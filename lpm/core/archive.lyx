// lpm/core/archive.lyx — .lxpkg (tar.gz) Extraktor
// WP-PM-03
//
// Ein .lxpkg ist ein tar.gz-Archiv (gzip-komprimiertes POSIX-tar).
// tar-Header: 512-Byte-Blöcke. Wir nutzen std/zlib für Decompression.
//
// Dateiformat: gzip-Header → DEFLATE-Stream → tar-Blöcke

unit lpm.core.archive;

import std.string;
import std.alloc;
import std.io;
import std.fs;
import std.zlib;

// ============================================================================
// Konstanten
// ============================================================================

pub con LXPKG_EXT:       int64 := 0;  // ".lxpkg"
con TAR_BLOCK:           int64 := 512;
con TAR_NAME_OFF:        int64 := 0;    // Dateiname im Header (100 Bytes)
con TAR_SIZE_OFF:        int64 := 124;  // Oktal-Größe (12 Bytes)
con TAR_TYPE_OFF:        int64 := 156;  // Typ: '0'=regulär, '5'=Verzeichnis
con ERR_AR_OK:           int64 := 0;
pub con ERR_AR_IO:       int64 := 1;
pub con ERR_AR_CORRUPT:  int64 := 2;
pub con ERR_AR_DECOMP:   int64 := 3;

// ============================================================================
// Hilfsfunktionen
// ============================================================================

// Liest eine Oktalzahl aus einem Tar-Header-Feld (null-terminiert oder space-padded).
fn readOctal(buf: int64, len: int64): int64 {
    var val: int64 := 0;
    var i: int64 := 0;
    while (i < len) {
        var c: int64 := peek8(buf + i);
        if ((c == 0) | (c == 32)) { return val; }
        if ((c >= 48) & (c <= 55)) {
            val := val * 8 + (c - 48);
        }
        i := i + 1;
    }
    return val;
}

// Prüft ob ein Tar-Block der Ende-Marker ist (alle Nullen).
fn tarIsEndBlock(block: int64): int64 {
    var i: int64 := 0;
    while (i < TAR_BLOCK) {
        if (peek8(block + i) != 0) { return 0; }
        i := i + 1;
    }
    return 1;
}

// Erstellt alle Zwischenverzeichnisse für einen Pfad.
fn ensureParentDir(destDir: int64, relPath: int64): void {
    var dLen: int64 := StrLen(destDir);
    var rLen: int64 := StrLen(relPath);
    var fullPath: int64 := alloc(dLen + rLen + 4);
    StrCpyN(fullPath, destDir, dLen);
    poke8(fullPath + dLen, 47);  // '/'
    StrCpyN(fullPath + dLen + 1, relPath, rLen);
    poke8(fullPath + dLen + 1 + rLen, 0);

    // Rückwärts das letzte '/' suchen und Verzeichnis anlegen
    var lastSlash: int64 := dLen + 1 + rLen - 1;
    while ((lastSlash > dLen) & (peek8(fullPath + lastSlash) != 47)) {
        lastSlash := lastSlash - 1;
    }
    if (lastSlash > dLen) {
        poke8(fullPath + lastSlash, 0);
        MkDirAll(fullPath);
        poke8(fullPath + lastSlash, 47);
    }
    free(fullPath);
}

// ============================================================================
// Öffentliche API
// ============================================================================

// Extrahiert ein .lxpkg-Archiv (tar.gz) nach destDir.
// pkgPath: Pfad zur .lxpkg-Datei
// destDir: Zielverzeichnis (muss existieren)
pub fn ArchiveExtract(pkgPath: int64, destDir: int64): int64 {
    // Datei einlesen
    var compressed: int64 := FileReadAll(pkgPath);
    if (compressed == 0) { return ERR_AR_IO; }
    var compLen: int64 := FileSize(pkgPath);

    // Zlib-Decompression (gzip-Format)
    var decompBuf: int64 := alloc(compLen * 8 + 65536);  // Heuristik: 8x Ratio
    var decompLen: int64 := alloc(8);
    var rc: int64 := ZlibDecompressGzip(compressed, compLen, decompBuf, compLen * 8 + 65536, decompLen);
    free(compressed);

    if (rc != 0) {
        free(decompBuf); free(decompLen);
        return ERR_AR_DECOMP;
    }

    var tarData: int64 := decompBuf;
    var tarLen: int64 := peek64(decompLen);
    free(decompLen);

    // Tar-Blöcke verarbeiten
    var pos: int64 := 0;
    var endCount: int64 := 0;

    var nameBuf: int64 := alloc(256);
    var fullPath: int64 := alloc(4096);
    var dLen: int64 := StrLen(destDir);

    while (pos + TAR_BLOCK <= tarLen) {
        var block: int64 := tarData + pos;

        // Ende-Marker erkennen
        if (tarIsEndBlock(block) == 1) {
            endCount := endCount + 1;
            if (endCount >= 2) { return ERR_AR_OK; }
            pos := pos + TAR_BLOCK;
        } else {
            endCount := 0;

            // Dateiname (max 100 Bytes, null-terminiert)
            StrCpyN(nameBuf, block + TAR_NAME_OFF, 100);
            poke8(nameBuf + 100, 0);

            var fileType: int64 := peek8(block + TAR_TYPE_OFF);
            var fileSize: int64 := readOctal(block + TAR_SIZE_OFF, 12);

            // Vollständigen Zielpfad zusammenbauen
            StrCpyN(fullPath, destDir, dLen);
            poke8(fullPath + dLen, 47);
            StrCpyN(fullPath + dLen + 1, nameBuf, StrLen(nameBuf));
            poke8(fullPath + dLen + 1 + StrLen(nameBuf), 0);

            pos := pos + TAR_BLOCK;

            if ((fileType == 53) | (fileType == 0)) {
                // Typ '5' = Verzeichnis
                if (fileType == 53) {
                    MkDirAll(fullPath);
                }
                // Typ '0' oder '\0' = reguläre Datei
                else if (fileType == 0) {
                    ensureParentDir(destDir, nameBuf);
                    if (fileSize > 0) {
                        FileWriteAll(fullPath, tarData + pos, fileSize);
                    } else {
                        // Leere Datei anlegen
                        FileWriteAll(fullPath, "", 0);
                    }
                }
            }

            // Nächster Block: fileSize aufrunden auf 512-Byte-Boundary
            var blocks: int64 := (fileSize + TAR_BLOCK - 1) / TAR_BLOCK;
            pos := pos + blocks * TAR_BLOCK;
        }
    }

    free(nameBuf); free(fullPath); free(decompBuf);
    return ERR_AR_OK;
}

// Erstellt ein .lxpkg-Archiv aus einem Verzeichnis.
// sourceDir: zu archivierende Verzeichnis
// destPkg: Ausgabepfad der .lxpkg-Datei
// files: null-terminiertes Array von pchar (Dateinamen relativ zu sourceDir)
// fileCount: Anzahl Dateien
pub fn ArchiveCreate(sourceDir: int64, destPkg: int64, files: int64, fileCount: int64): int64 {
    // tar-Daten zusammenbauen
    var tarBufSize: int64 := fileCount * 65536 + 4096;  // Heuristik
    var tarBuf: int64 := alloc(tarBufSize);
    var pos: int64 := 0;

    var sLen: int64 := StrLen(sourceDir);

    fn zeroPad(upto: int64): void {
        while (pos < upto) { poke8(tarBuf + pos, 0); pos := pos + 1; }
    }

    var i: int64 := 0;
    while (i < fileCount) {
        var fname: int64 := peek64(files + i * 8);
        if (fname == 0) { i := i + 1; }
        else {

        // Vollständiger Quellpfad
        var fLen: int64 := StrLen(fname);
        var srcPath: int64 := alloc(sLen + fLen + 4);
        StrCpyN(srcPath, sourceDir, sLen);
        poke8(srcPath + sLen, 47);
        StrCpyN(srcPath + sLen + 1, fname, fLen);
        poke8(srcPath + sLen + 1 + fLen, 0);

        var fileData: int64 := FileReadAll(srcPath);
        var fileSize: int64 := FileSize(srcPath);
        free(srcPath);

        if (fileData != 0) {
            // tar-Header schreiben (512 Bytes)
            var headerStart: int64 := pos;
            zeroPad(pos + TAR_BLOCK);

            // Name
            StrCpyN(tarBuf + headerStart + TAR_NAME_OFF, fname, (fLen > 99) & 99 | fLen);

            // Größe als Oktal
            var sizeBuf: int64 := alloc(16);
            var sv: int64 := fileSize;
            var oi: int64 := 10;
            poke8(sizeBuf + 11, 0);
            while (oi >= 0) {
                poke8(sizeBuf + oi, 48 + (sv % 8));
                sv := sv / 8;
                oi := oi - 1;
            }
            StrCpyN(tarBuf + headerStart + TAR_SIZE_OFF, sizeBuf, 12);
            free(sizeBuf);

            // Typ: reguläre Datei '0'
            poke8(tarBuf + headerStart + TAR_TYPE_OFF, 48);

            // Checksum (vereinfacht: Summe aller Header-Bytes)
            var chk: int64 := 0;
            var hi: int64 := 0;
            while (hi < TAR_BLOCK) {
                chk := chk + peek8(tarBuf + headerStart + hi);
                hi := hi + 1;
            }
            var chkBuf: int64 := alloc(8);
            // Checksum als 6-stellige Oktalzahl + Leerzeichen + Null
            var ci: int64 := 5;
            while (ci >= 0) {
                poke8(chkBuf + ci, 48 + (chk % 8));
                chk := chk / 8;
                ci := ci - 1;
            }
            poke8(chkBuf + 6, 32);
            poke8(chkBuf + 7, 0);
            StrCpyN(tarBuf + headerStart + 148, chkBuf, 8);
            free(chkBuf);

            // Dateidaten schreiben
            StrCpyN(tarBuf + pos, fileData, fileSize);
            pos := pos + fileSize;
            free(fileData);

            // Auf 512-Byte-Block auffüllen
            var nextBlock: int64 := ((pos + TAR_BLOCK - 1) / TAR_BLOCK) * TAR_BLOCK;
            zeroPad(nextBlock);
        }

        i := i + 1;
        }
    }

    // Zwei leere Endblöcke
    zeroPad(pos + TAR_BLOCK * 2);
    var tarLen: int64 := pos;

    // Gzip-Kompression
    var compBuf: int64 := alloc(tarLen + 4096);
    var compLen: int64 := alloc(8);
    var rc: int64 := ZlibCompressGzip(tarBuf, tarLen, compBuf, tarLen + 4096, compLen);
    free(tarBuf);

    if (rc != 0) {
        free(compBuf); free(compLen);
        return ERR_AR_DECOMP;
    }

    var written: int64 := FileWriteAll(destPkg, compBuf, peek64(compLen));
    free(compBuf); free(compLen);
    if (written == 0) { return ERR_AR_IO; }
    return ERR_AR_OK;
}

// Verifiziert die Integrität einer .lxpkg-Datei (FILES.sha256 Prüfung).
pub fn ArchiveVerifyChecksums(pkgPath: int64, destDir: int64): int64 {
    // FILES.sha256 im extrahierten Verzeichnis prüfen
    var dLen: int64 := StrLen(destDir);
    var checksumPath: int64 := alloc(dLen + 16);
    StrCpyN(checksumPath, destDir, dLen);
    StrCpyN(checksumPath + dLen, "/FILES.sha256", 13);
    poke8(checksumPath + dLen + 13, 0);

    if (FileExists(checksumPath) == 0) {
        free(checksumPath);
        return ERR_AR_CORRUPT;  // Keine Checksums-Datei
    }

    // TODO: SHA256 jeder Datei gegen FILES.sha256 prüfen
    // Vereinfachte V1-Implementierung: nur prüfen ob Datei existiert
    free(checksumPath);
    return ERR_AR_OK;
}
