// lpm/core/workspace.lyx — Workspace/Monorepo-Support
// WP-PM-11
//
// Verwaltet mehrere Lyx-Pakete in einem Repository.
// Manifest: lyx-workspace.toml mit [workspace] members = ["std/io", "std/net/http"]

unit lpm.core.workspace;

import std.string;
import std.alloc;
import std.io;
import std.fs;
import lpm.core.manifest;

// ============================================================================
// Konstanten
// ============================================================================

pub con WORKSPACE_FILE: int64 := 0;   // "lyx-workspace.toml"
pub con MAX_MEMBERS:    int64 := 256;
pub con ERR_WS_OK:      int64 := 0;
pub con ERR_WS_IO:      int64 := 1;
pub con ERR_WS_PARSE:   int64 := 2;
pub con ERR_WS_NOTFOUND: int64 := 3;

// ============================================================================
// Typen
// ============================================================================

pub type Workspace = struct {
    rootPath: int64;       // pchar — Workspace-Root-Verzeichnis
    members:  int64;       // pchar*-Array (Pfade relativ zu rootPath)
    memberCount: int64;
    valid:    int64;
};

// ============================================================================
// Hilfsfunktionen
// ============================================================================

fn wsStrdup(s: int64): int64 {
    if (s == 0) { return 0; }
    var len: int64 := StrLen(s);
    var buf: int64 := alloc(len + 1);
    StrCpyN(buf, s, len);
    poke8(buf + len, 0);
    return buf;
}

fn wsSkipWs(line: int64, pos: int64): int64 {
    var c: int64 := peek8(line + pos);
    while ((c == 32) | (c == 9)) { pos := pos + 1; c := peek8(line + pos); }
    return pos;
}

// ============================================================================
// Workspace-Parser
// ============================================================================

// Sucht lyx-workspace.toml im aktuellen und Parent-Verzeichnissen.
// Gibt alloc'd Pfad zurück oder 0. Aufrufer muss free().
pub fn WorkspaceFindRoot(startDir: int64): int64 {
    var buf: int64 := alloc(4096);
    var sLen: int64 := StrLen(startDir);
    StrCpyN(buf, startDir, sLen);
    poke8(buf + sLen, 0);

    var tries: int64 := 0;
    while (tries < 16) {
        var wfLen: int64 := StrLen(buf);
        var wfPath: int64 := alloc(wfLen + 24);
        StrCpyN(wfPath, buf, wfLen);
        StrCpyN(wfPath + wfLen, "/lyx-workspace.toml", 19);
        poke8(wfPath + wfLen + 19, 0);

        if (FileExists(wfPath) == 1) {
            free(wfPath);
            var result: int64 := wsStrdup(buf);
            free(buf);
            return result;
        }
        free(wfPath);

        // Ein Verzeichnis nach oben
        var newLen: int64 := wfLen;
        while ((newLen > 0) & (peek8(buf + newLen - 1) != 47)) { newLen := newLen - 1; }
        if (newLen <= 1) { free(buf); return 0; }  // bei "/" aufgehört
        newLen := newLen - 1;
        poke8(buf + newLen, 0);
        tries := tries + 1;
    }

    free(buf);
    return 0;
}

// Parst lyx-workspace.toml.
pub fn WorkspaceParse(rootPath: int64, ws: int64): int64 {
    var rLen: int64 := StrLen(rootPath);
    var wfPath: int64 := alloc(rLen + 24);
    StrCpyN(wfPath, rootPath, rLen);
    StrCpyN(wfPath + rLen, "/lyx-workspace.toml", 19);
    poke8(wfPath + rLen + 19, 0);

    var fdata: int64 := FileReadAll(wfPath);
    free(wfPath);
    if (fdata == 0) { return ERR_WS_IO; }

    // Workspace initialisieren
    poke64(ws,       wsStrdup(rootPath));
    poke64(ws + 8,   alloc(MAX_MEMBERS * 8));
    poke64(ws + 16,  0);
    poke64(ws + 24,  1);

    var members: int64 := peek64(ws + 8);
    var memberCount: int64 := 0;

    var pos: int64 := 0;
    var dataLen: int64 := StrLen(fdata);
    var inWorkspace: int64 := 0;
    var inMembers: int64 := 0;  // innerhalb von members = [...]

    var lineBuf: int64 := alloc(1024);
    var vbuf: int64 := alloc(512);

    while (pos <= dataLen) {
        var lp: int64 := 0;
        while ((pos <= dataLen) & (peek8(fdata + pos) != 10) & (lp < 1023)) {
            poke8(lineBuf + lp, peek8(fdata + pos));
            lp := lp + 1;
            pos := pos + 1;
        }
        poke8(lineBuf + lp, 0);
        if (pos <= dataLen) { pos := pos + 1; }

        var lpos: int64 := wsSkipWs(lineBuf, 0);
        var fc: int64 := peek8(lineBuf + lpos);

        if ((fc == 0) | (fc == 35) | (fc == 13)) { }
        else if (fc == 91) {
            // [workspace]
            inWorkspace := (StrCmpN(lineBuf + lpos + 1, "workspace]", 10) == 0) & 1;
            inMembers := 0;
        }
        else if ((inWorkspace == 1) & (StrCmpN(lineBuf + lpos, "members", 7) == 0)) {
            // members = [ ... ]
            // Multi-line oder single-line Array
            inMembers := 1;
        }
        else if (inMembers == 1) {
            // Zeile mit "path/to/member" oder "path/to/member",
            // oder ']' zum Beenden
            if (fc == 93) {
                inMembers := 0;
            } else {
                // Quoted String extrahieren
                var qp: int64 := lpos;
                while ((peek8(lineBuf + qp) != 34) & (peek8(lineBuf + qp) != 0)) { qp := qp + 1; }
                if (peek8(lineBuf + qp) == 34) {
                    qp := qp + 1;
                    var vp: int64 := 0;
                    var c2: int64 := peek8(lineBuf + qp);
                    while ((c2 != 34) & (c2 != 0) & (vp < 511)) {
                        poke8(vbuf + vp, c2);
                        vp := vp + 1;
                        qp := qp + 1;
                        c2 := peek8(lineBuf + qp);
                    }
                    poke8(vbuf + vp, 0);
                    if ((vp > 0) & (memberCount < MAX_MEMBERS)) {
                        poke64(members + memberCount * 8, wsStrdup(vbuf));
                        memberCount := memberCount + 1;
                    }
                }
            }
        }
    }

    poke64(ws + 16, memberCount);
    free(fdata); free(lineBuf); free(vbuf);
    return ERR_WS_OK;
}

// Gibt den absoluten Pfad eines Members zurück. Aufrufer muss free().
pub fn WorkspaceMemberPath(ws: int64, memberIdx: int64): int64 {
    var rootPath: int64 := peek64(ws);
    var members: int64 := peek64(ws + 8);
    var count: int64 := peek64(ws + 16);

    if (memberIdx >= count) { return 0; }

    var member: int64 := peek64(members + memberIdx * 8);
    var rLen: int64 := StrLen(rootPath);
    var mLen: int64 := StrLen(member);
    var result: int64 := alloc(rLen + mLen + 4);
    StrCpyN(result, rootPath, rLen);
    poke8(result + rLen, 47);
    StrCpyN(result + rLen + 1, member, mLen);
    poke8(result + rLen + 1 + mLen, 0);
    return result;
}

// Findet Member-Index nach Name. Gibt -1 wenn nicht gefunden.
pub fn WorkspaceFindMember(ws: int64, name: int64): int64 {
    var members: int64 := peek64(ws + 8);
    var count: int64 := peek64(ws + 16);
    var i: int64 := 0;
    while (i < count) {
        if (StrCmp(peek64(members + i * 8), name) == 0) { return i; }
        i := i + 1;
    }
    return 0 - 1;
}

// Schreibt lyx-workspace.toml.
pub fn WorkspaceWrite(ws: int64): int64 {
    var rootPath: int64 := peek64(ws);
    var members: int64 := peek64(ws + 8);
    var count: int64 := peek64(ws + 16);
    var rLen: int64 := StrLen(rootPath);

    var buf: int64 := alloc(count * 128 + 256);
    var pos: int64 := 0;

    fn ws2(s: int64): void {
        if (s == 0) { return; }
        var l: int64 := StrLen(s);
        StrCpyN(buf + pos, s, l);
        pos := pos + l;
    }

    ws2("[workspace]\nmembers = [\n");
    var i: int64 := 0;
    while (i < count) {
        ws2("  \"");
        ws2(peek64(members + i * 8));
        ws2("\"");
        if (i < count - 1) { ws2(","); }
        ws2("\n");
        i := i + 1;
    }
    ws2("]\n");
    poke8(buf + pos, 0);

    var wfPath: int64 := alloc(rLen + 24);
    StrCpyN(wfPath, rootPath, rLen);
    StrCpyN(wfPath + rLen, "/lyx-workspace.toml", 19);
    poke8(wfPath + rLen + 19, 0);

    var rc: int64 := FileWriteAll(wfPath, buf, pos);
    free(buf); free(wfPath);
    if (rc == 0) { return ERR_WS_IO; }
    return ERR_WS_OK;
}

pub fn WorkspaceFree(ws: int64): void {
    var rootPath: int64 := peek64(ws);
    if (rootPath != 0) { free(rootPath); }

    var members: int64 := peek64(ws + 8);
    var count: int64 := peek64(ws + 16);
    if (members != 0) {
        var i: int64 := 0;
        while (i < count) {
            var m: int64 := peek64(members + i * 8);
            if (m != 0) { free(m); }
            i := i + 1;
        }
        free(members);
    }
}
