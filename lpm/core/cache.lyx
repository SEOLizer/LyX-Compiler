// lpm/core/cache.lyx — ~/.lpm/cache Verwaltung
// WP-PM-03
//
// Verwaltet den lokalen Paket-Cache unter ~/.lpm/.
// Layout: ~/.lpm/cache/<namespace>/<name>/<version>/
//         ~/.lpm/registry/index.json
//         ~/.lpm/config.toml
//         ~/.lpm/keys/trusted.pub

unit lpm.core.cache;

import std.string;
import std.alloc;
import std.io;
import lpm.core.lpmutil;
import std.fs;

// ============================================================================
// Konstanten
// ============================================================================

pub con CACHE_INDEX_TTL_SEC: int64 := 3600;  // 1 Stunde
pub con ERR_CACHE_OK:        int64 := 0;
pub con ERR_CACHE_IO:        int64 := 1;
pub con ERR_CACHE_NOTFOUND:  int64 := 2;

// ============================================================================
// Pfad-Hilfsfunktionen
// ============================================================================

// Gibt den lpm-Basis-Pfad zurück: $LPM_HOME oder ~/.lpm
// Aufrufer muss free() aufrufen.
pub fn CacheGetHome(): int64 {
    var envHome: int64 := GetEnv("LPM_HOME");
    if (envHome != 0) { return envHome; }

    var home: int64 := GetEnv("HOME");
    if (home == 0) { home := "/root"; }

    var homeLen: int64 := StrLen(home);
    var result: int64 := alloc(homeLen + 8);
    lpmCpyN(result, home, homeLen);
    lpmCpyN(result + homeLen, "/.lpm", 5);
    poke8(result + homeLen + 5, 0);
    return result;
}

// Baut einen Cache-Pfad: {lpmHome}/cache/{name}/{version}
// name kann '/' enthalten (z.B. "net/http") → wird direkt als Pfad-Komponente verwendet.
// Aufrufer muss free() aufrufen.
pub fn CachePkgPath(lpmHome: int64, name: int64, version: int64): int64 {
    var hLen: int64 := StrLen(lpmHome);
    var nLen: int64 := StrLen(name);
    var vLen: int64 := StrLen(version);
    var result: int64 := alloc(hLen + nLen + vLen + 16);
    var pos: int64 := 0;
    lpmCpyN(result + pos, lpmHome, hLen);  pos := pos + hLen;
    lpmCpyN(result + pos, "/cache/", 7);   pos := pos + 7;
    lpmCpyN(result + pos, name, nLen);     pos := pos + nLen;
    poke8(result + pos, 47); pos := pos + 1;  // '/'
    lpmCpyN(result + pos, version, vLen);  pos := pos + vLen;
    poke8(result + pos, 0);
    return result;
}

fn cacheMakeSub(lpmHome: int64, buf: int64, sub: int64): int64 {
    var hLen: int64 := StrLen(lpmHome);
    lpmCpyN(buf, lpmHome, hLen);
    lpmCpyN(buf + hLen, sub, StrLen(sub));
    poke8(buf + hLen + StrLen(sub), 0);
    return MkDirAll(buf);
}

// Initialisiert ~/.lpm/ Verzeichnisstruktur.
pub fn CacheInit(lpmHome: int64): int64 {
    var hLen: int64 := StrLen(lpmHome);
    var buf: int64 := alloc(hLen + 32);
    cacheMakeSub(lpmHome, buf, "");
    cacheMakeSub(lpmHome, buf, "/cache");
    cacheMakeSub(lpmHome, buf, "/registry");
    cacheMakeSub(lpmHome, buf, "/keys");
    free(buf);
    return ERR_CACHE_OK;
}

// Gibt 1 zurück wenn Paket gecacht ist (Verzeichnis + lyx.toml existiert).
pub fn CacheHas(lpmHome: int64, name: int64, version: int64): int64 {
    var pkgPath: int64 := CachePkgPath(lpmHome, name, version);
    var mfPath: int64 := alloc(StrLen(pkgPath) + 16);
    lpmCpyN(mfPath, pkgPath, StrLen(pkgPath));
    lpmCpyN(mfPath + StrLen(pkgPath), "/lyx.toml", 9);
    poke8(mfPath + StrLen(pkgPath) + 9, 0);
    var exists: int64 := FileExists(mfPath);
    free(pkgPath); free(mfPath);
    return exists;
}

// Gibt den Import-Pfad für lyxc zurück: {pkgPath}/{entry}.
// Aufrufer muss free() aufrufen.
pub fn CacheImportPath(lpmHome: int64, name: int64, version: int64, entry: int64): int64 {
    var pkgPath: int64 := CachePkgPath(lpmHome, name, version);
    var eLen: int64 := StrLen(entry);
    var pLen: int64 := StrLen(pkgPath);
    var result: int64 := alloc(pLen + eLen + 4);
    lpmCpyN(result, pkgPath, pLen);
    poke8(result + pLen, 47);  // '/'
    lpmCpyN(result + pLen + 1, entry, eLen);
    poke8(result + pLen + 1 + eLen, 0);
    free(pkgPath);
    return result;
}

// ============================================================================
// Cache-Index (registry/index.json) — lokaler Spiegel der Registry
// ============================================================================

// Gibt den Pfad zur index.json zurück. Aufrufer muss free().
pub fn CacheIndexPath(lpmHome: int64): int64 {
    var hLen: int64 := StrLen(lpmHome);
    var result: int64 := alloc(hLen + 24);
    lpmCpyN(result, lpmHome, hLen);
    lpmCpyN(result + hLen, "/registry/index.json", 20);
    poke8(result + hLen + 20, 0);
    return result;
}

// Gibt den Pfad zur config.toml zurück. Aufrufer muss free().
pub fn CacheConfigPath(lpmHome: int64): int64 {
    var hLen: int64 := StrLen(lpmHome);
    var result: int64 := alloc(hLen + 16);
    lpmCpyN(result, lpmHome, hLen);
    lpmCpyN(result + hLen, "/config.toml", 12);
    poke8(result + hLen + 12, 0);
    return result;
}

// Gibt den Pfad zu trusted.pub zurück. Aufrufer muss free().
pub fn CacheTrustedKeyPath(lpmHome: int64): int64 {
    var hLen: int64 := StrLen(lpmHome);
    var result: int64 := alloc(hLen + 20);
    lpmCpyN(result, lpmHome, hLen);
    lpmCpyN(result + hLen, "/keys/trusted.pub", 17);
    poke8(result + hLen + 17, 0);
    return result;
}

// ============================================================================
// Cache-Inventar
// ============================================================================

pub type CacheEntry = struct {
    name:    int64;
    version: int64;
    path:    int64;
};

pub type CacheList = struct {
    entries: int64;   // *CacheEntry-Array
    count:   int64;
};

fn cacheScanStr(data: int64, dataLen: int64, p: int64, out2: int64): int64 {
    while ((peek8(data + p) != 34) & (p < dataLen)) { p := p + 1; }
    if (p >= dataLen) { poke64(out2, 0); return p; }
    p := p + 1;
    var start: int64 := p;
    while ((peek8(data + p) != 34) & (p < dataLen)) { p := p + 1; }
    var len: int64 := p - start;
    var s: int64 := alloc(len + 1);
    lpmCpyN(s, data + start, len);
    poke8(s + len, 0);
    poke64(out2, s);
    if (p < dataLen) { p := p + 1; }
    return p;
}

// Listet alle gecachten Pakete auf (Verzeichnis-Walk ~/.lpm/cache/).
// Aufrufer muss CacheListFree() aufrufen.
pub fn CacheList_(lpmHome: int64, out: int64): int64 {
    var buf: int64 := alloc(StrLen(lpmHome) + 8);
    lpmCpyN(buf, lpmHome, StrLen(lpmHome));
    lpmCpyN(buf + StrLen(lpmHome), "/cache", 6);
    poke8(buf + StrLen(lpmHome) + 6, 0);

    // max 1024 Einträge
    var entries: int64 := alloc(1024 * 24);  // sizeof(CacheEntry)=24
    poke64(out, entries);
    poke64(out + 8, 0);

    // DirList gibt uns alle Namespace-Verzeichnisse
    // Da wir keine rekursive Verzeichnisliste haben,
    // nutzen wir ReadDir zweistufig (namespace/name/version).
    // Vereinfachte Implementierung: liest index.json falls vorhanden.
    var indexPath: int64 := CacheIndexPath(lpmHome);
    if (FileExists(indexPath) == 0) { free(indexPath); free(buf); return ERR_CACHE_OK; }

    // Index.json enthält JSON-Array mit {name, version} Objekten — parsen wir einfach zeilenweise
    var data: int64 := lpmReadFile(indexPath);
    free(indexPath);
    if (data == 0) { free(buf); return ERR_CACHE_OK; }

    // Simples JSON-Scanning: suche "name" und "version" Felder
    var pos: int64 := 0;
    var dataLen: int64 := StrLen(data);
    var count: int64 := 0;

    while ((pos < dataLen) & (count < 1024)) {
        // Suche "name"
        if (lpmCmpN(data + pos, "\"name\"", 6) == 0) {
            pos := pos + 6;
            var namePtr: int64 := alloc(8);
            pos := cacheScanStr(data, dataLen, pos, namePtr);
            var name: int64 := peek64(namePtr);
            free(namePtr);

            // Suche nächstes "version"
            var vPtr: int64 := alloc(8);
            pos := cacheScanStr(data, dataLen, pos, vPtr);
            var ver: int64 := peek64(vPtr);
            free(vPtr);

            if ((name != 0) & (ver != 0)) {
                var entry: int64 := entries + count * 24;
                poke64(entry,      name);
                poke64(entry + 8,  ver);
                poke64(entry + 16, CachePkgPath(lpmHome, name, ver));
                count := count + 1;
            }
        } else {
            pos := pos + 1;
        }
    }

    poke64(out + 8, count);
    free(data); free(buf);
    return ERR_CACHE_OK;
}

pub fn CacheListFree(cl: int64): void {
    var count: int64 := peek64(cl + 8);
    var entries: int64 := peek64(cl);
    if (entries == 0) { return; }
    var i: int64 := 0;
    while (i < count) {
        var e: int64 := entries + i * 24;
        if (peek64(e) != 0) { free(peek64(e)); }
        if (peek64(e + 8) != 0) { free(peek64(e + 8)); }
        if (peek64(e + 16) != 0) { free(peek64(e + 16)); }
        i := i + 1;
    }
    free(entries);
}

// Löscht alle gecachten Pakete.
pub fn CacheClean(lpmHome: int64): int64 {
    var cachePath: int64 := alloc(StrLen(lpmHome) + 8);
    lpmCpyN(cachePath, lpmHome, StrLen(lpmHome));
    lpmCpyN(cachePath + StrLen(lpmHome), "/cache", 6);
    poke8(cachePath + StrLen(lpmHome) + 6, 0);

    var rc: int64 := RmDirAll(cachePath);
    free(cachePath);

    var cachePath2: int64 := alloc(StrLen(lpmHome) + 8);
    lpmCpyN(cachePath2, lpmHome, StrLen(lpmHome));
    lpmCpyN(cachePath2 + StrLen(lpmHome), "/cache", 6);
    poke8(cachePath2 + StrLen(lpmHome) + 6, 0);
    MkDirAll(cachePath2);
    free(cachePath2);

    if (rc != 0) { return ERR_CACHE_IO; }
    return ERR_CACHE_OK;
}

fn cacheWs(buf: int64, pos: int64, s: int64): int64 {
    if (s == 0) { return pos; }
    var l: int64 := StrLen(s);
    lpmCpyN(buf + pos, s, l);
    return pos + l;
}

// Aktualisiert die Index-JSON mit einem neuen Paket-Eintrag.
pub fn CacheIndexUpdate(lpmHome: int64, name: int64, version: int64, sha256: int64, source: int64): int64 {
    var indexPath: int64 := CacheIndexPath(lpmHome);
    var existing: int64 := 0;
    if (FileExists(indexPath) == 1) {
        existing := lpmReadFile(indexPath);
    }

    // Einfache JSON-Array-Manipulation: Wenn vorhanden, hängen wir ein Objekt an.
    var buf: int64 := alloc(4096);
    var pos: int64 := 0;

    if (existing != 0) {
        var elen: int64 := StrLen(existing);
        while ((elen > 0) & (peek8(existing + elen - 1) != 93)) { elen := elen - 1; }
        if (elen > 1) {
            lpmCpyN(buf, existing, elen - 1);
            pos := elen - 1;
            pos := cacheWs(buf, pos, ",\n");
        } else {
            pos := cacheWs(buf, pos, "[\n");
        }
        free(existing);
    } else {
        pos := cacheWs(buf, pos, "[\n");
    }

    pos := cacheWs(buf, pos, "{\"name\":\""); pos := cacheWs(buf, pos, name);
    pos := cacheWs(buf, pos, "\",\"version\":\""); pos := cacheWs(buf, pos, version);
    pos := cacheWs(buf, pos, "\",\"sha256\":\""); pos := cacheWs(buf, pos, sha256);
    pos := cacheWs(buf, pos, "\",\"source\":\""); pos := cacheWs(buf, pos, source);
    pos := cacheWs(buf, pos, "\"}\n]");
    poke8(buf + pos, 0);

    var rc: int64 := lpmWriteFile(indexPath, buf, pos);
    free(buf); free(indexPath);
    if (rc == 0) { return ERR_CACHE_IO; }
    return ERR_CACHE_OK;
}
