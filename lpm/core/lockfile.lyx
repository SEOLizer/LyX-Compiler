// lpm/core/lockfile.lyx — lyx.lock Lesen und Schreiben
// WP-PM-01
//
// lyx.lock ist ein TOML-Dokument mit [[package]]-Einträgen.
// Automatisch generiert — nicht manuell bearbeiten.

unit lpm.core.lockfile;

import std.string;
import std.alloc;
import std.io;
import std.fs;
import lpm.core.lpmutil;

// ============================================================================
// Typen
// ============================================================================

pub con MAX_LOCKED: int64 := 512;
pub con ERR_LF_OK:  int64 := 0;
pub con ERR_LF_IO:  int64 := 1;

// Ein gesperrtes Paket im Lock-File
pub type LockedPackage = struct {
    name:    int64;   // pchar — "net/http"
    version: int64;   // pchar — "1.2.0"
    sha256:  int64;   // pchar — Hex-String, 64 Zeichen
    source:  int64;   // pchar — Download-URL des .lxpkg
};

// Gesamtes Lock-File
pub type LockFile = struct {
    packages:  int64;   // *LockedPackage-Array
    count:     int64;
    valid:     int64;
};

// ============================================================================
// Hilfsfunktionen
// ============================================================================

fn lfStrdup(s: int64): int64 {
    if (s == 0) { return 0; }
    var len: int64 := StrLen(s);
    var buf: int64 := alloc(len + 1);
    lpmCpyN(buf, s, len);
    poke8(buf + len, 0);
    return buf;
}

fn lfSkipWs(line: int64, pos: int64): int64 {
    var c: int64 := peek8(line + pos);
    while ((c == 32) | (c == 9)) { pos := pos + 1; c := peek8(line + pos); }
    return pos;
}

fn lfReadQuoted(line: int64, pos: int64, buf: int64, max: int64): int64 {
    var out: int64 := 0;
    var c: int64 := peek8(line + pos);
    while ((c != 34) & (c != 0) & (out < max - 1)) {
        poke8(buf + out, c);
        out := out + 1;
        pos := pos + 1;
        c := peek8(line + pos);
    }
    poke8(buf + out, 0);
    if (c == 34) { pos := pos + 1; }
    return pos;
}

fn lfReadKey(line: int64, pos: int64, buf: int64, max: int64): int64 {
    var out: int64 := 0;
    var c: int64 := peek8(line + pos);
    while ((c != 61) & (c != 0) & (c != 32) & (c != 9) & (out < max - 1)) {
        poke8(buf + out, c);
        out := out + 1;
        pos := pos + 1;
        c := peek8(line + pos);
    }
    while ((out > 0) & ((peek8(buf + out - 1) == 32) | (peek8(buf + out - 1) == 9))) {
        out := out - 1;
    }
    poke8(buf + out, 0);
    return pos;
}

// ============================================================================
// Öffentliche API
// ============================================================================

// Initialisiert ein leeres LockFile.
pub fn LockFileInit(lf: int64): void {
    poke64(lf,      alloc(MAX_LOCKED * 32));  // packages array
    poke64(lf + 8,  0);                        // count
    poke64(lf + 16, 1);                        // valid
}

// Parst lyx.lock von path in lf.
pub fn LockFileParse(path: int64, lf: int64): int64 {
    var fdata: int64 := lpmReadFile(path);
    if (fdata == 0) {
        // Datei nicht vorhanden — leeres Lock-File ist OK
        LockFileInit(lf);
        return ERR_LF_OK;
    }

    LockFileInit(lf);

    var kbuf: int64 := alloc(256);
    var vbuf: int64 := alloc(1024);
    var lineBuf: int64 := alloc(2048);
    var dataLen: int64 := StrLen(fdata);
    var pos: int64 := 0;
    var inPackage: int64 := 0;
    var curPkg: int64 := 0;  // Zeiger auf aktuelles LockedPackage im Array

    while (pos <= dataLen) {
        var lp: int64 := 0;
        while ((pos <= dataLen) & (peek8(fdata + pos) != 10) & (lp < 2047)) {
            poke8(lineBuf + lp, peek8(fdata + pos));
            lp := lp + 1;
            pos := pos + 1;
        }
        poke8(lineBuf + lp, 0);
        if (pos <= dataLen) { pos := pos + 1; }

        var lpos: int64 := lfSkipWs(lineBuf, 0);
        var fc: int64 := peek8(lineBuf + lpos);

        if ((fc == 0) | (fc == 35) | (fc == 13)) {
            // Leer / Kommentar
        } else if ((fc == 91) & (peek8(lineBuf + lpos + 1) == 91)) {
            // [[package]] → neues Package
            var count: int64 := peek64(lf + 8);
            if (count < MAX_LOCKED) {
                curPkg := peek64(lf) + count * 32;  // sizeof(LockedPackage)=32
                poke64(curPkg, 0);
                poke64(curPkg + 8, 0);
                poke64(curPkg + 16, 0);
                poke64(curPkg + 24, 0);
                poke64(lf + 8, count + 1);
                inPackage := 1;
            }
        } else if (fc == 91) {
            inPackage := 0;
        } else if ((fc != 0) & (inPackage == 1) & (curPkg != 0)) {
            lpos := lfReadKey(lineBuf, lpos, kbuf, 256);
            lpos := lfSkipWs(lineBuf, lpos);
            if (peek8(lineBuf + lpos) == 61) {
                lpos := lpos + 1;
                lpos := lfSkipWs(lineBuf, lpos);
                if (peek8(lineBuf + lpos) == 34) {
                    lpos := lfReadQuoted(lineBuf, lpos + 1, vbuf, 1024);
                }
                if (lpmStrCmp(kbuf, "name") == 0)    { poke64(curPkg,      lfStrdup(vbuf)); }
                if (lpmStrCmp(kbuf, "version") == 0)  { poke64(curPkg + 8,  lfStrdup(vbuf)); }
                if (lpmStrCmp(kbuf, "sha256") == 0)   { poke64(curPkg + 16, lfStrdup(vbuf)); }
                if (lpmStrCmp(kbuf, "source") == 0)   { poke64(curPkg + 24, lfStrdup(vbuf)); }
            }
        }
    }

    free(kbuf); free(vbuf); free(lineBuf); free(fdata);
    return ERR_LF_OK;
}

fn lfWs(buf: int64, bpos: int64, s: int64): int64 {
    if (s == 0) { return bpos; }
    var l: int64 := StrLen(s);
    lpmCpyN(buf + bpos, s, l);
    return bpos + l;
}

// Schreibt LockFile nach path.
pub fn LockFileWrite(lf: int64, path: int64): int64 {
    var count: int64 := peek64(lf + 8);
    var pkgs: int64  := peek64(lf);

    var buf: int64 := alloc(count * 256 + 64);
    var bpos: int64 := 0;

    bpos := lfWs(buf, bpos, "# Automatisch generiert — nicht manuell bearbeiten\n");

    var i: int64 := 0;
    while (i < count) {
        var pkg: int64 := pkgs + i * 32;
        bpos := lfWs(buf, bpos, "\n[[package]]\n");
        bpos := lfWs(buf, bpos, "name    = \""); bpos := lfWs(buf, bpos, peek64(pkg));      bpos := lfWs(buf, bpos, "\"\n");
        bpos := lfWs(buf, bpos, "version = \""); bpos := lfWs(buf, bpos, peek64(pkg + 8));  bpos := lfWs(buf, bpos, "\"\n");
        bpos := lfWs(buf, bpos, "sha256  = \""); bpos := lfWs(buf, bpos, peek64(pkg + 16)); bpos := lfWs(buf, bpos, "\"\n");
        bpos := lfWs(buf, bpos, "source  = \""); bpos := lfWs(buf, bpos, peek64(pkg + 24)); bpos := lfWs(buf, bpos, "\"\n");
        i := i + 1;
    }

    poke8(buf + bpos, 0);
    var rc: int64 := lpmWriteFile(path, buf, bpos);
    free(buf);
    if (rc == 0) { return ERR_LF_IO; }
    return ERR_LF_OK;
}

// Sucht ein Paket im Lock-File nach Name. Gibt Zeiger auf LockedPackage oder 0.
pub fn LockFileFind(lf: int64, name: int64): int64 {
    var count: int64 := peek64(lf + 8);
    var pkgs: int64  := peek64(lf);
    var i: int64 := 0;
    while (i < count) {
        var pkg: int64 := pkgs + i * 32;
        var pname: int64 := peek64(pkg);
        if ((pname != 0) & (lpmStrCmp(pname, name) == 0)) { return pkg; }
        i := i + 1;
    }
    return 0;
}

// Fügt ein Paket hinzu oder aktualisiert es (nach Name).
pub fn LockFileUpsert(lf: int64, name: int64, version: int64, sha256: int64, source: int64): void {
    var existing: int64 := LockFileFind(lf, name);
    var pkg: int64;

    if (existing != 0) {
        pkg := existing;
        if (peek64(pkg + 8) != 0) { free(peek64(pkg + 8)); }
        if (peek64(pkg + 16) != 0) { free(peek64(pkg + 16)); }
        if (peek64(pkg + 24) != 0) { free(peek64(pkg + 24)); }
    } else {
        var count: int64 := peek64(lf + 8);
        if (count >= MAX_LOCKED) { return; }
        pkg := peek64(lf) + count * 32;
        if (peek64(pkg) != 0) { free(peek64(pkg)); }
        poke64(pkg, lfStrdup(name));
        poke64(lf + 8, count + 1);
    }

    poke64(pkg + 8,  lfStrdup(version));
    poke64(pkg + 16, lfStrdup(sha256));
    poke64(pkg + 24, lfStrdup(source));
}

// Gibt alle allozierten Strings im LockFile frei.
pub fn LockFileFree(lf: int64): void {
    var count: int64 := peek64(lf + 8);
    var pkgs: int64  := peek64(lf);
    if (pkgs == 0) { return; }
    var i: int64 := 0;
    while (i < count) {
        var pkg: int64 := pkgs + i * 32;
        var f: int64;
        f := peek64(pkg);      if (f != 0) { free(f); }
        f := peek64(pkg + 8);  if (f != 0) { free(f); }
        f := peek64(pkg + 16); if (f != 0) { free(f); }
        f := peek64(pkg + 24); if (f != 0) { free(f); }
        i := i + 1;
    }
    free(pkgs);
}
