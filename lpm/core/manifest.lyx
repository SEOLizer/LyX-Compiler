// lpm/core/manifest.lyx — lyx.toml Parser und Schreiber
// WP-PM-01
//
// Unterstützt TOML-Subset: Strings, Integer, [sections], [[array-of-tables]],
// Inline-Tabellen und Array-Werte. Ausreichend für lyx.toml und lyx.lock.

unit lpm.core.manifest;

import std.string;
import std.alloc;
import std.io;
import std.fs;
import lpm.core.semver;
import lpm.core.lpmutil;

// ============================================================================
// Konstanten
// ============================================================================

pub con MANIFEST_FILE:  int64 := 0;  // Platzhalter — String-Const nicht möglich in Lyx v0.9
                                      // Nutze "lyx.toml" inline

pub con MAX_DEPS:       int64 := 128;
pub con MAX_STR_LEN:    int64 := 512;
pub con ERR_MF_OK:      int64 := 0;
pub con ERR_MF_IO:      int64 := 1;
pub con ERR_MF_PARSE:   int64 := 2;
pub con ERR_MF_MISSING: int64 := 3;

// ============================================================================
// Typen
// ============================================================================

// Eine einzelne Dependency: name + Versionsrange
pub type Dependency = struct {
    name:    int64;   // pchar — z.B. "std/io"
    range:   int64;   // pchar — z.B. "^1.0.0"
};

// Package-Manifest (lyx.toml)
pub type Manifest = struct {
    // [package]
    name:        int64;   // pchar
    version:     int64;   // pchar
    author:      int64;   // pchar
    license:     int64;   // pchar
    description: int64;   // pchar
    entry:       int64;   // pchar — Haupt-Unit ("http.lyx")

    // [dependencies]
    deps:        int64;   // *Dependency-Array (allokiert)
    depCount:    int64;

    // [dev-dependencies]
    devDeps:     int64;   // *Dependency-Array
    devDepCount: int64;

    valid:       int64;
};

// ============================================================================
// TOML-Line-Parser Internals
// ============================================================================

// Alle TOML-Parsing-Konstanten
con TOML_MAX_LINE: int64 := 1024;

// Überspringt Whitespace (Space, Tab) ab pos.
fn skipWs(line: int64, pos: int64): int64 {
    var c: int64 := peek8(line + pos);
    while ((c == 32) | (c == 9)) {
        pos := pos + 1;
        c := peek8(line + pos);
    }
    return pos;
}

// Prüft ob der Rest der Zeile ein Kommentar oder leer ist.
fn isLineEnd(line: int64, pos: int64): int64 {
    var p: int64 := skipWs(line, pos);
    var c: int64 := peek8(line + p);
    return ((c == 0) | (c == 35) | (c == 13)) & 1;  // 0, '#', '\r'
}

// Liest einen gequoteten String ab pos (nach dem öffnenden ").
// Schreibt Inhalt in buf, gibt Position nach schließendem " zurück.
fn readQuotedStr(line: int64, pos: int64, buf: int64, bufMax: int64): int64 {
    var c: int64 := peek8(line + pos);
    var out: int64 := 0;
    while ((c != 34) & (c != 0) & (out < bufMax - 1)) {  // '"'
        if (c == 92) {  // Backslash-Escape
            pos := pos + 1;
            c := peek8(line + pos);
            if (c == 110) { poke8(buf + out, 10); }      // \n
            else if (c == 116) { poke8(buf + out, 9); }  // \t
            else if (c == 92) { poke8(buf + out, 92); }  // \\
            else if (c == 34) { poke8(buf + out, 34); }  // \"
            else { poke8(buf + out, c); }
        } else {
            poke8(buf + out, c);
        }
        out := out + 1;
        pos := pos + 1;
        c := peek8(line + pos);
    }
    poke8(buf + out, 0);
    if (c == 34) { pos := pos + 1; }  // schließendes "
    return pos;
}

// Liest einen unquotierten Wert (Integer oder bare string) bis Whitespace/Kommentar.
fn readBareVal(line: int64, pos: int64, buf: int64, bufMax: int64): int64 {
    var out: int64 := 0;
    var c: int64 := peek8(line + pos);
    while ((c != 0) & (c != 35) & (c != 13) & (c != 32) & (c != 9) & (out < bufMax - 1)) {
        poke8(buf + out, c);
        out := out + 1;
        pos := pos + 1;
        c := peek8(line + pos);
    }
    poke8(buf + out, 0);
    return pos;
}

// Liest einen Schlüssel (alphanumerisch, -, _, /, .) bis '='.
fn readKey(line: int64, pos: int64, buf: int64, bufMax: int64): int64 {
    var out: int64 := 0;
    var c: int64 := peek8(line + pos);
    while ((c != 61) & (c != 0) & (c != 32) & (c != 9) & (out < bufMax - 1)) {
        poke8(buf + out, c);
        out := out + 1;
        pos := pos + 1;
        c := peek8(line + pos);
    }
    // Trailing Whitespace vor '=' entfernen
    while ((out > 0) & ((peek8(buf + out - 1) == 32) | (peek8(buf + out - 1) == 9))) {
        out := out - 1;
    }
    poke8(buf + out, 0);
    return pos;
}

// Allokiert eine Kopie von str.
fn strdup(s: int64): int64 {
    if (s == 0) { return 0; }
    var len: int64 := StrLen(s);
    var buf: int64 := alloc(len + 1);
    lpmCpyN(buf, s, len);
    poke8(buf + len, 0);
    return buf;
}

// ============================================================================
// Manifest-Parser
// ============================================================================

pub fn ManifestParse(path: int64, out: int64): int64 {
    // out = *Manifest

    // Datei lesen
    var fdata: int64 := lpmReadFile(path);
    if (fdata == 0) { return ERR_MF_IO; }

    // Manifest initialisieren
    var mf: Manifest;
    mf.name := 0; mf.version := 0; mf.author := 0;
    mf.license := 0; mf.description := 0; mf.entry := 0;
    mf.deps := alloc(MAX_DEPS * 16);  // MAX_DEPS * sizeof(Dependency)
    mf.depCount := 0;
    mf.devDeps := alloc(MAX_DEPS * 16);
    mf.devDepCount := 0;
    mf.valid := 0;

    var kbuf: int64 := alloc(256);
    var vbuf: int64 := alloc(MAX_STR_LEN);

    // Aktueller [section]-Kontext
    var section: int64 := alloc(64);
    poke8(section, 0);

    var pos: int64 := 0;
    var lineStart: int64 := 0;
    var lineBuf: int64 := alloc(TOML_MAX_LINE);
    var dataLen: int64 := StrLen(fdata);

    while (pos <= dataLen) {
        // Zeile lesen bis '\n' oder Ende
        var lp: int64 := 0;
        while ((pos <= dataLen) & (peek8(fdata + pos) != 10) & (lp < TOML_MAX_LINE - 1)) {
            poke8(lineBuf + lp, peek8(fdata + pos));
            lp := lp + 1;
            pos := pos + 1;
        }
        poke8(lineBuf + lp, 0);
        if (pos <= dataLen) { pos := pos + 1; }  // '\n' überspringen

        var lpos: int64 := skipWs(lineBuf, 0);
        var fc: int64 := peek8(lineBuf + lpos);

        // Leerzeile oder Kommentar
        if ((fc == 0) | (fc == 35) | (fc == 13)) {
            // nichts tun
        }
        // [[array-of-tables]] — ignorieren wir vorerst (nur [sections] nötig)
        else if ((fc == 91) & (peek8(lineBuf + lpos + 1) == 91)) {
            // [[...]] → section leer setzen um zu ignorieren
            poke8(section, 0);
        }
        // [section]
        else if (fc == 91) {
            lpos := lpos + 1;
            var sp: int64 := 0;
            var c: int64 := peek8(lineBuf + lpos);
            while ((c != 93) & (c != 0) & (sp < 63)) {
                poke8(section + sp, c);
                sp := sp + 1;
                lpos := lpos + 1;
                c := peek8(lineBuf + lpos);
            }
            poke8(section + sp, 0);
        }
        // key = value
        else if (fc != 0) {
            lpos := readKey(lineBuf, lpos, kbuf, 256);
            lpos := skipWs(lineBuf, lpos);
            if (peek8(lineBuf + lpos) == 61) {  // '='
                lpos := lpos + 1;
                lpos := skipWs(lineBuf, lpos);

                var vc: int64 := peek8(lineBuf + lpos);
                if (vc == 34) {  // Quoted string
                    lpos := readQuotedStr(lineBuf, lpos + 1, vbuf, MAX_STR_LEN);
                } else {
                    lpos := readBareVal(lineBuf, lpos, vbuf, MAX_STR_LEN);
                }

                // Wert in Manifest-Felder mappen
                if (lpmStrCmp(section, "package") == 0) {
                    if (lpmStrCmp(kbuf, "name") == 0)        { mf.name        := strdup(vbuf); }
                    if (lpmStrCmp(kbuf, "version") == 0)     { mf.version     := strdup(vbuf); }
                    if (lpmStrCmp(kbuf, "author") == 0)      { mf.author      := strdup(vbuf); }
                    if (lpmStrCmp(kbuf, "license") == 0)     { mf.license     := strdup(vbuf); }
                    if (lpmStrCmp(kbuf, "description") == 0) { mf.description := strdup(vbuf); }
                }
                if (lpmStrCmp(section, "build") == 0) {
                    if (lpmStrCmp(kbuf, "entry") == 0) { mf.entry := strdup(vbuf); }
                }
                if (lpmStrCmp(section, "dependencies") == 0) {
                    if (mf.depCount < MAX_DEPS) {
                        var dep: int64 := mf.deps + mf.depCount * 16;
                        poke64(dep,     strdup(kbuf));
                        poke64(dep + 8, strdup(vbuf));
                        mf.depCount := mf.depCount + 1;
                    }
                }
                if (lpmStrCmp(section, "dev-dependencies") == 0) {
                    if (mf.devDepCount < MAX_DEPS) {
                        var dep: int64 := mf.devDeps + mf.devDepCount * 16;
                        poke64(dep,     strdup(kbuf));
                        poke64(dep + 8, strdup(vbuf));
                        mf.devDepCount := mf.devDepCount + 1;
                    }
                }
            }
        }
    }

    free(kbuf); free(vbuf); free(section);
    free(lineBuf); free(fdata);

    mf.valid := 1;
    // Manifest-Felder nach out schreiben (11 Felder × 8 = 88 Bytes)
    poke64(out,      mf.name);       poke64(out + 8,  mf.version);
    poke64(out + 16, mf.author);     poke64(out + 24, mf.license);
    poke64(out + 32, mf.description);poke64(out + 40, mf.entry);
    poke64(out + 48, mf.deps);       poke64(out + 56, mf.depCount);
    poke64(out + 64, mf.devDeps);    poke64(out + 72, mf.devDepCount);
    poke64(out + 80, mf.valid);
    return ERR_MF_OK;
}

fn mfWriteStr(buf: int64, pos: int64, s: int64): int64 {
    if (s == 0) { return pos; }
    var len: int64 := StrLen(s);
    lpmCpyN(buf + pos, s, len);
    return pos + len;
}

fn mfWriteLine(buf: int64, pos: int64, s: int64): int64 {
    pos := mfWriteStr(buf, pos, s);
    poke8(buf + pos, 10);
    return pos + 1;
}

fn mfWriteKV(buf: int64, pos: int64, k: int64, v: int64): int64 {
    pos := mfWriteStr(buf, pos, k);
    pos := mfWriteStr(buf, pos, " = \"");
    pos := mfWriteStr(buf, pos, v);
    pos := mfWriteStr(buf, pos, "\"\n");
    return pos;
}

// Schreibt Manifest als lyx.toml nach path.
pub fn ManifestWrite(mf: int64, path: int64): int64 {
    var buf: int64 := alloc(8192);
    var pos: int64 := 0;

    pos := mfWriteLine(buf, pos, "[package]");

    var name: int64 := peek64(mf);
    if (name != 0) { pos := mfWriteKV(buf, pos, "name", name); }
    var ver: int64 := peek64(mf + 8);
    if (ver != 0) { pos := mfWriteKV(buf, pos, "version", ver); }
    var auth: int64 := peek64(mf + 16);
    if (auth != 0) { pos := mfWriteKV(buf, pos, "author", auth); }
    var lic: int64 := peek64(mf + 24);
    if (lic != 0) { pos := mfWriteKV(buf, pos, "license", lic); }
    var desc: int64 := peek64(mf + 32);
    if (desc != 0) { pos := mfWriteKV(buf, pos, "description", desc); }
    poke8(buf + pos, 10); pos := pos + 1;

    var entry: int64 := peek64(mf + 40);
    if (entry != 0) {
        pos := mfWriteLine(buf, pos, "[build]");
        pos := mfWriteKV(buf, pos, "entry", entry);
        poke8(buf + pos, 10); pos := pos + 1;
    }

    var depCount: int64 := peek64(mf + 56);
    if (depCount > 0) {
        pos := mfWriteLine(buf, pos, "[dependencies]");
        var deps: int64 := peek64(mf + 48);
        var i: int64 := 0;
        while (i < depCount) {
            var dep: int64 := deps + i * 16;
            var dname: int64 := peek64(dep);
            var drange: int64 := peek64(dep + 8);
            pos := mfWriteStr(buf, pos, "\"");
            pos := mfWriteStr(buf, pos, dname);
            pos := mfWriteStr(buf, pos, "\" = \"");
            pos := mfWriteStr(buf, pos, drange);
            pos := mfWriteStr(buf, pos, "\"\n");
            i := i + 1;
        }
        poke8(buf + pos, 10); pos := pos + 1;
    }

    var devDepCount: int64 := peek64(mf + 72);
    if (devDepCount > 0) {
        pos := mfWriteLine(buf, pos, "[dev-dependencies]");
        var devDeps: int64 := peek64(mf + 64);
        var i: int64 := 0;
        while (i < devDepCount) {
            var dep: int64 := devDeps + i * 16;
            pos := mfWriteStr(buf, pos, "\"");
            pos := mfWriteStr(buf, pos, peek64(dep));
            pos := mfWriteStr(buf, pos, "\" = \"");
            pos := mfWriteStr(buf, pos, peek64(dep + 8));
            pos := mfWriteStr(buf, pos, "\"\n");
            i := i + 1;
        }
    }

    poke8(buf + pos, 0);
    var rc: int64 := lpmWriteFile(path, buf, pos);
    free(buf);
    if (rc == 0) { return ERR_MF_IO; }
    return ERR_MF_OK;
}

// Gibt alle allozierten Strings im Manifest frei.
pub fn ManifestFree(mf: int64): void {
    var f: int64;
    f := peek64(mf);      if (f != 0) { free(f); }
    f := peek64(mf + 8);  if (f != 0) { free(f); }
    f := peek64(mf + 16); if (f != 0) { free(f); }
    f := peek64(mf + 24); if (f != 0) { free(f); }
    f := peek64(mf + 32); if (f != 0) { free(f); }
    f := peek64(mf + 40); if (f != 0) { free(f); }

    var deps: int64 := peek64(mf + 48);
    var depCount: int64 := peek64(mf + 56);
    if (deps != 0) {
        var i: int64 := 0;
        while (i < depCount) {
            var dep: int64 := deps + i * 16;
            var dn: int64 := peek64(dep);
            var dr: int64 := peek64(dep + 8);
            if (dn != 0) { free(dn); }
            if (dr != 0) { free(dr); }
            i := i + 1;
        }
        free(deps);
    }

    var devDeps: int64 := peek64(mf + 64);
    var devDepCount: int64 := peek64(mf + 72);
    if (devDeps != 0) {
        var i: int64 := 0;
        while (i < devDepCount) {
            var dep: int64 := devDeps + i * 16;
            if (peek64(dep) != 0) { free(peek64(dep)); }
            if (peek64(dep + 8) != 0) { free(peek64(dep + 8)); }
            i := i + 1;
        }
        free(devDeps);
    }
}

// Validiert Manifest: Name und Version sind Pflichtfelder.
pub fn ManifestValidate(mf: int64): int64 {
    if (peek64(mf) == 0) { return ERR_MF_MISSING; }   // name
    if (peek64(mf + 8) == 0) { return ERR_MF_MISSING; } // version
    return ERR_MF_OK;
}

// Prüft ob Paketname valide ist: [a-z0-9_/.-] only
pub fn ManifestNameValid(name: int64): int64 {
    if (name == 0) { return 0; }
    var i: int64 := 0;
    var c: int64 := peek8(name + i);
    while (c != 0) {
        var ok: int64 := 0;
        if ((c >= 97) & (c <= 122)) { ok := 1; }  // a-z
        if ((c >= 48) & (c <= 57))  { ok := 1; }  // 0-9
        if (c == 95)  { ok := 1; }  // _
        if (c == 47)  { ok := 1; }  // /
        if (c == 46)  { ok := 1; }  // .
        if (c == 45)  { ok := 1; }  // -
        if (ok == 0) { return 0; }
        i := i + 1;
        c := peek8(name + i);
    }
    return 1;
}
