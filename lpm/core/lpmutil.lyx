// lpm/core/lpmutil.lyx — Hilfsfunktionen für lpm
// Ersetzt nicht-vorhandene Builtins: StrCpyN, StrCmpN, FileReadAll, FileWriteAll

unit lpm.core.lpmutil;

import std.alloc;
import std.fs;
import std.string;
import std.hash;

// n Bytes von src nach dst kopieren (wie strncpy ohne Null-Padding)
pub fn lpmCpyN(dst: int64, src: int64, n: int64): void {
    var i: int64 := 0;
    while (i < n) { poke8(dst + i, peek8(src + i)); i := i + 1; }
}

// Vergleicht erste n Bytes von a und b. Gibt 0 bei Gleichheit, sonst !=0.
pub fn lpmCmpN(a: int64, b: int64, n: int64): int64 {
    var i: int64 := 0;
    while (i < n) {
        var ca: int64 := peek8(a + i);
        var cb: int64 := peek8(b + i);
        if (ca < cb) { return 0 - 1; }
        if (ca > cb) { return 1; }
        i := i + 1;
    }
    return 0;
}

// Liest Datei vollständig in alloc'd Buffer. Aufrufer muss free().
// Gibt 0 bei Fehler. Schreibt Null-Terminator ans Ende.
pub fn lpmReadFile(path: int64): int64 {
    var fsize: int64 := FileSize(path);
    if (fsize <= 0) { return 0; }
    var buf: int64 := alloc(fsize + 1);
    var n: int64 := ReadFile(path, buf, fsize);
    if (n <= 0) { free(buf); return 0; }
    poke8(buf + n, 0);
    return buf;
}

// Schreibt buf[0..len-1] nach path. Gibt 0 bei Fehler, 1 bei Erfolg.
pub fn lpmWriteFile(path: int64, buf: int64, len: int64): int64 {
    return WriteFile(path, buf, len);
}

// Liest Umgebungsvariable via /proc/self/environ. Aufrufer muss free().
// Gibt 0 wenn nicht gefunden.
pub fn GetEnv(name: int64): int64 {
    var buf: int64 := alloc(65536);
    var n: int64 := ReadFile("/proc/self/environ", buf, 65535);
    if (n <= 0) { free(buf); return 0; }

    var nameLen: int64 := StrLen(name);
    var pos: int64 := 0;
    while (pos < n) {
        if (lpmCmpN(buf + pos, name, nameLen) == 0) {
            if (peek8(buf + pos + nameLen) == 61) {  // '='
                var valStart: int64 := pos + nameLen + 1;
                var valLen: int64 := 0;
                while ((valStart + valLen < n) & (peek8(buf + valStart + valLen) != 0)) {
                    valLen := valLen + 1;
                }
                var result: int64 := alloc(valLen + 1);
                lpmCpyN(result, buf + valStart, valLen);
                poke8(result + valLen, 0);
                free(buf);
                return result;
            }
        }
        // Weiter zur nächsten Null
        while ((pos < n) & (peek8(buf + pos) != 0)) { pos := pos + 1; }
        pos := pos + 1;
    }
    free(buf);
    return 0;
}

