pub fn RmDirAll(path: int64): int64 {
    return 0;
}

// SHA256 über binäre Daten der Länge size. Schreibt 32 Bytes nach out.
pub fn lpmSHA256(data: int64, size: int64, out: int64): void {
    HashSHA256Bytes(data, size, out);
}

// Null-terminierter String-Vergleich (wie C strcmp). 0 = gleich.
// StrCmp ist in sema registriert aber hat keine Codegen-Implementierung.
pub fn lpmStrCmp(a: int64, b: int64): int64 {
    if (a == 0) {
        if (b == 0) { return 0; }
        return 0 - 1;
    }
    if (b == 0) { return 1; }
    var i: int64 := 0;
    while (1 == 1) {
        var ca: int64 := peek8(a + i);
        var cb: int64 := peek8(b + i);
        if (ca < cb) { return 0 - 1; }
        if (ca > cb) { return 1; }
        if (ca == 0) { return 0; }
        i := i + 1;
    }
    return 0;
}
