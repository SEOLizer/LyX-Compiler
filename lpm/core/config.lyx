// lpm/core/config.lyx — YAML-Konfigurationsdatei für lpm
//
// Format: ~/.lpm/config.yml
//   registry: https://lpm.seolizer.de
//   api_key: meinschluessel
//
// Zeilenbasiertes YAML-Subset: key: value, # Kommentare, leere Zeilen.
// Anführungszeichen um Werte werden entfernt. Kein Nesting.

unit lpm.core.config;

import std.alloc;
import std.fs;
import std.string;
import lpm.core.lpmutil;

con CFG_MAX_ENTRIES: int64 := 64;
// Config-Struct (16 Bytes): entries:0, count:8
// Entry (16 Bytes): key:0, value:8

// Gibt den Pfad zu ~/.lpm/config.yml zurück. Aufrufer muss free().
pub fn LpmConfigPath(): int64 {
    var home: int64 := GetEnv("HOME");
    if (home == 0) { home := "/root"; }
    var hLen: int64 := StrLen(home);
    var result: int64 := alloc(hLen + 20);
    lpmCpyN(result, home, hLen);
    lpmCpyN(result + hLen, "/.lpm/config.yml", 16);
    poke8(result + hLen + 16, 0);
    free(home);
    return result;
}

// Hilfsfunktion: Whitespace-Zeichen?
fn cfgIsSpace(c: int64): int64 {
    if (c == 32) { return 1; }   // ' '
    if (c == 9)  { return 1; }   // '\t'
    return 0;
}

// Gibt Start-Index des ersten Nicht-Whitespace-Zeichens ab pos zurück.
fn cfgTrimLeft(buf: int64, pos: int64, end: int64): int64 {
    while ((pos < end) & (cfgIsSpace(peek8(buf + pos)) == 1)) { pos := pos + 1; }
    return pos;
}

// Gibt End-Index (exklusiv) des letzten Nicht-Whitespace-Zeichens vor end zurück.
fn cfgTrimRight(buf: int64, start: int64, end: int64): int64 {
    while ((end > start) & (cfgIsSpace(peek8(buf + end - 1)) == 1)) { end := end - 1; }
    return end;
}

// Kopiert buf[from..to) als null-terminierten String. Aufrufer muss free().
fn cfgSlice(buf: int64, start: int64, end: int64): int64 {
    var len: int64 := end - start;
    if (len <= 0) { return 0; }
    var s: int64 := alloc(len + 1);
    lpmCpyN(s, buf + start, len);
    poke8(s + len, 0);
    return s;
}

// Entfernt umgebende " oder ' von einem String. Gibt neuen alloc'd String zurück.
fn cfgStripQuotes(s: int64): int64 {
    if (s == 0) { return 0; }
    var len: int64 := StrLen(s);
    if (len < 2) { return s; }
    var first: int64 := peek8(s);
    var last: int64 := peek8(s + len - 1);
    if (((first == 34) & (last == 34)) | ((first == 39) & (last == 39))) {
        var inner: int64 := alloc(len - 1);
        lpmCpyN(inner, s + 1, len - 2);
        poke8(inner + len - 2, 0);
        free(s);
        return inner;
    }
    return s;
}

// Lädt ~/.lpm/config.yml (oder übergebenen Pfad). Gibt cfg-Handle zurück.
// 0 wenn Datei nicht vorhanden. Aufrufer muss LpmConfigFree() aufrufen.
pub fn LpmConfigLoad(path: int64): int64 {
    if (FileExists(path) == 0) { return 0; }
    var fsize: int64 := FileSize(path);
    if (fsize <= 0) { return 0; }

    var raw: int64 := alloc(fsize + 1);
    var n: int64 := ReadFile(path, raw, fsize);
    if (n <= 0) { free(raw); return 0; }
    poke8(raw + n, 0);

    var cfg: int64 := alloc(16);
    var entries: int64 := alloc(CFG_MAX_ENTRIES * 16);
    poke64(cfg,     entries);
    poke64(cfg + 8, 0);

    var pos: int64 := 0;
    while (pos <= n) {
        // Zeilenanfang suchen; Zeilenende ist \n oder Dateiende
        var lineStart: int64 := pos;
        var lineEnd: int64 := pos;
        while ((lineEnd < n) & (peek8(raw + lineEnd) != 10)) { lineEnd := lineEnd + 1; }

        // Zeile trimmen
        var ls: int64 := cfgTrimLeft(raw, lineStart, lineEnd);
        var le: int64 := cfgTrimRight(raw, ls, lineEnd);

        // Leer oder Kommentar überspringen
        if ((le > ls) & (peek8(raw + ls) != 35)) {  // 35 = '#'
            // Erstes ':' suchen
            var colon: int64 := ls;
            while ((colon < le) & (peek8(raw + colon) != 58)) { colon := colon + 1; }  // 58 = ':'

            if (colon < le) {
                var keyEnd: int64 := cfgTrimRight(raw, ls, colon);
                var valStart: int64 := cfgTrimLeft(raw, colon + 1, le);
                var valEnd: int64 := le;

                var key: int64 := cfgSlice(raw, ls, keyEnd);
                var val: int64 := cfgStripQuotes(cfgSlice(raw, valStart, valEnd));

                if (key != 0) {
                    var count: int64 := peek64(cfg + 8);
                    if (count < CFG_MAX_ENTRIES) {
                        var entry: int64 := entries + count * 16;
                        poke64(entry,     key);
                        poke64(entry + 8, val);
                        poke64(cfg + 8, count + 1);
                    } else {
                        if (key != 0) { free(key); }
                        if (val != 0) { free(val); }
                    }
                } else {
                    if (val != 0) { free(val); }
                }
            }
        }

        pos := lineEnd + 1;
    }

    free(raw);
    return cfg;
}

// Gibt den Wert für key zurück, oder 0. Der String gehört dem Config-Handle.
pub fn LpmConfigGet(cfg: int64, key: int64): int64 {
    if (cfg == 0) { return 0; }
    var entries: int64 := peek64(cfg);
    var count: int64 := peek64(cfg + 8);
    var i: int64 := 0;
    while (i < count) {
        var entry: int64 := entries + i * 16;
        var k: int64 := peek64(entry);
        if ((k != 0) & (lpmStrCmp(k, key) == 0)) { return peek64(entry + 8); }
        i := i + 1;
    }
    return 0;
}

// Gibt value zurück, oder defVal wenn key nicht gesetzt.
pub fn LpmConfigGetDef(cfg: int64, key: int64, defVal: int64): int64 {
    var v: int64 := LpmConfigGet(cfg, key);
    if (v == 0) { return defVal; }
    return v;
}

// Gibt alle Ressourcen frei.
pub fn LpmConfigFree(cfg: int64): void {
    if (cfg == 0) { return; }
    var entries: int64 := peek64(cfg);
    var count: int64 := peek64(cfg + 8);
    var i: int64 := 0;
    while (i < count) {
        var entry: int64 := entries + i * 16;
        if (peek64(entry) != 0)     { free(peek64(entry)); }
        if (peek64(entry + 8) != 0) { free(peek64(entry + 8)); }
        i := i + 1;
    }
    free(entries);
    free(cfg);
}
