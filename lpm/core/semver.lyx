// lpm/core/semver.lyx — Semantic Versioning Parser + Comparator
// WP-PM-01
//
// Unterstützt: Parsing von "1.2.3", Ranges "^1.0", "~1.2", ">=1.0.0", "=1.2.3", "*"
// SemVer nach semver.org v2.0.0: MAJOR.MINOR.PATCH[-prerelease][+build]

unit lpm.core.semver;

import std.string;
import std.alloc;
import std.io;
import lpm.core.lpmutil;

// ============================================================================
// Typen
// ============================================================================

// Geparste Semantic Version
pub type SemVer = struct {
    major:      int64;
    minor:      int64;
    patch:      int64;
    preRelease: int64;   // pchar — z.B. "alpha.1", 0 wenn keine
    build:      int64;   // pchar — Build-Metadata, wird bei Vergleich ignoriert
    valid:      int64;   // 1 wenn erfolgreich geparst
};

// SemVer-Range-Typen
pub con RANGE_EXACT:    int64 := 0;   // =1.2.3
pub con RANGE_COMPAT:   int64 := 1;   // ^1.2.3 — kompatibel (major darf nicht wachsen)
pub con RANGE_TILDE:    int64 := 2;   // ~1.2.3 — patch-kompatibel
pub con RANGE_GTE:      int64 := 3;   // >=1.2.3
pub con RANGE_GT:       int64 := 4;   // >1.2.3
pub con RANGE_LTE:      int64 := 5;   // <=1.2.3
pub con RANGE_LT:       int64 := 6;   // <1.2.3
pub con RANGE_ANY:      int64 := 7;   // * — alle Versionen

pub type SemVerRange = struct {
    kind:    int64;
    version: SemVer;
};

// ============================================================================
// Interne Hilfsfunktionen
// ============================================================================

fn isDigit(c: int64): int64 {
    return (c >= 48) & (c <= 57);
}

fn digitVal(c: int64): int64 {
    return c - 48;
}

// Parst einen nicht-negativen Integer ab Position pos in s.
// Schreibt Ergebnis nach outVal, gibt neue Position zurück.
fn parseUInt(s: int64, pos: int64, outVal: int64): int64 {
    var val: int64 := 0;
    var c: int64 := peek8(s + pos);
    if (isDigit(c) == 0) {
        poke64(outVal, 0);
        return 0;  // Fehler: keine Ziffer
    }
    while (isDigit(c) == 1) {
        val := val * 10 + digitVal(c);
        pos := pos + 1;
        c := peek8(s + pos);
    }
    poke64(outVal, val);
    return pos;
}

// Kopiert Zeichen von s+start bis s+end (exklusiv) in einen neuen Buffer.
fn substrAlloc(s: int64, start: int64, end: int64): int64 {
    var len: int64 := end - start;
    if (len <= 0) { return 0; }
    var buf: int64 := alloc(len + 1);
    var i: int64 := 0;
    while (i < len) {
        poke8(buf + i, peek8(s + start + i));
        i := i + 1;
    }
    poke8(buf + len, 0);
    return buf;
}

// ============================================================================
// Öffentliche API
// ============================================================================

// Parst "MAJOR.MINOR.PATCH[-prerelease][+build]" in SemVer.
// Gibt 1 bei Erfolg, 0 bei Fehler.
pub fn SemVerParse(s: int64, out: int64): int64 {
    var sv: SemVer;
    sv.major := 0; sv.minor := 0; sv.patch := 0;
    sv.preRelease := 0; sv.build := 0; sv.valid := 0;

    if (s == 0) {
        poke64(out,      sv.major); poke64(out + 8,  sv.minor);
        poke64(out + 16, sv.patch); poke64(out + 24, sv.preRelease);
        poke64(out + 32, sv.build); poke64(out + 40, sv.valid);
        return 0;
    }

    // Optionales "v"-Prefix tolerieren
    var pos: int64 := 0;
    if (peek8(s) == 118) { pos := 1; }  // 'v'

    // Major
    var tmp: int64 := alloc(8);
    pos := parseUInt(s, pos, tmp);
    if (pos == 0) { free(tmp); poke64(out,0); poke64(out+8,0); poke64(out+16,0); poke64(out+24,0); poke64(out+32,0); poke64(out+40,0); return 0; }
    sv.major := peek64(tmp);
    if (peek8(s + pos) != 46) { free(tmp); poke64(out,0); poke64(out+8,0); poke64(out+16,0); poke64(out+24,0); poke64(out+32,0); poke64(out+40,0); return 0; }  // '.'
    pos := pos + 1;

    // Minor
    pos := parseUInt(s, pos, tmp);
    if (pos == 0) { free(tmp); poke64(out,0); poke64(out+8,0); poke64(out+16,0); poke64(out+24,0); poke64(out+32,0); poke64(out+40,0); return 0; }
    sv.minor := peek64(tmp);
    if (peek8(s + pos) != 46) { free(tmp); poke64(out,0); poke64(out+8,0); poke64(out+16,0); poke64(out+24,0); poke64(out+32,0); poke64(out+40,0); return 0; }  // '.'
    pos := pos + 1;

    // Patch
    pos := parseUInt(s, pos, tmp);
    if (pos == 0) { free(tmp); poke64(out,0); poke64(out+8,0); poke64(out+16,0); poke64(out+24,0); poke64(out+32,0); poke64(out+40,0); return 0; }
    sv.patch := peek64(tmp);
    free(tmp);

    var c: int64 := peek8(s + pos);

    // Pre-release "-alpha.1"
    if (c == 45) {  // '-'
        pos := pos + 1;
        var start: int64 := pos;
        c := peek8(s + pos);
        while ((c != 0) & (c != 43)) {
            pos := pos + 1;
            c := peek8(s + pos);
        }
        sv.preRelease := substrAlloc(s, start, pos);
        c := peek8(s + pos);
    }

    // Build-Metadata "+build"
    if (c == 43) {  // '+'
        pos := pos + 1;
        var start: int64 := pos;
        while (peek8(s + pos) != 0) { pos := pos + 1; }
        sv.build := substrAlloc(s, start, pos);
    }

    sv.valid := 1;
    poke64(out,      sv.major); poke64(out + 8,  sv.minor);
    poke64(out + 16, sv.patch); poke64(out + 24, sv.preRelease);
    poke64(out + 32, sv.build); poke64(out + 40, sv.valid);
    return 1;
}

// Vergleicht zwei SemVer. Gibt -1 (a<b), 0 (a==b), 1 (a>b) zurück.
// Pre-release-Versionen gelten als kleiner als die Release-Version.
pub fn SemVerCompare(a: int64, b: int64): int64 {
    var am: int64 := peek64(a);           // major
    var bm: int64 := peek64(b);
    if (am < bm) { return 0 - 1; }
    if (am > bm) { return 1; }

    var ami: int64 := peek64(a + 8);     // minor
    var bmi: int64 := peek64(b + 8);
    if (ami < bmi) { return 0 - 1; }
    if (ami > bmi) { return 1; }

    var ap: int64 := peek64(a + 16);     // patch
    var bp: int64 := peek64(b + 16);
    if (ap < bp) { return 0 - 1; }
    if (ap > bp) { return 1; }

    // Pre-release: fehlt (0) > vorhanden
    var apr: int64 := peek64(a + 24);
    var bpr: int64 := peek64(b + 24);
    if ((apr == 0) & (bpr != 0)) { return 1; }
    if ((apr != 0) & (bpr == 0)) { return 0 - 1; }
    if ((apr != 0) & (bpr != 0)) {
        var cmp: int64 := lpmStrCmp(apr, bpr);
        if (cmp < 0) { return 0 - 1; }
        if (cmp > 0) { return 1; }
    }
    return 0;
}

// Gibt 1 wenn version die Range erfüllt, sonst 0.
pub fn SemVerSatisfies(version: int64, range: int64): int64 {
    var kind: int64 := peek64(range);
    var rv: int64 := range + 8;   // SemVer der Range

    if (kind == RANGE_ANY) { return 1; }

    var cmp: int64 := SemVerCompare(version, rv);

    if (kind == RANGE_EXACT) { return (cmp == 0) & 1; }
    if (kind == RANGE_GTE)   { return (cmp >= 0) & 1; }
    if (kind == RANGE_GT)    { return (cmp > 0) & 1; }
    if (kind == RANGE_LTE)   { return (cmp <= 0) & 1; }
    if (kind == RANGE_LT)    { return (cmp < 0) & 1; }

    if (kind == RANGE_COMPAT) {
        // ^1.2.3 → >=1.2.3 <2.0.0 (wenn major>0)
        // ^0.2.3 → >=0.2.3 <0.3.0 (wenn major==0, minor>0)
        // ^0.0.3 → =0.0.3
        if (cmp < 0) { return 0; }
        var vmaj: int64 := peek64(version);
        var rmaj: int64 := peek64(rv);
        if (vmaj != rmaj) { return 0; }
        if (rmaj > 0) { return 1; }
        // major == 0: minor muss gleich sein
        var vmin: int64 := peek64(version + 8);
        var rmin: int64 := peek64(rv + 8);
        if (vmin != rmin) { return 0; }
        if (rmin > 0) { return 1; }
        // minor == 0: exakt
        return (cmp == 0) & 1;
    }

    if (kind == RANGE_TILDE) {
        // ~1.2.3 → >=1.2.3 <1.3.0
        if (cmp < 0) { return 0; }
        if (peek64(version) != peek64(rv)) { return 0; }
        if (peek64(version + 8) != peek64(rv + 8)) { return 0; }
        return 1;
    }

    return 0;
}

// Parst eine Range-Spec ("^1.2.0", "~1.0", ">=2.0.0", "*") in SemVerRange.
// Gibt 1 bei Erfolg.
pub fn SemVerRangeParse(s: int64, out: int64): int64 {
    if (s == 0) { return 0; }

    var kind: int64 := RANGE_EXACT;
    var pos: int64 := 0;
    var c0: int64 := peek8(s);
    var c1: int64 := peek8(s + 1);

    // Wildcard
    if (c0 == 42) {  // '*'
        poke64(out, RANGE_ANY);
        return 1;
    }
    // "latest" → *
    if (lpmCmpN(s, "latest", 6) == 0) {
        poke64(out, RANGE_ANY);
        return 1;
    }
    // Caret
    if (c0 == 94) { kind := RANGE_COMPAT; pos := 1; }
    // Tilde
    else if (c0 == 126) { kind := RANGE_TILDE; pos := 1; }
    // >=
    else if ((c0 == 62) & (c1 == 61)) { kind := RANGE_GTE; pos := 2; }
    // >
    else if (c0 == 62) { kind := RANGE_GT; pos := 1; }
    // <=
    else if ((c0 == 60) & (c1 == 61)) { kind := RANGE_LTE; pos := 2; }
    // <
    else if (c0 == 60) { kind := RANGE_LT; pos := 1; }
    // = (explicit exact)
    else if (c0 == 61) { kind := RANGE_EXACT; pos := 1; }

    poke64(out, kind);
    var svBuf: int64 := out + 8;
    return SemVerParse(s + pos, svBuf);
}

// Schreibt Integer n als ASCII-Dezimalzahl in dst+pos. Gibt neue Position.
fn svWriteInt(dst: int64, n: int64, pos: int64): int64 {
    if (n == 0) {
        poke8(dst + pos, 48);
        return pos + 1;
    }
    var digits: int64 := alloc(24);
    var dc: int64 := 0;
    var v: int64 := n;
    while (v > 0) {
        poke8(digits + dc, 48 + (v % 10));
        dc := dc + 1;
        v := v / 10;
    }
    var i: int64 := dc - 1;
    var p: int64 := pos;
    while (i >= 0) {
        poke8(dst + p, peek8(digits + i));
        p := p + 1;
        i := i - 1;
    }
    free(digits);
    return p;
}

// Formatiert SemVer als "MAJOR.MINOR.PATCH" in buf (mindestens 32 Bytes).
pub fn SemVerFormat(sv: int64, buf: int64): void {
    var p: int64 := 0;
    p := svWriteInt(buf, peek64(sv),      p);
    poke8(buf + p, 46); p := p + 1;
    p := svWriteInt(buf, peek64(sv + 8),  p);
    poke8(buf + p, 46); p := p + 1;
    p := svWriteInt(buf, peek64(sv + 16), p);
    var pr: int64 := peek64(sv + 24);
    if (pr != 0) {
        poke8(buf + p, 45); p := p + 1;
        var prLen: int64 := StrLen(pr);
        lpmCpyN(buf + p, pr, prLen);
        p := p + prLen;
    }
    poke8(buf + p, 0);
}

// Gibt 1 wenn a == b (ohne Build-Metadata), 0 sonst.
pub fn SemVerEqual(a: int64, b: int64): int64 {
    return (SemVerCompare(a, b) == 0) & 1;
}

// Sortiert ein Array von SemVer*-Zeigern (in-place, aufsteigend).
// ptrs: int64-Array von Zeigern auf SemVer-Structs
// count: Anzahl Einträge
pub fn SemVerSort(ptrs: int64, count: int64): void {
    // Insertion Sort — ausreichend für typische Paketlisten (<100 Einträge)
    var i: int64 := 1;
    while (i < count) {
        var key: int64 := peek64(ptrs + i * 8);
        var j: int64 := i - 1;
        while ((j >= 0) & (SemVerCompare(peek64(ptrs + j * 8), key) > 0)) {
            poke64(ptrs + (j + 1) * 8, peek64(ptrs + j * 8));
            j := j - 1;
        }
        poke64(ptrs + (j + 1) * 8, key);
        i := i + 1;
    }
}
