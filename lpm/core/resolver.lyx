// lpm/core/resolver.lyx — Abhängigkeitsauflösung (Dependency Resolver)
// WP-PM-04
//
// Algorithmus: BFS über Dependency-Graph, Greedy-SemVer-Selektion.
// Diamant-Konflikte (A→C@^1, B→C@^2) werden erkannt und gemeldet.
// Topologische Sortierung der Installationsreihenfolge via DFS.

unit lpm.core.resolver;

import std.string;
import std.alloc;
import std.io;
import lpm.core.semver;
import lpm.core.manifest;
import lpm.core.lockfile;

// ============================================================================
// Typen
// ============================================================================

pub con MAX_NODES:   int64 := 512;
pub con MAX_EDGES:   int64 := 2048;
pub con ERR_RES_OK:  int64 := 0;
pub con ERR_RES_CONFLICT: int64 := 1;
pub con ERR_RES_NOTFOUND: int64 := 2;
pub con ERR_RES_CYCLE:    int64 := 3;

// Ein Knoten im Dependency-Graph
pub type DepNode = struct {
    name:      int64;   // pchar
    version:   int64;   // pchar — aufgelöste Version
    range:     int64;   // pchar — ursprüngliche Range-Spec
    sha256:    int64;   // pchar — wird später gefüllt
    source:    int64;   // pchar — Download-URL
    visited:   int64;   // für Topo-Sort
    inStack:   int64;   // Zyklus-Erkennung
};

// Kante im Graph: from → to (Indizes)
type DepEdge = struct {
    from: int64;
    to:   int64;
};

// Resolver-Kontext
pub type Resolver = struct {
    nodes:     int64;   // *DepNode-Array
    nodeCount: int64;
    edges:     int64;   // *DepEdge-Array
    edgeCount: int64;

    // Sortiertes Ergebnis (Indizes in Installations-Reihenfolge)
    order:     int64;   // int64-Array
    orderCount: int64;

    // Letzter Fehler
    errMsg:    int64;   // pchar
};

// Callback-Typ: Registry-Abfrage für verfügbare Versionen
// name → beste_version (pchar), die range erfüllt.
// Wenn nicht gefunden: 0 zurückgeben.
// userData: beliebiger Context-Pointer
pub type FetchVersionFn = int64;  // fn(userData, name, range): pchar

// ============================================================================
// Resolver-Initialisierung
// ============================================================================

pub fn ResolverInit(res: int64): void {
    poke64(res,       alloc(MAX_NODES * 56));  // sizeof(DepNode)=56
    poke64(res + 8,   0);
    poke64(res + 16,  alloc(MAX_EDGES * 16));  // sizeof(DepEdge)=16
    poke64(res + 24,  0);
    poke64(res + 32,  alloc(MAX_NODES * 8));   // order array
    poke64(res + 40,  0);
    poke64(res + 48,  0);
}

pub fn ResolverFree(res: int64): void {
    var nodes: int64 := peek64(res);
    var nodeCount: int64 := peek64(res + 8);
    if (nodes != 0) {
        var i: int64 := 0;
        while (i < nodeCount) {
            var node: int64 := nodes + i * 56;
            if (peek64(node) != 0) { free(peek64(node)); }
            if (peek64(node + 8) != 0) { free(peek64(node + 8)); }
            if (peek64(node + 16) != 0) { free(peek64(node + 16)); }
            if (peek64(node + 24) != 0) { free(peek64(node + 24)); }
            if (peek64(node + 32) != 0) { free(peek64(node + 32)); }
            i := i + 1;
        }
        free(nodes);
    }
    if (peek64(res + 16) != 0) { free(peek64(res + 16)); }
    if (peek64(res + 32) != 0) { free(peek64(res + 32)); }
    if (peek64(res + 48) != 0) { free(peek64(res + 48)); }
}

fn resStrdup(s: int64): int64 {
    if (s == 0) { return 0; }
    var len: int64 := StrLen(s);
    var buf: int64 := alloc(len + 1);
    StrCpyN(buf, s, len);
    poke8(buf + len, 0);
    return buf;
}

// ============================================================================
// Graph-Operationen
// ============================================================================

// Sucht Knoten nach Name. Gibt Index zurück oder -1.
fn resFindNode(res: int64, name: int64): int64 {
    var nodes: int64 := peek64(res);
    var count: int64 := peek64(res + 8);
    var i: int64 := 0;
    while (i < count) {
        var node: int64 := nodes + i * 56;
        if (StrCmp(peek64(node), name) == 0) { return i; }
        i := i + 1;
    }
    return 0 - 1;
}

// Fügt einen Knoten hinzu (oder gibt Index des bestehenden zurück).
fn resAddNode(res: int64, name: int64, range: int64): int64 {
    var existing: int64 := resFindNode(res, name);
    if (existing >= 0) { return existing; }

    var count: int64 := peek64(res + 8);
    if (count >= MAX_NODES) { return 0 - 1; }

    var node: int64 := peek64(res) + count * 56;
    poke64(node,      resStrdup(name));
    poke64(node + 8,  0);  // version noch nicht aufgelöst
    poke64(node + 16, resStrdup(range));
    poke64(node + 24, 0);
    poke64(node + 32, 0);
    poke64(node + 40, 0);  // visited
    poke64(node + 48, 0);  // inStack

    poke64(res + 8, count + 1);
    return count;
}

// Fügt eine Kante from→to hinzu.
fn resAddEdge(res: int64, from: int64, to: int64): void {
    var count: int64 := peek64(res + 24);
    if (count >= MAX_EDGES) { return; }
    var edge: int64 := peek64(res + 16) + count * 16;
    poke64(edge,     from);
    poke64(edge + 8, to);
    poke64(res + 24, count + 1);
}

// ============================================================================
// BFS-Resolver
// ============================================================================

// Rekursive BFS: verarbeitet alle Dependencies eines Knotens.
fn resolveNode(res: int64, nodeIdx: int64, fetchFn: int64, userData: int64): int64 {
    var nodes: int64 := peek64(res);
    var node: int64 := nodes + nodeIdx * 56;
    var name: int64 := peek64(node);
    var range: int64 := peek64(node + 16);

    // Version via Registry-Callback auflösen
    // fetchFn(userData, name, range) → pchar version
    var resolvedVer: int64 := call_fn(fetchFn, userData, name, range);
    if (resolvedVer == 0) {
        // Nicht gefunden — Fehlermeldung setzen
        var msgLen: int64 := StrLen(name) + 48;
        var msg: int64 := alloc(msgLen);
        StrCpyN(msg, "Paket nicht gefunden: ", 22);
        StrCpyN(msg + 22, name, StrLen(name));
        poke8(msg + 22 + StrLen(name), 0);
        poke64(res + 48, msg);
        return ERR_RES_NOTFOUND;
    }

    // Prüfen ob schon eine andere Version dieses Pakets aufgelöst wurde
    var existingVer: int64 := peek64(node + 8);
    if (existingVer != 0) {
        // Konflikt-Prüfung: Sind beide Versionen SemVer-kompatibel?
        var svA: SemVer; var svB: SemVer;
        SemVerParse(existingVer, &svA);
        SemVerParse(resolvedVer, &svB);

        var newRange: SemVerRange;
        SemVerRangeParse(range, &newRange);

        if (SemVerSatisfies(&svA, &newRange) == 0) {
            // Konflikt: existierende Version erfüllt neue Range nicht
            var msgLen: int64 := StrLen(name) + StrLen(existingVer) + StrLen(range) + 64;
            var msg: int64 := alloc(msgLen);
            StrCpyN(msg, "Versionskonflikt: ", 18);
            StrCpyN(msg + 18, name, StrLen(name));
            StrCpyN(msg + 18 + StrLen(name), " hat bereits ", 13);
            var p: int64 := 18 + StrLen(name) + 13;
            StrCpyN(msg + p, existingVer, StrLen(existingVer));
            p := p + StrLen(existingVer);
            StrCpyN(msg + p, ", inkompatibel mit ", 19);
            p := p + 19;
            StrCpyN(msg + p, range, StrLen(range));
            poke8(msg + p + StrLen(range), 0);
            poke64(res + 48, msg);
            return ERR_RES_CONFLICT;
        }
        // Version passt — keine Änderung nötig
        return ERR_RES_OK;
    }

    poke64(node + 8, resStrdup(resolvedVer));

    // Dependencies des aufgelösten Pakets aus dem Cache/Registry holen
    // Hier vereinfacht: wir lesen lyx.toml aus dem Cache wenn vorhanden
    // In einer vollständigen Implementierung würde die Registry die Manifest-Daten liefern

    return ERR_RES_OK;
}

// Löst alle Dependencies eines Root-Manifests auf.
// fetchFn: Callback fn(userData, pkgName, rangeSpec): pchar version
pub fn ResolverResolve(res: int64, mf: int64, fetchFn: int64, userData: int64): int64 {
    var depCount: int64 := peek64(mf + 56);
    var deps: int64 := peek64(mf + 48);

    // Alle direkten Dependencies als Knoten eintragen
    var i: int64 := 0;
    while (i < depCount) {
        var dep: int64 := deps + i * 16;
        var dname: int64 := peek64(dep);
        var drange: int64 := peek64(dep + 8);
        var idx: int64 := resAddNode(res, dname, drange);
        if (idx < 0) { return ERR_RES_CONFLICT; }

        var rc: int64 := resolveNode(res, idx, fetchFn, userData);
        if (rc != ERR_RES_OK) { return rc; }
        i := i + 1;
    }

    return ERR_RES_OK;
}

// ============================================================================
// Topologische Sortierung (DFS post-order)
// ============================================================================

fn topoVisit(res: int64, idx: int64): int64 {
    var nodes: int64 := peek64(res);
    var node: int64 := nodes + idx * 56;

    if (peek64(node + 48) == 1) {
        // In aktuellem DFS-Stack → Zyklus
        poke64(res + 48, "Zyklus in Abhängigkeiten erkannt");
        return ERR_RES_CYCLE;
    }
    if (peek64(node + 40) == 1) { return ERR_RES_OK; }  // bereits verarbeitet

    poke64(node + 48, 1);  // inStack = true

    // Alle Kinder besuchen
    var edgeCount: int64 := peek64(res + 24);
    var edges: int64 := peek64(res + 16);
    var j: int64 := 0;
    while (j < edgeCount) {
        var edge: int64 := edges + j * 16;
        if (peek64(edge) == idx) {
            var rc: int64 := topoVisit(res, peek64(edge + 8));
            if (rc != ERR_RES_OK) { return rc; }
        }
        j := j + 1;
    }

    poke64(node + 48, 0);  // inStack = false
    poke64(node + 40, 1);  // visited = true

    // Zum Order-Array hinzufügen (post-order → Abhängigkeiten zuerst)
    var orderCount: int64 := peek64(res + 40);
    poke64(peek64(res + 32) + orderCount * 8, idx);
    poke64(res + 40, orderCount + 1);

    return ERR_RES_OK;
}

// Berechnet topologische Installationsreihenfolge.
pub fn ResolverTopoSort(res: int64): int64 {
    poke64(res + 40, 0);  // orderCount zurücksetzen

    var nodeCount: int64 := peek64(res + 8);
    var nodes: int64 := peek64(res);

    // visited-Flags zurücksetzen
    var i: int64 := 0;
    while (i < nodeCount) {
        var node: int64 := nodes + i * 56;
        poke64(node + 40, 0);
        poke64(node + 48, 0);
        i := i + 1;
    }

    i := 0;
    while (i < nodeCount) {
        if (peek64(nodes + i * 56 + 40) == 0) {
            var rc: int64 := topoVisit(res, i);
            if (rc != ERR_RES_OK) { return rc; }
        }
        i := i + 1;
    }

    return ERR_RES_OK;
}

// Gibt das Lock-File aus dem aufgelösten Graph.
pub fn ResolverBuildLockFile(res: int64, lf: int64): void {
    LockFileInit(lf);
    var nodeCount: int64 := peek64(res + 8);
    var nodes: int64 := peek64(res);
    var i: int64 := 0;
    while (i < nodeCount) {
        var node: int64 := nodes + i * 56;
        var name: int64 := peek64(node);
        var ver: int64 := peek64(node + 8);
        var sha: int64 := peek64(node + 24);
        var src: int64 := peek64(node + 32);
        if ((name != 0) & (ver != 0)) {
            LockFileUpsert(lf, name, ver, sha, src);
        }
        i := i + 1;
    }
}

// Gibt Resolver-Fehlermeldung zurück (0 wenn kein Fehler).
pub fn ResolverGetError(res: int64): int64 {
    return peek64(res + 48);
}
