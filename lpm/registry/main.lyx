// lpm/registry/main.lyx — lpm-registry Serverprogramm
// WP-PM-09
//
// Einstiegspunkt für den offiziellen Registry-Server.
// Kommandozeile: lpm-registry [--port <port>] [--db <conn>] [--data <dir>]

unit lpm.registry.main;

import std.string;
import std.alloc;
import std.io;
import std.env;
import lpm.registry.server;

pub fn _start(argc: int64, argv: int64): int64 {
    var port: int64 := DEFAULT_PORT;
    var dbConn: int64 := "host=localhost dbname=lyx_registry user=lpm";
    var dataDir: int64 := "/var/lib/lpm-registry";

    var i: int64 := 1;
    while (i < argc) {
        var arg: int64 := peek64(argv + i * 8);
        if ((StrCmp(arg, "--port") == 0) & (i + 1 < argc)) {
            i := i + 1;
            var portStr: int64 := peek64(argv + i * 8);
            port := StrToInt(portStr);
        }
        else if ((StrCmp(arg, "--db") == 0) & (i + 1 < argc)) {
            i := i + 1;
            dbConn := peek64(argv + i * 8);
        }
        else if ((StrCmp(arg, "--data") == 0) & (i + 1 < argc)) {
            i := i + 1;
            dataDir := peek64(argv + i * 8);
        }
        else if (StrCmp(arg, "--help") == 0) {
            PrintLn("lpm-registry — Lyx Package Registry Server");
            PrintLn("Nutzung: lpm-registry [--port N] [--db CONNSTR] [--data DIR]");
            PrintLn("  --port <n>      TCP-Port (Standard: 8080)");
            PrintLn("  --db <conn>     PostgreSQL Connection-String");
            PrintLn("  --data <dir>    Paket-Datei-Verzeichnis");
            return 0;
        }
        i := i + 1;
    }

    // Umgebungsvariablen überschreiben Defaults
    var envPort: int64 := EnvGet("LPM_REGISTRY_PORT");
    if (envPort != 0) { port := StrToInt(envPort); }

    var envDb: int64 := EnvGet("LPM_REGISTRY_DB");
    if (envDb != 0) { dbConn := envDb; }

    var envData: int64 := EnvGet("LPM_REGISTRY_DATA");
    if (envData != 0) { dataDir := envData; }

    var cfg: ServerConfig;
    poke64(&cfg,      port);
    poke64(&cfg + 8,  dbConn);
    poke64(&cfg + 16, dataDir);

    return ServerRun(&cfg);
}
