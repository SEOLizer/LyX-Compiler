// ============================================================================
// Konstanten
// ============================================================================

pub con SERVER_VERSION:    int64 := 0;    // "1.0.0"
pub con DEFAULT_PORT:      int64 := 8080;
pub con MAX_CONN_BACKLOG:  int64 := 128;
pub con MAX_BODY_SIZE:     int64 := 52428800;  // 50 MB (für Pakete)
pub con RATE_LIMIT_RPM:    int64 := 100;       // Requests/min pro IP

// ============================================================================
// Typen
// ============================================================================

pub type ServerConfig = struct {
    port:     int64;
    dbConn:   int64;   // pchar — PostgreSQL Connection-String
    dataDir:  int64;   // pchar — Paket-Datei-Storage
};

// HTTP-Request geparst aus TCP-Stream
type Request = struct {
    method:  int64;   // pchar
    path:    int64;   // pchar
    body:    int64;   // pchar
    bodyLen: int64;
    apiKey:  int64;   // pchar — aus Authorization-Header
    clientIp: int64;  // pchar
};

// ============================================================================
// Datenbank-Initialisierung
// ============================================================================

// Erstellt Tabellen wenn nicht vorhanden.
pub fn DbInit(pg: int64): int64 {
    var rc: int64;

    rc := PGExec(pg,
        "CREATE TABLE IF NOT EXISTS users ("
        "  id SERIAL PRIMARY KEY,"
        "  email TEXT UNIQUE NOT NULL,"
        "  api_key_hash TEXT NOT NULL,"
        "  created_at TIMESTAMP DEFAULT NOW()"
        ")");
    if (rc != 0) { return rc; }

    rc := PGExec(pg,
        "CREATE TABLE IF NOT EXISTS namespaces ("
        "  id SERIAL PRIMARY KEY,"
        "  name TEXT UNIQUE NOT NULL,"
        "  owner_id INTEGER REFERENCES users(id)"
        ")");
    if (rc != 0) { return rc; }

    rc := PGExec(pg,
        "CREATE TABLE IF NOT EXISTS packages ("
        "  id SERIAL PRIMARY KEY,"
        "  name TEXT UNIQUE NOT NULL,"
        "  namespace TEXT NOT NULL,"
        "  owner_id INTEGER REFERENCES users(id),"
        "  created_at TIMESTAMP DEFAULT NOW()"
        ")");
    if (rc != 0) { return rc; }

    rc := PGExec(pg,
        "CREATE TABLE IF NOT EXISTS versions ("
        "  id SERIAL PRIMARY KEY,"
        "  package_id INTEGER REFERENCES packages(id),"
        "  version TEXT NOT NULL,"
        "  sha256 TEXT NOT NULL,"
        "  manifest_json TEXT,"
        "  download_path TEXT,"
        "  created_at TIMESTAMP DEFAULT NOW(),"
        "  UNIQUE(package_id, version)"
        ")");
    if (rc != 0) { return rc; }

    rc := PGExec(pg,
        "CREATE TABLE IF NOT EXISTS downloads ("
        "  id SERIAL PRIMARY KEY,"
        "  version_id INTEGER REFERENCES versions(id),"
        "  timestamp TIMESTAMP DEFAULT NOW(),"
        "  ip_hash TEXT"
        ")");
    if (rc != 0) { return rc; }

    rc := PGExec(pg,
        "CREATE INDEX IF NOT EXISTS idx_packages_name ON packages(name)");
    PGExec(pg,
        "CREATE INDEX IF NOT EXISTS idx_versions_pkg ON versions(package_id)");

    return 0;
}

// ============================================================================
// HTTP-Request-Parser (minimales HTTP/1.1)
// ============================================================================

fn parseRequest(raw: int64, rawLen: int64, req: int64, clientIp: int64): void {
    poke64(req,      0); poke64(req + 8, 0);
    poke64(req + 16, 0); poke64(req + 24, 0);
    poke64(req + 32, 0); poke64(req + 40, clientIp);

    var pos: int64 := 0;

    // Methode
    var mStart: int64 := 0;
    while ((pos < rawLen) & (peek8(raw + pos) != 32)) { pos := pos + 1; }
    var method: int64 := alloc(pos + 1);
    StrCpyN(method, raw, pos);
    poke8(method + pos, 0);
    poke64(req, method);
    pos := pos + 1;

    // Pfad
    var pStart: int64 := pos;
    while ((pos < rawLen) & (peek8(raw + pos) != 32)) { pos := pos + 1; }
    var path: int64 := alloc(pos - pStart + 1);
    StrCpyN(path, raw + pStart, pos - pStart);
    poke8(path + pos - pStart, 0);
    poke64(req + 8, path);

    // Headers scannen nach Authorization und Content-Length
    var contentLength: int64 := 0;
    while (pos < rawLen) {
        if ((peek8(raw + pos) == 13) & (peek8(raw + pos + 1) == 10)) {
            if ((peek8(raw + pos + 2) == 13) & (peek8(raw + pos + 3) == 10)) {
                // Leerzeile = Ende der Header
                pos := pos + 4;
                break;
            }
        }
        if (StrCmpN(raw + pos, "Authorization: Bearer ", 22) == 0) {
            pos := pos + 22;
            var kStart: int64 := pos;
            while ((pos < rawLen) & (peek8(raw + pos) != 13) & (peek8(raw + pos) != 10)) { pos := pos + 1; }
            var apiKey: int64 := alloc(pos - kStart + 1);
            StrCpyN(apiKey, raw + kStart, pos - kStart);
            poke8(apiKey + pos - kStart, 0);
            poke64(req + 32, apiKey);
        }
        if (StrCmpN(raw + pos, "Content-Length: ", 16) == 0) {
            pos := pos + 16;
            contentLength := 0;
            while ((pos < rawLen) & (peek8(raw + pos) >= 48) & (peek8(raw + pos) <= 57)) {
                contentLength := contentLength * 10 + (peek8(raw + pos) - 48);
                pos := pos + 1;
            }
        }
        pos := pos + 1;
    }

    // Body
    if ((contentLength > 0) & (pos + contentLength <= rawLen)) {
        var body: int64 := alloc(contentLength + 1);
        StrCpyN(body, raw + pos, contentLength);
        poke8(body + contentLength, 0);
        poke64(req + 16, body);
        poke64(req + 24, contentLength);
    }
}

fn freeRequest(req: int64): void {
    if (peek64(req) != 0) { free(peek64(req)); }
    if (peek64(req + 8) != 0) { free(peek64(req + 8)); }
    if (peek64(req + 16) != 0) { free(peek64(req + 16)); }
    if (peek64(req + 32) != 0) { free(peek64(req + 32)); }
}

// ============================================================================
// HTTP-Response-Helfer
// ============================================================================

fn sendResponse(fd: int64, status: int64, statusText: int64, body: int64): void {
    var bodyLen: int64 := 0;
    if (body != 0) { bodyLen := StrLen(body); }

    var hdr: int64 := alloc(256);
    var hpos: int64 := 0;

    fn hws(s: int64): void {
        var l: int64 := StrLen(s);
        StrCpyN(hdr + hpos, s, l);
        hpos := hpos + l;
    }

    hws("HTTP/1.1 ");
    // Status-Code als String
    var statusBuf: int64 := alloc(16);
    var sv: int64 := status; var si: int64 := 9;
    poke8(statusBuf + 9, 0);
    while (si >= 0) {
        poke8(statusBuf + si, 48 + (sv % 10));
        sv := sv / 10;
        si := si - 1;
    }
    // Führende Nullen entfernen
    var sStart: int64 := 0;
    while ((sStart < 9) & (peek8(statusBuf + sStart) == 48)) { sStart := sStart + 1; }
    hws(statusBuf + sStart);
    free(statusBuf);
    hws(" "); hws(statusText); hws("\r\n");
    hws("Content-Type: application/json\r\n");
    hws("Access-Control-Allow-Origin: *\r\n");
    // Content-Length
    hws("Content-Length: ");
    var clBuf: int64 := alloc(16);
    var clv: int64 := bodyLen; var cli: int64 := 9;
    poke8(clBuf + 9, 0);
    while (cli >= 0) {
        poke8(clBuf + cli, 48 + (clv % 10));
        clv := clv / 10;
        cli := cli - 1;
    }
    var clStart: int64 := 0;
    while ((clStart < 9) & (peek8(clBuf + clStart) == 48)) { clStart := clStart + 1; }
    hws(clBuf + clStart); free(clBuf);
    hws("\r\n\r\n");
    poke8(hdr + hpos, 0);

    SocketWrite(fd, hdr, hpos);
    free(hdr);
    if (body != 0) { SocketWrite(fd, body, bodyLen); }
}

fn send200(fd: int64, body: int64): void { sendResponse(fd, 200, "OK", body); }
fn send201(fd: int64, body: int64): void { sendResponse(fd, 201, "Created", body); }
fn send400(fd: int64, msg: int64): void {
    var b: int64 := alloc(StrLen(msg) + 20);
    StrCpyN(b, "{\"error\":\"", 10);
    StrCpyN(b + 10, msg, StrLen(msg));
    StrCpyN(b + 10 + StrLen(msg), "\"}", 2);
    poke8(b + 12 + StrLen(msg), 0);
    sendResponse(fd, 400, "Bad Request", b);
    free(b);
}
fn send401(fd: int64): void { sendResponse(fd, 401, "Unauthorized", "{\"error\":\"Authentifizierung erforderlich\"}"); }
fn send404(fd: int64): void { sendResponse(fd, 404, "Not Found", "{\"error\":\"Nicht gefunden\"}"); }
fn send500(fd: int64): void { sendResponse(fd, 500, "Internal Server Error", "{\"error\":\"Interner Fehler\"}"); }

// ============================================================================
// Auth-Validierung
// ============================================================================

fn validateApiKey(pg: int64, apiKey: int64): int64 {
    if (apiKey == 0) { return 0; }

    var keyHash: int64 := alloc(68);
    var hash: int64 := alloc(32);
    SHA256(apiKey, StrLen(apiKey), hash);
    // Hex-Encode
    con HEX2: int64 := "0123456789abcdef";
    var i: int64 := 0;
    while (i < 32) {
        var b: int64 := peek8(hash + i);
        poke8(keyHash + i * 2,     peek8(HEX2 + (b >> 4)));
        poke8(keyHash + i * 2 + 1, peek8(HEX2 + (b & 0xF)));
        i := i + 1;
    }
    poke8(keyHash + 64, 0);
    free(hash);

    var sql: int64 := alloc(128);
    StrCpyN(sql, "SELECT id FROM users WHERE api_key_hash='", 41);
    StrCpyN(sql + 41, keyHash, 64);
    StrCpyN(sql + 105, "'", 1);
    poke8(sql + 106, 0);
    free(keyHash);

    var res: int64 := PGQuery(pg, sql);
    free(sql);
    var rowCount: int64 := PGNumRows(res);
    PGFreeResult(res);
    return (rowCount > 0) & 1;
}

// ============================================================================
// Route-Handler
// ============================================================================

// GET /v1/search?q=<query>&limit=20
fn handleSearch(pg: int64, fd: int64, path: int64): void {
    // Query-Parameter extrahieren
    var q: int64 := 0;
    var qPos: int64 := StrStr(path, "q=");
    if (qPos != 0) {
        q := qPos + 2;
    }
    if (q == 0) { send400(fd, "q Parameter fehlt"); return; }

    // Bis zum nächsten & oder Ende
    var qEnd: int64 := q;
    while ((peek8(qEnd) != 0) & (peek8(qEnd) != 38)) { qEnd := qEnd + 1; }
    var qLen: int64 := qEnd - q;

    var qBuf: int64 := alloc(qLen * 2 + 64);  // URL-dekodierter Query
    StrCpyN(qBuf, q, qLen);
    poke8(qBuf + qLen, 0);
    // '+' durch ' ' ersetzen
    var qi: int64 := 0;
    while (qi < qLen) {
        if (peek8(qBuf + qi) == 43) { poke8(qBuf + qi, 32); }
        qi := qi + 1;
    }

    var sql: int64 := alloc(qLen + 128);
    StrCpyN(sql, "SELECT p.name, v.version, v.manifest_json FROM packages p"
        " JOIN versions v ON v.package_id=p.id"
        " WHERE p.name ILIKE '%", 109);
    StrCpyN(sql + 109, qBuf, qLen);
    StrCpyN(sql + 109 + qLen, "%' ORDER BY p.name LIMIT 20", 27);
    poke8(sql + 136 + qLen, 0);
    free(qBuf);

    var res: int64 := PGQuery(pg, sql);
    free(sql);

    var buf: int64 := alloc(8192);
    poke8(buf, 91); poke8(buf + 1, 0);  // '['
    var bpos: int64 := 1;

    fn bws(s: int64): void {
        var l: int64 := StrLen(s);
        StrCpyN(buf + bpos, s, l);
        bpos := bpos + l;
    }

    var rows: int64 := PGNumRows(res);
    var ri: int64 := 0;
    while (ri < rows) {
        if (ri > 0) { bws(","); }
        bws("{\"name\":\"");
        bws(PGGetValue(res, ri, 0));
        bws("\",\"version\":\"");
        bws(PGGetValue(res, ri, 1));
        bws("\",\"description\":\"\"}");
        ri := ri + 1;
    }
    PGFreeResult(res);

    bws("]");
    poke8(buf + bpos, 0);
    send200(fd, buf);
    free(buf);
}

// GET /v1/package/<name>
fn handlePackageInfo(pg: int64, fd: int64, name: int64): void {
    var sql: int64 := alloc(StrLen(name) + 128);
    StrCpyN(sql, "SELECT p.name, u.email, p.created_at FROM packages p"
        " LEFT JOIN users u ON u.id=p.owner_id WHERE p.name='", 103);
    StrCpyN(sql + 103, name, StrLen(name));
    poke8(sql + 103 + StrLen(name), 39); poke8(sql + 104 + StrLen(name), 0);

    var res: int64 := PGQuery(pg, sql);
    free(sql);
    if (PGNumRows(res) == 0) { PGFreeResult(res); send404(fd); return; }

    var pname: int64 := PGGetValue(res, 0, 0);
    var author: int64 := PGGetValue(res, 0, 1);

    // Versionen holen
    var sql2: int64 := alloc(StrLen(name) + 128);
    StrCpyN(sql2, "SELECT version FROM versions v"
        " JOIN packages p ON p.id=v.package_id WHERE p.name='", 82);
    StrCpyN(sql2 + 82, name, StrLen(name));
    poke8(sql2 + 82 + StrLen(name), 39); poke8(sql2 + 83 + StrLen(name), 0);

    var res2: int64 := PGQuery(pg, sql2);
    free(sql2);

    var buf: int64 := alloc(4096);
    var bpos: int64 := 0;

    fn bws(s: int64): void {
        var l: int64 := StrLen(s);
        StrCpyN(buf + bpos, s, l);
        bpos := bpos + l;
    }

    bws("{\"name\":\""); bws(pname);
    bws("\",\"author\":\""); bws(author != 0 ? author : "");
    bws("\",\"versions\":[");
    var rows2: int64 := PGNumRows(res2);
    var ri: int64 := 0;
    while (ri < rows2) {
        if (ri > 0) { bws(","); }
        bws("\""); bws(PGGetValue(res2, ri, 0)); bws("\"");
        ri := ri + 1;
    }
    bws("]}");
    poke8(buf + bpos, 0);

    PGFreeResult(res); PGFreeResult(res2);
    send200(fd, buf);
    free(buf);
}

// GET /v1/package/<name>/<version>
fn handlePackageVersion(pg: int64, fd: int64, name: int64, version: int64): void {
    var sql: int64 := alloc(StrLen(name) + StrLen(version) + 200);
    StrCpyN(sql, "SELECT v.sha256, v.download_path, v.manifest_json FROM versions v"
        " JOIN packages p ON p.id=v.package_id WHERE p.name='", 116);
    var pos: int64 := 116;
    StrCpyN(sql + pos, name, StrLen(name)); pos := pos + StrLen(name);
    StrCpyN(sql + pos, "' AND v.version='", 17); pos := pos + 17;
    StrCpyN(sql + pos, version, StrLen(version)); pos := pos + StrLen(version);
    poke8(sql + pos, 39); poke8(sql + pos + 1, 0);

    var res: int64 := PGQuery(pg, sql);
    free(sql);
    if (PGNumRows(res) == 0) { PGFreeResult(res); send404(fd); return; }

    var sha256: int64 := PGGetValue(res, 0, 0);
    var dlPath: int64 := PGGetValue(res, 0, 1);

    var buf: int64 := alloc(4096);
    var bpos2: int64 := 0;

    fn bws2(s: int64): void {
        var l: int64 := StrLen(s);
        StrCpyN(buf + bpos2, s, l);
        bpos2 := bpos2 + l;
    }

    bws2("{\"name\":\""); bws2(name);
    bws2("\",\"version\":\""); bws2(version);
    bws2("\",\"sha256\":\""); bws2(sha256);
    bws2("\",\"download_url\":\"https://registry.lyx-lang.org/v1/download/");
    bws2(name); bws2("/"); bws2(version);
    bws2("\"}");
    poke8(buf + bpos2, 0);

    PGFreeResult(res);
    send200(fd, buf);
    free(buf);
}

// POST /v1/publish
fn handlePublish(pg: int64, fd: int64, req: int64, dataDir: int64): void {
    // Auth prüfen
    if (validateApiKey(pg, peek64(req + 32)) == 0) {
        send401(fd);
        return;
    }

    // Body ist rohe .lxpkg-Datei
    var body: int64 := peek64(req + 16);
    var bodyLen: int64 := peek64(req + 24);
    if ((body == 0) | (bodyLen == 0)) {
        send400(fd, "Leerer Body");
        return;
    }

    // TODO: Manifest aus .lxpkg lesen (vereinfacht: Header aus Content-Disposition)
    // Vereinfachte Implementierung: speichern und in DB eintragen
    var tmpPath: int64 := alloc(StrLen(dataDir) + 32);
    StrCpyN(tmpPath, dataDir, StrLen(dataDir));
    StrCpyN(tmpPath + StrLen(dataDir), "/upload.lxpkg", 13);
    poke8(tmpPath + StrLen(dataDir) + 13, 0);

    FileWriteAll(tmpPath, body, bodyLen);
    free(tmpPath);

    send201(fd, "{\"status\":\"published\"}");
}

// ============================================================================
// Request-Dispatch
// ============================================================================

fn handleRequest(pg: int64, fd: int64, req: int64, dataDir: int64): void {
    var method: int64 := peek64(req);
    var path: int64 := peek64(req + 8);

    if (path == 0) { send400(fd, "Kein Pfad"); return; }

    // GET /v1/search
    if ((StrCmp(method, "GET") == 0) & (StrCmpN(path, "/v1/search", 10) == 0)) {
        handleSearch(pg, fd, path);
        return;
    }

    // GET /v1/package/<name> oder /v1/package/<name>/<version>
    if ((StrCmp(method, "GET") == 0) & (StrCmpN(path, "/v1/package/", 12) == 0)) {
        var pkgPart: int64 := path + 12;
        // Suche zweiten '/' für version
        var slashPos: int64 := 0;
        while ((peek8(pkgPart + slashPos) != 0) & (peek8(pkgPart + slashPos) != 47)) {
            slashPos := slashPos + 1;
        }
        var nameBuf: int64 := alloc(slashPos + 1);
        StrCpyN(nameBuf, pkgPart, slashPos);
        poke8(nameBuf + slashPos, 0);

        if (peek8(pkgPart + slashPos) == 47) {
            handlePackageVersion(pg, fd, nameBuf, pkgPart + slashPos + 1);
        } else {
            handlePackageInfo(pg, fd, nameBuf);
        }
        free(nameBuf);
        return;
    }

    // POST /v1/publish
    if ((StrCmp(method, "POST") == 0) & (StrCmp(path, "/v1/publish") == 0)) {
        handlePublish(pg, fd, req, dataDir);
        return;
    }

    send404(fd);
}

// ============================================================================
// Server-Hauptschleife
// ============================================================================

pub fn ServerRun(cfg: int64): int64 {
    var port: int64 := peek64(cfg);
    var dbConnStr: int64 := peek64(cfg + 8);
    var dataDir: int64 := peek64(cfg + 16);

    // Postgres verbinden
    var pg: int64 := PGConnect(dbConnStr);
    if (pg == 0) {
        PrintLn("registry: Datenbankverbindung fehlgeschlagen");
        return 1;
    }
    if (DbInit(pg) != 0) {
        PrintLn("registry: Datenbank-Init fehlgeschlagen");
        PGDisconnect(pg);
        return 1;
    }

    // TCP-Listener
    var listener: TCPListener := TCPListenerCreate(port);
    if (listener.fd <= 0) {
        PrintLn("registry: Listener konnte nicht erstellt werden");
        PGDisconnect(pg);
        return 1;
    }

    Print("registry: Läuft auf Port ");
    PrintInt(port);
    PrintLn("");

    var recvBuf: int64 := alloc(MAX_BODY_SIZE + 4096);

    while (1 == 1) {
        var conn: TCPConn := TCPListenerAccept(listener);
        if (conn.fd <= 0) { }
        else {
            var n: int64 := SocketRead(conn.fd, recvBuf, MAX_BODY_SIZE + 4095);
            if (n > 0) {
                poke8(recvBuf + n, 0);
                var req: Request;
                parseRequest(recvBuf, n, &req, "0.0.0.0");
                handleRequest(pg, conn.fd, &req, dataDir);
                freeRequest(&req);
            }
            SocketClose(conn.fd);
        }
    }

    free(recvBuf);
    PGDisconnect(pg);
    return 0;
}
