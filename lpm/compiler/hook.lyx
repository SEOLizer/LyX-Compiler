// lpm/compiler/hook.lyx — lyxc-Integration
// WP-PM-07
//
// Implementiert den lpm-seitigen Teil des lyxc-Hooks.
// lyxc ruft "lpm resolve <pkg>" auf und liest den Cache-Pfad von stdout.
//
// Exit-Codes:
//   0 = Paket gefunden, Cache-Pfad auf stdout
//   1 = Paket nicht gefunden

unit lpm.compiler.hook;

import std.string;
import std.alloc;
import std.io;
import std.fs;
import std.env;
import lpm.core.cache;
import lpm.core.lockfile;
import lpm.net.registry;
import lpm.net.download;
import lpm.core.archive;

// ============================================================================
// Konstanten
// ============================================================================

pub con HOOK_EXIT_OK:       int64 := 0;
pub con HOOK_EXIT_NOTFOUND: int64 := 1;

// Resolve-Modi (entsprechen --pkg-resolve Flag in lyxc)
pub con RESOLVE_AUTO:   int64 := 0;   // resolve wenn lyx.toml vorhanden
pub con RESOLVE_ALWAYS: int64 := 1;   // immer resolve
pub con RESOLVE_NEVER:  int64 := 2;   // nie resolve

// ============================================================================
// Hook-Logik
// ============================================================================

// Prüft ob wir im Auto-Modus auflösen sollen.
pub fn HookShouldResolve(mode: int64): int64 {
    if (mode == RESOLVE_NEVER) { return 0; }
    if (mode == RESOLVE_ALWAYS) { return 1; }
    // RESOLVE_AUTO: nur wenn lyx.toml vorhanden
    return FileExists("lyx.toml");
}

// Gibt Import-Pfad für ein Paket zurück (aus Lock-File und Cache).
// Gibt 0 zurück wenn nicht gecacht. Aufrufer muss free().
pub fn HookGetCachedPath(lpmHome: int64, pkgName: int64): int64 {
    var lf: LockFile;
    if (FileExists("lyx.lock") == 0) { return 0; }

    LockFileParse("lyx.lock", &lf);
    var locked: int64 := LockFileFind(&lf, pkgName);
    if (locked == 0) { LockFileFree(&lf); return 0; }

    var ver: int64 := peek64(locked + 8);
    if (CacheHas(lpmHome, pkgName, ver) == 0) {
        LockFileFree(&lf);
        return 0;
    }

    var path: int64 := CachePkgPath(lpmHome, pkgName, ver);
    LockFileFree(&lf);
    return path;
}

// Hauptfunktion des Hooks: wird von lpm resolve aufgerufen.
// pkgName: Paketname aus lyxc-Import-Fehler
// registryUrl: Registry-URL (0 = Standard)
// offline: 1 = kein Netzwerk
// Gibt Exit-Code zurück (0 = OK, 1 = nicht gefunden).
pub fn HookResolve(pkgName: int64, registryUrl: int64, offline: int64): int64 {
    var lpmHome: int64 := CacheGetHome();
    CacheInit(lpmHome);

    // 1. Im Cache suchen
    var cachedPath: int64 := HookGetCachedPath(lpmHome, pkgName);
    if (cachedPath != 0) {
        PrintLn(cachedPath);
        free(cachedPath);
        free(lpmHome);
        return HOOK_EXIT_OK;
    }

    // 2. Offline = nicht gefunden
    if (offline == 1) {
        EPrint("lpm resolve: Paket nicht im Cache: ");
        EPrintLn(pkgName);
        free(lpmHome);
        return HOOK_EXIT_NOTFOUND;
    }

    // 3. Von Registry herunterladen
    var regUrl: int64 := registryUrl;
    if (regUrl == 0) { regUrl := "https://registry.lyx-lang.org"; }

    var rc: RegistryClient;
    RegistryClientInit(&rc, regUrl, 0);

    var bestVer: int64 := RegistryFetchBestVersion(&rc, pkgName, "latest");
    if (bestVer == 0) {
        EPrint("lpm resolve: Paket nicht in Registry: ");
        EPrintLn(pkgName);
        RegistryClientFree(&rc);
        free(lpmHome);
        return HOOK_EXIT_NOTFOUND;
    }

    var sha256Ptr: int64 := alloc(8);
    var urlPtr: int64 := alloc(8);
    RegistryGetVersion(&rc, pkgName, bestVer, sha256Ptr, urlPtr);

    var sha256: int64 := peek64(sha256Ptr);
    var url: int64 := peek64(urlPtr);
    free(sha256Ptr); free(urlPtr);
    RegistryClientFree(&rc);

    if ((sha256 == 0) | (url == 0)) {
        EPrint("lpm resolve: Keine Version-Info für: ");
        EPrintLn(pkgName);
        if (sha256 != 0) { free(sha256); }
        if (url != 0) { free(url); }
        free(bestVer); free(lpmHome);
        return HOOK_EXIT_NOTFOUND;
    }

    // Download
    var tmpPkg: int64 := alloc(StrLen(lpmHome) + 20);
    StrCpyN(tmpPkg, lpmHome, StrLen(lpmHome));
    StrCpyN(tmpPkg + StrLen(lpmHome), "/_resolve.lxpkg", 15);
    poke8(tmpPkg + StrLen(lpmHome) + 15, 0);

    var dlRc: int64 := DownloadPackage(url, tmpPkg, sha256, pkgName, bestVer);
    if (sha256 != 0) { free(sha256); }
    if (url != 0) { free(url); }

    if (dlRc != ERR_DL_OK) {
        EPrint("lpm resolve: Download fehlgeschlagen für: ");
        EPrintLn(pkgName);
        free(tmpPkg); free(bestVer); free(lpmHome);
        return HOOK_EXIT_NOTFOUND;
    }

    // Entpacken
    var pkgPath: int64 := CachePkgPath(lpmHome, pkgName, bestVer);
    MkDirAll(pkgPath);
    var exRc: int64 := ArchiveExtract(tmpPkg, pkgPath);
    free(tmpPkg);

    if (exRc != ERR_AR_OK) {
        EPrint("lpm resolve: Entpacken fehlgeschlagen für: ");
        EPrintLn(pkgName);
        free(pkgPath); free(bestVer); free(lpmHome);
        return HOOK_EXIT_NOTFOUND;
    }

    // Erfolg: Pfad ausgeben
    PrintLn(pkgPath);

    free(pkgPath); free(bestVer); free(lpmHome);
    return HOOK_EXIT_OK;
}

// ============================================================================
// lyxc-seitige Hilfsfunktion (in lyxc einzubinden)
// ============================================================================

// Ruft "lpm resolve <pkgName>" als Subprozess auf.
// Gibt den Cache-Pfad zurück (aus stdout von lpm resolve) oder 0.
// Aufrufer muss free().
pub fn HookCallLpm(pkgName: int64, resolveMode: int64): int64 {
    if (HookShouldResolve(resolveMode) == 0) { return 0; }

    // Kommando aufbauen: "lpm resolve <pkgName>"
    var cmdLen: int64 := StrLen(pkgName) + 16;
    var cmd: int64 := alloc(cmdLen);
    StrCpyN(cmd, "lpm resolve ", 12);
    StrCpyN(cmd + 12, pkgName, StrLen(pkgName));
    poke8(cmd + 12 + StrLen(pkgName), 0);

    // popen-ähnlich: Pipe-Output lesen
    // Lyx nutzt sys_fork + sys_execve + sys_pipe für Subprocess
    // Vereinfachte Implementierung via process.lyx
    import std.process;

    var result: int64 := alloc(4096);
    var rc: int64 := ProcessOutput(cmd, result, 4095);
    free(cmd);

    if (rc != 0) { free(result); return 0; }

    // Trailing Newline entfernen
    var len: int64 := StrLen(result);
    while ((len > 0) & ((peek8(result + len - 1) == 10) | (peek8(result + len - 1) == 13))) {
        len := len - 1;
    }
    poke8(result + len, 0);

    if (len == 0) { free(result); return 0; }
    return result;
}
