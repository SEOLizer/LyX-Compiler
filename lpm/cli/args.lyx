// lpm/cli/args.lyx — Argument-Parser
// WP-PM-02
//
// Tokenisiert argv[] in Command + Flags + Argumente.
// Globale Flags: --verbose, --offline, --registry <url>, --version, --help

unit lpm.cli.args;

import std.string;
import std.alloc;
import std.io;

// ============================================================================
// Typen
// ============================================================================

pub con MAX_ARGS:   int64 := 64;
pub con MAX_FLAGS:  int64 := 32;

pub type ParsedArgs = struct {
    command:   int64;   // pchar — Subcommand ("install", "remove", ...)
    subArg:    int64;   // pchar — erstes Argument nach Command (Paketname etc.)

    // Positionale Argumente (nach command)
    args:      int64;   // pchar*-Array
    argCount:  int64;

    // Flags
    verbose:   int64;   // --verbose
    offline:   int64;   // --offline
    registry:  int64;   // pchar — --registry <url>
    showHelp:  int64;   // --help
    showVer:   int64;   // --version
    member:    int64;   // pchar — --member <name> (für workspace)
    devDeps:   int64;   // --dev (dev-dependencies einschließen)
};

// ============================================================================
// Parser
// ============================================================================

pub fn ArgsParse(argc: int64, argv: int64, out: int64): void {
    var pa: ParsedArgs;
    pa.command := 0; pa.subArg := 0;
    pa.args := alloc(MAX_ARGS * 8);
    pa.argCount := 0;
    pa.verbose := 0; pa.offline := 0;
    pa.registry := 0; pa.showHelp := 0; pa.showVer := 0;
    pa.member := 0; pa.devDeps := 0;

    var i: int64 := 1;  // argv[0] = Programmname überspringen
    var commandSet: int64 := 0;

    while (i < argc) {
        var arg: int64 := peek64(argv + i * 8);
        if (arg == 0) { i := i + 1; }
        else {
            var fc: int64 := peek8(arg);

            if ((fc == 45) & (peek8(arg + 1) == 45)) {
                // --flag
                var flag: int64 := arg + 2;
                if (StrCmp(flag, "verbose") == 0) { pa.verbose := 1; }
                else if (StrCmp(flag, "offline") == 0) { pa.offline := 1; }
                else if (StrCmp(flag, "help") == 0) { pa.showHelp := 1; }
                else if (StrCmp(flag, "version") == 0) { pa.showVer := 1; }
                else if (StrCmp(flag, "dev") == 0) { pa.devDeps := 1; }
                else if (StrCmp(flag, "registry") == 0) {
                    i := i + 1;
                    if (i < argc) { pa.registry := peek64(argv + i * 8); }
                }
                else if (StrCmp(flag, "member") == 0) {
                    i := i + 1;
                    if (i < argc) { pa.member := peek64(argv + i * 8); }
                }
            }
            else if (commandSet == 0) {
                // Erster Nicht-Flag-Wert = Subcommand
                pa.command := arg;
                commandSet := 1;
            }
            else {
                // Weiteres Argument
                if (pa.subArg == 0) { pa.subArg := arg; }
                if (pa.argCount < MAX_ARGS) {
                    poke64(pa.args + pa.argCount * 8, arg);
                    pa.argCount := pa.argCount + 1;
                }
            }
            i := i + 1;
        }
    }

    poke_struct(out, pa, 88);  // sizeof(ParsedArgs)
}

pub fn ArgsFree(pa: int64): void {
    var args: int64 := peek64(pa + 16);
    if (args != 0) { free(args); }
}

// ============================================================================
// Hilfe-Ausgabe
// ============================================================================

pub fn PrintHelp(): void {
    PrintLn("lpm — Lyx Package Manager v1.0.0");
    PrintLn("");
    PrintLn("NUTZUNG:");
    PrintLn("  lpm <subcommand> [optionen] [argumente]");
    PrintLn("");
    PrintLn("SUBCOMMANDS:");
    PrintLn("  init [--name <name>]          Neues Paket anlegen (lyx.toml erstellen)");
    PrintLn("  install [pkg[@version]]        Paket installieren / alle aus lyx.toml");
    PrintLn("  remove <pkg>                   Paket entfernen");
    PrintLn("  update [pkg]                   Paket aktualisieren");
    PrintLn("  search <query>                 Registry durchsuchen");
    PrintLn("  info <pkg>                     Paketdetails anzeigen");
    PrintLn("  list                           Installierte Pakete auflisten");
    PrintLn("  publish                        Paket in Registry hochladen");
    PrintLn("  login                          Registry-Authentifizierung");
    PrintLn("  resolve <pkg>                  lyxc-Hook: Paket auflösen");
    PrintLn("  cache list                     Gecachte Pakete anzeigen");
    PrintLn("  cache clean                    Cache leeren");
    PrintLn("");
    PrintLn("GLOBALE FLAGS:");
    PrintLn("  --verbose                      Detaillierte Ausgabe");
    PrintLn("  --offline                      Nur Cache nutzen, kein Netzwerk");
    PrintLn("  --registry <url>               Andere Registry verwenden");
    PrintLn("  --version                      Version ausgeben");
    PrintLn("  --help                         Diese Hilfe anzeigen");
}

pub fn PrintVersion(): void {
    PrintLn("lpm 1.0.0 (Lyx Package Manager)");
}
