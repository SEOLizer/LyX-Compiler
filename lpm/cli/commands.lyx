// ============================================================================
// Hilfsfunktionen
// ============================================================================

fn cmdStrdup(s: int64): int64 {
    if (s == 0) { return 0; }
    var len: int64 := StrLen(s);
    var buf: int64 := alloc(len + 1);
    StrCpyN(buf, s, len);
    poke8(buf + len, 0);
    return buf;
}

fn pathJoin(a: int64, b: int64): int64 {
    var aLen: int64 := StrLen(a);
    var bLen: int64 := StrLen(b);
    var buf: int64 := alloc(aLen + bLen + 4);
    StrCpyN(buf, a, aLen);
    poke8(buf + aLen, 47);
    StrCpyN(buf + aLen + 1, b, bLen);
    poke8(buf + aLen + 1 + bLen, 0);
    return buf;
}

// Initialisiert Registry-Client aus ParsedArgs.
fn makeRegistryClient(pa: int64, rc: int64): void {
    var regUrl: int64 := peek64(pa + 32);  // registry override
    if (regUrl == 0) { regUrl := "https://registry.lyx-lang.org"; }

    // API-Key aus ~/.lpm/config.toml laden
    var lpmHome: int64 := CacheGetHome();
    var cfgPath: int64 := CacheConfigPath(lpmHome);
    var apiKey: int64 := 0;
    if (FileExists(cfgPath) == 1) {
        var cfgData: int64 := FileReadAll(cfgPath);
        if (cfgData != 0) {
            // Suche "api_key = <wert>"
            var p: int64 := 0;
            var cfgLen: int64 := StrLen(cfgData);
            while (p < cfgLen) {
                if (StrCmpN(cfgData + p, "api_key", 7) == 0) {
                    p := p + 7;
                    while ((peek8(cfgData + p) != 34) & (p < cfgLen)) { p := p + 1; }
                    if (p < cfgLen) {
                        p := p + 1;
                        var start: int64 := p;
                        while ((peek8(cfgData + p) != 34) & (p < cfgLen)) { p := p + 1; }
                        var len: int64 := p - start;
                        apiKey := alloc(len + 1);
                        StrCpyN(apiKey, cfgData + start, len);
                        poke8(apiKey + len, 0);
                    }
                }
                p := p + 1;
            }
            free(cfgData);
        }
    }
    free(cfgPath); free(lpmHome);

    RegistryClientInit(rc, regUrl, apiKey);
    RegistryClientSetOffline(rc, peek64(pa + 24));  // offline flag
    if (apiKey != 0) { free(apiKey); }
}

// Registry-Fetch-Callback für den Resolver.
// userData zeigt auf RegistryClient.
fn fetchVersionCallback(userData: int64, name: int64, range: int64): int64 {
    return RegistryFetchBestVersion(userData, name, range);
}

// ============================================================================
// lpm init
// ============================================================================

pub fn CmdInit(pa: int64): int64 {
    var name: int64 := peek64(pa + 8);  // subArg oder --name
    if (name == 0) { name := "my-package"; }

    if (FileExists("lyx.toml") == 1) {
        PrintLn("lpm: lyx.toml existiert bereits.");
        return 1;
    }

    var mf: Manifest;
    poke64(&mf,       cmdStrdup(name));
    poke64(&mf + 8,   cmdStrdup("0.1.0"));
    poke64(&mf + 16,  cmdStrdup(""));
    poke64(&mf + 24,  cmdStrdup("MIT"));
    poke64(&mf + 32,  cmdStrdup(""));
    poke64(&mf + 40,  cmdStrdup("main.lyx"));
    poke64(&mf + 48,  alloc(128 * 16));
    poke64(&mf + 56,  0);
    poke64(&mf + 64,  alloc(128 * 16));
    poke64(&mf + 72,  0);
    poke64(&mf + 80,  1);

    var rc: int64 := ManifestWrite(&mf, "lyx.toml");
    ManifestFree(&mf);

    if (rc != ERR_MF_OK) {
        PrintLn("lpm: Fehler beim Schreiben von lyx.toml");
        return 1;
    }

    Print("lpm: Paket '");
    Print(name);
    PrintLn("' initialisiert. Bearbeite lyx.toml um die Metadaten anzupassen.");
    return 0;
}

// ============================================================================
// lpm install
// ============================================================================

pub fn CmdInstall(pa: int64): int64 {
    var lpmHome: int64 := CacheGetHome();
    CacheInit(lpmHome);

    var rc: RegistryClient;
    makeRegistryClient(pa, &rc);

    // Manifest lesen (oder anlegen wenn lyx.toml fehlt)
    var mf: Manifest;
    var mfExists: int64 := FileExists("lyx.toml");
    if (mfExists == 1) {
        if (ManifestParse("lyx.toml", &mf) != ERR_MF_OK) {
            PrintLn("lpm: Fehler beim Parsen von lyx.toml");
            RegistryClientFree(&rc); free(lpmHome);
            return 1;
        }
    } else {
        // Neues Manifest wenn ein spezifisches Paket angegeben
        poke64(&mf,      cmdStrdup("unnamed"));
        poke64(&mf + 8,  cmdStrdup("0.1.0"));
        poke64(&mf + 16, 0); poke64(&mf + 24, 0);
        poke64(&mf + 32, 0); poke64(&mf + 40, 0);
        poke64(&mf + 48, alloc(128 * 16));
        poke64(&mf + 56, 0);
        poke64(&mf + 64, alloc(128 * 16));
        poke64(&mf + 72, 0);
        poke64(&mf + 80, 1);
    }

    // Spezifisches Paket hinzufügen (lpm install net/http@1.2.0)?
    var specificPkg: int64 := peek64(pa + 8);  // subArg
    if (specificPkg != 0) {
        // Format: "name[@version]"
        var atPos: int64 := 0;
        while ((peek8(specificPkg + atPos) != 0) & (peek8(specificPkg + atPos) != 64)) {
            atPos := atPos + 1;
        }
        var pkgName: int64 := alloc(atPos + 1);
        StrCpyN(pkgName, specificPkg, atPos);
        poke8(pkgName + atPos, 0);

        var pkgRange: int64;
        if (peek8(specificPkg + atPos) == 64) {
            pkgRange := specificPkg + atPos + 1;
        } else {
            pkgRange := "latest";
        }

        // In Manifest eintragen
        var deps: int64 := peek64(&mf + 48);
        var depCount: int64 := peek64(&mf + 56);
        if (depCount < MAX_DEPS) {
            poke64(deps + depCount * 16,     cmdStrdup(pkgName));
            poke64(deps + depCount * 16 + 8, cmdStrdup(pkgRange));
            poke64(&mf + 56, depCount + 1);
        }
        free(pkgName);
        ManifestWrite(&mf, "lyx.toml");
    }

    // Lock-File lesen
    var lf: LockFile;
    LockFileParse("lyx.lock", &lf);

    // Resolver
    var res: Resolver;
    ResolverInit(&res);

    var errCode: int64 := ResolverResolve(&res, &mf, fetchVersionCallback, &rc);
    if (errCode != ERR_RES_OK) {
        PrintLn(ResolverGetError(&res));
        ResolverFree(&res); LockFileFree(&lf);
        ManifestFree(&mf); RegistryClientFree(&rc); free(lpmHome);
        return 1;
    }

    // Topologisch sortieren
    ResolverTopoSort(&res);

    // Pakete installieren
    var order: int64 := peek64(&res + 32);
    var orderCount: int64 := peek64(&res + 40);
    var nodes: int64 := peek64(&res);
    var installed: int64 := 0;

    var i: int64 := 0;
    while (i < orderCount) {
        var nodeIdx: int64 := peek64(order + i * 8);
        var node: int64 := nodes + nodeIdx * 56;
        var pkgName: int64 := peek64(node);
        var pkgVer: int64 := peek64(node + 8);

        if ((pkgName != 0) & (pkgVer != 0)) {
            if (CacheHas(lpmHome, pkgName, pkgVer) == 1) {
                // Cache-Hit — kein Download
                if (peek64(pa + 8) != 0) {  // verbose
                    Print("lpm: cached ");
                    Print(pkgName);
                    Print(" ");
                    PrintLn(pkgVer);
                }
            } else {
                // Download
                var sha256Ptr: int64 := alloc(8);
                var urlPtr: int64 := alloc(8);
                var regRc: int64 := RegistryGetVersion(&rc, pkgName, pkgVer, sha256Ptr, urlPtr);

                if (regRc == ERR_REG_OK) {
                    var sha256: int64 := peek64(sha256Ptr);
                    var url: int64 := peek64(urlPtr);

                    // Temporärer Pfad für Download
                    var tmpPkg: int64 := alloc(StrLen(lpmHome) + 32);
                    StrCpyN(tmpPkg, lpmHome, StrLen(lpmHome));
                    StrCpyN(tmpPkg + StrLen(lpmHome), "/tmp.lxpkg", 10);
                    poke8(tmpPkg + StrLen(lpmHome) + 10, 0);

                    var dlRc: int64 := DownloadPackage(url, tmpPkg, sha256, pkgName, pkgVer);
                    if (dlRc == ERR_DL_OK) {
                        // In Cache entpacken
                        var pkgPath: int64 := CachePkgPath(lpmHome, pkgName, pkgVer);
                        MkDirAll(pkgPath);
                        var exRc: int64 := ArchiveExtract(tmpPkg, pkgPath);
                        free(pkgPath);

                        if (exRc == ERR_AR_OK) {
                            // Lock-File aktualisieren
                            LockFileUpsert(&lf, pkgName, pkgVer, sha256, url);
                            // Cache-Index aktualisieren
                            CacheIndexUpdate(lpmHome, pkgName, pkgVer, sha256, url);
                            installed := installed + 1;
                        } else {
                            PrintLn("lpm: Fehler beim Entpacken");
                        }
                    }
                    if (sha256 != 0) { free(sha256); }
                    if (url != 0) { free(url); }
                    free(tmpPkg);
                }
                free(sha256Ptr); free(urlPtr);
            }
        }
        i := i + 1;
    }

    // Lock-File schreiben
    LockFileWrite(&lf, "lyx.lock");

    if (installed > 0) {
        Print("lpm: ");
        PrintInt(installed);
        PrintLn(" Paket(e) installiert");
    } else {
        PrintLn("lpm: alle Pakete aktuell");
    }

    ResolverFree(&res); LockFileFree(&lf);
    ManifestFree(&mf); RegistryClientFree(&rc); free(lpmHome);
    return 0;
}

// ============================================================================
// lpm remove
// ============================================================================

pub fn CmdRemove(pa: int64): int64 {
    var pkgName: int64 := peek64(pa + 8);
    if (pkgName == 0) {
        PrintLn("lpm remove: Paketname erforderlich");
        return 1;
    }

    var mf: Manifest;
    if (ManifestParse("lyx.toml", &mf) != ERR_MF_OK) {
        PrintLn("lpm: lyx.toml nicht gefunden oder fehlerhaft");
        return 1;
    }

    // Dependency aus Liste entfernen
    var deps: int64 := peek64(&mf + 48);
    var depCount: int64 := peek64(&mf + 56);
    var found: int64 := 0;
    var i: int64 := 0;
    while (i < depCount) {
        var dep: int64 := deps + i * 16;
        if (StrCmp(peek64(dep), pkgName) == 0) {
            if (peek64(dep) != 0) { free(peek64(dep)); }
            if (peek64(dep + 8) != 0) { free(peek64(dep + 8)); }
            // Letzten Eintrag an diese Stelle kopieren
            if (i < depCount - 1) {
                var last: int64 := deps + (depCount - 1) * 16;
                poke64(dep,     peek64(last));
                poke64(dep + 8, peek64(last + 8));
            }
            depCount := depCount - 1;
            poke64(&mf + 56, depCount);
            found := 1;
        } else {
            i := i + 1;
        }
    }

    if (found == 0) {
        Print("lpm: Paket '");
        Print(pkgName);
        PrintLn("' nicht in lyx.toml");
        ManifestFree(&mf);
        return 1;
    }

    ManifestWrite(&mf, "lyx.toml");
    ManifestFree(&mf);

    // Lock-File aktualisieren
    var lf: LockFile;
    LockFileParse("lyx.lock", &lf);
    // Eintrag entfernen (vereinfacht: Lock-File neu aufbauen ohne dieses Paket)
    // TODO: transitive Dependencies ebenfalls prüfen
    LockFileWrite(&lf, "lyx.lock");
    LockFileFree(&lf);

    Print("lpm: '");
    Print(pkgName);
    PrintLn("' aus lyx.toml entfernt");
    return 0;
}

// ============================================================================
// lpm update
// ============================================================================

pub fn CmdUpdate(pa: int64): int64 {
    // Einfache Implementierung: --offline-Flag entfernen, neu installieren
    poke64(pa + 24, 0);  // offline = 0
    return CmdInstall(pa);
}

// ============================================================================
// lpm search
// ============================================================================

pub fn CmdSearch(pa: int64): int64 {
    var query: int64 := peek64(pa + 8);
    if (query == 0) {
        PrintLn("lpm search: Suchbegriff erforderlich");
        return 1;
    }

    var rc: RegistryClient;
    makeRegistryClient(pa, &rc);

    var sr: SearchResults;
    var errCode: int64 := RegistrySearch(&rc, query, &sr);
    RegistryClientFree(&rc);

    if (errCode != ERR_REG_OK) {
        PrintLn("lpm: Suche fehlgeschlagen (Netzwerkfehler?)");
        return 1;
    }

    var count: int64 := peek64(&sr + 8);
    var items: int64 := peek64(&sr);

    if (count == 0) {
        PrintLn("lpm: Keine Pakete gefunden");
        SearchResultsFree(&sr);
        return 0;
    }

    var i: int64 := 0;
    while (i < count) {
        var item: int64 := items + i * 24;
        Print(peek64(item));        // name
        Print("@");
        Print(peek64(item + 8));    // version
        Print("  ");
        PrintLn(peek64(item + 16)); // description
        i := i + 1;
    }

    SearchResultsFree(&sr);
    return 0;
}

// ============================================================================
// lpm info
// ============================================================================

pub fn CmdInfo(pa: int64): int64 {
    var pkgName: int64 := peek64(pa + 8);
    if (pkgName == 0) {
        PrintLn("lpm info: Paketname erforderlich");
        return 1;
    }

    var rc: RegistryClient;
    makeRegistryClient(pa, &rc);

    var pi: PackageInfo;
    var errCode: int64 := RegistryGetInfo(&rc, pkgName, &pi);
    RegistryClientFree(&rc);

    if (errCode != ERR_REG_OK) {
        Print("lpm: Paket '");
        Print(pkgName);
        PrintLn("' nicht gefunden");
        return 1;
    }

    PrintLn("--- Paket-Info ---");
    Print("Name:        "); PrintLn(peek64(&pi) != 0 ? peek64(&pi) : pkgName);
    Print("Autor:       "); PrintLn(peek64(&pi + 8) != 0 ? peek64(&pi + 8) : "-");
    Print("Lizenz:      "); PrintLn(peek64(&pi + 16) != 0 ? peek64(&pi + 16) : "-");
    Print("Beschreibung:"); PrintLn(peek64(&pi + 24) != 0 ? peek64(&pi + 24) : "-");
    PackageInfoFree(&pi);
    return 0;
}

// ============================================================================
// lpm list
// ============================================================================

pub fn CmdList(pa: int64): int64 {
    var lpmHome: int64 := CacheGetHome();
    var cl: CacheList;
    CacheList_(lpmHome, &cl);
    free(lpmHome);

    var count: int64 := peek64(&cl + 8);
    var entries: int64 := peek64(&cl);

    if (count == 0) {
        PrintLn("lpm: Keine Pakete im Cache");
        CacheListFree(&cl);
        return 0;
    }

    // Auch lyx.lock anzeigen wenn vorhanden
    var lf: LockFile;
    var hasLock: int64 := FileExists("lyx.lock");
    if (hasLock == 1) {
        LockFileParse("lyx.lock", &lf);
        PrintLn("Installierte Pakete (aus lyx.lock):");
        var lfCount: int64 := peek64(&lf + 8);
        var lfPkgs: int64 := peek64(&lf);
        var i: int64 := 0;
        while (i < lfCount) {
            var pkg: int64 := lfPkgs + i * 32;
            Print("  ");
            Print(peek64(pkg));
            Print("@");
            PrintLn(peek64(pkg + 8));
            i := i + 1;
        }
        LockFileFree(&lf);
    } else {
        PrintLn("Gecachte Pakete:");
        var i: int64 := 0;
        while (i < count) {
            var entry: int64 := entries + i * 24;
            Print("  ");
            Print(peek64(entry));
            Print("@");
            PrintLn(peek64(entry + 8));
            i := i + 1;
        }
    }

    CacheListFree(&cl);
    return 0;
}

// ============================================================================
// lpm publish
// ============================================================================

pub fn CmdPublish(pa: int64): int64 {
    // Manifest lesen und validieren
    var mf: Manifest;
    if (ManifestParse("lyx.toml", &mf) != ERR_MF_OK) {
        PrintLn("lpm publish: lyx.toml nicht gefunden");
        return 1;
    }
    if (ManifestValidate(&mf) != ERR_MF_OK) {
        PrintLn("lpm publish: lyx.toml unvollständig (name und version Pflichtfelder)");
        ManifestFree(&mf);
        return 1;
    }
    if (ManifestNameValid(peek64(&mf)) == 0) {
        PrintLn("lpm publish: Ungültiger Paketname (nur [a-z0-9_/.-] erlaubt)");
        ManifestFree(&mf);
        return 1;
    }

    var pkgName: int64 := peek64(&mf);
    var pkgVer: int64 := peek64(&mf + 8);

    // Quelldateien sammeln
    var entry: int64 := peek64(&mf + 40);
    if (entry == 0) { entry := "main.lyx"; }

    // Dateien für Archiv: lyx.toml + entry + alle .lyx-Dateien im aktuellen Verzeichnis
    var fileList: int64 := alloc(64 * 8);
    poke64(fileList, "lyx.toml");
    poke64(fileList + 8, entry);
    var fileCount: int64 := 2;

    // FILES.sha256 erstellen
    CreateChecksumFile(".", fileList, fileCount);

    // Archiv erstellen
    var tmpPkg: int64 := alloc(256);
    StrCpyN(tmpPkg, pkgName, StrLen(pkgName));

    // '/' durch '_' ersetzen für Dateiname
    var i: int64 := 0;
    while (peek8(tmpPkg + i) != 0) {
        if (peek8(tmpPkg + i) == 47) { poke8(tmpPkg + i, 95); }
        i := i + 1;
    }
    poke8(tmpPkg + i, 95);
    StrCpyN(tmpPkg + i + 1, pkgVer, StrLen(pkgVer));
    StrCpyN(tmpPkg + i + 1 + StrLen(pkgVer), ".lxpkg", 6);
    poke8(tmpPkg + i + 1 + StrLen(pkgVer) + 6, 0);

    var arRc: int64 := ArchiveCreate(".", tmpPkg, fileList, fileCount);
    free(fileList);

    if (arRc != ERR_AR_OK) {
        PrintLn("lpm publish: Fehler beim Erstellen des Archivs");
        free(tmpPkg); ManifestFree(&mf);
        return 1;
    }

    // Upload
    var rc: RegistryClient;
    makeRegistryClient(pa, &rc);

    var dlRc: int64 := UploadPackage(peek64(&rc), tmpPkg, peek64(&rc + 8));
    RegistryClientFree(&rc);
    free(tmpPkg); ManifestFree(&mf);

    if (dlRc != ERR_DL_OK) {
        PrintLn("lpm publish: Upload fehlgeschlagen (API-Key gesetzt?)");
        return 1;
    }

    Print("lpm: Paket '");
    Print(pkgName);
    Print("@");
    Print(pkgVer);
    PrintLn("' erfolgreich veröffentlicht");
    return 0;
}

// ============================================================================
// lpm login
// ============================================================================

pub fn CmdLogin(pa: int64): int64 {
    PrintLn("lpm login: API-Key eingeben (von https://registry.lyx-lang.org):");
    Print("> ");

    var keyBuf: int64 := alloc(256);
    var len: int64 := ReadLine(keyBuf, 255);
    if (len <= 0) {
        PrintLn("lpm login: Abgebrochen");
        free(keyBuf);
        return 1;
    }
    // Trailing Newline entfernen
    while ((len > 0) & ((peek8(keyBuf + len - 1) == 10) | (peek8(keyBuf + len - 1) == 13))) {
        len := len - 1;
    }
    poke8(keyBuf + len, 0);

    // In ~/.lpm/config.toml speichern
    var lpmHome: int64 := CacheGetHome();
    CacheInit(lpmHome);
    var cfgPath: int64 := CacheConfigPath(lpmHome);

    var cfgContent: int64 := alloc(len + 32);
    StrCpyN(cfgContent, "api_key = \"", 11);
    StrCpyN(cfgContent + 11, keyBuf, len);
    StrCpyN(cfgContent + 11 + len, "\"\n", 2);
    poke8(cfgContent + 13 + len, 0);

    FileWriteAll(cfgPath, cfgContent, 13 + len);
    free(cfgContent); free(cfgPath); free(lpmHome); free(keyBuf);

    PrintLn("lpm: API-Key gespeichert");
    return 0;
}

// ============================================================================
// lpm resolve (lyxc-Hook)
// ============================================================================

pub fn CmdResolve(pa: int64): int64 {
    var pkgName: int64 := peek64(pa + 8);
    if (pkgName == 0) {
        EPrintLn("lpm resolve: Paketname erforderlich");
        return 1;
    }

    var lpmHome: int64 := CacheGetHome();

    // Paket im Lock-File suchen
    var lf: LockFile;
    if (FileExists("lyx.lock") == 1) {
        LockFileParse("lyx.lock", &lf);
        var locked: int64 := LockFileFind(&lf, pkgName);
        if (locked != 0) {
            var ver: int64 := peek64(locked + 8);
            if (CacheHas(lpmHome, pkgName, ver) == 1) {
                // Import-Pfad ausgeben (für lyxc)
                var importPath: int64 := CachePkgPath(lpmHome, pkgName, ver);
                PrintLn(importPath);
                free(importPath);
                LockFileFree(&lf);
                free(lpmHome);
                return 0;
            }
        }
        LockFileFree(&lf);
    }

    // Nicht gecacht: automatisch installieren
    var rc: RegistryClient;
    makeRegistryClient(pa, &rc);

    var bestVer: int64 := RegistryFetchBestVersion(&rc, pkgName, "latest");
    if (bestVer == 0) {
        EPrint("lpm resolve: Paket nicht gefunden: ");
        EPrintLn(pkgName);
        RegistryClientFree(&rc);
        free(lpmHome);
        return 1;
    }

    // SHA256 und URL holen
    var sha256Ptr: int64 := alloc(8);
    var urlPtr: int64 := alloc(8);
    RegistryGetVersion(&rc, pkgName, bestVer, sha256Ptr, urlPtr);
    var sha256: int64 := peek64(sha256Ptr);
    var url: int64 := peek64(urlPtr);
    free(sha256Ptr); free(urlPtr);

    if ((sha256 != 0) & (url != 0)) {
        var tmpPkg: int64 := alloc(StrLen(lpmHome) + 16);
        StrCpyN(tmpPkg, lpmHome, StrLen(lpmHome));
        StrCpyN(tmpPkg + StrLen(lpmHome), "/resolve.lxpkg", 14);
        poke8(tmpPkg + StrLen(lpmHome) + 14, 0);

        if (DownloadPackage(url, tmpPkg, sha256, pkgName, bestVer) == ERR_DL_OK) {
            var pkgPath: int64 := CachePkgPath(lpmHome, pkgName, bestVer);
            MkDirAll(pkgPath);
            ArchiveExtract(tmpPkg, pkgPath);
            PrintLn(pkgPath);
            free(pkgPath);
        }
        free(tmpPkg);
        if (sha256 != 0) { free(sha256); }
        if (url != 0) { free(url); }
    }

    free(bestVer);
    RegistryClientFree(&rc);
    free(lpmHome);
    return 0;
}

// ============================================================================
// lpm cache list / cache clean
// ============================================================================

pub fn CmdCacheList(pa: int64): int64 {
    var lpmHome: int64 := CacheGetHome();
    var cl: CacheList;
    CacheList_(lpmHome, &cl);
    free(lpmHome);

    var count: int64 := peek64(&cl + 8);
    var entries: int64 := peek64(&cl);

    PrintLn("Gecachte Pakete:");
    var i: int64 := 0;
    while (i < count) {
        var entry: int64 := entries + i * 24;
        Print("  ");
        Print(peek64(entry));
        Print("@");
        Print(peek64(entry + 8));
        Print("  ");
        PrintLn(peek64(entry + 16));
        i := i + 1;
    }

    if (count == 0) { PrintLn("  (leer)"); }

    CacheListFree(&cl);
    return 0;
}

pub fn CmdCacheClean(pa: int64): int64 {
    var lpmHome: int64 := CacheGetHome();
    var rc: int64 := CacheClean(lpmHome);
    free(lpmHome);

    if (rc != ERR_CACHE_OK) {
        PrintLn("lpm cache clean: Fehler beim Bereinigen");
        return 1;
    }
    PrintLn("lpm: Cache geleert");
    return 0;
}

// ============================================================================
// Haupt-Dispatch
// ============================================================================

pub fn Dispatch(pa: int64): int64 {
    var cmd: int64 := peek64(pa);
    if (cmd == 0) {
        PrintHelp();
        return 0;
    }

    if (peek64(pa + 40) == 1) { PrintVersion(); return 0; }  // --version
    if (peek64(pa + 48) == 1) { PrintHelp(); return 0; }    // --help

    if (StrCmp(cmd, "init")    == 0) { return CmdInit(pa); }
    if (StrCmp(cmd, "install") == 0) { return CmdInstall(pa); }
    if (StrCmp(cmd, "remove")  == 0) { return CmdRemove(pa); }
    if (StrCmp(cmd, "update")  == 0) { return CmdUpdate(pa); }
    if (StrCmp(cmd, "search")  == 0) { return CmdSearch(pa); }
    if (StrCmp(cmd, "info")    == 0) { return CmdInfo(pa); }
    if (StrCmp(cmd, "list")    == 0) { return CmdList(pa); }
    if (StrCmp(cmd, "publish") == 0) { return CmdPublish(pa); }
    if (StrCmp(cmd, "login")   == 0) { return CmdLogin(pa); }
    if (StrCmp(cmd, "resolve") == 0) { return CmdResolve(pa); }

    if (StrCmp(cmd, "cache") == 0) {
        var sub: int64 := peek64(pa + 8);  // subArg
        if ((sub != 0) & (StrCmp(sub, "clean") == 0)) { return CmdCacheClean(pa); }
        return CmdCacheList(pa);
    }

    Print("lpm: Unbekannter Subcommand '");
    Print(cmd);
    PrintLn("'");
    PrintLn("Nutze 'lpm --help' für eine Liste aller Befehle.");
    return 1;
}
