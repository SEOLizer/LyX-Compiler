// lpm/net/registry.lyx — Registry-Client (HTTPS/JSON)
// WP-PM-05
//
// API:
//   GET  /v1/search?q=<query>&limit=20   → [{name,version,description}]
//   GET  /v1/package/<name>              → {name,versions:[...],author,license}
//   GET  /v1/package/<name>/<version>    → {manifest,sha256,download_url}
//   POST /v1/publish                     → Upload eines .lxpkg (Auth required)

unit lpm.net.registry;

import std.string;
import std.alloc;
import std.io;
import std.net.https;
import std.net.http;
import std.json;

// ============================================================================
// Konstanten
// ============================================================================

pub con DEFAULT_REGISTRY: int64 := 0;   // "https://registry.lyx-lang.org"
pub con API_VERSION:       int64 := 0;   // "/v1"
pub con ERR_REG_OK:        int64 := 0;
pub con ERR_REG_NOTFOUND:  int64 := 1;
pub con ERR_REG_NET:       int64 := 2;
pub con ERR_REG_PARSE:     int64 := 3;
pub con ERR_REG_AUTH:      int64 := 4;

// ============================================================================
// Typen
// ============================================================================

// Registry-Klient-Kontext
pub type RegistryClient = struct {
    baseUrl:  int64;   // pchar — z.B. "https://registry.lyx-lang.org"
    apiKey:   int64;   // pchar — Bearer-Token für publish/login
    offline:  int64;   // 1 = nur Cache nutzen
};

// Suchergebnis
pub type SearchResult = struct {
    name:        int64;   // pchar
    version:     int64;   // pchar — neueste Version
    description: int64;   // pchar
};

pub type SearchResults = struct {
    items:  int64;   // *SearchResult-Array
    count:  int64;
};

// Paket-Versions-Info
pub type PackageVersionInfo = struct {
    version:     int64;   // pchar
    sha256:      int64;   // pchar
    downloadUrl: int64;   // pchar
};

pub type PackageInfo = struct {
    name:        int64;   // pchar
    author:      int64;   // pchar
    license:     int64;   // pchar
    description: int64;   // pchar
    versions:    int64;   // *PackageVersionInfo-Array
    versionCount: int64;
};

// ============================================================================
// Hilfsfunktionen
// ============================================================================

con MAX_SEARCH: int64 := 20;
con REG_BUF:    int64 := 65536;

fn regStrdup(s: int64): int64 {
    if (s == 0) { return 0; }
    var len: int64 := StrLen(s);
    var buf: int64 := alloc(len + 1);
    StrCpyN(buf, s, len);
    poke8(buf + len, 0);
    return buf;
}

// Baut URL zusammen: baseUrl + path. Aufrufer muss free().
fn buildUrl(baseUrl: int64, path: int64): int64 {
    var bLen: int64 := StrLen(baseUrl);
    var pLen: int64 := StrLen(path);
    var url: int64 := alloc(bLen + pLen + 4);
    StrCpyN(url, baseUrl, bLen);
    StrCpyN(url + bLen, path, pLen);
    poke8(url + bLen + pLen, 0);
    return url;
}

// Führt einen HTTPS-GET aus und gibt den Body als alloc'd String zurück.
// Aufrufer muss free().
fn httpGet(baseUrl: int64, path: int64, apiKey: int64): int64 {
    var url: int64 := buildUrl(baseUrl, path);

    // Host aus baseUrl extrahieren (alles nach "https://")
    var host: int64 := url;
    if (StrCmpN(url, "https://", 8) == 0) { host := url + 8; }
    else if (StrCmpN(url, "http://", 7) == 0) { host := url + 7; }

    // Host endet vor dem ersten '/'
    var hostLen: int64 := 0;
    while ((peek8(host + hostLen) != 0) & (peek8(host + hostLen) != 47)) { hostLen := hostLen + 1; }

    var hostBuf: int64 := alloc(hostLen + 1);
    StrCpyN(hostBuf, host, hostLen);
    poke8(hostBuf + hostLen, 0);

    // Pfad = alles ab dem '/'
    var pathStart: int64 := host + hostLen;
    if (peek8(pathStart) == 0) { pathStart := "/"; }

    var resp: HTTPResponse;
    if (StrCmpN(url, "https://", 8) == 0) {
        resp := HTTPSGet(hostBuf, pathStart);
    } else {
        resp := HTTPGet(hostBuf, pathStart);
    }

    free(hostBuf); free(url);

    if ((resp.statusCode < 200) | (resp.statusCode >= 300)) {
        if (resp.bodyPtr != 0) { HTTPResponseFree(resp); }
        return 0;
    }

    var result: int64 := regStrdup(resp.bodyPtr);
    HTTPResponseFree(resp);
    return result;
}

// POST mit JSON-Body und Bearer-Auth.
fn httpPost(baseUrl: int64, path: int64, body: int64, apiKey: int64): int64 {
    var url: int64 := buildUrl(baseUrl, path);

    var host: int64 := url;
    if (StrCmpN(url, "https://", 8) == 0) { host := url + 8; }

    var hostLen: int64 := 0;
    while ((peek8(host + hostLen) != 0) & (peek8(host + hostLen) != 47)) { hostLen := hostLen + 1; }

    var hostBuf: int64 := alloc(hostLen + 1);
    StrCpyN(hostBuf, host, hostLen);
    poke8(hostBuf + hostLen, 0);

    var pathStart: int64 := host + hostLen;
    if (peek8(pathStart) == 0) { pathStart := "/"; }

    var req: HTTPRequest;
    req.method := "POST";
    req.host := hostBuf;
    req.path := pathStart;
    req.body := body;
    req.bodyLen := StrLen(body);
    req.headerCount := 0;

    // Authorization-Header hinzufügen wenn apiKey vorhanden
    if (apiKey != 0) {
        var authVal: int64 := alloc(StrLen(apiKey) + 10);
        StrCpyN(authVal, "Bearer ", 7);
        StrCpyN(authVal + 7, apiKey, StrLen(apiKey));
        poke8(authVal + 7 + StrLen(apiKey), 0);
        // Header in req eintragen (vereinfacht — bei vollständiger HTTPSend-Unterstützung)
        req.headerCount := 1;
    }

    var resp: HTTPResponse := HTTPSend(req);
    free(hostBuf); free(url);

    if ((resp.statusCode < 200) | (resp.statusCode >= 300)) {
        if (resp.bodyPtr != 0) { HTTPResponseFree(resp); }
        return 0;
    }

    var result: int64 := regStrdup(resp.bodyPtr);
    HTTPResponseFree(resp);
    return result;
}

// ============================================================================
// Öffentliche API
// ============================================================================

// Initialisiert RegistryClient.
pub fn RegistryClientInit(rc: int64, baseUrl: int64, apiKey: int64): void {
    poke64(rc,      regStrdup(baseUrl != 0 ? baseUrl : "https://registry.lyx-lang.org"));
    poke64(rc + 8,  regStrdup(apiKey));
    poke64(rc + 16, 0);
}

pub fn RegistryClientSetOffline(rc: int64, offline: int64): void {
    poke64(rc + 16, offline);
}

pub fn RegistryClientFree(rc: int64): void {
    if (peek64(rc) != 0) { free(peek64(rc)); }
    if (peek64(rc + 8) != 0) { free(peek64(rc + 8)); }
}

// Sucht Pakete nach query. Aufrufer muss SearchResultsFree() aufrufen.
pub fn RegistrySearch(rc: int64, query: int64, out: int64): int64 {
    if (peek64(rc + 16) == 1) { return ERR_REG_NET; }  // offline

    var baseUrl: int64 := peek64(rc);
    var pathBuf: int64 := alloc(StrLen(query) + 32);
    StrCpyN(pathBuf, "/v1/search?q=", 13);
    StrCpyN(pathBuf + 13, query, StrLen(query));
    StrCpyN(pathBuf + 13 + StrLen(query), "&limit=20", 9);
    poke8(pathBuf + 13 + StrLen(query) + 9, 0);

    var body: int64 := httpGet(baseUrl, pathBuf, peek64(rc + 8));
    free(pathBuf);

    if (body == 0) { return ERR_REG_NET; }

    // JSON parsen: Array von {name, version, description}
    var items: int64 := alloc(MAX_SEARCH * 24);  // sizeof(SearchResult)=24
    poke64(out, items);
    poke64(out + 8, 0);

    // Simples JSON-Scanning
    var pos: int64 := 0;
    var bodyLen: int64 := StrLen(body);
    var count: int64 := 0;

    fn nextStr(p: int64, res2: int64): int64 {
        while ((peek8(body + p) != 34) & (p < bodyLen)) { p := p + 1; }
        if (p >= bodyLen) { poke64(res2, 0); return p; }
        p := p + 1;
        var start: int64 := p;
        while ((peek8(body + p) != 34) & (p < bodyLen)) { p := p + 1; }
        var len: int64 := p - start;
        var s: int64 := alloc(len + 1);
        StrCpyN(s, body + start, len);
        poke8(s + len, 0);
        poke64(res2, s);
        if (p < bodyLen) { p := p + 1; }
        return p;
    }

    while ((pos < bodyLen) & (count < MAX_SEARCH)) {
        if (StrCmpN(body + pos, "\"name\"", 6) == 0) {
            pos := pos + 6;
            var item: int64 := items + count * 24;
            var tmp: int64 := alloc(8);
            pos := nextStr(pos, tmp);  poke64(item,      peek64(tmp));
            pos := nextStr(pos, tmp);  // key "version"
            pos := nextStr(pos, tmp);  poke64(item + 8,  peek64(tmp));
            pos := nextStr(pos, tmp);  // key "description"
            pos := nextStr(pos, tmp);  poke64(item + 16, peek64(tmp));
            free(tmp);
            count := count + 1;
        } else {
            pos := pos + 1;
        }
    }

    poke64(out + 8, count);
    free(body);
    return ERR_REG_OK;
}

pub fn SearchResultsFree(sr: int64): void {
    var count: int64 := peek64(sr + 8);
    var items: int64 := peek64(sr);
    if (items == 0) { return; }
    var i: int64 := 0;
    while (i < count) {
        var item: int64 := items + i * 24;
        if (peek64(item) != 0) { free(peek64(item)); }
        if (peek64(item + 8) != 0) { free(peek64(item + 8)); }
        if (peek64(item + 16) != 0) { free(peek64(item + 16)); }
        i := i + 1;
    }
    free(items);
}

// Holt Paket-Info (alle Versionen). Aufrufer muss PackageInfoFree() aufrufen.
pub fn RegistryGetInfo(rc: int64, name: int64, out: int64): int64 {
    if (peek64(rc + 16) == 1) { return ERR_REG_NET; }

    var pathBuf: int64 := alloc(StrLen(name) + 16);
    StrCpyN(pathBuf, "/v1/package/", 12);
    StrCpyN(pathBuf + 12, name, StrLen(name));
    poke8(pathBuf + 12 + StrLen(name), 0);

    var body: int64 := httpGet(peek64(rc), pathBuf, peek64(rc + 8));
    free(pathBuf);
    if (body == 0) { return ERR_REG_NOTFOUND; }

    // JSON parsen: {name, author, license, description, versions: [...]}
    // Vereinfachtes Parsing
    poke64(out,      0); poke64(out + 8, 0); poke64(out + 16, 0);
    poke64(out + 24, 0); poke64(out + 32, alloc(64 * 40));
    poke64(out + 40, 0);

    var pos: int64 := 0;
    var bodyLen: int64 := StrLen(body);

    fn getField(key: int64, keyLen: int64, dst: int64): void {
        var p2: int64 := 0;
        while (p2 < bodyLen) {
            if (StrCmpN(body + p2, key, keyLen) == 0) {
                p2 := p2 + keyLen;
                while ((peek8(body + p2) != 34) & (p2 < bodyLen)) { p2 := p2 + 1; }
                if (p2 >= bodyLen) { return; }
                p2 := p2 + 1;
                var start: int64 := p2;
                while ((peek8(body + p2) != 34) & (p2 < bodyLen)) { p2 := p2 + 1; }
                var len: int64 := p2 - start;
                var s: int64 := alloc(len + 1);
                StrCpyN(s, body + start, len);
                poke8(s + len, 0);
                poke64(dst, s);
                return;
            }
            p2 := p2 + 1;
        }
    }

    var tmp: int64 := alloc(8);
    getField("\"name\":", 7, tmp);      poke64(out, peek64(tmp));
    getField("\"author\":", 9, tmp);    poke64(out + 8, peek64(tmp));
    getField("\"license\":", 10, tmp);  poke64(out + 16, peek64(tmp));
    getField("\"description\":", 14, tmp); poke64(out + 24, peek64(tmp));
    free(tmp);
    free(body);
    return ERR_REG_OK;
}

// Holt Version-spezifische Info. Gibt sha256 und download_url zurück.
pub fn RegistryGetVersion(rc: int64, name: int64, version: int64, sha256Out: int64, urlOut: int64): int64 {
    if (peek64(rc + 16) == 1) { return ERR_REG_NET; }

    var nLen: int64 := StrLen(name);
    var vLen: int64 := StrLen(version);
    var pathBuf: int64 := alloc(nLen + vLen + 16);
    StrCpyN(pathBuf, "/v1/package/", 12);
    StrCpyN(pathBuf + 12, name, nLen);
    poke8(pathBuf + 12 + nLen, 47);
    StrCpyN(pathBuf + 12 + nLen + 1, version, vLen);
    poke8(pathBuf + 12 + nLen + 1 + vLen, 0);

    var body: int64 := httpGet(peek64(rc), pathBuf, peek64(rc + 8));
    free(pathBuf);
    if (body == 0) { return ERR_REG_NOTFOUND; }

    // sha256 und download_url aus JSON extrahieren
    fn extractField(key: int64, keyLen: int64): int64 {
        var p2: int64 := 0;
        var bodyLen: int64 := StrLen(body);
        while (p2 < bodyLen) {
            if (StrCmpN(body + p2, key, keyLen) == 0) {
                p2 := p2 + keyLen;
                while ((peek8(body + p2) != 34) & (p2 < bodyLen)) { p2 := p2 + 1; }
                if (p2 >= bodyLen) { return 0; }
                p2 := p2 + 1;
                var start: int64 := p2;
                while ((peek8(body + p2) != 34) & (p2 < bodyLen)) { p2 := p2 + 1; }
                var len: int64 := p2 - start;
                var s: int64 := alloc(len + 1);
                StrCpyN(s, body + start, len);
                poke8(s + len, 0);
                return s;
            }
            p2 := p2 + 1;
        }
        return 0;
    }

    poke64(sha256Out, extractField("\"sha256\":", 9));
    poke64(urlOut,    extractField("\"download_url\":", 15));
    free(body);

    if ((peek64(sha256Out) == 0) | (peek64(urlOut) == 0)) { return ERR_REG_PARSE; }
    return ERR_REG_OK;
}

// Holt beste Version die range erfüllt. Aufrufer muss free(). Gibt 0 wenn nicht gefunden.
pub fn RegistryFetchBestVersion(rc: int64, name: int64, range: int64): int64 {
    if (peek64(rc + 16) == 1) { return 0; }

    var nLen: int64 := StrLen(name);
    var pathBuf: int64 := alloc(nLen + 32);
    StrCpyN(pathBuf, "/v1/package/", 12);
    StrCpyN(pathBuf + 12, name, nLen);
    StrCpyN(pathBuf + 12 + nLen, "/versions", 9);
    poke8(pathBuf + 12 + nLen + 9, 0);

    var body: int64 := httpGet(peek64(rc), pathBuf, peek64(rc + 8));
    free(pathBuf);
    if (body == 0) { return 0; }

    // JSON-Array von Versionsstrings durchsuchen, beste wählen
    import lpm.core.semver;

    var svRange: SemVerRange;
    SemVerRangeParse(range, &svRange);

    var bestVer: int64 := 0;
    var bestSv: SemVer;
    bestSv.valid := 0;

    var pos: int64 := 0;
    var bodyLen: int64 := StrLen(body);

    while (pos < bodyLen) {
        if (peek8(body + pos) == 34) {  // '"'
            pos := pos + 1;
            var start: int64 := pos;
            while ((peek8(body + pos) != 34) & (pos < bodyLen)) { pos := pos + 1; }
            var len: int64 := pos - start;
            if (len > 0) {
                var verStr: int64 := alloc(len + 1);
                StrCpyN(verStr, body + start, len);
                poke8(verStr + len, 0);

                var sv: SemVer;
                if (SemVerParse(verStr, &sv) == 1) {
                    if (SemVerSatisfies(&sv, &svRange) == 1) {
                        if ((bestSv.valid == 0) | (SemVerCompare(&sv, &bestSv) > 0)) {
                            if (bestVer != 0) { free(bestVer); }
                            bestVer := verStr;
                            bestSv := sv;
                            verStr := 0;
                        }
                    }
                }
                if (verStr != 0) { free(verStr); }
            }
            if (pos < bodyLen) { pos := pos + 1; }
        } else {
            pos := pos + 1;
        }
    }

    free(body);
    return bestVer;
}

pub fn PackageInfoFree(pi: int64): void {
    if (peek64(pi) != 0) { free(peek64(pi)); }
    if (peek64(pi + 8) != 0) { free(peek64(pi + 8)); }
    if (peek64(pi + 16) != 0) { free(peek64(pi + 16)); }
    if (peek64(pi + 24) != 0) { free(peek64(pi + 24)); }

    var versions: int64 := peek64(pi + 32);
    var vcount: int64 := peek64(pi + 40);
    if (versions != 0) {
        var i: int64 := 0;
        while (i < vcount) {
            var v: int64 := versions + i * 24;
            if (peek64(v) != 0) { free(peek64(v)); }
            if (peek64(v + 8) != 0) { free(peek64(v + 8)); }
            if (peek64(v + 16) != 0) { free(peek64(v + 16)); }
            i := i + 1;
        }
        free(versions);
    }
}
