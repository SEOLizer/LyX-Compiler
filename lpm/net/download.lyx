// lpm/net/download.lyx — Paket-Download + SHA256-Verifikation
// WP-PM-05/06
//
// Lädt .lxpkg von der Registry herunter und prüft die SHA256-Checksumme.
// Progress-Output auf stdout.

unit lpm.net.download;

import std.string;
import std.alloc;
import std.io;
import std.fs;
import std.net.https;
import std.net.http;
import std.hash;

// ============================================================================
// Konstanten
// ============================================================================

pub con ERR_DL_OK:       int64 := 0;
pub con ERR_DL_NET:      int64 := 1;
pub con ERR_DL_IO:       int64 := 2;
pub con ERR_DL_CHECKSUM: int64 := 3;

// ============================================================================
// Hilfsfunktionen
// ============================================================================

fn hexEncode32(data: int64, out: int64): void {
    con HEX: int64 := "0123456789abcdef";
    var i: int64 := 0;
    while (i < 32) {
        var b: int64 := peek8(data + i);
        poke8(out + i * 2,     peek8(HEX + (b >> 4)));
        poke8(out + i * 2 + 1, peek8(HEX + (b & 0xF)));
        i := i + 1;
    }
    poke8(out + 64, 0);
}

// Parst Host und Pfad aus einer URL. hostBuf und pathBuf müssen alloc'd sein.
fn parseUrl(url: int64, hostBuf: int64, pathBuf: int64): int64 {
    var start: int64 := url;
    if (StrCmpN(url, "https://", 8) == 0) { start := url + 8; }
    else if (StrCmpN(url, "http://", 7) == 0) { start := url + 7; }

    var hostLen: int64 := 0;
    while ((peek8(start + hostLen) != 0) & (peek8(start + hostLen) != 47)) { hostLen := hostLen + 1; }

    StrCpyN(hostBuf, start, hostLen);
    poke8(hostBuf + hostLen, 0);

    var pathStart: int64 := start + hostLen;
    if (peek8(pathStart) == 0) {
        poke8(pathBuf, 47); poke8(pathBuf + 1, 0);
    } else {
        StrCpyN(pathBuf, pathStart, StrLen(pathStart));
        poke8(pathBuf + StrLen(pathStart), 0);
    }
    return StrCmpN(url, "https://", 8) == 0 ? 1 : 0;  // 1=HTTPS
}

// Gibt eine einfache ASCII-Progress-Ausgabe.
fn printProgress(name: int64, version: int64, current: int64, total: int64): void {
    Print("lpm: downloading ");
    Print(name);
    Print(" ");
    Print(version);
    if (total > 0) {
        var pct: int64 := (current * 100) / total;
        Print(" [");
        var filled: int64 := pct / 5;
        var j: int64 := 0;
        while (j < 20) {
            if (j < filled) { Print("="); }
            else { Print(" "); }
            j := j + 1;
        }
        Print("] ");
        PrintInt(pct);
        Print("%");
    }
    Print("\r");
}

// ============================================================================
// Öffentliche API
// ============================================================================

// Lädt ein .lxpkg von downloadUrl herunter und speichert es nach destPath.
// Verifiziert SHA256 gegen expectedSha256 (Hex-String, 64 Zeichen).
// pkgName und pkgVersion nur für Progress-Ausgabe.
pub fn DownloadPackage(downloadUrl: int64, destPath: int64,
                       expectedSha256: int64,
                       pkgName: int64, pkgVersion: int64): int64 {
    Print("lpm: resolving ");
    Print(pkgName);
    Print("@");
    PrintLn(pkgVersion);

    var hostBuf: int64 := alloc(512);
    var pathBuf: int64 := alloc(2048);
    var isHttps: int64 := parseUrl(downloadUrl, hostBuf, pathBuf);

    var resp: HTTPResponse;
    if (isHttps == 1) {
        resp := HTTPSGet(hostBuf, pathBuf);
    } else {
        resp := HTTPGet(hostBuf, pathBuf);
    }
    free(hostBuf); free(pathBuf);

    if ((resp.statusCode < 200) | (resp.statusCode >= 300)) {
        if (resp.bodyPtr != 0) { HTTPResponseFree(resp); }
        PrintLn("lpm: download fehlgeschlagen");
        return ERR_DL_NET;
    }

    // Progress-Ausgabe
    printProgress(pkgName, pkgVersion, resp.bodySize, resp.bodySize);
    PrintLn("");

    // SHA256-Verifikation
    var hash: int64 := alloc(32);
    SHA256(resp.bodyPtr, resp.bodySize, hash);

    var computedHex: int64 := alloc(68);
    hexEncode32(hash, computedHex);
    free(hash);

    if (StrCmpN(computedHex, expectedSha256, 64) != 0) {
        HTTPResponseFree(resp);
        free(computedHex);
        PrintLn("lpm: SHA256-Prüfsumme stimmt nicht überein!");
        return ERR_DL_CHECKSUM;
    }
    free(computedHex);

    // Datei speichern
    var written: int64 := FileWriteAll(destPath, resp.bodyPtr, resp.bodySize);
    HTTPResponseFree(resp);

    if (written == 0) { return ERR_DL_IO; }

    Print("lpm: downloaded ");
    Print(pkgName);
    Print(" ");
    PrintLn(pkgVersion);

    return ERR_DL_OK;
}

// Upload eines .lxpkg zur Registry (für lpm publish).
pub fn UploadPackage(registryUrl: int64, pkgPath: int64, apiKey: int64): int64 {
    var pkgData: int64 := FileReadAll(pkgPath);
    if (pkgData == 0) { return ERR_DL_IO; }
    var pkgSize: int64 := FileSize(pkgPath);

    var hostBuf: int64 := alloc(512);
    var pathBuf: int64 := alloc(2048);

    var uploadUrl: int64 := alloc(StrLen(registryUrl) + 16);
    StrCpyN(uploadUrl, registryUrl, StrLen(registryUrl));
    StrCpyN(uploadUrl + StrLen(registryUrl), "/v1/publish", 11);
    poke8(uploadUrl + StrLen(registryUrl) + 11, 0);

    parseUrl(uploadUrl, hostBuf, pathBuf);
    free(uploadUrl);

    var req: HTTPRequest;
    req.method := "POST";
    req.host := hostBuf;
    req.path := pathBuf;
    req.body := pkgData;
    req.bodyLen := pkgSize;
    req.headerCount := 0;

    var resp: HTTPResponse := HTTPSend(req);
    free(pkgData); free(hostBuf); free(pathBuf);

    if ((resp.statusCode < 200) | (resp.statusCode >= 300)) {
        if (resp.bodyPtr != 0) { HTTPResponseFree(resp); }
        return ERR_DL_NET;
    }

    HTTPResponseFree(resp);
    return ERR_DL_OK;
}
