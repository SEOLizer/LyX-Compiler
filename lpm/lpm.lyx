// lpm/lpm.lyx — Lyx Package Manager — Hauptprogramm
// WP-PM-02
//
// Einstiegspunkt: liest argc/argv, dispatcht Subcommands, gibt Exit-Code zurück.
// Nutzung: lpm <subcommand> [--flags] [argumente]

unit lpm.main;

import std.string;
import std.alloc;
import std.io;
import lpm.cli.args;
import lpm.cli.commands;

// ParsedArgs-Feldoffsets (11 × 8 Bytes = 88)
// command:0 subArg:8 args:16 argCount:24 verbose:32 offline:40
// registry:48 showHelp:56 showVer:64 member:72 devDeps:80

pub fn main(argc: int64, argv: int64): int64 {
    var pa: int64 := alloc(88);
    ArgsParse(argc, argv, pa);

    var rc: int64 := 0;

    if (peek64(pa + 56) == 1) {      // showHelp
        PrintHelp();
    }
    else if (peek64(pa + 64) == 1) { // showVer
        PrintVersion();
    }
    else if (peek64(pa) == 0) {      // command == 0
        PrintHelp();
    }
    else {
        rc := Dispatch(pa);
    }

    ArgsFree(pa);
    free(pa);
    return rc;
}
