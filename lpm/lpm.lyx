// lpm/lpm.lyx — Lyx Package Manager — Hauptprogramm
// WP-PM-02
//
// Einstiegspunkt: liest argc/argv, dispatcht Subcommands, gibt Exit-Code zurück.
//
// Nutzung: lpm <subcommand> [--flags] [argumente]
// Starte Registry-Server: lpm-registry --port 8080 --db "..."

unit lpm.main;

import std.string;
import std.alloc;
import std.io;
import lpm.cli.args;
import lpm.cli.commands;

pub fn _start(argc: int64, argv: int64): int64 {
    var pa: ParsedArgs;
    ArgsParse(argc, argv, &pa);

    var rc: int64 := 0;

    if (pa.showHelp == 1) {
        PrintHelp();
        ArgsFree(&pa);
        return 0;
    }

    if (pa.showVer == 1) {
        PrintVersion();
        ArgsFree(&pa);
        return 0;
    }

    if (pa.command == 0) {
        PrintHelp();
        ArgsFree(&pa);
        return 0;
    }

    rc := Dispatch(&pa);

    ArgsFree(&pa);
    return rc;
}
