// --- Utilities ---

fn argEq(a: pchar, b: pchar): int64 {
    if (a == 0 as pchar || b == 0 as pchar) { return 0; }
    return StrEquals(a, b) as int64;
}

fn argStart(a: pchar, prefix: pchar): int64 {
    if (a == 0 as pchar || prefix == 0 as pchar) { return 0; }
    return StrStartsWith(a, prefix) as int64;
}

fn argAfter(a: pchar, prefix: pchar): pchar {
    var pl: int64 := StrLen(prefix);
    return (a as int64 + pl) as pchar;
}

fn flagVal(argc: int64, argv: pchar, flag: pchar): pchar {
    // supports --flag value and --flag=value
    var i: int64 := 1;
    while (i < argc) {
        var arg: pchar := ArgvGet(argv, i);
        if (StrEquals(arg, flag) as int64 == 1) {
            if (i + 1 < argc) { return ArgvGet(argv, i + 1); }
            return 0 as pchar;
        }
        var dashdash: int64 := StrLen(flag) + 1;
        var buf: int64 := alloc(dashdash + 2);
        var fl: int64 := StrLen(flag);
        var j: int64 := 0;
        while(j<fl){poke8(buf+j,StrCharAt(flag,j)&0xFF);j:=j+1;}
        poke8(buf+fl, 61); poke8(buf+fl+1, 0); // '='
        if (argStart(arg, buf as pchar) == 1) {
            free(buf, dashdash + 2);
            return argAfter(arg, buf as pchar);
        }
        free(buf, dashdash + 2);
        i := i + 1;
    }
    return 0 as pchar;
}

fn flagBool(argc: int64, argv: pchar, flag: pchar): int64 {
    var i: int64 := 1;
    while (i < argc) {
        var arg: pchar := ArgvGet(argv, i);
        if (StrEquals(arg, flag) as int64 == 1) { return 1; }
        i := i + 1;
    }
    return 0;
}

fn printLn2(a: pchar, b: pchar) {
    PrintLn(a);
    PrintLn(b);
}

fn sep() { PrintLn("--"c); }

fn printKV(key: pchar, val: int64) {
    var buf: int64 := alloc(24);
    var s: pchar := Int64ToStr(val, buf);
    Print(key); Print(": "c); PrintLn(s);
    free(buf, 24);
}

fn printKS(key: pchar, val: int64) {
    Print(key); Print(": "c);
    if (val == 0) { PrintLn("(none)"c); }
    else { PrintLn(val as pchar); }
}

fn printStr(val: int64) {
    if (val == 0) { Print("(none)"c); }
    else { Print(val as pchar); }
}

fn usage() {
    PrintLn("lyxdo — DigitalOcean CLI"c);
    PrintLn("Usage: lyxdo <command> [subcommand] [flags]"c);
    PrintLn(""c);
    PrintLn("Commands:"c);
    PrintLn("  auth         Token-Verwaltung"c);
    PrintLn("  account      Konto-Info"c);
    PrintLn("  compute      Droplets, SSH-Keys, Images, Sizes"c);
    PrintLn("  spaces       Object Storage"c);
    PrintLn("  database     Managed Databases"c);
    PrintLn("  kubernetes   DOKS Cluster"c);
    PrintLn("  networking   Domains, LB, VPC, Firewall, Floating-IPs"c);
    PrintLn("  volume       Block Storage"c);
    PrintLn("  apps         App Platform"c);
    PrintLn("  registry     Container Registry"c);
    PrintLn("  functions    Serverless Functions"c);
    PrintLn("  monitoring   Metriken und Alerts"c);
    PrintLn(""c);
    PrintLn("Globale Flags:"c);
    PrintLn("  --token <token>   API-Token (überschreibt DIGITALOCEAN_TOKEN)"c);
    PrintLn("  --config <path>   Konfig-Datei (default: ~/.config/lyxdo/config.json)"c);
    PrintLn("  --region <region> Standard-Region"c);
}

fn loadCreds(argc: int64, argv: pchar): DOCredentials {
    var tok: pchar := flagVal(argc, argv, "--token"c);
    if (tok != 0 as pchar) { return DOCredentialsFromToken(tok); }
    var cfg: pchar := flagVal(argc, argv, "--config"c);
    if (cfg != 0 as pchar) { return DOCredentialsFromFile(cfg); }
    return DOCredentialsDefault();
}

// --- auth ---

fn cmdAuth(argc: int64, argv: pchar): int64 {
    if (argc < 3) { PrintLn("Usage: lyxdo auth <init|token>"c); return 1; }
    var sub: pchar := ArgvGet(argv, 2);
    if (argEq(sub, "init"c) == 1) {
        PrintLn("Bitte DIGITALOCEAN_TOKEN setzen oder --token verwenden."c);
        PrintLn("Beispiel: export DIGITALOCEAN_TOKEN=dop_v1_..."c);
        return 0;
    }
    if (argEq(sub, "token"c) == 1) {
        var creds: DOCredentials := loadCreds(argc, argv);
        if (creds.token == 0) { PrintLn("Kein Token gefunden."c); return 1; }
        PrintLn(creds.token as pchar);
        DOCredentialsFree(creds);
        return 0;
    }
    if (argEq(sub, "list"c) == 1) {
        var cfgPath: int64 := DOConfigPath() as int64;
        PrintLn("Gespeicherte Konfiguration:"c);
        Print("  "c); PrintLn(cfgPath as pchar);
        free(cfgPath, StrLen(cfgPath as pchar) + 1);
        return 0;
    }
    PrintLn("Unbekannter auth-Unterbefehl."c);
    return 1;
}

// --- account ---

fn cmdAccount(argc: int64, argv: pchar): int64 {
    var creds: DOCredentials := loadCreds(argc, argv);
    if (creds.tokenLen == 0) { PrintLn("Kein Token. Bitte DIGITALOCEAN_TOKEN setzen."c); return 1; }
    var cl: DOClient; cl.token := creds.token; cl.tokenLen := creds.tokenLen;
    if (argc >= 3 && argEq(ArgvGet(argv, 2), "ratelimit"c) == 1) {
        var resp: HTTPResponse := DOGet(cl, "/v2/account"c);
        PrintLn("Rate Limit Header:"c);
        // headers are in resp.headers as HTTPHeader array
        HTTPResponseFree(resp);
        DOCredentialsFree(creds);
        return 0;
    }
    var resp: HTTPResponse := DOGet(cl, "/v2/account"c);
    if (resp.statusCode == 200 && resp.bodyPtr != 0) {
        PrintLn("--- Account ---"c);
        var email: int64 := doJsonStr(resp.bodyPtr, "email"c);
        var uuid: int64 := doJsonStr(resp.bodyPtr, "uuid"c);
        var status: int64 := doJsonStr(resp.bodyPtr, "status"c);
        var dropletLimit: int64 := doJsonInt(resp.bodyPtr, "droplet_limit"c);
        printKS("Email"c, email);
        printKS("UUID"c, uuid);
        printKS("Status"c, status);
        printKV("Droplet-Limit"c, dropletLimit);
        if (email != 0) { free(email, StrLen(email as pchar) + 1); }
        if (uuid  != 0) { free(uuid,  StrLen(uuid  as pchar) + 1); }
        if (status != 0) { free(status, StrLen(status as pchar) + 1); }
    } else {
        PrintLn("Fehler beim Abrufen des Accounts."c);
    }
    HTTPResponseFree(resp);
    DOCredentialsFree(creds);
    return 0;
}

// --- compute ---

fn cmdComputeDroplet(creds: DOCredentials, argc: int64, argv: pchar): int64 {
    if (argc < 4) {
        PrintLn("Usage: lyxdo compute droplet <list|get|create|delete|start|stop|reboot|snapshot|resize|ip>"c);
        return 1;
    }
    var sub: pchar := ArgvGet(argv, 3);

    if (argEq(sub, "list"c) == 1) {
        var tag: pchar := flagVal(argc, argv, "--tag"c);
        var json: int64 := 0;
        if (tag != 0 as pchar) {
            var cl: DOClient; cl.token := creds.token; cl.tokenLen := creds.tokenLen;
            var pathBuf: int64 := alloc(256);
            doMakePath(pathBuf, "/v2/droplets?tag_name="c, tag);
            json := DOGetAll(cl, pathBuf as pchar, "droplets"c);
            free(pathBuf, 256);
        } else {
            var cl: DOClient; cl.token := creds.token; cl.tokenLen := creds.tokenLen;
            json := DOGetAll(cl, "/v2/droplets"c, "droplets"c);
        }
        if (json != 0) { PrintLn(json as pchar); free(json, StrLen(json as pchar) + 1); }
        return 0;
    }

    if (argEq(sub, "get"c) == 1) {
        if (argc < 5) { PrintLn("Usage: lyxdo compute droplet get <id>"c); return 1; }
        var id: pchar := ArgvGet(argv, 4);
        var numBuf: int64 := alloc(24);
        var did: int64 := StrToInt64(id, numBuf);
        free(numBuf, 24);
        var d: DODroplet := DropletGet(creds, did);
        printKS("ID"c, d.id as int64);
        printKS("Name"c, d.name);
        printKS("Status"c, d.status);
        printKS("Region"c, d.region);
        printKS("Size"c, d.size);
        printKS("Image"c, d.image);
        printKS("IPv4"c, d.ipv4);
        DODropletFree(d);
        return 0;
    }

    if (argEq(sub, "create"c) == 1) {
        var name: pchar   := flagVal(argc, argv, "--name"c);
        var region: pchar := flagVal(argc, argv, "--region"c);
        var size: pchar   := flagVal(argc, argv, "--size"c);
        var image: pchar  := flagVal(argc, argv, "--image"c);
        if (name == 0 as pchar || region == 0 as pchar || size == 0 as pchar || image == 0 as pchar) {
            PrintLn("Pflicht: --name --region --size --image"c); return 1;
        }
        var sshKeys: pchar := flagVal(argc, argv, "--ssh-keys"c);
        var d: DODroplet := DropletCreateSimple(creds, name, region, size, image, sshKeys);
        if (d.id == 0) { PrintLn("Fehler beim Erstellen des Droplets."c); return 1; }
        Print("Erstellt: ID "c); PrintLn(d.id as pchar);
        DODropletFree(d);
        return 0;
    }

    if (argEq(sub, "delete"c) == 1) {
        if (argc < 5) { PrintLn("Usage: lyxdo compute droplet delete <id>"c); return 1; }
        var id2: pchar := ArgvGet(argv, 4);
        var numBuf2: int64 := alloc(24);
        var did2: int64 := StrToInt64(id2, numBuf2);
        free(numBuf2, 24);
        var ok: int64 := DropletDelete(creds, did2);
        if (ok == 1) { PrintLn("Gelöscht."c); } else { PrintLn("Fehler."c); }
        return 0;
    }

    if (argEq(sub, "start"c) == 1) {
        if (argc < 5) { PrintLn("Usage: lyxdo compute droplet start <id>"c); return 1; }
        var numBuf3: int64 := alloc(24);
        var did3: int64 := StrToInt64(ArgvGet(argv, 4), numBuf3);
        free(numBuf3, 24);
        var ok2: int64 := DropletPowerOn(creds, did3);
        if (ok2 == 1) { PrintLn("Start-Action ausgelöst."c); } else { PrintLn("Fehler."c); }
        return 0;
    }

    if (argEq(sub, "stop"c) == 1) {
        if (argc < 5) { PrintLn("Usage: lyxdo compute droplet stop <id>"c); return 1; }
        var numBuf4: int64 := alloc(24);
        var did4: int64 := StrToInt64(ArgvGet(argv, 4), numBuf4);
        free(numBuf4, 24);
        var ok3: int64 := DropletPowerOff(creds, did4);
        if (ok3 == 1) { PrintLn("Stop-Action ausgelöst."c); } else { PrintLn("Fehler."c); }
        return 0;
    }

    if (argEq(sub, "reboot"c) == 1) {
        if (argc < 5) { PrintLn("Usage: lyxdo compute droplet reboot <id>"c); return 1; }
        var numBuf5: int64 := alloc(24);
        var did5: int64 := StrToInt64(ArgvGet(argv, 4), numBuf5);
        free(numBuf5, 24);
        var ok4: int64 := DropletReboot(creds, did5);
        if (ok4 == 1) { PrintLn("Reboot ausgelöst."c); } else { PrintLn("Fehler."c); }
        return 0;
    }

    if (argEq(sub, "snapshot"c) == 1) {
        if (argc < 5) { PrintLn("Usage: lyxdo compute droplet snapshot <id> --snapshot-name <n>"c); return 1; }
        var numBuf6: int64 := alloc(24);
        var did6: int64 := StrToInt64(ArgvGet(argv, 4), numBuf6);
        free(numBuf6, 24);
        var snName: pchar := flagVal(argc, argv, "--snapshot-name"c);
        if (snName == 0 as pchar) { PrintLn("Pflicht: --snapshot-name"c); return 1; }
        var ok5: int64 := DropletSnapshot(creds, did6, snName);
        if (ok5 == 1) { PrintLn("Snapshot-Action ausgelöst."c); } else { PrintLn("Fehler."c); }
        return 0;
    }

    if (argEq(sub, "resize"c) == 1) {
        if (argc < 5) { PrintLn("Usage: lyxdo compute droplet resize <id> --size <s>"c); return 1; }
        var numBuf7: int64 := alloc(24);
        var did7: int64 := StrToInt64(ArgvGet(argv, 4), numBuf7);
        free(numBuf7, 24);
        var newSize: pchar := flagVal(argc, argv, "--size"c);
        if (newSize == 0 as pchar) { PrintLn("Pflicht: --size"c); return 1; }
        var resizeDisk: int64 := flagBool(argc, argv, "--resize-disk"c);
        var ok6: int64 := DropletResize(creds, did7, newSize, resizeDisk);
        if (ok6 == 1) { PrintLn("Resize-Action ausgelöst."c); } else { PrintLn("Fehler."c); }
        return 0;
    }

    if (argEq(sub, "ip"c) == 1) {
        if (argc < 5) { PrintLn("Usage: lyxdo compute droplet ip <id>"c); return 1; }
        var numBuf8: int64 := alloc(24);
        var did8: int64 := StrToInt64(ArgvGet(argv, 4), numBuf8);
        free(numBuf8, 24);
        var ip: int64 := DropletGetIP(creds, did8);
        if (ip == 0) { PrintLn("(keine IP)"c); } else { PrintLn(ip as pchar); free(ip, StrLen(ip as pchar)+1); }
        return 0;
    }

    PrintLn("Unbekannter compute droplet Unterbefehl."c);
    return 1;
}

fn cmdComputeSSHKey(creds: DOCredentials, argc: int64, argv: pchar): int64 {
    if (argc < 4) { PrintLn("Usage: lyxdo compute ssh-key <list|create|delete>"c); return 1; }
    var sub: pchar := ArgvGet(argv, 3);

    if (argEq(sub, "list"c) == 1) {
        var cl: DOClient; cl.token := creds.token; cl.tokenLen := creds.tokenLen;
        var json: int64 := DOGetAll(cl, "/v2/account/keys"c, "ssh_keys"c);
        if (json != 0) { PrintLn(json as pchar); free(json, StrLen(json as pchar)+1); }
        return 0;
    }

    if (argEq(sub, "create"c) == 1) {
        var name: pchar   := flagVal(argc, argv, "--name"c);
        var keyFile: pchar := flagVal(argc, argv, "--public-key-file"c);
        if (name == 0 as pchar || keyFile == 0 as pchar) {
            PrintLn("Pflicht: --name --public-key-file"c); return 1;
        }
        var keySz: int64 := FileSize(keyFile);
        if (keySz <= 0) { PrintLn("Public-Key-Datei nicht gefunden."c); return 1; }
        var keyData: int64 := alloc(keySz + 1);
        ReadFile(keyFile, keyData as pchar, keySz);
        poke8(keyData+keySz,0);
        var key: DOSSHKey := SSHKeyCreate(creds, name, keyData as pchar);
        free(keyData, keySz + 1);
        if (key.id == 0) { PrintLn("Fehler beim Erstellen."c); return 1; }
        Print("SSH-Key ID: "c); PrintLn(key.id as pchar);
        DOSSHKeyFree(key);
        return 0;
    }

    if (argEq(sub, "delete"c) == 1) {
        if (argc < 5) { PrintLn("Usage: lyxdo compute ssh-key delete <id>"c); return 1; }
        var ok: int64 := SSHKeyDelete(creds, ArgvGet(argv, 4));
        if (ok == 1) { PrintLn("SSH-Key gelöscht."c); } else { PrintLn("Fehler."c); }
        return 0;
    }

    PrintLn("Unbekannter ssh-key Unterbefehl."c);
    return 1;
}

fn cmdCompute(argc: int64, argv: pchar): int64 {
    var creds: DOCredentials := loadCreds(argc, argv);
    if (creds.tokenLen == 0) { PrintLn("Kein Token."c); return 1; }
    if (argc < 3) { PrintLn("Usage: lyxdo compute <droplet|ssh-key|image|size>"c); DOCredentialsFree(creds); return 1; }
    var sub: pchar := ArgvGet(argv, 2);
    var ret: int64 := 0;

    if (argEq(sub, "droplet"c) == 1) { ret := cmdComputeDroplet(creds, argc, argv); }
    else if (argEq(sub, "ssh-key"c) == 1) { ret := cmdComputeSSHKey(creds, argc, argv); }
    else if (argEq(sub, "image"c) == 1) {
        var cl: DOClient; cl.token := creds.token; cl.tokenLen := creds.tokenLen;
        var typeFlag: pchar := flagVal(argc, argv, "--type"c);
        var path: pchar := "/v2/images?type=distribution"c;
        if (typeFlag != 0 as pchar) { path := "/v2/images"c; }
        var json: int64 := DOGetAll(cl, path, "images"c);
        if (json != 0) { PrintLn(json as pchar); free(json, StrLen(json as pchar)+1); }
    }
    else if (argEq(sub, "size"c) == 1) {
        var cl2: DOClient; cl2.token := creds.token; cl2.tokenLen := creds.tokenLen;
        var json2: int64 := DOGetAll(cl2, "/v2/sizes"c, "sizes"c);
        if (json2 != 0) { PrintLn(json2 as pchar); free(json2, StrLen(json2 as pchar)+1); }
    }
    else { PrintLn("Unbekannter compute Unterbefehl."c); ret := 1; }

    DOCredentialsFree(creds);
    return ret;
}

// --- spaces ---

fn cmdSpaces(argc: int64, argv: pchar): int64 {
    var creds: DOCredentials := loadCreds(argc, argv);
    if (creds.tokenLen == 0) { PrintLn("Kein Token."c); return 1; }
    if (argc < 3) { PrintLn("Usage: lyxdo spaces <ls|cp|rm|mb|rb|url|presign>"c); DOCredentialsFree(creds); return 1; }
    var sub: pchar := ArgvGet(argv, 2);
    var region: pchar := flagVal(argc, argv, "--region"c);
    if (region == 0 as pchar) { region := "fra1"c; }
    var ret: int64 := 0;

    if (argEq(sub, "ls"c) == 1) {
        if (argc >= 4) {
            // parse spaces://<bucket>[/<prefix>] or just <bucket>
            var arg: pchar := ArgvGet(argv, 3);
            var prefix: pchar := 0 as pchar;
            var bucket: pchar := arg;
            // find '/'
            var sl: int64 := StrLen(arg);
            var j: int64 := 0;
            while(j<sl){if((StrCharAt(arg,j)&0xFF)==47){prefix:=((arg as int64)+j+1) as pchar;break;}j:=j+1;}
            var json: int64 := SpacesObjectList(creds, bucket, region, prefix);
            if (json != 0) { PrintLn(json as pchar); free(json, StrLen(json as pchar)+1); }
        } else {
            var json: int64 := SpacesBucketList(creds, region);
            if (json != 0) { PrintLn(json as pchar); free(json, StrLen(json as pchar)+1); }
        }
    }
    else if (argEq(sub, "cp"c) == 1) {
        if (argc < 5) { PrintLn("Usage: lyxdo spaces cp <src> spaces://<bucket>/<key>"c); ret := 1; }
        else {
            var src: pchar := ArgvGet(argv, 3);
            var dst: pchar := ArgvGet(argv, 4);
            // check if src is spaces:// (download) or dst is spaces:// (upload)
            var schemeSrc: pchar := "spaces://"c;
            var schemeDst: pchar := "spaces://"c;
            if (argStart(src, schemeSrc) == 1) {
                // download: spaces://<bucket>/<key> → local
                var rest: pchar := argAfter(src, schemeSrc);
                var rlen: int64 := StrLen(rest);
                var bucket: pchar := rest;
                var key: pchar := 0 as pchar;
                var j: int64 := 0;
                while(j<rlen){if((StrCharAt(rest,j)&0xFF)==47){key:=((rest as int64)+j+1) as pchar;poke8(rest as int64+j,0);break;}j:=j+1;}
                if (key == 0 as pchar) { PrintLn("Ungültiges Format: spaces://<bucket>/<key>"c); ret := 1; }
                else { var r: int64 := SpacesObjectGetFile(creds, bucket, region, key, dst); if(r==0){PrintLn("Heruntergeladen."c);}else{PrintLn("Fehler."c);ret:=1;} }
            } else if (argStart(dst, schemeDst) == 1) {
                // upload: local → spaces://<bucket>/<key>
                var rest2: pchar := argAfter(dst, schemeDst);
                var rlen2: int64 := StrLen(rest2);
                var bucket2: pchar := rest2;
                var key2: pchar := 0 as pchar;
                var j2: int64 := 0;
                while(j2<rlen2){if((StrCharAt(rest2,j2)&0xFF)==47){key2:=((rest2 as int64)+j2+1) as pchar;poke8(rest2 as int64+j2,0);break;}j2:=j2+1;}
                if (key2 == 0 as pchar) { PrintLn("Ungültiges Format: spaces://<bucket>/<key>"c); ret := 1; }
                else { var r2: int64 := SpacesObjectPutFile(creds, bucket2, region, key2, src); if(r2==0){PrintLn("Hochgeladen."c);}else{PrintLn("Fehler."c);ret:=1;} }
            } else { PrintLn("Mindestens src oder dst muss spaces:// sein."c); ret := 1; }
        }
    }
    else if (argEq(sub, "rm"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo spaces rm spaces://<bucket>/<key>"c); ret := 1; }
        else {
            var arg: pchar := ArgvGet(argv, 3);
            var scheme: pchar := "spaces://"c;
            var rest: pchar := argAfter(arg, scheme);
            var rlen: int64 := StrLen(rest);
            var bucket: pchar := rest;
            var key: pchar := 0 as pchar;
            var j: int64 := 0;
            while(j<rlen){if((StrCharAt(rest,j)&0xFF)==47){key:=((rest as int64)+j+1) as pchar;poke8(rest as int64+j,0);break;}j:=j+1;}
            var ok: int64 := SpacesObjectDelete(creds, bucket, region, key);
            if (ok == 1) { PrintLn("Gelöscht."c); } else { PrintLn("Fehler."c); ret := 1; }
        }
    }
    else if (argEq(sub, "mb"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo spaces mb <bucket>"c); ret := 1; }
        else {
            var ok2: int64 := SpacesBucketCreate(creds, ArgvGet(argv, 3), region);
            if (ok2 == 1) { PrintLn("Bucket erstellt."c); } else { PrintLn("Fehler."c); ret := 1; }
        }
    }
    else if (argEq(sub, "rb"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo spaces rb <bucket>"c); ret := 1; }
        else {
            var ok3: int64 := SpacesBucketDelete(creds, ArgvGet(argv, 3), region);
            if (ok3 == 1) { PrintLn("Bucket gelöscht."c); } else { PrintLn("Fehler."c); ret := 1; }
        }
    }
    else if (argEq(sub, "url"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo spaces url <bucket>/<key>"c); ret := 1; }
        else {
            var arg2: pchar := ArgvGet(argv, 3);
            var alen: int64 := StrLen(arg2);
