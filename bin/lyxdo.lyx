// --- volume ---

fn cmdVolume(argc: int64, argv: pchar): int64 {
    var creds: DOCredentials := loadCreds(argc, argv);
    if (creds.tokenLen == 0) { PrintLn("Kein Token."c); return 1; }
    if (argc < 3) { PrintLn("Usage: lyxdo volume <list|get|create|delete|attach|detach|snapshot>"c); DOCredentialsFree(creds); return 1; }
    var sub: pchar := ArgvGet(argv, 2);
    var ret: int64 := 0;
    var cl: DOClient; cl.token := creds.token; cl.tokenLen := creds.tokenLen;

    if (argEq(sub, "list"c) == 1) {
        var json: int64 := DOGetAll(cl, "/v2/volumes"c, "volumes"c);
        if (json != 0) { PrintLn(json as pchar); free(json, StrLen(json as pchar)+1); }
    }
    else if (argEq(sub, "get"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo volume get <id>"c); ret := 1; }
        else {
            var v: DOVolume := VolumeGet(creds, ArgvGet(argv, 3));
            printKS("ID"c, v.id);
            printKS("Name"c, v.name);
            printKS("Region"c, v.region);
            printKS("Status"c, v.status);
            printKV("Size (GB)"c, v.sizeGiB);
            DOVolumeFree(v);
        }
    }
    else if (argEq(sub, "create"c) == 1) {
        var name: pchar    := flagVal(argc, argv, "--name"c);
        var region: pchar  := flagVal(argc, argv, "--region"c);
        var sizeStr: pchar := flagVal(argc, argv, "--size"c);
        if (name == 0 as pchar || region == 0 as pchar || sizeStr == 0 as pchar) {
            PrintLn("Pflicht: --name --region --size"c); ret := 1;
        } else {
            var nb: int64 := alloc(24);
            var sz: int64 := StrToInt64(sizeStr, nb);
            free(nb, 24);
            var v2: DOVolume := VolumeCreate(creds, name, region, sz);
            if (v2.id == 0) { PrintLn("Fehler."c); ret := 1; }
            else { Print("Volume-ID: "c); PrintLn(v2.id as pchar); DOVolumeFree(v2); }
        }
    }
    else if (argEq(sub, "delete"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo volume delete <id>"c); ret := 1; }
        else {
            var ok: int64 := VolumeDelete(creds, ArgvGet(argv, 3));
            if (ok == 1) { PrintLn("Gelöscht."c); } else { PrintLn("Fehler."c); ret := 1; }
        }
    }
    else if (argEq(sub, "attach"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo volume attach <id> --droplet-id <did>"c); ret := 1; }
        else {
            var didStr: pchar := flagVal(argc, argv, "--droplet-id"c);
            var nb2: int64 := alloc(24);
            var did: int64 := StrToInt64(didStr, nb2);
            free(nb2, 24);
            var ok2: int64 := VolumeAttach(creds, ArgvGet(argv, 3), did);
            if (ok2 == 1) { PrintLn("Angehängt."c); } else { PrintLn("Fehler."c); ret := 1; }
        }
    }
    else if (argEq(sub, "detach"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo volume detach <id>"c); ret := 1; }
        else {
            var ok3: int64 := VolumeDetach(creds, ArgvGet(argv, 3), 0);
            if (ok3 == 1) { PrintLn("Getrennt."c); } else { PrintLn("Fehler."c); ret := 1; }
        }
    }
    else if (argEq(sub, "snapshot"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo volume snapshot <id> --snapshot-name <n>"c); ret := 1; }
        else {
            var snName: pchar := flagVal(argc, argv, "--snapshot-name"c);
            if (snName == 0 as pchar) { PrintLn("Pflicht: --snapshot-name"c); ret := 1; }
            else {
                var snap: DOSnapshot := VolumeSnapshotCreate(creds, ArgvGet(argv, 3), snName);
                if (snap.id == 0) { PrintLn("Fehler."c); ret := 1; }
                else { Print("Snapshot-ID: "c); PrintLn(snap.id as pchar); DOSnapshotFree(snap); }
            }
        }
    }
    else { PrintLn("Unbekannter volume Unterbefehl."c); ret := 1; }

    DOCredentialsFree(creds);
    return ret;
}

// --- apps ---

fn cmdApps(argc: int64, argv: pchar): int64 {
    var creds: DOCredentials := loadCreds(argc, argv);
    if (creds.tokenLen == 0) { PrintLn("Kein Token."c); return 1; }
    if (argc < 3) { PrintLn("Usage: lyxdo apps <list|get|create|delete|update|deploy|logs|deployments>"c); DOCredentialsFree(creds); return 1; }
    var sub: pchar := ArgvGet(argv, 2);
    var ret: int64 := 0;

    if (argEq(sub, "list"c) == 1) {
        var json: int64 := AppList(creds);
        if (json != 0) { PrintLn(json as pchar); free(json, StrLen(json as pchar)+1); }
    }
    else if (argEq(sub, "get"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo apps get <id>"c); ret := 1; }
        else {
            var a: DOApp := AppGet(creds, ArgvGet(argv, 3));
            printKS("ID"c, a.id);
            printKS("Status"c, a.status);
            printKS("LiveURL"c, a.liveURL);
            DOAppFree(a);
        }
    }
    else if (argEq(sub, "create"c) == 1) {
        var specPath: pchar := flagVal(argc, argv, "--spec"c);
        if (specPath == 0 as pchar) { PrintLn("Pflicht: --spec <spec.json>"c); ret := 1; }
        else {
            var sz: int64 := FileSize(specPath);
            if (sz <= 0) { PrintLn("Spec-Datei nicht gefunden."c); ret := 1; }
            else {
                var specData: int64 := alloc(sz + 1);
                ReadFile(specPath, specData as pchar, sz);
                poke8(specData+sz, 0);
                var a2: DOApp := AppCreateFromSpec(creds, specData, sz);
                free(specData, sz + 1);
                if (a2.id == 0) { PrintLn("Fehler."c); ret := 1; }
                else { Print("App-ID: "c); PrintLn(a2.id as pchar); DOAppFree(a2); }
            }
        }
    }
    else if (argEq(sub, "delete"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo apps delete <id>"c); ret := 1; }
        else {
            var ok: int64 := AppDelete(creds, ArgvGet(argv, 3));
            if (ok == 1) { PrintLn("Gelöscht."c); } else { PrintLn("Fehler."c); ret := 1; }
        }
    }
    else if (argEq(sub, "deploy"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo apps deploy <id> [--force-rebuild]"c); ret := 1; }
        else {
            var force: int64 := flagBool(argc, argv, "--force-rebuild"c);
            var d: DODeployment := AppDeploy(creds, ArgvGet(argv, 3), force);
            if (d.id == 0) { PrintLn("Fehler."c); ret := 1; }
            else { Print("Deployment-ID: "c); PrintLn(d.id as pchar); DODeploymentFree(d); }
        }
    }
    else if (argEq(sub, "logs"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo apps logs <id> [--component <n>] [--type RUN]"c); ret := 1; }
        else {
            var comp: pchar := flagVal(argc, argv, "--component"c);
            var ltype: pchar := flagVal(argc, argv, "--type"c);
            if (ltype == 0 as pchar) { ltype := "RUN"c; }
            var json2: int64 := AppLogs(creds, ArgvGet(argv, 3), comp, ltype);
            if (json2 != 0) { PrintLn(json2 as pchar); free(json2, StrLen(json2 as pchar)+1); }
        }
    }
    else if (argEq(sub, "deployments"c) == 1) {
        if (argc < 5) { PrintLn("Usage: lyxdo apps deployments list <id>"c); ret := 1; }
        else {
            var action: pchar := ArgvGet(argv, 3);
            if (argEq(action, "list"c) == 1) {
                var json3: int64 := AppDeploymentList(creds, ArgvGet(argv, 4));
                if (json3 != 0) { PrintLn(json3 as pchar); free(json3, StrLen(json3 as pchar)+1); }
            } else { PrintLn("Unbekannte deployments Aktion."c); ret := 1; }
        }
    }
    else { PrintLn("Unbekannter apps Unterbefehl."c); ret := 1; }

    DOCredentialsFree(creds);
    return ret;
}

// --- registry ---

fn cmdRegistry(argc: int64, argv: pchar): int64 {
    var creds: DOCredentials := loadCreds(argc, argv);
    if (creds.tokenLen == 0) { PrintLn("Kein Token."c); return 1; }
    if (argc < 3) { PrintLn("Usage: lyxdo registry <get|docker-credentials|repository|tag|garbage-collection>"c); DOCredentialsFree(creds); return 1; }
    var sub: pchar := ArgvGet(argv, 2);
    var ret: int64 := 0;

    if (argEq(sub, "get"c) == 1) {
        var r: DORegistry := RegistryGet(creds);
        printKS("Name"c, r.name);
        printKS("URL"c, r.serverURL);
        printKS("Region"c, r.region);
        printKV("Storage (bytes)"c, r.storageUsed);
        DORegistryFree(r);
    }
    else if (argEq(sub, "docker-credentials"c) == 1) {
        var json: int64 := RegistryDockerLogin(creds);
        if (json != 0) {
            var savePath: pchar := flagVal(argc, argv, "--save"c);
            if (savePath != 0 as pchar) {
                WriteFile(savePath, json as pchar, StrLen(json as pchar));
                Print("Gespeichert: "c); PrintLn(savePath);
            } else { PrintLn(json as pchar); }
            free(json, StrLen(json as pchar)+1);
        }
    }
    else if (argEq(sub, "repository"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo registry repository list"c); ret := 1; }
        else {
            var action: pchar := ArgvGet(argv, 3);
            if (argEq(action, "list"c) == 1) {
                var r2: DORegistry := RegistryGet(creds);
                if (r2.name == 0) { PrintLn("Kein Registry gefunden."c); ret := 1; }
                else {
                    var json2: int64 := RegistryRepositoryList(creds, r2.name as pchar);
                    if (json2 != 0) { PrintLn(json2 as pchar); free(json2, StrLen(json2 as pchar)+1); }
                    DORegistryFree(r2);
                }
            } else { PrintLn("Unbekannte repository Aktion."c); ret := 1; }
        }
    }
    else if (argEq(sub, "tag"c) == 1) {
        if (argc < 5) { PrintLn("Usage: lyxdo registry tag <list|delete> <repo>"c); ret := 1; }
        else {
            var action2: pchar := ArgvGet(argv, 3);
            var repo: pchar    := ArgvGet(argv, 4);
            var r3: DORegistry := RegistryGet(creds);
            if (r3.name == 0) { PrintLn("Kein Registry."c); ret := 1; }
            else {
                if (argEq(action2, "list"c) == 1) {
                    var json3: int64 := RegistryTagList(creds, r3.name as pchar, repo);
                    if (json3 != 0) { PrintLn(json3 as pchar); free(json3, StrLen(json3 as pchar)+1); }
                }
                else if (argEq(action2, "delete"c) == 1) {
                    if (argc < 6) { PrintLn("Usage: lyxdo registry tag delete <repo> <tag>"c); ret := 1; }
                    else {
                        var ok: int64 := RegistryTagDelete(creds, r3.name as pchar, repo, ArgvGet(argv, 5));
                        if (ok == 1) { PrintLn("Tag gelöscht."c); } else { PrintLn("Fehler."c); ret := 1; }
                    }
                }
                else { PrintLn("Unbekannte tag Aktion."c); ret := 1; }
                DORegistryFree(r3);
            }
        }
    }
    else if (argEq(sub, "garbage-collection"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo registry garbage-collection run"c); ret := 1; }
        else {
            var action3: pchar := ArgvGet(argv, 3);
            if (argEq(action3, "run"c) == 1) {
                var r4: DORegistry := RegistryGet(creds);
                if (r4.name == 0) { PrintLn("Kein Registry."c); ret := 1; }
                else {
                    var ok2: int64 := RegistryGarbageCollect(creds, r4.name as pchar);
                    if (ok2 == 1) { PrintLn("GC gestartet."c); } else { PrintLn("Fehler."c); ret := 1; }
                    DORegistryFree(r4);
                }
            } else { PrintLn("Unbekannte GC-Aktion."c); ret := 1; }
        }
    }
    else { PrintLn("Unbekannter registry Unterbefehl."c); ret := 1; }

    DOCredentialsFree(creds);
    return ret;
}

