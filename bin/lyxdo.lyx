            }
            else { PrintLn("Unbekannte namespace Aktion."c); ret := 1; }
        }
    }
    else if (argEq(sub, "invoke"c) == 1) {
        if (argc < 5) { PrintLn("Usage: lyxdo functions invoke <ns-uuid> <function> [--param '{\"key\":\"val\"}']"c); ret := 1; }
        else {
            var nsId: pchar := ArgvGet(argv, 3);
            var fn2: pchar  := ArgvGet(argv, 4);
            var params: pchar := flagVal(argc, argv, "--param"c);
            var paramsData: int64 := 0;
            var paramsLen: int64  := 0;
            if (params != 0 as pchar) { paramsData := params as int64; paramsLen := StrLen(params); }
            var result: int64 := FunctionInvoke(creds, nsId, fn2, paramsData, paramsLen);
            if (result != 0) { PrintLn(result as pchar); free(result, StrLen(result as pchar)+1); }
        }
    }
    else { PrintLn("Unbekannter functions Unterbefehl."c); ret := 1; }

    DOCredentialsFree(creds);
    return ret;
}

// --- monitoring ---

fn cmdMonitoring(argc: int64, argv: pchar): int64 {
    var creds: DOCredentials := loadCreds(argc, argv);
    if (creds.tokenLen == 0) { PrintLn("Kein Token."c); return 1; }
    if (argc < 3) { PrintLn("Usage: lyxdo monitoring <metrics|alert>"c); DOCredentialsFree(creds); return 1; }
    var sub: pchar := ArgvGet(argv, 2);
    var ret: int64 := 0;

    if (argEq(sub, "metrics"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo monitoring metrics get <droplet-id> --metric cpu"c); ret := 1; }
        else {
            var action: pchar := ArgvGet(argv, 3);
            if (argEq(action, "get"c) == 1) {
                if (argc < 5) { PrintLn("Usage: lyxdo monitoring metrics get <id> --metric <cpu|memory|disk|bandwidth|load>"c); ret := 1; }
                else {
                    var metId: pchar    := ArgvGet(argv, 4);
                    var metric: pchar   := flagVal(argc, argv, "--metric"c);
                    if (metric == 0 as pchar) { metric := "cpu"c; }
                    var startStr: pchar := flagVal(argc, argv, "--start"c);
                    var endStr: pchar   := flagVal(argc, argv, "--end"c);
                    var ts: int64 := 0; // default: 0 = last hour relative
                    var te: int64 := 0;
                    if (startStr != 0 as pchar) { var nb: int64 := alloc(24); ts := StrToInt64(startStr, nb); free(nb, 24); }
                    if (endStr   != 0 as pchar) { var nb2: int64 := alloc(24); te := StrToInt64(endStr,   nb2); free(nb2, 24); }
                    var json: int64 := 0;
                    if (argEq(metric, "cpu"c) == 1)       { json := MetricDropletCPU(creds, metId, ts, te); }
                    else if (argEq(metric, "memory"c) == 1) { json := MetricDropletMemory(creds, metId, ts, te); }
                    else if (argEq(metric, "disk"c) == 1)   { json := MetricDropletDisk(creds, metId, ts, te); }
                    else if (argEq(metric, "bandwidth"c) == 1) { json := MetricDropletBandwidth(creds, metId, ts, te); }
                    else if (argEq(metric, "load"c) == 1)   { json := MetricDropletLoad(creds, metId, ts, te); }
                    else { PrintLn("Unbekannte Metrik. Verfügbar: cpu memory disk bandwidth load"c); ret := 1; }
                    if (json != 0) { PrintLn(json as pchar); free(json, StrLen(json as pchar)+1); }
                }
            } else { PrintLn("Unbekannte metrics Aktion."c); ret := 1; }
        }
    }
    else if (argEq(sub, "alert"c) == 1) {
        if (argc < 4) { PrintLn("Usage: lyxdo monitoring alert <list|create|delete>"c); ret := 1; }
        else {
            var action2: pchar := ArgvGet(argv, 3);
            if (argEq(action2, "list"c) == 1) {
                var json2: int64 := AlertList(creds);
                if (json2 != 0) { PrintLn(json2 as pchar); free(json2, StrLen(json2 as pchar)+1); }
            }
            else if (argEq(action2, "create"c) == 1) {
                var atype: pchar   := flagVal(argc, argv, "--type"c);
                var compare: pchar := flagVal(argc, argv, "--compare"c);
                var valStr: pchar  := flagVal(argc, argv, "--value"c);
                var window: pchar  := flagVal(argc, argv, "--window"c);
                var email: pchar   := flagVal(argc, argv, "--emails"c);
                var dids: pchar    := flagVal(argc, argv, "--droplet-ids"c);
                if (atype == 0 as pchar || compare == 0 as pchar || valStr == 0 as pchar) {
                    PrintLn("Pflicht: --type --compare --value"c); ret := 1;
                } else {
                    if (window == 0 as pchar) { window := "5m"c; }
                    var nb3: int64 := alloc(24);
                    var aval: int64 := StrToInt64(valStr, nb3);
                    free(nb3, 24);
                    var a: DOAlert := AlertCreate(creds, "lyxdo-alert"c, atype, compare, aval, window, email, dids);
                    if (a.uuid == 0) { PrintLn("Fehler."c); ret := 1; }
                    else { Print("Alert-UUID: "c); PrintLn(a.uuid as pchar); DOAlertFree(a); }
                }
            }
            else if (argEq(action2, "delete"c) == 1) {
                if (argc < 5) { PrintLn("Usage: lyxdo monitoring alert delete <uuid>"c); ret := 1; }
                else {
                    var ok: int64 := AlertDelete(creds, ArgvGet(argv, 4));
                    if (ok == 1) { PrintLn("Gelöscht."c); } else { PrintLn("Fehler."c); ret := 1; }
                }
            }
            else { PrintLn("Unbekannte alert Aktion."c); ret := 1; }
        }
    }
    else { PrintLn("Unbekannter monitoring Unterbefehl."c); ret := 1; }

    DOCredentialsFree(creds);
    return ret;
}

// --- main ---

pub fn main(argc: int64, argv: pchar): int64 {
    if (argc < 2) { usage(); return 0; }

    var cmd: pchar := ArgvGet(argv, 1);

    if (argEq(cmd, "--help"c) == 1 || argEq(cmd, "-h"c) == 1) { usage(); return 0; }
    if (argEq(cmd, "--version"c) == 1 || argEq(cmd, "-v"c) == 1) {
        PrintLn("lyxdo 0.1.0 (DigitalOcean CLI, Lyx)"c);
        return 0;
    }

    if (argEq(cmd, "auth"c)       == 1) { return cmdAuth(argc, argv); }
    if (argEq(cmd, "account"c)    == 1) { return cmdAccount(argc, argv); }
    if (argEq(cmd, "compute"c)    == 1) { return cmdCompute(argc, argv); }
    if (argEq(cmd, "spaces"c)     == 1) { return cmdSpaces(argc, argv); }
    if (argEq(cmd, "database"c)   == 1) { return cmdDatabase(argc, argv); }
    if (argEq(cmd, "kubernetes"c) == 1) { return cmdKubernetes(argc, argv); }
    if (argEq(cmd, "networking"c) == 1) { return cmdNetworking(argc, argv); }
    if (argEq(cmd, "volume"c)     == 1) { return cmdVolume(argc, argv); }
    if (argEq(cmd, "apps"c)       == 1) { return cmdApps(argc, argv); }
    if (argEq(cmd, "registry"c)   == 1) { return cmdRegistry(argc, argv); }
    if (argEq(cmd, "functions"c)  == 1) { return cmdFunctions(argc, argv); }
    if (argEq(cmd, "monitoring"c) == 1) { return cmdMonitoring(argc, argv); }

    Print("Unbekannter Befehl: "c);
    PrintLn(cmd);
    PrintLn("Führe 'lyxdo --help' für Hilfe aus."c);
    return 1;
}
