// ─────────────────────────────────────────────────────────────────────────────
// email
// ─────────────────────────────────────────────────────────────────────────────

fn cmdEmail(argc: int64, argv: int64, c: CFClient) {
    var sub: pchar := argGet(argc, argv, 2);

    if (streq(sub, "status"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        if (streq(zoneId, ""c) == 1) { zoneId = getZoneId(c); }
        var s: CFEmailSettings := EmailRoutingGet(c, zoneId);
        if (s.enabled == 1) { PrintLn("Email routing: ENABLED"c); }
        else { PrintLn("Email routing: DISABLED"c); }
        CFEmailSettingsFree(s); return;
    }
    if (streq(sub, "enable"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        if (streq(zoneId, ""c) == 1) { zoneId = getZoneId(c); }
        var ok: int64 := EmailRoutingEnable(c, zoneId);
        if (ok == 1) { PrintLn("Enabled."c); } else { PrintLn("Failed."c); }
        return;
    }
    if (streq(sub, "rules"c) == 1) {
        var rsub:   pchar := argGet(argc, argv, 3);
        var zoneId: pchar := argGet(argc, argv, 4);
        if (streq(zoneId, ""c) == 1) { zoneId = getZoneId(c); }
        if (streq(rsub, "list"c) == 1) {
            var j: int64 := EmailRuleList(c, zoneId);
            printJson(j); return;
        }
        if (streq(rsub, "create"c) == 1) {
            var fromAddr: pchar := argGet(argc, argv, 5);
            var toAddr:   pchar := argGet(argc, argv, 6);
            var rule: CFEmailRule := EmailRuleCreate(c, zoneId,
                "Forward rule"c, 1,
                "literal"c, "to"c, fromAddr,
                "forward"c, toAddr);
            if (rule.id != 0) { Print("Rule created: "c); PrintLn(rule.id as pchar); }
            else { PrintLn("Failed."c); }
            CFEmailRuleFree(rule); return;
        }
        if (streq(rsub, "delete"c) == 1) {
            var ruleId: pchar := argGet(argc, argv, 5);
            var ok: int64 := EmailRuleDelete(c, zoneId, ruleId);
            if (ok == 1) { PrintLn("Deleted."c); } else { PrintLn("Failed."c); }
            return;
        }
        PrintLn("email rules: list <zoneId> | create <zoneId> <from> <to> | delete <zoneId> <ruleId>"c);
        return;
    }
    if (streq(sub, "catch-all"c) == 1) {
        var csub:   pchar := argGet(argc, argv, 3);
        var zoneId: pchar := argGet(argc, argv, 4);
        if (streq(zoneId, ""c) == 1) { zoneId = getZoneId(c); }
        if (streq(csub, "set"c) == 1) {
            var action: pchar := argGet(argc, argv, 5);
            var dest:   pchar := argGet(argc, argv, 6);
            var ok: int64 := EmailCatchAllSet(c, zoneId, action, dest, 1);
            if (ok == 1) { PrintLn("Catch-all set."c); } else { PrintLn("Failed."c); }
            return;
        }
        var ca: CFEmailRule := EmailCatchAllGet(c, zoneId);
        if (ca.actions != 0) { PrintLn(ca.actions as pchar); }
        else { PrintLn("[not configured]"c); }
        CFEmailRuleFree(ca); return;
    }
    if (streq(sub, "destinations"c) == 1) {
        var accountId: pchar := getAccountId(c);
        var j: int64 := EmailDestinationList(c, accountId);
        printJson(j); return;
    }
    PrintLn("email: status | enable | rules list|create|delete | catch-all [set] | destinations"c);
}

// ─────────────────────────────────────────────────────────────────────────────
// main
// ─────────────────────────────────────────────────────────────────────────────

pub fn main(argc: int64, argv: int64): int64 {
    if (argc < 2) { printUsage(); return 1; }

    var cmd: pchar := argGet(argc, argv, 1);

    if (streq(cmd, "help"c) == 1 || streq(cmd, "--help"c) == 1 || streq(cmd, "-h"c) == 1) {
        printUsage(); return 0;
    }

    var c: CFClient := clientFromEnv();

    if (c.authType == 0) {
        PrintLn("Error: no credentials found."c);
        PrintLn("Set CF_AUTH_TOKEN or CF_AUTH_KEY + CF_AUTH_EMAIL"c);
        return 1;
    }

    if (streq(cmd, "auth"c) == 1)      { cmdAuth(argc, argv, c); return 0; }
    if (streq(cmd, "zone"c) == 1)      { cmdZone(argc, argv, c); return 0; }
    if (streq(cmd, "dns"c) == 1)       { cmdDNS(argc, argv, c); return 0; }
    if (streq(cmd, "cache"c) == 1)     { cmdCache(argc, argv, c); return 0; }
    if (streq(cmd, "firewall"c) == 1)  { cmdFirewall(argc, argv, c); return 0; }
    if (streq(cmd, "lb"c) == 1)        { cmdLB(argc, argv, c); return 0; }
    if (streq(cmd, "workers"c) == 1)   { cmdWorkers(argc, argv, c); return 0; }
    if (streq(cmd, "r2"c) == 1)        { cmdR2(argc, argv, c); return 0; }
    if (streq(cmd, "d1"c) == 1)        { cmdD1(argc, argv, c); return 0; }
    if (streq(cmd, "pages"c) == 1)     { cmdPages(argc, argv, c); return 0; }
    if (streq(cmd, "tunnel"c) == 1)    { cmdTunnel(argc, argv, c); return 0; }
    if (streq(cmd, "analytics"c) == 1) { cmdAnalytics(argc, argv, c); return 0; }
    if (streq(cmd, "email"c) == 1)     { cmdEmail(argc, argv, c); return 0; }

    Print("Unknown command: "c); PrintLn(cmd);
    printUsage();
    return 1;
}
