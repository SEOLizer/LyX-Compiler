fn cmdWorkers(argc: int64, argv: int64, c: CFClient) {
    var sub: pchar := argGet(argc, argv, 2);
    var accountId: pchar := getAccountId(c);

    if (streq(sub, "scripts"c) == 1) {
        var j: int64 := WorkerList(c, accountId);
        printJson(j); return;
    }
    if (streq(sub, "routes"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        if (streq(zoneId, ""c) == 1) { zoneId = getZoneId(c); }
        var j: int64 := WorkerRouteList(c, zoneId);
        printJson(j); return;
    }
    if (streq(sub, "deploy"c) == 1) {
        var name:   pchar := argGet(argc, argv, 3);
        var script: pchar := argGet(argc, argv, 4);
        var sl: int64 := StrLen(script);
        var ok: int64 := WorkerDeploy(c, accountId, name, script as int64, sl);
        if (ok == 1) { PrintLn("Deployed."c); } else { PrintLn("Failed."c); }
        return;
    }
    if (streq(sub, "delete"c) == 1) {
        var name: pchar := argGet(argc, argv, 3);
        var ok: int64 := WorkerDelete(c, accountId, name);
        if (ok == 1) { PrintLn("Deleted."c); } else { PrintLn("Failed."c); }
        return;
    }
    if (streq(sub, "kv"c) == 1) {
        var ksub: pchar := argGet(argc, argv, 3);
        if (streq(ksub, "list"c) == 1) {
            var j: int64 := KVNamespaceList(c, accountId);
            printJson(j); return;
        }
        if (streq(ksub, "get"c) == 1) {
            var nsId: pchar := argGet(argc, argv, 4);
            var key:  pchar := argGet(argc, argv, 5);
            var val: int64 := KVGet(c, accountId, nsId, key);
            printJson(val); return;
        }
        if (streq(ksub, "put"c) == 1) {
            var nsId:  pchar := argGet(argc, argv, 4);
            var key:   pchar := argGet(argc, argv, 5);
            var value: pchar := argGet(argc, argv, 6);
            var vl: int64 := StrLen(value);
            var ok: int64 := KVPut(c, accountId, nsId, key, value as int64, vl);
            if (ok == 1) { PrintLn("Set."c); } else { PrintLn("Failed."c); }
            return;
        }
        if (streq(ksub, "delete"c) == 1) {
            var nsId: pchar := argGet(argc, argv, 4);
            var key:  pchar := argGet(argc, argv, 5);
            var ok: int64 := KVDelete(c, accountId, nsId, key);
            if (ok == 1) { PrintLn("Deleted."c); } else { PrintLn("Failed."c); }
            return;
        }
        PrintLn("workers kv: list | get <nsId> <key> | put <nsId> <key> <val> | delete <nsId> <key>"c);
        return;
    }
    if (streq(sub, "secrets"c) == 1) {
        var name:  pchar := argGet(argc, argv, 3);
        var ssub:  pchar := argGet(argc, argv, 4);
        if (streq(ssub, "list"c) == 1) {
            var j: int64 := WorkerSecretList(c, accountId, name);
            printJson(j); return;
        }
        if (streq(ssub, "set"c) == 1) {
            var skey: pchar := argGet(argc, argv, 5);
            var sval: pchar := argGet(argc, argv, 6);
            var ok: int64 := WorkerSecretSet(c, accountId, name, skey, sval);
            if (ok == 1) { PrintLn("Secret set."c); } else { PrintLn("Failed."c); }
            return;
        }
        if (streq(ssub, "delete"c) == 1) {
            var skey: pchar := argGet(argc, argv, 5);
            var ok: int64 := WorkerSecretDelete(c, accountId, name, skey);
            if (ok == 1) { PrintLn("Deleted."c); } else { PrintLn("Failed."c); }
            return;
        }
        PrintLn("workers secrets <name>: list | set <key> <val> | delete <key>"c);
        return;
    }
    if (streq(sub, "cron"c) == 1) {
        var name: pchar := argGet(argc, argv, 3);
        var j: int64 := WorkerCronList(c, accountId, name);
        printJson(j); return;
    }
    PrintLn("workers: scripts | routes [zoneId] | deploy <name> <script>"c);
    PrintLn("         delete <name> | kv ... | secrets <name> ... | cron <name>"c);
}

// ─────────────────────────────────────────────────────────────────────────────
// r2
// ─────────────────────────────────────────────────────────────────────────────

fn cmdR2(argc: int64, argv: int64, c: CFClient) {
    var sub: pchar := argGet(argc, argv, 2);
    var accountId: pchar := getAccountId(c);

    if (streq(sub, "buckets"c) == 1) {
        var bsub: pchar := argGet(argc, argv, 3);
        if (streq(bsub, "list"c) == 1 || streq(bsub, ""c) == 1) {
            var j: int64 := R2BucketList(c, accountId);
            printJson(j); return;
        }
        if (streq(bsub, "create"c) == 1) {
            var name: pchar := argGet(argc, argv, 4);
            var ok: int64 := R2BucketCreate(c, accountId, name, "WEUR"c);
            if (ok == 1) { PrintLn("Bucket created."c); } else { PrintLn("Failed."c); }
            return;
        }
        if (streq(bsub, "delete"c) == 1) {
            var name: pchar := argGet(argc, argv, 4);
            var ok: int64 := R2BucketDelete(c, accountId, name);
            if (ok == 1) { PrintLn("Bucket deleted."c); } else { PrintLn("Failed."c); }
            return;
        }
        PrintLn("r2 buckets: list | create <name> | delete <name>"c);
        return;
    }
    if (streq(sub, "objects"c) == 1) {
        var osub:   pchar := argGet(argc, argv, 3);
        var bucket: pchar := argGet(argc, argv, 4);
        var key:    pchar := argGet(argc, argv, 5);

        var r2: R2Conn := R2Connect(c, accountId);

        if (streq(osub, "list"c) == 1) {
            var j: int64 := R2List(r2, bucket, ""c, 1000);
            printJson(j); return;
        }
        if (streq(osub, "get"c) == 1) {
            var sz: int64 := 0;
            var data: int64 := R2Download(r2, bucket, key, &sz);
            if (data != 0) {
                sys_write(1, data, sz);
                sys_munmap(data, sz+1);
            } else { PrintLn("[not found]"c); }
            return;
        }
        if (streq(osub, "put"c) == 1) {
            var local: pchar := argGet(argc, argv, 6);
            // Read local file and upload
            var fd: int64 := sys_open(local, 0, 0);
            if (fd < 0) { Print("Cannot open: "c); PrintLn(local); return; }
            var buf: int64 := alloc(4096*1024);
            var n: int64 := sys_read(fd, buf, 4096*1024);
            sys_close(fd);
            if (n > 0) {
                var ok: int64 := R2Upload(r2, bucket, key, buf, n, "application/octet-stream"c);
                if (ok == 1) { PrintLn("Uploaded."c); } else { PrintLn("Failed."c); }
            } else { PrintLn("Empty file or read error."c); }
            free(buf, 4096*1024);
            return;
        }
        if (streq(osub, "delete"c) == 1) {
            var ok: int64 := R2Delete(r2, bucket, key);
            if (ok == 1) { PrintLn("Deleted."c); } else { PrintLn("Failed."c); }
            return;
        }
        PrintLn("r2 objects: list <bucket> | get <bucket> <key> | put <bucket> <key> <localfile> | delete <bucket> <key>"c);
        return;
    }
    PrintLn("r2: buckets | objects"c);
}

// ─────────────────────────────────────────────────────────────────────────────
// d1
// ─────────────────────────────────────────────────────────────────────────────

fn cmdD1(argc: int64, argv: int64, c: CFClient) {
    var sub: pchar := argGet(argc, argv, 2);
    var accountId: pchar := getAccountId(c);

    if (streq(sub, "databases"c) == 1) {
        var dsub: pchar := argGet(argc, argv, 3);
        if (streq(dsub, "list"c) == 1 || streq(dsub, ""c) == 1) {
            var j: int64 := D1List(c, accountId);
            printJson(j); return;
        }
        if (streq(dsub, "create"c) == 1) {
            var name: pchar := argGet(argc, argv, 4);
            var db: CFD1Database := D1Create(c, accountId, name);
            if (db.uuid != 0) { Print("Created: "c); PrintLn(db.uuid as pchar); }
            else { PrintLn("Failed."c); }
            CFD1DatabaseFree(db); return;
        }
        if (streq(dsub, "delete"c) == 1) {
            var dbId: pchar := argGet(argc, argv, 4);
            var ok: int64 := D1Delete(c, accountId, dbId);
            if (ok == 1) { PrintLn("Deleted."c); } else { PrintLn("Failed."c); }
            return;
        }
        PrintLn("d1 databases: list | create <name> | delete <id>"c);
        return;
    }
    if (streq(sub, "execute"c) == 1) {
        var dbId: pchar := argGet(argc, argv, 3);
        var sql:  pchar := argGet(argc, argv, 4);
        var r: D1Result := D1Exec(c, accountId, dbId, sql);
        Print("rows_affected: "c);
        var rbuf: int64 := alloc(24);
        var rstr: int64 := int64ToStr(r.rowsAffected, rbuf);
        PrintLn(rbuf as pchar); free(rbuf, 24);
        if (r.results != 0) { PrintLn(r.results as pchar); }
        D1ResultFree(r); return;
    }
    if (streq(sub, "query"c) == 1) {
        var dbId: pchar := argGet(argc, argv, 3);
        var sql:  pchar := argGet(argc, argv, 4);
        var r: D1Result := D1Exec(c, accountId, dbId, sql);
        if (r.results != 0) { printJson(r.results); r.results := 0; }
        else { PrintLn("[no results]"c); }
        D1ResultFree(r); return;
    }
    if (streq(sub, "tables"c) == 1) {
        var dbId: pchar := argGet(argc, argv, 3);
        var j: int64 := D1Tables(c, accountId, dbId);
        printJson(j); return;
    }
    if (streq(sub, "schema"c) == 1) {
        var dbId:  pchar := argGet(argc, argv, 3);
        var table: pchar := argGet(argc, argv, 4);
        var j: int64 := D1Schema(c, accountId, dbId, table);
        printJson(j); return;
    }
    PrintLn("d1: databases | execute <dbId> <sql> | query <dbId> <sql>"c);
    PrintLn("    tables <dbId> | schema <dbId> <table>"c);
}

// ─────────────────────────────────────────────────────────────────────────────
// pages
// ─────────────────────────────────────────────────────────────────────────────

fn cmdPages(argc: int64, argv: int64, c: CFClient) {
    var sub: pchar := argGet(argc, argv, 2);
    var accountId: pchar := getAccountId(c);

    if (streq(sub, "projects"c) == 1) {
        var psub: pchar := argGet(argc, argv, 3);
        if (streq(psub, "list"c) == 1 || streq(psub, ""c) == 1) {
            var j: int64 := PagesProjectList(c, accountId);
            printJson(j); return;
        }
        if (streq(psub, "get"c) == 1) {
            var name: pchar := argGet(argc, argv, 4);
            var p: CFPagesProject := PagesProjectGet(c, accountId, name);
            if (p.name != 0) { Print("URL: https://"c); Print(p.subdomain as pchar); PrintLn(".pages.dev"c); }
            else { PrintLn("[not found]"c); }
            CFPagesProjectFree(p); return;
        }
        if (streq(psub, "delete"c) == 1) {
            var name: pchar := argGet(argc, argv, 4);
            var ok: int64 := PagesProjectDelete(c, accountId, name);
            if (ok == 1) { PrintLn("Deleted."c); } else { PrintLn("Failed."c); }
            return;
        }
        if (streq(psub, "deploy"c) == 1) {
            var name: pchar := argGet(argc, argv, 4);
            var branch: pchar := argGet(argc, argv, 5);
            var dep: CFPagesDeployment := PagesDeploy(c, accountId, name, branch);
            if (dep.id != 0) { Print("Deployment: "c); PrintLn(dep.id as pchar); }
            else { PrintLn("Failed."c); }
            CFPagesDeploymentFree(dep); return;
        }
        PrintLn("pages projects: list | get <name> | delete <name> | deploy <name> [branch]"c);
        return;
    }
    if (streq(sub, "deployments"c) == 1) {
        var dsub: pchar := argGet(argc, argv, 3);
        var name: pchar := argGet(argc, argv, 4);
        if (streq(dsub, "list"c) == 1) {
            var j: int64 := PagesDeploymentList(c, accountId, name);
            printJson(j); return;
        }
        if (streq(dsub, "rollback"c) == 1) {
            var depId: pchar := argGet(argc, argv, 5);
            var ok: int64 := PagesDeploymentRollback(c, accountId, name, depId);
            if (ok == 1) { PrintLn("Rollback triggered."c); } else { PrintLn("Failed."c); }
            return;
        }
        PrintLn("pages deployments: list <name> | rollback <name> <deployId>"c);
        return;
    }
    if (streq(sub, "domains"c) == 1) {
        var name: pchar := argGet(argc, argv, 3);
        var dsub: pchar := argGet(argc, argv, 4);
        if (streq(dsub, "list"c) == 1 || streq(dsub, ""c) == 1) {
            var j: int64 := PagesDomainList(c, accountId, name);
            printJson(j); return;
        }
        if (streq(dsub, "add"c) == 1) {
            var domain: pchar := argGet(argc, argv, 5);
            var ok: int64 := PagesDomainAdd(c, accountId, name, domain);
            if (ok == 1) { PrintLn("Domain added."c); } else { PrintLn("Failed."c); }
            return;
        }
        PrintLn("pages domains <name>: list | add <domain>"c);
        return;
    }
    if (streq(sub, "env"c) == 1) {
        var name: pchar := argGet(argc, argv, 3);
        var esub: pchar := argGet(argc, argv, 4);
        if (streq(esub, "list"c) == 1) {
            var j: int64 := PagesEnvList(c, accountId, name);
            printJson(j); return;
        }
        if (streq(esub, "set"c) == 1) {
            var key: pchar := argGet(argc, argv, 5);
            var val: pchar := argGet(argc, argv, 6);
            var ok: int64 := PagesEnvSet(c, accountId, name, key, val, 0, "production"c);
            if (ok == 1) { PrintLn("Env set."c); } else { PrintLn("Failed."c); }
            return;
        }
        PrintLn("pages env <name>: list | set <key> <val>"c);
        return;
    }
    PrintLn("pages: projects | deployments | domains | env"c);
}

