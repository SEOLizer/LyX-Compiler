// ─────────────────────────────────────────────────────────────────────────────
// tunnel
// ─────────────────────────────────────────────────────────────────────────────

fn cmdTunnel(argc: int64, argv: int64, c: CFClient) {
    var sub: pchar := argGet(argc, argv, 2);
    var accountId: pchar := getAccountId(c);

    if (streq(sub, "list"c) == 1) {
        var j: int64 := TunnelList(c, accountId);
        printJson(j); return;
    }
    if (streq(sub, "create"c) == 1) {
        var name: pchar   := argGet(argc, argv, 3);
        var secret: pchar := argGet(argc, argv, 4);
        if (streq(secret, ""c) == 1) { secret = "changeme-please-use-32-chars-min"c; }
        var t: CFTunnel := TunnelCreate(c, accountId, name, secret);
        if (t.id != 0) { Print("Created: "c); PrintLn(t.id as pchar); }
        else { PrintLn("Failed."c); }
        CFTunnelFree(t); return;
    }
    if (streq(sub, "delete"c) == 1) {
        var id: pchar := argGet(argc, argv, 3);
        TunnelCleanup(c, accountId, id);
        var ok: int64 := TunnelDelete(c, accountId, id);
        if (ok == 1) { PrintLn("Deleted."c); } else { PrintLn("Failed."c); }
        return;
    }
    if (streq(sub, "token"c) == 1) {
        var id: pchar := argGet(argc, argv, 3);
        var tok: int64 := TunnelToken(c, accountId, id);
        if (tok != 0) { PrintLn(tok as pchar); free(tok, StrLen(tok as pchar)+1); }
        else { PrintLn("[failed]"c); }
        return;
    }
    if (streq(sub, "info"c) == 1) {
        var id: pchar := argGet(argc, argv, 3);
        var cfg: int64 := TunnelConfigGet(c, accountId, id);
        printJson(cfg);
        var conns: int64 := TunnelConnectionList(c, accountId, id);
        printJson(conns);
        return;
    }
    if (streq(sub, "route"c) == 1) {
        var rsub:    pchar := argGet(argc, argv, 3);
        var tunnId:  pchar := argGet(argc, argv, 4);
        var hostname: pchar := argGet(argc, argv, 5);
        var service:  pchar := argGet(argc, argv, 6);
        if (streq(rsub, "add"c) == 1) {
            var ok: int64 := TunnelIngressAdd(c, accountId, tunnId, hostname, service, 0 as pchar);
            if (ok == 1) { PrintLn("Route added."c); } else { PrintLn("Failed."c); }
        } else if (streq(rsub, "list"c) == 1) {
            var j: int64 := TunnelIngressList(c, accountId, tunnId);
            printJson(j);
        } else {
            PrintLn("tunnel route: add <id> <hostname> <service> | list <id>"c);
        }
        return;
    }
    if (streq(sub, "dns-route"c) == 1) {
        var tunnId:   pchar := argGet(argc, argv, 3);
        var hostname: pchar := argGet(argc, argv, 4);
        var zoneId:   pchar := getZoneId(c);
        var ok: int64 := TunnelDNSRoute(c, zoneId, tunnId, hostname, 1);
        if (ok == 1) { PrintLn("DNS route created."c); } else { PrintLn("Failed."c); }
        return;
    }
    PrintLn("tunnel: list | create <name> [secret] | delete <id>"c);
    PrintLn("        token <id> | info <id>"c);
    PrintLn("        route add|list <id> [hostname] [service]"c);
    PrintLn("        dns-route <id> <hostname>"c);
}

