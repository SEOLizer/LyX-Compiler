extern fn getenv(name: pchar): pchar;
extern fn exit(code: int64): int64;

fn streq(a: pchar, b: pchar): int64 {
    var i: int64 := 0;
    while ((peek8(a+i)&0xFF) != 0 && (peek8(b+i)&0xFF) != 0) {
        if ((peek8(a+i)&0xFF) != (peek8(b+i)&0xFF)) { return 0; }
        i := i + 1;
    }
    if ((peek8(a+i)&0xFF) != (peek8(b+i)&0xFF)) { return 0; }
    return 1;
}

fn argEq(argc: int64, argv: int64, idx: int64, s: pchar): int64 {
    if (idx >= argc) { return 0; }
    var p: pchar := peek64(argv + idx * 8) as pchar;
    return streq(p, s);
}

fn argGet(argc: int64, argv: int64, idx: int64): pchar {
    if (idx >= argc) { return ""c; }
    return peek64(argv + idx * 8) as pchar;
}

fn printUsage() {
    PrintLn("lyxcf — Cloudflare CLI"c);
    PrintLn(""c);
    PrintLn("Usage: lyxcf <command> [subcommand] [args...]"c);
    PrintLn(""c);
    PrintLn("Commands:"c);
    PrintLn("  auth     check | token"c);
    PrintLn("  zone     list | get | create | delete | pause | unpause | settings"c);
    PrintLn("  dns      list | get | create | update | delete | upsert | import | export"c);
    PrintLn("  cache    purge-all | purge | purge-tags | rules"c);
    PrintLn("  firewall rules | block-ip | block-country | allow-ip | rate-limits"c);
    PrintLn("  lb       pools | load-balancers | health"c);
    PrintLn("  workers  scripts | routes | kv | secrets | cron"c);
    PrintLn("  r2       buckets | objects"c);
    PrintLn("  d1       databases | execute | query | tables | schema"c);
    PrintLn("  pages    projects | deployments | domains | env"c);
    PrintLn("  tunnel   list | create | delete | token | info | route | dns-route"c);
    PrintLn("  analytics dashboard | top-ips | top-urls | firewall-events"c);
    PrintLn("  email    status | enable | rules | catch-all | destinations"c);
    PrintLn(""c);
    PrintLn("Auth via env: CF_AUTH_TOKEN=<token> or CF_AUTH_KEY=<key> CF_AUTH_EMAIL=<email>"c);
    PrintLn("              CF_ACCOUNT_ID=<id>  CF_ZONE_ID=<id>"c);
}

fn clientFromEnv(): CFClient {
    var creds: CFCredentials := CFCredentialsFromEnv();
    var c: CFClient;
    c.authType   := creds.authType;
    c.token      := creds.token;
    c.apiKey     := creds.apiKey;
    c.email      := creds.email;
    c.accountId  := creds.accountId;
    c.zoneId     := creds.zoneId;
    c.timeout    := 30000;
    c.maxRetries := 3;
    return c;
}

fn getAccountId(c: CFClient): pchar {
    var env: pchar := getenv("CF_ACCOUNT_ID"c);
    if (env != 0 as pchar) { return env; }
    return c.accountId as pchar;
}

fn getZoneId(c: CFClient): pchar {
    var env: pchar := getenv("CF_ZONE_ID"c);
    if (env != 0 as pchar) { return env; }
    return c.zoneId as pchar;
}

fn printJson(json: int64) {
    if (json == 0) { PrintLn("[no result]"c); return; }
    PrintLn(json as pchar);
    free(json, StrLen(json as pchar)+1);
}

// ─────────────────────────────────────────────────────────────────────────────
// auth
// ─────────────────────────────────────────────────────────────────────────────

fn cmdAuth(argc: int64, argv: int64, c: CFClient) {
    var sub: pchar := argGet(argc, argv, 2);
    if (streq(sub, "check"c) == 1 || streq(sub, ""c) == 1) {
        var ok: int64 := CFValidateToken(c);
        if (ok == 1) { PrintLn("Token valid."c); }
        else         { PrintLn("Token INVALID or network error."c); }
        return;
    }
    if (streq(sub, "token"c) == 1) {
        var tok: pchar := c.token as pchar;
        if (tok != 0 as pchar) { PrintLn(tok); }
        else { PrintLn("[no token set]"c); }
        return;
    }
    PrintLn("auth: unknown subcommand"c); PrintLn("  check | token"c);
}

// ─────────────────────────────────────────────────────────────────────────────
// zone
// ─────────────────────────────────────────────────────────────────────────────

fn cmdZone(argc: int64, argv: int64, c: CFClient) {
    var sub: pchar := argGet(argc, argv, 2);
    var accountId: pchar := getAccountId(c);

    if (streq(sub, "list"c) == 1) {
        var j: int64 := ZoneList(c);
        printJson(j); return;
    }
    if (streq(sub, "get"c) == 1) {
        var domain: pchar := argGet(argc, argv, 3);
        if (streq(domain, ""c) == 1) { PrintLn("usage: zone get <domain|id>"c); return; }
        var z: CFZone := ZoneGetByDomain(c, domain);
        if (z.id != 0) { PrintLn(z.id as pchar); }
        else { PrintLn("[not found]"c); }
        CFZoneFree(z); return;
    }
    if (streq(sub, "create"c) == 1) {
        var domain: pchar := argGet(argc, argv, 3);
        var z: CFZone := ZoneCreate(c, accountId, domain, 0 as pchar);
        if (z.id != 0) { Print("Created zone: "c); PrintLn(z.id as pchar); }
        else { PrintLn("Failed to create zone"c); }
        CFZoneFree(z); return;
    }
    if (streq(sub, "delete"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        var ok: int64 := ZoneDelete(c, zoneId);
        if (ok == 1) { PrintLn("Deleted."c); } else { PrintLn("Failed."c); }
        return;
    }
    if (streq(sub, "pause"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        var ok: int64 := ZonePause(c, zoneId);
        if (ok == 1) { PrintLn("Paused."c); } else { PrintLn("Failed."c); }
        return;
    }
    if (streq(sub, "unpause"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        var ok: int64 := ZoneUnpause(c, zoneId);
        if (ok == 1) { PrintLn("Unpaused."c); } else { PrintLn("Failed."c); }
        return;
    }
    if (streq(sub, "settings"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        var j: int64 := ZoneSettingsGetAll(c, zoneId);
        printJson(j); return;
    }
    if (streq(sub, "purge"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        var ok: int64 := CachePurgeAll(c, zoneId);
        if (ok == 1) { PrintLn("Cache purged."c); } else { PrintLn("Failed."c); }
        return;
    }
    PrintLn("zone: unknown subcommand"c);
    PrintLn("  list | get <domain> | create <domain> | delete <id>"c);
    PrintLn("  pause <id> | unpause <id> | settings <id> | purge <id>"c);
}

// ─────────────────────────────────────────────────────────────────────────────
// dns
// ─────────────────────────────────────────────────────────────────────────────

fn cmdDNS(argc: int64, argv: int64, c: CFClient) {
    var sub: pchar := argGet(argc, argv, 2);

    if (streq(sub, "list"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        if (streq(zoneId, ""c) == 1) { zoneId = getZoneId(c); }
        var j: int64 := DNSRecordList(c, zoneId);
        printJson(j); return;
    }
    if (streq(sub, "get"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        var recId: pchar  := argGet(argc, argv, 4);
        var rec: CFDNSRecord := DNSRecordGet(c, zoneId, recId);
        if (rec.id != 0) { Print(rec.name as pchar); Print(" "c); PrintLn(rec.content as pchar); }
        else { PrintLn("[not found]"c); }
        CFDNSRecordFree(rec); return;
    }
    if (streq(sub, "create"c) == 1) {
        var zoneId:  pchar := argGet(argc, argv, 3);
        var recType: pchar := argGet(argc, argv, 4);
        var name:    pchar := argGet(argc, argv, 5);
        var content: pchar := argGet(argc, argv, 6);
        var rec: CFDNSRecord := DNSRecordCreate(c, zoneId, recType, name, content, 1, 1);
        if (rec.id != 0) { Print("Created: "c); PrintLn(rec.id as pchar); }
        else { PrintLn("Failed."c); }
        CFDNSRecordFree(rec); return;
    }
    if (streq(sub, "delete"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        var recId:  pchar := argGet(argc, argv, 4);
        var ok: int64 := DNSRecordDelete(c, zoneId, recId);
        if (ok == 1) { PrintLn("Deleted."c); } else { PrintLn("Failed."c); }
        return;
    }
    if (streq(sub, "upsert"c) == 1) {
        var zoneId:  pchar := argGet(argc, argv, 3);
        var recType: pchar := argGet(argc, argv, 4);
        var name:    pchar := argGet(argc, argv, 5);
        var content: pchar := argGet(argc, argv, 6);
        var rec: CFDNSRecord := DNSRecordUpsert(c, zoneId, recType, name, content, 1, 1);
        if (rec.id != 0) { Print("Upserted: "c); PrintLn(rec.id as pchar); }
        else { PrintLn("Failed."c); }
        CFDNSRecordFree(rec); return;
    }
    if (streq(sub, "export"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        var j: int64 := DNSZoneExport(c, zoneId);
        printJson(j); return;
    }
    PrintLn("dns: unknown subcommand"c);
    PrintLn("  list <zoneId> | get <zoneId> <recId>"c);
    PrintLn("  create <zoneId> <TYPE> <name> <content>"c);
    PrintLn("  delete <zoneId> <recId> | upsert <zoneId> <TYPE> <name> <content>"c);
    PrintLn("  export <zoneId>"c);
}

// ─────────────────────────────────────────────────────────────────────────────
// cache
// ─────────────────────────────────────────────────────────────────────────────

fn cmdCache(argc: int64, argv: int64, c: CFClient) {
    var sub: pchar := argGet(argc, argv, 2);

    if (streq(sub, "purge-all"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        if (streq(zoneId, ""c) == 1) { zoneId = getZoneId(c); }
        var ok: int64 := CachePurgeAll(c, zoneId);
        if (ok == 1) { PrintLn("Cache purged."c); } else { PrintLn("Failed."c); }
        return;
    }
    if (streq(sub, "purge"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        var url:    pchar := argGet(argc, argv, 4);
        var urls: int64 := alloc(8); poke64(urls, url as int64);
        var ok: int64 := CachePurgeFiles(c, zoneId, urls, 1);
        free(urls, 8);
        if (ok == 1) { PrintLn("Purged."c); } else { PrintLn("Failed."c); }
        return;
    }
    if (streq(sub, "purge-tags"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        var tag:    pchar := argGet(argc, argv, 4);
        var tags: int64 := alloc(8); poke64(tags, tag as int64);
        var ok: int64 := CachePurgeTags(c, zoneId, tags, 1);
        free(tags, 8);
        if (ok == 1) { PrintLn("Tags purged."c); } else { PrintLn("Failed."c); }
        return;
    }
    if (streq(sub, "rules"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        if (streq(zoneId, ""c) == 1) { zoneId = getZoneId(c); }
        var j: int64 := CacheRuleList(c, zoneId);
        printJson(j); return;
    }
    PrintLn("cache: purge-all <zoneId> | purge <zoneId> <url> | purge-tags <zoneId> <tag> | rules <zoneId>"c);
}

