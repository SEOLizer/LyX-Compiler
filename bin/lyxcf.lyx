fn cmdFirewall(argc: int64, argv: int64, c: CFClient) {
    var sub: pchar := argGet(argc, argv, 2);

    if (streq(sub, "rules"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        if (streq(zoneId, ""c) == 1) { zoneId = getZoneId(c); }
        var j: int64 := FirewallRuleList(c, zoneId);
        printJson(j); return;
    }
    if (streq(sub, "block-ip"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        var ip:     pchar := argGet(argc, argv, 4);
        var ok: int64 := FirewallBlockIP(c, zoneId, ip, "Blocked by lyxcf"c);
        if (ok == 1) { PrintLn("IP blocked."c); } else { PrintLn("Failed."c); }
        return;
    }
    if (streq(sub, "allow-ip"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        var ip:     pchar := argGet(argc, argv, 4);
        var ok: int64 := FirewallAllowIP(c, zoneId, ip, "Allowed by lyxcf"c);
        if (ok == 1) { PrintLn("IP allowed."c); } else { PrintLn("Failed."c); }
        return;
    }
    if (streq(sub, "block-country"c) == 1) {
        var zoneId:   pchar := argGet(argc, argv, 3);
        var countryCode: pchar := argGet(argc, argv, 4);
        var countries: int64 := alloc(8); poke64(countries, countryCode as int64);
        var ok: int64 := FirewallBlockCountry(c, zoneId, countries, 1, "Country block"c);
        free(countries, 8);
        if (ok == 1) { PrintLn("Country blocked."c); } else { PrintLn("Failed."c); }
        return;
    }
    if (streq(sub, "rate-limits"c) == 1) {
        var zoneId: pchar := argGet(argc, argv, 3);
        if (streq(zoneId, ""c) == 1) { zoneId = getZoneId(c); }
        var j: int64 := RateLimitList(c, zoneId);
        printJson(j); return;
    }
    PrintLn("firewall: rules | block-ip | allow-ip | block-country | rate-limits"c);
}

// ─────────────────────────────────────────────────────────────────────────────
// workers
