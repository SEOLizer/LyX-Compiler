// ── Argument helpers ──────────────────────────────────────────────────────────

fn argEq(a: pchar, b: pchar): int64 {
    return StrEquals(a, b);
}

fn argStart(a: pchar, prefix: pchar): int64 {
    return StrStartsWith(a, prefix);
}

fn argAfter(a: pchar, prefix: pchar): pchar {
    var pl: int64 := StrLen(prefix);
    return (a as int64 + pl) as pchar;
}

fn flagVal(argc: int64, argv: pchar, flag: pchar): pchar {
    var fl: int64 := StrLen(flag);
    var i: int64 := 1;
    while (i < argc) {
        var arg: pchar := ArgvGet(argv, i);
        if (StrStartsWith(arg, flag) == 1) {
            if (StrLen(arg) > fl && (StrCharAt(arg, fl) & 0xFF) == 61) {
                return (arg as int64 + fl + 1) as pchar;
            }
            if (StrEquals(arg, flag) == 1 && i+1 < argc) {
                return ArgvGet(argv, i+1);
            }
        }
        i:=i+1;
    }
    return 0 as pchar;
}

fn flagBool(argc: int64, argv: pchar, flag: pchar): int64 {
    var i: int64 := 1;
    while (i < argc) {
        var arg: pchar := ArgvGet(argv, i);
        if (StrEquals(arg, flag) == 1) { return 1; }
        i:=i+1;
    }
    return 0;
}

fn loadCreds(argc: int64, argv: pchar): AWSCreds {
    var profile: pchar := flagVal(argc, argv, "--profile"c);
    var keyId:   pchar := flagVal(argc, argv, "--access-key"c);
    var secret:  pchar := flagVal(argc, argv, "--secret-key"c);
    var region:  pchar := flagVal(argc, argv, "--region"c);
    if (keyId != 0 as pchar && secret != 0 as pchar) {
        var c: AWSCreds := AWSCredentialsStatic(keyId, secret);
        if (region != 0 as pchar) {
            c.region := region as int64;
        }
        return c;
    }
    if (profile != 0 as pchar) {
        var c2: AWSCreds := AWSCredentialsProfile(profile);
        if (region != 0 as pchar) { c2.region := region as int64; }
        return c2;
    }
    return AWSCredentialsDefault();
}

fn getRegion(argc: int64, argv: pchar, creds: AWSCreds): pchar {
    var r: pchar := flagVal(argc, argv, "--region"c);
    if (r != 0 as pchar) { return r; }
    if (creds.region != 0) { return creds.region as pchar; }
    return "us-east-1"c;
}

fn printLine(s: pchar) {
    PrintLn(s);
}

fn printKV(key: pchar, val: pchar) {
    Print(key); Print(": "c); PrintLn(val);
}

fn printKI(key: pchar, val: int64) {
    var tmp: int64 := alloc(24); Int64ToStr(val, tmp as pchar);
    Print(key); Print(": "c); PrintLn(tmp as pchar);
    free(tmp, 24);
}

fn printNull(label: pchar, val: int64) {
    Print(label); Print(": "c);
    if (val != 0) { PrintLn(val as pchar); } else { PrintLn("(none)"c); }
}

// ── usage ─────────────────────────────────────────────────────────────────────

