// tests/prob_test.lyx
// Selbstpruefende Testbatterie fuer std.prob.
//
// Sollwerte aus Python (math.erf/lgamma/comb, statistics) bzw. aus
// unabhaengiger numerischer Integration der jeweiligen Dichte — nicht aus
// derselben Formel, die hier geprueft wird.

unit main;

import std.prob;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

// Relativer Vergleich. tol wird als Argument uebergeben (nicht als con
// gelesen), weil eine con f64 im Ausdruck falsch typisiert wird (#1499).
fn CheckRel(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  var diff: f64 := AbsF64(got - want);
  var scale: f64 := AbsF64(want);
  if (scale < 1.0) { scale := 1.0; }
  if (diff / scale > tol) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

// Genauigkeit des Unterbaus: alles, was durch ExpF64/LogF64 laeuft, traegt
// deren Fehler von rund 1e-7 relativ.
fn TOL(): f64 { return 0.0000001; }        // 1e-7  — exp/log-behaftet
fn TIGHT(): f64 { return 0.000000001; }    // 1e-9  — rein algebraisch

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" (bool)\n"c);
  }
}

fn Fill8(p: int64): void {
  pokef64(p,      2.5);  pokef64(p +  8, 3.1);  pokef64(p + 16, 1.8);
  pokef64(p + 24, 4.2);  pokef64(p + 32, 3.9);  pokef64(p + 40, 2.2);
  pokef64(p + 48, 3.3);  pokef64(p + 56, 2.8);
}

fn main(): int64 {
  var d: int64 := alloc(8 * 8);
  Fill8(d);

  // ── Deskriptive Statistik (Sollwerte aus Python statistics) ───────────────
  CheckRel("sum"c,     ProbSum(d, 8),       23.8,  TIGHT());
  CheckRel("mean"c,    ProbMean(d, 8),      2.975, TIGHT());
  CheckRel("varP"c,    ProbVarianceP(d, 8), 0.589375, TIGHT());
  CheckRel("varS"c,    ProbVarianceS(d, 8), 0.6735714285714286, TIGHT());
  CheckRel("sdP"c,     ProbStdDevP(d, 8),   0.7677076266392043, TIGHT());
  CheckRel("sdS"c,     ProbStdDevS(d, 8),   0.8207139748849342, TIGHT());
  CheckRel("min"c,     ProbMin(d, 8),       1.8,   TIGHT());
  CheckRel("max"c,     ProbMax(d, 8),       4.2,   TIGHT());
  CheckRel("range"c,   ProbRange(d, 8),     2.4,   TIGHT());
  CheckRel("median"c,  ProbMedian(d, 8),    2.95,  TIGHT());
  CheckRel("q25"c,     ProbQuantile(d, 8, 0.25), 2.425, TIGHT());
  CheckRel("q75"c,     ProbQuantile(d, 8, 0.75), 3.45,  TIGHT());
  CheckRel("iqr"c,     ProbIQR(d, 8),       1.025, TIGHT());
  CheckRel("q0"c,      ProbQuantile(d, 8, 0.0), 1.8, TIGHT());
  CheckRel("q1"c,      ProbQuantile(d, 8, 1.0), 4.2, TIGHT());
  CheckRel("skew"c,    ProbSkewness(d, 8),  0.12866941056364062, TIGHT());
  CheckRel("kurt"c,    ProbKurtosisExcess(d, 8), -1.0877020946888891, TIGHT());
  CheckRel("se"c,      ProbStandardError(d, 8), 0.2901662085278514, TIGHT());

  // Quelle bleibt unsortiert — ProbQuantile arbeitet auf einer Kopie
  CheckRel("srcUntouched"c, peekf64(d), 2.5, TIGHT());

  // Kahan-Summation: 1e16 + 1 + 1 ... muss die Einsen behalten
  var big: int64 := alloc(4 * 8);
  pokef64(big,      10000000000000000.0);
  pokef64(big +  8, 1.0);
  pokef64(big + 16, 1.0);
  pokef64(big + 24, -10000000000000000.0);
  CheckRel("kahan"c, ProbSum(big, 4), 2.0, TIGHT());
  free(big, 4 * 8);

  // Welford: grosses Mittel, kleine Streuung — die Lehrbuchformel liefert hier
  // negative Varianzen
  var w: int64 := alloc(4 * 8);
  pokef64(w,      1000000.01);  pokef64(w +  8, 1000000.02);
  pokef64(w + 16, 1000000.03);  pokef64(w + 24, 1000000.04);
  CheckRel("welford"c, ProbVarianceS(w, 4), 0.00016666666, 0.0001);
  free(w, 4 * 8);

  // Sortieren an Ort und Stelle
  var s: int64 := alloc(8 * 8);
  Fill8(s);
  ProbSortF64(s, 8);
  CheckRel("sort0"c, peekf64(s),      1.8, TIGHT());
  CheckRel("sort3"c, peekf64(s + 24), 2.8, TIGHT());
  CheckRel("sort7"c, peekf64(s + 56), 4.2, TIGHT());
  free(s, 8 * 8);

  // ── Kovarianz, Korrelation, Regression ────────────────────────────────────
  var xs: int64 := alloc(5 * 8);
  var ys: int64 := alloc(5 * 8);
  pokef64(xs,      1.0);  pokef64(xs +  8, 2.0);  pokef64(xs + 16, 3.0);
  pokef64(xs + 24, 4.0);  pokef64(xs + 32, 5.0);
  pokef64(ys,      2.1);  pokef64(ys +  8, 3.9);  pokef64(ys + 16, 6.2);
  pokef64(ys + 24, 7.8);  pokef64(ys + 32, 10.1);

  CheckRel("cov"c,  ProbCovariance(xs, ys, 5),  4.975, TIGHT());
  CheckRel("corr"c, ProbCorrelation(xs, ys, 5), 0.9986517555689657, TIGHT());
  CheckRel("corrSelf"c, ProbCorrelation(xs, xs, 5), 1.0, TIGHT());

  var sl: int64 := alloc(8);
  var ic: int64 := alloc(8);
  var r2: int64 := alloc(8);
  CheckB("regress"c, ProbLinRegress(xs, ys, 5, sl, ic, r2), true);
  CheckRel("slope"c,     peekf64(sl), 1.99, TIGHT());
  CheckRel("intercept"c, peekf64(ic), 0.05, TIGHT());
  CheckRel("r2"c,        peekf64(r2), 0.997305328900977, TIGHT());
  // konstante x-Reihe hat keine Gerade
  var cx: int64 := alloc(3 * 8);
  pokef64(cx, 2.0); pokef64(cx + 8, 2.0); pokef64(cx + 16, 2.0);
  CheckB("regressConst"c, ProbLinRegress(cx, ys, 3, sl, ic, r2), false);
  CheckRel("corrConst"c, ProbCorrelation(cx, ys, 3), 0.0, TIGHT());
  free(cx, 3 * 8);

  // z-Standardisierung
  var z: int64 := alloc(8 * 8);
  CheckB("zscores"c, ProbZScores(d, 8, z), true);
  CheckRel("zMean"c,  ProbMean(z, 8), 0.0, 0.000000001);
  CheckRel("zSd"c,    ProbStdDevP(z, 8), 1.0, TIGHT());
  free(z, 8 * 8);

  // ── Spezialfunktionen ─────────────────────────────────────────────────────
  CheckRel("lgamma0.5"c, ProbLogGamma(0.5),  0.5723649429247004, TOL());
  CheckRel("lgamma1"c,   ProbLogGamma(1.0),  0.0, TOL());
  CheckRel("lgamma5"c,   ProbLogGamma(5.0),  3.1780538303479458, TOL());
  CheckRel("lgamma10"c,  ProbLogGamma(10.0), 12.801827480081469, TOL());
  CheckRel("lgamma0.1"c, ProbLogGamma(0.1),  2.2527126517342055, TOL());
    // Gamma laeuft ueber exp(lgamma) und erbt dessen Fehler doppelt
  CheckRel("gamma5"c,    ProbGamma(5.0),     24.0, 0.000001);
  CheckRel("gamma0.5"c,  ProbGamma(0.5),     1.7724538509055159, TOL());
  CheckRel("gammaBig"c,  ProbGamma(200.0),   0.0, TIGHT());     // ueber der Grenze
  CheckRel("beta23"c,    ProbBeta(2.0, 3.0), 0.08333333333333333, TOL());

  CheckRel("erf1"c,    ProbErf(1.0),    0.8427007929497149, TOL());
  CheckRel("erfNeg"c,  ProbErf(-0.5),   -0.5204998778130465, TOL());
  CheckRel("erf0"c,    ProbErf(0.0),    0.0, TIGHT());
  CheckRel("erf3"c,    ProbErf(3.0),    0.9999779095030014, TOL());
  CheckRel("erfc2"c,   ProbErfc(2.0),   0.004677734981047265, 0.00001);

  CheckRel("gammaP_series"c, ProbGammaP(2.0, 1.0), 0.26424111765711533, TOL());
  CheckRel("gammaP_cf"c,     ProbGammaP(2.0, 3.0), 0.8008517265285442,  TOL());
  CheckRel("gammaP_0"c,      ProbGammaP(2.0, 0.0), 0.0, TIGHT());
  CheckRel("gammaQ"c,        ProbGammaQ(2.0, 3.0), 0.1991482734714558, TOL());
  // Naht zwischen Reihe und Kettenbruch: beide Seiten muessen zusammenpassen
  CheckRel("gammaP_seam"c, ProbGammaP(3.0, 3.999), ProbGammaP(3.0, 4.001), 0.001);

  CheckRel("betaI"c,     ProbBetaI(2.0, 3.0, 0.5), 0.6875, TOL());
  CheckRel("betaI_hi"c,  ProbBetaI(2.0, 3.0, 0.9), 0.9963, 0.001);
  CheckRel("betaI_0"c,   ProbBetaI(2.0, 3.0, 0.0), 0.0, TIGHT());
  CheckRel("betaI_1"c,   ProbBetaI(2.0, 3.0, 1.0), 1.0, TIGHT());
  // Symmetrie I_x(a,b) = 1 - I_(1-x)(b,a)
  CheckRel("betaI_sym"c, ProbBetaI(2.5, 4.5, 0.3),
                         1.0 - ProbBetaI(4.5, 2.5, 0.7), TOL());

  // ── Normalverteilung ──────────────────────────────────────────────────────
  CheckRel("npdf"c,  ProbNormalPdf(1.0, 0.0, 1.0), 0.24197072451914337, TOL());
  CheckRel("npdf2"c, ProbNormalPdf(2.0, 2.0, 3.0), 0.1329807601338109, TOL());
  CheckRel("ncdf0"c, ProbNormalCdf(0.0, 0.0, 1.0), 0.5, TIGHT());
  CheckRel("ncdf"c,  ProbNormalCdf(1.96, 0.0, 1.0), 0.9750021048517796, TOL());
  CheckRel("ncdfNeg"c, ProbNormalCdf(-1.0, 2.0, 3.0), 0.15865525393145707, TOL());
  CheckRel("nq"c,    ProbNormalQuantile(0.975, 0.0, 1.0), 1.959963984540054, TOL());
  CheckRel("nq50"c,  ProbNormalQuantile(0.5, 5.0, 2.0), 5.0, TOL());
  CheckRel("nq01"c,  ProbNormalQuantile(0.01, 0.0, 1.0), -2.3263478740408408, TOL());
  // Umkehrung: cdf(quantile(p)) = p, auch weit in den Flanken
  CheckRel("nRound1"c, ProbNormalCdf(ProbNormalQuantile(0.001, 0.0, 1.0), 0.0, 1.0), 0.001, 0.00001);
  CheckRel("nRound2"c, ProbNormalCdf(ProbNormalQuantile(0.9999, 0.0, 1.0), 0.0, 1.0), 0.9999, 0.00001);
  CheckRel("nSigma0"c, ProbNormalPdf(1.0, 0.0, 0.0), 0.0, TIGHT());

  // ── Log-Normal, Gleich-, Exponentialverteilung ────────────────────────────
  CheckRel("lncdf"c, ProbLogNormalCdf(1.0, 0.0, 1.0), 0.5, TOL());
  CheckRel("lnq"c,   ProbLogNormalQuantile(0.5, 0.0, 1.0), 1.0, TOL());
  CheckRel("lnpdfNeg"c, ProbLogNormalPdf(-1.0, 0.0, 1.0), 0.0, TIGHT());

  CheckRel("upfd"c,  ProbUniformPdf(0.5, 0.0, 2.0), 0.5, TIGHT());
  CheckRel("ucdf"c,  ProbUniformCdf(0.5, 0.0, 2.0), 0.25, TIGHT());
  CheckRel("uq"c,    ProbUniformQuantile(0.25, 0.0, 2.0), 0.5, TIGHT());
  CheckRel("ucdfOut"c, ProbUniformCdf(3.0, 0.0, 2.0), 1.0, TIGHT());

  CheckRel("epdf"c, ProbExponentialPdf(0.0, 2.0), 2.0, TIGHT());
  CheckRel("ecdf"c, ProbExponentialCdf(2.0, 0.5), 0.6321205588285577, TOL());
  CheckRel("eq"c,   ProbExponentialQuantile(0.6321205588285577, 0.5), 2.0, 0.00001);
  CheckRel("eMedian"c, ProbExponentialQuantile(0.5, 1.0), 0.6931471805599453, TOL());

  // ── Binomial- und Poissonverteilung ───────────────────────────────────────
  CheckRel("bpmf"c,  ProbBinomialPmf(3, 10, 0.3), 0.2668279319999998, TOL());
  CheckRel("bpmf0"c, ProbBinomialPmf(0, 10, 0.3), 0.02824752489999998, TOL());
  CheckRel("bpmfN"c, ProbBinomialPmf(10, 10, 0.3), 0.0000059048999999, 0.0001);
  CheckRel("bpmfOut"c, ProbBinomialPmf(11, 10, 0.3), 0.0, TIGHT());
  CheckRel("bcdf"c,  ProbBinomialCdf(3, 10, 0.3), 0.6496107183999996, TOL());
  CheckRel("bcdfAll"c, ProbBinomialCdf(10, 10, 0.3), 1.0, TIGHT());
  CheckI("bq"c, ProbBinomialQuantile(0.5, 10, 0.3), 3);
  CheckI("bq9"c, ProbBinomialQuantile(0.9, 10, 0.3), 5);
  CheckI("bq0"c, ProbBinomialQuantile(0.0, 10, 0.3), 0);
  // pmf summiert sich zu 1
  var bsum: f64 := 0.0;
  var bi: int64 := 0;
  while (bi <= 10) {
    bsum := bsum + ProbBinomialPmf(bi, 10, 0.3);
    bi := bi + 1;
  }
  CheckRel("bpmfSum"c, bsum, 1.0, 0.000001);   // 11 Summanden, jeder mit exp-Fehler

  CheckRel("ppmf"c, ProbPoissonPmf(2, 3.0), 0.22404180765538775, TOL());
  CheckRel("ppmf0"c, ProbPoissonPmf(0, 3.0), 0.049787068367863944, TOL());
  CheckRel("pcdf"c, ProbPoissonCdf(2, 3.0), 0.42319008112684353, TOL());
  CheckI("pq"c, ProbPoissonQuantile(0.42319008, 3.0), 2);
  var psum: f64 := 0.0;
  var pi2: int64 := 0;
  while (pi2 <= 60) {
    psum := psum + ProbPoissonPmf(pi2, 3.0);
    pi2 := pi2 + 1;
  }
  CheckRel("ppmfSum"c, psum, 1.0, TOL());

  // ── t-, Chi-Quadrat- und F-Verteilung ─────────────────────────────────────
  CheckRel("tpdf"c,  ProbStudentTPdf(1.0, 5.0), 0.2196797973509804, TOL());
  CheckRel("tcdf0"c, ProbStudentTCdf(0.0, 5.0), 0.5, TIGHT());
  CheckRel("tcdf"c,  ProbStudentTCdf(2.0, 5.0), 0.9490302605850709, 0.00001);
  CheckRel("tcdfSym"c, ProbStudentTCdf(-2.0, 5.0), 1.0 - ProbStudentTCdf(2.0, 5.0), TOL());
  // Tabellenwerte
  CheckRel("tq10"c,  ProbStudentTQuantile(0.975, 10.0), 2.2281388519649385, 0.00001);
  CheckRel("tq1"c,   ProbStudentTQuantile(0.975, 1.0),  12.706204736432095, 0.0001);
  CheckRel("tq30"c,  ProbStudentTQuantile(0.95, 30.0),  1.6972608865939923, 0.00001);
  // grosse df naehern sich der Normalverteilung
  // ab df = 10000 rechnet die Einheit ueber die Normalverteilung (s. Quelltext)
  CheckRel("tqLarge"c, ProbStudentTQuantile(0.975, 100000.0), 1.959963984540054, 0.00001);
  CheckRel("tcdf1000"c, ProbStudentTCdf(2.0, 1000.0), 0.9771148267534472, 0.00001);
  CheckRel("tcdf100"c,  ProbStudentTCdf(2.0, 100.0),  0.9758939106344121, 0.00001);
  CheckRel("tp2"c,  ProbStudentTPTwoSided(2.0, 5.0), 0.10193950316623468, 0.0001);

  CheckRel("chi2pdf"c, ProbChiSqPdf(2.0, 3.0), 0.20755374871029741, TOL());
  CheckRel("chi2cdf"c, ProbChiSqCdf(3.841458820694124, 1.0), 0.95, 0.00001);
  CheckRel("chi2q1"c,  ProbChiSqQuantile(0.95, 1.0), 3.841458820694124, 0.00001);
  CheckRel("chi2q3"c,  ProbChiSqQuantile(0.95, 3.0), 7.814727903251179, 0.00001);
  CheckRel("chi2q10"c, ProbChiSqQuantile(0.99, 10.0), 23.209251158954356, 0.0001);
  CheckRel("chi2up"c,  ProbChiSqPUpper(7.814727903251179, 3.0), 0.05, 0.00001);

  CheckRel("fcdf"c, ProbFCdf(3.708264871561176, 3.0, 10.0), 0.95, 0.00001);
  CheckRel("fq"c,   ProbFQuantile(0.95, 3.0, 10.0), 3.708264871561176, 0.00001);
  CheckRel("fq2"c,  ProbFQuantile(0.99, 5.0, 20.0), 4.103069805809465, 0.0001);
  // F(1,n) ist das Quadrat von t(n)
  var tv: f64 := ProbStudentTQuantile(0.975, 10.0);
  CheckRel("fIsTSq"c, ProbFQuantile(0.95, 1.0, 10.0), tv * tv, 0.0001);

  // ── Tests ─────────────────────────────────────────────────────────────────
  var tstat: int64 := alloc(8);
  var tdf: int64 := alloc(8);

  // Einstichprobentest gegen mu0 = 2.5
  var p1: f64 := ProbTTestOneSample(d, 8, 2.5, tstat, tdf);
  CheckRel("t1t"c,  peekf64(tstat), 1.6369928201147086, 0.00001);
  CheckRel("t1df"c, peekf64(tdf),   7.0, TIGHT());
  CheckRel("t1p"c,  p1, 0.1455, 0.01);
  // gegen den eigenen Mittelwert: t = 0, p = 1
  CheckRel("t1null"c, ProbTTestOneSample(d, 8, 2.975, tstat, tdf), 1.0, 0.00001);
  CheckRel("t1tooShort"c, ProbTTestOneSample(d, 1, 2.5, tstat, tdf), -1.0, TIGHT());

  // Welch-Test: zwei klar verschiedene Gruppen
  var g1: int64 := alloc(5 * 8);
  var g2: int64 := alloc(5 * 8);
  pokef64(g1,      5.1);  pokef64(g1 +  8, 4.9);  pokef64(g1 + 16, 5.3);
  pokef64(g1 + 24, 5.0);  pokef64(g1 + 32, 5.2);
  pokef64(g2,      6.1);  pokef64(g2 +  8, 6.3);  pokef64(g2 + 16, 5.9);
  pokef64(g2 + 24, 6.2);  pokef64(g2 + 32, 6.0);
  var p2: f64 := ProbTTestTwoSample(g1, 5, g2, 5, tstat, tdf);
  CheckRel("t2t"c,  peekf64(tstat), -10.0, 0.0001);
  CheckRel("t2df"c, peekf64(tdf),   8.0, 0.0001);
  CheckB("t2sig"c, p2 < 0.001, true);
  // dieselbe Gruppe gegen sich selbst: t = 0
  CheckRel("t2same"c, ProbTTestTwoSample(g1, 5, g1, 5, tstat, tdf), 1.0, 0.00001);

  // Chi-Quadrat-Anpassungstest: Wuerfel, 60 Wuerfe
  var obs: int64 := alloc(6 * 8);
  var exp: int64 := alloc(6 * 8);
  pokef64(obs,      12.0); pokef64(obs +  8,  8.0); pokef64(obs + 16, 10.0);
  pokef64(obs + 24, 11.0); pokef64(obs + 32,  9.0); pokef64(obs + 40, 10.0);
  var ei: int64 := 0;
  while (ei < 6) {
    pokef64(exp + ei * 8, 10.0);
    ei := ei + 1;
  }
  var chi2v: int64 := alloc(8);
  var chidf: int64 := alloc(8);
  var p3: f64 := ProbChiSqGof(obs, exp, 6, 0, chi2v, chidf);
  CheckRel("gofChi2"c, peekf64(chi2v), 1.0, TIGHT());
  CheckRel("gofDf"c,   peekf64(chidf), 5.0, TIGHT());
  CheckRel("gofP"c,    p3, 0.9625657732472964, 0.0001);
  CheckB("gofNotSig"c, p3 > 0.05, true);
  CheckRel("gofMinExp"c, ProbChiSqMinExpected(exp, 6), 10.0, TIGHT());
  // Erwartungswert 0 ist unzulaessig
  pokef64(exp, 0.0);
  CheckRel("gofBadExp"c, ProbChiSqGof(obs, exp, 6, 0, chi2v, chidf), -1.0, TIGHT());

  // Konfidenzintervall
  var lo: int64 := alloc(8);
  var hi: int64 := alloc(8);
  CheckB("ci"c, ProbConfIntervalMean(d, 8, 0.95, lo, hi), true);
  CheckRel("ciLo"c, peekf64(lo), 2.288865946491331, 0.0001);
  CheckRel("ciHi"c, peekf64(hi), 3.661134053508669, 0.0001);
  CheckB("ciBad"c, ProbConfIntervalMean(d, 8, 1.5, lo, hi), false);
  // engeres Niveau gibt ein engeres Intervall
  var lo2: int64 := alloc(8);
  var hi2: int64 := alloc(8);
  ProbConfIntervalMean(d, 8, 0.80, lo2, hi2);
  CheckB("ciNarrower"c, peekf64(hi2) - peekf64(lo2) < peekf64(hi) - peekf64(lo), true);

  // ── Zufallszahlen ─────────────────────────────────────────────────────────
  // Reproduzierbarkeit: gleicher Seed, gleiche Folge
  ProbSeed(12345);
  var r1: f64 := ProbRandUniform();
  var r2v: f64 := ProbRandUniform();
  ProbSeed(12345);
  CheckRel("rngRepro1"c, ProbRandUniform(), r1,  TIGHT());
  CheckRel("rngRepro2"c, ProbRandUniform(), r2v, TIGHT());
  // anderer Seed, andere Folge
  ProbSeed(999);
  CheckB("rngDiffers"c, AbsF64(ProbRandUniform() - r1) > 0.000001, true);

  // Wertebereich
  ProbSeed(7);
  var okRange: bool := true;
  var ri: int64 := 0;
  while (ri < 2000) {
    var u: f64 := ProbRandUniform();
    if (u < 0.0) { okRange := false; }
    if (u >= 1.0) { okRange := false; }
    ri := ri + 1;
  }
  CheckB("rngRange"c, okRange, true);

  // Verteilungstreue: 20000 Ziehungen, Mittel und Streuung muessen passen
  var big2: int64 := alloc(20000 * 8);
  ProbSeed(42);
  ProbFillUniform(big2, 20000, 0.0, 1.0);
  CheckRel("uMean"c, ProbMean(big2, 20000), 0.5, 0.02);
  CheckRel("uVar"c,  ProbVarianceP(big2, 20000), 0.0833333, 0.02);

  ProbSeed(42);
  ProbFillNormal(big2, 20000, 10.0, 2.0);
  CheckRel("nMean"c, ProbMean(big2, 20000), 10.0, 0.05);
  CheckRel("nSd"c,   ProbStdDevP(big2, 20000), 2.0, 0.05);
  CheckRel("nSkew"c, ProbSkewness(big2, 20000), 0.0, 0.05);
  CheckRel("nKurt"c, ProbKurtosisExcess(big2, 20000), 0.0, 0.1);
  // rund 68 Prozent im Ein-Sigma-Band
  var inBand: int64 := 0;
  var bi2: int64 := 0;
  while (bi2 < 20000) {
    var v: f64 := peekf64(big2 + bi2 * 8);
    if (AbsF64(v - 10.0) < 2.0) { inBand := inBand + 1; }
    bi2 := bi2 + 1;
  }
  CheckRel("nOneSigma"c, (inBand as f64) / 20000.0, 0.6827, 0.02);

  // Exponential: Mittel = 1/lambda
  ProbSeed(3);
  var ei2: int64 := 0;
  var esum: f64 := 0.0;
  while (ei2 < 20000) {
    esum := esum + ProbRandExponential(2.0);
    ei2 := ei2 + 1;
  }
  CheckRel("expSampleMean"c, esum / 20000.0, 0.5, 0.03);

  // Poisson: Mittel = lambda (beide Zweige, klein und gross)
  ProbSeed(5);
  var psum2: int64 := 0;
  var pi3: int64 := 0;
  while (pi3 < 20000) {
    psum2 := psum2 + ProbRandPoisson(4.0);
    pi3 := pi3 + 1;
  }
  CheckRel("poisSampleMean"c, (psum2 as f64) / 20000.0, 4.0, 0.03);

  ProbSeed(6);
  var psum3: int64 := 0;
  var pi4: int64 := 0;
  while (pi4 < 5000) {
    psum3 := psum3 + ProbRandPoisson(50.0);
    pi4 := pi4 + 1;
  }
  CheckRel("poisBigMean"c, (psum3 as f64) / 5000.0, 50.0, 0.03);

  // Binomial: Mittel = n*p
  ProbSeed(8);
  var bsum2: int64 := 0;
  var bi3: int64 := 0;
  while (bi3 < 10000) {
    bsum2 := bsum2 + ProbRandBinomial(20, 0.3);
    bi3 := bi3 + 1;
  }
  CheckRel("binSampleMean"c, (bsum2 as f64) / 10000.0, 6.0, 0.03);

  // Ganzzahlen bleiben in den Grenzen
  ProbSeed(11);
  var okInt: bool := true;
  var ii: int64 := 0;
  while (ii < 2000) {
    var k: int64 := ProbRandInt(3, 9);
    if (k < 3) { okInt := false; }
    if (k > 9) { okInt := false; }
    ii := ii + 1;
  }
  CheckB("randInt"c, okInt, true);
  CheckI("randIntDeg"c, ProbRandInt(5, 5), 5);

  // Mischen erhaelt die Werte (Summe bleibt gleich, Reihenfolge nicht)
  var sh: int64 := alloc(8 * 8);
  Fill8(sh);
  ProbSeed(21);
  ProbShuffle(sh, 8);
  CheckRel("shuffleSum"c, ProbSum(sh, 8), 23.8, TIGHT());
  var moved: bool := false;
  var si: int64 := 0;
  while (si < 8) {
    if (AbsF64(peekf64(sh + si * 8) - peekf64(d + si * 8)) > 0.000001) { moved := true; }
    si := si + 1;
  }
  CheckB("shuffleMoved"c, moved, true);
  free(sh, 8 * 8);
  free(big2, 20000 * 8);

  // ── Aufraeumen ────────────────────────────────────────────────────────────
  free(d, 8 * 8);
  free(xs, 5 * 8);   free(ys, 5 * 8);
  free(g1, 5 * 8);   free(g2, 5 * 8);
  free(obs, 6 * 8);  free(exp, 6 * 8);
  free(sl, 8); free(ic, 8); free(r2, 8);
  free(tstat, 8); free(tdf, 8);
  free(chi2v, 8); free(chidf, 8);
  free(lo, 8); free(hi, 8); free(lo2, 8); free(hi2, 8);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
