// tests/do_demo3_kubernetes.lyx — DO Demo 3: DOKS Cluster + App Deploy
// WP-DO-14 Demo 3
// Benötigt: DIGITALOCEAN_TOKEN env-Variable

unit tests.do_demo3_kubernetes;

import std.cloud.digitalocean.credentials;
import std.cloud.digitalocean.kubernetes;
import std.cloud.digitalocean.registry;
import std.cloud.digitalocean.apps;
import std.alloc;
import std.io;
import std.fs;

pub fn main(argc: int64, argv: pchar): int64 {
    var creds: DOCredentials := DOCredentialsFromEnv();
    if (creds.tokenLen == 0) {
        PrintLn("Fehler: DIGITALOCEAN_TOKEN nicht gesetzt."c);
        return 1;
    }

    PrintLn("--- DO Demo 3: DOKS Cluster ---"c);

    // Verfügbare Versionen abrufen
    PrintLn("Verfügbare K8s-Versionen:"c);
    var versions: int64 := K8sVersionList(creds);
    if (versions != 0) {
        PrintLn(versions as pchar);
        free(versions, StrLen(versions as pchar) + 1);
    }

    // Cluster erstellen
    Print("Erstelle DOKS-Cluster in fra1..."c);
    var cluster: DOK8sCluster := K8sClusterCreate(creds,
        "lyx-demo-k8s"c, "fra1"c, "latest"c, "s-2vcpu-4gb"c, 2);
    if (cluster.id == 0) {
        PrintLn(" FEHLER."c);
        DOCredentialsFree(creds);
        return 1;
    }
    Print(" ID: "c); PrintLn(cluster.id as pchar);
    DOK8sClusterFree(cluster);

    PrintLn("Hinweis: Cluster-Provisioning dauert ca. 5 Minuten."c);
    PrintLn("Nach Fertigstellung:"c);
    PrintLn("  lyxdo kubernetes cluster kubeconfig save <id> --output ~/.kube/config"c);
    PrintLn("  kubectl get nodes"c);

    // Container Registry erstellen (falls noch nicht vorhanden)
    PrintLn("Erstelle/überprüfe Container Registry..."c);
    var reg: DORegistry := RegistryGet(creds);
    if (reg.name == 0) {
        var newReg: DORegistry := RegistryCreate(creds, "lyx-demo"c, "fra1"c, "starter"c);
        if (newReg.name == 0) {
            PrintLn("Registry-Erstellung fehlgeschlagen."c);
        } else {
            Print("Registry erstellt: "c);
            printStr(newReg.serverURL);
            PrintLn(""c);
            DORegistryFree(newReg);
        }
    } else {
        Print("Bestehende Registry: "c);
        printStr(reg.serverURL);
        PrintLn(""c);
        DORegistryFree(reg);
    }

    PrintLn("--- Demo 3 abgeschlossen ---"c);
    DOCredentialsFree(creds);
    return 0;
}

fn printStr(val: int64) {
    if (val == 0) { Print("(none)"c); }
    else { Print(val as pchar); }
}
