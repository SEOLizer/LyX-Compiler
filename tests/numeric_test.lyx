// tests/numeric_test.lyx
// Selbstpruefende Testbatterie fuer std.numeric.
//
// Sollwerte aus Python. Der Kern der Pruefung ist aber ein anderer: zu jeder
// Aufgabe stehen ein einfaches und ein gutes Verfahren nebeneinander, und
// geprueft wird, dass das gute MESSBAR besser ist. Eine Batterie, in der
// Euler und Runge-Kutta gleich gut abschneiden, hat nichts belegt.
//
//   * Euler gegen RK4 bei y'=y: Euler liegt um 1,3e-2 daneben, RK4 um 2e-11
//   * Trapez gegen Simpson bei derselben Stuetzstellenzahl
//   * Gauss mit fuenf Knoten integriert Polynome bis Grad 9 EXAKT
//   * Newton mit exakter Ableitung (std.autodiff) gegen numerische
//
// Dazu strukturelle Aussagen: die Nullstelle erfuellt f(x)=0, der Spline geht
// durch alle Stuetzpunkte, das Integral ueber eine Konstante ist die Breite.

unit main;

import std.numeric;
import std.autodiff;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr("\n"c);
  }
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckNear(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  var d: f64 := got - want;
  if (d < 0.0) { d := 0.0 - d; }
  if (d > tol) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr(" diff*1e9="c);
    PrintFloat(d * 1000000000.0);
    PrintStr("\n"c);
  }
}

fn _abs(x: f64): f64 {
  if (x < 0.0) { return 0.0 - x; }
  return x;
}

// ── Die Testfunktionen ───────────────────────────────────────────────────────

fn FSq2(x: f64): f64 { return x * x - 2.0; }          // Nullstelle sqrt(2)
fn DSq2(x: f64): f64 { return 2.0 * x; }
fn FCos(x: f64): f64 { return x - CosF64(x); }        // x = cos(x)
fn FNoRoot(x: f64): f64 { return x * x + 1.0; }       // keine reelle Nullstelle
fn FCubicRoot(x: f64): f64 { return x * x * x - 8.0; } // Nullstelle 2

fn FOne(x: f64): f64 { return 1.0; }
fn FLin(x: f64): f64 { return 2.0 * x; }
fn FCube(x: f64): f64 { return x * x * x; }
fn FPoly9(x: f64): f64 {
  // Grad 9 — Gauss mit fuenf Knoten muss das exakt schaffen
  return x * x * x * x * x * x * x * x * x;
}
fn FSin(x: f64): f64 { return SinF64(x); }
fn FBell(x: f64): f64 { return ExpF64(0.0 - x * x); }

// ODE: y' = y
fn OdeExp(t: f64, y: f64): f64 { return y; }
// STEIF: y' = -1000(y - cos t) - sin t, Loesung y = cos t.
// Der Faktor -1000 zwingt jedes explizite Verfahren zu h < 2.8/1000.
fn OdeStiff(t: f64, y: f64): f64 {
  return 0.0 - 1000.0 * (y - CosF64(t)) - SinF64(t);
}
// Randwertproblem y'' = y  (Loesung sinh, wenn y(0)=0 und y'(0)=1)
fn BvpExp(x: f64, y: f64, v: f64): f64 { return y; }
// lineares RWP y'' + 0*y' + 1*y = 0  ->  y'' = -y
fn BvpP(x: f64): f64 { return 0.0; }
fn BvpQ(x: f64): f64 { return 1.0; }
fn BvpR(x: f64): f64 { return 0.0; }
// ODE: y' = -2ty, Loesung y = exp(-t^2)
fn OdeGauss(t: f64, y: f64): f64 { return 0.0 - 2.0 * t * y; }

// System: harmonischer Oszillator y'' = -y als y0'=y1, y1'=-y0
fn SysOsc(t: f64, y: int64, dydt: int64): void {
  pokef64(dydt, peekf64(y + 8));
  pokef64(dydt + 8, 0.0 - peekf64(y));
}

// Ableitung von x^2-2 ueber Vorwaerts-Dualzahlen aus std.autodiff — exakt,
// ohne die Formel von Hand hinzuschreiben. Genau dafuer gibt es die Unit.
fn DSq2auto(x: f64): f64 {
  var d: int64 := alloc(16);
  var sq: int64 := alloc(16);
  var c2: int64 := alloc(16);
  var r: int64 := alloc(16);
  AdDualVar(d, x);
  AdDualMul(d, d, sq);
  AdDualConst(c2, 2.0);
  AdDualSub(sq, c2, r);
  var res: f64 := AdDualDeriv(r);
  free(d, 16);  free(sq, 16);  free(c2, 16);  free(r, 16);
  return res;
}

fn main(): int64 {
  var SQRT2: f64 := 1.4142135623730951;
  var COSFIX: f64 := 0.7390851332151607;
  var E: f64 := 2.718281828459045;
  var GAUSSINT: f64 := 1.772453850902791;

  // ── Numerische Ableitung ───────────────────────────────────────────────────
  // d/dx x^3 bei 2 ist 12
  CheckNear("deriv.cubic"c, NumDeriv(FCube, 2.0), 12.0, 0.0000001);
  // d/dx sin bei 0 ist 1
  CheckNear("deriv.sin"c, NumDeriv(FSin, 0.0), 1.0, 0.0000001);
  // zweite Ableitung von x^3 bei 2 ist 12
  CheckNear("deriv2.cubic"c, NumDeriv2(FCube, 2.0), 12.0, 0.001);
  // Ableitung einer Konstanten ist null
  CheckNear("deriv.const"c, NumDeriv(FOne, 5.0), 0.0, 0.0000001);

  // die exakte Ableitung aus autodiff trifft besser als die numerische
  var exactD: f64 := DSq2auto(3.0);
  CheckNear("autodiff.exact"c, exactD, 6.0, 0.0);
  var numD: f64 := NumDeriv(FSq2, 3.0);
  CheckB("autodiff.beatsNumeric"c,
         _abs(exactD - 6.0) <= _abs(numD - 6.0), true);

  // ── Nullstellen ────────────────────────────────────────────────────────────
  CheckNear("bisect.sqrt2"c, NumBisect(FSq2, 0.0, 2.0, 1.0e-15, 200),
            SQRT2, 0.0000000001);
  CheckNear("brent.sqrt2"c, NumBrent(FSq2, 0.0, 2.0, 1.0e-15, 100),
            SQRT2, 0.0000000001);
  CheckNear("newton.sqrt2"c, NumNewton(FSq2, DSq2, 1.0, 1.0e-15, 50),
            SQRT2, 0.0000000001);
  CheckNear("secant.sqrt2"c, NumSecant(FSq2, 0.0, 2.0, 1.0e-15, 50),
            SQRT2, 0.0000000001);
  CheckNear("newtonNum.sqrt2"c, NumNewtonNum(FSq2, 1.0, 1.0e-13, 50),
            SQRT2, 0.0000001);

  // Newton mit Ableitung aus std.autodiff — der eigentliche Zweck jener Unit
  CheckNear("newton.autodiff"c, NumNewton(FSq2, DSq2auto, 1.0, 1.0e-15, 50),
            SQRT2, 0.0000000001);

  // x = cos(x)
  CheckNear("brent.cosFix"c, NumBrent(FCos, 0.0, 1.0, 1.0e-15, 100),
            COSFIX, 0.0000000001);
  CheckNear("bisect.cubic"c, NumBisect(FCubicRoot, 0.0, 5.0, 1.0e-14, 200),
            2.0, 0.0000000001);

  // Die gefundene Stelle muss f(x)=0 erfuellen — ohne fremden Sollwert
  var r1: f64 := NumBrent(FSq2, 0.0, 2.0, 1.0e-15, 100);
  CheckNear("brent.isRoot"c, FSq2(r1), 0.0, 0.0000000001);

  // kein Vorzeichenwechsel: Fehlerwert
  var bad: f64 := NumBisect(FNoRoot, 0.0, 2.0, 1.0e-12, 100);
  CheckB("bisect.noRootDetected"c, bad < 0.0 - 1.0e300, true);
  var bad2: f64 := NumBrent(FNoRoot, 0.0, 2.0, 1.0e-12, 100);
  CheckB("brent.noRootDetected"c, bad2 < 0.0 - 1.0e300, true);

  // Nullstelle genau auf einer Intervallgrenze: wird sofort erkannt
  CheckNear("bisect.rootIsEndpoint"c, NumBisect(FCubicRoot, 2.0, 5.0, 1.0e-14, 50),
            2.0, 0.0);
  CheckNear("brent.rootIsEndpoint"c, NumBrent(FCubicRoot, 0.0, 2.0, 1.0e-14, 50),
            2.0, 0.0);

  // Newton bei verschwindender Ableitung
  var flat: f64 := NumNewton(FSq2, FOne, 1.0, 1.0e-14, 5);
  CheckB("newton.survivesFlat"c, flat > 0.0, true);

  // Brent braucht weniger Schritte als die Halbierung: mit nur 15 Iterationen
  // ist Brent schon genau, Bisektion noch nicht.
  var b15: f64 := NumBrent(FSq2, 0.0, 2.0, 1.0e-15, 15);
  var h15: f64 := NumBisect(FSq2, 0.0, 2.0, 1.0e-15, 15);
  CheckB("brent.fasterThanBisect"c,
         _abs(b15 - SQRT2) < _abs(h15 - SQRT2), true);

  // ── Integration ────────────────────────────────────────────────────────────
  // Konstante: Flaeche ist die Breite
  CheckNear("trap.const"c, NumTrapezoid(FOne, 0.0, 3.0, 10), 3.0, 0.000000000001);
  CheckNear("simpson.const"c, NumSimpson(FOne, 0.0, 3.0, 10), 3.0, 0.000000000001);
  CheckNear("gauss.const"c, NumGauss5(FOne, 0.0, 3.0), 3.0, 0.000000000001);

  // 2x von 0 bis 1 ist 1 — die Trapezregel ist bei Geraden exakt
  CheckNear("trap.linearExact"c, NumTrapezoid(FLin, 0.0, 1.0, 4), 1.0, 0.000000000001);

  // x^3 von 0 bis 1 ist 0,25 — Simpson ist bei Grad 3 exakt, Trapez nicht
  var tCube: f64 := NumTrapezoid(FCube, 0.0, 1.0, 4);
  var sCube: f64 := NumSimpson(FCube, 0.0, 1.0, 4);
  CheckNear("simpson.cubicExact"c, sCube, 0.25, 0.000000000001);
  CheckB("trap.cubicNotExact"c, _abs(tCube - 0.25) > 0.001, true);

  // Gauss mit fuenf Knoten schafft Grad 9 exakt — mit fuenf Auswertungen
  CheckNear("gauss.degree9Exact"c, NumGauss5(FPoly9, 0.0, 1.0), 0.1, 0.000000000001);

  // sin von 0 bis pi ist 2
  var PI: f64 := 3.141592653589793;
  CheckNear("simpson.sin"c, NumSimpson(FSin, 0.0, PI, 100), 2.0, 0.0000001);
  CheckNear("romberg.sin"c, NumRomberg(FSin, 0.0, PI, 20, 1.0e-14), 2.0, 0.000000000001);
  CheckNear("adaptive.sin"c, NumAdaptiveSimpson(FSin, 0.0, PI, 1.0e-12, 30),
            2.0, 0.0000000001);
  CheckNear("gaussComp.sin"c, NumGaussComposite(FSin, 0.0, PI, 10), 2.0, 0.000000000001);

  // Glockenkurve
  var a5: f64 := 0.0 - 5.0;
  CheckNear("romberg.bell"c, NumRomberg(FBell, a5, 5.0, 20, 1.0e-13),
            GAUSSINT, 0.0000001);
  CheckNear("adaptive.bell"c, NumAdaptiveSimpson(FBell, a5, 5.0, 1.0e-12, 40),
            GAUSSINT, 0.0000001);
  CheckNear("gaussComp.bell"c, NumGaussComposite(FBell, a5, 5.0, 50),
            GAUSSINT, 0.0000001);

  // Simpson ist bei gleicher Stuetzstellenzahl besser als Trapez
  var tSin: f64 := NumTrapezoid(FSin, 0.0, PI, 20);
  var sSin: f64 := NumSimpson(FSin, 0.0, PI, 20);
  CheckB("simpson.beatsTrapezoid"c,
         _abs(sSin - 2.0) < _abs(tSin - 2.0), true);

  // umgekehrte Grenzen ergeben das negative Integral
  var negTwo: f64 := 0.0 - 2.0;
  CheckNear("integral.reversed"c, NumSimpson(FSin, PI, 0.0, 100), negTwo,
            0.0000001);
  // leeres Intervall
  CheckNear("integral.empty"c, NumSimpson(FSin, 1.0, 1.0, 10), 0.0, 0.000000000001);

  // ── Interpolation ──────────────────────────────────────────────────────────
  CheckNear("lerp.mid"c, NumLerp(0.0, 0.0, 2.0, 10.0, 1.0), 5.0, 0.000000000001);
  CheckNear("lerp.atStart"c, NumLerp(0.0, 3.0, 2.0, 10.0, 0.0), 3.0, 0.000000000001);
  CheckNear("lerp.degenerate"c, NumLerp(1.0, 7.0, 1.0, 9.0, 1.0), 7.0, 0.000000000001);

  var xs: int64 := alloc(5 * 8);
  var ys: int64 := alloc(5 * 8);
  var i: int64 := 0;
  while (i < 5) {
    var x: f64 := (i as f64);
    pokef64(xs + i * 8, x);
    pokef64(ys + i * 8, x * x * x);
    i := i + 1;
  }

  // Tabelleninterpolation trifft die Stuetzpunkte genau
  CheckNear("interp.atNode"c, NumInterpLinear(xs, ys, 5, 2.0), 8.0, 0.000000000001);
  // zwischen (2,8) und (3,27) liegt die GERADE, nicht die Kurve: 8 + 19/2
  CheckNear("interp.between"c, NumInterpLinear(xs, ys, 5, 2.5), 17.5, 0.000000000001);
  CheckNear("interp.belowRange"c, NumInterpLinear(xs, ys, 5, 0.0 - 1.0), 0.0, 0.000000000001);
  CheckNear("interp.aboveRange"c, NumInterpLinear(xs, ys, 5, 99.0), 64.0, 0.000000000001);

  // Lagrange durch fuenf Punkte von x^3 muss x^3 exakt wiedergeben
  CheckNear("lagrange.reproduces"c, NumLagrange(xs, ys, 5, 2.5), 15.625, 0.0000000001);
  CheckNear("lagrange.atNode"c, NumLagrange(xs, ys, 5, 3.0), 27.0, 0.0000000001);

  // Spline
  var y2: int64 := alloc(5 * 8);
  CheckB("spline.build"c, NumSplineBuild(xs, ys, 5, y2), true);
  // geht durch alle Stuetzpunkte
  var splineBad: int64 := 0;
  i := 0;
  while (i < 5) {
    var xi: f64 := peekf64(xs + i * 8);
    var yi: f64 := peekf64(ys + i * 8);
    var got: f64 := NumSplineEval(xs, ys, y2, 5, xi);
    if (_abs(got - yi) > 0.000000001) { splineBad := splineBad + 1; }
    i := i + 1;
  }
  CheckI("spline.passesThroughNodes"c, splineBad, 0);
  // zwischen den Punkten naeher an x^3 als die Gerade
  var sMid: f64 := NumSplineEval(xs, ys, y2, 5, 2.5);
  var lMid: f64 := NumInterpLinear(xs, ys, 5, 2.5);
  CheckB("spline.beatsLinear"c,
         _abs(sMid - 15.625) < _abs(lMid - 15.625), true);

  free(xs, 5 * 8);  free(ys, 5 * 8);  free(y2, 5 * 8);

  // ── ODE ────────────────────────────────────────────────────────────────────
  // y' = y, y(0)=1 -> y(1) = e
  var eu: f64 := NumEulerSolve(OdeExp, 0.0, 1.0, 1.0, 100);
  var rk: f64 := NumRk4Solve(OdeExp, 0.0, 1.0, 1.0, 100);
  CheckNear("euler.knownValue"c, eu, 2.7048138294215285, 0.000000001);
  CheckNear("rk4.exp"c, rk, E, 0.000000001);

  // Der Vergleich ist der Punkt: RK4 ist bei gleicher Schrittzahl um
  // Groessenordnungen besser.
  CheckB("rk4.beatsEuler"c, _abs(rk - E) < _abs(eu - E), true);
  CheckB("euler.errorIsLarge"c, _abs(eu - E) > 0.001, true);
  CheckB("rk4.errorIsTiny"c, _abs(rk - E) < 0.0000001, true);

  // y' = -2ty -> y = exp(-t^2); y(1) = 1/e
  var invE: f64 := 0.36787944117144233;
  CheckNear("rk4.gauss"c, NumRk4Solve(OdeGauss, 0.0, 1.0, 1.0, 200), invE,
            0.0000000001);

  // Mittelpunktverfahren liegt zwischen Euler und RK4
  var mp: f64 := 1.0;
  var h: f64 := 0.01;
  var t: f64 := 0.0;
  i := 0;
  while (i < 100) {
    mp := NumMidpointStep(OdeExp, t, mp, h);
    t := t + h;
    i := i + 1;
  }
  CheckB("midpoint.betterThanEuler"c, _abs(mp - E) < _abs(eu - E), true);
  CheckB("midpoint.worseThanRk4"c, _abs(mp - E) > _abs(rk - E), true);

  // Adaptiv: dasselbe Ergebnis mit selbst gewaehlter Schrittzahl
  var steps: int64 := alloc(8);
  var ad: f64 := NumRk4Adaptive(OdeExp, 0.0, 1.0, 1.0, 1.0e-12, 0.1, steps);
  CheckNear("adaptive.exp"c, ad, E, 0.0000000001);
  CheckB("adaptive.usedSteps"c, peek64(steps) > 0, true);
  CheckB("adaptive.notTooMany"c, peek64(steps) < 1000, true);
  free(steps, 8);

  // Ein Schritt ueber Null Breite aendert nichts
  CheckNear("rk4.zeroSpan"c, NumRk4Solve(OdeExp, 0.0, 5.0, 0.0, 10), 5.0,
            0.000000000001);

  // ── System: harmonischer Oszillator ────────────────────────────────────────
  //
  // y'' = -y mit y(0)=1, y'(0)=0 hat die Loesung cos(t). Nach 2*pi muss das
  // System wieder am Anfang stehen — und die Energie y^2 + y'^2 muss die ganze
  // Zeit eins bleiben. Beides ohne fremden Sollwert pruefbar.
  var y0: int64 := alloc(2 * 8);
  var out: int64 := alloc(2 * 8);
  pokef64(y0, 1.0);
  pokef64(y0 + 8, 0.0);

  CheckB("sys.solve"c, NumRk4SolveSys(SysOsc, 0.0, y0, 2, PI, 1000, out), true);
  // cos(pi) = -1, sin(pi) = 0
  CheckNear("sys.halfTurn"c, peekf64(out), 0.0 - 1.0, 0.0000001);
  CheckNear("sys.halfTurnVel"c, peekf64(out + 8), 0.0, 0.0000001);

  NumRk4SolveSys(SysOsc, 0.0, y0, 2, 2.0 * PI, 2000, out);
  CheckNear("sys.fullTurn"c, peekf64(out), 1.0, 0.0000001);
  CheckNear("sys.fullTurnVel"c, peekf64(out + 8), 0.0, 0.0000001);

  // Energieerhaltung an mehreren Zeitpunkten
  var energyBad: int64 := 0;
  var k: int64 := 1;
  while (k <= 8) {
    var tt: f64 := (k as f64) * PI / 4.0;
    NumRk4SolveSys(SysOsc, 0.0, y0, 2, tt, 500, out);
    var p: f64 := peekf64(out);
    var v: f64 := peekf64(out + 8);
    var en: f64 := p * p + v * v;
    if (_abs(en - 1.0) > 0.000001) { energyBad := energyBad + 1; }
    k := k + 1;
  }
  CheckI("sys.energyConserved"c, energyBad, 0);

  free(y0, 2 * 8);  free(out, 2 * 8);

  // ── Mehrschrittverfahren ───────────────────────────────────────────────────
  //
  // Vierte Ordnung wie RK4, aber eine Auswertung der rechten Seite je Schritt
  // statt vier.
  var ab: f64 := NumAdamsBashforth4(OdeExp, 0.0, 1.0, 1.0, 100);
  var abm: f64 := NumAdamsMoulton4(OdeExp, 0.0, 1.0, 1.0, 100);
  CheckNear("ab4.exp"c, ab, E, 0.0000001);
  CheckNear("abm4.exp"c, abm, E, 0.00000001);
  // die Nachbesserung ist besser als die blosse Vorhersage
  CheckB("abm4.beatsAb4"c, _abs(abm - E) < _abs(ab - E), true);
  // beide schlagen Euler deutlich
  CheckB("ab4.beatsEuler"c, _abs(ab - E) < _abs(eu - E), true);
  // zu wenige Schritte: faellt auf RK4 zurueck statt Unsinn zu liefern
  CheckNear("ab4.fewSteps"c, NumAdamsBashforth4(OdeExp, 0.0, 1.0, 1.0, 2),
            NumRk4Solve(OdeExp, 0.0, 1.0, 1.0, 2), 0.0);

  // ── Steife Gleichungen ─────────────────────────────────────────────────────
  //
  // Das ist der Kern: bei 50 Schritten ist h = 0,02 und damit weit ueber der
  // Stabilitaetsgrenze von RK4 (2,8/1000). Das explizite Verfahren laeuft
  // ueber, die impliziten treffen die Loesung cos(1) = 0,5403023.
  var cos1: f64 := 0.5403023058681398;
  var rkStiff: f64 := NumRk4Solve(OdeStiff, 0.0, 1.0, 1.0, 50);
  var bdf1: f64 := NumBdf1(OdeStiff, 0.0, 1.0, 1.0, 50);
  var bdf2: f64 := NumBdf2(OdeStiff, 0.0, 1.0, 1.0, 50);
  var trapz: f64 := NumTrapezoidal(OdeStiff, 0.0, 1.0, 1.0, 50);

  CheckB("stiff.rk4Explodes"c, _abs(rkStiff) > 1000.0, true);
  CheckNear("stiff.bdf1"c, bdf1, cos1, 0.0001);
  CheckNear("stiff.bdf2"c, bdf2, cos1, 0.000001);
  CheckNear("stiff.trapezoidal"c, trapz, cos1, 0.000001);
  // BDF2 ist zweiter Ordnung, BDF1 nur erster — der Unterschied muss messbar sein
  CheckB("stiff.bdf2BeatsBdf1"c, _abs(bdf2 - cos1) < _abs(bdf1 - cos1), true);

  // Auf nicht steifen Aufgaben stimmen die impliziten Verfahren ebenfalls
  CheckNear("bdf1.exp"c, NumBdf1(OdeExp, 0.0, 1.0, 1.0, 1000), E, 0.002);
  CheckNear("bdf2.exp"c, NumBdf2(OdeExp, 0.0, 1.0, 1.0, 1000), E, 0.00001);
  CheckNear("trapezoidal.exp"c, NumTrapezoidal(OdeExp, 0.0, 1.0, 1.0, 1000),
            E, 0.000001);
  // und die Trapezregel schlaegt BDF1 deutlich (zweite gegen erste Ordnung)
  var tE: f64 := NumTrapezoidal(OdeExp, 0.0, 1.0, 1.0, 100);
  var b1E: f64 := NumBdf1(OdeExp, 0.0, 1.0, 1.0, 100);
  CheckB("trapezoidal.beatsBdf1"c, _abs(tE - E) < _abs(b1E - E), true);

  // ── Randwertprobleme ───────────────────────────────────────────────────────
  //
  // y'' = y mit y(0) = 0 und y(1) = sinh(1). Die Loesung ist sinh(x), also
  // muss die gesuchte Anfangssteigung genau 1 sein.
  var sinh1: f64 := 1.1752011936438014;
  var slope: f64 := NumShoot(BvpExp, 0.0, 1.0, 0.0, sinh1, 0.0, 3.0, 200, 1.0e-13);
  CheckNear("shoot.slope"c, slope, 1.0, 0.0000001);

  // Mit der gefundenen Steigung muss der Verlauf beide Raender treffen
  var trace: int64 := alloc(101 * 8);
  CheckB("shootTrace.ok"c, NumShootTrace(BvpExp, 0.0, 1.0, 0.0, slope, 100, trace), true);
  CheckNear("shootTrace.left"c, peekf64(trace), 0.0, 0.0000000001);
  CheckNear("shootTrace.right"c, peekf64(trace + 100 * 8), sinh1, 0.0000001);
  // und in der Mitte sinh(0.5) = 0.5210953054937474
  CheckNear("shootTrace.middle"c, peekf64(trace + 50 * 8), 0.5210953054937474,
            0.0000001);
  free(trace, 101 * 8);

  // kein Vorzeichenwechsel im Steigungsbereich: Fehlerwert statt falscher Antwort
  var noSol: f64 := NumShoot(BvpExp, 0.0, 1.0, 0.0, sinh1, 5.0, 9.0, 100, 1.0e-12);
  CheckB("shoot.noBracketDetected"c, noSol < 0.0 - 1.0e300, true);

  // Lineares Randwertproblem mit finiten Differenzen:
  // y'' = -y, y(0) = 0, y(pi/2) = 1  ->  Loesung sin(x)
  var PI2: f64 := 1.5707963267948966;
  var nb: int64 := 100;
  var bys: int64 := alloc((nb + 1) * 8);
  CheckB("bvpLinear.ok"c, NumBvpLinear(BvpP, BvpQ, BvpR, 0.0, PI2, 0.0, 1.0, nb, bys),
         true);
  // Raender exakt
  CheckNear("bvpLinear.left"c, peekf64(bys), 0.0, 0.0);
  CheckNear("bvpLinear.right"c, peekf64(bys + nb * 8), 1.0, 0.0);
  // in der Mitte sin(pi/4) = 0.7071067811865476; zweite Ordnung bei n=100
  CheckNear("bvpLinear.middle"c, peekf64(bys + 50 * 8), 0.7071067811865476,
            0.0001);

  // Die Genauigkeit muss mit feinerem Gitter steigen — quadratisch, weil das
  // Verfahren zweiter Ordnung ist.
  var bys2: int64 := alloc(201 * 8);
  NumBvpLinear(BvpP, BvpQ, BvpR, 0.0, PI2, 0.0, 1.0, 200, bys2);
  var e100: f64 := _abs(peekf64(bys + 50 * 8) - 0.7071067811865476);
  var e200: f64 := _abs(peekf64(bys2 + 100 * 8) - 0.7071067811865476);
  CheckB("bvpLinear.convergesQuadratically"c, e200 < e100 / 3.0, true);
  free(bys, (nb + 1) * 8);  free(bys2, 201 * 8);

  // zu grobes Gitter wird abgelehnt
  var tiny: int64 := alloc(3 * 8);
  CheckB("bvpLinear.tooCoarse"c,
         NumBvpLinear(BvpP, BvpQ, BvpR, 0.0, PI2, 0.0, 1.0, 1, tiny), false);
  free(tiny, 3 * 8);

  // ── Negativkontrollen ──────────────────────────────────────────────────────
  //
  // Erstens: die Vergleiche oben muessen echte Unterschiede messen. Waeren
  // Euler und RK4 gleich gut, belegte "rk4.beatsEuler" nichts.
  CheckB("negCtrl.eulerRk4Differ"c, eu == rk, false);
  CheckB("negCtrl.trapSimpsonDiffer"c, tSin == sSin, false);

  // Zweitens: eine falsche Ableitung muss Newton verderben — sonst haette der
  // Ableitungsparameter keine Wirkung.
  var wrong: f64 := NumNewton(FSq2, FOne, 1.0, 1.0e-15, 50);
  CheckB("negCtrl.wrongDerivFails"c, _abs(wrong - SQRT2) < 0.0000001, false);

  // Drittens: die Nullstellensuche darf sich nicht auf ein Intervall ohne
  // Vorzeichenwechsel einlassen.
  CheckB("negCtrl.noRootRefused"c, bad > 0.0, false);

  // Viertens: der steife Fall muss RK4 tatsaechlich zu Fall bringen. Liefe es
  // dort auch durch, belegte "stiff.bdf2" nicht, wozu implizite Verfahren gut
  // sind. Mit genug Schritten schafft RK4 es dagegen sehr wohl — das zeigt,
  // dass es an der Schrittweite liegt und nicht an der Aufgabe.
  CheckB("negCtrl.rk4FailsWhenStiff"c, _abs(rkStiff - cos1) < 1.0, false);
  CheckNear("negCtrl.rk4WorksWithTinySteps"c,
            NumRk4Solve(OdeStiff, 0.0, 1.0, 1.0, 5000), cos1, 0.0001);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
