// demo_pg_types.lyx — WP-PG-12 Demo 6: NULL & PostgreSQL-Typen
//
// Tabelle mit INT8, FLOAT8, TEXT, BOOL und NULL-Spalte.
// Gibt PGGetFieldTypeOid und PGIsNull für jede Spalte aus.

import std.db.postgres;

fn connect(): int64 {
  var probe: int64 := pgProbe("127.0.0.1"c, 5432, "postgres"c, "postgres"c);
  if (probe == 0) { PrintStr("SKIP: PostgreSQL not available\n"); return 0; }
  var conn: int64 := PGConnect("127.0.0.1"c, 5432, "postgres"c, ""c, "postgres"c);
  if (conn == 0) { PrintStr("SKIP: TCP error\n"); return 0; }
  if (PGIsConnected(conn) == 0) {
    if (PGErrno(conn) == PG_ERR_PROTO) { PrintStr("SKIP: unsupported auth (need trust/md5)\n"); }
    else { PrintStr("SKIP: not connected\n"); }
    PGClose(conn); return 0;
  }
  return conn;
}

pub fn main(): int64 {
  var conn: int64 := connect();
  if (conn == 0) { return 0; }

  var r0: int64 := PGQuery(conn, "DROP TABLE IF EXISTS pg_demo_types"c);
  if (r0 != 0) { PGFreeResult(r0); }
  var r1: int64 := PGQuery(conn,
    "CREATE TABLE pg_demo_types (n INT8, f FLOAT8, t TEXT, b BOOL, x TEXT)"c);
  if (r1 == 0) { PrintStr("FAIL: CREATE\n"); PGClose(conn); return 1; }
  PGFreeResult(r1);

  // INSERT one row: n=42, f=3.14, t='hello', b=true, x=NULL
  var rIns: int64 := PGQuery(conn,
    "INSERT INTO pg_demo_types VALUES (42, 3.14, 'hello', true, NULL)"c);
  if (rIns == 0) { PrintStr("FAIL: INSERT\n"); PGClose(conn); return 1; }
  PGFreeResult(rIns);

  // SELECT and inspect
  var rSel: int64 := PGQuery(conn, "SELECT n, f, t, b, x FROM pg_demo_types"c);
  if (rSel == 0 || PGNumRows(rSel) == 0) {
    PrintStr("FAIL: SELECT\n");
    if (rSel != 0) { PGFreeResult(rSel); }
    PGClose(conn); return 1;
  }

  var nFields: int64 := PGNumFields(rSel);
  PrintStr("Fields: "); PrintInt(nFields); PrintStr("\n");

  // Print field metadata
  var col: int64 := 0;
  while (col < nFields) {
    PrintStr("  ["); PrintInt(col); PrintStr("] name=");
    PrintStr(PGGetFieldName(rSel, col));
    PrintStr(" oid="); PrintInt(PGGetFieldTypeOid(rSel, col));
    PrintStr("\n");
    col := col + 1;
  }

  PGFetchRow(rSel);

  PrintStr("Values:\n");
  PrintStr("  n (INT8, oid="); PrintInt(PG_OID_INT8); PrintStr("): ");
  PrintInt(PGGetInt(rSel, 0)); PrintStr("\n");

  PrintStr("  f (FLOAT8, oid="); PrintInt(PG_OID_FLOAT8); PrintStr("): ");
  PrintFloat(PGGetFloat(rSel, 1)); PrintStr("\n");

  PrintStr("  t (TEXT, oid="); PrintInt(PG_OID_TEXT); PrintStr("): ");
  PrintStr(PGGetStr(rSel, 2)); PrintStr("\n");

  PrintStr("  b (BOOL, oid="); PrintInt(PG_OID_BOOL); PrintStr("): ");
  if (PGGetBool(rSel, 3) != 0) { PrintStr("true"); } else { PrintStr("false"); }
  PrintStr("\n");

  PrintStr("  x (TEXT, NULL): PGIsNull=");
  PrintInt(PGIsNull(rSel, 0, 4)); PrintStr("\n");

  PGFreeResult(rSel);

  // Verify OIDs
  var rOid: int64 := PGQuery(conn, "SELECT n, f, t, b, x FROM pg_demo_types"c);
  if (rOid == 0) { PrintStr("FAIL: OID verify\n"); PGClose(conn); return 1; }
  var oidN: int64 := PGGetFieldTypeOid(rOid, 0);
  var oidF: int64 := PGGetFieldTypeOid(rOid, 1);
  var oidT: int64 := PGGetFieldTypeOid(rOid, 2);
  var oidB: int64 := PGGetFieldTypeOid(rOid, 3);
  PGFreeResult(rOid);

  if (oidN != PG_OID_INT8)  { PrintStr("FAIL: INT8 oid=");  PrintInt(oidN); PrintStr("\n"); PGClose(conn); return 1; }
  if (oidF != PG_OID_FLOAT8){ PrintStr("FAIL: FLOAT8 oid=");PrintInt(oidF); PrintStr("\n"); PGClose(conn); return 1; }
  if (oidT != PG_OID_TEXT)  { PrintStr("FAIL: TEXT oid=");  PrintInt(oidT); PrintStr("\n"); PGClose(conn); return 1; }
  if (oidB != PG_OID_BOOL)  { PrintStr("FAIL: BOOL oid=");  PrintInt(oidB); PrintStr("\n"); PGClose(conn); return 1; }

  PrintStr("OIDs correct: INT8="); PrintInt(oidN);
  PrintStr(" FLOAT8="); PrintInt(oidF);
  PrintStr(" TEXT="); PrintInt(oidT);
  PrintStr(" BOOL="); PrintInt(oidB); PrintStr("\n");

  var rDrop: int64 := PGQuery(conn, "DROP TABLE pg_demo_types"c);
  if (rDrop != 0) { PGFreeResult(rDrop); }
  PGClose(conn);
  PrintStr("OK\n");
  return 0;
}
