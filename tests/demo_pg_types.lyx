// demo_pg_types.lyx — WP-PG-12 Demo 6: NULL & PostgreSQL-Typen
//
// Tabelle mit INT8, FLOAT8, TEXT, BOOL und NULL-Spalte.
// Gibt PGGetFieldTypeOid und PGIsNull für jede Spalte aus.

import std.db.postgres;

fn connect(): int64 {
  var probe: int64 := pgProbe("127.0.0.1"c, 5432, "postgres"c, "postgres"c);
  if (probe == 0) { PrintLn("SKIP: PostgreSQL not available"); return 0; }
  var conn: int64 := PGConnect("127.0.0.1"c, 5432, "postgres"c, ""c, "postgres"c);
  if (conn == 0) { PrintLn("SKIP: TCP error"); return 0; }
  if (PGIsConnected(conn) == 0) {
    if (PGErrno(conn) == PG_ERR_PROTO) { PrintLn("SKIP: unsupported auth (need trust/md5)"); }
    else { PrintLn("SKIP: not connected"); }
    PGClose(conn); return 0;
  }
  return conn;
}

pub fn main(): int64 {
  var conn: int64 := connect();
  if (conn == 0) { return 0; }

  var r0: int64 := PGQuery(conn, "DROP TABLE IF EXISTS pg_demo_types"c);
  if (r0 != 0) { PGFreeResult(r0); }
  var r1: int64 := PGQuery(conn,
    "CREATE TABLE pg_demo_types (n INT8, f FLOAT8, t TEXT, b BOOL, x TEXT)"c);
  if (r1 == 0) { PrintLn("FAIL: CREATE"); PGClose(conn); return 1; }
  PGFreeResult(r1);

  // INSERT one row: n=42, f=3.14, t='hello', b=true, x=NULL
  var rIns: int64 := PGQuery(conn,
    "INSERT INTO pg_demo_types VALUES (42, 3.14, 'hello', true, NULL)"c);
  if (rIns == 0) { PrintLn("FAIL: INSERT"); PGClose(conn); return 1; }
  PGFreeResult(rIns);

  // SELECT and inspect
  var rSel: int64 := PGQuery(conn, "SELECT n, f, t, b, x FROM pg_demo_types"c);
  if (rSel == 0 || PGNumRows(rSel) == 0) {
    PrintLn("FAIL: SELECT");
    if (rSel != 0) { PGFreeResult(rSel); }
    PGClose(conn); return 1;
  }

  var nFields: int64 := PGNumFields(rSel);
  Print("Fields: "); PrintLn(StrFromInt(nFields));

  // Print field metadata
  var col: int64 := 0;
  while (col < nFields) {
    Print("  ["); Print(StrFromInt(col)); Print("] name=");
    Print(PGGetFieldName(rSel, col));
    Print(" oid="); PrintLn(StrFromInt(PGGetFieldTypeOid(rSel, col)));
    col := col + 1;
  }

  PGFetchRow(rSel);

  PrintLn("Values:");
  Print("  n (INT8, oid="); Print(StrFromInt(PG_OID_INT8)); Print("): ");
  PrintLn(StrFromInt(PGGetInt(rSel, 0)));

  Print("  f (FLOAT8, oid="); Print(StrFromInt(PG_OID_FLOAT8)); Print("): ");
  PrintFloat(PGGetFloat(rSel, 1)); PrintLn("");

  Print("  t (TEXT, oid="); Print(StrFromInt(PG_OID_TEXT)); Print("): ");
  PrintLn(PGGetStr(rSel, 2));

  Print("  b (BOOL, oid="); Print(StrFromInt(PG_OID_BOOL)); Print("): ");
  if (PGGetBool(rSel, 3) != 0) { Print("true"); } else { Print("false"); }
  PrintLn("");

  Print("  x (TEXT, NULL): PGIsNull=");
  PrintLn(StrFromInt(PGIsNull(rSel, 0, 4)));

  PGFreeResult(rSel);

  // Verify OIDs
  var rOid: int64 := PGQuery(conn, "SELECT n, f, t, b, x FROM pg_demo_types"c);
  if (rOid == 0) { PrintLn("FAIL: OID verify"); PGClose(conn); return 1; }
  var oidN: int64 := PGGetFieldTypeOid(rOid, 0);
  var oidF: int64 := PGGetFieldTypeOid(rOid, 1);
  var oidT: int64 := PGGetFieldTypeOid(rOid, 2);
  var oidB: int64 := PGGetFieldTypeOid(rOid, 3);
  PGFreeResult(rOid);

  if (oidN != PG_OID_INT8)  { Print("FAIL: INT8 oid=");  PrintLn(StrFromInt(oidN)); PGClose(conn); return 1; }
  if (oidF != PG_OID_FLOAT8){ Print("FAIL: FLOAT8 oid=");PrintLn(StrFromInt(oidF)); PGClose(conn); return 1; }
  if (oidT != PG_OID_TEXT)  { Print("FAIL: TEXT oid=");  PrintLn(StrFromInt(oidT)); PGClose(conn); return 1; }
  if (oidB != PG_OID_BOOL)  { Print("FAIL: BOOL oid=");  PrintLn(StrFromInt(oidB)); PGClose(conn); return 1; }

  Print("OIDs correct: INT8="); Print(StrFromInt(oidN));
  Print(" FLOAT8="); Print(StrFromInt(oidF));
  Print(" TEXT="); Print(StrFromInt(oidT));
  Print(" BOOL="); PrintLn(StrFromInt(oidB));

  var rDrop: int64 := PGQuery(conn, "DROP TABLE pg_demo_types"c);
  if (rDrop != 0) { PGFreeResult(rDrop); }
  PGClose(conn);
  PrintLn("OK");
  return 0;
}
