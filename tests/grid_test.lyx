// tests/grid_test.lyx
// Selbstpruefende Testbatterie fuer std.grid.
//
// Sollwerte aus einem unabhaengigen Python-Nachbau (BFS, Dijkstra mit heapq,
// A*). Dazu strukturelle Pruefungen, die ohne fremde Zahl auskommen:
//
//   * A*-Kosten == Dijkstra-Kosten  (eine zulaessige Heuristik aendert das
//     Ergebnis nicht, nur den Aufwand)
//   * Pfad ist zusammenhaengend, begehbar, faengt am Start an, endet am Ziel
//   * BFS-Schrittzahl <= Zahl der Zellen, und >= Chebyshev/Manhattan-Untergrenze
//   * Heuristik nie groesser als der wahre Restweg (Zulaessigkeit, direkt
//     geprueft gegen Dijkstra ueber alle Zellen)
//
// Der letzte Punkt ist der eigentliche Kern der Unit: er zeigt schwarz auf
// weiss, dass Manhattan bei acht Richtungen ueberschaetzt und Oktil nicht.

unit main;

import std.grid;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn TOL(): f64 { return 0.000000001; }

fn Check(name: pchar, got: f64, want: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > TOL()) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr("\n"c);
  }
}

// ── Pruefung: ist ein Pfad ueberhaupt ein Pfad? ──────────────────────────────
// Zusammenhaengend (jeder Schritt hoechstens ein Feld weit), begehbar, und
// mit den geforderten Enden. Faengt Indexfehler, die Kosten nicht aendern.
fn PathValid(cells: int64, w: int64, h: int64, px: int64, py: int64, len: int64,
             sx: int64, sy: int64, gx: int64, gy: int64, diag: bool): bool {
  if (len < 1) { return false; }
  if (peek64(px) != sx) { return false; }
  if (peek64(py) != sy) { return false; }
  if (peek64(px + (len - 1) * 8) != gx) { return false; }
  if (peek64(py + (len - 1) * 8) != gy) { return false; }

  var i: int64 := 0;
  while (i < len) {
    var x: int64 := peek64(px + i * 8);
    var y: int64 := peek64(py + i * 8);
    if (!GridWalkable(cells, x, y, w, h)) { return false; }
    if (i > 0) {
      var dx: int64 := x - peek64(px + (i - 1) * 8);
      var dy: int64 := y - peek64(py + (i - 1) * 8);
      if (dx < 0) { dx := 0 - dx; }
      if (dy < 0) { dy := 0 - dy; }
      if (dx > 1) { return false; }
      if (dy > 1) { return false; }
      if (dx + dy == 0) { return false; }
      if (!diag) {
        if (dx + dy != 1) { return false; }
      }
    }
    i := i + 1;
  }
  return true;
}

// Kosten eines Pfades aus seinen Zellen, nach derselben Regel wie die Unit:
// Betretungskosten der Zielzelle, diagonal mal Wurzel Zwei.
fn WalkCost(cells: int64, w: int64, h: int64, px: int64, py: int64, len: int64): f64 {
  var s: f64 := 0.0;
  var r2: f64 := 1.4142135623730951;
  var i: int64 := 1;
  while (i < len) {
    var x: int64 := peek64(px + i * 8);
    var y: int64 := peek64(py + i * 8);
    var step: f64 := GridCost(cells, x, y, w, h) as f64;
    if (x != peek64(px + (i - 1) * 8)) {
      if (y != peek64(py + (i - 1) * 8)) { step := step * r2; }
    }
    s := s + step;
    i := i + 1;
  }
  return s;
}

fn main(): int64 {
  // ── Koordinaten ────────────────────────────────────────────────────────────
  CheckI("index"c, GridIndex(3, 2, 10), 23);
  CheckI("x"c, GridX(23, 10), 3);
  CheckI("y"c, GridY(23, 10), 2);
  CheckB("inb"c, GridInBounds(3, 2, 10, 10), true);
  CheckB("inbNegX"c, GridInBounds(0 - 1, 2, 10, 10), false);
  CheckB("inbNegY"c, GridInBounds(3, 0 - 1, 10, 10), false);
  CheckB("inbW"c, GridInBounds(10, 2, 10, 10), false);
  CheckB("inbH"c, GridInBounds(3, 10, 10, 10), false);

  // ── Abstaende ──────────────────────────────────────────────────────────────
  CheckI("man"c, GridManhattan(0, 0, 3, 4), 7);
  CheckI("manSym"c, GridManhattan(3, 4, 0, 0), 7);
  CheckI("manSelf"c, GridManhattan(2, 2, 2, 2), 0);
  CheckI("cheb"c, GridChebyshev(0, 0, 3, 4), 4);
  CheckI("chebSym"c, GridChebyshev(3, 4, 0, 0), 4);
  CheckI("chebSelf"c, GridChebyshev(2, 2, 2, 2), 0);

  var r2: f64 := 1.4142135623730951;
  Check("oct11"c, GridOctile(0, 0, 1, 1), r2);
  Check("oct34"c, GridOctile(0, 0, 3, 4), 3.0 * r2 + 1.0);
  Check("oct43"c, GridOctile(0, 0, 4, 3), 3.0 * r2 + 1.0);
  Check("octSelf"c, GridOctile(5, 5, 5, 5), 0.0);
  Check("octStraight"c, GridOctile(0, 0, 5, 0), 5.0);

  // Oktil liegt immer zwischen Chebyshev und Manhattan — das ist genau die
  // Aussage "schaerfer als Chebyshev, aber nicht ueberschaetzend wie Manhattan".
  var oct: f64 := GridOctile(0, 0, 3, 4);
  CheckB("octGeCheb"c, oct >= (GridChebyshev(0, 0, 3, 4) as f64), true);
  CheckB("octLeMan"c, oct <= (GridManhattan(0, 0, 3, 4) as f64), true);

  Check("heur4"c, GridHeuristic(0, 0, 3, 4, false), 7.0);
  Check("heur8"c, GridHeuristic(0, 0, 3, 4, true), 3.0 * r2 + 1.0);

  // ── Gitter aufbauen ────────────────────────────────────────────────────────
  var w: int64 := 8;
  var h: int64 := 6;
  var n: int64 := w * h;
  var cells: int64 := alloc(n * 8);
  GridFill(cells, w, h, 1);
  CheckI("fill"c, GridCost(cells, 0, 0, w, h), 1);
  CheckI("fillLast"c, GridCost(cells, 7, 5, w, h), 1);
  GridSet(cells, 3, 3, w, 0);
  CheckI("set"c, GridCost(cells, 3, 3, w, h), 0);
  CheckB("walkable"c, GridWalkable(cells, 0, 0, w, h), true);
  CheckB("blocked"c, GridWalkable(cells, 3, 3, w, h), false);
  CheckB("oobBlocked"c, GridWalkable(cells, 0 - 1, 0, w, h), false);
  CheckI("oobCost"c, GridCost(cells, 99, 99, w, h), GRID_BLOCKED);
  GridSet(cells, 3, 3, w, 1);

  // ── Nachbarn ───────────────────────────────────────────────────────────────
  var nx: int64 := alloc(8 * 8);
  var ny: int64 := alloc(8 * 8);
  CheckI("nb4mid"c, GridNeighbors(cells, 3, 3, w, h, false, nx, ny), 4);
  CheckI("nb8mid"c, GridNeighbors(cells, 3, 3, w, h, true, nx, ny), 8);
  CheckI("nb4corner"c, GridNeighbors(cells, 0, 0, w, h, false, nx, ny), 2);
  CheckI("nb8corner"c, GridNeighbors(cells, 0, 0, w, h, true, nx, ny), 3);
  CheckI("nb4edge"c, GridNeighbors(cells, 0, 2, w, h, false, nx, ny), 3);
  CheckI("nb8edge"c, GridNeighbors(cells, 0, 2, w, h, true, nx, ny), 5);

  // Eckenschnitt: sind beide geraden Nachbarn einer Diagonalen belegt, faellt
  // die Diagonale weg. Mit nur EINEM belegten Nachbarn ebenfalls — sonst
  // schluepft der Weg durch die Wand.
  GridSet(cells, 4, 3, w, 0);
  CheckI("nb8oneWall"c, GridNeighbors(cells, 3, 3, w, h, true, nx, ny), 5);
  GridSet(cells, 3, 4, w, 0);
  CheckI("nb8twoWall"c, GridNeighbors(cells, 3, 3, w, h, true, nx, ny), 3);
  GridSet(cells, 4, 3, w, 1);
  GridSet(cells, 3, 4, w, 1);

  // ── Bresenham ──────────────────────────────────────────────────────────────
  var px: int64 := alloc(64 * 8);
  var py: int64 := alloc(64 * 8);

  CheckI("lineLenH"c, GridLine(0, 0, 5, 0, px, py, 64), 6);
  CheckI("lineLenV"c, GridLine(0, 0, 0, 5, px, py, 64), 6);
  CheckI("lineLenD"c, GridLine(0, 0, 5, 5, px, py, 64), 6);
  CheckI("lineLenPoint"c, GridLine(2, 2, 2, 2, px, py, 64), 1);

  // (0,0)->(4,2): Sollwerte aus dem Python-Nachbau des Standard-Bresenham.
  var ln: int64 := GridLine(0, 0, 4, 2, px, py, 64);
  CheckI("lineN"c, ln, 5);
  CheckI("lp0x"c, peek64(px), 0);        CheckI("lp0y"c, peek64(py), 0);
  CheckI("lp1x"c, peek64(px + 8), 1);    CheckI("lp1y"c, peek64(py + 8), 0);
  CheckI("lp2x"c, peek64(px + 16), 2);   CheckI("lp2y"c, peek64(py + 16), 1);
  CheckI("lp3x"c, peek64(px + 24), 3);   CheckI("lp3y"c, peek64(py + 24), 1);
  CheckI("lp4x"c, peek64(px + 32), 4);   CheckI("lp4y"c, peek64(py + 32), 2);

  // Rueckwaerts gezogen muss dieselbe Menge Zellen herauskommen.
  var lnr: int64 := GridLine(4, 2, 0, 0, px, py, 64);
  CheckI("lineRevN"c, lnr, 5);
  CheckI("lineRevStart"c, peek64(px), 4);
  CheckI("lineRevEnd"c, peek64(px + 32), 0);

  // Negative Richtung
  CheckI("lineNegN"c, GridLine(4, 4, 0, 2, px, py, 64), 5);
  CheckI("lineNeg0x"c, peek64(px), 4);
  CheckI("lineNeg4y"c, peek64(py + 32), 2);

  // maxLen zu klein -> -1, kein Ueberlauf
  CheckI("lineTooLong"c, GridLine(0, 0, 20, 0, px, py, 4), 0 - 1);

  // Sichtlinie
  CheckB("los.clear"c, GridLineOfSight(cells, 0, 0, 7, 0, w, h), true);
  GridSet(cells, 4, 0, w, 0);
  CheckB("los.blocked"c, GridLineOfSight(cells, 0, 0, 7, 0, w, h), false);
  CheckB("los.around"c, GridLineOfSight(cells, 0, 1, 7, 1, w, h), true);
  GridSet(cells, 4, 0, w, 1);
  CheckB("los.self"c, GridLineOfSight(cells, 2, 2, 2, 2, w, h), true);

  // ── BFS auf leerem Gitter ──────────────────────────────────────────────────
  var dist: int64 := alloc(n * 8);
  CheckB("bfsOk"c, GridBfs(cells, w, h, 0, 0, false, dist), true);
  CheckI("bfsSelf"c, peek64(dist + GridIndex(0, 0, w) * 8), 0);
  // Auf leerem Gitter ist die 4er-BFS-Zahl genau Manhattan.
  CheckI("bfsMan1"c, peek64(dist + GridIndex(3, 4, w) * 8), 7);
  CheckI("bfsMan2"c, peek64(dist + GridIndex(7, 5, w) * 8), 12);
  // ... und die 8er-Zahl genau Chebyshev.
  GridBfs(cells, w, h, 0, 0, true, dist);
  CheckI("bfsCheb1"c, peek64(dist + GridIndex(3, 4, w) * 8), 4);
  CheckI("bfsCheb2"c, peek64(dist + GridIndex(7, 5, w) * 8), 7);

  CheckB("bfsBadStart"c, GridBfs(cells, w, h, 0 - 1, 0, false, dist), false);
  CheckB("bfsBadW"c, GridBfs(cells, w, h, 0, 0, false, dist), true);

  CheckI("floodAll"c, GridFloodCount(cells, w, h, 0, 0, false), n);
  CheckB("reach"c, GridReachable(cells, w, h, 0, 0, 7, 5, false), true);
  CheckB("reachOob"c, GridReachable(cells, w, h, 0, 0, 99, 0, false), false);

  // ── Mauer quer durch, mit Luecke ───────────────────────────────────────────
  // Spalte 4 zu, ausser Zeile 5. Der Weg muss aussenherum.
  var y: int64 := 0;
  while (y < 5) {
    GridSet(cells, 4, y, w, 0);
    y := y + 1;
  }
  CheckB("wallLos"c, GridLineOfSight(cells, 0, 0, 7, 0, w, h), false);
  CheckB("wallReach"c, GridReachable(cells, w, h, 0, 0, 7, 0, false), true);
  CheckI("wallFlood"c, GridFloodCount(cells, w, h, 0, 0, false), n - 5);

  GridBfs(cells, w, h, 0, 0, false, dist);
  // (7,0) nur ueber die Luecke bei (4,5): 4 nach rechts, 5 runter, 3 rechts,
  // 5 hoch = 17 Schritte. Gegengerechnet mit dem Python-BFS.
  CheckI("wallBfs70"c, peek64(dist + GridIndex(7, 0, w) * 8), 17);
  CheckI("wallBfs45"c, peek64(dist + GridIndex(4, 5, w) * 8), 9);
  CheckI("wallBlockedCell"c, peek64(dist + GridIndex(4, 0, w) * 8), 0 - 1);

  // Vollstaendig abgeriegelte Zelle
  GridSet(cells, 4, 5, w, 0);
  CheckI("sealedFlood"c, GridFloodCount(cells, w, h, 0, 0, false), 4 * 6);
  CheckB("sealedReach"c, GridReachable(cells, w, h, 0, 0, 7, 0, false), false);
  GridBfs(cells, w, h, 0, 0, false, dist);
  CheckI("sealedBfs"c, peek64(dist + GridIndex(7, 0, w) * 8), 0 - 1);
  GridSet(cells, 4, 5, w, 1);

  // ── Dijkstra und A* muessen dieselben Kosten liefern ───────────────────────
  var dd: int64 := alloc(n * 8);
  var pp: int64 := alloc(n * 8);
  CheckB("dijOk"c, GridDijkstra(cells, w, h, 0, 0, false, dd, pp), true);
  var dv0: f64 := peekf64(dd + GridIndex(0, 0, w) * 8);
  Check("dijSelf"c, dv0, 0.0);
  var dv7: f64 := peekf64(dd + GridIndex(7, 0, w) * 8);
  Check("dij70"c, dv7, 17.0);
  var dvb: f64 := peekf64(dd + GridIndex(4, 0, w) * 8);
  var mone: f64 := 0.0 - 1.0;
  Check("dijBlocked"c, dvb, mone);

  var pl: int64 := GridPathFrom(pp, GridIndex(7, 0, w), w, px, py, 64);
  CheckI("prevPathLen"c, pl, 18);
  CheckB("prevPathValid"c,
         PathValid(cells, w, h, px, py, pl, 0, 0, 7, 0, false), true);
  Check("prevPathCost"c, WalkCost(cells, w, h, px, py, pl), 17.0);

  var an: int64 := GridAStar(cells, w, h, 0, 0, 7, 0, false, px, py, 64);
  CheckI("aStarLen"c, an, 18);
  CheckB("aStarValid"c,
         PathValid(cells, w, h, px, py, an, 0, 0, 7, 0, false), true);
  Check("aStarCost"c, WalkCost(cells, w, h, px, py, an), 17.0);
  Check("pathCost"c, GridPathCost(cells, w, h, 0, 0, 7, 0, false), 17.0);

  // 8 Richtungen: durch die Luecke, aber diagonal abkuerzend
  var an8: int64 := GridAStar(cells, w, h, 0, 0, 7, 0, true, px, py, 64);
  CheckB("aStar8Valid"c,
         PathValid(cells, w, h, px, py, an8, 0, 0, 7, 0, true), true);
  var c8: f64 := GridPathCost(cells, w, h, 0, 0, 7, 0, true);
  Check("aStar8Cost"c, WalkCost(cells, w, h, px, py, an8), c8);

  // Ziel gleich Start
  CheckI("aStarSelf"c, GridAStar(cells, w, h, 2, 2, 2, 2, false, px, py, 64), 1);
  Check("pathCostSelf"c, GridPathCost(cells, w, h, 2, 2, 2, 2, false), 0.0);

  // Unerreichbar / ungueltig
  GridSet(cells, 4, 5, w, 0);
  CheckI("aStarNoWay"c, GridAStar(cells, w, h, 0, 0, 7, 0, false, px, py, 64), 0 - 1);
  var pcn: f64 := GridPathCost(cells, w, h, 0, 0, 7, 0, false);
  var mone2: f64 := 0.0 - 1.0;
  Check("pathCostNoWay"c, pcn, mone2);
  GridSet(cells, 4, 5, w, 1);
  CheckI("aStarOob"c, GridAStar(cells, w, h, 0, 0, 99, 0, false, px, py, 64), 0 - 1);
  GridSet(cells, 7, 0, w, 0);
  CheckI("aStarGoalBlocked"c,
         GridAStar(cells, w, h, 0, 0, 7, 0, false, px, py, 64), 0 - 1);
  CheckI("aStarStartBlocked"c,
         GridAStar(cells, w, h, 7, 0, 0, 0, false, px, py, 64), 0 - 1);
  GridSet(cells, 7, 0, w, 1);
  CheckI("aStarTooShort"c,
         GridAStar(cells, w, h, 0, 0, 7, 0, false, px, py, 4), 0 - 1);

  // ── Kosten ungleich eins ───────────────────────────────────────────────────
  // Mauer weg, dafuer eine teure Spalte: Sumpf mit Kosten 5. Der Weg soll ihn
  // umgehen, wenn der Umweg billiger ist, und hindurch, wenn nicht.
  GridFill(cells, w, h, 1);
  y := 0;
  while (y < 5) {
    GridSet(cells, 4, y, w, 9);
    y := y + 1;
  }
  // Gerade durch: 7 Schritte, davon einer zu 9 -> 6*1 + 9 = 15.
  // Aussenherum ueber Zeile 5: 5 runter + 3 rechts + 5 hoch + 4 rechts = 17.
  Check("costThrough"c, GridPathCost(cells, w, h, 0, 0, 7, 0, false), 15.0);
  var cn: int64 := GridAStar(cells, w, h, 0, 0, 7, 0, false, px, py, 64);
  CheckB("costPathValid"c,
         PathValid(cells, w, h, px, py, cn, 0, 0, 7, 0, false), true);
  Check("costPathCost"c, WalkCost(cells, w, h, px, py, cn), 15.0);

  // Sumpf teurer als der Umweg: Kosten 20 -> 6 + 20 = 26 > 17.
  y := 0;
  while (y < 5) {
    GridSet(cells, 4, y, w, 20);
    y := y + 1;
  }
  Check("costAround"c, GridPathCost(cells, w, h, 0, 0, 7, 0, false), 17.0);
  GridFill(cells, w, h, 1);

  // ── Zulaessigkeit der Heuristik, direkt gemessen ───────────────────────────
  //
  // Wahre Restkosten zu (0,0) aus Dijkstra, dann fuer jede Zelle mit der
  // Heuristik verglichen. Oktil darf nie darueber liegen; Manhattan tut es
  // bei acht Richtungen sehr wohl — und genau das wird hier festgehalten,
  // damit niemand es "vereinfacht".
  GridDijkstra(cells, w, h, 0, 0, true, dd, 0);
  var octBad: int64 := 0;
  var manBad: int64 := 0;
  var chebBad: int64 := 0;
  var i: int64 := 0;
  while (i < n) {
    var tx: int64 := GridX(i, w);
    var ty: int64 := GridY(i, w);
    var truth: f64 := peekf64(dd + i * 8);
    if (truth >= 0.0) {
      var eps: f64 := 0.000000001;
      var ho: f64 := GridOctile(tx, ty, 0, 0);
      if (ho > truth + eps) { octBad := octBad + 1; }
      var hm: f64 := GridManhattan(tx, ty, 0, 0) as f64;
      if (hm > truth + eps) { manBad := manBad + 1; }
      var hc: f64 := GridChebyshev(tx, ty, 0, 0) as f64;
      if (hc > truth + eps) { chebBad := chebBad + 1; }
    }
    i := i + 1;
  }
  CheckI("octileAdmissible8"c, octBad, 0);
  CheckI("chebAdmissible8"c, chebBad, 0);
  // Manhattan ueberschaetzt bei 8 Richtungen: alle Zellen mit dx>0 UND dy>0.
  // Bei 8x6 sind das 7*5 = 35.
  CheckI("manhattanInadmissible8"c, manBad, 35);

  // Bei vier Richtungen ist Manhattan dagegen exakt und damit zulaessig.
  GridDijkstra(cells, w, h, 0, 0, false, dd, 0);
  manBad := 0;
  i := 0;
  while (i < n) {
    var tx: int64 := GridX(i, w);
    var ty: int64 := GridY(i, w);
    var truth: f64 := peekf64(dd + i * 8);
    if (truth >= 0.0) {
      var hm: f64 := GridManhattan(tx, ty, 0, 0) as f64;
      if (hm > truth + 0.000000001) { manBad := manBad + 1; }
    }
    i := i + 1;
  }
  CheckI("manhattanAdmissible4"c, manBad, 0);

  // ── A* == Dijkstra ueber viele Ziele ───────────────────────────────────────
  // Zufaellige Mauern, dann fuer jede Zelle: A*-Pfadkosten gegen die
  // Dijkstra-Karte. Beides muss uebereinstimmen, sonst ist die Heuristik
  // unzulaessig oder der Haufen kaputt.
  GridFill(cells, w, h, 1);
  GridSet(cells, 1, 1, w, 0);  GridSet(cells, 1, 2, w, 0);  GridSet(cells, 1, 3, w, 0);
  GridSet(cells, 3, 0, w, 0);  GridSet(cells, 3, 1, w, 0);  GridSet(cells, 5, 3, w, 0);
  GridSet(cells, 5, 4, w, 0);  GridSet(cells, 5, 5, w, 0);  GridSet(cells, 6, 2, w, 0);
  GridSet(cells, 2, 5, w, 7);  GridSet(cells, 3, 5, w, 7);  GridSet(cells, 6, 4, w, 3);

  var d4: int64 := 0;
  var d8: int64 := 0;
  var bad: int64 := 0;
  var badPath: int64 := 0;
  var badBfs: int64 := 0;
  while (d4 < 2) {
    var dg: bool := d4 == 1;
    GridDijkstra(cells, w, h, 0, 0, dg, dd, 0);
    GridBfs(cells, w, h, 0, 0, dg, dist);
    i := 0;
    while (i < n) {
      var tx: int64 := GridX(i, w);
      var ty: int64 := GridY(i, w);
      var truth: f64 := peekf64(dd + i * 8);
      var steps: int64 := peek64(dist + i * 8);

      // BFS und Dijkstra muessen sich darueber einig sein, WAS erreichbar ist.
      var rOk: bool := truth >= 0.0;
      var bOk: bool := steps >= 0;
      if (rOk != bOk) { badBfs := badBfs + 1; }

      var got: f64 := GridPathCost(cells, w, h, 0, 0, tx, ty, dg);
      if (AbsF64(got - truth) > 0.000000001) { bad := bad + 1; }

      var k: int64 := GridAStar(cells, w, h, 0, 0, tx, ty, dg, px, py, 64);
      if (rOk) {
        if (k < 1) { badPath := badPath + 1; }
        else {
          if (!PathValid(cells, w, h, px, py, k, 0, 0, tx, ty, dg)) {
            badPath := badPath + 1;
          }
          if (AbsF64(WalkCost(cells, w, h, px, py, k) - truth) > 0.000000001) {
            badPath := badPath + 1;
          }
          // Schrittzahl des Pfades darf die BFS-Schrittzahl nicht
          // unterschreiten — BFS ist die Untergrenze in Schritten.
          if (k - 1 < steps) { badPath := badPath + 1; }
        }
      }
      else {
        if (k != 0 - 1) { badPath := badPath + 1; }
      }
      i := i + 1;
    }
    d4 := d4 + 1;
  }
  CheckI("aStarEqDijkstra"c, bad, 0);
  CheckI("aStarPathsSound"c, badPath, 0);
  CheckI("bfsAgreesDijkstra"c, badBfs, 0);

  // Negativkontrolle: die Pruefung oben muss anschlagen, wenn der Pfad
  // absichtlich verbogen wird. Sonst prueft sie nichts.
  GridFill(cells, w, h, 1);
  var nn: int64 := GridAStar(cells, w, h, 0, 0, 5, 0, false, px, py, 64);
  CheckI("negCtrlLen"c, nn, 6);
  CheckB("negCtrlValid"c,
         PathValid(cells, w, h, px, py, nn, 0, 0, 5, 0, false), true);
  poke64(px + 16, 9);   // Sprung in die Wildnis
  CheckB("negCtrlCatches"c,
         PathValid(cells, w, h, px, py, nn, 0, 0, 5, 0, false), false);

  free(cells, n * 8);  free(dist, n * 8);  free(dd, n * 8);  free(pp, n * 8);
  free(nx, 8 * 8);  free(ny, 8 * 8);  free(px, 64 * 8);  free(py, 64 * 8);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
