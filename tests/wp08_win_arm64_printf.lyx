// WP-08: Windows ARM64 — printf via wsprintfA
// Tests PrintFloat on Windows ARM64 (wab_printf helper: int decomposition).
// USER32.DLL + wsprintfA are added to the PE import table.
// The wab_printf helper formats f64 as "int.frac" using wab_printint + wab_printstr.
//
// Expected output (one float per line):
//   3.141      (3.14159... integer=3, frac=141)
//   0.0        (0.0       integer=0, frac=0)
//   1.500      (1.5       integer=1, frac=500)
//   PASS
import std.io;

fn main(): int64 {
  var ok: int64 := 1;

  // 3.14159: integer=3, frac ~= 141
  PrintFloat(3.14159 as f64);
  PrintLn("");

  // 0.0: integer=0, frac=0
  PrintFloat(0.0 as f64);
  PrintLn("");

  // 1.5: integer=1, frac=500
  PrintFloat(1.5 as f64);
  PrintLn("");

  if ok == 0 {
    PrintLn("FAIL");
    return 1;
  }
  PrintLn("PASS");
  return 0;
}
