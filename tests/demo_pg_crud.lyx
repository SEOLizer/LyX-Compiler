// demo_pg_crud.lyx — WP-PG-12 Demo 1: CRUD-Grundlagen
//
// Legt eine Produkttabelle an, fügt 5 Zeilen ein, zeigt sie an,
// aktualisiert eine Zeile und löscht eine weitere.

import std.db.postgres;
import std.alloc;

fn connect(): int64 {
  var probe: int64 := pgProbe("127.0.0.1"c, 5432, "postgres"c, "postgres"c);
  if (probe == 0) { PrintLn("SKIP: PostgreSQL not available"); return 0; }
  var conn: int64 := PGConnect("127.0.0.1"c, 5432, "postgres"c, ""c, "postgres"c);
  if (conn == 0) { PrintLn("SKIP: TCP error"); return 0; }
  if (PGIsConnected(conn) == 0) {
    if (PGErrno(conn) == PG_ERR_PROTO) { PrintLn("SKIP: unsupported auth (need trust/md5)"); }
    else { PrintLn("SKIP: not connected"); }
    PGClose(conn); return 0;
  }
  return conn;
}

pub fn main(): int64 {
  var conn: int64 := connect();
  if (conn == 0) { return 0; }

  // Setup
  var r0: int64 := PGQuery(conn, "DROP TABLE IF EXISTS pg_demo_products"c);
  if (r0 != 0) { PGFreeResult(r0); }
  var r1: int64 := PGQuery(conn,
    "CREATE TABLE pg_demo_products (id SERIAL PRIMARY KEY, name TEXT, price FLOAT8)"c);
  if (r1 == 0) { PrintLn("FAIL: CREATE TABLE"); PGClose(conn); return 1; }
  PGFreeResult(r1);

  // INSERT 5 Rows via prepared statement
  var ins: int64 := PGStmtPrepare(conn, "ins_prod"c,
    "INSERT INTO pg_demo_products (name, price) VALUES ($1, $2)"c);
  if (ins == 0) { PrintLn("FAIL: prepare"); PGClose(conn); return 1; }

  var names: int64 := alloc(5 * 8);
  poke64(names,      "Apple"c as int64);
  poke64(names + 8,  "Banana"c as int64);
  poke64(names + 16, "Cherry"c as int64);
  poke64(names + 24, "Date"c as int64);
  poke64(names + 32, "Elderberry"c as int64);

  var prices: f64 := 1 as f64;  // placeholder
  var i: int64 := 0;
  while (i < 5) {
    PGStmtReset(ins);
    PGBindStr(ins, 0, peek64(names + i * 8) as pchar);
    PGBindFloat(ins, 1, (i + 1) as f64 * (1.99 as f64));
    var ri: int64 := PGStmtExecute(conn, ins);
    if (ri == 0) { PrintLn("FAIL: insert"); free(names, 40); PGStmtFree(ins); PGClose(conn); return 1; }
    PGFreeResult(ri);
    i := i + 1;
  }
  free(names, 40);
  PGStmtClose(conn, "ins_prod"c);
  PGStmtFree(ins);
  PrintLn("INSERT: 5 products");

  // SELECT all
  var rSel: int64 := PGQuery(conn,
    "SELECT id, name, price FROM pg_demo_products ORDER BY id"c);
  if (rSel == 0) { PrintLn("FAIL: SELECT"); PGClose(conn); return 1; }
  PrintLn("SELECT:");
  while (PGFetchRow(rSel) != 0) {
    Print("  id="); Print(StrFromInt(PGGetInt(rSel, 0)));
    Print(" name="); Print(PGGetStr(rSel, 1));
    Print(" price="); PrintFloat(PGGetFloat(rSel, 2)); PrintLn("");
  }
  PGFreeResult(rSel);

  // UPDATE id=3
  var rUpd: int64 := PGQuery(conn,
    "UPDATE pg_demo_products SET price=0.99 WHERE id=3"c);
  if (rUpd == 0) { PrintLn("FAIL: UPDATE"); PGClose(conn); return 1; }
  PGFreeResult(rUpd);
  Print("UPDATE: id=3 price->0.99 (changed="); Print(StrFromInt(PGChanges(conn))); PrintLn(")");

  // DELETE id=5
  var rDel: int64 := PGQuery(conn,
    "DELETE FROM pg_demo_products WHERE id=5"c);
  if (rDel == 0) { PrintLn("FAIL: DELETE"); PGClose(conn); return 1; }
  PGFreeResult(rDel);
  Print("DELETE: id=5 (changed="); Print(StrFromInt(PGChanges(conn))); PrintLn(")");

  // Final SELECT
  var rFin: int64 := PGQuery(conn,
    "SELECT id, name, price FROM pg_demo_products ORDER BY id"c);
  if (rFin == 0) { PrintLn("FAIL: final SELECT"); PGClose(conn); return 1; }
  Print("Final rows ("); Print(StrFromInt(PGNumRows(rFin))); PrintLn("):");
  while (PGFetchRow(rFin) != 0) {
    Print("  id="); Print(StrFromInt(PGGetInt(rFin, 0)));
    Print(" name="); Print(PGGetStr(rFin, 1));
    Print(" price="); PrintFloat(PGGetFloat(rFin, 2)); PrintLn("");
  }
  PGFreeResult(rFin);

  // Cleanup
  var rDrop: int64 := PGQuery(conn, "DROP TABLE pg_demo_products"c);
  if (rDrop != 0) { PGFreeResult(rDrop); }
  PGClose(conn);
  PrintLn("OK");
  return 0;
}
