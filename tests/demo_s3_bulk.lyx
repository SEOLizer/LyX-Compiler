// tests/demo_s3_bulk.lyx — S3 Demo: 100 objects upload + DeleteObjects (bulk delete)
// WP-S3-10

unit tests.demo_s3_bulk;

import std.cloud.aws.core;
import std.cloud.s3;
import std.io;
import std.alloc;

fn itoa(n: int64, buf: int64): pchar {
    if (n == 0) { poke8(buf, 48); poke8(buf+1, 0); return buf as pchar; }
    var tmp: int64 := alloc(24); var i: int64 := 0; var v: int64 := n;
    while (v > 0) { poke8(tmp+i, 48+(v%10)); v:=v/10; i:=i+1; }
    var j: int64 := 0;
    while (j < i) { poke8(buf+j, peek8(tmp+(i-1-j))); j:=j+1; }
    poke8(buf+i, 0); free(tmp, 24); return buf as pchar;
}

fn appendStr(buf: int64, off: int64, s: pchar): int64 {
    var n: int64 := StrLen(s); var i: int64 := 0;
    while(i<n){poke8(buf+off+i, StrCharAt(s,i)&0xFF);i:=i+1;}
    return off+n;
}

fn strDup(s: pchar): int64 {
    var n: int64 := StrLen(s); var buf: int64 := alloc(n+1);
    var i: int64 := 0;
    while(i<n){poke8(buf+i, StrCharAt(s,i)&0xFF);i:=i+1;}
    poke8(buf+n,0); return buf;
}

pub fn main(argc: int64, argv: int64): int64 {
    PrintLn("=== S3 Demo: Bulk Upload + DeleteObjects ==="c);

    var creds: AWSCreds := AWSCredentialsFromEnv();
    if (creds.accessKey == 0) {
        PrintLn("Error: set AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY"c); return 1;
    }
    var region: pchar := AWSRegionFromEnv("us-east-1"c);
    var client: S3Client := S3Connect(creds, region);

    var bucket: pchar := "lyx-bulk-demo"c;
    S3BucketCreate(client, bucket);

    var total: int64 := 100;
    var keyPtrs: int64 := alloc(total * 8);
    var keyBuf: int64 := alloc(64);

    // Upload 100 objects
    Print("Uploading "c);
    var tbuf: int64 := alloc(24); itoa(total, tbuf); Print(tbuf as pchar); free(tbuf, 24);
    PrintLn(" objects..."c);
    var data: pchar := "bulk-data"c;
    var dl: int64 := StrLen(data);
    var i: int64 := 0;
    while (i < total) {
        var off: int64 := appendStr(keyBuf, 0, "item/"c);
        var nbuf: int64 := alloc(16); itoa(i, nbuf);
        off := appendStr(keyBuf, off, nbuf as pchar); free(nbuf, 16);
        off := appendStr(keyBuf, off, ".bin"c);
        poke8(keyBuf+off, 0);
        poke64(keyPtrs + i*8, strDup(keyBuf as pchar));
        S3PutObject(client, bucket, keyBuf as pchar, data as int64, dl, "application/octet-stream"c);
        i := i + 1;
    }
    free(keyBuf, 64);

    // Verify count
    var lst: int64 := S3ListAll(client, bucket, ""c);
    var count: int64 := 0;
    if (lst != 0) { count := S3ListCount(lst); S3ListFree(lst); }
    Print("Listed object count: "c);
    var cbuf: int64 := alloc(24); itoa(count, cbuf); PrintLn(cbuf as pchar); free(cbuf, 24);

    // Bulk delete all 100 in one request
    Print("Bulk deleting "c);
    var db2: int64 := alloc(24); itoa(total, db2); Print(db2 as pchar); free(db2, 24);
    Print(" objects via S3DeleteObjects..."c);
    var delOk: int64 := S3DeleteObjects(client, bucket, keyPtrs, total);
    if (delOk == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }

    // Free key strings
    i := 0;
    while (i < total) {
        var k: int64 := peek64(keyPtrs + i*8);
        if (k != 0) { free(k, StrLen(k as pchar)+1); }
        i := i + 1;
    }
    free(keyPtrs, total*8);

    // Verify empty
    var lst2: int64 := S3ListAll(client, bucket, ""c);
    var count2: int64 := 0;
    if (lst2 != 0) { count2 := S3ListCount(lst2); S3ListFree(lst2); }
    Print("Objects remaining after delete: "c);
    var rb: int64 := alloc(24); itoa(count2, rb); PrintLn(rb as pchar); free(rb, 24);

    S3BucketDelete(client, bucket);
    S3Close(client);
    PrintLn("Done."c);
    return 0;
}
