// tests/pdf_basic_test.lyx
// WP-PDF-01 + WP-PDF-02: minimal PDF creation test

import std.pdf;
import std.io;

pub fn main(): int64 {
  // WP-PDF-01: empty document
  var doc: int64 := PdfNew();
  if (doc == 0) {
    PrintStr("FAIL: PdfNew returned 0\n");
    return 1;
  }

  var r: int64 := PdfSave(doc, "/tmp/pdf_empty.pdf");
  if (r != 0) {
    PrintStr("FAIL: PdfSave (empty) returned ");
    PrintInt(r);
    PrintStr("\n");
    PdfFree(doc);
    return 1;
  }
  PrintStr("OK: empty PDF saved to /tmp/pdf_empty.pdf\n");
  PdfFree(doc);

  // WP-PDF-02: document with 3 pages
  doc := PdfNew();
  if (doc == 0) {
    PrintStr("FAIL: PdfNew returned 0\n");
    return 1;
  }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p2: int64 := PdfAddPage(doc, PDF_LETTER_W, PDF_LETTER_H);

  if (p0 != 0 || p1 != 1 || p2 != 2) {
    PrintStr("FAIL: page handles wrong: ");
    PrintInt(p0); PrintStr(" ");
    PrintInt(p1); PrintStr(" ");
    PrintInt(p2); PrintStr("\n");
    PdfFree(doc);
    return 1;
  }

  if (PdfPageCount(doc) != 3) {
    PrintStr("FAIL: PdfPageCount != 3\n");
    PdfFree(doc);
    return 1;
  }

  r := PdfSave(doc, "/tmp/pdf_3pages.pdf");
  if (r != 0) {
    PrintStr("FAIL: PdfSave (3 pages) returned ");
    PrintInt(r);
    PrintStr("\n");
    PdfFree(doc);
    return 1;
  }
  PrintStr("OK: 3-page PDF saved to /tmp/pdf_3pages.pdf\n");
  PdfFree(doc);

  PrintStr("All PDF tests passed.\n");
  return 0;
}
