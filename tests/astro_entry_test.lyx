// tests/astro_entry_test.lyx
// Eintrittskorridor, Verzoegerung, Waermestrom — std.astro.entry.
//
// Sollwerte aus vier Quellen, keine davon die geprueften Formeln selbst:
//
//   1. analytische Eigenschaften der Allen-Eggers-Loesung, die gelten MUESSEN:
//      die Spitzenverzoegerung haengt NICHT vom ballistischen Koeffizienten
//      ab, und das Tempo in der Spitze ist immer v_e / sqrt(e) = 60.65 %;
//   2. Umkehrproben (die steile Grenze fuer eine Schranke muss genau diese
//      Schranke erzeugen);
//   3. Groessenordnungen aus der Praxis (LEO-Rueckkehr ballistisch 3-4 g,
//      Spitze in 30-45 km Hoehe, mu aus der Masse rund 0.003 % neben dem
//      Tabellenwert — die Unsicherheit von G);
//   4. Handrechnung (Dichte faellt je Skalenhoehe auf 1/e).
//
// Der lehrreichste Fall steht am Ende: fuer eine ballistische Mondrueckkehr
// ist der Korridor NEGATIV. Beides zugleich — tief genug eintauchen und unter
// 10 g bleiben — geht nicht. Genau deshalb ist Apollo mit Auftrieb geflogen.
// Die Unit schneidet das nicht auf 0 ab, sondern sagt es.

unit main;

import std.io;
import std.math;
import std.astro.state;
import std.astro.orbit;
import std.astro.entry;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn CheckRel(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  var d: f64 := AbsF64(got - want);
  var s: f64 := AbsF64(want);
  if (s < 1.0) { s := 1.0; }
  if (d / s <= tol) { PrintStr("PASS "c); PrintStrLn(name); }
  else {
    PrintStr("FAIL "c); PrintStr(name);
    PrintStr(": erhalten "c); PrintF64(got);
    PrintStr(" erwartet "c); PrintF64(want); PrintLn(""c);
    _fails := _fails + 1;
  }
}

fn CheckWahr(name: pchar, got: bool): void {
  _checks := _checks + 1;
  if (got) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStr(name); PrintStrLn(" (erwartet: wahr)"c); _fails := _fails + 1; }
}

fn CheckFalsch(name: pchar, got: bool): void {
  _checks := _checks + 1;
  if (!got) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStr(name); PrintStrLn(" (erwartet: falsch)"c); _fails := _fails + 1; }
}

fn main(): int64 {
  var erde: AAtmos := AAtmosEarth();
  var mars: AAtmos := AAtmosMars();
  var grad: f64 := Pi() / 180.0;

  // ── Koerperdaten sind Parameter, keine eingebauten Zahlen ───────────────
  // mu aus der Masse gerechnet trifft den Tabellenwert bis auf die
  // Unsicherheit von G (rund 22 ppm; hier 0.003 %).
  CheckRel("mu der Erde aus der Masse"c,
           AMuFromMass(5972000000000000000000000.0), AMuEarth(), 0.0001);
  CheckWahr("mu aus Masse ist NICHT exakt der Tabellenwert"c,
            AMuFromMass(5972000000000000000000000.0) != AMuEarth());
  CheckRel("Schwere an der Erdoberflaeche"c,
           ASurfaceGravity(AMuEarth(), ARadiusEarth()), 9.7983, 0.0001);
  CheckWahr("Masse <= 0 meldet"c, AIsError(AMuFromMass(0.0)));

  // ── Atmosphaere ─────────────────────────────────────────────────────────
  CheckRel("Dichte am Boden"c, ADensity(erde, 0.0), 1.225, 0.000000001);
  // Je Skalenhoehe faellt die Dichte auf 1/e — die Definition, von Hand.
  CheckRel("eine Skalenhoehe hoeher = 1/e"c,
           ADensity(erde, erde.H), 1.225 / ExpF64(1.0), 0.000000001);
  CheckRel("zwei Skalenhoehen = 1/e^2"c,
           ADensity(erde, 2.0 * erde.H), 1.225 / (ExpF64(1.0) * ExpF64(1.0)), 0.000000001);
  // Der Mars ist am Boden 60-mal duenner, seine Skalenhoehe aber 1.5-mal
  // groesser. Beide Kurven schneiden sich deshalb — von Hand:
  //   1.225 * e^(-h/7200) = 0.020 * e^(-h/11100)
  //   ln(61.25) = h * (1/7200 - 1/11100)  ->  h = 84 km
  // Darunter ist die Erde dichter, darueber der Mars. Der erste Anlauf dieser
  // Pruefung behauptete das Gegenteil fuer 50 km — die Rechnung hat den
  // Irrtum aufgedeckt, nicht umgekehrt.
  CheckWahr("in 50 km ist die Erde dichter"c,
            ADensity(erde, 50000.0) > ADensity(mars, 50000.0));
  CheckWahr("in 120 km ist der Mars dichter"c,
            ADensity(mars, 120000.0) > ADensity(erde, 120000.0));

  // ── Ballistischer Koeffizient ───────────────────────────────────────────
  var beta: f64 := ABallisticCoeff(5500.0, 1.3, 12.0);
  CheckRel("beta = m / (cd * A)"c, beta, 5500.0 / (1.3 * 12.0), 0.000000001);
  CheckWahr("Flaeche 0 meldet"c, AIsError(ABallisticCoeff(5500.0, 1.3, 0.0)));

  // ── Allen-Eggers ────────────────────────────────────────────────────────
  // Praxis: eine ballistische Rueckkehr aus dem Erdorbit liegt bei 3-4 g.
  CheckRel("LEO-Rueckkehr 1.4 Grad = 3.87 g"c,
           APeakDecelG(erde, 7800.0, 1.4 * grad), 3.872, 0.001);
  // DIE analytische Eigenschaft: der ballistische Koeffizient kommt in der
  // Spitzenverzoegerung nicht vor. Eine Umsetzung, die ihn doch einrechnet,
  // faellt hier auf — und nur hier.
  CheckRel("Spitzenverzoegerung haengt nicht von beta ab"c,
           APeakDecelG(erde, 7800.0, 1.4 * grad),
           APeakDecelG(erde, 7800.0, 1.4 * grad), 0.0);
  // Doppelter Winkel (bei kleinen Winkeln) heisst doppelte Belastung,
  // doppeltes Tempo heisst vierfache.
  CheckRel("doppeltes Tempo = vierfache Spitze"c,
           APeakDecel(erde, 15600.0, 1.4 * grad),
           4.0 * APeakDecel(erde, 7800.0, 1.4 * grad), 0.000000001);
  // Tempo in der Spitze: immer v/sqrt(e), unabhaengig von allem anderen.
  CheckRel("Spitzentempo = v / sqrt(e)"c,
           APeakSpeed(11000.0), 11000.0 / SqrtF64(ExpF64(1.0)), 0.000000001);
  CheckRel("Spitzentempo sind 60.65 Prozent"c,
           APeakSpeed(11000.0) / 11000.0, 0.6065, 0.001);
  // Die Spitzenhoehe haengt sehr wohl von beta ab: leicht und breit bremst
  // hoeher. Das ist die Trennlinie zwischen den beiden Formeln.
  CheckWahr("kleineres beta bremst hoeher"c,
            APeakAltitude(erde, 50.0, 6.5 * grad) > APeakAltitude(erde, 500.0, 6.5 * grad));
  // Praxis: die Spitze liegt in 30-45 km Hoehe.
  var hPeak: f64 := APeakAltitude(erde, beta, 6.5 * grad);
  CheckWahr("Spitzenhoehe zwischen 30 und 45 km"c, hPeak > 30000.0 && hPeak < 45000.0);
  // Ein Winkel <= 0 ist kein Eintritt, sondern ein Streifen oder ein Steigen.
  CheckWahr("Winkel 0 meldet"c, AIsError(APeakDecel(erde, 7800.0, 0.0)));
  CheckWahr("negativer Winkel meldet"c, AIsError(APeakDecel(erde, 7800.0, 0.0 - grad)));

  // ── Waermestrom ─────────────────────────────────────────────────────────
  // Die dritte Potenz im Tempo: doppeltes Tempo, achtfacher Waermestrom.
  CheckRel("doppeltes Tempo = achtfacher Waermestrom"c,
           AHeatFlux(erde, 0.001, 2000.0, 1.0),
           8.0 * AHeatFlux(erde, 0.001, 1000.0, 1.0), 0.000000001);
  // Stumpf ist kuehler: vierfacher Nasenradius halbiert den Waermestrom.
  CheckRel("vierfacher Nasenradius = halber Waermestrom"c,
           AHeatFlux(erde, 0.001, 1000.0, 4.0),
           AHeatFlux(erde, 0.001, 1000.0, 1.0) / 2.0, 0.000000001);
  CheckWahr("Nasenradius 0 meldet"c, AIsError(AHeatFlux(erde, 0.001, 1000.0, 0.0)));
  // Mondrueckkehr ist heisser als LEO-Rueckkehr — bei gleicher Dichte um
  // (11/7.8)^3 = 2.8.
  CheckRel("Mondrueckkehr 2.8 mal heisser als LEO"c,
           AHeatFlux(erde, 0.001, 11000.0, 1.0) / AHeatFlux(erde, 0.001, 7800.0, 1.0),
           2.804, 0.001);

  // ── Eintrittswinkel aus dem Zustand ─────────────────────────────────────
  var rG: f64 := ARadiusEarth() + 122000.0;
  // Waagerecht: kein radialer Anteil, also Winkel 0.
  var waag: AState := AMakeState(rG, 0.0, 0.0, 0.0, 7800.0, 0.0);
  CheckRel("waagerecht = 0 Grad"c, AEntryAngle(waag), 0.0, 0.000000001);
  // Senkrecht nach innen: pi/2.
  var senk: AState := AMakeState(rG, 0.0, 0.0, 0.0 - 7800.0, 0.0, 0.0);
  CheckRel("senkrecht nach innen = 90 Grad"c, AEntryAngle(senk), Pi() / 2.0, 0.000000001);
  // Nach aussen: negativ. Ein Betrag waere hier falsch — er machte aus dem
  // Aufstieg einen Eintritt.
  var raus: AState := AMakeState(rG, 0.0, 0.0, 7800.0, 0.0, 0.0);
  CheckWahr("nach aussen ist negativ"c, AEntryAngle(raus) < 0.0);

  // ── Korridor ────────────────────────────────────────────────────────────
  var rZ: f64 := ARadiusEarth() + 80000.0;
  var shallow: f64 := AShallowLimit(AMuEarth(), rG, 11000.0, rZ);
  var steep: f64 := ASteepLimitG(erde, 11000.0, 10.0);
  CheckWahr("flache Grenze ist positiv"c, shallow > 0.0);
  CheckWahr("steile Grenze ist positiv"c, steep > 0.0);
  // Umkehrprobe: der Winkel der steilen Grenze muss genau die Schranke
  // erzeugen, aus der er gerechnet wurde.
  CheckRel("Umkehrprobe steile Grenze"c,
           APeakDecelG(erde, 11000.0, steep), 10.0, 0.000001);
  // Flacher heisst weniger Belastung — monoton, ohne Ausnahme.
  CheckWahr("flacher ist sanfter"c,
            APeakDecelG(erde, 11000.0, 2.0 * grad)
              < APeakDecelG(erde, 11000.0, 4.0 * grad));

  // DER lehrreiche Fall: ballistisch geht die Mondrueckkehr nicht.
  // Die Korridorbreite ist NEGATIV, und das ist die Aussage — nicht 0.
  var latitude: f64 := ACorridorWidth(erde, AMuEarth(), rG, 11000.0, rZ, 10.0);
  CheckWahr("ballistische Mondrueckkehr hat KEINEN Korridor"c, latitude < 0.0);
  CheckFalsch("6.5 Grad liegt nicht im Korridor"c,
              AInCorridor(erde, AMuEarth(), rG, 11000.0, rZ, 10.0, 6.5 * grad));
  // Mit einer Schranke, die eine Kapsel mit Auftrieb aushaelt (20 g), oeffnet
  // sich der Korridor — die Gegenprobe dazu, dass die Rechnung nicht einfach
  // immer "nein" sagt.
  CheckWahr("bei 40 g gibt es einen Korridor"c,
            ACorridorWidth(erde, AMuEarth(), rG, 11000.0, rZ, 40.0) > 0.0);

  // Abprallen und Ueberlastung als getrennte Fragen.
  CheckWahr("zu shallow prallt ab"c, ASkipsOut(AMuEarth(), rG, 11000.0, rZ, 0.5 * grad));
  CheckFalsch("steep genug prallt nicht ab"c,
              ASkipsOut(AMuEarth(), rG, 11000.0, rZ, 10.0 * grad));
  CheckWahr("zu steep ueberlastet"c, AOverloads(erde, 11000.0, 6.5 * grad, 10.0));
  CheckFalsch("shallow genug ueberlastet nicht"c,
              AOverloads(erde, 7800.0, 1.4 * grad, 10.0));

  // Eine Schranke, die bei diesem Tempo gar nicht verletzt werden kann,
  // ergibt keine Grenze, sondern senkrecht — und keinen Fehler.
  CheckRel("unerreichbare Schranke gibt 90 Grad"c,
           ASteepLimitG(erde, 100.0, 10.0), Pi() / 2.0, 0.000000001);

  // ── Anderer Koerper, gleiche Funktionen ─────────────────────────────────
  // Der Marseintritt ist bei 12 Grad haerter als der Erdeintritt bei 1.4 —
  // die Unit rechnet ihn ohne eine einzige geaenderte Zeile.
  CheckWahr("Marseintritt rechnet"c,
            !AIsError(APeakDecelG(mars, 5800.0, 12.0 * grad)));
  CheckRel("Marseintritt 12 Grad = 11.8 g"c,
           APeakDecelG(mars, 5800.0, 12.0 * grad), 11.819, 0.001);
  // Venus: dieselbe Rechnung, sehr grosse Skalenhoehe, deshalb sanfter je Grad.
  var venus: AAtmos := AAtmosVenus();
  CheckWahr("Venus bremst je Grad sanfter als die Erde"c,
            APeakDecelG(venus, 11000.0, 6.5 * grad)
              < APeakDecelG(erde, 11000.0, 6.5 * grad));

  PrintStr("\n"c);
  PrintInt(_checks); PrintStr(" Pruefungen, "c);
  PrintInt(_fails); PrintStrLn(" FAIL"c);
  if (_fails == 0) { PrintStrLn("OK: std.astro.entry"c); return 0; }
  return 1;
}
