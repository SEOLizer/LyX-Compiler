// tests/pdf_namedest_test.lyx
// WP-PDF-14: named destinations

@description("WP-PDF-14: PDF named destination tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pdf_namedest_test;

import std.pdf;

fn testNamedDestBasic(): int64 {
  // Three pages, each with a named destination
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p2: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Introduction");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Chapter 1");
  PdfSetFont(doc, p2, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p2, 72.0, 750.0, "Appendix");

  var r0: int64 := PdfAddNamedDest(doc, "intro",    0);
  var r1: int64 := PdfAddNamedDest(doc, "chapter1", 1);
  var r2: int64 := PdfAddNamedDest(doc, "appendix", 2);
  if (r0 != 0 || r1 != 0 || r2 != 0) {
    Print("FAIL: PdfAddNamedDest\n");
    PdfFree(doc);
    return 1;
  }

  var err: int64 := PdfSave(doc, "/tmp/pdf_namedest_basic.pdf");
  PdfFree(doc);
  if (err != 0) {
    Print("FAIL: PdfSave (basic) err=");
    PrintInt(err);
    Print("\n");
    return 1;
  }

  var rdr: int64 := PdfOpen("/tmp/pdf_namedest_basic.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (basic)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 3) {
    Print("FAIL: basic page count expected 3, got ");
    PrintInt(n);
    Print("\n");
    return 1;
  }
  Print("OK: three named destinations\n");
  return 0;
}

fn testNamedDestSingle(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (single)\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "Only page");

  PdfAddNamedDest(doc, "top", 0);

  var err: int64 := PdfSave(doc, "/tmp/pdf_namedest_single.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (single)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_namedest_single.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (single)\n"); return 1; }
  PdfClose(rdr);
  Print("OK: single named destination\n");
  return 0;
}

fn testNamedDestWithOutline(): int64 {
  // Named dests combined with outlines — Catalog has both /Outlines and /Names
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (outline)\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Section 1");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Section 2");

  PdfOutlineAdd(doc, -1, "Section 1", p0);
  PdfOutlineAdd(doc, -1, "Section 2", p1);
  PdfAddNamedDest(doc, "sec1", 0);
  PdfAddNamedDest(doc, "sec2", 1);

  var err: int64 := PdfSave(doc, "/tmp/pdf_namedest_outline.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (outline)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_namedest_outline.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (outline)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 2) { Print("FAIL: outline+namedest page count\n"); return 1; }
  Print("OK: named destinations with outline\n");
  return 0;
}

fn testNamedDestWithMeta(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (meta)\n"); return 1; }

  PdfSetTitle(doc, "Named Dest Test");
  PdfSetAuthor(doc, "Test Suite");

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Cover");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Content");

  PdfAddNamedDest(doc, "cover",   0);
  PdfAddNamedDest(doc, "content", 1);

  var err: int64 := PdfSave(doc, "/tmp/pdf_namedest_meta.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (meta)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_namedest_meta.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (meta)\n"); return 1; }
  var buf: int64 := mmap(0, 256, 3, 34, -1, 0);
  PdfRdrGetTitle(rdr, buf, 256);
  var ok: int64 := 1;
  if (peek8(buf) == 0) { ok := 0; }
  munmap(buf, 256);
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (ok == 0 || n != 2) {
    Print("FAIL: meta+namedest (titleOk=");
    PrintInt(ok);
    Print(" pages=");
    PrintInt(n);
    Print(")\n");
    return 1;
  }
  Print("OK: named destinations with metadata\n");
  return 0;
}

fn testNamedDestNoEntries(): int64 {
  // PDF without named dests: unchanged behavior
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (none)\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "No named dests");

  var err: int64 := PdfSave(doc, "/tmp/pdf_namedest_none.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (none)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_namedest_none.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (none)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 1) { Print("FAIL: no-entries page count\n"); return 1; }
  Print("OK: no named destinations — PDF unaffected\n");
  return 0;
}

pub fn main(): int64 {
  if (testNamedDestBasic()       != 0) { return 1; }
  if (testNamedDestSingle()      != 0) { return 1; }
  if (testNamedDestWithOutline() != 0) { return 1; }
  if (testNamedDestWithMeta()    != 0) { return 1; }
  if (testNamedDestNoEntries()   != 0) { return 1; }
  Print("All WP-PDF-14 named destination tests passed.\n");
  return 0;
}
