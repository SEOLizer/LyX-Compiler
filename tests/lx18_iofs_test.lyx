// LX-18 Test: IOFS Island & Ocean FS (0x0C00–0x0C04) — nur Kompilierung prüfen.

import src.std.lyxos.iofs;

fn main(): int64 {
    // sys_iofs_mount
    var mfd: int64 := sys_iofs_mount(0, 0 as pchar);

    // sys_iofs_compact
    var cp: int64 := sys_iofs_compact(mfd, -1);

    // sys_iofs_page_info
    sys_iofs_page_info(mfd, 0, 0 as pchar);

    // sys_iofs_sandbox_enter / sys_iofs_sandbox_exit
    sys_iofs_sandbox_enter(mfd);
    sys_iofs_sandbox_exit();

    return cp;
}
