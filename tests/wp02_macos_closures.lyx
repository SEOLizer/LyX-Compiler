// WP-02: macOS x86_64 — function composition / higher-order behavior
// Closures with upvalue capture require further compiler work (sema gap).
// This test confirms that the macOS x86_64 code path handles basic control
// flow, local variables, and function calls correctly.
import std.io;

fn factorial(n: int64): int64 {
  if (n <= 1) { return 1; }
  return n * factorial(n - 1);
}

fn fibonacci(n: int64): int64 {
  if (n <= 1) { return n; }
  return fibonacci(n - 1) + fibonacci(n - 2);
}

fn applyAndSum(a: int64, b: int64, c: int64): int64 {
  var fa: int64 := factorial(a);
  var fb: int64 := factorial(b);
  var fc: int64 := factorial(c);
  return fa + fb + fc;
}

fn main(): int64 {
  var f5: int64 := factorial(5);
  PrintInt(f5);
  PrintLn("");

  var fib8: int64 := fibonacci(8);
  PrintInt(fib8);
  PrintLn("");

  var total: int64 := applyAndSum(3, 4, 5);
  PrintInt(total);
  PrintLn("");

  return 0;
}
