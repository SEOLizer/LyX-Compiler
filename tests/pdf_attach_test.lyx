// tests/pdf_attach_test.lyx
// WP-PDF-15: embedded file attachments

@description("WP-PDF-15: PDF embedded file attachment tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pdf_attach_test;

import std.alloc;
import std.pdf;

fn testAttachSingle(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "See attached data.csv");

  // Build a small CSV payload in a mmap'd buffer
  var csvBuf: int64 := alloc(64);
  poke8(csvBuf +  0, 110); // n
  poke8(csvBuf +  1, 97);  // a
  poke8(csvBuf +  2, 109); // m
  poke8(csvBuf +  3, 101); // e
  poke8(csvBuf +  4, 44);  // ,
  poke8(csvBuf +  5, 118); // v
  poke8(csvBuf +  6, 97);  // a
  poke8(csvBuf +  7, 108); // l
  poke8(csvBuf +  8, 10);  // \n
  poke8(csvBuf +  9, 65);  // A
  poke8(csvBuf + 10, 44);  // ,
  poke8(csvBuf + 11, 49);  // 1
  poke8(csvBuf + 12, 10);  // \n

  var r: int64 := PdfAttachFile(doc, "data.csv", csvBuf, 13);
  free(csvBuf, 64);

  if (r != 0) {
    Print("FAIL: PdfAttachFile\n");
    PdfFree(doc);
    return 1;
  }

  var err: int64 := PdfSave(doc, "/tmp/pdf_attach_single.pdf");
  PdfFree(doc);
  if (err != 0) {
    Print("FAIL: PdfSave (single) err=");
    PrintInt(err);
    Print("\n");
    return 1;
  }

  var rdr: int64 := PdfOpen("/tmp/pdf_attach_single.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (single)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 1) {
    Print("FAIL: single page count expected 1, got ");
    PrintInt(n);
    Print("\n");
    return 1;
  }
  Print("OK: single file attachment\n");
  return 0;
}

fn testAttachMultiple(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (multi)\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Page 1 — see attachments");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Page 2");

  var buf1: int64 := alloc(16);
  poke8(buf1 + 0, 104); // h
  poke8(buf1 + 1, 101); // e
  poke8(buf1 + 2, 108); // l
  poke8(buf1 + 3, 108); // l
  poke8(buf1 + 4, 111); // o

  var buf2: int64 := alloc(16);
  poke8(buf2 + 0, 119); // w
  poke8(buf2 + 1, 111); // o
  poke8(buf2 + 2, 114); // r
  poke8(buf2 + 3, 108); // l
  poke8(buf2 + 4, 100); // d

  PdfAttachFile(doc, "hello.txt", buf1, 5);
  PdfAttachFile(doc, "world.txt", buf2, 5);
  free(buf1, 16);
  free(buf2, 16);

  var err: int64 := PdfSave(doc, "/tmp/pdf_attach_multi.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (multi)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_attach_multi.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (multi)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 2) { Print("FAIL: multi page count\n"); return 1; }
  Print("OK: two file attachments\n");
  return 0;
}

fn testAttachWithMeta(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (meta)\n"); return 1; }

  PdfSetTitle(doc, "Attachment+Meta Test");
  PdfSetAuthor(doc, "Test Suite");

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "With metadata and attachment");

  var dbuf: int64 := alloc(8);
  poke8(dbuf + 0, 100); // d
  poke8(dbuf + 1, 97);  // a
  poke8(dbuf + 2, 116); // t
  poke8(dbuf + 3, 97);  // a

  PdfAttachFile(doc, "meta.bin", dbuf, 4);
  free(dbuf, 8);

  var err: int64 := PdfSave(doc, "/tmp/pdf_attach_meta.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (meta)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_attach_meta.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (meta)\n"); return 1; }
  var tbuf: int64 := alloc(256);
  PdfRdrGetTitle(rdr, tbuf, 256);
  var ok: int64 := 1;
  if (peek8(tbuf) == 0) { ok := 0; }
  free(tbuf, 256);
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (ok == 0 || n != 1) {
    Print("FAIL: attach+meta (titleOk=");
    PrintInt(ok);
    Print(" pages=");
    PrintInt(n);
    Print(")\n");
    return 1;
  }
  Print("OK: attachment with metadata\n");
  return 0;
}

fn testAttachWithNamedDest(): int64 {
  // Attachment combined with named destinations — both in the same /Names dict
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (ndest)\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "First");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Second");

  PdfAddNamedDest(doc, "first",  0);
  PdfAddNamedDest(doc, "second", 1);

  var dbuf: int64 := alloc(8);
  poke8(dbuf + 0, 120); // x
  poke8(dbuf + 1, 121); // y
  poke8(dbuf + 2, 122); // z

  PdfAttachFile(doc, "notes.txt", dbuf, 3);
  free(dbuf, 8);

  var err: int64 := PdfSave(doc, "/tmp/pdf_attach_ndest.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (ndest)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_attach_ndest.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (ndest)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 2) { Print("FAIL: ndest page count\n"); return 1; }
  Print("OK: attachment with named destinations\n");
  return 0;
}

fn testAttachNoFiles(): int64 {
  // PDF without attachments: unchanged behavior
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (none)\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "No attachments");

  var err: int64 := PdfSave(doc, "/tmp/pdf_attach_none.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (none)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_attach_none.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (none)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 1) { Print("FAIL: no-attach page count\n"); return 1; }
  Print("OK: no attachments — PDF unaffected\n");
  return 0;
}

pub fn main(): int64 {
  if (testAttachSingle()       != 0) { return 1; }
  if (testAttachMultiple()     != 0) { return 1; }
  if (testAttachWithMeta()     != 0) { return 1; }
  if (testAttachWithNamedDest() != 0) { return 1; }
  if (testAttachNoFiles()      != 0) { return 1; }
  Print("All WP-PDF-15 attachment tests passed.\n");
  return 0;
}
