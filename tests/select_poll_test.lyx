// tests/select_poll_test.lyx — I/O-Multiplexing: Select und Poll.
//
// `std/net/syscalls.lyx` trug seit jeher "I/O multiplexing" in der Überschrift,
// hatte die beiden Wrapper aber nicht: acht Beispiele riefen `Select`/`Poll`
// ins Leere. `sys_poll` gab es als Builtin, `sys_select` gar nicht.
//
// Geprüft wird nicht nur, dass der Aufruf übersetzt, sondern dass der Syscall
// echte Ergebnisse liefert. Besonders wichtig beim 4. Argument: nach
// SysV-Aufrufkonvention steht es in rcx, die Syscall-Konvention erwartet es in
// r10. Ohne das Umladen bekäme der Kernel Müll als exceptfds und antwortete
// mit EFAULT statt mit einer Anzahl bereiter Deskriptoren.

import std.io;
import std.net.syscalls;
import std.alloc;
var fails: int64 := 0;
fn e(n: pchar, g: int64, w: int64) { Print(n); Print(": "); if (g == w) { PrintLn("OK"); } else { Print("FAIL "); PrintInt(g); PrintLn(""); fails += 1; } }
fn main(): int64 {
  // stdin (fd 0) ist in dieser Umgebung nicht lesbar -> Timeout, also 0 bereite fds.
  // timeval{sec=0, usec=0} = sofortiger Rueckkehr
  var tv: int64 := alloc(16); poke64(tv, 0); poke64(tv + 8, 0);
  var rfds: int64 := alloc(128); var i: int64 := 0;
  while (i < 128) { poke8(rfds + i, 0); i := i + 1; }
  var r: int64 := Select(0, rfds, 0, 0, tv);
  e("Select ohne fds -> 0", r, 0);

  // poll mit nfds=0 und timeout 0 -> 0
  var p: int64 := Poll(0, 0, 0);
  e("Poll nfds=0 -> 0", p, 0);

  // Select auf stdout (fd 1) schreibbar -> 1 bereit
  var wfds: int64 := alloc(128); i := 0;
  while (i < 128) { poke8(wfds + i, 0); i := i + 1; }
  poke8(wfds, 2);                      // Bit 1 = fd 1
  poke64(tv, 0); poke64(tv + 8, 0);
  var w: int64 := Select(2, 0, wfds, 0, tv);
  e("Select stdout schreibbar", w, 1);

  if (fails == 0) { PrintLn("ALL OK"); return 0; }
  return 1;
}
