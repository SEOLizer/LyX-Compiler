// LX-08 Test: alle 10 Netzwerk-Syscalls kompilieren + Syscall-Nummern prüfen.

import src.std.lyxos.fs;
import src.std.lyxos.net;
import src.std.alloc;

fn main(): int64 {
    // sys_socket: TCP-Socket erstellen
    var fd: int64 := sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if fd < 0 { return 1; }

    // sys_setsockopt: SO_REUSEADDR
    var optval: int64 := alloc(8);
    poke8(optval, 0, 1);
    sys_setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, optval as pchar, 4);

    // sys_getsockopt: SO_TYPE auslesen
    var typeval: int64 := alloc(8);
    var typelen: int64 := alloc(8);
    poke8(typelen, 0, 4);
    sys_getsockopt(fd, SOL_SOCKET, SO_TYPE, typeval as pchar, typelen as pchar);

    // sys_bind: an INADDR_ANY:0
    var addr: int64 := alloc(SOCK_ADDR_IN_SIZE);
    poke8(addr,     0, AF_INET);
    poke8(addr + 2, 0, 0);
    poke8(addr + 4, 0, 0);
    sys_bind(fd, addr as pchar, SOCK_ADDR_IN_SIZE);

    // sys_listen
    sys_listen(fd, 8);

    // sys_accept (nicht-blockierend wegen SOCK_NONBLOCK; Fehler ist ok)
    var clientfd: int64 := sys_accept(fd, 0 as pchar, 0 as pchar);

    // sys_connect auf sich selbst (ECONNREFUSED ist ok)
    var fd2: int64 := sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    sys_connect(fd2, addr as pchar, SOCK_ADDR_IN_SIZE);

    // sys_sendmsg (fd2 ist nicht verbunden, Fehler erwartet)
    var msghdr: int64 := alloc(56);
    sys_sendmsg(fd2, msghdr as pchar, MSG_NOSIGNAL);

    // sys_recvmsg
    sys_recvmsg(fd2, msghdr as pchar, MSG_DONTWAIT);

    // sys_shutdown
    sys_shutdown(fd, SHUT_RDWR);
    sys_shutdown(fd2, SHUT_RDWR);

    sys_close(fd);
    sys_close(fd2);

    return 0;
}
