// tests/graph_fuzz.lyx
// Erzeugt Zufallsgraphen mit festem LCG, gibt Kanten und Ergebnisse aus;
// tools/graph_ref.py rechnet mit heapq/deque unabhaengig nach.

unit main;

import std.graph;
import std.math;
import std.alloc;

var _s: int64 := 2463534242;

fn Rnd(m: int64): int64 {
  _s := (_s * 6364136223846793005 + 1442695040888963407) & 4611686018427387903;
  return (_s / 65536) % m;
}

fn P(v: int64): void { PrintInt(v); PrintStr(" "c); }

// f64 als gerundete Ganzzahl mal 1000
fn Q(x: f64): int64 {
  if (x < 0.0) { return 0 - 1; }
  var t: f64 := TruncF64(x * 1000.0 + 0.5);
  return t as int64;
}

fn main(): int64 {
  var t: int64 := 0;
  while (t < 120) {
    var n: int64 := 2 + Rnd(12);
    var directed: bool := (t % 2) == 0;
    var maxE: int64 := 40;
    var g: int64 := GphNew(n, maxE, directed);
    var ecount: int64 := 1 + Rnd(maxE - 1);

    PrintStr("G "c);
    P(t); P(n);
    var dd: int64 := 0;
    if (directed) { dd := 1; }
    P(dd); P(ecount);
    PrintStr("\n"c);

    var esrc: int64 := alloc(maxE * 8);
    var edst: int64 := alloc(maxE * 8);
    var ewt: int64 := alloc(maxE * 8);
    PrintStr("E "c);
    var k: int64 := 0;
    while (k < ecount) {
      var u: int64 := Rnd(n);
      var v: int64 := Rnd(n);
      var w: int64 := 1 + Rnd(50);
      GphAddEdge(g, u, v, w as f64);
      poke64(esrc + k * 8, u);
      poke64(edst + k * 8, v);
      poke64(ewt + k * 8, w);
      P(u); P(v); P(w);
      k := k + 1;
    }
    PrintStr("\n"c);
    GphBuild(g);

    var dist: int64 := alloc(n * 8);
    var bf: int64 := alloc(n * 8);
    var bd: int64 := alloc(n * 8);

    GphDijkstra(g, 0, dist, 0);
    PrintStr("DIJ "c);
    var i: int64 := 0;
    while (i < n) {
      var x: f64 := peekf64(dist + i * 8);
      P(Q(x));
      i := i + 1;
    }
    PrintStr("\n"c);

    GphBellmanFord(g, 0, bf, 0);
    PrintStr("BF "c);
    i := 0;
    while (i < n) {
      var y: f64 := peekf64(bf + i * 8);
      P(Q(y));
      i := i + 1;
    }
    PrintStr("\n"c);

    GphBfs(g, 0, bd, 0);
    PrintStr("BFS "c);
    i := 0;
    while (i < n) { P(peek64(bd + i * 8)); i := i + 1; }
    PrintStr("\n"c);

    // Komponenten nur bei ungerichteten, SCC nur bei gerichteten
    var comp: int64 := alloc(n * 8);
    if (!directed) {
      PrintStr("COMP "c);
      P(GphComponents(g, comp));
      i := 0;
      while (i < n) { P(peek64(comp + i * 8)); i := i + 1; }
      PrintStr("\n"c);

      var mstE: int64 := alloc((n + 1) * 8);
      var mstW: int64 := alloc(8);
      PrintStr("MST "c);
      P(GphMstKruskal(g, mstE, mstW));
      var mw: f64 := peekf64(mstW);
      P(Q(mw));
      PrintStr("\n"c);
      free(mstE, (n + 1) * 8);  free(mstW, 8);
    }
    else {
      PrintStr("SCC "c);
      P(GphScc(g, comp));
      i := 0;
      while (i < n) { P(peek64(comp + i * 8)); i := i + 1; }
      PrintStr("\n"c);

      var topo: int64 := alloc(n * 8);
      PrintStr("TOPO "c);
      P(GphTopoSort(g, topo));
      PrintStr("\n"c);
      free(topo, n * 8);
    }

    // Flussnetz aus denselben Kanten: Kapazitaeten sind die Gewichte
    var fl: int64 := GphFlowNew(n, ecount + 1);
    var q2: int64 := 0;
    while (q2 < ecount) {
      var fu: int64 := peek64(esrc + q2 * 8);
      var fv: int64 := peek64(edst + q2 * 8);
      var fw: int64 := peek64(ewt + q2 * 8);
      GphFlowAddEdge(fl, fu, fv, fw as f64);
      q2 := q2 + 1;
    }
    GphFlowBuild(fl);
    var side: int64 := alloc(n * 8);
    PrintStr("FLOW "c);
    var mfv: f64 := GphMaxFlow(fl, 0, n - 1);
    P(Q(mfv));
    P(GphMinCut(fl, 0, side));
    PrintStr("\n"c);
    free(side, n * 8);
    GphFlowFree(fl);

    // Zweiteilung und Zuordnung: linke Haelfte 0..n/2-1
    var half: int64 := n / 2;
    if (half > 0) {
      var bg: int64 := GphNew(n, ecount + 1, false);
      var q3: int64 := 0;
      while (q3 < ecount) {
        var bu: int64 := peek64(esrc + q3 * 8);
        var bv: int64 := peek64(edst + q3 * 8);
        var lu: bool := bu < half;
        var lv: bool := bv < half;
        if (lu != lv) { GphAddEdge(bg, bu, bv, 1.0); }
        q3 := q3 + 1;
      }
      GphBuild(bg);
      var mt: int64 := alloc(n * 8);
      PrintStr("MATCH "c);
      P(half);
      P(GphBipartiteMatch(bg, half, mt));
      var q4: int64 := 0;
      while (q4 < n) { P(peek64(mt + q4 * 8)); q4 := q4 + 1; }
      PrintStr("\n"c);
      free(mt, n * 8);
      GphFree(bg);
    }

    free(dist, n * 8);  free(bf, n * 8);  free(bd, n * 8);  free(comp, n * 8);
    free(esrc, maxE * 8);  free(edst, maxE * 8);  free(ewt, maxE * 8);
    GphFree(g);
    t := t + 1;
  }
  return 0;
}
