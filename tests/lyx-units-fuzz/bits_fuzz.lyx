// tests/bits_fuzz.lyx
// Gibt Zufallswoerter samt Ergebnissen aus; tools/bits_ref.py rechnet mit
// Python-Ganzzahlen nach.
//
// Noetig, weil die langsamen Gegenfassungen in bits_test.lyx selbst BitsTest
// benutzen, das seinerseits BitsShr benutzt: waere BitsShr falsch, waeren
// beide Wege gleich falsch. Python kennt BitsShr nicht.

unit main;

import std.bits;

var _s: int64 := 2463534242;

fn Rnd(): int64 {
  _s := _s * 6364136223846793005 + 1442695040888963407;
  return _s;
}

fn P(v: int64): void {
  PrintInt(v);
  PrintStr(" "c);
}

fn main(): int64 {
  var t: int64 := 0;
  while (t < 400) {
    var x: int64 := Rnd();
    var kind: int64 := t % 4;
    if (kind == 1) { x := x & Rnd(); }
    if (kind == 2) { x := x & Rnd() & Rnd(); }
    if (kind == 3) { x := x | Rnd(); }
    var n: int64 := t % 65;

    PrintStr("R "c);
    P(x);
    P(n);
    P(BitsPopCount(x));
    P(BitsParity(x));
    P(BitsClz(x));
    P(BitsCtz(x));
    P(BitsHighestSet(x));
    P(BitsLowestSet(x));
    P(BitsReverse(x));
    P(BitsSwapBytes(x));
    P(BitsShr(x, n));
    P(BitsShl(x, n));
    P(BitsRotl(x, n));
    P(BitsRotr(x, n));
    P(BitsGrayEncode(x));
    P(BitsGrayDecode(BitsGrayEncode(x)));
    P(BitsMask(n));
    P(BitsExtract(x, n % 57, 7));
    P(BitsSar(x, n));
    var ov: int64 := 0;
    if (BitsShlOverflows(x, n)) { ov := 1; }
    P(ov);
    var y: int64 := Rnd();
    P(y);
    P(BitsShrPair(x, y, n));
    P(BitsShlPair(x, y, n));
    P(BitsRotl32(x, n));
    P(BitsRotr32(x, n));
    P(BitsRotl16(x, n));
    P(BitsRotl8(x, n));
    var wd: int64 := 2 + (n % 63);
    P(wd);
    P(BitsRotlN(x, n, wd));
    P(BitsRotrN(x, n, wd));
    PrintStr("\n"c);
    t := t + 1;
  }
  return 0;
}
