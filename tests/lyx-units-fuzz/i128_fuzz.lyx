// tests/i128_fuzz.lyx
// Gibt Zufallsrechnungen aus; tools/i128_ref.py rechnet sie mit Pythons
// beliebig grossen Ganzzahlen nach — die kennen keine 128-Bit-Grenze und
// koennen den Fehler daher nicht teilen.
//
// Die 128-Bit-Werte werden als DEZIMALZEICHENKETTE ausgegeben, nicht als
// Wortpaar: so wird die Ausgabefunktion gleich mitgeprueft, und die Referenz
// muss nichts ueber die interne Darstellung wissen.

unit main;

import std.i128;
import std.bits;
import std.alloc;

var _s: int64 := 2463534242;

fn Rnd(): int64 {
  _s := _s * 6364136223846793005 + 1442695040888963407;
  return _s;
}

fn PD(p: int64, buf: int64): void {
  I128ToDecimalU(p, buf, 64);
  PrintStr(buf);
  PrintStr(" "c);
}

fn P(v: int64): void {
  PrintInt(v);
  PrintStr(" "c);
}

fn main(): int64 {
  var a: int64 := alloc(16);
  var b: int64 := alloc(16);
  var q: int64 := alloc(16);
  var r: int64 := alloc(16);
  var t: int64 := alloc(16);
  var buf: int64 := alloc(64);

  var i: int64 := 0;
  while (i < 400) {
    var x: int64 := Rnd();
    var y: int64 := Rnd();
    // gelegentlich kleine Werte, sonst traefe man die Randfaelle nie
    if (i % 4 == 1) { x := BitsShr(x, 40); }
    if (i % 4 == 2) { y := BitsShr(y, 56); }
    if (i % 4 == 3) { x := BitsShr(x, 60); y := BitsShr(y, 60); }

    // volles Produkt zweier Woerter
    I128Mul64U(x, y, a);
    PrintStr("MUL "c);
    P(x); P(y);
    P(I128MulHiU(x, y));
    P(I128MulLo(x, y));
    PD(a, buf);
    P(I128MulHiS(x, y));
    PrintStr("\n"c);

    // 128-Bit-Werte aufbauen und rechnen
    I128Set(a, Rnd(), Rnd());
    I128Set(b, Rnd(), Rnd());
    if (i % 3 == 0) { I128Set(b, 0, BitsShr(Rnd(), 32)); }

    PrintStr("OPS "c);
    PD(a, buf);
    PD(b, buf);
    I128Add(a, b, t);   PD(t, buf);
    I128Sub(a, b, t);   PD(t, buf);
    I128Mul(a, b, t);   PD(t, buf);
    I128Neg(a, t);      PD(t, buf);
    P(I128CmpU(a, b));
    P(I128CmpS(a, b));
    P(I128PopCount(a));
    P(I128HighestSet(a));
    PrintStr("\n"c);

    // Division mit Rest
    if (!I128IsZero(b)) {
      I128DivRemU(a, b, q, r);
      PrintStr("DIV "c);
      PD(a, buf);
      PD(b, buf);
      PD(q, buf);
      PD(r, buf);
      PrintStr("\n"c);
    }

    // Schieben
    var n: int64 := i % 129;
    PrintStr("SHIFT "c);
    PD(a, buf);
    P(n);
    I128Shl(a, n, t);   PD(t, buf);
    I128ShrU(a, n, t);  PD(t, buf);
    I128Sar(a, n, t);   PD(t, buf);
    PrintStr("\n"c);

    // (a*b)/c auf 64 Bit
    var ok: int64 := alloc(8);
    var d: int64 := Rnd();
    if (d == 0) { d := 3; }
    var md: int64 := I128MulDivU(x, y, d, ok);
    PrintStr("MULDIV "c);
    P(x); P(y); P(d); P(peek64(ok)); P(md);
    PrintStr("\n"c);
    free(ok, 8);

    PrintStr("AVG "c);
    P(x); P(y); P(I128AvgU(x, y));
    PrintStr("\n"c);

    i := i + 1;
  }

  free(a, 16);  free(b, 16);  free(q, 16);  free(r, 16);  free(t, 16);
  free(buf, 64);
  return 0;
}
