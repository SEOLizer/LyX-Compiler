// tests/money_fuzz.lyx
// Gibt Zufallsrechnungen samt Ergebnis aus; tools/money_ref.py rechnet sie mit
// Pythons decimal-Modul nach — derselben Referenz, an der sich auch
// Java BigDecimal orientiert.

unit main;

import std.money;
import std.alloc;

var _s: int64 := 2463534242;

fn Rnd(m: int64): int64 {
  _s := (_s * 6364136223846793005 + 1442695040888963407) & 4611686018427387903;
  return (_s / 65536) % m;
}

fn P(v: int64): void {
  PrintInt(v);
  PrintStr(" "c);
}

fn main(): int64 {
  var parts: int64 := alloc(12 * 8);
  var w: int64 := alloc(12 * 8);
  var buf: int64 := alloc(64);

  var t: int64 := 0;
  while (t < 500) {
    var num: int64 := Rnd(2000001) - 1000000;
    var den: int64 := 1 + Rnd(9999);
    var mode: int64 := t % 7;

    PrintStr("DIV "c);
    P(num); P(den); P(mode);
    P(MoneyDivRound(num, den, mode));
    PrintStr("\n"c);

    // Steuer aus dem Bruttobetrag
    var gross: int64 := Rnd(10000000);
    var rate: int64 := 1 + Rnd(3000);
    PrintStr("TAX "c);
    P(gross); P(rate); P(mode);
    P(MoneyTaxOfGross(gross, rate, 4, mode));
    P(MoneyMulRate(gross, rate, 4, mode));
    PrintStr("\n"c);

    // Umskalieren
    var v: int64 := Rnd(2000001) - 1000000;
    var fs: int64 := Rnd(7);
    var ts: int64 := Rnd(7);
    PrintStr("SCALE "c);
    P(v); P(fs); P(ts); P(mode);
    P(MoneyRescale(v, fs, ts, mode));
    PrintStr("\n"c);

    // Aufteilen
    var total: int64 := Rnd(200001) - 100000;
    var n: int64 := 1 + Rnd(11);
    MoneySplit(total, n, parts);
    PrintStr("SPLIT "c);
    P(total); P(n);
    var i: int64 := 0;
    while (i < n) { P(peek64(parts + i * 8)); i := i + 1; }
    PrintStr("\n"c);

    // Aufteilen nach Gewichten
    var nw: int64 := 1 + Rnd(7);
    var sumW: int64 := 0;
    i := 0;
    while (i < nw) {
      var wv: int64 := Rnd(15);
      poke64(w + i * 8, wv);
      sumW := sumW + wv;
      i := i + 1;
    }
    if (sumW == 0) { poke64(w, 1); }
    var at: int64 := Rnd(200001) - 100000;
    PrintStr("ALLOC "c);
    P(at); P(nw);
    i := 0;
    while (i < nw) { P(peek64(w + i * 8)); i := i + 1; }
    if (MoneyAllocate(at, w, nw, parts)) {
      i := 0;
      while (i < nw) { P(peek64(parts + i * 8)); i := i + 1; }
    }
    PrintStr("\n"c);

    // Ausgeben
    var fv: int64 := Rnd(2000000001) - 1000000000;
    var fsc: int64 := Rnd(5);
    var fmt: int64 := t % 4;
    MoneyFormat(fv, fsc, buf, 64, fmt);
    PrintStr("FMT "c);
    P(fv); P(fsc); P(fmt);
    PrintStr(buf);
    PrintStr("\n"c);

    t := t + 1;
  }

  free(parts, 12 * 8);  free(w, 12 * 8);  free(buf, 64);
  return 0;
}
