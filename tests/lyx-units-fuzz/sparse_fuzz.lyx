// tests/sparse_fuzz.lyx
// Erzeugt Zufallspaare duenner Vektoren mit festem LCG und gibt Skalarprodukt,
// Kosinus, Winkel, euklidischen und Manhattan-Abstand, Jaccard, Summe und
// elementweises Produkt aus. tools/sparse_ref.py rechnet dasselbe mit
// numpy/scipy nach.
//
// Fliesskommawerte als round(x*1e9) — exakter Vergleich ohne Textausgabe.

unit main;

import std.sparse;
import std.math;
import std.alloc;

var _s: int64 := 2463534242;

fn Rnd(m: int64): int64 {
  _s := (_s * 6364136223846793005 + 1442695040888963407) & 4611686018427387903;
  return (_s / 65536) % m;
}

fn Q(x: f64): int64 {
  var v: f64 := x * 1000000000.0;
  var a: f64 := AbsF64(v);
  var r: f64 := a + 0.5;
  var t: f64 := TruncF64(r);
  var n: int64 := t as int64;
  if (v < 0.0) { return 0 - n; }
  return n;
}

fn P(v: int64): void {
  PrintInt(v);
  PrintStr(" "c);
}

fn Emit(tag: pchar, idx: int64, val: int64, nnz: int64): void {
  PrintStr(tag);
  P(nnz);
  var i: int64 := 0;
  while (i < nnz) {
    P(peek64(idx + i * 8));
    var v: f64 := peekf64(val + i * 8);
    P(Q(v));
    i := i + 1;
  }
  PrintStr("\n"c);
}

fn main(): int64 {
  var N: int64 := 40;
  var da: int64 := alloc(N * 8);
  var db: int64 := alloc(N * 8);
  var ia: int64 := alloc(N * 8);
  var va: int64 := alloc(N * 8);
  var ib: int64 := alloc(N * 8);
  var vb: int64 := alloc(N * 8);
  var oi: int64 := alloc(2 * N * 8);
  var ov: int64 := alloc(2 * N * 8);

  var cse: int64 := 0;
  while (cse < 80) {
    var fill: int64 := 1 + Rnd(9);
    var i: int64 := 0;
    while (i < N) {
      pokef64(da + i * 8, 0.0);
      pokef64(db + i * 8, 0.0);
      if (Rnd(10) < fill) {
        var r: int64 := Rnd(20001) - 10000;
        var x: f64 := (r as f64) / 1000.0;
        pokef64(da + i * 8, x);
      }
      if (Rnd(10) < fill) {
        var r2: int64 := Rnd(20001) - 10000;
        var y: f64 := (r2 as f64) / 1000.0;
        pokef64(db + i * 8, y);
      }
      i := i + 1;
    }
    var na: int64 := SparseFromDense(da, N, 0.0, ia, va, N);
    var nb: int64 := SparseFromDense(db, N, 0.0, ib, vb, N);

    PrintStr("CASE "c);
    P(cse);
    P(N);
    PrintStr("\n"c);
    Emit("A "c, ia, va, na);
    Emit("B "c, ib, vb, nb);

    PrintStr("SCAL "c);
    P(Q(SparseDot(ia, va, na, ib, vb, nb)));
    P(Q(SparseCosine(ia, va, na, ib, vb, nb)));
    P(Q(SparseAngular(ia, va, na, ib, vb, nb)));
    P(Q(SparseEuclid(ia, va, na, ib, vb, nb)));
    P(Q(SparseManhattan(ia, va, na, ib, vb, nb)));
    P(Q(SparseNorm(va, na)));
    P(Q(SparseNormL1(va, na)));
    P(Q(SparseNormInf(va, na)));
    P(Q(SparseJaccard(ia, na, ib, nb)));
    P(SparseOverlap(ia, na, ib, nb));
    PrintStr("\n"c);

    var m: int64 := SparseAdd(ia, va, na, ib, vb, nb, oi, ov, 2 * N);
    Emit("SUM "c, oi, ov, m);
    m := SparseHadamard(ia, va, na, ib, vb, nb, oi, ov, 2 * N);
    Emit("PROD "c, oi, ov, m);

    cse := cse + 1;
  }

  free(da, N * 8);  free(db, N * 8);
  free(ia, N * 8);  free(va, N * 8);
  free(ib, N * 8);  free(vb, N * 8);
  free(oi, 2 * N * 8);  free(ov, 2 * N * 8);
  return 0;
}
