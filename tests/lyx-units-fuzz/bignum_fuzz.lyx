// tests/bignum_fuzz.lyx
// Gibt Zufallsrechnungen als Dezimalzeichenketten aus; tools/bignum_ref.py
// rechnet sie mit Pythons Ganzzahlen nach.
//
// Dezimal statt Wortpaare: so wird die Ausgabe gleich mitgeprueft, und die
// Referenz muss nichts ueber die interne Darstellung wissen.

unit main;

import std.bignum;
import std.alloc;

var _s: int64 := 2463534242;
var _buf: int64 := 0;

fn Rnd(): int64 {
  _s := _s * 6364136223846793005 + 1442695040888963407;
  return _s;
}

fn PD(p: int64): void {
  BigToDecimal(p, _buf, 1024);
  PrintStr(_buf);
  PrintStr(" "c);
}

// Zufallszahl mit `words` Woertern nach out
fn Fill(out: int64, words: int64, tmp: int64, dg: int64): void {
  BigZero(out);
  var k: int64 := 0;
  while (k < words) {
    BigMulU64(out, 0 - 1, tmp);
    BigCopy(tmp, out);
    BigSetU64(dg, Rnd());
    BigAdd(out, dg, tmp);
    BigCopy(tmp, out);
    k := k + 1;
  }
}

fn main(): int64 {
  _buf := alloc(1024);
  var a: int64 := BigNew(20);
  var b: int64 := BigNew(20);
  var c: int64 := BigNew(50);
  var q: int64 := BigNew(50);
  var r: int64 := BigNew(50);
  var tmp: int64 := BigNew(50);
  var dg: int64 := BigNew(4);
  var m: int64 := BigNew(20);
  var e: int64 := BigNew(4);

  var i: int64 := 0;
  while (i < 150) {
    var la: int64 := 1 + (i % 6);
    var lb: int64 := 1 + ((i * 5) % 4);
    Fill(a, la, tmp, dg);
    Fill(b, lb, tmp, dg);

    // Vorzeichen wechseln lassen
    if (i % 3 == 1) { BigNeg(a, tmp); BigCopy(tmp, a); }
    if (i % 4 == 2) { BigNeg(b, tmp); BigCopy(tmp, b); }

    PrintStr("OPS "c);
    PD(a); PD(b);
    BigAdd(a, b, c);  PD(c);
    BigSub(a, b, c);  PD(c);
    BigMul(a, b, c);  PD(c);
    BigNeg(a, c);     PD(c);
    PrintInt(BigCmp(a, b)); PrintStr(" "c);
    PrintInt(BigBitLen(a)); PrintStr(" "c);
    PrintStr("\n"c);

    if (!BigIsZero(b)) {
      BigDivRem(a, b, q, r);
      PrintStr("DIV "c);
      PD(a); PD(b); PD(q); PD(r);
      PrintStr("\n"c);

      BigMod(a, b, c);
      PrintStr("MOD "c);
      PD(a); PD(b); PD(c);
      PrintStr("\n"c);

      BigGcd(a, b, c);
      PrintStr("GCD "c);
      PD(a); PD(b); PD(c);
      PrintStr("\n"c);
    }

    var n: int64 := i % 200;
    BigShl(a, n, c);
    PrintStr("SHL "c);
    PD(a); PrintInt(n); PrintStr(" "c); PD(c);
    PrintStr("\n"c);
    BigShr(a, n, c);
    PrintStr("SHR "c);
    PD(a); PrintInt(n); PrintStr(" "c); PD(c);
    PrintStr("\n"c);

    // modulare Potenz mit kleinen Werten, sonst wird es zu langsam
    Fill(m, 1, tmp, dg);
    if (!BigIsZero(m)) {
      BigSetU64(e, 1 + (i % 40));
      BigAbs(a, tmp);
      BigPowMod(tmp, e, m, c);
      PrintStr("POWMOD "c);
      PD(tmp); PD(e); PD(m); PD(c);
      PrintStr("\n"c);
    }

    i := i + 1;
  }

  BigFree(a); BigFree(b); BigFree(c); BigFree(q); BigFree(r);
  BigFree(tmp); BigFree(dg); BigFree(m); BigFree(e);
  free(_buf, 1024);
  return 0;
}
