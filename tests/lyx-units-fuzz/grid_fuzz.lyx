// tests/grid_fuzz.lyx
// Erzeugt Zufallsgitter mit einem festen LCG und gibt BFS-, Dijkstra- und
// A*-Ergebnisse als Zahlen aus. tools/grid_ref.py baut denselben LCG nach,
// rechnet mit heapq/deque und vergleicht Zeile fuer Zeile.
//
// Fliesskommawerte werden als round(x*1e6) ausgegeben — so ist der Vergleich
// exakt und haengt nicht an der Textausgabe von PrintFloat.

unit main;

import std.grid;
import std.math;
import std.alloc;

var _s: int64 := 88172645463325252;

fn Rnd(m: int64): int64 {
  _s := (_s * 6364136223846793005 + 1442695040888963407) & 4611686018427387903;
  return (_s / 65536) % m;
}

fn Q(x: f64): int64 {
  if (x < 0.0) { return 0 - 1; }
  var v: f64 := x * 1000000.0 + 0.5;
  var t: f64 := TruncF64(v);
  return t as int64;
}

fn P(v: int64): void {
  PrintInt(v);
  PrintStr(" "c);
}

fn main(): int64 {
  var cse: int64 := 0;
  while (cse < 60) {
    var w: int64 := 3 + Rnd(8);
    var h: int64 := 3 + Rnd(8);
    var n: int64 := w * h;
    var cells: int64 := alloc(n * 8);

    var i: int64 := 0;
    while (i < n) {
      var r: int64 := Rnd(10);
      var c: int64 := 0;
      if (r >= 3) { c := 1 + Rnd(4); }
      poke64(cells + i * 8, c);
      i := i + 1;
    }
    var sx: int64 := Rnd(w);
    var sy: int64 := Rnd(h);
    var gx: int64 := Rnd(w);
    var gy: int64 := Rnd(h);
    GridSet(cells, sx, sy, w, 1 + Rnd(4));
    GridSet(cells, gx, gy, w, 1 + Rnd(4));
    var diag: bool := Rnd(2) == 1;

    // Kopfzeile: Fall, Masse, Start, Ziel, Bewegungsart, dann das Gitter
    PrintStr("CASE "c);
    P(cse); P(w); P(h); P(sx); P(sy); P(gx); P(gy);
    var dg: int64 := 0;
    if (diag) { dg := 1; }
    P(dg);
    PrintStr("\n"c);

    PrintStr("CELLS "c);
    i := 0;
    while (i < n) { P(peek64(cells + i * 8)); i := i + 1; }
    PrintStr("\n"c);

    // Breitensuche
    var bd: int64 := alloc(n * 8);
    PrintStr("BFS "c);
    if (GridBfs(cells, w, h, sx, sy, diag, bd)) {
      i := 0;
      while (i < n) { P(peek64(bd + i * 8)); i := i + 1; }
    }
    PrintStr("\n"c);

    // Dijkstra
    var dd: int64 := alloc(n * 8);
    PrintStr("DIJ "c);
    if (GridDijkstra(cells, w, h, sx, sy, diag, dd, 0)) {
      i := 0;
      while (i < n) {
        var v: f64 := peekf64(dd + i * 8);
        P(Q(v));
        i := i + 1;
      }
    }
    PrintStr("\n"c);

    // A*: Kosten des gefundenen Weges, aus den Zellen nachgerechnet
    var px: int64 := alloc((n + 4) * 8);
    var py: int64 := alloc((n + 4) * 8);
    var k: int64 := GridAStar(cells, w, h, sx, sy, gx, gy, diag, px, py, n + 4);
    PrintStr("ASTAR "c);
    P(k);
    if (k > 0) {
      var s: f64 := 0.0;
      var r2: f64 := 1.4142135623730951;
      var j: int64 := 1;
      while (j < k) {
        var cx: int64 := peek64(px + j * 8);
        var cy: int64 := peek64(py + j * 8);
        var step: f64 := GridCost(cells, cx, cy, w, h) as f64;
        if (cx != peek64(px + (j - 1) * 8)) {
          if (cy != peek64(py + (j - 1) * 8)) { step := step * r2; }
        }
        s := s + step;
        j := j + 1;
      }
      P(Q(s));
      j := 0;
      while (j < k) {
        P(peek64(px + j * 8));
        P(peek64(py + j * 8));
        j := j + 1;
      }
    }
    PrintStr("\n"c);

    // Bresenham von Start nach Ziel
    var ln: int64 := GridLine(sx, sy, gx, gy, px, py, n + 4);
    PrintStr("LINE "c);
    P(ln);
    i := 0;
    while (i < ln) {
      P(peek64(px + i * 8));
      P(peek64(py + i * 8));
      i := i + 1;
    }
    PrintStr("\n"c);

    free(cells, n * 8);  free(bd, n * 8);  free(dd, n * 8);
    free(px, (n + 4) * 8);  free(py, (n + 4) * 8);
    cse := cse + 1;
  }
  return 0;
}
