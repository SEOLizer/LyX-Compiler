// tests/wavelet_test.lyx
// Selbstpruefende Testbatterie fuer std.wavelet.
//
// Zahlenwerte aus einer unabhaengig in Python geschriebenen Referenz derselben
// Definition. Der groessere Teil prueft strukturell: perfekte Rekonstruktion,
// Energieerhaltung (Parseval), verschwindende Momente. Solche Saetze muessen
// fuer JEDES orthogonale Wavelet gelten und decken Vorzeichen- und
// Indexfehler auf, die einzelne Zahlenwerte durchlassen wuerden.

unit main;

import std.wavelet;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn TOL(): f64 { return 0.0000000001; }

fn V(p: int64, i: int64): f64 {
  var v: f64 := peekf64(p + i * 8);
  return v;
}

fn Check(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > tol) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" (bool)\n"c);
  }
}

fn MaxDiff(a: int64, b: int64, n: int64): f64 {
  var worst: f64 := 0.0;
  var i: int64 := 0;
  while (i < n) {
    var d: f64 := AbsF64(V(a, i) - V(b, i));
    if (d > worst) { worst := d; }
    i := i + 1;
  }
  return worst;
}

fn Ramp(p: int64, n: int64): void {
  var i: int64 := 0;
  while (i < n) {
    pokef64(p + i * 8, (i + 1) as f64);
    i := i + 1;
  }
}

fn main(): int64 {
  // ── Filter ────────────────────────────────────────────────────────────────
  CheckI("lenHaar"c, WavFilterLen(WAV_HAAR), 2);
  CheckI("lenDb2"c,  WavFilterLen(WAV_DB2),  4);
  CheckI("lenDb3"c,  WavFilterLen(WAV_DB3),  6);
  CheckI("lenDb4"c,  WavFilterLen(WAV_DB4),  8);
  CheckI("lenBad"c,  WavFilterLen(99),       0);
  CheckI("momHaar"c, WavVanishingMoments(WAV_HAAR), 1);
  CheckI("momDb4"c,  WavVanishingMoments(WAV_DB4),  4);

  var lo: int64 := alloc(8 * 8);
  var hi: int64 := alloc(8 * 8);
  CheckB("filtOk"c, WavFilterLow(WAV_DB2, lo), true);
  CheckB("filtHiOk"c, WavFilterHigh(WAV_DB2, hi), true);
  CheckB("filtBad"c, WavFilterLow(99, lo), false);

  // Orthogonalitaet: Quadratsumme 1, Summe sqrt(2)
  var sumLo: f64 := 0.0;
  var sqLo: f64 := 0.0;
  var sumHi: f64 := 0.0;
  var sqHi: f64 := 0.0;
  var cross: f64 := 0.0;
  var i: int64 := 0;
  while (i < 4) {
    var l: f64 := V(lo, i);
    var h: f64 := V(hi, i);
    sumLo := sumLo + l;   sqLo := sqLo + l * l;
    sumHi := sumHi + h;   sqHi := sqHi + h * h;
    cross := cross + l * h;
    i := i + 1;
  }
  Check("db2SumLo"c, sumLo, SqrtF64(2.0), 0.0000000001);
  Check("db2SqLo"c,  sqLo,  1.0, 0.0000000001);
  // Hochpass summiert sich zu 0 — genau das loescht Konstanten aus
  Check("db2SumHi"c, sumHi, 0.0, 0.0000000001);
  Check("db2SqHi"c,  sqHi,  1.0, 0.0000000001);
  Check("db2Cross"c, cross, 0.0, 0.0000000001);

  // dasselbe fuer Haar
  WavFilterLow(WAV_HAAR, lo);
  Check("haarLo0"c, V(lo, 0), 0.7071067811865475, 0.0000000001);
  WavFilterHigh(WAV_HAAR, hi);
  Check("haarHi0"c, V(hi, 0),  0.7071067811865475, 0.0000000001);
  Check("haarHi1"c, V(hi, 1), -0.7071067811865475, 0.0000000001);
  free(lo, 8 * 8);  free(hi, 8 * 8);

  // ── Eine Stufe, Haar ──────────────────────────────────────────────────────
  var n: int64 := 8;
  var a: int64 := alloc(n * 8);
  var c: int64 := alloc(n * 8);
  var r: int64 := alloc(n * 8);
  Ramp(a, n);

  CheckB("dwtOk"c, WavDwt(a, n, WAV_HAAR, c), true);
  Check("haarA0"c, V(c, 0), 2.1213203435596424, TOL());
  Check("haarA3"c, V(c, 3), 10.606601717798213, TOL());
  Check("haarD0"c, V(c, 4), -0.7071067811865475, TOL());
  Check("haarD3"c, V(c, 7), -0.7071067811865475, TOL());

  // Rekonstruktion
  CheckB("idwtOk"c, WavIdwt(c, n, WAV_HAAR, r), true);
  Check("haarRound"c, MaxDiff(a, r, n), 0.0, 0.0000000001);

  // Parseval: die Energie bleibt
  Check("haarEnergy"c, WavEnergy(c, n), WavEnergy(a, n), 0.0000000001);
  Check("energyVal"c, WavEnergy(a, n), 204.0, TOL());

  // ── db2: verschwindende Momente ───────────────────────────────────────────
  WavDwt(a, n, WAV_DB2, c);
  Check("db2A0"c, V(c, 0), 2.3107890345001343, TOL());
  Check("db2A3"c, V(c, 3), 10.038195644931783, TOL());
  // db2 loescht Geraden: alle Details null ausser dem einen am zyklischen Rand
  Check("db2D0"c, V(c, 4), 0.0, 0.0000000001);
  Check("db2D1"c, V(c, 5), 0.0, 0.0000000001);
  Check("db2D2"c, V(c, 6), 0.0, 0.0000000001);
  // an der Nahtstelle springt das Signal von 8 auf 1 — dort MUSS ein Detail
  // stehen, sonst waere die Zerlegung blind fuer Spruenge
  Check("db2Dseam"c, V(c, 7), -2.8284271247461903, TOL());
  Check("db2Energy"c, WavEnergy(c, n), 204.0, 0.0000001);
  WavIdwt(c, n, WAV_DB2, r);
  Check("db2Round"c, MaxDiff(a, r, n), 0.0, 0.0000000001);

  // db3 loescht zusaetzlich Parabeln
  var n16: int64 := 16;
  var q: int64 := alloc(n16 * 8);
  var qc: int64 := alloc(n16 * 8);
  var qr: int64 := alloc(n16 * 8);
  i := 0;
  while (i < n16) {
    pokef64(q + i * 8, (i * i) as f64);
    i := i + 1;
  }
  WavDwt(q, n16, WAV_DB3, qc);
  // im Inneren null, nur an der Naht nicht
  Check("db3Quad0"c, V(qc, 8),  0.0, 0.0000001);
  Check("db3Quad3"c, V(qc, 11), 0.0, 0.0000001);
  Check("db3Quad5"c, V(qc, 13), 0.0, 0.0000001);
  var seamBig: bool := AbsF64(V(qc, 14)) > 1.0;
  CheckB("db3Seam"c, seamBig, true);
  WavIdwt(qc, n16, WAV_DB3, qr);
  Check("db3Round"c, MaxDiff(q, qr, n16), 0.0, 0.000000001);

  // db4 auf einem kubischen Verlauf
  i := 0;
  while (i < n16) {
    var t: f64 := i as f64;
    pokef64(q + i * 8, t * t * t);
    i := i + 1;
  }
  WavDwt(q, n16, WAV_DB4, qc);
  Check("db4Cubic0"c, V(qc, 8), 0.0, 0.000001);
  Check("db4Cubic2"c, V(qc, 10), 0.0, 0.000001);
  WavIdwt(qc, n16, WAV_DB4, qr);
  Check("db4Round"c, MaxDiff(q, qr, n16), 0.0, 0.0000001);
  free(q, n16 * 8);  free(qc, n16 * 8);  free(qr, n16 * 8);

  // ── Fehlerpfade einer Stufe ───────────────────────────────────────────────
  CheckB("dwtOdd"c, WavDwt(a, 7, WAV_HAAR, c), false);
  CheckB("dwtTooShort"c, WavDwt(a, 1, WAV_HAAR, c), false);
  CheckB("dwtBadKind"c, WavDwt(a, n, 99, c), false);
  CheckB("dwtAlias"c, WavDwt(a, n, WAV_HAAR, a), false);
  CheckB("idwtAlias"c, WavIdwt(c, n, WAV_HAAR, c), false);

  // ── Stufenzahl ────────────────────────────────────────────────────────────
  CheckI("maxLvlHaar8"c,  WavMaxLevel(8, WAV_HAAR),  2);
  CheckI("maxLvlHaar64"c, WavMaxLevel(64, WAV_HAAR), 5);
  CheckI("maxLvlDb2_64"c, WavMaxLevel(64, WAV_DB2),  4);
  CheckI("maxLvlOdd"c,    WavMaxLevel(7, WAV_HAAR),  0);
  CheckI("maxLvlBad"c,    WavMaxLevel(64, 99),       0);
  CheckI("approxLen"c,    WavApproxLen(64, 3),       8);
  CheckI("approxLen0"c,   WavApproxLen(64, 0),       64);

  // ── Mehrstufig ────────────────────────────────────────────────────────────
  Ramp(a, n);
  CheckB("multiOk"c, WavDwtMulti(a, n, WAV_HAAR, 2, c), true);
  // Referenz: [5, 13, -2, -2, -0.7071..., x4]
  Check("multiA0"c, V(c, 0),  5.0,  TOL());
  Check("multiA1"c, V(c, 1), 13.0,  TOL());
  Check("multiD2_0"c, V(c, 2), -2.0, TOL());
  Check("multiD2_1"c, V(c, 3), -2.0, TOL());
  Check("multiD1_0"c, V(c, 4), -0.7071067811865475, TOL());
  Check("multiD1_3"c, V(c, 7), -0.7071067811865475, TOL());
  Check("multiEnergy"c, WavEnergy(c, n), 204.0, 0.0000001);

  CheckB("multiInvOk"c, WavIdwtMulti(c, n, WAV_HAAR, 2, r), true);
  Check("multiRound"c, MaxDiff(a, r, n), 0.0, 0.0000000001);

  // eine Stufe mehrstufig ist dieselbe wie eine einzelne
  var c1: int64 := alloc(n * 8);
  WavDwt(a, n, WAV_DB2, c1);
  WavDwtMulti(a, n, WAV_DB2, 1, c);
  Check("multi1EqSingle"c, MaxDiff(c, c1, n), 0.0, TOL());
  free(c1, n * 8);

  // zu viele Stufen werden abgewiesen — und lassen die Ausgabe unberuehrt
  CheckB("multiTooDeep"c, WavDwtMulti(a, n, WAV_HAAR, 3, c), false);
  CheckB("multiZero"c, WavDwtMulti(a, n, WAV_HAAR, 0, c), false);
  CheckB("multiAlias"c, WavDwtMulti(a, n, WAV_HAAR, 2, a), false);

  // laengere Reihe, alle Familien, volle Stufenzahl
  var big: int64 := 64;
  var ba: int64 := alloc(big * 8);
  var bc: int64 := alloc(big * 8);
  var br: int64 := alloc(big * 8);
  i := 0;
  while (i < big) {
    var t: f64 := (i as f64) / 8.0;
    pokef64(ba + i * 8, SinF64(t) + 0.3 * CosF64(3.0 * t));
    i := i + 1;
  }
  var kinds: int64 := alloc(4 * 8);
  poke64(kinds, WAV_HAAR);  poke64(kinds + 8, WAV_DB2);
  poke64(kinds + 16, WAV_DB3);  poke64(kinds + 24, WAV_DB4);

  var allRound: bool := true;
  var allEnergy: bool := true;
  var ki: int64 := 0;
  while (ki < 4) {
    var kind: int64 := peek64(kinds + ki * 8);
    var lv: int64 := WavMaxLevel(big, kind);
    if (WavDwtMulti(ba, big, kind, lv, bc)) {
      if (AbsF64(WavEnergy(bc, big) - WavEnergy(ba, big)) > 0.000001) { allEnergy := false; }
      if (WavIdwtMulti(bc, big, kind, lv, br)) {
        if (MaxDiff(ba, br, big) > 0.000000001) { allRound := false; }
      }
      else { allRound := false; }
    }
    else { allRound := false; }
    ki := ki + 1;
  }
  CheckB("allFamiliesRound"c, allRound, true);
  CheckB("allFamiliesEnergy"c, allEnergy, true);
  free(kinds, 4 * 8);

  // ── Energieverdichtung ────────────────────────────────────────────────────
  // Ein glattes Signal buendelt seine Energie in wenigen Koeffizienten
  // db4 laesst bei n=64 nur 3 Stufen zu (WavMaxLevel) — mit 4 wuerde der
  // Aufruf zu Recht scheitern und die alten Koeffizienten stehen lassen
  CheckB("compactDecomp"c, WavDwtMulti(ba, big, WAV_DB4, 3, bc), true);
  var ratio8: f64 := WavEnergyRatio(bc, big, 8);
  // Referenz: 8 von 64 Koeffizienten tragen 98.2 Prozent der Energie,
  // 16 davon 99.8 Prozent
  // Toleranz 1e-5: das Testsignal kommt aus SinF64/CosF64, die gegenueber der
  // Python-Referenz um rund 1e-8 je Wert abweichen — im Energieanteil summiert
  // sich das auf etwa 1e-6
  Check("compaction8"c, ratio8, 0.9867519058693748, 0.00001);
  var ratio16: f64 := WavEnergyRatio(bc, big, 16);
  Check("compaction16"c, ratio16, 0.9985545074320265, 0.00001);
  Check("ratioAll"c, WavEnergyRatio(bc, big, big), 1.0, 0.0000000001);
  Check("ratioZeroK"c, WavEnergyRatio(bc, big, 0), 0.0, TOL());

  // Rauschen verteilt seine Energie — deutlich schlechter verdichtbar
  var noise: int64 := alloc(big * 8);
  var nc: int64 := alloc(big * 8);
  i := 0;
  while (i < big) {
    // grob wechselnde Werte ohne Glattheit
    var t: f64 := SinF64((i as f64) * 12.9898) * 43758.5453;
    var frac: f64 := t - ((t as int64) as f64);
    pokef64(noise + i * 8, frac);
    i := i + 1;
  }
  WavDwtMulti(noise, big, WAV_DB4, 3, nc);
  // Zwischenvariable: `f(...) < x` liest der Parser als Beginn einer
  // Typargumentliste (`f<...>`) und bricht mit "expected >" ab.
  var noiseRatio: f64 := WavEnergyRatio(nc, big, 8);
  var worseCompaction: bool := noiseRatio < ratio8;
  CheckB("noiseWorse"c, worseCompaction, true);
  free(noise, big * 8);  free(nc, big * 8);

  // ── Schwellenwerte ────────────────────────────────────────────────────────
  var t8: int64 := alloc(6 * 8);
  pokef64(t8,      3.0);   pokef64(t8 +  8, -3.0);
  pokef64(t8 + 16, 0.5);   pokef64(t8 + 24, -0.5);
  pokef64(t8 + 32, 1.0);   pokef64(t8 + 40, -1.0);

  WavThresholdHard(t8, 6, 1.0);
  Check("hardKeep"c,  V(t8, 0),  3.0, TOL());
  Check("hardKeepN"c, V(t8, 1), -3.0, TOL());
  Check("hardKill"c,  V(t8, 2),  0.0, TOL());
  Check("hardKillN"c, V(t8, 3),  0.0, TOL());
  // genau auf der Schwelle bleibt stehen
  Check("hardEdge"c,  V(t8, 4),  1.0, TOL());

  pokef64(t8,      3.0);   pokef64(t8 +  8, -3.0);
  pokef64(t8 + 16, 0.5);   pokef64(t8 + 24, -0.5);
  pokef64(t8 + 32, 1.0);   pokef64(t8 + 40, -1.0);
  WavThresholdSoft(t8, 6, 1.0);
  Check("softShrink"c,  V(t8, 0),  2.0, TOL());
  Check("softShrinkN"c, V(t8, 1), -2.0, TOL());
  Check("softKill"c,    V(t8, 2),  0.0, TOL());
  Check("softEdge"c,    V(t8, 4),  0.0, TOL());
  free(t8, 6 * 8);

  Check("univThresh"c, WavUniversalThreshold(1.0, 64), SqrtF64(2.0 * LogF64(64.0)), TOL());
  Check("univZeroN"c,  WavUniversalThreshold(1.0, 1), 0.0, TOL());

  // ── Entrauschen ───────────────────────────────────────────────────────────
  // glattes Signal plus wechselndes Stoersignal
  var clean: int64 := alloc(big * 8);
  var noisy: int64 := alloc(big * 8);
  var den: int64 := alloc(big * 8);
  i := 0;
  while (i < big) {
    var t: f64 := (i as f64) / 10.0;
    var s: f64 := SinF64(t) * 5.0;
    pokef64(clean + i * 8, s);
    var jitter: f64 := 0.4;
    if ((i % 2) == 1) { jitter := 0.0 - 0.4; }
    pokef64(noisy + i * 8, s + jitter);
    i := i + 1;
  }
  CheckB("denoiseOk"c, WavDenoise(noisy, big, WAV_DB4, 3, true, den), true);

  // Fehler gegen das saubere Signal muss kleiner werden
  var errBefore: f64 := 0.0;
  var errAfter: f64 := 0.0;
  i := 0;
  while (i < big) {
    var d1: f64 := V(noisy, i) - V(clean, i);
    var d2: f64 := V(den, i) - V(clean, i);
    errBefore := errBefore + d1 * d1;
    errAfter := errAfter + d2 * d2;
    i := i + 1;
  }
  // `a < b` als Aufrufargument liest der Parser als Beginn einer
  // Typargumentliste — Vergleich vorher in eine Variable legen.
  var improved: bool := errAfter < errBefore;
  CheckB("denoiseImproves"c, improved, true);

  // harte Schwelle geht ebenfalls
  CheckB("denoiseHardOk"c, WavDenoise(noisy, big, WAV_DB4, 3, false, den), true);
  CheckB("denoiseAlias"c, WavDenoise(noisy, big, WAV_DB4, 3, true, noisy), false);
  CheckB("denoiseTooDeep"c, WavDenoise(noisy, big, WAV_DB4, 99, true, den), false);

  // Rauschschaetzung: bei einem sauberen glatten Signal nahe null
  WavDwtMulti(clean, big, WAV_DB4, 3, bc);
  var sigmaClean: f64 := WavEstimateSigma(bc, big, 3);
  WavDwtMulti(noisy, big, WAV_DB4, 3, bc);
  var sigmaNoisy: f64 := WavEstimateSigma(bc, big, 3);
  var sigmaGrew: bool := sigmaNoisy > sigmaClean;
  CheckB("sigmaGrows"c, sigmaGrew, true);
  var sigmaSmall: bool := sigmaClean < 0.1;
  CheckB("sigmaCleanSmall"c, sigmaSmall, true);

  free(clean, big * 8);  free(noisy, big * 8);  free(den, big * 8);

  // ── 2D ────────────────────────────────────────────────────────────────────
  var w: int64 := 4;
  var h: int64 := 4;
  var img: int64 := alloc(16 * 8);
  var ic: int64 := alloc(16 * 8);
  var ir: int64 := alloc(16 * 8);
  i := 0;
  while (i < 16) {
    pokef64(img + i * 8, (i + 1) as f64);
    i := i + 1;
  }
  CheckB("dwt2dOk"c, WavDwt2D(img, w, h, WAV_HAAR, 1, ic), true);
  // Referenz: [[7,11,-1,-1],[23,27,-1,-1],[-4,-4,0,0],[-4,-4,0,0]]
  Check("i2d00"c, V(ic, 0),   7.0, TOL());
  Check("i2d01"c, V(ic, 1),  11.0, TOL());
  Check("i2d02"c, V(ic, 2),  -1.0, TOL());
  Check("i2d10"c, V(ic, 4),  23.0, TOL());
  Check("i2d20"c, V(ic, 8),  -4.0, TOL());
  Check("i2d22"c, V(ic, 10),  0.0, TOL());
  Check("i2d33"c, V(ic, 15),  0.0, TOL());

  CheckB("idwt2dOk"c, WavIdwt2D(ic, w, h, WAV_HAAR, 1, ir), true);
  Check("round2d"c, MaxDiff(img, ir, 16), 0.0, 0.0000000001);
  Check("energy2d"c, WavEnergy(ic, 16), WavEnergy(img, 16), 0.0000001);

  // zwei Stufen
  CheckB("dwt2dL2"c, WavDwt2D(img, w, h, WAV_HAAR, 2, ic), true);
  WavIdwt2D(ic, w, h, WAV_HAAR, 2, ir);
  Check("round2dL2"c, MaxDiff(img, ir, 16), 0.0, 0.0000000001);

  // ungerade Kantenlaenge wird abgewiesen
  CheckB("dwt2dOdd"c, WavDwt2D(img, 3, 4, WAV_HAAR, 1, ic), false);
  CheckB("dwt2dAlias"c, WavDwt2D(img, w, h, WAV_HAAR, 1, img), false);

  // konstantes Bild: alle Details null, Energie ganz im linken oberen Viertel
  var flat: int64 := alloc(16 * 8);
  i := 0;
  while (i < 16) { pokef64(flat + i * 8, 5.0); i := i + 1; }
  WavDwt2D(flat, w, h, WAV_HAAR, 1, ic);
  // konstant 5, zweimal Tiefpass mit Faktor sqrt(2): 5 * 2 = 10
  Check("flatLL"c, V(ic, 0), 10.0, TOL());
  Check("flatLH"c, V(ic, 2),  0.0, TOL());
  Check("flatHL"c, V(ic, 8),  0.0, TOL());
  Check("flatHH"c, V(ic, 10), 0.0, TOL());
  free(flat, 16 * 8);

  free(img, 16 * 8);  free(ic, 16 * 8);  free(ir, 16 * 8);
  free(ba, big * 8);  free(bc, big * 8);  free(br, big * 8);
  free(a, n * 8);  free(c, n * 8);  free(r, n * 8);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
