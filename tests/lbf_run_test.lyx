// tests/lbf_run_test.lyx — End-to-End nativer LYX!-Loader
// writeLBF erzeugt eine LYX!-Datei aus x86-64-Code (mov eax,42; ret), lbf_run lädt +
// führt sie nativ aus (mmap RWX + Sprung). Erwartet: 42.

import src.std.io;
import src.tools.lbf.writer;
import src.tools.lbf.loader;

fn main(): int64 {
    // x86-64: B8 2A 00 00 00 = mov eax, 42 ; C3 = ret
    var code: int64 := alloc(8);
    poke8(code + 0, 0xB8);
    poke8(code + 1, 0x2A);
    poke8(code + 2, 0x00);
    poke8(code + 3, 0x00);
    poke8(code + 4, 0x00);
    poke8(code + 5, 0xC3);

    var w: LBFNativeWriter := new LBFNativeWriter();
    w.setLifecycle(0, 0, 0);
    if !w.writeLBF("/tmp/lbf_rt.lyxnative"c, 0 as pchar, code, 6) {
        EPrintStrLn("FAIL: writeLBF");
        return 1;
    }

    var r: int64 := lbf_run("/tmp/lbf_rt.lyxnative"c);
    if r == 42 {
        PrintStrLn("lbf_run: OK (42)");
        return 0;
    }
    EPrintStr("FAIL: lbf_run returned "c);
    PrintInt(r);
    PrintLn("");
    return 1;
}
