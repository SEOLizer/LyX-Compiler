// tests/meta_safe_test.lyx — WP-3.2: .meta_safe section + runtime verifier
//
// MUST be compiled WITH --meta-safe:
//   lyxc --meta-safe tests/meta_safe_test.lyx -o /tmp/meta_safe_test
//   /tmp/meta_safe_test

import std.meta_safe;

// CRC32 reference implementation for test-vector validation
fn refCrc32(data: int64, len: int64): int64 {
  var crc: int64 := 0xFFFFFFFF;
  var i: int64 := 0;
  while (i < len) {
    crc := crc ^ (peek8(data + i) & 0xFF);
    var b: int64 := 0;
    while (b < 8) {
      if ((crc & 1) != 0) {
        crc := ((crc >> 1) & 0x7FFFFFFF) ^ (0 - 306674912);
      } else {
        crc := (crc >> 1) & 0x7FFFFFFF;
      }
      b := b + 1;
    }
    i := i + 1;
  }
  return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF;
}

// --- 1. CRC32 known test-vectors (RFC 3720 / standard IEEE 802.3) ---
fn testCrc32Vectors(): int64 {
  // All-zeros: CRC32("") = 0x00000000
  var empty: int64 := mmap(0, 8, 3, 34, -1, 0);
  var crcEmpty: int64 := refCrc32(empty, 0);
  if (crcEmpty != 0) { Print("FAIL: CRC32 empty\n"); return 1; }

  // "123456789" → 0xCBF43926
  var buf9: int64 := mmap(0, 16, 3, 34, -1, 0);
  poke8(buf9 + 0, 49); poke8(buf9 + 1, 50); poke8(buf9 + 2, 51);
  poke8(buf9 + 3, 52); poke8(buf9 + 4, 53); poke8(buf9 + 5, 54);
  poke8(buf9 + 6, 55); poke8(buf9 + 7, 56); poke8(buf9 + 8, 57);
  var crc9: int64 := refCrc32(buf9, 9);
  if (crc9 != 0xCBF43926) {
    Print("FAIL: CRC32 '123456789'\n");
    return 1;
  }

  // Single byte 0xFF → 0xFF000000 XOR poly chain...
  // Known CRC32 of [0x00] = 0xD202EF8D
  poke8(empty, 0);
  var crc1: int64 := refCrc32(empty, 1);
  if (crc1 != 0xD202EF8D) {
    Print("FAIL: CRC32 [0x00]\n");
    return 1;
  }
  Print("OK: CRC32 test vectors\n");
  return 0;
}

// --- 2. MetaSafeVerify() returns 0 on intact binary ---
fn testVerifyIntact(): int64 {
  var result: int64 := MetaSafeVerify();
  if (result != 0) {
    Print("FAIL: MetaSafeVerify() intact = ");
    PrintInt(result);
    Print("\n");
    return 1;
  }
  Print("OK: MetaSafeVerify() intact = 0\n");
  return 0;
}

// --- 3. MetaSafeGetPageHash() returns non-negative for page 0 ---
fn testGetHash(): int64 {
  var h: int64 := MetaSafeGetPageHash(0);
  if (h < 0) { Print("FAIL: GetPageHash(0)\n"); return 1; }
  Print("OK: MetaSafeGetPageHash(0) = ");
  PrintInt(h);
  Print("\n");
  return 0;
}

// --- 4. MetaSafeGetPageHash() returns -1 for out-of-bounds page ---
fn testGetHashOob(): int64 {
  var h: int64 := MetaSafeGetPageHash(9999);
  if (h != -1) { Print("FAIL: GetPageHash(9999) != -1\n"); return 1; }
  Print("OK: MetaSafeGetPageHash(9999) = -1\n");
  return 0;
}

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testCrc32Vectors();
  failed := failed + testVerifyIntact();
  failed := failed + testGetHash();
  failed := failed + testGetHashOob();
  if (failed != 0) {
    Print("FAILED\n");
    return 1;
  }
  Print("ALL PASSED\n");
  return 0;
}
