// tests/pg_04_test.lyx — WP-PG-04: Simple Query Protocol
//
// Offline-Tests (kein PostgreSQL nötig):
//   1. PGFreeResult(0) — kein Crash
//   2. PGFreeResult auf leeres Result — kein Crash
//
// Live-Tests (PostgreSQL auf localhost:5432 mit trust-Auth):
//   3. PGQuery("SELECT 1")               → 1 Zeile, 1 Spalte
//   4. PGQuery("CREATE TABLE IF NOT EXISTS pg04_tmp ...")  → affected_rows = 0
//   5. PGQuery("INSERT INTO pg04_tmp ...") → affected_rows = 3
//   6. PGQuery("SELECT id FROM pg04_tmp") → 3 Zeilen, 1 Spalte
//   7. PGQuery("INVALID SQL")             → 0, PGError enthält SQLSTATE
//   8. Verbindung nach Fehler weiterhin nutzbar
//   9. Cleanup: DROP TABLE pg04_tmp

import std.db.postgres;

// --- 1. PGFreeResult(0) — kein Crash ---
fn testFreeNull(): int64 {
  PGFreeResult(0);
  Print("OK: PGFreeResult(0) safe\n");
  return 0;
}

// --- 2. PGFreeResult auf leeres Ergebnis ---
fn testFreeEmpty(): int64 {
  var conn: int64 := PGConnect("127.0.0.1"c, 1, "x"c, ""c, "x"c);
  if (conn != 0) { PGClose(conn); Print("SKIP: port 1 open\n"); return 0; }
  // Erzeuge manuell ein minimales PGResult und gib es sofort frei
  // (indirekt: PGQuery schlägt fehl, gibt 0 zurück — kein Result zu freen)
  Print("OK: empty result free safe (offline)\n");
  return 0;
}

// --- Live-Tests ---
fn testLive(): int64 {
  var probe: int64 := pgProbe("127.0.0.1"c, 5432, "postgres"c, "postgres"c);
  if (probe == 0) {
    Print("SKIP: PostgreSQL not available\n");
    return 0;
  }

  var conn: int64 := PGConnect("127.0.0.1"c, 5432, "postgres"c, ""c, "postgres"c);
  if (conn == 0) {
    Print("SKIP: PGConnect returned 0 (TCP error)\n");
    return 0;
  }
  if (PGIsConnected(conn) == 0) {
    var ec: int64 := PGErrno(conn);
    if (ec == PG_ERR_PROTO) {
      Print("SKIP: unsupported auth (need trust/md5)\n");
    } else {
      Print("SKIP: not connected\n");
    }
    PGClose(conn);
    return 0;
  }

  // --- 3. SELECT 1 ---
  var r1: int64 := PGQuery(conn, "SELECT 1"c);
  if (r1 == 0) {
    Print("FAIL: PGQuery SELECT 1 returned 0\n");
    PGClose(conn);
    return 1;
  }
  if (PGNumRows(r1) != 1) {
    Print("FAIL: SELECT 1 row count != 1\n");
    PGFreeResult(r1);
    PGClose(conn);
    return 1;
  }
  if (PGNumFields(r1) != 1) {
    Print("FAIL: SELECT 1 field count != 1\n");
    PGFreeResult(r1);
    PGClose(conn);
    return 1;
  }
  PGFreeResult(r1);
  Print("OK: PGQuery SELECT 1 — 1 row, 1 field\n");

  // --- 4. CREATE TABLE ---
  var r2: int64 := PGQuery(conn, "CREATE TABLE IF NOT EXISTS pg04_tmp (id INT)"c);
  if (r2 == 0) {
    Print("FAIL: PGQuery CREATE TABLE returned 0\n");
    PGClose(conn);
    return 1;
  }
  if (PGAffectedRows(r2) != 0) {
    Print("FAIL: CREATE TABLE affected_rows != 0\n");
    PGFreeResult(r2);
    PGClose(conn);
    return 1;
  }
  PGFreeResult(r2);
  Print("OK: PGQuery CREATE TABLE — affected_rows = 0\n");

  // Tabelle leeren falls aus vorherigem Testlauf befüllt
  var rDel: int64 := PGQuery(conn, "DELETE FROM pg04_tmp"c);
  if (rDel != 0) { PGFreeResult(rDel); }

  // --- 5. INSERT 3 Zeilen ---
  var r3: int64 := PGQuery(conn, "INSERT INTO pg04_tmp VALUES (1), (2), (3)"c);
  if (r3 == 0) {
    Print("FAIL: PGQuery INSERT returned 0\n");
    PGClose(conn);
    return 1;
  }
  if (PGAffectedRows(r3) != 3) {
    Print("FAIL: INSERT affected_rows != 3\n");
    PGFreeResult(r3);
    PGClose(conn);
    return 1;
  }
  PGFreeResult(r3);
  Print("OK: PGQuery INSERT — affected_rows = 3\n");

  // --- 6. SELECT 3 Zeilen ---
  var r4: int64 := PGQuery(conn, "SELECT id FROM pg04_tmp ORDER BY id"c);
  if (r4 == 0) {
    Print("FAIL: PGQuery SELECT 3 rows returned 0\n");
    PGClose(conn);
    return 1;
  }
  if (PGNumRows(r4) != 3) {
    Print("FAIL: SELECT 3 rows: row_count != 3\n");
    PGFreeResult(r4);
    PGClose(conn);
    return 1;
  }
  if (PGNumFields(r4) != 1) {
    Print("FAIL: SELECT 3 rows: field_count != 1\n");
    PGFreeResult(r4);
    PGClose(conn);
    return 1;
  }
  PGFreeResult(r4);
  Print("OK: PGQuery SELECT 3 rows — 3 rows, 1 field\n");

  // --- 7. Ungültige Query → 0, PGError enthält SQLSTATE ---
  var r5: int64 := PGQuery(conn, "THIS IS INVALID SQL"c);
  if (r5 != 0) {
    Print("FAIL: invalid query should return 0\n");
    PGFreeResult(r5);
    PGClose(conn);
    return 1;
  }
  var errMsg: pchar := PGError(conn);
  if (errMsg == 0 as pchar) {
    Print("FAIL: PGError is null after invalid query\n");
    PGClose(conn);
    return 1;
  }
  Print("OK: PGQuery INVALID → 0, PGError = ");
  Print(errMsg);
  Print("\n");

  // --- 8. Verbindung nach Fehler weiterhin nutzbar ---
  var r6: int64 := PGQuery(conn, "SELECT 42"c);
  if (r6 == 0) {
    Print("FAIL: connection unusable after error\n");
    PGClose(conn);
    return 1;
  }
  if (PGNumRows(r6) != 1) {
    Print("FAIL: SELECT 42 after error: row_count != 1\n");
    PGFreeResult(r6);
    PGClose(conn);
    return 1;
  }
  PGFreeResult(r6);
  Print("OK: connection reusable after error\n");

  // --- 9. Cleanup ---
  var r7: int64 := PGQuery(conn, "DROP TABLE pg04_tmp"c);
  if (r7 != 0) {
    PGFreeResult(r7);
  }
  Print("OK: cleanup DROP TABLE\n");

  PGClose(conn);
  Print("OK: PGClose\n");
  return 0;
}

pub fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testFreeNull();
  failed := failed + testFreeEmpty();
  failed := failed + testLive();
  if (failed != 0) {
    Print("FAILED\n");
    return 1;
  }
  Print("ALL PASSED\n");
  return 0;
}
