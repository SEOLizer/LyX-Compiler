// tests/pdf_meta_test.lyx
// WP-PDF-07: document metadata (/Info dictionary)

@description("WP-PDF-07: document metadata test")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pdf_meta_test;

import std.pdf;

fn testFullMeta(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew\n"); return 1; }

  PdfSetTitle(doc, "WP-PDF-07 Test Document");
  PdfSetAuthor(doc, "Andreas Roene");
  PdfSetSubject(doc, "PDF library metadata test");
  PdfSetKeywords(doc, "pdf lyx test metadata");
  PdfSetCreator(doc, "Lyx std.pdf library");
  PdfSetProducer(doc, "aurum/lyxc 2026");

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 14.0);
  PdfTextAt(doc, page, 72.0, 750.0, "Document with /Info metadata");
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 10.0);
  PdfTextAt(doc, page, 72.0, 730.0, "Title: WP-PDF-07 Test Document");
  PdfTextAt(doc, page, 72.0, 716.0, "Author: Andreas Roene");
  PdfTextAt(doc, page, 72.0, 702.0, "Subject: PDF library metadata test");

  PdfSetCompression(doc, 1);
  var err: int64 := PdfSave(doc, "/tmp/pdf_meta_full.pdf");
  PdfFree(doc);
  if (err != 0) {
    PrintStr("FAIL: PdfSave (full meta) returned ");
    PrintInt(err);
    PrintStr("\n");
    return 1;
  }
  PrintStr("OK: metadata PDF saved to /tmp/pdf_meta_full.pdf\n");
  return 0;
}

fn testPartialMeta(): int64 {
  // Only some fields set — others should not appear in /Info
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew\n"); return 1; }

  PdfSetTitle(doc, "Partial Metadata Test");
  PdfSetAuthor(doc, "Test Author");
  // Subject, Keywords, Creator, Producer intentionally omitted

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "Partial metadata (title + author only)");

  var err: int64 := PdfSave(doc, "/tmp/pdf_meta_partial.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (partial meta)\n"); return 1; }
  PrintStr("OK: partial metadata PDF saved to /tmp/pdf_meta_partial.pdf\n");
  return 0;
}

fn testNoMeta(): int64 {
  // No metadata — /Info should not appear in trailer
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "No metadata set");

  var err: int64 := PdfSave(doc, "/tmp/pdf_meta_none.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (no meta)\n"); return 1; }
  PrintStr("OK: no-metadata PDF saved to /tmp/pdf_meta_none.pdf\n");
  return 0;
}

fn testSpecialCharsInMeta(): int64 {
  // Parentheses and backslashes in metadata must be escaped
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew\n"); return 1; }

  PdfSetTitle(doc, "Test (with parens) and \\backslash");
  PdfSetAuthor(doc, "O'Brien & Co.");

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "Metadata with special chars");

  var err: int64 := PdfSave(doc, "/tmp/pdf_meta_special.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (special chars meta)\n"); return 1; }
  PrintStr("OK: special-chars metadata PDF saved to /tmp/pdf_meta_special.pdf\n");
  return 0;
}

pub fn main(): int64 {
  if (testFullMeta()          != 0) { return 1; }
  if (testPartialMeta()       != 0) { return 1; }
  if (testNoMeta()            != 0) { return 1; }
  if (testSpecialCharsInMeta() != 0) { return 1; }
  PrintStr("All WP-PDF-07 metadata tests passed.\n");
  return 0;
}
