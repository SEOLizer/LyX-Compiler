// tests/decomp_test.lyx
// Selbstpruefende Testbatterie fuer std.decomp.
//
// Einzelne Zahlenwerte kommen aus numpy. Der groessere Teil prueft aber
// strukturell — und das ist hier nicht Bequemlichkeit, sondern noetig: die
// Spalten von U und V sind nur bis aufs Vorzeichen bestimmt (U und V gemeinsam
// gespiegelt ergibt dieselbe Zerlegung), und Eigenvektoren sind es bis auf
// einen Faktor. Ein Vergleich einzelner Komponenten mit numpy wuerde also
// zufaellig mal passen und mal nicht. Geprueft wird deshalb, was eindeutig
// IST: die Singulaerwerte, die Rekonstruktion, die Orthogonalitaet und die
// Moore-Penrose-Bedingungen.

unit main;

import std.decomp;
import std.linalg;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn TOL(): f64 { return 0.0000001; }

fn V(p: int64, i: int64): f64 {
  var v: f64 := peekf64(p + i * 8);
  return v;
}

fn Check(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > tol) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" (bool)\n"c);
  }
}

fn MaxDiff(a: int64, b: int64, cnt: int64): f64 {
  var worst: f64 := 0.0;
  var i: int64 := 0;
  while (i < cnt) {
    var d: f64 := AbsF64(V(a, i) - V(b, i));
    if (d > worst) { worst := d; }
    i := i + 1;
  }
  return worst;
}

// U * diag(s) * V^T nachbauen — der eine Test, der die ganze Zerlegung haelt
fn Reconstruct(u: int64, s: int64, v: int64, m: int64, n: int64, out: int64): void {
  var i: int64 := 0;
  while (i < m) {
    var j: int64 := 0;
    while (j < n) {
      var acc: f64 := 0.0;
      var k: int64 := 0;
      while (k < n) {
        acc := acc + LinGet(u, n, i, k) * V(s, k) * LinGet(v, n, j, k);
        k := k + 1;
      }
      LinSet(out, n, i, j, acc);
      j := j + 1;
    }
    i := i + 1;
  }
}

// Spaltenorthonormalitaet: M^T*M muss die Einheitsmatrix sein
fn OrthoError(mat: int64, rows: int64, cols: int64): f64 {
  var worst: f64 := 0.0;
  var i: int64 := 0;
  while (i < cols) {
    var j: int64 := 0;
    while (j < cols) {
      var acc: f64 := 0.0;
      var r: int64 := 0;
      while (r < rows) {
        acc := acc + LinGet(mat, cols, r, i) * LinGet(mat, cols, r, j);
        r := r + 1;
      }
      var want: f64 := 0.0;
      if (i == j) { want := 1.0; }
      var d: f64 := AbsF64(acc - want);
      if (d > worst) { worst := d; }
      j := j + 1;
    }
    i := i + 1;
  }
  return worst;
}

fn Fill32(a: int64): void {
  LinSet(a, 2, 0, 0, 1.0);  LinSet(a, 2, 0, 1, 2.0);
  LinSet(a, 2, 1, 0, 3.0);  LinSet(a, 2, 1, 1, 4.0);
  LinSet(a, 2, 2, 0, 5.0);  LinSet(a, 2, 2, 1, 6.0);
}

fn main(): int64 {
  // ── SVD einer 3x2-Matrix ──────────────────────────────────────────────────
  var a: int64 := alloc(6 * 8);
  var u: int64 := alloc(6 * 8);
  var s: int64 := alloc(2 * 8);
  var v: int64 := alloc(4 * 8);
  var rec: int64 := alloc(6 * 8);
  Fill32(a);

  CheckB("svdOk"c, DecompSvd(a, 3, 2, u, s, v), true);
  // Singulaerwerte sind eindeutig (numpy)
  Check("sv0"c, V(s, 0), 9.525518091565107, TOL());
  Check("sv1"c, V(s, 1), 0.5143005806586446, TOL());
  // absteigend
  CheckB("svSorted"c, V(s, 0) >= V(s, 1), true);

  Reconstruct(u, s, v, 3, 2, rec);
  Check("svdRecon"c, MaxDiff(rec, a, 6), 0.0, TOL());
  Check("uOrtho"c, OrthoError(u, 3, 2), 0.0, TOL());
  Check("vOrtho"c, OrthoError(v, 2, 2), 0.0, TOL());
  // die Eingabe bleibt unberuehrt
  Check("svdKeepsA"c, LinGet(a, 2, 0, 0), 1.0, TOL());

  // ohne V
  var s2: int64 := alloc(2 * 8);
  CheckB("svdNoV"c, DecompSvd(a, 3, 2, u, s2, 0), true);
  Check("svdNoVsame"c, MaxDiff(s, s2, 2), 0.0, TOL());
  CheckB("svdValuesOk"c, DecompSvdValues(a, 3, 2, s2), true);
  Check("svdValuesSame"c, MaxDiff(s, s2, 2), 0.0, TOL());
  free(s2, 2 * 8);

  // Fehlerpfade
  CheckB("svdWide"c, DecompSvd(a, 2, 3, u, s, v), false);
  CheckB("svdAlias"c, DecompSvd(a, 3, 2, a, s, v), false);

  // Normen und Kennzahlen (numpy)
  Check("norm2"c, DecompNorm2(a, 3, 2), 9.525518091565107, TOL());
  Check("cond2"c, DecompCond2(a, 3, 2), 18.52130534125813, 0.00001);
  CheckI("rank"c, DecompRank(a, 3, 2, 0.0), 2);

  // ── Rangdefekt ────────────────────────────────────────────────────────────
  // Zeile 2 = 2 * Zeile 1: Rang 1, zweiter Singulaerwert null
  var rd: int64 := alloc(6 * 8);
  LinSet(rd, 2, 0, 0, 1.0);  LinSet(rd, 2, 0, 1, 2.0);
  LinSet(rd, 2, 1, 0, 2.0);  LinSet(rd, 2, 1, 1, 4.0);
  LinSet(rd, 2, 2, 0, 3.0);  LinSet(rd, 2, 2, 1, 6.0);
  var srd: int64 := alloc(2 * 8);
  DecompSvdValues(rd, 3, 2, srd);
  Check("rdS1"c, V(srd, 1), 0.0, TOL());
  CheckI("rdRank"c, DecompRank(rd, 3, 2, 0.0), 1);
  // Kondition: singulaer, also 0 als Sonderfall
  Check("rdCond"c, DecompCond2(rd, 3, 2), 0.0, TOL());
  // Zerlegung traegt auch hier
  var urd: int64 := alloc(6 * 8);
  var vrd: int64 := alloc(4 * 8);
  DecompSvd(rd, 3, 2, urd, srd, vrd);
  Reconstruct(urd, srd, vrd, 3, 2, rec);
  Check("rdRecon"c, MaxDiff(rec, rd, 6), 0.0, TOL());
  free(urd, 6 * 8);  free(vrd, 4 * 8);

  // ── Pseudoinverse: die vier Moore-Penrose-Bedingungen ─────────────────────
  var pinv: int64 := alloc(6 * 8);     // 2x3
  CheckB("pinvOk"c, DecompPseudoInverse(a, 3, 2, 0.0, pinv), true);

  // A * A+ * A = A
  var ap: int64 := alloc(9 * 8);       // 3x3
  var apa: int64 := alloc(6 * 8);      // 3x2
  LinMul(a, pinv, 3, 2, 3, ap);
  LinMul(ap, a, 3, 3, 2, apa);
  Check("mp1"c, MaxDiff(apa, a, 6), 0.0, TOL());

  // A+ * A * A+ = A+
  var pa: int64 := alloc(4 * 8);       // 2x2
  var pap: int64 := alloc(6 * 8);      // 2x3
  LinMul(pinv, a, 2, 3, 2, pa);
  LinMul(pa, pinv, 2, 2, 3, pap);
  Check("mp2"c, MaxDiff(pap, pinv, 6), 0.0, TOL());

  // (A*A+) symmetrisch
  CheckB("mp3"c, LinIsSymmetric(ap, 3, 0.000001), true);
  // (A+*A) symmetrisch
  CheckB("mp4"c, LinIsSymmetric(pa, 2, 0.000001), true);

  // bei voller Spaltenzahl ist A+*A die Einheitsmatrix
  var id2: int64 := alloc(4 * 8);
  LinIdentity(id2, 2);
  Check("pinvLeftInv"c, MaxDiff(pa, id2, 4), 0.0, TOL());
  CheckB("pinvWide"c, DecompPseudoInverse(a, 2, 3, 0.0, pinv), false);
  free(ap, 9 * 8);  free(apa, 6 * 8);  free(pa, 4 * 8);  free(pap, 6 * 8);
  free(id2, 4 * 8);

  // ── Ausgleichsrechnung ueber die SVD ──────────────────────────────────────
  // Punkte (1,2.1) (2,3.9) (3,6.2) (4,7.8) an y = c0 + c1*x
  var A42: int64 := alloc(8 * 8);
  LinSet(A42, 2, 0, 0, 1.0);  LinSet(A42, 2, 0, 1, 1.0);
  LinSet(A42, 2, 1, 0, 1.0);  LinSet(A42, 2, 1, 1, 2.0);
  LinSet(A42, 2, 2, 0, 1.0);  LinSet(A42, 2, 2, 1, 3.0);
  LinSet(A42, 2, 3, 0, 1.0);  LinSet(A42, 2, 3, 1, 4.0);
  var b4: int64 := alloc(4 * 8);
  pokef64(b4,      2.1);  pokef64(b4 +  8, 3.9);
  pokef64(b4 + 16, 6.2);  pokef64(b4 + 24, 7.8);
  var x2: int64 := alloc(2 * 8);
  CheckB("lstsqOk"c, DecompLstSq(A42, 4, 2, b4, 0.0, x2), true);
  // dieselben Werte wie LinLstSq (QR) — zwei Verfahren, ein Ergebnis
  Check("lstsq0"c, V(x2, 0), 0.15, 0.000001);
  Check("lstsq1"c, V(x2, 1), 1.94, 0.000001);

  var xq: int64 := alloc(2 * 8);
  LinLstSq(A42, 4, 2, b4, xq);
  Check("svdEqQr"c, MaxDiff(x2, xq, 2), 0.0, 0.000001);
  free(xq, 2 * 8);

  // Rangdefekt: die QR-Fassung scheitert, die SVD liefert die Loesung
  // kleinster Norm
  var rdA: int64 := alloc(8 * 8);
  LinSet(rdA, 2, 0, 0, 1.0);  LinSet(rdA, 2, 0, 1, 2.0);
  LinSet(rdA, 2, 1, 0, 2.0);  LinSet(rdA, 2, 1, 1, 4.0);
  LinSet(rdA, 2, 2, 0, 3.0);  LinSet(rdA, 2, 2, 1, 6.0);
  LinSet(rdA, 2, 3, 0, 4.0);  LinSet(rdA, 2, 3, 1, 8.0);
  var rdB: int64 := alloc(4 * 8);
  pokef64(rdB,      1.0);  pokef64(rdB +  8, 2.0);
  pokef64(rdB + 16, 3.0);  pokef64(rdB + 24, 4.0);
  var rdX: int64 := alloc(2 * 8);
  CheckB("lstsqRankDef"c, DecompLstSq(rdA, 4, 2, rdB, 0.0, rdX), true);
  CheckB("qrFailsRankDef"c, LinLstSq(rdA, 4, 2, rdB, xq), false);
  // Loesung erfuellt die Normalgleichung: A^T(Ax-b) = 0
  var rdY: int64 := alloc(4 * 8);
  LinMulVec(rdA, 4, 2, rdX, rdY);
  var resid: f64 := 0.0;
  var i: int64 := 0;
  while (i < 2) {
    var acc: f64 := 0.0;
    var r: int64 := 0;
    while (r < 4) {
      acc := acc + LinGet(rdA, 2, r, i) * (V(rdY, r) - V(rdB, r));
      r := r + 1;
    }
    if (AbsF64(acc) > resid) { resid := AbsF64(acc); }
    i := i + 1;
  }
  Check("rankDefNormal"c, resid, 0.0, 0.000001);
  free(rdA, 8 * 8);  free(rdB, 4 * 8);  free(rdX, 2 * 8);  free(rdY, 4 * 8);

  // ── Rang-k-Naeherung ──────────────────────────────────────────────────────
  var lr: int64 := alloc(6 * 8);
  CheckB("lowRankOk"c, DecompLowRank(a, 3, 2, 1, lr), true);
  // Eckart-Young: der Fehler in der Spektralnorm ist genau s_(k+1)
  var diff: int64 := alloc(6 * 8);
  LinSub(a, lr, 3, 2, diff);
  Check("eckartYoung"c, DecompNorm2(diff, 3, 2), 0.5143005806586446, 0.000001);
  // k = n gibt die Matrix zurueck
  DecompLowRank(a, 3, 2, 2, lr);
  Check("lowRankFull"c, MaxDiff(lr, a, 6), 0.0, TOL());
  // k = 0 gibt die Nullmatrix
  DecompLowRank(a, 3, 2, 0, lr);
  Check("lowRankZero"c, LinNormFro(lr, 3, 2), 0.0, TOL());
  // k groesser als n wird geklemmt, nicht abgelehnt
  CheckB("lowRankClamp"c, DecompLowRank(a, 3, 2, 99, lr), true);
  Check("lowRankClampVal"c, MaxDiff(lr, a, 6), 0.0, TOL());
  free(lr, 6 * 8);  free(diff, 6 * 8);

  // ── Polare Zerlegung ──────────────────────────────────────────────────────
  var sq: int64 := alloc(9 * 8);
  LinSet(sq, 3, 0, 0,  1.2);  LinSet(sq, 3, 0, 1, 0.3);  LinSet(sq, 3, 0, 2, 0.0);
  LinSet(sq, 3, 1, 0, -0.2);  LinSet(sq, 3, 1, 1, 0.9);  LinSet(sq, 3, 1, 2, 0.1);
  LinSet(sq, 3, 2, 0,  0.0);  LinSet(sq, 3, 2, 1, 0.1);  LinSet(sq, 3, 2, 2, 1.1);
  var pq: int64 := alloc(9 * 8);
  var pp: int64 := alloc(9 * 8);
  CheckB("polarOk"c, DecompPolar(sq, 3, pq, pp), true);
  Check("polarQOrtho"c, OrthoError(pq, 3, 3), 0.0, TOL());
  CheckB("polarPSym"c, LinIsSymmetric(pp, 3, 0.000001), true);
  var qp: int64 := alloc(9 * 8);
  LinMul(pq, pp, 3, 3, 3, qp);
  Check("polarRecon"c, MaxDiff(qp, sq, 9), 0.0, TOL());
  // P ist positiv definit, weil A regulaer ist
  CheckB("polarPPosDef"c, LinIsPosDef(pp, 3), true);
  free(pq, 9 * 8);  free(pp, 9 * 8);  free(qp, 9 * 8);

  // ── Hessenberg ────────────────────────────────────────────────────────────
  var g4: int64 := alloc(16 * 8);
  LinSet(g4, 4, 0, 0, 4.0);  LinSet(g4, 4, 0, 1, 1.0);  LinSet(g4, 4, 0, 2, -2.0); LinSet(g4, 4, 0, 3, 2.0);
  LinSet(g4, 4, 1, 0, 1.0);  LinSet(g4, 4, 1, 1, 2.0);  LinSet(g4, 4, 1, 2, 0.0);  LinSet(g4, 4, 1, 3, 1.0);
  LinSet(g4, 4, 2, 0, -2.0); LinSet(g4, 4, 2, 1, 0.0);  LinSet(g4, 4, 2, 2, 3.0);  LinSet(g4, 4, 2, 3, -2.0);
  LinSet(g4, 4, 3, 0, 2.0);  LinSet(g4, 4, 3, 1, 1.0);  LinSet(g4, 4, 3, 2, -2.0); LinSet(g4, 4, 3, 3, -1.0);

  var hb: int64 := alloc(16 * 8);
  var qh: int64 := alloc(16 * 8);
  CheckB("hessOk"c, DecompHessenberg(g4, 4, hb, qh), true);
  // unterhalb der ersten Nebendiagonale muss alles null sein
  Check("hess20"c, LinGet(hb, 4, 2, 0), 0.0, TOL());
  Check("hess30"c, LinGet(hb, 4, 3, 0), 0.0, TOL());
  Check("hess31"c, LinGet(hb, 4, 3, 1), 0.0, TOL());
  // Spur bleibt erhalten (Aehnlichkeitstransformation)
  Check("hessTrace"c, LinTrace(hb, 4), LinTrace(g4, 4), TOL());
  CheckB("hessAlias"c, DecompHessenberg(g4, 4, g4, 0), false);
  free(qh, 16 * 8);

  // ── Eigenwerte allgemeiner Matrizen ───────────────────────────────────────
  var re: int64 := alloc(4 * 8);
  var im: int64 := alloc(4 * 8);

  // obere Dreiecksmatrix: Eigenwerte stehen auf der Diagonale
  var tri: int64 := alloc(9 * 8);
  LinSet(tri, 3, 0, 0, 4.0);  LinSet(tri, 3, 0, 1, 1.0);  LinSet(tri, 3, 0, 2, 0.0);
  LinSet(tri, 3, 1, 0, 0.0);  LinSet(tri, 3, 1, 1, 3.0);  LinSet(tri, 3, 1, 2, 1.0);
  LinSet(tri, 3, 2, 0, 0.0);  LinSet(tri, 3, 2, 1, 0.0);  LinSet(tri, 3, 2, 2, 2.0);
  CheckB("eigTriOk"c, DecompEigenGeneral(tri, 3, re, im), true);
  // Reihenfolge ist nicht festgelegt — geprueft wird ueber Summe und Produkt
  var sumEv: f64 := V(re, 0) + V(re, 1) + V(re, 2);
  var prodEv: f64 := V(re, 0) * V(re, 1) * V(re, 2);
  Check("eigTriSum"c, sumEv, 9.0, TOL());
  Check("eigTriProd"c, prodEv, 24.0, 0.000001);
  Check("eigTriIm"c, AbsF64(V(im, 0)) + AbsF64(V(im, 1)) + AbsF64(V(im, 2)), 0.0, TOL());

  // Drehmatrix: rein imaginaeres Paar +i / -i
  var rot: int64 := alloc(4 * 8);
  LinSet(rot, 2, 0, 0, 0.0);  LinSet(rot, 2, 0, 1, -1.0);
  LinSet(rot, 2, 1, 0, 1.0);  LinSet(rot, 2, 1, 1, 0.0);
  CheckB("eigRotOk"c, DecompEigenGeneral(rot, 2, re, im), true);
  Check("eigRotRe0"c, V(re, 0), 0.0, TOL());
  Check("eigRotRe1"c, V(re, 1), 0.0, TOL());
  Check("eigRotImAbs"c, AbsF64(V(im, 0)), 1.0, TOL());
  // konjugiertes Paar: die Imaginaerteile heben sich auf
  Check("eigRotConj"c, V(im, 0) + V(im, 1), 0.0, TOL());
  free(rot, 4 * 8);

  // allgemeine 4x4: Spur = Summe, Determinante = Produkt der Eigenwerte
  CheckB("eigGenOk"c, DecompEigenGeneral(g4, 4, re, im), true);
  var sum4: f64 := 0.0;
  i := 0;
  while (i < 4) {
    sum4 := sum4 + V(re, i);
    i := i + 1;
  }
  Check("eigGenTrace"c, sum4, LinTrace(g4, 4), 0.000001);

  // Produkt komplexer Zahlen: (a+bi)(c+di)
  var pr: f64 := 1.0;
  var pi2: f64 := 0.0;
  i := 0;
  while (i < 4) {
    var xr: f64 := V(re, i);
    var xi: f64 := V(im, i);
    var nr: f64 := pr * xr - pi2 * xi;
    var ni: f64 := pr * xi + pi2 * xr;
    pr := nr;
    pi2 := ni;
    i := i + 1;
  }
  Check("eigGenDet"c, pr, LinDet(g4, 4), 0.00001);
  Check("eigGenDetIm"c, pi2, 0.0, 0.00001);

  // symmetrische Matrix: dieselben Eigenwerte wie ueber LinEigenSym
  var sym: int64 := alloc(9 * 8);
  LinSet(sym, 3, 0, 0,  4.0);  LinSet(sym, 3, 0, 1, -2.0);  LinSet(sym, 3, 0, 2,  1.0);
  LinSet(sym, 3, 1, 0, -2.0);  LinSet(sym, 3, 1, 1,  4.0);  LinSet(sym, 3, 1, 2, -2.0);
  LinSet(sym, 3, 2, 0,  1.0);  LinSet(sym, 3, 2, 1, -2.0);  LinSet(sym, 3, 2, 2,  4.0);
  DecompEigenGeneral(sym, 3, re, im);
  var symSum: f64 := V(re, 0) + V(re, 1) + V(re, 2);
  Check("eigSymAgree"c, symSum, 12.0, 0.000001);
  var evJ: int64 := alloc(3 * 8);
  LinEigenSym(sym, 3, evJ, 0);
  var jSum: f64 := V(evJ, 0) + V(evJ, 1) + V(evJ, 2);
  Check("eigTwoWays"c, symSum, jSum, 0.000001);
  free(evJ, 3 * 8);

  // Spektralradius
  Check("spectralRot"c, DecompSpectralRadius(tri, 3), 4.0, 0.000001);

  // ── Eigenvektor per inverser Iteration ────────────────────────────────────
  var vec: int64 := alloc(3 * 8);
  CheckB("eigVecOk"c, DecompEigenVector(tri, 3, 4.0, vec), true);
  // A*v = lambda*v pruefen
  var av: int64 := alloc(3 * 8);
  LinMulVec(tri, 3, 3, vec, av);
  var worstEv: f64 := 0.0;
  i := 0;
  while (i < 3) {
    var d: f64 := AbsF64(V(av, i) - 4.0 * V(vec, i));
    if (d > worstEv) { worstEv := d; }
    i := i + 1;
  }
  Check("eigVecResidual"c, worstEv, 0.0, 0.00001);
  // normiert
  var len: f64 := 0.0;
  i := 0;
  while (i < 3) {
    var c: f64 := V(vec, i);
    len := len + c * c;
    i := i + 1;
  }
  Check("eigVecNorm"c, len, 1.0, 0.00001);

  // auch fuer die symmetrische Matrix, groesster Eigenwert
  CheckB("eigVecSymOk"c, DecompEigenVector(sym, 3, 7.372281323269014, vec), true);
  LinMulVec(sym, 3, 3, vec, av);
  worstEv := 0.0;
  i := 0;
  while (i < 3) {
    var d2: f64 := AbsF64(V(av, i) - 7.372281323269014 * V(vec, i));
    if (d2 > worstEv) { worstEv := d2; }
    i := i + 1;
  }
  Check("eigVecSymResid"c, worstEv, 0.0, 0.0001);
  free(vec, 3 * 8);  free(av, 3 * 8);  free(sym, 9 * 8);  free(tri, 9 * 8);

  free(a, 6 * 8);  free(u, 6 * 8);  free(s, 2 * 8);  free(v, 4 * 8);  free(rec, 6 * 8);
  free(rd, 6 * 8);  free(srd, 2 * 8);  free(pinv, 6 * 8);
  free(A42, 8 * 8);  free(b4, 4 * 8);  free(x2, 2 * 8);
  free(sq, 9 * 8);  free(g4, 16 * 8);  free(hb, 16 * 8);
  free(re, 4 * 8);  free(im, 4 * 8);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
