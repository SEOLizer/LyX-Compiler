// demo_pg_notify.lyx — WP-PG-12 Demo 5: LISTEN / NOTIFY
//
// conn1 LISTEN, conn2 NOTIFY, conn1 PGGetNotification.
// Gibt Channel, Payload und Sender-PID aus.

import std.db.postgres;

fn connect(): int64 {
  var conn: int64 := PGConnect("127.0.0.1"c, 5432, "postgres"c, ""c, "postgres"c);
  if (conn == 0) { return 0; }
  if (PGIsConnected(conn) == 0) { PGClose(conn); return 0; }
  return conn;
}

pub fn main(): int64 {
  var probe: int64 := pgProbe("127.0.0.1"c, 5432, "postgres"c, "postgres"c);
  if (probe == 0) { PrintStr("SKIP: PostgreSQL not available\n"); return 0; }

  var conn1: int64 := connect();
  if (conn1 == 0) { PrintStr("SKIP: unsupported auth (need trust/md5)\n"); return 0; }

  var conn2: int64 := connect();
  if (conn2 == 0) {
    PrintStr("SKIP: second connection failed\n");
    PGClose(conn1); return 0;
  }

  // conn1: LISTEN
  if (PGListen(conn1, "pg_demo_ch"c) == 0) {
    PrintStr("FAIL: PGListen\n"); PGClose(conn1); PGClose(conn2); return 1;
  }
  PrintStr("conn1: LISTEN pg_demo_ch\n");

  // conn2: NOTIFY with payload
  if (PGNotify(conn2, "pg_demo_ch"c, "Hello from Demo 5!"c) == 0) {
    PrintStr("FAIL: PGNotify\n"); PGClose(conn1); PGClose(conn2); return 1;
  }
  PrintStr("conn2: NOTIFY pg_demo_ch 'Hello from Demo 5!'\n");

  // conn1: flush incoming via a trivial query to receive the async notify
  var rFlush: int64 := PGQuery(conn1, "SELECT 1"c);
  if (rFlush != 0) { PGFreeResult(rFlush); }

  // conn1: read notification
  var notif: int64 := PGGetNotification(conn1);
  if (notif == 0) {
    // Try waiting briefly
    notif := PGWaitNotification(conn1, 200);
  }
  if (notif == 0) {
    PrintStr("SKIP: notification not received (delivery timing)\n");
    PGUnlisten(conn1, "pg_demo_ch"c);
    PGClose(conn1); PGClose(conn2); return 0;
  }

  PrintStr("conn1: notification received!\n");
  PrintStr("  channel = "); PrintStr(PGNotifChannel(notif)); PrintStr("\n");
  PrintStr("  payload = "); PrintStr(PGNotifPayload(notif)); PrintStr("\n");
  PrintStr("  sender pid = "); PrintInt(PGNotifPid(notif)); PrintStr("\n");
  PrintStr("  conn2 pid   = "); PrintInt(PGBackendPID(conn2)); PrintStr("\n");
  PGFreeNotification(notif);

  PGUnlisten(conn1, "pg_demo_ch"c);
  PGClose(conn1);
  PGClose(conn2);
  PrintStr("OK\n");
  return 0;
}
