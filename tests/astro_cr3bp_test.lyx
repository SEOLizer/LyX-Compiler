// tests/astro_cr3bp_test.lyx
// Selbstpruefende Batterie fuer std.astro.cr3bp (#1997).
//
// Die Sollwerte kommen aus drei Quellen, keine davon die geprueften Formeln:
//
//   1. GESCHLOSSENE Eigenschaften, die keinen Literaturwert brauchen: L4 und
//      L5 bilden mit beiden Massen ein gleichseitiges Dreieck, und an jedem
//      der fuenf Punkte verschwindet der Gradient des effektiven Potentials.
//      Die zweite ist die DEFINIERENDE Eigenschaft eines Librationspunkts —
//      sie prueft nicht, ob die Zahl stimmt, sondern ob der Punkt einer ist;
//   2. Literaturwerte: Sonne-Erde L1 bei 1.491e6 km und L2 bei 1.501e6 km von
//      der Erde — dort sitzen SOHO und JWST. Erde-Mond L1 bei rund 326000 km
//      von der Erde;
//   3. Nullstellen der Polynome: der gefundene Wert MUSS das jeweilige
//      Polynom fuenften Grades erfuellen. Das trennt "Newton ist irgendwohin
//      gelaufen" von "Newton hat die Wurzel gefunden".
//
// Der Gradiententest ist der tragende: eine Aufzaehlung von Abstaenden waere
// auch von einem Rechenfehler erfuellt, der alle fuenf gleich verschiebt.

unit main;

import std.io;
import std.math;
import std.astro.state;
import std.astro.cr3bp;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn CheckRel(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  var d: f64 := AbsF64(got - want);
  var s: f64 := AbsF64(want);
  if (s < 1.0) { s := 1.0; }
  if (d / s <= tol) { PrintStr("PASS "c); PrintStrLn(name); }
  else {
    PrintStr("FAIL "c); PrintStr(name);
    PrintStr(": erhalten "c); PrintF64(got);
    PrintStr(" erwartet "c); PrintF64(want); PrintLn(""c);
    _fails := _fails + 1;
  }
}

fn CheckWahr(name: pchar, got: bool): void {
  _checks := _checks + 1;
  if (got) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStr(name); PrintStrLn(" (erwartet: wahr)"c); _fails := _fails + 1; }
}

// Numerischer Gradient des effektiven Potentials in der Bahnebene. An einem
// Librationspunkt muss er verschwinden — das ist ihre Definition.
fn GradBetrag(mu: f64, p: AVec3): f64 {
  var h: f64 := 0.000001;
  var ux: f64 := (AEffectivePotential(mu, AVec(p.x + h, p.y, 0.0))
                - AEffectivePotential(mu, AVec(p.x - h, p.y, 0.0))) / (2.0 * h);
  var uy: f64 := (AEffectivePotential(mu, AVec(p.x, p.y + h, 0.0))
                - AEffectivePotential(mu, AVec(p.x, p.y - h, 0.0))) / (2.0 * h);
  return SqrtF64(ux * ux + uy * uy);
}

fn main(): int64 {
  var se: f64 := AMuSunEarth();
  var em: f64 := AMuEarthMoon();
  var au: f64 := 149597870700.0;
  var dEM: f64 := 384400000.0;

  // --- Massenparameter --------------------------------------------------
  CheckRel("mu aus zwei gleichen Massen ist 0.5"c, ACr3bpMu(1.0, 1.0), 0.5, 0.000000001);
  CheckRel("mu Sonne-Erde"c, ACr3bpMu(332946.0, 1.0), 0.000003003, 0.001);
  CheckWahr("Masse null meldet"c, AIsError(ACr3bpMu(1.0, 0.0)));

  // --- Die Punkte gegen die Literatur ----------------------------------
  CheckRel("Sonne-Erde L1 bei 1.491 Mio km von der Erde"c,
           ADistanceToSecondary(ALagrange1(se), se, au) / 1.0e9, 1.4916, 0.001);
  CheckRel("Sonne-Erde L2 bei 1.501 Mio km von der Erde"c,
           ADistanceToSecondary(ALagrange2(se), se, au) / 1.0e9, 1.5015, 0.001);
  // Erde-Mond L1: 58000 km vom Mond, also rund 326000 km von der Erde.
  CheckRel("Erde-Mond L1 rund 326000 km von der Erde"c,
           (dEM - ADistanceToSecondary(ALagrange1(em), em, dEM)) / 1000.0, 326000.0, 0.002);

  // --- Geschlossene Eigenschaften --------------------------------------
  //
  // L4 bildet mit BEIDEN Massen ein gleichseitiges Dreieck der Seitenlaenge 1.
  // Diese Pruefung braucht keinen Literaturwert und faengt jeden Fehler im
  // Vorfaktor.
  var l4: AVec3 := ALagrange4(em);
  CheckRel("L4 hat Abstand 1 zur grossen Masse"c,
           AMagnitude(ASub(l4, AVec(0.0 - em, 0.0, 0.0))), 1.0, 0.000000001);
  CheckRel("L4 hat Abstand 1 zur kleinen Masse"c,
           AMagnitude(ASub(l4, AVec(1.0 - em, 0.0, 0.0))), 1.0, 0.000000001);
  var l5: AVec3 := ALagrange5(em);
  CheckRel("L5 liegt spiegelbildlich zu L4"c, l5.y, 0.0 - l4.y, 0.000000001);
  CheckRel("L5 hat dieselbe x-Lage wie L4"c, l5.x, l4.x, 0.000000001);

  // Die Reihenfolge auf der Linie: L3 links der grossen Masse, dann L1, dann
  // die kleine Masse, dann L2. Eine vertauschte Wurzel faellt hier auf.
  CheckWahr("L3 liegt links der grossen Masse"c, ALagrange3(em).x < 0.0 - em);
  CheckWahr("L1 liegt zwischen den Massen"c,
            ALagrange1(em).x > 0.0 - em && ALagrange1(em).x < 1.0 - em);
  CheckWahr("L2 liegt jenseits der kleinen Masse"c, ALagrange2(em).x > 1.0 - em);

  // --- Der Gradiententest: die DEFINIERENDE Eigenschaft ------------------
  //
  // An einem Librationspunkt verschwindet der Gradient des effektiven
  // Potentials. Das prueft nicht, ob die Zahl stimmt, sondern ob der Punkt
  // ueberhaupt einer ist — und es faengt einen Fehler, der alle fuenf gleich
  // verschoebe und den die Abstandspruefungen oben durchliessen.
  CheckWahr("L1 ist ein Gleichgewichtspunkt"c, GradBetrag(em, ALagrange1(em)) < 0.00001);
  CheckWahr("L2 ist ein Gleichgewichtspunkt"c, GradBetrag(em, ALagrange2(em)) < 0.00001);
  CheckWahr("L3 ist ein Gleichgewichtspunkt"c, GradBetrag(em, ALagrange3(em)) < 0.00001);
  CheckWahr("L4 ist ein Gleichgewichtspunkt"c, GradBetrag(em, ALagrange4(em)) < 0.00001);
  CheckWahr("L5 ist ein Gleichgewichtspunkt"c, GradBetrag(em, ALagrange5(em)) < 0.00001);
  // Gegenprobe: ein beliebiger anderer Punkt ist KEINER. Ohne sie waere der
  // Test auch von einem Gradienten erfuellt, der immer null liefert.
  CheckWahr("ein beliebiger Punkt ist keiner"c, GradBetrag(em, AVec(0.7, 0.3, 0.0)) > 0.01);

  // --- Hill-Radius ------------------------------------------------------
  //
  // L1 und L2 liegen dicht am Hill-Radius — das ist der Grund, warum er als
  // Startwert taugt. Gleich sind sie ihm nicht.
  var rh: f64 := AHillRadius(dEM, em);
  var d1: f64 := ADistanceToSecondary(ALagrange1(em), em, dEM);
  CheckWahr("L1 liegt in der Groessenordnung des Hill-Radius"c,
            d1 > 0.7 * rh && d1 < 1.3 * rh);
  CheckWahr("aber nicht auf ihm"c, AbsF64(d1 - rh) / rh > 0.01);

  // --- Jacobi-Konstante -------------------------------------------------
  //
  // Sie ist die Erhaltungsgroesse; hier wird zunaechst nur geprueft, dass sie
  // sich richtig zusammensetzt: ohne Geschwindigkeit ist sie das doppelte
  // Potential, und Geschwindigkeit senkt sie um v^2.
  var p: AVec3 := AVec(0.8, 0.1, 0.0);
  CheckRel("ohne Tempo ist C das doppelte Potential"c,
           AJacobiConstant(em, p, AVec(0.0, 0.0, 0.0)),
           2.0 * AEffectivePotential(em, p), 0.000000001);
  CheckRel("Tempo senkt C um v^2"c,
           AJacobiConstant(em, p, AVec(0.3, 0.4, 0.0)),
           AJacobiConstant(em, p, AVec(0.0, 0.0, 0.0)) - 0.25, 0.000000001);
  // Auf einer Masse ist sie nicht bestimmbar.
  CheckWahr("auf der kleinen Masse meldet C"c,
            AIsError(AJacobiConstant(em, AVec(1.0 - em, 0.0, 0.0), AVec(0.0, 0.0, 0.0))));

  // --- Fehlerpfade ------------------------------------------------------
  CheckWahr("mu ausserhalb (0,1) meldet"c, AIsError(ALagrange1Gamma(1.5)));
  CheckWahr("mu null meldet"c, AIsError(ALagrange2Gamma(0.0)));
  CheckWahr("negative Trennung meldet"c,
            AIsError(ADistanceToSecondary(ALagrange1(em), em, 0.0 - 1.0)));

  PrintStr("\n"c);
  PrintInt(_checks); PrintStr(" Pruefungen, "c);
  PrintInt(_fails); PrintStrLn(" FAIL"c);
  if (_fails == 0) { PrintStrLn("OK: std.astro.cr3bp"c); return 0; }
  return 1;
}
