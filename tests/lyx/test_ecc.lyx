// Test: std/crypto/ecc — secp256k1 ECDSA (WP-BL-01 FIPS 186-4 Testvektoren)
import std.crypto.ecc;

fn bytesEq(a: int64, b: int64, n: int64): int64 {
    var i: int64 := 0;
    while (i < n) {
        if (peek8(a + i) != peek8(b + i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

fn printHex(buf: int64, n: int64): void {
    var hex: pchar := "0123456789abcdef";
    var i: int64 := 0;
    while (i < n) {
        var b: int64 := peek8(buf + i);
        Print(peek8(hex as int64 + (b >> 4)) as pchar);
        Print(peek8(hex as int64 + (b & 0xF)) as pchar);
        i := i + 1;
    }
}

pub fn main(argc: int64, argv: pchar): int64 {
    PrintLn("=== secp256k1 ECDSA Tests (WP-BL-01) ===");

    var priv: int64 := mmap(0, 32, 3, 34, -1, 0);
    var pubx: int64 := mmap(0, 32, 3, 34, -1, 0);
    var puby: int64 := mmap(0, 32, 3, 34, -1, 0);
    var r:    int64 := mmap(0, 32, 3, 34, -1, 0);
    var s:    int64 := mmap(0, 32, 3, 34, -1, 0);
    var hash: int64 := mmap(0, 32, 3, 34, -1, 0);

    // ----------------------------------------------------------------
    // Test 1: privkey = 1  →  pubkey = G
    // Expected Gx (LE): 98 17 F8 16 5B 81 F2 59 D9 28 CE 2D DB FC 9B 02
    //                   07 0B 87 CE 95 62 A0 55 AC BB DC F9 7E 66 BE 79
    // ----------------------------------------------------------------
    var i: int64 := 0;
    while (i < 32) { poke8(priv + i, 0); i := i + 1; }
    poke8(priv, 1);
    ECCPubFromPriv(priv, pubx, puby);

    var expGx: int64 := mmap(0, 32, 3, 34, -1, 0);
    poke8(expGx+ 0,0x98); poke8(expGx+ 1,0x17); poke8(expGx+ 2,0xF8); poke8(expGx+ 3,0x16);
    poke8(expGx+ 4,0x5B); poke8(expGx+ 5,0x81); poke8(expGx+ 6,0xF2); poke8(expGx+ 7,0x59);
    poke8(expGx+ 8,0xD9); poke8(expGx+ 9,0x28); poke8(expGx+10,0xCE); poke8(expGx+11,0x2D);
    poke8(expGx+12,0xDB); poke8(expGx+13,0xFC); poke8(expGx+14,0x9B); poke8(expGx+15,0x02);
    poke8(expGx+16,0x07); poke8(expGx+17,0x0B); poke8(expGx+18,0x87); poke8(expGx+19,0xCE);
    poke8(expGx+20,0x95); poke8(expGx+21,0x62); poke8(expGx+22,0xA0); poke8(expGx+23,0x55);
    poke8(expGx+24,0xAC); poke8(expGx+25,0xBB); poke8(expGx+26,0xDC); poke8(expGx+27,0xF9);
    poke8(expGx+28,0x7E); poke8(expGx+29,0x66); poke8(expGx+30,0xBE); poke8(expGx+31,0x79);

    var expGy: int64 := mmap(0, 32, 3, 34, -1, 0);
    poke8(expGy+ 0,0xB8); poke8(expGy+ 1,0xD4); poke8(expGy+ 2,0x10); poke8(expGy+ 3,0xFB);
    poke8(expGy+ 4,0x8F); poke8(expGy+ 5,0xD0); poke8(expGy+ 6,0x47); poke8(expGy+ 7,0x9C);
    poke8(expGy+ 8,0x19); poke8(expGy+ 9,0x54); poke8(expGy+10,0x85); poke8(expGy+11,0xA6);
    poke8(expGy+12,0x48); poke8(expGy+13,0xB4); poke8(expGy+14,0x17); poke8(expGy+15,0xFD);
    poke8(expGy+16,0xA8); poke8(expGy+17,0x08); poke8(expGy+18,0x11); poke8(expGy+19,0x0E);
    poke8(expGy+20,0xFC); poke8(expGy+21,0xFB); poke8(expGy+22,0xA4); poke8(expGy+23,0x5D);
    poke8(expGy+24,0x65); poke8(expGy+25,0xC4); poke8(expGy+26,0xA3); poke8(expGy+27,0x26);
    poke8(expGy+28,0x77); poke8(expGy+29,0xDA); poke8(expGy+30,0x3A); poke8(expGy+31,0x48);

    if (bytesEq(pubx, expGx, 32) == 1 && bytesEq(puby, expGy, 32) == 1) {
        PrintLn("OK: 1*G == G");
    } else {
        Print("FAIL: 1*G x="); printHex(pubx, 32); PrintLn("");
        Print("          y="); printHex(puby, 32); PrintLn("");
        return 1;
    }
    munmap(expGx, 32); munmap(expGy, 32);

    // ----------------------------------------------------------------
    // Test 2: privkey = 2  →  pubkey = 2G
    // 2G.x = C6047F9441ED7D6D3045406E95C07CD85C778E4B8CEF3CA7ABAC09B95C709EE5 (BE)
    // 2G.y = 1AE168FEA63DC339A3C58419466CEAEEF7F632653266D0E1236431A950CFE52A (BE)
    // ----------------------------------------------------------------
    i := 0;
    while (i < 32) { poke8(priv + i, 0); i := i + 1; }
    poke8(priv, 2);
    ECCPubFromPriv(priv, pubx, puby);

    var exp2Gx: int64 := mmap(0, 32, 3, 34, -1, 0);
    poke8(exp2Gx+ 0,0xE5); poke8(exp2Gx+ 1,0x9E); poke8(exp2Gx+ 2,0x70); poke8(exp2Gx+ 3,0x5C);
    poke8(exp2Gx+ 4,0xB9); poke8(exp2Gx+ 5,0x09); poke8(exp2Gx+ 6,0xAC); poke8(exp2Gx+ 7,0xAB);
    poke8(exp2Gx+ 8,0xA7); poke8(exp2Gx+ 9,0x3C); poke8(exp2Gx+10,0xEF); poke8(exp2Gx+11,0x8C);
    poke8(exp2Gx+12,0x4B); poke8(exp2Gx+13,0x8E); poke8(exp2Gx+14,0x77); poke8(exp2Gx+15,0x5C);
    poke8(exp2Gx+16,0xD8); poke8(exp2Gx+17,0x7C); poke8(exp2Gx+18,0xC0); poke8(exp2Gx+19,0x95);
    poke8(exp2Gx+20,0x6E); poke8(exp2Gx+21,0x40); poke8(exp2Gx+22,0x45); poke8(exp2Gx+23,0x30);
    poke8(exp2Gx+24,0x6D); poke8(exp2Gx+25,0x7D); poke8(exp2Gx+26,0xED); poke8(exp2Gx+27,0x41);
    poke8(exp2Gx+28,0x94); poke8(exp2Gx+29,0x7F); poke8(exp2Gx+30,0x04); poke8(exp2Gx+31,0xC6);

    // 2G.y = 1AE168FEA63DC339A3C58419466CEAEEF7F632653266D0E1236431A950CFE52A (BE)
    var exp2Gy: int64 := mmap(0, 32, 3, 34, -1, 0);
    poke8(exp2Gy+ 0,0x2A); poke8(exp2Gy+ 1,0xE5); poke8(exp2Gy+ 2,0xCF); poke8(exp2Gy+ 3,0x50);
    poke8(exp2Gy+ 4,0xA9); poke8(exp2Gy+ 5,0x31); poke8(exp2Gy+ 6,0x64); poke8(exp2Gy+ 7,0x23);
    poke8(exp2Gy+ 8,0xE1); poke8(exp2Gy+ 9,0xD0); poke8(exp2Gy+10,0x66); poke8(exp2Gy+11,0x32);
    poke8(exp2Gy+12,0x65); poke8(exp2Gy+13,0x32); poke8(exp2Gy+14,0xF6); poke8(exp2Gy+15,0xF7);
    poke8(exp2Gy+16,0xEE); poke8(exp2Gy+17,0xEA); poke8(exp2Gy+18,0x6C); poke8(exp2Gy+19,0x46);
    poke8(exp2Gy+20,0x19); poke8(exp2Gy+21,0x84); poke8(exp2Gy+22,0xC5); poke8(exp2Gy+23,0xA3);
    poke8(exp2Gy+24,0x39); poke8(exp2Gy+25,0xC3); poke8(exp2Gy+26,0x3D); poke8(exp2Gy+27,0xA6);
    poke8(exp2Gy+28,0xFE); poke8(exp2Gy+29,0x68); poke8(exp2Gy+30,0xE1); poke8(exp2Gy+31,0x1A);

    if (bytesEq(pubx, exp2Gx, 32) == 1 && bytesEq(puby, exp2Gy, 32) == 1) {
        PrintLn("OK: 2*G == 2G (Testvektoren bestätigt)");
    } else {
        Print("FAIL: 2*G x="); printHex(pubx, 32); PrintLn("");
        Print("      exp x="); printHex(exp2Gx, 32); PrintLn("");
        Print("          y="); printHex(puby, 32); PrintLn("");
        Print("      exp y="); printHex(exp2Gy, 32); PrintLn("");
        return 1;
    }
    munmap(exp2Gx, 32); munmap(exp2Gy, 32);

    // ----------------------------------------------------------------
    // Test 3: ECDSA Sign + Verify Roundtrip (zufälliger Schlüssel)
    // ----------------------------------------------------------------
    i := 0;
    while (i < 32) { poke8(hash + i, i + 1); i := i + 1; }  // hash = 01 02 03 ... 20
    ECCGenKey(priv, pubx, puby);
    ECDSASign(hash, priv, r, s);
    var v: int64 := ECDSAVerify(hash, pubx, puby, r, s);
    if (v == 1) {
        PrintLn("OK: ECDSA Sign + Verify (valid signature accepted)");
    } else {
        PrintLn("FAIL: ECDSA Verify rejected valid signature"); return 1;
    }

    // ----------------------------------------------------------------
    // Test 4: Korrumpierte Signatur wird abgelehnt
    // ----------------------------------------------------------------
    poke8(r, peek8(r) ^ 0x01);  // flip one bit in r
    var v2: int64 := ECDSAVerify(hash, pubx, puby, r, s);
    if (v2 == 0) {
        PrintLn("OK: ECDSA Verify lehnt korrumpierte Signatur ab");
    } else {
        PrintLn("FAIL: ECDSA Verify akzeptierte ungültige Signatur"); return 1;
    }

    munmap(priv, 32); munmap(pubx, 32); munmap(puby, 32);
    munmap(r, 32); munmap(s, 32); munmap(hash, 32);

    PrintLn("=== alle secp256k1 ECDSA Tests bestanden ===");
    return 0;
}
