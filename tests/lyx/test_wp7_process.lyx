// WP-7: Test für std/process_ext — Prozess-Credentials & Systeminfo
import std.process_ext;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-7: Prozess-Credentials & Systeminfo ===");

  // --- Test 1: UID/GID/EUID/EGID ---
  var uid:  int64 := GetUID();
  var gid:  int64 := GetGID();
  var euid: int64 := GetEUID();
  var egid: int64 := GetEGID();
  if (uid >= 0 && gid >= 0 && euid >= 0 && egid >= 0) {
    Print("OK: GetUID="); Print(uid);
    Print(" GetGID="); Print(gid);
    Print(" GetEUID="); Print(euid);
    Print(" GetEGID="); PrintLn(egid);
  } else {
    PrintLn("FAIL: Credentials negativ"); return 1;
  }

  // --- Test 2: UID == EUID (kein setuid-Bit) ---
  if (uid == euid) {
    PrintLn("OK: UID == EUID (kein setuid-Binary)");
  } else {
    Print("INFO: UID != EUID (setuid aktiv): "); Print(uid); Print(" != "); PrintLn(euid);
  }

  // --- Test 3: GetPPID ---
  var ppid: int64 := GetPPID();
  if (ppid > 1) {
    Print("OK: GetPPID="); PrintLn(ppid);
  } else {
    Print("FAIL: GetPPID="); PrintLn(ppid); return 1;
  }

  // --- Test 4: GetPGRP ---
  var pgrp: int64 := GetPGRP();
  if (pgrp > 0) {
    Print("OK: GetPGRP="); PrintLn(pgrp);
  } else {
    Print("FAIL: GetPGRP="); PrintLn(pgrp); return 1;
  }

  // --- Test 5: IsRoot ---
  var root: bool := IsRoot();
  if (!root) {
    PrintLn("OK: IsRoot=false (normaler Benutzer)");
  } else {
    PrintLn("OK: IsRoot=true (läuft als root)");
  }

  // --- Test 6: SetUID(uid) — gleiche UID, sollte als No-Op erfolgreich sein ---
  var r: int64 := SetUID(uid);
  if (r == 0) {
    PrintLn("OK: SetUID(eigene UID) erfolgreich");
  } else {
    Print("FAIL: SetUID(eigene UID)="); PrintLn(r); return 1;
  }

  // --- Test 7: SetGID(gid) — gleiche GID ---
  r := SetGID(gid);
  if (r == 0) {
    PrintLn("OK: SetGID(eigene GID) erfolgreich");
  } else {
    Print("FAIL: SetGID(eigene GID)="); PrintLn(r); return 1;
  }

  // --- Test 8: GetUname — sysname muss "Linux" sein ---
  var utsBuf: int64 := alloc(UTSNAME_SIZE);
  r := GetUname(utsBuf);
  if (r == 0) {
    // sysname ist an Offset 0, null-terminiert
    var sysname: pchar := utsBuf as pchar;
    // Prüfe erste 5 Bytes = "Linux"
    var isLinux: bool := (peek8(utsBuf+0) == 76 &&  // 'L'
                          peek8(utsBuf+1) == 105 &&  // 'i'
                          peek8(utsBuf+2) == 110 &&  // 'n'
                          peek8(utsBuf+3) == 117 &&  // 'u'
                          peek8(utsBuf+4) == 120);   // 'x'
    if (isLinux) {
      PrintLn("OK: GetUname — sysname=Linux");
    } else {
      Print("FAIL: sysname nicht Linux, erstes Byte="); PrintLn(peek8(utsBuf));
      free(utsBuf, UTSNAME_SIZE); return 1;
    }
  } else {
    Print("FAIL: GetUname="); PrintLn(r);
    free(utsBuf, UTSNAME_SIZE); return 1;
  }
  free(utsBuf, UTSNAME_SIZE);

  // --- Test 9: GetUnameRelease ---
  var relBuf: int64 := alloc(UTSNAME_FIELD_LEN);
  r := GetUnameRelease(relBuf);
  if (r == 0 && peek8(relBuf) != 0) {
    var relStr: pchar := relBuf as pchar;
    Print("OK: GetUnameRelease="); PrintLn(relStr);
  } else {
    PrintLn("FAIL: GetUnameRelease"); free(relBuf, UTSNAME_FIELD_LEN); return 1;
  }
  free(relBuf, UTSNAME_FIELD_LEN);

  // --- Test 10: GetUnameMachine muss "x86_64" sein ---
  var machBuf: int64 := alloc(UTSNAME_FIELD_LEN);
  r := GetUnameMachine(machBuf);
  if (r == 0) {
    var isx86: bool := (peek8(machBuf+0) == 120 &&  // 'x'
                        peek8(machBuf+1) == 56  &&  // '8'
                        peek8(machBuf+2) == 54  &&  // '6'
                        peek8(machBuf+3) == 95  &&  // '_'
                        peek8(machBuf+4) == 54);    // '6'
    if (isx86) {
      PrintLn("OK: GetUnameMachine=x86_64");
    } else {
      var machStr: pchar := machBuf as pchar;
      Print("INFO: GetUnameMachine="); PrintLn(machStr);
    }
  } else {
    Print("FAIL: GetUnameMachine="); PrintLn(r);
    free(machBuf, UTSNAME_FIELD_LEN); return 1;
  }
  free(machBuf, UTSNAME_FIELD_LEN);

  // --- Test 11: SetPGID(0, 0) — eigene Prozessgruppe setzen ---
  r := SetPGID(0, 0);
  if (r == 0 || r == -1) {
    // -1 = EPERM: erlaubt wenn Prozess bereits Gruppenleader ist
    PrintLn("OK: SetPGID(0,0)");
  } else {
    Print("INFO: SetPGID(0,0)="); PrintLn(r);
  }

  PrintLn("=== WP-7: alle Tests bestanden ===");
  return 0;
}
