// WP-4: Test für std/time — Zeit & Timer
import std.time;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-4: Zeit & Timer ===");

  // --- Test 1: Sleep(10) — 10 ms schlafen ---
  var t0: int64 := GetTimeMs();
  var r: int64 := Sleep(10);
  var t1: int64 := GetTimeMs();
  var elapsed: int64 := t1 - t0;
  if (r == 0 && elapsed >= 10) {
    Print("OK: Sleep(10ms) — elapsed="); Print(elapsed); PrintLn("ms");
  } else {
    Print("FAIL: Sleep r="); Print(r); Print(" elapsed="); PrintLn(elapsed);
    return 1;
  }

  // --- Test 2: SleepNs(500000) — 0.5 ms schlafen ---
  t0 := GetTimeNs(CLOCK_MONOTONIC);
  r := SleepNs(500000);
  t1 := GetTimeNs(CLOCK_MONOTONIC);
  var elapsedNs: int64 := t1 - t0;
  if (r == 0 && elapsedNs >= 500000) {
    Print("OK: SleepNs(500µs) — elapsed="); Print(elapsedNs); PrintLn("ns");
  } else {
    Print("FAIL: SleepNs r="); Print(r); Print(" elapsed="); PrintLn(elapsedNs);
    return 1;
  }

  // --- Test 3: GetTimeNs — monotone Zeit wächst ---
  var ns1: int64 := GetTimeNs(CLOCK_MONOTONIC);
  var ns2: int64 := GetTimeNs(CLOCK_MONOTONIC);
  if (ns2 > ns1 && ns1 > 0) {
    Print("OK: GetTimeNs(MONOTONIC) wächst — delta="); Print(ns2 - ns1); PrintLn("ns");
  } else {
    Print("FAIL: GetTimeNs ns1="); Print(ns1); Print(" ns2="); PrintLn(ns2);
    return 1;
  }

  // --- Test 4: GetTimeOfDay ---
  var secBuf:  int64 := alloc(8);
  var usecBuf: int64 := alloc(8);
  r := GetTimeOfDay(secBuf, usecBuf);
  var sec:  int64 := peek64(secBuf);
  var usec: int64 := peek64(usecBuf);
  free(secBuf, 8);
  free(usecBuf, 8);
  if (r == 0 && sec > 1700000000 && usec >= 0 && usec < 1000000) {
    Print("OK: GetTimeOfDay — sec="); Print(sec); Print(" usec="); PrintLn(usec);
  } else {
    Print("FAIL: GetTimeOfDay r="); Print(r); Print(" sec="); PrintLn(sec);
    return 1;
  }

  // --- Test 5: GetUnixMs ---
  var ms: int64 := GetUnixMs();
  if (ms > 1700000000000) {
    Print("OK: GetUnixMs="); PrintLn(ms);
  } else {
    Print("FAIL: GetUnixMs="); PrintLn(ms); return 1;
  }

  // --- Test 6: GetTimeMs (Monotonic) ---
  var ms0: int64 := GetTimeMs();
  Sleep(5);
  var ms1b: int64 := GetTimeMs();
  if (ms1b >= ms0 + 5) {
    Print("OK: GetTimeMs wächst — delta="); Print(ms1b - ms0); PrintLn("ms");
  } else {
    Print("FAIL: GetTimeMs delta="); PrintLn(ms1b - ms0); return 1;
  }

  // --- Test 7: TimerFdCreate + TimerFdSetTime + TimerFdRead ---
  var tfd: int64 := TimerFdCreate(CLOCK_MONOTONIC, TFD_CLOEXEC);
  if (tfd < 0) {
    Print("FAIL: TimerFdCreate="); PrintLn(tfd); return 1;
  }
  Print("OK: TimerFdCreate — fd="); PrintLn(tfd);
  // Timer auf 20ms setzen (einmalig)
  r := TimerFdSetTime(tfd, 0, 20000000);
  if (r != 0) {
    Print("FAIL: TimerFdSetTime="); PrintLn(r); return 1;
  }
  PrintLn("OK: TimerFdSetTime(20ms)");
  // Lesen blockiert bis Timer abläuft
  var count: int64 := TimerFdRead(tfd);
  if (count == 1) {
    Print("OK: TimerFdRead — count="); PrintLn(count);
  } else {
    Print("FAIL: TimerFdRead count="); PrintLn(count); return 1;
  }
  close(tfd);

  // --- Test 8: SleepUntil (absolute Zeit) ---
  var now: int64 := GetTimeNs(CLOCK_MONOTONIC);
  var target: int64 := now + 15000000; // +15ms
  r := SleepUntil(CLOCK_MONOTONIC, target);
  var after: int64 := GetTimeNs(CLOCK_MONOTONIC);
  if (r == 0 && after >= target) {
    PrintLn("OK: SleepUntil(+15ms)");
  } else {
    Print("FAIL: SleepUntil r="); Print(r);
    Print(" after="); Print(after); Print(" target="); PrintLn(target);
    return 1;
  }

  PrintLn("=== WP-4: alle Tests bestanden ===");
  return 0;
}
