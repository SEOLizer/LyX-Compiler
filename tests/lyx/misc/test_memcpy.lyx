import std.alloc;
fn main(): int64 {
  // memcpy: Inhalt von src nach dst kopieren
  var src: int64 := alloc(64);
  var dst: int64 := alloc(64);

  poke8(src,      72);  // 'H'
  poke8(src + 1,  101); // 'e'
  poke8(src + 2,  108); // 'l'
  poke8(src + 3,  108); // 'l'
  poke8(src + 4,  111); // 'o'
  poke8(src + 5,  0);

  memcpy(dst, src, 6);

  if (peek8(dst)     == 72)  { PrintLn("memcpy byte 0: ok"); }
  if (peek8(dst + 1) == 101) { PrintLn("memcpy byte 1: ok"); }
  if (peek8(dst + 4) == 111) { PrintLn("memcpy byte 4: ok"); }
  if (peek8(dst + 5) == 0)   { PrintLn("memcpy NUL: ok"); }

  // Quelle unverändert
  if (peek8(src) == 72) { PrintLn("memcpy src unchanged: ok"); }

  // memset: Buffer auf einen Wert setzen
  var buf: int64 := alloc(32);
  memset(buf, 255, 8);

  if (peek8(buf)     == 255) { PrintLn("memset byte 0: ok"); }
  if (peek8(buf + 7) == 255) { PrintLn("memset byte 7: ok"); }
  if (peek8(buf + 8) == 0)   { PrintLn("memset beyond: ok"); }

  // memset mit 0 (Zero-Fill)
  poke8(buf, 42);
  memset(buf, 0, 4);
  if (peek8(buf) == 0) { PrintLn("memset zero: ok"); }

  free(src, 64);
  free(dst, 64);
  free(buf, 32);
  return 0;
}
