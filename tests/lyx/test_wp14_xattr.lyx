// WP-14: Test fuer std/xattr -- xattr, statfs, fallocate
import std.xattr;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-14: xattr + statfs + fallocate ===");

  // ============================================================
  // --- Teil 1: xattr ---
  // ============================================================
  PrintLn("--- xattr ---");

  var testPath: pchar := "/tmp/lyx_xattr_wp14";

  // Testdatei anlegen
  var fd: int64 := open(testPath, 65, 420);   // O_WRONLY|O_CREAT, 0644
  if (fd < 0) {
    Print("FAIL: open testfile="); PrintLn(fd); return 1;
  }
  close(fd);

  // Test 1: XattrSet
  var val:  int64 := mmap(0, 32, 3, 34, -1, 0);
  poke8(val + 0, 104); poke8(val + 1, 101); poke8(val + 2, 108);
  poke8(val + 3, 108); poke8(val + 4, 111); poke8(val + 5, 0);  // "hello\0"
  var xname: pchar := "user.lyx_test";
  var sr: int64 := XattrSet(testPath, xname, val, 5, 0);
  if (sr < 0) {
    Print("FAIL: XattrSet="); PrintLn(sr);
    munmap(val, 32); unlink(testPath); return 1;
  }
  PrintLn("OK: XattrSet(user.lyx_test, 'hello')");

  // Test 2: XattrGet -- Groesse abfragen
  var needed: int64 := XattrGet(testPath, xname, 0, 0);
  if (needed != 5) {
    Print("FAIL: XattrGet(size)="); PrintLn(needed);
    munmap(val, 32); unlink(testPath); return 1;
  }
  Print("OK: XattrGet(size)="); PrintLn(needed);

  // Test 3: XattrGet -- Wert lesen
  var getbuf: int64 := mmap(0, 32, 3, 34, -1, 0);
  var gr: int64 := XattrGet(testPath, xname, getbuf, 32);
  if (gr != 5) {
    Print("FAIL: XattrGet(val)="); PrintLn(gr);
    munmap(getbuf, 32); munmap(val, 32); unlink(testPath); return 1;
  }
  // 'h'=104, 'e'=101, 'l'=108
  if (peek8(getbuf) != 104 || peek8(getbuf + 1) != 101 || peek8(getbuf + 2) != 108) {
    PrintLn("FAIL: XattrGet Inhalt falsch");
    munmap(getbuf, 32); munmap(val, 32); unlink(testPath); return 1;
  }
  PrintLn("OK: XattrGet Inhalt korrekt ('hello')");
  munmap(getbuf, 32);

  // Test 4: XattrList
  var listbuf: int64 := mmap(0, 256, 3, 34, -1, 0);
  var lr: int64 := XattrList(testPath, listbuf, 256);
  if (lr <= 0) {
    Print("FAIL: XattrList="); PrintLn(lr);
    munmap(listbuf, 256); munmap(val, 32); unlink(testPath); return 1;
  }
  // Erster Name muss "user.lyx_test" enthalten (beginnt mit 'u'=117)
  if (peek8(listbuf) != 117) {
    Print("FAIL: XattrList erstes Byte="); PrintLn(peek8(listbuf));
    munmap(listbuf, 256); munmap(val, 32); unlink(testPath); return 1;
  }
  Print("OK: XattrList="); Print(lr); PrintLn(" Bytes");
  munmap(listbuf, 256);

  // Test 5: XattrRemove
  var rr: int64 := XattrRemove(testPath, xname);
  if (rr < 0) {
    Print("FAIL: XattrRemove="); PrintLn(rr);
    munmap(val, 32); unlink(testPath); return 1;
  }
  PrintLn("OK: XattrRemove");

  // Test 6: FXattrSet + FXattrGet (fd-Varianten)
  var fd2: int64 := open(testPath, 2, 0);   // O_RDWR
  if (fd2 < 0) {
    Print("FAIL: open fxattr="); PrintLn(fd2);
    munmap(val, 32); unlink(testPath); return 1;
  }
  var fsr: int64 := FXattrSet(fd2, xname, val, 5, 0);
  if (fsr < 0) {
    Print("FAIL: FXattrSet="); PrintLn(fsr);
    close(fd2); munmap(val, 32); unlink(testPath); return 1;
  }
  var fgbuf: int64 := mmap(0, 32, 3, 34, -1, 0);
  var fgr: int64 := FXattrGet(fd2, xname, fgbuf, 32);
  if (fgr != 5) {
    Print("FAIL: FXattrGet="); PrintLn(fgr);
    munmap(fgbuf, 32); close(fd2); munmap(val, 32); unlink(testPath); return 1;
  }
  PrintLn("OK: FXattrSet + FXattrGet");
  var frr: int64 := FXattrRemove(fd2, xname);
  if (frr < 0) {
    Print("FAIL: FXattrRemove="); PrintLn(frr);
    munmap(fgbuf, 32); close(fd2); munmap(val, 32); unlink(testPath); return 1;
  }
  PrintLn("OK: FXattrRemove");
  munmap(fgbuf, 32);
  close(fd2);

  munmap(val, 32);
  unlink(testPath);

  // ============================================================
  // --- Teil 2: statfs ---
  // ============================================================
  PrintLn("--- statfs ---");

  var sfbuf: int64 := mmap(0, STATFS_SIZE, 3, 34, -1, 0);
  var sfr: int64 := StatFs("/", sfbuf);
  if (sfr < 0) {
    Print("FAIL: StatFs="); PrintLn(sfr);
    munmap(sfbuf, STATFS_SIZE); return 1;
  }
  PrintLn("OK: StatFs('/')");

  var bsize:  int64 := StatFsBlockSize(sfbuf);
  var total:  int64 := StatFsTotalBlocks(sfbuf);
  var free:   int64 := StatFsFreeBlocks(sfbuf);
  if (bsize <= 0 || total <= 0 || free < 0) {
    Print("FAIL: statfs-Werte bsize="); Print(bsize);
    Print(" total="); Print(total); Print(" free="); PrintLn(free);
    munmap(sfbuf, STATFS_SIZE); return 1;
  }
  Print("OK: BlockSize="); Print(bsize);
  Print(" TotalBlocks="); Print(total);
  Print(" FreeBlocks="); PrintLn(free);
  munmap(sfbuf, STATFS_SIZE);

  // ============================================================
  // --- Teil 3: fallocate ---
  // ============================================================
  PrintLn("--- fallocate ---");

  var allocPath: pchar := "/tmp/lyx_fallocate_wp14";
  var afd: int64 := open(allocPath, 65, 420);   // O_WRONLY|O_CREAT, 0644
  if (afd < 0) {
    Print("FAIL: open fallocate="); PrintLn(afd); return 1;
  }

  var ar: int64 := FileAllocate(afd, 0, 4096);
  if (ar < 0) {
    Print("FAIL: FileAllocate="); PrintLn(ar);
    close(afd); unlink(allocPath); return 1;
  }
  PrintLn("OK: FileAllocate(4096)");

  close(afd);
  unlink(allocPath);

  PrintLn("=== WP-14: alle Tests bestanden ===");
  return 0;
}
