// WP-9: Test für std/mmap_ext — erweiterte Memory-Operationen
import std.mmap_ext;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-9: erweiterte Memory-Operationen ===");

  // --- Test 1: MmapAdvise (MADV_SEQUENTIAL) ---
  var buf: int64 := mmap(0, 4096, 3, 34, -1, 0);
  if (buf == 0) { PrintLn("FAIL: mmap"); return 1; }
  var r: int64 := MmapAdvise(buf, 4096, MADV_SEQUENTIAL);
  if (r == 0) {
    PrintLn("OK: MmapAdvise(MADV_SEQUENTIAL)");
  } else {
    Print("FAIL: MmapAdvise="); PrintLn(r); return 1;
  }

  // --- Test 2: MmapAdvise (MADV_RANDOM) ---
  r := MmapAdvise(buf, 4096, MADV_RANDOM);
  if (r == 0) {
    PrintLn("OK: MmapAdvise(MADV_RANDOM)");
  } else {
    Print("FAIL: MmapAdvise(RANDOM)="); PrintLn(r); return 1;
  }

  // --- Test 3: MmapFreePages (MADV_DONTNEED) ---
  poke64(buf, 12345);
  r := MmapFreePages(buf, 4096);
  if (r == 0) {
    PrintLn("OK: MmapFreePages(MADV_DONTNEED)");
  } else {
    Print("FAIL: MmapFreePages="); PrintLn(r); return 1;
  }

  // --- Test 4: MmapSync auf anonymem Mapping (No-Op, gibt 0) ---
  r := MmapSync(buf, 4096, MS_SYNC);
  if (r == 0) {
    PrintLn("OK: MmapSync(MS_SYNC) — No-Op auf anonymem Mapping");
  } else {
    Print("INFO: MmapSync="); PrintLn(r);
  }

  // --- Test 5: MemInCore ---
  poke64(buf, 99);  // Seite berühren → sie muss im RAM sein
  var vec: int64 := mmap(0, 8, 3, 34, -1, 0);
  r := MemInCore(buf, PAGE_SIZE, vec);
  if (r == 0) {
    var resident: int64 := peek8(vec) & 1;
    if (resident == 1) {
      PrintLn("OK: MemInCore — Seite ist resident");
    } else {
      PrintLn("INFO: MemInCore — Seite nicht resident (nach MADV_DONTNEED erwartet)");
    }
  } else {
    Print("FAIL: MemInCore="); PrintLn(r);
  }
  munmap(vec, 8);

  // --- Test 6: MemIsResident ---
  poke64(buf, 42);  // Seite erneut berühren
  var res: bool := MemIsResident(buf);
  if (res) {
    PrintLn("OK: MemIsResident=true (Seite im RAM)");
  } else {
    PrintLn("INFO: MemIsResident=false (Seite ausgelagert)");
  }

  munmap(buf, 4096);

  // --- Test 7: MmapResize ---
  var small: int64 := mmap(0, 4096, 3, 34, -1, 0);
  if (small == 0) { PrintLn("FAIL: mmap für MmapResize"); return 1; }
  poke64(small, 42);  // Inhalt setzen
  var large: int64 := MmapResize(small, 4096, 8192);
  if (large > 0) {
    var val: int64 := peek64(large);
    if (val == 42) {
      Print("OK: MmapResize 4096→8192 — Inhalt erhalten, neue Adresse="); PrintLn(large);
    } else {
      Print("FAIL: MmapResize Inhalt verloren, val="); PrintLn(val); return 1;
    }
    munmap(large, 8192);
  } else {
    Print("FAIL: MmapResize="); PrintLn(large); return 1;
  }

  // --- Test 8: MemUnlock (auf normalem mmap) ---
  var lockBuf: int64 := mmap(0, 4096, 3, 34, -1, 0);
  r := MemUnlock(lockBuf, 4096);
  if (r == 0) {
    PrintLn("OK: MemUnlock");
  } else {
    Print("INFO: MemUnlock="); PrintLn(r);
  }
  munmap(lockBuf, 4096);

  // --- Test 9: MemFdCreate ---
  var fd: int64 := MemFdCreate("lyx_test", MFD_CLOEXEC);
  if (fd >= 0) {
    Print("OK: MemFdCreate — fd="); PrintLn(fd);
    // Größe setzen und inhalt schreiben
    sys_ftruncate(fd, 4096);
    var mapped: int64 := mmap(0, 4096, 3, 1, fd, 0);  // PROT_RW, MAP_SHARED=1
    if (mapped > 0) {
      poke64(mapped, 777);
      var readBack: int64 := peek64(mapped);
      if (readBack == 777) {
        PrintLn("OK: MemFdCreate — mmap+write+read korrekt");
      } else {
        Print("FAIL: MemFdCreate readBack="); PrintLn(readBack); return 1;
      }
      munmap(mapped, 4096);
    } else {
      Print("INFO: MemFdCreate mmap fehlgeschlagen="); PrintLn(mapped);
    }
    close(fd);
  } else {
    Print("FAIL: MemFdCreate="); PrintLn(fd); return 1;
  }

  PrintLn("=== WP-9: alle Tests bestanden ===");
  return 0;
}
