// Test-Programm für std/systeminfo
// Erweitert mit Thread-/Prozess-Informationen

import std.systeminfo;
import std.io;

fn main(): int64 {
  Print("=== System Information ===\n\n");
  
  // OS
  var os: int64 := GetOS();
  if (os == 0) {
    Print("OS: Linux\n");
  }
  else {
    Print("OS: Unknown\n");
  }
  
  Print("\n--- CPU ---\n");
  var logical: int64 := GetLogicalCores();
  var physical: int64 := GetPhysicalCores();
  var smt: int64 := GetSMTWidth();
  
  Print("Logical Cores: ");
  PrintInt(logical);
  Print("\n");
  
  Print("Physical Cores: ");
  PrintInt(physical);
  Print("\n");
  
  Print("SMT Width: ");
  PrintInt(smt);
  Print("\n");
  
  Print("\n--- Memory ---\n");
  var total: int64 := GetTotalMemory();
  var avail: int64 := GetAvailableMemory();
  var free: int64 := GetFreeMemory();
  
  Print("Total Memory: ");
  PrintInt(total / 1024);
  Print(" MB\n");
  
  Print("Available Memory: ");
  PrintInt(avail / 1024);
  Print(" MB\n");
  
  Print("Free Memory: ");
  PrintInt(free / 1024);
  Print(" MB\n");
  
  Print("\n--- Load Average ---\n");
  var load1: int64 := GetLoadAverage1();
  var load5: int64 := GetLoadAverage5();
  var load15: int64 := GetLoadAverage15();
  
  Print("Load 1min: ");
  PrintInt(load1 / 100);
  Print(".");
  PrintInt(load1 % 100);
  Print("\n");
  
  Print("Load 5min: ");
  PrintInt(load5 / 100);
  Print(".");
  PrintInt(load5 % 100);
  Print("\n");
  
  Print("Load 15min: ");
  PrintInt(load15 / 100);
  Print(".");
  PrintInt(load15 % 100);
  Print("\n");
  
  Print("\n--- Uptime ---\n");
  var uptime: int64 := GetUptime();
  
  var days: int64 := uptime / 86400;
  var hours: int64 := (uptime % 86400) / 3600;
  var mins: int64 := (uptime % 3600) / 60;
  var secs: int64 := uptime % 60;
  
  if (days > 0) {
    PrintInt(days);
    Print("d ");
  }
  PrintInt(hours);
  Print("h ");
  PrintInt(mins);
  Print("m ");
  PrintInt(secs);
  Print("s\n");
  
  Print("\n--- Current Process ---\n");
  var pid: int64 := GetProcessId();
  var ppid: int64 := GetParentProcessId();
  var utime: int64 := GetUserTime();
  var stime: int64 := GetSystemTime();
  var threads: int64 := GetNumThreads();
  
  Print("PID: ");
  PrintInt(pid);
  Print("\n");
  
  Print("Parent PID: ");
  PrintInt(ppid);
  Print("\n");
  
  Print("User Time: ");
  PrintInt(utime);
  Print(" ticks\n");
  
  Print("System Time: ");
  PrintInt(stime);
  Print(" ticks\n");
  
  Print("Threads: ");
  PrintInt(threads);
  Print("\n");
  
  Print("\n--- CPU Stats (/proc/stat) ---\n");
  var cpu_user: int64 := GetCpuUserTime();
  var cpu_sys: int64 := GetCpuSystemTime();
  var cpu_idle: int64 := GetCpuIdleTime();
  
  Print("User Time: ");
  PrintInt(cpu_user);
  Print(" jiffies\n");
  
  Print("System Time: ");
  PrintInt(cpu_sys);
  Print(" jiffies\n");
  
  Print("Idle Time: ");
  PrintInt(cpu_idle);
  Print(" jiffies\n");
  
  var total_cpu: int64 := cpu_user + cpu_sys + cpu_idle;
  if (total_cpu > 0) {
    var idle_pct: int64 := (cpu_idle * 100) / total_cpu;
    Print("CPU Usage: ");
    PrintInt(100 - idle_pct);
    Print("%\n");
  }
  
  Print("\n--- Processes ---\n");
  var running: int64 := GetRunningProcesses();
  
  Print("Running/Runnable: ");
  PrintInt(running);
  Print("\n");
  
  Print("\n=== Test Complete ===\n");
  
  return 0;
}