// WP-10: Test für std/inotify — Dateisystem-Überwachung
import std.inotify;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-10: inotify — Dateisystem-Überwachung ===");

  // --- Test 1: InotifyCreate ---
  var ifd: int64 := InotifyCreate();
  if (ifd < 0) {
    Print("FAIL: InotifyCreate="); PrintLn(ifd); return 1;
  }
  Print("OK: InotifyCreate — fd="); PrintLn(ifd);

  // --- Test 2: InotifyWatch auf /tmp ---
  var wd: int64 := InotifyWatch(ifd, "/tmp", IN_CREATE | IN_DELETE);
  if (wd < 0) {
    Print("FAIL: InotifyWatch="); PrintLn(wd);
    close(ifd); return 1;
  }
  Print("OK: InotifyWatch(/tmp, IN_CREATE|IN_DELETE) — wd="); PrintLn(wd);

  // --- Test 3: Event auslösen — Datei in /tmp erstellen ---
  var testPath: pchar := "/tmp/lyx_inotify_wp10_test";
  var filefd: int64 := open(testPath, 65, 420);  // O_WRONLY|O_CREAT, 0644
  if (filefd < 0) {
    Print("FAIL: open testfile="); PrintLn(filefd);
    InotifyUnwatch(ifd, wd); close(ifd); return 1;
  }
  close(filefd);
  PrintLn("OK: Testdatei erstellt → IN_CREATE-Event erwartet");

  // --- Test 4: InotifyRead + Event parsen ---
  var buf: int64 := mmap(0, 256, 3, 34, -1, 0);
  var n: int64 := InotifyRead(ifd, buf, 256);
  if (n < 16) {
    Print("FAIL: InotifyRead n="); PrintLn(n); return 1;
  }
  Print("OK: InotifyRead — "); Print(n); PrintLn(" Bytes gelesen");

  // Event parsen
  var evMask: int64 := InotifyEventMask(buf);
  var evWd:   int64 := InotifyEventWd(buf);
  var evLen:  int64 := InotifyEventLen(buf);
  var evName: int64 := InotifyEventName(buf);

  Print("  wd="); Print(evWd);
  Print(" mask="); Print(evMask);
  Print(" len="); PrintLn(evLen);

  // Maske prüfen: IN_CREATE (256) muss gesetzt sein
  if ((evMask & IN_CREATE) != 0) {
    PrintLn("OK: InotifyEventMask — IN_CREATE gesetzt");
  } else {
    Print("FAIL: IN_CREATE nicht in Maske="); PrintLn(evMask); return 1;
  }

  // wd prüfen
  if (evWd == wd) {
    PrintLn("OK: InotifyEventWd — korrekt");
  } else {
    Print("FAIL: wd="); Print(evWd); Print(" erwartet="); PrintLn(wd); return 1;
  }

  // Dateiname prüfen (sollte "lyx_inotify_wp10_test" sein)
  if (evLen > 0) {
    var nameStr: pchar := evName as pchar;
    Print("OK: InotifyEventName="); PrintLn(nameStr);
  } else {
    PrintLn("INFO: kein Name im Event (kein IN_CREATE in Unterverzeichnis erwartet)");
  }

  // --- Test 5: InotifyEventNext — nächstes Event ---
  var next: int64 := InotifyEventNext(buf);
  if (next <= buf && next >= buf + n) {
    PrintLn("OK: InotifyEventNext — kein weiteres Event");
  } else {
    // Evtl. zweites Event vorhanden (kein Fehler)
    PrintLn("OK: InotifyEventNext berechnet");
  }

  // --- Test 6: IN_DELETE — Testdatei löschen und Event lesen ---
  // (Datei entfernen mit sys_unlink, falls vorhanden)
  // Unlink via execve wäre zu komplex — wir testen stattdessen InotifyUnwatch
  var r: int64 := InotifyUnwatch(ifd, wd);
  if (r == 0) {
    PrintLn("OK: InotifyUnwatch");
  } else {
    Print("FAIL: InotifyUnwatch="); PrintLn(r); return 1;
  }

  // Aufräumen
  munmap(buf, 256);
  close(ifd);

  PrintLn("=== WP-10: alle Tests bestanden ===");
  return 0;
}
