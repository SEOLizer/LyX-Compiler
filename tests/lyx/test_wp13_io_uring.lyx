// WP-13: Test fuer std/io_uring -- io_uring Asynchrones I/O
import std.io_uring;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-13: io_uring -- Asynchrones I/O ===");

  // --- Test 1: IoUringCreate ---
  var ring: int64 := IoUringCreate(4);
  if (ring == 0) {
    PrintLn("FAIL: IoUringCreate=0"); return 1;
  }
  PrintLn("OK: IoUringCreate(4)");

  // --- Test 2: IoUringGetSQE ---
  var sqe: int64 := IoUringGetSQE(ring);
  if (sqe == 0) {
    PrintLn("FAIL: IoUringGetSQE=0"); IoUringFree(ring); return 1;
  }
  PrintLn("OK: IoUringGetSQE");

  // --- Test 3: NOP-SQE senden und auf Completion warten ---
  IoUringSQESetNop(sqe, 0x1337);
  var sr: int64 := IoUringSubmit(ring);
  if (sr < 0) {
    Print("FAIL: IoUringSubmit="); PrintLn(sr); IoUringFree(ring); return 1;
  }
  PrintLn("OK: IoUringSubmit (NOP)");

  var cqe: int64 := IoUringWaitCQE(ring);
  if (cqe == 0) {
    PrintLn("FAIL: IoUringWaitCQE=0"); IoUringFree(ring); return 1;
  }
  PrintLn("OK: IoUringWaitCQE");

  var res: int64 := IoUringCQEResult(cqe);
  if (res != 0) {
    Print("FAIL: NOP result="); PrintLn(res); IoUringCQESeen(ring, cqe); IoUringFree(ring); return 1;
  }
  PrintLn("OK: CQEResult=0 (NOP erfolgreich)");

  var ud: int64 := IoUringCQEUserData(cqe);
  if (ud != 0x1337) {
    Print("FAIL: CQEUserData="); PrintLn(ud); IoUringCQESeen(ring, cqe); IoUringFree(ring); return 1;
  }
  PrintLn("OK: CQEUserData=0x1337");

  IoUringCQESeen(ring, cqe);
  PrintLn("OK: IoUringCQESeen");

  // --- Test 4: asynchroner Read von /dev/zero ---
  var zeroFd: int64 := open("/dev/zero", 0, 0);
  if (zeroFd < 0) {
    Print("FAIL: open(/dev/zero)="); PrintLn(zeroFd); IoUringFree(ring); return 1;
  }

  var buf: int64 := mmap(0, 64, 3, 34, -1, 0);

  var sqe2: int64 := IoUringGetSQE(ring);
  if (sqe2 == 0) {
    PrintLn("FAIL: IoUringGetSQE(2)=0");
    munmap(buf, 64); close(zeroFd); IoUringFree(ring); return 1;
  }

  IoUringSQESetRead(sqe2, zeroFd, buf, 8, 0, 0xABCD);

  var sr2: int64 := IoUringSubmitAndWait(ring, 1);
  if (sr2 < 0) {
    Print("FAIL: IoUringSubmitAndWait="); PrintLn(sr2);
    munmap(buf, 64); close(zeroFd); IoUringFree(ring); return 1;
  }

  var cqe2: int64 := IoUringPeekCQE(ring);
  if (cqe2 == 0) {
    PrintLn("FAIL: IoUringPeekCQE(read)=0");
    munmap(buf, 64); close(zeroFd); IoUringFree(ring); return 1;
  }

  var res2: int64 := IoUringCQEResult(cqe2);
  if (res2 != 8) {
    Print("FAIL: Read result="); PrintLn(res2);
    IoUringCQESeen(ring, cqe2); munmap(buf, 64); close(zeroFd); IoUringFree(ring); return 1;
  }
  PrintLn("OK: async Read von /dev/zero -- 8 Bytes");

  var ud2: int64 := IoUringCQEUserData(cqe2);
  if (ud2 != 0xABCD) {
    Print("FAIL: CQEUserData(2)="); PrintLn(ud2);
    IoUringCQESeen(ring, cqe2); munmap(buf, 64); close(zeroFd); IoUringFree(ring); return 1;
  }
  PrintLn("OK: CQEUserData=0xABCD");

  // Pufferinhalt pruefen (muss 0 sein, /dev/zero liefert immer Nullen)
  var b: int64 := peek64(buf);
  if (b != 0) {
    Print("FAIL: Pufferinhalt="); PrintLn(b);
    IoUringCQESeen(ring, cqe2); munmap(buf, 64); close(zeroFd); IoUringFree(ring); return 1;
  }
  PrintLn("OK: Pufferinhalt=0 (/dev/zero)");

  IoUringCQESeen(ring, cqe2);
  munmap(buf, 64);
  close(zeroFd);

  // --- Test 5: IoUringFree ---
  IoUringFree(ring);
  PrintLn("OK: IoUringFree");

  PrintLn("=== WP-13: alle Tests bestanden ===");
  return 0;
}
