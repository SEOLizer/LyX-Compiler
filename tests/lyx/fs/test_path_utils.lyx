import std.fs;

fn main(): int64 {
  var buf: pchar := StrNew(512);

  // PathJoin — kein Slash nötig
  PathJoin(buf, "/home/user", "docs");
  if (StrEquals(buf, "/home/user/docs")) { PrintLn("PathJoin basic: ok"); }

  // PathJoin — a hat trailing Slash
  PathJoin(buf, "/home/user/", "docs");
  if (StrEquals(buf, "/home/user/docs")) { PrintLn("PathJoin trailing slash: ok"); }

  // PathJoin — b hat leading Slash
  PathJoin(buf, "/home/user", "/docs");
  if (StrEquals(buf, "/home/user/docs")) { PrintLn("PathJoin leading slash: ok"); }

  // PathJoin — leeres a
  PathJoin(buf, "", "docs");
  if (StrEquals(buf, "docs")) { PrintLn("PathJoin empty a: ok"); }

  // PathJoin — leeres b
  PathJoin(buf, "/home", "");
  if (StrEquals(buf, "/home")) { PrintLn("PathJoin empty b: ok"); }

  // PathJoin — beide leer
  PathJoin(buf, "", "");
  if (StrEquals(buf, "")) { PrintLn("PathJoin both empty: ok"); }

  // IsAbsolutePath
  if (IsAbsolutePath("/etc/hosts"))    { PrintLn("IsAbsolutePath abs: ok"); }
  if (!IsAbsolutePath("relative/path")){ PrintLn("IsAbsolutePath rel: ok"); }
  if (!IsAbsolutePath(""))             { PrintLn("IsAbsolutePath empty: ok"); }

  return 0;
}
