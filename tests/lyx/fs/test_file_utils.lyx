import std.fs;

fn main(): int64 {
  // FileCopy
  WriteFile("/tmp/lyx_fs03_src.txt", "hello lyx", 9);
  var copied: bool := FileCopy("/tmp/lyx_fs03_src.txt", "/tmp/lyx_fs03_dst.txt");
  if (copied) { PrintLn("FileCopy: ok"); }
  if (FileSize("/tmp/lyx_fs03_dst.txt") == 9) { PrintLn("FileCopy size: ok"); }

  // FileMove (Rename-Pfad — gleiches Dateisystem)
  var moved: bool := FileMove("/tmp/lyx_fs03_dst.txt", "/tmp/lyx_fs03_moved.txt");
  if (moved) { PrintLn("FileMove: ok"); }
  if (IsFile("/tmp/lyx_fs03_moved.txt"))     { PrintLn("Moved file exists: ok"); }
  if (!FileExists("/tmp/lyx_fs03_dst.txt"))   { PrintLn("Old file gone: ok"); }

  // FileReadAll (Builtin) + FileReadFree
  var data: pchar := FileReadAll("/tmp/lyx_fs03_src.txt");
  if (data != 0 as pchar) { PrintLn("FileReadAll: ok"); }
  if (StrEquals(data, "hello lyx")) { PrintLn("FileReadAll content: ok"); }
  FileReadFree(data);
  PrintLn("FileReadFree: ok");

  // FileReadAll auf nicht-existente Datei
  var bad: pchar := FileReadAll("/tmp/lyx_not_existing_xyz");
  if (bad == 0 as pchar) { PrintLn("FileReadAll missing: ok"); }

  // Aufräumen
  Remove("/tmp/lyx_fs03_src.txt");
  Remove("/tmp/lyx_fs03_moved.txt");

  return 0;
}
