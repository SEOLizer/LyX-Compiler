import std.fs;

fn main(): int64 {
  mkdir("/tmp/lyx_dirlist_test", 493);
  WriteFile("/tmp/lyx_dirlist_test/alpha.txt", "a", 1);
  WriteFile("/tmp/lyx_dirlist_test/beta.txt",  "b", 1);
  mkdir("/tmp/lyx_dirlist_test/subdir", 493);

  var d: int64 := DirList("/tmp/lyx_dirlist_test");

  var n: int64 := DirEntryCount(d);
  Print("count: "); PrintLn(n);

  var t1: int64 := DirEntryType(d, "alpha.txt", 9);
  var t2: int64 := DirEntryType(d, "subdir",    6);
  var t3: int64 := DirEntryType(d, "missing",   7);

  Print("alpha.txt type: "); PrintLn(t1);
  Print("subdir type: ");    PrintLn(t2);
  Print("missing type: ");   PrintLn(t3);

  DirFree(d);

  unlink("/tmp/lyx_dirlist_test/alpha.txt");
  unlink("/tmp/lyx_dirlist_test/beta.txt");
  rmdir("/tmp/lyx_dirlist_test/subdir");
  rmdir("/tmp/lyx_dirlist_test");

  return 0;
}
