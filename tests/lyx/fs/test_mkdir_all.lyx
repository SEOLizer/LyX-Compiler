import std.fs;

fn main(): int64 {
  var base: pchar := "/tmp/lyx_mka";

  // Tiefe Verschachtelung anlegen
  var deep: pchar := "/tmp/lyx_mka/a/b/c/d";
  if (MkdirAll(deep, DEFAULT_DIR_MODE)) { PrintLn("MkdirAll deep: ok"); }
  if (IsDirectory("/tmp/lyx_mka/a/b/c/d")) { PrintLn("All dirs exist: ok"); }

  // Idempotenz: nochmal aufrufen gibt true
  if (MkdirAll(deep, DEFAULT_DIR_MODE)) { PrintLn("MkdirAll idempotent: ok"); }

  // Einfacher Fall: ein Level
  if (MkdirAll("/tmp/lyx_mka_single", DEFAULT_DIR_MODE)) { PrintLn("MkdirAll single: ok"); }
  if (IsDirectory("/tmp/lyx_mka_single")) { PrintLn("Single dir exists: ok"); }

  // Fehlerfall: leerer Pfad
  if (!MkdirAll("", DEFAULT_DIR_MODE)) { PrintLn("MkdirAll empty: ok"); }

  // Aufräumen
  Rmdir("/tmp/lyx_mka/a/b/c/d");
  Rmdir("/tmp/lyx_mka/a/b/c");
  Rmdir("/tmp/lyx_mka/a/b");
  Rmdir("/tmp/lyx_mka/a");
  Rmdir("/tmp/lyx_mka");
  Rmdir("/tmp/lyx_mka_single");

  return 0;
}
