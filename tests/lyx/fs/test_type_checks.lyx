import std.fs;

fn main(): int64 {
  // Bekannte Verzeichnisse und Dateien
  var dirOk:    bool := IsDirectory("/tmp");
  var fileOk:   bool := IsFile("/etc/hostname");
  var existsD:  bool := FileExists("/tmp");
  var existsF:  bool := FileExists("/etc/hostname");

  // Negative Tests
  var noDir:    bool := IsDirectory("/etc/hostname");
  var noFile:   bool := IsFile("/tmp");
  var noExist:  bool := FileExists("/tmp/lyx_not_existing_xyz");

  // Eigene Testdatei
  WriteFile("/tmp/lyx_fc_test.txt", "hello", 5);
  var myFile:   bool := IsFile("/tmp/lyx_fc_test.txt");
  var myDir:    bool := IsDirectory("/tmp/lyx_fc_test.txt");
  var myExists: bool := FileExists("/tmp/lyx_fc_test.txt");
  unlink("/tmp/lyx_fc_test.txt");

  if (dirOk)   { PrintLn("IsDirectory(/tmp) = true"); }
  if (fileOk)  { PrintLn("IsFile(/etc/hostname) = true"); }
  if (existsD) { PrintLn("FileExists(/tmp) = true"); }
  if (existsF) { PrintLn("FileExists(/etc/hostname) = true"); }
  if (!noDir)  { PrintLn("IsDirectory(/etc/hostname) = false"); }
  if (!noFile) { PrintLn("IsFile(/tmp) = false"); }
  if (!noExist){ PrintLn("FileExists(missing) = false"); }
  if (myFile)  { PrintLn("IsFile(test.txt) = true"); }
  if (!myDir)  { PrintLn("IsDirectory(test.txt) = false"); }
  if (myExists){ PrintLn("FileExists(test.txt) = true"); }

  return 0;
}
