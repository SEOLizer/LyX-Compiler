import std.fs;

fn main(): int64 {
  // Mkdir
  var ok: bool := Mkdir("/tmp/lyx_fs02_test", DEFAULT_DIR_MODE);
  if (ok) { PrintLn("Mkdir: ok"); }

  // IsDirectory bestätigt
  if (IsDirectory("/tmp/lyx_fs02_test")) { PrintLn("IsDirectory nach Mkdir: ok"); }

  // Chmod
  if (Chmod("/tmp/lyx_fs02_test", S_IRWXU)) { PrintLn("Chmod 0700: ok"); }

  // Datei anlegen, Rename
  WriteFile("/tmp/lyx_fs02_test/a.txt", "x", 1);
  if (Rename("/tmp/lyx_fs02_test/a.txt", "/tmp/lyx_fs02_test/b.txt")) {
    PrintLn("Rename: ok");
  }
  if (IsFile("/tmp/lyx_fs02_test/b.txt"))  { PrintLn("Renamed file exists: ok"); }
  if (!FileExists("/tmp/lyx_fs02_test/a.txt")) { PrintLn("Old name gone: ok"); }

  // Remove (Datei)
  if (Remove("/tmp/lyx_fs02_test/b.txt")) { PrintLn("Remove file: ok"); }
  if (!FileExists("/tmp/lyx_fs02_test/b.txt")) { PrintLn("File removed: ok"); }

  // Remove (leeres Verzeichnis)
  if (Remove("/tmp/lyx_fs02_test")) { PrintLn("Remove dir: ok"); }
  if (!FileExists("/tmp/lyx_fs02_test")) { PrintLn("Dir removed: ok"); }

  return 0;
}
