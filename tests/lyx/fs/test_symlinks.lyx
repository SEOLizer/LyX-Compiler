import std.fs;

fn main(): int64 {
  var target: pchar := "/tmp/lyx_sym_target.txt";
  var link:   pchar := "/tmp/lyx_sym_link.txt";
  var buf:    pchar := StrNew(512);

  // Setup: Zieldatei anlegen
  WriteFile(target, "symlink content", 15);

  // Symlink erstellen
  if (Symlink(target, link)) { PrintLn("Symlink: ok"); }

  // IsLink bestätigt
  if (IsLink(link)) { PrintLn("IsLink: ok"); }

  // stat folgt Symlink → Größe der Zieldatei
  if (FileSizeFast(link) == 15) { PrintLn("FileSizeFast via link: ok"); }

  // ReadLinkStr liest den Link-Pfad
  var n: int64 := ReadLinkStr(link, buf, 512);
  if (n > 0 && StrEquals(buf, target)) { PrintLn("ReadLinkStr: ok"); }

  // ReadLink (raw, ohne automatisches NUL)
  var n2: int64 := ReadLink(link, buf, 511);
  if (n2 > 0) {
    StrSetChar(buf, n2, 0);
    if (StrEquals(buf, target)) { PrintLn("ReadLink raw: ok"); }
  }

  // Fehlerfall: kein Symlink
  var bad: int64 := ReadLinkStr(target, buf, 512);
  if (bad == -1) { PrintLn("ReadLinkStr on non-link: ok"); }

  // Aufräumen
  unlink(link);
  Remove(target);
  return 0;
}
