import std.fs;

fn main(): int64 {
  // Verzeichnisstruktur aufbauen
  MkdirAll("/tmp/lyx_dw/sub1", DEFAULT_DIR_MODE);
  MkdirAll("/tmp/lyx_dw/sub2/deep", DEFAULT_DIR_MODE);
  WriteFile("/tmp/lyx_dw/root.txt",       "r", 1);
  WriteFile("/tmp/lyx_dw/sub1/a.txt",     "a", 1);
  WriteFile("/tmp/lyx_dw/sub2/b.txt",     "b", 1);
  WriteFile("/tmp/lyx_dw/sub2/deep/c.txt","c", 1);

  var d: int64 := DirWalk("/tmp/lyx_dw");
  var n: int64 := DirWalkCount(d);

  // 4 Dateien + 3 Verzeichnisse (sub1, sub2, sub2/deep) = 7
  if (n == 7) { PrintLn("DirWalkCount: ok"); }

  // Alle Einträge haben vollständige Pfade und valide Typen
  var buf: pchar := StrNew(512);
  var ok: bool := true;
  var i: int64 := 0;
  while (i < n) {
    var pathLen: int64 := DirWalkPath(d, i, buf);
    var t: int64 := DirWalkType(d, i);
    if (pathLen <= 0) { ok := false; }
    if (t == DT_UNKNOWN) { ok := false; }
    i := i + 1;
  }
  if (ok) { PrintLn("All entries valid: ok"); }

  // Ungültiger Index
  if (DirWalkPath(d, 9999, buf) == -1) { PrintLn("Invalid index: ok"); }
  if (DirWalkType(d, 9999) == DT_UNKNOWN) { PrintLn("Invalid type: ok"); }

  // Fehlerfall: kein Verzeichnis
  var bad: int64 := DirWalk("/tmp/lyx_not_there");
  if (bad == 0) { PrintLn("DirWalk missing: ok"); }

  DirWalkFree(d);
  PrintLn("DirWalkFree: ok");

  // Aufräumen
  unlink("/tmp/lyx_dw/sub2/deep/c.txt");
  unlink("/tmp/lyx_dw/sub2/b.txt");
  unlink("/tmp/lyx_dw/sub1/a.txt");
  unlink("/tmp/lyx_dw/root.txt");
  Rmdir("/tmp/lyx_dw/sub2/deep");
  Rmdir("/tmp/lyx_dw/sub2");
  Rmdir("/tmp/lyx_dw/sub1");
  Rmdir("/tmp/lyx_dw");

  return 0;
}
