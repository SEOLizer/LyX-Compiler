import std.fs;

fn main(): int64 {
  // Testdatei anlegen
  WriteFile("/tmp/lyx_stat_test.txt", "hello", 5);

  // FileSizeFast
  var sz: int64 := FileSizeFast("/tmp/lyx_stat_test.txt");
  if (sz == 5) { PrintLn("FileSizeFast: ok"); }

  // FileModTime — muss > 0 sein
  var mt: int64 := FileModTime("/tmp/lyx_stat_test.txt");
  if (mt > 0) { PrintLn("FileModTime: ok"); }

  // FileAccessTime — muss > 0 sein
  var at: int64 := FileAccessTime("/tmp/lyx_stat_test.txt");
  if (at > 0) { PrintLn("FileAccessTime: ok"); }

  // FilePerm — WriteFile legt mit DEFAULT_MODE (0644 = 420) an
  var perm: int64 := FilePerm("/tmp/lyx_stat_test.txt");
  if (perm == 420) { PrintLn("FilePerm 0644: ok"); }

  // Fehlerfall: nicht existierende Datei
  var badSz: int64 := FileSizeFast("/tmp/lyx_not_existing_xyz");
  if (badSz == -1) { PrintLn("FileSizeFast missing: ok"); }

  // IsLink — reguläre Datei ist kein Symlink
  if (!IsLink("/tmp/lyx_stat_test.txt")) { PrintLn("IsLink regular: ok"); }

  // IsLink — /etc/localtime ist typischerweise ein Symlink
  if (IsLink("/etc/localtime")) { PrintLn("IsLink symlink: ok"); }

  // FileStat — direkter statBuf-Zugriff
  var sbuf: int64 := mmap(0, 144, 3, 34, -1, 0);
  if (FileStat("/tmp/lyx_stat_test.txt", sbuf)) {
    var size2: int64 := peek64(sbuf + 48);
    if (size2 == 5) { PrintLn("FileStat size: ok"); }
  }
  munmap(sbuf, 144);

  Remove("/tmp/lyx_stat_test.txt");
  return 0;
}
