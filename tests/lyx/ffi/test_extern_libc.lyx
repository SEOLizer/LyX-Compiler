// FFI regression (WP-PM-05.2): `extern fn ... link "libc.so.6"` must produce a
// real dynamically-linked binary that calls into libc — not the old stub that
// returned a constant. Uses only deterministic libc functions so stdout is
// stable. A real run links /lib64/ld-linux-x86-64.so.2 + libc.so.6.
extern fn strlen(s: pchar): int64 link "libc.so.6";
// #1153: `strncmp` nimmt ZWEI pchar-Parameter; die FFI-Sandbox verlangt fuer
// ein Symbol, das sie nicht einordnen kann, eine ausdrueckliche Angabe
// (fail-closed). Die Angabe ist die Erklaerung des Aufrufers, welchen Zugriff
// das Symbol bekommt — hier keinen ueber den Prozess hinaus.
@cap(system.exit)
extern fn strncmp(a: pchar, b: pchar, n: int64): int64 link "libc.so.6";

fn main(): int64 {
    Print("strlen="); PrintInt(strlen("abcdefg"));            Print("\n");
    Print("eq=");     PrintInt(strncmp("apple", "apple", 5)); Print("\n");
    return 0;
}
