// Einfacher MySQL Parameter Debug
import std.io;

type TestConn = struct {
    a: int64;
    b: pchar;
    c: pchar;
};

fn createConn(host: pchar, port: int64, user: pchar, pass: pchar, db: pchar): TestConn {
    var conn: TestConn;
    conn.a := port;
    conn.b := host;
    conn.c := pass;
    Print("  Inside createConn:\n");
    Print("    port = ");
    PrintInt(conn.a);
    Print("\n");
    Print("    host = ");
    Print(conn.b);
    Print("\n");
    Print("    pass = ");
    Print(conn.c);
    Print("\n");
    return conn;
}

pub fn main(): int64 {
    Print("=== MySQL Parameter Debug ===\n");
    
    var conn: TestConn := createConn("myhost", 3306, "myuser", "mypass", "mydb");
    
    Print("After return:\n");
    Print("  port = ");
    PrintInt(conn.a);
    Print("\n");
    Print("  host = ");
    Print(conn.b);
    Print("\n");
    Print("  pass = ");
    Print(conn.c);
    Print("\n");
    
    Print("=== Test Complete ===\n");
    return 0;
}