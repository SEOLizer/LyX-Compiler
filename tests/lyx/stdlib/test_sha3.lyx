import std.hash;

pub fn main(): int64 {
  var s1: pchar := HashSHA3_256Hex("abc");
  PrintLn("SHA3-256(abc)    = ", s1);
  var s2: pchar := HashSHA3_256Hex("");
  PrintLn("SHA3-256()       = ", s2);
  var s3: pchar := HashSHA3_256Hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq");
  PrintLn("SHA3-256(abcd..) = ", s3);
  var s4: pchar := HashSHA3_256Hex("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
  PrintLn("SHA3-256(200xa)  = ", s4);
  return 0;
}
