import std.db.mysql;
import std.io;

pub fn main(): int64 {
    Print("=== MySQL Full Query Test ===\n");
    
    // Connect with username 'lyx' and password 'test12345'
    var conn: MySQLConn := MySQLConnect("127.0.0.1", 3306, "lyx", "test12345", "lyx");
    
    if (conn.fd < 0) {
        Print("Connect FAILED: error=");
        PrintInt(conn.error_num);
        Print("\n");
        return 1;
    }
    
    Print("Connected!\n");
    
    // Send COM_QUERY: SELECT 1
    var result: int64 := MySQLQuery(conn, "SELECT 1 AS test_value");
    
    if (result < 0) {
        Print("Query failed: ");
        PrintInt(result);
        Print("\n");
        sys_close(conn.fd);
        return 1;
    }
    
    Print("Query result rows: ");
    PrintInt(result);
    Print("\n");
    
    // Read result
    if (result > 0) {
        var rows: int64 := MySQLFetchRow(conn);
        if (rows > 0) {
            Print("Row 0, Col 0: ");
            PrintInt(peek8(rows));
            Print("\n");
        }
    }
    
    // Cleanup
    sys_close(conn.fd);
    
    Print("=== SUCCESS ===\n");
    return 0;
}