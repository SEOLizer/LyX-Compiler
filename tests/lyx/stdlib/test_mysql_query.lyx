import std.db.mysql;
import std.io;

pub fn main(): int64 {
    Print("=== MySQL Full Query Test ===\n");
    
    // Connect with username 'lyx' and password 'test12345'
    var conn: MySQLConn := MySQLConnect("127.0.0.1", 3306, "lyx", "test12345", "lyx");
    
    if (conn.fd < 0) {
        Print("Connect FAILED: error=");
        PrintInt(conn.error_num);
        Print("\n");
        return 1;
    }
    
    Print("Connected!\n");
    
    // Send COM_QUERY: SELECT 1
    // #1943: MySQLQuery liefert ein MySQLResult, keine Zahl. Bis 1.1.19D stand
    // hier `var result: int64 := ...`; der Struct wurde als Zahl gespeichert,
    // mit `result < 0` verglichen und mit PrintInt ausgegeben. Uebersetzt hat
    // das nur, weil die Typpruefung ueber Unitgrenzen ausfiel — gemessen wurde
    // dabei nichts. Dieselbe Verwechslung ein zweites Mal: MySQLFetchRow
    // erwartet das ERGEBNIS, nicht die Verbindung.
    //
    // Die richtige Form steht nebenan in test_mysql_full_query.lyx; die beiden
    // muessen uebereinstimmen.
    var res: MySQLResult := MySQLQuery(conn, "SELECT 1 AS test_value");
    
    if (conn.error_num != 0) {
        Print("Query failed, error_num = ");
        PrintInt(conn.error_num);
        Print("\n");
        sys_close(conn.fd);
        return 1;
    }
    
    Print("field_count = ");
    PrintInt(res.field_count);
    Print("\n");
    
    // Read result
    if (res.field_count > 0) {
        var row: int64 := MySQLFetchRow(res);
        if (row > 0) {
            Print("Row 0, Col 0: ");
            PrintInt(MySQLGetRowInt(res, row, 0));
            Print("\n");
        }
    }
    
    // Cleanup
    sys_close(conn.fd);
    
    Print("=== SUCCESS ===\n");
    return 0;
}