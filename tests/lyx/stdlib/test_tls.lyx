// WP-STB-07: test TLSKeyCreate / TLSSetValue / TLSGetValue

import std.thread;
import std.io;

fn main(): int64 {
    // First key is 1 (key 0 is reserved/invalid)
    var key: TLSKey := TLSKeyCreate();
    PrintLn(key);         // expect: 1

    // Set and retrieve a value
    var ret: int64 := TLSSetValue(key, 42);
    PrintLn(ret);         // expect: 0

    var val: int64 := TLSGetValue(key);
    PrintLn(val);         // expect: 42

    // Invalid key 0 must be rejected
    ret := TLSSetValue(0, 999);
    PrintLn(ret);         // expect: -1

    // GetValue on unset key returns 0
    var key2: TLSKey := TLSKeyCreate();
    PrintLn(key2);        // expect: 2
    val := TLSGetValue(key2);
    PrintLn(val);         // expect: 0

    // Two keys are independent
    TLSSetValue(key2, 100);
    PrintLn(TLSGetValue(key));   // expect: 42
    PrintLn(TLSGetValue(key2));  // expect: 100

    // Overwrite works
    TLSSetValue(key, 7);
    PrintLn(TLSGetValue(key));   // expect: 7

    // ThreadSelf TID is consistent across calls
    var tid1: int64 := ThreadSelf();
    var tid2: int64 := ThreadSelf();
    if (tid1 == tid2) { PrintLn("tid_stable=true"); }

    PrintLn("OK");
    return 0;
}
