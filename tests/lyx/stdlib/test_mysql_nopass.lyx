// MySQL test without password
import std.db.mysql;
import std.io;

pub fn main(): int64 {
    Print("MySQL Test without password\n");
    
    var conn: MySQLConn := MySQLConnect("127.0.0.1", 3306, "lyx", "", "lyx");
    
    if (conn.fd < 0) {
        Print("Connect failed: ");
        PrintInt(conn.error_num);
        Print("\n");
        return 1;
    }
    
    Print("Connected!\n");
    
    var res: MySQLResult := MySQLQuery(conn, "SELECT 1");
    
    if (conn.error_num != 0) {
        Print("Query failed: ");
        PrintInt(conn.error_num);
        Print("\n");
    }
    else {
        Print("Query success!\n");
    }

    MySQLFreeResult(res); 
    MySQLClose(conn);
    Print("Test done.\n");
    return 0;
}