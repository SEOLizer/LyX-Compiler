// WP-STB-06: test ini.LoadFile / ini.SaveFile / ini.GetString

import std.ini;
import std.io;

fn main(): int64 {
    var ini_content: pchar := "[database]\nhost = localhost\nport = 5432\n\n[app]\nname = MyApp\ndebug = true\n";

    var doc: int64 := ParseString(ini_content);
    if (doc == 0) {
        PrintLn("FAIL: ParseString returned 0");
        return 1;
    }

    var host: pchar := GetString(doc, "database", "host", "MISSING");
    PrintLn(host);  // expect: localhost

    var name: pchar := GetString(doc, "app", "name", "MISSING");
    PrintLn(name);  // expect: MyApp

    var port: int64 := GetInt(doc, "database", "port", 0);
    PrintLn(port);  // expect: 5432

    var missing: pchar := GetString(doc, "database", "nonexistent", "DEFAULT");
    PrintLn(missing);  // expect: DEFAULT

    var has_db: bool := HasSection(doc, "database");
    if (has_db) { PrintLn("has_database=true"); }

    var has_host: bool := HasKey(doc, "database", "host");
    if (has_host) { PrintLn("has_host=true"); }

    var count: int64 := GetSectionCount(doc);
    PrintLn(count);  // expect: 2

    // Test SaveFile / LoadFile round-trip
    var tmp_path: pchar := "/tmp/lyx_test.ini";
    var saved: bool := SaveFile(doc, tmp_path);
    if (not saved) {
        PrintLn("FAIL: SaveFile returned false");
        return 1;
    }

    var doc2: int64 := LoadFile(tmp_path);
    if (doc2 == 0) {
        PrintLn("FAIL: LoadFile returned 0");
        return 1;
    }

    var host2: pchar := GetString(doc2, "database", "host", "MISSING");
    PrintLn(host2);  // expect: localhost

    var name2: pchar := GetString(doc2, "app", "name", "MISSING");
    PrintLn(name2);  // expect: MyApp

    PrintLn("OK");
    return 0;
}
