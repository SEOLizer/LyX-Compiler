// WP-STB-09: test LFDParseString / LFDGetNodeType / LFDGetNodeChild

import std.lfd_parser;
import std.io;

fn main(): int64 {
    // Basic parse: form with one button
    var root: int64 := LFDParseString("form { button \"OK\" { } }");
    if (root == -1) { PrintLn("parse_failed"); return 1; }

    var kind: int64 := LFDGetNodeType(root);
    PrintLn(kind);             // expect: 0  (LFD_TK_FORM)

    var child: int64 := LFDGetNodeChild(root, 0);
    if (child == 0) { PrintLn("no_child"); return 1; }

    var ckind: int64 := LFDGetNodeType(child);
    PrintLn(ckind);            // expect: 6  (LFD_TK_BUTTON)

    var cc: int64 := LFDGetNodeChildCount(root);
    PrintLn(cc);               // expect: 1

    var c2: int64 := LFDGetNodeChild(root, 1);
    PrintLn(c2);               // expect: 0  (no second child)

    // Error case: no 'form' keyword
    var bad: int64 := LFDParseString("invalid { }");
    PrintLn(bad);              // expect: -1

    // Multi-widget: button + label
    var root2: int64 := LFDParseString("form { button \"OK\" { } label \"Name\" { } }");
    if (root2 == -1) { PrintLn("parse2_failed"); return 1; }
    var cc2: int64 := LFDGetNodeChildCount(root2);
    PrintLn(cc2);              // expect: 2

    // Nested layout
    var root3: int64 := LFDParseString("form { vertical { button \"A\" { } button \"B\" { } } }");
    if (root3 == -1) { PrintLn("parse3_failed"); return 1; }
    var vbox: int64 := LFDGetNodeChild(root3, 0);
    var lkind: int64 := LFDGetNodeType(vbox);
    PrintLn(lkind);            // expect: 2  (LFD_TK_VERTICAL)
    var lcc: int64 := LFDGetNodeChildCount(vbox);
    PrintLn(lcc);              // expect: 2

    // Property inside widget
    var root4: int64 := LFDParseString("form { button \"Save\" { width: 100 height: 30 } }");
    if (root4 == -1) { PrintLn("parse4_failed"); return 1; }
    var btn: int64 := LFDGetNodeChild(root4, 0);
    var propw: int64 := LFDGetNodeChild(btn, 0);
    var proph: int64 := LFDGetNodeChild(btn, 1);
    var pkindw: int64 := LFDGetNodeType(propw);
    PrintLn(pkindw);           // expect: 101 (LFD_NODE_PROPERTY)
    PrintLn(LFDGetNodeIntVal(propw));  // expect: 100
    PrintLn(LFDGetNodeIntVal(proph));  // expect: 30

    PrintLn("OK");
    return 0;
}
