// Simple mmap test
import std.io;
import std.alloc;

pub fn main(): int64 {
    Print("=== mmap Test ===\n");
    
    var data: int64 := alloc(4096);
    Print("mmap returned: ");
    PrintInt(data);
    Print("\n");
    
    if data == 0 {
        Print("ERROR: mmap failed\n");
        return 1;
    }
    
    // Write some data
    poke8(data, 72); // 'H'
    poke8(data + 1, 101); // 'e'
    poke8(data + 2, 108); // 'l'
    poke8(data + 3, 108); // 'l'
    poke8(data + 4, 111); // 'o'
    
    // Read it back
    var b: int64 := peek8(data);
    Print("peek8(data) = ");
    PrintInt(b);
    Print("\n");
    
    var i: int64 := 0;
    while i < 5 {
        var c: int64 := peek8(data + i);
        Print("byte ");
        PrintInt(i);
        Print(" = ");
        PrintInt(c);
        Print("\n");
        i := i + 1;
    }
    
    free(data, 4096);
    
    Print("=== Done ===\n");
    return 0;
}