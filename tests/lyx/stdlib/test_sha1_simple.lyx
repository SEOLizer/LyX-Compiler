// Einfacher SHA1 Test
import std.io;
import std.crypto.sha1;
import std.alloc;

pub fn main(): int64 {
    Print("=== Simple SHA1 Test ===\n");
    
    var data: int64 := alloc(10);
    poke8(data, 72); // 'H'
    poke8(data + 1, 101); // 'e'
    poke8(data + 2, 108); // 'l'
    poke8(data + 3, 108); // 'l'
    poke8(data + 4, 111); // 'o'
    
    var out: int64 := alloc(20);
    
    Print("Calling SHA1...\n");
    SHA1(data, 5, out);
    Print("Back!\n");
    
    Print("Hash: ");
    var i: int64 := 0;
    while (i < 20) {
        PrintInt(peek8(out + i));
        Print(" ");
        i := i + 1;
    }
    Print("\n");
    
    free(data, 10);
    free(out, 20);
    
    Print("=== Done ===\n");
    return 0;
}