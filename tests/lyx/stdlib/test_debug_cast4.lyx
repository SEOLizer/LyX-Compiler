// Debug: Test Cast on struct field passed to function
import std.io;

type TConn = struct {
    fd: int64;
    pass: pchar;
};

fn computeHash(conn: TConn): int64 {
    // Schauen was im Feld ist
    var val: pchar := conn.pass;
    Print("  val = ");
    Print(val);
    Print("\n");
    
    // Adresse der connection selbst
    var connAddr: int64 := @conn;
    Print("  &conn = ");
    PrintInt(connAddr);
    Print("\n");
    
    // Cast
    var addr: int64 := conn.pass as int64;
    Print("  cast = ");
    PrintInt(addr);
    Print("\n");
    
    return addr;
}

pub fn main(): int64 {
    Print("=== Debug Struct Field Cast ===\n");
    
    var conn: TConn;
    conn.fd := 100;
    conn.pass := "secret123";
    
    var result: int64 := computeHash(conn);
    Print("Result = ");
    PrintInt(result);
    Print("\n");
    
    Print("=== Test Complete ===\n");
    return 0;
}