import std.db.mysql;
import std.io;

pub fn main(): int64 {
    Print("MySQL Test (User: lyx, Pass: test12345)\n");
    
    // Speichere alle Parameter lokal, bevor wir die Struct zurückbekommen
    var host: pchar := "127.0.0.1";
    var port: int64 := 3306;
    var user: pchar := "lyx";
    var pass: pchar := "test12345";
    var db: pchar := "lyx";
    
    var conn: MySQLConn := MySQLConnect(host, port, user, pass, db);
    
    if (conn.fd < 0) {
        Print("Connect failed: ");
        PrintInt(conn.error_num);
        Print("\n");
        return 1;
    }
    
    Print("Connected!\n");
    
    // Simple query
    var res: MySQLResult := MySQLQuery(conn, "SELECT 1");
    
    if (conn.error_num != 0) {
        Print("Query failed with error code: ");
        PrintInt(conn.error_num);
        Print("\n");
    }
    else {
        Print("Query success!\n");
        Print("Affected Rows: ");
        PrintInt(MySQLAffectedRows(conn));
        Print("\n");
        // Hier sollten die Ergebnisdaten ausgelesen werden, falls gewünscht.
    }

    MySQLFreeResult(res); 
    MySQLClose(conn);
    Print("Test abgeschlossen.\n");
    return 0;
}