// WP-C6: std/net/http.lyx — PUT/DELETE/Headers/Redirect Test
// Testet alle neuen Funktionen ohne Netzwerkzugang (reine Einheitentests)

import std.net.http;

fn main(): int64 {
    var ok: int64 := 1;

    // T1: HTTPSetHeader baut korrekten Header-String
    var hdrs: int64 := HTTPSetHeader(0, "Content-Type"c, "application/json"c);
    if hdrs == 0 { Print("FAIL T1: HTTPSetHeader returned 0\n"); ok := 0; }
    // Erwartet: "Content-Type: application/json\r\n\0"
    if hdrs != 0 {
        // Prüfe erste Bytes: 'C'=67, 'o'=111, 'n'=110
        if peek8(hdrs) != 67 || peek8(hdrs+1) != 111 || peek8(hdrs+2) != 110 {
            Print("FAIL T1: header prefix wrong\n"); ok := 0;
        }
    }

    // T2: Zweiter Header wird angehängt
    var hdrs2: int64 := HTTPSetHeader(hdrs, "X-Custom"c, "value"c);
    if hdrs2 == 0 { Print("FAIL T2: second header returned 0\n"); ok := 0; }
    // hdrs ist nun freigegeben; hdrs2 enthält beide Header

    // T3: HTTPSetBearerToken
    var hdrs3: int64 := HTTPSetBearerToken(0, "mytoken123"c);
    if hdrs3 == 0 { Print("FAIL T3: bearer token returned 0\n"); ok := 0; }
    // Erwartet: "Authorization: Bearer mytoken123\r\n"
    if hdrs3 != 0 {
        // 'A'=65, 'u'=117, 't'=116, 'h'=104
        if peek8(hdrs3) != 65 { Print("FAIL T3: Authorization prefix\n"); ok := 0; }
    }

    // T4: HTTPSetBasicAuth — Base64("user:pass") = "dXNlcjpwYXNz"
    var hdrs4: int64 := HTTPSetBasicAuth(0, "user"c, "pass"c);
    if hdrs4 == 0 { Print("FAIL T4: basic auth returned 0\n"); ok := 0; }
    // Erwartet: "Authorization: Basic dXNlcjpwYXNz\r\n"
    if hdrs4 != 0 {
        // Suche "Basic d" ab Position 15 ("Authorization: ")
        if peek8(hdrs4 + 15) != 66 || peek8(hdrs4 + 16) != 97 ||
           peek8(hdrs4 + 17) != 115 || peek8(hdrs4 + 18) != 105 {
            Print("FAIL T4: Basic prefix in value\n"); ok := 0;
        }
    }

    // T5: HTTPGetHeader — Suche in simulierten Response-Headern
    // Simuliere headersRaw: "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nX-Req: 42\r\n"
    var fakeHdrs: pchar := "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nX-Req: 42\r\n"c;
    var fakeLen: int64 := 60;  // Approximation
    var fakeLen2: int64 := 0;
    while peek8(fakeHdrs as int64 + fakeLen2) != 0 { fakeLen2 := fakeLen2 + 1; }

    var resp: HTTPResponse;
    resp.statusCode := 200;
    resp.statusText := 0;
    resp.headerCount := 0;
    resp.contentLength := 0;
    resp.bodyPtr := 0;
    resp.bodySize := 0;
    resp.headersRaw := fakeHdrs as int64;
    resp.headersSize := fakeLen2;

    var ctVal: int64 := HTTPGetHeader(resp, "Content-Type"c);
    if ctVal == 0 { Print("FAIL T5: Content-Type not found\n"); ok := 0; }
    if ctVal != 0 {
        // Wert muss "application/json\r\n..." beginnen — 'a'=97
        if peek8(ctVal) != 97 { Print("FAIL T5: Content-Type value wrong\n"); ok := 0; }
    }

    var xreqVal: int64 := HTTPGetHeader(resp, "X-Req"c);
    if xreqVal == 0 { Print("FAIL T5b: X-Req not found\n"); ok := 0; }
    if xreqVal != 0 {
        // Wert "42\r\n" — '4'=52
        if peek8(xreqVal) != 52 { Print("FAIL T5b: X-Req value wrong\n"); ok := 0; }
    }

    // T6: Nicht vorhandener Header → 0
    var noHdr: int64 := HTTPGetHeader(resp, "X-Nonexistent"c);
    if noHdr != 0 { Print("FAIL T6: expected 0 for missing header\n"); ok := 0; }

    // T7: HTTPRequestBuild für DELETE
    var delReq: HTTPRequest;
    delReq.method := HTTP_DELETE;
    delReq.host := "example.com"c as int64;
    delReq.path := "/api/item/1"c as int64;
    delReq.port := 80;
    delReq.headers := hdrs2;  // Custom headers
    delReq.body := 0;
    delReq.bodySize := 0;
    var delBuf: int64 := HTTPRequestBuild(delReq);
    if delBuf == 0 { Print("FAIL T7: HTTPRequestBuild for DELETE\n"); ok := 0; }
    if delBuf != 0 {
        var reqContent: int64 := delBuf + 16;
        // Erwartet: "DELETE /api/item/1 HTTP/1.1\r\n..."
        // 'D'=68, 'E'=69, 'L'=76
        if peek8(reqContent) != 68 || peek8(reqContent+1) != 69 || peek8(reqContent+2) != 76 {
            Print("FAIL T7: DELETE method not in request\n"); ok := 0;
        }
        var allocSz: int64 := peek64(delBuf);
        munmap(delBuf, allocSz);
    }

    // T8: HTTPRequestBuild für PATCH
    var patchReq: HTTPRequest;
    patchReq.method := HTTP_PATCH;
    patchReq.host := "api.example.com"c as int64;
    patchReq.path := "/v1/resource"c as int64;
    patchReq.port := 80;
    patchReq.headers := 0;
    patchReq.body := "patch body"c as int64;
    patchReq.bodySize := 10;
    var patchBuf: int64 := HTTPRequestBuild(patchReq);
    if patchBuf == 0 { Print("FAIL T8: HTTPRequestBuild for PATCH\n"); ok := 0; }
    if patchBuf != 0 {
        var patchContent: int64 := patchBuf + 16;
        // 'P'=80, 'A'=65, 'T'=84, 'C'=67, 'H'=72
        if peek8(patchContent) != 80 || peek8(patchContent+1) != 65 {
            Print("FAIL T8: PATCH method not in request\n"); ok := 0;
        }
        var pallocSz: int64 := peek64(patchBuf);
        munmap(patchBuf, pallocSz);
    }

    // Cleanup
    HTTPHeadersFree(hdrs2);
    HTTPHeadersFree(hdrs3);
    HTTPHeadersFree(hdrs4);

    if ok != 0 {
        Print("PASS: std/net/http WP-C6\n");
    }
    return 0;
}
