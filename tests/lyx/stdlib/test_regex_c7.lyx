import std.regex;
import std.alloc;

pub fn main(): int64 {
    // Test 1: RegexFindAll — Acceptance criterion
    var out: int64 := alloc(10 * 8);
    var count: int64 := RegexFindAll("\\d+", "a1b2c3", out, 10);
    PrintLn("FindAll count = ", count);
    if (count == 3) {
        var m0: pchar := peek64(out + 0 * 8) as pchar;
        var m1: pchar := peek64(out + 1 * 8) as pchar;
        var m2: pchar := peek64(out + 2 * 8) as pchar;
        PrintLn("  [0] = '", m0, "'");
        PrintLn("  [1] = '", m1, "'");
        PrintLn("  [2] = '", m2, "'");
    }

    // Test 2: RegexSearchSpan — Acceptance criterion
    var sPtr: int64 := alloc(8);
    var ePtr: int64 := alloc(8);
    var ok: bool := RegexSearchSpan("\\d+", "abc123", sPtr, ePtr);
    var s: int64 := peek64(sPtr);
    var e: int64 := peek64(ePtr);
    PrintLn("SearchSpan ok = ", ok);
    PrintLn("  s = ", s, "  e = ", e);

    // Test 3: Alternation | — cat|dog matches "dog"
    var out2: int64 := alloc(10 * 8);
    var cnt2: int64 := RegexFindAll("cat|dog", "I have a dog and a cat", out2, 10);
    PrintLn("Alternation count = ", cnt2);
    if (cnt2 >= 2) {
        var a0: pchar := peek64(out2 + 0 * 8) as pchar;
        var a1: pchar := peek64(out2 + 1 * 8) as pchar;
        PrintLn("  [0] = '", a0, "'");
        PrintLn("  [1] = '", a1, "'");
    }

    // Test 4: Alternation | — leftmost match wins
    var sPtr2: int64 := alloc(8);
    var ePtr2: int64 := alloc(8);
    RegexSearchSpan("b|ab", "ab", sPtr2, ePtr2);
    var s2: int64 := peek64(sPtr2);
    PrintLn("Leftmost alt match start = ", s2);

    // Test 5: FindAll — no matches
    var out3: int64 := alloc(8);
    var cnt3: int64 := RegexFindAll("xyz", "hello world", out3, 5);
    PrintLn("No match count = ", cnt3);

    return 0;
}
