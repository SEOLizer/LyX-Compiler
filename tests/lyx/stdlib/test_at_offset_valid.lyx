// WP-A3: at(offset) struct fields — valid usage test

import std.alloc;

// UART-like register struct with explicit memory-mapped offsets
type UART_Regs = struct {
    SR:  u32 at(0);
    DR:  u32 at(4);
    BRR: u32 at(8);
    CR1: u32 at(12);
};

// @packed struct — sizeof without padding
@packed
type PackedReg = struct {
    a: int8;
    b: int16;
    c: int32;
};

// Mixed field sizes at explicit offsets
type MixedMap = struct {
    flags: int8  at(0);
    value: int32 at(4);
    ptr:   int64 at(8);
};

pub fn main(): int64 {
    // Test 1: BRR at offset 8 — write via raw pointer, read back
    var buf: int64 := alloc(64);
    poke32(buf + 8, 0x1234);
    var brrVal: int64 := peek32(buf + 8);
    if (brrVal == 0x1234) {
        PrintLn("BRR at offset 8: OK");
    } else {
        PrintLn("BRR offset FAIL");
    }

    // Test 2: MixedMap — ptr at offset 8 (not overlapping flags@0 or value@4)
    var mbuf: int64 := alloc(32);
    poke8(mbuf + 0, 0x7F);
    poke32(mbuf + 4, 0xCAFE);
    poke64(mbuf + 8, 0x123456789ABCDEF0);
    var flagsVal: int64 := peek8(mbuf);
    var valVal:   int64 := peek32(mbuf + 4);
    var ptrVal:   int64 := peek64(mbuf + 8);
    if (flagsVal == 0x7F && valVal == 0xCAFE && ptrVal == 0x123456789ABCDEF0) {
        PrintLn("MixedMap offsets: OK");
    } else {
        PrintLn("MixedMap FAIL");
    }

    return 0;
}
