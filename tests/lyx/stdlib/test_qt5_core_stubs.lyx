// WP-STB-10: test QCoreApplicationExists, QStringFromUtf8, QStringToUtf8

import std.qt5_core;
import std.io;

fn main(): int64 {
    // Without a running QApplication, QCoreApplicationExists() must return 0
    var exists: int64 := QCoreApplicationExists();
    PrintLn(exists);          // expect: 0

    // QStringFromUtf8 / QStringToUtf8 round-trip
    var qs: int64 := QStringFromUtf8("hello");
    if (qs == 0) { PrintLn("QString_alloc_failed"); return 1; }

    var ptr: int64 := QStringToUtf8(qs);
    if (ptr == 0) { PrintLn("toUtf8_failed"); return 1; }

    // Compare byte-by-byte: "hello" = 104 101 108 108 111
    var ok: int64 := 1;
    if (peek8(ptr)     != 104) { ok := 0; }
    if (peek8(ptr + 1) != 101) { ok := 0; }
    if (peek8(ptr + 2) != 108) { ok := 0; }
    if (peek8(ptr + 3) != 108) { ok := 0; }
    if (peek8(ptr + 4) != 111) { ok := 0; }
    if (peek8(ptr + 5) != 0)   { ok := 0; }
    PrintLn(ok);               // expect: 1

    // QStringFree must not crash
    QStringFree(qs);

    // Null-safety: passing 0 must return 0, not crash
    var nil1: int64 := QStringFromUtf8(0 as pchar);
    PrintLn(nil1);             // expect: 0
    var nil2: int64 := QStringToUtf8(0);
    PrintLn(nil2);             // expect: 0

    // QCoreApplicationQuit / QCoreApplicationProcessEvents must not crash
    // when called without a running event loop
    QCoreApplicationQuit();
    QCoreApplicationProcessEvents();

    PrintLn("OK");
    return 0;
}
