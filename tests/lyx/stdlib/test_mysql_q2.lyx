import std.db.mysql;
import std.io;
import std.alloc;

pub fn main(): int64 {
    Print("=== MySQL Simple Query Test ===\n");
    
    var conn: MySQLConn := MySQLConnect("127.0.0.1", 3306, "lyx", "test12345", "lyx");
    
    if (conn.fd < 0) {
        Print("Connect FAILED: error=");
        PrintInt(conn.error_num);
        return 1;
    }
    
    Print("Connected OK!\n");
    
    // Build SQL buffer directly
    var sql: pchar := "SELECT 1";
    var sqlLen: int64 := 8;
    var sqlBuf: int64 := alloc(sqlLen);
    
    // Copy string to buffer
    var i: int64 := 0;
    while (i < sqlLen) {
        poke8(sqlBuf + i, peek8(sql + i));
        i := i + 1;
    }
    
    Print("Sending packet...\n");
    var ok: bool := MySQLSendPacket(conn, sqlBuf, sqlLen);
    if (ok) { Print("Send OK\n"); } else { Print("Send FAIL\n"); }
    free(sqlBuf, sqlLen);
    
    if (!ok) {
        sys_close(conn.fd);
        return 1;
    }
    
    Print("Reading response packet...\n");
    var pkt: int64 := MySQLReadPacket(conn);
    if (pkt > 0) {
        Print("Got packet: len=");
        PrintInt(conn.last_payload_len);
        Print(", first=");
        PrintInt(peek8(pkt));
        Print("\n");
        free(pkt, conn.last_payload_len + 1);
    } else {
        Print("No packet\n");
    }
    
    sys_close(conn.fd);
    
    Print("=== SUCCESS ===\n");
    return 0;
}