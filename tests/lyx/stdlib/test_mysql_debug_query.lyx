import std.db.mysql;
import std.io;
import std.string;

pub fn main(): int64 {
    Print("=== MySQL Debug Query Test ===\n");
    
    var conn: MySQLConn := MySQLConnect("127.0.0.1", 3306, "lyx", "test12345", "lyx");
    
    if (conn.fd < 0) {
        Print("Connect FAILED: error=");
        PrintInt(conn.error_num);
        Print("\n");
        return 1;
    }
    
    Print("Connected OK!\n");
    
    // Test StrLen on a simple string
    var testStr: pchar := "SELECT 1";
    var slen: int64 := StrLen(testStr);
    Print("StrLen('SELECT 1') = ");
    PrintInt(slen);
    Print("\n");
    
    Print("Calling MySQLQuery...\n");
    
    var result: int64 := MySQLQuery(conn, testStr);
    
    Print("MySQLQuery returned: ");
    PrintInt(result);
    Print("\n");
    
    sys_close(conn.fd);
    
    Print("=== Done ===\n");
    return 0;
}