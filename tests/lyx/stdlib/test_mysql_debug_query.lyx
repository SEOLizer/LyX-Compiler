import std.db.mysql;
import std.io;
import std.string;

pub fn main(): int64 {
    Print("=== MySQL Debug Query Test ===\n");
    
    var conn: MySQLConn := MySQLConnect("127.0.0.1", 3306, "lyx", "test12345", "lyx");
    
    if (conn.fd < 0) {
        Print("Connect FAILED: error=");
        PrintInt(conn.error_num);
        Print("\n");
        return 1;
    }
    
    Print("Connected OK!\n");
    
    // Test StrLen on a simple string
    var testStr: pchar := "SELECT 1";
    var slen: int64 := StrLen(testStr);
    Print("StrLen('SELECT 1') = ");
    PrintInt(slen);
    Print("\n");
    
    Print("Calling MySQLQuery...\n");
    
    // #1943: MySQLQuery liefert ein MySQLResult, keine Zahl — siehe die
    // ausfuehrliche Begruendung in test_mysql_query.lyx. Was diesen Test
    // interessiert, ist ob der Aufruf durchging; das steht in conn.error_num.
    var res: MySQLResult := MySQLQuery(conn, testStr);
    
    Print("MySQLQuery: error_num = ");
    PrintInt(conn.error_num);
    Print(", field_count = ");
    PrintInt(res.field_count);
    Print("\n");
    
    sys_close(conn.fd);
    
    Print("=== Done ===\n");
    return 0;
}