// WP-STB-06: test yaml.LoadFile / yaml.SaveFile / yaml.GetString

import std.yaml;
import std.io;

fn main(): int64 {
    var yaml_content: pchar := "host: localhost\nport: 9200\nname: ElasticApp\nenabled: true\n";

    var doc: int64 := ParseString(yaml_content);
    if (doc == 0) {
        PrintLn("FAIL: ParseString returned 0");
        return 1;
    }

    var host: pchar := GetString(doc, "host", "MISSING");
    PrintLn(host);  // expect: localhost

    var name: pchar := GetString(doc, "name", "MISSING");
    PrintLn(name);  // expect: ElasticApp

    var port: int64 := GetInt(doc, "port", 0);
    PrintLn(port);  // expect: 9200

    var missing: pchar := GetString(doc, "nonexistent", "DEFAULT");
    PrintLn(missing);  // expect: DEFAULT

    // Test SaveFile / LoadFile round-trip
    var tmp_path: pchar := "/tmp/lyx_test.yaml";
    var saved: bool := SaveFile(doc, tmp_path);
    if (not saved) {
        PrintLn("FAIL: SaveFile returned false");
        return 1;
    }

    var doc2: int64 := LoadFile(tmp_path);
    if (doc2 == 0) {
        PrintLn("FAIL: LoadFile returned 0");
        return 1;
    }

    var host2: pchar := GetString(doc2, "host", "MISSING");
    PrintLn(host2);  // expect: localhost

    var name2: pchar := GetString(doc2, "name", "MISSING");
    PrintLn(name2);  // expect: ElasticApp

    PrintLn("OK");
    return 0;
}
