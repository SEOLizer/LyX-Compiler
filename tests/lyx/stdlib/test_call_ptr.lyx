// Test calling function with pointer
import std.io;
import std.alloc;

fn processBuffer(buf: int64, len: int64): int64 {
    var sum: int64 := 0;
    var i: int64 := 0;
    while i < len {
        sum := sum + peek8(buf + i);
        i := i + 1;
    }
    return sum;
}

pub fn main(): int64 {
    Print("=== Pointer Call Test ===\n");
    
    var buf: int64 := alloc(4096);
    if buf == 0 {
        Print("ERROR: mmap failed\n");
        return 1;
    }
    
    poke8(buf, 10);
    poke8(buf + 1, 20);
    poke8(buf + 2, 30);
    
    Print("Calling processBuffer...\n");
    var result: int64 := processBuffer(buf, 3);
    
    Print("Result: ");
    PrintInt(result);
    Print("\n");
    
    free(buf, 4096);
    
    Print("=== Done ===\n");
    return 0;
}