// SHA1 test with no optimization
import std.io;
import std.crypto.sha1;
import std.alloc;

fn dummy(): int64 {
    return 42;
}

pub fn main(): int64 {
    Print("=== SHA1 NoOpt Test ===\n");
    
    var data: int64 := alloc(10);
    poke8(data, 72); // 'H'
    poke8(data + 1, 101); // 'e'
    poke8(data + 2, 108); // 'l'
    poke8(data + 3, 108); // 'l'
    poke8(data + 4, 111); // 'o'
    
    var out: int64 := alloc(20);
    
    var d: int64 := dummy();
    Print("dummy returned: ");
    PrintInt(d);
    Print("\n");
    
    Print("Calling SHA1...\n");
    SHA1(data, 5, out);
    Print("Back!\n");
    
    free(data, 10);
    free(out, 20);
    
    Print("=== Done ===\n");
    return 0;
}