// WP-C10: std/geo.lyx — BoundingBoxFromPoints + CalculateBoundingBox + GeoBBox

import std.geo;

fn main(): int64 {
    var ok: int64 := 1;

    // Punkte in Microdegrees
    var berlin: GeoPoint;
    berlin.x := 13388889;   // 13.388889°E
    berlin.y := 52516667;   // 52.516667°N

    var muenchen: GeoPoint;
    muenchen.x := 11575000;  // 11.575°E
    muenchen.y := 48137100;  // 48.1371°N

    // T1: GeoPointNew
    var p1: GeoPoint := GeoPointNew(13388889, 52516667);
    if p1.x != 13388889 || p1.y != 52516667 {
        Print("FAIL T1: GeoPointNew\n"); ok := 0;
    }

    // T2: BoundingBoxFromPoints — min/max korrekt
    var bb: GeoBBox := BoundingBoxFromPoints(berlin, muenchen);
    if bb.minX != 11575000 { Print("FAIL T2a: minX\n"); ok := 0; }
    if bb.minY != 48137100 { Print("FAIL T2b: minY\n"); ok := 0; }
    if bb.maxX != 13388889 { Print("FAIL T2c: maxX\n"); ok := 0; }
    if bb.maxY != 52516667 { Print("FAIL T2d: maxY\n"); ok := 0; }

    // T3: GeoBBoxGetMin/Max liefern korrekte GeoPoints
    var bmin: GeoPoint := GeoBBoxGetMin(bb);
    var bmax: GeoPoint := GeoBBoxGetMax(bb);
    if bmin.x != 11575000 { Print("FAIL T3a: GetMin.x\n"); ok := 0; }
    if bmax.y != 52516667 { Print("FAIL T3b: GetMax.y\n"); ok := 0; }

    // T4: CalculateBoundingBox — 100km Radius um Berlin
    var bb2: GeoBBox := CalculateBoundingBox(berlin, 100000);
    if bb2.minY >= berlin.y { Print("FAIL T4a: minY should be south\n"); ok := 0; }
    if bb2.maxY <= berlin.y { Print("FAIL T4b: maxY should be north\n"); ok := 0; }
    if bb2.minX >= berlin.x { Print("FAIL T4c: minX should be west\n"); ok := 0; }
    if bb2.maxX <= berlin.x { Print("FAIL T4d: maxX should be east\n"); ok := 0; }

    // T5: GeoBBoxContains — Berlin in Berlin-BBox
    var inBB: bool := GeoBBoxContains(bb2, berlin);
    if !inBB { Print("FAIL T5: center not in own bbox\n"); ok := 0; }

    // T6: GeoBBoxContains — Sydney nicht in Berlin-BBox
    var sydney: GeoPoint;
    sydney.x := 151208000;
    sydney.y := -33868000;
    var notIn: bool := GeoBBoxContains(bb2, sydney);
    if notIn { Print("FAIL T6: Sydney in Berlin bbox\n"); ok := 0; }

    // T7: GeoBBoxCenter
    var center: GeoPoint := GeoBBoxCenter(bb);
    var expLon: int64 := (13388889 + 11575000) / 2;
    var expLat: int64 := (52516667 + 48137100) / 2;
    if center.x != expLon { Print("FAIL T7a: center.x\n"); ok := 0; }
    if center.y != expLat { Print("FAIL T7b: center.y\n"); ok := 0; }

    // T8: GeoBBoxOverlaps — selbst-overlap
    var selfOvl: bool := GeoBBoxOverlaps(bb2, bb2);
    if !selfOvl { Print("FAIL T8\n"); ok := 0; }

    // T9: DistanceMCorrected Berlin-München (400-700km)
    var dist: int64 := DistanceMCorrected(berlin, muenchen);
    if dist < 400000 || dist > 700000 {
        Print("FAIL T9: dist="); PrintInt(dist); Print("\n"); ok := 0;
    }

    // T10: BoundingBoxMin/Max (Regression — alte Hilfsfunktionen)
    var bmin2: GeoPoint := BoundingBoxMin(berlin, muenchen);
    var bmax2: GeoPoint := BoundingBoxMax(berlin, muenchen);
    if bmin2.x != 11575000 { Print("FAIL T10a\n"); ok := 0; }
    if bmax2.y != 52516667 { Print("FAIL T10b\n"); ok := 0; }

    if ok != 0 {
        Print("PASS: std/geo WP-C10\n");
    }
    return 0;
}
