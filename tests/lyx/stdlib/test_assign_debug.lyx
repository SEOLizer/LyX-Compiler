// Test struct field assignment
import std.io;

type TConn = struct {
    fd: int64;
    pass: pchar;
};

fn createConn(passArg: pchar): TConn {
    var conn: TConn;
    conn.fd := 100;
    // Hier ist die Zuweisung
    conn.pass := passArg;
    return conn;
}

pub fn main(): int64 {
    Print("=== Struct Field Assign Test ===\n");
    
    var conn: TConn := createConn("mypassword");
    
    Print("conn.pass = ");
    Print(conn.pass);
    Print("\n");
    
    Print("=== Address Test ===\n");
    var passAddr: int64 := conn.pass as int64;
    Print("addr = ");
    PrintInt(passAddr);
    Print("\n");
    
    if (passAddr > 0) {
        Print("first char = ");
        PrintInt(peek8(passAddr));
        Print("\n");
    }
    
    Print("=== Test Complete ===\n");
    return 0;
}