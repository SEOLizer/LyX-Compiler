// Test Struct Field Address
import std.io;
import std.net.syscalls;

type TestConn = struct {
    fd: int64;
    host: pchar;
    password: pchar;
};

pub fn main(): int64 {
    Print("=== Struct Field Address Test ===\n");
    
    var conn: TestConn;
    conn.fd := 10;
    conn.host := "localhost";
    conn.password := "mypassword";
    
    Print("conn.fd = ");
    PrintInt(conn.fd);
    Print("\n");
    
    // Try to access password field via struct
    Print("conn.password = ");
    Print(conn.password);
    Print("\n");
    
    Print("=== Test Complete ===\n");
    return 0;
}