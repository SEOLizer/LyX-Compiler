import std.net.socket;

pub fn main(): int64 {
  // Create a connected Unix socket pair via socketpair
  // socketpair(AF_UNIX=1, SOCK_STREAM=1, 0, fds_ptr): syscall 53
  var fds: int64 := mmap(0, 16, 3, 34, -1, 0);
  poke64(fds, 0);
  poke64(fds + 8, 0);

  var ret: int64 := sys_socketpair(1, 1, 0, fds);
  if (ret < 0) {
    PrintLn("socketpair failed: ", ret);
    munmap(fds, 16);
    return 1;
  }

  var fd0: int64 := peek32(fds) & 0xFFFFFFFF;
  var fd1: int64 := peek32(fds + 4) & 0xFFFFFFFF;
  PrintLn("fds: ", fd0, " ", fd1);

  var conn: UnixConn;
  conn.fd := fd0;

  var pid_out: int64 := mmap(0, 8, 3, 34, -1, 0);
  var uid_out: int64 := mmap(0, 8, 3, 34, -1, 0);
  var gid_out: int64 := mmap(0, 8, 3, 34, -1, 0);
  poke64(pid_out, 0);
  poke64(uid_out, 0);
  poke64(gid_out, 0);

  var rpid: int64 := UnixSocketGetPeerCred(conn, pid_out, uid_out, gid_out);
  PrintLn("rpid = ", rpid);
  PrintLn("pid  = ", peek64(pid_out));
  PrintLn("uid  = ", peek64(uid_out));
  PrintLn("gid  = ", peek64(gid_out));

  sys_close(fd0);
  sys_close(fd1);
  munmap(fds, 16);
  munmap(pid_out, 8);
  munmap(uid_out, 8);
  munmap(gid_out, 8);
  return 0;
}
