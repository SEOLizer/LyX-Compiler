// WP-STB-08: test FastTextInitVocabFromText / FastTextSaveModel / FastTextLoad

import std.fasttext;
import std.io;

fn main(): int64 {
    FastTextInitVocabFromText("hello world hello");

    var vsz: int64 := FastTextGetVocabSize();
    PrintLn(vsz);          // expect: 2

    var hfreq: int64 := FastTextGetWordFreq("hello");
    PrintLn(hfreq);        // expect: 2

    var wfreq: int64 := FastTextGetWordFreq("world");
    PrintLn(wfreq);        // expect: 1

    var hidx: int64 := FastTextGetWordIndex("hello");
    PrintLn(hidx);         // expect: 0

    var widx: int64 := FastTextGetWordIndex("world");
    PrintLn(widx);         // expect: 1

    var missing: int64 := FastTextGetWordIndex("foo");
    PrintLn(missing);      // expect: -1

    // Save / load round-trip
    var ret: int64 := FastTextSaveModel("/tmp/lyx_test.ft");
    PrintLn(ret);          // expect: 0

    ret := FastTextLoad("/tmp/lyx_test.ft");
    PrintLn(ret);          // expect: 0

    var vsz2: int64 := FastTextGetVocabSize();
    PrintLn(vsz2);         // expect: 2

    var hfreq2: int64 := FastTextGetWordFreq("hello");
    PrintLn(hfreq2);       // expect: 2

    var wfreq2: int64 := FastTextGetWordFreq("world");
    PrintLn(wfreq2);       // expect: 1

    PrintLn("OK");
    return 0;
}
