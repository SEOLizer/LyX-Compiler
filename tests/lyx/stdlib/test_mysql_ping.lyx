import std.db.mysql;
import std.io;

pub fn main(): int64 {
    Print("MySQL Ping Test\n");
    
    var conn: MySQLConn := MySQLConnect("127.0.0.1", 3306, "lyx2", "", "lyx");
    
    if (conn.fd < 0) {
        Print("Connect failed: ");
        PrintInt(conn.error_num);
        Print("\n");
        return 1;
    }
    
    Print("Connected!\n");
    
    // Reset packet_num to 0 for commands
    conn.packet_num := 0;
    
    // Send COM_PING = 14 (0x0E)
    var pingBuf: int64 := mmap(0, 5, 3, 34, -1, 0);
    poke8(pingBuf, 14);  // COM_PING
    
    var sent: bool := MySQLSendPacket(conn, pingBuf, 1);
    munmap(pingBuf, 5);
    
    Print("PING sent: ");
    if (sent) { Print("yes"); } else { Print("no"); }
    Print("\n");
    
    if (!sent) {
        MySQLClose(conn);
        return 1;
    }
    
    // Read response
    Print("Reading response...\n");
    var response: int64 := MySQLReadPacket(conn);
    
    if (response <= 0) {
        Print("No response\n");
        MySQLClose(conn);
        return 1;
    }
    
    var first: int64 := peek8(response);
    var payLen: int64 := conn.last_payload_len;
    
    Print("Response first: ");
    PrintInt(first);
    Print(" (len=");
    PrintInt(payLen);
    Print(")\n");
    
    if (first == 0x00) {
        Print("PONG OK!\n");
    }
    
    munmap(response, payLen + 1);
    MySQLClose(conn);
    Print("Done\n");
    
    return 0;
}