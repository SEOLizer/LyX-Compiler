import std.url;

pub fn main(): int64 {
    // URLPercentEncode / URLPercentDecode
    var enc: pchar := URLPercentEncode("hello world");
    PrintLn("encode('hello world') = '", enc, "'");

    var dec: pchar := URLPercentDecode("hello%20world");
    PrintLn("decode('hello%20world') = '", dec, "'");

    // URLBuild
    var built: pchar := URLBuild("https", "example.com", 0, "/path", "q=1", "sec");
    PrintLn("URLBuild = '", built, "'");

    var built2: pchar := URLBuild("http", "localhost", 8080, "/api", "", "");
    PrintLn("URLBuild(port) = '", built2, "'");

    // URLQueryGet
    var url: pchar := "https://example.com/search?q=lyx&page=2#top";
    var qv: pchar := URLQueryGet(url, "q");
    PrintLn("URLQueryGet(q) = '", qv, "'");
    var qv2: pchar := URLQueryGet(url, "page");
    PrintLn("URLQueryGet(page) = '", qv2, "'");

    // URLQuerySet — add new param
    var u2: pchar := URLQuerySet("https://example.com/search?q=lyx", "page", "3");
    PrintLn("URLQuerySet(add) = '", u2, "'");

    // URLQuerySet — replace existing param
    var u3: pchar := URLQuerySet("https://example.com/?q=old&x=1", "q", "new");
    PrintLn("URLQuerySet(replace) = '", u3, "'");

    // URLQuerySet — URL with no query
    var u4: pchar := URLQuerySet("https://example.com/path", "k", "v");
    PrintLn("URLQuerySet(new) = '", u4, "'");

    // URLResolve — absolute path
    var r1: pchar := URLResolve("https://example.com/a/b/c", "/new/path");
    PrintLn("URLResolve(/path) = '", r1, "'");

    // URLResolve — relative path
    var r2: pchar := URLResolve("https://example.com/a/b/c", "d");
    PrintLn("URLResolve(rel) = '", r2, "'");

    // URLResolve — absolute URL
    var r3: pchar := URLResolve("https://example.com/", "http://other.com/x");
    PrintLn("URLResolve(abs) = '", r3, "'");

    return 0;
}
