// Test calling an empty function
import std.io;

fn myFunc(a: int64): int64 {
    return a + 1;
}

pub fn main(): int64 {
    Print("=== Call Test ===\n");
    
    var result: int64 := myFunc(5);
    
    Print("Result: ");
    PrintInt(result);
    Print("\n");
    
    Print("=== Done ===\n");
    return 0;
}