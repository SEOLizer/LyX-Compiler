// Test printing pointer values
import std.io;
import std.alloc;

fn testFunc(buf: int64, len: int64): int64 {
    Print("In testFunc, buf = ");
    PrintInt(buf);
    Print("\n");
    Print("In testFunc, len = ");
    PrintInt(len);
    Print("\n");
    return 0;
}

pub fn main(): int64 {
    Print("=== Pointer Test ===\n");
    
    var buf: int64 := alloc(4096);
    if buf == 0 {
        Print("ERROR: mmap failed\n");
        return 1;
    }
    
    var len: int64 := 5;
    
    Print("Before call, buf = ");
    PrintInt(buf);
    Print("\n");
    Print("Before call, len = ");
    PrintInt(len);
    Print("\n");
    
    Print("Calling testFunc...\n");
    var result: int64 := testFunc(buf, len);
    
    Print("After call\n");
    
    free(buf, 4096);
    
    Print("=== Done ===\n");
    return 0;
}