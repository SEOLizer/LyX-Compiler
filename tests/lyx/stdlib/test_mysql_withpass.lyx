import std.db.mysql;
import std.io;
import std.alloc;

pub fn main(): int64 {
    Print("=== MySQL with Password Test ===\n");
    
    var conn: MySQLConn := MySQLConnect("127.0.0.1", 3306, "lyx", "test12345", "lyx");
    
    if (conn.fd < 0) {
        Print("FAILED: ");
        PrintInt(conn.error_num);
        Print("\n");
        return 1;
    }
    
    Print("Connected successfully!\n");
    Print("packet_num after auth: ");
    PrintInt(conn.packet_num);
    Print("\n");
    
    // Reset and send COM_PING
    conn.packet_num := 0;
    
    var cmd: int64 := alloc(5);
    poke8(cmd, 1);        // length = 1 byte
    poke8(cmd + 1, 0);   // zero
    poke8(cmd + 2, 0);   // zero
    poke8(cmd + 3, 0);   // packet_num
    poke8(cmd + 4, 14);  // COM_PING = 0x0E
    
    var written: int64 := sys_write(conn.fd, cmd, 5);
    free(cmd, 5);
    
    Print("Wrote ping: ");
    PrintInt(written);
    Print("\n");
    
    // Read response
    var hdr: int64 := alloc(4);
    var nr: int64 := sys_read(conn.fd, hdr, 4);
    
    if (nr <= 0) {
        Print("Read error: ");
        PrintInt(nr);
        Print("\n");
    } else {
        var respLen: int64 := peek8(hdr) | (peek8(hdr + 1) << 8) | (peek8(hdr + 2) << 16);
        var pktNum: int64 := peek8(hdr + 3);
        Print("Response: len=");
        PrintInt(respLen);
        Print(" pkt=");
        PrintInt(pktNum);
        Print("\n");
        
        if (respLen > 0) {
            var body: int64 := alloc(respLen);
            sys_read(conn.fd, body, respLen);
            Print("First byte: ");
            PrintInt(peek8(body));
            Print("\n");
            free(body, respLen);
        }
    }
    
    free(hdr, 4);
    
    // Close connection
    sys_close(conn.fd);
    
    Print("=== SUCCESS ===\n");
    return 0;
}