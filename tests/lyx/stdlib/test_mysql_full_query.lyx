import std.db.mysql;
import std.io;

pub fn main(): int64 {
    Print("=== Full MySQL Query Test ===\n");
    
    var conn: MySQLConn := MySQLConnect("127.0.0.1", 3306, "lyx", "test12345", "lyx");
    
    if (conn.fd < 0) {
        Print("Connect FAILED: error=");
        PrintInt(conn.error_num);
        return 1;
    }
    
    Print("Testing 'SELECT 1 AS test_value'...\n");
    var res: MySQLResult := MySQLQuery(conn, "SELECT 1 AS test_value");
    
    if (res.field_count > 0) {
        Print("field_count = ");
        PrintInt(res.field_count);
        Print("\n");
        
        // Fetch row
        var row: int64 := MySQLFetchRow(res);
        if (row > 0) {
            var val: int64 := MySQLGetRowInt(res, row, 0);
            Print("row value = ");
            PrintInt(val);
            Print("\n");
        }
        
        // Free result
        MySQLFreeResult(res);
    }
    
    Print("\nTesting 'SHOW DATABASES'...\n");
    var res2: MySQLResult := MySQLQuery(conn, "SHOW DATABASES");
    Print("Result field_count = ");
    PrintInt(res2.field_count);
    Print("\n");
    
    var rowCount: int64 := 0;
    var row2: int64 := MySQLFetchRow(res2);
    while (row2 > 0) {
        var dbname: pchar := MySQLGetRowStr(res2, row2, 0);
        rowCount := rowCount + 1;
        row2 := MySQLFetchRow(res2);
    }
    Print("Databases found: ");
    PrintInt(rowCount);
    Print("\n");
    
    MySQLFreeResult(res2);
    MySQLClose(conn);
    
    Print("=== ALL TESTS SUCCESS ===\n");
    return 0;
}