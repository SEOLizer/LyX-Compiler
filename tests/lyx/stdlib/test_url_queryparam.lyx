import std.url;

pub fn main(): int64 {
  var q: pchar := "foo=bar&baz=42&empty=";
  var v1: pchar := GetQueryParam(q, "foo");
  var v2: pchar := GetQueryParam(q, "baz");
  var v3: pchar := GetQueryParam(q, "missing");
  var v4: pchar := GetQueryParam(q, "empty");
  PrintLn("foo    = '", v1, "'");
  PrintLn("baz    = '", v2, "'");
  PrintLn("missing= '", v3, "'");
  PrintLn("empty  = '", v4, "'");
  var h1: bool := HasQueryParam(q, "foo");
  var h2: bool := HasQueryParam(q, "missing");
  PrintLn("HasQueryParam(foo)     = ", h1);
  PrintLn("HasQueryParam(missing) = ", h2);
  return 0;
}
