// Test WAV parser
import std.audio;

pub fn main(): int64 {
  var info: AudioInfo;
  var result: int64;
  var path: pchar;
  
  // Use /tmp/test.wav (created earlier)
  path := "/tmp/test.wav";
  
  result := WAVParse(path, info);
  
  if (result == AUDIO_OK) {
    Print("WAV parsed!\n");
    Print("Format: ");
    PrintInt(info.format);
    Print("\n");
    Print("Sample Rate: ");
    PrintInt(info.sampleRate);
    Print(" Hz\n");
    Print("Channels: ");
    PrintInt(info.channels);
    Print("\n");
    Print("Bits: ");
    PrintInt(info.bitsPerSample);
    Print("\n");
    Print("Duration: ");
    PrintInt(info.durationMs);
    Print(" ms\n");
  } else {
    Print("Failed: ");
    PrintInt(result);
    Print("\n");
  }
  
  return 0;
}