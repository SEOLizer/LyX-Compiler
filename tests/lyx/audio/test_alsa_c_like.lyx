// Compare: Known working pattern from C code
import std.audio;
import std.audio.alsa;
import std.alloc;

pub fn main(): int64 {
  Print("=== ALSA: C-like pattern test ===\n");

  // Open ALSA like C code does
  var hp: int64;
  hp := alloc(8);
  var res: int64;
  
  Print("Opening ALSA...\n");
  res := snd_pcm_open(hp, "hw:0", 0, 0);
  Print("Open result: "); PrintInt(res); Print("\n");
  
  if (res != 0) {
    Print("ERROR: Cannot open ALSA\n");
    return 1;
  }
  
  var alsaHandle: int64;
  alsaHandle := peek64(hp);
  Print("Handle (from peek64): "); PrintInt(alsaHandle); Print("\n");
  free(hp, 8);

  // Allocate params like C code
  Print("Allocating params...\n");
  var pp: int64;
  pp := alloc(8);
  snd_pcm_hw_params_malloc(pp);
  var params: int64;
  params := peek64(pp);
  Print("Params allocated\n");

  // Set params - exact same order as C
  Print("Setting params...\n");
  snd_pcm_hw_params_any(alsaHandle, params);
  snd_pcm_hw_params_set_access(alsaHandle, params, 3);  // RW_INTERLEAVED
  snd_pcm_hw_params_set_format(alsaHandle, params, 2);  // S16_LE
  
  var rate: int64 := 48000;
  var ratePtr: int64;
  ratePtr := alloc(8);
  poke32(ratePtr, rate);
  snd_pcm_hw_params_set_rate_near(alsaHandle, params, ratePtr, 0);
  var actualRate: int64;
  actualRate := peek32(ratePtr);
  Print("Rate requested: "); PrintInt(rate); Print(", actual: "); PrintInt(actualRate); Print("\n");
  free(ratePtr, 8);
  
  snd_pcm_hw_params_set_channels(alsaHandle, params, 2);
  
  res := snd_pcm_hw_params(alsaHandle, params);
  Print("hw_params result: "); PrintInt(res); Print("\n");
  
  if (res != 0) {
    Print("ERROR: Cannot set params: "); PrintInt(res); Print("\n");
    return 1;
  }
  
  snd_pcm_hw_params_free(params);
  free(pp, 8);
  Print("Params set and freed\n");

  // Read audio data
  var fd: int64;
  fd := open("/tmp/playback_30s.wav", 0, 0);
  
  // Debug: check first few bytes of file
  var testBuf: int64;
  testBuf := alloc(16);
  var testRead: int64;
  testRead := sys_read(fd, testBuf, 16);
  free(testBuf, 16);
  
  // Now read from offset 44
  lseek(fd, 44, SEEK_SET);
  
  var playBuf: int64;
  playBuf := alloc(192000);
  var bytesRead: int64;
  bytesRead := sys_read(fd, playBuf, 192000);
  close(fd);
  
  Print("Read "); PrintInt(bytesRead); Print(" bytes\n");

  // Write exactly like C code
  Print("Writing "); PrintInt(48000); Print(" frames...\n");
  res := snd_pcm_writei(alsaHandle, playBuf, 48000);
  Print("Write result: "); PrintInt(res); Print(" frames\n");
  
  if (res < 0) {
    Print("Write error: ");
    PrintInt(res); Print("\n");
  }
  
  // Skip drain - just close immediately
  Print("Closing...\n");
  snd_pcm_close(alsaHandle);
  
  free(playBuf, 192000);
  
  Print("=== Done ===\n");
  return 0;
}