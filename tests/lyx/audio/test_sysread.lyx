// sys_read test
pub fn main(): int64 {
  var fd: int64;
  var buf: int64;
  
  fd := open("test.wav", O_RDONLY, 0);
  Print("fd=");
  PrintInt(fd);
  Print("\n");
  
  // mmap buffer
  buf := mmap(0, 100, 3, 34, -1, 0);
  Print("buf=");
  PrintInt(buf);
  Print("\n");
  
  // sys_read with buffer
  var ret: int64;
  ret := sys_read(fd, buf, 50);
  Print("ret=");
  PrintInt(ret);
  Print("\n");
  
  if (ret > 0) {
    Print("content: ");
    PrintInt(peek8(buf + 0));
    Print(" ");
    PrintInt(peek8(buf + 1));
    Print(" ");
    PrintInt(peek8(buf + 2));
    Print(" ");
    PrintInt(peek8(buf + 3));
    Print("\n");
  }
  
  close(fd);
  
  return 0;
}