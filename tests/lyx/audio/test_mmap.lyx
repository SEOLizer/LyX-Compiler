// mmap test
pub fn main(): int64 {
  var buf: int64;
  
  // Simple mmap test
  buf := mmap(0, 4096, 3, 34, -1, 0);   // #2088: Offset fehlte (r9 = Muell), MAP_ANON allein ist kein gueltiger Typ
