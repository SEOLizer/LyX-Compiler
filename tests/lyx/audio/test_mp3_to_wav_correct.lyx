// Test: MP3 to WAV with correct sample rate
import std.audio;
import std.audio.mpg123;
import std.alloc;

pub fn main(): int64 {
  Print("=== MP3 to WAV (Correct Format) ===\n");
  
  var mp3Path: pchar := "/home/andreas/PhpstormProjects/aurum/music_test.mp3";
  var wavPath: pchar := "/tmp/correct_output.wav";
  
  // Step 1: Initialize MP3 decoder
  mpg123_init();
  var handle: int64;
  handle := mpg123_new(0, 0);
  
  // Open MP3 without fixed format
  var res: int64;
  res := mpg123_open(handle, mp3Path);
  
  if (res != MPG123_OK) {
    Print("ERROR: Cannot open MP3\n");
    mpg123_exit();
    return 1;
  }
  
  // Query actual format
  var ratePtr: int64;
  var chanPtr: int64;
  var encPtr: int64;
  ratePtr := alloc(8);
  chanPtr := alloc(8);
  encPtr := alloc(8);
  
  res := mpg123_getformat(handle, ratePtr, chanPtr, encPtr);
  
  var sampleRate: int64;
  sampleRate := peek64(ratePtr);
  var channels: int64;
  channels := peek64(chanPtr);
  var encoding: int64;
  encoding := peek64(encPtr);
  
  Print("MP3 Format:\n");
  Print("  Sample Rate: ");
  PrintInt(sampleRate);
  Print(" Hz\n");
  Print("  Channels: ");
  PrintInt(channels);
  Print("\n");
  Print("  Encoding: ");
  PrintInt(encoding);
  Print("\n");
  
  free(ratePtr, 8);
  free(chanPtr, 8);
  free(encPtr, 8);
  
  // Now re-open with fixed format to decode
  mpg123_close(handle);
  res := mpg123_open_fixed(handle, mp3Path, channels, MPG123_ENC_SIGNED_16);
  
  if (res != MPG123_OK) {
    Print("ERROR: Cannot open with fixed format\n");
    mpg123_delete(handle);
    mpg123_exit();
    return 1;
  }
  
  // Allocate buffer and decode
  var buf: int64;
  buf := alloc(10485760);
  var done: int64;
  done := alloc(8);
  
  var total: int64;
  total := 0;
  
  while (total < 10485760) {
    res := mpg123_read(handle, buf + total, 16384, done);
    
    if (res == MPG123_DONE) {
      break;
    }
    if (res < 0 and res != MPG123_NEW_FORMAT) {
      Print("Decode error: ");
      PrintInt(res);
      Print("\n");
      free(buf, 10485760);
      free(done, 8);
      mpg123_close(handle);
      mpg123_delete(handle);
      mpg123_exit();
      return 1;
    }
    
    var bytesRead: int64;
    bytesRead := peek64(done);
    if (bytesRead > 0) {
      total := total + bytesRead;
    }
  }

  Print("Decoded ");
  PrintInt(total);
  Print(" bytes\n");
  
  // Save as WAV with CORRECT sample rate
  var bitsPerSample: int64;
  bitsPerSample := 16;
  
  // Determine bytes per sample
  if (encoding == 4) {
    bitsPerSample := 16;
  } else if (encoding == 1) {
    bitsPerSample := 8;
  }
  
  res := WAVSaveFile(wavPath, buf, total, sampleRate, channels, bitsPerSample);
  
  free(buf, 10485760);
  free(done, 8);
  mpg123_close(handle);
  mpg123_delete(handle);
  mpg123_exit();
  
  if (res != 0) {
    Print("ERROR: Cannot save WAV\n");
    return 1;
  }
  
  Print("WAV saved: ");
  Print(wavPath);
  Print("\n");
  
  // Verify the file
  var fd: int64;
  fd := open(wavPath, 0, 0);
  if (fd >= 0) {
    lseek(fd, 22, SEEK_SET);
    var rate: int32;
    rate := peek8(fd) | (peek8(fd+1) << 8) | (peek8(fd+2) << 16) | (peek8(fd+3) << 24);
    lseek(fd, 34, SEEK_SET);
    var bits: int8;
    bits := peek8(fd);
    lseek(fd, 36, SEEK_SET);
    var ch: int8;
    ch := peek8(fd);
    
    Print("WAV Header:\n");
    Print("  Sample Rate: ");
    PrintInt(rate);
    Print(" Hz\n");
    Print("  Bits: ");
    PrintInt(bits);
    Print("\n");
    Print("  Channels: ");
    PrintInt(ch);
    Print("\n");
    
    close(fd);
  }
  
  Print("=== Done ===\n");
  return 0;
}
