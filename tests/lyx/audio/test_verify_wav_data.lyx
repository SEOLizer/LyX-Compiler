// Test: Verify WAV data is correct in memory
import std.audio;
import std.alloc;

pub fn main(): int64 {
  var wavPath: pchar := "/tmp/playback_30s.wav";
  Print("=== Verify WAV data ===\n");

  // Read first 100 bytes of PCM data
  var fd: int64;
  fd := open(wavPath, 0, 0);
  if (fd < 0) {
    Print("ERROR: Cannot open file\n");
    return 1;
  }

  // Skip header
  lseek(fd, 44, SEEK_SET);
  
  var buf: int64;
  buf := alloc(100);
  var bytesRead: int64;
  bytesRead := sys_read(fd, buf, 100);
  close(fd);
  
  Print("Read "); PrintInt(bytesRead); Print(" bytes from data section\n");
  
  // Check first 16 samples (first few frames)
  Print("First 8 samples (L R L R format):\n");
  var i: int64 := 0;
  while (i < 16) {
    var sample: int64;
    sample := peek8(buf + i) | (peek8(buf + i + 1) << 8);
    // Convert to signed
    if (sample >= 32768) {
      sample := sample - 65536;
    }
    PrintInt(sample); Print(" ");
    i := i + 2;
    if (i % 4 == 0) {
      Print(" | ");
    }
  }
  Print("\n");
  
  // Check last bytes before EOF
  var offset: int64 := 44 + 192000;
  offset := offset - 16;
  Print("Last 16 bytes of 1 second chunk (offset "); PrintInt(offset); Print("):\n");
  var lastPtr: int64;
  lastPtr := alloc(16);
  fd := open(wavPath, 0, 0);
  lseek(fd, offset, SEEK_SET);
  sys_read(fd, lastPtr, 16);
  close(fd);
  
  i := 0;
  while (i < 16) {
    var b: int64 := peek8(lastPtr + i);
    PrintInt(b); Print(" ");
    i := i + 1;
  }
  Print("\n");
  
  free(buf, 100);
  free(lastPtr, 16);
  
  Print("=== Done ===\n");
  return 0;
}