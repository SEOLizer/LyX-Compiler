// Test WAV Decoder
import std.audio;

pub fn main(): int64 {
  var info: AudioInfo;
  var result: int64;
  var data: int64;
  
  // Parse WAV
  result := WAVParse("/home/andreas/PhpstormProjects/aurum/test.wav", info);
  
  if (result == AUDIO_OK) {
    Print("Parse OK!\n");
    Print("Sample Rate: ");
    PrintInt(info.sampleRate);
    Print(" Hz\n");
    Print("Channels: ");
    PrintInt(info.channels);
    Print("\n");
    Print("Bits/Sample: ");
    PrintInt(info.bitsPerSample);
    Print("\n");
    Print("Data Offset: ");
    PrintInt(info.dataOffset);
    Print("\n");
    Print("Data Size: ");
    PrintInt(info.dataSize);
    Print(" bytes\n");
    
    // Read audio data
    data := WAVReadData("/home/andreas/PhpstormProjects/aurum/test.wav", info);
    
    if (data != 0) {
      Print("\nAudio data loaded!\n");
      Print("First 8 bytes: ");
      PrintInt(peek8(data + 0));
      Print(" ");
      PrintInt(peek8(data + 1));
      Print(" ");
      PrintInt(peek8(data + 2));
      Print(" ");
      PrintInt(peek8(data + 3));
      Print(" ");
      PrintInt(peek8(data + 4));
      Print(" ");
      PrintInt(peek8(data + 5));
      Print(" ");
      PrintInt(peek8(data + 6));
      Print(" ");
      PrintInt(peek8(data + 7));
      Print("\n");
      
      munmap(data, info.dataSize);
    } else {
      Print("Failed to load audio data\n");
    }
  } else {
    Print("Parse failed: ");
    PrintInt(result);
    Print("\n");
  }
  
  return 0;
}