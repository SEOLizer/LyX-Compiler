// Test: ALSA set format debug - try prepare first
import std.audio;
import std.audio.alsa;
import std.alloc;

pub fn main(): int64 {
  Print("=== ALSA Format Debug v2 ===\n");
  
  // Step 1: Open ALSA
  var handle: int64;
  handle := ALSAAudioOpen();
  
  if (handle == 0) {
    Print("ERROR: Cannot open ALSA\n");
    return 1;
  }
  
  Print("Handle: ");
  PrintInt(handle);
  Print("\n");
  
  // Try prepare first
  var result: int64;
  result := snd_pcm_prepare(handle);
  Print("prepare result: ");
  PrintInt(result);
  Print("\n");
  
  // Step 2: Try to set format with debug
  Print("Setting format...\n");
  
  var paramsPtr: int64;
  paramsPtr := alloc(8);
  
  if (paramsPtr == 0) {
    ALSAClose(handle);
    Print("ERROR: mmap failed\n");
    return 1;
  }
  
  result := snd_pcm_hw_params_malloc(paramsPtr);
  Print("malloc result: ");
  PrintInt(result);
  Print("\n");
  
  if (result != ALSA_OK) {
    ALSAClose(handle);
    free(paramsPtr, 8);
    Print("ERROR: malloc failed\n");
    return 1;
  }
  
  var params: int64;
  params := peek64(paramsPtr);
  Print("params: ");
  PrintInt(params);
  Print("\n");
  
  // Initialize
  result := snd_pcm_hw_params_any(handle, params);
  Print("hw_params_any result: ");
  PrintInt(result);
  Print("\n");
  
  // Try simpler operations
  if (result == ALSA_OK) {
    // Set access
    result := snd_pcm_hw_params_set_access(handle, params, SND_PCM_ACCESS_RW_INTERLEAVED);
    Print("set_access result: ");
    PrintInt(result);
    Print("\n");
  }
  
  snd_pcm_hw_params_free(params);
  free(paramsPtr, 8);
  ALSAClose(handle);
  
  Print("=== Done ===\n");
  return 0;
}
