// Test WAVParse
import std.audio;

pub fn main(): int64 {
  var info: AudioInfo;
  var r: int64;
  
  r := WAVParse("/home/andreas/PhpstormProjects/aurum/test.wav", info);
  
  if (r == AUDIO_OK) {
    Print("WAV OK!\n");
    Print("Rate: ");
    PrintInt(info.sampleRate);
    Print(" Hz\n");
    Print("Channels: ");
    PrintInt(info.channels);
    Print("\n");
    Print("Bits: ");
    PrintInt(info.bitsPerSample);
    Print("\n");
    Print("Duration: ");
    PrintInt(info.durationMs);
    Print(" ms\n");
  } else {
    Print("Failed: ");
    PrintInt(r);
    Print("\n");
  }
  
  return 0;
}