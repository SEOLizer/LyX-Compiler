// Test: Check drain timing explicitly
import std.audio;
import std.audio.alsa;
import std.alloc;

pub fn main(): int64 {
  Print("=== Drain timing test ===\n");
  
  var sampleRate: int64 := 48000;
  var bytesPerFrame: int64 := 4;
  var oneSec: int64 := sampleRate * bytesPerFrame;
  
  var buf: int64;
  buf := alloc(oneSec);
  
  // Fill with silence
  var i: int64 := 0;
  while (i < oneSec) {
    poke8(buf + i, 0);
    i := i + 1;
  }
  
  // Open ALSA
  var hp: int64;
  hp := alloc(8);
  var res: int64;
  res := snd_pcm_open(hp, "hw:0", 0, 0);
  
  if (res != 0) { return 1; }
  
  var handle: int64;
  handle := peek64(hp);
  free(hp, 8);
  
  var pp: int64;
  pp := alloc(8);
  snd_pcm_hw_params_malloc(pp);
  var params: int64;
  params := peek64(pp);
  
  snd_pcm_hw_params_any(handle, params);
  snd_pcm_hw_params_set_access(handle, params, 3);
  snd_pcm_hw_params_set_format(handle, params, 2);
  
  var ratePtr: int64;
  ratePtr := alloc(8);
  poke32(ratePtr, sampleRate);
  snd_pcm_hw_params_set_rate_near(handle, params, ratePtr, 0);
  var actualRate: int64;
  actualRate := peek32(ratePtr);
  free(ratePtr, 8);
  
  snd_pcm_hw_params_set_channels(handle, params, 2);
  res := snd_pcm_hw_params(handle, params);
  
  if (res != 0) { return 1; }
  
  snd_pcm_hw_params_free(params);
  free(pp, 8);
  
  Print("Rate: "); PrintInt(actualRate); Print(" Hz\n");
  
  Print("Writing 48000 frames...\n");
  res := snd_pcm_writei(handle, buf, sampleRate);
  Print("Write done: "); PrintInt(res); Print("\n");
  
  Print("Calling drain NOW - please wait...\n");
  snd_pcm_drain(handle);
  Print("Drain DONE!\n");
  
  snd_pcm_close(handle);
  free(buf, oneSec);
  
  Print("=== Done ===\n");
  return 0;
}