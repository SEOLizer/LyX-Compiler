// Simple 1-second 440Hz sine wave test
import std.audio;
import std.audio.alsa;
import std.alloc;

pub fn main(): int64 {
  Print("=== Simple 440Hz test ===\n");
  
  var sampleRate: int64 := 48000;
  var bytesPerFrame: int64 := 4;
  var oneSec: int64 := sampleRate * bytesPerFrame;
  
  var buf: int64;
  buf := alloc(oneSec);
  
  // Generate 440Hz sine wave
  var i: int64 := 0;
  while (i < sampleRate) {
    var phase: int64 := (i * 440 * 6283) / sampleRate;
    phase := phase % 6284;
    
    // Simple sin approximation
    var val: int64;
    if (phase < 3142) {
      val := (phase * 32768) / 3142 - 32768;
    } else {
      val := ((6284 - phase) * 32768) / 3142 - 32768;
    }
    
    val := (val * 20000) / 32768;
    
    var offset: int64 := i * 4;
    var s: int64 := val;
    if (s < 0) { s := s + 65536; }
    
    poke8(buf + offset, s & 255);
    poke8(buf + offset + 1, (s >> 8) & 255);
    poke8(buf + offset + 2, s & 255);
    poke8(buf + offset + 3, (s >> 8) & 255);
    
    i := i + 1;
  }
  
// Open ALSA
   var alsaHandleStorage: int64;
   var res: int64;
   res := snd_pcm_open(@alsaHandleStorage, "hw:0", 0, 0);
   
   if (res != 0) {
     Print("Open failed: "); PrintInt(res); Print("\n");
     return 1;
   }
   
   var alsaHandle: int64;
   alsaHandle := peek64(@alsaHandleStorage);
  
  var pp: int64;
  pp := alloc(8);
  snd_pcm_hw_params_malloc(pp);
  var params: int64;
  params := peek64(pp);
  
  snd_pcm_hw_params_any(alsaHandle, params);
  snd_pcm_hw_params_set_access(alsaHandle, params, 3);
  snd_pcm_hw_params_set_format(alsaHandle, params, 2);
  
  var ratePtr: int64;
  ratePtr := alloc(8);
  poke32(ratePtr, sampleRate);
  snd_pcm_hw_params_set_rate_near(alsaHandle, params, ratePtr, 0);
  var actualRate: int64;
  actualRate := peek32(ratePtr);
  free(ratePtr, 8);
  
  snd_pcm_hw_params_set_channels(alsaHandle, params, 2);
  res := snd_pcm_hw_params(alsaHandle, params);
  
  if (res != 0) {
    Print("Params failed: "); PrintInt(res); Print("\n");
    return 1;
  }
  
  snd_pcm_hw_params_free(params);
  free(pp, 8);
  
  Print("Playing 1 second 440Hz tone...\n");
  Print("(This should take ~1 second to complete...)\n");
  res := snd_pcm_writei(alsaHandle, buf, sampleRate);
  Print("Written: "); PrintInt(res); Print("\n");
  
  Print("Now draining (should wait for playback)...\n");
  snd_pcm_drain(alsaHandle);
  Print("Drain done\n");
  snd_pcm_close(alsaHandle);
  free(buf, oneSec);
  
  Print("=== Done ===\n");
  return 0;
}