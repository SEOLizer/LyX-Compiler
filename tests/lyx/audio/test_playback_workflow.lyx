// Test: Complete MP3 to WAV to Playback workflow
import std.audio;
import std.audio.mpg123;
import std.alloc;

pub fn main(): int64 {
  Print("=== MP3 Decode & Playback Test ===\n");
  
  var mp3Path: pchar := "/home/andreas/PhpstormProjects/aurum/music_test.mp3";
  var wavPath: pchar := "/tmp/playback_test.wav";
  
  // Step 1: Decode MP3 to WAV
  Print("1. Decoding MP3 to WAV...\n");
  
  mpg123_init();
  var handle: int64;
  handle := mpg123_new(0, 0);
  
  if (handle == 0) {
    Print("ERROR: Failed to create mpg123 handle\n");
    mpg123_exit();
    return 1;
  }
  
  var res: int64;
  res := mpg123_open_fixed(handle, mp3Path, 2, 4);
  
  if (res != MPG123_OK) {
    Print("ERROR: Failed to open MP3\n");
    mpg123_delete(handle);
    mpg123_exit();
    return 1;
  }
  
  // Allocate buffer
  var buf: int64;
  buf := alloc(10485760);
  var done: int64;
  done := alloc(8);
  
  var total: int64;
  total := 0;
  
  while (total < 10485760) {
    res := mpg123_read(handle, buf + total, 16384, done);
    
    if (res == MPG123_DONE) {
      break;
    }
    if (res < 0 and res != MPG123_NEW_FORMAT) {
      Print("Decode error: ");
      PrintInt(res);
      Print("\n");
      free(buf, 10485760);
      free(done, 8);
      mpg123_close(handle);
      mpg123_delete(handle);
      mpg123_exit();
      return 1;
    }
    
    total := total + 4096;
  }
  
  Print("Decoded ");
  PrintInt(total);
  Print(" bytes\n");
  
  // Save as WAV
  res := WAVSaveFile(wavPath, buf, total, 44100, 2, 16);
  
  free(buf, 10485760);
  free(done, 8);
  mpg123_close(handle);
  mpg123_delete(handle);
  mpg123_exit();
  
  if (res != 0) {
    Print("ERROR: Failed to save WAV\n");
    return 1;
  }
  
  Print("2. WAV file created: ");
  Print(wavPath);
  Print("\n");
  
  // Step 2: Playback info
  Print("3. File info:\n");
  var fd: int64;
  fd := open(wavPath, 0, 0);
  if (fd >= 0) {
    var fsize: int64;
    fsize := lseek(fd, 0, SEEK_END);
    close(fd);
    Print("   Size: ");
    PrintInt(fsize);
    Print(" bytes\n");
    Print("   Format: 16-bit stereo 44100 Hz PCM\n");
  }
  
  Print("\n=== To play, run: ===\n");
  Print("  aplay ");
  Print(wavPath);
  Print("\n");
  Print("  # or\n");
  Print("  paplay ");
  Print(wavPath);
  Print("\n");
  
  Print("=== Done ===\n");
  return 0;
}
