// Test: Detailed ALSA error debugging
import std.audio;
import std.audio.alsa;
import std.alloc;

pub fn main(): int64 {
  Print("=== ALSA Detailed Debug ===\n");
  
  // Open ALSA device
  var handle: int64;
  handle := ALSAAudioOpen();
  
  if (handle == 0) {
    Print("ERROR: Cannot open ALSA\n");
    return 1;
  }
  
  Print("Handle: ");
  PrintInt(handle);
  Print("\n");
  
  // Now try setting params
  var paramsPtr: int64;
  paramsPtr := alloc(8);
  
  if (paramsPtr == 0) {
    ALSAClose(handle);
    Print("ERROR: mmap failed\n");
    return 1;
  }
  
  var result: int64;
  result := snd_pcm_hw_params_malloc(paramsPtr);
  Print("malloc: ");
  PrintInt(result);
  if (result != 0) { Print(" ERROR"); }
  Print("\n");
  
  if (result != ALSA_OK) {
    ALSAClose(handle);
    free(paramsPtr, 8);
    return 1;
  }
  
  var params: int64;
  params := peek64(paramsPtr);
  Print("params ptr: ");
  PrintInt(params);
  Print("\n");
  
  // Step 1: hw_params_any
  result := snd_pcm_hw_params_any(handle, params);
  Print("hw_params_any: ");
  PrintInt(result);
  if (result < 0) { Print(" (negative)"); }
  Print("\n");
  
  if (result < 0) {
    // Print more info
    Print("Error code: ");
    PrintInt(result);
    Print("\n");
    // Try with no params
    snd_pcm_hw_params_free(params);
    free(paramsPtr, 8);
    ALSAClose(handle);
    Print("FAILED at hw_params_any\n");
    return 1;
  }
  
  // Step 2: set access
  result := snd_pcm_hw_params_set_access(handle, params, SND_PCM_ACCESS_RW_INTERLEAVED);
  Print("set_access: ");
  PrintInt(result);
  if (result < 0) { Print(" (ERROR)"); }
  Print("\n");
  
  if (result < 0) {
    snd_pcm_hw_params_free(params);
    free(paramsPtr, 8);
    ALSAClose(handle);
    Print("FAILED at set_access\n");
    return 1;
  }
  
  // Step 3: set format
  result := snd_pcm_hw_params_set_format(handle, params, SND_PCM_FORMAT_S16_LE);
  Print("set_format: ");
  PrintInt(result);
  if (result < 0) { Print(" (ERROR)"); }
  Print("\n");
  
  if (result < 0) {
    snd_pcm_hw_params_free(params);
    free(paramsPtr, 8);
    ALSAClose(handle);
    Print("FAILED at set_format\n");
    return 1;
  }
  
  // Step 4: set rate
  result := snd_pcm_hw_params_set_rate_near(handle, params, 44100, 0);
  Print("set_rate: ");
  PrintInt(result);
  if (result < 0) { Print(" (ERROR)"); }
  Print("\n");
  
  if (result < 0) {
    snd_pcm_hw_params_free(params);
    free(paramsPtr, 8);
    ALSAClose(handle);
    Print("FAILED at set_rate\n");
    return 1;
  }
  
  // Step 5: set channels
  result := snd_pcm_hw_params_set_channels(handle, params, 2);
  Print("set_channels: ");
  PrintInt(result);
  if (result < 0) { Print(" (ERROR)"); }
  Print("\n");
  
  if (result < 0) {
    snd_pcm_hw_params_free(params);
    free(paramsPtr, 8);
    ALSAClose(handle);
    Print("FAILED at set_channels\n");
    return 1;
  }
  
  // Step 6: Apply params
  Print("Applying hw_params...\n");
  result := snd_pcm_hw_params(handle, params);
  Print("hw_params: ");
  PrintInt(result);
  if (result < 0) { Print(" (ERROR)"); }
  Print("\n");
  
  if (result < 0) {
    Print("Error applying params: ");
    PrintInt(result);
    Print("\n");
  }
  
  // Cleanup
  snd_pcm_hw_params_free(params);
  free(paramsPtr, 8);
  ALSAClose(handle);
  
  Print("=== Done ===\n");
  return 0;
}
