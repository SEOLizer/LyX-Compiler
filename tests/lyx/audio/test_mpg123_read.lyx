// Test MP3 decoder using libmpg123
import std.audio;
import std.audio.mpg123;
import std.alloc;

pub fn main(): int64 {
  Print("=== MP3 Decoder Test ===\n");
  
  // Initialize
  mpg123_init();
  var handle: int64;
  handle := mpg123_new(0, 0);
  
  if (handle == 0) {
    Print("ERROR: Failed to create mpg123 handle\n");
    mpg123_exit();
    return 1;
  }
  
  // Open MP3 file
  var res: int64;
  res := mpg123_open_fixed(handle, "/home/andreas/PhpstormProjects/aurum/music_test.mp3", 2, 4);
  
  if (res != MPG123_OK) {
    Print("ERROR: Failed to open MP3 file\n");
    mpg123_delete(handle);
    mpg123_exit();
    return 1;
  }
  Print("MP3 file opened successfully\n");
  
  // Allocate buffers
  var buf: int64;
  buf := alloc(16384);
  var done: int64;
  done := alloc(8);
  
  // Decode loop
  var totalBytes: int64;
  totalBytes := 0;
  
  var iterations: int64;
  iterations := 0;
  
  while (iterations < 500) {
    res := mpg123_read(handle, buf, 16384, done);
    
    if (res == MPG123_DONE) {
      Print("Decoding complete at iteration ");
      PrintInt(iterations);
      Print("\n");
      iterations := 1000;  // break
    } else if (res < 0 and res != MPG123_NEW_FORMAT) {
      Print("Error at iteration ");
      PrintInt(iterations);
      Print(": ");
      PrintInt(res);
      Print("\n");
      iterations := 1000;  // break
    }
    
    // Assume some bytes decoded on MPG123_OK
    if (res == MPG123_OK or res == 0) {
      totalBytes := totalBytes + 4096;
    }
    
    iterations := iterations + 1;
  }
  
  Print("Total bytes decoded: ");
  PrintInt(totalBytes);
  Print("\n");
  
  // Cleanup
  free(buf, 16384);
  free(done, 8);
  mpg123_close(handle);
  mpg123_delete(handle);
  mpg123_exit();
  
  Print("=== Test Complete ===\n");
  return 0;
}
