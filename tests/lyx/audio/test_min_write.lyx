// Test: Minimal file write
import std.audio;
import std.alloc;

pub fn main(): int64 {
  Print("=== Minimal Write Test ===\n");
  
  // Open file
  var fd: int64;
  fd := open("/tmp/minimal_test.bin", O_WRONLY | O_CREAT | O_TRUNC, 420);
  
  Print("fd = ");
  PrintInt(fd);
  Print("\n");
  
  if (fd < 0) {
    Print("open failed\n");
    return 1;
  }
  
  // Write simple byte
  var buf: int64;
  buf := alloc(10);
  
  poke8(buf, 65);  // 'A'
  poke8(buf + 1, 66);  // 'B'
  poke8(buf + 2, 67);  // 'C'
  
  var written: int64;
  written := write(fd, buf, 3);
  
  Print("written = ");
  PrintInt(written);
  Print("\n");
  
  close(fd);
  free(buf, 10);
  
  Print("=== Done ===\n");
  return 0;
}
