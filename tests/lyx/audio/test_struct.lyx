// Test AudioInfo struct field access
import std.audio;

pub fn main(): int64 {
  var info: AudioInfo;
  
  // Test direct assignment
  info.format := 100;
  info.sampleRate := 200;
  info.channels := 300;
  info.bitsPerSample := 400;
  info.dataOffset := 500;
  info.dataSize := 600;
  info.durationMs := 700;
  
  Print("After assignment:\n");
  Print("format: ");
  PrintInt(info.format);
  Print("\n");
  Print("sampleRate: ");
  PrintInt(info.sampleRate);
  Print("\n");
  Print("channels: ");
  PrintInt(info.channels);
  Print("\n");
  Print("bitsPerSample: ");
  PrintInt(info.bitsPerSample);
  Print("\n");
  Print("dataOffset: ");
  PrintInt(info.dataOffset);
  Print("\n");
  Print("dataSize: ");
  PrintInt(info.dataSize);
  Print("\n");
  Print("durationMs: ");
  PrintInt(info.durationMs);
  Print("\n");
  
  return 0;
}
