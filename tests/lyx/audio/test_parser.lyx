// Test program for audio parser
import std.audio;

pub fn main(): int64 {
  var info: AudioInfo;
  var result: int64;
  var path: pchar;
  
  path := "/home/andreas/PhpstormProjects/aurum/music_test.mp3";
  
  result := MP3Parse(path, info);
  
  if (result == AUDIO_OK) {
    Print("Success!\n");
    Print("Format: ");
    PrintInt(info.format);
    Print("\n");
    Print("Sample Rate: ");
    PrintInt(info.sampleRate);
    Print(" Hz\n");
    Print("Channels: ");
    PrintInt(info.channels);
    Print("\n");
    Print("Duration: ");
    PrintInt(info.durationMs);
    Print(" ms\n");
  } else {
    Print("Failed: ");
    PrintInt(result);
    Print("\n");
  }
  
  return 0;
}