// Test: WAV header write only (no MP3 decoding)
import std.audio;
import std.alloc;

pub fn main(): int64 {
  Print("=== WAV Header Test ===\n");
  
  // Create a test buffer
  var buf: int64;
  buf := alloc(4096);
  Print("Buffer: ");
  PrintInt(buf);
  Print("\n");
  
  // Write header to buffer
  var headerSize: int64;
  headerSize := WAVWriteHeader(buf, 1000, 44100, 2, 16);
  
  Print("Header size: ");
  PrintInt(headerSize);
  Print("\n");
  
  Print("Calling WAVSaveFile...\n");
  
  // Try to save to file
  var result: int64;
  result := WAVSaveFile("/tmp/test_header.wav", buf + 44, 1000, 44100, 2, 16);
  
  Print("Save result: ");
  PrintInt(result);
  Print("\n");
  
  if (result == 0) {
    Print("SUCCESS!\n");
  }
  
  free(buf, 4096);
  
  Print("=== Done ===\n");
  return 0;
}
