// Test: Check actual MP3 format
import std.audio;
import std.audio.mpg123;
import std.alloc;

pub fn main(): int64 {
  Print("=== MP3 Format Check ===\n");
  
  mpg123_init();
  var handle: int64;
  handle := mpg123_new(0, 0);
  
  // Open WITHOUT fixed format first
  var res: int64;
  res := mpg123_open(handle, "/home/andreas/PhpstormProjects/aurum/music_test.mp3");
  
  Print("Open result: ");
  PrintInt(res);
  Print("\n");
  
  // Allocate pointers for format query
  var ratePtr: int64;
  var chanPtr: int64;
  var encPtr: int64;
  ratePtr := alloc(8);
  chanPtr := alloc(8);
  encPtr := alloc(8);
  
  // Query format
  res := mpg123_getformat(handle, ratePtr, chanPtr, encPtr);
  
  Print("GetFormat result: ");
  PrintInt(res);
  Print("\n");
  
  if (res == MPG123_OK or res == MPG123_NEW_FORMAT) {
    var rate: int64;
    rate := peek64(ratePtr);
    var channels: int64;
    channels := peek64(chanPtr);
    var encoding: int64;
    encoding := peek64(encPtr);
    
    Print("Sample Rate: ");
    PrintInt(rate);
    Print(" Hz\n");
    
    Print("Channels: ");
    PrintInt(channels);
    Print("\n");
    
    Print("Encoding: ");
    PrintInt(encoding);
    Print("\n");
    
    // Check what encoding value means
    if (encoding == 4) {
      Print("Encoding = 4 = SIGNED_16\n");
    } else if (encoding == 1) {
      Print("Encoding = 1 = UNSIGNED_8\n");
    } else if (encoding == 2) {
      Print("Encoding = 2 = SIGNED_8\n");
    }
  }
  
  free(ratePtr, 8);
  free(chanPtr, 8);
  free(encPtr, 8);
  
  mpg123_close(handle);
  mpg123_delete(handle);
  mpg123_exit();
  
  Print("=== Done ===\n");
  return 0;
}
