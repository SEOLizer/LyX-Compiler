// Test MP3 Parser
import std.audio;

pub fn main(): int64 {
  var info: AudioInfo;
  var result: int64;
  
  result := MP3Parse("/home/andreas/PhpstormProjects/aurum/music_test.mp3", info);
  
  if (result == AUDIO_OK) {
    Print("MP3 Parse OK!\n");
    Print("Format: ");
    PrintInt(info.format);
    Print("\n");
    Print("Sample Rate: ");
    PrintInt(info.sampleRate);
    Print(" Hz\n");
    Print("Channels: ");
    PrintInt(info.channels);
    Print("\n");
    Print("Bits: ");
    PrintInt(info.bitsPerSample);
    Print("\n");
    Print("Data Offset: ");
    PrintInt(info.dataOffset);
    Print("\n");
    Print("Data Size: ");
    PrintInt(info.dataSize);
    Print(" bytes\n");
    Print("Duration: ");
    PrintInt(info.durationMs);
    Print(" ms\n");
  } else {
    Print("MP3 Parse failed: ");
    PrintInt(result);
    Print("\n");
  }
  
  return 0;
}