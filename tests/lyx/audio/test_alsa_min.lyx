// Test: Minimal ALSA open
import std.audio;
import std.audio.alsa;

pub fn main(): int64 {
  Print("=== Minimal ALSA Test ===\n");
  
  var handlePtr: int64;
  handlePtr := mmap(0, 8, 3, 34, -1, 0);
  
  Print("handlePtr = ");
  PrintInt(handlePtr);
  Print("\n");
  
  if (handlePtr == 0) {
    Print("ERROR: mmap failed\n");
    return 1;
  }
  
  Print("Calling snd_pcm_open...\n");
  
  var result: int64;
  result := snd_pcm_open(handlePtr, "default", SND_PCM_STREAM_PLAYBACK, 0);
  
  Print("result = ");
  PrintInt(result);
  Print("\n");
  
  if (result != ALSA_OK) {
    Print("ERROR: open failed\n");
    munmap(handlePtr, 8);
    return 1;
  }
  
  Print("Success!\n");
  
  var handle: int64;
  handle := peek64(handlePtr);
  Print("handle = ");
  PrintInt(handle);
  Print("\n");
  
  // Try to close
  if (handle != 0) {
    snd_pcm_close(handle);
  }
  
  munmap(handlePtr, 8);
  
  Print("=== Done ===\n");
  return 0;
}
