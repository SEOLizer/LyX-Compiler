// #2199: von `parallel Array<int64>` auf f32 umgestellt. Die Ganzzahlform
// rechnete still falsch (4-Byte-Schrittweite, und `a + b` lief als addps,
// also Gleitkomma auf dem Bitmuster) und wird jetzt in sema abgewiesen.
// Dieser Fall prueft ohnehin nur, DASS uebersetzt wird — den Wert prueft
// tests/simd_elembreite_test.sh.
fn addVectors(a: parallel Array<f32>, b: parallel Array<f32>): parallel Array<f32> {
  return a + b;
}

fn main(): int64 {
  let x: parallel Array<f32>(4) = parallel Array<f32>(4);
  let y: parallel Array<f32>(4) = parallel Array<f32>(4);
  let z: parallel Array<f32> = addVectors(x, y);
  return 0;
}
