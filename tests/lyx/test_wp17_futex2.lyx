// WP-17: Test fuer futex2 -- sys_futex_wait/wake/waitv/requeue
import std.thread;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-17: futex2 -- neue Synchronisierungs-API ===");

  var flags32: int64 := FUTEX2_SIZE_U32 | FUTEX2_PRIVATE;

  // Futex-Variable: 4-Byte-Int im mmap-Speicher (uint32, ausgerichtet)
  var futex: int64 := mmap(0, 4096, 3, 34, -1, 0);
  poke32(futex, 42);

  // ============================================================
  // --- Test 1: Futex2Wake ohne Wartende -- gibt 0 zurueck ---
  // ============================================================
  var wr: int64 := Futex2Wake(futex, 1, flags32);
  if (wr != 0) {
    Print("FAIL: Futex2Wake(no waiters)="); PrintLn(wr); return 1;
  }
  PrintLn("OK: Futex2Wake(keine Wartenden) = 0");

  // ============================================================
  // --- Test 2: Futex2Wait mit falschem Wert -- sofort -EAGAIN ---
  // Der Kernel prueft: *futex == val? Wenn nein -> EAGAIN
  // ============================================================
  var wr2: int64 := Futex2Wait(futex, 99, flags32);
  // Erwartet: -11 (EAGAIN) -- Wert stimmt nicht ueberein
  if (wr2 != -11) {
    Print("FAIL: Futex2Wait(mismatch) expected -11, got="); PrintLn(wr2); return 1;
  }
  PrintLn("OK: Futex2Wait(mismatch) = -EAGAIN");

  // ============================================================
  // --- Test 3: Futex2WakeAll ohne Wartende ---
  // ============================================================
  var wa: int64 := Futex2WakeAll(futex, flags32);
  if (wa != 0) {
    Print("FAIL: Futex2WakeAll="); PrintLn(wa); return 1;
  }
  PrintLn("OK: Futex2WakeAll(keine Wartenden) = 0");

  // ============================================================
  // --- Test 4: Futex2WaitV -- simultan auf 2 Futexe warten ---
  // Beide Futexe haben andere Werte als erwartet -> sofort -EAGAIN
  // ============================================================
  var futex2: int64 := futex + 8;
  poke32(futex2, 77);

  var waiters: int64 := mmap(0, FUTEX_WAITV_SIZE * 2, 3, 34, -1, 0);
  Futex2WaitVEntry(waiters,                    futex,  99, flags32);
  Futex2WaitVEntry(waiters + FUTEX_WAITV_SIZE, futex2, 11, flags32);

  var vr: int64 := Futex2WaitV(waiters, 2);
  // Erwartet: >= 0 (Index des sofort nicht-wartenden Futex) oder -11 (EAGAIN)
  if (vr >= 0) {
    Print("OK: Futex2WaitV -- sofort zurueck, Index="); PrintLn(vr);
  } else {
    if (vr == -11) {
      PrintLn("OK: Futex2WaitV -- EAGAIN (alle Werte ungleich erwartet)");
    } else {
      Print("FAIL: Futex2WaitV="); PrintLn(vr);
      munmap(waiters, FUTEX_WAITV_SIZE * 2); munmap(futex, 4096); return 1;
    }
  }
  munmap(waiters, FUTEX_WAITV_SIZE * 2);

  // ============================================================
  // --- Test 5: Futex2Requeue -- Verschiebetest ohne Wartende ---
  // nrWake=0, nrRequeue=0 -> sofort 0 (nichts zu tun)
  // ============================================================
  // cmpVal muss dem aktuellen Wert an futex entsprechen (= 42)
  var cmpVal: int64 := peek32(futex);
  var rr: int64 := Futex2Requeue(futex, futex2, flags32, cmpVal, 0, 0);
  if (rr < 0) {
    Print("FAIL: Futex2Requeue="); PrintLn(rr);
    munmap(futex, 4096); return 1;
  }
  Print("OK: Futex2Requeue(keine Wartenden, cmpVal="); Print(cmpVal); Print(") = "); PrintLn(rr);

  munmap(futex, 4096);

  PrintLn("=== WP-17: alle Tests bestanden ===");
  return 0;
}
