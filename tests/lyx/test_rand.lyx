// Test: std/crypto/rand -- WP-BL-01 getrandom-Syscall
import std.crypto.rand;

pub fn main(argc: int64, argv: pchar): int64 {
    PrintLn("=== crypto/rand Tests (WP-BL-01) ===");

    // ----------------------------------------------------------------
    // Test 1: RandBytes schreibt len Bytes
    // ----------------------------------------------------------------
    var buf: int64 := mmap(0, 64, 3, 34, -1, 0);
    var i: int64 := 0;
    while (i < 64) { poke8(buf + i, 0); i := i + 1; }

    var rc: int64 := RandBytes(buf, 32);
    if (rc == 32) {
        PrintLn("OK: RandBytes(32) == 32");
    } else {
        Print("FAIL: RandBytes returned "); PrintLn(rc); return 1;
    }

    // ----------------------------------------------------------------
    // Test 2: Ausgabe ist nicht all-zero (statistische Plausibilität)
    // ----------------------------------------------------------------
    var nonzero: int64 := 0;
    i := 0;
    while (i < 32) {
        if (peek8(buf + i) != 0) { nonzero := nonzero + 1; }
        i := i + 1;
    }
    if (nonzero > 0) {
        PrintLn("OK: RandBytes-Ausgabe nicht all-zero");
    } else {
        PrintLn("FAIL: alle 32 Bytes sind 0 (extrem unwahrscheinlich bei CSPRNG)"); return 1;
    }

    // ----------------------------------------------------------------
    // Test 3: RandBytesExact füllt exakt n Bytes
    // ----------------------------------------------------------------
    i := 0;
    while (i < 64) { poke8(buf + i, 0); i := i + 1; }
    rc := RandBytesExact(buf, 64);
    if (rc == 64) {
        PrintLn("OK: RandBytesExact(64) == 64");
    } else {
        Print("FAIL: RandBytesExact returned "); PrintLn(rc); return 1;
    }

    // ----------------------------------------------------------------
    // Test 4: RandBytesExact(0) gibt 0 zurück
    // ----------------------------------------------------------------
    rc := RandBytesExact(buf, 0);
    if (rc == 0) {
        PrintLn("OK: RandBytesExact(0) == 0");
    } else {
        Print("FAIL: RandBytesExact(0) returned "); PrintLn(rc); return 1;
    }

    // ----------------------------------------------------------------
    // Test 5: RandInt64 liefert zwei verschiedene Werte
    // ----------------------------------------------------------------
    var a: int64 := RandInt64();
    var b: int64 := RandInt64();
    if (a != b) {
        PrintLn("OK: RandInt64() liefert verschiedene Werte");
    } else {
        PrintLn("FAIL: zwei aufeinanderfolgende RandInt64() sind identisch (1/2^64 Chance)"); return 1;
    }

    // ----------------------------------------------------------------
    // Test 6: RandU32 liegt im Bereich 0..2^32-1
    // ----------------------------------------------------------------
    var u: int64 := RandU32();
    if (u >= 0 && u <= 0xFFFFFFFF) {
        PrintLn("OK: RandU32() liegt in [0, 2^32-1]");
    } else {
        Print("FAIL: RandU32 ausserhalb Bereich: "); PrintLn(u); return 1;
    }

    // ----------------------------------------------------------------
    // Test 7: GRND_NONBLOCK-Flag via RandBytes mit Flags-Variante
    //         (kein eigener Syscall-Aufruf nötig — wir testen nur dass
    //          die Konstante korrekt definiert ist)
    // ----------------------------------------------------------------
    if (GRND_NONBLOCK == 1 && GRND_RANDOM == 2) {
        PrintLn("OK: GRND_NONBLOCK=1 GRND_RANDOM=2 korrekt");
    } else {
        PrintLn("FAIL: GRND_-Konstanten falsch"); return 1;
    }

    munmap(buf, 64);
    PrintLn("=== alle crypto/rand Tests bestanden ===");
    return 0;
}
