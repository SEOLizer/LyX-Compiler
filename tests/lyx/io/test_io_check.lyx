// WP-CS-09: @io_check + IOResult() smoke tests
// Test 1: @io_check(false) — kein Crash bei fehlerhaftem open, IOResult liefert -2 (ENOENT)
// Test 2: IOResult() nach erfolgreichem open auf /dev/null — sollte >= 0 sein

fn main(): int64 {
  @io_check(false);

  // open einer nicht existierenden Datei — ohne io_check kein Crash
  var fd: int64 := open("/tmp/__lyx_cs09_nonexistent_xyz__"c, 0, 0);
  var r1: int64 := IOResult();

  // r1 sollte -2 (ENOENT) sein
  if (r1 != -2) {
    // Fehler: falscher IOResult
    var msg: pchar := "FAIL: IOResult expected -2\n"c;
    write(2, msg as int64, 27);
    return 1;
  }

  // fd sollte negativ sein
  if (fd >= 0) {
    var msg2: pchar := "FAIL: open should have failed\n"c;
    write(2, msg2 as int64, 30);
    return 1;
  }

  @io_check(true);

  // Erfolgreicher open auf /dev/null
  var fd2: int64 := open("/dev/null"c, 0, 0);
  var r2: int64 := IOResult();

  if (r2 < 0) {
    var msg3: pchar := "FAIL: /dev/null open failed\n"c;
    write(2, msg3 as int64, 28);
    return 1;
  }

  close(fd2);

  var ok: pchar := "PASS: io_check + IOResult OK\n"c;
  write(1, ok as int64, 29);
  return 0;
}
