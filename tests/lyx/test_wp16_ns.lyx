// WP-16: Test fuer std/ns -- pidfd, unshare, setns
import std.ns;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-16: ns -- Namespaces & pidfd ===");

  // ============================================================
  // --- Teil 1: pidfd_open ---
  // ============================================================
  PrintLn("--- pidfd ---");

  // Test 1: PidFdOpen fuer den eigenen Prozess
  var pid:   int64 := getpid();
  var pidfd: int64 := PidFdOpen(pid, 0);
  if (pidfd < 0) {
    Print("FAIL: PidFdOpen="); PrintLn(pidfd); return 1;
  }
  Print("OK: PidFdOpen(pid="); Print(pid); Print(") -> fd="); PrintLn(pidfd);

  // Test 2: PidFdSendSignal(sig=0) -- Existenz-Check, sendet kein echtes Signal
  var sr: int64 := PidFdSendSignal(pidfd, 0);
  if (sr < 0) {
    Print("FAIL: PidFdSendSignal(0)="); PrintLn(sr);
    close(pidfd); return 1;
  }
  PrintLn("OK: PidFdSendSignal(sig=0) -- Prozess existiert");

  // Test 3: PidFdGetFd -- fd=1 (stdout) aus eigenem Prozess duplizieren
  var dupfd: int64 := PidFdGetFd(pidfd, 1);
  if (dupfd < 0) {
    Print("FAIL: PidFdGetFd="); PrintLn(dupfd);
    close(pidfd); return 1;
  }
  Print("OK: PidFdGetFd(stdout) -> fd="); PrintLn(dupfd);
  close(dupfd);
  close(pidfd);

  // ============================================================
  // --- Teil 2: setns -- eigenen UTS-Namespace beitreten (vor unshare) ---
  // ============================================================
  PrintLn("--- setns ---");

  // Test 4: setns -- Syscall erreichbar (UTS braucht CAP_SYS_ADMIN -> EPERM erwartet)
  var nsfd: int64 := open("/proc/self/ns/uts", 0, 0);   // O_RDONLY
  if (nsfd < 0) {
    Print("FAIL: open(/proc/self/ns/uts)="); PrintLn(nsfd); return 1;
  }
  var jr: int64 := NamespaceJoin(nsfd, NSTYPE_ANY);
  close(nsfd);
  // Erwartet: 0 (root), -1 (EPERM, kein root), -22 (EINVAL, gleicher Namespace)
  if (jr == 0 || jr == -1 || jr == -22) {
    Print("OK: NamespaceJoin(uts) syscall erreichbar, r="); PrintLn(jr);
  } else {
    Print("FAIL: NamespaceJoin unerwarteter Fehler="); PrintLn(jr); return 1;
  }

  // ============================================================
  // --- Teil 3: unshare(CLONE_NEWUSER) ---
  // ============================================================
  PrintLn("--- unshare ---");

  // Test 5: NamespaceUnshare(CLONE_NEWUSER) -- kein root erforderlich
  var ur: int64 := NamespaceUnshare(CLONE_NEWUSER);
  if (ur < 0) {
    Print("FAIL: NamespaceUnshare(CLONE_NEWUSER)="); PrintLn(ur); return 1;
  }
  PrintLn("OK: NamespaceUnshare(CLONE_NEWUSER)");

  PrintLn("=== WP-16: alle Tests bestanden ===");
  return 0;
}
