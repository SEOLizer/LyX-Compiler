// Grenzfaelle des gueltigen Indexbereichs: erstes und letztes Element.
//
// Vorher stand hier `arr[5]` mit dem Kommentar "This should trigger bounds
// check" — ausgeloest hat es nichts. Der Zugriff las den Speicher hinter dem
// Array, und weil der Rueckgabewert dieser Stack-Muell war, wechselte der
// Exit-Code von Lauf zu Lauf (#1156). Ein Test ohne festes Ergebnis misst
// nichts.
//
// Der Zugriff AUSSERHALB gehoert nicht hierher: dieser Runner kennt nur
// "Exit 0 = gruen" und kann weder einen erwarteten Uebersetzungsfehler noch
// einen erwarteten Abbruch ausdruecken. Beides prueft
// tests/bounds_check_test.sh.
fn main(): int64 {
  let arr: int64[3] = [1, 2, 3];
  if (arr[0] != 1) { return 1; }
  if (arr[2] != 3) { return 2; }
  if (len(arr) != 3) { return 3; }
  return 0;
}
