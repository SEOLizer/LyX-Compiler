// Test: Import vs local function
import data.core;

fn localNewInt64(name: int64, cap: int64): Series {
  var s: Series;
  s.data := mmap(0, cap * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  s.labels := 0;
  s.length := cap;
  s.colType := 1;
  s.name := name;
  return s;
}

fn main(): int64 {
  Print("Test localNewInt64:\n");
  var s1: Series := localNewInt64(0, 10);
  SeriesSetInt(s1, 0, 42);
  var v1: int64 := SeriesGetInt(s1, 0);
  PrintInt(v1);
  Print("\n");
  
  Print("Test SeriesNewInt64 (imported):\n");
  var s2: Series := SeriesNewInt64(0 as pchar, 10);
  SeriesAppendInt(s2, 99);
  var v2: int64 := SeriesGetInt(s2, 0);
  PrintInt(v2);
  Print("\n");
  
  return 0;
}
