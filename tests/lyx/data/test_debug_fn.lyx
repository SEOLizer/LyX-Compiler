// Debug: print values inside function
import data.core;
import std.alloc;

fn debugNewInt64(name: int64, cap: int64): Series {
  Print("F: start\n");
  var s: Series;
  Print("F: var done\n");
  
  var dataPtr: int64 := alloc(cap * 8);
  Print("F: data mmap done: ");
  PrintInt(dataPtr);
  Print("\n");
  
  s.data := dataPtr;
  
  s.labels := 0;
  s.length := 0;
  s.colType := 1;
  s.name := name;
  
  Print("F: returning\n");
  return s;
}

fn main(): int64 {
  Print("Vor debugNewInt64\n");
  var s: Series := debugNewInt64(0, 10);
  Print("Nach debugNewInt64\n");
  
  Print("data: ");
  PrintInt(s.data);
  Print("\n");
  
  return 0;
}
