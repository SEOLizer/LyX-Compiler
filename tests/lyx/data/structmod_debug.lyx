// Simple module that returns a struct - with debug
pub type Pair = struct {
  x: int64;
  y: int64;
};

pub fn makePair(a: int64, b: int64): Pair {
  Print("makePair called with: ");
  PrintInt(a);
  Print(" ");
  PrintInt(b);
  Print("\n");
  
  var p: Pair;
  p.x := a;
  p.y := b;
  
  Print("Returning p.x=");
  PrintInt(p.x);
  Print(" p.y=");
  PrintInt(p.y);
  Print("\n");
  
  return p;
}
