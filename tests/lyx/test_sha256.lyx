// Test: std/crypto/sha256 -- FIPS 180-4 test vectors
import std.crypto.sha256;

// StrEq: vergleicht zwei NUL-terminierte Strings (len Bytes)
fn strEq(a: int64, b: int64, len: int64): int64 {
    var i: int64 := 0;
    while (i < len) {
        if (peek8(a + i) != peek8(b + i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

pub fn main(argc: int64, argv: pchar): int64 {
    PrintLn("=== SHA-256 Tests (FIPS 180-4 Testvektoren) ===");

    var buf:  int64 := mmap(0, 256, 3, 34, -1, 0);  // Eingabepuffer
    var out:  int64 := mmap(0,  65, 3, 34, -1, 0);  // Hex-Ausgabe (64 + NUL)
    var dig:  int64 := mmap(0,  32, 3, 34, -1, 0);  // Rohdigest (32 Byte)

    // ----------------------------------------------------------------
    // Test 1: SHA-256("") = e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
    // ----------------------------------------------------------------
    SHA256Hex(buf, 0, out);
    var exp1: pchar := "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
    if (strEq(out, exp1 as int64, 64) == 1) {
        PrintLn("OK: SHA256(\"\")");
    } else {
        Print("FAIL: SHA256(\"\") got="); var gotStr: pchar := out as pchar; PrintLn(gotStr); return 1;
    }

    // ----------------------------------------------------------------
    // Test 2: SHA-256("abc") = ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
    // ----------------------------------------------------------------
    poke8(buf, 97); poke8(buf + 1, 98); poke8(buf + 2, 99);   // "abc"
    SHA256Hex(buf, 3, out);
    var exp2: pchar := "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
    if (strEq(out, exp2 as int64, 64) == 1) {
        PrintLn("OK: SHA256(\"abc\")");
    } else {
        Print("FAIL: SHA256(\"abc\") got="); var gotStr: pchar := out as pchar; PrintLn(gotStr); return 1;
    }

    // ----------------------------------------------------------------
    // Test 3: SHA-256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    //       = 248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1
    // ----------------------------------------------------------------
    var msg3: pchar := "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
    var j: int64 := 0;
    while (j < 56) { poke8(buf + j, peek8(msg3 as int64 + j)); j := j + 1; }
    SHA256Hex(buf, 56, out);
    var exp3: pchar := "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1";
    if (strEq(out, exp3 as int64, 64) == 1) {
        PrintLn("OK: SHA256(\"abcdbcdecdef...nopq\")");
    } else {
        Print("FAIL: SHA256(56-char) got="); var gotStr: pchar := out as pchar; PrintLn(gotStr); return 1;
    }

    // ----------------------------------------------------------------
    // Test 4: SHA-256("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmn
    //                  hijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")
    //       = cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1
    // (112-Byte-Eingabe, braucht 2 Padding-Bloecke)
    // ----------------------------------------------------------------
    var msg4: pchar := "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
    j := 0;
    while (j < 112) { poke8(buf + j, peek8(msg4 as int64 + j)); j := j + 1; }
    SHA256Hex(buf, 112, out);
    var exp4: pchar := "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1";
    if (strEq(out, exp4 as int64, 64) == 1) {
        PrintLn("OK: SHA256(112-Byte, 2-Block-Padding)");
    } else {
        Print("FAIL: SHA256(112-Byte) got="); var gotStr: pchar := out as pchar; PrintLn(gotStr); return 1;
    }

    // ----------------------------------------------------------------
    // Test 5: SHA256 Rohdigest -- erste 4 Bytes von SHA256("abc") = ba 78 16 bf
    // ----------------------------------------------------------------
    poke8(buf, 97); poke8(buf + 1, 98); poke8(buf + 2, 99);
    SHA256(buf, 3, dig);
    if (peek8(dig) == 0xBA && peek8(dig + 1) == 0x78 && peek8(dig + 2) == 0x16 && peek8(dig + 3) == 0xBF) {
        PrintLn("OK: SHA256 Rohdigest erste 4 Bytes korrekt (0xBA 0x78 0x16 0xBF)");
    } else {
        Print("FAIL: Rohdigest[0..3] = ");
        Print(peek8(dig)); Print(" "); Print(peek8(dig+1));
        Print(" "); Print(peek8(dig+2)); Print(" "); PrintLn(peek8(dig+3));
        return 1;
    }

    // ----------------------------------------------------------------
    // Test 6: SHA256Str convenience wrapper
    // ----------------------------------------------------------------
    SHA256Str("abc", 3, dig);
    SHA256Hex(buf, 3, out);    // buf still has "abc"
    // both must give the same result -- compare first 4 raw bytes
    var digHex: int64 := mmap(0, 65, 3, 34, -1, 0);
    SHA256Hex("abc" as int64, 3, digHex);
    if (strEq(digHex, exp2 as int64, 64) == 1) {
        PrintLn("OK: SHA256Str(\"abc\") == SHA256Hex(\"abc\")");
    } else {
        Print("FAIL: SHA256Str mismatch: "); PrintLn(digHex as pchar); return 1;
    }
    munmap(digHex, 65);

    munmap(dig,  32);
    munmap(out,  65);
    munmap(buf, 256);

    PrintLn("=== alle SHA-256 Tests bestanden ===");
    return 0;
}
