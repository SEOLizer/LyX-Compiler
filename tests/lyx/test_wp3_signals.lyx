// WP-3: Test für std/signal — Signalbehandlung
import std.signals;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-3: Signalbehandlung ===");

  // --- Test 1: SIG_IGN — SIGTERM ignorieren ---
  var r: int64 := SignalIgnore(SIGTERM);
  if (r != 0) {
    Print("FAIL: SignalIgnore(SIGTERM) = "); PrintLn(r); return 1;
  }
  // Signal an uns selbst senden — Prozess muss überleben
  r := SignalSendSelf(SIGTERM);
  if (r != 0) {
    Print("FAIL: SignalSendSelf(SIGTERM) = "); PrintLn(r); return 1;
  }
  PrintLn("OK: SIG_IGN — SIGTERM ignoriert, Prozess läuft weiter");

  // --- Test 2: SignalDefault — SIG_DFL wiederherstellen ---
  r := SignalDefault(SIGTERM);
  if (r != 0) {
    Print("FAIL: SignalDefault(SIGTERM) = "); PrintLn(r); return 1;
  }
  PrintLn("OK: SignalDefault(SIGTERM) — Standard-Verhalten wiederhergestellt");

  // --- Test 3: SIG_IGN für SIGPIPE ---
  r := SignalIgnore(SIGPIPE);
  if (r != 0) {
    Print("FAIL: SignalIgnore(SIGPIPE) = "); PrintLn(r); return 1;
  }
  PrintLn("OK: SignalIgnore(SIGPIPE)");

  // --- Test 4: SignalMaskBlock + SignalMaskUnblock ---
  // SIGUSR2 blockieren
  r := SignalMaskBlock(SIGUSR2);
  if (r != 0) {
    Print("FAIL: SignalMaskBlock(SIGUSR2) = "); PrintLn(r); return 1;
  }
  // SIGUSR2 senden — bleibt pending weil blockiert
  r := SignalSendSelf(SIGUSR2);
  if (r != 0) {
    Print("FAIL: SignalSendSelf(SIGUSR2) = "); PrintLn(r); return 1;
  }
  // SIG_IGN setzen bevor wir entblockieren → Signal wird verworfen
  SignalIgnore(SIGUSR2);
  r := SignalMaskUnblock(SIGUSR2);
  if (r != 0) {
    Print("FAIL: SignalMaskUnblock(SIGUSR2) = "); PrintLn(r); return 1;
  }
  // Wenn wir hier sind, wurde das pending SIGUSR2 durch SIG_IGN verworfen
  PrintLn("OK: SignalMask — pending SIGUSR2 wurde durch SIG_IGN verworfen");
  SignalDefault(SIGUSR2);

  // --- Test 5: SignalFd — Signal über fd empfangen ---
  // SIGUSR1 blockieren (MUSS vor signalfd passieren!)
  r := SignalMaskBlock(SIGUSR1);
  if (r != 0) {
    Print("FAIL: SignalMaskBlock(SIGUSR1) = "); PrintLn(r); return 1;
  }
  var sfd: int64 := SignalFd(SIGUSR1);
  if (sfd < 0) {
    Print("FAIL: SignalFd(SIGUSR1) = "); PrintLn(sfd); return 1;
  }
  Print("OK: SignalFd erstellt — fd="); PrintLn(sfd);
  // SIGUSR1 an uns selbst senden
  r := SignalSendSelf(SIGUSR1);
  if (r != 0) {
    Print("FAIL: SignalSendSelf(SIGUSR1) = "); PrintLn(r); return 1;
  }
  // Event vom signalfd lesen
  var buf: int64 := alloc(SIGNALFD_SIGINFO_SIZE);
  var n: int64 := SignalFdRead(sfd, buf);
  if (n == SIGNALFD_SIGINFO_SIZE) {
    var signo: int64 := SignalFdSigno(buf);
    if (signo == SIGUSR1) {
      Print("OK: SignalFd — ssi_signo="); PrintLn(signo);
    } else {
      Print("FAIL: falsches Signal signo="); PrintLn(signo); return 1;
    }
  } else {
    Print("FAIL: SignalFdRead n="); PrintLn(n); return 1;
  }
  free(buf, SIGNALFD_SIGINFO_SIZE);
  close(sfd);
  SignalMaskUnblock(SIGUSR1);

  // --- Test 6: sys_getpid() liefert plausiblen Wert ---
  var pid: int64 := sys_getpid();
  if (pid > 1 && pid < 4194304) {
    Print("OK: sys_getpid = "); PrintLn(pid);
  } else {
    Print("FAIL: sys_getpid = "); PrintLn(pid); return 1;
  }

  // --- Test 7: SignalSend(pid, 0) — Existenz-Check (sig=0 sendet nichts) ---
  r := SignalSend(pid, 0);
  if (r == 0) {
    PrintLn("OK: SignalSend(self, 0) — Prozess existiert");
  } else {
    Print("FAIL: SignalSend(self, 0) = "); PrintLn(r); return 1;
  }

  PrintLn("=== WP-3: alle Tests bestanden ===");
  return 0;
}
