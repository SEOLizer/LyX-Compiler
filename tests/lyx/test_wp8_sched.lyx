// WP-8: Test für std/sched — Scheduling & CPU-Affinität
import std.sched;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-8: Scheduling & CPU-Affinität ===");

  // --- Test 1: SchedYield ---
  var r: int64 := SchedYield();
  if (r == 0) {
    PrintLn("OK: SchedYield");
  } else {
    Print("FAIL: SchedYield="); PrintLn(r); return 1;
  }

  // --- Test 2: GetCurrentCPU ---
  var cpu: int64 := GetCurrentCPU();
  if (cpu >= 0) {
    Print("OK: GetCurrentCPU="); PrintLn(cpu);
  } else {
    Print("FAIL: GetCurrentCPU="); PrintLn(cpu); return 1;
  }

  // --- Test 3: GetCPU (mit Puffer) ---
  var cpuBuf: int64 := alloc(8);
  var nodeBuf: int64 := alloc(8);
  poke64(cpuBuf, 0); poke64(nodeBuf, 0);
  r := GetCPU(cpuBuf, nodeBuf);
  if (r == 0) {
    var cpuVal:  int64 := peek64(cpuBuf) & 4294967295;
    var nodeVal: int64 := peek64(nodeBuf) & 4294967295;
    Print("OK: GetCPU — cpu="); Print(cpuVal);
    Print(" node="); PrintLn(nodeVal);
  } else {
    Print("FAIL: GetCPU="); PrintLn(r);
    free(cpuBuf, 8); free(nodeBuf, 8); return 1;
  }
  free(cpuBuf, 8);
  free(nodeBuf, 8);

  // --- Test 4: SchedGetAffinity ---
  var mask: int64 := alloc(CPU_SET_SIZE);
  r := SchedGetAffinity(0, mask);
  if (r == 0) {
    var cnt: int64 := CpuSetCount(mask);
    Print("OK: SchedGetAffinity — "); Print(cnt); PrintLn(" CPU(s) in Maske");
    if (cnt <= 0) {
      PrintLn("FAIL: Maske ist leer"); free(mask, CPU_SET_SIZE); return 1;
    }
  } else {
    Print("FAIL: SchedGetAffinity="); PrintLn(r);
    free(mask, CPU_SET_SIZE); return 1;
  }

  // --- Test 5: CpuSetHas — CPU 0 muss in der Maske sein ---
  if (CpuSetHas(mask, 0)) {
    PrintLn("OK: CpuSetHas(mask, 0) = true");
  } else {
    PrintLn("FAIL: CPU 0 sollte in der Maske sein"); free(mask, CPU_SET_SIZE); return 1;
  }

  // --- Test 6: CpuSetZero + CpuSetAdd ---
  var mask2: int64 := alloc(CPU_SET_SIZE);
  CpuSetZero(mask2);
  if (CpuSetCount(mask2) == 0) {
    PrintLn("OK: CpuSetZero — Maske leer");
  } else {
    PrintLn("FAIL: CpuSetZero"); free(mask2, CPU_SET_SIZE); free(mask, CPU_SET_SIZE); return 1;
  }
  CpuSetAdd(mask2, 0);
  if (CpuSetHas(mask2, 0) && CpuSetCount(mask2) == 1) {
    PrintLn("OK: CpuSetAdd(0) — CPU 0 gesetzt");
  } else {
    PrintLn("FAIL: CpuSetAdd"); free(mask2, CPU_SET_SIZE); free(mask, CPU_SET_SIZE); return 1;
  }
  CpuSetAdd(mask2, 3);
  if (CpuSetHas(mask2, 3) && CpuSetCount(mask2) == 2) {
    PrintLn("OK: CpuSetAdd(3) — CPU 0+3 gesetzt");
  } else {
    PrintLn("FAIL: CpuSetAdd(3)"); free(mask2, CPU_SET_SIZE); free(mask, CPU_SET_SIZE); return 1;
  }
  CpuSetRemove(mask2, 0);
  if (!CpuSetHas(mask2, 0) && CpuSetHas(mask2, 3)) {
    PrintLn("OK: CpuSetRemove(0) — nur CPU 3 verbleibt");
  } else {
    PrintLn("FAIL: CpuSetRemove"); free(mask2, CPU_SET_SIZE); free(mask, CPU_SET_SIZE); return 1;
  }
  free(mask2, CPU_SET_SIZE);

  // --- Test 7: SchedSetAffinity (CPU 0 einschließen) ---
  // Sichere Variante: aktuelle Maske lesen und mit CPU 0 setzen
  var setMask: int64 := alloc(CPU_SET_SIZE);
  CpuSetZero(setMask);
  CpuSetAdd(setMask, 0);
  r := SchedSetAffinity(0, setMask);
  if (r == 0) {
    PrintLn("OK: SchedSetAffinity(CPU 0)");
    // Maske zurücklesen und verifizieren
    var verifyMask: int64 := alloc(CPU_SET_SIZE);
    SchedGetAffinity(0, verifyMask);
    if (CpuSetHas(verifyMask, 0) && CpuSetCount(verifyMask) == 1) {
      PrintLn("OK: Affinität verifiziert — nur CPU 0");
    } else {
      Print("FAIL: Affinität falsch, CPUs="); PrintLn(CpuSetCount(verifyMask));
    }
    free(verifyMask, CPU_SET_SIZE);
    // Originalmaske wiederherstellen
    SchedSetAffinity(0, mask);
  } else {
    Print("INFO: SchedSetAffinity="); PrintLn(r);
  }
  free(setMask, CPU_SET_SIZE);
  free(mask, CPU_SET_SIZE);

  // --- Test 8: GetPriority ---
  var nice: int64 := GetPriority(0);
  if (nice >= -20 && nice <= 19) {
    Print("OK: GetPriority(self)="); PrintLn(nice);
  } else {
    Print("FAIL: GetPriority="); PrintLn(nice); return 1;
  }

  // --- Test 9: SetPriority(0, nice) — gleicher Nice-Wert, No-Op ---
  r := SetPriority(0, nice);
  if (r == 0) {
    PrintLn("OK: SetPriority(self, eigen) = 0");
  } else {
    Print("FAIL: SetPriority="); PrintLn(r); return 1;
  }

  PrintLn("=== WP-8: alle Tests bestanden ===");
  return 0;
}
