// WP-18: Test fuer std/debug -- ptrace & perf_event_open
import std.debug;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-18: debug -- ptrace & perf_event_open ===");

  // ============================================================
  // --- Teil 1: ptrace ---
  // ============================================================
  PrintLn("--- ptrace ---");

  // Test 1: PtraceTraceme -- markiert den aktuellen Prozess als traceable.
  // Gibt 0 zurueck (oder -EPERM wenn bereits traciert).
  var tr: int64 := PtraceTraceme();
  if (tr == 0) {
    PrintLn("OK: PtraceTraceme() = 0");
  } else {
    // -1 = EPERM ist auch ok (z.B. in Containers oder wenn bereits traciert)
    if (tr == -1) {
      PrintLn("OK: PtraceTraceme() = -EPERM (erwartet in manchen Umgebungen)");
    } else {
      Print("FAIL: PtraceTraceme="); PrintLn(tr); return 1;
    }
  }

  // Test 2: PtraceAttach an sich selbst -- immer -EPERM (kein Selbst-Attach)
  var pid: int64 := getpid();
  var ar: int64 := PtraceAttach(pid);
  if (ar == -1) {
    PrintLn("OK: PtraceAttach(self) = -EPERM (erwartet)");
  } else {
    if (ar == 0) {
      // Selten: manche Systeme erlauben es
      PrintLn("OK: PtraceAttach(self) = 0");
      PtraceDetach(pid, 0);
    } else {
      Print("FAIL: PtraceAttach="); PrintLn(ar); return 1;
    }
  }

  // ============================================================
  // --- Teil 2: perf_event_open ---
  // ============================================================
  PrintLn("--- perf_event_open ---");

  // Test 3: PerfCount(SW_TASK_CLOCK) -- klappt nur wenn perf_event_paranoid <= 2
  var fd: int64 := PerfCount(PERF_TYPE_SOFTWARE, PERF_COUNT_SW_TASK_CLOCK);
  if (fd < 0) {
    // -13 = EACCES (perf_event_paranoid zu hoch), -1 = EPERM: erwartet auf gesperrten Systemen
    if (fd == -13 || fd == -1) {
      PrintLn("INFO: PerfCount -- EACCES/EPERM (perf_event_paranoid zu hoch, Syscall erreichbar)");
    } else {
      Print("FAIL: PerfCount unerwarteter Fehler="); PrintLn(fd); return 1;
    }
  } else {
    Print("OK: PerfCount(SW_TASK_CLOCK) -- fd="); PrintLn(fd);

    // Test 4: PerfReset
    var rr: int64 := PerfReset(fd);
    if (rr < 0) {
      Print("FAIL: PerfReset="); PrintLn(rr); close(fd); return 1;
    }
    PrintLn("OK: PerfReset");

    // Test 5: PerfRead
    var v1: int64 := PerfRead(fd);
    if (v1 < 0) {
      Print("FAIL: PerfRead="); PrintLn(v1); close(fd); return 1;
    }
    Print("OK: PerfRead nach Reset = "); PrintLn(v1);

    // Test 6: Arbeit + zweiter Read
    var i: int64 := 0;
    var sum: int64 := 0;
    while (i < 10000) { sum := sum + i; i := i + 1; }
    var v2: int64 := PerfRead(fd);
    if (v2 < 0) {
      Print("FAIL: PerfRead(2)="); PrintLn(v2); close(fd); return 1;
    }
    if (v2 >= v1) {
      Print("OK: PerfRead nach Arbeit = "); Print(v2); PrintLn(" (>= vorher)");
    } else {
      Print("FAIL: Zaehler kleiner: v1="); Print(v1); Print(" v2="); PrintLn(v2);
      close(fd); return 1;
    }

    // Test 7: PerfDisable + PerfEnable
    if (PerfDisable(fd) < 0) { PrintLn("FAIL: PerfDisable"); close(fd); return 1; }
    PrintLn("OK: PerfDisable");
    if (PerfEnable(fd) < 0) { PrintLn("FAIL: PerfEnable"); close(fd); return 1; }
    PrintLn("OK: PerfEnable");

    close(fd);
  }

  PrintLn("=== WP-18: alle Tests bestanden ===");
  return 0;
}
