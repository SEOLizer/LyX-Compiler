// tests/lyx/enums/test_enum_basic.lyx
// WP-04: Enum-Typen – Grundtest
// Syntax: enum Name { VAL, VAL = explicit }
// Enums werden zu int64-Konstanten (0, 1, 2, ...) compiliert

// Automatische Nummerierung (0, 1, 2, ...)
pub enum TokenKind {
  tkEof,
  tkIdent,
  tkInt,
  tkPlus,
  tkMinus,
  tkStar,
};

// Explizite Werte mit '='
pub enum HttpStatus {
  OK           = 200,
  NOT_FOUND    = 404,
  SERVER_ERROR = 500,
};

// Gemischt: explizit + auto-increment
pub enum Direction {
  NORTH,        // 0
  SOUTH,        // 1
  EAST  = 10,   // 10
  WEST,         // 11 (continues from last explicit)
};

// Hilfsfunktion: gibt TokenKind-Namen zurück
fn tokenKindName(k: TokenKind): pchar {
  if (k == tkEof)    { return "EOF"; }
  if (k == tkIdent)  { return "IDENT"; }
  if (k == tkInt)    { return "INT"; }
  if (k == tkPlus)   { return "PLUS"; }
  if (k == tkMinus)  { return "MINUS"; }
  if (k == tkStar)   { return "STAR"; }
  return "?";
}

fn main(): int64 {
  // === Auto-nummerierung ===
  Print("=== TokenKind (auto) ===\n");
  Print("tkEof   = "); PrintInt(tkEof);   Print("\n");
  Print("tkIdent = "); PrintInt(tkIdent); Print("\n");
  Print("tkInt   = "); PrintInt(tkInt);   Print("\n");
  Print("tkPlus  = "); PrintInt(tkPlus);  Print("\n");
  Print("tkMinus = "); PrintInt(tkMinus); Print("\n");
  Print("tkStar  = "); PrintInt(tkStar);  Print("\n");

  // === Explizite Werte ===
  Print("=== HttpStatus (explicit) ===\n");
  Print("OK           = "); PrintInt(OK);           Print("\n");
  Print("NOT_FOUND    = "); PrintInt(NOT_FOUND);    Print("\n");
  Print("SERVER_ERROR = "); PrintInt(SERVER_ERROR); Print("\n");

  // === Gemischt ===
  Print("=== Direction (mixed) ===\n");
  Print("NORTH = "); PrintInt(NORTH); Print("\n");
  Print("SOUTH = "); PrintInt(SOUTH); Print("\n");
  Print("EAST  = "); PrintInt(EAST);  Print("\n");
  Print("WEST  = "); PrintInt(WEST);  Print("\n");

  // === Variable mit Enum-Typ ===
  Print("=== Typed variable ===\n");
  var kind: TokenKind := tkIdent;
  Print("kind = "); Print(tokenKindName(kind)); Print("\n");

  // === switch auf Enum-Wert ===
  Print("=== switch on enum ===\n");
  var status: HttpStatus := OK;
  switch (status) {
    case 200: { Print("status: OK\n"); break; }
    case 404: { Print("status: Not Found\n"); break; }
    case 500: { Print("status: Server Error\n"); break; }
    default:  { Print("status: unknown\n"); break; }
  }

  // === Enum in Ausdrücken ===
  Print("=== arithmetic ===\n");
  var sum: int64 := tkPlus + tkMinus + tkStar;
  Print("tkPlus+tkMinus+tkStar = "); PrintInt(sum); Print("\n");

  // === Vergleiche ===
  Print("=== comparisons ===\n");
  if (kind == tkIdent) {
    Print("kind is IDENT\n");
  }
  if (tkEof < tkIdent) {
    Print("tkEof < tkIdent: true\n");
  }

  return 0;
}
