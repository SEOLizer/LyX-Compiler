// Test: std/crypto/hmac -- RFC 4231 HMAC-SHA256 Testvektoren
import std.crypto.hmac;

fn strEq(a: int64, b: int64, len: int64): int64 {
    var i: int64 := 0;
    while (i < len) {
        if (peek8(a + i) != peek8(b + i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

pub fn main(argc: int64, argv: pchar): int64 {
    PrintLn("=== HMAC-SHA256 Tests (RFC 4231) ===");

    var out: int64 := mmap(0, 65, 3, 34, -1, 0);
    var buf: int64 := mmap(0, 256, 3, 34, -1, 0);

    // ----------------------------------------------------------------
    // Test 1: RFC 4231 TC-1
    //   Key  = 0b0b...0b (20 Bytes)
    //   Data = "Hi There"
    //   MAC  = b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7
    // ----------------------------------------------------------------
    var key1: int64 := mmap(0, 20, 3, 34, -1, 0);
    var i: int64 := 0;
    while (i < 20) { poke8(key1 + i, 0x0B); i := i + 1; }
    var data1: pchar := "Hi There";
    HMAC_SHA256_Hex(key1, 20, data1 as int64, 8, out);
    var exp1: pchar := "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7";
    if (strEq(out, exp1 as int64, 64) == 1) {
        PrintLn("OK: HMAC-SHA256 RFC4231-TC1 (Hi There)");
    } else {
        Print("FAIL TC1 got="); var s: pchar := out as pchar; PrintLn(s); return 1;
    }
    munmap(key1, 20);

    // ----------------------------------------------------------------
    // Test 2: RFC 4231 TC-2
    //   Key  = "Jefe"
    //   Data = "what do ya want for nothing?"
    //   MAC  = 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843
    // ----------------------------------------------------------------
    var key2: pchar := "Jefe";
    var data2: pchar := "what do ya want for nothing?";
    HMAC_SHA256_Hex(key2 as int64, 4, data2 as int64, 28, out);
    var exp2: pchar := "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843";
    if (strEq(out, exp2 as int64, 64) == 1) {
        PrintLn("OK: HMAC-SHA256 RFC4231-TC2 (Jefe)");
    } else {
        Print("FAIL TC2 got="); var s2: pchar := out as pchar; PrintLn(s2); return 1;
    }

    // ----------------------------------------------------------------
    // Test 3: RFC 4231 TC-3
    //   Key  = 0xaa * 20
    //   Data = 0xdd * 50
    //   MAC  = 773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe
    // ----------------------------------------------------------------
    var key3: int64 := mmap(0, 20, 3, 34, -1, 0);
    var data3: int64 := mmap(0, 50, 3, 34, -1, 0);
    i := 0; while (i < 20) { poke8(key3 + i, 0xAA); i := i + 1; }
    i := 0; while (i < 50) { poke8(data3 + i, 0xDD); i := i + 1; }
    HMAC_SHA256_Hex(key3, 20, data3, 50, out);
    var exp3: pchar := "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe";
    if (strEq(out, exp3 as int64, 64) == 1) {
        PrintLn("OK: HMAC-SHA256 RFC4231-TC3 (0xaa/0xdd)");
    } else {
        Print("FAIL TC3 got="); var s3: pchar := out as pchar; PrintLn(s3); return 1;
    }
    munmap(key3, 20); munmap(data3, 50);

    // ----------------------------------------------------------------
    // Test 4: RFC 4231 TC-6 — Schlüssel länger als Blockgröße (131 Bytes)
    //   Key  = 0xaa * 131
    //   Data = "Test Using Larger Than Block-Size Key - Hash Key First"
    //   MAC  = 60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54
    // ----------------------------------------------------------------
    var key6: int64 := mmap(0, 131, 3, 34, -1, 0);
    i := 0; while (i < 131) { poke8(key6 + i, 0xAA); i := i + 1; }
    var data6: pchar := "Test Using Larger Than Block-Size Key - Hash Key First";
    HMAC_SHA256_Hex(key6, 131, data6 as int64, 54, out);
    var exp6: pchar := "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54";
    if (strEq(out, exp6 as int64, 64) == 1) {
        PrintLn("OK: HMAC-SHA256 RFC4231-TC6 (Key > Blockgröße)");
    } else {
        Print("FAIL TC6 got="); var s6: pchar := out as pchar; PrintLn(s6); return 1;
    }
    munmap(key6, 131);

    // ----------------------------------------------------------------
    // Test 5: Rohdigest-API — HMAC_SHA256 (nicht Hex)
    //   Erwartet: ersten 4 Bytes von TC1 = b0 34 4c 61
    // ----------------------------------------------------------------
    var key5: int64 := mmap(0, 20, 3, 34, -1, 0);
    var dig:  int64 := mmap(0, 32, 3, 34, -1, 0);
    i := 0; while (i < 20) { poke8(key5 + i, 0x0B); i := i + 1; }
    HMAC_SHA256(key5, 20, "Hi There" as int64, 8, dig);
    if (peek8(dig) == 0xB0 && peek8(dig+1) == 0x34 && peek8(dig+2) == 0x4C && peek8(dig+3) == 0x61) {
        PrintLn("OK: HMAC_SHA256 Rohdigest erste 4 Bytes korrekt");
    } else {
        Print("FAIL Rohdigest[0..3] = ");
        Print(peek8(dig)); Print(" "); Print(peek8(dig+1));
        Print(" "); Print(peek8(dig+2)); Print(" "); PrintLn(peek8(dig+3));
        return 1;
    }
    munmap(key5, 20); munmap(dig, 32);

    munmap(out, 65); munmap(buf, 256);
    PrintLn("=== alle HMAC-SHA256 Tests bestanden ===");
    return 0;
}
