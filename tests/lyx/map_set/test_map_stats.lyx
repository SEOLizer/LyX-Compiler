// Test: MapCount / MapSum / MapMin / MapMax / MapAvg
// Uses Map<int64, int64> cast to int64 for the aggregate functions.

import std.stats;

fn main(): int64 {
  // Build a map with known values: { 1->10, 2->20, 3->30, 4->40, 5->50 }
  var m: Map<int64, int64> := {};
  m[1] := 10;
  m[2] := 20;
  m[3] := 30;
  m[4] := 40;
  m[5] := 50;

  var mp: int64 := m as int64;

  // MapCount
  var cnt: int64 := MapCount(mp);
  PrintStr("MapCount = ");
  PrintInt(cnt);
  PrintStr(" (expected 5)\n");

  // MapSum: 10+20+30+40+50 = 150
  var s: int64 := MapSum(mp);
  PrintStr("MapSum   = ");
  PrintInt(s);
  PrintStr(" (expected 150)\n");

  // MapMin: 10
  var mn: int64 := MapMin(mp);
  PrintStr("MapMin   = ");
  PrintInt(mn);
  PrintStr(" (expected 10)\n");

  // MapMax: 50
  var mx: int64 := MapMax(mp);
  PrintStr("MapMax   = ");
  PrintInt(mx);
  PrintStr(" (expected 50)\n");

  // MapAvg: 150/5 = 30
  var avg: int64 := MapAvg(mp);
  PrintStr("MapAvg   = ");
  PrintInt(avg);
  PrintStr(" (expected 30)\n");

  // Edge case: single entry map
  var m2: Map<int64, int64> := {};
  m2[42] := 99;
  var mp2: int64 := m2 as int64;
  PrintStr("Single-entry MapSum = ");
  PrintInt(MapSum(mp2));
  PrintStr(" (expected 99)\n");

  // Edge case: null map
  var mp3: int64 := 0;
  PrintStr("Null MapCount = ");
  PrintInt(MapCount(mp3));
  PrintStr(" (expected 0)\n");

  PrintStr("Done.\n");
  return 0;
}
