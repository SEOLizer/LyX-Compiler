// WP-AS-20: @optimization_level pragma — arithmetic still correct at any level
// Expected exit code: 0
fn compute(x: int64): int64 {
    @optimization_level(0);
    var a: int64 := x + 1;
    var b: int64 := a * 2;
    var c: int64 := b - x;
    return c;  // (x+1)*2 - x = x+2
}

fn main(): int64 {
    var result: int64 := compute(10);
    if (result == 12) {
        exit(0);
    }
    exit(1);
    return 0;
}
