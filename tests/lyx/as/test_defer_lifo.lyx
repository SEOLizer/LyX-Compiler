// WP-AS-20: defer LIFO order test
// Two defers: A (first), B (second).
// LIFO: B runs first → gSeq = 2, then A → gSeq = 2*16 + 1 = 33
// Expected exit code: 33
var gSeq: int64 := 0;

fn tag(n: int64): int64 {
    gSeq := (gSeq * 16) + n;
    return 0;
}

fn doDefers(): int64 {
    defer tag(1);   // defer A: runs second (LIFO)
    defer tag(2);   // defer B: runs first  (LIFO)
    return 0;
}

fn main(): int64 {
    doDefers();
    exit(gSeq);
    return 0;
}
