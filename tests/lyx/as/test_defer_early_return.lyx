// WP-AS-20: defer runs before early return
// Expected exit code: 42
var gFlag: int64 := 0;

fn markDone(): int64 {
    gFlag := 42;
    return 0;
}

fn earlyReturn(): int64 {
    defer markDone();
    return 0;   // early return: defer must run first
}

fn main(): int64 {
    earlyReturn();
    exit(gFlag);
    return 0;
}
