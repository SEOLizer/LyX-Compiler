// WP-AS-20: @bounds_check(false) suppresses bounds check — normal access works
// Expected exit code: 0
fn main(): int64 {
    @bounds_check(false);
    var arr: int64[4];
    arr[0] := 10;
    arr[1] := 20;
    arr[2] := 30;
    arr[3] := 40;
    if (arr[0] + arr[3] == 50) {
        exit(0);
    }
    exit(1);
    return 0;
}
