// WP-12: Test für std/ipc_sysv — SysV IPC (Shared Memory, Semaphore, MsgQueue)
import std.ipc_sysv;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-12: ipc_sysv — SysV IPC ===");

  // ============================================================
  // --- Teil 1: Shared Memory ---
  // ============================================================
  PrintLn("--- Shared Memory ---");

  // Test 1: ShmCreate
  var shmId: int64 := ShmCreate(IPC_PRIVATE, 4096, IPC_CREAT | 438);
  if (shmId < 0) {
    Print("FAIL: ShmCreate="); PrintLn(shmId); return 1;
  }
  Print("OK: ShmCreate — shmId="); PrintLn(shmId);

  // Test 2: ShmAttach
  var ptr: int64 := ShmAttach(shmId, 0, 0);
  if (ptr < 0) {
    Print("FAIL: ShmAttach="); PrintLn(ptr);
    ShmDelete(shmId); return 1;
  }
  PrintLn("OK: ShmAttach");

  // Test 3: Schreiben und Lesen im Shared Memory
  poke64(ptr,      0xCAFEBABE);
  poke64(ptr + 8,  42);
  var v0: int64 := peek64(ptr);
  var v1: int64 := peek64(ptr + 8);
  if (v0 != 0xCAFEBABE || v1 != 42) {
    Print("FAIL: SHM-Inhalt v0="); Print(v0); Print(" v1="); PrintLn(v1);
    ShmDetach(ptr); ShmDelete(shmId); return 1;
  }
  PrintLn("OK: SHM-Inhalt korrekt (0xCAFEBABE, 42)");

  // Test 4: ShmDetach + ShmDelete
  var dr: int64 := ShmDetach(ptr);
  if (dr < 0) {
    Print("FAIL: ShmDetach="); PrintLn(dr);
    ShmDelete(shmId); return 1;
  }
  var del: int64 := ShmDelete(shmId);
  if (del < 0) {
    Print("FAIL: ShmDelete="); PrintLn(del); return 1;
  }
  PrintLn("OK: ShmDetach + ShmDelete");

  // ============================================================
  // --- Teil 2: Semaphore ---
  // ============================================================
  PrintLn("--- Semaphore ---");

  // Test 5: SemCreate
  var semId: int64 := SemCreate(IPC_PRIVATE, 1, IPC_CREAT | 438);
  if (semId < 0) {
    Print("FAIL: SemCreate="); PrintLn(semId); return 1;
  }
  Print("OK: SemCreate — semId="); PrintLn(semId);

  // Test 6: SemSetVal + SemGetVal
  var sr: int64 := SemSetVal(semId, 0, 3);
  if (sr < 0) {
    Print("FAIL: SemSetVal="); PrintLn(sr);
    SemDelete(semId); return 1;
  }
  var sv: int64 := SemGetVal(semId, 0);
  if (sv != 3) {
    Print("FAIL: SemGetVal="); PrintLn(sv);
    SemDelete(semId); return 1;
  }
  PrintLn("OK: SemSetVal(3) + SemGetVal=3");

  // Test 7: SemPost
  var pr: int64 := SemPost(semId, 0);
  if (pr < 0) {
    Print("FAIL: SemPost="); PrintLn(pr);
    SemDelete(semId); return 1;
  }
  var sv2: int64 := SemGetVal(semId, 0);
  if (sv2 != 4) {
    Print("FAIL: nach SemPost SemGetVal="); PrintLn(sv2);
    SemDelete(semId); return 1;
  }
  PrintLn("OK: SemPost -> SemGetVal=4");

  // Test 8: SemWait (nicht-blockierend, da Wert > 0)
  var wr: int64 := SemWait(semId, 0);
  if (wr < 0) {
    Print("FAIL: SemWait="); PrintLn(wr);
    SemDelete(semId); return 1;
  }
  var sv3: int64 := SemGetVal(semId, 0);
  if (sv3 != 3) {
    Print("FAIL: nach SemWait SemGetVal="); PrintLn(sv3);
    SemDelete(semId); return 1;
  }
  PrintLn("OK: SemWait -> SemGetVal=3");

  // Test 9: SemDelete
  var sdel: int64 := SemDelete(semId);
  if (sdel < 0) {
    Print("FAIL: SemDelete="); PrintLn(sdel); return 1;
  }
  PrintLn("OK: SemDelete");

  // ============================================================
  // --- Teil 3: SysV Message Queues ---
  // ============================================================
  PrintLn("--- SysV Message Queues ---");

  // Test 10: MsgQueueCreate
  var mqId: int64 := MsgQueueCreate(IPC_PRIVATE, IPC_CREAT | 438);
  if (mqId < 0) {
    Print("FAIL: MsgQueueCreate="); PrintLn(mqId); return 1;
  }
  Print("OK: MsgQueueCreate — mqId="); PrintLn(mqId);

  // Test 11: MsgSend
  // msgbuf-Layout: [mtype: int64][data: 8 Bytes] = 16 Bytes
  var sendBuf: int64 := mmap(0, 32, 3, 34, -1, 0);
  poke64(sendBuf,     1);           // mtype = 1
  poke64(sendBuf + 8, 0xDEADBEEF); // Nutzdaten
  var ms: int64 := MsgSend(mqId, sendBuf, 8, 0);
  if (ms != 0) {
    Print("FAIL: MsgSend="); PrintLn(ms);
    munmap(sendBuf, 32); MsgQueueDelete(mqId); return 1;
  }
  PrintLn("OK: MsgSend — mtype=1 + 8 Byte Nutzdaten");

  // Test 12: MsgRecv
  var recvBuf: int64 := mmap(0, 64, 3, 34, -1, 0);
  // size = max Nutzdaten OHNE mtype-Header = 8
  var n: int64 := MsgRecv(mqId, recvBuf, 8, 1, 0);
  if (n != 8) {
    Print("FAIL: MsgRecv n="); PrintLn(n);
    munmap(recvBuf, 64); munmap(sendBuf, 32); MsgQueueDelete(mqId); return 1;
  }
  Print("OK: MsgRecv — "); Print(n); PrintLn(" Nutzdaten-Bytes");

  var gotType: int64 := peek64(recvBuf);
  var gotData: int64 := peek64(recvBuf + 8);
  if (gotType != 1 || gotData != 0xDEADBEEF) {
    Print("FAIL: mtype="); Print(gotType);
    Print(" data="); PrintLn(gotData);
    munmap(recvBuf, 64); munmap(sendBuf, 32); MsgQueueDelete(mqId); return 1;
  }
  PrintLn("OK: MsgRecv-Inhalt korrekt (mtype=1, data=0xDEADBEEF)");

  // Test 13: MsgQueueDelete
  var mdel: int64 := MsgQueueDelete(mqId);
  if (mdel < 0) {
    Print("FAIL: MsgQueueDelete="); PrintLn(mdel);
    munmap(recvBuf, 64); munmap(sendBuf, 32); return 1;
  }
  PrintLn("OK: MsgQueueDelete");

  munmap(recvBuf, 64);
  munmap(sendBuf, 32);

  PrintLn("=== WP-12: alle Tests bestanden ===");
  return 0;
}
