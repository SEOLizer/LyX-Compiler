// WP-CS-10: @overflow_check tests
// Test 1: @overflow_check(false) — kein Crash bei Wraparound
// Test 2: @overflow_check(true)  — Panic bei int64-Overflow (add/sub/mul)

fn main(): int64 {
  @overflow_check(false);

  // Test 1a: add wraparound — kein Crash
  var maxInt: int64 := 9223372036854775807;
  var r1: int64 := maxInt + 1;
  // r1 sollte -9223372036854775808 (MIN_INT64) sein
  var expected: int64 := 0 - 9223372036854775807 - 1;
  if (r1 != expected) {
    var msg: pchar := "FAIL: add wraparound wrong\n"c;
    write(2, msg as int64, 27);
    return 1;
  }

  // Test 1b: sub wraparound — kein Crash
  var minInt: int64 := 0 - 9223372036854775807 - 1;
  var r2: int64 := minInt - 1;
  if (r2 != 9223372036854775807) {
    var msg2: pchar := "FAIL: sub wraparound wrong\n"c;
    write(2, msg2 as int64, 27);
    return 1;
  }

  // Test 1c: mul wraparound — kein Crash
  var r3: int64 := 9223372036854775807 * 2;
  if (r3 != -2) {
    var msg3: pchar := "FAIL: mul wraparound wrong\n"c;
    write(2, msg3 as int64, 27);
    return 1;
  }

  // Test 2: kein Overflow bei normaler Arithmetik — auch mit overflow_check(true) kein Crash
  @overflow_check(true);

  var a: int64 := 100;
  var b: int64 := 200;
  var r4: int64 := a + b;
  if (r4 != 300) {
    var msg4: pchar := "FAIL: normal add wrong\n"c;
    write(2, msg4 as int64, 23);
    return 1;
  }

  var r5: int64 := b - a;
  if (r5 != 100) {
    var msg5: pchar := "FAIL: normal sub wrong\n"c;
    write(2, msg5 as int64, 23);
    return 1;
  }

  var r6: int64 := a * 3;
  if (r6 != 300) {
    var msg6: pchar := "FAIL: normal mul wrong\n"c;
    write(2, msg6 as int64, 23);
    return 1;
  }

  var ok: pchar := "PASS: overflow_check OK\n"c;
  write(1, ok as int64, 24);
  return 0;
}
