// WP-1: Test für std/fs_ext — Erweitertes Datei-I/O
import std.fs_ext;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-1: Erweitertes Datei-I/O ===");

  // --- FileExists / FileAccess ---
  if (FileExists("/etc/hostname")) {
    PrintLn("OK: FileExists(/etc/hostname) = true");
  } else {
    PrintLn("FAIL: FileExists(/etc/hostname)");
    return 1;
  }

  if (!FileExists("/tmp/wp1_this_file_does_not_exist_xyz")) {
    PrintLn("OK: FileExists(nonexistent) = false");
  } else {
    PrintLn("FAIL: FileExists(nonexistent) soll false sein");
    return 1;
  }

  // --- Fstat ---
  var statBuf: int64 := alloc(STAT_SIZE);
  var fd: int64 := open("/etc/hostname", 0, 0);
  if (fd < 0) {
    PrintLn("FAIL: open(/etc/hostname)");
    return 1;
  }
  var r: int64 := Fstat(fd, statBuf);
  if (r == 0) {
    var sz: int64 := StatFileSize(statBuf);
    Print("OK: Fstat — Dateigröße = ");
    PrintLn(sz);
    if (sz <= 0) {
      PrintLn("FAIL: Dateigröße muss > 0 sein");
      close(fd); free(statBuf, STAT_SIZE); return 1;
    }
    if (StatIsFile(statBuf)) {
      PrintLn("OK: StatIsFile = true");
    } else {
      PrintLn("FAIL: StatIsFile soll true sein");
      close(fd); free(statBuf, STAT_SIZE); return 1;
    }
  } else {
    PrintLn("FAIL: Fstat");
    close(fd); free(statBuf, STAT_SIZE); return 1;
  }
  close(fd);
  free(statBuf, STAT_SIZE);

  // --- PRead ---
  var prbufMem: int64 := alloc(64);
  fd := open("/etc/hostname", 0, 0);
  if (fd < 0) { PrintLn("FAIL: open für PRead"); return 1; }
  var n: int64 := PRead(fd, prbufMem, 63, 0);
  close(fd);
  if (n > 0) {
    poke8(prbufMem + n - 1, 0);  // newline durch NUL ersetzen
    var prbufStr: pchar := prbufMem as pchar;
    Print("OK: PRead — /etc/hostname = ");
    PrintLn(prbufStr);
  } else {
    PrintLn("FAIL: PRead"); free(prbufMem, 64); return 1;
  }
  free(prbufMem, 64);

  // --- GetCwd ---
  var cwdMem: int64 := alloc(PATH_MAX);
  r := GetCwd(cwdMem, PATH_MAX);
  if (r > 0) {
    var cwdStr: pchar := cwdMem as pchar;
    Print("OK: GetCwd = ");
    PrintLn(cwdStr);
  } else {
    PrintLn("FAIL: GetCwd"); free(cwdMem, PATH_MAX); return 1;
  }
  free(cwdMem, PATH_MAX);

  // --- FileSize convenience ---
  var hostSz: int64 := FileSize("/etc/hostname");
  if (hostSz > 0) {
    Print("OK: FileSize(/etc/hostname) = ");
    PrintLn(hostSz);
  } else {
    PrintLn("FAIL: FileSize"); return 1;
  }

  // --- PWrite + PRead Roundtrip (O_RDWR|O_CREAT|O_TRUNC = 578) ---
  var tmpFd: int64 := open("/tmp/wp1_pwrite_test", 578, 420);
  if (tmpFd < 0) { PrintLn("FAIL: open /tmp/wp1_pwrite_test"); return 1; }
  var wbuf: int64 := alloc(8);
  poke8(wbuf + 0, 72); poke8(wbuf + 1, 101);
  poke8(wbuf + 2, 108); poke8(wbuf + 3, 108); poke8(wbuf + 4, 111); // "Hello"
  var pw: int64 := PWrite(tmpFd, wbuf, 5, 0);
  var rbuf2: int64 := alloc(8);
  var pr: int64 := PRead(tmpFd, rbuf2, 5, 0);
  close(tmpFd);
  if (pw == 5 && pr == 5) {
    poke8(rbuf2 + 5, 0);
    var rtStr: pchar := rbuf2 as pchar;
    Print("OK: PWrite+PRead roundtrip = ");
    PrintLn(rtStr);
  } else {
    Print("FAIL: PWrite="); Print(pw); Print(" PRead="); PrintLn(pr);
    free(wbuf, 8); free(rbuf2, 8); return 1;
  }
  free(wbuf, 8);
  free(rbuf2, 8);

  // --- Ftruncate ---
  tmpFd := open("/tmp/wp1_pwrite_test", 1, 0);
  if (tmpFd >= 0) {
    r := Ftruncate(tmpFd, 3);
    close(tmpFd);
    var newSz: int64 := FileSize("/tmp/wp1_pwrite_test");
    if (r == 0 && newSz == 3) {
      PrintLn("OK: Ftruncate auf 3 Bytes");
    } else {
      Print("FAIL: Ftruncate r="); Print(r);
      Print(" sz="); PrintLn(newSz); return 1;
    }
  }

  // --- WriteV ---
  var iov: int64 := alloc(IOVEC_SIZE * 2);
  var segA: int64 := alloc(4);
  var segB: int64 := alloc(4);
  poke8(segA + 0, 65); poke8(segA + 1, 66); poke8(segA + 2, 67); // "ABC"
  poke8(segB + 0, 88); poke8(segB + 1, 89); poke8(segB + 2, 90); // "XYZ"
  IovecSet(iov, 0, segA, 3);
  IovecSet(iov, 1, segB, 3);
  tmpFd := open("/tmp/wp1_writev_test", 65, 420);
  if (tmpFd >= 0) {
    var wv: int64 := WriteV(tmpFd, iov, 2);
    close(tmpFd);
    if (wv == 6) {
      PrintLn("OK: WriteV — 6 Bytes geschrieben");
    } else {
      Print("FAIL: WriteV = "); PrintLn(wv); return 1;
    }
  }
  free(iov, IOVEC_SIZE * 2);
  free(segA, 4);
  free(segB, 4);

  // --- Fsync ---
  tmpFd := open("/tmp/wp1_pwrite_test", 1, 0);
  if (tmpFd >= 0) {
    r := Fsync(tmpFd);
    close(tmpFd);
    if (r == 0) {
      PrintLn("OK: Fsync");
    } else {
      PrintLn("FAIL: Fsync"); return 1;
    }
  }

  PrintLn("=== WP-1: alle Tests bestanden ===");
  return 0;
}
