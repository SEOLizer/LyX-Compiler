// WP-11: Test für std/mqueue — POSIX Message Queues
import std.mqueue;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-11: mqueue — POSIX Message Queues ===");

  var qname: pchar := "/lyx_wp11_test";

  // Cleanup: Queue aus vorherigem Lauf löschen
  MqUnlink(qname);

  // --- Test 1: MqOpen (RDWR + CREATE + EXCL) ---
  var flags: int64 := MQ_OPEN_RDWR | MQ_OPEN_CREATE | MQ_OPEN_EXCL;
  var fd: int64 := MqOpen(qname, flags, 438);
  if (fd < 0) {
    Print("FAIL: MqOpen="); PrintLn(fd); return 1;
  }
  Print("OK: MqOpen(RDWR+CREATE) — fd="); PrintLn(fd);

  // --- Test 2: MqSend — 8-Byte-Nachricht ---
  var msgBuf: int64 := mmap(0, 32, 3, 34, -1, 0);
  poke64(msgBuf, 13375);   // Testwert
  var r: int64 := MqSend(fd, msgBuf, 8, 5);
  if (r != 0) {
    Print("FAIL: MqSend="); PrintLn(r);
    munmap(msgBuf, 32); MqClose(fd); MqUnlink(qname); return 1;
  }
  PrintLn("OK: MqSend — 8 Bytes mit prio=5 gesendet");

  // --- Test 3: MqGetCurMsgs — sollte 1 sein ---
  var cur: int64 := MqGetCurMsgs(fd);
  if (cur != 1) {
    Print("FAIL: MqGetCurMsgs="); PrintLn(cur);
    munmap(msgBuf, 32); MqClose(fd); MqUnlink(qname); return 1;
  }
  PrintLn("OK: MqGetCurMsgs=1");

  // --- Test 4: MqRecv — Inhalt prüfen ---
  var recvBuf: int64 := mmap(0, 8192, 3, 34, -1, 0);
  var n: int64 := MqRecv(fd, recvBuf, 8192, 0);
  if (n != 8) {
    Print("FAIL: MqRecv n="); PrintLn(n);
    munmap(recvBuf, 8192); munmap(msgBuf, 32);
    MqClose(fd); MqUnlink(qname); return 1;
  }
  Print("OK: MqRecv — "); Print(n); PrintLn(" Bytes empfangen");

  var got: int64 := peek64(recvBuf);
  if (got != 13375) {
    Print("FAIL: Nachrichteninhalt="); PrintLn(got);
    munmap(recvBuf, 8192); munmap(msgBuf, 32);
    MqClose(fd); MqUnlink(qname); return 1;
  }
  PrintLn("OK: Nachrichteninhalt korrekt (13375)");

  // --- Test 5: MqGetAttr ---
  var attrBuf: int64 := mmap(0, MQ_ATTR_SIZE, 3, 34, -1, 0);
  var ar: int64 := MqGetAttr(fd, attrBuf);
  if (ar != 0) {
    Print("FAIL: MqGetAttr="); PrintLn(ar);
    munmap(attrBuf, MQ_ATTR_SIZE); munmap(recvBuf, 8192); munmap(msgBuf, 32);
    MqClose(fd); MqUnlink(qname); return 1;
  }
  var maxmsg:  int64 := peek64(attrBuf + MQ_ATTR_MAXMSG);
  var msgsize: int64 := peek64(attrBuf + MQ_ATTR_MSGSIZE);
  if (maxmsg <= 0 || msgsize <= 0) {
    Print("FAIL: MqGetAttr ungültig maxmsg="); Print(maxmsg);
    Print(" msgsize="); PrintLn(msgsize);
    munmap(attrBuf, MQ_ATTR_SIZE); munmap(recvBuf, 8192); munmap(msgBuf, 32);
    MqClose(fd); MqUnlink(qname); return 1;
  }
  Print("OK: MqGetAttr — maxmsg="); Print(maxmsg);
  Print(" msgsize="); PrintLn(msgsize);
  munmap(attrBuf, MQ_ATTR_SIZE);

  // --- Test 6: MqGetMaxMsg ---
  var mm: int64 := MqGetMaxMsg(fd);
  if (mm != maxmsg) {
    Print("FAIL: MqGetMaxMsg="); PrintLn(mm);
    munmap(recvBuf, 8192); munmap(msgBuf, 32);
    MqClose(fd); MqUnlink(qname); return 1;
  }
  Print("OK: MqGetMaxMsg="); PrintLn(mm);

  // --- Test 7: MqClose + MqUnlink ---
  var cr: int64 := MqClose(fd);
  if (cr < 0) {
    Print("FAIL: MqClose="); PrintLn(cr);
    munmap(recvBuf, 8192); munmap(msgBuf, 32); MqUnlink(qname); return 1;
  }
  PrintLn("OK: MqClose");

  var ur: int64 := MqUnlink(qname);
  if (ur < 0) {
    Print("FAIL: MqUnlink="); PrintLn(ur);
    munmap(recvBuf, 8192); munmap(msgBuf, 32); return 1;
  }
  PrintLn("OK: MqUnlink");

  munmap(recvBuf, 8192);
  munmap(msgBuf, 32);

  PrintLn("=== WP-11: alle Tests bestanden ===");
  return 0;
}
