// WP-15: Test fuer std/security_ext -- prctl, capget, arch_prctl
import std.security_ext;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-15: security_ext -- prctl & Capabilities ===");

  // ============================================================
  // --- Teil 1: prctl Prozessname ---
  // ============================================================
  PrintLn("--- prctl: Prozessname ---");

  // Test 1: ProcessSetName
  var sr: int64 := ProcessSetName("lyx_wp15_test");
  if (sr < 0) {
    Print("FAIL: ProcessSetName="); PrintLn(sr); return 1;
  }
  PrintLn("OK: ProcessSetName('lyx_wp15_test')");

  // Test 2: ProcessGetName -- Rueckgabe muss mit 'l' beginnen (ASCII 108)
  var nameBuf: int64 := mmap(0, 16, 3, 34, -1, 0);
  var gr: int64 := ProcessGetName(nameBuf);
  if (gr < 0) {
    Print("FAIL: ProcessGetName="); PrintLn(gr);
    munmap(nameBuf, 16); return 1;
  }
  if (peek8(nameBuf) != 108) {   // 'l'
    Print("FAIL: Name beginnt nicht mit 'l', byte="); PrintLn(peek8(nameBuf));
    munmap(nameBuf, 16); return 1;
  }
  PrintLn("OK: ProcessGetName -- Name korrekt");
  munmap(nameBuf, 16);

  // ============================================================
  // --- Teil 2: prctl Dumpable ---
  // ============================================================
  PrintLn("--- prctl: Dumpable ---");

  // Test 3: GetDumpable -- sollte 1 sein (Standard)
  var d: int64 := ProcessGetDumpable();
  if (d < 0) {
    Print("FAIL: ProcessGetDumpable="); PrintLn(d); return 1;
  }
  Print("OK: ProcessGetDumpable="); PrintLn(d);

  // Test 4: SetDumpable(0) + verifizieren + wiederherstellen
  var dr: int64 := ProcessSetDumpable(0);
  if (dr < 0) {
    Print("FAIL: ProcessSetDumpable(0)="); PrintLn(dr); return 1;
  }
  var d2: int64 := ProcessGetDumpable();
  if (d2 != 0) {
    Print("FAIL: nach SetDumpable(0) GetDumpable="); PrintLn(d2); return 1;
  }
  PrintLn("OK: ProcessSetDumpable(0)");
  ProcessSetDumpable(d);   // Originalwert wiederherstellen
  PrintLn("OK: Dumpable wiederhergestellt");

  // ============================================================
  // --- Teil 3: prctl No-New-Privs ---
  // ============================================================
  PrintLn("--- prctl: NoNewPrivs ---");

  // Test 5: GetNoNewPrivs (vor dem Setzen)
  var nnp: int64 := ProcessGetNoNewPrivs();
  if (nnp < 0) {
    Print("FAIL: ProcessGetNoNewPrivs="); PrintLn(nnp); return 1;
  }
  Print("OK: ProcessGetNoNewPrivs="); PrintLn(nnp);

  // Test 6: SetNoNewPrivs (einweg -- gilt fuer restliche Laufzeit dieses Prozesses)
  var nr: int64 := ProcessSetNoNewPrivs();
  if (nr < 0) {
    Print("FAIL: ProcessSetNoNewPrivs="); PrintLn(nr); return 1;
  }
  var nnp2: int64 := ProcessGetNoNewPrivs();
  if (nnp2 != 1) {
    Print("FAIL: nach SetNoNewPrivs GetNoNewPrivs="); PrintLn(nnp2); return 1;
  }
  PrintLn("OK: ProcessSetNoNewPrivs -- gesetzt und verifiziert");

  // ============================================================
  // --- Teil 4: arch_prctl FS-Basis ---
  // ============================================================
  PrintLn("--- arch_prctl: FS-Basis ---");

  // Test 7: ArchGetFs -- Syscall muss erfolgreich sein (Wert kann 0 sein bei static ELF)
  var fsBuf: int64 := mmap(0, 8, 3, 34, -1, 0);
  var fsr: int64 := sys_arch_prctl(ARCH_GET_FS, fsBuf);
  if (fsr < 0) {
    Print("FAIL: arch_prctl(ARCH_GET_FS)="); PrintLn(fsr);
    munmap(fsBuf, 8); return 1;
  }
  var fs: int64 := peek64(fsBuf);
  munmap(fsBuf, 8);
  Print("OK: arch_prctl(ARCH_GET_FS)="); PrintLn(fs);

  // ============================================================
  // --- Teil 5: Capabilities ---
  // ============================================================
  PrintLn("--- Capabilities ---");

  // Test 8: CapGet -- Capabilities lesen
  var capBuf: int64 := mmap(0, CAP_BUF_SIZE, 3, 34, -1, 0);
  var cr: int64 := CapGet(capBuf);
  if (cr < 0) {
    Print("FAIL: CapGet="); PrintLn(cr);
    munmap(capBuf, CAP_BUF_SIZE); return 1;
  }
  var eff0: int64 := peek32(capBuf + CAP_EFF_0);
  var prm0: int64 := peek32(capBuf + CAP_PRM_0);
  Print("OK: CapGet -- effective[0]="); Print(eff0);
  Print(" permitted[0]="); PrintLn(prm0);

  // Test 9: CapIsSet (CAP_NET_RAW = 13) -- normaler User hat es nicht
  var isset: int64 := CapIsSet(CAP_NET_RAW);
  if (isset < 0) {
    Print("FAIL: CapIsSet="); PrintLn(isset);
    munmap(capBuf, CAP_BUF_SIZE); return 1;
  }
  Print("OK: CapIsSet(CAP_NET_RAW)="); PrintLn(isset);

  // Test 10: CapDrop -- CAP_NET_RAW fallen lassen (ist wahrscheinlich schon 0)
  var dropr: int64 := CapDrop(CAP_NET_RAW);
  if (dropr < 0) {
    Print("FAIL: CapDrop(CAP_NET_RAW)="); PrintLn(dropr);
    munmap(capBuf, CAP_BUF_SIZE); return 1;
  }
  PrintLn("OK: CapDrop(CAP_NET_RAW)");

  munmap(capBuf, CAP_BUF_SIZE);

  PrintLn("=== WP-15: alle Tests bestanden ===");
  return 0;
}
