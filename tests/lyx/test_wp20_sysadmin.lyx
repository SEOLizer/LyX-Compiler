// WP-20: Test fuer std/sysadmin -- mount, umount, chroot, sync, sethostname, reboot
import std.sysadmin;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-20: sysadmin -- System-Administration ===");

  // ============================================================
  // --- Test 1: SyncAll -- kein root erforderlich ---
  // ============================================================
  var sr: int64 := SyncAll();
  if (sr != 0) {
    Print("FAIL: SyncAll="); PrintLn(sr); return 1;
  }
  PrintLn("OK: SyncAll() = 0");

  // ============================================================
  // --- Test 2: Chroot -- erwartet EPERM ohne root ---
  // ============================================================
  var cr: int64 := Chroot("/");
  if (cr == 0) {
    PrintLn("OK: Chroot('/') = 0 (root-Prozess)");
  } else {
    if (cr == -1) {
      PrintLn("OK: Chroot('/') = -EPERM (erwartet ohne root)");
    } else {
      Print("FAIL: Chroot unerwarteter Fehler="); PrintLn(cr); return 1;
    }
  }

  // ============================================================
  // --- Test 3: SetHostname -- erwartet EPERM ohne root ---
  // ============================================================
  var hr: int64 := SetHostname("lyx_test", 8);
  if (hr == 0) {
    PrintLn("OK: SetHostname = 0 (root-Prozess)");
  } else {
    if (hr == -1) {
      PrintLn("OK: SetHostname = -EPERM (erwartet ohne root)");
    } else {
      Print("FAIL: SetHostname unerwarteter Fehler="); PrintLn(hr); return 1;
    }
  }

  // ============================================================
  // --- Test 4: Mount -- erwartet EPERM ohne root ---
  // ============================================================
  var mr: int64 := Mount("none", "/tmp", "tmpfs", MS_RDONLY);
  if (mr == 0) {
    PrintLn("OK: Mount = 0 (root-Prozess, bitte umount /tmp)");
    Umount("/tmp", MNT_DETACH);
  } else {
    if (mr == -1 || mr == -13) {
      PrintLn("OK: Mount = -EPERM/-EACCES (erwartet ohne root)");
    } else {
      Print("FAIL: Mount unerwarteter Fehler="); PrintLn(mr); return 1;
    }
  }

  // ============================================================
  // --- Test 5: Umount -- erwartet EPERM oder EINVAL ---
  // ============================================================
  var ur: int64 := Umount("/proc", MNT_DETACH);
  if (ur == 0) {
    PrintLn("OK: Umount = 0 (unerwartet, root-Prozess?)");
  } else {
    // -1=EPERM, -22=EINVAL, -16=EBUSY -- alles ausser ENOSYS erwartet
    if (ur == -1 || ur == -22 || ur == -16 || ur == -13) {
      Print("OK: Umount = "); Print(ur); PrintLn(" (EPERM/EINVAL/EBUSY erwartet)");
    } else {
      Print("FAIL: Umount unerwarteter Fehler="); PrintLn(ur); return 1;
    }
  }

  // ============================================================
  // --- Test 6: Reboot mit ungueltigem Kommando -- EINVAL oder EPERM ---
  // (kein tatsaechlicher Reboot: ungueltige magic -> EINVAL, keine caps -> EPERM)
  // ============================================================
  // sys_reboot(0, 0, 0, 0) -- ungueltige Magics -> EINVAL (kein Reboot)
  var rr: int64 := sys_reboot(0, 0, 0, 0);
  if (rr == -22) {
    PrintLn("OK: sys_reboot(bad magic) = -EINVAL (sicher, kein Reboot)");
  } else {
    if (rr == -1) {
      PrintLn("OK: sys_reboot = -EPERM (kein CAP_SYS_BOOT)");
    } else {
      Print("FAIL: sys_reboot unerwarteter Fehler="); PrintLn(rr); return 1;
    }
  }

  PrintLn("=== WP-20: alle Tests bestanden ===");
  return 0;
}
