  Print("=== Test 5: codegen locals ===\n");
  var s1: pchar := "fn sum(n: int64): int64 { var acc: int64 := 0; var i: int64 := 1; ";
  var s2: pchar := "while (i <= n) { acc := acc + i; i := i + 1; } return acc; } ";
  var s3: pchar := "fn main(): int64 { PrintInt(sum(10)); Print(\"\\n\"); return 0; }";
  var src: pchar := StrConcat(StrConcat(s1, s2), s3);
