// ============================================================================
// main
// ============================================================================

fn main(argc: int64, argv: pchar) {
  test1();
  test2();
  test3();
  test4();
  test5();
  Print("=== All codegen tests done ===\n");
  Print("Run with: chmod +x /tmp/test_cg_* && /tmp/test_cg_hello\n");
}
