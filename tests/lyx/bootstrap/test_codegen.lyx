// tests/lyx/bootstrap/test_codegen.lyx
// WP-08: Self-Hosted x86_64 Code Generator Test
//
// Strategy: parse a small Lyx program, run the codegen, write an ELF binary,
// then verify the binary was produced.

import src.parser;
import src.codegen_x86;
// #1153: kein `import std.alloc` — bootstrap.* bringt src.std.alloc mit,
// und beide exportieren alloc/free. Der Doppelimport machte die Namen
// mehrdeutig, und der Test uebersetzte gar nicht.

// ============================================================================
// Helper: print N chars from a pchar (length-delimited, no null needed)
// ============================================================================

fn PrintN(p: pchar, n: int64) {
  var buf: pchar := alloc(n + 1) as pchar;
  var addr: int64 := buf as int64;
  var i: int64 := 0;
  while (i < n) {
    poke8(addr + i, StrCharAt(p, i));
    i := i + 1;
  }
  poke8(addr + n, 0);
  Print(buf);
}

// ============================================================================
// Test 1: Emit an ELF that prints "hello" and returns 0
// ============================================================================

fn test1() {
  Print("=== Test 1: codegen hello world ===\n");
  var src: pchar :=
    "fn main(): int64 { Print(\"hello\\n\"); return 0; }";
  var p: Parser := new Parser();
  p.Init(src, StrLen(src));
  var head: int64 := p.Parse();
  Print("parse hadError="); PrintInt(p.hadError); Print("\n");
  Print("nodeCount=");      PrintInt(p.nodeCount); Print("\n");

  if (p.hadError == 0 && head >= 0) {
    var cg: Codegen := new Codegen();
    cg.Init(p.src, p.nodes, p.toks);
    cg.Generate(head);
    Print("codeLen="); PrintInt(cg.codeLen); Print("\n");
    Print("dataLen="); PrintInt(cg.dataLen); Print("\n");
    cg.WriteELF("/tmp/test_cg_hello");
    Print("wrote /tmp/test_cg_hello\n");
    dispose cg;
  }
  dispose p;
}

