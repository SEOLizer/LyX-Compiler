// ============================================================================
// Test 7: Parse expressions (binop, call, field access)
// ============================================================================

fn test7() {
  Print("=== Test 7: expressions ===\n");
  var src: pchar := "fn f(): int64 { var r: int64 := a + b * c; return foo(r, 1 + 2); }";
  var p: Parser := new Parser();
  p.Init(src, StrLen(src));
  var head: int64 := p.Parse();

  Print("hadError="); PrintInt(p.hadError); Print("\n");
  Print("nodeCount="); PrintInt(p.nodeCount); Print("\n");
  if (head >= 0) {
    var body: int64 := p.NChild2(head);
    var stmt0: int64 := p.NChild0(body);
    Print("stmt0="); Print(p.NodeKindStr(p.NKind(stmt0))); Print("\n");
    var stmt1: int64 := p.NNext(stmt0);
    Print("stmt1="); Print(p.NodeKindStr(p.NKind(stmt1))); Print("\n");
    var retExpr: int64 := p.NChild0(stmt1);
    Print("retExpr="); Print(p.NodeKindStr(p.NKind(retExpr))); Print("\n");
  }
  dispose p;
}

// ============================================================================
// Test 8: Parse enum + fn (stress test)
// ============================================================================

fn test8() {
  Print("=== Test 8: enum test source ===\n");
  var p1: pchar := "pub enum TokenKind { tkEof, tkIdent, tkInt }; ";
  var p2: pchar := "fn tokenName(k: int64): pchar { ";
  var p3: pchar := "  if (k == 0) { return \"EOF\"; } ";
  var p4: pchar := "  return \"?\"; }";
  var src: pchar := StrConcat(StrConcat(StrConcat(p1, p2), p3), p4);
  var p: Parser := new Parser();
  p.Init(src, StrLen(src));
  var head: int64 := p.Parse();

  Print("hadError="); PrintInt(p.hadError); Print("\n");
  Print("topDecls="); PrintInt(p.ListLen(head)); Print("\n");

  var cur: int64 := head;
  while (cur != -1) {
    Print("  "); Print(p.NodeKindStr(p.NKind(cur)));
    Print(" isPub="); PrintInt(p.NIsPub(cur));
    Print(" name="); PrintN(p.NSVal(cur), p.NSLen(cur));
    Print("\n");
    cur := p.NNext(cur);
  }
  dispose p;
}

// ============================================================================
// Test 9: Assignment statement
// ============================================================================

fn test9() {
  Print("=== Test 9: assignment ===\n");
  var src: pchar := "fn f() { var x: int64 := 0; x := x + 1; }";
  var p: Parser := new Parser();
  p.Init(src, StrLen(src));
  var head: int64 := p.Parse();

  Print("hadError="); PrintInt(p.hadError); Print("\n");
  if (head >= 0) {
    var body: int64 := p.NChild2(head);
    var s0: int64 := p.NChild0(body);
    var s1: int64 := p.NNext(s0);
    Print("s0="); Print(p.NodeKindStr(p.NKind(s0))); Print("\n");
    Print("s1="); Print(p.NodeKindStr(p.NKind(s1))); Print("\n");
  }
  dispose p;
}

