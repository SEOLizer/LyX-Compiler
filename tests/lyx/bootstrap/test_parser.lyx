// tests/lyx/bootstrap/test_parser.lyx
// WP-06: Self-Hosted Parser Test

import src.parser;
// #1153: kein `import std.alloc` — bootstrap.* bringt src.std.alloc mit,
// und beide exportieren alloc/free. Der Doppelimport machte die Namen
// mehrdeutig, und der Test uebersetzte gar nicht.

// ============================================================================
// Helper: print N chars from a pointer (no null terminator required)
// ============================================================================

fn PrintN(p: pchar, n: int64) {
  var buf: pchar := alloc(n + 1) as pchar;
  var addr: int64 := buf as int64;
  var i: int64 := 0;
  while (i < n) {
    poke8(addr + i, StrCharAt(p, i));
    i := i + 1;
  }
  poke8(addr + n, 0);
  Print(buf);
}

// ============================================================================
// Test 1: Parse a simple function declaration
// ============================================================================

fn test1() {
  Print("=== Test 1: fn decl ===\n");
  var src: pchar := "fn add(x: int64, y: int64): int64 { return x + y; }";
  var p: Parser := new Parser();
  p.Init(src, StrLen(src));
  Print("tokCount="); PrintInt(p.tokCount); Print("\n");
  Print("firstTokKind="); PrintInt(p.TokKind(0)); Print("\n");
  var head: int64 := p.Parse();

  Print("hadError="); PrintInt(p.hadError); Print("\n");
  Print("nodeCount="); PrintInt(p.nodeCount); Print("\n");
  Print("head="); PrintInt(head); Print("\n");
  Print("p.nodes="); PrintInt(p.nodes); Print("\n");
  Print("topDecls="); PrintInt(p.ListLen(head)); Print("\n");

  if (head >= 0) {
    Print("decl[0] kind="); Print(p.NodeKindStr(p.NKind(head))); Print("\n");
    Print("decl[0] name=");
    PrintN(p.NSVal(head), p.NSLen(head));
    Print("\n");
    var params: int64 := p.NChild0(head);
    Print("params="); PrintInt(p.ListLen(params)); Print("\n");
  }
  dispose p;
}

// ============================================================================
// Test 2: Parse var/con declarations
// ============================================================================

fn test2() {
  Print("=== Test 2: var/con decls ===\n");
  var src: pchar := "var x: int64 := 42; con MAX: int64 := 100; var msg: pchar := \"hello\";";
  var p: Parser := new Parser();
  p.Init(src, StrLen(src));
  var head: int64 := p.Parse();

  Print("hadError="); PrintInt(p.hadError); Print("\n");
  Print("topDecls="); PrintInt(p.ListLen(head)); Print("\n");

  var cur: int64 := head;
  while (cur != -1) {
    Print("  "); Print(p.NodeKindStr(p.NKind(cur)));
    Print(" name="); PrintN(p.NSVal(cur), p.NSLen(cur));
    Print("\n");
    cur := p.NNext(cur);
  }
  dispose p;
}

