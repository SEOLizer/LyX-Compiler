// WP-EN-07: Korrektheit des Loop-Unrollings für alle Energy-Level.
// Das Ergebnis muss für alle Level identisch sein (Unrolling ist reine Performance-Optimierung).

@energy(2)
fn sumLevel2(n: int64): int64 {
  var s: int64 := 0;
  var i: int64 := 0;
  while i < n { s := s + i; i := i + 1; }
  return s;
}

@energy(3)
fn sumLevel3(n: int64): int64 {
  var s: int64 := 0;
  var i: int64 := 0;
  while i < n { s := s + i; i := i + 1; }
  return s;
}

@energy(4)
fn sumLevel4(n: int64): int64 {
  var s: int64 := 0;
  var i: int64 := 0;
  while i < n { s := s + i; i := i + 1; }
  return s;
}

@energy(5)
fn sumLevel5(n: int64): int64 {
  var s: int64 := 0;
  var i: int64 := 0;
  while i < n { s := s + i; i := i + 1; }
  return s;
}

@energy(1)
fn sumLevel1(n: int64): int64 {
  var s: int64 := 0;
  var i: int64 := 0;
  while i < n { s := s + i; i := i + 1; }
  return s;
}

@energy(5)
fn forRangeSum(n: int64): int64 {
  var s: int64 := 0;
  for i := 0 to n - 1 { s := s + i; }
  return s;
}

@energy(4)
fn forCSum(n: int64): int64 {
  var s: int64 := 0;
  for i := 0; i < n; i := i + 1 { s := s + i; }
  return s;
}

@energy(5)
fn breakTest(n: int64): int64 {
  var s: int64 := 0;
  var i: int64 := 0;
  while i < n {
    if i == 5 { break; }
    s := s + i;
    i := i + 1;
  }
  return s;
}

@energy(5)
fn contTest(n: int64): int64 {
  var s: int64 := 0;
  var i: int64 := 0;
  while i < n {
    i := i + 1;
    if (i & 1) == 0 { continue; }
    s := s + i;
  }
  return s;
}

fn main(): int64 {
  var expected: int64 := 4950;

  if sumLevel1(100) != expected { write(2, "FAIL: level1\n"c as int64, 13); return 1; }
  if sumLevel2(100) != expected { write(2, "FAIL: level2\n"c as int64, 13); return 1; }
  if sumLevel3(100) != expected { write(2, "FAIL: level3\n"c as int64, 13); return 1; }
  if sumLevel4(100) != expected { write(2, "FAIL: level4\n"c as int64, 13); return 1; }
  if sumLevel5(100) != expected { write(2, "FAIL: level5\n"c as int64, 13); return 1; }

  // Edge cases: n = 0 and n = 1 (partial iterations)
  if sumLevel5(0) != 0 { write(2, "FAIL: level5 n=0\n"c as int64, 17); return 1; }
  if sumLevel5(1) != 0 { write(2, "FAIL: level5 n=1\n"c as int64, 17); return 1; }
  if sumLevel2(0) != 0 { write(2, "FAIL: level2 n=0\n"c as int64, 17); return 1; }
  if sumLevel2(3) != 3 { write(2, "FAIL: level2 n=3\n"c as int64, 17); return 1; }

  // for loop variants
  if forRangeSum(100) != expected { write(2, "FAIL: forRange\n"c as int64, 15); return 1; }
  if forCSum(100)     != expected { write(2, "FAIL: forC\n"c as int64,    11); return 1; }

  // break and continue with high unroll factor
  if breakTest(100) != 10 { write(2, "FAIL: break\n"c as int64, 12); return 1; }
  if contTest(10)   != 25 { write(2, "FAIL: cont\n"c as int64,  11); return 1; }

  write(1, "PASS\n"c as int64, 5);
  return 0;
}
