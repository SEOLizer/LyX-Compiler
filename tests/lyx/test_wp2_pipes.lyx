// WP-2: Test für std/pipe — Pipes & fd-Duplikation
import std.pipe;

pub fn main(argc: int64, argv: pchar): int64 {
  PrintLn("=== WP-2: Pipes & fd-Duplikation ===");

  // --- PipeCreate ---
  var rfdBuf: int64 := alloc(8);
  var wfdBuf: int64 := alloc(8);
  var r: int64 := PipeCreate(rfdBuf, wfdBuf);
  if (r != 0) {
    PrintLn("FAIL: PipeCreate"); return 1;
  }
  var rfd: int64 := peek64(rfdBuf);
  var wfd: int64 := peek64(wfdBuf);
  if (rfd <= 0 || wfd <= 0 || rfd == wfd) {
    Print("FAIL: ungültige fds rfd="); Print(rfd);
    Print(" wfd="); PrintLn(wfd); return 1;
  }
  Print("OK: PipeCreate — rfd="); Print(rfd);
  Print(" wfd="); PrintLn(wfd);

  // --- Write + Read durch Pipe ---
  var wbuf: int64 := alloc(8);
  poke8(wbuf + 0, 80); poke8(wbuf + 1, 73);
  poke8(wbuf + 2, 80); poke8(wbuf + 3, 69); // "PIPE"
  var written: int64 := write(wfd, wbuf, 4);
  var rbuf: int64 := alloc(8);
  var bytesRead: int64 := sys_read(rfd, rbuf, 4);
  if (written == 4 && bytesRead == 4) {
    poke8(rbuf + 4, 0);
    var s: pchar := rbuf as pchar;
    Print("OK: Pipe write/read = ");
    PrintLn(s);
  } else {
    Print("FAIL: written="); Print(written);
    Print(" read="); PrintLn(bytesRead); return 1;
  }
  free(wbuf, 8);
  free(rbuf, 8);

  // --- FdDup ---
  var dupFd: int64 := FdDup(wfd);
  if (dupFd <= 0 || dupFd == wfd) {
    Print("FAIL: FdDup dupFd="); PrintLn(dupFd); return 1;
  }
  Print("OK: FdDup — dupFd="); PrintLn(dupFd);
  // Schreiben über dupFd und Lesen über rfd
  var wb2: int64 := alloc(8);
  poke8(wb2 + 0, 68); poke8(wb2 + 1, 85); poke8(wb2 + 2, 80); // "DUP"
  write(dupFd, wb2, 3);
  var rb2: int64 := alloc(8);
  bytesRead := sys_read(rfd, rb2, 3);
  if (bytesRead == 3) {
    poke8(rb2 + 3, 0);
    var s2: pchar := rb2 as pchar;
    Print("OK: FdDup write/read = ");
    PrintLn(s2);
  } else {
    Print("FAIL: FdDup read bytesRead="); PrintLn(bytesRead); return 1;
  }
  free(wb2, 8);
  free(rb2, 8);
  close(dupFd);

  // --- FdDup2: wfd auf bekannte fd-Nummer duplizieren ---
  var targetFd: int64 := 50;
  var dup2Fd: int64 := FdDup2(wfd, targetFd);
  if (dup2Fd != targetFd) {
    Print("FAIL: FdDup2 erwartet "); Print(targetFd);
    Print(" bekam "); PrintLn(dup2Fd); return 1;
  }
  Print("OK: FdDup2 — fd="); PrintLn(dup2Fd);
  // Schreiben über dup2Fd
  var wb3: int64 := alloc(8);
  poke8(wb3 + 0, 68); poke8(wb3 + 1) := 50; poke8(wb3 + 2, 50); // "D22"
  poke8(wb3 + 0, 68); poke8(wb3 + 1, 50); poke8(wb3 + 2, 50);   // "D22"
  write(dup2Fd, wb3, 3);
  var rb3: int64 := alloc(8);
  bytesRead := sys_read(rfd, rb3, 3);
  if (bytesRead == 3) {
    PrintLn("OK: FdDup2 write/read bestätigt");
  } else {
    Print("FAIL: FdDup2 read="); PrintLn(bytesRead); return 1;
  }
  free(wb3, 8);
  free(rb3, 8);
  close(dup2Fd);

  // --- Pipe2 mit O_CLOEXEC ---
  var rfd2Buf: int64 := alloc(8);
  var wfd2Buf: int64 := alloc(8);
  r := Pipe2(rfd2Buf, wfd2Buf, O_CLOEXEC);
  if (r != 0) {
    PrintLn("FAIL: Pipe2(O_CLOEXEC)"); return 1;
  }
  var rfd2: int64 := peek64(rfd2Buf);
  var wfd2: int64 := peek64(wfd2Buf);
  Print("OK: Pipe2(O_CLOEXEC) — rfd="); Print(rfd2);
  Print(" wfd="); PrintLn(wfd2);
  close(rfd2); close(wfd2);
  free(rfd2Buf, 8); free(wfd2Buf, 8);

  // Aufräumen
  close(rfd); close(wfd);
  free(rfdBuf, 8); free(wfdBuf, 8);

  PrintLn("=== WP-2: alle Tests bestanden ===");
  return 0;
}
