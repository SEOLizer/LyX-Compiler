// WP-B2: .meta_safe Secure Post-Patching — Akzeptanztest
// Kompilieren mit: lyxc --meta-safe test_meta_safe.lyx -o test_meta_safe
// Akzeptanzkriterien:
//  1. MetaSafeVerify() = 0 bei unverändertem Binary
//  2. MetaSafeGetPageHash(0) > 0 (gültiger CRC32)
//  3. MetaSafeGetPageHash(-1) = -1 (ungültiger Index)
//  4. MetaSafeGetPageHash(9999) = -1 (out-of-range)

import std.meta_safe;

fn main(): int64 {
    var ok: int64 := 1;

    // T1: Unverändertes Binary → 0
    var r1: int64 := MetaSafeVerify();
    if r1 != 0 { Print("FAIL T1: expected 0\n"); ok := 0; }

    // T2: PageHash[0] muss positiver CRC32-Wert sein
    var h0: int64 := MetaSafeGetPageHash(0);
    if h0 <= 0 { Print("FAIL T2: invalid hash\n"); ok := 0; }

    // T3: Ungültiger negativer Index → -1
    var hm: int64 := MetaSafeGetPageHash(-1);
    if hm != -1 { Print("FAIL T3: expected -1\n"); ok := 0; }

    // T4: Out-of-range Index → -1
    var hb: int64 := MetaSafeGetPageHash(9999);
    if hb != -1 { Print("FAIL T4: expected -1\n"); ok := 0; }

    if ok != 0 {
        Print("PASS: .meta_safe (WP-B2)\n");
    }
    return 0;
}
