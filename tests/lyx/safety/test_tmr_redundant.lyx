// WP-B1: @redundant — Triple Modular Redundancy
// Akzeptanzkriterien:
//  1. @redundant var belegt 24 Bytes (3 Slots)
//  2. poke64(addr+8, corrupt) → Lesezugriff gibt Originalwert zurück und heilt Kopie
//  3. Alle 3 Einzelkorrumpierungen (A, B, C) werden durch Majority-Vote korrigiert
//  4. Assignment schreibt alle 3 Kopien

fn main(): int64 {
    @redundant var x: int64 := 5;
    var ok: int64 := 1;

    // T1: Initialer Lesezugriff
    var v1: int64 := x;
    if v1 != 5 { Print("FAIL T1: init\n"); ok := 0; }

    // Adresse von Slot A (lowest addr; @x gibt &A zurück; B=&A+8, C=&A+16)
    var addr: int64 := @x;

    // T2: Korrumpiere Slot B (addr+8) — Majority durch A und C
    poke64(addr + 8, 0xDEAD);
    var v2: int64 := x;
    if v2 != 5 { Print("FAIL T2: B corrupt\n"); ok := 0; }

    // T3: Korrumpiere Slot A (addr) — B wurde in T2 geheilt
    poke64(addr, 0xBEEF);
    var v3: int64 := x;
    if v3 != 5 { Print("FAIL T3: A corrupt\n"); ok := 0; }

    // T4: Korrumpiere Slot C (addr+16) — A wurde in T3 geheilt
    poke64(addr + 16, 0xCAFE);
    var v4: int64 := x;
    if v4 != 5 { Print("FAIL T4: C corrupt\n"); ok := 0; }

    // T5: Assignment setzt alle 3 Kopien
    x := 42;
    var v5: int64 := x;
    if v5 != 42 { Print("FAIL T5: assign\n"); ok := 0; }

    // T6: Nach Assignment: Einzelkorrumpierung immer noch heilbar
    poke64(@x + 8, 0xDEAD);
    var v6: int64 := x;
    if v6 != 42 { Print("FAIL T6: post-assign corrupt\n"); ok := 0; }

    if ok != 0 {
        Print("PASS: @redundant TMR (WP-B1)\n");
    }
    return 0;
}
