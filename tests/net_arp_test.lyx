// tests/net_arp_test.lyx — ARP Unit Tests (45 tests)
unit tests.net_arp_test;

import std.net.arp;
import std.alloc;
import std.io;

fn pass(n: int64) { Print("PASS "); PrintLn(n); }
fn fail(n: int64) { Print("FAIL "); PrintLn(n); }
fn check(n: int64, ok: int64) { if (ok == 1) { pass(n); } else { fail(n); } }

// Build a synthetic ARP frame into buf (42 bytes zeroed).
// op: 1=REQUEST, 2=REPLY
// srcMac/dstMac: pointer to 6-byte arrays
// srcIP/dstIP: packed IPv4 (big-endian in wire order)
fn buildFrame(buf: int64, op: int64, srcMac: int64, srcIP: int64, dstMac: int64, dstIP: int64) {
    var i: int64 := 0;
    while (i < 42) { poke8(buf + i, 0); i := i + 1; }
    // Ethernet header
    i := 0;
    while (i < 6) { poke8(buf + i,     peek8(dstMac + i)); i := i + 1; }
    i := 0;
    while (i < 6) { poke8(buf + 6 + i, peek8(srcMac + i)); i := i + 1; }
    poke8(buf + 12, 8);  // EtherType 0x0806
    poke8(buf + 13, 6);
    // ARP payload
    poke8(buf + 14, 0); poke8(buf + 15, 1);  // hrd = Ethernet
    poke8(buf + 16, 8); poke8(buf + 17, 0);  // pro = IPv4
    poke8(buf + 18, 6);  // hlen
    poke8(buf + 19, 4);  // plen
    poke8(buf + 20, 0); poke8(buf + 21, op); // op
    i := 0;
    while (i < 6) { poke8(buf + 22 + i, peek8(srcMac + i)); i := i + 1; }
    poke8(buf + 28, (srcIP >> 24) & 255);
    poke8(buf + 29, (srcIP >> 16) & 255);
    poke8(buf + 30, (srcIP >> 8)  & 255);
    poke8(buf + 31, srcIP & 255);
    i := 0;
    while (i < 6) { poke8(buf + 32 + i, peek8(dstMac + i)); i := i + 1; }
    poke8(buf + 38, (dstIP >> 24) & 255);
    poke8(buf + 39, (dstIP >> 16) & 255);
    poke8(buf + 40, (dstIP >> 8)  & 255);
    poke8(buf + 41, dstIP & 255);
}

fn main() {
    // ── Tests 1-9: Constants ─────────────────────────────────────────────────────

    check(1,  ARP_FRAME_SIZE == 42);
    check(2,  ARP_ETH_DST    == 0);
    check(3,  ARP_ETH_SRC    == 6);
    check(4,  ARP_ETH_TYPE   == 12);
    check(5,  ARP_SIP        == 28);
    check(6,  ARP_TIP        == 38);
    check(7,  ARP_SHA        == 22);
    check(8,  ARP_OP_REQUEST == 1);
    check(9,  ARP_OP_REPLY   == 2);

    // ── Tests 10-27: ArpBuildRequest ────────────────────────────────────────────

    var mac1: int64 := alloc(6);
    poke8(mac1, 0xAA); poke8(mac1+1, 0xBB); poke8(mac1+2, 0xCC);
    poke8(mac1+3, 0xDD); poke8(mac1+4, 0xEE); poke8(mac1+5, 0xFF);

    var srcIP: int64 := (192 << 24) | (168 << 16) | (1 << 8) | 10;  // 192.168.1.10
    var dstIP: int64 := (192 << 24) | (168 << 16) | (1 << 8) | 1;   // 192.168.1.1

    var buf: int64 := alloc(42);
    var ret: int64 := ArpBuildRequest(buf, mac1, srcIP, dstIP);

    check(10, ret == 42);
    // Ethernet dst = broadcast ff:ff:ff:ff:ff:ff
    check(11, peek8(buf + 0) == 255);
    check(12, peek8(buf + 1) == 255);
    check(13, peek8(buf + 5) == 255);
    // Ethernet src = srcMac
    check(14, peek8(buf + 6)  == 0xAA);
    check(15, peek8(buf + 11) == 0xFF);
    // EtherType = 0x0806
    check(16, peek8(buf + 12) == 8);
    check(17, peek8(buf + 13) == 6);
    // HRD = 0x0001 big-endian
    check(18, peek8(buf + 14) == 0);
    check(19, peek8(buf + 15) == 1);
    // PRO = 0x0800 big-endian
    check(20, peek8(buf + 16) == 8);
    check(21, peek8(buf + 17) == 0);
    // hlen=6, plen=4
    check(22, peek8(buf + 18) == 6);
    check(23, peek8(buf + 19) == 4);
    // OP = 0x0001 (REQUEST) big-endian
    check(24, peek8(buf + 20) == 0);
    check(25, peek8(buf + 21) == 1);
    // SHA = srcMac
    check(26, peek8(buf + 22) == 0xAA);
    // SIP = srcIP big-endian
    check(27, peek8(buf + 28) == 192);

    // ── Tests 28-36: ArpBuildReply ──────────────────────────────────────────────

    var mac2: int64 := alloc(6);
    poke8(mac2, 0x11); poke8(mac2+1, 0x22); poke8(mac2+2, 0x33);
    poke8(mac2+3, 0x44); poke8(mac2+4, 0x55); poke8(mac2+5, 0x66);

    ret := ArpBuildReply(buf, mac1, srcIP, mac2, dstIP);

    check(28, ret == 42);
    // Ethernet dst = dstMac (mac2)
    check(29, peek8(buf + 0) == 0x11);
    check(30, peek8(buf + 5) == 0x66);
    // Ethernet src = srcMac (mac1)
    check(31, peek8(buf + 6) == 0xAA);
    // OP = 0x0002 (REPLY) big-endian
    check(32, peek8(buf + 20) == 0);
    check(33, peek8(buf + 21) == 2);
    // SHA = srcMac (mac1)
    check(34, peek8(buf + 22) == 0xAA);
    // THA = dstMac (mac2)
    check(35, peek8(buf + 32) == 0x11);
    // TIP = dstIP big-endian
    check(36, peek8(buf + 38) == 192);

    // ── Tests 37-45: ArpParse ───────────────────────────────────────────────────

    var frame: int64 := alloc(42);
    var result: int64 := alloc(ARP_RESULT_SIZE);

    // Test 37: short frame → OK=0
    var i2: int64 := 0;
    while (i2 < ARP_RESULT_SIZE) { poke8(result + i2, 0); i2 := i2 + 1; }
    ArpParse(frame, 20, result);
    check(37, peek8(result + ARP_RESULT_OK) == 0);

    // Test 38: wrong EtherType → OK=0
    buildFrame(frame, ARP_OP_REPLY, mac1, srcIP, mac2, dstIP);
    poke8(frame + 12, 8);
    poke8(frame + 13, 0);  // 0x0800 = IPv4, not ARP
    i2 := 0;
    while (i2 < ARP_RESULT_SIZE) { poke8(result + i2, 0); i2 := i2 + 1; }
    ArpParse(frame, 42, result);
    check(38, peek8(result + ARP_RESULT_OK) == 0);

    // Test 39: wrong hlen → OK=0
    buildFrame(frame, ARP_OP_REPLY, mac1, srcIP, mac2, dstIP);
    poke8(frame + 18, 4);  // hlen=4 instead of 6
    i2 := 0;
    while (i2 < ARP_RESULT_SIZE) { poke8(result + i2, 0); i2 := i2 + 1; }
    ArpParse(frame, 42, result);
    check(39, peek8(result + ARP_RESULT_OK) == 0);

    // Test 40: valid REPLY → OK=1
    buildFrame(frame, ARP_OP_REPLY, mac1, srcIP, mac2, dstIP);
    i2 := 0;
    while (i2 < ARP_RESULT_SIZE) { poke8(result + i2, 0); i2 := i2 + 1; }
    ArpParse(frame, 42, result);
    check(40, peek8(result + ARP_RESULT_OK) == 1);

    // Test 41: SENDER_IP parsed correctly (srcIP = 192.168.1.10)
    var senderIP: int64 := peek64(result + ARP_RESULT_SENDER_IP);
    check(41, senderIP == srcIP);

    // Test 42: TARGET_IP parsed correctly (dstIP = 192.168.1.1)
    var targetIP: int64 := peek64(result + ARP_RESULT_TARGET_IP);
    check(42, targetIP == dstIP);

    // Test 43: SENDER_MAC parsed correctly (first byte = 0xAA from mac1)
    check(43, peek8(result + ARP_RESULT_SENDER_MAC) == 0xAA);

    // Test 44: TARGET_MAC parsed correctly (first byte = 0x11 from mac2)
    check(44, peek8(result + ARP_RESULT_TARGET_MAC) == 0x11);

    // Test 45: OP parsed correctly (ARP_OP_REPLY = 2)
    var op: int64 := peek64(result + ARP_RESULT_OP);
    check(45, op == ARP_OP_REPLY);

    free(mac1, 6);
    free(mac2, 6);
    free(buf, 42);
    free(frame, 42);
    free(result, ARP_RESULT_SIZE);
}
