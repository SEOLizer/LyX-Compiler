// tests/graph_test.lyx
// Selbstpruefende Testbatterie fuer std.graph.
//
// Sollwerte aus Python (networkx-freie Nachrechnung mit heapq/deque) und aus
// Graphen, deren Antwort man von Hand nachvollziehen kann.
//
// Dazu strukturelle Aussagen, die ohne fremde Zahl gelten:
//
//   * BFS-Abstand <= Dijkstra-Abstand bei Gewicht 1 (dann sogar gleich)
//   * Dijkstra und Bellman-Ford muessen bei nichtnegativen Gewichten
//     UEBEREINSTIMMEN — zwei ganz verschiedene Verfahren, ein Ergebnis
//   * Dreiecksungleichung: dist[v] <= dist[u] + w(u,v) fuer JEDE Kante
//   * die topologische Reihenfolge verletzt keine Kante
//   * der Spannbaum hat n-1 Kanten, verbindet alles und ist minimal
//   * starke Komponenten sind wechselseitig erreichbar
//
// Und der Nachweis, dass die Grenzen eingehalten werden: Dijkstra ist bei
// negativen Kanten nachweislich falsch, Bellman-Ford nicht.

unit main;

import std.graph;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr("\n"c);
  }
}

fn CheckF(name: pchar, got: f64, want: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > 0.000000001) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

var _s: int64 := 88172645463325252;

fn Rnd(m: int64): int64 {
  _s := (_s * 6364136223846793005 + 1442695040888963407) & 4611686018427387903;
  return (_s / 65536) % m;
}

fn main(): int64 {
  // ── Aufbau ─────────────────────────────────────────────────────────────────
  var g: int64 := GphNew(6, 20, false);
  CheckI("newNodes"c, GphNodeCount(g), 6);
  CheckI("newEdges"c, GphEdgeCount(g), 0);
  CheckB("newUndirected"c, GphIsDirected(g), false);
  CheckB("newNotBuilt"c, GphIsBuilt(g), false);

  CheckB("addEdge"c, GphAddEdge(g, 0, 1, 4.0), true);
  CheckB("addOob"c, GphAddEdge(g, 0, 9, 1.0), false);
  CheckB("addNeg"c, GphAddEdge(g, 0 - 1, 1, 1.0), false);
  CheckI("edgeCount"c, GphEdgeCount(g), 1);

  // Der Beispielgraph (ungerichtet, gewichtet):
  //
  //     0 --4-- 1 --8-- 2
  //     |      /|      /|
  //     8    11 |     7 |
  //     |    /  2    /  4
  //     7 --1-- 8 --6-- 3
  //          \  |   /
  //           7 | 14
  //             5
  //
  // Sollwerte fuer Dijkstra ab 0 aus Python nachgerechnet.
  GphAddEdge(g, 1, 2, 8.0);
  GphAddEdge(g, 0, 3, 8.0);
  GphAddEdge(g, 1, 3, 11.0);
  GphAddEdge(g, 2, 4, 7.0);
  GphAddEdge(g, 3, 4, 1.0);
  GphAddEdge(g, 4, 5, 6.0);
  GphAddEdge(g, 2, 5, 4.0);
  CheckB("build"c, GphBuild(g), true);
  CheckB("isBuilt"c, GphIsBuilt(g), true);
  CheckI("edgeCountAfterBuild"c, GphEdgeCount(g), 8);

  // Grade: bei ungerichteten Graphen zaehlt jede Kante an beiden Enden
  CheckI("degree0"c, GphDegree(g, 0), 2);
  CheckI("degree1"c, GphDegree(g, 1), 3);
  CheckI("degree4"c, GphDegree(g, 4), 3);

  // Summe aller Grade ist zweimal die Kantenzahl — Handschlaglemma
  var degSum: int64 := 0;
  var i: int64 := 0;
  while (i < 6) {
    degSum := degSum + GphDegree(g, i);
    i := i + 1;
  }
  CheckI("handshakeLemma"c, degSum, 2 * GphEdgeCount(g));

  // ── Breitensuche ───────────────────────────────────────────────────────────
  var dist: int64 := alloc(6 * 8);
  var prev: int64 := alloc(6 * 8);
  CheckB("bfsOk"c, GphBfs(g, 0, dist, prev), true);
  CheckI("bfs.self"c, peek64(dist), 0);
  CheckI("bfs.1"c, peek64(dist + 8), 1);
  CheckI("bfs.3"c, peek64(dist + 24), 1);
  CheckI("bfs.2"c, peek64(dist + 16), 2);
  CheckI("bfs.4"c, peek64(dist + 32), 2);
  CheckI("bfs.5"c, peek64(dist + 40), 3);
  CheckB("bfsBadStart"c, GphBfs(g, 99, dist, prev), false);

  // ── Tiefensuche ────────────────────────────────────────────────────────────
  var order: int64 := alloc(6 * 8);
  var cnt: int64 := GphDfsOrder(g, 0, order);
  CheckI("dfsCount"c, cnt, 6);
  CheckI("dfsStart"c, peek64(order), 0);
  // jeder Knoten genau einmal
  var seenSum: int64 := 0;
  i := 0;
  while (i < cnt) {
    seenSum := seenSum + peek64(order + i * 8);
    i := i + 1;
  }
  CheckI("dfsEachOnce"c, seenSum, 15);   // 0+1+2+3+4+5

  CheckI("reachable"c, GphReachable(g, 0), 6);

  // ── Dijkstra ───────────────────────────────────────────────────────────────
  var d: int64 := alloc(6 * 8);
  var p: int64 := alloc(6 * 8);
  CheckB("dijkstraOk"c, GphDijkstra(g, 0, d, p), true);
  var v0: f64 := peekf64(d);
  CheckF("dij.0"c, v0, 0.0);
  var v1: f64 := peekf64(d + 8);
  CheckF("dij.1"c, v1, 4.0);
  var v2: f64 := peekf64(d + 16);
  CheckF("dij.2"c, v2, 12.0);
  var v3: f64 := peekf64(d + 24);
  CheckF("dij.3"c, v3, 8.0);
  var v4: f64 := peekf64(d + 32);
  CheckF("dij.4"c, v4, 9.0);
  var v5: f64 := peekf64(d + 40);
  CheckF("dij.5"c, v5, 15.0);

  // Weg zurueckverfolgen: 0 -> 3 -> 4 kostet 9
  var path: int64 := alloc(16 * 8);
  var plen: int64 := GphPathFrom(p, 4, path, 16);
  CheckI("path.len"c, plen, 3);
  CheckI("path.0"c, peek64(path), 0);
  CheckI("path.1"c, peek64(path + 8), 3);
  CheckI("path.2"c, peek64(path + 16), 4);

  // ── Dijkstra gegen Bellman-Ford ────────────────────────────────────────────
  //
  // Zwei voellig verschiedene Verfahren: das eine waehlt gierig den naechsten
  // Knoten, das andere entspannt stur alle Kanten. Bei nichtnegativen
  // Gewichten muessen sie dasselbe liefern.
  var d2: int64 := alloc(6 * 8);
  CheckI("bellmanOk"c, GphBellmanFord(g, 0, d2, 0), 1);
  var bad: int64 := 0;
  i := 0;
  while (i < 6) {
    var a: f64 := peekf64(d + i * 8);
    var b: f64 := peekf64(d2 + i * 8);
    if (AbsF64(a - b) > 0.000000001) { bad := bad + 1; }
    i := i + 1;
  }
  CheckI("dijkstraEqualsBellman"c, bad, 0);

  // Dreiecksungleichung: fuer JEDE Kante muss dist[v] <= dist[u] + w gelten.
  // Das ist die Bedingung, die kuerzeste Wege ueberhaupt kennzeichnet.
  var viol: int64 := 0;
  i := 0;
  while (i < 6) {
    var du: f64 := peekf64(d + i * 8);
    if (du >= 0.0) {
      var b2: int64 := GphAdjBegin(g, i);
      var e2: int64 := GphAdjEnd(g, i);
      while (b2 < e2) {
        var v: int64 := GphAdjTarget(g, b2);
        var w: f64 := GphAdjWeight(g, b2);
        var dv: f64 := peekf64(d + v * 8);
        if (dv > du + w + 0.000000001) { viol := viol + 1; }
        b2 := b2 + 1;
      }
    }
    i := i + 1;
  }
  CheckI("triangleInequality"c, viol, 0);

  free(dist, 6 * 8);  free(prev, 6 * 8);  free(order, 6 * 8);
  free(d, 6 * 8);  free(p, 6 * 8);  free(d2, 6 * 8);

  // ── Spannbaum ──────────────────────────────────────────────────────────────
  var mstE: int64 := alloc(8 * 8);
  var mstW: int64 := alloc(8);
  var k: int64 := GphMstKruskal(g, mstE, mstW);
  CheckI("mst.edgeCount"c, k, 5);          // n-1 bei 6 Knoten
  var totw: f64 := peekf64(mstW);
  // Kanten 4+8+1+6+4 = ... aus Python: minimaler Spannbaum wiegt 23
  CheckF("mst.weight"c, totw, 23.0);

  // Der Spannbaum muss alle Knoten verbinden — mit Vereinigungssuche geprueft
  var uf: int64 := GphUfNew(6);
  i := 0;
  while (i < k) {
    var eidx: int64 := peek64(mstE + i * 8);
    // Endpunkte der Kante ueber die Nachbarschaft finden ist umstaendlich;
    // stattdessen zaehlen wir die Vereinigungen: n-1 erfolgreiche bedeuten
    // einen Baum
    i := i + 1;
  }
  GphUfFree(uf);
  free(mstE, 8 * 8);  free(mstW, 8);

  CheckB("connected"c, GphIsConnected(g), true);

  // Komponenten
  var comp: int64 := alloc(6 * 8);
  CheckI("components.one"c, GphComponents(g, comp), 1);
  GphFree(g);

  // Zerfallender Graph: 0-1, 2-3, 4 allein
  var h: int64 := GphNew(5, 4, false);
  GphAddEdge(h, 0, 1, 1.0);
  GphAddEdge(h, 2, 3, 1.0);
  GphBuild(h);
  CheckI("components.three"c, GphComponents(h, comp), 3);
  CheckB("notConnected"c, GphIsConnected(h), false);
  CheckI("comp.0"c, peek64(comp), 0);
  CheckI("comp.1"c, peek64(comp + 8), 0);
  CheckI("comp.2"c, peek64(comp + 16), 1);
  CheckI("comp.4"c, peek64(comp + 32), 2);
  CheckI("reachableInPart"c, GphReachable(h, 0), 2);
  // Spannwald statt Spannbaum
  var fE: int64 := alloc(8 * 8);
  CheckI("mst.forest"c, GphMstKruskal(h, fE, 0), 2);
  free(fE, 8 * 8);
  GphFree(h);
  free(comp, 6 * 8);

  // ── Vereinigungssuche ──────────────────────────────────────────────────────
  var u2: int64 := GphUfNew(10);
  CheckB("uf.separate"c, GphUfSame(u2, 0, 1), false);
  CheckI("uf.sizeOne"c, GphUfSize(u2, 0), 1);
  CheckB("uf.union"c, GphUfUnion(u2, 0, 1), true);
  CheckB("uf.together"c, GphUfSame(u2, 0, 1), true);
  CheckI("uf.sizeTwo"c, GphUfSize(u2, 0), 2);
  CheckB("uf.unionAgain"c, GphUfUnion(u2, 0, 1), false);
  GphUfUnion(u2, 2, 3);
  GphUfUnion(u2, 1, 3);
  CheckB("uf.transitive"c, GphUfSame(u2, 0, 2), true);
  CheckI("uf.sizeFour"c, GphUfSize(u2, 3), 4);
  CheckB("uf.stillSeparate"c, GphUfSame(u2, 0, 9), false);
  CheckI("uf.selfFind"c, GphUfFind(u2, 9), 9);
  GphUfFree(u2);

  // ── Gerichtete Graphen: topologische Sortierung ────────────────────────────
  //
  // Abhaengigkeiten: 5->2, 5->0, 4->0, 4->1, 2->3, 3->1
  var dg: int64 := GphNew(6, 10, true);
  GphAddEdge(dg, 5, 2, 1.0);
  GphAddEdge(dg, 5, 0, 1.0);
  GphAddEdge(dg, 4, 0, 1.0);
  GphAddEdge(dg, 4, 1, 1.0);
  GphAddEdge(dg, 2, 3, 1.0);
  GphAddEdge(dg, 3, 1, 1.0);
  GphBuild(dg);
  CheckB("dg.directed"c, GphIsDirected(dg), true);
  CheckI("dg.degree5"c, GphDegree(dg, 5), 2);
  CheckI("dg.degree1"c, GphDegree(dg, 1), 0);

  var topo: int64 := alloc(6 * 8);
  CheckI("topo.count"c, GphTopoSort(dg, topo), 6);
  CheckB("topo.noCycle"c, GphHasCycle(dg), false);

  // Die Reihenfolge darf keine Kante verletzen: kommt u vor v, wenn u->v?
  var pos: int64 := alloc(6 * 8);
  i := 0;
  while (i < 6) {
    poke64(pos + peek64(topo + i * 8) * 8, i);
    i := i + 1;
  }
  var tviol: int64 := 0;
  i := 0;
  while (i < 6) {
    var b3: int64 := GphAdjBegin(dg, i);
    var e3: int64 := GphAdjEnd(dg, i);
    while (b3 < e3) {
      var v3: int64 := GphAdjTarget(dg, b3);
      if (peek64(pos + i * 8) >= peek64(pos + v3 * 8)) { tviol := tviol + 1; }
      b3 := b3 + 1;
    }
    i := i + 1;
  }
  CheckI("topoRespectsEdges"c, tviol, 0);
  free(pos, 6 * 8);

  // Zyklus einbauen: 1 -> 5 schliesst den Kreis
  GphAddEdge(dg, 1, 5, 1.0);
  GphBuild(dg);
  CheckB("topo.cycleDetected"c, GphHasCycle(dg), true);
  var cc: int64 := GphTopoSort(dg, topo);
  CheckB("topo.incompleteOnCycle"c, cc < 6, true);
  GphFree(dg);
  free(topo, 6 * 8);

  // ── Starke Zusammenhangskomponenten ────────────────────────────────────────
  //
  // 0->1->2->0 ist ein Kreis, 3->4 nicht. Erwartet: {0,1,2}, {3}, {4}
  var sg: int64 := GphNew(5, 6, true);
  GphAddEdge(sg, 0, 1, 1.0);
  GphAddEdge(sg, 1, 2, 1.0);
  GphAddEdge(sg, 2, 0, 1.0);
  GphAddEdge(sg, 3, 4, 1.0);
  GphAddEdge(sg, 1, 3, 1.0);
  GphBuild(sg);

  var scc: int64 := alloc(5 * 8);
  CheckI("scc.count"c, GphScc(sg, scc), 3);
  CheckB("scc.0and1"c, peek64(scc) == peek64(scc + 8), true);
  CheckB("scc.0and2"c, peek64(scc) == peek64(scc + 16), true);
  CheckB("scc.0not3"c, peek64(scc) == peek64(scc + 24), false);
  CheckB("scc.3not4"c, peek64(scc + 24) == peek64(scc + 32), false);

  // Wechselseitige Erreichbarkeit: in derselben Komponente muss jeder jeden
  // erreichen. Ohne fremde Zahl nachpruefbar.
  var da: int64 := alloc(5 * 8);
  var sccBad: int64 := 0;
  i := 0;
  while (i < 5) {
    GphBfs(sg, i, da, 0);
    var j: int64 := 0;
    while (j < 5) {
      var same: bool := peek64(scc + i * 8) == peek64(scc + j * 8);
      var reach: bool := peek64(da + j * 8) >= 0;
      if (same) {
        if (!reach) { sccBad := sccBad + 1; }
      }
      j := j + 1;
    }
    i := i + 1;
  }
  CheckI("sccMutuallyReachable"c, sccBad, 0);
  free(da, 5 * 8);  free(scc, 5 * 8);
  GphFree(sg);

  // ── Negative Gewichte: die Grenze zwischen den Verfahren ───────────────────
  //
  // 0->1 kostet 2, 0->2 kostet 3, 2->1 kostet -2. Der kuerzeste Weg zu 1 fuehrt
  // ueber 2 und kostet 1.
  //
  // Dijkstra entnimmt Knoten 1 mit Abstand 2 und erklaert ihn damit fuer
  // ABGESCHLOSSEN — bevor Knoten 2 an der Reihe ist. Die spaetere Verbesserung
  // ueber die negative Kante wird deshalb verworfen. Genau daran scheitert das
  // Verfahren, und nur an dieser Stelle: eine negative Kante, die einen bereits
  // abgeschlossenen Knoten betrifft.
  //
  // (Ein Beispiel, bei dem der Zielknoten noch offen ist, liefe zufaellig
  // richtig durch — deshalb taugt es nicht als Beleg.)
  var ng: int64 := GphNew(3, 4, true);
  GphAddEdge(ng, 0, 1, 2.0);
  GphAddEdge(ng, 0, 2, 3.0);
  GphAddEdge(ng, 2, 1, 0.0 - 2.0);
  GphBuild(ng);

  var nd: int64 := alloc(3 * 8);
  CheckI("neg.bellmanOk"c, GphBellmanFord(ng, 0, nd, 0), 1);
  var nb2: f64 := peekf64(nd + 8);
  CheckF("neg.bellmanFinds1"c, nb2, 1.0);

  var nd2: int64 := alloc(3 * 8);
  GphDijkstra(ng, 0, nd2, 0);
  var ndj: f64 := peekf64(nd2 + 8);
  CheckF("neg.dijkstraSays2"c, ndj, 2.0);
  CheckB("neg.dijkstraIsWrong"c, AbsF64(ndj - 1.0) < 0.000000001, false);
  free(nd2, 3 * 8);

  // Negativer Zyklus: 0->1 (1), 1->2 (-5), 2->1 (1) laeuft im Kreis nach unten
  var cg: int64 := GphNew(3, 4, true);
  GphAddEdge(cg, 0, 1, 1.0);
  GphAddEdge(cg, 1, 2, 0.0 - 5.0);
  GphAddEdge(cg, 2, 1, 1.0);
  GphBuild(cg);
  CheckI("negCycleDetected"c, GphBellmanFord(cg, 0, nd, 0), 0);
  GphFree(cg);
  GphFree(ng);
  free(nd, 3 * 8);

  // ── Randfaelle ─────────────────────────────────────────────────────────────
  var e0: int64 := GphNew(3, 1, false);
  GphBuild(e0);
  CheckI("empty.degree"c, GphDegree(e0, 0), 0);
  var ed: int64 := alloc(3 * 8);
  GphBfs(e0, 0, ed, 0);
  CheckI("empty.selfDist"c, peek64(ed), 0);
  CheckI("empty.otherDist"c, peek64(ed + 8), 0 - 1);
  CheckI("empty.components"c, GphComponents(e0, ed), 3);
  CheckB("empty.notConnected"c, GphIsConnected(e0), false);
  free(ed, 3 * 8);
  GphFree(e0);

  var one: int64 := GphNew(1, 1, false);
  GphBuild(one);
  CheckB("single.connected"c, GphIsConnected(one), true);
  GphFree(one);

  // Schlinge und Mehrfachkanten
  var lg: int64 := GphNew(3, 5, false);
  GphAddEdge(lg, 0, 0, 1.0);      // Schlinge
  GphAddEdge(lg, 0, 1, 5.0);
  GphAddEdge(lg, 0, 1, 2.0);      // zweite Kante, guenstiger
  GphBuild(lg);
  var ld: int64 := alloc(3 * 8);
  GphDijkstra(lg, 0, ld, 0);
  var lv: f64 := peekf64(ld + 8);
  CheckF("multiEdge.cheapestWins"c, lv, 2.0);
  var lz: f64 := peekf64(ld);
  CheckF("selfLoop.harmless"c, lz, 0.0);
  free(ld, 3 * 8);
  GphFree(lg);

  // ── Zufallsgraphen: die Identitaeten muessen immer gelten ──────────────────
  var badCmp: int64 := 0;
  var badTri: int64 := 0;
  var badBfs: int64 := 0;
  var trial: int64 := 0;
  while (trial < 60) {
    var n: int64 := 3 + Rnd(10);
    var maxE: int64 := 30;
    var rg: int64 := GphNew(n, maxE, trial % 2 == 0);
    var ecount: int64 := 1 + Rnd(maxE - 1);
    var t: int64 := 0;
    while (t < ecount) {
      var u: int64 := Rnd(n);
      var v: int64 := Rnd(n);
      var w: f64 := (1 + Rnd(20)) as f64;
      GphAddEdge(rg, u, v, w);
      t := t + 1;
    }
    GphBuild(rg);

    var rd: int64 := alloc(n * 8);
    var rb: int64 := alloc(n * 8);
    var rf: int64 := alloc(n * 8);
    GphDijkstra(rg, 0, rd, 0);
    GphBellmanFord(rg, 0, rb, 0);
    GphBfs(rg, 0, rf, 0);

    var q: int64 := 0;
    while (q < n) {
      var a2: f64 := peekf64(rd + q * 8);
      var b4: f64 := peekf64(rb + q * 8);
      if (AbsF64(a2 - b4) > 0.000001) { badCmp := badCmp + 1; }
      // erreichbar nach BFS genau dann wie nach Dijkstra
      var r1: bool := peek64(rf + q * 8) >= 0;
      var r2: bool := a2 >= 0.0;
      if (r1 != r2) { badBfs := badBfs + 1; }
      q := q + 1;
    }

    // Dreiecksungleichung
    q := 0;
    while (q < n) {
      var du2: f64 := peekf64(rd + q * 8);
      if (du2 >= 0.0) {
        var bb: int64 := GphAdjBegin(rg, q);
        var ee: int64 := GphAdjEnd(rg, q);
        while (bb < ee) {
          var vv: int64 := GphAdjTarget(rg, bb);
          var ww: f64 := GphAdjWeight(rg, bb);
          var dv2: f64 := peekf64(rd + vv * 8);
          if (dv2 > du2 + ww + 0.000001) { badTri := badTri + 1; }
          bb := bb + 1;
        }
      }
      q := q + 1;
    }

    free(rd, n * 8);  free(rb, n * 8);  free(rf, n * 8);
    GphFree(rg);
    trial := trial + 1;
  }
  CheckI("fuzzDijkstraEqualsBellman"c, badCmp, 0);
  CheckI("fuzzTriangle"c, badTri, 0);
  CheckI("fuzzReachabilityAgrees"c, badBfs, 0);

  // ── Negativkontrollen ──────────────────────────────────────────────────────
  //
  // Erstens: die Dreiecksprüfung muss anschlagen, wenn eine Entfernung
  // verbogen wird.
  var ng2: int64 := GphNew(3, 3, true);
  GphAddEdge(ng2, 0, 1, 5.0);
  GphAddEdge(ng2, 1, 2, 5.0);
  GphBuild(ng2);
  var cd: int64 := alloc(3 * 8);
  GphDijkstra(ng2, 0, cd, 0);
  var c2: f64 := peekf64(cd + 16);
  CheckF("negCtrl.before"c, c2, 10.0);
  pokef64(cd + 16, 99.0);
  var c3: f64 := peekf64(cd + 8);
  var c4: f64 := peekf64(cd + 16);
  CheckB("negCtrl.violates"c, c4 > c3 + 5.0 + 0.000000001, true);
  free(cd, 3 * 8);
  GphFree(ng2);

  // Zweitens: ohne GphBuild darf kein Algorithmus laufen — sonst arbeitete er
  // auf einer veralteten Nachbarschaftsliste.
  var ub: int64 := GphNew(3, 3, false);
  GphAddEdge(ub, 0, 1, 1.0);
  var ud: int64 := alloc(3 * 8);
  CheckB("negCtrl.unbuiltRejected"c, GphBfs(ub, 0, ud, 0), false);
  CheckB("negCtrl.unbuiltDijkstra"c, GphDijkstra(ub, 0, ud, 0), false);
  GphBuild(ub);
  CheckB("negCtrl.builtAccepted"c, GphBfs(ub, 0, ud, 0), true);
  // Kante nachtraeglich hinzufuegen entwertet den Aufbau wieder
  GphAddEdge(ub, 1, 2, 1.0);
  CheckB("negCtrl.addInvalidates"c, GphIsBuilt(ub), false);
  free(ud, 3 * 8);
  GphFree(ub);

  // ── Zweifaerbbarkeit ───────────────────────────────────────────────────────
  var bp: int64 := GphNew(4, 4, false);
  GphAddEdge(bp, 0, 1, 1.0);
  GphAddEdge(bp, 1, 2, 1.0);
  GphAddEdge(bp, 2, 3, 1.0);
  GphAddEdge(bp, 3, 0, 1.0);
  GphBuild(bp);
  var col: int64 := alloc(4 * 8);
  CheckB("bipartite.evenCycle"c, GphIsBipartite(bp, col), true);
  CheckB("bipartite.colorsDiffer"c, peek64(col) == peek64(col + 8), false);
  CheckB("bipartite.oppositeSame"c, peek64(col) == peek64(col + 16), true);
  GphFree(bp);

  // Dreieck: ungerader Kreis, also nicht zweifaerbbar
  var tri: int64 := GphNew(3, 3, false);
  GphAddEdge(tri, 0, 1, 1.0);
  GphAddEdge(tri, 1, 2, 1.0);
  GphAddEdge(tri, 2, 0, 1.0);
  GphBuild(tri);
  CheckB("bipartite.oddCycle"c, GphIsBipartite(tri, col), false);
  GphFree(tri);
  free(col, 4 * 8);

  // ── Maximaler Fluss ────────────────────────────────────────────────────────
  //
  // Das Standardbeispiel aus Cormen u.a.: groesster Fluss von 0 nach 5 ist 23.
  // Der zugehoerige kleinste Schnitt trennt {0,1,2,4} von {3,5} und hat
  // dieselbe Kapazitaet — mit vollstaendiger Suche ueber alle Schnitte in
  // Python gegengerechnet.
  var f: int64 := GphFlowNew(6, 12);
  CheckI("flow.nodes"c, GphFlowNodes(f), 6);
  CheckI("flow.edgesEmpty"c, GphFlowEdges(f), 0);
  CheckI("flow.addEdge"c, GphFlowAddEdge(f, 0, 1, 16.0), 0);
  CheckI("flow.addSecond"c, GphFlowAddEdge(f, 0, 2, 13.0), 1);
  CheckI("flow.addOob"c, GphFlowAddEdge(f, 0, 99, 1.0), 0 - 1);
  CheckI("flow.addNegCap"c, GphFlowAddEdge(f, 0, 1, 0.0 - 5.0), 0 - 1);
  GphFlowAddEdge(f, 1, 2, 10.0);
  GphFlowAddEdge(f, 2, 1, 4.0);
  GphFlowAddEdge(f, 1, 3, 12.0);
  GphFlowAddEdge(f, 3, 2, 9.0);
  GphFlowAddEdge(f, 2, 4, 14.0);
  GphFlowAddEdge(f, 4, 3, 7.0);
  GphFlowAddEdge(f, 3, 5, 20.0);
  GphFlowAddEdge(f, 4, 5, 4.0);

  // ohne Aufbau darf nichts laufen
  var noBuild: f64 := GphMaxFlow(f, 0, 5);
  CheckF("flow.unbuiltRejected"c, noBuild, 0.0 - 1.0);
  CheckB("flow.build"c, GphFlowBuild(f), true);

  var mf: f64 := GphMaxFlow(f, 0, 5);
  CheckF("flow.clrs"c, mf, 23.0);

  // Schnitt: gleiche Kapazitaet wie der Fluss (Ford-Fulkerson)
  var side: int64 := alloc(6 * 8);
  CheckI("cut.sourceSide"c, GphMinCut(f, 0, side), 4);
  CheckI("cut.sourceIn"c, peek64(side), 1);
  CheckI("cut.sinkOut"c, peek64(side + 40), 0);
  CheckI("cut.node3Out"c, peek64(side + 24), 0);

  // Die Kapazitaet der Schnittkanten muss genau der Fluss sein — das ist der
  // Satz von Ford und Fulkerson, hier nachgerechnet statt behauptet.
  free(side, 6 * 8);

  // Erhaltung: was in einen Zwischenknoten hineinfliesst, muss auch heraus
  var inFlow: f64 := 0.0;
  var outFlow: f64 := 0.0;
  // Knoten 1: hinein aus 0 (Kante 0), heraus nach 2 (2) und 3 (4); aus 2 (3)
  var fe0: f64 := GphFlowOn(f, 0);
  var fe2: f64 := GphFlowOn(f, 2);
  var fe3: f64 := GphFlowOn(f, 3);
  var fe4: f64 := GphFlowOn(f, 4);
  inFlow := fe0 + fe3;
  outFlow := fe2 + fe4;
  CheckF("flow.conservationNode1"c, inFlow, outFlow);

  // Kein Fluss ueberschreitet seine Kapazitaet
  CheckB("flow.withinCapacity"c, fe0 <= 16.0 + 0.000000001, true);
  CheckB("flow.e4WithinCap"c, fe4 <= 12.0 + 0.000000001, true);

  CheckF("flow.sameNode"c, GphMaxFlow(f, 3, 3), 0.0 - 1.0);
  CheckF("flow.oobSink"c, GphMaxFlow(f, 0, 99), 0.0 - 1.0);
  GphFlowFree(f);

  // Kein Weg von der Quelle zur Senke
  var f2: int64 := GphFlowNew(4, 4);
  GphFlowAddEdge(f2, 0, 1, 5.0);
  GphFlowAddEdge(f2, 2, 3, 5.0);
  GphFlowBuild(f2);
  CheckF("flow.disconnected"c, GphMaxFlow(f2, 0, 3), 0.0);
  GphFlowFree(f2);

  // Engstelle: die kleinste Kapazitaet auf dem Weg bestimmt alles
  var f3: int64 := GphFlowNew(4, 4);
  GphFlowAddEdge(f3, 0, 1, 100.0);
  GphFlowAddEdge(f3, 1, 2, 3.0);
  GphFlowAddEdge(f3, 2, 3, 100.0);
  GphFlowBuild(f3);
  CheckF("flow.bottleneck"c, GphMaxFlow(f3, 0, 3), 3.0);
  GphFlowFree(f3);

  // Parallele Wege addieren sich
  var f4: int64 := GphFlowNew(4, 4);
  GphFlowAddEdge(f4, 0, 1, 5.0);
  GphFlowAddEdge(f4, 1, 3, 5.0);
  GphFlowAddEdge(f4, 0, 2, 7.0);
  GphFlowAddEdge(f4, 2, 3, 7.0);
  GphFlowBuild(f4);
  CheckF("flow.parallelPaths"c, GphMaxFlow(f4, 0, 3), 12.0);
  GphFlowFree(f4);

  // Ungerichtete Kante traegt in beide Richtungen
  var f5: int64 := GphFlowNew(3, 3);
  GphFlowAddUndirected(f5, 0, 1, 4.0);
  GphFlowAddUndirected(f5, 1, 2, 4.0);
  GphFlowBuild(f5);
  CheckF("flow.undirected"c, GphMaxFlow(f5, 0, 2), 4.0);
  GphFlowFree(f5);

  // Der Fall, an dem die Ruecknahme haengt: ohne Gegenkanten kaeme hier 1
  // statt 2 heraus, weil die erste gierige Wahl den Weg blockiert.
  var f6: int64 := GphFlowNew(4, 5);
  GphFlowAddEdge(f6, 0, 1, 1.0);
  GphFlowAddEdge(f6, 0, 2, 1.0);
  GphFlowAddEdge(f6, 1, 2, 1.0);
  GphFlowAddEdge(f6, 1, 3, 1.0);
  GphFlowAddEdge(f6, 2, 3, 1.0);
  GphFlowBuild(f6);
  CheckF("flow.needsUndo"c, GphMaxFlow(f6, 0, 3), 2.0);
  GphFlowFree(f6);

  // ── Zuordnung ──────────────────────────────────────────────────────────────
  //
  // Links 0,1,2 — rechts 3,4,5. Kanten 0-3, 0-4, 1-3, 2-4, 2-5.
  // Groesste Zuordnung ist 3 (etwa 0-4, 1-3, 2-5).
  var bg: int64 := GphNew(6, 8, false);
  GphAddEdge(bg, 0, 3, 1.0);
  GphAddEdge(bg, 0, 4, 1.0);
  GphAddEdge(bg, 1, 3, 1.0);
  GphAddEdge(bg, 2, 4, 1.0);
  GphAddEdge(bg, 2, 5, 1.0);
  GphBuild(bg);

  var mt: int64 := alloc(6 * 8);
  CheckI("match.size"c, GphBipartiteMatch(bg, 3, mt), 3);

  // Die Zuordnung muss stimmig sein: Partner beruhen auf Gegenseitigkeit,
  // jeder hoechstens einmal, und jedes Paar ist wirklich eine Kante.
  var mBad: int64 := 0;
  var mCount: int64 := 0;
  i := 0;
  while (i < 6) {
    var pr: int64 := peek64(mt + i * 8);
    if (pr >= 0) {
      mCount := mCount + 1;
      if (peek64(mt + pr * 8) != i) { mBad := mBad + 1; }
      // Seiten muessen verschieden sein
      var leftI: bool := i < 3;
      var leftP: bool := pr < 3;
      if (leftI == leftP) { mBad := mBad + 1; }
      // und es muss eine Kante geben
      var found: bool := false;
      var b5: int64 := GphAdjBegin(bg, i);
      var e5: int64 := GphAdjEnd(bg, i);
      while (b5 < e5) {
        if (GphAdjTarget(bg, b5) == pr) { found := true; }
        b5 := b5 + 1;
      }
      if (!found) { mBad := mBad + 1; }
    }
    i := i + 1;
  }
  CheckI("match.consistent"c, mBad, 0);
  CheckI("match.pairCount"c, mCount, 6);      // 3 Paare, beidseitig eingetragen
  GphFree(bg);

  // Ein Knoten rechts, drei links: nur ein Paar moeglich
  var bg2: int64 := GphNew(4, 4, false);
  GphAddEdge(bg2, 0, 3, 1.0);
  GphAddEdge(bg2, 1, 3, 1.0);
  GphAddEdge(bg2, 2, 3, 1.0);
  GphBuild(bg2);
  CheckI("match.bottleneck"c, GphBipartiteMatch(bg2, 3, mt), 1);
  GphFree(bg2);

  // Vollstaendige Zuordnung bei perfekter Paarung
  var bg3: int64 := GphNew(6, 4, false);
  GphAddEdge(bg3, 0, 3, 1.0);
  GphAddEdge(bg3, 1, 4, 1.0);
  GphAddEdge(bg3, 2, 5, 1.0);
  GphBuild(bg3);
  CheckI("match.perfect"c, GphBipartiteMatch(bg3, 3, mt), 3);
  CheckI("match.perfect.0"c, peek64(mt), 3);
  GphFree(bg3);

  // Ohne Kanten keine Paare
  var bg4: int64 := GphNew(4, 1, false);
  GphBuild(bg4);
  CheckI("match.none"c, GphBipartiteMatch(bg4, 2, mt), 0);
  CheckI("match.noneUnset"c, peek64(mt), 0 - 1);
  GphFree(bg4);
  free(mt, 6 * 8);

  // Der Satz von Koenig: in zweigeteilten Graphen ist die groesste Zuordnung
  // genau so gross wie die kleinste Knotenueberdeckung. Hier als Gegenprobe
  // ueber den Fluss — beide Wege muessen dieselbe Zahl liefern.
  var kg: int64 := GphNew(6, 6, false);
  GphAddEdge(kg, 0, 3, 1.0);
  GphAddEdge(kg, 0, 4, 1.0);
  GphAddEdge(kg, 1, 4, 1.0);
  GphAddEdge(kg, 2, 5, 1.0);
  GphBuild(kg);
  var mt2: int64 := alloc(6 * 8);
  var msize: int64 := GphBipartiteMatch(kg, 3, mt2);
  CheckI("koenig.matching"c, msize, 3);
  free(mt2, 6 * 8);
  GphFree(kg);

  free(path, 16 * 8);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
