// LX-21 Test: Zwei-Register-Rückgabe  var val, err := syscall(...)

import src.std.lyxos.fs;
import src.std.lyxos.io;

fn main(): int64 {
    // var a, b := — beide Variablen benutzen
    var fd, err := sys_open("tests/lx21_tworet_test.lyx"c, O_RDONLY, 0);
    if err != 0 {
        EPrintStrLn("lx21: sys_open failed");
        return 1;
    }
    sys_close(fd);

    // var a, _ := — zweiter Wert verworfen
    var fd2, _ := sys_open("tests/lx21_tworet_test.lyx"c, O_RDONLY, 0);
    sys_close(fd2);

    PrintStrLn("lx21: ok");
    return 0;
}
