// tests/demo_s3_crud.lyx — S3 Demo: Bucket + text file upload/download/delete
// WP-S3-10

unit tests.demo_s3_crud;

import std.cloud.aws.core;
import std.cloud.s3;
import std.io;
import std.alloc;

pub fn main(argc: int64, argv: int64): int64 {
    PrintLn("=== S3 Demo: CRUD ==="c);

    var creds: AWSCreds := AWSCredentialsFromEnv();
    if (creds.accessKey == 0) {
        PrintLn("Error: set AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY"c); return 1;
    }
    var region: pchar := AWSRegionFromEnv("us-east-1"c);
    var client: S3Client := S3Connect(creds, region);

    var bucket: pchar := "lyx-crud-demo"c;

    // Create bucket
    Print("Creating bucket '"c); Print(bucket); Print("'..."c);
    var ok: int64 := S3BucketCreate(client, bucket);
    if (ok == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }

    // Check it exists
    var exists: int64 := S3BucketExists(client, bucket);
    Print("BucketExists: "c);
    if (exists == 1) { PrintLn("yes"c); } else { PrintLn("no"c); }

    // Upload text file
    var key: pchar := "hello/world.txt"c;
    var data: pchar := "Hello, Lyx S3 SDK!\n"c;
    var dl: int64 := StrLen(data);
    Print("Uploading '"c); Print(key); Print("'..."c);
    var putOk: int64 := S3PutObject(client, bucket, key, data as int64, dl, "text/plain"c);
    if (putOk == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }

    // Object exists check
    var objExists: int64 := S3ObjectExists(client, bucket, key);
    Print("ObjectExists: "c);
    if (objExists == 1) { PrintLn("yes"c); } else { PrintLn("no"c); }

    // Get size
    var size: int64 := S3GetObjectSize(client, bucket, key);
    Print("Object size: "c);
    var sbuf: int64 := alloc(24); s3Int64Str(size, sbuf);
    PrintLn(sbuf as pchar); free(sbuf, 24);

    // Download
    Print("Downloading '"c); Print(key); Print("'..."c);
    var body: int64 := S3GetObject(client, bucket, key);
    if (body != 0) {
        PrintLn(" OK"c);
        Print("Content: "c); PrintLn(body as pchar);
        var bl: int64 := StrLen(body as pchar);
        free(body, bl+1);
    } else { PrintLn(" FAILED"c); }

    // HeadObject
    var meta: S3ObjectMeta := S3HeadObject(client, bucket, key);
    Print("ETag: "c);
    if (meta.etag != 0) { PrintLn(meta.etag as pchar); }
    else { PrintLn("(none)"c); }
    S3ObjectMetaFree(meta);

    // Delete object
    Print("Deleting object..."c);
    var delOk: int64 := S3DeleteObject(client, bucket, key);
    if (delOk == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }

    // Delete bucket
    Print("Deleting bucket..."c);
    var bDelOk: int64 := S3BucketDelete(client, bucket);
    if (bDelOk == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }

    S3Close(client);
    PrintLn("Done."c);
    return 0;
}

fn s3Int64Str(n: int64, buf: int64) {
    if (n == 0) { poke8(buf, 48); poke8(buf+1, 0); return; }
    var tmp: int64 := alloc(24); var i: int64 := 0; var v: int64 := n;
    while (v > 0) { poke8(tmp+i, 48+(v%10)); v:=v/10; i:=i+1; }
    var j: int64 := 0;
    while (j < i) { poke8(buf+j, peek8(tmp+(i-1-j))); j:=j+1; }
    poke8(buf+i, 0); free(tmp, 24);
}
