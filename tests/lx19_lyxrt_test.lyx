// LX-19 Test: lyxrt Runtime-Library — Kompilierung und Grundfunktionen prüfen

import src.std.lyxos.lyxrt;

fn main(): int64 {
    // rt_alloc: kleiner Block
    var p: int64 := rt_alloc(128);
    if p == 0 {
        rt_panic("lyxrt test: rt_alloc returned 0\n"c, 32);
    }

    // rt_alloc: zwei Blöcke — zweiter muss nach erstem liegen
    var q: int64 := rt_alloc(64);
    if q <= p {
        rt_panic("lyxrt test: bump-pointer error\n"c, 31);
    }

    // rt_free ist no-op — darf nicht crashen
    rt_free(p, 128);
    rt_free(q, 64);

    return 0;
}
