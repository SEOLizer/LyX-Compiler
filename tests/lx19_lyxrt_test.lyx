// LX-19 Test: lyxrt Runtime-Library — Kompilierung und Grundfunktionen prüfen

import src.std.lyxos.lyxrt;

fn main(): int64 {
    // alloc: kleiner Block
    var p: int64 := alloc(128);
    if p == 0 {
        rt_panic("lyxrt test: alloc returned 0\n"c, 34);
    }

    // alloc: zwei Blöcke — zweiter muss nach erstem liegen
    var q: int64 := alloc(64);
    if q <= p {
        rt_panic("lyxrt test: bump-pointer error\n"c, 33);
    }

    // free ist no-op — darf nicht crashen
    free(p, 128);
    free(q, 64);

    return 0;
}
