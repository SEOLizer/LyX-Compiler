// LX-28 Test: Section Block Emitter — block_count + build + validate (--target=x86_64)

import src.std.alloc;
import src.std.io;
import src.std.lyxos.lbf_layout;
import src.tools.lbf.block_header;
import src.tools.lbf.sections;

fn main(): int64 {
    // ── Test 1–7: section_block_count ─────────────────────────────────────────
    if section_block_count(0) != 0 {
        EPrintStrLn("FAIL: block_count(0) != 0"); return 1;
    }
    if section_block_count(1) != 1 {
        EPrintStrLn("FAIL: block_count(1) != 1"); return 1;
    }
    if section_block_count(4032) != 1 {
        EPrintStrLn("FAIL: block_count(4032) != 1"); return 1;
    }
    if section_block_count(4033) != 2 {
        EPrintStrLn("FAIL: block_count(4033) != 2"); return 1;
    }
    if section_block_count(4000) != 1 {
        EPrintStrLn("FAIL: block_count(4000) != 1"); return 1;
    }
    if section_block_count(8064) != 2 {
        EPrintStrLn("FAIL: block_count(8064) != 2"); return 1;
    }
    if section_block_count(8065) != 3 {
        EPrintStrLn("FAIL: block_count(8065) != 3"); return 1;
    }

    var block: int64 := alloc(LBF_BLOCK_SIZE);
    var data: int64  := alloc(LBF_BLOCK_SIZE);

    // ── Test 8: 4000-Byte-.text-Block — Payload gefüllt, Schwanz genullt ──────
    var i: int64 := 0;
    while i < 4000 { poke8(data + i, 0xAA); i := i + 1; }

    section_build_block(block, data, 4000, 1, 3, 0);

    var ok: int64 := 1;
    i := 0;
    while i < 4000 {
        if (peek8(block + 64 + i) & 0xFF) != 0xAA { ok := 0; }
        i := i + 1;
    }
    if ok == 0 { EPrintStrLn("FAIL: payload-Bytes nicht 0xAA"); return 1; }

    i := 4064;
    while i < 4096 {
        if peek8(block + i) != 0 { EPrintStrLn("FAIL: Schwanz-Bytes nicht 0x00"); return 1; }
        i := i + 1;
    }

    // ── Test 9: .text — Immutable-Flag via lbf_header_set_immutable ──────────
    section_build_block(block, data, 4000, 1, 3, 0);
    lbf_header_set_immutable(block);
    if (peek8(block + LBF_H_FLAGS) & 1) == 0 {
        EPrintStrLn("FAIL: .text Block nicht immutable"); return 1;
    }

    // ── Test 10: .data — kein lbf_header_set_immutable → Flag = 0 ───────────
    section_build_block(block, data, 4000, 1, 3, 0);
    if (peek8(block + LBF_H_FLAGS) & 1) != 0 {
        EPrintStrLn("FAIL: .data Block sollte nicht immutable sein"); return 1;
    }

    // ── Test 11: .rodata — Immutable-Flag ebenfalls setzbar ──────────────────
    section_build_block(block, data, 4000, 1, 3, 0);
    lbf_header_set_immutable(block);
    if (peek8(block + LBF_H_FLAGS) & 1) == 0 {
        EPrintStrLn("FAIL: .rodata Block nicht immutable"); return 1;
    }

    // ── Test 12: lbf_header_validate → 0 (.text, nach set_immutable) ─────────
    // CRC deckt nur Payload — set_immutable ändert nur Header → CRC bleibt valide
    section_build_block(block, data, 4000, 1, 3, 0);
    lbf_header_set_immutable(block);
    if lbf_header_validate(block) != 0 {
        EPrintStrLn("FAIL: validate .text Block != 0"); return 1;
    }

    // ── Test 13: lbf_header_validate → 0 (.data Block) ───────────────────────
    section_build_block(block, data, 4000, 1, 3, 0);
    if lbf_header_validate(block) != 0 {
        EPrintStrLn("FAIL: validate .data Block != 0"); return 1;
    }

    // ── Test 14: 4033-Byte-.text → zwei Blöcke ───────────────────────────────
    var data2: int64  := alloc(4033);
    var block2: int64 := alloc(LBF_BLOCK_SIZE);

    i := 0;
    while i < 4033 { poke8(data2 + i, 0xBB); i := i + 1; }

    // Block 0: 4032 Bytes 0xBB
    section_build_block(block, data2, 4032, 1, 3, 0);
    lbf_header_set_immutable(block);
    if lbf_header_validate(block) != 0 {
        EPrintStrLn("FAIL: validate 4033 Block0 != 0"); return 1;
    }
    ok := 1;
    i := 0;
    while i < 4032 {
        if (peek8(block + 64 + i) & 0xFF) != 0xBB { ok := 0; }
        i := i + 1;
    }
    if ok == 0 { EPrintStrLn("FAIL: 4033 Block0 Payload falsch"); return 1; }

    // Block 1: 1 Byte 0xBB + 4031 Null-Bytes
    section_build_block(block2, data2 + 4032, 1, 2, 3, 0);
    lbf_header_set_immutable(block2);
    if lbf_header_validate(block2) != 0 {
        EPrintStrLn("FAIL: validate 4033 Block1 != 0"); return 1;
    }
    if (peek8(block2 + 64) & 0xFF) != 0xBB {
        EPrintStrLn("FAIL: 4033 Block1 erstes Byte falsch"); return 1;
    }
    i := 1;
    while i < 4032 {
        if peek8(block2 + 64 + i) != 0 {
            EPrintStrLn("FAIL: 4033 Block1 Schwanz nicht 0"); return 1;
        }
        i := i + 1;
    }

    // ── Test 15: section_emit .bss (data_len=0) → 0 (kein Schreiben) ─────────
    if section_emit(1, data, 0, LBF_SECT_TYPE_BSS, 5, 6) != 0 {
        EPrintStrLn("FAIL: section_emit BSS (len=0) != 0"); return 1;
    }

    free(data2, 4033);
    free(block2, LBF_BLOCK_SIZE);
    free(block, LBF_BLOCK_SIZE);
    free(data, LBF_BLOCK_SIZE);

    PrintStrLn("lx28: section block emitter OK");
    return 0;
}
