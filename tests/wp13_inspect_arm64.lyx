// WP-13: Inspect Debug-Visualizer — ARM64 Linux + Windows ARM64
//
// Abnahme-Kriterien (stderr):
//   Inspect(x)          → "[Inspect:x] 42"
//   Inspect(neg)        → "[Inspect:neg] -7"
//   Inspect(0 - 1 + 1)  → "[Inspect:?] 0"
// stdout:
//   "PASS"
//
// Plattform: ARM64 Linux (inline SYS_WRITE), Windows ARM64 (wab helpers 11/12)
import std.io;

fn main(): int64 {
  var x: int64 := 42;
  Inspect(x);
  var neg: int64 := 0 - 7;
  Inspect(neg);
  Inspect(0 - 1 + 1);
  PrintLn("PASS");
  return 0;
}
