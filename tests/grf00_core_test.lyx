// tests/grf00_core_test.lyx — GRF-00: Core Image API Tests

unit tests.grf00_core_test;

import std.image.core;
import std.alloc;
import std.io;

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // --- Test 1: GrfImageAlloc basic ---
    var img: int64 := GrfImageAlloc(100, 100);
    if (img == 0) {
        PrintLn("FAIL: GrfImageAlloc returned 0"c);
        ok := 0;
    }
    if (ok != 0) {
        var pixLen:   int64 := peek64(img + GRF_OFF_PIXLEN);
        var channels: int64 := peek64(img + GRF_OFF_CHANNELS);
        if (pixLen != 40000) {
            PrintLn("FAIL: PIXLEN != 40000"c);
            ok := 0;
        } else {
            PrintLn("PASS: GrfImageAlloc PIXLEN=40000"c);
        }
        if (channels != 4) {
            PrintLn("FAIL: CHANNELS != 4"c);
            ok := 0;
        } else {
            PrintLn("PASS: GrfImageAlloc CHANNELS=4"c);
        }
    }

    // --- Test 2: SetPixel / GetPixel round-trip ---
    if (img != 0) {
        GrfImageSetPixel(img, 0, 0, 0xFF8040FF);
        var px: int64 := GrfImageGetPixel(img, 0, 0);
        if (px != 0xFF8040FF) {
            PrintLn("FAIL: SetPixel/GetPixel round-trip (0,0)"c);
            ok := 0;
        } else {
            PrintLn("PASS: SetPixel/GetPixel (0,0)"c);
        }
        // corner pixel
        GrfImageSetPixel(img, 99, 99, 0x112233FF);
        var px2: int64 := GrfImageGetPixel(img, 99, 99);
        if (px2 != 0x112233FF) {
            PrintLn("FAIL: SetPixel/GetPixel corner (99,99)"c);
            ok := 0;
        } else {
            PrintLn("PASS: SetPixel/GetPixel corner (99,99)"c);
        }
    }

    // --- Test 3: GrfImageClear ---
    if (img != 0) {
        GrfImageClear(img, 0xAABBCCDD);
        var p0: int64 := GrfImageGetPixel(img, 0, 0);
        var p1: int64 := GrfImageGetPixel(img, 50, 50);
        var p2: int64 := GrfImageGetPixel(img, 99, 99);
        if (p0 != 0xAABBCCDD || p1 != 0xAABBCCDD || p2 != 0xAABBCCDD) {
            PrintLn("FAIL: GrfImageClear"c);
            ok := 0;
        } else {
            PrintLn("PASS: GrfImageClear"c);
        }
    }

    // --- Test 4: GrfImageFree ---
    if (img != 0) {
        GrfImageFree(img);
        PrintLn("PASS: GrfImageFree"c);
    }

    // --- Test 5: GrfImageAlloc invalid dimensions ---
    var imgBad: int64 := GrfImageAlloc(0, 100);
    if (imgBad != 0) {
        PrintLn("FAIL: GrfImageAlloc(0,100) should return 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: GrfImageAlloc(0,100)=0"c);
    }
    var imgBad2: int64 := GrfImageAlloc(100, 0);
    if (imgBad2 != 0) {
        PrintLn("FAIL: GrfImageAlloc(100,0) should return 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: GrfImageAlloc(100,0)=0"c);
    }

    // --- Test 6: GrfDetectFormat ---
    var tbuf: int64 := alloc(16);

    // BMP: 'B'=0x42 'M'=0x4D
    poke8(tbuf,     0x42);
    poke8(tbuf + 1, 0x4D);
    poke8(tbuf + 2, 0x00);
    poke8(tbuf + 3, 0x00);
    var fmtBmp: int64 := GrfDetectFormat(tbuf, 16);
    if (fmtBmp != GRF_FMT_BMP) {
        PrintLn("FAIL: GrfDetectFormat BMP"c);
        ok := 0;
    } else {
        PrintLn("PASS: GrfDetectFormat BMP"c);
    }

    // PNG: 89 50 4E 47
    poke8(tbuf,     0x89); poke8(tbuf + 1, 0x50);
    poke8(tbuf + 2, 0x4E); poke8(tbuf + 3, 0x47);
    var fmtPng: int64 := GrfDetectFormat(tbuf, 16);
    if (fmtPng != GRF_FMT_PNG) {
        PrintLn("FAIL: GrfDetectFormat PNG"c);
        ok := 0;
    } else {
        PrintLn("PASS: GrfDetectFormat PNG"c);
    }

    // JPEG: FF D8 FF xx
    poke8(tbuf, 0xFF); poke8(tbuf + 1, 0xD8);
    poke8(tbuf + 2, 0xFF); poke8(tbuf + 3, 0xE0);
    var fmtJpg: int64 := GrfDetectFormat(tbuf, 16);
    if (fmtJpg != GRF_FMT_JPEG) {
        PrintLn("FAIL: GrfDetectFormat JPEG"c);
        ok := 0;
    } else {
        PrintLn("PASS: GrfDetectFormat JPEG"c);
    }

    // GIF: 47 49 46 38
    poke8(tbuf, 0x47); poke8(tbuf + 1, 0x49);
    poke8(tbuf + 2, 0x46); poke8(tbuf + 3, 0x38);
    var fmtGif: int64 := GrfDetectFormat(tbuf, 16);
    if (fmtGif != GRF_FMT_GIF) {
        PrintLn("FAIL: GrfDetectFormat GIF"c);
        ok := 0;
    } else {
        PrintLn("PASS: GrfDetectFormat GIF"c);
    }

    // TIFF LE: 49 49 2A 00
    poke8(tbuf, 0x49); poke8(tbuf + 1, 0x49);
    poke8(tbuf + 2, 0x2A); poke8(tbuf + 3, 0x00);
    var fmtTifLE: int64 := GrfDetectFormat(tbuf, 16);
    if (fmtTifLE != GRF_FMT_TIFF) {
        PrintLn("FAIL: GrfDetectFormat TIFF LE"c);
        ok := 0;
    } else {
        PrintLn("PASS: GrfDetectFormat TIFF LE"c);
    }

    // TIFF BE: 4D 4D 00 2A
    poke8(tbuf, 0x4D); poke8(tbuf + 1, 0x4D);
    poke8(tbuf + 2, 0x00); poke8(tbuf + 3, 0x2A);
    var fmtTifBE: int64 := GrfDetectFormat(tbuf, 16);
    if (fmtTifBE != GRF_FMT_TIFF) {
        PrintLn("FAIL: GrfDetectFormat TIFF BE"c);
        ok := 0;
    } else {
        PrintLn("PASS: GrfDetectFormat TIFF BE"c);
    }

    // WebP: RIFF....WEBP
    poke8(tbuf,      0x52); poke8(tbuf + 1,  0x49);
    poke8(tbuf + 2,  0x46); poke8(tbuf + 3,  0x46);
    poke8(tbuf + 4,  0x00); poke8(tbuf + 5,  0x00);
    poke8(tbuf + 6,  0x00); poke8(tbuf + 7,  0x00);
    poke8(tbuf + 8,  0x57); poke8(tbuf + 9,  0x45);
    poke8(tbuf + 10, 0x42); poke8(tbuf + 11, 0x50);
    var fmtWebP: int64 := GrfDetectFormat(tbuf, 16);
    if (fmtWebP != GRF_FMT_WEBP) {
        PrintLn("FAIL: GrfDetectFormat WebP"c);
        ok := 0;
    } else {
        PrintLn("PASS: GrfDetectFormat WebP"c);
    }

    // AVIF: xxxx ftyp avif
    poke8(tbuf,      0x00); poke8(tbuf + 1,  0x00);
    poke8(tbuf + 2,  0x00); poke8(tbuf + 3,  0x1C);
    poke8(tbuf + 4,  0x66); poke8(tbuf + 5,  0x74);
    poke8(tbuf + 6,  0x79); poke8(tbuf + 7,  0x70);
    poke8(tbuf + 8,  0x61); poke8(tbuf + 9,  0x76);
    poke8(tbuf + 10, 0x69); poke8(tbuf + 11, 0x66);
    var fmtAvif: int64 := GrfDetectFormat(tbuf, 16);
    if (fmtAvif != GRF_FMT_AVIF) {
        PrintLn("FAIL: GrfDetectFormat AVIF"c);
        ok := 0;
    } else {
        PrintLn("PASS: GrfDetectFormat AVIF"c);
    }

    // AVIF variant: 'avis'
    poke8(tbuf + 11, 0x73);
    var fmtAvis: int64 := GrfDetectFormat(tbuf, 16);
    if (fmtAvis != GRF_FMT_AVIF) {
        PrintLn("FAIL: GrfDetectFormat AVIS"c);
        ok := 0;
    } else {
        PrintLn("PASS: GrfDetectFormat AVIS"c);
    }

    // Unknown — clear all 12 bytes so AVIF ftyp remnant doesn't trigger
    poke8(tbuf,      0x00); poke8(tbuf + 1,  0x00);
    poke8(tbuf + 2,  0x00); poke8(tbuf + 3,  0x00);
    poke8(tbuf + 4,  0x00); poke8(tbuf + 5,  0x00);
    poke8(tbuf + 6,  0x00); poke8(tbuf + 7,  0x00);
    poke8(tbuf + 8,  0x00); poke8(tbuf + 9,  0x00);
    poke8(tbuf + 10, 0x00); poke8(tbuf + 11, 0x00);
    var fmtUnk: int64 := GrfDetectFormat(tbuf, 16);
    if (fmtUnk != GRF_FMT_UNKNOWN) {
        PrintLn("FAIL: GrfDetectFormat unknown"c);
        ok := 0;
    } else {
        PrintLn("PASS: GrfDetectFormat unknown"c);
    }

    // Short buffer (< 4 bytes)
    var fmtShort: int64 := GrfDetectFormat(tbuf, 2);
    if (fmtShort != GRF_FMT_UNKNOWN) {
        PrintLn("FAIL: GrfDetectFormat short buf"c);
        ok := 0;
    } else {
        PrintLn("PASS: GrfDetectFormat short buf"c);
    }

    free(tbuf, 16);

    if (ok != 0) {
        PrintLn("=== GRF-00: ALL PASS ==="c);
    } else {
        PrintLn("=== GRF-00: SOME FAIL ==="c);
    }
    return ok;
}
