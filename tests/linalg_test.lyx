// tests/linalg_test.lyx
// Selbstpruefende Testbatterie fuer std.linalg.
//
// Der groessere Teil prueft STRUKTURELL: A*A^-1 = I, Q^T*Q = I, Q*R = A,
// A*v = lambda*v, L*L^T = A. Solche Pruefungen brauchen keine fremden Zahlen
// und schlagen auch dann an, wenn ein Verfahren in sich schluessig, aber
// falsch waere. Die eingestreuten Zahlenwerte sind gegen numpy geprueft.

unit main;

import std.linalg;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn TOL(): f64 { return 0.000000001; }

fn Check(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > tol) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" (bool)\n"c);
  }
}

// peekf64 direkt in einem Ausdruck wird nicht als f64 typisiert (bekannter
// Typbug, gleiche Familie wie #1499): der Wert muss erst in eine Variable.
fn PV(p: int64, i: int64): f64 {
  var v: f64 := peekf64(p + i * 8);
  return v;
}

// Groesste Abweichung zweier Matrizen — der Ruecken jeder strukturellen Pruefung
fn MaxDiff(a: int64, b: int64, m: int64, n: int64): f64 {
  var worst: f64 := 0.0;
  var i: int64 := 0;
  var cnt: int64 := m * n;
  while (i < cnt) {
    var x: f64 := peekf64(a + i * 8);
    var y: f64 := peekf64(b + i * 8);
    var d: f64 := AbsF64(x - y);
    if (d > worst) { worst := d; }
    i := i + 1;
  }
  return worst;
}

// Symmetrisch positiv definite 3x3: [[4,-2,1],[-2,4,-2],[1,-2,4]]
fn FillSpd(a: int64): void {
  LinSet(a, 3, 0, 0,  4.0);  LinSet(a, 3, 0, 1, -2.0);  LinSet(a, 3, 0, 2,  1.0);
  LinSet(a, 3, 1, 0, -2.0);  LinSet(a, 3, 1, 1,  4.0);  LinSet(a, 3, 1, 2, -2.0);
  LinSet(a, 3, 2, 0,  1.0);  LinSet(a, 3, 2, 1, -2.0);  LinSet(a, 3, 2, 2,  4.0);
}

// Allgemeine, nicht symmetrische 3x3 mit Determinante -306
fn FillGen(a: int64): void {
  LinSet(a, 3, 0, 0,  6.0);  LinSet(a, 3, 0, 1,  1.0);  LinSet(a, 3, 0, 2,  1.0);
  LinSet(a, 3, 1, 0,  4.0);  LinSet(a, 3, 1, 1, -2.0);  LinSet(a, 3, 1, 2,  5.0);
  LinSet(a, 3, 2, 0,  2.0);  LinSet(a, 3, 2, 1,  8.0);  LinSet(a, 3, 2, 2,  7.0);
}

fn main(): int64 {
  // ── Zugriff und Grundformen ───────────────────────────────────────────────
  var a: int64 := alloc(9 * 8);
  var b: int64 := alloc(9 * 8);
  var c: int64 := alloc(9 * 8);

  LinFill(a, 3, 3, 2.5);
  Check("fill"c, LinGet(a, 3, 1, 2), 2.5, TOL());
  LinSet(a, 3, 1, 2, 7.0);
  Check("set"c, LinGet(a, 3, 1, 2), 7.0, TOL());
  Check("setOther"c, LinGet(a, 3, 2, 1), 2.5, TOL());   // Zeile/Spalte nicht vertauscht

  LinIdentity(a, 3);
  Check("id11"c, LinGet(a, 3, 1, 1), 1.0, TOL());
  Check("id01"c, LinGet(a, 3, 0, 1), 0.0, TOL());
  Check("trace"c, LinTrace(a, 3), 3.0, TOL());

  // Transponieren einer nicht quadratischen Matrix
  var r23: int64 := alloc(6 * 8);
  var r32: int64 := alloc(6 * 8);
  LinSet(r23, 3, 0, 0, 1.0);  LinSet(r23, 3, 0, 1, 2.0);  LinSet(r23, 3, 0, 2, 3.0);
  LinSet(r23, 3, 1, 0, 4.0);  LinSet(r23, 3, 1, 1, 5.0);  LinSet(r23, 3, 1, 2, 6.0);
  CheckB("transOk"c, LinTranspose(r23, 2, 3, r32), true);
  Check("trans02"c, LinGet(r32, 2, 0, 1), 4.0, TOL());
  Check("trans21"c, LinGet(r32, 2, 2, 1), 6.0, TOL());
  CheckB("transAlias"c, LinTranspose(r23, 2, 3, r23), false);

  // Add/Sub/Scale
  FillGen(a);
  FillSpd(b);
  LinAdd(a, b, 3, 3, c);
  Check("add00"c, LinGet(c, 3, 0, 0), 10.0, TOL());
  LinSub(c, b, 3, 3, c);
  Check("subBack"c, MaxDiff(c, a, 3, 3), 0.0, TOL());
  LinScale(a, 3, 3, 2.0, c);
  Check("scale"c, LinGet(c, 3, 2, 2), 14.0, TOL());

  // Produkt: A*I = A, und ein von Hand nachgerechneter Eintrag
  FillGen(a);
  LinIdentity(b, 3);
  CheckB("mulOk"c, LinMul(a, b, 3, 3, 3, c), true);
  Check("mulIdent"c, MaxDiff(c, a, 3, 3), 0.0, TOL());
  CheckB("mulAlias"c, LinMul(a, b, 3, 3, 3, a), false);

  // (2x3)*(3x2) = 2x2
  var p22: int64 := alloc(4 * 8);
  LinMul(r23, r32, 2, 3, 2, p22);
  // Zeile 0 mal Spalte 0: 1*1 + 2*2 + 3*3 = 14
  Check("mul2x3_00"c, LinGet(p22, 2, 0, 0), 14.0, TOL());
  Check("mul2x3_01"c, LinGet(p22, 2, 0, 1), 32.0, TOL());
  Check("mul2x3_11"c, LinGet(p22, 2, 1, 1), 77.0, TOL());

  // Matrix mal Vektor
  var v3: int64 := alloc(3 * 8);
  var y3: int64 := alloc(3 * 8);
  pokef64(v3, 1.0);  pokef64(v3 + 8, 2.0);  pokef64(v3 + 16, 3.0);
  CheckB("mulVecOk"c, LinMulVec(a, 3, 3, v3, y3), true);
  Check("mulVec0"c, peekf64(y3),      11.0, TOL());   // 6+2+3
  Check("mulVec1"c, peekf64(y3 + 8),  15.0, TOL());   // 4-4+15
  Check("mulVec2"c, peekf64(y3 + 16), 39.0, TOL());   // 2+16+21
  CheckB("mulVecAlias"c, LinMulVec(a, 3, 3, v3, v3), false);

  // ── Normen ────────────────────────────────────────────────────────────────
  FillSpd(a);
  Check("normFro"c, LinNormFro(a, 3, 3), 8.12403840463596, 0.0000001);
  Check("normOne"c, LinNormOne(a, 3, 3), 8.0, TOL());
  Check("normInf"c, LinNormInf(a, 3, 3), 8.0, TOL());
  CheckB("isSym"c, LinIsSymmetric(a, 3, TOL()), true);
  FillGen(a);
  CheckB("isNotSym"c, LinIsSymmetric(a, 3, TOL()), false);

  // ── LU, Loesen, Determinante, Inverse ─────────────────────────────────────
  FillGen(a);
  Check("detGen"c, LinDet(a, 3), -306.0, 0.0000001);
  FillSpd(a);
  Check("detSpd"c, LinDet(a, 3), 36.0, 0.0000001);
  LinIdentity(b, 3);
  Check("detId"c, LinDet(b, 3), 1.0, TOL());

  // Singulaere Matrix: Determinante 0, Loesen scheitert, Rang kleiner
  var sing: int64 := alloc(9 * 8);
  LinSet(sing, 3, 0, 0, 1.0);  LinSet(sing, 3, 0, 1, 2.0);  LinSet(sing, 3, 0, 2, 3.0);
  LinSet(sing, 3, 1, 0, 2.0);  LinSet(sing, 3, 1, 1, 4.0);  LinSet(sing, 3, 1, 2, 6.0);
  LinSet(sing, 3, 2, 0, 1.0);  LinSet(sing, 3, 2, 1, 1.0);  LinSet(sing, 3, 2, 2, 1.0);
  Check("detSing"c, LinDet(sing, 3), 0.0, TOL());
  var xs: int64 := alloc(3 * 8);
  CheckB("solveSing"c, LinSolve(sing, 3, v3, xs), false);
  CheckI("rankSing"c, LinRank(sing, 3, 3), 2);
  CheckI("rankFull"c, LinRank(a, 3, 3), 3);

  // Pivotisierung ist Pflicht: ohne Zeilentausch scheitert [[0,1],[1,0]]
  var sw: int64 := alloc(4 * 8);
  LinSet(sw, 2, 0, 0, 0.0);  LinSet(sw, 2, 0, 1, 1.0);
  LinSet(sw, 2, 1, 0, 1.0);  LinSet(sw, 2, 1, 1, 0.0);
  var b2: int64 := alloc(2 * 8);
  var x2: int64 := alloc(2 * 8);
  pokef64(b2, 5.0);  pokef64(b2 + 8, 7.0);
  CheckB("pivotSolve"c, LinSolve(sw, 2, b2, x2), true);
  Check("pivotX0"c, peekf64(x2),     7.0, TOL());
  Check("pivotX1"c, peekf64(x2 + 8), 5.0, TOL());
  Check("pivotDet"c, LinDet(sw, 2), -1.0, TOL());

  // Loesen: A*x muss b ergeben
  FillSpd(a);
  var x3: int64 := alloc(3 * 8);
  CheckB("solveOk"c, LinSolve(a, 3, v3, x3), true);
  Check("solveX0"c, peekf64(x3),      0.6666666666666666, 0.0000001);
  Check("solveX1"c, peekf64(x3 + 8),  1.5, 0.0000001);
  Check("solveX2"c, peekf64(x3 + 16), 1.3333333333333333, 0.0000001);
  LinMulVec(a, 3, 3, x3, y3);
  Check("solveResid"c, PV(y3, 0), 1.0, 0.0000001);
  // A bleibt unveraendert
  Check("solveKeepsA"c, LinGet(a, 3, 0, 0), 4.0, TOL());

  // Inverse: A*A^-1 = I
  var inv: int64 := alloc(9 * 8);
  CheckB("invOk"c, LinInverse(a, 3, inv), true);
  Check("inv00"c, LinGet(inv, 3, 0, 0), 0.3333333333333333, 0.0000001);
  LinMul(a, inv, 3, 3, 3, c);
  LinIdentity(b, 3);
  Check("invIdent"c, MaxDiff(c, b, 3, 3), 0.0, 0.0000001);
  CheckB("invSing"c, LinInverse(sing, 3, inv), false);
  CheckB("invAlias"c, LinInverse(a, 3, a), false);

  // dasselbe fuer die nicht symmetrische Matrix
  FillGen(a);
  LinInverse(a, 3, inv);
  LinMul(a, inv, 3, 3, 3, c);
  Check("invIdentGen"c, MaxDiff(c, b, 3, 3), 0.0, 0.0000001);

  // ── Stufenform ────────────────────────────────────────────────────────────
  var rr: int64 := alloc(9 * 8);
  LinCopy(sing, rr, 3, 3);
  CheckI("rrefRank"c, LinRref(rr, 3, 3), 2);
  // fuehrende Eins in der ersten Zeile
  Check("rref00"c, LinGet(rr, 3, 0, 0), 1.0, 0.0000001);
  // breite Matrix: Rang hoechstens 2
  var wide: int64 := alloc(6 * 8);
  LinSet(wide, 3, 0, 0, 1.0);  LinSet(wide, 3, 0, 1, 2.0);  LinSet(wide, 3, 0, 2, 3.0);
  LinSet(wide, 3, 1, 0, 2.0);  LinSet(wide, 3, 1, 1, 4.0);  LinSet(wide, 3, 1, 2, 7.0);
  CheckI("rankWide"c, LinRank(wide, 2, 3), 2);
  var dep: int64 := alloc(6 * 8);
  LinSet(dep, 3, 0, 0, 1.0);  LinSet(dep, 3, 0, 1, 2.0);  LinSet(dep, 3, 0, 2, 3.0);
  LinSet(dep, 3, 1, 0, 2.0);  LinSet(dep, 3, 1, 1, 4.0);  LinSet(dep, 3, 1, 2, 6.0);
  CheckI("rankDep"c, LinRank(dep, 2, 3), 1);
  var nullm: int64 := alloc(4 * 8);
  LinZero(nullm, 2, 2);
  CheckI("rankZero"c, LinRank(nullm, 2, 2), 0);
  free(nullm, 4 * 8);

  // ── QR ────────────────────────────────────────────────────────────────────
  // 4x2, ueberbestimmt
  var m: int64 := 4;
  var nn: int64 := 2;
  var A42: int64 := alloc(8 * 8);
  LinSet(A42, 2, 0, 0, 1.0);  LinSet(A42, 2, 0, 1, 1.0);
  LinSet(A42, 2, 1, 0, 1.0);  LinSet(A42, 2, 1, 1, 2.0);
  LinSet(A42, 2, 2, 0, 1.0);  LinSet(A42, 2, 2, 1, 3.0);
  LinSet(A42, 2, 3, 0, 1.0);  LinSet(A42, 2, 3, 1, 4.0);

  var q: int64 := alloc(16 * 8);
  var rmat: int64 := alloc(8 * 8);
  CheckB("qrOk"c, LinQr(A42, m, nn, q, rmat), true);

  // Q ist orthogonal: Q^T*Q = I
  var qt: int64 := alloc(16 * 8);
  var qtq: int64 := alloc(16 * 8);
  var i4: int64 := alloc(16 * 8);
  LinTranspose(q, m, m, qt);
  LinMul(qt, q, m, m, m, qtq);
  LinIdentity(i4, m);
  Check("qOrtho"c, MaxDiff(qtq, i4, m, m), 0.0, 0.0000001);

  // Q*R = A
  var qr: int64 := alloc(8 * 8);
  LinMul(q, rmat, m, m, nn, qr);
  Check("qrRecon"c, MaxDiff(qr, A42, m, nn), 0.0, 0.0000001);

  // R ist obere Dreiecksmatrix
  Check("rLower"c, LinGet(rmat, nn, 1, 0), 0.0, 0.0000001);
  Check("rLower2"c, LinGet(rmat, nn, 3, 0), 0.0, 0.0000001);

  // mehr Spalten als Zeilen wird abgewiesen
  CheckB("qrWide"c, LinQr(r23, 2, 3, q, rmat), false);

  // ── Ausgleichsrechnung ────────────────────────────────────────────────────
  // Punkte (1,2.1) (2,3.9) (3,6.2) (4,7.8): Gerade y = a + b*x
  var bls: int64 := alloc(4 * 8);
  pokef64(bls,      2.1);  pokef64(bls +  8, 3.9);
  pokef64(bls + 16, 6.2);  pokef64(bls + 24, 7.8);
  var xls: int64 := alloc(2 * 8);
  CheckB("lstsqOk"c, LinLstSq(A42, m, nn, bls, xls), true);
  // numpy: Achsenabschnitt 0.15, Steigung 1.92
  Check("lstsqA"c, peekf64(xls),     0.15, 0.0000001);
  Check("lstsqB"c, PV(xls, 1), 1.94, 0.0000001);

  // Genau bestimmter Fall: die Loesung ist exakt, kein Rest
  var A22: int64 := alloc(4 * 8);
  LinSet(A22, 2, 0, 0, 2.0);  LinSet(A22, 2, 0, 1, 1.0);
  LinSet(A22, 2, 1, 0, 1.0);  LinSet(A22, 2, 1, 1, 3.0);
  var b22: int64 := alloc(2 * 8);
  pokef64(b22, 5.0);  pokef64(b22 + 8, 10.0);
  var x22: int64 := alloc(2 * 8);
  LinLstSq(A22, 2, 2, b22, x22);
  Check("lstsqExact0"c, peekf64(x22),     1.0, 0.0000001);
  Check("lstsqExact1"c, peekf64(x22 + 8), 3.0, 0.0000001);
  CheckB("lstsqWide"c, LinLstSq(r23, 2, 3, b22, x22), false);

  // ── Cholesky ──────────────────────────────────────────────────────────────
  FillSpd(a);
  var l: int64 := alloc(9 * 8);
  CheckB("cholOk"c, LinCholesky(a, 3, l), true);
  Check("chol00"c, LinGet(l, 3, 0, 0),  2.0, TOL());
  Check("chol10"c, LinGet(l, 3, 1, 0), -1.0, TOL());
  // oberes Dreieck bleibt null
  Check("cholUpper"c, LinGet(l, 3, 0, 2), 0.0, TOL());
  // L*L^T = A
  var lt: int64 := alloc(9 * 8);
  LinTranspose(l, 3, 3, lt);
  LinMul(l, lt, 3, 3, 3, c);
  Check("cholRecon"c, MaxDiff(c, a, 3, 3), 0.0, 0.0000001);

  // Cholesky-Loesung stimmt mit LU-Loesung ueberein
  var xc: int64 := alloc(3 * 8);
  CheckB("cholSolveOk"c, LinCholeskySolve(l, 3, v3, xc), true);
  LinSolve(a, 3, v3, x3);
  Check("cholVsLu"c, MaxDiff(xc, x3, 3, 1), 0.0, 0.0000001);

  // nicht positiv definit wird abgewiesen
  var npd: int64 := alloc(4 * 8);
  LinSet(npd, 2, 0, 0, 1.0);  LinSet(npd, 2, 0, 1, 2.0);
  LinSet(npd, 2, 1, 0, 2.0);  LinSet(npd, 2, 1, 1, 1.0);   // Eigenwerte 3 und -1
  CheckB("cholNotPd"c, LinCholesky(npd, 2, l), false);
  CheckB("isPosDefNo"c, LinIsPosDef(npd, 2), false);
  CheckB("isPosDefYes"c, LinIsPosDef(a, 3), true);
  // unsymmetrisch ist nie positiv definit
  FillGen(b);
  CheckB("isPosDefGen"c, LinIsPosDef(b, 3), false);
  free(npd, 4 * 8);

  // ── Eigenwerte ────────────────────────────────────────────────────────────
  FillSpd(a);
  var ev: int64 := alloc(3 * 8);
  var evec: int64 := alloc(9 * 8);
  CheckB("eigOk"c, LinEigenSym(a, 3, ev, evec), true);
  LinEigenSortDesc(ev, evec, 3);
  // numpy: 7.372281323269014, 3.0, 1.627718676730985
  Check("eig0"c, peekf64(ev),      7.372281323269014, 0.0000001);
  Check("eig1"c, peekf64(ev + 8),  3.0,               0.0000001);
  Check("eig2"c, peekf64(ev + 16), 1.627718676730985, 0.0000001);

  // Spur ist die Summe der Eigenwerte, Determinante ihr Produkt
  var sumEv: f64 := PV(ev, 0) + PV(ev, 1) + PV(ev, 2);
  Check("eigTrace"c, sumEv, LinTrace(a, 3), 0.0000001);
  var prodEv: f64 := PV(ev, 0) * PV(ev, 1) * PV(ev, 2);
  Check("eigDet"c, prodEv, 36.0, 0.000001);

  // A*v = lambda*v fuer jeden Eigenvektor
  var col: int64 := alloc(3 * 8);
  var av: int64 := alloc(3 * 8);
  var worstEig: f64 := 0.0;
  var k: int64 := 0;
  while (k < 3) {
    var i: int64 := 0;
    while (i < 3) {
      pokef64(col + i * 8, LinGet(evec, 3, i, k));
      i := i + 1;
    }
    LinMulVec(a, 3, 3, col, av);
    var lam: f64 := PV(ev, k);
    i := 0;
    while (i < 3) {
      var lhs: f64 := PV(av, i);
      var rhs: f64 := lam * PV(col, i);
      var d: f64 := AbsF64(lhs - rhs);
      if (d > worstEig) { worstEig := d; }
      i := i + 1;
    }
    k := k + 1;
  }
  Check("eigResidual"c, worstEig, 0.0, 0.0000001);

  // Eigenvektoren sind normiert und paarweise orthogonal
  var dot01: f64 := 0.0;
  var len0: f64 := 0.0;
  var i5: int64 := 0;
  while (i5 < 3) {
    dot01 := dot01 + LinGet(evec, 3, i5, 0) * LinGet(evec, 3, i5, 1);
    len0 := len0 + LinGet(evec, 3, i5, 0) * LinGet(evec, 3, i5, 0);
    i5 := i5 + 1;
  }
  Check("eigOrtho"c, dot01, 0.0, 0.0000001);
  Check("eigNorm"c, len0, 1.0, 0.0000001);

  // Diagonalmatrix: Eigenwerte sind die Diagonale
  var diag: int64 := alloc(9 * 8);
  LinZero(diag, 3, 3);
  LinSet(diag, 3, 0, 0, 5.0);  LinSet(diag, 3, 1, 1, -2.0);  LinSet(diag, 3, 2, 2, 9.0);
  LinEigenSym(diag, 3, ev, 0);
  LinEigenSortDesc(ev, 0, 3);
  Check("eigDiag0"c, peekf64(ev),      9.0,  0.0000001);
  Check("eigDiag2"c, peekf64(ev + 16), -2.0, 0.0000001);
  free(diag, 9 * 8);

  // unsymmetrisch wird abgewiesen
  FillGen(b);
  CheckB("eigNotSym"c, LinEigenSym(b, 3, ev, evec), false);

  // ── Singulaerwerte und Kondition ──────────────────────────────────────────
  FillSpd(a);
  var sv: int64 := alloc(3 * 8);
  CheckB("svOk"c, LinSingularValues(a, 3, 3, sv), true);
  // fuer symmetrisch positiv definite Matrizen sind es die Eigenwerte
  Check("sv0"c, peekf64(sv),      7.372281323269014, 0.000001);
  Check("sv1"c, peekf64(sv + 8),  3.0,               0.000001);
  Check("sv2"c, peekf64(sv + 16), 1.627718676730985, 0.000001);
  Check("cond2"c, LinCond2(a, 3, 3), 4.529210992451762, 0.00001);
  // Einheitsmatrix hat Kondition 1
  LinIdentity(b, 3);
  Check("condId"c, LinCond2(b, 3, 3), 1.0, 0.0000001);
  // singulaere Matrix: 0 als Sonderfall
  Check("condSing"c, LinCond2(sing, 3, 3), 0.0, TOL());

  // ── Aufraeumen ────────────────────────────────────────────────────────────
  free(a, 9 * 8);   free(b, 9 * 8);   free(c, 9 * 8);
  free(r23, 6 * 8); free(r32, 6 * 8); free(p22, 4 * 8);
  free(v3, 3 * 8);  free(y3, 3 * 8);  free(x3, 3 * 8);  free(xs, 3 * 8);
  free(sing, 9 * 8); free(inv, 9 * 8); free(rr, 9 * 8);
  free(wide, 6 * 8); free(dep, 6 * 8);
  free(sw, 4 * 8);  free(b2, 2 * 8);  free(x2, 2 * 8);
  free(A42, 8 * 8); free(q, 16 * 8);  free(rmat, 8 * 8);
  free(qt, 16 * 8); free(qtq, 16 * 8); free(i4, 16 * 8); free(qr, 8 * 8);
  free(bls, 4 * 8); free(xls, 2 * 8);
  free(A22, 4 * 8); free(b22, 2 * 8); free(x22, 2 * 8);
  free(l, 9 * 8);   free(lt, 9 * 8);  free(xc, 3 * 8);
  free(ev, 3 * 8);  free(evec, 9 * 8); free(col, 3 * 8); free(av, 3 * 8);
  free(sv, 3 * 8);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
