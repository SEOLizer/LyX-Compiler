// tests/match_exhaustiveness_test.lyx
// WP-2.2-A: Match-Exhaustiveness
//
// Valid patterns: compile and run correctly.
// (Non-exhaustive matches would be rejected at compile time —
//  verified by the fact that this file compiles.)

@description("WP-2.2-A: match exhaustiveness tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.match_exhaustiveness_test;

enum Color { Red, Green, Blue }
enum Result { Ok, Error }
enum Dir { North, South, East, West }

// --- 1. Exhaustive match with all variants covered ---
fn testAllVariantsCovered(): int64 {
  var c: Color := Green;
  var r: int64 := 0;
  match c {
    case Red   => { r := 1; }
    case Green => { r := 2; }
    case Blue  => { r := 3; }
  }
  if (r != 2) { PrintStr("FAIL: all variants match\n"); return 1; }
  PrintStr("OK: all enum variants covered\n");
  return 0;
}

// --- 2. Match with wildcard covers all ---
fn testWildcardCoversAll(): int64 {
  var c: Color := Blue;
  var r: int64 := 0;
  match c {
    case Red => { r := 1; }
    case _   => { r := 99; }
  }
  if (r != 99) { PrintStr("FAIL: wildcard\n"); return 1; }
  PrintStr("OK: wildcard covers remainder\n");
  return 0;
}

// --- 3. Result enum: both Ok and Error covered ---
fn testResultExhaustive(): int64 {
  var res: Result := Ok;
  var r: int64 := 0;
  match res {
    case Ok    => { r := 1; }
    case Error => { r := 2; }
  }
  if (r != 1) { PrintStr("FAIL: Result match\n"); return 1; }
  PrintStr("OK: Result enum exhaustive\n");
  return 0;
}

// --- 4. Four-variant enum with wildcard ---
fn testFourVariantWildcard(): int64 {
  var d: Dir := West;
  var r: int64 := 0;
  match d {
    case North => { r := 1; }
    case South => { r := 2; }
    case _     => { r := 99; }
  }
  if (r != 99) { PrintStr("FAIL: Dir wildcard\n"); return 1; }
  PrintStr("OK: four-variant enum with wildcard\n");
  return 0;
}

// --- 5. All four variants explicitly covered ---
fn testAllFourVariants(): int64 {
  var d: Dir := East;
  var r: int64 := 0;
  match d {
    case North => { r := 1; }
    case South => { r := 2; }
    case East  => { r := 3; }
    case West  => { r := 4; }
  }
  if (r != 3) { PrintStr("FAIL: Dir all four\n"); return 1; }
  PrintStr("OK: all four Dir variants covered\n");
  return 0;
}

// --- 6. Non-enum match (int64) — no exhaustiveness check, just works ---
fn testNonEnumMatch(): int64 {
  var x: int64 := 42;
  var r: int64 := 0;
  match x {
    case 1  => { r := 1; }
    case 42 => { r := 42; }
    case _  => { r := 0; }
  }
  if (r != 42) { PrintStr("FAIL: non-enum match\n"); return 1; }
  PrintStr("OK: non-enum match\n");
  return 0;
}

pub fn main(): int64 {
  if (testAllVariantsCovered()   != 0) { return 1; }
  if (testWildcardCoversAll()    != 0) { return 1; }
  if (testResultExhaustive()     != 0) { return 1; }
  if (testFourVariantWildcard()  != 0) { return 1; }
  if (testAllFourVariants()      != 0) { return 1; }
  if (testNonEnumMatch()         != 0) { return 1; }
  PrintStr("All WP-2.2-A match exhaustiveness tests passed.\n");
  return 0;
}
