// LX-17 Test: Lyra Agent Interface (0x0900–0x090B) — nur Kompilierung prüfen.

import src.std.lyxos.lyra;

fn main(): int64 {
    // sys_intent_submit / sys_intent_wait / sys_intent_cancel
    var iid: int64 := sys_intent_submit("code review"c, 11, INTENT_PRIO_HIGH);
    var st:  int64 := sys_intent_wait(iid, 1000000000, 0);
    sys_intent_cancel(iid);

    // sys_lyra_event
    sys_lyra_event(LYRA_VOICE, "hello"c, 5);

    // sys_dream_register / sys_dream_unregister
    var did: int64 := sys_dream_register(0, 5000000000, DREAM_ONESHOT);
    sys_dream_unregister(did);

    // sys_memory_store / sys_memory_recall / sys_memory_search
    sys_memory_store("key1"c, "value"c, 5, MEM_PERSIST);
    var nb: int64 := sys_memory_recall("key1"c, 0 as pchar, 0);
    var ns: int64 := sys_memory_search(0 as pchar, 128, 5, 0 as pchar, 0);

    // sys_context_push / sys_context_pop
    sys_context_push("ctx"c, 3);
    sys_context_pop();

    // sys_timeline_query (6 args)
    var nq: int64 := sys_timeline_query(0, -1, 0 as pchar, 0, 0 as pchar, 0);

    return nq;
}
