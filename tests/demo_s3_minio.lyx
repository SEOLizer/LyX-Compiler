// tests/demo_s3_minio.lyx — S3 Demo: MinIO local endpoint (same code as AWS S3)
// WP-S3-10
// Prerequisites: minio server running at localhost:9000
//   docker run -p 9000:9000 -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin minio/minio server /data

unit tests.demo_s3_minio;

import std.cloud.aws.core;
import std.cloud.s3;
import std.io;
import std.alloc;

fn itoa(n: int64, buf: int64): pchar {
    if (n == 0) { poke8(buf, 48); poke8(buf+1, 0); return buf as pchar; }
    var tmp: int64 := alloc(24); var i: int64 := 0; var v: int64 := n;
    while (v > 0) { poke8(tmp+i, 48+(v%10)); v:=v/10; i:=i+1; }
    var j: int64 := 0;
    while (j < i) { poke8(buf+j, peek8(tmp+(i-1-j))); j:=j+1; }
    poke8(buf+i, 0); free(tmp, 24); return buf as pchar;
}

pub fn main(argc: int64, argv: int64): int64 {
    PrintLn("=== S3 Demo: MinIO Local Endpoint ==="c);

    // Connect to local MinIO — S3ConnectMinio handles path-style + HTTP
    var client: S3Client := S3ConnectMinio("localhost"c, 9000,
        "minioadmin"c, "minioadmin"c);

    var bucket: pchar := "lyx-minio-test"c;

    // Create bucket
    Print("Creating bucket '"c); Print(bucket); Print("'..."c);
    var ok: int64 := S3BucketCreate(client, bucket);
    if (ok == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED (maybe already exists)"c); }

    // List buckets
    var bl: S3BucketList := S3ListBuckets(client);
    Print("Buckets visible: "c);
    var bbuf: int64 := alloc(24); itoa(S3BucketListCount(bl), bbuf);
    PrintLn(bbuf as pchar); free(bbuf, 24);
    var bi: int64 := 0;
    while (bi < S3BucketListCount(bl)) {
        Print("  "c); PrintLn(S3BucketListGetName(bl, bi)); bi := bi + 1;
    }
    S3BucketListFree(bl);

    // Upload
    var key: pchar := "test/hello.txt"c;
    var data: pchar := "Hello from Lyx + MinIO!\n"c;
    var dl: int64 := StrLen(data);
    Print("Uploading '"c); Print(key); Print("'..."c);
    var putOk: int64 := S3PutObject(client, bucket, key, data as int64, dl, "text/plain"c);
    if (putOk == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }

    // Download
    Print("Downloading..."c);
    var body: int64 := S3GetObject(client, bucket, key);
    if (body != 0) {
        PrintLn(" OK"c);
        Print("Content: "c); PrintLn(body as pchar);
        free(body, StrLen(body as pchar)+1);
    } else { PrintLn(" FAILED"c); }

    // Range request
    Print("Range GET (bytes 0-4)..."c);
    var outLen: int64 := 0;
    // #1061: Ausgabeparameter als Zelle — Lyx hat kein unaeres &.
    var outLenCell: int64 := alloc(8); poke64(outLenCell, 0);
    var chunk: int64 := S3GetObjectRange(client, bucket, key, 0, 5, outLenCell);
    outLen := peek64(outLenCell); free(outLenCell, 8);
    if (chunk != 0) {
        Print(" OK ("c);
        var lbuf: int64 := alloc(24); itoa(outLen, lbuf); Print(lbuf as pchar); free(lbuf, 24);
        PrintLn(" bytes)"c);
        free(chunk, outLen+1);
    } else { PrintLn(" FAILED"c); }

    // Copy
    var dstKey: pchar := "test/hello-copy.txt"c;
    Print("Copying to '"c); Print(dstKey); Print("'..."c);
    var cpOk: int64 := S3CopyObject(client, bucket, key, bucket, dstKey);
    if (cpOk == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }

    // List
    PrintLn("Objects in bucket:"c);
    var lst: int64 := S3ListObjects(client, bucket, ""c, 100);
    if (lst != 0) {
        var cn: int64 := S3ListCount(lst); var ci: int64 := 0;
        while (ci < cn) {
            Print("  "c); PrintLn(S3ListGetKey(lst, ci)); ci := ci+1;
        }
        S3ListFree(lst);
    }

    // Cleanup
    var keys: int64 := alloc(16);
    poke64(keys,   key as int64);
    poke64(keys+8, dstKey as int64);
    S3DeleteObjects(client, bucket, keys, 2);
    free(keys, 16);
    S3BucketDelete(client, bucket);

    S3Close(client);
    PrintLn("Done."c);
    return 0;
}
