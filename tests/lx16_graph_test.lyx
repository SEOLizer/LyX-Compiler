// LX-16 Test: Semantisches Paging & Wissensgraph (0x080D–0x0812) — nur Kompilierung prüfen.

import src.std.lyxos.graph;

fn main(): int64 {
    // sys_sem_annotate / sys_sem_query
    sys_sem_annotate(0 as pchar, 4096, 0);
    var sr: int64 := sys_sem_query(0 as pchar, 128, 5, 0 as pchar, 0);

    // sys_graph_node_create
    var nid: int64 := sys_graph_node_create(0, GRAPH_PERSIST);

    // sys_graph_edge_add / sys_graph_edge_remove
    var eid: int64 := sys_graph_edge_add(nid, GRAPH_REL_DEPENDS_ON, nid, 0 as pchar, 0);
    sys_graph_edge_remove(eid);

    // sys_graph_query
    var qr: int64 := sys_graph_query(nid, GRAPH_REL_ANY, 2, 0 as pchar, 0);

    return qr;
}
