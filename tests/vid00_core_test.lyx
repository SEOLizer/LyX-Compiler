// tests/vid00_core_test.lyx — VID-00: Core Video API Tests

unit tests.vid00_core_test;

import std.video.core;
import std.alloc;
import std.io;

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Test 1: VidDetectFormat — AVI ('RIFF'+'AVI ')
    // -------------------------------------------------------------------------
    var buf1: int64 := alloc(16);
    poke8(buf1,    0x52); poke8(buf1+1,  0x49); poke8(buf1+2,  0x46); poke8(buf1+3,  0x46);
    poke8(buf1+4,  0x00); poke8(buf1+5,  0x00); poke8(buf1+6,  0x00); poke8(buf1+7,  0x00);
    poke8(buf1+8,  0x41); poke8(buf1+9,  0x56); poke8(buf1+10, 0x49); poke8(buf1+11, 0x20);
    poke8(buf1+12, 0x00); poke8(buf1+13, 0x00); poke8(buf1+14, 0x00); poke8(buf1+15, 0x00);
    var fmt1: int64 := VidDetectFormat(buf1, 16);
    if (fmt1 != VID_FMT_AVI) {
        PrintLn("FAIL: VidDetectFormat AVI"c);
        ok := 0;
    } else {
        PrintLn("PASS: VidDetectFormat AVI"c);
    }
    free(buf1, 16);

    // -------------------------------------------------------------------------
    // Test 2: VidDetectFormat — MP4 ('ftyp' at offset 4)
    // -------------------------------------------------------------------------
    var buf2: int64 := alloc(16);
    poke8(buf2,   0x00); poke8(buf2+1, 0x00); poke8(buf2+2, 0x00); poke8(buf2+3, 0x14);
    poke8(buf2+4, 0x66); poke8(buf2+5, 0x74); poke8(buf2+6, 0x79); poke8(buf2+7, 0x70);
    poke8(buf2+8, 0x69); poke8(buf2+9, 0x73); poke8(buf2+10, 0x6F); poke8(buf2+11, 0x6D);
    poke8(buf2+12, 0); poke8(buf2+13, 0); poke8(buf2+14, 0); poke8(buf2+15, 0);
    var fmt2: int64 := VidDetectFormat(buf2, 16);
    if (fmt2 != VID_FMT_MP4) {
        PrintLn("FAIL: VidDetectFormat MP4"c);
        ok := 0;
    } else {
        PrintLn("PASS: VidDetectFormat MP4"c);
    }
    free(buf2, 16);

    // -------------------------------------------------------------------------
    // Test 3: VidDetectFormat — unknown
    // -------------------------------------------------------------------------
    var buf3: int64 := alloc(16);
    poke8(buf3, 0); poke8(buf3+1, 0); poke8(buf3+2, 0); poke8(buf3+3, 0);
    poke8(buf3+4, 0); poke8(buf3+5, 0); poke8(buf3+6, 0); poke8(buf3+7, 0);
    poke8(buf3+8, 0); poke8(buf3+9, 0); poke8(buf3+10, 0); poke8(buf3+11, 0);
    poke8(buf3+12, 0); poke8(buf3+13, 0); poke8(buf3+14, 0); poke8(buf3+15, 0);
    var fmt3: int64 := VidDetectFormat(buf3, 16);
    if (fmt3 != VID_FMT_UNKNOWN) {
        PrintLn("FAIL: VidDetectFormat unknown"c);
        ok := 0;
    } else {
        PrintLn("PASS: VidDetectFormat unknown"c);
    }
    free(buf3, 16);

    // -------------------------------------------------------------------------
    // Test 4: VidDetectFormat — too short
    // -------------------------------------------------------------------------
    var buf4: int64 := alloc(8);
    poke8(buf4, 0x52); poke8(buf4+1, 0x49); poke8(buf4+2, 0x46); poke8(buf4+3, 0x46);
    var fmt4: int64 := VidDetectFormat(buf4, 4);
    if (fmt4 != VID_FMT_UNKNOWN) {
        PrintLn("FAIL: VidDetectFormat too short"c);
        ok := 0;
    } else {
        PrintLn("PASS: VidDetectFormat too short → UNKNOWN"c);
    }
    free(buf4, 8);

    // -------------------------------------------------------------------------
    // Test 5: Codec constants are distinct
    // -------------------------------------------------------------------------
    var distinct: int64 := 1;
    if (VID_CODEC_MJPEG == VID_CODEC_H264) { distinct := 0; }
    if (VID_CODEC_H264  == VID_CODEC_H265) { distinct := 0; }
    if (VID_CODEC_H265  == VID_CODEC_AV1)  { distinct := 0; }
    if (VID_CODEC_AV1   == VID_CODEC_MP4V) { distinct := 0; }
    if (VID_CODEC_MP4V  == VID_CODEC_VP8)  { distinct := 0; }
    if (VID_CODEC_VP8   == VID_CODEC_VP9)  { distinct := 0; }
    if (distinct != 1) {
        PrintLn("FAIL: codec constants not distinct"c);
        ok := 0;
    } else {
        PrintLn("PASS: codec constants distinct"c);
    }

    if (ok != 0) {
        PrintLn("=== VID-00: ALL PASS ==="c);
    } else {
        PrintLn("=== VID-00: SOME FAIL ==="c);
    }
    return ok;
}
