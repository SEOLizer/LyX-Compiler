// LX-23 Test: var fd, err := sys_open + var n, _ := sys_read — Zwei-Register.

import src.std.lyxos.fs;

fn main(): int64 {
    var fd, err := sys_open("tests/lyxos/lx21_two_ret.lyx"c, O_RDONLY, 0);
    if err != 0 {
        return 1;
    }
    var n, _ := sys_read(fd, 0 as pchar, 0);
    sys_close(fd);
    if n < 0 {
        return 1;
    }
    return 0;
}
