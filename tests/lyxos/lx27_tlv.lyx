// LX-27 Test: TLV-Framework — nur Kompilierung prüfen (--target=lyxos)

import src.std.alloc;
import src.std.lyxos.lbf_layout;
import src.tools.lbf.tlv;

fn main(): int64 {
    var tbuf: int64 := alloc(LBF_TLV_MAX_SIZE);
    var pused: int64 := alloc(8);
    poke64(pused, 0);

    var cval: int64 := alloc(8);
    poke64(cval, LBF_CAP_FS_READ);

    tlv_append(tbuf, pused, LBF_TLV_CAPABILITIES, cval, 8);
    tlv_add_lifecycle(tbuf, pused, LBF_LC_ONE_SHOT);
    tlv_add_section(tbuf, pused, 1, 2, LBF_SECT_TYPE_TEXT, LBF_SECT_PROT_RX);

    var count: int64 := tlv_count(tbuf, peek64(pused));

    var ovp: int64 := alloc(8);
    var olp: int64 := alloc(8);
    tlv_find(tbuf, peek64(pused), LBF_TLV_CAPABILITIES, ovp, olp);

    free(cval, 8);
    free(tbuf, LBF_TLV_MAX_SIZE);
    free(pused, 8);
    free(ovp, 8);
    free(olp, 8);

    return count;
}
