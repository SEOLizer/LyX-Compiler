// LX-23 Test: sys_clock_get + sys_timer_create — nur Kompilierung prüfen.

import src.std.alloc;
import src.std.lyxos.time;

fn main(): int64 {
    var ts: int64 := alloc(16);
    sys_clock_get(CLOCK_MONO, ts);
    var tid: int64 := sys_timer_create(CLOCK_MONO, 1000000, TIMER_ONESHOT);
    return tid - tid;
}
