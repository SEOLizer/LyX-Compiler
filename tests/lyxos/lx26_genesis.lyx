// LX-26 Test: Genesis Content Serializer — nur Kompilierung prüfen (--target=lyxos)

import src.std.alloc;
import src.std.lyxos.lbf_layout;
import src.tools.lbf.genesis;

fn main(): int64 {
    var d: int64 := genesis_data_alloc();
    var p: int64 := alloc(4032);

    poke64(d + GEN_D_ENTRY_POINT, 0x401000);
    poke64(d + GEN_D_TEXT_BLOCKS, 1);

    genesis_serialize(d, p);

    var ep: int64 := genesis_get_entry_point(p);
    var total: int64 := genesis_get_total_block_count(p);

    var d2: int64 := genesis_data_alloc();
    genesis_deserialize(p, d2);

    genesis_data_free(d);
    genesis_data_free(d2);
    free(p, 4032);

    return ep + total;
}
