// WP-11: macOS x86_64 — StrEndsWith vollständig implementiert
//
// Verifies StrEndsWith correctness on x86_64 (Linux + macOS Mach-O).
// The implementation in codegen_x86.lyx uses two strlen calls, repe cmpsb,
// and sete al — identical code is emitted for both Linux ELF and macOS Mach-O
// because the macOS backend verbatim-copies user-code from offset 301+.
//
// Test matrix:
//   1. exact match                — StrEndsWith("hello", "hello")  → true
//   2. suffix present             — StrEndsWith("foobar", "bar")   → true
//   3. suffix absent              — StrEndsWith("foobar", "baz")   → false
//   4. suffix longer than string  — StrEndsWith("hi", "hello")     → false
//   5. empty suffix               — StrEndsWith("abc", "")         → true
//   6. empty string               — StrEndsWith("", "x")           → false
//
// Expected output:
//   PASS
import std.io;

fn main(): int64 {
  var ok: int64 := 1;

  // 1. exact match
  if !StrEndsWith("hello"c, "hello"c)  { ok := 0; PrintLn("FAIL 1"); }

  // 2. suffix present
  if !StrEndsWith("foobar"c, "bar"c)   { ok := 0; PrintLn("FAIL 2"); }

  // 3. suffix absent
  if StrEndsWith("foobar"c, "baz"c)    { ok := 0; PrintLn("FAIL 3"); }

  // 4. suffix longer than string
  if StrEndsWith("hi"c, "hello"c)      { ok := 0; PrintLn("FAIL 4"); }

  // 5. empty suffix — always true
  if !StrEndsWith("abc"c, ""c)         { ok := 0; PrintLn("FAIL 5"); }

  // 6. empty string, non-empty suffix
  if StrEndsWith(""c, "x"c)            { ok := 0; PrintLn("FAIL 6"); }

  // 7. both empty — empty suffix always matches
  if !StrEndsWith(""c, ""c)            { ok := 0; PrintLn("FAIL 7"); }

  if ok == 0 { return 1; }
  PrintLn("PASS");
  return 0;
}
