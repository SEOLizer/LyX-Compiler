// tests/bignum_test.lyx
// Selbstpruefende Testbatterie fuer std.bignum.
//
// Sollwerte aus Python, dessen Ganzzahlen von Haus aus beliebig gross sind.
// Dazu strukturelle Aussagen, die ohne fremde Zahl gelten:
//
//   * (a*b)/b = a und (a*b)%b = 0
//   * q*b + r = a, und |r| < |b|  — fuer jede Division
//   * a + (-a) = 0, a - b = -(b - a)
//   * ggT teilt beide Zahlen, und a*b = ggT * kgV
//   * Einlesen und Ausgeben sind zueinander invers
//   * Schieben um n ist Multiplikation mit 2^n
//
// Und der Nachweis, dass es ueberhaupt um etwas geht: Zahlen jenseits von 2^64
// werden richtig gerechnet, wo int64 laengst uebergelaufen waere.

unit main;

import std.bignum;
import std.bits;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;
var _buf: int64 := 0;

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr("\n"c);
  }
}

fn _streq(a: int64, b: pchar): bool {
  var i: int64 := 0;
  var run: bool := true;
  var ok: bool := true;
  while (run) {
    var x: int64 := peek8(a + i);
    var y: int64 := peek8(b + i);
    if (x != y) { ok := false; run := false; }
    else {
      if (x == 0) { run := false; }
    }
    i := i + 1;
  }
  return ok;
}

// Der Wert von p als Dezimalzeichenkette gegen einen Sollwert.
fn CheckDec(name: pchar, p: int64, want: pchar): void {
  _checks := _checks + 1;
  BigToDecimal(p, _buf, 512);
  if (!_streq(_buf, want)) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintStr(_buf);
    PrintStr(" want="c);
    PrintStr(want);
    PrintStr("\n"c);
  }
}

var _s: int64 := 88172645463325252;

fn Rnd(): int64 {
  _s := _s * 6364136223846793005 + 1442695040888963407;
  return _s;
}

fn main(): int64 {
  _buf := alloc(512);

  var a: int64 := BigNew(40);
  var b: int64 := BigNew(40);
  var c: int64 := BigNew(90);
  var d: int64 := BigNew(90);
  var q: int64 := BigNew(90);
  var r: int64 := BigNew(90);
  var t: int64 := BigNew(90);

  // ── Anlegen und Grundzustand ───────────────────────────────────────────────
  CheckI("newLen"c, BigLen(a), 0);
  CheckB("newIsZero"c, BigIsZero(a), true);
  CheckI("newSign"c, BigSign(a), 0);
  CheckB("newNotNeg"c, BigIsNeg(a), false);
  CheckDec("newDec"c, a, "0"c);
  CheckI("cap"c, BigCap(a), 40);

  BigSetU64(a, 42);
  CheckI("setU64Len"c, BigLen(a), 1);
  CheckI("setU64Sign"c, BigSign(a), 1);
  CheckDec("setU64Dec"c, a, "42"c);
  CheckI("toU64"c, BigToU64(a), 42);
  CheckB("fitsU64"c, BigFitsU64(a), true);

  BigSetU64(a, 0);
  CheckB("setZeroIsZero"c, BigIsZero(a), true);
  CheckI("setZeroLen"c, BigLen(a), 0);

  BigSetI64(a, 0 - 42);
  CheckB("setI64Neg"c, BigIsNeg(a), true);
  CheckI("setI64Sign"c, BigSign(a), 0 - 1);
  CheckDec("setI64Dec"c, a, "-42"c);
  // der kleinste int64 hat keinen darstellbaren Gegenwert in int64 —
  // als grosse Zahl aber sehr wohl
  BigSetI64(a, 1 << 63);
  CheckDec("setI64Min"c, a, "-9223372036854775808"c);
  BigSetU64(a, 1 << 63);
  CheckDec("setU64High"c, a, "9223372036854775808"c);
  // genau hier ist int64 zu Ende und die Unit faengt an
  BigSetU64(a, 0 - 1);
  CheckDec("setU64Max"c, a, "18446744073709551615"c);

  // ── Einlesen und Ausgeben ──────────────────────────────────────────────────
  CheckB("parse.ok"c, BigFromDecimal("123456789012345678901234567890"c, a), true);
  CheckDec("parse.roundTrip"c, a, "123456789012345678901234567890"c);
  CheckI("parse.len"c, BigLen(a), 2);
  CheckB("parse.neg"c, BigFromDecimal("-999999999999999999999999"c, a), true);
  CheckDec("parse.negDec"c, a, "-999999999999999999999999"c);
  CheckB("parse.plus"c, BigFromDecimal("+7"c, a), true);
  CheckDec("parse.plusDec"c, a, "7"c);
  CheckB("parse.zero"c, BigFromDecimal("0"c, a), true);
  CheckB("parse.zeroIsZero"c, BigIsZero(a), true);
  CheckB("parse.leadingZeros"c, BigFromDecimal("000042"c, a), true);
  CheckDec("parse.leadingZerosDec"c, a, "42"c);
  CheckB("parse.empty"c, BigFromDecimal(""c, a), false);
  CheckB("parse.letters"c, BigFromDecimal("12x4"c, a), false);
  CheckB("parse.null"c, BigFromDecimal(0, a), false);

  // 2^128 und 2^256 — jenseits von allem, was int64 kann
  BigFromDecimal("340282366920938463463374607431768211456"c, a);
  CheckDec("dec.2p128"c, a, "340282366920938463463374607431768211456"c);
  CheckI("dec.2p128Bits"c, BigBitLen(a), 129);
  BigFromDecimal("115792089237316195423570985008687907853269984665640564039457584007913129639936"c, a);
  CheckI("dec.2p256Bits"c, BigBitLen(a), 257);
  CheckI("dec.2p256Len"c, BigLen(a), 5);

  // ── Vergleichen ────────────────────────────────────────────────────────────
  BigSetU64(a, 100);
  BigSetU64(b, 200);
  CheckI("cmp.lt"c, BigCmp(a, b), 0 - 1);
  CheckI("cmp.gt"c, BigCmp(b, a), 1);
  CheckI("cmp.eq"c, BigCmp(a, a), 0);
  BigSetI64(a, 0 - 100);
  CheckI("cmp.negLtPos"c, BigCmp(a, b), 0 - 1);
  CheckI("cmp.absEqual"c, BigCmpAbs(a, b), 0 - 1);
  BigSetI64(b, 0 - 200);
  CheckI("cmp.bothNeg"c, BigCmp(a, b), 1);
  CheckI("cmpAbs.bothNeg"c, BigCmpAbs(a, b), 0 - 1);
  // verschiedene Laengen
  BigFromDecimal("18446744073709551616"c, a);
  BigSetU64(b, 0 - 1);
  CheckI("cmp.longerWins"c, BigCmp(a, b), 1);

  // ── Addieren und Subtrahieren ──────────────────────────────────────────────
  BigSetU64(a, 0 - 1);
  BigSetU64(b, 1);
  CheckB("add.carryOk"c, BigAdd(a, b, c), true);
  // 2^64-1 + 1 = 2^64, also ein neues Wort
  CheckDec("add.carriesToNewWord"c, c, "18446744073709551616"c);
  CheckI("add.newLen"c, BigLen(c), 2);

  BigFromDecimal("18446744073709551616"c, a);
  BigSetU64(b, 1);
  BigSub(a, b, c);
  CheckDec("sub.borrowsAcrossWord"c, c, "18446744073709551615"c);
  CheckI("sub.shrinks"c, BigLen(c), 1);

  // a + (-a) = 0
  BigFromDecimal("123456789012345678901234567890"c, a);
  BigNeg(a, b);
  BigAdd(a, b, c);
  CheckB("add.inverseIsZero"c, BigIsZero(c), true);
  CheckI("add.zeroSign"c, BigSign(c), 0);

  // a - b = -(b - a)
  BigFromDecimal("999999999999999999999"c, a);
  BigFromDecimal("123456789012345678"c, b);
  BigSub(a, b, c);
  BigSub(b, a, d);
  BigNeg(d, t);
  CheckB("sub.antisymmetric"c, BigEquals(c, t), true);
  CheckDec("sub.value"c, c, "999876543210987654321"c);

  // gemischte Vorzeichen
  BigSetI64(a, 0 - 50);
  BigSetU64(b, 30);
  BigAdd(a, b, c);
  CheckDec("add.negPlusPos"c, c, "-20"c);
  BigAdd(b, a, c);
  CheckDec("add.posPlusNeg"c, c, "-20"c);
  BigSub(b, a, c);
  CheckDec("sub.posMinusNeg"c, c, "80"c);
  BigSetU64(b, 50);
  BigAdd(a, b, c);
  CheckB("add.cancels"c, BigIsZero(c), true);

  // mit null
  BigZero(a);
  BigSetU64(b, 7);
  BigAdd(a, b, c);
  CheckDec("add.zeroLeft"c, c, "7"c);
  BigAdd(b, a, c);
  CheckDec("add.zeroRight"c, c, "7"c);
  BigSub(a, b, c);
  CheckDec("sub.zeroMinus"c, c, "-7"c);
  BigSub(b, a, c);
  CheckDec("sub.minusZero"c, c, "7"c);

  // ── Multiplizieren ─────────────────────────────────────────────────────────
  BigSetU64(a, 0 - 1);
  BigSetU64(b, 0 - 1);
  BigMul(a, b, c);
  // (2^64-1)^2 = 340282366920938463426481119284349108225
  CheckDec("mul.maxSquared"c, c, "340282366920938463426481119284349108225"c);

  BigFromDecimal("123456789012345678901234567890"c, a);
  BigFromDecimal("987654321098765432109876543210"c, b);
  BigMul(a, b, c);
  CheckDec("mul.big"c, c, "121932631137021795226185032733622923332237463801111263526900"c);

  BigZero(a);
  BigSetU64(b, 42);
  BigMul(a, b, c);
  CheckB("mul.byZero"c, BigIsZero(c), true);
  BigMul(b, a, c);
  CheckB("mul.zeroBy"c, BigIsZero(c), true);

  BigSetI64(a, 0 - 6);
  BigSetU64(b, 7);
  BigMul(a, b, c);
  CheckDec("mul.negPos"c, c, "-42"c);
  BigSetI64(b, 0 - 7);
  BigMul(a, b, c);
  CheckDec("mul.negNeg"c, c, "42"c);

  BigFromDecimal("123456789012345678901234567890"c, a);
  BigMulU64(a, 1000000, c);
  CheckDec("mulU64"c, c, "123456789012345678901234567890000000"c);
  BigMulU64(a, 0, c);
  CheckB("mulU64.zero"c, BigIsZero(c), true);

  // ── Schieben ───────────────────────────────────────────────────────────────
  BigSetU64(a, 1);
  BigShl(a, 64, c);
  CheckDec("shl.64"c, c, "18446744073709551616"c);
  BigShl(a, 128, c);
  CheckDec("shl.128"c, c, "340282366920938463463374607431768211456"c);
  BigShl(a, 0, c);
  CheckDec("shl.0"c, c, "1"c);
  BigShl(a, 1, c);
  CheckDec("shl.1"c, c, "2"c);

  BigFromDecimal("340282366920938463463374607431768211456"c, a);
  BigShr(a, 128, c);
  CheckDec("shr.128"c, c, "1"c);
  BigShr(a, 129, c);
  CheckB("shr.past"c, BigIsZero(c), true);
  BigShr(a, 1, c);
  CheckDec("shr.1"c, c, "170141183460469231731687303715884105728"c);

  // Schieben ist Multiplikation mit 2^n — ueber viele Werte geprueft
  var badShift: int64 := 0;
  var two: int64 := BigNew(4);
  var acc: int64 := BigNew(90);
  BigSetU64(two, 2);
  BigFromDecimal("123456789012345678901"c, a);
  BigCopy(a, acc);
  var i: int64 := 0;
  while (i < 80) {
    BigShl(a, i, c);
    if (!BigEquals(c, acc)) { badShift := badShift + 1; }
    BigMul(acc, two, d);
    BigCopy(d, acc);
    i := i + 1;
  }
  CheckI("shlIsMulByTwo"c, badShift, 0);
  BigFree(two);  BigFree(acc);

  // ── Bits ───────────────────────────────────────────────────────────────────
  BigZero(a);
  CheckI("bitLen.zero"c, BigBitLen(a), 0);
  BigSetU64(a, 1);
  CheckI("bitLen.one"c, BigBitLen(a), 1);
  BigSetU64(a, 255);
  CheckI("bitLen.255"c, BigBitLen(a), 8);
  BigSetU64(a, 0 - 1);
  CheckI("bitLen.u64max"c, BigBitLen(a), 64);
  BigFromDecimal("18446744073709551616"c, a);
  CheckI("bitLen.2p64"c, BigBitLen(a), 65);
  CheckB("testBit.64"c, BigTestBit(a, 64), true);
  CheckB("testBit.63"c, BigTestBit(a, 63), false);
  CheckB("testBit.oob"c, BigTestBit(a, 9999), false);
  CheckB("isOdd.even"c, BigIsOdd(a), false);
  BigSetU64(a, 7);
  CheckB("isOdd.odd"c, BigIsOdd(a), true);
  BigZero(a);
  CheckB("isOdd.zero"c, BigIsOdd(a), false);

  // ── Teilen ─────────────────────────────────────────────────────────────────
  BigSetU64(a, 100);
  BigSetU64(b, 7);
  CheckB("div.ok"c, BigDivRem(a, b, q, r), true);
  CheckDec("div.q"c, q, "14"c);
  CheckDec("div.r"c, r, "2"c);

  BigZero(b);
  CheckB("div.byZero"c, BigDivRem(a, b, q, r), false);

  BigSetU64(a, 5);
  BigSetU64(b, 100);
  BigDivRem(a, b, q, r);
  CheckB("div.smallerNum"c, BigIsZero(q), true);
  CheckDec("div.remIsNum"c, r, "5"c);

  BigFromDecimal("121932631137021795226185032733622923332237463801111263526900"c, a);
  BigFromDecimal("987654321098765432109876543210"c, b);
  BigDivRem(a, b, q, r);
  CheckDec("div.bigExact"c, q, "123456789012345678901234567890"c);
  CheckB("div.bigNoRem"c, BigIsZero(r), true);

  // Vorzeichen: Quotient Richtung null, Rest wie der Zaehler
  BigSetI64(a, 0 - 7);
  BigSetU64(b, 2);
  BigDivRem(a, b, q, r);
  CheckDec("divS.negQ"c, q, "-3"c);
  CheckDec("divS.negR"c, r, "-1"c);
  BigSetU64(a, 7);
  BigSetI64(b, 0 - 2);
  BigDivRem(a, b, q, r);
  CheckDec("divS.negDivQ"c, q, "-3"c);
  CheckDec("divS.negDivR"c, r, "1"c);

  // BigMod liefert immer einen nichtnegativen Rest
  BigSetI64(a, 0 - 7);
  BigSetU64(b, 3);
  BigMod(a, b, c);
  CheckDec("mod.negIsPositive"c, c, "2"c);
  BigSetU64(a, 7);
  BigMod(a, b, c);
  CheckDec("mod.pos"c, c, "1"c);
  // und der Unterschied zur Division ist festgehalten
  BigSetI64(a, 0 - 7);
  BigDivRem(a, b, q, r);
  CheckDec("mod.divRemDiffers"c, r, "-1"c);

  // ── ggT ────────────────────────────────────────────────────────────────────
  BigSetU64(a, 48);
  BigSetU64(b, 18);
  BigGcd(a, b, c);
  CheckDec("gcd.small"c, c, "6"c);
  BigSetU64(b, 0);
  BigGcd(a, b, c);
  CheckDec("gcd.withZero"c, c, "48"c);
  BigSetU64(a, 17);
  BigSetU64(b, 13);
  BigGcd(a, b, c);
  CheckDec("gcd.coprime"c, c, "1"c);
  // grosse Zahlen: Sollwert aus Python math.gcd
  BigFromDecimal("123456789012345678901234567890"c, a);
  BigFromDecimal("987654321098765432109876543210"c, b);
  BigGcd(a, b, c);
  CheckDec("gcd.big"c, c, "9000000000900000000090"c);
  // negatives Vorzeichen spielt keine Rolle
  BigNeg(a, d);
  BigGcd(d, b, c);
  CheckDec("gcd.ignoresSign"c, c, "9000000000900000000090"c);

  // ── Modulare Potenz ────────────────────────────────────────────────────────
  BigSetU64(a, 2);
  BigSetU64(b, 10);
  var m: int64 := BigNew(10);
  BigSetU64(m, 1000);
  BigPowMod(a, b, m, c);
  CheckDec("powMod.small"c, c, "24"c);

  BigSetU64(a, 3);
  BigSetU64(b, 0);
  BigPowMod(a, b, m, c);
  CheckDec("powMod.expZero"c, c, "1"c);

  BigSetU64(m, 1);
  BigSetU64(b, 100);
  BigPowMod(a, b, m, c);
  CheckB("powMod.modOne"c, BigIsZero(c), true);

  // der Fall, fuer den es die Funktion gibt: RSA-artige Groessen.
  // Sollwert aus Python pow(a, 65537, m).
  BigSetU64(m, 1000000007);
  BigFromDecimal("1234567890123456789"c, a);
  BigSetU64(b, 65537);
  BigPowMod(a, b, m, c);
  CheckDec("powMod.rsaLike"c, c, "346808349"c);

  // kleiner Fermat: a^(p-1) mod p = 1 fuer eine Primzahl p
  BigSetU64(m, 1000000007);
  BigSetU64(b, 1000000006);
  BigPowMod(a, b, m, c);
  CheckDec("powMod.fermat"c, c, "1"c);

  // ── Hex ────────────────────────────────────────────────────────────────────
  BigSetU64(a, 0);
  BigToHex(a, _buf, 512);
  CheckB("hex.zero"c, _streq(_buf, "0"c), true);
  BigSetU64(a, 255);
  BigToHex(a, _buf, 512);
  CheckB("hex.ff"c, _streq(_buf, "ff"c), true);
  BigSetU64(a, 0 - 1);
  BigToHex(a, _buf, 512);
  CheckB("hex.u64max"c, _streq(_buf, "ffffffffffffffff"c), true);
  BigFromDecimal("340282366920938463463374607431768211455"c, a);
  BigToHex(a, _buf, 512);
  CheckB("hex.2p128minus1"c, _streq(_buf, "ffffffffffffffffffffffffffffffff"c), true);
  BigSetU64(a, 1234567890123456789);
  BigToHex(a, _buf, 512);
  CheckB("hex.known"c, _streq(_buf, "112210f47de98115"c), true);

  // ── Die tragenden Identitaeten, ueber Zufallszahlen ────────────────────────
  //
  // Keine fremden Sollwerte: was hier geprueft wird, muss fuer JEDE Zahl gelten.
  var badMul: int64 := 0;
  var badDiv: int64 := 0;
  var badAdd: int64 := 0;
  var badRound: int64 := 0;

  var x: int64 := BigNew(12);
  var y: int64 := BigNew(12);
  var p1: int64 := BigNew(30);
  var p2: int64 := BigNew(30);

  var trial: int64 := 0;
  while (trial < 120) {
    // Zufallszahlen wechselnder Laenge aufbauen
    var lx: int64 := 1 + (trial % 5);
    var ly: int64 := 1 + ((trial * 3) % 4);
    BigZero(x);
    BigZero(y);
    var k: int64 := 0;
    while (k < lx) {
      BigMulU64(x, 0 - 1, p1);
      BigCopy(p1, x);
      var dg: int64 := BigNew(4);
      BigSetU64(dg, Rnd());
      BigAdd(x, dg, p1);
      BigCopy(p1, x);
      BigFree(dg);
      k := k + 1;
    }
    k := 0;
    while (k < ly) {
      BigMulU64(y, 0 - 1, p1);
      BigCopy(p1, y);
      var dg2: int64 := BigNew(4);
      BigSetU64(dg2, Rnd());
      BigAdd(y, dg2, p1);
      BigCopy(p1, y);
      BigFree(dg2);
      k := k + 1;
    }

    if (!BigIsZero(y)) {
      // (x*y)/y = x, Rest 0
      BigMul(x, y, p1);
      BigDivRemAbs(p1, y, q, r);
      if (!BigEquals(q, x)) { badMul := badMul + 1; }
      if (!BigIsZero(r)) { badMul := badMul + 1; }

      // x/y: q*y + r = x, und r < y
      BigDivRemAbs(x, y, q, r);
      BigMul(q, y, p2);
      BigAdd(p2, r, p1);
      if (!BigEquals(p1, x)) { badDiv := badDiv + 1; }
      if (BigCmpAbs(r, y) >= 0) { badDiv := badDiv + 1; }
    }

    // (x+y)-y = x
    BigAdd(x, y, p1);
    BigSub(p1, y, p2);
    if (!BigEquals(p2, x)) { badAdd := badAdd + 1; }

    // Ausgeben und wieder einlesen
    BigToDecimal(x, _buf, 512);
    if (!BigFromDecimal(_buf, p1)) { badRound := badRound + 1; }
    else {
      if (!BigEquals(p1, x)) { badRound := badRound + 1; }
    }

    trial := trial + 1;
  }
  CheckI("mulDivInverse"c, badMul, 0);
  CheckI("divReassembles"c, badDiv, 0);
  CheckI("addSubInverse"c, badAdd, 0);
  CheckI("decRoundTrip"c, badRound, 0);

  // ggT teilt beide Zahlen — ueber Zufallspaare
  var badGcd: int64 := 0;
  trial := 0;
  while (trial < 40) {
    BigSetU64(x, Rnd());
    BigSetU64(y, Rnd());
    if (!BigIsZero(x)) {
      if (!BigIsZero(y)) {
        BigGcd(x, y, q);
        if (BigIsZero(q)) { badGcd := badGcd + 1; }
        else {
          BigDivRemAbs(x, q, 0, r);
          if (!BigIsZero(r)) { badGcd := badGcd + 1; }
          BigDivRemAbs(y, q, 0, r);
          if (!BigIsZero(r)) { badGcd := badGcd + 1; }
        }
      }
    }
    trial := trial + 1;
  }
  CheckI("gcdDividesBoth"c, badGcd, 0);

  BigFree(x);  BigFree(y);  BigFree(p1);  BigFree(p2);

  // ── Kapazitaet ─────────────────────────────────────────────────────────────
  //
  // Zu kleine Ziele muessen false liefern, nicht ueber den Rand schreiben.
  var small: int64 := BigNew(1);
  BigSetU64(a, 0 - 1);
  BigSetU64(b, 0 - 1);
  CheckB("cap.addTooSmall"c, BigAdd(a, b, small), false);
  CheckB("cap.mulTooSmall"c, BigMul(a, b, small), false);
  BigFromDecimal("340282366920938463463374607431768211456"c, a);
  CheckB("cap.copyTooSmall"c, BigCopy(a, small), false);
  CheckB("cap.shlTooSmall"c, BigShl(a, 64, small), false);
  CheckI("cap.decTooSmall"c, BigToDecimal(a, _buf, 3), 0 - 1);
  CheckI("cap.hexTooSmall"c, BigToHex(a, _buf, 3), 0 - 1);
  BigFree(small);

  // ── Negativkontrollen ──────────────────────────────────────────────────────
  //
  // Erstens: die Identitaetspruefung muss anschlagen, wenn ein Ergebnis
  // verbogen wird.
  BigFromDecimal("123456789012345678901234567890"c, a);
  BigFromDecimal("987654321"c, b);
  BigMul(a, b, c);
  BigDivRemAbs(c, b, q, r);
  CheckB("negCtrl.holds"c, BigEquals(q, a), true);
  // ein Wort verbiegen
  BigSetU64(t, 1);
  BigAdd(c, t, d);
  BigDivRemAbs(d, b, q, r);
  CheckB("negCtrl.remainderChanges"c, BigIsZero(r), false);

  // Zweitens: der Nachweis, dass es um etwas geht. Dieselbe Rechnung in int64
  // laeuft ueber und liefert etwas anderes.
  var i1: int64 := 1234567890123456789;
  var i2: int64 := 987654321;
  var wrapped: int64 := i1 * i2;
  BigSetU64(a, i1);
  BigSetU64(b, i2);
  BigMul(a, b, c);
  CheckDec("negCtrl.bigIsRight"c, c, "1219326311248285321112635269"c);
  // int64 kippt um — das Ergebnis passt nicht in 64 Bit
  BigSetU64(t, wrapped);
  CheckB("negCtrl.int64Wraps"c, BigEquals(c, t), false);

  BigFree(a);  BigFree(b);  BigFree(c);  BigFree(d);
  BigFree(q);  BigFree(r);  BigFree(t);  BigFree(m);
  free(_buf, 512);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
