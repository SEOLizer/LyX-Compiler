// tests/cf_demo1_dns.lyx — Demo 1: DNS Multi-Env Setup + Cache Purge
// WP-CF-16

unit tests.cf_demo1_dns;

import std.cloud.cf.credentials;
import std.cloud.cf.transport;
import std.cloud.cf.zones;
import std.cloud.cf.dns;
import std.cloud.cf.cache;
import std.io;

pub fn main(argc: int64, argv: int64): int64 {
    var creds: CFCredentials := CFCredentialsFromEnv();
    var c: CFClient;
    c.authType:=creds.authType; c.token:=creds.token; c.apiKey:=creds.apiKey;
    c.email:=creds.email; c.accountId:=creds.accountId; c.zoneId:=creds.zoneId;
    c.timeout:=30000; c.maxRetries:=3;

    if (c.authType == 0) {
        PrintLn("Error: set CF_AUTH_TOKEN"c); return 1;
    }

    var domain: pchar := "example.com"c;
    PrintLn("=== CF Demo 1: DNS Multi-Env + Cache ==="c);

    // Look up zone
    Print("Finding zone for "c); PrintLn(domain);
    var zone: CFZone := ZoneGetByDomain(c, domain);
    if (zone.id == 0) { PrintLn("Zone not found"c); return 1; }
    var zoneId: pchar := zone.id as pchar;
    Print("Zone ID: "c); PrintLn(zoneId);

    // Production IP records (proxied)
    Print("Setting A records..."c);
    var r1: CFDNSRecord := DNSRecordUpsert(c, zoneId, "A"c, "@"c, "1.2.3.4"c, 1, 1);
    var r2: CFDNSRecord := DNSRecordUpsert(c, zoneId, "A"c, "www"c, "1.2.3.4"c, 1, 1);
    var r3: CFDNSRecord := DNSRecordUpsert(c, zoneId, "A"c, "api"c, "5.6.7.8"c, 1, 0);
    if (r1.id != 0 && r2.id != 0 && r3.id != 0) { PrintLn(" OK"c); }
    else { PrintLn(" FAILED"c); }
    CFDNSRecordFree(r1); CFDNSRecordFree(r2); CFDNSRecordFree(r3);

    // MX record
    Print("Setting MX record..."c);
    var mx: CFDNSRecord := DNSRecordCreateMX(c, zoneId, "@"c,
        "mail.example.com"c, 10);
    if (mx.id != 0) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }
    CFDNSRecordFree(mx);

    // SPF TXT
    Print("Setting SPF..."c);
    var spf: CFDNSRecord := DNSRecordCreateTXT(c, zoneId, "@"c,
        "v=spf1 include:_spf.google.com ~all"c);
    if (spf.id != 0) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }
    CFDNSRecordFree(spf);

    // DMARC TXT
    Print("Setting DMARC..."c);
    var dmarc: CFDNSRecord := DNSRecordCreateTXT(c, zoneId, "_dmarc"c,
        "v=DMARC1; p=quarantine; rua=mailto:dmarc@example.com"c);
    if (dmarc.id != 0) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }
    CFDNSRecordFree(dmarc);

    // Staging CNAME
    Print("Setting staging CNAME..."c);
    var stg: CFDNSRecord := DNSRecordCreateCNAME(c, zoneId, "staging"c,
        "staging.example.com.cdn.cloudflare.net"c, 0);
    if (stg.id != 0) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }
    CFDNSRecordFree(stg);

    // Purge cache
    Print("Purging cache..."c);
    var ok: int64 := CachePurgeAll(c, zoneId);
    if (ok == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }

    CFZoneFree(zone);
    PrintLn("Done."c);
    return 0;
}
