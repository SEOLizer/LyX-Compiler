// tests/grf01_bmp_test.lyx — GRF-01: BMP Decoder/Encoder Tests

unit tests.grf01_bmp_test;

import std.image.core;
import std.image.bmp;
import std.alloc;
import std.io;

// Build a minimal 24-bpp BMP in buf (must be >= 54 + rowBytes*h bytes).
// pixels: array of [r,g,b] triples, top-down order (will be stored bottom-up).
fn makeBmp24(buf: int64, w: int64, h: int64, rgbData: int64): int64 {
    var rowRaw:   int64 := w * 3;
    var rowBytes: int64 := ((rowRaw + 3) / 4) * 4;
    var pixBytes: int64 := rowBytes * h;
    var fileSize: int64 := 54 + pixBytes;

    // File header
    poke8(buf,     0x42); poke8(buf + 1, 0x4D);
    poke8(buf + 2, fileSize & 255); poke8(buf + 3, (fileSize >> 8) & 255);
    poke8(buf + 4, 0); poke8(buf + 5, 0); poke8(buf + 6, 0); poke8(buf + 7, 0);
    poke8(buf + 8, 0); poke8(buf + 9, 0);
    poke8(buf + 10, 54); poke8(buf + 11, 0); poke8(buf + 12, 0); poke8(buf + 13, 0);

    // BITMAPINFOHEADER
    poke8(buf + 14, 40); poke8(buf + 15, 0); poke8(buf + 16, 0); poke8(buf + 17, 0);
    // width
    poke8(buf + 18, w & 255); poke8(buf + 19, (w >> 8) & 255);
    poke8(buf + 20, 0);       poke8(buf + 21, 0);
    // height (positive = bottom-up)
    poke8(buf + 22, h & 255); poke8(buf + 23, (h >> 8) & 255);
    poke8(buf + 24, 0);       poke8(buf + 25, 0);
    // planes=1
    poke8(buf + 26, 1); poke8(buf + 27, 0);
    // bpp=24
    poke8(buf + 28, 24); poke8(buf + 29, 0);
    // compression=0
    poke8(buf + 30, 0); poke8(buf + 31, 0); poke8(buf + 32, 0); poke8(buf + 33, 0);
    // image size
    poke8(buf + 34, pixBytes & 255); poke8(buf + 35, (pixBytes >> 8) & 255);
    poke8(buf + 36, 0); poke8(buf + 37, 0);
    // x/y ppm + clr used/important = 0
    poke8(buf + 38, 0); poke8(buf + 39, 0); poke8(buf + 40, 0); poke8(buf + 41, 0);
    poke8(buf + 42, 0); poke8(buf + 43, 0); poke8(buf + 44, 0); poke8(buf + 45, 0);
    poke8(buf + 46, 0); poke8(buf + 47, 0); poke8(buf + 48, 0); poke8(buf + 49, 0);
    poke8(buf + 50, 0); poke8(buf + 51, 0); poke8(buf + 52, 0); poke8(buf + 53, 0);

    // Pixel data: BMP bottom-up, BGR order
    var row: int64 := 0;
    while (row < h) {
        var srcRow: int64 := h - 1 - row;   // flip: BMP row 0 = image last row
        var dst: int64 := buf + 54 + row * rowBytes;
        var x: int64 := 0;
        while (x < w) {
            var sp: int64 := rgbData + (srcRow * w + x) * 3;
            poke8(dst + x * 3,     peek8(sp + 2));   // B
            poke8(dst + x * 3 + 1, peek8(sp + 1));   // G
            poke8(dst + x * 3 + 2, peek8(sp));        // R
            x := x + 1;
        }
        // padding
        var pi: int64 := rowRaw;
        while (pi < rowBytes) {
            poke8(dst + pi, 0);
            pi := pi + 1;
        }
        row := row + 1;
    }
    return fileSize;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Test 1: 24-bpp 2x2 BMP decode, check RGB values and BGR swap
    // Pixel layout (row-major, top-down):
    //   (0,0)=FF0000  (1,0)=00FF00
    //   (0,1)=0000FF  (1,1)=FFFFFF
    // -------------------------------------------------------------------------
    var rgb2x2: int64 := alloc(12);
    poke8(rgb2x2,     0xFF); poke8(rgb2x2 + 1,  0x00); poke8(rgb2x2 + 2,  0x00); // R
    poke8(rgb2x2 + 3, 0x00); poke8(rgb2x2 + 4,  0xFF); poke8(rgb2x2 + 5,  0x00); // G
    poke8(rgb2x2 + 6, 0x00); poke8(rgb2x2 + 7,  0x00); poke8(rgb2x2 + 8,  0xFF); // B
    poke8(rgb2x2 + 9, 0xFF); poke8(rgb2x2 + 10, 0xFF); poke8(rgb2x2 + 11, 0xFF); // W

    var bmpBuf: int64 := alloc(128);
    makeBmp24(bmpBuf, 2, 2, rgb2x2);

    var img: int64 := alloc(GRF_SIZE);
    var ret: int64 := BmpDecode(bmpBuf, 128, img);
    if (ret != 1) {
        PrintLn("FAIL: BmpDecode 24-bpp 2x2"c);
        ok := 0;
    } else {
        PrintLn("PASS: BmpDecode 24-bpp 2x2 ret=1"c);
        var p00: int64 := GrfImageGetPixel(img, 0, 0);
        var p10: int64 := GrfImageGetPixel(img, 1, 0);
        var p01: int64 := GrfImageGetPixel(img, 0, 1);
        var p11: int64 := GrfImageGetPixel(img, 1, 1);
        if (p00 != 0xFF0000FF) {
            PrintLn("FAIL: (0,0) should be 0xFF0000FF"c);
            ok := 0;
        } else {
            PrintLn("PASS: (0,0) = 0xFF0000FF (red)"c);
        }
        if (p10 != 0x00FF00FF) {
            PrintLn("FAIL: (1,0) should be 0x00FF00FF"c);
            ok := 0;
        } else {
            PrintLn("PASS: (1,0) = 0x00FF00FF (green)"c);
        }
        if (p01 != 0x0000FFFF) {
            PrintLn("FAIL: (0,1) should be 0x0000FFFF"c);
            ok := 0;
        } else {
            PrintLn("PASS: (0,1) = 0x0000FFFF (blue)"c);
        }
        if (p11 != 0xFFFFFFFF) {
            PrintLn("FAIL: (1,1) should be 0xFFFFFFFF"c);
            ok := 0;
        } else {
            PrintLn("PASS: (1,1) = 0xFFFFFFFF (white)"c);
        }
    }
    GrfImageFree(img);
    free(bmpBuf, 128);
    free(rgb2x2, 12);

    // -------------------------------------------------------------------------
    // Test 2: Row padding — 1x1 24-bpp BMP, rowBytes must be 4 (not 3)
    // -------------------------------------------------------------------------
    var rgb1x1: int64 := alloc(3);
    poke8(rgb1x1, 0xAB); poke8(rgb1x1 + 1, 0xCD); poke8(rgb1x1 + 2, 0xEF);
    var bmpBuf1: int64 := alloc(64);
    makeBmp24(bmpBuf1, 1, 1, rgb1x1);
    // fileSize should be 54 + 4 = 58 (1 pixel * 3 bytes + 1 pad = 4 bytes per row)
    var fsize1: int64 := peek8(bmpBuf1 + 2) | (peek8(bmpBuf1 + 3) << 8);
    if (fsize1 != 58) {
        PrintLn("FAIL: 1x1 BMP fileSize != 58 (padding error)"c);
        ok := 0;
    } else {
        PrintLn("PASS: 1x1 BMP fileSize=58 (row padded to 4)"c);
    }

    var img1: int64 := alloc(GRF_SIZE);
    var ret1: int64 := BmpDecode(bmpBuf1, 64, img1);
    if (ret1 != 1) {
        PrintLn("FAIL: BmpDecode 1x1"c);
        ok := 0;
    } else {
        var p: int64 := GrfImageGetPixel(img1, 0, 0);
        if (p != 0xABCDEFFF) {
            PrintLn("FAIL: 1x1 pixel value wrong"c);
            ok := 0;
        } else {
            PrintLn("PASS: 1x1 pixel = 0xABCDEFFF"c);
        }
    }
    GrfImageFree(img1);
    free(bmpBuf1, 64);
    free(rgb1x1, 3);

    // -------------------------------------------------------------------------
    // Test 3: 32-bpp BMP decode with alpha channel
    // -------------------------------------------------------------------------
    var bmpBuf32: int64 := alloc(128);
    // Build 32-bpp BMP manually (1x1 pixel, BGRA)
    var fs32: int64 := 54 + 4;   // 1 pixel * 4 bytes, already aligned
    poke8(bmpBuf32,     0x42); poke8(bmpBuf32 + 1, 0x4D);
    poke8(bmpBuf32 + 2, fs32 & 255); poke8(bmpBuf32 + 3, 0);
    poke8(bmpBuf32 + 4, 0); poke8(bmpBuf32 + 5, 0);
    poke8(bmpBuf32 + 6, 0); poke8(bmpBuf32 + 7, 0);
    poke8(bmpBuf32 + 8, 0); poke8(bmpBuf32 + 9, 0);
    poke8(bmpBuf32 + 10, 54); poke8(bmpBuf32 + 11, 0);
    poke8(bmpBuf32 + 12, 0);  poke8(bmpBuf32 + 13, 0);
    // BITMAPINFOHEADER
    poke8(bmpBuf32 + 14, 40); poke8(bmpBuf32 + 15, 0);
    poke8(bmpBuf32 + 16, 0);  poke8(bmpBuf32 + 17, 0);
    poke8(bmpBuf32 + 18, 1);  poke8(bmpBuf32 + 19, 0);   // w=1
    poke8(bmpBuf32 + 20, 0);  poke8(bmpBuf32 + 21, 0);
    poke8(bmpBuf32 + 22, 1);  poke8(bmpBuf32 + 23, 0);   // h=1
    poke8(bmpBuf32 + 24, 0);  poke8(bmpBuf32 + 25, 0);
    poke8(bmpBuf32 + 26, 1);  poke8(bmpBuf32 + 27, 0);   // planes=1
    poke8(bmpBuf32 + 28, 32); poke8(bmpBuf32 + 29, 0);   // bpp=32
    // compression=0
    poke8(bmpBuf32 + 30, 0); poke8(bmpBuf32 + 31, 0);
    poke8(bmpBuf32 + 32, 0); poke8(bmpBuf32 + 33, 0);
    poke8(bmpBuf32 + 34, 4); poke8(bmpBuf32 + 35, 0);
    poke8(bmpBuf32 + 36, 0); poke8(bmpBuf32 + 37, 0);
    // remaining header fields = 0
    var hi: int64 := 38;
    while (hi < 54) { poke8(bmpBuf32 + hi, 0); hi := hi + 1; }
    // Pixel: BGRA = 0x11 0x22 0x33 0x80 → R=0x33, G=0x22, B=0x11, A=0x80
    poke8(bmpBuf32 + 54, 0x11);
    poke8(bmpBuf32 + 55, 0x22);
    poke8(bmpBuf32 + 56, 0x33);
    poke8(bmpBuf32 + 57, 0x80);

    var img32: int64 := alloc(GRF_SIZE);
    var ret32: int64 := BmpDecode(bmpBuf32, 128, img32);
    if (ret32 != 1) {
        PrintLn("FAIL: BmpDecode 32-bpp"c);
        ok := 0;
    } else {
        var p32: int64 := GrfImageGetPixel(img32, 0, 0);
        // BGRA 0x11,0x22,0x33,0x80 → RGBA 0x33221180
        if (p32 != 0x33221180) {
            PrintLn("FAIL: 32-bpp pixel alpha wrong"c);
            ok := 0;
        } else {
            PrintLn("PASS: 32-bpp pixel 0x33221180 (alpha=0x80)"c);
        }
    }
    GrfImageFree(img32);
    free(bmpBuf32, 128);

    // -------------------------------------------------------------------------
    // Test 4: BmpEncode → BmpDecode round-trip
    // -------------------------------------------------------------------------
    var imgSrc: int64 := GrfImageAlloc(3, 3);
    GrfImageSetPixel(imgSrc, 0, 0, 0xFF0000FF);
    GrfImageSetPixel(imgSrc, 1, 0, 0x00FF00FF);
    GrfImageSetPixel(imgSrc, 2, 0, 0x0000FFFF);
    GrfImageSetPixel(imgSrc, 0, 1, 0xFFFF00FF);
    GrfImageSetPixel(imgSrc, 1, 1, 0xFF00FFFF);
    GrfImageSetPixel(imgSrc, 2, 1, 0x00FFFFFF);
    GrfImageSetPixel(imgSrc, 0, 2, 0x808080FF);
    GrfImageSetPixel(imgSrc, 1, 2, 0x000000FF);
    GrfImageSetPixel(imgSrc, 2, 2, 0xFFFFFFFF);

    var encBuf: int64 := alloc(512);
    var encLen: int64 := BmpEncode(imgSrc, encBuf, 512);
    if (encLen <= 0) {
        PrintLn("FAIL: BmpEncode returned 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: BmpEncode returned > 0"c);
        var imgDst: int64 := alloc(GRF_SIZE);
        var retDec: int64 := BmpDecode(encBuf, encLen, imgDst);
        if (retDec != 1) {
            PrintLn("FAIL: BmpDecode on re-encoded data"c);
            ok := 0;
        } else {
            var rtOk: int64 := 1;
            var qy: int64 := 0;
            while (qy < 3) {
                var qx: int64 := 0;
                while (qx < 3) {
                    var pSrc: int64 := GrfImageGetPixel(imgSrc, qx, qy);
                    var pDst: int64 := GrfImageGetPixel(imgDst, qx, qy);
                    // Compare RGB only (BMP 24-bpp encoder drops alpha, restores as 255)
                    var srcRGB: int64 := pSrc >> 8;
                    var dstRGB: int64 := pDst >> 8;
                    if (srcRGB != dstRGB) { rtOk := 0; }
                    qx := qx + 1;
                }
                qy := qy + 1;
            }
            if (rtOk == 0) {
                PrintLn("FAIL: BmpEncode/BmpDecode round-trip pixel mismatch"c);
                ok := 0;
            } else {
                PrintLn("PASS: BmpEncode/BmpDecode round-trip 3x3"c);
            }
        }
        GrfImageFree(imgDst);
    }
    GrfImageFree(imgSrc);
    free(encBuf, 512);

    // -------------------------------------------------------------------------
    // Test 5: Error cases
    // -------------------------------------------------------------------------
    var emptyBuf: int64 := alloc(4);
    poke8(emptyBuf, 0); poke8(emptyBuf + 1, 0); poke8(emptyBuf + 2, 0); poke8(emptyBuf + 3, 0);
    var imgErr: int64 := alloc(GRF_SIZE);
    var retErr: int64 := BmpDecode(emptyBuf, 4, imgErr);
    if (retErr != 0) {
        PrintLn("FAIL: BmpDecode on bad data should return 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: BmpDecode bad signature → 0"c);
    }
    free(emptyBuf, 4);
    free(imgErr, GRF_SIZE);

    if (ok != 0) {
        PrintLn("=== GRF-01: ALL PASS ==="c);
    } else {
        PrintLn("=== GRF-01: SOME FAIL ==="c);
    }
    return ok;
}
