// LX-22 Test: Debug & Telemetrie (0x0A00–0x0A05) — nur Kompilierung prüfen.

import src.std.lyxos.debug;

fn main(): int64 {
    // sys_debug_print(msg, len) — Kernel-Debug-Output
    sys_debug_print("lx22: debug_print\n"c, 18);

    // sys_trace_event(event_id, data, data_len)
    sys_trace_event(TRACE_USER, 0 as pchar, 0);

    // sys_perf_counter(counter_id) — gibt Zählerwert zurück
    var cycles: int64 := sys_perf_counter(PERF_CYCLES);

    // sys_stack_trace(out_buf, max_frames) — gibt Anzahl Frames zurück
    var nframes: int64 := sys_stack_trace(0 as pchar, 0);

    // sys_watchpoint_set(addr, size, flags)
    sys_watchpoint_set(cycles, 8, WP_WRITE);

    // sys_watchpoint_clear(addr)
    sys_watchpoint_clear(cycles);

    return 0;
}
