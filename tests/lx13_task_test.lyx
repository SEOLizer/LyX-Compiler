// LX-13 Test: Task-Scheduler & Parallelität (0x0B00–0x0B09) — nur Kompilierung prüfen.

import src.std.lyxos.task;

fn main(): int64 {
    // sys_cpu_count / sys_affinity_hint
    var ncpu: int64 := sys_cpu_count();
    sys_affinity_hint(-1, 1);

    // sys_task_group_create / sys_task_group_add / sys_task_group_await
    var grp: int64 := sys_task_group_create(0);
    sys_task_group_add(grp, 0 as pchar, 0 as pchar, 0);
    sys_task_group_await(grp, -1);

    // sys_task_spawn / sys_task_cancel / sys_task_await
    var tfd: int64 := sys_task_spawn(0 as pchar, 0 as pchar, 0, TASK_DETACHED);
    sys_task_cancel(tfd);
    var res: int64 := sys_task_await(tfd, 0 as pchar, 0, -1);

    // sys_cpu_topology
    sys_cpu_topology(0 as pchar, 0);

    // sys_numa_alloc
    var mem: int64 := sys_numa_alloc(4096, NUMA_NODE_ANY, 3);

    return ncpu;
}
