// tests/edi05_delfor_test.lyx — EDI-05: DELFOR + DELJIT tests

unit tests.edi05_delfor_test;

import std.edi.core;
import std.edi.delfor;
import std.alloc;
import std.io;

fn hasTag(buf: int64, bufLen: int64, t0: int64, t1: int64, t2: int64): int64 {
    var i: int64 := 0;
    while (i + 2 < bufLen) {
        if (peek8(buf+i) == t0 && peek8(buf+i+1) == t1 && peek8(buf+i+2) == t2) {
            return 1;
        }
        i := i + 1;
    }
    return 0;
}

fn memEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
        if (peek8(a+i) != peek8(b+i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Tests 1-2: EdiDelforCheckCumu — regression detection
    // -------------------------------------------------------------------------
    var ck1: int64 := EdiDelforCheckCumu(100, 80);
    if (ck1 != 0) {
        PrintLn("FAIL: CheckCumu(100,80) should return 0"c); ok := 0;
    } else { PrintLn("PASS: CheckCumu(100,80) returns 0 (ok)"c); }

    var ck2: int64 := EdiDelforCheckCumu(70, 80);
    if (ck2 != 1) {
        PrintLn("FAIL: CheckCumu(70,80) should return 1 (warning)"c); ok := 0;
    } else { PrintLn("PASS: CheckCumu(70,80) returns 1 (warning)"c); }

    // -------------------------------------------------------------------------
    // Tests 3-6: DELFOR write — BGM 241, LIN, SCC, QTY tags present
    // -------------------------------------------------------------------------
    var buf1: int64 := alloc(4096);
    var zi: int64 := 0;
    while (zi < 4096) { poke8(buf1 + zi, 0); zi := zi + 1; }

    var line1: int64 := alloc(EDI_DELFOR_LINE_SIZE);
    zi := 0;
    while (zi < EDI_DELFOR_LINE_SIZE) { poke8(line1 + zi, 0); zi := zi + 1; }
    poke64(line1 + EDI_DELFOR_LINE_GTIN,    "01234565"c as int64);
    poke64(line1 + EDI_DELFOR_LINE_GTINLEN, 8);
    poke64(line1 + EDI_DELFOR_LINE_CUMULQTY, 350);
    poke64(line1 + EDI_DELFOR_LINE_REQCOUNT, 2);

    // req[0]: firm, qty=50, date=20260620
    var req0: int64 := line1 + EDI_DELFOR_LINE_REQS + 0 * EDI_DELFOR_REQ_SIZE;
    poke64(req0 + EDI_DELFOR_REQ_DATE, "20260620"c as int64);
    poke64(req0 + EDI_DELFOR_REQ_QTY,  50);
    poke64(req0 + EDI_DELFOR_REQ_TYPE, 1);

    // req[1]: planning, qty=100, date=20260627
    var req1: int64 := line1 + EDI_DELFOR_LINE_REQS + 1 * EDI_DELFOR_REQ_SIZE;
    poke64(req1 + EDI_DELFOR_REQ_DATE, "20260627"c as int64);
    poke64(req1 + EDI_DELFOR_REQ_QTY,  100);
    poke64(req1 + EDI_DELFOR_REQ_TYPE, 3);

    var w1: int64 := EdiDelforWrite("DLF001"c as int64, "20260615"c as int64, line1, 1, buf1, 4096);

    if (w1 <= 0) {
        PrintLn("FAIL: EdiDelforWrite should return > 0"c); ok := 0;
    } else { PrintLn("PASS: EdiDelforWrite returns > 0"c); }

    // BGM = 66,71,77
    if (hasTag(buf1, w1, 66, 71, 77) != 1) {
        PrintLn("FAIL: DELFOR missing BGM tag"c); ok := 0;
    } else { PrintLn("PASS: DELFOR has BGM tag"c); }

    // SCC = 83,67,67
    if (hasTag(buf1, w1, 83, 67, 67) != 1) {
        PrintLn("FAIL: DELFOR missing SCC tag"c); ok := 0;
    } else { PrintLn("PASS: DELFOR has SCC tag"c); }

    // QTY = 81,84,89
    if (hasTag(buf1, w1, 81, 84, 89) != 1) {
        PrintLn("FAIL: DELFOR missing QTY tag"c); ok := 0;
    } else { PrintLn("PASS: DELFOR has QTY tag"c); }

    // -------------------------------------------------------------------------
    // Tests 7-12: DELFOR round-trip (write → read → verify)
    // -------------------------------------------------------------------------
    var rlines: int64 := alloc(2 * EDI_DELFOR_LINE_SIZE);
    zi := 0;
    while (zi < 2 * EDI_DELFOR_LINE_SIZE) { poke8(rlines + zi, 0); zi := zi + 1; }

    var cnt: int64 := EdiDelforRead(buf1, w1, rlines, 2);

    if (cnt != 1) {
        PrintLn("FAIL: EdiDelforRead should return 1 line"c); ok := 0;
    } else { PrintLn("PASS: EdiDelforRead returns 1 line"c); }

    var rl0: int64 := rlines + 0 * EDI_DELFOR_LINE_SIZE;

    var rgp: int64 := peek64(rl0 + EDI_DELFOR_LINE_GTIN);
    var rgl: int64 := peek64(rl0 + EDI_DELFOR_LINE_GTINLEN);
    if (memEq(rgp, rgl, "01234565"c as int64, 8) != 1) {
        PrintLn("FAIL: DELFOR round-trip GTIN mismatch"c); ok := 0;
    } else { PrintLn("PASS: DELFOR round-trip GTIN matches"c); }

    var rcumu: int64 := peek64(rl0 + EDI_DELFOR_LINE_CUMULQTY);
    if (rcumu != 350) {
        PrintLn("FAIL: DELFOR round-trip cumulQty mismatch"c); ok := 0;
    } else { PrintLn("PASS: DELFOR round-trip cumulQty=350"c); }

    var rreqc: int64 := peek64(rl0 + EDI_DELFOR_LINE_REQCOUNT);
    if (rreqc != 2) {
        PrintLn("FAIL: DELFOR round-trip reqCount should be 2"c); ok := 0;
    } else { PrintLn("PASS: DELFOR round-trip reqCount=2"c); }

    // req[0] type must be 1 (firm)
    var rr0: int64 := rl0 + EDI_DELFOR_LINE_REQS + 0 * EDI_DELFOR_REQ_SIZE;
    var rt0: int64 := peek64(rr0 + EDI_DELFOR_REQ_TYPE);
    if (rt0 != 1) {
        PrintLn("FAIL: DELFOR req[0] type should be 1 (firm)"c); ok := 0;
    } else { PrintLn("PASS: DELFOR req[0] type=1 (firm)"c); }

    // req[1] type must be 3 (planning)
    var rr1: int64 := rl0 + EDI_DELFOR_LINE_REQS + 1 * EDI_DELFOR_REQ_SIZE;
    var rt1: int64 := peek64(rr1 + EDI_DELFOR_REQ_TYPE);
    if (rt1 != 3) {
        PrintLn("FAIL: DELFOR req[1] type should be 3 (planning)"c); ok := 0;
    } else { PrintLn("PASS: DELFOR req[1] type=3 (planning)"c); }

    // -------------------------------------------------------------------------
    // Tests 13-15: DELFOR req quantities and dates
    // -------------------------------------------------------------------------
    var rq0: int64 := peek64(rr0 + EDI_DELFOR_REQ_QTY);
    if (rq0 != 50) {
        PrintLn("FAIL: DELFOR req[0].qty should be 50"c); ok := 0;
    } else { PrintLn("PASS: DELFOR req[0].qty=50"c); }

    var rq1: int64 := peek64(rr1 + EDI_DELFOR_REQ_QTY);
    if (rq1 != 100) {
        PrintLn("FAIL: DELFOR req[1].qty should be 100"c); ok := 0;
    } else { PrintLn("PASS: DELFOR req[1].qty=100"c); }

    var rd0p: int64 := peek64(rr0 + EDI_DELFOR_REQ_DATE);
    var rd0l: int64 := 8;
    if (memEq(rd0p, rd0l, "20260620"c as int64, 8) != 1) {
        PrintLn("FAIL: DELFOR req[0].date should be 20260620"c); ok := 0;
    } else { PrintLn("PASS: DELFOR req[0].date=20260620"c); }

    free(rlines, 2 * EDI_DELFOR_LINE_SIZE);
    free(line1, EDI_DELFOR_LINE_SIZE);
    free(buf1, 4096);

    // -------------------------------------------------------------------------
    // Tests 16-19: DELJIT write — BGM 251, LIN, DTM, QTY, LOC tags
    // -------------------------------------------------------------------------
    var buf2: int64 := alloc(4096);
    zi := 0;
    while (zi < 4096) { poke8(buf2 + zi, 0); zi := zi + 1; }

    var jline: int64 := alloc(EDI_DELJIT_LINE_SIZE);
    zi := 0;
    while (zi < EDI_DELJIT_LINE_SIZE) { poke8(jline + zi, 0); zi := zi + 1; }
    poke64(jline + EDI_DELJIT_LINE_GTIN,    "01234565"c as int64);
    poke64(jline + EDI_DELJIT_LINE_GTINLEN, 8);
    poke64(jline + EDI_DELJIT_LINE_QTY,     25);
    poke64(jline + EDI_DELJIT_LINE_DATETIME, "202606151430"c as int64);
    poke64(jline + EDI_DELJIT_LINE_DTLEN,   12);
    poke64(jline + EDI_DELJIT_LINE_LOC,     "DEWHL"c as int64);
    poke64(jline + EDI_DELJIT_LINE_LOCLEN,  5);

    var w2: int64 := EdiDeljitWrite("JIT001"c as int64, "20260615"c as int64, jline, 1, buf2, 4096);

    if (w2 <= 0) {
        PrintLn("FAIL: EdiDeljitWrite should return > 0"c); ok := 0;
    } else { PrintLn("PASS: EdiDeljitWrite returns > 0"c); }

    // BGM = 66,71,77
    if (hasTag(buf2, w2, 66, 71, 77) != 1) {
        PrintLn("FAIL: DELJIT missing BGM tag"c); ok := 0;
    } else { PrintLn("PASS: DELJIT has BGM tag"c); }

    // LOC = 76,79,67
    if (hasTag(buf2, w2, 76, 79, 67) != 1) {
        PrintLn("FAIL: DELJIT missing LOC tag"c); ok := 0;
    } else { PrintLn("PASS: DELJIT has LOC tag"c); }

    // -------------------------------------------------------------------------
    // Tests 20-25: DELJIT round-trip
    // -------------------------------------------------------------------------
    var jrlines: int64 := alloc(2 * EDI_DELJIT_LINE_SIZE);
    zi := 0;
    while (zi < 2 * EDI_DELJIT_LINE_SIZE) { poke8(jrlines + zi, 0); zi := zi + 1; }

    var jcnt: int64 := EdiDeljitRead(buf2, w2, jrlines, 2);

    if (jcnt != 1) {
        PrintLn("FAIL: EdiDeljitRead should return 1 line"c); ok := 0;
    } else { PrintLn("PASS: EdiDeljitRead returns 1 line"c); }

    var jl0: int64 := jrlines + 0 * EDI_DELJIT_LINE_SIZE;

    var jgp: int64 := peek64(jl0 + EDI_DELJIT_LINE_GTIN);
    var jgl: int64 := peek64(jl0 + EDI_DELJIT_LINE_GTINLEN);
    if (memEq(jgp, jgl, "01234565"c as int64, 8) != 1) {
        PrintLn("FAIL: DELJIT round-trip GTIN mismatch"c); ok := 0;
    } else { PrintLn("PASS: DELJIT round-trip GTIN matches"c); }

    var jdtp: int64 := peek64(jl0 + EDI_DELJIT_LINE_DATETIME);
    var jdtl: int64 := peek64(jl0 + EDI_DELJIT_LINE_DTLEN);
    if (memEq(jdtp, jdtl, "202606151430"c as int64, 12) != 1) {
        PrintLn("FAIL: DELJIT round-trip datetime mismatch"c); ok := 0;
    } else { PrintLn("PASS: DELJIT round-trip datetime=202606151430"c); }

    var jqty: int64 := peek64(jl0 + EDI_DELJIT_LINE_QTY);
    if (jqty != 25) {
        PrintLn("FAIL: DELJIT round-trip qty should be 25"c); ok := 0;
    } else { PrintLn("PASS: DELJIT round-trip qty=25"c); }

    var jlocp: int64 := peek64(jl0 + EDI_DELJIT_LINE_LOC);
    var jlocl: int64 := peek64(jl0 + EDI_DELJIT_LINE_LOCLEN);
    if (memEq(jlocp, jlocl, "DEWHL"c as int64, 5) != 1) {
        PrintLn("FAIL: DELJIT round-trip location mismatch"c); ok := 0;
    } else { PrintLn("PASS: DELJIT round-trip location=DEWHL"c); }

    var jdtlen_val: int64 := peek64(jl0 + EDI_DELJIT_LINE_DTLEN);
    if (jdtlen_val != 12) {
        PrintLn("FAIL: DELJIT datetime length should be 12"c); ok := 0;
    } else { PrintLn("PASS: DELJIT datetime length=12 (CCYYMMDDHHMM)"c); }

    free(jrlines, 2 * EDI_DELJIT_LINE_SIZE);
    free(jline, EDI_DELJIT_LINE_SIZE);
    free(buf2, 4096);

    // -------------------------------------------------------------------------
    // Test 26: 52-week × 100-article DELFOR stress test (no overflow)
    // -------------------------------------------------------------------------
    var bigBuf: int64 := alloc(400000);
    var bigLines: int64 := alloc(100 * EDI_DELFOR_LINE_SIZE);
    zi := 0;
    while (zi < 100 * EDI_DELFOR_LINE_SIZE) { poke8(bigLines + zi, 0); zi := zi + 1; }

    var ai: int64 := 0;
    while (ai < 100) {
        var al: int64 := bigLines + ai * EDI_DELFOR_LINE_SIZE;
        poke64(al + EDI_DELFOR_LINE_GTIN,    "01234565"c as int64);
        poke64(al + EDI_DELFOR_LINE_GTINLEN, 8);
        poke64(al + EDI_DELFOR_LINE_CUMULQTY, (ai + 1) * 100);
        poke64(al + EDI_DELFOR_LINE_REQCOUNT, 52);
        var ri2: int64 := 0;
        while (ri2 < 52) {
            var rq: int64 := al + EDI_DELFOR_LINE_REQS + ri2 * EDI_DELFOR_REQ_SIZE;
            poke64(rq + EDI_DELFOR_REQ_DATE, "20260620"c as int64);
            poke64(rq + EDI_DELFOR_REQ_QTY,  10);
            // alternate firm/planning
            if (ri2 - (ri2 / 2) * 2 == 0) {
                poke64(rq + EDI_DELFOR_REQ_TYPE, 1);
            } else {
                poke64(rq + EDI_DELFOR_REQ_TYPE, 3);
            }
            ri2 := ri2 + 1;
        }
        ai := ai + 1;
    }

    var wBig: int64 := EdiDelforWrite("STRESS01"c as int64, "20260615"c as int64, bigLines, 100, bigBuf, 400000);

    if (wBig <= 0) {
        PrintLn("FAIL: stress DELFOR 52x100 should write > 0 bytes"c); ok := 0;
    } else { PrintLn("PASS: stress DELFOR 52x100 writes > 0 bytes (no overflow)"c); }

    free(bigLines, 100 * EDI_DELFOR_LINE_SIZE);
    free(bigBuf, 400000);

    // -------------------------------------------------------------------------
    // Test 27: EdiDelforCheckCumu equal quantities → 0 (no warning)
    // -------------------------------------------------------------------------
    var ck3: int64 := EdiDelforCheckCumu(100, 100);
    if (ck3 != 0) {
        PrintLn("FAIL: CheckCumu(100,100) should return 0"c); ok := 0;
    } else { PrintLn("PASS: CheckCumu(100,100) returns 0 (equal is ok)"c); }

    // -------------------------------------------------------------------------
    // Final result
    // -------------------------------------------------------------------------
    if (ok == 1) {
        PrintLn("ALL PASS"c);
    } else {
        PrintLn("SOME TESTS FAILED"c);
    }
    return 0;
}
