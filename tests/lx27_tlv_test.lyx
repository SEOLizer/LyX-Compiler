// LX-27 Test: TLV-Framework — Roundtrip, Overflow, Intent-Truncation (--target=x86_64)

import src.std.alloc;
import src.std.io;
import src.std.lyxos.lbf_layout;
import src.tools.lbf.tlv;

// Füllt len Bytes ab buf mit (start_val + i) & 0xFF.
fn fill_buf(buf: int64, len: int64, start_val: int64) {
    var i: int64 := 0;
    while i < len {
        poke8(buf + i, (start_val + i) & 0xFF);
        i := i + 1;
    }
}

// Vergleicht len Bytes — gibt 0 zurück wenn identisch, -1 sonst.
fn cmp_buf(a: int64, b: int64, len: int64): int64 {
    var i: int64 := 0;
    while i < len {
        if peek8(a + i) != peek8(b + i) { return 0 - 1; }
        i := i + 1;
    }
    return 0;
}

fn main(): int64 {
    var tbuf: int64 := alloc(LBF_TLV_MAX_SIZE);
    var pused: int64 := alloc(8);
    poke64(pused, 0);

    var out_vp: int64 := alloc(8);   // out_val pointer
    var out_lp: int64 := alloc(8);   // out_len pointer

    // ── Test 1–8: Roundtrip für alle 8 TLV-Typen ─────────────────────────────

    // Typ 1: HUMAN_INTENT (4 Bytes)
    var v1: int64 := alloc(4);
    fill_buf(v1, 4, 1);
    if tlv_append(tbuf, pused, LBF_TLV_HUMAN_INTENT, v1, 4) != 0 {
        EPrintStrLn("FAIL: append type 1"); return 1;
    }
    if tlv_find(tbuf, peek64(pused), LBF_TLV_HUMAN_INTENT, out_vp, out_lp) != 0 {
        EPrintStrLn("FAIL: find type 1"); return 1;
    }
    if peek64(out_lp) != 4 { EPrintStrLn("FAIL: type 1 length"); return 1; }
    if cmp_buf(v1, peek64(out_vp), 4) != 0 { EPrintStrLn("FAIL: type 1 content"); return 1; }
    free(v1, 4);

    // Typ 2: DEP_HASH_GRAPH (8 Bytes)
    var v2: int64 := alloc(8);
    fill_buf(v2, 8, 0x11);
    if tlv_append(tbuf, pused, LBF_TLV_DEP_HASH_GRAPH, v2, 8) != 0 {
        EPrintStrLn("FAIL: append type 2"); return 1;
    }
    if tlv_find(tbuf, peek64(pused), LBF_TLV_DEP_HASH_GRAPH, out_vp, out_lp) != 0 {
        EPrintStrLn("FAIL: find type 2"); return 1;
    }
    if peek64(out_lp) != 8 { EPrintStrLn("FAIL: type 2 length"); return 1; }
    if cmp_buf(v2, peek64(out_vp), 8) != 0 { EPrintStrLn("FAIL: type 2 content"); return 1; }
    free(v2, 8);

    // Typ 3: SYM_INTERFACE (8 Bytes)
    var v3: int64 := alloc(8);
    fill_buf(v3, 8, 0x21);
    if tlv_append(tbuf, pused, LBF_TLV_SYM_INTERFACE, v3, 8) != 0 {
        EPrintStrLn("FAIL: append type 3"); return 1;
    }
    if tlv_find(tbuf, peek64(pused), LBF_TLV_SYM_INTERFACE, out_vp, out_lp) != 0 {
        EPrintStrLn("FAIL: find type 3"); return 1;
    }
    if peek64(out_lp) != 8 { EPrintStrLn("FAIL: type 3 length"); return 1; }
    if cmp_buf(v3, peek64(out_vp), 8) != 0 { EPrintStrLn("FAIL: type 3 content"); return 1; }
    free(v3, 8);

    // Typ 4: ISA_EXTENSIONS (8 Bytes, uint64 LE)
    var v4: int64 := alloc(8);
    poke64(v4, 4);
    if tlv_append(tbuf, pused, LBF_TLV_ISA_EXTENSIONS, v4, 8) != 0 {
        EPrintStrLn("FAIL: append type 4"); return 1;
    }
    if tlv_find(tbuf, peek64(pused), LBF_TLV_ISA_EXTENSIONS, out_vp, out_lp) != 0 {
        EPrintStrLn("FAIL: find type 4"); return 1;
    }
    if peek64(out_lp) != 8 { EPrintStrLn("FAIL: type 4 length"); return 1; }
    if cmp_buf(v4, peek64(out_vp), 8) != 0 { EPrintStrLn("FAIL: type 4 content"); return 1; }
    free(v4, 8);

    // Typ 5: CAPABILITIES (8 Bytes, uint64 LE)
    var v5: int64 := alloc(8);
    poke64(v5, LBF_CAP_FS_READ | LBF_CAP_FS_WRITE);
    if tlv_append(tbuf, pused, LBF_TLV_CAPABILITIES, v5, 8) != 0 {
        EPrintStrLn("FAIL: append type 5"); return 1;
    }
    if tlv_find(tbuf, peek64(pused), LBF_TLV_CAPABILITIES, out_vp, out_lp) != 0 {
        EPrintStrLn("FAIL: find type 5"); return 1;
    }
    if peek64(out_lp) != 8 { EPrintStrLn("FAIL: type 5 length"); return 1; }
    if cmp_buf(v5, peek64(out_vp), 8) != 0 { EPrintStrLn("FAIL: type 5 content"); return 1; }
    free(v5, 8);

    // Typ 6: SOURCE_MAP (4 Bytes)
    var v6: int64 := alloc(4);
    fill_buf(v6, 4, 0x61);
    if tlv_append(tbuf, pused, LBF_TLV_SOURCE_MAP, v6, 4) != 0 {
        EPrintStrLn("FAIL: append type 6"); return 1;
    }
    if tlv_find(tbuf, peek64(pused), LBF_TLV_SOURCE_MAP, out_vp, out_lp) != 0 {
        EPrintStrLn("FAIL: find type 6"); return 1;
    }
    if peek64(out_lp) != 4 { EPrintStrLn("FAIL: type 6 length"); return 1; }
    if cmp_buf(v6, peek64(out_vp), 4) != 0 { EPrintStrLn("FAIL: type 6 content"); return 1; }
    free(v6, 4);

    // Typ 7: BUILD_MANIFEST (8 Bytes)
    var v7: int64 := alloc(8);
    fill_buf(v7, 8, 0x71);
    if tlv_append(tbuf, pused, LBF_TLV_BUILD_MANIFEST, v7, 8) != 0 {
        EPrintStrLn("FAIL: append type 7"); return 1;
    }
    if tlv_find(tbuf, peek64(pused), LBF_TLV_BUILD_MANIFEST, out_vp, out_lp) != 0 {
        EPrintStrLn("FAIL: find type 7"); return 1;
    }
    if peek64(out_lp) != 8 { EPrintStrLn("FAIL: type 7 length"); return 1; }
    if cmp_buf(v7, peek64(out_vp), 8) != 0 { EPrintStrLn("FAIL: type 7 content"); return 1; }
    free(v7, 8);

    // Typ 8: LIFECYCLE (1 Byte)
    var v8: int64 := alloc(1);
    poke8(v8, LBF_LC_DAEMON);
    if tlv_append(tbuf, pused, LBF_TLV_LIFECYCLE, v8, 1) != 0 {
        EPrintStrLn("FAIL: append type 8"); return 1;
    }
    if tlv_find(tbuf, peek64(pused), LBF_TLV_LIFECYCLE, out_vp, out_lp) != 0 {
        EPrintStrLn("FAIL: find type 8"); return 1;
    }
    if peek64(out_lp) != 1 { EPrintStrLn("FAIL: type 8 length"); return 1; }
    if peek8(peek64(out_vp)) != LBF_LC_DAEMON { EPrintStrLn("FAIL: type 8 content"); return 1; }
    free(v8, 1);

    // ── Test 9: tlv_count == 8 ────────────────────────────────────────────────
    if tlv_count(tbuf, peek64(pused)) != 8 {
        EPrintStrLn("FAIL: tlv_count != 8");
        return 1;
    }

    // ── Test 10: find auf nicht-vorhandenen Typ → -1 ──────────────────────────
    if tlv_find(tbuf, peek64(pused), LBF_TLV_SECTION_MAP, out_vp, out_lp) != (0 - 1) {
        EPrintStrLn("FAIL: find fehlender Typ != -1");
        return 1;
    }

    // ── Test 11: Pool-Überlauf ────────────────────────────────────────────────
    var ovfbuf: int64 := alloc(LBF_TLV_MAX_SIZE);
    var ovfused: int64 := alloc(8);
    poke64(ovfused, 0);

    // Füllt Puffer exakt: 3 + 3901 = 3904 Bytes
    var bigbuf: int64 := alloc(3901);
    fill_buf(bigbuf, 3901, 0xAA);
    if tlv_append(ovfbuf, ovfused, 1, bigbuf, 3901) != 0 {
        EPrintStrLn("FAIL: Großes Append fehlgeschlagen");
        return 1;
    }
    if peek64(ovfused) != 3904 {
        EPrintStrLn("FAIL: used nach großem Append falsch");
        return 1;
    }
    free(bigbuf, 3901);

    // Nächstes Append muss scheitern (3904 + 3 + 1 = 3908 > 3904)
    var onebuf: int64 := alloc(1);
    poke8(onebuf, 0xFF);
    if tlv_append(ovfbuf, ovfused, 1, onebuf, 1) != (0 - 1) {
        EPrintStrLn("FAIL: Overflow-Append sollte -1 zurückgeben");
        return 1;
    }
    if peek64(ovfused) != 3904 {
        EPrintStrLn("FAIL: used nach Overflow-Append verändert");
        return 1;
    }
    free(onebuf, 1);
    free(ovfbuf, LBF_TLV_MAX_SIZE);
    free(ovfused, 8);

    // ── Test 12: Intent > 512 Bytes → auf 512 Bytes gekürzt ──────────────────
    var intbuf: int64 := alloc(LBF_TLV_MAX_SIZE);
    var intused: int64 := alloc(8);
    poke64(intused, 0);

    var longtext: int64 := alloc(600);
    var lt: int64 := 0;
    while lt < 600 { poke8(longtext + lt, 65); lt := lt + 1; }  // 'A' = 65

    if tlv_add_intent(intbuf, intused, longtext) != 0 {
        EPrintStrLn("FAIL: tlv_add_intent mit langem Text");
        return 1;
    }
    if tlv_find(intbuf, peek64(intused), LBF_TLV_HUMAN_INTENT, out_vp, out_lp) != 0 {
        EPrintStrLn("FAIL: find nach tlv_add_intent");
        return 1;
    }
    if peek64(out_lp) != 512 {
        EPrintStrLn("FAIL: Intent > 512 nicht auf 512 gekürzt");
        return 1;
    }
    if peek8(peek64(out_vp)) != 65 {
        EPrintStrLn("FAIL: Intent-Inhalt falsch");
        return 1;
    }
    free(longtext, 600);
    free(intbuf, LBF_TLV_MAX_SIZE);
    free(intused, 8);

    // ── Test 13: tlv_add_capabilities ────────────────────────────────────────
    var capbuf: int64 := alloc(LBF_TLV_MAX_SIZE);
    var capused: int64 := alloc(8);
    poke64(capused, 0);

    if tlv_add_capabilities(capbuf, capused, LBF_CAP_NET_SOCKET) != 0 {
        EPrintStrLn("FAIL: tlv_add_capabilities"); return 1;
    }
    if tlv_find(capbuf, peek64(capused), LBF_TLV_CAPABILITIES, out_vp, out_lp) != 0 {
        EPrintStrLn("FAIL: find capabilities"); return 1;
    }
    if peek64(out_lp) != 8 { EPrintStrLn("FAIL: capabilities length"); return 1; }
    if peek64(peek64(out_vp)) != LBF_CAP_NET_SOCKET {
        EPrintStrLn("FAIL: capabilities value"); return 1;
    }
    free(capbuf, LBF_TLV_MAX_SIZE);
    free(capused, 8);

    // ── Test 14: tlv_add_lifecycle ────────────────────────────────────────────
    var lcbuf: int64 := alloc(LBF_TLV_MAX_SIZE);
    var lcused: int64 := alloc(8);
    poke64(lcused, 0);

    if tlv_add_lifecycle(lcbuf, lcused, LBF_LC_EVENT_LOOP) != 0 {
        EPrintStrLn("FAIL: tlv_add_lifecycle"); return 1;
    }
    if tlv_find(lcbuf, peek64(lcused), LBF_TLV_LIFECYCLE, out_vp, out_lp) != 0 {
        EPrintStrLn("FAIL: find lifecycle"); return 1;
    }
    if peek64(out_lp) != 1 { EPrintStrLn("FAIL: lifecycle length"); return 1; }
    if peek8(peek64(out_vp)) != LBF_LC_EVENT_LOOP {
        EPrintStrLn("FAIL: lifecycle value"); return 1;
    }
    free(lcbuf, LBF_TLV_MAX_SIZE);
    free(lcused, 8);

    // ── Test 15: tlv_add_section ──────────────────────────────────────────────
    var sbuf: int64 := alloc(LBF_TLV_MAX_SIZE);
    var sused: int64 := alloc(8);
    poke64(sused, 0);

    if tlv_add_section(sbuf, sused, 1, 3, LBF_SECT_TYPE_TEXT, LBF_SECT_PROT_RX) != 0 {
        EPrintStrLn("FAIL: tlv_add_section"); return 1;
    }
    if tlv_find(sbuf, peek64(sused), LBF_TLV_SECTION_MAP, out_vp, out_lp) != 0 {
        EPrintStrLn("FAIL: find section"); return 1;
    }
    if peek64(out_lp) != 8 { EPrintStrLn("FAIL: section length"); return 1; }
    var sect_addr: int64 := peek64(out_vp);
    if (peek32(sect_addr) & 0xFFFFFFFF) != 1 { EPrintStrLn("FAIL: section block_start"); return 1; }
    if peek16(sect_addr + 4) != 3 { EPrintStrLn("FAIL: section block_count"); return 1; }
    if peek8(sect_addr + 6) != LBF_SECT_TYPE_TEXT { EPrintStrLn("FAIL: section type"); return 1; }
    if peek8(sect_addr + 7) != LBF_SECT_PROT_RX { EPrintStrLn("FAIL: section prot"); return 1; }
    free(sbuf, LBF_TLV_MAX_SIZE);
    free(sused, 8);

    // ── Aufräumen ─────────────────────────────────────────────────────────────
    free(tbuf, LBF_TLV_MAX_SIZE);
    free(pused, 8);
    free(out_vp, 8);
    free(out_lp, 8);

    PrintStrLn("lx27: tlv framework OK");
    return 0;
}
