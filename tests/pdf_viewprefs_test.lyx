fn testViewOpenAction(): int64 {
  // 3-page PDF that opens to page 2 (0-based index 1)
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (openact)\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p2: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Cover");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Contents — opens here");
  PdfSetFont(doc, p2, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p2, 72.0, 750.0, "Chapter 1");

  PdfSetOpenAction(doc, 1);

  var err: int64 := PdfSave(doc, "/tmp/pdf_vp_openaction.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (openact)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_vp_openaction.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (openact)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 3) { Print("FAIL: openact page count\n"); return 1; }
  Print("OK: open action to page 2\n");
  return 0;
}

fn testViewTwoColumn(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (twocol)\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p2: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p3: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Left col page 1");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Right col page 1");
  PdfSetFont(doc, p2, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p2, 72.0, 750.0, "Left col page 2");
  PdfSetFont(doc, p3, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p3, 72.0, 750.0, "Right col page 2");

  PdfSetViewerFlags(doc, PDF_VIEW_TWO_COLUMN_LEFT | PDF_VIEW_DISPLAY_DOCTITLE);
  PdfSetTitle(doc, "Two Column Layout");

  var err: int64 := PdfSave(doc, "/tmp/pdf_vp_twocol.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (twocol)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_vp_twocol.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (twocol)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 4) { Print("FAIL: twocol page count\n"); return 1; }
  Print("OK: two-column layout + display doc title\n");
  return 0;
}

fn testViewNoPrefs(): int64 {
  // PDF without viewer prefs: unchanged behavior
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (noprefs)\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "Default viewer prefs");

  var err: int64 := PdfSave(doc, "/tmp/pdf_vp_none.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (noprefs)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_vp_none.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (noprefs)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 1) { Print("FAIL: noprefs page count\n"); return 1; }
  Print("OK: no viewer prefs — PDF unaffected\n");
  return 0;
}

pub fn main(): int64 {
  if (testViewFullscreen() != 0) { return 1; }
  if (testViewHideUI()     != 0) { return 1; }
  if (testViewOpenAction() != 0) { return 1; }
  if (testViewTwoColumn()  != 0) { return 1; }
  if (testViewNoPrefs()    != 0) { return 1; }
  Print("All WP-PDF-13 viewer preference tests passed.\n");
  return 0;
}
