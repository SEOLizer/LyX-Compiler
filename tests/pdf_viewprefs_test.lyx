// tests/pdf_viewprefs_test.lyx
// WP-PDF-13: viewer preferences

@description("WP-PDF-13: PDF viewer preference tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pdf_viewprefs_test;

import std.pdf;

fn testViewFullscreen(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Slide 1");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Slide 2");

  PdfSetViewerFlags(doc, PDF_VIEW_FULLSCREEN | PDF_VIEW_FIT_WINDOW);

  var err: int64 := PdfSave(doc, "/tmp/pdf_vp_fullscreen.pdf");
  PdfFree(doc);
  if (err != 0) {
    Print("FAIL: PdfSave (fullscreen) err=");
    PrintInt(err);
    Print("\n");
    return 1;
  }

  var rdr: int64 := PdfOpen("/tmp/pdf_vp_fullscreen.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (fullscreen)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 2) {
    Print("FAIL: fullscreen page count expected 2, got ");
    PrintInt(n);
    Print("\n");
    return 1;
  }
  Print("OK: fullscreen + fit-window\n");
  return 0;
}

