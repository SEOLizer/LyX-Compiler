  PdfSetViewerFlags(doc, PDF_VIEW_HIDE_TOOLBAR | PDF_VIEW_HIDE_MENUBAR | PDF_VIEW_HIDE_WINDOWUI | PDF_VIEW_CENTER_WINDOW);

  var err: int64 := PdfSave(doc, "/tmp/pdf_vp_hideui.pdf");
