// tests/aws_demo3_dynamodb.lyx — AWS SDK Demo: DynamoDB CRUD
// WP-AWS-15

unit tests.aws_demo3_dynamodb;

import std.cloud.aws.core;
import std.cloud.dynamodb;
import std.alloc;
import std.io;

pub fn main(argc: int64, argv: pchar): int64 {
    PrintLn("=== AWS DynamoDB Demo ==="c);

    var creds: AWSCreds := AWSCredentialsDefault();
    if (creds.accessKey == 0) {
        PrintLn("Error: no credentials found."c);
        return 1;
    }

    var region: pchar := "eu-central-1"c;
    if (creds.region != 0) { region := creds.region as pchar; }

    var client: DDBClient := DDBConnect(creds, region);
    var tableName: pchar := "lyxaws-demo-users"c;

    // 1. List tables
    PrintLn("--- List Tables ---"c);
    var tables: int64 := DDBListTables(client);
    if (tables != 0) { PrintLn(tables as pchar); free(tables, StrLen(tables as pchar)+1); }

    // 2. Create table (PAY_PER_REQUEST billing)
    PrintLn("--- Create Table ---"c);
    var ok: int64 := DDBCreateTableOnDemand(client, tableName, "userId"c, "S"c);
    if (ok == 1) { Print("Created table: "c); PrintLn(tableName); }
    else { PrintLn("Table exists or error (continuing)"c); }

    // 3. Describe table
    PrintLn("--- Describe Table ---"c);
    var desc: int64 := DDBDescribeTable(client, tableName);
    if (desc != 0) { PrintLn(desc as pchar); free(desc, StrLen(desc as pchar)+1); }

    // 4. Put items
    PrintLn("--- Put Items ---"c);
    var item1: DDBItem := DDBItemNew();
    DDBItemSetStr(item1, "userId"c, "user-001"c);
    DDBItemSetStr(item1, "name"c, "Alice Mueller"c);
    DDBItemSetStr(item1, "email"c, "alice@example.com"c);
    DDBItemSetNum(item1, "age"c, "30"c);
    DDBItemSetBool(item1, "active"c, 1);
    ok := DDBPutItem(client, tableName, item1);
    DDBItemFree(item1);
    if (ok == 1) { PrintLn("Put item1: OK"c); } else { PrintLn("Put item1: FAILED"c); }

    var item2: DDBItem := DDBItemNew();
    DDBItemSetStr(item2, "userId"c, "user-002"c);
    DDBItemSetStr(item2, "name"c, "Bob Schmidt"c);
    DDBItemSetStr(item2, "email"c, "bob@example.com"c);
    DDBItemSetNum(item2, "age"c, "25"c);
    DDBItemSetBool(item2, "active"c, 0);
    ok := DDBPutItem(client, tableName, item2);
    DDBItemFree(item2);
    if (ok == 1) { PrintLn("Put item2: OK"c); } else { PrintLn("Put item2: FAILED"c); }

    // 5. Get item
    PrintLn("--- Get Item ---"c);
    var result: int64 := DDBGetItem(client, tableName, "userId"c, "S"c, "user-001"c);
    if (result != 0) { PrintLn(result as pchar); free(result, StrLen(result as pchar)+1); }
    else { PrintLn("Not found or error"c); }

    // 6. Scan table
    PrintLn("--- Scan Table ---"c);
    var scan: int64 := DDBScan(client, tableName, 0 as pchar, 0 as pchar, 10);
    if (scan != 0) { PrintLn(scan as pchar); free(scan, StrLen(scan as pchar)+1); }

    // 7. Update item
    PrintLn("--- Update Item ---"c);
    result := DDBUpdateItem(client, tableName,
                            "userId"c, "S"c, "user-001"c,
                            "SET #age = :newage"c,
                            "{\"#age\":\"age\",\":newage\":{\"N\":\"31\"}}"c);
    if (result != 0) { PrintLn(result as pchar); free(result, StrLen(result as pchar)+1); }

    // 8. Delete items
    PrintLn("--- Delete Items ---"c);
    ok := DDBDeleteItem(client, tableName, "userId"c, "S"c, "user-001"c);
    if (ok == 1) { PrintLn("Deleted user-001"c); } else { PrintLn("Delete failed"c); }
    ok := DDBDeleteItem(client, tableName, "userId"c, "S"c, "user-002"c);
    if (ok == 1) { PrintLn("Deleted user-002"c); } else { PrintLn("Delete failed"c); }

    // 9. Delete table
    PrintLn("--- Delete Table ---"c);
    ok := DDBDeleteTable(client, tableName);
    if (ok == 1) { PrintLn("Table deleted"c); } else { PrintLn("Delete failed"c); }

    DDBClose(client);
    PrintLn("=== Done ==="c);
    return 0;
}
