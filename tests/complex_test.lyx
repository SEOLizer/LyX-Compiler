// tests/complex_test.lyx
// Selbstpruefende Testbatterie fuer std.complex — und fuer die
// Winkelfunktionen, die dafuer in std.mathx entstanden sind.
//
// Sollwerte, die nicht von Hand nachrechenbar sind, stammen aus Pythons
// cmath. Der grosse Abgleich laeuft ausserhalb dieser Datei als Fuzz ueber
// Bitmuster; hier stehen die Sonderfaelle, die ein Zufallsgenerator nie
// trifft — allen voran die Verzweigungsschnitte.

unit main;

import std.io;
import std.complex;
import std.mathx;
import std.math;
import std.math.constants;
import std.feq;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn EPS(): f64 { return 0.000000000001; }        // 1e-12
fn TIGHT(): f64 { return 0.0000000000000001; }  // 1e-16
fn Pi(): f64 { return PI; }

fn Fail(name: pchar): void {
  _fails := _fails + 1;
  PrintStr("FAIL "c);
  PrintStr(name);
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    Fail(name);
    PrintStr(" got="c); PrintBool(got);
    PrintStr(" want="c); PrintBool(want);
    PrintStr("\n"c);
  }
}

fn CheckF(name: pchar, got: f64, want: f64, eps: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > eps) {
    Fail(name);
    PrintStr(" got="c); PrintFloat(got);
    PrintStr(" want="c); PrintFloat(want);
    PrintStr("\n"c);
  }
}

fn CheckC(name: pchar, got: Cx, wr: f64, wi: f64, eps: f64): void {
  _checks := _checks + 1;
  var dr: f64 := AbsF64(CxRe(got) - wr);
  var di: f64 := AbsF64(CxIm(got) - wi);
  var off: bool := dr > eps || di > eps;
  if (off) {
    Fail(name);
    PrintStr(" got="c); PrintFloat(CxRe(got));
    PrintStr(","c); PrintFloat(CxIm(got));
    PrintStr(" want="c); PrintFloat(wr);
    PrintStr(","c); PrintFloat(wi);
    PrintStr("\n"c);
  }
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    Fail(name);
    PrintStr(" got="c); PrintInt(got);
    PrintStr(" want="c); PrintInt(want);
    PrintStr("\n"c);
  }
}

fn StrEq(a: int64, b: int64): bool {
  var i: int64 := 0;
  var eq: bool := true;
  var running: bool := true;
  while (running) {
    var ca: int64 := peek8(a + i);
    var cb: int64 := peek8(b + i);
    if (ca != cb) { eq := false; running := false; }
    if (running && ca == 0) { running := false; }
    i := i + 1;
  }
  return eq;
}

fn CheckS(name: pchar, buf: int64, want: pchar): void {
  _checks := _checks + 1;
  if (!StrEq(buf, want as int64)) {
    Fail(name);
    PrintStr(" got=\""c); PrintStr(buf as pchar);
    PrintStr("\" want=\""c); PrintStr(want);
    PrintStr("\"\n"c);
  }
}

fn main(): int64 {
  var buf: int64 := alloc(256);
  var nz: f64 := -0.0;

  // ── Konstruktion und Zugriff ──────────────────────────────────────────────
  var a: Cx := CxNew(3.0, 4.0);
  CheckF("re"c, CxRe(a), 3.0, 0.0);
  CheckF("im"c, CxIm(a), 4.0, 0.0);
  CheckC("copy"c, CxCopy(a), 3.0, 4.0, 0.0);
  CheckC("fromReal"c, CxFromReal(5.0), 5.0, 0.0, 0.0);
  CheckC("fromImag"c, CxFromImag(5.0), 0.0, 5.0, 0.0);
  CheckC("zero"c, CxZero(), 0.0, 0.0, 0.0);
  CheckC("one"c, CxOne(), 1.0, 0.0, 0.0);
  CheckC("i"c, CxI(), 0.0, 1.0, 0.0);
  CheckB("isZero"c, CxIsZero(CxZero()), true);
  CheckB("isZero_no"c, CxIsZero(a), false);
  CheckB("isReal"c, CxIsReal(CxFromReal(2.0)), true);
  CheckB("isReal_no"c, CxIsReal(a), false);
  CheckB("isFinite"c, CxIsFinite(a), true);

  // ── Grundrechenarten von Hand ─────────────────────────────────────────────
  var b: Cx := CxNew(1.0, 2.0);
  CheckC("add"c, CxAdd(a, b), 4.0, 6.0, 0.0);
  CheckC("sub"c, CxSub(a, b), 2.0, 2.0, 0.0);
  CheckC("neg"c, CxNeg(a), 0.0 - 3.0, 0.0 - 4.0, 0.0);
  CheckC("conj"c, CxConj(a), 3.0, 0.0 - 4.0, 0.0);
  // (3+4i)(1+2i) = 3+6i+4i-8 = -5+10i
  CheckC("mul"c, CxMul(a, b), 0.0 - 5.0, 10.0, 0.0);
  // i*i = -1 — die Rechenregel, aus der alles folgt
  CheckC("i_squared"c, CxMul(CxI(), CxI()), 0.0 - 1.0, 0.0, 0.0);
  CheckC("mulReal"c, CxMulReal(a, 2.0), 6.0, 8.0, 0.0);
  CheckC("addReal"c, CxAddReal(a, 1.0), 4.0, 4.0, 0.0);
  CheckC("subReal"c, CxSubReal(a, 1.0), 2.0, 4.0, 0.0);
  CheckC("divReal"c, CxDivReal(a, 2.0), 1.5, 2.0, 0.0);
  // (3+4i)/(1+2i) = (3+4i)(1-2i)/5 = (11-2i)/5
  CheckC("div"c, CxDiv(a, b), 2.2, 0.0 - 0.4, EPS());
  CheckC("inv"c, CxInv(CxNew(0.0, 2.0)), 0.0, 0.0 - 0.5, EPS());
  CheckC("divSelf"c, CxDiv(a, a), 1.0, 0.0, EPS());

  // ── Division nach Smith: der Fall, den die Lehrbuchformel verliert ────────
  //
  // Bei Nennern um 1e200 ueberlaeuft c^2 + d^2 nach unendlich, obwohl der
  // Quotient voellig harmlos ist. Smith klammert den groesseren Nenner aus und
  // kommt ohne dieses Quadrat aus.
  var huge: Cx := CxNew(1.0e200, 1.0e200);
  var q1: Cx := CxDiv(huge, huge);
  CheckC("div_hugeSelf"c, q1, 1.0, 0.0, EPS());
  var q2: Cx := CxDiv(CxNew(2.0e200, 0.0), CxNew(1.0e200, 0.0));
  CheckC("div_hugeReal"c, q2, 2.0, 0.0, EPS());
  // Negativkontrolle: die naive Formel liefert hier wirklich Unsinn. Wenn
  // diese Zeile je "false" wird, ueberlaeuft das Quadrat nicht mehr und der
  // Test prueft nichts.
  var naiveDen: f64 := 1.0e200 * 1.0e200 + 1.0e200 * 1.0e200;
  var naiveOverflows: bool := FeqIsInf(naiveDen);
  CheckB("div_naiveOverflows"c, naiveOverflows, true);
  // und ebenso am unteren Ende
  var tiny: Cx := CxNew(1.0e-200, 1.0e-200);
  CheckC("div_tinySelf"c, CxDiv(tiny, tiny), 1.0, 0.0, EPS());
  var naiveTiny: f64 := 1.0e-200 * 1.0e-200;
  CheckB("div_naiveUnderflows"c, naiveTiny == 0.0, true);

  // ── Betrag und Argument ───────────────────────────────────────────────────
  CheckF("abs"c, CxAbs(CxNew(3.0, 4.0)), 5.0, 0.0);
  CheckF("abs2"c, CxAbs2(CxNew(3.0, 4.0)), 25.0, 0.0);
  CheckF("abs_zero"c, CxAbs(CxZero()), 0.0, 0.0);
  // ueberlaufsicher, wie in std.dist
  CheckF("abs_huge"c, CxAbs(CxNew(3.0e200, 4.0e200)), 5.0e200, 1.0e188);
  var naiveAbs: f64 := SqrtF64(3.0e200 * 3.0e200 + 4.0e200 * 4.0e200);
  CheckB("abs_naiveOverflows"c, FeqIsInf(naiveAbs), true);
  CheckF("arg_pos"c, CxArg(CxNew(1.0, 0.0)), 0.0, 0.0);
  CheckF("arg_i"c, CxArg(CxNew(0.0, 1.0)), Pi() / 2.0, EPS());
  CheckF("arg_negI"c, CxArg(CxNew(0.0, 0.0 - 1.0)), 0.0 - Pi() / 2.0, EPS());
  CheckF("arg_diag"c, CxArg(CxNew(1.0, 1.0)), Pi() / 4.0, EPS());
  CheckC("normalize"c, CxNormalize(CxNew(3.0, 4.0)), 0.6, 0.8, EPS());
  CheckC("normalize_zero"c, CxNormalize(CxZero()), 0.0, 0.0, 0.0);

  // ── Verzweigungsschnitte ──────────────────────────────────────────────────
  //
  // Der Kern der ganzen Einheit. Auf der negativen reellen Achse entscheidet
  // allein das Vorzeichen der Null im Imaginaerteil, welche Seite gemeint ist.
  // Ein Vergleich `im == 0` kann das nicht sehen — beide Nullen sind gleich.
  CheckF("arg_negRe_upper"c, CxArg(CxNew(0.0 - 1.0, 0.0)), Pi(), EPS());
  CheckF("arg_negRe_lower"c, CxArg(CxNew(0.0 - 1.0, nz)), 0.0 - Pi(), EPS());
  CheckC("log_negRe_upper"c, CxLog(CxNew(0.0 - 1.0, 0.0)), 0.0, Pi(), EPS());
  CheckC("log_negRe_lower"c, CxLog(CxNew(0.0 - 1.0, nz)), 0.0, 0.0 - Pi(), EPS());
  // Die beiden Ufer MUESSEN sich unterscheiden — sonst prueft der Test nichts
  var upper: Cx := CxLog(CxNew(0.0 - 2.0, 0.0));
  var lower: Cx := CxLog(CxNew(0.0 - 2.0, nz));
  var cutDiffers: bool := CxIm(upper) != CxIm(lower);
  CheckB("log_cutHasTwoSides"c, cutDiffers, true);
  CheckF("log_cutJump"c, CxIm(upper) - CxIm(lower), 2.0 * Pi(), EPS());
  // sqrt erbt den Schnitt: sqrt(-4) ist 2i von oben, -2i von unten
  CheckC("sqrt_negRe_upper"c, CxSqrt(CxNew(0.0 - 4.0, 0.0)), 0.0, 2.0, EPS());
  CheckC("sqrt_negRe_lower"c, CxSqrt(CxNew(0.0 - 4.0, nz)), 0.0, 0.0 - 2.0, EPS());
  // Das Vorzeichenbit ueberlebt in der Sprache — sonst waere all das unmoeglich
  CheckB("negZero_survives"c, FeqSignBit(nz), true);
  CheckB("posZero_clean"c, FeqSignBit(0.0), false);
  // arg(+1 - 0i) ist -0.0, nicht +0.0
  CheckB("arg_negZeroResult"c, FeqSignBit(CxArg(CxNew(1.0, nz))), true);

  // ── Exponentialfunktion und Logarithmus ───────────────────────────────────
  CheckC("exp_zero"c, CxExp(CxZero()), 1.0, 0.0, 0.0);
  CheckC("exp_one"c, CxExp(CxOne()), 2.718281828459045, 0.0, EPS());
  // Eulersche Identitaet: e^(i*pi) = -1
  CheckC("exp_iPi"c, CxExp(CxNew(0.0, Pi())), 0.0 - 1.0, 0.0, EPS());
  CheckC("exp_iHalfPi"c, CxExp(CxNew(0.0, Pi() / 2.0)), 0.0, 1.0, EPS());
  CheckC("log_one"c, CxLog(CxOne()), 0.0, 0.0, 0.0);
  CheckC("log_e"c, CxLog(CxFromReal(2.718281828459045)), 1.0, 0.0, EPS());
  CheckC("log_i"c, CxLog(CxI()), 0.0, Pi() / 2.0, EPS());
  CheckC("log10_100"c, CxLog10(CxFromReal(100.0)), 2.0, 0.0, EPS());
  CheckC("log2_8"c, CxLog2(CxFromReal(8.0)), 3.0, 0.0, EPS());
  // Rundreise
  var z1: Cx := CxNew(0.7, 1.3);
  CheckC("logExp_round"c, CxLog(CxExp(z1)), 0.7, 1.3, EPS());
  CheckC("expLog_round"c, CxExp(CxLog(z1)), 0.7, 1.3, EPS());

  // log ist nahe |z| = 1 besonders heikel: dort loescht der Logarithmus die
  // fuehrenden Stellen seines Arguments aus. Deshalb rechnet CxLog dort ueber
  // log1p. Ein Wert dicht an 1 prueft genau diesen Zweig.
  var near1: Cx := CxNew(1.0, 0.000001);
  CheckF("log_near1_re"c, CxRe(CxLog(near1)), 4.9999999999975e-13, 1.0e-24);
  CheckF("log_near1_im"c, CxIm(CxLog(near1)), 9.999999999996666e-07, 1.0e-20);

  // ── Wurzel ────────────────────────────────────────────────────────────────
  CheckC("sqrt_4"c, CxSqrt(CxFromReal(4.0)), 2.0, 0.0, EPS());
  CheckC("sqrt_zero"c, CxSqrt(CxZero()), 0.0, 0.0, 0.0);
  CheckC("sqrt_i"c, CxSqrt(CxI()), 0.7071067811865476, 0.7071067811865476, EPS());
  // Probe: die Wurzel quadriert ergibt wieder den Ausgangswert
  var sq: Cx := CxSqrt(CxNew(0.0 - 7.0, 3.0));
  CheckC("sqrt_squared"c, CxMul(sq, sq), 0.0 - 7.0, 3.0, EPS());
  var sq2: Cx := CxSqrt(CxNew(1.0e-300, 1.0e-300));
  CheckB("sqrt_tinyFinite"c, CxIsFinite(sq2), true);

  // ── Potenzen ──────────────────────────────────────────────────────────────
  CheckC("powInt_0"c, CxPowInt(a, 0), 1.0, 0.0, 0.0);
  CheckC("powInt_1"c, CxPowInt(a, 1), 3.0, 4.0, 0.0);
  // (3+4i)^2 = 9+24i-16 = -7+24i
  CheckC("powInt_2"c, CxPowInt(a, 2), 0.0 - 7.0, 24.0, EPS());
  CheckC("powInt_neg"c, CxPowInt(CxNew(0.0, 2.0), 0 - 2), 0.0 - 0.25, 0.0, EPS());
  // i^4 = 1, und das exakt: CxPowInt kommt ohne Winkelfunktionen aus
  CheckC("powInt_i4"c, CxPowInt(CxI(), 4), 1.0, 0.0, 0.0);
  CheckC("powInt_i3"c, CxPowInt(CxI(), 3), 0.0, 0.0 - 1.0, 0.0);
  // reelle Basis bleibt exakt reell — der Vorteil gegenueber exp(n*log z)
  CheckC("powInt_realStaysReal"c, CxPowInt(CxFromReal(3.0), 3), 27.0, 0.0, 0.0);
  CheckB("powInt_imExactZero"c, CxIm(CxPowInt(CxFromReal(3.0), 5)) == 0.0, true);
  CheckC("powReal"c, CxPowReal(CxFromReal(4.0), 0.5), 2.0, 0.0, EPS());
  CheckC("pow_zeroExp"c, CxPow(a, CxZero()), 1.0, 0.0, 0.0);
  CheckC("pow_ofZero"c, CxPow(CxZero(), CxFromReal(2.0)), 0.0, 0.0, 0.0);
  CheckC("pow_zeroZero"c, CxPow(CxZero(), CxZero()), 1.0, 0.0, 0.0);
  // i hoch i ist reell — das beruehmte Beispiel
  CheckC("pow_iToI"c, CxPow(CxI(), CxI()), 0.20787957635076193, 0.0, EPS());

  // ── Einheitswurzeln ───────────────────────────────────────────────────────
  var rr: int64 := alloc(8 * 8);
  var ri: int64 := alloc(8 * 8);
  CheckB("roots_ok"c, CxRoots(CxOne(), 4, rr, ri), true);
  CheckB("roots_badN"c, CxRoots(CxOne(), 0, rr, ri), false);
  // Die vierten Einheitswurzeln sind 1, i, -1, -i
  CheckC("root4_0"c, CxLoad(rr, ri, 0), 1.0, 0.0, EPS());
  CheckC("root4_1"c, CxLoad(rr, ri, 1), 0.0, 1.0, EPS());
  CheckC("root4_2"c, CxLoad(rr, ri, 2), 0.0 - 1.0, 0.0, EPS());
  CheckC("root4_3"c, CxLoad(rr, ri, 3), 0.0, 0.0 - 1.0, EPS());
  // Strukturell: jede Wurzel hoch n gibt den Ausgangswert zurueck, und alle
  // n Wurzeln summieren sich zu null (fuer n > 1)
  var zr: Cx := CxNew(0.0 - 5.0, 2.0);
  CxRoots(zr, 5, rr, ri);
  var sumR: Cx := CxZero();
  var k: int64 := 0;
  var rootFails: int64 := 0;
  while (k < 5) {
    var w: Cx := CxLoad(rr, ri, k);
    var p5: Cx := CxPowInt(w, 5);
    var off: bool := !CxApproxEq(p5, zr, 0.000000001);
    if (off) { rootFails := rootFails + 1; }
    sumR := CxAdd(sumR, w);
    k := k + 1;
  }
  CheckI("roots_allRaiseBack"c, rootFails, 0);
  CheckC("roots_sumZero"c, sumR, 0.0, 0.0, 0.000000001);

  // ── Trigonometrie und hyperbolische Funktionen ────────────────────────────
  CheckC("sin_zero"c, CxSin(CxZero()), 0.0, 0.0, 0.0);
  CheckC("cos_zero"c, CxCos(CxZero()), 1.0, 0.0, 0.0);
  CheckC("sin_real"c, CxSin(CxFromReal(1.0)), 0.8414709848078965, 0.0, EPS());
  CheckC("cos_real"c, CxCos(CxFromReal(1.0)), 0.5403023058681398, 0.0, EPS());
  // sin(i) = i*sinh(1)
  CheckC("sin_i"c, CxSin(CxI()), 0.0, 1.1752011936438014, EPS());
  CheckC("cos_i"c, CxCos(CxI()), 1.5430806348152437, 0.0, EPS());
  CheckC("sinh_zero"c, CxSinh(CxZero()), 0.0, 0.0, 0.0);
  CheckC("cosh_zero"c, CxCosh(CxZero()), 1.0, 0.0, 0.0);
  CheckC("tan_zero"c, CxTan(CxZero()), 0.0, 0.0, 0.0);
  CheckC("tanh_zero"c, CxTanh(CxZero()), 0.0, 0.0, 0.0);

  // Identitaeten ueber viele Werte statt Einzelwerte
  var idFails: int64 := 0;
  var ii: int64 := 0;
  while (ii < 40) {
    var t: f64 := ((ii as f64) - 20.0) * 0.31;
    var zz: Cx := CxNew(t, t * 0.5 - 0.3);
    // sin^2 + cos^2 = 1
    var s: Cx := CxSin(zz);
    var c: Cx := CxCos(zz);
    var one: Cx := CxAdd(CxMul(s, s), CxMul(c, c));
    if (!CxApproxEq(one, CxOne(), 0.000000001)) { idFails := idFails + 1; }
    // cosh^2 - sinh^2 = 1
    var sh: Cx := CxSinh(zz);
    var ch: Cx := CxCosh(zz);
    var one2: Cx := CxSub(CxMul(ch, ch), CxMul(sh, sh));
    if (!CxApproxEq(one2, CxOne(), 0.000000001)) { idFails := idFails + 1; }
    // tan = sin/cos
    var tn: Cx := CxTan(zz);
    var sc: Cx := CxDiv(s, c);
    if (!CxApproxEq(tn, sc, 0.000000001)) { idFails := idFails + 1; }
    // tanh = sinh/cosh
    var th: Cx := CxTanh(zz);
    var shc: Cx := CxDiv(sh, ch);
    if (!CxApproxEq(th, shc, 0.000000001)) { idFails := idFails + 1; }
    // sin(2z) = 2 sin z cos z
    var s2: Cx := CxSin(CxMulReal(zz, 2.0));
    var s2b: Cx := CxMulReal(CxMul(s, c), 2.0);
    if (!CxApproxEq(s2, s2b, 0.00000001)) { idFails := idFails + 1; }
    // e^(iz) = cos z + i sin z
    var lhs: Cx := CxExp(CxMul(CxI(), zz));
    var rhs: Cx := CxAdd(c, CxMul(CxI(), s));
    if (!CxApproxEq(lhs, rhs, 0.00000001)) { idFails := idFails + 1; }
    ii := ii + 1;
  }
  CheckI("identities"c, idFails, 0);

  // ── Umkehrfunktionen ──────────────────────────────────────────────────────
  CheckC("asin_zero"c, CxAsin(CxZero()), 0.0, 0.0, 0.0);
  CheckC("acos_one"c, CxAcos(CxOne()), 0.0, 0.0, EPS());
  CheckC("acos_zero"c, CxAcos(CxZero()), Pi() / 2.0, 0.0, EPS());
  CheckC("atan_zero"c, CxAtan(CxZero()), 0.0, 0.0, 0.0);
  CheckC("asin_one"c, CxAsin(CxOne()), Pi() / 2.0, 0.0, EPS());
  CheckC("atanh_zero"c, CxAtanh(CxZero()), 0.0, 0.0, 0.0);
  CheckC("acosh_one"c, CxAcosh(CxOne()), 0.0, 0.0, EPS());
  CheckC("asinh_zero"c, CxAsinh(CxZero()), 0.0, 0.0, 0.0);
  // asin ausserhalb [-1,1] ist komplex — der Punkt der ganzen Uebung
  CheckC("asin_two"c, CxAsin(CxFromReal(2.0)),
         1.5707963267948966, 0.0 - 1.3169578969248166, EPS());

  // Rundreisen. Der Hauptzweig macht sie nur in einem Streifen exakt, deshalb
  // bleiben die Werte klein.
  var invFails: int64 := 0;
  var jj: int64 := 0;
  while (jj < 30) {
    var u: f64 := ((jj as f64) - 15.0) * 0.06;
    var zz2: Cx := CxNew(u, u * 0.7 + 0.11);
    if (!CxApproxEq(CxSin(CxAsin(zz2)), zz2, 0.00000001)) { invFails := invFails + 1; }
    if (!CxApproxEq(CxCos(CxAcos(zz2)), zz2, 0.00000001)) { invFails := invFails + 1; }
    if (!CxApproxEq(CxTan(CxAtan(zz2)), zz2, 0.00000001)) { invFails := invFails + 1; }
    if (!CxApproxEq(CxSinh(CxAsinh(zz2)), zz2, 0.00000001)) { invFails := invFails + 1; }
    if (!CxApproxEq(CxTanh(CxAtanh(zz2)), zz2, 0.00000001)) { invFails := invFails + 1; }
    jj := jj + 1;
  }
  CheckI("inverse_roundTrips"c, invFails, 0);

  // asinh mit negativem Realteil laeuft ueber die Spiegelung — der Zweig, der
  // die Ausloeschung vermeidet. Ohne ihn blieben rund drei Stellen liegen.
  var an: Cx := CxAsinh(CxNew(0.0 - 33.0, 38.0));
  CheckC("asinh_negRe"c, an, 0.0 - 4.611713187185685, 0.8556069003804284, 1.0e-14);
  CheckC("asinh_oddSymmetry"c, CxAdd(CxAsinh(CxNew(2.0, 3.0)), CxAsinh(CxNew(0.0 - 2.0, 0.0 - 3.0))),
         0.0, 0.0, EPS());

  // ── Polarform ─────────────────────────────────────────────────────────────
  CheckC("fromPolar_1_0"c, CxFromPolar(1.0, 0.0), 1.0, 0.0, EPS());
  CheckC("fromPolar_1_halfPi"c, CxFromPolar(1.0, Pi() / 2.0), 0.0, 1.0, EPS());
  CheckC("fromPolar_2_pi"c, CxFromPolar(2.0, Pi()), 0.0 - 2.0, 0.0, EPS());
  var polFails: int64 := 0;
  var pp: int64 := 0;
  while (pp < 24) {
    var ang: f64 := ((pp as f64) - 12.0) * 0.26;
    var rad: f64 := 0.5 + (pp as f64) * 0.3;
    var zp: Cx := CxFromPolar(rad, ang);
    if (AbsF64(CxAbs(zp) - rad) > 0.000000001) { polFails := polFails + 1; }
    if (AbsF64(CxArg(zp) - ang) > 0.000000001) { polFails := polFails + 1; }
    pp := pp + 1;
  }
  CheckI("polar_roundTrip"c, polFails, 0);

  // ── Vergleich ─────────────────────────────────────────────────────────────
  CheckB("equals"c, CxEquals(a, CxNew(3.0, 4.0)), true);
  CheckB("equals_no"c, CxEquals(a, b), false);
  CheckB("approxEq"c, CxApproxEq(a, CxNew(3.0000000001, 4.0), 0.001), true);
  CheckB("approxEq_no"c, CxApproxEq(a, b, 0.001), false);

  // ── Bruecke zu getrennten Feldern (std.fft, std.tensor) ───────────────────
  var fr: int64 := alloc(4 * 8);
  var fi: int64 := alloc(4 * 8);
  CxStore(CxNew(1.0, 2.0), fr, fi, 0);
  CxStore(CxNew(3.0, 4.0), fr, fi, 1);
  CheckC("store_load0"c, CxLoad(fr, fi, 0), 1.0, 2.0, 0.0);
  CheckC("store_load1"c, CxLoad(fr, fi, 1), 3.0, 4.0, 0.0);
  CheckF("store_rawRe"c, peekf64(fr + 8), 3.0, 0.0);
  CheckF("store_rawIm"c, peekf64(fi + 8), 4.0, 0.0);

  // ── Textausgabe ───────────────────────────────────────────────────────────
  var lpos: int64 := CxFormat(CxNew(3.0, 4.0), 1, buf, 256);
  CheckB("fmt_posEndsI"c, peek8(buf + lpos - 1) == 105, true);
  CheckB("fmt_posHasPlus"c, peek8(buf + 3) == 43, true);
  var lneg: int64 := CxFormat(CxNew(3.0, 0.0 - 4.0), 1, buf, 256);
  CheckB("fmt_negHasMinus"c, peek8(buf + 3) == 45, true);
  CheckB("fmt_negEndsI"c, peek8(buf + lneg - 1) == 105, true);
  // genau ein Vorzeichen zwischen den Teilen, kein "3.0+-4.0i"
  CheckB("fmt_negNoDoubleSign"c, peek8(buf + 4) == 45, false);
  // Die Zahlformatierung selbst kommt von FloatToStr und faellt je nach
  // Standardbibliothek unterschiedlich aus ("5.0" gegen "5.00"). Geprueft
  // wird deshalb die Struktur, die CxFormat beitraegt: ein rein reeller Wert
  // traegt kein "i", ein rein imaginaerer keinen Realteil davor.
  var lreal: int64 := CxFormat(CxNew(5.0, 0.0), 2, buf, 256);
  var realHasI: bool := peek8(buf + lreal - 1) == 105;
  CheckB("fmt_realNoI"c, realHasI, false);
  CheckB("fmt_realStartsFive"c, peek8(buf) == 53, true);
  var limag: int64 := CxFormat(CxNew(0.0, 2.0), 1, buf, 256);
  CheckB("fmt_imagStartsTwo"c, peek8(buf) == 50, true);
  CheckB("fmt_imagEndsI"c, peek8(buf + limag - 1) == 105, true);
  var lnimag: int64 := CxFormat(CxNew(0.0, 0.0 - 2.0), 1, buf, 256);
  CheckB("fmt_negImagStartsMinus"c, peek8(buf) == 45, true);
  CheckB("fmt_negImagEndsI"c, peek8(buf + lnimag - 1) == 105, true);
  var lzero: int64 := CxFormat(CxZero(), 1, buf, 256);
  CheckB("fmt_zeroStartsZero"c, peek8(buf) == 48, true);
  CheckB("fmt_zeroNoI"c, peek8(buf + lzero - 1) == 105, false);
  CheckI("fmt_tooSmall"c, CxFormat(CxNew(3.0, 4.0), 6, buf, 4), 0 - 1);

  // ── std.mathx: Winkelfunktionen ───────────────────────────────────────────
  //
  // Geprueft wird MxSin/MxCos/MxTan gegen Sollwerte aus Python. Ein Vergleich
  // MIT SinF64 steht hier bewusst nicht: dessen Verhalten haengt davon ab,
  // gegen welche Standardbibliothek uebersetzt wird (die Repo-Fassung ist
  // einwandfrei, die installierte veraltet, #1578). Ein Test, der die
  // Umgebung statt den eigenen Code prueft, schlaegt je nach Aufruf an oder
  // nicht — und taugt deshalb nicht als Pruefung.
  CheckF("mxSin_0"c, MxSin(0.0), 0.0, 0.0);
  CheckF("mxCos_0"c, MxCos(0.0), 1.0, 0.0);
  CheckF("mxSin_halfPi"c, MxSin(Pi() / 2.0), 1.0, TIGHT());
  CheckF("mxCos_pi"c, MxCos(Pi()), 0.0 - 1.0, TIGHT());
  CheckF("mxSin_pi"c, MxSin(Pi()), 0.0, 0.000000000000001);
  // genau der Wert, an dem SinF64 scheitert
  CheckF("mxSin_badForStd"c, MxSin(0.0 - 6.282895), 0.0002903071755088165, 1.0e-15);

  // Argumentreduktion ueber mehrere Perioden
  CheckF("mxSin_10pi"c, MxSin(10.0 * Pi()), 0.0, 0.00000000000001);
  CheckF("mxCos_10pi"c, MxCos(10.0 * Pi()), 1.0, 0.00000000000001);
  CheckF("mxSin_1000"c, MxSin(1000.0), 0.8268795405320025, 1.0e-14);
  CheckF("mxCos_1000"c, MxCos(1000.0), 0.5623790762907029, 1.0e-14);
  CheckF("mxSin_1e6"c, MxSin(1000000.0), 0.0 - 0.34999350217129294, 1.0e-13);
  CheckF("mxSin_1e9"c, MxSin(1000000000.0), 0.5458434494486996, 1.0e-11);
  CheckF("mxTan_0"c, MxTan(0.0), 0.0, 0.0);
  CheckF("mxTan_quarterPi"c, MxTan(Pi() / 4.0), 1.0, 0.000000000000001);
  CheckF("mxTan_1000"c, MxTan(1000.0), 1.4703241557027185, 1.0e-13);

  // sin^2 + cos^2 = 1 ueber einen weiten Bereich
  var trigFails: int64 := 0;
  var tt: int64 := 0;
  while (tt < 200) {
    var x: f64 := ((tt as f64) - 100.0) * 137.5;
    var sv: f64 := MxSin(x);
    var cv: f64 := MxCos(x);
    if (AbsF64(sv * sv + cv * cv - 1.0) > 0.000000000000001) { trigFails := trigFails + 1; }
    if (AbsF64(sv) > 1.0000000001) { trigFails := trigFails + 1; }
    if (AbsF64(cv) > 1.0000000001) { trigFails := trigFails + 1; }
    tt := tt + 1;
  }
  CheckI("mxTrig_pythagoras"c, trigFails, 0);

  // MxSinCos liefert dasselbe wie die Einzelaufrufe
  var sp: int64 := alloc(8);
  var cp: int64 := alloc(8);
  MxSinCos(2.5, sp, cp);
  CheckF("mxSinCos_sin"c, peekf64(sp), MxSin(2.5), 0.0);
  CheckF("mxSinCos_cos"c, peekf64(cp), MxCos(2.5), 0.0);
  free(sp, 8);
  free(cp, 8);

  // MxAtan und MxAtan2
  CheckF("mxAtan_0"c, MxAtan(0.0), 0.0, 0.0);
  CheckF("mxAtan_1"c, MxAtan(1.0), Pi() / 4.0, TIGHT());
  CheckF("mxAtan_big"c, MxAtan(1000000.0), 1.5707953267948967, 1.0e-15);
  CheckF("mxAtan_neg"c, MxAtan(0.0 - 1.0), 0.0 - Pi() / 4.0, TIGHT());
  CheckF("mxAtan2_quadrant1"c, MxAtan2(1.0, 1.0), Pi() / 4.0, TIGHT());
  CheckF("mxAtan2_quadrant2"c, MxAtan2(1.0, 0.0 - 1.0), 3.0 * Pi() / 4.0, EPS());
  CheckF("mxAtan2_quadrant3"c, MxAtan2(0.0 - 1.0, 0.0 - 1.0), 0.0 - 3.0 * Pi() / 4.0, EPS());
  CheckF("mxAtan2_quadrant4"c, MxAtan2(0.0 - 1.0, 1.0), 0.0 - Pi() / 4.0, TIGHT());
  CheckF("mxAtan2_yAxis"c, MxAtan2(1.0, 0.0), Pi() / 2.0, TIGHT());
  // die Nullfaelle, an denen Atan2F64 scheitert (#1577)
  CheckF("mxAtan2_negZero_negRe"c, MxAtan2(nz, 0.0 - 1.0), 0.0 - Pi(), TIGHT());
  CheckF("mxAtan2_posZero_negRe"c, MxAtan2(0.0, 0.0 - 1.0), Pi(), TIGHT());
  CheckB("mxAtan2_negZero_posRe"c, FeqSignBit(MxAtan2(nz, 1.0)), true);
  CheckB("mxAtan2_posZero_posRe"c, FeqSignBit(MxAtan2(0.0, 1.0)), false);
  // Gegenprobe zu #1577: Atan2F64 verwirft das Vorzeichen der Null hier in
  // BEIDEN Fassungen der Standardbibliothek — anders als bei SinF64 haengt
  // dieser Befund nicht davon ab, wogegen uebersetzt wird.
  var stdA: f64 := Atan2F64(nz, 0.0 - 1.0);
  var stdWrongSign: bool := stdA > 0.0;
  CheckB("stdAtan2_wrongSide"c, stdWrongSign, true);

  free(fr, 4 * 8);
  free(fi, 4 * 8);
  free(rr, 8 * 8);
  free(ri, 8 * 8);
  free(buf, 256);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
