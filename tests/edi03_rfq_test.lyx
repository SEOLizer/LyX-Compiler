// tests/edi03_rfq_test.lyx — EDI-03: REQOTE + QUOTES tests

unit tests.edi03_rfq_test;

import std.edi.core;
import std.edi.rfq;
import std.alloc;
import std.io;

fn hasTag(buf: int64, bufLen: int64, t0: int64, t1: int64, t2: int64): int64 {
    var i: int64 := 0;
    while (i + 2 < bufLen) {
        if (peek8(buf+i) == t0 && peek8(buf+i+1) == t1 && peek8(buf+i+2) == t2) {
            return 1;
        }
        i := i + 1;
    }
    return 0;
}

fn memEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
        if (peek8(a+i) != peek8(b+i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Test 1: EdiReqoteWrite without rfqNum → returns -1
    // -------------------------------------------------------------------------
    var out1: int64 := alloc(512);
    var w1: int64 := EdiReqoteWrite(0, 0, 0, 0, out1, 512);
    if (w1 != (0 - 1)) {
        PrintLn("FAIL: EdiReqoteWrite(null rfqNum) should return -1"c); ok := 0;
    } else { PrintLn("PASS: EdiReqoteWrite(null rfqNum) returns -1"c); }
    free(out1, 512);

    // -------------------------------------------------------------------------
    // Test 2: EdiQuotesWrite without rfqRef → returns -1
    // -------------------------------------------------------------------------
    var out2: int64 := alloc(512);
    var w2: int64 := EdiQuotesWrite(0, 0, 0, 0, out2, 512);
    if (w2 != (0 - 1)) {
        PrintLn("FAIL: EdiQuotesWrite(null rfqRef) should return -1"c); ok := 0;
    } else { PrintLn("PASS: EdiQuotesWrite(null rfqRef) returns -1"c); }
    free(out2, 512);

    // -------------------------------------------------------------------------
    // Test 3: EdiReqoteWrite — has BGM + LIN + QTY tags
    // -------------------------------------------------------------------------
    var rfqNum: pchar := "RFQ001"c;
    var reqDate: pchar := "20260615"c;
    var needBy:  pchar := "20260630"c;
    var gtinA:   pchar := "4006381333931"c;
    var unitPCE: pchar := "PCE"c;

    var lines3: int64 := alloc(EDI_RFQ_LINE_SIZE);
    poke64(lines3 + EDI_RFQ_LINE_GTIN,    gtinA as int64);
    poke64(lines3 + EDI_RFQ_LINE_GTINLEN, 13);
    poke64(lines3 + EDI_RFQ_LINE_QTY,     50);
    poke64(lines3 + EDI_RFQ_LINE_UNIT,    unitPCE as int64);
    poke64(lines3 + EDI_RFQ_LINE_UNITLEN, 3);
    poke64(lines3 + EDI_RFQ_LINE_DATE,    needBy as int64);

    var out3: int64 := alloc(1024);
    var w3: int64 := EdiReqoteWrite(rfqNum as int64, reqDate as int64, lines3, 1, out3, 1024);
    if (w3 <= 0) { PrintLn("FAIL: EdiReqoteWrite returned <= 0"c); ok := 0; }
    else          { PrintLn("PASS: EdiReqoteWrite returned bytes"c); }
    if (hasTag(out3, w3, 66, 71, 77) != 1) {   // BGM
        PrintLn("FAIL: EdiReqoteWrite missing BGM"c); ok := 0;
    } else { PrintLn("PASS: EdiReqoteWrite has BGM"c); }
    if (hasTag(out3, w3, 76, 73, 78) != 1) {   // LIN
        PrintLn("FAIL: EdiReqoteWrite missing LIN"c); ok := 0;
    } else { PrintLn("PASS: EdiReqoteWrite has LIN"c); }
    if (hasTag(out3, w3, 81, 84, 89) != 1) {   // QTY
        PrintLn("FAIL: EdiReqoteWrite missing QTY"c); ok := 0;
    } else { PrintLn("PASS: EdiReqoteWrite has QTY"c); }
    if (hasTag(out3, w3, 68, 84, 77) != 1) {   // DTM
        PrintLn("FAIL: EdiReqoteWrite missing DTM"c); ok := 0;
    } else { PrintLn("PASS: EdiReqoteWrite has DTM"c); }

    // -------------------------------------------------------------------------
    // Test 4: EdiReqoteRead round-trip — rfqNum, date, line GTIN and qty
    // -------------------------------------------------------------------------
    var hdr4: int64 := alloc(EDI_RFQHDR_SIZE);
    var rlines4: int64 := alloc(4 * EDI_RFQ_LINE_SIZE);
    var rc4: int64 := EdiReqoteRead(out3, w3, hdr4, rlines4, 4);
    if (rc4 != 1) {
        PrintLn("FAIL: EdiReqoteRead should find 1 line"c); ok := 0;
    } else { PrintLn("PASS: EdiReqoteRead line count = 1"c); }

    var rRfqPtr: int64 := peek64(hdr4 + EDI_RFQHDR_NUM);
    var rRfqLen: int64 := peek64(hdr4 + EDI_RFQHDR_NUMLEN);
    if (memEq(rRfqPtr, rRfqLen, rfqNum as int64, 6) != 1) {
        PrintLn("FAIL: REQOTE round-trip rfqNum mismatch"c); ok := 0;
    } else { PrintLn("PASS: REQOTE round-trip rfqNum matches"c); }

    var rDatePtr: int64 := peek64(hdr4 + EDI_RFQHDR_DATE);
    var rDateLen: int64 := peek64(hdr4 + EDI_RFQHDR_DATELEN);
    if (memEq(rDatePtr, rDateLen, reqDate as int64, 8) != 1) {
        PrintLn("FAIL: REQOTE round-trip date mismatch"c); ok := 0;
    } else { PrintLn("PASS: REQOTE round-trip date matches"c); }

    var rGtinPtr: int64 := peek64(rlines4 + EDI_RFQ_LINE_GTIN);
    var rGtinLen: int64 := peek64(rlines4 + EDI_RFQ_LINE_GTINLEN);
    if (memEq(rGtinPtr, rGtinLen, gtinA as int64, 13) != 1) {
        PrintLn("FAIL: REQOTE round-trip GTIN mismatch"c); ok := 0;
    } else { PrintLn("PASS: REQOTE round-trip GTIN matches"c); }

    var rQty4: int64 := peek64(rlines4 + EDI_RFQ_LINE_QTY);
    if (rQty4 != 50) {
        PrintLn("FAIL: REQOTE round-trip qty should be 50"c); ok := 0;
    } else { PrintLn("PASS: REQOTE round-trip qty = 50"c); }

    free(rlines4, 4 * EDI_RFQ_LINE_SIZE);
    free(hdr4, EDI_RFQHDR_SIZE);

    // -------------------------------------------------------------------------
    // Test 5: EdiQuotesWrite — has BGM + RFF + LIN + PRI + LOC tags
    // -------------------------------------------------------------------------
    var quoteNum: pchar := "QTE001"c;
    var delivDate: pchar := "20260720"c;

    var qlines5: int64 := alloc(EDI_QUOTE_LINE_SIZE);
    poke64(qlines5 + EDI_QUOTE_LINE_GTIN,        gtinA as int64);
    poke64(qlines5 + EDI_QUOTE_LINE_GTINLEN,     13);
    poke64(qlines5 + EDI_QUOTE_LINE_PRICE,       3500);   // 35.00
    poke64(qlines5 + EDI_QUOTE_LINE_CURRENCY,    0);
    poke64(qlines5 + EDI_QUOTE_LINE_CURRENCYLEN, 0);
    poke64(qlines5 + EDI_QUOTE_LINE_DATE,        delivDate as int64);
    poke64(qlines5 + EDI_QUOTE_LINE_AVAIL,       1);

    var out5: int64 := alloc(1024);
    var w5: int64 := EdiQuotesWrite(rfqNum as int64, quoteNum as int64, qlines5, 1, out5, 1024);
    if (w5 <= 0) { PrintLn("FAIL: EdiQuotesWrite returned <= 0"c); ok := 0; }
    else          { PrintLn("PASS: EdiQuotesWrite returned bytes"c); }
    if (hasTag(out5, w5, 66, 71, 77) != 1) {   // BGM
        PrintLn("FAIL: EdiQuotesWrite missing BGM"c); ok := 0;
    } else { PrintLn("PASS: EdiQuotesWrite has BGM"c); }
    if (hasTag(out5, w5, 82, 70, 70) != 1) {   // RFF
        PrintLn("FAIL: EdiQuotesWrite missing RFF"c); ok := 0;
    } else { PrintLn("PASS: EdiQuotesWrite has RFF"c); }
    if (hasTag(out5, w5, 76, 73, 78) != 1) {   // LIN
        PrintLn("FAIL: EdiQuotesWrite missing LIN"c); ok := 0;
    } else { PrintLn("PASS: EdiQuotesWrite has LIN"c); }
    if (hasTag(out5, w5, 80, 82, 73) != 1) {   // PRI
        PrintLn("FAIL: EdiQuotesWrite missing PRI"c); ok := 0;
    } else { PrintLn("PASS: EdiQuotesWrite has PRI"c); }
    if (hasTag(out5, w5, 76, 79, 67) != 1) {   // LOC
        PrintLn("FAIL: EdiQuotesWrite missing LOC"c); ok := 0;
    } else { PrintLn("PASS: EdiQuotesWrite has LOC"c); }

    // -------------------------------------------------------------------------
    // Test 6: EdiQuotesRead — rfqRef links back, price and avail recovered
    // -------------------------------------------------------------------------
    var hdr6: int64 := alloc(EDI_QUOTEHDR_SIZE);
    var rqlines6: int64 := alloc(4 * EDI_QUOTE_LINE_SIZE);
    var rc6: int64 := EdiQuotesRead(out5, w5, hdr6, rqlines6, 4);
    if (rc6 != 1) {
        PrintLn("FAIL: EdiQuotesRead should find 1 line"c); ok := 0;
    } else { PrintLn("PASS: EdiQuotesRead line count = 1"c); }

    // quoteNum recovered from BGM
    var rQnPtr: int64 := peek64(hdr6 + EDI_QUOTEHDR_NUM);
    var rQnLen: int64 := peek64(hdr6 + EDI_QUOTEHDR_NUMLEN);
    if (memEq(rQnPtr, rQnLen, quoteNum as int64, 6) != 1) {
        PrintLn("FAIL: QUOTES round-trip quoteNum mismatch"c); ok := 0;
    } else { PrintLn("PASS: QUOTES round-trip quoteNum matches"c); }

    // rfqRef recovered from RFF+RFQ
    var rRefPtr: int64 := peek64(hdr6 + EDI_QUOTEHDR_RFQREF);
    var rRefLen: int64 := peek64(hdr6 + EDI_QUOTEHDR_RFQREFLEN);
    if (memEq(rRefPtr, rRefLen, rfqNum as int64, 6) != 1) {
        PrintLn("FAIL: QUOTES rfqRef does not match REQOTE rfqNum"c); ok := 0;
    } else { PrintLn("PASS: QUOTES rfqRef matches REQOTE rfqNum"c); }

    // price recovered
    var rPrice6: int64 := peek64(rqlines6 + EDI_QUOTE_LINE_PRICE);
    if (rPrice6 != 3500) {
        PrintLn("FAIL: QUOTES round-trip price should be 3500"c); ok := 0;
    } else { PrintLn("PASS: QUOTES round-trip price = 3500"c); }

    // availability recovered
    var rAvail6: int64 := peek64(rqlines6 + EDI_QUOTE_LINE_AVAIL);
    if (rAvail6 != 1) {
        PrintLn("FAIL: QUOTES round-trip avail should be 1"c); ok := 0;
    } else { PrintLn("PASS: QUOTES round-trip avail = 1"c); }

    // GTIN recovered
    var rGtin6Ptr: int64 := peek64(rqlines6 + EDI_QUOTE_LINE_GTIN);
    var rGtin6Len: int64 := peek64(rqlines6 + EDI_QUOTE_LINE_GTINLEN);
    if (memEq(rGtin6Ptr, rGtin6Len, gtinA as int64, 13) != 1) {
        PrintLn("FAIL: QUOTES round-trip GTIN mismatch"c); ok := 0;
    } else { PrintLn("PASS: QUOTES round-trip GTIN matches"c); }

    free(rqlines6, 4 * EDI_QUOTE_LINE_SIZE);
    free(hdr6, EDI_QUOTEHDR_SIZE);
    free(out5, 1024);
    free(qlines5, EDI_QUOTE_LINE_SIZE);

    // -------------------------------------------------------------------------
    // Test 7: REQOTE + QUOTES 2-line round-trip
    // -------------------------------------------------------------------------
    var gtinB:  pchar := "01234565"c;
    var lines7: int64 := alloc(2 * EDI_RFQ_LINE_SIZE);
    var l7a: int64 := lines7 + 0 * EDI_RFQ_LINE_SIZE;
    var l7b: int64 := lines7 + 1 * EDI_RFQ_LINE_SIZE;

    poke64(l7a + EDI_RFQ_LINE_GTIN,    gtinA as int64);
    poke64(l7a + EDI_RFQ_LINE_GTINLEN, 13);
    poke64(l7a + EDI_RFQ_LINE_QTY,     100);
    poke64(l7a + EDI_RFQ_LINE_UNIT,    unitPCE as int64);
    poke64(l7a + EDI_RFQ_LINE_UNITLEN, 3);
    poke64(l7a + EDI_RFQ_LINE_DATE,    0);

    poke64(l7b + EDI_RFQ_LINE_GTIN,    gtinB as int64);
    poke64(l7b + EDI_RFQ_LINE_GTINLEN, 8);
    poke64(l7b + EDI_RFQ_LINE_QTY,     200);
    poke64(l7b + EDI_RFQ_LINE_UNIT,    unitPCE as int64);
    poke64(l7b + EDI_RFQ_LINE_UNITLEN, 3);
    poke64(l7b + EDI_RFQ_LINE_DATE,    0);

    var rfqNum7: pchar := "RFQ007"c;
    var out7: int64 := alloc(2048);
    var w7: int64 := EdiReqoteWrite(rfqNum7 as int64, 0, lines7, 2, out7, 2048);
    if (w7 <= 0) { PrintLn("FAIL: REQOTE 2-line write returned <= 0"c); ok := 0; }
    else          { PrintLn("PASS: REQOTE 2-line write returned bytes"c); }

    var hdr7: int64 := alloc(EDI_RFQHDR_SIZE);
    var rlines7: int64 := alloc(4 * EDI_RFQ_LINE_SIZE);
    var rc7: int64 := EdiReqoteRead(out7, w7, hdr7, rlines7, 4);
    if (rc7 != 2) {
        PrintLn("FAIL: REQOTE 2-line read should find 2"c); ok := 0;
    } else { PrintLn("PASS: REQOTE 2-line read count = 2"c); }

    var rQty7b: int64 := peek64(rlines7 + 1 * EDI_RFQ_LINE_SIZE + EDI_RFQ_LINE_QTY);
    if (rQty7b != 200) {
        PrintLn("FAIL: REQOTE 2-line line[1] qty should be 200"c); ok := 0;
    } else { PrintLn("PASS: REQOTE 2-line line[1] qty = 200"c); }

    // Build QUOTES for same 2 lines
    var qlines7: int64 := alloc(2 * EDI_QUOTE_LINE_SIZE);
    var q7a: int64 := qlines7 + 0 * EDI_QUOTE_LINE_SIZE;
    var q7b: int64 := qlines7 + 1 * EDI_QUOTE_LINE_SIZE;

    poke64(q7a + EDI_QUOTE_LINE_GTIN,    gtinA as int64);
    poke64(q7a + EDI_QUOTE_LINE_GTINLEN, 13);
    poke64(q7a + EDI_QUOTE_LINE_PRICE,   9900);   // 99.00
    poke64(q7a + EDI_QUOTE_LINE_DATE,    0);
    poke64(q7a + EDI_QUOTE_LINE_AVAIL,   1);
    poke64(q7a + EDI_QUOTE_LINE_CURRENCY, 0);
    poke64(q7a + EDI_QUOTE_LINE_CURRENCYLEN, 0);

    poke64(q7b + EDI_QUOTE_LINE_GTIN,    gtinB as int64);
    poke64(q7b + EDI_QUOTE_LINE_GTINLEN, 8);
    poke64(q7b + EDI_QUOTE_LINE_PRICE,   4900);   // 49.00
    poke64(q7b + EDI_QUOTE_LINE_DATE,    0);
    poke64(q7b + EDI_QUOTE_LINE_AVAIL,   0);   // not available
    poke64(q7b + EDI_QUOTE_LINE_CURRENCY, 0);
    poke64(q7b + EDI_QUOTE_LINE_CURRENCYLEN, 0);

    var qout7: int64 := alloc(2048);
    var qw7: int64 := EdiQuotesWrite(rfqNum7 as int64, 0, qlines7, 2, qout7, 2048);
    if (qw7 <= 0) { PrintLn("FAIL: QUOTES 2-line write returned <= 0"c); ok := 0; }
    else           { PrintLn("PASS: QUOTES 2-line write returned bytes"c); }

    var qhdr7: int64 := alloc(EDI_QUOTEHDR_SIZE);
    var rqlines7: int64 := alloc(4 * EDI_QUOTE_LINE_SIZE);
    var rqc7: int64 := EdiQuotesRead(qout7, qw7, qhdr7, rqlines7, 4);
    if (rqc7 != 2) {
        PrintLn("FAIL: QUOTES 2-line read should find 2"c); ok := 0;
    } else { PrintLn("PASS: QUOTES 2-line read count = 2"c); }

    // rfqRef in QUOTES refers back to RFQ007
    var rRef7Ptr: int64 := peek64(qhdr7 + EDI_QUOTEHDR_RFQREF);
    var rRef7Len: int64 := peek64(qhdr7 + EDI_QUOTEHDR_RFQREFLEN);
    if (memEq(rRef7Ptr, rRef7Len, rfqNum7 as int64, 6) != 1) {
        PrintLn("FAIL: QUOTES 2-line rfqRef mismatch"c); ok := 0;
    } else { PrintLn("PASS: QUOTES 2-line rfqRef = RFQ007"c); }

    // line[1] avail=0
    var rAvail7b: int64 := peek64(rqlines7 + 1 * EDI_QUOTE_LINE_SIZE + EDI_QUOTE_LINE_AVAIL);
    if (rAvail7b != 0) {
        PrintLn("FAIL: QUOTES 2-line line[1] avail should be 0"c); ok := 0;
    } else { PrintLn("PASS: QUOTES 2-line line[1] avail = 0"c); }

    // line[0] price=9900
    var rPrice7a: int64 := peek64(rqlines7 + 0 * EDI_QUOTE_LINE_SIZE + EDI_QUOTE_LINE_PRICE);
    if (rPrice7a != 9900) {
        PrintLn("FAIL: QUOTES 2-line line[0] price should be 9900"c); ok := 0;
    } else { PrintLn("PASS: QUOTES 2-line line[0] price = 9900"c); }

    free(rqlines7, 4 * EDI_QUOTE_LINE_SIZE);
    free(qhdr7, EDI_QUOTEHDR_SIZE);
    free(qout7, 2048);
    free(qlines7, 2 * EDI_QUOTE_LINE_SIZE);
    free(rlines7, 4 * EDI_RFQ_LINE_SIZE);
    free(hdr7, EDI_RFQHDR_SIZE);
    free(out7, 2048);
    free(lines7, 2 * EDI_RFQ_LINE_SIZE);

    free(out3, 1024);
    free(lines3, EDI_RFQ_LINE_SIZE);

    if (ok != 0) { PrintLn("=== EDI-03: ALL PASS ==="c); }
    else          { PrintLn("=== EDI-03: SOME FAIL ==="c); }
    return ok;
}
