unit rp.basis;

// #1985: Basisklasse in einer EIGENEN Unit — genau die Grenze, an der die
// Layout-Rechnung im IR-Weg abbrach.
pub type TBasis = class {
  w: int64;
  z: int64;
  fn Create(): void { self.w := 11; self.z := 22; }
  fn HoleW(): int64 { return self.w; }
  fn HoleZ(): int64 { return self.z; }
}

// Ableitung in DERSELBEN Unit — die Gegenprobe, die schon immer stimmte.
pub type TGleicheUnit = class extends TBasis {
  eigen: int64;
  fn Create(): void { super.Create(); self.w := 44; self.eigen := 5; }
}
