import rp.basis;
import std.io;

// Ableitung in einer ANDEREN Unit als die Basis. Das eigene Feld muss HINTER
// den geerbten liegen; lag es davor, ueberschrieb `self.eigen := 5` das Feld
// `w` und `HoleW()` lieferte 5.
type TAndereUnit = class extends TBasis {
  eigen: int64;
  fn Create(): void { super.Create(); self.w := 77; self.eigen := 5; }
}

fn main(): int64 {
  var g: TGleicheUnit := new TGleicheUnit();
  PrintStr(IntToStr(g.HoleW())); PrintStr(" ");
  PrintStr(IntToStr(g.HoleZ())); PrintStr(" ");
  PrintStr(IntToStr(g.eigen));   PrintStr(" ");
  var a: TAndereUnit := new TAndereUnit();
  PrintStr(IntToStr(a.HoleW())); PrintStr(" ");
  PrintStr(IntToStr(a.HoleZ())); PrintStr(" ");
  PrintLn(IntToStr(a.eigen));
  return 0;
}
