#
#	Kleine Beispiel-pci.ids fuer tests/pci_wp2_test.lyx.
#	Format identisch zur ausgelieferten share/pci.ids; der Test haengt
#	bewusst nicht an der Systeminstallation.
#
1234  Beispiel Hersteller
	0001  Erstes Geraet
		1234 8888  Erste Beispielkarte
		1234 9999  Zweite Beispielkarte
# ein Kommentar mitten im Block — er darf die Suche nicht beenden
	0002  Zweites Geraet
	00ff  Letztes Geraet
8086  Intel Corporation
	10d3  82574L Gigabit Network Connection

# Klassenabschnitt
C 02  Network controller
	00  Ethernet controller
	80  Network controller
C 0c  Serial bus controller
	03  USB controller
