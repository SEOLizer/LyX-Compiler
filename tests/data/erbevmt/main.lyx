unit main;
import rp.a;
import std.io;

type TAbl = class extends TBasis {
  fn Create(): void { self.w := 77; }
  fn Eigen(): int64 { return self.w; }        // im ERBENDEN Modul uebersetzt
  override fn VWert(): int64 { return 222; }
}

fn ueberBasis(b: TBasis): int64 { return b.VWert(); }

fn main(): int64 {
  var a: TAbl := new TAbl();
  PrintLn(IntToStr(a.Wert()));        // geerbt, nicht virtuell -> 77
  PrintLn(IntToStr(a.Eigen()));       // eigenes Modul, dasselbe Feld -> 77
  PrintLn(IntToStr(a.w));             // Feldzugriff von aussen -> 77
  PrintLn(IntToStr(a.VWert()));       // ueberschrieben -> 222
  PrintLn(IntToStr(ueberBasis(a as TBasis)));  // virtuelle Dispatch -> 222
  var b: TBasis := new TBasis();
  PrintLn(IntToStr(b.Wert()));        // Basis allein -> 11
  PrintLn(IntToStr(b.VWert()));       // Basis allein, virtuell -> 111
  return 0;
}
