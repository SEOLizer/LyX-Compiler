unit rp.a;

// Die Basis liegt in einer EIGENEN Unit und traegt eine virtuelle Methode.
// Beides zusammen ist der Fall aus #1998: erst die virtuelle Methode gibt der
// Klasse eine VMT und schiebt die Felder um 8 Byte nach hinten, und erst die
// Modulgrenze laesst das im erbenden Modul unbemerkt.
pub type TBasis = class {
  w: int64;
  fn Create(): void { self.w := 11; }
  fn Wert(): int64 { return self.w; }         // geerbt, NICHT virtuell
  virtual fn VWert(): int64 { return 111; }   // diese Zeile entscheidet
}
