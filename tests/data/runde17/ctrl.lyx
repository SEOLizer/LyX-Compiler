unit runde17.ctrl;
// #1670: Klassen aus einer ANDEREN Unit — der Name muss auch dort am Objekt
// haengen, nicht nur bei Klassen der uebersetzten Datei.
pub type TControl = class {
  x: int64;
  fn Create(): void { self.x := 0; }
  virtual fn Paint(): void { }
}
pub type TEdit = class extends TControl {
  fn Create(): void { self.x := 1; }
  override fn Paint(): void { }
}
