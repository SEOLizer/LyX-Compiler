// Verbraucher fuer #2451: benutzt NICHT alles aus der Unit, und prueft am
// WERT, dass das Benutzte vollstaendig da ist.
//
// Stellenwertige Summanden, damit eine fehlende Teilsumme nicht von einer
// anderen verdeckt wird: 8 + 800 + 20000 + 7 = 20815.
import std.io;
import dce2451.helfer;

fn main(): int64 {
  var s: int64 := 0;
  s := s + Verdoppeln(4);                            //     8
  s := s + _indirect_call_1(ZeigerAufPlusDrei(), 5) * 100;   //   800  (5+3)
  var a: Abgeleitet := new Abgeleitet();
  var b: Basis := a as Basis;
  s := s + b.Wert() * 1000;                          // 20000  (Override)
  s := s + SIEBEN;                                   //     7
  PrintIntLn(s);
  return 0;
}
