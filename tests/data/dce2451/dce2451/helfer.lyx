// tests/data/dce2451/dce2451/helfer.lyx — Pruefdaten fuer #2451, kein Test
// (kein main).
//
// Die Unit traegt absichtlich mehr, als der Verbraucher braucht, und deckt die
// Wege ab, auf denen eine Funktion erreichbar ist, OHNE dass ihr Name im
// Programm steht. Genau daran wuerde ein zu scharfer Schnitt scheitern.
unit dce2451.helfer;

pub con SIEBEN: int64 := 7;

// 1. Gewoehnlicher Aufruf.
pub fn Verdoppeln(n: int64): int64 { return n * 2; }

// 2. Nur ueber einen Funktionszeiger erreichbar: der Name steht im Programm
//    nicht an einer Aufrufstelle, sondern als Adresse (IRO_FUNC_ADDR).
pub fn PlusDrei(n: int64): int64 { return n + 3; }
pub fn ZeigerAufPlusDrei(): int64 { return PlusDrei as int64; }

// 3. Virtuelle Methode mit Override. Auf dem IR-Weg ist das eine
//    Vergleichskette ueber die type-id mit direkten Aufrufen; das Override ist
//    also erreichbar, ohne im Programm genannt zu sein.
pub type Basis = class {
  pub virtual fn Wert(): int64 { return 10; }
};

pub type Abgeleitet = class extends Basis {
  pub override fn Wert(): int64 { return 20; }
};

