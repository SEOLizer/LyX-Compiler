import rp.basis;
import rp.mitte;
import std.io;

type TAbl = class extends TMitte {
  fn Create(): void { super.Create(); }
}

fn main(): int64 {
  var a: TAbl := new TAbl();
  PrintStr(IntToStr(a.Doppelt()));   PrintStr(" ");
  PrintStr(IntToStr(a.Dreifach()));  PrintStr(" ");
  PrintStr(IntToStr(a.Eigen()));     PrintStr(" ");
  var b: TBasis := a as TBasis;
  PrintStr(IntToStr(b.Doppelt()));   PrintStr(" ");
  var c: TBasis := new TBasis();
  PrintLn(IntToStr(c.Doppelt()));
  return 0;
}
