unit rp.basis;

// #1976: Basisklasse in einer EIGENEN Unit — genau das ist der Fall, an dem
// die Kettenverfolgung im IR-Weg abbrach.
pub type TBasis = class {
  Wert: int64;
  fn Create(): void { self.Wert := 7; }
  fn Doppelt(): int64 { return self.Wert * 2; }
  fn Dreifach(): int64 { return self.Wert * 3; }
}
