// tests/pqc_wp08_test.lyx
// WP-PQC-08: SLH-DSA (SPHINCS+, FIPS 205) — Korrektheitstests
//
// Abnahmekriterien:
// AC-WP08.1: KeyGen + Sign + Verify (Mini) → 1
// AC-WP08.2: Signatur-Manipulation → Verify → 0
// AC-WP08.3: Nachrichten-Manipulation → Verify → 0
// AC-WP08.4: SLH-DSA-SHA2-128s Roundtrip (Schlüssel + Signatur korrekte Größe)
//
// Hinweis: AC-WP08.4 testet Runzentriert 128s; dauert mehrere Sekunden.
// Für CI: nur Mini-Tests aktiv; 128s optional.

unit tests.pqc_wp08_test;

import std.crypto.pqc.slhdsa;
import std.alloc;

// ─── Hilfsfunktionen ──────────────────────────────────────────────────────

fn fillbuf(buf: int64, val: int64, n: int64) {
  var i: int64 := 0; while (i < n) { poke8(buf+i, val); i := i+1; }
}

fn compareBytes(a: int64, b: int64, n: int64): int64 {
  var i: int64 := 0;
  while (i < n) { if (peek8(a+i) != peek8(b+i)) { return 0; } i := i+1; }
  return 1;
}

// ============================================================
// AC-WP08.1: Mini-Roundtrip (KeyGen + Sign + Verify = 1)
// ============================================================
fn testMiniRoundtrip(): int64 {
  var ps: int64 := alloc(SLH_PS);
  SLHParamsMini(ps);

  var n: int64 := 16;
  var sk: int64 := alloc(4*n);
  var pk: int64 := alloc(2*n);

  var skseed: int64 := alloc(n);
  var skprf:  int64 := alloc(n);
  var pkseed: int64 := alloc(n);
  fillbuf(skseed, 0x01, n);
  fillbuf(skprf,  0x02, n);
  fillbuf(pkseed, 0x03, n);

  SLHDSAKeyGen(ps, skseed, skprf, pkseed, sk, pk);

  // Signatur: R(16) + FORS(192) + HT(1184) = 1392 Bytes
  var sig: int64 := alloc(SLH_MINI_SIG);
  var msg: int64 := alloc(5);
  poke8(msg+0,0x68); poke8(msg+1,0x65); poke8(msg+2,0x6C);
  poke8(msg+3,0x6C); poke8(msg+4,0x6F);  // "hello"

  var siglen: int64 := SLHDSASign(ps, sk, msg, 5, 0, sig);

  var failed: int64 := 0;

  if (siglen != SLH_MINI_SIG) {
    PrintLn("FAIL: Mini Sign returned wrong siglen"); failed := failed+1;
  }

  var ok: int64 := SLHDSAVerify(ps, pk, msg, 5, sig);
  if (ok != 1) {
    PrintLn("FAIL: Mini Verify should be 1 for valid sig"); failed := failed+1;
  }

  free(msg,5); free(sig,SLH_MINI_SIG); free(pkseed,n); free(skprf,n);
  free(skseed,n); free(pk,2*n); free(sk,4*n); free(ps,SLH_PS);

  if (failed == 0) { PrintLn("OK: SLH-DSA Mini KeyGen+Sign+Verify roundtrip (WP-08.1)"); }
  return failed;
}

// ============================================================
// AC-WP08.2: Signatur-Manipulation → Verify = 0
// ============================================================
fn testMiniSigTamper(): int64 {
  var ps: int64 := alloc(SLH_PS);
  SLHParamsMini(ps);

  var n: int64 := 16;
  var sk: int64 := alloc(4*n);
  var pk: int64 := alloc(2*n);

  var skseed: int64 := alloc(n);
  var skprf:  int64 := alloc(n);
  var pkseed: int64 := alloc(n);
  fillbuf(skseed, 0x11, n);
  fillbuf(skprf,  0x22, n);
  fillbuf(pkseed, 0x33, n);
  SLHDSAKeyGen(ps, skseed, skprf, pkseed, sk, pk);

  var sig: int64 := alloc(SLH_MINI_SIG);
  var msg: int64 := alloc(4);
  poke8(msg+0,0x74); poke8(msg+1,0x65); poke8(msg+2,0x73); poke8(msg+3,0x74);  // "test"
  SLHDSASign(ps, sk, msg, 4, 0, sig);

  // Byte in der Mitte der Signatur flippen
  var tamper_pos: int64 := SLH_MINI_SIG / 2;
  poke8(sig + tamper_pos, peek8(sig + tamper_pos) ^ 0xFF);

  var ok: int64 := SLHDSAVerify(ps, pk, msg, 4, sig);
  var failed: int64 := 0;
  if (ok != 0) {
    PrintLn("FAIL: Tampered sig should not verify"); failed := failed+1;
  }

  free(msg,4); free(sig,SLH_MINI_SIG);
  free(pkseed,n); free(skprf,n); free(skseed,n);
  free(pk,2*n); free(sk,4*n); free(ps,SLH_PS);

  if (failed == 0) { PrintLn("OK: SLH-DSA Mini tampered sig rejected (WP-08.2)"); }
  return failed;
}

// ============================================================
// AC-WP08.3: Nachrichten-Manipulation → Verify = 0
// ============================================================
fn testMiniMsgTamper(): int64 {
  var ps: int64 := alloc(SLH_PS);
  SLHParamsMini(ps);

  var n: int64 := 16;
  var sk: int64 := alloc(4*n);
  var pk: int64 := alloc(2*n);

  var skseed: int64 := alloc(n);
  var skprf:  int64 := alloc(n);
  var pkseed: int64 := alloc(n);
  fillbuf(skseed, 0x44, n);
  fillbuf(skprf,  0x55, n);
  fillbuf(pkseed, 0x66, n);
  SLHDSAKeyGen(ps, skseed, skprf, pkseed, sk, pk);

  var sig: int64 := alloc(SLH_MINI_SIG);
  var msg: int64 := alloc(3);
  poke8(msg+0,0x61); poke8(msg+1,0x62); poke8(msg+2,0x63);  // "abc"
  SLHDSASign(ps, sk, msg, 3, 0, sig);

  // Nachricht manipulieren
  poke8(msg+1, 0x00);

  var ok: int64 := SLHDSAVerify(ps, pk, msg, 3, sig);
  var failed: int64 := 0;
  if (ok != 0) {
    PrintLn("FAIL: Modified message should not verify"); failed := failed+1;
  }

  free(msg,3); free(sig,SLH_MINI_SIG);
  free(pkseed,n); free(skprf,n); free(skseed,n);
  free(pk,2*n); free(sk,4*n); free(ps,SLH_PS);

  if (failed == 0) { PrintLn("OK: SLH-DSA Mini modified message rejected (WP-08.3)"); }
  return failed;
}

// ============================================================
// AC-WP08.4: Schlüssellayout-Check (Mini-Params, n=16, wie 128s)
// ============================================================
fn testKeygenSizes(): int64 {
  var ps: int64 := alloc(SLH_PS);
  SLHParamsMini(ps);   // n=16 wie 128s, aber h=4 → KeyGen viel schneller

  var n: int64 := 16;
  var sk: int64 := alloc(4*n);
  var pk: int64 := alloc(2*n);
  var skseed: int64 := alloc(n);
  var skprf: int64 := alloc(n);
  var pkseed: int64 := alloc(n);
  fillbuf(skseed, 0xAA, n);
  fillbuf(skprf,  0xBB, n);
  fillbuf(pkseed, 0xCC, n);

  SLHDSAKeyGen(ps, skseed, skprf, pkseed, sk, pk);

  var failed: int64 := 0;

  // SK[0..15] = skseed = 0xAA..AA
  var skseed_ok: int64 := 1;
  var i: int64 := 0;
  while (i < n) { if (peek8(sk+i) != 0xAA) { skseed_ok := 0; } i := i+1; }
  if (skseed_ok == 0) {
    PrintLn("FAIL: SK.seed not stored correctly"); failed := failed+1;
  }

  // PK[0..15] = pkseed = 0xCC..CC
  var pkseed_ok: int64 := 1;
  i := 0;
  while (i < n) { if (peek8(pk+i) != 0xCC) { pkseed_ok := 0; } i := i+1; }
  if (pkseed_ok == 0) {
    PrintLn("FAIL: PK.seed not stored correctly"); failed := failed+1;
  }

  // PK.root (pk[16..31]) und SK.root (sk[48..63]) müssen übereinstimmen
  var roots_match: int64 := compareBytes(pk+n, sk+3*n, n);
  if (roots_match == 0) {
    PrintLn("FAIL: PK.root in pk and sk don't match"); failed := failed+1;
  }

  free(pkseed,n); free(skprf,n); free(skseed,n);
  free(pk,2*n); free(sk,4*n); free(ps,SLH_PS);

  if (failed == 0) { PrintLn("OK: SLH-DSA KeyGen layout correct: SK.seed/PK.seed/PK.root (WP-08.4)"); }
  return failed;
}

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testMiniRoundtrip();
  failed := failed + testMiniSigTamper();
  failed := failed + testMiniMsgTamper();
  failed := failed + testKeygenSizes();
  if (failed != 0) { PrintLn("FAILED"); return 1; }
  PrintLn("ALL PASSED");
  PrintLn("NOTE: Full 128s/256s Sign+Verify roundtrip requires more time — manual test");
  return 0;
}
