// tests/nested_fn_test.lyx — verschachtelte Funktionen (NestedFnDecl).
//
// `NestedFnDecl` steht seit jeher in der EBNF, war aber nicht benutzbar. Drei
// getrennte Lücken:
//
//   1. sema registrierte den Namen nicht (Pass1 läuft nur über die oberste
//      Ebene) → jeder Aufruf: "undefined function".
//   2. sema prüfte den Rumpf gar nicht → Fehler darin fielen erst im Codegen auf.
//   3. Der Codegen emittierte den Rumpf INLINE mitten in die umgebende Funktion,
//      die anschließend hineinlief → SIGSEGV.
//
// Dazu kam ein stiller Fehler: ein Zugriff auf eine lokale Variable der
// umgebenden Funktion lieferte 0 statt des Werts. Verschachtelte Funktionen
// bekommen keinen Static Link und werden als gewöhnliche Funktionen emittiert;
// ein solcher Zugriff ist deshalb jetzt ein sema-Fehler (siehe
// tests/nested_fn_capture_test.sh).

import std.io;

var fails: int64 := 0;

fn expect(name: pchar, got: int64, want: int64) {
  Print(name); Print(": ");
  if (got == want) {
    PrintLn("OK");
  } else {
    Print("FAIL got="); PrintInt(got); Print(" want="); PrintInt(want); PrintLn("");
    fails += 1;
  }
}

con GLOBAL_ADD: int64 := 10;

// einfacher Fall
fn outerSimple(x: int64): int64 {
  fn inner(v: int64): int64 { return v + 1; }
  return inner(x);
}

// Aufruf VOR der Deklaration — Vorab-Registrierung im Block
fn outerForward(x: int64): int64 {
  return later(x);
  fn later(v: int64): int64 { return v + 2; }
}

// zwei verschachtelte, die sich gegenseitig aufrufen
fn outerTwo(x: int64): int64 {
  fn addOne(v: int64): int64 { return v + 1; }
  fn doubleIt(v: int64): int64 { return addOne(v) * 2; }
  return doubleIt(x);
}

// fn in fn
fn outerDeep(x: int64): int64 {
  fn mid(v: int64): int64 {
    fn deep(w: int64): int64 { return w + 2; }
    return deep(v);
  }
  return mid(x);
}

// Rekursion in der verschachtelten Funktion
fn outerRec(x: int64): int64 {
  fn fact(n: int64): int64 {
    if (n <= 1) { return 1; }
    return n * fact(n - 1);
  }
  return fact(x);
}

// globale Symbole bleiben sichtbar (nur Locals der umgebenden Fn sind tabu)
fn outerGlobal(x: int64): int64 {
  fn useGlobal(v: int64): int64 { return v + GLOBAL_ADD; }
  return useGlobal(x);
}

// mehrfacher Aufruf derselben verschachtelten Funktion
fn outerRepeat(x: int64): int64 {
  fn inc(v: int64): int64 { return v + 1; }
  return inc(inc(inc(x)));
}

// die umgebende Funktion muss nach der Deklaration normal weiterlaufen —
// genau das ging nicht, als der Rumpf inline emittiert wurde
fn outerFallthrough(x: int64): int64 {
  var acc: int64 := x;
  fn helper(v: int64): int64 { return v * 2; }
  acc := acc + 1;
  acc := helper(acc);
  acc := acc + 1;
  return acc;
}

fn main(): int64 {
  expect("einfach", outerSimple(41), 42);
  expect("Aufruf vor Deklaration", outerForward(40), 42);
  expect("zwei verschachtelte", outerTwo(20), 42);
  expect("fn in fn", outerDeep(40), 42);
  expect("Rekursion", outerRec(5), 120);
  expect("globales con sichtbar", outerGlobal(32), 42);
  expect("mehrfacher Aufruf", outerRepeat(39), 42);
  expect("Durchlauf nach Deklaration", outerFallthrough(19), 41);

  if (fails == 0) { PrintLn("ALL OK"); return 0; }
  PrintLn("FAILURES");
  return 1;
}
