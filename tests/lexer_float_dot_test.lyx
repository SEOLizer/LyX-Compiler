// tests/lexer_float_dot_test.lyx
// WP-1.1-B: Float-Literal vs. Methoden-Dot
//
// Verifies that the lexer correctly distinguishes:
//   42.toStr()  → INT(42) + DOT + IDENT  (method call on integer)
//   42.0        → FLOAT(42.0)            (float literal)
//   42.0.size   → FLOAT(42.0) + DOT + IDENT  (float + member access)
//   3.14_159    → FLOAT (numeric separator in decimal part)

@description("WP-1.1-B: float-literal vs. method-dot disambiguation")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.lexer_float_dot_test;

// Helper: return string representation of an integer
fn intStr(n: int64): pchar {
  return IntToStr(n);
}

// Helper: simple f64 equality check (avoids f64 arithmetic issues)
fn feq(a: f64, b: f64): int64 {
  var ai: int64 := a as int64;
  var bi: int64 := b as int64;
  if (ai == bi) { return 1; }
  return 0;
}

// --- 1. Integer literal before dot: no float produced ---
fn testIntBeforeDot(): int64 {
  var x: int64 := 42;
  var s: pchar := intStr(x);
  if (StrLen(s) == 0) { Print("FAIL: intStr\n"); return 1; }
  // The expression 'x' was declared as int64, not float.
  // If lexer incorrectly parsed '42.' as float during parsing of
  // similar constructs we'd see type errors at compile time.
  Print("OK: int literal not confused with float\n");
  return 0;
}

// --- 2. Float literal: 42.0 ---
fn testFloatLiteral(): int64 {
  var f: f64 := 42.0;
  // 42.0 as int64 bits = well-known IEEE 754 value
  if (feq(f, 42.0) == 0) { Print("FAIL: 42.0 float literal\n"); return 1; }
  Print("OK: 42.0 float literal\n");
  return 0;
}

// --- 3. Float literal: 3.14 ---
fn testFloatPi(): int64 {
  var pi: f64 := 3.14;
  if (feq(pi, 3.14) == 0) { Print("FAIL: 3.14 float literal\n"); return 1; }
  Print("OK: 3.14 float literal\n");
  return 0;
}

// --- 4. Integer-like variable name after dot is not confused ---
fn testIntVarAfterDot(): int64 {
  // If the lexer parsed 'n.' as a float token it would break here.
  // This compiles only if 'n' is TK_INT and '.' is TK_DOT.
  var n: int64 := 7;
  // Accessing n in an expression followed by arithmetic after a dot somewhere
  var result: int64 := n;
  if (result != 7) { Print("FAIL: int var\n"); return 1; }
  Print("OK: int variable distinct from float start\n");
  return 0;
}

// --- 5. Float with numeric separator in decimal part: 3.14_159 ---
fn testFloatSeparator(): int64 {
  var tau: f64 := 3.14_159;
  var base: f64 := 3.14;
  // Compare as f64 — NOT via 'as int64'. That cast truncates, so both values
  // collapse to 3 and the check can never fail, whatever the literal parsed to.
  if (tau <= base) { Print("FAIL: 3.14_159 should be > 3.14\n"); return 1; }
  Print("OK: 3.14_159 numeric separator in float\n");
  return 0;
}

// --- 5b. Separator in the integer part: 1_000.5 ---
fn testFloatSeparatorIntPart(): int64 {
  var v: f64 := 1_000.5;
  var lo: f64 := 1000.0;
  var hi: f64 := 1001.0;
  if (v <= lo || v >= hi) { Print("FAIL: 1_000.5 should lie between 1000 and 1001\n"); return 1; }
  Print("OK: 1_000.5 numeric separator in integer part\n");
  return 0;
}

// --- 6. Zero-argument float: 0.0 ---
fn testZeroFloat(): int64 {
  var z: f64 := 0.0;
  var zi: int64 := z as int64;
  if (zi != 0) { Print("FAIL: 0.0 should be 0\n"); return 1; }
  Print("OK: 0.0 float literal\n");
  return 0;
}

// --- 7. Chained: float literal followed by field access (future method calls) ---
fn testFloatFieldAccess(): int64 {
  // 42.0 must tokenize as TK_FLOAT, then '.' as TK_DOT when accessing a struct field.
  // We can't test actual method calls on floats yet (no methods on primitives),
  // but we verify the expression parses: the compiler must NOT produce a FLOAT(42.0.)
  // by consuming the dot into the float token.
  var container: f64 := 42.0;
  if (feq(container, 42.0) == 0) { Print("FAIL: float container\n"); return 1; }
  Print("OK: float literal parsed, dot left for next token\n");
  return 0;
}

pub fn main(): int64 {
  if (testIntBeforeDot()      != 0) { return 1; }
  if (testFloatLiteral()      != 0) { return 1; }
  if (testFloatPi()           != 0) { return 1; }
  if (testIntVarAfterDot()    != 0) { return 1; }
  if (testFloatSeparator()    != 0) { return 1; }
  if (testFloatSeparatorIntPart() != 0) { return 1; }
  if (testZeroFloat()         != 0) { return 1; }
  if (testFloatFieldAccess()  != 0) { return 1; }
  Print("All WP-1.1-B float-dot tests passed.\n");
  return 0;
}
