// LX-10 Test: alle 13 IPC-Syscalls kompilieren + Syscall-Nummern prüfen.

import src.std.lyxos.ipc;
import src.std.alloc;

fn main(): int64 {
    // sys_mutex_lock / sys_mutex_unlock
    var mtx: int64 := 0;
    sys_mutex_lock(mtx);
    sys_mutex_unlock(mtx);

    // sys_sem_create / sys_sem_wait / sys_sem_post / sys_sem_destroy
    var sem: int64 := sys_sem_create(1);
    sys_sem_wait(sem);
    sys_sem_post(sem);
    sys_sem_destroy(sem);

    // sys_channel_create / sys_channel_send / sys_channel_recv
    var fds:     int64 := sys_channel_create(CHAN_NONE);
    var send_fd: int64 := fds >> CHAN_SEND_SHIFT;
    var recv_fd: int64 := fds & CHAN_RECV_MASK;
    var msg: int64 := alloc(16);
    sys_channel_send(send_fd, msg as pchar, 16);
    sys_channel_recv(recv_fd, msg as pchar, 16);

    // sys_notify_create / sys_notify_send / sys_notify_recv
    var nq: int64 := sys_notify_create(NOTIFY_NONE);
    sys_notify_send(nq, 1);
    sys_notify_recv(nq, NOTIFY_WAIT_ANY);

    // sys_futex
    var futword: int64 := alloc(8);
    poke8(futword, MUTEX_UNLOCKED);
    sys_futex(futword as pchar, FUTEX_WAKE, 1);

    return 0;
}
