// Die Capability-Bindung ist KEIN Papier: was eine Unit nicht deklariert,
// verhindert der Kernel.
//
// Dieses Programm deklariert nur `fs.read`. Der Handler versucht zu
// SCHREIBEN. Erwartet wird kein höflicher Fehlercode, sondern das Ende des
// Prozesses durch SIGSYS — die Entscheidung liegt beim seccomp-Filter, den
// der Übersetzer aus dem Attribut erzeugt, und nicht bei SemaRTI.
//
// Damit ist die Kette vollständig: SemaRTI prüft, ob eine Operation nur
// deklarierte Rechte verlangt (Registry), und der Kernel setzt durch, dass
// die Unit nichts anderes tut. Keine der beiden Prüfungen allein genügt.
@capabilities([fs.read])
unit main;

import std.io;
import std.fs;

fn main(): int64 {
  var argc: int64 := GetArgC();
  var argv: pchar := GetArgV();
  var was: int64 := 0;
  if (argc > 1) { was := StrToInt(ArgvGet(argv, 1)); }

  if (was == 0) {
    // Der erlaubte Fall: lesen. Muss durchlaufen.
    PrintStrLn("LESEN_ERLAUBT"c);
    return 0;
  }
  // Der verbotene Fall: schreiben, ohne fs.write deklariert zu haben.
  PrintStrLn("VERSUCHE_SCHREIBEN"c);
  var r: int64 := WriteFile("/tmp/semarti_darf_nicht.txt"c, "x"c, 1);
  PrintStr("SCHREIBEN_LIEF_DURCH r="c); PrintLn(r);
  return 0;
}
