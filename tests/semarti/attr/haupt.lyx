// Nutzt die aus @operation ERZEUGTE Unit. Dass dieses Programm läuft, ist
// der Nachweis: die Deskriptoren kommen aus den Attributen am Code, und
// niemand hat sie von Hand eingetragen.
@capabilities([fs.read])
unit main;

import std.io;
import std.string;
import std.semarti.wert;
import std.semarti.schema;
import std.semarti.registry;
import std.semarti.objekte;
import std.semarti.ablauf;
import semarti_erzeugt;

var _fehler: int64 := 0;
fn pruefe(name: pchar, b: int64): void {
  if (b != 0) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStrLn(name); _fehler := _fehler + 1; }
}

fn auth(oi: int64, objekt: int64, principal: pchar): int64 { return 1; }
fn pol(oi: int64, objekt: int64, ein: int64, principal: pchar): int64 { return SRA_POLICY_ERLAUBT; }

fn main(): int64 {
  var n: int64 := SemartiRegistrieren();
  pruefe("erzeugte_unit_registrierte_zwei"c, n == 2);
  pruefe("registry_kennt_zwei"c, RegistryAnzahl() == 2);

  var oi1: int64 := RegistryFinde("com.example.doc.read_title"c);
  pruefe("erste_id_aus_dem_attribut"c, oi1 >= 0);
  pruefe("erste_version_1_0_0"c, OpMajor(oi1) == 1 && OpMinor(oi1) == 0 && OpPatch(oi1) == 0);
  pruefe("erste_risiko_nur_lesen"c, OpRisiko(oi1) == SRR_RISIKO_NUR_LESEN);
  pruefe("erste_ohne_bestaetigung"c, OpBestaetigung(oi1) == SRR_BESTAETIGUNG_NICHT_NOETIG);
  pruefe("erste_braucht_instanz"c, OpObjektbindung(oi1) == SRR_OBJEKT_NOETIG);

  var oi2: int64 := RegistryFinde("com.example.doc.export"c);
  pruefe("zweite_id_aus_dem_attribut"c, oi2 >= 0);
  pruefe("zweite_version_2_1_3"c, OpMajor(oi2) == 2 && OpMinor(oi2) == 1 && OpPatch(oi2) == 3);
  pruefe("zweite_risiko_aussenwirkung"c, OpRisiko(oi2) == SRR_RISIKO_AUSSENWIRKUNG);
  pruefe("zweite_mit_bestaetigung"c, OpBestaetigung(oi2) == SRR_BESTAETIGUNG_NOETIG);

  // Und der Aufruf läuft über denselben geprüften Pfad wie eine von Hand
  // registrierte Operation.
  RegistryAbschliessen();
  AblaufAuthorizerSetzen(auth);
  AblaufPolicySetzen(pol);
  var o: int64 := ObjektRegistrieren("Doc"c, "d1"c, SRO_WURZEL);
  var e: int64 := WertObjekt();
  WertFeldSetzen(e, "key"c, WertText("k"c));
  pruefe("aufruf_der_erzeugten_operation"c,
      AblaufAufrufen("com.example.doc.read_title"c, 1, 0, o, e, "nutzer"c, 0) == SRA_OK);
  pruefe("ausgabe_stimmt"c,
      StrEq(WertTextwert(WertFeld(AblaufLetzteAusgabe(), "content"c)), "Titel"c) != 0);
  // Die bestätigungspflichtige bleibt ohne Bestätigung stehen — die Angabe
  // kam aus dem Attribut.
  var e2: int64 := WertObjekt();
  WertFeldSetzen(e2, "key"c, WertText("k"c));
  pruefe("bestaetigung_aus_dem_attribut_greift"c,
      AblaufAufrufen("com.example.doc.export"c, 2, 1, o, e2, "nutzer"c, 0) == SRA_CONFIRMATION_REQUIRED);

  if (_fehler != 0) { PrintStr("FEHLER="c); PrintLn(_fehler); return 1; }
  PrintStrLn("ALL PASS"c);
  return 0;
}
