// #2419 Punkt 1: Deskriptoren am Code statt daneben.
//
// Die Metadaten, die mit dem Code auseinanderlaufen können, stehen am
// Attribut; das Schema bleibt eine Funktion, weil es verschachtelt ist.
// Die Namenskonvention <fn>_eingabeschema / <fn>_ausgabeschema verbindet
// beides, und der Übersetzer meldet eine fehlende Funktion beim Bauen der
// erzeugten Unit — nicht die Laufzeit.
@capabilities([fs.read])
unit semarti_traeger;

import std.io;
import std.semarti.wert;
import std.semarti.registry;

pub fn schemaMit(feld: pchar): int64 {
  var s: int64 := WertObjekt();
  WertFeldSetzen(s, "type"c, WertText("object"c));
  var p: int64 := WertObjekt();
  var f: int64 := WertObjekt();
  WertFeldSetzen(f, "type"c, WertText("string"c));
  WertFeldSetzen(p, feld, f);
  WertFeldSetzen(s, "properties"c, p);
  var r: int64 := WertListe();
  WertGliedAnhaengen(r, WertText(feld));
  WertFeldSetzen(s, "required"c, r);
  return s;
}

pub fn titelLesen_eingabeschema(): int64 { return schemaMit("key"c); }
pub fn titelLesen_ausgabeschema(): int64 { return schemaMit("content"c); }

@operation(id: "com.example.doc.read_title", version: "1.0.0", risk: read_only, confirm: false, instance: true)
pub fn titelLesen(eingabe: int64, ausgabe: int64, objekt: int64, principal: int64): int64 {
  WertFeldSetzen(ausgabe, "content"c, WertText("Titel"c));
  return 0;
}

pub fn exportieren_eingabeschema(): int64 { return schemaMit("key"c); }
pub fn exportieren_ausgabeschema(): int64 { return schemaMit("content"c); }

@operation(id: "com.example.doc.export", version: "2.1.3", risk: external, confirm: true, instance: true)
pub fn exportieren(eingabe: int64, ausgabe: int64, objekt: int64, principal: int64): int64 {
  WertFeldSetzen(ausgabe, "content"c, WertText("exportiert"c));
  return 0;
}

