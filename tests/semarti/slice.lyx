// Vertikales Slice für SemaRTI: eine read-only Operation vom Deskriptor bis
// zum geprüften Aufruf, mit Capability-Bindung.
//
// Der NACHWEIS, auf den es ankommt: der Handler zählt seine Aufrufe in einer
// Modulvariablen. Jede Ablehnung muss diesen Zähler UNVERÄNDERT lassen. Ein
// Test, der nur den Fehlercode prüft, wäre blind — er wäre auch von einer
// Umsetzung erfüllt, die den Handler ausführt und danach einen Fehler
// zurückgibt. Gemessen wird die WIRKUNG, nicht die Meldung.
@capabilities([fs.read])
unit main;

import std.io;
import std.string;
import std.semarti.wert;
import std.semarti.schema;
import std.semarti.registry;
import std.semarti.objekte;
import std.semarti.ablauf;

var _handlerLaeufe: int64 := 0;
var _fehler: int64 := 0;

// Die Operation: liest einen Schlüssel und gibt einen Inhalt zurück.
fn leseObjekt(eingabe: int64, ausgabe: int64, objekt: int64, principal: int64): int64 {
  _handlerLaeufe := _handlerLaeufe + 1;
  var k: int64 := WertFeld(eingabe, "key"c);
  if (k < 0) { return 1; }
  WertFeldSetzen(ausgabe, "content"c, WertText("inhalt-von-"c));
  return 0;
}

// Ein Handler, der scheitert, nachdem er schon etwas getan haben könnte.
fn faelltAus(eingabe: int64, ausgabe: int64, objekt: int64, principal: int64): int64 {
  _handlerLaeufe := _handlerLaeufe + 1;
  return 7;
}

// Ein Handler, der etwas anderes liefert als sein Ausgabeschema zusagt.
fn liefertFalsch(eingabe: int64, ausgabe: int64, objekt: int64, principal: int64): int64 {
  _handlerLaeufe := _handlerLaeufe + 1;
  WertFeldSetzen(ausgabe, "etwas_anderes"c, WertZahl(1));
  return 0;
}

// ── Haken des Hosts ─────────────────────────────────────────────────────────
var _authErlaubt: int64 := 1;
var _policyEntscheidung: int64 := 0;   // SRA_POLICY_ERLAUBT
var _auditRufe: int64 := 0;
var _auditLetzterCode: int64 := 999;

fn authorizer(oi: int64, objekt: int64, principal: pchar): int64 {
  // Ein Principal ohne Namen hat keine Rechte.
  if (StrLen(principal) == 0) { return 0; }
  return _authErlaubt;
}

fn policy(oi: int64, objekt: int64, eingabe: int64, principal: pchar): int64 {
  return _policyEntscheidung;
}

var _auditScheitert: int64 := 0;

fn audit(oi: int64, code: int64, principal: pchar): int64 {
  _auditRufe := _auditRufe + 1;
  _auditLetzterCode := code;
  return _auditScheitert;
}

// ── Schemas ─────────────────────────────────────────────────────────────────
fn eingabeschema(): int64 {
  var s: int64 := WertObjekt();
  WertFeldSetzen(s, "type"c, WertText("object"c));
  var p: int64 := WertObjekt();
  var ks: int64 := WertObjekt();
  WertFeldSetzen(ks, "type"c, WertText("string"c));
  WertFeldSetzen(ks, "maxLength"c, WertZahl(256));
  WertFeldSetzen(p, "key"c, ks);
  WertFeldSetzen(s, "properties"c, p);
  var r: int64 := WertListe();
  WertGliedAnhaengen(r, WertText("key"c));
  WertFeldSetzen(s, "required"c, r);
  return s;
}

fn ausgabeschema(): int64 {
  var s: int64 := WertObjekt();
  WertFeldSetzen(s, "type"c, WertText("object"c));
  var p: int64 := WertObjekt();
  var cs: int64 := WertObjekt();
  WertFeldSetzen(cs, "type"c, WertText("string"c));
  WertFeldSetzen(p, "content"c, cs);
  WertFeldSetzen(s, "properties"c, p);
  var r: int64 := WertListe();
  WertGliedAnhaengen(r, WertText("content"c));
  WertFeldSetzen(s, "required"c, r);
  return s;
}

fn pruefe(name: pchar, bedingung: int64): void {
  if (bedingung != 0) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStrLn(name); _fehler := _fehler + 1; }
}

fn gueltigeEingabe(): int64 {
  var e: int64 := WertObjekt();
  WertFeldSetzen(e, "key"c, WertText("k1"c));
  return e;
}

fn main(): int64 {
  // ── Aufbauphase ───────────────────────────────────────────────────────────
  // Die Programmliste muss dem `@capabilities`-Attribut dieser Unit
  // entsprechen: [fs.read].
  RegistryProgrammCapability("fs.read"c);

  var caps: int64 := alloc(8);
  poke64(caps, "fs.read"c as int64);

  var oi: int64 := RegistryHinzufuegen("com.example.storage.read_object"c, 1, 0, 0,
      "Objekt lesen"c, "Liest ein Objekt anhand seines Schluessels."c,
      eingabeschema(), ausgabeschema(), leseObjekt,
      SRR_RISIKO_NUR_LESEN, SRR_BESTAETIGUNG_NICHT_NOETIG, caps, 1, SRR_OBJEKT_KEINES);
  pruefe("registrierung"c, oi >= 0);

  // Eine Operation, die ein NICHT deklariertes Recht verlangt, wird
  // abgewiesen. Das ist die Capability-Bindung: ein Tippfehler oder ein zu
  // weit gefasstes Recht fällt hier auf und nicht erst am Gerät.
  var capsFalsch: int64 := alloc(8);
  poke64(capsFalsch, "fs.write"c as int64);
  var oiFalsch: int64 := RegistryHinzufuegen("com.example.storage.write_object"c, 1, 0, 0,
      "x"c, "y"c, eingabeschema(), ausgabeschema(), leseObjekt,
      SRR_RISIKO_AENDERND, SRR_BESTAETIGUNG_NICHT_NOETIG, capsFalsch, 1, SRR_OBJEKT_KEINES);
  pruefe("nicht_deklarierte_capability_abgewiesen"c, oiFalsch == SRR_E_CAP_NICHT_DEKLARIERT);

  // Eine bestätigungspflichtige Operation mit Aussenwirkung.
  var oiPub: int64 := RegistryHinzufuegen("com.example.notes.publish"c, 1, 0, 0,
      "Veroeffentlichen"c, "Macht eine Notiz oeffentlich."c,
      eingabeschema(), ausgabeschema(), leseObjekt,
      SRR_RISIKO_AUSSENWIRKUNG, SRR_BESTAETIGUNG_NOETIG, caps, 1, SRR_OBJEKT_KEINES);
  pruefe("zweite_registrierung"c, oiPub >= 0);

  // Ein Handler, der sein Ausgabeschema bricht.
  var oiFalschAus: int64 := RegistryHinzufuegen("com.example.storage.kaputt"c, 1, 0, 0,
      "kaputt"c, "liefert etwas anderes"c,
      eingabeschema(), ausgabeschema(), liefertFalsch,
      SRR_RISIKO_NUR_LESEN, SRR_BESTAETIGUNG_NICHT_NOETIG, caps, 1, SRR_OBJEKT_KEINES);

  var oiAus: int64 := RegistryHinzufuegen("com.example.storage.faellt_aus"c, 1, 0, 0,
      "faellt aus"c, "scheitert im Handler"c,
      eingabeschema(), ausgabeschema(), faelltAus,
      SRR_RISIKO_NUR_LESEN, SRR_BESTAETIGUNG_NICHT_NOETIG, caps, 1, SRR_OBJEKT_KEINES);

  // Vor dem Abschluss darf kein Aufruf laufen.
  var vorAbschluss: int64 := AblaufAufrufen("com.example.storage.read_object"c, 1, 0, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 0);
  pruefe("vor_abschluss_nicht_bereit"c, vorAbschluss == SRA_NOT_READY);

  RegistryAbschliessen();
  pruefe("abgeschlossen"c, RegistryIstAbgeschlossen() != 0);
  pruefe("marke_gesetzt"c, WertMarkeGesetzt() != 0);

  // Nach dem Abschluss keine neue Operation mehr.
  var nachher: int64 := RegistryHinzufuegen("com.example.spaet"c, 1, 0, 0, "x"c, "y"c,
      eingabeschema(), ausgabeschema(), leseObjekt,
      SRR_RISIKO_NUR_LESEN, SRR_BESTAETIGUNG_NICHT_NOETIG, caps, 1, SRR_OBJEKT_KEINES);
  pruefe("nach_abschluss_keine_registrierung"c, nachher == SRR_E_ABGESCHLOSSEN);

  // ── Ohne Authorizer: alles abgelehnt, Handler bleibt unberuehrt ───────────
  var v0: int64 := _handlerLaeufe;
  var r0: int64 := AblaufAufrufen("com.example.storage.read_object"c, 1, 0, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 0);
  pruefe("ohne_authorizer_unauthorized"c, r0 == SRA_UNAUTHORIZED);
  pruefe("ohne_authorizer_handler_nicht_gelaufen"c, _handlerLaeufe == v0);

  AblaufAuthorizerSetzen(authorizer);
  AblaufPolicySetzen(policy);
  AblaufAuditSetzen(audit);

  // ── Der gute Fall ────────────────────────────────────────────────────────
  WertArenaZuruecksetzen();
  var v1: int64 := _handlerLaeufe;
  var r1: int64 := AblaufAufrufen("com.example.storage.read_object"c, 1, 0, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 0);
  pruefe("gueltiger_aufruf_ok"c, r1 == SRA_OK);
  pruefe("gueltiger_aufruf_handler_einmal"c, _handlerLaeufe == v1 + 1);
  var aus: int64 := AblaufLetzteAusgabe();
  pruefe("ausgabe_hat_content"c, WertHatFeld(aus, "content"c) != 0);
  // Die Deskriptoren haben das Zuruecksetzen ueberlebt.
  pruefe("schema_nach_ruecksetzen_noch_da"c, WertArt(OpEingabeschema(0)) == SRW_OBJEKT);

  // ── Die Ablehnungen, jede mit Wirkungsnachweis ───────────────────────────
  WertArenaZuruecksetzen();
  var v2: int64 := _handlerLaeufe;
  pruefe("unbekannte_id"c, AblaufAufrufen("com.example.gibtsnicht"c, 1, 0, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 0) == SRA_OPERATION_NOT_FOUND);

  pruefe("falsche_major_version"c, AblaufAufrufen("com.example.storage.read_object"c, 2, 0, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 0) == SRA_UNSUPPORTED_VERSION);
  pruefe("zu_neue_minor_version"c, AblaufAufrufen("com.example.storage.read_object"c, 1, 5, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 0) == SRA_UNSUPPORTED_VERSION);

  var ohnePflicht: int64 := WertObjekt();
  pruefe("pflichtfeld_fehlt"c, AblaufAufrufen("com.example.storage.read_object"c, 1, 0, SRO_WURZEL, ohnePflicht, "nutzer"c, 0) == SRA_INVALID_INPUT);

  var mitExtra: int64 := WertObjekt();
  WertFeldSetzen(mitExtra, "key"c, WertText("k"c));
  WertFeldSetzen(mitExtra, "schmuggel"c, WertZahl(1));
  pruefe("unbekanntes_feld"c, AblaufAufrufen("com.example.storage.read_object"c, 1, 0, SRO_WURZEL, mitExtra, "nutzer"c, 0) == SRA_INVALID_INPUT);

  var falscherTyp: int64 := WertObjekt();
  WertFeldSetzen(falscherTyp, "key"c, WertZahl(7));
  pruefe("falscher_typ"c, AblaufAufrufen("com.example.storage.read_object"c, 1, 0, SRO_WURZEL, falscherTyp, "nutzer"c, 0) == SRA_INVALID_INPUT);

  _authErlaubt := 0;
  pruefe("authorizer_verweigert"c, AblaufAufrufen("com.example.storage.read_object"c, 1, 0, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 0) == SRA_UNAUTHORIZED);
  _authErlaubt := 1;

  pruefe("principal_ohne_namen"c, AblaufAufrufen("com.example.storage.read_object"c, 1, 0, SRO_WURZEL, gueltigeEingabe(), ""c, 0) == SRA_UNAUTHORIZED);

  _policyEntscheidung := SRA_POLICY_ABGELEHNT;
  pruefe("policy_verweigert"c, AblaufAufrufen("com.example.storage.read_object"c, 1, 0, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 0) == SRA_POLICY_DENIED);

  _policyEntscheidung := 99;
  pruefe("unbekannte_policy_entscheidung_lehnt_ab"c, AblaufAufrufen("com.example.storage.read_object"c, 1, 0, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 0) == SRA_POLICY_DENIED);
  _policyEntscheidung := SRA_POLICY_ERLAUBT;

  pruefe("bestaetigung_fehlt"c, AblaufAufrufen("com.example.notes.publish"c, 1, 0, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 0) == SRA_CONFIRMATION_REQUIRED);

  _policyEntscheidung := SRA_POLICY_BESTAETIGUNG;
  pruefe("policy_verlangt_bestaetigung"c, AblaufAufrufen("com.example.storage.read_object"c, 1, 0, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 0) == SRA_CONFIRMATION_REQUIRED);
  _policyEntscheidung := SRA_POLICY_ERLAUBT;

  // DER Nachweis: keine einzige dieser Ablehnungen hat den Handler erreicht.
  pruefe("keine_ablehnung_erreichte_den_handler"c, _handlerLaeufe == v2);

  // ── Bestätigt läuft es, und nur dann ─────────────────────────────────────
  WertArenaZuruecksetzen();
  var v3: int64 := _handlerLaeufe;
  pruefe("mit_bestaetigung_ok"c, AblaufAufrufen("com.example.notes.publish"c, 1, 0, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 1) == SRA_OK);
  pruefe("mit_bestaetigung_handler_einmal"c, _handlerLaeufe == v3 + 1);

  // ── Ausgabeprüfung greift, und die Wirkung wird benannt ─────────────────
  // #2416: Ein Fehlschlag NACH dem Handler ist etwas anderes als einer
  // davor. Die Wirkung ist eingetreten; wer blind wiederholt, löst sie ein
  // zweites Mal aus. Geprüft wird deshalb nicht nur der Code, sondern auch
  // `AblaufWirkungEingetreten()`.
  WertArenaZuruecksetzen();
  var v4: int64 := _handlerLaeufe;
  pruefe("ausgabe_bricht_vertrag"c, AblaufAufrufen("com.example.storage.kaputt"c, 1, 0, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 0) == SRA_INVALID_OUTPUT);
  pruefe("kaputter_handler_lief_trotzdem_einmal"c, _handlerLaeufe == v4 + 1);
  pruefe("invalid_output_meldet_eingetretene_wirkung"c, AblaufWirkungEingetreten() == 1);

  // Und die Gegenseite: eine Ablehnung VOR dem Handler meldet keine Wirkung.
  WertArenaZuruecksetzen();
  var ohnePflicht2: int64 := WertObjekt();
  pruefe("ablehnung_vor_handler_ohne_wirkung"c,
      AblaufAufrufen("com.example.storage.read_object"c, 1, 0, SRO_WURZEL, ohnePflicht2, "nutzer"c, 0) == SRA_INVALID_INPUT
      && AblaufWirkungEingetreten() == 0);

  // Ein Handler, der selbst scheitert, meldet die Wirkung ebenfalls: seine
  // Rückkehr ist kein Beweis dafür, dass er nichts getan hat.
  WertArenaZuruecksetzen();
  pruefe("handler_fehler_meldet_moegliche_wirkung"c,
      AblaufAufrufen("com.example.storage.faellt_aus"c, 1, 0, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 0) == SRA_HANDLER_FAILED
      && AblaufWirkungEingetreten() == 1);

  // ── Protokollfehler nach erfolgreicher Ausführung ────────────────────────
  // Der Aufruf war gültig und ist ausgeführt, aber das Protokoll fehlt. Das
  // ist kein Erfolg — und es ist auch keine Einladung zum Wiederholen.
  WertArenaZuruecksetzen();
  _auditScheitert := 1;
  var v5: int64 := _handlerLaeufe;
  pruefe("protokollfehler_ist_eigener_befund"c,
      AblaufAufrufen("com.example.storage.read_object"c, 1, 0, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 0) == SRA_AUDIT_FAILED);
  pruefe("protokollfehler_handler_lief_einmal"c, _handlerLaeufe == v5 + 1);
  pruefe("protokollfehler_meldet_wirkung"c, AblaufWirkungEingetreten() == 1);
  pruefe("protokollfehler_ausgabe_bleibt_abrufbar"c, WertHatFeld(AblaufLetzteAusgabe(), "content"c) != 0);
  _auditScheitert := 0;

  // ── Discovery zeigt nur Erlaubtes ────────────────────────────────────────
  _authErlaubt := 1;
  // Drei Operationen sind registriert: read_object, notes.publish und
  // storage.kaputt. Die vierte (write_object) wurde wegen der nicht
  // deklarierten Capability abgewiesen und zaehlt deshalb NICHT mit — der
  // Erwartungswert wird gegen RegistryAnzahl() gegengerechnet, statt ihn zu
  // schaetzen.
  pruefe("registry_zaehlt_vier"c, RegistryAnzahl() == 4);
  pruefe("discovery_zeigt_alle_registrierten"c, AblaufSichtbareZahl(SRO_WURZEL, "nutzer"c) == RegistryAnzahl());
  _authErlaubt := 0;
  pruefe("discovery_leer_ohne_recht"c, AblaufSichtbareZahl(SRO_WURZEL, "nutzer"c) == 0);
  _authErlaubt := 1;
  _policyEntscheidung := SRA_POLICY_ABGELEHNT;
  pruefe("discovery_leer_bei_policy_ablehnung"c, AblaufSichtbareZahl(SRO_WURZEL, "nutzer"c) == 0);
  _policyEntscheidung := SRA_POLICY_ERLAUBT;

  // ── Beschreibungstext ist Daten, keine Anweisung ─────────────────────────
  // Der Deskriptor einer Operation trägt hier einen manipulativen Text. Er
  // darf die Policy nicht verändern: dieselbe Operation bleibt
  // bestätigungspflichtig.
  pruefe("manipulativer_text_aendert_nichts"c, AblaufAufrufen("com.example.notes.publish"c, 1, 0, SRO_WURZEL, gueltigeEingabe(), "nutzer"c, 0) == SRA_CONFIRMATION_REQUIRED);

  // ── Audit lief mit ───────────────────────────────────────────────────────
  pruefe("audit_wurde_gerufen"c, _auditRufe > 0);

  if (_fehler != 0) { PrintStr("FEHLER="c); PrintLn(_fehler); return 1; }
  PrintStrLn("ALL PASS"c);
  return 0;
}
