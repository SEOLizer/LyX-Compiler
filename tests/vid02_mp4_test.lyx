// tests/vid02_mp4_test.lyx — VID-02: MP4 Reader Tests
//
// Builds a minimal ISOBMFF MP4 (317 bytes):
//   ftyp[20]: isom
//   moov[297]:
//     mvhd[108]: v0, timescale=1000, duration=5000 → 5000ms
//     trak[181]:
//       tkhd[92]:  v0, width=1280 (16.16), height=720 (16.16)
//       mdia[81]:
//         hdlr[33]: handler='vide'
//         minf[40]:
//           stbl[32]:
//             stsd[24]: entry='avc1' → H.264

unit tests.vid02_mp4_test;

import std.video.core;
import std.video.mp4;
import std.alloc;
import std.io;

fn put32BE(buf: int64, off: int64, val: int64): void {
    poke8(buf+off,   (val >> 24) & 255);
    poke8(buf+off+1, (val >> 16) & 255);
    poke8(buf+off+2, (val >>  8) & 255);
    poke8(buf+off+3,  val        & 255);
}

fn put4cc(buf: int64, off: int64, a: int64, b: int64, c: int64, d: int64): void {
    poke8(buf+off, a); poke8(buf+off+1, b); poke8(buf+off+2, c); poke8(buf+off+3, d);
}

fn zeroRange(buf: int64, start: int64, count: int64): void {
    var i: int64 := 0;
    while (i < count) { poke8(buf + start + i, 0); i := i + 1; }
}

// Identity matrix for tkhd/mvhd (36 bytes, big-endian fixed-point 16.16)
fn writeMatrix(buf: int64, off: int64): void {
    put32BE(buf, off+0,  0x00010000);  // a = 1.0
    put32BE(buf, off+4,  0);            // b
    put32BE(buf, off+8,  0);            // u
    put32BE(buf, off+12, 0);            // c
    put32BE(buf, off+16, 0x00010000);  // d = 1.0
    put32BE(buf, off+20, 0);            // v
    put32BE(buf, off+24, 0);            // tx
    put32BE(buf, off+28, 0);            // ty
    put32BE(buf, off+32, 0x40000000);  // w = 1.0 (2.30 fixed)
}

fn makeTestMp4(buf: int64): int64 {
    zeroRange(buf, 0, 512);

    // ---- ftyp box [0..19] (20 bytes) ----
    put32BE(buf, 0, 20);
    put4cc(buf, 4, 0x66,0x74,0x79,0x70);   // 'ftyp'
    put4cc(buf, 8, 0x69,0x73,0x6F,0x6D);   // 'isom'
    put32BE(buf, 12, 0);                     // minor_version
    put4cc(buf, 16, 0x69,0x73,0x6F,0x6D);  // compat 'isom'

    // ---- moov box [20..316] (297 bytes) ----
    put32BE(buf, 20, 297);
    put4cc(buf, 24, 0x6D,0x6F,0x6F,0x76);  // 'moov'

    // ---- mvhd [28..135] (108 bytes) ----
    put32BE(buf, 28, 108);
    put4cc(buf, 32, 0x6D,0x76,0x68,0x64);  // 'mvhd'
    put32BE(buf, 36, 0);                     // version=0, flags=0
    put32BE(buf, 40, 0);                     // creation_time
    put32BE(buf, 44, 0);                     // modification_time
    put32BE(buf, 48, 1000);                  // timescale
    put32BE(buf, 52, 5000);                  // duration (5s at 1000Hz)
    put32BE(buf, 56, 0x00010000);            // rate = 1.0
    poke8(buf+60, 0x01); poke8(buf+61, 0x00);  // volume = 1.0
    // reserved 10 bytes [62..71] = zeros
    writeMatrix(buf, 72);                    // matrix [72..107]
    // pre_defined 24 bytes [108..131] = zeros
    put32BE(buf, 132, 2);                    // next_track_id

    // ---- trak [136..316] (181 bytes) ----
    put32BE(buf, 136, 181);
    put4cc(buf, 140, 0x74,0x72,0x61,0x6B);  // 'trak'

    // ---- tkhd [144..235] (92 bytes) ----
    put32BE(buf, 144, 92);
    put4cc(buf, 148, 0x74,0x6B,0x68,0x64);  // 'tkhd'
    put32BE(buf, 152, 3);                     // version=0, flags=3 (enabled|in_movie)
    put32BE(buf, 156, 0);                     // creation_time
    put32BE(buf, 160, 0);                     // modification_time
    put32BE(buf, 164, 1);                     // track_id
    put32BE(buf, 168, 0);                     // reserved
    put32BE(buf, 172, 5000);                  // duration
    // reserved 8 bytes [176..183] = zeros
    // layer(2) + alt_group(2) + volume(2) + reserved(2) [184..191] = zeros
    writeMatrix(buf, 192);                    // matrix [192..227]
    // width = 1280 in 16.16 fixed: 1280 << 16 = 0x05000000
    put32BE(buf, 228, 0x05000000);
    // height = 720 in 16.16 fixed: 720 << 16 = 0x02D00000
    put32BE(buf, 232, 0x02D00000);

    // ---- mdia [236..316] (81 bytes) ----
    put32BE(buf, 236, 81);
    put4cc(buf, 240, 0x6D,0x64,0x69,0x61);  // 'mdia'

    // ---- hdlr [244..276] (33 bytes) ----
    put32BE(buf, 244, 33);
    put4cc(buf, 248, 0x68,0x64,0x6C,0x72);  // 'hdlr'
    put32BE(buf, 252, 0);                     // version=0, flags=0
    put32BE(buf, 256, 0);                     // pre_defined
    put4cc(buf, 260, 0x76,0x69,0x64,0x65);  // handler_type='vide'
    // reserved 12 bytes [264..275] = zeros
    poke8(buf+276, 0);                        // name '\0'

    // ---- minf [277..316] (40 bytes) ----
    put32BE(buf, 277, 40);
    put4cc(buf, 281, 0x6D,0x69,0x6E,0x66);  // 'minf'

    // ---- stbl [285..316] (32 bytes) ----
    put32BE(buf, 285, 32);
    put4cc(buf, 289, 0x73,0x74,0x62,0x6C);  // 'stbl'

    // ---- stsd [293..316] (24 bytes) ----
    put32BE(buf, 293, 24);
    put4cc(buf, 297, 0x73,0x74,0x73,0x64);  // 'stsd'
    put32BE(buf, 301, 0);                     // version=0, flags=0
    put32BE(buf, 305, 1);                     // entry_count=1
    // avc1 entry [309..316]: size=8, type='avc1'
    put32BE(buf, 309, 8);
    put4cc(buf, 313, 0x61,0x76,0x63,0x31);  // 'avc1'

    return 317;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;
    var buf: int64 := alloc(512);
    var len: int64 := makeTestMp4(buf);

    // -------------------------------------------------------------------------
    // Test 1: Mp4Meta — width, height, duration, codec
    // -------------------------------------------------------------------------
    var vid: int64 := alloc(VID_SIZE);
    var ret: int64 := Mp4Meta(buf, len, vid);
    if (ret != 1) {
        PrintLn("FAIL: Mp4Meta returned 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: Mp4Meta ret=1"c);

        var w: int64 := peek64(vid + VID_OFF_WIDTH);
        var h: int64 := peek64(vid + VID_OFF_HEIGHT);
        if (w != 1280) { PrintLn("FAIL: Mp4Meta width != 1280"c); ok := 0; }
        else            { PrintLn("PASS: Mp4Meta width=1280"c); }
        if (h != 720)  { PrintLn("FAIL: Mp4Meta height != 720"c); ok := 0; }
        else            { PrintLn("PASS: Mp4Meta height=720"c); }

        var dur: int64 := peek64(vid + VID_OFF_DURATION_MS);
        if (dur != 5000) { PrintLn("FAIL: Mp4Meta duration != 5000ms"c); ok := 0; }
        else              { PrintLn("PASS: Mp4Meta duration=5000ms"c); }

        var codec: int64 := peek64(vid + VID_OFF_CODEC);
        if (codec != VID_CODEC_H264) { PrintLn("FAIL: Mp4Meta codec != H264"c); ok := 0; }
        else                          { PrintLn("PASS: Mp4Meta codec=H264"c); }

        var fmt: int64 := peek64(vid + VID_OFF_FORMAT);
        if (fmt != VID_FMT_MP4) { PrintLn("FAIL: Mp4Meta format != MP4"c); ok := 0; }
        else                      { PrintLn("PASS: Mp4Meta format=MP4"c); }
    }
    free(vid, VID_SIZE);

    // -------------------------------------------------------------------------
    // Test 2: Mp4Meta — bad magic (no ftyp) → 0
    // -------------------------------------------------------------------------
    var badBuf: int64 := alloc(16);
    poke8(badBuf, 0); poke8(badBuf+1, 0); poke8(badBuf+2, 0); poke8(badBuf+3, 0);
    poke8(badBuf+4, 0); poke8(badBuf+5, 0); poke8(badBuf+6, 0); poke8(badBuf+7, 0);
    poke8(badBuf+8, 0); poke8(badBuf+9, 0); poke8(badBuf+10, 0); poke8(badBuf+11, 0);
    var vidBad: int64 := alloc(VID_SIZE);
    var retBad: int64 := Mp4Meta(badBuf, 16, vidBad);
    if (retBad != 0) {
        PrintLn("FAIL: Mp4Meta bad input should return 0"c); ok := 0;
    } else {
        PrintLn("PASS: Mp4Meta bad input → 0"c);
    }
    free(vidBad, VID_SIZE);
    free(badBuf, 16);

    // -------------------------------------------------------------------------
    // Test 3: VidDetectFormat on our MP4 buffer
    // -------------------------------------------------------------------------
    var fmt3: int64 := VidDetectFormat(buf, len);
    if (fmt3 != VID_FMT_MP4) {
        PrintLn("FAIL: VidDetectFormat on MP4 buf"c); ok := 0;
    } else {
        PrintLn("PASS: VidDetectFormat MP4 buf"c);
    }

    free(buf, 512);

    if (ok != 0) {
        PrintLn("=== VID-02: ALL PASS ==="c);
    } else {
        PrintLn("=== VID-02: SOME FAIL ==="c);
    }
    return ok;
}
