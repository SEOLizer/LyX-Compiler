  poke8(sig+48, 56);  poke8(sig+49, 123); poke8(sig+50, 46);  poke8(sig+51, 174);
  poke8(sig+52, 180); poke8(sig+53, 48);  poke8(sig+54, 42);  poke8(sig+55, 238);
  poke8(sig+56, 176); poke8(sig+57, 13);  poke8(sig+58, 41);  poke8(sig+59, 22);
  poke8(sig+60, 18);  poke8(sig+61, 187); poke8(sig+62, 12);  poke8(sig+63, 0);
}

fn main() {
  // ── Tests 1-5: SHA-512 Testvektoren ─────────────────────────────────────────
  // SHA-512("abc") = ddaf35a193617abacc417349ae204131...a54ca49f
  var abc: int64 := alloc(4);
  poke8(abc, 97); poke8(abc+1, 98); poke8(abc+2, 99);  // "abc"
  var h512: int64 := alloc(64);
  lic_sha512(abc, 3, h512);

  if peek8(h512+0)  == 0xdd { pass(1); } else { fail(1); }   // Byte 0
  if peek8(h512+1)  == 0xaf { pass(2); } else { fail(2); }   // Byte 1
  if peek8(h512+2)  == 0x35 { pass(3); } else { fail(3); }   // Byte 2
  if peek8(h512+3)  == 0xa1 { pass(4); } else { fail(4); }   // Byte 3
  if peek8(h512+63) == 0x9f { pass(5); } else { fail(5); }   // Letztes Byte
  free(abc, 4); free(h512, 64);

  // ── Tests 6-8: Ed25519 akzeptiert RFC-8032-TV1 (leere Nachricht) ─────────────
  var pk1: int64 := alloc(32); var sig1: int64 := alloc(64);
  var msg0: int64 := alloc(1); // leere Nachricht (nicht-null Pointer)
  _fillTV1PubKey(pk1); _fillTV1Sig(sig1);

  var ok1: bool := lic_ed25519_verify(msg0, 0, sig1, pk1);
  if ok1     { pass(6); } else { fail(6); }

  // Selbe Verifikation ein zweites Mal (deterministisch)
  ok1 := lic_ed25519_verify(msg0, 0, sig1, pk1);
  if ok1     { pass(7); } else { fail(7); }

  // Falsche Nachrichtenlänge (1 statt 0) → muss false sein
  var ok1b: bool := lic_ed25519_verify(msg0, 1, sig1, pk1);
  if not ok1b { pass(8); } else { fail(8); }

  free(pk1, 32); free(sig1, 64); free(msg0, 1);

  // ── Tests 9-12: Ed25519 akzeptiert RFC-8032-TV2 (Nachricht = 0x72) ───────────
  var pk2: int64 := alloc(32); var sig2: int64 := alloc(64);
  var msg1: int64 := alloc(1);
  poke8(msg1, 0x72);  // Nachricht: ein Byte 'r' = 0x72
  _fillTV2PubKey(pk2); _fillTV2Sig(sig2);

  var ok2: bool := lic_ed25519_verify(msg1, 1, sig2, pk2);
  if ok2     { pass(9);  } else { fail(9); }

  // TV1-Signatur mit TV2-PublicKey → Fehlschlag
  var sig1b: int64 := alloc(64); _fillTV1Sig(sig1b);
  var ok2b: bool := lic_ed25519_verify(msg1, 1, sig1b, pk2);
  if not ok2b { pass(10); } else { fail(10); }
  free(sig1b, 64);

  // TV2-Signatur mit TV1-PublicKey → Fehlschlag
  var pk1c: int64 := alloc(32); _fillTV1PubKey(pk1c);
  var ok2c: bool := lic_ed25519_verify(msg1, 1, sig2, pk1c);
  if not ok2c { pass(11); } else { fail(11); }
  free(pk1c, 32);

  // Leere Nachricht mit TV2-Signatur und TV2-PublicKey → Fehlschlag
  var msg0b: int64 := alloc(1);
  var ok2d: bool := lic_ed25519_verify(msg0b, 0, sig2, pk2);
  if not ok2d { pass(12); } else { fail(12); }
  free(msg0b, 1);

  free(pk2, 32); free(sig2, 64); free(msg1, 1);

  // ── Tests 13-15: Manipulierte Signatur → Ablehnung ───────────────────────────
  var pk3: int64 := alloc(32); var sig3: int64 := alloc(64);
  var msg3: int64 := alloc(1);
  _fillTV1PubKey(pk3); _fillTV1Sig(sig3);

  // Byte 0 der Signatur flippen
  poke8(sig3, peek8(sig3) ^ 1);
  var ok3a: bool := lic_ed25519_verify(msg3, 0, sig3, pk3);
  if not ok3a { pass(13); } else { fail(13); }

  // Byte 32 der Signatur flippen (S-Teil)
  _fillTV1Sig(sig3); poke8(sig3+32, peek8(sig3+32) ^ 1);
  var ok3b: bool := lic_ed25519_verify(msg3, 0, sig3, pk3);
  if not ok3b { pass(14); } else { fail(14); }

  // Letztes Byte der Signatur flippen
  _fillTV1Sig(sig3); poke8(sig3+63, peek8(sig3+63) ^ 1);
  var ok3c: bool := lic_ed25519_verify(msg3, 0, sig3, pk3);
  if not ok3c { pass(15); } else { fail(15); }

  free(pk3, 32); free(sig3, 64); free(msg3, 1);

  // ── Tests 16-18: Manipulierter Public Key → Ablehnung ────────────────────────
  var pk4: int64 := alloc(32); var sig4: int64 := alloc(64);
  var msg4: int64 := alloc(1);
  _fillTV1PubKey(pk4); _fillTV1Sig(sig4);

  poke8(pk4, peek8(pk4) ^ 1);
  var ok4a: bool := lic_ed25519_verify(msg4, 0, sig4, pk4);
  if not ok4a { pass(16); } else { fail(16); }

  _fillTV1PubKey(pk4); poke8(pk4+16, peek8(pk4+16) ^ 1);
  var ok4b: bool := lic_ed25519_verify(msg4, 0, sig4, pk4);
  if not ok4b { pass(17); } else { fail(17); }

  _fillTV1PubKey(pk4); poke8(pk4+31, peek8(pk4+31) ^ 1);
  var ok4c: bool := lic_ed25519_verify(msg4, 0, sig4, pk4);
  if not ok4c { pass(18); } else { fail(18); }

  free(pk4, 32); free(sig4, 64); free(msg4, 1);

  // ── Tests 19-20: Base64 Encode/Decode Roundtrip ──────────────────────────────
  var raw: int64 := alloc(64); var enc: int64 := alloc(96); var dec: int64 := alloc(64);
  // TV1-Signatur kodieren/dekodieren
  _fillTV1Sig(raw);
  var encLen: int64 := lic_base64Encode(raw, 64, enc);
  var decLen: int64 := lic_base64Decode(enc, encLen, dec);

  if decLen == 64 { pass(19); } else { fail(19); }

  // Prüfe erste 4 Bytes identisch
  var same: int64 := 1;
  var bi: int64 := 0;
  while bi < 64 {
    if peek8(raw+bi) != peek8(dec+bi) { same := 0; }
    bi := bi + 1;
  }
  if same == 1 { pass(20); } else { fail(20); }

  free(raw, 64); free(enc, 96); free(dec, 64);
}
