fn _fillTV2PubKey(pk: int64) {
  // RFC 8032 Test-Vektor 2 Public Key:
  // 3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c
  poke8(pk+0,  61);  poke8(pk+1,  64);  poke8(pk+2,  23);  poke8(pk+3,  195);
  poke8(pk+4,  232); poke8(pk+5,  67);  poke8(pk+6,  137); poke8(pk+7,  90);
