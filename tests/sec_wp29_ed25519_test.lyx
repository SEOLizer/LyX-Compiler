  // RFC 8032 Test-Vektor 2 Signatur (Nachricht: 0x72):
  // 92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00
  poke8(sig+0,  146); poke8(sig+1,  160); poke8(sig+2,  9);   poke8(sig+3,  169);
  poke8(sig+4,  240); poke8(sig+5,  212); poke8(sig+6,  202); poke8(sig+7,  184);
  poke8(sig+8,  114); poke8(sig+9,  14);  poke8(sig+10, 130); poke8(sig+11, 11);
  poke8(sig+12, 95);  poke8(sig+13, 100); poke8(sig+14, 37);  poke8(sig+15, 64);
  poke8(sig+16, 162); poke8(sig+17, 178); poke8(sig+18, 123); poke8(sig+19, 84);
  poke8(sig+20, 22);  poke8(sig+21, 80);  poke8(sig+22, 63);  poke8(sig+23, 143);
  poke8(sig+24, 179); poke8(sig+25, 118); poke8(sig+26, 34);  poke8(sig+27, 35);
  poke8(sig+28, 235); poke8(sig+29, 219); poke8(sig+30, 105); poke8(sig+31, 218);
  poke8(sig+32, 8);   poke8(sig+33, 90);  poke8(sig+34, 193); poke8(sig+35, 228);
  poke8(sig+36, 62);  poke8(sig+37, 21);  poke8(sig+38, 153); poke8(sig+39, 110);
  poke8(sig+40, 69);  poke8(sig+41, 143); poke8(sig+42, 54);  poke8(sig+43, 19);
