  poke8(sig+0,  229); poke8(sig+1,  86);  poke8(sig+2,  67);  poke8(sig+3,  0);
  poke8(sig+4,  195); poke8(sig+5,  96);  poke8(sig+6,  172); poke8(sig+7,  114);
