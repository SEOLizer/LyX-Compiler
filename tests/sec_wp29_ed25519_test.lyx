// tests/sec_wp29_ed25519_test.lyx — WP-29: Ed25519-Verifikation (20 Tests)
//
// Prüft:
//   C-1: SHA-512 korrekte Ausgabe (RFC-Testvektor "abc")
//   C-2: Ed25519-Verify akzeptiert gültige Signaturen (RFC-8032-TV1, TV2)
//   C-3: Ed25519-Verify lehnt manipulierte Signaturen ab
//   C-4: Base64-Encode/Decode Roundtrip für 64-Byte-Daten
unit tests.sec_wp29_ed25519_test;

import src.crypto.lic_sha512;
import src.crypto.lic_base64;
import src.crypto.lic_ed25519;
import src.std.alloc;

fn pass(n: int64) { Print("PASS "); PrintLn(n); }
fn fail(n: int64) { Print("FAIL "); PrintLn(n); }

// ── Hilfsfunktion: Puffer mit Testvektor-Bytes füllen ─────────────────────────

fn _fillTV1PubKey(pk: int64) {
  // RFC 8032 Test-Vektor 1 Public Key:
  // d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a
  poke8(pk+0,  215); poke8(pk+1,  90);  poke8(pk+2,  152); poke8(pk+3,  1);
  poke8(pk+4,  130); poke8(pk+5,  177); poke8(pk+6,  10);  poke8(pk+7,  183);
  poke8(pk+8,  213); poke8(pk+9,  75);  poke8(pk+10, 254); poke8(pk+11, 211);
  poke8(pk+12, 201); poke8(pk+13, 100); poke8(pk+14, 7);   poke8(pk+15, 58);
  poke8(pk+16, 14);  poke8(pk+17, 225); poke8(pk+18, 114); poke8(pk+19, 243);
  poke8(pk+20, 218); poke8(pk+21, 166); poke8(pk+22, 35);  poke8(pk+23, 37);
  poke8(pk+24, 175); poke8(pk+25, 2);   poke8(pk+26, 26);  poke8(pk+27, 104);
  poke8(pk+28, 247); poke8(pk+29, 7);   poke8(pk+30, 81);  poke8(pk+31, 26);
}

