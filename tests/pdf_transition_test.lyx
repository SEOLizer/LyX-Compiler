}

fn testTransWithMeta(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew (meta)\n"); return 1; }

  PdfSetTitle(doc, "Transition+Meta Test");
  PdfSetAuthor(doc, "Test Suite");

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Slide with meta 1");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Slide with meta 2");

  PdfSetPageTransition(doc, 0, PDF_TRANS_GLITTER, 100);
  PdfSetPageTransition(doc, 1, PDF_TRANS_BOX,     150);

  var err: int64 := PdfSave(doc, "/tmp/pdf_trans_meta.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (meta)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_trans_meta.pdf");
  if (rdr == 0) { PrintStr("FAIL: PdfOpen (meta)\n"); return 1; }
  var buf: int64 := mmap(0, 256, 3, 34, -1, 0);
  PdfRdrGetTitle(rdr, buf, 256);
  var ok: int64 := 1;
  if (peek8(buf) == 0) { ok := 0; }
  munmap(buf, 256);
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (ok == 0 || n != 2) {
    PrintStr("FAIL: trans+meta (titleOk=");
    PrintInt(ok);
    PrintStr(" pages=");
    PrintInt(n);
    PrintStr(")\n");
    return 1;
  }
  PrintStr("OK: transitions with metadata\n");
  return 0;
}

pub fn main(): int64 {
  if (testTransDissolve()   != 0) { return 1; }
  if (testTransWipe()       != 0) { return 1; }
  if (testTransMultiStyle() != 0) { return 1; }
  if (testTransNoTrans()    != 0) { return 1; }
  if (testTransWithMeta()   != 0) { return 1; }
  PrintStr("All WP-PDF-12 page transition tests passed.\n");
  return 0;
}
