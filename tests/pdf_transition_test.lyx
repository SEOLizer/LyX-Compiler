// tests/pdf_transition_test.lyx
// WP-PDF-12: page transitions

@description("WP-PDF-12: PDF page transition tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pdf_transition_test;

import std.pdf;

fn testTransDissolve(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Slide 1");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Slide 2");

  PdfSetPageTransition(doc, 0, PDF_TRANS_DISSOLVE, 100);
  PdfSetPageTransition(doc, 1, PDF_TRANS_DISSOLVE, 100);

  var err: int64 := PdfSave(doc, "/tmp/pdf_trans_dissolve.pdf");
  PdfFree(doc);
  if (err != 0) {
    PrintStr("FAIL: PdfSave (dissolve) err=");
    PrintInt(err);
    PrintStr("\n");
    return 1;
  }

  var rdr: int64 := PdfOpen("/tmp/pdf_trans_dissolve.pdf");
  if (rdr == 0) { PrintStr("FAIL: PdfOpen (dissolve)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 2) {
    PrintStr("FAIL: dissolve page count expected 2, got ");
    PrintInt(n);
    PrintStr("\n");
    return 1;
  }
  PrintStr("OK: dissolve transition\n");
  return 0;
}

