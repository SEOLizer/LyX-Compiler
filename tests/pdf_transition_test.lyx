fn testTransMultiStyle(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew (multi)\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p2: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Push page");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Cover page");
  PdfSetFont(doc, p2, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p2, 72.0, 750.0, "Fly page");

  PdfSetPageTransition(doc, 0, PDF_TRANS_PUSH,  150);
  PdfSetPageTransition(doc, 1, PDF_TRANS_COVER, 100);
  PdfSetPageTransition(doc, 2, PDF_TRANS_FLY,     0);

  var err: int64 := PdfSave(doc, "/tmp/pdf_trans_multi.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (multi)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_trans_multi.pdf");
  if (rdr == 0) { PrintStr("FAIL: PdfOpen (multi)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 3) { PrintStr("FAIL: multi page count\n"); return 1; }
  PrintStr("OK: mixed transition styles\n");
  return 0;
}

fn testTransNoTrans(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew (none)\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "No transitions");

  var err: int64 := PdfSave(doc, "/tmp/pdf_trans_none.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (none)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_trans_none.pdf");
  if (rdr == 0) { PrintStr("FAIL: PdfOpen (none)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
