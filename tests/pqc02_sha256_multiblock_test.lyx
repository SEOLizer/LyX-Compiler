// tests/pqc02_sha256_multiblock_test.lyx
// WP-PQC-02: SHA-256 Multi-Block — SHA256 + HashSHA256Bytes
// NIST FIPS 180-4 known-answer tests

import std.crypto.sha256;
import std.alloc;
import std.io;

fn hexByte(val: int64): int64 {
  if (val >= 48 && val <= 57)  { return val - 48; }
  if (val >= 97 && val <= 102) { return val - 87; }
  return 0;
}

fn hexToBytes(hex: pchar, out: int64, len: int64): void {
  var i: int64 := 0;
  while (i < len) {
    var hi: int64 := hexByte(StrCharAt(hex, i * 2)     & 0xFF);
    var lo: int64 := hexByte(StrCharAt(hex, i * 2 + 1) & 0xFF);
    poke8(out + i, (hi << 4) | lo);
    i := i + 1;
  }
}

fn digestEq(a: int64, b: int64): int64 {
  var i: int64 := 0;
  while (i < 32) {
    if (peek8(a + i) != peek8(b + i)) { return 0; }
    i := i + 1;
  }
  return 1;
}

pub fn main(): int64 {
  var got: int64 := alloc(32);
  var exp: int64 := alloc(32);

  // ── Test 1: SHA-256("") ──────────────────────────────────────────────────
  // FIPS 180-4: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
  hexToBytes("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"c, exp, 32);
  var empty: pchar := ""c;
  SHA256(empty as int64, 0, got);
  if (digestEq(got, exp) == 0) {
    Print("FAIL: SHA256(\"\") digest mismatch\n");
    free(got, 32); free(exp, 32); return 1;
  }
  Print("OK: SHA256(\"\") matches NIST vector\n");

  // ── Test 2: SHA-256("abc") ───────────────────────────────────────────────
  // expected: ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
  hexToBytes("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"c, exp, 32);
  var msg2: pchar := "abc"c;
  SHA256(msg2 as int64, 3, got);
  if (digestEq(got, exp) == 0) {
    Print("FAIL: SHA256(\"abc\") digest mismatch\n");
    free(got, 32); free(exp, 32); return 1;
  }
  Print("OK: SHA256(\"abc\") matches NIST vector\n");

  // ── Test 3: 56-byte input (2-block padding needed) ───────────────────────
  // "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
  // expected: 248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1
  hexToBytes("248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"c, exp, 32);
  var msg3: pchar := "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"c;
  SHA256(msg3 as int64, 56, got);
  if (digestEq(got, exp) == 0) {
    Print("FAIL: SHA256(56-byte) digest mismatch\n");
    free(got, 32); free(exp, 32); return 1;
  }
  Print("OK: SHA256(56-byte, 2-block padding) matches NIST vector\n");

  // ── Test 4: 112-byte input (multiple full blocks) ────────────────────────
  // expected: cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1
  hexToBytes("cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1"c, exp, 32);
  var msg4: pchar := "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"c;
  SHA256(msg4 as int64, 112, got);
  if (digestEq(got, exp) == 0) {
    Print("FAIL: SHA256(112-byte) digest mismatch\n");
    free(got, 32); free(exp, 32); return 1;
  }
  Print("OK: SHA256(112-byte, 3 blocks) matches NIST vector\n");

  // ── Test 5: HashSHA256Bytes("abc") ───────────────────────────────────────
  hexToBytes("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"c, exp, 32);
  HashSHA256Bytes(msg2 as int64, 3, got);
  if (digestEq(got, exp) == 0) {
    Print("FAIL: HashSHA256Bytes(\"abc\") mismatch\n");
    free(got, 32); free(exp, 32); return 1;
  }
  Print("OK: HashSHA256Bytes(\"abc\") matches NIST vector\n");

  // ── Test 6: HashSHA256Bytes(112-byte) ────────────────────────────────────
  hexToBytes("cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1"c, exp, 32);
  HashSHA256Bytes(msg4 as int64, 112, got);
  if (digestEq(got, exp) == 0) {
    Print("FAIL: HashSHA256Bytes(112-byte) mismatch\n");
    free(got, 32); free(exp, 32); return 1;
  }
  Print("OK: HashSHA256Bytes(112-byte) matches NIST vector\n");

  // ── Test 7: SHA256Hex("abc") ─────────────────────────────────────────────
  var hexOut: int64 := alloc(65);
  SHA256Hex(msg2 as int64, 3, hexOut);
  var expHex: pchar := "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"c;
  var hexOk: int64 := 1;
  var hi: int64 := 0;
  while (hi < 64) {
    if (peek8(hexOut + hi) != StrCharAt(expHex, hi)) { hexOk := 0; }
    hi := hi + 1;
  }
  if (hexOk == 0) {
    Print("FAIL: SHA256Hex(\"abc\") mismatch\n");
    free(hexOut, 65); free(got, 32); free(exp, 32); return 1;
  }
  Print("OK: SHA256Hex(\"abc\") matches\n");
  free(hexOut, 65);

  free(got, 32);
  free(exp, 32);
  Print("All WP-PQC-02 tests passed.\n");
  return 0;
}
