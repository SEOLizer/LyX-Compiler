// tests/feq_test.lyx
// Selbstpruefende Testbatterie fuer std.feq.
//
// Sollwerte aus Python (math.ulp, math.nextafter, struct.pack fuer die
// Bitmuster). Viele Pruefungen brauchen gar keine fremde Zahl: dass
// FeqNextUp genau ein ULP weiter liegt, dass -0.0 und +0.0 gleich sind aber
// verschiedene Vorzeichenbits haben, dass NaN sich selbst ungleich ist — das
// sind Festlegungen von IEEE 754 und muessen ohne Referenz gelten.

unit main;

import std.feq;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn Check(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > tol) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" (bool)\n"c);
  }
}

fn main(): int64 {
  var zero: f64 := 0.0;
  var nan: f64 := zero / zero;
  var inf: f64 := 1.0 / zero;
  var ninf: f64 := 0.0 - inf;
  // -0.0 entsteht NICHT durch 0.0 - 0.0 (das ist nach IEEE +0.0), sondern
  // durch Multiplikation mit einem negativen Wert
  var negOne: f64 := -1.0;
  var negZero: f64 := zero * negOne;

  // ── Bitmuster ─────────────────────────────────────────────────────────────
  CheckI("bits1"c, FeqBits(1.0), 4607182418800017408);
  CheckI("bits0"c, FeqBits(0.0), 0);
  CheckI("bitsNegZero"c, FeqBits(negZero), 0 - 9223372036854775807 - 1);
  Check("fromBits1"c, FeqFromBits(4607182418800017408), 1.0, 0.0);
  // kleinste subnormale Zahl hat Bitmuster 1
  var tiny: f64 := FeqFromBits(1);
  CheckB("tinyPositive"c, tiny > 0.0, true);
  CheckB("tinySubnormal"c, FeqIsSubnormal(tiny), true);

  // ── Klassifikation ────────────────────────────────────────────────────────
  CheckB("isNaN"c, FeqIsNaN(nan), true);
  CheckB("isNaNNo"c, FeqIsNaN(1.0), false);
  CheckB("isNaNInf"c, FeqIsNaN(inf), false);
  CheckB("isInf"c, FeqIsInf(inf), true);
  CheckB("isInfNeg"c, FeqIsInf(ninf), true);
  CheckB("isInfNo"c, FeqIsInf(1.0), false);
  CheckB("isInfNaN"c, FeqIsInf(nan), false);
  CheckB("isFinite"c, FeqIsFinite(1.0), true);
  CheckB("isFiniteNaN"c, FeqIsFinite(nan), false);
  CheckB("isFiniteInf"c, FeqIsFinite(inf), false);
  CheckB("isZero"c, FeqIsZero(0.0), true);
  // -0.0 ist im Vergleich gleich +0.0 — das ist IEEE, kein Fehler
  CheckB("isZeroNeg"c, FeqIsZero(negZero), true);
  CheckB("negZeroEqualsZero"c, negZero == zero, true);
  // im Vorzeichenbit unterscheiden sie sich aber
  CheckB("signBitNegZero"c, FeqSignBit(negZero), true);
  CheckB("signBitZero"c, FeqSignBit(zero), false);
  CheckB("signBitNeg"c, FeqSignBit(-1.0), true);
  CheckB("signBitPos"c, FeqSignBit(1.0), false);
  CheckB("subnormalNo"c, FeqIsSubnormal(1.0), false);
  CheckB("subnormalZero"c, FeqIsSubnormal(0.0), false);

  // ── ULP ───────────────────────────────────────────────────────────────────
  // Die Sollwerte kommen aus BITMUSTERN, nicht aus Literalen: ein Literal wie
  // 0.0000000000000002220446049250313 wird vom Parser zu 2.2e-16 verstuemmelt
  // (#1478). Ausgerechnet beim Pruefen des Maschinen-Epsilons waere das fatal.
  Check("ulp1"c, FeqUlp(1.0), FeqFromBits(4372995238176751616), 0.0);
  Check("ulpHalf"c, FeqUlp(0.5), FeqFromBits(4368491638549381120), 0.0);
  Check("ulp1e9"c, FeqUlp(1000000000.0), FeqFromBits(4503599627370496000), 0.0);
  // das Maschinen-Epsilon IST das ULP bei 1.0
  Check("epsIsUlp1"c, FeqEpsilon(), FeqUlp(1.0), 0.0);

  Check("nextUp1"c, FeqNextUp(1.0), FeqFromBits(4607182418800017409), 0.0);
  Check("nextDown1"c, FeqNextDown(1.0), FeqFromBits(4607182418800017407), 0.0);
  Check("nextUpZero"c, FeqNextUp(0.0), tiny, 0.0);
  // ueber die Null hinweg: nextDown(0) ist die kleinste negative Zahl
  CheckB("nextDownZeroNeg"c, FeqNextDown(0.0) < 0.0, true);
  CheckB("nextUpNaN"c, FeqIsNaN(FeqNextUp(nan)), true);
  CheckB("nextUpInf"c, FeqIsInf(FeqNextUp(inf)), true);
  // hoch und wieder runter fuehrt zurueck
  Check("nextRoundtrip"c, FeqNextDown(FeqNextUp(1.0)), 1.0, 0.0);
  Check("nextRoundtrip2"c, FeqNextUp(FeqNextDown(7.5)), 7.5, 0.0);

  CheckI("ulpsSame"c, FeqUlpsBetween(1.0, 1.0), 0);
  CheckI("ulpsOne"c, FeqUlpsBetween(1.0, FeqNextUp(1.0)), 1);
  CheckI("ulpsThree"c, FeqUlpsBetween(1.0, FeqNextUp(FeqNextUp(FeqNextUp(1.0)))), 3);
  CheckI("ulpsNaN"c, FeqUlpsBetween(nan, 1.0), -1);
  // 0.1+0.2 und 0.3 liegen genau ein ULP auseinander — das ist der
  // beruehmte Fall, und er ist so nah, wie es ueberhaupt geht
  var sum: f64 := 0.1 + 0.2;
  CheckB("classicNotEqual"c, sum == 0.3, false);
  CheckI("classicOneUlp"c, FeqUlpsBetween(sum, 0.3), 1);
  // ueber die Null hinweg zaehlt die Spiegelung richtig
  CheckI("ulpsAcrossZero"c, FeqUlpsBetween(0.0 - tiny, tiny), 2);

  // ── Absolute, relative und kombinierte Vergleiche ─────────────────────────
  var big: f64 := 1000000000.0;
  var big1: f64 := 1000000001.0;

  // absolut: bei grossen Zahlen zu streng
  CheckB("absBigFails"c, FeqAbs(big, big1, 0.000000001), false);
  // relativ: hier richtig
  CheckB("relBigOk"c, FeqRel(big, big1, 0.000001), true);
  CheckB("relBigStrict"c, FeqRel(big, big1, 0.0000000001), false);

  // Kleine Werte werden per Division erzeugt, nicht als Literal: unterhalb
  // von 1e-18 liefert der Parser 0 (#1478), und dann wuerde der Test das
  // Gegenteil dessen pruefen, was dasteht.
  var small20: f64 := 1.0 / 100000000000000000000.0;         // 1e-20
  var small30: f64 := small20 / 10000000000.0;               // 1e-30
  // absolut: bei kleinen Zahlen zu grosszuegig
  CheckB("absSmallTooLoose"c, FeqAbs(small20, small30, 0.000000001), true);
  // relativ erkennt den Unterschied
  CheckB("relSmallStrict"c, FeqRel(small20, small30, 0.001), false);

  // relativ gegen null: scheitert grundsaetzlich
  CheckB("relZeroFails"c, FeqRel(0.0, 0.0000000000000001, 0.001), false);
  // absolut ist dort richtig
  CheckB("absZeroOk"c, FeqAbs(0.0, 0.0000000000000001, 0.000000000001), true);
  CheckB("feqZeroOk"c, FeqZero(0.0000000000000001, 0.000000000001), true);
  CheckB("feqZeroNo"c, FeqZero(0.001, 0.000000000001), false);

  // die kombinierte Fassung kann beides
  CheckB("equalBig"c, FeqEqual(big, big1, 0.000000000001, 0.000001), true);
  CheckB("equalNearZero"c, FeqEqual(0.0, 0.0000000000000001, 0.000000000001, 0.000001), true);
  CheckB("equalDiffers"c, FeqEqual(1.0, 1.1, 0.000000000001, 0.000001), false);
  CheckB("equalClassic"c, FeqEqual(sum, 0.3, 0.000000000001, 0.000000001), true);
  CheckB("equalSame"c, FeqEqual(1.0, 1.0, 0.0, 0.0), true);

  // NaN ist zu nichts gleich, auch nicht zu sich selbst
  CheckB("nanNotEqualNan"c, FeqEqual(nan, nan, 1.0, 1.0), false);
  CheckB("nanNotEqualAbs"c, FeqAbs(nan, nan, 1.0), false);
  CheckB("nanNotEqualRel"c, FeqRel(nan, nan, 1.0), false);
  CheckB("nanNotEqualUlps"c, FeqUlps(nan, nan, 100, 0.0), false);
  // unendlich ist sich selbst gleich
  CheckB("infEqualsInf"c, FeqEqual(inf, inf, 0.0, 0.0), true);
  CheckB("infNotNinf"c, FeqEqual(inf, ninf, 1.0, 1.0), false);
  // unendlich gegen eine endliche Zahl: nie gleich, egal wie gross die Toleranz
  CheckB("infVsFinite"c, FeqRel(inf, 1.0, 1000000.0), false);

  // ── ULP-Vergleich ─────────────────────────────────────────────────────────
  CheckB("ulpsEqual1"c, FeqUlps(1.0, FeqNextUp(1.0), 1, 0.0), true);
  CheckB("ulpsEqual0"c, FeqUlps(1.0, FeqNextUp(1.0), 0, 0.0), false);
  CheckB("ulpsClassic"c, FeqUlps(sum, 0.3, 2, 0.0), true);
  CheckB("ulpsFar"c, FeqUlps(1.0, 1.1, 4, 0.0), false);
  // verschiedene Vorzeichen: ohne absolute Schranke nicht gleich
  CheckB("ulpsSignDiffers"c, FeqUlps(tiny, 0.0 - tiny, 1000, 0.0), false);
  // mit absoluter Schranke schon
  CheckB("ulpsSignAbs"c, FeqUlps(tiny, 0.0 - tiny, 0, 0.000000000001), true);

  // ── Ordnung ───────────────────────────────────────────────────────────────
  CheckI("compareLess"c, FeqCompare(1.0, 2.0), -1);
  CheckI("compareGreater"c, FeqCompare(2.0, 1.0), 1);
  CheckI("compareEqual"c, FeqCompare(1.0, 1.0), 0);
  CheckI("compareNegZero"c, FeqCompare(negZero, zero), 0);
  CheckI("compareNaN"c, FeqCompare(nan, 1.0), 2);
  CheckI("compareNaNBoth"c, FeqCompare(nan, nan), 0);

  // totale Ordnung: -inf < -1 < -0 < +0 < 1 < +inf
  CheckI("totalNegInf"c, FeqTotalOrder(ninf, -1.0), -1);
  CheckI("totalNegOne"c, FeqTotalOrder(-1.0, negZero), -1);
  // hier unterscheidet die totale Ordnung, was der normale Vergleich gleich nennt
  CheckI("totalNegZero"c, FeqTotalOrder(negZero, zero), -1);
  CheckI("totalZero"c, FeqTotalOrder(zero, 1.0), -1);
  CheckI("totalInf"c, FeqTotalOrder(1.0, inf), -1);
  CheckI("totalSame"c, FeqTotalOrder(3.5, 3.5), 0);

  // ── Hilfsfunktionen ───────────────────────────────────────────────────────
  Check("clampLow"c, FeqClamp(-5.0, 0.0, 10.0), 0.0, 0.0);
  Check("clampHigh"c, FeqClamp(50.0, 0.0, 10.0), 10.0, 0.0);
  Check("clampInside"c, FeqClamp(5.0, 0.0, 10.0), 5.0, 0.0);
  CheckB("clampNaN"c, FeqIsNaN(FeqClamp(nan, 0.0, 10.0)), true);

  // Endpunkte muessen exakt getroffen werden
  Check("lerp0"c, FeqLerp(1.0, 2.0, 0.0), 1.0, 0.0);
  Check("lerp1"c, FeqLerp(1.0, 2.0, 1.0), 2.0, 0.0);
  Check("lerpHalf"c, FeqLerp(1.0, 2.0, 0.5), 1.5, 0.0);
  // auch bei krummen Werten, wo a + t*(b-a) danebenliegen kann
  Check("lerpExact"c, FeqLerp(0.1, 0.3, 1.0), 0.3, 0.0);

  Check("safeDiv"c, FeqSafeDiv(6.0, 3.0, -1.0), 2.0, 0.0);
  Check("safeDivZero"c, FeqSafeDiv(6.0, 0.0, -1.0), -1.0, 0.0);
  Check("safeDivNaN"c, FeqSafeDiv(0.0, 0.0, 42.0), 42.0, 0.0);

  // ── Rundung ───────────────────────────────────────────────────────────────
  Check("halfAway2.5"c, FeqRoundHalfAway(2.5), 3.0, 0.0);
  Check("halfAway3.5"c, FeqRoundHalfAway(3.5), 4.0, 0.0);
  Check("halfAwayNeg"c, FeqRoundHalfAway(-2.5), -3.0, 0.0);
  Check("halfAwayDown"c, FeqRoundHalfAway(2.4), 2.0, 0.0);

  // Bankiersrundung: zur geraden Zahl
  Check("halfEven2.5"c, FeqRoundHalfEven(2.5), 2.0, 0.0);
  Check("halfEven3.5"c, FeqRoundHalfEven(3.5), 4.0, 0.0);
  Check("halfEven4.5"c, FeqRoundHalfEven(4.5), 4.0, 0.0);
  Check("halfEvenNeg"c, FeqRoundHalfEven(-2.5), -2.0, 0.0);
  Check("halfEvenPlain"c, FeqRoundHalfEven(2.4), 2.0, 0.0);
  Check("halfEvenUp"c, FeqRoundHalfEven(2.6), 3.0, 0.0);

  // Der Unterschied summiert sich: 0.5+1.5+2.5+3.5 rundet kaufmaennisch zu
  // 1+2+3+4 = 10, bankiers zu 0+2+2+4 = 8. Der wahre Wert ist 8.
  var sumAway: f64 := FeqRoundHalfAway(0.5) + FeqRoundHalfAway(1.5)
                    + FeqRoundHalfAway(2.5) + FeqRoundHalfAway(3.5);
  var sumEven: f64 := FeqRoundHalfEven(0.5) + FeqRoundHalfEven(1.5)
                    + FeqRoundHalfEven(2.5) + FeqRoundHalfEven(3.5);
  Check("biasAway"c, sumAway, 10.0, 0.0);
  Check("biasEven"c, sumEven, 8.0, 0.0);
  Check("trueSum"c, 0.5 + 1.5 + 2.5 + 3.5, 8.0, 0.0);

  Check("roundTo2"c, FeqRoundTo(3.14159, 2), 3.14, 0.0000000001);
  Check("roundTo4"c, FeqRoundTo(3.14159, 4), 3.1416, 0.0000000001);
  Check("roundTo0"c, FeqRoundTo(3.7, 0), 4.0, 0.0);
  CheckB("roundToNaN"c, FeqIsNaN(FeqRoundTo(nan, 2)), true);
  // die dokumentierte Falle: 1.005 liegt in f64 knapp UNTER 1.005 und rundet
  // deshalb auf 1.0, nicht auf 1.01
  Check("roundToTrap"c, FeqRoundTo(1.005, 2), 1.0, 0.0);

  // ── Abschneiden, Nachkommateil ────────────────────────────────────────────
  Check("trunc2.7"c, FeqTrunc(2.7), 2.0, 0.0);
  Check("truncNeg2.7"c, FeqTrunc(-2.7), -2.0, 0.0);
  Check("truncExact"c, FeqTrunc(3.0), 3.0, 0.0);
  Check("truncZero"c, FeqTrunc(0.0), 0.0, 0.0);
  CheckB("truncNaN"c, FeqIsNaN(FeqTrunc(nan)), true);
  CheckB("truncInf"c, FeqIsInf(FeqTrunc(inf)), true);

  // jenseits von 2^63: hier liefert TruncF64 aus std.math Muell, weil es
  // ueber fToInt geht. Werte dieser Groesse sind bereits ganzzahlig, also
  // muss Abschneiden sie unveraendert lassen.
  var e19: f64 := 10000000000000000000.0;
  var e30: f64 := 1000000000000000000000000000000.0;
  CheckB("truncBig"c, FeqTrunc(e19) == e19, true);
  CheckB("truncHuge"c, FeqTrunc(e30) == e30, true);
  CheckB("truncBigNeg"c, FeqTrunc(0.0 - e19) == 0.0 - e19, true);
  // zum Vergleich: Floor und Ceil aus std.math sind dort korrekt
  CheckB("floorBigOk"c, FloorF64(e19) == e19, true);
  CheckB("ceilBigOk"c, CeilF64(e30) == e30, true);

  Check("frac"c, FeqFrac(2.75), 0.75, 0.0);
  Check("fracNeg"c, FeqFrac(-2.75), -0.75, 0.0);
  Check("fracExact"c, FeqFrac(3.0), 0.0, 0.0);

  // ── Floor- und Ceil-Division ──────────────────────────────────────────────
  // Lyx' `/` trunkiert: -7/2 ist -3. FeqFloorDiv rundet ab.
  CheckI("lyxDivTruncates"c, -7 / 2, -3);
  CheckI("floorDivNeg"c, FeqFloorDiv(-7, 2), -4);
  CheckI("floorDivPos"c, FeqFloorDiv(7, 2), 3);
  CheckI("floorDivBothNeg"c, FeqFloorDiv(-7, -2), 3);
  CheckI("floorDivNegDiv"c, FeqFloorDiv(7, -2), -4);
  CheckI("floorDivExact"c, FeqFloorDiv(6, 2), 3);
  CheckI("floorDivMinusOne"c, FeqFloorDiv(-1, 2), -1);
  CheckI("floorDivZero"c, FeqFloorDiv(0, 2), 0);
  CheckI("floorDivByZero"c, FeqFloorDiv(7, 0), 0);

  // Der Rest hat das Vorzeichen des Divisors — anders als bei `%`
  CheckI("lyxModTruncates"c, -7 % 3, -1);
  CheckI("floorModNeg"c, FeqFloorMod(-7, 3), 2);
  CheckI("floorModPos"c, FeqFloorMod(7, 3), 1);
  CheckI("floorModNegDiv"c, FeqFloorMod(7, -3), -2);
  CheckI("floorModExact"c, FeqFloorMod(6, 3), 0);
  // Grundgleichung: a = floorDiv(a,b)*b + floorMod(a,b)
  CheckI("divModIdentity"c, FeqFloorDiv(-7, 3) * 3 + FeqFloorMod(-7, 3), -7);
  CheckI("divModIdentity2"c, FeqFloorDiv(7, -3) * -3 + FeqFloorMod(7, -3), 7);

  CheckI("ceilDivPos"c, FeqCeilDiv(7, 2), 4);
  CheckI("ceilDivExact"c, FeqCeilDiv(6, 2), 3);
  CheckI("ceilDivNeg"c, FeqCeilDiv(-7, 2), -3);
  CheckI("ceilDivBothNeg"c, FeqCeilDiv(-7, -2), 4);
  CheckI("ceilDivZero"c, FeqCeilDiv(0, 2), 0);
  // der praktische Fall: Bloecke zaehlen
  CheckI("blocks10of3"c, FeqCeilDiv(10, 3), 4);
  CheckI("blocks9of3"c, FeqCeilDiv(9, 3), 3);

  // ── Auf Vielfache runden ──────────────────────────────────────────────────
  Check("floorTo"c, FeqFloorTo(7.3, 2.0), 6.0, 0.0);
  Check("ceilTo"c, FeqCeilTo(7.3, 2.0), 8.0, 0.0);
  Check("floorToNeg"c, FeqFloorTo(-7.3, 2.0), -8.0, 0.0);
  Check("ceilToNeg"c, FeqCeilTo(-7.3, 2.0), -6.0, 0.0);
  Check("floorToExact"c, FeqFloorTo(8.0, 2.0), 8.0, 0.0);
  Check("floorToBadStep"c, FeqFloorTo(7.3, 0.0), 7.3, 0.0);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
