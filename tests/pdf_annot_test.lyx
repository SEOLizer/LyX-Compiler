// tests/pdf_annot_test.lyx
// WP-PDF-08: annotations (URI links, GoTo page links, text notes)

@description("WP-PDF-08: annotation test")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pdf_annot_test;

import std.pdf;

fn testLinkURI(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 14.0);
  PdfTextAt(doc, page, 72.0, 750.0, "WP-PDF-08: URI link test");
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 720.0, "Click here: https://example.com");

  var ai: int64 := PdfAddLink(doc, page, 72.0, 712.0, 280.0, 730.0);
  PdfLinkSetURI(doc, ai, "https://example.com");

  var err: int64 := PdfSave(doc, "/tmp/pdf_annot_link.pdf");
  PdfFree(doc);
  if (err != 0) {
    PrintStr("FAIL: PdfSave (link) returned ");
    PrintInt(err);
    PrintStr("\n");
    return 1;
  }
  PrintStr("OK: URI link PDF saved to /tmp/pdf_annot_link.pdf\n");
  return 0;
}

fn testLinkGoto(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew\n"); return 1; }

  var page0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var page1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);

  PdfSetFont(doc, page0, PDF_FONT_HELVETICA, 14.0);
  PdfTextAt(doc, page0, 72.0, 750.0, "Page 1 — click to go to Page 2");
  PdfSetFont(doc, page0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page0, 72.0, 720.0, "[Go to page 2]");

  PdfSetFont(doc, page1, PDF_FONT_HELVETICA, 14.0);
  PdfTextAt(doc, page1, 72.0, 750.0, "Page 2 — you arrived via GoTo link");

  var ai: int64 := PdfAddLinkGoto(doc, page0, 72.0, 712.0, 200.0, 730.0);
  PdfLinkSetGoto(doc, ai, page1);

  var err: int64 := PdfSave(doc, "/tmp/pdf_annot_goto.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (goto)\n"); return 1; }
  PrintStr("OK: GoTo link PDF saved to /tmp/pdf_annot_goto.pdf\n");
  return 0;
}

