fn testSpecialCharsInAnnot(): int64 {
  // Parentheses and backslashes in title/content/URL must be escaped
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "Special chars in annotation strings");

  PdfAddNote(doc, page, 72.0, 720.0, "Note (1)", "Content with (parens) and \\slash.");

  var err: int64 := PdfSave(doc, "/tmp/pdf_annot_special.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (special)\n"); return 1; }
  PrintStr("OK: special-chars annotation PDF saved to /tmp/pdf_annot_special.pdf\n");
  return 0;
}

pub fn main(): int64 {
  if (testLinkURI()            != 0) { return 1; }
  if (testLinkGoto()           != 0) { return 1; }
  if (testTextNote()           != 0) { return 1; }
  if (testMixedAnnotations()   != 0) { return 1; }
  if (testNoAnnotations()      != 0) { return 1; }
  if (testSpecialCharsInAnnot() != 0) { return 1; }
  PrintStr("All WP-PDF-08 annotation tests passed.\n");
  return 0;
}
