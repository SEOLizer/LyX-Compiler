fn testMixedAnnotations(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew\n"); return 1; }

  var page0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var page1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);

  PdfSetFont(doc, page0, PDF_FONT_HELVETICA, 14.0);
  PdfTextAt(doc, page0, 72.0, 750.0, "Mixed annotations: links + notes");
  PdfSetFont(doc, page0, PDF_FONT_HELVETICA, 11.0);
  PdfTextAt(doc, page0, 72.0, 720.0, "External: https://example.org");
  PdfTextAt(doc, page0, 72.0, 700.0, "Internal: jump to page 2");
  PdfTextAt(doc, page0, 72.0, 680.0, "Note marker nearby");

  PdfSetFont(doc, page1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page1, 72.0, 750.0, "Page 2 destination");

  var ai0: int64 := PdfAddLink(doc, page0, 72.0, 712.0, 260.0, 728.0);
  PdfLinkSetURI(doc, ai0, "https://example.org");

  var ai1: int64 := PdfAddLinkGoto(doc, page0, 72.0, 692.0, 240.0, 708.0);
  PdfLinkSetGoto(doc, ai1, page1);

  PdfAddNote(doc, page0, 290.0, 672.0, "Author", "Remember to update this section.");

  PdfSetCompression(doc, 1);
  var err: int64 := PdfSave(doc, "/tmp/pdf_annot_mixed.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (mixed)\n"); return 1; }
  PrintStr("OK: mixed annotation PDF saved to /tmp/pdf_annot_mixed.pdf\n");
  return 0;
}

