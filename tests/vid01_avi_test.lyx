// tests/vid01_avi_test.lyx — VID-01: AVI Reader Tests
//
// Builds a minimal AVI (236 bytes):
//   RIFF[228] AVI
//     LIST[192] hdrl
//       avih[56]: w=320, h=240, totalFrames=30, µs/frame=33333
//       LIST[116] strl
//         strh[56]: vids/MJPG, scale=1001, rate=30000
//         strf[40]: BITMAPINFOHEADER (not parsed)
//     LIST[16] movi
//       00dc[4]: dummy data

unit tests.vid01_avi_test;

import std.video.core;
import std.video.avi;
import std.image.core;
import std.alloc;
import std.io;

fn put32LE(buf: int64, off: int64, val: int64): void {
    poke8(buf+off,   val & 255);
    poke8(buf+off+1, (val >>  8) & 255);
    poke8(buf+off+2, (val >> 16) & 255);
    poke8(buf+off+3, (val >> 24) & 255);
}

fn put4cc(buf: int64, off: int64, a: int64, b: int64, c: int64, d: int64): void {
    poke8(buf+off, a); poke8(buf+off+1, b); poke8(buf+off+2, c); poke8(buf+off+3, d);
}

fn makeTestAvi(buf: int64): int64 {
    // Zero out
    var i: int64 := 0;
    while (i < 256) { poke8(buf+i, 0); i := i+1; }

    // ---- Sizes (precomputed) ----
    // avih chunk   = 8+56 = 64
    // strh chunk   = 8+56 = 64
    // strf chunk   = 8+40 = 48
    // strl content = 4+64+48 = 116  → strl LIST = 8+116 = 124
    // hdrl content = 4+64+124 = 192 → hdrl LIST = 8+192 = 200
    // 00dc chunk   = 8+4 = 12
    // movi content = 4+12 = 16      → movi LIST = 8+16  = 24
    // RIFF content = 4+200+24 = 228 → total = 8+228 = 236

    // RIFF header at [0]
    put4cc(buf,  0, 0x52, 0x49, 0x46, 0x46);  // 'RIFF'
    put32LE(buf, 4, 228);                       // file size - 8
    put4cc(buf,  8, 0x41, 0x56, 0x49, 0x20);  // 'AVI '

    // LIST hdrl at [12], size=192
    put4cc(buf, 12, 0x4C, 0x49, 0x53, 0x54);  // 'LIST'
    put32LE(buf, 16, 192);
    put4cc(buf, 20, 0x68, 0x64, 0x72, 0x6C);  // 'hdrl'

    // avih chunk at [24], data at [32]
    put4cc(buf, 24, 0x61, 0x76, 0x69, 0x68);  // 'avih'
    put32LE(buf, 28, 56);
    put32LE(buf, 32, 33333);   // dwMicroSecPerFrame
    put32LE(buf, 36, 0);       // dwMaxBytesPerSec
    put32LE(buf, 40, 0);       // dwPaddingGranularity
    put32LE(buf, 44, 0);       // dwFlags
    put32LE(buf, 48, 30);      // dwTotalFrames
    put32LE(buf, 52, 0);       // dwInitialFrames
    put32LE(buf, 56, 1);       // dwStreams
    put32LE(buf, 60, 0);       // dwSuggestedBufferSize
    put32LE(buf, 64, 320);     // dwWidth
    put32LE(buf, 68, 240);     // dwHeight
    // reserved 16 bytes at [72..87] = zeros

    // LIST strl at [88], size=116
    put4cc(buf, 88, 0x4C, 0x49, 0x53, 0x54);  // 'LIST'
    put32LE(buf, 92, 116);
    put4cc(buf, 96, 0x73, 0x74, 0x72, 0x6C);  // 'strl'

    // strh chunk at [100], data at [108]
    put4cc(buf, 100, 0x73, 0x74, 0x72, 0x68);  // 'strh'
    put32LE(buf, 104, 56);
    put4cc(buf, 108, 0x76, 0x69, 0x64, 0x73);  // fccType = 'vids'
    put4cc(buf, 112, 0x4D, 0x4A, 0x50, 0x47);  // fccHandler = 'MJPG'
    put32LE(buf, 116, 0);       // dwFlags
    // wPriority(2) + wLanguage(2) at [120..123] = zeros
    put32LE(buf, 124, 0);       // dwInitialFrames
    put32LE(buf, 128, 1001);    // dwScale
    put32LE(buf, 132, 30000);   // dwRate
    put32LE(buf, 136, 0);       // dwStart
    put32LE(buf, 140, 30);      // dwLength (frame count)
    // remaining 16 bytes at [144..163] = zeros

    // strf chunk at [164], data at [172] (BITMAPINFOHEADER, 40 bytes)
    put4cc(buf, 164, 0x73, 0x74, 0x72, 0x66);  // 'strf'
    put32LE(buf, 168, 40);
    put32LE(buf, 172, 40);     // biSize
    put32LE(buf, 176, 320);    // biWidth
    put32LE(buf, 180, 240);    // biHeight
    poke8(buf+184, 1); poke8(buf+185, 0);   // biPlanes=1
    poke8(buf+186, 24); poke8(buf+187, 0);  // biBitCount=24
    put4cc(buf, 188, 0x4D, 0x4A, 0x50, 0x47); // biCompression='MJPG'
    // rest zeros

    // LIST movi at [212], size=16
    put4cc(buf, 212, 0x4C, 0x49, 0x53, 0x54);  // 'LIST'
    put32LE(buf, 216, 16);
    put4cc(buf, 220, 0x6D, 0x6F, 0x76, 0x69);  // 'movi'

    // 00dc chunk at [224], data at [232] (4 bytes dummy)
    put4cc(buf, 224, 0x30, 0x30, 0x64, 0x63);  // '00dc'
    put32LE(buf, 228, 4);
    poke8(buf+232, 0xFF); poke8(buf+233, 0xD8); poke8(buf+234, 0x00); poke8(buf+235, 0x00);

    return 236;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;
    var buf: int64 := alloc(256);
    var len: int64 := makeTestAvi(buf);

    // -------------------------------------------------------------------------
    // Test 1: AviMeta — basic metadata
    // -------------------------------------------------------------------------
    var vid: int64 := alloc(VID_SIZE);
    var ret: int64 := AviMeta(buf, len, vid);
    if (ret != 1) {
        PrintLn("FAIL: AviMeta returned 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: AviMeta ret=1"c);

        var w: int64 := peek64(vid + VID_OFF_WIDTH);
        var h: int64 := peek64(vid + VID_OFF_HEIGHT);
        if (w != 320) { PrintLn("FAIL: AviMeta width != 320"c); ok := 0; }
        else           { PrintLn("PASS: AviMeta width=320"c); }
        if (h != 240) { PrintLn("FAIL: AviMeta height != 240"c); ok := 0; }
        else           { PrintLn("PASS: AviMeta height=240"c); }

        var fc: int64 := peek64(vid + VID_OFF_FRAME_COUNT);
        if (fc != 30) { PrintLn("FAIL: AviMeta frameCount != 30"c); ok := 0; }
        else           { PrintLn("PASS: AviMeta frameCount=30"c); }

        var fpsn: int64 := peek64(vid + VID_OFF_FPS_NUM);
        var fpsd: int64 := peek64(vid + VID_OFF_FPS_DEN);
        if (fpsn != 30000 || fpsd != 1001) {
            PrintLn("FAIL: AviMeta fps wrong"c); ok := 0;
        } else {
            PrintLn("PASS: AviMeta fps=30000/1001"c);
        }

        var codec: int64 := peek64(vid + VID_OFF_CODEC);
        if (codec != VID_CODEC_MJPEG) {
            PrintLn("FAIL: AviMeta codec != MJPEG"c); ok := 0;
        } else {
            PrintLn("PASS: AviMeta codec=MJPEG"c);
        }

        var fmt: int64 := peek64(vid + VID_OFF_FORMAT);
        if (fmt != VID_FMT_AVI) {
            PrintLn("FAIL: AviMeta format != AVI"c); ok := 0;
        } else {
            PrintLn("PASS: AviMeta format=AVI"c);
        }

        var dur: int64 := peek64(vid + VID_OFF_DURATION_MS);
        if (dur < 900 || dur > 1100) {
            PrintLn("FAIL: AviMeta duration out of range"c); ok := 0;
        } else {
            PrintLn("PASS: AviMeta duration ~1s"c);
        }
    }
    free(vid, VID_SIZE);

    // -------------------------------------------------------------------------
    // Test 2: AviGetFrameCount — 1 '00dc' chunk in movi
    // -------------------------------------------------------------------------
    var fc2: int64 := AviGetFrameCount(buf, len);
    if (fc2 != 1) {
        PrintLn("FAIL: AviGetFrameCount != 1"c); ok := 0;
    } else {
        PrintLn("PASS: AviGetFrameCount=1"c);
    }

    // -------------------------------------------------------------------------
    // Test 3: AviGetFrameOffset — frame 0 exists, dummy JPEG marker check
    // -------------------------------------------------------------------------
    var flen3: int64 := alloc(8);
    poke64(flen3, 0);
    var fptr: int64 := AviGetFrameOffset(buf, len, 0, flen3);
    var flen3v: int64 := peek64(flen3);
    free(flen3, 8);
    if (fptr == 0) {
        PrintLn("FAIL: AviGetFrameOffset returned 0"c); ok := 0;
    } else {
        PrintLn("PASS: AviGetFrameOffset ret != 0"c);
        if (flen3v != 4) {
            PrintLn("FAIL: frame length != 4"c); ok := 0;
        } else {
            PrintLn("PASS: frame length=4"c);
        }
        // First byte should be 0xFF (fake JPEG SOI start)
        if (peek8(fptr) != 0xFF) {
            PrintLn("FAIL: frame data[0] != 0xFF"c); ok := 0;
        } else {
            PrintLn("PASS: frame data[0]=0xFF"c);
        }
    }

    // -------------------------------------------------------------------------
    // Test 4: AviExtractMjpegFrame — invalid JPEG data → 0 (no crash)
    // -------------------------------------------------------------------------
    var img4: int64 := alloc(GRF_SIZE);
    var ret4: int64 := AviExtractMjpegFrame(buf, len, 0, img4);
    if (ret4 != 0) {
        PrintLn("FAIL: AviExtractMjpegFrame invalid JPEG should return 0"c); ok := 0;
    } else {
        PrintLn("PASS: AviExtractMjpegFrame invalid JPEG → 0"c);
    }
    free(img4, GRF_SIZE);

    // -------------------------------------------------------------------------
    // Test 5: AviGetFrameOffset — frame 1 not found → 0
    // -------------------------------------------------------------------------
    var fptr5: int64 := AviGetFrameOffset(buf, len, 1, 0);
    if (fptr5 != 0) {
        PrintLn("FAIL: AviGetFrameOffset frame 1 should return 0"c); ok := 0;
    } else {
        PrintLn("PASS: AviGetFrameOffset frame 1 → 0 (only 1 frame)"c);
    }

    // -------------------------------------------------------------------------
    // Test 6: AviMeta — bad signature → 0
    // -------------------------------------------------------------------------
    var badBuf: int64 := alloc(16);
    poke8(badBuf, 0); poke8(badBuf+1, 0); poke8(badBuf+2, 0); poke8(badBuf+3, 0);
    poke8(badBuf+4, 0); poke8(badBuf+5, 0); poke8(badBuf+6, 0); poke8(badBuf+7, 0);
    poke8(badBuf+8, 0); poke8(badBuf+9, 0); poke8(badBuf+10, 0); poke8(badBuf+11, 0);
    var vidBad: int64 := alloc(VID_SIZE);
    var retBad: int64 := AviMeta(badBuf, 16, vidBad);
    if (retBad != 0) {
        PrintLn("FAIL: AviMeta bad sig should return 0"c); ok := 0;
    } else {
        PrintLn("PASS: AviMeta bad sig → 0"c);
    }
    free(vidBad, VID_SIZE);
    free(badBuf, 16);

    free(buf, 256);

    if (ok != 0) {
        PrintLn("=== VID-01: ALL PASS ==="c);
    } else {
        PrintLn("=== VID-01: SOME FAIL ==="c);
    }
    return ok;
}
