// tests/fft_test.lyx
// Selbstpruefende Testbatterie fuer std.fft.
//
// Sollwerte aus Python (cmath, direkte Summenformel) — also aus der Definition
// der DFT, nicht aus einem FFT-Verfahren. Zusaetzlich pruefen strukturelle
// Saetze (Parseval, Verschiebung, Linearitaet), die unabhaengig von jedem
// Zahlenwert gelten muessen.

unit main;

import std.fft;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn TOL(): f64 { return 0.000000001; }   // 1e-9

fn Check(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > tol) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" (bool)\n"c);
  }
}

fn G(p: int64, i: int64): f64 {
  var v: f64 := peekf64(p + i * 8);
  return v;
}

fn P(p: int64, i: int64, v: f64): void {
  pokef64(p + i * 8, v);
}

fn Zero(p: int64, n: int64): void {
  var i: int64 := 0;
  while (i < n) { P(p, i, 0.0); i := i + 1; }
}

// Testsignal, 8 Werte
fn Sig8(p: int64): void {
  P(p, 0, 0.3);   P(p, 1, 1.2);   P(p, 2, -0.7);  P(p, 3, 2.5);
  P(p, 4, 0.0);   P(p, 5, -1.8);  P(p, 6, 0.9);   P(p, 7, 1.1);
}

fn main(): int64 {
  // ── Groessenhilfen ────────────────────────────────────────────────────────
  CheckB("pow2_1"c,   FftIsPowerOfTwo(1),  true);
  CheckB("pow2_1024"c, FftIsPowerOfTwo(1024), true);
  CheckB("pow2_6"c,   FftIsPowerOfTwo(6),  false);
  CheckB("pow2_0"c,   FftIsPowerOfTwo(0),  false);
  CheckI("next1"c,    FftNextPowerOfTwo(1),  1);
  CheckI("next5"c,    FftNextPowerOfTwo(5),  8);
  CheckI("next1024"c, FftNextPowerOfTwo(1024), 1024);
  CheckI("next1025"c, FftNextPowerOfTwo(1025), 2048);

  var n: int64 := 8;
  var re: int64 := alloc(n * 8);
  var im: int64 := alloc(n * 8);

  // ── Grundfaelle mit bekanntem Spektrum ────────────────────────────────────
  // Impuls: flaches Spektrum, ueberall 1
  Zero(re, n);  Zero(im, n);
  P(re, 0, 1.0);
  CheckB("fwdOk"c, FftForward(re, im, n), true);
  var i: int64 := 0;
  var flat: bool := true;
  while (i < n) {
    if (AbsF64(G(re, i) - 1.0) > TOL()) { flat := false; }
    if (AbsF64(G(im, i)) > TOL()) { flat := false; }
    i := i + 1;
  }
  CheckB("impulsFlat"c, flat, true);

  // Konstante: alles in Bin 0
  Zero(im, n);
  i := 0;
  while (i < n) { P(re, i, 1.0); i := i + 1; }
  FftForward(re, im, n);
  Check("constX0"c, G(re, 0), 8.0, TOL());
  Check("constX1"c, G(re, 1), 0.0, TOL());
  Check("constX4"c, G(re, 4), 0.0, TOL());

  // cos(2*pi*2j/8): Bins 2 und 6, je n/2
  Zero(im, n);
  i := 0;
  while (i < n) {
    P(re, i, CosF64(6.283185307179586 * 2.0 * (i as f64) / 8.0));
    i := i + 1;
  }
  FftForward(re, im, n);
  Check("cosX2"c, G(re, 2), 4.0, 0.00000001);
  Check("cosX6"c, G(re, 6), 4.0, 0.00000001);
  Check("cosX1"c, G(re, 1), 0.0, 0.00000001);
  Check("cosX2i"c, G(im, 2), 0.0, 0.00000001);

  // sin: rein imaginaer, antisymmetrisch
  Zero(im, n);
  i := 0;
  while (i < n) {
    P(re, i, SinF64(6.283185307179586 * 2.0 * (i as f64) / 8.0));
    i := i + 1;
  }
  FftForward(re, im, n);
  Check("sinX2re"c, G(re, 2), 0.0, 0.00000001);
  Check("sinX2im"c, G(im, 2), -4.0, 0.00000001);
  Check("sinX6im"c, G(im, 6), 4.0, 0.00000001);

  // ── Vergleich mit der Definition (Python-Sollwerte) ───────────────────────
  Sig8(re);  Zero(im, n);
  FftForward(re, im, n);
  Check("sigX0re"c, G(re, 0), 3.5, TOL());
  Check("sigX0im"c, G(im, 0), 0.0, TOL());
  Check("sigX1re"c, G(re, 1), 1.4313708498984763, TOL());
  Check("sigX1im"c, G(im, 1), -1.511269837220809, TOL());
  Check("sigX3re"c, G(re, 3), -0.8313708498984732, TOL());
  Check("sigX3im"c, G(im, 3), -4.711269837220811, TOL());
  Check("sigX4re"c, G(re, 4), -2.5, TOL());
  Check("sigX4im"c, G(im, 4), 0.0, TOL());

  // Parseval: Energie bleibt erhalten (sum|x|^2 = sum|X|^2 / n)
  var energyF: f64 := 0.0;
  i := 0;
  while (i < n) {
    energyF := energyF + G(re, i) * G(re, i) + G(im, i) * G(im, i);
    i := i + 1;
  }
  Check("parseval"c, energyF / 8.0, 13.53, 0.0000001);

  // ── FFT gegen direkte DFT ─────────────────────────────────────────────────
  var dre: int64 := alloc(n * 8);
  var ddi: int64 := alloc(n * 8);
  Sig8(re);  Zero(im, n);
  Sig8(dre); Zero(ddi, n);
  FftForward(re, im, n);
  CheckB("dftOk"c, FftDft(dre, ddi, n, -1), true);
  var same: bool := true;
  i := 0;
  while (i < n) {
    if (AbsF64(G(re, i) - G(dre, i)) > TOL()) { same := false; }
    if (AbsF64(G(im, i) - G(ddi, i)) > TOL()) { same := false; }
    i := i + 1;
  }
  CheckB("fftEqDft"c, same, true);

  // ── Hin und zurueck ───────────────────────────────────────────────────────
  Sig8(re);  Zero(im, n);
  FftForward(re, im, n);
  CheckB("invOk"c, FftInverse(re, im, n), true);
  Check("round0"c, G(re, 0), 0.3,  TOL());
  Check("round3"c, G(re, 3), 2.5,  TOL());
  Check("round5"c, G(re, 5), -1.8, TOL());
  Check("round5i"c, G(im, 5), 0.0, TOL());

  // Sonderfaelle n = 1 und n = 2
  var s1: int64 := alloc(8);
  var s1i: int64 := alloc(8);
  P(s1, 0, 7.0);  P(s1i, 0, 0.0);
  CheckB("n1"c, FftForward(s1, s1i, 1), true);
  Check("n1val"c, G(s1, 0), 7.0, TOL());
  FftInverse(s1, s1i, 1);
  Check("n1inv"c, G(s1, 0), 7.0, TOL());
  free(s1, 8);  free(s1i, 8);

  var s2: int64 := alloc(16);
  var s2i: int64 := alloc(16);
  P(s2, 0, 1.0);  P(s2, 1, 3.0);  P(s2i, 0, 0.0);  P(s2i, 1, 0.0);
  FftForward(s2, s2i, 2);
  Check("n2X0"c, G(s2, 0), 4.0,  TOL());
  Check("n2X1"c, G(s2, 1), -2.0, TOL());
  free(s2, 16);  free(s2i, 16);

  // Ungueltige Eingaben
  CheckB("fwdN0"c, FftForward(re, im, 0), false);
  CheckB("radix2On6"c, FftRadix2(re, im, 6, -1), false);

  // ── Bluestein: beliebige Laengen gegen die DFT ────────────────────────────
  var m: int64 := 5;
  var br: int64 := alloc(m * 8);  var bi: int64 := alloc(m * 8);
  var xr: int64 := alloc(m * 8);  var xi: int64 := alloc(m * 8);
  P(br, 0, 1.0);  P(br, 1, -2.0); P(br, 2, 3.0);  P(br, 3, 0.5);  P(br, 4, 4.0);
  Zero(bi, m);
  i := 0;
  while (i < m) { P(xr, i, G(br, i)); P(xi, i, 0.0); i := i + 1; }

  CheckB("blueOk"c, FftForward(br, bi, m), true);
  FftDft(xr, xi, m, -1);
  Check("blue5_1re"c, G(br, 1), -1.2135254915624216, 0.00000001);
  Check("blue5_1im"c, G(bi, 1),  4.2368759670397385, 0.00000001);
  Check("blue5_2re"c, G(br, 2),  0.4635254915624194, 0.00000001);
  Check("blue5_2im"c, G(bi, 2),  5.9043528044927225, 0.00000001);
  var eqDft: bool := true;
  i := 0;
  while (i < m) {
    if (AbsF64(G(br, i) - G(xr, i)) > 0.00000001) { eqDft := false; }
    if (AbsF64(G(bi, i) - G(xi, i)) > 0.00000001) { eqDft := false; }
    i := i + 1;
  }
  CheckB("blueEqDft"c, eqDft, true);

  // Rundgang bei ungerader Laenge
  FftInverse(br, bi, m);
  Check("blueRound0"c, G(br, 0), 1.0,  0.00000001);
  Check("blueRound2"c, G(br, 2), 3.0,  0.00000001);
  Check("blueRound4"c, G(br, 4), 4.0,  0.00000001);
  Check("blueRound4i"c, G(bi, 4), 0.0, 0.00000001);
  free(br, m * 8);  free(bi, m * 8);
  free(xr, m * 8);  free(xi, m * 8);

  // mehrere krumme Laengen: Rundgang muss ueberall zurueckfuehren
  var lens: int64 := alloc(5 * 8);
  poke64(lens, 3);  poke64(lens + 8, 6);  poke64(lens + 16, 9);
  poke64(lens + 24, 12);  poke64(lens + 32, 100);
  var li: int64 := 0;
  var allBack: bool := true;
  while (li < 5) {
    var ln: int64 := peek64(lens + li * 8);
    var ar: int64 := alloc(ln * 8);
    var ai: int64 := alloc(ln * 8);
    var k: int64 := 0;
    while (k < ln) {
      P(ar, k, (k as f64) * 0.75 - 2.0);
      P(ai, k, 0.0);
      k := k + 1;
    }
    FftForward(ar, ai, ln);
    FftInverse(ar, ai, ln);
    k := 0;
    while (k < ln) {
      if (AbsF64(G(ar, k) - ((k as f64) * 0.75 - 2.0)) > 0.0000001) { allBack := false; }
      if (AbsF64(G(ai, k)) > 0.0000001) { allBack := false; }
      k := k + 1;
    }
    free(ar, ln * 8);
    free(ai, ln * 8);
    li := li + 1;
  }
  CheckB("oddRoundtrips"c, allBack, true);
  free(lens, 5 * 8);

  // ── Grosse Laenge: Rundgang und Genauigkeit ───────────────────────────────
  var big: int64 := 1024;
  var gr: int64 := alloc(big * 8);
  var gi: int64 := alloc(big * 8);
  i := 0;
  while (i < big) {
    P(gr, i, SinF64(6.283185307179586 * 5.0 * (i as f64) / (big as f64))
             + 0.5 * CosF64(6.283185307179586 * 17.0 * (i as f64) / (big as f64)));
    P(gi, i, 0.0);
    i := i + 1;
  }
  // Spitze liegt bei Bin 5 (Amplitude 1) — nicht bei 17 (Amplitude 0.5)
  var cr: int64 := alloc(big * 8);
  var ci: int64 := alloc(big * 8);
  i := 0;
  while (i < big) { P(cr, i, G(gr, i)); P(ci, i, 0.0); i := i + 1; }
  FftForward(cr, ci, big);
  CheckI("peakBin"c, FftPeakBin(cr, ci, big), 5);
  // Amplitude: |X[5]| = n/2 * 1.0, |X[17]| = n/2 * 0.5
  var mag: int64 := alloc(big * 8);
  CheckB("magOk"c, FftMagnitude(cr, ci, big, mag), true);
  Check("mag5"c,  G(mag, 5),  512.0, 0.00001);
  Check("mag17"c, G(mag, 17), 256.0, 0.00001);
  Check("mag6"c,  G(mag, 6),  0.0,   0.00001);

  // Leistung ist das Betragsquadrat
  var pw: int64 := alloc(big * 8);
  FftPower(cr, ci, big, pw);
  Check("power5"c, G(pw, 5), 512.0 * 512.0, 0.1);

  // Phase liegt in -pi..pi
  var ph: int64 := alloc(big * 8);
  FftPhase(cr, ci, big, ph);
  var phOk: bool := true;
  i := 0;
  while (i < big) {
    if (AbsF64(G(ph, i)) > 3.1415926536) { phOk := false; }
    i := i + 1;
  }
  CheckB("phaseRange"c, phOk, true);

  // Rundgang bei n = 1024
  FftInverse(cr, ci, big);
  var maxErr: f64 := 0.0;
  i := 0;
  while (i < big) {
    var e: f64 := AbsF64(G(cr, i) - G(gr, i));
    if (e > maxErr) { maxErr := e; }
    i := i + 1;
  }
  Check("bigRoundErr"c, maxErr, 0.0, 0.0000001);

  free(mag, big * 8);  free(pw, big * 8);  free(ph, big * 8);
  free(cr, big * 8);   free(ci, big * 8);
  free(gr, big * 8);   free(gi, big * 8);

  // ── Reelle Eingabe, Frequenzachse ─────────────────────────────────────────
  var sig: int64 := alloc(n * 8);
  Sig8(sig);
  var rr: int64 := alloc(n * 8);
  var ri: int64 := alloc(n * 8);
  CheckB("realOk"c, FftForwardReal(sig, n, rr, ri), true);
  Check("realX1re"c, G(rr, 1), 1.4313708498984763, TOL());
  Check("realX1im"c, G(ri, 1), -1.511269837220809, TOL());
  // Quelle bleibt unangetastet
  Check("realSrc"c, G(sig, 1), 1.2, TOL());
  // konjugierte Symmetrie einer reellen Eingabe: X[n-k] = conj(X[k])
  Check("conjSymRe"c, G(rr, 7), G(rr, 1), TOL());
  Check("conjSymIm"c, G(ri, 7), 0.0 - G(ri, 1), TOL());
  CheckB("realNullOut"c, FftForwardReal(sig, n, 0, ri), false);

  Check("freq0"c,    FftBinFrequency(0, 8, 8000.0), 0.0,     TOL());
  Check("freq1"c,    FftBinFrequency(1, 8, 8000.0), 1000.0,  TOL());
  Check("freqNyq"c,  FftBinFrequency(4, 8, 8000.0), 4000.0,  TOL());
  // oberhalb der Nyquist-Grenze zaehlen die Stuetzstellen negativ
  Check("freqNeg"c,  FftBinFrequency(5, 8, 8000.0), -3000.0, TOL());
  Check("freqLast"c, FftBinFrequency(7, 8, 8000.0), -1000.0, TOL());

  free(sig, n * 8);  free(rr, n * 8);  free(ri, n * 8);

  // ── Faltung ───────────────────────────────────────────────────────────────
  var av: int64 := alloc(3 * 8);
  var bv: int64 := alloc(4 * 8);
  P(av, 0, 1.0);  P(av, 1, 2.0);  P(av, 2, 3.0);
  P(bv, 0, 0.5);  P(bv, 1, -1.0); P(bv, 2, 2.0);  P(bv, 3, 1.0);
  var out: int64 := alloc(6 * 8);
  CheckB("convOk"c, FftConvolveReal(av, 3, bv, 4, out), true);
  // von Hand: [0.5, 0, 1.5, 2, 8, 3]
  Check("conv0"c, G(out, 0), 0.5, 0.0000001);
  Check("conv1"c, G(out, 1), 0.0, 0.0000001);
  Check("conv2"c, G(out, 2), 1.5, 0.0000001);
  Check("conv3"c, G(out, 3), 2.0, 0.0000001);
  Check("conv4"c, G(out, 4), 8.0, 0.0000001);
  Check("conv5"c, G(out, 5), 3.0, 0.0000001);
  CheckB("convBadN"c, FftConvolveReal(av, 0, bv, 4, out), false);
  CheckB("convNullOut"c, FftConvolveReal(av, 3, bv, 4, 0), false);

  // Faltung mit dem Einheitsimpuls gibt das Signal zurueck
  var dl: int64 := alloc(8);
  P(dl, 0, 1.0);
  var out2: int64 := alloc(3 * 8);
  FftConvolveReal(av, 3, dl, 1, out2);
  Check("convDelta0"c, G(out2, 0), 1.0, 0.0000001);
  Check("convDelta2"c, G(out2, 2), 3.0, 0.0000001);
  free(dl, 8);  free(out2, 3 * 8);
  free(av, 3 * 8);  free(bv, 4 * 8);  free(out, 6 * 8);

  // Zyklische Faltung: gegen die direkte Summe
  var pr: int64 := alloc(4 * 8);  var pmi: int64 := alloc(4 * 8);
  var qr: int64 := alloc(4 * 8);  var qmi: int64 := alloc(4 * 8);
  P(pr, 0, 1.0);  P(pr, 1, 2.0);  P(pr, 2, 0.0);  P(pr, 3, -1.0);  Zero(pmi, 4);
  P(qr, 0, 0.0);  P(qr, 1, 1.0);  P(qr, 2, 1.0);  P(qr, 3, 0.0);   Zero(qmi, 4);
  CheckB("circOk"c, FftConvolveCircular(pr, pmi, qr, qmi, 4), true);
  // c[k] = sum_j p[j]*q[(k-j) mod 4] -> [-1, 0, 3, 2]
  Check("circ0"c, G(pr, 0), -1.0, 0.0000001);
  Check("circ1"c, G(pr, 1),  0.0, 0.0000001);
  Check("circ2"c, G(pr, 2),  3.0, 0.0000001);
  Check("circ3"c, G(pr, 3),  2.0, 0.0000001);
  free(pr, 4 * 8);  free(pmi, 4 * 8);  free(qr, 4 * 8);  free(qmi, 4 * 8);

  // ── Korrelation ───────────────────────────────────────────────────────────
  var ca: int64 := alloc(n * 8);
  var cb: int64 := alloc(n * 8);
  var cro: int64 := alloc(n * 8);
  Sig8(ca);  Sig8(cb);
  CheckB("corrOk"c, FftCorrelateReal(ca, cb, n, cro), true);
  // Autokorrelation bei Verschiebung 0 ist die Energie
  Check("autocorr0"c, G(cro, 0), 13.53, 0.0000001);
  Check("autocorr1"c, G(cro, 1), -2.53, 0.0000001);
  // und sie ist bei 0 maximal
  var isMax: bool := true;
  i := 1;
  while (i < n) {
    if (G(cro, i) > G(cro, 0)) { isMax := false; }
    i := i + 1;
  }
  CheckB("autocorrMax"c, isMax, true);
  free(ca, n * 8);  free(cb, n * 8);  free(cro, n * 8);

  // ── Fensterfunktionen ─────────────────────────────────────────────────────
  var w: int64 := alloc(n * 8);
  CheckB("hannOk"c, FftWindowHann(w, n), true);
  Check("hann0"c,  G(w, 0), 0.0, TOL());
  Check("hann7"c,  G(w, 7), 0.0, TOL());
  Check("hann1"c,  G(w, 1), 0.1882550990706332, 0.0000001);
  Check("hann3"c,  G(w, 3), 0.9504844339512095, 0.0000001);
  // symmetrisch
  Check("hannSym"c, G(w, 2), G(w, 5), 0.0000001);
  Check("hannGain"c, FftWindowGain(w, n), 0.4375, 0.0000001);

  CheckB("hammingOk"c, FftWindowHamming(w, n), true);
  Check("hamming0"c,   G(w, 0), 0.08, 0.0000001);
  Check("hammingGain"c, FftWindowGain(w, n), 0.4825, 0.0000001);

  CheckB("blackmanOk"c, FftWindowBlackman(w, n), true);
  Check("blackman0"c,   G(w, 0), 0.0, 0.0000001);
  Check("blackmanMid"c, G(w, 4), 0.9203636180999083, 0.0000001);
  Check("blackmanGain"c, FftWindowGain(w, n), 0.3675, 0.0000001);

  CheckB("winN1"c, FftWindowHann(w, 1), true);
  Check("winN1val"c, G(w, 0), 1.0, TOL());
  CheckB("winNull"c, FftWindowHann(0, n), false);

  // Fenster anwenden
  var ws: int64 := alloc(n * 8);
  Sig8(ws);
  FftWindowHann(w, n);
  CheckB("applyOk"c, FftApplyWindow(ws, w, n), true);
  Check("applied0"c, G(ws, 0), 0.0, TOL());              // Rand ausgeblendet
  Check("applied3"c, G(ws, 3), 2.5 * 0.9504844339512095, 0.0000001);
  free(ws, n * 8);  free(w, n * 8);

  free(re, n * 8);   free(im, n * 8);
  free(dre, n * 8);  free(ddi, n * 8);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
