// tests/generics_monomorph_test.lyx
// #1014/#1053: Der Test nutzte durchgehend die ECKIGE Form — `fn max[T](...)`
// in der Deklaration und `max[int64](...)` am Aufrufort. Beides kennt der
// Compiler nicht; geschrieben wird spitz: `fn max<T>(...)` und `max<int64>(...)`.
// ebnf.md fuehrte den eckigen Aufruf faelschlich als GenericCallSuffix und ist
// mit #1053 richtiggestellt.
//
// Der Test bleibt rot, jetzt aber nur noch wegen #1009 (sema meldet fuer den
// Typparameter "unknown param type"). Gefuehrt in tests/suite-broken.txt.
// WP-2.1: Generics Monomorphisierung
//
// Tests: separate IR-Funktionen für verschiedene Typen,
//        korrekte Ergebnisse, Mehrfach-Instantiierung, verschachtelte Generics.

@description("WP-2.1: Generics monomorphization tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.generics_monomorph_test;

// --- Generic max function ---
fn max<T>(a: T, b: T): T {
  if (a > b) { return a; }
  return b;
}

// --- Generic min function ---
fn min<T>(a: T, b: T): T {
  if (a < b) { return a; }
  return b;
}

// --- Generic identity ---
fn id<T>(x: T): T {
  return x;
}

// --- Generic swap (via two calls) ---
fn clamp<T>(val: T, lo: T, hi: T): T {
  if (val < lo) { return lo; }
  if (val > hi) { return hi; }
  return val;
}

// --- 1. max[int64] ---
fn testMaxInt64(): int64 {
  var r: int64 := max<int64>(10, 20);
  if (r != 20) { PrintLn("FAIL: max<int64>(10,20) expected 20"); return 1; }
  var s: int64 := max<int64>(42, 7);
  if (s != 42) { PrintLn("FAIL: max<int64>(42,7) expected 42"); return 1; }
  PrintLn("OK: max[int64]");
  return 0;
}

// --- 2. min[int64] ---
fn testMinInt64(): int64 {
  var r: int64 := min<int64>(3, 9);
  if (r != 3) { PrintLn("FAIL: min<int64>(3,9) expected 3"); return 1; }
  var s: int64 := min<int64>(100, 1);
  if (s != 1) { PrintLn("FAIL: min<int64>(100,1) expected 1"); return 1; }
  PrintLn("OK: min[int64]");
  return 0;
}

// --- 3. id[int64] ---
fn testIdInt64(): int64 {
  var r: int64 := id<int64>(42);
  if (r != 42) { PrintLn("FAIL: id<int64>(42)"); return 1; }
  PrintLn("OK: id[int64]");
  return 0;
}

// --- 4. id[pchar] (different type → different specialization) ---
fn testIdPchar(): int64 {
  var s: pchar := id<pchar>("hello"c);
  if (s == 0) { PrintLn("FAIL: id[pchar] returned null"); return 1; }
  PrintLn("OK: id[pchar]");
  return 0;
}

// --- 5. clamp[int64] ---
fn testClampInt64(): int64 {
  var r1: int64 := clamp<int64>(5, 0, 10);   // in range → 5
  var r2: int64 := clamp<int64>(-3, 0, 10);  // below → 0
  var r3: int64 := clamp<int64>(15, 0, 10);  // above → 10
  if (r1 != 5 || r2 != 0 || r3 != 10) {
    PrintLn("FAIL: clamp[int64]"); return 1;
  }
  PrintLn("OK: clamp[int64]");
  return 0;
}

// --- 6. Multiple instantiations of same generic (cache dedup test) ---
fn testMultipleInstantiations(): int64 {
  // Same type, multiple calls — should reuse max__int64
  var a: int64 := max<int64>(1, 2);
  var b: int64 := max<int64>(10, 3);
  var c: int64 := max<int64>(100, 200);
  if (a != 2 || b != 10 || c != 200) {
    PrintLn("FAIL: multiple max[int64] calls"); return 1;
  }
  PrintLn("OK: multiple instantiations reuse same specialization");
  return 0;
}

pub fn main(): int64 {
  if (testMaxInt64()               != 0) { return 1; }
  if (testMinInt64()               != 0) { return 1; }
  if (testIdInt64()                != 0) { return 1; }
  if (testIdPchar()                != 0) { return 1; }
  if (testClampInt64()             != 0) { return 1; }
  if (testMultipleInstantiations() != 0) { return 1; }
  PrintLn("All WP-2.1 generics monomorphization tests passed.");
  return 0;
}
