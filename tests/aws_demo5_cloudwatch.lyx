// tests/aws_demo5_cloudwatch.lyx — AWS SDK Demo: CloudWatch metrics + logs
// WP-AWS-15

unit tests.aws_demo5_cloudwatch;

import std.cloud.aws.core;
import std.cloud.cloudwatch;
import std.alloc;
import std.io;

pub fn main(argc: int64, argv: int64): int64 {
    PrintLn("=== AWS CloudWatch Demo ==="c);

    var creds: AWSCreds := AWSCredentialsDefault();
    if (creds.accessKey == 0) {
        PrintLn("Error: no credentials found."c);
        return 1;
    }

    var region: pchar := "eu-central-1"c;
    if (creds.region != 0) { region := creds.region as pchar; }

    // ── Metrics ───────────────────────────────────────────────────────────────

    var cwClient: CWClient := CWConnect(creds, region);

    // List EC2 metrics
    PrintLn("--- List EC2 Metrics ---"c);
    var metrics: int64 := CWListMetrics(cwClient, "AWS/EC2"c, "CPUUtilization"c);
    if (metrics != 0) { PrintLn(metrics as pchar); free(metrics, StrLen(metrics as pchar)+1); }
    else { PrintLn("(no metrics or error)"c); }

    // Put custom metric
    PrintLn("--- Put Custom Metric ---"c);
    var dataBuf: int64 := alloc(32);
    var name: pchar := "RequestCount"c;
    poke64(dataBuf,     name as int64);  // metricName
    poke64(dataBuf+8,   42);             // value (42 requests)
    poke64(dataBuf+16, "Count"c as int64); // unit
    poke64(dataBuf+24, 0);              // timestamp (0 = now)
    var ok: int64 := CWPutMetricData(cwClient, "MyApp/Production"c, dataBuf, 1);
    free(dataBuf, 32);
    if (ok == 1) { PrintLn("Custom metric published"c); } else { PrintLn("Metric publish failed"c); }

    // Describe alarms
    PrintLn("--- Describe Alarms ---"c);
    var alarms: int64 := CWDescribeAlarms(cwClient, 0 as pchar);
    if (alarms != 0) { PrintLn(alarms as pchar); free(alarms, StrLen(alarms as pchar)+1); }
    else { PrintLn("(no alarms)"c); }

    CWClose(cwClient);

    // ── Logs ──────────────────────────────────────────────────────────────────

    var logsClient: CWLogsClient := CWLogsConnect(creds, region);
    var groupName:  pchar := "/lyxaws/demo"c;
    var streamName: pchar := "run-001"c;

    // Create log group
    PrintLn("--- Create Log Group ---"c);
    ok := CWLogsCreateLogGroup(logsClient, groupName);
    if (ok == 1) { PrintLn("Log group created"c); } else { PrintLn("Log group exists or error"c); }

    // Set retention
    PrintLn("--- Set Retention (7 days) ---"c);
    ok := CWLogsPutRetentionPolicy(logsClient, groupName, 7);
    if (ok == 1) { PrintLn("Retention set"c); }

    // Create log stream
    PrintLn("--- Create Log Stream ---"c);
    ok := CWLogsCreateLogStream(logsClient, groupName, streamName);
    if (ok == 1) { PrintLn("Log stream created"c); } else { PrintLn("Stream exists or error"c); }

    // Put log events
    PrintLn("--- Put Log Events ---"c);
    var msgsBuf: int64 := alloc(3 * 8);
    var tsBuf:   int64 := alloc(3 * 8);
    poke64(msgsBuf,    "Application started"c    as int64);
    poke64(msgsBuf+8,  "Processing request 1"c   as int64);
    poke64(msgsBuf+16, "Request completed OK"c   as int64);
    // timestamps: current epoch ms (approximate)
    poke64(tsBuf,    1718000000000);
    poke64(tsBuf+8,  1718000001000);
    poke64(tsBuf+16, 1718000002000);
    var logResult: int64 := CWLogsPutLogEvents(logsClient, groupName, streamName,
                                               msgsBuf, tsBuf, 3, 0 as pchar);
    free(msgsBuf, 3*8); free(tsBuf, 3*8);
    if (logResult != 0) {
        PrintLn("Log events submitted"c);
        free(logResult, StrLen(logResult as pchar)+1);
    } else {
        PrintLn("Log events failed"c);
    }

    // Get log events back
    PrintLn("--- Get Log Events ---"c);
    var events: int64 := CWLogsGetLogEvents(logsClient, groupName, streamName, 0, 0, 10);
    if (events != 0) { PrintLn(events as pchar); free(events, StrLen(events as pchar)+1); }

    // List log groups
    PrintLn("--- List Log Groups ---"c);
    var groups: int64 := CWLogsDescribeLogGroups(logsClient, "/lyxaws"c);
    if (groups != 0) { PrintLn(groups as pchar); free(groups, StrLen(groups as pchar)+1); }

    // Cleanup: delete log group
    PrintLn("--- Delete Log Group ---"c);
    ok := CWLogsDeleteLogGroup(logsClient, groupName);
    if (ok == 1) { PrintLn("Log group deleted"c); } else { PrintLn("Delete failed"c); }

    CWLogsClose(logsClient);
    PrintLn("=== Done ==="c);
    return 0;
}
