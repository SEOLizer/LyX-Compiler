// tests/hl703_result_test.lyx — WP-HL7-03 Befunde: ORU^R01 / OUL^R22 (45 tests)
unit tests.hl703_result_test;

import std.hl7.results;
import std.hl7.core;
import std.alloc;
import std.io;

fn strEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
        if (peek8(a + i) != peek8(b + i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

fn contains(hay: int64, hayLen: int64, needle: int64, needleLen: int64): int64 {
    var i: int64 := 0;
    while (i <= hayLen - needleLen) {
        if (strEq(hay + i, needleLen, needle, needleLen)) { return 1; }
        i := i + 1;
    }
    return 0;
}

fn pass(n: int64) { Print("PASS "); PrintLn(n); }
fn fail(n: int64) { Print("FAIL "); PrintLn(n); }
fn check(n: int64, ok: int64) { if (ok == 1) { pass(n); } else { fail(n); } }

fn main() {
    var obx:    int64 := alloc(HL7_OBX_SIZE);
    var note:   int64 := alloc(HL7_NTE_SIZE);
    var report: int64 := alloc(HL7_RPT_SIZE);
    var out:    int64 := alloc(4096);

    // ── Tests 1-9: OBX segment basics ────────────────────────────────────────
    // "OBX|1|NM|8867-4^Heart rate^LN||72|/min|60-100|N|||F"
    // f1=1  f2=NM  f3=8867-4^Heart rate^LN  f4=  f5=72  f6=/min  f7=60-100  f8=N  f9=  f10=  f11=F
    // length = 51 chars
    {
        var seg: int64 := "OBX|1|NM|8867-4^Heart rate^LN||72|/min|60-100|N|||F"c as int64;
        var slen: int64 := 51;
        Hl7ObxParse(seg, slen, obx);

        // Test 1: OBX-1 set ID = "1"
        {
            var p: int64 := peek64(obx + HL7_OBX_SETID);
            var l: int64 := peek64(obx + HL7_OBX_SETID_LEN);
            var exp: int64 := "1"c as int64;
            check(1, strEq(p, l, exp, 1));
        }

        // Test 2: OBX-2 value type = "NM"
        {
            var p: int64 := peek64(obx + HL7_OBX_VALTYPE);
            var l: int64 := peek64(obx + HL7_OBX_VALTYPE_LEN);
            var exp: int64 := "NM"c as int64;
            check(2, strEq(p, l, exp, 2));
        }

        // Test 3: OBX-3 observation ID = "8867-4^Heart rate^LN" (20 chars)
        {
            var p: int64 := peek64(obx + HL7_OBX_OBSID);
            var l: int64 := peek64(obx + HL7_OBX_OBSID_LEN);
            var exp: int64 := "8867-4^Heart rate^LN"c as int64;
            check(3, strEq(p, l, exp, 20));
        }

        // Test 4: OBX-5 value = "72"
        {
            var p: int64 := peek64(obx + HL7_OBX_VALUE);
            var l: int64 := peek64(obx + HL7_OBX_VALUE_LEN);
            var exp: int64 := "72"c as int64;
            check(4, strEq(p, l, exp, 2));
        }

        // Test 5: OBX-6 units = "/min"
        {
            var p: int64 := peek64(obx + HL7_OBX_UNIT);
            var l: int64 := peek64(obx + HL7_OBX_UNIT_LEN);
            var exp: int64 := "/min"c as int64;
            check(5, strEq(p, l, exp, 4));
        }

        // Test 6: OBX-7 reference range = "60-100"
        {
            var p: int64 := peek64(obx + HL7_OBX_REFRANGE);
            var l: int64 := peek64(obx + HL7_OBX_REFRANGE_LEN);
            var exp: int64 := "60-100"c as int64;
            check(6, strEq(p, l, exp, 6));
        }

        // Test 7: OBX-8 abnormal flag = "N"
        {
            var p: int64 := peek64(obx + HL7_OBX_ABNFLAG);
            var l: int64 := peek64(obx + HL7_OBX_ABNFLAG_LEN);
            var exp: int64 := "N"c as int64;
            check(7, strEq(p, l, exp, 1));
        }

        // Test 8: OBX-11 status = "F"
        {
            var p: int64 := peek64(obx + HL7_OBX_STATUS);
            var l: int64 := peek64(obx + HL7_OBX_STATUS_LEN);
            var exp: int64 := "F"c as int64;
            check(8, strEq(p, l, exp, 1));
        }

        // Test 9: HL7_OBX_SIZE constant = 144
        check(9, HL7_OBX_SIZE == 144);
    }

    // ── Tests 10-13: ISCORR flag ─────────────────────────────────────────────
    // Segment pattern "OBX|1|NM|loinc||72||||||?" (25 chars) — f11=status char

    // Test 10: OBX-11 = C → ISCORR=1 (Corrected value)
    {
        var seg: int64 := "OBX|1|NM|loinc||72||||||C"c as int64;
        var slen: int64 := 25;
        Hl7ObxParse(seg, slen, obx);
        check(10, peek64(obx + HL7_OBX_ISCORR) == 1);
    }

    // Test 11: OBX-11 = W → ISCORR=1 (Wrong / deleted)
    {
        var seg: int64 := "OBX|1|NM|loinc||72||||||W"c as int64;
        var slen: int64 := 25;
        Hl7ObxParse(seg, slen, obx);
        check(11, peek64(obx + HL7_OBX_ISCORR) == 1);
    }

    // Test 12: OBX-11 = F → ISCORR=0 (Final, not corrected)
    {
        var seg: int64 := "OBX|1|NM|loinc||72||||||F"c as int64;
        var slen: int64 := 25;
        Hl7ObxParse(seg, slen, obx);
        check(12, peek64(obx + HL7_OBX_ISCORR) == 0);
    }

    // Test 13: OBX-11 = P → ISCORR=0 (Preliminary, not corrected)
    {
        var seg: int64 := "OBX|1|NM|loinc||72||||||P"c as int64;
        var slen: int64 := 25;
        Hl7ObxParse(seg, slen, obx);
        check(13, peek64(obx + HL7_OBX_ISCORR) == 0);
    }

    // ── Tests 14-19: ISCRIT flag ─────────────────────────────────────────────
    // Pattern "OBX|1|NM|loinc||15|||XX|||F" (27 chars) — f8=abnflag, f11=F

    // Test 14: OBX-8 = AA → ISCRIT=1 (panic / absurd abnormal)
    {
        var seg: int64 := "OBX|1|NM|loinc||15|||AA|||F"c as int64;
        var slen: int64 := 27;
        Hl7ObxParse(seg, slen, obx);
        check(14, peek64(obx + HL7_OBX_ISCRIT) == 1);
    }

    // Test 15: OBX-8 = LL → ISCRIT=1 (critical low)
    {
        var seg: int64 := "OBX|1|NM|loinc||15|||LL|||F"c as int64;
        var slen: int64 := 27;
        Hl7ObxParse(seg, slen, obx);
        check(15, peek64(obx + HL7_OBX_ISCRIT) == 1);
    }

    // Test 16: OBX-8 = HH → ISCRIT=1 (critical high)
    {
        var seg: int64 := "OBX|1|NM|loinc||15|||HH|||F"c as int64;
        var slen: int64 := 27;
        Hl7ObxParse(seg, slen, obx);
        check(16, peek64(obx + HL7_OBX_ISCRIT) == 1);
    }

    // Test 17: OBX-8 = CC → ISCRIT=1 (critical call-back)
    {
        var seg: int64 := "OBX|1|NM|loinc||15|||CC|||F"c as int64;
        var slen: int64 := 27;
        Hl7ObxParse(seg, slen, obx);
        check(17, peek64(obx + HL7_OBX_ISCRIT) == 1);
    }

    // Test 18: OBX-8 = H (single char) → ISCRIT=0 (abnormal high, not critical)
    // "OBX|1|NM|loinc||110|||H|||F" — 27 chars, f5=110 (3 chars)
    {
        var seg: int64 := "OBX|1|NM|loinc||110|||H|||F"c as int64;
        var slen: int64 := 27;
        Hl7ObxParse(seg, slen, obx);
        check(18, peek64(obx + HL7_OBX_ISCRIT) == 0);
    }

    // Test 19: OBX-8 = L (single char) → ISCRIT=0 (abnormal low, not critical)
    // "OBX|1|NM|loinc||55|||L|||F" — 26 chars
    {
        var seg: int64 := "OBX|1|NM|loinc||55|||L|||F"c as int64;
        var slen: int64 := 26;
        Hl7ObxParse(seg, slen, obx);
        check(19, peek64(obx + HL7_OBX_ISCRIT) == 0);
    }

    // ── Tests 20-26: All 7 OBX value types ───────────────────────────────────
    // Each test parses a segment and verifies OBX-2 (value type code).

    // Test 20: NM (Numeric) — "OBX|1|NM|loinc||72||||||F" (25 chars)
    {
        var seg: int64 := "OBX|1|NM|loinc||72||||||F"c as int64;
        var slen: int64 := 25;
        Hl7ObxParse(seg, slen, obx);
        var p: int64 := peek64(obx + HL7_OBX_VALTYPE);
        var l: int64 := peek64(obx + HL7_OBX_VALTYPE_LEN);
        var exp: int64 := "NM"c as int64;
        check(20, strEq(p, l, exp, 2));
    }

    // Test 21: ST (Short Text) — "OBX|1|ST|loinc||Positive||||||F" (31 chars)
    {
        var seg: int64 := "OBX|1|ST|loinc||Positive||||||F"c as int64;
        var slen: int64 := 31;
        Hl7ObxParse(seg, slen, obx);
        var p: int64 := peek64(obx + HL7_OBX_VALTYPE);
        var l: int64 := peek64(obx + HL7_OBX_VALTYPE_LEN);
        var exp: int64 := "ST"c as int64;
        check(21, strEq(p, l, exp, 2));
    }

    // Test 22: TX (Text) — "OBX|1|TX|loinc||Long text||||||F" (32 chars)
    {
        var seg: int64 := "OBX|1|TX|loinc||Long text||||||F"c as int64;
        var slen: int64 := 32;
        Hl7ObxParse(seg, slen, obx);
        var p: int64 := peek64(obx + HL7_OBX_VALTYPE);
        var l: int64 := peek64(obx + HL7_OBX_VALTYPE_LEN);
        var exp: int64 := "TX"c as int64;
        check(22, strEq(p, l, exp, 2));
    }

    // Test 23: CWE (Coded With Exceptions) — "OBX|1|CWE|loinc||code^sys||||||F" (32 chars)
    {
        var seg: int64 := "OBX|1|CWE|loinc||code^sys||||||F"c as int64;
        var slen: int64 := 32;
        Hl7ObxParse(seg, slen, obx);
        var p: int64 := peek64(obx + HL7_OBX_VALTYPE);
        var l: int64 := peek64(obx + HL7_OBX_VALTYPE_LEN);
        var exp: int64 := "CWE"c as int64;
        check(23, strEq(p, l, exp, 3));
    }

    // Test 24: SN (Structured Numeric) — "OBX|1|SN|loinc||^1.5||||||F" (27 chars)
    {
        var seg: int64 := "OBX|1|SN|loinc||^1.5||||||F"c as int64;
        var slen: int64 := 27;
        Hl7ObxParse(seg, slen, obx);
        var p: int64 := peek64(obx + HL7_OBX_VALTYPE);
        var l: int64 := peek64(obx + HL7_OBX_VALTYPE_LEN);
        var exp: int64 := "SN"c as int64;
        check(24, strEq(p, l, exp, 2));
    }

    // Test 25: FT (Formatted Text) — "OBX|1|FT|loinc||formatted||||||F" (32 chars)
    {
        var seg: int64 := "OBX|1|FT|loinc||formatted||||||F"c as int64;
        var slen: int64 := 32;
        Hl7ObxParse(seg, slen, obx);
        var p: int64 := peek64(obx + HL7_OBX_VALTYPE);
        var l: int64 := peek64(obx + HL7_OBX_VALTYPE_LEN);
        var exp: int64 := "FT"c as int64;
        check(25, strEq(p, l, exp, 2));
    }

    // Test 26: RP (Reference Pointer) — "OBX|1|RP|loinc||url||||||F" (26 chars)
    {
        var seg: int64 := "OBX|1|RP|loinc||url||||||F"c as int64;
        var slen: int64 := 26;
        Hl7ObxParse(seg, slen, obx);
        var p: int64 := peek64(obx + HL7_OBX_VALTYPE);
        var l: int64 := peek64(obx + HL7_OBX_VALTYPE_LEN);
        var exp: int64 := "RP"c as int64;
        check(26, strEq(p, l, exp, 2));
    }

    // ── Tests 27-29: NTE segment parsing ─────────────────────────────────────
    // "NTE|1|L|This is a comment" — 25 chars, NTE-3 = "This is a comment" (17 chars)

    // Test 27: NTE-3 text pointer and length non-zero
    {
        var seg: int64 := "NTE|1|L|This is a comment"c as int64;
        var slen: int64 := 25;
        Hl7NteParse(seg, slen, note);
        var l: int64 := peek64(note + HL7_NTE_TEXT_LEN);
        check(27, l > 0);
    }

    // Test 28: NTE-3 text = "This is a comment"
    {
        var seg: int64 := "NTE|1|L|This is a comment"c as int64;
        var slen: int64 := 25;
        Hl7NteParse(seg, slen, note);
        var p: int64 := peek64(note + HL7_NTE_TEXT);
        var l: int64 := peek64(note + HL7_NTE_TEXT_LEN);
        var exp: int64 := "This is a comment"c as int64;
        check(28, strEq(p, l, exp, 17));
    }

    // Test 29: HL7_NTE_SIZE = 16
    check(29, HL7_NTE_SIZE == 16);

    // ── Tests 30-38: ORU^R01 full message parse ───────────────────────────────
    // MSH(53)+CR(1)+PID(17)+CR(1)+OBR(55)+CR(1)+OBX(37) = 165 bytes
    // MSH: "MSH|^~\&|LIS|LAB|KIS|H|20260615||ORU^R01|R001|P|2.5.1"
    // PID: "PID|1||P001^^^KIS"
    // OBR: "OBR|1|PL001|FL001|8867-4||20260615080000|20260615090000"
    // OBX: "OBX|1|NM|8867-4||72|/min|60-100|N|||F"
    {
        var msg: int64 := "MSH|^~\\&|LIS|LAB|KIS|H|20260615||ORU^R01|R001|P|2.5.1\rPID|1||P001^^^KIS\rOBR|1|PL001|FL001|8867-4||20260615080000|20260615090000\rOBX|1|NM|8867-4||72|/min|60-100|N|||F"c as int64;
        var mlen: int64 := 165;
        Hl7OruParse(msg, mlen, report);

        // Test 30: MSGTYPE = 1 (ORU)
        check(30, peek64(report + HL7_RPT_MSGTYPE) == 1);

        // Test 31: EVENT = "R01"
        {
            var p: int64 := peek64(report + HL7_RPT_EVENT);
            var l: int64 := peek64(report + HL7_RPT_EVENT_LEN);
            var exp: int64 := "R01"c as int64;
            check(31, strEq(p, l, exp, 3));
        }

        // Test 32: PAT_ID = "P001" from PID-3.1
        {
            var p: int64 := peek64(report + HL7_RPT_PAT_ID);
            var l: int64 := peek64(report + HL7_RPT_PAT_ID_LEN);
            var exp: int64 := "P001"c as int64;
            check(32, strEq(p, l, exp, 4));
        }

        // Test 33: PLACER = "PL001" from OBR-2
        {
            var p: int64 := peek64(report + HL7_RPT_PLACER);
            var l: int64 := peek64(report + HL7_RPT_PLACER_LEN);
            var exp: int64 := "PL001"c as int64;
            check(33, strEq(p, l, exp, 5));
        }

        // Test 34: FILLER = "FL001" from OBR-3
        {
            var p: int64 := peek64(report + HL7_RPT_FILLER);
            var l: int64 := peek64(report + HL7_RPT_FILLER_LEN);
            var exp: int64 := "FL001"c as int64;
            check(34, strEq(p, l, exp, 5));
        }

        // Test 35: SERVICE = "8867-4" from OBR-4
        {
            var p: int64 := peek64(report + HL7_RPT_SERVICE);
            var l: int64 := peek64(report + HL7_RPT_SERVICE_LEN);
            var exp: int64 := "8867-4"c as int64;
            check(35, strEq(p, l, exp, 6));
        }

        // Test 36: OBS_DT = "20260615090000" from OBR-7
        {
            var p: int64 := peek64(report + HL7_RPT_OBS_DT);
            var l: int64 := peek64(report + HL7_RPT_OBS_DT_LEN);
            var exp: int64 := "20260615090000"c as int64;
            check(36, strEq(p, l, exp, 14));
        }
    }

    // Test 37: ORU with critical OBX-8=AA — parse OBX from message → ISCRIT=1
    // MSH(53)+CR(1)+OBX(38) = 92 bytes, OBX at offset 54
    {
        var msg: int64 := "MSH|^~\\&|LIS|LAB|KIS|H|20260615||ORU^R01|R002|P|2.5.1\rOBX|1|NM|8867-4||15|/min|60-100|AA|||F"c as int64;
        var obxSeg: int64 := msg + 54;
        var obxLen: int64 := 38;
        Hl7ObxParse(obxSeg, obxLen, obx);
        check(37, peek64(obx + HL7_OBX_ISCRIT) == 1);
    }

    // Test 38: HL7_RPT_SIZE = 104
    check(38, HL7_RPT_SIZE == 104);

    // ── Tests 39-42: OUL^R22 with SPM + OBX ─────────────────────────────────
    // MSH(53)+CR(1)+PID(17)+CR(1)+SPM(17)+CR(1)+OBR(24)+CR(1)+OBX(32) = 147 bytes
    // MSH: "MSH|^~\&|LIS|LAB|KIS|H|20260615||OUL^R22|U001|P|2.5.1"
    // PID: "PID|1||U001^^^KIS"
    // SPM: "SPM|1|SP001||BLOO"   (specimen — presence must not break parsing)
    // OBR: "OBR|1|PL002|FL002|MICBLD"
    // OBX: "OBX|1|ST|MICBLD||Positive||||||F"
    {
        var msg: int64 := "MSH|^~\\&|LIS|LAB|KIS|H|20260615||OUL^R22|U001|P|2.5.1\rPID|1||U001^^^KIS\rSPM|1|SP001||BLOO\rOBR|1|PL002|FL002|MICBLD\rOBX|1|ST|MICBLD||Positive||||||F"c as int64;
        var mlen: int64 := 147;
        Hl7OulParse(msg, mlen, report);

        // Test 39: MSGTYPE = 2 (OUL)
        check(39, peek64(report + HL7_RPT_MSGTYPE) == 2);

        // Test 40: EVENT = "R22"
        {
            var p: int64 := peek64(report + HL7_RPT_EVENT);
            var l: int64 := peek64(report + HL7_RPT_EVENT_LEN);
            var exp: int64 := "R22"c as int64;
            check(40, strEq(p, l, exp, 3));
        }

        // Test 41: PAT_ID = "U001" — SPM segment does not corrupt PID parsing
        {
            var p: int64 := peek64(report + HL7_RPT_PAT_ID);
            var l: int64 := peek64(report + HL7_RPT_PAT_ID_LEN);
            var exp: int64 := "U001"c as int64;
            check(41, strEq(p, l, exp, 4));
        }

        // Test 42: PLACER = "PL002" from OBR-2
        {
            var p: int64 := peek64(report + HL7_RPT_PLACER);
            var l: int64 := peek64(report + HL7_RPT_PLACER_LEN);
            var exp: int64 := "PL002"c as int64;
            check(42, strEq(p, l, exp, 5));
        }
    }

    // ── Tests 43-45: Hl7OruWrite output structure ────────────────────────────
    {
        var i: int64 := 0;
        while (i < HL7_RPT_SIZE) { poke8(report + i, 0); i := i + 1; }
        i := 0;
        while (i < HL7_OBX_SIZE) { poke8(obx + i, 0); i := i + 1; }

        var plStr: int64 := "PL001"c as int64;
        poke64(report + HL7_RPT_PLACER, plStr);
        poke64(report + HL7_RPT_PLACER_LEN, 5);

        var vtStr: int64 := "NM"c as int64;
        poke64(obx + HL7_OBX_VALTYPE, vtStr);
        poke64(obx + HL7_OBX_VALTYPE_LEN, 2);

        var valStr: int64 := "72"c as int64;
        poke64(obx + HL7_OBX_VALUE, valStr);
        poke64(obx + HL7_OBX_VALUE_LEN, 2);

        var stStr: int64 := "F"c as int64;
        poke64(obx + HL7_OBX_STATUS, stStr);
        poke64(obx + HL7_OBX_STATUS_LEN, 1);

        var n: int64 := Hl7OruWrite(report, obx, out, 4096);

        // Test 43: output starts with "MSH"
        check(43, peek8(out) == 77 && peek8(out+1) == 83 && peek8(out+2) == 72);

        // Test 44: output contains "OBR" segment tag
        var obrTag: int64 := "OBR"c as int64;
        check(44, contains(out, n, obrTag, 3));

        // Test 45: output contains "OBX" segment tag
        var obxTag: int64 := "OBX"c as int64;
        check(45, contains(out, n, obxTag, 3));
    }
}
