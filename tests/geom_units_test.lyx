// tests/geom_units_test.lyx — Funktionsprüfung der Geometrie-/Result-Units.
//
// Diese Units (vector/rect/circle/color/result) benutzten Struct-Literale
// `Type{f: e, ...}` — eine Syntax, die Lyx nie hatte (weder Parser noch EBNF);
// sie waren dadurch schlicht nicht kompilierbar. Beim Umschreiben auf
// Deklaration + Feldzuweisung sind die VERSCHACHTELTEN Fälle
// (`Rect{min: Vec2{...}, max: Vec2{...}}`) am fehleranfälligsten, weil dort ein
// inneres Literal in eine eigene Hilfsvariable wandern muss. Deshalb prüft
// dieser Test Konstruktoren UND abgeleitete Werte gegen erwartete Zahlen, statt
// sich auf „kompiliert durch" zu verlassen.

import std.io;
import std.vector;
import std.rect;
import std.circle;
import std.color;
import std.result;

var failures: int64 := 0;

fn expect(name: pchar, got: int64, want: int64) {
  Print(name); Print(": ");
  if (got == want) {
    PrintLn("OK");
  } else {
    Print("FAIL got="); PrintInt(got); Print(" want="); PrintInt(want); PrintLn("");
    failures += 1;
  }
}

fn main(): int64 {
  // --- vector: einfache Literale ---
  var a: Vec2 := Vec2New(3, 4);
  expect("Vec2New.x", a.x, 3);
  expect("Vec2New.y", a.y, 4);
  var z: Vec2 := Vec2Zero();
  expect("Vec2Zero", z.x + z.y, 0);
  var b: Vec2 := Vec2New(10, 20);
  var s: Vec2 := Vec2Add(a, b);
  expect("Vec2Add.x", s.x, 13);
  expect("Vec2Add.y", s.y, 24);
  var d: Vec2 := Vec2Sub(b, a);
  expect("Vec2Sub.x", d.x, 7);
  var m: Vec2 := Vec2Mul(a, 3);
  expect("Vec2Mul.y", m.y, 12);

  // --- rect: verschachtelte Literale ---
  var r0: Rect := RectNew(a, b);
  expect("RectNew.min.x", r0.min.x, 3);
  expect("RectNew.max.y", r0.max.y, 20);

  var e: Rect := RectEmpty();
  expect("RectEmpty.min.x", e.min.x, 0);
  expect("RectEmpty.max.y", e.max.y, 0);

  var r: Rect := RectFromXYWH(5, 7, 10, 20);
  expect("FromXYWH.min.x", r.min.x, 5);
  expect("FromXYWH.min.y", r.min.y, 7);
  expect("FromXYWH.max.x", r.max.x, 15);
  expect("FromXYWH.max.y", r.max.y, 27);

  var sz: Vec2 := RectSize(r);
  expect("RectSize.x", sz.x, 10);
  expect("RectSize.y", sz.y, 20);

  var ctr: Vec2 := RectCenter(r);
  expect("RectCenter.x", ctr.x, 10);

  // --- circle: verschachtelte Literale ---
  var c: Circle := CircleNew(a, 5);
  expect("CircleNew.center.x", c.center.x, 3);
  expect("CircleNew.radius", c.radius, 5);

  var c2: Circle := CircleFromXYR(10, 10, 4);
  expect("CircleFromXYR.center.y", c2.center.y, 10);
  expect("CircleFromXYR.radius", c2.radius, 4);

  var br: Rect := CircleBoundingRect(c2);
  expect("BoundingRect.min.x", br.min.x, 6);
  expect("BoundingRect.max.x", br.max.x, 14);
  expect("BoundingRect.min.y", br.min.y, 6);
  expect("BoundingRect.max.y", br.max.y, 14);

  // --- color: vierfeldrige Literale ---
  var col: Color := ColorRGBA(10, 20, 30, 40);
  expect("Color.r", col.r, 10);
  expect("Color.g", col.g, 20);
  expect("Color.b", col.b, 30);
  expect("Color.a", col.a, 40);

  // --- result: Literale mit bool-Feld ---
  var ok: ResultInt64 := OkInt64(99);
  expect("Result.value", ok.value, 99);
  expect("Result.success", ok.success as int64, 1);
  expect("Result.unwrap", ResultInt64Unwrap(ok), 99);

  if (failures == 0) { PrintLn("ALL OK"); return 0; }
  PrintLn("FAILURES");
  return 1;
}
