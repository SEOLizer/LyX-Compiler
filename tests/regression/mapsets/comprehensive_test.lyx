// #1821: Der Set-Teil ist entfernt. `Set` ist als Wort reserviert, die
// Semantikpruefung loest `Set<T>` aber nicht auf — ebnf.md fuehrt die Form
// ausdruecklich NICHT als gueltige Produktion ("fuer spaeter vorgesehen").
// Was bleibt, ist der Map-Teil, den es wirklich gibt.
// Comprehensive Map/Set test
fn main() {
  Print("=== Map Tests ===\n");
  
  // 1. Empty map creation
  var m: Map<int64, int64> := {};
  Print("1. Empty map created\n");
  
  // 2. Map insertion
  m[1] := 100;
  m[2] := 200;
  m[3] := 300;
  Print("2. Inserted 3 entries\n");
  
  // 3. Map access
  Print("3. m[1] = ");
  PrintInt(m[1]);
  Print(", m[2] = ");
  PrintInt(m[2]);
  Print(", m[3] = ");
  PrintInt(m[3]);
  Print("\n");
  
  // 4. Map update
  m[2] := 999;
  Print("4. Updated m[2] = ");
  PrintInt(m[2]);
  Print("\n");
  
  // 5. Map contains (in operator)
  if (1 in m) {
    Print("5. Key 1 exists in map\n");
  }
  if (99 in m) {
    Print("ERROR: Key 99 should not exist\n");
  } else {
    Print("   Key 99 does not exist (correct)\n");
  }
  
  // 6. Map with literal initialization
  var m2: Map<int64, int64> := {10: 1000, 20: 2000};
  Print("6. m2[10] = ");
  PrintInt(m2[10]);
  Print(", m2[20] = ");
  PrintInt(m2[20]);
  Print("\n");
  
  Print("\n=== All tests passed! ===\n");
  exit(0);
}
