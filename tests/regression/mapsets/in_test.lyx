// #1821: Dieser Test benutzte zusaetzlich `Set<T>`. Den Typ gibt es nicht:
// `Set` ist als Wort reserviert, die Semantikpruefung loest `Set<T>` aber
// nicht auf — ebnf.md fuehrt die Form ausdruecklich NICHT als gueltige
// Produktion ("fuer spaeter vorgesehen"). Der Set-Teil ist deshalb entfernt
// statt portiert; was hier bleibt, ist der Map-Teil, den es wirklich gibt.
fn main() {
  var m: Map<int64, int64> := {1: 10, 2: 20};

  if (1 in m) {
    Print("1 in map: yes\n");
  } else {
    Print("1 in map: no\n");
  }

  if (3 in m) {
    Print("3 in map: yes\n");
  } else {
    Print("3 in map: no\n");
  }

  exit(0);
}
