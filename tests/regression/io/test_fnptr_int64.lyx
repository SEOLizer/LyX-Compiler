// Test: function pointer - use int64 directly
fn add(a: int64, b: int64): int64 {
  return a + b;
}

fn main(): int64 {
  // Use int64 to store function address
  var cb: int64 := add as int64;
  // #1150: die ADRESSE selbst ist nicht stabil; geprueft wird, dass sie nicht 0 ist.
  if (cb != 0) { PrintLn("PASS Adresse != 0"); } else { PrintLn("FAIL Adresse 0"); }
  return 0;
}
