// Test std.net after refactoring
// Note: Using built-in PrintInt and Print from std

// #1820: IPPack/IPUnpack/TCPListener* gibt es alle in std.net.socket —
// dem Test fehlte nur der Import.
import std.net.socket;

fn main(): int64 {
  // Test IP packing  
  var ip: int64 := IPPack(192, 168, 1, 1);
  
  // Test IP unpacking
  var addr: IPAddr := IPUnpack(ip);
  
  // Test TCPListener
  var listener: TCPListener;
  listener := TCPListenerNew();
  
  if (listener.fd < 0) {
    return 1;
  }
  
  // Test binding
  // #1820: band an 192.168.1.1 — eine Adresse, die die Maschine nicht hat,
  // also scheitert bind zwangslaeufig. Geprueft werden soll der Aufrufweg,
  // dafuer ist die Loopback-Adresse die richtige.
  var result: int64 := TCPListenerBindTo(listener, IPPack(127, 0, 0, 1), 18080);
  if (result < 0) {
    TCPListenerClose(listener);
    return 1;
  }
  
  TCPListenerClose(listener);
  
  return 0;
}
