fn main(): int64 {
  var a: array := [10, 20, 30];
  Print("len: ");
  PrintInt(len(a));
  Print("\n");
  Print("a[0]: ");
  PrintInt(a[0]);
  Print("\n");
  Print("a[1]: ");
  PrintInt(a[1]);
  Print("\n");
  Print("a[2]: ");
  PrintInt(a[2]);
  Print("\n");
  var sum: int64 := a[0] + a[1] + a[2];
  Print("sum: ");
  PrintInt(sum);
  Print("\n");
  // #1150: den Ein-Argument-`free` gibt es nicht mehr; die Puffer der
  // dynamischen Arrays gehoeren dem Arena-Allokator und werden nicht einzeln
  // zurueckgegeben.
  if (sum == 60) { PrintLn("PASS sum=60"); } else { Print("FAIL sum="); PrintLn(sum); }
  return 0;
}
