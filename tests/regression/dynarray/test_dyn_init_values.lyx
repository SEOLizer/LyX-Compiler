fn main(): int64 {
  var a: array := [10, 20, 30];
  Print("len: ");
  PrintInt(len(a));
  Print("\n");
  Print("a[0]: ");
  PrintInt(a[0]);
  Print("\n");
  Print("a[1]: ");
  PrintInt(a[1]);
  Print("\n");
  Print("a[2]: ");
  PrintInt(a[2]);
  Print("\n");
  var sum: int64 := a[0] + a[1] + a[2];
  Print("sum: ");
  PrintInt(sum);
  Print("\n");
  free(a);
  return sum;
}
