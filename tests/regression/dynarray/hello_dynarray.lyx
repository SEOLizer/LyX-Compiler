fn main(): int64 {
  var a: array := [];
  Print("Array init: ");
  PrintInt(len(a));
  Print("\n");

  push(a, 10);
  Print("After push 10, len: ");
  PrintInt(len(a));
  Print("\n");

  push(a, 20);
  Print("After push 20, len: ");
  PrintInt(len(a));
  Print("\n");

  Print("a[0]: ");
  PrintInt(a[0]);
  Print("\n");

  Print("a[1]: ");
  PrintInt(a[1]);
  Print("\n");

  var popped: int64 := pop(a);
  Print("Popped: ");
  PrintInt(popped);
  Print("\n");
  Print("After pop, len: ");
  PrintInt(len(a));
  Print("\n");

  a[0] := 100;
  Print("a[0] after assign: ");
  PrintInt(a[0]);
  Print("\n");

  // #1150: den Ein-Argument-`free` gibt es nicht mehr; die Puffer der
  // dynamischen Arrays gehoeren dem Arena-Allokator und werden nicht einzeln
  // zurueckgegeben.
  Print("After free.\n");

  return 0;
}
