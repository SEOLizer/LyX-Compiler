// test_append.lyx
// Teste den append-Builtin (Alias für push)
fn main(): int64 {
  var a: array := [];

  append(a, 10);
  append(a, 20);
  append(a, 30);

  Print("len after 3 appends: ");
  PrintInt(len(a));
  Print("\n");

  Print("a[0]: ");
  PrintInt(a[0]);
  Print("\n");

  Print("a[1]: ");
  PrintInt(a[1]);
  Print("\n");

  Print("a[2]: ");
  PrintInt(a[2]);
  Print("\n");

  // #1150: den Ein-Argument-`free` gibt es nicht mehr; die Puffer der
  // dynamischen Arrays gehoeren dem Arena-Allokator und werden nicht einzeln
  // zurueckgegeben.
  return 0;
}
