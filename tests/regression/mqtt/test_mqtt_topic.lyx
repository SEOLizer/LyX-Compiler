// tests/regression/mqtt/test_mqtt_topic.lyx
// MQTT-UTF-8, Topic Names, Topic Filter und Shared Subscriptions.
// Beide Seiten gemessen: gueltige Werte MQ_OK, ungueltige mit EXAKTEM
// Fehlercode (CLAUDE.md, "Beide Seiten messen").
import std.io;
import std.mqtt.topic;

var fehler: int64 := 0;

fn chk(name: pchar, ist: int64, soll: int64) {
  if (ist != soll) {
    fehler := fehler + 1;
    Print("FAIL "); Print(name); Print(" ist="); PrintInt(ist);
    Print(" soll="); PrintInt(soll); Print("\n");
  }
}

fn s2p(s: pchar): int64 { return s as int64; }

fn main(): int64 {
  var b: int64 := alloc(64);
  // "a/b"
  poke8(b+0, 97); poke8(b+1, 47); poke8(b+2, 98);
  chk("name a/b", MqTopicNamePruefe(b, 3, true), MQ_OK);
  chk("filter a/b", MqTopicFilterPruefe(b, 3, true), MQ_OK);
  // "a/+"
  poke8(b+2, 43);
  chk("name a/+", MqTopicNamePruefe(b, 3, true), MQ_E_TOPIC_WILDCARD);
  chk("filter a/+", MqTopicFilterPruefe(b, 3, true), MQ_OK);
  // "a/+b"
  poke8(b+3, 98);
  chk("filter a/+b", MqTopicFilterPruefe(b, 4, true), MQ_E_FILTER_PLUS_LEVEL);
  // "a/#"
  poke8(b+2, 35);
  chk("filter a/#", MqTopicFilterPruefe(b, 3, true), MQ_OK);
  // "a/#/b"
  poke8(b+3, 47); poke8(b+4, 98);
  chk("filter a/#/b", MqTopicFilterPruefe(b, 5, true), MQ_E_FILTER_HASH_LAST);
  // leer
  chk("filter leer", MqTopicFilterPruefe(b, 0, true), MQ_E_TOPIC_EMPTY);
  // UTF-8: 0xC3 0xA4 = ä
  poke8(b+0, 195); poke8(b+1, 164);
  chk("utf8 ae", MqUtf8Pruefe(b, 2, true), MQ_OK);
  chk("utf8 abgeschnitten", MqUtf8Pruefe(b, 1, true), MQ_E_UTF8_FORM);
  // overlong C0 80
  poke8(b+0, 192); poke8(b+1, 128);
  chk("utf8 overlong C0", MqUtf8Pruefe(b, 2, true), MQ_E_UTF8_OVERLONG);
  // surrogate ED A0 80 = U+D800
  poke8(b+0, 237); poke8(b+1, 160); poke8(b+2, 128);
  chk("utf8 surrogate", MqUtf8Pruefe(b, 3, true), MQ_E_UTF8_SURROGATE);
  // U+0000 als 1 Byte
  poke8(b+0, 0);
  chk("utf8 null", MqUtf8Pruefe(b, 1, true), MQ_E_UTF8_NULL);
  // Steuerzeichen 0x01: streng abweisen, locker erlauben
  poke8(b+0, 1);
  chk("utf8 ctrl streng", MqUtf8Pruefe(b, 1, true), MQ_E_UTF8_CONTROL);
  chk("utf8 ctrl locker", MqUtf8Pruefe(b, 1, false), MQ_OK);
  // F5 ausserhalb
  poke8(b+0, 245);
  chk("utf8 F5", MqUtf8Pruefe(b, 1, true), MQ_E_UTF8_RANGE);
  // $share/g/a/b
  var sh: pchar := "$share/g/a/b";
  var p: int64 := s2p(sh);
  chk("shared erkannt", MqIstSharedFilter(p, 12) as int64, 1);
  var aus: int64 := alloc(16);
  chk("shared ok", MqSharedFilterPruefe(p, 12, true, aus), MQ_OK);
  chk("shared restOff", peek64(aus + 0), 9);
  chk("shared restLen", peek64(aus + 8), 3);
  var sh2: pchar := "$share//a";
  chk("shared leerer name", MqSubscribeFilterPruefe(s2p(sh2), 9, true), MQ_E_SHARE_NAME);
  var sh3: pchar := "$share/g";
  chk("shared ohne filter", MqSubscribeFilterPruefe(s2p(sh3), 8, true), MQ_E_SHARE_FILTER);

  if (fehler == 0) { Print("ALL PASS\n"); return 0; }
  Print("FAILS: "); PrintInt(fehler); Print("\n");
  return 1;
}
