// Test: abstract - class with multiple abstract methods

type Shape = class {
  abstract fn Area(): int64;
  abstract fn Perimeter(): int64;
};

// Concrete implementations
type Rectangle = class extends Shape {
  override fn Area(): int64 { return 12; }
  override fn Perimeter(): int64 { return 14; }
};

type Circle = class extends Shape {
  override fn Area(): int64 { return 9; }
  override fn Perimeter(): int64 { return 6; }
};

fn main(): int64 {
  var r: Rectangle := new Rectangle();
  var c: Circle := new Circle();
  
  var summe: int64 := r.Area() + r.Perimeter() + c.Area() + c.Perimeter();
  // 12 + 14 + 9 + 6 = 41
  if summe == 41 { PrintLn("PASS abstract_multi"c); } else { PrintLn("FAIL abstract_multi"c); }
  return 0;
}
