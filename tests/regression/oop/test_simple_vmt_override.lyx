// Simple test
type Base = class {
  virtual fn Foo(): int64 {
    return 0;
  }
};

type Derived = class extends Base {
  override fn Foo(): int64 {
    return 1;
  }
};

fn main(): int64 {
  var d: Derived := new Derived();
  if (d.Foo() == 1) { PrintLn("PASS override greift"); } else { PrintLn("FAIL"); }
  return 0;
}
