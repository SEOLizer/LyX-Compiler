// Test TObject mit explizitem extends
// Testet: explizite Vererbung von TObject, ClassName-Methode

// Eine Klasse die explizit von TObject erbt
type MyClass = class extends TObject {
  val: int64;
  
  fn SetVal(v: int64) {
    self.val := v;
  }
  
  fn GetVal(): int64 {
    return self.val;
  }
};

fn main(): int64 {
  // Test 1: Instanziierung
  var obj: MyClass := new MyClass();
  obj.SetVal(42);
  
  Print("Test 1: Basic functionality\n");
  Print("  obj.val = ");
  PrintInt(obj.GetVal());
  Print("\n");
  
  if (obj.GetVal() != 42) {
    Print("FAILED: GetVal() returned wrong value\n");
    return 1;
  }
  Print("  PASSED\n");
  
  // Test 2: ClassName() Methode (von TObject geerbt)
  Print("Test 2: ClassName() method\n");
  var name: pchar := obj.ClassName();
  Print("  obj.ClassName() = ");
  Print(name);
  Print("\n");
  Print("  PASSED\n");
  
  // Test 3: Free() Methode (von TObject geerbt)
  Print("Test 3: Free() method\n");
  obj.Free();
  Print("  PASSED (no crash)\n");
  
  Print("\nAll tests PASSED!\n");
  return 0;
}
