// Test: abstract method override via VMT
type Shape = class {
  abstract fn area(): int64;
};

type Rectangle = class extends Shape {
  width: int64;
  height: int64;

  fn Init(w: int64, h: int64) {
    self.width := w;
    self.height := h;
  }

  override fn area(): int64 {
    return self.width * self.height;
  }
};

fn main(): int64 {
  var r: Rectangle := new Rectangle();
  r.Init(5, 3);
  var s: Shape := r;
  var a: int64 := s.area();
  Print("Rectangle area: "); PrintInt(a); Print("\n");
  // #1150: Der Test druckte nur. Jetzt urteilt er selbst — 5 * 3 = 15.
  if a == 15 { PrintLn("PASS vmt_abstract"c); } else { PrintLn("FAIL vmt_abstract"c); }
  dispose s;
  return 0;
}