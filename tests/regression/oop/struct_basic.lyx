// examples/struct_basic.lyx - Basic struct usage example
// Demonstrates struct definition, literals, field access and assignment

type Point = struct {
  x: int64;
  y: int64;
};

type Rect = struct {
  left: int64;
  top: int64;
  right: int64;
  bottom: int64;
};

fn main(): int64 {
  // Test 1: Basic struct literal and field access
  var p: Point;
  p.x := 10;
  p.y := 20;
  PrintInt(p.x);  // Expected: 10
  PrintInt(p.y);  // Expected: 20

  // Test 2: Field assignment
  p.x := 42;
  PrintInt(p.x);  // Expected: 42

  // Test 3: Using struct fields in expressions
  var sum: int64 := p.x + p.y;
  PrintInt(sum);  // Expected: 62 (42 + 20)

  // Test 4: Larger struct with more fields
  var r: Rect;
  r.left := 0;
  r.top := 0;
  r.right := 100;
  r.bottom := 50;
  PrintInt(r.right - r.left);   // Expected: 100
  PrintInt(r.bottom - r.top);   // Expected: 50

  return 0;
}
