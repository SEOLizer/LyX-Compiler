// Debug IPPack calculation step by step

fn main(): int64 {
  var a: uint8 := 192;
  var b: uint8 := 168;
  var c: uint8 := 1;
  var d: uint8 := 1;
  
  var part1: int64 := (a as int64) << 24;
  var part2: int64 := (b as int64) << 16;
  var part3: int64 := (c as int64) << 8;
  var part4: int64 := (d as int64);
  
  Print("a = "); PrintInt(a as int64); Print("\n");
  Print("b = "); PrintInt(b as int64); Print("\n");
  Print("c = "); PrintInt(c as int64); Print("\n");
  Print("d = "); PrintInt(d as int64); Print("\n");
  
  Print("(a as int64) = "); PrintInt(a as int64); Print("\n");
  Print("(a as int64) << 24 = "); PrintInt(part1); Print("\n");
  Print("(b as int64) = "); PrintInt(b as int64); Print("\n");
  Print("(b as int64) << 16 = "); PrintInt(part2); Print("\n");
  Print("(c as int64) = "); PrintInt(c as int64); Print("\n");
  Print("(c as int64) << 8 = "); PrintInt(part3); Print("\n");
  Print("(d as int64) = "); PrintInt(part4); Print("\n");
  
  var result: int64 := part1 | part2 | part3 | part4;
  Print("result = "); PrintInt(result); Print("\n");
  
  return 0;
}
