// Test: uint8 to int64 cast in function return

fn testCast(x: uint8): int64 {
  return x as int64;
}

fn main(): int64 {
  var val: uint8 := 192;
  var result: int64 := testCast(val);
  
  Print("result = ");
  PrintInt(result);
  Print("\n");
  
  // #1150: Ergebnis geprueft drucken statt es im Exit-Code zu tragen.
  if (result == 192) { PrintLn("PASS"); } else { PrintLn("FAIL"); }
  return 0;
}
