import src.std.io;

fn test_widths(): int64 {
  var a: int8 := 130;      // wird beim Speichern auf 8 Bit gekuerzt: -126
  var b: uint8 := 250;    // vorzeichenlose 8 Bit
  var x: int64 := a + b;   // Arithmetik auf 64 Bit erweitert: -126 + 250 = 124
  PrintLn(x);
  return x;
}

fn main(): int64 {
  test_widths();
  return 0;
}
