// Test Statistics & Aggregation Module
//
// #1344: Dieser Test rief die stats-API mit EINEM Argument (`ArraySum(arr)`),
// waehrend sie durchgehend `(zeiger, anzahl)` nimmt. Er stand deshalb in
// tests/suite-broken.txt. Zwei Dinge waren falsch, nicht eines:
//
//   1. Die Stelligkeit — sichtbar geworden durch die Pruefung ueber
//      Unit-Grenzen (#1264).
//   2. Die ADRESSE. Ein Lyx-Array ist ein Zeiger auf {cap, len}, die Elemente
//      liegen dahinter. `ArraySum(arr)` haette also den Kopf mitgelesen, selbst
//      wenn die Stelligkeit gestimmt haette. Richtig ist `arr.data` — das
//      ueberspringt den Kopf — zusammen mit `len(arr)`.
//
// Ausserdem rief der Test drei Dinge, die es in std/stats.lyx nicht gibt:
// `ArrayReverse` und `ArrayFilterGt` (keine Funktionen dieser Unit) und
// `ArraySort` als RUECKGABEfunktion, obwohl sie an Ort und Stelle sortiert.
// Sie sind hier durch das ersetzt, was die Unit wirklich anbietet.
//
// Erfolgskonvention: 0 = alles bestanden, sonst die Anzahl der Abweichungen.

import std.io;
import std.stats;

var fehler: int64 := 0;

fn pruefe(name: pchar, ist: int64, soll: int64): void {
  if (ist == soll) {
    PrintStr("PASS "); PrintLn(name);
  } else {
    PrintStr("FAIL "); PrintStr(name);
    PrintStr(": "); PrintStr(IntToStr(ist));
    PrintStr(" erwartet "); PrintLn(IntToStr(soll));
    fehler := fehler + 1;
  }
}

fn main(): int64 {
  var arr: array := [10, 20, 30, 40, 50];
  var p: int64 := arr.data as int64;
  var n: int64 := len(arr);

  pruefe("ArraySum"c,      ArraySum(p, n),      150);
  pruefe("ArrayMin"c,      ArrayMin(p, n),      10);
  pruefe("ArrayMax"c,      ArrayMax(p, n),      50);
  pruefe("ArrayAvg"c,      ArrayAvg(p, n),      30);
  pruefe("ArrayCount"c,    ArrayCount(p, n),    5);
  pruefe("ArrayRange"c,    ArrayRange(p, n),    40);
  pruefe("ArraySumSquares"c, ArraySumSquares(p, n), 5500);

  // Varianz von [10,20,30,40,50] um den Mittelwert 30:
  // (400 + 100 + 0 + 100 + 400) / 5 = 200; Wurzel daraus ganzzahlig 14.
  pruefe("ArrayVariance"c, ArrayVariance(p, n), 200);
  pruefe("ArrayStdDev"c,   ArrayStdDev(p, n),   14);

  // Produkt einer kleineren Reihe, damit der Wert lesbar bleibt.
  var klein: array := [2, 3, 4];
  pruefe("ArrayProduct"c,  ArrayProduct(klein.data as int64, len(klein)), 24);

  // Zugriff auf Raender und Suche.
  pruefe("ArrayFirst"c,    ArrayFirst(p, n, 0 - 1),  10);
  pruefe("ArrayLast"c,     ArrayLast(p, n, 0 - 1),   50);
  pruefe("ArrayIndexOf"c,  ArrayIndexOf(p, n, 30),   2);
  pruefe("ArrayLastIndexOf"c, ArrayLastIndexOf(p, n, 30), 2);

  // Ein Wert, den es nicht gibt: -1, nicht 0 — sonst waere er von Index 0
  // nicht zu unterscheiden.
  pruefe("ArrayIndexOf (fehlt)"c, ArrayIndexOf(p, n, 99), 0 - 1);

  var mehrfach: array := [1, 2, 2, 3, 2, 4];
  var pm: int64 := mehrfach.data as int64;
  var nm: int64 := len(mehrfach);
  pruefe("ArrayCountValue"c, ArrayCountValue(pm, nm, 2), 3);
  if (ArrayContains(pm, nm, 3)) { pruefe("ArrayContains (vorhanden)"c, 1, 1); }
  else { pruefe("ArrayContains (vorhanden)"c, 0, 1); }
  if (ArrayContains(pm, nm, 9)) { pruefe("ArrayContains (fehlt)"c, 1, 0); }
  else { pruefe("ArrayContains (fehlt)"c, 0, 0); }

  // ArraySort sortiert AN ORT UND STELLE und liefert nichts zurueck.
  var unsortiert: array := [50, 10, 40, 20, 30];
  var pu: int64 := unsortiert.data as int64;
  ArraySort(pu, len(unsortiert));
  pruefe("ArraySort: kleinstes vorn"c, ArrayFirst(pu, len(unsortiert), 0 - 1), 10);
  pruefe("ArraySort: groesstes hinten"c, ArrayLast(pu, len(unsortiert), 0 - 1), 50);

  // Median sortiert ebenfalls an Ort und Stelle; bei fuenf Werten der dritte.
  var fuer_median: array := [7, 1, 5, 3, 9];
  pruefe("ArrayMedian"c, ArrayMedian(fuer_median.data as int64, len(fuer_median)), 5);

  // Leere Reihe: die Funktionen muessen 0 liefern statt zu rechnen.
  pruefe("ArraySum (leer)"c,   ArraySum(p, 0),   0);
  pruefe("ArrayAvg (leer)"c,   ArrayAvg(p, 0),   0);
  pruefe("ArrayMedian (leer)"c, ArrayMedian(p, 0), 0);

  PrintStr("--- Abweichungen: "); PrintLn(IntToStr(fehler));
  return fehler;
}
