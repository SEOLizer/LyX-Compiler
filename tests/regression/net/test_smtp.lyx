// Test SMTP Client
// Demonstrates SMTP protocol flow without actually sending email

import std.net.smtp;

fn main(): int64 {
  Print("Testing SMTP client...\n");
  
  // Test 1: Build EHLO command
  Print("Test 1: Build EHLO command\n");
  var ehloCmd: int64 := SMTPBuildEhlo("localhost"c as int64);
  if (ehloCmd != 0) {
    Print("  EHLO: ");
    sys_write(1, ehloCmd, 20);
    Print("...\n");
    munmap(ehloCmd, 256);
  }
  
  // Test 2: Build MAIL FROM command
  Print("Test 2: Build MAIL FROM command\n");
  var mailCmd: int64 := SMTPBuildMailFrom("test@example.com"c as int64);
  if (mailCmd != 0) {
    Print("  MAIL FROM: ");
    sys_write(1, mailCmd, 30);
    Print("...\n");
    munmap(mailCmd, 512);
  }
  
  // Test 3: Build RCPT TO command
  Print("Test 3: Build RCPT TO command\n");
  var rcptCmd: int64 := SMTPBuildRcptTo("user@example.com"c as int64);
  if (rcptCmd != 0) {
    Print("  RCPT TO: ");
    sys_write(1, rcptCmd, 30);
    Print("...\n");
    munmap(rcptCmd, 512);
  }
  
  // Test 4: Build email message
  Print("Test 4: Build email message\n");
  var email: SMTPEmail;
  email.from := "sender@example.com";
  email.toAddr := "recipient@example.com";
  email.subject := "Test from Lyx";
  email.body := "Hello from the Lyx SMTP client!";
  
  var msg: int64 := SMTPBuildMessage(email);
  if (msg != 0) {
    var msgLen: int64 := SMTPStrLen(msg);
    Print("  Message length: ");
    PrintInt(msgLen);
    Print(" bytes\n");
    sys_write(1, msg, msgLen);
    munmap(msg, 8192);
  }
  
  // Test 5: Connect to SMTP server (if available)
  // This test connects to a real SMTP server
  // Uncomment and set your SMTP server details:
  /*
  Print("\nTest 5: Connect to SMTP server\n");
