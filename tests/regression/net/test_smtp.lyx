    Print("  QUIT response: ");
    PrintInt(code);
    Print("\n");
    
    SMTPClose(conn);
  } else {
    Print("  Connection failed (expected in test environment)\n");
  }
  */
  
  Print("\nAll tests completed!\n");
  return 0;
}
