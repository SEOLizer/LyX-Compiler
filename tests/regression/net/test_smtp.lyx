  if (conn.connected == 1) {
    Print("  Connected!\n");
    
    // EHLO
    var code: int64 := SMTPEhlo(conn, 0);
    Print("  EHLO response: ");
    PrintInt(code);
    Print("\n");
    
    // Send email
    code := SMTPSend(conn, email);
    Print("  SMTP send result: ");
    PrintInt(code);
    Print("\n");
    
    // QUIT
