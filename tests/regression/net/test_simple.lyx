// Simple Network Test
// Tests basic socket creation

pub fn main() {
  Print("=== Simple Network Test ===\n");
  
  // Just test IPPack
  var ip: int64 := (192 << 24) | (168 << 16) | (1 << 8) | 1;
  Print("IP: ");
  PrintInt((ip >> 24) & 0xFF);
  Print(".");
  PrintInt((ip >> 16) & 0xFF);
  Print(".");
  PrintInt((ip >> 8) & 0xFF);
  Print(".");
  PrintInt(ip & 0xFF);
  Print("\n");
  
  Print("Test complete!\n");
}
