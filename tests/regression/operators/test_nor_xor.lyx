// NOR (`|~`) und XOR (`^`).
//
// #1819: Diese Datei schrieb frueher `~|` — die Zeichen in der falschen
// Reihenfolge; der Operator heisst `|~` (ebnf.md §1143). Und sie erwartete
// LOGISCHES NOR auf `bool`. Das gibt es in Lyx nicht: `|~` ist BITWEISES NOR,
// `a |~ b` = `~(a | b)`. Auf Wahrheitswerten ist `true |~ false` deshalb
// `~1 = -2` — ungleich 0 und damit WAHR, nicht falsch. Wer logisches NOR
// braucht, schreibt `not (a or b)`.
//
// Gemessen wird darum beides getrennt: der Bitoperator auf int64 mit
// nachgerechneten Werten, das logische NOR als Ausdruck aus `not`/`or`.

fn main(): int64 {
  // XOR auf Bits: 12 ^ 10 = 6
  var x: int64 := 12 ^ 10;
  if (x != 6) { return 1; }

  // NOR auf Bits: ~(12 | 10) = ~14 = -15
  var n: int64 := 12 |~ 10;
  if (n != 0 - 15) { return 2; }

  // ~(0 | 0) = -1 — alle Bits gesetzt.
  var alle: int64 := 0 |~ 0;
  if (alle != 0 - 1) { return 3; }

  // XOR auf bool: hier verhaelt sich `^` wie erwartet (0/1 bleiben 0/1).
  var a: bool := true;
  var b: bool := false;
  if (!(a ^ b)) { return 4; }
  if (a ^ a)    { return 5; }

  // Logisches NOR gibt es nur als Ausdruck.
  if (not (a or b))  { return 6; }   // true or false -> false
  if (!(not (b or b))) { return 7; } // false or false -> true

  // Gegenprobe zur Falle oben: `|~` auf bool ist NICHT logisches NOR.
  // true |~ false = ~1 = -2, also wahr.
  var falle: int64 := 1 |~ 0;
  if (falle != 0 - 2) { return 8; }

  Print("OK: NOR und XOR\n"c);
  return 0;
}
