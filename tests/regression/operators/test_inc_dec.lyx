var globalCounter: int64 := 0;

fn tick() {
  globalCounter++;
}

fn tock() {
  globalCounter--;
}

fn main(): int64 {
  Print("Initial: ");
  PrintInt(globalCounter);
  Print("\n");
  
  tick();
  tick();
  tick();
  Print("After 3 ticks: ");
  PrintInt(globalCounter);
  Print("\n");
  
  tock();
  Print("After 1 tock: ");
  PrintInt(globalCounter);
  Print("\n");
  
  return 0;
}
