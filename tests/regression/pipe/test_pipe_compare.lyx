fn double(x: int64): int64 {
  return x * 2;
}

fn addOne(x: int64): int64 {
  return x + 1;
}

fn main(): int64 {
  var x: int64 := 5;
  
  var pipeResult: int64 := x |> double() |> addOne();
  var classicResult: int64 := addOne(double(x));
  
  Print("Pipe:     5 |> double |> addOne = ");
  PrintInt(pipeResult);
  Print("\n");
  
  Print("Classic:  addOne(double(5)) = ");
  PrintInt(classicResult);
  Print("\n");
  
  if (pipeResult == classicResult) {
    Print("Both are equal!\n");
  } else {
    Print("ERROR: Results differ!\n");
  }
  
  return 0;
}
