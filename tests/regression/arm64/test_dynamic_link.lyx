// Test ARM64 Dynamic Linking
// #1179: Hier fehlte die link-Klausel — ausgerechnet in dem Test, der das
// dynamische Linken prueft. Das Symbol wurde nie gebunden, `strlen` lieferte
// still 0, und der Test war trotzdem gruen.
extern fn strlen(str: pchar): int64 link "libc.so.6";

fn main(): int64 {
  var msg: pchar := "Hello ARM64!";
  var len: int64 := strlen(msg);
  Print("Message: ");
  Print(msg);
  Print("\nLength: ");
  PrintInt(len);
  Print("\n");
  return 0;
}
