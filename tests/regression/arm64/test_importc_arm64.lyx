// Dasselbe auf ARM64: eine C-Funktion aus libc, dynamisch gebunden (PLT/GOT).
//
// #1819: stand frueher als `importC "string.h" link "libc.so.6"` da — eine
// Schreibweise, die es nie gab. Uebersetzt wird diese Datei mit
// --target=arm64; gemessen wird der Rueckgabewert, nicht die Ausgabe.
extern fn strlen(s: pchar): int64 link "libc.so.6";

fn main(): int64 {
  var s: pchar := "extern on ARM64!"c;
  var n: int64 := strlen(s);
  if (n != 16) { return 1; }
  return 0;
}
