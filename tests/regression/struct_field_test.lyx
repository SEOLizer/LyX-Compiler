// tests/lyx/struct_field_test.lyx
// Minimaler Test fuer Struct-Feldzugriff

type TPoint = struct {
  x: int64;
  y: int64;
};

fn main(): int64 {
  // Test 1: Struct erstellen und Feld lesen
  var p: TPoint;
  p.x := 42;
  p.y := 100;
  
  // Test 2: Direkter Feldzugriff (CRASH?)
  var xVal: int64 := p.x;
  var yVal: int64 := p.y;
  
  Print("x = ");
  PrintInt(xVal);
  Print("\ny = ");
  PrintInt(yVal);
  Print("\n");
  
  return 0;
}
