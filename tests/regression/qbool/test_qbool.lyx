// test_qbool.lyx
// Test file for QBool probabilistic type

import std.qbool;
import std.io;

fn test_basic(): void {
  Print("=== Test: Basic QBool Operations ===\n");
  
  // Create QBools with different probabilities
  var likely_true: QBool := Maybe(0.8);
  var likely_false: QBool := Maybe(0.2);
  var uncertain: QBool := Maybe(0.5);
  
  Print("likely_true probability: ");
  PrintFloat(GetProbability(likely_true));
  Print("\n");
  
  Print("likely_false probability: ");
  PrintFloat(GetProbability(likely_false));
  Print("\n");
  
  // Test NOT operator
  var not_likely: QBool := QBoolNot(likely_true);
  Print("NOT likely_true probability: ");
  PrintFloat(GetProbability(not_likely));
  Print("\n");
}

fn test_logical(): void {
  Print("\n=== Test: Logical Operators ===\n");
  
  var a: QBool := Maybe(0.7);
  var b: QBool := Maybe(0.4);
  
  var and_result: QBool := QBoolAnd(a, b);
  var or_result: QBool := QBoolOr(a, b);
  var xor_result: QBool := QBoolXor(a, b);
  
  Print("A = 0.7, B = 0.4\n");
  Print("A AND B = ");
  PrintFloat(GetProbability(and_result));
  Print(" (expected: 0.28)\n");
  
  Print("A OR B = ");
  PrintFloat(GetProbability(or_result));
  Print(" (expected: 0.82)\n");
  
  Print("A XOR B = ");
  PrintFloat(GetProbability(xor_result));
  Print(" (expected: 0.54)\n");
}

fn test_observe(): void {
  Print("\n=== Test: Observe (Collapse) ===\n");
  
  var q: QBool := Maybe(0.5);
  
  // Observe multiple times - should give roughly 50% true
  var true_count: int64 := 0;
  var false_count: int64 := 0;
  var i: int64 := 0;
  
  while (i < 100) {
    if (Observe(q)) {
      true_count := true_count + 1;
    } else {
      false_count := false_count + 1;
    }
    i := i + 1;
  }
  
  Print("Observed 100 times:\n");
  Print("  True: ");
  PrintInt(true_count);
  Print("\n");
  Print("  False: ");
  PrintInt(false_count);
  Print("\n");
}

// #1150: test_entanglement() rief EntangledPair/Entangle/ObserveA/ObserveB —
// diese API gibt es in std.qbool nicht. Der Abschnitt ist entfernt.

fn test_ai_decision(): void {
  Print("\n=== Test: AI Decision Making ===\n");
  
  // Weather prediction
  RandomSeed(42);
  var take_umbrella: bool := WeatherPrediction(0.3, 0.7);
  Print("Weather decision (sunny=0.3, rain=0.7): ");
  if (take_umbrella) { Print("Take umbrella\n"); } else { Print("No umbrella\n"); }
  
  // Medical diagnosis
  var is_sick: bool := Diagnose(0.8, 0.6, 0.7);
  Print("Diagnosis (fever=0.8, cough=0.6, fatigue=0.7): ");
  if (is_sick) { Print("Probably sick\n"); } else { Print("Probably okay\n"); }
}

fn main(): int64 {
  test_basic();
  test_logical();
  test_observe();
  test_ai_decision();
  
  Print("\n=== All tests completed ===\n");
  return 0;
}
