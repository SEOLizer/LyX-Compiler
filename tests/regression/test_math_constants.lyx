// Test Mathematical Constants Module
// Verifies constant values and conversion functions

import std.math.constants;

fn main(): int64 {
  Print("Testing Mathematical Constants...\n");
  
  // Test 1: Circle Constants
  Print("Test 1: Circle Constants\n");
  Print("  PI = ");
  PrintFloat(PI);
  Print("\n");
  
  Print("  TAU = ");
  PrintFloat(TAU);
  Print("\n");
  
  Print("  TAU / PI = ");
  PrintFloat(TAU / PI);
  Print(" (expected ~2.0)\n");
  
  Print("  HALF_PI = ");
  PrintFloat(HALF_PI);
  Print("\n");
  
  Print("  INV_PI = ");
  PrintFloat(INV_PI);
  Print("\n");
  
  // Test 2: Euler's Number
  Print("Test 2: Euler's Number\n");
  Print("  E = ");
  PrintFloat(E);
  Print("\n");
  
  Print("  INV_E = ");
  PrintFloat(INV_E);
  Print("\n");
  
  Print("  E * INV_E = ");
  PrintFloat(E * INV_E);
  Print(" (expected ~1.0)\n");
  
  // Test 3: Golden Ratio
  Print("Test 3: Golden Ratio\n");
  Print("  PHI = ");
  PrintFloat(PHI);
  Print("\n");
  
  Print("  INV_PHI = ");
  PrintFloat(INV_PHI);
  Print("\n");
  
  Print("  PHI * INV_PHI = ");
  PrintFloat(PHI * INV_PHI);
  Print(" (expected ~1.0)\n");
  
  Print("  PHI² = ");
  PrintFloat(PHI_SQUARED);
  Print(" (expected ~2.618)\n");
  
  // Test 4: Square Roots
  Print("Test 4: Square Roots\n");
  Print("  SQRT2 = ");
  PrintFloat(SQRT2);
  Print("\n");
  
  Print("  SQRT3 = ");
  PrintFloat(SQRT3);
  Print("\n");
  
  Print("  SQRT5 = ");
  PrintFloat(SQRT5);
  Print("\n");
  
  Print("  SQRT2 * SQRT2 = ");
  PrintFloat(SQRT2 * SQRT2);
  Print(" (expected ~2.0)\n");
  
  Print("  SQRT3 * SQRT3 = ");
  PrintFloat(SQRT3 * SQRT3);
  Print(" (expected ~3.0)\n");
  
  Print("  INV_SQRT2 = ");
  PrintFloat(INV_SQRT2);
  Print("\n");
  
  // Test 5: Logarithm Constants
  Print("Test 5: Logarithm Constants\n");
  Print("  LN2 = ");
  PrintFloat(LN2);
  Print("\n");
  
  Print("  LN10 = ");
  PrintFloat(LN10);
  Print("\n");
  
  Print("  LOG2E = ");
  PrintFloat(LOG2E);
  Print("\n");
  
  Print("  LOG10E = ");
  PrintFloat(LOG10E);
  Print("\n");
  
  // Test 6: Degree/Radian Conversion
  Print("Test 6: Degree/Radian Conversion\n");
  Print("  DegToRad(180) = ");
  PrintFloat(DegToRad(180.0));
  Print(" (expected ~3.14159)\n");
  
  Print("  RadToDeg(PI) = ");
  PrintFloat(RadToDeg(PI));
  Print(" (expected ~180.0)\n");
  
  Print("  DegToRad(90) = ");
  PrintFloat(DegToRad(90.0));
  Print(" (expected ~1.5708)\n");
  
  Print("  DegToRad(360) = ");
  PrintFloat(DegToRad(360.0));
  Print(" (expected ~6.2832)\n");
  
  // Test 7: Machine Constants
  Print("Test 7: Machine Constants\n");
  Print("  EPSILON = ");
  PrintFloat(EPSILON);
  Print("\n");
  
  Print("  MAX_SAFE_INT = ");
  PrintInt(MAX_SAFE_INT);
  Print("\n");
  
  // Test 8: Approximate Equality
  Print("Test 8: Approximate Equality\n");
  Print("  ApproxEqual(PI, 3.14159265, EPSILON) = ");
  if (ApproxEqual(PI, 3.14159265, EPSILON)) {
    Print("true")
  } else {
    Print("false")
  }
  Print("\n");
  
  Print("  ApproxZero(0.000000001, EPSILON) = ");
  if (ApproxZero(0.000000001, EPSILON)) {
    Print("true")
  } else {
    Print("false")
  }
  Print("\n");
  
  Print("  ApproxOne(0.999999999999999, EPSILON) = ");
  if (ApproxOne(0.999999999999999, EPSILON)) {
    Print("true")
  } else {
    Print("false")
  }
  Print("\n");
  
  Print("\nAll tests completed!\n");
  return 0;
}
