var counter: int64 := 0;
var total: int64 := 100;

fn add(val: int64) {
  counter := counter + val;
  total := total + val;
}

fn main(): int64 {
  Print("Initial:\n");
  Print("  counter = ");
  PrintInt(counter);
  Print("\n");
  Print("  total = ");
  PrintInt(total);
  Print("\n");
  
  add(10);
  add(20);
  add(5);
  
  Print("After adds:\n");
  Print("  counter = ");
  PrintInt(counter);
  Print("\n");
  Print("  total = ");
  PrintInt(total);
  Print("\n");
  
  return 0;
}
