fn main(): int64 {
    // Test StrLen on literal
    var len: int64 := StrLen("Hello");
    Print("StrLen(Hello) = "); PrintInt(len); Print("\n");

    // Test StrCharAt
    var c: int64 := StrCharAt("ABC", 0);
    Print("StrCharAt(ABC,0) = "); PrintInt(c); Print("\n");

    // Test StrNew + StrSetChar + Print
    var s: pchar := StrNew(16);
    StrSetChar(s, 0, 72);   // 'H'
    StrSetChar(s, 1, 105);  // 'i'
    StrSetChar(s, 2, 0);    // null terminator
    Print(s); Print("\n");
    StrFree(s);

    // Test StrAppend
    var a: pchar := StrNew(32);
    var b: pchar := StrAppend(a, "Hello");
    var c2: pchar := StrAppend(b, " World");
    Print(c2); Print("\n");
    StrFree(c2);

    // Test StrFromInt
    var ns: pchar := StrFromInt(42);
    Print("StrFromInt(42) = "); Print(ns); Print("\n");
    StrFree(ns);

    var ns2: pchar := StrFromInt(-7);
    Print("StrFromInt(-7) = "); Print(ns2); Print("\n");
    StrFree(ns2);

    return 0;
}
