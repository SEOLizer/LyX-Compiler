// Test für String-Builtins
fn main(): int64 {
  // Test 1: StrLength
  var len: int64 := StrLength("Hello");
  Print("Length of Hello: ");
  PrintInt(len);
  Print("\n");
  
  // Test 2: StrCharAt
  var c: int64 := StrCharAt("Hello", 1);
  Print("Second character of Hello: ");
  PrintInt(c);
  Print(" (ASCII)\n");
  
  // Test 3: str_compare
  var cmp: int64 := str_compare("abc", "abc");
  Print("Compare abc with abc: ");
  PrintInt(cmp);
  Print(" (should be 0)\n");
  
  var cmp2: int64 := str_compare("abc", "def");
  Print("Compare abc with def: ");
  PrintInt(cmp2);
  Print(" (should be negative)\n");
  
  return 0;
}