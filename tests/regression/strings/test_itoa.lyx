// #1820: rief itoa_to_buf auf — eine Funktion, die es nie gab — und schrieb
// dabei in ein String-LITERAL. Beides zusammen war doppelt kaputt: der Name
// fehlte, und der Puffer waere Speicherkorruption gewesen (siehe CLAUDE.md,
// „String-Literale sind keine Schreibpuffer"). Die Funktion heisst jetzt
// IntToStrPadIn und steht in src.std.string_in; der Puffer kommt aus alloc().
import src.std.string_in;
import src.std.alloc;

fn main(argc: int64, argv: pchar): int64 {
  var buf: int64 := alloc(64);
  if (buf == 0) { Print("ERR alloc\n"); return 1; }

  // -42 auf Mindestbreite 6, mit Nullen gefuellt -> "-00042"
  var r: int64 := IntToStrPadIn(0 - 42, buf, 0, 64, 6, 1);
  if (r < 0) { Print("ERR\n"); return 1; }
  Print(buf as pchar);
  Print("\n");

  // Dasselbe mit Leerzeichen: das Vorzeichen steht direkt vor der Zahl.
  var r2: int64 := IntToStrPadIn(0 - 42, buf, 0, 64, 6, 0);
  if (r2 < 0) { Print("ERR\n"); return 1; }
  Print(buf as pchar);
  Print("\n");

  // Ohne Fuellung, wenn die Zahl schon breiter ist als gefordert.
  var r3: int64 := IntToStrPadIn(123456, buf, 0, 64, 3, 1);
  if (r3 < 0) { Print("ERR\n"); return 1; }
  Print(buf as pchar);
  Print("\n");

  // Zu kleiner Puffer meldet -1 und schreibt nichts.
  if (IntToStrPadIn(123456, buf, 0, 4, 0, 0) != (0 - 1)) { Print("ERR klein\n"); return 1; }

  return 0;
}
