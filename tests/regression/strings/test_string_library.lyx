// Test für String-Library Functions
import std.string;

fn main(): int64 {
  Print("=== String Library Tests ===\n");
  
  // Test 1: Character conversion
  Print("Test 1: Character conversion\n");
  var lower_a: int64 := CharToLower(65);  // 'A' -> 'a'
  var upper_z: int64 := CharToUpper(122); // 'z' -> 'Z'
  Print("'A' to lower: ");
  PrintInt(lower_a);
  Print(" (should be 97)\n");
  Print("'z' to upper: ");
  PrintInt(upper_z);
  Print(" (should be 90)\n\n");
  
  // Test 2: Whitespace detection
  Print("Test 2: Whitespace detection\n");
  var is_space: bool := IsWhitespace(32);   // space
  var is_tab: bool := IsWhitespace(9);     // tab
  var is_a: bool := IsWhitespace(65);      // 'A'
  Print("Space is whitespace: ");
  if (is_space) { Print("true"); } else { Print("false"); }
  Print("\nTab is whitespace: ");
  if (is_tab) { Print("true"); } else { Print("false"); }
  Print("\n'A' is whitespace: ");
  if (is_a) { Print("true"); } else { Print("false"); }
  Print("\n\n");
  
  // Test 3: Safe character access
  Print("Test 3: Safe character access\n");
  var valid_char: int64 := StrSafeCharAt("Hello", 1);
  var invalid_char: int64 := StrSafeCharAt("Hello", 10);
  Print("StrSafeCharAt('Hello', 1): ");
  PrintInt(valid_char);
  Print("\nstr_safe_char_at('Hello', 10): ");
  PrintInt(invalid_char);
  Print(" (should be -1)\n");
  
  return 0;
}