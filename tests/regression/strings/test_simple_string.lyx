// Einfacher Test für String-Builtins
fn main(): int64 {
  // Test 1: StrLength
  var len: int64 := StrLength("Hello");
  Print("Length: ");
  PrintInt(len);
  Print("\n");
  
  // Test 2: StrCharAt 
  var c1: int64 := StrCharAt("Hello", 0);
  var c2: int64 := StrCharAt("Hello", 1);
  Print("First char: ");
  PrintInt(c1);
  Print(", Second char: ");
  PrintInt(c2);
  Print("\n");
  
  return 0;
}