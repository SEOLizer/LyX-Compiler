import std.math;
import std.prob;
import std.io;
// Comprehensive test for Math builtins
fn main(): int64 {
  Print("=== Math Builtin Tests ===\n");
  
  // Test 1: Integer absolute value
  Print("Test 1: Integer absolute value\n");
  var neg_val: int64 := -42;
  var pos_val: int64 := 37;
  Print("Abs(-42) = ");
  Print(Abs(neg_val));
  Print("\nabs(37) = ");
  Print(Abs(pos_val));
  Print("\n\n");
  
  // Test 2: Float absolute value
  Print("Test 2: Float absolute value\n");
  var neg_float: f64 := -3.14;
  var abs_result: f64 := AbsF64(neg_float);
  Print("AbsF64(-3.14) = ");
  PrintFloatLn(abs_result);
  Print("\n\n");
  
  // Test 3: Square root and square
  Print("Test 3: Square operations\n");
  var val: f64 := 4.0;
  var sqrt_result: f64 := SqrtF64(val);
  var square_result: f64 := Square(val);
  Print("SqrtF64(4.0) = ");
  PrintFloatLn(sqrt_result);
  Print("\nSquare(4.0) = ");
  PrintFloatLn(square_result);
  Print("\n\n");
  
  // Test 4: Rounding and truncation
  Print("Test 4: Rounding and truncation\n");
  var float_val: f64 := 3.7;
  var rounded: int64 := RoundF64(float_val);
  var truncated: int64 := TruncF64(float_val) as int64;
  Print("RoundF64(3.7) = ");
  Print(rounded);
  Print("\ntrunc(3.7) = ");
  Print(truncated);
  Print("\n\n");
  
  // Test 5: Fractional part
  Print("Test 5: Fractional part\n");
  var frac_val: f64 := 5.25;
  var frac_result: f64 := Frac(frac_val);
  Print("frac(5.25) = ");
  PrintFloatLn(frac_result);
  Print("\n\n");
  
  // Test 6: Pi constant
  Print("Test 6: Pi constant\n");
  var pi_val: f64 := Pi();
  Print("Pi() = ");
  PrintFloatLn(pi_val);
  Print("\n\n");
  
  // Test 7: Bit operations
  Print("Test 7: Bit operations\n");
  var test_val: int64 := 1311768467463790320;
  var high_bits: int64 := HiWord(test_val);
  var low_bits: int64 := LoWord(test_val);
  var swapped: int64 := SwapWords(test_val);
  Print("Original value (hex): ");
  Print(test_val);
  Print("\nhi() = ");
  Print(high_bits);
  Print("\nlo() = ");
  Print(low_bits);
  Print("\nswap() = ");
  Print(swapped);
  Print("\n\n");
  
  // Test 8: Odd/Even test
  Print("Test 8: Odd/Even test\n");
  var even_num: int64 := 42;
  var odd_num: int64 := 37;
  Print("odd(42) = ");
  if (Odd(even_num)) { Print("true"); } else { Print("false"); }
  Print("\nodd(37) = ");
  if (Odd(odd_num)) { Print("true"); } else { Print("false"); }
  Print("\n\n");
  
  // Test 9: Random number (simplified)
  Print("Test 9: Random number\n");
  var rand_val: f64 := ProbRandUniform();
  Print("ProbRandUniform() = ");
  PrintFloatLn(rand_val);
  Print("\n\n");
  
  // Test 10: Trigonometric functions (simplified)
  Print("Test 10: Trigonometric functions (simplified)\n");
  var angle: f64 := 1.0;
  var sin_result: f64 := SinF64(angle);
  var cos_result: f64 := CosF64(angle);
  Print("SinF64(1.0) = ");
  PrintFloatLn(sin_result);
  Print("\ncos(1.0) = ");
  PrintFloatLn(cos_result);
  Print("\n");
  
  Print("=== All Math tests completed! ===\n");
  
  return 0;
}