import std.math;
// Simple test for Math builtins (integer only)
fn main(): int64 {
  Print("=== Simple Math Builtin Tests ===\n");
  
  // Test 1: Integer absolute value
  Print("Test 1: Abs() function\n");
  var neg_val: int64 := -42;
  var pos_val: int64 := 37;
  var zero_val: int64 := 0;
  
  Print("Abs(-42) = ");
  PrintInt(Abs(neg_val));
  Print("\n");
  
  Print("Abs(37) = ");
  PrintInt(Abs(pos_val));
  Print("\n");
  
  Print("Abs(0) = ");
  PrintInt(Abs(zero_val));
  Print("\n\n");
  
  // Test 2: Odd/Even test
  Print("Test 2: IsOdd() function\n");
  var even_num: int64 := 42;
  var odd_num: int64 := 37;
  var zero_num: int64 := 0;
  
  Print("IsOdd(42) = ");
  if (IsOdd(even_num)) { Print("true"); } else { Print("false"); }
  Print("\n");
  
  Print("IsOdd(37) = ");
  if (IsOdd(odd_num)) { Print("true"); } else { Print("false"); }
  Print("\n");
  
  Print("IsOdd(0) = ");
  if (IsOdd(zero_num)) { Print("true"); } else { Print("false"); }
  Print("\n\n");
  
  // Test 3: Bit operations
  Print("Test 3: Bit operations\n");
  var test_val: int64 := 123456;
  
  Print("Original value: ");
  PrintInt(test_val);
  Print("\n");
  
  Print("hi(123456) = ");
  PrintInt(hi(test_val));
  Print("\n");
  
  Print("lo(123456) = ");
  PrintInt(lo(test_val));
  Print("\n");
  
  Print("swap(123456) = ");
  PrintInt(swap(test_val));
  Print("\n\n");
  
  Print("=== Simple Math tests completed! ===\n");
  
  return 0;
}