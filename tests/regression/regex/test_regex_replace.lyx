// test_regex_replace.lyx
// Teste RegexReplace (std.regex)
import std.regex;

fn main(): int64 {
  // Ersetze Pattern
  var count: int64 := RegexReplace(r"world", "hello world", "Lyx");
  Print("Ersetzungen fuer 'world' -> 'Lyx': ");
  PrintInt(count);
  Print("\n");

  if (count > 0) {
    Print("OK: Ersetzung durchgefuehrt\n");
  } else {
    Print("FAIL: Keine Ersetzung durchgefuehrt\n");
  }

  // Kein Match -> 0 Ersetzungen
  var count2: int64 := RegexReplace(r"xyz", "hello world", "foo");
  Print("Ersetzungen fuer 'xyz': ");
  PrintInt(count2);
  Print("\n");

  if (count2 == 0) {
    Print("OK: Keine Ersetzung wie erwartet\n");
  } else {
    Print("FAIL: Unerwartet Ersetzungen durchgefuehrt\n");
  }

  var outBuf: [64]char;
  var count3: int64 := RegexReplaceInto(outBuf, r"world", "hello world", "Lyx");
  Print("ReplaceInto: ");
  Print(outBuf);
  Print(" (count=");
  PrintInt(count3);
  Print(")\n");

  return 0;
}
