// #1299: Array-Literal als globaler Startwert.
//
// Der Test hat bis 1.0.15C 0/0/0 gedruckt und galt trotzdem als gruen: der
// Runner (tests/run_lyx_suite.sh) vergleicht die Ausgabe mit nichts. Ein
// stiller Nullwert war damit von einem richtigen Ergebnis nicht zu
// unterscheiden. Deshalb urteilt der Test jetzt SELBST und druckt PASS/FAIL —
// das ist die Sprache, die der Runner versteht.
import std.io;

var arr: array := [10, 20, 30];

fn main(): int64 {
  var bad: int64 := 0;
  if (arr[0] != 10) { PrintLn("FAIL arr[0]"); bad := 1; }
  if (arr[1] != 20) { PrintLn("FAIL arr[1]"); bad := 1; }
  if (arr[2] != 30) { PrintLn("FAIL arr[2]"); bad := 1; }
  if (bad == 0) { PrintLn("PASS globales Array-Literal"); }
  return bad;
}
