// Test Luhn/Credit Card Validation Module
// Demonstrates Luhn algorithm, card type detection, and formatting

import std.validate.luhn;

fn main(): int64 {
  Print("Testing Luhn/Credit Card Module...\n");
  
  // Test 1: Luhn Validation
  Print("Test 1: Luhn Validation\n");
  var valid: int64 := LuhnValidate("4532015112830366");
  Print("  4532015112830366 -> ");
  if (valid == 1) {
    Print("VALID")
  } else {
    Print("INVALID")
  }
  Print("\n");
  
  valid := LuhnValidate("4532015112830367");
  Print("  4532015112830367 -> ");
  if (valid == 1) {
    Print("VALID")
  } else {
    Print("INVALID")
  }
  Print("\n");
  
  // Test 2: Luhn Check Digit
  Print("Test 2: Luhn Check Digit\n");
  var check: int64 := LuhnCheckDigit("7992739871");
  Print("  7992739871 -> check digit: ");
  PrintInt(check);
  Print(" (expected: 3)\n");
  
  // Test 3: Credit Card Type Detection
  Print("Test 3: Credit Card Type Detection\n");
  var t: int64 := CreditCardType("4532015112830366");
  Print("  4532... -> ");
  sys_write(1, CreditCardTypeName(t), 20);
  Print("\n");
  
  t := CreditCardType("5425233430109903");
  Print("  5425... -> ");
  sys_write(1, CreditCardTypeName(t), 20);
  Print("\n");
  
  t := CreditCardType("374245455400126");
  Print("  3742... -> ");
  sys_write(1, CreditCardTypeName(t), 20);
  Print("\n");
  
  t := CreditCardType("6011111111111117");
  Print("  6011... -> ");
  sys_write(1, CreditCardTypeName(t), 20);
  Print("\n");
  
  // Test 4: Credit Card Validation
  Print("Test 4: Credit Card Validation\n");
  valid := CreditCardValidate("4532015112830366");
  Print("  4532015112830366 -> ");
  if (valid == 1) {
    Print("VALID CARD")
  } else {
    Print("INVALID")
  }
  Print("\n");
  
  // Test 5: Credit Card Formatting
  Print("Test 5: Credit Card Formatting\n");
  var formatted: int64 := CreditCardFormat("4532015112830366");
  if (formatted != 0) {
    Print("  4532015112830366 -> ");
    sys_write(1, formatted, 19);
    Print("\n");
    munmap(formatted, 20);
  }
  
  // Test 6: Credit Card Masking
  Print("Test 6: Credit Card Masking\n");
  var masked: int64 := CreditCardMask("4532015112830366");
  if (masked != 0) {
    Print("  4532015112830366 -> ");
    sys_write(1, masked, 19);
    Print("\n");
    munmap(masked, 20);
  }
  
  // Test 7: Generate Test Card Numbers
  Print("Test 7: Generate Test Card Numbers\n");
  var testVisa: int64 := CreditCardGenerateTest(CARD_VISA);
  if (testVisa != 0) {
    Print("  Visa test:   ");
    sys_write(1, testVisa, 16);
    Print(" (Luhn: ");
    if (LuhnValidate(testVisa as pchar) == 1) {
      Print("OK")
    } else {
      Print("FAIL")
    }
    Print(")\n");
    munmap(testVisa, 17);
  }
  
  var testAmex: int64 := CreditCardGenerateTest(CARD_AMEX);
  if (testAmex != 0) {
    Print("  Amex test:   ");
    sys_write(1, testAmex, 15);
    Print(" (Luhn: ");
    if (LuhnValidate(testAmex as pchar) == 1) {
      Print("OK")
    } else {
      Print("FAIL")
    }
    Print(")\n");
    munmap(testAmex, 16);
  }
  
  // Test 8: IMEI Validation
  Print("Test 8: IMEI Validation\n");
  valid := IMEIValidate("352099001761481");
  Print("  352099001761481 -> ");
  if (valid == 1) {
    Print("VALID IMEI")
  } else {
    Print("INVALID")
  }
  Print("\n");
  
  // Test 9: Luhn transposition detection
  Print("Test 9: Transposition Error Detection\n");
  valid := LuhnValidate("79927398713");
  Print("  79927398713 -> ");
  if (valid == 1) {
    Print("VALID")
  } else {
    Print("INVALID (transposition detected!)")
  }
  Print("\n");
  
  valid := LuhnValidate("79927398714");
  Print("  79927398714 -> ");
  if (valid == 1) {
    Print("VALID")
  } else {
    Print("INVALID (transposition detected!)")
  }
  Print("\n");
  
  Print("\nAll tests completed!\n");
  return 0;
}
