// Test VAT ID Validation Module
// Demonstrates EU VAT number validation

import std.validate.vat;

fn main(): int64 {
  Print("Testing VAT ID Validation Module...\n");
  
  // Test 1: German VAT (USt-IdNr.)
  Print("Test 1: German VAT\n");
  var valid: int64 := VATValidate("DE123456789");
  Print("  DE123456789 -> ");
  if (valid == 0) { Print("VALID") } else { Print("INVALID") }
  Print("\n");
  
  // Test 2: Austrian VAT (UID)
  Print("Test 2: Austrian VAT\n");
  valid := VATValidate("ATU12345678");
  Print("  ATU12345678 -> ");
  if (valid == 0) { Print("VALID") } else { Print("INVALID") }
  Print("\n");
  
  valid := VATValidate("AT123456789");
  Print("  AT123456789 (missing U) -> ");
  if (valid == 0) { Print("VALID") } else { Print("INVALID") }
  Print("\n");
  
  // Test 3: Belgian VAT
  Print("Test 3: Belgian VAT\n");
  valid := VATValidate("BE0123456749");
  Print("  BE0123456749 -> ");
  if (valid == 0) { Print("VALID") } else { Print("INVALID") }
  Print("\n");
  
  // Test 4: French VAT
  Print("Test 4: French VAT\n");
  valid := VATValidate("FR12345678901");
  Print("  FR12345678901 -> ");
  if (valid == 0) { Print("VALID") } else { Print("INVALID") }
  Print("\n");
  
  // Test 5: Italian VAT
  Print("Test 5: Italian VAT\n");
  valid := VATValidate("IT12345678901");
  Print("  IT12345678901 -> ");
  if (valid == 0) { Print("VALID") } else { Print("INVALID") }
  Print("\n");
  
  // Test 6: Spanish VAT
  Print("Test 6: Spanish VAT\n");
  valid := VATValidate("ESB12345678");
  Print("  ESB12345678 -> ");
  if (valid == 0) { Print("VALID") } else { Print("INVALID") }
  Print("\n");
  
  // Test 7: Dutch VAT
  Print("Test 7: Dutch VAT\n");
  valid := VATValidate("NL123456789B12");
  Print("  NL123456789B12 -> ");
  if (valid == 0) { Print("VALID") } else { Print("INVALID") }
  Print("\n");
  
  // Test 8: Polish VAT
  Print("Test 8: Polish VAT\n");
  valid := VATValidate("PL1234567890");
  Print("  PL1234567890 -> ");
  if (valid == 0) { Print("VALID") } else { Print("INVALID") }
  Print("\n");
  
  // Test 9: Swedish VAT
  Print("Test 9: Swedish VAT\n");
  valid := VATValidate("SE123456789001");
  Print("  SE123456789001 -> ");
  if (valid == 0) { Print("VALID") } else { Print("INVALID") }
  Print("\n");
  
  valid := VATValidate("SE123456789011");
  Print("  SE123456789011 (wrong ending) -> ");
  if (valid == 0) { Print("VALID") } else { Print("INVALID") }
  Print("\n");
  
  // Test 10: VAT name lookup
  Print("Test 10: VAT Name Lookup\n");
  var name: int64 := VATGetCountryName("DE") as int64;
  Print("  DE -> ");
  sys_write(1, name, 20);
  Print("\n");
  
  name := VATGetCountryName("AT") as int64;
  Print("  AT -> ");
  sys_write(1, name, 20);
  Print("\n");
  
  name := VATGetCountryName("FR") as int64;
  Print("  FR -> ");
  sys_write(1, name, 20);
  Print("\n");
  
  // Test 11: Format description
  Print("Test 11: Format Description\n");
  var fmt: int64 := VATGetFormat("DE") as int64;
  Print("  DE -> ");
  sys_write(1, fmt, 20);
  Print("\n");
  
  fmt := VATGetFormat("AT") as int64;
  Print("  AT -> ");
  sys_write(1, fmt, 20);
  Print("\n");
  
  Print("\nAll tests completed!\n");
  return 0;
}
