// Test EAN Validation Module
// Demonstrates EAN, ISBN, and UPC validation

import std.validate.ean;

fn main(): int64 {
  Print("Testing EAN Validation Module...\n");
  
  // Test 1: EAN-13 Validation
  Print("Test 1: EAN-13 Validation\n");
  
  var valid: int64 := EAN13Validate("4006381333931");
  Print("  4006381333931 -> ");
  if (valid == 0) {
    Print("VALID")
  } else {
    Print("INVALID (code ");
    PrintInt(valid);
    Print(")")
  }
  Print("\n");
  
  valid := EAN13Validate("4006381333930");
  Print("  4006381333930 -> ");
  if (valid == 0) {
    Print("VALID")
  } else {
    Print("INVALID (code ");
    PrintInt(valid);
    Print(")")
  }
  Print("\n");
  
  // Test 2: EAN-13 Check Digit
  Print("Test 2: EAN-13 Check Digit\n");
  var check: int64 := EAN13CheckDigit("400638133393");
  Print("  400638133393 -> check digit: ");
  PrintInt(check);
  Print("\n");
  
  // Test 3: EAN-8 Validation
  Print("Test 3: EAN-8 Validation\n");
  valid := EAN8Validate("96385074");
  Print("  96385074 -> ");
  if (valid == 0) {
    Print("VALID")
  } else {
    Print("INVALID")
  }
  Print("\n");
  
  // Test 4: ISBN-13 Validation
  Print("Test 4: ISBN-13 Validation\n");
  valid := ISBN13Validate("9783161484100");
  Print("  9783161484100 -> ");
  if (valid == 0) {
    Print("VALID")
  } else {
    Print("INVALID")
  }
  Print("\n");
  
  // Test 5: ISBN-10 Validation
  Print("Test 5: ISBN-10 Validation\n");
  valid := ISBN10Validate("0306406152");
  Print("  0306406152 -> ");
  if (valid == 0) {
    Print("VALID")
  } else {
    Print("INVALID")
  }
  Print("\n");
  
  valid := ISBN10Validate("030640615X");
  Print("  030640615X -> ");
  if (valid == 0) {
    Print("VALID")
  } else {
    Print("INVALID")
  }
  Print("\n");
  
  // Test 6: UPC-A Validation
  Print("Test 6: UPC-A Validation\n");
  valid := UPCAValidate("012345678905");
  Print("  012345678905 -> ");
  if (valid == 0) {
    Print("VALID")
  } else {
    Print("INVALID")
  }
  Print("\n");
  
  // Test 7: EAN-13 Formatting
  Print("Test 7: EAN-13 Formatting\n");
  var formatted: int64 := EAN13Format("4006381333931");
  if (formatted != 0) {
    Print("  Formatted: ");
    sys_write(1, formatted, 16);
    Print("\n");
    munmap(formatted, 16);
  }
  
  // Test 8: Country Detection
  Print("Test 8: Country Detection\n");
  var country: int64 := EAN13GetCountry("4006381333931") as int64;
  Print("  400... -> ");
  sys_write(1, country, 20);
  Print("\n");
  
  country := EAN13GetCountry("5901234123457") as int64;
  Print("  590... -> ");
  sys_write(1, country, 20);
  Print("\n");
  
  country := EAN13GetCountry("8401234567890") as int64;
  Print("  840... -> ");
  sys_write(1, country, 20);
  Print("\n");
  
  Print("\nAll tests completed!\n");
  return 0;
}
