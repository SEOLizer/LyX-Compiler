// simple_fs_test.lyx - Einfacher Filesystem-Test


fn main(): int64 {
  var test_path: pchar := "/tmp/simple_test.txt";
  var buf: pchar := "Hello World\n";
  var fd: int64 := 0;

  // O_WRONLY | O_CREAT | O_TRUNC = 1 | 64 | 512 = 577
  fd := open(test_path, 577, 420);
  if (fd < 0) {
    return 1;
  }

  write(fd, buf, 12);
  close(fd);
  unlink(test_path);

  return 0;
}
