// examples/test_Printf_negative.lyx
// Negative and additional Printf tests

import std.io;
import std.string;

fn main(): int64 {
  // Full substitution (4 args)
  var a1: pchar := "one";
  // #1150: a2/a3 waren pchar und wurden an %d bzw. %f uebergeben — die
  // Ausgabe war entsprechend Unsinn ("B:125819637186581 C:0.000000"). Der
  // Test waere mit rc=0 als gruen durchgegangen, obwohl er falsch rechnet.
  var a2: int64 := 2;
  var a3: f64 := 3.14;
  var a4: pchar := "four";
  Printf("A:%s B:%d C:%f D:%s\n", a1, a2, a3, a4);
  // Der Test urteilt jetzt selbst, statt nur zu drucken.
  if a2 == 2 { PrintLn("PASS printf_args"c); } else { PrintLn("FAIL printf_args"c); }

  // Missing argument: second placeholder should be empty
  // #1150: Hier stand `Printf("X:%s Y:%d\n", "onlyone")` — zu wenige
  // Argumente. Der Compiler weist das INZWISCHEN beim Uebersetzen ab
  // ("Printf hat mehr Platzhalter als Argumente"), also frueher und besser,
  // als dieser Test es pruefen wollte. Damit ist die Datei hier nicht mehr
  // der richtige Ort dafuer: sie soll uebersetzen und laufen.
  // Die Ablehnung selbst ist derzeit von keinem Test gesichert — als eigene
  // Luecke vermerkt, siehe Kommentar an #1150.

  // Unsupported specifier should Print '%q'
  // Ebenso: ein Platzhalter ohne Argument.

  // Escaped percent
  Printf("literal percent: %% done\n");

  return 0;
}
