// Comprehensive test of all string builtins
fn main(): int64 {
  Print("=== Comprehensive String Builtin Tests ===\n");
  
  // Test 1: str_length
  Print("Test 1: str_length\n");
  Print("Length of 'Test': ");
  Print(StrLength("Test"));
  Print("\n");
  
  // Test 2: StrCharAt
  Print("\nTest 2: StrCharAt\n");
  var test_str: pchar := "Hello";
  Print("Characters of 'Hello': ");
  Print(StrCharAt(test_str, 0)); Print(" ");
  Print(StrCharAt(test_str, 1)); Print(" ");
  Print(StrCharAt(test_str, 2)); Print(" ");
  Print(StrCharAt(test_str, 3)); Print(" ");
  Print(StrCharAt(test_str, 4)); Print("\n");
  Print("Should be: 72 101 108 108 111 (H e l l o)\n");
  
  // Test 3: StrEquals
  Print("\nTest 3: StrEquals\n");
  var cmp_result: int64 := StrEquals("abc", "abc");
  Print("StrEquals(abc, abc): ");
  Print(cmp_result);
  Print(" (1 = gleich)\n");
  
  Print("\n=== All basic tests completed! ===\n");
  
  return 0;
}