// C-Funktion aus libc aufrufen (frueher: `importC "string.h" link "..."`).
//
// #1819: `importC` gab es nie in der Sprache. Die Absicht — eine Funktion aus
// einer C-Bibliothek rufen — traegt heute `extern fn ... link "..."`; den
// Header liest `lyxc --include <hdr.h>` und gibt die Deklarationen aus.
extern fn strlen(s: pchar): int64 link "libc.so.6";

fn main(): int64 {
  var s: pchar := "extern works!"c;
  var n: int64 := strlen(s);
  Print("strlen via extern fn: "c);
  PrintInt(n);
  Print("\n"c);
  if (n != 13) { return 1; }
  return 0;
}
