// Test: std/log basic functions

import std.log;

fn main(): int64 {
  Print("=== std/log Tests ===\n");
  
  // Test get_log_level
  var level: int64 := get_log_level();
  Print("Default log level: ");
  PrintInt(level);
  Print("\n");
  
  // Test log_level_to_string
  Print("\n--- Testing level strings ---\n");
  Print("0: ");
  Print(log_level_to_string(0));
  Print("\n");
  
  // Test log functions (single call)
  Print("\n--- Testing log levels ---\n");
  
  log_info("This is an INFO message");
  
  // Test conditional logging
  Print("\n--- Testing conditional ---\n");
  log_debug_if(true, "Conditional: true");
  
  Print("=== Tests done! ===\n");
  
  return 0;
}
