// Test: std/log minimal

import std.log;

fn main(): int64 {
  Print("Test 1: get_log_level\n");
  var level: int64 := get_log_level();
  PrintInt(level);
  Print("\n");
  
  Print("Test 2: log_level_to_string\n");
  Print(log_level_to_string(0));
  Print("\n");
  Print(log_level_to_string(1));
  Print("\n");
  
  Print("Test 3: log_info\n");
  log_info("Hello from log!");
  
  Print("Test 4: log_warn\n");
  log_warn("This is a warning");
  
  Print("Test 5: log_error\n");
  log_error("This is an error");
  
  Print("Test 7: log_debug_if\n");
  log_debug_if(true, "Conditional true");
  log_debug_if(false, "Conditional false");
  
  Print("Done!\n");
  return 0;
}
