// examples/use_time_format.lyx
// Einfaches Beispiel zur Demonstration der numerischen Datumsfunktionen

// #1820: Der Test rief DaysFromCivil und day_of_year ohne jeden Import auf.
// Beide Funktionen gibt es — DaysFromCivil in std.time, die zweite heisst
// DayOfYear in std.datetime. Gefehlt hat nicht die API, sondern der Import.
import std.time;
import std.datetime;

fn main(argc: int64, argv: pchar): int64 {
  // Beispiel: 2026-02-15
  let y: int64 := 2026;
  let m: int64 := 2;
  let d: int64 := 15;

  // Berechnungen
  let days: int64 := DaysFromCivil(y, m, d);
  let doy: int64 := DayOfYear(y, m, d);
  let w: int64 := DayOfWeekYmd(y, m, d); // 0=Mon

  Print("Date info:\n");
  Print("year: "); PrintInt(y); Print("\n");
  Print("month: "); PrintInt(m); Print("\n");
  Print("day: "); PrintInt(d); Print("\n");
  Print("days since epoch: "); PrintInt(days); Print("\n");
  Print("day of year: "); PrintInt(doy); Print("\n");
  Print("weekday (0=Mon): "); PrintInt(w); Print("\n");

  // Demo: format current epoch times
  let ts0: int64 := 0; // 1970-01-01T00:00:00Z
  // #1820: Format schreibt in einen Puffer und liefert die Laenge zurueck.
  // Der Test gab 0 als Puffer und nahm das Ergebnis als pchar — Format
  // meldete daraufhin -1, und Print(0) lief in einen Speicherzugriffsfehler.
  var buf: pchar := StrNew(64);
  let n: int64 := Format(ts0, "%Y-%m-%d %H:%i:%s", buf);
  Print("formatted ts0: ");
  if (n < 0) { Print("(Fehler)"); } else { Print(buf); }
  Print("\n");

  return 0;
}
