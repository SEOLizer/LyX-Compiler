// examples/use_time.lyx
import std.time;
import std.io;

fn main(): int64 {
  // #1179: Hier stand `now_unix()` — ein Symbol, das std.time als link-lose
  // extern-Deklaration fuehrte. Es wurde nie gebunden und lieferte still 0;
  // der Test druckte also eine Null und galt als gruen. `Now()` ist die
  // oeffentliche Schnittstelle und liefert die echte Zeit.
  let t := Now();
  Print(t);
  Print("\n");
  // small sleep to demonstrate
  Sleep(1);
  return 0;
}
