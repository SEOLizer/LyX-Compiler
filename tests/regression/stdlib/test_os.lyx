// Test: std/os basic functions
// Tests: sleep, get_pid, env_get, env_set, get_cwd

import std.os;

fn main(): int64 {
  Print("=== std/os Tests ===\n");
  
  // Test get_pid
  var pid: int64 := get_pid();
  Print("PID: ");
  PrintInt(pid);
  Print("\n");
  
  // Test env_get
  var home: pchar := env_get("HOME");
  Print("HOME: ");
  Print(home);
  Print("\n");
  
  var path: pchar := env_get("PATH");
  Print("PATH exists: ");
  if (path != "") {
    Print("yes\n");
  } else {
    Print("no\n");
  }
  
  // Test env_has
  var has_home: bool := env_has("HOME");
  Print("env_has(HOME): ");
  if (has_home) {
    Print("true\n");
  } else {
    Print("false\n");
  }
  
  // Test get_cwd
  var cwd: pchar := get_cwd();
  Print("CWD: ");
  Print(cwd);
  Print("\n");
  
  // Test time
  // #1179: Hier stand `time()` — das rohe libc-Symbol, das std.os als
  // link-lose extern-Deklaration fuehrte und das nie gebunden wurde. Der Test
  // druckte "Unix time: 0" und galt als gruen. `unix_time()` ist die
  // oeffentliche Funktion der Unit und liefert die echte Zeit.
  var t: int64 := unix_time();
  Print("Unix time: ");
  PrintInt(t);
  Print("\n");
  
  // Test get_os_name
  var os_name: pchar := get_os_name();
  Print("OS: ");
  Print(os_name);
  Print("\n");
  
  // Test get_arch
  var arch: pchar := get_arch();
  Print("Architecture: ");
  Print(arch);
  Print("\n");
  
  // Test get_user_name
  var user: pchar := get_user_name();
  Print("User: ");
  Print(user);
  Print("\n");
  
  // Test get_temp_dir
  var tmp: pchar := get_temp_dir();
  Print("Temp dir: ");
  Print(tmp);
  Print("\n");
  
  // Test sleep (brief)
  Print("Testing sleep(100ms)...\n");
  sleep(100);
  Print("Sleep done!\n");
  
  Print("=== All tests passed! ===\n");
  
  return 0;
}
