// Test Country Codes Module
// Demonstrates ISO 3166-1 alpha-2 country code lookups

import std.country;

fn main(): int64 {
  Print("Testing Country Codes Module (ISO 3166-1)...\n");
  
  // Test 1: Country Name Lookup
  Print("Test 1: Country Name Lookup\n");
  var name: int64 := CountryGetName("DE") as int64;
  Print("  DE -> ");
  sys_write(1, name, 20);
  Print("\n");
  
  name := CountryGetName("US") as int64;
  Print("  US -> ");
  sys_write(1, name, 20);
  Print("\n");
  
  name := CountryGetName("JP") as int64;
  Print("  JP -> ");
  sys_write(1, name, 20);
  Print("\n");
  
  name := CountryGetName("XX") as int64;
  Print("  XX -> ");
  sys_write(1, name, 20);
  Print("\n");
  
  // Test 2: Code Lookup by Name
  Print("Test 2: Code Lookup by Name\n");
  var code: int64 := CountryGetCode("Germany") as int64;
  Print("  Germany -> ");
  sys_write(1, code, 2);
  Print("\n");
  
  code := CountryGetCode("Switzerland") as int64;
  Print("  Switzerland -> ");
  sys_write(1, code, 2);
  Print("\n");
  
  code := CountryGetCode("Japan") as int64;
  Print("  Japan -> ");
  sys_write(1, code, 2);
  Print("\n");
  
  // Test 3: Currency Lookup
  Print("Test 3: Currency Lookup\n");
  var currency: int64 := CountryGetCurrency("DE") as int64;
  Print("  DE -> ");
  sys_write(1, currency, 3);
  Print("\n");
  
  currency := CountryGetCurrency("GB") as int64;
  Print("  GB -> ");
  sys_write(1, currency, 3);
  Print("\n");
  
  currency := CountryGetCurrency("JP") as int64;
  Print("  JP -> ");
  sys_write(1, currency, 3);
  Print("\n");
  
  currency := CountryGetCurrency("CH") as int64;
  Print("  CH -> ");
  sys_write(1, currency, 3);
  Print("\n");
  
  // Test 4: Region Lookup
  Print("Test 4: Region Lookup\n");
  var region: int64 := CountryGetRegion("DE");
  Print("  DE -> ");
  sys_write(1, CountryGetRegionName(region), 20);
  Print("\n");
  
  region := CountryGetRegion("US");
  Print("  US -> ");
  sys_write(1, CountryGetRegionName(region), 20);
  Print("\n");
  
  region := CountryGetRegion("JP");
  Print("  JP -> ");
  sys_write(1, CountryGetRegionName(region), 20);
  Print("\n");
  
  region := CountryGetRegion("BR");
  Print("  BR -> ");
  sys_write(1, CountryGetRegionName(region), 20);
  Print("\n");
  
  region := CountryGetRegion("AU");
  Print("  AU -> ");
  sys_write(1, CountryGetRegionName(region), 20);
  Print("\n");
  
  // Test 5: ISO Numeric Code
  Print("Test 5: ISO Numeric Code\n");
  var num: int64 := CountryGetNumeric("DE");
  Print("  DE -> ");
  PrintInt(num);
  Print("\n");
  
  num := CountryGetNumeric("US");
  Print("  US -> ");
  PrintInt(num);
  Print("\n");
  
  num := CountryGetNumeric("CH");
  Print("  CH -> ");
  PrintInt(num);
  Print("\n");
  
  // Test 6: Validation
  Print("Test 6: Code Validation\n");
  var valid: int64 := CountryIsValid("DE");
  Print("  DE -> ");
  if (valid == 1) { Print("VALID") } else { Print("INVALID") }
  Print("\n");
  
  valid := CountryIsValid("XX");
  Print("  XX -> ");
  if (valid == 1) { Print("VALID") } else { Print("INVALID") }
  Print("\n");
  
  valid := CountryIsValid("US");
  Print("  US -> ");
  if (valid == 1) { Print("VALID") } else { Print("INVALID") }
  Print("\n");
  
  // Test 7: Database Stats
  Print("Test 7: Database Stats\n");
  Print("  Countries in database: ");
  PrintInt(CountryGetCount());
  Print("\n");
  
  Print("\nAll tests completed!\n");
  return 0;
}
