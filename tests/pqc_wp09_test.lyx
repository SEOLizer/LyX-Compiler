// tests/pqc_wp09_test.lyx
// WP-PQC-09: Hybrid-KEM (X25519 + ML-KEM-768)
//
// Abnahmekriterien:
// AC-WP09.1: X25519 RFC-7748-Testvektoren (Alice-Schlüsselpaar)
// AC-WP09.2: X25519 DH-Austausch (Alice und Bob einigen sich auf gleichen Key)
// AC-WP09.3: HybridKEM Roundtrip (Encap → Decap ergibt gleichen SharedKey)
// AC-WP09.4: HybridKEM Ablehnung (manipulierter CT → anderer SharedKey)
// AC-WP09.5: HybridKEM Determinismus (gleiche Seeds → gleiche Outputs)

unit tests.pqc_wp09_test;

import std.crypto.x25519;
import std.crypto.pqc.hybrid;
import std.alloc;

fn fill_buf(buf: int64, n: int64, seed: int64) {
  var v: int64 := seed;
  var i: int64 := 0;
  while (i < n) {
    v := (v * 6364136223846793005) + 1442695040888963407;
    poke8(buf+i, (v>>16) & 0xFF);
    i := i+1;
  }
}

fn bytes_equal(a: int64, b: int64, n: int64): int64 {
  var i: int64 := 0;
  while (i < n) { if (peek8(a+i) != peek8(b+i)) { return 0; } i := i+1; }
  return 1;
}

fn bytes_nonzero(a: int64, n: int64): int64 {
  var i: int64 := 0;
  while (i < n) { if (peek8(a+i) != 0) { return 1; } i := i+1; }
  return 0;
}

// ─────────────────────────────────────────────────────────────────────────────
// AC-WP09.1: RFC 7748 §6.1 Testvektoren
//
// Alice private key (raw, vor Klemmung):
//   77 07 6d 0a 73 18 a5 7d 3c 16 c1 72 51 b2 66 45
//   df 4c 2f 87 eb c0 99 2a b1 77 fb a5 1d b9 2c 2a
// Alice public key = X25519(alice_private, 9):
//   85 20 f0 09 89 30 a7 54 74 8b 7d dc b4 3e f7 5a
//   0d bf 3a 0d 26 38 1a f4 eb a4 a9 8e aa 9b 4e 6a

fn testAC1(): int64 {
  var k: int64 := alloc(32);
  var u: int64 := alloc(32);
  var out: int64 := alloc(32);
  var expected: int64 := alloc(32);

  // Alice private key (hex, LE)
  poke8(k+0,0x77); poke8(k+1,0x07); poke8(k+2,0x6d); poke8(k+3,0x0a);
  poke8(k+4,0x73); poke8(k+5,0x18); poke8(k+6,0xa5); poke8(k+7,0x7d);
  poke8(k+8,0x3c); poke8(k+9,0x16); poke8(k+10,0xc1); poke8(k+11,0x72);
  poke8(k+12,0x51); poke8(k+13,0xb2); poke8(k+14,0x66); poke8(k+15,0x45);
  poke8(k+16,0xdf); poke8(k+17,0x4c); poke8(k+18,0x2f); poke8(k+19,0x87);
  poke8(k+20,0xeb); poke8(k+21,0xc0); poke8(k+22,0x99); poke8(k+23,0x2a);
  poke8(k+24,0xb1); poke8(k+25,0x77); poke8(k+26,0xfb); poke8(k+27,0xa5);
  poke8(k+28,0x1d); poke8(k+29,0xb9); poke8(k+30,0x2c); poke8(k+31,0x2a);

  // u = 9 (base point)
  var i: int64 := 0;
  while (i < 32) { poke8(u+i, 0); i := i+1; }
  poke8(u+0, 9);

  // Expected public key
  poke8(expected+0,0x85); poke8(expected+1,0x20); poke8(expected+2,0xf0); poke8(expected+3,0x09);
  poke8(expected+4,0x89); poke8(expected+5,0x30); poke8(expected+6,0xa7); poke8(expected+7,0x54);
  poke8(expected+8,0x74); poke8(expected+9,0x8b); poke8(expected+10,0x7d); poke8(expected+11,0xdc);
  poke8(expected+12,0xb4); poke8(expected+13,0x3e); poke8(expected+14,0xf7); poke8(expected+15,0x5a);
  poke8(expected+16,0x0d); poke8(expected+17,0xbf); poke8(expected+18,0x3a); poke8(expected+19,0x0d);
  poke8(expected+20,0x26); poke8(expected+21,0x38); poke8(expected+22,0x1a); poke8(expected+23,0xf4);
  poke8(expected+24,0xeb); poke8(expected+25,0xa4); poke8(expected+26,0xa9); poke8(expected+27,0x8e);
  poke8(expected+28,0xaa); poke8(expected+29,0x9b); poke8(expected+30,0x4e); poke8(expected+31,0x6a);

  X25519(out, k, u);

  var ok: int64 := bytes_equal(out, expected, 32);
  free(k, 32); free(u, 32); free(out, 32); free(expected, 32);
  if (ok != 0) { PrintLn("OK: X25519 RFC-7748-Testvektor (WP-09.1)"); return 0; }
  PrintLn("FAIL: X25519 RFC-7748-Testvektor (WP-09.1)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────
// AC-WP09.2: DH-Austausch X25519(sk_A, X25519(sk_B, 9)) == X25519(sk_B, X25519(sk_A, 9))

fn testAC2(): int64 {
  var sk_a: int64 := alloc(32); var pk_a: int64 := alloc(32);
  var sk_b: int64 := alloc(32); var pk_b: int64 := alloc(32);
  var ss_a: int64 := alloc(32); var ss_b: int64 := alloc(32);
  var seed_a: int64 := alloc(32); var seed_b: int64 := alloc(32);
  fill_buf(seed_a, 32, 0xAAAAAAAA);
  fill_buf(seed_b, 32, 0xBBBBBBBB);
  X25519KeyGen(seed_a, pk_a, sk_a);
  X25519KeyGen(seed_b, pk_b, sk_b);
  X25519SharedSecret(sk_a, pk_b, ss_a);  // Alice: X25519(sk_a, pk_b)
  X25519SharedSecret(sk_b, pk_a, ss_b);  // Bob:   X25519(sk_b, pk_a)
  var ok: int64 := bytes_equal(ss_a, ss_b, 32) & bytes_nonzero(ss_a, 32);
  free(sk_a,32); free(pk_a,32); free(sk_b,32); free(pk_b,32);
  free(ss_a,32); free(ss_b,32); free(seed_a,32); free(seed_b,32);
  if (ok != 0) { PrintLn("OK: X25519 DH-Austausch (WP-09.2)"); return 0; }
  PrintLn("FAIL: X25519 DH-Austausch (WP-09.2)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────
// AC-WP09.3: HybridKEM Roundtrip

fn testAC3(): int64 {
  var pk:   int64 := alloc(HYBRID_PK);
  var sk:   int64 := alloc(HYBRID_SK);
  var ct:   int64 := alloc(HYBRID_CT);
  var ss1:  int64 := alloc(32);
  var ss2:  int64 := alloc(32);
  var seed: int64 := alloc(96);
  var rand: int64 := alloc(64);
  fill_buf(seed, 96, 0x12345678);
  fill_buf(rand, 64, 0xDEADBEEF);

  HybridKEMKeyGen(seed, pk, sk);
  HybridKEMEncapsulate(pk, rand, ct, ss1);
  HybridKEMDecapsulate(sk, ct, ss2);

  var ok: int64 := bytes_equal(ss1, ss2, 32) & bytes_nonzero(ss1, 32);
  free(pk, HYBRID_PK); free(sk, HYBRID_SK); free(ct, HYBRID_CT);
  free(ss1, 32); free(ss2, 32); free(seed, 96); free(rand, 64);
  if (ok != 0) { PrintLn("OK: HybridKEM Roundtrip (WP-09.3)"); return 0; }
  PrintLn("FAIL: HybridKEM Roundtrip (WP-09.3)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────
// AC-WP09.4: Manipulierter CT → anderer SharedKey

fn testAC4(): int64 {
  var pk:     int64 := alloc(HYBRID_PK);
  var sk:     int64 := alloc(HYBRID_SK);
  var ct_ok:  int64 := alloc(HYBRID_CT);
  var ct_bad: int64 := alloc(HYBRID_CT);
  var ss_ref: int64 := alloc(32);
  var ss_ok:  int64 := alloc(32);
  var ss_bad: int64 := alloc(32);
  var seed:   int64 := alloc(96);
  var rand:   int64 := alloc(64);
  fill_buf(seed, 96, 0xCAFEBABE);
  fill_buf(rand, 64, 0x0DDBA11);

  HybridKEMKeyGen(seed, pk, sk);
  HybridKEMEncapsulate(pk, rand, ct_ok, ss_ref);

  // CT kopieren und erstes Byte flippen
  var i: int64 := 0;
  while (i < HYBRID_CT) { poke8(ct_bad+i, peek8(ct_ok+i)); i := i+1; }
  poke8(ct_bad, peek8(ct_bad) ^ 0xFF);

  HybridKEMDecapsulate(sk, ct_ok,  ss_ok);
  HybridKEMDecapsulate(sk, ct_bad, ss_bad);

  var ok1: int64 := bytes_equal(ss_ok, ss_ref, 32);  // korrekter CT → gleicher Key
  var ok2: int64 := 0;
  if (bytes_equal(ss_bad, ss_ref, 32) == 0) { ok2 := 1; }  // manipulierter CT → anderer Key
  var ok3: int64 := bytes_nonzero(ss_bad, 32);  // kein Absturz

  free(pk,HYBRID_PK); free(sk,HYBRID_SK);
  free(ct_ok,HYBRID_CT); free(ct_bad,HYBRID_CT);
  free(ss_ref,32); free(ss_ok,32); free(ss_bad,32);
  free(seed,96); free(rand,64);

  if (ok1 != 0) {
    if (ok2 != 0) {
      if (ok3 != 0) {
        PrintLn("OK: HybridKEM Ablehnung manipulierter CT (WP-09.4)");
        return 0;
      }
    }
  }
  PrintLn("FAIL: HybridKEM Ablehnung (WP-09.4)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────
// AC-WP09.5: Determinismus

fn testAC5(): int64 {
  var pk1: int64 := alloc(HYBRID_PK); var pk2: int64 := alloc(HYBRID_PK);
  var sk1: int64 := alloc(HYBRID_SK); var sk2: int64 := alloc(HYBRID_SK);
  var ct1: int64 := alloc(HYBRID_CT); var ct2: int64 := alloc(HYBRID_CT);
  var ss1: int64 := alloc(32); var ss2: int64 := alloc(32);
  var seed: int64 := alloc(96); var rand: int64 := alloc(64);
  fill_buf(seed, 96, 0xFEEDC0DE);
  fill_buf(rand, 64, 0xBAADF00D);

  HybridKEMKeyGen(seed, pk1, sk1);
  HybridKEMKeyGen(seed, pk2, sk2);
  HybridKEMEncapsulate(pk1, rand, ct1, ss1);
  HybridKEMEncapsulate(pk2, rand, ct2, ss2);

  var ok: int64 := bytes_equal(pk1, pk2, HYBRID_PK) & bytes_equal(ct1, ct2, HYBRID_CT) & bytes_equal(ss1, ss2, 32);

  free(pk1,HYBRID_PK); free(pk2,HYBRID_PK);
  free(sk1,HYBRID_SK); free(sk2,HYBRID_SK);
  free(ct1,HYBRID_CT); free(ct2,HYBRID_CT);
  free(ss1,32); free(ss2,32); free(seed,96); free(rand,64);

  if (ok != 0) { PrintLn("OK: HybridKEM Determinismus (WP-09.5)"); return 0; }
  PrintLn("FAIL: HybridKEM Determinismus (WP-09.5)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testAC1();
  failed := failed + testAC2();
  failed := failed + testAC3();
  failed := failed + testAC4();
  failed := failed + testAC5();
  if (failed != 0) { PrintLn("FAILED"); return 1; }
  PrintLn("ALL PASSED");
  return 0;
}
