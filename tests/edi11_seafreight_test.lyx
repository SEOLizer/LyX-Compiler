fn strEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
        if (peek8(a + i) != peek8(b + i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

fn pass(n: int64) { Print("PASS "); PrintLn(n); }
fn fail(n: int64) { Print("FAIL "); PrintLn(n); }
fn check(n: int64, ok: int64) { if (ok == 1) { pass(n); } else { fail(n); } }

// Zero-fill a buffer
fn zero(ptr: int64, sz: int64) {
    var i: int64 := 0;
    while (i < sz) { poke8(ptr + i, 0); i := i + 1; }
}

// Fill SF header with standard voyage data
fn fillHdr(hdr: int64) {
    zero(hdr, EDI_SF_HDR_SIZE);
    poke64(hdr + EDI_SF_HDR_REF,      "VOYAGE001"c as int64);
    poke64(hdr + EDI_SF_HDR_REFLEN,   9);
    poke64(hdr + EDI_SF_HDR_DATE,     "20260615"c as int64);
    poke64(hdr + EDI_SF_HDR_VESSEL,   "COSCO"c as int64);
    poke64(hdr + EDI_SF_HDR_VESSELLN, 5);
    poke64(hdr + EDI_SF_HDR_VOYAGE,   "VG2026A"c as int64);
    poke64(hdr + EDI_SF_HDR_VOYAGELN, 7);
    poke64(hdr + EDI_SF_HDR_PORT,     "DEHAM"c as int64);
    poke64(hdr + EDI_SF_HDR_PORTLEN,  5);
}

// Fill container at ptr with ID (always 11 chars), size, bay, row, tier, weight × 100
fn fillContPos(c: int64, idStr: int64, sz: int64, bay: int64, row: int64, tier: int64): int64 {
    zero(c, EDI_SF_CONT_SIZE_OFF);
    poke64(c + EDI_SF_CONT_ID,      idStr);
    poke64(c + EDI_SF_CONT_IDLEN,   11);
    poke64(c + EDI_SF_CONT_SIZE,    sz);
    poke64(c + EDI_SF_CONT_TYPE,    "GP"c as int64);
    poke64(c + EDI_SF_CONT_TYPELEN, 2);
    poke64(c + EDI_SF_CONT_BAY,     bay);
    poke64(c + EDI_SF_CONT_ROW,     row);
    poke64(c + EDI_SF_CONT_TIER,    tier);
    return 1;
}

// Set weight and moveType on an already-filled container
fn fillContWtMv(c: int64, wt: int64, mv: int64): int64 {
    poke64(c + EDI_SF_CONT_WEIGHT,   wt);
    poke64(c + EDI_SF_CONT_MOVETYPE, mv);
    return 1;
}

