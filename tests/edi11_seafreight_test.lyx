        fillContWtMv(cont + 1 * EDI_SF_CONT_SIZE_OFF, 2750000, EDI_SF_MOVE_DISCHARGE);

        var out: int64 := alloc(8192);
        var written: int64 := EdiBaplieWrite(hdr, cont, 2, out, 8192);
        check(8, written > 0);

        // BGM tag present
        {
            var found: int64 := 0;
            var j: int64 := 0;
            while (j + 2 < written) {
                if (peek8(out+j)==66 && peek8(out+j+1)==71 && peek8(out+j+2)==77) { found := 1; }
                j := j + 1;
            }
            check(9, found);
        }

        // EQD tag present
        {
            var found: int64 := 0;
            var j: int64 := 0;
            while (j + 2 < written) {
                if (peek8(out+j)==69 && peek8(out+j+1)==81 && peek8(out+j+2)==68) { found := 1; }
                j := j + 1;
            }
            check(10, found);
        }

        var hdr2:  int64 := alloc(EDI_SF_HDR_SIZE);
        var cont2: int64 := alloc(4 * EDI_SF_CONT_SIZE_OFF);
        zero(hdr2, EDI_SF_HDR_SIZE);
        zero(cont2, 4 * EDI_SF_CONT_SIZE_OFF);

        var contCount: int64 := EdiBaplieRead(out, written, hdr2, cont2, 4);
        check(11, contCount == 2);
        check(12, peek64(hdr2 + EDI_SF_HDR_BGMQUAL) == EDI_SF_BGM_BAPLIE);
        check(13, peek64(cont2 + 0 * EDI_SF_CONT_SIZE_OFF + EDI_SF_CONT_IDLEN) == 11);

        var id0Ptr: int64 := peek64(cont2 + 0 * EDI_SF_CONT_SIZE_OFF + EDI_SF_CONT_ID);
        var id0Len: int64 := peek64(cont2 + 0 * EDI_SF_CONT_SIZE_OFF + EDI_SF_CONT_IDLEN);
        check(14, strEq(id0Ptr, id0Len, "AAAU0000007"c as int64, 11));

        free(cont2, 4 * EDI_SF_CONT_SIZE_OFF);
        free(hdr2, EDI_SF_HDR_SIZE);
        free(out, 8192);
        free(cont, 2 * EDI_SF_CONT_SIZE_OFF);
        free(hdr, EDI_SF_HDR_SIZE);
    }

