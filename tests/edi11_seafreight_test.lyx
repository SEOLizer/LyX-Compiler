        var written: int64 := EdiVermasWrite(hdr, cont, 1, out, 8192);
        var found: int64 := 0;
        var j: int64 := 0;
        while (j + 2 < written) {
            if (peek8(out+j)==77 && peek8(out+j+1)==69 && peek8(out+j+2)==65) { found := 1; }
            j := j + 1;
        }
        check(44, found);
        free(out, 8192);
        free(cont, EDI_SF_CONT_SIZE_OFF);
        free(hdr, EDI_SF_HDR_SIZE);
    }

    // ── Test 45: MOVINS cont size == 40 round-trip ───────────────────────────
    {
