// tests/pqc_wp07_test.lyx
// WP-PQC-07: ML-DSA (CRYSTALS-Dilithium, NIST FIPS 204)
//
// Abnahmekriterien:
// AC-WP07.1: MLDSAKeyGen erzeugt korrekt große Schlüssel (level=44,65,87)
// AC-WP07.2: Sign → Verify Roundtrip (Signatur gültig)
// AC-WP07.3: Manipulation der Signatur → Verify verweigert
// AC-WP07.4: Falscher Public Key → Verify verweigert
// AC-WP07.5: Determinismus (gleiche Eingaben = gleiche Signatur)

unit tests.pqc_wp07_test;

import std.crypto.pqc.mldsa;
import std.alloc;

fn fill_buf(buf: int64, size: int64, seed: int64) {
  var v: int64 := seed;
  var i: int64 := 0;
  while (i < size) {
    v := (v * 6364136223846793005) + 1442695040888963407;
    poke8(buf + i, (v >> 16) & 0xFF);
    i := i + 1;
  }
}

fn bytes_nonzero(buf: int64, n: int64): int64 {
  var i: int64 := 0;
  while (i < n) { if (peek8(buf + i) != 0) { return 1; } i := i + 1; }
  return 0;
}

fn bytes_equal(a: int64, b: int64, n: int64): int64 {
  var i: int64 := 0;
  while (i < n) { if (peek8(a + i) != peek8(b + i)) { return 0; } i := i + 1; }
  return 1;
}

fn pk_size(level: int64): int64 {
  if (level == 44) { return 1312; }
  if (level == 65) { return 1952; }
  return 2592;
}
fn sk_size(level: int64): int64 {
  if (level == 44) { return 2528; }
  if (level == 65) { return 4000; }
  return 4864;
}
fn sig_size(level: int64): int64 {
  if (level == 44) { return 2420; }
  if (level == 65) { return 3293; }
  return 4595;
}

// ─────────────────────────────────────────────────────────────────────────────
// AC-WP07.1: Schlüsselgrößen

fn testKeySizes(level: int64): int64 {
  var pks: int64 := pk_size(level);
  var sks: int64 := sk_size(level);
  var pk:  int64 := alloc(pks);
  var sk:  int64 := alloc(sks);
  var seed: int64 := alloc(32);
  fill_buf(seed, 32, 0x11111111);
  MLDSAKeyGen(seed, level, pk, sk);
  var ok: int64 := bytes_nonzero(pk, pks) & bytes_nonzero(sk, sks);
  free(pk, pks); free(sk, sks); free(seed, 32);
  return ok;
}

fn testAC1(): int64 {
  var ok: int64 := testKeySizes(44) & testKeySizes(65) & testKeySizes(87);
  if (ok != 0) { PrintLn("OK: MLDSAKeyGen Schluesselgroessen level=44,65,87 (WP-07.1)"); return 0; }
  PrintLn("FAIL: MLDSAKeyGen Schluesselgroessen (WP-07.1)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────
// AC-WP07.2: Sign → Verify Roundtrip

fn testRoundtrip(level: int64): int64 {
  var pks: int64 := pk_size(level);
  var sks: int64 := sk_size(level);
  var sigs: int64 := sig_size(level);
  var pk:  int64 := alloc(pks);
  var sk:  int64 := alloc(sks);
  var sig: int64 := alloc(sigs);
  var seed: int64 := alloc(32);
  fill_buf(seed, 32, 0xABCDABCD);

  var msg: int64 := alloc(32);
  fill_buf(msg, 32, 0xDEADBEEF);

  MLDSAKeyGen(seed, level, pk, sk);
  var siglen: int64 := MLDSASign(sk, level, msg, 32, sig);
  var valid: int64 := MLDSAVerify(pk, level, msg, 32, sig, siglen);

  free(pk, pks); free(sk, sks); free(sig, sigs); free(seed, 32); free(msg, 32);
  return valid;
}

fn testAC2(): int64 {
  var ok44: int64 := testRoundtrip(44);
  var ok65: int64 := testRoundtrip(65);
  var ok87: int64 := testRoundtrip(87);
  if (ok44 != 0) {
    if (ok65 != 0) {
      if (ok87 != 0) {
        PrintLn("OK: Sign->Verify Roundtrip level=44,65,87 (WP-07.2)");
        return 0;
      }
    }
  }
  PrintLn("FAIL: Roundtrip (WP-07.2)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────
// AC-WP07.3: Manipulierte Signatur → Verify verweigert

fn testRejection(level: int64): int64 {
  var pks: int64 := pk_size(level);
  var sks: int64 := sk_size(level);
  var sigs: int64 := sig_size(level);
  var pk:  int64 := alloc(pks);
  var sk:  int64 := alloc(sks);
  var sig: int64 := alloc(sigs);
  var seed: int64 := alloc(32);
  fill_buf(seed, 32, 0xCAFECAFE);

  var msg: int64 := alloc(32);
  fill_buf(msg, 32, 0xBEEFBEEF);

  MLDSAKeyGen(seed, level, pk, sk);
  var siglen: int64 := MLDSASign(sk, level, msg, 32, sig);

  // Erstes Byte der Signatur flippen (c̃ Teil)
  poke8(sig, peek8(sig) ^ 0xFF);
  var invalid: int64 := MLDSAVerify(pk, level, msg, 32, sig, siglen);

  free(pk, pks); free(sk, sks); free(sig, sigs); free(seed, 32); free(msg, 32);
  if (invalid == 0) { return 0; }  // OK: Signatur wurde korrekt verweigert
  return 1;                          // FAIL: manipulierte Signatur akzeptiert
}

fn testAC3(): int64 {
  var fail: int64 := 0;
  fail := fail + testRejection(44);
  fail := fail + testRejection(65);
  fail := fail + testRejection(87);
  if (fail == 0) { PrintLn("OK: Manipulierte Signatur wird verweigert level=44,65,87 (WP-07.3)"); return 0; }
  PrintLn("FAIL: Ablehnung manipulierter Signaturen (WP-07.3)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────
// AC-WP07.4: Falscher Public Key → Verify verweigert

fn testWrongKey(level: int64): int64 {
  var pks: int64 := pk_size(level);
  var sks: int64 := sk_size(level);
  var sigs: int64 := sig_size(level);
  var pk1: int64 := alloc(pks);
  var sk1: int64 := alloc(sks);
  var pk2: int64 := alloc(pks);
  var sk2: int64 := alloc(sks);
  var sig: int64 := alloc(sigs);
  var seed1: int64 := alloc(32);
  var seed2: int64 := alloc(32);
  fill_buf(seed1, 32, 0x11223344);
  fill_buf(seed2, 32, 0x55667788);

  var msg: int64 := alloc(32);
  fill_buf(msg, 32, 0xAABBCCDD);

  MLDSAKeyGen(seed1, level, pk1, sk1);
  MLDSAKeyGen(seed2, level, pk2, sk2);
  var siglen: int64 := MLDSASign(sk1, level, msg, 32, sig);
  // Verifikation mit falschem Public Key muss scheitern
  var invalid: int64 := MLDSAVerify(pk2, level, msg, 32, sig, siglen);

  free(pk1, pks); free(sk1, sks); free(pk2, pks); free(sk2, sks);
  free(sig, sigs); free(seed1, 32); free(seed2, 32); free(msg, 32);
  if (invalid == 0) { return 0; }  // OK: Ablehnung korrekt
  return 1;                          // FAIL: fälschlicherweise akzeptiert
}

fn testAC4(): int64 {
  var fail: int64 := 0;
  fail := fail + testWrongKey(44);
  fail := fail + testWrongKey(65);
  fail := fail + testWrongKey(87);
  if (fail == 0) { PrintLn("OK: Falscher PublicKey wird verweigert level=44,65,87 (WP-07.4)"); return 0; }
  PrintLn("FAIL: Falscher PublicKey (WP-07.4)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────
// AC-WP07.5: Determinismus

fn testDeterminism(level: int64): int64 {
  var pks: int64 := pk_size(level);
  var sks: int64 := sk_size(level);
  var sigs: int64 := sig_size(level);
  var pk1: int64 := alloc(pks); var pk2: int64 := alloc(pks);
  var sk1: int64 := alloc(sks); var sk2: int64 := alloc(sks);
  var sig1: int64 := alloc(sigs); var sig2: int64 := alloc(sigs);
  var seed: int64 := alloc(32);
  fill_buf(seed, 32, 0xFEEDC0DE);

  var msg: int64 := alloc(32);
  fill_buf(msg, 32, 0x01020304);

  MLDSAKeyGen(seed, level, pk1, sk1);
  MLDSAKeyGen(seed, level, pk2, sk2);
  MLDSASign(sk1, level, msg, 32, sig1);
  MLDSASign(sk2, level, msg, 32, sig2);

  var pk_ok:  int64 := bytes_equal(pk1, pk2, pks);
  var sig_ok: int64 := bytes_equal(sig1, sig2, sigs);

  free(pk1, pks); free(pk2, pks); free(sk1, sks); free(sk2, sks);
  free(sig1, sigs); free(sig2, sigs); free(seed, 32); free(msg, 32);

  if (pk_ok == 0) { return 0; }
  if (sig_ok == 0) { return 0; }
  return 1;
}

fn testAC5(): int64 {
  var ok: int64 := testDeterminism(44) & testDeterminism(65) & testDeterminism(87);
  if (ok != 0) { PrintLn("OK: Determinismus level=44,65,87 (WP-07.5)"); return 0; }
  PrintLn("FAIL: Determinismus (WP-07.5)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testAC1();
  failed := failed + testAC2();
  failed := failed + testAC3();
  failed := failed + testAC4();
  failed := failed + testAC5();
  if (failed != 0) { PrintLn("FAILED"); return 1; }
  PrintLn("ALL PASSED");
  return 0;
}
