// tests/pdf_compress_test.lyx
// WP-PDF-05: zlib/DEFLATE FlateDecode compression for PDF content streams

@description("WP-PDF-05: FlateDecode compression test")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pdf_compress_test;

import std.alloc;
import std.pdf;

fn testNoCompression(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }
  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 720.0, "Uncompressed PDF (no PdfSetCompression call)");
  var err: int64 := PdfSave(doc, "/tmp/pdf_no_compress.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: uncompressed PdfSave\n"); return 1; }
  Print("OK: uncompressed PDF saved to /tmp/pdf_no_compress.pdf\n");
  return 0;
}

fn testCompressionBasic(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }
  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 720.0, "Compressed PDF (FlateDecode)");
  PdfTextAt(doc, page, 72.0, 704.0, "Second line of text for compression test");
  PdfTextAt(doc, page, 72.0, 688.0, "Third line — repeated operators compress well");
  PdfSetCompression(doc, 1);
  var err: int64 := PdfSave(doc, "/tmp/pdf_compress.pdf");
  PdfFree(doc);
  if (err != 0) {
    Print("FAIL: compressed PdfSave returned ");
    PrintInt(err);
    Print("\n");
    return 1;
  }
  Print("OK: compressed PDF saved to /tmp/pdf_compress.pdf\n");
  return 0;
}

fn testCompressionMultipage(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }
  var pi: int64 := 0;
  while (pi < 3) {
    var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
    PdfSetFont(doc, page, PDF_FONT_TIMES, 11.0);
    PdfSetLineSpacing(doc, page, 16.0);
    PdfTextBlock(doc, page, 72.0, 750.0, 450.0,
      "This is a word-wrapped text block with FlateDecode compression. Repeated PDF operators like BT ET Tf Td Tj compress very well with LZ77 back-references.");
    PdfSetFillColor(doc, page, 0.2, 0.5, 0.8);
    PdfRect(doc, page, 72.0, 100.0, 200.0, 80.0);
    PdfFill(doc, page);
    PdfSetStrokeColor(doc, page, 0.8, 0.2, 0.0);
    PdfSetLineWidth(doc, page, 2.0);
    PdfMoveTo(doc, page, 72.0, 200.0);
    PdfLineTo(doc, page, 400.0, 200.0);
    PdfStroke(doc, page);
    pi := pi + 1;
  }
  PdfSetCompression(doc, 1);
  var err: int64 := PdfSave(doc, "/tmp/pdf_compress_multi.pdf");
  PdfFree(doc);
  if (err != 0) {
    Print("FAIL: multipage compressed PdfSave returned ");
    PrintInt(err);
    Print("\n");
    return 1;
  }
  Print("OK: multipage compressed PDF saved to /tmp/pdf_compress_multi.pdf\n");
  return 0;
}

fn testCompressionGraphics(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }
  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var n: int64 := 0;
  while (n < 20) {
    PdfSetFillColor(doc, page, 0.5, 0.3, 0.7);
    PdfRect(doc, page, 72.0, 700.0 - n * 30.0, 400.0, 20.0);
    PdfFill(doc, page);
    n := n + 1;
  }
  PdfSetCompression(doc, 1);
  var err: int64 := PdfSave(doc, "/tmp/pdf_compress_gfx.pdf");
  PdfFree(doc);
  if (err != 0) {
    Print("FAIL: graphics compressed PdfSave returned ");
    PrintInt(err);
    Print("\n");
    return 1;
  }
  Print("OK: graphics compressed PDF saved to /tmp/pdf_compress_gfx.pdf\n");
  return 0;
}

fn testZlibDirect(): int64 {
  // Compress a repetitive buffer and verify zlib header + Adler-32
  var inLen: int64 := 256;
  var inBuf: int64 := alloc(inLen);
  if (inBuf == 0) { Print("FAIL: mmap input\n"); return 1; }

  // Fill with repeating "ABCABCABC..."
  var fi: int64 := 0;
  while (fi < inLen) {
    poke8(inBuf + fi, 65 + fi - (fi / 3) * 3);
    fi := fi + 1;
  }

  var maxOut: int64 := zlibMaxOutputSize(inLen);
  var outBuf: int64 := alloc(maxOut);
  if (outBuf == 0) {
    free(inBuf, inLen);
    Print("FAIL: mmap output\n");
    return 1;
  }

  var czlen: int64 := zlibCompress(inBuf, inLen, outBuf);
  if (czlen <= 0) {
    free(inBuf, inLen);
    free(outBuf, maxOut);
    Print("FAIL: zlibCompress returned 0\n");
    return 1;
  }

  // Verify zlib header bytes
  var cmf: int64 := peek8(outBuf);
  var flg: int64 := peek8(outBuf + 1);
  if (cmf != 0x78) {
    Print("FAIL: bad CMF byte: ");
    PrintInt(cmf);
    Print("\n");
    free(inBuf, inLen);
    free(outBuf, maxOut);
    return 1;
  }
  // #1071: Frueher stand hier `flg != 0x01`. Das schrieb EIN bestimmtes
  // FLG-Byte fest statt der Regel aus RFC 1950 -- und wurde rot, als der
  // PDF-Pfad auf die gemeinsame Implementierung umgestellt wurde, die wie
  // echtes zlib die FLEVEL-Bits setzt (0x9C bei Standardstufe). Beide Werte
  // sind gueltig. Geprueft wird jetzt, was der RFC verlangt: FDICT muss null
  // sein, und die Pruefbedingung unten muss aufgehen.
  if ((flg & 0x20) != 0) {
    Print("FAIL: FDICT gesetzt, FLG: ");
    PrintInt(flg);
    Print("\n");
    free(inBuf, inLen);
    free(outBuf, maxOut);
    return 1;
  }
  // (CMF*256+FLG) must be divisible by 31
  var check: int64 := (cmf * 256 + flg) - ((cmf * 256 + flg) / 31) * 31;
  if (check != 0) {
    Print("FAIL: zlib header check failed\n");
    free(inBuf, inLen);
    free(outBuf, maxOut);
    return 1;
  }

  // Compute expected Adler-32
  var s1: int64 := 1;
  var s2: int64 := 0;
  var ai: int64 := 0;
  while (ai < inLen) {
    var b: int64 := peek8(inBuf + ai);
    s1 := s1 + b;
    if (s1 >= 65521) { s1 := s1 - 65521; }
    s2 := s2 + s1;
    if (s2 >= 65521) { s2 := s2 - 65521; }
    ai := ai + 1;
  }

  // Last 4 bytes of output = Adler-32 big-endian
  var a32_0: int64 := peek8(outBuf + czlen - 4);
  var a32_1: int64 := peek8(outBuf + czlen - 3);
  var a32_2: int64 := peek8(outBuf + czlen - 2);
  var a32_3: int64 := peek8(outBuf + czlen - 1);
  var got_s2: int64 := (a32_0 << 8) | a32_1;
  var got_s1: int64 := (a32_2 << 8) | a32_3;

  if (got_s1 != s1 || got_s2 != s2) {
    Print("FAIL: Adler-32 mismatch. expected s1=");
    PrintInt(s1);
    Print(" s2=");
    PrintInt(s2);
    Print(" got s1=");
    PrintInt(got_s1);
    Print(" s2=");
    PrintInt(got_s2);
    Print("\n");
    free(inBuf, inLen);
    free(outBuf, maxOut);
    return 1;
  }

  free(inBuf, inLen);
  free(outBuf, maxOut);
  Print("OK: zlibCompress: header OK, Adler-32 verified, compressed ");
  PrintInt(inLen);
  Print(" → ");
  PrintInt(czlen);
  Print(" bytes\n");
  return 0;
}

pub fn main(): int64 {
  if (testNoCompression()       != 0) { return 1; }
  if (testCompressionBasic()    != 0) { return 1; }
  if (testCompressionMultipage() != 0) { return 1; }
  if (testCompressionGraphics() != 0) { return 1; }
  if (testZlibDirect()          != 0) { return 1; }
  Print("All WP-PDF-05 compression tests passed.\n");
  return 0;
}
