// tests/pdf_outline_test.lyx
// WP-PDF-10: document outlines (bookmarks)

@description("WP-PDF-10: PDF outline test")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pdf_outline_test;

import std.alloc;
import std.pdf;

fn testOutlineBasic(): int64 {
  // Three root-level bookmarks on a 3-page PDF
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p2: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Chapter 1");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Chapter 2");
  PdfSetFont(doc, p2, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p2, 72.0, 750.0, "Chapter 3");

  var oi0: int64 := PdfOutlineAdd(doc, -1, "Chapter 1", p0);
  var oi1: int64 := PdfOutlineAdd(doc, -1, "Chapter 2", p1);
  var oi2: int64 := PdfOutlineAdd(doc, -1, "Chapter 3", p2);
  if (oi0 < 0 || oi1 < 0 || oi2 < 0) {
    Print("FAIL: PdfOutlineAdd\n");
    PdfFree(doc);
    return 1;
  }

  var err: int64 := PdfSave(doc, "/tmp/pdf_outline_basic.pdf");
  PdfFree(doc);
  if (err != 0) {
    Print("FAIL: PdfSave (basic) err=");
    PrintInt(err);
    Print("\n");
    return 1;
  }

  var rdr: int64 := PdfOpen("/tmp/pdf_outline_basic.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (basic)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 3) {
    Print("FAIL: expected 3 pages, got ");
    PrintInt(n);
    Print("\n");
    return 1;
  }
  Print("OK: basic outline (3 root items)\n");
  return 0;
}

fn testOutlineNested(): int64 {
  // 2-level hierarchy: 2 root items, each with 2 children
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (nested)\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p2: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p3: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p4: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Part 1");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Part 1 - Section 1");
  PdfSetFont(doc, p2, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p2, 72.0, 750.0, "Part 1 - Section 2");
  PdfSetFont(doc, p3, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p3, 72.0, 750.0, "Part 2");
  PdfSetFont(doc, p4, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p4, 72.0, 750.0, "Part 2 - Section 1");

  var root0: int64 := PdfOutlineAdd(doc, -1, "Part 1", p0);
  PdfOutlineAdd(doc, root0, "Section 1.1", p1);
  PdfOutlineAdd(doc, root0, "Section 1.2", p2);
  var root1: int64 := PdfOutlineAdd(doc, -1, "Part 2", p3);
  PdfOutlineAdd(doc, root1, "Section 2.1", p4);

  var err: int64 := PdfSave(doc, "/tmp/pdf_outline_nested.pdf");
  PdfFree(doc);
  if (err != 0) {
    Print("FAIL: PdfSave (nested)\n");
    return 1;
  }

  var rdr: int64 := PdfOpen("/tmp/pdf_outline_nested.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (nested)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 5) {
    Print("FAIL: nested page count expected 5, got ");
    PrintInt(n);
    Print("\n");
    return 1;
  }
  Print("OK: nested outline (2-level hierarchy)\n");
  return 0;
}

fn testOutlineNoItems(): int64 {
  // PDF without outlines should still save and open correctly
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (noitems)\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "No outline");

  var err: int64 := PdfSave(doc, "/tmp/pdf_outline_none.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (noitems)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_outline_none.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (noitems)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 1) {
    Print("FAIL: noitems page count\n");
    return 1;
  }
  Print("OK: no-outline PDF unaffected\n");
  return 0;
}

fn testOutlineWithMeta(): int64 {
  // Outline combined with metadata
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (meta)\n"); return 1; }

  PdfSetTitle(doc, "Outline+Meta Test");
  PdfSetAuthor(doc, "Test Suite");

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Intro");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Conclusion");

  PdfOutlineAdd(doc, -1, "Introduction", p0);
  PdfOutlineAdd(doc, -1, "Conclusion", p1);

  var err: int64 := PdfSave(doc, "/tmp/pdf_outline_meta.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (meta)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_outline_meta.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (meta)\n"); return 1; }

  var buf: int64 := alloc(256);
  PdfRdrGetTitle(rdr, buf, 256);
  var ok: int64 := 1;
  if (peek8(buf) == 0) { ok := 0; }
  free(buf, 256);
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);

  if (ok == 0 || n != 2) {
    Print("FAIL: outline+meta (titleOk=");
    PrintInt(ok);
    Print(" pages=");
    PrintInt(n);
    Print(")\n");
    return 1;
  }
  Print("OK: outline with metadata\n");
  return 0;
}

fn testOutlineSpecialChars(): int64 {
  // Titles with parentheses and backslashes must be escaped
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (special)\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "Special chars");

  PdfOutlineAdd(doc, -1, "Chapter (1) Notes", page);
  PdfOutlineAdd(doc, -1, "Appendix \\A", page);

  var err: int64 := PdfSave(doc, "/tmp/pdf_outline_special.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (special)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_outline_special.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (special)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 1) { Print("FAIL: special page count\n"); return 1; }
  Print("OK: special-char outline titles\n");
  return 0;
}

pub fn main(): int64 {
  if (testOutlineBasic()       != 0) { return 1; }
  if (testOutlineNested()      != 0) { return 1; }
  if (testOutlineNoItems()     != 0) { return 1; }
  if (testOutlineWithMeta()    != 0) { return 1; }
  if (testOutlineSpecialChars() != 0) { return 1; }
  Print("All WP-PDF-10 outline tests passed.\n");
  return 0;
}
