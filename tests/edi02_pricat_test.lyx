// tests/edi02_pricat_test.lyx — EDI-02: PRICAT + PARTIN + GS1 validation tests

unit tests.edi02_pricat_test;

import std.edi.core;
import std.edi.catalog;
import std.alloc;
import std.io;

fn hasTag(buf: int64, bufLen: int64, t0: int64, t1: int64, t2: int64): int64 {
    var i: int64 := 0;
    while (i + 2 < bufLen) {
        if (peek8(buf+i) == t0 && peek8(buf+i+1) == t1 && peek8(buf+i+2) == t2) {
            return 1;
        }
        i := i + 1;
    }
    return 0;
}

fn memEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
        if (peek8(a+i) != peek8(b+i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Tests 1-8: GS1 GTIN / GLN check digit validation
    // -------------------------------------------------------------------------
    var gtin8v: pchar := "01234565"c;
    if (EdiGtinCheck(gtin8v as int64, 8) != 1) {
        PrintLn("FAIL: valid GTIN-8 should return 1"c); ok := 0;
    } else { PrintLn("PASS: valid GTIN-8 returns 1"c); }

    var gtin8i: pchar := "01234560"c;
    if (EdiGtinCheck(gtin8i as int64, 8) != 0) {
        PrintLn("FAIL: invalid GTIN-8 should return 0"c); ok := 0;
    } else { PrintLn("PASS: invalid GTIN-8 returns 0"c); }

    var gtin13v: pchar := "4006381333931"c;
    if (EdiGtinCheck(gtin13v as int64, 13) != 1) {
        PrintLn("FAIL: valid GTIN-13 should return 1"c); ok := 0;
    } else { PrintLn("PASS: valid GTIN-13 returns 1"c); }

    var gtin13i: pchar := "4006381333932"c;
    if (EdiGtinCheck(gtin13i as int64, 13) != 0) {
        PrintLn("FAIL: invalid GTIN-13 should return 0"c); ok := 0;
    } else { PrintLn("PASS: invalid GTIN-13 returns 0"c); }

    var gtinBad: pchar := "123456789"c;
    if (EdiGtinCheck(gtinBad as int64, 9) != 0) {
        PrintLn("FAIL: wrong-length GTIN should return 0"c); ok := 0;
    } else { PrintLn("PASS: wrong-length GTIN returns 0"c); }

    var gln13v: pchar := "4012345123456"c;
    if (EdiGlnCheck(gln13v as int64, 13) != 1) {
        PrintLn("FAIL: valid GLN should return 1"c); ok := 0;
    } else { PrintLn("PASS: valid GLN returns 1"c); }

    var gln13i: pchar := "4012345123457"c;
    if (EdiGlnCheck(gln13i as int64, 13) != 0) {
        PrintLn("FAIL: invalid GLN should return 0"c); ok := 0;
    } else { PrintLn("PASS: invalid GLN returns 0"c); }

    var glnBad: pchar := "4012345"c;
    if (EdiGlnCheck(glnBad as int64, 7) != 0) {
        PrintLn("FAIL: wrong-length GLN should return 0"c); ok := 0;
    } else { PrintLn("PASS: wrong-length GLN returns 0"c); }

    // -------------------------------------------------------------------------
    // Test 9: EdiPricatWrite — single item has BGM + LIN + IMD + PRI tags
    // -------------------------------------------------------------------------
    var item1: int64 := alloc(EDI_PRICAT_ITEM_SIZE);
    var gtin1: pchar := "4006381333931"c;
    var desc1: pchar := "Sample Product"c;
    var curr1: pchar := "EUR"c;
    var unit1: pchar := "PCE"c;
    var vf1:   pchar := "20260101"c;
    var vt1:   pchar := "20261231"c;
    poke64(item1 + EDI_PRICAT_GTIN,        gtin1 as int64);
    poke64(item1 + EDI_PRICAT_GTINLEN,     13);
    poke64(item1 + EDI_PRICAT_DESC,        desc1 as int64);
    poke64(item1 + EDI_PRICAT_DESCLEN,     14);
    poke64(item1 + EDI_PRICAT_GROSSPRICE,  1999);
    poke64(item1 + EDI_PRICAT_NETPRICE,    1680);
    poke64(item1 + EDI_PRICAT_CURRENCY,    curr1 as int64);
    poke64(item1 + EDI_PRICAT_CURRENCYLEN, 3);
    poke64(item1 + EDI_PRICAT_UNIT,        unit1 as int64);
    poke64(item1 + EDI_PRICAT_UNITLEN,     3);
    poke64(item1 + EDI_PRICAT_VALIDFROM,   vf1 as int64);
    poke64(item1 + EDI_PRICAT_VALIDTO,     vt1 as int64);

    var out9: int64 := alloc(1024);
    var w9: int64 := EdiPricatWrite(item1, 1, out9, 1024);
    if (w9 <= 0) { PrintLn("FAIL: EdiPricatWrite returned <= 0"c); ok := 0; }
    else          { PrintLn("PASS: EdiPricatWrite returned bytes"c); }
    if (hasTag(out9, w9, 66, 71, 77) != 1) {   // BGM
        PrintLn("FAIL: EdiPricatWrite missing BGM"c); ok := 0;
    } else { PrintLn("PASS: EdiPricatWrite has BGM"c); }
    if (hasTag(out9, w9, 76, 73, 78) != 1) {   // LIN
        PrintLn("FAIL: EdiPricatWrite missing LIN"c); ok := 0;
    } else { PrintLn("PASS: EdiPricatWrite has LIN"c); }
    if (hasTag(out9, w9, 73, 77, 68) != 1) {   // IMD
        PrintLn("FAIL: EdiPricatWrite missing IMD"c); ok := 0;
    } else { PrintLn("PASS: EdiPricatWrite has IMD"c); }
    if (hasTag(out9, w9, 80, 82, 73) != 1) {   // PRI
        PrintLn("FAIL: EdiPricatWrite missing PRI"c); ok := 0;
    } else { PrintLn("PASS: EdiPricatWrite has PRI"c); }

    // -------------------------------------------------------------------------
    // Test 10: EdiPricatWrite + EdiPricatRead round-trip — GTIN, gross + net price
    // -------------------------------------------------------------------------
    var ritems: int64 := alloc(4 * EDI_PRICAT_ITEM_SIZE);
    var rcount: int64 := EdiPricatRead(out9, w9, ritems, 4);
    if (rcount != 1) {
        PrintLn("FAIL: EdiPricatRead should find 1 item"c); ok := 0;
    } else { PrintLn("PASS: EdiPricatRead count = 1"c); }

    var rGtinPtr: int64 := peek64(ritems + EDI_PRICAT_GTIN);
    var rGtinLen: int64 := peek64(ritems + EDI_PRICAT_GTINLEN);
    if (memEq(rGtinPtr, rGtinLen, gtin1 as int64, 13) != 1) {
        PrintLn("FAIL: PRICAT round-trip GTIN mismatch"c); ok := 0;
    } else { PrintLn("PASS: PRICAT round-trip GTIN matches"c); }

    var rGross: int64 := peek64(ritems + EDI_PRICAT_GROSSPRICE);
    if (rGross != 1999) {
        PrintLn("FAIL: PRICAT round-trip grossPrice should be 1999"c); ok := 0;
    } else { PrintLn("PASS: PRICAT round-trip grossPrice = 1999"c); }

    var rNet: int64 := peek64(ritems + EDI_PRICAT_NETPRICE);
    if (rNet != 1680) {
        PrintLn("FAIL: PRICAT round-trip netPrice should be 1680"c); ok := 0;
    } else { PrintLn("PASS: PRICAT round-trip netPrice = 1680"c); }

    free(ritems, 4 * EDI_PRICAT_ITEM_SIZE);
    free(out9, 1024);
    free(item1, EDI_PRICAT_ITEM_SIZE);

    // -------------------------------------------------------------------------
    // Test 11: EdiPartinWrite + EdiPartinRead round-trip — GLN, name, city
    // -------------------------------------------------------------------------
    var party: int64 := alloc(EDI_PARTY_SIZE);
    var pGln:  pchar := "4012345123456"c;
    var pName: pchar := "ACME GmbH"c;
    var pStr:  pchar := "Hauptstr. 1"c;
    var pCity: pchar := "Berlin"c;
    var pPost: pchar := "10115"c;
    var pCtry: pchar := "DE"c;
    var pRole: pchar := "SU"c;
    poke64(party + EDI_PARTY_GLN,       pGln  as int64);
    poke64(party + EDI_PARTY_GLNLEN,    13);
    poke64(party + EDI_PARTY_NAME,      pName as int64);
    poke64(party + EDI_PARTY_NAMELEN,   9);
    poke64(party + EDI_PARTY_STREET,    pStr  as int64);
    poke64(party + EDI_PARTY_STREETL,   11);
    poke64(party + EDI_PARTY_CITY,      pCity as int64);
    poke64(party + EDI_PARTY_CITYL,     6);
    poke64(party + EDI_PARTY_POSTCODE,  pPost as int64);
    poke64(party + EDI_PARTY_POSTCODEL, 5);
    poke64(party + EDI_PARTY_COUNTRY,   pCtry as int64);
    poke64(party + EDI_PARTY_COUNTRYL,  2);
    poke64(party + EDI_PARTY_ROLE,      pRole as int64);
    poke64(party + EDI_PARTY_ROLEL,     2);

    var out11: int64 := alloc(512);
    var w11:   int64 := EdiPartinWrite(party, out11, 512);
    if (w11 <= 0) { PrintLn("FAIL: EdiPartinWrite returned <= 0"c); ok := 0; }
    else           { PrintLn("PASS: EdiPartinWrite returned bytes"c); }
    if (hasTag(out11, w11, 66, 71, 77) != 1) {   // BGM
        PrintLn("FAIL: EdiPartinWrite missing BGM"c); ok := 0;
    } else { PrintLn("PASS: EdiPartinWrite has BGM"c); }
    if (hasTag(out11, w11, 78, 65, 68) != 1) {   // NAD
        PrintLn("FAIL: EdiPartinWrite missing NAD"c); ok := 0;
    } else { PrintLn("PASS: EdiPartinWrite has NAD"c); }

    var rParty: int64 := alloc(EDI_PARTY_SIZE);
    var r11: int64 := EdiPartinRead(out11, w11, rParty);
    if (r11 != EDI_OK) {
        PrintLn("FAIL: EdiPartinRead should return EDI_OK"c); ok := 0;
    } else { PrintLn("PASS: EdiPartinRead returns EDI_OK"c); }

    var rGlnPtr: int64 := peek64(rParty + EDI_PARTY_GLN);
    var rGlnLen: int64 := peek64(rParty + EDI_PARTY_GLNLEN);
    if (memEq(rGlnPtr, rGlnLen, pGln as int64, 13) != 1) {
        PrintLn("FAIL: PARTIN round-trip GLN mismatch"c); ok := 0;
    } else { PrintLn("PASS: PARTIN round-trip GLN matches"c); }

    var rNamePtr: int64 := peek64(rParty + EDI_PARTY_NAME);
    var rNameLen: int64 := peek64(rParty + EDI_PARTY_NAMELEN);
    if (memEq(rNamePtr, rNameLen, pName as int64, 9) != 1) {
        PrintLn("FAIL: PARTIN round-trip name mismatch"c); ok := 0;
    } else { PrintLn("PASS: PARTIN round-trip name matches"c); }

    var rCityPtr: int64 := peek64(rParty + EDI_PARTY_CITY);
    var rCityLen: int64 := peek64(rParty + EDI_PARTY_CITYL);
    if (memEq(rCityPtr, rCityLen, pCity as int64, 6) != 1) {
        PrintLn("FAIL: PARTIN round-trip city mismatch"c); ok := 0;
    } else { PrintLn("PASS: PARTIN round-trip city matches"c); }

    free(rParty, EDI_PARTY_SIZE);
    free(out11, 512);
    free(party, EDI_PARTY_SIZE);

    // -------------------------------------------------------------------------
    // Test 12: EdiPricatWrite + EdiPricatRead with 3 items
    // -------------------------------------------------------------------------
    var items3: int64 := alloc(3 * EDI_PRICAT_ITEM_SIZE);
    var g3a: pchar := "4006381333931"c;
    var g3b: pchar := "01234565"c;
    var g3c: pchar := "4012345123456"c;

    var it0: int64 := items3 + 0 * EDI_PRICAT_ITEM_SIZE;
    poke64(it0 + EDI_PRICAT_GTIN,        g3a as int64);
    poke64(it0 + EDI_PRICAT_GTINLEN,     13);
    poke64(it0 + EDI_PRICAT_GROSSPRICE,  500);
    poke64(it0 + EDI_PRICAT_NETPRICE,    400);
    poke64(it0 + EDI_PRICAT_DESC,        0);
    poke64(it0 + EDI_PRICAT_DESCLEN,     0);
    poke64(it0 + EDI_PRICAT_CURRENCY,    0);
    poke64(it0 + EDI_PRICAT_CURRENCYLEN, 0);
    poke64(it0 + EDI_PRICAT_UNIT,        0);
    poke64(it0 + EDI_PRICAT_UNITLEN,     0);
    poke64(it0 + EDI_PRICAT_VALIDFROM,   0);
    poke64(it0 + EDI_PRICAT_VALIDTO,     0);

    var it1: int64 := items3 + 1 * EDI_PRICAT_ITEM_SIZE;
    poke64(it1 + EDI_PRICAT_GTIN,        g3b as int64);
    poke64(it1 + EDI_PRICAT_GTINLEN,     8);
    poke64(it1 + EDI_PRICAT_GROSSPRICE,  2500);
    poke64(it1 + EDI_PRICAT_NETPRICE,    2100);
    poke64(it1 + EDI_PRICAT_DESC,        0);
    poke64(it1 + EDI_PRICAT_DESCLEN,     0);
    poke64(it1 + EDI_PRICAT_CURRENCY,    0);
    poke64(it1 + EDI_PRICAT_CURRENCYLEN, 0);
    poke64(it1 + EDI_PRICAT_UNIT,        0);
    poke64(it1 + EDI_PRICAT_UNITLEN,     0);
    poke64(it1 + EDI_PRICAT_VALIDFROM,   0);
    poke64(it1 + EDI_PRICAT_VALIDTO,     0);

    var it2: int64 := items3 + 2 * EDI_PRICAT_ITEM_SIZE;
    poke64(it2 + EDI_PRICAT_GTIN,        g3c as int64);
    poke64(it2 + EDI_PRICAT_GTINLEN,     13);
    poke64(it2 + EDI_PRICAT_GROSSPRICE,  100);
    poke64(it2 + EDI_PRICAT_NETPRICE,    80);
    poke64(it2 + EDI_PRICAT_DESC,        0);
    poke64(it2 + EDI_PRICAT_DESCLEN,     0);
    poke64(it2 + EDI_PRICAT_CURRENCY,    0);
    poke64(it2 + EDI_PRICAT_CURRENCYLEN, 0);
    poke64(it2 + EDI_PRICAT_UNIT,        0);
    poke64(it2 + EDI_PRICAT_UNITLEN,     0);
    poke64(it2 + EDI_PRICAT_VALIDFROM,   0);
    poke64(it2 + EDI_PRICAT_VALIDTO,     0);

    var out12: int64 := alloc(2048);
    var w12:   int64 := EdiPricatWrite(items3, 3, out12, 2048);
    if (w12 <= 0) { PrintLn("FAIL: EdiPricatWrite (3 items) returned <= 0"c); ok := 0; }
    else           { PrintLn("PASS: EdiPricatWrite (3 items) returned bytes"c); }

    var ritems3: int64 := alloc(6 * EDI_PRICAT_ITEM_SIZE);
    var rcount3: int64 := EdiPricatRead(out12, w12, ritems3, 6);
    if (rcount3 != 3) {
        PrintLn("FAIL: EdiPricatRead 3-item should find 3"c); ok := 0;
    } else { PrintLn("PASS: EdiPricatRead 3-item count = 3"c); }

    var ri1: int64 := ritems3 + 1 * EDI_PRICAT_ITEM_SIZE;
    var r1GtinPtr: int64 := peek64(ri1 + EDI_PRICAT_GTIN);
    var r1GtinLen: int64 := peek64(ri1 + EDI_PRICAT_GTINLEN);
    if (memEq(r1GtinPtr, r1GtinLen, g3b as int64, 8) != 1) {
        PrintLn("FAIL: 3-item PRICAT item[1] GTIN mismatch"c); ok := 0;
    } else { PrintLn("PASS: 3-item PRICAT item[1] GTIN matches"c); }

    var r1Gross: int64 := peek64(ri1 + EDI_PRICAT_GROSSPRICE);
    if (r1Gross != 2500) {
        PrintLn("FAIL: 3-item PRICAT item[1] grossPrice should be 2500"c); ok := 0;
    } else { PrintLn("PASS: 3-item PRICAT item[1] grossPrice = 2500"c); }

    free(ritems3, 6 * EDI_PRICAT_ITEM_SIZE);
    free(out12, 2048);
    free(items3, 3 * EDI_PRICAT_ITEM_SIZE);

    if (ok != 0) { PrintLn("=== EDI-02: ALL PASS ==="c); }
    else          { PrintLn("=== EDI-02: SOME FAIL ==="c); }
    return ok;
}
