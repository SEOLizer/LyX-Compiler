// WP-05: std/audio — WAV round-trip test (offline, no audio hardware required)
// Tests: AudioGenTone → WAVSaveFile → WAVParse → verify metadata
//
// Expected output:
//   1
//   88200
//   44100
//   1
//   16
//   1000
//   88200
//   PASS

import std.io;
import std.audio;

fn main(): int64 {
  // 1. Generate 440Hz square-wave: 1000ms, 44100 Hz, mono, 16-bit, amplitude 16384
  var sizePtr: int64 := mmap(0, 8, 3, 34, -1, 0);
  var pcm: int64 := AudioGenTone(440, 1000, 44100, 1, 16384, sizePtr);
  var pcmSize: int64 := peek64(sizePtr);
  munmap(sizePtr, 8);

  if (pcm == 0) {
    PrintStr("FAIL: AudioGenTone returned null\n");
    return 1;
  }

  PrintInt(1);        // genOK
  PrintStr("\n");
  PrintInt(pcmSize);  // expected: 44100 * 1 * 2 = 88200
  PrintStr("\n");

  // 2. Save as WAV
  var saveResult: int64 := WAVSaveFile("/tmp/wp05_test_440.wav"c, pcm, pcmSize, 44100, 1, 16);
  munmap(pcm, pcmSize);

  if (saveResult != AUDIO_OK) {
    PrintStr("FAIL: WAVSaveFile\n");
    return 1;
  }

  // 3. Parse back
  var info: AudioInfo;
  var parseResult: int64 := WAVParse("/tmp/wp05_test_440.wav"c, info);
  if (parseResult != AUDIO_OK) {
    PrintStr("FAIL: WAVParse\n");
    return 1;
  }

  PrintInt(info.sampleRate);
  PrintStr("\n");
  PrintInt(info.channels);
  PrintStr("\n");
  PrintInt(info.bitsPerSample);
  PrintStr("\n");
  PrintInt(info.durationMs);
  PrintStr("\n");
  PrintInt(info.dataSize);
  PrintStr("\n");

  // 4. Verify fields
  var ok: int64 := 1;
  if (info.sampleRate != 44100)    { ok := 0; }
  if (info.channels != 1)          { ok := 0; }
  if (info.bitsPerSample != 16)    { ok := 0; }
  if (info.durationMs < 990)       { ok := 0; }
  if (info.durationMs > 1010)      { ok := 0; }
  if (info.dataSize != 88200)      { ok := 0; }

  if (ok != 0) {
    PrintStr("PASS\n");
  } else {
    PrintStr("FAIL: metadata mismatch\n");
  }

  return 0;
}
