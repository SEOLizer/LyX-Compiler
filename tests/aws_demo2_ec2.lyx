// tests/aws_demo2_ec2.lyx — AWS SDK Demo: EC2 instance lifecycle
// WP-AWS-15

unit tests.aws_demo2_ec2;

import std.cloud.aws.core;
import std.cloud.ec2;
import std.cloud.iam;
import std.alloc;
import std.io;

pub fn main(argc: int64, argv: pchar): int64 {
    PrintLn("=== AWS EC2 Demo ==="c);

    var creds: AWSCreds := AWSCredentialsDefault();
    if (creds.accessKey == 0) {
        PrintLn("Error: no credentials found."c);
        return 1;
    }

    var region: pchar := "eu-central-1"c;
    if (creds.region != 0) { region := creds.region as pchar; }

    var client: EC2Client := EC2Connect(creds, region);

    // 1. Describe availability zones
    PrintLn("--- Availability Zones ---"c);
    var azs: int64 := EC2DescribeAvailabilityZones(client);
    if (azs != 0) { PrintLn(azs as pchar); free(azs, StrLen(azs as pchar)+1); }

    // 2. Describe existing instances
    PrintLn("--- Running Instances ---"c);
    var instances: int64 := EC2DescribeInstances(client);
    if (instances != 0) {
        PrintLn(instances as pchar);
        free(instances, StrLen(instances as pchar)+1);
    } else {
        PrintLn("(no instances or error)"c);
    }

    // 3. List key pairs
    PrintLn("--- Key Pairs ---"c);
    var keys: int64 := EC2DescribeKeyPairs(client);
    if (keys != 0) { PrintLn(keys as pchar); free(keys, StrLen(keys as pchar)+1); }

    // 4. List security groups
    PrintLn("--- Security Groups ---"c);
    var sgs: int64 := EC2DescribeSecurityGroups(client);
    if (sgs != 0) { PrintLn(sgs as pchar); free(sgs, StrLen(sgs as pchar)+1); }

    // 5. List VPCs
    PrintLn("--- VPCs ---"c);
    var vpcs: int64 := EC2DescribeVpcs(client);
    if (vpcs != 0) { PrintLn(vpcs as pchar); free(vpcs, StrLen(vpcs as pchar)+1); }

    // 6. Launch a t3.micro instance (Amazon Linux 2023 AMI - region specific, demo only)
    PrintLn("--- Launch Instance (demo) ---"c);
    // Use a placeholder AMI — real AMI IDs are region-specific
    // ami-0abcdef1234567890 is a placeholder; real usage requires valid AMI
    var instanceId: int64 := EC2RunInstances(client,
                                              "ami-0abcdef1234567890"c, // placeholder
                                              "t3.micro"c,
                                              1, 1,
                                              0 as pchar,  // key name (optional)
                                              0 as pchar,  // subnet (default VPC)
                                              0 as pchar); // security group
    if (instanceId != 0) {
        Print("Launched: "c); PrintLn(instanceId as pchar);

        // 7. Get instance details
        var inst: EC2Instance := EC2DescribeInstanceById(client, instanceId as pchar);
        printKV("State", inst.state as pchar);
        EC2InstanceFree(inst);

        // 8. Terminate instance
        PrintLn("--- Terminate Instance ---"c);
        var ok: int64 := EC2TerminateInstances(client, instanceId as pchar);
        if (ok == 1) { PrintLn("Terminated"c); } else { PrintLn("Terminate error"c); }
        free(instanceId, StrLen(instanceId as pchar)+1);
    } else {
        PrintLn("Launch skipped (AMI placeholder)"c);
    }

    // 9. Describe volumes
    PrintLn("--- EBS Volumes ---"c);
    var vols: int64 := EC2DescribeVolumes(client);
    if (vols != 0) { PrintLn(vols as pchar); free(vols, StrLen(vols as pchar)+1); }

    EC2Close(client);

    // 10. Check IAM caller identity via STS
    PrintLn("--- IAM/STS Caller Identity ---"c);
    var stsCreds: AWSCreds := AWSCredentialsDefault();
    var stsClient: STSClient := STSConnect(stsCreds, region);
    var identity: int64 := STSGetCallerIdentity(stsClient);
    if (identity != 0) { PrintLn(identity as pchar); free(identity, StrLen(identity as pchar)+1); }
    STSClose(stsClient);

    PrintLn("=== Done ==="c);
    return 0;
}

fn printKV(k: pchar, v: pchar) {
    Print(k); Print(": "c);
    if (v != 0 as pchar) { PrintLn(v); } else { PrintLn("(none)"c); }
}
