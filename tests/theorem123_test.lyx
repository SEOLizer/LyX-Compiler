// tests/theorem123_test.lyx
// Selbstpruefende Testbatterie fuer std.theorem123 (Alon/Yuster 1995).
//
// Sollwerte sind VON HAND nachgerechnet, nicht aus derselben Formel gezogen,
// die hier geprueft wird. Fuer eine Gleichverteilung auf {0, 1, 2} etwa:
// neun geordnete Paare, davon sieben mit |Differenz| <= 1 — also 7/9.
//
// Der wichtigste Fall ist der letzte: n Atome im Abstand knapp ueber 1. Dort
// geht das Verhaeltnis gegen 3, erreicht die 3 aber NIE. Ein Test, der nur
// "Ungleichung haelt" prueft, waere auch von einer Umsetzung erfuellt, die
// immer 1 zurueckgibt; dieser misst zusaetzlich, dass der Wert dort ankommt,
// wo er hingehoert.

unit main;

import std.io;
import std.theorem123;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

// Relativer Vergleich; tol als Argument, nicht als con (#1499).
fn CheckRel(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  var d: f64 := AbsF64(got - want);
  var s: f64 := AbsF64(want);
  if (s < 1.0) { s := 1.0; }
  if (d / s <= tol) {
    PrintStr("PASS "c); PrintStrLn(name);
  } else {
    PrintStr("FAIL "c); PrintStr(name);
    PrintStr(": erhalten "c); PrintF64(got);
    PrintStr(" erwartet "c); PrintF64(want); PrintLn(""c);
    _fails := _fails + 1;
  }
}

fn CheckWahr(name: pchar, got: bool): void {
  _checks := _checks + 1;
  if (got) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStr(name); PrintStrLn(" (erwartet: wahr)"c); _fails := _fails + 1; }
}

fn CheckFalsch(name: pchar, got: bool): void {
  _checks := _checks + 1;
  if (!got) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStr(name); PrintStrLn(" (erwartet: falsch)"c); _fails := _fails + 1; }
}

fn main(): int64 {
  // ── Die Schranke selbst ────────────────────────────────────────────────
  // 2 * ceil(b/a) - 1. Der namensgebende Fall a=1, b=2 gibt 3.
  CheckRel("Schranke(1,2) = 3"c, T123Schranke(1.0, 2.0), 3.0, 0.000000001);
  CheckRel("Schranke(1,1) = 1"c, T123Schranke(1.0, 1.0), 1.0, 0.000000001);
  CheckRel("Schranke(1,3) = 5"c, T123Schranke(1.0, 3.0), 5.0, 0.000000001);
  // Die Aufrundung ist die Aussage: b/a = 2.5 zaehlt wie 3.
  CheckRel("Schranke(1,2.5) = 5"c, T123Schranke(1.0, 2.5), 5.0, 0.000000001);
  // Und sie springt schon knapp ueber der ganzen Zahl.
  CheckRel("Schranke(1,2.0001) = 5"c, T123Schranke(1.0, 2.0001), 5.0, 0.000000001);
  CheckRel("Schranke(2,4) = 3"c, T123Schranke(2.0, 4.0), 3.0, 0.000000001);

  // ── Gleichverteilung auf {0,1,2} ───────────────────────────────────────
  // Neun geordnete Paare. |Diff| <= 1 trifft sieben davon (alle ausser
  // (0,2) und (2,0)), |Diff| <= 2 alle neun.
  var w: int64 := alloc(3 * 8);
  var g: int64 := alloc(3 * 8);
  pokef64(w + 0, 0.0); pokef64(w + 8, 1.0); pokef64(w + 16, 2.0);
  var drittel: f64 := 1.0 / 3.0;
  pokef64(g + 0, drittel); pokef64(g + 8, drittel); pokef64(g + 16, 1.0 - drittel - drittel);
  CheckRel("P(<=1) auf {0,1,2} = 7/9"c, T123NahePaar(w, g, 3, 1.0), 7.0 / 9.0, 0.000000001);
  CheckRel("P(<=2) auf {0,1,2} = 1"c, T123NahePaar(w, g, 3, 2.0), 1.0, 0.000000001);
  CheckRel("Verhaeltnis = 9/7"c, T123VerhaeltnisGewichtet(w, g, 3, 1.0, 2.0), 9.0 / 7.0, 0.000000001);
  CheckWahr("123 gilt auf {0,1,2}"c, T123Gilt(w, g, 3));

  // P(<=0) ist die Wahrscheinlichkeit, denselben Wert zu ziehen: 3 * (1/3)^2.
  CheckRel("P(<=0) = 1/3"c, T123NahePaar(w, g, 3, 0.0), 1.0 / 3.0, 0.000000001);

  // ── Stichprobe: dieselbe Verteilung, andere Darstellung ────────────────
  var s: int64 := alloc(3 * 8);
  pokef64(s + 0, 0.0); pokef64(s + 8, 1.0); pokef64(s + 16, 2.0);
  CheckRel("Stichprobe P(<=1) = 7/9"c, T123NahePaarStichprobe(s, 3, 1.0), 7.0 / 9.0, 0.000000001);
  CheckWahr("123 gilt fuer die Stichprobe"c, T123GiltStichprobe(s, 3));

  // Die Diagonale gehoert dazu: eine EINELEMENTIGE Stichprobe hat P(<=0) = 1,
  // nicht 0. Wer i == j weglaesst, bekommt hier 0 und teilt spaeter dadurch.
  var e: int64 := alloc(8);
  pokef64(e, 42.0);
  CheckRel("ein Wert: P(<=0) = 1"c, T123NahePaarStichprobe(e, 1, 0.0), 1.0, 0.000000001);

  // ── Weit auseinander: nur die Diagonale ist nah ────────────────────────
  var f: int64 := alloc(2 * 8);
  var fg: int64 := alloc(2 * 8);
  pokef64(f + 0, 0.0); pokef64(f + 8, 1000.0);
  pokef64(fg + 0, 0.5); pokef64(fg + 8, 0.5);
  CheckRel("weit entfernt: P(<=1) = 1/2"c, T123NahePaar(f, fg, 2, 1.0), 0.5, 0.000000001);
  CheckRel("weit entfernt: Verhaeltnis = 1"c,
           T123VerhaeltnisGewichtet(f, fg, 2, 1.0, 2.0), 1.0, 0.000000001);
  CheckWahr("123 gilt auch dort"c, T123Gilt(f, fg, 2));

  // ── Der Fall, der die Schranke ausreizt ────────────────────────────────
  //
  // n Atome im Abstand 1.0001, gleichgewichtet. Innerhalb von 1 liegt nur die
  // Diagonale: n Paare. Innerhalb von 2 liegen zusaetzlich die direkten
  // Nachbarn — 2*(n-1) Paare, denn 2*1.0001 > 2. Also
  //
  //     P(<=1) = n/n^2,  P(<=2) = (3n-2)/n^2,  Verhaeltnis = (3n-2)/n = 3 - 2/n.
  //
  // Fuer n = 50 sind das 2.96: nah an 3, aber darunter — und das muss so
  // bleiben, sonst waere die Schranke nicht scharf oder die Rechnung falsch.
  var n: int64 := 50;
  var kw: int64 := alloc(n * 8);
  var kg: int64 := alloc(n * 8);
  var i: int64 := 0;
  var gew: f64 := 1.0 / (n as f64);
  var restgewicht: f64 := 1.0;
  while (i < n) {
    pokef64(kw + i * 8, (i as f64) * 1.0001);
    if (i < n - 1) { pokef64(kg + i * 8, gew); restgewicht := restgewicht - gew; }
    else { pokef64(kg + i * 8, restgewicht); }   // Rest, damit die Summe exakt 1 ist
    i := i + 1;
  }
  var pa: f64 := T123NahePaar(kw, kg, n, 1.0);
  var pb: f64 := T123NahePaar(kw, kg, n, 2.0);
  CheckRel("Kette: P(<=1) = 1/n"c, pa, 1.0 / (n as f64), 0.000001);
  CheckRel("Kette: P(<=2) = (3n-2)/n^2"c, pb,
           (3.0 * (n as f64) - 2.0) / ((n as f64) * (n as f64)), 0.000001);
  var v: f64 := pb / pa;
  CheckRel("Kette: Verhaeltnis = 3 - 2/n"c, v, 3.0 - 2.0 / (n as f64), 0.000001);
  // Die eigentliche Aussage: nah an 3, aber STRIKT darunter.
  CheckWahr("Kette: Verhaeltnis < 3"c, v < 3.0);
  CheckWahr("Kette: Verhaeltnis > 2.9"c, v > 2.9);
  CheckWahr("Kette: 123 gilt"c, T123Gilt(kw, kg, n));

  // Verallgemeinerung auf derselben Kette: a=1, b=3 hat Schranke 5.
  // Innerhalb von 3 liegen Nachbarn bis Abstand 2 (2*1.0001 <= 3), also
  // n + 2*(n-1) + 2*(n-2) Paare = 5n - 6.
  var pc: f64 := T123NahePaar(kw, kg, n, 3.0);
  CheckRel("Kette: P(<=3) = (5n-6)/n^2"c, pc,
           (5.0 * (n as f64) - 6.0) / ((n as f64) * (n as f64)), 0.000001);
  CheckWahr("Kette: verallgemeinerte Ungleichung a=1,b=3"c,
            T123GiltAllgemein(kw, kg, n, 1.0, 3.0));

  // ── Fehlerfaelle melden statt zu raten ─────────────────────────────────
  // Jeder gibt NaN zurueck; ein stiller Ersatzwert waere hier besonders
  // gefaehrlich, weil 0 und 1 beide plausibel aussehen.
  CheckWahr("leere Verteilung meldet"c, T123IstFehler(T123NahePaar(w, g, 0, 1.0)));
  CheckWahr("negatives t meldet"c, T123IstFehler(T123NahePaar(w, g, 3, 0.0 - 1.0)));
  CheckWahr("a <= 0 meldet"c, T123IstFehler(T123Schranke(0.0, 2.0)));
  CheckWahr("b < a meldet"c, T123IstFehler(T123Schranke(2.0, 1.0)));

  var bad: int64 := alloc(2 * 8);
  pokef64(bad + 0, 0.5); pokef64(bad + 8, 0.2);          // Summe 0.7
  CheckWahr("Gewichtssumme != 1 meldet"c, T123IstFehler(T123NahePaar(f, bad, 2, 1.0)));
  pokef64(bad + 0, 1.5); pokef64(bad + 8, 0.0 - 0.5);    // negatives Gewicht
  CheckWahr("negatives Gewicht meldet"c, T123IstFehler(T123NahePaar(f, bad, 2, 1.0)));
  // Und die Pruefung faellt dann auf false, statt eine Verletzung zu behaupten.
  CheckFalsch("kaputte Eingabe gilt nicht"c, T123Gilt(f, bad, 2));

  PrintStr("\n"c);
  PrintInt(_checks); PrintStr(" Pruefungen, "c);
  PrintInt(_fails); PrintStrLn(" FAIL"c);
  if (_fails == 0) { PrintStrLn("OK: std.theorem123"c); return 0; }
  return 1;
}
