// #2353: memcpy ueber alle Laengen, die die Wege des Helfers trennen.
//
// Geprueft wird der WERT jedes einzelnen Byte, nicht eine Invariante wie
// "erstes Byte stimmt" — und zusaetzlich, dass NEBEN dem Zielbereich nichts
// geschrieben wurde. Der 64-Byte-Weg kopiert den Schwanz ueber
// [rdi+rdx-64], also GENAU bis an das Ende; ein Vorzeichen- oder
// Offsetfehler dort schreibt hinter das Ziel, und nur ein Waechter findet
// das.
import src.std.io

con WACHE: int64 := 16;   // Waechterbytes vor und hinter dem Ziel
con WERT:  int64 := 170;  // 0xAA

fn pruefeLaenge(n: int64): int64 {
  var quelle: int64 := alloc(14000);
  var ziel:   int64 := alloc(14000 + 2 * WACHE);

  // Quelle mit einem laengenabhaengigen Muster fuellen: dieselbe Laenge
  // zweimal zu pruefen wuerde einen stehengebliebenen Puffer nicht zeigen.
  var i: int64 := 0;
  while (i < n) {
    poke8(quelle + i, (i * 7 + n) & 255);
    i := i + 1;
  }
  // Ziel samt Waechtern auf WERT
  i := 0;
  while (i < n + 2 * WACHE) { poke8(ziel + i, WERT); i := i + 1; }

  var rueck: int64 := memcpy(ziel + WACHE, quelle, n);

  // 1. Rueckgabe ist der Zielzeiger (C-Semantik, #1842)
  if (rueck != ziel + WACHE) {
    PrintStr("  n="c); PrintInt(n); PrintStrLn(": Rueckgabe falsch"c);
    return 1;
  }
  // 2. jedes kopierte Byte
  i := 0;
  while (i < n) {
    var soll: int64 := (i * 7 + n) & 255;
    var ist:  int64 := peek8(ziel + WACHE + i);
    if (ist != soll) {
      PrintStr("  n="c); PrintInt(n); PrintStr(" Byte "c); PrintInt(i);
      PrintStr(": soll "c); PrintInt(soll); PrintStr(" ist "c); PrintInt(ist);
      PrintStrLn(""c);
      return 1;
    }
    i := i + 1;
  }
  // 3. Waechter VOR dem Ziel
  i := 0;
  while (i < WACHE) {
    if (peek8(ziel + i) != WERT) {
      PrintStr("  n="c); PrintInt(n);
      PrintStr(": vor dem Ziel ueberschrieben, Abstand "c);
      PrintInt(WACHE - i); PrintStrLn(""c);
      return 1;
    }
    i := i + 1;
  }
  // 4. Waechter HINTER dem Ziel
  i := 0;
  while (i < WACHE) {
    if (peek8(ziel + WACHE + n + i) != WERT) {
      PrintStr("  n="c); PrintInt(n);
      PrintStr(": hinter dem Ziel ueberschrieben, Abstand "c);
      PrintInt(i); PrintStrLn(""c);
      return 1;
    }
    i := i + 1;
  }
  return 0;
}

fn main(): int64 {
  var fehler: int64 := 0;
  var geprueft: int64 := 0;

  // Alle Laengen 0..600 lueckenlos: darin liegen die Wegegrenzen des
  // Helfers (16, 32, 64, 512) und die Vorfiltergrenze.
  var n: int64 := 0;
  while (n <= 600) {
    fehler := fehler + pruefeLaenge(n);
    geprueft := geprueft + 1;
    n := n + 1;
  }
  // Grob bis 13000, damit der 64-Byte-Weg und die Grenze 12288 beide
  // beidseitig getroffen werden.
  n := 601;
  while (n <= 13000) {
    fehler := fehler + pruefeLaenge(n);
    geprueft := geprueft + 1;
    n := n + 37;
  }
  // Die Grenzen EINZELN, jeweils davor, darauf und dahinter.
  var g: [12]int64;
  g[0] := 63;  g[1] := 64;    g[2] := 65;
  g[3] := 511; g[4] := 512;   g[5] := 513;
  g[6] := 12287; g[7] := 12288; g[8] := 12289;
  g[9] := 127; g[10] := 128;  g[11] := 129;
  var k: int64 := 0;
  while (k < 12) {
    fehler := fehler + pruefeLaenge(g[k]);
    geprueft := geprueft + 1;
    k := k + 1;
  }

  PrintStr("geprueft: "c); PrintInt(geprueft);
  PrintStr(" Laengen, Fehler: "c); PrintInt(fehler); PrintStrLn(""c);
  if (fehler == 0) { PrintStrLn("ALL PASS"c); return 0; }
  PrintStrLn("FAIL"c);
  return 1;
}
