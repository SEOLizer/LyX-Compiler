// #2421: Eine Struct-Zuweisung an eine Modulvariable kopiert den INHALT.
//
// Bis 1.2.33B wurde der ZEIGER überschrieben: die Globale zeigte danach in
// den Rahmen des Aufrufers, und sobald der weiterbenutzt wurde, standen
// Stapeladressen in den Feldern.
//
// ZWEI NACHWEISE, und der zweite ist der wichtigere:
//
//  1. Die vier Formen aus der Meldung liefern alle denselben Wert. Dieser
//     Test allein wäre aber blind für den Kern: direkt nach der Zuweisung
//     stimmt der Wert auch im kaputten Zustand. Deshalb läuft erst eine
//     tiefe Rekursion, die den Rahmen überschreibt, und DANN wird gelesen.
//
//  2. Die Quelle wird nach der Zuweisung GEÄNDERT. Wandert die Globale mit,
//     hält sie einen Verweis statt einer Kopie. Dieser Fall war in der
//     Meldung als „richtig" eingeordnet — er war es nicht, er fiel nur nicht
//     auf, weil der Rahmen von `main` weiterlebt.
unit main;
import std.io;
import std.string;

pub type TR = struct { Left: int64; Top: int64; Right: int64; Bottom: int64; };
pub type TZwei = struct { a: int64; b: int64; };

var g_a: TR;
var g_b: TR;
var g_c: TR;
var g_d: TR;
var g_alias: TZwei;

var _fehler: int64 := 0;

fn mk(a: int64, b: int64, c: int64, d: int64): TR {
  var r: TR;
  r.Left := a; r.Top := b; r.Right := c; r.Bottom := d;
  return r;
}

fn NimmDirekt(r: TR): void { g_b := r; }

fn NimmUeberLokal(r: TR): void {
  var k: TR := r;
  g_c := k;
}

fn NimmFelder(r: TR): void {
  g_d.Left := r.Left;
  g_d.Top := r.Top;
  g_d.Right := r.Right;
  g_d.Bottom := r.Bottom;
}

// Benutzt den Stapel, damit ein Verweis auf einen alten Rahmen auffällt.
fn Tief(n: int64): int64 {
  var fuell: TR := mk(n, n, n, n);
  if (n <= 0) { return fuell.Left; }
  return Tief(n - 1) + 1;
}

fn pruefe(name: pchar, r: int64, soll1: int64, soll2: int64, soll3: int64, soll4: int64): void {
  var ok: int64 := 0;
  if (peek64(r) == soll1 && peek64(r + 8) == soll2
      && peek64(r + 16) == soll3 && peek64(r + 24) == soll4) { ok := 1; }
  if (ok != 0) { PrintStr("PASS "c); PrintStrLn(name); }
  else {
    PrintStr("FAIL "c); PrintStr(name); PrintStr(" -> "c);
    PrintStr(IntToStr(peek64(r))); PrintStr(" "c);
    PrintStr(IntToStr(peek64(r + 8))); PrintStr(" "c);
    PrintStr(IntToStr(peek64(r + 16))); PrintStr(" "c);
    PrintStrLn(IntToStr(peek64(r + 24)));
    _fehler := _fehler + 1;
  }
}

fn main(): int64 {
  var lokal: TR := mk(1, 2, 21, 12);
  g_a := lokal;
  NimmDirekt(mk(1, 2, 21, 12));
  NimmUeberLokal(mk(1, 2, 21, 12));
  NimmFelder(mk(1, 2, 21, 12));

  // ERST den Stapel überschreiben, dann lesen. Ohne diesen Schritt ist der
  // Test auch im kaputten Zustand grün.
  Tief(20);

  pruefe("1 local_nach_modulvariable"c, g_a as int64, 1, 2, 21, 12);
  pruefe("2 parameter_direkt"c, g_b as int64, 1, 2, 21, 12);
  pruefe("3 parameter_ueber_lokale_kopie"c, g_c as int64, 1, 2, 21, 12);
  pruefe("4 feldweise"c, g_d as int64, 1, 2, 21, 12);

  // Der zweite Nachweis: die Globale darf nicht mitwandern.
  var q: TZwei;
  q.a := 1; q.b := 2;
  g_alias := q;
  q.a := 777; q.b := 888;
  if (g_alias.a == 1 && g_alias.b == 2) {
    PrintStrLn("PASS 5 zuweisung_kopiert_statt_zu_verweisen"c);
  } else {
    PrintStr("FAIL 5 zuweisung_kopiert_statt_zu_verweisen -> "c);
    PrintStr(IntToStr(g_alias.a)); PrintStr(" "c); PrintStrLn(IntToStr(g_alias.b));
    _fehler := _fehler + 1;
  }

  // Und die Gegenrichtung: die Quelle darf von der Globalen nicht verändert
  // werden. Ohne diese Prüfung wäre auch eine Umsetzung erfüllt, die in
  // beide Richtungen verknüpft.
  g_alias.a := 5;
  if (q.a == 777) { PrintStrLn("PASS 6 schreiben_in_die_globale_laesst_die_quelle"c); }
  else { PrintStr("FAIL 6 schreiben_in_die_globale_laesst_die_quelle -> "c); PrintStrLn(IntToStr(q.a)); _fehler := _fehler + 1; }

  if (_fehler != 0) { PrintStr("FEHLER="c); PrintLn(_fehler); return 1; }
  PrintStrLn("ALL PASS"c);
  return 0;
}
