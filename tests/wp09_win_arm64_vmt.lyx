// WP-09: Windows ARM64 — VMT Hardware-Verifikation
// Verifies virtual method dispatch on real Windows ARM64 hardware (not QEMU).
//
// Test matrix:
//   1. Single-class VMT  — Counter with Increment/GetCount via VMT
//   2. Two-class VMT     — Accumulator with Add/GetSum independent of Counter
//   3. Polymorphic field — method modifies a field, field value retrieved via VMT
//   4. Chained calls     — multiple VMT calls in sequence produce correct result
//
// Expected output:
//   3
//   60
//   PASS
//
// Hardware note: run on real Windows ARM64 device (Surface Pro X, Snapdragon
// Laptop, etc.) to complete WP-09 verification.  QEMU emulation alone is NOT
// sufficient; result + device model must be recorded in the commit message.
import std.io;

type Counter = class {
  count: int64;
  fn Increment() { self.count := self.count + 1; }
  fn GetCount(): int64 { return self.count; }
};

type Accumulator = class {
  sum: int64;
  fn Add(v: int64) { self.sum := self.sum + v; }
  fn GetSum(): int64 { return self.sum; }
};

fn main(): int64 {
  var ok: int64 := 1;

  // ---- 1+3+4: Counter VMT — Increment three times, read back ----------------
  var c: Counter := new Counter();
  c.Increment();
  c.Increment();
  c.Increment();
  var count: int64 := c.GetCount();
  if (count != 3) { ok := 0; }
  PrintInt(count);
  PrintLn("");

  // ---- 2: Accumulator VMT — Add 10+20+30 = 60 --------------------------------
  var a: Accumulator := new Accumulator();
  a.Add(10);
  a.Add(20);
  a.Add(30);
  var total: int64 := a.GetSum();
  if (total != 60) { ok := 0; }
  PrintInt(total);
  PrintLn("");

  // ---- result ----------------------------------------------------------------
  if ok == 0 {
    PrintLn("FAIL");
    return 1;
  }
  PrintLn("PASS");
  return 0;
}
