// tests/gpio_wp30_test.lyx
// WP-3.0: Hilfsfunktionen — CopyStringToBuf + DelayMicroseconds
//
// Abnahmekriterien:
// AC-WP3.0.1: CopyStringToBuf("lyx-gpio", buf, 32) schreibt 8 Zeichen + NUL
// AC-WP3.0.2: CopyStringToBuf mit max_len=4 → 3 Zeichen + NUL, Rest unverändert
// AC-WP3.0.3: DelayMicroseconds(1000) wartet mindestens 1 ms
// AC-WP3.0.4: DelayMicroseconds(0) kehrt sofort zurück (< 100 µs)

unit tests.gpio_wp30_test;

import std.hardware.gpio_util;
import std.alloc;

// ============================================================
// AC-WP3.0.1: Vollständige Kopie in großem Puffer
// ============================================================
fn testCopyFull(): int64 {
  var buf: int64 := alloc(64);
  var i: int64 := 0;
  while (i < 64) { poke8(buf + i, 0xFF); i := i + 1; }  // Vorbelegen

  var written: int64 := GpioCopyStringToBuf("lyx-gpio"c, buf, 32);

  var failed: int64 := 0;

  // Rückgabewert: 8 Bytes geschrieben (ohne NUL)
  if (written != 8) {
    PrintLn("FAIL: written count should be 8");
    failed := failed + 1;
  }

  // Bytes 0–7: "lyx-gpio" (ASCII)
  if (peek8(buf + 0) != 108) { PrintLn("FAIL: buf[0] != 'l'"); failed:=failed+1; }  // 'l'
  if (peek8(buf + 1) != 121) { PrintLn("FAIL: buf[1] != 'y'"); failed:=failed+1; }  // 'y'
  if (peek8(buf + 2) != 120) { PrintLn("FAIL: buf[2] != 'x'"); failed:=failed+1; }  // 'x'
  if (peek8(buf + 3) != 45)  { PrintLn("FAIL: buf[3] != '-'"); failed:=failed+1; }  // '-'
  if (peek8(buf + 4) != 103) { PrintLn("FAIL: buf[4] != 'g'"); failed:=failed+1; }  // 'g'
  if (peek8(buf + 5) != 112) { PrintLn("FAIL: buf[5] != 'p'"); failed:=failed+1; }  // 'p'
  if (peek8(buf + 6) != 105) { PrintLn("FAIL: buf[6] != 'i'"); failed:=failed+1; }  // 'i'
  if (peek8(buf + 7) != 111) { PrintLn("FAIL: buf[7] != 'o'"); failed:=failed+1; }  // 'o'

  // Byte 8: NUL-Terminator
  if (peek8(buf + 8) != 0) {
    PrintLn("FAIL: buf[8] should be NUL terminator");
    failed := failed + 1;
  }

  // Byte 9: unverändert (0xFF)
  if (peek8(buf + 9) != 0xFF) {
    PrintLn("FAIL: buf[9] should be untouched (0xFF)");
    failed := failed + 1;
  }

  free(buf, 64);
  if (failed == 0) { PrintLn("OK: CopyStringToBuf full copy 8+NUL bytes (WP-3.0.1)"); }
  return failed;
}

// ============================================================
// AC-WP3.0.2: Abschneiden bei max_len=4 → 3 Zeichen + NUL
// ============================================================
fn testCopyTruncate(): int64 {
  var buf: int64 := alloc(16);
  var i: int64 := 0;
  while (i < 16) { poke8(buf + i, 0xAA); i := i + 1; }

  var written: int64 := GpioCopyStringToBuf("lyx-gpio"c, buf, 4);

  var failed: int64 := 0;

  // Rückgabe: 3 (max_len-1 = 3)
  if (written != 3) {
    PrintLn("FAIL: truncated written count should be 3");
    failed := failed + 1;
  }

  // Bytes 0–2: "lyx"
  if (peek8(buf + 0) != 108) { PrintLn("FAIL: buf[0] != 'l'"); failed:=failed+1; }
  if (peek8(buf + 1) != 121) { PrintLn("FAIL: buf[1] != 'y'"); failed:=failed+1; }
  if (peek8(buf + 2) != 120) { PrintLn("FAIL: buf[2] != 'x'"); failed:=failed+1; }

  // Byte 3: NUL-Terminator (max_len-1)
  if (peek8(buf + 3) != 0) {
    PrintLn("FAIL: buf[3] should be NUL terminator after truncation");
    failed := failed + 1;
  }

  // Byte 4: unverändert (0xAA)
  if (peek8(buf + 4) != 0xAA) {
    PrintLn("FAIL: buf[4] beyond max_len should be untouched");
    failed := failed + 1;
  }

  free(buf, 16);
  if (failed == 0) { PrintLn("OK: CopyStringToBuf truncates at max_len-1 + NUL (WP-3.0.2)"); }
  return failed;
}

// AC-WP3.0.2 Variante: leerer String
fn testCopyEmpty(): int64 {
  var buf: int64 := alloc(8);
  poke8(buf, 0xFF);
  var written: int64 := GpioCopyStringToBuf(""c, buf, 8);
  var failed: int64 := 0;
  if (written != 0)         { PrintLn("FAIL: empty src written should be 0"); failed:=failed+1; }
  if (peek8(buf) != 0)      { PrintLn("FAIL: buf[0] should be NUL for empty src"); failed:=failed+1; }
  free(buf, 8);
  if (failed == 0) { PrintLn("OK: CopyStringToBuf empty string (WP-3.0.2)"); }
  return failed;
}

// AC-WP3.0.2 Variante: max_len=1 → sofort NUL, 0 Zeichen
fn testCopyMaxLenOne(): int64 {
  var buf: int64 := alloc(4);
  poke8(buf,     0xBB);
  poke8(buf + 1, 0xBB);
  var written: int64 := GpioCopyStringToBuf("hello"c, buf, 1);
  var failed: int64 := 0;
  if (written != 0)    { PrintLn("FAIL: max_len=1 written should be 0"); failed:=failed+1; }
  if (peek8(buf) != 0) { PrintLn("FAIL: max_len=1 buf[0] should be NUL"); failed:=failed+1; }
  if (peek8(buf + 1) != 0xBB) { PrintLn("FAIL: max_len=1 buf[1] should be untouched"); failed:=failed+1; }
  free(buf, 4);
  if (failed == 0) { PrintLn("OK: CopyStringToBuf max_len=1 → NUL only (WP-3.0.2)"); }
  return failed;
}

// ============================================================
// AC-WP3.0.3: DelayMicroseconds(1000) wartet mindestens 1 ms
// ============================================================
fn testDelayOneMs(): int64 {
  var ts0: int64 := alloc(GPIO_TIMESPEC_SIZE);
  var ts1: int64 := alloc(GPIO_TIMESPEC_SIZE);

  clock_gettime(GPIO_CLOCK_MONOTONIC, ts0);
  GpioDelayMicroseconds(1000);
  clock_gettime(GPIO_CLOCK_MONOTONIC, ts1);

  var startNs:  int64 := peek64(ts0) * GPIO_NS_PER_SEC + peek64(ts0 + 8);
  var endNs:    int64 := peek64(ts1) * GPIO_NS_PER_SEC + peek64(ts1 + 8);
  var elapsedUs: int64 := (endNs - startNs) / GPIO_NS_PER_US;

  free(ts0, GPIO_TIMESPEC_SIZE);
  free(ts1, GPIO_TIMESPEC_SIZE);

  if (elapsedUs < 1000) {
    PrintLn("FAIL: DelayMicroseconds(1000) elapsed < 1000 us");
    return 1;
  }
  PrintLn("OK: DelayMicroseconds(1000) waited >= 1 ms (WP-3.0.3)");
  return 0;
}

// ============================================================
// AC-WP3.0.4: DelayMicroseconds(0) kehrt sofort zurück
// ============================================================
fn testDelayZero(): int64 {
  var ts0: int64 := alloc(GPIO_TIMESPEC_SIZE);
  var ts1: int64 := alloc(GPIO_TIMESPEC_SIZE);

  clock_gettime(GPIO_CLOCK_MONOTONIC, ts0);
  GpioDelayMicroseconds(0);
  GpioDelayMicroseconds(-1);
  clock_gettime(GPIO_CLOCK_MONOTONIC, ts1);

  var startNs:  int64 := peek64(ts0) * GPIO_NS_PER_SEC + peek64(ts0 + 8);
  var endNs:    int64 := peek64(ts1) * GPIO_NS_PER_SEC + peek64(ts1 + 8);
  var elapsedUs: int64 := (endNs - startNs) / GPIO_NS_PER_US;

  free(ts0, GPIO_TIMESPEC_SIZE);
  free(ts1, GPIO_TIMESPEC_SIZE);

  // Grenze: < 500 µs (großzügig für langsame CI-Maschinen)
  if (elapsedUs >= 500) {
    PrintLn("FAIL: DelayMicroseconds(0) took >= 500 us — not immediate");
    return 1;
  }
  PrintLn("OK: DelayMicroseconds(0/-1) returns immediately (WP-3.0.4)");
  return 0;
}

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testCopyFull();
  failed := failed + testCopyTruncate();
  failed := failed + testCopyEmpty();
  failed := failed + testCopyMaxLenOne();
  failed := failed + testDelayOneMs();
  failed := failed + testDelayZero();

  if (failed != 0) { PrintLn("FAILED"); return 1; }
  PrintLn("ALL PASSED");
  return 0;
}
