// tests/demo_s3_list.lyx — S3 Demo: 20 objects in prefixes, ListWithDelimiter, ListAll
// WP-S3-10

unit tests.demo_s3_list;

import std.cloud.aws.core;
import std.cloud.s3;
import std.io;
import std.alloc;

fn itoa(n: int64, buf: int64): pchar {
    if (n == 0) { poke8(buf, 48); poke8(buf+1, 0); return buf as pchar; }
    var tmp: int64 := alloc(24); var i: int64 := 0; var v: int64 := n;
    while (v > 0) { poke8(tmp+i, 48+(v%10)); v:=v/10; i:=i+1; }
    var j: int64 := 0;
    while (j < i) { poke8(buf+j, peek8(tmp+(i-1-j))); j:=j+1; }
    poke8(buf+i, 0); free(tmp, 24); return buf as pchar;
}

fn append(buf: int64, off: int64, s: pchar): int64 {
    var n: int64 := StrLen(s); var i: int64 := 0;
    while(i<n){poke8(buf+off+i, StrCharAt(s,i)&0xFF);i:=i+1;}
    return off+n;
}

pub fn main(argc: int64, argv: int64): int64 {
    PrintLn("=== S3 Demo: List Objects ==="c);

    var creds: AWSCreds := AWSCredentialsFromEnv();
    if (creds.accessKey == 0) {
        PrintLn("Error: set AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY"c); return 1;
    }
    var region: pchar := AWSRegionFromEnv("us-east-1"c);
    var client: S3Client := S3Connect(creds, region);

    var bucket: pchar := "lyx-list-demo"c;
    S3BucketCreate(client, bucket);

    // Upload 20 objects spread across two prefixes
    var data: pchar := "x"c;
    var keyBuf: int64 := alloc(64);
    var i: int64 := 0;
    while (i < 10) {
        var off: int64 := append(keyBuf, 0, "alpha/"c);
        var nbuf: int64 := alloc(8); itoa(i, nbuf);
        off := append(keyBuf, off, nbuf as pchar);
        off := append(keyBuf, off, ".txt"c);
        poke8(keyBuf+off, 0); free(nbuf, 8);
        S3PutObject(client, bucket, keyBuf as pchar, data as int64, 1, "text/plain"c);
        i := i + 1;
    }
    i := 0;
    while (i < 10) {
        var off2: int64 := append(keyBuf, 0, "beta/"c);
        var nbuf2: int64 := alloc(8); itoa(i, nbuf2);
        off2 := append(keyBuf, off2, nbuf2 as pchar);
        off2 := append(keyBuf, off2, ".txt"c);
        poke8(keyBuf+off2, 0); free(nbuf2, 8);
        S3PutObject(client, bucket, keyBuf as pchar, data as int64, 1, "text/plain"c);
        i := i + 1;
    }
    free(keyBuf, 64);
    PrintLn("Uploaded 20 objects (alpha/ x10, beta/ x10)"c);

    // ListWithDelimiter → shows top-level prefixes
    PrintLn(""c);
    PrintLn("ListWithDelimiter(delimiter='/'):"c);
    var prefixList: int64 := S3ListWithDelimiter(client, bucket, ""c, "/"c);
    if (prefixList != 0) {
        var pc: int64 := S3ListPrefixCount(prefixList);
        Print("  Common prefixes: "c);
        var pbuf: int64 := alloc(24); itoa(pc, pbuf); PrintLn(pbuf as pchar); free(pbuf, 24);
        var j: int64 := 0;
        while (j < pc) {
            Print("    "c); PrintLn(S3ListGetPrefix(prefixList, j));
            j := j + 1;
        }
        S3ListFree(prefixList);
    }

    // ListObjects with prefix 'alpha/'
    PrintLn(""c);
    PrintLn("ListObjects(prefix='alpha/'):"c);
    var alphaList: int64 := S3ListObjects(client, bucket, "alpha/"c, 100);
    if (alphaList != 0) {
        var count: int64 := S3ListCount(alphaList);
        Print("  Count: "c);
        var cbuf: int64 := alloc(24); itoa(count, cbuf); PrintLn(cbuf as pchar); free(cbuf, 24);
        var k: int64 := 0;
        while (k < count) {
            Print("    "c); PrintLn(S3ListGetKey(alphaList, k));
            k := k + 1;
        }
        S3ListFree(alphaList);
    }

    // ListAll (both prefixes)
    PrintLn(""c);
    PrintLn("ListAll(prefix=''):"c);
    var allList: int64 := S3ListAll(client, bucket, ""c);
    if (allList != 0) {
        Print("  Total: "c);
        var tbuf: int64 := alloc(24); itoa(S3ListCount(allList), tbuf);
        PrintLn(tbuf as pchar); free(tbuf, 24);
        S3ListFree(allList);
    }

    // Cleanup: delete all
    PrintLn(""c);
    PrintLn("Cleaning up..."c);
    var toDelete: int64 := S3ListAll(client, bucket, ""c);
    if (toDelete != 0) {
        var n: int64 := S3ListCount(toDelete);
        var keyPtrs: int64 := alloc(n*8);
        var m: int64 := 0;
        while (m < n) { poke64(keyPtrs+m*8, S3ListGetKey(toDelete,m) as int64); m:=m+1; }
        S3DeleteObjects(client, bucket, keyPtrs, n);
        free(keyPtrs, n*8);
        S3ListFree(toDelete);
    }
    S3BucketDelete(client, bucket);

    S3Close(client);
    PrintLn("Done."c);
    return 0;
}
