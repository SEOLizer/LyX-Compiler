@description("WP-PDF-06: raster image test")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pdf_image_test;

import std.pdf;

// Fill buffer with a simple gradient: R increases left→right, G increases top→bottom
fn makeGradientRGB(buf: int64, w: int64, h: int64): void {
  var y: int64 := 0;
  while (y < h) {
    var x: int64 := 0;
    while (x < w) {
      var r: int64 := (x * 255) / w;
      var g: int64 := (y * 255) / h;
      var b: int64 := 128;
      poke8(buf + (y * w + x) * 3,     r);
      poke8(buf + (y * w + x) * 3 + 1, g);
      poke8(buf + (y * w + x) * 3 + 2, b);
      x := x + 1;
    }
    y := y + 1;
  }
}

// Fill buffer with a grayscale gradient
fn makeGradientGray(buf: int64, w: int64, h: int64): void {
  var y: int64 := 0;
  while (y < h) {
    var x: int64 := 0;
    while (x < w) {
      poke8(buf + y * w + x, (x * 255) / w);
      x := x + 1;
    }
    y := y + 1;
  }
}

fn testImageRGB(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }
  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);

  var pw: int64 := 64;
  var ph: int64 := 64;
  var rawbuf: int64 := mmap(0, pw * ph * 3, 3, 34, -1, 0);
  if (rawbuf == 0) { PdfFree(doc); Print("FAIL: mmap\n"); return 1; }

  makeGradientRGB(rawbuf, pw, ph);

  var imgIdx: int64 := PdfAddImage(doc, rawbuf, pw, ph, 3);
  munmap(rawbuf, pw * ph * 3);

  if (imgIdx < 0) { PdfFree(doc); Print("FAIL: PdfAddImage\n"); return 1; }

  // Place image at (72, 600) scaled to 200×200 points
  PdfDrawImage(doc, page, imgIdx, 72.0, 600.0, 200.0, 200.0);

  // Add a label below
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 10.0);
  PdfTextAt(doc, page, 72.0, 590.0, "64x64 RGB gradient");

  PdfSetCompression(doc, 1);
  var err: int64 := PdfSave(doc, "/tmp/pdf_image_rgb.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave RGB image\n"); return 1; }
  Print("OK: RGB image PDF saved to /tmp/pdf_image_rgb.pdf\n");
  return 0;
}

fn testImageGray(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }
  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);

  var pw: int64 := 128;
  var ph: int64 := 32;
  var rawbuf: int64 := mmap(0, pw * ph, 3, 34, -1, 0);
  if (rawbuf == 0) { PdfFree(doc); Print("FAIL: mmap\n"); return 1; }

  makeGradientGray(rawbuf, pw, ph);

  var imgIdx: int64 := PdfAddImage(doc, rawbuf, pw, ph, 1);
  munmap(rawbuf, pw * ph);

  if (imgIdx < 0) { PdfFree(doc); Print("FAIL: PdfAddImage gray\n"); return 1; }

  PdfDrawImage(doc, page, imgIdx, 72.0, 700.0, 300.0, 75.0);

  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 10.0);
  PdfTextAt(doc, page, 72.0, 692.0, "128x32 grayscale gradient");

  PdfSetCompression(doc, 1);
  var err: int64 := PdfSave(doc, "/tmp/pdf_image_gray.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave gray image\n"); return 1; }
  Print("OK: grayscale image PDF saved to /tmp/pdf_image_gray.pdf\n");
  return 0;
}

fn testMultiImage(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }
  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);

  var pw: int64 := 32;
  var ph: int64 := 32;
  var rawbuf: int64 := mmap(0, pw * ph * 3, 3, 34, -1, 0);
  if (rawbuf == 0) { PdfFree(doc); Print("FAIL: mmap\n"); return 1; }

  // Image 0: red
  var r: int64 := 0;
  while (r < pw * ph * 3) { poke8(rawbuf + r, 0); r := r + 1; }
  var rr: int64 := 0;
  while (rr < pw * ph) { poke8(rawbuf + rr * 3, 220); rr := rr + 1; }
  var img0: int64 := PdfAddImage(doc, rawbuf, pw, ph, 3);

  // Image 1: green
  var gg: int64 := 0;
  while (gg < pw * ph * 3) { poke8(rawbuf + gg, 0); gg := gg + 1; }
  var gp: int64 := 0;
  while (gp < pw * ph) { poke8(rawbuf + gp * 3 + 1, 180); gp := gp + 1; }
  var img1: int64 := PdfAddImage(doc, rawbuf, pw, ph, 3);

  // Image 2: blue
  var bb: int64 := 0;
  while (bb < pw * ph * 3) { poke8(rawbuf + bb, 0); bb := bb + 1; }
  var bp: int64 := 0;
  while (bp < pw * ph) { poke8(rawbuf + bp * 3 + 2, 200); bp := bp + 1; }
  var img2: int64 := PdfAddImage(doc, rawbuf, pw, ph, 3);

  munmap(rawbuf, pw * ph * 3);

  if (img0 < 0 || img1 < 0 || img2 < 0) {
    PdfFree(doc);
    Print("FAIL: PdfAddImage multi\n");
    return 1;
  }

  PdfDrawImage(doc, page, img0, 72.0,  650.0, 120.0, 120.0);
  PdfDrawImage(doc, page, img1, 210.0, 650.0, 120.0, 120.0);
  PdfDrawImage(doc, page, img2, 348.0, 650.0, 120.0, 120.0);

  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 10.0);
  PdfTextAt(doc, page, 72.0, 642.0, "Red, Green, Blue 32x32 images");

  PdfSetCompression(doc, 1);
  var err: int64 := PdfSave(doc, "/tmp/pdf_image_multi.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave multi image\n"); return 1; }
  Print("OK: multi-image PDF saved to /tmp/pdf_image_multi.pdf\n");
  return 0;
}

fn testImageNoCompress(): int64 {
  // Verify images work without compression too
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }
  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);

  var pw: int64 := 16;
  var ph: int64 := 16;
  var rawbuf: int64 := mmap(0, pw * ph * 3, 3, 34, -1, 0);
  if (rawbuf == 0) { PdfFree(doc); Print("FAIL: mmap\n"); return 1; }
  makeGradientRGB(rawbuf, pw, ph);
  var imgIdx: int64 := PdfAddImage(doc, rawbuf, pw, ph, 3);
  munmap(rawbuf, pw * ph * 3);
  if (imgIdx < 0) { PdfFree(doc); Print("FAIL: PdfAddImage (no compress)\n"); return 1; }
  PdfDrawImage(doc, page, imgIdx, 100.0, 700.0, 100.0, 100.0);
  var err: int64 := PdfSave(doc, "/tmp/pdf_image_nocompress.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (no compress)\n"); return 1; }
  Print("OK: image PDF (no compress) saved to /tmp/pdf_image_nocompress.pdf\n");
  return 0;
}

pub fn main(): int64 {
  if (testImageRGB()        != 0) { return 1; }
  if (testImageGray()       != 0) { return 1; }
  if (testMultiImage()      != 0) { return 1; }
  if (testImageNoCompress() != 0) { return 1; }
  Print("All WP-PDF-06 image tests passed.\n");
  return 0;
}
