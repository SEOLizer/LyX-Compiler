// tests/defer_scope_test.lyx
// WP-2.2-B: Defer-Scope-Semantik
//
// Tests: LIFO-Reihenfolge, früher return, verschachtelte Scopes.

@description("WP-2.2-B: defer scope semantics tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.defer_scope_test;

import std.alloc;
// Shared order-tracking buffer (simple global array via poke/peek)
var g_order: int64 := 0;
var g_idx:   int64 := 0;

fn recordStep(step: int64) {
  poke64(g_order + g_idx * 8, step);
  g_idx := g_idx + 1;
}

fn resetOrder() {
  g_order := alloc(64 * 8);
  g_idx   := 0;
}

fn getStep(i: int64): int64 {
  return peek64(g_order + i * 8);
}

// --- 1. Single defer runs at end of block ---
fn testSingleDefer(): int64 {
  resetOrder();
  {
    defer recordStep(2);
    recordStep(1);
  }
  // expected: 1, 2
  if (getStep(0) != 1 || getStep(1) != 2) {
    PrintLn("FAIL: single defer"); return 1;
  }
  PrintLn("OK: single defer at block end");
  return 0;
}

// --- 2. Multiple defers in LIFO order ---
fn testLIFO(): int64 {
  resetOrder();
  {
    defer recordStep(3);  // registered first → runs last
    defer recordStep(2);
    defer recordStep(1);  // registered last → runs first
    recordStep(0);
  }
  // expected: 0, 1, 2, 3
  if (getStep(0) != 0 || getStep(1) != 1 || getStep(2) != 2 || getStep(3) != 3) {
    PrintLn("FAIL: LIFO order"); return 1;
  }
  PrintLn("OK: multiple defers LIFO");
  return 0;
}

// --- 3. Defer runs before early return ---
fn helperEarlyReturn(doReturn: int64): int64 {
  resetOrder();
  defer recordStep(99);  // must run even on early return
  if (doReturn != 0) {
    recordStep(1);
    return 1;
  }
  recordStep(2);
  return 0;
}

fn testEarlyReturn(): int64 {
  var r: int64 := helperEarlyReturn(1);
  if (r != 1) { PrintLn("FAIL: early return value"); return 1; }
  // step 1 was recorded, then defer(99) ran
  if (getStep(0) != 1 || getStep(1) != 99) {
    PrintLn("FAIL: defer before early return"); return 1;
  }
  PrintLn("OK: defer runs before early return");
  return 0;
}

// --- 4. Nested scopes — inner defer runs first ---
fn testNestedScopes(): int64 {
  resetOrder();
  {
    defer recordStep(3);   // outer scope, runs last
    {
      defer recordStep(2); // inner scope, runs when inner block exits
      recordStep(1);
    }
    // inner block exited: defer(2) ran here
    recordStep(4);
  }
  // outer block exited: defer(3) ran here
  // expected sequence: 1, 2, 4, 3
  if (getStep(0) != 1 || getStep(1) != 2 || getStep(2) != 4 || getStep(3) != 3) {
    PrintLn("FAIL: nested scope defer order");
    Print("  got: ");
    var i: int64 := 0;
    while (i < 4) { Print(StrFromInt(getStep(i))); Print(" "); i := i + 1; }
    PrintLn("");
    return 1;
  }
  PrintLn("OK: nested scopes inner-first");
  return 0;
}

// --- 5. Defer in a loop ---
// Geprueft wird die REIHENFOLGE: der aufgeschobene Aufruf laeuft am Ende
// jeder Iteration, nicht erst am Funktionsende. Das Argument ist bewusst
// konstant — wann die Argumente ausgewertet werden, ist ein eigener Defekt
// (siehe testDeferArgTiming unten) und soll diesen Test nicht mitreissen.
fn testDeferInLoop(): int64 {
  resetOrder();
  var i: int64 := 0;
  while (i < 3) {
    defer recordStep(99);   // laeuft am Ende DIESER Iteration
    recordStep(i);
    i := i + 1;
  }
  // erwartet: 0, 99, 1, 99, 2, 99
  if (getStep(0) != 0  || getStep(1) != 99 ||
      getStep(2) != 1  || getStep(3) != 99 ||
      getStep(4) != 2  || getStep(5) != 99) {
    PrintLn("FAIL: defer in loop");
    Print("  got: ");
    var j: int64 := 0;
    while (j < 6) { Print(StrFromInt(getStep(j))); Print(" "); j := j + 1; }
    PrintLn("");
    return 1;
  }
  PrintLn("OK: defer in loop (per-iteration block scope)");
  return 0;
}

pub fn main(): int64 {
  if (testSingleDefer()   != 0) { return 1; }
  if (testLIFO()          != 0) { return 1; }
  if (testEarlyReturn()   != 0) { return 1; }
  if (testNestedScopes()  != 0) { return 1; }
  if (testDeferInLoop()   != 0) { return 1; }
  PrintLn("All WP-2.2-B defer scope tests passed.");
  return 0;
}
