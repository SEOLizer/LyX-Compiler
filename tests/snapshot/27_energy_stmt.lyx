// 27_energy_stmt.lyx — WP-EN-04: @energy(N); Statement überschreibt Level innerhalb Funktion
fn mixed(n: int64): int64 {
  @energy(2);
  var s: int64 := 0;
  var i: int64 := 0;
  while i < n { s := s + i; i := i + 1; }
  return s;
}

fn withFor(n: int64): int64 {
  @energy(5);
  var s: int64 := 0;
  for i := 0 to n - 1 { s := s + i; }
  return s;
}

fn main(): int64 {
  if mixed(100)   != 4950 { Print("FAIL: mixed(100)\n");   return 1; }
  if mixed(0)     != 0    { Print("FAIL: mixed(0)\n");     return 1; }
  if mixed(1)     != 0    { Print("FAIL: mixed(1)\n");     return 1; }
  if withFor(100) != 4950 { Print("FAIL: withFor(100)\n"); return 1; }
  if withFor(8)   != 28   { Print("FAIL: withFor(8)\n");   return 1; }
  Print("OK\n");
  return 0;
}
