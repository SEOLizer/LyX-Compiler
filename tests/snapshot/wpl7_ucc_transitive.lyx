// WP-L7 AC3: @uses_caller_cap — Transitive Propagation über zwei Ebenen

// Ebene 2: benötigt fs.write vom Aufrufer
@uses_caller_cap([fs.write])
fn logToFile(): void {
}

// Ebene 1: leiht fs.write → kann logToFile aufrufen
@uses_caller_cap([fs.write])
fn writeLog(): void {
  logToFile();  // OK: writeLog borrows fs.write, gilt intern
}

// Aufrufer mit der Capability
@capabilities([fs.write(path: "/var/log")])
fn withCap(): void {
  writeLog();   // OK: withCap hat fs.write
}

fn main(): int64 {
  withCap();
  PrintLn("transitive ok");
  return 0;
}
