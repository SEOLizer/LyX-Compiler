// WP-L8 AC1: Klassen-Capability wird von allen Instanzmethoden geerbt

@uses_caller_cap([fs.write])
fn writeLog(): void {
}

@capabilities([fs.write(path: "/var/log")])
pub type Logger = class {
  fn log(): void {
    writeLog();  // OK: Logger erbt fs.write von der Klasse
  }
};

@capabilities([fs.write(path: "/var/log")])
fn main(): int64 {
  var l: Logger := new Logger();
  l.log();
  PrintLn("class cap ok");
  return 0;
}
