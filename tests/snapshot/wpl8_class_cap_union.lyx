// WP-L8 AC2: Methode fügt eigene Capability hinzu — Vereinigung ist korrekt

@uses_caller_cap([fs.write])
fn writeLog(): void {
}

@uses_caller_cap([network.tcp.connect])
fn connectNet(): void {
}

@capabilities([fs.write(path: "/var/log")])
pub type Logger = class {
  fn logOnly(): void {
    writeLog();    // OK: erbt fs.write von Klasse
  }

  @capabilities([network.tcp.connect])
  fn logAndConnect(): void {
    writeLog();    // OK: erbt fs.write von Klasse
    connectNet();  // OK: eigene network.tcp.connect
  }
};

@capabilities([fs.write(path: "/var/log"), network.tcp.connect])
fn main(): int64 {
  var l: Logger := new Logger();
  l.logOnly();
  l.logAndConnect();
  PrintLn("union ok");
  return 0;
}
