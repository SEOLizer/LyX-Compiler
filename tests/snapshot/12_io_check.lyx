// WP-CS-11: @io_check + IOResult snapshot test

fn main(): int64 {
  // @io_check(false): no panic on failed open; IOResult holds errno
  @io_check(false);

  var fd: int64 := open("/tmp/__lyx_snap12_noexist__"c, 0, 0);
  var r: int64 := IOResult();

  // errno -2 = ENOENT on Linux
  if (r != -2) {
    write(1, "FAIL: IOResult\n"c as int64, 15);
    return 1;
  }
  if (fd >= 0) {
    write(1, "FAIL: fd\n"c as int64, 9);
    return 1;
  }

  // @io_check(true): successful open must not panic
  @io_check(true);
  var fd2: int64 := open("/dev/null"c, 0, 0);
  var r2: int64 := IOResult();
  if (r2 < 0) {
    write(1, "FAIL: devnull\n"c as int64, 14);
    return 1;
  }
  close(fd2);

  write(1, "PASS: io_check OK\n"c as int64, 18);
  return 0;
}
