// 22_printfloat.lyx — PrintFloat / FloatToStr / EPrintFloat Builtins
// Note: negative float literals are broken in bootstrap (unary/binary minus
// uses integer arithmetic on IEEE-754 bits). Use (0-N) as f64 for negatives.
fn main(): int64 {
  if (!StrEquals(FloatToStr(0.0), "0.000000")) {
    PrintStr("FAIL: 0.0 → "); PrintStr(FloatToStr(0.0)); PrintStr("\n"); return 1;
  }
  if (!StrEquals(FloatToStr(1.0), "1.000000")) {
    PrintStr("FAIL: 1.0 → "); PrintStr(FloatToStr(1.0)); PrintStr("\n"); return 1;
  }
  if (!StrEquals(FloatToStr(42.0), "42.000000")) {
    PrintStr("FAIL: 42.0 → "); PrintStr(FloatToStr(42.0)); PrintStr("\n"); return 1;
  }
  if (!StrEquals(FloatToStr(0.5), "0.500000")) {
    PrintStr("FAIL: 0.5 → "); PrintStr(FloatToStr(0.5)); PrintStr("\n"); return 1;
  }
  if (!StrEquals(FloatToStr(0.25), "0.250000")) {
    PrintStr("FAIL: 0.25 → "); PrintStr(FloatToStr(0.25)); PrintStr("\n"); return 1;
  }
  if (!StrEquals(FloatToStr(100.5), "100.500000")) {
    PrintStr("FAIL: 100.5 → "); PrintStr(FloatToStr(100.5)); PrintStr("\n"); return 1;
  }
  // Negative via int cast (only reliable way in bootstrap compiler)
  var neg1: f64 := (0 - 1) as f64;
  if (!StrEquals(FloatToStr(neg1), "-1.000000")) {
    PrintStr("FAIL: -1 → "); PrintStr(FloatToStr(neg1)); PrintStr("\n"); return 1;
  }
  var neg42: f64 := (0 - 42) as f64;
  if (!StrEquals(FloatToStr(neg42), "-42.000000")) {
    PrintStr("FAIL: -42 → "); PrintStr(FloatToStr(neg42)); PrintStr("\n"); return 1;
  }
  PrintFloat(1.5);
  PrintStr("\n");
  PrintStr("OK\n");
  return 0;
}
