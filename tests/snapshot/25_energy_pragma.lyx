// 25_energy_pragma.lyx — WP-EN-05: @energy(5) Funktion-Pragma (8× Loop-Unrolling)
@energy(5)
fn sumN(n: int64): int64 {
  var s: int64 := 0;
  var i: int64 := 0;
  while i < n { s := s + i; i := i + 1; }
  return s;
}

fn main(): int64 {
  if sumN(100) != 4950 { Print("FAIL: sumN(100)\n"); return 1; }
  if sumN(0)   != 0    { Print("FAIL: sumN(0)\n");   return 1; }
  if sumN(1)   != 0    { Print("FAIL: sumN(1)\n");   return 1; }
  if sumN(8)   != 28   { Print("FAIL: sumN(8)\n");   return 1; }
  if sumN(9)   != 36   { Print("FAIL: sumN(9)\n");   return 1; }
  Print("OK\n");
  return 0;
}
