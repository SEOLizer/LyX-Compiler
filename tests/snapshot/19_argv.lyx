// 19_argv.lyx — GetArgC / GetArg Builtins
fn main(): int64 {
  var argc: int64 := GetArgC();
  if (argc < 1) { Print("FAIL: argc < 1\n"); return 1; }

  // argv[0] ist der Programmpfad — muss nicht-null sein
  var prog: pchar := GetArg(0);
  if (prog == (0 as pchar)) { Print("FAIL: argv[0] null\n"); return 1; }

  Print("OK\n");
  return 0;
}
