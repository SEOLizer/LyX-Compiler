import src.std.alloc;

fn main(): int64 {
  var pid: int64 := sys_fork();
  if pid == 0 {
    var argv: int64 := alloc(2 * 8);
    poke64(argv, "/bin/true"c as int64);
    poke64(argv + 8, 0);
    sys_execve("/bin/true"c, argv, 0);
    return 1;
  }
  var st: int64 := alloc(8); poke64(st, 0);
  sys_wait4(pid, st, 0);
  var code: int64 := (peek64(st) >> 8) & 0xFF;
  free(st, 8);
  PrintLn(code);
  return 0;
}
