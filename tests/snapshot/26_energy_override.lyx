// 26_energy_override.lyx — WP-EN-04: @energy Funktion-Pragma überschreibt globalen Level
// Globaler Level 3 (4× Unrolling), eine Funktion mit @energy(1) (kein Unrolling)
@energy(3);

@energy(1)
fn lowPower(n: int64): int64 {
  var s: int64 := 0;
  var i: int64 := 0;
  while i < n { s := s + i; i := i + 1; }
  return s;
}

fn highPower(n: int64): int64 {
  var s: int64 := 0;
  var i: int64 := 0;
  while i < n { s := s + i; i := i + 1; }
  return s;
}

fn main(): int64 {
  if lowPower(100)  != 4950 { Print("FAIL: lowPower\n");  return 1; }
  if highPower(100) != 4950 { Print("FAIL: highPower\n"); return 1; }
  if lowPower(0)    != 0    { Print("FAIL: lowPower(0)\n"); return 1; }
  if lowPower(1)    != 0    { Print("FAIL: lowPower(1)\n"); return 1; }
  Print("OK\n");
  return 0;
}
