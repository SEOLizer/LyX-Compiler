fn factorial(n: int64): int64 {
  if (n <= 1) { return 1; }
  return n * factorial(n - 1);
}

fn add(a: int64, b: int64): int64 {
  return a + b;
}

fn main(): int64 {
  PrintInt(factorial(5));  PrintStr("\n");
  PrintInt(factorial(10)); PrintStr("\n");
  PrintInt(add(7, 8));     PrintStr("\n");
  return 0;
}
