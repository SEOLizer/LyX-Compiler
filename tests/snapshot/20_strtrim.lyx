// 20_strtrim.lyx — StrTrim Builtin
fn main(): int64 {
  if (!StrEquals(StrTrim(StrCopy("  hello  ")), "hello")) {
    PrintStr("FAIL: leading+trailing\n"); return 1;
  }
  if (!StrEquals(StrTrim(StrCopy("   ")), "")) {
    PrintStr("FAIL: all whitespace\n"); return 1;
  }
  if (!StrEquals(StrTrim(StrCopy("")), "")) {
    PrintStr("FAIL: empty\n"); return 1;
  }
  if (!StrEquals(StrTrim(StrCopy("\t\nfoo\r\n")), "foo")) {
    PrintStr("FAIL: tab/newline\n"); return 1;
  }
  if (!StrEquals(StrTrim(StrCopy("abc")), "abc")) {
    PrintStr("FAIL: no whitespace\n"); return 1;
  }
  PrintStr("OK\n");
  return 0;
}
