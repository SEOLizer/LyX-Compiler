// 20_strtrim.lyx — StrTrim Builtin
fn main(): int64 {
  if (!StrEquals(StrTrim(StrCopy("  hello  ")), "hello")) {
    Print("FAIL: leading+trailing\n"); return 1;
  }
  if (!StrEquals(StrTrim(StrCopy("   ")), "")) {
    Print("FAIL: all whitespace\n"); return 1;
  }
  if (!StrEquals(StrTrim(StrCopy("")), "")) {
    Print("FAIL: empty\n"); return 1;
  }
  if (!StrEquals(StrTrim(StrCopy("\t\nfoo\r\n")), "foo")) {
    Print("FAIL: tab/newline\n"); return 1;
  }
  if (!StrEquals(StrTrim(StrCopy("abc")), "abc")) {
    Print("FAIL: no whitespace\n"); return 1;
  }
  Print("OK\n");
  return 0;
}
