// 28_energy_directive.lyx — WP-EN-03: top-level @energy(N); Direktive setzt globalen Level
@energy(2);

fn sumWhile(n: int64): int64 {
  var s: int64 := 0;
  var i: int64 := 0;
  while i < n { s := s + i; i := i + 1; }
  return s;
}

fn sumForC(n: int64): int64 {
  var s: int64 := 0;
  for i := 0; i < n; i := i + 1 { s := s + i; }
  return s;
}

fn main(): int64 {
  if sumWhile(100) != 4950 { PrintStr("FAIL: sumWhile\n"); return 1; }
  if sumWhile(0)   != 0    { PrintStr("FAIL: sumWhile(0)\n"); return 1; }
  if sumWhile(1)   != 0    { PrintStr("FAIL: sumWhile(1)\n"); return 1; }
  if sumForC(100)  != 4950 { PrintStr("FAIL: sumForC\n");  return 1; }
  PrintStr("OK\n");
  return 0;
}
