// WP-H12: hardware.i2c + hardware.spi → spezifische Landlock-Regeln.
// I2C Bus 1 → /dev/i2c-1; SPI Bus 0 CS 0 → /dev/spidev0.0.
// Zwei GPIO-Pins auf unterschiedlichen Chips → zwei separate Regeln.

@capabilities([
  hardware.i2c(bus: 1),
  hardware.spi(bus: 0, cs: 0),
  hardware.gpio(pin: 18),
  hardware.gpio(pin: 40)
])
fn main(): int64 {
  return 0;
}
