// 18_random.lyx — Random() und RandomSeed() Builtins
fn main(): int64 {
  RandomSeed(42);

  var r1: int64 := Random();
  var r2: int64 := Random();
  var r3: int64 := Random();

  if (r1 == 0) { PrintStr("FAIL: r1 ist 0\n"); return 1; }
  if (r2 == r1) { PrintStr("FAIL: r2 == r1\n"); return 1; }
  if (r3 == r2) { PrintStr("FAIL: r3 == r2\n"); return 1; }

  // Reseed → gleiche Sequenz
  RandomSeed(42);
  var r1b: int64 := Random();
  if (r1b != r1) { PrintStr("FAIL: reseed liefert andere Sequenz\n"); return 1; }

  PrintStr("OK\n");
  return 0;
}
