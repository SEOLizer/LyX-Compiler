// 24_map_set_in.lyx — Map/Set/in-Operator (WP-BI-06)
fn main(): int64 {
  // Map: int64 keys → int64 values
  var m: int64 := { 1: 100, 2: 200, 3: 300 };

  // MapGet via in-operator: check membership
  if (!(1 in m)) { Print("FAIL: 1 not in m\n"); return 1; }
  if (!(2 in m)) { Print("FAIL: 2 not in m\n"); return 1; }
  if (!(3 in m)) { Print("FAIL: 3 not in m\n"); return 1; }
  if (4 in m)    { Print("FAIL: 4 in m\n");     return 1; }

  // Set: membership test
  var s: int64 := { 10, 20, 30 };
  if (!(10 in s)) { Print("FAIL: 10 not in s\n"); return 1; }
  if (!(20 in s)) { Print("FAIL: 20 not in s\n"); return 1; }
  if (!(30 in s)) { Print("FAIL: 30 not in s\n"); return 1; }
  if (5 in s)     { Print("FAIL: 5 in s\n");      return 1; }

  // Empty map
  var em: int64 := {};
  if (1 in em) { Print("FAIL: 1 in empty map\n"); return 1; }

  Print("OK\n");
  return 0;
}
