// WP-CS-11: IOResult() nach fehlgeschlagenem read() liefert EBADF (-9)

fn main(): int64 {
  @io_check(false);
  var n: int64 := read(-1, 0, 0);
  var r: int64 := IOResult();
  if (r != -9) {
