// 21_strfind.lyx — StrFind Builtin (Substring-Suche)
fn main(): int64 {
  if (StrFind("hello world", "world") != 6)  { PrintStr("FAIL: basic\n");         return 1; }
  if (StrFind("hello world", "hello") != 0)  { PrintStr("FAIL: at start\n");      return 1; }
  if (StrFind("hello world", "xyz")   != -1) { PrintStr("FAIL: not found\n");     return 1; }
  if (StrFind("hello world", "")      != 0)  { PrintStr("FAIL: empty needle\n");  return 1; }
  if (StrFind("", "abc")              != -1) { PrintStr("FAIL: empty hs\n");      return 1; }
  if (StrFind("aaab", "aab")          != 1)  { PrintStr("FAIL: overlap\n");       return 1; }
  if (StrFind("ab", "abcd")           != -1) { PrintStr("FAIL: needle longer\n"); return 1; }
  PrintStr("OK\n");
  return 0;
}
