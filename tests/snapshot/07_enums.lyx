pub enum Color {
  RED,
  GREEN,
  BLUE,
};

pub enum HttpStatus {
  OK    = 200,
  NOT_FOUND = 404,
};

fn main(): int64 {
  PrintInt(RED);    PrintStr("\n");
  PrintInt(GREEN);  PrintStr("\n");
  PrintInt(BLUE);   PrintStr("\n");
  PrintInt(OK);     PrintStr("\n");
  PrintInt(NOT_FOUND); PrintStr("\n");

  var c: Color := GREEN;
  if (c == GREEN) {
    PrintStr("green\n");
  }
  return 0;
}
