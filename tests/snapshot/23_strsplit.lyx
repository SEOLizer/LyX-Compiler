// 23_strsplit.lyx — StrSplit Builtin
fn main(): int64 {
  // Basic split: "a,b,c" by ","
  var arr1: pchar[] := StrSplit("a,b,c", ",");
  if (!StrEquals(arr1[0], "a")) {
    PrintStr("FAIL: arr1[0]="); PrintStr(arr1[0]); PrintStr("\n"); return 1;
  }
  if (!StrEquals(arr1[1], "b")) {
    PrintStr("FAIL: arr1[1]="); PrintStr(arr1[1]); PrintStr("\n"); return 1;
  }
  if (!StrEquals(arr1[2], "c")) {
    PrintStr("FAIL: arr1[2]="); PrintStr(arr1[2]); PrintStr("\n"); return 1;
  }

  // No delimiter found → single element
  var arr2: pchar[] := StrSplit("hello", ",");
  if (!StrEquals(arr2[0], "hello")) {
    PrintStr("FAIL: arr2[0]="); PrintStr(arr2[0]); PrintStr("\n"); return 1;
  }

  // Leading delimiter → first element is empty string
  var arr3: pchar[] := StrSplit(",a", ",");
  if (!StrEquals(arr3[0], "")) {
    PrintStr("FAIL: arr3[0] not empty\n"); return 1;
  }
  if (!StrEquals(arr3[1], "a")) {
    PrintStr("FAIL: arr3[1]="); PrintStr(arr3[1]); PrintStr("\n"); return 1;
  }

  // Multi-char delimiter
  var arr4: pchar[] := StrSplit("x::y::z", "::");
  if (!StrEquals(arr4[0], "x")) {
    PrintStr("FAIL: arr4[0]="); PrintStr(arr4[0]); PrintStr("\n"); return 1;
  }
  if (!StrEquals(arr4[1], "y")) {
    PrintStr("FAIL: arr4[1]="); PrintStr(arr4[1]); PrintStr("\n"); return 1;
  }
  if (!StrEquals(arr4[2], "z")) {
    PrintStr("FAIL: arr4[2]="); PrintStr(arr4[2]); PrintStr("\n"); return 1;
  }

  PrintStr("OK\n");
  return 0;
}
