// WP-CS-11: @overflow_check snapshot test

fn main(): int64 {
  // @overflow_check(false): wraparound without panic
  @overflow_check(false);

  var maxInt: int64 := 9223372036854775807;
  var wrapped: int64 := maxInt + 1;
  var expected: int64 := 0 - 9223372036854775807 - 1;
  if (wrapped != expected) {
    write(1, "FAIL: add wrap\n"c as int64, 15);
    return 1;
  }

  var minInt: int64 := 0 - 9223372036854775807 - 1;
  var wrapped2: int64 := minInt - 1;
  if (wrapped2 != 9223372036854775807) {
    write(1, "FAIL: sub wrap\n"c as int64, 15);
    return 1;
  }

  // @overflow_check(true): normal arithmetic must not panic
  @overflow_check(true);

  var a: int64 := 1000000;
  var b: int64 := 2000000;
  var s: int64 := a + b;
  var d: int64 := b - a;
  var m: int64 := a * 3;

  if (s != 3000000) { write(1, "FAIL: add\n"c as int64, 10); return 1; }
  if (d != 1000000) { write(1, "FAIL: sub\n"c as int64, 10); return 1; }
  if (m != 3000000) { write(1, "FAIL: mul\n"c as int64, 10); return 1; }

  write(1, "PASS: overflow_check OK\n"c as int64, 24);
  return 0;
}
