// WP-CS-11: @if conditional compilation snapshot test

con ENABLED: bool := true;
con DISABLED: bool := false;
con VERSION: int64 := 42;

@if (ENABLED) {
  fn feature_on(): int64 { return 1; }
} @else {
  fn feature_on(): int64 { return 0; }
}

@if (DISABLED) {
  fn feature_off(): int64 { return 0; }
} @else {
  fn feature_off(): int64 { return 1; }
}

@if (TARGET_IS_X86_64) {
  fn arch_name(): pchar { return "x86_64"c; }
} @else {
  fn arch_name(): pchar { return "other"c; }
}

fn main(): int64 {
  // @if with constant — always picks correct branch
  if (feature_on() != 1) { write(1, "FAIL on\n"c as int64, 8); return 1; }
  if (feature_off() != 1) { write(1, "FAIL off\n"c as int64, 9); return 1; }

  // @if at statement level
  var x: int64 := 0;
  @if (VERSION == 42) {
    x := 1;
  } @else {
    x := 0;
  }
  if (x != 1) { write(1, "FAIL stmt\n"c as int64, 10); return 1; }

  // @if with bool && logic
  @if (true && ENABLED) {
    x := 10;
  } @else {
    x := 0;
  }
  if (x != 10) { write(1, "FAIL &&\n"c as int64, 8); return 1; }

  // TARGET_X86_64 system constant
  var arch: pchar := arch_name();
  write(1, arch as int64, 6);
  write(1, "\n"c as int64, 1);

  write(1, "PASS: @if OK\n"c as int64, 13);
  return 0;
}
