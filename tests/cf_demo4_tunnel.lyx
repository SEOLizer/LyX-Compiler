// tests/cf_demo4_tunnel.lyx — Demo 4: Cloudflare Tunnel + DNS Routing
// WP-CF-16

unit tests.cf_demo4_tunnel;

import std.cloud.cf.credentials;
import std.cloud.cf.transport;
import std.cloud.cf.zones;
import std.cloud.cf.tunnel;
import std.io;

pub fn main(argc: int64, argv: int64): int64 {
    var creds: CFCredentials := CFCredentialsFromEnv();
    var c: CFClient;
    c.authType:=creds.authType; c.token:=creds.token; c.apiKey:=creds.apiKey;
    c.email:=creds.email; c.accountId:=creds.accountId; c.zoneId:=creds.zoneId;
    c.timeout:=30000; c.maxRetries:=3;

    if (c.authType == 0) {
        PrintLn("Error: set CF_AUTH_TOKEN, CF_ACCOUNT_ID, CF_ZONE_ID"c); return 1;
    }

    var accountId: pchar := creds.accountId as pchar;
    var zoneId:    pchar := creds.zoneId as pchar;

    if (accountId == 0 as pchar || zoneId == 0 as pchar) {
        PrintLn("Error: CF_ACCOUNT_ID and CF_ZONE_ID required"c); return 1;
    }

    PrintLn("=== CF Demo 4: Tunnel + DNS Routing ==="c);

    // Create tunnel
    Print("Creating tunnel 'lyx-home-server'..."c);
    var t: CFTunnel := TunnelCreate(c, accountId, "lyx-home-server"c,
        "lyx-tunnel-secret-32-chars-min!!"c);
    if (t.id == 0) { PrintLn(" FAILED"c); return 1; }
    PrintLn(" OK"c);
    Print("Tunnel ID: "c); PrintLn(t.id as pchar);

    var tunnelId: pchar := t.id as pchar;

    // Add ingress rules
    Print("Adding ingress: home.example.com -> http://localhost:8080..."c);
    var ok1: int64 := TunnelIngressAdd(c, accountId, tunnelId,
        "home.example.com"c, "http://localhost:8080"c, 0 as pchar);
    if (ok1 == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }

    Print("Adding ingress: nas.example.com -> http://192.168.1.50:5000..."c);
    var ok2: int64 := TunnelIngressAdd(c, accountId, tunnelId,
        "nas.example.com"c, "http://192.168.1.50:5000"c, 0 as pchar);
    if (ok2 == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }

    // Create DNS CNAME records pointing to tunnel
    Print("DNS route for home.example.com..."c);
    var dns1: int64 := TunnelDNSRoute(c, zoneId, tunnelId,
        "home.example.com"c, 1);
    if (dns1 == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }

    Print("DNS route for nas.example.com..."c);
    var dns2: int64 := TunnelDNSRoute(c, zoneId, tunnelId,
        "nas.example.com"c, 1);
    if (dns2 == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }

    // Get token
    Print("Fetching tunnel token..."c);
    var token: int64 := TunnelToken(c, accountId, tunnelId);
    if (token != 0) {
        PrintLn(" OK"c);
        PrintLn(""c);
        PrintLn("Run cloudflared with:"c);
        Print("  cloudflared tunnel --token "c);
        PrintLn(token as pchar);
        free(token, StrLen(token as pchar)+1);
    } else {
        PrintLn(" FAILED"c);
    }

    // Show connections
    var conns: int64 := TunnelConnectionList(c, accountId, tunnelId);
    if (conns != 0) {
        Print("Connections: "c); PrintLn(conns as pchar);
        free(conns, StrLen(conns as pchar)+1);
    }

    CFTunnelFree(t);
    PrintLn("Done."c);
    return 0;
}
