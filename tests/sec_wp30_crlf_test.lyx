// tests/sec_wp30_crlf_test.lyx — WP-30: HTTP Custom-Header CRLF-Injection (20 Tests)
//
// Prüft:
//   A: HTTPRequestBuild gibt 0 zurück wenn req.headers Injection-CR/LF enthält
//      (nacktes \r, nacktes \n, oder \r\n\r\n)
//   B: HTTPRequestBuild gibt non-zero zurück bei legitimen Custom-Headern
//      (per HTTPSetHeader gebaut, enthalten \r\n als Zeilentrenner)
//   C: HTTPSetHeader validiert Name und Value einzeln (kein CR/LF erlaubt)
//   D: Host- und Path-Checks bleiben intakt (Regression)
unit tests.sec_wp30_crlf_test;

import std.net.http;
import std.alloc;

fn pass(n: int64) { Print("PASS "); PrintLn(n); }
fn fail(n: int64) { Print("FAIL "); PrintLn(n); }

// Gibt einen frisch allokierten Puffer zurück, der s (null-terminiert) enthält.
fn _mkStr(s: pchar, slen: int64): int64 {
  var buf: int64 := alloc(slen + 1);
  if buf == 0 { return 0; }
  var i: int64 := 0;
  while i < slen {
    poke8(buf + i, peek8(s as int64 + i));
    i := i + 1;
  }
  poke8(buf + slen, 0);
  return buf;
}

// Baut eine minimale HTTPRequest und gibt das Ergebnis von HTTPRequestBuild zurück.
fn _buildReq(host: pchar, path: pchar, headers: int64): int64 {
  var req: HTTPRequest;
  req.method  := HTTP_GET;
  req.host    := host;
  req.path    := path;
  req.headers := headers as pchar;
  req.body    := 0 as pchar;
  req.bodySize := 0;
  return HTTPRequestBuild(req);
}

// Gibt den mmap-Buffer einer erfolgreichen HTTPRequestBuild-Antwort frei.
fn _freeResp(resp: int64) {
  if resp == 0 { return; }
  var allocSize: int64 := peek64(resp);
  munmap(resp, allocSize);
}

@capabilities([network.tcp.connect, system.time])
pub fn main(argc: int64, argv: pchar): int64 {
  // ── A: Legitime Custom-Header → non-zero ────────────────────────────────────

  // Test 1: kein Custom-Header (headers = 0)
  var r1: int64 := _buildReq("example.com"c, "/"c, 0);
  if r1 != 0 { pass(1); _freeResp(r1); } else { fail(1); }

  // Test 2: normaler Header via HTTPSetHeader → enthält \r\n, muss durchgehen
  var h2: int64 := HTTPSetHeader(0, "X-Foo"c, "bar"c);
  var r2: int64 := _buildReq("example.com"c, "/"c, h2);
  if r2 != 0 { pass(2); _freeResp(r2); } else { fail(2); }
  HTTPHeadersFree(h2);

  // Test 3: zwei Custom-Header via HTTPSetHeader
  var h3a: int64 := HTTPSetHeader(0, "X-A"c, "1"c);
  var h3: int64 := HTTPSetHeader(h3a, "X-B"c, "2"c);
  var r3: int64 := _buildReq("example.com"c, "/"c, h3);
  if r3 != 0 { pass(3); _freeResp(r3); } else { fail(3); }
  HTTPHeadersFree(h3);

  // Test 4: Authorization-Header via HTTPSetHeader
  var h4: int64 := HTTPSetBearerToken(0, "abc123"c);
  var r4: int64 := _buildReq("api.example.com"c, "/v1/data"c, h4);
  if r4 != 0 { pass(4); _freeResp(r4); } else { fail(4); }
  HTTPHeadersFree(h4);

  // Test 5: leerer Custom-Header (kein headers) → erlaubt
  var r5: int64 := _buildReq("x.de"c, "/path"c, 0);
  if r5 != 0 { pass(5); _freeResp(r5); } else { fail(5); }

  // ── B: CRLF-Injection in req.headers → muss 0 zurückgeben ─────────────────

  // Test 6: \r\n\r\n — klassische Header-Injektion (doppeltes CRLF)
  var h6: int64 := _mkStr("X-Foo: bar\r\n\r\nGET / HTTP/1.1"c, 29);
  var r6: int64 := _buildReq("example.com"c, "/"c, h6);
  if r6 == 0 { pass(6); } else { fail(6); _freeResp(r6); }
  free(h6, 30);

  // Test 7: nacktes \n (kein vorhergehendes \r)
  var h7: int64 := _mkStr("X-Foo: bar\nX-Evil: injected\r\n"c, 28);
  var r7: int64 := _buildReq("example.com"c, "/"c, h7);
  if r7 == 0 { pass(7); } else { fail(7); _freeResp(r7); }
  free(h7, 29);

  // Test 8: nacktes \r (nicht gefolgt von \n)
  var h8: int64 := alloc(5);
  poke8(h8+0, 65); poke8(h8+1, 58); poke8(h8+2, 32); poke8(h8+3, 13); poke8(h8+4, 0);
  var r8: int64 := _buildReq("example.com"c, "/"c, h8);
  if r8 == 0 { pass(8); } else { fail(8); _freeResp(r8); }
  free(h8, 5);

  // Test 9: Request-Smuggling via \r\n\r\n in der Mitte
  var h9: int64 := _mkStr("X-A: good\r\n\r\nTransfer-Encoding: chunked\r\n"c, 41);
  var r9: int64 := _buildReq("example.com"c, "/"c, h9);
  if r9 == 0 { pass(9); } else { fail(9); _freeResp(r9); }
  free(h9, 42);

  // Test 10: \n am Anfang (nacktes LF)
  var h10: int64 := alloc(4);
  poke8(h10+0, 10); poke8(h10+1, 65); poke8(h10+2, 58); poke8(h10+3, 0);
  var r10: int64 := _buildReq("example.com"c, "/"c, h10);
  if r10 == 0 { pass(10); } else { fail(10); _freeResp(r10); }
  free(h10, 4);

  // Test 11: \r\n\r\n am Ende (leere Zeile = Headerabschluss)
  var h11: int64 := _mkStr("X-Foo: bar\r\n\r\n"c, 14);
  var r11: int64 := _buildReq("example.com"c, "/"c, h11);
  if r11 == 0 { pass(11); } else { fail(11); _freeResp(r11); }
  free(h11, 15);

  // ── C: HTTPSetHeader validiert Name und Value ──────────────────────────────

  // Test 12: Name mit \r\n → HTTPSetHeader gibt 0 zurück
  var name12: int64 := _mkStr("X-Evil\r\nHost"c, 12);
  var h12: int64 := HTTPSetHeader(0, name12 as pchar, "val"c);
  if h12 == 0 { pass(12); } else { fail(12); HTTPHeadersFree(h12); }
  free(name12, 13);

  // Test 13: Value mit \r\n → HTTPSetHeader gibt 0 zurück
  var val13: int64 := _mkStr("safe\r\nX-Evil: injected"c, 22);
  var h13: int64 := HTTPSetHeader(0, "X-Header"c, val13 as pchar);
  if h13 == 0 { pass(13); } else { fail(13); HTTPHeadersFree(h13); }
  free(val13, 23);

  // Test 14: Name mit nacktem \n → HTTPSetHeader gibt 0 zurück
  var name14: int64 := _mkStr("X-A\nX-B"c, 7);
  var h14: int64 := HTTPSetHeader(0, name14 as pchar, "value"c);
  if h14 == 0 { pass(14); } else { fail(14); HTTPHeadersFree(h14); }
  free(name14, 8);

  // Test 15: Value mit nacktem \r → HTTPSetHeader gibt 0 zurück
  var val15: int64 := alloc(5);
  poke8(val15+0, 118); poke8(val15+1, 97); poke8(val15+2, 108);
  poke8(val15+3, 13); poke8(val15+4, 0);
  var h15: int64 := HTTPSetHeader(0, "X-Test"c, val15 as pchar);
  if h15 == 0 { pass(15); } else { fail(15); HTTPHeadersFree(h15); }
  free(val15, 5);

  // Test 16: sauberer Name und Value → HTTPSetHeader gibt non-zero zurück
  var h16: int64 := HTTPSetHeader(0, "X-Clean"c, "safe-value"c);
  if h16 != 0 { pass(16); HTTPHeadersFree(h16); } else { fail(16); }

  // Test 17: langer sauberer Header via HTTPSetHeader → HTTPRequestBuild OK
  var h17: int64 := HTTPSetHeader(0, "X-Request-ID"c, "1234567890abcdef"c);
  var r17: int64 := _buildReq("example.com"c, "/"c, h17);
  if r17 != 0 { pass(17); _freeResp(r17); } else { fail(17); }
  HTTPHeadersFree(h17);

  // ── D: Regression — Host- und Path-Checks noch intakt ───────────────────────

  // Test 18: Host mit \r\n → muss 0 zurückgeben (WP-9.1)
  var r18: int64 := _buildReq("evil.com\r\nHost: good.com"c, "/"c, 0);
  if r18 == 0 { pass(18); } else { fail(18); _freeResp(r18); }

  // Test 19: Path mit \r\n → muss 0 zurückgeben (WP-9.2)
  var r19: int64 := _buildReq("example.com"c, "/x\r\nX-Injected: val"c, 0);
  if r19 == 0 { pass(19); } else { fail(19); _freeResp(r19); }

  // Test 20: alles sauber — normaler GET-Request mit zwei Custom-Headern
  var h20a: int64 := HTTPSetHeader(0, "X-Request-ID"c, "42"c);
  var h20: int64 := HTTPSetHeader(h20a, "X-Client"c, "lyxc"c);
  var r20: int64 := _buildReq("api.example.org"c, "/health"c, h20);
  if r20 != 0 { pass(20); _freeResp(r20); } else { fail(20); }
  HTTPHeadersFree(h20);

  return 0;
}
