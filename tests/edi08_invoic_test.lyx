// tests/edi08_invoic_test.lyx — EDI-08: INVOIC + INVCON + COMDIS + COACSU tests

unit tests.edi08_invoic_test;

import std.edi.core;
import std.edi.invoice;
import std.alloc;
import std.io;

fn hasTag(buf: int64, bufLen: int64, t0: int64, t1: int64, t2: int64): int64 {
    var i: int64 := 0;
    while (i + 2 < bufLen) {
        if (peek8(buf+i) == t0 && peek8(buf+i+1) == t1 && peek8(buf+i+2) == t2) {
            return 1;
        }
        i := i + 1;
    }
    return 0;
}

fn memEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
        if (peek8(a+i) != peek8(b+i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Tests 1-20: INVOIC — 3-line invoice (S 19% + AA 7% + Z 0%), round-trip,
    //             validate, BGM-qualifier coverage
    //
    // Computed totals:
    //   line0: qty=10 × price=1999 → netAmt=19990, tax_S=19990×19/100=3798
    //   line1: qty=5  × price=500  → netAmt=2500,  tax_AA=2500×7/100=175
    //   line2: qty=3  × price=1000 → netAmt=3000,  tax_Z=0
    //   netTotal=25490  taxTotal=3973  grossTotal=29463
    // -------------------------------------------------------------------------
    var buf1: int64 := alloc(8192);
    var zi: int64 := 0;
    while (zi < 8192) { poke8(buf1 + zi, 0); zi := zi + 1; }

    var hdr1: int64 := alloc(EDI_INVOIC_HDR_SIZE);
    zi := 0;
    while (zi < EDI_INVOIC_HDR_SIZE) { poke8(hdr1 + zi, 0); zi := zi + 1; }
    poke64(hdr1 + EDI_INVOIC_HDR_BGMQUAL,  380);
    poke64(hdr1 + EDI_INVOIC_HDR_NUM,      "INV-2026-001"c as int64);
    poke64(hdr1 + EDI_INVOIC_HDR_NUMLEN,   12);
    poke64(hdr1 + EDI_INVOIC_HDR_DATE,     "20260615"c as int64);
    poke64(hdr1 + EDI_INVOIC_HDR_SUPPLIER, "4012345000014"c as int64);
    poke64(hdr1 + EDI_INVOIC_HDR_SUPLEN,   13);
    poke64(hdr1 + EDI_INVOIC_HDR_BUYER,    "4000001000017"c as int64);
    poke64(hdr1 + EDI_INVOIC_HDR_BUYLEN,   13);
    poke64(hdr1 + EDI_INVOIC_HDR_CURRENCY, "EUR"c as int64);
    poke64(hdr1 + EDI_INVOIC_HDR_CURLEN,   3);

    var ilines: int64 := alloc(3 * EDI_INVOIC_LINE_SIZE);
    zi := 0;
    while (zi < 3 * EDI_INVOIC_LINE_SIZE) { poke8(ilines + zi, 0); zi := zi + 1; }

    var il0: int64 := ilines + 0 * EDI_INVOIC_LINE_SIZE;
    poke64(il0 + EDI_INVOIC_LINE_GTIN,    "04006381333931"c as int64);
    poke64(il0 + EDI_INVOIC_LINE_GTINLEN, 14);
    poke64(il0 + EDI_INVOIC_LINE_QTY,     10);
    poke64(il0 + EDI_INVOIC_LINE_PRICE,   1999);
    poke64(il0 + EDI_INVOIC_LINE_NETAMT,  19990);
    poke64(il0 + EDI_INVOIC_LINE_TAXTYPE, EDI_INVOIC_TAX_S);

    var il1: int64 := ilines + 1 * EDI_INVOIC_LINE_SIZE;
    poke64(il1 + EDI_INVOIC_LINE_GTIN,    "04006381000045"c as int64);
    poke64(il1 + EDI_INVOIC_LINE_GTINLEN, 14);
    poke64(il1 + EDI_INVOIC_LINE_QTY,     5);
    poke64(il1 + EDI_INVOIC_LINE_PRICE,   500);
    poke64(il1 + EDI_INVOIC_LINE_NETAMT,  2500);
    poke64(il1 + EDI_INVOIC_LINE_TAXTYPE, EDI_INVOIC_TAX_AA);

    var il2: int64 := ilines + 2 * EDI_INVOIC_LINE_SIZE;
    poke64(il2 + EDI_INVOIC_LINE_GTIN,    "04006381000052"c as int64);
    poke64(il2 + EDI_INVOIC_LINE_GTINLEN, 14);
    poke64(il2 + EDI_INVOIC_LINE_QTY,     3);
    poke64(il2 + EDI_INVOIC_LINE_PRICE,   1000);
    poke64(il2 + EDI_INVOIC_LINE_NETAMT,  3000);
    poke64(il2 + EDI_INVOIC_LINE_TAXTYPE, EDI_INVOIC_TAX_Z);

    var w1: int64 := EdiInvoicWrite(hdr1, ilines, 3, buf1, 8192);

    // Test 1: write > 0
    if (w1 <= 0) {
        PrintLn("FAIL: EdiInvoicWrite should return > 0"c); ok := 0;
    } else { PrintLn("PASS: EdiInvoicWrite returns > 0"c); }

    // Test 2: has BGM tag (66=B,71=G,77=M)
    if (hasTag(buf1, w1, 66, 71, 77) != 1) {
        PrintLn("FAIL: INVOIC missing BGM tag"c); ok := 0;
    } else { PrintLn("PASS: INVOIC has BGM tag"c); }

    // Test 3: has LIN tag (76=L,73=I,78=N)
    if (hasTag(buf1, w1, 76, 73, 78) != 1) {
        PrintLn("FAIL: INVOIC missing LIN tag"c); ok := 0;
    } else { PrintLn("PASS: INVOIC has LIN tag"c); }

    // Test 4: has TAX tag (84=T,65=A,88=X)
    if (hasTag(buf1, w1, 84, 65, 88) != 1) {
        PrintLn("FAIL: INVOIC missing TAX tag"c); ok := 0;
    } else { PrintLn("PASS: INVOIC has TAX tag"c); }

    // Test 5: has UNS tag (85=U,78=N,83=S)
    if (hasTag(buf1, w1, 85, 78, 83) != 1) {
        PrintLn("FAIL: INVOIC missing UNS+S separator"c); ok := 0;
    } else { PrintLn("PASS: INVOIC has UNS+S separator"c); }

    // Round-trip read
    var rhdr1: int64 := alloc(EDI_INVOIC_HDR_SIZE);
    zi := 0;
    while (zi < EDI_INVOIC_HDR_SIZE) { poke8(rhdr1 + zi, 0); zi := zi + 1; }
    var rlines: int64 := alloc(4 * EDI_INVOIC_LINE_SIZE);
    zi := 0;
    while (zi < 4 * EDI_INVOIC_LINE_SIZE) { poke8(rlines + zi, 0); zi := zi + 1; }

    var rcnt: int64 := EdiInvoicRead(buf1, w1, rhdr1, rlines, 4);

    // Test 6: lineCount = 3
    if (rcnt != 3) {
        PrintLn("FAIL: EdiInvoicRead should return 3 lines"c); ok := 0;
    } else { PrintLn("PASS: EdiInvoicRead returns 3 lines"c); }

    // Test 7: bgmQual = 380
    if (peek64(rhdr1 + EDI_INVOIC_HDR_BGMQUAL) != 380) {
        PrintLn("FAIL: bgmQual should be 380"c); ok := 0;
    } else { PrintLn("PASS: bgmQual=380 (invoice)"c); }

    // Test 8: supplier GLN round-trip
    var rsp: int64 := peek64(rhdr1 + EDI_INVOIC_HDR_SUPPLIER);
    var rsl: int64 := peek64(rhdr1 + EDI_INVOIC_HDR_SUPLEN);
    if (memEq(rsp, rsl, "4012345000014"c as int64, 13) != 1) {
        PrintLn("FAIL: supplier GLN mismatch"c); ok := 0;
    } else { PrintLn("PASS: supplier GLN=4012345000014"c); }

    // Test 9: buyer GLN round-trip
    var rbp: int64 := peek64(rhdr1 + EDI_INVOIC_HDR_BUYER);
    var rbl: int64 := peek64(rhdr1 + EDI_INVOIC_HDR_BUYLEN);
    if (memEq(rbp, rbl, "4000001000017"c as int64, 13) != 1) {
        PrintLn("FAIL: buyer GLN mismatch"c); ok := 0;
    } else { PrintLn("PASS: buyer GLN=4000001000017"c); }

    // Test 10: line[0] GTIN round-trip
    var rl0: int64 := rlines + 0 * EDI_INVOIC_LINE_SIZE;
    var rg0p: int64 := peek64(rl0 + EDI_INVOIC_LINE_GTIN);
    var rg0l: int64 := peek64(rl0 + EDI_INVOIC_LINE_GTINLEN);
    if (memEq(rg0p, rg0l, "04006381333931"c as int64, 14) != 1) {
        PrintLn("FAIL: line[0] GTIN mismatch"c); ok := 0;
    } else { PrintLn("PASS: line[0] GTIN=04006381333931"c); }

    // Test 11: line[0] qty = 10
    if (peek64(rl0 + EDI_INVOIC_LINE_QTY) != 10) {
        PrintLn("FAIL: line[0] qty should be 10"c); ok := 0;
    } else { PrintLn("PASS: line[0] qty=10"c); }

    // Test 12: line[0] price = 1999 (19.99 EUR)
    if (peek64(rl0 + EDI_INVOIC_LINE_PRICE) != 1999) {
        PrintLn("FAIL: line[0] price should be 1999"c); ok := 0;
    } else { PrintLn("PASS: line[0] price=1999 (19.99 EUR)"c); }

    // Test 13: line[0] taxType = S (1)
    if (peek64(rl0 + EDI_INVOIC_LINE_TAXTYPE) != EDI_INVOIC_TAX_S) {
        PrintLn("FAIL: line[0] taxType should be S(1)"c); ok := 0;
    } else { PrintLn("PASS: line[0] taxType=S (19%)"c); }

    // Test 14: line[1] taxType = AA (2)
    var rl1: int64 := rlines + 1 * EDI_INVOIC_LINE_SIZE;
    if (peek64(rl1 + EDI_INVOIC_LINE_TAXTYPE) != EDI_INVOIC_TAX_AA) {
        PrintLn("FAIL: line[1] taxType should be AA(2)"c); ok := 0;
    } else { PrintLn("PASS: line[1] taxType=AA (7%)"c); }

    // Test 15: line[2] taxType = Z (3)
    var rl2: int64 := rlines + 2 * EDI_INVOIC_LINE_SIZE;
    if (peek64(rl2 + EDI_INVOIC_LINE_TAXTYPE) != EDI_INVOIC_TAX_Z) {
        PrintLn("FAIL: line[2] taxType should be Z(3)"c); ok := 0;
    } else { PrintLn("PASS: line[2] taxType=Z (0%)"c); }

    // Test 16: netTotal = 25490 (19990+2500+3000)
    if (peek64(rhdr1 + EDI_INVOIC_HDR_NETTOTAL) != 25490) {
        PrintLn("FAIL: netTotal should be 25490"c); ok := 0;
    } else { PrintLn("PASS: netTotal=25490 (254.90 EUR)"c); }

    // Test 17: taxTotal = 3973 (3798 S + 175 AA)
    if (peek64(rhdr1 + EDI_INVOIC_HDR_TAXTOTAL) != 3973) {
        PrintLn("FAIL: taxTotal should be 3973"c); ok := 0;
    } else { PrintLn("PASS: taxTotal=3973 (39.73 EUR)"c); }

    // Test 18: grossTotal = 29463 (25490+3973)
    if (peek64(rhdr1 + EDI_INVOIC_HDR_GROSSTOTAL) != 29463) {
        PrintLn("FAIL: grossTotal should be 29463"c); ok := 0;
    } else { PrintLn("PASS: grossTotal=29463 (294.63 EUR)"c); }

    // Test 19: EdiInvoicValidate → 0 (correct totals)
    if (EdiInvoicValidate(rhdr1, rlines, rcnt) != 0) {
        PrintLn("FAIL: EdiInvoicValidate should return 0"c); ok := 0;
    } else { PrintLn("PASS: EdiInvoicValidate=0 (ok)"c); }

    // Test 20: EdiInvoicValidate → 1 when netTotal tampered (+10000)
    poke64(rhdr1 + EDI_INVOIC_HDR_NETTOTAL, 99999);
    if (EdiInvoicValidate(rhdr1, rlines, rcnt) != 1) {
        PrintLn("FAIL: EdiInvoicValidate should return 1 (net err)"c); ok := 0;
    } else { PrintLn("PASS: EdiInvoicValidate=1 (tampered net)"c); }

    free(rlines, 4 * EDI_INVOIC_LINE_SIZE);
    free(rhdr1, EDI_INVOIC_HDR_SIZE);
    free(ilines, 3 * EDI_INVOIC_LINE_SIZE);
    free(hdr1, EDI_INVOIC_HDR_SIZE);
    free(buf1, 8192);

    // -------------------------------------------------------------------------
    // Tests 21-23: BGM qualifiers 381 (credit note), 383 (debit), 386 (prepayment)
    // -------------------------------------------------------------------------
    var buf2: int64 := alloc(4096);
    var hdr2: int64 := alloc(EDI_INVOIC_HDR_SIZE);
    var l2:   int64 := alloc(EDI_INVOIC_LINE_SIZE);
    var rhdr2:int64 := alloc(EDI_INVOIC_HDR_SIZE);
    var rl2b: int64 := alloc(2 * EDI_INVOIC_LINE_SIZE);

    zi := 0;
    while (zi < EDI_INVOIC_LINE_SIZE) { poke8(l2 + zi, 0); zi := zi + 1; }
    poke64(l2 + EDI_INVOIC_LINE_QTY,     1);
    poke64(l2 + EDI_INVOIC_LINE_PRICE,   10000);
    poke64(l2 + EDI_INVOIC_LINE_NETAMT,  10000);
    poke64(l2 + EDI_INVOIC_LINE_TAXTYPE, EDI_INVOIC_TAX_S);

    // Test 21: BGM qual 381 (credit note)
    zi := 0;
    while (zi < 4096) { poke8(buf2 + zi, 0); zi := zi + 1; }
    zi := 0;
    while (zi < EDI_INVOIC_HDR_SIZE) { poke8(hdr2 + zi, 0); zi := zi + 1; }
    poke64(hdr2 + EDI_INVOIC_HDR_BGMQUAL, 381);
    var w2: int64 := EdiInvoicWrite(hdr2, l2, 1, buf2, 4096);
    zi := 0;
    while (zi < EDI_INVOIC_HDR_SIZE) { poke8(rhdr2 + zi, 0); zi := zi + 1; }
    zi := 0;
    while (zi < 2 * EDI_INVOIC_LINE_SIZE) { poke8(rl2b + zi, 0); zi := zi + 1; }
    EdiInvoicRead(buf2, w2, rhdr2, rl2b, 2);
    if (peek64(rhdr2 + EDI_INVOIC_HDR_BGMQUAL) != 381) {
        PrintLn("FAIL: bgmQual 381 not round-tripped"c); ok := 0;
    } else { PrintLn("PASS: bgmQual=381 (credit note)"c); }

    // Test 22: BGM qual 383 (debit)
    zi := 0;
    while (zi < 4096) { poke8(buf2 + zi, 0); zi := zi + 1; }
    zi := 0;
    while (zi < EDI_INVOIC_HDR_SIZE) { poke8(hdr2 + zi, 0); zi := zi + 1; }
    poke64(hdr2 + EDI_INVOIC_HDR_BGMQUAL, 383);
    w2 := EdiInvoicWrite(hdr2, l2, 1, buf2, 4096);
    zi := 0;
    while (zi < EDI_INVOIC_HDR_SIZE) { poke8(rhdr2 + zi, 0); zi := zi + 1; }
    EdiInvoicRead(buf2, w2, rhdr2, rl2b, 2);
    if (peek64(rhdr2 + EDI_INVOIC_HDR_BGMQUAL) != 383) {
        PrintLn("FAIL: bgmQual 383 not round-tripped"c); ok := 0;
    } else { PrintLn("PASS: bgmQual=383 (debit)"c); }

    // Test 23: BGM qual 386 (prepayment)
    zi := 0;
    while (zi < 4096) { poke8(buf2 + zi, 0); zi := zi + 1; }
    zi := 0;
    while (zi < EDI_INVOIC_HDR_SIZE) { poke8(hdr2 + zi, 0); zi := zi + 1; }
    poke64(hdr2 + EDI_INVOIC_HDR_BGMQUAL, 386);
    w2 := EdiInvoicWrite(hdr2, l2, 1, buf2, 4096);
    zi := 0;
    while (zi < EDI_INVOIC_HDR_SIZE) { poke8(rhdr2 + zi, 0); zi := zi + 1; }
    EdiInvoicRead(buf2, w2, rhdr2, rl2b, 2);
    if (peek64(rhdr2 + EDI_INVOIC_HDR_BGMQUAL) != 386) {
        PrintLn("FAIL: bgmQual 386 not round-tripped"c); ok := 0;
    } else { PrintLn("PASS: bgmQual=386 (prepayment)"c); }

    free(rl2b, 2 * EDI_INVOIC_LINE_SIZE);
    free(rhdr2, EDI_INVOIC_HDR_SIZE);
    free(l2, EDI_INVOIC_LINE_SIZE);
    free(hdr2, EDI_INVOIC_HDR_SIZE);
    free(buf2, 4096);

    // -------------------------------------------------------------------------
    // Tests 24-28: INVCON round-trip
    //   contractNum=CON-2026-001, invoiceRef=INV-001, amount=250000 (2500.00 EUR)
    // -------------------------------------------------------------------------
    var buf3: int64 := alloc(2048);
    zi := 0;
    while (zi < 2048) { poke8(buf3 + zi, 0); zi := zi + 1; }

    var chdr: int64 := alloc(EDI_INVCON_HDR_SIZE);
    zi := 0;
    while (zi < EDI_INVCON_HDR_SIZE) { poke8(chdr + zi, 0); zi := zi + 1; }
    poke64(chdr + EDI_INVCON_HDR_CONTRACTNUM, "CON-2026-001"c as int64);
    poke64(chdr + EDI_INVCON_HDR_NUMLEN,      12);
    poke64(chdr + EDI_INVCON_HDR_DATE,        "20260615"c as int64);
    poke64(chdr + EDI_INVCON_HDR_INVOICEREF,  "INV-001"c as int64);
    poke64(chdr + EDI_INVCON_HDR_REFLEN,      7);
    poke64(chdr + EDI_INVCON_HDR_AMOUNT,      250000);
    poke64(chdr + EDI_INVCON_HDR_CURRENCY,    "EUR"c as int64);
    poke64(chdr + EDI_INVCON_HDR_CURLEN,      3);

    var w3: int64 := EdiInvconWrite(chdr, buf3, 2048);

    // Test 24: write > 0
    if (w3 <= 0) {
        PrintLn("FAIL: EdiInvconWrite should return > 0"c); ok := 0;
    } else { PrintLn("PASS: EdiInvconWrite returns > 0"c); }

    var rchdr: int64 := alloc(EDI_INVCON_HDR_SIZE);
    zi := 0;
    while (zi < EDI_INVCON_HDR_SIZE) { poke8(rchdr + zi, 0); zi := zi + 1; }
    EdiInvconRead(buf3, w3, rchdr);

    // Test 25: contractNum = CON-2026-001
    var rcnp: int64 := peek64(rchdr + EDI_INVCON_HDR_CONTRACTNUM);
    var rcnl: int64 := peek64(rchdr + EDI_INVCON_HDR_NUMLEN);
    if (memEq(rcnp, rcnl, "CON-2026-001"c as int64, 12) != 1) {
        PrintLn("FAIL: INVCON contractNum mismatch"c); ok := 0;
    } else { PrintLn("PASS: INVCON contractNum=CON-2026-001"c); }

    // Test 26: invoiceRef = INV-001
    var rirp: int64 := peek64(rchdr + EDI_INVCON_HDR_INVOICEREF);
    var rirl: int64 := peek64(rchdr + EDI_INVCON_HDR_REFLEN);
    if (memEq(rirp, rirl, "INV-001"c as int64, 7) != 1) {
        PrintLn("FAIL: INVCON invoiceRef mismatch"c); ok := 0;
    } else { PrintLn("PASS: INVCON invoiceRef=INV-001"c); }

    // Test 27: amount = 250000 (2500.00 EUR)
    if (peek64(rchdr + EDI_INVCON_HDR_AMOUNT) != 250000) {
        PrintLn("FAIL: INVCON amount should be 250000"c); ok := 0;
    } else { PrintLn("PASS: INVCON amount=250000 (2500.00 EUR)"c); }

    // Test 28: currency = EUR
    var rcurp: int64 := peek64(rchdr + EDI_INVCON_HDR_CURRENCY);
    var rcurl: int64 := peek64(rchdr + EDI_INVCON_HDR_CURLEN);
    if (memEq(rcurp, rcurl, "EUR"c as int64, 3) != 1) {
        PrintLn("FAIL: INVCON currency mismatch"c); ok := 0;
    } else { PrintLn("PASS: INVCON currency=EUR"c); }

    free(rchdr, EDI_INVCON_HDR_SIZE);
    free(chdr, EDI_INVCON_HDR_SIZE);
    free(buf3, 2048);

    // -------------------------------------------------------------------------
    // Tests 29-33: COMDIS round-trip
    //   disputeRef=DIS-001, invoiceRef=INV-002, amount=15000, reason=PRICEDISPUTE
    // -------------------------------------------------------------------------
    var buf4: int64 := alloc(2048);
    zi := 0;
    while (zi < 2048) { poke8(buf4 + zi, 0); zi := zi + 1; }

    var dhdr: int64 := alloc(EDI_COMDIS_HDR_SIZE);
    zi := 0;
    while (zi < EDI_COMDIS_HDR_SIZE) { poke8(dhdr + zi, 0); zi := zi + 1; }
    poke64(dhdr + EDI_COMDIS_HDR_DISPUTEREF, "DIS-001"c as int64);
    poke64(dhdr + EDI_COMDIS_HDR_REFLEN,     7);
    poke64(dhdr + EDI_COMDIS_HDR_DATE,       "20260615"c as int64);
    poke64(dhdr + EDI_COMDIS_HDR_INVOICEREF, "INV-002"c as int64);
    poke64(dhdr + EDI_COMDIS_HDR_IREFLEN,    7);
    poke64(dhdr + EDI_COMDIS_HDR_AMOUNT,     15000);
    poke64(dhdr + EDI_COMDIS_HDR_REASON,     "PRICEDISPUTE"c as int64);
    poke64(dhdr + EDI_COMDIS_HDR_REASONLEN,  12);

    var w4: int64 := EdiComdisWrite(dhdr, buf4, 2048);

    // Test 29: write > 0
    if (w4 <= 0) {
        PrintLn("FAIL: EdiComdisWrite should return > 0"c); ok := 0;
    } else { PrintLn("PASS: EdiComdisWrite returns > 0"c); }

    var rdhdr: int64 := alloc(EDI_COMDIS_HDR_SIZE);
    zi := 0;
    while (zi < EDI_COMDIS_HDR_SIZE) { poke8(rdhdr + zi, 0); zi := zi + 1; }
    EdiComdisRead(buf4, w4, rdhdr);

    // Test 30: disputeRef = DIS-001
    var rdrp: int64 := peek64(rdhdr + EDI_COMDIS_HDR_DISPUTEREF);
    var rdrl: int64 := peek64(rdhdr + EDI_COMDIS_HDR_REFLEN);
    if (memEq(rdrp, rdrl, "DIS-001"c as int64, 7) != 1) {
        PrintLn("FAIL: COMDIS disputeRef mismatch"c); ok := 0;
    } else { PrintLn("PASS: COMDIS disputeRef=DIS-001"c); }

    // Test 31: invoiceRef = INV-002
    var rdirp: int64 := peek64(rdhdr + EDI_COMDIS_HDR_INVOICEREF);
    var rdirl: int64 := peek64(rdhdr + EDI_COMDIS_HDR_IREFLEN);
    if (memEq(rdirp, rdirl, "INV-002"c as int64, 7) != 1) {
        PrintLn("FAIL: COMDIS invoiceRef mismatch"c); ok := 0;
    } else { PrintLn("PASS: COMDIS invoiceRef=INV-002"c); }

    // Test 32: amount = 15000 (150.00 EUR)
    if (peek64(rdhdr + EDI_COMDIS_HDR_AMOUNT) != 15000) {
        PrintLn("FAIL: COMDIS amount should be 15000"c); ok := 0;
    } else { PrintLn("PASS: COMDIS amount=15000 (150.00 EUR)"c); }

    // Test 33: reason = PRICEDISPUTE
    var rrsrp: int64 := peek64(rdhdr + EDI_COMDIS_HDR_REASON);
    var rrsrl: int64 := peek64(rdhdr + EDI_COMDIS_HDR_REASONLEN);
    if (memEq(rrsrp, rrsrl, "PRICEDISPUTE"c as int64, 12) != 1) {
        PrintLn("FAIL: COMDIS reason mismatch"c); ok := 0;
    } else { PrintLn("PASS: COMDIS reason=PRICEDISPUTE"c); }

    free(rdhdr, EDI_COMDIS_HDR_SIZE);
    free(dhdr, EDI_COMDIS_HDR_SIZE);
    free(buf4, 2048);

    // -------------------------------------------------------------------------
    // Tests 34-37: COACSU round-trip
    //   accountRef=ACC-001, netBalance=125000 (1250.00), grossBalance=148750 (1487.50)
    // -------------------------------------------------------------------------
    var buf5: int64 := alloc(2048);
    zi := 0;
    while (zi < 2048) { poke8(buf5 + zi, 0); zi := zi + 1; }

    var ahdr: int64 := alloc(EDI_COACSU_HDR_SIZE);
    zi := 0;
    while (zi < EDI_COACSU_HDR_SIZE) { poke8(ahdr + zi, 0); zi := zi + 1; }
    poke64(ahdr + EDI_COACSU_HDR_ACCOUNTREF,   "ACC-001"c as int64);
    poke64(ahdr + EDI_COACSU_HDR_REFLEN,       7);
    poke64(ahdr + EDI_COACSU_HDR_DATE,         "20260615"c as int64);
    poke64(ahdr + EDI_COACSU_HDR_NETBALANCE,   125000);
    poke64(ahdr + EDI_COACSU_HDR_GROSSBALANCE, 148750);
    poke64(ahdr + EDI_COACSU_HDR_CURRENCY,     "EUR"c as int64);
    poke64(ahdr + EDI_COACSU_HDR_CURLEN,       3);

    var w5: int64 := EdiCoacsuWrite(ahdr, buf5, 2048);

    // Test 34: write > 0
    if (w5 <= 0) {
        PrintLn("FAIL: EdiCoacsuWrite should return > 0"c); ok := 0;
    } else { PrintLn("PASS: EdiCoacsuWrite returns > 0"c); }

    var rahdr: int64 := alloc(EDI_COACSU_HDR_SIZE);
    zi := 0;
    while (zi < EDI_COACSU_HDR_SIZE) { poke8(rahdr + zi, 0); zi := zi + 1; }
    EdiCoacsuRead(buf5, w5, rahdr);

    // Test 35: accountRef = ACC-001
    var rarp: int64 := peek64(rahdr + EDI_COACSU_HDR_ACCOUNTREF);
    var rarl: int64 := peek64(rahdr + EDI_COACSU_HDR_REFLEN);
    if (memEq(rarp, rarl, "ACC-001"c as int64, 7) != 1) {
        PrintLn("FAIL: COACSU accountRef mismatch"c); ok := 0;
    } else { PrintLn("PASS: COACSU accountRef=ACC-001"c); }

    // Test 36: netBalance = 125000 (1250.00 EUR)
    if (peek64(rahdr + EDI_COACSU_HDR_NETBALANCE) != 125000) {
        PrintLn("FAIL: COACSU netBalance should be 125000"c); ok := 0;
    } else { PrintLn("PASS: COACSU netBalance=125000 (1250.00 EUR)"c); }

    // Test 37: grossBalance = 148750 (1487.50 EUR)
    if (peek64(rahdr + EDI_COACSU_HDR_GROSSBALANCE) != 148750) {
        PrintLn("FAIL: COACSU grossBalance should be 148750"c); ok := 0;
    } else { PrintLn("PASS: COACSU grossBalance=148750 (1487.50 EUR)"c); }

    free(rahdr, EDI_COACSU_HDR_SIZE);
    free(ahdr, EDI_COACSU_HDR_SIZE);
    free(buf5, 2048);

    if (ok == 1) {
        PrintLn("ALL PASS"c);
        return 0;
    }
    PrintLn("SOME TESTS FAILED"c);
    return 1;
}
