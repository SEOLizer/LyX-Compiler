// tests/prime_test.lyx
// Selbstpruefende Testbatterie fuer std.prime.
//
// Die interessanten Faelle sind nicht die Primzahlen, sondern die Zahlen, die
// sich als solche ausgeben:
//
//   * Carmichael-Zahlen (561, 1105, 1729, ...) bestehen den Fermat-Test fuer
//     JEDE teilerfremde Basis. Miller-Rabin faellt nicht darauf herein — der
//     Unterschied zwischen beiden Verfahren ist hier gepruefte Aussage.
//   * Starke Pseudoprimzahlen wie 2047 = 23*89 ueberstehen die Basis 2 und
//     werden erst von der naechsten Basis entlarvt. Damit ist belegt, dass
//     mehrere Runden noetig sind und nicht bloss Zierde.
//   * Die groesste Primzahl unter 2^64 (18446744073709551557) hat als int64
//     ein NEGATIVES Bitmuster — der Test dafuer haelt einen tatsaechlich
//     aufgetretenen Fehler fest.
//
// Sollwerte aus einem unabhaengigen Python-Miller-Rabin und aus Listen
// bekannter Carmichael- und Pseudoprimzahlen. Dazu ein vollstaendiger Abgleich
// gegen ein Sieb des Eratosthenes bis 2000 — dort ist jede Antwort beweisbar.

unit main;

import std.prime;
import std.bignum;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;
var _n: int64 := 0;

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr("\n"c);
  }
}

// Primzahltest fuer eine Zahl, die als Zeichenkette gegeben ist.
fn IsP(s: pchar): bool {
  BigFromDecimal(s as pchar, _n);
  return PrimeIsPrime(_n, 13);
}

fn CheckPrime(s: pchar, want: bool): void {
  _checks := _checks + 1;
  if (IsP(s) != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(s);
    PrintStr(" -> "c);
    if (want) { PrintStr("sollte PRIM sein\n"c); }
    else { PrintStr("sollte zusammengesetzt sein\n"c); }
  }
}

fn main(): int64 {
  _n := BigNew(20);
  var a: int64 := BigNew(20);
  var b: int64 := BigNew(20);
  var out: int64 := BigNew(20);

  // ── Die Tabelle der kleinen Primzahlen ─────────────────────────────────────
  CheckI("small.0"c, PrimeSmall(0), 2);
  CheckI("small.1"c, PrimeSmall(1), 3);
  CheckI("small.12"c, PrimeSmall(12), 41);
  CheckI("small.53"c, PrimeSmall(53), 251);
  CheckI("small.oob"c, PrimeSmall(54), 0);
  CheckI("small.neg"c, PrimeSmall(0 - 1), 0);

  // ── Randfaelle ─────────────────────────────────────────────────────────────
  CheckPrime("0"c, false);
  CheckPrime("1"c, false);
  CheckPrime("2"c, true);
  CheckPrime("3"c, true);
  CheckPrime("4"c, false);
  CheckPrime("5"c, true);
  CheckPrime("9"c, false);
  CheckPrime("-7"c, false);      // negative Zahlen sind keine Primzahlen
  CheckPrime("251"c, true);
  CheckPrime("252"c, false);
  CheckPrime("253"c, false);     // 11*23, knapp ueber der Tabelle
  CheckPrime("257"c, true);
  CheckPrime("65537"c, true);    // der uebliche RSA-Exponent

  // ── Carmichael-Zahlen ──────────────────────────────────────────────────────
  //
  // Diese Zahlen sind zusammengesetzt, bestehen aber den Fermat-Test fuer jede
  // zu ihnen teilerfremde Basis. Genau deshalb reicht Fermat nicht und es
  // braucht Miller-Rabin.
  CheckPrime("561"c, false);       // 3*11*17
  CheckPrime("1105"c, false);
  CheckPrime("1729"c, false);      // die Taxi-Zahl
  CheckPrime("2465"c, false);
  CheckPrime("2821"c, false);
  CheckPrime("6601"c, false);
  CheckPrime("8911"c, false);
  CheckPrime("62745"c, false);
  CheckPrime("162401"c, false);
  CheckPrime("101101"c, false);
  CheckPrime("410041"c, false);

  // ── Starke Pseudoprimzahlen ────────────────────────────────────────────────
  //
  // 2047 = 23*89 uebersteht die Basis 2. Wer nur eine Runde rechnet, haelt sie
  // fuer prim — mit der zweiten Basis faellt sie.
  BigFromDecimal("2047"c, a);
  BigFromDecimal("2"c, b);
  CheckB("2047.base2Silent"c, PrimeIsWitness(a, b), false);
  BigFromDecimal("3"c, b);
  CheckB("2047.base3Catches"c, PrimeIsWitness(a, b), true);
  // Ueber PrimeIsPrime faellt 2047 schon der Probedivision zum Opfer (23 steht
  // in der Tabelle) — die Rundenzahl kommt gar nicht zum Tragen. Der Beleg,
  // dass Runden zaehlen, braucht eine Zahl mit grossen Faktoren: 1373653 ist
  // 829 * 1657, beide oberhalb der Tabelle.
  CheckI("2047.caughtByTrialDivision"c, PrimeTrialDivide(a), 23);

  // 1373653 uebersteht die Basen 2 und 3
  BigFromDecimal("1373653"c, a);
  CheckB("1373653.twoRounds"c, PrimeIsPrime(a, 2), true);
  CheckB("1373653.threeRounds"c, PrimeIsPrime(a, 3), false);
  // 25326001 uebersteht 2, 3 und 5
  BigFromDecimal("25326001"c, a);
  CheckB("25326001.threeRounds"c, PrimeIsPrime(a, 3), true);
  CheckB("25326001.fourRounds"c, PrimeIsPrime(a, 4), false);

  // ── Probedivision ──────────────────────────────────────────────────────────
  BigFromDecimal("561"c, a);
  CheckI("trial.561"c, PrimeTrialDivide(a), 3);
  BigFromDecimal("2047"c, a);
  CheckI("trial.2047"c, PrimeTrialDivide(a), 23);
  BigFromDecimal("251"c, a);
  CheckI("trial.selfPrime"c, PrimeTrialDivide(a), 0);
  BigFromDecimal("65537"c, a);
  CheckI("trial.noSmallFactor"c, PrimeTrialDivide(a), 0);
  BigFromDecimal("0"c, a);
  CheckI("trial.zero"c, PrimeTrialDivide(a), 0);

  // ── Der Bitmuster-Fall ─────────────────────────────────────────────────────
  //
  // Die groesste Primzahl unter 2^64. Als int64 ist ihr Wort negativ; ein
  // vorzeichenbehafteter Vergleich im Kleinzahl-Zweig hat sie zunaechst
  // faelschlich verworfen. Der Fall bleibt als Pruefung stehen.
  CheckPrime("18446744073709551557"c, true);
  CheckPrime("18446744073709551615"c, false);   // 2^64-1, zusammengesetzt
  CheckPrime("18446744073709551629"c, true);    // erste Primzahl ueber 2^64
  CheckPrime("9223372036854775783"c, true);     // groesste unter 2^63
  CheckPrime("9223372036854775807"c, false);    // 2^63-1 = 7*73*127*337*92737*649657

  // ── Grosse Zahlen ──────────────────────────────────────────────────────────
  CheckPrime("1000000007"c, true);
  CheckPrime("1000000009"c, true);
  CheckPrime("1000000011"c, false);
  // Mersenne: 2^61-1 ist prim, 2^67-1 nicht
  CheckPrime("2305843009213693951"c, true);
  CheckPrime("147573952589676412927"c, false);
  // 128 Bit
  CheckPrime("340282366920938463463374607431768211297"c, true);
  CheckPrime("340282366920938463463374607431768211455"c, false);
  // 256 Bit: der Modul von secp256k1
  CheckPrime("115792089237316195423570985008687907853269984665640564039457584007913129639747"c, true);
  // dieselbe Zahl plus zwei ist zusammengesetzt
  CheckPrime("115792089237316195423570985008687907853269984665640564039457584007913129639749"c, false);

  // ── Vollstaendiger Abgleich gegen ein Sieb ─────────────────────────────────
  //
  // Bis 2000 wird jede Zahl geprueft, und die Wahrheit kommt aus einem Sieb des
  // Eratosthenes — einem Verfahren, das mit Miller-Rabin nichts gemein hat.
  var LIM: int64 := 2000;
  var sieve: int64 := alloc(LIM + 1);
  var i: int64 := 0;
  while (i <= LIM) {
    poke8(sieve + i, 1);
    i := i + 1;
  }
  poke8(sieve, 0);
  poke8(sieve + 1, 0);
  i := 2;
  while (i * i <= LIM) {
    if (peek8(sieve + i) == 1) {
      var j: int64 := i * i;
      while (j <= LIM) {
        poke8(sieve + j, 0);
        j := j + i;
      }
    }
    i := i + 1;
  }

  var mismatches: int64 := 0;
  var primeCount: int64 := 0;
  i := 0;
  while (i <= LIM) {
    BigSetU64(_n, i);
    var got: bool := PrimeIsPrime(_n, 13);
    var want: bool := peek8(sieve + i) == 1;
    if (got != want) { mismatches := mismatches + 1; }
    if (want) { primeCount := primeCount + 1; }
    i := i + 1;
  }
  CheckI("sieveAgreement"c, mismatches, 0);
  // 303 Primzahlen bis 2000 — wenn die Zahl nicht stimmt, war das Sieb falsch
  CheckI("sieveCount"c, primeCount, 303);
  free(sieve, LIM + 1);

  // ── Naechste Primzahl ──────────────────────────────────────────────────────
  BigSetU64(a, 1000);
  CheckB("next.ok"c, PrimeNext(a, 13, out), true);
  CheckI("next.1000"c, BigToU64(out), 1009);
  BigSetU64(a, 0);
  PrimeNext(a, 13, out);
  CheckI("next.0"c, BigToU64(out), 2);
  BigSetU64(a, 1);
  PrimeNext(a, 13, out);
  CheckI("next.1"c, BigToU64(out), 2);
  BigSetU64(a, 2);
  PrimeNext(a, 13, out);
  CheckI("next.2"c, BigToU64(out), 3);
  BigSetU64(a, 3);
  PrimeNext(a, 13, out);
  CheckI("next.3"c, BigToU64(out), 5);
  BigSetU64(a, 7);
  PrimeNext(a, 13, out);
  CheckI("next.7"c, BigToU64(out), 11);
  BigSetI64(a, 0 - 5);
  PrimeNext(a, 13, out);
  CheckI("next.negative"c, BigToU64(out), 2);

  // ueber die Wortgrenze hinweg
  BigFromDecimal("18446744073709551615"c, a);
  CheckB("next.pastU64"c, PrimeNext(a, 13, out), true);
  BigFromDecimal("18446744073709551629"c, b);
  CheckB("next.pastU64Value"c, BigEquals(out, b), true);

  // Die gefundene Zahl muss prim sein und es darf keine kleinere dazwischen
  // liegen — beides ohne fremden Sollwert nachpruefbar.
  var badNext: int64 := 0;
  var start: int64 := 100;
  while (start < 400) {
    BigSetU64(a, start);
    if (PrimeNext(a, 13, out)) {
      if (!PrimeIsPrime(out, 13)) { badNext := badNext + 1; }
      // keine Primzahl zwischen start+1 und out-1
      var v: int64 := BigToU64(out);
      var mid: int64 := start + 1;
      while (mid < v) {
        BigSetU64(b, mid);
        if (PrimeIsPrime(b, 13)) { badNext := badNext + 1; }
        mid := mid + 1;
      }
      if (v <= start) { badNext := badNext + 1; }
    }
    else { badNext := badNext + 1; }
    start := start + 1;
  }
  CheckI("nextIsTight"c, badNext, 0);

  // ── Teilerfremdheit ────────────────────────────────────────────────────────
  BigSetU64(a, 65537);
  BigSetU64(b, 3120);
  CheckB("coprime.rsaLike"c, PrimeCoprime(a, b), true);
  BigSetU64(a, 12);
  BigSetU64(b, 18);
  CheckB("coprime.no"c, PrimeCoprime(a, b), false);
  BigSetU64(a, 17);
  BigSetU64(b, 13);
  CheckB("coprime.primes"c, PrimeCoprime(a, b), true);
  BigSetU64(a, 1);
  BigSetU64(b, 999);
  CheckB("coprime.one"c, PrimeCoprime(a, b), true);

  // ── Eigene Basen ───────────────────────────────────────────────────────────
  var blist: int64 := alloc(4 * 8);
  var b1: int64 := BigNew(2);
  var b2: int64 := BigNew(2);
  var b3: int64 := BigNew(2);
  BigSetU64(b1, 2);
  BigSetU64(b2, 3);
  BigSetU64(b3, 5);
  poke64(blist, b1);
  poke64(blist + 8, b2);
  poke64(blist + 16, b3);

  BigFromDecimal("1000000007"c, a);
  CheckB("bases.prime"c, PrimeIsPrimeWithBases(a, blist, 3), true);
  BigFromDecimal("561"c, a);
  CheckB("bases.carmichael"c, PrimeIsPrimeWithBases(a, blist, 3), false);
  // nur die Basis 2 laesst 2047 durch
  BigFromDecimal("2047"c, a);
  CheckB("bases.onlyTwo"c, PrimeIsPrimeWithBases(a, blist, 1), true);
  CheckB("bases.twoAndThree"c, PrimeIsPrimeWithBases(a, blist, 2), false);
  BigFree(b1);  BigFree(b2);  BigFree(b3);
  free(blist, 4 * 8);

  // ── Montgomery gegen die Divisionsfassung ──────────────────────────────────
  //
  // Der ganze Test haengt an BigPowModOdd. Beide Wege muessen dasselbe liefern,
  // sonst ist die schnelle Fassung falsch und niemand merkt es.
  var m: int64 := BigNew(20);
  var e: int64 := BigNew(20);
  var o1: int64 := BigNew(40);
  var o2: int64 := BigNew(40);
  var badMont: int64 := 0;
  var t: int64 := 0;
  while (t < 60) {
    BigSetU64(m, 1000000007 + t * 2);
    if ((BigWord(m, 0) & 1) == 1) {
      BigSetU64(a, 123456789 + t * 7919);
      BigSetU64(e, 65537 + t);
      BigPowMod(a, e, m, o1);
      if (!BigPowModOdd(a, e, m, o2)) { badMont := badMont + 1; }
      else {
        if (!BigEquals(o1, o2)) { badMont := badMont + 1; }
      }
    }
    t := t + 1;
  }
  CheckI("montMatchesDiv"c, badMont, 0);

  // gerader Modul muss abgelehnt werden
  BigSetU64(m, 1000);
  BigSetU64(a, 7);
  BigSetU64(e, 5);
  CheckB("mont.evenRejected"c, BigPowModOdd(a, e, m, o2), false);
  // die Divisionsfassung kann es trotzdem
  CheckB("div.evenOk"c, BigPowMod(a, e, m, o1), true);
  CheckI("div.evenValue"c, BigToU64(o1), 807);

  // ── Negativkontrollen ──────────────────────────────────────────────────────
  //
  // Erstens: eine einzelne Runde muss nachweislich zu wenig sein. Waeren alle
  // Rundenzahlen gleichwertig, pruefte der Test nichts.
  BigFromDecimal("1373653"c, a);
  CheckB("negCtrl.roundsMatter"c, PrimeIsPrime(a, 2) == PrimeIsPrime(a, 3), false);

  // Zweitens: der Fermat-Test allein wuerde eine Carmichael-Zahl durchlassen.
  // a^(n-1) mod n = 1 fuer 561 zur Basis 2 — und trotzdem ist 561 = 3*11*17.
  BigFromDecimal("561"c, a);
  BigFromDecimal("560"c, e);
  BigSetU64(b, 2);
  BigPowMod(b, e, a, o1);
  CheckI("negCtrl.fermatFooled"c, BigToU64(o1), 1);
  CheckB("negCtrl.millerRabinNot"c, PrimeIsPrime(a, 13), false);

  BigFree(_n);  BigFree(a);  BigFree(b);  BigFree(out);
  BigFree(m);  BigFree(e);  BigFree(o1);  BigFree(o2);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
