// tests/pqc_wp01_test.lyx
// WP-PQC-01: Keccak-1600 / SHA-3 / SHAKE — NIST-Testvektoren (FIPS 202)
//
// Abnahmekriterien:
// AC-WP01.1: SHA3-256("")  == a7ffc6f8bf1ed766...  (NIST FIPS 202 Appendix C)
// AC-WP01.2: SHA3-256("abc") == 3a985da74fe225b2...
// AC-WP01.3: SHA3-512("")  == a69f73cca23a9ac5...
// AC-WP01.4: SHAKE128("", 32) == 7f9c2ba4e88f827d...
// AC-WP01.5: SHAKE256("", 32) == 46b9dd2b0ba88d13...

unit tests.pqc_wp01_test;

import std.crypto.keccak;
import std.alloc;

// Byteweiser Vergleich zweier Puffer gleicher Länge
fn compareBytes(got: int64, expected: int64, len: int64): int64 {
  var i: int64 := 0;
  while (i < len) {
    if (peek8(got + i) != peek8(expected + i)) { return 1; }
    i := i + 1;
  }
  return 0;
}

// ============================================================
// AC-WP01.1: SHA3-256("") — Leerstring
// ============================================================
fn testSHA3_256_empty(): int64 {
  var out: int64 := alloc(32);
  var exp: int64 := alloc(32);
  SHA3_256(0, 0, out);
  poke8(exp+0,0xa7); poke8(exp+1,0xff); poke8(exp+2,0xc6); poke8(exp+3,0xf8);
  poke8(exp+4,0xbf); poke8(exp+5,0x1e); poke8(exp+6,0xd7); poke8(exp+7,0x66);
  poke8(exp+8,0x51); poke8(exp+9,0xc1); poke8(exp+10,0x47); poke8(exp+11,0x56);
  poke8(exp+12,0xa0); poke8(exp+13,0x61); poke8(exp+14,0xd6); poke8(exp+15,0x62);
  poke8(exp+16,0xf5); poke8(exp+17,0x80); poke8(exp+18,0xff); poke8(exp+19,0x4d);
  poke8(exp+20,0xe4); poke8(exp+21,0x3b); poke8(exp+22,0x49); poke8(exp+23,0xfa);
  poke8(exp+24,0x82); poke8(exp+25,0xd8); poke8(exp+26,0x0a); poke8(exp+27,0x4b);
  poke8(exp+28,0x80); poke8(exp+29,0xf8); poke8(exp+30,0x43); poke8(exp+31,0x4a);
  var r: int64 := compareBytes(out, exp, 32);
  free(out, 32); free(exp, 32);
  if (r == 0) { PrintLn("OK: SHA3-256('') matches NIST vector (WP-01.1)"); }
  else { PrintLn("FAIL: SHA3-256('') mismatch"); }
  return r;
}

// ============================================================
// AC-WP01.2: SHA3-256("abc")
// ============================================================
fn testSHA3_256_abc(): int64 {
  var out: int64 := alloc(32);
  var exp: int64 := alloc(32);
  var msg: int64 := alloc(3);
  poke8(msg+0, 97); poke8(msg+1, 98); poke8(msg+2, 99);
  SHA3_256(msg, 3, out);
  poke8(exp+0,0x3a); poke8(exp+1,0x98); poke8(exp+2,0x5d); poke8(exp+3,0xa7);
  poke8(exp+4,0x4f); poke8(exp+5,0xe2); poke8(exp+6,0x25); poke8(exp+7,0xb2);
  poke8(exp+8,0x04); poke8(exp+9,0x5c); poke8(exp+10,0x17); poke8(exp+11,0x2d);
  poke8(exp+12,0x6b); poke8(exp+13,0xd3); poke8(exp+14,0x90); poke8(exp+15,0xbd);
  poke8(exp+16,0x85); poke8(exp+17,0x5f); poke8(exp+18,0x08); poke8(exp+19,0x6e);
  poke8(exp+20,0x3e); poke8(exp+21,0x9d); poke8(exp+22,0x52); poke8(exp+23,0x5b);
  poke8(exp+24,0x46); poke8(exp+25,0xbf); poke8(exp+26,0xe2); poke8(exp+27,0x45);
  poke8(exp+28,0x11); poke8(exp+29,0x43); poke8(exp+30,0x15); poke8(exp+31,0x32);
  var r: int64 := compareBytes(out, exp, 32);
  free(out, 32); free(exp, 32); free(msg, 3);
  if (r == 0) { PrintLn("OK: SHA3-256('abc') matches NIST vector (WP-01.2)"); }
  else { PrintLn("FAIL: SHA3-256('abc') mismatch"); }
  return r;
}

