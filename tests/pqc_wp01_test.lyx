fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testSHA3_256_empty();
  failed := failed + testSHA3_256_abc();
  failed := failed + testSHA3_512_empty();
  failed := failed + testSHAKE128_empty();
  failed := failed + testSHAKE256_empty();
  if (failed != 0) { PrintLn("FAILED"); return 1; }
  PrintLn("ALL PASSED");
  return 0;
}
