// tests/static_method_codegen_test.lyx — Codegen für `TypeName.Method(args)`.
//
// Der Callee `TypeName_Method` hat IMMER ein implizites self als ersten
// Parameter. Der statische Aufruf ließ den self-Slot weg, wodurch alle
// Argumente um ein Register nach vorn rutschten: self bekam den ersten echten
// Wert, der erste Parameter Müll. `SB.Create(41)` lieferte 169 statt 42, und in
// std.string reichte es für einen SIGSEGV.
//
// Jetzt wird für den statischen Aufruf self = 0 übergeben. Dass die Methode self
// nicht anfassen darf, prüft sema separat (tests/static_method_call_test.sh).
//
// Hinweis: Aufrufe werden hier an Variablen gebunden statt direkt in expect()
// verschachtelt — ein 7-Argument-Aufruf innerhalb einer fremden Argumentliste
// ist ein eigener, vorbestehender Codegen-Bug (siehe Issue zum Thema
// „nested call with 7 arguments").

import std.io;

var fails: int64 := 0;

fn expect(name: pchar, got: int64, want: int64) {
  Print(name); Print(": ");
  if (got == want) {
    PrintLn("OK");
  } else {
    Print("FAIL got="); PrintInt(got); Print(" want="); PrintInt(want); PrintLn("");
    fails += 1;
  }
}

pub type F = class {
  a: int64;
  b: int64;

  // self-frei → statischer Aufruf erlaubt
  pub fn Zero(): int64 { return 7; }
  pub fn One(x: int64): int64 { return x + 1; }
  pub fn Two(x: int64, y: int64): int64 { return x * 10 + y; }
  pub fn Five(a1: int64, a2: int64, a3: int64, a4: int64, a5: int64): int64 {
    return a1 + a2 * 2 + a3 * 3 + a4 * 4 + a5 * 5;
  }
  pub fn Seven(a1: int64, a2: int64, a3: int64, a4: int64, a5: int64, a6: int64, a7: int64): int64 {
    return a1 + a7 * 100;
  }

  // benutzt self → nur über eine Instanz
  pub fn Sum(): int64 { return self.a + self.b; }
};

fn main(): int64 {
  // --- statische Aufrufe: Argumente müssen unverschoben ankommen ---
  var s0: int64 := F.Zero();
  expect("static 0 args", s0, 7);

  var s1: int64 := F.One(41);
  expect("static 1 arg", s1, 42);

  var s2: int64 := F.Two(4, 2);
  expect("static 2 args", s2, 42);

  // 5 Argumente + self = 6 Slots: letzter Fall, der noch komplett in Register passt
  var s5: int64 := F.Five(1, 2, 3, 4, 5);
  expect("static 5 args", s5, 55);

  // 7 Argumente + self = 8 Slots: Stack-Spill-Pfad
  var s7: int64 := F.Seven(5, 0, 0, 0, 0, 0, 3);
  expect("static 7 args (spill)", s7, 305);

  // --- Instanz-Aufrufe bleiben unverändert ---
  var o: F := new F();
  o.a := 30;
  o.b := 12;

  var i0: int64 := o.Sum();
  expect("instance uses self", i0, 42);

  var i2: int64 := o.Two(4, 2);
  expect("instance 2 args", i2, 42);

  var i5: int64 := o.Five(1, 2, 3, 4, 5);
  expect("instance 5 args", i5, 55);

  var i7: int64 := o.Seven(5, 0, 0, 0, 0, 0, 3);
  expect("instance 7 args (spill)", i7, 305);

  // self bleibt nach einem statischen Aufruf intakt
  var i0b: int64 := o.Sum();
  expect("instance after static", i0b, 42);

  if (fails == 0) { PrintLn("ALL OK"); return 0; }
  PrintLn("FAILURES");
  return 1;
}
