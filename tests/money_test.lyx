// tests/money_test.lyx
// Selbstpruefende Testbatterie fuer std.money.
//
// Sollwerte aus Pythons decimal-Modul (ROUND_HALF_UP, ROUND_HALF_EVEN, ...) —
// derselben Referenz, an der sich auch Java BigDecimal und der ISO-Standard
// orientieren. Die vollstaendige Rundungstabelle steht unten als Zahlenwerk im
// Test, nicht als Behauptung im Kommentar.
//
// Dazu strukturelle Aussagen, die ohne fremde Zahl gelten:
//
//   * Aufteilen verliert nichts: die Summe der Anteile ist GENAU der
//     Ausgangsbetrag — bei jeder Personenzahl, jedem Gewicht, jedem Vorzeichen
//   * netto + steuer = brutto, in beide Richtungen gerechnet
//   * Einlesen und Ausgeben sind zueinander invers
//   * ungueltige Betraege pflanzen sich durch jede Operation fort
//
// Und eine Gegenprobe in Gleitkomma, die zeigt, warum es die Unit gibt.

unit main;

import std.money;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr("\n"c);
  }
}

fn CheckStr(name: pchar, buf: int64, want: pchar): void {
  _checks := _checks + 1;
  var i: int64 := 0;
  var ok: bool := true;
  var run: bool := true;
  while (run) {
    var a: int64 := peek8(buf + i);
    var b: int64 := peek8(want + i);
    if (a != b) { ok := false; run := false; }
    else {
      if (a == 0) { run := false; }
    }
    i := i + 1;
  }
  if (!ok) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got=\""c);
    PrintStr(buf);
    PrintStr("\" want=\""c);
    PrintStr(want);
    PrintStr("\"\n"c);
  }
}

var _s: int64 := 88172645463325252;

fn Rnd(m: int64): int64 {
  _s := (_s * 6364136223846793005 + 1442695040888963407) & 4611686018427387903;
  return (_s / 65536) % m;
}

fn main(): int64 {
  var buf: int64 := alloc(64);

  // ── Die Gegenprobe: warum nicht f64 ────────────────────────────────────────
  //
  // In Gleitkomma ist 0,10 + 0,20 nicht 0,30. In Cent gerechnet stimmt es.
  var f1: f64 := 0.1;
  var f2: f64 := 0.2;
  var f3: f64 := 0.3;
  var fsum: f64 := f1 + f2;
  CheckB("f64IsWrong"c, fsum == f3, false);
  CheckI("moneyIsRight"c, MoneyAdd(10, 20), 30);

  // Hundert mal ein Cent: in f64 nicht genau 1,00 — in Cent schon.
  var acc: f64 := 0.0;
  var cents: int64 := 0;
  var i: int64 := 0;
  while (i < 100) {
    var one: f64 := 0.01;
    acc := acc + one;
    cents := MoneyAdd(cents, 1);
    i := i + 1;
  }
  var oneEuro: f64 := 1.0;
  CheckB("f64SumDrifts"c, acc == oneEuro, false);
  CheckI("moneySumExact"c, cents, 100);

  // ── Zehnerpotenzen ─────────────────────────────────────────────────────────
  CheckI("pow10.0"c, MoneyPow10(0), 1);
  CheckI("pow10.2"c, MoneyPow10(2), 100);
  CheckI("pow10.18"c, MoneyPow10(18), 1000000000000000000);
  CheckI("pow10.19"c, MoneyPow10(19), MONEY_INVALID);
  CheckI("pow10.neg"c, MoneyPow10(0 - 1), MONEY_INVALID);

  // ── Die vollstaendige Rundungstabelle ──────────────────────────────────────
  //
  // Sollwerte aus Python decimal. Geteilt wird jeweils durch 10, der Zaehler
  // ist also der Wert mal zehn: 25/10 = 2,5.
  //
  //  Wert  HALF_UP  HALF_EVEN  HALF_DOWN   UP  DOWN  FLOOR  CEIL
  //   2,5     3         2          2        3    2     2      3
  //  -2,5    -3        -2         -2       -3   -2    -3     -2
  //   2,4     2         2          2        3    2     2      3
  //  -2,4    -2        -2         -2       -3   -2    -3     -2
  //   3,5     4         4          3        4    3     3      4
  //  -3,5    -4        -4         -3       -4   -3    -4     -3
  //   0,5     1         0          0        1    0     0      1
  //  -0,5    -1         0          0       -1    0    -1      0
  CheckI("r.2.5.halfUp"c,   MoneyDivRound(25, 10, MONEY_HALF_UP), 3);
  CheckI("r.2.5.halfEven"c, MoneyDivRound(25, 10, MONEY_HALF_EVEN), 2);
  CheckI("r.2.5.halfDown"c, MoneyDivRound(25, 10, MONEY_HALF_DOWN), 2);
  CheckI("r.2.5.up"c,       MoneyDivRound(25, 10, MONEY_UP), 3);
  CheckI("r.2.5.down"c,     MoneyDivRound(25, 10, MONEY_DOWN), 2);
  CheckI("r.2.5.floor"c,    MoneyDivRound(25, 10, MONEY_FLOOR), 2);
  CheckI("r.2.5.ceil"c,     MoneyDivRound(25, 10, MONEY_CEIL), 3);

  CheckI("r.-2.5.halfUp"c,   MoneyDivRound(0 - 25, 10, MONEY_HALF_UP), 0 - 3);
  CheckI("r.-2.5.halfEven"c, MoneyDivRound(0 - 25, 10, MONEY_HALF_EVEN), 0 - 2);
  CheckI("r.-2.5.halfDown"c, MoneyDivRound(0 - 25, 10, MONEY_HALF_DOWN), 0 - 2);
  CheckI("r.-2.5.up"c,       MoneyDivRound(0 - 25, 10, MONEY_UP), 0 - 3);
  CheckI("r.-2.5.down"c,     MoneyDivRound(0 - 25, 10, MONEY_DOWN), 0 - 2);
  CheckI("r.-2.5.floor"c,    MoneyDivRound(0 - 25, 10, MONEY_FLOOR), 0 - 3);
  CheckI("r.-2.5.ceil"c,     MoneyDivRound(0 - 25, 10, MONEY_CEIL), 0 - 2);

  CheckI("r.2.4.halfUp"c,   MoneyDivRound(24, 10, MONEY_HALF_UP), 2);
  CheckI("r.2.4.up"c,       MoneyDivRound(24, 10, MONEY_UP), 3);
  CheckI("r.2.4.floor"c,    MoneyDivRound(24, 10, MONEY_FLOOR), 2);
  CheckI("r.2.4.ceil"c,     MoneyDivRound(24, 10, MONEY_CEIL), 3);
  CheckI("r.-2.4.up"c,      MoneyDivRound(0 - 24, 10, MONEY_UP), 0 - 3);
  CheckI("r.-2.4.floor"c,   MoneyDivRound(0 - 24, 10, MONEY_FLOOR), 0 - 3);
  CheckI("r.-2.4.ceil"c,    MoneyDivRound(0 - 24, 10, MONEY_CEIL), 0 - 2);

  // 3,5 zeigt den Unterschied der Bankenrundung: hier AUF, weil 4 gerade ist
  CheckI("r.3.5.halfEven"c, MoneyDivRound(35, 10, MONEY_HALF_EVEN), 4);
  CheckI("r.3.5.halfDown"c, MoneyDivRound(35, 10, MONEY_HALF_DOWN), 3);
  CheckI("r.-3.5.halfEven"c, MoneyDivRound(0 - 35, 10, MONEY_HALF_EVEN), 0 - 4);

  CheckI("r.0.5.halfUp"c,   MoneyDivRound(5, 10, MONEY_HALF_UP), 1);
  CheckI("r.0.5.halfEven"c, MoneyDivRound(5, 10, MONEY_HALF_EVEN), 0);
  CheckI("r.-0.5.halfUp"c,  MoneyDivRound(0 - 5, 10, MONEY_HALF_UP), 0 - 1);
  CheckI("r.-0.5.halfEven"c, MoneyDivRound(0 - 5, 10, MONEY_HALF_EVEN), 0);
  CheckI("r.-0.5.ceil"c,    MoneyDivRound(0 - 5, 10, MONEY_CEIL), 0);

  // Bankenrundung ueber eine ganze Reihe: 0,5 / 1,5 / 2,5 / 3,5 / 4,5
  CheckI("even.0.5"c, MoneyDivRound(5, 10, MONEY_HALF_EVEN), 0);
  CheckI("even.1.5"c, MoneyDivRound(15, 10, MONEY_HALF_EVEN), 2);
  CheckI("even.2.5"c, MoneyDivRound(25, 10, MONEY_HALF_EVEN), 2);
  CheckI("even.3.5"c, MoneyDivRound(35, 10, MONEY_HALF_EVEN), 4);
  CheckI("even.4.5"c, MoneyDivRound(45, 10, MONEY_HALF_EVEN), 4);
  // Genau das ist der Grund fuer die Bankenrundung: die Summe der gerundeten
  // Werte weicht weniger ab als bei HALF_UP.
  var sumEven: int64 := 0;
  var sumUp: int64 := 0;
  var t: int64 := 0;
  while (t < 10) {
    var num: int64 := t * 10 + 5;
    sumEven := sumEven + MoneyDivRound(num, 10, MONEY_HALF_EVEN);
    sumUp := sumUp + MoneyDivRound(num, 10, MONEY_HALF_UP);
    t := t + 1;
  }
  // exakte Summe der Werte 0,5 ... 9,5 ist 50
  CheckI("halfEvenUnbiased"c, sumEven, 50);
  CheckI("halfUpBiased"c, sumUp, 55);

  CheckI("divByZero"c, MoneyDivRound(100, 0, MONEY_HALF_UP), MONEY_INVALID);
  CheckI("divNegDen"c, MoneyDivRound(100, 0 - 4, MONEY_HALF_UP), 0 - 25);
  CheckI("divExact"c, MoneyDivRound(100, 4, MONEY_HALF_UP), 25);
  CheckI("divBadMode"c, MoneyDivRound(7, 2, 99), MONEY_INVALID);

  // ── Grundrechenarten und Ueberlauf ─────────────────────────────────────────
  CheckI("add"c, MoneyAdd(1050, 275), 1325);
  CheckI("sub"c, MoneySub(1050, 275), 775);
  CheckI("subNeg"c, MoneySub(275, 1050), 0 - 775);
  CheckI("neg"c, MoneyNeg(1050), 0 - 1050);
  CheckI("abs"c, MoneyAbs(0 - 1050), 1050);
  CheckI("mulInt"c, MoneyMulInt(1050, 3), 3150);
  CheckI("divInt"c, MoneyDivInt(1000, 3, MONEY_HALF_UP), 333);
  CheckI("divIntUp"c, MoneyDivInt(1000, 3, MONEY_CEIL), 334);

  var MAX: int64 := 9223372036854775807;
  CheckI("addOverflow"c, MoneyAdd(MAX, 1), MONEY_INVALID);
  CheckI("subOverflow"c, MoneySub(0 - MAX, 2), MONEY_INVALID);
  CheckI("mulOverflow"c, MoneyMulInt(MAX, 2), MONEY_INVALID);

  // Fortpflanzung: einmal ungueltig, immer ungueltig
  var bad: int64 := MoneyAdd(MAX, 1);
  CheckB("invalidDetected"c, MoneyIsValid(bad), false);
  CheckI("propAdd"c, MoneyAdd(bad, 5), MONEY_INVALID);
  CheckI("propSub"c, MoneySub(5, bad), MONEY_INVALID);
  CheckI("propMul"c, MoneyMulInt(bad, 2), MONEY_INVALID);
  CheckI("propNeg"c, MoneyNeg(bad), MONEY_INVALID);
  CheckI("propAbs"c, MoneyAbs(bad), MONEY_INVALID);
  CheckI("propRate"c, MoneyMulRate(bad, 19, 2, MONEY_HALF_UP), MONEY_INVALID);
  CheckI("propRescale"c, MoneyRescale(bad, 2, 4, MONEY_HALF_UP), MONEY_INVALID);
  CheckI("propFormat"c, MoneyFormat(bad, 2, buf, 64, MONEY_FMT_DE), 0 - 1);
  CheckB("validOk"c, MoneyIsValid(1050), true);

  CheckI("sign+"c, MoneySign(5), 1);
  CheckI("sign-"c, MoneySign(0 - 5), 0 - 1);
  CheckI("sign0"c, MoneySign(0), 0);
  CheckI("cmpLt"c, MoneyCmp(1, 2), 0 - 1);
  CheckI("cmpGt"c, MoneyCmp(2, 1), 1);
  CheckI("cmpEq"c, MoneyCmp(2, 2), 0);
  CheckI("min"c, MoneyMin(1050, 275), 275);
  CheckI("max"c, MoneyMax(1050, 275), 1050);

  // Summe eines Feldes
  var arr: int64 := alloc(5 * 8);
  poke64(arr, 1999);  poke64(arr + 8, 500);  poke64(arr + 16, 1);
  poke64(arr + 24, 0 - 1000);  poke64(arr + 32, 0);
  CheckI("sum"c, MoneySum(arr, 5), 1500);
  CheckI("sumEmpty"c, MoneySum(arr, 0), 0);
  poke64(arr + 16, MONEY_INVALID);
  CheckI("sumWithInvalid"c, MoneySum(arr, 5), MONEY_INVALID);
  poke64(arr + 16, 1);

  // ── Skala aendern ──────────────────────────────────────────────────────────
  CheckI("rescaleUp"c, MoneyRescale(1050, 2, 4, MONEY_HALF_UP), 105000);
  CheckI("rescaleSame"c, MoneyRescale(1050, 2, 2, MONEY_HALF_UP), 1050);
  CheckI("rescaleDown"c, MoneyRescale(105050, 4, 2, MONEY_HALF_UP), 1051);
  CheckI("rescaleDownEven"c, MoneyRescale(105050, 4, 2, MONEY_HALF_EVEN), 1050);
  CheckI("rescaleDownNeg"c, MoneyRescale(0 - 105050, 4, 2, MONEY_HALF_UP), 0 - 1051);
  CheckI("rescaleToZero"c, MoneyRescale(1250, 2, 0, MONEY_HALF_UP), 13);
  CheckI("rescaleBadScale"c, MoneyRescale(1050, 0 - 1, 2, MONEY_HALF_UP), MONEY_INVALID);

  // Auf zwei Stellen runden, aber vierstellig bleiben
  CheckI("roundTo"c, MoneyRoundTo(123456, 4, 2, MONEY_HALF_UP), 123500);
  CheckI("roundToNoop"c, MoneyRoundTo(123456, 4, 4, MONEY_HALF_UP), 123456);
  CheckI("roundToCoarser"c, MoneyRoundTo(123456, 4, 6, MONEY_HALF_UP), 123456);

  // Schweizer Bargeldrundung auf 5 Rappen
  CheckI("cash.1"c, MoneyRoundToMultiple(101, 5, MONEY_HALF_UP), 100);
  CheckI("cash.2"c, MoneyRoundToMultiple(102, 5, MONEY_HALF_UP), 100);
  CheckI("cash.3"c, MoneyRoundToMultiple(103, 5, MONEY_HALF_UP), 105);
  CheckI("cash.4"c, MoneyRoundToMultiple(107, 5, MONEY_HALF_UP), 105);
  CheckI("cash.5"c, MoneyRoundToMultiple(108, 5, MONEY_HALF_UP), 110);
  CheckI("cash.neg"c, MoneyRoundToMultiple(0 - 103, 5, MONEY_HALF_UP), 0 - 105);
  CheckI("cash.exact"c, MoneyRoundToMultiple(105, 5, MONEY_HALF_UP), 105);
  CheckI("cash.badMult"c, MoneyRoundToMultiple(103, 0, MONEY_HALF_UP), MONEY_INVALID);

  // ── Saetze, Prozente, Steuer ───────────────────────────────────────────────
  CheckI("rate19"c, MoneyMulRate(10000, 19, 2, MONEY_HALF_UP), 1900);
  CheckI("rate7"c, MoneyMulRate(10000, 7, 2, MONEY_HALF_UP), 700);
  CheckI("rate19.95"c, MoneyMulRate(10000, 1995, 4, MONEY_HALF_UP), 1995);
  CheckI("rateRounds"c, MoneyMulRate(1999, 19, 2, MONEY_HALF_UP), 380);
  CheckI("rateRoundsDown"c, MoneyMulRate(1999, 19, 2, MONEY_DOWN), 379);
  CheckI("pct19"c, MoneyPercent(10000, 19, 0, MONEY_HALF_UP), 1900);
  CheckI("pct7.5"c, MoneyPercent(10000, 75, 1, MONEY_HALF_UP), 750);

  CheckI("addTax"c, MoneyAddTax(10000, 19, 2, MONEY_HALF_UP), 11900);
  // Der Klassiker: die Steuer IM Bruttobetrag ist nicht 19 Prozent davon.
  CheckI("taxOfGross"c, MoneyTaxOfGross(11900, 19, 2, MONEY_HALF_UP), 1900);
  CheckI("netOfGross"c, MoneyNetOfGross(11900, 19, 2, MONEY_HALF_UP), 10000);
  // Wer stattdessen 19 Prozent vom Brutto nimmt, liegt um 361 Cent daneben —
  // hier festgehalten, damit der Unterschied belegt ist.
  CheckI("naiveTaxIsWrong"c, MoneyMulRate(11900, 19, 2, MONEY_HALF_UP), 2261);

  // netto + steuer = brutto, ueber viele Betraege und beide Steuersaetze
  var badTax: int64 := 0;
  var g: int64 := 1;
  while (g < 3000) {
    var gross: int64 := g * 7;
    var tax19: int64 := MoneyTaxOfGross(gross, 19, 2, MONEY_HALF_UP);
    var net19: int64 := MoneyNetOfGross(gross, 19, 2, MONEY_HALF_UP);
    if (MoneyAdd(net19, tax19) != gross) { badTax := badTax + 1; }
    var tax7: int64 := MoneyTaxOfGross(gross, 7, 2, MONEY_HALF_UP);
    var net7: int64 := MoneyNetOfGross(gross, 7, 2, MONEY_HALF_UP);
    if (MoneyAdd(net7, tax7) != gross) { badTax := badTax + 1; }
    g := g + 1;
  }
  CheckI("taxSplitsExactly"c, badTax, 0);

  // ── Aufteilen ohne verlorene Cents ─────────────────────────────────────────
  var parts: int64 := alloc(16 * 8);

  CheckB("split3ok"c, MoneySplit(10000, 3, parts), true);
  CheckI("split3.0"c, peek64(parts), 3334);
  CheckI("split3.1"c, peek64(parts + 8), 3333);
  CheckI("split3.2"c, peek64(parts + 16), 3333);
  CheckI("split3.sum"c, MoneySum(parts, 3), 10000);

  CheckB("split7ok"c, MoneySplit(10000, 7, parts), true);
  CheckI("split7.sum"c, MoneySum(parts, 7), 10000);
  CheckI("split7.0"c, peek64(parts), 1429);
  CheckI("split7.6"c, peek64(parts + 48), 1428);

  CheckB("splitNegOk"c, MoneySplit(0 - 10000, 3, parts), true);
  CheckI("splitNeg.sum"c, MoneySum(parts, 3), 0 - 10000);
  CheckI("splitNeg.0"c, peek64(parts), 0 - 3334);

  CheckB("split1"c, MoneySplit(777, 1, parts), true);
  CheckI("split1.val"c, peek64(parts), 777);
  CheckB("splitZeroParts"c, MoneySplit(100, 0, parts), false);
  CheckB("splitNegParts"c, MoneySplit(100, 0 - 2, parts), false);
  CheckB("splitInvalid"c, MoneySplit(MONEY_INVALID, 3, parts), false);
  CheckB("splitZeroAmount"c, MoneySplit(0, 4, parts), true);
  CheckI("splitZero.sum"c, MoneySum(parts, 4), 0);

  // Aufteilen ist fuer JEDE Kombination verlustfrei
  var badSplit: int64 := 0;
  var amt: int64 := 0;
  while (amt < 200) {
    var p2: int64 := 1;
    while (p2 <= 16) {
      MoneySplit(amt, p2, parts);
      if (MoneySum(parts, p2) != amt) { badSplit := badSplit + 1; }
      MoneySplit(0 - amt, p2, parts);
      if (MoneySum(parts, p2) != 0 - amt) { badSplit := badSplit + 1; }
      p2 := p2 + 1;
    }
    amt := amt + 1;
  }
  CheckI("splitNeverLoses"c, badSplit, 0);

  // ── Aufteilen nach Gewichten ───────────────────────────────────────────────
  var w: int64 := alloc(8 * 8);
  poke64(w, 1);  poke64(w + 8, 1);  poke64(w + 16, 1);
  CheckB("alloc3ok"c, MoneyAllocate(10000, w, 3, parts), true);
  CheckI("alloc3.sum"c, MoneySum(parts, 3), 10000);
  CheckI("alloc3.0"c, peek64(parts), 3334);
  // Die Gewichte duerfen nicht veraendert worden sein
  CheckI("allocKeepsWeights0"c, peek64(w), 1);
  CheckI("allocKeepsWeights1"c, peek64(w + 8), 1);
  CheckI("allocKeepsWeights2"c, peek64(w + 16), 1);

  // Ungleiche Gewichte: 100,00 im Verhaeltnis 1:2:7
  poke64(w, 1);  poke64(w + 8, 2);  poke64(w + 16, 7);
  CheckB("allocWok"c, MoneyAllocate(10000, w, 3, parts), true);
  CheckI("allocW.0"c, peek64(parts), 1000);
  CheckI("allocW.1"c, peek64(parts + 8), 2000);
  CheckI("allocW.2"c, peek64(parts + 16), 7000);
  CheckI("allocW.sum"c, MoneySum(parts, 3), 10000);

  // Der Fall mit Rest: 10 Cent im Verhaeltnis 3:1:1
  poke64(w, 3);  poke64(w + 8, 1);  poke64(w + 16, 1);
  CheckB("allocRestOk"c, MoneyAllocate(10, w, 3, parts), true);
  CheckI("allocRest.sum"c, MoneySum(parts, 3), 10);
  CheckI("allocRest.0"c, peek64(parts), 6);
  CheckI("allocRest.1"c, peek64(parts + 8), 2);
  CheckI("allocRest.2"c, peek64(parts + 16), 2);

  // Ein Gewicht null bekommt nichts
  poke64(w, 1);  poke64(w + 8, 0);  poke64(w + 16, 1);
  MoneyAllocate(10000, w, 3, parts);
  CheckI("allocZeroWeight"c, peek64(parts + 8), 0);
  CheckI("allocZeroW.sum"c, MoneySum(parts, 3), 10000);

  poke64(w, 1);  poke64(w + 8, 1);
  CheckB("allocNegTotal"c, MoneyAllocate(0 - 10000, w, 2, parts), true);
  CheckI("allocNeg.sum"c, MoneySum(parts, 2), 0 - 10000);
  poke64(w, 0);  poke64(w + 8, 0);
  CheckB("allocZeroSum"c, MoneyAllocate(100, w, 2, parts), false);
  poke64(w, 0 - 1);  poke64(w + 8, 1);
  CheckB("allocNegWeight"c, MoneyAllocate(100, w, 2, parts), false);
  poke64(w, 1);  poke64(w + 8, 1);
  CheckB("allocZeroN"c, MoneyAllocate(100, w, 0, parts), false);
  CheckB("allocInvalid"c, MoneyAllocate(MONEY_INVALID, w, 2, parts), false);

  // Auch die Gewichtsverteilung verliert nie einen Cent
  var badAlloc: int64 := 0;
  var trial: int64 := 0;
  while (trial < 400) {
    var n: int64 := 1 + Rnd(8);
    var k: int64 := 0;
    var anyW: int64 := 0;
    while (k < n) {
      var wv: int64 := Rnd(20);
      poke64(w + k * 8, wv);
      anyW := anyW + wv;
      k := k + 1;
    }
    if (anyW == 0) {
      poke64(w, 1);
      anyW := 1;
    }
    var total: int64 := Rnd(100000) - 30000;
    if (MoneyAllocate(total, w, n, parts)) {
      if (MoneySum(parts, n) != total) { badAlloc := badAlloc + 1; }
      // Gewichte unveraendert?
      k := 0;
      while (k < n) {
        if (peek64(w + k * 8) < 0) { badAlloc := badAlloc + 1; }
        k := k + 1;
      }
    }
    else { badAlloc := badAlloc + 1; }
    trial := trial + 1;
  }
  CheckI("allocNeverLoses"c, badAlloc, 0);

  // ── Ausgeben ───────────────────────────────────────────────────────────────
  MoneyFormat(1325, 2, buf, 64, MONEY_FMT_PLAIN);
  CheckStr("fmt.plain"c, buf, "13.25"c);
  MoneyFormat(1325, 2, buf, 64, MONEY_FMT_DE);
  CheckStr("fmt.de"c, buf, "13,25"c);
  MoneyFormat(123456789, 2, buf, 64, MONEY_FMT_DE);
  CheckStr("fmt.de.groups"c, buf, "1.234.567,89"c);
  MoneyFormat(123456789, 2, buf, 64, MONEY_FMT_EN);
  CheckStr("fmt.en.groups"c, buf, "1,234,567.89"c);
  MoneyFormat(123456789, 2, buf, 64, MONEY_FMT_CH);
  CheckStr("fmt.ch.groups"c, buf, "1'234'567.89"c);
  MoneyFormat(123456789, 2, buf, 64, MONEY_FMT_PLAIN);
  CheckStr("fmt.plain.nogroups"c, buf, "1234567.89"c);

  // Fuehrende Null und kleine Betraege
  MoneyFormat(5, 2, buf, 64, MONEY_FMT_DE);
  CheckStr("fmt.005"c, buf, "0,05"c);
  MoneyFormat(50, 2, buf, 64, MONEY_FMT_DE);
  CheckStr("fmt.050"c, buf, "0,50"c);
  MoneyFormat(0, 2, buf, 64, MONEY_FMT_DE);
  CheckStr("fmt.zero"c, buf, "0,00"c);
  MoneyFormat(0 - 5, 2, buf, 64, MONEY_FMT_DE);
  CheckStr("fmt.negSmall"c, buf, "-0,05"c);
  MoneyFormat(0 - 123456789, 2, buf, 64, MONEY_FMT_DE);
  CheckStr("fmt.negBig"c, buf, "-1.234.567,89"c);

  // Andere Skalen
  MoneyFormat(1234, 0, buf, 64, MONEY_FMT_DE);
  CheckStr("fmt.scale0"c, buf, "1.234"c);
  MoneyFormat(1050, 3, buf, 64, MONEY_FMT_PLAIN);
  CheckStr("fmt.scale3"c, buf, "1.050"c);
  MoneyFormat(1, 4, buf, 64, MONEY_FMT_PLAIN);
  CheckStr("fmt.scale4"c, buf, "0.0001"c);

  // Gruppengrenzen: genau drei und genau vier Stellen
  MoneyFormat(99999, 2, buf, 64, MONEY_FMT_DE);
  CheckStr("fmt.999.99"c, buf, "999,99"c);
  MoneyFormat(100000, 2, buf, 64, MONEY_FMT_DE);
  CheckStr("fmt.1000.00"c, buf, "1.000,00"c);

  CheckI("fmt.retLen"c, MoneyFormat(1325, 2, buf, 64, MONEY_FMT_DE), 5);
  CheckI("fmt.tooSmall"c, MoneyFormat(123456789, 2, buf, 5, MONEY_FMT_DE), 0 - 1);
  CheckI("fmt.badScale"c, MoneyFormat(1325, 0 - 1, buf, 64, MONEY_FMT_DE), 0 - 1);

  // ── Einlesen ───────────────────────────────────────────────────────────────
  CheckI("parse.plain"c, MoneyParse("13.25"c, 2, MONEY_HALF_UP), 1325);
  CheckI("parse.de"c, MoneyParse("13,25"c, 2, MONEY_HALF_UP), 1325);
  CheckI("parse.deGroups"c, MoneyParse("1.234.567,89"c, 2, MONEY_HALF_UP), 123456789);
  CheckI("parse.enGroups"c, MoneyParse("1,234,567.89"c, 2, MONEY_HALF_UP), 123456789);
  CheckI("parse.chGroups"c, MoneyParse("1'234'567.89"c, 2, MONEY_HALF_UP), 123456789);
  CheckI("parse.noDecimals"c, MoneyParse("42"c, 2, MONEY_HALF_UP), 4200);
  CheckI("parse.oneDecimal"c, MoneyParse("42.5"c, 2, MONEY_HALF_UP), 4250);
  CheckI("parse.neg"c, MoneyParse("-13.25"c, 2, MONEY_HALF_UP), 0 - 1325);
  CheckI("parse.plus"c, MoneyParse("+13.25"c, 2, MONEY_HALF_UP), 1325);
  CheckI("parse.zero"c, MoneyParse("0.00"c, 2, MONEY_HALF_UP), 0);
  CheckI("parse.leadingDot"c, MoneyParse("0.05"c, 2, MONEY_HALF_UP), 5);
  CheckI("parse.spaces"c, MoneyParse("1 234,56"c, 2, MONEY_HALF_UP), 123456);
  CheckI("parse.scale0"c, MoneyParse("1234"c, 0, MONEY_HALF_UP), 1234);
  CheckI("parse.scale3"c, MoneyParse("1.050"c, 3, MONEY_HALF_UP), 1050);

  // ── Mehrdeutigkeit: genau drei Ziffern hinter einem einzelnen Trenner ──────
  //
  // "1.005" ist eintausendfuenf ODER eins Komma null null fuenf. Entschieden
  // wird nach der Zielskala. Beide Lesarten hier festgehalten, damit die Regel
  // nachpruefbar ist und nicht bloss im Kommentar steht.
  CheckI("parse.ambig.scale2"c, MoneyParse("1.005"c, 2, MONEY_HALF_UP), 100500);
  CheckI("parse.ambig.scale3"c, MoneyParse("1.005"c, 3, MONEY_HALF_UP), 1005);
  // Vier Ziffern danach sind eindeutig dezimal
  CheckI("parse.fourDigits"c, MoneyParse("1.0050"c, 2, MONEY_HALF_UP), 101);
  // Zwei Trenner derselben Art sind eindeutig Gruppen
  CheckI("parse.twoSameSep"c, MoneyParse("1.234.567"c, 2, MONEY_HALF_UP), 123456700);
  // Beide Zeichenarten: das letzte gewinnt
  CheckI("parse.bothSeps"c, MoneyParse("1.234,5"c, 2, MONEY_HALF_UP), 123450);
  CheckI("parse.bothSepsRev"c, MoneyParse("1,234.5"c, 2, MONEY_HALF_UP), 123450);

  // Zu viele Nachkommastellen: es wird gerundet, nach der gewaehlten Art
  CheckI("parse.roundUp"c, MoneyParse("1.0050"c, 2, MONEY_HALF_UP), 101);
  CheckI("parse.roundEven"c, MoneyParse("1.0050"c, 2, MONEY_HALF_EVEN), 100);
  CheckI("parse.roundEven2"c, MoneyParse("1.0150"c, 2, MONEY_HALF_EVEN), 102);
  CheckI("parse.roundDown"c, MoneyParse("1.9999"c, 2, MONEY_DOWN), 199);
  CheckI("parse.roundCeil"c, MoneyParse("1.0010"c, 2, MONEY_CEIL), 101);
  CheckI("parse.roundFloorNeg"c, MoneyParse("-1.0010"c, 2, MONEY_FLOOR), 0 - 101);
  CheckI("parse.roundHalfMore"c, MoneyParse("1.00510"c, 2, MONEY_HALF_EVEN), 101);
  CheckI("parse.roundHalfUpNeg"c, MoneyParse("-1.0050"c, 2, MONEY_HALF_UP), 0 - 101);

  // Ungueltiges
  CheckI("parse.empty"c, MoneyParse(""c, 2, MONEY_HALF_UP), MONEY_INVALID);
  CheckI("parse.letters"c, MoneyParse("12a4"c, 2, MONEY_HALF_UP), MONEY_INVALID);
  CheckI("parse.onlySign"c, MoneyParse("-"c, 2, MONEY_HALF_UP), MONEY_INVALID);
  CheckI("parse.signInside"c, MoneyParse("12-4"c, 2, MONEY_HALF_UP), MONEY_INVALID);
  CheckI("parse.null"c, MoneyParse(0 as pchar, 2, MONEY_HALF_UP), MONEY_INVALID);
  CheckI("parse.badScale"c, MoneyParse("1.00"c, 0 - 1, MONEY_HALF_UP), MONEY_INVALID);

  // Einlesen und Ausgeben sind zueinander invers
  var badRound: int64 := 0;
  var v2: int64 := 0 - 500000;
  while (v2 < 500000) {
    MoneyFormat(v2, 2, buf, 64, MONEY_FMT_PLAIN);
    if (MoneyParse(buf as pchar, 2, MONEY_HALF_UP) != v2) { badRound := badRound + 1; }
    MoneyFormat(v2, 2, buf, 64, MONEY_FMT_DE);
    if (MoneyParse(buf as pchar, 2, MONEY_HALF_UP) != v2) { badRound := badRound + 1; }
    MoneyFormat(v2, 2, buf, 64, MONEY_FMT_EN);
    if (MoneyParse(buf as pchar, 2, MONEY_HALF_UP) != v2) { badRound := badRound + 1; }
    v2 := v2 + 4999;
  }
  CheckI("formatParseRoundTrip"c, badRound, 0);

  // ── Waehrungen ─────────────────────────────────────────────────────────────
  CheckI("cur.EUR"c, MoneyCurrencyScale("EUR"c), 2);
  CheckI("cur.USD"c, MoneyCurrencyScale("USD"c), 2);
  CheckI("cur.JPY"c, MoneyCurrencyScale("JPY"c), 0);
  CheckI("cur.KRW"c, MoneyCurrencyScale("KRW"c), 0);
  CheckI("cur.ISK"c, MoneyCurrencyScale("ISK"c), 0);
  CheckI("cur.KWD"c, MoneyCurrencyScale("KWD"c), 3);
  CheckI("cur.BHD"c, MoneyCurrencyScale("BHD"c), 3);
  CheckI("cur.TND"c, MoneyCurrencyScale("TND"c), 3);
  CheckI("cur.CLF"c, MoneyCurrencyScale("CLF"c), 4);
  CheckI("cur.unknown"c, MoneyCurrencyScale("XYZ"c), 2);
  CheckI("cur.null"c, MoneyCurrencyScale(0 as pchar), 2);

  // Yen hat keine Nachkommastellen — die Ausgabe darf keine erfinden
  MoneyFormat(1234, MoneyCurrencyScale("JPY"c), buf, 64, MONEY_FMT_EN);
  CheckStr("fmt.jpy"c, buf, "1,234"c);
  MoneyFormat(1234, MoneyCurrencyScale("KWD"c), buf, 64, MONEY_FMT_EN);
  CheckStr("fmt.kwd"c, buf, "1.234"c);

  // ── Eine ganze Rechnung ────────────────────────────────────────────────────
  //
  // Drei Positionen, Rabatt, Steuer, Aufteilung auf zwei Zahler. Am Ende muss
  // alles bis auf den Cent aufgehen — das ist der Zweck der Unit.
  var pos1: int64 := MoneyMulInt(MoneyParse("19,99"c, 2, MONEY_HALF_UP), 3);
  var pos2: int64 := MoneyMulInt(MoneyParse("4,95"c, 2, MONEY_HALF_UP), 7);
  var pos3: int64 := MoneyParse("129,00"c, 2, MONEY_HALF_UP);
  CheckI("bill.pos1"c, pos1, 5997);
  CheckI("bill.pos2"c, pos2, 3465);
  CheckI("bill.pos3"c, pos3, 12900);

  var net: int64 := MoneyAdd(MoneyAdd(pos1, pos2), pos3);
  CheckI("bill.net"c, net, 22362);

  // 3 Prozent Skonto
  var disc: int64 := MoneyPercent(net, 3, 0, MONEY_HALF_UP);
  CheckI("bill.discount"c, disc, 671);
  var netAfter: int64 := MoneySub(net, disc);
  CheckI("bill.netAfter"c, netAfter, 21691);

  var tax: int64 := MoneyMulRate(netAfter, 19, 2, MONEY_HALF_UP);
  CheckI("bill.tax"c, tax, 4121);
  var gross: int64 := MoneyAdd(netAfter, tax);
  CheckI("bill.gross"c, gross, 25812);

  // Rueckrechnung aus dem Bruttobetrag muss dasselbe Netto ergeben
  CheckI("bill.backwards"c, MoneyNetOfGross(gross, 19, 2, MONEY_HALF_UP), 21691);

  // Auf zwei Zahler aufteilen
  MoneySplit(gross, 2, parts);
  CheckI("bill.split.sum"c, MoneySum(parts, 2), gross);
  CheckI("bill.split.0"c, peek64(parts), 12906);

  MoneyFormat(gross, 2, buf, 64, MONEY_FMT_DE);
  CheckStr("bill.formatted"c, buf, "258,12"c);

  // ── Negativkontrollen ──────────────────────────────────────────────────────
  //
  // Erstens: die Aufteilungspruefung muss anschlagen, wenn ein Anteil verbogen
  // wird. Sonst prueft sie nichts.
  MoneySplit(10000, 3, parts);
  CheckI("negCtrl.sumOk"c, MoneySum(parts, 3), 10000);
  poke64(parts, peek64(parts) - 1);
  CheckB("negCtrl.sumCatches"c, MoneySum(parts, 3) == 10000, false);

  // Zweitens: die naive Aufteilung, die diese Unit vermeidet — dreimal
  // abgerundet ergibt 99,99 statt 100,00.
  var naive: int64 := MoneyMulInt(MoneyDivInt(10000, 3, MONEY_DOWN), 3);
  CheckI("negCtrl.naiveLoses"c, naive, 9999);
  CheckB("negCtrl.naiveDiffers"c, naive == 10000, false);

  // Drittens: die Rundungsarten muessen sich wirklich unterscheiden. Waeren
  // alle gleich, waere die Tabelle oben wertlos.
  CheckB("negCtrl.modesDiffer"c,
         MoneyDivRound(25, 10, MONEY_HALF_UP) == MoneyDivRound(25, 10, MONEY_HALF_EVEN),
         false);
  CheckB("negCtrl.floorCeilDiffer"c,
         MoneyDivRound(0 - 24, 10, MONEY_FLOOR) == MoneyDivRound(0 - 24, 10, MONEY_CEIL),
         false);

  free(buf, 64);  free(arr, 5 * 8);  free(parts, 16 * 8);  free(w, 8 * 8);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
