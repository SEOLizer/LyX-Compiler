// tests/astro_groundtrack_test.lyx
// Selbstpruefende Batterie fuer std.astro.groundtrack (#1995).
//
// Die Sollwerte kommen aus vier Quellen, von denen KEINE die hier geprueften
// Formeln ist:
//
//   1. ein Stuetzpunkt der Zeitrechnung: zur Epoche J2000.0 betraegt der
//      Greenwich-Stundenwinkel 280.46061837 Grad, das sind 18h 41m 50.55s.
//      Diese Zahl ist unabhaengig von jeder Bahnrechnung bekannt;
//   2. Rundlaeufe: die Drehung ECI->ECEF und zurueck muss den Ausgangsvektor
//      wiedergeben. Das ist die Pruefung, die ein falsches Vorzeichen in der
//      Drehmatrix faengt — ein Ergebnisvergleich in nur EINE Richtung waere
//      auch von der Rueckdrehung erfuellt;
//   3. geschlossene Eigenschaften: eine geostationaere Bahn hat einen
//      STEHENDEN Unterpunkt, eine polare ueberstreicht alle Breiten;
//   4. die Erddrehung selbst: ein Sterntag ist eine volle Umdrehung, also
//      muss GMST nach 86164.0905 s wieder denselben Wert haben.
//
// Die geostationaere Probe ist die staerkste: sie stellt Umlaufzeit und
// Erddrehrate gegeneinander, zwei Groessen aus verschiedenen Units.

unit main;

import std.io;
import std.math;
import std.astro.state;
import std.astro.orbit;
import std.astro.launch;
import std.astro.groundtrack;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn CheckRel(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  var d: f64 := AbsF64(got - want);
  var s: f64 := AbsF64(want);
  if (s < 1.0) { s := 1.0; }
  if (d / s <= tol) { PrintStr("PASS "c); PrintStrLn(name); }
  else {
    PrintStr("FAIL "c); PrintStr(name);
    PrintStr(": erhalten "c); PrintF64(got);
    PrintStr(" erwartet "c); PrintF64(want); PrintLn(""c);
    _fails := _fails + 1;
  }
}

fn CheckWahr(name: pchar, got: bool): void {
  _checks := _checks + 1;
  if (got) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStr(name); PrintStrLn(" (erwartet: wahr)"c); _fails := _fails + 1; }
}

fn CheckFalsch(name: pchar, got: bool): void {
  _checks := _checks + 1;
  if (!got) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStr(name); PrintStrLn(" (erwartet: falsch)"c); _fails := _fails + 1; }
}

fn main(): int64 {
  var gr: f64 := Pi() / 180.0;
  var tp: f64 := 2.0 * Pi();
  var mu: f64 := AMuEarth();
  var rE: f64 := ARadiusEarth();
  var j2: f64 := AJ2Earth();
  var om: f64 := AEarthRotation();
  var sid: f64 := 86164.0905;

  // --- Der Stundenwinkel -----------------------------------------------
  CheckRel("GMST zur Epoche J2000.0"c, AGmst(2451545.0) / gr, 280.46061837, 0.0000001);
  // 280.4606 Grad sind 18h 41m 50.55s — dieselbe Zahl in der anderen Einheit.
  CheckRel("dasselbe in Stunden"c, AGmst(2451545.0) / gr / 15.0, 18.697374, 0.00001);
  // Nach einem Sterntag steht die Erde wieder gleich. Das misst die
  // Drehrate, die in der Reihe steckt, gegen die aus std.astro.launch.
  var g0: f64 := AGmst(2451545.0);
  var g1: f64 := AGmst(2451545.0 + sid / 86400.0);
  var dg: f64 := AbsF64(g1 - g0);
  if (dg > Pi()) { dg := tp - dg; }
  CheckWahr("nach einem Sterntag steht GMST wieder gleich"c, dg < 0.00001);
  // Das Falten muss auch vor J2000 greifen — dort ist das Argument negativ,
  // und ein Cast nach int64 statt FloorF64 haette hier das falsche Vorzeichen.
  CheckWahr("GMST liegt auch vor J2000 in [0,2pi)"c,
            AGmst(2400000.5) >= 0.0 && AGmst(2400000.5) < tp);
  CheckWahr("GMST liegt auch weit nach J2000 in [0,2pi)"c,
            AGmst(2500000.0) >= 0.0 && AGmst(2500000.0) < tp);

  // --- Die Drehung ------------------------------------------------------
  var v: AVec3 := AVec(7000000.0, 1234567.0, 3456789.0);
  var g: f64 := 1.2345;
  // Rundlauf. Faengt ein falsches Vorzeichen, das ein Vergleich in nur eine
  // Richtung nicht faenge.
  var rund: AVec3 := AEcefToEci(AEciToEcef(v, g), g);
  CheckRel("Rundlauf ECI->ECEF->ECI, x"c, rund.x, v.x, 0.000000001);
  CheckRel("Rundlauf ECI->ECEF->ECI, y"c, rund.y, v.y, 0.000000001);
  CheckRel("Rundlauf ECI->ECEF->ECI, z"c, rund.z, v.z, 0.000000001);
  // Eine Drehung um z laesst Betrag und z-Komponente unveraendert.
  CheckRel("die Drehung erhaelt den Betrag"c,
           AMagnitude(AEciToEcef(v, g)), AMagnitude(v), 0.000000001);
  CheckRel("die Drehung laesst z stehen"c, AEciToEcef(v, g).z, v.z, 0.000000001);
  // Bei GMST = 0 fallen beide Rahmen zusammen.
  CheckRel("bei GMST 0 sind die Rahmen gleich"c, AEciToEcef(v, 0.0).x, v.x, 0.000000001);
  // Die Drehrichtung ist nicht beliebig: ein Punkt auf der ECI-x-Achse
  // erscheint im mitrotierenden Rahmen bei NEGATIVER Laenge, weil die Erde
  // unter ihm nach Osten weggedreht ist.
  CheckWahr("die Drehung geht nach Osten"c,
            AEciToEcef(AVec(1.0, 0.0, 0.0), 0.5).y < 0.0);

  // --- Unterpunkt -------------------------------------------------------
  // Ein Vektor in der Aequatorebene hat Breite null.
  CheckRel("aequatorialer Ort hat Breite 0"c,
           ASubPointLatitude(AVec(7000000.0, 0.0, 0.0)), 0.0, 0.0000001);
  // Ueber dem Pol sind es 90 Grad.
  CheckRel("polarer Ort hat Breite 90 Grad"c,
           ASubPointLatitude(AVec(0.0, 0.0, 7000000.0)) / gr, 90.0, 0.0000001);
  CheckRel("Suedpol gibt -90 Grad"c,
           ASubPointLatitude(AVec(0.0, 0.0, 0.0 - 7000000.0)) / gr, 0.0 - 90.0, 0.0000001);
  // Die Hoehe ueber der Kugel.
  CheckRel("Hoehe ueber der Kugel"c,
           ASubPointAltitude(AVec(rE + 400000.0, 0.0, 0.0), rE), 400000.0, 0.000001);
  // Der Nullvektor hat keinen Unterpunkt.
  CheckWahr("Nullvektor meldet"c, AIsError(ASubPointLatitude(AVec(0.0, 0.0, 0.0))));

  // --- Laengenversatz je Umlauf ----------------------------------------
  //
  // DIE STAERKSTE PRUEFUNG: eine geostationaere Bahn steht still. Ihr
  // Versatz je Umlauf muss null sein — das stellt die Umlaufzeit aus
  // std.astro.orbit gegen die Drehrate aus std.astro.launch, zwei Groessen
  // aus verschiedenen Units, die nichts voneinander wissen.
  // Gefaltet werden muss dabei auf den Vollkreis: nach einem GEO-Umlauf hat
  // sich die Erde fast genau EINMAL gedreht, der Versatz betraegt also rund
  // -360 Grad und nicht 0. Wer das nicht faltet, misst nichts.
  var aGeo: f64 := ASmaFromRepeatCycle(mu, j2, rE, om, 1.0, 1.0, 0.0, 0.0);
  var dGeo: f64 := AGroundTrackShift(mu, j2, rE, om, aGeo, 0.0, 0.0);
  var rest: f64 := AbsF64(dGeo) - tp;
  CheckWahr("geostationaer: die Spur steht (unter 0.001 Grad je Umlauf)"c,
            AbsF64(rest) / gr < 0.001);
  // Nebenbefund, der die J2-Rechnung von der keplerschen trennt: die WIRKLICH
  // stehende Bahn liegt nicht bei den keplerschen 42164.17 km. J2 laesst den
  // Satelliten bei gegebener Halbachse etwas schneller umlaufen, also muss
  // die Halbachse groesser sein. Rund 2 km — klein, aber die keplersche Bahn
  // wandert damit gut 0.027 Grad je Umlauf, im Jahr rund 10 Grad.
  var aKep: f64 := ASemiMajorFromPeriod(mu, sid);
  CheckWahr("die J2-stehende Bahn liegt hoeher als die keplersche"c, aGeo > aKep);
  CheckRel("und zwar um rund 2 km"c, (aGeo - aKep) / 1000.0, 2.09, 0.05);
  var dKep: f64 := AGroundTrackShift(mu, j2, rE, om, aKep, 0.0, 0.0);
  CheckWahr("die keplersche Bahn steht NICHT still"c,
            AbsF64(AbsF64(dKep) - tp) / gr > 0.01);
  // Eine LEO-Bahn wandert nach WESTEN — der Versatz ist negativ. Ohne diese
  // Richtungspruefung waere der Test auch von einem Vorzeichenfehler erfuellt.
  var aISS: f64 := rE + 420000.0;
  var dISS: f64 := AGroundTrackShift(mu, j2, rE, om, aISS, 0.0, 51.64 * gr);
  CheckWahr("LEO wandert nach Westen"c, dISS < 0.0);
  // Groessenordnung: rund 93 Minuten Umlauf, die Erde dreht in der Zeit
  // gut 23 Grad weiter.
  CheckRel("ISS-Versatz je Umlauf rund -23 Grad"c, dISS / gr, 0.0 - 23.3, 0.02);
  // Auf dem Aequator sind das rund 2600 km.
  CheckRel("derselbe Versatz in Metern"c,
           AGroundTrackShiftEquator(mu, j2, rE, om, aISS, 0.0, 51.64 * gr),
           dISS * rE, 0.000000001);
  // Hoehere Bahn heisst laengerer Umlauf heisst groesserer Versatz.
  CheckWahr("hoehere Bahn versetzt weiter"c,
            AGroundTrackShift(mu, j2, rE, om, rE + 800000.0, 0.0, 98.6 * gr) < dISS);
  // Fehlerpfad.
  CheckWahr("unmoegliche Bahn meldet"c,
            AIsError(AGroundTrackShift(mu, j2, rE, om, 0.0 - 1.0, 0.0, 0.0)));

  PrintStr("\n"c);
  PrintInt(_checks); PrintStr(" Pruefungen, "c);
  PrintInt(_fails); PrintStrLn(" FAIL"c);
  if (_fails == 0) { PrintStrLn("OK: std.astro.groundtrack"c); return 0; }
  return 1;
}
