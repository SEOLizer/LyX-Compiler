// tests/strlen_simd_probe.lyx — Nachweis fuer _lyx_strlen_simd (T1.1).
//
// Geprueft wird der WERT, nicht eine Invariante: jede Laenge wird gegen
// eine unabhaengige byteweise Zaehlung gehalten. Ein Test, der nur „liegt
// zwischen 0 und n" prueft, waere auch von einem falschen Ergebnis
// erfuellt.
//
// Faelle:
//   1. Laengen 0..40 an JEDEM Versatz 0..15 innerhalb der Belegung. Der
//      Helfer rundet den Zeiger auf 16 ab und liest einen Block, der VOR
//      dem Zeiger beginnt; die Bytes davor muessen aus der Maske fallen.
//      Nur ein Durchlauf ueber alle Versaetze deckt das ab.
//   2. Lange Ketten (4095/4096/4097) — der Schleifenweg.
//   3. Nullzeiger gibt 0 (WP-33).
//   4. Seitengrenze: eine Kette, deren Null das LETZTE Byte einer
//      belegten Seite ist, mit einer NICHT belegten Seite dahinter. Laeuft
//      der Helfer darueber hinaus, faultet dieser Fall. Das ist die
//      Zusicherung, die `movdqa` auf 16 ausgerichtet ueberhaupt erst
//      tragfaehig macht.

@description("Nachweis: _lyx_strlen_simd rechnet richtig und liest nicht ueber die Seite")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")

import std.io;

// Unabhaengige Zaehlung — bewusst byteweise und ohne StrLen.
fn zaehle(p: int64): int64 {
  var i: int64 := 0;
  while (peek8(p + i) != 0) { i += 1; }
  return i;
}

fn fuelle(p: int64, n: int64): void {
  var i: int64 := 0;
  while (i < n) { poke8(p + i, 97 + (i % 26)); i += 1; }
  poke8(p + n, 0);
}

fn main(): int64 {
  var fehler: int64 := 0;
  var geprueft: int64 := 0;

  // --- 1 und 2: Laengen an jedem Versatz -------------------------------
  var roh: int64 := alloc(8192);
  var versatz: int64 := 0;
  while (versatz < 16) {
    var n: int64 := 0;
    while (n <= 40) {
      var p: int64 := roh + versatz;
      fuelle(p, n);
      var soll: int64 := zaehle(p);
      var ist: int64 := StrLen(p as pchar);
      geprueft += 1;
      if (ist != soll || soll != n) {
        PrintStr("FEHLER Versatz "c); PrintInt(versatz);
        PrintStr(" Laenge "c); PrintInt(n);
        PrintStr(": StrLen gab "c); PrintInt(ist);
        PrintStr(", gezaehlt "c); PrintLn(soll);
        fehler += 1;
      }
      n += 1;
    }
    // lange Ketten am selben Versatz
    var lang: int64 := 4095;
    while (lang <= 4097) {
      var q: int64 := roh + versatz;
      fuelle(q, lang);
      var soll2: int64 := zaehle(q);
      var ist2: int64 := StrLen(q as pchar);
      geprueft += 1;
      if (ist2 != soll2 || soll2 != lang) {
        PrintStr("FEHLER lang, Versatz "c); PrintInt(versatz);
        PrintStr(" Laenge "c); PrintInt(lang);
        PrintStr(": StrLen gab "c); PrintInt(ist2);
        PrintStr(", gezaehlt "c); PrintLn(soll2);
        fehler += 1;
      }
      lang += 1;
    }
    versatz += 1;
  }

  // --- 3: Nullzeiger ---------------------------------------------------
  var nz: int64 := StrLen(0 as pchar);
  geprueft += 1;
  if (nz != 0) {
    PrintStr("FEHLER Nullzeiger: StrLen gab "c); PrintLn(nz);
    fehler += 1;
  }

  // --- 4: Seitengrenze -------------------------------------------------
  // Zwei Seiten holen, die zweite wieder freigeben. Danach endet die
  // belegte Seite hart; ein Lesen dahinter faultet.
  var zwei: int64 := mmap(0, 8192, 3, 34, 0 - 1, 0);   // PROT_RW, MAP_PRIVATE|MAP_ANONYMOUS
  if (zwei <= 0) {
    PrintLn("FEHLER mmap fuer den Seitentest schlug fehl");
    fehler += 1;
  } else {
    munmap(zwei + 4096, 4096);
    // Kette so legen, dass ihre Null auf dem letzten Byte der Seite liegt.
    var kl: int64 := 0;
    while (kl <= 20) {
      var start: int64 := zwei + 4096 - 1 - kl;
      var j: int64 := 0;
      while (j < kl) { poke8(start + j, 98); j += 1; }
      poke8(zwei + 4095, 0);
      var istk: int64 := StrLen(start as pchar);
      geprueft += 1;
      if (istk != kl) {
        PrintStr("FEHLER Seitengrenze, Laenge "c); PrintInt(kl);
        PrintStr(": StrLen gab "c); PrintLn(istk);
        fehler += 1;
      }
      kl += 1;
    }
  }

  PrintStr("geprueft="c); PrintInt(geprueft);
  PrintStr(" fehler="c); PrintLn(fehler);
  if (fehler != 0) { return 1; }
  PrintLn("ALL PASS");
  return 0;
}
