// WP-02: macOS x86_64 — Closures mit Upvalue-Capture
//
// Neue Funktionalität im Compiler (src/parser.lyx, src/sema.lyx, src/codegen_x86.lyx):
//
//   1. ParseType() erkennt "fn(T): R" als Funktionstyp (ParseFnType)
//   2. ParsePrimary() erzeugt NK_CLOSURE für "fn(params): R { body }"
//   3. Codegen NK_CLOSURE: inline Inner-Function + Heap-Env + Closure-Struct
//   4. cg_genCall: Local-Variable-Call → indirekter Call mit Env-Ptr als erstem Arg
//
// Abnahme (Originaltest):
//   makeCounter() → Closure, 3x aufgerufen → v == 3
//
// Weiterer Test:
//   makeAdder(x) → Closure die immer x addiert
//
// Expected output:
//   3
//   10
//   PASS
import std.io;

fn makeCounter(): fn(): int64 {
  var n: int64 := 0;
  return fn(): int64 { n := n + 1; return n; };
}

fn makeAdder(x: int64): fn(int64): int64 {
  return fn(y: int64): int64 { return x + y; };
}

fn main(): int64 {
  // Test 1: Zähler (Abnahme-Kriterium)
  var c := makeCounter();
  c();
  c();
  var v: int64 := c();
  PrintInt(v);
  PrintLn("");

  // Test 2: Adder-Closure mit explizitem Parameter
  var add5 := makeAdder(5);
  var sum: int64 := add5(5);
  PrintInt(sum);
  PrintLn("");

  // Abnahme
  var ok: int64 := 1;
  if (v != 3) { ok := 0; PrintLn("FAIL: counter"); }
  if (sum != 10) { ok := 0; PrintLn("FAIL: adder"); }
  if (ok != 0) { PrintLn("PASS"); }

  return 0;
}
