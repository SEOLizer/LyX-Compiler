// WP-10: ARM64 Linux — PIE Binary (ET_DYN)
//
// Verifies that the ARM64 ELF writer produces a Position-Independent Executable
// by emitting e_type=ET_DYN (3) and a load VA of 0x1000 instead of ET_EXEC
// with the fixed 0x401000 base.
//
// Compile (native ARM64 Linux or fixed cross-compiler):
//   lyxc --target=arm64 tests/wp10_arm64_pie.lyx -o /tmp/wp10_pie
//
// Expected readelf output:
//   Typ: DYN (gemeinsam genutzte Objektdatei)  [ET_DYN = 3]
//   Einstiegspunktadresse: 0x1000              [relative to load base]
//   Maschine: AArch64
//
// Note: x86_64-hosted cross-compilation maps LYX_TC_ARM64→0 (InjectConBool
// shadow), which resets the target to x86_64 via the zero-sentinel default.
// Run natively on ARM64 Linux or after that bug is fixed.
import std.io;

fn main(): int64 {
  PrintLn("PIE");
  return 0;
}
