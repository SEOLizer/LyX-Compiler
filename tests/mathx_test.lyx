// tests/mathx_test.lyx
// Selbstpruefende Testbatterie fuer std.mathx.
//
// Sollwerte aus Pythons math-Modul, das seinerseits auf der libm des Systems
// aufsetzt — also auf denselben fdlibm-Verfahren.
//
// Der Kern der Pruefung ist der Vergleich MIT std.math: die neuen Fassungen
// muessen messbar genauer sein, sonst waere die Unit ueberfluessig. Gemessen
// in korrekten Dezimalstellen von sechzehn:
//
//     log(1000)   std.math 7 Stellen   ->  mathx exakt
//     exp(10)     std.math 11 Stellen  ->  mathx exakt
//     log10(50)   std.math 9 Stellen   ->  mathx exakt
//
// Dazu strukturelle Aussagen ohne fremde Sollwerte: exp und log sind
// zueinander invers, cosh^2 - sinh^2 = 1, ldexp und frexp heben sich auf.

unit main;

import std.mathx;
import std.feq;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr("\n"c);
  }
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn _abs(x: f64): f64 {
  if (x < 0.0) { return 0.0 - x; }
  return x;
}

// Relativer Vergleich — bei Werten ueber 1e15 zeigt PrintFloat nichts Brauchbares
fn CheckRel(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  var d: f64 := _abs(got - want);
  var w: f64 := _abs(want);
  var rel: f64 := d;
  if (w > 1.0) { rel := d / w; }
  if (rel > tol) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" rel*1e15="c);
    PrintFloat(rel * 1000000000000000.0);
    PrintStr("\n"c);
  }
}

fn CheckExact(name: pchar, got: f64, want: f64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" nicht exakt: "c);
    PrintFloat(got);
    PrintStr(" statt "c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

// Zahl der korrekten Dezimalstellen
fn Digits(got: f64, want: f64): int64 {
  if (want == 0.0) { return 99; }
  var rel: f64 := _abs(got - want) / _abs(want);
  if (rel == 0.0) { return 99; }
  return TruncF64(0.0 - (MxLog(rel) / 2.302585092994046)) as int64;
}

fn main(): int64 {
  var E: f64 := 2.718281828459045;
  var LN2: f64 := 0.6931471805599453;

  // ── Exponent von Hand ──────────────────────────────────────────────────────
  CheckExact("ldexp.simple"c, MxLdexp(1.0, 10), 1024.0);
  CheckExact("ldexp.negative"c, MxLdexp(1.0, 0 - 10), 0.0009765625);
  CheckExact("ldexp.zero"c, MxLdexp(3.5, 0), 3.5);
  CheckExact("ldexp.onZero"c, MxLdexp(0.0, 10), 0.0);
  CheckExact("ldexp.big"c, MxLdexp(1.0, 100), 1.2676506002282294e30);
  CheckExact("ldexp.negValue"c, MxLdexp(0.0 - 3.0, 2), 0.0 - 12.0);
  // Unterlauf ins Subnormale und darunter
  CheckExact("ldexp.underflow"c, MxLdexp(1.0, 0 - 2000), 0.0);

  var ea: int64 := alloc(8);
  var m: f64 := MxFrexp(1024.0, ea);
  CheckExact("frexp.mantissa"c, m, 0.5);
  CheckI("frexp.exponent"c, peek64(ea), 11);
  m := MxFrexp(0.5, ea);
  CheckExact("frexp.half"c, m, 0.5);
  CheckI("frexp.halfExp"c, peek64(ea), 0);
  m := MxFrexp(0.0, ea);
  CheckExact("frexp.zero"c, m, 0.0);
  CheckI("frexp.zeroExp"c, peek64(ea), 0);

  // frexp und ldexp heben sich auf — fuer viele Werte
  var badRound: int64 := 0;
  var i: int64 := 0;
  while (i < 200) {
    var x: f64 := (i as f64) * 3.7 - 300.0;
    if (x != 0.0) {
      var mm: f64 := MxFrexp(x, ea);
      var back: f64 := MxLdexp(mm, peek64(ea));
      if (back != x) { badRound := badRound + 1; }
    }
    i := i + 1;
  }
  CheckI("frexpLdexpRoundTrip"c, badRound, 0);
  free(ea, 8);

  CheckExact("copySign.pos"c, MxCopySign(3.0, 1.0), 3.0);
  CheckExact("copySign.neg"c, MxCopySign(3.0, 0.0 - 1.0), 0.0 - 3.0);
  CheckExact("copySign.fromNeg"c, MxCopySign(0.0 - 3.0, 1.0), 3.0);

  var ip: int64 := alloc(8);
  var frac: f64 := MxModf(3.75, ip);
  CheckExact("modf.frac"c, frac, 0.75);
  CheckExact("modf.int"c, peekf64(ip), 3.0);
  frac := MxModf(0.0 - 3.75, ip);
  CheckExact("modf.negFrac"c, frac, 0.0 - 0.75);
  CheckExact("modf.negInt"c, peekf64(ip), 0.0 - 3.0);
  free(ip, 8);

  // ── Exponentialfunktion ────────────────────────────────────────────────────
  CheckRel("exp.zero"c, MxExp(0.0), 1.0, 0.0);
  CheckRel("exp.one"c, MxExp(1.0), E, 0.000000000000001);
  CheckRel("exp.ten"c, MxExp(10.0), 22026.465794806718, 0.000000000000001);
  CheckRel("exp.negFive"c, MxExp(0.0 - 5.0), 0.006737946999085467, 0.000000000000001);
  CheckRel("exp.half"c, MxExp(0.5), 1.6487212707001282, 0.000000000000001);
  CheckRel("exp.hundred"c, MxExp(100.0), 2.6881171418161356e43, 0.000000000000001);
  CheckRel("exp.large"c, MxExp(709.0), 8.218407461554972e307, 0.000000000000001);
  CheckRel("exp.negLarge"c, MxExp(0.0 - 700.0), 9.859676543759770e-305, 0.00000000000001);
  // Ueberlauf und Unterlauf
  CheckB("exp.overflow"c, FeqIsInf(MxExp(1000.0)), true);
  CheckExact("exp.underflow"c, MxExp(0.0 - 1000.0), 0.0);
  // sehr kleines Argument: 1+x
  CheckExact("exp.tiny"c, MxExp(1.0e-20), 1.0);

  // ── Der Vergleich mit std.math ─────────────────────────────────────────────
  //
  // Das ist der Grund fuer die Unit. Die neuen Fassungen muessen an den
  // gemessenen Schwachstellen BESSER sein.
  var stdLog1000: int64 := Digits(LogF64(1000.0), 6.907755278982137);
  var mxLog1000: int64 := Digits(MxLog(1000.0), 6.907755278982137);
  CheckB("beatsStd.log1000"c, mxLog1000 > stdLog1000, true);
  CheckB("std.log1000IsWeak"c, stdLog1000 < 10, true);

  var stdExp10: int64 := Digits(ExpF64(10.0), 22026.465794806718);
  var mxExp10: int64 := Digits(MxExp(10.0), 22026.465794806718);
  CheckB("beatsStd.exp10"c, mxExp10 > stdExp10, true);

  var stdLog10: int64 := Digits(Log10F64(50.0), 1.6989700043360187);
  var mxLog10v: int64 := Digits(MxLog10(50.0), 1.6989700043360187);
  CheckB("beatsStd.log10"c, mxLog10v > stdLog10, true);

  // ── Logarithmus ────────────────────────────────────────────────────────────
  CheckExact("log.one"c, MxLog(1.0), 0.0);
  CheckRel("log.two"c, MxLog(2.0), LN2, 0.0);
  CheckRel("log.e"c, MxLog(E), 1.0, 0.000000000000001);
  CheckRel("log.thousand"c, MxLog(1000.0), 6.907755278982137, 0.000000000000001);
  CheckRel("log.1e10"c, MxLog(1.0e10), 23.025850929940457, 0.000000000000001);
  CheckRel("log.1e300"c, MxLog(1.0e300), 690.7755278982137, 0.000000000000001);
  CheckRel("log.small"c, MxLog(0.001), 0.0 - 6.907755278982137, 0.000000000000001);
  // #1569: Literale ab 1e-28 werden zu null uebersetzt — der Wert wird
  // deshalb zur Laufzeit aus Faktoren gebildet.
  var tiny2: f64 := 1.0e-25 * 1.0e-25 * 1.0e-25 * 1.0e-25;   // 1e-100
  CheckRel("log.tiny"c, MxLog(tiny2), 0.0 - 230.25850929940458, 0.000000000000001);
  CheckB("log.zeroIsNegInf"c, FeqIsInf(MxLog(0.0)), true);
  CheckB("log.negativeIsNaN"c, FeqIsNaN(MxLog(0.0 - 1.0)), true);

  CheckRel("log2.ten"c, MxLog2(10.0), 3.321928094887362, 0.000000000000001);
  // Zweierpotenzen muessen EXAKT herauskommen
  CheckExact("log2.exactPow"c, MxLog2(1024.0), 10.0);
  CheckExact("log2.exactOne"c, MxLog2(1.0), 0.0);
  CheckExact("log2.exactNeg"c, MxLog2(0.25), 0.0 - 2.0);
  CheckRel("log10.fifty"c, MxLog10(50.0), 1.6989700043360187, 0.000000000000001);
  CheckRel("log10.thousand"c, MxLog10(1000.0), 3.0, 0.000000000000001);

  // exp und log sind zueinander invers — ueber viele Werte, ohne fremden Sollwert
  var badInv: int64 := 0;
  i := 1;
  while (i < 300) {
    var x: f64 := (i as f64) * 0.37;
    var back: f64 := MxLog(MxExp(x));
    if (_abs(back - x) > 1.0e-12 * _abs(x)) { badInv := badInv + 1; }
    var back2: f64 := MxExp(MxLog(x));
    if (_abs(back2 - x) > 1.0e-12 * _abs(x)) { badInv := badInv + 1; }
    i := i + 1;
  }
  CheckI("expLogInverse"c, badInv, 0);

  // log(a*b) = log(a) + log(b)
  var lhs: f64 := MxLog(7.0 * 13.0);
  var rhs: f64 := MxLog(7.0) + MxLog(13.0);
  CheckRel("log.product"c, lhs, rhs, 0.0000000000001);

  // ── expm1 und log1p ────────────────────────────────────────────────────────
  //
  // Hier zeigt sich der Nutzen am deutlichsten: fuer kleines x loescht die
  // naive Rechnung alle Stellen aus.
  CheckRel("expm1.tiny"c, MxExpm1(1.0e-10), 1.00000000005e-10, 0.000000000001);
  CheckRel("expm1.one"c, MxExpm1(1.0), E - 1.0, 0.000000000000001);
  CheckExact("expm1.zero"c, MxExpm1(0.0), 0.0);
  CheckRel("log1p.tiny"c, MxLog1p(1.0e-10), 9.999999999500001e-11, 0.000000000001);
  CheckRel("log1p.one"c, MxLog1p(1.0), LN2, 0.000000000000001);
  CheckExact("log1p.zero"c, MxLog1p(0.0), 0.0);

  // Der Nachweis: die naive Rechnung verliert hier Stellen, die neue nicht
  var naiveExpm1: f64 := ExpF64(1.0e-10) - 1.0;
  var goodExpm1: f64 := MxExpm1(1.0e-10);
  var dN: int64 := Digits(naiveExpm1, 1.00000000005e-10);
  var dG: int64 := Digits(goodExpm1, 1.00000000005e-10);
  CheckB("expm1.beatsNaive"c, dG > dN, true);
  CheckB("expm1.naiveIsBad"c, dN < 8, true);

  // expm1 und log1p sind zueinander invers
  CheckRel("expm1Log1pInverse"c, MxExpm1(MxLog1p(0.001)), 0.001, 0.000000000001);

  // ── exp2 und exp10 ─────────────────────────────────────────────────────────
  CheckExact("exp2.ten"c, MxExp2(10.0), 1024.0);
  CheckExact("exp2.zero"c, MxExp2(0.0), 1.0);
  CheckExact("exp2.negative"c, MxExp2(0.0 - 2.0), 0.25);
  CheckRel("exp2.half"c, MxExp2(0.5), 1.4142135623730951, 0.000000000000001);
  CheckRel("exp10.three"c, MxExp10(3.0), 1000.0, 0.000000000000001);
  CheckRel("exp10.negOne"c, MxExp10(0.0 - 1.0), 0.1, 0.000000000000001);

  // ── Potenz ─────────────────────────────────────────────────────────────────
  CheckExact("pow.intExact"c, MxPow(2.0, 10.0), 1024.0);
  CheckExact("pow.zeroExp"c, MxPow(5.0, 0.0), 1.0);
  CheckExact("pow.oneExp"c, MxPow(5.0, 1.0), 5.0);
  CheckExact("pow.negBaseEven"c, MxPow(0.0 - 2.0, 2.0), 4.0);
  CheckExact("pow.negBaseOdd"c, MxPow(0.0 - 2.0, 3.0), 0.0 - 8.0);
  CheckExact("pow.negExp"c, MxPow(2.0, 0.0 - 2.0), 0.25);
  CheckRel("pow.sqrt"c, MxPow(2.0, 0.5), 1.4142135623730951, 0.000000000000001);
  CheckRel("pow.fractional"c, MxPow(1.1, 50.0), 117.39085287969579, 0.00000000000001);
  CheckB("pow.negBaseFracIsNaN"c, FeqIsNaN(MxPow(0.0 - 2.0, 0.5)), true);
  CheckExact("pow.zeroBase"c, MxPow(0.0, 3.0), 0.0);

  // ── Kubikwurzel ────────────────────────────────────────────────────────────
  CheckRel("cbrt.27"c, MxCbrt(27.0), 3.0, 0.000000000000001);
  CheckRel("cbrt.negative"c, MxCbrt(0.0 - 8.0), 0.0 - 2.0, 0.000000000000001);
  CheckExact("cbrt.zero"c, MxCbrt(0.0), 0.0);
  CheckRel("cbrt.one"c, MxCbrt(1.0), 1.0, 0.000000000000001);
  CheckRel("cbrt.large"c, MxCbrt(1.0e30), 1.0e10, 0.000000000000001);
  var small: f64 := 1.0e-15 * 1.0e-15;      // 1e-30, siehe #1569
  var smallRoot: f64 := 1.0e-10;
  CheckRel("cbrt.small"c, MxCbrt(small), smallRoot, 0.000000000000001);
  // die dritte Potenz muss zurueckfuehren
  var badCbrt: int64 := 0;
  i := 1;
  while (i < 100) {
    var v: f64 := (i as f64) * 7.3;
    var c: f64 := MxCbrt(v);
    if (_abs(c * c * c - v) > 1.0e-12 * v) { badCbrt := badCbrt + 1; }
    i := i + 1;
  }
  CheckI("cbrtCubesBack"c, badCbrt, 0);

  // ── Hyperbolische Funktionen ───────────────────────────────────────────────
  CheckRel("sinh.one"c, MxSinh(1.0), 1.1752011936438014, 0.000000000000001);
  CheckRel("cosh.one"c, MxCosh(1.0), 1.5430806348152437, 0.000000000000001);
  CheckRel("tanh.one"c, MxTanh(1.0), 0.7615941559557649, 0.000000000000001);
  CheckExact("sinh.zero"c, MxSinh(0.0), 0.0);
  CheckExact("cosh.zero"c, MxCosh(0.0), 1.0);
  CheckExact("tanh.zero"c, MxTanh(0.0), 0.0);
  // ungerade und gerade
  CheckRel("sinh.odd"c, MxSinh(0.0 - 1.0), 0.0 - 1.1752011936438014, 0.000000000000001);
  CheckRel("cosh.even"c, MxCosh(0.0 - 1.0), 1.5430806348152437, 0.000000000000001);
  // Saettigung
  CheckRel("tanh.saturates"c, MxTanh(100.0), 1.0, 0.0);
  CheckRel("tanh.saturatesNeg"c, MxTanh(0.0 - 100.0), 0.0 - 1.0, 0.0);
  // kleines Argument ohne Ausloeschung
  CheckRel("sinh.tiny"c, MxSinh(1.0e-10), 1.0e-10, 0.000000001);
  CheckRel("tanh.tiny"c, MxTanh(1.0e-10), 1.0e-10, 0.000000001);

  // cosh^2 - sinh^2 = 1 — die Grundidentitaet, ohne fremden Sollwert
  var badId: int64 := 0;
  i := 0;
  while (i < 60) {
    var x: f64 := (i as f64) * 0.25 - 7.0;
    var sh: f64 := MxSinh(x);
    var ch: f64 := MxCosh(x);
    var id: f64 := ch * ch - sh * sh;
    if (_abs(id - 1.0) > 0.000000001) { badId := badId + 1; }
    // tanh = sinh/cosh
    if (_abs(MxTanh(x) - sh / ch) > 0.000000001) { badId := badId + 1; }
    i := i + 1;
  }
  CheckI("hyperbolicIdentity"c, badId, 0);

  // ── Umkehrfunktionen ───────────────────────────────────────────────────────
  CheckRel("asinh.one"c, MxAsinh(1.0), 0.881373587019543, 0.000000000000001);
  CheckRel("acosh.two"c, MxAcosh(2.0), 1.3169578969248166, 0.000000000000001);
  CheckRel("atanh.half"c, MxAtanh(0.5), 0.5493061443340548, 0.000000000000001);
  CheckExact("asinh.zero"c, MxAsinh(0.0), 0.0);
  CheckExact("acosh.one"c, MxAcosh(1.0), 0.0);
  CheckExact("atanh.zero"c, MxAtanh(0.0), 0.0);
  CheckB("acosh.belowOneIsNaN"c, FeqIsNaN(MxAcosh(0.5)), true);
  CheckB("atanh.aboveOneIsNaN"c, FeqIsNaN(MxAtanh(1.5)), true);
  CheckRel("asinh.odd"c, MxAsinh(0.0 - 1.0), 0.0 - 0.881373587019543, 0.000000000000001);

  // Umkehrung: asinh(sinh(x)) = x
  var badInvH: int64 := 0;
  i := 0;
  while (i < 40) {
    var x: f64 := (i as f64) * 0.3 - 6.0;
    if (_abs(MxAsinh(MxSinh(x)) - x) > 0.0000000001) { badInvH := badInvH + 1; }
    if (_abs(MxAtanh(MxTanh(x)) - x) > 0.0000001) { badInvH := badInvH + 1; }
    i := i + 1;
  }
  CheckI("inverseHyperbolic"c, badInvH, 0);

  // ── Rest bei Division ──────────────────────────────────────────────────────
  CheckExact("fmod.simple"c, MxFmod(7.0, 3.0), 1.0);
  CheckExact("fmod.negative"c, MxFmod(0.0 - 7.0, 3.0), 0.0 - 1.0);
  CheckExact("fmod.exact"c, MxFmod(6.0, 3.0), 0.0);
  CheckB("fmod.byZeroIsNaN"c, FeqIsNaN(MxFmod(1.0, 0.0)), true);
  // IEEE-Rest: zur naechsten ganzen Zahl, nicht zur kleineren
  CheckExact("remainder.seven"c, MxRemainder(7.0, 3.0), 1.0);
  CheckExact("remainder.five"c, MxRemainder(5.0, 3.0), 0.0 - 1.0);
  // und das ist der Unterschied zu fmod
  CheckB("remainder.differsFromFmod"c,
         MxRemainder(5.0, 3.0) == MxFmod(5.0, 3.0), false);

  // ── Negativkontrollen ──────────────────────────────────────────────────────
  //
  // Erstens: die Vergleiche mit std.math muessen echte Unterschiede messen.
  CheckB("negCtrl.logDiffers"c, MxLog(1000.0) == LogF64(1000.0), false);
  CheckB("negCtrl.expDiffers"c, MxExp(10.0) == ExpF64(10.0), false);

  // Zweitens: die Argumentreduktion muss wirken. Ohne sie waere exp(100)
  // deutlich ungenauer als exp(1) — hier ist beides gleich gut.
  var d1: int64 := Digits(MxExp(1.0), E);
  var d100: int64 := Digits(MxExp(100.0), 2.6881171418161356e43);
  CheckB("negCtrl.reductionWorks"c, d100 >= d1 - 2, true);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
