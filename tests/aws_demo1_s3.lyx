// tests/aws_demo1_s3.lyx — AWS SDK Demo: S3 upload/download/presign
// WP-AWS-15

unit tests.aws_demo1_s3;

import std.cloud.aws.core;
import std.cloud.s3;
import std.alloc;
import std.io;

pub fn main(argc: int64, argv: pchar): int64 {
    PrintLn("=== AWS S3 Demo ==="c);

    var creds: AWSCreds := AWSCredentialsDefault();
    if (creds.accessKey == 0) {
        PrintLn("Error: no credentials. Set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY."c);
        return 1;
    }

    var region: pchar := "eu-central-1"c;
    if (creds.region != 0) { region := creds.region as pchar; }

    var client: S3Client := S3Connect(creds, region);

    // 1. List buckets
    PrintLn("--- List Buckets ---"c);
    // #1943: S3ListBuckets liefert eine S3BucketList, keine Zeichenkette. Bis
    // 1.1.19D stand hier `var buckets: int64 := ...`, gefolgt von
    // `PrintLn(buckets as pchar)` und einem `free` ueber die so gemessene
    // "Laenge" — ausgegeben wurde damit das Speicherbild des Structs, und
    // freigegeben ein Block, den es so nie gab. Uebersetzt hat es nur, weil
    // die Typpruefung ueber Unitgrenzen ausfiel.
    //
    // Die Unit bietet den richtigen Zugang: Anzahl, Name je Eintrag, Freigabe.
    var buckets: S3BucketList := S3ListBuckets(client);
    var n: int64 := S3BucketListCount(buckets);
    if (n > 0) {
        var bi: int64 := 0;
        while (bi < n) {
            PrintLn(S3BucketListGetName(buckets, bi));
            bi := bi + 1;
        }
    } else {
        PrintLn("(no buckets or error)"c);
    }
    S3BucketListFree(buckets);

    // 2. Create test bucket
    var bucket: pchar := "lyxaws-demo-test-bucket"c;
    PrintLn("--- Create Bucket ---"c);
    var ok: int64 := S3BucketCreate(client, bucket);
    if (ok == 1) {
        Print("Created: "c); PrintLn(bucket);
    } else {
        PrintLn("Bucket already exists or error (continuing)"c);
    }

    // 3. Upload an object
    PrintLn("--- Upload Object ---"c);
    var content: pchar := "Hello from Lyx AWS SDK! This is a test file."c;
    var contentLen: int64 := StrLen(content);
    ok := S3PutObject(client, bucket, "test/hello.txt"c,
                      content as int64, contentLen, "text/plain"c);
    if (ok == 0) { PrintLn("Upload: OK"c); } else { PrintLn("Upload: FAILED"c); }

    // 4. Check if object exists
    PrintLn("--- Head Object ---"c);
    var exists: int64 := S3ObjectExists(client, bucket, "test/hello.txt"c);
    if (exists == 1) { PrintLn("Object exists: YES"c); } else { PrintLn("Object exists: NO"c); }

    // 5. Download object
    PrintLn("--- Download Object ---"c);
    var data: int64 := S3GetObject(client, bucket, "test/hello.txt"c);
    if (data != 0) {
        Print("Content: "c); PrintLn(data as pchar);
        free(data, StrLen(data as pchar)+1);
    } else {
        PrintLn("Download: FAILED"c);
    }

    // 6. List objects with prefix
    PrintLn("--- List Objects (prefix=test/) ---"c);
    // #1344: S3ListObjects verlangt maxKeys als viertes Argument.
    var listing: int64 := S3ListObjects(client, bucket, "test/"c, 1000);
    if (listing != 0) {
        PrintLn(listing as pchar);
        free(listing, StrLen(listing as pchar)+1);
    }

    // 7. Presigned URL
    PrintLn("--- Presigned URL (1 hour) ---"c);
    var url: int64 := S3PresignURL(client, bucket, "test/hello.txt"c, 3600);
    if (url != 0) {
        PrintLn(url as pchar);
        free(url, StrLen(url as pchar)+1);
    } else {
        PrintLn("Presign: FAILED"c);
    }

    // 8. Delete object
    PrintLn("--- Delete Object ---"c);
    ok := S3DeleteObject(client, bucket, "test/hello.txt"c);
    if (ok == 1) { PrintLn("Deleted object"c); } else { PrintLn("Delete failed"c); }

    // 9. Delete bucket
    PrintLn("--- Delete Bucket ---"c);
    ok := S3BucketDelete(client, bucket);
    if (ok == 1) { PrintLn("Deleted bucket"c); } else { PrintLn("Delete failed (may not be empty)"c); }

    S3Close(client);
    PrintLn("=== Done ==="c);
    return 0;
}
