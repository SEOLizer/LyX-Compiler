// #2391: sha256_compress gegen die NIST-Vektoren (FIPS 180-4 / CAVP).
//
// Geprueft wird der WERT des Zustands nach der Kompression, nicht dass der
// Aufruf durchlaeuft. Die Erwartungswerte sind die veroeffentlichten
// Hashes, woertlich uebernommen.
//
// Laeuft nur mit SHA-NI. Ohne das Feature loest der Befehl SIGILL aus —
// darum fragt der Test selbst ab und meldet SKIP statt rot zu werden.
import src.std.io
import std.cpu.features

// Zustand als 8 Woerter ausgeben und mit der Erwartung vergleichen
fn pruefe(name: pchar, st: int64, erw: pchar): int64 {
  var puf: int64 := alloc(80);
  var p: int64 := 0;
  var ziffern: pchar := "0123456789abcdef"c;
  var i: int64 := 0;
  while (i < 8) {
    var w: int64 := peek32(st + i * 4) & 4294967295;
    var k: int64 := 7;
    while (k >= 0) {
      poke8(puf + p, peek8((ziffern as int64) + ((w >> (k * 4)) & 15)));
      p := p + 1;
      k := k - 1;
    }
    i := i + 1;
  }
  poke8(puf + p, 0);
  if (StrEquals(puf as pchar, erw) != 0) {
    PrintStr("PASS "c); PrintStrLn(name);
    return 0;
  }
  PrintStr("FAIL "c); PrintStr(name);
  PrintStr(": ist "c); PrintStr(puf as pchar);
  PrintStr(" soll "c); PrintStrLn(erw);
  return 1;
}

fn initZustand(st: int64) {
  poke32(st,      1779033703);
  poke32(st + 4,  3144134277);
  poke32(st + 8,  1013904242);
  poke32(st + 12, 2773480762);
  poke32(st + 16, 1359893119);
  poke32(st + 20, 2600822924);
  poke32(st + 24,  528734635);
  poke32(st + 28, 1541459225);
}

fn main(): int64 {
  if (CpuHasSHANI() == 0) {
    PrintStrLn("SKIP: diese CPU hat kein SHA-NI (CPUID.7.0:EBX Bit 29)"c);
    PrintStrLn("ALL PASS"c);
    return 0;
  }
  var fehler: int64 := 0;
  var st:  int64 := alloc(32);
  var blk: int64 := alloc(128);

  // 1. "abc" — ein Block
  initZustand(st);
  var i: int64 := 0;
  while (i < 64) { poke8(blk + i, 0); i := i + 1; }
  poke8(blk + 0, 97); poke8(blk + 1, 98); poke8(blk + 2, 99);
  poke8(blk + 3, 128);
  poke8(blk + 63, 24);
  sha256_compress(st, blk, 1);
  fehler := fehler + pruefe("abc"c, st,
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"c);

  // 2. leere Nachricht
  initZustand(st);
  i := 0;
  while (i < 64) { poke8(blk + i, 0); i := i + 1; }
  poke8(blk + 0, 128);
  sha256_compress(st, blk, 1);
  fehler := fehler + pruefe("leer"c, st,
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"c);

  // 3. ZWEI Bloecke in EINEM Aufruf: 56 Byte 'a' plus Polsterung.
  //    Prueft die Blockschleife — ein Test mit nur einem Block waere auch
  //    von einer Fassung erfuellt, die rdx ignoriert.
  initZustand(st);
  i := 0;
  while (i < 128) { poke8(blk + i, 0); i := i + 1; }
  i := 0;
  while (i < 56) { poke8(blk + i, 97); i := i + 1; }   // 56 x 'a'
  poke8(blk + 56, 128);
  poke8(blk + 126, 1); poke8(blk + 127, 192);          // 448 Bit = 0x1C0
  sha256_compress(st, blk, 2);
  fehler := fehler + pruefe("56a_zwei_bloecke"c, st,
    "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a"c);

  PrintStr("Fehler: "c); PrintInt(fehler); PrintStrLn(""c);
  if (fehler == 0) { PrintStrLn("ALL PASS"c); return 0; }
  PrintStrLn("FAIL"c);
  return 1;
}
