// #2391 Punkt 2 (Mehrblock): erschoepfender Vergleich ueber alle Laengen
// 0..320. Drei Dinge werden gegeneinander gehalten, nicht gegen eine
// Invariante:
//
//   1. Schnellweg gegen Softwareweg  (prueft sha256_compress mit n > 1)
//   2. Sha256Update stueckweise gegen SHA256 in einem Zug, je Weg
//      (prueft die ZWEITE Mehrblockstelle in Sha256Update — eigene
//      Aufzaehlung, eigene Rechnung `full`)
//   3. vier Stueckgroessen: 1, 7, 64, 100 — 1 fuellt nur den Puffer,
//      64 trifft die Blockgrenze genau, 7 und 100 liegen schief dazu
//
// Die Laengenreihe deckt beide Padgrenzen (remaining < 56, >= 56) in jedem
// Block ab und laeuft bis 320 B = 5 Bloecke, also n = 1..5 im Schnellweg.
import std.crypto.sha256;
import std.cpu.features;

fn hashEinmal(d: int64, n: int64, out: int64) {
  SHA256(d, n, out);
}

fn hashStueckweise(d: int64, n: int64, stueck: int64, out: int64) {
  var ctx: int64 := alloc(Sha256CtxSize());
  Sha256Init(ctx);
  var pos: int64 := 0;
  while (pos < n) {
    var rest: int64 := n - pos;
    var k: int64 := stueck;
    if (k > rest) { k := rest; }
    Sha256Update(ctx, d + pos, k);
    pos := pos + k;
  }
  Sha256Final(ctx, out);
}

fn gleich32(a: int64, b: int64): int64 {
  var i: int64 := 0;
  while (i < 32) {
    if (peek8(a + i) != peek8(b + i)) { return 0; }
    i := i + 1;
  }
  return 1;
}

fn main(): int64 {
  var MAX: int64 := 320;
  var d: int64 := alloc(MAX + 8);
  var i: int64 := 0;
  while (i < MAX) { poke8(d + i, (i * 31 + 7) % 251); i := i + 1; }

  // Zuerst merken: SHA256NIAvailable() gibt 0 zurueck, solange der
  // Umschalter auf Software steht — am Ende der Schleife abgefragt waere die
  // Zeile irrefuehrend und der Nachweis, dass der Schnellweg lief, faellt weg.
  SHA256ForceSoftware(0);
  var shani: int64 := SHA256NIAvailable();

  var hw: int64 := alloc(40);
  var sw: int64 := alloc(40);
  var st: int64 := alloc(40);

  var stuecke: int64 := alloc(32);
  poke64(stuecke +  0, 1);
  poke64(stuecke +  8, 7);
  poke64(stuecke + 16, 64);
  poke64(stuecke + 24, 100);

  var fehlerWege:    int64 := 0;
  var fehlerStueckH: int64 := 0;
  var fehlerStueckS: int64 := 0;
  var ersteLaenge:   int64 := 0 - 1;

  var n: int64 := 0;
  while (n <= MAX) {
    SHA256ForceSoftware(0); hashEinmal(d, n, hw);
    SHA256ForceSoftware(1); hashEinmal(d, n, sw);
    if (gleich32(hw, sw) == 0) {
      fehlerWege := fehlerWege + 1;
      if (ersteLaenge < 0) { ersteLaenge := n; }
    }

    var s: int64 := 0;
    while (s < 4) {
      var k: int64 := peek64(stuecke + s * 8);
      SHA256ForceSoftware(0); hashStueckweise(d, n, k, st);
      if (gleich32(st, hw) == 0) {
        fehlerStueckH := fehlerStueckH + 1;
        if (ersteLaenge < 0) { ersteLaenge := n; }
      }
      SHA256ForceSoftware(1); hashStueckweise(d, n, k, st);
      if (gleich32(st, sw) == 0) {
        fehlerStueckS := fehlerStueckS + 1;
        if (ersteLaenge < 0) { ersteLaenge := n; }
      }
      s := s + 1;
    }
    n := n + 1;
  }

  PrintStr("shani_verfuegbar="); PrintInt(shani);               PrintLn("");
  PrintStr("laengen=");          PrintInt(MAX + 1);             PrintLn("");
  PrintStr("fehler_wege=");      PrintInt(fehlerWege);          PrintLn("");
  PrintStr("fehler_stueck_hw="); PrintInt(fehlerStueckH);       PrintLn("");
  PrintStr("fehler_stueck_sw="); PrintInt(fehlerStueckS);       PrintLn("");
  PrintStr("erste_abweichung="); PrintInt(ersteLaenge);         PrintLn("");
  if (fehlerWege == 0 && fehlerStueckH == 0 && fehlerStueckS == 0) {
    PrintLn("ALLE GLEICH");
    return 0;
  }
  PrintLn("ABWEICHUNG");
  return 1;
}
