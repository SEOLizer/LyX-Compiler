// Beide Wege der OEFFENTLICHEN API gegeneinander: Hardware und Software
// muessen denselben Hash liefern. Ohne den Umschalter waere der Softwareweg
// auf einer SHA-NI-CPU nicht mehr erreichbar.
import std.crypto.sha256;
import std.cpu.features;

fn zeig(name: pchar, d: pchar, n: int64) {
  var hex: int64 := alloc(80);
  SHA256Hex(d as int64, n, hex);
  PrintStr(name); PrintStr(": "); PrintStr(hex as pchar); PrintLn("");
}

fn main(): int64 {
  PrintStr("SHA-NI verfuegbar: "); PrintInt(SHA256NIAvailable()); PrintLn("");
  zeig("abc  hw", "abc", 3);
  SHA256ForceSoftware(1);
  zeig("abc  sw", "abc", 3);
  SHA256ForceSoftware(0);
  zeig("leer hw", "", 0);
  SHA256ForceSoftware(1);
  zeig("leer sw", "", 0);

  // Lange Nachricht ueber mehrere Bloecke, beide Wege Byte fuer Byte
  var lang: int64 := alloc(200);
  var i: int64 := 0;
  while (i < 200) { poke8(lang + i, 97 + (i % 26)); i := i + 1; }
  var h1: int64 := alloc(80);
  var h2: int64 := alloc(80);
  SHA256ForceSoftware(0); SHA256Hex(lang, 200, h1);
  SHA256ForceSoftware(1); SHA256Hex(lang, 200, h2);
  PrintStr("200B hw: "); PrintStr(h1 as pchar); PrintLn("");
  PrintStr("200B sw: "); PrintStr(h2 as pchar); PrintLn("");
  var gleich: int64 := 1;
  i := 0;
  while (i < 64) {
    if (peek8(h1 + i) != peek8(h2 + i)) { gleich := 0; }
    i := i + 1;
  }
  if (gleich != 0) { PrintLn("GLEICH"); } else { PrintLn("UNGLEICH"); }
  return 0;
}
