// tests/grp01_core_test.lyx
// WP-GRP-01 Abnahmetest: GraphNow, GraphIDFromStr, GraphIDNew

unit tests.grp01_core_test;

import std.graphdb.core;
import std.io;

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // GraphNow > 0
    var t1: int64 := GraphNow();
    if (t1 <= 0) {
        PrintLn("FAIL: GraphNow returned <= 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: GraphNow > 0"c);
    }

    // GraphNow wächst
    var t2: int64 := GraphNow();
    if (t2 < t1) {
        PrintLn("FAIL: GraphNow did not grow"c);
        ok := 0;
    } else {
        PrintLn("PASS: GraphNow grows"c);
    }

    // GraphIDFromStr deterministisch
    var id1: int64 := GraphIDFromStr("alice"c, 5);
    var id2: int64 := GraphIDFromStr("alice"c, 5);
    if (id1 != id2) {
        PrintLn("FAIL: GraphIDFromStr not deterministic"c);
        ok := 0;
    } else {
        PrintLn("PASS: GraphIDFromStr deterministic"c);
    }

    // GraphIDFromStr verschieden für verschiedene Strings
    var id3: int64 := GraphIDFromStr("bob"c, 3);
    if (id1 == id3) {
        PrintLn("FAIL: GraphIDFromStr collision alice==bob"c);
        ok := 0;
    } else {
        PrintLn("PASS: GraphIDFromStr alice!=bob"c);
    }

    // GraphIDFromStr > 0
    if (id1 <= 0) {
        PrintLn("FAIL: GraphIDFromStr returned <= 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: GraphIDFromStr > 0"c);
    }

    // GraphIDNew > 0
    var n1: int64 := GraphIDNew();
    if (n1 <= 0) {
        PrintLn("FAIL: GraphIDNew returned <= 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: GraphIDNew > 0"c);
    }

    // GraphIDNew zwei Aufrufe verschieden
    var n2: int64 := GraphIDNew();
    if (n1 == n2) {
        PrintLn("FAIL: GraphIDNew returned same value twice"c);
        ok := 0;
    } else {
        PrintLn("PASS: GraphIDNew unique"c);
    }

    if (ok != 0) {
        PrintLn("=== WP-GRP-01: ALL PASS ==="c);
    } else {
        PrintLn("=== WP-GRP-01: FAILURES ==="c);
    }
    return ok;
}
