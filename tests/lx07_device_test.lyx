// LX-07 Test: I/O-Geräte & Poll
// Öffnet eine Pipe, schreibt ein Byte, pollt auf dem Lese-Ende.

import src.std.lyxos.fs;
import src.std.lyxos.device;
import src.std.alloc;

fn main(): int64 {
    // Pipe anlegen: sys_pipe(read_fd_out, write_fd_out, flags)
    var buf: int64 := alloc(16);
    sys_pipe(buf as pchar, (buf + 8) as pchar, 0);
    var rfd: int64 := peek8(buf,     0);
    var wfd: int64 := peek8(buf + 8, 0);

    // 1 Byte in den Schreib-Ende schreiben
    var one: int64 := alloc(1);
    poke8(one, 0, 65);   // 'A'
    sys_write(wfd, one as pchar, 1);

    // PollEvent auf dem Lese-Ende: events = POLL_IN
    var ev: int64 := alloc(POLL_EVENT_SIZE);
    poke8(ev,      0, rfd);       // fd
    poke8(ev + 8,  0, POLL_IN);   // events (32-bit, aber poke8 passt)

    // sys_poll(events_ptr, count, timeout_ns=0)
    var ready: int64 := sys_poll(ev as pchar, 1, 0);

    // revents lesen (Bytes 12–15)
    var revents: int64 := peek8(ev + 8, 0);

    sys_close(rfd);
    sys_close(wfd);

    // sys_ioctl mit ungültigem Request → ERR_INVAL erwartet
    var err: int64 := sys_ioctl(0, 0xDEAD, 0 as pchar);

    // Ergebnis: ready >= 0 (kein Fehler) && POLL_IN gesetzt
    if ready < 0 { return 1; }
    if (revents & POLL_IN) == 0 { return 2; }

    return 0;
}
