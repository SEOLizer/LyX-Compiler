// tests/pgp00_core_test.lyx — PGP-00: Core constants and CRC-24

unit tests.pgp00_core_test;

import std.pgp.core;
import std.alloc;
import std.io;

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Test 1: selected constant values
    // -------------------------------------------------------------------------
    if (PGP_TAG_SIG != 2) { PrintLn("FAIL: PGP_TAG_SIG != 2"c); ok := 0; }
    else { PrintLn("PASS: PGP_TAG_SIG=2"c); }

    if (PGP_ALG_RSA != 1) { PrintLn("FAIL: PGP_ALG_RSA != 1"c); ok := 0; }
    else { PrintLn("PASS: PGP_ALG_RSA=1"c); }

    if (PGP_HASH_SHA256 != 8) { PrintLn("FAIL: PGP_HASH_SHA256 != 8"c); ok := 0; }
    else { PrintLn("PASS: PGP_HASH_SHA256=8"c); }

    if (PGP_SYM_AES256 != 9) { PrintLn("FAIL: PGP_SYM_AES256 != 9"c); ok := 0; }
    else { PrintLn("PASS: PGP_SYM_AES256=9"c); }

    if (PGP_SIG_CERT_POSITIVE != 0x13) { PrintLn("FAIL: PGP_SIG_CERT_POSITIVE != 0x13"c); ok := 0; }
    else { PrintLn("PASS: PGP_SIG_CERT_POSITIVE=0x13"c); }

    // -------------------------------------------------------------------------
    // Test 2: packet struct layout constants
    // -------------------------------------------------------------------------
    if (PGP_PKT_SIZE != 32) { PrintLn("FAIL: PGP_PKT_SIZE != 32"c); ok := 0; }
    else { PrintLn("PASS: PGP_PKT_SIZE=32"c); }

    // -------------------------------------------------------------------------
    // Test 3: tag constants are distinct
    // -------------------------------------------------------------------------
    var distinct: int64 := 1;
    if (PGP_TAG_SIG     == PGP_TAG_PUBKEY)    { distinct := 0; }
    if (PGP_TAG_PUBKEY  == PGP_TAG_UID)       { distinct := 0; }
    if (PGP_TAG_UID     == PGP_TAG_SECKEY)    { distinct := 0; }
    if (PGP_TAG_SECKEY  == PGP_TAG_SEIPD)     { distinct := 0; }
    if (PGP_TAG_LITERAL == PGP_TAG_COMPRESSED){ distinct := 0; }
    if (distinct != 1) { PrintLn("FAIL: tag constants not distinct"c); ok := 0; }
    else { PrintLn("PASS: tag constants distinct"c); }

    // -------------------------------------------------------------------------
    // Test 4: algo constants are distinct
    // -------------------------------------------------------------------------
    var dAlg: int64 := 1;
    if (PGP_ALG_RSA  == PGP_ALG_DSA)    { dAlg := 0; }
    if (PGP_ALG_DSA  == PGP_ALG_ECDSA)  { dAlg := 0; }
    if (PGP_ALG_ECDH == PGP_ALG_EDDSA)  { dAlg := 0; }
    if (dAlg != 1) { PrintLn("FAIL: algo constants not distinct"c); ok := 0; }
    else { PrintLn("PASS: algo constants distinct"c); }

    // -------------------------------------------------------------------------
    // Test 5: CRC-24 of 0 bytes = 0xB704CE (init value passes through unchanged)
    // -------------------------------------------------------------------------
    var buf0: int64 := alloc(4);
    var crc0: int64 := PgpCrc24(buf0, 0);
    free(buf0, 4);
    if (crc0 != 0xB704CE) { PrintLn("FAIL: CRC-24 empty != 0xB704CE"c); ok := 0; }
    else { PrintLn("PASS: CRC-24 empty=0xB704CE"c); }

    // -------------------------------------------------------------------------
    // Test 6: CRC-24 of [0x01] = 0xE72528  (manually verified)
    // -------------------------------------------------------------------------
    var buf1: int64 := alloc(4);
    poke8(buf1, 1);
    var crc1: int64 := PgpCrc24(buf1, 1);
    free(buf1, 4);
    if (crc1 != 0xE72528) { PrintLn("FAIL: CRC-24([0x01]) != 0xE72528"c); ok := 0; }
    else { PrintLn("PASS: CRC-24([0x01])=0xE72528"c); }

    // -------------------------------------------------------------------------
    // Test 7: CRC-24 is consistent (same input → same output)
    // -------------------------------------------------------------------------
    var buf3: int64 := alloc(8);
    poke8(buf3, 0x48); poke8(buf3+1, 0x65); poke8(buf3+2, 0x6C);
    poke8(buf3+3, 0x6C); poke8(buf3+4, 0x6F); poke8(buf3+5, 0x21);
    var c3a: int64 := PgpCrc24(buf3, 6);
    var c3b: int64 := PgpCrc24(buf3, 6);
    free(buf3, 8);
    if (c3a != c3b) { PrintLn("FAIL: CRC-24 not consistent"c); ok := 0; }
    else { PrintLn("PASS: CRC-24 consistent"c); }

    if (ok != 0) { PrintLn("=== PGP-00: ALL PASS ==="c); }
    else         { PrintLn("=== PGP-00: SOME FAIL ==="c); }
    return ok;
}
