// tests/pqc_wp05_test.lyx
// WP-PQC-05: NTT / Polynomring-Arithmetik
//
// Abnahmekriterien:
// AC-WP05.1: KyberNTT → KyberINTT = Original (mod 3329)
// AC-WP05.2: KyberPolyAdd korrekt mod q
// AC-WP05.3: KyberPolySub korrekt mod q
// AC-WP05.4: KyberSampleCBD — Koeffizienten ∈ [0, q) aus Binomialverteilung
// AC-WP05.5: DilithiumNTT → DilithiumINTT = Original (mod 8380417)

unit tests.pqc_wp05_test;

import std.crypto.ntt;
import std.alloc;

// ─── Hilfsfunktionen ──────────────────────────────────────────────────────────

fn fillPoly(f: int64, seed: int64) {
  // Füllt Polynom mit pseudo-zufälligen Werten ∈ [0, q) via Lfsr
  var v: int64 := seed;
  var i: int64 := 0;
  while (i < 256) {
    v := (v * 6364136223846793005) + 1442695040888963407;
    var c: int64 := (v >> 16) & 0xFFFF;
    poke64(f+i*8, c - (c/3329)*3329);
    i := i+1;
  }
}

fn fillPolyDilith(f: int64, seed: int64) {
  var v: int64 := seed;
  var i: int64 := 0;
  while (i < 256) {
    v := (v * 6364136223846793005) + 1442695040888963407;
    var c: int64 := (v >> 8) & 0xFFFFFF;
    poke64(f+i*8, c - (c/8380417)*8380417);
    i := i+1;
  }
}

fn polyEqual(a: int64, b: int64, q: int64): int64 {
  var i: int64 := 0;
  while (i < 256) {
    if (peek64(a+i*8) != peek64(b+i*8)) { return 0; }
    i := i+1;
  }
  return 1;
}

// ============================================================
// AC-WP05.1: KyberNTT → KyberINTT Roundtrip
// ============================================================
fn testKyberNTTRoundtrip(): int64 {
  var f: int64 := NTTPolyNew();
  var g: int64 := NTTPolyNew();
  fillPoly(f, 0xDEADBEEF);
  // Kopie für Vergleich
  var i: int64 := 0;
  while (i < 2048) { poke8(g+i, peek8(f+i)); i := i+1; }
  // NTT dann INTT
  KyberNTT(f);
  KyberINTT(f);
  var ok: int64 := polyEqual(f, g, 3329);
  NTTPolyFree(f); NTTPolyFree(g);
  if (ok == 1) { PrintLn("OK: KyberNTT->KyberINTT Roundtrip (WP-05.1)"); return 0; }
  PrintLn("FAIL: KyberNTT->KyberINTT Roundtrip (WP-05.1)");
  return 1;
}

// ============================================================
// AC-WP05.2: KyberPolyAdd
// ============================================================
fn testKyberPolyAdd(): int64 {
  var a: int64 := NTTPolyNew();
  var b: int64 := NTTPolyNew();
  var c: int64 := NTTPolyNew();
  fillPoly(a, 0x111);
  fillPoly(b, 0x222);
  KyberPolyAdd(a, b, c);
  // Erwarte: c[i] = (a[i] + b[i]) mod 3329
  var ok: int64 := 1;
  var i: int64 := 0;
  while (i < 256) {
    var expected: int64 := peek64(a+i*8) + peek64(b+i*8);
    expected := expected - (expected/3329)*3329;
    if (peek64(c+i*8) != expected) { ok := 0; }
    i := i+1;
  }
  NTTPolyFree(a); NTTPolyFree(b); NTTPolyFree(c);
  if (ok == 1) { PrintLn("OK: KyberPolyAdd korrekt mod 3329 (WP-05.2)"); return 0; }
  PrintLn("FAIL: KyberPolyAdd falsch (WP-05.2)");
  return 1;
}

// ============================================================
// AC-WP05.3: KyberPolySub
// ============================================================
fn testKyberPolySub(): int64 {
  var a: int64 := NTTPolyNew();
  var b: int64 := NTTPolyNew();
  var c: int64 := NTTPolyNew();
  fillPoly(a, 0x333);
  fillPoly(b, 0x444);
  KyberPolySub(a, b, c);
  var ok: int64 := 1;
  var i: int64 := 0;
  while (i < 256) {
    var expected: int64 := peek64(a+i*8) - peek64(b+i*8) + 3329;
    expected := expected - (expected/3329)*3329;
    if (peek64(c+i*8) != expected) { ok := 0; }
    i := i+1;
  }
  NTTPolyFree(a); NTTPolyFree(b); NTTPolyFree(c);
  if (ok == 1) { PrintLn("OK: KyberPolySub korrekt mod 3329 (WP-05.3)"); return 0; }
  PrintLn("FAIL: KyberPolySub falsch (WP-05.3)");
  return 1;
}

// ============================================================
// AC-WP05.4: KyberSampleCBD — Koeffizienten in [0, q)
// ============================================================
fn testKyberSampleCBD(): int64 {
  var prf: int64 := alloc(192);  // 64*3 = 192 Bytes für eta=3
  var f: int64 := NTTPolyNew();
  // Fülle prf mit bekannten Bytes
  var i: int64 := 0;
  while (i < 192) { poke8(prf+i, i & 0xFF); i := i+1; }
  KyberSampleCBD(prf, 2, f);
  var ok: int64 := 1;
  i := 0;
  while (i < 256) {
    var c: int64 := peek64(f+i*8);
    // Koeffizient muss ∈ [0, 3329): ursprünglich a-b ∈ [-2,2], nach +q und mod q ∈ {0,1,2,3327,3328}
    if (c < 0) { ok := 0; }
    if (c >= 3329) { ok := 0; }
    // Muss ∈ {0,1,2,3327,3328} für eta=2
    var valid: int64 := 0;
    if (c == 0) { valid := 1; }
    if (c == 1) { valid := 1; }
    if (c == 2) { valid := 1; }
    if (c == 3327) { valid := 1; }
    if (c == 3328) { valid := 1; }
    if (valid == 0) { ok := 0; }
    i := i+1;
  }
  NTTPolyFree(f); free(prf, 192);
  if (ok == 1) { PrintLn("OK: KyberSampleCBD Koeffizienten in [0,q) (WP-05.4)"); return 0; }
  PrintLn("FAIL: KyberSampleCBD ungueltige Koeffizienten (WP-05.4)");
  return 1;
}

// ============================================================
// AC-WP05.5: DilithiumNTT → DilithiumINTT Roundtrip
// ============================================================
fn testDilithiumNTTRoundtrip(): int64 {
  var f: int64 := NTTPolyNew();
  var g: int64 := NTTPolyNew();
  fillPolyDilith(f, 0xCAFEBABE);
  var i: int64 := 0;
  while (i < 2048) { poke8(g+i, peek8(f+i)); i := i+1; }
  DilithiumNTT(f);
  DilithiumINTT(f);
  var ok: int64 := polyEqual(f, g, 8380417);
  NTTPolyFree(f); NTTPolyFree(g);
  if (ok == 1) { PrintLn("OK: DilithiumNTT->DilithiumINTT Roundtrip (WP-05.5)"); return 0; }
  PrintLn("FAIL: DilithiumNTT->DilithiumINTT Roundtrip (WP-05.5)");
  return 1;
}

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testKyberNTTRoundtrip();
  failed := failed + testKyberPolyAdd();
  failed := failed + testKyberPolySub();
  failed := failed + testKyberSampleCBD();
  failed := failed + testDilithiumNTTRoundtrip();
  if (failed != 0) { PrintLn("FAILED"); return 1; }
  PrintLn("ALL PASSED");
  return 0;
}
