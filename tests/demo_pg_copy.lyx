// demo_pg_copy.lyx — WP-PG-12 Demo 4: COPY IN Bulk-Insert vs. Einzel-INSERT
//
// Vergleicht COPY IN gegen Einzel-INSERTs (je 10.000 Rows).
// Zeigt Dauer beider Methoden. COPY sollte deutlich schneller sein.

import std.db.postgres;

extern fn sys_clock_gettime(clockid: int64, tp: pchar): int64;

fn intToStr(val: int64, buf: int64): int64 {
  if (val == 0) { poke8(buf, 48); poke8(buf + 1, 0); return 1; }
  var tmp: int64 := mmap(0, 24, 3, 34, -1, 0);
  var n: int64 := val; var pos: int64 := 0;
  while (n > 0) { poke8(tmp + pos, (n % 10) + 48); n := n / 10; pos := pos + 1; }
  var out: int64 := 0;
  var j: int64 := pos - 1;
  while (j >= 0) { poke8(buf + out, peek8(tmp + j)); out := out + 1; j := j - 1; }
  poke8(buf + out, 0); munmap(tmp, 24); return out;
}

fn nowMs(): int64 {
  var ts: int64 := mmap(0, 16, 3, 34, -1, 0);
  sys_clock_gettime(1, ts as pchar);
  var ms: int64 := peek64(ts) * 1000 + peek64(ts + 8) / 1000000;
  munmap(ts, 16);
  return ms;
}

fn connect(): int64 {
  var probe: int64 := pgProbe("127.0.0.1"c, 5432, "postgres"c, "postgres"c);
  if (probe == 0) { PrintStr("SKIP: PostgreSQL not available\n"); return 0; }
  var conn: int64 := PGConnect("127.0.0.1"c, 5432, "postgres"c, ""c, "postgres"c);
  if (conn == 0) { PrintStr("SKIP: TCP error\n"); return 0; }
  if (PGIsConnected(conn) == 0) {
    if (PGErrno(conn) == PG_ERR_PROTO) { PrintStr("SKIP: unsupported auth (need trust/md5)\n"); }
    else { PrintStr("SKIP: not connected\n"); }
    PGClose(conn); return 0;
  }
  return conn;
}

pub fn main(): int64 {
  var conn: int64 := connect();
  if (conn == 0) { return 0; }

  var r0: int64 := PGQuery(conn, "DROP TABLE IF EXISTS pg_demo_copy"c);
  if (r0 != 0) { PGFreeResult(r0); }
  var r1: int64 := PGQuery(conn, "CREATE TABLE pg_demo_copy (id INT, val TEXT)"c);
  if (r1 == 0) { PrintStr("FAIL: CREATE\n"); PGClose(conn); return 1; }
  PGFreeResult(r1);

  var N: int64 := 10000;

  // --- COPY IN ---
  var t0: int64 := nowMs();
  if (PGCopyBegin(conn, "pg_demo_copy"c, "id,val"c) == 0) {
    PrintStr("FAIL: CopyBegin\n"); PGClose(conn); return 1;
  }
  var vals: int64 := mmap(0, 2 * 8, 3, 34, -1, 0);
  var idBuf: int64 := mmap(0, 24, 3, 34, -1, 0);
  var i: int64 := 0;
  while (i < N) {
    var idLen: int64 := intToStr(i, idBuf);
    poke8(idBuf + idLen, 0);
    poke64(vals,     idBuf);
    poke64(vals + 8, "x"c as int64);
    PGCopyRow(conn, vals, 2);
    i := i + 1;
  }
  munmap(vals, 16); munmap(idBuf, 24);
  PGCopyEnd(conn);
  var t1: int64 := nowMs();
  var copyMs: int64 := t1 - t0;

  var rCnt: int64 := PGQuery(conn, "SELECT COUNT(*) FROM pg_demo_copy"c);
  if (rCnt == 0) { PrintStr("FAIL: COUNT after COPY\n"); PGClose(conn); return 1; }
  PGFetchRow(rCnt);
  var copyCnt: int64 := PGGetInt(rCnt, 0);
  PGFreeResult(rCnt);

  // Clear table
  var rDel: int64 := PGQuery(conn, "DELETE FROM pg_demo_copy"c);
  if (rDel != 0) { PGFreeResult(rDel); }

  // --- Einzel-INSERTs ---
  var stmt: int64 := PGStmtPrepare(conn, "ins_copy_cmp"c,
    "INSERT INTO pg_demo_copy VALUES ($1, $2)"c);
  if (stmt == 0) { PrintStr("FAIL: prepare single\n"); PGClose(conn); return 1; }

  var t2: int64 := nowMs();
  i := 0;
  while (i < N) {
    PGStmtReset(stmt);
    PGBindInt(stmt, 0, i);
    PGBindStr(stmt, 1, "x"c);
    var ri: int64 := PGStmtExecute(conn, stmt);
    if (ri != 0) { PGFreeResult(ri); }
    i := i + 1;
  }
  var t3: int64 := nowMs();
  var singleMs: int64 := t3 - t2;

  PGStmtClose(conn, "ins_copy_cmp"c);
  PGStmtFree(stmt);

  var rCnt2: int64 := PGQuery(conn, "SELECT COUNT(*) FROM pg_demo_copy"c);
  if (rCnt2 == 0) { PrintStr("FAIL: COUNT after single\n"); PGClose(conn); return 1; }
  PGFetchRow(rCnt2);
  var singleCnt: int64 := PGGetInt(rCnt2, 0);
  PGFreeResult(rCnt2);

  PrintStr("COPY IN:   "); PrintInt(N); PrintStr(" rows in "); PrintInt(copyMs); PrintStr(" ms\n");
  PrintStr("Single INSERT: "); PrintInt(N); PrintStr(" rows in "); PrintInt(singleMs); PrintStr(" ms\n");
  if (singleMs > 0) {
    PrintStr("Speedup: ~"); PrintInt(singleMs / copyMs); PrintStr("x\n");
  }
  if (copyCnt != N) {
    PrintStr("FAIL: COPY count = "); PrintInt(copyCnt); PrintStr("\n");
    PGClose(conn); return 1;
  }
  if (singleCnt != N) {
    PrintStr("FAIL: single count = "); PrintInt(singleCnt); PrintStr("\n");
    PGClose(conn); return 1;
  }

  var rDrop: int64 := PGQuery(conn, "DROP TABLE pg_demo_copy"c);
  if (rDrop != 0) { PGFreeResult(rDrop); }
  PGClose(conn);
  PrintStr("OK\n");
  return 0;
}
