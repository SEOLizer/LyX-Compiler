// tests/csv_test.lyx
// Selbstpruefende Testbatterie fuer std.csv.
//
// Die Testdateien schreibt der Test selbst, damit er von keinem Datenbestand
// abhaengt. Geprueft wird am INHALT der Felder, nicht an ihrer Zahl: eine
// Pruefung auf "drei Spalten erkannt" waere auch von einem Parser erfuellt,
// der an der falschen Stelle trennt.
//
// Jeder Abweisungsfall wird einzeln ausgeloest und sein Schluessel gelesen --
// "ging nicht" ist keine Aussage.

unit main;

import std.csv;
import std.string;
import std.math;
import std.alloc;
import std.fs;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn Check(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > tol) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" (bool)\n"c);
  }
}

fn CheckS(name: pchar, got: pchar, want: pchar): void {
  _checks := _checks + 1;
  if (got == 0 as pchar) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" (Zeiger 0)\n"c);
    return;
  }
  if (StrCmp(got, want) != 0) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got=["c);
    PrintStr(got);
    PrintStr("] want=["c);
    PrintStr(want);
    PrintStr("]\n"c);
  }
}

fn CheckNull(name: pchar, got: pchar): void {
  _checks := _checks + 1;
  if (got != 0 as pchar) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" (Zeiger nicht 0)\n"c);
  }
}

fn SVf(p: int64, i: int64, v: f64): void {
  pokef64(p + i * 8, v);
}

fn NEGf(x: f64): f64 { return 0.0 - x; }

fn PV(p: int64, i: int64): f64 {
  var v: f64 := peekf64(p + i * 8);
  return v;
}

// Datei mit genau diesem Inhalt anlegen
fn Schreib(pfad: pchar, inhalt: pchar): bool {
  var n: int64 := StrLen(inhalt);
  var w: int64 := WriteFile(pfad, inhalt, n);
  if (w != n) { return false; }
  return true;
}

fn P1(): pchar { return "/tmp/csv_test_komma.csv"c; }
fn P2(): pchar { return "/tmp/csv_test_semi.csv"c; }
fn P3(): pchar { return "/tmp/csv_test_spalten.txt"c; }
fn P4(): pchar { return "/tmp/csv_test_zackig.csv"c; }
fn P5(): pchar { return "/tmp/csv_test_offen.csv"c; }
fn P6(): pchar { return "/tmp/csv_test_crlf.csv"c; }
fn P7(): pchar { return "/tmp/csv_test_leer.csv"c; }

fn main(): int64 {
  // ── Komma mit Kopfzeile ───────────────────────────────────────────────────

  CheckB("schreib1"c,
         Schreib(P1(), "a,b,c\n1,2,3\n4,5,6\n7,8,9\n"c), true);
  var t1: int64 := CsvOpenCsv(P1(), true);
  CheckB("open1"c, t1 != 0, true);
  CheckI("err1"c, CsvError(), CSV_OK);
  CheckI("rows1"c, CsvRowCount(t1), 3);
  CheckI("cols1"c, CsvColCount(t1), 3);
  CheckB("hasHdr1"c, CsvHasHeader(t1), true);
  CheckI("hdrCount1"c, CsvHeaderCount(t1), 3);
  CheckS("hdr0"c, CsvHeader(t1, 0), "a"c);
  CheckS("hdr2"c, CsvHeader(t1, 2), "c"c);
  CheckNull("hdrOob"c, CsvHeader(t1, 3));
  CheckI("colIdxB"c, CsvColumnIndex(t1, "b"c), 1);
  CheckI("colIdxUnknown"c, CsvColumnIndex(t1, "zzz"c), -1);
  // Inhalte feldweise -- nicht nur die Zahl der Felder
  CheckS("f00"c, CsvField(t1, 0, 0), "1"c);
  CheckS("f01"c, CsvField(t1, 0, 1), "2"c);
  CheckS("f12"c, CsvField(t1, 1, 2), "6"c);
  CheckS("f20"c, CsvField(t1, 2, 0), "7"c);
  CheckNull("fRowOob"c, CsvField(t1, 3, 0));
  CheckNull("fColOob"c, CsvField(t1, 0, 3));
  CheckB("notRagged"c, CsvIsRagged(t1), false);
  var okBox: int64 := alloc(8);
  Check("float12"c, CsvFloat(t1, 1, 2, okBox), 6.0, 0.000000001);
  CheckI("floatOk"c, peek64(okBox), 1);
  CheckI("int20"c, CsvInt(t1, 2, 0, okBox), 7);
  CheckI("intOk"c, peek64(okBox), 1);
  // Zugriff ausserhalb: ok bleibt 0 und der Schluessel sagt, warum
  var dummy: f64 := CsvFloat(t1, 9, 0, okBox);
  CheckI("floatOobOk"c, peek64(okBox), 0);
  CheckI("floatOobErr"c, CsvError(), CSV_E_RANGE);

  // ── Semikolon mit Anfuehrungszeichen ──────────────────────────────────────
  //
  // Trennzeichen IM Feld, verdoppeltes Anfuehrungszeichen, Leerraum um die
  // Felder. Hier faellt ein Parser auf, der stumpf an jedem Semikolon trennt.

  CheckB("schreib2"c,
         Schreib(P2(),
           "name;wert;bem\n\"Mueller, Hans\"; 42 ;\"sagt \"\"hallo\"\"\"\n\"a;b;c\";7;x\n"c),
         true);
  var t2: int64 := CsvOpen(P2(), CSV_SEP_SEMICOLON, CSV_QUOTE_DOUBLE,
                           CSV_NO_COMMENT, true);
  CheckB("open2"c, t2 != 0, true);
  CheckI("rows2"c, CsvRowCount(t2), 2);
  CheckI("cols2"c, CsvColCount(t2), 3);
  CheckS("quotedComma"c, CsvField(t2, 0, 0), "Mueller, Hans"c);
  CheckS("trimmed"c, CsvField(t2, 0, 1), "42"c);
  CheckS("doubledQuote"c, CsvField(t2, 0, 2), "sagt \"hallo\""c);
  CheckS("quotedSeps"c, CsvField(t2, 1, 0), "a;b;c"c);
  CheckS("afterQuoted"c, CsvField(t2, 1, 1), "7"c);
  Check("quotedFloat"c, CsvFloat(t2, 0, 1, okBox), 42.0, 0.000000001);

  // ── Spalten mit Leerraum, Kommentare, Fehlend-Marke ───────────────────────

  CheckB("schreib3"c,
         Schreib(P3(),
           "# Kopf des Datensatzes\nmpg zyl ps\n18.0   8   130.0\n15.0\t8\t?\n\n24.0 4 95.0\n"c),
         true);
  var t3: int64 := CsvOpen(P3(), CSV_SEP_WHITESPACE, CSV_QUOTE_DOUBLE,
                           CSV_COMMENT_HASH, true);
  CheckB("open3"c, t3 != 0, true);
  CheckS("wsHdr0"c, CsvHeader(t3, 0), "mpg"c);
  CheckI("wsRows"c, CsvRowCount(t3), 3);
  CheckI("wsCols"c, CsvColCount(t3), 3);
  // Mehrfache Leerzeichen und Tabulatoren sind EIN Trenner
  CheckS("wsField"c, CsvField(t3, 0, 2), "130.0"c);
  CheckS("tabField"c, CsvField(t3, 1, 1), "8"c);
  Check("wsFloat"c, CsvFloat(t3, 2, 2, okBox), 95.0, 0.000000001);
  // Leerzeile wird nicht zur Zeile
  CheckS("afterBlank"c, CsvField(t3, 2, 0), "24.0"c);
  // Fehlend-Marke
  CheckB("missBeforeSet"c, CsvIsMissing(t3, 1, 2), false);
  CheckB("setMissing"c, CsvSetMissing(t3, "?"c), true);
  CheckB("missAfterSet"c, CsvIsMissing(t3, 1, 2), true);
  CheckB("notMissing"c, CsvIsMissing(t3, 1, 1), false);
  var d2: f64 := CsvFloat(t3, 1, 2, okBox);
  CheckI("missFloatOk"c, peek64(okBox), 0);
  CheckI("missFloatErr"c, CsvError(), CSV_E_MISSING);
  CheckB("missLeer"c, CsvSetMissing(t3, ""c), false);
  // Ohne Kommentarzeichen wird die Kommentarzeile zur Kopfzeile -- geprueft,
  // weil CsvOpenWhitespace genau das tut (ein geratenes Kommentarzeichen
  // wuerde stillschweigend Datenzeilen verwerfen)
  var t3b: int64 := CsvOpenWhitespace(P3(), true);
  CheckB("open3b"c, t3b != 0, true);
  CheckS("noCommentHdr"c, CsvHeader(t3b, 0), "#"c);
  CheckI("noCommentRows"c, CsvRowCount(t3b), 4);
  CsvFree(t3b);

  // ── Zackige Tabelle ───────────────────────────────────────────────────────

  CheckB("schreib4"c, Schreib(P4(), "1,2,3\n4,5\n6,7,8,9\n"c), true);
  var t4: int64 := CsvOpenCsv(P4(), false);
  CheckB("open4"c, t4 != 0, true);
  CheckB("noHdr"c, CsvHasHeader(t4), false);
  CheckI("hdrCountNoHdr"c, CsvHeaderCount(t4), 0);
  CheckNull("hdrNoHdr"c, CsvHeader(t4, 0));
  CheckI("raggedRows"c, CsvRowCount(t4), 3);
  CheckI("raggedCols"c, CsvColCount(t4), 4);
  CheckB("isRagged"c, CsvIsRagged(t4), true);
  CheckI("len0"c, CsvRowFieldCount(t4, 0), 3);
  CheckI("len1"c, CsvRowFieldCount(t4, 1), 2);
  CheckI("len2"c, CsvRowFieldCount(t4, 2), 4);
  // Erste Zeile ist hier DATEN, nicht Kopf
  CheckS("noHdrFirst"c, CsvField(t4, 0, 0), "1"c);
  // hinter dem Ende einer kurzen Zeile: fehlt, statt leer zu sein
  CheckNull("shortRow"c, CsvField(t4, 1, 2));
  CheckB("shortRowMissing"c, CsvIsMissing(t4, 1, 2), true);
  // kurze Zeile = fehlendes Feld; Zeile oder Spalte, die es nicht gibt =
  // Aufruffehler. Beide Faelle einzeln, sonst waere der Unterschied Zierde.
  CheckI("stateShort"c, CsvFieldState(t4, 1, 2), CSV_E_MISSING);
  CheckI("stateOk"c, CsvFieldState(t4, 1, 1), CSV_OK);
  CheckI("stateRowOob"c, CsvFieldState(t4, 9, 0), CSV_E_RANGE);
  CheckI("stateColOob"c, CsvFieldState(t4, 0, 9), CSV_E_RANGE);
  var kurz: f64 := CsvFloat(t4, 1, 2, okBox);
  CheckI("shortFloatOk"c, peek64(okBox), 0);
  CheckI("shortFloatErr"c, CsvError(), CSV_E_MISSING);

  // ── Zahlenmatrix ──────────────────────────────────────────────────────────

  var cols: int64 := alloc(2 * 8);
  poke64(cols + 0, 0);
  poke64(cols + 8, 2);
  var M: int64 := alloc(8 * 8);
  // t4 Zeile 1 hat keine Spalte 2 -> strikt scheitert
  CheckI("matrixStrict"c, CsvToMatrix(t4, cols, 2, M, 8), -1);
  CheckI("matrixStrictErr"c, CsvError(), CSV_E_MISSING);
  var skipBox: int64 := alloc(8);
  CheckI("usableCount"c, CsvUsableRowCount(t4, cols, 2), 2);
  CheckI("matrixSkip"c, CsvToMatrixSkip(t4, cols, 2, M, 8, skipBox), 2);
  CheckI("skipped"c, peek64(skipBox), 1);
  Check("mat00"c, PV(M, 0), 1.0, 0.000000001);
  Check("mat01"c, PV(M, 1), 3.0, 0.000000001);
  Check("mat10"c, PV(M, 2), 6.0, 0.000000001);
  Check("mat11"c, PV(M, 3), 8.0, 0.000000001);
  // Zielpuffer zu klein wird gemeldet, nicht ueberschrieben
  CheckI("matrixTight"c, CsvToMatrixSkip(t4, cols, 2, M, 1, skipBox), -1);
  CheckI("matrixTightErr"c, CsvError(), CSV_E_SPACE);
  CheckI("matrixStrictTight"c, CsvToMatrix(t1, cols, 2, M, 2), -1);
  CheckI("matrixStrictTightErr"c, CsvError(), CSV_E_SPACE);
  // saubere Tabelle: strikt geht durch
  CheckI("matrixClean"c, CsvToMatrix(t1, cols, 2, M, 8), 3);
  Check("cleanMat00"c, PV(M, 0), 1.0, 0.000000001);
  Check("cleanMat21"c, PV(M, 5), 9.0, 0.000000001);
  // Nullargumente
  CheckI("matrixNullOut"c, CsvToMatrix(t1, cols, 2, 0, 8), -1);
  CheckI("matrixNullOutErr"c, CsvError(), CSV_E_ARGS);
  CheckI("matrixNullCols"c, CsvToMatrix(t1, 0, 2, M, 8), -1);

  // Eine Spalte mit Text ist keine Zahl -- und wird gemeldet
  var colText: int64 := alloc(8);
  poke64(colText, 0);
  CheckI("textMatrix"c, CsvToMatrix(t2, colText, 1, M, 8), -1);
  CheckI("textMatrixErr"c, CsvError(), CSV_E_NUMBER);
  CheckB("textRowUnusable"c, CsvRowUsable(t2, 0, colText, 1), false);

  // ── CRLF und fehlender Zeilenumbruch am Ende ──────────────────────────────

  CheckB("schreib6"c, Schreib(P6(), "a,b\r\n1,2\r\n3,4"c), true);
  var t6: int64 := CsvOpenCsv(P6(), true);
  CheckB("open6"c, t6 != 0, true);
  CheckI("crlfRows"c, CsvRowCount(t6), 2);
  CheckS("crlfHdr"c, CsvHeader(t6, 1), "b"c);
  CheckS("crlfF01"c, CsvField(t6, 0, 1), "2"c);
  // letzte Zeile ohne Umbruch
  CheckS("lastNoNewline"c, CsvField(t6, 1, 1), "4"c);
  Check("crlfFloat"c, CsvFloat(t6, 1, 0, okBox), 3.0, 0.000000001);
  CheckI("crlfOk"c, peek64(okBox), 1);

  // ── Abweisungen ───────────────────────────────────────────────────────────

  // offenes Anfuehrungszeichen
  CheckB("schreib5"c, Schreib(P5(), "a,b\n\"offen,2\n"c), true);
  CheckI("openQuote"c, CsvOpenCsv(P5(), true), 0);
  CheckI("openQuoteErr"c, CsvError(), CSV_E_QUOTE);
  // fehlende Datei
  CheckI("missingFile"c, CsvOpenCsv("/tmp/csv_test_gibtsnicht.csv"c, true), 0);
  CheckI("missingFileErr"c, CsvError(), CSV_E_FILE);
  // leere Datei
  CheckB("schreib7"c, Schreib(P7(), ""c), true);
  CheckI("emptyFile"c, CsvOpenCsv(P7(), true), 0);
  CheckI("emptyFileErr"c, CsvError(), CSV_E_FILE);
  // Pfad 0
  CheckI("nullPath"c, CsvOpenCsv(0 as pchar, true), 0);
  CheckI("nullPathErr"c, CsvError(), CSV_E_ARGS);
  // Abfragen auf einem 0-Handle
  CheckI("rowsNull"c, CsvRowCount(0), 0);
  CheckI("colsNull"c, CsvColCount(0), 0);
  CheckNull("fieldNull"c, CsvField(0, 0, 0));
  CheckB("missingNull"c, CsvIsMissing(0, 0, 0), true);

  CsvFree(t1);
  CsvFree(t2);
  CsvFree(t3);
  CsvFree(t4);
  CsvFree(t6);
  DeleteFile(P1());
  DeleteFile(P2());
  DeleteFile(P3());
  DeleteFile(P4());
  DeleteFile(P5());
  DeleteFile(P6());
  DeleteFile(P7());

  // ── Schreiben ─────────────────────────────────────────────────────────────

  CheckI("wNewSepWs"c, CsvWriterNew(CSV_SEP_WHITESPACE, CSV_QUOTE_DOUBLE, false), 0);
  CheckI("wNewSepWsErr"c, CsvError(), CSV_E_ARGS);
  CheckI("wNewSepNl"c, CsvWriterNew(10, CSV_QUOTE_DOUBLE, false), 0);
  CheckI("wNewSepEqQuote"c, CsvWriterNew(34, 34, false), 0);
  CheckI("wNewAlwaysNoQuote"c, CsvWriterNew(CSV_SEP_COMMA, CSV_NO_QUOTE, true), 0);

  var w: int64 := CsvWriterNew(CSV_SEP_COMMA, CSV_QUOTE_DOUBLE, false);
  CheckB("wNew"c, w != 0, true);
  CheckI("wRows0"c, CsvWriterRowCount(w), 0);
  CheckI("wLen0"c, CsvWriterLen(w), 0);
  // Leere Zeile wird abgelehnt: beim Einlesen verschwindet sie wieder
  CheckB("wEmptyRow"c, CsvEndRow(w), false);
  CheckI("wEmptyRowErr"c, CsvError(), CSV_E_EMPTYROW);

  // Anfuehrungszeichen genau dann, wenn sie gebraucht werden -- und NICHT,
  // wenn nicht. Ohne die Gegenseite waere der Test auch von einem Schreiber
  // erfuellt, der alles einpackt.
  CheckB("wPlain"c, CsvWriteField(w, "abc"c), true);
  CheckB("wSep"c, CsvWriteField(w, "a,b"c), true);
  CheckB("wQuote"c, CsvWriteField(w, "sagt \"hallo\""c), true);
  CheckB("wNewline"c, CsvWriteField(w, "zwei\nzeilen"c), true);
  CheckB("wLead"c, CsvWriteField(w, " vorn"c), true);
  CheckB("wTrail"c, CsvWriteField(w, "hinten "c), true);
  CheckB("wEmpty"c, CsvWriteField(w, ""c), true);
  CheckI("wPending"c, CsvWriterPendingFields(w), 7);
  CheckB("wEnd"c, CsvEndRow(w), true);
  CheckI("wRows1"c, CsvWriterRowCount(w), 1);
  CheckI("wPendingAfter"c, CsvWriterPendingFields(w), 0);
  CheckS("wLine"c, CsvWriterData(w) as pchar,
         "abc,\"a,b\",\"sagt \"\"hallo\"\"\",\"zwei\nzeilen\",\" vorn\",\"hinten \",\n"c);

  // Zahlen
  CheckB("wInt"c, CsvWriteInt(w, -42), true);
  CheckB("wFloat3"c, CsvWriteFloat(w, 3.14159, 3), true);
  CheckB("wFloat0"c, CsvWriteFloat(w, 2.5, 0), true);
  CheckB("wFloatNegDec"c, CsvWriteFloat(w, 1.0, -1), false);
  CheckI("wFloatNegDecErr"c, CsvError(), CSV_E_ARGS);
  // NaN und Unendlich gehoeren nicht in eine Zahlenspalte
  var riesig: f64 := 1.7976931348623157e308;
  var zwei: f64 := 2.0;
  CheckB("wInf"c, CsvWriteFloat(w, riesig * zwei, 2), false);
  CheckI("wInfErr"c, CsvError(), CSV_E_NUMBER);
  CheckB("wEnd2"c, CsvEndRow(w), true);

  // Fehlend: ohne Marke leer, mit Marke die Marke
  CheckB("wMiss1"c, CsvWriteMissing(w), true);
  CheckB("wSetMiss"c, CsvWriterSetMissing(w, "NA"c), true);
  CheckB("wMiss2"c, CsvWriteMissing(w), true);
  CheckB("wEnd3"c, CsvEndRow(w), true);

  // Offene Zeile verhindert das Sichern -- sonst entscheidet der Schreiber,
  // wo die Tabelle endet
  CheckB("wOpenField"c, CsvWriteField(w, "offen"c), true);
  CheckI("wSaveOpen"c, CsvWriterSave(w, "/tmp/csv_test_w1.csv"c), -1);
  CheckI("wSaveOpenErr"c, CsvError(), CSV_E_EMPTYROW);
  CheckB("wEnd4"c, CsvEndRow(w), true);
  var geschrieben: int64 := CsvWriterSave(w, "/tmp/csv_test_w1.csv"c);
  CheckI("wSave"c, geschrieben, CsvWriterLen(w));
  CheckI("wSaveFile"c, FileSize("/tmp/csv_test_w1.csv"c), geschrieben);
  CheckI("wSaveNullPath"c, CsvWriterSave(w, 0 as pchar), -1);

  // Rundlauf: was geschrieben wurde, muss feldweise zurueckkommen
  var tw: int64 := CsvOpenCsv("/tmp/csv_test_w1.csv"c, false);
  CheckB("wReopen"c, tw != 0, true);
  CheckI("wReRows"c, CsvRowCount(tw), 4);
  CheckS("wRe00"c, CsvField(tw, 0, 0), "abc"c);
  CheckS("wRe01"c, CsvField(tw, 0, 1), "a,b"c);
  CheckS("wRe02"c, CsvField(tw, 0, 2), "sagt \"hallo\""c);
  CheckS("wRe03"c, CsvField(tw, 0, 3), "zwei\nzeilen"c);
  CheckS("wRe04"c, CsvField(tw, 0, 4), " vorn"c);
  CheckS("wRe05"c, CsvField(tw, 0, 5), "hinten "c);
  CheckB("wRe06Missing"c, CsvIsMissing(tw, 0, 6), true);
  CheckS("wRe10"c, CsvField(tw, 1, 0), "-42"c);
  CheckS("wRe11"c, CsvField(tw, 1, 1), "3.142"c);
  CheckS("wRe12"c, CsvField(tw, 1, 2), "3"c);
  CheckB("wRe20Missing"c, CsvIsMissing(tw, 2, 0), true);
  CheckS("wRe21"c, CsvField(tw, 2, 1), "NA"c);
  CheckB("wSetMissRead"c, CsvSetMissing(tw, "NA"c), true);
  CheckB("wRe21Missing"c, CsvIsMissing(tw, 2, 1), true);
  CsvFree(tw);
  CsvWriterFree(w);

  // ── quoteAlways und CRLF ──────────────────────────────────────────────────

  var w2: int64 := CsvWriterNew(CSV_SEP_SEMICOLON, CSV_QUOTE_DOUBLE, true);
  CheckB("w2New"c, w2 != 0, true);
  CsvWriterSetCrlf(w2, true);
  CheckB("w2F1"c, CsvWriteField(w2, "x"c), true);
  CheckB("w2F2"c, CsvWriteInt(w2, 7), true);
  CheckB("w2End"c, CsvEndRow(w2), true);
  CheckS("w2Line"c, CsvWriterData(w2) as pchar, "\"x\";\"7\"\r\n"c);
  // und wieder einlesbar
  CheckI("w2Save"c, CsvWriterSave(w2, "/tmp/csv_test_w2.csv"c),
         CsvWriterLen(w2));
  var t2b: int64 := CsvOpen("/tmp/csv_test_w2.csv"c, CSV_SEP_SEMICOLON,
                            CSV_QUOTE_DOUBLE, CSV_NO_COMMENT, false);
  CheckI("w2ReRows"c, CsvRowCount(t2b), 1);
  CheckS("w2Re00"c, CsvField(t2b, 0, 0), "x"c);
  CheckS("w2Re01"c, CsvField(t2b, 0, 1), "7"c);
  CsvFree(t2b);
  CsvWriterFree(w2);

  // ── Zeilen aus Zeichenketten, Matrix, Kurzform ────────────────────────────

  var namen: int64 := alloc(3 * 8);
  poke64(namen + 0, "spalte a"c as int64);
  poke64(namen + 8, "b;b"c as int64);
  poke64(namen + 16, "c"c as int64);
  var w3: int64 := CsvWriterNew(CSV_SEP_COMMA, CSV_QUOTE_DOUBLE, false);
  CheckB("w3Row"c, CsvWriteRowStrings(w3, namen, 3), true);
  CheckI("w3Rows"c, CsvWriterRowCount(w3), 1);
  CheckB("w3NullNames"c, CsvWriteRowStrings(w3, 0, 3), false);
  // Matrix
  var MM: int64 := alloc(6 * 8);
  SVf(MM, 0, 1.5);   SVf(MM, 1, NEGf(2.25)); SVf(MM, 2, 3.0);
  SVf(MM, 3, 4.125); SVf(MM, 4, 0.0);        SVf(MM, 5, NEGf(0.5));
  CheckB("w3Matrix"c, CsvWriteMatrix(w3, MM, 2, 3, 4), true);
  CheckI("w3RowsAfter"c, CsvWriterRowCount(w3), 3);
  CheckI("w3Save"c, CsvWriterSave(w3, "/tmp/csv_test_w3.csv"c),
         CsvWriterLen(w3));
  CsvWriterFree(w3);

  // Rundlauf der Zahlen: dieselbe Matrix muss zurueckkommen
  var t3c: int64 := CsvOpenCsv("/tmp/csv_test_w3.csv"c, true);
  CheckB("w3Reopen"c, t3c != 0, true);
  CheckS("w3Hdr0"c, CsvHeader(t3c, 0), "spalte a"c);
  CheckS("w3Hdr1"c, CsvHeader(t3c, 1), "b;b"c);
  CheckI("w3ReRows"c, CsvRowCount(t3c), 2);
  var colsAll: int64 := alloc(3 * 8);
  poke64(colsAll + 0, 0);
  poke64(colsAll + 8, 1);
  poke64(colsAll + 16, 2);
  var MB: int64 := alloc(6 * 8);
  CheckI("w3Matrix back"c, CsvToMatrix(t3c, colsAll, 3, MB, 2), 2);
  var worst: f64 := 0.0;
  var wi: int64 := 0;
  while (wi < 6) {
    var d: f64 := AbsF64(PV(MM, wi) - PV(MB, wi));
    if (d > worst) { worst := d; }
    wi := wi + 1;
  }
  Check("w3RoundTrip"c, worst, 0.0, 0.00001);
  CsvFree(t3c);

  // Kurzform mit Kopfzeile
  var kurzLen: int64 := CsvSaveMatrix("/tmp/csv_test_w4.csv"c, MM, 2, 3, 4,
                                      CSV_SEP_TAB, namen);
  CheckB("saveMatrix"c, kurzLen > 0, true);
  CheckI("saveMatrixSize"c, FileSize("/tmp/csv_test_w4.csv"c), kurzLen);
  var t4b: int64 := CsvOpen("/tmp/csv_test_w4.csv"c, CSV_SEP_TAB,
                            CSV_QUOTE_DOUBLE, CSV_NO_COMMENT, true);
  CheckB("saveMatrixReopen"c, t4b != 0, true);
  CheckI("saveMatrixRows"c, CsvRowCount(t4b), 2);
  CheckS("saveMatrixHdr2"c, CsvHeader(t4b, 2), "c"c);
  Check("saveMatrixVal"c, CsvFloat(t4b, 1, 2, okBox), NEGf(0.5), 0.00001);
  CheckI("saveMatrixOk"c, peek64(okBox), 1);
  CsvFree(t4b);
  // Kurzform mit unbrauchbarer Angabe
  CheckI("saveMatrixBadSep"c,
         CsvSaveMatrix("/tmp/csv_test_w5.csv"c, MM, 2, 3, 4,
                       CSV_SEP_WHITESPACE, 0), -1);

  DeleteFile("/tmp/csv_test_w1.csv"c);
  DeleteFile("/tmp/csv_test_w2.csv"c);
  DeleteFile("/tmp/csv_test_w3.csv"c);
  DeleteFile("/tmp/csv_test_w4.csv"c);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
