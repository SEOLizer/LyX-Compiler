// WP-PDF-04: graphics primitives — colors, paths, transformations

@description("WP-PDF-04: graphics primitives test")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pdf_graphics_test;

import std.pdf;

fn testRect(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }
  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);

  // Blue filled rectangle
  PdfSetFillColor(doc, page, 0.0, 0.4, 0.8);
  PdfRect(doc, page, 72.0, 72.0, 200.0, 100.0);
  PdfFill(doc, page);

  // Red stroked rectangle
  PdfSetStrokeColor(doc, page, 1.0, 0.0, 0.0);
  PdfSetLineWidth(doc, page, 2.0);
  PdfRect(doc, page, 300.0, 72.0, 150.0, 80.0);
  PdfStroke(doc, page);

  // Green filled+stroked rectangle
  PdfSetFillColor(doc, page, 0.0, 0.7, 0.0);
  PdfSetStrokeColor(doc, page, 0.0, 0.3, 0.0);
  PdfSetLineWidth(doc, page, 1.0);
  PdfRect(doc, page, 72.0, 200.0, 100.0, 60.0);
  PdfFillStroke(doc, page);

  var err: int64 := PdfSave(doc, "/tmp/pdf_rect.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave rect\n"); return 1; }
  Print("OK: rect PDF saved to /tmp/pdf_rect.pdf\n");
  return 0;
}

fn testLine(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }
  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);

  // Solid red line
  PdfSetStrokeColor(doc, page, 1.0, 0.0, 0.0);
  PdfSetLineWidth(doc, page, 2.0);
  PdfSetLineCap(doc, page, 1);
  PdfMoveTo(doc, page, 72.0, 500.0);
  PdfLineTo(doc, page, 400.0, 500.0);
  PdfStroke(doc, page);

  // Dashed blue line
  PdfSetStrokeColor(doc, page, 0.0, 0.0, 1.0);
  PdfSetLineWidth(doc, page, 1.5);
  PdfSetDash(doc, page, 10.0, 5.0);
  PdfMoveTo(doc, page, 72.0, 480.0);
  PdfLineTo(doc, page, 400.0, 480.0);
  PdfStroke(doc, page);

  // Reset dash to solid
  PdfSetDash(doc, page, 0.0, 0.0);
  PdfSetStrokeColor(doc, page, 0.0, 0.5, 0.0);
  PdfSetLineWidth(doc, page, 3.0);
  PdfSetLineCap(doc, page, 2);
  PdfSetLineJoin(doc, page, 1);
  PdfMoveTo(doc, page, 72.0, 460.0);
  PdfLineTo(doc, page, 200.0, 440.0);
  PdfLineTo(doc, page, 328.0, 460.0);
  PdfStroke(doc, page);

  var err: int64 := PdfSave(doc, "/tmp/pdf_line.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave line\n"); return 1; }
  Print("OK: line PDF saved to /tmp/pdf_line.pdf\n");
  return 0;
}

