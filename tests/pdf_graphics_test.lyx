  return 0;
}

fn testSaveRestore(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }
  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);

  // Red context
  PdfSetFillColor(doc, page, 1.0, 0.0, 0.0);
  PdfRect(doc, page, 72.0, 700.0, 50.0, 50.0);
  PdfFill(doc, page);

  // Save, override to blue, restore → back to red (viewer handles state)
  PdfSaveState(doc, page);
  PdfSetFillColor(doc, page, 0.0, 0.0, 1.0);
  PdfSetLineWidth(doc, page, 4.0);
  PdfRect(doc, page, 140.0, 700.0, 50.0, 50.0);
  PdfFill(doc, page);
  PdfRestoreState(doc, page);

  // After restore: fill should be red again
  PdfRect(doc, page, 208.0, 700.0, 50.0, 50.0);
  PdfFill(doc, page);

  var err: int64 := PdfSave(doc, "/tmp/pdf_state.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave state\n"); return 1; }
  Print("OK: state PDF saved to /tmp/pdf_state.pdf\n");
  return 0;
}

fn testTransform(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }
  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);

  // Translate and draw
  PdfSaveState(doc, page);
  PdfTranslate(doc, page, 200.0, 400.0);
  PdfSetFillColor(doc, page, 0.2, 0.6, 0.2);
  PdfRect(doc, page, 0.0, 0.0, 80.0, 40.0);
  PdfFill(doc, page);
  PdfRestoreState(doc, page);

  // Scale and draw
  PdfSaveState(doc, page);
  PdfTranslate(doc, page, 72.0, 350.0);
  PdfScale(doc, page, 2.0, 1.0);
  PdfSetFillColor(doc, page, 0.6, 0.2, 0.6);
  PdfRect(doc, page, 0.0, 0.0, 50.0, 30.0);
  PdfFill(doc, page);
  PdfRestoreState(doc, page);

  // Rotate 45° and draw
  PdfSaveState(doc, page);
  PdfTranslate(doc, page, 300.0, 300.0);
  PdfRotate(doc, page, 45.0);
  PdfSetFillColor(doc, page, 0.8, 0.6, 0.0);
  PdfRect(doc, page, 0.0, 0.0, 60.0, 60.0);
  PdfFill(doc, page);
  PdfRestoreState(doc, page);

  var err: int64 := PdfSave(doc, "/tmp/pdf_transform.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave transform\n"); return 1; }
  Print("OK: transform PDF saved to /tmp/pdf_transform.pdf\n");
  return 0;
}

fn testCMYK(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }
  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);

  // Pure cyan fill (CMYK: 1 0 0 0)
  PdfSetFillColorCMYK(doc, page, 1.0, 0.0, 0.0, 0.0);
  PdfRect(doc, page, 72.0, 650.0, 80.0, 50.0);
  PdfFill(doc, page);

  // Pure magenta stroke
  PdfSetStrokeColorCMYK(doc, page, 0.0, 1.0, 0.0, 0.0);
  PdfSetLineWidth(doc, page, 3.0);
  PdfRect(doc, page, 170.0, 650.0, 80.0, 50.0);
  PdfStroke(doc, page);

  var err: int64 := PdfSave(doc, "/tmp/pdf_cmyk.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave cmyk\n"); return 1; }
  Print("OK: CMYK PDF saved to /tmp/pdf_cmyk.pdf\n");
  return 0;
}

fn testRotation(): int64 {
  // Verify sin/cos values at key angles
  // sin(0) = 0, cos(0) = 100 (×100)
  // sin(90) = 100, cos(90) = 0
  // sin(180) = 0, cos(180) = -100
  // sin(270) = -100, cos(270) = 0

  // We can verify by checking the cm operator output in the PDF
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }
  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);

  // 0° rotation = identity
  PdfSaveState(doc, page);
  PdfTranslate(doc, page, 100.0, 400.0);
  PdfRotate(doc, page, 0.0);
  PdfSetFillColor(doc, page, 1.0, 0.0, 0.0);
  PdfRect(doc, page, 0.0, 0.0, 50.0, 20.0);
  PdfFill(doc, page);
  PdfRestoreState(doc, page);

  // 90° rotation
  PdfSaveState(doc, page);
  PdfTranslate(doc, page, 200.0, 400.0);
  PdfRotate(doc, page, 90.0);
  PdfSetFillColor(doc, page, 0.0, 0.0, 1.0);
  PdfRect(doc, page, 0.0, 0.0, 50.0, 20.0);
  PdfFill(doc, page);
  PdfRestoreState(doc, page);

  // 30° rotation
  PdfSaveState(doc, page);
  PdfTranslate(doc, page, 300.0, 400.0);
  PdfRotate(doc, page, 30.0);
  PdfSetFillColor(doc, page, 0.0, 0.6, 0.0);
  PdfRect(doc, page, 0.0, 0.0, 50.0, 20.0);
  PdfFill(doc, page);
  PdfRestoreState(doc, page);

  var err: int64 := PdfSave(doc, "/tmp/pdf_rotate.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave rotate\n"); return 1; }
  Print("OK: rotation PDF saved to /tmp/pdf_rotate.pdf\n");
  return 0;
}

pub fn main(): int64 {
  if (testRect()        != 0) { return 1; }
  if (testLine()        != 0) { return 1; }
  if (testCircle()      != 0) { return 1; }
  if (testSaveRestore() != 0) { return 1; }
  if (testTransform()   != 0) { return 1; }
  if (testCMYK()        != 0) { return 1; }
  if (testRotation()    != 0) { return 1; }
  Print("All WP-PDF-04 graphics tests passed.\n");
  return 0;
}
