// tests/method_result_dispatch_test.lyx — Methodenaufruf auf einem Aufruf-Ergebnis.
//
// `t.Trim().ByteLength()` scheiterte mit
//   error: undefined function 'ByteLength' — no codegen implementation found
// weil cg_objClassIdx für einen Aufruf als Empfänger -1 lieferte: der Aufruf
// wurde ungemangelt emittiert und fand beim Patchen kein Ziel.
//
// Die Klassenauflösung selbst gab es bereits (cg_exprClassName + fnRet-Registry,
// in der freie Funktionen UND Methoden stehen) — sie wurde an dieser Stelle nur
// nicht benutzt. Da sie sich für den Empfänger rekursiv aufruft, funktionieren
// auch Ketten und freie Funktionen mit class-Rückgabe als Empfänger.
//
// Mitgeprüft: Operatoren auf einem Methoden-Ergebnis (`a.M() == b`, `a.M()[i]`),
// die damit ebenfalls auflösen — ebnf.md §15.3 ist entsprechend angepasst.

import std.io;
import std.text;
import std.strtype;

var fails: int64 := 0;

fn expect(name: pchar, got: int64, want: int64) {
  Print(name); Print(": ");
  if (got == want) {
    PrintLn("OK");
  } else {
    Print("FAIL got="); PrintInt(got); Print(" want="); PrintInt(want); PrintLn("");
    fails += 1;
  }
}

fn main(): int64 {
  var padded: Text := TextFromPchar("  hi  ");

  // --- Methodenaufruf auf Methoden-Ergebnis ---
  expect("Trim().ByteLength()", padded.Trim().ByteLength(), 2);
  expect("Trim().CodepointCount()", padded.Trim().CodepointCount(), 2);

  var t: Text := TextFromPchar("hello world");
  expect("SubstringCp().ByteLength()", t.SubstringCp(0, 5).ByteLength(), 5);
  expect("AsciiUpper().ByteAt(0)", t.AsciiUpper().ByteAt(0), 72);

  // --- freie Funktion mit class-Rückgabe als Empfänger ---
  expect("TextFromPchar().ByteLength()", TextFromPchar("abc").ByteLength(), 3);

  // --- Kette über drei Stufen (rekursive Auflösung) ---
  expect("dreistufige Kette", padded.Trim().AsciiUpper().ByteLength(), 2);

  // --- dieselbe Mechanik auf der String-Klasse ---
  var s: String := StringFromPchar("apple");
  expect("Substring().Length()", s.Substring(0, 3).Length(), 3);
  expect("Add().Length()", s.Add(StringFromPchar("!")).Length(), 6);

  // --- Operatoren auf einem Methoden-Ergebnis ---
  var hi: Text := TextFromPchar("hi");
  var eq: int64 := 0;
  if (padded.Trim() == hi) { eq := 1; }
  expect("Methodenergebnis ==", eq, 1);

  var ne: int64 := 0;
  if (padded.Trim() != t) { ne := 1; }
  expect("Methodenergebnis !=", ne, 1);

  expect("Methodenergebnis [i]", padded.Trim()[0], 104);   // 'h'

  // --- Zwischenvariable muss weiter funktionieren (alter Workaround) ---
  var tr: Text := padded.Trim();
  expect("via Zwischenvariable", tr.ByteLength(), 2);

  if (fails == 0) { PrintLn("ALL OK"); return 0; }
  PrintLn("FAILURES");
  return 1;
}
