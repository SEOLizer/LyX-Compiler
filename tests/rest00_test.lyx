// tests/rest00_test.lyx — REST-00: RestClient unit tests (no network)
//
// Tests URL parsing, path building, query string construction,
// status code helpers, auth header wiring, and client lifecycle.
// All tests are network-independent.

unit tests.rest00_test;

import std.net.rest;
import std.net.http;
import std.alloc;
import std.io;

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Test 1: RestClientInit — HTTPS URL → useHttps=1, host, basePath
    // -------------------------------------------------------------------------
    var c1: int64 := alloc(REST_SIZE);
    var url1: pchar := "https://api.example.com/v1"c;
    RestClientInit(c1, url1 as int64, 0);

    var https1: int64 := peek64(c1 + REST_OFF_HTTPS);
    if (https1 != 1) { PrintLn("FAIL: HTTPS URL → useHttps != 1"c); ok := 0; }
    else              { PrintLn("PASS: HTTPS URL → useHttps=1"c); }

    var host1: int64 := peek64(c1 + REST_OFF_HOST);
    var hlen1: int64 := peek64(c1 + REST_OFF_HOSTLEN);
    if (hlen1 != 15) { PrintLn("FAIL: HTTPS host len != 15"c); ok := 0; }
    else              { PrintLn("PASS: HTTPS host len=15"c); }

    // Check host bytes = "api.example.com"
    var hostOk: int64 := 1;
    var expHost: pchar := "api.example.com"c;
    var hi: int64 := 0;
    while (hi < 15) {
        if (peek8(host1 + hi) != StrCharAt(expHost, hi)) { hostOk := 0; }
        hi := hi + 1;
    }
    if (hostOk != 1) { PrintLn("FAIL: HTTPS host bytes wrong"c); ok := 0; }
    else              { PrintLn("PASS: HTTPS host = api.example.com"c); }

    // basePath should be "/v1"
    var path1: int64 := peek64(c1 + REST_OFF_BASEPATH);
    var plen1: int64 := peek64(c1 + REST_OFF_PATHLEN);
    if (plen1 != 3) { PrintLn("FAIL: basePath len != 3"c); ok := 0; }
    else             { PrintLn("PASS: basePath len=3"c); }
    if (peek8(path1) != 0x2F || peek8(path1+1) != 0x76 || peek8(path1+2) != 0x31) {
        PrintLn("FAIL: basePath != /v1"c); ok := 0;
    } else {
        PrintLn("PASS: basePath = /v1"c);
    }

    RestClientFree(c1);
    free(c1, REST_SIZE);

    // -------------------------------------------------------------------------
    // Test 2: RestClientInit — HTTP URL without path → useHttps=0, basePath="/"
    // -------------------------------------------------------------------------
    var c2: int64 := alloc(REST_SIZE);
    var url2: pchar := "http://localhost"c;
    RestClientInit(c2, url2 as int64, 0);

    var https2: int64 := peek64(c2 + REST_OFF_HTTPS);
    if (https2 != 0) { PrintLn("FAIL: HTTP URL → useHttps != 0"c); ok := 0; }
    else              { PrintLn("PASS: HTTP URL → useHttps=0"c); }

    var path2: int64 := peek64(c2 + REST_OFF_BASEPATH);
    if (peek8(path2) != 0x2F) { PrintLn("FAIL: no-path basePath != /"c); ok := 0; }
    else                       { PrintLn("PASS: no-path basePath=/"c); }

    RestClientFree(c2);
    free(c2, REST_SIZE);

    // -------------------------------------------------------------------------
    // Test 3: RestBuildPath — basePath="/v1", path="/users" → "/v1/users"
    // -------------------------------------------------------------------------
    var c3: int64 := alloc(REST_SIZE);
    var url3: pchar := "https://api.example.com/v1"c;
    RestClientInit(c3, url3 as int64, 0);

    var out3: int64 := alloc(256);
    var path3: pchar := "/users"c;
    var len3: int64 := RestBuildPath(c3, path3 as int64, out3, 256);
    // expect "/v1/users" → length 9, no double slash
    if (len3 != 9) { PrintLn("FAIL: RestBuildPath len != 9"c); ok := 0; }
    else            { PrintLn("PASS: RestBuildPath len=9"c); }

    var exp3: pchar := "/v1/users"c;
    var path3ok: int64 := 1;
    var pi: int64 := 0;
    while (pi < 9) {
        if (peek8(out3 + pi) != StrCharAt(exp3, pi)) { path3ok := 0; }
        pi := pi + 1;
    }
    if (path3ok != 1) { PrintLn("FAIL: RestBuildPath result != /v1/users"c); ok := 0; }
    else               { PrintLn("PASS: RestBuildPath = /v1/users"c); }

    free(out3, 256);
    RestClientFree(c3);
    free(c3, REST_SIZE);

    // -------------------------------------------------------------------------
    // Test 4: RestBuildPath — double-slash dedup: basePath="/v1/", path="/users"
    // -------------------------------------------------------------------------
    var c4: int64 := alloc(REST_SIZE);
    var url4: pchar := "https://api.example.com/v1/"c;
    RestClientInit(c4, url4 as int64, 0);

    var out4: int64 := alloc(256);
    var p4: pchar := "/users"c;
    var len4: int64 := RestBuildPath(c4, p4 as int64, out4, 256);
    // "/v1/" + "/users" → dedup → "/v1/users" (len=9)
    if (len4 != 9) { PrintLn("FAIL: dedup double-slash len != 9"c); ok := 0; }
    else            { PrintLn("PASS: dedup double-slash len=9"c); }
    if (peek8(out4+4) != 0x75) { PrintLn("FAIL: dedup result[4] != u"c); ok := 0; }
    else                        { PrintLn("PASS: dedup no double-slash"c); }

    free(out4, 256);
    RestClientFree(c4);
    free(c4, REST_SIZE);

    // -------------------------------------------------------------------------
    // Test 5: RestQueryAppend — first param → '?', second → '&'
    // -------------------------------------------------------------------------
    var qbuf: int64 := alloc(512);
    // Seed with "/search\0"
    poke8(qbuf,   0x2F); poke8(qbuf+1, 0x73); poke8(qbuf+2, 0x65);
    poke8(qbuf+3, 0x61); poke8(qbuf+4, 0x72); poke8(qbuf+5, 0x63);
    poke8(qbuf+6, 0x68); poke8(qbuf+7, 0);

    var qk1: pchar := "q"c;
    var qv1: pchar := "hello"c;
    var ql1: int64 := RestQueryAppend(qbuf, 512, qk1 as int64, qv1 as int64);
    // expect "/search?q=hello" → 15
    if (ql1 != 15) { PrintLn("FAIL: first query param len != 15"c); ok := 0; }
    else            { PrintLn("PASS: first query param len=15"c); }
    if (peek8(qbuf + 7) != 0x3F) { PrintLn("FAIL: separator should be ?"c); ok := 0; }
    else                           { PrintLn("PASS: first param sep=?"c); }

    var qk2: pchar := "page"c;
    var qv2: pchar := "2"c;
    var ql2: int64 := RestQueryAppend(qbuf, 512, qk2 as int64, qv2 as int64);
    // expect "/search?q=hello&page=2" → 22
    if (ql2 != 22) { PrintLn("FAIL: second query param len != 22"c); ok := 0; }
    else            { PrintLn("PASS: second query param len=22"c); }
    if (peek8(qbuf + 15) != 0x26) { PrintLn("FAIL: second separator should be &"c); ok := 0; }
    else                            { PrintLn("PASS: second param sep=&"c); }

    free(qbuf, 512);

    // -------------------------------------------------------------------------
    // Test 6: RestQueryAppend — percent-encoding of unsafe chars
    // -------------------------------------------------------------------------
    var pbuf: int64 := alloc(256);
    poke8(pbuf, 0);  // empty string to start
    var pk: pchar := "msg"c;
    var pv: pchar := "hello world"c;
    RestQueryAppend(pbuf, 256, pk as int64, pv as int64);
    // expect "?msg=hello%20world"
    // ?msg=hello = 10 chars → '%' at index 10, '2' at 11, '0' at 12
    if (peek8(pbuf+10) != 0x25) { PrintLn("FAIL: percent-encode '%' missing"c); ok := 0; }
    else                         { PrintLn("PASS: percent-encode '%' present"c); }
    if (peek8(pbuf+11) != 0x32 || peek8(pbuf+12) != 0x30) {
        PrintLn("FAIL: percent-encode 20 wrong"c); ok := 0;
    } else {
        PrintLn("PASS: space → %20"c);
    }
    free(pbuf, 256);

    // -------------------------------------------------------------------------
    // Test 7: RestIsSuccess / RestIsClientError / RestIsServerError
    // -------------------------------------------------------------------------
    if (RestIsSuccess(200) != 1)     { PrintLn("FAIL: 200 not success"c); ok := 0; }
    else                              { PrintLn("PASS: 200 is success"c); }
    if (RestIsSuccess(204) != 1)     { PrintLn("FAIL: 204 not success"c); ok := 0; }
    else                              { PrintLn("PASS: 204 is success"c); }
    if (RestIsSuccess(299) != 1)     { PrintLn("FAIL: 299 not success"c); ok := 0; }
    else                              { PrintLn("PASS: 299 is success"c); }
    if (RestIsSuccess(300) != 0)     { PrintLn("FAIL: 300 should not be success"c); ok := 0; }
    else                              { PrintLn("PASS: 300 not success"c); }

    if (RestIsClientError(400) != 1) { PrintLn("FAIL: 400 not client error"c); ok := 0; }
    else                              { PrintLn("PASS: 400 is client error"c); }
    if (RestIsClientError(404) != 1) { PrintLn("FAIL: 404 not client error"c); ok := 0; }
    else                              { PrintLn("PASS: 404 is client error"c); }
    if (RestIsClientError(499) != 1) { PrintLn("FAIL: 499 not client error"c); ok := 0; }
    else                              { PrintLn("PASS: 499 is client error"c); }
    if (RestIsClientError(500) != 0) { PrintLn("FAIL: 500 should not be client error"c); ok := 0; }
    else                              { PrintLn("PASS: 500 not client error"c); }

    if (RestIsServerError(500) != 1) { PrintLn("FAIL: 500 not server error"c); ok := 0; }
    else                              { PrintLn("PASS: 500 is server error"c); }
    if (RestIsServerError(503) != 1) { PrintLn("FAIL: 503 not server error"c); ok := 0; }
    else                              { PrintLn("PASS: 503 is server error"c); }
    if (RestIsServerError(200) != 0) { PrintLn("FAIL: 200 should not be server error"c); ok := 0; }
    else                              { PrintLn("PASS: 200 not server error"c); }

    // -------------------------------------------------------------------------
    // Test 8: RestClientSetBearerToken — authHdrs becomes non-zero
    // -------------------------------------------------------------------------
    var c8: int64 := alloc(REST_SIZE);
    var url8: pchar := "http://api.test.local/v2"c;
    RestClientInit(c8, url8 as int64, 0);

    var ah8before: int64 := peek64(c8 + REST_OFF_AUTHHDRS);
    if (ah8before != 0) { PrintLn("FAIL: initial authHdrs should be 0"c); ok := 0; }
    else                 { PrintLn("PASS: initial authHdrs=0"c); }

    var tok8: pchar := "my-secret-token"c;
    RestClientSetBearerToken(c8, tok8 as int64);
    var ah8after: int64 := peek64(c8 + REST_OFF_AUTHHDRS);
    if (ah8after == 0) { PrintLn("FAIL: authHdrs still 0 after SetBearerToken"c); ok := 0; }
    else                { PrintLn("PASS: authHdrs non-zero after SetBearerToken"c); }

    RestClientFree(c8);
    free(c8, REST_SIZE);

    // -------------------------------------------------------------------------
    // Test 9: RestClientSetApiKey — authHdrs becomes non-zero
    // -------------------------------------------------------------------------
    var c9: int64 := alloc(REST_SIZE);
    var url9: pchar := "http://api.test.local"c;
    RestClientInit(c9, url9 as int64, 0);

    var hdrName: pchar := "X-API-Key"c;
    var hdrVal:  pchar := "key-abc-123"c;
    RestClientSetApiKey(c9, hdrName as int64, hdrVal as int64);
    var ah9: int64 := peek64(c9 + REST_OFF_AUTHHDRS);
    if (ah9 == 0) { PrintLn("FAIL: authHdrs still 0 after SetApiKey"c); ok := 0; }
    else           { PrintLn("PASS: authHdrs non-zero after SetApiKey"c); }

    RestClientFree(c9);
    free(c9, REST_SIZE);

    // -------------------------------------------------------------------------
    // Test 10: RestClientInit with token → authHdrs non-zero from init
    // -------------------------------------------------------------------------
    var c10: int64 := alloc(REST_SIZE);
    var url10: pchar := "https://api.example.com"c;
    var tok10: pchar := "init-token"c;
    RestClientInit(c10, url10 as int64, tok10 as int64);
    var ah10: int64 := peek64(c10 + REST_OFF_AUTHHDRS);
    if (ah10 == 0) { PrintLn("FAIL: authHdrs 0 when token passed to init"c); ok := 0; }
    else            { PrintLn("PASS: authHdrs set by init token"c); }

    RestClientFree(c10);
    free(c10, REST_SIZE);

    // -------------------------------------------------------------------------
    // Test 11: RestClientFree — struct zeroed after free
    // -------------------------------------------------------------------------
    var c11: int64 := alloc(REST_SIZE);
    var url11: pchar := "https://api.example.com/api"c;
    RestClientInit(c11, url11 as int64, 0);
    RestClientFree(c11);
    var zeroOk: int64 := 1;
    var zi: int64 := 0;
    while (zi < REST_SIZE) {
        if (peek8(c11 + zi) != 0) { zeroOk := 0; }
        zi := zi + 1;
    }
    if (zeroOk != 1) { PrintLn("FAIL: struct not zeroed after Free"c); ok := 0; }
    else              { PrintLn("PASS: struct zeroed after Free"c); }
    free(c11, REST_SIZE);

    if (ok != 0) { PrintLn("=== REST-00: ALL PASS ==="c); }
    else         { PrintLn("=== REST-00: SOME FAIL ==="c); }
    return ok;
}
