// tests/sat_test.lyx
// Selbstpruefende Testbatterie fuer std.sat.
//
// Sollwerte aus Python, dessen Ganzzahlen unbegrenzt sind — damit laesst sich
// das exakte Ergebnis bilden und anschliessend saettigen, ohne selbst in den
// Ueberlauf zu geraten. Die Randfaelle stehen zusaetzlich einzeln da, weil
// gerade sie in Zufallsproben selten getroffen werden.

unit main;

import std.sat;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" (bool)\n"c);
  }
}

fn main(): int64 {
  var mx: int64 := SatI64Max();
  var mn: int64 := SatI64Min();
  var m1: int64 := 0 - 1;

  // ── Grenzen ───────────────────────────────────────────────────────────────
  CheckI("i64max"c, mx, 9223372036854775807);
  CheckI("i64min"c, mn, 0 - 9223372036854775807 - 1);
  CheckI("i32max"c, SatI32Max(), 2147483647);
  CheckI("i32min"c, SatI32Min(), 0 - 2147483648);
  CheckI("i16max"c, SatI16Max(), 32767);
  CheckI("i8min"c, SatI8Min(), 0 - 128);
  CheckI("u8max"c, SatU8Max(), 255);
  CheckI("u32max"c, SatU32Max(), 4294967295);
  // der Wertebereich ist unsymmetrisch: |MIN| ist um eins groesser als MAX
  CheckI("asymmetric"c, mx + mn, 0 - 1);

  // ── Ueberlauf erkennen ────────────────────────────────────────────────────
  CheckB("addNoOvf"c, SatAddOverflows(1, 2), false);
  CheckB("addOvfMax"c, SatAddOverflows(mx, 1), true);
  CheckB("addOvfMaxMax"c, SatAddOverflows(mx, mx), true);
  CheckB("addNoOvfEdge"c, SatAddOverflows(mx, 0), false);
  CheckB("addOvfMin"c, SatAddOverflows(mn, m1), true);
  CheckB("addNoOvfMinPos"c, SatAddOverflows(mn, 1), false);
  CheckB("addMinMax"c, SatAddOverflows(mn, mx), false);

  CheckB("subNoOvf"c, SatSubOverflows(5, 3), false);
  CheckB("subOvfMin"c, SatSubOverflows(mn, 1), true);
  CheckB("subOvfMax"c, SatSubOverflows(mx, m1), true);
  CheckB("subNoOvfEdge"c, SatSubOverflows(mx, 0), false);
  // a - INT64_MIN laeuft ueber, sobald a positiv ist
  CheckB("subMinOperand"c, SatSubOverflows(1, mn), true);
  CheckB("subMinFromMin"c, SatSubOverflows(mn, mn), false);

  CheckB("mulNoOvf"c, SatMulOverflows(1000, 1000), false);
  CheckB("mulOvf"c, SatMulOverflows(3037000500, 3037000500), true);
  CheckB("mulZero"c, SatMulOverflows(0, mn), false);
  CheckB("mulOne"c, SatMulOverflows(1, mn), false);
  // DIESE beiden Faelle bringen SafeMul aus std.result zum Absturz —
  // hier muessen sie ohne SIGFPE erkannt werden
  CheckB("mulMinByNegOne"c, SatMulOverflows(mn, m1), true);
  CheckB("mulNegOneByMin"c, SatMulOverflows(m1, mn), true);
  CheckB("mulNegOneOther"c, SatMulOverflows(m1, 5), false);
  CheckB("mulMaxByNegOne"c, SatMulOverflows(mx, m1), false);

  CheckB("divNoOvf"c, SatDivOverflows(10, 2), false);
  CheckB("divOvf"c, SatDivOverflows(mn, m1), true);
  CheckB("divMaxNegOne"c, SatDivOverflows(mx, m1), false);
  CheckB("negOvf"c, SatNegOverflows(mn), true);
  CheckB("negNoOvf"c, SatNegOverflows(mx), false);

  // ── Gepruefte Rechnung ────────────────────────────────────────────────────
  var out: int64 := alloc(8);
  poke64(out, 12345);

  CheckB("addCheckedOk"c, SatAddChecked(2, 3, out), true);
  CheckI("addCheckedVal"c, peek64(out), 5);
  // bei Ueberlauf bleibt out unberuehrt
  poke64(out, 999);
  CheckB("addCheckedOvf"c, SatAddChecked(mx, 1, out), false);
  CheckI("addCheckedUntouched"c, peek64(out), 999);

  CheckB("subCheckedOk"c, SatSubChecked(10, 3, out), true);
  CheckI("subCheckedVal"c, peek64(out), 7);
  CheckB("mulCheckedOk"c, SatMulChecked(6, 7, out), true);
  CheckI("mulCheckedVal"c, peek64(out), 42);
  CheckB("mulCheckedOvf"c, SatMulChecked(m1, mn, out), false);

  CheckB("divCheckedOk"c, SatDivChecked(10, 3, out), true);
  CheckI("divCheckedVal"c, peek64(out), 3);
  CheckB("divCheckedZero"c, SatDivChecked(10, 0, out), false);
  CheckB("divCheckedOvf"c, SatDivChecked(mn, m1, out), false);
  // out = 0 ist erlaubt und verwirft das Ergebnis
  CheckB("checkedNullOut"c, SatAddChecked(1, 2, 0), true);
  free(out, 8);

  // ── Saettigung ────────────────────────────────────────────────────────────
  CheckI("satAddNormal"c, SatAdd(2, 3), 5);
  CheckI("satAddMax"c, SatAdd(mx, 1), mx);
  CheckI("satAddMaxMax"c, SatAdd(mx, mx), mx);
  CheckI("satAddMin"c, SatAdd(mn, m1), mn);
  CheckI("satAddMinMin"c, SatAdd(mn, mn), mn);
  CheckI("satAddMixed"c, SatAdd(mn, mx), m1);

  CheckI("satSubNormal"c, SatSub(10, 3), 7);
  CheckI("satSubMin"c, SatSub(mn, 1), mn);
  CheckI("satSubMax"c, SatSub(mx, m1), mx);
  CheckI("satSubFromMin"c, SatSub(1, mn), mx);

  CheckI("satMulNormal"c, SatMul(6, 7), 42);
  CheckI("satMulOvfPos"c, SatMul(3037000500, 3037000500), mx);
  // negatives Produkt klemmt nach unten
  CheckI("satMulOvfNeg"c, SatMul(3037000500, 0 - 3037000500), mn);
  CheckI("satMulMinNegOne"c, SatMul(mn, m1), mx);
  CheckI("satMulNegOneMin"c, SatMul(m1, mn), mx);
  CheckI("satMulZero"c, SatMul(0, mn), 0);
  // zwei negative Faktoren ergeben ein positives Produkt
  CheckI("satMulBothNeg"c, SatMul(0 - 3037000500, 0 - 3037000500), mx);

  CheckI("satDivNormal"c, SatDiv(10, 3), 3);
  CheckI("satDivOvf"c, SatDiv(mn, m1), mx);
  CheckI("satDivZero"c, SatDiv(5, 0), 0);
  CheckI("satDivNeg"c, SatDiv(0 - 10, 3), 0 - 3);

  CheckI("satNeg"c, SatNeg(5), 0 - 5);
  CheckI("satNegMin"c, SatNeg(mn), mx);
  CheckI("satNegMax"c, SatNeg(mx), 0 - mx);
  CheckI("satAbs"c, SatAbs(0 - 5), 5);
  CheckI("satAbsMin"c, SatAbs(mn), mx);
  CheckI("satAbsPos"c, SatAbs(7), 7);

  // ── Klemmen ───────────────────────────────────────────────────────────────
  CheckI("clampInside"c, SatClamp(5, 0, 10), 5);
  CheckI("clampLow"c, SatClamp(0 - 5, 0, 10), 0);
  CheckI("clampHigh"c, SatClamp(50, 0, 10), 10);
  CheckI("clampEdgeLo"c, SatClamp(0, 0, 10), 0);
  CheckI("clampEdgeHi"c, SatClamp(10, 0, 10), 10);
  // vertauschte Grenzen werden getauscht, nicht stillschweigend uebernommen
  CheckI("clampSwapped"c, SatClamp(5, 10, 0), 5);
  CheckI("clampSwappedLow"c, SatClamp(0 - 5, 10, 0), 0);
  CheckB("inRange"c, SatInRange(5, 0, 10), true);
  CheckB("inRangeNo"c, SatInRange(50, 0, 10), false);

  // ── Breitenbegrenzung ─────────────────────────────────────────────────────
  CheckI("toU8High"c, SatToU8(300), 255);
  CheckI("toU8Low"c, SatToU8(0 - 5), 0);
  CheckI("toU8Inside"c, SatToU8(128), 128);
  CheckI("toI8High"c, SatToI8(200), 127);
  CheckI("toI8Low"c, SatToI8(0 - 200), 0 - 128);
  CheckI("toI16"c, SatToI16(40000), 32767);
  CheckI("toI32"c, SatToI32(3000000000), 2147483647);
  CheckI("toU16"c, SatToU16(70000), 65535);
  CheckI("toU32"c, SatToU32(0 - 1), 0);
  CheckI("toI32Min"c, SatToI32(mn), SatI32Min());

  CheckB("fitsU8"c, SatFitsU8(255), true);
  CheckB("fitsU8No"c, SatFitsU8(256), false);
  CheckB("fitsI8"c, SatFitsI8(0 - 128), true);
  CheckB("fitsI8No"c, SatFitsI8(0 - 129), false);
  CheckB("fitsI32"c, SatFitsI32(2147483647), true);
  CheckB("fitsI32No"c, SatFitsI32(2147483648), false);

  // ── Rechnen in fester Breite ──────────────────────────────────────────────
  // Der Bildverarbeitungsfall: heller machen darf nicht umschlagen
  CheckI("addU8Sat"c, SatAddU8(200, 100), 255);
  CheckI("addU8Normal"c, SatAddU8(100, 50), 150);
  CheckI("subU8Sat"c, SatSubU8(50, 100), 0);
  CheckI("subU8Normal"c, SatSubU8(200, 50), 150);
  CheckI("addI16Sat"c, SatAddI16(30000, 5000), 32767);
  CheckI("subI16Sat"c, SatSubI16(0 - 30000, 5000), 0 - 32768);

  // ── Umwandlung aus f64 ────────────────────────────────────────────────────
  var z: f64 := 0.0;
  var nan: f64 := z / z;
  var inf: f64 := 1.0 / z;

  CheckI("fromF64"c, SatFromF64(2.7), 2);
  CheckI("fromF64Neg"c, SatFromF64(0.0 - 2.7), 0 - 2);
  CheckI("fromF64Exact"c, SatFromF64(5.0), 5);
  CheckI("fromF64Zero"c, SatFromF64(0.0), 0);
  CheckI("fromF64NaN"c, SatFromF64(nan), 0);
  CheckI("fromF64Inf"c, SatFromF64(inf), mx);
  CheckI("fromF64NegInf"c, SatFromF64(0.0 - inf), mn);
  // jenseits des int64-Bereichs: klemmen statt Muell
  CheckI("fromF64Huge"c, SatFromF64(1000000000000000000000000000000.0), mx);
  CheckI("fromF64HugeNeg"c, SatFromF64(0.0 - 1000000000000000000000000000000.0), mn);

  CheckI("roundF64"c, SatRoundFromF64(2.5), 3);
  CheckI("roundF64Down"c, SatRoundFromF64(2.4), 2);
  CheckI("roundF64Neg"c, SatRoundFromF64(0.0 - 2.5), 0 - 3);
  CheckI("roundF64NaN"c, SatRoundFromF64(nan), 0);

  CheckI("clampedF64"c, SatFromF64Clamped(300.0, 0, 255), 255);
  CheckI("clampedF64Low"c, SatFromF64Clamped(0.0 - 5.0, 0, 255), 0);
  CheckI("clampedF64Inside"c, SatFromF64Clamped(127.6, 0, 255), 128);
  CheckI("clampedF64NaN"c, SatFromF64Clamped(nan, 0, 255), 0);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
