// tests/edi09_payment_test.lyx — EDI-09: Payment messages tests

unit tests.edi09_payment_test;

import std.edi.core;
import std.edi.payment;
import std.alloc;
import std.io;

fn hasTag(buf: int64, bufLen: int64, t0: int64, t1: int64, t2: int64): int64 {
    var i: int64 := 0;
    while (i + 2 < bufLen) {
        if (peek8(buf+i) == t0 && peek8(buf+i+1) == t1 && peek8(buf+i+2) == t2) { return 1; }
        i := i + 1;
    }
    return 0;
}

fn memEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
        if (peek8(a+i) != peek8(b+i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

fn zeroHdr(hdr: int64): int64 {
    var zi: int64 := 0;
    while (zi < EDI_PAY_HDR_SIZE) { poke8(hdr + zi, 0); zi := zi + 1; }
    return 0;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Tests 1-4: IBAN checksum (MOD 97)
    // -------------------------------------------------------------------------
    // DE44500105175407324931 — valid German IBAN
    if (EdiIbanCheck("DE44500105175407324931"c as int64, 22) != 1) {
        PrintLn("FAIL: DE44 IBAN should be valid"c); ok := 0;
    } else { PrintLn("PASS: EdiIbanCheck DE44... valid"c); }

    // DE00... — wrong check digits → invalid
    if (EdiIbanCheck("DE00500105175407324931"c as int64, 22) != 0) {
        PrintLn("FAIL: DE00 IBAN should be invalid"c); ok := 0;
    } else { PrintLn("PASS: EdiIbanCheck DE00... invalid"c); }

    // Too short → invalid
    if (EdiIbanCheck("DE4"c as int64, 3) != 0) {
        PrintLn("FAIL: short IBAN should be invalid"c); ok := 0;
    } else { PrintLn("PASS: EdiIbanCheck short → invalid"c); }

    // GB29NWBK60161331926819 — valid UK IBAN (22 chars)
    if (EdiIbanCheck("GB29NWBK60161331926819"c as int64, 22) != 1) {
        PrintLn("FAIL: GB29 IBAN should be valid"c); ok := 0;
    } else { PrintLn("PASS: EdiIbanCheck GB29... valid"c); }

    // -------------------------------------------------------------------------
    // Tests 5-7: BIC format validation
    // -------------------------------------------------------------------------
    if (EdiBicCheck("COBADEFF"c as int64, 8) != 1) {
        PrintLn("FAIL: COBADEFF (8-char BIC) should be valid"c); ok := 0;
    } else { PrintLn("PASS: EdiBicCheck COBADEFF (8-char) valid"c); }

    if (EdiBicCheck("COBADEFFXXX"c as int64, 11) != 1) {
        PrintLn("FAIL: COBADEFFXXX (11-char BIC) should be valid"c); ok := 0;
    } else { PrintLn("PASS: EdiBicCheck COBADEFFXXX (11-char) valid"c); }

    if (EdiBicCheck("COBADE"c as int64, 6) != 0) {
        PrintLn("FAIL: 6-char BIC should be invalid"c); ok := 0;
    } else { PrintLn("PASS: EdiBicCheck 6-char → invalid"c); }

    // -------------------------------------------------------------------------
    // Tests 8-14: REMADV — write/read/check, invoice ref validation
    // -------------------------------------------------------------------------
    var buf1: int64 := alloc(4096);
    var zi:   int64 := 0;
    while (zi < 4096) { poke8(buf1 + zi, 0); zi := zi + 1; }
    var hdr1: int64 := alloc(EDI_PAY_HDR_SIZE);
    zeroHdr(hdr1);
    poke64(hdr1 + EDI_PAY_HDR_REF,      "PAY-2026-001"c as int64);
    poke64(hdr1 + EDI_PAY_HDR_REFLEN,   12);
    poke64(hdr1 + EDI_PAY_HDR_DATE,     "20260615"c as int64);
    poke64(hdr1 + EDI_PAY_HDR_AMOUNT,   125000);
    poke64(hdr1 + EDI_PAY_HDR_CURRENCY, "EUR"c as int64);
    poke64(hdr1 + EDI_PAY_HDR_CURLEN,   3);
    poke64(hdr1 + EDI_PAY_HDR_CREDIBAN, "DE44500105175407324931"c as int64);
    poke64(hdr1 + EDI_PAY_HDR_CREDILEN, 22);
    poke64(hdr1 + EDI_PAY_HDR_BIC,      "COBADEFF"c as int64);
    poke64(hdr1 + EDI_PAY_HDR_BICLEN,   8);
    poke64(hdr1 + EDI_PAY_HDR_DEBTIBAN, "DE00500105175407000001"c as int64);
    poke64(hdr1 + EDI_PAY_HDR_DEBTILEN, 22);
    // No invoice ref yet

    // Test 8: REMADV without RFF+IV → EdiRemadvCheck = 1 (warn)
    if (EdiRemadvCheck(hdr1) != 1) {
        PrintLn("FAIL: REMADV without invoiceRef should warn (1)"c); ok := 0;
    } else { PrintLn("PASS: EdiRemadvCheck without ref = 1 (warn)"c); }

    // Add invoice ref
    poke64(hdr1 + EDI_PAY_HDR_INVOICEREF,  "INV-2026-005"c as int64);
    poke64(hdr1 + EDI_PAY_HDR_INVOICELEN, 12);

    // Test 9: REMADV with invoice ref → EdiRemadvCheck = 0 (ok)
    if (EdiRemadvCheck(hdr1) != 0) {
        PrintLn("FAIL: REMADV with invoiceRef should be ok (0)"c); ok := 0;
    } else { PrintLn("PASS: EdiRemadvCheck with ref = 0 (ok)"c); }

    var w1: int64 := EdiRemadvWrite(hdr1, buf1, 4096);
    if (w1 <= 0) {
        PrintLn("FAIL: EdiRemadvWrite should return > 0"c); ok := 0;
    } else { PrintLn("PASS: EdiRemadvWrite returns > 0"c); }

    // has BGM and FII tags
    if (hasTag(buf1, w1, 66, 71, 77) != 1) {
        PrintLn("FAIL: REMADV missing BGM tag"c); ok := 0;
    } else { PrintLn("PASS: REMADV has BGM tag"c); }
    if (hasTag(buf1, w1, 70, 73, 73) != 1) {
        PrintLn("FAIL: REMADV missing FII tag"c); ok := 0;
    } else { PrintLn("PASS: REMADV has FII tag"c); }

    var rhdr1: int64 := alloc(EDI_PAY_HDR_SIZE);
    zeroHdr(rhdr1);
    EdiRemadvRead(buf1, w1, rhdr1);

    // Test 13: bgmQual = 481
    if (peek64(rhdr1 + EDI_PAY_HDR_BGMQUAL) != EDI_PAY_BGM_REMADV) {
        PrintLn("FAIL: REMADV bgmQual should be 481"c); ok := 0;
    } else { PrintLn("PASS: REMADV bgmQual=481"c); }

    // Test 14: invoiceRef round-trip
    var rirp: int64 := peek64(rhdr1 + EDI_PAY_HDR_INVOICEREF);
    var rirl: int64 := peek64(rhdr1 + EDI_PAY_HDR_INVOICELEN);
    if (memEq(rirp, rirl, "INV-2026-005"c as int64, 12) != 1) {
        PrintLn("FAIL: REMADV invoiceRef mismatch"c); ok := 0;
    } else { PrintLn("PASS: REMADV invoiceRef=INV-2026-005"c); }

    free(rhdr1, EDI_PAY_HDR_SIZE);
    free(hdr1, EDI_PAY_HDR_SIZE);
    free(buf1, 4096);

    // -------------------------------------------------------------------------
    // Tests 15-18: DIRDEB — mandate ref validation + round-trip
    // -------------------------------------------------------------------------
    var buf2: int64 := alloc(4096);
    zi := 0;
    while (zi < 4096) { poke8(buf2 + zi, 0); zi := zi + 1; }
    var hdr2: int64 := alloc(EDI_PAY_HDR_SIZE);
    zeroHdr(hdr2);
    poke64(hdr2 + EDI_PAY_HDR_AMOUNT,   50000);
    poke64(hdr2 + EDI_PAY_HDR_CURRENCY, "EUR"c as int64);
    poke64(hdr2 + EDI_PAY_HDR_CURLEN,   3);
    poke64(hdr2 + EDI_PAY_HDR_CREDIBAN, "DE44500105175407324931"c as int64);
    poke64(hdr2 + EDI_PAY_HDR_CREDILEN, 22);

    // Test 15: DIRDEB without mandate ref → 2 (err)
    if (EdiDirdebCheck(hdr2) != 2) {
        PrintLn("FAIL: DIRDEB without mandateRef should err (2)"c); ok := 0;
    } else { PrintLn("PASS: EdiDirdebCheck without mandateRef = 2 (err)"c); }

    poke64(hdr2 + EDI_PAY_HDR_MANDATEREF, "MND-DE-20260101-001"c as int64);
    poke64(hdr2 + EDI_PAY_HDR_MANDATELEN, 19);

    // Test 16: DIRDEB with mandate ref → 0 (ok)
    if (EdiDirdebCheck(hdr2) != 0) {
        PrintLn("FAIL: DIRDEB with mandateRef should be ok (0)"c); ok := 0;
    } else { PrintLn("PASS: EdiDirdebCheck with mandateRef = 0 (ok)"c); }

    var w2: int64 := EdiDirdebWrite(hdr2, buf2, 4096);
    var rhdr2: int64 := alloc(EDI_PAY_HDR_SIZE);
    zeroHdr(rhdr2);
    EdiDirdebRead(buf2, w2, rhdr2);

    // Test 17: bgmQual = 431
    if (peek64(rhdr2 + EDI_PAY_HDR_BGMQUAL) != EDI_PAY_BGM_DIRDEB) {
        PrintLn("FAIL: DIRDEB bgmQual should be 431"c); ok := 0;
    } else { PrintLn("PASS: DIRDEB bgmQual=431"c); }

    // Test 18: mandateRef round-trip
    var rmp: int64 := peek64(rhdr2 + EDI_PAY_HDR_MANDATEREF);
    var rml: int64 := peek64(rhdr2 + EDI_PAY_HDR_MANDATELEN);
    if (memEq(rmp, rml, "MND-DE-20260101-001"c as int64, 19) != 1) {
        PrintLn("FAIL: DIRDEB mandateRef mismatch"c); ok := 0;
    } else { PrintLn("PASS: DIRDEB mandateRef=MND-DE-20260101-001"c); }

    free(rhdr2, EDI_PAY_HDR_SIZE);
    free(hdr2, EDI_PAY_HDR_SIZE);
    free(buf2, 4096);

    // -------------------------------------------------------------------------
    // Tests 19-21: FINCAN — TN ref validation + round-trip
    // -------------------------------------------------------------------------
    var buf3: int64 := alloc(4096);
    zi := 0;
    while (zi < 4096) { poke8(buf3 + zi, 0); zi := zi + 1; }
    var hdr3: int64 := alloc(EDI_PAY_HDR_SIZE);
    zeroHdr(hdr3);
    poke64(hdr3 + EDI_PAY_HDR_AMOUNT,   75000);
    poke64(hdr3 + EDI_PAY_HDR_CURRENCY, "EUR"c as int64);
    poke64(hdr3 + EDI_PAY_HDR_CURLEN,   3);

    // Test 19: FINCAN without TN ref → 2 (err)
    if (EdiFincanCheck(hdr3) != 2) {
        PrintLn("FAIL: FINCAN without txnRef should err (2)"c); ok := 0;
    } else { PrintLn("PASS: EdiFincanCheck without txnRef = 2 (err)"c); }

    poke64(hdr3 + EDI_PAY_HDR_TXNREF,    "TXN-2026-999"c as int64);
    poke64(hdr3 + EDI_PAY_HDR_TXNREFLEN, 12);

    var w3: int64 := EdiFincanWrite(hdr3, buf3, 4096);
    var rhdr3: int64 := alloc(EDI_PAY_HDR_SIZE);
    zeroHdr(rhdr3);
    EdiFincanRead(buf3, w3, rhdr3);

    // Test 20: bgmQual = 456
    if (peek64(rhdr3 + EDI_PAY_HDR_BGMQUAL) != EDI_PAY_BGM_FINCAN) {
        PrintLn("FAIL: FINCAN bgmQual should be 456"c); ok := 0;
    } else { PrintLn("PASS: FINCAN bgmQual=456"c); }

    // Test 21: txnRef round-trip
    var rtp: int64 := peek64(rhdr3 + EDI_PAY_HDR_TXNREF);
    var rtl: int64 := peek64(rhdr3 + EDI_PAY_HDR_TXNREFLEN);
    if (memEq(rtp, rtl, "TXN-2026-999"c as int64, 12) != 1) {
        PrintLn("FAIL: FINCAN txnRef mismatch"c); ok := 0;
    } else { PrintLn("PASS: FINCAN txnRef=TXN-2026-999"c); }

    free(rhdr3, EDI_PAY_HDR_SIZE);
    free(hdr3, EDI_PAY_HDR_SIZE);
    free(buf3, 4096);

    // -------------------------------------------------------------------------
    // Tests 22-28: PAYMUL — 3-item batch, sum validation
    //   item0: 50000, item1: 30000, item2: 20000 → total=100000
    // -------------------------------------------------------------------------
    var buf4: int64 := alloc(8192);
    zi := 0;
    while (zi < 8192) { poke8(buf4 + zi, 0); zi := zi + 1; }
    var hdr4: int64 := alloc(EDI_PAY_HDR_SIZE);
    zeroHdr(hdr4);
    poke64(hdr4 + EDI_PAY_HDR_REF,      "BATCH-001"c as int64);
    poke64(hdr4 + EDI_PAY_HDR_REFLEN,   9);
    poke64(hdr4 + EDI_PAY_HDR_AMOUNT,   100000);
    poke64(hdr4 + EDI_PAY_HDR_CURRENCY, "EUR"c as int64);
    poke64(hdr4 + EDI_PAY_HDR_CURLEN,   3);

    var items4: int64 := alloc(3 * EDI_PAYMUL_ITEM_SIZE);
    zi := 0;
    while (zi < 3 * EDI_PAYMUL_ITEM_SIZE) { poke8(items4 + zi, 0); zi := zi + 1; }

    var it0: int64 := items4 + 0 * EDI_PAYMUL_ITEM_SIZE;
    poke64(it0 + EDI_PAYMUL_ITEM_AMOUNT,   50000);
    poke64(it0 + EDI_PAYMUL_ITEM_REF,      "PMT-001"c as int64);
    poke64(it0 + EDI_PAYMUL_ITEM_REFLEN,   7);
    poke64(it0 + EDI_PAYMUL_ITEM_DEBTIBAN, "DE44500105175407324931"c as int64);
    poke64(it0 + EDI_PAYMUL_ITEM_DEBTILEN, 22);

    var it1: int64 := items4 + 1 * EDI_PAYMUL_ITEM_SIZE;
    poke64(it1 + EDI_PAYMUL_ITEM_AMOUNT,   30000);
    poke64(it1 + EDI_PAYMUL_ITEM_REF,      "PMT-002"c as int64);
    poke64(it1 + EDI_PAYMUL_ITEM_REFLEN,   7);
    poke64(it1 + EDI_PAYMUL_ITEM_DEBTIBAN, "DE44500105175407324931"c as int64);
    poke64(it1 + EDI_PAYMUL_ITEM_DEBTILEN, 22);

    var it2: int64 := items4 + 2 * EDI_PAYMUL_ITEM_SIZE;
    poke64(it2 + EDI_PAYMUL_ITEM_AMOUNT,   20000);
    poke64(it2 + EDI_PAYMUL_ITEM_REF,      "PMT-003"c as int64);
    poke64(it2 + EDI_PAYMUL_ITEM_REFLEN,   7);
    poke64(it2 + EDI_PAYMUL_ITEM_DEBTIBAN, "DE44500105175407324931"c as int64);
    poke64(it2 + EDI_PAYMUL_ITEM_DEBTILEN, 22);

    var w4: int64 := EdiPaymulWrite(hdr4, items4, 3, buf4, 8192);

    // Test 22: write > 0
    if (w4 <= 0) {
        PrintLn("FAIL: EdiPaymulWrite should return > 0"c); ok := 0;
    } else { PrintLn("PASS: EdiPaymulWrite returns > 0"c); }

    // Test 23: has LIN tag (76,73,78)
    if (hasTag(buf4, w4, 76, 73, 78) != 1) {
        PrintLn("FAIL: PAYMUL missing LIN tag"c); ok := 0;
    } else { PrintLn("PASS: PAYMUL has LIN tag"c); }

    // Read back
    var rhdr4:  int64 := alloc(EDI_PAY_HDR_SIZE);
    zeroHdr(rhdr4);
    var ritems4: int64 := alloc(4 * EDI_PAYMUL_ITEM_SIZE);
    zi := 0;
    while (zi < 4 * EDI_PAYMUL_ITEM_SIZE) { poke8(ritems4 + zi, 0); zi := zi + 1; }

    var rcnt4: int64 := EdiPaymulRead(buf4, w4, rhdr4, ritems4, 4);

    // Test 24: 3 items read back
    if (rcnt4 != 3) {
        PrintLn("FAIL: EdiPaymulRead should return 3 items"c); ok := 0;
    } else { PrintLn("PASS: EdiPaymulRead returns 3 items"c); }

    // Test 25: total amount = 100000
    if (peek64(rhdr4 + EDI_PAY_HDR_AMOUNT) != 100000) {
        PrintLn("FAIL: PAYMUL total should be 100000"c); ok := 0;
    } else { PrintLn("PASS: PAYMUL total=100000 (1000.00 EUR)"c); }

    // Test 26: item[0] amount = 50000
    var ri0: int64 := ritems4 + 0 * EDI_PAYMUL_ITEM_SIZE;
    if (peek64(ri0 + EDI_PAYMUL_ITEM_AMOUNT) != 50000) {
        PrintLn("FAIL: PAYMUL item[0] amount should be 50000"c); ok := 0;
    } else { PrintLn("PASS: PAYMUL item[0].amount=50000"c); }

    // Test 27: EdiPaymulValidate → 0 (correct)
    if (EdiPaymulValidate(rhdr4, ritems4, rcnt4) != 0) {
        PrintLn("FAIL: EdiPaymulValidate should return 0"c); ok := 0;
    } else { PrintLn("PASS: EdiPaymulValidate=0 (ok)"c); }

    // Test 28: EdiPaymulValidate → 2 when total tampered
    poke64(rhdr4 + EDI_PAY_HDR_AMOUNT, 999999);
    if (EdiPaymulValidate(rhdr4, ritems4, rcnt4) != 2) {
        PrintLn("FAIL: EdiPaymulValidate should return 2 (sum mismatch)"c); ok := 0;
    } else { PrintLn("PASS: EdiPaymulValidate=2 (tampered total)"c); }

    free(ritems4, 4 * EDI_PAYMUL_ITEM_SIZE);
    free(rhdr4, EDI_PAY_HDR_SIZE);
    free(items4, 3 * EDI_PAYMUL_ITEM_SIZE);
    free(hdr4, EDI_PAY_HDR_SIZE);
    free(buf4, 8192);

    // -------------------------------------------------------------------------
    // Tests 29-32: CREMUL, DEBMUL, PAYORD, PAYEXT BGM qualifiers
    // -------------------------------------------------------------------------
    var buf5: int64 := alloc(4096);
    var hdr5: int64 := alloc(EDI_PAY_HDR_SIZE);
    var rhdr5:int64 := alloc(EDI_PAY_HDR_SIZE);
    var rit5: int64 := alloc(EDI_PAYMUL_ITEM_SIZE);
    var it5:  int64 := alloc(EDI_PAYMUL_ITEM_SIZE);
    zi := 0;
    while (zi < EDI_PAYMUL_ITEM_SIZE) { poke8(it5 + zi, 0); zi := zi + 1; }
    poke64(it5 + EDI_PAYMUL_ITEM_AMOUNT, 10000);
    poke64(it5 + EDI_PAYMUL_ITEM_REF,    "X"c as int64);
    poke64(it5 + EDI_PAYMUL_ITEM_REFLEN, 1);

    // Test 29: CREMUL bgmQual = 454
    zi := 0;
    while (zi < 4096) { poke8(buf5 + zi, 0); zi := zi + 1; }
    zeroHdr(hdr5);
    poke64(hdr5 + EDI_PAY_HDR_AMOUNT, 10000);
    var w5: int64 := EdiCremulWrite(hdr5, it5, 1, buf5, 4096);
    zeroHdr(rhdr5);
    zi := 0;
    while (zi < EDI_PAYMUL_ITEM_SIZE) { poke8(rit5 + zi, 0); zi := zi + 1; }
    EdiCremulRead(buf5, w5, rhdr5, rit5, 1);
    if (peek64(rhdr5 + EDI_PAY_HDR_BGMQUAL) != EDI_PAY_BGM_CREMUL) {
        PrintLn("FAIL: CREMUL bgmQual should be 454"c); ok := 0;
    } else { PrintLn("PASS: CREMUL bgmQual=454"c); }

    // Test 30: DEBMUL bgmQual = 453
    zi := 0;
    while (zi < 4096) { poke8(buf5 + zi, 0); zi := zi + 1; }
    zeroHdr(hdr5);
    poke64(hdr5 + EDI_PAY_HDR_AMOUNT, 10000);
    w5 := EdiDebmulWrite(hdr5, it5, 1, buf5, 4096);
    zeroHdr(rhdr5);
    EdiDebmulRead(buf5, w5, rhdr5, rit5, 1);
    if (peek64(rhdr5 + EDI_PAY_HDR_BGMQUAL) != EDI_PAY_BGM_DEBMUL) {
        PrintLn("FAIL: DEBMUL bgmQual should be 453"c); ok := 0;
    } else { PrintLn("PASS: DEBMUL bgmQual=453"c); }

    // Test 31: PAYORD bgmQual = 450
    zi := 0;
    while (zi < 4096) { poke8(buf5 + zi, 0); zi := zi + 1; }
    zeroHdr(hdr5);
    poke64(hdr5 + EDI_PAY_HDR_AMOUNT, 20000);
    w5 := EdiPayordWrite(hdr5, buf5, 4096);
    zeroHdr(rhdr5);
    EdiPayordRead(buf5, w5, rhdr5);
    if (peek64(rhdr5 + EDI_PAY_HDR_BGMQUAL) != EDI_PAY_BGM_PAYORD) {
        PrintLn("FAIL: PAYORD bgmQual should be 450"c); ok := 0;
    } else { PrintLn("PASS: PAYORD bgmQual=450"c); }

    // Test 32: PAYEXT bgmQual = 455
    zi := 0;
    while (zi < 4096) { poke8(buf5 + zi, 0); zi := zi + 1; }
    zeroHdr(hdr5);
    poke64(hdr5 + EDI_PAY_HDR_AMOUNT, 30000);
    w5 := EdiPayextWrite(hdr5, buf5, 4096);
    zeroHdr(rhdr5);
    EdiPayextRead(buf5, w5, rhdr5);
    if (peek64(rhdr5 + EDI_PAY_HDR_BGMQUAL) != EDI_PAY_BGM_PAYEXT) {
        PrintLn("FAIL: PAYEXT bgmQual should be 455"c); ok := 0;
    } else { PrintLn("PASS: PAYEXT bgmQual=455"c); }

    free(it5, EDI_PAYMUL_ITEM_SIZE);
    free(rit5, EDI_PAYMUL_ITEM_SIZE);
    free(rhdr5, EDI_PAY_HDR_SIZE);
    free(hdr5, EDI_PAY_HDR_SIZE);
    free(buf5, 4096);

    // -------------------------------------------------------------------------
    // Tests 33-34: DEBADV + BANSTA BGM qualifiers
    // -------------------------------------------------------------------------
    var buf6: int64 := alloc(4096);
    var hdr6: int64 := alloc(EDI_PAY_HDR_SIZE);
    var rhdr6:int64 := alloc(EDI_PAY_HDR_SIZE);

    // Test 33: DEBADV bgmQual = 479
    zi := 0;
    while (zi < 4096) { poke8(buf6 + zi, 0); zi := zi + 1; }
    zeroHdr(hdr6);
    poke64(hdr6 + EDI_PAY_HDR_AMOUNT, 5000);
    var w6: int64 := EdiDebadvWrite(hdr6, buf6, 4096);
    zeroHdr(rhdr6);
    EdiDebadvRead(buf6, w6, rhdr6);
    if (peek64(rhdr6 + EDI_PAY_HDR_BGMQUAL) != EDI_PAY_BGM_DEBADV) {
        PrintLn("FAIL: DEBADV bgmQual should be 479"c); ok := 0;
    } else { PrintLn("PASS: DEBADV bgmQual=479"c); }

    // Test 34: BANSTA bgmQual = 391
    zi := 0;
    while (zi < 4096) { poke8(buf6 + zi, 0); zi := zi + 1; }
    zeroHdr(hdr6);
    poke64(hdr6 + EDI_PAY_HDR_AMOUNT, 12345);
    w6 := EdiBanstaWrite(hdr6, buf6, 4096);
    zeroHdr(rhdr6);
    EdiBanstaRead(buf6, w6, rhdr6);
    if (peek64(rhdr6 + EDI_PAY_HDR_BGMQUAL) != EDI_PAY_BGM_BANSTA) {
        PrintLn("FAIL: BANSTA bgmQual should be 391"c); ok := 0;
    } else { PrintLn("PASS: BANSTA bgmQual=391"c); }

    free(rhdr6, EDI_PAY_HDR_SIZE);
    free(hdr6, EDI_PAY_HDR_SIZE);
    free(buf6, 4096);

    // -------------------------------------------------------------------------
    // Tests 35-40: DOCAPP — documentary credit with 2 DOC segments
    //   creditNum=LC-2026-001, beneficiary=4012345000014, bankBic=COBADEFF
    //   amount=500000 (5000.00 EUR), validUntil=20261231
    //   doc[0]: code="710" (B/L), copies=3
    //   doc[1]: code="720" (cert of origin), copies=2
    // -------------------------------------------------------------------------
    var buf7:  int64 := alloc(4096);
    zi := 0;
    while (zi < 4096) { poke8(buf7 + zi, 0); zi := zi + 1; }

    var dhdr: int64 := alloc(EDI_DOCAPP_HDR_SIZE);
    zi := 0;
    while (zi < EDI_DOCAPP_HDR_SIZE) { poke8(dhdr + zi, 0); zi := zi + 1; }
    poke64(dhdr + EDI_DOCAPP_HDR_CREDITNUM,    "LC-2026-001"c as int64);
    poke64(dhdr + EDI_DOCAPP_HDR_CREDITNUMLEN, 11);
    poke64(dhdr + EDI_DOCAPP_HDR_BENEFICIARY,  "4012345000014"c as int64);
    poke64(dhdr + EDI_DOCAPP_HDR_BENEFLEN,     13);
    poke64(dhdr + EDI_DOCAPP_HDR_BANKBIC,      "COBADEFF"c as int64);
    poke64(dhdr + EDI_DOCAPP_HDR_BANKBICLEN,   8);
    poke64(dhdr + EDI_DOCAPP_HDR_AMOUNT,       500000);
    poke64(dhdr + EDI_DOCAPP_HDR_CURRENCY,     "EUR"c as int64);
    poke64(dhdr + EDI_DOCAPP_HDR_CURLEN,       3);
    poke64(dhdr + EDI_DOCAPP_HDR_VALIDUNTIL,   "20261231"c as int64);

    var docs: int64 := alloc(2 * EDI_DOCAPP_DOC_SIZE);
    zi := 0;
    while (zi < 2 * EDI_DOCAPP_DOC_SIZE) { poke8(docs + zi, 0); zi := zi + 1; }
    var d0: int64 := docs + 0 * EDI_DOCAPP_DOC_SIZE;
    poke64(d0 + EDI_DOCAPP_DOC_CODE,    "710"c as int64);
    poke64(d0 + EDI_DOCAPP_DOC_CODELEN, 3);
    poke64(d0 + EDI_DOCAPP_DOC_COPIES,  3);
    var d1: int64 := docs + 1 * EDI_DOCAPP_DOC_SIZE;
    poke64(d1 + EDI_DOCAPP_DOC_CODE,    "720"c as int64);
    poke64(d1 + EDI_DOCAPP_DOC_CODELEN, 3);
    poke64(d1 + EDI_DOCAPP_DOC_COPIES,  2);

    var w7: int64 := EdiDocappWrite(dhdr, docs, 2, buf7, 4096);

    // Test 35: write > 0
    if (w7 <= 0) {
        PrintLn("FAIL: EdiDocappWrite should return > 0"c); ok := 0;
    } else { PrintLn("PASS: EdiDocappWrite returns > 0"c); }

    // Test 36: has DOC tag (68=D,79=O,67=C)
    if (hasTag(buf7, w7, 68, 79, 67) != 1) {
        PrintLn("FAIL: DOCAPP missing DOC tag"c); ok := 0;
    } else { PrintLn("PASS: DOCAPP has DOC tag"c); }

    var rdhdr: int64 := alloc(EDI_DOCAPP_HDR_SIZE);
    zi := 0;
    while (zi < EDI_DOCAPP_HDR_SIZE) { poke8(rdhdr + zi, 0); zi := zi + 1; }
    var rdocs: int64 := alloc(4 * EDI_DOCAPP_DOC_SIZE);
    zi := 0;
    while (zi < 4 * EDI_DOCAPP_DOC_SIZE) { poke8(rdocs + zi, 0); zi := zi + 1; }

    var rdcnt: int64 := EdiDocappRead(buf7, w7, rdhdr, rdocs, 4);

    // Test 37: 2 docs read back
    if (rdcnt != 2) {
        PrintLn("FAIL: EdiDocappRead should return 2 docs"c); ok := 0;
    } else { PrintLn("PASS: EdiDocappRead returns 2 docs"c); }

    // Test 38: creditNum round-trip
    var rcnp: int64 := peek64(rdhdr + EDI_DOCAPP_HDR_CREDITNUM);
    var rcnl: int64 := peek64(rdhdr + EDI_DOCAPP_HDR_CREDITNUMLEN);
    if (memEq(rcnp, rcnl, "LC-2026-001"c as int64, 11) != 1) {
        PrintLn("FAIL: DOCAPP creditNum mismatch"c); ok := 0;
    } else { PrintLn("PASS: DOCAPP creditNum=LC-2026-001"c); }

    // Test 39: bankBic round-trip
    var rbp: int64 := peek64(rdhdr + EDI_DOCAPP_HDR_BANKBIC);
    var rbl: int64 := peek64(rdhdr + EDI_DOCAPP_HDR_BANKBICLEN);
    if (memEq(rbp, rbl, "COBADEFF"c as int64, 8) != 1) {
        PrintLn("FAIL: DOCAPP bankBic mismatch"c); ok := 0;
    } else { PrintLn("PASS: DOCAPP bankBic=COBADEFF"c); }

    // Test 40: doc[0].copies = 3
    var rd0: int64 := rdocs + 0 * EDI_DOCAPP_DOC_SIZE;
    if (peek64(rd0 + EDI_DOCAPP_DOC_COPIES) != 3) {
        PrintLn("FAIL: DOCAPP doc[0].copies should be 3"c); ok := 0;
    } else { PrintLn("PASS: DOCAPP doc[0].copies=3"c); }

    free(rdocs, 4 * EDI_DOCAPP_DOC_SIZE);
    free(rdhdr, EDI_DOCAPP_HDR_SIZE);
    free(docs, 2 * EDI_DOCAPP_DOC_SIZE);
    free(dhdr, EDI_DOCAPP_HDR_SIZE);
    free(buf7, 4096);

    // -------------------------------------------------------------------------
    // Test 41: DOCINF bgmQual = 763
    // -------------------------------------------------------------------------
    var buf8:  int64 := alloc(4096);
    zi := 0;
    while (zi < 4096) { poke8(buf8 + zi, 0); zi := zi + 1; }
    var dhdr8: int64 := alloc(EDI_DOCAPP_HDR_SIZE);
    zi := 0;
    while (zi < EDI_DOCAPP_HDR_SIZE) { poke8(dhdr8 + zi, 0); zi := zi + 1; }
    poke64(dhdr8 + EDI_DOCAPP_HDR_CREDITNUM,    "LC-2026-002"c as int64);
    poke64(dhdr8 + EDI_DOCAPP_HDR_CREDITNUMLEN, 11);
    poke64(dhdr8 + EDI_DOCAPP_HDR_AMOUNT,       100000);
    var docs8: int64 := alloc(EDI_DOCAPP_DOC_SIZE);
    zi := 0;
    while (zi < EDI_DOCAPP_DOC_SIZE) { poke8(docs8 + zi, 0); zi := zi + 1; }
    poke64(docs8 + EDI_DOCAPP_DOC_CODE,    "710"c as int64);
    poke64(docs8 + EDI_DOCAPP_DOC_CODELEN, 3);
    poke64(docs8 + EDI_DOCAPP_DOC_COPIES,  1);

    var w8: int64 := EdiDocinfrWrite(dhdr8, docs8, 1, buf8, 4096);
    var rdhdr8: int64 := alloc(EDI_DOCAPP_HDR_SIZE);
    zi := 0;
    while (zi < EDI_DOCAPP_HDR_SIZE) { poke8(rdhdr8 + zi, 0); zi := zi + 1; }
    var rdocs8: int64 := alloc(2 * EDI_DOCAPP_DOC_SIZE);
    zi := 0;
    while (zi < 2 * EDI_DOCAPP_DOC_SIZE) { poke8(rdocs8 + zi, 0); zi := zi + 1; }
    EdiDocinfrRead(buf8, w8, rdhdr8, rdocs8, 2);

    // The DOCINF creditNum read-back (bgmQual=763 shows in the BGM segment)
    var rdn8p: int64 := peek64(rdhdr8 + EDI_DOCAPP_HDR_CREDITNUM);
    var rdn8l: int64 := peek64(rdhdr8 + EDI_DOCAPP_HDR_CREDITNUMLEN);
    if (memEq(rdn8p, rdn8l, "LC-2026-002"c as int64, 11) != 1) {
        PrintLn("FAIL: DOCINF creditNum mismatch"c); ok := 0;
    } else { PrintLn("PASS: DOCINF creditNum=LC-2026-002"c); }

    free(rdocs8, 2 * EDI_DOCAPP_DOC_SIZE);
    free(rdhdr8, EDI_DOCAPP_HDR_SIZE);
    free(docs8, EDI_DOCAPP_DOC_SIZE);
    free(dhdr8, EDI_DOCAPP_HDR_SIZE);
    free(buf8, 4096);

    // -------------------------------------------------------------------------
    // Test 42: CREEXT bgmQual = 462
    // -------------------------------------------------------------------------
    var buf9: int64 := alloc(4096);
    zi := 0;
    while (zi < 4096) { poke8(buf9 + zi, 0); zi := zi + 1; }
    var hdr9: int64 := alloc(EDI_PAY_HDR_SIZE);
    var rhdr9:int64 := alloc(EDI_PAY_HDR_SIZE);
    zeroHdr(hdr9);
    poke64(hdr9 + EDI_PAY_HDR_AMOUNT, 8000);
    var w9: int64 := EdiCreextWrite(hdr9, buf9, 4096);
    zeroHdr(rhdr9);
    EdiCreextRead(buf9, w9, rhdr9);
    if (peek64(rhdr9 + EDI_PAY_HDR_BGMQUAL) != EDI_PAY_BGM_CREEXT) {
        PrintLn("FAIL: CREEXT bgmQual should be 462"c); ok := 0;
    } else { PrintLn("PASS: CREEXT bgmQual=462"c); }

    // creditor IBAN round-trip from PAYORD
    zi := 0;
    while (zi < 4096) { poke8(buf9 + zi, 0); zi := zi + 1; }
    zeroHdr(hdr9);
    poke64(hdr9 + EDI_PAY_HDR_AMOUNT,   99900);
    poke64(hdr9 + EDI_PAY_HDR_CREDIBAN, "DE44500105175407324931"c as int64);
    poke64(hdr9 + EDI_PAY_HDR_CREDILEN, 22);
    poke64(hdr9 + EDI_PAY_HDR_CURRENCY, "EUR"c as int64);
    poke64(hdr9 + EDI_PAY_HDR_CURLEN,   3);
    w9 := EdiPayordWrite(hdr9, buf9, 4096);
    zeroHdr(rhdr9);
    EdiPayordRead(buf9, w9, rhdr9);

    // Test 43: PAYORD creditor IBAN round-trip
    var rcip: int64 := peek64(rhdr9 + EDI_PAY_HDR_CREDIBAN);
    var rcil: int64 := peek64(rhdr9 + EDI_PAY_HDR_CREDILEN);
    if (memEq(rcip, rcil, "DE44500105175407324931"c as int64, 22) != 1) {
        PrintLn("FAIL: PAYORD creditor IBAN mismatch"c); ok := 0;
    } else { PrintLn("PASS: PAYORD creditor IBAN round-trip"c); }

    free(rhdr9, EDI_PAY_HDR_SIZE);
    free(hdr9, EDI_PAY_HDR_SIZE);
    free(buf9, 4096);

    if (ok == 1) {
        PrintLn("ALL PASS"c);
        return 0;
    }
    PrintLn("SOME TESTS FAILED"c);
    return 1;
}
