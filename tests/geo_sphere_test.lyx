// tests/geo_sphere_test.lyx
// Entfernungen, Kurse und Zielpunkte auf der Erdkugel — std.geo.sphere.
//
// Sollwerte aus vier Quellen, keine davon die geprueften Formeln:
//
//   1. geschlossene Eigenschaften der Kugel (halber Aequator und Pol-zu-Pol
//      sind beide pi*R = 20015.114 km; eine Bogenminute ist definitionsgemaess
//      eine Seemeile);
//   2. unabhaengig nachgerechnete Strecken (Hamburg-New York 6129.924 km,
//      Anfangskurs 293.244, Endkurs 226.069 Grad);
//   3. Umkehrproben (Zielpunkt aus Kurs und Entfernung muss den Zielort
//      treffen; Kurs hin und zurueck haengen zusammen);
//   4. der Vergleich mit std.geo, dessen Naeherung genau dort auseinanderlaeuft,
//      wo #1888 es beschreibt.
//
// Der wichtigste Fall ist die DATUMSGRENZE: 179 Grad Ost nach 179 Grad West
// sind 222 km, nicht 39852 km. Daran ist die Naeherung in std.geo um den
// Faktor 180 vorbeigegangen, und nur ein Test, der ueber die Grenze rechnet,
// bemerkt so etwas.

unit main;

import std.io;
import std.math;
import std.geo.sphere;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn CheckRel(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  var d: f64 := AbsF64(got - want);
  var s: f64 := AbsF64(want);
  if (s < 1.0) { s := 1.0; }
  if (d / s <= tol) { PrintStr("PASS "c); PrintStrLn(name); }
  else {
    PrintStr("FAIL "c); PrintStr(name);
    PrintStr(": erhalten "c); PrintF64(got);
    PrintStr(" erwartet "c); PrintF64(want); PrintLn(""c);
    _fails := _fails + 1;
  }
}

fn CheckWahr(name: pchar, got: bool): void {
  _checks := _checks + 1;
  if (got) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStr(name); PrintStrLn(" (erwartet: wahr)"c); _fails := _fails + 1; }
}

fn CheckFalsch(name: pchar, got: bool): void {
  _checks := _checks + 1;
  if (!got) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStr(name); PrintStrLn(" (erwartet: falsch)"c); _fails := _fails + 1; }
}

fn main(): int64 {
  var hh:  GeoPos := GeoPosNew(53.5511, 9.9937);          // Hamburg
  var ny:  GeoPos := GeoPosNew(40.7128, 0.0 - 74.0060);   // New York
  var syd: GeoPos := GeoPosNew(0.0 - 33.8688, 151.2093);  // Sydney
  var bue: GeoPos := GeoPosNew(0.0 - 34.6037, 0.0 - 58.3816); // Buenos Aires
  var hb:  GeoPos := GeoPosNew(53.0793, 8.8017);          // Bremen
  var nullpunkt: GeoPos := GeoPosNew(0.0, 0.0);

  // ── Eigenschaften der Kugel ─────────────────────────────────────────────
  // Halber Aequator und Pol zu Pol sind DASSELBE: pi * R.
  var halb: f64 := GeoEntfernungKm(nullpunkt, GeoPosNew(0.0, 180.0));
  var pole: f64 := GeoEntfernungKm(GeoPosNew(90.0, 0.0), GeoPosNew(0.0 - 90.0, 0.0));
  CheckRel("halber Aequator = pi*R"c, halb, Pi() * GeoErdradius() / 1000.0, 0.000000001);
  CheckRel("Pol zu Pol = halber Aequator"c, pole, halb, 0.000000001);
  // Eine Bogenminute ist definitionsgemaess eine Seemeile (1852 m).
  CheckRel("eine Bogenminute = 1 sm"c,
           GeoEntfernungSm(nullpunkt, GeoPosNew(1.0 / 60.0, 0.0)), 1.0, 0.001);
  // Derselbe Punkt hat Abstand 0.
  CheckRel("derselbe Punkt: 0 km"c, GeoEntfernungKm(hh, hh), 0.0, 0.000000001);

  // ── Strecken, unabhaengig nachgerechnet ─────────────────────────────────
  CheckRel("Hamburg -> New York = 6129.924 km"c, GeoEntfernungKm(hh, ny), 6129.924, 0.000001);
  CheckRel("Sydney -> Buenos Aires = 11801.08 km"c, GeoEntfernungKm(syd, bue), 11801.082, 0.000001);
  CheckRel("Hamburg -> Bremen = 94.98 km"c, GeoEntfernungKm(hh, hb), 94.984, 0.0001);
  // Entfernung ist symmetrisch — bei einer Naeherung mit Mittelbreite ist das
  // nicht selbstverstaendlich.
  CheckRel("Entfernung ist symmetrisch"c,
           GeoEntfernungKm(hh, ny), GeoEntfernungKm(ny, hh), 0.000000001);

  // ── Datumsgrenze ────────────────────────────────────────────────────────
  // Der Fall, an dem std.geo um den Faktor 180 vorbeigeht (#1888).
  var o179: GeoPos := GeoPosNew(0.0, 179.0);
  var w179: GeoPos := GeoPosNew(0.0, 0.0 - 179.0);
  CheckRel("179 Ost -> 179 West = 222.4 km"c, GeoEntfernungKm(o179, w179), 222.39, 0.001);
  CheckRel("Kurs dort ist genau Ost"c, GeoKurs(o179, w179), 90.0, 0.000001);
  CheckRel("und zurueck genau West"c, GeoKurs(w179, o179), 270.0, 0.000001);
  // Auch der Mittelpunkt muss auf der kurzen Seite liegen, nicht auf 0 Grad.
  var m: GeoPos := GeoMittelpunkt(o179, w179);
  CheckWahr("Mittelpunkt liegt bei 180, nicht bei 0"c, AbsF64(m.lon) > 179.9);

  // ── Kurse ───────────────────────────────────────────────────────────────
  CheckRel("Anfangskurs HH->NY = 293.244"c, GeoKurs(hh, ny), 293.244, 0.00001);
  // Auf einem Grosskreis AENDERT sich der Kurs unterwegs — das ist der
  // Unterschied zur Loxodrome und der Grund, warum es beide Funktionen gibt.
  CheckRel("Endkurs HH->NY = 226.069"c, GeoEndkurs(hh, ny), 226.069, 0.00001);
  CheckWahr("Anfangs- und Endkurs sind verschieden"c,
            AbsF64(GeoKurs(hh, ny) - GeoEndkurs(hh, ny)) > 10.0);
  // Kurse liegen immer in 0..360, nie negativ.
  CheckWahr("Kurs nach Westen bleibt positiv"c, GeoKurs(hh, ny) > 0.0);
  CheckWahr("Kurs bleibt unter 360"c, GeoKurs(hh, ny) < 360.0);
  // Genau nach Norden, Osten, Sueden, Westen.
  CheckRel("nach Norden = 0"c,   GeoKurs(nullpunkt, GeoPosNew(1.0, 0.0)), 0.0, 0.000001);
  CheckRel("nach Osten = 90"c,   GeoKurs(nullpunkt, GeoPosNew(0.0, 1.0)), 90.0, 0.000001);
  CheckRel("nach Sueden = 180"c, GeoKurs(nullpunkt, GeoPosNew(0.0 - 1.0, 0.0)), 180.0, 0.000001);
  CheckRel("nach Westen = 270"c, GeoKurs(nullpunkt, GeoPosNew(0.0, 0.0 - 1.0)), 270.0, 0.000001);

  // ── Zielpunkt: die Umkehrprobe ──────────────────────────────────────────
  var ziel: GeoPos := GeoZielpunkt(hh, GeoKurs(hh, ny), GeoEntfernung(hh, ny));
  CheckRel("Zielpunkt trifft die Breite"c, ziel.lat, 40.7128, 0.0000001);
  CheckRel("Zielpunkt trifft die Laenge"c, ziel.lon, 0.0 - 74.0060, 0.0000001);
  // Auch ueber die Datumsgrenze hinweg — und die Laenge bleibt in -180..180.
  var ueber: GeoPos := GeoZielpunkt(GeoPosNew(0.0, 179.0), 90.0, 400000.0);
  CheckWahr("Zielpunkt ueber der Grenze bleibt im Bereich"c,
            ueber.lon >= 0.0 - 180.0 && ueber.lon <= 180.0);
  CheckWahr("und liegt jetzt westlich"c, ueber.lon < 0.0);
  // Der Mittelpunkt ist von beiden Enden gleich weit entfernt.
  var mid: GeoPos := GeoMittelpunkt(hh, ny);
  CheckRel("Mittelpunkt liegt in der Mitte"c,
           GeoEntfernungKm(hh, mid), GeoEntfernungKm(mid, ny), 0.000001);

  // ── Abstand von einer Strecke ───────────────────────────────────────────
  // Ein Punkt AUF der Strecke hat Querabweichung 0. Die Toleranz ist nicht
  // 0: auf 6100 km bleiben rund 11 Mikrometer Rundung stehen. Eine Pruefung
  // auf exakte 0 wuerde daran scheitern und nichts Besseres aussagen.
  CheckRel("Punkt auf der Strecke: 0 quer"c,
           GeoQuerabweichung(mid, hh, ny), 0.0, 0.001);
  // Das Vorzeichen unterscheidet links von rechts — ohne es weiss man nicht,
  // wohin zu steuern ist.
  //
  // SENKRECHT WOZU: auf einem Grosskreis aendert sich der Kurs unterwegs. Der
  // erste Anlauf dieser Pruefung ging vom Mittelpunkt senkrecht zum
  // ANFANGSKURS weg und mass 38301 statt 50000 m — der Unterschied ist
  // cos(50 Grad), also genau die Kursdrehung zwischen Hamburg und der Mitte.
  // Senkrecht muss ORTLICH heissen, also zum Kurs AM Mittelpunkt.
  var kursMitte: f64 := GeoKurs(mid, ny);
  var rechts: GeoPos := GeoZielpunkt(mid, GeoNormKurs(kursMitte + 90.0), 50000.0);
  var links:  GeoPos := GeoZielpunkt(mid, GeoNormKurs(kursMitte - 90.0), 50000.0);
  CheckWahr("rechts der Strecke ist positiv"c, GeoQuerabweichung(rechts, hh, ny) > 0.0);
  CheckWahr("links der Strecke ist negativ"c,  GeoQuerabweichung(links, hh, ny) < 0.0);
  CheckRel("50 km Abstand werden gemessen"c,
           AbsF64(GeoQuerabweichung(rechts, hh, ny)), 50000.0, 0.0001);
  CheckRel("links misst denselben Betrag"c,
           AbsF64(GeoQuerabweichung(links, hh, ny)), 50000.0, 0.0001);

  // ── Loxodrome ───────────────────────────────────────────────────────────
  // Fester Kurs ist LAENGER als der Grosskreis — sonst waere der Grosskreis
  // nicht die kuerzeste Verbindung.
  CheckWahr("Loxodrome ist laenger als der Grosskreis"c,
            GeoLoxodromStrecke(hh, ny) > GeoEntfernung(hh, ny));
  CheckRel("Loxodrome HH->NY = 6469.4 km"c,
           GeoLoxodromStrecke(hh, ny) / 1000.0, 6469.397, 0.00001);
  // Entlang eines Breitenkreises fallen Loxodrome und fester Kurs zusammen:
  // Kurs genau Ost, Laenge = Bogen mal cos(Breite).
  CheckRel("Loxodrom-Kurs am Breitenkreis = 90"c,
           GeoLoxodromKurs(GeoPosNew(60.0, 0.0), GeoPosNew(60.0, 10.0)), 90.0, 0.000001);
  CheckRel("Loxodrome am 60. Breitenkreis"c,
           GeoLoxodromStrecke(GeoPosNew(60.0, 0.0), GeoPosNew(60.0, 10.0)) / 1000.0,
           GeoZuBogen(10.0) * CosF64(GeoZuBogen(60.0)) * GeoErdradius() / 1000.0, 0.000001);
  // Auf demselben Meridian ist die Loxodrome der Grosskreis.
  CheckRel("auf dem Meridian gleich lang"c,
           GeoLoxodromStrecke(GeoPosNew(10.0, 5.0), GeoPosNew(50.0, 5.0)),
           GeoEntfernung(GeoPosNew(10.0, 5.0), GeoPosNew(50.0, 5.0)), 0.0001);

  // ── Grad, Minuten, Sekunden mit Himmelsrichtung ─────────────────────────
  // Exakt, nicht ueber gerundete Festkommafaktoren (#1888).
  CheckRel("53 Grad 33 Min 04 Sek Nord"c, GeoAusGMS(53.0, 33.0, 4.0, GEO_NORD), 53.551111, 0.000001);
  CheckRel("dasselbe als Sued ist negativ"c,
           GeoAusGMS(53.0, 33.0, 4.0, GEO_SUED), 0.0 - 53.551111, 0.000001);
  CheckRel("Ost ist positiv"c,  GeoAusGMS(9.0, 59.0, 37.0, GEO_OST), 9.993611, 0.000001);
  CheckRel("West ist negativ"c, GeoAusGMS(9.0, 59.0, 37.0, GEO_WEST), 0.0 - 9.993611, 0.000001);
  // 60 Minuten sind keine Schreibweise, sondern ein Tippfehler — und 61
  // Minuten liegen 1.85 km neben der gemeinten Stelle.
  CheckWahr("60 Minuten werden abgewiesen"c, GeoIstFehler(GeoAusGMS(0.0, 60.0, 0.0, GEO_NORD)));
  CheckWahr("60 Sekunden werden abgewiesen"c, GeoIstFehler(GeoAusGMS(0.0, 0.0, 60.0, GEO_NORD)));
  // DAS ist der Unterschied zu std.geo: eine unbekannte Richtung wird dort
  // still als Nord genommen.
  CheckWahr("unbekannte Himmelsrichtung meldet"c, GeoIstFehler(GeoAusGMS(53.0, 33.0, 4.0, 88)));
  CheckWahr("negative Minuten melden"c, GeoIstFehler(GeoAusGMS(53.0, 0.0 - 1.0, 0.0, GEO_NORD)));
  // Und die Rueckrichtung: welcher Buchstabe gehoert zum Vorzeichen?
  CheckWahr("negative Breite ist Sued"c, GeoRichtungBreite(0.0 - 53.0) == GEO_SUED);
  CheckWahr("positive Breite ist Nord"c, GeoRichtungBreite(53.0) == GEO_NORD);
  CheckWahr("negative Laenge ist West"c, GeoRichtungLaenge(0.0 - 74.0) == GEO_WEST);
  CheckWahr("positive Laenge ist Ost"c,  GeoRichtungLaenge(9.9) == GEO_OST);

  // ── Kompasssektor ───────────────────────────────────────────────────────
  // Der Nordsektor liegt SYMMETRISCH um 0 — 350 Grad ist noch Nord.
  CheckWahr("0 Grad ist Nord"c,   GeoKompassSektor(0.0) == 0);
  CheckWahr("350 Grad ist Nord"c, GeoKompassSektor(350.0) == 0);
  CheckWahr("10 Grad ist Nord"c,  GeoKompassSektor(10.0) == 0);
  CheckWahr("90 Grad ist Ost"c,   GeoKompassSektor(90.0) == 4);
  CheckWahr("180 Grad ist Sued"c, GeoKompassSektor(180.0) == 8);
  CheckWahr("270 Grad ist West"c, GeoKompassSektor(270.0) == 12);

  // ── Gueltigkeit ─────────────────────────────────────────────────────────
  CheckWahr("Nordpol ist gueltig"c, GeoPosGueltig(GeoPosNew(90.0, 0.0)));
  CheckFalsch("91 Grad Breite nicht"c, GeoPosGueltig(GeoPosNew(91.0, 0.0)));
  CheckFalsch("181 Grad Laenge nicht"c, GeoPosGueltig(GeoPosNew(0.0, 181.0)));
  CheckWahr("ungueltige Eingabe meldet"c, GeoIstFehler(GeoEntfernung(GeoPosNew(91.0, 0.0), hh)));

  // ── Horizont und Sicht ──────────────────────────────────────────────────
  // 1.7 m Augenhoehe geben 4.65 km — die Zahl, die erklaert, warum ein Schiff
  // am Horizont verschwindet statt kleiner zu werden.
  CheckRel("Horizont bei 1.7 m = 4.65 km"c, GeoHorizont(1.7) / 1000.0, 4.654, 0.001);
  CheckRel("Augenhoehe 0 gibt 0"c, GeoHorizont(0.0), 0.0, 0.000000001);
  // Zwei Tuerme von 100 m sehen einander auf 71 km, aber nicht auf 100 km.
  var t1: GeoPos := GeoPosNew(0.0, 0.0);
  CheckWahr("zwei Tuerme sehen sich auf 60 km"c,
            GeoSichtverbindung(t1, 100.0, GeoZielpunkt(t1, 90.0, 60000.0), 100.0));
  CheckFalsch("auf 100 km nicht mehr"c,
              GeoSichtverbindung(t1, 100.0, GeoZielpunkt(t1, 90.0, 100000.0), 100.0));

  PrintStr("\n"c);
  PrintInt(_checks); PrintStr(" Pruefungen, "c);
  PrintInt(_fails); PrintStrLn(" FAIL"c);
  if (_fails == 0) { PrintStrLn("OK: std.geo.sphere"c); return 0; }
  return 1;
}
