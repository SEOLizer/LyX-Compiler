// tests/do_demo1_webserver.lyx — DO Demo 1: Webserver-Deploy
// WP-DO-14 Demo 1
// Benötigt: DIGITALOCEAN_TOKEN env-Variable

unit tests.do_demo1_webserver;

import std.cloud.digitalocean.credentials;
import std.cloud.digitalocean.droplets;
import std.cloud.digitalocean.networking;
import std.alloc;
import std.io;
import std.fs;

pub fn main(argc: int64, argv: pchar): int64 {
    var creds: DOCredentials := DOCredentialsFromEnv();
    if (creds.tokenLen == 0) {
        PrintLn("Fehler: DIGITALOCEAN_TOKEN nicht gesetzt."c);
        return 1;
    }

    PrintLn("--- DO Demo 1: Einfacher Webserver-Deploy ---"c);

    // SSH-Key aus Datei laden
    var keyPath: pchar := "/root/.ssh/id_rsa.pub"c;
    var keyExists: int64 := FileExists(keyPath) as int64;
    var key: DOSSHKey;
    key.id := 0; key.name := 0; key.fingerprint := 0; key.publicKey := 0;

    if (keyExists == 1) {
        var keySz: int64 := FileSize(keyPath);
        var keyBuf: int64 := alloc(keySz + 1);
        ReadFile(keyPath, keyBuf as pchar, keySz);
        poke8(keyBuf+keySz, 0);
        key := SSHKeyCreate(creds, "lyx-demo-key"c, keyBuf as pchar);
        free(keyBuf, keySz + 1);
        if (key.id != 0) {
            Print("SSH-Key importiert: "c); PrintLn(key.id as pchar);
        }
    } else {
        PrintLn("Kein SSH-Key gefunden — fahre ohne fort."c);
    }

    // Droplet erstellen
    Print("Erstelle Droplet web-01 in fra1..."c);
    var sshKeyId: pchar := 0 as pchar;
    if (key.id != 0) { sshKeyId := key.id as pchar; }
    // #1344: DropletCreateSimple nimmt keinen SSH-Schluessel — die Unit
    // fuehrt nur name/region/size/image. Der Schluessel wird hier nur noch
    // gemeldet, damit die Zeile nicht so aussieht, als wuerde er gesetzt.
    if (sshKeyId != 0 as pchar) { PrintLn(" (SSH-Schluessel wird von DropletCreateSimple nicht uebergeben)"c); }
    var d: DODroplet := DropletCreateSimple(creds,
        "web-01"c, "fra1"c, "s-1vcpu-1gb"c, "ubuntu-22-04-x64"c);
    if (d.id == 0) {
        PrintLn(" FEHLER beim Erstellen des Droplets."c);
        DOCredentialsFree(creds);
        return 1;
    }
    Print(" ID: "c); PrintLn(d.id as pchar);

    // Warten bis aktiv
    Print("Warte auf aktiven Status..."c);
    var ready: DODroplet := DropletWait(creds, d.id, "active"c);
    if (ready.id == 0) {
        PrintLn(" Timeout."c);
    } else {
        PrintLn(" aktiv!"c);
    }
    DODropletFree(d);

    // IP abrufen
    var ip: int64 := DropletGetIP(creds, ready.id);
    Print("Droplet IP: "c);
    if (ip != 0) { PrintLn(ip as pchar); }
    else { PrintLn("(keine öffentliche IP)"c); }

    // Floating IP zuweisen
    Print("Erstelle Floating IP in fra1..."c);
    var fip: DOFloatingIP := FloatingIPCreate(creds, "fra1"c);
    if (fip.ip == 0) {
        PrintLn(" FEHLER."c);
    } else {
        Print(" "c); PrintLn(fip.ip as pchar);
        var ok: int64 := FloatingIPAssign(creds, fip.ip as pchar, ready.id);
        if (ok == 1) {
            Print("Floating IP zugewiesen: "c); PrintLn(fip.ip as pchar);
        } else {
            PrintLn("Fehler beim Zuweisen der Floating IP."c);
        }
    }

    PrintLn("--- Demo 1 abgeschlossen ---"c);
    PrintLn("Zum Aufräumen:"c);
    PrintLn("  lyxdo compute droplet delete <id>"c);
    PrintLn("  lyxdo networking floating-ip delete <ip>"c);

    if (ip   != 0) { free(ip,   StrLen(ip   as pchar) + 1); }
    DODropletFree(ready);
    DOFloatingIPFree(fip);
    if (key.id != 0) { DOSSHKeyFree(key); }
    DOCredentialsFree(creds);
    return 0;
}
