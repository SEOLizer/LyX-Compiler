// tests/lyxos_geraet/probe0.lyx — #2599 Stufe 0: läuft Lyx-Code auf dem Gerät,
// und kommt seine Ausgabe beim Wirt an?
//
// Dieses Programm beantwortet GENAU EINE Frage und sonst keine. Kein Netz,
// keine Dateien, keine Krypto. Es ist der kleinste Nachweis, dass der Weg
// trägt: übersetzen -> ins Abbild legen -> booten -> Ausgabe einsammeln ->
// urteilen. Alles darüber (RFC-8448-Vektoren, TLS-Handschlag) setzt diesen
// Schritt voraus.
//
// WARUM EINE RECHNUNG DRIN IST. Eine Marke allein würde nur belegen, dass der
// LADER gelaufen ist — bei einem leeren Programm stünde sie genauso da. Die
// Summe 1..1000 ist zur Übersetzungszeit nicht faltbar (Schleife mit
// veränderlicher Grenze), und ihr Wert wird GEPRÜFT. Steht die Summe falsch in
// der Ausgabe, hat Code gelaufen und FALSCH gerechnet — das ist ein anderer
// Befund als "nichts gelaufen", und beide müssen unterscheidbar sein.
//
// WARUM DIE MARKEN SO SPERRIG SIND. Die serielle Leitung trägt auch die
// Kernelausgabe (im Versuch 296 Zeilen davor). Ein Muster wie "ok" oder "PASS"
// trifft dort zufällig; `LYXOS-PROBE-...-7F3A` nicht.
import std.io;

fn main(): int64 {
  PrintLn("LYXOS-PROBE-START-7F3A"c);

  var s: int64 := 0;
  var i: int64 := 1;
  while (i <= 1000) { s := s + i; i := i + 1; }
  Print("LYXOS-PROBE-SUMME "c); PrintInt(s); PrintLn(""c);

  if (s != 500500) {
    PrintLn("LYXOS-PROBE-RECHNUNG-FALSCH"c);
    return 1;
  }

  PrintLn("LYXOS-PROBE-ENDE-7F3A"c);
  return 0;
}
