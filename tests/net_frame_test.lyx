// tests/net_frame_test.lyx — Pure kernel-safe frame unit tests (45 tests)
//
// Tests: std.net.eth, std.net.ipv4, std.net.udp, std.net.arp.frame, std.net.dhcp.frame
unit tests.net_frame_test;

import std.net.eth;
import std.net.ipv4;
import std.net.udp;
import std.net.arp.frame;
import std.net.dhcp.frame;
import std.alloc;
import std.io;

fn pass(n: int64) { Print("PASS "); PrintLn(n); }
fn fail(n: int64) { Print("FAIL "); PrintLn(n); }
fn check(n: int64, ok: int64) { if ok == 1 { pass(n); } else { fail(n); } }

fn main() {
    // ── Tests 1-5: std.net.eth constants ──────────────────────────────────────
    check(1,  ETH_HDR_SIZE == 14);
    check(2,  ETH_P_IP     == 2048);
    check(3,  ETH_P_ARP    == 2054);
    check(4,  ETH_P_IPV6   == 34525);

    // ── Test 5: EthBuildFrame ─────────────────────────────────────────────────
    var ethBuf: int64 := alloc(14);
    var dstMac: int64 := alloc(6);
    var srcMac: int64 := alloc(6);
    poke8(dstMac,   0x11); poke8(dstMac+1, 0x22); poke8(dstMac+2, 0x33);
    poke8(dstMac+3, 0x44); poke8(dstMac+4, 0x55); poke8(dstMac+5, 0x66);
    poke8(srcMac,   0xAA); poke8(srcMac+1, 0xBB); poke8(srcMac+2, 0xCC);
    poke8(srcMac+3, 0xDD); poke8(srcMac+4, 0xEE); poke8(srcMac+5, 0xFF);
    var ethWritten: int64 := EthBuildFrame(ethBuf, dstMac, srcMac, ETH_P_IP);
    check(5,  ethWritten == 14);
    check(6,  (peek8(ethBuf+0) & 255) == 0x11);
    check(7,  (peek8(ethBuf+5) & 255) == 0x66);
    check(8,  (peek8(ethBuf+6) & 255) == 0xAA);
    check(9,  (peek8(ethBuf+11) & 255) == 0xFF);
    check(10, (peek8(ethBuf+12) & 255) == 8);    // ETH_P_IP hi
    check(11, (peek8(ethBuf+13) & 255) == 0);    // ETH_P_IP lo

    // ── Test 12: EthBroadcastMac ──────────────────────────────────────────────
    EthBroadcastMac(dstMac);
    check(12, (peek8(dstMac) & 255) == 255 && (peek8(dstMac+5) & 255) == 255);

    // ── Test 13: EthZeroMac ───────────────────────────────────────────────────
    EthZeroMac(dstMac);
    check(13, (peek8(dstMac) & 255) == 0 && (peek8(dstMac+3) & 255) == 0);

    // ── Test 14: EthReadType ──────────────────────────────────────────────────
    check(14, EthReadType(ethBuf) == ETH_P_IP);

    // ── Tests 15-19: std.net.ipv4 ─────────────────────────────────────────────
    check(15, IPV4_HDR_SIZE == 20);
    check(16, IP_PROTO_UDP  == 17);
    check(17, IP_PROTO_TCP  == 6);
    check(18, IpAddr(192, 168, 1, 1) == ((192 << 24) | (168 << 16) | (1 << 8) | 1));
    check(19, IpBroadcast() == 0xFFFFFFFF);

    // ── Test 20-22: IpBuildHeader ─────────────────────────────────────────────
    var ipBuf: int64 := alloc(20);
    var i: int64 := 0;
    while i < 20 { poke8(ipBuf + i, 0); i := i + 1; }
    var srcIP: int64 := IpAddr(192, 168, 1, 10);
    var dstIP: int64 := IpAddr(192, 168, 1, 1);
    var ipWritten: int64 := IpBuildHeader(ipBuf, srcIP, dstIP, IP_PROTO_UDP, 8);
    check(20, ipWritten == 20);
    check(21, (peek8(ipBuf+0) & 255) == 0x45);   // version=4, IHL=5
    check(22, (peek8(ipBuf+9) & 255) == 17);      // proto = UDP

    // ── Test 23: IpBuildHeader total length ───────────────────────────────────
    var totalLen: int64 := ((peek8(ipBuf+2) & 255) << 8) | (peek8(ipBuf+3) & 255);
    check(23, totalLen == 28);   // 20 + 8

    // ── Test 24: IpBuildHeader checksum non-zero ──────────────────────────────
    var ckHi: int64 := peek8(ipBuf+10) & 255;
    var ckLo: int64 := peek8(ipBuf+11) & 255;
    check(24, (ckHi | ckLo) != 0);

    // ── Tests 25-28: std.net.udp ──────────────────────────────────────────────
    check(25, UDP_HDR_SIZE == 8);
    check(26, UDP_PORT_DHCP_SERVER == 67);
    check(27, UDP_PORT_DHCP_CLIENT == 68);

    var udpBuf: int64 := alloc(8);
    i := 0;
    while i < 8 { poke8(udpBuf + i, 0); i := i + 1; }
    var udpWritten: int64 := UdpBuildHeader(udpBuf, 68, 67, 300);
    check(28, udpWritten == 8);

    // ── Test 29: UdpBuildHeader length field ─────────────────────────────────
    var udpLen: int64 := UdpReadLength(udpBuf);
    check(29, udpLen == 308);   // 8 + 300

    // ── Test 30: UdpBuildHeader ports ─────────────────────────────────────────
    check(30, UdpReadSrcPort(udpBuf) == 68);
    check(31, UdpReadDstPort(udpBuf) == 67);

    // ── Tests 32-35: std.net.arp.frame constants ──────────────────────────────
    check(32, ARP_FRAME_SIZE == 42);
    check(33, ARP_OP_REQUEST == 1);
    check(34, ARP_OP_REPLY   == 2);
    check(35, ARP_RESULT_SIZE == 48);

    // ── Test 36-37: ArpBuildRequest ──────────────────────────────────────────
    var arpBuf: int64 := alloc(42);
    poke8(srcMac,   0xAA); poke8(srcMac+1, 0xBB); poke8(srcMac+2, 0xCC);
    poke8(srcMac+3, 0xDD); poke8(srcMac+4, 0xEE); poke8(srcMac+5, 0xFF);
    var arpWritten: int64 := ArpBuildRequest(arpBuf, srcMac, srcIP, dstIP);
    check(36, arpWritten == 42);
    check(37, (peek8(arpBuf+0) & 255) == 255);   // dst MAC = broadcast

    // ── Test 38: ArpParse round-trip ─────────────────────────────────────────
    var arpResult: int64 := alloc(ARP_RESULT_SIZE);
    i := 0;
    while i < ARP_RESULT_SIZE { poke8(arpResult + i, 0); i := i + 1; }
    ArpParse(arpBuf, 42, arpResult);
    check(38, peek64(arpResult + ARP_RESULT_OK) == 1);

    // ── Tests 39-40: std.net.dhcp.frame constants ─────────────────────────────
    check(39, DHCP_PORT_SERVER  == 67);
    check(40, DHCP_MSG_DISCOVER == 1);

    // ── Test 41-43: DhcpBuildDiscover ─────────────────────────────────────────
    var dhcpBuf: int64 := alloc(DHCP_MIN_LEN);
    var xid: int64 := 0xDEADBEEF;
    var dhcpWritten: int64 := DhcpBuildDiscover(dhcpBuf, srcMac, xid);
    check(41, dhcpWritten == DHCP_MIN_LEN);
    check(42, (peek8(dhcpBuf + DHCP_OFFS_OP) & 255) == DHCP_OP_REQUEST);

    // ── Test 43: magic cookie at DHCP_OFFS_COOKIE (236) ──────────────────────
    check(43, (peek8(dhcpBuf + DHCP_OFFS_COOKIE) & 255) == DHCP_MAGIC_B0);

    // ── Tests 44-45: DhcpParseReply (invalid frame → ok=0) ───────────────────
    var dhcpResult: int64 := alloc(DHCP_RESULT_SIZE);
    i := 0;
    while i < DHCP_RESULT_SIZE { poke8(dhcpResult + i, 0); i := i + 1; }
    DhcpParseReply(dhcpBuf, dhcpWritten, dhcpResult);
    // DhcpBuildDiscover sets op=1 (request), so DhcpParseReply checks op==2
    check(44, peek64(dhcpResult + DHCP_RESULT_OK) == 0);
    check(45, DHCP_RESULT_SIZE == 72);
}
