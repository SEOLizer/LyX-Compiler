// tests/pdf_text_test.lyx
// WP-PDF-03: text output — PdfSetFont, PdfTextAt, PdfTextBlock, PdfTextWidth

@description("WP-PDF-03: text rendering test")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pdf_text_test;

import std.pdf;

fn testTextWidth(): int64 {
  // Helvetica 12pt: "Hello" = H(667)+e(556)+l(222)+l(222)+o(556) = 2223 milli-pts
  // width = 2223 * 12 / 1000 = 26.676 → truncated to 26pt
  var w: f64 := PdfTextWidth(0, PDF_FONT_HELVETICA, 12.0, "Hello");
  var wi: int64 := w as int64;
  if (wi < 25 || wi > 28) {
    PrintStr("FAIL: PdfTextWidth(Helvetica 12pt, 'Hello') = ");
    PrintInt(wi);
    PrintStr(" (expected ~26)\n");
    return 1;
  }
  PrintStr("OK: PdfTextWidth Helvetica 12pt 'Hello' = ~");
  PrintInt(wi);
  PrintStr("pt\n");

  // Courier is monospaced: 5 chars * 600 * 12 / 1000 = 36pt
  var cw: f64 := PdfTextWidth(0, PDF_FONT_COURIER, 12.0, "Hello");
  var cwi: int64 := cw as int64;
  if (cwi != 36) {
    PrintStr("FAIL: PdfTextWidth(Courier 12pt, 'Hello') = ");
    PrintInt(cwi);
    PrintStr(" (expected 36)\n");
    return 1;
  }
  PrintStr("OK: PdfTextWidth Courier 12pt 'Hello' = 36pt\n");
  return 0;
}

fn testTextAt(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew returned 0\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 720.0, "Hello, PDF World!");

  var err: int64 := PdfSave(doc, "/tmp/pdf_text.pdf");
  PdfFree(doc);
  if (err != 0) {
    PrintStr("FAIL: PdfSave returned ");
    PrintInt(err);
    PrintStr("\n");
    return 1;
  }
  PrintStr("OK: text PDF saved to /tmp/pdf_text.pdf\n");
  return 0;
}

fn testTextColor(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew returned 0\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA_BOLD, 14.0);
  PdfSetTextColor(doc, page, 0.8, 0.1, 0.1);
  PdfTextAt(doc, page, 72.0, 700.0, "Red Bold Text");

  PdfSetFont(doc, page, PDF_FONT_COURIER, 10.0);
  PdfSetTextColor(doc, page, 0.0, 0.0, 0.8);
  PdfTextAt(doc, page, 72.0, 680.0, "Blue Courier Text");

  var err: int64 := PdfSave(doc, "/tmp/pdf_color.pdf");
  PdfFree(doc);
  if (err != 0) {
    PrintStr("FAIL: PdfSave (color) returned ");
    PrintInt(err);
    PrintStr("\n");
    return 1;
  }
  PrintStr("OK: color text PDF saved to /tmp/pdf_color.pdf\n");
  return 0;
}

fn testTextBlock(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew returned 0\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_TIMES, 11.0);
  PdfSetLineSpacing(doc, page, 16.0);
  PdfTextBlock(doc, page, 72.0, 750.0, 450.0,
    "This is a word-wrapped text block. It should automatically break lines when the text exceeds the specified width of 450 points. Each line uses the configured line spacing of 16 points.");

  var err: int64 := PdfSave(doc, "/tmp/pdf_block.pdf");
  PdfFree(doc);
  if (err != 0) {
    PrintStr("FAIL: PdfSave (block) returned ");
    PrintInt(err);
    PrintStr("\n");
    return 1;
  }
  PrintStr("OK: text block PDF saved to /tmp/pdf_block.pdf\n");
  return 0;
}

fn testSpecialChars(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew returned 0\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 700.0, "Parens: (hello) and backslash: \\test\\");

  var err: int64 := PdfSave(doc, "/tmp/pdf_special.pdf");
  PdfFree(doc);
  if (err != 0) {
    PrintStr("FAIL: PdfSave (special) returned ");
    PrintInt(err);
    PrintStr("\n");
    return 1;
  }
  PrintStr("OK: special chars PDF saved to /tmp/pdf_special.pdf\n");
  return 0;
}

pub fn main(): int64 {
  if (testTextWidth()    != 0) { return 1; }
  if (testTextAt()       != 0) { return 1; }
  if (testTextColor()    != 0) { return 1; }
  if (testTextBlock()    != 0) { return 1; }
  if (testSpecialChars() != 0) { return 1; }
  PrintStr("All WP-PDF-03 text tests passed.\n");
  return 0;
}
