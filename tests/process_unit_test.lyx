// tests/process_unit_test.lyx — std.process gegen echte Prozesse.
//
// Die Unit war doppelt kaputt: sie deklarierte execve/execvp als rohes FFI
// (beide auf der harten Blacklist → Unit nicht übersetzbar), und ihr
// waitpid-Aufruf übergab die Zahl 0 als Status-„Zeiger", las den Status also nie
// zurück — Exit-Codes waren immer 0. Beides ist nur an laufenden Prozessen zu
// sehen, nicht am Compilieren, deshalb dieser Test.
//
// Prozess-Primitive kommen jetzt aus den Compiler-Builtins (sys_fork/sys_execve/
// sys_wait4/…), nicht aus FFI — die Blacklist bleibt unangetastet.

import std.io;
import std.process;

fn expect(name: pchar, got: int64, want: int64) {
  Print(name); Print(": ");
  if (got == want) { PrintLn("OK"); } else { Print("FAIL got="); PrintInt(got); Print(" want="); PrintInt(want); PrintLn(""); }
}

fn main(): int64 {
  // self_pid muss plausibel sein
  var pid: int64 := self_pid();
  if (pid > 1) { PrintLn("self_pid: OK"); } else { PrintLn("self_pid: FAIL"); }

  // run(/bin/true) = 0, run(/bin/false) = 1  -- prueft Exit-Code-Auslesung
  expect("run /bin/true", run("/bin/true"), 0);
  expect("run /bin/false", run("/bin/false"), 1);

  // shell: Exit-Code durchreichen
  expect("shell exit 7", shell("exit 7"), 7);
  expect("shell true", shell("true"), 0);

  // spawn + wait_for
  var p: int64 := spawn("/bin/true");
  if (p > 0) { PrintLn("spawn pid: OK"); } else { PrintLn("spawn pid: FAIL"); }
  expect("wait_for", wait_for(p), 0);

  // nicht existierendes Programm -> execve scheitert -> 127
  expect("run missing", run("/nonexistent_binary_xyz"), 127);
  return 0;
}
