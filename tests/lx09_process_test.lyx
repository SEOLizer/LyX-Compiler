// LX-09 Test: alle 14 Prozess-/Thread-Syscalls kompilieren + Syscall-Nummern prüfen.

import src.std.lyxos.process;
import src.std.alloc;

fn main(): int64 {
    // sys_version: ABI-Version abfragen
    var ver: int64 := sys_version();

    // sys_getpid / sys_gettid
    var pid: int64 := sys_getpid();
    var tid: int64 := sys_gettid();

    // sys_getrandom: 8 Bytes Zufall
    var rnd: int64 := alloc(8);
    sys_getrandom(rnd as pchar, 8, GRND_BLOCK);

    // sys_yield: CPU freigeben
    sys_yield();

    // sys_sleep_ns: 1 µs schlafen
    sys_sleep_ns(NS_PER_US);

    // sys_priority: eigene Priorität abfragen (pid=0 = selbst)
    sys_priority(0, PRIO_NORMAL);

    // sys_signal_mask: Maske lesen (mask=0 = keine Änderung)
    var prev: int64 := sys_signal_mask(0, 0);

    // sys_spawn: /bin/true starten (Fehler auf LyxOS-ELF ok)
    var opts: int64 := alloc(SPAWN_OPTS_SIZE);
    poke8(opts + SPAWN_OPTS_FLAGS,    0, SPAWN_NONE);
    poke8(opts + SPAWN_OPTS_CWD_FD,   0, -1);
    poke8(opts + SPAWN_OPTS_STDIN_FD,  0, 0);
    poke8(opts + SPAWN_OPTS_STDOUT_FD, 0, 1);
    poke8(opts + SPAWN_OPTS_STDERR_FD, 0, 2);
    poke8(opts + SPAWN_OPTS_STACK_SIZE, 0, 0);
    var child: int64 := sys_spawn(-1, "/bin/true"c, 0 as pchar, 0 as pchar, opts as pchar);

    // sys_wait: auf Kind warten (timeout 0 = nicht-blockierend)
    var status: int64 := alloc(8);
    sys_wait(child, status as pchar, 0);

    // sys_thread_spawn: nicht aufrufen (braucht gültige entry-fn-Adresse)
    // sys_thread_exit: nicht aufrufen (würde Thread beenden)
    // sys_exit / sys_exit_group: am Ende, aber nicht im Test (würden Prozess beenden)
    // → diese 3 werden durch direkten Aufruf in einem separaten Block erzwungen

    var dummy: int64 := 0;
    if dummy < 0 {
        // Toter Code — erzwingt Emission aller noreturn-Syscalls
        sys_exit(0);
        sys_thread_exit(0);
        sys_exit_group(0);
        var stack: int64 := alloc(65536);
        sys_thread_spawn(0 as pchar, stack as pchar, 65536, 0 as pchar);
    }

    return 0;
}
