// tests/grp04_mem_test.lyx
// WP-GRP-04 Abnahmetest: GraphMemStore

unit tests.grp04_mem_test;

import std.graphdb.core;
import std.graphdb.node;
import std.graphdb.edge;
import std.graphdb.mem;
import std.io;
import std.alloc;

fn makeNode(id: int64): int64 {
    var n: int64 := alloc(GNODE_SIZE);
    GraphNodeInit(n);
    poke64(n + GNODE_OFF_ID, id);
    return n;
}

fn makeEdge(id: int64, src: int64, tgt: int64): int64 {
    var e: int64 := alloc(GEDGE_SIZE);
    GraphEdgeInit(e);
    poke64(e + GEDGE_OFF_ID,        id);
    poke64(e + GEDGE_OFF_SOURCE,    src);
    poke64(e + GEDGE_OFF_TARGET,    tgt);
    poke64(e + GEDGE_OFF_CREATEDAT, GraphNow());
    return e;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    var s: int64 := alloc(GMEM_SIZE);
    GraphMemStoreInit(s);
    PrintLn("PASS: GraphMemStoreInit no crash"c);

    // Nodes anlegen
    var idA: int64 := GraphIDNew();
    var idB: int64 := GraphIDNew();
    var idC: int64 := GraphIDNew();
    var nA: int64  := makeNode(idA);
    var nB: int64  := makeNode(idB);
    var nC: int64  := makeNode(idC);

    // AddNode → GetNode gibt denselben Pointer zurück
    if (GraphMemStoreAddNode(s, nA) != 1) {
        PrintLn("FAIL: AddNode A"c); ok := 0;
    } else { PrintLn("PASS: AddNode A"c); }

    if (GraphMemStoreAddNode(s, nB) != 1) {
        PrintLn("FAIL: AddNode B"c); ok := 0;
    } else { PrintLn("PASS: AddNode B"c); }

    if (GraphMemStoreAddNode(s, nC) != 1) {
        PrintLn("FAIL: AddNode C"c); ok := 0;
    } else { PrintLn("PASS: AddNode C"c); }

    if (GraphMemStoreGetNode(s, idA) != nA) {
        PrintLn("FAIL: GetNode A pointer mismatch"c); ok := 0;
    } else { PrintLn("PASS: GetNode A"c); }

    // Doppelte Node-ID → AddNode gibt 0
    if (GraphMemStoreAddNode(s, nA) != 0) {
        PrintLn("FAIL: duplicate AddNode should return 0"c); ok := 0;
    } else { PrintLn("PASS: duplicate AddNode=0"c); }

    // Edge ohne createdAt → AddEdge gibt 0
    var eBad: int64 := alloc(GEDGE_SIZE);
    GraphEdgeInit(eBad);
    poke64(eBad + GEDGE_OFF_ID,     GraphIDNew());
    poke64(eBad + GEDGE_OFF_SOURCE, idA);
    poke64(eBad + GEDGE_OFF_TARGET, idB);
    if (GraphMemStoreAddEdge(s, eBad) != 0) {
        PrintLn("FAIL: edge without createdAt should return 0"c); ok := 0;
    } else { PrintLn("PASS: edge without createdAt=0"c); }

    // Edge mit ungültigem source → AddEdge gibt 0
    var eBad2: int64 := alloc(GEDGE_SIZE);
    GraphEdgeInit(eBad2);
    poke64(eBad2 + GEDGE_OFF_ID,        GraphIDNew());
    poke64(eBad2 + GEDGE_OFF_SOURCE,    99999);
    poke64(eBad2 + GEDGE_OFF_TARGET,    idB);
    poke64(eBad2 + GEDGE_OFF_CREATEDAT, GraphNow());
    if (GraphMemStoreAddEdge(s, eBad2) != 0) {
        PrintLn("FAIL: edge with invalid source should return 0"c); ok := 0;
    } else { PrintLn("PASS: edge with invalid source=0"c); }

    // Dreieck A→B, B→C, A→C
    var idE1: int64 := GraphIDNew();
    var idE2: int64 := GraphIDNew();
    var idE3: int64 := GraphIDNew();
    var eAB: int64  := makeEdge(idE1, idA, idB);
    var eBC: int64  := makeEdge(idE2, idB, idC);
    var eAC: int64  := makeEdge(idE3, idA, idC);

    if (GraphMemStoreAddEdge(s, eAB) != 1) {
        PrintLn("FAIL: AddEdge A->B"c); ok := 0;
    } else { PrintLn("PASS: AddEdge A->B"c); }

    if (GraphMemStoreAddEdge(s, eBC) != 1) {
        PrintLn("FAIL: AddEdge B->C"c); ok := 0;
    } else { PrintLn("PASS: AddEdge B->C"c); }

    if (GraphMemStoreAddEdge(s, eAC) != 1) {
        PrintLn("FAIL: AddEdge A->C"c); ok := 0;
    } else { PrintLn("PASS: AddEdge A->C"c); }

    // OutEdges für A → {idE1, idE3}
    var ebuf: int64 := alloc(10 * 8);
    var ecnt: int64 := GraphMemStoreOutEdges(s, idA, ebuf, 10);
    if (ecnt != 2) {
        PrintLn("FAIL: OutEdges A count != 2"c); ok := 0;
    } else { PrintLn("PASS: OutEdges A count=2"c); }
    free(ebuf, 10 * 8);

    // Neighbors für A → {idB, idC}
    var nbuf: int64 := alloc(10 * 8);
    var ncnt: int64 := GraphMemStoreNeighbors(s, idA, nbuf, 10);
    if (ncnt != 2) {
        PrintLn("FAIL: Neighbors A count != 2"c); ok := 0;
    } else { PrintLn("PASS: Neighbors A count=2"c); }

    // Prüfe dass idB und idC in den Nachbarn sind
    var foundB: int64 := 0;
    var foundC: int64 := 0;
    var ni: int64     := 0;
    while (ni < ncnt) {
        if (peek64(nbuf + ni * 8) == idB) { foundB := 1; }
        if (peek64(nbuf + ni * 8) == idC) { foundC := 1; }
        ni := ni + 1;
    }
    if (foundB != 1) {
        PrintLn("FAIL: Neighbors A missing B"c); ok := 0;
    } else { PrintLn("PASS: Neighbors A has B"c); }
    if (foundC != 1) {
        PrintLn("FAIL: Neighbors A missing C"c); ok := 0;
    } else { PrintLn("PASS: Neighbors A has C"c); }
    free(nbuf, 10 * 8);

    // Neighbors für B → {idC}
    var nbuf2: int64 := alloc(10 * 8);
    var ncnt2: int64 := GraphMemStoreNeighbors(s, idB, nbuf2, 10);
    if (ncnt2 != 1) {
        PrintLn("FAIL: Neighbors B count != 1"c); ok := 0;
    } else { PrintLn("PASS: Neighbors B count=1"c); }
    if (peek64(nbuf2) != idC) {
        PrintLn("FAIL: Neighbors B[0] != C"c); ok := 0;
    } else { PrintLn("PASS: Neighbors B[0]=C"c); }
    free(nbuf2, 10 * 8);

    // Stress: 1000 Nodes + 1000 Edges
    var ri: int64   := 0;
    var rnA: int64  := 0;
    var rnB: int64  := 0;
    var rIdA: int64 := 0;
    var rIdB: int64 := 0;
    var rIdE: int64 := 0;
    var re: int64   := 0;
    var prevId: int64 := 0;
    var prevPtr: int64 := 0;
    ri := 0;
    while (ri < 1000) {
        rnA := alloc(GNODE_SIZE);
        GraphNodeInit(rnA);
        rIdA := GraphIDNew();
        poke64(rnA + GNODE_OFF_ID, rIdA);
        GraphMemStoreAddNode(s, rnA);
        ri := ri + 1;
    }
    PrintLn("PASS: 1000 nodes no crash"c);

    // GetNode sanity nach vielen Inserts (letzten rIdA holen)
    prevPtr := GraphMemStoreGetNode(s, rIdA);
    if (prevPtr == 0) {
        PrintLn("FAIL: GetNode after stress"c); ok := 0;
    } else { PrintLn("PASS: GetNode after stress"c); }

    GraphMemStoreFree(s);
    free(s, GMEM_SIZE);
    PrintLn("PASS: GraphMemStoreFree no crash"c);

    // Cleanup bad-edge allocs
    GraphEdgeFree(eBad);
    free(eBad, GEDGE_SIZE);
    GraphEdgeFree(eBad2);
    free(eBad2, GEDGE_SIZE);

    if (ok != 0) {
        PrintLn("=== WP-GRP-04: ALL PASS ==="c);
    } else {
        PrintLn("=== WP-GRP-04: FAILURES ==="c);
    }
    return ok;
}
