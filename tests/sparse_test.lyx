// tests/sparse_test.lyx
// Selbstpruefende Testbatterie fuer std.sparse.
//
// Der Kern der Pruefung braucht keine fremden Sollwerte: JEDE duenne Funktion
// muss dasselbe liefern wie ihre dichte Schwester in std.dist auf demselben
// Vektor. Beide Wege sind unabhaengig geschrieben — der eine laeuft im
// Gleichlauf ueber Indizes, der andere stumpf ueber alle Dimensionen. Stimmen
// sie ueberein, ist der Gleichlauf richtig.
//
// Dazu strukturelle Aussagen (Cauchy-Schwarz, Dreiecksungleichung, Norm nach
// Normierung = 1), Sollwerte aus numpy/scipy, Randfaelle (leer, Nullvektor,
// disjunkt, identisch) und Negativkontrollen.

unit main;

import std.sparse;
import std.dist;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn TOL(): f64 { return 0.000000000001; }

fn Check(name: pchar, got: f64, want: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > TOL()) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

fn CheckT(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > tol) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr("\n"c);
  }
}

// Ein deterministischer Erzeuger fuer den Abgleich dicht/duenn.
var _s: int64 := 88172645463325252;

fn Rnd(m: int64): int64 {
  _s := (_s * 6364136223846793005 + 1442695040888963407) & 4611686018427387903;
  return (_s / 65536) % m;
}

fn RndVal(): f64 {
  var r: int64 := Rnd(20001) - 10000;
  return (r as f64) / 1000.0;
}

fn main(): int64 {
  var N: int64 := 12;
  var da: int64 := alloc(N * 8);
  var db: int64 := alloc(N * 8);
  var ia: int64 := alloc(N * 8);
  var va: int64 := alloc(N * 8);
  var ib: int64 := alloc(N * 8);
  var vb: int64 := alloc(N * 8);

  // ── Umwandlung dicht <-> duenn ─────────────────────────────────────────────
  var i: int64 := 0;
  while (i < N) {
    pokef64(da + i * 8, 0.0);
    i := i + 1;
  }
  pokef64(da + 1 * 8, 2.0);
  pokef64(da + 4 * 8, 0.0 - 3.0);
  pokef64(da + 9 * 8, 0.5);

  var na: int64 := SparseFromDense(da, N, 0.0, ia, va, N);
  CheckI("fromDenseNnz"c, na, 3);
  CheckI("fromDenseI0"c, peek64(ia), 1);
  CheckI("fromDenseI1"c, peek64(ia + 8), 4);
  CheckI("fromDenseI2"c, peek64(ia + 16), 9);
  var t0: f64 := peekf64(va);
  Check("fromDenseV0"c, t0, 2.0);
  var t1: f64 := peekf64(va + 8);
  var m3: f64 := 0.0 - 3.0;
  Check("fromDenseV1"c, t1, m3);
  CheckB("fromDenseSorted"c, SparseIsSorted(ia, na), true);

  // cap zu klein -> -1, kein Ueberlauf
  CheckI("fromDenseCap"c, SparseFromDense(da, N, 0.0, ia, va, 2), 0 - 1);
  na := SparseFromDense(da, N, 0.0, ia, va, N);

  // Rueckweg muss den Ausgangsvektor wiederherstellen
  var back: int64 := alloc(N * 8);
  CheckB("toDenseOk"c, SparseToDense(ia, va, na, back, N), true);
  var diff: int64 := 0;
  i := 0;
  while (i < N) {
    var x: f64 := peekf64(da + i * 8);
    var y: f64 := peekf64(back + i * 8);
    if (AbsF64(x - y) > TOL()) { diff := diff + 1; }
    i := i + 1;
  }
  CheckI("roundTrip"c, diff, 0);

  // Index ausserhalb -> false
  poke64(ia + 16, 99);
  CheckB("toDenseOob"c, SparseToDense(ia, va, na, back, N), false);
  poke64(ia + 16, 9);

  // eps filtert
  pokef64(da + 2 * 8, 0.0000001);
  CheckI("fromDenseEps"c, SparseFromDense(da, N, 0.001, ia, va, N), 3);
  CheckI("fromDenseNoEps"c, SparseFromDense(da, N, 0.0, ia, va, N), 4);
  pokef64(da + 2 * 8, 0.0);
  na := SparseFromDense(da, N, 0.0, ia, va, N);

  // ── Einzelzugriff ──────────────────────────────────────────────────────────
  var gv: f64 := SparseGet(ia, va, na, 4);
  Check("get4"c, gv, m3);
  gv := SparseGet(ia, va, na, 1);
  Check("get1"c, gv, 2.0);
  gv := SparseGet(ia, va, na, 9);
  Check("get9"c, gv, 0.5);
  gv := SparseGet(ia, va, na, 0);
  Check("getMissLow"c, gv, 0.0);
  gv := SparseGet(ia, va, na, 5);
  Check("getMissMid"c, gv, 0.0);
  gv := SparseGet(ia, va, na, 11);
  Check("getMissHigh"c, gv, 0.0);
  gv := SparseGet(ia, va, 0, 4);
  Check("getEmpty"c, gv, 0.0);

  // ── Normen gegen die dichte Fassung ────────────────────────────────────────
  var sn: f64 := SparseNorm(va, na);
  var dn: f64 := DistNorm(da, N);
  Check("normVsDense"c, sn, dn);
  var snq: f64 := SparseNormSq(va, na);
  var dnq: f64 := DistNormSq(da, N);
  Check("normSqVsDense"c, snq, dnq);
  Check("normSqIsSquare"c, snq, sn * sn);
  Check("normL1"c, SparseNormL1(va, na), 5.5);
  Check("normInf"c, SparseNormInf(va, na), 3.0);
  Check("normEmpty"c, SparseNorm(va, 0), 0.0);
  Check("normL1Empty"c, SparseNormL1(va, 0), 0.0);

  // Ueberlaufsicherheit: der dichte Weg mit Quadraten waere hier unendlich.
  var big: int64 := alloc(2 * 8);
  var bidx: int64 := alloc(2 * 8);
  poke64(bidx, 0);  poke64(bidx + 8, 7);
  pokef64(big, 1.0e180);
  pokef64(big + 8, 1.0e180);
  var bn: f64 := SparseNorm(big, 2);
  var wantBn: f64 := 1.4142135623730951e180;
  CheckT("normHuge"c, bn, wantBn, 1.0e166);
  pokef64(big, 1.0e-180);
  pokef64(big + 8, 1.0e-180);
  bn := SparseNorm(big, 2);
  var wantBs: f64 := 1.4142135623730951e-180;
  CheckT("normTiny"c, bn, wantBs, 1.0e-194);
  free(big, 2 * 8);  free(bidx, 2 * 8);

  // ── Skalarprodukt und Kosinus gegen die dichte Fassung ─────────────────────
  i := 0;
  while (i < N) {
    pokef64(db + i * 8, 0.0);
    i := i + 1;
  }
  pokef64(db + 0 * 8, 1.0);
  pokef64(db + 4 * 8, 2.0);
  pokef64(db + 9 * 8, 0.0 - 1.0);
  var nb: int64 := SparseFromDense(db, N, 0.0, ib, vb, N);
  CheckI("bNnz"c, nb, 3);

  // a = {1:2, 4:-3, 9:0.5}, b = {0:1, 4:2, 9:-1}
  // dot = (-3)(2) + (0.5)(-1) = -6.5
  var dot: f64 := SparseDot(ia, va, na, ib, vb, nb);
  var wantDot: f64 := 0.0 - 6.5;
  Check("dot"c, dot, wantDot);
  Check("dotSym"c, SparseDot(ib, vb, nb, ia, va, na), dot);

  var cs: f64 := SparseCosine(ia, va, na, ib, vb, nb);
  var cd: f64 := DistCosineSimilarity(da, db, N);
  Check("cosineVsDense"c, cs, cd);
  Check("cosineSym"c, SparseCosine(ib, vb, nb, ia, va, na), cs);
  Check("cosineDist"c, SparseCosineDist(ia, va, na, ib, vb, nb), 1.0 - cs);
  var ang: f64 := SparseAngular(ia, va, na, ib, vb, nb);
  var dang: f64 := DistAngular(da, db, N);
  Check("angularVsDense"c, ang, dang);

  // Abstaende gegen die dichte Fassung
  var se: f64 := SparseEuclid(ia, va, na, ib, vb, nb);
  var de: f64 := DistEuclid(da, db, N);
  Check("euclidVsDense"c, se, de);
  var sm: f64 := SparseManhattan(ia, va, na, ib, vb, nb);
  var dm: f64 := DistManhattan(da, db, N);
  Check("manhattanVsDense"c, sm, dm);

  // ── Randfaelle der Winkelmasse ─────────────────────────────────────────────
  // Identisch -> 1, Winkel 0
  Check("cosSelf"c, SparseCosine(ia, va, na, ia, va, na), 1.0);
  Check("angSelf"c, SparseAngular(ia, va, na, ia, va, na), 0.0);
  Check("euclidSelf"c, SparseEuclid(ia, va, na, ia, va, na), 0.0);

  // Vielfaches -> ebenfalls 1: der Kosinus misst nur die Richtung
  var sc: int64 := alloc(N * 8);
  i := 0;
  while (i < na) {
    var v: f64 := peekf64(va + i * 8);
    pokef64(sc + i * 8, v * 7.0);
    i := i + 1;
  }
  Check("cosScaled"c, SparseCosine(ia, va, na, ia, sc, na), 1.0);

  // Gegenrichtung -> -1
  i := 0;
  while (i < na) {
    var v: f64 := peekf64(va + i * 8);
    pokef64(sc + i * 8, 0.0 - v);
    i := i + 1;
  }
  Check("cosOpposite"c, SparseCosine(ia, va, na, ia, sc, na), 0.0 - 1.0);
  var pi: f64 := 3.141592653589793;
  CheckT("angOpposite"c, SparseAngular(ia, va, na, ia, sc, na), pi, 0.000000001);

  // Disjunkt -> Skalarprodukt 0, rechter Winkel
  var di: int64 := alloc(2 * 8);
  var dv: int64 := alloc(2 * 8);
  poke64(di, 0);  poke64(di + 8, 5);
  pokef64(dv, 3.0);  pokef64(dv + 8, 4.0);
  Check("dotDisjoint"c, SparseDot(ia, va, na, di, dv, 2), 0.0);
  Check("cosDisjoint"c, SparseCosine(ia, va, na, di, dv, 2), 0.0);
  CheckT("angDisjoint"c, SparseAngular(ia, va, na, di, dv, 2), pi / 2.0, 0.000000001);
  // Bei disjunkten Vektoren ist der Abstand die Wurzel aus der Summe beider
  // Quadratsummen — hier sqrt(||a||^2 + 25).
  var wantD: f64 := SqrtF64(SparseNormSq(va, na) + 25.0);
  Check("euclidDisjoint"c, SparseEuclid(ia, va, na, di, dv, 2), wantD);

  // Leer und Nullvektor
  Check("dotEmpty"c, SparseDot(ia, va, 0, ib, vb, nb), 0.0);
  Check("cosEmpty"c, SparseCosine(ia, va, 0, ib, vb, nb), 0.0);
  Check("euclidEmptyA"c, SparseEuclid(ia, va, 0, ib, vb, nb), DistNorm(db, N));
  Check("euclidEmptyBoth"c, SparseEuclid(ia, va, 0, ib, vb, 0), 0.0);
  var zi: int64 := alloc(8);
  var zv: int64 := alloc(8);
  poke64(zi, 3);  pokef64(zv, 0.0);
  Check("cosZeroVec"c, SparseCosine(ia, va, na, zi, zv, 1), 0.0);
  CheckB("normalizeZero"c, SparseNormalize(zv, 1), false);

  // ── Cauchy-Schwarz: |<a,b>| <= ||a||*||b|| ─────────────────────────────────
  var lhs: f64 := AbsF64(SparseDot(ia, va, na, ib, vb, nb));
  var rhs: f64 := SparseNorm(va, na) * SparseNorm(vb, nb);
  CheckB("cauchySchwarz"c, lhs <= rhs + TOL(), true);

  // Dreiecksungleichung fuer den euklidischen Abstand
  var ab: f64 := SparseEuclid(ia, va, na, ib, vb, nb);
  var ac: f64 := SparseEuclid(ia, va, na, di, dv, 2);
  var cb: f64 := SparseEuclid(di, dv, 2, ib, vb, nb);
  CheckB("triangleEuclid"c, ab <= ac + cb + TOL(), true);

  // Der Winkel ist eine Metrik, der Kosinus-Abstand nicht — beides gepruefte
  // Aussage, keine Behauptung.
  var wab: f64 := SparseAngular(ia, va, na, ib, vb, nb);
  var wac: f64 := SparseAngular(ia, va, na, di, dv, 2);
  var wcb: f64 := SparseAngular(di, dv, 2, ib, vb, nb);
  CheckB("triangleAngular"c, wab <= wac + wcb + 0.000000001, true);

  // ── Normieren ──────────────────────────────────────────────────────────────
  var nv: int64 := alloc(N * 8);
  i := 0;
  while (i < na) {
    var v: f64 := peekf64(va + i * 8);
    pokef64(nv + i * 8, v);
    i := i + 1;
  }
  CheckB("normalizeOk"c, SparseNormalize(nv, na), true);
  Check("normalizeLen"c, SparseNorm(nv, na), 1.0);
  // Richtung unveraendert
  Check("normalizeDir"c, SparseCosine(ia, va, na, ia, nv, na), 1.0);
  // Nach der Normierung beider Seiten ist das Skalarprodukt der Kosinus —
  // genau der im Kopf beschriebene Trick fuer Massenvergleiche.
  var nvb: int64 := alloc(N * 8);
  i := 0;
  while (i < nb) {
    var v: f64 := peekf64(vb + i * 8);
    pokef64(nvb + i * 8, v);
    i := i + 1;
  }
  SparseNormalize(nvb, nb);
  Check("normalizedDotIsCosine"c, SparseDot(ia, nv, na, ib, nvb, nb), cs);

  SparseScale(nv, na, 3.0);
  Check("scale"c, SparseNorm(nv, na), 3.0);
  SparseScale(nv, na, 0.0);
  Check("scaleZero"c, SparseNorm(nv, na), 0.0);

  // ── Rechnen ────────────────────────────────────────────────────────────────
  var oi: int64 := alloc(2 * N * 8);
  var ov: int64 := alloc(2 * N * 8);
  var od: int64 := alloc(N * 8);

  var m: int64 := SparseAdd(ia, va, na, ib, vb, nb, oi, ov, 2 * N);
  // Vereinigung von {1,4,9} und {0,4,9} = {0,1,4,9}
  CheckI("addNnz"c, m, 4);
  CheckB("addSorted"c, SparseIsSorted(oi, m), true);
  SparseToDense(oi, ov, m, od, N);
  var bad: int64 := 0;
  i := 0;
  while (i < N) {
    var xa: f64 := peekf64(da + i * 8);
    var xb: f64 := peekf64(db + i * 8);
    var x: f64 := xa + xb;
    var y: f64 := peekf64(od + i * 8);
    if (AbsF64(x - y) > TOL()) { bad := bad + 1; }
    i := i + 1;
  }
  CheckI("addVsDense"c, bad, 0);

  m := SparseSub(ia, va, na, ib, vb, nb, oi, ov, 2 * N);
  CheckI("subNnz"c, m, 4);
  SparseToDense(oi, ov, m, od, N);
  bad := 0;
  i := 0;
  while (i < N) {
    var xa: f64 := peekf64(da + i * 8);
    var xb: f64 := peekf64(db + i * 8);
    var x: f64 := xa - xb;
    var y: f64 := peekf64(od + i * 8);
    if (AbsF64(x - y) > TOL()) { bad := bad + 1; }
    i := i + 1;
  }
  CheckI("subVsDense"c, bad, 0);

  // a - a ist der Nullvektor: die Eintraege bleiben stehen (dokumentiert),
  // SparsePrune raeumt sie weg.
  m := SparseSub(ia, va, na, ia, va, na, oi, ov, 2 * N);
  CheckI("subSelfNnz"c, m, 3);
  Check("subSelfNorm"c, SparseNorm(ov, m), 0.0);
  CheckI("pruneAll"c, SparsePrune(oi, ov, m, 0.0), 0);

  // axpy mit Faktor
  var two: f64 := 2.0;
  m := SparseAxpy(ia, va, na, ib, vb, nb, two, oi, ov, 2 * N);
  SparseToDense(oi, ov, m, od, N);
  bad := 0;
  i := 0;
  while (i < N) {
    var xa: f64 := peekf64(da + i * 8);
    var xb: f64 := peekf64(db + i * 8);
    var x: f64 := xa + 2.0 * xb;
    var y: f64 := peekf64(od + i * 8);
    if (AbsF64(x - y) > TOL()) { bad := bad + 1; }
    i := i + 1;
  }
  CheckI("axpyVsDense"c, bad, 0);

  // cap zu klein
  CheckI("axpyCap"c, SparseAxpy(ia, va, na, ib, vb, nb, two, oi, ov, 2), 0 - 1);

  // Elementweises Produkt: nur der Schnitt {4,9}
  m := SparseHadamard(ia, va, na, ib, vb, nb, oi, ov, 2 * N);
  CheckI("hadamardNnz"c, m, 2);
  CheckI("hadamardI0"c, peek64(oi), 4);
  CheckI("hadamardI1"c, peek64(oi + 8), 9);
  var hv: f64 := peekf64(ov);
  Check("hadamardV0"c, hv, 0.0 - 6.0);
  hv := peekf64(ov + 8);
  Check("hadamardV1"c, hv, 0.0 - 0.5);
  // Summe der Produkte ist wieder das Skalarprodukt
  var hs: f64 := 0.0;
  i := 0;
  while (i < m) {
    var hvi: f64 := peekf64(ov + i * 8);
    hs := hs + hvi;
    i := i + 1;
  }
  Check("hadamardSumIsDot"c, hs, wantDot);
  CheckI("hadamardCap"c, SparseHadamard(ia, va, na, ib, vb, nb, oi, ov, 1), 0 - 1);
  CheckI("hadamardDisjoint"c,
         SparseHadamard(ia, va, na, di, dv, 2, oi, ov, 2 * N), 0);

  // ── Sortieren und Zusammenfassen ───────────────────────────────────────────
  var ui: int64 := alloc(8 * 8);
  var uv: int64 := alloc(8 * 8);
  poke64(ui + 0, 5);  pokef64(uv + 0, 1.0);
  poke64(ui + 8, 1);  pokef64(uv + 8, 2.0);
  poke64(ui + 16, 5); pokef64(uv + 16, 3.0);
  poke64(ui + 24, 0); pokef64(uv + 24, 4.0);
  poke64(ui + 32, 1); pokef64(uv + 32, 5.0);
  CheckB("unsortedDetected"c, SparseIsSorted(ui, 5), false);
  var un: int64 := SparseSort(ui, uv, 5);
  CheckI("sortNnz"c, un, 3);
  CheckB("sortSorted"c, SparseIsSorted(ui, un), true);
  CheckI("sortI0"c, peek64(ui), 0);
  CheckI("sortI1"c, peek64(ui + 8), 1);
  CheckI("sortI2"c, peek64(ui + 16), 5);
  var sv: f64 := peekf64(uv);
  Check("sortV0"c, sv, 4.0);
  sv := peekf64(uv + 8);
  Check("sortV1dup"c, sv, 7.0);   // 2 + 5
  sv := peekf64(uv + 16);
  Check("sortV2dup"c, sv, 4.0);   // 1 + 3
  CheckI("sortEmpty"c, SparseSort(ui, uv, 0), 0);
  CheckI("sortOne"c, SparseSort(ui, uv, 1), 1);

  // ── Indexmengen ────────────────────────────────────────────────────────────
  CheckI("overlap"c, SparseOverlap(ia, na, ib, nb), 2);
  CheckI("overlapSelf"c, SparseOverlap(ia, na, ia, na), na);
  CheckI("overlapDisjoint"c, SparseOverlap(ia, na, di, 2), 0);
  // |{1,4,9} n {0,4,9}| = 2, |u| = 4
  Check("jaccard"c, SparseJaccard(ia, na, ib, nb), 0.5);
  Check("jaccardSelf"c, SparseJaccard(ia, na, ia, na), 1.0);
  Check("jaccardDisjoint"c, SparseJaccard(ia, na, di, 2), 0.0);
  Check("jaccardEmpty"c, SparseJaccard(ia, 0, ib, 0), 1.0);
  Check("jaccardOneEmpty"c, SparseJaccard(ia, na, ib, 0), 0.0);

  // ── Suche in einer Sammlung ────────────────────────────────────────────────
  // Vier Vektoren, der dritte ist ein Vielfaches der Anfrage -> Kosinus 1.
  var CN: int64 := 4;
  var cIdx: int64 := alloc(CN * 8);
  var cVal: int64 := alloc(CN * 8);
  var cNnz: int64 := alloc(CN * 8);
  var k: int64 := 0;
  while (k < CN) {
    poke64(cIdx + k * 8, alloc(N * 8));
    poke64(cVal + k * 8, alloc(N * 8));
    k := k + 1;
  }
  // 0: b
  poke64(cNnz, nb);
  i := 0;
  while (i < nb) {
    poke64(peek64(cIdx) + i * 8, peek64(ib + i * 8));
    var v: f64 := peekf64(vb + i * 8);
    pokef64(peek64(cVal) + i * 8, v);
    i := i + 1;
  }
  // 1: disjunkt zur Anfrage
  poke64(cNnz + 8, 2);
  poke64(peek64(cIdx + 8), 0);      pokef64(peek64(cVal + 8), 3.0);
  poke64(peek64(cIdx + 8) + 8, 5);  pokef64(peek64(cVal + 8) + 8, 4.0);
  // 2: 7*a
  poke64(cNnz + 16, na);
  i := 0;
  while (i < na) {
    poke64(peek64(cIdx + 16) + i * 8, peek64(ia + i * 8));
    var v: f64 := peekf64(va + i * 8);
    pokef64(peek64(cVal + 16) + i * 8, v * 7.0);
    i := i + 1;
  }
  // 3: a mit Stoerung
  poke64(cNnz + 24, na);
  i := 0;
  while (i < na) {
    poke64(peek64(cIdx + 24) + i * 8, peek64(ia + i * 8));
    var v: f64 := peekf64(va + i * 8);
    pokef64(peek64(cVal + 24) + i * 8, v + 0.4);
    i := i + 1;
  }

  var osim: int64 := alloc(8);
  var best: int64 := SparseNearest(ia, va, na, cIdx, cVal, cNnz, CN, osim);
  CheckI("nearest"c, best, 2);
  var bsim: f64 := peekf64(osim);
  Check("nearestSim"c, bsim, 1.0);
  CheckI("nearestEmptyColl"c,
         SparseNearest(ia, va, na, cIdx, cVal, cNnz, 0, osim), 0 - 1);

  var tp: int64 := alloc(CN * 8);
  var ts: int64 := alloc(CN * 8);
  var tn: int64 := SparseTopK(ia, va, na, cIdx, cVal, cNnz, CN, 3, tp, ts);
  CheckI("topKn"c, tn, 3);
  CheckI("topK0"c, peek64(tp), 2);
  CheckI("topK1"c, peek64(tp + 8), 3);
  // absteigend sortiert
  var dec: bool := true;
  i := 1;
  while (i < tn) {
    var p: f64 := peekf64(ts + (i - 1) * 8);
    var q: f64 := peekf64(ts + i * 8);
    if (q > p) { dec := false; }
    i := i + 1;
  }
  CheckB("topKdesc"c, dec, true);
  var ts0: f64 := peekf64(ts);
  Check("topKbestSim"c, ts0, 1.0);
  // Der beste der Liste ist derselbe wie bei SparseNearest
  CheckI("topKmatchesNearest"c, peek64(tp), best);
  CheckI("topKmoreThanColl"c,
         SparseTopK(ia, va, na, cIdx, cVal, cNnz, CN, 99, tp, ts), CN);
  CheckI("topKzero"c,
         SparseTopK(ia, va, na, cIdx, cVal, cNnz, CN, 0, tp, ts), 0);
  CheckI("topKemptyColl"c,
         SparseTopK(ia, va, na, cIdx, cVal, cNnz, 0, 3, tp, ts), 0);

  // ── Zufallsabgleich duenn gegen dicht ──────────────────────────────────────
  //
  // 400 Paare mit wechselnder Besetzung. Jede duenne Funktion muss auf die
  // letzte Stelle mit ihrer dichten Schwester uebereinstimmen. Das ist die
  // eigentliche Pruefung des Gleichlaufs: die dichte Fassung kennt keine
  // Indexzeiger und kann deshalb nicht denselben Fehler machen.
  var badDot: int64 := 0;
  var badCos: int64 := 0;
  var badEuc: int64 := 0;
  var badMan: int64 := 0;
  var badAdd: int64 := 0;
  var badNrm: int64 := 0;
  var badGet: int64 := 0;

  var trial: int64 := 0;
  while (trial < 400) {
    var fill: int64 := 1 + Rnd(9);
    i := 0;
    while (i < N) {
      pokef64(da + i * 8, 0.0);
      pokef64(db + i * 8, 0.0);
      if (Rnd(10) < fill) {
        var x: f64 := RndVal();
        pokef64(da + i * 8, x);
      }
      if (Rnd(10) < fill) {
        var y: f64 := RndVal();
        pokef64(db + i * 8, y);
      }
      i := i + 1;
    }
    na := SparseFromDense(da, N, 0.0, ia, va, N);
    nb := SparseFromDense(db, N, 0.0, ib, vb, N);

    var sd: f64 := SparseDot(ia, va, na, ib, vb, nb);
    var dd: f64 := 0.0;
    i := 0;
    while (i < N) {
      var fa: f64 := peekf64(da + i * 8);
      var fb: f64 := peekf64(db + i * 8);
      dd := dd + fa * fb;
      i := i + 1;
    }
    if (AbsF64(sd - dd) > 0.000000001) { badDot := badDot + 1; }

    var c1: f64 := SparseCosine(ia, va, na, ib, vb, nb);
    var c2: f64 := DistCosineSimilarity(da, db, N);
    if (AbsF64(c1 - c2) > 0.000000001) { badCos := badCos + 1; }

    var e1: f64 := SparseEuclid(ia, va, na, ib, vb, nb);
    var e2: f64 := DistEuclid(da, db, N);
    if (AbsF64(e1 - e2) > 0.000000001) { badEuc := badEuc + 1; }

    var m1: f64 := SparseManhattan(ia, va, na, ib, vb, nb);
    var m2: f64 := DistManhattan(da, db, N);
    if (AbsF64(m1 - m2) > 0.000000001) { badMan := badMan + 1; }

    var r1: f64 := SparseNorm(va, na);
    var r2: f64 := DistNorm(da, N);
    if (AbsF64(r1 - r2) > 0.000000001) { badNrm := badNrm + 1; }

    var mm: int64 := SparseAdd(ia, va, na, ib, vb, nb, oi, ov, 2 * N);
    if (!SparseIsSorted(oi, mm)) { badAdd := badAdd + 1; }
    SparseToDense(oi, ov, mm, od, N);
    i := 0;
    while (i < N) {
      var ga: f64 := peekf64(da + i * 8);
      var gb: f64 := peekf64(db + i * 8);
      var x: f64 := ga + gb;
      var y: f64 := peekf64(od + i * 8);
      if (AbsF64(x - y) > 0.000000001) { badAdd := badAdd + 1; }
      i := i + 1;
    }

    // Einzelzugriff gegen das dichte Feld
    i := 0;
    while (i < N) {
      var g: f64 := SparseGet(ia, va, na, i);
      var x: f64 := peekf64(da + i * 8);
      if (AbsF64(g - x) > TOL()) { badGet := badGet + 1; }
      i := i + 1;
    }
    trial := trial + 1;
  }
  CheckI("fuzzDot"c, badDot, 0);
  CheckI("fuzzCosine"c, badCos, 0);
  CheckI("fuzzEuclid"c, badEuc, 0);
  CheckI("fuzzManhattan"c, badMan, 0);
  CheckI("fuzzNorm"c, badNrm, 0);
  CheckI("fuzzAdd"c, badAdd, 0);
  CheckI("fuzzGet"c, badGet, 0);

  // ── Negativkontrollen ──────────────────────────────────────────────────────
  //
  // Der Abgleich oben ist nur etwas wert, wenn er auch anschlaegt. Zwei
  // absichtliche Fehler:
  //
  // 1. Ein verbogener Wert muss die Uebereinstimmung zerstoeren.
  i := 0;
  while (i < N) {
    pokef64(da + i * 8, 0.0);
    i := i + 1;
  }
  pokef64(da + 1 * 8, 2.0);
  pokef64(da + 4 * 8, 0.0 - 3.0);
  pokef64(da + 9 * 8, 0.5);
  i := 0;
  while (i < N) {
    pokef64(db + i * 8, 0.0);
    i := i + 1;
  }
  pokef64(db + 0 * 8, 1.0);
  pokef64(db + 4 * 8, 2.0);
  pokef64(db + 9 * 8, 0.0 - 1.0);
  na := SparseFromDense(da, N, 0.0, ia, va, N);
  nb := SparseFromDense(db, N, 0.0, ib, vb, N);
  var keep: f64 := peekf64(va);
  var probe1: f64 := SparseNorm(va, na);
  var probe2: f64 := DistNorm(da, N);
  CheckB("negCtrlAgreeBefore"c, AbsF64(probe1 - probe2) < TOL(), true);
  pokef64(va, keep + 1.0);
  probe1 := SparseNorm(va, na);
  CheckB("negCtrlCatchesValue"c, AbsF64(probe1 - probe2) > 0.1, true);
  pokef64(va, keep);

  // 2. Unsortierte Indizes: der Gleichlauf uebersieht dann Eintraege. Genau
  //    deshalb ist die Sortierung Vorbedingung und SparseIsSorted oeffentlich.
  var wi: int64 := alloc(3 * 8);
  var wv: int64 := alloc(3 * 8);
  poke64(wi, 9);  poke64(wi + 8, 4);  poke64(wi + 16, 1);
  pokef64(wv, 0.5);  pokef64(wv + 8, 0.0 - 3.0);  pokef64(wv + 16, 2.0);
  CheckB("negCtrlUnsortedFlagged"c, SparseIsSorted(wi, 3), false);
  var wrong: f64 := SparseDot(wi, wv, 3, ib, vb, nb);
  var right: f64 := SparseDot(ia, va, na, ib, vb, nb);
  CheckB("negCtrlUnsortedWrong"c, AbsF64(wrong - right) > 0.1, true);
  // Nach dem Sortieren stimmt es wieder
  var wn: int64 := SparseSort(wi, wv, 3);
  Check("sortRepairs"c, SparseDot(wi, wv, wn, ib, vb, nb), right);
  free(wi, 3 * 8);  free(wv, 3 * 8);

  k := 0;
  while (k < CN) {
    free(peek64(cIdx + k * 8), N * 8);
    free(peek64(cVal + k * 8), N * 8);
    k := k + 1;
  }
  free(cIdx, CN * 8);  free(cVal, CN * 8);  free(cNnz, CN * 8);
  free(tp, CN * 8);  free(ts, CN * 8);  free(osim, 8);
  free(da, N * 8);  free(db, N * 8);  free(back, N * 8);  free(od, N * 8);
  free(ia, N * 8);  free(va, N * 8);  free(ib, N * 8);  free(vb, N * 8);
  free(sc, N * 8);  free(nv, N * 8);  free(nvb, N * 8);
  free(oi, 2 * N * 8);  free(ov, 2 * N * 8);
  free(di, 2 * 8);  free(dv, 2 * 8);  free(zi, 8);  free(zv, 8);
  free(ui, 8 * 8);  free(uv, 8 * 8);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
