// Sonderfaelle von fma(a, b, c), Erwartungen aus libm (glibc fma) erhoben.
// Geprueft wird BEIDER Weg: Hardware-FMA (vfmadd213sd) und der exakte
// ganzzahlige Rueckfall. NaN-Nutzbits und das NaN-Vorzeichen sind nicht
// festgelegt (IEEE 754-2019 §6.2), dort wird nur "ist NaN" verlangt.
unit main;
import std.io;
import std.fma;

var _fehler: int64 := 0;

fn istNanB(b: int64): int64 {
  if ((ShrU(b, 52) & 2047) == 2047 && (b & 4503599627370495) != 0) { return 1; }
  return 0;
}

fn pruef(name: pchar, ab: int64, bb: int64, cb: int64, erw: int64): void {
  var a: f64 := BitsF64(ab);
  var b: f64 := BitsF64(bb);
  var c: f64 := BitsF64(cb);
  var i: int64 := 0;
  while (i < 2) {
    FmaNurSoftware(i);
    var got: int64 := F64Bits(MathFma(a, b, c));
    var ok: int64 := 0;
    if (istNanB(erw) != 0) {
      if (istNanB(got) != 0) { ok := 1; }
    } else if (got == erw) { ok := 1; }
    if (ok != 0) {
      PrintStr("PASS "); PrintStr(name);
      if (i == 0) { PrintStrLn(" (hardware)"); } else { PrintStrLn(" (software)"); }
    } else {
      PrintStr("FAIL "); PrintStr(name);
      if (i == 0) { PrintStr(" (hardware)"); } else { PrintStr(" (software)"); }
      PrintStr(" erwartet="); PrintStr(IntToStr(erw));
      PrintStr(" bekommen="); PrintLn(got);
      _fehler := _fehler + 1;
    }
    i := i + 1;
  }
  FmaNurSoftware(0);
}

fn main(): int64 {
  pruef("einfach"c,                  4609434218613702656, 4611686018427387904, 4607182418800017408, 4616189618054758400);
  pruef("eine_rundung"c,             4607182418800017409, 4607182418800017409, -4616189618054758400, 4377498837804122112);
  pruef("ausloeschung_nach_inf"c,    9094988921128908188, 9094988921128908188, -4503599627370496, -4503599627370496);
  pruef("inf_mal_null_ist_nan"c,     9218868437227405312, 0, 4607182418800017408, 9221120237041090560);
  pruef("nan_in_c"c,                 4607182418800017408, 4607182418800017408, 9221120237041090560, 9221120237041090560);
  pruef("inf_minus_inf_ist_nan"c,    9218868437227405312, 4607182418800017408, -4503599627370496, 9221120237041090560);
  pruef("null_plus_minusnull"c,      0, 4607182418800017408, -9223372036854775808, 0);
  pruef("minusnull_plus_minusnull"c, -9223372036854775808, 4607182418800017408, -9223372036854775808, -9223372036854775808);
  pruef("subnormal_haelfte"c,        1, 4602678819172646912, 0, 0);
  pruef("subnormal_summe"c,          1, 1, 1, 1);
  pruef("ueberlauf_nach_inf"c,       9094988921128908188, 9094988921128908188, 4607182418800017408, 9218868437227405312);
  pruef("ueberlauf_negativ"c,        -128383115725867620, 9094988921128908188, 4607182418800017408, -4503599627370496);
  pruef("groesste_endliche"c,        9218868437227405311, 4607182418800017408, 0, 9218868437227405311);
  pruef("halb_ulp_abwaerts"c,        4607182418800017408, 4607182418800017408, 4368491638549381120, 4607182418800017408);
  pruef("halb_ulp_aufwaerts"c,       4607182418800017408, 4607182418800017408, 4368491638582935552, 4607182418800017409);
  pruef("c_dominiert"c,              4489465336364539835, 4728849860713775104, -4528558861725571482, -4528558877965663153);
  if (_fehler != 0) { PrintStr("FEHLER="); PrintLn(_fehler); return 1; }
  PrintStrLn("ALL PASS");
  return 0;
}
