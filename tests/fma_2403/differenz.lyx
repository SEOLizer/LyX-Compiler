unit main;
import std.io;
import std.string;
import std.fma;

// xorshift64* mit logischen Schiebern (Lyx' >> ist arithmetisch).
var _s: int64 := 0;
fn srand(seed: int64): void { _s := seed; }
fn rnd(): int64 {
  var x: int64 := _s;
  x := x ^ (x << 13);
  x := x ^ ShrU(x, 7);
  x := x ^ (x << 17);
  _s := x;
  return x;
}

// Muster mit realistischer Exponentenverteilung: zufaellige Mantisse, der
// Exponent aus einem engeren Bereich, damit Subnormale und Ueberlauf wirklich
// vorkommen und nicht nur Mittelwerte.
fn musterBits(art: int64): int64 {
  var m: int64 := rnd() & 4503599627370495;
  var e: int64 := 0;
  if (art == 0) { e := (rnd() & 2047); }                       // alles, auch inf/nan
  else if (art == 1) { e := 1023 + ((rnd() & 63) - 32); }      // nahe 1.0
  else if (art == 2) { e := (rnd() & 31); }                    // winzig, Subnormale
  else if (art == 3) { e := 2047 - (rnd() & 31); }             // riesig, Ueberlauf
  else { e := 1023 + ((rnd() & 1023) - 512); }                 // breit gestreut
  var s: int64 := rnd() & 1;
  var b: int64 := (m) | ((e & 2047) << 52);
  if (s != 0) { b := b | (1 << 63); }
  return b;
}

fn main(): int64 {
  var argc: int64 := GetArgC();
  var argv: pchar := GetArgV();
  var n: int64 := 200000;
  var art: int64 := 4;
  var seed: int64 := 88172645463325252;
  if (argc > 1) { var v: int64 := StrToInt(ArgvGet(argv, 1)); if (v > 0) { n := v; } }
  if (argc > 2) { art := StrToInt(ArgvGet(argv, 2)); }
  srand(seed);

  var pruefHw: int64 := 0;
  var pruefSw: int64 := 0;
  var abw: int64 := 0;
  var erstes: int64 := 0 - 1;
  var i: int64 := 0;
  while (i < n) {
    var ab: int64 := musterBits(art);
    var bb: int64 := musterBits(art);
    var cb: int64 := musterBits(art);
    var a: f64 := BitsF64(ab);
    var b: f64 := BitsF64(bb);
    var c: f64 := BitsF64(cb);
    FmaNurSoftware(0);
    var hw: int64 := F64Bits(MathFma(a, b, c));
    FmaNurSoftware(1);
    var sw: int64 := F64Bits(MathFma(a, b, c));
    // NaN-Muster duerfen sich in den Nutzbits unterscheiden; verglichen wird
    // dann nur "ist NaN". Alles andere BITGENAU.
    var beideNaN: int64 := 0;
    if ((ShrU(hw, 52) & 2047) == 2047 && (hw & 4503599627370495) != 0
        && (ShrU(sw, 52) & 2047) == 2047 && (sw & 4503599627370495) != 0) { beideNaN := 1; }
    if (hw != sw && beideNaN == 0) {
      abw := abw + 1;
      if (erstes < 0) {
        erstes := i;
        PrintStr("ERSTE ABWEICHUNG i="); PrintLn(i);
        PrintStr("  a="); PrintLn(ab);
        PrintStr("  b="); PrintLn(bb);
        PrintStr("  c="); PrintLn(cb);
        PrintStr("  hw="); PrintLn(hw);
        PrintStr("  sw="); PrintLn(sw);
      }
    }
    // NaN-Nutzbits sind nicht festgelegt; fuer die Pruefsumme normieren,
    // damit sie mit der C-Referenz vergleichbar ist.
    var nh: int64 := hw; var ns: int64 := sw;
    if ((ShrU(nh, 52) & 2047) == 2047 && (nh & 4503599627370495) != 0) { nh := 9221120237041090560; }
    if ((ShrU(ns, 52) & 2047) == 2047 && (ns & 4503599627370495) != 0) { ns := 9221120237041090560; }
    pruefHw := pruefHw ^ nh;   // normNaN
    pruefSw := pruefSw ^ ns;
    i := i + 1;
  }
  FmaNurSoftware(0);
  PrintStr("n="); PrintLn(n);
  PrintStr("abweichungen="); PrintLn(abw);
  PrintStr("pruef_hw="); PrintLn(pruefHw);
  PrintStr("pruef_sw="); PrintLn(pruefSw);
  return 0;
}
