// tests/grp06_file_test.lyx
// WP-GRP-06 Abnahmetest: GraphFileSave / GraphFileLoad

unit tests.grp06_file_test;

import std.graphdb.core;
import std.graphdb.node;
import std.graphdb.edge;
import std.graphdb.mem;
import std.graphdb.file;
import std.fs;
import std.io;
import std.alloc;

con TEST_PATH_LEN: int64 := 22;

fn getTestPath(): pchar { return "/tmp/grp06_test.lbf"c; }
fn getCorruptPath(): pchar { return "/tmp/grp06_corrupt.lbf"c; }

fn makeNode(id: int64): int64 {
    var n: int64 := alloc(GNODE_SIZE);
    GraphNodeInit(n);
    poke64(n + GNODE_OFF_ID, id);
    return n;
}

fn makeEdgeAt(id: int64, src: int64, tgt: int64, ts: int64): int64 {
    var e: int64 := alloc(GEDGE_SIZE);
    GraphEdgeInit(e);
    poke64(e + GEDGE_OFF_ID,        id);
    poke64(e + GEDGE_OFF_SOURCE,    src);
    poke64(e + GEDGE_OFF_TARGET,    tgt);
    poke64(e + GEDGE_OFF_CREATEDAT, ts);
    return e;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64     := 1;
    var s: int64      := 0;
    var s2: int64     := 0;
    var idA: int64    := 0;
    var idB: int64    := 0;
    var idC: int64    := 0;
    var nA: int64     := 0;
    var nB: int64     := 0;
    var nC: int64     := 0;
    var idE1: int64   := 0;
    var idE2: int64   := 0;
    var eAB: int64    := 0;
    var eBC: int64    := 0;
    var vbuf: int64   := 0;
    var ret: int64    := 0;
    var fsz: int64    := 0;
    var lnA: int64    := 0;
    var lnB: int64    := 0;
    var lnC: int64    := 0;
    var vdims: int64  := 0;
    var vb: int64     := 0;
    var v0: int64     := 0;
    var v1: int64     := 0;
    var age: int64    := 0;
    var slen: int64   := 0;
    var sp: pchar     := 0 as pchar;
    var ch0: int64    := 0;
    var ebuf: int64   := 0;
    var ecnt: int64   := 0;
    var eid: int64    := 0;
    var ep: int64     := 0;
    var wt: int64     := 0;
    var corrupt: pchar := 0 as pchar;
    var r2: int64     := 0;
    var s3: int64     := 0;
    var r3: int64     := 0;
    var cnt3n: int64  := 0;
    var cnt3e: int64  := 0;
    var slenPtr: int64 := 0;

    // ── Store aufbauen ────────────────────────────────────────
    s := alloc(GMEM_SIZE);
    GraphMemStoreInit(s);

    idA := GraphIDNew();
    idB := GraphIDNew();
    idC := GraphIDNew();
    nA := makeNode(idA);
    nB := makeNode(idB);
    nC := makeNode(idC);

    // nA: int-Prop "age"=42, str-Prop "name"="Alice", vec=[7,11]
    GraphNodeSetInt(nA, "age"c, 3, 42);
    GraphNodeSetStr(nA, "name"c, 4, "Alice"c, 5);
    vbuf := alloc(2 * 8);
    poke64(vbuf,     7);
    poke64(vbuf + 8, 11);
    GraphNodeSetVec(nA, 2, vbuf);
    free(vbuf, 2 * 8);

    GraphMemStoreAddNode(s, nA);
    GraphMemStoreAddNode(s, nB);
    GraphMemStoreAddNode(s, nC);

    idE1 := GraphIDNew();
    idE2 := GraphIDNew();
    eAB := makeEdgeAt(idE1, idA, idB, 1000);
    eBC := makeEdgeAt(idE2, idB, idC, 2000);
    GraphEdgeSetType(eAB, "KNOWS"c, 5);
    GraphEdgeSetInt(eAB, "weight"c, 6, 100);
    GraphEdgeSetType(eBC, "LIKES"c, 5);
    GraphMemStoreAddEdge(s, eAB);
    GraphMemStoreAddEdge(s, eBC);

    // ── WP-GRP-06-01: GraphFileSave ──────────────────────────
    ret := GraphFileSave(s, getTestPath(), TEST_PATH_LEN, 0);
    if (ret != 1) {
        PrintLn("FAIL: GraphFileSave returned 0"c); ok := 0;
    } else { PrintLn("PASS: GraphFileSave=1"c); }

    fsz := FileSize(getTestPath());
    if (fsz <= GFILE_HEADER_SIZE) {
        PrintLn("FAIL: saved file too small"c); ok := 0;
    } else { PrintLn("PASS: file size > header"c); }

    // ── WP-GRP-06-02: GraphFileLoad ──────────────────────────
    s2 := alloc(GMEM_SIZE);
    GraphMemStoreInit(s2);
    r2 := GraphFileLoad(s2, getTestPath(), TEST_PATH_LEN);
    if (r2 != 1) {
        PrintLn("FAIL: GraphFileLoad returned 0"c); ok := 0;
    } else { PrintLn("PASS: GraphFileLoad=1"c); }

    // ── WP-GRP-06-03: Node-IDs vorhanden ─────────────────────
    lnA := GraphMemStoreGetNode(s2, idA);
    if (lnA == 0) {
        PrintLn("FAIL: loaded nA not found"c); ok := 0;
    } else { PrintLn("PASS: loaded nA found"c); }

    lnB := GraphMemStoreGetNode(s2, idB);
    if (lnB == 0) {
        PrintLn("FAIL: loaded nB not found"c); ok := 0;
    } else { PrintLn("PASS: loaded nB found"c); }

    lnC := GraphMemStoreGetNode(s2, idC);
    if (lnC == 0) {
        PrintLn("FAIL: loaded nC not found"c); ok := 0;
    } else { PrintLn("PASS: loaded nC found"c); }

    // ── WP-GRP-06-04: Int-Property round-trip ────────────────
    if (lnA != 0) {
        age := GraphNodeGetInt(lnA, "age"c, 3);
        if (age != 42) {
            PrintLn("FAIL: int prop age != 42"c); ok := 0;
        } else { PrintLn("PASS: int prop age=42"c); }
    }

    // ── WP-GRP-06-05: Str-Property round-trip ────────────────
    if (lnA != 0) {
        slenPtr := alloc(8);
        poke64(slenPtr, 0);
        sp := GraphNodeGetStr(lnA, "name"c, 4, slenPtr);
        slen := peek64(slenPtr);
        free(slenPtr, 8);
        if (slen != 5) {
            PrintLn("FAIL: str prop len != 5"c); ok := 0;
        } else { PrintLn("PASS: str prop len=5"c); }
        if (sp == 0 as pchar) {
            PrintLn("FAIL: str prop ptr is null"c); ok := 0;
        } else {
            ch0 := peek8(sp as int64);
            if (ch0 != 65) {
                PrintLn("FAIL: str prop[0] != 'A'"c); ok := 0;
            } else { PrintLn("PASS: str prop[0]='A'"c); }
        }
    }

    // ── WP-GRP-06-06: Vector round-trip ──────────────────────
    if (lnA != 0) {
        vdims := peek64(lnA + GNODE_OFF_VECDIMS);
        if (vdims != 2) {
            PrintLn("FAIL: vec dims != 2"c); ok := 0;
        } else { PrintLn("PASS: vec dims=2"c); }
        vb := peek64(lnA + GNODE_OFF_VECBUF);
        if (vb == 0) {
            PrintLn("FAIL: vec buf is null"c); ok := 0;
        } else {
            v0 := peek64(vb);
            v1 := peek64(vb + 8);
            if (v0 != 7) {
                PrintLn("FAIL: vec[0] != 7"c); ok := 0;
            } else { PrintLn("PASS: vec[0]=7"c); }
            if (v1 != 11) {
                PrintLn("FAIL: vec[1] != 11"c); ok := 0;
            } else { PrintLn("PASS: vec[1]=11"c); }
        }
    }

    // ── WP-GRP-06-07: Edge round-trip (OutEdges + TypeEq) ────
    ebuf := alloc(10 * 8);
    ecnt := GraphMemStoreOutEdges(s2, idA, ebuf, 10);
    if (ecnt != 1) {
        PrintLn("FAIL: OutEdges A count != 1"c); ok := 0;
    } else { PrintLn("PASS: OutEdges A count=1"c); }

    if (ecnt >= 1) {
        eid := peek64(ebuf);
        ep  := GraphMemStoreGetEdge(s2, eid);
        if (ep == 0) {
            PrintLn("FAIL: loaded edge not found"c); ok := 0;
        } else {
            ret := GraphEdgeTypeEq(ep, "KNOWS"c, 5);
            if (ret != 1) {
                PrintLn("FAIL: edge type != KNOWS"c); ok := 0;
            } else { PrintLn("PASS: edge type=KNOWS"c); }
            wt := GraphEdgeGetInt(ep, "weight"c, 6);
            if (wt != 100) {
                PrintLn("FAIL: edge int prop weight != 100"c); ok := 0;
            } else { PrintLn("PASS: edge int prop weight=100"c); }
        }
    }
    free(ebuf, 10 * 8);

    GraphMemStoreFree(s2);
    free(s2, GMEM_SIZE);

    // ── WP-GRP-06-08: Corrupt file → returns 0 ───────────────
    corrupt := alloc(8) as pchar;
    poke8(corrupt as int64,     88);  // wrong magic
    poke8(corrupt as int64 + 1, 88);
    poke8(corrupt as int64 + 2, 88);
    poke8(corrupt as int64 + 3, 88);
    poke8(corrupt as int64 + 4, 88);
    poke8(corrupt as int64 + 5, 88);
    poke8(corrupt as int64 + 6, 88);
    poke8(corrupt as int64 + 7, 88);
    WriteFile(getCorruptPath(), corrupt, 8);
    free(corrupt as int64, 8);

    s2 := alloc(GMEM_SIZE);
    GraphMemStoreInit(s2);
    r2 := GraphFileLoad(s2, getCorruptPath(), 24);
    if (r2 != 0) {
        PrintLn("FAIL: corrupt file should return 0"c); ok := 0;
    } else { PrintLn("PASS: corrupt file returns 0"c); }
    GraphMemStoreFree(s2);
    free(s2, GMEM_SIZE);

    // ── WP-GRP-06-09: Non-existent file → returns 0 ──────────
    s2 := alloc(GMEM_SIZE);
    GraphMemStoreInit(s2);
    r2 := GraphFileLoad(s2, "/tmp/grp06_does_not_exist.lbf"c, 29);
    if (r2 != 0) {
        PrintLn("FAIL: missing file should return 0"c); ok := 0;
    } else { PrintLn("PASS: missing file returns 0"c); }
    GraphMemStoreFree(s2);
    free(s2, GMEM_SIZE);

    // ── WP-GRP-06-10: Leerer Store save + load ───────────────
    s3 := alloc(GMEM_SIZE);
    GraphMemStoreInit(s3);
    r3 := GraphFileSave(s3, "/tmp/grp06_empty.lbf"c, 20, 0);
    if (r3 != 1) {
        PrintLn("FAIL: empty store save returned 0"c); ok := 0;
    } else { PrintLn("PASS: empty store save=1"c); }
    GraphMemStoreFree(s3);
    free(s3, GMEM_SIZE);

    s3 := alloc(GMEM_SIZE);
    GraphMemStoreInit(s3);
    r3 := GraphFileLoad(s3, "/tmp/grp06_empty.lbf"c, 20);
    if (r3 != 1) {
        PrintLn("FAIL: empty store load returned 0"c); ok := 0;
    } else { PrintLn("PASS: empty store load=1"c); }
    cnt3n := peek64(s3 + GMEM_OFF_NODECOUNT);
    cnt3e := peek64(s3 + GMEM_OFF_EDGECOUNT);
    if (cnt3n != 0) {
        PrintLn("FAIL: empty store node count != 0"c); ok := 0;
    } else { PrintLn("PASS: empty store node count=0"c); }
    if (cnt3e != 0) {
        PrintLn("FAIL: empty store edge count != 0"c); ok := 0;
    } else { PrintLn("PASS: empty store edge count=0"c); }
    GraphMemStoreFree(s3);
    free(s3, GMEM_SIZE);

    // ── Cleanup ───────────────────────────────────────────────
    GraphMemStoreFree(s);
    free(s, GMEM_SIZE);
    DeleteFile(getTestPath());
    DeleteFile(getCorruptPath());
    DeleteFile("/tmp/grp06_empty.lbf"c);

    if (ok != 0) {
        PrintLn("=== WP-GRP-06: ALL PASS ==="c);
    } else {
        PrintLn("=== WP-GRP-06: FAILURES ==="c);
    }
    return ok;
}
