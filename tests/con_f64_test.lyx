// tests/con_f64_test.lyx
// Gleitkomma-Konstanten mit einer RECHNUNG im Anfangswert (#1853).
//
// Bis 1.1.13A rechnete die Konstantenfaltung ganzzahlig auf den IEEE-Bits.
// Das lieferte keine offensichtlichen Truemmer, sondern plausible Zahlen —
// deshalb ist jeder Sollwert hier von Hand nachgerechnet:
//
//     con H: f64 := 0.0 - 0.5    ergab  -8.0   (statt -0.5)
//     con M: f64 := 2.0 * 3.0    ergab   0.0   (statt 6.0)
//     con S: f64 := 0.25 + 0.25  ergab  "overflow"
//     con N: f64 := 0.0 / 0.0    ergab   0.0   (statt nan)
//
// Sechster Fall derselben Familie: #1373, #1499, #1512, #1801, #1803.
//
// Gemessen werden WERTE, nicht "uebersetzt". Und die Gegenprobe gehoert dazu:
// das reine Literal war immer richtig — ein Test ohne diesen Fall wuerde nicht
// merken, wenn der Fix den funktionierenden Weg mitnimmt.

unit main;

import std.io;
import std.math;

// Reine Literale — der Weg, der schon vorher stimmte.
pub con LIT_HALB:  f64 := 0.5;
pub con LIT_NEG:   f64 := -1.5;

// Rechnungen — der Weg, der still falsch war.
pub con ADD:       f64 := 0.25 + 0.25;
pub con SUB:       f64 := 0.0 - 0.5;
pub con MUL:       f64 := 2.0 * 3.0;
pub con DIV:       f64 := 1.0 / 2.0;

// Geschachtelt: der Ausdruck ist Gleitkomma, sobald es EIN Operand ist.
pub con VERKETTET: f64 := DIV * 3.0;
pub con UEBER_CON: f64 := 0.0 - DIV;

// Division durch 0 ist fuer Gleitkomma definiert und muss durchkommen —
// die ganzzahlige Fassung faengt sie ab und lieferte hier still 0.
pub con INF:       f64 := 1.0 / 0.0;
pub con NEG_INF:   f64 := 0.0 - 1.0 / 0.0;
pub con NAN_WERT:  f64 := 0.0 / 0.0;

// Vergleiche zwischen Gleitkommakonstanten. Der Fall mit den NEGATIVEN Zahlen
// ist der aussagekraeftige: als Bitmuster verglichen waere -1.5 < -2.5 wahr,
// weil dort das Vorzeichenbit vorne steht.
pub con KLEINER:      bool := 1.5 < 2.5;
pub con KLEINER_NEG:  bool := 0.0 - 1.5 < 0.0 - 2.5;
pub con GLEICH:       bool := 0.5 == 1.0 / 2.0;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn Check(name: pchar, got: f64, want: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) <= 0.000000001) {
    PrintStr("PASS "c); PrintStrLn(name);
  } else {
    PrintStr("FAIL "c); PrintStr(name);
    PrintStr(": erhalten "c); PrintF64(got);
    PrintStr(" erwartet "c); PrintF64(want); PrintLn(""c);
    _fails := _fails + 1;
  }
}

fn CheckBool(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got == want) { PrintStr("PASS "c); PrintStrLn(name); }
  else {
    PrintStr("FAIL "c); PrintStr(name); PrintStr(": erhalten "c); PrintBool(got);
    PrintStr(" erwartet "c); PrintBool(want); PrintLn(""c);
    _fails := _fails + 1;
  }
}

fn main(): int64 {
  // Gegenprobe: der Weg, der immer stimmte, stimmt weiterhin.
  Check("Literal 0.5"c,  LIT_HALB, 0.5);
  Check("Literal -1.5"c, LIT_NEG, 0.0 - 1.5);

  // Die vier Grundrechenarten im Anfangswert.
  Check("0.25 + 0.25 = 0.5"c, ADD, 0.5);
  Check("0.0 - 0.5 = -0.5"c,  SUB, 0.0 - 0.5);
  Check("2.0 * 3.0 = 6.0"c,   MUL, 6.0);
  Check("1.0 / 2.0 = 0.5"c,   DIV, 0.5);

  // Geschachtelt und ueber eine andere Konstante.
  Check("DIV * 3.0 = 1.5"c,   VERKETTET, 1.5);
  Check("0.0 - DIV = -0.5"c,  UEBER_CON, 0.0 - 0.5);

  // Division durch 0: inf, -inf, nan. Gemessen wird an der EIGENSCHAFT,
  // nicht am Zahlenwert — inf laesst sich nicht mit einer Toleranz pruefen.
  _checks := _checks + 1;
  var grosz: f64 := 1000000000000000000000.0;
  if (INF > grosz) { PrintStrLn("PASS 1.0 / 0.0 ist +inf"c); }
  else { PrintStr("FAIL 1.0 / 0.0 ist +inf: "c); PrintF64(INF); PrintLn(""c); _fails := _fails + 1; }

  _checks := _checks + 1;
  if (NEG_INF < 0.0 - grosz) { PrintStrLn("PASS -1.0 / 0.0 ist -inf"c); }
  else { PrintStr("FAIL -1.0 / 0.0 ist -inf: "c); PrintF64(NEG_INF); PrintLn(""c); _fails := _fails + 1; }

  // NaN ist der einzige Wert, der sich selbst ungleich ist.
  _checks := _checks + 1;
  if (NAN_WERT != NAN_WERT) { PrintStrLn("PASS 0.0 / 0.0 ist NaN"c); }
  else { PrintStr("FAIL 0.0 / 0.0 ist NaN: "c); PrintF64(NAN_WERT); PrintLn(""c); _fails := _fails + 1; }

  // Vergleiche.
  CheckBool("1.5 < 2.5"c, KLEINER, true);
  // Der Fall, der den Bitmuster-Vergleich entlarvt: als Bits waere das wahr.
  CheckBool("-1.5 < -2.5 ist falsch"c, KLEINER_NEG, false);
  CheckBool("0.5 == 1.0/2.0"c, GLEICH, true);

  PrintStr("\n"c);
  PrintInt(_checks); PrintStr(" Pruefungen, "c);
  PrintInt(_fails); PrintStrLn(" FAIL"c);
  if (_fails == 0) { PrintStrLn("OK: con f64 mit Rechnung"c); return 0; }
  return 1;
}
