// tests/convolve_test.lyx
// Selbstpruefende Testbatterie fuer std.conv.
//
// Sollwerte fuer full/same/valid und die Korrelation aus numpy
// (np.convolve, np.correlate). Randmodi und 2D aus einer unabhaengig in Python
// geschriebenen Referenzschleife — nicht aus derselben Formel, die hier laeuft.

unit main;

import std.convolve;
import std.fft;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn TOL(): f64 { return 0.000000001; }
fn FTOL(): f64 { return 0.000001; }   // FFT-Weg: Drehfaktoren aus sin/cos

// peekf64 gehoert erst in eine typisierte Variable, sonst wird der Wert im
// Ausdruck nicht als f64 gefuehrt.
fn V(p: int64, i: int64): f64 {
  var v: f64 := peekf64(p + i * 8);
  return v;
}

fn Check(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > tol) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" (bool)\n"c);
  }
}

fn Sig5(p: int64): void {
  pokef64(p,      1.0);  pokef64(p +  8, 2.0);  pokef64(p + 16, 3.0);
  pokef64(p + 24, 4.0);  pokef64(p + 32, 5.0);
}

fn main(): int64 {
  var a: int64 := alloc(5 * 8);
  var k: int64 := alloc(3 * 8);
  var out: int64 := alloc(16 * 8);
  Sig5(a);
  // Kern [1, 0, -1] — unsymmetrisch, deshalb taugt er, um Faltung von
  // Korrelation zu unterscheiden
  pokef64(k, 1.0);  pokef64(k + 8, 0.0);  pokef64(k + 16, -1.0);

  // ── Ausgabelaengen ────────────────────────────────────────────────────────
  CheckI("lenFull"c,  ConvOutputLen(5, 3, CONV_FULL),  7);
  CheckI("lenSame"c,  ConvOutputLen(5, 3, CONV_SAME),  5);
  CheckI("lenValid"c, ConvOutputLen(5, 3, CONV_VALID), 3);
  CheckI("lenValidTooBig"c, ConvOutputLen(3, 5, CONV_VALID), -1);
  CheckI("lenBadMode"c, ConvOutputLen(5, 3, 99), -1);
  CheckI("lenBadN"c,  ConvOutputLen(0, 3, CONV_FULL), -1);

  // ── full (numpy: [1, 2, 2, 2, 2, -4, -5]) ─────────────────────────────────
  CheckB("fullOk"c, ConvDirect(a, 5, k, 3, CONV_FULL, CONV_EDGE_ZERO, out), true);
  Check("full0"c, V(out, 0),  1.0, TOL());
  Check("full1"c, V(out, 1),  2.0, TOL());
  Check("full3"c, V(out, 3),  2.0, TOL());
  Check("full5"c, V(out, 5), -4.0, TOL());
  Check("full6"c, V(out, 6), -5.0, TOL());

  // ── same, Null-Rand (numpy 'same': [2, 2, 2, 2, -4]) ──────────────────────
  ConvDirect(a, 5, k, 3, CONV_SAME, CONV_EDGE_ZERO, out);
  Check("same0"c, V(out, 0),  2.0, TOL());
  Check("same2"c, V(out, 2),  2.0, TOL());
  Check("same4"c, V(out, 4), -4.0, TOL());

  // ── valid (numpy 'valid': [2, 2, 2]) ──────────────────────────────────────
  ConvDirect(a, 5, k, 3, CONV_VALID, CONV_EDGE_ZERO, out);
  Check("valid0"c, V(out, 0), 2.0, TOL());
  Check("valid2"c, V(out, 2), 2.0, TOL());

  // ── Korrelation: gespiegeltes Vorzeichen ──────────────────────────────────
  // numpy correlate 'full': [-1, -2, -2, -2, -2, 4, 5]
  CheckB("corrOk"c, ConvCorrelateDirect(a, 5, k, 3, CONV_FULL, CONV_EDGE_ZERO, out), true);
  Check("corr0"c, V(out, 0), -1.0, TOL());
  Check("corr5"c, V(out, 5),  4.0, TOL());
  Check("corr6"c, V(out, 6),  5.0, TOL());

  // symmetrischer Kern: Faltung und Korrelation fallen zusammen
  var ks: int64 := alloc(3 * 8);
  pokef64(ks, 0.25);  pokef64(ks + 8, 0.5);  pokef64(ks + 16, 0.25);
  var o2: int64 := alloc(16 * 8);
  ConvDirect(a, 5, ks, 3, CONV_SAME, CONV_EDGE_ZERO, out);
  ConvCorrelateDirect(a, 5, ks, 3, CONV_SAME, CONV_EDGE_ZERO, o2);
  var symSame: bool := true;
  var i: int64 := 0;
  while (i < 5) {
    if (AbsF64(V(out, i) - V(o2, i)) > TOL()) { symSame := false; }
    i := i + 1;
  }
  CheckB("symKernelEqual"c, symSame, true);

  // ── Randmodi (Referenzschleife in Python) ─────────────────────────────────
  // Glaettungskern [0.25, 0.5, 0.25] auf [1,2,3,4,5]
  ConvDirect(a, 5, ks, 3, CONV_SAME, CONV_EDGE_ZERO, out);
  Check("edgeZero0"c, V(out, 0), 1.0,  TOL());
  Check("edgeZero4"c, V(out, 4), 3.5,  TOL());
  Check("edgeZero2"c, V(out, 2), 3.0,  TOL());

  ConvDirect(a, 5, ks, 3, CONV_SAME, CONV_EDGE_CLAMP, out);
  Check("edgeClamp0"c, V(out, 0), 1.25, TOL());
  Check("edgeClamp4"c, V(out, 4), 4.75, TOL());

  ConvDirect(a, 5, ks, 3, CONV_SAME, CONV_EDGE_REFLECT, out);
  Check("edgeRefl0"c, V(out, 0), 1.25, TOL());
  Check("edgeRefl4"c, V(out, 4), 4.75, TOL());

  ConvDirect(a, 5, ks, 3, CONV_SAME, CONV_EDGE_WRAP, out);
  Check("edgeWrap0"c, V(out, 0), 2.25, TOL());
  Check("edgeWrap4"c, V(out, 4), 3.75, TOL());

  // Ein Kern laenger als das Signal darf den Rand nicht ueberlaufen
  var kbig: int64 := alloc(9 * 8);
  ConvKernelBox(kbig, 9);
  CheckB("longKernelOk"c, ConvDirect(a, 5, kbig, 9, CONV_SAME, CONV_EDGE_REFLECT, out), true);
  // Mittelwert eines Glaettungskerns ueber ein monotones Signal bleibt im
  // Wertebereich — ein Ueberlauf faellt hier sofort auf
  var inRange: bool := true;
  i := 0;
  while (i < 5) {
    var v: f64 := V(out, i);
    if (v < 1.0) { inRange := false; }
    if (v > 5.0) { inRange := false; }
    i := i + 1;
  }
  CheckB("longKernelRange"c, inRange, true);
  free(kbig, 9 * 8);

  // ── Faltungs-Grundeigenschaften ───────────────────────────────────────────
  // Einheitsimpuls als Kern gibt das Signal zurueck
  var dk: int64 := alloc(8);
  pokef64(dk, 1.0);
  ConvDirect(a, 5, dk, 1, CONV_FULL, CONV_EDGE_ZERO, out);
  Check("deltaKern0"c, V(out, 0), 1.0, TOL());
  Check("deltaKern4"c, V(out, 4), 5.0, TOL());
  free(dk, 8);

  // Kommutativitaet: a*k = k*a (bei FULL)
  ConvDirect(a, 5, k, 3, CONV_FULL, CONV_EDGE_ZERO, out);
  ConvDirect(k, 3, a, 5, CONV_FULL, CONV_EDGE_ZERO, o2);
  var commut: bool := true;
  i := 0;
  while (i < 7) {
    if (AbsF64(V(out, i) - V(o2, i)) > TOL()) { commut := false; }
    i := i + 1;
  }
  CheckB("commutative"c, commut, true);

  // Summe der Ausgabe = Summe(a) * Summe(k) — gilt fuer FULL immer
  ConvDirect(a, 5, ks, 3, CONV_FULL, CONV_EDGE_ZERO, out);
  var sum: f64 := 0.0;
  i := 0;
  while (i < 7) {
    sum := sum + V(out, i);
    i := i + 1;
  }
  Check("sumProduct"c, sum, 15.0, 0.0000001);   // 15 * 1.0

  // ── FFT-Weg gegen den direkten ────────────────────────────────────────────
  CheckB("fftOk"c, ConvFft(a, 5, k, 3, CONV_FULL, o2), true);
  ConvDirect(a, 5, k, 3, CONV_FULL, CONV_EDGE_ZERO, out);
  var fftSame: bool := true;
  i := 0;
  while (i < 7) {
    if (AbsF64(V(out, i) - V(o2, i)) > FTOL()) { fftSame := false; }
    i := i + 1;
  }
  CheckB("fftEqDirect"c, fftSame, true);

  ConvFft(a, 5, k, 3, CONV_SAME, o2);
  ConvDirect(a, 5, k, 3, CONV_SAME, CONV_EDGE_ZERO, out);
  var fftSame2: bool := true;
  i := 0;
  while (i < 5) {
    if (AbsF64(V(out, i) - V(o2, i)) > FTOL()) { fftSame2 := false; }
    i := i + 1;
  }
  CheckB("fftEqDirectSame"c, fftSame2, true);

  // ConvFilter waehlt: kurzer Kern -> direkt, mit Rand -> direkt
  CheckB("filterOk"c, ConvFilter(a, 5, ks, 3, CONV_SAME, CONV_EDGE_CLAMP, out), true);
  Check("filterClamp0"c, V(out, 0), 1.25, TOL());

  // ── langes Signal: direkt, FFT und Overlap-Add muessen uebereinstimmen ────
  var bigN: int64 := 500;
  var kN: int64 := 40;
  var big: int64 := alloc(bigN * 8);
  var kk: int64 := alloc(kN * 8);
  i := 0;
  while (i < bigN) {
    pokef64(big + i * 8, SinF64((i as f64) * 0.1) + 0.5 * (i as f64) / 100.0);
    i := i + 1;
  }
  ConvKernelGauss1D(kk, kN, 6.0);

  var fullLen: int64 := bigN + kN - 1;
  var dOut: int64 := alloc(fullLen * 8);
  var fOut: int64 := alloc(fullLen * 8);
  var oOut: int64 := alloc(fullLen * 8);

  ConvDirect(big, bigN, kk, kN, CONV_FULL, CONV_EDGE_ZERO, dOut);
  ConvFft(big, bigN, kk, kN, CONV_FULL, fOut);
  CheckB("olaOk"c, ConvOverlapAdd(big, bigN, kk, kN, 64, oOut), true);

  var worstF: f64 := 0.0;
  var worstO: f64 := 0.0;
  i := 0;
  while (i < fullLen) {
    var dv: f64 := V(dOut, i);
    var e1: f64 := AbsF64(dv - V(fOut, i));
    var e2: f64 := AbsF64(dv - V(oOut, i));
    if (e1 > worstF) { worstF := e1; }
    if (e2 > worstO) { worstO := e2; }
    i := i + 1;
  }
  Check("fftVsDirectLong"c, worstF, 0.0, FTOL());
  Check("olaVsDirect"c, worstO, 0.0, FTOL());

  // Blockgroesse darf das Ergebnis nicht aendern
  ConvOverlapAdd(big, bigN, kk, kN, 128, fOut);
  var worstB: f64 := 0.0;
  i := 0;
  while (i < fullLen) {
    var e: f64 := AbsF64(V(oOut, i) - V(fOut, i));
    if (e > worstB) { worstB := e; }
    i := i + 1;
  }
  Check("olaBlockSize"c, worstB, 0.0, FTOL());
  CheckB("olaBadBlock"c, ConvOverlapAdd(big, bigN, kk, kN, 0, oOut), false);

  free(big, bigN * 8);  free(kk, kN * 8);
  free(dOut, fullLen * 8);  free(fOut, fullLen * 8);  free(oOut, fullLen * 8);

  // ── Kernel ────────────────────────────────────────────────────────────────
  var box: int64 := alloc(4 * 8);
  CheckB("boxOk"c, ConvKernelBox(box, 4), true);
  Check("box0"c, V(box, 0), 0.25, TOL());
  Check("boxSum"c, ConvKernelSum(box, 4), 1.0, TOL());
  free(box, 4 * 8);

  var g5: int64 := alloc(5 * 8);
  CheckB("gaussOk"c, ConvKernelGauss1D(g5, 5, 1.0), true);
  Check("gaussSum"c, ConvKernelSum(g5, 5), 1.0, 0.0000001);
  Check("gauss0"c, V(g5, 0), 0.05448868454964295, 0.0000001);
  Check("gauss2"c, V(g5, 2), 0.4026199540412157, 0.0000001);
  // symmetrisch
  Check("gaussSym"c, V(g5, 1), V(g5, 3), 0.0000001);
  CheckB("gaussBadSigma"c, ConvKernelGauss1D(g5, 5, 0.0), false);

  CheckI("gaussLen1"c, ConvGaussLen(1.0), 7);
  CheckI("gaussLen2"c, ConvGaussLen(2.0), 13);
  CheckI("gaussLenTiny"c, ConvGaussLen(0.1), 1);

  var g2d: int64 := alloc(9 * 8);
  CheckB("gauss2dOk"c, ConvKernelGauss2D(g2d, 3, 1.0), true);
  Check("gauss2dSum"c, ConvKernelSum(g2d, 9), 1.0, 0.0000001);
  // Mitte ist das Maximum
  var maxMid: bool := true;
  i := 0;
  while (i < 9) {
    if (i != 4) {
      if (V(g2d, i) > V(g2d, 4)) { maxMid := false; }
    }
    i := i + 1;
  }
  CheckB("gauss2dPeak"c, maxMid, true);
  free(g2d, 9 * 8);

  // Kerne mit Summe 0 lassen sich nicht normieren — und das ist richtig so
  var sob: int64 := alloc(9 * 8);
  ConvKernelSobelX(sob);
  Check("sobelSum"c, ConvKernelSum(sob, 9), 0.0, TOL());
  CheckB("normalizeZeroSum"c, ConvNormalize(sob, 9), false);
  Check("sobelX0"c, V(sob, 0), -1.0, TOL());
  Check("sobelX3"c, V(sob, 3), -2.0, TOL());
  Check("sobelX5"c, V(sob, 5),  2.0, TOL());
  ConvKernelSobelY(sob);
  Check("sobelY1"c, V(sob, 1), -2.0, TOL());
  Check("sobelY7"c, V(sob, 7),  2.0, TOL());
  ConvKernelLaplace(sob);
  Check("lapCenter"c, V(sob, 4), -4.0, TOL());
  Check("lapSum"c, ConvKernelSum(sob, 9), 0.0, TOL());
  ConvKernelSharpen(sob);
  Check("sharpSum"c, ConvKernelSum(sob, 9), 1.0, TOL());
  Check("sharpCenter"c, V(sob, 4), 5.0, TOL());

  // ── 2D ────────────────────────────────────────────────────────────────────
  // Bild 4x3 mit 1..12
  var w: int64 := 4;
  var h: int64 := 3;
  var img: int64 := alloc(12 * 8);
  i := 0;
  while (i < 12) {
    pokef64(img + i * 8, (i + 1) as f64);
    i := i + 1;
  }
  var oimg: int64 := alloc(12 * 8);

  // Identitaetskern: Bild bleibt Bild
  var idk: int64 := alloc(9 * 8);
  i := 0;
  while (i < 9) { pokef64(idk + i * 8, 0.0); i := i + 1; }
  pokef64(idk + 4 * 8, 1.0);
  CheckB("conv2dOk"c, Conv2D(img, w, h, idk, 3, 3, CONV_EDGE_CLAMP, oimg), true);
  var ident2d: bool := true;
  i := 0;
  while (i < 12) {
    if (AbsF64(V(oimg, i) - V(img, i)) > TOL()) { ident2d := false; }
    i := i + 1;
  }
  CheckB("conv2dIdentity"c, ident2d, true);
  CheckB("conv2dAlias"c, Conv2D(img, w, h, idk, 3, 3, CONV_EDGE_CLAMP, img), false);
  free(idk, 9 * 8);

  // Laplace mit Null-Rand (Referenzschleife)
  ConvKernelLaplace(sob);
  Conv2D(img, w, h, sob, 3, 3, CONV_EDGE_ZERO, oimg);
  Check("lap2dZero00"c, V(oimg, 0),   3.0, TOL());
  Check("lap2dZero03"c, V(oimg, 3),  -5.0, TOL());
  Check("lap2dZero11"c, V(oimg, 5),   0.0, TOL());
  Check("lap2dZero23"c, V(oimg, 11), -29.0, TOL());

  // Laplace mit fortgesetztem Rand
  Conv2D(img, w, h, sob, 3, 3, CONV_EDGE_CLAMP, oimg);
  Check("lap2dClamp00"c, V(oimg, 0),  5.0, TOL());
  Check("lap2dClamp11"c, V(oimg, 5),  0.0, TOL());
  Check("lap2dClamp23"c, V(oimg, 11), -5.0, TOL());
  // im Inneren eines linearen Verlaufs ist der Laplace-Operator null
  Check("lap2dInner"c, V(oimg, 6), 0.0, TOL());

  // Sobel-X als Korrelation, fortgesetzter Rand: ueberall waagerechter Anstieg
  ConvKernelSobelX(sob);
  Conv2DCorrelate(img, w, h, sob, 3, 3, CONV_EDGE_CLAMP, oimg);
  Check("sobel2d00"c, V(oimg, 0), 4.0, TOL());
  Check("sobel2d01"c, V(oimg, 1), 8.0, TOL());
  Check("sobel2d03"c, V(oimg, 3), 4.0, TOL());
  Check("sobel2d11"c, V(oimg, 5), 8.0, TOL());

  // Faltung und Korrelation unterscheiden sich beim Sobel im Vorzeichen
  Conv2D(img, w, h, sob, 3, 3, CONV_EDGE_CLAMP, oimg);
  Check("sobel2dConv01"c, V(oimg, 1), -8.0, TOL());

  // ── separabel gegen 2D ────────────────────────────────────────────────────
  var kx: int64 := alloc(7 * 8);
  ConvKernelGauss1D(kx, 7, 1.0);
  var sep: int64 := alloc(12 * 8);
  CheckB("sepOk"c, Conv2DSeparable(img, w, h, kx, 7, kx, 7, CONV_EDGE_CLAMP, sep), true);
  // Referenzschleife in Python, zwei getrennte Durchgaenge
  Check("sep00"c, V(sep, 0),  2.7990005030323966, 0.0000001);
  Check("sep03"c, V(sep, 3),  5.072307424739048,  0.0000001);
  Check("sep11"c, V(sep, 5),  6.0584386307976565, 0.0000001);
  Check("sep23"c, V(sep, 11), 10.200999496967603, 0.0000001);

  // dasselbe ueber den vollen 2D-Kern: separabel und voll muessen
  // uebereinstimmen, sonst ist die Trennung falsch
  var full2d: int64 := alloc(49 * 8);
  var yy: int64 := 0;
  while (yy < 7) {
    var xx: int64 := 0;
    while (xx < 7) {
      pokef64(full2d + (yy * 7 + xx) * 8, V(kx, yy) * V(kx, xx));
      xx := xx + 1;
    }
    yy := yy + 1;
  }
  var full2dOut: int64 := alloc(12 * 8);
  Conv2D(img, w, h, full2d, 7, 7, CONV_EDGE_CLAMP, full2dOut);
  var sepEq: bool := true;
  i := 0;
  while (i < 12) {
    if (AbsF64(V(sep, i) - V(full2dOut, i)) > 0.0000001) { sepEq := false; }
    i := i + 1;
  }
  CheckB("sepEqFull"c, sepEq, true);
  free(full2d, 49 * 8);  free(full2dOut, 12 * 8);

  // Gauss-Weichzeichnung: Mittelwert bleibt erhalten (Kern summiert zu 1),
  // Streuung nimmt ab
  var blur: int64 := alloc(12 * 8);
  CheckB("blurOk"c, Conv2DGaussBlur(img, w, h, 1.0, CONV_EDGE_CLAMP, blur), true);
  var sIn: f64 := 0.0;
  var sOut2: f64 := 0.0;
  i := 0;
  while (i < 12) {
    sIn := sIn + V(img, i);
    sOut2 := sOut2 + V(blur, i);
    i := i + 1;
  }
  Check("blurKeepsMean"c, sOut2 / 12.0, sIn / 12.0, 0.0000001);
  // Extremwerte werden gedaempft
  CheckB("blurDampens"c, V(blur, 0) > V(img, 0), true);
  CheckB("blurDampens2"c, V(blur, 11) < V(img, 11), true);
  CheckB("blurBadSigma"c, Conv2DGaussBlur(img, w, h, 0.0, CONV_EDGE_CLAMP, blur), false);
  free(blur, 12 * 8);

  // Sobel-Betrag: auf einem waagerecht ansteigenden Bild ueberall positiv
  var mag: int64 := alloc(12 * 8);
  CheckB("sobelMagOk"c, Conv2DSobelMagnitude(img, w, h, CONV_EDGE_CLAMP, mag), true);
  var allPos: bool := true;
  i := 0;
  while (i < 12) {
    if (V(mag, i) < 0.0) { allPos := false; }
    i := i + 1;
  }
  CheckB("sobelMagPos"c, allPos, true);
  // in der Mitte: Gx = 8 (waagerechter Anstieg 1 je Pixel),
  // Gy = 32 (senkrechter Anstieg 4 je Zeile) -> sqrt(1088)
  Check("sobelMagMid"c, V(mag, 5), SqrtF64(1088.0), 0.0000001);
  CheckB("sobelMagAlias"c, Conv2DSobelMagnitude(img, w, h, CONV_EDGE_CLAMP, img), false);
  free(mag, 12 * 8);

  // konstantes Bild: Glaettung aendert nichts, Kantenfilter gibt null
  var flat: int64 := alloc(12 * 8);
  i := 0;
  while (i < 12) { pokef64(flat + i * 8, 7.0); i := i + 1; }
  Conv2DGaussBlur(flat, w, h, 1.5, CONV_EDGE_CLAMP, oimg);
  Check("flatBlur"c, V(oimg, 5), 7.0, 0.0000001);
  Conv2DSobelMagnitude(flat, w, h, CONV_EDGE_CLAMP, oimg);
  Check("flatSobel"c, V(oimg, 5), 0.0, 0.0000001);
  free(flat, 12 * 8);

  // ── Fehlerpfade ───────────────────────────────────────────────────────────
  CheckB("directAlias"c, ConvDirect(a, 5, k, 3, CONV_FULL, CONV_EDGE_ZERO, a), false);
  CheckB("directBadMode"c, ConvDirect(a, 5, k, 3, 99, CONV_EDGE_ZERO, out), false);
  CheckB("validTooBig"c, ConvDirect(k, 3, a, 5, CONV_VALID, CONV_EDGE_ZERO, out), false);
  CheckB("conv2dBadW"c, Conv2D(img, 0, h, sob, 3, 3, CONV_EDGE_ZERO, oimg), false);
  CheckB("sepAlias"c, Conv2DSeparable(img, w, h, kx, 7, kx, 7, CONV_EDGE_CLAMP, img), false);

  free(a, 5 * 8);   free(k, 3 * 8);   free(ks, 3 * 8);
  free(out, 16 * 8); free(o2, 16 * 8);
  free(g5, 5 * 8);  free(sob, 9 * 8);
  free(img, 12 * 8); free(oimg, 12 * 8); free(sep, 12 * 8); free(kx, 7 * 8);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
