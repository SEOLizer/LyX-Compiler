// demo_pg_tx.lyx — WP-PG-12 Demo 3: Transaktion mit Rollback & Savepoint
//
// BEGIN -> INSERT -> SAVEPOINT -> INSERT (to be rolled back) ->
// ROLLBACK TO SAVEPOINT -> INSERT -> COMMIT
// Verifiziert: genau 1 Row in der Tabelle (die gerettete)

import std.db.postgres;

fn connect(): int64 {
  var probe: int64 := pgProbe("127.0.0.1"c, 5432, "postgres"c, "postgres"c);
  if (probe == 0) { PrintStr("SKIP: PostgreSQL not available\n"); return 0; }
  var conn: int64 := PGConnect("127.0.0.1"c, 5432, "postgres"c, ""c, "postgres"c);
  if (conn == 0) { PrintStr("SKIP: TCP error\n"); return 0; }
  if (PGIsConnected(conn) == 0) {
    if (PGErrno(conn) == PG_ERR_PROTO) { PrintStr("SKIP: unsupported auth (need trust/md5)\n"); }
    else { PrintStr("SKIP: not connected\n"); }
    PGClose(conn); return 0;
  }
  return conn;
}

pub fn main(): int64 {
  var conn: int64 := connect();
  if (conn == 0) { return 0; }

  var r0: int64 := PGQuery(conn, "DROP TABLE IF EXISTS pg_demo_tx"c);
  if (r0 != 0) { PGFreeResult(r0); }
  var r1: int64 := PGQuery(conn, "CREATE TABLE pg_demo_tx (id INT, label TEXT)"c);
  if (r1 == 0) { PrintStr("FAIL: CREATE\n"); PGClose(conn); return 1; }
  PGFreeResult(r1);

  // BEGIN
  if (PGBegin(conn) == 0) { PrintStr("FAIL: BEGIN\n"); PGClose(conn); return 1; }
  PrintStr("BEGIN\n");

  // SAVEPOINT (table is empty at this point)
  if (PGSavepoint(conn, "sp1"c) == 0) { PrintStr("FAIL: SAVEPOINT\n"); PGClose(conn); return 1; }
  PrintStr("SAVEPOINT sp1 (table empty)\n");

  // INSERT row that will be rolled back
  var rBad: int64 := PGQuery(conn, "INSERT INTO pg_demo_tx VALUES (1, 'discard_me')"c);
  if (rBad == 0) { PrintStr("FAIL: bad INSERT\n"); PGClose(conn); return 1; }
  PGFreeResult(rBad);
  PrintStr("INSERT id=1 'discard_me'\n");

  // ROLLBACK TO SAVEPOINT (removes the row, but tx stays open)
  if (PGRollbackTo(conn, "sp1"c) == 0) { PrintStr("FAIL: ROLLBACK TO\n"); PGClose(conn); return 1; }
  if (PGInTransaction(conn) == 0) { PrintStr("FAIL: TX closed after RollbackTo\n"); PGClose(conn); return 1; }
  PrintStr("ROLLBACK TO sp1 -> row discarded, TX still open\n");

  // INSERT the row we want to keep
  var rGood: int64 := PGQuery(conn, "INSERT INTO pg_demo_tx VALUES (2, 'keeper')"c);
  if (rGood == 0) { PrintStr("FAIL: good INSERT\n"); PGClose(conn); return 1; }
  PGFreeResult(rGood);
  PrintStr("INSERT id=2 'keeper'\n");

  // COMMIT
  if (PGCommit(conn) == 0) { PrintStr("FAIL: COMMIT\n"); PGClose(conn); return 1; }
  PrintStr("COMMIT\n");

  // Verify: exactly 1 row with label='keeper'
  var rV: int64 := PGQuery(conn, "SELECT id, label FROM pg_demo_tx"c);
  if (rV == 0) { PrintStr("FAIL: verify SELECT\n"); PGClose(conn); return 1; }
  var rowCount: int64 := PGNumRows(rV);
  PrintStr("Rows in table: "); PrintInt(rowCount); PrintStr("\n");
  while (PGFetchRow(rV) != 0) {
    PrintStr("  id="); PrintInt(PGGetInt(rV, 0));
    PrintStr(" label="); PrintStr(PGGetStr(rV, 1)); PrintStr("\n");
  }
  PGFreeResult(rV);

  if (rowCount != 1) {
    PrintStr("FAIL: expected 1 row, got "); PrintInt(rowCount); PrintStr("\n");
    PGClose(conn); return 1;
  }
  PrintStr("OK: exactly 1 row after Rollback-To-Savepoint\n");

  var rDrop: int64 := PGQuery(conn, "DROP TABLE pg_demo_tx"c);
  if (rDrop != 0) { PGFreeResult(rDrop); }
  PGClose(conn);
  PrintStr("OK\n");
  return 0;
}
