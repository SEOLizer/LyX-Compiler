// demo_pg_tx.lyx — WP-PG-12 Demo 3: Transaktion mit Rollback & Savepoint
//
// BEGIN -> INSERT -> SAVEPOINT -> INSERT (to be rolled back) ->
// ROLLBACK TO SAVEPOINT -> INSERT -> COMMIT
// Verifiziert: genau 1 Row in der Tabelle (die gerettete)

import std.db.postgres;

fn connect(): int64 {
  var probe: int64 := pgProbe("127.0.0.1"c, 5432, "postgres"c, "postgres"c);
  if (probe == 0) { PrintLn("SKIP: PostgreSQL not available"); return 0; }
  var conn: int64 := PGConnect("127.0.0.1"c, 5432, "postgres"c, ""c, "postgres"c);
  if (conn == 0) { PrintLn("SKIP: TCP error"); return 0; }
  if (PGIsConnected(conn) == 0) {
    if (PGErrno(conn) == PG_ERR_PROTO) { PrintLn("SKIP: unsupported auth (need trust/md5)"); }
    else { PrintLn("SKIP: not connected"); }
    PGClose(conn); return 0;
  }
  return conn;
}

pub fn main(): int64 {
  var conn: int64 := connect();
  if (conn == 0) { return 0; }

  var r0: int64 := PGQuery(conn, "DROP TABLE IF EXISTS pg_demo_tx"c);
  if (r0 != 0) { PGFreeResult(r0); }
  var r1: int64 := PGQuery(conn, "CREATE TABLE pg_demo_tx (id INT, label TEXT)"c);
  if (r1 == 0) { PrintLn("FAIL: CREATE"); PGClose(conn); return 1; }
  PGFreeResult(r1);

  // BEGIN
  if (PGBegin(conn) == 0) { PrintLn("FAIL: BEGIN"); PGClose(conn); return 1; }
  PrintLn("BEGIN");

  // SAVEPOINT (table is empty at this point)
  if (PGSavepoint(conn, "sp1"c) == 0) { PrintLn("FAIL: SAVEPOINT"); PGClose(conn); return 1; }
  PrintLn("SAVEPOINT sp1 (table empty)");

  // INSERT row that will be rolled back
  var rBad: int64 := PGQuery(conn, "INSERT INTO pg_demo_tx VALUES (1, 'discard_me')"c);
  if (rBad == 0) { PrintLn("FAIL: bad INSERT"); PGClose(conn); return 1; }
  PGFreeResult(rBad);
  PrintLn("INSERT id=1 'discard_me'");

  // ROLLBACK TO SAVEPOINT (removes the row, but tx stays open)
  if (PGRollbackTo(conn, "sp1"c) == 0) { PrintLn("FAIL: ROLLBACK TO"); PGClose(conn); return 1; }
  if (PGInTransaction(conn) == 0) { PrintLn("FAIL: TX closed after RollbackTo"); PGClose(conn); return 1; }
  PrintLn("ROLLBACK TO sp1 -> row discarded, TX still open");

  // INSERT the row we want to keep
  var rGood: int64 := PGQuery(conn, "INSERT INTO pg_demo_tx VALUES (2, 'keeper')"c);
  if (rGood == 0) { PrintLn("FAIL: good INSERT"); PGClose(conn); return 1; }
  PGFreeResult(rGood);
  PrintLn("INSERT id=2 'keeper'");

  // COMMIT
  if (PGCommit(conn) == 0) { PrintLn("FAIL: COMMIT"); PGClose(conn); return 1; }
  PrintLn("COMMIT");

  // Verify: exactly 1 row with label='keeper'
  var rV: int64 := PGQuery(conn, "SELECT id, label FROM pg_demo_tx"c);
  if (rV == 0) { PrintLn("FAIL: verify SELECT"); PGClose(conn); return 1; }
  var rowCount: int64 := PGNumRows(rV);
  Print("Rows in table: "); PrintLn(StrFromInt(rowCount));
  while (PGFetchRow(rV) != 0) {
    Print("  id="); Print(StrFromInt(PGGetInt(rV, 0)));
    Print(" label="); PrintLn(PGGetStr(rV, 1));
  }
  PGFreeResult(rV);

  if (rowCount != 1) {
    Print("FAIL: expected 1 row, got "); PrintLn(StrFromInt(rowCount));
    PGClose(conn); return 1;
  }
  PrintLn("OK: exactly 1 row after Rollback-To-Savepoint");

  var rDrop: int64 := PGQuery(conn, "DROP TABLE pg_demo_tx"c);
  if (rDrop != 0) { PGFreeResult(rDrop); }
  PGClose(conn);
  PrintLn("OK");
  return 0;
}
