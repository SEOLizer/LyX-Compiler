// tests/pgp01_armor_test.lyx — PGP-01: ASCII Armor encode/decode

unit tests.pgp01_armor_test;

import std.pgp.core;
import std.pgp.armor;
import std.alloc;
import std.io;

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Test 1: PgpArmorEncode — encode 3 known bytes, verify header
    // -------------------------------------------------------------------------
    var data: int64 := alloc(8);
    poke8(data, 0x41); poke8(data+1, 0x42); poke8(data+2, 0x43);  // "ABC"

    var armored: int64 := alloc(512);
    var alen: int64 := PgpArmorEncode(data, 3, PGP_ARMOR_MESSAGE, armored, 512);
    if (alen <= 0) {
        PrintLn("FAIL: PgpArmorEncode returned 0"c); ok := 0;
    } else {
        PrintLn("PASS: PgpArmorEncode alen>0"c);
    }

    // Check: starts with "-----BEGIN PGP MESSAGE-----"
    var hdr_ok: int64 := 1;
    var exp: pchar := "-----BEGIN PGP MESSAGE-----"c;
    var k: int64 := 0;
    while (StrCharAt(exp, k) != 0) {
        if (peek8(armored + k) != StrCharAt(exp, k)) { hdr_ok := 0; }
        k := k + 1;
    }
    if (hdr_ok != 1) { PrintLn("FAIL: PgpArmorEncode wrong header"c); ok := 0; }
    else { PrintLn("PASS: PgpArmorEncode header correct"c); }

    // -------------------------------------------------------------------------
    // Test 2: PgpArmorType detects MESSAGE
    // -------------------------------------------------------------------------
    var tp: int64 := PgpArmorType(armored, alen);
    if (tp != PGP_ARMOR_MESSAGE) {
        PrintLn("FAIL: PgpArmorType != MESSAGE"c); ok := 0;
    } else {
        PrintLn("PASS: PgpArmorType=MESSAGE"c);
    }

    // -------------------------------------------------------------------------
    // Test 3: PgpArmorDecode roundtrip — decoded == original
    // -------------------------------------------------------------------------
    var decoded: int64 := alloc(64);
    var dlen: int64 := PgpArmorDecode(armored, alen, decoded, 64);
    if (dlen != 3) {
        PrintLn("FAIL: PgpArmorDecode dlen != 3"c); ok := 0;
    } else {
        PrintLn("PASS: PgpArmorDecode dlen=3"c);
    }
    if (dlen == 3) {
        if (peek8(decoded) != 0x41 || peek8(decoded+1) != 0x42 || peek8(decoded+2) != 0x43) {
            PrintLn("FAIL: PgpArmorDecode data mismatch"c); ok := 0;
        } else {
            PrintLn("PASS: PgpArmorDecode data=ABC"c);
        }
    }
    free(decoded, 64);

    // -------------------------------------------------------------------------
    // Test 4: roundtrip with 57 bytes (exactly one full base64 line)
    // -------------------------------------------------------------------------
    var data57: int64 := alloc(64);
    var n: int64 := 0;
    while (n < 57) { poke8(data57 + n, n + 1); n := n + 1; }
    var arm57: int64 := alloc(512);
    var al57: int64 := PgpArmorEncode(data57, 57, PGP_ARMOR_MESSAGE, arm57, 512);
    var dec57: int64 := alloc(64);
    var dl57: int64 := PgpArmorDecode(arm57, al57, dec57, 64);
    if (dl57 != 57) {
        PrintLn("FAIL: 57-byte roundtrip dlen != 57"c); ok := 0;
    } else {
        PrintLn("PASS: 57-byte roundtrip dlen=57"c);
    }
    if (dl57 == 57) {
        var eq57: int64 := 1;
        var m: int64 := 0;
        while (m < 57) {
            if (peek8(dec57 + m) != peek8(data57 + m)) { eq57 := 0; }
            m := m + 1;
        }
        if (eq57 != 1) { PrintLn("FAIL: 57-byte roundtrip data mismatch"c); ok := 0; }
        else { PrintLn("PASS: 57-byte roundtrip data match"c); }
    }
    free(dec57, 64);
    free(arm57, 512);
    free(data57, 64);

    // -------------------------------------------------------------------------
    // Test 5: roundtrip with larger data (100 bytes → 2 lines)
    // -------------------------------------------------------------------------
    var data100: int64 := alloc(128);
    var j: int64 := 0;
    while (j < 100) { poke8(data100 + j, (j * 3 + 7) & 255); j := j + 1; }
    var arm100: int64 := alloc(1024);
    var al100: int64 := PgpArmorEncode(data100, 100, PGP_ARMOR_SIGNATURE, arm100, 1024);
    var tp100: int64 := PgpArmorType(arm100, al100);
    if (tp100 != PGP_ARMOR_SIGNATURE) {
        PrintLn("FAIL: 100-byte armor type != SIGNATURE"c); ok := 0;
    } else {
        PrintLn("PASS: 100-byte armor type=SIGNATURE"c);
    }
    var dec100: int64 := alloc(128);
    var dl100: int64 := PgpArmorDecode(arm100, al100, dec100, 128);
    if (dl100 != 100) {
        PrintLn("FAIL: 100-byte roundtrip dlen != 100"c); ok := 0;
    } else {
        PrintLn("PASS: 100-byte roundtrip dlen=100"c);
    }
    if (dl100 == 100) {
        var eq100: int64 := 1;
        var m2: int64 := 0;
        while (m2 < 100) {
            if (peek8(dec100 + m2) != peek8(data100 + m2)) { eq100 := 0; }
            m2 := m2 + 1;
        }
        if (eq100 != 1) { PrintLn("FAIL: 100-byte roundtrip data mismatch"c); ok := 0; }
        else { PrintLn("PASS: 100-byte roundtrip data match"c); }
    }
    free(dec100, 128);
    free(arm100, 1024);
    free(data100, 128);

    // -------------------------------------------------------------------------
    // Test 6: PgpArmorDecode — corrupt CRC → -1
    // -------------------------------------------------------------------------
    // Flip one byte in the CRC line (the char after '=')
    // Find '=' at start of a line in armored
    var corr: int64 := alloc(512);
    var ci: int64 := 0;
    while (ci < alen) { poke8(corr + ci, peek8(armored + ci)); ci := ci + 1; }
    // Find the CRC '=' (starts a line)
    var crcOff: int64 := 0;
    var lineS: int64 := 1;
    var fi: int64 := 0;
    while (fi < alen && crcOff == 0) {
        var bc: int64 := peek8(corr + fi);
        if (lineS != 0 && bc == 0x3D) { crcOff := fi; }
        if (bc == 0x0A) { lineS := 1; } else { lineS := 0; }
        fi := fi + 1;
    }
    if (crcOff > 0) {
        // Flip the first CRC data byte
        var orig: int64 := peek8(corr + crcOff + 1);
        if (orig == 0x41) { poke8(corr + crcOff + 1, 0x42); }
        else               { poke8(corr + crcOff + 1, 0x41); }
    }
    var decBad: int64 := alloc(64);
    var dlBad: int64 := PgpArmorDecode(corr, alen, decBad, 64);
    free(decBad, 64);
    free(corr, 512);
    if (dlBad != (0 - 1)) {
        PrintLn("FAIL: corrupt CRC should return -1"c); ok := 0;
    } else {
        PrintLn("PASS: corrupt CRC → -1"c);
    }

    // -------------------------------------------------------------------------
    // Test 7: PgpArmorType — non-armor → UNKNOWN
    // -------------------------------------------------------------------------
    var notArmor: int64 := alloc(32);
    poke8(notArmor, 0x48); poke8(notArmor+1, 0x65); poke8(notArmor+2, 0x6C);
    poke8(notArmor+3, 0x6C); poke8(notArmor+4, 0x6F); poke8(notArmor+5, 0);
    var tp7: int64 := PgpArmorType(notArmor, 6);
    free(notArmor, 32);
    if (tp7 != PGP_ARMOR_UNKNOWN) {
        PrintLn("FAIL: non-armor should return UNKNOWN"c); ok := 0;
    } else {
        PrintLn("PASS: non-armor → UNKNOWN"c);
    }

    free(armored, 512);
    free(data, 8);

    if (ok != 0) { PrintLn("=== PGP-01: ALL PASS ==="c); }
    else         { PrintLn("=== PGP-01: SOME FAIL ==="c); }
    return ok;
}
