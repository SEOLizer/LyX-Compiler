// tests/hl702_order_test.lyx — WP-HL7-02 Order Management tests
unit tests.hl702_order_test;

import std.hl7.orders;
import std.hl7.core;
import std.alloc;
import std.io;

fn strEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
        if (peek8(a + i) != peek8(b + i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

fn contains(hay: int64, hayLen: int64, needle: int64, needleLen: int64): int64 {
    var i: int64 := 0;
    while (i <= hayLen - needleLen) {
        if (strEq(hay + i, needleLen, needle, needleLen)) { return 1; }
        i := i + 1;
    }
    return 0;
}

fn pass(n: int64) { Print("PASS "); PrintLn(n); }
fn fail(n: int64) { Print("FAIL "); PrintLn(n); }
fn check(n: int64, ok: int64) { if (ok == 1) { pass(n); } else { fail(n); } }

fn main() {
    var order: int64 := alloc(HL7_ORD_SIZE);
    var admin: int64 := alloc(HL7_RXA_SIZE);
    var out:   int64 := alloc(4096);

    // ── Test 1: Hl7OrcParse — order control NW ───────────────────────────────
    {
        var seg: int64 := "ORC|NW|PLN001|FLN001||IP|||||||Dr.Smith"c as int64;
        var slen: int64 := 39;
        Hl7OrcParse(seg, slen, order);
        var p: int64 := peek64(order + HL7_ORD_CTRL);
        var l: int64 := peek64(order + HL7_ORD_CTRL_LEN);
        var exp: int64 := "NW"c as int64;
        check(1, strEq(p, l, exp, 2));
    }

    // ── Test 2: Hl7OrcParse — placer order number ────────────────────────────
    {
        var seg: int64 := "ORC|NW|PLN001|FLN001||IP|||||||Dr.Smith"c as int64;
        var slen: int64 := 39;
        Hl7OrcParse(seg, slen, order);
        var p: int64 := peek64(order + HL7_ORD_PLACER);
        var l: int64 := peek64(order + HL7_ORD_PLACER_LEN);
        var exp: int64 := "PLN001"c as int64;
        check(2, strEq(p, l, exp, 6));
    }

    // ── Test 3: Hl7OrcParse — filler order number ────────────────────────────
    {
        var seg: int64 := "ORC|NW|PLN001|FLN001||IP|||||||Dr.Smith"c as int64;
        var slen: int64 := 39;
        Hl7OrcParse(seg, slen, order);
        var p: int64 := peek64(order + HL7_ORD_FILLER);
        var l: int64 := peek64(order + HL7_ORD_FILLER_LEN);
        var exp: int64 := "FLN001"c as int64;
        check(3, strEq(p, l, exp, 6));
    }

    // ── Test 4: Hl7OrcParse — order status (ORC-5) ───────────────────────────
    {
        var seg: int64 := "ORC|NW|PLN001|FLN001||IP|||||||Dr.Smith"c as int64;
        var slen: int64 := 39;
        Hl7OrcParse(seg, slen, order);
        var p: int64 := peek64(order + HL7_ORD_STATUS);
        var l: int64 := peek64(order + HL7_ORD_STATUS_LEN);
        var exp: int64 := "IP"c as int64;
        check(4, strEq(p, l, exp, 2));
    }

    // ── Test 5: Hl7OrcParse — ordering provider (ORC-12) ────────────────────
    {
        var seg: int64 := "ORC|NW|PLN001|FLN001||IP|||||||Dr.Smith"c as int64;
        var slen: int64 := 39;
        Hl7OrcParse(seg, slen, order);
        var p: int64 := peek64(order + HL7_ORD_PROVIDER);
        var l: int64 := peek64(order + HL7_ORD_PROVIDER_LEN);
        var exp: int64 := "Dr.Smith"c as int64;
        check(5, strEq(p, l, exp, 8));
    }

    // ── Test 6: Hl7ObrParse — service code (OBR-4) ───────────────────────────
    {
        var seg: int64 := "OBR|1|PLN001||BLPNL"c as int64;
        var slen: int64 := 19;
        Hl7ObrParse(seg, slen, order);
        var p: int64 := peek64(order + HL7_ORD_SERVICE);
        var l: int64 := peek64(order + HL7_ORD_SERVICE_LEN);
        var exp: int64 := "BLPNL"c as int64;
        check(6, strEq(p, l, exp, 5));
    }

    // ── Test 7: Hl7ObrParse — priority S (OBR-5) ─────────────────────────────
    {
        var seg: int64 := "OBR|1|PLN001||BLPNL|S"c as int64;
        var slen: int64 := 21;
        poke64(order + HL7_ORD_ISSTAT, 0);
        Hl7ObrParse(seg, slen, order);
        var p: int64 := peek64(order + HL7_ORD_PRIORITY);
        var l: int64 := peek64(order + HL7_ORD_PRIORITY_LEN);
        check(7, l == 1 && peek8(p) == 83);  // 'S'
    }

    // ── Test 8: Hl7ObrParse — requested datetime (OBR-6) ────────────────────
    {
        var seg: int64 := "OBR|1|PLN001||BLPNL||20260615080000"c as int64;
        var slen: int64 := 35;
        Hl7ObrParse(seg, slen, order);
        var p: int64 := peek64(order + HL7_ORD_REQ_DT);
        var l: int64 := peek64(order + HL7_ORD_REQ_DT_LEN);
        var exp: int64 := "20260615080000"c as int64;
        check(8, strEq(p, l, exp, 14));
    }

    // ── Test 9: Hl7ObrParse — observation datetime (OBR-7) ──────────────────
    {
        var seg: int64 := "OBR|1|PLN001||BLPNL||20260615080000|20260615090000"c as int64;
        var slen: int64 := 50;
        Hl7ObrParse(seg, slen, order);
        var p: int64 := peek64(order + HL7_ORD_OBS_DT);
        var l: int64 := peek64(order + HL7_ORD_OBS_DT_LEN);
        var exp: int64 := "20260615090000"c as int64;
        check(9, strEq(p, l, exp, 14));
    }

    // Full ORM message:
    // MSH|^~\&|LABSYS|LAB|KIS|H|20260615||ORM^O01|L001|P|2.5.1 (56)
    // \r PID|1||PAT001^^^KIS||Mueller^Hans (33)
    // \r PV1|1|O|||||||||||||||||VN-ORD-001 (34)
    // \r ORC|NW|PLN001|FLN001||IP|||||||Dr.Smith (39)
    // \r OBR|1|PLN001||BLPNL|S|20260615080000 (36)
    // Total = 56+1+33+1+34+1+39+1+36 = 202

    // ── Test 10: Hl7OrmParse — msgtype = 1 (ORM) ─────────────────────────────
    {
        var msg: int64 := "MSH|^~\\&|LABSYS|LAB|KIS|H|20260615||ORM^O01|L001|P|2.5.1\rPID|1||PAT001^^^KIS||Mueller^Hans\rPV1|1|O|||||||||||||||||VN-ORD-001\rORC|NW|PLN001|FLN001||IP|||||||Dr.Smith\rOBR|1|PLN001||BLPNL|S|20260615080000"c as int64;
        var mlen: int64 := 202;
        Hl7OrmParse(msg, mlen, order);
        check(10, peek64(order + HL7_ORD_MSGTYPE) == 1);
    }

    // ── Test 11: Hl7OrmParse — ORC control NW ────────────────────────────────
    {
        var msg: int64 := "MSH|^~\\&|LABSYS|LAB|KIS|H|20260615||ORM^O01|L001|P|2.5.1\rPID|1||PAT001^^^KIS||Mueller^Hans\rPV1|1|O|||||||||||||||||VN-ORD-001\rORC|NW|PLN001|FLN001||IP|||||||Dr.Smith\rOBR|1|PLN001||BLPNL|S|20260615080000"c as int64;
        var mlen: int64 := 202;
        Hl7OrmParse(msg, mlen, order);
        var p: int64 := peek64(order + HL7_ORD_CTRL);
        var l: int64 := peek64(order + HL7_ORD_CTRL_LEN);
        var exp: int64 := "NW"c as int64;
        check(11, strEq(p, l, exp, 2));
    }

    // ── Test 12: Hl7OrmParse — placer order number ───────────────────────────
    {
        var msg: int64 := "MSH|^~\\&|LABSYS|LAB|KIS|H|20260615||ORM^O01|L001|P|2.5.1\rPID|1||PAT001^^^KIS||Mueller^Hans\rPV1|1|O|||||||||||||||||VN-ORD-001\rORC|NW|PLN001|FLN001||IP|||||||Dr.Smith\rOBR|1|PLN001||BLPNL|S|20260615080000"c as int64;
        var mlen: int64 := 202;
        Hl7OrmParse(msg, mlen, order);
        var p: int64 := peek64(order + HL7_ORD_PLACER);
        var l: int64 := peek64(order + HL7_ORD_PLACER_LEN);
        var exp: int64 := "PLN001"c as int64;
        check(12, strEq(p, l, exp, 6));
    }

    // ── Test 13: Hl7OrmParse — service code from OBR ─────────────────────────
    {
        var msg: int64 := "MSH|^~\\&|LABSYS|LAB|KIS|H|20260615||ORM^O01|L001|P|2.5.1\rPID|1||PAT001^^^KIS||Mueller^Hans\rPV1|1|O|||||||||||||||||VN-ORD-001\rORC|NW|PLN001|FLN001||IP|||||||Dr.Smith\rOBR|1|PLN001||BLPNL|S|20260615080000"c as int64;
        var mlen: int64 := 202;
        Hl7OrmParse(msg, mlen, order);
        var p: int64 := peek64(order + HL7_ORD_SERVICE);
        var l: int64 := peek64(order + HL7_ORD_SERVICE_LEN);
        var exp: int64 := "BLPNL"c as int64;
        check(13, strEq(p, l, exp, 5));
    }

    // ── Test 14: Hl7OrmParse — STAT priority detected (OBR-5=S) ─────────────
    {
        var msg: int64 := "MSH|^~\\&|LABSYS|LAB|KIS|H|20260615||ORM^O01|L001|P|2.5.1\rPID|1||PAT001^^^KIS||Mueller^Hans\rPV1|1|O|||||||||||||||||VN-ORD-001\rORC|NW|PLN001|FLN001||IP|||||||Dr.Smith\rOBR|1|PLN001||BLPNL|S|20260615080000"c as int64;
        var mlen: int64 := 202;
        Hl7OrmParse(msg, mlen, order);
        check(14, peek64(order + HL7_ORD_ISSTAT) == 1);
    }

    // ── Test 15: Hl7OrmParse — isstat=0 for routine ──────────────────────────
    {
        var msg: int64 := "MSH|^~\\&|LABSYS|LAB|KIS|H|20260615||ORM^O01|L002|P|2.5.1\rORC|NW|PLN002\rOBR|1|PLN002||URICP|R"c as int64;
        var mlen: int64 := 92;
        Hl7OrmParse(msg, mlen, order);
        check(15, peek64(order + HL7_ORD_ISSTAT) == 0);
    }

    // ── Test 16: Hl7OrmParse — patient ID from PID-3 ─────────────────────────
    {
        var msg: int64 := "MSH|^~\\&|LABSYS|LAB|KIS|H|20260615||ORM^O01|L001|P|2.5.1\rPID|1||PAT001^^^KIS||Mueller^Hans\rPV1|1|O|||||||||||||||||VN-ORD-001\rORC|NW|PLN001|FLN001||IP|||||||Dr.Smith\rOBR|1|PLN001||BLPNL|S|20260615080000"c as int64;
        var mlen: int64 := 202;
        Hl7OrmParse(msg, mlen, order);
        var p: int64 := peek64(order + HL7_ORD_PAT_ID);
        var l: int64 := peek64(order + HL7_ORD_PAT_ID_LEN);
        var exp: int64 := "PAT001"c as int64;
        check(16, strEq(p, l, exp, 6));
    }

    // ── Test 17: Hl7OmlParse — msgtype = 2 (OML) ─────────────────────────────
    {
        // MSH(56) + \r + PID(19) + \r + ORC(18) + \r + OBR(20) = 56+1+19+1+18+1+20 = 116
        var msg: int64 := "MSH|^~\\&|LABSYS|LAB|KIS|H|20260615||OML^O21|L002|P|2.5.1\rPID|1||PAT002^^^KIS\rORC|NW|PLN002|||IP\rOBR|1|PLN002||MICBLD"c as int64;
        var mlen: int64 := 116;
        Hl7OmlParse(msg, mlen, order);
        check(17, peek64(order + HL7_ORD_MSGTYPE) == 2);
    }

    // ── Test 18: Hl7OmlParse — ORC control from OML ──────────────────────────
    {
        var msg: int64 := "MSH|^~\\&|LABSYS|LAB|KIS|H|20260615||OML^O21|L002|P|2.5.1\rPID|1||PAT002^^^KIS\rORC|NW|PLN002|||IP\rOBR|1|PLN002||MICBLD"c as int64;
        var mlen: int64 := 116;
        Hl7OmlParse(msg, mlen, order);
        var p: int64 := peek64(order + HL7_ORD_CTRL);
        var l: int64 := peek64(order + HL7_ORD_CTRL_LEN);
        var exp: int64 := "NW"c as int64;
        check(18, strEq(p, l, exp, 2));
    }

    // ── Test 19: Hl7OmlParse — service from OBR in OML ───────────────────────
    {
        var msg: int64 := "MSH|^~\\&|LABSYS|LAB|KIS|H|20260615||OML^O21|L002|P|2.5.1\rPID|1||PAT002^^^KIS\rORC|NW|PLN002|||IP\rOBR|1|PLN002||MICBLD"c as int64;
        var mlen: int64 := 116;
        Hl7OmlParse(msg, mlen, order);
        var p: int64 := peek64(order + HL7_ORD_SERVICE);
        var l: int64 := peek64(order + HL7_ORD_SERVICE_LEN);
        var exp: int64 := "MICBLD"c as int64;
        check(19, strEq(p, l, exp, 6));
    }

    // ── Tests 20-24: Hl7OrmWrite ─────────────────────────────────────────────
    {
        var i: int64 := 0;
        while (i < HL7_ORD_SIZE) { poke8(order + i, 0); i := i + 1; }
        var plStr: int64 := "ORD-99"c as int64;
        poke64(order + HL7_ORD_PLACER, plStr);
        poke64(order + HL7_ORD_PLACER_LEN, 6);
        var ctStr: int64 := "NW"c as int64;
        poke64(order + HL7_ORD_CTRL, ctStr);
        poke64(order + HL7_ORD_CTRL_LEN, 2);

        var n: int64 := Hl7OrmWrite(order, out, 4096);

        // Test 20: starts with MSH
        check(20, peek8(out) == 77 && peek8(out+1) == 83 && peek8(out+2) == 72);

        // Test 21: contains ORC segment
        var orcTag: int64 := "ORC"c as int64;
        check(21, contains(out, n, orcTag, 3));

        // Test 22: contains OBR segment
        var obrTag: int64 := "OBR"c as int64;
        check(22, contains(out, n, obrTag, 3));

        // Test 23: MSH-9 = ORM^O01
        var evTag: int64 := "ORM^O01"c as int64;
        check(23, contains(out, n, evTag, 7));

        // Test 24: placer order number in ORC
        var plTag: int64 := "ORD-99"c as int64;
        check(24, contains(out, n, plTag, 6));
    }

    // ── Tests 25-28: Hl7OmlWrite ─────────────────────────────────────────────
    {
        var i: int64 := 0;
        while (i < HL7_ORD_SIZE) { poke8(order + i, 0); i := i + 1; }
        var n: int64 := Hl7OmlWrite(order, out, 4096);

        // Test 25: starts with MSH
        check(25, peek8(out) == 77 && peek8(out+1) == 83 && peek8(out+2) == 72);

        // Test 26: contains ORC
        var orcTag: int64 := "ORC"c as int64;
        check(26, contains(out, n, orcTag, 3));

        // Test 27: contains OBR
        var obrTag: int64 := "OBR"c as int64;
        check(27, contains(out, n, obrTag, 3));

        // Test 28: MSH-9 = OML^O21
        var evTag: int64 := "OML^O21"c as int64;
        check(28, contains(out, n, evTag, 7));
    }

    // ── Tests 29-31, 45: Hl7OrrWrite ─────────────────────────────────────────
    {
        var i: int64 := 0;
        while (i < HL7_ORD_SIZE) { poke8(order + i, 0); i := i + 1; }
        poke64(order + HL7_ORD_MSGTYPE, 1);
        var plStr: int64 := "PLN-ACK"c as int64;
        poke64(order + HL7_ORD_PLACER, plStr);
        poke64(order + HL7_ORD_PLACER_LEN, 7);
        var okStr: int64 := "OK"c as int64;
        var n: int64 := Hl7OrrWrite(order, okStr, out, 4096);

        // Test 29: starts with MSH
        check(29, peek8(out) == 77 && peek8(out+1) == 83 && peek8(out+2) == 72);

        // Test 30: contains MSA segment
        var msaTag: int64 := "MSA"c as int64;
        check(30, contains(out, n, msaTag, 3));

        // Test 31: ORC status = "OK" in response
        var okTag: int64 := "OK"c as int64;
        check(31, contains(out, n, okTag, 2));
    }

    // ── Tests 32-38: Hl7RasParse ─────────────────────────────────────────────
    // RXA segment: RXA|0|1|20260615080000|20260615083000|ASP-999^Aspirin|500|mg|||Dr.Jones||PO
    // Positions: RXA(3)+|0(2)+|1(2)+|+20260615080000(15)+|+20260615083000(15)+|+ASP-999^Aspirin(16)+|+500(4)+|+mg(3)+|||+Dr.Jones(9)+||+PO(2)
    // = 3+2+2+1+14+1+14+1+15+1+3+1+2+3+8+2+2 = 75
    // Full RAS message: MSH(53)+\r+RXA(75) = 129
    {
        var msg: int64 := "MSH|^~\\&|PHARM|H|KIS|H|20260615||RAS^O17|R001|P|2.5.1\rRXA|0|1|20260615080000|20260615083000|ASP-999^Aspirin|500|mg|||Dr.Jones||PO"c as int64;
        var mlen: int64 := 129;
        Hl7RasParse(msg, mlen, admin);

        // Test 32: drug code (RXA-5)
        {
            var p: int64 := peek64(admin + HL7_RXA_DRUG);
            var l: int64 := peek64(admin + HL7_RXA_DRUG_LEN);
            var exp: int64 := "ASP-999^Aspirin"c as int64;
            check(32, strEq(p, l, exp, 15));
        }

        // Test 33: dose (RXA-6)
        {
            var p: int64 := peek64(admin + HL7_RXA_DOSE);
            var l: int64 := peek64(admin + HL7_RXA_DOSE_LEN);
            var exp: int64 := "500"c as int64;
            check(33, strEq(p, l, exp, 3));
        }

        // Test 34: dose unit (RXA-7)
        {
            var p: int64 := peek64(admin + HL7_RXA_UNIT);
            var l: int64 := peek64(admin + HL7_RXA_UNIT_LEN);
            var exp: int64 := "mg"c as int64;
            check(34, strEq(p, l, exp, 2));
        }

        // Test 35: route (RXA-12)
        {
            var p: int64 := peek64(admin + HL7_RXA_ROUTE);
            var l: int64 := peek64(admin + HL7_RXA_ROUTE_LEN);
            var exp: int64 := "PO"c as int64;
            check(35, strEq(p, l, exp, 2));
        }

        // Test 36: start datetime (RXA-3)
        {
            var p: int64 := peek64(admin + HL7_RXA_START);
            var l: int64 := peek64(admin + HL7_RXA_START_LEN);
            var exp: int64 := "20260615080000"c as int64;
            check(36, strEq(p, l, exp, 14));
        }

        // Test 37: stop datetime (RXA-4)
        {
            var p: int64 := peek64(admin + HL7_RXA_STOP);
            var l: int64 := peek64(admin + HL7_RXA_STOP_LEN);
            var exp: int64 := "20260615083000"c as int64;
            check(37, strEq(p, l, exp, 14));
        }

        // Test 38: administered by (RXA-10)
        {
            var p: int64 := peek64(admin + HL7_RXA_ADMIN_BY);
            var l: int64 := peek64(admin + HL7_RXA_ADMIN_BY_LEN);
            var exp: int64 := "Dr.Jones"c as int64;
            check(38, strEq(p, l, exp, 8));
        }
    }

    // ── Test 39: HL7_ORD_CTRL constant = 0 ───────────────────────────────────
    check(39, HL7_ORD_CTRL == 0 && HL7_ORD_PLACER == 16);

    // ── Test 40: HL7_ORD_SIZE = 192 ──────────────────────────────────────────
    check(40, HL7_ORD_SIZE == 192);

    // ── Test 41: HL7_RXA_SIZE = 112 ──────────────────────────────────────────
    check(41, HL7_RXA_SIZE == 112);

    // ── Test 42: Hl7OrcParse — order control CA ──────────────────────────────
    {
        var seg: int64 := "ORC|CA|PLN001"c as int64;
        var slen: int64 := 13;
        Hl7OrcParse(seg, slen, order);
        var p: int64 := peek64(order + HL7_ORD_CTRL);
        var l: int64 := peek64(order + HL7_ORD_CTRL_LEN);
        var exp: int64 := "CA"c as int64;
        check(42, strEq(p, l, exp, 2));
    }

    // ── Test 43: Hl7OrcParse — order control DC ──────────────────────────────
    {
        var seg: int64 := "ORC|DC|PLN001"c as int64;
        var slen: int64 := 13;
        Hl7OrcParse(seg, slen, order);
        var p: int64 := peek64(order + HL7_ORD_CTRL);
        var l: int64 := peek64(order + HL7_ORD_CTRL_LEN);
        var exp: int64 := "DC"c as int64;
        check(43, strEq(p, l, exp, 2));
    }

    // ── Test 44: Hl7OrmParse — visit number from PV1-19 ──────────────────────
    {
        var msg: int64 := "MSH|^~\\&|LABSYS|LAB|KIS|H|20260615||ORM^O01|L001|P|2.5.1\rPID|1||PAT001^^^KIS||Mueller^Hans\rPV1|1|O|||||||||||||||||VN-ORD-001\rORC|NW|PLN001|FLN001||IP|||||||Dr.Smith\rOBR|1|PLN001||BLPNL|S|20260615080000"c as int64;
        var mlen: int64 := 202;
        Hl7OrmParse(msg, mlen, order);
        var p: int64 := peek64(order + HL7_ORD_VISIT);
        var l: int64 := peek64(order + HL7_ORD_VISIT_LEN);
        var exp: int64 := "VN-ORD-001"c as int64;
        check(44, strEq(p, l, exp, 10));
    }

    // ── Test 45: Hl7OrrWrite — ORL^O22 for OML mode ──────────────────────────
    {
        var i: int64 := 0;
        while (i < HL7_ORD_SIZE) { poke8(order + i, 0); i := i + 1; }
        poke64(order + HL7_ORD_MSGTYPE, 2);
        var okStr: int64 := "OK"c as int64;
        var n: int64 := Hl7OrrWrite(order, okStr, out, 4096);
        var orlTag: int64 := "ORL^O22"c as int64;
        check(45, contains(out, n, orlTag, 7));
    }
}
