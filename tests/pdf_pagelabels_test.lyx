// tests/pdf_pagelabels_test.lyx
// WP-PDF-11: page label ranges

@description("WP-PDF-11: page labels test")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pdf_pagelabels_test;

import std.pdf;

fn testLabelRomanThenDecimal(): int64 {
  // Classic book layout: pages 0..2 = Roman lower (preface), pages 3+ = decimal
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p2: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p3: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p4: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Preface i");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Preface ii");
  PdfSetFont(doc, p2, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p2, 72.0, 750.0, "Preface iii");
  PdfSetFont(doc, p3, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p3, 72.0, 750.0, "Chapter 1, page 1");
  PdfSetFont(doc, p4, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p4, 72.0, 750.0, "Chapter 1, page 2");

  PdfSetPageLabel(doc, 0, PDF_LABEL_ROMAN_L, "", 1);
  PdfSetPageLabel(doc, 3, PDF_LABEL_DECIMAL, "", 1);

  var err: int64 := PdfSave(doc, "/tmp/pdf_labels_roman_decimal.pdf");
  PdfFree(doc);
  if (err != 0) {
    Print("FAIL: PdfSave (roman+decimal) err=");
    PrintInt(err);
    Print("\n");
    return 1;
  }

  var rdr: int64 := PdfOpen("/tmp/pdf_labels_roman_decimal.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 5) {
    Print("FAIL: page count expected 5, got ");
    PrintInt(n);
    Print("\n");
    return 1;
  }
  Print("OK: roman-lower + decimal labels\n");
  return 0;
}

fn testLabelSingleRange(): int64 {
  // Only one label range: decimal from page 0
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (single)\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "Page 1");

  PdfSetPageLabel(doc, 0, PDF_LABEL_DECIMAL, "", 1);

  var err: int64 := PdfSave(doc, "/tmp/pdf_labels_single.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (single)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_labels_single.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (single)\n"); return 1; }
  PdfClose(rdr);
  Print("OK: single decimal range\n");
  return 0;
}

fn testLabelWithPrefix(): int64 {
  // Appendix pages labeled "A-1", "A-2", etc.
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (prefix)\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p2: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Main page 1");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Main page 2");
  PdfSetFont(doc, p2, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p2, 72.0, 750.0, "Appendix A-1");

  PdfSetPageLabel(doc, 0, PDF_LABEL_DECIMAL, "", 1);
  PdfSetPageLabel(doc, 2, PDF_LABEL_DECIMAL, "A-", 1);

  var err: int64 := PdfSave(doc, "/tmp/pdf_labels_prefix.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (prefix)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_labels_prefix.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (prefix)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 3) { Print("FAIL: prefix page count\n"); return 1; }
  Print("OK: decimal with prefix\n");
  return 0;
}

fn testLabelAlphabetic(): int64 {
  // Uppercase alphabetic labels: A, B, C
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (alpha)\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Tab A");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Tab B");

  PdfSetPageLabel(doc, 0, PDF_LABEL_ALPHA_U, "", 1);

  var err: int64 := PdfSave(doc, "/tmp/pdf_labels_alpha.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (alpha)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_labels_alpha.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (alpha)\n"); return 1; }
  PdfClose(rdr);
  Print("OK: uppercase alphabetic labels\n");
  return 0;
}

fn testLabelNoLabels(): int64 {
  // PDF without any label ranges: unchanged behavior
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (none)\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "No labels");

  var err: int64 := PdfSave(doc, "/tmp/pdf_labels_none.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (none)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_labels_none.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (none)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 1) { Print("FAIL: no-labels page count\n"); return 1; }
  Print("OK: no labels — PDF unaffected\n");
  return 0;
}

pub fn main(): int64 {
  if (testLabelRomanThenDecimal() != 0) { return 1; }
  if (testLabelSingleRange()      != 0) { return 1; }
  if (testLabelWithPrefix()       != 0) { return 1; }
  if (testLabelAlphabetic()       != 0) { return 1; }
  if (testLabelNoLabels()         != 0) { return 1; }
  Print("All WP-PDF-11 page label tests passed.\n");
  return 0;
}
