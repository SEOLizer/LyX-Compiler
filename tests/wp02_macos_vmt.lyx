// WP-02: macOS x86_64 — VMT pointer initialization
// Verifies that `new ClassName()` correctly initializes the VMT pointer on macOS.
// The macOS backend must translate the Linux ELF VMT address (0x4000B0+offset)
// to the macOS Mach-O address (0x100001000+offset) via mxb_patchVMTAddrs.
import std.io;

type Counter = class {
  count: int64;
  fn Increment() { self.count := self.count + 1; }
  fn GetCount(): int64 { return self.count; }
};

type Accumulator = class {
  sum: int64;
  fn Add(v: int64) { self.sum := self.sum + v; }
  fn GetSum(): int64 { return self.sum; }
};

fn main(): int64 {
  var c: Counter := new Counter();
  c.Increment();
  c.Increment();
  c.Increment();
  var count: int64 := c.GetCount();
  PrintInt(count);
  PrintLn("");

  var a: Accumulator := new Accumulator();
  a.Add(10);
  a.Add(20);
  a.Add(30);
  var total: int64 := a.GetSum();
  PrintInt(total);
  PrintLn("");

  return 0;
}
