// WP-02: macOS x86_64 — DynArray (mmap flags 34 → 0x1002)
// Verifies that DynArray push/pop/len/free work correctly on macOS.
import std.io;

fn main(): int64 {
  var arr: int64[] := [];
  push(arr, 10);
  push(arr, 20);
  push(arr, 30);
  push(arr, 40);

  var l: int64 := len(arr);
  PrintInt(l);
  PrintLn("");

  var v: int64 := pop(arr);
  PrintInt(v);
  PrintLn("");

  var l2: int64 := len(arr);
  PrintInt(l2);
  PrintLn("");

  // #1264: `free` nimmt Adresse UND Groesse. Der Aufruf gab nur die Adresse
  // mit; die Groesse kam vom Stack, munmap bekam also eine beliebige Laenge.
  free(arr, 8 * 4);
  return 0;
}
