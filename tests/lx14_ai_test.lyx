// LX-14 Test: KI-Basis (0x0800–0x0806) — nur Kompilierung & Syscall-Präsenz prüfen.

import src.std.lyxos.ai;

fn main(): int64 {
    // sys_ai_model_load / sys_ai_model_unload / sys_ai_model_info
    var mfd: int64 := sys_ai_model_load(-1, "/models/test.gguf"c, AI_MODEL_LAZY);
    sys_ai_model_info(mfd, 0 as pchar);
    sys_ai_model_unload(mfd);

    // sys_ai_ctx_create / sys_ai_ctx_destroy
    var cfd: int64 := sys_ai_ctx_create(mfd, 0, AI_CTX_DEFAULT);
    sys_ai_ctx_destroy(cfd);

    // sys_ai_infer (async) — gibt Job-fd zurück
    var jfd: int64 := sys_ai_infer(cfd, 0, 0, 0 as pchar);

    // sys_ai_infer_sync (blockierend, 6 args)
    var buf: int64 := 0;
    var res: int64 := sys_ai_infer_sync(cfd, 0 as pchar, 0, 0 as pchar, 0, 0 as pchar);

    return res;
}
