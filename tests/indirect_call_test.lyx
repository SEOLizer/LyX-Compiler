// tests/indirect_call_test.lyx — _indirect_call_N(fnPtr, a1..aN).
//
// Ruft einen ROHEN Code-Pointer (kein Closure-Struct). _0 und _1 gab es,
// _2/_3/_4 waren in sema registriert, aber nie emittiert — der Aufruf bestand
// sema und starb im Codegen mit "no codegen implementation found".
//
// Aufgefallen ist das erst an den Android-JNI-Beispielen: std/android/jni.lyx
// benutzt _indirect_call_2 und _4, galt aber als übersetzbar, weil
// `--compile-unit` den Codegen gar nicht erreicht. Ein Unit-Sweep kann diese
// Fehlerklasse also nicht sehen — nur ein echtes Programm.
//
// Geprüft wird die Argumentlage: die Werte müssen in rdi/rsi/rdx/rcx in der
// richtigen Reihenfolge ankommen, deshalb stellenwertige Erwartungen (123,
// 1234) statt einer Summe, die eine Vertauschung überleben würde.

import std.io;
var fails: int64 := 0;
fn e(n: pchar, g: int64, w: int64) { Print(n); Print(": "); if (g == w) { PrintLn("OK"); } else { Print("FAIL "); PrintInt(g); PrintLn(""); fails += 1; } }
fn f0(): int64 { return 7; }
fn f1(a: int64): int64 { return a + 1; }
fn f2(a: int64, b: int64): int64 { return a * 10 + b; }
fn f3(a: int64, b: int64, c: int64): int64 { return a * 100 + b * 10 + c; }
fn f4(a: int64, b: int64, c: int64, d: int64): int64 { return a * 1000 + b * 100 + c * 10 + d; }
fn main(): int64 {
  e("call_0", _indirect_call_0(f0 as int64), 7);
  e("call_1", _indirect_call_1(f1 as int64, 41), 42);
  e("call_2", _indirect_call_2(f2 as int64, 4, 2), 42);
  e("call_3", _indirect_call_3(f3 as int64, 1, 2, 3), 123);
  e("call_4", _indirect_call_4(f4 as int64, 1, 2, 3, 4), 1234);
  if (fails == 0) { PrintLn("ALL OK"); return 0; }
  return 1;
}
