// tests/modmath_test.lyx
// Selbstpruefende Testbatterie fuer std.modmath.
// Bau: lyxc tests/modmath_test.lyx -I . -I /home/andreas/PhpstormProjects/aurum -o /tmp/modmath_test

unit main;

import std.modmath;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn Check(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckBool(name: pchar, got: bool, want: bool): void {
  var g: int64 := 0;
  var w: int64 := 0;
  if (got)  { g := 1; }
  if (want) { w := 1; }
  Check(name, g, w);
}

fn main(): int64 {
  // ── Normalisierung: `%` schneidet Richtung Null ab, ModNorm nicht ──────────
  Check("norm+"c,      ModNorm(7, 3),    1);
  Check("norm-"c,      ModNorm(-7, 3),   2);
  Check("norm0"c,      ModNorm(0, 5),    0);
  Check("normBig"c,    ModNorm(-1, 1000000007), 1000000006);
  Check("normM1"c,     ModNorm(9, 1),    0);
  Check("normBadM"c,   ModNorm(5, 0),    MOD_ERR);
  Check("normOver"c,   ModNorm(5, MOD_MAX + 1), MOD_ERR);
  CheckBool("eq"c,     ModEq(-7, 2, 3),  true);
  CheckBool("neq"c,    ModEq(-7, 1, 3),  false);

  // ── Grundoperationen ──────────────────────────────────────────────────────
  Check("add"c,    ModAdd(9, 8, 5),      2);
  Check("addNeg"c, ModAdd(-9, 8, 5),     4);
  Check("sub"c,    ModSub(3, 8, 5),      0);
  Check("subNeg"c, ModSub(1, 3, 5),      3);
  Check("neg"c,    ModNeg(2, 5),         3);
  Check("neg0"c,   ModNeg(0, 5),         0);
  Check("mul"c,    ModMul(7, 8, 5),      1);
  Check("mulNeg"c, ModMul(-7, 8, 5),     4);

  // Ueberlaufsicherheit: direkt gerechnet wrappt das (4e9 * 4e9 ist als int64
  // negativ), ueber Verdoppeln-und-Addieren nicht.
  Check("mulBig"c,  ModMul(4000000000, 4000000000, 1000000007), 784);
  Check("mulHuge"c, ModMul(MOD_MAX - 1, MOD_MAX - 2, MOD_MAX),  2);
  Check("mulM1"c,   ModMul(5, 5, 1),     0);

  // ── Potenzen ──────────────────────────────────────────────────────────────
  Check("pow"c,     ModPow(2, 10, 1000),        24);
  Check("pow0"c,    ModPow(5, 0, 7),            1);
  Check("powFermat"c, ModPow(3, 1000000006, 1000000007), 1);   // kleiner Fermat
  Check("powNegE"c, ModPow(3, -1, 7),           5);            // 3*5 = 15 = 1 mod 7
  Check("powNegNo"c, ModPow(2, -1, 4),          MOD_ERR);      // 2 nicht invertierbar
  Check("powBig"c,  ModPow(123456789, 987654321, 4611686018427387847), 684252095760009403);

  // ── Erweiterter Euklid ────────────────────────────────────────────────────
  var xb: int64 := alloc(8);
  var yb: int64 := alloc(8);
  Check("gcdExtG"c, ModGcdExt(240, 46, xb, yb), 2);
  Check("gcdExtX"c, peek64(xb), -9);
  Check("gcdExtY"c, peek64(yb), 47);
  // Bezout-Identitaet muss halten
  Check("bezout"c, 240 * peek64(xb) + 46 * peek64(yb), 2);
  Check("gcdExtNeg"c, ModGcdExt(-240, 46, xb, yb), 2);   // gcd bleibt positiv
  Check("gcd"c,     ModGcd(240, 46),  2);
  Check("gcdZero"c, ModGcd(0, 7),     7);
  free(xb, 8);
  free(yb, 8);

  // ── Inverse und Division ──────────────────────────────────────────────────
  Check("inv"c,      ModInv(3, 7),      5);
  Check("invNeg"c,   ModInv(-3, 7),     2);
  Check("invNone"c,  ModInv(2, 4),      MOD_ERR);
  Check("invPrime"c, ModInv(123456789, 1000000007), 18633540);
  Check("invRound"c, ModMul(123456789, ModInv(123456789, 1000000007), 1000000007), 1);
  Check("div"c,      ModDiv(6, 3, 7),   2);
  Check("divInv"c,   ModDiv(1, 3, 7),   5);
  Check("divNone"c,  ModDiv(1, 2, 4),   MOD_ERR);
  CheckBool("unit"c,    ModIsUnit(3, 8),  true);
  CheckBool("notUnit"c, ModIsUnit(2, 8),  false);

  // ── Lineare Kongruenzen ───────────────────────────────────────────────────
  var sx: int64 := alloc(8);
  var sm: int64 := alloc(8);
  // 14x = 30 (mod 100): g = 2, zwei Loesungen, kleinste x = 45 modulo 50
  Check("linG"c,   ModSolveLinear(14, 30, 100, sx, sm), 2);
  Check("linX"c,   peek64(sx), 45);
  Check("linMod"c, peek64(sm), 50);
  Check("linCheck"c, ModMul(14, peek64(sx), 100), ModNorm(30, 100));
  Check("linNone"c,  ModSolveLinear(14, 31, 100, sx, sm), MOD_ERR);
  Check("linUnit"c,  ModSolveLinear(3, 1, 7, sx, sm), 1);
  Check("linUnitX"c, peek64(sx), 5);
  free(sx, 8);
  free(sm, 8);

  // ── Chinesischer Restsatz ─────────────────────────────────────────────────
  var cr: int64 := alloc(8);
  Check("crtM"c,  ModCrt2(2, 3, 3, 5, cr), 15);
  Check("crtR"c,  peek64(cr), 8);
  // nicht teilerfremd, vertraeglich: x = 2 mod 6 und x = 8 mod 10 -> 8 mod 30
  Check("crtNcM"c, ModCrt2(2, 6, 8, 10, cr), 30);
  Check("crtNcR"c, peek64(cr), 8);
  // nicht teilerfremd, unvertraeglich
  Check("crtBad"c, ModCrt2(1, 6, 2, 10, cr), MOD_ERR);
  // Ueberlaufschutz statt stillem Wrap
  Check("crtOver"c, ModCrt2(1, 3037000493, 1, 3037000507, cr), MOD_ERR);

  var rs: int64 := alloc(3 * 8);
  var ms: int64 := alloc(3 * 8);
  poke64(rs, 2);      poke64(rs + 8, 3);   poke64(rs + 16, 2);
  poke64(ms, 3);      poke64(ms + 8, 5);   poke64(ms + 16, 7);
  Check("crtNM"c, ModCrtN(rs, ms, 3, cr), 105);
  Check("crtNR"c, peek64(cr), 23);
  free(rs, 3 * 8);
  free(ms, 3 * 8);
  free(cr, 8);

  // ── Ringstruktur ──────────────────────────────────────────────────────────
  Check("phi1"c,   ModEulerPhi(1),   1);
  Check("phiP"c,   ModEulerPhi(7),   6);
  Check("phi12"c,  ModEulerPhi(12),  4);
  Check("phiPk"c,  ModEulerPhi(9),   6);
  Check("phiBig"c, ModEulerPhi(1000000007), 1000000006);

  CheckBool("prime2"c,   ModIsPrime(2),    true);
  CheckBool("prime1"c,   ModIsPrime(1),    false);
  CheckBool("prime91"c,  ModIsPrime(91),   false);   // 7*13, Fermat-Pseudoprim zur Basis 3
  CheckBool("primeCar"c, ModIsPrime(561),  false);   // Carmichael-Zahl
  CheckBool("primeBig"c, ModIsPrime(1000000007), true);
  CheckBool("primeBad"c, ModIsPrime(1000000009 * 3), false);
  CheckBool("primeMax"c, ModIsPrime(4611686018427387847), true);

  Check("ord1"c,   ModOrder(1, 7),   1);
  Check("ord3"c,   ModOrder(3, 7),   6);   // Primitivwurzel
  Check("ord2"c,   ModOrder(2, 7),   3);
  Check("ord10"c,  ModOrder(10, 3),  1);
  Check("ordNone"c, ModOrder(2, 4),  MOD_ERR);
  Check("ord12"c,  ModOrder(5, 12),  2);
  CheckBool("primRoot"c,  ModIsPrimitiveRoot(3, 7),  true);
  CheckBool("primRootN"c, ModIsPrimitiveRoot(2, 7),  false);
  Check("primRootP"c, ModPrimitiveRoot(7),  3);
  Check("primRoot8"c, ModPrimitiveRoot(8),  MOD_ERR);   // Gruppe nicht zyklisch

  // ── Quadratische Reste ────────────────────────────────────────────────────
  Check("leg1"c,  ModLegendre(2, 7),   1);    // 3^2 = 2 mod 7
  Check("legN1"c, ModLegendre(3, 7),  -1);
  Check("leg0"c,  ModLegendre(7, 7),   0);
  Check("jac1"c,  ModJacobi(2, 7),     1);
  Check("jacC"c,  ModJacobi(2, 15),    1);    // (2/3)*(2/5) = (-1)*(-1)
  Check("jac0"c,  ModJacobi(3, 9),     0);
  Check("jacEven"c, ModJacobi(3, 8),   MOD_ERR);

  Check("sqrt3m4"c, ModSqrt(2, 7),     4);    // 4^2 = 16 = 2 mod 7
  Check("sqrtNone"c, ModSqrt(3, 7),    MOD_ERR);
  Check("sqrt0"c,   ModSqrt(0, 7),     0);
  Check("sqrt2"c,   ModSqrt(1, 2),     1);
  // p = 1 mod 4 erzwingt den vollen Tonelli-Shanks-Pfad
  var r13: int64 := ModSqrt(10, 13);
  Check("sqrtTS"c,  ModMul(r13, r13, 13), 10);
  // 1000000009 = 1 mod 4; 241383801 = 123456^2 ist dort quadratischer Rest
  var rbig: int64 := ModSqrt(241383801, 1000000009);
  Check("sqrtTSBig"c, ModMul(rbig, rbig, 1000000009), 241383801);

  // ── Ergebnis ──────────────────────────────────────────────────────────────
  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
