// WP-07: std.net — IPv6 Support
// Tests:
//   1. SocketNewV6   — create raw IPv6 TCP socket
//   2. BindV6        — bind to ::1 (loopback) ephemeral port
//   3. ConnectV6     — API compiles + syscall reached (no server; ECONNREFUSED expected)
//   4. ParseIPv6     — parse "::1" and verify hi=0, lo=1
//   5. IPv6Format    — format loopback and verify string "::1"
//   6. DNSResultGetIPv6Hi/Lo — extract from synthesised AAAA result buffer
import std.io;
import std.net.socket;
import std.net.types;
import std.net.dns;

fn main(): int64 {
  var ok: int64 := 1;

  // ---- 1. SocketNewV6 -------------------------------------------------------
  var fd: int64 := SocketNewV6();
  if (fd < 0) {
    PrintLn("FAIL: SocketNewV6");
    return 1;
  }

  // ---- 2. BindV6 (::1, port 0 = ephemeral) ----------------------------------
  var loHi: int64 := IPv6LoopbackHi();
  var loLo: int64 := IPv6LoopbackLo();
  var r: int64 := BindV6(fd, loHi, loLo, 0);
  if (r < 0) {
    PrintLn("FAIL: BindV6");
    sys_close(fd);
    return 1;
  }
  sys_close(fd);

  // ---- 3. ConnectV6 (loopback port 1 — no server; ECONNREFUSED = -111) ------
  var fd2: int64 := SocketNewV6();
  if (fd2 >= 0) {
    var cr: int64 := ConnectV6(fd2, loHi, loLo, 1);
    sys_close(fd2);
    if (cr == 0) { ok := 0; }  // unexpected success (no server on port 1)
  }

  // ---- 4. ParseIPv6 ("::1") -------------------------------------------------
  var hiPtr: int64 := mmap(0, 8, 3, 34, -1, 0);
  var loPtr: int64 := mmap(0, 8, 3, 34, -1, 0);
  var s: pchar := "::1"c;
  ParseIPv6(s as int64, 3, hiPtr, loPtr);
  var hi: int64 := peek64(hiPtr);
  var lo: int64 := peek64(loPtr);
  munmap(hiPtr, 8); munmap(loPtr, 8);
  if (hi != 0 || lo != 1) {
    PrintLn("FAIL: ParseIPv6 ::1");
    return 1;
  }

  // ---- 5. IPv6Format (loopback -> "::1") ------------------------------------
  var fmtBuf: int64 := mmap(0, 48, 3, 34, -1, 0);
  IPv6Format(0, 1, fmtBuf);
  var c0: int64 := peek8(fmtBuf);
  var c1: int64 := peek8(fmtBuf + 1);
  var c2: int64 := peek8(fmtBuf + 2);
  var c3: int64 := peek8(fmtBuf + 3);
  munmap(fmtBuf, 48);
  // "::1" = 58 58 49 0
  if (c0 != 58 || c1 != 58 || c2 != 49 || c3 != 0) {
    PrintLn("FAIL: IPv6Format");
    return 1;
  }

  // ---- 6. DNSResultGetIPv6Hi/Lo (synthesised AAAA buffer) ------------------
  // Build a fake 128-byte result with success=1, type=AAAA(28), dataLen=16
  // and IPv6 2001:db8::1 at offset 40.
  var res: int64 := mmap(0, 128, 3, 34, -1, 0);
  poke8(res + 0, 1);   // success
  poke8(res + 8, 28);  // DNS_TYPE_AAAA
  poke8(res + 32, 16); // dataLen
  // 2001:0db8:0000:0000:0000:0000:0000:0001
  poke8(res + 40, 0x20); poke8(res + 41, 0x01);
  poke8(res + 42, 0x0d); poke8(res + 43, 0xb8);
  poke8(res + 44, 0);    poke8(res + 45, 0);
  poke8(res + 46, 0);    poke8(res + 47, 0);
  poke8(res + 48, 0);    poke8(res + 49, 0);
  poke8(res + 50, 0);    poke8(res + 51, 0);
  poke8(res + 52, 0);    poke8(res + 53, 0);
  poke8(res + 54, 0);    poke8(res + 55, 1);
  var v6hi: int64 := DNSResultGetIPv6Hi(res);
  var v6lo: int64 := DNSResultGetIPv6Lo(res);
  munmap(res, 128);
  // Expected hi = 0x20010db800000000, lo = 1
  var expHi: int64 := (0x2001 << 48) | (0x0db8 << 32);
  if (v6hi != expHi || v6lo != 1) {
    PrintLn("FAIL: DNSResultGetIPv6Hi/Lo");
    return 1;
  }

  if (ok == 0) {
    PrintLn("FAIL: ConnectV6 unexpected success");
    return 1;
  }

  PrintLn("PASS");
  return 0;
}
