// OOP Bug #1 (geerbte Feld-Offsets) — Kernel-Verifikations-Repro für PR #856.
// Auf echtem LyxOS-Kernel testen (NICHT lbf_run/Linux — new→mmap nr9 ≠ Linux).
// Erwartung nach #856: alle Werte korrekt (vor #856: Garbage 0/1016).
//
// Compile: lyxc --target=lyxos tests/oop_field_kernel_repro.lyx -o repro.lyxnative
// (develop ≥ 1.0.2F enthält #856.)
//
// PrintInt-Schritte für Serial-Output (jeder Schritt einzeln verifizierbar):

type A = class {
    val: int64;
    virtual fn S(): int64 { return 0; }
};

type D = class extends A {
    override fn S(): int64 { return self.val + 1; }
    fn C(v: int64) { self.val := v; }
};

fn main(): int64 {
    var d: D := new D();
    d.C(41);
    PrintInt(d.val);        // erwartet 41  (geerbtes Feld val, Schreib via self in C, Lese via d.val)
    PrintLn("");
    var d2: D := new D();
    d2.C(7);
    PrintInt(d.val);        // erwartet 41  (zwei Objekte, kein Aliasing)
    PrintLn("");
    PrintInt(d2.val);       // erwartet 7
    PrintLn("");
    return d.val;           // exit-code 41
}
