// tests/grp03_edge_test.lyx
// WP-GRP-03 Abnahmetest: GraphEdge Type, Properties

unit tests.grp03_edge_test;

import std.graphdb.core;
import std.graphdb.edge;
import std.io;
import std.alloc;

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    var e: int64 := alloc(GEDGE_SIZE);
    GraphEdgeInit(e);
    PrintLn("PASS: GraphEdgeInit no crash"c);

    // createdAt nach Init = 0
    var cat: int64 := peek64(e + GEDGE_OFF_CREATEDAT);
    if (cat != 0) {
        PrintLn("FAIL: createdAt after init != 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: createdAt after init = 0"c);
    }

    // Aufrufer setzt createdAt
    poke64(e + GEDGE_OFF_CREATEDAT, GraphNow());

    // EdgeType
    GraphEdgeSetType(e, "KNOWS"c, 5);

    if (GraphEdgeTypeEq(e, "KNOWS"c, 5) != 1) {
        PrintLn("FAIL: TypeEq KNOWS"c);
        ok := 0;
    } else {
        PrintLn("PASS: TypeEq KNOWS=1"c);
    }

    if (GraphEdgeTypeEq(e, "PRODUCED"c, 8) != 0) {
        PrintLn("FAIL: TypeEq PRODUCED should be 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: TypeEq PRODUCED=0"c);
    }

    // SetInt / GetInt
    GraphEdgeSetInt(e, "weight"c, 6, 99);
    var w: int64 := GraphEdgeGetInt(e, "weight"c, 6);
    if (w != 99) {
        PrintLn("FAIL: GetInt weight != 99"c);
        ok := 0;
    } else {
        PrintLn("PASS: GetInt weight=99"c);
    }

    // SetStr / GetStr
    GraphEdgeSetStr(e, "label"c, 5, "friends"c, 7);
    var slen: int64 := alloc(8);
    var sptr: pchar := GraphEdgeGetStr(e, "label"c, 5, slen);
    var gotLen: int64 := peek64(slen);
    free(slen, 8);
    if (gotLen != 7) {
        PrintLn("FAIL: GetStr len != 7"c);
        ok := 0;
    } else {
        PrintLn("PASS: GetStr len=7"c);
    }
    if (sptr == 0 as pchar) {
        PrintLn("FAIL: GetStr returned null"c);
        ok := 0;
    } else {
        if (StrCharAt(sptr, 0) != 102) {
            PrintLn("FAIL: GetStr first char != f"c);
            ok := 0;
        } else {
            PrintLn("PASS: GetStr = friends"c);
        }
    }

    // SetF64 / GetF64 (bits-basiert)
    var expBits: int64 := (3.14 as f64) as int64;
    GraphEdgeSetF64(e, "score"c, 5, expBits);
    var gotBits: int64 := GraphEdgeGetF64(e, "score"c, 5);
    if (gotBits != expBits) {
        PrintLn("FAIL: GetF64 score bits mismatch"c);
        ok := 0;
    } else {
        PrintLn("PASS: GetF64 score bits match"c);
    }

    // Properties koexistieren
    var w2: int64 := GraphEdgeGetInt(e, "weight"c, 6);
    if (w2 != 99) {
        PrintLn("FAIL: weight lost after adding more props"c);
        ok := 0;
    } else {
        PrintLn("PASS: props coexist"c);
    }

    // EdgeType überschreiben
    GraphEdgeSetType(e, "LIKES"c, 5);
    if (GraphEdgeTypeEq(e, "LIKES"c, 5) != 1) {
        PrintLn("FAIL: TypeEq LIKES after overwrite"c);
        ok := 0;
    } else {
        PrintLn("PASS: TypeEq LIKES after overwrite"c);
    }
    if (GraphEdgeTypeEq(e, "KNOWS"c, 5) != 0) {
        PrintLn("FAIL: TypeEq KNOWS should be 0 after overwrite"c);
        ok := 0;
    } else {
        PrintLn("PASS: TypeEq KNOWS=0 after overwrite"c);
    }

    GraphEdgeFree(e);
    free(e, GEDGE_SIZE);
    PrintLn("PASS: GraphEdgeFree no crash"c);

    if (ok != 0) {
        PrintLn("=== WP-GRP-03: ALL PASS ==="c);
    } else {
        PrintLn("=== WP-GRP-03: FAILURES ==="c);
    }
    return ok;
}
