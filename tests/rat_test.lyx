// tests/rat_test.lyx
// Selbstpruefende Testbatterie fuer std.rat.
//
// Die Sollwerte stammen, wo sie nicht offensichtlich sind, aus Pythons
// fractions.Fraction — einer unabhaengigen Umsetzung derselben Mathematik.
// Nachgerechnet wurde mit denselben Eingaben, nicht mit denselben Formeln.

unit main;

import std.io;
import std.rat;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn Fail(name: pchar): void {
  _fails := _fails + 1;
  PrintStr("FAIL "c);
  PrintStr(name);
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    Fail(name);
    PrintStr(" got="c); PrintInt(got);
    PrintStr(" want="c); PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    Fail(name);
    PrintStr(" got="c); PrintBool(got);
    PrintStr(" want="c); PrintBool(want);
    PrintStr("\n"c);
  }
}

// Ein Bruch stimmt, wenn Zaehler UND Nenner stimmen. Der Vergleich laeuft
// bewusst auf den Komponenten und nicht ueber RatEquals(): sonst pruefte der
// Test die Kanonisierung mit derselben Funktion, die sie herstellt.
fn CheckR(name: pchar, got: Rat, wn: int64, wd: int64): void {
  _checks := _checks + 1;
  if (RatNum(got) != wn || RatDen(got) != wd) {
    Fail(name);
    PrintStr(" got="c); PrintInt(RatNum(got));
    PrintStr("/"c); PrintInt(RatDen(got));
    PrintStr(" want="c); PrintInt(wn);
    PrintStr("/"c); PrintInt(wd);
    PrintStr("\n"c);
  }
}

fn CheckNaR(name: pchar, got: Rat): void {
  _checks := _checks + 1;
  if (RatIsValid(got)) {
    Fail(name);
    PrintStr(" erwartet NaR, bekam "c); PrintInt(RatNum(got));
    PrintStr("/"c); PrintInt(RatDen(got));
    PrintStr("\n"c);
  }
}

fn CheckF(name: pchar, got: f64, want: f64, eps: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > eps) {
    Fail(name);
    PrintStr(" got="c); PrintFloat(got);
    PrintStr(" want="c); PrintFloat(want);
    PrintStr("\n"c);
  }
}

fn StrEq(a: int64, b: int64): bool {
  var i: int64 := 0;
  var eq: bool := true;
  var running: bool := true;
  while (running) {
    var ca: int64 := peek8(a + i);
    var cb: int64 := peek8(b + i);
    if (ca != cb) { eq := false; running := false; }
    if (running && ca == 0) { running := false; }
    i := i + 1;
  }
  return eq;
}

fn CheckS(name: pchar, buf: int64, want: pchar): void {
  _checks := _checks + 1;
  if (!StrEq(buf, want as int64)) {
    Fail(name);
    PrintStr(" got=\""c); PrintStr(buf as pchar);
    PrintStr("\" want=\""c); PrintStr(want);
    PrintStr("\"\n"c);
  }
}

fn main(): int64 {
  var buf: int64 := alloc(256);

  // ── Kanonisierung ─────────────────────────────────────────────────────────
  CheckR("new_reduce"c, RatNew(6, 8), 3, 4);
  CheckR("new_negDen"c, RatNew(3, 0 - 4), 0 - 3, 4);
  CheckR("new_bothNeg"c, RatNew(0 - 3, 0 - 4), 3, 4);
  CheckR("new_negNum"c, RatNew(0 - 6, 8), 0 - 3, 4);
  CheckR("new_zero"c, RatNew(0, 5), 0, 1);
  CheckR("new_zeroNegDen"c, RatNew(0, 0 - 5), 0, 1);
  CheckR("new_int"c, RatNew(12, 4), 3, 1);
  CheckR("new_alreadyRed"c, RatNew(7, 9), 7, 9);
  CheckNaR("new_denZero"c, RatNew(1, 0));
  CheckR("fromInt"c, RatFromInt(0 - 7), 0 - 7, 1);
  CheckR("zero"c, RatZero(), 0, 1);
  CheckR("one"c, RatOne(), 1, 1);
  CheckB("isInt_yes"c, RatIsInt(RatNew(9, 3)), true);
  CheckB("isInt_no"c, RatIsInt(RatNew(9, 4)), false);
  CheckB("isZero_yes"c, RatIsZero(RatNew(0, 7)), true);
  CheckB("isZero_no"c, RatIsZero(RatNew(1, 7)), false);
  CheckB("isZero_nar"c, RatIsZero(RatNew(1, 0)), false);

  // -2^63 ist ausgeschlossen — dokumentierte Grenze, nicht Zufall
  var minv: int64 := (0 - 9223372036854775807) - 1;
  CheckNaR("min_num"c, RatNew(minv, 1));
  CheckNaR("min_den"c, RatNew(1, minv));
  CheckNaR("min_fromInt"c, RatFromInt(minv));

  // ── Vorzeichen, Betrag, Kehrwert ──────────────────────────────────────────
  CheckI("sign_pos"c, RatSign(RatNew(3, 4)), 1);
  CheckI("sign_neg"c, RatSign(RatNew(0 - 3, 4)), 0 - 1);
  CheckI("sign_zero"c, RatSign(RatZero()), 0);
  CheckR("neg"c, RatNeg(RatNew(3, 4)), 0 - 3, 4);
  CheckR("neg_neg"c, RatNeg(RatNew(0 - 3, 4)), 3, 4);
  CheckR("neg_zero"c, RatNeg(RatZero()), 0, 1);
  CheckR("abs"c, RatAbs(RatNew(0 - 3, 4)), 3, 4);
  CheckR("abs_pos"c, RatAbs(RatNew(3, 4)), 3, 4);
  CheckR("inv"c, RatInv(RatNew(3, 4)), 4, 3);
  CheckR("inv_neg"c, RatInv(RatNew(0 - 3, 4)), 0 - 4, 3);
  CheckNaR("inv_zero"c, RatInv(RatZero()));

  // ── Grundrechenarten gegen Handrechnung ───────────────────────────────────
  CheckR("add"c, RatAdd(RatNew(1, 2), RatNew(1, 3)), 5, 6);
  CheckR("add_reduce"c, RatAdd(RatNew(1, 6), RatNew(1, 3)), 1, 2);
  CheckR("add_lcm"c, RatAdd(RatNew(1, 6), RatNew(1, 10)), 4, 15);
  CheckR("add_zero"c, RatAdd(RatNew(3, 7), RatZero()), 3, 7);
  CheckR("add_toZero"c, RatAdd(RatNew(3, 7), RatNew(0 - 3, 7)), 0, 1);
  CheckR("sub"c, RatSub(RatNew(1, 2), RatNew(1, 3)), 1, 6);
  CheckR("sub_self"c, RatSub(RatNew(5, 9), RatNew(5, 9)), 0, 1);
  CheckR("mul"c, RatMul(RatNew(2, 3), RatNew(3, 5)), 2, 5);
  CheckR("mul_zero"c, RatMul(RatNew(2, 3), RatZero()), 0, 1);
  CheckR("mul_neg"c, RatMul(RatNew(0 - 2, 3), RatNew(3, 5)), 0 - 2, 5);
  CheckR("mul_negNeg"c, RatMul(RatNew(0 - 2, 3), RatNew(0 - 3, 5)), 2, 5);
  CheckR("div"c, RatDiv(RatNew(2, 3), RatNew(4, 5)), 5, 6);
  CheckR("div_self"c, RatDiv(RatNew(7, 11), RatNew(7, 11)), 1, 1);
  CheckNaR("div_zero"c, RatDiv(RatNew(1, 2), RatZero()));

  // Der Fall, an dem f64 scheitert: drei Drittel sind hier exakt eins
  var third: Rat := RatNew(1, 3);
  CheckR("thirds_exact"c, RatAdd(RatAdd(third, third), third), 1, 1);
  var tenth: Rat := RatNew(1, 10);
  var s10: Rat := RatZero();
  var i: int64 := 0;
  while (i < 10) { s10 := RatAdd(s10, tenth); i := i + 1; }
  CheckR("tenths_exact"c, s10, 1, 1);
  // dieselbe Summe in f64 trifft die 1 NICHT — das ist der Grund fuer die Einheit
  var f10: f64 := 0.0;
  var j: int64 := 0;
  while (j < 10) { f10 := f10 + 0.1; j := j + 1; }
  CheckB("tenths_f64_inexact"c, f10 == 1.0, false);

  // ── Ueberlauf: der kleinste gemeinsame Nenner zaehlt ──────────────────────
  //
  // 2^62 + 2^62 als Produkt der Nenner waere 2^124 und ginge nicht. Ueber den
  // kleinsten gemeinsamen Nenner bleibt es bei 2^62 — und das Ergebnis 1/2^61
  // ist exakt. Ohne den ggT-Schritt in RatAdd waere hier NaR statt einer
  // voellig darstellbaren Antwort.
  var p62: int64 := 4611686018427387904;          // 2^62
  CheckI("p62_value"c, p62, 1 << 62);
  var a62: Rat := RatNew(1, p62);
  CheckR("add_lcmSaves"c, RatAdd(a62, a62), 1, p62 / 2);

  // Kreuzkuerzen vor dem Produkt: (2^62/3) * (3/2^62) ist 1, obwohl beide
  // Zwischenprodukte ueberlaufen wuerden.
  var big1: Rat := RatNew(p62, 3);
  var big2: Rat := RatNew(3, p62);
  CheckR("mul_crossCancel"c, RatMul(big1, big2), 1, 1);

  // Und der Ueberlauf, der wirklich einer ist: 1/2^62 + 1/3 braucht den
  // Nenner 3*2^62 und meldet ehrlich NaR, statt abzuschneiden.
  CheckNaR("add_realOverflow"c, RatAdd(a62, RatNew(1, 3)));
  CheckNaR("mul_realOverflow"c, RatMul(RatNew(p62, 1), RatNew(3, 1)));

  // ── NaR pflanzt sich fort ─────────────────────────────────────────────────
  var nar: Rat := RatNew(1, 0);
  CheckB("nar_invalid"c, RatIsValid(nar), false);
  CheckB("valid"c, RatIsValid(RatNew(1, 2)), true);
  CheckNaR("nar_add"c, RatAdd(nar, RatOne()));
  CheckNaR("nar_addR"c, RatAdd(RatOne(), nar));
  CheckNaR("nar_sub"c, RatSub(RatOne(), nar));
  CheckNaR("nar_mul"c, RatMul(nar, RatOne()));
  CheckNaR("nar_div"c, RatDiv(RatOne(), nar));
  CheckNaR("nar_neg"c, RatNeg(nar));
  CheckNaR("nar_abs"c, RatAbs(nar));
  CheckNaR("nar_inv"c, RatInv(nar));
  CheckNaR("nar_pow"c, RatPow(nar, 2));
  CheckNaR("nar_frac"c, RatFrac(nar));
  CheckB("nar_equals"c, RatEquals(nar, nar), false);
  // Beim Vergleich gilt NaR als kleiner — damit bleibt Sortieren total
  CheckI("nar_cmpBoth"c, RatCmp(nar, nar), 0);
  CheckI("nar_cmpLeft"c, RatCmp(nar, RatNew(0 - 5, 1)), 0 - 1);
  CheckI("nar_cmpRight"c, RatCmp(RatNew(0 - 5, 1), nar), 1);

  // ── Potenzen ──────────────────────────────────────────────────────────────
  CheckR("pow0"c, RatPow(RatNew(2, 3), 0), 1, 1);
  CheckR("pow1"c, RatPow(RatNew(2, 3), 1), 2, 3);
  CheckR("pow3"c, RatPow(RatNew(2, 3), 3), 8, 27);
  CheckR("pow_neg"c, RatPow(RatNew(2, 3), 0 - 2), 9, 4);
  CheckR("pow_negBase"c, RatPow(RatNew(0 - 2, 3), 3), 0 - 8, 27);
  CheckR("pow_negBaseEven"c, RatPow(RatNew(0 - 2, 3), 2), 4, 9);
  CheckR("pow_zeroBase"c, RatPow(RatZero(), 5), 0, 1);
  CheckR("pow_zeroZero"c, RatPow(RatZero(), 0), 1, 1);
  CheckNaR("pow_zeroNeg"c, RatPow(RatZero(), 0 - 1));
  CheckR("pow_10"c, RatPow(RatNew(1, 2), 10), 1, 1024);
  CheckNaR("pow_overflow"c, RatPow(RatNew(2, 3), 100));

  // ── Vergleich ueber 128 Bit ───────────────────────────────────────────────
  CheckI("cmp_lt"c, RatCmp(RatNew(1, 3), RatNew(1, 2)), 0 - 1);
  CheckI("cmp_gt"c, RatCmp(RatNew(1, 2), RatNew(1, 3)), 1);
  CheckI("cmp_eq"c, RatCmp(RatNew(2, 4), RatNew(1, 2)), 0);
  CheckI("cmp_negPos"c, RatCmp(RatNew(0 - 1, 100), RatNew(1, 1000000)), 0 - 1);
  CheckI("cmp_bothNeg"c, RatCmp(RatNew(0 - 1, 2), RatNew(0 - 1, 3)), 0 - 1);
  CheckI("cmp_zero"c, RatCmp(RatZero(), RatZero()), 0);

  // Hier beisst der 128-Bit-Pfad: 2^62/(2^62+1) ist echt kleiner als
  // (2^62+1)/(2^62+2), aber beide Kreuzprodukte sprengen int64 weit. Ein
  // Vergleich in 64 Bit wuerde hier auf abgeschnittenen Zahlen entscheiden.
  var c1: Rat := RatNew(p62, p62 + 1);
  var c2: Rat := RatNew(p62 + 1, p62 + 2);
  CheckI("cmp_128bit"c, RatCmp(c1, c2), 0 - 1);
  CheckI("cmp_128bitRev"c, RatCmp(c2, c1), 1);
  CheckB("cmp_128bitNotEq"c, RatEquals(c1, c2), false);
  // Negativkontrolle: das Kreuzprodukt in int64 gerechnet liefert bei genau
  // diesen Werten das FALSCHE Vorzeichen. Wenn diese Zeile je "false" wird,
  // hat der Vergleich aufgehoert, ueber 128 Bit zu laufen.
  var q1n: int64 := p62 - 2;
  var q1d: int64 := p62 - 1;
  var w1: Rat := RatNew(q1n, q1d);          // knapp unter 1
  var w2: Rat := RatNew(q1d, q1n);          // knapp ueber 1
  CheckI("cmp_128bitPair"c, RatCmp(w1, w2), 0 - 1);
  // Vergleich hoisten: f(x, a < b, y) wird sonst als Typargumentliste geparst
  var naivL: int64 := q1n * q1n;
  var naivR: int64 := q1d * q1d;
  var naiveWrong: bool := naivL < naivR;
  CheckB("cmp_naiveIsWrong"c, naiveWrong, false);

  CheckB("lt"c, RatLt(RatNew(1, 3), RatNew(1, 2)), true);
  CheckB("lt_eq"c, RatLt(RatNew(1, 2), RatNew(1, 2)), false);
  CheckB("le_eq"c, RatLe(RatNew(1, 2), RatNew(2, 4)), true);
  CheckB("equals"c, RatEquals(RatNew(2, 4), RatNew(1, 2)), true);
  CheckB("equals_no"c, RatEquals(RatNew(2, 5), RatNew(1, 2)), false);
  CheckR("min"c, RatMin(RatNew(1, 3), RatNew(1, 2)), 1, 3);
  CheckR("max"c, RatMax(RatNew(1, 3), RatNew(1, 2)), 1, 2);
  CheckR("min_neg"c, RatMin(RatNew(0 - 1, 3), RatNew(1, 2)), 0 - 1, 3);

  // ── Runden ────────────────────────────────────────────────────────────────
  CheckI("floor_pos"c, RatFloor(RatNew(7, 2)), 3);
  CheckI("floor_neg"c, RatFloor(RatNew(0 - 7, 2)), 0 - 4);
  CheckI("floor_exact"c, RatFloor(RatNew(8, 2)), 4);
  CheckI("floor_negExact"c, RatFloor(RatNew(0 - 8, 2)), 0 - 4);
  CheckI("ceil_pos"c, RatCeil(RatNew(7, 2)), 4);
  CheckI("ceil_neg"c, RatCeil(RatNew(0 - 7, 2)), 0 - 3);
  CheckI("ceil_exact"c, RatCeil(RatNew(8, 2)), 4);
  CheckI("trunc_pos"c, RatTrunc(RatNew(7, 2)), 3);
  CheckI("trunc_neg"c, RatTrunc(RatNew(0 - 7, 2)), 0 - 3);
  CheckI("round_up"c, RatRound(RatNew(7, 4)), 2);
  CheckI("round_down"c, RatRound(RatNew(5, 4)), 1);
  CheckI("round_halfPos"c, RatRound(RatNew(7, 2)), 4);
  CheckI("round_halfNeg"c, RatRound(RatNew(0 - 7, 2)), 0 - 4);
  CheckI("round_halfOne"c, RatRound(RatNew(1, 2)), 1);
  CheckI("round_exact"c, RatRound(RatNew(6, 2)), 3);
  // Bankiersrundung: 3.5 auf 4, aber 2.5 auf 2 — beide zur geraden Zahl
  CheckI("rhe_35"c, RatRoundHalfEven(RatNew(7, 2)), 4);
  CheckI("rhe_25"c, RatRoundHalfEven(RatNew(5, 2)), 2);
  CheckI("rhe_neg25"c, RatRoundHalfEven(RatNew(0 - 5, 2)), 0 - 2);
  CheckI("rhe_neg35"c, RatRoundHalfEven(RatNew(0 - 7, 2)), 0 - 4);
  CheckI("rhe_notHalf"c, RatRoundHalfEven(RatNew(7, 4)), 2);
  // Negativkontrolle: bei genau der Haelfte MUESSEN sich beide Regeln
  // unterscheiden, sonst prueft der Test die Unterscheidung gar nicht.
  CheckB("rhe_differs"c, RatRound(RatNew(5, 2)) == RatRoundHalfEven(RatNew(5, 2)), false);
  CheckR("frac_pos"c, RatFrac(RatNew(7, 2)), 1, 2);
  CheckR("frac_neg"c, RatFrac(RatNew(0 - 7, 2)), 0 - 1, 2);
  CheckR("frac_int"c, RatFrac(RatNew(8, 2)), 0, 1);

  // Der Halb-Vergleich darf bei grossen Nennern nicht ueberlaufen: hier ist
  // der Rest so gross, dass sein Doppeltes negativ wuerde.
  var halfBig: Rat := RatNew(p62 - 1, p62);
  CheckI("round_bigNoOverflow"c, RatRound(halfBig), 1);
  CheckI("floor_bigNoOverflow"c, RatFloor(halfBig), 0);

  // ── f64-Bruecke ───────────────────────────────────────────────────────────
  CheckF("toF64_half"c, RatToF64(RatNew(1, 2)), 0.5, 0.0);
  CheckF("toF64_third"c, RatToF64(RatNew(1, 3)), 1.0 / 3.0, 0.000000000000001);
  CheckF("toF64_neg"c, RatToF64(RatNew(0 - 3, 4)), 0.0 - 0.75, 0.0);
  CheckF("toF64_int"c, RatToF64(RatNew(9, 3)), 3.0, 0.0);
  CheckF("toF64_zero"c, RatToF64(RatZero()), 0.0, 0.0);
  CheckF("toF64_improper"c, RatToF64(RatNew(7, 2)), 3.5, 0.0);

  CheckR("fromF64Exact_half"c, RatFromF64Exact(0.5), 1, 2);
  CheckR("fromF64Exact_quarter"c, RatFromF64Exact(0.25), 1, 4);
  CheckR("fromF64Exact_int"c, RatFromF64Exact(7.0), 7, 1);
  CheckR("fromF64Exact_neg"c, RatFromF64Exact(0.0 - 0.75), 0 - 3, 4);
  CheckR("fromF64Exact_zero"c, RatFromF64Exact(0.0), 0, 1);
  // 0.1 ist in f64 nicht 1/10 — die exakte Darstellung zeigt genau das
  CheckR("fromF64Exact_tenth"c, RatFromF64Exact(0.1),
         3602879701896397, 36028797018963968);
  CheckB("fromF64Exact_tenthNotTenth"c,
         RatEquals(RatFromF64Exact(0.1), RatNew(1, 10)), false);

  // Beste Naeherung — Sollwerte aus Fraction.limit_denominator
  var piv: f64 := 3.14159265358979323846;
  CheckR("approxPi_10"c, RatFromF64(piv, 10), 22, 7);
  CheckR("approxPi_100"c, RatFromF64(piv, 100), 311, 99);
  CheckR("approxPi_1000"c, RatFromF64(piv, 1000), 355, 113);
  CheckR("approxPi_10000"c, RatFromF64(piv, 10000), 355, 113);
  CheckR("approxE_1000"c, RatFromF64(2.718281828459045, 1000), 1457, 536);
  CheckR("approx_exactVal"c, RatFromF64(0.75, 1000), 3, 4);
  CheckR("approx_neg"c, RatFromF64(0.0 - piv, 100), 0 - 311, 99);
  CheckR("approx_maxDen1"c, RatFromF64(piv, 1), 3, 1);
  CheckNaR("approx_maxDen0"c, RatFromF64(piv, 0));
  // Der Semikonvergent ist wirklich naeher als die Konvergente 22/7 —
  // ohne diesen Vergleich pruefte nichts, dass der Zusatzschritt etwas bringt
  var e311: f64 := AbsF64(piv - RatToF64(RatNew(311, 99)));
  var e22: f64 := AbsF64(piv - RatToF64(RatNew(22, 7)));
  var semiBetter: bool := e311 < e22;
  CheckB("semiconv_better"c, semiBetter, true);

  CheckR("ratApprox_keep"c, RatApprox(RatNew(3, 4), 100), 3, 4);
  CheckR("ratApprox_pi"c, RatApprox(RatNew(355, 113), 50), 22, 7);
  CheckR("ratApprox_tenth"c, RatApprox(RatFromF64Exact(0.1), 100), 1, 10);
  CheckNaR("ratApprox_nar"c, RatApprox(nar, 10));

  // ── Kettenbrueche ─────────────────────────────────────────────────────────
  var cf: int64 := alloc(64 * 8);
  // 415/93 = [4; 2, 6, 7], ein Lehrbuchbeispiel
  CheckI("cf_len"c, RatContinuedFrac(RatNew(415, 93), cf, 64), 4);
  CheckI("cf_a0"c, peek64(cf), 4);
  CheckI("cf_a1"c, peek64(cf + 8), 2);
  CheckI("cf_a2"c, peek64(cf + 16), 6);
  CheckI("cf_a3"c, peek64(cf + 24), 7);
  CheckR("cf_roundTrip"c, RatFromContinuedFrac(cf, 4), 415, 93);
  // Ganze Zahl: ein einziger Koeffizient
  CheckI("cf_intLen"c, RatContinuedFrac(RatNew(5, 1), cf, 64), 1);
  CheckI("cf_intA0"c, peek64(cf), 5);
  // Negativer Bruch: alle Koeffizienten ab a1 bleiben positiv
  var nn: int64 := RatContinuedFrac(RatNew(0 - 415, 93), cf, 64);
  var tailPos: bool := peek64(cf + 8) > 0;
  CheckB("cf_negTail"c, tailPos, true);
  CheckR("cf_negRound"c, RatFromContinuedFrac(cf, nn), 0 - 415, 93);
  CheckI("cf_nar"c, RatContinuedFrac(nar, cf, 64), 0);
  CheckNaR("cf_fromEmpty"c, RatFromContinuedFrac(cf, 0));

  // ── Mediant und einfachster Bruch ─────────────────────────────────────────
  CheckR("mediant"c, RatMediant(RatNew(1, 3), RatNew(1, 2)), 2, 5);
  CheckR("mediant_01"c, RatMediant(RatZero(), RatOne()), 1, 2);
  CheckNaR("mediant_nar"c, RatMediant(nar, RatOne()));
  // Der Mediant liegt echt zwischen den beiden Bruechen
  var md: Rat := RatMediant(RatNew(1, 3), RatNew(1, 2));
  CheckB("mediant_between"c,
         RatLt(RatNew(1, 3), md) && RatLt(md, RatNew(1, 2)), true);

  // Das Intervall ist GESCHLOSSEN: 1/2 gehoert dazu und hat den kleineren
  // Nenner als 2/5. Waere die Grenze ausgeschlossen, waere 2/5 die Antwort.
  CheckR("simplest_third_half"c, RatSimplest(RatNew(1, 3), RatNew(1, 2)), 1, 2);
  CheckR("simplest_intInside"c, RatSimplest(RatNew(1, 2), RatNew(3, 2)), 1, 1);
  CheckR("simplest_same"c, RatSimplest(RatNew(2, 7), RatNew(2, 7)), 2, 7);
  CheckR("simplest_swapped"c, RatSimplest(RatNew(1, 2), RatNew(1, 3)), 1, 2);
  CheckR("simplest_negRange"c, RatSimplest(RatNew(0 - 1, 2), RatNew(0 - 1, 3)), 0 - 1, 2);
  // [0.3, 0.4] enthaelt 1/3 — und nichts mit kleinerem Nenner
  CheckR("simplest_310_410"c, RatSimplest(RatNew(3, 10), RatNew(4, 10)), 1, 3);
  var sp: Rat := RatSimplest(RatNew(3, 10), RatNew(4, 10));
  CheckB("simplest_inRange"c,
         RatLe(RatNew(3, 10), sp) && RatLe(sp, RatNew(4, 10)), true);
  CheckNaR("simplest_nar"c, RatSimplest(nar, RatOne()));
  // Ein Intervall, in dem kein Bruch mit kleinem Nenner liegt: zwischen
  // 5/17 und 6/17 ist 1/3 der einfachste.
  CheckR("simplest_narrow"c, RatSimplest(RatNew(5, 17), RatNew(6, 17)), 1, 3);

  // Brute-Force-Gegenprobe: fuer viele Intervalle muss das Ergebnis (a) drin
  // liegen und (b) darf von keinem Bruch mit kleinerem Nenner unterboten
  // werden. Das Absuchen ist stumpf und teilt sich keine Zeile Code mit dem
  // Kettenbruchverfahren, das es kontrolliert.
  var spFails: int64 := 0;
  var la: int64 := 1;
  while (la <= 14) {
    var lb: int64 := la + 1;
    while (lb <= 15) {
      var lo2: Rat := RatNew(1, lb);
      var hi2: Rat := RatNew(1, la);
      var got: Rat := RatSimplest(lo2, hi2);
      var inRange: bool := RatLe(lo2, got) && RatLe(got, hi2);
      if (!inRange) { spFails := spFails + 1; }
      var qq: int64 := 1;
      while (qq < RatDen(got)) {
        var pp: int64 := RatFloor(RatMul(hi2, RatFromInt(qq)));
        var cand2: Rat := RatNew(pp, qq);
        var hits: bool := RatLe(lo2, cand2) && RatLe(cand2, hi2);
        if (hits) { spFails := spFails + 1; }
        qq := qq + 1;
      }
      lb := lb + 1;
    }
    la := la + 1;
  }
  CheckI("simplest_isSimplest"c, spFails, 0);

  // ── Textausgabe ───────────────────────────────────────────────────────────
  RatFormat(RatNew(3, 4), buf, 256);      CheckS("fmt_frac"c, buf, "3/4"c);
  RatFormat(RatNew(0 - 10, 4), buf, 256); CheckS("fmt_neg"c, buf, "-5/2"c);
  RatFormat(RatNew(12, 4), buf, 256);     CheckS("fmt_int"c, buf, "3"c);
  RatFormat(RatZero(), buf, 256);         CheckS("fmt_zero"c, buf, "0"c);
  RatFormat(RatNew(0 - 5, 1), buf, 256);  CheckS("fmt_negInt"c, buf, "-5"c);
  RatFormat(nar, buf, 256);               CheckS("fmt_nar"c, buf, "NaR"c);
  CheckI("fmt_len"c, RatFormat(RatNew(0 - 10, 4), buf, 256), 4);
  // Zu kleiner Puffer meldet -1, statt darueber hinaus zu schreiben
  CheckI("fmt_tooSmall"c, RatFormat(RatNew(12345, 6789), buf, 5), 0 - 1);
  CheckI("fmt_bufTiny"c, RatFormat(RatNew(1, 2), buf, 2), 0 - 1);

  RatFormatDecimal(RatNew(1, 2), 2, buf, 256);
  CheckS("dec_half"c, buf, "0.50"c);
  RatFormatDecimal(RatNew(1, 3), 5, buf, 256);
  CheckS("dec_third"c, buf, "0.33333"c);
  RatFormatDecimal(RatNew(2, 3), 5, buf, 256);
  CheckS("dec_twoThird"c, buf, "0.66667"c);
  RatFormatDecimal(RatNew(1, 3), 30, buf, 256);
  CheckS("dec_third30"c, buf, "0.333333333333333333333333333333"c);
  RatFormatDecimal(RatNew(0 - 7, 2), 3, buf, 256);
  CheckS("dec_neg"c, buf, "-3.500"c);
  RatFormatDecimal(RatNew(7, 2), 0, buf, 256);
  CheckS("dec_zeroDigits"c, buf, "4"c);
  RatFormatDecimal(RatNew(5, 2), 0, buf, 256);
  CheckS("dec_zeroDigitsHalf"c, buf, "3"c);
  RatFormatDecimal(RatNew(123, 1), 2, buf, 256);
  CheckS("dec_int"c, buf, "123.00"c);
  RatFormatDecimal(RatZero(), 3, buf, 256);
  CheckS("dec_zero"c, buf, "0.000"c);
  // Der Uebertrag muss durch alle Ziffern bis in den Ganzteil laufen
  RatFormatDecimal(RatNew(99, 100), 1, buf, 256);
  CheckS("dec_carryToInt"c, buf, "1.0"c);
  RatFormatDecimal(RatNew(999, 1000), 2, buf, 256);
  CheckS("dec_carry2"c, buf, "1.00"c);
  RatFormatDecimal(RatNew(1999, 1000), 2, buf, 256);
  CheckS("dec_carryInner"c, buf, "2.00"c);
  RatFormatDecimal(RatNew(9999, 10000), 3, buf, 256);
  CheckS("dec_carry3"c, buf, "1.000"c);
  RatFormatDecimal(nar, 3, buf, 256);
  CheckS("dec_nar"c, buf, "NaR"c);
  CheckI("dec_tooManyDigits"c, RatFormatDecimal(RatNew(1, 3), 61, buf, 256), 0 - 1);
  CheckI("dec_negDigits"c, RatFormatDecimal(RatNew(1, 3), 0 - 1, buf, 256), 0 - 1);
  CheckI("dec_tooSmall"c, RatFormatDecimal(RatNew(1, 3), 20, buf, 8), 0 - 1);

  // Grosser Nenner: die Langdivision laeuft ueber 128 Bit, sonst waere
  // rem*10 hier laengst uebergelaufen.
  RatFormatDecimal(RatNew(1, p62), 20, buf, 256);
  CheckS("dec_bigDen"c, buf, "0.00000000000000000022"c);

  // ── Einlesen ──────────────────────────────────────────────────────────────
  CheckR("parse_frac"c, RatParse("3/4"c as int64), 3, 4);
  CheckR("parse_reduce"c, RatParse("6/8"c as int64), 3, 4);
  CheckR("parse_int"c, RatParse("42"c as int64), 42, 1);
  CheckR("parse_neg"c, RatParse("-3/4"c as int64), 0 - 3, 4);
  CheckR("parse_plus"c, RatParse("+3/4"c as int64), 3, 4);
  CheckR("parse_spaces"c, RatParse("  7 / 8 "c as int64), 7, 8);
  CheckNaR("parse_negDen"c, RatParse("3/-4"c as int64));
  CheckR("parse_zero"c, RatParse("0/5"c as int64), 0, 1);
  CheckNaR("parse_empty"c, RatParse(""c as int64));
  CheckNaR("parse_denZero"c, RatParse("1/0"c as int64));
  CheckNaR("parse_noDen"c, RatParse("1/"c as int64));
  CheckNaR("parse_trailing"c, RatParse("3/4x"c as int64));
  CheckNaR("parse_junk"c, RatParse("abc"c as int64));
  CheckNaR("parse_null"c, RatParse(0));
  // Zu grosse Ziffernfolge wird abgelehnt, nicht stillschweigend gekappt
  CheckNaR("parse_tooBig"c, RatParse("99999999999999999999"c as int64));
  CheckR("parse_maxInt"c, RatParse("9223372036854775807"c as int64),
         9223372036854775807, 1);
  // Ausgabe und Einlesen sind zueinander invers
  RatFormat(RatNew(0 - 355, 113), buf, 256);
  CheckR("parse_roundTrip"c, RatParse(buf), 0 - 355, 113);

  // ── Strukturelle Invarianten ueber viele Werte ────────────────────────────
  //
  // Der Umfang ist bewusst begrenzt: solange #1580 offen ist, kostet JEDE
  // Rueckgabe eines Rat zwei mmap-Aufrufe und rund 32 Mikrosekunden. Mit den
  // urspruenglichen 25200 Durchlaeufen lief diese Datei 26 Sekunden und damit
  // hart an der 30-Sekunden-Grenze des Suite-Runners — ein Test, der auf einer
  // langsameren Maschine in die Zeitueberschreitung faellt, ist wertlos. Nach
  // dem Fix koennen die Schranken wieder hochgesetzt werden.
  //
  // Nicht einzelne Sollwerte, sondern Gesetze: was fuer alle Brueche gelten
  // muss, muss auch fuer diese gelten. Trifft ein Ueberlauf, ist NaR die
  // richtige Antwort und die Invariante wird uebersprungen — geprueft wird
  // dann aber, dass sie WIRKLICH ungueltig ist und nicht falsch.
  var na: int64 := 1;
  var invFails: int64 := 0;
  var tested: int64 := 0;
  while (na <= 8) {
    var da: int64 := 1;
    while (da <= 8) {
      var nb: int64 := 0 - 8;
      while (nb <= 8) {
        var db: int64 := 1;
        while (db <= 5) {
          var x: Rat := RatNew(na, da);
          var y: Rat := RatNew(nb, db);
          tested := tested + 1;
          // (x+y) - y = x
          var back: Rat := RatSub(RatAdd(x, y), y);
          if (RatIsValid(back) && !RatEquals(back, x)) { invFails := invFails + 1; }
          // x*y / y = x, sofern y nicht null
          if (!RatIsZero(y)) {
            var b2: Rat := RatDiv(RatMul(x, y), y);
            if (RatIsValid(b2) && !RatEquals(b2, x)) { invFails := invFails + 1; }
          }
          // Kanonische Form: Nenner positiv, teilerfremd
          var sm: Rat := RatAdd(x, y);
          if (RatIsValid(sm)) {
            if (RatDen(sm) <= 0) { invFails := invFails + 1; }
            if (GCD(RatNum(sm), RatDen(sm)) != 1 && RatNum(sm) != 0) {
              invFails := invFails + 1;
            }
            if (RatNum(sm) == 0 && RatDen(sm) != 1) { invFails := invFails + 1; }
          }
          // Vergleich und Subtraktion muessen sich einig sein
          var df: Rat := RatSub(x, y);
          if (RatIsValid(df)) {
            if (RatCmp(x, y) != RatSign(df)) { invFails := invFails + 1; }
          }
          // Floor <= Wert <= Ceil, und Ceil - Floor ist 0 oder 1
          var fl: int64 := RatFloor(x);
          var ce: int64 := RatCeil(x);
          if (ce - fl > 1 || ce < fl) { invFails := invFails + 1; }
          db := db + 1;
        }
        nb := nb + 1;
      }
      da := da + 1;
    }
    na := na + 1;
  }
  CheckI("invariants_tested"c, tested, 8 * 8 * 17 * 5);
  CheckI("invariants_fail"c, invFails, 0);

  // Kettenbruch-Rundreise ueber viele Brueche: jeder Bruch muss sich aus
  // seinen eigenen Koeffizienten wiederherstellen lassen.
  var cfFails: int64 := 0;
  var cn: int64 := 0 - 20;
  while (cn <= 20) {
    var cd: int64 := 1;
    while (cd <= 20) {
      var r0: Rat := RatNew(cn, cd);
      var kk: int64 := RatContinuedFrac(r0, cf, 64);
      var r1: Rat := RatFromContinuedFrac(cf, kk);
      if (!RatEquals(r0, r1)) { cfFails := cfFails + 1; }
      cd := cd + 1;
    }
    cn := cn + 1;
  }
  CheckI("cf_roundTripAll"c, cfFails, 0);

  // Beste Naeherung: das Ergebnis muss den Nenner einhalten und darf von
  // keinem Bruch mit kleinerem Nenner geschlagen werden. Der zweite Teil wird
  // durch stumpfes Absuchen aller Nenner geprueft — langsam, aber unabhaengig
  // vom Kettenbruchverfahren, das er kontrolliert.
  var apFails: int64 := 0;
  var vi: int64 := 1;
  while (vi <= 40) {
    var xv: f64 := (vi as f64) / 40.0 * 3.3 + 0.05;
    var lim: int64 := 20;
    var best: Rat := RatFromF64(xv, lim);
    if (RatDen(best) > lim) { apFails := apFails + 1; }
    var bestErr: f64 := AbsF64(xv - RatToF64(best));
    var qd: int64 := 1;
    while (qd <= lim) {
      // bester Zaehler zu diesem Nenner: gerundetes x*qd
      var pn: int64 := RoundF64(xv * (qd as f64)) as int64;
      var cand: Rat := RatNew(pn, qd);
      var ce2: f64 := AbsF64(xv - RatToF64(cand));
      if (ce2 < bestErr - 0.000000000001) { apFails := apFails + 1; }
      qd := qd + 1;
    }
    vi := vi + 1;
  }
  CheckI("approx_isBest"c, apFails, 0);

  free(cf, 64 * 8);
  free(buf, 256);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
