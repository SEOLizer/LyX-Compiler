// tests/edi01_contrl_test.lyx — EDI-01: CONTRL + APERAK + GENRAL tests

unit tests.edi01_contrl_test;

import std.edi.core;
import std.edi.messages;
import std.alloc;
import std.io;

// Find 3-byte tag in raw buffer, returns 1 if found
fn hasTag(buf: int64, bufLen: int64, t0: int64, t1: int64, t2: int64): int64 {
    var i: int64 := 0;
    while (i + 2 < bufLen) {
        if (peek8(buf+i) == t0 && peek8(buf+i+1) == t1 && peek8(buf+i+2) == t2) {
            return 1;
        }
        i := i + 1;
    }
    return 0;
}

// Count occurrences of a 3-byte tag
fn countTag(buf: int64, bufLen: int64, t0: int64, t1: int64, t2: int64): int64 {
    var i: int64 := 0;
    var cnt: int64 := 0;
    while (i + 2 < bufLen) {
        if (peek8(buf+i) == t0 && peek8(buf+i+1) == t1 && peek8(buf+i+2) == t2) {
            cnt := cnt + 1;
        }
        i := i + 1;
    }
    return cnt;
}

fn memEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
        if (peek8(a+i) != peek8(b+i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Test 1: EdiContrlOk — produces UNB + UNH + UCI(7) + UNT + UNZ
    // -------------------------------------------------------------------------
    var icr1: pchar := "ICROK001"c;
    var snd1: pchar := "SENDER01"c;
    var rcv1: pchar := "RECEIVER"c;
    var out1: int64 := alloc(512);
    var w1: int64 := EdiContrlOk(icr1 as int64, snd1 as int64, rcv1 as int64, out1, 512);
    if (w1 <= 0) { PrintLn("FAIL: EdiContrlOk returned <= 0"c); ok := 0; }
    else          { PrintLn("PASS: EdiContrlOk returned bytes"c); }
    // Must contain UNB, UNH, UCI, UNT, UNZ tags
    if (hasTag(out1, w1, 85, 78, 66) != 1) {
        PrintLn("FAIL: EdiContrlOk missing UNB"c); ok := 0;
    } else { PrintLn("PASS: EdiContrlOk has UNB"c); }
    if (hasTag(out1, w1, 85, 78, 72) != 1) {
        PrintLn("FAIL: EdiContrlOk missing UNH"c); ok := 0;
    } else { PrintLn("PASS: EdiContrlOk has UNH"c); }
    if (hasTag(out1, w1, 85, 67, 73) != 1) {   // UCI
        PrintLn("FAIL: EdiContrlOk missing UCI"c); ok := 0;
    } else { PrintLn("PASS: EdiContrlOk has UCI"c); }
    if (hasTag(out1, w1, 85, 78, 84) != 1) {   // UNT
        PrintLn("FAIL: EdiContrlOk missing UNT"c); ok := 0;
    } else { PrintLn("PASS: EdiContrlOk has UNT"c); }
    if (hasTag(out1, w1, 85, 78, 90) != 1) {   // UNZ
        PrintLn("FAIL: EdiContrlOk missing UNZ"c); ok := 0;
    } else { PrintLn("PASS: EdiContrlOk has UNZ"c); }

    // -------------------------------------------------------------------------
    // Test 2: EdiContrlErr — UCI must contain status '4' and error code
    // -------------------------------------------------------------------------
    var icr2: pchar := "ICRERR01"c;
    var out2: int64 := alloc(512);
    var w2: int64 := EdiContrlErr(icr2, 5, 14, out2, 512);
    if (w2 <= 0) { PrintLn("FAIL: EdiContrlErr returned <= 0"c); ok := 0; }
    else          { PrintLn("PASS: EdiContrlErr returned bytes"c); }
    if (hasTag(out2, w2, 85, 67, 73) != 1) {
        PrintLn("FAIL: EdiContrlErr missing UCI"c); ok := 0;
    } else { PrintLn("PASS: EdiContrlErr has UCI"c); }
    // Status '4' (52) must appear somewhere after UCI
    var foundStatus4: int64 := 0;
    var i2: int64 := 0;
    while (i2 + 5 < w2 && foundStatus4 == 0) {
        if (peek8(out2+i2) == 85 && peek8(out2+i2+1) == 67 && peek8(out2+i2+2) == 73) {
            // found UCI — scan forward for '4'
            var j2: int64 := i2 + 3;
            while (j2 < w2 && foundStatus4 == 0) {
                if (peek8(out2+j2) == 52) { foundStatus4 := 1; }   // '4'
                if (peek8(out2+j2) == 39) { j2 := w2; }            // segment terminator
                j2 := j2 + 1;
            }
        }
        i2 := i2 + 1;
    }
    if (foundStatus4 != 1) {
        PrintLn("FAIL: EdiContrlErr UCI does not contain status '4'"c); ok := 0;
    } else { PrintLn("PASS: EdiContrlErr UCI status = '4'"c); }

    // -------------------------------------------------------------------------
    // Test 3: EdiContrlRead — parse positive CONTRL → status=7
    // -------------------------------------------------------------------------
    var res3: int64 := alloc(EDI_CONTRL_SIZE);
    var r3: int64 := EdiContrlRead(out1, w1, res3);
    if (r3 != EDI_OK) {
        PrintLn("FAIL: EdiContrlRead positive should return EDI_OK"c); ok := 0;
    } else { PrintLn("PASS: EdiContrlRead positive returns EDI_OK"c); }
    var status3: int64 := peek64(res3 + EDI_CONTRL_STATUS);
    if (status3 != 7) {
        PrintLn("FAIL: positive CONTRL status should be 7"c); ok := 0;
    } else { PrintLn("PASS: positive CONTRL status = 7 (accepted)"c); }
    free(res3, EDI_CONTRL_SIZE);

    // -------------------------------------------------------------------------
    // Test 4: EdiContrlRead — parse negative CONTRL → status=4, errCode=14
    // -------------------------------------------------------------------------
    var res4: int64 := alloc(EDI_CONTRL_SIZE);
    var r4: int64 := EdiContrlRead(out2, w2, res4);
    if (r4 != EDI_OK) {
        PrintLn("FAIL: EdiContrlRead negative should return EDI_OK"c); ok := 0;
    } else { PrintLn("PASS: EdiContrlRead negative returns EDI_OK"c); }
    var status4: int64 := peek64(res4 + EDI_CONTRL_STATUS);
    if (status4 != 4) {
        PrintLn("FAIL: negative CONTRL status should be 4"c); ok := 0;
    } else { PrintLn("PASS: negative CONTRL status = 4 (rejected)"c); }
    var err4: int64 := peek64(res4 + EDI_CONTRL_ERRCODE);
    if (err4 != 14) {
        PrintLn("FAIL: negative CONTRL errCode should be 14"c); ok := 0;
    } else { PrintLn("PASS: negative CONTRL errCode = 14"c); }
    var seg4: int64 := peek64(res4 + EDI_CONTRL_SEGPOS);
    if (seg4 != 5) {
        PrintLn("FAIL: negative CONTRL segPos should be 5"c); ok := 0;
    } else { PrintLn("PASS: negative CONTRL segPos = 5"c); }
    free(res4, EDI_CONTRL_SIZE);

    free(out1, 512);
    free(out2, 512);

    // -------------------------------------------------------------------------
    // Test 5: EdiAperakWrite — BGM + RFF + ERC + FTX structure
    // -------------------------------------------------------------------------
    var refMsg5: pchar := "MSG001"c;
    var errTxt5: pchar := "Mandatory field missing in segment XYZ"c;
    var out5: int64 := alloc(512);
    var w5: int64 := EdiAperakWrite(refMsg5 as int64, 42, errTxt5 as int64, out5, 512);
    if (w5 <= 0) { PrintLn("FAIL: EdiAperakWrite returned <= 0"c); ok := 0; }
    else          { PrintLn("PASS: EdiAperakWrite returned bytes"c); }
    if (hasTag(out5, w5, 66, 71, 77) != 1) {   // BGM
        PrintLn("FAIL: EdiAperakWrite missing BGM"c); ok := 0;
    } else { PrintLn("PASS: EdiAperakWrite has BGM"c); }
    if (hasTag(out5, w5, 82, 70, 70) != 1) {   // RFF
        PrintLn("FAIL: EdiAperakWrite missing RFF"c); ok := 0;
    } else { PrintLn("PASS: EdiAperakWrite has RFF"c); }
    if (hasTag(out5, w5, 69, 82, 67) != 1) {   // ERC
        PrintLn("FAIL: EdiAperakWrite missing ERC"c); ok := 0;
    } else { PrintLn("PASS: EdiAperakWrite has ERC"c); }
    if (hasTag(out5, w5, 70, 84, 88) != 1) {   // FTX
        PrintLn("FAIL: EdiAperakWrite missing FTX"c); ok := 0;
    } else { PrintLn("PASS: EdiAperakWrite has FTX"c); }

    // -------------------------------------------------------------------------
    // Test 6: EdiAperakRead — errCode and text recovered from EdiAperakWrite output
    // -------------------------------------------------------------------------
    var res6: int64 := alloc(EDI_APERAK_SIZE);
    EdiAperakRead(out5, w5, res6);
    var ec6: int64 := peek64(res6 + EDI_APERAK_ERRCODE);
    if (ec6 != 42) {
        PrintLn("FAIL: EdiAperakRead errCode should be 42"c); ok := 0;
    } else { PrintLn("PASS: EdiAperakRead errCode = 42"c); }
    var tl6: int64 := peek64(res6 + EDI_APERAK_TEXTLEN);
    if (tl6 <= 0) {
        PrintLn("FAIL: EdiAperakRead textLen should be > 0"c); ok := 0;
    } else { PrintLn("PASS: EdiAperakRead textLen > 0"c); }
    free(res6, EDI_APERAK_SIZE);
    free(out5, 512);

    // -------------------------------------------------------------------------
    // Test 7: EdiGenralWrite — text > 512 chars splits into 2 FTX segments
    // -------------------------------------------------------------------------
    // Build a 520-byte body
    var body7: int64 := alloc(528);
    var bi7: int64 := 0;
    while (bi7 < 520) {
        poke8(body7 + bi7, 65 + (bi7 - (bi7 / 26) * 26));   // cycling A-Z
        bi7 := bi7 + 1;
    }
    poke8(body7 + 520, 0);   // null terminate

    var subj7: pchar := "LONGTEXT"c;
    var out7: int64 := alloc(2048);
    var w7: int64 := EdiGenralWrite(subj7 as int64, body7, 0, out7, 2048);
    if (w7 <= 0) { PrintLn("FAIL: EdiGenralWrite returned <= 0"c); ok := 0; }
    else          { PrintLn("PASS: EdiGenralWrite (520-char body) returned bytes"c); }
    var ftxCount7: int64 := countTag(out7, w7, 70, 84, 88);   // "FTX"
    if (ftxCount7 < 2) {
        PrintLn("FAIL: 520-char body should produce >= 2 FTX segments"c); ok := 0;
    } else { PrintLn("PASS: 520-char body → >= 2 FTX segments"c); }

    // -------------------------------------------------------------------------
    // Test 8: EdiGenralWrite + EdiGenralRead round-trip (short body)
    // -------------------------------------------------------------------------
    var subj8: pchar := "TESTSUBJECT"c;
    var body8: pchar := "Hello World from GENRAL"c;
    var out8: int64 := alloc(512);
    var w8: int64 := EdiGenralWrite(subj8 as int64, body8 as int64, 0, out8, 512);
    var res8: int64 := alloc(EDI_GENRAL_SIZE);
    EdiGenralRead(out8, w8, res8);

    var bl8: int64 := peek64(res8 + EDI_GENRAL_BODYLEN);
    if (bl8 != 23) {
        PrintLn("FAIL: GENRAL round-trip bodyLen should be 23"c); ok := 0;
    } else { PrintLn("PASS: GENRAL round-trip bodyLen = 23"c); }

    var bp8: int64 := peek64(res8 + EDI_GENRAL_BODY);
    if (memEq(bp8, 23, body8 as int64, 23) != 1) {
        PrintLn("FAIL: GENRAL round-trip body bytes differ"c); ok := 0;
    } else { PrintLn("PASS: GENRAL round-trip body matches"c); }

    // Free the alloc'd body from EdiGenralRead
    free(bp8, 16384);
    free(res8, EDI_GENRAL_SIZE);
    free(out8, 512);

    // -------------------------------------------------------------------------
    // Test 9: EdiGenralRead — 520-char body recovered completely
    // -------------------------------------------------------------------------
    var res9: int64 := alloc(EDI_GENRAL_SIZE);
    EdiGenralRead(out7, w7, res9);
    var bl9: int64 := peek64(res9 + EDI_GENRAL_BODYLEN);
    if (bl9 != 520) {
        PrintLn("FAIL: GENRAL 520-char round-trip bodyLen != 520"c); ok := 0;
    } else { PrintLn("PASS: GENRAL 520-char round-trip bodyLen = 520"c); }
    var bp9: int64 := peek64(res9 + EDI_GENRAL_BODY);
    if (memEq(bp9, 520, body7, 520) != 1) {
        PrintLn("FAIL: GENRAL 520-char round-trip body bytes differ"c); ok := 0;
    } else { PrintLn("PASS: GENRAL 520-char round-trip body matches"c); }
    free(bp9, 16384);
    free(res9, EDI_GENRAL_SIZE);

    free(out7, 2048);
    free(body7, 528);

    if (ok != 0) { PrintLn("=== EDI-01: ALL PASS ==="c); }
    else          { PrintLn("=== EDI-01: SOME FAIL ==="c); }
    return ok;
}
