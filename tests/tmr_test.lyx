// tests/tmr_test.lyx
// WP-3.1: Triple Modular Redundancy (TMR)
//
// Tests: triple storage init, read, multiple reassignments, multiple @redundant vars.
// Note: direct copy-corruption test requires addrof builtin (future WP).

@description("WP-3.1: TMR triple modular redundancy tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.tmr_test;

// --- 1. @redundant var initialises with correct value ---
fn testInit(): int64 {
  @redundant var x: int64 := 42;
  if (x != 42) { PrintStr("FAIL: init value\n"); return 1; }
  PrintStr("OK: init value\n");
  return 0;
}

// --- 2. Reassignment updates the value ---
fn testReassign(): int64 {
  @redundant var v: int64 := 0;
  v := 1234;
  if (v != 1234) { PrintStr("FAIL: after first assign\n"); return 1; }
  v := 9999;
  if (v != 9999) { PrintStr("FAIL: after second assign\n"); return 1; }
  PrintStr("OK: reassign\n");
  return 0;
}

// --- 3. Multiple @redundant vars coexist without aliasing ---
fn testMultiple(): int64 {
  @redundant var a: int64 := 1;
  @redundant var b: int64 := 2;
  @redundant var c: int64 := 3;
  if (a != 1) { PrintStr("FAIL: multi a init\n"); return 1; }
  if (b != 2) { PrintStr("FAIL: multi b init\n"); return 1; }
  if (c != 3) { PrintStr("FAIL: multi c init\n"); return 1; }
  a := 10;
  if (a != 10) { PrintStr("FAIL: multi a reassign\n"); return 1; }
  if (b != 2)  { PrintStr("FAIL: multi b unchanged\n"); return 1; }
  if (c != 3)  { PrintStr("FAIL: multi c unchanged\n"); return 1; }
  b := 20; c := 30;
  if (a != 10) { PrintStr("FAIL: multi a after b/c change\n"); return 1; }
  if (b != 20) { PrintStr("FAIL: multi b after reassign\n"); return 1; }
  if (c != 30) { PrintStr("FAIL: multi c after reassign\n"); return 1; }
  PrintStr("OK: multiple redundant vars\n");
  return 0;
}

// --- 4. @redundant var mixed with regular vars ---
fn testMixed(): int64 {
  var before: int64 := 111;
  @redundant var s: int64 := 555;
  var after: int64 := 222;
  if (before != 111) { PrintStr("FAIL: before unchanged\n"); return 1; }
  if (s != 555)      { PrintStr("FAIL: redundant value\n"); return 1; }
  if (after != 222)  { PrintStr("FAIL: after unchanged\n"); return 1; }
  s := 777;
  if (before != 111) { PrintStr("FAIL: before after s-assign\n"); return 1; }
  if (s != 777)      { PrintStr("FAIL: redundant after assign\n"); return 1; }
  if (after != 222)  { PrintStr("FAIL: after after s-assign\n"); return 1; }
  PrintStr("OK: mixed vars\n");
  return 0;
}

// --- 5. Majority-vote self-healing: simulate via mmap'd triple ---
// We test the TMR algorithm correctness by directly calling the vote logic
// on heap-allocated copies (mirrors the stack TMR behaviour).
fn tmrVote(a: int64, b: int64, c: int64): int64 {
  // Majority vote: B==C wins if A corrupt; otherwise A is returned.
  if (b == c) {
    if (a == b) { return a; }  // all equal
    return b;                  // B==C: B is majority
  }
  return a;  // B!=C: A wins (A==B, A==C, or triple mismatch)
}

fn testVoteAlgorithm(): int64 {
  // All equal → any value
  if (tmrVote(5, 5, 5) != 5) { PrintStr("FAIL: vote all equal\n"); return 1; }
  // A corrupted, B==C → B wins
  if (tmrVote(0xDEAD, 5, 5) != 5) { PrintStr("FAIL: vote A corrupt\n"); return 1; }
  // B corrupted, A==C → A wins (B!=C)
  if (tmrVote(5, 0xDEAD, 5) != 5) { PrintStr("FAIL: vote B corrupt\n"); return 1; }
  // C corrupted, A==B → A wins (B!=C)
  if (tmrVote(5, 5, 0xDEAD) != 5) { PrintStr("FAIL: vote C corrupt\n"); return 1; }
  // Triple mismatch → A (first copy)
  if (tmrVote(1, 2, 3) != 1)       { PrintStr("FAIL: vote triple mismatch\n"); return 1; }
  PrintStr("OK: vote algorithm\n");
  return 0;
}

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testInit();
  failed := failed + testReassign();
  failed := failed + testMultiple();
  failed := failed + testMixed();
  failed := failed + testVoteAlgorithm();
  if (failed != 0) {
    PrintStr("FAILED\n");
    return 1;
  }
  PrintStr("ALL PASSED\n");
  return 0;
}
