// tests/tmr_test.lyx
// WP-3.1: Triple Modular Redundancy (TMR)
//
// Tests: triple storage init, read, multiple reassignments, multiple @redundant vars.
// Note: direct copy-corruption test requires addrof builtin (future WP).

@description("WP-3.1: TMR triple modular redundancy tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.tmr_test;

// --- 1. @redundant var initialises with correct value ---
fn testInit(): int64 {
  @redundant var x: int64 := 42;
  if (x != 42) { PrintLn("FAIL: init value"); return 1; }
  PrintLn("OK: init value");
  return 0;
}

// --- 2. Reassignment updates the value ---
fn testReassign(): int64 {
  @redundant var v: int64 := 0;
  v := 1234;
  if (v != 1234) { PrintLn("FAIL: after first assign"); return 1; }
  v := 9999;
  if (v != 9999) { PrintLn("FAIL: after second assign"); return 1; }
  PrintLn("OK: reassign");
  return 0;
}

// --- 3. Multiple @redundant vars coexist without aliasing ---
fn testMultiple(): int64 {
  @redundant var a: int64 := 1;
  @redundant var b: int64 := 2;
  @redundant var c: int64 := 3;
  if (a != 1) { PrintLn("FAIL: multi a init"); return 1; }
  if (b != 2) { PrintLn("FAIL: multi b init"); return 1; }
  if (c != 3) { PrintLn("FAIL: multi c init"); return 1; }
  a := 10;
  if (a != 10) { PrintLn("FAIL: multi a reassign"); return 1; }
  if (b != 2)  { PrintLn("FAIL: multi b unchanged"); return 1; }
  if (c != 3)  { PrintLn("FAIL: multi c unchanged"); return 1; }
  b := 20; c := 30;
  if (a != 10) { PrintLn("FAIL: multi a after b/c change"); return 1; }
  if (b != 20) { PrintLn("FAIL: multi b after reassign"); return 1; }
  if (c != 30) { PrintLn("FAIL: multi c after reassign"); return 1; }
  PrintLn("OK: multiple redundant vars");
  return 0;
}

// --- 4. @redundant var mixed with regular vars ---
fn testMixed(): int64 {
  var before: int64 := 111;
  @redundant var s: int64 := 555;
  var after: int64 := 222;
  if (before != 111) { PrintLn("FAIL: before unchanged"); return 1; }
  if (s != 555)      { PrintLn("FAIL: redundant value"); return 1; }
  if (after != 222)  { PrintLn("FAIL: after unchanged"); return 1; }
  s := 777;
  if (before != 111) { PrintLn("FAIL: before after s-assign"); return 1; }
  if (s != 777)      { PrintLn("FAIL: redundant after assign"); return 1; }
  if (after != 222)  { PrintLn("FAIL: after after s-assign"); return 1; }
  PrintLn("OK: mixed vars");
  return 0;
}

// --- 5. Majority-vote self-healing: simulate via mmap'd triple ---
// We test the TMR algorithm correctness by directly calling the vote logic
// on heap-allocated copies (mirrors the stack TMR behaviour).
fn tmrVote(a: int64, b: int64, c: int64): int64 {
  // Majority vote: B==C wins if A corrupt; otherwise A is returned.
  if (b == c) {
    if (a == b) { return a; }  // all equal
    return b;                  // B==C: B is majority
  }
  return a;  // B!=C: A wins (A==B, A==C, or triple mismatch)
}

fn testVoteAlgorithm(): int64 {
  // All equal → any value
  if (tmrVote(5, 5, 5) != 5) { PrintLn("FAIL: vote all equal"); return 1; }
  // A corrupted, B==C → B wins
  if (tmrVote(0xDEAD, 5, 5) != 5) { PrintLn("FAIL: vote A corrupt"); return 1; }
  // B corrupted, A==C → A wins (B!=C)
  if (tmrVote(5, 0xDEAD, 5) != 5) { PrintLn("FAIL: vote B corrupt"); return 1; }
  // C corrupted, A==B → A wins (B!=C)
  if (tmrVote(5, 5, 0xDEAD) != 5) { PrintLn("FAIL: vote C corrupt"); return 1; }
  // Triple mismatch → A (first copy)
  if (tmrVote(1, 2, 3) != 1)       { PrintLn("FAIL: vote triple mismatch"); return 1; }
  PrintLn("OK: vote algorithm");
  return 0;
}

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testInit();
  failed := failed + testReassign();
  failed := failed + testMultiple();
  failed := failed + testMixed();
  failed := failed + testVoteAlgorithm();
  if (failed != 0) {
    PrintLn("FAILED");
    return 1;
  }
  PrintLn("ALL PASSED");
  return 0;
}
