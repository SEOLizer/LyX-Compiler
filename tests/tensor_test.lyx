// tests/tensor_test.lyx
// Selbstpruefende Testbatterie fuer std.tensor.
//
// Sollwerte aus numpy (tensordot, transpose, trace) und aus einer
// numpy-Nachbildung der Gatteranwendung. Dazu Pruefungen, die ohne fremde
// Zahlen gelten muessen: die Norm bleibt unter jedem Gatter erhalten (Gatter
// sind unitaer), die Spur einer Dichtematrix ist 1, und die Entropie eines
// unverschraenkten Zustands ist 0.

unit main;

import std.tensor;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn TOL(): f64 { return 0.000000001; }

fn V(p: int64, i: int64): f64 {
  var v: f64 := peekf64(p + i * 8);
  return v;
}

fn Check(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > tol) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" (bool)\n"c);
  }
}

fn main(): int64 {
  // ── Form, Schrittweiten, Indizes ──────────────────────────────────────────
  var shape: int64 := alloc(3 * 8);
  poke64(shape, 2);  poke64(shape + 8, 3);  poke64(shape + 16, 4);
  CheckI("size"c, TenSize(shape, 3), 24);

  var str: int64 := alloc(3 * 8);
  CheckB("stridesOk"c, TenStrides(shape, 3, str), true);
  CheckI("stride0"c, peek64(str), 12);
  CheckI("stride1"c, peek64(str + 8), 4);
  CheckI("stride2"c, peek64(str + 16), 1);

  var idx: int64 := alloc(3 * 8);
  poke64(idx, 1);  poke64(idx + 8, 2);  poke64(idx + 16, 3);
  CheckI("flatIndex"c, TenFlatIndex(str, idx, 3), 23);

  TenUnflatten(23, shape, 3, idx);
  CheckI("unflat0"c, peek64(idx), 1);
  CheckI("unflat1"c, peek64(idx + 8), 2);
  CheckI("unflat2"c, peek64(idx + 16), 3);

  // ── Komplexe Grundoperationen ─────────────────────────────────────────────
  var n: int64 := 4;
  var are: int64 := alloc(n * 8);  var aim: int64 := alloc(n * 8);
  var bre: int64 := alloc(n * 8);  var bim: int64 := alloc(n * 8);
  var ore: int64 := alloc(n * 8);  var oim: int64 := alloc(n * 8);

  var i: int64 := 0;
  while (i < n) {
    pokef64(are + i * 8, (i + 1) as f64);
    pokef64(aim + i * 8, (i) as f64);
    pokef64(bre + i * 8, 2.0);
    pokef64(bim + i * 8, 1.0);
    i := i + 1;
  }

  TenAdd(are, aim, bre, bim, ore, oim, n);
  Check("addRe"c, V(ore, 0), 3.0, TOL());
  Check("addIm"c, V(oim, 1), 2.0, TOL());
  TenSub(are, aim, bre, bim, ore, oim, n);
  Check("subRe"c, V(ore, 0), -1.0, TOL());

  // (1+0i) * (2+1i) = 2+1i ; (2+1i)*(2+1i) = 3+4i
  TenCopy(are, aim, ore, oim, n);
  TenScale(ore, oim, n, 2.0, 1.0);
  Check("scaleRe0"c, V(ore, 0), 2.0, TOL());
  Check("scaleIm0"c, V(oim, 0), 1.0, TOL());
  Check("scaleRe1"c, V(ore, 1), 3.0, TOL());
  Check("scaleIm1"c, V(oim, 1), 4.0, TOL());

  TenCopy(are, aim, ore, oim, n);
  TenConj(ore, oim, n);
  Check("conj"c, V(oim, 1), -1.0, TOL());

  // |a|^2 = sum (re^2 + im^2) = (1+4+9+16) + (0+1+4+9) = 30 + 14 = 44
  Check("normSq"c, TenNormSq(are, aim, n), 44.0, TOL());
  Check("norm"c, TenNorm(are, aim, n), SqrtF64(44.0), TOL());

  // <a|a> muss reell und gleich |a|^2 sein
  var ir: int64 := alloc(8);
  var ii: int64 := alloc(8);
  TenInner(are, aim, are, aim, n, ir, ii);
  var innerRe: f64 := V(ir, 0);
  var innerIm: f64 := V(ii, 0);
  Check("innerSelfRe"c, innerRe, 44.0, TOL());
  Check("innerSelfIm"c, innerIm, 0.0, TOL());

  free(are, n * 8);  free(aim, n * 8);
  free(bre, n * 8);  free(bim, n * 8);
  free(ore, n * 8);  free(oim, n * 8);

  // ── Kontraktion: komplexes Matrixprodukt ──────────────────────────────────
  // A = (1..6) + i*(0..5), 2x3 ; B = 2*(1..6) - i*(0..5), 3x2
  var ar2: int64 := alloc(6 * 8);  var ai2: int64 := alloc(6 * 8);
  var br2: int64 := alloc(6 * 8);  var bi2: int64 := alloc(6 * 8);
  i := 0;
  while (i < 6) {
    pokef64(ar2 + i * 8, (i + 1) as f64);
    pokef64(ai2 + i * 8, i as f64);
    pokef64(br2 + i * 8, ((i + 1) * 2) as f64);
    pokef64(bi2 + i * 8, 0.0 - (i as f64));
    i := i + 1;
  }
  var sa: int64 := alloc(2 * 8);  poke64(sa, 2);  poke64(sa + 8, 3);
  var sb: int64 := alloc(2 * 8);  poke64(sb, 3);  poke64(sb + 8, 2);
  var axA: int64 := alloc(2 * 8);  poke64(axA, 1);
  var axB: int64 := alloc(2 * 8);  poke64(axB, 0);
  var cr: int64 := alloc(16 * 8);  var ci: int64 := alloc(16 * 8);
  var cs: int64 := alloc(4 * 8);

  CheckI("contractRank"c, TenContractRank(2, 2, 1), 2);
  CheckB("contractOk"c, TenContract(ar2, ai2, sa, 2, br2, bi2, sb, 2,
                                    axA, axB, 1, cr, ci, cs), true);
  CheckI("cShape0"c, peek64(cs), 2);
  CheckI("cShape1"c, peek64(cs + 8), 2);
  // numpy: [54+10j, 69+10j, 126+46j, 168+55j]
  Check("c00re"c, V(cr, 0), 54.0, TOL());
  Check("c00im"c, V(ci, 0), 10.0, TOL());
  Check("c01re"c, V(cr, 1), 69.0, TOL());
  Check("c10re"c, V(cr, 2), 126.0, TOL());
  Check("c10im"c, V(ci, 2), 46.0, TOL());
  Check("c11re"c, V(cr, 3), 168.0, TOL());
  Check("c11im"c, V(ci, 3), 55.0, TOL());

  // nicht passende Dimensionen werden abgewiesen
  poke64(axB, 1);
  CheckB("contractMismatch"c, TenContract(ar2, ai2, sa, 2, br2, bi2, sb, 2,
                                          axA, axB, 1, cr, ci, cs), false);
  poke64(axB, 0);
  poke64(axA, 5);
  CheckB("contractBadAxis"c, TenContract(ar2, ai2, sa, 2, br2, bi2, sb, 2,
                                         axA, axB, 1, cr, ci, cs), false);
  poke64(axA, 1);

  // ── Kontraktion ueber zwei Achsen ─────────────────────────────────────────
  // X (2,3,4) mit Y (3,4,2) ueber Achsen (1,2) gegen (0,1)
  var xr: int64 := alloc(24 * 8);  var xi: int64 := alloc(24 * 8);
  var yr: int64 := alloc(24 * 8);  var yi: int64 := alloc(24 * 8);
  i := 0;
  while (i < 24) {
    pokef64(xr + i * 8, i as f64);   pokef64(xi + i * 8, 0.0);
    pokef64(yr + i * 8, i as f64);   pokef64(yi + i * 8, 0.0);
    i := i + 1;
  }
  var sx: int64 := alloc(3 * 8);  poke64(sx, 2);  poke64(sx + 8, 3);  poke64(sx + 16, 4);
  var sy: int64 := alloc(3 * 8);  poke64(sy, 3);  poke64(sy + 8, 4);  poke64(sy + 16, 2);
  var a2: int64 := alloc(2 * 8);  poke64(a2, 1);  poke64(a2 + 8, 2);
  var b2: int64 := alloc(2 * 8);  poke64(b2, 0);  poke64(b2 + 8, 1);

  CheckB("contract2Ok"c, TenContract(xr, xi, sx, 3, yr, yi, sy, 3,
                                     a2, b2, 2, cr, ci, cs), true);
  CheckI("c2Shape0"c, peek64(cs), 2);
  CheckI("c2Shape1"c, peek64(cs + 8), 2);
  // numpy tensordot: [1012, 1078, 2596, 2806]
  Check("c2_0"c, V(cr, 0), 1012.0, TOL());
  Check("c2_1"c, V(cr, 1), 1078.0, TOL());
  Check("c2_2"c, V(cr, 2), 2596.0, TOL());
  Check("c2_3"c, V(cr, 3), 2806.0, TOL());

  // ── Tensorprodukt (keine kontrahierte Achse) ──────────────────────────────
  var v1r: int64 := alloc(2 * 8);  var v1i: int64 := alloc(2 * 8);
  var v2r: int64 := alloc(2 * 8);  var v2i: int64 := alloc(2 * 8);
  pokef64(v1r, 1.0);  pokef64(v1r + 8, 2.0);  pokef64(v1i, 0.0);  pokef64(v1i + 8, 0.0);
  pokef64(v2r, 3.0);  pokef64(v2r + 8, 4.0);  pokef64(v2i, 0.0);  pokef64(v2i + 8, 0.0);
  var s1: int64 := alloc(8);  poke64(s1, 2);
  var s2: int64 := alloc(8);  poke64(s2, 2);
  CheckB("outerOk"c, TenOuter(v1r, v1i, s1, 1, v2r, v2i, s2, 1, cr, ci, cs), true);
  CheckI("outerShape0"c, peek64(cs), 2);
  CheckI("outerShape1"c, peek64(cs + 8), 2);
  Check("outer00"c, V(cr, 0), 3.0, TOL());
  Check("outer01"c, V(cr, 1), 4.0, TOL());
  Check("outer10"c, V(cr, 2), 6.0, TOL());
  Check("outer11"c, V(cr, 3), 8.0, TOL());

  // ── Achsen vertauschen ────────────────────────────────────────────────────
  var pr: int64 := alloc(24 * 8);  var pi2: int64 := alloc(24 * 8);
  var ps: int64 := alloc(3 * 8);
  var perm: int64 := alloc(3 * 8);
  poke64(perm, 2);  poke64(perm + 8, 0);  poke64(perm + 16, 1);
  CheckB("permOk"c, TenPermute(xr, xi, sx, 3, perm, pr, pi2, ps), true);
  CheckI("permShape0"c, peek64(ps), 4);
  CheckI("permShape1"c, peek64(ps + 8), 2);
  CheckI("permShape2"c, peek64(ps + 16), 3);
  // numpy transpose(2,0,1): flach beginnt mit 0, 4, 8, 12
  Check("perm0"c, V(pr, 0), 0.0, TOL());
  Check("perm1"c, V(pr, 1), 4.0, TOL());
  Check("perm2"c, V(pr, 2), 8.0, TOL());
  Check("perm3"c, V(pr, 3), 12.0, TOL());

  // doppelte Achse in der Permutation ist unzulaessig
  poke64(perm + 8, 2);
  CheckB("permDup"c, TenPermute(xr, xi, sx, 3, perm, pr, pi2, ps), false);
  poke64(perm + 8, 0);
  CheckB("permAlias"c, TenPermute(xr, xi, sx, 3, perm, xr, xi, ps), false);

  // ── Spur und partielle Spur ───────────────────────────────────────────────
  // 3x3-Matrix 0..8: Spur = 0 + 4 + 8 = 12
  var mr: int64 := alloc(9 * 8);  var mi: int64 := alloc(9 * 8);
  i := 0;
  while (i < 9) {
    pokef64(mr + i * 8, i as f64);
    pokef64(mi + i * 8, 0.0);
    i := i + 1;
  }
  var ms: int64 := alloc(2 * 8);  poke64(ms, 3);  poke64(ms + 8, 3);
  var trS: int64 := alloc(2 * 8);
  CheckB("traceOk"c, TenPartialTrace(mr, mi, ms, 2, 0, 1, cr, ci, trS), true);
  Check("trace"c, V(cr, 0), 12.0, TOL());

  // 2x2x2x2 (0..15), Spur ueber Achsen 1 und 3
  var t4r: int64 := alloc(16 * 8);  var t4i: int64 := alloc(16 * 8);
  i := 0;
  while (i < 16) {
    pokef64(t4r + i * 8, i as f64);
    pokef64(t4i + i * 8, 0.0);
    i := i + 1;
  }
  var s4: int64 := alloc(4 * 8);
  poke64(s4, 2);  poke64(s4 + 8, 2);  poke64(s4 + 16, 2);  poke64(s4 + 24, 2);
  CheckB("ptOk"c, TenPartialTrace(t4r, t4i, s4, 4, 1, 3, cr, ci, trS), true);
  // numpy trace(axis1=1, axis2=3): [5, 9, 21, 25]
  Check("pt0"c, V(cr, 0), 5.0, TOL());
  Check("pt1"c, V(cr, 1), 9.0, TOL());
  Check("pt2"c, V(cr, 2), 21.0, TOL());
  Check("pt3"c, V(cr, 3), 25.0, TOL());
  CheckB("ptSameAxis"c, TenPartialTrace(t4r, t4i, s4, 4, 1, 1, cr, ci, trS), false);

  free(xr, 24 * 8);  free(xi, 24 * 8);  free(yr, 24 * 8);  free(yi, 24 * 8);
  free(pr, 24 * 8);  free(pi2, 24 * 8);
  free(t4r, 16 * 8); free(t4i, 16 * 8);
  free(mr, 9 * 8);   free(mi, 9 * 8);

  // ── Quantenzustaende: Gatter ──────────────────────────────────────────────
  CheckI("stateSize1"c, QuStateSize(1), 2);
  CheckI("stateSize3"c, QuStateSize(3), 8);
  CheckI("stateSizeBad"c, QuStateSize(0), 0);
  CheckI("stateSizeHuge"c, QuStateSize(40), 0);

  var sr: int64 := alloc(8 * 8);  var si: int64 := alloc(8 * 8);
  var gr: int64 := alloc(16 * 8); var gi: int64 := alloc(16 * 8);

  // X auf |0> gibt |1>
  CheckB("zeroOk"c, QuStateZero(sr, si, 1), true);
  Check("zeroAmp"c, V(sr, 0), 1.0, TOL());
  QuGateX(gr, gi);
  CheckB("applyOk"c, QuApply1(sr, si, 1, 0, gr, gi), true);
  Check("xProb0"c, QuProbability(sr, si, 1, 0), 0.0, TOL());
  Check("xProb1"c, QuProbability(sr, si, 1, 1), 1.0, TOL());

  // Y auf |0> gibt i|1> — rein imaginaer, der Fall, an dem sich echtes
  // komplexes Rechnen zeigt
  QuStateZero(sr, si, 1);
  QuGateY(gr, gi);
  QuApply1(sr, si, 1, 0, gr, gi);
  Check("yRe"c, V(sr, 1), 0.0, TOL());
  Check("yIm"c, V(si, 1), 1.0, TOL());
  Check("yProb"c, QuProbability(sr, si, 1, 1), 1.0, TOL());

  // H auf |0>: gleichgewichtige Ueberlagerung
  QuStateZero(sr, si, 1);
  QuGateH(gr, gi);
  QuApply1(sr, si, 1, 0, gr, gi);
  Check("hProb0"c, QuProbability(sr, si, 1, 0), 0.5, TOL());
  Check("hProb1"c, QuProbability(sr, si, 1, 1), 0.5, TOL());
  // zweimal H ist die Identitaet — die Probe auf Interferenz
  QuApply1(sr, si, 1, 0, gr, gi);
  Check("hhProb0"c, QuProbability(sr, si, 1, 0), 1.0, TOL());
  Check("hhProb1"c, QuProbability(sr, si, 1, 1), 0.0, TOL());

  // Z aendert nur die Phase, nicht die Wahrscheinlichkeit
  QuStateZero(sr, si, 1);
  QuGateH(gr, gi);
  QuApply1(sr, si, 1, 0, gr, gi);
  QuGateZ(gr, gi);
  QuApply1(sr, si, 1, 0, gr, gi);
  Check("zProb0"c, QuProbability(sr, si, 1, 0), 0.5, TOL());
  Check("zSign"c, V(sr, 1), 0.0 - 0.7071067811865475, 0.0000001);

  // T auf |1>: Phase e^{i pi/4}
  QuStateBasis(sr, si, 1, 1);
  QuGateT(gr, gi);
  QuApply1(sr, si, 1, 0, gr, gi);
  Check("tRe"c, V(sr, 1), 0.7071067811865476, 0.0000001);
  Check("tIm"c, V(si, 1), 0.7071067811865476, 0.0000001);

  // S zweimal ist Z
  QuStateBasis(sr, si, 1, 1);
  QuGateS(gr, gi);
  QuApply1(sr, si, 1, 0, gr, gi);
  QuApply1(sr, si, 1, 0, gr, gi);
  Check("ssRe"c, V(sr, 1), -1.0, TOL());

  // RY(pi/2) auf |0> gibt (|0>+|1>)/sqrt(2)
  QuStateZero(sr, si, 1);
  QuGateRY(gr, gi, 1.5707963267948966);
  QuApply1(sr, si, 1, 0, gr, gi);
  Check("ryRe0"c, V(sr, 0), 0.7071067811865476, 0.0000001);
  Check("ryRe1"c, V(sr, 1), 0.7071067811865476, 0.0000001);

  // RX(pi) auf |0> gibt -i|1>
  QuStateZero(sr, si, 1);
  QuGateRX(gr, gi, 3.141592653589793);
  QuApply1(sr, si, 1, 0, gr, gi);
  Check("rxIm1"c, V(si, 1), -1.0, 0.0000001);

  // RZ aendert nur Phasen: die Norm bleibt, die Wahrscheinlichkeit auch
  QuStateZero(sr, si, 1);
  QuGateH(gr, gi);
  QuApply1(sr, si, 1, 0, gr, gi);
  QuGateRZ(gr, gi, 0.7);
  QuApply1(sr, si, 1, 0, gr, gi);
  Check("rzProb"c, QuProbability(sr, si, 1, 0), 0.5, 0.0000001);
  Check("rzNorm"c, TenNorm(sr, si, 2), 1.0, 0.0000001);

  // ── Zwei Qubits: Bell-Zustand ─────────────────────────────────────────────
  QuStateZero(sr, si, 2);
  QuGateH(gr, gi);
  QuApply1(sr, si, 2, 0, gr, gi);
  var cn: int64 := alloc(16 * 8);
  var cni: int64 := alloc(16 * 8);
  QuGateCNOT(cn, cni);
  CheckB("cnotOk"c, QuApply2(sr, si, 2, 0, 1, cn, cni), true);

  Check("bell00"c, QuProbability(sr, si, 2, 0), 0.5, TOL());
  Check("bell01"c, QuProbability(sr, si, 2, 1), 0.0, TOL());
  Check("bell10"c, QuProbability(sr, si, 2, 2), 0.0, TOL());
  Check("bell11"c, QuProbability(sr, si, 2, 3), 0.5, TOL());
  Check("bellNorm"c, TenNorm(sr, si, 4), 1.0, TOL());
  Check("bellQ0One"c, QuProbQubitOne(sr, si, 2, 0), 0.5, TOL());
  Check("bellQ1One"c, QuProbQubitOne(sr, si, 2, 1), 0.5, TOL());

  // reduzierte Dichtematrix: maximal gemischt, Entropie 1 Bit
  var rr: int64 := alloc(4 * 8);
  var ri: int64 := alloc(4 * 8);
  CheckB("rdmOk"c, QuReducedDensity(sr, si, 2, 0, rr, ri), true);
  Check("rdm00"c, V(rr, 0), 0.5, TOL());
  Check("rdm11"c, V(rr, 3), 0.5, TOL());
  Check("rdm01"c, V(rr, 1), 0.0, TOL());
  // Spur einer Dichtematrix ist immer 1
  Check("rdmTrace"c, V(rr, 0) + V(rr, 3), 1.0, TOL());
  // Toleranz 1e-6 statt 1e-7: die Entropie laeuft ueber LogF64, dessen
  // relativer Fehler rund 1e-7 betraegt. Gemessen weicht sie um 1.5e-7 ab.
  // Bemerkenswert dabei: log(0.5)/log(2) ist exakt -1, weil sich der Fehler
  // dort weghebt — sobald der Eigenwert knapp neben 0.5 liegt, tut er das
  // nicht mehr.
  Check("bellEntropy"c, QuEntanglementEntropy(sr, si, 2, 0), 1.0, 0.000001);
  Check("bellEntropy1"c, QuEntanglementEntropy(sr, si, 2, 1), 1.0, 0.000001);

  // Produktzustand |+>|0>: keine Verschraenkung, Entropie 0
  QuStateZero(sr, si, 2);
  QuGateH(gr, gi);
  QuApply1(sr, si, 2, 0, gr, gi);
  Check("prodEntropy"c, QuEntanglementEntropy(sr, si, 2, 0), 0.0, 0.000001);
  QuReducedDensity(sr, si, 2, 0, rr, ri);
  // reiner Zustand: alle vier Eintraege 0.5
  Check("prodRdm00"c, V(rr, 0), 0.5, TOL());
  Check("prodRdm01"c, V(rr, 1), 0.5, TOL());
  Check("prodRdmTrace"c, V(rr, 0) + V(rr, 3), 1.0, TOL());

  // CZ ist symmetrisch, CNOT nicht — das unterscheidet die beiden
  QuStateBasis(sr, si, 2, 3);       // |11>
  QuGateCZ(cn, cni);
  QuApply2(sr, si, 2, 0, 1, cn, cni);
  Check("czPhase"c, V(sr, 3), -1.0, TOL());

  QuStateBasis(sr, si, 2, 2);       // |10>
  QuGateCNOT(cn, cni);
  QuApply2(sr, si, 2, 0, 1, cn, cni);
  Check("cnot10to11"c, QuProbability(sr, si, 2, 3), 1.0, TOL());

  // SWAP vertauscht |01> und |10>
  QuStateBasis(sr, si, 2, 1);
  QuGateSWAP(cn, cni);
  QuApply2(sr, si, 2, 0, 1, cn, cni);
  Check("swap"c, QuProbability(sr, si, 2, 2), 1.0, TOL());

  CheckB("apply2SameQubit"c, QuApply2(sr, si, 2, 0, 0, cn, cni), false);
  CheckB("apply1BadTarget"c, QuApply1(sr, si, 2, 5, gr, gi), false);

  // ── Drei Qubits: GHZ ──────────────────────────────────────────────────────
  QuStateZero(sr, si, 3);
  QuGateH(gr, gi);
  QuApply1(sr, si, 3, 0, gr, gi);
  QuGateCNOT(cn, cni);
  QuApply2(sr, si, 3, 0, 1, cn, cni);
  QuApply2(sr, si, 3, 1, 2, cn, cni);

  Check("ghz000"c, QuProbability(sr, si, 3, 0), 0.5, TOL());
  Check("ghz111"c, QuProbability(sr, si, 3, 7), 0.5, TOL());
  Check("ghzMid"c, QuProbability(sr, si, 3, 3), 0.0, TOL());
  Check("ghzNorm"c, TenNorm(sr, si, 8), 1.0, TOL());
  // jedes einzelne Qubit ist maximal verschraenkt mit dem Rest
  Check("ghzEnt0"c, QuEntanglementEntropy(sr, si, 3, 0), 1.0, 0.000001);
  Check("ghzEnt1"c, QuEntanglementEntropy(sr, si, 3, 1), 1.0, 0.000001);
  Check("ghzEnt2"c, QuEntanglementEntropy(sr, si, 3, 2), 1.0, 0.000001);

  // Normierung nach kuenstlicher Stoerung
  pokef64(sr, V(sr, 0) * 2.0);
  CheckB("normalizeOk"c, QuNormalize(sr, si, 3), true);
  Check("normalized"c, TenNorm(sr, si, 8), 1.0, TOL());

  free(sr, 8 * 8);  free(si, 8 * 8);
  free(gr, 16 * 8); free(gi, 16 * 8);
  free(cn, 16 * 8); free(cni, 16 * 8);
  free(rr, 4 * 8);  free(ri, 4 * 8);

  free(shape, 3 * 8);  free(str, 3 * 8);  free(idx, 3 * 8);
  free(ar2, 6 * 8);  free(ai2, 6 * 8);  free(br2, 6 * 8);  free(bi2, 6 * 8);
  free(sa, 2 * 8);   free(sb, 2 * 8);   free(axA, 2 * 8);  free(axB, 2 * 8);
  free(cr, 16 * 8);  free(ci, 16 * 8);  free(cs, 4 * 8);
  free(sx, 3 * 8);   free(sy, 3 * 8);   free(a2, 2 * 8);   free(b2, 2 * 8);
  free(v1r, 2 * 8);  free(v1i, 2 * 8);  free(v2r, 2 * 8);  free(v2i, 2 * 8);
  free(s1, 8);       free(s2, 8);       free(ps, 3 * 8);   free(perm, 3 * 8);
  free(ms, 2 * 8);   free(s4, 4 * 8);   free(trS, 2 * 8);
  free(ir, 8);       free(ii, 8);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
