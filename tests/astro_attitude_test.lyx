// tests/astro_attitude_test.lyx — std.astro.attitude (#1900)
//
// Alle Sollwerte sind analytisch, nicht aus derselben Formel gezogen, die
// hier geprueft wird: eine Drehung um einen bekannten Winkel um eine bekannte
// Achse hat ein bekanntes Ergebnis, und die Slew-Zeiten fallen aus den
// Gleichungen der gleichfoermig beschleunigten Bewegung.
//
// Die staerksten Pruefungen sind drei:
//
//   1. Der KURZE Weg. 350 Grad um z ist dieselbe Lage wie -10 Grad; ein
//      Regler, der das Vorzeichen nicht festlegt, dreht 350 statt 10. Ein
//      Test, der nur den Betrag prueft, saehe das nicht — deshalb steht hier
//      die Zahl 10 und nicht "kleiner als pi".
//   2. Die STETIGKEIT der Slew-Zeit an der Grenze zwischen dreieckigem und
//      trapezfoermigem Fall. Beide Formeln muessen dort dasselbe liefern;
//      ein Fehler in EINEM der Zweige bricht genau das.
//   3. Bei verschwindendem Fehler ist die ACHSE unbestimmt (NaN), der
//      DREHVEKTOR aber null. Beides zusammen ist die Aussage: die eine
//      Groesse hat dort keinen Wert, die andere sehr wohl.

unit main;

import std.io;
import std.math;
import std.quat;
import std.astro.state;
import std.astro.attitude;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn CheckRel(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  var d: f64 := AbsF64(got - want);
  var s: f64 := AbsF64(want);
  if (s < 1.0) { s := 1.0; }
  if (d / s <= tol) { PrintStr("PASS "c); PrintStrLn(name); }
  else {
    PrintStr("FAIL "c); PrintStr(name);
    PrintStr(": erhalten "c); PrintF64(got);
    PrintStr(" erwartet "c); PrintF64(want); PrintLn(""c);
    _fails := _fails + 1;
  }
}

fn CheckWahr(name: pchar, got: bool): void {
  _checks := _checks + 1;
  if (got) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStr(name); PrintStrLn(" (erwartet: wahr)"c); _fails := _fails + 1; }
}

fn CheckFalsch(name: pchar, got: bool): void {
  _checks := _checks + 1;
  if (!got) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStr(name); PrintStrLn(" (erwartet: falsch)"c); _fails := _fails + 1; }
}

fn Grad(x: f64): f64 { return x * Pi() / 180.0; }

fn main(): int64 {
  var eins: Quat := QuatIdentity();

  // ── Lagefehler: die Zahl aus dem Prototyp in #1900 ──────────────────────
  var q30: Quat := QuatFromAxisAngle(0.0, 0.0, 1.0, Grad(30.0));
  CheckRel("Lagefehler 30 Grad"c, AAttErrorAngle(eins, q30), Grad(30.0), 0.000000001);

  // Die Achse ist +z, und zwar mit Vorzeichen: der Fehler dreht von IST nach
  // SOLL. Ein vertauschtes Argumentpaar faellt genau hier auf und nirgends
  // sonst, denn der WINKEL ist in beiden Richtungen gleich.
  var achse: AVec3 := AAttErrorAxis(eins, q30);
  CheckRel("Fehlerachse +z"c, achse.z, 1.0, 0.000000001);
  CheckRel("Fehlerachse ohne x-Anteil"c, achse.x, 0.0, 0.000000001);
  var achseRueck: AVec3 := AAttErrorAxis(q30, eins);
  CheckRel("umgekehrte Richtung: Achse -z"c, achseRueck.z, 0.0 - 1.0, 0.000000001);
  CheckRel("umgekehrte Richtung: gleicher Winkel"c,
           AAttErrorAngle(q30, eins), Grad(30.0), 0.000000001);

  // Der Drehvektor traegt beides: Achse mal Winkel.
  var dv: AVec3 := AAttErrorVector(eins, q30);
  CheckRel("Drehvektor z = 30 Grad in rad"c, dv.z, Grad(30.0), 0.000000001);
  CheckRel("Betrag des Drehvektors = Winkel"c, AMagnitude(dv), Grad(30.0), 0.000000001);

  // ── Der kurze Weg ───────────────────────────────────────────────────────
  // 350 Grad um z IST -10 Grad um z. Ohne die Vorzeichenfestlegung kaeme hier
  // 350 heraus, und ein Regler drehte fast einmal herum.
  var q350: Quat := QuatFromAxisAngle(0.0, 0.0, 1.0, Grad(350.0));
  CheckRel("350 Grad zaehlen als 10 Grad"c, AAttErrorAngle(eins, q350), Grad(10.0), 0.0000001);
  var a350: AVec3 := AAttErrorAxis(eins, q350);
  CheckRel("und die Achse kippt auf -z"c, a350.z, 0.0 - 1.0, 0.0000001);
  // Genau 180 Grad ist der Grenzfall — dort sind beide Wege gleich lang.
  var q180: Quat := QuatFromAxisAngle(0.0, 0.0, 1.0, Grad(180.0));
  CheckRel("180 Grad bleiben 180 Grad"c, AAttErrorAngle(eins, q180), Pi(), 0.0000001);

  // q und -q sind DIESELBE Lage. Der Fehler dazwischen ist null.
  CheckRel("q und -q sind dieselbe Lage"c, AAttErrorAngle(q30, QuatNeg(q30)), 0.0, 0.0000001);

  // ── Verschwindender Fehler: Achse unbestimmt, Drehvektor null ───────────
  var keinAchse: AVec3 := AAttErrorAxis(eins, eins);
  CheckWahr("kein Fehler: Achse ist unbestimmt"c, AVecIsError(keinAchse));
  var keinDv: AVec3 := AAttErrorVector(eins, eins);
  CheckFalsch("kein Fehler: Drehvektor ist bestimmt"c, AVecIsError(keinDv));
  CheckRel("kein Fehler: Drehvektor ist null"c, AMagnitude(keinDv), 0.0, 0.000000001);

  // ── Winkelgeschwindigkeit ───────────────────────────────────────────────
  // 30 Grad in 3 Sekunden = 10 Grad/s um +z.
  var w: AVec3 := AAngularVelocity(eins, q30, 3.0);
  CheckRel("Winkelgeschwindigkeit z"c, w.z, Grad(10.0), 0.000000001);
  CheckRel("Winkelgeschwindigkeit Betrag"c, AMagnitude(w), Grad(10.0), 0.000000001);
  CheckWahr("dt = 0 meldet"c, AVecIsError(AAngularVelocity(eins, q30, 0.0)));
  CheckWahr("dt negativ meldet"c, AVecIsError(AAngularVelocity(eins, q30, 0.0 - 1.0)));

  // ── Weiterdrehen ────────────────────────────────────────────────────────
  // 0.1 rad/s um z, 5 s lang = 0.5 rad.
  var wz: AVec3 := AVec(0.0, 0.0, 0.1);
  var qn: Quat := AAttPropagate(eins, wz, 5.0);
  CheckRel("Propagation: 0.1 rad/s * 5 s = 0.5 rad"c, QuatAngle(qn), 0.5, 0.000000001);
  CheckWahr("Propagation liefert ein Einheitsquaternion"c, AAttValid(qn, 0.000000001));

  // Hin und zurueck ergibt die Ausgangslage — die Probe, die einen
  // Vorzeichenfehler in der Integration aufdeckt.
  var zurueck: Quat := AAttPropagate(qn, AScale(wz, 0.0 - 1.0), 5.0);
  CheckRel("Propagation hin und zurueck"c, AAttErrorAngle(eins, zurueck), 0.0, 0.0000001);

  // Ein ueberlanges Quaternion wird beim Weiterdrehen wieder normiert. Ohne
  // das treibt der Betrag ueber viele Schritte weg und die Lage skaliert
  // still — genau der Punkt aus der Meldung.
  var lang: Quat := QuatScale(q30, 1.5);
  CheckFalsch("Ausgangsquaternion ist nicht normiert"c, QuatIsUnit(lang, 0.000001));
  var korrigiert: Quat := AAttPropagate(lang, AVec(0.0, 0.0, 0.0), 1.0);
  CheckWahr("Propagation normiert wieder"c, AAttValid(korrigiert, 0.000000001));

  // ── Slew ────────────────────────────────────────────────────────────────
  var wMax: f64 := 0.05;    // rad/s
  var aMax: f64 := 0.005;   // rad/s^2
  var grenze: f64 := ASlewTriangleLimit(wMax, aMax);
  CheckRel("Grenzwinkel = wMax^2 / aMax"c, grenze, 0.5, 0.000000001);

  // Dreieckig: 0.125 rad -> 2*sqrt(0.125/0.005) = 10 s, Spitze sqrt(0.125*0.005).
  CheckRel("dreieckig: Zeit"c, ASlewTime(0.125, wMax, aMax), 10.0, 0.000000001);
  CheckRel("dreieckig: Spitzenrate"c, ASlewPeakRate(0.125, wMax, aMax), 0.025, 0.000000001);
  // Die Spitzenrate bleibt dort UNTER wMax — wer wMax meldet, ueberschaetzt
  // die Belastung der Aktorik.
  CheckWahr("dreieckig: Spitze unter wMax"c, ASlewPeakRate(0.125, wMax, aMax) < wMax);

  // Trapezfoermig: 1.0 rad -> 1/0.05 + 0.05/0.005 = 30 s, Spitze = wMax.
  CheckRel("trapezfoermig: Zeit"c, ASlewTime(1.0, wMax, aMax), 30.0, 0.000000001);
  CheckRel("trapezfoermig: Spitzenrate = wMax"c, ASlewPeakRate(1.0, wMax, aMax), wMax, 0.000000001);

  // Die Stetigkeit an der Grenze: beide Formeln muessen dort 20 s liefern.
  CheckRel("Grenze von unten"c, ASlewTime(grenze, wMax, aMax), 20.0, 0.000000001);
  CheckRel("Grenze von oben"c, ASlewTime(grenze * 1.000000001, wMax, aMax), 20.0, 0.000001);

  CheckRel("Winkel 0 braucht keine Zeit"c, ASlewTime(0.0, wMax, aMax), 0.0, 0.000000001);
  CheckWahr("negativer Winkel meldet"c, AIsError(ASlewTime(0.0 - 1.0, wMax, aMax)));
  CheckWahr("wMax = 0 meldet"c, AIsError(ASlewTime(1.0, 0.0, aMax)));
  CheckWahr("aMax = 0 meldet"c, AIsError(ASlewTime(1.0, wMax, 0.0)));

  // ── Ratengrenze ─────────────────────────────────────────────────────────
  var schnell: AVec3 := AVec(0.06, 0.08, 0.0);   // Betrag 0.1
  CheckFalsch("0.1 rad/s ueberschreitet 0.05"c, AAttRateWithin(schnell, wMax));
  var geklemmt: AVec3 := AAttClampRate(schnell, wMax);
  CheckRel("geklemmt auf wMax"c, AMagnitude(geklemmt), wMax, 0.000000001);
  // Die RICHTUNG bleibt. Komponentenweise zu klemmen waere falsch: das dreht
  // die Achse und damit das Ziel. Ein Test, der nur den Betrag prueft, waere
  // auch von der falschen Umsetzung erfuellt.
  CheckRel("Richtung bleibt erhalten (x)"c, geklemmt.x / AMagnitude(geklemmt), 0.6, 0.000000001);
  CheckRel("Richtung bleibt erhalten (y)"c, geklemmt.y / AMagnitude(geklemmt), 0.8, 0.000000001);
  // Und eine Rate unter der Grenze wird NICHT angefasst.
  var langsam: AVec3 := AVec(0.01, 0.0, 0.0);
  CheckWahr("langsame Rate haelt die Grenze"c, AAttRateWithin(langsam, wMax));
  CheckRel("langsame Rate bleibt unveraendert"c,
           AMagnitude(AAttClampRate(langsam, wMax)), 0.01, 0.000000001);

  // ── Gueltigkeit ─────────────────────────────────────────────────────────
  CheckWahr("Einheitsquaternion ist gueltig"c, AAttValid(q30, 0.000000001));
  CheckFalsch("ueberlanges Quaternion ist ungueltig"c, AAttValid(lang, 0.000001));
  CheckFalsch("NaN-Quaternion ist ungueltig"c,
              AAttValid(QuatNew(AError(), 0.0, 0.0, 0.0), 0.000001));

  PrintStr("\n"c);
  PrintInt(_checks); PrintStr(" Pruefungen, "c);
  PrintInt(_fails); PrintStrLn(" FAIL"c);
  if (_fails == 0) { PrintStrLn("OK: std.astro.attitude"c); return 0; }
  return 1;
}
