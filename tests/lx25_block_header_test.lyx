// LX-25 Test: Block Header I/O — Roundtrip + CRC + Validation (--target=x86_64)

import src.std.alloc;
import src.std.io;
import src.tools.lbf.block_header;

fn main(): int64 {
    var block: int64 := alloc(4096);

    // Payload (buf+64..buf+4095) mit 0xAB füllen
    var i: int64 := 64;
    while i < 4096 {
        poke8(block + i, 0xAB);
        i := i + 1;
    }

    // Genesis-Block initialisieren (block_index=0, total_blocks=1, compiled_at=0)
    lbf_header_init(block, 0, 1, 0, 1);

    // CRC setzen
    lbf_header_set_crc(block, block + 64);

    // Validate → 0 erwartet
    var r: int64 := lbf_header_validate(block);
    if r != 0 {
        EPrintStrLn("FAIL: validate nach init sollte 0 sein");
        return 1;
    }

    // lbf_header_is_genesis
    if !lbf_header_is_genesis(block) {
        EPrintStrLn("FAIL: Block sollte Genesis sein");
        return 1;
    }

    // Immutable-Flag setzen und prüfen
    lbf_header_set_immutable(block);
    if (peek8(block + 5) & 1) == 0 {
        EPrintStrLn("FAIL: Immutable-Flag nicht gesetzt");
        return 1;
    }

    // Payload korrumpieren → CRC-Fehler (-2)
    poke8(block + 65, peek8(block + 65) ^ 1);
    r := lbf_header_validate(block);
    if r != (0 - 2) {
        EPrintStrLn("FAIL: CRC-Fehler nicht erkannt");
        return 1;
    }

    // Payload wiederherstellen
    poke8(block + 65, peek8(block + 65) ^ 1);

    // Validate nach Wiederherstellung → wieder 0
    r := lbf_header_validate(block);
    if r != 0 {
        EPrintStrLn("FAIL: validate nach Wiederherstellung sollte 0 sein");
        return 1;
    }

    // Magic korrumpieren → Magic-Fehler (-1)
    poke8(block, 0xFF);
    r := lbf_header_validate(block);
    if r != (0 - 1) {
        EPrintStrLn("FAIL: Magic-Fehler nicht erkannt");
        return 1;
    }

    PrintStrLn("lx25: block header OK");
    return 0;
}
