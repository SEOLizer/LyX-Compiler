// tests/aws_demo4_lambda_sqs.lyx — AWS SDK Demo: Lambda + SQS pipeline
// WP-AWS-15

unit tests.aws_demo4_lambda_sqs;

import std.cloud.aws.core;
import std.cloud.lambda;
import std.cloud.sqs;
import std.alloc;
import std.io;

pub fn main(argc: int64, argv: pchar): int64 {
    PrintLn("=== AWS Lambda + SQS Demo ==="c);

    var creds: AWSCreds := AWSCredentialsDefault();
    if (creds.accessKey == 0) {
        PrintLn("Error: no credentials found."c);
        return 1;
    }

    var region: pchar := "eu-central-1"c;
    if (creds.region != 0) { region := creds.region as pchar; }

    // ── SQS Part ──────────────────────────────────────────────────────────────

    PrintLn("--- SQS: Create Queue ---"c);
    var sqsClient: SQSClient := SQSConnect(creds, region);
    var queueName: pchar := "lyxaws-demo-pipeline"c;

    var queueUrl: int64 := SQSCreateQueue(sqsClient, queueName, 30, 86400);
    if (queueUrl != 0) {
        Print("Queue URL: "c); PrintLn(queueUrl as pchar);
    } else {
        // Try to get URL if it already exists
        queueUrl := SQSGetQueueUrl(sqsClient, queueName);
        if (queueUrl != 0) {
            Print("Existing Queue URL: "c); PrintLn(queueUrl as pchar);
        } else {
            PrintLn("Error: could not create or get queue"c);
            SQSClose(sqsClient);
            return 1;
        }
    }

    var qurl: pchar := queueUrl as pchar;

    // Send messages
    PrintLn("--- SQS: Send Messages ---"c);
    var msg1: int64 := SQSSendMessage(sqsClient, qurl, "{\"event\":\"order\",\"id\":\"ORD-001\",\"amount\":99.99}"c, 0);
    if (msg1 != 0) { Print("Sent msg1: "c); PrintLn(msg1 as pchar); free(msg1, StrLen(msg1 as pchar)+1); }
    var msg2: int64 := SQSSendMessage(sqsClient, qurl, "{\"event\":\"order\",\"id\":\"ORD-002\",\"amount\":149.00}"c, 0);
    if (msg2 != 0) { Print("Sent msg2: "c); PrintLn(msg2 as pchar); free(msg2, StrLen(msg2 as pchar)+1); }
    var msg3: int64 := SQSSendMessage(sqsClient, qurl, "{\"event\":\"order\",\"id\":\"ORD-003\",\"amount\":9.99}"c, 0);
    if (msg3 != 0) { Print("Sent msg3: "c); PrintLn(msg3 as pchar); free(msg3, StrLen(msg3 as pchar)+1); }

    // Get queue attributes (message count)
    PrintLn("--- SQS: Queue Attributes ---"c);
    var attrs: int64 := SQSGetQueueAttributes(sqsClient, qurl);
    if (attrs != 0) { PrintLn(attrs as pchar); free(attrs, StrLen(attrs as pchar)+1); }

    // Receive messages
    PrintLn("--- SQS: Receive Messages ---"c);
    var received: int64 := SQSReceiveMessages(sqsClient, qurl, 10, 0);
    if (received != 0) {
        PrintLn(received as pchar);
        // Parse and delete first message
        var firstMsg: SQSMessage := SQSParseFirstMessage(received, StrLen(received as pchar));
        if (firstMsg.receiptHandle != 0) {
            PrintLn("--- SQS: Delete First Message ---"c);
            var ok: int64 := SQSDeleteMessage(sqsClient, qurl, firstMsg.receiptHandle as pchar);
            if (ok == 1) { PrintLn("Message deleted"c); }
        }
        SQSMessageFree(firstMsg);
        free(received, StrLen(received as pchar)+1);
    }

    // Purge and delete queue
    PrintLn("--- SQS: Purge Queue ---"c);
    SQSPurgeQueue(sqsClient, qurl);
    PrintLn("--- SQS: Delete Queue ---"c);
    SQSDeleteQueue(sqsClient, qurl);
    free(queueUrl, StrLen(queueUrl as pchar)+1);
    SQSClose(sqsClient);

    // ── Lambda Part ───────────────────────────────────────────────────────────

    PrintLn("--- Lambda: List Functions ---"c);
    var lambdaClient: LambdaClient := LambdaConnect(creds, region);
    var functions: int64 := LambdaListFunctions(lambdaClient);
    if (functions != 0) {
        PrintLn(functions as pchar);
        free(functions, StrLen(functions as pchar)+1);
    } else {
        PrintLn("(no functions or error)"c);
    }

    // Invoke an existing function (if available)
    PrintLn("--- Lambda: Invoke (demo-processor) ---"c);
    var payload: pchar := "{\"source\":\"lyxaws-demo\",\"version\":\"1.0\"}"c;
    var result: int64 := LambdaInvoke(lambdaClient, "demo-processor"c,
                                       payload as int64, StrLen(payload),
                                       "RequestResponse"c);
    if (result != 0) {
        Print("Response: "c); PrintLn(result as pchar);
        free(result, StrLen(result as pchar)+1);
    } else {
        PrintLn("(function not found or error — skipped)"c);
    }

    LambdaClose(lambdaClient);
    PrintLn("=== Done ==="c);
    return 0;
}
