// tests/streq_simd_probe.lyx — Nachweis fuer _lyx_streq und
// _lyx_startswith (T1.2).
//
// Gemessen wird gegen eine unabhaengige byteweise Fassung, Fall fuer Fall,
// und BEIDE Seiten: dass gleiche Ketten 1 geben, UND dass ungleiche 0
// geben. Ein Test, der nur die Treffer prueft, waere auch von einer
// Fassung erfuellt, die immer 1 sagt.
//
//   1. Gleichheit fuer Laengen 0..40 an jedem Versatz 0..15.
//   2. Abweichung an JEDER Position — der Block, in dem sie liegt,
//      entscheidet, und die Entscheidung haengt daran, ob vor ihr eine
//      Null steht.
//   3. Praefixverhaeltnis in beiden Richtungen: "abc" vs "abcd" ist
//      UNGLEICH, aber "abc" IST ein Praefix von "abcd". Das ist genau die
//      Stelle, an der sich die beiden Helfer unterscheiden.
//   4. Seitengrenze: beide Zeiger im letzten 16-Byte-Stueck einer Seite,
//      dahinter unbelegt. Ohne die Seitenpruefung im Helfer faultet das.

@description("Nachweis: _lyx_streq und _lyx_startswith, beide Seiten")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")

import std.io;

fn setze(p: int64, n: int64, saat: int64): void {
  var i: int64 := 0;
  while (i < n) { poke8(p + i, 97 + ((i + saat) % 26)); i += 1; }
  poke8(p + n, 0);
}

// Unabhaengige byteweise Fassungen — bewusst ohne die Builtins.
fn gleichByteweise(a: int64, b: int64): int64 {
  var i: int64 := 0;
  while (true) {
    var ca: int64 := peek8(a + i);
    var cb: int64 := peek8(b + i);
    if (ca != cb) { return 0; }
    if (ca == 0) { return 1; }
    i += 1;
  }
  return 0;
}

fn beginntByteweise(s: int64, pre: int64): int64 {
  var i: int64 := 0;
  while (true) {
    var cp: int64 := peek8(pre + i);
    if (cp == 0) { return 1; }
    if (peek8(s + i) != cp) { return 0; }
    i += 1;
  }
  return 0;
}

fn main(): int64 {
  var fehler: int64 := 0;
  var geprueft: int64 := 0;

  var ra: int64 := alloc(4096);
  var rb: int64 := alloc(4096);

  // --- 1 bis 3 --------------------------------------------------------
  var vers: int64 := 0;
  while (vers < 16) {
    var n: int64 := 0;
    while (n <= 40) {
      var a: int64 := ra + vers;
      var b: int64 := rb + vers;

      // (1) gleich
      setze(a, n, 0);
      setze(b, n, 0);
      var sollG: int64 := gleichByteweise(a, b);
      var istG: int64 := 0;
      if (StrEquals(a as pchar, b as pchar)) { istG := 1; }
      geprueft += 1;
      if (istG != sollG || sollG != 1) {
        PrintStr("FEHLER gleich: vers="c); PrintInt(vers);
        PrintStr(" n="c); PrintInt(n);
        PrintStr(" ist="c); PrintInt(istG);
        PrintStr(" soll="c); PrintLn(sollG);
        fehler += 1;
      }
      var istS: int64 := 0;
      if (StrStartsWith(a as pchar, b as pchar)) { istS := 1; }
      geprueft += 1;
      if (istS != beginntByteweise(a, b)) {
        PrintStr("FEHLER beginnt(gleich): vers="c); PrintInt(vers);
        PrintStr(" n="c); PrintLn(n);
        fehler += 1;
      }

      // (2) Abweichung an jeder Position
      var pos: int64 := 0;
      while (pos < n) {
        setze(b, n, 0);
        poke8(b + pos, peek8(b + pos) + 1);
        var sG: int64 := gleichByteweise(a, b);
        var iG: int64 := 0;
        if (StrEquals(a as pchar, b as pchar)) { iG := 1; }
        geprueft += 1;
        if (iG != sG || sG != 0) {
          PrintStr("FEHLER abweichend: vers="c); PrintInt(vers);
          PrintStr(" n="c); PrintInt(n);
          PrintStr(" pos="c); PrintInt(pos);
          PrintStr(" ist="c); PrintLn(iG);
          fehler += 1;
        }
        var sS: int64 := beginntByteweise(a, b);
        var iS: int64 := 0;
        if (StrStartsWith(a as pchar, b as pchar)) { iS := 1; }
        geprueft += 1;
        if (iS != sS) {
          PrintStr("FEHLER beginnt(abweichend): vers="c); PrintInt(vers);
          PrintStr(" n="c); PrintInt(n);
          PrintStr(" pos="c); PrintLn(pos);
          fehler += 1;
        }
        pos += 1;
      }

      // (3) Praefixverhaeltnis: b ist das kuerzere
      var kurz: int64 := 0;
      while (kurz < n) {
        setze(a, n, 0);
        setze(b, kurz, 0);
        var pG: int64 := gleichByteweise(a, b);
        var pI: int64 := 0;
        if (StrEquals(a as pchar, b as pchar)) { pI := 1; }
        geprueft += 1;
        if (pI != pG || pG != 0) {
          PrintStr("FEHLER Praefix/gleich: n="c); PrintInt(n);
          PrintStr(" kurz="c); PrintInt(kurz);
          PrintStr(" ist="c); PrintLn(pI);
          fehler += 1;
        }
        // ... aber es IST ein Praefix
        var qS: int64 := beginntByteweise(a, b);
        var qI: int64 := 0;
        if (StrStartsWith(a as pchar, b as pchar)) { qI := 1; }
        geprueft += 1;
        if (qI != qS || qS != 1) {
          PrintStr("FEHLER Praefix/beginnt: n="c); PrintInt(n);
          PrintStr(" kurz="c); PrintInt(kurz);
          PrintStr(" ist="c); PrintLn(qI);
          fehler += 1;
        }
        // umgekehrt: das LAENGERE ist kein Praefix des kuerzeren
        var rS: int64 := beginntByteweise(b, a);
        var rI: int64 := 0;
        if (StrStartsWith(b as pchar, a as pchar)) { rI := 1; }
        geprueft += 1;
        if (rI != rS || rS != 0) {
          PrintStr("FEHLER umgekehrt/beginnt: n="c); PrintInt(n);
          PrintStr(" kurz="c); PrintInt(kurz);
          PrintStr(" ist="c); PrintLn(rI);
          fehler += 1;
        }
        kurz += 8;
      }
      n += 1;
    }
    vers += 1;
  }

  // --- 4: Seitengrenze ------------------------------------------------
  var s1: int64 := mmap(0, 8192, 3, 34, 0 - 1, 0);
  var s2: int64 := mmap(0, 8192, 3, 34, 0 - 1, 0);
  if (s1 <= 0 || s2 <= 0) {
    PrintLn("FEHLER mmap fuer den Seitentest schlug fehl");
    fehler += 1;
  } else {
    munmap(s1 + 4096, 4096);
    munmap(s2 + 4096, 4096);
    var kl: int64 := 0;
    while (kl <= 20) {
      var pa: int64 := s1 + 4096 - 1 - kl;
      var pb: int64 := s2 + 4096 - 1 - kl;
      var j: int64 := 0;
      while (j < kl) { poke8(pa + j, 100); poke8(pb + j, 100); j += 1; }
      poke8(s1 + 4095, 0);
      poke8(s2 + 4095, 0);
      var gg: int64 := 0;
      if (StrEquals(pa as pchar, pb as pchar)) { gg := 1; }
      geprueft += 1;
      if (gg != 1) {
        PrintStr("FEHLER Seitengrenze gleich, kl="c); PrintLn(kl);
        fehler += 1;
      }
      var bb: int64 := 0;
      if (StrStartsWith(pa as pchar, pb as pchar)) { bb := 1; }
      geprueft += 1;
      if (bb != 1) {
        PrintStr("FEHLER Seitengrenze beginnt, kl="c); PrintLn(kl);
        fehler += 1;
      }
      // und eine Abweichung im letzten Byte vor der Grenze
      if (kl > 0) {
        poke8(pb + kl - 1, 101);
        var uu: int64 := 1;
        if (StrEquals(pa as pchar, pb as pchar)) { uu := 1; } else { uu := 0; }
        geprueft += 1;
        if (uu != 0) {
          PrintStr("FEHLER Seitengrenze ungleich nicht erkannt, kl="c); PrintLn(kl);
          fehler += 1;
        }
        poke8(pb + kl - 1, 100);
      }
      kl += 1;
    }
  }

  PrintStr("geprueft="c); PrintInt(geprueft);
  PrintStr(" fehler="c); PrintLn(fehler);
  if (fehler != 0) { return 1; }
  PrintLn("ALL PASS");
  return 0;
}
