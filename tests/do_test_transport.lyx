// tests/do_test_transport.lyx — DO SDK Unit Tests: Transport + Credentials
// WP-DO-14 Integrationstests (keine echten API-Calls — nur strukturelle Tests)

unit tests.do_test_transport;

import std.cloud.digitalocean.transport;
import std.cloud.digitalocean.credentials;
import std.alloc;
import std.io;

var passed: int64 := 0;
var failed: int64 := 0;

fn checkThat(name: pchar, cond: int64) {
    if (cond == 1) {
        Print("  PASS: "c); PrintLn(name);
        passed := passed + 1;
    } else {
        Print("  FAIL: "c); PrintLn(name);
        failed := failed + 1;
    }
}

fn testPathHelpers() {
    PrintLn("--- Path Helpers ---"c);
    var buf: int64 := alloc(256);

    doMakePath(buf, "/v2/droplets/"c, "12345"c);
    var s: pchar := buf as pchar;
    var isMatch: int64 := StrEquals(s, "/v2/droplets/12345"c) as int64;
    checkThat("doMakePath /v2/droplets/12345"c, isMatch);

    doMakePath3(buf, "/v2/databases/"c, "abc-uuid"c, "/users"c);
    var s2: pchar := buf as pchar;
    var match2: int64 := StrEquals(s2, "/v2/databases/abc-uuid/users"c) as int64;
    checkThat("doMakePath3 /v2/databases/abc-uuid/users"c, match2);

    var numBuf: int64 := alloc(24);
    doMakePathI(buf, "/droplets/"c, 42);   // #1017: doMakePathI stellt "/v2" selbst voran
    var s3: pchar := buf as pchar;
    var match3: int64 := StrEquals(s3, "/v2/droplets/42"c) as int64;
    checkThat("doMakePathI /v2/droplets/42"c, match3);
    free(numBuf, 24);

    doMakePathIS(buf, "/droplets/"c, 99, "/actions"c);
    var s4: pchar := buf as pchar;
    var match4: int64 := StrEquals(s4, "/v2/droplets/99/actions"c) as int64;
    checkThat("doMakePathIS /v2/droplets/99/actions"c, match4);

    doMakePathSS(buf, "/kubernetes/clusters/"c, "cluster-id"c, "/node_pools"c);
    var s5: pchar := buf as pchar;
    var match5: int64 := StrEquals(s5, "/v2/kubernetes/clusters/cluster-id/node_pools"c) as int64;
    checkThat("doMakePathSS cluster/node_pools"c, match5);

    free(buf, 256);
}

fn testJSONHelpers() {
    PrintLn("--- JSON Helpers ---"c);

    // Simple JSON object
    var json: pchar := "{\"id\":\"abc-123\",\"name\":\"test-droplet\",\"status\":\"active\",\"count\":42,\"active\":true}"c;
    var jsonPtr: int64 := json as int64;

    var id: int64 := doJsonStr(jsonPtr, "id"c);
    var idMatch: int64 := 0;
    if (id != 0) { idMatch := StrEquals(id as pchar, "abc-123"c) as int64; free(id, StrLen(id as pchar)+1); }
    checkThat("doJsonStr id=abc-123"c, idMatch);

    var name: int64 := doJsonStr(jsonPtr, "name"c);
    var nameMatch: int64 := 0;
    if (name != 0) { nameMatch := StrEquals(name as pchar, "test-droplet"c) as int64; free(name, StrLen(name as pchar)+1); }
    checkThat("doJsonStr name=test-droplet"c, nameMatch);

    var count: int64 := doJsonInt(jsonPtr, "count"c);
    checkThat("doJsonInt count=42"c, count == 42);

    var active: int64 := doJsonBool(jsonPtr, "active"c);
    checkThat("doJsonBool active=true"c, active == 1);

    var missing: int64 := doJsonStr(jsonPtr, "nonexistent"c);
    checkThat("doJsonStr missing=0"c, missing == 0);
}

fn testClientNew() {
    PrintLn("--- DOClientNew ---"c);
    var tok: pchar := "dop_v1_test_token_1234567890abcdef"c;
    var cl: DOClient := DOClientNew(tok);
    var tokLen: int64 := StrLen(tok);
    checkThat("DOClientNew token not null"c, cl.token != 0);
    checkThat("DOClientNew tokenLen correct"c, cl.tokenLen == tokLen);
}

fn testCredentialsFromToken() {
    PrintLn("--- DOCredentialsFromToken ---"c);
    var tok: pchar := "dop_v1_abc123"c;
    var creds: DOCredentials := DOCredentialsFromToken(tok);
    checkThat("creds.token not null"c, creds.token != 0);
    checkThat("creds.tokenLen == 13"c, creds.tokenLen == 13);   // #1017: "dop_v1_abc123" hat 13 Zeichen
    checkThat("creds.tokenType == PAT"c, creds.tokenType == DO_TOKEN_PAT);
    DOCredentialsFree(creds);
}

fn testCredentialsFree() {
    PrintLn("--- DOCredentialsFree ---"c);
    var tok: pchar := "dop_v1_freetest"c;
    var creds: DOCredentials := DOCredentialsFromToken(tok);
    DOCredentialsFree(creds);
    // no crash = pass
    checkThat("DOCredentialsFree no crash"c, 1);
}

pub fn main(argc: int64, argv: pchar): int64 {
    PrintLn("=== DO SDK Transport Tests ==="c);

    testPathHelpers();
    testJSONHelpers();
    testClientNew();
    testCredentialsFromToken();
    testCredentialsFree();

    PrintLn(""c);
    Print("Ergebnis: "c);
    var nb: int64 := alloc(24);
    Print(Int64ToStr(passed, nb)); Print(" bestanden, "c);
    Print(Int64ToStr(failed, nb)); PrintLn(" fehlgeschlagen."c);
    free(nb, 24);

    if (failed > 0) { return 1; }
    return 0;
}
