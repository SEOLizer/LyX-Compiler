// tests/sec_wp26_alloc_test.lyx — WP-26: alloc() Sicherheitstests (15 tests)
//
// Prüft:
//   C-1: Integer-Overflow-Guard (size > 1 GB → return 0)
//   C-2: Zero-Alloc-Aliasing (alloc(0) liefert zwei verschiedene Adressen)
unit tests.sec_wp26_alloc_test;

import std.alloc;
import src.std.io;

fn pass(n: int64) { Print("PASS "); PrintLn(n); }
fn fail(n: int64) { Print("FAIL "); PrintLn(n); }
fn check(n: int64, ok: int64) { if ok == 1 { pass(n); } else { fail(n); } }

fn main() {
    // ── Tests 1-5: Normales alloc() funktioniert weiterhin ───────────────────
    var p1: int64 := alloc(1);
    check(1, p1 != 0);

    var p2: int64 := alloc(16);
    check(2, p2 != 0);
    check(3, p2 != p1);            // Zwei Allokationen sind verschieden

    var p3: int64 := alloc(1024);
    check(4, p3 != 0);
    check(5, p3 != p2);

    // ── Tests 6-8: C-2 Zero-Alloc-Aliasing — alloc(0) darf nicht aliasieren ─
    var z1: int64 := alloc(0);
    var z2: int64 := alloc(0);
    check(6, z1 != 0);             // alloc(0) gibt gültigen Pointer zurück
    check(7, z2 != 0);
    check(8, z1 != z2);            // KERN: zwei alloc(0) müssen verschiedene Adressen sein

    // ── Tests 9-10: C-2 Negatives size — wie alloc(0) behandelt ─────────────
    var n1: int64 := alloc(0 - 1);   // size = -1
    var n2: int64 := alloc(0 - 1);
    check(9,  n1 != 0);
    check(10, n1 != n2);           // Zwei negative allocs müssen verschieden sein

    // ── Tests 11-13: C-1 Integer-Overflow-Guard ───────────────────────────────
    // alloc(> 1 GB) muss 0 zurückgeben
    var big1: int64 := alloc(1073741825);    // 1 GB + 1 → verboten
    check(11, big1 == 0);

    var big2: int64 := alloc(2147483648);    // 2 GB → verboten
    check(12, big2 == 0);

    // alloc(genau 1 GB) ist erlaubt (Grenze inklusiv)
    // Hinweis: testet nur Rückgabe-non-null, nicht ob mmap tatsächlich 1 GB frei hat
    // Daher: nur prüfen dass 1073741824 nicht 0 zurückgibt auf einem System mit genug RAM
    // Wir überspringen diesen Test da er RAM-abhängig ist.

    // ── Tests 14-15: Normales Schreiben nach alloc() funktioniert ────────────
    var buf: int64 := alloc(8);
    poke8(buf,   0xAA);
    poke8(buf+1, 0xBB);
    check(14, (peek8(buf)   & 255) == 0xAA);
    check(15, (peek8(buf+1) & 255) == 0xBB);
}
