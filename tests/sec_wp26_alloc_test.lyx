// tests/sec_wp26_alloc_test.lyx — WP-26: alloc()/calloc() Sicherheitstests (18 tests)
//
// Prüft:
//   C-1: Integer-Overflow-Guard alloc() (size > 1 GB → return 0)
//   C-2: Zero-Alloc-Aliasing (alloc(0) liefert zwei verschiedene Adressen)
//   C-3: calloc() Integer-Overflow (count*elem_size → return 0 statt Under-Alloc)
//
// main() gibt die Anzahl der Fehlschläge zurück (0 = grün) → non-zero exit für CI.
unit tests.sec_wp26_alloc_test;

import std.alloc;
import std.io;

fn pass(n: int64) { Print("PASS "); PrintLn(n); }
fn fail(n: int64) { Print("FAIL "); PrintLn(n); }
// Gibt 1 zurück wenn der Check fehlschlägt (für Fail-Akkumulation in main → exit-Code).
fn check(n: int64, ok: int64): int64 { if ok == 1 { pass(n); return 0; } fail(n); return 1; }

fn main(): int64 {
    var f: int64 := 0;
    // ── Tests 1-5: Normales alloc() funktioniert weiterhin ───────────────────
    var p1: int64 := alloc(1);
    f := f + check(1, p1 != 0);

    var p2: int64 := alloc(16);
    f := f + check(2, p2 != 0);
    f := f + check(3, p2 != p1);            // Zwei Allokationen sind verschieden

    var p3: int64 := alloc(1024);
    f := f + check(4, p3 != 0);
    f := f + check(5, p3 != p2);

    // ── Tests 6-8: C-2 Zero-Alloc-Aliasing — alloc(0) darf nicht aliasieren ─
    var z1: int64 := alloc(0);
    var z2: int64 := alloc(0);
    f := f + check(6, z1 != 0);             // alloc(0) gibt gültigen Pointer zurück
    f := f + check(7, z2 != 0);
    f := f + check(8, z1 != z2);            // KERN: zwei alloc(0) müssen verschiedene Adressen sein

    // ── Tests 9-10: C-2 Negatives size — wie alloc(0) behandelt ─────────────
    var n1: int64 := alloc(0 - 1);   // size = -1
    var n2: int64 := alloc(0 - 1);
    f := f + check(9,  n1 != 0);
    f := f + check(10, n1 != n2);           // Zwei negative allocs müssen verschieden sein

    // ── Tests 11-12: C-1 Integer-Overflow-Guard (Test 13: 1-GB-Grenzfall RAM-abhängig, übersprungen) ─
    var big1: int64 := alloc(1073741825);    // 1 GB + 1 → verboten
    f := f + check(11, big1 == 0);

    var big2: int64 := alloc(2147483648);    // 2 GB → verboten
    f := f + check(12, big2 == 0);

    // ── Tests 14-15: Normales Schreiben nach alloc() funktioniert ────────────
    var buf: int64 := alloc(8);
    poke8(buf,   0xAA);
    poke8(buf+1, 0xBB);
    f := f + check(14, (peek8(buf)   & 255) == 0xAA);
    f := f + check(15, (peek8(buf+1) & 255) == 0xBB);

    // ── Tests 16-18: WP-26 calloc() Integer-Overflow-Guard ───────────────────
    // count*elem_size würde überlaufen → muss 0 liefern (kein Under-Alloc)
    f := f + check(16, calloc(0 - 1, 8) == 0);          // negativer count
    f := f + check(17, calloc(4611686018427387904, 8) == 0);  // 2^62 * 8 → Overflow
    f := f + check(18, calloc(0, 8) == 0);              // zero count

    return f;   // 0 = alle PASS; >0 = Anzahl FAILs → non-zero exit für CI
}
