// ============================================================
// AC-WP03.3: CTR_DRBG deterministic + state-updating
// ============================================================
fn testDRBGDeterminism(): int64 {
  var seed: int64 := alloc(48);
  var s1: int64 := alloc(AES256CTR_STATE_SIZE);
  var s2: int64 := alloc(AES256CTR_STATE_SIZE);
  var out1: int64 := alloc(64);
  var out2: int64 := alloc(64);
  var out3: int64 := alloc(64);
  var i: int64 := 0;
  var ok: int64 := 0;
  var diff: int64 := 0;
  var failed: int64 := 0;
  // Seed: 0x00..0x2F
  while (i < 48) { poke8(seed+i, i); i := i+1; }
  AES256CTRDRBGInit(s1, seed);
  AES256CTRDRBGInit(s2, seed);
  AES256CTRDRBGGenerate(s1, out1, 64);
  AES256CTRDRBGGenerate(s2, out2, 64);
  // Same seed → same output
  ok := compareBytes(out1, out2, 64);
  if (ok == 0) { PrintLn("FAIL: CTR_DRBG same seed produced different output (WP-03.3)"); failed := failed+1; }
  // Second call on s1 → different output (state updated after each generate)
  AES256CTRDRBGGenerate(s1, out3, 64);
  diff := compareBytes(out1, out3, 64);
  if (diff == 1) { PrintLn("FAIL: CTR_DRBG second call same as first (state not updated) (WP-03.3)"); failed := failed+1; }
  free(out3,64); free(out2,64); free(out1,64);
  free(s2,AES256CTR_STATE_SIZE); free(s1,AES256CTR_STATE_SIZE); free(seed,48);
  if (failed == 0) { PrintLn("OK: CTR_DRBG deterministic & state-updating (WP-03.3)"); }
  return failed;
}

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testCTRRoundtrip();
  failed := failed + testNIST80038A();
  failed := failed + testDRBGDeterminism();
  if (failed != 0) { PrintLn("FAILED"); return 1; }
  PrintLn("ALL PASSED");
  return 0;
}
