// tests/pqc_wp03_test.lyx
// WP-PQC-03: AES-256-CTR + CTR_DRBG — Korrektheitstests
//
// Abnahmekriterien:
// AC-WP03.1: AES-256-CTR Encrypt→Decrypt Roundtrip
// AC-WP03.2: AES-256-CTR vs. NIST SP 800-38A F.5.5 (AES-256 CTR, 4 Blöcke)
// AC-WP03.3: CTR_DRBG deterministic & state-updating

unit tests.pqc_wp03_test;

import std.crypto.aes;
import std.alloc;

fn fillbuf(buf: int64, val: int64, n: int64) {
  var i: int64 := 0;
  while (i < n) { poke8(buf+i, val); i := i+1; }
}

fn compareBytes(a: int64, b: int64, n: int64): int64 {
  var i: int64 := 0;
  while (i < n) {
    if (peek8(a+i) != peek8(b+i)) { return 0; }
    i := i+1;
  }
  return 1;
}

// ============================================================
// AC-WP03.1: AES-256-CTR Encrypt→Decrypt Roundtrip
// ============================================================
fn testCTRRoundtrip(): int64 {
  var key: int64 := alloc(32);
  var iv:  int64 := alloc(16);
  var pt:  int64 := alloc(48);
  var ct:  int64 := alloc(48);
  var dt:  int64 := alloc(48);
  var i:   int64 := 0;
  fillbuf(key, 0xAB, 32);
  fillbuf(iv,  0x55, 16);
  while (i < 48) { poke8(pt+i, i); i := i+1; }
  AES256CTR(key, iv, pt, 48, ct);
  AES256CTR(key, iv, ct, 48, dt);
  var ok: int64 := compareBytes(pt, dt, 48);
  free(dt,48); free(ct,48); free(pt,48); free(iv,16); free(key,32);
  if (ok == 1) { PrintLn("OK: AES-256-CTR Encrypt->Decrypt Roundtrip (WP-03.1)"); return 0; }
  PrintLn("FAIL: AES-256-CTR Roundtrip mismatch (WP-03.1)");
  return 1;
}

