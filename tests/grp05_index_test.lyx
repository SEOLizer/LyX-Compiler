// tests/grp05_index_test.lyx
// WP-GRP-05 Abnahmetest: TemporalIndex, TypeIndex, VectorIndex

unit tests.grp05_index_test;

import std.graphdb.core;
import std.graphdb.node;
import std.graphdb.edge;
import std.graphdb.mem;
import std.graphdb.index;
import std.io;
import std.alloc;

fn makeNode(id: int64): int64 {
    var n: int64 := alloc(GNODE_SIZE);
    GraphNodeInit(n);
    poke64(n + GNODE_OFF_ID, id);
    return n;
}

fn makeEdgeAt(id: int64, src: int64, tgt: int64, ts: int64): int64 {
    var e: int64 := alloc(GEDGE_SIZE);
    GraphEdgeInit(e);
    poke64(e + GEDGE_OFF_ID,        id);
    poke64(e + GEDGE_OFF_SOURCE,    src);
    poke64(e + GEDGE_OFF_TARGET,    tgt);
    poke64(e + GEDGE_OFF_CREATEDAT, ts);
    return e;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // ── Setup Store ──────────────────────────────────────────
    var s: int64 := alloc(GMEM_SIZE);
    GraphMemStoreInit(s);

    var idA: int64 := GraphIDNew();
    var idB: int64 := GraphIDNew();
    var idC: int64 := GraphIDNew();
    var nA: int64  := makeNode(idA);
    var nB: int64  := makeNode(idB);
    var nC: int64  := makeNode(idC);
    GraphMemStoreAddNode(s, nA);
    GraphMemStoreAddNode(s, nB);
    GraphMemStoreAddNode(s, nC);

    var t1: int64 := 1000;
    var t2: int64 := 2000;
    var t3: int64 := 3000;

    var idE1: int64 := GraphIDNew();
    var idE2: int64 := GraphIDNew();
    var idE3: int64 := GraphIDNew();
    var eAB: int64  := makeEdgeAt(idE1, idA, idB, t1);
    var eBC: int64  := makeEdgeAt(idE2, idB, idC, t2);
    var eAC: int64  := makeEdgeAt(idE3, idA, idC, t3);
    GraphEdgeSetType(eAB, "KNOWS"c, 5);
    GraphEdgeSetType(eBC, "LIKES"c, 5);
    GraphEdgeSetType(eAC, "KNOWS"c, 5);
    GraphMemStoreAddEdge(s, eAB);
    GraphMemStoreAddEdge(s, eBC);
    GraphMemStoreAddEdge(s, eAC);

    // ── TemporalIndex ─────────────────────────────────────────
    var tidx: int64 := alloc(GTIDX_SIZE);
    GraphTemporalIndexInit(tidx);
    GraphTemporalIndexBuild(tidx, s);
    PrintLn("PASS: TemporalIndexBuild no crash"c);

    // Query [t1, t2] → E1, E2
    var tbuf: int64 := alloc(10 * 8);
    var tcnt: int64 := GraphTemporalIndexQuery(tidx, t1, t2, tbuf, 10);
    if (tcnt != 2) {
        PrintLn("FAIL: TemporalQuery [t1,t2] count != 2"c); ok := 0;
    } else { PrintLn("PASS: TemporalQuery [t1,t2] count=2"c); }

    // Query [t3, t3] → E3 only
    var tcnt2: int64 := GraphTemporalIndexQuery(tidx, t3, t3, tbuf, 10);
    if (tcnt2 != 1) {
        PrintLn("FAIL: TemporalQuery [t3,t3] count != 1"c); ok := 0;
    } else { PrintLn("PASS: TemporalQuery [t3,t3] count=1"c); }

    // Query tsFrom > tsTo → 0
    var tcnt3: int64 := GraphTemporalIndexQuery(tidx, t3, t1, tbuf, 10);
    if (tcnt3 != 0) {
        PrintLn("FAIL: TemporalQuery from>to should=0"c); ok := 0;
    } else { PrintLn("PASS: TemporalQuery from>to=0"c); }

    // Query leer → 0 bei leerem Result-Fenster
    var tcnt4: int64 := GraphTemporalIndexQuery(tidx, 9999, 99999, tbuf, 10);
    if (tcnt4 != 0) {
        PrintLn("FAIL: TemporalQuery outside range should=0"c); ok := 0;
    } else { PrintLn("PASS: TemporalQuery outside=0"c); }
    free(tbuf, 10 * 8);

    GraphTemporalIndexFree(tidx);
    free(tidx, GTIDX_SIZE);

    // ── TypeIndex ─────────────────────────────────────────────
    var xidx: int64 := alloc(GXIDX_SIZE);
    GraphTypeIndexInit(xidx);
    GraphTypeIndexBuild(xidx, s);
    PrintLn("PASS: TypeIndexBuild no crash"c);

    // "KNOWS" → E1, E3
    var xbuf: int64 := alloc(10 * 8);
    var xcnt: int64 := GraphTypeIndexQuery(xidx, "KNOWS"c, 5, xbuf, 10);
    if (xcnt != 2) {
        PrintLn("FAIL: TypeQuery KNOWS count != 2"c); ok := 0;
    } else { PrintLn("PASS: TypeQuery KNOWS count=2"c); }

    // "LIKES" → E2
    var xcnt2: int64 := GraphTypeIndexQuery(xidx, "LIKES"c, 5, xbuf, 10);
    if (xcnt2 != 1) {
        PrintLn("FAIL: TypeQuery LIKES count != 1"c); ok := 0;
    } else { PrintLn("PASS: TypeQuery LIKES count=1"c); }

    // Unknown type → 0
    var xcnt3: int64 := GraphTypeIndexQuery(xidx, "UNKNOWN"c, 7, xbuf, 10);
    if (xcnt3 != 0) {
        PrintLn("FAIL: TypeQuery UNKNOWN should=0"c); ok := 0;
    } else { PrintLn("PASS: TypeQuery UNKNOWN=0"c); }
    free(xbuf, 10 * 8);

    GraphTypeIndexFree(xidx);
    free(xidx, GXIDX_SIZE);

    // ── VectorIndex ───────────────────────────────────────────
    // Add vectors: store as plain int64 values (VectorIndex uses integer dot products)
    // nA: {1, 0} — unit x
    // nB: {0, 1} — unit y (orthogonal to x)
    // nC: {3, 4} — partial x (mag=5), cosine with {1,0} = 3/5 → score 600000
    var vbuf: int64 := alloc(2 * 8);
    poke64(vbuf,     1);
    poke64(vbuf + 8, 0);
    GraphNodeSetVec(nA, 2, vbuf);

    poke64(vbuf,     0);
    poke64(vbuf + 8, 1);
    GraphNodeSetVec(nB, 2, vbuf);

    poke64(vbuf,     3);
    poke64(vbuf + 8, 4);
    GraphNodeSetVec(nC, 2, vbuf);
    free(vbuf, 2 * 8);

    var vidx: int64 := alloc(GVIDX_SIZE);
    GraphVectorIndexInit(vidx, 2);
    GraphVectorIndexBuild(vidx, s);
    PrintLn("PASS: VectorIndexBuild no crash"c);

    // Query {1, 0}: nA score=1000000 (identical), nC score=600000 (dot=3/mag=5), nB score=0
    var qvec: int64 := alloc(2 * 8);
    poke64(qvec,     1);
    poke64(qvec + 8, 0);

    var nodeIds: int64 := alloc(10 * 8);
    var scores:  int64 := alloc(10 * 8);
    var vcnt: int64 := GraphVectorIndexSearch(vidx, qvec, 3, nodeIds, scores);

    if (vcnt != 3) {
        PrintLn("FAIL: VectorSearch topK=3 count != 3"c); ok := 0;
    } else { PrintLn("PASS: VectorSearch count=3"c); }

    // First result should have score 1000000 (identical to nA)
    var sc0: int64 := peek64(scores);
    if (sc0 != 1000000) {
        PrintLn("FAIL: VectorSearch top score != 1000000"c); ok := 0;
    } else { PrintLn("PASS: VectorSearch top score=1000000"c); }

    // Scores descending
    var sc1: int64 := peek64(scores + 8);
    var sc2: int64 := peek64(scores + 16);
    if (sc0 < sc1) {
        PrintLn("FAIL: VectorSearch scores not descending [0]>[1]"c); ok := 0;
    } else { PrintLn("PASS: VectorSearch scores desc [0]>=[1]"c); }
    if (sc1 < sc2) {
        PrintLn("FAIL: VectorSearch scores not descending [1]>[2]"c); ok := 0;
    } else { PrintLn("PASS: VectorSearch scores desc [1]>=[2]"c); }

    // nB score should be 0 (orthogonal)
    // nC: dot(q={1,0}, n={3,4})=3, |q|=1, |n|=5, score=3*1000000/5=600000
    if (sc2 != 0) {
        PrintLn("FAIL: VectorSearch orthogonal score != 0"c); ok := 0;
    } else { PrintLn("PASS: VectorSearch orthogonal score=0"c); }

    // topK larger than count → returns all
    var vcnt2: int64 := GraphVectorIndexSearch(vidx, qvec, 10, nodeIds, scores);
    if (vcnt2 != 3) {
        PrintLn("FAIL: VectorSearch topK>count should return count"c); ok := 0;
    } else { PrintLn("PASS: VectorSearch topK>count=3"c); }

    free(qvec, 2 * 8);
    free(nodeIds, 10 * 8);
    free(scores, 10 * 8);

    GraphVectorIndexFree(vidx);
    free(vidx, GVIDX_SIZE);

    // Empty store index → no crash
    var s2: int64 := alloc(GMEM_SIZE);
    GraphMemStoreInit(s2);
    var tidx2: int64 := alloc(GTIDX_SIZE);
    GraphTemporalIndexInit(tidx2);
    GraphTemporalIndexBuild(tidx2, s2);
    var tbuf2: int64 := alloc(8);
    var tc5: int64 := GraphTemporalIndexQuery(tidx2, 0, 9999999, tbuf2, 1);
    if (tc5 != 0) {
        PrintLn("FAIL: empty store TemporalQuery should=0"c); ok := 0;
    } else { PrintLn("PASS: empty store TemporalQuery=0"c); }
    free(tbuf2, 8);
    GraphTemporalIndexFree(tidx2);
    free(tidx2, GTIDX_SIZE);
    GraphMemStoreFree(s2);
    free(s2, GMEM_SIZE);

    // Cleanup main store
    GraphMemStoreFree(s);
    free(s, GMEM_SIZE);

    if (ok != 0) {
        PrintLn("=== WP-GRP-05: ALL PASS ==="c);
    } else {
        PrintLn("=== WP-GRP-05: FAILURES ==="c);
    }
    return ok;
}
