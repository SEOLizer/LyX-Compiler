// tests/thread_concurrency_test.lyx — echte Nebenläufigkeit (Issue #992).
//
// Bis zur Behebung startete ThreadCreate keinen brauchbaren Kindthread:
// `func` und `arg` lagen in dessen Frame, und clone(2) garantiert über
// CLONE_VM zwar den geteilten Adressraum, nicht aber die LEBENSDAUER des
// Frames. Sobald ThreadCreate zurückkehrte, wurde der Speicher wiederverwendet
// — ein direkt folgendes ThreadJoin genügte — und der Kindthread sprang auf
// einen überschriebenen Funktionszeiger. Ohne Frame-Wiederverwendung lief es
// zufällig durch, mit Join segfaultete es.
//
// Zweiter Teil desselben Defekts: CLONE_CHILD_SETTID schreibt die TID erst,
// wenn der Kindthread zum ersten Mal läuft. Der Elternprozess las den Slot
// direkt nach clone und fand die selbst geschriebene 0 — ThreadJoin hielt den
// Thread für beendet und kehrte sofort zurück.
//
// Dieser Test ist zugleich der Nachweis, dass die Atomics wirken: vier Threads
// erhöhen denselben Zähler je NITER-mal. Mit einem echten `lock xadd` ist das
// Ergebnis exakt 4*NITER; mit der früheren peek64/poke64-Fassung gingen
// Zuwächse verloren. Der zweite Zähler wird bewusst NICHT-atomar erhöht — dort
// muss allein der Mutex die Korrektheit herstellen.

import std.thread;
import std.io;

con NITER: int64 := 50000;

pub var tct_counter: Atomic;   // atomar erhöht
pub var tct_plain:   Atomic;   // nicht-atomar erhöht, nur durch Mutex geschützt
pub var tct_lock:    Mutex;

fn tctBumpAtomic(arg: int64): int64 {
  var i: int64 := 0;
  while (i < NITER) {
    AtomicAdd(tct_counter, 1);
    i := i + 1;
  }
  return 0;
}

fn tctBumpLocked(arg: int64): int64 {
  var i: int64 := 0;
  while (i < NITER) {
    MutexLock(tct_lock);
    // Bewusst als Lesen-Ändern-Schreiben: die Korrektheit muss vom Mutex kommen.
    AtomicStore(tct_plain, AtomicLoad(tct_plain) + 1);
    MutexUnlock(tct_lock);
    i := i + 1;
  }
  return 0;
}

fn main(): int64 {
  var expected: int64 := 4 * NITER;

  tct_counter := AtomicNew(0);
  tct_plain   := AtomicNew(0);
  tct_lock    := MutexNew();

  // --- Atomics unter echter Nebenläufigkeit ---------------------------
  var a0: Thread := ThreadCreate(tctBumpAtomic, 0);
  var a1: Thread := ThreadCreate(tctBumpAtomic, 0);
  var a2: Thread := ThreadCreate(tctBumpAtomic, 0);
  var a3: Thread := ThreadCreate(tctBumpAtomic, 0);
  if (a0.handle == 0) { PrintLn("FAIL ThreadCreate lieferte kein Handle"); return 1; }
  ThreadJoin(a0); ThreadJoin(a1); ThreadJoin(a2); ThreadJoin(a3);

  var got: int64 := AtomicLoad(tct_counter);
  if (got != expected) {
    Print("FAIL AtomicAdd: erwartet "); Print(expected);
    Print(", erhalten "); PrintLn(got);
    return 2;
  }

  // --- Mutex schließt wirklich aus -------------------------------------
  var b0: Thread := ThreadCreate(tctBumpLocked, 0);
  var b1: Thread := ThreadCreate(tctBumpLocked, 0);
  var b2: Thread := ThreadCreate(tctBumpLocked, 0);
  var b3: Thread := ThreadCreate(tctBumpLocked, 0);
  ThreadJoin(b0); ThreadJoin(b1); ThreadJoin(b2); ThreadJoin(b3);

  var gotM: int64 := AtomicLoad(tct_plain);
  if (gotM != expected) {
    Print("FAIL Mutex: erwartet "); Print(expected);
    Print(", erhalten "); PrintLn(gotM);
    return 3;
  }

  // --- Thread-Argument kommt an ----------------------------------------
  AtomicStore(tct_counter, 0);
  var c0: Thread := ThreadCreate(tctBumpAtomic, 0);
  ThreadJoin(c0);
  if (AtomicLoad(tct_counter) != NITER) {
    PrintLn("FAIL einzelner Thread nach Wiederverwendung des Handoff-Blocks");
    return 4;
  }

  AtomicFree(tct_counter);
  AtomicFree(tct_plain);
  MutexFree(tct_lock);
  PrintLn("threads: alle Pruefungen bestanden");
  return 42;
}
