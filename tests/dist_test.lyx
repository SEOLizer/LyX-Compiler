// tests/dist_test.lyx
// Selbstpruefende Testbatterie fuer std.dist.
//
// Sollwerte aus numpy. Dazu strukturelle Pruefungen, die fuer JEDE Metrik
// gelten muessen und keine fremde Zahl brauchen: d(a,a) = 0, Symmetrie
// d(a,b) = d(b,a), und die Dreiecksungleichung d(a,c) <= d(a,b) + d(b,c).
// Sie treffen Vorzeichen- und Indexfehler, die einzelne Zahlenwerte
// durchlassen — und beim Kosinus-Abstand zeigen sie, dass er die
// Dreiecksungleichung eben NICHT erfuellt.

unit main;

import std.dist;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn TOL(): f64 { return 0.0000000001; }

fn Check(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > tol) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" (bool)\n"c);
  }
}

fn V3(p: int64, x: f64, y: f64, z: f64): void {
  pokef64(p, x);
  pokef64(p + 8, y);
  pokef64(p + 16, z);
}

fn main(): int64 {
  // ── Hypotenuse ────────────────────────────────────────────────────────────
  Check("hypot34"c, DistHypot(3.0, 4.0), 5.0, TOL());
  Check("hypotNeg"c, DistHypot(0.0 - 3.0, 4.0), 5.0, TOL());
  Check("hypotZero"c, DistHypot(0.0, 0.0), 0.0, TOL());
  Check("hypotOneZero"c, DistHypot(5.0, 0.0), 5.0, TOL());
  Check("hypotSym"c, DistHypot(3.0, 4.0), DistHypot(4.0, 3.0), TOL());
  Check("hypot3"c, DistHypot3(1.0, 2.0, 2.0), 3.0, TOL());
  Check("hypot3Zero"c, DistHypot3(0.0, 0.0, 0.0), 0.0, TOL());
  Check("hypot3Neg"c, DistHypot3(0.0 - 1.0, 2.0, 0.0 - 2.0), 3.0, TOL());

  // Der Grund fuer diese Funktion: die naive Formel scheitert hier.
  // 1e180 wird durch Multiplikation aufgebaut, weil das Literal den Parser
  // ueberfordern wuerde.
  var big: f64 := 1.0;
  var i: int64 := 0;
  while (i < 180) {
    big := big * 10.0;
    i := i + 1;
  }
  var small: f64 := 1.0;
  i := 0;
  while (i < 180) {
    small := small / 10.0;
    i := i + 1;
  }

  var sqrt2: f64 := SqrtF64(2.0);
  // hypot(t,t) = t*sqrt(2); geprueft wird der Quotient, weil sich die
  // Groessenordnung sonst nicht ausgeben laesst
  Check("hypotHuge"c, DistHypot(big, big) / big, sqrt2, 0.0000001);
  Check("hypotTiny"c, DistHypot(small, small) / small, sqrt2, 0.0000001);
  Check("hypot3Huge"c, DistHypot3(big, big, big) / big, SqrtF64(3.0), 0.0000001);
  // zum Vergleich: so sieht es naiv aus
  var naiveHuge: f64 := SqrtF64(big * big + big * big);
  CheckB("naiveOverflows"c, naiveHuge > big * 1000000.0, true);
  var naiveTiny: f64 := SqrtF64(small * small + small * small);
  CheckB("naiveUnderflows"c, naiveTiny == 0.0, true);

  // ── Euklidischer Abstand ──────────────────────────────────────────────────
  var a: int64 := alloc(3 * 8);
  var b: int64 := alloc(3 * 8);
  var c: int64 := alloc(3 * 8);
  V3(a, 1.0, 2.0, 3.0);
  V3(b, 4.0, 6.0, 3.0);

  Check("euclid"c, DistEuclid(a, b, 3), 5.0, TOL());
  Check("euclidSq"c, DistEuclidSq(a, b, 3), 25.0, TOL());
  Check("euclidSelf"c, DistEuclid(a, a, 3), 0.0, TOL());
  Check("euclidSym"c, DistEuclid(a, b, 3), DistEuclid(b, a, 3), TOL());
  Check("euclidDim0"c, DistEuclid(a, b, 0), 0.0, TOL());
  Check("euclidDim1"c, DistEuclid(a, b, 1), 3.0, TOL());

  // auch hier: skaliert gerechnet, also kein Ueberlauf
  var ha: int64 := alloc(2 * 8);
  var hb: int64 := alloc(2 * 8);
  pokef64(ha, big);        pokef64(ha + 8, big);
  pokef64(hb, 0.0);        pokef64(hb + 8, 0.0);
  Check("euclidHuge"c, DistEuclid(ha, hb, 2) / big, sqrt2, 0.0000001);
  free(ha, 2 * 8);  free(hb, 2 * 8);

  Check("norm"c, DistNorm(a, 3), SqrtF64(14.0), TOL());
  Check("normSq"c, DistNormSq(a, 3), 14.0, TOL());
  Check("normZeroDim"c, DistNorm(a, 0), 0.0, TOL());

  // ── Andere Metriken (numpy) ───────────────────────────────────────────────
  Check("manhattan"c, DistManhattan(a, b, 3), 7.0, TOL());
  Check("chebyshev"c, DistChebyshev(a, b, 3), 4.0, TOL());
  Check("minkowski3"c, DistMinkowski(a, b, 3, 3.0), 4.497941445275415, 0.0000001);

  // Minkowski enthaelt die anderen als Sonderfaelle — das ist der Test, der
  // beweist, dass die Verallgemeinerung stimmt
  Check("minkowskiIsManhattan"c, DistMinkowski(a, b, 3, 1.0),
        DistManhattan(a, b, 3), 0.0000001);
  Check("minkowskiIsEuclid"c, DistMinkowski(a, b, 3, 2.0),
        DistEuclid(a, b, 3), 0.0000001);
  // fuer grosses p naehert er sich Chebyshev
  Check("minkowskiTowardsCheb"c, DistMinkowski(a, b, 3, 60.0),
        DistChebyshev(a, b, 3), 0.01);
  Check("minkowskiBadP"c, DistMinkowski(a, b, 3, 0.0), 0.0, TOL());

  // ── Metrikeigenschaften ───────────────────────────────────────────────────
  // Diese drei muessen fuer jede echte Metrik gelten.
  V3(c, 0.0 - 2.0, 5.0, 1.0);

  Check("identEuclid"c, DistEuclid(a, a, 3), 0.0, TOL());
  Check("identManhattan"c, DistManhattan(a, a, 3), 0.0, TOL());
  Check("identChebyshev"c, DistChebyshev(a, a, 3), 0.0, TOL());

  Check("symManhattan"c, DistManhattan(a, c, 3), DistManhattan(c, a, 3), TOL());
  Check("symChebyshev"c, DistChebyshev(a, c, 3), DistChebyshev(c, a, 3), TOL());

  var eAC: f64 := DistEuclid(a, c, 3);
  var eAB: f64 := DistEuclid(a, b, 3);
  var eBC: f64 := DistEuclid(b, c, 3);
  var triEuclid: bool := eAC <= eAB + eBC + 0.0000001;
  CheckB("triangleEuclid"c, triEuclid, true);

  var mAC: f64 := DistManhattan(a, c, 3);
  var mAB: f64 := DistManhattan(a, b, 3);
  var mBC: f64 := DistManhattan(b, c, 3);
  var triManhattan: bool := mAC <= mAB + mBC + 0.0000001;
  CheckB("triangleManhattan"c, triManhattan, true);

  var cAC: f64 := DistChebyshev(a, c, 3);
  var cAB: f64 := DistChebyshev(a, b, 3);
  var cBC: f64 := DistChebyshev(b, c, 3);
  var triCheb: bool := cAC <= cAB + cBC + 0.0000001;
  CheckB("triangleChebyshev"c, triCheb, true);

  // Chebyshev <= Euklid <= Manhattan gilt immer
  CheckB("chebLeEuclid"c, cAC <= eAC + 0.0000001, true);
  CheckB("euclidLeManhattan"c, eAC <= mAC + 0.0000001, true);

  // ── Winkelmasse ───────────────────────────────────────────────────────────
  Check("cosineSim"c, DistCosineSimilarity(a, b, 3), 0.8554823885364436, 0.0000001);
  Check("cosineDist"c, DistCosine(a, b, 3), 1.0 - 0.8554823885364436, 0.0000001);
  Check("cosineSelf"c, DistCosineSimilarity(a, a, 3), 1.0, 0.0000001);

  // Skaleninvarianz: der Kosinus misst nur die Richtung
  var a2: int64 := alloc(3 * 8);
  V3(a2, 100.0, 200.0, 300.0);
  Check("cosineScaleInvariant"c, DistCosineSimilarity(a2, b, 3),
        DistCosineSimilarity(a, b, 3), 0.0000001);
  // der euklidische Abstand ist es NICHT — das ist der Unterschied
  CheckB("euclidNotScaleInvariant"c,
         AbsF64(DistEuclid(a2, b, 3) - DistEuclid(a, b, 3)) > 1.0, true);

  // orthogonal und entgegengesetzt
  var ox: int64 := alloc(3 * 8);
  var oy: int64 := alloc(3 * 8);
  V3(ox, 1.0, 0.0, 0.0);
  V3(oy, 0.0, 1.0, 0.0);
  Check("cosineOrthogonal"c, DistCosineSimilarity(ox, oy, 3), 0.0, TOL());
  V3(oy, 0.0 - 1.0, 0.0, 0.0);
  Check("cosineOpposite"c, DistCosineSimilarity(ox, oy, 3), -1.0, TOL());
  // Nullvektor hat keine Richtung
  V3(oy, 0.0, 0.0, 0.0);
  Check("cosineZeroVec"c, DistCosineSimilarity(ox, oy, 3), 0.0, TOL());

  V3(oy, 0.0, 1.0, 0.0);
  Check("angular90"c, DistAngular(ox, oy, 3), 1.5707963267948966, 0.0000001);
  Check("angular0"c, DistAngular(ox, ox, 3), 0.0, 0.0000001);
  free(ox, 3 * 8);  free(oy, 3 * 8);  free(a2, 3 * 8);

  // ── Diskrete Masse ────────────────────────────────────────────────────────
  var ia: int64 := alloc(5 * 8);
  var ib: int64 := alloc(5 * 8);
  poke64(ia, 1);      poke64(ia + 8, 2);  poke64(ia + 16, 3);
  poke64(ia + 24, 4); poke64(ia + 32, 5);
  poke64(ib, 1);      poke64(ib + 8, 9);  poke64(ib + 16, 3);
  poke64(ib + 24, 9); poke64(ib + 32, 5);
  CheckI("hamming"c, DistHamming(ia, ib, 5), 2);
  CheckI("hammingSelf"c, DistHamming(ia, ia, 5), 0);

  CheckI("hammingBits0"c, DistHammingBits(0, 0), 0);
  CheckI("hammingBits1"c, DistHammingBits(0, 1), 1);
  CheckI("hammingBits3"c, DistHammingBits(7, 0), 3);
  CheckI("hammingBitsMix"c, DistHammingBits(255, 15), 4);
  // ein negativer Wert hat das oberste Bit gesetzt
  CheckI("hammingBitsNeg"c, DistHammingBits(0, 0 - 1), 64);

  // Jaccard: {1,2,3} gegen {2,3,4} -> Schnitt 2, Vereinigung 4 -> 1 - 0.5
  var ja: int64 := alloc(4 * 8);
  var jb: int64 := alloc(4 * 8);
  poke64(ja, 1);  poke64(ja + 8, 1);  poke64(ja + 16, 1);  poke64(ja + 24, 0);
  poke64(jb, 0);  poke64(jb + 8, 1);  poke64(jb + 16, 1);  poke64(jb + 24, 1);
  Check("jaccard"c, DistJaccard(ja, jb, 4), 0.5, TOL());
  Check("jaccardSelf"c, DistJaccard(ja, ja, 4), 0.0, TOL());
  // zwei leere Mengen gelten als gleich
  poke64(ja, 0);  poke64(ja + 8, 0);  poke64(ja + 16, 0);  poke64(ja + 24, 0);
  poke64(jb, 0);  poke64(jb + 8, 0);  poke64(jb + 16, 0);  poke64(jb + 24, 0);
  Check("jaccardEmpty"c, DistJaccard(ja, jb, 4), 0.0, TOL());
  free(ia, 5 * 8);  free(ib, 5 * 8);  free(ja, 4 * 8);  free(jb, 4 * 8);

  // ── Nachbarsuche ──────────────────────────────────────────────────────────
  // vier Punkte in der Ebene
  var set: int64 := alloc(4 * 2 * 8);
  pokef64(set,       0.0);  pokef64(set +  8, 0.0);    // (0,0)
  pokef64(set + 16, 10.0);  pokef64(set + 24, 0.0);    // (10,0)
  pokef64(set + 32,  3.0);  pokef64(set + 40, 4.0);    // (3,4)
  pokef64(set + 48,  0.0);  pokef64(set + 56, 1.0);    // (0,1)

  var q: int64 := alloc(2 * 8);
  pokef64(q, 0.0);  pokef64(q + 8, 0.0);
  var od: int64 := alloc(8);

  // naechster ist der Punkt selbst (Index 0, Abstand 0)
  CheckI("nearestSelf"c, DistNearest(q, set, 4, 2, od), 0);
  var d0: f64 := peekf64(od);
  Check("nearestSelfDist"c, d0, 0.0, TOL());

  // von (0,2) aus ist (0,1) der naechste
  pokef64(q, 0.0);  pokef64(q + 8, 2.0);
  CheckI("nearest"c, DistNearest(q, set, 4, 2, od), 3);
  var d1: f64 := peekf64(od);
  Check("nearestDist"c, d1, 1.0, TOL());

  // der weiteste von (0,0) ist (10,0)
  pokef64(q, 0.0);  pokef64(q + 8, 0.0);
  CheckI("farthest"c, DistFarthest(q, set, 4, 2, od), 1);
  var d2: f64 := peekf64(od);
  Check("farthestDist"c, d2, 10.0, TOL());
  CheckI("nearestEmpty"c, DistNearest(q, set, 0, 2, od), -1);

  // Abstandsmatrix: symmetrisch, Nullen auf der Diagonale
  var dm: int64 := alloc(16 * 8);
  CheckB("matrixOk"c, DistMatrix(set, 4, 2, dm), true);
  Check("matrixDiag"c, peekf64(dm), 0.0, TOL());
  Check("matrixDiag3"c, peekf64(dm + (3 * 4 + 3) * 8), 0.0, TOL());
  // (0,0) nach (3,4) ist 5
  Check("matrix02"c, peekf64(dm + (0 * 4 + 2) * 8), 5.0, TOL());
  // symmetrisch
  Check("matrixSym"c, peekf64(dm + (2 * 4 + 0) * 8),
        peekf64(dm + (0 * 4 + 2) * 8), TOL());
  // (10,0) nach (3,4) ist sqrt(49+16)
  Check("matrix12"c, peekf64(dm + (1 * 4 + 2) * 8), SqrtF64(65.0), TOL());
  free(dm, 16 * 8);

  // Schwerpunkt: Mittel der vier Punkte
  var cen: int64 := alloc(2 * 8);
  CheckB("centroidOk"c, DistCentroid(set, 4, 2, cen), true);
  Check("centroidX"c, peekf64(cen), 3.25, TOL());
  Check("centroidY"c, peekf64(cen + 8), 1.25, TOL());
  CheckB("centroidEmpty"c, DistCentroid(set, 0, 2, cen), false);
  free(cen, 2 * 8);

  // Umkreispruefung ohne Wurzel
  pokef64(q, 0.0);  pokef64(q + 8, 0.0);
  CheckB("within5"c, DistWithin(q, set + 32, 2, 5.0), true);
  CheckB("within4"c, DistWithin(q, set + 32, 2, 4.9), false);
  CheckB("withinNegRadius"c, DistWithin(q, set, 2, 0.0 - 1.0), false);
  CheckB("withinZeroRadius"c, DistWithin(q, set, 2, 0.0), true);

  free(set, 4 * 2 * 8);  free(q, 2 * 8);  free(od, 8);
  free(a, 3 * 8);  free(b, 3 * 8);  free(c, 3 * 8);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
