// tests/cf_demo3_d1.lyx — Demo 3: D1 Edge Database CRUD
// WP-CF-16

unit tests.cf_demo3_d1;

import std.cloud.cf.credentials;
import std.cloud.cf.transport;
import std.cloud.cf.d1;
import std.io;
import std.alloc;

pub fn main(argc: int64, argv: int64): int64 {
    var creds: CFCredentials := CFCredentialsFromEnv();
    var c: CFClient;
    c.authType:=creds.authType; c.token:=creds.token; c.apiKey:=creds.apiKey;
    c.email:=creds.email; c.accountId:=creds.accountId; c.zoneId:=creds.zoneId;
    c.timeout:=30000; c.maxRetries:=3;

    if (c.authType == 0) {
        PrintLn("Error: set CF_AUTH_TOKEN and CF_ACCOUNT_ID"c); return 1;
    }

    var accountId: pchar := creds.accountId as pchar;
    PrintLn("=== CF Demo 3: D1 Edge Database ==="c);

    // Create database
    Print("Creating D1 database 'app-db'..."c);
    var db: CFD1Database := D1Create(c, accountId, "app-db"c);
    if (db.uuid == 0) { PrintLn(" FAILED"c); return 1; }
    PrintLn(" OK"c);
    Print("DB UUID: "c); PrintLn(db.uuid as pchar);

    var dbId: pchar := db.uuid as pchar;

    // Create table
    Print("Creating users table..."c);
    var cr: D1Result := D1Exec(c, accountId, dbId,
        "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL)"c);
    if (cr.success == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }
    D1ResultFree(cr);

    // Batch insert
    Print("Batch inserting 2 users..."c);
    var s1: D1Statement;
    s1.sql := "INSERT INTO users VALUES (?,?,?)"c as int64;
    s1.params := "[1,\"Alice\",\"alice@example.com\"]"c as int64;
    s1.paramCount := 3;
    var s2: D1Statement;
    s2.sql := "INSERT INTO users VALUES (?,?,?)"c as int64;
    s2.params := "[2,\"Bob\",\"bob@example.com\"]"c as int64;
    s2.paramCount := 3;
    var stmts: int64 := alloc(48);
    // Copy s1 and s2 structs into stmts buffer (3 fields * 8 bytes = 24 bytes each)
    poke64(stmts,    s1.sql);    poke64(stmts+8,  s1.params); poke64(stmts+16, s1.paramCount);
    poke64(stmts+24, s2.sql);    poke64(stmts+32, s2.params); poke64(stmts+40, s2.paramCount);
    var batchResult: int64 := D1Batch(c, accountId, dbId, stmts, 2);
    free(stmts, 48);
    if (batchResult != 0) {
        PrintLn(" OK"c);
        free(batchResult, StrLen(batchResult as pchar)+1);
    } else { PrintLn(" FAILED"c); }

    // Query single user
    Print("Querying user id=1..."c);
    var qr: D1Result := D1Query(c, accountId, dbId,
        "SELECT * FROM users WHERE id=?"c,
        "[1]"c, 1);
    if (qr.success == 1 && qr.results != 0) {
        PrintLn(" OK"c);
        var name: int64 := D1ResultGetString(qr, 0, "name"c);
        var email: int64 := D1ResultGetString(qr, 0, "email"c);
        if (name != 0) { Print("  name:  "c); PrintLn(name as pchar); free(name, StrLen(name as pchar)+1); }
        if (email != 0) { Print("  email: "c); PrintLn(email as pchar); free(email, StrLen(email as pchar)+1); }
    } else { PrintLn(" FAILED"c); }
    D1ResultFree(qr);

    // Count all users
    Print("Counting users..."c);
    var count: D1Result := D1Exec(c, accountId, dbId, "SELECT COUNT(*) as cnt FROM users"c);
    if (count.success == 1) {
        var n: int64 := D1ResultGetInt(count, 0, "cnt"c);
        Print(" count="c);
        var nbuf: int64 := alloc(16);
        Int64ToStr(n, nbuf);
        PrintLn(nbuf as pchar); free(nbuf, 16);
    } else { PrintLn(" FAILED"c); }
    D1ResultFree(count);

    // List tables
    Print("Tables: "c);
    var tables: int64 := D1Tables(c, accountId, dbId);
    if (tables != 0) { PrintLn(tables as pchar); free(tables, StrLen(tables as pchar)+1); }
    else { PrintLn("[none]"c); }

    // Schema
    Print("Schema for users: "c);
    var schema: int64 := D1Schema(c, accountId, dbId, "users"c);
    if (schema != 0) { PrintLn(schema as pchar); free(schema, StrLen(schema as pchar)+1); }
    else { PrintLn("[not found]"c); }

    CFD1DatabaseFree(db);
    PrintLn("Done."c);
    return 0;
}
