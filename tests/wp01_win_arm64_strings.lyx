// WP-01: Windows ARM64 string builtins — StrSub / StrConcat / StrCopy
// Verifies that StrSub, StrConcat, and StrCopy produce correct results.
import std.io;
import std.string;

fn main(): int64 {
  var hello: pchar := "Hello, World!";
  var sub: pchar := StrSub(hello, 7, 5);
  PrintLn(sub);

  var a: pchar := "Hello";
  var b: pchar := ", ARM64!";
  var cat: pchar := StrConcat(a, b);
  PrintLn(cat);

  var src: pchar := "Copy me!";
  var cpy: pchar := StrCopy(src);
  PrintLn(cpy);

  return 0;
}
