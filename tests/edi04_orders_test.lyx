// tests/edi04_orders_test.lyx — EDI-04: ORDERS + ORDRSP + ORDCHG tests

unit tests.edi04_orders_test;

import std.edi.core;
import std.edi.orders;
import std.alloc;
import std.io;

fn hasTag(buf: int64, bufLen: int64, t0: int64, t1: int64, t2: int64): int64 {
    var i: int64 := 0;
    while (i + 2 < bufLen) {
        if (peek8(buf+i) == t0 && peek8(buf+i+1) == t1 && peek8(buf+i+2) == t2) {
            return 1;
        }
        i := i + 1;
    }
    return 0;
}

fn memEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
        if (peek8(a+i) != peek8(b+i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Test 1: EdiOrdersWrite with missing order number → returns -1
    // -------------------------------------------------------------------------
    var badHdr: int64 := alloc(EDI_ORDER_HDR_SIZE);
    var zi1: int64 := 0;
    while (zi1 < EDI_ORDER_HDR_SIZE) { poke8(badHdr + zi1, 0); zi1 := zi1 + 1; }
    var outBad: int64 := alloc(512);
    var wBad: int64 := EdiOrdersWrite(badHdr, 0, 0, outBad, 512);
    if (wBad != (0 - 1)) {
        PrintLn("FAIL: EdiOrdersWrite(null orderNum) should return -1"c); ok := 0;
    } else { PrintLn("PASS: EdiOrdersWrite(null orderNum) returns -1"c); }
    free(outBad, 512);
    free(badHdr, EDI_ORDER_HDR_SIZE);

    // -------------------------------------------------------------------------
    // Tests 2-4: ORDERS write + read round-trip (orderNum, GTIN, price)
    // -------------------------------------------------------------------------
    var orderNum: pchar := "PO001"c;
    var orderDate: pchar := "20260615"c;
    var buyerGLN: pchar := "4012345000001"c;
    var supGLN:   pchar := "4012345000002"c;
    var delivGLN: pchar := "4012345000003"c;
    var invGLN:   pchar := "4012345000004"c;
    var gtinA: pchar := "4006381333931"c;
    var gtinB: pchar := "01234565"c;
    var unitPCE: pchar := "PCE"c;

    var hdr: int64 := alloc(EDI_ORDER_HDR_SIZE);
    var hdrZi: int64 := 0;
    while (hdrZi < EDI_ORDER_HDR_SIZE) { poke8(hdr + hdrZi, 0); hdrZi := hdrZi + 1; }
    poke64(hdr + EDI_ORDER_HDR_NUM,        orderNum as int64);
    poke64(hdr + EDI_ORDER_HDR_NUMLEN,     5);
    poke64(hdr + EDI_ORDER_HDR_DATE,       orderDate as int64);
    poke64(hdr + EDI_ORDER_HDR_DATELEN,    8);
    poke64(hdr + EDI_ORDER_HDR_BUYER_GLN,  buyerGLN as int64);
    poke64(hdr + EDI_ORDER_HDR_BUYER_GLNL, 13);
    poke64(hdr + EDI_ORDER_HDR_SUP_GLN,    supGLN as int64);
    poke64(hdr + EDI_ORDER_HDR_SUP_GLNL,   13);
    poke64(hdr + EDI_ORDER_HDR_DELIV_GLN,  delivGLN as int64);
    poke64(hdr + EDI_ORDER_HDR_DELIV_GLNL, 13);
    poke64(hdr + EDI_ORDER_HDR_INV_GLN,    invGLN as int64);
    poke64(hdr + EDI_ORDER_HDR_INV_GLNL,   13);

    // 2 line items
    var lines: int64 := alloc(2 * EDI_ORDER_LINE_SIZE);
    var la: int64 := lines + 0 * EDI_ORDER_LINE_SIZE;
    var lb: int64 := lines + 1 * EDI_ORDER_LINE_SIZE;

    poke64(la + EDI_ORDER_LINE_GTIN,    gtinA as int64);
    poke64(la + EDI_ORDER_LINE_GTINLEN, 13);
    poke64(la + EDI_ORDER_LINE_QTY,     10);
    poke64(la + EDI_ORDER_LINE_UNIT,    unitPCE as int64);
    poke64(la + EDI_ORDER_LINE_UNITLEN, 3);
    poke64(la + EDI_ORDER_LINE_PRICE,   1999);
    poke64(la + EDI_ORDER_LINE_TAXRATE, 1900);
    poke64(la + EDI_ORDER_LINE_DATE,    0);
    poke64(la + EDI_ORDER_LINE_STATUS,  0);
    poke64(la + EDI_ORDER_LINE_LINENO,  1);

    poke64(lb + EDI_ORDER_LINE_GTIN,    gtinB as int64);
    poke64(lb + EDI_ORDER_LINE_GTINLEN, 8);
    poke64(lb + EDI_ORDER_LINE_QTY,     5);
    poke64(lb + EDI_ORDER_LINE_UNIT,    unitPCE as int64);
    poke64(lb + EDI_ORDER_LINE_UNITLEN, 3);
    poke64(lb + EDI_ORDER_LINE_PRICE,   3500);
    poke64(lb + EDI_ORDER_LINE_TAXRATE, 700);
    poke64(lb + EDI_ORDER_LINE_DATE,    0);
    poke64(lb + EDI_ORDER_LINE_STATUS,  0);
    poke64(lb + EDI_ORDER_LINE_LINENO,  2);

    var out2: int64 := alloc(2048);
    var w2: int64 := EdiOrdersWrite(hdr, lines, 2, out2, 2048);
    if (w2 <= 0) { PrintLn("FAIL: EdiOrdersWrite returned <= 0"c); ok := 0; }
    else          { PrintLn("PASS: EdiOrdersWrite returned bytes"c); }
    if (hasTag(out2, w2, 66, 71, 77) != 1) {    // BGM
        PrintLn("FAIL: ORDERS missing BGM"c); ok := 0;
    } else { PrintLn("PASS: ORDERS has BGM"c); }
    if (hasTag(out2, w2, 78, 65, 68) != 1) {    // NAD
        PrintLn("FAIL: ORDERS missing NAD"c); ok := 0;
    } else { PrintLn("PASS: ORDERS has NAD"c); }
    if (hasTag(out2, w2, 84, 65, 88) != 1) {    // TAX
        PrintLn("FAIL: ORDERS missing TAX"c); ok := 0;
    } else { PrintLn("PASS: ORDERS has TAX"c); }
    if (hasTag(out2, w2, 77, 79, 65) != 1) {    // MOA
        PrintLn("FAIL: ORDERS missing MOA"c); ok := 0;
    } else { PrintLn("PASS: ORDERS has MOA"c); }

    // -------------------------------------------------------------------------
    // Test 5: EdiOrdersRead — orderNum, all 4 NAD roles, line GTIN + qty + price
    // -------------------------------------------------------------------------
    var rHdr: int64 := alloc(EDI_ORDER_HDR_SIZE);
    var rLines: int64 := alloc(4 * EDI_ORDER_LINE_SIZE);
    var rc5: int64 := EdiOrdersRead(out2, w2, rHdr, rLines, 4);
    if (rc5 != 2) {
        PrintLn("FAIL: EdiOrdersRead should find 2 lines"c); ok := 0;
    } else { PrintLn("PASS: EdiOrdersRead line count = 2"c); }

    var rOrderPtr: int64 := peek64(rHdr + EDI_ORDER_HDR_NUM);
    var rOrderLen: int64 := peek64(rHdr + EDI_ORDER_HDR_NUMLEN);
    if (memEq(rOrderPtr, rOrderLen, orderNum as int64, 5) != 1) {
        PrintLn("FAIL: ORDERS round-trip orderNum mismatch"c); ok := 0;
    } else { PrintLn("PASS: ORDERS round-trip orderNum matches"c); }

    // All 4 NAD roles extracted
    var rBGL: int64 := peek64(rHdr + EDI_ORDER_HDR_BUYER_GLNL);
    if (rBGL != 13) {
        PrintLn("FAIL: ORDERS buyer GLN len should be 13"c); ok := 0;
    } else { PrintLn("PASS: ORDERS buyer GLN extracted"c); }

    var rSGL: int64 := peek64(rHdr + EDI_ORDER_HDR_SUP_GLNL);
    if (rSGL != 13) {
        PrintLn("FAIL: ORDERS supplier GLN len should be 13"c); ok := 0;
    } else { PrintLn("PASS: ORDERS supplier GLN extracted"c); }

    var rDGL: int64 := peek64(rHdr + EDI_ORDER_HDR_DELIV_GLNL);
    if (rDGL != 13) {
        PrintLn("FAIL: ORDERS delivery GLN len should be 13"c); ok := 0;
    } else { PrintLn("PASS: ORDERS delivery GLN extracted"c); }

    var rIGL: int64 := peek64(rHdr + EDI_ORDER_HDR_INV_GLNL);
    if (rIGL != 13) {
        PrintLn("FAIL: ORDERS invoicee GLN len should be 13"c); ok := 0;
    } else { PrintLn("PASS: ORDERS invoicee GLN extracted"c); }

    // line[0] GTIN and price
    var rGtinPtr: int64 := peek64(rLines + 0 * EDI_ORDER_LINE_SIZE + EDI_ORDER_LINE_GTIN);
    var rGtinLen: int64 := peek64(rLines + 0 * EDI_ORDER_LINE_SIZE + EDI_ORDER_LINE_GTINLEN);
    if (memEq(rGtinPtr, rGtinLen, gtinA as int64, 13) != 1) {
        PrintLn("FAIL: ORDERS round-trip line[0] GTIN mismatch"c); ok := 0;
    } else { PrintLn("PASS: ORDERS round-trip line[0] GTIN matches"c); }

    var rPrice0: int64 := peek64(rLines + 0 * EDI_ORDER_LINE_SIZE + EDI_ORDER_LINE_PRICE);
    if (rPrice0 != 1999) {
        PrintLn("FAIL: ORDERS round-trip line[0] price should be 1999"c); ok := 0;
    } else { PrintLn("PASS: ORDERS round-trip line[0] price = 1999"c); }

    var rQty1: int64 := peek64(rLines + 1 * EDI_ORDER_LINE_SIZE + EDI_ORDER_LINE_QTY);
    if (rQty1 != 5) {
        PrintLn("FAIL: ORDERS round-trip line[1] qty should be 5"c); ok := 0;
    } else { PrintLn("PASS: ORDERS round-trip line[1] qty = 5"c); }

    // -------------------------------------------------------------------------
    // Test 6: EdiOrdersValidate — correct total → 0, tampered total → 1
    // -------------------------------------------------------------------------
    // total = 10 × 1999 + 5 × 3500 = 19990 + 17500 = 37490
    var rTotal: int64 := peek64(rHdr + EDI_ORDER_HDR_TOTAL);
    if (rTotal != 37490) {
        PrintLn("FAIL: ORDERS MOA total should be 37490"c); ok := 0;
    } else { PrintLn("PASS: ORDERS MOA total = 37490"c); }

    var valOk: int64 := EdiOrdersValidate(rHdr, rLines, 2);
    if (valOk != 0) {
        PrintLn("FAIL: EdiOrdersValidate correct total should return 0"c); ok := 0;
    } else { PrintLn("PASS: EdiOrdersValidate correct total = 0 (valid)"c); }

    // Tamper: add 2 cents → diff > 1 → should return 1
    poke64(rHdr + EDI_ORDER_HDR_TOTAL, rTotal + 2);
    var valBad: int64 := EdiOrdersValidate(rHdr, rLines, 2);
    if (valBad != 1) {
        PrintLn("FAIL: EdiOrdersValidate tampered total should return 1"c); ok := 0;
    } else { PrintLn("PASS: EdiOrdersValidate tampered total = 1 (mismatch)"c); }

    free(rLines, 4 * EDI_ORDER_LINE_SIZE);
    free(rHdr, EDI_ORDER_HDR_SIZE);

    // -------------------------------------------------------------------------
    // Test 7: EdiOrdrspWrite + EdiOrdrspRead — line status (1=accepted, 7=rejected)
    // -------------------------------------------------------------------------
    var rspLines: int64 := alloc(2 * EDI_ORDER_LINE_SIZE);
    var rsa: int64 := rspLines + 0 * EDI_ORDER_LINE_SIZE;
    var rsb: int64 := rspLines + 1 * EDI_ORDER_LINE_SIZE;

    poke64(rsa + EDI_ORDER_LINE_GTIN,    gtinA as int64);
    poke64(rsa + EDI_ORDER_LINE_GTINLEN, 13);
    poke64(rsa + EDI_ORDER_LINE_QTY,     10);
    poke64(rsa + EDI_ORDER_LINE_UNIT,    unitPCE as int64);
    poke64(rsa + EDI_ORDER_LINE_UNITLEN, 3);
    poke64(rsa + EDI_ORDER_LINE_PRICE,   1999);
    poke64(rsa + EDI_ORDER_LINE_TAXRATE, 0);
    poke64(rsa + EDI_ORDER_LINE_DATE,    0);
    poke64(rsa + EDI_ORDER_LINE_STATUS,  1);   // accepted
    poke64(rsa + EDI_ORDER_LINE_LINENO,  1);

    poke64(rsb + EDI_ORDER_LINE_GTIN,    gtinB as int64);
    poke64(rsb + EDI_ORDER_LINE_GTINLEN, 8);
    poke64(rsb + EDI_ORDER_LINE_QTY,     5);
    poke64(rsb + EDI_ORDER_LINE_UNIT,    unitPCE as int64);
    poke64(rsb + EDI_ORDER_LINE_UNITLEN, 3);
    poke64(rsb + EDI_ORDER_LINE_PRICE,   0);
    poke64(rsb + EDI_ORDER_LINE_TAXRATE, 0);
    poke64(rsb + EDI_ORDER_LINE_DATE,    0);
    poke64(rsb + EDI_ORDER_LINE_STATUS,  7);   // rejected
    poke64(rsb + EDI_ORDER_LINE_LINENO,  2);

    var confirmNum: pchar := "CONF001"c;
    var out7: int64 := alloc(2048);
    var w7: int64 := EdiOrdrspWrite(orderNum as int64, confirmNum as int64, rspLines, 2, out7, 2048);
    if (w7 <= 0) { PrintLn("FAIL: EdiOrdrspWrite returned <= 0"c); ok := 0; }
    else          { PrintLn("PASS: EdiOrdrspWrite returned bytes"c); }
    if (hasTag(out7, w7, 82, 70, 70) != 1) {   // RFF
        PrintLn("FAIL: EdiOrdrspWrite missing RFF"c); ok := 0;
    } else { PrintLn("PASS: EdiOrdrspWrite has RFF"c); }

    var rRspHdr: int64 := alloc(EDI_ORDER_HDR_SIZE);
    var rRspLines: int64 := alloc(4 * EDI_ORDER_LINE_SIZE);
    var rRspC: int64 := EdiOrdrspRead(out7, w7, rRspHdr, rRspLines, 4);
    if (rRspC != 2) {
        PrintLn("FAIL: EdiOrdrspRead should find 2 lines"c); ok := 0;
    } else { PrintLn("PASS: EdiOrdrspRead line count = 2"c); }

    var stat0: int64 := peek64(rRspLines + 0 * EDI_ORDER_LINE_SIZE + EDI_ORDER_LINE_STATUS);
    if (stat0 != 1) {
        PrintLn("FAIL: ORDRSP line[0] status should be 1 (accepted)"c); ok := 0;
    } else { PrintLn("PASS: ORDRSP line[0] status = 1 (accepted)"c); }

    var stat1: int64 := peek64(rRspLines + 1 * EDI_ORDER_LINE_SIZE + EDI_ORDER_LINE_STATUS);
    if (stat1 != 7) {
        PrintLn("FAIL: ORDRSP line[1] status should be 7 (rejected)"c); ok := 0;
    } else { PrintLn("PASS: ORDRSP line[1] status = 7 (rejected)"c); }

    // confirmNum recovered from BGM
    var rConfPtr: int64 := peek64(rRspHdr + EDI_ORDER_HDR_NUM);
    var rConfLen: int64 := peek64(rRspHdr + EDI_ORDER_HDR_NUMLEN);
    if (memEq(rConfPtr, rConfLen, confirmNum as int64, 7) != 1) {
        PrintLn("FAIL: ORDRSP confirmNum mismatch"c); ok := 0;
    } else { PrintLn("PASS: ORDRSP confirmNum matches"c); }

    free(rRspLines, 4 * EDI_ORDER_LINE_SIZE);
    free(rRspHdr, EDI_ORDER_HDR_SIZE);
    free(out7, 2048);
    free(rspLines, 2 * EDI_ORDER_LINE_SIZE);

    // -------------------------------------------------------------------------
    // Test 8: EdiOrdchgWrite + EdiOrdchgRead — changeNo, original order reference
    // -------------------------------------------------------------------------
    var chgLines: int64 := alloc(EDI_ORDER_LINE_SIZE);
    poke64(chgLines + EDI_ORDER_LINE_GTIN,    gtinA as int64);
    poke64(chgLines + EDI_ORDER_LINE_GTINLEN, 13);
    poke64(chgLines + EDI_ORDER_LINE_QTY,     15);   // changed quantity
    poke64(chgLines + EDI_ORDER_LINE_UNIT,    unitPCE as int64);
    poke64(chgLines + EDI_ORDER_LINE_UNITLEN, 3);
    poke64(chgLines + EDI_ORDER_LINE_PRICE,   0);
    poke64(chgLines + EDI_ORDER_LINE_TAXRATE, 0);
    poke64(chgLines + EDI_ORDER_LINE_DATE,    0);
    poke64(chgLines + EDI_ORDER_LINE_STATUS,  0);
    poke64(chgLines + EDI_ORDER_LINE_LINENO,  1);

    var out8: int64 := alloc(1024);
    var w8: int64 := EdiOrdchgWrite(orderNum as int64, 2, chgLines, 1, out8, 1024);
    if (w8 <= 0) { PrintLn("FAIL: EdiOrdchgWrite returned <= 0"c); ok := 0; }
    else          { PrintLn("PASS: EdiOrdchgWrite returned bytes"c); }

    var rChgHdr: int64 := alloc(EDI_ORDER_HDR_SIZE);
    var rChgLines: int64 := alloc(2 * EDI_ORDER_LINE_SIZE);
    var rChgC: int64 := EdiOrdchgRead(out8, w8, rChgHdr, rChgLines, 2);
    if (rChgC != 1) {
        PrintLn("FAIL: EdiOrdchgRead should find 1 line"c); ok := 0;
    } else { PrintLn("PASS: EdiOrdchgRead line count = 1"c); }

    var rChgNo: int64 := peek64(rChgHdr + EDI_ORDER_HDR_CHANGENO);
    if (rChgNo != 2) {
        PrintLn("FAIL: ORDCHG changeNo should be 2"c); ok := 0;
    } else { PrintLn("PASS: ORDCHG changeNo = 2"c); }

    // original order reference from RFF+ON
    var rChgRefPtr: int64 := peek64(rChgHdr + EDI_ORDER_HDR_NUM);
    var rChgRefLen: int64 := peek64(rChgHdr + EDI_ORDER_HDR_NUMLEN);
    if (memEq(rChgRefPtr, rChgRefLen, orderNum as int64, 5) != 1) {
        PrintLn("FAIL: ORDCHG order reference mismatch"c); ok := 0;
    } else { PrintLn("PASS: ORDCHG order reference = PO001"c); }

    var rChgQty: int64 := peek64(rChgLines + EDI_ORDER_LINE_QTY);
    if (rChgQty != 15) {
        PrintLn("FAIL: ORDCHG changed qty should be 15"c); ok := 0;
    } else { PrintLn("PASS: ORDCHG changed qty = 15"c); }

    free(rChgLines, 2 * EDI_ORDER_LINE_SIZE);
    free(rChgHdr, EDI_ORDER_HDR_SIZE);
    free(out8, 1024);
    free(chgLines, EDI_ORDER_LINE_SIZE);

    free(out2, 2048);
    free(lines, 2 * EDI_ORDER_LINE_SIZE);
    free(hdr, EDI_ORDER_HDR_SIZE);

    if (ok != 0) { PrintLn("=== EDI-04: ALL PASS ==="c); }
    else          { PrintLn("=== EDI-04: SOME FAIL ==="c); }
    return ok;
}
