// WP-04: Tuple-Return-Typ [T, T]
// Verifies that functions returning [T, T] correctly pass two values
// via the SysV rax:rdx convention, and that call sites destructure them
// correctly with var [a, b] := fn().
//
// Expected output:
//   10
//   20
//   100
//   200
import std.io;

fn swapPair(a: int64, b: int64): [int64, int64] {
  return [b, a];
}

fn minMax(a: int64, b: int64): [int64, int64] {
  if (a <= b) {
    return [a, b];
  }
  return [b, a];
}

fn main(): int64 {
  var x, y := swapPair(20, 10);
  PrintInt(x);
  PrintLn("");
  PrintInt(y);
  PrintLn("");

  var lo, hi := minMax(200, 100);
  PrintInt(lo);
  PrintLn("");
  PrintInt(hi);
  PrintLn("");

  return 0;
}
