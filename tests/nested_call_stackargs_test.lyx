// tests/nested_call_stackargs_test.lyx — Stack-Argumente bei verschachtelten Aufrufen.
//
// Ab dem 7. Slot passen Argumente nicht mehr in Register und gehen nach
// SysV-Konvention über den Stack. Der Aufrufer muss sie nach dem `call` selbst
// abräumen — genau das fehlte. Isoliert fiel es nicht auf (der Frame wird beim
// Funktionsende ohnehin über rbp zurückgesetzt), aber INNERHALB der
// Argumentliste eines anderen Aufrufs lagen dort schon dessen ausgewertete
// Argumente: die liegengebliebenen Slots verschoben sie.
//
// Ausprägungen waren SIGSEGV oder — gefährlicher — ein stillschweigend
// verlorener Parameter des äußeren Aufrufs.
//
// Bei Methoden zählt das implizite self mit, die Grenze liegt dort also schon
// bei 6 expliziten Argumenten.

import std.io;

var fails: int64 := 0;

fn expect(name: pchar, got: int64, want: int64) {
  Print(name); Print(": ");
  if (got == want) {
    PrintLn("OK");
  } else {
    Print("FAIL got="); PrintInt(got); Print(" want="); PrintInt(want); PrintLn("");
    fails += 1;
  }
}

fn f6(a1: int64, a2: int64, a3: int64, a4: int64, a5: int64, a6: int64): int64 {
  return a1 + a6 * 100;
}

fn f7(a1: int64, a2: int64, a3: int64, a4: int64, a5: int64, a6: int64, a7: int64): int64 {
  return a1 + a7 * 100;
}

fn f9(a1: int64, a2: int64, a3: int64, a4: int64, a5: int64, a6: int64,
      a7: int64, a8: int64, a9: int64): int64 {
  return a1 + a9 * 100;
}

fn two(a: int64, b: int64): int64 { return a * 1000 + b; }

pub type C = class {
  v: int64;
  pub fn M6(a1: int64, a2: int64, a3: int64, a4: int64, a5: int64, a6: int64): int64 {
    return a1 + a6 * 100;
  }
  pub fn M7(a1: int64, a2: int64, a3: int64, a4: int64, a5: int64, a6: int64, a7: int64): int64 {
    return a1 + a7 * 100;
  }
};

fn main(): int64 {
  // --- freie Funktionen, verschachtelt in fremder Argumentliste ---
  expect("nested f6 (noch Register)", f6(5, 0, 0, 0, 0, 3), 305);
  expect("nested f7 (1 Stack-Slot)", f7(5, 0, 0, 0, 0, 0, 3), 305);
  expect("nested f9 (3 Stack-Slots)", f9(5, 0, 0, 0, 0, 0, 0, 0, 3), 305);

  // zwei verschachtelte Aufrufe nebeneinander: beide räumen ihre Slots ab
  expect("zwei verschachtelte", two(f7(1, 0, 0, 0, 0, 0, 2), f7(3, 0, 0, 0, 0, 0, 4)),
         201000 + 403);

  // --- Methoden: implizites self zählt mit ---
  var o: C := new C();
  expect("nested M6 (6+self)", o.M6(5, 0, 0, 0, 0, 3), 305);
  expect("nested M7 (7+self)", o.M7(5, 0, 0, 0, 0, 0, 3), 305);
  expect("nested static M7", C.M7(5, 0, 0, 0, 0, 0, 3), 305);

  // --- isolierter Aufruf muss unverändert stimmen ---
  var r7: int64 := f7(5, 0, 0, 0, 0, 0, 3);
  expect("isoliert f7", r7, 305);
  var r9: int64 := f9(5, 0, 0, 0, 0, 0, 0, 0, 3);
  expect("isoliert f9", r9, 305);

  // --- der äußere pchar-Parameter darf nicht verloren gehen ---
  // (genau das war die stille Ausprägung: der Name verschwand, der Wert stimmte)
  expect("aeusserer Name erhalten", f7(9, 0, 0, 0, 0, 0, 1), 109);

  if (fails == 0) { PrintLn("ALL OK"); return 0; }
  PrintLn("FAILURES");
  return 1;
}
