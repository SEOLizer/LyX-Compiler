// tests/pqc_wp10_test.lyx
// WP-PQC-10: High-Level PQC API
//
// Abnahmekriterien:
// AC-WP10.1: KEM-Roundtrip (ML-KEM-512/768/1024, Hybrid-768)
// AC-WP10.2: DSA-Roundtrip Sign/Verify (ML-DSA-44/65/87, SLH-DSA-128S)
// AC-WP10.3: Key-Größen korrekt (pkLen/skLen stimmen mit Konstanten überein)
// AC-WP10.4: Determinismus (gleicher Seed → gleicher PK)
// AC-WP10.5: Manipulierte Signatur wird abgelehnt (ML-DSA-65)

unit tests.pqc_wp10_test;

import std.crypto.pqc.pqc;
import std.alloc;

fn fill(buf: int64, n: int64, seed: int64) {
  var v: int64 := seed;
  var i: int64 := 0;
  while (i < n) {
    v := (v * 6364136223846793005) + 1442695040888963407;
    poke8(buf+i, (v>>16) & 0xFF);
    i := i+1;
  }
}

fn mem_eq(a: int64, b: int64, n: int64): int64 {
  var i: int64 := 0;
  while (i < n) { if (peek8(a+i) != peek8(b+i)) { return 0; } i := i+1; }
  return 1;
}

fn mem_nonzero(a: int64, n: int64): int64 {
  var i: int64 := 0;
  while (i < n) { if (peek8(a+i) != 0) { return 1; } i := i+1; }
  return 0;
}

// ─── AC-WP10.1: KEM-Roundtrip ────────────────────────────────────────────────

fn testKEMRoundtrip(alg: int64): int64 {
  var ctLen: int64 := PQCCTLen(alg);
  var ct:    int64 := alloc(ctLen);
  var ss1:   int64 := alloc(PQC_SS_LEN);
  var ss2:   int64 := alloc(PQC_SS_LEN);

  var kp: int64 := PQCKeyGen(alg);
  PQCEncapsulate(kp, ct, ss1);
  PQCDecapsulate(kp, ct, ss2);

  var ok: int64 := mem_eq(ss1, ss2, PQC_SS_LEN) & mem_nonzero(ss1, PQC_SS_LEN);
  PQCFreeKeyPair(kp);
  free(ct, ctLen); free(ss1, PQC_SS_LEN); free(ss2, PQC_SS_LEN);
  return ok;
}

fn testAC1(): int64 {
  var failed: int64 := 0;
  if (testKEMRoundtrip(PQC_ALG_MLKEM_512) != 0)  { PrintLn("OK: KEM-Roundtrip ML-KEM-512  (WP-10.1)"); } else { PrintLn("FAIL: KEM-Roundtrip ML-KEM-512  (WP-10.1)"); failed := failed+1; }
  if (testKEMRoundtrip(PQC_ALG_MLKEM_768) != 0)  { PrintLn("OK: KEM-Roundtrip ML-KEM-768  (WP-10.1)"); } else { PrintLn("FAIL: KEM-Roundtrip ML-KEM-768  (WP-10.1)"); failed := failed+1; }
  if (testKEMRoundtrip(PQC_ALG_MLKEM_1024) != 0) { PrintLn("OK: KEM-Roundtrip ML-KEM-1024 (WP-10.1)"); } else { PrintLn("FAIL: KEM-Roundtrip ML-KEM-1024 (WP-10.1)"); failed := failed+1; }
  if (testKEMRoundtrip(PQC_ALG_HYBRID_768) != 0) { PrintLn("OK: KEM-Roundtrip Hybrid-768  (WP-10.1)"); } else { PrintLn("FAIL: KEM-Roundtrip Hybrid-768  (WP-10.1)"); failed := failed+1; }
  return failed;
}

// ─── AC-WP10.2: DSA-Roundtrip ────────────────────────────────────────────────

fn testDSARoundtrip(alg: int64): int64 {
  var sigLen: int64 := PQCSigLen(alg);
  var sig:    int64 := alloc(sigLen);
  var msg:    int64 := alloc(64);
  fill(msg, 64, 0xABCDEF01);

  var kp: int64 := PQCKeyGen(alg);
  var sl: int64 := PQCSign(kp, msg, 64, sig);
  var ok: int64 := 0;
  if (sl > 0) { ok := PQCVerify(kp, msg, 64, sig, sl); }

  PQCFreeKeyPair(kp);
  free(sig, sigLen); free(msg, 64);
  return ok;
}

fn testAC2(): int64 {
  var failed: int64 := 0;
  if (testDSARoundtrip(PQC_ALG_MLDSA_44) != 0)    { PrintLn("OK: DSA-Roundtrip ML-DSA-44    (WP-10.2)"); } else { PrintLn("FAIL: DSA-Roundtrip ML-DSA-44    (WP-10.2)"); failed := failed+1; }
  if (testDSARoundtrip(PQC_ALG_MLDSA_65) != 0)    { PrintLn("OK: DSA-Roundtrip ML-DSA-65    (WP-10.2)"); } else { PrintLn("FAIL: DSA-Roundtrip ML-DSA-65    (WP-10.2)"); failed := failed+1; }
  if (testDSARoundtrip(PQC_ALG_MLDSA_87) != 0)    { PrintLn("OK: DSA-Roundtrip ML-DSA-87    (WP-10.2)"); } else { PrintLn("FAIL: DSA-Roundtrip ML-DSA-87    (WP-10.2)"); failed := failed+1; }
  if (testDSARoundtrip(PQC_ALG_SLHDSA_MINI) != 0) { PrintLn("OK: DSA-Roundtrip SLH-DSA-Mini (WP-10.2)"); } else { PrintLn("FAIL: DSA-Roundtrip SLH-DSA-Mini (WP-10.2)"); failed := failed+1; }
  return failed;
}

// ─── AC-WP10.3: Key-Größen ───────────────────────────────────────────────────

fn testKeySizes(alg: int64): int64 {
  var kp: int64 := PQCKeyGen(alg);
  var ok: int64 := (PQCGetPublicKeyLen(kp) == PQCPublicKeyLen(alg)) & (PQCGetSecretKeyLen(kp) == PQCSecretKeyLen(alg));
  PQCFreeKeyPair(kp);
  return ok;
}

fn testAC3(): int64 {
  var failed: int64 := 0;
  if (testKeySizes(PQC_ALG_MLKEM_768) != 0)  { PrintLn("OK: Key-Größen ML-KEM-768  (WP-10.3)"); } else { PrintLn("FAIL: Key-Größen ML-KEM-768  (WP-10.3)"); failed := failed+1; }
  if (testKeySizes(PQC_ALG_MLDSA_65) != 0)   { PrintLn("OK: Key-Größen ML-DSA-65   (WP-10.3)"); } else { PrintLn("FAIL: Key-Größen ML-DSA-65   (WP-10.3)"); failed := failed+1; }
  if (testKeySizes(PQC_ALG_HYBRID_768) != 0) { PrintLn("OK: Key-Größen Hybrid-768  (WP-10.3)"); } else { PrintLn("FAIL: Key-Größen Hybrid-768  (WP-10.3)"); failed := failed+1; }
  return failed;
}

// ─── AC-WP10.4: Determinismus ────────────────────────────────────────────────

fn testAC4(): int64 {
  // Gleicher Seed → gleicher PK für ML-KEM-768
  var seed: int64 := alloc(64);
  fill(seed, 64, 0xDEADC0DE);

  var kp1: int64 := PQCKeyGenFromSeed(PQC_ALG_MLKEM_768, seed);
  var kp2: int64 := PQCKeyGenFromSeed(PQC_ALG_MLKEM_768, seed);

  var ok: int64 := mem_eq(PQCGetPublicKey(kp1), PQCGetPublicKey(kp2), MLKEM768_PK);

  PQCFreeKeyPair(kp1); PQCFreeKeyPair(kp2); free(seed, 64);

  if (ok != 0) { PrintLn("OK: Determinismus PQCKeyGenFromSeed (WP-10.4)"); return 0; }
  PrintLn("FAIL: Determinismus (WP-10.4)");
  return 1;
}

// ─── AC-WP10.5: Manipulierte Signatur wird abgelehnt ────────────────────────

fn testAC5(): int64 {
  var sigLen: int64 := PQCSigLen(PQC_ALG_MLDSA_65);
  var sig:    int64 := alloc(sigLen);
  var msg:    int64 := alloc(32);
  fill(msg, 32, 0xCAFEBABE);

  var kp: int64 := PQCKeyGen(PQC_ALG_MLDSA_65);
  var sl: int64 := PQCSign(kp, msg, 32, sig);

  // erstes Byte flippen
  poke8(sig, peek8(sig) ^ 0xFF);

  var accepted: int64 := PQCVerify(kp, msg, 32, sig, sl);

  PQCFreeKeyPair(kp); free(sig, sigLen); free(msg, 32);

  if (accepted == 0) { PrintLn("OK: Manipulierte Signatur abgelehnt (WP-10.5)"); return 0; }
  PrintLn("FAIL: Manipulierte Signatur akzeptiert (WP-10.5)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testAC1();
  failed := failed + testAC2();
  failed := failed + testAC3();
  failed := failed + testAC4();
  failed := failed + testAC5();
  if (failed != 0) { PrintLn("FAILED"); return 1; }
  PrintLn("ALL PASSED");
  return 0;
}
