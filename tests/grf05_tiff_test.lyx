// tests/grf05_tiff_test.lyx — GRF-05: TIFF Decoder Tests

unit tests.grf05_tiff_test;

import std.image.core;
import std.image.tiff;
import std.alloc;
import std.io;

// Build a minimal 2×1 uncompressed RGB TIFF (LE byte order).
// Returns bytes written.
fn makeRgbTiff2x1LE(buf: int64): int64 {
    var p: int64 := buf;

    // TIFF header (LE)
    poke8(p, 0x49); poke8(p+1, 0x49);  // 'II' = LE
    poke8(p+2, 42); poke8(p+3, 0);     // magic = 42
    // IFD offset = 8 (immediately after header)
    poke8(p+4, 8); poke8(p+5, 0); poke8(p+6, 0); poke8(p+7, 0);
    p := p + 8;

    // IFD at offset 8: 9 tags × 12 bytes each + 2-byte count + 4-byte next IFD
    // Tag layout: [tag:2][type:2][count:4][value_or_offset:4]
    // Pixel data will be at offset 8 + 2 + 9*12 + 4 = 122
    var pixelOff: int64 := 8 + 2 + 9 * 12 + 4;

    poke8(p, 9); poke8(p+1, 0);  // 9 tags
    p := p + 2;

    // ImageWidth = 2 (SHORT)
    poke8(p,0x00);poke8(p+1,0x01); poke8(p+2,3);poke8(p+3,0);   // tag=256, type=SHORT
    poke8(p+4,1);poke8(p+5,0);poke8(p+6,0);poke8(p+7,0);         // count=1
    poke8(p+8,2);poke8(p+9,0);poke8(p+10,0);poke8(p+11,0);       // value=2
    p := p + 12;

    // ImageLength = 1 (SHORT)
    poke8(p,0x01);poke8(p+1,0x01); poke8(p+2,3);poke8(p+3,0);
    poke8(p+4,1);poke8(p+5,0);poke8(p+6,0);poke8(p+7,0);
    poke8(p+8,1);poke8(p+9,0);poke8(p+10,0);poke8(p+11,0);       // value=1
    p := p + 12;

    // BitsPerSample = 8 (SHORT)
    poke8(p,0x02);poke8(p+1,0x01); poke8(p+2,3);poke8(p+3,0);
    poke8(p+4,1);poke8(p+5,0);poke8(p+6,0);poke8(p+7,0);
    poke8(p+8,8);poke8(p+9,0);poke8(p+10,0);poke8(p+11,0);       // value=8
    p := p + 12;

    // Compression = 1 (None) (SHORT)
    poke8(p,0x03);poke8(p+1,0x01); poke8(p+2,3);poke8(p+3,0);
    poke8(p+4,1);poke8(p+5,0);poke8(p+6,0);poke8(p+7,0);
    poke8(p+8,1);poke8(p+9,0);poke8(p+10,0);poke8(p+11,0);       // value=1 (none)
    p := p + 12;

    // PhotometricInterpretation = 2 (RGB) (SHORT)
    poke8(p,0x06);poke8(p+1,0x01); poke8(p+2,3);poke8(p+3,0);
    poke8(p+4,1);poke8(p+5,0);poke8(p+6,0);poke8(p+7,0);
    poke8(p+8,2);poke8(p+9,0);poke8(p+10,0);poke8(p+11,0);       // value=2 (RGB)
    p := p + 12;

    // SamplesPerPixel = 3 (SHORT)
    poke8(p,0x15);poke8(p+1,0x01); poke8(p+2,3);poke8(p+3,0);
    poke8(p+4,1);poke8(p+5,0);poke8(p+6,0);poke8(p+7,0);
    poke8(p+8,3);poke8(p+9,0);poke8(p+10,0);poke8(p+11,0);       // value=3
    p := p + 12;

    // RowsPerStrip = 1 (SHORT)
    poke8(p,0x16);poke8(p+1,0x01); poke8(p+2,3);poke8(p+3,0);
    poke8(p+4,1);poke8(p+5,0);poke8(p+6,0);poke8(p+7,0);
    poke8(p+8,1);poke8(p+9,0);poke8(p+10,0);poke8(p+11,0);       // value=1
    p := p + 12;

    // StripOffsets = pixelOff (LONG)
    poke8(p,0x11);poke8(p+1,0x01); poke8(p+2,4);poke8(p+3,0);    // tag=273, type=LONG
    poke8(p+4,1);poke8(p+5,0);poke8(p+6,0);poke8(p+7,0);         // count=1
    poke8(p+8,pixelOff&255);poke8(p+9,(pixelOff>>8)&255);
    poke8(p+10,(pixelOff>>16)&255);poke8(p+11,(pixelOff>>24)&255);
    p := p + 12;

    // StripByteCounts = 6 (LONG) [2 pixels × 3 bytes = 6]
    poke8(p,0x17);poke8(p+1,0x01); poke8(p+2,4);poke8(p+3,0);    // tag=279, type=LONG
    poke8(p+4,1);poke8(p+5,0);poke8(p+6,0);poke8(p+7,0);
    poke8(p+8,6);poke8(p+9,0);poke8(p+10,0);poke8(p+11,0);       // value=6
    p := p + 12;

    // Next IFD = 0
    poke8(p,0);poke8(p+1,0);poke8(p+2,0);poke8(p+3,0); p:=p+4;

    // Pixel data: 2 RGB pixels
    // Pixel (0,0) = Red = 0xFF 0x00 0x00
    // Pixel (1,0) = Blue = 0x00 0x00 0xFF
    poke8(p, 0xFF); poke8(p+1, 0x00); poke8(p+2, 0x00);
    poke8(p+3, 0x00); poke8(p+4, 0x00); poke8(p+5, 0xFF);
    p := p + 6;

    return p - buf;
}

// Build 1×1 BE TIFF grayscale with value=0xAB
fn makeTiff1x1BEGray(buf: int64): int64 {
    var p: int64 := buf;
    // BE header
    poke8(p, 0x4D); poke8(p+1, 0x4D);  // 'MM' = BE
    poke8(p+2, 0); poke8(p+3, 42);     // magic BE
    poke8(p+4, 0); poke8(p+5, 0); poke8(p+6, 0); poke8(p+7, 8);
    p := p + 8;
    var pixelOff: int64 := 8 + 2 + 7 * 12 + 4;

    poke8(p, 0); poke8(p+1, 7); p := p + 2;  // 7 tags

    // Width=1 BE SHORT
    poke8(p,1);poke8(p+1,0); poke8(p+2,0);poke8(p+3,3); poke8(p+4,0);poke8(p+5,0);poke8(p+6,0);poke8(p+7,1); poke8(p+8,0);poke8(p+9,1);poke8(p+10,0);poke8(p+11,0); p:=p+12;
    // Height=1 BE SHORT
    poke8(p,1);poke8(p+1,1); poke8(p+2,0);poke8(p+3,3); poke8(p+4,0);poke8(p+5,0);poke8(p+6,0);poke8(p+7,1); poke8(p+8,0);poke8(p+9,1);poke8(p+10,0);poke8(p+11,0); p:=p+12;
    // BPS=8 BE SHORT
    poke8(p,1);poke8(p+1,2); poke8(p+2,0);poke8(p+3,3); poke8(p+4,0);poke8(p+5,0);poke8(p+6,0);poke8(p+7,1); poke8(p+8,0);poke8(p+9,8);poke8(p+10,0);poke8(p+11,0); p:=p+12;
    // Compression=1 BE SHORT
    poke8(p,1);poke8(p+1,3); poke8(p+2,0);poke8(p+3,3); poke8(p+4,0);poke8(p+5,0);poke8(p+6,0);poke8(p+7,1); poke8(p+8,0);poke8(p+9,1);poke8(p+10,0);poke8(p+11,0); p:=p+12;
    // Photometric=1 (Gray) BE SHORT
    poke8(p,1);poke8(p+1,6); poke8(p+2,0);poke8(p+3,3); poke8(p+4,0);poke8(p+5,0);poke8(p+6,0);poke8(p+7,1); poke8(p+8,0);poke8(p+9,1);poke8(p+10,0);poke8(p+11,0); p:=p+12;
    // StripOffsets BE LONG
    poke8(p,1);poke8(p+1,0x11); poke8(p+2,0);poke8(p+3,4); poke8(p+4,0);poke8(p+5,0);poke8(p+6,0);poke8(p+7,1);
    poke8(p+8,(pixelOff>>24)&255);poke8(p+9,(pixelOff>>16)&255);poke8(p+10,(pixelOff>>8)&255);poke8(p+11,pixelOff&255); p:=p+12;
    // StripByteCounts=1 BE LONG
    poke8(p,1);poke8(p+1,0x17); poke8(p+2,0);poke8(p+3,4); poke8(p+4,0);poke8(p+5,0);poke8(p+6,0);poke8(p+7,1); poke8(p+8,0);poke8(p+9,0);poke8(p+10,0);poke8(p+11,1); p:=p+12;
    // Next IFD = 0
    poke8(p,0);poke8(p+1,0);poke8(p+2,0);poke8(p+3,0); p:=p+4;
    // Pixel
    poke8(p, 0xAB); p:=p+1;
    return p - buf;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Test 1: 2x1 RGB TIFF LE — pixel check (red left, blue right)
    // -------------------------------------------------------------------------
    var buf1: int64 := alloc(256);
    var len1: int64 := makeRgbTiff2x1LE(buf1);
    var img1: int64 := alloc(GRF_SIZE);
    var ret1: int64 := TiffDecode(buf1, len1, img1);
    if (ret1 != 1) {
        PrintLn("FAIL: TiffDecode 2x1 LE returned 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: TiffDecode 2x1 LE ret=1"c);
        var p0: int64 := GrfImageGetPixel(img1, 0, 0);
        var p1: int64 := GrfImageGetPixel(img1, 1, 0);
        if (p0 != 0xFF0000FF) {
            PrintLn("FAIL: pixel (0,0) should be red"c);
            ok := 0;
        } else {
            PrintLn("PASS: pixel (0,0) = red"c);
        }
        if (p1 != 0x0000FFFF) {
            PrintLn("FAIL: pixel (1,0) should be blue"c);
            ok := 0;
        } else {
            PrintLn("PASS: pixel (1,0) = blue"c);
        }
        var fmt: int64 := peek64(img1 + GRF_OFF_FORMAT);
        if (fmt != GRF_FMT_TIFF) {
            PrintLn("FAIL: format != GRF_FMT_TIFF"c);
            ok := 0;
        } else {
            PrintLn("PASS: format=GRF_FMT_TIFF"c);
        }
    }
    GrfImageFree(img1);
    free(buf1, 256);

    // -------------------------------------------------------------------------
    // Test 2: 1x1 BE Grayscale TIFF — byte order and gray→RGBA conversion
    // -------------------------------------------------------------------------
    var bufG: int64 := alloc(128);
    var lenG: int64 := makeTiff1x1BEGray(bufG);
    var imgG: int64 := alloc(GRF_SIZE);
    var retG: int64 := TiffDecode(bufG, lenG, imgG);
    if (retG != 1) {
        PrintLn("FAIL: TiffDecode 1x1 BE gray returned 0"c);
        ok := 0;
    } else {
        var pg: int64 := GrfImageGetPixel(imgG, 0, 0);
        // Gray=0xAB → RGBA = 0xABABABFF
        if (pg != 0xABABABFF) {
            PrintLn("FAIL: 1x1 BE gray pixel wrong"c);
            ok := 0;
        } else {
            PrintLn("PASS: 1x1 BE gray = 0xABABABFF"c);
        }
    }
    GrfImageFree(imgG);
    free(bufG, 128);

    // -------------------------------------------------------------------------
    // Test 3: Bad signature → return 0
    // -------------------------------------------------------------------------
    var bufBad: int64 := alloc(16);
    poke8(bufBad, 0); poke8(bufBad+1, 0); poke8(bufBad+2, 0); poke8(bufBad+3, 0);
    var imgBad: int64 := alloc(GRF_SIZE);
    var retBad: int64 := TiffDecode(bufBad, 16, imgBad);
    if (retBad != 0) {
        PrintLn("FAIL: TiffDecode bad sig should return 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: TiffDecode bad sig → 0"c);
    }
    free(bufBad, 16);
    free(imgBad, GRF_SIZE);

    if (ok != 0) {
        PrintLn("=== GRF-05: ALL PASS ==="c);
    } else {
        PrintLn("=== GRF-05: SOME FAIL ==="c);
    }
    return ok;
}
