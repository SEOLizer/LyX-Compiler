// tests/pg_05_test.lyx — WP-PG-05: Result-Set Accessoren
//
// Offline-Tests (kein PostgreSQL nötig):
//   1. PGFetchRow auf leerem Result → 0 Iterationen
//   2. PGGetStr / PGGetInt / PGGetFloat / PGGetBool auf 0 → kein Crash
//
// Live-Tests (PostgreSQL auf localhost:5432 mit trust-Auth):
//   3. while(PGFetchRow) über 3-Zeilen-SELECT → exakt 3 Iterationen
//   4. PGGetInt  für INTEGER-Spalte → korrekter Wert
//   5. PGGetStr  für TEXT-Spalte    → korrekter String
//   6. PGGetFloat für FLOAT8-Spalte → korrekter Wert
//   7. PGGetBool für BOOLEAN-Spalte → korrekt
//   8. PGIsNull  für NULL-Spalte    → 1
//   9. PGGetFieldName               → korrekte Namen
//  10. PGGetFieldTypeOid für INT4-Spalte → OID 23
//  11. PGDataSeek(result, 0) → Neustart der Iteration

import std.db.postgres;

// --- Offline: PGFetchRow auf 0 ---
fn testFetchNull(): int64 {
  var n: int64 := PGFetchRow(0);
  if (n != 0) { PrintStr("FAIL: PGFetchRow(0) != 0\n"); return 1; }
  PrintStr("OK: PGFetchRow(0) = 0\n");
  return 0;
}

// --- Offline: Accessoren auf 0 → kein Crash ---
fn testAccessorsNull(): int64 {
  PGGetStr(0, 0);
  PGGetInt(0, 0);
  PGGetFloat(0, 0);
  PGGetBool(0, 0);
  PGIsNull(0, 0, 0);
  PGGetFieldName(0, 0);
  PGGetFieldTypeOid(0, 0);
  PrintStr("OK: all accessors on null result safe\n");
  return 0;
}

// --- Live-Tests ---
fn testLive(): int64 {
  var probe: int64 := pgProbe("127.0.0.1"c, 5432, "postgres"c, "postgres"c);
  if (probe == 0) {
    PrintStr("SKIP: PostgreSQL not available\n");
    return 0;
  }

  var conn: int64 := PGConnect("127.0.0.1"c, 5432, "postgres"c, ""c, "postgres"c);
  if (conn == 0) { PrintStr("SKIP: PGConnect TCP error\n"); return 0; }
  if (PGIsConnected(conn) == 0) {
    if (PGErrno(conn) == PG_ERR_PROTO) {
      PrintStr("SKIP: unsupported auth (need trust/md5)\n");
    } else {
      PrintStr("SKIP: not connected\n");
    }
    PGClose(conn);
    return 0;
  }

  // Setup: temp table with INT, TEXT, FLOAT8, BOOL, nullable columns
  var rDrop: int64 := PGQuery(conn, "DROP TABLE IF EXISTS pg05_tmp"c);
  if (rDrop != 0) { PGFreeResult(rDrop); }

  var rCreate: int64 := PGQuery(conn,
    "CREATE TABLE pg05_tmp (id INT, name TEXT, price FLOAT8, active BOOL, note TEXT)"c);
  if (rCreate == 0) {
    PrintStr("FAIL: CREATE TABLE\n"); PGClose(conn); return 1;
  }
  PGFreeResult(rCreate);

  var rIns: int64 := PGQuery(conn,
    "INSERT INTO pg05_tmp VALUES (1,'alpha',1.5,true,NULL),(2,'beta',2.75,false,'hello'),(3,'gamma',3.0,true,NULL)"c);
  if (rIns == 0) {
    PrintStr("FAIL: INSERT\n"); PGClose(conn); return 1;
  }
  PGFreeResult(rIns);

  // --- 3. while(PGFetchRow) → 3 Iterationen ---
  var rSel: int64 := PGQuery(conn,
    "SELECT id, name, price, active, note FROM pg05_tmp ORDER BY id"c);
  if (rSel == 0) {
    PrintStr("FAIL: SELECT\n"); PGClose(conn); return 1;
  }

  var iters: int64 := 0;
  while (PGFetchRow(rSel) != 0) { iters := iters + 1; }
  if (iters != 3) {
    PrintStr("FAIL: PGFetchRow iterations != 3\n");
    PGFreeResult(rSel); PGClose(conn); return 1;
  }
  PrintStr("OK: PGFetchRow — 3 iterations\n");

  // --- 4–8: re-iterate via PGDataSeek ---
  PGDataSeek(rSel, 0);

  // Row 0: id=1, name='alpha', price=1.5, active=true, note=NULL
  if (PGFetchRow(rSel) == 0) {
    PrintStr("FAIL: PGFetchRow after DataSeek row 0\n");
    PGFreeResult(rSel); PGClose(conn); return 1;
  }

  // 4. PGGetInt
  var id: int64 := PGGetInt(rSel, 0);
  if (id != 1) {
    PrintStr("FAIL: PGGetInt id != 1\n");
    PGFreeResult(rSel); PGClose(conn); return 1;
  }
  PrintStr("OK: PGGetInt id = 1\n");

  // 5. PGGetStr
  var name: pchar := PGGetStr(rSel, 1);
  if (name == 0 as pchar) {
    PrintStr("FAIL: PGGetStr name = 0\n");
    PGFreeResult(rSel); PGClose(conn); return 1;
  }
  PrintStr("OK: PGGetStr name = "); PrintStr(name); PrintStr("\n");

  // 6. PGGetFloat
  var price: f64 := PGGetFloat(rSel, 2);
  // 1.5 is exactly representable — compare as integer after ×2
  var priceX2: int64 := (price * (2 as f64)) as int64;
  if (priceX2 != 3) {
    PrintStr("FAIL: PGGetFloat price != 1.5\n");
    PGFreeResult(rSel); PGClose(conn); return 1;
  }
  PrintStr("OK: PGGetFloat price = 1.5\n");

  // 7. PGGetBool (active=true → "t")
  var active: int64 := PGGetBool(rSel, 3);
  if (active != 1) {
    PrintStr("FAIL: PGGetBool active != 1\n");
    PGFreeResult(rSel); PGClose(conn); return 1;
  }
  PrintStr("OK: PGGetBool active = 1\n");

  // 8. PGIsNull (note=NULL for row 0)
  var isNull: int64 := PGIsNull(rSel, 0, 4);
  if (isNull == 0) {
    PrintStr("FAIL: PGIsNull note != 1\n");
    PGFreeResult(rSel); PGClose(conn); return 1;
  }
  PrintStr("OK: PGIsNull note (row 0) = 1\n");

  // Also verify non-null: note of row 1 ('hello')
  var isNull2: int64 := PGIsNull(rSel, 1, 4);
  if (isNull2 != 0) {
    PrintStr("FAIL: PGIsNull note row 1 should be 0\n");
    PGFreeResult(rSel); PGClose(conn); return 1;
  }
  PrintStr("OK: PGIsNull note (row 1) = 0\n");

  // 9. PGGetFieldName
  var fn0: pchar := PGGetFieldName(rSel, 0);
  var fn1: pchar := PGGetFieldName(rSel, 1);
  if (fn0 == 0 as pchar || fn1 == 0 as pchar) {
    PrintStr("FAIL: PGGetFieldName null\n");
    PGFreeResult(rSel); PGClose(conn); return 1;
  }
  PrintStr("OK: field[0]="); PrintStr(fn0); PrintStr(" field[1]="); PrintStr(fn1); PrintStr("\n");

  // 10. PGGetFieldTypeOid für INT (id) → OID 23
  var oid: int64 := PGGetFieldTypeOid(rSel, 0);
  if (oid != PG_OID_INT4) {
    PrintStr("FAIL: PGGetFieldTypeOid id != 23, got "); PrintInt(oid); PrintStr("\n");
    PGFreeResult(rSel); PGClose(conn); return 1;
  }
  PrintStr("OK: PGGetFieldTypeOid id = 23\n");

  // 11. PGDataSeek(rSel, 0) → re-read first row
  PGDataSeek(rSel, 0);
  if (PGFetchRow(rSel) == 0) {
    PrintStr("FAIL: PGFetchRow after PGDataSeek(0)\n");
    PGFreeResult(rSel); PGClose(conn); return 1;
  }
  var idAgain: int64 := PGGetInt(rSel, 0);
  if (idAgain != 1) {
    PrintStr("FAIL: PGDataSeek re-read id != 1\n");
    PGFreeResult(rSel); PGClose(conn); return 1;
  }
  PrintStr("OK: PGDataSeek restart → id = 1\n");

  PGFreeResult(rSel);

  // Cleanup
  var rClean: int64 := PGQuery(conn, "DROP TABLE pg05_tmp"c);
  if (rClean != 0) { PGFreeResult(rClean); }

  PGClose(conn);
  PrintStr("OK: PGClose\n");
  return 0;
}

pub fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testFetchNull();
  failed := failed + testAccessorsNull();
  failed := failed + testLive();
  if (failed != 0) { PrintStr("FAILED\n"); return 1; }
  PrintStr("ALL PASSED\n");
  return 0;
}
