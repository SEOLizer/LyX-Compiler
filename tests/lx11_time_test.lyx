// LX-11 Test: Zeit-Syscalls 0x0500–0x0504 kompilieren + Syscall-Nummern prüfen.

import src.std.lyxos.time;
import src.std.lyxos.ipc;

fn main(): int64 {
    // sys_clock_get: Monotone Zeit lesen
    var ts: int64 := 0;
    var ns: int64 := sys_clock_get(CLOCK_MONO, ts as pchar);

    // sys_clock_set: nur kompilieren (braucht Admin-Cap; wird zur Laufzeit scheitern)
    sys_clock_set(CLOCK_REAL, ts as pchar);

    // sys_timer_create + sys_timer_set + sys_timer_wait
    var nq: int64 := sys_notify_create(NOTIFY_NONE);
    var tfd: int64 := sys_timer_create(CLOCK_MONO, nq, TIMER_ONESHOT);
    sys_timer_set(tfd, TIMER_DISARM_INTERVAL, 1000000);
    var ticks: int64 := sys_timer_wait(tfd, 0 - 1);

    return ticks;
}
