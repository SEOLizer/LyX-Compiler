// tests/struct_packing_test.lyx
// WP-4.1-A: Struct Packing — @packed und at(offset)
//
// Tests: tightly-packed field layout, explicit field offsets, type-size mapping.

@description("WP-4.1-A: struct packing tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.struct_packing_test;

// --- 1. @packed struct: fields use natural type sizes, no 8-byte padding ---
@packed
struct TightHeader {
  magic:   uint8;
  version: uint8;
  flags:   uint16;
  length:  uint32;
}

fn testPackedFieldOffsets(): int64 {
  // In a @packed struct the fields are laid out tightly:
  //   magic   @ offset 0  (uint8,  1 byte)
  //   version @ offset 1  (uint8,  1 byte)
  //   flags   @ offset 2  (uint16, 2 bytes)
  //   length  @ offset 4  (uint32, 4 bytes)
  // total: 8 bytes

  var buf: int64 := mmap(0, 16, 3, 34, -1, 0);
  var h: TightHeader;
  poke8 (buf + 0, 0xAB);   // magic
  poke8 (buf + 1, 0x02);   // version
  poke16(buf + 2, 0x0102); // flags  (little-endian: 0x02, 0x01)
  poke32(buf + 4, 0xDEAD); // length

  // Read back via struct field accessors using known offsets
  var m: uint8  := peek8 (buf + 0) as uint8;
  var v: uint8  := peek8 (buf + 1) as uint8;
  var f: uint16 := peek16(buf + 2) as uint16;
  var l: uint32 := peek32(buf + 4) as uint32;

  if (m as int64 != 0xAB)   { PrintStr("FAIL: magic\n");   return 1; }
  if (v as int64 != 0x02)   { PrintStr("FAIL: version\n"); return 1; }
  if (f as int64 != 0x0102) { PrintStr("FAIL: flags\n");   return 1; }
  if (l as int64 != 0xDEAD) { PrintStr("FAIL: length\n");  return 1; }
  PrintStr("OK: @packed field layout\n");
  return 0;
}

// --- 2. Non-packed struct still uses 8-byte strides ---
struct WideHeader {
  magic:   uint8;
  version: uint8;
}

fn testUnpackedStride(): int64 {
  // Each field in an unpacked struct takes 8 bytes
  // magic   @ 0, version @ 8
  var buf: int64 := mmap(0, 32, 3, 34, -1, 0);
  poke8(buf + 0, 0x55);
  poke8(buf + 8, 0x77);

  var m: uint8 := peek8(buf + 0) as uint8;
  var v: uint8 := peek8(buf + 8) as uint8;

  if (m as int64 != 0x55) { PrintStr("FAIL: wide magic\n");   return 1; }
  if (v as int64 != 0x77) { PrintStr("FAIL: wide version\n"); return 1; }
  PrintStr("OK: unpacked 8-byte stride\n");
  return 0;
}

// --- 3. @packed struct with all primitive types ---
@packed
struct MixedPacked {
  a: uint8;
  b: uint16;
  c: uint32;
  d: int64;
}

fn testMixedPackedSizes(): int64 {
  // a @ 0 (1), b @ 1 (2), c @ 3 (4), d @ 7 (8) — total 15 bytes
  var buf: int64 := mmap(0, 32, 3, 34, -1, 0);
  poke8 (buf + 0,  0x01);
  poke16(buf + 1,  0x0203);
  poke32(buf + 3,  0x04050607);
  poke64(buf + 7,  0x0102030405060708);

  var a: uint8  := peek8 (buf + 0) as uint8;
  var b: uint16 := peek16(buf + 1) as uint16;
  var c: uint32 := peek32(buf + 3) as uint32;
  var d: int64  := peek64(buf + 7);

  if (a as int64 != 0x01)               { PrintStr("FAIL: mixed a\n"); return 1; }
  if (b as int64 != 0x0203)             { PrintStr("FAIL: mixed b\n"); return 1; }
  if (c as int64 != 0x04050607)         { PrintStr("FAIL: mixed c\n"); return 1; }
  if (d != 0x0102030405060708)          { PrintStr("FAIL: mixed d\n"); return 1; }
  PrintStr("OK: mixed packed sizes\n");
  return 0;
}

// --- 4. at(offset) explicit field placement ---
@packed
struct ExplicitLayout {
  id:    uint16 at(0);
  flags: uint8  at(2);
  pad:   uint8  at(3);
  value: int64  at(4);
}

fn testExplicitOffsets(): int64 {
  var buf: int64 := mmap(0, 32, 3, 34, -1, 0);
  poke16(buf + 0, 0xBEEF);
  poke8 (buf + 2, 0x42);
  poke8 (buf + 3, 0x00);
  poke64(buf + 4, 9999);

  var id:    uint16 := peek16(buf + 0) as uint16;
  var flags: uint8  := peek8 (buf + 2) as uint8;
  var value: int64  := peek64(buf + 4);

  if (id as int64    != 0xBEEF) { PrintStr("FAIL: explicit id\n");    return 1; }
  if (flags as int64 != 0x42)   { PrintStr("FAIL: explicit flags\n"); return 1; }
  if (value          != 9999)   { PrintStr("FAIL: explicit value\n"); return 1; }
  PrintStr("OK: explicit at(offset) layout\n");
  return 0;
}

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testPackedFieldOffsets();
  failed := failed + testUnpackedStride();
  failed := failed + testMixedPackedSizes();
  failed := failed + testExplicitOffsets();
  if (failed != 0) {
    PrintStr("FAILED\n");
    return 1;
  }
  PrintStr("ALL PASSED\n");
  return 0;
}
