// tests/pgp02_packet_test.lyx — PGP-02: packet format iterator
//
// Hand-crafted test packets:
//   Old-format, ll=0 (1-byte length): tag byte 0x{tag*4|0x80}, len, body
//   Old-format, ll=1 (2-byte length): tag byte 0x{tag*4|0x81}, lenHi, lenLo, body
//   New-format, 1-byte length (<192): tag byte 0xC0|tag, len, body

unit tests.pgp02_packet_test;

import std.pgp.core;
import std.pgp.packet;
import std.alloc;
import std.io;

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Test 1: PgpPacketFirst — old-format UID packet (tag=13, ll=0)
    //   tag byte: 0x80 | (13 << 2) | 0 = 0x80 | 0x34 = 0xB4
    //   body: "Hi" (2 bytes: 0x48 0x69)
    // -------------------------------------------------------------------------
    var buf1: int64 := alloc(16);
    poke8(buf1, 0xB4);        // 0x80|(13<<2)|0 = 0xB4
    poke8(buf1+1, 2);         // length = 2
    poke8(buf1+2, 0x48);      // 'H'
    poke8(buf1+3, 0x69);      // 'i'

    var pkt: int64 := alloc(PGP_PKT_SIZE);
    var r1: int64 := PgpPacketFirst(buf1, 4, pkt);
    if (r1 != 1) {
        PrintLn("FAIL: PgpPacketFirst old-fmt returned 0"c); ok := 0;
    } else {
        PrintLn("PASS: PgpPacketFirst old-fmt ret=1"c);
        var tag1: int64 := peek64(pkt + PGP_PKT_OFF_TAG);
        var blen1: int64 := peek64(pkt + PGP_PKT_OFF_BLEN);
        var body1: int64 := peek64(pkt + PGP_PKT_OFF_BODY);
        if (tag1 != PGP_TAG_UID) { PrintLn("FAIL: tag != UID(13)"c); ok := 0; }
        else { PrintLn("PASS: tag=UID(13)"c); }
        if (blen1 != 2) { PrintLn("FAIL: blen != 2"c); ok := 0; }
        else { PrintLn("PASS: blen=2"c); }
        if (peek8(body1) != 0x48 || peek8(body1+1) != 0x69) {
            PrintLn("FAIL: body != 'Hi'"c); ok := 0;
        } else {
            PrintLn("PASS: body='Hi'"c);
        }
    }
    free(buf1, 16);

    // -------------------------------------------------------------------------
    // Test 2: Two old-format packets — iterate with PgpPacketNext
    //   Packet A: tag=6 (PUBKEY), ll=0, len=3, body=[0x01,0x02,0x03]
    //     tag byte: 0x80|(6<<2)|0 = 0x80|0x18 = 0x98
    //   Packet B: tag=13 (UID), ll=0, len=2, body=[0x41,0x42]
    //     tag byte: 0xB4
    // -------------------------------------------------------------------------
    var buf2: int64 := alloc(16);
    poke8(buf2,    0x98);  // tag=6, ll=0
    poke8(buf2+1,  3);     // len=3
    poke8(buf2+2,  0x01);
    poke8(buf2+3,  0x02);
    poke8(buf2+4,  0x03);
    poke8(buf2+5,  0xB4);  // tag=13, ll=0
    poke8(buf2+6,  2);     // len=2
    poke8(buf2+7,  0x41);  // 'A'
    poke8(buf2+8,  0x42);  // 'B'

    var r2a: int64 := PgpPacketFirst(buf2, 9, pkt);
    if (r2a != 1) {
        PrintLn("FAIL: PgpPacketFirst packet A returned 0"c); ok := 0;
    } else {
        var tagA: int64 := peek64(pkt + PGP_PKT_OFF_TAG);
        if (tagA != PGP_TAG_PUBKEY) { PrintLn("FAIL: packet A tag != PUBKEY(6)"c); ok := 0; }
        else { PrintLn("PASS: packet A tag=PUBKEY(6)"c); }
    }

    var r2b: int64 := PgpPacketNext(buf2, 9, pkt);
    if (r2b != 1) {
        PrintLn("FAIL: PgpPacketNext packet B returned 0"c); ok := 0;
    } else {
        var tagB: int64 := peek64(pkt + PGP_PKT_OFF_TAG);
        var blenB: int64 := peek64(pkt + PGP_PKT_OFF_BLEN);
        if (tagB != PGP_TAG_UID) { PrintLn("FAIL: packet B tag != UID(13)"c); ok := 0; }
        else { PrintLn("PASS: packet B tag=UID(13)"c); }
        if (blenB != 2) { PrintLn("FAIL: packet B blen != 2"c); ok := 0; }
        else { PrintLn("PASS: packet B blen=2"c); }
    }

    var r2c: int64 := PgpPacketNext(buf2, 9, pkt);
    if (r2c != 0) {
        PrintLn("FAIL: PgpPacketNext past end should return 0"c); ok := 0;
    } else {
        PrintLn("PASS: PgpPacketNext past end → 0"c);
    }
    free(buf2, 16);

    // -------------------------------------------------------------------------
    // Test 3: new-format packet (bit 6 set), 1-byte length
    //   tag=2 (SIG), new-format: tag byte = 0xC0 | 2 = 0xC2, len=4, body=[1,2,3,4]
    // -------------------------------------------------------------------------
    var buf3: int64 := alloc(16);
    poke8(buf3,   0xC2);  // 0xC0|2 = new-format SIG
    poke8(buf3+1, 4);     // length = 4
    poke8(buf3+2, 0x01);
    poke8(buf3+3, 0x02);
    poke8(buf3+4, 0x03);
    poke8(buf3+5, 0x04);

    var r3: int64 := PgpPacketFirst(buf3, 6, pkt);
    if (r3 != 1) {
        PrintLn("FAIL: PgpPacketFirst new-fmt returned 0"c); ok := 0;
    } else {
        var tag3: int64 := peek64(pkt + PGP_PKT_OFF_TAG);
        var blen3: int64 := peek64(pkt + PGP_PKT_OFF_BLEN);
        if (tag3 != PGP_TAG_SIG) { PrintLn("FAIL: new-fmt tag != SIG(2)"c); ok := 0; }
        else { PrintLn("PASS: new-fmt tag=SIG(2)"c); }
        if (blen3 != 4) { PrintLn("FAIL: new-fmt blen != 4"c); ok := 0; }
        else { PrintLn("PASS: new-fmt blen=4"c); }
    }
    free(buf3, 16);

    // -------------------------------------------------------------------------
    // Test 4: old-format with 2-byte length (ll=1)
    //   tag=11 (LITERAL), ll=1: tag byte = 0x80|(11<<2)|1 = 0x80|0x2C|1 = 0xAD
    //   length = 0x0100 = 256, body = first 5 bytes to check (buf size limit)
    // -------------------------------------------------------------------------
    var buf4: int64 := alloc(12);
    poke8(buf4,   0xAD);  // tag=11, ll=1
    poke8(buf4+1, 0x00);  // lenHi
    poke8(buf4+2, 0x05);  // lenLo  → 5 bytes
    poke8(buf4+3, 0xAA);
    poke8(buf4+4, 0xBB);
    poke8(buf4+5, 0xCC);
    poke8(buf4+6, 0xDD);
    poke8(buf4+7, 0xEE);

    var r4: int64 := PgpPacketFirst(buf4, 8, pkt);
    if (r4 != 1) {
        PrintLn("FAIL: 2-byte-len packet returned 0"c); ok := 0;
    } else {
        var tag4: int64 := peek64(pkt + PGP_PKT_OFF_TAG);
        var blen4: int64 := peek64(pkt + PGP_PKT_OFF_BLEN);
        if (tag4 != PGP_TAG_LITERAL) { PrintLn("FAIL: 2-byte-len tag != LITERAL(11)"c); ok := 0; }
        else { PrintLn("PASS: 2-byte-len tag=LITERAL(11)"c); }
        if (blen4 != 5) { PrintLn("FAIL: 2-byte-len blen != 5"c); ok := 0; }
        else { PrintLn("PASS: 2-byte-len blen=5"c); }
    }
    free(buf4, 12);

    // -------------------------------------------------------------------------
    // Test 5: empty buffer → PgpPacketFirst returns 0
    // -------------------------------------------------------------------------
    var buf5: int64 := alloc(4);
    var r5: int64 := PgpPacketFirst(buf5, 0, pkt);
    free(buf5, 4);
    if (r5 != 0) {
        PrintLn("FAIL: empty buf should return 0"c); ok := 0;
    } else {
        PrintLn("PASS: empty buf → 0"c);
    }

    free(pkt, PGP_PKT_SIZE);

    if (ok != 0) { PrintLn("=== PGP-02: ALL PASS ==="c); }
    else         { PrintLn("=== PGP-02: SOME FAIL ==="c); }
    return ok;
}
