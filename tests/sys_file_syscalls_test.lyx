// tests/sys_file_syscalls_test.lyx — sys_open / sys_lseek auf dem ELF-Pfad.
//
// sys_read, sys_write und sys_close waren im x86-Codegen als Alias der
// gleichnamigen Builtins vorhanden, sys_open/sys_lseek/sys_stat nicht — obwohl
// sys_open in sema registriert und im IR-Pfad gelowert war. Auf ELF starb der
// Aufruf deshalb mit "no codegen implementation found", auf lyxos lief er.
// sys_lseek war zudem gar nicht registriert.
//
// Geprüft wird ein echter Datei-Roundtrip, nicht nur Übersetzbarkeit: schreiben,
// zurücklesen, Inhalt vergleichen, per lseek die Größe bestimmen.

import std.io;
import std.alloc;
var fails: int64 := 0;
fn e(n: pchar, g: int64, w: int64) { Print(n); Print(": "); if (g == w) { PrintLn("OK"); } else { Print("FAIL "); PrintInt(g); PrintLn(""); fails += 1; } }
fn main(): int64 {
  // schreiben ueber sys_open/sys_write/sys_close
  var fd: int64 := sys_open("/tmp/lyx_sysopen_test.txt", 65, 384);   // O_WRONLY|O_CREAT, 0600
  if (fd < 0) { PrintLn("open zum Schreiben fehlgeschlagen"); return 1; }
  var n: int64 := sys_write(fd, "hallo" as int64, 5);
  e("sys_write", n, 5);
  sys_close(fd);

  // zurueck lesen
  fd := sys_open("/tmp/lyx_sysopen_test.txt", 0, 0);
  e("sys_open lesend", fd >= 0 as int64, 1);
  var buf: int64 := alloc(16);
  var r: int64 := sys_read(fd, buf, 16);
  e("sys_read Laenge", r, 5);
  e("Inhalt[0]", peek8(buf) & 255, 104);       // 'h'
  e("Inhalt[4]", peek8(buf + 4) & 255, 111);   // 'o'

  // sys_lseek: ans Ende springen -> Dateigroesse
  var end: int64 := sys_lseek(fd, 0, 2);
  e("sys_lseek Ende", end, 5);
  sys_close(fd);
  unlink("/tmp/lyx_sysopen_test.txt");
  if (fails == 0) { PrintLn("ALL OK"); return 0; }
  return 1;
}
