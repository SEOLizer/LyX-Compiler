// tests/aws_demo6_secrets_iam.lyx — AWS SDK Demo: Secrets Manager + SSM + IAM/STS
// WP-AWS-15

unit tests.aws_demo6_secrets_iam;

import std.cloud.aws.core;
import std.cloud.secrets;
import std.cloud.iam;
import std.alloc;
import std.io;

pub fn main(argc: int64, argv: pchar): int64 {
    PrintLn("=== AWS Secrets + IAM Demo ==="c);

    var creds: AWSCreds := AWSCredentialsDefault();
    if (creds.accessKey == 0) {
        PrintLn("Error: no credentials found."c);
        return 1;
    }

    var region: pchar := "eu-central-1"c;
    if (creds.region != 0) { region := creds.region as pchar; }

    // ── STS: Who am I? ────────────────────────────────────────────────────────

    PrintLn("--- STS: GetCallerIdentity ---"c);
    var stsCreds: AWSCreds := AWSCredentialsDefault();
    var stsClient: STSClient := STSConnect(stsCreds, region);
    var identity: int64 := STSGetCallerIdentity(stsClient);
    if (identity != 0) { PrintLn(identity as pchar); free(identity, StrLen(identity as pchar)+1); }
    STSClose(stsClient);

    // ── IAM ───────────────────────────────────────────────────────────────────

    PrintLn("--- IAM: List Users ---"c);
    var iamCreds: AWSCreds := AWSCredentialsDefault();
    var iamClient: IAMClient := IAMConnect(iamCreds);
    var users: int64 := IAMListUsers(iamClient);
    if (users != 0) { PrintLn(users as pchar); free(users, StrLen(users as pchar)+1); }

    PrintLn("--- IAM: List Roles ---"c);
    var roles: int64 := IAMListRoles(iamClient);
    if (roles != 0) { PrintLn(roles as pchar); free(roles, StrLen(roles as pchar)+1); }

    PrintLn("--- IAM: Get Current User ---"c);
    var me: IAMUser := IAMGetUser(iamClient, 0 as pchar);
    if (me.userName != 0) {
        Print("UserName: "c); PrintLn(me.userName as pchar);
        Print("ARN: "c); PrintLn(me.arn as pchar);
    }
    IAMUserFree(me);
    IAMClose(iamClient);

    // ── Secrets Manager ───────────────────────────────────────────────────────

    PrintLn("--- Secrets: List ---"c);
    var secCreds: AWSCreds := AWSCredentialsDefault();
    var secClient: SecretsClient := SecretsConnect(secCreds, region);
    var secrets: int64 := SecretsListSecrets(secClient);
    if (secrets != 0) { PrintLn(secrets as pchar); free(secrets, StrLen(secrets as pchar)+1); }

    PrintLn("--- Secrets: Create ---"c);
    var secretName: pchar := "lyxaws/demo/db-password"c;
    var secretVal:  pchar := "{\"password\":\"sup3rs3cr3t!\",\"user\":\"admin\"}"c;
    var createResult: int64 := SecretsCreateSecret(secClient, secretName, secretVal,
                                                    "Demo DB password"c, 0 as pchar);
    if (createResult != 0) {
        PrintLn("Secret created"c);
        free(createResult, StrLen(createResult as pchar)+1);
    } else {
        PrintLn("Create failed (may already exist, trying get)"c);
    }

    PrintLn("--- Secrets: Get Value ---"c);
    var val: int64 := SecretsGetString(secClient, secretName);
    if (val != 0) {
        Print("Secret value: "c); PrintLn(val as pchar);
        free(val, StrLen(val as pchar)+1);
    } else {
        PrintLn("Not found or error"c);
    }

    PrintLn("--- Secrets: Update Value ---"c);
    var updateResult: int64 := SecretsPutValue(secClient, secretName,
                                                "{\"password\":\"n3wp4ssw0rd!\",\"user\":\"admin\"}"c);
    if (updateResult != 0) { PrintLn("Updated"c); free(updateResult, StrLen(updateResult as pchar)+1); }
    else { PrintLn("Update failed"c); }

    PrintLn("--- Secrets: Tag ---"c);
    SecretsTagResource(secClient, secretName, "Environment"c, "demo"c);

    PrintLn("--- Secrets: Delete ---"c);
    var ok: int64 := SecretsDeleteSecret(secClient, secretName, 0, 1); // force delete
    if (ok == 1) { PrintLn("Secret deleted"c); } else { PrintLn("Delete failed"c); }

    SecretsClose(secClient);

    // ── SSM Parameter Store ───────────────────────────────────────────────────

    PrintLn("--- SSM: Put Parameter ---"c);
    var ssmCreds: AWSCreds := AWSCredentialsDefault();
    var ssmClient: SSMClient := SSMConnect(ssmCreds, region);

    ok := SSMPutParameter(ssmClient, "/lyxaws/demo/config/env"c,
                          "production"c, "String"c, 1, 0 as pchar);
    if (ok == 1) { PrintLn("SSM parameter stored"c); } else { PrintLn("SSM put failed"c); }

    ok := SSMPutParameter(ssmClient, "/lyxaws/demo/config/debug"c,
                          "false"c, "String"c, 1, 0 as pchar);

    PrintLn("--- SSM: Get Parameter ---"c);
    var ssmVal: int64 := SSMGetParameterValue(ssmClient, "/lyxaws/demo/config/env"c);
    if (ssmVal != 0) {
        Print("Value: "c); PrintLn(ssmVal as pchar);
        free(ssmVal, StrLen(ssmVal as pchar)+1);
    }

    PrintLn("--- SSM: Get Parameters by Path ---"c);
    var pathParams: int64 := SSMGetParametersByPath(ssmClient, "/lyxaws/demo/config"c, 1, 1);
    if (pathParams != 0) { PrintLn(pathParams as pchar); free(pathParams, StrLen(pathParams as pchar)+1); }

    PrintLn("--- SSM: Delete Parameters ---"c);
    SSMDeleteParameter(ssmClient, "/lyxaws/demo/config/env"c);
    SSMDeleteParameter(ssmClient, "/lyxaws/demo/config/debug"c);
    PrintLn("SSM parameters cleaned up"c);

    SSMClose(ssmClient);
    PrintLn("=== Done ==="c);
    return 0;
}
