// tests/pdf_layer_test.lyx
// WP-PDF-16: optional content groups (layers)

@description("WP-PDF-16: PDF layer (OCG) tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pdf_layer_test;

import std.pdf;

fn testLayerBasic(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var layerIdx: int64 := PdfAddLayer(doc, "Background");
  if (layerIdx != 0) {
    Print("FAIL: PdfAddLayer index expected 0, got ");
    PrintInt(layerIdx);
    Print("\n");
    PdfFree(doc);
    return 1;
  }

  PdfLayerBegin(doc, page, layerIdx);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "Background layer text");
  PdfLayerEnd(doc, page);

  var err: int64 := PdfSave(doc, "/tmp/pdf_layer_basic.pdf");
  PdfFree(doc);
  if (err != 0) {
    Print("FAIL: PdfSave err=");
    PrintInt(err);
    Print("\n");
    return 1;
  }

  var rdr: int64 := PdfOpen("/tmp/pdf_layer_basic.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 1) {
    Print("FAIL: page count expected 1, got ");
    PrintInt(n);
    Print("\n");
    return 1;
  }
  Print("OK: basic single layer\n");
  return 0;
}

fn testLayerMultiple(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (multi)\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var l0: int64 := PdfAddLayer(doc, "Layer0");
  var l1: int64 := PdfAddLayer(doc, "Layer1");
  var l2: int64 := PdfAddLayer(doc, "Layer2");

  if (l0 != 0 || l1 != 1 || l2 != 2) {
    Print("FAIL: layer indices l0=");
    PrintInt(l0);
    Print(" l1=");
    PrintInt(l1);
    Print(" l2=");
    PrintInt(l2);
    Print("\n");
    PdfFree(doc);
    return 1;
  }

  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 10.0);

  PdfLayerBegin(doc, page, l0);
  PdfTextAt(doc, page, 72.0, 750.0, "Layer 0 content");
  PdfLayerEnd(doc, page);

  PdfLayerBegin(doc, page, l1);
  PdfTextAt(doc, page, 72.0, 730.0, "Layer 1 content");
  PdfLayerEnd(doc, page);

  PdfLayerBegin(doc, page, l2);
  PdfTextAt(doc, page, 72.0, 710.0, "Layer 2 content");
  PdfLayerEnd(doc, page);

  var err: int64 := PdfSave(doc, "/tmp/pdf_layer_multi.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (multi)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_layer_multi.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (multi)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 1) { Print("FAIL: multi page count\n"); return 1; }
  Print("OK: multiple layers on one page\n");
  return 0;
}

fn testLayerHidden(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (hidden)\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var lVisible: int64 := PdfAddLayer(doc, "Visible");
  var lHidden:  int64 := PdfAddLayer(doc, "Hidden");

  PdfLayerSetVisible(doc, lHidden, 0);

  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);

  PdfLayerBegin(doc, page, lVisible);
  PdfTextAt(doc, page, 72.0, 750.0, "This is visible by default");
  PdfLayerEnd(doc, page);

  PdfLayerBegin(doc, page, lHidden);
  PdfTextAt(doc, page, 72.0, 730.0, "This is hidden by default");
  PdfLayerEnd(doc, page);

  var err: int64 := PdfSave(doc, "/tmp/pdf_layer_hidden.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (hidden)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_layer_hidden.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (hidden)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 1) { Print("FAIL: hidden layer page count\n"); return 1; }
  Print("OK: hidden layer (off by default)\n");
  return 0;
}

fn testLayerNoLayers(): int64 {
  // PDF without any layers: OCProperties must be absent, no regression
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (none)\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "No layers here");

  var err: int64 := PdfSave(doc, "/tmp/pdf_layer_none.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (none)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_layer_none.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (none)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 1) { Print("FAIL: no-layer page count\n"); return 1; }
  Print("OK: no layers — PDF unaffected\n");
  return 0;
}

fn testLayerWithOutline(): int64 {
  // Layers combined with outline bookmarks
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew (outline)\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);

  var l0: int64 := PdfAddLayer(doc, "PageOneContent");
  var l1: int64 := PdfAddLayer(doc, "PageTwoContent");

  PdfOutlineAdd(doc, -1, "Page One", 0);
  PdfOutlineAdd(doc, -1, "Page Two", 1);

  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfLayerBegin(doc, p0, l0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Page one with layer");
  PdfLayerEnd(doc, p0);

  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfLayerBegin(doc, p1, l1);
  PdfTextAt(doc, p1, 72.0, 750.0, "Page two with layer");
  PdfLayerEnd(doc, p1);

  var err: int64 := PdfSave(doc, "/tmp/pdf_layer_outline.pdf");
  PdfFree(doc);
  if (err != 0) { Print("FAIL: PdfSave (outline)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_layer_outline.pdf");
  if (rdr == 0) { Print("FAIL: PdfOpen (outline)\n"); return 1; }
  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 2) { Print("FAIL: outline+layer page count\n"); return 1; }
  Print("OK: layers combined with outline\n");
  return 0;
}

pub fn main(): int64 {
  if (testLayerBasic()       != 0) { return 1; }
  if (testLayerMultiple()    != 0) { return 1; }
  if (testLayerHidden()      != 0) { return 1; }
  if (testLayerNoLayers()    != 0) { return 1; }
  if (testLayerWithOutline() != 0) { return 1; }
  Print("All WP-PDF-16 layer tests passed.\n");
  return 0;
}
