// tests/pgp03_key_test.lyx — PGP-03: key packet parsing + v4 fingerprint
//
// Minimal v4 RSA public-key body:
//   [0x04]              version=4
//   [0x00,0x00,0x00,0x00] timestamp=0
//   [0x01]              algo=RSA (PGP_ALG_RSA)
//   [0x00,0x08, 0x01]   MPI: 8 bits, value=0x01 (tiny fake RSA n)
//   [0x00,0x08, 0x01]   MPI: 8 bits, value=0x01 (tiny fake RSA e)
// Total: 12 bytes

unit tests.pgp03_key_test;

import std.pgp.core;
import std.pgp.key;
import std.alloc;
import std.io;

fn makeV4KeyBody(buf: int64): int64 {
    poke8(buf,    0x04);  // version=4
    poke8(buf+1,  0x00);  // timestamp (big-endian, 4 bytes)
    poke8(buf+2,  0x00);
    poke8(buf+3,  0x00);
    poke8(buf+4,  0x00);
    poke8(buf+5,  0x01);  // algo=RSA
    poke8(buf+6,  0x00);  // MPI n: bit-count hi
    poke8(buf+7,  0x08);  // MPI n: bit-count lo = 8 bits
    poke8(buf+8,  0x01);  // MPI n: value byte
    poke8(buf+9,  0x00);  // MPI e: bit-count hi
    poke8(buf+10, 0x08);  // MPI e: bit-count lo = 8 bits
    poke8(buf+11, 0x01);  // MPI e: value byte
    return 12;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    var body: int64 := alloc(16);
    var blen: int64 := makeV4KeyBody(body);

    // -------------------------------------------------------------------------
    // Test 1: PgpKeyVersion → 4
    // -------------------------------------------------------------------------
    var ver: int64 := PgpKeyVersion(body, blen);
    if (ver != 4) { PrintLn("FAIL: PgpKeyVersion != 4"c); ok := 0; }
    else           { PrintLn("PASS: PgpKeyVersion=4"c); }

    // -------------------------------------------------------------------------
    // Test 2: PgpKeyAlgo → PGP_ALG_RSA (1)
    // -------------------------------------------------------------------------
    var algo: int64 := PgpKeyAlgo(body, blen);
    if (algo != PGP_ALG_RSA) { PrintLn("FAIL: PgpKeyAlgo != RSA"c); ok := 0; }
    else                      { PrintLn("PASS: PgpKeyAlgo=RSA(1)"c); }

    // -------------------------------------------------------------------------
    // Test 3: PgpKeyTimestamp → 0
    // -------------------------------------------------------------------------
    var ts: int64 := PgpKeyTimestamp(body, blen);
    if (ts != 0) { PrintLn("FAIL: PgpKeyTimestamp != 0"c); ok := 0; }
    else          { PrintLn("PASS: PgpKeyTimestamp=0"c); }

    // -------------------------------------------------------------------------
    // Test 4: PgpKeyFingerprint returns 1, produces 20 bytes
    // -------------------------------------------------------------------------
    var fp: int64 := alloc(20);
    var rfp: int64 := PgpKeyFingerprint(body, blen, fp);
    if (rfp != 1) { PrintLn("FAIL: PgpKeyFingerprint returned 0"c); ok := 0; }
    else           { PrintLn("PASS: PgpKeyFingerprint ret=1"c); }

    // -------------------------------------------------------------------------
    // Test 5: fingerprint is deterministic
    // -------------------------------------------------------------------------
    var fp2: int64 := alloc(20);
    PgpKeyFingerprint(body, blen, fp2);
    var same: int64 := 1;
    var i: int64 := 0;
    while (i < 20) {
        if (peek8(fp + i) != peek8(fp2 + i)) { same := 0; }
        i := i + 1;
    }
    free(fp2, 20);
    if (same != 1) { PrintLn("FAIL: fingerprint not deterministic"c); ok := 0; }
    else            { PrintLn("PASS: fingerprint deterministic"c); }

    // -------------------------------------------------------------------------
    // Test 6: PgpKeyId — last 8 bytes of fingerprint
    // -------------------------------------------------------------------------
    var kid: int64 := alloc(8);
    var rkid: int64 := PgpKeyId(body, blen, kid);
    if (rkid != 1) { PrintLn("FAIL: PgpKeyId returned 0"c); ok := 0; }
    else            { PrintLn("PASS: PgpKeyId ret=1"c); }

    var kidMatch: int64 := 1;
    var j: int64 := 0;
    while (j < 8) {
        if (peek8(kid + j) != peek8(fp + 12 + j)) { kidMatch := 0; }
        j := j + 1;
    }
    if (kidMatch != 1) { PrintLn("FAIL: key ID != last 8 bytes of fingerprint"c); ok := 0; }
    else                { PrintLn("PASS: key ID = last 8 bytes of fingerprint"c); }
    free(kid, 8);

    // -------------------------------------------------------------------------
    // Test 7: PgpKeyVersion — too short → 0
    // -------------------------------------------------------------------------
    var shortBuf: int64 := alloc(4);
    poke8(shortBuf, 4);
    var verShort: int64 := PgpKeyVersion(shortBuf, 3);
    free(shortBuf, 4);
    if (verShort != 0) { PrintLn("FAIL: too-short body should give version=0"c); ok := 0; }
    else                { PrintLn("PASS: too-short body → version=0"c); }

    // -------------------------------------------------------------------------
    // Test 8: PgpKeyFingerprint — v3 body → 0 (unsupported)
    // -------------------------------------------------------------------------
    var v3body: int64 := alloc(16);
    var v3i: int64 := 0;
    while (v3i < 16) { poke8(v3body + v3i, 0); v3i := v3i + 1; }
    poke8(v3body, 3);  // version=3
    var fpv3: int64 := alloc(20);
    var rfpv3: int64 := PgpKeyFingerprint(v3body, 12, fpv3);
    free(fpv3, 20);
    free(v3body, 16);
    if (rfpv3 != 0) { PrintLn("FAIL: v3 fingerprint should return 0"c); ok := 0; }
    else             { PrintLn("PASS: v3 fingerprint → 0 (unsupported)"c); }

    free(fp, 20);
    free(body, 16);

    if (ok != 0) { PrintLn("=== PGP-03: ALL PASS ==="c); }
    else         { PrintLn("=== PGP-03: SOME FAIL ==="c); }
    return ok;
}
