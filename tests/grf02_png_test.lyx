// tests/grf02_png_test.lyx — GRF-02: PNG Decoder/Encoder Tests

unit tests.grf02_png_test;

import std.image.core;
import std.image.png;
import std.alloc;
import std.io;

// Write bytes from a hex string literal into a buffer.
// Returns number of bytes written.
fn writePngBytes(dst: int64, bytes: int64, count: int64): void {
    var i: int64 := 0;
    while (i < count) {
        poke8(dst + i, peek8(bytes + i));
        i := i + 1;
    }
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Test 1: PngEncode → PngDecode round-trip (store-only, filter 0)
    // -------------------------------------------------------------------------
    var imgSrc: int64 := GrfImageAlloc(4, 4);
    GrfImageClear(imgSrc, 0xFF0000FF);     // all red
    GrfImageSetPixel(imgSrc, 1, 1, 0x00FF00FF);  // one green pixel
    GrfImageSetPixel(imgSrc, 2, 2, 0x0000FFFF);  // one blue pixel
    GrfImageSetPixel(imgSrc, 3, 3, 0x000000AA);  // one semi-transparent black

    // Estimate max output size: 8 + 25 + 4+4+idatSz+4 + 12
    // filtSize = 4*(4*4+1) = 4*17 = 68 bytes, 1 block: deflSz=5+68=73, idatSz=2+73+4=79
    // total ≈ 8+25+79+12+12 = ~136, use 512 for safety
    var encBuf: int64 := alloc(512);
    var encLen: int64 := PngEncode(imgSrc, encBuf, 512);
    if (encLen <= 0) {
        PrintLn("FAIL: PngEncode returned 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: PngEncode returned > 0"c);

        // Decode back
        var imgDst: int64 := alloc(GRF_SIZE);
        var retDec: int64 := PngDecode(encBuf, encLen, imgDst);
        if (retDec != 1) {
            PrintLn("FAIL: PngDecode on encoded data"c);
            ok := 0;
        } else {
            PrintLn("PASS: PngDecode returned 1"c);

            // Check dimensions
            var dw: int64 := peek64(imgDst + GRF_OFF_WIDTH);
            var dh: int64 := peek64(imgDst + GRF_OFF_HEIGHT);
            if (dw != 4 || dh != 4) {
                PrintLn("FAIL: decoded dimensions wrong"c);
                ok := 0;
            } else {
                PrintLn("PASS: decoded 4x4"c);
            }

            // Check pixel values (round-trip)
            var rtOk: int64 := 1;
            var qy: int64 := 0;
            while (qy < 4) {
                var qx: int64 := 0;
                while (qx < 4) {
                    var pSrc: int64 := GrfImageGetPixel(imgSrc, qx, qy);
                    var pDst: int64 := GrfImageGetPixel(imgDst, qx, qy);
                    if (pSrc != pDst) { rtOk := 0; }
                    qx := qx + 1;
                }
                qy := qy + 1;
            }
            if (rtOk == 0) {
                PrintLn("FAIL: PngEncode/PngDecode round-trip pixel mismatch"c);
                ok := 0;
            } else {
                PrintLn("PASS: PngEncode/PngDecode round-trip 4x4 RGBA"c);
            }
        }
        GrfImageFree(imgDst);
    }
    GrfImageFree(imgSrc);
    free(encBuf, 512);

    // -------------------------------------------------------------------------
    // Test 2: Invalid signature → return 0
    // -------------------------------------------------------------------------
    var badBuf: int64 := alloc(16);
    poke8(badBuf,     0x00); poke8(badBuf + 1, 0x00);
    poke8(badBuf + 2, 0x00); poke8(badBuf + 3, 0x00);
    var imgBad: int64 := alloc(GRF_SIZE);
    var retBad: int64 := PngDecode(badBuf, 16, imgBad);
    if (retBad != 0) {
        PrintLn("FAIL: PngDecode bad sig should return 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: PngDecode bad sig → 0"c);
    }
    free(badBuf, 16);
    free(imgBad, GRF_SIZE);

    // -------------------------------------------------------------------------
    // Test 3: PngEncode + PngDecode for grayscale (color type 0 decode only)
    // We encode as RGBA, then verify a larger decode round-trip
    // -------------------------------------------------------------------------
    var imgGray: int64 := GrfImageAlloc(2, 2);
    GrfImageSetPixel(imgGray, 0, 0, 0x808080FF);
    GrfImageSetPixel(imgGray, 1, 0, 0x404040FF);
    GrfImageSetPixel(imgGray, 0, 1, 0xC0C0C0FF);
    GrfImageSetPixel(imgGray, 1, 1, 0xFFFFFFFF);
    var encGray: int64 := alloc(512);
    var encLenG: int64 := PngEncode(imgGray, encGray, 512);
    if (encLenG <= 0) {
        PrintLn("FAIL: PngEncode gray-like image"c);
        ok := 0;
    } else {
        var imgGrayDec: int64 := alloc(GRF_SIZE);
        var retGrayDec: int64 := PngDecode(encGray, encLenG, imgGrayDec);
        if (retGrayDec != 1) {
            PrintLn("FAIL: PngDecode gray-like"c);
            ok := 0;
        } else {
            var p00: int64 := GrfImageGetPixel(imgGrayDec, 0, 0);
            var p11: int64 := GrfImageGetPixel(imgGrayDec, 1, 1);
            if (p00 != 0x808080FF || p11 != 0xFFFFFFFF) {
                PrintLn("FAIL: gray-like round-trip pixel"c);
                ok := 0;
            } else {
                PrintLn("PASS: gray-like 2x2 round-trip"c);
            }
        }
        GrfImageFree(imgGrayDec);
    }
    GrfImageFree(imgGray);
    free(encGray, 512);

    // -------------------------------------------------------------------------
    // Test 4: PngEncode output starts with correct PNG signature
    // -------------------------------------------------------------------------
    var imgSig: int64 := GrfImageAlloc(1, 1);
    GrfImageSetPixel(imgSig, 0, 0, 0xABCDEFFF);
    var sigBuf: int64 := alloc(512);
    var sigLen: int64 := PngEncode(imgSig, sigBuf, 512);
    if (sigLen > 8) {
        var s0: int64 := peek8(sigBuf);
        var s1: int64 := peek8(sigBuf + 1);
        var s2: int64 := peek8(sigBuf + 2);
        var s3: int64 := peek8(sigBuf + 3);
        if (s0 != 0x89 || s1 != 0x50 || s2 != 0x4E || s3 != 0x47) {
            PrintLn("FAIL: PngEncode signature wrong"c);
            ok := 0;
        } else {
            PrintLn("PASS: PngEncode signature correct"c);
        }
        // Decode 1x1 back
        var imgOne: int64 := alloc(GRF_SIZE);
        var retOne: int64 := PngDecode(sigBuf, sigLen, imgOne);
        if (retOne != 1) {
            PrintLn("FAIL: PngDecode 1x1"c);
            ok := 0;
        } else {
            var p1x1: int64 := GrfImageGetPixel(imgOne, 0, 0);
            if (p1x1 != 0xABCDEFFF) {
                PrintLn("FAIL: 1x1 RGBA pixel wrong"c);
                ok := 0;
            } else {
                PrintLn("PASS: 1x1 RGBA pixel correct"c);
            }
        }
        GrfImageFree(imgOne);
    } else {
        PrintLn("FAIL: PngEncode 1x1 returned 0"c);
        ok := 0;
    }
    GrfImageFree(imgSig);
    free(sigBuf, 512);

    if (ok != 0) {
        PrintLn("=== GRF-02: ALL PASS ==="c);
    } else {
        PrintLn("=== GRF-02: SOME FAIL ==="c);
    }
    return ok;
}
