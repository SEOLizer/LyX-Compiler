// tests/edi07_inventory_test.lyx — EDI-07: INVRPT + SLSRPT + SLSFCT tests

unit tests.edi07_inventory_test;

import std.edi.core;
import std.edi.inventory;
import std.alloc;
import std.io;

fn hasTag(buf: int64, bufLen: int64, t0: int64, t1: int64, t2: int64): int64 {
    var i: int64 := 0;
    while (i + 2 < bufLen) {
        if (peek8(buf+i) == t0 && peek8(buf+i+1) == t1 && peek8(buf+i+2) == t2) {
            return 1;
        }
        i := i + 1;
    }
    return 0;
}

fn memEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
        if (peek8(a+i) != peek8(b+i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Tests 1-5: INVRPT write — 3 lines with all 3 stock types
    // -------------------------------------------------------------------------
    var buf1: int64 := alloc(4096);
    var zi: int64 := 0;
    while (zi < 4096) { poke8(buf1 + zi, 0); zi := zi + 1; }

    var ilines: int64 := alloc(3 * EDI_INV_LINE_SIZE);
    zi := 0;
    while (zi < 3 * EDI_INV_LINE_SIZE) { poke8(ilines + zi, 0); zi := zi + 1; }

    // Line 0: on-hand
    var il0: int64 := ilines + 0 * EDI_INV_LINE_SIZE;
    poke64(il0 + EDI_INV_LINE_GTIN,      "01234565"c as int64);
    poke64(il0 + EDI_INV_LINE_GTINLEN,   8);
    poke64(il0 + EDI_INV_LINE_WAREHOUSE, "4012345000014"c as int64);
    poke64(il0 + EDI_INV_LINE_WHLEN,     13);
    poke64(il0 + EDI_INV_LINE_QTY,       500);
    poke64(il0 + EDI_INV_LINE_UNIT,      "EA"c as int64);
    poke64(il0 + EDI_INV_LINE_UNITLEN,   2);
    poke64(il0 + EDI_INV_LINE_TYPE,      1);

    // Line 1: on-order
    var il1: int64 := ilines + 1 * EDI_INV_LINE_SIZE;
    poke64(il1 + EDI_INV_LINE_GTIN,      "01234565"c as int64);
    poke64(il1 + EDI_INV_LINE_GTINLEN,   8);
    poke64(il1 + EDI_INV_LINE_WAREHOUSE, "4012345000014"c as int64);
    poke64(il1 + EDI_INV_LINE_WHLEN,     13);
    poke64(il1 + EDI_INV_LINE_QTY,       200);
    poke64(il1 + EDI_INV_LINE_UNIT,      "EA"c as int64);
    poke64(il1 + EDI_INV_LINE_UNITLEN,   2);
    poke64(il1 + EDI_INV_LINE_TYPE,      2);

    // Line 2: in-transit
    var il2: int64 := ilines + 2 * EDI_INV_LINE_SIZE;
    poke64(il2 + EDI_INV_LINE_GTIN,      "01234565"c as int64);
    poke64(il2 + EDI_INV_LINE_GTINLEN,   8);
    poke64(il2 + EDI_INV_LINE_WAREHOUSE, "4012345000014"c as int64);
    poke64(il2 + EDI_INV_LINE_WHLEN,     13);
    poke64(il2 + EDI_INV_LINE_QTY,       75);
    poke64(il2 + EDI_INV_LINE_UNIT,      "EA"c as int64);
    poke64(il2 + EDI_INV_LINE_UNITLEN,   2);
    poke64(il2 + EDI_INV_LINE_TYPE,      3);

    var w1: int64 := EdiInvrptWrite("INV001"c as int64, "20260615"c as int64, ilines, 3, buf1, 4096);

    if (w1 <= 0) {
        PrintLn("FAIL: EdiInvrptWrite should return > 0"c); ok := 0;
    } else { PrintLn("PASS: EdiInvrptWrite returns > 0"c); }

    // BGM = 66,71,77
    if (hasTag(buf1, w1, 66, 71, 77) != 1) {
        PrintLn("FAIL: INVRPT missing BGM tag"c); ok := 0;
    } else { PrintLn("PASS: INVRPT has BGM tag"c); }

    // QTY = 81,84,89
    if (hasTag(buf1, w1, 81, 84, 89) != 1) {
        PrintLn("FAIL: INVRPT missing QTY tag"c); ok := 0;
    } else { PrintLn("PASS: INVRPT has QTY tag"c); }

    // -------------------------------------------------------------------------
    // Tests 4-9: INVRPT round-trip — all 3 stock types correctly separated
    // -------------------------------------------------------------------------
    var rilines: int64 := alloc(4 * EDI_INV_LINE_SIZE);
    zi := 0;
    while (zi < 4 * EDI_INV_LINE_SIZE) { poke8(rilines + zi, 0); zi := zi + 1; }

    var icnt: int64 := EdiInvrptRead(buf1, w1, rilines, 4);

    if (icnt != 3) {
        PrintLn("FAIL: EdiInvrptRead should return 3 lines"c); ok := 0;
    } else { PrintLn("PASS: EdiInvrptRead returns 3 lines"c); }

    // line[0]: type=1 (on-hand), qty=500
    var ril0: int64 := rilines + 0 * EDI_INV_LINE_SIZE;
    if (peek64(ril0 + EDI_INV_LINE_TYPE) != 1) {
        PrintLn("FAIL: line[0] type should be 1 (on-hand)"c); ok := 0;
    } else { PrintLn("PASS: line[0] type=1 (on-hand)"c); }

    if (peek64(ril0 + EDI_INV_LINE_QTY) != 500) {
        PrintLn("FAIL: line[0] qty should be 500"c); ok := 0;
    } else { PrintLn("PASS: line[0] qty=500"c); }

    // line[1]: type=2 (on-order), qty=200
    var ril1: int64 := rilines + 1 * EDI_INV_LINE_SIZE;
    if (peek64(ril1 + EDI_INV_LINE_TYPE) != 2) {
        PrintLn("FAIL: line[1] type should be 2 (on-order)"c); ok := 0;
    } else { PrintLn("PASS: line[1] type=2 (on-order)"c); }

    if (peek64(ril1 + EDI_INV_LINE_QTY) != 200) {
        PrintLn("FAIL: line[1] qty should be 200"c); ok := 0;
    } else { PrintLn("PASS: line[1] qty=200"c); }

    // line[2]: type=3 (in-transit), qty=75
    var ril2: int64 := rilines + 2 * EDI_INV_LINE_SIZE;
    if (peek64(ril2 + EDI_INV_LINE_TYPE) != 3) {
        PrintLn("FAIL: line[2] type should be 3 (in-transit)"c); ok := 0;
    } else { PrintLn("PASS: line[2] type=3 (in-transit)"c); }

    if (peek64(ril2 + EDI_INV_LINE_QTY) != 75) {
        PrintLn("FAIL: line[2] qty should be 75"c); ok := 0;
    } else { PrintLn("PASS: line[2] qty=75"c); }

    // warehouse GLN round-trip
    var rwp: int64 := peek64(ril0 + EDI_INV_LINE_WAREHOUSE);
    var rwl: int64 := peek64(ril0 + EDI_INV_LINE_WHLEN);
    if (memEq(rwp, rwl, "4012345000014"c as int64, 13) != 1) {
        PrintLn("FAIL: line[0] warehouse GLN mismatch"c); ok := 0;
    } else { PrintLn("PASS: line[0] warehouse GLN=4012345000014"c); }

    free(rilines, 4 * EDI_INV_LINE_SIZE);
    free(ilines, 3 * EDI_INV_LINE_SIZE);
    free(buf1, 4096);

    // -------------------------------------------------------------------------
    // Tests 11-17: SLSRPT write + round-trip (period qualifiers 617/610/102)
    // -------------------------------------------------------------------------
    var buf2: int64 := alloc(4096);
    zi := 0;
    while (zi < 4096) { poke8(buf2 + zi, 0); zi := zi + 1; }

    var slines: int64 := alloc(3 * EDI_SLS_LINE_SIZE);
    zi := 0;
    while (zi < 3 * EDI_SLS_LINE_SIZE) { poke8(slines + zi, 0); zi := zi + 1; }

    // Line 0: weekly (qualifier 617)
    var sl0: int64 := slines + 0 * EDI_SLS_LINE_SIZE;
    poke64(sl0 + EDI_SLS_LINE_GTIN,       "01234565"c as int64);
    poke64(sl0 + EDI_SLS_LINE_GTINLEN,    8);
    poke64(sl0 + EDI_SLS_LINE_POSGLN,     "4000001000017"c as int64);
    poke64(sl0 + EDI_SLS_LINE_POSGLNLEN,  13);
    poke64(sl0 + EDI_SLS_LINE_PERIOD,     617);
    poke64(sl0 + EDI_SLS_LINE_DATE,       "202624"c as int64);
    poke64(sl0 + EDI_SLS_LINE_DATELEN,    6);
    poke64(sl0 + EDI_SLS_LINE_QTY,        120);
    poke64(sl0 + EDI_SLS_LINE_REVENUE,    239880);   // 2398.80
    poke64(sl0 + EDI_SLS_LINE_CURRENCY,   "EUR"c as int64);
    poke64(sl0 + EDI_SLS_LINE_CURRENCYLEN, 3);

    // Line 1: monthly (qualifier 610)
    var sl1: int64 := slines + 1 * EDI_SLS_LINE_SIZE;
    poke64(sl1 + EDI_SLS_LINE_GTIN,       "4006381333931"c as int64);
    poke64(sl1 + EDI_SLS_LINE_GTINLEN,    13);
    poke64(sl1 + EDI_SLS_LINE_POSGLN,     "4000001000017"c as int64);
    poke64(sl1 + EDI_SLS_LINE_POSGLNLEN,  13);
    poke64(sl1 + EDI_SLS_LINE_PERIOD,     610);
    poke64(sl1 + EDI_SLS_LINE_DATE,       "202606"c as int64);
    poke64(sl1 + EDI_SLS_LINE_DATELEN,    6);
    poke64(sl1 + EDI_SLS_LINE_QTY,        500);
    poke64(sl1 + EDI_SLS_LINE_REVENUE,    999500);   // 9995.00
    poke64(sl1 + EDI_SLS_LINE_CURRENCY,   "EUR"c as int64);
    poke64(sl1 + EDI_SLS_LINE_CURRENCYLEN, 3);

    // Line 2: daily (qualifier 102)
    var sl2: int64 := slines + 2 * EDI_SLS_LINE_SIZE;
    poke64(sl2 + EDI_SLS_LINE_GTIN,       "01234565"c as int64);
    poke64(sl2 + EDI_SLS_LINE_GTINLEN,    8);
    poke64(sl2 + EDI_SLS_LINE_POSGLN,     "4000001000017"c as int64);
    poke64(sl2 + EDI_SLS_LINE_POSGLNLEN,  13);
    poke64(sl2 + EDI_SLS_LINE_PERIOD,     102);
    poke64(sl2 + EDI_SLS_LINE_DATE,       "20260615"c as int64);
    poke64(sl2 + EDI_SLS_LINE_DATELEN,    8);
    poke64(sl2 + EDI_SLS_LINE_QTY,        18);
    poke64(sl2 + EDI_SLS_LINE_REVENUE,    35982);    // 359.82
    poke64(sl2 + EDI_SLS_LINE_CURRENCY,   "EUR"c as int64);
    poke64(sl2 + EDI_SLS_LINE_CURRENCYLEN, 3);

    var w2: int64 := EdiSlsrptWrite("SLS001"c as int64, "20260615"c as int64, slines, 3, buf2, 4096);

    if (w2 <= 0) {
        PrintLn("FAIL: EdiSlsrptWrite should return > 0"c); ok := 0;
    } else { PrintLn("PASS: EdiSlsrptWrite returns > 0"c); }

    // MOA = 77,79,65
    if (hasTag(buf2, w2, 77, 79, 65) != 1) {
        PrintLn("FAIL: SLSRPT missing MOA tag"c); ok := 0;
    } else { PrintLn("PASS: SLSRPT has MOA tag"c); }

    var rslines: int64 := alloc(4 * EDI_SLS_LINE_SIZE);
    zi := 0;
    while (zi < 4 * EDI_SLS_LINE_SIZE) { poke8(rslines + zi, 0); zi := zi + 1; }

    var scnt: int64 := EdiSlsrptRead(buf2, w2, rslines, 4);

    if (scnt != 3) {
        PrintLn("FAIL: EdiSlsrptRead should return 3 lines"c); ok := 0;
    } else { PrintLn("PASS: EdiSlsrptRead returns 3 lines"c); }

    // line[0]: period=617 (week), qty=120
    var rsl0: int64 := rslines + 0 * EDI_SLS_LINE_SIZE;
    if (peek64(rsl0 + EDI_SLS_LINE_PERIOD) != 617) {
        PrintLn("FAIL: line[0] period should be 617 (week)"c); ok := 0;
    } else { PrintLn("PASS: line[0] period=617 (week)"c); }

    if (peek64(rsl0 + EDI_SLS_LINE_QTY) != 120) {
        PrintLn("FAIL: line[0] qty should be 120"c); ok := 0;
    } else { PrintLn("PASS: line[0] qty=120"c); }

    // line[1]: period=610 (month)
    var rsl1: int64 := rslines + 1 * EDI_SLS_LINE_SIZE;
    if (peek64(rsl1 + EDI_SLS_LINE_PERIOD) != 610) {
        PrintLn("FAIL: line[1] period should be 610 (month)"c); ok := 0;
    } else { PrintLn("PASS: line[1] period=610 (month)"c); }

    if (peek64(rsl1 + EDI_SLS_LINE_REVENUE) != 999500) {
        PrintLn("FAIL: line[1] revenue should be 999500"c); ok := 0;
    } else { PrintLn("PASS: line[1] revenue=999500 (9995.00)"c); }

    // line[2]: period=102 (day)
    var rsl2: int64 := rslines + 2 * EDI_SLS_LINE_SIZE;
    if (peek64(rsl2 + EDI_SLS_LINE_PERIOD) != 102) {
        PrintLn("FAIL: line[2] period should be 102 (day)"c); ok := 0;
    } else { PrintLn("PASS: line[2] period=102 (day)"c); }

    // revenue for line[0]
    if (peek64(rsl0 + EDI_SLS_LINE_REVENUE) != 239880) {
        PrintLn("FAIL: line[0] revenue should be 239880"c); ok := 0;
    } else { PrintLn("PASS: line[0] revenue=239880 (2398.80)"c); }

    // currency for line[2]
    var rcurp: int64 := peek64(rsl2 + EDI_SLS_LINE_CURRENCY);
    var rcurl: int64 := peek64(rsl2 + EDI_SLS_LINE_CURRENCYLEN);
    if (memEq(rcurp, rcurl, "EUR"c as int64, 3) != 1) {
        PrintLn("FAIL: line[2] currency mismatch"c); ok := 0;
    } else { PrintLn("PASS: line[2] currency=EUR"c); }

    free(rslines, 4 * EDI_SLS_LINE_SIZE);

    // -------------------------------------------------------------------------
    // Tests 20-24: SLSFCT write + round-trip (confidence via FTX+ACB)
    // -------------------------------------------------------------------------
    var buf3: int64 := alloc(4096);
    zi := 0;
    while (zi < 4096) { poke8(buf3 + zi, 0); zi := zi + 1; }

    // Reuse sl0 with confidence added
    poke64(sl0 + EDI_SLS_LINE_CONFIDENCE, 85);   // 85% confident
    poke64(sl1 + EDI_SLS_LINE_CONFIDENCE, 60);   // 60% confident

    var w3: int64 := EdiSlsfctWrite("FCT001"c as int64, "20260615"c as int64, slines, 2, buf3, 4096);

    if (w3 <= 0) {
        PrintLn("FAIL: EdiSlsfctWrite should return > 0"c); ok := 0;
    } else { PrintLn("PASS: EdiSlsfctWrite returns > 0"c); }

    // FTX = 70,84,88
    if (hasTag(buf3, w3, 70, 84, 88) != 1) {
        PrintLn("FAIL: SLSFCT missing FTX tag (confidence)"c); ok := 0;
    } else { PrintLn("PASS: SLSFCT has FTX tag (confidence)"c); }

    var rflines: int64 := alloc(3 * EDI_SLS_LINE_SIZE);
    zi := 0;
    while (zi < 3 * EDI_SLS_LINE_SIZE) { poke8(rflines + zi, 0); zi := zi + 1; }

    var fcnt: int64 := EdiSlsfctRead(buf3, w3, rflines, 3);

    if (fcnt != 2) {
        PrintLn("FAIL: EdiSlsfctRead should return 2 lines"c); ok := 0;
    } else { PrintLn("PASS: EdiSlsfctRead returns 2 lines"c); }

    var rfl0: int64 := rflines + 0 * EDI_SLS_LINE_SIZE;
    if (peek64(rfl0 + EDI_SLS_LINE_CONFIDENCE) != 85) {
        PrintLn("FAIL: line[0] confidence should be 85"c); ok := 0;
    } else { PrintLn("PASS: line[0] confidence=85"c); }

    var rfl1: int64 := rflines + 1 * EDI_SLS_LINE_SIZE;
    if (peek64(rfl1 + EDI_SLS_LINE_CONFIDENCE) != 60) {
        PrintLn("FAIL: line[1] confidence should be 60"c); ok := 0;
    } else { PrintLn("PASS: line[1] confidence=60"c); }

    free(rflines, 3 * EDI_SLS_LINE_SIZE);
    free(slines, 3 * EDI_SLS_LINE_SIZE);
    free(buf3, 4096);
    free(buf2, 4096);

    // -------------------------------------------------------------------------
    // Final result
    // -------------------------------------------------------------------------
    if (ok == 1) {
        PrintLn("ALL PASS"c);
    } else {
        PrintLn("SOME TESTS FAILED"c);
    }
    return 0;
}
