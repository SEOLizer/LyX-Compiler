// tests/pdf_rotation_test.lyx
// WP-PDF-20: PdfSetPageRotation — /Rotate entry in Page dict

import std.pdf;
import std.io;
import std.fs;
import std.alloc;

// Search for needle (length nl) in haystack (length hl). Returns 1 if found.
fn containsBytes(hay: int64, hl: int64, needle: pchar, nl: int64): int64 {
  if (nl == 0 || hl < nl) { return 0; }
  var i: int64 := 0;
  while (i <= hl - nl) {
    var j: int64 := 0;
    while (j < nl && peek8(hay + i + j) == StrCharAt(needle, j)) {
      j := j + 1;
    }
    if (j == nl) { return 1; }
    i := i + 1;
  }
  return 0;
}

pub fn main(): int64 {
  // ── Test 1: basic /Rotate emission ──────────────────────────────────────
  var doc: int64 := PdfNew();
  if (doc == 0) { Print("FAIL: PdfNew\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p2: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);

  // page 0: 90°, page 1: 270°, page 2: stays 0° (no /Rotate emitted)
  PdfSetPageRotation(doc, p0, 90);
  PdfSetPageRotation(doc, p1, 270);

  // invalid: 45° should be silently ignored (page 0 stays 90°)
  PdfSetPageRotation(doc, p0, 45);

  // invalid: out-of-bounds page should be silently ignored
  PdfSetPageRotation(doc, 99, 180);

  var path: pchar := "/tmp/pdf_rotation_test.pdf"c;
  if (PdfSave(doc, path) != 0) {
    Print("FAIL: PdfSave\n");
    PdfFree(doc);
    return 1;
  }
  PdfFree(doc);

  // Read back and verify
  var fsize: int64 := FileSize(path);
  if (fsize <= 0) { Print("FAIL: FileSize\n"); return 1; }

  var buf: int64 := alloc(fsize + 1);
  if (buf == 0) { Print("FAIL: alloc\n"); return 1; }

  var nread: int64 := ReadFile(path, buf as pchar, fsize);
  if (nread != fsize) { Print("FAIL: ReadFile\n"); free(buf, fsize + 1); return 1; }

  // Expect /Rotate 90 for page 0
  if (containsBytes(buf, nread, "/Rotate 90"c, 10) == 0) {
    Print("FAIL: /Rotate 90 not found in PDF\n");
    free(buf, fsize + 1); return 1;
  }

  // Expect /Rotate 270 for page 1
  if (containsBytes(buf, nread, "/Rotate 270"c, 11) == 0) {
    Print("FAIL: /Rotate 270 not found in PDF\n");
    free(buf, fsize + 1); return 1;
  }

  // /Rotate 45 must NOT appear (invalid value rejected)
  if (containsBytes(buf, nread, "/Rotate 45"c, 10) != 0) {
    Print("FAIL: /Rotate 45 found in PDF (should have been rejected)\n");
    free(buf, fsize + 1); return 1;
  }

  // /Rotate 0 must NOT appear (default, omitted)
  if (containsBytes(buf, nread, "/Rotate 0"c, 9) != 0) {
    Print("FAIL: /Rotate 0 found in PDF (should be omitted for default)\n");
    free(buf, fsize + 1); return 1;
  }

  free(buf, fsize + 1);
  Print("OK: /Rotate 90 and /Rotate 270 emitted; invalid values rejected\n");

  // ── Test 2: all four valid values ────────────────────────────────────────
  var doc2: int64 := PdfNew();
  if (doc2 == 0) { Print("FAIL: PdfNew doc2\n"); return 1; }

  var q0: int64 := PdfAddPage(doc2, PDF_A4_W, PDF_A4_H);
  var q1: int64 := PdfAddPage(doc2, PDF_A4_W, PDF_A4_H);
  var q2: int64 := PdfAddPage(doc2, PDF_A4_W, PDF_A4_H);
  var q3: int64 := PdfAddPage(doc2, PDF_A4_W, PDF_A4_H);

  PdfSetPageRotation(doc2, q0, 0);
  PdfSetPageRotation(doc2, q1, 90);
  PdfSetPageRotation(doc2, q2, 180);
  PdfSetPageRotation(doc2, q3, 270);

  var path2: pchar := "/tmp/pdf_rotation_test2.pdf"c;
  if (PdfSave(doc2, path2) != 0) {
    Print("FAIL: PdfSave doc2\n");
    PdfFree(doc2);
    return 1;
  }
  PdfFree(doc2);

  var fsize2: int64 := FileSize(path2);
  var buf2: int64 := alloc(fsize2 + 1);
  ReadFile(path2, buf2 as pchar, fsize2);

  if (containsBytes(buf2, fsize2, "/Rotate 90"c,  10) == 0) { Print("FAIL: doc2 /Rotate 90\n");  free(buf2, fsize2+1); return 1; }
  if (containsBytes(buf2, fsize2, "/Rotate 180"c, 11) == 0) { Print("FAIL: doc2 /Rotate 180\n"); free(buf2, fsize2+1); return 1; }
  if (containsBytes(buf2, fsize2, "/Rotate 270"c, 11) == 0) { Print("FAIL: doc2 /Rotate 270\n"); free(buf2, fsize2+1); return 1; }
  if (containsBytes(buf2, fsize2, "/Rotate 0"c,   9) != 0)  { Print("FAIL: doc2 /Rotate 0 should be omitted\n"); free(buf2, fsize2+1); return 1; }

  free(buf2, fsize2 + 1);
  Print("OK: all four rotation values (0 omitted, 90/180/270 emitted)\n");

  Print("All WP-PDF-20 tests passed.\n");
  return 0;
}
