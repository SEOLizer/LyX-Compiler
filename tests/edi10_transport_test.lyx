        free(out, 4096);
        free(hdr, EDI_TRN_HDR_SIZE);
    }

    // ── Tests 35-36: IFTMAN write/read round-trip ────────────────────────────
    {
        var hdr: int64 := alloc(EDI_TRN_HDR_SIZE);
        var i: int64 := 0;
        while (i < EDI_TRN_HDR_SIZE) { poke8(hdr + i, 0); i := i + 1; }
