// tests/edi10_transport_test.lyx — WP-EDI-10 Transport tests
unit tests.edi10_transport_test;

import std.edi.transport;
import std.edi.core;
import std.alloc;
import std.io;

fn strEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
        if (peek8(a + i) != peek8(b + i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

fn pass(n: int64) {
    Print("PASS ");
    PrintLn(n);
}

fn fail(n: int64) {
    Print("FAIL ");
    PrintLn(n);
}

fn check(n: int64, ok: int64) {
    if (ok == 1) { pass(n); } else { fail(n); }
}

