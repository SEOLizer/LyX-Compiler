        var goodCount: int64 := EdiIftdgnRead(out, written, hdr2, goods2, 2);

        // Test 23: goodCount == 1
        check(23, goodCount == 1);

        // Test 24: bgmQual == 350 (IFTDGN)
        check(24, peek64(hdr2 + EDI_TRN_HDR_BGMQUAL) == EDI_TRN_BGM_IFTDGN);

        var unPtr:   int64 := peek64(goods2 + EDI_DGD_UNNUMBER);
