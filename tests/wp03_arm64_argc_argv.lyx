// WP-03: ARM64 Linux — CRT-Init: argc/argv from Linux AArch64 ABI stack.
// On AArch64 at _start, registers are undefined; argc is at [sp+0], argv at [sp+8].
// The fixed 20-byte static stub loads them via LDR x0,[sp] + ADD x1,sp,#8 before
// calling main. This test verifies that argc is correctly forwarded as x0.
// Expected exit code when invoked as: ./binary       → 1
// Expected exit code when invoked as: ./binary a b c → 4

fn main(argc: int64, argv: int64): int64 {
  return argc;
}
