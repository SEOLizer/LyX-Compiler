// WP-12: Xtensa/ESP32 — PrintInt echte itoa-Loop
//
// Verifies that PrintInt on the Xtensa target emits a real integer-to-decimal
// conversion (do-while subtraction-by-10 loop) rather than the old "INT" stub.
//
// Implementation in src/backend/xtensa.lyx → xt_emitPrintIntHelper():
//   - UART base 0x60000000 built with SSL+SLL (6 << 28)
//   - Negative values: NEG + '-' byte to UART before digit loop
//   - Digit extraction: iterative subtraction by a7=10 into 24-byte stack buffer
//   - Digits stored backward (sp+23 down), printed forward after inversion
//
// Test matrix:
//   1. single digit   — PrintInt(7)       → "7"
//   2. multi-digit    — PrintInt(42)      → "42"
//   3. zero           — PrintInt(0)       → "0"
//   4. negative       — PrintInt(-1)      → "-1"
//   5. three digits   — PrintInt(123)     → "123"
//
// Compile:
//   lyxc --target=xtensa tests/wp12_esp32_printint.lyx -o /tmp/wp12.elf
//
// Expected ELF: Xtensa ELF32, entry 0x40080000 + helper offset,
//   S8I to 0x60000000 present in code section (UART writes).
import std.io;

fn main(): int64 {
  PrintInt(7);
  PrintLn("");
  PrintInt(42);
  PrintLn("");
  PrintInt(0);
  PrintLn("");
  PrintInt(-1);
  PrintLn("");
  PrintInt(123);
  PrintLn("");
  return 0;
}
