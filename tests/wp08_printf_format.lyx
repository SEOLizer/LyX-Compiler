// WP-08: Windows ARM64 — Printf Formatstrings
//
// #1014: Die Aufrufe fuellten die Argumentliste mit Nullen auf vier Stellen auf
// — eine alte ARM64-Konvention, als Printf feste vier Argumente bekam. Die
// x86-Fassung (#1012/PR #1036) weist ueberzaehlige Argumente ausdruecklich ab
// ("Printf hat mehr Argumente als Platzhalter"), was richtig ist. Die Fuellwerte
// sind daher entfallen.
//
// Abnahme-Kriterien:
//   Printf("x=%d, s=%s\n"c, 42, "hello"c)  → "x=42, s=hello"
//   Printf("%f\n"c, 3.14)                   → "3.140000"
//   Printf("100%%\n"c)                      → "100%"
//   PrintFloat bestehender Test bleibt grün (PrintFloat ruft Helper id=9 auf)
//
// Plattform: Windows ARM64 (PE32+/AArch64), Builtin id=10 → wab_printf_full
import std.io;

fn main(): int64 {
  // Test 1: %d und %s
  Printf("x=%d, s=%s\n"c, 42, "hello"c);

  // Test 2: %f
  var pi: f64 := 3.14;
  Printf("%f\n"c, pi);

  // Test 3: %%
  Printf("100%%\n"c);

  // Abnahme-Markierung
  PrintLn("PASS");

  return 0;
}
