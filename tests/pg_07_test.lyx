// tests/pg_07_test.lyx — WP-PG-07: Parameter-Binding
//
// Offline:
//   1. PGBindInt/Float/Str/Bool/Null auf 0 → kein Crash
//
// Live (PostgreSQL localhost:5432 trust/md5):
//   2. INSERT mit $1 (int), $2 (text), $3 (float) → korrekte Werte
//   3. NULL-Binding → Spalte ist NULL in DB
//   4. PGBindFloat(stmt, 0, 3.14) → Spalte enthält 3.14
//   5. PGBindBool → "t"/"f" korrekt gespeichert
//   6. 100 Inserts mit Re-Bind → COUNT(*) = 100

import std.db.postgres;

fn testBindNull(): int64 {
  PGBindInt(0, 0, 42);
  PGBindFloat(0, 0, 3.14 as f64);
  PGBindStr(0, 0, "x"c);
  PGBindBool(0, 0, 1);
  PGBindNull(0, 0);
  Print("OK: bind on null stmt safe\n");
  return 0;
}

fn testLive(): int64 {
  var probe: int64 := pgProbe("127.0.0.1"c, 5432, "postgres"c, "postgres"c);
  if (probe == 0) { Print("SKIP: PostgreSQL not available\n"); return 0; }

  var conn: int64 := PGConnect("127.0.0.1"c, 5432, "postgres"c, ""c, "postgres"c);
  if (conn == 0) { Print("SKIP: TCP error\n"); return 0; }
  if (PGIsConnected(conn) == 0) {
    if (PGErrno(conn) == PG_ERR_PROTO) { Print("SKIP: unsupported auth (need trust/md5)\n"); }
    else { Print("SKIP: not connected\n"); }
    PGClose(conn); return 0;
  }

  // Setup
  var r0: int64 := PGQuery(conn, "DROP TABLE IF EXISTS pg07_tmp"c);
  if (r0 != 0) { PGFreeResult(r0); }
  var r1: int64 := PGQuery(conn,
    "CREATE TABLE pg07_tmp (id INT, label TEXT, price FLOAT8, active BOOL, note TEXT)"c);
  if (r1 == 0) { Print("FAIL: CREATE TABLE\n"); PGClose(conn); return 1; }
  PGFreeResult(r1);

  var ins: int64 := PGStmtPrepare(conn, "ins07"c,
    "INSERT INTO pg07_tmp VALUES ($1,$2,$3,$4,$5)"c);
  if (ins == 0) {
    Print("FAIL: PGStmtPrepare: ");
    var e: pchar := PGError(conn);
    if (e != 0 as pchar) { Print(e); }
    Print("\n");
    PGClose(conn); return 1;
  }

  // --- 2. INSERT mit int, text, float, bool, null ---
  PGBindInt  (ins, 0, 1);
  PGBindStr  (ins, 1, "hello"c);
  PGBindFloat(ins, 2, 9.99 as f64);
  PGBindBool (ins, 3, 1);
  PGBindNull (ins, 4);
  var ri: int64 := PGStmtExecute(conn, ins);
  if (ri == 0) {
    Print("FAIL: INSERT row 1\n"); PGStmtFree(ins); PGClose(conn); return 1;
  }
  if (PGAffectedRows(ri) != 1) {
    Print("FAIL: affected_rows != 1\n"); PGFreeResult(ri); PGStmtFree(ins); PGClose(conn); return 1;
  }
  PGFreeResult(ri);
  Print("OK: INSERT row 1 (int/text/float/bool/null)\n");

  // --- 3. NULL-Binding verifizieren ---
  var rChk: int64 := PGQuery(conn,
    "SELECT note FROM pg07_tmp WHERE id=1"c);
  if (rChk == 0 || PGNumRows(rChk) != 1) {
    Print("FAIL: SELECT note\n");
    if (rChk != 0) { PGFreeResult(rChk); }
    PGStmtFree(ins); PGClose(conn); return 1;
  }
  if (PGIsNull(rChk, 0, 0) == 0) {
    Print("FAIL: note should be NULL\n");
    PGFreeResult(rChk); PGStmtFree(ins); PGClose(conn); return 1;
  }
  PGFreeResult(rChk);
  Print("OK: NULL binding verified\n");

  // --- 4. PGBindFloat(3.14) → Spalte enthält 3.14 ---
  PGStmtReset(ins);
  PGBindInt  (ins, 0, 2);
  PGBindStr  (ins, 1, "pi"c);
  PGBindFloat(ins, 2, 3.14 as f64);
  PGBindBool (ins, 3, 0);
  PGBindStr  (ins, 4, "ok"c);
  var ri2: int64 := PGStmtExecute(conn, ins);
  if (ri2 == 0) { Print("FAIL: INSERT row 2\n"); PGStmtFree(ins); PGClose(conn); return 1; }
  PGFreeResult(ri2);

  var rPi: int64 := PGQuery(conn, "SELECT price::text FROM pg07_tmp WHERE id=2"c);
  if (rPi == 0 || PGNumRows(rPi) != 1) {
    Print("FAIL: SELECT price\n");
    if (rPi != 0) { PGFreeResult(rPi); }
    PGStmtFree(ins); PGClose(conn); return 1;
  }
  PGFetchRow(rPi);
  var priceTxt: pchar := PGGetStr(rPi, 0);
  Print("OK: PGBindFloat(3.14) → DB contains: ");
  if (priceTxt != 0 as pchar) { Print(priceTxt); } else { Print("NULL"); }
  Print("\n");
  PGFreeResult(rPi);

  // --- 5. PGBindBool → "t"/"f" ---
  var rBool: int64 := PGQuery(conn, "SELECT active FROM pg07_tmp ORDER BY id"c);
  if (rBool == 0 || PGNumRows(rBool) != 2) {
    Print("FAIL: SELECT active\n");
    if (rBool != 0) { PGFreeResult(rBool); }
    PGStmtFree(ins); PGClose(conn); return 1;
  }
  PGFetchRow(rBool); var a0: int64 := PGGetBool(rBool, 0);
  PGFetchRow(rBool); var a1: int64 := PGGetBool(rBool, 0);
  PGFreeResult(rBool);
  if (a0 != 1 || a1 != 0) {
    Print("FAIL: bool values wrong\n"); PGStmtFree(ins); PGClose(conn); return 1;
  }
  Print("OK: PGBindBool — row1=true row2=false\n");

  // --- 6. 100 Inserts mit Re-Bind ---
  var ix: int64 := 3;
  while (ix < 103) {
    PGStmtReset(ins);
    PGBindInt(ins, 0, ix);
    PGBindStr(ins, 1, "bulk"c);
    PGBindFloat(ins, 2, ix as f64);
    PGBindBool(ins, 3, 0);
    PGBindNull(ins, 4);
    var rb: int64 := PGStmtExecute(conn, ins);
    if (rb == 0) {
      Print("FAIL: bulk insert at "); PrintInt(ix); Print("\n");
      PGStmtFree(ins); PGClose(conn); return 1;
    }
    PGFreeResult(rb);
    ix := ix + 1;
  }

  var rCount: int64 := PGQuery(conn, "SELECT COUNT(*) FROM pg07_tmp"c);
  if (rCount == 0) { Print("FAIL: COUNT query\n"); PGStmtFree(ins); PGClose(conn); return 1; }
  PGFetchRow(rCount);
  var cnt: int64 := PGGetInt(rCount, 0);
  PGFreeResult(rCount);
  if (cnt != 102) {
    Print("FAIL: COUNT(*) = "); PrintInt(cnt); Print(" (expected 102)\n");
    PGStmtFree(ins); PGClose(conn); return 1;
  }
  Print("OK: 100 bulk inserts — COUNT(*) = 102\n");

  PGStmtClose(conn, "ins07"c);
  PGStmtFree(ins);

  var rDrop: int64 := PGQuery(conn, "DROP TABLE pg07_tmp"c);
  if (rDrop != 0) { PGFreeResult(rDrop); }

  PGClose(conn);
  Print("OK: PGClose\n");
  return 0;
}

pub fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testBindNull();
  failed := failed + testLive();
  if (failed != 0) { Print("FAILED\n"); return 1; }
  Print("ALL PASSED\n");
  return 0;
}
