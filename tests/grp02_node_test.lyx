// tests/grp02_node_test.lyx
// WP-GRP-02 Abnahmetest: GraphNode Labels, Properties, Vektor

unit tests.grp02_node_test;

import std.graphdb.core;
import std.graphdb.node;
import std.io;
import std.alloc;

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // Alloziere GraphNode auf dem Heap
    var n: int64 := alloc(GNODE_SIZE);
    GraphNodeInit(n);

    // Init/Free ohne Crash
    PrintLn("PASS: GraphNodeInit no crash"c);

    // Labels
    GraphNodeAddLabel(n, "Person"c, 6);
    GraphNodeAddLabel(n, "User"c, 4);

    if (GraphNodeHasLabel(n, "Person"c, 6) != 1) {
        PrintLn("FAIL: HasLabel Person"c);
        ok := 0;
    } else {
        PrintLn("PASS: HasLabel Person"c);
    }

    if (GraphNodeHasLabel(n, "User"c, 4) != 1) {
        PrintLn("FAIL: HasLabel User"c);
        ok := 0;
    } else {
        PrintLn("PASS: HasLabel User"c);
    }

    if (GraphNodeHasLabel(n, "Admin"c, 5) != 0) {
        PrintLn("FAIL: HasLabel Admin should be 0"c);
        ok := 0;
    } else {
        PrintLn("PASS: HasLabel Admin=0"c);
    }

    // SetInt / GetInt
    GraphNodeSetInt(n, "age"c, 3, 42);
    var age: int64 := GraphNodeGetInt(n, "age"c, 3);
    if (age != 42) {
        PrintLn("FAIL: GetInt age != 42"c);
        ok := 0;
    } else {
        PrintLn("PASS: GetInt age=42"c);
    }

    // SetStr / GetStr
    GraphNodeSetStr(n, "name"c, 4, "Alice"c, 5);
    var slen: int64 := alloc(8);
    var sptr: pchar := GraphNodeGetStr(n, "name"c, 4, slen);
    var gotLen: int64 := peek64(slen);
    free(slen, 8);
    if (gotLen != 5) {
        PrintLn("FAIL: GetStr len != 5"c);
        ok := 0;
    } else {
        PrintLn("PASS: GetStr len=5"c);
    }
    if (sptr == 0 as pchar) {
        PrintLn("FAIL: GetStr returned null"c);
        ok := 0;
    } else {
        if (StrCharAt(sptr, 0) != 65) {
            PrintLn("FAIL: GetStr first char != A"c);
            ok := 0;
        } else {
            PrintLn("PASS: GetStr = Alice"c);
        }
    }

    // SetF64 / GetF64  (API: bits als int64 übergeben)
    var exp95Bits: int64 := (0.95 as f64) as int64;
    GraphNodeSetF64(n, "score"c, 5, exp95Bits);
    var scBits: int64 := GraphNodeGetF64(n, "score"c, 5);
    var expBits: int64 := exp95Bits;
    if (scBits != expBits) {
        PrintLn("FAIL: GetF64 score != 0.95"c);
        ok := 0;
    } else {
        PrintLn("PASS: GetF64 score=0.95"c);
    }

    // Zwei Properties koexistieren
    var age2: int64 := GraphNodeGetInt(n, "age"c, 3);
    if (age2 != 42) {
        PrintLn("FAIL: age lost after adding more props"c);
        ok := 0;
    } else {
        PrintLn("PASS: props coexist"c);
    }

    // Vektor
    var vbuf: int64 := alloc(24);
    poke64(vbuf,      (1.0 as f64) as int64);
    poke64(vbuf + 8,  (2.5 as f64) as int64);
    poke64(vbuf + 16, (3.7 as f64) as int64);
    GraphNodeSetVec(n, 3, vbuf);
    free(vbuf, 24);

    var d1: f64 := GraphNodeGetVecDim(n, 1);
    var d1bits: int64 := d1 as int64;
    var exp25: int64 := (2.5 as f64) as int64;
    if (d1bits != exp25) {
        PrintLn("FAIL: GetVecDim(1) != 2.5"c);
        ok := 0;
    } else {
        PrintLn("PASS: GetVecDim(1)=2.5"c);
    }

    // Realloc-Test: 100 Properties
    var ri: int64 := 0;
    while (ri < 100) {
        GraphNodeSetInt(n, "x"c, 1, ri);
        ri := ri + 1;
    }
    PrintLn("PASS: 100 properties no crash"c);

    GraphNodeFree(n);
    free(n, GNODE_SIZE);
    PrintLn("PASS: GraphNodeFree no crash"c);

    if (ok != 0) {
        PrintLn("=== WP-GRP-02: ALL PASS ==="c);
    } else {
        PrintLn("=== WP-GRP-02: FAILURES ==="c);
    }
    return ok;
}
