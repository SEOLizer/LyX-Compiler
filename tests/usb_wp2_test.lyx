// tests/usb_wp2_test.lyx
// WP-2: USB-Descriptor-Typen abbilden
//
// Abnahmekriterien:
// AC-1: Größenkonstanten stimmen (18, 9, 9, 7)
// AC-2: Bekannten Device-Descriptor korrekt parsen
// AC-3: bEndpointAddress Bit 7 → Richtung
// AC-4: bmAttributes Bits 1-0 → Transfer-Typ

unit tests.usb_wp2_test;

import std.hardware.usb_types;
import std.alloc;

// ============================================================
// AC-1: Größenkonstanten
// ============================================================
fn testSizes(): int64 {
  var failed: int64 := 0;
  if (USB_SIZEOF_DEVICE_DESC != 18) {
    PrintLn("FAIL: USB_SIZEOF_DEVICE_DESC != 18");
    failed := failed + 1;
  }
  if (USB_SIZEOF_CONFIG_DESC != 9) {
    PrintLn("FAIL: USB_SIZEOF_CONFIG_DESC != 9");
    failed := failed + 1;
  }
  if (USB_SIZEOF_INTERFACE_DESC != 9) {
    PrintLn("FAIL: USB_SIZEOF_INTERFACE_DESC != 9");
    failed := failed + 1;
  }
  if (USB_SIZEOF_ENDPOINT_DESC != 7) {
    PrintLn("FAIL: USB_SIZEOF_ENDPOINT_DESC != 7");
    failed := failed + 1;
  }
  if (USB_SIZEOF_DESC_HDR != 2) {
    PrintLn("FAIL: USB_SIZEOF_DESC_HDR != 2");
    failed := failed + 1;
  }
  if (failed == 0) { PrintLn("OK: descriptor size constants"); }
  return failed;
}

// ============================================================
// AC-2: Bekannten Device-Descriptor parsen
// USB-Hub: bDeviceClass=9, idVendor=0x1234, idProduct=0x5678
//
// Binär-Layout (18 Bytes, Little-Endian):
//   0x12 0x01            bLength=18, bDescriptorType=1
//   0x00 0x02            bcdUSB=0x0200 (LE: 00 02)
//   0x09 0x00 0x00       bDeviceClass=9, SubClass=0, Protocol=0
//   0x40                 bMaxPacketSize0=64
//   0x34 0x12            idVendor=0x1234 (LE)
//   0x78 0x56            idProduct=0x5678 (LE)
//   0x00 0x01            bcdDevice=0x0100 (LE)
//   0x01 0x02 0x03 0x01  iMfr=1, iProd=2, iSerial=3, bNumConfigs=1
// ============================================================
fn testDeviceDescriptor(): int64 {
  var buf: int64 := alloc(18);
  poke8(buf +  0, 0x12);  // bLength = 18
  poke8(buf +  1, 0x01);  // bDescriptorType = USB_DT_DEVICE
  poke8(buf +  2, 0x00);  // bcdUSB low  = 0x00
  poke8(buf +  3, 0x02);  // bcdUSB high = 0x02  → 0x0200
  poke8(buf +  4, 0x09);  // bDeviceClass = 9 (HUB)
  poke8(buf +  5, 0x00);  // bDeviceSubClass
  poke8(buf +  6, 0x00);  // bDeviceProtocol
  poke8(buf +  7, 0x40);  // bMaxPacketSize0 = 64
  poke8(buf +  8, 0x34);  // idVendor low
  poke8(buf +  9, 0x12);  // idVendor high  → 0x1234
  poke8(buf + 10, 0x78);  // idProduct low
  poke8(buf + 11, 0x56);  // idProduct high → 0x5678
  poke8(buf + 12, 0x00);  // bcdDevice low
  poke8(buf + 13, 0x01);  // bcdDevice high → 0x0100
  poke8(buf + 14, 0x01);  // iManufacturer
  poke8(buf + 15, 0x02);  // iProduct
  poke8(buf + 16, 0x03);  // iSerialNumber
  poke8(buf + 17, 0x01);  // bNumConfigurations

  var failed: int64 := 0;

  if (UsbDevDesc_bLength(buf) != 18) {
    PrintLn("FAIL: bLength != 18"); failed := failed + 1;
  }
  if (UsbDevDesc_bDescriptorType(buf) != USB_DT_DEVICE) {
    PrintLn("FAIL: bDescriptorType != 1"); failed := failed + 1;
  }
  if (UsbDevDesc_bcdUSB(buf) != 0x0200) {
    PrintLn("FAIL: bcdUSB != 0x0200"); failed := failed + 1;
  }
  if (UsbDevDesc_bDeviceClass(buf) != 9) {
    PrintLn("FAIL: bDeviceClass != 9"); failed := failed + 1;
  }
  if (UsbDevDesc_bMaxPacketSize0(buf) != 64) {
    PrintLn("FAIL: bMaxPacketSize0 != 64"); failed := failed + 1;
  }
  if (UsbDevDesc_idVendor(buf) != 0x1234) {
    PrintLn("FAIL: idVendor != 0x1234"); failed := failed + 1;
  }
  if (UsbDevDesc_idProduct(buf) != 0x5678) {
    PrintLn("FAIL: idProduct != 0x5678"); failed := failed + 1;
  }
  if (UsbDevDesc_bcdDevice(buf) != 0x0100) {
    PrintLn("FAIL: bcdDevice != 0x0100"); failed := failed + 1;
  }
  if (UsbDevDesc_iManufacturer(buf) != 1) {
    PrintLn("FAIL: iManufacturer != 1"); failed := failed + 1;
  }
  if (UsbDevDesc_iProduct(buf) != 2) {
    PrintLn("FAIL: iProduct != 2"); failed := failed + 1;
  }
  if (UsbDevDesc_iSerialNumber(buf) != 3) {
    PrintLn("FAIL: iSerialNumber != 3"); failed := failed + 1;
  }
  if (UsbDevDesc_bNumConfigurations(buf) != 1) {
    PrintLn("FAIL: bNumConfigurations != 1"); failed := failed + 1;
  }

  free(buf, 18);
  if (failed == 0) { PrintLn("OK: DeviceDescriptor parsing"); }
  return failed;
}

// ============================================================
// AC-2b: Configuration + Interface + Endpoint Descriptor
// ============================================================
fn testOtherDescriptors(): int64 {
  var failed: int64 := 0;

  // Config: 2 Interfaces, Self-Powered, 100 mA (bMaxPower=50)
  var cfg: int64 := alloc(9);
  poke8(cfg + 0, 9);    // bLength
  poke8(cfg + 1, 2);    // bDescriptorType = USB_DT_CONFIG
  poke8(cfg + 2, 0x19); // wTotalLength low = 25
  poke8(cfg + 3, 0x00); // wTotalLength high
  poke8(cfg + 4, 2);    // bNumInterfaces
  poke8(cfg + 5, 1);    // bConfigurationValue
  poke8(cfg + 6, 0);    // iConfiguration
  poke8(cfg + 7, 0xC0); // bmAttributes: Self-Powered (Bit 6 = 1) + Reserved (Bit 7 = 1)
  poke8(cfg + 8, 50);   // bMaxPower = 50 → 100 mA

  if (UsbCfgDesc_bNumInterfaces(cfg) != 2)       { PrintLn("FAIL: cfg bNumInterfaces"); failed := failed + 1; }
  if (UsbCfgDesc_bConfigurationValue(cfg) != 1)  { PrintLn("FAIL: cfg bConfigValue");  failed := failed + 1; }
  if (UsbCfgDesc_wTotalLength(cfg) != 25)        { PrintLn("FAIL: cfg wTotalLength");  failed := failed + 1; }
  if (UsbCfgDesc_bMaxPower(cfg) != 50)           { PrintLn("FAIL: cfg bMaxPower");     failed := failed + 1; }
  free(cfg, 9);

  // Interface: 3 Endpoints, HID-Klasse
  var ifc: int64 := alloc(9);
  poke8(ifc + 0, 9);   // bLength
  poke8(ifc + 1, 4);   // bDescriptorType = USB_DT_INTERFACE
  poke8(ifc + 2, 0);   // bInterfaceNumber
  poke8(ifc + 3, 0);   // bAlternateSetting
  poke8(ifc + 4, 3);   // bNumEndpoints
  poke8(ifc + 5, 3);   // bInterfaceClass = 3 (HID)
  poke8(ifc + 6, 1);   // bInterfaceSubClass
  poke8(ifc + 7, 1);   // bInterfaceProtocol (Keyboard)
  poke8(ifc + 8, 0);   // iInterface

  if (UsbIfDesc_bNumEndpoints(ifc) != 3)         { PrintLn("FAIL: ifc bNumEndpoints");   failed := failed + 1; }
  if (UsbIfDesc_bInterfaceClass(ifc) != 3)       { PrintLn("FAIL: ifc bInterfaceClass"); failed := failed + 1; }
  if (UsbIfDesc_bInterfaceNumber(ifc) != 0)      { PrintLn("FAIL: ifc bIfcNumber");      failed := failed + 1; }
  free(ifc, 9);

  // Endpoint: IN Interrupt, EP 1, 8 Bytes, 10 ms Interval
  var ep: int64 := alloc(7);
  poke8(ep + 0, 7);    // bLength
  poke8(ep + 1, 5);    // bDescriptorType = USB_DT_ENDPOINT
  poke8(ep + 2, 0x81); // bEndpointAddress: IN (Bit 7=1), Nr 1 (Bits 0-3)
  poke8(ep + 3, 0x03); // bmAttributes: Interrupt (Bits 1-0 = 11)
  poke8(ep + 4, 8);    // wMaxPacketSize low
  poke8(ep + 5, 0);    // wMaxPacketSize high → 8
  poke8(ep + 6, 10);   // bInterval = 10 ms

  if (UsbEpDesc_bEndpointAddress(ep) != 0x81)   { PrintLn("FAIL: ep bEndpointAddress"); failed := failed + 1; }
  if (UsbEpDesc_bmAttributes(ep) != 0x03)       { PrintLn("FAIL: ep bmAttributes");    failed := failed + 1; }
  if (UsbEpDesc_wMaxPacketSize(ep) != 8)        { PrintLn("FAIL: ep wMaxPacketSize");  failed := failed + 1; }
  if (UsbEpDesc_bInterval(ep) != 10)            { PrintLn("FAIL: ep bInterval");       failed := failed + 1; }
  free(ep, 7);

  if (failed == 0) { PrintLn("OK: Config/Interface/Endpoint descriptor parsing"); }
  return failed;
}

// ============================================================
// AC-3: bEndpointAddress Bit 7 → Richtung
// ============================================================
fn testEndpointDirection(): int64 {
  var failed: int64 := 0;

  if (UsbEpDirection(0x81) != USB_EP_DIR_IN) {
    PrintLn("FAIL: 0x81 should be IN"); failed := failed + 1;
  }
  if (UsbEpDirection(0x82) != USB_EP_DIR_IN) {
    PrintLn("FAIL: 0x82 should be IN"); failed := failed + 1;
  }
  if (UsbEpDirection(0x01) != USB_EP_DIR_OUT) {
    PrintLn("FAIL: 0x01 should be OUT"); failed := failed + 1;
  }
  if (UsbEpDirection(0x02) != USB_EP_DIR_OUT) {
    PrintLn("FAIL: 0x02 should be OUT"); failed := failed + 1;
  }
  if (UsbEpDirection(0x00) != USB_EP_DIR_OUT) {
    PrintLn("FAIL: 0x00 should be OUT"); failed := failed + 1;
  }

  // Nummer extrahieren
  if (UsbEpNumber(0x81) != 1) { PrintLn("FAIL: 0x81 number != 1"); failed := failed + 1; }
  if (UsbEpNumber(0x03) != 3) { PrintLn("FAIL: 0x03 number != 3"); failed := failed + 1; }

  if (failed == 0) { PrintLn("OK: endpoint direction (AC-3)"); }
  return failed;
}

// ============================================================
// AC-4: bmAttributes Bits 1-0 → Transfer-Typ
// ============================================================
fn testTransferType(): int64 {
  var failed: int64 := 0;

  if (UsbEpTransferType(0x00) != USB_TRANS_CONTROL)   { PrintLn("FAIL: 0x00 != Control");   failed := failed + 1; }
  if (UsbEpTransferType(0x01) != USB_TRANS_ISO)        { PrintLn("FAIL: 0x01 != Iso");       failed := failed + 1; }
  if (UsbEpTransferType(0x02) != USB_TRANS_BULK)       { PrintLn("FAIL: 0x02 != Bulk");      failed := failed + 1; }
  if (UsbEpTransferType(0x03) != USB_TRANS_INTERRUPT)  { PrintLn("FAIL: 0x03 != Interrupt"); failed := failed + 1; }
  // Bits 7-2 werden ignoriert
  if (UsbEpTransferType(0xFE) != USB_TRANS_BULK)       { PrintLn("FAIL: 0xFE != Bulk");      failed := failed + 1; }
  if (UsbEpTransferType(0xFF) != USB_TRANS_INTERRUPT)  { PrintLn("FAIL: 0xFF != Interrupt"); failed := failed + 1; }

  if (failed == 0) { PrintLn("OK: transfer type (AC-4)"); }
  return failed;
}

// ============================================================
// Struct-Layout + UsbEndpointFromDesc
// ============================================================
fn testEndpointStruct(): int64 {
  var failed: int64 := 0;

  // Endpoint-Descriptor für IN Bulk EP 2, 64 Bytes, kein Interval
  var epBuf: int64 := alloc(7);
  poke8(epBuf + 0, 7);
  poke8(epBuf + 1, 5);
  poke8(epBuf + 2, 0x82);  // IN, EP 2
  poke8(epBuf + 3, 0x02);  // Bulk
  poke8(epBuf + 4, 64);
  poke8(epBuf + 5, 0);
  poke8(epBuf + 6, 0);

  var epMem: int64 := alloc(USB_SIZEOF_ENDPOINT);
  UsbEndpointFromDesc(epMem, epBuf);

  // Prüfe via peek64 (Struct ist an epMem mit 8-Byte-Feldern)
  var epAddress:  int64 := peek64(epMem);
  var epDir:      int64 := peek64(epMem + 8);
  var epNum:      int64 := peek64(epMem + 16);
  var epTrans:    int64 := peek64(epMem + 24);
  var epPacket:   int64 := peek64(epMem + 32);
  var epInterval: int64 := peek64(epMem + 40);

  if (epAddress  != 0x82)           { PrintLn("FAIL: ep struct address");   failed := failed + 1; }
  if (epDir      != USB_EP_DIR_IN)  { PrintLn("FAIL: ep struct direction"); failed := failed + 1; }
  if (epNum      != 2)              { PrintLn("FAIL: ep struct number");     failed := failed + 1; }
  if (epTrans    != USB_TRANS_BULK) { PrintLn("FAIL: ep struct transfer");  failed := failed + 1; }
  if (epPacket   != 64)             { PrintLn("FAIL: ep struct max_packet");failed := failed + 1; }
  if (epInterval != 0)              { PrintLn("FAIL: ep struct interval");   failed := failed + 1; }

  free(epBuf, 7);
  free(epMem, USB_SIZEOF_ENDPOINT);
  if (failed == 0) { PrintLn("OK: UsbEndpoint struct (UsbEndpointFromDesc)"); }
  return failed;
}

// ============================================================
// UsbEndpointAt / UsbInterfaceAt / UsbConfigAt
// ============================================================
fn testArrayNavigation(): int64 {
  var failed: int64 := 0;

  var base: int64 := 0x1000;

  // UsbEndpointAt
  if (UsbEndpointAt(base, 0) != base) {
    PrintLn("FAIL: UsbEndpointAt(base, 0)"); failed := failed + 1;
  }
  if (UsbEndpointAt(base, 1) != base + USB_SIZEOF_ENDPOINT) {
    PrintLn("FAIL: UsbEndpointAt(base, 1)"); failed := failed + 1;
  }
  if (UsbEndpointAt(base, 3) != base + 3 * USB_SIZEOF_ENDPOINT) {
    PrintLn("FAIL: UsbEndpointAt(base, 3)"); failed := failed + 1;
  }

  // UsbInterfaceAt
  if (UsbInterfaceAt(base, 2) != base + 2 * USB_SIZEOF_INTERFACE) {
    PrintLn("FAIL: UsbInterfaceAt(base, 2)"); failed := failed + 1;
  }

  // UsbConfigAt
  if (UsbConfigAt(base, 1) != base + USB_SIZEOF_CONFIGURATION) {
    PrintLn("FAIL: UsbConfigAt(base, 1)"); failed := failed + 1;
  }

  if (failed == 0) { PrintLn("OK: array navigation helpers"); }
  return failed;
}

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testSizes();
  failed := failed + testDeviceDescriptor();
  failed := failed + testOtherDescriptors();
  failed := failed + testEndpointDirection();
  failed := failed + testTransferType();
  failed := failed + testEndpointStruct();
  failed := failed + testArrayNavigation();

  if (failed != 0) {
    PrintLn("FAILED");
    return 1;
  }
  PrintLn("ALL PASSED");
  return 0;
}
