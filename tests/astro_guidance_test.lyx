// tests/astro_guidance_test.lyx — std.astro.guidance (#1900)
//
// Guidance laesst sich nicht gegen geschlossene Loesungen pruefen, sondern
// nur gegen SZENARIEN mit bekanntem Ausgang. Das ist eine andere und
// schwaechere Vertrauensstufe als bei std.astro.orbit, und genau deshalb
// sind es zwei Units. Die Szenarien hier sind so gewaehlt, dass sich jede
// Zahl von Hand nachrechnen laesst.
//
// Das Leitszenario ist das aus dem Prototyp in #1900:
//
//   r = (-1000, 50, 0) m,  v = (10, 0, 0) m/s
//
//   t_CPA   = -(r.v)/|v|^2 = 10000/100                       = 100 s
//   d_CPA   = |r + 100*v| = |(0, 50, 0)|                      = 50 m
//   omega_z = (r x v)_z / |r|^2 = -500 / 1002500              = -4.9875e-4 rad/s
//
// Die letzte Zahl steht im Issue als "0.000499" — sie faellt hier mit
// Vorzeichen an, und das Vorzeichen ist die Drehrichtung der Sichtlinie.
//
// Drei Pruefungen tragen den Test:
//
//   1. Ein NEGATIVES t_CPA wird zurueckgegeben, nicht auf 0 geklemmt: die
//      dichteste Annaeherung ist dann vorbei, und das ist eine Auskunft.
//   2. Kollisionskurs verlangt BEIDE Haelften — ruhende Sichtlinie UND
//      abnehmender Abstand. Eine ruhende Sichtlinie bei wachsendem Abstand
//      ist ein sich entfernendes Ziel.
//   3. Die Sollbeschleunigung der Proportional Navigation steht SENKRECHT
//      auf der Sichtlinie. Ein Test, der nur ihren Betrag misst, waere auch
//      von einer Verfolgungskurve erfuellt.

unit main;

import std.io;
import std.math;
import std.astro.state;
import std.astro.guidance;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn CheckRel(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  var d: f64 := AbsF64(got - want);
  var s: f64 := AbsF64(want);
  if (s < 1.0) { s := 1.0; }
  if (d / s <= tol) { PrintStr("PASS "c); PrintStrLn(name); }
  else {
    PrintStr("FAIL "c); PrintStr(name);
    PrintStr(": erhalten "c); PrintF64(got);
    PrintStr(" erwartet "c); PrintF64(want); PrintLn(""c);
    _fails := _fails + 1;
  }
}

fn CheckWahr(name: pchar, got: bool): void {
  _checks := _checks + 1;
  if (got) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStr(name); PrintStrLn(" (erwartet: wahr)"c); _fails := _fails + 1; }
}

fn CheckFalsch(name: pchar, got: bool): void {
  _checks := _checks + 1;
  if (!got) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStr(name); PrintStrLn(" (erwartet: falsch)"c); _fails := _fails + 1; }
}

fn main(): int64 {
  // ── Das Leitszenario ────────────────────────────────────────────────────
  var r: AVec3 := AVec(0.0 - 1000.0, 50.0, 0.0);
  var v: AVec3 := AVec(10.0, 0.0, 0.0);

  CheckRel("Abstand"c, ARange(r), SqrtF64(1002500.0), 0.000000001);
  CheckRel("Zeit bis CPA = 100 s"c, ATimeToCPA(r, v), 100.0, 0.000000001);
  CheckRel("Abstand bei CPA = 50 m"c, ADistanceAtCPA(r, v), 50.0, 0.000000001);

  // Sichtlinienrate: Betrag und Vorzeichen der z-Komponente.
  var w: AVec3 := ALosRate(r, v);
  CheckRel("Sichtlinienrate z"c, w.z, 0.0 - 500.0 / 1002500.0, 0.000000001);
  CheckRel("Sichtlinienrate Betrag"c, ALosRateMagnitude(r, v), 500.0 / 1002500.0, 0.000000001);

  // Annaeherungsrate: POSITIV beim Naeherkommen. Die Ableitung des Abstands
  // ist dabei negativ — das Vorzeichen ist eine Festlegung, keine
  // Selbstverstaendlichkeit, und dieser Fall haelt sie fest.
  CheckRel("Annaeherungsrate positiv"c, AClosingSpeed(r, v), 10000.0 / SqrtF64(1002500.0), 0.000000001);

  // Restflugzeit gegen CPA-Zeit: die beiden sind NICHT dasselbe. Ein Test,
  // der nur eine misst, uebersieht eine Verwechslung der beiden Begriffe.
  CheckRel("Restflugzeit entlang der Sichtlinie"c,
           ATimeToGo(r, v), 1002500.0 / 10000.0, 0.000000001);
  CheckWahr("Restflugzeit und CPA-Zeit sind verschieden"c,
            AbsF64(ATimeToGo(r, v) - ATimeToCPA(r, v)) > 0.1);

  // Relativer Ort zum CPA-Zeitpunkt.
  var beiCpa: AVec3 := ARelPositionAt(r, v, 100.0);
  CheckRel("Ort bei CPA: x aufgebraucht"c, beiCpa.x, 0.0, 0.000000001);
  CheckRel("Ort bei CPA: y bleibt"c, beiCpa.y, 50.0, 0.000000001);

  // ── Quer und laengs ─────────────────────────────────────────────────────
  CheckRel("Querabweichung"c, ACrossTrack(r, v), 50.0, 0.000000001);
  CheckRel("Laengsabstand: Ziel liegt hinten"c, AAlongTrack(r, v), 0.0 - 1000.0, 0.000000001);

  // Querabweichung und CPA-Abstand sind DIESELBE Groesse — bei geradliniger
  // Bewegung ist der senkrechte Abstand zur Bahngeraden genau der kleinste
  // Abstand, den die Bahn erreicht. Der Test hat das erzwungen: hier stand
  // zuerst die Erwartung, ein SCHIEFES Szenario wuerde die beiden trennen,
  // und sie war falsch. Statt der Differenz steht deshalb jetzt die
  // IDENTITAET da, an einem schiefen Fall geprueft, wo die beiden Formeln
  // voellig verschiedene Zwischenwerte durchlaufen:
  //
  //   quer  = |r x v| / |v|          = 5500 / sqrt(125)
  //   CPA   = |r + t*v| mit t = 78   = sqrt(220^2 + 440^2)
  //
  // Dass zwei so verschiedene Rechenwege auf dieselbe Zahl fallen, ist die
  // staerkere Aussage als jede Ungleichung.
  var vs: AVec3 := AVec(10.0, 5.0, 0.0);
  CheckRel("Querabweichung (schiefer Fall)"c, ACrossTrack(r, vs), 5500.0 / SqrtF64(125.0), 0.000000001);
  CheckRel("Laengsabstand (schiefer Fall)"c, AAlongTrack(r, vs), (0.0 - 9750.0) / SqrtF64(125.0), 0.000000001);
  CheckRel("schief: quer == CPA-Abstand"c,
           ACrossTrack(r, vs), ADistanceAtCPA(r, vs), 0.000000001);

  // Der Laengsabstand haengt mit der CPA-Zeit zusammen: t = -laengs / |v|.
  // Ein Vorzeichenfehler in einer der beiden Funktionen bricht genau das.
  CheckRel("Laengsabstand und CPA-Zeit passen zusammen"c,
           ATimeToCPA(r, vs), (0.0 - AAlongTrack(r, vs)) / SqrtF64(125.0), 0.000000001);

  // Eine Querabweichung von 30 m, wie im Prototyp: Ziel 30 m neben der
  // Bahngeraden.
  var q30: AVec3 := AVec(0.0 - 400.0, 30.0, 0.0);
  CheckRel("Querabweichung 30 m"c, ACrossTrack(q30, v), 30.0, 0.000000001);

  // ── Die dichteste Annaeherung liegt hinter uns ──────────────────────────
  // Ein negatives t wird ZURUECKGEGEBEN. Auf 0 geklemmt wuerde aus "zu spaet"
  // ein "jetzt".
  var rWeg: AVec3 := AVec(1000.0, 50.0, 0.0);
  CheckRel("CPA liegt in der Vergangenheit"c, ATimeToCPA(rWeg, v), 0.0 - 100.0, 0.000000001);
  CheckWahr("CPA-Zeit ist wirklich negativ"c, ATimeToCPA(rWeg, v) < 0.0);
  // Und die Annaeherungsrate ist dort negativ: das Ziel entfernt sich.
  CheckWahr("entfernendes Ziel: Rate negativ"c, AClosingSpeed(rWeg, v) < 0.0);
  // Eine Restflugzeit gibt es dann nicht. Ein grosser positiver Wert waere
  // hier besonders gefaehrlich — er saehe aus wie "noch viel Zeit".
  CheckWahr("entfernendes Ziel: keine Restflugzeit"c, AIsError(ATimeToGo(rWeg, v)));

  // ── Kollisionskurs ──────────────────────────────────────────────────────
  var rDirekt: AVec3 := AVec(0.0 - 1000.0, 0.0, 0.0);
  CheckRel("direkter Anflug: Sichtlinienrate 0"c, ALosRateMagnitude(rDirekt, v), 0.0, 0.000000001);
  CheckWahr("direkter Anflug ist Kollisionskurs"c,
            AOnCollisionCourse(rDirekt, v, 0.00001));
  // Dieselbe ruhende Sichtlinie, aber das Ziel entfernt sich: KEIN
  // Kollisionskurs. Ohne diesen Fall waere die Funktion von einer Umsetzung
  // nicht zu unterscheiden, die nur die Rate prueft.
  var rDirektWeg: AVec3 := AVec(1000.0, 0.0, 0.0);
  CheckRel("entfernend: Sichtlinienrate ebenfalls 0"c,
           ALosRateMagnitude(rDirektWeg, v), 0.0, 0.000000001);
  CheckFalsch("entfernend ist kein Kollisionskurs"c,
              AOnCollisionCourse(rDirektWeg, v, 0.00001));
  // Und das Leitszenario mit seiner drehenden Sichtlinie auch nicht.
  CheckFalsch("drehende Sichtlinie ist kein Kollisionskurs"c,
              AOnCollisionCourse(r, v, 0.00001));

  // ── Proportional Navigation ─────────────────────────────────────────────
  var a: AVec3 := AProNavAccel(r, v, 4.0);
  CheckFalsch("Sollbeschleunigung ist bestimmt"c, AVecIsError(a));
  // Betrag: N * Vc * |omega|, weil omega senkrecht auf r_hat steht.
  CheckRel("Betrag = N * Vc * omega"c, AMagnitude(a),
           4.0 * AClosingSpeed(r, v) * ALosRateMagnitude(r, v), 0.000000001);
  // DIE Aussage: senkrecht auf der Sichtlinie. Sie dreht die Sichtlinie
  // still, sie bremst nicht. Ein Test nur ueber den Betrag waere auch von
  // einer Verfolgungskurve erfuellt.
  CheckRel("steht senkrecht auf der Sichtlinie"c, ADot(a, AUnitVec(r)), 0.0, 0.000000001);
  // Auf Kollisionskurs ist sie null — die Eigenschaft, wegen der das
  // Verfahren benutzt wird.
  CheckRel("auf Kollisionskurs ist sie null"c,
           AMagnitude(AProNavAccel(rDirekt, v, 4.0)), 0.0, 0.000000001);
  // Und sie waechst mit dem Beiwert.
  CheckRel("N = 8 verdoppelt gegenueber N = 4"c,
           AMagnitude(AProNavAccel(r, v, 8.0)), 2.0 * AMagnitude(a), 0.000000001);

  // ── Wo es keine Antwort gibt ────────────────────────────────────────────
  var still: AVec3 := AVec(0.0, 0.0, 0.0);
  // Gleiche Geschwindigkeit: kein Annaeherungszeitpunkt. Die Division durch
  // fast null ist der Fall, den die Meldung zu #1900 ausdruecklich nennt.
  CheckWahr("keine Relativbewegung: kein CPA"c, AIsError(ATimeToCPA(r, still)));
  CheckWahr("keine Relativbewegung: kein CPA-Abstand"c, AIsError(ADistanceAtCPA(r, still)));
  CheckWahr("keine Relativbewegung: keine Querabweichung"c, AIsError(ACrossTrack(r, still)));
  // Abstand null: keine Sichtlinie, keine Annaeherungsrate.
  CheckWahr("Abstand null: keine Sichtlinienrate"c, AVecIsError(ALosRate(still, v)));
  CheckWahr("Abstand null: keine Annaeherungsrate"c, AIsError(AClosingSpeed(still, v)));
  CheckWahr("N <= 0 meldet"c, AVecIsError(AProNavAccel(r, v, 0.0)));
  CheckWahr("negatives N meldet"c, AVecIsError(AProNavAccel(r, v, 0.0 - 4.0)));
  // Eine unmoegliche Eingabe darf nicht als Kollisionskurs durchgehen.
  CheckFalsch("keine Relativbewegung ist kein Kollisionskurs"c,
              AOnCollisionCourse(r, still, 0.00001));

  PrintStr("\n"c);
  PrintInt(_checks); PrintStr(" Pruefungen, "c);
  PrintInt(_fails); PrintStrLn(" FAIL"c);
  if (_fails == 0) { PrintStrLn("OK: std.astro.guidance"c); return 0; }
  return 1;
}
