// LX-06 Test: VFS-Syscalls auf LyxOS
// Öffnet /etc/hostname, liest den Inhalt, gibt ihn auf stdout aus.

import src.std.lyxos.fs;
import src.std.alloc;

fn main(): int64 {
    // sys_open: AT_CWD=-1, "/etc/hostname", O_RDONLY=0, mode=0
    var fd: int64 := sys_open("/etc/hostname"c, O_RDONLY, 0);
    if fd < 0 { return 1; }

    var buf: int64 := alloc(256);
    var n: int64 := sys_read(fd, buf as pchar, 255);
    sys_close(fd);

    if n > 0 {
        sys_write(1, buf as pchar, n);
    }

    // sys_seek-Test: Datei neu öffnen und springen
    var fd2: int64 := sys_open("/etc/hostname"c, O_RDONLY, 0);
    if fd2 >= 0 {
        sys_seek(fd2, 0, SEEK_SET);
        sys_close(fd2);
    }

    return 0;
}
