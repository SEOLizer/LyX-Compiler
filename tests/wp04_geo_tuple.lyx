// WP-04: std/geo.lyx — BoundingBoxFromPoints and CalculateBoundingBox
// Verifies that [GeoPoint, GeoPoint] tuple-returning functions compile and
// return non-null (valid heap) pointers for both values.
// Note: field access on tuple-destructured struct vars requires explicit type
// annotation (not yet supported); raw pointer validity is verified here.
//
// Expected output:
//   1
//   1
import std.io;
import std.geo;

fn main(): int64 {
  var p1: GeoPoint := GeoPointNew(0 - 10000000, 0 - 5000000);
  var p2: GeoPoint := GeoPointNew(10000000, 5000000);

  var bbMin, bbMax := BoundingBoxFromPoints(p1, p2);

  // Verify both returned heap pointers are non-null
  var minOk: int64 := 0;
  var maxOk: int64 := 0;
  if (bbMin as int64 != 0) { minOk := 1; }
  if (bbMax as int64 != 0) { maxOk := 1; }

  PrintInt(minOk);
  PrintLn("");
  PrintInt(maxOk);
  PrintLn("");

  return 0;
}
