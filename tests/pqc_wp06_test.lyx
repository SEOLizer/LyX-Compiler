// tests/pqc_wp06_test.lyx
// WP-PQC-06: ML-KEM (CRYSTALS-Kyber, NIST FIPS 203)
//
// Abnahmekriterien:
// AC-WP06.1: MLKEMKeyGen erzeugt korrekt große Schlüssel (k=2,3,4)
// AC-WP06.2: Encapsulate → Decapsulate Roundtrip (SharedKeys stimmen überein)
// AC-WP06.3: Manipulierter Ciphertext → anderen (nicht abgestürzten) SharedKey
// AC-WP06.4: Zwei Encapsulate-Aufrufe mit gleichen Daten → gleichen SharedKey
// AC-WP06.5: Zwei Encapsulate-Aufrufe mit verschiedenen Randomness → verschiedene CTs

unit tests.pqc_wp06_test;

import std.crypto.pqc.mlkem;
import std.alloc;

// Füllt einen Puffer mit deterministischen Byte-Werten
fn fill_buf(buf: int64, size: int64, seed: int64) {
  var v: int64 := seed;
  var i: int64 := 0;
  while (i < size) {
    v := (v * 6364136223846793005) + 1442695040888963407;
    poke8(buf + i, (v >> 16) & 0xFF);
    i := i + 1;
  }
}

fn memcmp(a: int64, b: int64, n: int64): int64 {
  var i: int64 := 0;
  while (i < n) {
    if (peek8(a + i) != peek8(b + i)) { return 1; }
    i := i + 1;
  }
  return 0;
}

// Gibt 1 zurück wenn alle n Bytes in a[] und b[] gleich sind, sonst 0
fn bytes_equal(a: int64, b: int64, n: int64): int64 {
  if (memcmp(a, b, n) == 0) { return 1; }
  return 0;
}

// ─────────────────────────────────────────────────────────────────────────────
// Hilfsfunktion: Schlüsselgrößen für k
fn pk_size(k: int64): int64 {
  if (k == 2) { return 800; }
  if (k == 3) { return 1184; }
  return 1568;
}
fn sk_size(k: int64): int64 {
  if (k == 2) { return 1632; }
  if (k == 3) { return 2400; }
  return 3168;
}
fn ct_size(k: int64): int64 {
  if (k == 2) { return 768; }
  if (k == 3) { return 1088; }
  return 1568;
}

// ─────────────────────────────────────────────────────────────────────────────
// AC-WP06.1: Schlüsselgrößen-Check (KeyGen gibt keine Fehler und
//            füllt die Puffer mit non-zero Bytes)

fn testKeySizes(k: int64): int64 {
  var pks: int64 := pk_size(k);
  var sks: int64 := sk_size(k);
  var cts: int64 := ct_size(k);

  var pk:   int64 := alloc(pks);
  var sk:   int64 := alloc(sks);
  var seed: int64 := alloc(64);
  fill_buf(seed, 64, 0xABCDEF);

  var rc: int64 := MLKEMKeyGen(seed, k, pk, sk);

  // Mindestens ein nicht-null Byte in pk und sk
  var pk_ok: int64 := 0;
  var sk_ok: int64 := 0;
  var i: int64 := 0;
  while (i < pks) { if (peek8(pk + i) != 0) { pk_ok := 1; } i := i + 1; }
  i := 0;
  while (i < sks) { if (peek8(sk + i) != 0) { sk_ok := 1; } i := i + 1; }

  free(pk, pks); free(sk, sks); free(seed, 64);

  if (rc != 0)     { return 1; }
  if (pk_ok == 0)  { return 1; }
  if (sk_ok == 0)  { return 1; }
  return 0;
}

fn testAC1(): int64 {
  var fail: int64 := 0;
  fail := fail + testKeySizes(2);
  fail := fail + testKeySizes(3);
  fail := fail + testKeySizes(4);
  if (fail == 0) {
    PrintLn("OK: MLKEMKeyGen Schluesselgroessen k=2,3,4 (WP-06.1)");
    return 0;
  }
  PrintLn("FAIL: MLKEMKeyGen Schluesselgroessen (WP-06.1)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────
// AC-WP06.2: Encapsulate → Decapsulate Roundtrip

fn testRoundtrip(k: int64): int64 {
  var pks: int64 := pk_size(k);
  var sks: int64 := sk_size(k);
  var cts: int64 := ct_size(k);

  var pk:   int64 := alloc(pks);
  var sk:   int64 := alloc(sks);
  var seed: int64 := alloc(64);
  var rand: int64 := alloc(32);
  var ct:   int64 := alloc(cts);
  var ss1:  int64 := alloc(32);  // SharedKey vom Encapsulate
  var ss2:  int64 := alloc(32);  // SharedKey vom Decapsulate

  fill_buf(seed, 64, 0x12345678);
  fill_buf(rand, 32, 0xDEADBEEF);

  MLKEMKeyGen(seed, k, pk, sk);
  MLKEMEncapsulate(pk, k, rand, ct, ss1);
  MLKEMDecapsulate(sk, k, ct, ss2);

  var ok: int64 := bytes_equal(ss1, ss2, 32);

  free(pk, pks); free(sk, sks); free(seed, 64); free(rand, 32);
  free(ct, cts); free(ss1, 32); free(ss2, 32);
  return ok;
}

fn testAC2(): int64 {
  var fail: int64 := 0;
  if (testRoundtrip(2) == 0) { fail := fail + 1; }
  if (testRoundtrip(3) == 0) { fail := fail + 1; }
  if (testRoundtrip(4) == 0) { fail := fail + 1; }
  if (fail == 0) {
    PrintLn("OK: Encapsulate->Decapsulate Roundtrip k=2,3,4 (WP-06.2)");
    return 0;
  }
  PrintLn("FAIL: Roundtrip (WP-06.2)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────
// AC-WP06.3: Manipulierter CT → anderer SharedKey (implizite Ablehnung)

fn testRejection(k: int64): int64 {
  var pks: int64 := pk_size(k);
  var sks: int64 := sk_size(k);
  var cts: int64 := ct_size(k);

  var pk:     int64 := alloc(pks);
  var sk:     int64 := alloc(sks);
  var seed:   int64 := alloc(64);
  var rand:   int64 := alloc(32);
  var ct_ok:  int64 := alloc(cts);
  var ct_bad: int64 := alloc(cts);
  var ss_ok:  int64 := alloc(32);
  var ss_bad: int64 := alloc(32);
  var ss_ref: int64 := alloc(32);

  fill_buf(seed, 64, 0xCAFEBABE);
  fill_buf(rand, 32, 0x0DDBA11);

  MLKEMKeyGen(seed, k, pk, sk);
  MLKEMEncapsulate(pk, k, rand, ct_ok, ss_ref);

  // ct_bad = ct_ok mit einem manipulierten Byte
  var i: int64 := 0;
  while (i < cts) { poke8(ct_bad + i, peek8(ct_ok + i)); i := i + 1; }
  poke8(ct_bad, peek8(ct_bad) ^ 0xFF);  // erstes Byte flippen

  MLKEMDecapsulate(sk, k, ct_ok,  ss_ok);
  MLKEMDecapsulate(sk, k, ct_bad, ss_bad);

  // ss_ok muss mit ss_ref übereinstimmen
  var ok1: int64 := bytes_equal(ss_ok,  ss_ref, 32);
  // ss_bad muss verschieden von ss_ref sein (nicht abgestürzt, aber anderer Key)
  var ok2: int64 := 0;
  if (memcmp(ss_bad, ss_ref, 32) != 0) { ok2 := 1; }
  // ss_bad muss nicht Null sein (irgendein deterministischer Wert)
  var ok3: int64 := 0;
  i := 0;
  while (i < 32) { if (peek8(ss_bad + i) != 0) { ok3 := 1; } i := i + 1; }

  free(pk, pks); free(sk, sks); free(seed, 64); free(rand, 32);
  free(ct_ok, cts); free(ct_bad, cts);
  free(ss_ok, 32); free(ss_bad, 32); free(ss_ref, 32);

  if (ok1 == 0) { return 1; }
  if (ok2 == 0) { return 1; }
  if (ok3 == 0) { return 1; }
  return 0;
}

fn testAC3(): int64 {
  var fail: int64 := 0;
  fail := fail + testRejection(2);
  fail := fail + testRejection(3);
  fail := fail + testRejection(4);
  if (fail == 0) {
    PrintLn("OK: Implizite Ablehnung bei manipuliertem CT k=2,3,4 (WP-06.3)");
    return 0;
  }
  PrintLn("FAIL: Ablehnung (WP-06.3)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────
// AC-WP06.4: Determinismus — gleiche Eingaben → gleiche Ausgaben

fn testDeterminism(k: int64): int64 {
  var pks: int64 := pk_size(k);
  var sks: int64 := sk_size(k);
  var cts: int64 := ct_size(k);

  var pk1: int64 := alloc(pks); var pk2: int64 := alloc(pks);
  var sk1: int64 := alloc(sks); var sk2: int64 := alloc(sks);
  var seed: int64 := alloc(64);
  var rand: int64 := alloc(32);
  var ct1: int64 := alloc(cts); var ct2: int64 := alloc(cts);
  var ss1: int64 := alloc(32);  var ss2: int64 := alloc(32);

  fill_buf(seed, 64, 0xFEEDFACE);
  fill_buf(rand, 32, 0xBAADF00D);

  MLKEMKeyGen(seed, k, pk1, sk1);
  MLKEMKeyGen(seed, k, pk2, sk2);
  MLKEMEncapsulate(pk1, k, rand, ct1, ss1);
  MLKEMEncapsulate(pk2, k, rand, ct2, ss2);

  var ok1: int64 := bytes_equal(pk1, pk2, pks);
  var ok2: int64 := bytes_equal(ct1, ct2, cts);
  var ok3: int64 := bytes_equal(ss1, ss2, 32);

  free(pk1, pks); free(pk2, pks); free(sk1, sks); free(sk2, sks);
  free(seed, 64); free(rand, 32);
  free(ct1, cts); free(ct2, cts); free(ss1, 32); free(ss2, 32);

  if (ok1 == 0) { return 1; }
  if (ok2 == 0) { return 1; }
  if (ok3 == 0) { return 1; }
  return 0;
}

fn testAC4(): int64 {
  var fail: int64 := 0;
  fail := fail + testDeterminism(2);
  fail := fail + testDeterminism(3);
  fail := fail + testDeterminism(4);
  if (fail == 0) {
    PrintLn("OK: Determinismus (gleiche Eingaben = gleiche Ausgaben) k=2,3,4 (WP-06.4)");
    return 0;
  }
  PrintLn("FAIL: Determinismus (WP-06.4)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────
// AC-WP06.5: Verschiedene Randomness → verschiedene CTs und SharedKeys

fn testRandomness(k: int64): int64 {
  var pks: int64 := pk_size(k);
  var sks: int64 := sk_size(k);
  var cts: int64 := ct_size(k);

  var pk:   int64 := alloc(pks);
  var sk:   int64 := alloc(sks);
  var seed: int64 := alloc(64);
  var r1:   int64 := alloc(32);
  var r2:   int64 := alloc(32);
  var ct1:  int64 := alloc(cts);
  var ct2:  int64 := alloc(cts);
  var ss1:  int64 := alloc(32);
  var ss2:  int64 := alloc(32);

  fill_buf(seed, 64, 0x11223344);
  fill_buf(r1, 32, 0xAAAAAAAA);
  fill_buf(r2, 32, 0xBBBBBBBB);

  MLKEMKeyGen(seed, k, pk, sk);
  MLKEMEncapsulate(pk, k, r1, ct1, ss1);
  MLKEMEncapsulate(pk, k, r2, ct2, ss2);

  var ct_differ: int64 := 0;
  if (memcmp(ct1, ct2, cts) != 0) { ct_differ := 1; }
  var ss_differ: int64 := 0;
  if (memcmp(ss1, ss2, 32) != 0) { ss_differ := 1; }

  free(pk, pks); free(sk, sks); free(seed, 64);
  free(r1, 32); free(r2, 32);
  free(ct1, cts); free(ct2, cts);
  free(ss1, 32); free(ss2, 32);

  if (ct_differ == 0) { return 1; }
  if (ss_differ == 0) { return 1; }
  return 0;
}

fn testAC5(): int64 {
  var fail: int64 := 0;
  fail := fail + testRandomness(2);
  fail := fail + testRandomness(3);
  fail := fail + testRandomness(4);
  if (fail == 0) {
    PrintLn("OK: Verschiedene Randomness ergibt verschiedene CTs k=2,3,4 (WP-06.5)");
    return 0;
  }
  PrintLn("FAIL: Randomness-Diversitaet (WP-06.5)");
  return 1;
}

// ─────────────────────────────────────────────────────────────────────────────

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testAC1();
  failed := failed + testAC2();
  failed := failed + testAC3();
  failed := failed + testAC4();
  failed := failed + testAC5();
  if (failed != 0) {
    PrintLn("FAILED");
    return 1;
  }
  PrintLn("ALL PASSED");
  return 0;
}
