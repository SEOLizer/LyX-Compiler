// Formen, die NICHT vorgespult werden dürfen. Geprüft wird am Erzeugnis
// (keine PCMPEQ-Bytes) und am Wert.
unit main;
import std.io;
import std.alloc;

var _rufe: int64 := 0;

fn hole(p: int64, i: int64): int64 {
  // Eine Funktion mit Nebenwirkung: wird sie in der Bedingung aufgerufen,
  // darf nicht vorgespult werden — das Vorspulen würde die Aufrufe
  // überspringen und die Zählung wäre beobachtbar anders.
  _rufe := _rufe + 1;
  return peek8(p + i);
}

fn mitAufruf(a: int64, b: int64, n: int64): int64 {
  var i: int64 := 0;
  var fund: int64 := 0 - 1;
  while (i < n) {
    if (hole(a, i) != peek8(b + i)) { fund := i; i := n; }
    i := i + 1;
  }
  return fund;
}

fn mitKleinerAls(a: int64, b: int64, n: int64): int64 {
  // `<` statt `==`/`!=`: ein Grössenvergleich ist keine Gleichheit, und
  // PCMPGT wäre vorzeichenbehaftet — bleibt skalar.
  var i: int64 := 0;
  var fund: int64 := 0 - 1;
  while (i < n) {
    if (peek8(a + i) < peek8(b + i)) { fund := i; i := n; }
    i := i + 1;
  }
  return fund;
}

fn mitDrittemSchritt(a: int64, b: int64, n: int64): int64 {
  var i: int64 := 0;
  var fund: int64 := 0 - 1;
  var z: int64 := 0;
  while (i < n) {
    if (peek8(a + i) != peek8(b + i)) { fund := i; }
    z := z + 1;
    i := i + 1;
  }
  return fund + z;
}

fn main(): int64 {
  var n: int64 := 100;
  var a: int64 := alloc(n);
  var b: int64 := alloc(n);
  var i: int64 := 0;
  while (i < n) { poke8(a + i, 7); poke8(b + i, 7); i := i + 1; }
  poke8(b + 80, 9);
  PrintStr("mit_aufruf="); PrintLn(mitAufruf(a, b, n));
  PrintStr("aufrufe="); PrintLn(_rufe);
  PrintStr("mit_kleiner_als="); PrintLn(mitKleinerAls(a, b, n));
  PrintStr("mit_drittem="); PrintLn(mitDrittemSchritt(a, b, n));
  return 0;
}
