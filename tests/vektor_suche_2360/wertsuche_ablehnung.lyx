// Formen, die trotz EINER Lesung nicht vorgespult werden dürfen (#2415).
unit main;
import std.io;
import std.alloc;

var _rufe: int64 := 0;

fn hole(): int64 { _rufe := _rufe + 1; return 32; }

// Ein AUFRUF als Wert: er hat eine Nebenwirkung, und Vorspulen würde die
// Aufrufe überspringen. Muss skalar bleiben.
fn mitAufruf(a: int64, n: int64): int64 {
  var i: int64 := 0;
  var fund: int64 := 0 - 1;
  while (i < n) {
    if (peek8(a + i) == hole()) { fund := i; i := n; }
    i := i + 1;
  }
  return fund;
}

// Eine RECHNUNG als Wert: die Invarianz ist nicht ohne weiteres zu belegen.
fn mitRechnung(a: int64, n: int64, w: int64): int64 {
  var i: int64 := 0;
  var fund: int64 := 0 - 1;
  while (i < n) {
    if (peek8(a + i) == w + 1) { fund := i; i := n; }
    i := i + 1;
  }
  return fund;
}

fn main(): int64 {
  var n: int64 := 100;
  var a: int64 := alloc(n);
  var i: int64 := 0;
  while (i < n) { poke8(a + i, 65); i := i + 1; }
  poke8(a + 80, 32);
  PrintStr("mit_aufruf="); PrintLn(mitAufruf(a, n));
  PrintStr("aufrufe="); PrintLn(_rufe);
  PrintStr("mit_rechnung="); PrintLn(mitRechnung(a, n, 31));
  return 0;
}
