unit main;
import std.io;
import std.alloc;

fn findeLiteral(a: int64, n: int64): int64 {
  var i: int64 := 0;
  var fund: int64 := 0 - 1;
  while (i < n) {
    if (peek8(a + i) == 32) { fund := i; i := n; }
    i := i + 1;
  }
  return fund;
}

fn findeLocal(a: int64, n: int64, w: int64): int64 {
  var i: int64 := 0;
  var fund: int64 := 0 - 1;
  while (i < n) {
    if (peek8(a + i) == w) { fund := i; i := n; }
    i := i + 1;
  }
  return fund;
}

fn findeUngleich16(a: int64, n: int64, w: int64): int64 {
  var i: int64 := 0;
  var fund: int64 := 0 - 1;
  while (i < n) {
    if (peek16(a + i * 2) != w) { fund := i; i := n; }
    i := i + 1;
  }
  return fund;
}

fn findeLocal32(a: int64, n: int64, w: int64): int64 {
  var i: int64 := 0;
  var fund: int64 := 0 - 1;
  while (i < n) {
    if (peek32(a + i * 4) == w) { fund := i; i := n; }
    i := i + 1;
  }
  return fund;
}

fn main(): int64 {
  var n: int64 := 200;
  var a: int64 := alloc(n * 4);
  // Byte-Fälle: alles 65, Treffer an verschiedenen Stellen.
  var pos: int64 := 0;
  while (pos < 7) {
    var p: int64 := 0;
    if (pos == 0) { p := 0; } else if (pos == 1) { p := 1; }
    else if (pos == 2) { p := 15; } else if (pos == 3) { p := 16; }
    else if (pos == 4) { p := 99; } else if (pos == 5) { p := 96; }
    else { p := 0 - 1; }
    var k: int64 := 0;
    while (k < n * 4) { poke8(a + k, 65); k := k + 1; }
    if (p >= 0) { poke8(a + p, 32); }
    PrintStr("literal p="); PrintStr(IntToStr(p)); PrintStr(" -> "); PrintStrLn(IntToStr(findeLiteral(a, 100)));
    PrintStr("local   p="); PrintStr(IntToStr(p)); PrintStr(" -> "); PrintStrLn(IntToStr(findeLocal(a, 100, 32)));
    pos := pos + 1;
  }
  // 16 Bit, Ungleichheit
  var k2: int64 := 0;
  while (k2 < n) { poke16(a + k2 * 2, 7); k2 := k2 + 1; }
  poke16(a + 33 * 2, 9);
  PrintStr("ungleich16 -> "); PrintStrLn(IntToStr(findeUngleich16(a, 100, 7)));
  // 32 Bit
  var k3: int64 := 0;
  while (k3 < n) { poke32(a + k3 * 4, 0); k3 := k3 + 1; }
  poke32(a + 42 * 4, 123456);
  PrintStr("local32 -> "); PrintStrLn(IntToStr(findeLocal32(a, 100, 123456)));
  return 0;
}
