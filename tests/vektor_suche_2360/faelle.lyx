unit main;
import std.io;
import std.alloc;

// Suchschleife: erstes ungleiches Byte. Gibt den Index zurueck und laesst
// den Zaehler so zurueck, wie die skalare Fassung ihn laesst.
fn ersteUngleich8(a: int64, b: int64, n: int64): int64 {
  var i: int64 := 0;
  var fund: int64 := 0 - 1;
  while (i < n) {
    if (peek8(a + i) != peek8(b + i)) { fund := i; i := n; }
    i := i + 1;
  }
  PrintStr("  i_danach="); PrintLn(i);
  return fund;
}

// Gleichheitsform, ohne Fruehausstieg: zaehlt alle Treffer.
fn zaehleGleich8(a: int64, b: int64, n: int64): int64 {
  var i: int64 := 0;
  var c: int64 := 0;
  while (i < n) {
    if (peek8(a + i) == peek8(b + i)) { c := c + 1; }
    i := i + 1;
  }
  return c;
}

fn ersteUngleich16(a: int64, b: int64, n: int64): int64 {
  var i: int64 := 0;
  var fund: int64 := 0 - 1;
  while (i < n) {
    if (peek16(a + i * 2) != peek16(b + i * 2)) { fund := i; i := n; }
    i := i + 1;
  }
  return fund;
}

fn ersteUngleich32(a: int64, b: int64, n: int64): int64 {
  var i: int64 := 0;
  var fund: int64 := 0 - 1;
  while (i < n) {
    if (peek32(a + i * 4) != peek32(b + i * 4)) { fund := i; i := n; }
    i := i + 1;
  }
  return fund;
}

fn ersteUngleich64(a: int64, b: int64, n: int64): int64 {
  var i: int64 := 0;
  var fund: int64 := 0 - 1;
  while (i < n) {
    if (peek64(a + i * 8) != peek64(b + i * 8)) { fund := i; i := n; }
    i := i + 1;
  }
  return fund;
}

fn fuell(p: int64, n: int64, w: int64): void {
  var i: int64 := 0;
  while (i < n) { poke8(p + i, w); i := i + 1; }
}

fn main(): int64 {
  var N: int64 := 200;
  var a: int64 := alloc(N * 8);
  var b: int64 := alloc(N * 8);

  // ── Breite 1, Treffer an verschiedenen Stellen ───────────────────────────
  var faelle: int64 := alloc(64);
  poke64(faelle,      0);      // erstes Element
  poke64(faelle + 8,  1);
  poke64(faelle + 16, 15);     // letztes Element des ersten Blocks
  poke64(faelle + 24, 16);     // erstes Element des zweiten Blocks
  poke64(faelle + 32, 99);     // im Rest hinter dem letzten vollen Block (n=100)
  poke64(faelle + 40, 96);
  poke64(faelle + 48, 0 - 1);  // kein Treffer
  var k: int64 := 0;
  while (k < 7) {
    var pos: int64 := peek64(faelle + k * 8);
    var n: int64 := 100;
    fuell(a, N * 8, 7); fuell(b, N * 8, 7);
    if (pos >= 0) { poke8(b + pos, 9); }
    PrintStr("breite1 pos="); PrintLn(pos);
    var r: int64 := ersteUngleich8(a, b, n);
    PrintStr("  fund="); PrintLn(r);
    k := k + 1;
  }

  // ── n nicht Vielfaches der Blockbreite, Treffer dahinter ────────────────
  fuell(a, N * 8, 3); fuell(b, N * 8, 3);
  poke8(b + 20, 4);
  PrintStr("n=21 (Rest), Treffer bei 20: "); PrintLn(ersteUngleich8(a, b, 21));
  PrintStr("n=20 (Treffer liegt ausserhalb): "); PrintLn(ersteUngleich8(a, b, 20));

  // ── n kleiner als ein Block ─────────────────────────────────────────────
  fuell(a, N * 8, 3); fuell(b, N * 8, 3);
  poke8(b + 5, 4);
  PrintStr("n=8: "); PrintLn(ersteUngleich8(a, b, 8));
  PrintStr("n=0: "); PrintLn(ersteUngleich8(a, b, 0));

  // ── Gleichheitsform ohne Fruehausstieg ──────────────────────────────────
  fuell(a, N * 8, 5); fuell(b, N * 8, 5);
  poke8(b + 3, 6); poke8(b + 70, 6);
  PrintStr("gleiche von 100 (erwartet 98): "); PrintLn(zaehleGleich8(a, b, 100));

  // ── breitere Elemente ───────────────────────────────────────────────────
  fuell(a, N * 8, 0); fuell(b, N * 8, 0);
  poke16(b + 30 * 2, 1);
  PrintStr("breite2, Treffer bei 30: "); PrintLn(ersteUngleich16(a, b, 100));
  fuell(b, N * 8, 0);
  poke32(b + 17 * 4, 1);
  PrintStr("breite4, Treffer bei 17: "); PrintLn(ersteUngleich32(a, b, 100));
  fuell(b, N * 8, 0);
  poke64(b + 9 * 8, 1);
  PrintStr("breite8, Treffer bei 9: "); PrintLn(ersteUngleich64(a, b, 100));
  fuell(b, N * 8, 0);
  PrintStr("breite8, kein Treffer: "); PrintLn(ersteUngleich64(a, b, 100));
  return 0;
}
