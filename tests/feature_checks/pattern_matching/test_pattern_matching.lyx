fn classify(n: int64): int64 {
    match n {
        case 0 => {
            PrintLn("zero");
        }
        case 1 | 2 | 3 => {
            PrintLn("small");
        }
        case 10 | 20 | 30 => {
            PrintLn("tens");
        }
        case _ => {
            PrintLn("other");
        }
    }
    return 0;
}

fn main(): int64 {
    classify(0);
    classify(1);
    classify(2);
    classify(3);
    classify(5);
    classify(10);
    classify(20);
    classify(99);
    return 0;
}
