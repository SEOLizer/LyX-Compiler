// Test: enum types — basic auto-numbering and explicit values

enum Color {
  RED;      // 0
  GREEN;    // 1
  BLUE;     // 2
};

enum HttpStatus {
  OK           := 200;
  NOT_FOUND    := 404;
  SERVER_ERROR := 500;
};

enum Direction {
  NORTH;        // 0
  SOUTH;        // 1
  EAST  := 10;  // 10
  WEST;         // 11 (continues from last explicit)
};

fn main(): int64 {
  Print("RED    = "); PrintLn(StrFromInt(RED));
  Print("GREEN  = "); PrintLn(StrFromInt(GREEN));
  Print("BLUE   = "); PrintLn(StrFromInt(BLUE));

  Print("OK           = "); PrintLn(StrFromInt(OK));
  Print("NOT_FOUND    = "); PrintLn(StrFromInt(NOT_FOUND));
  Print("SERVER_ERROR = "); PrintLn(StrFromInt(SERVER_ERROR));

  Print("NORTH = "); PrintLn(StrFromInt(NORTH));
  Print("SOUTH = "); PrintLn(StrFromInt(SOUTH));
  Print("EAST  = "); PrintLn(StrFromInt(EAST));
  Print("WEST  = "); PrintLn(StrFromInt(WEST));

  // Enum value in expression
  var status: int64 := OK;
  if (status == 200) {
    PrintLn("status is OK");
  }

  // Enum value in arithmetic
  var sum: int64 := RED + GREEN + BLUE;
  Print("RED+GREEN+BLUE = "); PrintLn(StrFromInt(sum));

  return 0;
}
