// Test: multi-return / tuple
// Expected output:
//   divmod(17, 5): q=3 r=2
//   divmod(100, 7): q=14 r=2

fn divmod(a: int64, b: int64): (int64, int64) {
  return (a / b, a % b);
}

fn main(): int64 {
  var q, r := divmod(17, 5);
  Print("divmod(17, 5): q=");
  Print(StrFromInt(q));
  Print(" r=");
  PrintLn(StrFromInt(r));

  var q2, r2 := divmod(100, 7);
  Print("divmod(100, 7): q=");
  Print(StrFromInt(q2));
  Print(" r=");
  PrintLn(StrFromInt(r2));

  return 0;
}
