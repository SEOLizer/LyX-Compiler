// Test: try/catch/throw — exception handling
// Expected output:
//   before try
//   caught: 42
//   after try
//   no throw path: done

fn main(): int64 {
  // Basic throw + catch
  PrintLn("before try");
  try {
    throw 42;
    PrintLn("unreachable");
  } catch (e: int64) {
    Print("caught: ");
    PrintLn(StrFromInt(e));
  }
  PrintLn("after try");

  // No-throw path
  try {
    var x: int64 := 7;
  } catch (e: int64) {
    PrintLn("should not happen");
  }
  PrintLn("no throw path: done");

  return 0;
}
