fn max<T>(a: T, b: T): T {
    if (a > b) {
        return a;
    }
    return b;
}

fn min<T>(a: T, b: T): T {
    if (a < b) {
        return a;
    }
    return b;
}

fn main(): int64 {
    var x: int64 := max<int64>(10, 20);
    Print("max(10, 20) = "); PrintLn(StrFromInt(x));

    var y: int64 := max<int64>(42, 7);
    Print("max(42, 7) = "); PrintLn(StrFromInt(y));

    var a: int64 := min<int64>(3, 9);
    Print("min(3, 9) = "); PrintLn(StrFromInt(a));

    var b: int64 := min<int64>(100, 1);
    Print("min(100, 1) = "); PrintLn(StrFromInt(b));

    return 0;
}
