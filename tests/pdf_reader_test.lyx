// tests/pdf_reader_test.lyx
// WP-PDF-09: read and parse existing PDF files

@description("WP-PDF-09: PDF reader test")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pdf_reader_test;

import std.pdf;

// Compare mmap'd buffer against a pchar literal; returns 1 if equal.
fn _cmpBuf(buf: int64, expected: pchar): int64 {
  var i: int64 := 0;
  while (1 == 1) {
    var ec: int64 := StrCharAt(expected, i);
    var bc: int64 := peek8(buf + i);
    if (ec != bc) { return 0; }
    if (ec == 0) { return 1; }
    i := i + 1;
  }
  return 1;
}

fn testReadMetadata(): int64 {
  // Write a PDF with all metadata fields set
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew\n"); return 1; }

  PdfSetTitle(doc, "WP-PDF-09 Reader Test");
  PdfSetAuthor(doc, "Test Author");
  PdfSetSubject(doc, "Reader unit test");
  PdfSetKeywords(doc, "pdf reader test");

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "Reader test page");

  var err: int64 := PdfSave(doc, "/tmp/pdf_reader_meta.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (meta)\n"); return 1; }

  // Read it back
  var rdr: int64 := PdfOpen("/tmp/pdf_reader_meta.pdf");
  if (rdr == 0) { PrintStr("FAIL: PdfOpen (meta)\n"); return 1; }

  var pageCount: int64 := PdfRdrPageCount(rdr);
  if (pageCount != 1) {
    PrintStr("FAIL: pageCount=");
    PrintInt(pageCount);
    PrintStr(" expected 1\n");
    PdfClose(rdr);
    return 1;
  }

  var buf: int64 := mmap(0, 256, 3, 34, -1, 0);
  if (buf == 0) { PdfClose(rdr); PrintStr("FAIL: mmap buf\n"); return 1; }

  PdfRdrGetTitle(rdr, buf, 256);
  if (_cmpBuf(buf, "WP-PDF-09 Reader Test") == 0) {
    PrintStr("FAIL: title mismatch\n");
    munmap(buf, 256);
    PdfClose(rdr);
    return 1;
  }

  PdfRdrGetAuthor(rdr, buf, 256);
  if (_cmpBuf(buf, "Test Author") == 0) {
    PrintStr("FAIL: author mismatch\n");
    munmap(buf, 256);
    PdfClose(rdr);
    return 1;
  }

  PdfRdrGetSubject(rdr, buf, 256);
  if (_cmpBuf(buf, "Reader unit test") == 0) {
    PrintStr("FAIL: subject mismatch\n");
    munmap(buf, 256);
    PdfClose(rdr);
    return 1;
  }

  PdfRdrGetKeywords(rdr, buf, 256);
  if (_cmpBuf(buf, "pdf reader test") == 0) {
    PrintStr("FAIL: keywords mismatch\n");
    munmap(buf, 256);
    PdfClose(rdr);
    return 1;
  }

  munmap(buf, 256);
  PdfClose(rdr);
  PrintStr("OK: metadata read back correctly\n");
  return 0;
}

fn testReadPageCount(): int64 {
  // Write a 3-page PDF and verify the reader returns 3
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew (pages)\n"); return 1; }

  var p0: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p1: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  var p2: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, p0, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p0, 72.0, 750.0, "Page 1");
  PdfSetFont(doc, p1, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p1, 72.0, 750.0, "Page 2");
  PdfSetFont(doc, p2, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, p2, 72.0, 750.0, "Page 3");

  var err: int64 := PdfSave(doc, "/tmp/pdf_reader_pages.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (pages)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_reader_pages.pdf");
  if (rdr == 0) { PrintStr("FAIL: PdfOpen (pages)\n"); return 1; }

  var n: int64 := PdfRdrPageCount(rdr);
  PdfClose(rdr);
  if (n != 3) {
    PrintStr("FAIL: expected 3 pages, got ");
    PrintInt(n);
    PrintStr("\n");
    return 1;
  }
  PrintStr("OK: 3-page PDF read correctly\n");
  return 0;
}

fn testReadNoMeta(): int64 {
  // PDF without metadata: title/author should be empty
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew (nometa)\n"); return 1; }

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "No metadata");

  var err: int64 := PdfSave(doc, "/tmp/pdf_reader_nometa.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (nometa)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_reader_nometa.pdf");
  if (rdr == 0) { PrintStr("FAIL: PdfOpen (nometa)\n"); return 1; }

  var n: int64 := PdfRdrPageCount(rdr);

  var buf: int64 := mmap(0, 256, 3, 34, -1, 0);
  PdfRdrGetTitle(rdr, buf, 256);
  var titleEmpty: int64 := peek8(buf);
  munmap(buf, 256);
  PdfClose(rdr);

  if (n != 1) {
    PrintStr("FAIL: expected 1 page, got ");
    PrintInt(n);
    PrintStr("\n");
    return 1;
  }
  if (titleEmpty != 0) {
    PrintStr("FAIL: expected empty title\n");
    return 1;
  }
  PrintStr("OK: no-metadata PDF read correctly\n");
  return 0;
}

fn testReadCompressed(): int64 {
  // Write a compressed PDF and verify the reader handles it
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew (compressed)\n"); return 1; }

  PdfSetTitle(doc, "Compressed Test");
  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "Compressed content stream");

  PdfSetCompression(doc, 1);
  var err: int64 := PdfSave(doc, "/tmp/pdf_reader_compressed.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (compressed)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_reader_compressed.pdf");
  if (rdr == 0) { PrintStr("FAIL: PdfOpen (compressed)\n"); return 1; }

  var n: int64 := PdfRdrPageCount(rdr);
  var buf: int64 := mmap(0, 256, 3, 34, -1, 0);
  PdfRdrGetTitle(rdr, buf, 256);
  var ok: int64 := _cmpBuf(buf, "Compressed Test");
  munmap(buf, 256);
  PdfClose(rdr);

  if (n != 1 || ok == 0) {
    PrintStr("FAIL: compressed PDF reader (pages=");
    PrintInt(n);
    PrintStr(" titleOk=");
    PrintInt(ok);
    PrintStr(")\n");
    return 1;
  }
  PrintStr("OK: compressed PDF read correctly\n");
  return 0;
}

fn testReadSpecialCharsInMeta(): int64 {
  // Metadata with escaped parens and backslash should round-trip correctly
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew (special)\n"); return 1; }

  PdfSetTitle(doc, "Test (special) chars");
  PdfSetAuthor(doc, "O'Brien");

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "Special chars in metadata");

  var err: int64 := PdfSave(doc, "/tmp/pdf_reader_special.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (special)\n"); return 1; }

  var rdr: int64 := PdfOpen("/tmp/pdf_reader_special.pdf");
  if (rdr == 0) { PrintStr("FAIL: PdfOpen (special)\n"); return 1; }

  var buf: int64 := mmap(0, 256, 3, 34, -1, 0);
  PdfRdrGetTitle(rdr, buf, 256);
  var ok1: int64 := _cmpBuf(buf, "Test (special) chars");
  PdfRdrGetAuthor(rdr, buf, 256);
  var ok2: int64 := _cmpBuf(buf, "O'Brien");
  munmap(buf, 256);
  PdfClose(rdr);

  if (ok1 == 0 || ok2 == 0) {
    PrintStr("FAIL: special chars round-trip (title=");
    PrintInt(ok1);
    PrintStr(" author=");
    PrintInt(ok2);
    PrintStr(")\n");
    return 1;
  }
  PrintStr("OK: special-chars metadata round-trip correct\n");
  return 0;
}

pub fn main(): int64 {
  if (testReadMetadata()         != 0) { return 1; }
  if (testReadPageCount()        != 0) { return 1; }
  if (testReadNoMeta()           != 0) { return 1; }
  if (testReadCompressed()       != 0) { return 1; }
  if (testReadSpecialCharsInMeta() != 0) { return 1; }
  PrintStr("All WP-PDF-09 reader tests passed.\n");
  return 0;
}
