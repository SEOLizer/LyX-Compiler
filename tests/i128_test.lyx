// tests/i128_test.lyx
// Selbstpruefende Testbatterie fuer std.i128.
//
// Sollwerte aus Python, dessen Ganzzahlen beliebig gross sind und daher keine
// 128-Bit-Grenze kennen — die Referenz kann den Fehler also nicht teilen.
//
// Dazu strukturelle Aussagen, die ohne fremde Zahl gelten:
//
//   * a*b = hi*2^64 + lo, nachgerechnet ueber die Division: (a*b)/b = a
//   * Division und Multiplikation sind zueinander invers: q*b + r = a, r < b
//   * Einlesen und Ausgeben sind zueinander invers, ueber alle 39 Stellen
//   * MulHi ist genau dann ungleich null, wenn a*b in 64 Bit ueberlaeuft
//
// Und eine Gegenprobe: der naive 64-Bit-Weg liefert bei denselben Zahlen
// erkennbar etwas anderes.

unit main;

import std.i128;
import std.bits;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr("\n"c);
  }
}

fn CheckStr(name: pchar, buf: int64, want: pchar): void {
  _checks := _checks + 1;
  var i: int64 := 0;
  var ok: bool := true;
  var run: bool := true;
  while (run) {
    var a: int64 := peek8(buf + i);
    var b: int64 := peek8(want + i);
    if (a != b) { ok := false; run := false; }
    else {
      if (a == 0) { run := false; }
    }
    i := i + 1;
  }
  if (!ok) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got=\""c);
    PrintStr(buf);
    PrintStr("\" want=\""c);
    PrintStr(want);
    PrintStr("\"\n"c);
  }
}

// Ein 128-Bit-Wert stimmt mit (hi,lo) ueberein?
fn CheckVal(name: pchar, p: int64, wantHi: int64, wantLo: int64): void {
  _checks := _checks + 1;
  var hi: int64 := I128Hi(p);
  var lo: int64 := I128Lo(p);
  var ok: bool := hi == wantHi;
  if (ok) { ok := lo == wantLo; }
  if (!ok) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got hi="c);
    PrintInt(hi);
    PrintStr(" lo="c);
    PrintInt(lo);
    PrintStr("  want hi="c);
    PrintInt(wantHi);
    PrintStr(" lo="c);
    PrintInt(wantLo);
    PrintStr("\n"c);
  }
}

var _s: int64 := 88172645463325252;

fn Rnd(): int64 {
  _s := _s * 6364136223846793005 + 1442695040888963407;
  return _s;
}

fn main(): int64 {
  var MONE: int64 := 0 - 1;
  var MIN: int64 := 1 << 63;
  var MAX: int64 := 9223372036854775807;

  var a: int64 := alloc(16);
  var b: int64 := alloc(16);
  var c: int64 := alloc(16);
  var q: int64 := alloc(16);
  var r: int64 := alloc(16);
  var buf: int64 := alloc(64);

  // ── Setzen und Lesen ───────────────────────────────────────────────────────
  I128Set(a, 7, 42);
  CheckI("hi"c, I128Hi(a), 7);
  CheckI("lo"c, I128Lo(a), 42);
  I128Zero(a);
  CheckB("isZero"c, I128IsZero(a), true);
  I128SetU64(a, MONE);
  CheckVal("setU64"c, a, 0, MONE);
  CheckB("setU64NotNeg"c, I128IsNeg(a), false);
  CheckB("setU64FitsU64"c, I128FitsU64(a), true);
  CheckB("setU64NotFitsI64"c, I128FitsI64(a), false);
  I128SetI64(a, MONE);
  CheckVal("setI64neg"c, a, MONE, MONE);
  CheckB("setI64IsNeg"c, I128IsNeg(a), true);
  CheckB("setI64FitsI64"c, I128FitsI64(a), true);
  I128SetI64(a, 42);
  CheckVal("setI64pos"c, a, 0, 42);
  I128Copy(a, b);
  CheckB("copyEquals"c, I128Equals(a, b), true);

  // ── Das volle Produkt ──────────────────────────────────────────────────────
  //
  // Sollwerte aus Python: (a*b) >> 64 bzw. & (2**64-1).
  CheckI("mulHi.small"c, I128MulHiU(3, 4), 0);
  CheckI("mulHi.2p32"c, I128MulHiU(4294967296, 4294967296), 1);
  // MAX*2 = 2^64-2, also hi=0
  CheckI("mulHi.maxTimes2"c, I128MulHiU(MAX, 2), 0);
  // 2^63 * 2 = 2^64, also hi=1, lo=0
  CheckI("mulHi.minTimes2"c, I128MulHiU(MIN, 2), 1);
  CheckI("mulLo.minTimes2"c, I128MulLo(MIN, 2), 0);
  // (2^64-1)^2 = 2^128 - 2^65 + 1 -> hi = 2^64-2, lo = 1
  CheckI("mulHi.onesSquared"c, I128MulHiU(MONE, MONE), 0 - 2);
  CheckI("mulLo.onesSquared"c, I128MulLo(MONE, MONE), 1);
  CheckI("mulHi.byZero"c, I128MulHiU(MONE, 0), 0);
  CheckI("mulHi.byOne"c, I128MulHiU(MONE, 1), 0);

  // Der Uebertrag aus der mittleren Spalte — genau hier irren sich naive
  // Fassungen. Sollwerte aus Python.
  CheckI("mulHi.mid1"c, I128MulHiU(0xFFFFFFFF, 0xFFFFFFFF), 0);
  CheckI("mulHi.mid2"c, I128MulHiU(0x100000000, 0xFFFFFFFFFF), 255);
  CheckI("mulHi.mid3"c, I128MulHiU(0xDEADBEEFCAFEBABE, 0x1234567890ABCDEF), 0x0FD5BDEEE268600E);
  CheckI("mulLo.mid3"c, I128MulLo(0xDEADBEEFCAFEBABE, 0x1234567890ABCDEF), 0x773285AE1C447D62);

  // Vorzeichenbehaftet: (-1)*(-1) = 1, also hi = 0
  CheckI("mulHiS.negNeg"c, I128MulHiS(MONE, MONE), 0);
  // (-1)*1 = -1, hi = -1
  CheckI("mulHiS.negPos"c, I128MulHiS(MONE, 1), MONE);
  CheckI("mulHiS.posPos"c, I128MulHiS(3, 4), 0);
  // -2^63 * 2 = -2^64, hi = -1, lo = 0
  CheckI("mulHiS.minTimes2"c, I128MulHiS(MIN, 2), MONE);

  // Ueberlaufmeldung
  CheckB("ovf.no"c, I128MulOverflowsU(1000000, 1000000), false);
  CheckB("ovf.yes"c, I128MulOverflowsU(MONE, 2), true);
  CheckB("ovf.exact"c, I128MulOverflowsU(4294967296, 4294967295), false);
  CheckB("ovf.justOver"c, I128MulOverflowsU(4294967296, 4294967296), true);

  I128Mul64U(MONE, MONE, a);
  CheckVal("mul64U"c, a, 0 - 2, 1);
  I128Mul64S(MONE, MONE, a);
  CheckVal("mul64S"c, a, 0, 1);

  // ── Vorzeichenloser Vergleich ──────────────────────────────────────────────
  CheckB("ltu.plain"c, I128LtU64(1, 2), true);
  CheckB("ltu.rev"c, I128LtU64(2, 1), false);
  CheckB("ltu.eq"c, I128LtU64(2, 2), false);
  // Der Punkt: -1 ist als Bitmuster die GROESSTE Zahl
  CheckB("ltu.minusOneIsBig"c, I128LtU64(MAX, MONE), true);
  var signedLies: bool := MONE < MAX;
  CheckB("ltu.signedWouldLie"c, signedLies, true);

  // ── Addieren und Subtrahieren ──────────────────────────────────────────────
  I128Set(a, 0, MONE);
  I128Set(b, 0, 1);
  CheckI("add.carryOut"c, I128Add(a, b, c), 0);
  CheckVal("add.carries"c, c, 1, 0);

  I128Set(a, MONE, MONE);
  I128Set(b, 0, 1);
  CheckI("add.overflows"c, I128Add(a, b, c), 1);
  CheckVal("add.wraps"c, c, 0, 0);

  I128Set(a, 0, 0);
  I128Set(b, 0, 1);
  CheckI("sub.borrows"c, I128Sub(a, b, c), 1);
  CheckVal("sub.wraps"c, c, MONE, MONE);

  I128Set(a, 1, 0);
  I128Set(b, 0, 1);
  CheckI("sub.borrowFromHi"c, I128Sub(a, b, c), 0);
  CheckVal("sub.result"c, c, 0, MONE);

  // Ausgabe darf auf den Eingang zeigen
  I128Set(a, 0, 5);
  I128Set(b, 0, 3);
  I128Add(a, b, a);
  CheckVal("add.inPlace"c, a, 0, 8);
  I128Sub(a, b, a);
  CheckVal("sub.inPlace"c, a, 0, 5);

  // Negieren
  I128SetU64(a, 1);
  I128Neg(a, c);
  CheckVal("neg.one"c, c, MONE, MONE);
  I128Neg(c, c);
  CheckVal("neg.twice"c, c, 0, 1);
  I128Zero(a);
  I128Neg(a, c);
  CheckVal("neg.zero"c, c, 0, 0);
  I128Set(a, 1, 0);
  I128Neg(a, c);
  CheckVal("neg.hiOnly"c, c, MONE, 0);

  I128SetI64(a, 0 - 42);
  I128Abs(a, c);
  CheckVal("abs.neg"c, c, 0, 42);
  I128SetI64(a, 42);
  I128Abs(a, c);
  CheckVal("abs.pos"c, c, 0, 42);

  // Uebertragsketten einzeln
  var cout: int64 := alloc(8);
  CheckI("addCarry.sum"c, I128AddCarry(1, 2, 0, cout), 3);
  CheckI("addCarry.noCarry"c, peek64(cout), 0);
  CheckI("addCarry.wrap"c, I128AddCarry(MONE, 1, 0, cout), 0);
  CheckI("addCarry.carry"c, peek64(cout), 1);
  CheckI("addCarry.cin"c, I128AddCarry(MONE, 0, 1, cout), 0);
  CheckI("addCarry.cinCarry"c, peek64(cout), 1);
  CheckI("subBorrow.diff"c, I128SubBorrow(5, 3, 0, cout), 2);
  CheckI("subBorrow.noBorrow"c, peek64(cout), 0);
  CheckI("subBorrow.wrap"c, I128SubBorrow(0, 1, 0, cout), MONE);
  CheckI("subBorrow.borrow"c, peek64(cout), 1);

  // ── Schieben ───────────────────────────────────────────────────────────────
  I128Set(a, 0, 1);
  I128Shl(a, 64, c);
  CheckVal("shl.64"c, c, 1, 0);
  I128Shl(a, 127, c);
  CheckVal("shl.127"c, c, MIN, 0);
  I128Shl(a, 128, c);
  CheckVal("shl.128"c, c, 0, 0);
  I128Shl(a, 0, c);
  CheckVal("shl.0"c, c, 0, 1);
  I128Set(a, 0, MONE);
  I128Shl(a, 1, c);
  CheckVal("shl.crossesBoundary"c, c, 1, 0 - 2);

  I128Set(a, 1, 0);
  I128ShrU(a, 64, c);
  CheckVal("shr.64"c, c, 0, 1);
  I128ShrU(a, 1, c);
  CheckVal("shr.1"c, c, 0, MIN);
  I128Set(a, MONE, MONE);
  I128ShrU(a, 127, c);
  CheckVal("shr.allOnes127"c, c, 0, 1);
  I128ShrU(a, 128, c);
  CheckVal("shr.128"c, c, 0, 0);

  // Arithmetisch: das Vorzeichen bleibt
  I128Set(a, MONE, MONE);
  I128Sar(a, 127, c);
  CheckVal("sar.negStaysNeg"c, c, MONE, MONE);
  I128Sar(a, 200, c);
  CheckVal("sar.negFar"c, c, MONE, MONE);
  I128Set(a, MAX, MONE);
  I128Sar(a, 200, c);
  CheckVal("sar.posFar"c, c, 0, 0);
  I128Set(a, 0 - 2, 0);
  I128Sar(a, 1, c);
  CheckVal("sar.byOne"c, c, MONE, 0);

  // ── Bits ───────────────────────────────────────────────────────────────────
  I128Set(a, MONE, MONE);
  CheckI("popCount.all"c, I128PopCount(a), 128);
  I128Zero(a);
  CheckI("popCount.none"c, I128PopCount(a), 0);
  CheckI("highest.zero"c, I128HighestSet(a), 0 - 1);
  I128Set(a, 0, 1);
  CheckI("highest.bit0"c, I128HighestSet(a), 0);
  I128Set(a, 1, 0);
  CheckI("highest.bit64"c, I128HighestSet(a), 64);
  I128Set(a, MIN, 0);
  CheckI("highest.bit127"c, I128HighestSet(a), 127);
  CheckB("testBit.127"c, I128TestBit(a, 127), true);
  CheckB("testBit.126"c, I128TestBit(a, 126), false);
  CheckB("testBit.oob"c, I128TestBit(a, 128), false);
  I128Zero(a);
  I128SetBit(a, 100);
  CheckI("setBit.pop"c, I128PopCount(a), 1);
  CheckB("setBit.test"c, I128TestBit(a, 100), true);

  // ── Vergleichen ────────────────────────────────────────────────────────────
  I128Set(a, 0, 5);
  I128Set(b, 0, 7);
  CheckI("cmpU.lt"c, I128CmpU(a, b), 0 - 1);
  CheckI("cmpU.gt"c, I128CmpU(b, a), 1);
  CheckI("cmpU.eq"c, I128CmpU(a, a), 0);
  I128Set(a, 1, 0);
  I128Set(b, 0, MONE);
  CheckI("cmpU.hiWins"c, I128CmpU(a, b), 1);

  // Der Unterschied zwischen den beiden Deutungen
  I128SetI64(a, 0 - 1);
  I128SetU64(b, 1);
  CheckI("cmpS.negIsSmaller"c, I128CmpS(a, b), 0 - 1);
  CheckI("cmpU.negIsBigger"c, I128CmpU(a, b), 1);

  // ── Teilen ─────────────────────────────────────────────────────────────────
  I128SetU64(a, 100);
  I128SetU64(b, 7);
  CheckB("div.ok"c, I128DivRemU(a, b, q, r), true);
  CheckVal("div.q"c, q, 0, 14);
  CheckVal("div.r"c, r, 0, 2);

  I128SetU64(b, 0);
  CheckB("div.byZero"c, I128DivRemU(a, b, q, r), false);

  I128SetU64(a, 42);
  I128SetU64(b, 100);
  I128DivRemU(a, b, q, r);
  CheckVal("div.smallerNum"c, q, 0, 0);
  CheckVal("div.remIsNum"c, r, 0, 42);

  // 2^64 / 2 = 2^63
  I128Set(a, 1, 0);
  I128SetU64(b, 2);
  I128DivRemU(a, b, q, r);
  CheckVal("div.2p64by2"c, q, 0, MIN);
  CheckVal("div.2p64by2rem"c, r, 0, 0);

  // (2^128-1) / (2^64-1) = 2^64 + 1
  I128Set(a, MONE, MONE);
  I128SetU64(b, MONE);
  I128DivRemU(a, b, q, r);
  CheckVal("div.maxByOnes"c, q, 1, 1);
  CheckVal("div.maxByOnesRem"c, r, 0, 0);

  // Division durch ein 64-Bit-Wort
  var rem: int64 := alloc(8);
  I128Set(a, 1, 0);
  CheckB("divU64.ok"c, I128DivRemU64(a, 10, q, rem), true);
  // 2^64 = 18446744073709551616, /10 = 1844674407370955161 Rest 6
  CheckVal("divU64.q"c, q, 0, 1844674407370955161);
  CheckI("divU64.rem"c, peek64(rem), 6);
  CheckB("divU64.byZero"c, I128DivRemU64(a, 0, q, rem), false);

  // Vorzeichenbehaftet: Richtung null, Rest traegt das Vorzeichen des Zaehlers
  I128SetI64(a, 0 - 7);
  I128SetI64(b, 2);
  CheckB("divS.ok"c, I128DivRemS(a, b, q, r), true);
  CheckB("divS.qNeg"c, I128IsNeg(q), true);
  I128Neg(q, c);
  CheckVal("divS.q"c, c, 0, 3);
  CheckB("divS.rNeg"c, I128IsNeg(r), true);
  I128Neg(r, c);
  CheckVal("divS.r"c, c, 0, 1);

  I128SetI64(a, 7);
  I128SetI64(b, 0 - 2);
  I128DivRemS(a, b, q, r);
  CheckB("divS.negDivisor"c, I128IsNeg(q), true);
  CheckB("divS.remPositive"c, I128IsNeg(r), false);

  // ── Multiplizieren auf 128 Bit ─────────────────────────────────────────────
  I128Set(a, 0, MONE);
  I128SetU64(b, 2);
  I128Mul(a, b, c);
  CheckVal("mul128.doubling"c, c, 1, 0 - 2);
  I128MulU64(a, 2, c);
  CheckVal("mulU64.doubling"c, c, 1, 0 - 2);

  // ── Dezimalausgabe ─────────────────────────────────────────────────────────
  I128Zero(a);
  I128ToDecimalU(a, buf, 64);
  CheckStr("dec.zero"c, buf, "0"c);
  I128SetU64(a, 42);
  I128ToDecimalU(a, buf, 64);
  CheckStr("dec.42"c, buf, "42"c);
  I128SetU64(a, MONE);
  I128ToDecimalU(a, buf, 64);
  CheckStr("dec.u64max"c, buf, "18446744073709551615"c);
  I128Set(a, 1, 0);
  I128ToDecimalU(a, buf, 64);
  CheckStr("dec.2p64"c, buf, "18446744073709551616"c);
  // 2^128 - 1, die groesste darstellbare Zahl: 39 Stellen
  I128Set(a, MONE, MONE);
  CheckI("dec.maxLen"c, I128ToDecimalU(a, buf, 64), 39);
  CheckStr("dec.max"c, buf, "340282366920938463463374607431768211455"c);
  // 2^127
  I128Set(a, MIN, 0);
  I128ToDecimalU(a, buf, 64);
  CheckStr("dec.2p127"c, buf, "170141183460469231731687303715884105728"c);

  // Vorzeichenbehaftet
  I128SetI64(a, 0 - 42);
  I128ToDecimalS(a, buf, 64);
  CheckStr("decS.neg"c, buf, "-42"c);
  I128SetI64(a, 42);
  I128ToDecimalS(a, buf, 64);
  CheckStr("decS.pos"c, buf, "42"c);
  // kleinster vorzeichenbehafteter Wert: -2^127
  I128Set(a, MIN, 0);
  I128ToDecimalS(a, buf, 64);
  CheckStr("decS.min"c, buf, "-170141183460469231731687303715884105728"c);
  // groesster: 2^127 - 1
  I128Set(a, MAX, MONE);
  I128ToDecimalS(a, buf, 64);
  CheckStr("decS.max"c, buf, "170141183460469231731687303715884105727"c);

  CheckI("dec.bufTooSmall"c, I128ToDecimalU(a, buf, 3), 0 - 1);

  // ── Dezimal einlesen ───────────────────────────────────────────────────────
  CheckB("parse.ok"c, I128FromDecimal("42"c, a), true);
  CheckVal("parse.42"c, a, 0, 42);
  CheckB("parse.zero"c, I128FromDecimal("0"c, a), true);
  CheckVal("parse.0"c, a, 0, 0);
  CheckB("parse.u64max"c, I128FromDecimal("18446744073709551615"c, a), true);
  CheckVal("parse.u64maxVal"c, a, 0, MONE);
  CheckB("parse.2p64"c, I128FromDecimal("18446744073709551616"c, a), true);
  CheckVal("parse.2p64Val"c, a, 1, 0);
  CheckB("parse.max"c, I128FromDecimal("340282366920938463463374607431768211455"c, a), true);
  CheckVal("parse.maxVal"c, a, MONE, MONE);
  CheckB("parse.neg"c, I128FromDecimal("-42"c, a), true);
  CheckB("parse.negIsNeg"c, I128IsNeg(a), true);
  CheckB("parse.plus"c, I128FromDecimal("+42"c, a), true);
  CheckVal("parse.plusVal"c, a, 0, 42);

  CheckB("parse.empty"c, I128FromDecimal(""c, a), false);
  CheckB("parse.letters"c, I128FromDecimal("12x4"c, a), false);
  CheckB("parse.null"c, I128FromDecimal(0, a), false);
  CheckB("parse.onlySign"c, I128FromDecimal("-"c, a), false);
  // ueber 2^128 hinaus muss abgelehnt werden
  CheckB("parse.tooBig"c, I128FromDecimal("340282366920938463463374607431768211456"c, a), false);
  CheckB("parse.wayTooBig"c, I128FromDecimal("99999999999999999999999999999999999999999"c, a), false);

  // Einlesen und Ausgeben sind zueinander invers
  var badRound: int64 := 0;
  var t: int64 := 0;
  while (t < 300) {
    I128Set(a, Rnd(), Rnd());
    if (t % 3 == 0) { I128Set(a, 0, Rnd()); }
    if (t % 5 == 0) { I128Set(a, 0, BitsShr(Rnd(), 40)); }
    I128ToDecimalU(a, buf, 64);
    if (!I128FromDecimal(buf, b)) { badRound := badRound + 1; }
    else {
      if (!I128Equals(a, b)) { badRound := badRound + 1; }
    }
    t := t + 1;
  }
  CheckI("decRoundTrip"c, badRound, 0);

  // ── Die tragenden Identitaeten ─────────────────────────────────────────────
  //
  // Fuer Zufallspaare: das volle Produkt geteilt durch einen Faktor muss den
  // anderen ergeben, und Division mit Rest muss sich rueckwaerts zusammensetzen
  // lassen. Beides braucht keine fremde Zahl und trifft jeden Uebertragsfehler.
  var badMul: int64 := 0;
  var badDiv: int64 := 0;
  var badOvf: int64 := 0;
  var prod: int64 := alloc(16);
  var back: int64 := alloc(16);
  var chk: int64 := alloc(16);

  t := 0;
  while (t < 500) {
    var x: int64 := Rnd();
    var y: int64 := Rnd();
    if (t % 4 == 1) { x := BitsShr(x, 32); }
    if (t % 4 == 2) { y := BitsShr(y, 48); }
    if (t % 4 == 3) { x := BitsShr(x, 60); y := BitsShr(y, 60); }

    // (x*y)/y = x, wenn y nicht null
    I128Mul64U(x, y, prod);
    if (y != 0) {
      I128SetU64(b, y);
      I128DivRemU(prod, b, back, r);
      I128SetU64(chk, x);
      if (!I128Equals(back, chk)) { badMul := badMul + 1; }
      if (!I128IsZero(r)) { badMul := badMul + 1; }
    }

    // MulHi ist genau dann null, wenn das Produkt in 64 Bit passt
    var fits: bool := I128FitsU64(prod);
    var hiZero: bool := I128MulHiU(x, y) == 0;
    if (fits != hiZero) { badOvf := badOvf + 1; }

    // Division mit Rest: q*d + r = a, und r < d
    var d: int64 := Rnd();
    if (d == 0) { d := 7; }
    I128Set(a, Rnd(), Rnd());
    I128SetU64(b, d);
    I128DivRemU(a, b, q, r);
    I128Mul(q, b, back);
    I128Add(back, r, back);
    if (!I128Equals(back, a)) { badDiv := badDiv + 1; }
    if (I128CmpU(r, b) >= 0) { badDiv := badDiv + 1; }

    t := t + 1;
  }
  CheckI("mulDivInverse"c, badMul, 0);
  CheckI("divRemReassembles"c, badDiv, 0);
  CheckI("mulHiMatchesOverflow"c, badOvf, 0);

  // ── Wofuer man das braucht ─────────────────────────────────────────────────
  //
  // (a*b)/c, wenn a*b nicht in 64 Bit passt, das Ergebnis aber schon.
  var ok: int64 := alloc(8);
  // 2^62 * 6 / 3 = 2^63, das Zwischenprodukt sprengt 64 Bit
  var big: int64 := BitsShl(1, 62);
  CheckI("mulDiv.exact"c, I128MulDivU(big, 6, 3, ok), MIN);
  CheckI("mulDiv.ok"c, peek64(ok), 1);
  // Gegenprobe: der naive Weg liefert etwas anderes
  CheckB("mulDiv.naiveDiffers"c, (big * 6) / 3 == MIN, false);

  CheckI("mulDiv.byZero"c, I128MulDivU(10, 10, 0, ok), 0 - 1);
  CheckI("mulDiv.zeroFlag"c, peek64(ok), 0);
  // Ergebnis passt nicht in 64 Bit
  I128MulDivU(MONE, MONE, 1, ok);
  CheckI("mulDiv.tooBig"c, peek64(ok), 0);
  CheckI("mulDiv.simple"c, I128MulDivU(100, 3, 4, ok), 75);

  // Exakter Mittelwert, auch wenn a+b ueberlaeuft
  CheckI("avg.simple"c, I128AvgU(10, 20), 15);
  CheckI("avg.odd"c, I128AvgU(10, 21), 15);
  CheckI("avg.noOverflow"c, I128AvgU(MONE, MONE), MONE);
  CheckI("avg.max"c, I128AvgU(MAX, MAX), MAX);
  // Gegenprobe: die naive Fassung kippt um. Bei MAX+MAX laeuft die Summe auf
  // -2 ueber, der "Mittelwert" waere -1 statt MAX.
  var naiveAvg: int64 := (MAX + MAX) / 2;
  CheckI("avg.naiveWraps"c, naiveAvg, MONE);
  CheckB("avg.naiveDiffers"c, naiveAvg == I128AvgU(MAX, MAX), false);

  var badAvg: int64 := 0;
  t := 0;
  while (t < 300) {
    var x2: int64 := Rnd();
    var y2: int64 := Rnd();
    // exakt nachgerechnet ueber 128 Bit
    I128SetU64(a, x2);
    I128SetU64(b, y2);
    I128Add(a, b, c);
    I128SetU64(b, 2);
    I128DivRemU(c, b, q, r);
    if (peek64(q) != I128AvgU(x2, y2)) { badAvg := badAvg + 1; }
    t := t + 1;
  }
  CheckI("avgMatches128"c, badAvg, 0);

  // ── Negativkontrollen ──────────────────────────────────────────────────────
  //
  // Erstens: die Identitaetspruefung muss anschlagen, wenn das Produkt verbogen
  // wird.
  I128Mul64U(123456789, 987654321, prod);
  I128SetU64(b, 987654321);
  I128DivRemU(prod, b, back, r);
  I128SetU64(chk, 123456789);
  CheckB("negCtrl.holds"c, I128Equals(back, chk), true);
  // Um den Quotienten zu aendern, muss mindestens der Teiler dazukommen —
  // ein einzelner Zaehlerschritt landet nur im Rest.
  I128SetU64(c, 987654321);
  I128Add(prod, c, prod);
  I128DivRemU(prod, b, back, r);
  CheckB("negCtrl.catches"c, I128Equals(back, chk), false);
  // und der Rest allein aendert den Quotienten eben NICHT
  I128Sub(prod, c, prod);
  I128SetU64(c, 1);
  I128Add(prod, c, prod);
  I128DivRemU(prod, b, back, r);
  CheckB("negCtrl.remainderOnly"c, I128Equals(back, chk), true);
  CheckVal("negCtrl.remIsOne"c, r, 0, 1);

  // Zweitens: eine naive MulHi-Fassung ohne den Uebertrag aus der mittleren
  // Spalte. Sie muss bei passenden Zahlen ein ANDERES Ergebnis liefern —
  // sonst pruefte der Test den Uebertrag gar nicht.
  var x3: int64 := 0xDEADBEEFCAFEBABE;
  var y3: int64 := 0x1234567890ABCDEF;
  var a0: int64 := x3 & 0xFFFFFFFF;
  var a1: int64 := BitsShr(x3, 32);
  var b0: int64 := y3 & 0xFFFFFFFF;
  var b1: int64 := BitsShr(y3, 32);
  var naiveHi: int64 := a1 * b1 + BitsShr(a0 * b1, 32) + BitsShr(a1 * b0, 32);
  CheckB("negCtrl.naiveMulHiDiffers"c, naiveHi == I128MulHiU(x3, y3), false);

  free(a, 16);  free(b, 16);  free(c, 16);  free(q, 16);  free(r, 16);
  free(prod, 16);  free(back, 16);  free(chk, 16);
  free(buf, 64);  free(cout, 8);  free(rem, 8);  free(ok, 8);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
