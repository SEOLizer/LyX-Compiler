// tests/cf_demo5_waf_analytics.lyx — Demo 5: WAF + Rate Limiting + Analytics
// WP-CF-16

unit tests.cf_demo5_waf_analytics;

import std.cloud.cf.credentials;
import std.cloud.cf.transport;
import std.cloud.cf.zones;
import std.cloud.cf.waf;
import std.cloud.cf.analytics;
import std.io;
import std.alloc;

pub fn main(argc: int64, argv: int64): int64 {
    var creds: CFCredentials := CFCredentialsFromEnv();
    var c: CFClient;
    c.authType:=creds.authType; c.token:=creds.token; c.apiKey:=creds.apiKey;
    c.email:=creds.email; c.accountId:=creds.accountId; c.zoneId:=creds.zoneId;
    c.timeout:=30000; c.maxRetries:=3;

    if (c.authType == 0) {
        PrintLn("Error: set CF_AUTH_TOKEN and CF_ZONE_ID"c); return 1;
    }

    PrintLn("=== CF Demo 5: WAF + Rate Limiting + Analytics ==="c);

    var domain: pchar := "example.com"c;
    Print("Finding zone for "c); PrintLn(domain);
    var zone: CFZone := ZoneGetByDomain(c, domain);
    if (zone.id == 0) { PrintLn("Zone not found"c); return 1; }
    var zoneId: pchar := zone.id as pchar;
    Print("Zone: "c); PrintLn(zoneId);

    // Block threat countries
    Print("Blocking high-threat countries (CN, RU, KP)..."c);
    var countries: int64 := alloc(24);
    poke64(countries,    "CN"c as int64);
    poke64(countries+8,  "RU"c as int64);
    poke64(countries+16, "KP"c as int64);
    var geoOk: int64 := FirewallBlockCountry(c, zoneId, countries, 3, "Geo-Block Demo"c);
    free(countries, 24);
    if (geoOk == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }

    // Rate limit API endpoint: 100 req/60s → ban 1h
    Print("Creating rate limit on /api/*..."c);
    var rl: CFRateLimit := RateLimitCreate(c, zoneId,
        "*/api/*"c, 100, 60, "ban"c, 3600);
    if (rl.id != 0) {
        Print(" OK (id="c); Print(rl.id as pchar); PrintLn(")"c);
    } else { PrintLn(" FAILED"c); }
    CFRateLimitFree(rl);

    // Set security level to high
    Print("Setting security level to 'high'..."c);
    var slOk: int64 := ZoneSetSecurityLevel(c, zoneId, "high"c);
    if (slOk == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }

    // Enable bot fight mode
    Print("Enabling bot fight mode..."c);
    var bfOk: int64 := ZoneSetBotFightMode(c, zoneId, 1);
    if (bfOk == 1) { PrintLn(" OK"c); } else { PrintLn(" FAILED"c); }

    // Pull analytics dashboard
    PrintLn(""c);
    Print("Fetching analytics dashboard (last 24h)..."c);
    var stats: int64 := AnalyticsDashboard(c, zoneId, "-1440"c, 0 as pchar);
    if (stats != 0) {
        PrintLn(" OK"c);
        var sl2: int64 := StrLen(stats as pchar);
        // Extract key metrics
        var requests: int64 := cfExtractInt(stats, sl2, "requests"c);
        var threats:  int64 := cfExtractInt(stats, sl2, "threats"c);
        Print("  Requests (24h): "c);
        var rbuf: int64 := alloc(24); var rstr: int64 := Int64ToStr(requests, rbuf);
        PrintLn(rbuf as pchar); free(rbuf, 24);
        Print("  Threats:        "c);
        var tbuf: int64 := alloc(24); var tstr: int64 := Int64ToStr(threats, tbuf);
        PrintLn(tbuf as pchar); free(tbuf, 24);
        free(stats, sl2+1);
    } else { PrintLn(" FAILED"c); }

    // Top 10 IPs
    Print("Fetching top 10 IPs..."c);
    var topIPs: int64 := AnalyticsTop10IPs(c, zoneId, 0 as pchar);
    if (topIPs != 0) { PrintLn(" OK"c); free(topIPs, StrLen(topIPs as pchar)+1); }
    else { PrintLn(" FAILED (GraphQL may need different perms)"c); }

    // Firewall events
    Print("Fetching firewall events..."c);
    var fw: int64 := AnalyticsFirewallEvents(c, zoneId, 0 as pchar, 10);
    if (fw != 0) {
        PrintLn(" OK"c);
        free(fw, StrLen(fw as pchar)+1);
    } else { PrintLn(" FAILED"c); }

    CFZoneFree(zone);
    PrintLn("Done."c);
    return 0;
}
