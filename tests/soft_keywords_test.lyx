// tests/soft_keywords_test.lyx
// WP-1.1-A: Soft-Keyword-Infrastruktur
// Tests: _isSoftKw helper, range-based for, wraps annotation

@description("WP-1.1-A: soft-keyword infrastructure tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.soft_keywords_test;

// --- 1. 'defer' als Bezeichner (kein Konflikt) ---
fn testDeferAsIdent(): int64 {
  var defer: int64 := 42;
  if (defer != 42) { PrintStr("FAIL: defer as ident\n"); return 1; }
  PrintStr("OK: defer as identifier\n");
  return 0;
}

// --- 2. for i in range(n) — range(n) iteriert 0..n-1 ---
fn testRangeN(): int64 {
  var sum: int64 := 0;
  for i in range(5) {
    sum := sum + i;
  }
  // 0+1+2+3+4 = 10
  if (sum != 10) {
    PrintStr("FAIL: range(5) sum expected 10, got ");
    PrintInt(sum);
    PrintStr("\n");
    return 1;
  }
  PrintStr("OK: for i in range(5)\n");
  return 0;
}

// --- 3. for i in range(start, stop) — expliziter Start ---
fn testRangeStartStop(): int64 {
  var sum: int64 := 0;
  for i in range(3, 7) {
    sum := sum + i;
  }
  // 3+4+5+6 = 18
  if (sum != 18) {
    PrintStr("FAIL: range(3,7) sum expected 18, got ");
    PrintInt(sum);
    PrintStr("\n");
    return 1;
  }
  PrintStr("OK: for i in range(3, 7)\n");
  return 0;
}

// --- 4. range(0) → no iterations ---
fn testRangeZero(): int64 {
  var count: int64 := 0;
  for i in range(0) {
    count := count + 1;
  }
  if (count != 0) {
    PrintStr("FAIL: range(0) should iterate 0 times\n");
    return 1;
  }
  PrintStr("OK: for i in range(0) — no iterations\n");
  return 0;
}

// --- 5. break inside range loop ---
fn testRangeBreak(): int64 {
  var last: int64 := -1;
  for i in range(10) {
    if (i == 5) { break; }
    last := i;
  }
  if (last != 4) {
    PrintStr("FAIL: range break expected last=4, got ");
    PrintInt(last);
    PrintStr("\n");
    return 1;
  }
  PrintStr("OK: break in range loop\n");
  return 0;
}

// --- 6. wraps annotation — parsed without error, flag accessible ---
fn testWrapsAnnotation(): int64 {
  var x: int64 wraps := 255;
  // Semantics: wraps just sets a flag; actual overflow behavior is future WP.
  // Test that the variable works normally for now.
  x := x + 1;
  if (x != 256) {
    PrintStr("FAIL: wraps var arithmetic\n");
    return 1;
  }
  PrintStr("OK: wraps annotation parsed\n");
  return 0;
}

// --- 7. 'range' as a function name (no conflict) ---
fn range(n: int64): int64 {
  return n * 2;
}

fn testRangeAsFuncName(): int64 {
  var r: int64 := range(5);
  if (r != 10) {
    PrintStr("FAIL: range() as function name\n");
    return 1;
  }
  PrintStr("OK: range as function name (no conflict)\n");
  return 0;
}

pub fn main(): int64 {
  if (testDeferAsIdent()      != 0) { return 1; }
  if (testRangeN()            != 0) { return 1; }
  if (testRangeStartStop()    != 0) { return 1; }
  if (testRangeZero()         != 0) { return 1; }
  if (testRangeBreak()        != 0) { return 1; }
  if (testWrapsAnnotation()   != 0) { return 1; }
  if (testRangeAsFuncName()   != 0) { return 1; }
  PrintStr("All WP-1.1-A soft-keyword tests passed.\n");
  return 0;
}
