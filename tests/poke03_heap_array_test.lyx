// WP-POKE-03: Heap-dynamisches Array<T> — Akzeptanztest
// Testet: push, pop, len, cap, Wachstum über Kapazitätsgrenzen

fn main(): int64 {

    // --- Test 1: push/pop basic ---
    var arr: Array<int64>;
    push(arr, 42);
    push(arr, 99);
    var v: int64 := pop(arr);
    if (v != 99) {
        PrintLn("FAIL T1: pop returned wrong value");
        return 1;
    }
    PrintLn("T1 OK: push/pop basic");

    // --- Test 2: len nach push ---
    var arr2: Array<int64>;
    push(arr2, 10);
    push(arr2, 20);
    push(arr2, 30);
    if (len(arr2) != 3) {
        PrintLn("FAIL T2: len wrong");
        return 1;
    }
    PrintLn("T2 OK: len(arr) == 3");

    // --- Test 3: pop verringert len ---
    pop(arr2);
    if (len(arr2) != 2) {
        PrintLn("FAIL T3: len nach pop wrong");
        return 1;
    }
    PrintLn("T3 OK: len(arr) == 2 nach pop");

    // --- Test 4: cap initialer Wert ---
    var arr3: Array<int64>;
    push(arr3, 1);
    if (cap(arr3) < 1) {
        PrintLn("FAIL T4: cap < 1 nach erstem push");
        return 1;
    }
    PrintLn("T4 OK: cap >= 1 nach erstem push");

    // --- Test 5: Wachstum über initiale Kapazität (1024 Elemente) ---
    var big: Array<int64>;
    var i: int64 := 0;
    while (i < 1030) {
        push(big, i);
        i := i + 1;
    }
    if (len(big) != 1030) {
        PrintLn("FAIL T5: len != 1030 nach Wachstum");
        return 1;
    }
    // Letztes Element prüfen
    var last: int64 := pop(big);
    if (last != 1029) {
        PrintLn("FAIL T5: letztes Element falsch nach Wachstum");
        return 1;
    }
    PrintLn("T5 OK: Wachstum über 1024 Elemente");

    // --- Test 6: Werte bleiben nach Wachstum korrekt ---
    var vals: Array<int64>;
    var j: int64 := 0;
    while (j < 1030) {
        push(vals, j * 2);
        j := j + 1;
    }
    // Element 512 (nach dem Wachstum) prüfen — durch pop aller Elemente
    var k: int64 := 1029;
    while (k >= 0) {
        var got: int64 := pop(vals);
        if (got != k * 2) {
            PrintLn("FAIL T6: falscher Wert nach Wachstum");
            return 1;
        }
        k := k - 1;
    }
    PrintLn("T6 OK: Werte korrekt nach Wachstum");

    PrintLn("Alle Tests bestanden.");
    return 0;
}
