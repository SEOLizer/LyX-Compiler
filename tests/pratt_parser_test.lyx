// tests/pratt_parser_test.lyx
// WP-1.2: Pratt Expression Parser
//
// Tests: binding-power precedence, left/right associativity,
//        const-expr restriction, existing operators unaffected.

@description("WP-1.2: Pratt expression parser tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pratt_parser_test;

// --- 1. Basic precedence: 1 + 2 * 3 = 7 ---
fn testMulBeforeAdd(): int64 {
  var r: int64 := 1 + 2 * 3;
  if (r != 7) { Print("FAIL: 1+2*3 expected 7, got "); PrintInt(r); Print("\n"); return 1; }
  Print("OK: 1+2*3=7\n");
  return 0;
}

// --- 2. Left-associativity of +: (1+2)+3 = 6 ---
fn testAddLeftAssoc(): int64 {
  var r: int64 := 1 + 2 + 3;
  if (r != 6) { Print("FAIL: 1+2+3 expected 6\n"); return 1; }
  Print("OK: + left-assoc\n");
  return 0;
}

// --- 3. Subtraction left-assoc: 10-3-2 = 5 (not 10-(3-2)=9) ---
fn testSubLeftAssoc(): int64 {
  var r: int64 := 10 - 3 - 2;
  if (r != 5) { Print("FAIL: 10-3-2 expected 5, got "); PrintInt(r); Print("\n"); return 1; }
  Print("OK: - left-assoc\n");
  return 0;
}

// --- 4. Comparison + logical: (2>1) && (3>2) ---
fn testCmpAndLogic(): int64 {
  var r: int64 := 0;
  if (2 > 1 && 3 > 2) { r := 1; }
  if (r != 1) { Print("FAIL: 2>1 && 3>2\n"); return 1; }
  Print("OK: comparison + &&\n");
  return 0;
}

// --- 5. || binds looser than && ---
fn testOrAndPrecedence(): int64 {
  // 0 || 1 && 0 = 0 || (1 && 0) = 0 || 0 = 0
  var r: int64 := 0;
  if (0 == 1 || 1 == 1 && 0 == 1) { r := 1; }  // should NOT enter
  if (r != 0) { Print("FAIL: || vs &&\n"); return 1; }
  Print("OK: || vs && precedence\n");
  return 0;
}

// --- 6. Bitwise ops: & ^ | ---
fn testBitwiseOps(): int64 {
  var a: int64 := 0b1100;   // 12
  var b: int64 := 0b1010;   // 10
  var r1: int64 := a & b;   // 0b1000 = 8
  var r2: int64 := a | b;   // 0b1110 = 14
  var r3: int64 := a ^ b;   // 0b0110 = 6
  if (r1 != 8 || r2 != 14 || r3 != 6) {
    Print("FAIL: bitwise ops\n"); return 1;
  }
  Print("OK: & | ^ bitwise\n");
  return 0;
}

// --- 7. Shift ops ---
fn testShift(): int64 {
  var r: int64 := 1 << 3;    // 8
  var s: int64 := 16 >> 2;   // 4
  if (r != 8 || s != 4) { Print("FAIL: << >>\n"); return 1; }
  Print("OK: << >> shift\n");
  return 0;
}

// --- 8. == != ---
fn testEqNeq(): int64 {
  if (5 == 5 && 3 != 4) {
    Print("OK: == !=\n");
    return 0;
  }
  Print("FAIL: == !=\n");
  return 1;
}

// --- 9. ?? null-coalescence: right-associative ---
fn testNullCoalRightAssoc(): int64 {
  // a ?? b ?? c should be a ?? (b ?? c)
  // If a is non-null: result = a, regardless of b,c
  var a: pchar := "hello"c;
  var b: pchar := "world"c;
  var c: pchar := "!"c;
  var r: pchar := a ?? b ?? c;
  // r should be "hello" since a is non-null
  if (r != a) { Print("FAIL: ?? should return first non-null\n"); return 1; }
  Print("OK: ?? right-assoc, first non-null\n");
  return 0;
}

// --- 10. |> pipe-forward ---
fn triple(n: int64): int64 { return n * 3; }
fn minus10(n: int64): int64 { return n - 10; }

fn testPipeForward(): int64 {
  // 5 |> triple |> minus10 = minus10(triple(5)) = minus10(15) = 5
  var r: int64 := 5 |> triple |> minus10;
  if (r != 5) { Print("FAIL: |> pipe, got "); PrintInt(r); Print("\n"); return 1; }
  Print("OK: |> pipe-forward\n");
  return 0;
}

// --- 11. Unary minus and not ---
fn testUnaryOps(): int64 {
  var x: int64 := -5;
  if (x != -5) { Print("FAIL: unary minus\n"); return 1; }
  var b: int64 := 0;
  if (!b != 0) {  // !0 is non-zero (true)
    Print("OK: unary - and !\n");
    return 0;
  }
  Print("FAIL: unary !\n");
  return 1;
}

// --- 12. Complex mixed expression ---
fn testComplex(): int64 {
  // 2 + 3 * 4 - 1 == 13: (2 + (3*4)) - 1 = 14-1 = 13
  var r: int64 := 2 + 3 * 4 - 1;
  if (r != 13) { Print("FAIL: complex expr expected 13, got "); PrintInt(r); Print("\n"); return 1; }
  Print("OK: 2+3*4-1=13\n");
  return 0;
}

pub fn main(): int64 {
  if (testMulBeforeAdd()       != 0) { return 1; }
  if (testAddLeftAssoc()       != 0) { return 1; }
  if (testSubLeftAssoc()       != 0) { return 1; }
  if (testCmpAndLogic()        != 0) { return 1; }
  if (testOrAndPrecedence()    != 0) { return 1; }
  if (testBitwiseOps()         != 0) { return 1; }
  if (testShift()              != 0) { return 1; }
  if (testEqNeq()              != 0) { return 1; }
  if (testNullCoalRightAssoc() != 0) { return 1; }
  if (testPipeForward()        != 0) { return 1; }
  if (testUnaryOps()           != 0) { return 1; }
  if (testComplex()            != 0) { return 1; }
  Print("All WP-1.2 Pratt parser tests passed.\n");
  return 0;
}
