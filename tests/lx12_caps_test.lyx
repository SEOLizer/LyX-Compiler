// LX-12 Test: Capabilities + Pledge + Unveil (0x0700–0x0708) kompilieren prüfen.

import src.std.lyxos.caps;

fn main(): int64 {
    // sys_cap_create / sys_cap_restrict / sys_cap_rights
    var cfd: int64 := sys_cap_create(0, RIGHT_READ);
    var rfd: int64 := sys_cap_restrict(cfd, RIGHT_READ);
    var rts: int64 := sys_cap_rights(rfd);

    // sys_pledge: stdio + rpath erlauben
    sys_pledge("stdio rpath"c, ""c);

    // sys_unveil: /tmp lesbar machen, dann sperren
    sys_unveil("/tmp"c, "r"c);
    sys_unveil(""c, ""c);

    // sys_uid_get / sys_gid_get
    var uid: int64 := sys_uid_get();
    var gid: int64 := sys_gid_get();

    // sys_setuid: nur kompilieren (braucht Admin-Cap)
    sys_setuid(uid);

    // sys_seccomp: nur kompilieren (STRICT würde uns sperren)
    sys_seccomp(SECCOMP_FILTER, 0 as pchar);

    return uid;
}
