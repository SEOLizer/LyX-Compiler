// tests/pdf_pdfa_test.lyx
// WP-PDF-27: PDF/A-1b conformance

@description("WP-PDF-27: PDF/A conformance test")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.pdf_pdfa_test;

import std.pdf;

fn testPdfA1b(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew\n"); return 1; }

  PdfSetTitle(doc, "PDF/A-1b Test Document");
  PdfSetAuthor(doc, "Andreas Roene");
  PdfSetCreator(doc, "Lyx std.pdf library");
  PdfSetProducer(doc, "aurum/lyxc 2026");

  // Enable PDF/A-1b — must be called before PdfGenerateXMP
  PdfSetConformance(doc, PDF_CONFORMANCE_A1B);

  // XMP with pdfaid namespace (required for PDF/A)
  PdfGenerateXMP(doc);

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 14.0);
  PdfTextAt(doc, page, 72.0, 750.0, "PDF/A-1b Test Document");
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 11.0);
  PdfTextAt(doc, page, 72.0, 725.0, "This file should be PDF/A-1b compliant.");
  PdfTextAt(doc, page, 72.0, 710.0, "Verify with: veraPDF out.pdf");

  var err: int64 := PdfSave(doc, "/tmp/pdf_pdfa_a1b.pdf");
  PdfFree(doc);
  if (err != 0) {
    PrintStr("FAIL: PdfSave returned ");
    PrintInt(err);
    PrintStr("\n");
    return 1;
  }
  PrintStr("OK: PDF/A-1b saved to /tmp/pdf_pdfa_a1b.pdf\n");
  return 0;
}

fn testPdfA1bNoEncryption(): int64 {
  // PDF/A must not encrypt — encryption should be silently suppressed
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew\n"); return 1; }

  PdfSetConformance(doc, PDF_CONFORMANCE_A1B);
  PdfSetEncryption(doc, PDF_ENC_RC4_128);  // should be ignored in PDF/A mode
  PdfSetUserPassword(doc, "secret");
  PdfGenerateXMP(doc);

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "PDF/A + encryption attempt (encryption suppressed)");

  var err: int64 := PdfSave(doc, "/tmp/pdf_pdfa_noenc.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (no-enc)\n"); return 1; }
  PrintStr("OK: PDF/A no-encryption test saved to /tmp/pdf_pdfa_noenc.pdf\n");
  return 0;
}

fn testPdfA2b(): int64 {
  var doc: int64 := PdfNew();
  if (doc == 0) { PrintStr("FAIL: PdfNew\n"); return 1; }

  PdfSetTitle(doc, "PDF/A-2b Test");
  PdfSetConformance(doc, PDF_CONFORMANCE_A2B);
  PdfGenerateXMP(doc);

  var page: int64 := PdfAddPage(doc, PDF_A4_W, PDF_A4_H);
  PdfSetFont(doc, page, PDF_FONT_HELVETICA, 12.0);
  PdfTextAt(doc, page, 72.0, 750.0, "PDF/A-2b test file");

  var err: int64 := PdfSave(doc, "/tmp/pdf_pdfa_a2b.pdf");
  PdfFree(doc);
  if (err != 0) { PrintStr("FAIL: PdfSave (A2b)\n"); return 1; }
  PrintStr("OK: PDF/A-2b saved to /tmp/pdf_pdfa_a2b.pdf\n");
  return 0;
}

pub fn main(): int64 {
  if (testPdfA1b()            != 0) { return 1; }
  if (testPdfA1bNoEncryption() != 0) { return 1; }
  if (testPdfA2b()            != 0) { return 1; }
  PrintStr("All WP-PDF-27 PDF/A tests passed.\n");
  return 0;
}
