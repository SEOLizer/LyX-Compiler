// tests/demo_s3_presign.lyx — S3 Demo: Presigned URL generation
// WP-S3-10

unit tests.demo_s3_presign;

import std.cloud.aws.core;
import std.cloud.s3;
import std.io;
import std.alloc;

pub fn main(argc: int64, argv: int64): int64 {
    PrintLn("=== S3 Demo: Presigned URLs ==="c);

    var creds: AWSCreds := AWSCredentialsFromEnv();
    if (creds.accessKey == 0) {
        PrintLn("Error: set AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY"c); return 1;
    }
    var region: pchar := AWSRegionFromEnv("us-east-1"c);
    var client: S3Client := S3Connect(creds, region);

    var bucket: pchar := "my-example-bucket"c;
    var key:    pchar := "documents/report.pdf"c;

    // Presign GET (1 hour)
    Print("Presigned GET (3600s):\n  "c);
    var getUrl: int64 := S3PresignGet(client, bucket, key, 3600);
    if (getUrl != 0) {
        PrintLn(getUrl as pchar);
        free(getUrl, StrLen(getUrl as pchar)+1);
    } else { PrintLn("(failed)"c); }

    // Presign PUT (15 minutes)
    Print("Presigned PUT (900s):\n  "c);
    var putUrl: int64 := S3PresignPut(client, bucket, key, 900);
    if (putUrl != 0) {
        PrintLn(putUrl as pchar);
        free(putUrl, StrLen(putUrl as pchar)+1);
    } else { PrintLn("(failed)"c); }

    // Presign DELETE (5 minutes)
    Print("Presigned DELETE (300s):\n  "c);
    var delUrl: int64 := S3PresignDelete(client, bucket, key, 300);
    if (delUrl != 0) {
        PrintLn(delUrl as pchar);
        free(delUrl, StrLen(delUrl as pchar)+1);
    } else { PrintLn("(failed)"c); }

    // Presign HEAD
    Print("Presigned HEAD (3600s):\n  "c);
    var headUrl: int64 := S3PresignHead(client, bucket, key, 3600);
    if (headUrl != 0) {
        PrintLn(headUrl as pchar);
        free(headUrl, StrLen(headUrl as pchar)+1);
    } else { PrintLn("(failed)"c); }

    // Short-lived presigned URL (60s)
    Print("Presigned GET short (60s):\n  "c);
    var shortUrl: int64 := S3PresignGet(client, bucket, "temp/scratch.bin"c, 60);
    if (shortUrl != 0) {
        PrintLn(shortUrl as pchar);
        free(shortUrl, StrLen(shortUrl as pchar)+1);
    } else { PrintLn("(failed)"c); }

    S3Close(client);
    PrintLn("Done."c);
    return 0;
}
