// tests/edi06_desadv_test.lyx — EDI-06: DESADV + RECADV tests

unit tests.edi06_desadv_test;

import std.edi.core;
import std.edi.shipping;
import std.alloc;
import std.io;

fn hasTag(buf: int64, bufLen: int64, t0: int64, t1: int64, t2: int64): int64 {
    var i: int64 := 0;
    while (i + 2 < bufLen) {
        if (peek8(buf+i) == t0 && peek8(buf+i+1) == t1 && peek8(buf+i+2) == t2) {
            return 1;
        }
        i := i + 1;
    }
    return 0;
}

fn memEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
        if (peek8(a+i) != peek8(b+i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

pub fn main(argc: int64, argv: pchar): int64 {
    var ok: int64 := 1;

    // -------------------------------------------------------------------------
    // Tests 1-2: EdiSsccCheck — valid and invalid SSCC-18
    // -------------------------------------------------------------------------
    // "340000000000000007": base17="34000000000000000", check=7
    // Verify: i=0:3×3=9, i=1:4×1=4, rest 0, i=17:7×1=7 → sum=20 → 20%10=0
    var ssccValid: int64 := "340000000000000007"c as int64;
    if (EdiSsccCheck(ssccValid, 18) != 1) {
        PrintLn("FAIL: EdiSsccCheck valid SSCC should return 1"c); ok := 0;
    } else { PrintLn("PASS: EdiSsccCheck valid SSCC returns 1"c); }

    var ssccBad: int64 := "340000000000000001"c as int64;
    if (EdiSsccCheck(ssccBad, 18) != 0) {
        PrintLn("FAIL: EdiSsccCheck invalid SSCC should return 0"c); ok := 0;
    } else { PrintLn("PASS: EdiSsccCheck invalid SSCC returns 0"c); }

    // -------------------------------------------------------------------------
    // Test 3: EdiSsccCheck — wrong length
    // -------------------------------------------------------------------------
    if (EdiSsccCheck(ssccValid, 17) != 0) {
        PrintLn("FAIL: EdiSsccCheck len!=18 should return 0"c); ok := 0;
    } else { PrintLn("PASS: EdiSsccCheck len=17 returns 0"c); }

    // -------------------------------------------------------------------------
    // Test 4: EdiSsccGenerate — produces valid SSCC
    // -------------------------------------------------------------------------
    var base17: int64 := "34000000000000001"c as int64;
    var generatedSscc: int64 := alloc(20);
    var gi: int64 := 0;
    while (gi < 20) { poke8(generatedSscc + gi, 0); gi := gi + 1; }
    EdiSsccGenerate(base17, generatedSscc);
    if (EdiSsccCheck(generatedSscc, 18) != 1) {
        PrintLn("FAIL: EdiSsccGenerate result fails EdiSsccCheck"c); ok := 0;
    } else { PrintLn("PASS: EdiSsccGenerate produces valid SSCC"c); }
    // expected "340000000000000014"
    if (memEq(generatedSscc, 18, "340000000000000014"c as int64, 18) != 1) {
        PrintLn("FAIL: EdiSsccGenerate wrong value"c); ok := 0;
    } else { PrintLn("PASS: EdiSsccGenerate = 340000000000000014"c); }

    // -------------------------------------------------------------------------
    // Tests 6-9: DESADV write — 3-level hierarchy (pallet → carton → item)
    // -------------------------------------------------------------------------
    var buf1: int64 := alloc(4096);
    var zi: int64 := 0;
    while (zi < 4096) { poke8(buf1 + zi, 0); zi := zi + 1; }

    var pkgs: int64 := alloc(3 * EDI_PACKAGE_SIZE);
    zi := 0;
    while (zi < 3 * EDI_PACKAGE_SIZE) { poke8(pkgs + zi, 0); zi := zi + 1; }

    // Package 0: pallet, SSCC="340000000000000007", no parent
    var pkg0: int64 := pkgs + 0 * EDI_PACKAGE_SIZE;
    poke64(pkg0 + EDI_PACKAGE_SSCC,    ssccValid);
    poke64(pkg0 + EDI_PACKAGE_SSCCLEN, 18);
    poke64(pkg0 + EDI_PACKAGE_TYPE,    EDI_PKG_PALLET);
    poke64(pkg0 + EDI_PACKAGE_PARENT,  0 - 1);

    // Package 1: carton, SSCC="340000000000000014", parent=0
    var ssccCarton: int64 := generatedSscc;
    var pkg1: int64 := pkgs + 1 * EDI_PACKAGE_SIZE;
    poke64(pkg1 + EDI_PACKAGE_SSCC,    ssccCarton);
    poke64(pkg1 + EDI_PACKAGE_SSCCLEN, 18);
    poke64(pkg1 + EDI_PACKAGE_TYPE,    EDI_PKG_CARTON);
    poke64(pkg1 + EDI_PACKAGE_PARENT,  0);

    // Package 2: item, GTIN="01234565", qty=100, parent=1
    var pkg2: int64 := pkgs + 2 * EDI_PACKAGE_SIZE;
    poke64(pkg2 + EDI_PACKAGE_GTIN,    "01234565"c as int64);
    poke64(pkg2 + EDI_PACKAGE_GTINLEN, 8);
    poke64(pkg2 + EDI_PACKAGE_QTY,     100);
    poke64(pkg2 + EDI_PACKAGE_TYPE,    EDI_PKG_ITEM);
    poke64(pkg2 + EDI_PACKAGE_PARENT,  1);

    var w1: int64 := EdiDesadvWrite("DESADV001"c as int64, "20260615"c as int64, pkgs, 3, buf1, 4096);

    if (w1 <= 0) {
        PrintLn("FAIL: EdiDesadvWrite should return > 0"c); ok := 0;
    } else { PrintLn("PASS: EdiDesadvWrite returns > 0"c); }

    // BGM = 66,71,77
    if (hasTag(buf1, w1, 66, 71, 77) != 1) {
        PrintLn("FAIL: DESADV missing BGM tag"c); ok := 0;
    } else { PrintLn("PASS: DESADV has BGM tag"c); }

    // CPS = 67,80,83
    if (hasTag(buf1, w1, 67, 80, 83) != 1) {
        PrintLn("FAIL: DESADV missing CPS tag"c); ok := 0;
    } else { PrintLn("PASS: DESADV has CPS tag"c); }

    // GIN = 71,73,78
    if (hasTag(buf1, w1, 71, 73, 78) != 1) {
        PrintLn("FAIL: DESADV missing GIN tag"c); ok := 0;
    } else { PrintLn("PASS: DESADV has GIN tag"c); }

    // -------------------------------------------------------------------------
    // Tests 10-15: DESADV round-trip (3 packages, hierarchy intact)
    // -------------------------------------------------------------------------
    var rpkgs: int64 := alloc(4 * EDI_PACKAGE_SIZE);
    zi := 0;
    while (zi < 4 * EDI_PACKAGE_SIZE) { poke8(rpkgs + zi, 0); zi := zi + 1; }

    var cnt: int64 := EdiDesadvRead(buf1, w1, rpkgs, 4);

    if (cnt != 3) {
        PrintLn("FAIL: EdiDesadvRead should return 3 packages"c); ok := 0;
    } else { PrintLn("PASS: EdiDesadvRead returns 3 packages"c); }

    // pkg[0]: pallet, no parent
    var rp0: int64 := rpkgs + 0 * EDI_PACKAGE_SIZE;
    if (peek64(rp0 + EDI_PACKAGE_TYPE) != EDI_PKG_PALLET) {
        PrintLn("FAIL: pkg[0] type should be pallet"c); ok := 0;
    } else { PrintLn("PASS: pkg[0] type=pallet"c); }

    var rp0parent: int64 := peek64(rp0 + EDI_PACKAGE_PARENT);
    if (rp0parent != (0 - 1)) {
        PrintLn("FAIL: pkg[0] parent should be -1 (none)"c); ok := 0;
    } else { PrintLn("PASS: pkg[0] parent=-1 (no parent)"c); }

    // pkg[1]: carton, parent=0
    var rp1: int64 := rpkgs + 1 * EDI_PACKAGE_SIZE;
    if (peek64(rp1 + EDI_PACKAGE_TYPE) != EDI_PKG_CARTON) {
        PrintLn("FAIL: pkg[1] type should be carton"c); ok := 0;
    } else { PrintLn("PASS: pkg[1] type=carton"c); }

    if (peek64(rp1 + EDI_PACKAGE_PARENT) != 0) {
        PrintLn("FAIL: pkg[1] parent should be 0 (pallet)"c); ok := 0;
    } else { PrintLn("PASS: pkg[1] parent=0 (pallet)"c); }

    // pkg[2]: item with GTIN and qty
    var rp2: int64 := rpkgs + 2 * EDI_PACKAGE_SIZE;
    if (peek64(rp2 + EDI_PACKAGE_TYPE) != EDI_PKG_ITEM) {
        PrintLn("FAIL: pkg[2] type should be item"c); ok := 0;
    } else { PrintLn("PASS: pkg[2] type=item"c); }

    var rp2gp: int64 := peek64(rp2 + EDI_PACKAGE_GTIN);
    var rp2gl: int64 := peek64(rp2 + EDI_PACKAGE_GTINLEN);
    if (memEq(rp2gp, rp2gl, "01234565"c as int64, 8) != 1) {
        PrintLn("FAIL: pkg[2] GTIN mismatch"c); ok := 0;
    } else { PrintLn("PASS: pkg[2] GTIN=01234565"c); }

    if (peek64(rp2 + EDI_PACKAGE_QTY) != 100) {
        PrintLn("FAIL: pkg[2] qty should be 100"c); ok := 0;
    } else { PrintLn("PASS: pkg[2] qty=100"c); }

    // rpkgs wird hier NICHT freigegeben: rp0 zeigt hinein und wird in Test 25
    // noch gelesen. Bis PR #998 war `free` wirkungslos, deshalb fiel der Zugriff
    // auf den freigegebenen Puffer nicht auf; seit `free` wirklich munmapped
    // stuerzte der Test genau dort ab (#1016). Freigabe jetzt am Ende.

    // -------------------------------------------------------------------------
    // Test 16: Duplicate SSCC → EdiDesadvRead returns -1
    // -------------------------------------------------------------------------
    var buf2: int64 := alloc(4096);
    zi := 0;
    while (zi < 4096) { poke8(buf2 + zi, 0); zi := zi + 1; }

    var dupPkgs: int64 := alloc(2 * EDI_PACKAGE_SIZE);
    zi := 0;
    while (zi < 2 * EDI_PACKAGE_SIZE) { poke8(dupPkgs + zi, 0); zi := zi + 1; }

    // Two packages with identical SSCC
    var dp0: int64 := dupPkgs + 0 * EDI_PACKAGE_SIZE;
    poke64(dp0 + EDI_PACKAGE_SSCC,    ssccValid);
    poke64(dp0 + EDI_PACKAGE_SSCCLEN, 18);
    poke64(dp0 + EDI_PACKAGE_TYPE,    EDI_PKG_PALLET);
    poke64(dp0 + EDI_PACKAGE_PARENT,  0 - 1);

    var dp1: int64 := dupPkgs + 1 * EDI_PACKAGE_SIZE;
    poke64(dp1 + EDI_PACKAGE_SSCC,    ssccValid);   // same SSCC as dp0!
    poke64(dp1 + EDI_PACKAGE_SSCCLEN, 18);
    poke64(dp1 + EDI_PACKAGE_TYPE,    EDI_PKG_CARTON);
    poke64(dp1 + EDI_PACKAGE_PARENT,  0);

    var wDup: int64 := EdiDesadvWrite("DUP001"c as int64, "20260615"c as int64, dupPkgs, 2, buf2, 4096);

    var rpkgsDup: int64 := alloc(4 * EDI_PACKAGE_SIZE);
    zi := 0;
    while (zi < 4 * EDI_PACKAGE_SIZE) { poke8(rpkgsDup + zi, 0); zi := zi + 1; }

    var dupResult: int64 := EdiDesadvRead(buf2, wDup, rpkgsDup, 4);
    if (dupResult != (0 - 1)) {
        PrintLn("FAIL: duplicate SSCC should return -1"c); ok := 0;
    } else { PrintLn("PASS: duplicate SSCC returns -1"c); }

    free(rpkgsDup, 4 * EDI_PACKAGE_SIZE);
    free(dupPkgs, 2 * EDI_PACKAGE_SIZE);
    free(buf2, 4096);

    // -------------------------------------------------------------------------
    // Tests 17-23: RECADV write + read (partial acceptance)
    // -------------------------------------------------------------------------
    var buf3: int64 := alloc(4096);
    zi := 0;
    while (zi < 4096) { poke8(buf3 + zi, 0); zi := zi + 1; }

    var rlines: int64 := alloc(2 * EDI_RECADV_LINE_SIZE);
    zi := 0;
    while (zi < 2 * EDI_RECADV_LINE_SIZE) { poke8(rlines + zi, 0); zi := zi + 1; }

    // Line 0: fully accepted
    var rl0: int64 := rlines + 0 * EDI_RECADV_LINE_SIZE;
    poke64(rl0 + EDI_RECADV_LINE_GTIN,      "01234565"c as int64);
    poke64(rl0 + EDI_RECADV_LINE_GTINLEN,   8);
    poke64(rl0 + EDI_RECADV_LINE_ORDERED,   50);
    poke64(rl0 + EDI_RECADV_LINE_DELIVERED, 50);
    poke64(rl0 + EDI_RECADV_LINE_ACCEPTED,  50);

    // Line 1: partial acceptance (damage) with reason
    var rl1: int64 := rlines + 1 * EDI_RECADV_LINE_SIZE;
    poke64(rl1 + EDI_RECADV_LINE_GTIN,      "4006381333931"c as int64);
    poke64(rl1 + EDI_RECADV_LINE_GTINLEN,   13);
    poke64(rl1 + EDI_RECADV_LINE_ORDERED,   100);
    poke64(rl1 + EDI_RECADV_LINE_DELIVERED, 100);
    poke64(rl1 + EDI_RECADV_LINE_ACCEPTED,  90);    // 10 damaged
    poke64(rl1 + EDI_RECADV_LINE_REASON,    "DAMAGED"c as int64);
    poke64(rl1 + EDI_RECADV_LINE_REASONLEN, 7);

    var w3: int64 := EdiRecadvWrite("PO001"c as int64, "20260615"c as int64, rlines, 2, buf3, 4096);

    if (w3 <= 0) {
        PrintLn("FAIL: EdiRecadvWrite should return > 0"c); ok := 0;
    } else { PrintLn("PASS: EdiRecadvWrite returns > 0"c); }

    // BGM = 66,71,77
    if (hasTag(buf3, w3, 66, 71, 77) != 1) {
        PrintLn("FAIL: RECADV missing BGM tag"c); ok := 0;
    } else { PrintLn("PASS: RECADV has BGM tag"c); }

    // FTX = 70,84,88
    if (hasTag(buf3, w3, 70, 84, 88) != 1) {
        PrintLn("FAIL: RECADV missing FTX tag"c); ok := 0;
    } else { PrintLn("PASS: RECADV has FTX tag (reason)"c); }

    var rrlines: int64 := alloc(3 * EDI_RECADV_LINE_SIZE);
    zi := 0;
    while (zi < 3 * EDI_RECADV_LINE_SIZE) { poke8(rrlines + zi, 0); zi := zi + 1; }

    var rcnt: int64 := EdiRecadvRead(buf3, w3, rrlines, 3);

    if (rcnt != 2) {
        PrintLn("FAIL: EdiRecadvRead should return 2 lines"c); ok := 0;
    } else { PrintLn("PASS: EdiRecadvRead returns 2 lines"c); }

    var rr0: int64 := rrlines + 0 * EDI_RECADV_LINE_SIZE;
    if (peek64(rr0 + EDI_RECADV_LINE_ORDERED) != 50) {
        PrintLn("FAIL: line[0] ordered should be 50"c); ok := 0;
    } else { PrintLn("PASS: line[0] ordered=50"c); }

    if (peek64(rr0 + EDI_RECADV_LINE_ACCEPTED) != 50) {
        PrintLn("FAIL: line[0] accepted should be 50"c); ok := 0;
    } else { PrintLn("PASS: line[0] accepted=50"c); }

    var rr1: int64 := rrlines + 1 * EDI_RECADV_LINE_SIZE;
    if (peek64(rr1 + EDI_RECADV_LINE_ACCEPTED) != 90) {
        PrintLn("FAIL: line[1] accepted should be 90 (partial)"c); ok := 0;
    } else { PrintLn("PASS: line[1] accepted=90 (partial acceptance)"c); }

    if (peek64(rr1 + EDI_RECADV_LINE_DELIVERED) != 100) {
        PrintLn("FAIL: line[1] delivered should be 100"c); ok := 0;
    } else { PrintLn("PASS: line[1] delivered=100"c); }

    var rr1rp: int64 := peek64(rr1 + EDI_RECADV_LINE_REASON);
    var rr1rl: int64 := peek64(rr1 + EDI_RECADV_LINE_REASONLEN);
    if (memEq(rr1rp, rr1rl, "DAMAGED"c as int64, 7) != 1) {
        PrintLn("FAIL: line[1] reason mismatch"c); ok := 0;
    } else { PrintLn("PASS: line[1] reason=DAMAGED"c); }

    free(rrlines, 3 * EDI_RECADV_LINE_SIZE);
    free(rlines, 2 * EDI_RECADV_LINE_SIZE);
    free(buf3, 4096);

    // -------------------------------------------------------------------------
    // Test 24: RECADV GTIN round-trip for line[1]
    // -------------------------------------------------------------------------
    var buf4: int64 := alloc(2048);
    zi := 0;
    while (zi < 2048) { poke8(buf4 + zi, 0); zi := zi + 1; }
    var rlines2: int64 := alloc(EDI_RECADV_LINE_SIZE);
    zi := 0;
    while (zi < EDI_RECADV_LINE_SIZE) { poke8(rlines2 + zi, 0); zi := zi + 1; }
    poke64(rlines2 + EDI_RECADV_LINE_GTIN,      "4006381333931"c as int64);
    poke64(rlines2 + EDI_RECADV_LINE_GTINLEN,   13);
    poke64(rlines2 + EDI_RECADV_LINE_ORDERED,   10);
    poke64(rlines2 + EDI_RECADV_LINE_DELIVERED, 10);
    poke64(rlines2 + EDI_RECADV_LINE_ACCEPTED,  8);
    var w4: int64 := EdiRecadvWrite("PO002"c as int64, "20260615"c as int64, rlines2, 1, buf4, 2048);
    var rrlines2: int64 := alloc(2 * EDI_RECADV_LINE_SIZE);
    zi := 0;
    while (zi < 2 * EDI_RECADV_LINE_SIZE) { poke8(rrlines2 + zi, 0); zi := zi + 1; }
    EdiRecadvRead(buf4, w4, rrlines2, 2);
    var rgp: int64 := peek64(rrlines2 + EDI_RECADV_LINE_GTIN);
    var rgl: int64 := peek64(rrlines2 + EDI_RECADV_LINE_GTINLEN);
    if (memEq(rgp, rgl, "4006381333931"c as int64, 13) != 1) {
        PrintLn("FAIL: RECADV GTIN round-trip mismatch"c); ok := 0;
    } else { PrintLn("PASS: RECADV GTIN round-trip matches"c); }
    free(rrlines2, 2 * EDI_RECADV_LINE_SIZE);
    free(rlines2, EDI_RECADV_LINE_SIZE);
    free(buf4, 2048);

    // -------------------------------------------------------------------------
    // Test 25: SSCC pallet SSCC round-trip via DESADV
    // -------------------------------------------------------------------------
    var rp0sp: int64 := peek64(rp0 + EDI_PACKAGE_SSCC);
    var rp0sl: int64 := peek64(rp0 + EDI_PACKAGE_SSCCLEN);
    if (memEq(rp0sp, rp0sl, ssccValid, 18) != 1) {
        PrintLn("FAIL: DESADV pallet SSCC round-trip mismatch"c); ok := 0;
    } else { PrintLn("PASS: DESADV pallet SSCC round-trip matches"c); }

    free(rpkgs, 4 * EDI_PACKAGE_SIZE);
    free(pkgs, 3 * EDI_PACKAGE_SIZE);
    free(generatedSscc, 20);
    free(buf1, 4096);

    // -------------------------------------------------------------------------
    // Final result
    // -------------------------------------------------------------------------
    if (ok == 1) {
        PrintLn("ALL PASS"c);
    } else {
        PrintLn("SOME TESTS FAILED"c);
    }
    return 0;
}
