// tests/switch_fallthrough_test.lyx
// WP-2.2-C: Switch-Fallthrough-Verbot
//
// All cases here explicitly terminate with break/return — the file compiles
// only because no implicit fallthrough occurs.  Non-terminating cases would
// be rejected at compile time with "switch case may fall through".

@description("WP-2.2-C: switch fallthrough enforcement tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.switch_fallthrough_test;

// --- 1. All cases end with break ---
fn testAllBreak(x: int64): int64 {
  var r: int64 := 0;
  switch (x) {
    case 1: { r := 10; break; }
    case 2: { r := 20; break; }
    default: { r := 99; break; }
  }
  return r;
}

fn testBreakCase(): int64 {
  if (testAllBreak(1) != 10) { PrintStr("FAIL: break case 1\n"); return 1; }
  if (testAllBreak(2) != 20) { PrintStr("FAIL: break case 2\n"); return 1; }
  if (testAllBreak(5) != 99) { PrintStr("FAIL: break default\n"); return 1; }
  PrintStr("OK: all cases end with break\n");
  return 0;
}

// --- 2. Cases end with return ---
fn testReturnCase(x: int64): int64 {
  switch (x) {
    case 1: { return 100; }
    case 2: { return 200; }
    default: { return -1; }
  }
}

fn testAllReturn(): int64 {
  if (testReturnCase(1) != 100) { PrintStr("FAIL: return case 1\n"); return 1; }
  if (testReturnCase(2) != 200) { PrintStr("FAIL: return case 2\n"); return 1; }
  if (testReturnCase(9) != -1)  { PrintStr("FAIL: return default\n"); return 1; }
  PrintStr("OK: all cases end with return\n");
  return 0;
}

// --- 3. Default without explicit case ---
fn testDefaultOnly(x: int64): int64 {
  var r: int64 := 0;
  switch (x) {
    default: { r := 42; break; }
  }
  return r;
}

fn testDefaultCase(): int64 {
  if (testDefaultOnly(99) != 42) { PrintStr("FAIL: default only\n"); return 1; }
  PrintStr("OK: default case with break\n");
  return 0;
}

// --- 4. Case body with if/else both terminating ---
fn testIfElseTerminator(x: int64): int64 {
  var r: int64 := 0;
  switch (x) {
    case 1: {
      if (x > 0) {
        r := 10;
        return 10;
      } else {
        r := 11;
        return 11;
      }
    }
    default: { r := 0; break; }
  }
  return r;
}

fn testIfElseInCase(): int64 {
  if (testIfElseTerminator(1) != 10) { PrintStr("FAIL: if/else in case\n"); return 1; }
  if (testIfElseTerminator(2) != 0)  { PrintStr("FAIL: default after if/else case\n"); return 1; }
  PrintStr("OK: if/else both-terminating case\n");
  return 0;
}

// --- 5. Mixed break and return ---
fn testMixedTerminators(x: int64): int64 {
  var r: int64 := 0;
  switch (x) {
    case 1: { return 1; }
    case 2: { r := 2; break; }
    case 3: { return 3; }
    default: { r := 99; break; }
  }
  return r;
}

fn testMixed(): int64 {
  if (testMixedTerminators(1) != 1)  { PrintStr("FAIL: mixed 1\n"); return 1; }
  if (testMixedTerminators(2) != 2)  { PrintStr("FAIL: mixed 2\n"); return 1; }
  if (testMixedTerminators(3) != 3)  { PrintStr("FAIL: mixed 3\n"); return 1; }
  if (testMixedTerminators(9) != 99) { PrintStr("FAIL: mixed default\n"); return 1; }
  PrintStr("OK: mixed break/return terminators\n");
  return 0;
}

pub fn main(): int64 {
  if (testBreakCase()     != 0) { return 1; }
  if (testAllReturn()     != 0) { return 1; }
  if (testDefaultCase()   != 0) { return 1; }
  if (testIfElseInCase()  != 0) { return 1; }
  if (testMixed()         != 0) { return 1; }
  PrintStr("All WP-2.2-C switch fallthrough tests passed.\n");
  return 0;
}
