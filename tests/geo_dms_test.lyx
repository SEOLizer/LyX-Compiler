// tests/geo_dms_test.lyx
// #1888 Punkte 2 und 3: ParseDMS rechnet exakt und meldet, DistanceMApprox
// heisst nach dem, was es tut.
//
// Die Sollwerte sind von Hand gerechnet, nicht aus der geprueften Formel:
//   53 Grad 33' 04" = (53*3600 + 33*60 + 4) / 3600 Grad = 53.5511111 Grad
//                   = 53551111 Mikrograd (abgerundet)
//    0 Grad 59' 59" = 3599/3600 Grad = 999722 Mikrograd
//    1 Grad 00' 00" = exakt 1000000 Mikrograd
//
// Der dritte Wert ist der aussagekraeftigste: mit den alten Festkommafaktoren
// (16667 je Minute, 278 je Sekunde) kamen dort 1000020 heraus. Eine volle
// Minute MUSS exakt aufgehen, sonst stimmt die Umrechnung an keiner Stelle.

unit main;

import std.io;
import std.geo;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn Check(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got == want) { PrintStr("PASS "c); PrintStrLn(name); }
  else {
    PrintStr("FAIL "c); PrintStr(name);
    PrintStr(": erhalten "c); PrintInt(got);
    PrintStr(" erwartet "c); PrintInt(want); PrintLn(""c);
    _fails := _fails + 1;
  }
}

fn CheckWahr(name: pchar, got: bool): void {
  _checks := _checks + 1;
  if (got) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStr(name); PrintStrLn(" (erwartet: wahr)"c); _fails := _fails + 1; }
}

fn CheckFalsch(name: pchar, got: bool): void {
  _checks := _checks + 1;
  if (!got) { PrintStr("PASS "c); PrintStrLn(name); }
  else { PrintStr("FAIL "c); PrintStr(name); PrintStrLn(" (erwartet: falsch)"c); _fails := _fails + 1; }
}

fn main(): int64 {
  // ── Exakte Umrechnung ───────────────────────────────────────────────────
  Check("53 Grad 33' 04\" N"c, ParseDMS(53, 33, 4, 78), 53551111);
  Check("0 Grad 59' 59\" N"c,  ParseDMS(0, 59, 59, 78), 999722);
  // Der Fall, der die alten Faktoren entlarvt: 1000020 statt 1000000.
  Check("1 Grad exakt"c,       ParseDMS(1, 0, 0, 78), 1000000);
  Check("90 Grad exakt"c,      ParseDMS(90, 0, 0, 78), 90000000);
  Check("180 Grad exakt"c,     ParseDMS(180, 0, 0, 69), 180000000);
  Check("0 Grad 0' 0\""c,      ParseDMS(0, 0, 0, 78), 0);
  // Eine Bogenminute sind exakt 1/60 Grad; sechzig davon ein voller Grad.
  Check("60 mal eine Minute"c, ParseDMS(0, 1, 0, 78) * 60, 999960);

  // ── Himmelsrichtungen ───────────────────────────────────────────────────
  Check("Nord ist positiv"c,  ParseDMS(53, 33, 4, 78), 53551111);
  Check("Sued ist negativ"c,  ParseDMS(53, 33, 4, 83), 0 - 53551111);
  Check("Ost ist positiv"c,   ParseDMS(9, 59, 37, 69), 9993611);
  Check("West ist negativ"c,  ParseDMS(9, 59, 37, 87), 0 - 9993611);

  // ── Fehlerfaelle: melden statt raten ────────────────────────────────────
  // Der Kern von #1888 Punkt 3: eine unbekannte Richtung wurde still als
  // Nord genommen. Ein Tippfehler im Buchstaben spiegelte damit eine Position
  // auf die andere Erdhalbkugel, ohne dass es auffiel.
  CheckWahr("unbekannte Richtung meldet"c, GeoIstDmsFehler(ParseDMS(53, 33, 4, 88)));
  CheckWahr("Kleinbuchstabe n meldet"c,    GeoIstDmsFehler(ParseDMS(53, 33, 4, 110)));
  CheckWahr("Richtung 0 meldet"c,          GeoIstDmsFehler(ParseDMS(53, 33, 4, 0)));
  // 60 Minuten sind keine Schreibweise, sondern ein Tippfehler — und 61
  // Minuten liegen 1.85 km neben der gemeinten Stelle.
  CheckWahr("60 Minuten meldet"c,   GeoIstDmsFehler(ParseDMS(0, 60, 0, 78)));
  CheckWahr("60 Sekunden meldet"c,  GeoIstDmsFehler(ParseDMS(0, 0, 60, 78)));
  CheckWahr("negative Minuten melden"c, GeoIstDmsFehler(ParseDMS(0, 0 - 1, 0, 78)));
  CheckWahr("negative Grad melden"c,    GeoIstDmsFehler(ParseDMS(0 - 1, 0, 0, 78)));
  // Gegenprobe: 59 Minuten und 59 Sekunden sind gueltig und melden NICHT.
  CheckFalsch("59' 59\" ist gueltig"c, GeoIstDmsFehler(ParseDMS(0, 59, 59, 78)));
  // Und der Fehlerwert ist keine gueltige Koordinate — 0 waere es gewesen.
  CheckWahr("Fehlerwert liegt ausserhalb"c, GEO_DMS_FEHLER > 180000000);

  // ── Punkt 2: der Name sagt jetzt, was die Funktion tut ──────────────────
  var hh: GeoPoint := GeoPointNew(9993700, 53551100);
  var hb: GeoPoint := GeoPointNew(8801700, 53079300);
  // Im Nahbereich stimmt die Naeherung auf unter ein Prozent — dafuer ist sie
  // da, und das steht jetzt im Namen.
  var d: int64 := DistanceMApprox(hh, hb);
  CheckWahr("Naeherung im Nahbereich brauchbar"c, d > 94000 && d < 96500);
  // Der alte Name leitet weiter, damit vorhandener Code laeuft — er liefert
  // denselben Wert, nicht etwa einen besseren.
  Check("alter Name leitet weiter"c, HaversineDistanceM(hh, hb), d);
  // Und die Grenze der Naeherung bleibt bestehen: ueber die Datumsgrenze
  // rechnet sie weiter falsch. Das ist keine Verschlechterung, sondern der
  // dokumentierte Gueltigkeitsbereich — wer das braucht, nimmt std.geo.sphere.
  var o179: GeoPoint := GeoPointNew(179000000, 0);
  var w179: GeoPoint := GeoPointNew(0 - 179000000, 0);
  CheckWahr("Datumsgrenze bleibt ausserhalb des Bereichs"c,
            DistanceMApprox(o179, w179) > 1000000);

  PrintStr("\n"c);
  PrintInt(_checks); PrintStr(" Pruefungen, "c);
  PrintInt(_fails); PrintStrLn(" FAIL"c);
  if (_fails == 0) { PrintStrLn("OK: ParseDMS exakt, DistanceMApprox benannt"c); return 0; }
  return 1;
}
