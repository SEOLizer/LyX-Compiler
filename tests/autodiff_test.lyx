// tests/autodiff_test.lyx
// Selbstpruefende Testbatterie fuer std.autodiff.
//
// Sollwerte aus Python (analytisch abgeleitete Formeln, in math nachgerechnet).
// Zusaetzlich zwei Pruefungen, die ohne fremde Zahlen auskommen und deshalb
// besonders tragen:
//
//   - Vorwaerts- gegen Rueckwaertsmodus. Beide teilen keinen Code; ein Fehler
//     muesste in beiden gleich auftreten, um unentdeckt zu bleiben.
//   - der zentrale Differenzenquotient als dritte, voellig unabhaengige
//     Quelle. Er ist ungenau (rund zehn gueltige Stellen), aber er kennt die
//     Kettenregel nicht — genau das macht ihn als Gegenprobe wertvoll.

unit main;

import std.autodiff;
import std.math;
import std.alloc;

var _fails: int64 := 0;
var _checks: int64 := 0;

fn TOL(): f64 { return 0.000000001; }

fn Check(name: pchar, got: f64, want: f64, tol: f64): void {
  _checks := _checks + 1;
  if (AbsF64(got - want) > tol) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintFloat(got);
    PrintStr(" want="c);
    PrintFloat(want);
    PrintStr("\n"c);
  }
}

fn CheckI(name: pchar, got: int64, want: int64): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" got="c);
    PrintInt(got);
    PrintStr(" want="c);
    PrintInt(want);
    PrintStr("\n"c);
  }
}

fn CheckB(name: pchar, got: bool, want: bool): void {
  _checks := _checks + 1;
  if (got != want) {
    _fails := _fails + 1;
    PrintStr("FAIL "c);
    PrintStr(name);
    PrintStr(" (bool)\n"c);
  }
}

fn main(): int64 {
  var X: f64 := 1.7;
  var Y: f64 := -0.8;
  var Z: f64 := 2.3;

  // ── Bandverwaltung ────────────────────────────────────────────────────────
  var t: int64 := AdTapeNew(256);
  CheckB("tapeOk"c, t != 0, true);
  CheckI("capacity"c, AdTapeCapacity(t), 256);
  CheckI("countEmpty"c, AdTapeCount(t), 0);
  CheckI("tapeBadCap"c, AdTapeNew(0), 0);

  var x: int64 := AdVar(t, X);
  var y: int64 := AdVar(t, Y);
  CheckI("firstNode"c, x, 0);
  CheckI("secondNode"c, y, 1);
  CheckI("countTwo"c, AdTapeCount(t), 2);
  Check("valueX"c, AdValue(t, x), X, TOL());

  // ungueltige Knoten
  Check("valueBad"c, AdValue(t, 99), 0.0, TOL());
  CheckI("addBad"c, AdAdd(t, x, 99), AD_INVALID);
  CheckI("addNoTape"c, AdAdd(0, x, y), AD_INVALID);

  // ── Grundoperationen mit Gradient ─────────────────────────────────────────
  // f = x + y
  var f1: int64 := AdAdd(t, x, y);
  Check("addVal"c, AdValue(t, f1), 0.9, TOL());
  CheckB("bwOk"c, AdBackward(t, f1), true);
  Check("addDx"c, AdGrad(t, x), 1.0, TOL());
  Check("addDy"c, AdGrad(t, y), 1.0, TOL());

  // f = x - y
  var f2: int64 := AdSub(t, x, y);
  Check("subVal"c, AdValue(t, f2), 2.5, TOL());
  AdBackward(t, f2);
  Check("subDx"c, AdGrad(t, x), 1.0, TOL());
  Check("subDy"c, AdGrad(t, y), -1.0, TOL());

  // f = x * y
  var f3: int64 := AdMul(t, x, y);
  Check("mulVal"c, AdValue(t, f3), -1.36, TOL());
  AdBackward(t, f3);
  Check("mulDx"c, AdGrad(t, x), Y, TOL());
  Check("mulDy"c, AdGrad(t, y), X, TOL());

  // f = x / y
  var f4: int64 := AdDiv(t, x, y);
  Check("divVal"c, AdValue(t, f4), -2.125, TOL());
  AdBackward(t, f4);
  Check("divDx"c, AdGrad(t, x), -1.25, TOL());
  Check("divDy"c, AdGrad(t, y), -2.6562499999999996, TOL());

  // Division durch null gibt 0 statt NaN — sonst verseucht es das ganze Band
  var zeroNode: int64 := AdConst(t, 0.0);
  var f5: int64 := AdDiv(t, x, zeroNode);
  Check("divZeroVal"c, AdValue(t, f5), 0.0, TOL());
  AdBackward(t, f5);
  Check("divZeroGrad"c, AdGrad(t, x), 0.0, TOL());

  // ── Einstellige Operationen ───────────────────────────────────────────────
  var g: int64 := AdNeg(t, x);
  Check("negVal"c, AdValue(t, g), -1.7, TOL());
  AdBackward(t, g);
  Check("negD"c, AdGrad(t, x), -1.0, TOL());

  g := AdSquare(t, x);
  Check("sqVal"c, AdValue(t, g), 2.89, TOL());
  AdBackward(t, g);
  Check("sqD"c, AdGrad(t, x), 3.4, TOL());

  g := AdSqrt(t, x);
  Check("sqrtVal"c, AdValue(t, g), 1.3038404810405297, TOL());
  AdBackward(t, g);
  Check("sqrtD"c, AdGrad(t, x), 0.3834824944236852, TOL());

  g := AdExp(t, x);
  Check("expVal"c, AdValue(t, g), 5.4739473917272, 0.0000001);
  AdBackward(t, g);
  Check("expD"c, AdGrad(t, x), 5.4739473917272, 0.0000001);

  g := AdLog(t, x);
  Check("logVal"c, AdValue(t, g), 0.5306282510621704, 0.0000001);
  AdBackward(t, g);
  Check("logD"c, AdGrad(t, x), 0.5882352941176471, TOL());

  g := AdSin(t, x);
  Check("sinVal"c, AdValue(t, g), 0.9916648104524686, 0.0000001);
  AdBackward(t, g);
  Check("sinD"c, AdGrad(t, x), -0.12884449429552464, 0.0000001);

  g := AdCos(t, x);
  Check("cosVal"c, AdValue(t, g), -0.12884449429552464, 0.0000001);
  AdBackward(t, g);
  Check("cosD"c, AdGrad(t, x), -0.9916648104524686, 0.0000001);

  g := AdTan(t, x);
  Check("tanVal"c, AdValue(t, g), -7.696602139459161, 0.00001);
  AdBackward(t, g);
  Check("tanD"c, AdGrad(t, x), 60.23768449312735, 0.001);

  g := AdPowConst(t, x, 2.5);
  Check("powVal"c, AdValue(t, g), 3.7680989902071307, 0.0000001);
  AdBackward(t, g);
  Check("powD"c, AdGrad(t, x), 5.541322044422251, 0.0000001);

  // Exponent 0 gibt konstant 1
  g := AdPowConst(t, x, 0.0);
  Check("pow0Val"c, AdValue(t, g), 1.0, TOL());
  AdBackward(t, g);
  Check("pow0D"c, AdGrad(t, x), 0.0, TOL());

  g := AdRecip(t, x);
  Check("recipVal"c, AdValue(t, g), 0.5882352941176471, TOL());
  AdBackward(t, g);
  Check("recipD"c, AdGrad(t, x), -0.34602076124567477, TOL());

  g := AdAbs(t, y);
  Check("absVal"c, AdValue(t, g), 0.8, TOL());
  AdBackward(t, g);
  Check("absD"c, AdGrad(t, y), -1.0, TOL());

  // Betrag bei 0: Ableitung per Konvention 0
  var zn: int64 := AdVar(t, 0.0);
  g := AdAbs(t, zn);
  AdBackward(t, g);
  Check("absZeroD"c, AdGrad(t, zn), 0.0, TOL());

  g := AdMulConst(t, x, 3.0);
  Check("mulConstVal"c, AdValue(t, g), 5.1, TOL());
  AdBackward(t, g);
  Check("mulConstD"c, AdGrad(t, x), 3.0, TOL());

  g := AdAddConst(t, x, 3.0);
  Check("addConstVal"c, AdValue(t, g), 4.7, TOL());
  AdBackward(t, g);
  Check("addConstD"c, AdGrad(t, x), 1.0, TOL());

  // ── Bausteine neuronaler Netze ────────────────────────────────────────────
  g := AdTanh(t, x);
  Check("tanhVal"c, AdValue(t, g), 0.935409070603099, 0.0000001);
  AdBackward(t, g);
  Check("tanhD"c, AdGrad(t, x), 0.1250098706334466, 0.0000001);

  g := AdSigmoid(t, x);
  Check("sigVal"c, AdValue(t, g), 0.8455347349164652, 0.0000001);
  AdBackward(t, g);
  Check("sigD"c, AdGrad(t, x), 0.13060574696620808, 0.0000001);

  g := AdRelu(t, x);
  Check("reluPos"c, AdValue(t, g), X, TOL());
  AdBackward(t, g);
  Check("reluPosD"c, AdGrad(t, x), 1.0, TOL());

  g := AdRelu(t, y);
  Check("reluNeg"c, AdValue(t, g), 0.0, TOL());
  AdBackward(t, g);
  Check("reluNegD"c, AdGrad(t, y), 0.0, TOL());

  // Maximum: der Gradient fliesst nur in den Gewinner
  g := AdMax(t, x, y);
  Check("maxVal"c, AdValue(t, g), X, TOL());
  AdBackward(t, g);
  Check("maxDx"c, AdGrad(t, x), 1.0, TOL());
  Check("maxDy"c, AdGrad(t, y), 0.0, TOL());

  g := AdMin(t, x, y);
  Check("minVal"c, AdValue(t, g), Y, TOL());
  AdBackward(t, g);
  Check("minDx"c, AdGrad(t, x), 0.0, TOL());
  Check("minDy"c, AdGrad(t, y), 1.0, TOL());

  // ── Kettenregel und mehrfach genutzte Variablen ───────────────────────────
  // Der eigentliche Test des Rueckwaertslaufs: x taucht in beiden Faktoren
  // auf, die Beitraege muessen sich addieren, nicht ueberschreiben.
  AdTapeReset(t);
  CheckI("resetCount"c, AdTapeCount(t), 0);
  x := AdVar(t, X);
  y := AdVar(t, Y);

  // f = (x+y) * (x-y) = x^2 - y^2 -> df/dx = 2x, df/dy = -2y
  var sum: int64 := AdAdd(t, x, y);
  var dif: int64 := AdSub(t, x, y);
  var prod: int64 := AdMul(t, sum, dif);
  Check("diamondVal"c, AdValue(t, prod), 2.25, TOL());
  AdBackward(t, prod);
  Check("diamondDx"c, AdGrad(t, x), 3.4, TOL());
  Check("diamondDy"c, AdGrad(t, y), 1.6, TOL());

  // log(exp(x)) = x, Gradient exakt 1 — prueft, dass sich die lokalen
  // Ableitungen sauber wegheben
  AdTapeReset(t);
  x := AdVar(t, X);
  var ident: int64 := AdLog(t, AdExp(t, x));
  Check("identVal"c, AdValue(t, ident), X, 0.0000001);
  AdBackward(t, ident);
  Check("identD"c, AdGrad(t, x), 1.0, 0.0000001);

  // drei Variablen: f = x*y*z + sin(x*y)
  AdTapeReset(t);
  x := AdVar(t, X);
  y := AdVar(t, Y);
  var z: int64 := AdVar(t, Z);
  var xy: int64 := AdMul(t, x, y);
  var f: int64 := AdAdd(t, AdMul(t, xy, z), AdSin(t, xy));
  Check("threeVal"c, AdValue(t, f), -4.105864602435316, 0.0000001);
  AdBackward(t, f);
  Check("threeDx"c, AdGrad(t, x), -2.007390932713135, 0.0000001);
  Check("threeDy"c, AdGrad(t, y), 4.265705732015412, 0.0000001);
  Check("threeDz"c, AdGrad(t, z), -1.36, TOL());

  // Sammelabruf
  var vars: int64 := alloc(3 * 8);
  var grads: int64 := alloc(3 * 8);
  poke64(vars, x);  poke64(vars + 8, y);  poke64(vars + 16, z);
  CheckB("gradsOk"c, AdGradients(t, vars, 3, grads), true);
  var g0: f64 := peekf64(grads);
  var g2: f64 := peekf64(grads + 16);
  Check("gradsFirst"c, g0, -2.007390932713135, 0.0000001);
  Check("gradsThird"c, g2, -1.36, TOL());
  free(vars, 3 * 8);
  free(grads, 3 * 8);

  // ── Rosenbrock ────────────────────────────────────────────────────────────
  // f = (1-x)^2 + 100*(y - x^2)^2 — der Klassiker unter den Testfunktionen,
  // weil sein Gradient in einem schmalen Tal fast verschwindet
  AdTapeReset(t);
  x := AdVar(t, X);
  y := AdVar(t, Y);
  var one: int64 := AdConst(t, 1.0);
  var term1: int64 := AdSquare(t, AdSub(t, one, x));
  var term2: int64 := AdMulConst(t, AdSquare(t, AdSub(t, y, AdSquare(t, x))), 100.0);
  var rosen: int64 := AdAdd(t, term1, term2);
  Check("rosenVal"c, AdValue(t, rosen), 1362.0999999999997, 0.000001);
  AdBackward(t, rosen);
  Check("rosenDx"c, AdGrad(t, x), 2510.6, 0.000001);
  Check("rosenDy"c, AdGrad(t, y), -737.9999999999999, 0.000001);

  // Im Minimum (1,1) muss der Gradient verschwinden
  AdTapeReset(t);
  x := AdVar(t, 1.0);
  y := AdVar(t, 1.0);
  one := AdConst(t, 1.0);
  term1 := AdSquare(t, AdSub(t, one, x));
  term2 := AdMulConst(t, AdSquare(t, AdSub(t, y, AdSquare(t, x))), 100.0);
  rosen := AdAdd(t, term1, term2);
  Check("rosenMinVal"c, AdValue(t, rosen), 0.0, TOL());
  AdBackward(t, rosen);
  Check("rosenMinDx"c, AdGrad(t, x), 0.0, TOL());
  Check("rosenMinDy"c, AdGrad(t, y), 0.0, TOL());

  // ── Kleines Netz: L = (sigmoid(w*x+b) - target)^2 ─────────────────────────
  AdTapeReset(t);
  var w: int64 := AdVar(t, 0.5);
  var b: int64 := AdVar(t, -0.3);
  var inp: int64 := AdConst(t, 1.7);
  var target: int64 := AdConst(t, 1.0);
  var lin: int64 := AdAdd(t, AdMul(t, w, inp), b);
  var act: int64 := AdSigmoid(t, lin);
  var loss: int64 := AdSquare(t, AdSub(t, act, target));
  Check("nnLoss"c, AdValue(t, loss), 0.13385676576501607, 0.0000001);
  AdBackward(t, loss);
  Check("nnDw"c, AdGrad(t, w), -0.28860335351525546, 0.0000001);
  Check("nnDb"c, AdGrad(t, b), -0.16976667853838556, 0.0000001);

  // Ein Gradientenschritt muss den Verlust senken — die eigentliche Probe
  // aufs Exempel
  var lr: f64 := 1.0;
  // `-0.3 - lr * ...` waere ein negatives Literal als Operand und rechnet in
  // lyxc 1.0.19D still falsch (#1496) — der Startwert steht deshalb in einer
  // Variablen.
  var b0: f64 := -0.3;
  var w2: f64 := 0.5 - lr * AdGrad(t, w);
  var b2: f64 := b0 - lr * AdGrad(t, b);
  AdTapeReset(t);
  w := AdVar(t, w2);
  b := AdVar(t, b2);
  inp := AdConst(t, 1.7);
  target := AdConst(t, 1.0);
  lin := AdAdd(t, AdMul(t, w, inp), b);
  act := AdSigmoid(t, lin);
  var loss2: int64 := AdSquare(t, AdSub(t, act, target));
  var improved: bool := AdValue(t, loss2) < 0.13385676576501607;
  CheckB("nnStepImproves"c, improved, true);

  // ── Vorwaerts- gegen Rueckwaertsmodus ─────────────────────────────────────
  // f = exp(x*y) / (1 + x^2), abgeleitet nach x
  var dx: int64 := alloc(16);
  var dy: int64 := alloc(16);
  var d1: int64 := alloc(16);
  var d2: int64 := alloc(16);
  var d3: int64 := alloc(16);

  AdDualVar(dx, X);
  AdDualConst(dy, Y);
  AdDualMul(dx, dy, d1);          // x*y
  AdDualExp(d1, d2);              // exp(x*y)
  AdDualMul(dx, dx, d1);          // x^2
  AdDualAddConst(d1, 1.0, d3);    // 1 + x^2
  AdDualDiv(d2, d3, d1);          // Ergebnis
  var fwdVal: f64 := AdDualValue(d1);
  var fwdDer: f64 := AdDualDeriv(d1);

  AdTapeReset(t);
  x := AdVar(t, X);
  y := AdVar(t, Y);
  var e: int64 := AdExp(t, AdMul(t, x, y));
  var den: int64 := AdAddConst(t, AdSquare(t, x), 1.0);
  var q: int64 := AdDiv(t, e, den);
  AdBackward(t, q);

  Check("fwdVsRevVal"c, fwdVal, AdValue(t, q), TOL());
  Check("fwdVsRevDer"c, fwdDer, AdGrad(t, x), TOL());

  // dieselbe Rechnung nach y
  AdDualConst(dx, X);
  AdDualVar(dy, Y);
  AdDualMul(dx, dy, d1);
  AdDualExp(d1, d2);
  AdDualMul(dx, dx, d1);
  AdDualAddConst(d1, 1.0, d3);
  AdDualDiv(d2, d3, d1);
  Check("fwdVsRevDerY"c, AdDualDeriv(d1), AdGrad(t, y), TOL());

  // Vorwaertsmodus einzeln gegen Python
  AdDualVar(dx, X);
  AdDualSin(dx, d1);
  Check("dualSin"c, AdDualValue(d1), 0.9916648104524686, 0.0000001);
  Check("dualSinD"c, AdDualDeriv(d1), -0.12884449429552464, 0.0000001);
  AdDualSqrt(dx, d1);
  Check("dualSqrtD"c, AdDualDeriv(d1), 0.3834824944236852, TOL());
  AdDualPowConst(dx, 2.5, d1);
  Check("dualPowD"c, AdDualDeriv(d1), 5.541322044422251, 0.0000001);
  AdDualLog(dx, d1);
  Check("dualLogD"c, AdDualDeriv(d1), 0.5882352941176471, TOL());
  AdDualCos(dx, d1);
  Check("dualCosD"c, AdDualDeriv(d1), -0.9916648104524686, 0.0000001);
  // Division durch null auch hier abgefangen
  AdDualConst(d2, 0.0);
  AdDualDiv(dx, d2, d3);
  Check("dualDivZero"c, AdDualValue(d3), 0.0, TOL());

  free(dx, 16);  free(dy, 16);  free(d1, 16);  free(d2, 16);  free(d3, 16);

  // ── Numerische Gegenprobe ─────────────────────────────────────────────────
  // f(x) = sin(x)*exp(x/3), analytisch abgeleitet ueber das Band, verglichen
  // mit dem zentralen Differenzenquotienten
  var h: f64 := AdNumericStep(X);

  AdTapeReset(t);
  x := AdVar(t, X + h);
  var fp: f64 := AdValue(t, AdMul(t, AdSin(t, x), AdExp(t, AdMulConst(t, x, 0.3333333333333333))));
  AdTapeReset(t);
  x := AdVar(t, X - h);
  var fm: f64 := AdValue(t, AdMul(t, AdSin(t, x), AdExp(t, AdMulConst(t, x, 0.3333333333333333))));

  AdTapeReset(t);
  x := AdVar(t, X);
  var fx: int64 := AdMul(t, AdSin(t, x), AdExp(t, AdMulConst(t, x, 0.3333333333333333)));
  AdBackward(t, fx);
  var exact: f64 := AdGrad(t, x);
  var numeric: f64 := AdNumericDeriv(fp, fm, h);

  // Der Differenzenquotient traegt hier rund zehn Stellen — mehr ist von ihm
  // nicht zu erwarten, und genau das ist der Grund fuer diese Einheit.
  CheckB("numericAgrees"c, AdGradClose(exact, numeric, 0.000001), true);
  Check("numericClose"c, numeric, exact, 0.0001);

  CheckB("gradCloseSame"c, AdGradClose(1.0, 1.0, 0.001), true);
  CheckB("gradCloseDiff"c, AdGradClose(1.0, 2.0, 0.001), false);
  // relativ, nicht absolut: 1e6 gegen 1e6+1 gilt als gleich
  CheckB("gradCloseRel"c, AdGradClose(1000000.0, 1000001.0, 0.001), true);

  // ── Bandueberlauf ─────────────────────────────────────────────────────────
  var small: int64 := AdTapeNew(3);
  var s1: int64 := AdVar(small, 1.0);
  var s2: int64 := AdVar(small, 2.0);
  var s3: int64 := AdAdd(small, s1, s2);
  CheckI("smallThird"c, s3, 2);
  // das Band ist voll: der naechste Knoten wird abgewiesen, statt zu schreiben
  var s4: int64 := AdAdd(small, s1, s2);
  CheckI("overflow"c, s4, AD_INVALID);
  CheckI("countCapped"c, AdTapeCount(small), 3);
  // eine Operation auf einem ungueltigen Knoten pflanzt sich fort
  CheckI("invalidPropagates"c, AdMul(small, s4, s1), AD_INVALID);
  CheckB("backwardInvalid"c, AdBackward(small, s4), false);
  AdTapeFree(small);

  AdTapeFree(t);

  PrintStr("checks="c);
  PrintInt(_checks);
  PrintStr(" fails="c);
  PrintInt(_fails);
  PrintStr("\n"c);
  return _fails;
}
