// ============================================================================
// Test 9: 10000 Zeilen × 10 Spalten
// ============================================================================

fn testLargeOds(): int64 {
  var doc: OdfDocument := new OdfDocument();
  doc.Init(ODF_TYPE_SPREADSHEET);
  OdsAddSheet(doc, "Gross"c);
  var r: int64 := 0;
  while r < 10000 {
    var c: int64 := 0;
    while c < 10 {
      OdsSetCellInt(doc, r, c, r * 10 + c);
      c := c + 1;
    }
    r := r + 1;
  }
  OdsFlushSheet(doc);
  var rc: int64 := doc.SaveToFile("/tmp/off_test_large.ods"c);
  doc.Close();
  if rc != ODF_OK {
    PrintLn("FAIL: testLargeOds");
    return 1;
  }
  PrintLn("OK: testLargeOds");
  return 0;
}

// ============================================================================
// Test 10: odfEscapeInto Einheit-Tests
// ============================================================================

fn testEscapeUnit(): int64 {
  var escBuf: int64 := alloc(256);

  var n: int64 := odfEscapeInto("&"c as int64, escBuf, 256);
  if n != 5 { PrintLn("FAIL: escape &"); free(escBuf, 256); return 1; }

  n := odfEscapeInto("<"c as int64, escBuf, 256);
  if n != 4 { PrintLn("FAIL: escape <"); free(escBuf, 256); return 1; }

  n := odfEscapeInto(">"c as int64, escBuf, 256);
  if n != 4 { PrintLn("FAIL: escape >"); free(escBuf, 256); return 1; }

  n := odfEscapeInto("\""c as int64, escBuf, 256);
  if n != 6 { PrintLn("FAIL: escape \""); free(escBuf, 256); return 1; }

  n := odfEscapeInto("'"c as int64, escBuf, 256);
  if n != 5 { PrintLn("FAIL: escape '"); free(escBuf, 256); return 1; }

  n := odfEscapeInto(""c as int64, escBuf, 256);
  if n != 0 { PrintLn("FAIL: escape empty"); free(escBuf, 256); return 1; }

  n := odfEscapeInto("Hallo Welt"c as int64, escBuf, 256);
  if n != 10 { PrintLn("FAIL: escape ASCII"); free(escBuf, 256); return 1; }

  free(escBuf, 256);
  PrintLn("OK: testEscapeUnit");
  return 0;
}

// ============================================================================
// main
// ============================================================================

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testEscapeUnit();
  failed := failed + testEmptyOdt();
  failed := failed + testOdtContent();
  failed := failed + testXmlEscape();
  failed := failed + testStyleDedup();
  failed := failed + testManyParagraphs();
  failed := failed + testSimpleOds();
  failed := failed + testMultiSheet();
  failed := failed + testGapCells();
  failed := failed + testLargeOds();

  if failed != 0 {
    PrintLn("FAILED");
    return 1;
  }
  PrintLn("ALL PASSED");
  return 0;
}
