// ============================================================================
// Test 6: Einfaches ODS
// ============================================================================

fn testSimpleOds(): int64 {
  var doc: OdfDocument := new OdfDocument();
  doc.Init(ODF_TYPE_SPREADSHEET);
  OdsAddSheet(doc, "Tabelle1"c);
  OdsSetCell(doc, 0, 0, "Name"c);
  OdsSetCell(doc, 0, 1, "Wert"c);
  OdsSetCell(doc, 1, 0, "Alpha"c);
  OdsSetCellInt(doc, 1, 1, 42);
  OdsSetCell(doc, 2, 0, "Beta"c);
  OdsSetCellFloat(doc, 2, 1, 314, 2);
  OdsFlushSheet(doc);
  var rc: int64 := doc.SaveToFile("/tmp/off_test_simple.ods"c);
  doc.Close();
  if rc != ODF_OK {
    PrintLn("FAIL: testSimpleOds");
    return 1;
  }
  PrintLn("OK: testSimpleOds");
  return 0;
}

