// ============================================================================
// Test 4: Auto-Style-Deduplizierung (50x Bold → 1 Style)
// ============================================================================

fn testStyleDedup(): int64 {
  var doc: OdfDocument := new OdfDocument();
  doc.Init(ODF_TYPE_TEXT);
  var i: int64 := 0;
  while i < 50 {
    OdtAddParagraphStyled(doc, "Fetter Text"c, 1, 0);
    i := i + 1;
  }
  var rc: int64 := doc.SaveToFile("/tmp/off_test_dedup.odt"c);
  var idx: int64 := doc.autoStyleIdx;
  doc.Close();
  if rc != ODF_OK {
    PrintLn("FAIL: testStyleDedup SaveToFile");
    return 1;
  }
  if idx != 1 {
    PrintLn("FAIL: testStyleDedup: mehr als 1 Auto-Style");
    return 1;
  }
  PrintLn("OK: testStyleDedup");
  return 0;
}

