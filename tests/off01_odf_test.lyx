// tests/off01_odf_test.lyx — OFF-01..OFF-05: ODF-Bibliothek Integrationstest

unit tests.off01_odf_test;

import std.alloc;
import std.io;
import std.string;
import std.office.odf_doc;
import std.office.odf_xml;
import std.office.odt;
import std.office.ods;

// ============================================================================
// Test 1: Leeres ODT-Dokument
// ============================================================================

fn testEmptyOdt(): int64 {
  var doc: OdfDocument := new OdfDocument();
  doc.Init(ODF_TYPE_TEXT);
  var rc: int64 := doc.SaveToFile("/tmp/off_test_empty.odt"c);
  doc.Close();
  if rc != ODF_OK {
    PrintLn("FAIL: testEmptyOdt");
    return 1;
  }
  PrintLn("OK: testEmptyOdt");
  return 0;
}

// ============================================================================
// Test 2: ODT mit Inhalt
// ============================================================================

fn testOdtContent(): int64 {
  var doc: OdfDocument := new OdfDocument();
  doc.Init(ODF_TYPE_TEXT);
  OdtAddHeading(doc, "Testdokument"c, 1);
  OdtAddHeading(doc, "Kapitel 1"c, 2);
  OdtAddParagraph(doc, "Hallo Welt"c);
  OdtAddParagraphStyled(doc, "Fetter Text"c, 1, 0);
  OdtAddParagraphStyled(doc, "Kursiver Text"c, 0, 1);
  OdtAddParagraphStyled(doc, "Fett und Kursiv"c, 1, 1);
  OdtAddLineBreak(doc);
  OdtAddParagraph(doc, "Zweiter Absatz nach Leerzeile"c);
  OdtAddHorizontalRule(doc);
  OdtAddHeading(doc, "Kapitel 2"c, 2);
  OdtAddParagraph(doc, "Ende des Dokuments"c);
  var rc: int64 := doc.SaveToFile("/tmp/off_test_content.odt"c);
  doc.Close();
  if rc != ODF_OK {
    PrintLn("FAIL: testOdtContent");
    return 1;
  }
  PrintLn("OK: testOdtContent");
  return 0;
}

