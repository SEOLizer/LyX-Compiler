// tests/compound_tokens_test.lyx
// WP-1.1-C: Compound-Token Longest-Match
//
// Verifies that all multi-character operators are tokenized as single tokens:
//   ..   → TK_DOTDOT    (not DOT + DOT)
//   ...  → TK_DOTDOTDOT (not DOT + DOT + DOT)
//   ??   → TK_NULLCL    (not QUEST + QUEST)
//   ?.   → TK_QMARK_DOT (not QUEST + DOT)
//   |>   → TK_PIPE_OP   (not BITOR + GT)
//   |~   → TK_PIPE_CAST (not BITOR + BITNOT)
//   !=   → TK_NEQ       (not NOT + EQ)
//
// All tests compile only if the lexer correctly produces the compound token.
// Incorrect tokenization would cause a parse error or wrong semantics.

@description("WP-1.1-C: compound-token longest-match tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.compound_tokens_test;

// --- 1. ?? (null coalescence) — lexer must produce one token, not two ---
fn testNullCoalescence(): int64 {
  var a: pchar := 0;
  var b: pchar := "hello"c;
  var result: pchar := a ?? b;
  if (result == 0) { PrintLn("FAIL: ?? returned null"); return 1; }
  PrintLn("OK: ?? null coalescence");
  return 0;
}

// --- 2. .. (range in for-loop) — TK_DOTDOT not two TK_DOT ---
fn testDotDotRange(): int64 {
  var sum: int64 := 0;
  for i in range(1, 5) {
    sum := sum + i;
  }
  // 1+2+3+4 = 10
  if (sum != 10) {
    Print("FAIL: range sum expected 10, got ");
    PrintLn(StrFromInt(sum));
    return 1;
  }
  PrintLn("OK: .. range token");
  return 0;
}

// --- 3. != (not-equal) — TK_NEQ not TK_NOT + TK_EQ ---
fn testNotEqual(): int64 {
  var x: int64 := 3;
  var y: int64 := 5;
  if (x != y) {
    PrintLn("OK: != not-equal token");
    return 0;
  }
  PrintLn("FAIL: != token");
  return 1;
}

// --- 4. |> (pipe-forward) — TK_PIPE_OP not TK_BITOR + TK_GT ---
fn double(n: int64): int64 { return n * 2; }
fn addOne(n: int64): int64 { return n + 1; }

fn testPipeForward(): int64 {
  // 3 |> double |> addOne = double(3) |> addOne = addOne(6) = 7
  var result: int64 := 3 |> double |> addOne;
  if (result != 7) {
    Print("FAIL: |> pipe result expected 7, got ");
    PrintLn(StrFromInt(result));
    return 1;
  }
  PrintLn("OK: |> pipe-forward token");
  return 0;
}

// --- 5. |~ (pipe-cast / NOR) — TK_PIPE_CAST not TK_BITOR + TK_BITNOT ---
// Currently |~ is TK_NOR (bitwise NOR). Verify it parses as a single token.
fn testPipeCast(): int64 {
  var a: int64 := 6;   // 0b0110
  var b: int64 := 3;   // 0b0011
  // a |~ b  = NOT (a | b) = NOT 7 = ...11111000 (in two's complement)
  var r: int64 := a |~ b;
  // r should be ~(a | b) = ~7 = -8 in signed 64-bit
  if (r != -8) {
    Print("FAIL: |~ result expected -8, got ");
    PrintLn(StrFromInt(r));
    return 1;
  }
  PrintLn("OK: |~ pipe-cast/NOR token");
  return 0;
}

// --- 6. Multiple compound tokens in one expression ---
fn testCombined(): int64 {
  var a: int64 := 5;
  var b: int64 := 3;
  // (a != b) evaluates to true (1), ?? on int (identity since non-null)
  var ok: int64 := 0;
  if (a != b) { ok := 1; }
  if (ok == 0) { PrintLn("FAIL: combined test"); return 1; }
  PrintLn("OK: combined compound tokens");
  return 0;
}

// --- 7. Verify . (dot) still works as member access after compound-token code ---
type Point = struct { x: int64; y: int64; }

fn testDotAccess(): int64 {
  var p: Point;
  p.x := 10;
  p.y := 20;
  if (p.x != 10 || p.y != 20) { PrintLn("FAIL: dot member access"); return 1; }
  PrintLn("OK: . dot member access unaffected");
  return 0;
}

pub fn main(): int64 {
  if (testNullCoalescence() != 0) { return 1; }
  if (testDotDotRange()     != 0) { return 1; }
  if (testNotEqual()        != 0) { return 1; }
  if (testPipeForward()     != 0) { return 1; }
  if (testPipeCast()        != 0) { return 1; }
  if (testCombined()        != 0) { return 1; }
  if (testDotAccess()       != 0) { return 1; }
  PrintLn("All WP-1.1-C compound-token tests passed.");
  return 0;
}
