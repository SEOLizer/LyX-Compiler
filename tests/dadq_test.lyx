unit tests.dadq_test;

import std.alloc;
import std.crypto.sha256;
import std.crypto.rand;
import std.crypto.pqc.dadq;

// --- Hilfsfunktionen ---

fn memset8(p: int64, val: int64, len: int64) {
    var i: int64 := 0;
    while (i < len) { poke8(p + i, val & 0xFF); i := i + 1; }
}

fn memeq(a: int64, b: int64, len: int64): int64 {
    var i: int64 := 0;
    while (i < len) {
        if (peek8(a + i) != peek8(b + i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

// --- T-1.1.1: Deterministisch (gleicher Seed -> gleiche pk/sk) ---

fn testDeterministic(): int64 {
    var seed: int64 := alloc(32);
    var pk1:  int64 := alloc(DADQ_PK_LEN);
    var sk1:  int64 := alloc(DADQ_SK_LEN_FULL);
    var pk2:  int64 := alloc(DADQ_PK_LEN);
    var sk2:  int64 := alloc(DADQ_SK_LEN_FULL);
    var rc:   int64 := 0;

    memset8(seed, 0x42, 32);
    dadqKeyGenFull(seed, pk1, sk1);
    dadqKeyGenFull(seed, pk2, sk2);

    if (memeq(pk1, pk2, DADQ_PK_LEN) == 0) {
        PrintLn("FAIL T-1.1.1: pk nicht deterministisch");
        rc := 1;
    }
    if (memeq(sk1, sk2, DADQ_SK_LEN_FULL) == 0) {
        PrintLn("FAIL T-1.1.1: sk nicht deterministisch");
        rc := 1;
    }
    if (rc == 0) { PrintLn("OK   T-1.1.1: Deterministisch"); }

    free(pk1, DADQ_PK_LEN); free(sk1, DADQ_SK_LEN_FULL);
    free(pk2, DADQ_PK_LEN); free(sk2, DADQ_SK_LEN_FULL);
    free(seed, 32);
    return rc;
}

// --- T-1.1.2: Verschiedene Seeds -> verschiedene PKs ---

fn testSeedCollision(): int64 {
    var seed1: int64 := alloc(32);
    var seed2: int64 := alloc(32);
    var pk1:   int64 := alloc(DADQ_PK_LEN);
    var sk1:   int64 := alloc(DADQ_SK_LEN_FULL);
    var pk2:   int64 := alloc(DADQ_PK_LEN);
    var sk2:   int64 := alloc(DADQ_SK_LEN_FULL);
    var rc:    int64 := 0;

    memset8(seed1, 0x11, 32);
    memset8(seed2, 0x22, 32);
    dadqKeyGenFull(seed1, pk1, sk1);
    dadqKeyGenFull(seed2, pk2, sk2);

    if (memeq(pk1, pk2, DADQ_PK_LEN) != 0) {
        PrintLn("FAIL T-1.1.2: Verschiedene Seeds -> gleiche pk (Kollision!)");
        rc := 1;
    }
    if (rc == 0) { PrintLn("OK   T-1.1.2: Seed-Kollisionstest"); }

    free(pk1, DADQ_PK_LEN); free(sk1, DADQ_SK_LEN_FULL);
    free(pk2, DADQ_PK_LEN); free(sk2, DADQ_SK_LEN_FULL);
    free(seed1, 32); free(seed2, 32);
    return rc;
}

// --- T-1.2.1: Dec(sk, Enc(pk, m)) = m  (Korrektheit, 100 Iterationen) ---

fn testRoundtrip(): int64 {
    var seed:  int64 := alloc(32);
    var pk:    int64 := alloc(DADQ_PK_LEN);
    var sk:    int64 := alloc(DADQ_SK_LEN_FULL);
    var m:     int64 := alloc(DADQ_BLOCK_SZ);
    var c_len: int64 := DADQ_BLOCK_SZ + DADQ_OVERHEAD;
    var c:     int64 := alloc(c_len);
    var m2:    int64 := alloc(DADQ_BLOCK_SZ);
    var rc:    int64 := 0;
    var iter:  int64 := 0;
    var dr:    int64 := 0;

    memset8(seed, 0x7F, 32);
    dadqKeyGenFull(seed, pk, sk);

    iter := 0;
    while (iter < 100) {
        RandBytesExact(m, DADQ_BLOCK_SZ);
        dadqEnc(pk, m, DADQ_BLOCK_SZ, c);
        memset8(m2, 0, DADQ_BLOCK_SZ);
        dr := dadqDec(sk, c, c_len, m2);
        if (dr != 0) {
            PrintLn("FAIL T-1.2.1: Dec returned error");
            rc := 1;
        } else {
            if (memeq(m, m2, DADQ_BLOCK_SZ) == 0) {
                PrintLn("FAIL T-1.2.1: Dec(Enc(m)) != m");
                rc := 1;
            }
        }
        iter := iter + 1;
    }
    if (rc == 0) { PrintLn("OK   T-1.2.1: Roundtrip 100 Iterationen"); }

    free(m, DADQ_BLOCK_SZ); free(c, c_len); free(m2, DADQ_BLOCK_SZ);
    free(pk, DADQ_PK_LEN); free(sk, DADQ_SK_LEN_FULL); free(seed, 32);
    return rc;
}

// --- T-1.2.2: Enc(pk, m1) != Enc(pk, m2) fuer m1 != m2 ---

fn testInjectivity(): int64 {
    var seed:  int64 := alloc(32);
    var pk:    int64 := alloc(DADQ_PK_LEN);
    var sk:    int64 := alloc(DADQ_SK_LEN_FULL);
    var m1:    int64 := alloc(DADQ_BLOCK_SZ);
    var m2:    int64 := alloc(DADQ_BLOCK_SZ);
    var c_len: int64 := DADQ_BLOCK_SZ + DADQ_OVERHEAD;
    var c1:    int64 := alloc(c_len);
    var c2:    int64 := alloc(c_len);
    var rc:    int64 := 0;

    memset8(seed, 0xAB, 32);
    dadqKeyGenFull(seed, pk, sk);
    memset8(m1, 0x00, DADQ_BLOCK_SZ);
    memset8(m2, 0xFF, DADQ_BLOCK_SZ);
    dadqEnc(pk, m1, DADQ_BLOCK_SZ, c1);
    dadqEnc(pk, m2, DADQ_BLOCK_SZ, c2);

    if (memeq(c1, c2, c_len) != 0) {
        PrintLn("FAIL T-1.2.2: Enc(m1) == Enc(m2) fuer m1!=m2");
        rc := 1;
    }
    if (rc == 0) { PrintLn("OK   T-1.2.2: Injektivitaet"); }

    free(m1, DADQ_BLOCK_SZ); free(m2, DADQ_BLOCK_SZ);
    free(c1, c_len); free(c2, c_len);
    free(pk, DADQ_PK_LEN); free(sk, DADQ_SK_LEN_FULL); free(seed, 32);
    return rc;
}

// --- T-1.2.3: Enc mit pk1 != pk2 -> verschiedene Ciphertexte ---

fn testCrossKeyEnc(): int64 {
    var seed1: int64 := alloc(32);
    var seed2: int64 := alloc(32);
    var pk1:   int64 := alloc(DADQ_PK_LEN);
    var sk1:   int64 := alloc(DADQ_SK_LEN_FULL);
    var pk2:   int64 := alloc(DADQ_PK_LEN);
    var sk2:   int64 := alloc(DADQ_SK_LEN_FULL);
    var m:     int64 := alloc(DADQ_BLOCK_SZ);
    var c_len: int64 := DADQ_BLOCK_SZ + DADQ_OVERHEAD;
    var c1:    int64 := alloc(c_len);
    var c2:    int64 := alloc(c_len);
    var rc:    int64 := 0;

    memset8(seed1, 0x11, 32);
    memset8(seed2, 0x22, 32);
    dadqKeyGenFull(seed1, pk1, sk1);
    dadqKeyGenFull(seed2, pk2, sk2);
    memset8(m, 0x55, DADQ_BLOCK_SZ);
    dadqEnc(pk1, m, DADQ_BLOCK_SZ, c1);
    dadqEnc(pk2, m, DADQ_BLOCK_SZ, c2);

    if (memeq(c1, c2, c_len) != 0) {
        PrintLn("FAIL T-1.2.3: Enc mit pk1!=pk2 -> gleiche Ciphertexte");
        rc := 1;
    }
    if (rc == 0) { PrintLn("OK   T-1.2.3: Cross-Key Enc"); }

    free(m, DADQ_BLOCK_SZ); free(c1, c_len); free(c2, c_len);
    free(pk1, DADQ_PK_LEN); free(sk1, DADQ_SK_LEN_FULL);
    free(pk2, DADQ_PK_LEN); free(sk2, DADQ_SK_LEN_FULL);
    free(seed1, 32); free(seed2, 32);
    return rc;
}

// --- T-1.2.4: Dec mit falschem sk schlaegt fehl ---

fn testWrongKey(): int64 {
    var seed1: int64 := alloc(32);
    var seed2: int64 := alloc(32);
    var pk1:   int64 := alloc(DADQ_PK_LEN);
    var sk1:   int64 := alloc(DADQ_SK_LEN_FULL);
    var pk2:   int64 := alloc(DADQ_PK_LEN);
    var sk2:   int64 := alloc(DADQ_SK_LEN_FULL);
    var m:     int64 := alloc(DADQ_BLOCK_SZ);
    var c_len: int64 := DADQ_BLOCK_SZ + DADQ_OVERHEAD;
    var c:     int64 := alloc(c_len);
    var m2:    int64 := alloc(DADQ_BLOCK_SZ);
    var dr:    int64 := 0;
    var rc:    int64 := 0;

    memset8(seed1, 0x33, 32);
    memset8(seed2, 0x44, 32);
    dadqKeyGenFull(seed1, pk1, sk1);
    dadqKeyGenFull(seed2, pk2, sk2);
    memset8(m, 0x77, DADQ_BLOCK_SZ);
    dadqEnc(pk1, m, DADQ_BLOCK_SZ, c);
    memset8(m2, 0, DADQ_BLOCK_SZ);
    dr := dadqDec(sk2, c, c_len, m2);

    if (dr == 0) {
        if (memeq(m, m2, DADQ_BLOCK_SZ) != 0) {
            PrintLn("FAIL T-1.2.4: Dec mit falschem SK lieferte korrekten Klartext!");
            rc := 1;
        } else {
            PrintLn("WARN T-1.2.4: Dec ok aber falscher Plaintext (Konsistenzcheck schwach)");
        }
    } else {
        PrintLn("OK   T-1.2.4: Dec mit falschem SK -> Fehler");
    }

    free(m, DADQ_BLOCK_SZ); free(c, c_len); free(m2, DADQ_BLOCK_SZ);
    free(pk1, DADQ_PK_LEN); free(sk1, DADQ_SK_LEN_FULL);
    free(pk2, DADQ_PK_LEN); free(sk2, DADQ_SK_LEN_FULL);
    free(seed1, 32); free(seed2, 32);
    return rc;
}

// --- T-1.3: Exhaustiver Test fuer 1-Byte-Nachrichten (alle 256 Werte) ---

fn testExhaustive1Byte(): int64 {
    var seed:  int64 := alloc(32);
    var pk:    int64 := alloc(DADQ_PK_LEN);
    var sk:    int64 := alloc(DADQ_SK_LEN_FULL);
    var m:     int64 := alloc(1);
    var c_len: int64 := 1 + DADQ_OVERHEAD;
    var c:     int64 := alloc(c_len);
    var m2:    int64 := alloc(1);
    var rc:    int64 := 0;
    var val:   int64 := 0;
    var dr:    int64 := 0;

    memset8(seed, 0xDE, 32);
    dadqKeyGenFull(seed, pk, sk);

    val := 0;
    while (val < 256) {
        poke8(m, val & 0xFF);
        dadqEnc(pk, m, 1, c);
        poke8(m2, 0);
        dr := dadqDec(sk, c, c_len, m2);
        if (dr != 0) { rc := 1; }
        if (peek8(m2) != (val & 0xFF)) { rc := 1; }
        val := val + 1;
    }

    if (rc == 0) {
        PrintLn("OK   T-1.3: Exhaustiver 1-Byte-Test (256/256 korrekt)");
    } else {
        PrintLn("FAIL T-1.3: Exhaustiver 1-Byte-Test fehlgeschlagen");
    }

    free(m, 1); free(c, c_len); free(m2, 1);
    free(pk, DADQ_PK_LEN); free(sk, DADQ_SK_LEN_FULL); free(seed, 32);
    return rc;
}

// --- T-1.2.5: Probabilistisches Enc (gleiche Msg, gleicher pk -> verschiedene c) ---

fn testProbabilisticEnc(): int64 {
    var seed:  int64 := alloc(32);
    var pk:    int64 := alloc(DADQ_PK_LEN);
    var sk:    int64 := alloc(DADQ_SK_LEN_FULL);
    var m:     int64 := alloc(DADQ_BLOCK_SZ);
    var c_len: int64 := DADQ_BLOCK_SZ + DADQ_OVERHEAD;
    var c1:    int64 := alloc(c_len);
    var c2:    int64 := alloc(c_len);
    var rc:    int64 := 0;

    memset8(seed, 0xCA, 32);
    dadqKeyGenFull(seed, pk, sk);
    memset8(m, 0xBE, DADQ_BLOCK_SZ);
    dadqEnc(pk, m, DADQ_BLOCK_SZ, c1);
    dadqEnc(pk, m, DADQ_BLOCK_SZ, c2);

    if (memeq(c1, c2, c_len) != 0) {
        PrintLn("FAIL T-1.2.5: Enc ist deterministisch (Sicherheitsproblem!)");
        rc := 1;
    }
    if (rc == 0) { PrintLn("OK   T-1.2.5: Probabilistisches Enc"); }

    free(m, DADQ_BLOCK_SZ); free(c1, c_len); free(c2, c_len);
    free(pk, DADQ_PK_LEN); free(sk, DADQ_SK_LEN_FULL); free(seed, 32);
    return rc;
}

// --- Main ---

fn main(): int64 {
    PrintLn("=== DADQ Phase 1 Korrektheitstests ===");
    var fail: int64 := 0;

    fail := fail + testDeterministic();
    fail := fail + testSeedCollision();
    fail := fail + testRoundtrip();
    fail := fail + testInjectivity();
    fail := fail + testCrossKeyEnc();
    fail := fail + testWrongKey();
    fail := fail + testExhaustive1Byte();
    fail := fail + testProbabilisticEnc();

    PrintLn("===================================");
    if (fail == 0) {
        PrintLn("Alle Tests bestanden.");
    } else {
        PrintLn("FEHLER: Einige Tests fehlgeschlagen.");
    }
    return fail;
}
