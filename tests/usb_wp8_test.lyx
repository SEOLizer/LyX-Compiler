// tests/usb_wp8_test.lyx
// WP-8: Erweiterungen — ISO-Transfers, Claim-Manager, URB-Pool
//
// WP-8.1 ISO-Transfers (hardware-unabhängig):
//   Layout, Alloc/Free, Init, Paket-Accessoren, Fehlerbehandlung
// WP-8.2 Claim-Manager:
//   AC-1: Doppeltes Claim ist idempotent
//   AC-2: Release → Claim ohne Fehler
// WP-8.3 URB-Pool:
//   Layout-Verifikation, Init mit fd=-1, Buffer-Zugriff, Resubmit-Guard

unit tests.usb_wp8_test;

import std.hardware.usb_iso;
import std.hardware.usb_ifc_mgr;
import std.hardware.usb_urb_pool;
import std.hardware.usb_interrupt;
import std.alloc;

// ============================================================
// WP-8.1: ISO-Konstanten
// ============================================================
fn testIsoConstants(): int64 {
  var failed: int64 := 0;
  if (USB_ISO_PACKET_SIZE != 12)   { PrintLn("FAIL: ISO_PACKET_SIZE != 12"); failed:=failed+1; }
  if (ISO_PKT_ARRAY_OFF   != 56)   { PrintLn("FAIL: PKT_ARRAY_OFF != 56");   failed:=failed+1; }
  if (ISO_PKT_OFF_LENGTH        != 0) { PrintLn("FAIL: PKT LENGTH off"); failed:=failed+1; }
  if (ISO_PKT_OFF_ACTUAL_LENGTH != 4) { PrintLn("FAIL: PKT ACTUAL off"); failed:=failed+1; }
  if (ISO_PKT_OFF_STATUS        != 8) { PrintLn("FAIL: PKT STATUS off"); failed:=failed+1; }
  if (failed == 0) { PrintLn("OK: ISO constants"); }
  return failed;
}

// ============================================================
// WP-8.1: UsbAllocIsoUrb / UsbFreeIsoUrb
// ============================================================
fn testIsoAllocFree(): int64 {
  var num: int64 := 3;
  var urb: int64 := UsbAllocIsoUrb(num);
  if (urb == 0) { PrintLn("FAIL: UsbAllocIsoUrb returned 0"); return 1; }

  // Total bytes = 56 + 3*12 = 92 → alle 0
  var failed: int64 := 0;
  var total: int64 := 56 + num * 12;
  var i: int64 := 0;
  while (i < total) {
    if (peek8(urb + i) != 0) {
      PrintLn("FAIL: ISO URB not zeroed");
      failed := failed + 1;
      break;
    }
    i := i + 1;
  }

  UsbFreeIsoUrb(urb, num);
  if (failed == 0) { PrintLn("OK: UsbAllocIsoUrb zeroed + freed"); }
  return failed;
}

// ============================================================
// WP-8.1: UsbInitIsoRead — Felder und Paket-Deskriptoren korrekt
// ============================================================
fn testIsoInit(): int64 {
  var num: int64 := 4;
  var urb: int64 := UsbAllocIsoUrb(num);
  var fakeBuffer: int64 := 0x5A5A5A5A;
  var failed: int64 := 0;

  UsbInitIsoRead(urb, 0x84, fakeBuffer, 192, num);

  // URB-Felder
  if (peek8(urb + URB_OFF_TYPE) != 0) {
    PrintLn("FAIL: type != ISO(0)"); failed:=failed+1;
  }
  if (peek8(urb + URB_OFF_ENDPOINT) != 0x84) {
    PrintLn("FAIL: endpoint != 0x84"); failed:=failed+1;
  }
  if (peek64(urb + URB_OFF_BUFFER) != fakeBuffer) {
    PrintLn("FAIL: buffer mismatch"); failed:=failed+1;
  }
  // buffer_length = 192 * 4 = 768
  if ((peek32(urb + URB_OFF_BUFFER_LENGTH) & 0xFFFFFFFF) != 768) {
    PrintLn("FAIL: buffer_length != 768"); failed:=failed+1;
  }
  // number_of_packets = 4
  if ((peek32(urb + URB_OFF_NUM_PACKETS) & 0xFFFFFFFF) != 4) {
    PrintLn("FAIL: num_packets != 4"); failed:=failed+1;
  }

  // Paket-Deskriptoren: length=192, actual=0, status=0
  var i: int64 := 0;
  while (i < num) {
    var pkt: int64 := urb + ISO_PKT_ARRAY_OFF + i * USB_ISO_PACKET_SIZE;
    if ((peek32(pkt) & 0xFFFFFFFF) != 192) {
      PrintLn("FAIL: packet length != 192"); failed:=failed+1;
    }
    if ((peek32(pkt + 4) & 0xFFFFFFFF) != 0) {
      PrintLn("FAIL: packet actual_len != 0"); failed:=failed+1;
    }
    if ((peek32(pkt + 8) & 0xFFFFFFFF) != 0) {
      PrintLn("FAIL: packet status != 0"); failed:=failed+1;
    }
    i := i + 1;
  }

  UsbFreeIsoUrb(urb, num);
  if (failed == 0) { PrintLn("OK: UsbInitIsoRead struct layout"); }
  return failed;
}

// ============================================================
// WP-8.1: Paket-Accessoren nach manueller Befüllung
// ============================================================
fn testIsoPacketAccessors(): int64 {
  var num: int64 := 2;
  var urb: int64 := UsbAllocIsoUrb(num);
  var failed: int64 := 0;

  // Paket 0: len=512, actual=256, status=0
  var pkt0: int64 := urb + ISO_PKT_ARRAY_OFF;
  poke32(pkt0,     512);
  poke32(pkt0 + 4, 256);
  poke32(pkt0 + 8, 0);

  // Paket 1: len=512, actual=0, status=-5 (Fehler)
  var pkt1: int64 := urb + ISO_PKT_ARRAY_OFF + USB_ISO_PACKET_SIZE;
  poke32(pkt1,     512);
  poke32(pkt1 + 4, 0);
  poke32(pkt1 + 8, -5 & 0xFFFFFFFF);

  if (UsbIsoPacketLen(urb, 0) != 512)     { PrintLn("FAIL: pkt0 len");    failed:=failed+1; }
  if (UsbIsoPacketActualLen(urb, 0) != 256){ PrintLn("FAIL: pkt0 actual"); failed:=failed+1; }
  if (UsbIsoPacketStatus(urb, 0) != 0)    { PrintLn("FAIL: pkt0 status"); failed:=failed+1; }
  if (UsbIsoPacketLen(urb, 1) != 512)     { PrintLn("FAIL: pkt1 len");    failed:=failed+1; }
  if (UsbIsoPacketActualLen(urb, 1) != 0) { PrintLn("FAIL: pkt1 actual"); failed:=failed+1; }
  if (UsbIsoPacketStatus(urb, 1) != -5)   { PrintLn("FAIL: pkt1 status"); failed:=failed+1; }

  // error_count aus URB
  poke32(urb + URB_OFF_ERROR_COUNT, 1);
  if (UsbIsoErrorCount(urb) != 1) { PrintLn("FAIL: error_count"); failed:=failed+1; }

  UsbFreeIsoUrb(urb, num);
  if (failed == 0) { PrintLn("OK: ISO packet accessors (AC-3/AC-4)"); }
  return failed;
}

// ============================================================
// WP-8.1: fd=-1 → SubmitIsoRead gibt 0 zurück
// ============================================================
fn testIsoInvalidFd(): int64 {
  var buf: int64 := alloc(512);
  var r: int64 := UsbSubmitIsoRead(-1, 0x84, buf, 128, 4);
  free(buf, 512);
  if (r != 0) {
    PrintLn("FAIL: SubmitIsoRead(fd=-1) should return 0");
    return 1;
  }
  PrintLn("OK: ISO fd=-1 → return 0");
  return 0;
}

// ============================================================
// WP-8.2: Claim-Manager — Alloc/Free, Felder
// ============================================================
fn testIfcMgrAllocFree(): int64 {
  var mgr: int64 := UsbIfcMgrAlloc(7, 2);
  if (mgr == 0) { PrintLn("FAIL: UsbIfcMgrAlloc returned 0"); return 1; }
  var failed: int64 := 0;
  if (UsbIfcDevFd(mgr) != 7)    { PrintLn("FAIL: dev_fd != 7");    failed:=failed+1; }
  if (UsbIfcNum(mgr) != 2)      { PrintLn("FAIL: ifc_num != 2");   failed:=failed+1; }
  if (UsbIfcIsClaimed(mgr) != 0){ PrintLn("FAIL: is_claimed != 0"); failed:=failed+1; }
  UsbIfcMgrFree(mgr);
  if (failed == 0) { PrintLn("OK: UsbIfcMgr alloc/fields"); }
  return failed;
}

// ============================================================
// WP-8.2 AC-1: Doppeltes Acquire ist idempotent
// Verifizierung: is_claimed bleibt 1 nach zweitem Acquire-Aufruf.
// (ioctl schlägt mit fd=-1 fehl → Acquire gibt 0)
// Mit fd=-1 und Tracking: is_claimed-Feld wird nach erstem fehlschlagenden
// ioctl auf 0 belassen. Das ist korrekt: idempotent bezüglich des Zustands.
// ============================================================
fn testIfcAcquireIdempotent(): int64 {
  // Wir simulieren einen bereits geclaimten Manager (manuell is_claimed=1 setzen)
  var mgr: int64 := UsbIfcMgrAlloc(5, 0);
  var failed: int64 := 0;

  // Manuell als geclaimt markieren (simuliert erfolgreichen ersten Claim)
  poke64(mgr + 16, 1);

  // Zweites Acquire: is_claimed=1 → No-op, gibt 1 zurück ohne ioctl
  var r: int64 := UsbIfcAcquire(mgr);
  if (r != 1) { PrintLn("FAIL: second Acquire should return 1"); failed:=failed+1; }
  if (UsbIfcIsClaimed(mgr) != 1) {
    PrintLn("FAIL: is_claimed should remain 1 after second Acquire");
    failed:=failed+1;
  }

  UsbIfcMgrFree(mgr);
  if (failed == 0) { PrintLn("OK: double Acquire is idempotent (AC-1)"); }
  return failed;
}

// ============================================================
// WP-8.2 AC-2: Release → Acquire funktioniert
// ============================================================
fn testIfcReleaseAcquireCycle(): int64 {
  var mgr: int64 := UsbIfcMgrAlloc(5, 0);
  var failed: int64 := 0;

  // Manuell als geclaimt markieren
  poke64(mgr + 16, 1);
  if (UsbIfcIsClaimed(mgr) != 1) {
    PrintLn("FAIL: setup: is_claimed should be 1");
    failed := failed + 1;
  }

  // Release: ioctl schlägt mit fd=5 fehl (kein echtes Gerät), aber is_claimed wird 0
  UsbIfcRelease(mgr);
  if (UsbIfcIsClaimed(mgr) != 0) {
    PrintLn("FAIL: after Release: is_claimed should be 0");
    failed := failed + 1;
  }

  // Release nochmal (No-op wenn nicht geclaimt)
  UsbIfcRelease(mgr);
  if (UsbIfcIsClaimed(mgr) != 0) {
    PrintLn("FAIL: second Release: is_claimed should remain 0");
    failed := failed + 1;
  }

  UsbIfcMgrFree(mgr);
  if (failed == 0) { PrintLn("OK: Release→state=0, double Release=no-op (AC-2)"); }
  return failed;
}

// ============================================================
// WP-8.3: Pool-Konstanten
// ============================================================
fn testPoolConstants(): int64 {
  var failed: int64 := 0;
  if (USB_URB_POOL_COUNT      != 4)   { PrintLn("FAIL: POOL_COUNT");      failed:=failed+1; }
  if (USB_URB_POOL_BUF_SIZE   != 64)  { PrintLn("FAIL: POOL_BUF_SIZE");   failed:=failed+1; }
  if (USB_URB_POOL_HDR_SIZE   != 32)  { PrintLn("FAIL: POOL_HDR_SIZE");   failed:=failed+1; }
  if (USB_URB_POOL_ENTRY_SIZE != 136) { PrintLn("FAIL: POOL_ENTRY_SIZE"); failed:=failed+1; }
  if (USB_URB_POOL_TOTAL_SIZE != 576) { PrintLn("FAIL: POOL_TOTAL_SIZE"); failed:=failed+1; }
  if (failed == 0) { PrintLn("OK: URB upool constants"); }
  return failed;
}

// ============================================================
// WP-8.3: Alloc / Header-Felder
// ============================================================
fn testPoolAllocFree(): int64 {
  var upool: int64 := UsbUrbPoolAlloc(9, 0x81, 32);
  if (upool == 0) { PrintLn("FAIL: UsbUrbPoolAlloc returned 0"); return 1; }
  var failed: int64 := 0;
  if (peek64(upool) != 9)       { PrintLn("FAIL: upool dev_fd != 9");    failed:=failed+1; }
  if (peek64(upool + 8) != 0x81){ PrintLn("FAIL: upool endpoint != 0x81");failed:=failed+1;}
  if (peek64(upool + 16) != 32) { PrintLn("FAIL: upool buf_size != 32"); failed:=failed+1; }
  UsbUrbPoolFree(upool);
  if (failed == 0) { PrintLn("OK: URB upool alloc/free/header"); }
  return failed;
}

// ============================================================
// WP-8.3: Buffer-Adressen korrekt berechnet
// ============================================================
fn testPoolBufferAddresses(): int64 {
  var upool: int64 := UsbUrbPoolAlloc(3, 0x81, 64);
  var failed: int64 := 0;

  var i: int64 := 0;
  while (i < 4) {
    var entBase: int64 := upool + 32 + i * 136;
    var bufAddr: int64 := UsbUrbPoolGetBuffer(upool, i);
    // Buffer liegt bei entryBase + 56
    if (bufAddr != entBase + 56) {
      PrintLn("FAIL: upool buffer address wrong");
      failed := failed + 1;
    }
    i := i + 1;
  }

  UsbUrbPoolFree(upool);
  if (failed == 0) { PrintLn("OK: upool buffer addresses (entBase+56)"); }
  return failed;
}

// ============================================================
// WP-8.3 AC-1: Init mit fd=-1 → 0 eingereicht (kein Crash)
// ============================================================
fn testPoolInitInvalidFd(): int64 {
  var upool: int64 := UsbUrbPoolAlloc(-1, 0x81, 8);
  var submitted: int64 := UsbUrbPoolInit(upool);
  UsbUrbPoolFree(upool);
  if (submitted != 0) {
    PrintLn("FAIL: Init with fd=-1 should submit 0 URBs");
    return 1;
  }
  PrintLn("OK: upool Init fd=-1 → 0 submitted, no crash");
  return 0;
}

// ============================================================
// WP-8.3: GetInUse nach Init-Fehler = 0 (submit fehlgeschlagen)
// ============================================================
fn testPoolInUseAfterFailedInit(): int64 {
  var upool: int64 := UsbUrbPoolAlloc(-1, 0x81, 8);
  UsbUrbPoolInit(upool);
  var failed: int64 := 0;
  var i: int64 := 0;
  while (i < 4) {
    if (UsbUrbPoolGetInUse(upool, i) != 0) {
      PrintLn("FAIL: in_use should be 0 after failed submit");
      failed := failed + 1;
    }
    i := i + 1;
  }
  UsbUrbPoolFree(upool);
  if (failed == 0) { PrintLn("OK: upool in_use=0 after failed submit"); }
  return failed;
}

// ============================================================
// WP-8.3 AC-3: Resubmit-Guard — idx out-of-range → -1
// ============================================================
fn testPoolResubmitGuard(): int64 {
  var upool: int64 := UsbUrbPoolAlloc(-1, 0x81, 8);
  var failed: int64 := 0;
  if (UsbUrbPoolResubmit(upool, -1) != -1) { PrintLn("FAIL: idx=-1"); failed:=failed+1; }
  if (UsbUrbPoolResubmit(upool, 4)  != -1) { PrintLn("FAIL: idx=4");  failed:=failed+1; }
  UsbUrbPoolFree(upool);
  if (failed == 0) { PrintLn("OK: upool resubmit guard (idx -1/4 → -1)"); }
  return failed;
}

fn main(): int64 {
  var failed: int64 := 0;

  // WP-8.1: ISO
  failed := failed + testIsoConstants();
  failed := failed + testIsoAllocFree();
  failed := failed + testIsoInit();
  failed := failed + testIsoPacketAccessors();
  failed := failed + testIsoInvalidFd();

  // WP-8.2: Claim-Manager
  failed := failed + testIfcMgrAllocFree();
  failed := failed + testIfcAcquireIdempotent();
  failed := failed + testIfcReleaseAcquireCycle();

  // WP-8.3: URB-Pool
  failed := failed + testPoolConstants();
  failed := failed + testPoolAllocFree();
  failed := failed + testPoolBufferAddresses();
  failed := failed + testPoolInitInvalidFd();
  failed := failed + testPoolInUseAfterFailedInit();
  failed := failed + testPoolResubmitGuard();

  if (failed != 0) { PrintLn("FAILED"); return 1; }
  PrintLn("ALL PASSED");
  return 0;
}
