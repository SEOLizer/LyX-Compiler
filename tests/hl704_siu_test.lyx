// tests/hl704_siu_test.lyx — WP-HL7-04 Scheduling: SIU^S12..S26 (45 tests)
unit tests.hl704_siu_test;

import std.hl7.scheduling;
import std.hl7.core;
import std.alloc;
import std.io;

fn strEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
        if (peek8(a + i) != peek8(b + i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

fn contains(hay: int64, hayLen: int64, needle: int64, needleLen: int64): int64 {
    var i: int64 := 0;
    while (i <= hayLen - needleLen) {
        if (strEq(hay + i, needleLen, needle, needleLen)) { return 1; }
        i := i + 1;
    }
    return 0;
}

fn pass(n: int64) { Print("PASS "); PrintLn(n); }
fn fail(n: int64) { Print("FAIL "); PrintLn(n); }
fn check(n: int64, ok: int64) { if (ok == 1) { pass(n); } else { fail(n); } }

fn main() {
    var sch:   int64 := alloc(HL7_SCH_SIZE);
    var ais:   int64 := alloc(HL7_AIS_SIZE);
    var aig:   int64 := alloc(HL7_AIG_SIZE);
    var ail:   int64 := alloc(HL7_AIL_SIZE);
    var appt:  int64 := alloc(HL7_APPT_SIZE);
    var appt2: int64 := alloc(HL7_APPT_SIZE);
    var out:   int64 := alloc(4096);

    // ── Tests 1-9: SCH segment parsing ───────────────────────────────────────
    // "SCH|A001|F001|||||||60||20260615090000||||||||||||||Booked"
    // f1=A001  f2=F001  f9=60  f11=20260615090000  f25=Booked
    // length = 58 chars
    {
        var seg: int64 := "SCH|A001|F001|||||||60||20260615090000||||||||||||||Booked"c as int64;
        var slen: int64 := 58;
        Hl7SchParse(seg, slen, sch);

        // Test 1: SCH-1 = "A001"
        {
            var p: int64 := peek64(sch + HL7_SCH_PLACER);
            var l: int64 := peek64(sch + HL7_SCH_PLACER_LEN);
            var exp: int64 := "A001"c as int64;
            check(1, strEq(p, l, exp, 4));
        }

        // Test 2: SCH-2 = "F001"
        {
            var p: int64 := peek64(sch + HL7_SCH_FILLER);
            var l: int64 := peek64(sch + HL7_SCH_FILLER_LEN);
            var exp: int64 := "F001"c as int64;
            check(2, strEq(p, l, exp, 4));
        }

        // Test 3: SCH-9 duration = "60"
        {
            var p: int64 := peek64(sch + HL7_SCH_DURATION);
            var l: int64 := peek64(sch + HL7_SCH_DURATION_LEN);
            var exp: int64 := "60"c as int64;
            check(3, strEq(p, l, exp, 2));
        }

        // Test 4: SCH-11 start datetime = "20260615090000"
        {
            var p: int64 := peek64(sch + HL7_SCH_START_DT);
            var l: int64 := peek64(sch + HL7_SCH_START_DT_LEN);
            var exp: int64 := "20260615090000"c as int64;
            check(4, strEq(p, l, exp, 14));
        }

        // Test 5: SCH-25 status = "Booked"
        {
            var p: int64 := peek64(sch + HL7_SCH_STATUS);
            var l: int64 := peek64(sch + HL7_SCH_STATUS_LEN);
            var exp: int64 := "Booked"c as int64;
            check(5, strEq(p, l, exp, 6));
        }

        // Test 6: HL7_SCH_SIZE = 128
        check(6, HL7_SCH_SIZE == 128);
    }

    // Test 7: Short SCH "SCH|B001" (8 chars) — SCH-1 = "B001", no crash
    {
        var seg: int64 := "SCH|B001"c as int64;
        var slen: int64 := 8;
        Hl7SchParse(seg, slen, sch);
        var p: int64 := peek64(sch + HL7_SCH_PLACER);
        var l: int64 := peek64(sch + HL7_SCH_PLACER_LEN);
        var exp: int64 := "B001"c as int64;
        check(7, strEq(p, l, exp, 4));
    }

    // Test 8: SCH-2 absent in short segment → length = 0
    {
        var seg: int64 := "SCH|B001"c as int64;
        var slen: int64 := 8;
        Hl7SchParse(seg, slen, sch);
        check(8, peek64(sch + HL7_SCH_FILLER_LEN) == 0);
    }

    // Test 9: SCH-25 absent in short segment → length = 0
    {
        var seg: int64 := "SCH|B001"c as int64;
        var slen: int64 := 8;
        Hl7SchParse(seg, slen, sch);
        check(9, peek64(sch + HL7_SCH_STATUS_LEN) == 0);
    }

    // ── Tests 10-16: AIS / AIG / AIL segment parsing ─────────────────────────

    // Test 10: AIS-3 service = "CONS^Consultation^L" (19 chars)
    // "AIS|1||CONS^Consultation^L" — 26 chars
    {
        var seg: int64 := "AIS|1||CONS^Consultation^L"c as int64;
        var slen: int64 := 26;
        Hl7AisParse(seg, slen, ais);
        var p: int64 := peek64(ais + HL7_AIS_SERVICE);
        var l: int64 := peek64(ais + HL7_AIS_SERVICE_LEN);
        var exp: int64 := "CONS^Consultation^L"c as int64;
        check(10, strEq(p, l, exp, 19));
    }

    // Test 11: HL7_AIS_SIZE = 48
    check(11, HL7_AIS_SIZE == 48);

    // Test 12: AIG-3 resource = "DR001^Dr Smith^L" (16 chars)
    // "AIG|1||DR001^Dr Smith^L|Physician" — 33 chars
    {
        var seg: int64 := "AIG|1||DR001^Dr Smith^L|Physician"c as int64;
        var slen: int64 := 33;
        Hl7AigParse(seg, slen, aig);
        var p: int64 := peek64(aig + HL7_AIG_RESOURCE);
        var l: int64 := peek64(aig + HL7_AIG_RESOURCE_LEN);
        var exp: int64 := "DR001^Dr Smith^L"c as int64;
        check(12, strEq(p, l, exp, 16));
    }

    // Test 13: AIG-4 resource type = "Physician" (9 chars)
    {
        var seg: int64 := "AIG|1||DR001^Dr Smith^L|Physician"c as int64;
        var slen: int64 := 33;
        Hl7AigParse(seg, slen, aig);
        var p: int64 := peek64(aig + HL7_AIG_RESTYPE);
        var l: int64 := peek64(aig + HL7_AIG_RESTYPE_LEN);
        var exp: int64 := "Physician"c as int64;
        check(13, strEq(p, l, exp, 9));
    }

    // Test 14: HL7_AIG_SIZE = 48
    check(14, HL7_AIG_SIZE == 48);

    // Test 15: AIL-3 location = "ROOM101^Room 101^L" (18 chars)
    // "AIL|1||ROOM101^Room 101^L" — 25 chars
    {
        var seg: int64 := "AIL|1||ROOM101^Room 101^L"c as int64;
        var slen: int64 := 25;
        Hl7AilParse(seg, slen, ail);
        var p: int64 := peek64(ail + HL7_AIL_LOCATION);
        var l: int64 := peek64(ail + HL7_AIL_LOCATION_LEN);
        var exp: int64 := "ROOM101^Room 101^L"c as int64;
        check(15, strEq(p, l, exp, 18));
    }

    // Test 16: HL7_AIL_SIZE = 32
    check(16, HL7_AIL_SIZE == 32);

    // ── Tests 17-28: Hl7SiuParse S12 full message ────────────────────────────
    // MSH(53)+CR+SCH(58)+CR+PID(19)+CR+AIS(26)+CR+AIG(33)+CR+AIL(25) = 219
    // MSH: "MSH|^~\&|LIS|LAB|KIS|H|20260615||SIU^S12|R001|P|2.5.1"  53 chars
    // SCH: "SCH|A001|F001|||||||60||20260615090000||||||||||||||Booked"  58 chars
    // PID: "PID|1||PAT001^^^KIS"  19 chars
    // AIS: "AIS|1||CONS^Consultation^L"  26 chars
    // AIG: "AIG|1||DR001^Dr Smith^L|Physician"  33 chars
    // AIL: "AIL|1||ROOM101^Room 101^L"  25 chars
    {
        var msg: int64 := "MSH|^~\\&|LIS|LAB|KIS|H|20260615||SIU^S12|R001|P|2.5.1\rSCH|A001|F001|||||||60||20260615090000||||||||||||||Booked\rPID|1||PAT001^^^KIS\rAIS|1||CONS^Consultation^L\rAIG|1||DR001^Dr Smith^L|Physician\rAIL|1||ROOM101^Room 101^L"c as int64;
        var mlen: int64 := 219;
        Hl7SiuParse(msg, mlen, appt);

        // Test 17: ISCANCEL = 0 (S12 is not a cancel event)
        check(17, peek64(appt + HL7_APPT_ISCANCEL) == 0);

        // Test 18: ISDELETE = 0
        check(18, peek64(appt + HL7_APPT_ISDELETE) == 0);

        // Test 19: ISNOSHOW = 0
        check(19, peek64(appt + HL7_APPT_ISNOSHOW) == 0);

        // Test 20: EVENT = "S12"
        {
            var p: int64 := peek64(appt + HL7_APPT_EVENT);
            var l: int64 := peek64(appt + HL7_APPT_EVENT_LEN);
            var exp: int64 := "S12"c as int64;
            check(20, strEq(p, l, exp, 3));
        }

        // Test 21: PLACER = "A001"
        {
            var p: int64 := peek64(appt + HL7_APPT_PLACER);
            var l: int64 := peek64(appt + HL7_APPT_PLACER_LEN);
            var exp: int64 := "A001"c as int64;
            check(21, strEq(p, l, exp, 4));
        }

        // Test 22: FILLER = "F001"
        {
            var p: int64 := peek64(appt + HL7_APPT_FILLER);
            var l: int64 := peek64(appt + HL7_APPT_FILLER_LEN);
            var exp: int64 := "F001"c as int64;
            check(22, strEq(p, l, exp, 4));
        }

        // Test 23: START_DT = "20260615090000"
        {
            var p: int64 := peek64(appt + HL7_APPT_START_DT);
            var l: int64 := peek64(appt + HL7_APPT_START_DT_LEN);
            var exp: int64 := "20260615090000"c as int64;
            check(23, strEq(p, l, exp, 14));
        }

        // Test 24: DURATION = "60"
        {
            var p: int64 := peek64(appt + HL7_APPT_DURATION);
            var l: int64 := peek64(appt + HL7_APPT_DURATION_LEN);
            var exp: int64 := "60"c as int64;
            check(24, strEq(p, l, exp, 2));
        }

        // Test 25: SERVICE = "CONS^Consultation^L" from AIS-3
        {
            var p: int64 := peek64(appt + HL7_APPT_SERVICE);
            var l: int64 := peek64(appt + HL7_APPT_SERVICE_LEN);
            var exp: int64 := "CONS^Consultation^L"c as int64;
            check(25, strEq(p, l, exp, 19));
        }

        // Test 26: PAT_ID = "PAT001" from PID-3.1
        {
            var p: int64 := peek64(appt + HL7_APPT_PAT_ID);
            var l: int64 := peek64(appt + HL7_APPT_PAT_ID_LEN);
            var exp: int64 := "PAT001"c as int64;
            check(26, strEq(p, l, exp, 6));
        }

        // Test 27: STATUS = "Booked" from SCH-25
        {
            var p: int64 := peek64(appt + HL7_APPT_STATUS);
            var l: int64 := peek64(appt + HL7_APPT_STATUS_LEN);
            var exp: int64 := "Booked"c as int64;
            check(27, strEq(p, l, exp, 6));
        }

        // Test 28: HL7_APPT_SIZE = 152
        check(28, HL7_APPT_SIZE == 152);
    }

    // ── Tests 29-35: Cancel / Delete / NoShow detection ──────────────────────
    // Minimal messages: MSH(53)+CR+SCH(13) = 67 chars each
    // "SCH|A001|F001" = 13 chars

    // Test 29: SIU^S15 → ISCANCEL = 1
    {
        var msg: int64 := "MSH|^~\\&|LIS|LAB|KIS|H|20260615||SIU^S15|R001|P|2.5.1\rSCH|A001|F001"c as int64;
        var mlen: int64 := 67;
        Hl7SiuParse(msg, mlen, appt);
        check(29, peek64(appt + HL7_APPT_ISCANCEL) == 1);
    }

    // Test 30: SIU^S15 → ISDELETE = 0
    {
        var msg: int64 := "MSH|^~\\&|LIS|LAB|KIS|H|20260615||SIU^S15|R001|P|2.5.1\rSCH|A001|F001"c as int64;
        var mlen: int64 := 67;
        Hl7SiuParse(msg, mlen, appt);
        check(30, peek64(appt + HL7_APPT_ISDELETE) == 0);
    }

    // Test 31: SIU^S15 → ISNOSHOW = 0
    {
        var msg: int64 := "MSH|^~\\&|LIS|LAB|KIS|H|20260615||SIU^S15|R001|P|2.5.1\rSCH|A001|F001"c as int64;
        var mlen: int64 := 67;
        Hl7SiuParse(msg, mlen, appt);
        check(31, peek64(appt + HL7_APPT_ISNOSHOW) == 0);
    }

    // Test 32: SIU^S17 → ISDELETE = 1
    {
        var msg: int64 := "MSH|^~\\&|LIS|LAB|KIS|H|20260615||SIU^S17|R001|P|2.5.1\rSCH|A001|F001"c as int64;
        var mlen: int64 := 67;
        Hl7SiuParse(msg, mlen, appt);
        check(32, peek64(appt + HL7_APPT_ISDELETE) == 1);
    }

    // Test 33: SIU^S17 → ISCANCEL = 0
    {
        var msg: int64 := "MSH|^~\\&|LIS|LAB|KIS|H|20260615||SIU^S17|R001|P|2.5.1\rSCH|A001|F001"c as int64;
        var mlen: int64 := 67;
        Hl7SiuParse(msg, mlen, appt);
        check(33, peek64(appt + HL7_APPT_ISCANCEL) == 0);
    }

    // Test 34: SIU^S26 → ISNOSHOW = 1
    {
        var msg: int64 := "MSH|^~\\&|LIS|LAB|KIS|H|20260615||SIU^S26|R001|P|2.5.1\rSCH|A001|F001"c as int64;
        var mlen: int64 := 67;
        Hl7SiuParse(msg, mlen, appt);
        check(34, peek64(appt + HL7_APPT_ISNOSHOW) == 1);
    }

    // Test 35: SIU^S26 → ISDELETE = 0 (no-show does not delete appointment)
    {
        var msg: int64 := "MSH|^~\\&|LIS|LAB|KIS|H|20260615||SIU^S26|R001|P|2.5.1\rSCH|A001|F001"c as int64;
        var mlen: int64 := 67;
        Hl7SiuParse(msg, mlen, appt);
        check(35, peek64(appt + HL7_APPT_ISDELETE) == 0);
    }

    // ── Tests 36-42: Hl7SiuWrite output structure + round-trip ───────────────
    {
        var i: int64 := 0;
        while (i < HL7_APPT_SIZE) { poke8(appt + i, 0); i := i + 1; }

        var plStr:  int64 := "A001"c as int64;
        var flStr:  int64 := "F001"c as int64;
        var dtStr:  int64 := "20260615090000"c as int64;
        var durStr: int64 := "60"c as int64;
        var svcStr: int64 := "CONS^Consultation^L"c as int64;
        var evtStr: int64 := "S12"c as int64;

        poke64(appt + HL7_APPT_PLACER, plStr);
        poke64(appt + HL7_APPT_PLACER_LEN, 4);
        poke64(appt + HL7_APPT_FILLER, flStr);
        poke64(appt + HL7_APPT_FILLER_LEN, 4);
        poke64(appt + HL7_APPT_START_DT, dtStr);
        poke64(appt + HL7_APPT_START_DT_LEN, 14);
        poke64(appt + HL7_APPT_DURATION, durStr);
        poke64(appt + HL7_APPT_DURATION_LEN, 2);
        poke64(appt + HL7_APPT_SERVICE, svcStr);
        poke64(appt + HL7_APPT_SERVICE_LEN, 19);
        poke64(appt + HL7_APPT_EVENT, evtStr);
        poke64(appt + HL7_APPT_EVENT_LEN, 3);

        var n: int64 := Hl7SiuWrite(appt, out, 4096);

        // Test 36: output starts with "MSH"
        check(36, peek8(out) == 77 && peek8(out+1) == 83 && peek8(out+2) == 72);

        // Test 37: output contains "SCH" segment tag
        var schTag: int64 := "SCH"c as int64;
        check(37, contains(out, n, schTag, 3));

        // Test 38: output contains "AIS" segment tag
        var aisTag: int64 := "AIS"c as int64;
        check(38, contains(out, n, aisTag, 3));

        // Round-trip: parse written output
        var j: int64 := 0;
        while (j < HL7_APPT_SIZE) { poke8(appt2 + j, 0); j := j + 1; }
        Hl7SiuParse(out, n, appt2);

        // Test 41: round-trip PLACER = "A001"
        {
            var p: int64 := peek64(appt2 + HL7_APPT_PLACER);
            var l: int64 := peek64(appt2 + HL7_APPT_PLACER_LEN);
            check(41, strEq(p, l, plStr, 4));
        }

        // Test 42: round-trip EVENT = "S12"
        {
            var p: int64 := peek64(appt2 + HL7_APPT_EVENT);
            var l: int64 := peek64(appt2 + HL7_APPT_EVENT_LEN);
            check(42, strEq(p, l, evtStr, 3));
        }
    }

    // ── Tests 39-40: S13 / S14 event code parsing ────────────────────────────
    // "MSH|^~\&|LIS|LAB|KIS|H|20260615||SIU^S13|R001|P|2.5.1\rSCH|A001|F001"
    // MSH(53)+CR(1)+SCH(13) = 67 chars

    // Test 39: SIU^S13 EVENT = "S13"
    {
        var msg: int64 := "MSH|^~\\&|LIS|LAB|KIS|H|20260615||SIU^S13|R001|P|2.5.1\rSCH|A001|F001"c as int64;
        var mlen: int64 := 67;
        Hl7SiuParse(msg, mlen, appt);
        var p: int64 := peek64(appt + HL7_APPT_EVENT);
        var l: int64 := peek64(appt + HL7_APPT_EVENT_LEN);
        var exp: int64 := "S13"c as int64;
        check(39, strEq(p, l, exp, 3));
    }

    // Test 40: SIU^S14 EVENT = "S14"
    {
        var msg: int64 := "MSH|^~\\&|LIS|LAB|KIS|H|20260615||SIU^S14|R001|P|2.5.1\rSCH|A001|F001"c as int64;
        var mlen: int64 := 67;
        Hl7SiuParse(msg, mlen, appt);
        var p: int64 := peek64(appt + HL7_APPT_EVENT);
        var l: int64 := peek64(appt + HL7_APPT_EVENT_LEN);
        var exp: int64 := "S14"c as int64;
        check(40, strEq(p, l, exp, 3));
    }

    // ── Tests 43-45: additional checks ───────────────────────────────────────

    // Test 43: SIU^S26 → ISCANCEL = 0 (no-show is not cancel)
    {
        var msg: int64 := "MSH|^~\\&|LIS|LAB|KIS|H|20260615||SIU^S26|R001|P|2.5.1\rSCH|A001|F001"c as int64;
        var mlen: int64 := 67;
        Hl7SiuParse(msg, mlen, appt);
        check(43, peek64(appt + HL7_APPT_ISCANCEL) == 0);
    }

    // Test 44: AIS-1 set ID = "1"
    {
        var seg: int64 := "AIS|1||CONS^Consultation^L"c as int64;
        var slen: int64 := 26;
        Hl7AisParse(seg, slen, ais);
        var p: int64 := peek64(ais + HL7_AIS_SETID);
        var l: int64 := peek64(ais + HL7_AIS_SETID_LEN);
        var exp: int64 := "1"c as int64;
        check(44, strEq(p, l, exp, 1));
    }

    // Test 45: AIG-1 set ID = "1"
    {
        var seg: int64 := "AIG|1||DR001^Dr Smith^L|Physician"c as int64;
        var slen: int64 := 33;
        Hl7AigParse(seg, slen, aig);
        var p: int64 := peek64(aig + HL7_AIG_SETID);
        var l: int64 := peek64(aig + HL7_AIG_SETID_LEN);
        var exp: int64 := "1"c as int64;
        check(45, strEq(p, l, exp, 1));
    }
}
