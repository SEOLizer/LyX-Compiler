// tests/hl700_mllp_test.lyx — WP-HL7-00 MLLP + MSH/ACK tests
unit tests.hl700_mllp_test;

import std.hl7.core;
import std.alloc;
import std.io;

fn strEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
        if (peek8(a + i) != peek8(b + i)) { return 0; }
        i := i + 1;
    }
    return 1;
}

fn pass(n: int64) { Print("PASS "); PrintLn(n); }
fn fail(n: int64) { Print("FAIL "); PrintLn(n); }
fn check(n: int64, ok: int64) { if (ok == 1) { pass(n); } else { fail(n); } }

fn main() {
    var buf:   int64 := alloc(4096);
    var msg:   int64 := alloc(4096);
    var msh:   int64 := alloc(HL7_MSH_SIZE);
    var state: int64 := alloc(HL7_STATE_SIZE);
    var ack:   int64 := alloc(4096);

    Hl7StateInit(state);

    // ── Test 1: MllpFrameWrite returns msgLen + 3 ───────────────────────────
    {
        var body: int64 := "MSH|^~\\&|APP|FAC|RAPP|RFAC|20260101||ADT^A01|C001|P|2.5.1"c as int64;
        var blen: int64 := 59;
        var n: int64 := MllpFrameWrite(buf, 4096, body, blen);
        check(1, n == blen + 3);
    }

    // ── Test 2: MllpFrameWrite starts with VT (0x0B) ────────────────────────
    {
        var body: int64 := "MSH|^~\\&|APP|FAC|RAPP|RFAC|20260101||ADT^A01|C001|P|2.5.1"c as int64;
        var blen: int64 := 59;
        MllpFrameWrite(buf, 4096, body, blen);
        check(2, peek8(buf) == HL7_MLLP_VT);
    }

    // ── Test 3: MllpFrameWrite ends with FS+CR ──────────────────────────────
    {
        var body: int64 := "MSH|^~\\&|APP|FAC|RAPP|RFAC|20260101||ADT^A01|C001|P|2.5.1"c as int64;
        var blen: int64 := 59;
        var n: int64 := MllpFrameWrite(buf, 4096, body, blen);
        check(3, peek8(buf + n - 2) == HL7_MLLP_FS && peek8(buf + n - 1) == HL7_MLLP_CR);
    }

    // ── Test 4: MllpFrameWrite overflow returns -1 ───────────────────────────
    {
        var body: int64 := "MSG"c as int64;
        var n: int64 := MllpFrameWrite(buf, 5, body, 4);
        check(4, n == 0 - 1);
    }

    // ── Test 5: MllpFrameRead extracts body correctly ───────────────────────
    {
        var body: int64 := "MSH|^~\\&|APP|FAC|RAPP|RFAC|20260101||ADT^A01|C001|P|2.5.1"c as int64;
        var blen: int64 := 59;
        MllpFrameWrite(buf, 4096, body, blen);
        var n: int64 := MllpFrameRead(buf, blen + 3, msg, 4096);
        check(5, n == blen);
    }

    // ── Test 6: MllpFrameRead body matches original ─────────────────────────
    {
        var body: int64 := "MSH|^~\\&|APP|FAC|RAPP|RFAC|20260101||ADT^A01|C001|P|2.5.1"c as int64;
        var blen: int64 := 59;
        MllpFrameWrite(buf, 4096, body, blen);
        MllpFrameRead(buf, blen + 3, msg, 4096);
        check(6, strEq(msg, blen, body, blen));
    }

    // ── Test 7: MllpFrameRead returns -1 when no VT found ───────────────────
    {
        var plain: int64 := "MSH|^~\\&|APP|FAC"c as int64;
        var n: int64 := MllpFrameRead(plain, 16, msg, 4096);
        check(7, n == 0 - 1);
    }

    // ── Test 8: MllpFrameRead ignores data before VT ────────────────────────
    {
        // pre-pend some garbage bytes before VT
        poke8(buf, 99);
        poke8(buf+1, 99);
        var body: int64 := "MSH|^~\\&|SEND|SF|RECV|RF|20260115||ORM^O01|X999|P|2.5.1"c as int64;
        var blen: int64 := 57;
        MllpFrameWrite(buf + 2, 4094, body, blen);
        var n: int64 := MllpFrameRead(buf, blen + 5, msg, 4096);
        check(8, n == blen);
    }

    // ── Test 9: Hl7MshParse returns HL7_OK ──────────────────────────────────
    {
        var m: int64 := "MSH|^~\\&|SENDAPP|SENDFAC|RECVAPP|RECVFAC|20260615143000||ADT^A01^ADT_A01|CTRL001|P|2.5.1"c as int64;
        var mlen: int64 := 88;
        var r: int64 := Hl7MshParse(m, mlen, msh);
        check(9, r == HL7_OK);
    }

    // ── Test 10: Hl7MshParse — SendingApp correct ───────────────────────────
    {
        var m: int64 := "MSH|^~\\&|SENDAPP|SENDFAC|RECVAPP|RECVFAC|20260615143000||ADT^A01^ADT_A01|CTRL001|P|2.5.1"c as int64;
        var mlen: int64 := 88;
        Hl7MshParse(m, mlen, msh);
        var sapp: int64 := peek64(msh + HL7_MSH_SEND_APP);
        var sappl: int64 := peek64(msh + HL7_MSH_SEND_APP_LEN);
        var exp: int64 := "SENDAPP"c as int64;
        check(10, strEq(sapp, sappl, exp, 7));
    }

    // ── Test 11: Hl7MshParse — ReceivingApp correct ─────────────────────────
