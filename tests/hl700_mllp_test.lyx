    // ── Test 18: Hl7IsTestMsg returns 1 for proc_id='T' ─────────────────────
    {
        var m: int64 := "MSH|^~\\&|APP|FAC|RAPP|RFAC|20260101||ADT^A01|T001|T|2.5.1"c as int64;
