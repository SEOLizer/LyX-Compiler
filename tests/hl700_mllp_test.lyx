    // ── Test 12: Hl7MshParse — MsgType correct ──────────────────────────────
    {
        var m: int64 := "MSH|^~\\&|SENDAPP|SENDFAC|RECVAPP|RECVFAC|20260615143000||ADT^A01^ADT_A01|CTRL001|P|2.5.1"c as int64;
        var mlen: int64 := 88;
        Hl7MshParse(m, mlen, msh);
        var tptr: int64 := peek64(msh + HL7_MSH_MSG_TYPE);
