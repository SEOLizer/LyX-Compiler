    // ── Test 50: MllpFrameWrite body correct after write ────────────────────
    {
        var body: int64 := "HELLO"c as int64;
        var blen: int64 := 5;
        MllpFrameWrite(buf, 4096, body, blen);
        // bytes 1..5 should match "HELLO"
        check(50, peek8(buf+1)==72 && peek8(buf+2)==69 && peek8(buf+3)==76
                  && peek8(buf+4)==76 && peek8(buf+5)==79);
