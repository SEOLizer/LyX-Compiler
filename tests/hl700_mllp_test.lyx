        var m: int64 := "MSH|^~\\&|SENDAPP|SENDFAC|RECVAPP|RECVFAC|20260615143000||ADT^A01^ADT_A01|CTRL001|P|2.5.1"c as int64;
        var mlen: int64 := 88;
        Hl7MshParse(m, mlen, msh);
        var rapp: int64 := peek64(msh + HL7_MSH_RECV_APP);
        var rappl: int64 := peek64(msh + HL7_MSH_RECV_APP_LEN);
        var exp: int64 := "RECVAPP"c as int64;
        check(11, strEq(rapp, rappl, exp, 7));
