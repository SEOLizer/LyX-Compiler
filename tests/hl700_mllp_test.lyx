        var mlen: int64 := 88;
        Hl7MshParse(m, mlen, msh);
        var ptr: int64 := peek64(msh + HL7_MSH_RECV_FAC);
        var len: int64 := peek64(msh + HL7_MSH_RECV_FAC_LEN);
        var exp: int64 := "RECVFAC"c as int64;
        check(41, strEq(ptr, len, exp, 7));
    }

    // ── Test 42: Hl7MshParse DateTime ───────────────────────────────────────
    {
        var m: int64 := "MSH|^~\\&|SENDAPP|SENDFAC|RECVAPP|RECVFAC|20260615143000||ADT^A01^ADT_A01|CTRL001|P|2.5.1"c as int64;
        var mlen: int64 := 88;
        Hl7MshParse(m, mlen, msh);
        var ptr: int64 := peek64(msh + HL7_MSH_DATETIME);
        var len: int64 := peek64(msh + HL7_MSH_DATETIME_LEN);
        var exp: int64 := "20260615143000"c as int64;
        check(42, strEq(ptr, len, exp, 14));
    }

    // ── Test 43: Hl7MshParse field separator stored ──────────────────────────
    {
        var m: int64 := "MSH|^~\\&|A|B|C|D|20260101||ADT^A01|X|P|2.5.1"c as int64;
        var mlen: int64 := 45;
        Hl7MshParse(m, mlen, msh);
        check(43, peek64(msh + HL7_MSH_FIELD_SEP) == 124);  // '|'
    }

    // ── Test 44: Hl7MshParse component separator stored ─────────────────────
    {
        var m: int64 := "MSH|^~\\&|A|B|C|D|20260101||ADT^A01|X|P|2.5.1"c as int64;
        var mlen: int64 := 45;
        Hl7MshParse(m, mlen, msh);
        check(44, peek64(msh + HL7_MSH_COMP_SEP) == 94);    // '^'
    }

    // ── Test 45: Hl7AckWrite contains ACK in MSH-9 ──────────────────────────
    {
        var m: int64 := "MSH|^~\\&|APP|FAC|RAPP|RFAC|20260101||ORM^O01|X001|P|2.5.1"c as int64;
        var mlen: int64 := 59;
        Hl7MshParse(m, mlen, msh);
        var n: int64 := Hl7AckWrite(msh, "AA"c, 0, ack, 4096);
        // look for "ACK" (65,67,75) in MSH-9 position (after 8th pipe)
        var i: int64 := 0;
        var found: int64 := 0;
        while (i < n - 2 && found == 0) {
            if (peek8(ack+i)==65 && peek8(ack+i+1)==67 && peek8(ack+i+2)==75) {
                found := 1;
            }
            i := i + 1;
        }
        check(45, found);
    }

    // ── Test 46: Hl7MshParse — MSH with ORU message type ───────────────────
    {
        var m: int64 := "MSH|^~\\&|LIS|LAB|HIS|HOSP|20260101||ORU^R01|LAB001|P|2.5.1"c as int64;
        var mlen: int64 := 60;
        Hl7MshParse(m, mlen, msh);
        var tptr: int64 := peek64(msh + HL7_MSH_MSG_TYPE);
        var tlen: int64 := peek64(msh + HL7_MSH_MSG_TYPE_LEN);
        var exp: int64 := "ORU"c as int64;
        check(46, strEq(tptr, tlen, exp, 3));
    }

    // ── Test 47: Hl7MshParse — MSH trigger R01 ──────────────────────────────
    {
        var m: int64 := "MSH|^~\\&|LIS|LAB|HIS|HOSP|20260101||ORU^R01|LAB001|P|2.5.1"c as int64;
        var mlen: int64 := 60;
        Hl7MshParse(m, mlen, msh);
        var tptr: int64 := peek64(msh + HL7_MSH_TRIGGER);
        var tlen: int64 := peek64(msh + HL7_MSH_TRIGGER_LEN);
        var exp: int64 := "R01"c as int64;
        check(47, strEq(tptr, tlen, exp, 3));
    }

    // ── Test 48: Hl7VersionCheck HL7_OK for 2.4 ─────────────────────────────
    {
        var m: int64 := "MSH|^~\\&|A|B|C|D|20260101||ADT^A01|X|P|2.4"c as int64;
