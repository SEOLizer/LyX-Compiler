// tests/if_block_required_test.lyx
// WP-1.3-A + WP-1.3-B: IfStmt Block-Pflicht & Dangling-Else
//
// WP-1.3-A: All valid forms (with blocks) compile and run correctly.
//           Invalid forms (without block) are rejected at parse time.
//
// WP-1.3-B: Dangling-else is structurally impossible because WP-1.3-A
//           mandates blocks on both if- and else-branches.
//           The classic ambiguity:
//             if (a) if (b) x; else y;   // no longer valid — fails at parse time
//                                        // because "if (a)" has no block after it.
//           This file itself is the proof: it compiles only because every if/else
//           uses braces. Any attempt to omit them triggers:
//             "if-branch requires a block: if (cond) { ... }"
//           before the parser can even reach the dangling else position.

@description("WP-1.3-A + WP-1.3-B: if-branch block required, dangling-else impossible")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.if_block_required_test;

// --- 1. Basic if with block ---
fn testBasicIf(): int64 {
  var x: int64 := 5;
  if (x > 0) { return 1; }
  return 0;
}

// --- 2. if/else both with blocks ---
fn testIfElse(): int64 {
  var x: int64 := 5;
  if (x > 10) {
    return 0;
  } else {
    return 1;
  }
}

// --- 3. else if chain ---
fn testElseIfChain(): int64 {
  var x: int64 := 5;
  if (x < 0) {
    return 0;
  } else if (x == 0) {
    return 0;
  } else if (x < 10) {
    return 1;   // expected: 5 hits this
  } else {
    return 0;
  }
}

// --- 4. nested if ---
fn testNestedIf(): int64 {
  var a: int64 := 3;
  var b: int64 := 7;
  if (a < b) {
    if (a > 0) {
      return 1;
    }
  }
  return 0;
}

// --- 5. if with multiple statements in block ---
fn testBlockWithMultipleStmts(): int64 {
  var sum: int64 := 0;
  var x: int64 := 4;
  if (x > 0) {
    sum := sum + 1;
    sum := sum + 2;
    sum := sum + 3;
  }
  if (sum != 6) { return 0; }
  return 1;
}

// --- 6. empty else block ---
fn testEmptyElse(): int64 {
  var x: int64 := 5;
  var hit: int64 := 0;
  if (x > 10) {
    hit := 1;
  } else {
  }
  if (hit != 0) { return 0; }
  return 1;
}

// --- WP-1.3-B: dangling-else proofs ---
// The following tests express all patterns where a dangling-else would be
// ambiguous in a language without mandatory blocks. Since WP-1.3-A enforces
// blocks, these are all well-formed and unambiguous.

// Classic dangling-else scenario written unambiguously with blocks:
//   if (a) { if (b) { x; } else { y; } }   — else belongs to inner if
//   if (a) { if (b) { x; } } else { z; }   — else belongs to outer if
fn testDanglingElseInner(): int64 {
  var a: int64 := 1;
  var b: int64 := 0;
  var result: int64 := 0;
  if (a != 0) {
    if (b != 0) {
      result := 1;   // not reached: b == 0
    } else {
      result := 2;   // reached: inner else
    }
  }
  if (result != 2) { PrintStr("FAIL: dangling-else inner\n"); return 0; }
  return 1;
}

fn testDanglingElseOuter(): int64 {
  var a: int64 := 0;
  var b: int64 := 1;
  var result: int64 := 0;
  if (a != 0) {
    if (b != 0) {
      result := 1;   // not reached: a == 0
    }
  } else {
    result := 3;     // reached: outer else
  }
  if (result != 3) { PrintStr("FAIL: dangling-else outer\n"); return 0; }
  return 1;
}

pub fn main(): int64 {
  if (testBasicIf()                != 1) { PrintStr("FAIL: basic if\n");              return 1; }
  if (testIfElse()                 != 1) { PrintStr("FAIL: if/else\n");               return 1; }
  if (testElseIfChain()            != 1) { PrintStr("FAIL: else if chain\n");         return 1; }
  if (testNestedIf()               != 1) { PrintStr("FAIL: nested if\n");             return 1; }
  if (testBlockWithMultipleStmts() != 1) { PrintStr("FAIL: multi-stmt block\n");      return 1; }
  if (testEmptyElse()              != 1) { PrintStr("FAIL: empty else\n");            return 1; }
  if (testDanglingElseInner()      != 1) { PrintStr("FAIL: dangling-else inner\n");   return 1; }
  if (testDanglingElseOuter()      != 1) { PrintStr("FAIL: dangling-else outer\n");   return 1; }
  PrintStr("All WP-1.3-A + WP-1.3-B if-block/dangling-else tests passed.\n");
  return 0;
}
