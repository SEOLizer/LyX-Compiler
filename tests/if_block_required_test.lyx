// tests/if_block_required_test.lyx
// WP-1.3-A: IfStmt Block-Pflicht
//
// All valid forms compile and run correctly.
// Invalid forms (without block) are rejected at parse time —
// verified by the fact that this file compiles at all.

@description("WP-1.3-A: if-branch block required tests")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit tests.if_block_required_test;

// --- 1. Basic if with block ---
fn testBasicIf(): int64 {
  var x: int64 := 5;
  if (x > 0) { return 1; }
  return 0;
}

// --- 2. if/else both with blocks ---
fn testIfElse(): int64 {
  var x: int64 := 5;
  if (x > 10) {
    return 0;
  } else {
    return 1;
  }
}

// --- 3. else if chain ---
fn testElseIfChain(): int64 {
  var x: int64 := 5;
  if (x < 0) {
    return 0;
  } else if (x == 0) {
    return 0;
  } else if (x < 10) {
    return 1;   // expected: 5 hits this
  } else {
    return 0;
  }
}

// --- 4. nested if ---
fn testNestedIf(): int64 {
  var a: int64 := 3;
  var b: int64 := 7;
  if (a < b) {
    if (a > 0) {
      return 1;
    }
  }
  return 0;
}

// --- 5. if with multiple statements in block ---
fn testBlockWithMultipleStmts(): int64 {
  var sum: int64 := 0;
  var x: int64 := 4;
  if (x > 0) {
    sum := sum + 1;
    sum := sum + 2;
    sum := sum + 3;
  }
  if (sum != 6) { return 0; }
  return 1;
}

// --- 6. empty else block ---
fn testEmptyElse(): int64 {
  var x: int64 := 5;
  var hit: int64 := 0;
  if (x > 10) {
    hit := 1;
  } else {
  }
  if (hit != 0) { return 0; }
  return 1;
}

pub fn main(): int64 {
  if (testBasicIf()                != 1) { PrintStr("FAIL: basic if\n");              return 1; }
  if (testIfElse()                 != 1) { PrintStr("FAIL: if/else\n");               return 1; }
  if (testElseIfChain()            != 1) { PrintStr("FAIL: else if chain\n");         return 1; }
  if (testNestedIf()               != 1) { PrintStr("FAIL: nested if\n");             return 1; }
  if (testBlockWithMultipleStmts() != 1) { PrintStr("FAIL: multi-stmt block\n");      return 1; }
  if (testEmptyElse()              != 1) { PrintStr("FAIL: empty else\n");            return 1; }
  PrintStr("All WP-1.3-A if-block tests passed.\n");
  return 0;
}
