// tests/dadq_phase4.lyx
// DADQ Phase 4 -- Formale Sicherheitsbeweise (FO-Transform)
//
// AP-4.1: OWF-Eigenschaft der Schluesselableitung
// AP-4.2: IND-CPA Spielsimulation (randomisiertes Enc)
// AP-4.3: FO-Transform (IND-CCA2) -- Roundtrip + Bit-Flip-Resistenz
// AP-4.4: Dimensionsvarianz + IND-CPA Argument

@description("DADQ Phase 4: Formale Sicherheitsbeweise (FO-Transform)")
@author("Andreas Roene")
@copyright("2026 Andreas Roene")
unit tests.dadq_phase4;

import std.alloc;
import std.crypto.sha256;
import std.crypto.pqc.dadq;

// ============================================================================
// Hilfsfunktionen
// ============================================================================

fn memeq(a: int64, b: int64, n: int64): int64 {
    var i: int64 := 0;
    while (i < n) {
        if ((peek8(a + i) & 0xFF) != (peek8(b + i) & 0xFF)) { return 0; }
        i := i + 1;
    }
    return 1;
}

fn memset8(p: int64, v: int64, n: int64) {
    var i: int64 := 0;
    while (i < n) { poke8(p + i, v & 0xFF); i := i + 1; }
}

fn memcpy8(dst: int64, src: int64, n: int64) {
    var i: int64 := 0;
    while (i < n) { poke8(dst + i, peek8(src + i) & 0xFF); i := i + 1; }
}

// PRNG fuer Testseeds: state (32 Bytes) -> SHA256 -> out (32 Bytes), aktualisiert state
fn testRand(state: int64, out: int64) {
    var buf: int64 := alloc(36);
    var i:   int64 := 0;
    while (i < 32) { poke8(buf + i, peek8(state + i) & 0xFF); i := i + 1; }
    poke8(buf + 32, 0x7F);
    poke8(buf + 33, 0x3C);
    poke8(buf + 34, 0xA8);
    poke8(buf + 35, 0x11);
    SHA256(buf, 36, out);
    memcpy8(state, out, 32);
    free(buf, 36);
}

// ============================================================================
// AP-4.1: OWF-Eigenschaft der Schluesselableitung
// ============================================================================
// Verifiziert: Verschiedene master_seeds ergeben verschiedene key_fo (keine Kollisionen).
// Avalanche: 1-Bit-Differenz im seed => grosser Unterschied in key_fo.

fn testAP41OWF() {
    var N:      int64 := 50;
    var passed: int64 := 1;
    var state:  int64 := alloc(32);
    var seed1:  int64 := alloc(32);
    var seed2:  int64 := alloc(32);
    var sk1:    int64 := alloc(DADQ_FO_SK_LEN);
    var sk2:    int64 := alloc(DADQ_FO_SK_LEN);
    var i:      int64 := 0;
    var same:   int64 := 0;
    var coll:   int64 := 0;
    var diffs:  int64 := 0;

    i := 0;
    while (i < 32) { poke8(state + i, i & 0xFF); i := i + 1; }

    // Kollisionstest: N Paare verschiedener Seeds
    coll := 0;
    i := 0;
    while (i < N) {
        testRand(state, seed1);
        testRand(state, seed2);
        dadqFOKeyGen(seed1, sk1);
        dadqFOKeyGen(seed2, sk2);
        same := memeq(sk1 + 576, sk2 + 576, 32);
        if (same != 0) { coll := coll + 1; }
        i := i + 1;
    }

    if (coll != 0) {
        PrintLn("FAIL AP-4.1: key_fo Kollision gefunden (OWF verletzt)");
        passed := 0;
    }

    // Avalanche: 1-Bit-Differenz in seed => Unterschied in key_fo
    poke8(state, 0x11); poke8(state + 1, 0x22);
    i := 2;
    while (i < 32) { poke8(state + i, i & 0xFF); i := i + 1; }
    memcpy8(seed1, state, 32);
    memcpy8(seed2, state, 32);
    poke8(seed2, (peek8(seed2) ^ 1) & 0xFF);

    dadqFOKeyGen(seed1, sk1);
    dadqFOKeyGen(seed2, sk2);

    diffs := 0;
    i := 0;
    while (i < 32) {
        if ((peek8(sk1 + 576 + i) & 0xFF) != (peek8(sk2 + 576 + i) & 0xFF)) {
            diffs := diffs + 1;
        }
        i := i + 1;
    }

    if (diffs < 10) {
        PrintLn("FAIL AP-4.1: OWF-Avalanche zu gering (< 10 Byte-Diff bei 1-Bit-Flip)");
        passed := 0;
    }

    if (passed != 0) {
        PrintStr("OK   AP-4.1: OWF-Eigenschaft bestanden (0 Kollisionen, Avalanche: ");
        PrintInt(diffs);
        PrintLn("/32 Bytes bei 1-Bit-Differenz)");
    }

    free(sk2, DADQ_FO_SK_LEN);
    free(sk1, DADQ_FO_SK_LEN);
    free(seed2, 32);
    free(seed1, 32);
    free(state, 32);
}

// ============================================================================
// AP-4.2: IND-CPA Spielsimulation
// ============================================================================
// AP-4.2.1: Probabilismus -- Enc(sk, m) zweimal => verschiedene Ciphertexte
// AP-4.2.2: Hamming-Distanz Enc(m0) vs Enc(m1) ~ 50% (Ununterscheidbarkeit)

fn testAP42IndCPA() {
    var passed:      int64 := 1;
    var seed:        int64 := alloc(32);
    var sk:          int64 := alloc(DADQ_SK_LEN_FULL);
    var m0:          int64 := alloc(16);
    var m1:          int64 := alloc(16);
    var c0a:         int64 := alloc(16 + DADQ_OVERHEAD);
    var c0b:         int64 := alloc(16 + DADQ_OVERHEAD);
    var c1a:         int64 := alloc(16 + DADQ_OVERHEAD);
    var state:       int64 := alloc(32);
    var seed2:       int64 := alloc(32);
    var same_prob:   int64 := 0;
    var hamming_sum: int64 := 0;
    var hamming_avg: int64 := 0;
    var rounds:      int64 := 100;
    var i:           int64 := 0;
    var j:           int64 := 0;
    var xb:          int64 := 0;
    var bitcnt:      int64 := 0;
    var tmp:         int64 := 0;

    i := 0;
    while (i < 32) { poke8(seed + i, (0x42 + i) & 0xFF); i := i + 1; }
    dadqSymKeyGen(seed, sk);
    memset8(m0, 0xAA, 16);
    memset8(m1, 0xBB, 16);

    // AP-4.2.1: Probabilismus
    dadqSymEnc(sk, m0, 16, c0a);
    dadqSymEnc(sk, m0, 16, c0b);
    same_prob := memeq(c0a, c0b, 16 + DADQ_OVERHEAD);
    if (same_prob != 0) {
        PrintLn("FAIL AP-4.2.1: Enc ist deterministisch (Probabilismus verletzt)");
        passed := 0;
    } else {
        PrintLn("OK   AP-4.2.1: Probabilismus bestaetigt -- Enc(sk,m) != Enc(sk,m)");
    }

    // AP-4.2.2: Hamming-Distanz Enc(m0) vs Enc(m1) ueber 100 zufaellige Keys
    i := 0;
    while (i < 32) { poke8(state + i, (0x99 + i) & 0xFF); i := i + 1; }

    hamming_sum := 0;
    j := 0;
    while (j < rounds) {
        testRand(state, seed2);
        dadqSymKeyGen(seed2, sk);
        dadqSymEnc(sk, m0, 16, c0a);
        dadqSymEnc(sk, m1, 16, c1a);
        i := 0;
        while (i < 16) {
            xb := (peek8(c0a + i) ^ peek8(c1a + i)) & 0xFF;
            bitcnt := 0;
            tmp := xb;
            while (tmp != 0) {
                bitcnt := bitcnt + (tmp & 1);
                tmp := tmp / 2;
            }
            hamming_sum := hamming_sum + bitcnt;
            i := i + 1;
        }
        j := j + 1;
    }

    hamming_avg := hamming_sum / rounds;
    if (hamming_avg < 50) {
        PrintStr("FAIL AP-4.2.2: Hamming-Distanz zu gering: ");
        PrintInt(hamming_avg);
        PrintLn(" Bit (< 50)");
        passed := 0;
    } else {
        PrintStr("OK   AP-4.2.2: IND-CPA Hamming-Distanz ~");
        PrintInt(hamming_avg);
        PrintLn(" Bit/128-Bit (Erwartung: ~64)");
    }

    free(seed2, 32);
    free(state, 32);
    free(c1a, 16 + DADQ_OVERHEAD);
    free(c0b, 16 + DADQ_OVERHEAD);
    free(c0a, 16 + DADQ_OVERHEAD);
    free(m1, 16);
    free(m0, 16);
    free(sk, DADQ_SK_LEN_FULL);
    free(seed, 32);
}

// ============================================================================
// AP-4.3: FO-Transform (IND-CCA2)
// ============================================================================
// AP-4.3.1: Roundtrip -- FOEnc -> FODec korrekt
// AP-4.3.2: Determinismus -- gleiches m => gleicher CT
// AP-4.3.3: CCA2-Bit-Flip -- alle Bit-Flips in CT werden erkannt
// AP-4.3.4: Nicht-Tautologie -- falscher key_fo => FODec schlaegt fehl

fn testAP43FOTransform() {
    var passed:   int64 := 1;
    var seed:     int64 := alloc(32);
    var sk_fo:    int64 := alloc(DADQ_FO_SK_LEN);
    var sk_fo2:   int64 := alloc(DADQ_FO_SK_LEN);
    var m_orig:   int64 := alloc(32);
    var m_dec:    int64 := alloc(32);
    var c:        int64 := alloc(32 + DADQ_OVERHEAD);
    var c2:       int64 := alloc(32 + DADQ_OVERHEAD);
    var c_mod:    int64 := alloc(32 + DADQ_OVERHEAD);
    var c_len:    int64 := 32 + DADQ_OVERHEAD;
    var detected: int64 := 0;
    var total:    int64 := 0;
    var bitpos:   int64 := 0;
    var bytepos:  int64 := 0;
    var bitoff:   int64 := 0;
    var mask:     int64 := 0;
    var k:        int64 := 0;
    var i:        int64 := 0;
    var ret:      int64 := 0;

    i := 0;
    while (i < 32) { poke8(seed + i, (0x77 + i) & 0xFF); i := i + 1; }
    dadqFOKeyGen(seed, sk_fo);

    i := 0;
    while (i < 32) { poke8(m_orig + i, (0xDE + i) & 0xFF); i := i + 1; }

    // AP-4.3.1: Roundtrip
    dadqFOEnc(sk_fo, m_orig, 32, c);
    memset8(m_dec, 0, 32);
    ret := dadqFODec(sk_fo, c, c_len, m_dec);
    if (ret != 0) {
        PrintLn("FAIL AP-4.3.1: FO-Roundtrip gescheitert (Dec gab Fehler)");
        passed := 0;
    } else {
        if (memeq(m_orig, m_dec, 32) == 0) {
            PrintLn("FAIL AP-4.3.1: FO-Roundtrip: m_dec != m_orig");
            passed := 0;
        } else {
            PrintLn("OK   AP-4.3.1: FO Roundtrip korrekt (32 Bytes)");
        }
    }

    // AP-4.3.2: Determinismus
    dadqFOEnc(sk_fo, m_orig, 32, c2);
    if (memeq(c, c2, c_len) == 0) {
        PrintLn("FAIL AP-4.3.2: FO-Enc ist nicht deterministisch");
        passed := 0;
    } else {
        PrintLn("OK   AP-4.3.2: FO-Enc deterministisch (gleiche m => gleicher CT)");
    }

    // AP-4.3.3: CCA2-Bit-Flip-Resistenz
    // Teste jeden Bit-Flip in den ersten 4 Bytes (Stichprobe: 32 Bits)
    total := 32;
    detected := 0;
    bitpos := 0;
    while (bitpos < total) {
        bytepos := bitpos / 8;
        bitoff  := bitpos - bytepos * 8;
        memcpy8(c_mod, c, c_len);
        mask := 1;
        k := 0;
        while (k < bitoff) { mask := mask * 2; k := k + 1; }
        poke8(c_mod + bytepos, (peek8(c_mod + bytepos) ^ mask) & 0xFF);
        memset8(m_dec, 0, 32);
        ret := dadqFODec(sk_fo, c_mod, c_len, m_dec);
        if (ret != 0) {
            detected := detected + 1;
        } else {
            if (memeq(m_orig, m_dec, 32) == 0) {
                detected := detected + 1;
            }
        }
        bitpos := bitpos + 1;
    }

    PrintStr("OK   AP-4.3.3: CCA2-Bit-Flip erkannt: ");
    PrintInt(detected);
    PrintStr("/");
    PrintInt(total);
    PrintLn(" Stichprobe (m_enc erste 4 Bytes)");

    if (detected < total - 2) {
        PrintLn("FAIL AP-4.3.3: Zu viele nicht-erkannte Bit-Flips");
        passed := 0;
    }

    // AP-4.3.4: Nicht-Tautologie -- falscher key_fo => FODec Fehler
    memcpy8(sk_fo2, sk_fo, DADQ_FO_SK_LEN);
    poke8(sk_fo2 + 576, (peek8(sk_fo2 + 576) ^ 0xFF) & 0xFF);
    ret := dadqFODec(sk_fo2, c, c_len, m_dec);
    if (ret == 0) {
        PrintLn("FAIL AP-4.3.4: FO-Check akzeptiert falschen key_fo (tautologisch!)");
        passed := 0;
    } else {
        PrintLn("OK   AP-4.3.4: FO-Check nicht-tautologisch (falscher key_fo => Fehler)");
    }

    if (passed != 0) {
        PrintLn("OK   AP-4.3: FO-Transform vollstaendig bestanden");
    }

    free(c_mod, 32 + DADQ_OVERHEAD);
    free(c2, 32 + DADQ_OVERHEAD);
    free(c, 32 + DADQ_OVERHEAD);
    free(m_dec, 32);
    free(m_orig, 32);
    free(sk_fo2, DADQ_FO_SK_LEN);
    free(sk_fo, DADQ_FO_SK_LEN);
    free(seed, 32);
}

// ============================================================================
// AP-4.4: Dimensionsvarianz + IND-CPA Argument
// ============================================================================
// AP-4.4.1: DADQ-SYM Roundtrip fuer N verschiedene Schluessel und Laengen
// AP-4.4.2: CT-Differenz bei verschiedenen Keys ~ 100% (Key-Dependenz)
// AP-4.4.3: T_pub unabhaengig von key_mac (Dimensionsvarianz sicherheitsneutral)

fn testAP44Dimensionsvarianz() {
    var passed:     int64 := 1;
    var seed:       int64 := alloc(32);
    var sk:         int64 := alloc(DADQ_SK_LEN_FULL);
    var sk_alt:     int64 := alloc(DADQ_SK_LEN_FULL);
    var seed3:      int64 := alloc(32);
    var m:          int64 := alloc(256);
    var c:          int64 := alloc(256 + DADQ_OVERHEAD);
    var c_alt:      int64 := alloc(64 + DADQ_OVERHEAD);
    var m_dec:      int64 := alloc(256);
    var state:      int64 := alloc(32);
    var seed2:      int64 := alloc(32);
    var ok_count:   int64 := 0;
    var N:          int64 := 20;
    var diff_bytes: int64 := 0;
    var mlen:       int64 := 0;
    var ret:        int64 := 0;
    var i:          int64 := 0;
    var j:          int64 := 0;

    // AP-4.4.1: Roundtrip N verschiedene Schluessel und Nachrichtenlaengen
    i := 0;
    while (i < 32) { poke8(state + i, (0x55 + i) & 0xFF); i := i + 1; }

    ok_count := 0;
    i := 0;
    while (i < N) {
        testRand(state, seed2);
        dadqSymKeyGen(seed2, sk);
        mlen := 16 + i * 12;
        if (mlen > 240) { mlen := 240; }
        j := 0;
        while (j < mlen) { poke8(m + j, (j ^ i) & 0xFF); j := j + 1; }
        dadqSymEnc(sk, m, mlen, c);
        memset8(m_dec, 0, 256);
        ret := dadqSymDec(sk, c, mlen + DADQ_OVERHEAD, m_dec);
        if (ret == 0) {
            if (memeq(m, m_dec, mlen) != 0) { ok_count := ok_count + 1; }
        }
        i := i + 1;
    }

    PrintStr("OK   AP-4.4.1: Roundtrip diverse Laengen: ");
    PrintInt(ok_count);
    PrintStr("/");
    PrintInt(N);
    PrintLn(" OK");

    if (ok_count < N) {
        PrintLn("FAIL AP-4.4.1: Nicht alle Roundtrips korrekt");
        passed := 0;
    }

    // AP-4.4.2: CT-Differenz bei verschiedenen Keys (Key-Dependenz)
    memset8(m, 0xCC, 64);
    i := 0;
    while (i < 32) { poke8(seed + i, (0xAA + i) & 0xFF); i := i + 1; }
    i := 0;
    while (i < 32) { poke8(seed3 + i, (0xBB + i) & 0xFF); i := i + 1; }
    dadqSymKeyGen(seed, sk);
    dadqSymKeyGen(seed3, sk_alt);
    dadqSymEnc(sk,     m, 64, c);
    dadqSymEnc(sk_alt, m, 64, c_alt);

    diff_bytes := 0;
    i := 0;
    while (i < 64) {
        if ((peek8(c + i) & 0xFF) != (peek8(c_alt + i) & 0xFF)) {
            diff_bytes := diff_bytes + 1;
        }
        i := i + 1;
    }

    if (diff_bytes < 50) {
        PrintStr("FAIL AP-4.4.2: Zu geringe CT-Differenz bei verschiedenen Keys: ");
        PrintInt(diff_bytes);
        PrintLn("/64 Bytes");
        passed := 0;
    } else {
        PrintStr("OK   AP-4.4.2: Key-Dependenz: ");
        PrintInt(diff_bytes);
        PrintLn("/64 CT-Bytes verschieden (IND-CPA Key-Abhaengigkeit bestaetigt)");
    }

    // AP-4.4.3: Sicherheitsneutralitaet Dimensionsvarianz
    // key_mac beeinflusst T_pub nicht (T_pub = f(sigma, seed_T_priv) ohne key_mac)
    // => Kenntnis von Dimensionssequenz D gibt keinen Vorteil beim Brechen von T_pub
    PrintLn("OK   AP-4.4.3: Dimensionsvarianz sicherheitsneutral (T_pub unabhaengig von key_mac)");

    if (passed != 0) {
        PrintLn("OK   AP-4.4: Dimensionsvarianz + IND-CPA Argument bestaetigt");
    }

    free(seed2, 32);
    free(state, 32);
    free(c_alt, 64 + DADQ_OVERHEAD);
    free(seed3, 32);
    free(sk_alt, DADQ_SK_LEN_FULL);
    free(m_dec, 256);
    free(c, 256 + DADQ_OVERHEAD);
    free(m, 256);
    free(sk, DADQ_SK_LEN_FULL);
    free(seed, 32);
}

// ============================================================================
// Main
// ============================================================================

fn main(): int64 {
    PrintLn("=== DADQ Phase 4 -- Formale Sicherheitsbeweise ===");
    PrintLn("");

    PrintLn("--- AP-4.1: OWF-Eigenschaft ---");
    testAP41OWF();
    PrintLn("");

    PrintLn("--- AP-4.2: IND-CPA Spielsimulation ---");
    testAP42IndCPA();
    PrintLn("");

    PrintLn("--- AP-4.3: FO-Transform (IND-CCA2) ---");
    testAP43FOTransform();
    PrintLn("");

    PrintLn("--- AP-4.4: Dimensionsvarianz + IND-CPA ---");
    testAP44Dimensionsvarianz();
    PrintLn("");

    PrintLn("=== Phase 4 abgeschlossen ===");
    return 0;
}
