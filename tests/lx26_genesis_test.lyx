// LX-26 Test: Genesis Content Serializer — Roundtrip + Feldprüfungen (--target=x86_64)

import src.std.alloc;
import src.std.io;
import src.std.lyxos.lbf_layout;
import src.tools.lbf.genesis;

fn main(): int64 {
    var d: int64 := genesis_data_alloc();
    var p: int64 := alloc(4032);

    // Felder setzen
    poke64(d + GEN_D_ENTRY_POINT,   0x401000);
    poke64(d + GEN_D_TEXT_BLOCKS,   1);
    poke64(d + GEN_D_RODATA_BLOCKS, 0);
    poke64(d + GEN_D_DATA_BLOCKS,   0);
    poke64(d + GEN_D_BSS_BLOCKS,    0);
    poke64(d + GEN_D_FILE_SIZE,     4096);
    poke64(d + GEN_D_COMPILED_AT,   1718000000000000);

    genesis_serialize(d, p);

    // Test 1: entry_point LE-64
    if peek64(p + GEN_P_ENTRY_POINT) != 0x401000 {
        EPrintStrLn("FAIL: entry_point falsch");
        return 1;
    }

    // Test 2: entry_point Little-Endian Bytes
    if peek8(p + GEN_P_ENTRY_POINT)     != 0    { EPrintStrLn("FAIL: ep byte0"); return 1; }
    if peek8(p + GEN_P_ENTRY_POINT + 1) != 0x10 { EPrintStrLn("FAIL: ep byte1"); return 1; }
    if peek8(p + GEN_P_ENTRY_POINT + 2) != 0x40 { EPrintStrLn("FAIL: ep byte2"); return 1; }
    if peek8(p + GEN_P_ENTRY_POINT + 3) != 0    { EPrintStrLn("FAIL: ep byte3"); return 1; }

    // Test 3: compiler_name = "lyxc" + Null-Padding
    if peek8(p + GEN_P_COMPILER_NAME)      != 108 { EPrintStrLn("FAIL: name[0]"); return 1; }
    if peek8(p + GEN_P_COMPILER_NAME + 1)  != 121 { EPrintStrLn("FAIL: name[1]"); return 1; }
    if peek8(p + GEN_P_COMPILER_NAME + 2)  != 120 { EPrintStrLn("FAIL: name[2]"); return 1; }
    if peek8(p + GEN_P_COMPILER_NAME + 3)  != 99  { EPrintStrLn("FAIL: name[3]"); return 1; }
    if peek8(p + GEN_P_COMPILER_NAME + 4)  != 0   { EPrintStrLn("FAIL: name[4] nicht NUL"); return 1; }
    if peek8(p + GEN_P_COMPILER_NAME + 15) != 0   { EPrintStrLn("FAIL: name[15] nicht NUL"); return 1; }

    // Test 4: file_crc32c = 0x00000000 nach Serialize
    if (peek32(p + GEN_P_FILE_CRC32C) & 0xFFFFFFFF) != 0 {
        EPrintStrLn("FAIL: file_crc32c nicht 0");
        return 1;
    }

    // Test 5: content_type = 1
    if peek8(p + GEN_P_CONTENT_TYPE) != 1 {
        EPrintStrLn("FAIL: content_type falsch");
        return 1;
    }

    // Test 6: target_arch = 1 (x86-64)
    if peek8(p + GEN_P_TARGET_ARCH) != 1 {
        EPrintStrLn("FAIL: target_arch falsch");
        return 1;
    }

    // Test 7: stack_size = 131072 (0x20000)
    if (peek32(p + GEN_P_STACK_SIZE) & 0xFFFFFFFF) != 131072 {
        EPrintStrLn("FAIL: stack_size falsch");
        return 1;
    }

    // Test 8: tlv_offset = 128
    if peek16(p + GEN_P_TLV_OFFSET) != 128 {
        EPrintStrLn("FAIL: tlv_offset falsch");
        return 1;
    }

    // Test 9: genesis_get_entry_point
    if genesis_get_entry_point(p) != 0x401000 {
        EPrintStrLn("FAIL: get_entry_point");
        return 1;
    }

    // Test 10: genesis_get_total_block_count (1+0+0+0+1 = 2)
    if genesis_get_total_block_count(p) != 2 {
        EPrintStrLn("FAIL: get_total_block_count");
        return 1;
    }

    // Test 11: Deserialize-Roundtrip
    var d2: int64 := genesis_data_alloc();
    genesis_deserialize(p, d2);

    if peek64(d2 + GEN_D_ENTRY_POINT) != 0x401000 {
        EPrintStrLn("FAIL: roundtrip entry_point");
        return 1;
    }
    if peek64(d2 + GEN_D_CONTENT_TYPE) != 1 {
        EPrintStrLn("FAIL: roundtrip content_type");
        return 1;
    }
    if peek64(d2 + GEN_D_TEXT_BLOCKS) != 1 {
        EPrintStrLn("FAIL: roundtrip text_blocks");
        return 1;
    }
    if peek64(d2 + GEN_D_STACK_SIZE) != 131072 {
        EPrintStrLn("FAIL: roundtrip stack_size");
        return 1;
    }
    if peek64(d2 + GEN_D_FILE_SIZE) != 4096 {
        EPrintStrLn("FAIL: roundtrip file_size");
        return 1;
    }
    if peek64(d2 + GEN_D_COMPILED_AT) != 1718000000000000 {
        EPrintStrLn("FAIL: roundtrip compiled_at");
        return 1;
    }

    // Test 12: compiler_name Roundtrip
    if peek8(d2 + GEN_D_COMPILER_NAME)     != 108 { EPrintStrLn("FAIL: rt name[0]"); return 1; }
    if peek8(d2 + GEN_D_COMPILER_NAME + 1) != 121 { EPrintStrLn("FAIL: rt name[1]"); return 1; }
    if peek8(d2 + GEN_D_COMPILER_NAME + 2) != 120 { EPrintStrLn("FAIL: rt name[2]"); return 1; }
    if peek8(d2 + GEN_D_COMPILER_NAME + 3) != 99  { EPrintStrLn("FAIL: rt name[3]"); return 1; }
    if peek8(d2 + GEN_D_COMPILER_NAME + 4) != 0   { EPrintStrLn("FAIL: rt name[4]"); return 1; }

    // Test 13: tlv_offset + tlv_used Roundtrip
    if peek64(d2 + GEN_D_TLV_OFFSET) != 128 { EPrintStrLn("FAIL: rt tlv_offset"); return 1; }
    if peek64(d2 + GEN_D_TLV_USED)   != 0   { EPrintStrLn("FAIL: rt tlv_used");   return 1; }

    genesis_data_free(d);
    genesis_data_free(d2);
    free(p, 4032);

    PrintStrLn("lx26: genesis serializer OK");
    return 0;
}
