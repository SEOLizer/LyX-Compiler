// tests/do_demo2_database.lyx — DO Demo 2: Managed Database + Spaces
// WP-DO-14 Demo 2
// Benötigt: DIGITALOCEAN_TOKEN, optional DO_SPACES_KEY/DO_SPACES_SECRET

unit tests.do_demo2_database;

import std.cloud.digitalocean.credentials;
import std.cloud.digitalocean.databases;
import std.cloud.digitalocean.spaces;
import std.alloc;
import std.io;

pub fn main(argc: int64, argv: pchar): int64 {
    var creds: DOCredentials := DOCredentialsFromEnv();
    if (creds.tokenLen == 0) {
        PrintLn("Fehler: DIGITALOCEAN_TOKEN nicht gesetzt."c);
        return 1;
    }

    PrintLn("--- DO Demo 2: Managed Database + Spaces Backup ---"c);

    // PostgreSQL-Datenbank erstellen
    Print("Erstelle Managed PostgreSQL in fra1..."c);
    var db: DODatabase := DatabaseCreate(creds,
        "lyx-demo-pg"c, "pg"c, "15"c, "fra1"c, "db-s-1vcpu-1gb"c, 1);
    if (db.id == 0) {
        PrintLn(" FEHLER."c);
        DOCredentialsFree(creds);
        return 1;
    }
    Print(" ID: "c); PrintLn(db.id as pchar);

    // Warten bis online
    Print("Warte auf online-Status (kann 5-10 min dauern)..."c);
    var ready: DODatabase := DatabaseWait(creds, db.id as pchar);
    DODatabaseFree(db);
    if (ready.id == 0) {
        PrintLn(" Timeout."c);
        DOCredentialsFree(creds);
        return 1;
    }
    PrintLn(" online!"c);

    // Verbindung abrufen
    var conn: DODBConnection := DatabaseGetConnection(creds, ready.id as pchar);
    Print("Verbindungs-URI: "c);
    if (conn.uri != 0) { PrintLn(conn.uri as pchar); }
    else { PrintLn("(keine URI)"c); }

    // Spaces-Backup-Bucket erstellen (falls Spaces-Keys gesetzt)
    if (creds.spacesKey != 0) {
        PrintLn("Erstelle Spaces-Bucket für Backups..."c);
        var ok: int64 := SpacesBucketCreate(creds, "lyx-demo-backups"c, "fra1"c);
        if (ok == 1) { PrintLn("Bucket 'lyx-demo-backups' erstellt."c); }
        else { PrintLn("Bucket-Erstellung fehlgeschlagen (existiert ggf. bereits)."c); }

        // Demo-Backup-Datei hochladen
        var backupData: pchar := "-- PostgreSQL backup placeholder\n-- Real backup requires pg_dump\n"c;
        var bl: int64 := StrLen(backupData);
        var ok2: int64 := SpacesObjectPut(creds, "lyx-demo-backups"c, "fra1"c,
                                           "backups/demo-backup.sql"c,
                                           backupData as int64, bl, "text/plain"c);
        if (ok2 == 1) { PrintLn("Demo-Backup hochgeladen: backups/demo-backup.sql"c); }
    } else {
        PrintLn("Kein DO_SPACES_KEY gesetzt — Spaces-Backup übersprungen."c);
    }

    PrintLn("--- Demo 2 abgeschlossen ---"c);
    PrintLn("Zum Aufräumen:"c);
    PrintLn("  lyxdo database delete <id>"c);

    DODBConnectionFree(conn);
    DODatabaseFree(ready);
    DOCredentialsFree(creds);
    return 0;
}
