// tests/usb_wp7a_test.lyx
// WP-7A: Typsichere USB-Endpoint-Wrapper
//
// Erreichbare Abnahmekriterien (ohne Lyx-Generics + nominale Typen):
//
// ✓ AC-1 PARTIAL: UsbBulkOutEndpoint hat nur Write — kein Read existiert im Modul
// ✓ AC-2 PARTIAL: UsbBulkInEndpoint hat nur Read — kein Write existiert im Modul
// ✓ AC-3 PARTIAL: Falsche Richtung → Runtime-Sentinel (dev_fd=-1), alle Ops -1
// ✗ AC-4 BLOCKED: Zero-Cost erfordert Generics/Inlining (Lyx hat keines)
//
// Nicht testbar ohne Compiler-Eingriff:
//   "BulkOutEndpoint<$01>.Read(...) erzeugt Compiler-Fehler" — da Lyx strukturelles
//   Typing hat, ist dies ohne Nominale Typen und Generics nicht erreichbar.
//
// Getestet wird:
//   - Factory-Funktionen: Struct-Felder korrekt gesetzt
//   - Runtime-Sentinel: Falsche Richtung → dev_fd=-1, Valid=0
//   - API-Separation: Write/Read/Submit nur auf dem richtigen Typ sichtbar
//   - Operationen mit fd=-1 → negativer Rückgabewert

unit tests.usb_wp7a_test;

import std.hardware.usb_endpoint_types;
import std.alloc;

// ============================================================
// Factory-Funktionen: Felder korrekt gesetzt
// ============================================================
fn testFactoryFields(): int64 {
  var failed: int64 := 0;

  // BulkOut: ep=0x01 (OUT, Bit7=0) → gültig
  var out1: UsbBulkOutEndpoint := UsbMakeBulkOut(5, 0x01, 1000);
  if (out1.dev_fd   != 5)    { PrintLn("FAIL: BulkOut dev_fd");   failed:=failed+1; }
  if (out1.endpoint != 0x01) { PrintLn("FAIL: BulkOut endpoint"); failed:=failed+1; }
  if (out1.timeout  != 1000) { PrintLn("FAIL: BulkOut timeout");  failed:=failed+1; }

  // BulkIn: ep=0x82 (IN, Bit7=1) → gültig
  var in1: UsbBulkInEndpoint := UsbMakeBulkIn(7, 0x82, 2000);
  if (in1.dev_fd   != 7)    { PrintLn("FAIL: BulkIn dev_fd");   failed:=failed+1; }
  if (in1.endpoint != 0x82) { PrintLn("FAIL: BulkIn endpoint"); failed:=failed+1; }
  if (in1.timeout  != 2000) { PrintLn("FAIL: BulkIn timeout");  failed:=failed+1; }

  // InterruptIn: ep=0x81 (IN, Bit7=1) → gültig
  var ii1: UsbInterruptInEndpoint := UsbMakeInterruptIn(3, 0x81, 8, 500);
  if (ii1.dev_fd   != 3)   { PrintLn("FAIL: IntIn dev_fd");   failed:=failed+1; }
  if (ii1.endpoint != 0x81){ PrintLn("FAIL: IntIn endpoint"); failed:=failed+1; }
  if (ii1.buf_size != 8)   { PrintLn("FAIL: IntIn buf_size"); failed:=failed+1; }
  if (ii1.timeout  != 500) { PrintLn("FAIL: IntIn timeout");  failed:=failed+1; }

  if (failed == 0) { PrintLn("OK: factory field assignment"); }
  return failed;
}

// ============================================================
// AC-3 (Runtime): Falsche Richtung → Sentinel (dev_fd=-1)
// BulkOutEndpoint mit IN-Adresse → ungültig
// BulkInEndpoint mit OUT-Adresse → ungültig
// ============================================================
fn testWrongDirection(): int64 {
  var failed: int64 := 0;

  // BulkOut mit IN-Adresse 0x81 (Bit7=1) → Sentinel
  var badOut: UsbBulkOutEndpoint := UsbMakeBulkOut(5, 0x81, 1000);
  if (badOut.dev_fd != -1) {
    PrintLn("FAIL: BulkOut with IN addr should have dev_fd=-1");
    failed := failed + 1;
  }
  if (UsbBulkOutValid(badOut) != 0) {
    PrintLn("FAIL: BulkOutValid should return 0 for IN-addr");
    failed := failed + 1;
  }

  // BulkIn mit OUT-Adresse 0x02 (Bit7=0) → Sentinel
  var badIn: UsbBulkInEndpoint := UsbMakeBulkIn(5, 0x02, 1000);
  if (badIn.dev_fd != -1) {
    PrintLn("FAIL: BulkIn with OUT addr should have dev_fd=-1");
    failed := failed + 1;
  }
  if (UsbBulkInValid(badIn) != 0) {
    PrintLn("FAIL: BulkInValid should return 0 for OUT-addr");
    failed := failed + 1;
  }

  // InterruptIn mit OUT-Adresse 0x03 → Sentinel
  var badII: UsbInterruptInEndpoint := UsbMakeInterruptIn(5, 0x03, 8, 500);
  if (badII.dev_fd != -1) {
    PrintLn("FAIL: IntIn with OUT addr should have dev_fd=-1");
    failed := failed + 1;
  }
  if (UsbInterruptInValid(badII) != 0) {
    PrintLn("FAIL: IntInValid should return 0 for OUT-addr");
    failed := failed + 1;
  }

  if (failed == 0) { PrintLn("OK: wrong direction → sentinel (AC-3 runtime)"); }
  return failed;
}

// ============================================================
// Korrekte Richtung → Valid=1
// ============================================================
fn testCorrectDirectionValid(): int64 {
  var failed: int64 := 0;

  var validOut: UsbBulkOutEndpoint := UsbMakeBulkOut(4, 0x01, 500);
  if (UsbBulkOutValid(validOut) != 1) {
    PrintLn("FAIL: valid BulkOut should return Valid=1");
    failed := failed + 1;
  }

  var validIn: UsbBulkInEndpoint := UsbMakeBulkIn(4, 0x81, 500);
  if (UsbBulkInValid(validIn) != 1) {
    PrintLn("FAIL: valid BulkIn should return Valid=1");
    failed := failed + 1;
  }

  var validII: UsbInterruptInEndpoint := UsbMakeInterruptIn(4, 0x83, 64, 1000);
  if (UsbInterruptInValid(validII) != 1) {
    PrintLn("FAIL: valid IntIn should return Valid=1");
    failed := failed + 1;
  }

  if (failed == 0) { PrintLn("OK: correct direction → Valid=1"); }
  return failed;
}

// ============================================================
// Sentinel-Endpoint: alle Ops geben -1/0 zurück (kein Crash)
// ============================================================
fn testSentinelOpsReturnError(): int64 {
  var failed: int64 := 0;
  var buf: int64 := alloc(8);

  // Sentinel BulkOut → Write gibt -1
  var badOut: UsbBulkOutEndpoint := UsbMakeBulkOut(5, 0x81, 1000);
  var r1: int64 := UsbBulkOutWrite(badOut, buf, 8);
  if (r1 != -1) {
    PrintLn("FAIL: BulkOutWrite on sentinel should return -1");
    failed := failed + 1;
  }

  // Sentinel BulkIn → Read gibt -1
  var badIn: UsbBulkInEndpoint := UsbMakeBulkIn(5, 0x02, 1000);
  var r2: int64 := UsbBulkInRead(badIn, buf, 8);
  if (r2 != -1) {
    PrintLn("FAIL: BulkInRead on sentinel should return -1");
    failed := failed + 1;
  }

  // Sentinel InterruptIn → Submit gibt 0
  var badII: UsbInterruptInEndpoint := UsbMakeInterruptIn(5, 0x03, 8, 500);
  var r3: int64 := UsbInterruptInSubmit(badII, buf, 0);
  if (r3 != 0) {
    PrintLn("FAIL: IntInSubmit on sentinel should return 0");
    failed := failed + 1;
  }

  free(buf, 8);
  if (failed == 0) { PrintLn("OK: sentinel endpoint → error return, no crash"); }
  return failed;
}

// ============================================================
// Gültiger Endpoint mit fd=-1 (kein echtes Gerät) → ioctl schlägt fehl
// Verifiziert, dass die Operationen den ioctl aufrufen (kein Shortcut)
// ============================================================
fn testValidEndpointInvalidFd(): int64 {
  var failed: int64 := 0;
  var buf: int64 := alloc(64);

  // fd=-1 ist kein Sentinel (dev_fd >= 0 ist die Sentinel-Bedingung nicht erfüllt)
  // Aber fd=-1 ist auch kein gültiger fd → ioctl gibt -EBADF zurück

  // Hinweis: UsbMakeBulkOut(fd=-1, ...) würde fd=-1 akzeptieren (kein Sentinel,
  // da die Sentinel-Bedingung ep-Richtung ist, nicht fd-Gültigkeit).
  // Daher testen wir mit einem validen ep-Format aber -1 als fd:
  var out_fd_minus1: UsbBulkOutEndpoint;
  out_fd_minus1.dev_fd   := -1;
  out_fd_minus1.endpoint := 0x01;
  out_fd_minus1.timeout  := 100;

  // dev_fd < 0 → gibt -1 zurück (Sentinel-Check greift)
  var r1: int64 := UsbBulkOutWrite(out_fd_minus1, buf, 8);
  if (r1 != -1) {
    PrintLn("FAIL: fd=-1 → BulkOutWrite should return -1");
    failed := failed + 1;
  }

  free(buf, 64);
  if (failed == 0) { PrintLn("OK: fd=-1 caught by sentinel check"); }
  return failed;
}

// ============================================================
// EP-Adress-Extraktion: Richtungs-Bit korrekt
// ============================================================
fn testEpAddressEncoding(): int64 {
  var failed: int64 := 0;

  // OUT endpoints: 0x00..0x0F (Bit7=0)
  var out1: UsbBulkOutEndpoint := UsbMakeBulkOut(1, 0x00, 100);
  var out2: UsbBulkOutEndpoint := UsbMakeBulkOut(1, 0x0F, 100);
  if (UsbBulkOutValid(out1) != 1 || UsbBulkOutValid(out2) != 1) {
    PrintLn("FAIL: 0x00/0x0F should be valid OUT");
    failed := failed + 1;
  }

  // IN endpoints: 0x80..0x8F (Bit7=1)
  var in1: UsbBulkInEndpoint := UsbMakeBulkIn(1, 0x80, 100);
  var in2: UsbBulkInEndpoint := UsbMakeBulkIn(1, 0x8F, 100);
  if (UsbBulkInValid(in1) != 1 || UsbBulkInValid(in2) != 1) {
    PrintLn("FAIL: 0x80/0x8F should be valid IN");
    failed := failed + 1;
  }

  // Cross-check: OUT-Adresse für IN → Sentinel, vice versa
  var crossIn: UsbBulkInEndpoint := UsbMakeBulkIn(1, 0x01, 100);
  var crossOut: UsbBulkOutEndpoint := UsbMakeBulkOut(1, 0x81, 100);
  if (UsbBulkInValid(crossIn) != 0 || UsbBulkOutValid(crossOut) != 0) {
    PrintLn("FAIL: cross-direction should be invalid");
    failed := failed + 1;
  }

  if (failed == 0) { PrintLn("OK: endpoint address direction encoding"); }
  return failed;
}

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testFactoryFields();
  failed := failed + testWrongDirection();
  failed := failed + testCorrectDirectionValid();
  failed := failed + testSentinelOpsReturnError();
  failed := failed + testValidEndpointInvalidFd();
  failed := failed + testEpAddressEncoding();

  if (failed != 0) {
    PrintLn("FAILED");
    return 1;
  }
  PrintLn("ALL PASSED");
  return 0;
}
