// bench/str_prim.lyx — Messgeschirr fuer die Zeichenketten-Primitiven des
// x86-Codegens: StrLen, StrEquals, StrStartsWith, memcpy.
//
//   str_prim <op 1..5> <laenge> <wiederholungen>
//
//     op 1 = StrLen             (voller Durchlauf bis zur Null)
//     op 2 = StrEquals, gleich  (voller Durchlauf, schlechtester Fall)
//     op 3 = StrEquals, Abbruch in der Mitte
//     op 4 = memcpy
//     op 5 = StrStartsWith, Praefix halbe Laenge
//     op 6 = Leerlauf: dieselbe Schleife OHNE Primitive. Die Differenz zu
//            1..5 ist der Eigenanteil der gemessenen Primitive; ohne diesen
//            Boden sagt eine Takzahl nur, wie teuer die Schleife ist.
//
// Warum eigene Kerne und nicht eine Unit aus std: diese vier Primitiven
// erzeugt der Codegen selbst (codegen_x86.lyx, Helferblock und
// Builtin-Kette), und fast jede std-Unit laeuft ueber sie. Gemessen wird
// deshalb genau das Erzeugnis dieser Stellen, ohne eine Unit dazwischen.
//
// Je Wiederholung wird ein Byte IM INNEREN der Zeichenkette veraendert —
// nie auf 0, die Laenge bleibt also gleich. Das haelt den Kern in der
// Schleife (kein Herausziehen) und die Pruefsumme haengt am Ergebnis.
//
// Die Pruefsumme ist Teil der Messung: weichen zwei Fassungen darin ab,
// rechnen sie nicht dasselbe und die Zeiten sind wertlos.

@description("Benchmark: Zeichenketten-Primitiven des x86-Codegens")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")

import std.io;
import std.string;

// Fuellt p mit n Nicht-Null-Bytes und setzt den Abschluss.
fn fuelle(p: int64, n: int64, start: int64): void {
  var i: int64 := 0;
  while (i < n) {
    poke8(p + i, 97 + ((i + start) % 26));
    i += 1;
  }
  poke8(p + n, 0);
}

fn main(): int64 {
  var argc: int64 := GetArgC();
  var argv: pchar := GetArgV();
  var op: int64 := 1;
  var n: int64 := 32;
  var wdh: int64 := 100000;
  if (argc > 1) { op := StrToInt(ArgvGet(argv, 1)); }
  if (argc > 2) { var v2: int64 := StrToInt(ArgvGet(argv, 2)); if (v2 > 0) { n := v2; } }
  if (argc > 3) { var v3: int64 := StrToInt(ArgvGet(argv, 3)); if (v3 > 0) { wdh := v3; } }
  if (op < 1 || op > 6) { PrintLn("op muss 1..6 sein"); return 2; }
  if (n < 8) { PrintLn("laenge muss mindestens 8 sein"); return 2; }

  var a: int64 := alloc(n + 64);
  var b: int64 := alloc(n + 64);
  var z: int64 := alloc(n + 64);
  fuelle(a, n, 0);
  fuelle(b, n, 0);
  // op 3: Abbruch in der Mitte. Ein einzelnes abweichendes Byte, der Rest
  // bleibt gleich — so misst der Fall den TEILdurchlauf, nicht den Abbruch
  // im ersten Byte.
  if (op == 3) { poke8(b + (n / 2), 33); }
  // op 5: Praefix der halben Laenge.
  if (op == 5) { poke8(b + (n / 2), 0); }

  var summe: int64 := 0;
  var r: int64 := 0;
  // Nie Position 0 und nie das Byte, an dem op 3/op 5 haengen: die Laenge
  // und der Abbruchpunkt muessen ueber alle Laeufe gleich bleiben, sonst
  // misst jeder Lauf etwas anderes.
  //
  // k laeuft als Zaehler mit Umschlag, NICHT als `r % x`: eine Division
  // kostet auf dieser Maschine mehr Takte als der gemessene Kern bei
  // kurzen Laengen und haette die Messung verdeckt.
  var k: int64 := 1;
  var kMax: int64 := n / 2;
  var zyk: int64 := 0;
  while (r < wdh) {
    k += 1;
    if (k > kMax) { k := 1; }
    zyk += 1;
    if (zyk >= 26) { zyk := 0; }
    if (k != n / 2) {
      poke8(a + k, 97 + zyk);
      // IMMER mitschreiben: op 3 soll genau EINE Abweichung haben (bei n/2),
      // op 5 einen vollstaendig passenden Praefix. Ohne das Mitschreiben
      // wanderte der Abbruchpunkt mit r und jeder Lauf messe etwas anderes.
      poke8(b + k, 97 + zyk);
    }
    if (op == 1) {
      summe := summe + StrLen(a as pchar);
    } else if (op == 2 || op == 3) {
      if (StrEquals(a as pchar, b as pchar)) { summe := summe + 1; }
    } else if (op == 6) {
      summe := summe + peek8(a + k);
    } else if (op == 4) {
      memcpy(z, a, n);
      summe := summe + peek8(z + n - 1);
    } else {
      if (StrStartsWith(a as pchar, b as pchar)) { summe := summe + 1; }
    }
    r += 1;
  }

  PrintStr("checksum="c);
  PrintLn(summe);
  return 0;
}
