// bench/chacha_qr.lyx — ChaCha20-Quarter-Round, der Kern aus dem Auftrag.
//
// Aufruf:  chacha_qr <runden>
//
// Gemessen wird die Quarter-Round in der Form, in der sie in ChaCha20 steht:
// vier 32-Bit-Woerter, je vier Mal Addition, XOR und Linksrotation um 16, 12,
// 8 und 7 Bit. Ausgegeben wird eine Pruefsumme — sie MUSS mit der der
// C-Fassung uebereinstimmen, sonst wird nicht gemessen, sondern gemeldet.
//
// Zur Rotation: ChaCha rechnet auf 32 Bit. `rotl(x, n)` aus #2190 rotiert
// 64 Bit und taugt dafuer nicht. Bis 1.2.19J stand die Rotation deshalb als
// eigene Funktion aus Schieben, Verodern und Maskieren da — die Form, die GCC
// und Clang zu einem `rol r32` zusammenziehen, lyxc aber nicht. Seit #2177
// gibt es `rotl32` als eingebaute Funktion (`rol eax, cl`): 240 -> 178 ms bei
// 2e7 Runden, gcc -O2 162 ms. Die C-Fassung behaelt die Schiebeform — GCC
// erkennt sie, beide rechnen also dasselbe in derselben Instruktion.
// Eine Mustererkennung der Schiebeform in lyxc braucht einen
// Wertebereichsnachweis (obere 32 Bit leer) und bleibt ein eigener Schritt.

@description("Benchmark: ChaCha20-Quarter-Round (#2195)")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")

import std.io;
import std.string;

con M32: int64 := 4294967295;   // 0xFFFFFFFF

fn main(): int64 {
  var argc: int64 := GetArgC();
  var argv: pchar := GetArgV();
  var runden: int64 := 1000000;
  if (argc > 1) {
    var s: pchar := ArgvGet(argv, 1);
    var v: int64 := StrToInt(s);
    if (v > 0) { runden := v; }
  }

  // Startzustand wie in RFC 8439, Abschnitt 2.1.1 — damit die Pruefsumme
  // nicht von einer willkuerlichen Belegung abhaengt.
  var a: int64 := 285400596;    // 0x11111111
  var b: int64 := 16843009;     // 0x01020304
  var c: int64 := 2609191515;   // 0x9b8d6f43
  var d: int64 := 20016;        // 0x01234567

  var i: int64 := 0;
  var summe: int64 := 0;
  while (i < runden) {
    a := (a + b) & M32;  d := d ^ a;  d := rotl32(d, 16);
    c := (c + d) & M32;  b := b ^ c;  b := rotl32(b, 12);
    a := (a + b) & M32;  d := d ^ a;  d := rotl32(d, 8);
    c := (c + d) & M32;  b := b ^ c;  b := rotl32(b, 7);
    // Der Zustand wandert in die naechste Runde; die Pruefsumme haengt damit
    // an JEDER Runde. Ein Compiler, der die Schleife wegoptimiert, faellt
    // ueber die Pruefsumme auf.
    summe := (summe + a + b + c + d) & M32;
    i += 1;
  }

  PrintStr("checksum="c);
  PrintLn(summe);
  return 0;
}
