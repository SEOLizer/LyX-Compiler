// bench/aes_ni.lyx — Messgeschirr fuer AES-NI gegen den Rechenweg (#2383).
//
//   aes_ni <op 1..7> <bloecke je Wiederholung> <wiederholungen>
//
//     op 1 = AES-128, ein Block verschluesseln — AESENC-Kette
//     op 2 = AES-128, derselbe Lauf gerechnet (AESForceSoftware)
//     op 3 = AES-256 verschluesseln — AESENC-Kette
//     op 4 = AES-256 gerechnet
//     op 5 = AES-128 Schluesselexpansion — tabellenfrei (AESENCLAST)
//     op 6 = AES-128 Schluesselexpansion gerechnet (S-Box)
//     op 7 = Leerlauf: dieselbe Schleife ohne AES. Ohne diesen Boden sagt
//            eine Zeit nur, wie teuer die Schleife ist.
//
// Gemessen wird ueber AESEncryptBlockWithKey, also die Stelle, die jeder
// Aufrufer trifft — nicht ueber AESNIEncryptBlock direkt. Der Unterschied
// ist genau eine Verzweigung, und die gehoert in die Messung.
//
// Je Block wird ein Byte des Klartexts veraendert und die Pruefsumme
// mitgefuehrt: sonst darf der Uebersetzer den Aufruf aus der Schleife
// ziehen, und beide Zweige muessen nachweislich DASSELBE rechnen — weichen
// die Pruefsummen von op 1 und op 2 ab, sind die Zeiten wertlos.

@description("Benchmark: AES-NI gegen den Rechenweg")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")

import std.io;
import std.string;
import std.crypto.aes;

fn main(): int64 {
  var argc: int64 := GetArgC();
  var argv: pchar := GetArgV();
  var op: int64 := 1;
  var bl: int64 := 64;
  var wdh: int64 := 1000;
  if (argc > 1) { op := StrToInt(ArgvGet(argv, 1)); }
  if (argc > 2) { var v2: int64 := StrToInt(ArgvGet(argv, 2)); if (v2 > 0) { bl := v2; } }
  if (argc > 3) { var v3: int64 := StrToInt(ArgvGet(argv, 3)); if (v3 > 0) { wdh := v3; } }
  if (op < 1 || op > 7) { PrintLn("op muss 1..7 sein"); return 2; }

  var key: pchar := alloc(48) as pchar;
  var blk: pchar := alloc(32) as pchar;
  var ek:  pchar := alloc(256) as pchar;
  var i: int64 := 0;
  while (i < 32) { StrSetChar(key, i, (i * 11) & 255); i += 1; }
  i := 0;
  while (i < 16) { StrSetChar(blk, i, i * 17); i += 1; }

  // Der Umschalter steht VOR der Expansion: op 6 soll auch den
  // Schluesselplan gerechnet erzeugen.
  if (op == 2 || op == 4 || op == 6) { AESForceSoftware(1); } else { AESForceSoftware(0); }

  var rounds: int64 := 10;
  if (op == 3 || op == 4) { rounds := 14; }
  if (rounds == 10) { AES128KeyExpand(key, ek); } else { AES256KeyExpand(key, ek); }

  var summe: int64 := 0;
  var r: int64 := 0;
  var k: int64 := 1;
  while (r < wdh) {
    var b: int64 := 0;
    while (b < bl) {
      k += 1;
      if (k > 15) { k := 1; }
      StrSetChar(blk, k, (k + b) & 255);
      if (op == 7) {
        summe := summe + StrCharAt(blk, k);
      } else if (op == 5 || op == 6) {
        AES128KeyExpand(key, ek);
        summe := summe + StrCharAt(ek, 160);
      } else {
        AESEncryptBlockWithKey(blk, ek, rounds);
        summe := summe + StrCharAt(blk, 0);
      }
      b += 1;
    }
    r += 1;
  }

  PrintStr("checksum="c);
  PrintLn(summe);
  return 0;
}
