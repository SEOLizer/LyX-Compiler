// bench/ec_p256.lyx — Messprogramm fuer std.crypto.ec (P-256).
//
// Aufruf: ec_p256 <was> <runden>, mit was = s(ignieren) | v(erify) |
// d(h) | k(eygen). Gemessen wird nicht in diesem Programm, sondern von
// aussen ueber die Befehlszahl; die Startkosten fallen durch die Differenz
// zweier Laeufe heraus:
//
//   a=$(perf stat -x, -e instructions:u -- ./ec_p256 d 1  2>&1 >/dev/null \
//        | awk -F, '/instructions/{print $1}')
//   b=$(perf stat -x, -e instructions:u -- ./ec_p256 d 11 2>&1 >/dev/null \
//        | awk -F, '/instructions/{print $1}')
//   echo $(( (b - a) / 10 ))      # Befehle je Aufruf
//
// Befehle statt Wanduhr, weil die Entwicklungsmaschine waehrend der Messung
// belegt war und die Wanduhr dann um den Faktor zwei streute. Stand
// 1.2.41 (#2096): signieren 29 Mio, pruefen 54 Mio, ECDH 27 Mio,
// Schluesselpaar 27 Mio.

unit main;
import std.io;
import std.string;
import std.alloc;
import std.crypto.ec;
import std.crypto.sha256;

fn main(): int64 {
  var was: pchar := GetArg(1) as pchar;
  var runden: int64 := StrToInt(GetArg(2) as pchar);
  var priv: int64 := alloc(32);
  var x: int64 := alloc(32);
  var y: int64 := alloc(32);
  var r: int64 := alloc(32);
  var s: int64 := alloc(32);
  var hash: int64 := alloc(32);
  var gem: int64 := alloc(32);
  var t: pchar := "Nachricht"c;
  SHA256(t as int64, StrLen(t), hash);
  if (!EcGenerateKey(EC_P256, priv, x, y)) { PrintLn("KEYFEHLER"); return 1; }

  // Eine echte Signatur, damit das Pruefen nicht am Nullwert fruehzeitig
  // abbricht und etwas ganz anderes gemessen wird.
  if (!EcdsaSign(EC_P256, hash, priv, r, s)) { PrintLn("SIGNFEHLER"); return 1; }
  if (!EcdsaVerify(EC_P256, hash, x, y, r, s)) { PrintLn("VERIFYFEHLER"); return 1; }
  var i: int64 := 0;
  var w: int64 := StrCharAt(was, 0);
  while (i < runden) {
    if (w == 115) { EcdsaSign(EC_P256, hash, priv, r, s); }          // sign
    if (w == 118) { EcdsaVerify(EC_P256, hash, x, y, r, s); }        // verify
    if (w == 100) { EcdhSharedSecret(EC_P256, priv, x, y, gem); }    // dh
    if (w == 107) { EcGenerateKey(EC_P256, priv, x, y); }            // keygen
    i := i + 1;
  }
  // Ergebnis anfassen, damit nichts wegoptimiert wird
  Print("fertig "); PrintInt(peek8(r) + peek8(s) + peek8(gem) + peek8(x)); PrintLn("");
  return 0;
}
