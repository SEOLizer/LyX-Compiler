// bench/arr_add_f32.lyx — elementweise f32-Addition (#2195).
//
// Aufruf:  arr_add_f32 <elemente> <wiederholungen>
//
// Der Kern, an dem die Entscheidung zu #2205 haengt: lohnt sich ein
// 256-Bit-Pfad? Deshalb wird er ueber DREI Groessen gemessen — eine, die in
// den L1 passt, eine in den L2, und eine darueber. Bei der letzten entscheidet
// die Speicherbandbreite, nicht die Vektorbreite; ein AVX2-Pfad kann dort
// nichts gewinnen, egal wie gut er kodiert ist.
//
// Gerechnet wird mit `parallel Array<f32>`, also ueber den vektorisierten
// Weg aus #2183/#2184. Die Pruefsumme haengt an allen Elementen; ein
// Compiler, der die Schleife wegoptimiert, faellt darueber auf.

@description("Benchmark: elementweise f32-Addition (#2195)")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")

import std.io;
import std.string;

fn main(): int64 {
  var argc: int64 := GetArgC();
  var argv: pchar := GetArgV();
  var n: int64 := 4096;
  var wdh: int64 := 1000;
  if (argc > 1) { var v1: int64 := StrToInt(ArgvGet(argv, 1)); if (v1 > 0) { n := v1; } }
  if (argc > 2) { var v2: int64 := StrToInt(ArgvGet(argv, 2)); if (v2 > 0) { wdh := v2; } }

  var a: parallel Array<f32> := parallel Array<f32>(n);
  var b: parallel Array<f32> := parallel Array<f32>(n);

  // Belegung so, dass die Summe exakt darstellbar bleibt: ganze Zahlen bis
  // 2^24 sind in f32 verlustfrei. Sonst haengt die Pruefsumme an der
  // Rundungsreihenfolge, und die darf sich zwischen 128 und 256 Bit
  // unterscheiden — dann waere ein Pruefsummenvergleich kein Nachweis mehr,
  // sondern eine Fehlerquelle.
  var i: int64 := 0;
  while (i < n) {
    a[i] := (i % 1000) as f64;
    b[i] := ((i * 7) % 1000) as f64;
    i += 1;
  }

  var summe: int64 := 0;
  var r: int64 := 0;
  while (r < wdh) {
    var c: parallel Array<f32> := a + b;
    // Nur ein Element je Wiederholung in die Pruefsumme: der Zugriff selbst
    // soll die Messung nicht dominieren, aber das Ergebnis muss gebraucht
    // werden, sonst darf der Compiler die Addition streichen.
    summe := summe + (c[r % n] as int64);
    r += 1;
  }

  PrintStr("checksum="c);
  PrintLn(summe);
  return 0;
}
