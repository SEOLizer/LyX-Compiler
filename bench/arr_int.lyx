// bench/arr_int.lyx — elementweise Ganzzahl-Kerne fuer 8/16/32 Bit (#2195).
//
// Aufruf:  arr_int <breite 8|16|32> <op 1=add 2=mul 3=sum> <elemente> <wiederholungen>
//
// `parallel Array` traegt nur f32/f64 (#2199 weist Ganzzahlen laut ab).
// Gemessen wird deshalb, was Lyx heute fuer Ganzzahlfelder erzeugt: eine
// skalare Schleife ueber peek/poke in der jeweiligen Breite. Die C-Fassung
// rechnet dasselbe auf uint8_t/uint16_t/uint32_t — gcc/clang vektorisieren
// dort, und genau dieser Abstand soll sichtbar werden.
//
// Alle Rechnungen sind vorzeichenlos modulo 2^breite, wie in C. Je
// Wiederholung wird ein Element von a veraendert, damit kein Compiler den
// Kern aus der Wiederholungsschleife ziehen darf; die Pruefsumme haengt an
// einem Ergebniselement (add/mul) bzw. an der ganzen Summe (sum).

@description("Benchmark: Ganzzahl-Feldkerne 8/16/32 Bit (#2195)")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")

import std.io;
import std.string;

fn lies(p: int64, breite: int64, i: int64): int64 {
  if (breite == 8)  { return peek8(p + i); }
  if (breite == 16) { return peek16(p + i * 2); }
  return peek32(p + i * 4) & 0xFFFFFFFF;
}

fn schreib(p: int64, breite: int64, i: int64, v: int64): void {
  if (breite == 8)  { poke8(p + i, v & 0xFF); return; }
  if (breite == 16) { poke16(p + i * 2, v & 0xFFFF); return; }
  poke32(p + i * 4, v & 0xFFFFFFFF);
}

// Die Kerne: je Breite und Operation eine eigene Schleife, damit keine
// Fallunterscheidung im heissen Pfad steht.
fn add8(a: int64, b: int64, c: int64, n: int64): void {
  var i: int64 := 0;
  while (i < n) { poke8(c + i, (peek8(a + i) + peek8(b + i)) & 0xFF); i += 1; }
}
fn add16(a: int64, b: int64, c: int64, n: int64): void {
  var i: int64 := 0;
  while (i < n) { var o: int64 := i * 2; poke16(c + o, (peek16(a + o) + peek16(b + o)) & 0xFFFF); i += 1; }
}
fn add32(a: int64, b: int64, c: int64, n: int64): void {
  var i: int64 := 0;
  while (i < n) { var o: int64 := i * 4; poke32(c + o, (peek32(a + o) + peek32(b + o)) & 0xFFFFFFFF); i += 1; }
}
fn mul8(a: int64, b: int64, c: int64, n: int64): void {
  var i: int64 := 0;
  while (i < n) { poke8(c + i, (peek8(a + i) * peek8(b + i)) & 0xFF); i += 1; }
}
fn mul16(a: int64, b: int64, c: int64, n: int64): void {
  var i: int64 := 0;
  while (i < n) { var o: int64 := i * 2; poke16(c + o, (peek16(a + o) * peek16(b + o)) & 0xFFFF); i += 1; }
}
fn mul32(a: int64, b: int64, c: int64, n: int64): void {
  var i: int64 := 0;
  while (i < n) { var o: int64 := i * 4; poke32(c + o, (peek32(a + o) * peek32(b + o)) & 0xFFFFFFFF); i += 1; }
}
fn sum8(a: int64, n: int64): int64 {
  var s: int64 := 0; var i: int64 := 0;
  while (i < n) { s := s + peek8(a + i); i += 1; }
  return s;
}
fn sum16(a: int64, n: int64): int64 {
  var s: int64 := 0; var i: int64 := 0;
  while (i < n) { s := s + peek16(a + i * 2); i += 1; }
  return s;
}
fn sum32(a: int64, n: int64): int64 {
  var s: int64 := 0; var i: int64 := 0;
  while (i < n) { s := s + (peek32(a + i * 4) & 0xFFFFFFFF); i += 1; }
  return s;
}

fn main(): int64 {
  var argc: int64 := GetArgC();
  var argv: pchar := GetArgV();
  var breite: int64 := 32;
  var op: int64 := 1;
  var n: int64 := 4096;
  var wdh: int64 := 1000;
  if (argc > 1) { breite := StrToInt(ArgvGet(argv, 1)); }
  if (argc > 2) { op := StrToInt(ArgvGet(argv, 2)); }
  if (argc > 3) { var v3: int64 := StrToInt(ArgvGet(argv, 3)); if (v3 > 0) { n := v3; } }
  if (argc > 4) { var v4: int64 := StrToInt(ArgvGet(argv, 4)); if (v4 > 0) { wdh := v4; } }
  if (breite != 8 && breite != 16 && breite != 32) { PrintLn("breite muss 8, 16 oder 32 sein"); return 2; }
  if (op < 1 || op > 3) { PrintLn("op muss 1 (add), 2 (mul) oder 3 (sum) sein"); return 2; }

  var bytes: int64 := n * (breite / 8);
  var a: int64 := alloc(bytes);
  var b: int64 := alloc(bytes);
  var c: int64 := alloc(bytes);

  var i: int64 := 0;
  while (i < n) {
    // Ueber die volle Breite verteilt, damit add und mul tatsaechlich
    // ueberlaufen; schreib() kappt auf die Breite.
    schreib(a, breite, i, i * 2654435761);
    schreib(b, breite, i, i * 40503 + 12345);
    i += 1;
  }

  var summe: int64 := 0;
  var r: int64 := 0;
  while (r < wdh) {
    var k: int64 := r % n;
    schreib(a, breite, k, lies(a, breite, k) + 1);
    if (op == 3) {
      if (breite == 8)       { summe := summe + sum8(a, n); }
      else if (breite == 16) { summe := summe + sum16(a, n); }
      else                   { summe := summe + sum32(a, n); }
    } else {
      if (op == 1) {
        if (breite == 8)       { add8(a, b, c, n); }
        else if (breite == 16) { add16(a, b, c, n); }
        else                   { add32(a, b, c, n); }
      } else {
        if (breite == 8)       { mul8(a, b, c, n); }
        else if (breite == 16) { mul16(a, b, c, n); }
        else                   { mul32(a, b, c, n); }
      }
      summe := summe + lies(c, breite, k);
    }
    r += 1;
  }

  PrintStr("checksum="c);
  PrintLn(summe);
  return 0;
}
