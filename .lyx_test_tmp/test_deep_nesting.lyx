// Test: Tiefe Verschachtelung und gemischte Kontrollstrukturen

// ----------------------------------------------------------------
// 1. if in if in if in if in if (5 Ebenen)
// ----------------------------------------------------------------
fn deepIf(a: int64, b: int64, c: int64, d: int64, e: int64): int64 {
  if (a > 0) {
    if (b > 0) {
      if (c > 0) {
        if (d > 0) {
          if (e > 0) { return 5; } else { return 4; }
        } else {
          if (e > 0) { return 40; } else { return 30; }
        }
      } else {
        return 20;
      }
    } else {
      return 10;
    }
  } else {
    return 0;
  }
}

fn testDeepIf(): int64 {
  if (deepIf(1,1,1,1,1) != 5)  { Print("FAIL deepIf(1,1,1,1,1)\n"); return 1; }
  if (deepIf(1,1,1,1,0) != 4)  { Print("FAIL deepIf(1,1,1,1,0)\n"); return 1; }
  if (deepIf(1,1,1,0,1) != 40) { Print("FAIL deepIf(1,1,1,0,1)\n"); return 1; }
  if (deepIf(1,1,1,0,0) != 30) { Print("FAIL deepIf(1,1,1,0,0)\n"); return 1; }
  if (deepIf(1,1,0,1,1) != 20) { Print("FAIL deepIf(1,1,0,*,*)\n"); return 1; }
  if (deepIf(1,0,1,1,1) != 10) { Print("FAIL deepIf(1,0,*,*,*)\n"); return 1; }
  if (deepIf(0,1,1,1,1) != 0)  { Print("FAIL deepIf(0,*,*,*,*)\n"); return 1; }
  Print("OK: 5-fach verschachteltes if\n");
  return 0;
}

// ----------------------------------------------------------------
// 2. break bricht nur die innere Schleife
//    5 äußere × (j bricht bei 3) → 5×3 = 15
// ----------------------------------------------------------------
fn testBreakInner(): int64 {
  var result: int64 := 0;
  var i: int64 := 0;
  while (i < 5) {
    var j: int64 := 0;
    while (j < 5) {
      if (j == 3) { break; }
      result := result + 1;
      j := j + 1;
    }
    i := i + 1;
  }
  if (result != 15) {
    Print("FAIL: break inner, got ");
    PrintInt(result);
    Print(" expected 15\n");
    return 1;
  }
  Print("OK: break bricht nur innere Schleife\n");
  return 0;
}

// ----------------------------------------------------------------
// 3. Äußere Schleife via Flag-Pattern abbrechen
//    i=0 → +5; i=1 → +5; i=2,j=0,1 → +2, dann stop
//    Erwartet: 12
// ----------------------------------------------------------------
fn testBreakOuter(): int64 {
  var result: int64 := 0;
  var stop: int64 := 0;
  var i: int64 := 0;
  while ((i < 5) && (stop == 0)) {
    var j: int64 := 0;
    while (j < 5) {
      if ((i == 2) && (j == 2)) {
        stop := 1;
        break;
      }
      result := result + 1;
      j := j + 1;
    }
    i := i + 1;
  }
  if (result != 12) {
    Print("FAIL: break outer via flag, got ");
    PrintInt(result);
    Print(" expected 12\n");
    return 1;
  }
  Print("OK: äußere Schleife via Flag-Break\n");
  return 0;
}

// ----------------------------------------------------------------
// 4. continue in zwei verschachtelten Schleifen
//    i=1,3 (ungerade): innere zählt j=1,3 → +2 je Durchlauf
//    i=2,4 (gerade): äußere continue
//    Erwartet: 4
// ----------------------------------------------------------------
fn testContinueNested(): int64 {
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < 4) {
    i := i + 1;
    if ((i % 2) == 0) { continue; }
    var j: int64 := 0;
    while (j < 4) {
      j := j + 1;
      if ((j % 2) == 0) { continue; }
      sum := sum + 1;
    }
  }
  if (sum != 4) {
    Print("FAIL: continue nested, got ");
    PrintInt(sum);
    Print(" expected 4\n");
    return 1;
  }
  Print("OK: continue in verschachtelten Schleifen\n");
  return 0;
}

// ----------------------------------------------------------------
// 5. while in if (beide Zweige)
//    flag=1: 3×3 - 3 diagonale = 6 Paare mit i!=j
//    flag=0: 0
// ----------------------------------------------------------------
fn whileInIf(flag: int64): int64 {
  var result: int64 := 0;
  if (flag > 0) {
    var i: int64 := 0;
    while (i < 3) {
      var j: int64 := 0;
      while (j < 3) {
        if (i != j) { result := result + 1; }
        j := j + 1;
      }
      i := i + 1;
    }
  }
  return result;
}

fn testWhileInIf(): int64 {
  if (whileInIf(1) != 6) {
    Print("FAIL: while in if (flag=1), got ");
    PrintInt(whileInIf(1));
    Print(" expected 6\n");
    return 1;
  }
  if (whileInIf(0) != 0) {
    Print("FAIL: while in if (flag=0)\n");
    return 1;
  }
  Print("OK: while in if\n");
  return 0;
}

// ----------------------------------------------------------------
// 6. switch in while in if (3 Strukturtypen kombiniert)
//    i=0 (mod=0): +0+1+2=+3; i=1 (mod=1): +1; i=2 (mod=0): +0+1+2=+3
//    Erwartet: 7   (3 + 1 + 3)
// ----------------------------------------------------------------
fn testSwitchInWhileInIf(): int64 {
  var sum: int64 := 0;
  var ok: int64 := 1;
  if (ok > 0) {
    var i: int64 := 0;
    while (i < 3) {
      switch (i % 2) {
        case 0: {
          var k: int64 := 0;
          while (k < 3) {
            sum := sum + k;
            k := k + 1;
          }
          break;
        }
        case 1: { sum := sum + 1; break; }
        default: { break; }
      }
      i := i + 1;
    }
  }
  if (sum != 7) {
    Print("FAIL: switch in while in if, got ");
    PrintInt(sum);
    Print(" expected 7\n");
    return 1;
  }
  Print("OK: switch in while in if\n");
  return 0;
}

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testDeepIf();
  failed := failed + testBreakInner();
  failed := failed + testBreakOuter();
  failed := failed + testContinueNested();
  failed := failed + testWhileInIf();
  failed := failed + testSwitchInWhileInIf();
  if (failed == 0) {
    Print("=== Alle Tiefe-Verschachtelung-Tests bestanden ===\n");
  } else {
    Print("=== FEHLER: ");
    PrintInt(failed);
    Print(" Test(s) fehlgeschlagen ===\n");
  }
  return failed;
}
