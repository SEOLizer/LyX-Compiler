// Test: if in switch/case, switch in while, switch in if

// ----------------------------------------------------------------
// 1. if innerhalb eines switch-case (2 Ebenen)
// ----------------------------------------------------------------
fn ifInCase(x: int64, flag: int64): int64 {
  switch (x) {
    case 1: {
      if (flag > 0) { return 11; } else { return 10; }
    }
    case 2: {
      if (flag > 0) {
        if (flag > 10) { return 222; } else { return 22; }
      } else {
        return 20;
      }
    }
    default: { return 0; }
  }
}

fn testIfInCase(): int64 {
  if (ifInCase(1, 5)  != 11)  { Print("FAIL: ifInCase(1,5)\n");  return 1; }
  if (ifInCase(1, 0)  != 10)  { Print("FAIL: ifInCase(1,0)\n");  return 1; }
  if (ifInCase(2, 15) != 222) { Print("FAIL: ifInCase(2,15)\n"); return 1; }
  if (ifInCase(2, 5)  != 22)  { Print("FAIL: ifInCase(2,5)\n");  return 1; }
  if (ifInCase(2, 0)  != 20)  { Print("FAIL: ifInCase(2,0)\n");  return 1; }
  if (ifInCase(9, 1)  != 0)   { Print("FAIL: ifInCase(9,1)\n");  return 1; }
  Print("OK: if in switch-case (2 Ebenen)\n");
  return 0;
}

// ----------------------------------------------------------------
// 2. switch in while + if im case
//    i=0: mod=0, i>0? nein → +0
//    i=1: mod=1 → +1
//    i=2: mod=2, i<5 → +2
//    i=3: mod=0, i>0 → +3
//    i=4: mod=1 → +1
//    i=5: mod=2, i<5? nein → +20
//    Erwartet: 27
// ----------------------------------------------------------------
fn testWhileSwitchIf(): int64 {
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < 6) {
    switch (i % 3) {
      case 0: {
        if (i > 0) { sum := sum + i; }
        break;
      }
      case 1: { sum := sum + 1; break; }
      case 2: {
        if (i < 5) { sum := sum + 2; } else { sum := sum + 20; }
        break;
      }
      default: { break; }
    }
    i := i + 1;
  }
  if (sum != 27) {
    Print("FAIL: while+switch+if, got ");
    PrintInt(sum);
    Print(" expected 27\n");
    return 1;
  }
  Print("OK: switch in while mit if in case\n");
  return 0;
}

// ----------------------------------------------------------------
// 3. switch innerhalb eines if
// ----------------------------------------------------------------
fn caseInIf(mode: int64, x: int64): int64 {
  if (mode == 1) {
    switch (x) {
      case 10: { return 110; }
      case 20: { return 120; }
      default: { return 100; }
    }
  } else {
    if (mode == 2) {
      switch (x) {
        case 10: { return 210; }
        default: { return 200; }
      }
    } else {
      return 0;
    }
  }
}

fn testCaseInIf(): int64 {
  if (caseInIf(1, 10) != 110) { Print("FAIL: caseInIf(1,10)\n"); return 1; }
  if (caseInIf(1, 20) != 120) { Print("FAIL: caseInIf(1,20)\n"); return 1; }
  if (caseInIf(1, 99) != 100) { Print("FAIL: caseInIf(1,99)\n"); return 1; }
  if (caseInIf(2, 10) != 210) { Print("FAIL: caseInIf(2,10)\n"); return 1; }
  if (caseInIf(2, 99) != 200) { Print("FAIL: caseInIf(2,99)\n"); return 1; }
  if (caseInIf(3, 10) != 0)   { Print("FAIL: caseInIf(3,10)\n"); return 1; }
  Print("OK: switch in if (verschachtelt)\n");
  return 0;
}

// ----------------------------------------------------------------
// 4. switch in switch (verschachtelt)
// ----------------------------------------------------------------
fn switchInSwitch(a: int64, b: int64): int64 {
  switch (a) {
    case 1: {
      switch (b) {
        case 10: { return 110; }
        case 20: { return 120; }
        default: { return 100; }
      }
    }
    case 2: {
      switch (b) {
        case 10: { return 210; }
        default: { return 200; }
      }
    }
    default: { return 0; }
  }
}

fn testSwitchInSwitch(): int64 {
  if (switchInSwitch(1, 10) != 110) { Print("FAIL: switchInSwitch(1,10)\n"); return 1; }
  if (switchInSwitch(1, 20) != 120) { Print("FAIL: switchInSwitch(1,20)\n"); return 1; }
  if (switchInSwitch(1, 99) != 100) { Print("FAIL: switchInSwitch(1,99)\n"); return 1; }
  if (switchInSwitch(2, 10) != 210) { Print("FAIL: switchInSwitch(2,10)\n"); return 1; }
  if (switchInSwitch(2, 99) != 200) { Print("FAIL: switchInSwitch(2,99)\n"); return 1; }
  if (switchInSwitch(9, 10) != 0)   { Print("FAIL: switchInSwitch(9,10)\n"); return 1; }
  Print("OK: switch in switch (verschachtelt)\n");
  return 0;
}

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testIfInCase();
  failed := failed + testWhileSwitchIf();
  failed := failed + testCaseInIf();
  failed := failed + testSwitchInSwitch();
  if (failed == 0) {
    Print("=== Alle Switch/Case-Verschachtelungs-Tests bestanden ===\n");
  } else {
    Print("=== FEHLER: ");
    PrintInt(failed);
    Print(" Test(s) fehlgeschlagen ===\n");
  }
  return failed;
}
