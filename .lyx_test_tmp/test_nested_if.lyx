// Test: verschachtelte IF-Strukturen

// ----------------------------------------------------------------
// 1. if in if in if (3 Ebenen, alle 8 Kombinationen)
// ----------------------------------------------------------------
fn tripleIf(a: int64, b: int64, c: int64): int64 {
  if (a > 0) {
    if (b > 0) {
      if (c > 0) { return 7; } else { return 6; }
    } else {
      if (c > 0) { return 5; } else { return 4; }
    }
  } else {
    if (b > 0) {
      if (c > 0) { return 3; } else { return 2; }
    } else {
      if (c > 0) { return 1; } else { return 0; }
    }
  }
}

fn testTripleIf(): int64 {
  if (tripleIf(1, 1, 1) != 7) { Print("FAIL tripleIf(+,+,+)\n"); return 1; }
  if (tripleIf(1, 1, 0) != 6) { Print("FAIL tripleIf(+,+,-)\n"); return 1; }
  if (tripleIf(1, 0, 1) != 5) { Print("FAIL tripleIf(+,-,+)\n"); return 1; }
  if (tripleIf(1, 0, 0) != 4) { Print("FAIL tripleIf(+,-,-)\n"); return 1; }
  if (tripleIf(0, 1, 1) != 3) { Print("FAIL tripleIf(-,+,+)\n"); return 1; }
  if (tripleIf(0, 1, 0) != 2) { Print("FAIL tripleIf(-,+,-)\n"); return 1; }
  if (tripleIf(0, 0, 1) != 1) { Print("FAIL tripleIf(-,-,+)\n"); return 1; }
  if (tripleIf(0, 0, 0) != 0) { Print("FAIL tripleIf(-,-,-)\n"); return 1; }
  Print("OK: triple IF (3 Ebenen, alle 8 Kombinationen)\n");
  return 0;
}

// ----------------------------------------------------------------
// 2. if in while in while
//    diag(0+1+2+3+4=10) + upper(10 Paare i>j, jeweils +1) = 20
// ----------------------------------------------------------------
fn testIfInWhileInWhile(): int64 {
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < 5) {
    var j: int64 := 0;
    while (j < 5) {
      if (i == j) {
        sum := sum + i;
      } else {
        if (i > j) {
          sum := sum + 1;
        }
      }
      j := j + 1;
    }
    i := i + 1;
  }
  if (sum != 20) {
    Print("FAIL: if in while in while, got ");
    PrintInt(sum);
    Print(" expected 20\n");
    return 1;
  }
  Print("OK: if in while in while\n");
  return 0;
}

// ----------------------------------------------------------------
// 3. break + continue in einer while-Schleife
//    i=0,2,4,6 (gerade) → continue; i=7 → break
//    gezählt werden: i=1,3,5 → 1+3+5=9
// ----------------------------------------------------------------
fn testBreakContinue(): int64 {
  var result: int64 := 0;
  var i: int64 := 0;
  while (i < 10) {
    if (i == 7) { break; }
    if ((i % 2) == 0) {
      i := i + 1;
      continue;
    }
    result := result + i;
    i := i + 1;
  }
  if (result != 9) {
    Print("FAIL: break+continue, got ");
    PrintInt(result);
    Print(" expected 9\n");
    return 1;
  }
  Print("OK: break+continue in while\n");
  return 0;
}

// ----------------------------------------------------------------
// 4. if in verschachtelten while-Schleifen (wie for-in-for)
//    i<j: wenn i+j>4 → +10, sonst +1
//    (0,1),(0,2),(0,3) → +3; (1,2),(1,3) → +2; (2,3): 5>4 → +10
//    Erwartet: 15
// ----------------------------------------------------------------
fn testIfInNestedWhile(): int64 {
  var count: int64 := 0;
  var i: int64 := 0;
  while (i < 4) {
    var j: int64 := 0;
    while (j < 4) {
      if (i < j) {
        if ((i + j) > 4) {
          count := count + 10;
        } else {
          count := count + 1;
        }
      }
      j := j + 1;
    }
    i := i + 1;
  }
  if (count != 15) {
    Print("FAIL: if in nested while, got ");
    PrintInt(count);
    Print(" expected 15\n");
    return 1;
  }
  Print("OK: if in verschachtelten while-Schleifen\n");
  return 0;
}

fn main(): int64 {
  var failed: int64 := 0;
  failed := failed + testTripleIf();
  failed := failed + testIfInWhileInWhile();
  failed := failed + testBreakContinue();
  failed := failed + testIfInNestedWhile();
  if (failed == 0) {
    Print("=== Alle IF-Verschachtelungs-Tests bestanden ===\n");
  } else {
    Print("=== FEHLER: ");
    PrintInt(failed);
    Print(" Test(s) fehlgeschlagen ===\n");
  }
  return failed;
}
