// Lyx Data Library - Pretty-printing
// Human-readable ASCII table rendering of a typed DataFrame, for debugging and
// REPL use. Columns are width-aligned; cell values are rendered by DataType
// (including compact List/Struct forms); NULL shows as an empty cell.
//
// Example:
//   id | price    | name
//   ---+----------+-----
//   1  | 3.500000 | Ann
//   2  |          | Bob

@description("Pretty ASCII table printing for the Lyx data framework")
@author("Andreas Röne")
@copyright("2024-2026 Andreas Röne")
unit data.print;

import data.kernel;
import data.frame;

// ---- primitive formatting (append to a Buffer) -----------------------------

fn _pushInt64(b: Buffer, v: int64) {
  if (v == 0) { BufferPushByte(b, 48); return; }
  var neg: int64 := 0;
  var n: int64 := v;
  if (n < 0) { neg := 1; n := 0 - n; }
  var tmp: int64 := mmap(0, 24, PROT_RW, MAP_ANON, FD_NONE, 0);
  var cnt: int64 := 0;
  while (n > 0) {
    poke8(tmp + cnt, 48 + (n - (n / 10) * 10));
    n := n / 10;
    cnt += 1;
  }
  if (neg != 0) { BufferPushByte(b, 45); }
  var i: int64 := cnt - 1;
  while (i >= 0) { BufferPushByte(b, peek8(tmp + i)); i := i - 1; }
  munmap(tmp, 24);
}

fn _pushFloat64(b: Buffer, v: f64) {
  var x: f64 := v;
  if (x < 0.0) { BufferPushByte(b, 45); x := 0.0 - x; }
  var ipart: int64 := x as int64;
  _pushInt64(b, ipart);
  BufferPushByte(b, 46);
  var frac: f64 := x - (ipart as f64);
  var d: int64 := 0;
  while (d < 6) {
    frac := frac * 10.0;
    var digit: int64 := frac as int64;
    BufferPushByte(b, 48 + digit);
    frac := frac - (digit as f64);
    d += 1;
  }
}

// Render cell df[col,row] into `out`; returns the number of bytes appended.
// NULL renders as nothing (an empty, blank cell).
fn _cellStr(b: Buffer, df: DataFrame, col: int64, row: int64): int64 {
  var start: int64 := b.len;
  if (DataFrameIsValid(df, col, row) == 0) { return 0; }
  var t: int64 := DataFrameColType(df, col);
  if (t == DT_FLOAT64) {
    _pushFloat64(b, DataFrameGetFloat64(df, col, row));
  } else if (t == DT_UTF8) {
    var p: int64 := DataFrameGetUtf8Ptr(df, col, row);
    var l: int64 := DataFrameGetUtf8Len(df, col, row);
    if (l > 0) { BufferPushBytes(b, p, l); }
  } else if (t == DT_LIST) {
    BufferPushByte(b, 91);  // '['
    var n: int64 := DataFrameGetListLen(df, col, row);
    var j: int64 := 0;
    while (j < n) {
      if (j > 0) { BufferPushByte(b, 44); BufferPushByte(b, 32); }  // ", "
      _pushInt64(b, DataFrameGetListElemInt64(df, col, row, j));
      j += 1;
    }
    BufferPushByte(b, 93);  // ']'
  } else if (t == DT_STRUCT) {
    BufferPushByte(b, 123);  // '{'
    var dt: DataType := df.columns[col].field.dtype;
    var f: int64 := 0;
    while (f < dt.fieldCount) {
      if (f > 0) { BufferPushByte(b, 44); BufferPushByte(b, 32); }
      BufferPushBytes(b, peek64(dt.fields + f * 24), peek64(dt.fields + f * 24 + 8));
      BufferPushByte(b, 61);  // '='
      if (peek64(dt.fields + f * 24 + 16) == DT_FLOAT64) {
        _pushFloat64(b, DataFrameGetStructFieldFloat64(df, col, row, f));
      } else {
        _pushInt64(b, DataFrameGetStructFieldInt64(df, col, row, f));
      }
      f += 1;
    }
    BufferPushByte(b, 125);  // '}'
  } else {
    _pushInt64(b, DataFrameGetInt64(df, col, row));
  }
  return b.len - start;
}

// Width of cell df[col,row]'s rendered form (without keeping the bytes).
fn _cellWidth(scratch: Buffer, df: DataFrame, col: int64, row: int64): int64 {
  scratch.len := 0;
  return _cellStr(scratch, df, col, row);
}

fn _pushSpaces(b: Buffer, n: int64) {
  var i: int64 := 0;
  while (i < n) { BufferPushByte(b, 32); i := i + 1; }
}

// Build the full rendered table (header, separator, rows) into a Buffer, showing
// at most `maxRows` data rows (a value <= 0 means all rows). Caller frees it.
pub fn DataFrameToStringBuffer(df: DataFrame, maxRows: int64): Buffer {
  var out: Buffer := BufferNew(256);
  var scratch: Buffer := BufferNew(64);

  var rowsShown: int64 := df.rowCount;
  if (maxRows > 0 && maxRows < rowsShown) { rowsShown := maxRows; }

  // Column widths: max of header name and the rendered cells actually shown.
  var widths: int64 := mmap(0, df.colCount * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  var c: int64 := 0;
  while (c < df.colCount) {
    var w: int64 := df.columns[c].field.nameLen;
    var r: int64 := 0;
    while (r < rowsShown) {
      var cw: int64 := _cellWidth(scratch, df, c, r);
      if (cw > w) { w := cw; }
      r += 1;
    }
    poke64(widths + c * 8, w);
    c += 1;
  }

  // Header row.
  var hc: int64 := 0;
  while (hc < df.colCount) {
    if (hc > 0) { BufferPushByte(out, 32); BufferPushByte(out, 124); BufferPushByte(out, 32); }  // " | "
    var wname: int64 := df.columns[hc].field.nameLen;
    BufferPushBytes(out, df.columns[hc].field.name, wname);
    _pushSpaces(out, peek64(widths + hc * 8) - wname);
    hc += 1;
  }
  BufferPushByte(out, 10);

  // Separator row: dashes per column, joined by "-+-".
  var sc: int64 := 0;
  while (sc < df.colCount) {
    if (sc > 0) { BufferPushByte(out, 45); BufferPushByte(out, 43); BufferPushByte(out, 45); }  // "-+-"
    var wd: int64 := peek64(widths + sc * 8);
    var k: int64 := 0;
    while (k < wd) { BufferPushByte(out, 45); k := k + 1; }  // '-'
    sc += 1;
  }
  BufferPushByte(out, 10);

  // Data rows.
  var rr: int64 := 0;
  while (rr < rowsShown) {
    var dc: int64 := 0;
    while (dc < df.colCount) {
      if (dc > 0) { BufferPushByte(out, 32); BufferPushByte(out, 124); BufferPushByte(out, 32); }
      var cellLen: int64 := _cellStr(out, df, dc, rr);
      _pushSpaces(out, peek64(widths + dc * 8) - cellLen);
      dc += 1;
    }
    BufferPushByte(out, 10);
    rr += 1;
  }

  // Footnote if truncated.
  if (rowsShown < df.rowCount) {
    BufferPushByte(out, 46); BufferPushByte(out, 46); BufferPushByte(out, 46);  // "..."
    BufferPushByte(out, 32);
    _pushInt64(out, df.rowCount - rowsShown);
    BufferPushBytes(out, " more rows"c as int64, 10);
    BufferPushByte(out, 10);
  }

  munmap(widths, df.colCount * 8);
  BufferFree(scratch);
  return out;
}

// Print the whole DataFrame as an aligned table to stdout.
pub fn DataFramePrint(df: DataFrame) {
  var b: Buffer := DataFrameToStringBuffer(df, 0);
  if (b.len > 0) { write(1, b.data, b.len); }
  BufferFree(b);
}

// Print at most `maxRows` data rows (with a "... N more rows" footnote).
pub fn DataFramePrintN(df: DataFrame, maxRows: int64) {
  var b: Buffer := DataFrameToStringBuffer(df, maxRows);
  if (b.len > 0) { write(1, b.data, b.len); }
  BufferFree(b);
}
