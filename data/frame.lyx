// Lyx Data Library - L2 Structure
// Typed, null-aware columnar tables built on the L1 kernel primitives.
//
// This layer turns the raw Buffer/Bitmap/DataType primitives into the objects
// higher layers (operations, IO) actually work with:
//   - Field:     a named, typed, nullable column descriptor
//   - Column:    values (Buffer) + validity (Bitmap) + Field, kept in lockstep
//   - DataFrame: a growable Array<Column> plus row bookkeeping
//
// Design notes:
//   - Lyx structs have REFERENCE semantics (a struct variable is a heap object;
//     a nested struct field holds a pointer to another object). So a Column's
//     `values`/`validity` are assigned whole (`c.values := BufferNew(...)`),
//     never filled field-by-field into an unallocated slot.
//   - Columns live inline in an Array<Column> (16-byte [cap|len] header, then
//     sizeof(Column)-byte elements). Each element stores pointers to its Field/
//     Buffer/Bitmap, so growing the array (mmap+memcpy) never disturbs them.
//   - There is exactly ONE length per column (Column.length, mirrored by the
//     Buffer/Bitmap element counts). No duplicated bookkeeping — the source of
//     the data.core Series double-truth bug is gone.
//   - Rectangular by construction: DataFrameAppendRow extends every column with
//     a NULL cell, and DataFrameAddColumn back-fills existing rows with NULLs.
//   - This first cut covers int64 + NULL columns. Float64/Utf8/nested List land
//     in the next increment; the DataType tag is already carried per column.

@description("L2 typed columnar structures for the Lyx data framework (Field, Column, DataFrame)")
@author("Andreas Röne")
@copyright("2024-2026 Andreas Röne")
unit data.frame;

import data.kernel;

// ============================================================================
// Field — named, typed, nullable column descriptor
// ============================================================================

pub type Field = struct {
  name: int64;        // pchar (column name)
  nameLen: int64;     // byte length of name
  dtype: DataType;    // reference to the column's type descriptor
  nullable: int64;    // 1 = may contain NULLs, 0 = not
};

pub fn FieldNew(name: int64, nameLen: int64, dtype: DataType, nullable: int64): Field {
  var f: Field;
  f.name := name;
  f.nameLen := nameLen;
  f.dtype := dtype;
  f.nullable := nullable;
  return f;
}

// ============================================================================
// Column — values + validity + descriptor, always the same length
// ============================================================================

pub type Column = struct {
  field: Field;        // name + type + nullability
  values: Buffer;      // fixed-width 8-byte slots: int64 / f64 bits / Utf8 offset
  validity: Bitmap;    // per-element NULL mask (1 = valid)
  aux: Buffer;         // variable-length payload (Utf8 bytes); empty otherwise
  length: int64;       // logical element count (single source of truth)
};

// Initialise a Column *in place* through a reference (e.g. an Array<Column>
// slot whose pointers are still zero). Uses whole-struct assignment for the
// nested Buffer/Bitmap/Field, per Lyx reference semantics.
fn _columnInit(c: Column, name: int64, nameLen: int64, dtype: DataType, nullable: int64, cap: int64) {
  c.field := FieldNew(name, nameLen, dtype, nullable);
  c.values := BufferNew(cap * 8);   // 8 bytes per fixed-width slot
  c.validity := BitmapNew(cap);
  c.aux := BufferNew(16);           // grows only when the column holds Utf8
  c.length := 0;
}

// Construct a standalone Column.
pub fn ColumnNew(name: int64, nameLen: int64, dtype: DataType, nullable: int64, cap: int64): Column {
  var c: Column;
  _columnInit(c, name, nameLen, dtype, nullable, cap);
  return c;
}

// Append an int64 value (marked valid). Returns 1 on success, 0 on OOM.
pub fn ColumnAppendInt64(c: Column, value: int64): int64 {
  if (BufferPushInt64(c.values, value) == 0) { return 0; }
  if (BitmapAppend(c.validity, 1) == 0) { return 0; }
  c.length += 1;
  return 1;
}

// Append a NULL cell (slot still occupies space so indices stay aligned).
pub fn ColumnAppendNull(c: Column): int64 {
  if (BufferPushInt64(c.values, 0) == 0) { return 0; }
  if (BitmapAppend(c.validity, 0) == 0) { return 0; }
  c.length += 1;
  return 1;
}

// Read the int64 at `idx`. Returns 0 if out of range; use ColumnIsValid to
// distinguish a real 0 from NULL.
pub fn ColumnGetInt64(c: Column, idx: int64): int64 {
  return BufferGetInt64(c.values, idx);
}

// 1 if the cell at `idx` holds a real value, 0 if NULL / out of range.
pub fn ColumnIsValid(c: Column, idx: int64): int64 {
  return BitmapGet(c.validity, idx);
}

// Overwrite `idx` with an int64 value and mark it valid. Returns 1 on success,
// 0 if out of range.
pub fn ColumnSetInt64(c: Column, idx: int64, value: int64): int64 {
  if (BufferSetInt64(c.values, idx, value) == 0) { return 0; }
  BitmapSet(c.validity, idx, 1);
  return 1;
}

// Mark `idx` as NULL (value left in place but reported invalid).
pub fn ColumnSetNull(c: Column, idx: int64) {
  BitmapSet(c.validity, idx, 0);
}

// Count of non-NULL cells.
pub fn ColumnCountValid(c: Column): int64 {
  return BitmapCountValid(c.validity);
}

// Sum of the valid int64 cells (NULLs skipped).
pub fn ColumnSumInt64(c: Column): int64 {
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < c.length) {
    if (BitmapGet(c.validity, i) != 0) {
      sum := sum + BufferGetInt64(c.values, i);
    }
    i += 1;
  }
  return sum;
}

// ---- Float64 cells ---------------------------------------------------------

// Append an f64 value (marked valid). Returns 1 on success, 0 on OOM.
pub fn ColumnAppendFloat64(c: Column, value: f64): int64 {
  if (BufferPushFloat64(c.values, value) == 0) { return 0; }
  if (BitmapAppend(c.validity, 1) == 0) { return 0; }
  c.length += 1;
  return 1;
}

// Read the f64 at `idx` (0.0 if out of range; check ColumnIsValid for NULL).
pub fn ColumnGetFloat64(c: Column, idx: int64): f64 {
  return BufferGetFloat64(c.values, idx);
}

// Overwrite `idx` with an f64 and mark it valid. Returns 1 on success.
pub fn ColumnSetFloat64(c: Column, idx: int64, value: f64): int64 {
  if (BufferSetFloat64(c.values, idx, value) == 0) { return 0; }
  BitmapSet(c.validity, idx, 1);
  return 1;
}

// Sum of the valid f64 cells (NULLs skipped).
pub fn ColumnSumFloat64(c: Column): f64 {
  var sum: f64 := 0.0;
  var i: int64 := 0;
  while (i < c.length) {
    if (BitmapGet(c.validity, i) != 0) {
      sum := sum + BufferGetFloat64(c.values, i);
    }
    i += 1;
  }
  return sum;
}

// ---- Utf8 (variable-length string) cells -----------------------------------
//
// The fixed slot in `values` holds a byte offset into `aux`, where the string
// is stored length-prefixed: [len:int64][bytes...]. NULL is tracked by the
// validity bitmap, so an offset of 0 is never confused with a NULL cell.

// Append a string (copied into the column). Returns 1 on success, 0 on OOM.
pub fn ColumnAppendUtf8(c: Column, strPtr: int64, strLen: int64): int64 {
  var off: int64 := c.aux.len;
  if (BufferPushInt64(c.aux, strLen) == 0) { return 0; }
  if (strLen > 0) {
    if (BufferPushBytes(c.aux, strPtr, strLen) < 0) { return 0; }
  }
  if (BufferPushInt64(c.values, off) == 0) { return 0; }
  if (BitmapAppend(c.validity, 1) == 0) { return 0; }
  c.length += 1;
  return 1;
}

// Byte length of the string at `idx` (0 if NULL / out of range).
pub fn ColumnGetUtf8Len(c: Column, idx: int64): int64 {
  if (BitmapGet(c.validity, idx) == 0) { return 0; }
  var off: int64 := BufferGetInt64(c.values, idx);
  return peek64(BufferByteAddr(c.aux, off));
}

// Pointer to the string bytes at `idx` (NOT NUL-terminated). Returns 0 if NULL.
// NOTE: a view into `aux` — only valid until the next Utf8 append/set, which
// may grow and move that buffer. Copy the bytes (or use ColumnGetUtf8Into) if
// you need to keep them.
pub fn ColumnGetUtf8Ptr(c: Column, idx: int64): int64 {
  if (BitmapGet(c.validity, idx) == 0) { return 0; }
  var off: int64 := BufferGetInt64(c.values, idx);
  return BufferByteAddr(c.aux, off) + 8;   // skip the length prefix
}

// Copy the string at `idx` into `dest` (NUL-terminated, truncated to destCap-1
// bytes) and return the full stored length. dest gets an empty string for NULL.
pub fn ColumnGetUtf8Into(c: Column, idx: int64, dest: int64, destCap: int64): int64 {
  if (destCap <= 0) { return 0; }
  if (BitmapGet(c.validity, idx) == 0) { poke8(dest, 0); return 0; }
  var off: int64 := BufferGetInt64(c.values, idx);
  var base: int64 := BufferByteAddr(c.aux, off);
  var len: int64 := peek64(base);
  var n: int64 := len;
  if (n > destCap - 1) { n := destCap - 1; }
  if (n < 0) { n := 0; }
  memcpy(dest, base + 8, n);
  poke8(dest + n, 0);
  return len;
}

// Overwrite the cell at `idx` with a new string (appended to aux; the old blob
// is left orphaned in aux — acceptable slack for the first cut). Marks valid.
pub fn ColumnSetUtf8(c: Column, idx: int64, strPtr: int64, strLen: int64): int64 {
  if (idx < 0 || idx >= c.length) { return 0; }
  var off: int64 := c.aux.len;
  if (BufferPushInt64(c.aux, strLen) == 0) { return 0; }
  if (strLen > 0) {
    if (BufferPushBytes(c.aux, strPtr, strLen) < 0) { return 0; }
  }
  BufferSetInt64(c.values, idx, off);
  BitmapSet(c.validity, idx, 1);
  return 1;
}

// ---- List<Int64> (nested) cells --------------------------------------------
//
// A nested list is stored in `aux` just like Utf8: the fixed slot holds a byte
// offset, and at that offset aux holds [count:int64][elem0:int64][elem1]...
// Offsets (not pointers) are stored, so growing/moving aux never dangles a cell.
// Build the column with dtype dtList(dtBox(dtNew(DT_INT64))).

// Append a list of `n` int64 values (copied from `elems`). Returns 1, or 0 on OOM.
pub fn ColumnAppendListInt64(c: Column, elems: int64, n: int64): int64 {
  var off: int64 := c.aux.len;
  if (BufferPushInt64(c.aux, n) == 0) { return 0; }
  var i: int64 := 0;
  while (i < n) {
    if (BufferPushInt64(c.aux, peek64(elems + i * 8)) == 0) { return 0; }
    i += 1;
  }
  if (BufferPushInt64(c.values, off) == 0) { return 0; }
  if (BitmapAppend(c.validity, 1) == 0) { return 0; }
  c.length += 1;
  return 1;
}

// Number of elements in the list at `idx` (0 if NULL / out of range).
pub fn ColumnGetListLen(c: Column, idx: int64): int64 {
  if (BitmapGet(c.validity, idx) == 0) { return 0; }
  var off: int64 := BufferGetInt64(c.values, idx);
  return peek64(BufferByteAddr(c.aux, off));
}

// Element `j` of the list at `idx` (0 if NULL / out of range).
pub fn ColumnGetListElemInt64(c: Column, idx: int64, j: int64): int64 {
  if (BitmapGet(c.validity, idx) == 0) { return 0; }
  var off: int64 := BufferGetInt64(c.values, idx);
  var base: int64 := BufferByteAddr(c.aux, off);
  var cnt: int64 := peek64(base);
  if (j < 0 || j >= cnt) { return 0; }
  return peek64(base + 8 + j * 8);
}

// Overwrite the list cell at `idx` with a new list (the old blob is left
// orphaned in aux). Marks the cell valid. Returns 1, or 0 on OOM/out of range.
pub fn ColumnSetListInt64(c: Column, idx: int64, elems: int64, n: int64): int64 {
  if (idx < 0 || idx >= c.length) { return 0; }
  var off: int64 := c.aux.len;
  if (BufferPushInt64(c.aux, n) == 0) { return 0; }
  var i: int64 := 0;
  while (i < n) {
    if (BufferPushInt64(c.aux, peek64(elems + i * 8)) == 0) { return 0; }
    i += 1;
  }
  BufferSetInt64(c.values, idx, off);
  BitmapSet(c.validity, idx, 1);
  return 1;
}

// ---- List<Float64> ---------------------------------------------------------
// Same [count][elem...] aux layout as List<Int64>; elements are f64 bits. The
// shared ColumnGetListLen works (identical count prefix). Build the column with
// dtype dtList(dtBox(dtNew(DT_FLOAT64))).

// Append a list of `n` f64 values read from the f64 array at `elems`.
pub fn ColumnAppendListFloat64(c: Column, elems: int64, n: int64): int64 {
  var off: int64 := c.aux.len;
  if (BufferPushInt64(c.aux, n) == 0) { return 0; }
  var i: int64 := 0;
  while (i < n) {
    if (BufferPushFloat64(c.aux, peekf64(elems + i * 8)) == 0) { return 0; }
    i += 1;
  }
  if (BufferPushInt64(c.values, off) == 0) { return 0; }
  if (BitmapAppend(c.validity, 1) == 0) { return 0; }
  c.length += 1;
  return 1;
}

// Element `j` (f64) of the list at `idx` (0.0 if NULL / out of range).
pub fn ColumnGetListElemFloat64(c: Column, idx: int64, j: int64): f64 {
  if (BitmapGet(c.validity, idx) == 0) { return 0.0; }
  var off: int64 := BufferGetInt64(c.values, idx);
  var base: int64 := BufferByteAddr(c.aux, off);
  var cnt: int64 := peek64(base);
  if (j < 0 || j >= cnt) { return 0.0; }
  return peekf64(base + 8 + j * 8);
}

pub fn ColumnSetListFloat64(c: Column, idx: int64, elems: int64, n: int64): int64 {
  if (idx < 0 || idx >= c.length) { return 0; }
  var off: int64 := c.aux.len;
  if (BufferPushInt64(c.aux, n) == 0) { return 0; }
  var i: int64 := 0;
  while (i < n) {
    if (BufferPushFloat64(c.aux, peekf64(elems + i * 8)) == 0) { return 0; }
    i += 1;
  }
  BufferSetInt64(c.values, idx, off);
  BitmapSet(c.validity, idx, 1);
  return 1;
}

// ---- List<Utf8> ------------------------------------------------------------
// aux layout: [count:int64] then per element [len:int64][bytes...]. Element
// access walks from the front (O(j)). Build the column with dtype
// dtList(dtBox(dtNew(DT_UTF8))).

// Append a list of `n` strings. `ptrs` is an array of pchar pointers and `lens`
// the matching int64 byte-lengths.
pub fn ColumnAppendListUtf8(c: Column, ptrs: int64, lens: int64, n: int64): int64 {
  var off: int64 := c.aux.len;
  if (BufferPushInt64(c.aux, n) == 0) { return 0; }
  var i: int64 := 0;
  while (i < n) {
    var el: int64 := peek64(lens + i * 8);
    if (BufferPushInt64(c.aux, el) == 0) { return 0; }
    if (el > 0) {
      if (BufferPushBytes(c.aux, peek64(ptrs + i * 8), el) < 0) { return 0; }
    }
    i += 1;
  }
  if (BufferPushInt64(c.values, off) == 0) { return 0; }
  if (BitmapAppend(c.validity, 1) == 0) { return 0; }
  c.length += 1;
  return 1;
}

// Overwrite the Utf8-list cell at `idx` (old blob orphaned in aux). Marks valid.
pub fn ColumnSetListUtf8(c: Column, idx: int64, ptrs: int64, lens: int64, n: int64): int64 {
  if (idx < 0 || idx >= c.length) { return 0; }
  var off: int64 := c.aux.len;
  if (BufferPushInt64(c.aux, n) == 0) { return 0; }
  var i: int64 := 0;
  while (i < n) {
    var el: int64 := peek64(lens + i * 8);
    if (BufferPushInt64(c.aux, el) == 0) { return 0; }
    if (el > 0) {
      if (BufferPushBytes(c.aux, peek64(ptrs + i * 8), el) < 0) { return 0; }
    }
    i += 1;
  }
  BufferSetInt64(c.values, idx, off);
  BitmapSet(c.validity, idx, 1);
  return 1;
}

// Walk to element `j` of the Utf8 list at [idx], returning the byte address of
// its [len] prefix (0 if NULL / out of range). Internal helper.
fn _listUtf8ElemBase(c: Column, idx: int64, j: int64): int64 {
  if (BitmapGet(c.validity, idx) == 0) { return 0; }
  var off: int64 := BufferGetInt64(c.values, idx);
  var base: int64 := BufferByteAddr(c.aux, off);
  var cnt: int64 := peek64(base);
  if (j < 0 || j >= cnt) { return 0; }
  var pos: int64 := base + 8;
  var e: int64 := 0;
  while (e < j) {
    pos := pos + 8 + peek64(pos);  // skip [len][bytes]
    e += 1;
  }
  return pos;
}

// Byte length of element `j` of the Utf8 list at [idx] (0 if NULL / out of range).
pub fn ColumnGetListElemUtf8Len(c: Column, idx: int64, j: int64): int64 {
  var p: int64 := _listUtf8ElemBase(c, idx, j);
  if (p == 0) { return 0; }
  return peek64(p);
}

// Pointer to the bytes of element `j` of the Utf8 list at [idx] (0 if NULL /
// out of range). Valid until the next aux mutation.
pub fn ColumnGetListElemUtf8Ptr(c: Column, idx: int64, j: int64): int64 {
  var p: int64 := _listUtf8ElemBase(c, idx, j);
  if (p == 0) { return 0; }
  return p + 8;  // skip the length prefix
}

// ---- Struct (nested record) cells ------------------------------------------
//
// A struct column holds records with a fixed set of named int64 fields. The
// field schema (names) lives in the column's DataType (dtStruct); each cell is
// `fieldCount` int64 values stored in `aux` at the slot's byte offset. Build the
// column with dtype dtStruct(StructFieldsInt64(names, nameLens, F), F).

// Struct field descriptor: a fieldCount-entry array of 24-byte records
//   [namePtr : int64][nameLen : int64][typeId : int64]
// typeId is a DT_* tag (DT_INT64 / DT_FLOAT64; both occupy one 8-byte cell slot).

// Build a descriptor from parallel name/nameLen arrays; all fields typed int64.
pub fn StructFieldsInt64(names: int64, nameLens: int64, fieldCount: int64): int64 {
  var arr: int64 := mmap(0, fieldCount * 24, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (arr < 0) { return 0; }
  var i: int64 := 0;
  while (i < fieldCount) {
    poke64(arr + i * 24,      peek64(names + i * 8));
    poke64(arr + i * 24 + 8,  peek64(nameLens + i * 8));
    poke64(arr + i * 24 + 16, DT_INT64);
    i += 1;
  }
  return arr;
}

// Build a descriptor from parallel name/nameLen/typeId arrays (mixed field types).
pub fn StructFields(names: int64, nameLens: int64, typeIds: int64, fieldCount: int64): int64 {
  var arr: int64 := mmap(0, fieldCount * 24, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (arr < 0) { return 0; }
  var i: int64 := 0;
  while (i < fieldCount) {
    poke64(arr + i * 24,      peek64(names + i * 8));
    poke64(arr + i * 24 + 8,  peek64(nameLens + i * 8));
    poke64(arr + i * 24 + 16, peek64(typeIds + i * 8));
    i += 1;
  }
  return arr;
}

// Index of the struct field named `name` in column `c`, or -1 if absent.
pub fn ColumnStructFieldIndex(c: Column, name: int64, nameLen: int64): int64 {
  var dt: DataType := c.field.dtype;
  var i: int64 := 0;
  while (i < dt.fieldCount) {
    if (_nameEq(peek64(dt.fields + i * 24), peek64(dt.fields + i * 24 + 8), name, nameLen) != 0) {
      return i;
    }
    i += 1;
  }
  return -1;
}

// DT_* type of struct field `fieldIdx` in column `c` (DT_NULL if out of range).
pub fn ColumnStructFieldType(c: Column, fieldIdx: int64): int64 {
  var dt: DataType := c.field.dtype;
  if (fieldIdx < 0 || fieldIdx >= dt.fieldCount) { return DT_NULL; }
  return peek64(dt.fields + fieldIdx * 24 + 16);
}

// Set the struct cell at `idx` from `vals` (an array of fieldCount 8-byte slots;
// f64 fields hold the raw f64 bits). Marks the cell valid. Returns 1, or 0.
pub fn ColumnSetStructInt64(c: Column, idx: int64, vals: int64): int64 {
  if (idx < 0 || idx >= c.length) { return 0; }
  var F: int64 := c.field.dtype.fieldCount;
  var off: int64 := c.aux.len;
  var i: int64 := 0;
  while (i < F) {
    if (BufferPushInt64(c.aux, peek64(vals + i * 8)) == 0) { return 0; }
    i += 1;
  }
  BufferSetInt64(c.values, idx, off);
  BitmapSet(c.validity, idx, 1);
  return 1;
}

// Read int64 struct field `fieldIdx` of the record at `idx` (0 if NULL / oob).
pub fn ColumnGetStructFieldInt64(c: Column, idx: int64, fieldIdx: int64): int64 {
  if (BitmapGet(c.validity, idx) == 0) { return 0; }
  var F: int64 := c.field.dtype.fieldCount;
  if (fieldIdx < 0 || fieldIdx >= F) { return 0; }
  var off: int64 := BufferGetInt64(c.values, idx);
  return peek64(BufferByteAddr(c.aux, off) + fieldIdx * 8);
}

// Read f64 struct field `fieldIdx` of the record at `idx` (0.0 if NULL / oob).
pub fn ColumnGetStructFieldFloat64(c: Column, idx: int64, fieldIdx: int64): f64 {
  if (BitmapGet(c.validity, idx) == 0) { return 0.0; }
  var F: int64 := c.field.dtype.fieldCount;
  if (fieldIdx < 0 || fieldIdx >= F) { return 0.0; }
  var off: int64 := BufferGetInt64(c.values, idx);
  return peekf64(BufferByteAddr(c.aux, off) + fieldIdx * 8);
}

pub fn ColumnFree(c: Column) {
  BufferFree(c.values);
  BitmapFree(c.validity);
  BufferFree(c.aux);
}

// ============================================================================
// DataFrame — a growable set of equal-length columns
// ============================================================================

pub type DataFrame = struct {
  columns: Array<Column>;  // inline Column elements (16-byte header + N*size)
  colCount: int64;         // number of columns in use
  colCap: int64;           // element capacity of the columns array
  rowCount: int64;         // rows (every column has exactly this many cells)
};

// Allocate an Array<Column> region: 16-byte [cap|len] header + cap elements.
// Returns 0 on OOM.
fn _allocColumnArray(cap: int64): int64 {
  var mem: int64 := mmap(0, cap * sizeof(Column) + 16, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (mem < 0) { return 0; }
  poke64(mem + 0, cap);   // header: capacity
  poke64(mem + 8, 0);     // header: length
  return mem;
}

pub fn DataFrameNew(): DataFrame {
  var df: DataFrame;
  df.colCap := 8;
  df.columns := _allocColumnArray(df.colCap);
  df.colCount := 0;
  df.rowCount := 0;
  return df;
}

// Double the column array, preserving the header and the inline elements.
fn _dfGrowCols(df: DataFrame) {
  var newCap: int64 := df.colCap * 2;
  var nb: int64 := _allocColumnArray(newCap);
  if (nb == 0) { return; }
  poke64(nb + 8, df.colCount);  // carry the length
  memcpy(nb + 16, df.columns + 16, df.colCount * sizeof(Column));
  munmap(df.columns, df.colCap * sizeof(Column) + 16);
  df.columns := nb;
  df.colCap := newCap;
}

// Add a column. Existing rows are back-filled with NULLs so the table stays
// rectangular. Returns the new column index, or -1 on failure.
pub fn DataFrameAddColumn(df: DataFrame, name: int64, nameLen: int64, dtype: DataType, nullable: int64): int64 {
  if (df.colCount >= df.colCap) {
    _dfGrowCols(df);
    if (df.colCount >= df.colCap) { return -1; }  // grow failed (OOM)
  }
  _columnInit(df.columns[df.colCount], name, nameLen, dtype, nullable, 16);
  // Back-fill existing rows so the new column has one cell per current row.
  var r: int64 := 0;
  while (r < df.rowCount) {
    ColumnAppendNull(df.columns[df.colCount]);
    r += 1;
  }
  df.colCount += 1;
  poke64(df.columns + 8, df.colCount);  // keep Array header length in sync
  return df.colCount - 1;
}

// Install a fully-formed column from raw buffers (used by binary load). The
// column's values/validity/aux are filled by copying the given byte regions;
// no back-fill is performed, so all raw columns must share `length` rows. Sets
// df.rowCount to `length`. Returns the new column index, or -1 on failure.
pub fn DataFrameAppendColumnRaw(df: DataFrame, name: int64, nameLen: int64, dtype: DataType,
                                valuesData: int64, valuesLen: int64,
                                validBits: int64, validCount: int64,
                                auxData: int64, auxLen: int64, length: int64): int64 {
  if (df.colCount >= df.colCap) {
    _dfGrowCols(df);
    if (df.colCount >= df.colCap) { return -1; }
  }
  var c: Column := df.columns[df.colCount];
  c.field := FieldNew(name, nameLen, dtype, 1);
  // values buffer
  var vb: Buffer := BufferNew(valuesLen + 1);
  if (valuesLen > 0) { memcpy(vb.data, valuesData, valuesLen); vb.len := valuesLen; }
  c.values := vb;
  // validity bitmap
  var bm: Bitmap := BitmapNew(length + 8);
  if (length > 0) {
    var vbytes: int64 := (length + 7) / 8;
    memcpy(bm.bits, validBits, vbytes);
  }
  bm.len := length;
  c.validity := bm;
  // aux buffer
  var ab: Buffer := BufferNew(auxLen + 1);
  if (auxLen > 0) { memcpy(ab.data, auxData, auxLen); ab.len := auxLen; }
  c.aux := ab;
  c.length := length;
  df.colCount += 1;
  poke64(df.columns + 8, df.colCount);
  if (length > df.rowCount) { df.rowCount := length; }
  return df.colCount - 1;
}

// Append a row: extend every column with a NULL cell. Returns the new row
// index, or -1 if any column failed to grow.
pub fn DataFrameAppendRow(df: DataFrame): int64 {
  var i: int64 := 0;
  while (i < df.colCount) {
    if (ColumnAppendNull(df.columns[i]) == 0) { return -1; }
    i += 1;
  }
  df.rowCount += 1;
  return df.rowCount - 1;
}

