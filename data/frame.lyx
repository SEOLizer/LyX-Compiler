// --- Column lookup by name -------------------------------------------------

// Byte-compare two names (pchar + length). Returns 1 if equal.
fn _nameEq(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
  if (aLen != bLen) { return 0; }
  var i: int64 := 0;
  while (i < aLen) {
    if ((peek8(a + i) & 255) != (peek8(b + i) & 255)) { return 0; }
    i += 1;
  }
  return 1;
}

// Index of the column named `name`, or -1 if absent.
pub fn DataFrameColByName(df: DataFrame, name: int64, nameLen: int64): int64 {
  var i: int64 := 0;
  while (i < df.colCount) {
    if (_nameEq(df.columns[i].field.name, df.columns[i].field.nameLen, name, nameLen) != 0) {
      return i;
    }
    i += 1;
  }
  return -1;
}

// --- Introspection ---------------------------------------------------------

pub fn DataFrameColCount(df: DataFrame): int64 { return df.colCount; }
pub fn DataFrameRowCount(df: DataFrame): int64 { return df.rowCount; }

// DataType id of a column (DT_* from data.kernel), or DT_NULL if out of range.
pub fn DataFrameColType(df: DataFrame, col: int64): int64 {
  if (col < 0 || col >= df.colCount) { return DT_NULL; }
  return df.columns[col].field.dtype.id;
}

pub fn DataFrameFree(df: DataFrame) {
  var i: int64 := 0;
  while (i < df.colCount) {
    ColumnFree(df.columns[i]);
    i += 1;
  }
  munmap(df.columns, df.colCap * sizeof(Column) + 16);
  df.columns := 0;
  df.colCount := 0;
  df.colCap := 0;
  df.rowCount := 0;
}
