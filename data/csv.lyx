// Lyx Data Library - L4 IO: CSV
// Writing typed DataFrames (data.frame) to RFC-4180 CSV.
//
// This first cut covers serialisation (DataFrame -> CSV text / file). Reading
// with type inference lands in the next batch.
//
// Formatting per column DataType:
//   - Int64/Bool/Timestamp: decimal integer
//   - Float64:              decimal with 6 fractional digits (truncated)
//   - Utf8:                 raw text, RFC-4180 quoted when needed
//   - NULL cells:           an empty field
//
// Values are accumulated in an L1 Buffer, so the whole document is built with
// bounds-safe growth before a single write() syscall.

@description("CSV serialisation for the Lyx data framework (DataFrame -> CSV)")
@author("Andreas Röne")
@copyright("2024-2026 Andreas Röne")
unit data.csv;

import data.kernel;
import data.frame;

// ---- primitive formatting --------------------------------------------------

// Append the decimal representation of an int64 to `b`.
fn _pushInt64(b: Buffer, v: int64) {
  if (v == 0) { BufferPushByte(b, 48); return; }
  var neg: int64 := 0;
  var n: int64 := v;
  if (n < 0) { neg := 1; n := 0 - n; }
  var tmp: int64 := mmap(0, 24, PROT_RW, MAP_ANON, FD_NONE, 0);
  var cnt: int64 := 0;
  while (n > 0) {
    poke8(tmp + cnt, 48 + (n - (n / 10) * 10));
    n := n / 10;
    cnt := cnt + 1;
  }
  if (neg != 0) { BufferPushByte(b, 45); }  // '-'
  var i: int64 := cnt - 1;
  while (i >= 0) { BufferPushByte(b, peek8(tmp + i)); i := i - 1; }
  munmap(tmp, 24);
}

// Append an f64 as decimal with 6 fractional digits (truncated).
fn _pushFloat64(b: Buffer, v: f64) {
  var x: f64 := v;
  if (x < 0.0) { BufferPushByte(b, 45); x := 0.0 - x; }
  var ipart: int64 := x as int64;
  _pushInt64(b, ipart);
  BufferPushByte(b, 46);  // '.'
  var frac: f64 := x - (ipart as f64);
  var d: int64 := 0;
  while (d < 6) {
    frac := frac * 10.0;
    var digit: int64 := frac as int64;
    BufferPushByte(b, 48 + digit);
    frac := frac - (digit as f64);
    d := d + 1;
  }
}

// Does a string need RFC-4180 quoting (contains comma, quote, CR or LF)?
fn _needsQuote(ptr: int64, len: int64): int64 {
  var i: int64 := 0;
  while (i < len) {
    var c: int64 := peek8(ptr + i) & 255;
    if (c == 44 || c == 34 || c == 10 || c == 13) { return 1; }  // , " \n \r
    i := i + 1;
  }
  return 0;
}

// Append a Utf8 field, quoting and escaping per RFC-4180 when necessary.
fn _pushCsvField(b: Buffer, ptr: int64, len: int64) {
  if (_needsQuote(ptr, len) == 0) {
    if (len > 0) { BufferPushBytes(b, ptr, len); }
    return;
  }
  BufferPushByte(b, 34);  // opening quote
  var i: int64 := 0;
  while (i < len) {
    var c: int64 := peek8(ptr + i) & 255;
    if (c == 34) { BufferPushByte(b, 34); }  // escape " as ""
    BufferPushByte(b, c);
    i := i + 1;
  }
  BufferPushByte(b, 34);  // closing quote
}

// ---- serialisation ---------------------------------------------------------

// Append a single cell (df[col,row]) as a CSV field. NULL -> empty field.
fn _pushCell(b: Buffer, df: DataFrame, col: int64, row: int64) {
  if (DataFrameIsValid(df, col, row) == 0) { return; }  // empty field
  var t: int64 := DataFrameColType(df, col);
  if (t == DT_FLOAT64) {
    _pushFloat64(b, DataFrameGetFloat64(df, col, row));
  } else if (t == DT_UTF8) {
    _pushCsvField(b, DataFrameGetUtf8Ptr(df, col, row), DataFrameGetUtf8Len(df, col, row));
  } else {
    _pushInt64(b, DataFrameGetInt64(df, col, row));
  }
}

// Serialise `df` into a freshly allocated L1 Buffer containing the full CSV
// document (header row + data rows, '\n'-terminated lines). The caller owns the
// Buffer and should BufferFree it.
pub fn DataFrameToCsvBuffer(df: DataFrame): Buffer {
  var b: Buffer := BufferNew(256);
  // Header.
  var c: int64 := 0;
  while (c < df.colCount) {
    if (c > 0) { BufferPushByte(b, 44); }  // ','
    _pushCsvField(b, df.columns[c].field.name, df.columns[c].field.nameLen);
    c := c + 1;
  }
  BufferPushByte(b, 10);  // '\n'
  // Rows.
  var r: int64 := 0;
  while (r < df.rowCount) {
    var k: int64 := 0;
    while (k < df.colCount) {
      if (k > 0) { BufferPushByte(b, 44); }
      _pushCell(b, df, k, r);
      k := k + 1;
    }
    BufferPushByte(b, 10);
    r := r + 1;
  }
  return b;
}

// Write `df` to `path` as CSV. Returns the number of bytes written, or -1 on
// error (open/write failure).
pub fn DataFrameWriteCsv(df: DataFrame, path: int64): int64 {
  var b: Buffer := DataFrameToCsvBuffer(df);
  // O_WRONLY | O_CREAT | O_TRUNC = 577, mode 0644 = 420
  var fd: int64 := open(path, 577, 420);
  if (fd < 0) { BufferFree(b); return -1; }
  var written: int64 := 0;
  if (b.len > 0) { written := write(fd, b.data, b.len); }
  close(fd);
  BufferFree(b);
  return written;
}

// ============================================================================
// Reading (with type inference)
// ============================================================================

// Read the whole file at `path` into a growable Buffer. Returns the Buffer
// (b.data == 0 signals open/read failure — check before use).
fn _readFile(path: int64): Buffer {
  var b: Buffer := BufferNew(65536);
  var fd: int64 := open(path, 0, 0);  // O_RDONLY
  if (fd < 0) { BufferFree(b); b.data := 0; b.len := 0; b.cap := 0; return b; }
  var done: int64 := 0;
  while (done == 0) {
    if (BufferReserve(b, 65536) == 0) { done := 1; }
    else {
      var nr: int64 := read(fd, b.data + b.len, 65536);
      if (nr <= 0) { done := 1; }
      else { b.len := b.len + nr; }
    }
  }
  close(fd);
  return b;
}

// --- field classification / parsing ----------------------------------------

fn _isIntField(ptr: int64, len: int64): int64 {
  var i: int64 := 0;
  if (len > 0 && (peek8(ptr) & 255) == 45) { i := 1; }  // leading '-'
  if (i >= len) { return 0; }                            // just "-" is not an int
  while (i < len) {
    var c: int64 := peek8(ptr + i) & 255;
    if (c < 48 || c > 57) { return 0; }
    i := i + 1;
  }
  return 1;
}

fn _isFloatField(ptr: int64, len: int64): int64 {
  var i: int64 := 0;
  if (len > 0 && (peek8(ptr) & 255) == 45) { i := 1; }
  var dots: int64 := 0;
  var digits: int64 := 0;
  while (i < len) {
    var c: int64 := peek8(ptr + i) & 255;
    if (c == 46) {                       // '.'
      dots := dots + 1;
      if (dots > 1) { return 0; }
    } else if (c >= 48 && c <= 57) {
      digits := digits + 1;
    } else {
      return 0;
    }
    i := i + 1;
  }
  if (digits == 0) { return 0; }
  return 1;
}

fn _parseIntField(ptr: int64, len: int64): int64 {
  var i: int64 := 0;
  var neg: int64 := 0;
  if (len > 0 && (peek8(ptr) & 255) == 45) { neg := 1; i := 1; }
  var v: int64 := 0;
  while (i < len) {
    v := v * 10 + ((peek8(ptr + i) & 255) - 48);
    i := i + 1;
  }
  if (neg != 0) { v := 0 - v; }
  return v;
}

fn _parseFloatField(ptr: int64, len: int64): f64 {
  var i: int64 := 0;
  var neg: int64 := 0;
  if (len > 0 && (peek8(ptr) & 255) == 45) { neg := 1; i := 1; }
  var result: f64 := 0.0;
  while (i < len && (peek8(ptr + i) & 255) != 46) {
    var dg: int64 := (peek8(ptr + i) & 255) - 48;
    result := result * 10.0 + (dg as f64);   // single cast — avoids double-cast bug
    i := i + 1;
  }
  if (i < len && (peek8(ptr + i) & 255) == 46) {
    i := i + 1;
    var place: f64 := 0.1;
    while (i < len) {
      var dg2: int64 := (peek8(ptr + i) & 255) - 48;
      result := result + (dg2 as f64) * place;
      place := place / 10.0;
      i := i + 1;
    }
  }
  if (neg != 0) { result := 0.0 - result; }
  return result;
}

// --- RFC-4180 tokeniser -----------------------------------------------------

// Parse the raw CSV bytes into `norm` (concatenated unquoted field bytes) and
// `desc` (an int64 buffer of [offset, length] pairs, one per field, in row-major
// order). Quotes and "" escapes are resolved. Returns the number of columns
// (fields in the first row).
fn _tokenizeCsv(raw: int64, len: int64, norm: Buffer, desc: Buffer): int64 {
  var pos: int64 := 0;
  var col0: int64 := 0;
  var firstRow: int64 := 1;
  while (pos < len) {
    var fstart: int64 := norm.len;
    if ((peek8(raw + pos) & 255) == 34) {   // quoted field
      pos := pos + 1;
      var inField: int64 := 1;
      while (inField != 0 && pos < len) {
        var c: int64 := peek8(raw + pos) & 255;
        if (c == 34) {
          if (pos + 1 < len && (peek8(raw + pos + 1) & 255) == 34) {
            BufferPushByte(norm, 34);
            pos := pos + 2;
          } else {
            pos := pos + 1;
            inField := 0;   // closing quote
          }
        } else {
          BufferPushByte(norm, c);
          pos := pos + 1;
        }
      }
    } else {                                 // unquoted field
      var scanning: int64 := 1;
      while (scanning != 0 && pos < len) {
        var c2: int64 := peek8(raw + pos) & 255;
        if (c2 == 44 || c2 == 10 || c2 == 13) {
          scanning := 0;
        } else {
          BufferPushByte(norm, c2);
          pos := pos + 1;
        }
      }
    }
    // Record the field descriptor.
    BufferPushInt64(desc, fstart);
    BufferPushInt64(desc, norm.len - fstart);
    if (firstRow != 0) { col0 := col0 + 1; }
    // Terminator: comma continues the row; newline/EOF ends it.
    if (pos < len && (peek8(raw + pos) & 255) == 44) {
      pos := pos + 1;
    } else {
      if (pos < len && (peek8(raw + pos) & 255) == 13) { pos := pos + 1; }  // \r
      if (pos < len && (peek8(raw + pos) & 255) == 10) { pos := pos + 1; }  // \n
      firstRow := 0;
    }
  }
  return col0;
}

// Read a CSV file into a typed DataFrame. Column names come from the header
// row; each column's type is inferred from its values (all-integer -> Int64,
// otherwise all-numeric -> Float64, otherwise Utf8). Empty fields become NULL.
// On open/read failure or an empty file, returns an empty DataFrame.
pub fn DataFrameReadCsv(path: int64): DataFrame {
  var df: DataFrame := DataFrameNew();
  var file: Buffer := _readFile(path);
  if (file.data == 0 || file.len == 0) { BufferFree(file); return df; }

  var norm: Buffer := BufferNew(file.len);
  var desc: Buffer := BufferNew(256);
  var nCols: int64 := _tokenizeCsv(file.data, file.len, norm, desc);
  if (nCols <= 0) {
    BufferFree(file); BufferFree(norm); BufferFree(desc);
    return df;
  }
  var nFields: int64 := BufferCountInt64(desc) / 2;
  var nRows: int64 := nFields / nCols - 1;   // minus the header row
  if (nRows < 0) { nRows := 0; }

  // Pass 1: infer each column's type from its data cells.
  var c: int64 := 0;
  while (c < nCols) {
    var canInt: int64 := 1;
    var canFloat: int64 := 1;
    var any: int64 := 0;
    var r: int64 := 0;
    while (r < nRows) {
      var fi: int64 := (r + 1) * nCols + c;
      var off: int64 := BufferGetInt64(desc, fi * 2);
      var ln: int64 := BufferGetInt64(desc, fi * 2 + 1);
      if (ln > 0) {
        any := 1;
        var p: int64 := norm.data + off;
        if (_isIntField(p, ln) == 0) { canInt := 0; }
        if (_isFloatField(p, ln) == 0) { canFloat := 0; }
      }
      r := r + 1;
    }
    var t: int64 := DT_UTF8;
    if (any != 0) {
      if (canInt != 0) { t := DT_INT64; }
      else if (canFloat != 0) { t := DT_FLOAT64; }
    }
    // Header name for column c (field index c), duplicated into stable storage.
    var hoff: int64 := BufferGetInt64(desc, c * 2);
    var hlen: int64 := BufferGetInt64(desc, c * 2 + 1);
    var nm: int64 := mmap(0, hlen + 1, PROT_RW, MAP_ANON, FD_NONE, 0);
    if (hlen > 0) { memcpy(nm, norm.data + hoff, hlen); }
    DataFrameAddColumn(df, nm, hlen, dtNew(t), 1);
    c := c + 1;
  }

  // Pass 2: append rows, parsing each cell by its column's inferred type.
  var rr: int64 := 0;
  while (rr < nRows) {
    var row: int64 := DataFrameAppendRow(df);
    var cc: int64 := 0;
    while (cc < nCols) {
      var fi2: int64 := (rr + 1) * nCols + cc;
      var off2: int64 := BufferGetInt64(desc, fi2 * 2);
      var ln2: int64 := BufferGetInt64(desc, fi2 * 2 + 1);
      if (ln2 > 0) {
        var p2: int64 := norm.data + off2;
        var ct: int64 := DataFrameColType(df, cc);
        if (ct == DT_FLOAT64) {
          DataFrameSetFloat64(df, cc, row, _parseFloatField(p2, ln2));
        } else if (ct == DT_UTF8) {
          DataFrameSetUtf8(df, cc, row, p2, ln2);
        } else {
          DataFrameSetInt64(df, cc, row, _parseIntField(p2, ln2));
        }
      }
      // else: leave the cell NULL
      cc := cc + 1;
    }
    rr := rr + 1;
  }

  BufferFree(file);
  BufferFree(norm);
  BufferFree(desc);
  return df;
}
