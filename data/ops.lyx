// Lyx Data Library - L3 Operations (Batch 1)
// Row/column operations over the typed columnar DataFrame (data.frame).
//
// These are the high-frequency table operations — aggregation, filtering,
// projection, slicing — reimplemented on the typed, null-aware L2 API instead
// of data.core's raw int64 layout. Later batches add sort, group-by, join and
// reshape.
//
// Design notes:
//   - Operations that produce a new table clone the source schema (same column
//     names, types, nullability) and copy rows through the typed accessors, so
//     NULLs, f64 bits and Utf8 payloads all survive correctly.
//   - Cell copying dispatches on the column's DataType, keeping the operations
//     themselves type-agnostic.

@description("L3 operations for the Lyx data framework (aggregate, filter, select, slice)")
@author("Andreas Röne")
@copyright("2024-2026 Andreas Röne")
unit data.ops;

import data.kernel;
import data.frame;

// Comparison operators for filtering.
pub con OP_EQ: int64 := 1;
pub con OP_NE: int64 := 2;
pub con OP_LT: int64 := 3;
pub con OP_LE: int64 := 4;
pub con OP_GT: int64 := 5;
pub con OP_GE: int64 := 6;

// ============================================================================
// Schema / row copying
// ============================================================================

// Create an empty DataFrame with the same columns (name, type, nullability) as
// `src`. The result has zero rows.
pub fn DataFrameCloneSchema(src: DataFrame): DataFrame {
  var dst: DataFrame := DataFrameNew();
  var i: int64 := 0;
  while (i < src.colCount) {
    DataFrameAddColumn(dst,
      src.columns[i].field.name,
      src.columns[i].field.nameLen,
      src.columns[i].field.dtype,
      src.columns[i].field.nullable);
    i := i + 1;
  }
  return dst;
}

// Copy a single cell (respecting type and NULL) from src[srcCol,srcRow] to
// dst[dstCol,dstRow]. dst must already have that row.
fn _copyCell(dst: DataFrame, dstCol: int64, dstRow: int64,
             src: DataFrame, srcCol: int64, srcRow: int64) {
  if (DataFrameIsValid(src, srcCol, srcRow) == 0) {
    DataFrameSetNull(dst, dstCol, dstRow);
    return;
  }
  var t: int64 := DataFrameColType(src, srcCol);
  if (t == DT_FLOAT64) {
    DataFrameSetFloat64(dst, dstCol, dstRow, DataFrameGetFloat64(src, srcCol, srcRow));
  } else if (t == DT_UTF8) {
    var ptr: int64 := DataFrameGetUtf8Ptr(src, srcCol, srcRow);
    var len: int64 := DataFrameGetUtf8Len(src, srcCol, srcRow);
    DataFrameSetUtf8(dst, dstCol, dstRow, ptr, len);
  } else {
    // int64, bool, timestamp — all plain 8-byte slots
    DataFrameSetInt64(dst, dstCol, dstRow, DataFrameGetInt64(src, srcCol, srcRow));
  }
}

// Append src's row `srcRow` to `dst` (which must share src's schema), copying
// every column with the correct type. Returns the new row index, or -1.
pub fn DataFrameAppendRowFrom(dst: DataFrame, src: DataFrame, srcRow: int64): int64 {
  var row: int64 := DataFrameAppendRow(dst);
  if (row < 0) { return -1; }
  var c: int64 := 0;
  while (c < src.colCount) {
    _copyCell(dst, c, row, src, c, srcRow);
    c := c + 1;
  }
  return row;
}

// ============================================================================
// Aggregation (NULL-aware)
// ============================================================================

// Sum of a column's valid int64 cells.
pub fn DataFrameSumInt64(df: DataFrame, col: int64): int64 {
  if (col < 0 || col >= df.colCount) { return 0; }
  return ColumnSumInt64(df.columns[col]);
}

// Sum of a column's valid f64 cells.
pub fn DataFrameSumFloat64(df: DataFrame, col: int64): f64 {
  if (col < 0 || col >= df.colCount) { return 0.0; }
  return ColumnSumFloat64(df.columns[col]);
}

// Count of non-NULL cells in a column.
pub fn DataFrameCountValid(df: DataFrame, col: int64): int64 {
  if (col < 0 || col >= df.colCount) { return 0; }
  return ColumnCountValid(df.columns[col]);
}

// Mean of a column as f64 (works for int64 or f64 columns). Returns 0.0 for an
// all-NULL / empty column. NULLs are excluded from both sum and count.
pub fn DataFrameMeanF64(df: DataFrame, col: int64): f64 {
  if (col < 0 || col >= df.colCount) { return 0.0; }
  var n: int64 := ColumnCountValid(df.columns[col]);
  if (n == 0) { return 0.0; }
  var t: int64 := DataFrameColType(df, col);
  if (t == DT_FLOAT64) {
    return ColumnSumFloat64(df.columns[col]) / (n as f64);
  }
  return (ColumnSumInt64(df.columns[col]) as f64) / (n as f64);
}

// Minimum of a column's valid int64 cells. `found` (int64*) is set to 1 if any
// valid cell existed, 0 otherwise; the return value is 0 when none.
pub fn DataFrameMinInt64(df: DataFrame, col: int64, found: int64): int64 {
  poke64(found, 0);
  if (col < 0 || col >= df.colCount) { return 0; }
  var c: Column := df.columns[col];
  var best: int64 := 0;
  var have: int64 := 0;
  var i: int64 := 0;
  while (i < c.length) {
    if (ColumnIsValid(c, i) != 0) {
      var v: int64 := ColumnGetInt64(c, i);
      if (have == 0 || v < best) { best := v; have := 1; }
    }
    i := i + 1;
  }
  poke64(found, have);
  return best;
}

// Maximum of a column's valid int64 cells (see DataFrameMinInt64 for `found`).
pub fn DataFrameMaxInt64(df: DataFrame, col: int64, found: int64): int64 {
  poke64(found, 0);
  if (col < 0 || col >= df.colCount) { return 0; }
  var c: Column := df.columns[col];
  var best: int64 := 0;
  var have: int64 := 0;
  var i: int64 := 0;
  while (i < c.length) {
    if (ColumnIsValid(c, i) != 0) {
      var v: int64 := ColumnGetInt64(c, i);
      if (have == 0 || v > best) { best := v; have := 1; }
    }
    i := i + 1;
  }
  poke64(found, have);
  return best;
}

// ============================================================================
// Filtering
// ============================================================================

fn _cmpInt64(a: int64, op: int64, b: int64): int64 {
  if (op == OP_EQ) { if (a == b) { return 1; } return 0; }
  if (op == OP_NE) { if (a != b) { return 1; } return 0; }
  if (op == OP_LT) { if (a < b)  { return 1; } return 0; }
  if (op == OP_LE) { if (a <= b) { return 1; } return 0; }
  if (op == OP_GT) { if (a > b)  { return 1; } return 0; }
  if (op == OP_GE) { if (a >= b) { return 1; } return 0; }
  return 0;
}

// Return a new DataFrame containing the rows where the int64 column `col`
// satisfies `col <op> value`. NULL cells never match. The full schema is kept.
pub fn DataFrameFilterInt64(src: DataFrame, col: int64, op: int64, value: int64): DataFrame {
  var dst: DataFrame := DataFrameCloneSchema(src);
  if (col < 0 || col >= src.colCount) { return dst; }
  var r: int64 := 0;
  while (r < src.rowCount) {
    if (DataFrameIsValid(src, col, r) != 0) {
      if (_cmpInt64(DataFrameGetInt64(src, col, r), op, value) != 0) {
        DataFrameAppendRowFrom(dst, src, r);
      }
    }
    r := r + 1;
  }
  return dst;
}

// ============================================================================
// Projection / slicing
// ============================================================================

// Return a new DataFrame with only the columns listed in `colIdx` (an int64
// array of `n` column indices), in the given order, with all rows.
pub fn DataFrameSelect(src: DataFrame, colIdx: int64, n: int64): DataFrame {
  var dst: DataFrame := DataFrameNew();
  // Build the projected schema.
  var i: int64 := 0;
  while (i < n) {
    var ci: int64 := peek64(colIdx + i * 8);
    if (ci >= 0 && ci < src.colCount) {
      DataFrameAddColumn(dst,
        src.columns[ci].field.name,
        src.columns[ci].field.nameLen,
        src.columns[ci].field.dtype,
        src.columns[ci].field.nullable);
    }
    i := i + 1;
  }
  // Copy rows, projecting the selected columns.
  var r: int64 := 0;
  while (r < src.rowCount) {
    var row: int64 := DataFrameAppendRow(dst);
    var k: int64 := 0;
    while (k < n) {
      var ci: int64 := peek64(colIdx + k * 8);
      if (ci >= 0 && ci < src.colCount) {
        _copyCell(dst, k, row, src, ci, r);
      }
      k := k + 1;
    }
    r := r + 1;
  }
  return dst;
}

// Rows [start, end) of `src` as a new DataFrame (clamped to valid range).
pub fn DataFrameSlice(src: DataFrame, start: int64, end: int64): DataFrame {
  var dst: DataFrame := DataFrameCloneSchema(src);
  var s: int64 := start;
  var e: int64 := end;
  if (s < 0) { s := 0; }
  if (e > src.rowCount) { e := src.rowCount; }
  var r: int64 := s;
  while (r < e) {
    DataFrameAppendRowFrom(dst, src, r);
    r := r + 1;
  }
  return dst;
}

// First `n` rows.
pub fn DataFrameHead(src: DataFrame, n: int64): DataFrame {
  return DataFrameSlice(src, 0, n);
}

// Last `n` rows.
pub fn DataFrameTail(src: DataFrame, n: int64): DataFrame {
  var start: int64 := src.rowCount - n;
  if (start < 0) { start := 0; }
  return DataFrameSlice(src, start, src.rowCount);
}

// ============================================================================
// Sorting
// ============================================================================

// Ordering predicate for two rows by an int64 column. Returns 1 if row `a`
// should come strictly before row `b`. NULLs sort last (regardless of `asc`).
fn _rowLessInt64(src: DataFrame, col: int64, asc: int64, a: int64, b: int64): int64 {
  var va: int64 := DataFrameIsValid(src, col, a);
  var vb: int64 := DataFrameIsValid(src, col, b);
  if (va == 0 && vb == 0) { return 0; }  // both NULL: keep order (stable)
  if (va == 0) { return 0; }             // a NULL -> after b
  if (vb == 0) { return 1; }             // b NULL -> a before
  var x: int64 := DataFrameGetInt64(src, col, a);
  var y: int64 := DataFrameGetInt64(src, col, b);
  if (asc != 0) {
    if (x < y) { return 1; }
    return 0;
  }
  if (x > y) { return 1; }
  return 0;
}

// Stable bottom-up merge sort of the row-index array `idx` (n entries) by an
// int64 column. `tmp` is scratch of the same size. O(n log n), no recursion.
fn _mergeSortRows(src: DataFrame, col: int64, asc: int64, idx: int64, tmp: int64, n: int64) {
  var width: int64 := 1;
  while (width < n) {
    var i: int64 := 0;
    while (i < n) {
      var left: int64 := i;
      var mid: int64 := i + width;
      if (mid > n) { mid := n; }
      var right: int64 := i + width * 2;
      if (right > n) { right := n; }
      var a: int64 := left;
      var b: int64 := mid;
      var k: int64 := left;
      while (a < mid && b < right) {
        // Take from the left run unless the right element is strictly less
        // (preserves stability).
        if (_rowLessInt64(src, col, asc, peek64(idx + b * 8), peek64(idx + a * 8)) != 0) {
          poke64(tmp + k * 8, peek64(idx + b * 8));
          b := b + 1;
        } else {
          poke64(tmp + k * 8, peek64(idx + a * 8));
          a := a + 1;
        }
        k := k + 1;
      }
      while (a < mid) { poke64(tmp + k * 8, peek64(idx + a * 8)); a := a + 1; k := k + 1; }
      while (b < right) { poke64(tmp + k * 8, peek64(idx + b * 8)); b := b + 1; k := k + 1; }
      i := i + width * 2;
    }
    memcpy(idx, tmp, n * 8);
    width := width * 2;
  }
}

// Return a new DataFrame with the rows sorted by int64 column `col`
// (ascending != 0 for ascending, else descending). NULLs are placed last.
// Stable. Full schema preserved.
pub fn DataFrameSortByInt64(src: DataFrame, col: int64, ascending: int64): DataFrame {
  var dst: DataFrame := DataFrameCloneSchema(src);
  var n: int64 := src.rowCount;
  if (n <= 0) { return dst; }
  // Build the identity index [0, n).
  var idx: int64 := mmap(0, n * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (idx < 0) { return dst; }
  var i: int64 := 0;
  while (i < n) { poke64(idx + i * 8, i); i := i + 1; }
  // Sort unless the column is invalid (then keep original order).
  if (col >= 0 && col < src.colCount) {
    var tmp: int64 := mmap(0, n * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
    if (tmp >= 0) {
      _mergeSortRows(src, col, ascending, idx, tmp, n);
      munmap(tmp, n * 8);
    }
  }
  // Materialise rows in sorted order.
  var j: int64 := 0;
  while (j < n) {
    DataFrameAppendRowFrom(dst, src, peek64(idx + j * 8));
    j := j + 1;
  }
  munmap(idx, n * 8);
  return dst;
}

// ============================================================================
// Group-by (int64 key)
// ============================================================================

// Index of the row in `df` whose int64 column `keyCol` equals `key`, or -1.
fn _findKeyRow(df: DataFrame, keyCol: int64, key: int64): int64 {
  var r: int64 := 0;
  while (r < df.rowCount) {
    if (DataFrameIsValid(df, keyCol, r) != 0) {
      if (DataFrameGetInt64(df, keyCol, r) == key) { return r; }
    }
    r := r + 1;
  }
  return -1;
}

// Group `src` by the int64 column `keyCol` and sum the int64 column `valCol`
// per group. Result has two columns: the key (named after keyCol) and "sum".
// Rows with a NULL key are skipped; NULL values contribute nothing.
pub fn DataFrameGroupBySumInt64(src: DataFrame, keyCol: int64, valCol: int64): DataFrame {
  var dst: DataFrame := DataFrameNew();
  if (keyCol < 0 || keyCol >= src.colCount) { return dst; }
  var kc: int64 := DataFrameAddColumn(dst,
    src.columns[keyCol].field.name, src.columns[keyCol].field.nameLen,
    src.columns[keyCol].field.dtype, 0);
  var sc: int64 := DataFrameAddColumn(dst, "sum", 3, dtNew(DT_INT64), 1);
  var r: int64 := 0;
  while (r < src.rowCount) {
    if (DataFrameIsValid(src, keyCol, r) != 0) {
      var key: int64 := DataFrameGetInt64(src, keyCol, r);
      var g: int64 := _findKeyRow(dst, kc, key);
      if (g < 0) {
        g := DataFrameAppendRow(dst);
        DataFrameSetInt64(dst, kc, g, key);
        DataFrameSetInt64(dst, sc, g, 0);
      }
      if (DataFrameIsValid(src, valCol, r) != 0) {
        DataFrameSetInt64(dst, sc, g,
          DataFrameGetInt64(dst, sc, g) + DataFrameGetInt64(src, valCol, r));
      }
    }
    r := r + 1;
  }
  return dst;
}

// Group `src` by the int64 column `keyCol` and count rows per group. Result has
// two columns: the key (named after keyCol) and "count". NULL keys are skipped.
pub fn DataFrameGroupByCount(src: DataFrame, keyCol: int64): DataFrame {
  var dst: DataFrame := DataFrameNew();
  if (keyCol < 0 || keyCol >= src.colCount) { return dst; }
  var kc: int64 := DataFrameAddColumn(dst,
    src.columns[keyCol].field.name, src.columns[keyCol].field.nameLen,
    src.columns[keyCol].field.dtype, 0);
  var cc: int64 := DataFrameAddColumn(dst, "count", 5, dtNew(DT_INT64), 1);
  var r: int64 := 0;
  while (r < src.rowCount) {
    if (DataFrameIsValid(src, keyCol, r) != 0) {
      var key: int64 := DataFrameGetInt64(src, keyCol, r);
      var g: int64 := _findKeyRow(dst, kc, key);
      if (g < 0) {
        g := DataFrameAppendRow(dst);
        DataFrameSetInt64(dst, kc, g, key);
        DataFrameSetInt64(dst, cc, g, 0);
      }
      DataFrameSetInt64(dst, cc, g, DataFrameGetInt64(dst, cc, g) + 1);
    }
    r := r + 1;
  }
  return dst;
}

// ============================================================================
// Join (int64 key)
// ============================================================================

// Build the joined output schema: all of `left`'s columns followed by all of
// `right`'s columns. Right columns are made nullable (a left join fills them
// with NULLs on unmatched rows).
fn _joinSchema(left: DataFrame, right: DataFrame): DataFrame {
  var dst: DataFrame := DataFrameCloneSchema(left);
  var c: int64 := 0;
  while (c < right.colCount) {
    DataFrameAddColumn(dst,
      right.columns[c].field.name, right.columns[c].field.nameLen,
      right.columns[c].field.dtype, 1);
    c := c + 1;
  }
  return dst;
}

// Append one output row = left row `lRow` + (right row `rRow` if hasRight, else
// NULLs for every right column). `dst` must have `_joinSchema` layout.
fn _emitJoinedRow(dst: DataFrame, left: DataFrame, lRow: int64,
                  right: DataFrame, rRow: int64, hasRight: int64) {
  var row: int64 := DataFrameAppendRow(dst);
  var c: int64 := 0;
  while (c < left.colCount) {
    _copyCell(dst, c, row, left, c, lRow);
    c := c + 1;
  }
  if (hasRight != 0) {
    var d: int64 := 0;
    while (d < right.colCount) {
      _copyCell(dst, left.colCount + d, row, right, d, rRow);
      d := d + 1;
    }
  }
  // else: right columns keep the NULL that DataFrameAppendRow set.
}

// Inner join on int64 keys: one output row for every (left, right) pair whose
// key columns are equal and non-NULL. Output = left columns ++ right columns.
pub fn DataFrameJoinInner(left: DataFrame, leftKey: int64,
                          right: DataFrame, rightKey: int64): DataFrame {
  var dst: DataFrame := _joinSchema(left, right);
  if (leftKey < 0 || leftKey >= left.colCount) { return dst; }
  if (rightKey < 0 || rightKey >= right.colCount) { return dst; }
  var lr: int64 := 0;
  while (lr < left.rowCount) {
    if (DataFrameIsValid(left, leftKey, lr) != 0) {
      var lk: int64 := DataFrameGetInt64(left, leftKey, lr);
      var rr: int64 := 0;
      while (rr < right.rowCount) {
        if (DataFrameIsValid(right, rightKey, rr) != 0) {
          if (DataFrameGetInt64(right, rightKey, rr) == lk) {
            _emitJoinedRow(dst, left, lr, right, rr, 1);
          }
        }
        rr := rr + 1;
      }
    }
    lr := lr + 1;
  }
  return dst;
}

// Left join on int64 keys: every left row appears at least once. Matching right
// rows are paired; a left row with no match gets NULLs for the right columns.
pub fn DataFrameJoinLeft(left: DataFrame, leftKey: int64,
                         right: DataFrame, rightKey: int64): DataFrame {
  var dst: DataFrame := _joinSchema(left, right);
  if (leftKey < 0 || leftKey >= left.colCount) { return dst; }
  var rightOk: int64 := 1;
  if (rightKey < 0 || rightKey >= right.colCount) { rightOk := 0; }
  var lr: int64 := 0;
  while (lr < left.rowCount) {
    var matched: int64 := 0;
    var lkValid: int64 := DataFrameIsValid(left, leftKey, lr);
    if (lkValid != 0 && rightOk != 0) {
      var lk: int64 := DataFrameGetInt64(left, leftKey, lr);
      var rr: int64 := 0;
      while (rr < right.rowCount) {
        if (DataFrameIsValid(right, rightKey, rr) != 0) {
          if (DataFrameGetInt64(right, rightKey, rr) == lk) {
            _emitJoinedRow(dst, left, lr, right, rr, 1);
            matched := 1;
          }
        }
        rr := rr + 1;
      }
    }
    if (matched == 0) {
      _emitJoinedRow(dst, left, lr, right, 0, 0);  // left row + NULL right side
    }
    lr := lr + 1;
  }
  return dst;
}

// ============================================================================
// Utf8-key group-by / join
// ============================================================================

// Compare the Utf8 cell df[col,row] against the bytes ptr[0..len). Returns 1
// if equal (same length and bytes).
fn _utf8CellEq(df: DataFrame, col: int64, row: int64, ptr: int64, len: int64): int64 {
  if (DataFrameGetUtf8Len(df, col, row) != len) { return 0; }
  var p: int64 := DataFrameGetUtf8Ptr(df, col, row);
  var i: int64 := 0;
  while (i < len) {
    if ((peek8(p + i) & 255) != (peek8(ptr + i) & 255)) { return 0; }
    i := i + 1;
  }
  return 1;
}

// Row in `df` whose Utf8 column `keyCol` equals ptr[0..len), or -1.
fn _findKeyRowUtf8(df: DataFrame, keyCol: int64, ptr: int64, len: int64): int64 {
  var r: int64 := 0;
  while (r < df.rowCount) {
    if (DataFrameIsValid(df, keyCol, r) != 0) {
      if (_utf8CellEq(df, keyCol, r, ptr, len) != 0) { return r; }
    }
    r := r + 1;
  }
  return -1;
}

// Group `src` by the Utf8 column `keyCol` and sum the int64 column `valCol` per
// group. Result: the key column (Utf8, named after keyCol) + "sum". NULL keys
// skipped, NULL values contribute nothing.
pub fn DataFrameGroupBySumUtf8(src: DataFrame, keyCol: int64, valCol: int64): DataFrame {
  var dst: DataFrame := DataFrameNew();
  if (keyCol < 0 || keyCol >= src.colCount) { return dst; }
  var kc: int64 := DataFrameAddColumn(dst,
    src.columns[keyCol].field.name, src.columns[keyCol].field.nameLen,
    src.columns[keyCol].field.dtype, 0);
  var sc: int64 := DataFrameAddColumn(dst, "sum", 3, dtNew(DT_INT64), 1);
  var r: int64 := 0;
  while (r < src.rowCount) {
    if (DataFrameIsValid(src, keyCol, r) != 0) {
      var kp: int64 := DataFrameGetUtf8Ptr(src, keyCol, r);
      var kl: int64 := DataFrameGetUtf8Len(src, keyCol, r);
      var g: int64 := _findKeyRowUtf8(dst, kc, kp, kl);
      if (g < 0) {
        g := DataFrameAppendRow(dst);
        DataFrameSetUtf8(dst, kc, g, kp, kl);
        DataFrameSetInt64(dst, sc, g, 0);
      }
      if (DataFrameIsValid(src, valCol, r) != 0) {
        DataFrameSetInt64(dst, sc, g,
          DataFrameGetInt64(dst, sc, g) + DataFrameGetInt64(src, valCol, r));
      }
    }
    r := r + 1;
  }
  return dst;
}

// Group `src` by the Utf8 column `keyCol` and count rows per group. Result: the
// key column (Utf8) + "count". NULL keys skipped.
pub fn DataFrameGroupByCountUtf8(src: DataFrame, keyCol: int64): DataFrame {
  var dst: DataFrame := DataFrameNew();
  if (keyCol < 0 || keyCol >= src.colCount) { return dst; }
  var kc: int64 := DataFrameAddColumn(dst,
    src.columns[keyCol].field.name, src.columns[keyCol].field.nameLen,
    src.columns[keyCol].field.dtype, 0);
  var cc: int64 := DataFrameAddColumn(dst, "count", 5, dtNew(DT_INT64), 1);
  var r: int64 := 0;
  while (r < src.rowCount) {
    if (DataFrameIsValid(src, keyCol, r) != 0) {
      var kp: int64 := DataFrameGetUtf8Ptr(src, keyCol, r);
      var kl: int64 := DataFrameGetUtf8Len(src, keyCol, r);
      var g: int64 := _findKeyRowUtf8(dst, kc, kp, kl);
      if (g < 0) {
        g := DataFrameAppendRow(dst);
        DataFrameSetUtf8(dst, kc, g, kp, kl);
        DataFrameSetInt64(dst, cc, g, 0);
      }
      DataFrameSetInt64(dst, cc, g, DataFrameGetInt64(dst, cc, g) + 1);
    }
    r := r + 1;
  }
  return dst;
}

// Inner join on Utf8 keys: one output row per (left, right) pair whose Utf8 key
// columns are equal and non-NULL. Output = left columns ++ right columns.
pub fn DataFrameJoinInnerUtf8(left: DataFrame, leftKey: int64,
                              right: DataFrame, rightKey: int64): DataFrame {
  var dst: DataFrame := _joinSchema(left, right);
  if (leftKey < 0 || leftKey >= left.colCount) { return dst; }
  if (rightKey < 0 || rightKey >= right.colCount) { return dst; }
  var lr: int64 := 0;
  while (lr < left.rowCount) {
    if (DataFrameIsValid(left, leftKey, lr) != 0) {
      var lp: int64 := DataFrameGetUtf8Ptr(left, leftKey, lr);
      var ll: int64 := DataFrameGetUtf8Len(left, leftKey, lr);
      var rr: int64 := 0;
      while (rr < right.rowCount) {
        if (DataFrameIsValid(right, rightKey, rr) != 0) {
          if (_utf8CellEq(right, rightKey, rr, lp, ll) != 0) {
            _emitJoinedRow(dst, left, lr, right, rr, 1);
          }
        }
        rr := rr + 1;
      }
    }
    lr := lr + 1;
  }
  return dst;
}

// Left join on Utf8 keys: every left row appears at least once; a left row with
// no match gets NULLs for the right columns.
pub fn DataFrameJoinLeftUtf8(left: DataFrame, leftKey: int64,
                             right: DataFrame, rightKey: int64): DataFrame {
  var dst: DataFrame := _joinSchema(left, right);
  if (leftKey < 0 || leftKey >= left.colCount) { return dst; }
  var rightOk: int64 := 1;
  if (rightKey < 0 || rightKey >= right.colCount) { rightOk := 0; }
  var lr: int64 := 0;
  while (lr < left.rowCount) {
    var matched: int64 := 0;
    if (DataFrameIsValid(left, leftKey, lr) != 0 && rightOk != 0) {
      var lp: int64 := DataFrameGetUtf8Ptr(left, leftKey, lr);
      var ll: int64 := DataFrameGetUtf8Len(left, leftKey, lr);
      var rr: int64 := 0;
      while (rr < right.rowCount) {
        if (DataFrameIsValid(right, rightKey, rr) != 0) {
          if (_utf8CellEq(right, rightKey, rr, lp, ll) != 0) {
            _emitJoinedRow(dst, left, lr, right, rr, 1);
            matched := 1;
          }
        }
        rr := rr + 1;
      }
    }
    if (matched == 0) {
      _emitJoinedRow(dst, left, lr, right, 0, 0);
    }
    lr := lr + 1;
  }
  return dst;
}

// ============================================================================
// Right / outer join (int64 and Utf8 keys)
// ============================================================================

// Append an output row = NULLs for every left column + right row `rRow`. Used
// for right rows that have no matching left row.
fn _emitRightOnlyRow(dst: DataFrame, left: DataFrame, right: DataFrame, rRow: int64) {
  var row: int64 := DataFrameAppendRow(dst);
  // left columns keep the NULL that DataFrameAppendRow set.
  var d: int64 := 0;
  while (d < right.colCount) {
    _copyCell(dst, left.colCount + d, row, right, d, rRow);
    d := d + 1;
  }
}

// Right join on int64 keys: every right row appears at least once; a right row
// with no match gets NULLs for the left columns. Output = left ++ right columns.
pub fn DataFrameJoinRight(left: DataFrame, leftKey: int64,
                          right: DataFrame, rightKey: int64): DataFrame {
  var dst: DataFrame := _joinSchema(left, right);
  if (rightKey < 0 || rightKey >= right.colCount) { return dst; }
  var leftOk: int64 := 1;
  if (leftKey < 0 || leftKey >= left.colCount) { leftOk := 0; }
  var rr: int64 := 0;
  while (rr < right.rowCount) {
    var matched: int64 := 0;
    if (DataFrameIsValid(right, rightKey, rr) != 0 && leftOk != 0) {
      var rk: int64 := DataFrameGetInt64(right, rightKey, rr);
      var lr: int64 := 0;
      while (lr < left.rowCount) {
        if (DataFrameIsValid(left, leftKey, lr) != 0) {
          if (DataFrameGetInt64(left, leftKey, lr) == rk) {
            _emitJoinedRow(dst, left, lr, right, rr, 1);
            matched := 1;
          }
        }
        lr := lr + 1;
      }
    }
    if (matched == 0) { _emitRightOnlyRow(dst, left, right, rr); }
    rr := rr + 1;
  }
  return dst;
}

// Right join on Utf8 keys.
pub fn DataFrameJoinRightUtf8(left: DataFrame, leftKey: int64,
                              right: DataFrame, rightKey: int64): DataFrame {
  var dst: DataFrame := _joinSchema(left, right);
  if (rightKey < 0 || rightKey >= right.colCount) { return dst; }
  var leftOk: int64 := 1;
  if (leftKey < 0 || leftKey >= left.colCount) { leftOk := 0; }
  var rr: int64 := 0;
  while (rr < right.rowCount) {
    var matched: int64 := 0;
    if (DataFrameIsValid(right, rightKey, rr) != 0 && leftOk != 0) {
      var rp: int64 := DataFrameGetUtf8Ptr(right, rightKey, rr);
      var rl: int64 := DataFrameGetUtf8Len(right, rightKey, rr);
      var lr: int64 := 0;
      while (lr < left.rowCount) {
        if (DataFrameIsValid(left, leftKey, lr) != 0) {
          if (_utf8CellEq(left, leftKey, lr, rp, rl) != 0) {
            _emitJoinedRow(dst, left, lr, right, rr, 1);
            matched := 1;
          }
        }
        lr := lr + 1;
      }
    }
    if (matched == 0) { _emitRightOnlyRow(dst, left, right, rr); }
    rr := rr + 1;
  }
  return dst;
}

// Does right row `rRow` have any matching left row on int64 keys?
fn _rightHasMatchInt64(left: DataFrame, leftKey: int64, right: DataFrame, rightKey: int64, rRow: int64): int64 {
  if (DataFrameIsValid(right, rightKey, rRow) == 0) { return 0; }
  var rk: int64 := DataFrameGetInt64(right, rightKey, rRow);
  var lr: int64 := 0;
  while (lr < left.rowCount) {
    if (DataFrameIsValid(left, leftKey, lr) != 0) {
      if (DataFrameGetInt64(left, leftKey, lr) == rk) { return 1; }
    }
    lr := lr + 1;
  }
  return 0;
}

// Full outer join on int64 keys: inner matches, plus unmatched left rows (NULL
// right) and unmatched right rows (NULL left).
pub fn DataFrameJoinOuter(left: DataFrame, leftKey: int64,
                          right: DataFrame, rightKey: int64): DataFrame {
  var dst: DataFrame := _joinSchema(left, right);
  var leftOk: int64 := 1;
  if (leftKey < 0 || leftKey >= left.colCount) { leftOk := 0; }
  var rightOk: int64 := 1;
  if (rightKey < 0 || rightKey >= right.colCount) { rightOk := 0; }
  // Left side: every left row, matched or NULL-right.
  var lr: int64 := 0;
  while (lr < left.rowCount) {
    var matched: int64 := 0;
    if (DataFrameIsValid(left, leftKey, lr) != 0 && rightOk != 0) {
      var lk: int64 := DataFrameGetInt64(left, leftKey, lr);
      var rr: int64 := 0;
      while (rr < right.rowCount) {
        if (DataFrameIsValid(right, rightKey, rr) != 0) {
          if (DataFrameGetInt64(right, rightKey, rr) == lk) {
            _emitJoinedRow(dst, left, lr, right, rr, 1);
            matched := 1;
          }
        }
        rr := rr + 1;
      }
    }
    if (matched == 0) { _emitJoinedRow(dst, left, lr, right, 0, 0); }
    lr := lr + 1;
  }
  // Right side: only unmatched right rows.
  if (leftOk != 0 && rightOk != 0) {
    var rr2: int64 := 0;
    while (rr2 < right.rowCount) {
      if (_rightHasMatchInt64(left, leftKey, right, rightKey, rr2) == 0) {
        _emitRightOnlyRow(dst, left, right, rr2);
      }
      rr2 := rr2 + 1;
    }
  }
  return dst;
}

// Does right row `rRow` have any matching left row on Utf8 keys?
fn _rightHasMatchUtf8(left: DataFrame, leftKey: int64, right: DataFrame, rightKey: int64, rRow: int64): int64 {
  if (DataFrameIsValid(right, rightKey, rRow) == 0) { return 0; }
  var rp: int64 := DataFrameGetUtf8Ptr(right, rightKey, rRow);
  var rl: int64 := DataFrameGetUtf8Len(right, rightKey, rRow);
  var lr: int64 := 0;
  while (lr < left.rowCount) {
    if (DataFrameIsValid(left, leftKey, lr) != 0) {
      if (_utf8CellEq(left, leftKey, lr, rp, rl) != 0) { return 1; }
    }
    lr := lr + 1;
  }
  return 0;
}

// Full outer join on Utf8 keys.
pub fn DataFrameJoinOuterUtf8(left: DataFrame, leftKey: int64,
                              right: DataFrame, rightKey: int64): DataFrame {
  var dst: DataFrame := _joinSchema(left, right);
  var leftOk: int64 := 1;
  if (leftKey < 0 || leftKey >= left.colCount) { leftOk := 0; }
  var rightOk: int64 := 1;
  if (rightKey < 0 || rightKey >= right.colCount) { rightOk := 0; }
  var lr: int64 := 0;
  while (lr < left.rowCount) {
    var matched: int64 := 0;
    if (DataFrameIsValid(left, leftKey, lr) != 0 && rightOk != 0) {
      var lp: int64 := DataFrameGetUtf8Ptr(left, leftKey, lr);
      var ll: int64 := DataFrameGetUtf8Len(left, leftKey, lr);
      var rr: int64 := 0;
      while (rr < right.rowCount) {
        if (DataFrameIsValid(right, rightKey, rr) != 0) {
          if (_utf8CellEq(right, rightKey, rr, lp, ll) != 0) {
            _emitJoinedRow(dst, left, lr, right, rr, 1);
            matched := 1;
          }
        }
        rr := rr + 1;
      }
    }
    if (matched == 0) { _emitJoinedRow(dst, left, lr, right, 0, 0); }
    lr := lr + 1;
  }
  if (leftOk != 0 && rightOk != 0) {
    var rr2: int64 := 0;
    while (rr2 < right.rowCount) {
      if (_rightHasMatchUtf8(left, leftKey, right, rightKey, rr2) == 0) {
        _emitRightOnlyRow(dst, left, right, rr2);
      }
      rr2 := rr2 + 1;
    }
  }
  return dst;
}

// ============================================================================
// Reshape (melt / pivot)
// ============================================================================

// Copy `n` bytes into a fresh, stable heap allocation and return the pointer.
// Used to give pivot output columns names that outlive the source frame.
fn _dupBytes(src: int64, n: int64): int64 {
  var sz: int64 := n;
  if (sz < 1) { sz := 1; }
  var p: int64 := mmap(0, sz, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (p < 0) { return 0; }
  if (n > 0) { memcpy(p, src, n); }
  return p;
}

// Melt (wide -> long): keep the `nId` identifier columns (idIdx) and unpivot the
// `nVal` int64 value columns (valIdx) into two columns, "variable" (Utf8, the
// source column name) and "value" (int64). One output row per (source row,
// value column). NULL value cells stay NULL. Value columns must be int64.
pub fn DataFrameMeltInt64(src: DataFrame, idIdx: int64, nId: int64,
                          valIdx: int64, nVal: int64): DataFrame {
  var dst: DataFrame := DataFrameNew();
  // Identifier columns, preserved.
  var i: int64 := 0;
  while (i < nId) {
    var ci: int64 := peek64(idIdx + i * 8);
    if (ci >= 0 && ci < src.colCount) {
      DataFrameAddColumn(dst,
        src.columns[ci].field.name, src.columns[ci].field.nameLen,
        src.columns[ci].field.dtype, 1);
    }
    i := i + 1;
  }
  var varCol: int64 := DataFrameAddColumn(dst, "variable", 8, dtNew(DT_UTF8), 1);
  var valCol: int64 := DataFrameAddColumn(dst, "value", 5, dtNew(DT_INT64), 1);
  var r: int64 := 0;
  while (r < src.rowCount) {
    var v: int64 := 0;
    while (v < nVal) {
      var vc: int64 := peek64(valIdx + v * 8);
      if (vc >= 0 && vc < src.colCount) {
        var row: int64 := DataFrameAppendRow(dst);
        var k: int64 := 0;
        while (k < nId) {
          var ci2: int64 := peek64(idIdx + k * 8);
          if (ci2 >= 0 && ci2 < src.colCount) {
            _copyCell(dst, k, row, src, ci2, r);
          }
          k := k + 1;
        }
        DataFrameSetUtf8(dst, varCol, row,
          src.columns[vc].field.name, src.columns[vc].field.nameLen);
        if (DataFrameIsValid(src, vc, r) != 0) {
          DataFrameSetInt64(dst, valCol, row, DataFrameGetInt64(src, vc, r));
        }
      }
      v := v + 1;
    }
    r := r + 1;
  }
  return dst;
}

// Pivot (long -> wide): one output row per distinct int64 `indexCol` value; the
// distinct Utf8 `pivotCol` strings become int64 columns filled from `valueCol`.
// Cells with no matching source row stay NULL. Later duplicates for the same
// (index, pivot) cell overwrite earlier ones.
pub fn DataFramePivotUtf8(src: DataFrame, indexCol: int64, pivotCol: int64, valueCol: int64): DataFrame {
  var dst: DataFrame := DataFrameNew();
  if (indexCol < 0 || indexCol >= src.colCount) { return dst; }
  if (pivotCol < 0 || pivotCol >= src.colCount) { return dst; }
  if (valueCol < 0 || valueCol >= src.colCount) { return dst; }
  // Index column (col 0), same name/type as the source index.
  var idxc: int64 := DataFrameAddColumn(dst,
    src.columns[indexCol].field.name, src.columns[indexCol].field.nameLen,
    src.columns[indexCol].field.dtype, 1);
  // Pass 1: create one int64 column per distinct pivot string (names duplicated
  // into stable storage so they outlive `src`).
  var r: int64 := 0;
  while (r < src.rowCount) {
    if (DataFrameIsValid(src, pivotCol, r) != 0) {
      var pptr: int64 := DataFrameGetUtf8Ptr(src, pivotCol, r);
      var plen: int64 := DataFrameGetUtf8Len(src, pivotCol, r);
      if (DataFrameColByName(dst, pptr, plen) < 0) {
        DataFrameAddColumn(dst, _dupBytes(pptr, plen), plen, dtNew(DT_INT64), 1);
      }
    }
    r := r + 1;
  }
  // Pass 2: one row per distinct index value.
  var r2: int64 := 0;
  while (r2 < src.rowCount) {
    if (DataFrameIsValid(src, indexCol, r2) != 0) {
      var iv: int64 := DataFrameGetInt64(src, indexCol, r2);
      if (_findKeyRow(dst, idxc, iv) < 0) {
        var er: int64 := DataFrameAppendRow(dst);
        DataFrameSetInt64(dst, idxc, er, iv);
      }
    }
    r2 := r2 + 1;
  }
  // Pass 3: scatter values into [index row, pivot column].
  var r3: int64 := 0;
  while (r3 < src.rowCount) {
    if (DataFrameIsValid(src, indexCol, r3) != 0 && DataFrameIsValid(src, pivotCol, r3) != 0) {
      if (DataFrameIsValid(src, valueCol, r3) != 0) {
        var iv2: int64 := DataFrameGetInt64(src, indexCol, r3);
        var er2: int64 := _findKeyRow(dst, idxc, iv2);
        var pc: int64 := DataFrameColByName(dst,
          DataFrameGetUtf8Ptr(src, pivotCol, r3), DataFrameGetUtf8Len(src, pivotCol, r3));
        if (er2 >= 0 && pc >= 0) {
          DataFrameSetInt64(dst, pc, er2, DataFrameGetInt64(src, valueCol, r3));
        }
      }
    }
    r3 := r3 + 1;
  }
  return dst;
}
