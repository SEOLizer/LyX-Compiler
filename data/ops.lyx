// Inner join on Utf8 keys with a chained hash index on `right`. O(L + R).
pub fn DataFrameJoinInnerUtf8Hash(left: DataFrame, leftKey: int64,
                                  right: DataFrame, rightKey: int64): DataFrame {
  var dst: DataFrame := _joinSchema(left, right);
  if (leftKey < 0 || leftKey >= left.colCount) { return dst; }
  if (rightKey < 0 || rightKey >= right.colCount) { return dst; }
  var cap: int64 := _pow2Ge(right.rowCount * 2 + 16);
  var mask: int64 := cap - 1;
  var slots: int64 := mmap(0, cap * 8, PROT_RW, MAP_ANON, FD_NONE, 0);  // first right row+1
  if (slots < 0) { return dst; }
  var chainNext: int64 := mmap(0, (right.rowCount + 1) * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (chainNext < 0) { munmap(slots, cap * 8); return dst; }
  // build
  var rr: int64 := 0;
  while (rr < right.rowCount) {
    if (DataFrameIsValid(right, rightKey, rr) != 0) {
      var kp: int64 := DataFrameGetUtf8Ptr(right, rightKey, rr);
      var kl: int64 := DataFrameGetUtf8Len(right, rightKey, rr);
      var h: int64 := _hashBytes(kp, kl) & mask;
      var probing: int64 := 1;
      while (probing != 0) {
        var pay: int64 := peek64(slots + h * 8);
        if (pay == 0) {
          poke64(slots + h * 8, rr + 1);
          poke64(chainNext + rr * 8, 0);
          probing := 0;
        } else if (_utf8CellEq(right, rightKey, pay - 1, kp, kl) != 0) {
          poke64(chainNext + rr * 8, pay);
          poke64(slots + h * 8, rr + 1);
          probing := 0;
        } else {
          h := (h + 1) & mask;
        }
      }
    }
    rr += 1;
  }
  // probe
  var lr: int64 := 0;
  while (lr < left.rowCount) {
    if (DataFrameIsValid(left, leftKey, lr) != 0) {
      var kp: int64 := DataFrameGetUtf8Ptr(left, leftKey, lr);
      var kl: int64 := DataFrameGetUtf8Len(left, leftKey, lr);
      var h: int64 := _hashBytes(kp, kl) & mask;
      var searching: int64 := 1;
      while (searching != 0) {
        var pay: int64 := peek64(slots + h * 8);
        if (pay == 0) { searching := 0; }
        else if (_utf8CellEq(right, rightKey, pay - 1, kp, kl) != 0) {
          var c: int64 := pay;
          while (c != 0) {
            _emitJoinedRow(dst, left, lr, right, c - 1, 1);
            c := peek64(chainNext + (c - 1) * 8);
          }
          searching := 0;
        } else {
          h := (h + 1) & mask;
        }
      }
    }
    lr += 1;
  }
  munmap(slots, cap * 8);
  munmap(chainNext, (right.rowCount + 1) * 8);
  return dst;
}
