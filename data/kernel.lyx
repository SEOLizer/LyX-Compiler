// Lyx Data Library - L1 Kernel
// Foundation primitives for the typed columnar data framework.
//
// This module provides the memory-level building blocks that every higher
// layer (Column, DataFrame, operations, IO) is built on:
//   - DataType: a self-describing type descriptor (primitive + nested List)
//   - Buffer:   a growable, bounds-safe byte buffer (replaces the fixed,
//               OOB-prone raw mmap arrays used in data.core)
//   - Bitmap:   a validity bitmap (1 bit / element) that distinguishes a real
//               value from NULL — impossible with data.core's "0 == missing".
//
// Design notes:
//   - libc-free by construction: only the mmap/munmap syscalls are used, never
//     libc_malloc/realloc (which break on LyxOS, which has no dynamic linker).
//     MAP_ANON pages arrive zero-initialised, so a fresh Bitmap is all-NULL and
//     a fresh Buffer is all-zero for free.
//   - Structs are pass-by-reference in Lyx, so the grow helpers can reassign
//     .data/.cap in place and the caller sees the new, larger buffer.
//   - No error channel yet: on OOM a mutating call reports failure via its
//     int64 return (1 = ok, 0 = failed) and leaves the structure unchanged
//     rather than corrupting the heap. Callers must check.

@description("L1 kernel primitives for the Lyx data framework (DataType, Buffer, Bitmap)")
@author("Andreas Röne")
@copyright("2024-2026 Andreas Röne")
unit data.kernel;

// ============================================================================
// DataType — self-describing type descriptor
// ============================================================================

// Primitive type tags. Nested types (LIST/STRUCT) carry extra information in
// the DataType struct below.
pub con DT_NULL:      int64 := 0;
pub con DT_BOOL:      int64 := 1;
pub con DT_INT64:     int64 := 2;
pub con DT_FLOAT64:   int64 := 3;
pub con DT_UTF8:      int64 := 4;  // variable-length: slot holds an int64 handle
pub con DT_TIMESTAMP: int64 := 5;  // unix seconds, stored as int64
pub con DT_LIST:      int64 := 6;  // homogeneous list of `child`
pub con DT_STRUCT:    int64 := 7;  // record; fields described elsewhere (P2)

// A DataType is a small value struct. For primitives only `id` matters. For a
// LIST, `child` points to a heap-boxed DataType describing the element type.
// `fields`/`fieldCount` are reserved for STRUCT and stay 0 until P2.
pub type DataType = struct {
  id: int64;          // DT_*
  child: int64;       // pointer to a boxed DataType (LIST element type), else 0
  fields: int64;      // pointer to a Field array (STRUCT), else 0
  fieldCount: int64;  // number of struct fields, else 0
};

// Construct a primitive DataType.
pub fn dtNew(id: int64): DataType {
  var dt: DataType;
  dt.id := id;
  dt.child := 0;
  dt.fields := 0;
  dt.fieldCount := 0;
  return dt;
}

// Box a DataType onto the heap (32 bytes = 4 int64 fields) and return the
// pointer, so a LIST can reference its element type. Returns 0 on OOM.
pub fn dtBox(dt: DataType): int64 {
  var p: int64 := mmap(0, 32, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (p < 0) { return 0; }
  poke64(p + 0,  dt.id);
  poke64(p + 8,  dt.child);
  poke64(p + 16, dt.fields);
  poke64(p + 24, dt.fieldCount);
  return p;
}

// Read a boxed DataType back from the heap. Returns DT_NULL if ptr is null.
pub fn dtUnbox(ptr: int64): DataType {
  var dt: DataType;
  if (ptr == 0) {
    dt.id := DT_NULL; dt.child := 0; dt.fields := 0; dt.fieldCount := 0;
    return dt;
  }
  dt.id         := peek64(ptr + 0);
  dt.child      := peek64(ptr + 8);
  dt.fields     := peek64(ptr + 16);
  dt.fieldCount := peek64(ptr + 24);
  return dt;
}

// Construct a LIST<child> DataType. `childPtr` must be a boxed DataType (dtBox).
pub fn dtList(childPtr: int64): DataType {
  var dt: DataType;
  dt.id := DT_LIST;
  dt.child := childPtr;
  dt.fields := 0;
  dt.fieldCount := 0;
  return dt;
}

// Construct a STRUCT DataType. `fields` points to a `fieldCount`-entry array of
// 16-byte [namePtr, nameLen] descriptors (one per struct field).
pub fn dtStruct(fields: int64, fieldCount: int64): DataType {
  var dt: DataType;
  dt.id := DT_STRUCT;
  dt.child := 0;
  dt.fields := fields;
  dt.fieldCount := fieldCount;
  return dt;
}

// Byte width of one slot in a Buffer for this type. Variable-length and nested
// types store an 8-byte handle/offset in the slot, so they report 8. NULL is 0.
pub fn dtWidth(dt: DataType): int64 {
  if (dt.id == DT_NULL)      { return 0; }
  if (dt.id == DT_BOOL)      { return 1; }
  if (dt.id == DT_INT64)     { return 8; }
  if (dt.id == DT_FLOAT64)   { return 8; }
  if (dt.id == DT_TIMESTAMP) { return 8; }
  // UTF8, LIST, STRUCT: 8-byte handle into a side buffer
  return 8;
}

// Is this a fixed-width primitive (packs directly into a Buffer slot)?
pub fn dtIsFixedWidth(dt: DataType): int64 {
  if (dt.id == DT_BOOL)      { return 1; }
  if (dt.id == DT_INT64)     { return 1; }
  if (dt.id == DT_FLOAT64)   { return 1; }
  if (dt.id == DT_TIMESTAMP) { return 1; }
  return 0;
}

// ============================================================================
// Buffer — growable, bounds-safe byte buffer
// ============================================================================

pub type Buffer = struct {
  data: int64;   // mmap'd byte region
  len: int64;    // bytes currently used
  cap: int64;    // bytes allocated
};

// Create a Buffer with an initial capacity in bytes (rounded up to >= 1).
// data == 0 signals allocation failure; every mutating op guards on it.
pub fn BufferNew(capBytes: int64): Buffer {
  var b: Buffer;
  var c: int64 := capBytes;
  if (c < 1) { c := 1; }
  b.data := mmap(0, c, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (b.data < 0) { b.data := 0; b.len := 0; b.cap := 0; return b; }
  b.len := 0;
  b.cap := c;
  return b;
}

// Ensure at least `need` more bytes fit. Doubles capacity until it does, moving
// the region with a fresh mmap + memcpy + munmap. Returns 1 on success, 0 on
// OOM (buffer left unchanged so the caller can bail without corruption).
pub fn BufferReserve(b: Buffer, need: int64): int64 {
  if (b.data == 0) { return 0; }
  if (b.len + need <= b.cap) { return 1; }
  var newCap: int64 := b.cap;
  if (newCap < 1) { newCap := 1; }
  while (newCap < b.len + need) { newCap := newCap * 2; }
  var nb: int64 := mmap(0, newCap, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (nb < 0) { return 0; }
  memcpy(nb, b.data, b.len);
  munmap(b.data, b.cap);
  b.data := nb;
  b.cap := newCap;
  return 1;
}

// Append an 8-byte value. Returns 1 on success, 0 on OOM (value not written).
pub fn BufferPushInt64(b: Buffer, value: int64): int64 {
  if (BufferReserve(b, 8) == 0) { return 0; }
  poke64(b.data + b.len, value);
  b.len := b.len + 8;
  return 1;
}

// Append a single byte (low 8 bits). Returns 1 on success, 0 on OOM.
pub fn BufferPushByte(b: Buffer, value: int64): int64 {
  if (BufferReserve(b, 1) == 0) { return 0; }
  poke8(b.data + b.len, value & 255);
  b.len := b.len + 1;
  return 1;
}

// Read the int64 slot at element index `idx` (idx * 8 byte offset).
// Bounds-checked: out-of-range reads return 0 instead of touching foreign memory.
pub fn BufferGetInt64(b: Buffer, idx: int64): int64 {
  if (b.data == 0) { return 0; }
  if (idx < 0 || idx * 8 + 8 > b.len) { return 0; }
  return peek64(b.data + idx * 8);
}

// Overwrite the int64 slot at element index `idx`. Returns 1 on success,
// 0 if out of range (never writes past len).
pub fn BufferSetInt64(b: Buffer, idx: int64, value: int64): int64 {
  if (b.data == 0) { return 0; }
  if (idx < 0 || idx * 8 + 8 > b.len) { return 0; }
  poke64(b.data + idx * 8, value);
  return 1;
}

// Number of int64 elements currently stored.
pub fn BufferCountInt64(b: Buffer): int64 {
  return b.len / 8;
}

// Append an 8-byte f64 value (stored as raw IEEE-754 bits, no conversion).
// Returns 1 on success, 0 on OOM.
pub fn BufferPushFloat64(b: Buffer, value: f64): int64 {
  if (BufferReserve(b, 8) == 0) { return 0; }
  pokef64(b.data + b.len, value);
  b.len := b.len + 8;
  return 1;
}

// Read the f64 slot at element index `idx`. Out-of-range returns 0.0.
pub fn BufferGetFloat64(b: Buffer, idx: int64): f64 {
  if (b.data == 0) { return 0.0; }
  if (idx < 0 || idx * 8 + 8 > b.len) { return 0.0; }
  return peekf64(b.data + idx * 8);
}

// Overwrite the f64 slot at element index `idx`. Returns 1 on success, 0 if
// out of range.
pub fn BufferSetFloat64(b: Buffer, idx: int64, value: f64): int64 {
  if (b.data == 0) { return 0; }
  if (idx < 0 || idx * 8 + 8 > b.len) { return 0; }
  pokef64(b.data + idx * 8, value);
  return 1;
}

// Append `n` raw bytes copied from `src`. Returns the byte offset at which they
// were written (so callers can index back into the buffer), or -1 on OOM.
pub fn BufferPushBytes(b: Buffer, src: int64, n: int64): int64 {
  if (n < 0) { return -1; }
  if (BufferReserve(b, n) == 0) { return -1; }
  var off: int64 := b.len;
  memcpy(b.data + off, src, n);
  b.len := b.len + n;
  return off;
}

// Absolute address of byte offset `off` in the buffer's current backing store.
// NOTE: only valid until the next mutation that may grow (and move) the buffer.
pub fn BufferByteAddr(b: Buffer, off: int64): int64 {
  if (b.data == 0) { return 0; }
  return b.data + off;
}

// Release the buffer's memory and reset it to empty.
pub fn BufferFree(b: Buffer) {
  if (b.data != 0) {
    munmap(b.data, b.cap);
  }
  b.data := 0;
  b.len := 0;
  b.cap := 0;
}

// ============================================================================
// Bitmap — validity bits (1 = valid, 0 = NULL), one bit per element
// ============================================================================

pub type Bitmap = struct {
  bits: int64;   // mmap'd byte region; bit i = element i validity
  len: int64;    // number of elements (bits) tracked
  cap: int64;    // capacity in bits
};

// Bytes needed to hold `nbits` bits (ceil division).
fn _bmBytes(nbits: int64): int64 {
  return (nbits + 7) / 8;
}

// Create a Bitmap sized for `capBits` elements. MAP_ANON zeroes the pages, so
// every element starts as NULL (bit 0). bits == 0 signals allocation failure.
pub fn BitmapNew(capBits: int64): Bitmap {
  var bm: Bitmap;
  var c: int64 := capBits;
  if (c < 8) { c := 8; }
  var bytes: int64 := _bmBytes(c);
  bm.bits := mmap(0, bytes, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (bm.bits < 0) { bm.bits := 0; bm.len := 0; bm.cap := 0; return bm; }
  bm.len := 0;
  bm.cap := c;
  return bm;
}

// Grow to hold at least `capBits` bits. Fresh pages are zeroed (new bits NULL).
// Returns 1 on success, 0 on OOM (bitmap unchanged).
pub fn BitmapReserve(bm: Bitmap, capBits: int64): int64 {
  if (bm.bits == 0) { return 0; }
  if (capBits <= bm.cap) { return 1; }
  var newCap: int64 := bm.cap;
  if (newCap < 8) { newCap := 8; }
  while (newCap < capBits) { newCap := newCap * 2; }
  var oldBytes: int64 := _bmBytes(bm.cap);
  var newBytes: int64 := _bmBytes(newCap);
  var nb: int64 := mmap(0, newBytes, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (nb < 0) { return 0; }
  memcpy(nb, bm.bits, oldBytes);
  munmap(bm.bits, oldBytes);
  bm.bits := nb;
  bm.cap := newCap;
  return 1;
}

// Set element `idx` valid (1) or NULL (0). Out-of-range index is ignored.
pub fn BitmapSet(bm: Bitmap, idx: int64, valid: int64) {
  if (bm.bits == 0) { return; }
  if (idx < 0 || idx >= bm.cap) { return; }
  var byteOff: int64 := idx / 8;
  var bit: int64 := idx & 7;
  var cur: int64 := peek8(bm.bits + byteOff) & 255;
  if (valid != 0) {
    cur := cur | (1 << bit);
  } else {
    // Clear the bit without a bitwise-NOT: subtract it if present.
    cur := cur & (255 - (1 << bit));
  }
  poke8(bm.bits + byteOff, cur);
}

// Read element `idx` validity: 1 = valid, 0 = NULL (or out of range).
pub fn BitmapGet(bm: Bitmap, idx: int64): int64 {
  if (bm.bits == 0) { return 0; }
  if (idx < 0 || idx >= bm.len) { return 0; }
  var byteOff: int64 := idx / 8;
  var bit: int64 := idx & 7;
  return (peek8(bm.bits + byteOff) >> bit) & 1;
}

// Append a validity bit, growing as needed. Returns 1 on success, 0 on OOM.
pub fn BitmapAppend(bm: Bitmap, valid: int64): int64 {
  if (bm.len >= bm.cap) {
    if (BitmapReserve(bm, bm.len + 1) == 0) { return 0; }
  }
  BitmapSet(bm, bm.len, valid);
  bm.len := bm.len + 1;
  return 1;
}

// Count of valid (non-NULL) elements.
pub fn BitmapCountValid(bm: Bitmap): int64 {
  var n: int64 := 0;
  var i: int64 := 0;
  while (i < bm.len) {
    n := n + BitmapGet(bm, i);
    i := i + 1;
  }
  return n;
}

// Release the bitmap's memory and reset it to empty.
pub fn BitmapFree(bm: Bitmap) {
  if (bm.bits != 0) {
    munmap(bm.bits, _bmBytes(bm.cap));
  }
  bm.bits := 0;
  bm.len := 0;
  bm.cap := 0;
}
