// data.strbridge — interop between the string types and the DataFrame
//
// Ties together the owned byte String (std.strtype), the UTF-8 Text type
// (std.text), and the DataFrame's Utf8 columns (data.frame):
//   - String <-> Text conversions.
//   - Reading/writing a DataFrame Utf8 cell as a validated Text, so string
//     columns can be processed Unicode-correctly (codepoints, NFC, case).
//
// Lives in the data layer (depends on std) — correct direction, no layering
// inversion.

@description("Interop: String <-> Text and DataFrame Utf8 cells <-> Text")
@author("Andreas Röne")
@copyright("2024-2026 Andreas Röne")
unit data.strbridge;

import data.frame;
import std.strtype;
import std.text;
import std.unicode;

// ---- String <-> Text -------------------------------------------------------

// Owned byte String -> UTF-8 Text (validated; check TextIsValid for the result).
pub fn StringToText(s: String): Text {
  return TextFromUtf8(s.Data(), s.Length());
}

// UTF-8 Text -> owned byte String (raw bytes copied).
pub fn TextToString(t: Text): String {
  return StringFromBytes(TextData(t), TextByteLength(t));
}

// ---- DataFrame Utf8 cell <-> Text ------------------------------------------

// Read the Utf8 cell df[col,row] as a validated Text. A NULL cell yields an
// empty Text.
pub fn DataFrameGetTextCell(df: DataFrame, col: int64, row: int64): Text {
  if (DataFrameIsValid(df, col, row) == 0) {
    return TextFromUtf8(0, 0);
  }
  var ptr: int64 := DataFrameGetUtf8Ptr(df, col, row);
  var len: int64 := DataFrameGetUtf8Len(df, col, row);
  return TextFromUtf8(ptr, len);
}

// Write Text `t` into the Utf8 cell df[col,row]. Returns 1 on success.
pub fn DataFrameSetTextCell(df: DataFrame, col: int64, row: int64, t: Text): int64 {
  return DataFrameSetUtf8(df, col, row, TextData(t), TextByteLength(t));
}

// ---- column-level Text operations ------------------------------------------

// 1 if every non-NULL cell of the Utf8 column `col` is valid UTF-8, else 0.
// A data-quality check after importing CSV/JSON etc.
pub fn DataFrameColumnAllValidUtf8(df: DataFrame, col: int64): int64 {
  var r: int64 := 0;
  while (r < df.rowCount) {
    if (DataFrameIsValid(df, col, r) != 0) {
      var t: Text := DataFrameGetTextCell(df, col, r);
      var ok: int64 := TextIsValid(t);
      TextFree(t);
      if (ok == 0) { return 0; }
    }
    r += 1;
  }
  return 1;
}

// Rewrite every non-NULL cell of the Utf8 column `col` to its NFC form. After
// this, byte-wise operations on the column (group-by / join / equality) become
// normalisation-insensitive — e.g. a composed "é" (U+00E9) and a decomposed
// "e"+U+0301 are unified. Returns the number of cells normalised.
pub fn DataFrameNormalizeColumnNFC(df: DataFrame, col: int64): int64 {
  var count: int64 := 0;
  var r: int64 := 0;
  while (r < df.rowCount) {
    if (DataFrameIsValid(df, col, r) != 0) {
      var t: Text := DataFrameGetTextCell(df, col, r);
      var nfc: Text := TextToNFC(t);
      DataFrameSetTextCell(df, col, r, nfc);
      TextFree(t);
      TextFree(nfc);
      count += 1;
    }
    r += 1;
  }
  return count;
}
