#!/bin/sh
# preinst — Unit-Baeume, die dieses Paket NICHT mitliefert, ueber das Auspacken
# retten (#2633).
#
# BEFUND. Die Installation von 1.2.47B entfernte /usr/include/lyx/units/lyxos/
# und legte damit jeden Bau mit --target=lyxos still. Das ist kein Fehlgriff
# von dpkg, sondern seine Regel: ein frueheres Paket (LYU_BAEUME="x86_64
# lyxos") hatte diese Dateien mitgeliefert, das neue liefert sie nicht mehr --
# also raeumt dpkg sie beim Hochruesten weg. Dass es RICHTIG ist, macht es
# nicht harmlos: ohne gueltigen Baum meldet lyxc jeden benutzten Namen als
# undefiniert, und zwar in den PAKETDATEIEN des Benutzers statt in seinem
# Quelltext ("undefined function 'NowMs'" in vega/forms.lyx). Der Fehler wird
# dann an der falschen Stelle gesucht.
#
# WARUM NICHT STATT DESSEN ALLES MITLIEFERN. #2536 hat es gemessen: der
# lyxos-Baum ist installiert 274 MB gross gegen 2,4 MB bei x86_64, weil seine
# .lyu den IR-Abschnitt verbatim tragen (#2538). Gepackt faellt das nicht auf
# (1,05 %), der Preis liegt vollstaendig auf der Platte des Benutzers. Solange
# das so ist, bleibt x86_64 die Vorgabe -- und dieses Skript sorgt dafuer, dass
# ein selbst gebauter Baum daneben das Hochruesten UEBERLEBT.
#
# WIE. Vor dem Auspacken wandert jeder vorhandene Baum nach .vorher-<name>;
# dpkg packt dann seine Baeume frisch aus. postinst entscheidet je Baum: liegt
# er nach dem Auspacken wieder da, gilt die Paketfassung und die Sicherung
# faellt weg; fehlt er, wird die Sicherung zurueckgestellt.
#
# Dass kein Baum aufgezaehlt wird, ist Absicht: das Skript muss nicht wissen,
# was das Paket mitbringt -- das steht nach dem Auspacken auf der Platte. Eine
# Liste hier waere eine zweite Aufzaehlung derselben Sache und wuerde beim
# naechsten neuen Ziel vergessen.
set -e

BASIS="${DPKG_ROOT:-}/usr/include/lyx/units"

sichern() {
  [ -d "$BASIS" ] || return 0
  for d in "$BASIS"/*/; do
    [ -d "$d" ] || continue
    n="$(basename "$d")"
    case "$n" in .vorher-*) continue ;; esac
    rm -rf "$BASIS/.vorher-$n"
    mv "$d" "$BASIS/.vorher-$n"
  done
}

zurueck() {
  [ -d "$BASIS" ] || return 0
  for s in "$BASIS"/.vorher-*/; do
    [ -d "$s" ] || continue
    n="$(basename "$s")"; n="${n#.vorher-}"
    if [ -d "$BASIS/$n" ]; then rm -rf "$s"; else mv "$s" "$BASIS/$n"; fi
  done
}

case "$1" in
  install|upgrade)  sichern ;;
  # Bricht das Hochruesten ab, ruft dpkg das preinst des ALTEN Pakets mit
  # abort-upgrade. Die Sicherung muss dann zurueck, sonst bleibt der Benutzer
  # ohne Baeume stehen -- schlimmer als der Befund, den dieses Skript behebt.
  abort-upgrade)    zurueck ;;
esac

exit 0
