#!/bin/sh
# postinst — gesicherte Unit-Baeume zurueckstellen, die das Paket nicht
# mitliefert (#2633). Gegenstueck zu preinst; die Begruendung steht dort.
#
# Geurteilt wird am ZUSTAND der Platte, nicht an einer Liste: liegt der Baum
# nach dem Auspacken wieder da, hat ihn das Paket mitgebracht und die
# Paketfassung gilt. Fehlt er, war er lokal gebaut und wird zurueckgestellt.
set -e

BASIS="${DPKG_ROOT:-}/usr/include/lyx/units"

case "$1" in
  configure|abort-remove|abort-deconfigure)
    if [ -d "$BASIS" ]; then
      for s in "$BASIS"/.vorher-*/; do
        [ -d "$s" ] || continue
        n="$(basename "$s")"; n="${n#.vorher-}"
        if [ -d "$BASIS/$n" ]; then
          rm -rf "$s"
        else
          mv "$s" "$BASIS/$n"
          echo "lyx-compiler: Unit-Baum units/$n erhalten (nicht im Paket enthalten)."
        fi
      done
    fi
    ;;
esac

exit 0
