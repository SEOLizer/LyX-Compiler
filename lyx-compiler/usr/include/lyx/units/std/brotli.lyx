// std/brotli.lyx — Brotli-Dekompressor (RFC 7932) + Store-Kompressor
//
// Decompressor: vollständige RFC-7932-Implementierung (ohne statisches Dict).
// Compressor:   Store-Modus (gültige Brotli-Streams, keine Komprimierung).
//
// Schiebefenster: bis 16 MB (WBITS 10..24).
// Bekannte Einschränkung: static-dictionary-Transforms (§8) werden nicht
//   unterstützt — betrifft nur sehr wenige Streams in der Praxis.

unit std.brotli;

import std.alloc;
import std.io;
import std.string;

pub con BROTLI_OK:        int64 := 0;
pub con BROTLI_ERR:       int64 := 0 - 1;
pub con BROTLI_OVERFLOW:  int64 := 0 - 2;

// ============================================================================
// BrStream — Bit-Reader (40 Bytes)
// [0] src int64  [8] pos int64  [16] len int64  [24] bitBuf int64  [32] nBits int64
// ============================================================================

fn brNewStream(src: int64, srcLen: int64): int64 {
    var s: int64 := alloc(40);
    poke64(s,      src);
    poke64(s + 8,  0);
    poke64(s + 16, srcLen);
    poke64(s + 24, 0);
    poke64(s + 32, 0);
    return s;
}

fn brFill(s: int64): void {
    var pos:   int64 := peek64(s + 8);
    var srcLen: int64 := peek64(s + 16);
    var buf:   int64 := peek64(s + 24);
    var nb:    int64 := peek64(s + 32);
    while ((nb <= 56) & (pos < srcLen)) {
        var src: int64 := peek64(s);
        buf := buf | (peek8(src + pos) << nb);
        nb  := nb + 8;
        pos += 1;
    }
    poke64(s + 8,  pos);
    poke64(s + 24, buf);
    poke64(s + 32, nb);
}

fn brReadBit(s: int64): int64 {
    var nb: int64 := peek64(s + 32);
    if (nb == 0) { brFill(s); nb := peek64(s + 32); }
    var buf: int64 := peek64(s + 24);
    var bit: int64 := buf & 1;
    poke64(s + 24, buf >> 1);
    poke64(s + 32, nb - 1);
    return bit;
}

fn brReadBits(s: int64, n: int64): int64 {
    if (n == 0) { return 0; }
    brFill(s);
    var buf:  int64 := peek64(s + 24);
    var nb:   int64 := peek64(s + 32);
    var mask: int64 := (1 << n) - 1;
    var val:  int64 := buf & mask;
    poke64(s + 24, buf >> n);
    poke64(s + 32, nb - n);
    return val;
}

fn brPeekBits(s: int64, n: int64): int64 {
    brFill(s);
    var buf:  int64 := peek64(s + 24);
    var mask: int64 := (1 << n) - 1;
    return buf & mask;
}

fn brSkipBits(s: int64, n: int64): void {
    var buf: int64 := peek64(s + 24);
    var nb:  int64 := peek64(s + 32);
    poke64(s + 24, buf >> n);
    poke64(s + 32, nb - n);
}

fn brAlignByte(s: int64): void {
    var nb:  int64 := peek64(s + 32);
    var rem: int64 := nb % 8;
    if (rem != 0) { brSkipBits(s, rem); }
}

fn brBytesLeft(s: int64): int64 {
    return peek64(s + 16) - peek64(s + 8);
}

// ============================================================================
// Lookup-Tabellen: Insert/Copy-Längen-Codes (RFC 7932 §7.3)
// ============================================================================

fn brInsertBase(c: int64): int64 {
    if (c == 0)  { return 0; }      if (c == 1)  { return 1; }
    if (c == 2)  { return 2; }      if (c == 3)  { return 3; }
    if (c == 4)  { return 4; }      if (c == 5)  { return 5; }
    if (c == 6)  { return 6; }      if (c == 7)  { return 8; }
    if (c == 8)  { return 10; }     if (c == 9)  { return 14; }
    if (c == 10) { return 18; }     if (c == 11) { return 26; }
    if (c == 12) { return 34; }     if (c == 13) { return 50; }
    if (c == 14) { return 66; }     if (c == 15) { return 98; }
    if (c == 16) { return 130; }    if (c == 17) { return 194; }
    if (c == 18) { return 322; }    if (c == 19) { return 578; }
    if (c == 20) { return 1090; }   if (c == 21) { return 2114; }
    if (c == 22) { return 6210; }
    return 22594;
}

fn brInsertExtra(c: int64): int64 {
    if (c <= 5)  { return 0; }
    if (c <= 7)  { return 1; }
    if (c <= 9)  { return 2; }
    if (c <= 11) { return 3; }
    if (c <= 13) { return 4; }
    if (c <= 15) { return 5; }
    if (c == 16) { return 6; }
    if (c == 17) { return 7; }
    if (c == 18) { return 8; }
    if (c == 19) { return 9; }
    if (c == 20) { return 10; }
    if (c == 21) { return 12; }
    if (c == 22) { return 14; }
    return 24;
}

fn brCopyBase(c: int64): int64 {
    if (c == 0)  { return 2; }      if (c == 1)  { return 3; }
    if (c == 2)  { return 4; }      if (c == 3)  { return 5; }
    if (c == 4)  { return 6; }      if (c == 5)  { return 7; }
    if (c == 6)  { return 8; }      if (c == 7)  { return 9; }
    if (c == 8)  { return 10; }     if (c == 9)  { return 12; }
    if (c == 10) { return 14; }     if (c == 11) { return 18; }
    if (c == 12) { return 22; }     if (c == 13) { return 30; }
    if (c == 14) { return 38; }     if (c == 15) { return 54; }
    if (c == 16) { return 70; }     if (c == 17) { return 102; }
    if (c == 18) { return 134; }    if (c == 19) { return 198; }
    if (c == 20) { return 326; }    if (c == 21) { return 582; }
    if (c == 22) { return 1094; }
    return 2118;
}

fn brCopyExtra(c: int64): int64 {
    if (c <= 7)  { return 0; }
    if (c <= 9)  { return 1; }
    if (c <= 11) { return 2; }
    if (c <= 13) { return 3; }
    if (c <= 15) { return 4; }
    if (c <= 17) { return 5; }
    if (c <= 19) { return 6; }
    if (c <= 21) { return 7; }
    if (c == 22) { return 9; }
    return 24;
}

// Block-Längen-Codes (26 Symbole, RFC 7932 Tabelle 3)
fn brBlkBase(c: int64): int64 {
    if (c == 0)  { return 1; }      if (c == 1)  { return 5; }
    if (c == 2)  { return 9; }      if (c == 3)  { return 13; }
    if (c == 4)  { return 17; }     if (c == 5)  { return 25; }
    if (c == 6)  { return 33; }     if (c == 7)  { return 41; }
    if (c == 8)  { return 49; }     if (c == 9)  { return 65; }
    if (c == 10) { return 81; }     if (c == 11) { return 97; }
    if (c == 12) { return 113; }    if (c == 13) { return 145; }
    if (c == 14) { return 177; }    if (c == 15) { return 209; }
    if (c == 16) { return 241; }    if (c == 17) { return 305; }
    if (c == 18) { return 369; }    if (c == 19) { return 497; }
    if (c == 20) { return 753; }    if (c == 21) { return 1265; }
    if (c == 22) { return 2289; }   if (c == 23) { return 4337; }
    if (c == 24) { return 8433; }
    return 16625;
}

fn brBlkExtra(c: int64): int64 {
    if (c <= 3)  { return 2; }
    if (c <= 7)  { return 3; }
    if (c <= 11) { return 4; }
    if (c <= 15) { return 5; }
    if (c <= 17) { return 6; }
    if (c == 18) { return 7; }
    if (c == 19) { return 8; }
    if (c == 20) { return 9; }
    if (c == 21) { return 10; }
    if (c == 22) { return 11; }
    if (c == 23) { return 12; }
    if (c == 24) { return 13; }
    return 24;
}

// Permutations-Reihenfolge für Meta-Huffman-Code-Längen (RFC 7932 §3.4)
fn brMetaOrd(i: int64): int64 {
    if (i == 0)  { return 1; }   if (i == 1)  { return 2; }
    if (i == 2)  { return 3; }   if (i == 3)  { return 4; }
    if (i == 4)  { return 0; }   if (i == 5)  { return 5; }
    if (i == 6)  { return 17; }  if (i == 7)  { return 6; }
    if (i == 8)  { return 16; }  if (i == 9)  { return 7; }
    if (i == 10) { return 8; }   if (i == 11) { return 9; }
    if (i == 12) { return 10; }  if (i == 13) { return 11; }
    if (i == 14) { return 12; }  if (i == 15) { return 13; }
    if (i == 16) { return 14; }
    return 15;
}

// ============================================================================
// Huffman-Baum (kanonisch, canonical decoding)
// Struct (416 Bytes):
//   [0]   maxLen     int64
//   [8]   firstCode  [16]int64  (128 Bytes)
//   [136] firstIdx   [16]int64  (128 Bytes)
//   [264] countArr   [16]int64  (128 Bytes)
//   [392] symsPtr    int64      → gepacktes u16-Array
//   [400] trivialSym int64      (-1 = normal, ≥0 = trivialer Einzel-Code)
//   [408] total
// ============================================================================

fn brLog2Ceil(n: int64): int64 {
    var bits: int64 := 0;
    var sz:   int64 := 1;
    while (sz < n) { sz := sz * 2; bits := bits + 1; }
    return bits;
}

fn brBuildTree(lens: int64, numSyms: int64): int64 {
    // 416 Byte gemaess der Layout-Beschreibung oben: der Slot [408] total lag
    // bisher AUSSERHALB der Allokation von 408 Byte.
    var tree:    int64 := alloc(416);
    var count:   int64 := alloc(16 * 8);
    var i:       int64 := 0;
    var maxLen:  int64 := 0;
    var total:   int64 := 0;

    while (i < 16) { poke64(count + i * 8, 0); i := i + 1; }

    i := 0;
    while (i < numSyms) {
        var l: int64 := peek8(lens + i);
        if (l > 0) {
            poke64(count + l * 8, peek64(count + l * 8) + 1);
            if (l > maxLen) { maxLen := l; }
            total += 1;
        }
        i += 1;
    }

    poke64(tree, maxLen);
    poke64(tree + 400, 0 - 1);  // trivialSym = -1

    if (maxLen == 0) {
        // Trivial: first symbol with len=0 (single-symbol code)
        // Caller must use brBuildTrivialTree instead
        free(count, 16 * 8);
        poke64(tree + 392, 0);
        return tree;
    }

    // Compute first canonical code per length
    var firstCode: int64 := alloc(16 * 8);
    i := 0;
    while (i < 16) { poke64(firstCode + i * 8, 0); i := i + 1; }
    var code: int64 := 0;
    var l: int64 := 1;
    while (l <= maxLen) {
        code := (code + peek64(count + (l - 1) * 8)) << 1;
        poke64(firstCode + l * 8, code);
        l += 1;
    }

    // Compute firstIdx per length
    var firstIdx: int64 := alloc(16 * 8);
    i := 0;
    while (i < 16) { poke64(firstIdx + i * 8, 0); i := i + 1; }
    var idx: int64 := 0;
    l := 1;
    while (l <= maxLen) {
        poke64(firstIdx + l * 8, idx);
        idx := idx + peek64(count + l * 8);
        l += 1;
    }

    // Build sorted symbol array (packed u16)
    var syms: int64 := alloc(total * 2 + 2);
    idx := 0;
    l := 1;
    while (l <= maxLen) {
        i := 0;
        while (i < numSyms) {
            if (peek8(lens + i) == l) {
                poke8(syms + idx * 2,     i & 0xFF);
                poke8(syms + idx * 2 + 1, (i >> 8) & 0xFF);
                idx += 1;
            }
            i += 1;
        }
        l += 1;
    }

    // Copy into tree struct
    i := 0;
    while (i < 16) {
        poke64(tree + 8 + i * 8,   peek64(firstCode + i * 8));
        poke64(tree + 136 + i * 8, peek64(firstIdx  + i * 8));
        poke64(tree + 264 + i * 8, peek64(count     + i * 8));
        i += 1;
    }
    poke64(tree + 392, syms);
    poke64(tree + 408, total);   // fuer brFreeTree: syms war alloc(total * 2 + 2)

    free(firstCode, 16 * 8);
    free(firstIdx, 16 * 8);
    free(count, 16 * 8);
    return tree;
}

fn brBuildTrivialTree(sym: int64): int64 {
    var tree: int64 := alloc(416);
    var i: int64 := 0;
    while (i < 416) { poke8(tree + i, 0); i := i + 1; }
    // maxLen = 0 (already 0)
    poke64(tree + 392, 0);    // no syms needed
    poke64(tree + 400, sym);  // trivialSym
    poke64(tree + 408, 0);
    return tree;
}

fn brFreeTree(tree: int64): void {
    if (tree == 0) { return; }
    var syms: int64 := peek64(tree + 392);
    if (syms != 0) { free(syms, peek64(tree + 408) * 2 + 2); }
    free(tree, 416);
}

fn brDecodeSymbol(s: int64, tree: int64): int64 {
    var trivial: int64 := peek64(tree + 400);
    if (trivial >= 0) { return trivial; }
    var maxLen: int64 := peek64(tree);
    var val:    int64 := 0;
    var l:      int64 := 1;
    while (l <= maxLen) {
        val := (val << 1) | brReadBit(s);
        var fc:  int64 := peek64(tree + 8 + l * 8);
        var cnt: int64 := peek64(tree + 264 + l * 8);
        if ((val >= fc) & ((val - fc) < cnt)) {
            var fi:   int64 := peek64(tree + 136 + l * 8);
            var idx:  int64 := fi + (val - fc);
            var syms: int64 := peek64(tree + 392);
            return peek8(syms + idx * 2) | (peek8(syms + idx * 2 + 1) << 8);
        }
        l += 1;
    }
    return 0 - 1;
}

// ============================================================================
// Prefix-Code-Längen lesen (RFC 7932 §3.4)
// ============================================================================

fn brReadComplexTree(s: int64, numSyms: int64, hskip: int64): int64 {
    var metaLens: int64 := alloc(18);
    var i: int64 := 0;
    while (i < 18) { poke8(metaLens + i, 0); i := i + 1; }

    i := hskip;
    while (i < 18) {
        var sym: int64 := brMetaOrd(i);
        var l:   int64 := brReadBits(s, 3);
        poke8(metaLens + sym, l);
        i += 1;
    }

    var metaTree: int64 := brBuildTree(metaLens, 18);
    free(metaLens, 18);

    var lens: int64 := alloc(numSyms);
    i := 0;
    while (i < numSyms) { poke8(lens + i, 0); i := i + 1; }

    var prevLen: int64 := 8;
    i := 0;
    while (i < numSyms) {
        var sym: int64 := brDecodeSymbol(s, metaTree);
        if (sym < 16) {
            poke8(lens + i, sym);
            if (sym != 0) { prevLen := sym; }
            i += 1;
        } else {
            if (sym == 16) {
                var extra: int64 := brReadBits(s, 2);
                var count: int64 := extra + 3;
                if ((i + count) > numSyms) { count := numSyms - i; }
                var j: int64 := 0;
                while (j < count) {
                    poke8(lens + i, prevLen);
                    i += 1;
                    j += 1;
                }
            } else {
                var extra: int64 := brReadBits(s, 3);
                var count: int64 := extra + 3;
                if ((i + count) > numSyms) { count := numSyms - i; }
                var j: int64 := 0;
                while (j < count) {
                    poke8(lens + i, 0);
                    i += 1;
                    j += 1;
                }
            }
        }
    }

    brFreeTree(metaTree);
    var tree: int64 := brBuildTree(lens, numSyms);
    free(lens, numSyms);
    return tree;
}

fn brReadTree(s: int64, numSyms: int64): int64 {
    var hskip: int64 := brReadBits(s, 2);

    if (hskip != 1) {
        return brReadComplexTree(s, numSyms, hskip);
    }

    // Simple prefix code
    var abits:   int64 := brLog2Ceil(numSyms);
    var nsym:    int64 := brReadBits(s, 2) + 1;
    var sa:      int64 := alloc(4 * 8);
    var i:       int64 := 0;
    while (i < nsym) {
        poke64(sa + i * 8, brReadBits(s, abits));
        i += 1;
    }
    var special: int64 := 0;
    if (nsym == 4) { special := brReadBit(s); }

    var tree: int64 := 0;
    if (nsym == 1) {
        tree := brBuildTrivialTree(peek64(sa));
    } else {
        var lens: int64 := alloc(numSyms);
        i := 0;
        while (i < numSyms) { poke8(lens + i, 0); i := i + 1; }

        if (nsym == 2) {
            poke8(lens + peek64(sa),     1);
            poke8(lens + peek64(sa + 8), 1);
        } else {
            if (nsym == 3) {
                poke8(lens + peek64(sa),      1);
                poke8(lens + peek64(sa + 8),  2);
                poke8(lens + peek64(sa + 16), 2);
            } else {
                if (special == 0) {
                    poke8(lens + peek64(sa),      2);
                    poke8(lens + peek64(sa + 8),  2);
                    poke8(lens + peek64(sa + 16), 2);
                    poke8(lens + peek64(sa + 24), 2);
                } else {
                    poke8(lens + peek64(sa),      1);
                    poke8(lens + peek64(sa + 8),  2);
                    poke8(lens + peek64(sa + 16), 3);
                    poke8(lens + peek64(sa + 24), 3);
                }
            }
        }
        tree := brBuildTree(lens, numSyms);
        free(lens, numSyms);
    }
    free(sa, 4 * 8);
    return tree;
}

// ============================================================================
// Hilfsfunktionen: WBITS, NBLTYPES, Block-Zähler
// ============================================================================

fn brReadWBits(s: int64): int64 {
    if (brReadBit(s) == 0) { return 16; }
    var n: int64 := brReadBits(s, 3);
    if (n < 7) { return n + 17; }
    var m: int64 := brReadBits(s, 3);
    if (m == 0) { return 24; }
    if (m < 7)  { return m + 9; }
    return 0 - 1;  // error
}

fn brReadNBltypes(s: int64): int64 {
    if (brReadBit(s) == 0) { return 1; }
    var n: int64 := brReadBits(s, 3);
    var x: int64 := 0;
    if (n > 0) { x := brReadBits(s, n); }
    return (1 << n) + x + 1;
}

fn brReadBlkCount(s: int64, cntTree: int64): int64 {
    var sym: int64 := brDecodeSymbol(s, cntTree);
    return brBlkBase(sym) + brReadBits(s, brBlkExtra(sym));
}

// ============================================================================
// Block-State (40 Bytes)
// [0] nbltypes  [8] blktype  [16] blkcount  [24] typeTree  [32] cntTree
// ============================================================================

fn brNewBlkState(s: int64, typeAlph: int64): int64 {
    var bs:   int64 := alloc(40);
    var nb:   int64 := brReadNBltypes(s);
    poke64(bs,      nb);
    poke64(bs + 8,  0);
    poke64(bs + 16, 0 - 1);  // unlimited initially
    poke64(bs + 24, 0);
    poke64(bs + 32, 0);

    if (nb > 1) {
        var typeTree: int64 := brReadTree(s, nb + 2);
        var cntTree:  int64 := brReadTree(s, 26);
        var cnt:      int64 := brReadBlkCount(s, cntTree);
        poke64(bs + 24, typeTree);
        poke64(bs + 32, cntTree);
        poke64(bs + 16, cnt);
    }
    return bs;
}

fn brFreeBlkState(bs: int64): void {
    if (bs == 0) { return; }
    var tt: int64 := peek64(bs + 24);
    var ct: int64 := peek64(bs + 32);
    if (tt != 0) { brFreeTree(tt); }
    if (ct != 0) { brFreeTree(ct); }
    free(bs, 40);
}

// Decrements block count; switches block type when count reaches 0.
fn brTickBlk(s: int64, bs: int64): void {
    var cnt: int64 := peek64(bs + 16);
    if (cnt < 0) { return; }  // unlimited (nbltypes==1)
    cnt -= 1;
    if (cnt > 0) {
        poke64(bs + 16, cnt);
        return;
    }
    // Switch block type
    var nb:  int64 := peek64(bs);
    var cur: int64 := peek64(bs + 8);
    var tt:  int64 := peek64(bs + 24);
    var ct:  int64 := peek64(bs + 32);
    var sym: int64 := brDecodeSymbol(s, tt);
    var nxt: int64 := 0;
    if (sym == 0) {
        // "previous" type: wrap to last previous
        if (cur == 0) { nxt := nb - 1; } else { nxt := cur - 1; }
    } else {
        if (sym == 1) {
            nxt := (cur + 1) % nb;
        } else {
            nxt := sym - 2;
        }
    }
    poke64(bs + 8, nxt);
    poke64(bs + 16, brReadBlkCount(s, ct));
}

// ============================================================================
// Kontext-Map lesen (RFC 7932 §7.3)
// Gibt Pointer auf int64-Array der Länge 'size' zurück.
// ============================================================================

fn brReadContextMap(s: int64, ntrees: int64, cmSize: int64): int64 {
    var cmap:   int64 := alloc(cmSize * 8);
    var i:      int64 := 0;
    while (i < cmSize) { poke64(cmap + i * 8, 0); i := i + 1; }

    var rlemax: int64 := 0;
    if (brReadBit(s) == 1) { rlemax := brReadBits(s, 4) + 1; }

    var cmAlph: int64 := ntrees + rlemax;
    var cmTree: int64 := brReadTree(s, cmAlph);

    i := 0;
    while (i < cmSize) {
        var sym: int64 := brDecodeSymbol(s, cmTree);
        if (sym < ntrees) {
            poke64(cmap + i * 8, sym);
            i += 1;
        } else {
            var rc:  int64 := sym - ntrees + 1;
            var run: int64 := (1 << rc) + brReadBits(s, rc);
            if ((i + run) > cmSize) { run := cmSize - i; }
            var j: int64 := 0;
            while (j < run) {
                poke64(cmap + i * 8, 0);
                i += 1;
                j += 1;
            }
        }
    }

    brFreeTree(cmTree);

    // Inverse Move-to-Front (wenn Bit gesetzt)
    if (brReadBit(s) == 1) {
        var mtf: int64 := alloc(256 * 8);
        var k:   int64 := 0;
        while (k < 256) { poke64(mtf + k * 8, k); k := k + 1; }
        k := 0;
        while (k < cmSize) {
            var idx: int64 := peek64(cmap + k * 8);
            var val: int64 := peek64(mtf + idx * 8);
            poke64(cmap + k * 8, val);
            var m: int64 := idx;
            while (m > 0) {
                poke64(mtf + m * 8, peek64(mtf + (m - 1) * 8));
                m -= 1;
            }
            poke64(mtf, val);
            k += 1;
        }
        free(mtf, 256 * 8);
    }

    return cmap;
}

// ============================================================================
// BrCtx — Haupt-Dekompressor-Kontext (136 Bytes)
// [0] stream  [8] window  [16] wsize  [24] wmask  [32] wpos
// [40] dst  [48] dstPos  [56] dstMax  [64] error
// [72..103] dist-Ringpuffer (4×int64)
// [104] lit0 (letztes Literal)  [112] lit1  [120] npostfix  [128] ndirect
// ============================================================================

fn brCtxNew(s: int64, dst: int64, dstMax: int64): int64 {
    var wbits: int64 := brReadWBits(s);
    if (wbits < 10) { return 0; }
    var wsize:  int64 := 1 << wbits;
    var wmask:  int64 := wsize - 1;
    var window: int64 := alloc(wsize);
    var ctx:    int64 := alloc(136);
    poke64(ctx,       s);
    poke64(ctx + 8,   window);
    poke64(ctx + 16,  wsize);
    poke64(ctx + 24,  wmask);
    poke64(ctx + 32,  0);
    poke64(ctx + 40,  dst);
    poke64(ctx + 48,  0);
    poke64(ctx + 56,  dstMax);
    poke64(ctx + 64,  0);
    poke64(ctx + 72,  4);   // dist ring buffer initialised to {4, 11, 15, 16}
    poke64(ctx + 80,  11);
    poke64(ctx + 88,  15);
    poke64(ctx + 96,  16);
    poke64(ctx + 104, 0);   // lit0
    poke64(ctx + 112, 0);   // lit1
    poke64(ctx + 120, 0);   // npostfix
    poke64(ctx + 128, 0);   // ndirect
    return ctx;
}

fn brCtxFree(ctx: int64): void {
    if (ctx == 0) { return; }
    var win: int64 := peek64(ctx + 8);
    if (win != 0) { free(win, peek64(ctx + 16)); }
    free(ctx, 136);
}

fn brOutput(ctx: int64, b: int64): void {
    var dstPos: int64 := peek64(ctx + 48);
    var dstMax: int64 := peek64(ctx + 56);
    if (dstPos >= dstMax) { poke64(ctx + 64, 1); return; }
    var dst:    int64 := peek64(ctx + 40);
    poke8(dst + dstPos, b);
    poke64(ctx + 48, dstPos + 1);
    var wpos:  int64 := peek64(ctx + 32);
    var wmask: int64 := peek64(ctx + 24);
    var win:   int64 := peek64(ctx + 8);
    poke8(win + wpos, b);
    poke64(ctx + 32, (wpos + 1) & wmask);
    // Update last literals
    poke64(ctx + 112, peek64(ctx + 104));
    poke64(ctx + 104, b);
}

fn brCopyRef(ctx: int64, dist: int64, copyLen: int64): void {
    var wpos:  int64 := peek64(ctx + 32);
    var wsize: int64 := peek64(ctx + 16);
    var wmask: int64 := peek64(ctx + 24);
    var win:   int64 := peek64(ctx + 8);
    var i:     int64 := 0;
    while (i < copyLen) {
        var src: int64 := (wpos - dist + wsize) & wmask;
        var b:   int64 := peek8(win + src);
        brOutput(ctx, b);
        wpos   := peek64(ctx + 32);
        wmask  := peek64(ctx + 24);
        win    := peek64(ctx + 8);
        i += 1;
    }
}

// Push new distance into ring buffer
fn brPushDist(ctx: int64, d: int64): void {
    poke64(ctx + 96, peek64(ctx + 88));
    poke64(ctx + 88, peek64(ctx + 80));
    poke64(ctx + 80, peek64(ctx + 72));
    poke64(ctx + 72, d);
}

// ============================================================================
// Distanz-Dekodierung (RFC 7932 §7.4)
// ============================================================================

fn brDecodeDistance(ctx: int64, s: int64, distCode: int64): int64 {
    if (distCode == 0) { return peek64(ctx + 72); }
    if (distCode == 1) { return peek64(ctx + 80); }
    if (distCode == 2) { return peek64(ctx + 88); }
    if (distCode == 3) { return peek64(ctx + 96); }
    var ndirect: int64 := peek64(ctx + 128);
    if (distCode <= (ndirect + 3)) {
        return distCode - 3;
    }
    var npostfix: int64 := peek64(ctx + 120);
    var d2:       int64 := distCode - ndirect - 4;
    var half:     int64 := (d2 >> npostfix) >> 1;
    var pmask:    int64 := (1 << npostfix) - 1;
    var postfix:  int64 := d2 & pmask;
    var nbits:    int64 := half + 1;
    var extra:    int64 := brReadBits(s, nbits);
    return ((2 + ((d2 >> npostfix) & 1)) << nbits) - 4 + ndirect + (extra << npostfix) + postfix;
}

// ============================================================================
// IC-Code dekodieren (RFC 7932 §7.3)
// Gibt insert_code in insertOut, copy_code in copyOut.
// Gibt 1 zurück falls "use last distance", sonst 0.
// ============================================================================

fn brDecodeIC(icCode: int64, insertOut: int64, copyOut: int64): int64 {
    var useLast: int64 := 0;
    var ic:      int64 := 0;
    var cc:      int64 := 0;
    if (icCode < 128) {
        useLast := 1;
        if (icCode < 64) {
            ic := (icCode >> 3) & 7;
            cc := icCode & 7;
        } else {
            ic := ((icCode - 64) >> 3) & 7;
            cc := 8 + ((icCode - 64) & 7);
        }
    } else {
        var d2: int64 := icCode - 128;
        var g:  int64 := d2 >> 6;
        var b:  int64 := d2 & 63;
        ic := ((g / 3) * 8) + ((b >> 3) & 7);
        cc := ((g % 3) * 8) + (b & 7);
    }
    poke64(insertOut, ic);
    poke64(copyOut,   cc);
    return useLast;
}

// ============================================================================
// Literal-Kontext-ID (RFC 7932 §7.2)
// ============================================================================

fn brLiteralCtx(ctx: int64, mode: int64): int64 {
    var l0: int64 := peek64(ctx + 104);
    var l1: int64 := peek64(ctx + 112);
    if (mode == 0) { return l0 & 0x3F; }
    if (mode == 1) { return l0 >> 2; }
    if (mode == 3) { return ((l0 >> 3) & 7) | ((l1 >> 1) & 56); }
    // mode 2 (UTF-8): simplified fallback to mode 0
    return l0 & 0x3F;
}

// ============================================================================
// Meta-Block-Dekodierung
// meta-state (104 Bytes):
// [0]  mlen     [8]  blkL  [16] blkI  [24] blkD
// [32] ctxModes [40] ntreesL [48] ntreesD
// [56] cmapL  [64] cmapD
// [72] treesL [80] treesI [88] treesD
// [96] distAlph
// ============================================================================

fn brFreeMetaState(ms: int64): void {
    if (ms == 0) { return; }
    var bL: int64 := peek64(ms + 8);
    var bI: int64 := peek64(ms + 16);
    var bD: int64 := peek64(ms + 24);
    if (bL != 0) { brFreeBlkState(bL); }
    if (bI != 0) { brFreeBlkState(bI); }
    if (bD != 0) { brFreeBlkState(bD); }

    var modes: int64 := peek64(ms + 32);
    if (modes != 0) { free(modes, peek64(ms + 104)); }

    var cmL: int64 := peek64(ms + 56);
    var cmD: int64 := peek64(ms + 64);
    if (cmL != 0) { free(cmL, peek64(ms + 112) * 8); }
    if (cmD != 0) { free(cmD, peek64(ms + 120) * 8); }

    var ntL: int64 := peek64(ms + 40);
    var ntD: int64 := peek64(ms + 48);

    var tL: int64 := peek64(ms + 72);
    var tI: int64 := peek64(ms + 80);
    var tD: int64 := peek64(ms + 88);

    if (tL != 0) {
        var bsL: int64 := peek64(ms + 8);
        var nbL: int64 := ntL;
        var i: int64 := 0;
        while (i < nbL) {
            var t: int64 := peek64(tL + i * 8);
            if (t != 0) { brFreeTree(t); }
            i += 1;
        }
        free(tL, ntL * 8);
    }
    if (tI != 0) {
        var bsI: int64 := peek64(ms + 16);
        var nbI: int64 := peek64(bsI);
        var i: int64 := 0;
        while (i < nbI) {
            var t: int64 := peek64(tI + i * 8);
            if (t != 0) { brFreeTree(t); }
            i += 1;
        }
        free(tI, nbI * 8);
    }
    if (tD != 0) {
        var nbD: int64 := ntD;
        var i: int64 := 0;
        while (i < nbD) {
            var t: int64 := peek64(tD + i * 8);
            if (t != 0) { brFreeTree(t); }
            i += 1;
        }
        free(tD, nbD * 8);
    }

    free(ms, 128);
}

// Liest den Header eines komprimierten Meta-Blocks und baut alle Huffman-Bäume.
fn brReadMetaHeader(s: int64, ctx: int64): int64 {
    var ms: int64 := alloc(128);   // 104 Nutzdaten + 3 Groessen-Slots (104/112/120)
    var i:  int64 := 0;
    while (i < 104) { poke8(ms + i, 0); i := i + 1; }

    var bL: int64 := brNewBlkState(s, 258);
    var bI: int64 := brNewBlkState(s, 258);
    var bD: int64 := brNewBlkState(s, 258);
    poke64(ms + 8,  bL);
    poke64(ms + 16, bI);
    poke64(ms + 24, bD);

    var nbL: int64 := peek64(bL);
    var nbI: int64 := peek64(bI);
    var nbD: int64 := peek64(bD);

    // NPOSTFIX (2 bits) + NDIRECT (4 bits × 2^NPOSTFIX)
    var npostfix: int64 := brReadBits(s, 2);
    var ndirect:  int64 := brReadBits(s, 4) << npostfix;
    poke64(ctx + 120, npostfix);
    poke64(ctx + 128, ndirect);

    // Context modes (2 bits each, one per literal block type)
    var modes: int64 := alloc(nbL);
    i := 0;
    while (i < nbL) {
        poke8(modes + i, brReadBits(s, 2));
        i += 1;
    }
    poke64(ms + 32, modes);
    poke64(ms + 104, nbL);        // fuer brFreeMetaState: modes war alloc(nbL)

    // NTREESL (number of literal Huffman trees)
    var ntL: int64 := brReadNBltypes(s);
    poke64(ms + 40, ntL);

    // Context maps
    var cmL: int64 := brReadContextMap(s, ntL, nbL * 64);
    var ntD: int64 := brReadNBltypes(s);
    poke64(ms + 48, ntD);
    var cmD: int64 := brReadContextMap(s, ntD, nbD * 4);
    poke64(ms + 56, cmL);
    poke64(ms + 64, cmD);
    poke64(ms + 112, nbL * 64);   // Eintraege in cmL
    poke64(ms + 120, nbD * 4);    // Eintraege in cmD

    // Distance alphabet size
    var distAlph: int64 := 16 + (ndirect) + (48 << npostfix);
    poke64(ms + 96, distAlph);

    // Read NTREESL literal trees
    var tL: int64 := alloc(ntL * 8);
    i := 0;
    while (i < ntL) {
        poke64(tL + i * 8, brReadTree(s, 256));
        i += 1;
    }
    poke64(ms + 72, tL);

    // Read NBLTYPESI IC trees (one per IC block type)
    var tI: int64 := alloc(nbI * 8);
    i := 0;
    while (i < nbI) {
        poke64(tI + i * 8, brReadTree(s, 704));
        i += 1;
    }
    poke64(ms + 80, tI);

    // Read NTREESD distance trees
    var tD: int64 := alloc(ntD * 8);
    i := 0;
    while (i < ntD) {
        poke64(tD + i * 8, brReadTree(s, distAlph));
        i += 1;
    }
    poke64(ms + 88, tD);

    return ms;
}

// Dekodiert MLEN bytes aus einem komprimierten Meta-Block.
fn brDecompressMeta(ctx: int64, ms: int64, mlen: int64): void {
    var s:       int64 := peek64(ctx);
    var bL:      int64 := peek64(ms + 8);
    var bI:      int64 := peek64(ms + 16);
    var bD:      int64 := peek64(ms + 24);
    var modes:   int64 := peek64(ms + 32);
    var cmL:     int64 := peek64(ms + 56);
    var cmD:     int64 := peek64(ms + 64);
    var tL:      int64 := peek64(ms + 72);
    var tI:      int64 := peek64(ms + 80);
    var tD:      int64 := peek64(ms + 88);
    var ntL:     int64 := peek64(ms + 40);
    var ntD:     int64 := peek64(ms + 48);
    var dAlph:   int64 := peek64(ms + 96);
    var remain:  int64 := mlen;
    var distOut: int64 := alloc(8);
    var insOut:  int64 := alloc(8);
    var cpOut:   int64 := alloc(8);

    while (remain > 0) {
        if (peek64(ctx + 64) != 0) {
            remain := 0;
        } else {
            // Get current block types
            var ltType: int64 := peek64(bL + 8);
            var icType: int64 := peek64(bI + 8);
            var dType:  int64 := peek64(bD + 8);

            // Tick IC block
            brTickBlk(s, bI);

            // Decode IC code
            var icTree:  int64 := peek64(tI + icType * 8);
            var icCode:  int64 := brDecodeSymbol(s, icTree);
            var useLast: int64 := brDecodeIC(icCode, insOut, cpOut);
            var insCd:   int64 := peek64(insOut);
            var cpCd:    int64 := peek64(cpOut);

            var insLen: int64 := brInsertBase(insCd) + brReadBits(s, brInsertExtra(insCd));
            var cpLen:  int64 := brCopyBase(cpCd)    + brReadBits(s, brCopyExtra(cpCd));

            // Insert literals
            var j: int64 := 0;
            while (j < insLen) {
                brTickBlk(s, bL);
                var ltType2: int64 := peek64(bL + 8);
                var mode:    int64 := peek8(modes + ltType2);
                var ctxId:   int64 := brLiteralCtx(ctx, mode);
                var cmOff:   int64 := ltType2 * 64 + ctxId;
                var tidx:    int64 := peek64(cmL + cmOff * 8);
                var litTree: int64 := peek64(tL + tidx * 8);
                var lit:     int64 := brDecodeSymbol(s, litTree);
                brOutput(ctx, lit);
                remain -= 1;
                j += 1;
            }

            if (remain <= 0) {
                remain := 0;
            } else {
                // Decode distance
                var dist: int64 := 0;
                if (useLast == 1) {
                    dist := peek64(ctx + 72);
                } else {
                    brTickBlk(s, bD);
                    var dType2: int64 := peek64(bD + 8);
                    var ctxId:  int64 := 0;
                    var cmOff:  int64 := dType2 * 4 + ctxId;
                    var tidx:   int64 := peek64(cmD + cmOff * 8);
                    var dTree:  int64 := peek64(tD + tidx * 8);
                    var dCode:  int64 := brDecodeSymbol(s, dTree);
                    dist := brDecodeDistance(ctx, s, dCode);
                    brPushDist(ctx, dist);
                }

                // Copy
                brCopyRef(ctx, dist, cpLen);
                remain -= cpLen;
                if (remain < 0) { remain := 0; }
            }
        }
    }

    free(distOut, 8);
    free(insOut, 8);
    free(cpOut, 8);
}

// ============================================================================
// BrotliDecompress — öffentliche API
// ============================================================================

pub fn BrotliDecompress(src: int64, srcLen: int64, dst: int64, dstMax: int64): int64 {
    if ((src == 0) | (dst == 0) | (srcLen <= 0)) { return BROTLI_ERR; }

    var s:   int64 := brNewStream(src, srcLen);
    var ctx: int64 := brCtxNew(s, dst, dstMax);
    if (ctx == 0) { free(s, 40); return BROTLI_ERR; }

    var done: int64 := 0;
    while (done == 0) {
        if (peek64(ctx + 64) != 0) {
            done := 1;
        } else {
            // Read ISLAST
            var isLast: int64 := brReadBit(s);

            // Read ISLASTEMPTY (only if ISLAST)
            var isEmpty: int64 := 0;
            if (isLast == 1) { isEmpty := brReadBit(s); }

            if (isEmpty == 1) {
                done := 1;
            } else {
                // Read MLEN
                var mnibbles: int64 := brReadBits(s, 2);
                if (mnibbles == 3) {
                    // skip reserved / metadata block: not supported, skip
                    done := 1;
                } else {
                    var nbytes: int64 := mnibbles + 4;
                    var mlen:   int64 := 0;
                    var k:      int64 := 0;
                    while (k < nbytes) {
                        mlen := mlen | (brReadBits(s, 4) << (k * 4));
                        k += 1;
                    }
                    mlen += 1;

                    var isUncomp: int64 := 0;
                    if (isLast == 0) { isUncomp := brReadBit(s); }

                    if (isUncomp == 1) {
                        // Uncompressed: align to byte, copy mlen bytes
                        brAlignByte(s);
                        var i: int64 := 0;
                        while (i < mlen) {
                            brOutput(ctx, brReadBits(s, 8));
                            i += 1;
                        }
                    } else {
                        // Compressed meta-block
                        var ms: int64 := brReadMetaHeader(s, ctx);
                        if (ms != 0) {
                            brDecompressMeta(ctx, ms, mlen);
                            brFreeMetaState(ms);
                        } else {
                            poke64(ctx + 64, 1);
                        }
                    }
                }
                if (isLast == 1) { done := 1; }
            }
        }
    }

    var written: int64 := peek64(ctx + 48);
    var err:     int64 := peek64(ctx + 64);
    brCtxFree(ctx);
    free(s, 40);

    if (err != 0) { return BROTLI_ERR; }
    return written;
}

// ============================================================================
// BrWriter — Bit-Writer für Kompressor (40 Bytes)
// [0] dst  [8] pos  [16] dstMax  [24] bitBuf  [32] nBits
// ============================================================================

fn brwNew(dst: int64, dstMax: int64): int64 {
    var w: int64 := alloc(40);
    poke64(w,      dst);
    poke64(w + 8,  0);
    poke64(w + 16, dstMax);
    poke64(w + 24, 0);
    poke64(w + 32, 0);
    return w;
}

fn brwWriteBits(w: int64, val: int64, n: int64): void {
    var buf: int64 := peek64(w + 24);
    var nb:  int64 := peek64(w + 32);
    buf := buf | (val << nb);
    nb  := nb + n;
    while (nb >= 8) {
        var pos:    int64 := peek64(w + 8);
        var dst:    int64 := peek64(w);
        var dstMax: int64 := peek64(w + 16);
        if (pos < dstMax) {
            poke8(dst + pos, buf & 0xFF);
            pos += 1;
            poke64(w + 8, pos);
        }
        buf := buf >> 8;
        nb  := nb - 8;
    }
    poke64(w + 24, buf);
    poke64(w + 32, nb);
}

fn brwFlush(w: int64): void {
    var nb: int64 := peek64(w + 32);
    if (nb > 0) { brwWriteBits(w, 0, 8 - nb); }
}

// ============================================================================
// BrotliCompress — Store-Modus (kein LZ77, gültiger RFC-7932-Stream)
// ============================================================================

pub fn BrotliCompress(src: int64, srcLen: int64, dst: int64, dstMax: int64): int64 {
    if ((src == 0) | (dst == 0)) { return BROTLI_ERR; }
    if (srcLen == 0) {
        if (dstMax < 1) { return BROTLI_OVERFLOW; }
        poke8(dst, 0x06);  // WBITS=16(0) ISLAST=1 ISLASTEMPTY=1 → 0b00000110 → 0x06
        return 1;
    }

    // Worst case: 4 bytes header per chunk + srcLen + 1 byte terminal
    var chunks: int64 := (srcLen + 16777215) / 16777216;
    var needed: int64 := srcLen + chunks * 5 + 2;
    if (dstMax < needed) { return BROTLI_OVERFLOW; }

    var w:   int64 := brwNew(dst, dstMax);

    // WBITS = 16: single bit 0
    brwWriteBits(w, 0, 1);

    var pos: int64 := 0;
    while (pos < srcLen) {
        var remain: int64 := srcLen - pos;
        var blk:    int64 := remain;
        if (blk > 16777216) { blk := 16777216; }

        var M: int64 := blk - 1;

        // RFC 7932 §9.2: last nibble of MLEN-1 MUST NOT be zero → use minimum nibbles
        var mnibCode: int64 := 0;  // 0→4 nibbles, 1→5 nibbles, 2→6 nibbles
        if (M >= 0x100000) { mnibCode := 2; }
        else { if (M >= 0x10000) { mnibCode := 1; } }

        // ISLAST=0 always for data blocks — ISUNCOMPRESSED only allowed when ISLAST=0
        brwWriteBits(w, 0, 1);         // ISLAST=0
        brwWriteBits(w, mnibCode, 2);  // MNIBBLES
        // MLEN-1 in (mnibCode+4) nibbles
        var nnibs: int64 := mnibCode + 4;
        var k: int64 := 0;
        while (k < nnibs) {
            brwWriteBits(w, (M >> (k * 4)) & 0xF, 4);
            k += 1;
        }
        brwWriteBits(w, 1, 1);    // ISUNCOMPRESSED=1
        brwFlush(w);              // auf Bytegrenze ausrichten

        // Rohdaten
        var i: int64 := 0;
        while (i < blk) {
            var outPos: int64 := peek64(w + 8);
            var outDst: int64 := peek64(w);
            poke8(outDst + outPos, peek8(src + pos + i));
            poke64(w + 8, outPos + 1);
            i += 1;
        }
        pos += blk;
    }

    // Terminal empty last block: ISLAST=1 ISLASTEMPTY=1 (2 bits) + flush
    brwWriteBits(w, 3, 2);   // 0b11 = ISLAST=1, ISLASTEMPTY=1
    brwFlush(w);

    var written: int64 := peek64(w + 8);
    free(w, 40);
    return written;
}
