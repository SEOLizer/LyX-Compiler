// std/brotli.lyx — Brotli (RFC 7932)
//
// KOMPRESSION (#1075): echte komprimierte Meta-Bloecke — Huffman-codierte
// Literale, Insert-and-Copy-Codes und Distanzcodes. Ein Meta-Block ueber die
// gesamte Eingabe, je ein Blocktyp (NBLTYPES* = 1), NPOSTFIX = 0, NDIRECT = 0,
// ein Literal- und ein Distanzbaum (NTREES* = 1); damit entfallen
// Blockwechselcodes und Kontextkarten. Rueckfall auf den unkomprimierten
// Meta-Block, wenn sich nichts lohnt. Gemessen:
//
//     1000 Byte Text   ->    150 Byte
//    65536 Byte Text   ->    152 Byte
//   300000 Byte Text   ->    153 Byte
//    50000 Byte 'A'    ->     12 Byte
//    20000 Byte Zufall ->  20004 Byte  (unkomprimiert, kein Schaden)
//
// Gegengelesen wird ausschliesslich mit der REFERENZIMPLEMENTIERUNG
// (python3 `brotli`) — siehe unten, warum der eigene Dekodierer dafuer
// nicht taugt.
//
// DEKOMPRESSION (#1079): laeuft. Gemessen ueber 120 Frames der
// Referenzimplementierung (zehn Eingaben x zwoelf Qualitaetsstufen):
//
//                              korrekt  still falsch  gemeldet  abgestuerzt
//   Ausgangslage (36 Frames)      13         0            0         23
//   nach #1075 (36 Frames)        13         0            0         23
//   heute (120 Frames)            88         0           32          0
//
// Die 32 gemeldeten sind Stroeme, die das STATISCHE WOERTERBUCH (§8) brauchen.
// Das ist nicht umgesetzt und wird deshalb als Fehler zurueckgegeben, nicht
// geraten -- vorher kopierte der Dekodierer an dieser Stelle aus dem Fenster
// und lieferte stillschweigend falschen Inhalt.
//
// Acht belegte Defekte, in der Reihenfolge des Findens (#1075 und #1079):
//
//   1. brCopyExtra: Zusatzbits ab Code 19 falsch. Betrifft jede Kopie ab
//      Laenge 198.
//   2. brReadContextMap: kein Waechter fuer NTREES < 2. Laut §9.2 steht die
//      Karte dann GAR NICHT im Strom.
//   3. brReadComplexTree: las die Codelaengen als feste DREI Bit statt mit dem
//      variablen 2..4-Bit-Code aus §3.5, ohne Abbruch ueber die Kraft-Summe
//      und ohne die Wiederholcodes 16/17.
//   4. brDecodeIC: rechnete die neun Zellen der Tabelle aus §5 als schlichtes
//      3x3-Raster; die Tabelle ist anders angeordnet.
//   5. brDecodeDistance kannte nur VIER Sondersymbole statt SECHZEHN (§4).
//      Damit war alles danach um zwoelf verschoben -- und weil die Zahl der
//      Zusatzbits aus derselben Rechnung kam, wurde auch die falsche BITZAHL
//      gelesen. Ab der ersten Distanz war der Strom aus dem Takt.
//   6. brFreeMetaState las die Zahl der Baeume aus dem bereits freigegebenen
//      Blockzustand -- ein Use-after-free, der NACH vollstaendig richtiger
//      Dekodierung zuschlug.
//   7. brReadContextMap hatte die Symbolreihenfolge vertauscht: laut §7.3
//      stehen die Lauflaengencodes VORN (1..RLEMAX), die Werte dahinter.
//   8. brLiteralCtx kannte von den vier Kontextmodi nur zwei. UTF8 fiel still
//      auf LSB6 zurueck, Signed rechnete etwas Eigenes. Beide brauchen die
//      Tabellen aus §7.1 -- sie stehen jetzt als brLut0/1/2 hier und werden
//      im Test gegen die CRC-32 aus dem RFC gehalten.
//   Dazu brReadWBits, das die zweite Stufe des WBITS-Codes nie las (10..17).
//
// Was den Befund erst sichtbar gemacht hat, war nicht scharfes Hinsehen,
// sondern der KOMPRESSOR: erst mit ihm gab es kleine Stroeme mit bekanntem
// Inhalt, gegen die sich Schritt fuer Schritt vergleichen liess.
//
// NICHT umgesetzt: das statische Woerterbuch (§8) samt Transformationen.
// Ein Strom, der es braucht, wird gemeldet.
//
// Schiebefenster: bis 16 MB (WBITS 10..24).
// Bekannte Einschraenkung: static-dictionary-Transforms (§8) werden nicht
//   unterstuetzt.

unit std.brotli;

import std.alloc;
import std.io;
import std.string;

pub con BROTLI_OK:        int64 := 0;
pub con BROTLI_ERR:       int64 := 0 - 1;
pub con BROTLI_OVERFLOW:  int64 := 0 - 2;

// ============================================================================
// BrStream — Bit-Reader (40 Bytes)
// [0] src int64  [8] pos int64  [16] len int64  [24] bitBuf int64  [32] nBits int64
// ============================================================================

fn brNewStream(src: int64, srcLen: int64): int64 {
    var s: int64 := alloc(40);
    poke64(s,      src);
    poke64(s + 8,  0);
    poke64(s + 16, srcLen);
    poke64(s + 24, 0);
    poke64(s + 32, 0);
    return s;
}

fn brFill(s: int64): void {
    var pos:   int64 := peek64(s + 8);
    var srcLen: int64 := peek64(s + 16);
    var buf:   int64 := peek64(s + 24);
    var nb:    int64 := peek64(s + 32);
    while ((nb <= 56) & (pos < srcLen)) {
        var src: int64 := peek64(s);
        buf := buf | (peek8(src + pos) << nb);
        nb  := nb + 8;
        pos += 1;
    }
    poke64(s + 8,  pos);
    poke64(s + 24, buf);
    poke64(s + 32, nb);
}

fn brReadBit(s: int64): int64 {
    var nb: int64 := peek64(s + 32);
    if (nb == 0) { brFill(s); nb := peek64(s + 32); }
    var buf: int64 := peek64(s + 24);
    var bit: int64 := buf & 1;
    poke64(s + 24, buf >> 1);
    poke64(s + 32, nb - 1);
    return bit;
}

fn brReadBits(s: int64, n: int64): int64 {
    if (n == 0) { return 0; }
    brFill(s);
    var buf:  int64 := peek64(s + 24);
    var nb:   int64 := peek64(s + 32);
    var mask: int64 := (1 << n) - 1;
    var val:  int64 := buf & mask;
    poke64(s + 24, buf >> n);
    poke64(s + 32, nb - n);
    return val;
}

fn brPeekBits(s: int64, n: int64): int64 {
    brFill(s);
    var buf:  int64 := peek64(s + 24);
    var mask: int64 := (1 << n) - 1;
    return buf & mask;
}

fn brSkipBits(s: int64, n: int64): void {
    var buf: int64 := peek64(s + 24);
    var nb:  int64 := peek64(s + 32);
    poke64(s + 24, buf >> n);
    poke64(s + 32, nb - n);
}

fn brAlignByte(s: int64): void {
    var nb:  int64 := peek64(s + 32);
    var rem: int64 := nb % 8;
    if (rem != 0) { brSkipBits(s, rem); }
}

fn brBytesLeft(s: int64): int64 {
    return peek64(s + 16) - peek64(s + 8);
}

// ============================================================================
// Lookup-Tabellen: Insert/Copy-Längen-Codes (RFC 7932 §7.3)
// ============================================================================

fn brInsertBase(c: int64): int64 {
    if (c == 0)  { return 0; }      if (c == 1)  { return 1; }
    if (c == 2)  { return 2; }      if (c == 3)  { return 3; }
    if (c == 4)  { return 4; }      if (c == 5)  { return 5; }
    if (c == 6)  { return 6; }      if (c == 7)  { return 8; }
    if (c == 8)  { return 10; }     if (c == 9)  { return 14; }
    if (c == 10) { return 18; }     if (c == 11) { return 26; }
    if (c == 12) { return 34; }     if (c == 13) { return 50; }
    if (c == 14) { return 66; }     if (c == 15) { return 98; }
    if (c == 16) { return 130; }    if (c == 17) { return 194; }
    if (c == 18) { return 322; }    if (c == 19) { return 578; }
    if (c == 20) { return 1090; }   if (c == 21) { return 2114; }
    if (c == 22) { return 6210; }
    return 22594;
}

fn brInsertExtra(c: int64): int64 {
    if (c <= 5)  { return 0; }
    if (c <= 7)  { return 1; }
    if (c <= 9)  { return 2; }
    if (c <= 11) { return 3; }
    if (c <= 13) { return 4; }
    if (c <= 15) { return 5; }
    if (c == 16) { return 6; }
    if (c == 17) { return 7; }
    if (c == 18) { return 8; }
    if (c == 19) { return 9; }
    if (c == 20) { return 10; }
    if (c == 21) { return 12; }
    if (c == 22) { return 14; }
    return 24;
}

fn brCopyBase(c: int64): int64 {
    if (c == 0)  { return 2; }      if (c == 1)  { return 3; }
    if (c == 2)  { return 4; }      if (c == 3)  { return 5; }
    if (c == 4)  { return 6; }      if (c == 5)  { return 7; }
    if (c == 6)  { return 8; }      if (c == 7)  { return 9; }
    if (c == 8)  { return 10; }     if (c == 9)  { return 12; }
    if (c == 10) { return 14; }     if (c == 11) { return 18; }
    if (c == 12) { return 22; }     if (c == 13) { return 30; }
    if (c == 14) { return 38; }     if (c == 15) { return 54; }
    if (c == 16) { return 70; }     if (c == 17) { return 102; }
    if (c == 18) { return 134; }    if (c == 19) { return 198; }
    if (c == 20) { return 326; }    if (c == 21) { return 582; }
    if (c == 22) { return 1094; }
    return 2118;
}

// #1075: Die Zusatzbits ab Code 19 wichen von RFC 7932 §5 ab -- 19 stand auf
// 6 statt 7, 20 und 21 auf 7 statt 8 und 9, 22 auf 9 statt 10. Betroffen ist
// jede Kopie ab Laenge 198. Aufgefallen ist es erst, als es einen KOMPRIMIERER
// gab: der Dekoder allein hatte die Tabelle nie gegen etwas gehalten, und
// solche Kopien kamen in den bisherigen Testdaten nicht vor.
fn brCopyExtra(c: int64): int64 {
    if (c <= 7)  { return 0; }
    if (c <= 9)  { return 1; }
    if (c <= 11) { return 2; }
    if (c <= 13) { return 3; }
    if (c <= 15) { return 4; }
    if (c <= 17) { return 5; }
    if (c == 18) { return 6; }
    if (c == 19) { return 7; }
    if (c == 20) { return 8; }
    if (c == 21) { return 9; }
    if (c == 22) { return 10; }
    return 24;
}

// Block-Längen-Codes (26 Symbole, RFC 7932 Tabelle 3)
fn brBlkBase(c: int64): int64 {
    if (c == 0)  { return 1; }      if (c == 1)  { return 5; }
    if (c == 2)  { return 9; }      if (c == 3)  { return 13; }
    if (c == 4)  { return 17; }     if (c == 5)  { return 25; }
    if (c == 6)  { return 33; }     if (c == 7)  { return 41; }
    if (c == 8)  { return 49; }     if (c == 9)  { return 65; }
    if (c == 10) { return 81; }     if (c == 11) { return 97; }
    if (c == 12) { return 113; }    if (c == 13) { return 145; }
    if (c == 14) { return 177; }    if (c == 15) { return 209; }
    if (c == 16) { return 241; }    if (c == 17) { return 305; }
    if (c == 18) { return 369; }    if (c == 19) { return 497; }
    if (c == 20) { return 753; }    if (c == 21) { return 1265; }
    if (c == 22) { return 2289; }   if (c == 23) { return 4337; }
    if (c == 24) { return 8433; }
    return 16625;
}

fn brBlkExtra(c: int64): int64 {
    if (c <= 3)  { return 2; }
    if (c <= 7)  { return 3; }
    if (c <= 11) { return 4; }
    if (c <= 15) { return 5; }
    if (c <= 17) { return 6; }
    if (c == 18) { return 7; }
    if (c == 19) { return 8; }
    if (c == 20) { return 9; }
    if (c == 21) { return 10; }
    if (c == 22) { return 11; }
    if (c == 23) { return 12; }
    if (c == 24) { return 13; }
    return 24;
}

// Permutations-Reihenfolge für Meta-Huffman-Code-Längen (RFC 7932 §3.4)
fn brMetaOrd(i: int64): int64 {
    if (i == 0)  { return 1; }   if (i == 1)  { return 2; }
    if (i == 2)  { return 3; }   if (i == 3)  { return 4; }
    if (i == 4)  { return 0; }   if (i == 5)  { return 5; }
    if (i == 6)  { return 17; }  if (i == 7)  { return 6; }
    if (i == 8)  { return 16; }  if (i == 9)  { return 7; }
    if (i == 10) { return 8; }   if (i == 11) { return 9; }
    if (i == 12) { return 10; }  if (i == 13) { return 11; }
    if (i == 14) { return 12; }  if (i == 15) { return 13; }
    if (i == 16) { return 14; }
    return 15;
}

// ============================================================================
// Huffman-Baum (kanonisch, canonical decoding)
// Struct (416 Bytes):
//   [0]   maxLen     int64
//   [8]   firstCode  [16]int64  (128 Bytes)
//   [136] firstIdx   [16]int64  (128 Bytes)
//   [264] countArr   [16]int64  (128 Bytes)
//   [392] symsPtr    int64      → gepacktes u16-Array
//   [400] trivialSym int64      (-1 = normal, ≥0 = trivialer Einzel-Code)
//   [408] total
// ============================================================================

fn brLog2Ceil(n: int64): int64 {
    var bits: int64 := 0;
    var sz:   int64 := 1;
    while (sz < n) { sz := sz * 2; bits := bits + 1; }
    return bits;
}

fn brBuildTree(lens: int64, numSyms: int64): int64 {
    // 416 Byte gemaess der Layout-Beschreibung oben: der Slot [408] total lag
    // bisher AUSSERHALB der Allokation von 408 Byte.
    var tree:    int64 := alloc(416);
    var count:   int64 := alloc(16 * 8);
    var i:       int64 := 0;
    var maxLen:  int64 := 0;
    var total:   int64 := 0;

    while (i < 16) { poke64(count + i * 8, 0); i := i + 1; }

    i := 0;
    while (i < numSyms) {
        var l: int64 := peek8(lens + i);
        if (l > 0) {
            poke64(count + l * 8, peek64(count + l * 8) + 1);
            if (l > maxLen) { maxLen := l; }
            total += 1;
        }
        i += 1;
    }

    poke64(tree, maxLen);
    poke64(tree + 400, 0 - 1);  // trivialSym = -1

    if (maxLen == 0) {
        // Trivial: first symbol with len=0 (single-symbol code)
        // Caller must use brBuildTrivialTree instead
        free(count, 16 * 8);
        poke64(tree + 392, 0);
        return tree;
    }

    // Compute first canonical code per length
    var firstCode: int64 := alloc(16 * 8);
    i := 0;
    while (i < 16) { poke64(firstCode + i * 8, 0); i := i + 1; }
    var code: int64 := 0;
    var l: int64 := 1;
    while (l <= maxLen) {
        code := (code + peek64(count + (l - 1) * 8)) << 1;
        poke64(firstCode + l * 8, code);
        l += 1;
    }

    // Compute firstIdx per length
    var firstIdx: int64 := alloc(16 * 8);
    i := 0;
    while (i < 16) { poke64(firstIdx + i * 8, 0); i := i + 1; }
    var idx: int64 := 0;
    l := 1;
    while (l <= maxLen) {
        poke64(firstIdx + l * 8, idx);
        idx := idx + peek64(count + l * 8);
        l += 1;
    }

    // Build sorted symbol array (packed u16)
    var syms: int64 := alloc(total * 2 + 2);
    idx := 0;
    l := 1;
    while (l <= maxLen) {
        i := 0;
        while (i < numSyms) {
            if (peek8(lens + i) == l) {
                poke8(syms + idx * 2,     i & 0xFF);
                poke8(syms + idx * 2 + 1, (i >> 8) & 0xFF);
                idx += 1;
            }
            i += 1;
        }
        l += 1;
    }

    // Copy into tree struct
    i := 0;
    while (i < 16) {
        poke64(tree + 8 + i * 8,   peek64(firstCode + i * 8));
        poke64(tree + 136 + i * 8, peek64(firstIdx  + i * 8));
        poke64(tree + 264 + i * 8, peek64(count     + i * 8));
        i += 1;
    }
    poke64(tree + 392, syms);
    poke64(tree + 408, total);   // fuer brFreeTree: syms war alloc(total * 2 + 2)

    free(firstCode, 16 * 8);
    free(firstIdx, 16 * 8);
    free(count, 16 * 8);
    return tree;
}

fn brBuildTrivialTree(sym: int64): int64 {
    var tree: int64 := alloc(416);
    var i: int64 := 0;
    while (i < 416) { poke8(tree + i, 0); i := i + 1; }
    // maxLen = 0 (already 0)
    poke64(tree + 392, 0);    // no syms needed
    poke64(tree + 400, sym);  // trivialSym
    poke64(tree + 408, 0);
    return tree;
}

fn brFreeTree(tree: int64): void {
    if (tree == 0) { return; }
    var syms: int64 := peek64(tree + 392);
    if (syms != 0) { free(syms, peek64(tree + 408) * 2 + 2); }
    free(tree, 416);
}

fn brDecodeSymbol(s: int64, tree: int64): int64 {
    var trivial: int64 := peek64(tree + 400);
    if (trivial >= 0) { return trivial; }
    var maxLen: int64 := peek64(tree);
    var val:    int64 := 0;
    var l:      int64 := 1;
    while (l <= maxLen) {
        val := (val << 1) | brReadBit(s);
        var fc:  int64 := peek64(tree + 8 + l * 8);
        var cnt: int64 := peek64(tree + 264 + l * 8);
        if ((val >= fc) & ((val - fc) < cnt)) {
            var fi:   int64 := peek64(tree + 136 + l * 8);
            var idx:  int64 := fi + (val - fc);
            var syms: int64 := peek64(tree + 392);
            return peek8(syms + idx * 2) | (peek8(syms + idx * 2 + 1) << 8);
        }
        l += 1;
    }
    return 0 - 1;
}

// ============================================================================
// Prefix-Code-Längen lesen (RFC 7932 §3.4)
// ============================================================================

// Liest die Codelaenge EINES Codelaengen-Symbols. RFC 7932 §3.5 gibt dafuer
// einen festen Code mit 2..4 Bit an, nicht ein Feld fester Breite:
//   0 -> 00   1 -> 0111   2 -> 011   3 -> 10   4 -> 01   5 -> 1111
// Die Muster stehen so, wie sie im Strom erscheinen, also von rechts nach
// links gelesen -- das erste gelesene Bit ist das rechte Zeichen.
//
// #1075: Vorher las diese Stelle stur DREI Bit. Damit lief der Bitstrom ab
// dem ersten komplexen Code aus dem Takt, und der Rest des Meta-Blocks war
// Rauschen -- in der Praxis ein Absturz. Da es keinen Kompressor gab, ist es
// nie jemandem aufgefallen: gemessen wurde der Dekoder nie an echten Stroemen.
fn brReadCLLen(s: int64): int64 {
    if (brReadBit(s) == 0) {
        if (brReadBit(s) == 0) { return 0; }
        return 3;
    }
    if (brReadBit(s) == 0) { return 4; }
    if (brReadBit(s) == 0) { return 2; }
    if (brReadBit(s) == 0) { return 1; }
    return 5;
}

fn brReadComplexTree(s: int64, numSyms: int64, hskip: int64): int64 {
    var metaLens: int64 := alloc(18);
    var i: int64 := 0;
    while (i < 18) { poke8(metaLens + i, 0); i := i + 1; }

    // Die Folge endet, sobald der Code vollstaendig ist (Kraft-Summe 32) --
    // nachlaufende Nullen stehen nicht im Strom.
    var space:    int64 := 32;
    var numCodes: int64 := 0;
    var oneSym:   int64 := 0;
    i := hskip;
    while ((i < 18) & (space > 0)) {
        var sym: int64 := brMetaOrd(i);
        var l:   int64 := brReadCLLen(s);
        poke8(metaLens + sym, l);
        if (l != 0) {
            numCodes := numCodes + 1;
            oneSym := sym;
            space := space - (32 >> l);
        }
        i := i + 1;
    }
    if ((numCodes != 1) & (space != 0)) { free(metaLens, 18); return 0; }

    var metaTree: int64 := 0;
    if (numCodes == 1) {
        // Genau eine Laenge ungleich null: der Code hat EIN Symbol mit
        // Codelaenge null (RFC 7932 §3.5). Es werden dafuer keine Bits
        // gelesen.
        metaTree := brBuildTrivialTree(oneSym);
    } else {
        metaTree := brBuildTree(metaLens, 18);
    }
    free(metaLens, 18);

    var lens: int64 := alloc(numSyms);
    i := 0;
    while (i < numSyms) { poke8(lens + i, 0); i := i + 1; }

    // Auch hier endet die Folge, sobald der Code vollstaendig ist.
    var lspace:  int64 := 32768;
    var prevLen: int64 := 8;
    var repCount:  int64 := 0;
    var repLen:  int64 := 0;
    i := 0;
    while ((i < numSyms) & (lspace > 0)) {
        var sym: int64 := brDecodeSymbol(s, metaTree);
        if (sym < 0) { i := numSyms; }
        else {
            if (sym < 16) {
                repCount := 0;
                poke8(lens + i, sym);
                i := i + 1;
                if (sym != 0) {
                    prevLen := sym;
                    lspace := lspace - (32768 >> sym);
                }
            } else {
                // 16 wiederholt die letzte Laenge ungleich null, 17 die Null.
                // Folgt derselbe Code erneut, MODIFIZIERT er den bisherigen
                // Zaehler, statt einen neuen zu beginnen (§3.5).
                var extraBits: int64 := sym - 14;   // 16 -> 2, 17 -> 3
                var newLen:    int64 := prevLen;
                if (sym == 17) { newLen := 0; }
                if (repLen != newLen) { repCount := 0; repLen := newLen; }
                var oldRepeat: int64 := repCount;
                if (repCount > 0) {
                    repCount := repCount - 2;
                    repCount := repCount << extraBits;
                }
                repCount := repCount + brReadBits(s, extraBits) + 3;
                var delta: int64 := repCount - oldRepeat;
                if ((i + delta) > numSyms) { delta := numSyms - i; }
                var j: int64 := 0;
                while (j < delta) {
                    poke8(lens + i, repLen);
                    i := i + 1;
                    if (repLen != 0) { lspace := lspace - (32768 >> repLen); }
                    j := j + 1;
                }
            }
        }
    }

    brFreeTree(metaTree);
    var tree: int64 := brBuildTree(lens, numSyms);
    free(lens, numSyms);
    return tree;
}

fn brReadTree(s: int64, numSyms: int64): int64 {
    var hskip: int64 := brReadBits(s, 2);

    if (hskip != 1) {
        return brReadComplexTree(s, numSyms, hskip);
    }

    // Simple prefix code
    var abits:   int64 := brLog2Ceil(numSyms);
    var nsym:    int64 := brReadBits(s, 2) + 1;
    var sa:      int64 := alloc(4 * 8);
    var i:       int64 := 0;
    while (i < nsym) {
        poke64(sa + i * 8, brReadBits(s, abits));
        i += 1;
    }
    var special: int64 := 0;
    if (nsym == 4) { special := brReadBit(s); }

    var tree: int64 := 0;
    if (nsym == 1) {
        tree := brBuildTrivialTree(peek64(sa));
    } else {
        var lens: int64 := alloc(numSyms);
        i := 0;
        while (i < numSyms) { poke8(lens + i, 0); i := i + 1; }

        if (nsym == 2) {
            poke8(lens + peek64(sa),     1);
            poke8(lens + peek64(sa + 8), 1);
        } else {
            if (nsym == 3) {
                poke8(lens + peek64(sa),      1);
                poke8(lens + peek64(sa + 8),  2);
                poke8(lens + peek64(sa + 16), 2);
            } else {
                if (special == 0) {
                    poke8(lens + peek64(sa),      2);
                    poke8(lens + peek64(sa + 8),  2);
                    poke8(lens + peek64(sa + 16), 2);
                    poke8(lens + peek64(sa + 24), 2);
                } else {
                    poke8(lens + peek64(sa),      1);
                    poke8(lens + peek64(sa + 8),  2);
                    poke8(lens + peek64(sa + 16), 3);
                    poke8(lens + peek64(sa + 24), 3);
                }
            }
        }
        tree := brBuildTree(lens, numSyms);
        free(lens, numSyms);
    }
    free(sa, 4 * 8);
    return tree;
}

// ============================================================================
// Hilfsfunktionen: WBITS, NBLTYPES, Block-Zähler
// ============================================================================

// WBITS aus dem Stromkopf (RFC 7932 §9.1).
//
// #1079: Die Vorgaengerfassung gab bei n == 0 sofort 17 zurueck und las die
// ZWEITE Stufe nie. Genau dort stehen aber die Werte 10..17: n == 0 heisst
// "drei weitere Bits folgen". Umgekehrt las sie bei n == 7 drei Bits zu viel,
// obwohl n == 7 fuer sich schon WBITS 24 bedeutet. Nur 18..23 kamen zufaellig
// richtig heraus -- jeder Strom mit kleinerem Fenster lief aus dem Takt.
fn brReadWBits(s: int64): int64 {
    if (brReadBit(s) == 0) { return 16; }
    var n: int64 := brReadBits(s, 3);
    if (n != 0) { return n + 17; }          // 1..7 -> 18..24
    var m: int64 := brReadBits(s, 3);
    if (m == 0) { return 17; }
    if (m == 1) { return 0 - 1; }           // laut RFC ungueltig
    return m + 8;                            // 2..7 -> 10..15
}

fn brReadNBltypes(s: int64): int64 {
    if (brReadBit(s) == 0) { return 1; }
    var n: int64 := brReadBits(s, 3);
    var x: int64 := 0;
    if (n > 0) { x := brReadBits(s, n); }
    return (1 << n) + x + 1;
}

fn brReadBlkCount(s: int64, cntTree: int64): int64 {
    var sym: int64 := brDecodeSymbol(s, cntTree);
    return brBlkBase(sym) + brReadBits(s, brBlkExtra(sym));
}

// ============================================================================
// Block-State (40 Bytes)
// [0] nbltypes  [8] blktype  [16] blkcount  [24] typeTree  [32] cntTree
// ============================================================================

fn brNewBlkState(s: int64, typeAlph: int64): int64 {
    var bs:   int64 := alloc(40);
    var nb:   int64 := brReadNBltypes(s);
    poke64(bs,      nb);
    poke64(bs + 8,  0);
    poke64(bs + 16, 0 - 1);  // unlimited initially
    poke64(bs + 24, 0);
    poke64(bs + 32, 0);

    if (nb > 1) {
        var typeTree: int64 := brReadTree(s, nb + 2);
        var cntTree:  int64 := brReadTree(s, 26);
        var cnt:      int64 := brReadBlkCount(s, cntTree);
        poke64(bs + 24, typeTree);
        poke64(bs + 32, cntTree);
        poke64(bs + 16, cnt);
    }
    return bs;
}

fn brFreeBlkState(bs: int64): void {
    if (bs == 0) { return; }
    var tt: int64 := peek64(bs + 24);
    var ct: int64 := peek64(bs + 32);
    if (tt != 0) { brFreeTree(tt); }
    if (ct != 0) { brFreeTree(ct); }
    free(bs, 40);
}

// Decrements block count; switches block type when count reaches 0.
fn brTickBlk(s: int64, bs: int64): void {
    var cnt: int64 := peek64(bs + 16);
    if (cnt < 0) { return; }  // unlimited (nbltypes==1)
    cnt -= 1;
    if (cnt > 0) {
        poke64(bs + 16, cnt);
        return;
    }
    // Switch block type
    var nb:  int64 := peek64(bs);
    var cur: int64 := peek64(bs + 8);
    var tt:  int64 := peek64(bs + 24);
    var ct:  int64 := peek64(bs + 32);
    var sym: int64 := brDecodeSymbol(s, tt);
    var nxt: int64 := 0;
    if (sym == 0) {
        // "previous" type: wrap to last previous
        if (cur == 0) { nxt := nb - 1; } else { nxt := cur - 1; }
    } else {
        if (sym == 1) {
            nxt := (cur + 1) % nb;
        } else {
            nxt := sym - 2;
        }
    }
    poke64(bs + 8, nxt);
    poke64(bs + 16, brReadBlkCount(s, ct));
}

// ============================================================================
// Kontext-Map lesen (RFC 7932 §7.3)
// Gibt Pointer auf int64-Array der Länge 'size' zurück.
// ============================================================================

fn brReadContextMap(s: int64, ntrees: int64, cmSize: int64): int64 {
    var cmap:   int64 := alloc(cmSize * 8);
    var i:      int64 := 0;
    while (i < cmSize) { poke64(cmap + i * 8, 0); i := i + 1; }

    // #1075: Bei EINEM Baum steht im Strom gar keine Kontextkarte -- RFC 7932
    // §9.2: "appears only if NTREESL >= 2; otherwise, the context map has only
    // zero values". Ohne diese Sperre las der Dekoder ein RLEMAX-Bit und einen
    // Codebaum ueber ein EINELEMENTIGES Alphabet aus Daten, die etwas ganz
    // anderes bedeuten, und lief dann in der Fuellschleife aus dem Puffer:
    // Segmentation Fault. Da fast jeder reale Brotli-Strom mit einem
    // Literalbaum auskommt, betraf das nahezu alles -- 23 von 36 Frames der
    // Referenzimplementierung stuerzten ab, ehe es hier einen Kompressor gab,
    // an dem es auffallen konnte.
    if (ntrees < 2) { return cmap; }

    var rlemax: int64 := 0;
    if (brReadBit(s) == 1) { rlemax := brReadBits(s, 4) + 1; }

    var cmAlph: int64 := ntrees + rlemax;
    var cmTree: int64 := brReadTree(s, cmAlph);

    // #1079: Das Alphabet steht laut RFC 7932 §7.3 in dieser Reihenfolge:
    //     0                        -> Wert 0
    //     1 .. RLEMAX              -> Lauf von Nullen, rc = sym, rc Zusatzbits
    //     RLEMAX+1 .. RLEMAX+N-1   -> Werte 1 .. NTREES-1
    // Die Vorgaengerfassung hatte es genau andersherum: alles unter NTREES galt
    // als Wert, alles darueber als Lauflaenge. Werte wurden damit als Laeufe
    // gelesen und umgekehrt; die Karte war Rauschen und ihre Eintraege landeten
    // anschliessend als Index in einer Zeigertabelle -- daher der Absturz.
    i := 0;
    while (i < cmSize) {
        var sym: int64 := brDecodeSymbol(s, cmTree);
        if (sym < 0) {
            // Kein gueltiges Symbol: der Strom ist kaputt. Vorher wurde die -1
            // als Wert uebernommen und spaeter als Index benutzt.
            brFreeTree(cmTree);
            free(cmap, cmSize * 8);
            return 0;
        }
        if (sym == 0) {
            poke64(cmap + i * 8, 0);
            i += 1;
        } else {
            if (sym <= rlemax) {
                var rc:  int64 := sym;
                var run: int64 := (1 << rc) + brReadBits(s, rc);
                if ((i + run) > cmSize) { run := cmSize - i; }
                var j: int64 := 0;
                while (j < run) {
                    poke64(cmap + i * 8, 0);
                    i += 1;
                    j += 1;
                }
            } else {
                poke64(cmap + i * 8, sym - rlemax);
                i += 1;
            }
        }
    }

    brFreeTree(cmTree);

    // Inverse Move-to-Front (wenn Bit gesetzt)
    if (brReadBit(s) == 1) {
        var mtf: int64 := alloc(256 * 8);
        var k:   int64 := 0;
        while (k < 256) { poke64(mtf + k * 8, k); k := k + 1; }
        k := 0;
        while (k < cmSize) {
            var idx: int64 := peek64(cmap + k * 8);
            var val: int64 := peek64(mtf + idx * 8);
            poke64(cmap + k * 8, val);
            var m: int64 := idx;
            while (m > 0) {
                poke64(mtf + m * 8, peek64(mtf + (m - 1) * 8));
                m -= 1;
            }
            poke64(mtf, val);
            k += 1;
        }
        free(mtf, 256 * 8);
    }

    return cmap;
}

// ============================================================================
// BrCtx — Haupt-Dekompressor-Kontext (136 Bytes)
// [0] stream  [8] window  [16] wsize  [24] wmask  [32] wpos
// [40] dst  [48] dstPos  [56] dstMax  [64] error
// [72..103] dist-Ringpuffer (4×int64)
// [104] lit0 (letztes Literal)  [112] lit1  [120] npostfix  [128] ndirect
// ============================================================================

fn brCtxNew(s: int64, dst: int64, dstMax: int64): int64 {
    var wbits: int64 := brReadWBits(s);
    if (wbits < 10) { return 0; }
    var wsize:  int64 := 1 << wbits;
    var wmask:  int64 := wsize - 1;
    var window: int64 := alloc(wsize);
    var ctx:    int64 := alloc(136);
    poke64(ctx,       s);
    poke64(ctx + 8,   window);
    poke64(ctx + 16,  wsize);
    poke64(ctx + 24,  wmask);
    poke64(ctx + 32,  0);
    poke64(ctx + 40,  dst);
    poke64(ctx + 48,  0);
    poke64(ctx + 56,  dstMax);
    poke64(ctx + 64,  0);
    poke64(ctx + 72,  4);   // dist ring buffer initialised to {4, 11, 15, 16}
    poke64(ctx + 80,  11);
    poke64(ctx + 88,  15);
    poke64(ctx + 96,  16);
    poke64(ctx + 104, 0);   // lit0
    poke64(ctx + 112, 0);   // lit1
    poke64(ctx + 120, 0);   // npostfix
    poke64(ctx + 128, 0);   // ndirect
    return ctx;
}

fn brCtxFree(ctx: int64): void {
    if (ctx == 0) { return; }
    var win: int64 := peek64(ctx + 8);
    if (win != 0) { free(win, peek64(ctx + 16)); }
    free(ctx, 136);
}

fn brOutput(ctx: int64, b: int64): void {
    var dstPos: int64 := peek64(ctx + 48);
    var dstMax: int64 := peek64(ctx + 56);
    if (dstPos >= dstMax) { poke64(ctx + 64, 1); return; }
    var dst:    int64 := peek64(ctx + 40);
    poke8(dst + dstPos, b);
    poke64(ctx + 48, dstPos + 1);
    var wpos:  int64 := peek64(ctx + 32);
    var wmask: int64 := peek64(ctx + 24);
    var win:   int64 := peek64(ctx + 8);
    poke8(win + wpos, b);
    poke64(ctx + 32, (wpos + 1) & wmask);
    // Update last literals
    poke64(ctx + 112, peek64(ctx + 104));
    poke64(ctx + 104, b);
}

fn brCopyRef(ctx: int64, dist: int64, copyLen: int64): void {
    var wpos:  int64 := peek64(ctx + 32);
    var wsize: int64 := peek64(ctx + 16);
    var wmask: int64 := peek64(ctx + 24);
    var win:   int64 := peek64(ctx + 8);
    var i:     int64 := 0;
    while (i < copyLen) {
        var src: int64 := (wpos - dist + wsize) & wmask;
        var b:   int64 := peek8(win + src);
        brOutput(ctx, b);
        wpos   := peek64(ctx + 32);
        wmask  := peek64(ctx + 24);
        win    := peek64(ctx + 8);
        i += 1;
    }
}

// Push new distance into ring buffer
fn brPushDist(ctx: int64, d: int64): void {
    poke64(ctx + 96, peek64(ctx + 88));
    poke64(ctx + 88, peek64(ctx + 80));
    poke64(ctx + 80, peek64(ctx + 72));
    poke64(ctx + 72, d);
}

// ============================================================================
// Distanz-Dekodierung (RFC 7932 §7.4)
// ============================================================================

// Distanzcode zu Distanz (RFC 7932 §4). Rueckgabe < 1 heisst: ungueltig.
//
// #1079: Die Vorgaengerfassung kannte nur VIER Sondersymbole. Es sind
// SECHZEHN: 0..3 sind die vier zuletzt benutzten Distanzen, 4..15 sind
// dieselben mit +/-1, +/-2, +/-3. Alles danach war entsprechend um zwoelf
// verschoben -- und weil die Zahl der Zusatzbits aus derselben verschobenen
// Rechnung kam, las der Dekodierer auch die FALSCHE BITZAHL. Ab der ersten
// Distanz lief der Strom damit aus dem Takt; was danach kam, war Rauschen.
// Sichtbar wurde es als Absturz, nicht als Fehlermeldung.
fn brDecodeDistance(ctx: int64, s: int64, distCode: int64): int64 {
    var last:  int64 := peek64(ctx + 72);
    var last2: int64 := peek64(ctx + 80);
    var last3: int64 := peek64(ctx + 88);
    var last4: int64 := peek64(ctx + 96);

    if (distCode == 0)  { return last; }
    if (distCode == 1)  { return last2; }
    if (distCode == 2)  { return last3; }
    if (distCode == 3)  { return last4; }
    if (distCode == 4)  { return last - 1; }
    if (distCode == 5)  { return last + 1; }
    if (distCode == 6)  { return last - 2; }
    if (distCode == 7)  { return last + 2; }
    if (distCode == 8)  { return last - 3; }
    if (distCode == 9)  { return last + 3; }
    if (distCode == 10) { return last2 - 1; }
    if (distCode == 11) { return last2 + 1; }
    if (distCode == 12) { return last2 - 2; }
    if (distCode == 13) { return last2 + 2; }
    if (distCode == 14) { return last2 - 3; }
    if (distCode == 15) { return last2 + 3; }

    var ndirect:  int64 := peek64(ctx + 128);
    var npostfix: int64 := peek64(ctx + 120);

    // Die naechsten NDIRECT Symbole stehen unmittelbar fuer 1..NDIRECT.
    if (distCode < (16 + ndirect)) { return distCode - 15; }

    var d2:        int64 := distCode - ndirect - 16;
    var ndistbits: int64 := 1 + (d2 >> (npostfix + 1));
    var hcode:     int64 := d2 >> npostfix;
    var lcode:     int64 := d2 & ((1 << npostfix) - 1);
    var offset:    int64 := ((2 + (hcode & 1)) << ndistbits) - 4;
    var dextra:    int64 := brReadBits(s, ndistbits);
    return ((offset + dextra) << npostfix) + lcode + ndirect + 1;
}

// ============================================================================
// IC-Code dekodieren (RFC 7932 §7.3)
// Gibt insert_code in insertOut, copy_code in copyOut.
// Gibt 1 zurück falls "use last distance", sonst 0.
// ============================================================================

fn brDecodeIC(icCode: int64, insertOut: int64, copyOut: int64): int64 {
    var useLast: int64 := 0;
    var ic:      int64 := 0;
    var cc:      int64 := 0;
    if (icCode < 128) {
        useLast := 1;
        if (icCode < 64) {
            ic := (icCode >> 3) & 7;
            cc := icCode & 7;
        } else {
            ic := ((icCode - 64) >> 3) & 7;
            cc := 8 + ((icCode - 64) & 7);
        }
    } else {
        // #1075: Die neun Zellen der Tabelle in RFC 7932 §5 stehen NICHT
        // zeilenweise. Die Vorgaengerfassung rechnete sie als schlichtes
        // 3x3-Raster (ic = (g/3)*8, cc = (g%3)*8) und lag ab der dritten
        // Zelle daneben: Symbol 290 ergab Einfuegecode 4 und Kopiercode 18
        // statt 12 und 2. Betroffen ist jeder Befehl mit expliziter Distanz,
        // also praktisch jeder echte Strom.
        var d2: int64 := icCode - 128;
        var g:  int64 := d2 >> 6;
        var b:  int64 := d2 & 63;
        var insHi: int64 := 0;
        var cpyHi: int64 := 0;
        if (g == 0) { insHi := 0; cpyHi := 0; }
        else { if (g == 1) { insHi := 0; cpyHi := 1; }
        else { if (g == 2) { insHi := 1; cpyHi := 0; }
        else { if (g == 3) { insHi := 1; cpyHi := 1; }
        else { if (g == 4) { insHi := 0; cpyHi := 2; }
        else { if (g == 5) { insHi := 2; cpyHi := 0; }
        else { if (g == 6) { insHi := 1; cpyHi := 2; }
        else { if (g == 7) { insHi := 2; cpyHi := 1; }
        else { insHi := 2; cpyHi := 2; } } } } } } } }
        ic := insHi * 8 + ((b >> 3) & 7);
        cc := cpyHi * 8 + (b & 7);
    }
    poke64(insertOut, ic);
    poke64(copyOut,   cc);
    return useLast;
}

