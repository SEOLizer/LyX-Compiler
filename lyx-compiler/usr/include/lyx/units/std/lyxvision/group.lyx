// std/lyxvision/group.lyx
// LyxVision - TGroup: Container für Views (abgeleitet von TView)
// Inspiriert von Borland Turbo Vision

unit std.lyxvision.group;

import std.lyxvision.types;
import std.lyxvision.consts;
import std.lyxvision.view;
import std.lyxvision.drivers;

// ============================================================================
// TGroup - Container für Views (erweitert TView mit Vererbung)
// ============================================================================

pub type TGroup = class extends TView {
  firstChild: TView;   // erstes Kind in der linked list
  lastChild:  TView;   // letztes Kind (für O(1) append)
  current:    TView;   // aktuell fokussiertes Kind
  buffer:     int64;
  bufferSize: int64;
  focusChain: TView;   // Anker der Fokus-Kette

  fn Init(gx: int64, gy: int64, gw: int64, gh: int64) {
    self.originX   := gx;
    self.originY   := gy;
    self.sizeX     := gw;
    self.sizeY     := gh;
    self.cursorX   := 0;
    self.cursorY   := 0;
    self.growMode  := gfFixed;
    self.dragMode  := dmLimitAll;
    self.helpCtx   := hcNoContext;
    self.state     := sfVisible;
    self.options   := ofSelectable | ofBuffered;
    self.ownerPtr  := 0;
    self.nextPtr   := 0;
    self.viewType  := vtGroup;
    self.dirtyLevel   := dfClean;
    self.parentDirty  := dfClean;

    self.firstChild := 0;
    self.lastChild  := 0;
    self.current    := 0;
    self.buffer     := 0;
    self.bufferSize := gw * gh;
    self.focusChain := 0;
  }

  override fn Draw() {
    if (!FlagSet(self.state, sfVisible)) {
      return;
    }
    SetColors(colorLightGray, colorBlue);
    var gox: int64 := self.originX;
    var goy: int64 := self.originY;
    var gsx: int64 := self.sizeX;
    var gsy: int64 := self.sizeY;
    var gsx1: int64 := gsx - 1;
    var gsy1: int64 := gsy - 1;
    var gx2: int64 := gox + gsx1;
    var gy2: int64 := goy + gsy1;
    FillRect(gox, goy, gx2, gy2);

    var child: TView := self.firstChild;
    while (child != 0) {
      child.Draw();
      child := child.nextPtr;
    }
    self.dirtyLevel := dfClean;
  }
};

// ============================================================================
// TGroup Funktionen
// ============================================================================

pub fn GroupNew(x: int64, y: int64, w: int64, h: int64): TGroup {
  var g: TGroup := new TGroup();
  g.Init(x, y, w, h);
  return g;
}

// Hängt v ans Ende der Kind-Liste von g
pub fn GroupInsert(g: TGroup, v: TView): TGroup {
  v.nextPtr  := 0;
  v.ownerPtr := 0;

  if (g.firstChild == 0) {
    g.firstChild := v;
    g.lastChild  := v;
  } else {
    g.lastChild.nextPtr := v;
    g.lastChild := v;
  }

  // Erstes selektierbares Kind wird zum aktuellen Fokus
  if (g.current == 0) {
    if (FlagSet(v.options, ofSelectable)) {
      g.current := v;
    }
  }

  g.dirtyLevel := dfChildren;
  return g;
}

pub fn GroupRemove(g: TGroup, v: TView): TGroup {
  if (g.firstChild == 0) {
    return g;
  }

  // Erstes Element entfernen
  if (g.firstChild == v) {
    g.firstChild := v.nextPtr;
    if (g.lastChild == v) {
      g.lastChild := 0;
    }
    v.nextPtr  := 0;
    v.ownerPtr := 0;
    if (g.current == v) {
      g.current := g.firstChild;
    }
    g.dirtyLevel := dfChildren;
    return g;
  }

  // Mittendrin suchen
  var prev: TView := g.firstChild;
  while (prev.nextPtr != 0) {
    if (prev.nextPtr == v) {
      prev.nextPtr := v.nextPtr;
      if (g.lastChild == v) {
        g.lastChild := prev;
      }
      v.nextPtr  := 0;
      v.ownerPtr := 0;
      if (g.current == v) {
        g.current := g.firstChild;
      }
      g.dirtyLevel := dfChildren;
      return g;
    }
    prev := prev.nextPtr;
  }
  return g;
}

pub fn GroupDraw(g: TGroup): TGroup {
  if (!FlagSet(g.state, sfVisible)) {
    return g;
  }
  SetColors(colorLightGray, colorBlue);
  var gox: int64 := g.originX;
  var goy: int64 := g.originY;
  var gsx: int64 := g.sizeX;
  var gsy: int64 := g.sizeY;
  var gsx1: int64 := gsx - 1;
  var gsy1: int64 := gsy - 1;
  var gx2: int64 := gox + gsx1;
  var gy2: int64 := goy + gsy1;
  FillRect(gox, goy, gx2, gy2);

  var child: TView := g.firstChild;
  while (child != 0) {
    child.Draw();
    child := child.nextPtr;
  }

  g.dirtyLevel := dfClean;
  return g;
}

pub fn GroupAddToFocusChain(g: TGroup, v: TView): TGroup {
  g.focusChain := v;
  return g;
}

// Setzt Fokus auf das nächste selektierbare Kind (Tab)
pub fn GroupNext(g: TGroup): TGroup {
  if (g.firstChild == 0) {
    return g;
  }

  var start: TView;
  if (g.current == 0) {
    start := g.firstChild;
  } else {
    start := g.current.nextPtr;
  }

  // Vorwärts suchen ab start
  var c: TView := start;
  while (c != 0) {
    if (FlagSet(c.options, ofSelectable)) {
      g.current := c;
      g.dirtyLevel := dfVisual;
      return g;
    }
    c := c.nextPtr;
  }

  // Wrap-around: von vorne suchen
  c := g.firstChild;
  while (c != 0) {
    if (FlagSet(c.options, ofSelectable)) {
      g.current := c;
      g.dirtyLevel := dfVisual;
      return g;
    }
    c := c.nextPtr;
  }
  return g;
}

// Setzt Fokus auf das vorherige selektierbare Kind (Shift-Tab)
pub fn GroupPrev(g: TGroup): TGroup {
  if (g.firstChild == 0) {
    return g;
  }

  // Letztes selektierbares vor current suchen
  var found: TView := 0 as TView;   // #1238: Nullzeiger, kein int64
  var c: TView := g.firstChild;
  while (c != 0) {
    if (c == g.current) {
      if (found != 0) {
        g.current := found;
        g.dirtyLevel := dfVisual;
        return g;
      }
      // current ist erstes selektierbares → wrap zum letzten
      var last: TView := 0 as TView;   // #1238: Nullzeiger, kein int64
      var d: TView := g.firstChild;
      while (d != 0) {
        if (FlagSet(d.options, ofSelectable)) {
          last := d;
        }
        d := d.nextPtr;
      }
      if (last != 0) {
        g.current := last;
        g.dirtyLevel := dfVisual;
      }
      return g;
    }
    if (FlagSet(c.options, ofSelectable)) {
      found := c;
    }
    c := c.nextPtr;
  }
  return g;
}

pub fn GroupSetCurrent(g: TGroup, v: TView): TGroup {
  g.current := v;
  g.dirtyLevel := dfVisual;
  return g;
}

pub fn GroupGetCurrent(g: TGroup): TView {
  return g.current;
}

pub fn GroupExecute(g: TGroup): int64 {
  var running: int64 := 1;
  var result: int64 := cmValid;

  while (running == 1) {
    var key: int64 := ReadKeyRaw();
    if (key == 27) {
      running := 0;
      result  := cmCancel;
    }
    if (key == 9) {
      GroupNext(g);
      GroupDraw(g);
    }
    if (key == 353) {
      GroupPrev(g);
      GroupDraw(g);
    }
  }
  return result;
}

pub fn GroupSetState(g: TGroup, aState: int64, enable: int64): TGroup {
  g.dirtyLevel := dfVisual;
  return g;
}

pub fn GroupClear(g: TGroup): TGroup {
  g.firstChild := 0;
  g.lastChild  := 0;
  g.current    := 0;
  g.focusChain := 0;
  g.dirtyLevel := dfChildren;
  return g;
}

pub fn GroupIsEmpty(g: TGroup): bool {
  return g.firstChild == 0;
}

// End of std/lyxvision/group.lyx
