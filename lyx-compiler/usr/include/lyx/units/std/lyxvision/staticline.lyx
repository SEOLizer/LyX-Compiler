// std/lyxvision/staticline.lyx
// LyxVision - TStaticLine: Horizontale/Vertikale Linie
// Inspiriert von Borland Turbo Vision

unit std.lyxvision.staticline;

import std.lyxvision.types;
import std.lyxvision.consts;
import std.lyxvision.view;
import std.lyxvision.drivers;

// ============================================================================
// Linien-Typen und Stile
// ============================================================================

pub con slHorizontal: int64 := 0;
pub con slVertical:   int64 := 1;

pub con slSingle: int64 := 0;
pub con slDouble: int64 := 1;
pub con slBlock:  int64 := 2;

// Zeichen-Codes (CP437)
pub con slCharHorizSingle: int64 := 196;
pub con slCharHorizDouble: int64 := 205;
pub con slCharHorizBlock:  int64 := 223;
pub con slCharVertSingle:  int64 := 179;
pub con slCharVertDouble:  int64 := 186;
pub con slCharVertBlock:   int64 := 219;

// ============================================================================
// TStaticLine - Horizontale oder Vertikale Linie
// ============================================================================

pub type TStaticLine = class extends TView {
  lineType:  int64;
  lineStyle: int64;

  fn Init(x: int64, y: int64, sx: int64, sy: int64, ltype: int64, lstyle: int64) {
    self.originX     := x;
    self.originY     := y;
    self.sizeX       := sx;
    self.sizeY       := sy;
    self.cursorX     := 0;
    self.cursorY     := 0;
    self.growMode    := gfFixed;
    self.dragMode    := dmLimitAll;
    self.helpCtx     := hcNoContext;
    self.state       := sfVisible;
    self.options     := 0;
    self.ownerPtr    := 0;
    self.nextPtr     := 0;
    self.viewType    := vtStaticLine;
    self.dirtyLevel  := dfClean;
    self.parentDirty := dfClean;
    self.lineType    := ltype;
    self.lineStyle   := lstyle;
  }

  override fn Draw() {
    if (!FlagSet(self.state, sfVisible)) {
      return;
    }
    var ch: int64;
    if (self.lineType == slHorizontal) {
      if (self.lineStyle == slDouble) {
        ch := slCharHorizDouble;
      } else if (self.lineStyle == slBlock) {
        ch := slCharHorizBlock;
      } else {
        ch := slCharHorizSingle;
      }
      var i: int64 := 0;
      while (i < self.sizeX) {
        var px: int64 := self.originX + i;
        MoveCursor(px, self.originY);
        PrintCh(ch);
        i := i + 1;
      }
    } else {
      if (self.lineStyle == slDouble) {
        ch := slCharVertDouble;
      } else if (self.lineStyle == slBlock) {
        ch := slCharVertBlock;
      } else {
        ch := slCharVertSingle;
      }
      var i: int64 := 0;
      while (i < self.sizeY) {
        var py: int64 := self.originY + i;
        MoveCursor(self.originX, py);
        PrintCh(ch);
        i := i + 1;
      }
    }
    self.dirtyLevel := dfClean;
  }
};

// ============================================================================
// TStaticLine Funktionen
// ============================================================================

pub fn StaticLineCreateH(x: int64, y: int64, length: int64): TStaticLine {
  var sl: TStaticLine := new TStaticLine();
  sl.Init(x, y, length, 1, slHorizontal, slSingle);
  sl.growMode := gfGrowLoX;
  sl.dragMode := dmLimitLoX;
  return sl;
}

pub fn StaticLineCreateV(x: int64, y: int64, length: int64): TStaticLine {
  var sl: TStaticLine := new TStaticLine();
  sl.Init(x, y, 1, length, slVertical, slSingle);
  sl.growMode := gfGrowLoY;
  sl.dragMode := dmLimitLoY;
  return sl;
}

pub fn StaticLineSetStyle(sl: TStaticLine, style: int64): TStaticLine {
  sl.lineStyle := style;
  return sl;
}

pub fn StaticLineDraw(sl: TStaticLine): TStaticLine {
  sl.Draw();
  return sl;
}

pub fn StaticLineDrawColor(sl: TStaticLine, fg: int64, bg: int64): TStaticLine {
  SetColors(fg, bg);
  sl.Draw();
  ResetColors();
  return sl;
}

// End of std/lyxvision/staticline.lyx
