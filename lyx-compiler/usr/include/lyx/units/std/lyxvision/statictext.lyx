// std/lyxvision/statictext.lyx
// LyxVision - TStaticText: Statischer Text
// Inspiriert von Borland Turbo Vision

unit std.lyxvision.statictext;

import std.lyxvision.types;
import std.lyxvision.consts;
import std.lyxvision.view;
import std.lyxvision.drivers;

// ============================================================================
// TStaticText - Statischer Text (nicht-editierbar)
// ============================================================================

pub type TStaticText = class extends TView {
  text:        pchar;
  centerAlign: int64;

  fn Init(x: int64, y: int64, w: int64, t: pchar) {
    self.originX     := x;
    self.originY     := y;
    self.sizeX       := w;
    self.sizeY       := 1;
    self.cursorX     := 0;
    self.cursorY     := 0;
    self.growMode    := gfFixed;
    self.dragMode    := dmLimitAll;
    self.helpCtx     := hcNoContext;
    self.state       := sfVisible;
    self.options     := 0;
    self.ownerPtr    := 0;
    self.nextPtr     := 0;
    self.viewType    := vtStaticText;
    self.dirtyLevel  := dfClean;
    self.parentDirty := dfClean;
    self.text        := t;
    self.centerAlign := 0;
  }

  override fn Draw() {
    if (!FlagSet(self.state, sfVisible)) {
      return;
    }
    var ox: int64 := self.originX;
    var oy: int64 := self.originY;
    MoveCursor(ox, oy);
    SetColors(colorLightGray, colorBlue);
    PrintStr(self.text);
    ResetColors();
    self.dirtyLevel := dfClean;
  }
};

// ============================================================================
// TStaticText Funktionen
// ============================================================================

pub fn StaticTextCreate(x: int64, y: int64, text: pchar): TStaticText {
  var st: TStaticText := new TStaticText();
  st.Init(x, y, 1, text);
  return st;
}

pub fn StaticTextNew(x: int64, y: int64, width: int64, text: pchar): TStaticText {
  var st: TStaticText := new TStaticText();
  st.Init(x, y, width, text);
  return st;
}

pub fn StaticTextSetText(st: TStaticText, text: pchar): TStaticText {
  st.text := text;
  st.dirtyLevel := dfVisual;
  return st;
}

pub fn StaticTextSetCenterAlign(st: TStaticText, center: int64): TStaticText {
  st.centerAlign := center;
  return st;
}

pub fn StaticTextDraw(st: TStaticText): TStaticText {
  st.Draw();
  return st;
}

pub fn StaticTextDrawColor(st: TStaticText, fg: int64, bg: int64): TStaticText {
  SetColors(fg, bg);
  st.Draw();
  ResetColors();
  return st;
}

// End of std/lyxvision/statictext.lyx
