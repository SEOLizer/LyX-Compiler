// std/io.lyx
// I/O utilities: Print/PrintLn wrappers, FloatToStr, BoolToStr, Printf helpers

@description("I/O utilities: Print/PrintLn, FloatToStr, Printf helpers")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
unit std.io;

import std.string;
import std.alloc;   // #1431: Schreibpuffer statt String-Literal

// Zeilenbrechende Varianten — PrintFloatLn/PrintBoolLn gibt es hier schon,
// PrintIntLn/PrintStrLn fehlten. sema registriert beide Namen zwar als Builtin,
// aber kein Backend implementiert sie: der Aufruf bestand sema und scheiterte
// erst im Codegen mit "no codegen implementation found".
pub fn PrintIntLn(n: int64): void {
  PrintInt(n);
  PrintLn("");
}

pub fn PrintStrLn(s: pchar): void {
  PrintStr(s);
  PrintLn("");
}

pub fn Print(s: pchar): void {
  PrintStr(s);
}

pub fn PrintFloatLn(x: f64): void {
  PrintFloat(x);
  PrintStr("\n");
}

pub fn PrintBoolLn(b: bool): void {
  if (b) { PrintStr("true"); } else { PrintStr("false"); }
  PrintStr("\n");
}

pub fn ExitProc(code: int64): void {
  exit(code);
}

pub fn BoolToStr(b: bool): pchar {
  if (b) { return "true"; }
  return "false";
}

// #1284: Sonderfaelle und Puffer.
//
// Zuvor lief jeder Wert durch `v as int64`. Fuer inf, NaN und Betraege ab 2^63
// liefert die Umwandlung den "integer indefinite"-Wert 0x8000000000000000 —
// daher die gemeldete 9223372036854775808 und, weil `frac` daraus NaN wird,
// der Nachkommateil aus Muell.
//
// Ausserdem stand als Zielpuffer ein String-LITERAL. Zwei Aufrufe hintereinander
// lieferten denselben Zeiger, und geschrieben wurde in den Literalbereich —
// dieselbe Klasse wie #1259 und #1260.
//
// NaN erkennt man daran, dass es sich selbst ungleich ist; unendlich daran,
// dass es ueber dem groessten endlichen f64 liegt.
// #1430: Schreibt den Nachkommateil mit FUEHRENDEN NULLEN auf prec Stellen.
// Ohne das wurde aus 5.02 die Ausgabe "5.2": der skalierte Bruchteil ist 2,
// und IntToStr(2) ist "2" — die Null davor ging verloren, und damit stand
// dort eine andere Zahl.
fn _ioFracAus(buf: pchar, pos: int64, fracScaled: int64, prec: int64): int64 {
  var p: int64 := pos;
  var s: pchar := IntToStr(fracScaled);
  var l: int64 := StrLen(s);
  var nullen: int64 := prec - l;
  while (nullen > 0) {
    StrSetChar(buf, p, 48);
    p := p + 1;
    nullen := nullen - 1;
  }
  var k: int64 := 0;
  while (k < l) {
    StrSetChar(buf, p, StrCharAt(s, k));
    p := p + 1;
    k := k + 1;
  }
  return p;
}

pub fn FloatToStr(val: f64, prec: int64): pchar {
  if (val != val) { return "nan"; }
  var maxFinite: f64 := 1.7976931348623157e308;
  if (val > maxFinite) { return "inf"; }
  if (val < 0.0 - maxFinite) { return "-inf"; }

  var neg: bool := false;
  var v: f64 := val;
  if (v < 0.0) { neg := true; v := 0.0 - v; }

  var buf: pchar := alloc(96) as pchar;
  var pos: int64 := 0;
  if (neg) { StrSetChar(buf, pos, 45); pos += 1; }

  // Ab 2^63 traegt kein int64 mehr den Vorkommateil. Statt still Falsches zu
  // liefern, wird der Wert normiert und mit Exponent ausgegeben.
  var grenze: f64 := 9.0e18;
  if (v >= grenze) {
    var exp: int64 := 0;
    while (v >= 10.0) { v := v / 10.0; exp := exp + 1; }
    var mi: int64 := v as int64;
    var mfrac: f64 := v - (mi as f64);
    var mscale: int64 := 1;
    var mj: int64 := 0;
    while (mj < prec) { mscale := mscale * 10; mj := mj + 1; }
    var mfs: int64 := ((mfrac * (mscale as f64)) + 0.5) as int64;   // #1430: runden
    if (mfs >= mscale) { mi := mi + 1; mfs := mfs - mscale; }
    var sm: pchar := IntToStr(mi);
    var k1: int64 := 0;
    while (k1 < StrLen(sm)) { StrSetChar(buf, pos, StrCharAt(sm, k1)); pos += 1; k1 += 1; }
    if (prec > 0) {
      StrSetChar(buf, pos, 46); pos += 1;
      pos := _ioFracAus(buf, pos, mfs, prec);   // #1430: mit fuehrenden Nullen
    }
    StrSetChar(buf, pos, 101); pos += 1;   // 'e'
    var se: pchar := IntToStr(exp);
    var k3: int64 := 0;
    while (k3 < StrLen(se)) { StrSetChar(buf, pos, StrCharAt(se, k3)); pos += 1; k3 += 1; }
    StrSetChar(buf, pos, 0);
    return buf;
  }

  var ip: int64 := v as int64;
  var ipf: f64 := ip as f64;
  var frac: f64 := v - ipf;
  var scale: int64 := 1;
  var si: int64 := 0;
  while (si < prec) { scale := scale * 10; si := si + 1; }
  var scaleF: f64 := scale as f64;
  var fracTmp: f64 := frac * scaleF;
  // #1430: Hier stand `fracTmp as int64` — abgeschnitten statt gerundet. 5.02
  // liegt als f64 knapp unter 5.02; mal 100 ergibt 1.999..., abgeschnitten 1,
  // ausgegeben "5.1". Gerundet wird daraus 2, und mit der fuehrenden Null
  // "5.02".
  var fracScaled: int64 := (fracTmp + 0.5) as int64;
  // Rundet der Bruchteil auf die naechste ganze Zahl auf (0.999 bei prec 2),
  // gehoert der Uebertrag in den Vorkommateil.
  if (fracScaled >= scale) {
    ip := ip + 1;
    fracScaled := fracScaled - scale;
  }

  var s_ip: pchar := IntToStr(ip);
  var ipLen: int64 := StrLen(s_ip);
  var ki: int64 := 0;
  while (ki < ipLen) {
    StrSetChar(buf, pos, StrCharAt(s_ip, ki));
    pos += 1;
    ki += 1;
  }

  // #1430: Bei prec <= 0 gibt es keinen Nachkommateil — vorher stand dort
  // trotzdem ein Punkt und eine 0.
  if (prec > 0) {
    StrSetChar(buf, pos, 46);
    pos += 1;
    pos := _ioFracAus(buf, pos, fracScaled, prec);
  }

  StrSetChar(buf, pos, 0);
  return buf;
}

// Core printf: up to 4 pre-formatted pchar arguments
//
// #1431: Hier stand `var chbuf: pchar := " ";` — ein String-LITERAL als
// Schreibpuffer, in das jedes auszugebende Zeichen geschrieben wurde. Dieselbe
// Klasse wie #1259 und #1260, und in derselben Datei schon einmal behoben
// (FloatToStr, #1284).
//
// Heute faellt es nicht auf: der Datenbereich ist beschreibbar, und das Zeichen
// wird sofort ausgegeben. Es faellt in dem Moment auf, in dem Literale in einen
// schreibgeschuetzten Abschnitt wandern — was zu W^X und RELRO passt, die der
// Compiler bereits setzt. Dann stuerzt JEDER Printf-Aufruf ab. Und schon
// vorher gilt: gleiche Literale werden zusammengefasst, ein Ein-Zeichen-Literal
// anderswo im Programm teilt sich denselben Speicher.
//
// Nicht mehr `pub`: der Doppelunterstrich sagt seit jeher, dass das hier
// niemand von aussen rufen soll — die Sichtbarkeit sagte das Gegenteil, und
// die erzeugte Doku fuehrte die Funktion als Teil der Schnittstelle. Keine
// Unit im Baum ruft sie.
fn __PrintfCore(fmt: pchar, a1: pchar, a2: pchar, a3: pchar, a4: pchar): int64 {
  var i: int64 := 0;
  var n: int64 := StrLen(fmt);
  var printed: int64 := 0;
  var chbuf: pchar := alloc(2) as pchar;
  StrSetChar(chbuf, 1, 0);
  var argIndex: int64 := 1;
  while (i < n) {
    var c: int64 := StrCharAt(fmt, i);
    if (c == 37) {
      i += 1;
      if (i < n) {
        var spec: int64 := StrCharAt(fmt, i);
        if (spec == 37) {
          StrSetChar(chbuf, 0, 37);
          PrintStr(chbuf);
          printed += 1;
        } else if (spec == 115) {
          var selIdx: int64 := argIndex;
          var arg: pchar := "";
          if (selIdx == 1) { arg := a1; }
          else if (selIdx == 2) { arg := a2; }
          else if (selIdx == 3) { arg := a3; }
          else if (selIdx == 4) { arg := a4; }
          argIndex += 1;
          if (arg != "") {
            PrintStr(arg);
            var argLen: int64 := StrLen(arg);
            printed += argLen;
          }
        } else if (spec == 100) {
          var selIdx: int64 := argIndex;
          var arg: pchar := "";
          if (selIdx == 1) { arg := a1; }
          else if (selIdx == 2) { arg := a2; }
          else if (selIdx == 3) { arg := a3; }
          else if (selIdx == 4) { arg := a4; }
          argIndex += 1;
          if (arg != "") {
            PrintStr(arg);
            var argLen: int64 := StrLen(arg);
            printed += argLen;
          }
        } else if (spec == 102) {
          var selIdx: int64 := argIndex;
          var arg: pchar := "";
          if (selIdx == 1) { arg := a1; }
          else if (selIdx == 2) { arg := a2; }
          else if (selIdx == 3) { arg := a3; }
          else if (selIdx == 4) { arg := a4; }
          argIndex += 1;
          if (arg != "") {
            PrintStr(arg);
            var argLen: int64 := StrLen(arg);
            printed += argLen;
          }
        } else {
          StrSetChar(chbuf, 0, 37);
          PrintStr(chbuf);
          StrSetChar(chbuf, 0, spec);
          PrintStr(chbuf);
          printed += 2;
        }
      }
    } else {
      StrSetChar(chbuf, 0, c);
      PrintStr(chbuf);
      printed += 1;
    }
    i += 1;
  }
  free(chbuf as int64, 2);   // #1431
  return printed;
}

// Printf wrappers with unique names for typed arguments

pub fn PrintfS(fmt: pchar, a1: pchar): int64 {
  return __PrintfCore(fmt, a1, "", "", "");
}

pub fn PrintfI(fmt: pchar, a1: int64): int64 {
  var s1: pchar := IntToStr(a1);
  return __PrintfCore(fmt, s1, "", "", "");
}

pub fn PrintfF(fmt: pchar, a1: f64): int64 {
  var s1: pchar := FloatToStr(a1, 6);
  return __PrintfCore(fmt, s1, "", "", "");
}

pub fn PrintfB(fmt: pchar, a1: bool): int64 {
  var s1: pchar := BoolToStr(a1);
  return __PrintfCore(fmt, s1, "", "", "");
}

pub fn PrintfSS(fmt: pchar, a1: pchar, a2: pchar): int64 {
  return __PrintfCore(fmt, a1, a2, "", "");
}

pub fn PrintfSI(fmt: pchar, a1: pchar, a2: int64): int64 {
  var s2: pchar := IntToStr(a2);
  return __PrintfCore(fmt, a1, s2, "", "");
}

pub fn PrintfIS(fmt: pchar, a1: int64, a2: pchar): int64 {
  var s1: pchar := IntToStr(a1);
  return __PrintfCore(fmt, s1, a2, "", "");
}

pub fn PrintfII(fmt: pchar, a1: int64, a2: int64): int64 {
  var s1: pchar := IntToStr(a1);
  var s2: pchar := IntToStr(a2);
  return __PrintfCore(fmt, s1, s2, "", "");
}

pub fn PrintfIF(fmt: pchar, a1: int64, a2: f64): int64 {
  var s1: pchar := IntToStr(a1);
  var s2: pchar := FloatToStr(a2, 6);
  return __PrintfCore(fmt, s1, s2, "", "");
}

pub fn PrintfFF(fmt: pchar, a1: f64, a2: f64): int64 {
  var s1: pchar := FloatToStr(a1, 6);
  var s2: pchar := FloatToStr(a2, 6);
  return __PrintfCore(fmt, s1, s2, "", "");
}

pub fn PrintfSSS(fmt: pchar, a1: pchar, a2: pchar, a3: pchar): int64 {
  return __PrintfCore(fmt, a1, a2, a3, "");
}

pub fn PrintfSIS(fmt: pchar, a1: pchar, a2: int64, a3: pchar): int64 {
  var s2: pchar := IntToStr(a2);
  return __PrintfCore(fmt, a1, s2, a3, "");
}

pub fn PrintfISI(fmt: pchar, a1: int64, a2: pchar, a3: int64): int64 {
  var s1: pchar := IntToStr(a1);
  var s3: pchar := IntToStr(a3);
  return __PrintfCore(fmt, s1, a2, s3, "");
}

pub fn PrintfIII(fmt: pchar, a1: int64, a2: int64, a3: int64): int64 {
  var s1: pchar := IntToStr(a1);
  var s2: pchar := IntToStr(a2);
  var s3: pchar := IntToStr(a3);
  return __PrintfCore(fmt, s1, s2, s3, "");
}

pub fn PrintfFFF(fmt: pchar, a1: f64, a2: f64, a3: f64): int64 {
  var s1: pchar := FloatToStr(a1, 6);
  var s2: pchar := FloatToStr(a2, 6);
  var s3: pchar := FloatToStr(a3, 6);
  return __PrintfCore(fmt, s1, s2, s3, "");
}

pub fn PrintfSSSS(fmt: pchar, a1: pchar, a2: pchar, a3: pchar, a4: pchar): int64 {
  return __PrintfCore(fmt, a1, a2, a3, a4);
}

pub fn PrintfIIII(fmt: pchar, a1: int64, a2: int64, a3: int64, a4: int64): int64 {
  var s1: pchar := IntToStr(a1);
  var s2: pchar := IntToStr(a2);
  var s3: pchar := IntToStr(a3);
  var s4: pchar := IntToStr(a4);
  return __PrintfCore(fmt, s1, s2, s3, s4);
}

pub fn PrintfISIF(fmt: pchar, a1: int64, a2: pchar, a3: int64, a4: f64): int64 {
  var s1: pchar := IntToStr(a1);
  var s3: pchar := IntToStr(a3);
  var s4: pchar := FloatToStr(a4, 6);
  return __PrintfCore(fmt, s1, a2, s3, s4);
}

