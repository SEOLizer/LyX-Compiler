// std/hl7/adt.lyx — HL7 v2 ADT: Patientenadministration (WP-HL7-01)
//
// Public API:
//   Hl7PidParse(seg, segLen, pid)           — PID segment → struct
//   Hl7Pv1Parse(seg, segLen, pv1)           — PV1 segment → struct
//   Hl7MrgParse(seg, segLen, mrg)           — MRG segment → struct
//   Hl7Nk1Parse(seg, segLen, nk1)           — NK1 segment → struct
//   Hl7AdtParse(msg, len, adt)              — full message → ADT struct
//   Hl7AdtWrite(adt, event, out, outMax)    → int64 (bytes written)
//   Hl7AdtIsMerge(eventPtr, eventLen)       → int64 (1=merge 0=not)

unit std.hl7.adt;

import std.hl7.core;
import std.alloc;

// ── PID struct offsets ────────────────────────────────────────────────────────
pub con HL7_PID_ID1:      int64 := 0;    // PID-3 first ID
pub con HL7_PID_ID1_LEN:  int64 := 8;
pub con HL7_PID_ID2:      int64 := 16;   // PID-3 second ID (repeat ~)
pub con HL7_PID_ID2_LEN:  int64 := 24;
pub con HL7_PID_ID3:      int64 := 32;   // PID-3 third ID
pub con HL7_PID_ID3_LEN:  int64 := 40;
pub con HL7_PID_NAME:     int64 := 48;   // PID-5 full name field
pub con HL7_PID_NAME_LEN: int64 := 56;
pub con HL7_PID_FAMILY:   int64 := 64;   // PID-5.1 family name
pub con HL7_PID_FAMILY_LEN: int64 := 72;
pub con HL7_PID_GIVEN:    int64 := 80;   // PID-5.2 given name
pub con HL7_PID_GIVEN_LEN: int64 := 88;
pub con HL7_PID_BIRTH:    int64 := 96;   // PID-7 birth date
pub con HL7_PID_BIRTH_LEN: int64 := 104;
pub con HL7_PID_SEX:      int64 := 112;  // PID-8 sex (M/F/U)
pub con HL7_PID_SEX_LEN:  int64 := 120;
pub con HL7_PID_ADDR:     int64 := 128;  // PID-11 address
pub con HL7_PID_ADDR_LEN: int64 := 136;
pub con HL7_PID_PHONE:    int64 := 144;  // PID-13 home phone
pub con HL7_PID_PHONE_LEN: int64 := 152;
pub con HL7_PID_INSID:    int64 := 160;  // PID-19 insurance/SSN
pub con HL7_PID_INSID_LEN: int64 := 168;
pub con HL7_PID_SIZE:     int64 := 176;

// ── PV1 struct offsets ────────────────────────────────────────────────────────
pub con HL7_PV1_VISIT:    int64 := 0;    // PV1-19 visit number
pub con HL7_PV1_VISIT_LEN: int64 := 8;
pub con HL7_PV1_CLASS:    int64 := 16;   // PV1-2 patient class (I/O/E)
pub con HL7_PV1_CLASS_LEN: int64 := 24;
pub con HL7_PV1_LOC:      int64 := 32;   // PV1-3 full location
pub con HL7_PV1_LOC_LEN:  int64 := 40;
pub con HL7_PV1_LPOINT:   int64 := 48;   // PV1-3.1 point of care
pub con HL7_PV1_LPOINT_LEN: int64 := 56;
pub con HL7_PV1_LROOM:    int64 := 64;   // PV1-3.2 room
pub con HL7_PV1_LROOM_LEN: int64 := 72;
pub con HL7_PV1_LBED:     int64 := 80;   // PV1-3.3 bed
pub con HL7_PV1_LBED_LEN: int64 := 88;
pub con HL7_PV1_LFAC:     int64 := 96;   // PV1-3.4 facility
pub con HL7_PV1_LFAC_LEN: int64 := 104;
pub con HL7_PV1_ATTDOC:   int64 := 112;  // PV1-7 attending doctor
pub con HL7_PV1_ATTDOC_LEN: int64 := 120;
pub con HL7_PV1_ADMIT:    int64 := 128;  // PV1-44 admit date/time
pub con HL7_PV1_ADMIT_LEN: int64 := 136;
pub con HL7_PV1_DISCH:    int64 := 144;  // PV1-45 discharge date/time
pub con HL7_PV1_DISCH_LEN: int64 := 152;
pub con HL7_PV1_SIZE:     int64 := 160;

// ── MRG struct offsets ────────────────────────────────────────────────────────
pub con HL7_MRG_PID:      int64 := 0;    // MRG-1 prior patient ID
pub con HL7_MRG_PID_LEN:  int64 := 8;
pub con HL7_MRG_ACCT:     int64 := 16;   // MRG-3 prior account number
pub con HL7_MRG_ACCT_LEN: int64 := 24;
pub con HL7_MRG_VISIT:    int64 := 32;   // MRG-5 prior visit number
pub con HL7_MRG_VISIT_LEN: int64 := 40;
pub con HL7_MRG_SIZE:     int64 := 48;

// ── NK1 struct offsets ────────────────────────────────────────────────────────
pub con HL7_NK1_NAME:     int64 := 0;    // NK1-2 contact name
pub con HL7_NK1_NAME_LEN: int64 := 8;
pub con HL7_NK1_REL:      int64 := 16;   // NK1-3 relationship
pub con HL7_NK1_REL_LEN:  int64 := 24;
pub con HL7_NK1_PHONE:    int64 := 32;   // NK1-5 phone
pub con HL7_NK1_PHONE_LEN: int64 := 40;
pub con HL7_NK1_SIZE:     int64 := 48;

// ── ADT struct offsets ────────────────────────────────────────────────────────
pub con HL7_ADT_EVENT:    int64 := 0;    // trigger event e.g. "A01"
pub con HL7_ADT_EVENT_LEN: int64 := 8;
pub con HL7_ADT_ISMERGE:  int64 := 16;  // 1=merge event
pub con HL7_ADT_HASMRG:   int64 := 24;  // 1=MRG segment present
pub con HL7_ADT_SEND_APP: int64 := 32;
pub con HL7_ADT_SEND_APP_LEN: int64 := 40;
pub con HL7_ADT_SEND_FAC: int64 := 48;
pub con HL7_ADT_SEND_FAC_LEN: int64 := 56;
pub con HL7_ADT_RECV_APP: int64 := 64;
pub con HL7_ADT_RECV_APP_LEN: int64 := 72;
pub con HL7_ADT_RECV_FAC: int64 := 80;
pub con HL7_ADT_RECV_FAC_LEN: int64 := 88;
pub con HL7_ADT_CTRL_ID:  int64 := 96;
pub con HL7_ADT_CTRL_ID_LEN: int64 := 104;
pub con HL7_ADT_PID:      int64 := 112; // embedded PID (176 bytes)
pub con HL7_ADT_PV1:      int64 := 288; // embedded PV1 (160 bytes)
pub con HL7_ADT_MRG:      int64 := 448; // embedded MRG (48 bytes)
pub con HL7_ADT_NK1:      int64 := 496; // embedded NK1 (48 bytes)
pub con HL7_ADT_SIZE:     int64 := 544;

// ── Private helpers ──────────────────────────────────────────────────────────

fn adtStrLen(s: int64): int64 {
    var n: int64 := 0;
    while (peek8(s + n) != 0) { n := n + 1; }
    return n;
}

fn adtCopy(dst: int64, src: int64, count: int64) {
    var i: int64 := 0;
    while (i < count) { poke8(dst + i, peek8(src + i)); i := i + 1; }
}

// Get Nth pipe-separated field (1-based) from HL7 segment.
fn adtFieldGet(seg: int64, segLen: int64, sep: int64, fieldNum: int64, outPtr: int64, outLen: int64) {
    var pos:  int64 := 0;
    var fnum: int64 := 0;
    while (pos < segLen && peek8(seg + pos) != sep) { pos := pos + 1; }
    while (pos < segLen && fnum < fieldNum) {
        pos += 1;
        fnum += 1;
        if (fnum == fieldNum) {
            var start: int64 := pos;
            while (pos < segLen && peek8(seg + pos) != sep && peek8(seg + pos) != 13 && peek8(seg + pos) != 10) {
                pos += 1;
            }
            poke64(outPtr, seg + start);
            poke64(outLen, pos - start);
            return;
        }
        while (pos < segLen && peek8(seg + pos) != sep && peek8(seg + pos) != 13) {
            pos += 1;
        }
    }
    poke64(outPtr, 0);
    poke64(outLen, 0);
}

// Get Nth component (1-based) from a field value.
fn adtCompGet(fldPtr: int64, fldLen: int64, csep: int64, compNum: int64, outPtr: int64, outLen: int64) {
    var pos:   int64 := 0;
    var cnum:  int64 := 1;
    var start: int64 := 0;
    while (cnum < compNum && pos < fldLen) {
        if (peek8(fldPtr + pos) == csep) { cnum := cnum + 1; start := pos + 1; }
        pos += 1;
    }
    var end: int64 := start;
    while (end < fldLen && peek8(fldPtr + end) != csep) { end := end + 1; }
    poke64(outPtr, fldPtr + start);
    poke64(outLen, end - start);
}

// Get Nth repeat (1-based) split by rsep.
fn adtRepeat(fldPtr: int64, fldLen: int64, rsep: int64, repNum: int64, outPtr: int64, outLen: int64) {
    var pos:   int64 := 0;
    var rnum:  int64 := 1;
    var start: int64 := 0;
    while (rnum < repNum && pos < fldLen) {
        if (peek8(fldPtr + pos) == rsep) { rnum := rnum + 1; start := pos + 1; }
        pos += 1;
    }
    var end: int64 := start;
    while (end < fldLen && peek8(fldPtr + end) != rsep) { end := end + 1; }
    poke64(outPtr, fldPtr + start);
    poke64(outLen, end - start);
}

// Find segment by 3-char name. Returns ptr to segment start or 0 if not found.
fn adtFindSeg(msg: int64, len: int64, n1: int64, n2: int64, n3: int64, fsep: int64): int64 {
    if (len >= 4 && peek8(msg)==n1 && peek8(msg+1)==n2 && peek8(msg+2)==n3 && peek8(msg+3)==fsep) {
        return msg;
    }
    var i: int64 := 0;
    while (i < len - 4) {
        if (peek8(msg + i) == 13) {
            if (peek8(msg+i+1)==n1 && peek8(msg+i+2)==n2 && peek8(msg+i+3)==n3 && peek8(msg+i+4)==fsep) {
                return msg + i + 1;
            }
        }
        i += 1;
    }
    return 0;
}

// Return length of segment starting at segStart (until next CR or end of msg).
fn adtSegLen(msgStart: int64, msgLen: int64, segStart: int64): int64 {
    var offset: int64 := segStart - msgStart;
    var pos:    int64 := offset;
    while (pos < msgLen && peek8(msgStart + pos) != 13 && peek8(msgStart + pos) != 10) {
        pos += 1;
    }
    return pos - offset;
}

fn adtWriteByte(out: int64, pos: int64, b: int64): int64 {
    poke8(out + pos, b);
    return pos + 1;
}

fn adtWriteField(out: int64, pos: int64, ptr: int64, len: int64): int64 {
    adtCopy(out + pos, ptr, len);
    return pos + len;
}

// ── Public API ────────────────────────────────────────────────────────────────

// Parse PID segment into pid struct.
pub fn Hl7PidParse(seg: int64, segLen: int64, pid: int64) {
    var fsep: int64 := 124;
    var csep: int64 := 94;
    var rsep: int64 := 126;
    var fptr: int64 := alloc(16);
    var flen: int64 := alloc(16);
    var cptr: int64 := alloc(16);
    var clen: int64 := alloc(16);
    // PID-3: Patient Identifier List (may repeat with ~)
    adtFieldGet(seg, segLen, fsep, 3, fptr, flen);
    var f3ptr: int64 := peek64(fptr);
    var f3len: int64 := peek64(flen);
    var rptr: int64 := alloc(16);
    var rlen: int64 := alloc(16);
    adtRepeat(f3ptr, f3len, rsep, 1, rptr, rlen);
    adtCompGet(peek64(rptr), peek64(rlen), csep, 1, cptr, clen);
    poke64(pid + HL7_PID_ID1, peek64(cptr));
    poke64(pid + HL7_PID_ID1_LEN, peek64(clen));
    adtRepeat(f3ptr, f3len, rsep, 2, rptr, rlen);
    adtCompGet(peek64(rptr), peek64(rlen), csep, 1, cptr, clen);
    poke64(pid + HL7_PID_ID2, peek64(cptr));
    poke64(pid + HL7_PID_ID2_LEN, peek64(clen));
    adtRepeat(f3ptr, f3len, rsep, 3, rptr, rlen);
    adtCompGet(peek64(rptr), peek64(rlen), csep, 1, cptr, clen);
    poke64(pid + HL7_PID_ID3, peek64(cptr));
    poke64(pid + HL7_PID_ID3_LEN, peek64(clen));
    // PID-5: Patient Name
    adtFieldGet(seg, segLen, fsep, 5, fptr, flen);
    poke64(pid + HL7_PID_NAME, peek64(fptr));
    poke64(pid + HL7_PID_NAME_LEN, peek64(flen));
    adtCompGet(peek64(fptr), peek64(flen), csep, 1, cptr, clen);
    poke64(pid + HL7_PID_FAMILY, peek64(cptr));
    poke64(pid + HL7_PID_FAMILY_LEN, peek64(clen));
    adtCompGet(peek64(fptr), peek64(flen), csep, 2, cptr, clen);
    poke64(pid + HL7_PID_GIVEN, peek64(cptr));
    poke64(pid + HL7_PID_GIVEN_LEN, peek64(clen));
    // PID-7: Birth Date
    adtFieldGet(seg, segLen, fsep, 7, fptr, flen);
    poke64(pid + HL7_PID_BIRTH, peek64(fptr));
    poke64(pid + HL7_PID_BIRTH_LEN, peek64(flen));
    // PID-8: Sex
    adtFieldGet(seg, segLen, fsep, 8, fptr, flen);
    poke64(pid + HL7_PID_SEX, peek64(fptr));
    poke64(pid + HL7_PID_SEX_LEN, peek64(flen));
    // PID-11: Address
    adtFieldGet(seg, segLen, fsep, 11, fptr, flen);
    poke64(pid + HL7_PID_ADDR, peek64(fptr));
    poke64(pid + HL7_PID_ADDR_LEN, peek64(flen));
    // PID-13: Home Phone
    adtFieldGet(seg, segLen, fsep, 13, fptr, flen);
    poke64(pid + HL7_PID_PHONE, peek64(fptr));
    poke64(pid + HL7_PID_PHONE_LEN, peek64(flen));
    // PID-19: Insurance / SSN
    adtFieldGet(seg, segLen, fsep, 19, fptr, flen);
    poke64(pid + HL7_PID_INSID, peek64(fptr));
    poke64(pid + HL7_PID_INSID_LEN, peek64(flen));
}

// Parse PV1 segment into pv1 struct.
pub fn Hl7Pv1Parse(seg: int64, segLen: int64, pv1: int64) {
    var fsep: int64 := 124;
    var csep: int64 := 94;
    var fptr: int64 := alloc(16);
    var flen: int64 := alloc(16);
    var cptr: int64 := alloc(16);
    var clen: int64 := alloc(16);
    // PV1-2: Patient Class
    adtFieldGet(seg, segLen, fsep, 2, fptr, flen);
    poke64(pv1 + HL7_PV1_CLASS, peek64(fptr));
    poke64(pv1 + HL7_PV1_CLASS_LEN, peek64(flen));
    // PV1-3: Assigned Patient Location
    adtFieldGet(seg, segLen, fsep, 3, fptr, flen);
    poke64(pv1 + HL7_PV1_LOC, peek64(fptr));
    poke64(pv1 + HL7_PV1_LOC_LEN, peek64(flen));
    adtCompGet(peek64(fptr), peek64(flen), csep, 1, cptr, clen);
    poke64(pv1 + HL7_PV1_LPOINT, peek64(cptr));
    poke64(pv1 + HL7_PV1_LPOINT_LEN, peek64(clen));
    adtCompGet(peek64(fptr), peek64(flen), csep, 2, cptr, clen);
    poke64(pv1 + HL7_PV1_LROOM, peek64(cptr));
    poke64(pv1 + HL7_PV1_LROOM_LEN, peek64(clen));
    adtCompGet(peek64(fptr), peek64(flen), csep, 3, cptr, clen);
    poke64(pv1 + HL7_PV1_LBED, peek64(cptr));
    poke64(pv1 + HL7_PV1_LBED_LEN, peek64(clen));
    adtCompGet(peek64(fptr), peek64(flen), csep, 4, cptr, clen);
    poke64(pv1 + HL7_PV1_LFAC, peek64(cptr));
    poke64(pv1 + HL7_PV1_LFAC_LEN, peek64(clen));
    // PV1-7: Attending Doctor
    adtFieldGet(seg, segLen, fsep, 7, fptr, flen);
    poke64(pv1 + HL7_PV1_ATTDOC, peek64(fptr));
    poke64(pv1 + HL7_PV1_ATTDOC_LEN, peek64(flen));
    // PV1-19: Visit Number
    adtFieldGet(seg, segLen, fsep, 19, fptr, flen);
    poke64(pv1 + HL7_PV1_VISIT, peek64(fptr));
    poke64(pv1 + HL7_PV1_VISIT_LEN, peek64(flen));
    // PV1-44: Admit Date/Time
    adtFieldGet(seg, segLen, fsep, 44, fptr, flen);
    poke64(pv1 + HL7_PV1_ADMIT, peek64(fptr));
    poke64(pv1 + HL7_PV1_ADMIT_LEN, peek64(flen));
    // PV1-45: Discharge Date/Time
    adtFieldGet(seg, segLen, fsep, 45, fptr, flen);
    poke64(pv1 + HL7_PV1_DISCH, peek64(fptr));
    poke64(pv1 + HL7_PV1_DISCH_LEN, peek64(flen));
}

// Parse MRG segment into mrg struct.
pub fn Hl7MrgParse(seg: int64, segLen: int64, mrg: int64) {
    var fsep: int64 := 124;
    var csep: int64 := 94;
    var fptr: int64 := alloc(16);
    var flen: int64 := alloc(16);
    var cptr: int64 := alloc(16);
    var clen: int64 := alloc(16);
    // MRG-1: Prior Patient ID
    adtFieldGet(seg, segLen, fsep, 1, fptr, flen);
    adtCompGet(peek64(fptr), peek64(flen), csep, 1, cptr, clen);
    poke64(mrg + HL7_MRG_PID, peek64(cptr));
    poke64(mrg + HL7_MRG_PID_LEN, peek64(clen));
    // MRG-3: Prior Account Number
    adtFieldGet(seg, segLen, fsep, 3, fptr, flen);
    poke64(mrg + HL7_MRG_ACCT, peek64(fptr));
    poke64(mrg + HL7_MRG_ACCT_LEN, peek64(flen));
    // MRG-5: Prior Visit Number
    adtFieldGet(seg, segLen, fsep, 5, fptr, flen);
    poke64(mrg + HL7_MRG_VISIT, peek64(fptr));
    poke64(mrg + HL7_MRG_VISIT_LEN, peek64(flen));
}

// Parse NK1 segment into nk1 struct.
pub fn Hl7Nk1Parse(seg: int64, segLen: int64, nk1: int64) {
    var fsep: int64 := 124;
    var fptr: int64 := alloc(16);
    var flen: int64 := alloc(16);
    // NK1-2: Contact Name
    adtFieldGet(seg, segLen, fsep, 2, fptr, flen);
    poke64(nk1 + HL7_NK1_NAME, peek64(fptr));
    poke64(nk1 + HL7_NK1_NAME_LEN, peek64(flen));
    // NK1-3: Relationship
    adtFieldGet(seg, segLen, fsep, 3, fptr, flen);
    poke64(nk1 + HL7_NK1_REL, peek64(fptr));
    poke64(nk1 + HL7_NK1_REL_LEN, peek64(flen));
    // NK1-5: Phone
    adtFieldGet(seg, segLen, fsep, 5, fptr, flen);
    poke64(nk1 + HL7_NK1_PHONE, peek64(fptr));
    poke64(nk1 + HL7_NK1_PHONE_LEN, peek64(flen));
}

// Returns 1 if event code indicates a patient merge operation.
// Merge events: A34, A35, A36, A39, A40, A41, A42, A43, A44, A45
pub fn Hl7AdtIsMerge(eventPtr: int64, eventLen: int64): int64 {
    if (eventLen < 3) { return 0; }
    if (peek8(eventPtr) != 65) { return 0; }  // 'A'
    var d1: int64 := peek8(eventPtr + 1) as int64;
    var d2: int64 := peek8(eventPtr + 2) as int64;
    if (d1 == 51) {  // '3': A34, A35, A36, A39
        if (d2 == 52 || d2 == 53 || d2 == 54 || d2 == 57) { return 1; }
    }
    if (d1 == 52) {  // '4': A40, A41, A42, A43, A44, A45
        if (d2 >= 48 && d2 <= 53) { return 1; }
    }
    return 0;
}

// Parse full ADT message into adt struct.
// Parses MSH (event, sender/receiver), PID, PV1, and optionally MRG, NK1.
pub fn Hl7AdtParse(msg: int64, len: int64, adt: int64) {
    var mshBuf: int64 := alloc(HL7_MSH_SIZE);
    Hl7MshParse(msg, len, mshBuf);
    // Copy sender/receiver from MSH
    poke64(adt + HL7_ADT_SEND_APP, peek64(mshBuf + HL7_MSH_SEND_APP));
    poke64(adt + HL7_ADT_SEND_APP_LEN, peek64(mshBuf + HL7_MSH_SEND_APP_LEN));
    poke64(adt + HL7_ADT_SEND_FAC, peek64(mshBuf + HL7_MSH_SEND_FAC));
    poke64(adt + HL7_ADT_SEND_FAC_LEN, peek64(mshBuf + HL7_MSH_SEND_FAC_LEN));
    poke64(adt + HL7_ADT_RECV_APP, peek64(mshBuf + HL7_MSH_RECV_APP));
    poke64(adt + HL7_ADT_RECV_APP_LEN, peek64(mshBuf + HL7_MSH_RECV_APP_LEN));
    poke64(adt + HL7_ADT_RECV_FAC, peek64(mshBuf + HL7_MSH_RECV_FAC));
    poke64(adt + HL7_ADT_RECV_FAC_LEN, peek64(mshBuf + HL7_MSH_RECV_FAC_LEN));
    poke64(adt + HL7_ADT_CTRL_ID, peek64(mshBuf + HL7_MSH_CTRL_ID));
    poke64(adt + HL7_ADT_CTRL_ID_LEN, peek64(mshBuf + HL7_MSH_CTRL_ID_LEN));
    // Trigger event
    poke64(adt + HL7_ADT_EVENT, peek64(mshBuf + HL7_MSH_TRIGGER));
    poke64(adt + HL7_ADT_EVENT_LEN, peek64(mshBuf + HL7_MSH_TRIGGER_LEN));
    var evPtr: int64 := peek64(mshBuf + HL7_MSH_TRIGGER);
    var evLen: int64 := peek64(mshBuf + HL7_MSH_TRIGGER_LEN);
    poke64(adt + HL7_ADT_ISMERGE, Hl7AdtIsMerge(evPtr, evLen));
    // Find and parse PID segment
    var pidSeg: int64 := adtFindSeg(msg, len, 80, 73, 68, 124);  // P,I,D,|
    if (pidSeg != 0) {
        var pidLen: int64 := adtSegLen(msg, len, pidSeg);
        Hl7PidParse(pidSeg, pidLen, adt + HL7_ADT_PID);
    }
    // Find and parse PV1 segment
    var pv1Seg: int64 := adtFindSeg(msg, len, 80, 86, 49, 124);  // P,V,1,|
    if (pv1Seg != 0) {
        var pv1Len: int64 := adtSegLen(msg, len, pv1Seg);
        Hl7Pv1Parse(pv1Seg, pv1Len, adt + HL7_ADT_PV1);
    }
    // Find and parse MRG segment
    poke64(adt + HL7_ADT_HASMRG, 0);
    var mrgSeg: int64 := adtFindSeg(msg, len, 77, 82, 71, 124);  // M,R,G,|
    if (mrgSeg != 0) {
        poke64(adt + HL7_ADT_HASMRG, 1);
        var mrgLen: int64 := adtSegLen(msg, len, mrgSeg);
        Hl7MrgParse(mrgSeg, mrgLen, adt + HL7_ADT_MRG);
    }
    // Find and parse NK1 segment
    var nk1Seg: int64 := adtFindSeg(msg, len, 78, 75, 49, 124);  // N,K,1,|
    if (nk1Seg != 0) {
        var nk1Len: int64 := adtSegLen(msg, len, nk1Seg);
        Hl7Nk1Parse(nk1Seg, nk1Len, adt + HL7_ADT_NK1);
    }
}

// Write ADT message to out buffer. event is null-terminated pchar ("A01" etc.).
// Returns bytes written or -1 on overflow.
pub fn Hl7AdtWrite(adt: int64, event: pchar, out: int64, outMax: int64): int64 {
  var eventAdr: int64 := event as int64;   // #1613
    var pos: int64 := 0;
    var fsep: int64 := 124;  // '|'
    var csep: int64 := 94;   // '^'
    // MSH
    poke8(out+pos, 77); pos := pos + 1;  // M
    poke8(out+pos, 83); pos := pos + 1;  // S
    poke8(out+pos, 72); pos := pos + 1;  // H
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, csep); pos := pos + 1;
    poke8(out+pos, 126); pos := pos + 1; // ~
    poke8(out+pos, 92);  pos := pos + 1; // backslash
    poke8(out+pos, 38);  pos := pos + 1; // &
    poke8(out+pos, fsep); pos := pos + 1;
    // MSH-3: sending app
    var saPtr: int64 := peek64(adt + HL7_ADT_SEND_APP);
    var saLen: int64 := peek64(adt + HL7_ADT_SEND_APP_LEN);
    if (saLen > 0) { pos := adtWriteField(out, pos, saPtr, saLen); }
    poke8(out+pos, fsep); pos := pos + 1;
    // MSH-4: sending fac
    var sfPtr: int64 := peek64(adt + HL7_ADT_SEND_FAC);
    var sfLen: int64 := peek64(adt + HL7_ADT_SEND_FAC_LEN);
    if (sfLen > 0) { pos := adtWriteField(out, pos, sfPtr, sfLen); }
    poke8(out+pos, fsep); pos := pos + 1;
    // MSH-5: recv app
    var raPtr: int64 := peek64(adt + HL7_ADT_RECV_APP);
    var raLen: int64 := peek64(adt + HL7_ADT_RECV_APP_LEN);
    if (raLen > 0) { pos := adtWriteField(out, pos, raPtr, raLen); }
    poke8(out+pos, fsep); pos := pos + 1;
    // MSH-6: recv fac
    var rfPtr: int64 := peek64(adt + HL7_ADT_RECV_FAC);
    var rfLen: int64 := peek64(adt + HL7_ADT_RECV_FAC_LEN);
    if (rfLen > 0) { pos := adtWriteField(out, pos, rfPtr, rfLen); }
    poke8(out+pos, fsep); pos := pos + 1;
    // MSH-7: empty datetime
    poke8(out+pos, fsep); pos := pos + 1;
    // MSH-8: empty security
    poke8(out+pos, fsep); pos := pos + 1;
    // MSH-9: ADT^<event>
    poke8(out+pos, 65); pos := pos + 1;  // A
    poke8(out+pos, 68); pos := pos + 1;  // D
    poke8(out+pos, 84); pos := pos + 1;  // T
    poke8(out+pos, csep); pos := pos + 1;
    var evLen: int64 := adtStrLen(eventAdr);
    pos := adtWriteField(out, pos, eventAdr, evLen);
    poke8(out+pos, fsep); pos := pos + 1;
    // MSH-10: ctrl id
    var ciPtr: int64 := peek64(adt + HL7_ADT_CTRL_ID);
    var ciLen: int64 := peek64(adt + HL7_ADT_CTRL_ID_LEN);
    if (ciLen > 0) { pos := adtWriteField(out, pos, ciPtr, ciLen); }
    poke8(out+pos, fsep); pos := pos + 1;
    // MSH-11: P
    poke8(out+pos, 80); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    // MSH-12: 2.5.1
    poke8(out+pos, 50); pos := pos + 1;
    poke8(out+pos, 46); pos := pos + 1;
    poke8(out+pos, 53); pos := pos + 1;
    poke8(out+pos, 46); pos := pos + 1;
    poke8(out+pos, 49); pos := pos + 1;
    poke8(out+pos, 13); pos := pos + 1;  // CR
    // PID segment
    poke8(out+pos, 80); pos := pos + 1;  // P
    poke8(out+pos, 73); pos := pos + 1;  // I
    poke8(out+pos, 68); pos := pos + 1;  // D
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, 49); pos := pos + 1;  // "1"
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;  // PID-2 empty
    // PID-3: patient ID (first repeat)
    var id1Ptr: int64 := peek64(adt + HL7_ADT_PID + HL7_PID_ID1);
    var id1Len: int64 := peek64(adt + HL7_ADT_PID + HL7_PID_ID1_LEN);
    if (id1Len > 0) { pos := adtWriteField(out, pos, id1Ptr, id1Len); }
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;  // PID-4 empty
    // PID-5: name family^given
    var famPtr: int64 := peek64(adt + HL7_ADT_PID + HL7_PID_FAMILY);
    var famLen: int64 := peek64(adt + HL7_ADT_PID + HL7_PID_FAMILY_LEN);
    var givPtr: int64 := peek64(adt + HL7_ADT_PID + HL7_PID_GIVEN);
    var givLen: int64 := peek64(adt + HL7_ADT_PID + HL7_PID_GIVEN_LEN);
    if (famLen > 0) { pos := adtWriteField(out, pos, famPtr, famLen); }
    poke8(out+pos, csep); pos := pos + 1;
    if (givLen > 0) { pos := adtWriteField(out, pos, givPtr, givLen); }
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;  // PID-6 empty
    // PID-7: birth date
    var bdPtr: int64 := peek64(adt + HL7_ADT_PID + HL7_PID_BIRTH);
    var bdLen: int64 := peek64(adt + HL7_ADT_PID + HL7_PID_BIRTH_LEN);
    if (bdLen > 0) { pos := adtWriteField(out, pos, bdPtr, bdLen); }
    poke8(out+pos, fsep); pos := pos + 1;
    // PID-8: sex
    var sxPtr: int64 := peek64(adt + HL7_ADT_PID + HL7_PID_SEX);
    var sxLen: int64 := peek64(adt + HL7_ADT_PID + HL7_PID_SEX_LEN);
    if (sxLen > 0) { pos := adtWriteField(out, pos, sxPtr, sxLen); }
    poke8(out+pos, 13); pos := pos + 1;  // CR
    // PV1 segment
    poke8(out+pos, 80); pos := pos + 1;  // P
    poke8(out+pos, 86); pos := pos + 1;  // V
    poke8(out+pos, 49); pos := pos + 1;  // 1
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, 49); pos := pos + 1;  // "1"
    poke8(out+pos, fsep); pos := pos + 1;
    // PV1-2: class
    var clPtr: int64 := peek64(adt + HL7_ADT_PV1 + HL7_PV1_CLASS);
    var clLen: int64 := peek64(adt + HL7_ADT_PV1 + HL7_PV1_CLASS_LEN);
    if (clLen > 0) { pos := adtWriteField(out, pos, clPtr, clLen); }
    poke8(out+pos, fsep); pos := pos + 1;
    // PV1-3: location point^room^bed^fac
    var lpPtr: int64 := peek64(adt + HL7_ADT_PV1 + HL7_PV1_LPOINT);
    var lpLen: int64 := peek64(adt + HL7_ADT_PV1 + HL7_PV1_LPOINT_LEN);
    var lrPtr: int64 := peek64(adt + HL7_ADT_PV1 + HL7_PV1_LROOM);
    var lrLen: int64 := peek64(adt + HL7_ADT_PV1 + HL7_PV1_LROOM_LEN);
    var lbPtr: int64 := peek64(adt + HL7_ADT_PV1 + HL7_PV1_LBED);
    var lbLen: int64 := peek64(adt + HL7_ADT_PV1 + HL7_PV1_LBED_LEN);
    if (lpLen > 0) { pos := adtWriteField(out, pos, lpPtr, lpLen); }
    poke8(out+pos, csep); pos := pos + 1;
    if (lrLen > 0) { pos := adtWriteField(out, pos, lrPtr, lrLen); }
    poke8(out+pos, csep); pos := pos + 1;
    if (lbLen > 0) { pos := adtWriteField(out, pos, lbPtr, lbLen); }
    poke8(out+pos, 13); pos := pos + 1;  // CR
    // MRG segment (only for merge events)
    if (peek64(adt + HL7_ADT_HASMRG) == 1) {
        poke8(out+pos, 77); pos := pos + 1;  // M
        poke8(out+pos, 82); pos := pos + 1;  // R
        poke8(out+pos, 71); pos := pos + 1;  // G
        poke8(out+pos, fsep); pos := pos + 1;
        var mpPtr: int64 := peek64(adt + HL7_ADT_MRG + HL7_MRG_PID);
        var mpLen: int64 := peek64(adt + HL7_ADT_MRG + HL7_MRG_PID_LEN);
        if (mpLen > 0) { pos := adtWriteField(out, pos, mpPtr, mpLen); }
        poke8(out+pos, fsep); pos := pos + 1;
        poke8(out+pos, fsep); pos := pos + 1;
        var maPtr: int64 := peek64(adt + HL7_ADT_MRG + HL7_MRG_ACCT);
        var maLen: int64 := peek64(adt + HL7_ADT_MRG + HL7_MRG_ACCT_LEN);
        if (maLen > 0) { pos := adtWriteField(out, pos, maPtr, maLen); }
        poke8(out+pos, 13); pos := pos + 1;  // CR
    }
    return pos;
}
