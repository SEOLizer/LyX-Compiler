// String comparison helper
pub fn CountryStrEqual(s1: int64, s2: int64): int64 {
  var i: int64 := 0;
  var c1: int64;
  var c2: int64;
  
  if (s1 == 0 || s2 == 0) {
    return 0;
  }
  
  while (i < 50) {
    c1 := peek8(s1 + i);
    c2 := peek8(s2 + i);
    
    // Case-insensitive comparison
    if (c1 >= 97 && c1 <= 122) { c1 := c1 - 32; }
    if (c2 >= 97 && c2 <= 122) { c2 := c2 - 32; }
    
    if (c1 != c2) {
      return 0;
    }
    if (c1 == 0) {
      return 1;
    }
    i += 1;
  }
  
  return 1;
}

// Get country name by 2-letter code
// code: 2-letter ISO 3166-1 code
// Returns pointer to country name (static, no free needed), or "Unknown"
pub fn CountryGetName(code: pchar): pchar {   // #1221: liefert eine Zeichenkette
  var db: int64;
  var i: int64;
  var entryCode: int64;
  
  db := CountryInitDb();
  if (db == 0) {
    return "Unknown";
  }
  
  i := 0;
  while (i < COUNTRY_COUNT * 40) {
    entryCode := peek64(db + i);
    if (entryCode != 0) {
      if (CountryStrEqual(code as int64, entryCode) == 1) {
        return peek64(db + i + 8);  // Return name
      }
    }
    i += 40;
  }
  
  return "Unknown";
}

