// std/process_ext — WP-7: Prozess-Credentials & Systeminfo
// Wrapper um sys_getuid/gid/euid/egid/ppid, sys_uname,
// sys_setsid, sys_setpgid, sys_getpgrp, sys_setuid, sys_setgid

import std.alloc;

// Hilfsfunktion: kopiert n Bytes von src nach dst
fn _peCopyBytes(dst: int64, src: int64, n: int64) {
  var i: int64 := 0;
  while (i < n) {
    poke8(dst + i, peek8(src + i));
    i += 1;
  }
}

// ============================================================
// utsname-Struktur (Linux x86-64, 390 Bytes)
//   +0:   sysname    (65 Bytes, z.B. "Linux")
//   +65:  nodename   (65 Bytes, Hostname)
//   +130: release    (65 Bytes, z.B. "6.8.0-117-generic")
//   +195: version    (65 Bytes, Kernel-Build-Info)
//   +260: machine    (65 Bytes, z.B. "x86_64")
//   +325: domainname (65 Bytes, NIS-Domain)
// ============================================================
pub con UTSNAME_SIZE:     int64 := 390;
pub con UTSNAME_SYSNAME:  int64 := 0;
pub con UTSNAME_NODENAME: int64 := 65;
pub con UTSNAME_RELEASE:  int64 := 130;
pub con UTSNAME_VERSION:  int64 := 195;
pub con UTSNAME_MACHINE:  int64 := 260;
pub con UTSNAME_DOMAIN:   int64 := 325;
pub con UTSNAME_FIELD_LEN: int64 := 65;

// ============================================================
// Prozess-IDs und Credentials lesen
// ============================================================

pub fn GetUID(): int64  { return sys_getuid(); }
pub fn GetGID(): int64  { return sys_getgid(); }
pub fn GetEUID(): int64 { return sys_geteuid(); }
pub fn GetEGID(): int64 { return sys_getegid(); }
pub fn GetPPID(): int64 { return sys_getppid(); }
pub fn GetPGRP(): int64 { return sys_getpgrp(); }

// IsRoot: gibt true zurück wenn der Prozess als Root (EUID=0) läuft.
pub fn IsRoot(): bool {
  return sys_geteuid() == 0;
}

// ============================================================
// Credentials setzen (erfordert passende Berechtigungen)
// ============================================================

// SetUID: setzt die User-ID. Gibt 0 bei Erfolg, -EPERM bei fehlenden Rechten.
pub fn SetUID(uid: int64): int64 { return sys_setuid(uid); }

// SetGID: setzt die Group-ID.
pub fn SetGID(gid: int64): int64 { return sys_setgid(gid); }

// ============================================================
// Session & Prozessgruppe
// ============================================================

// SetSID: erstellt eine neue Session (Daemon-Basis). Gibt die neue SID zurück.
// Schlägt fehl wenn der Prozess bereits Prozessgruppen-Leader ist.
pub fn SetSID(): int64 { return sys_setsid(); }

// SetPGID: setzt die Prozessgruppe von pid auf pgid.
// pid=0 → aktueller Prozess; pgid=0 → pid als eigene Prozessgruppe.
pub fn SetPGID(pid: int64, pgid: int64): int64 {
  return sys_setpgid(pid, pgid);
}

// ============================================================
// Systeminfo via uname
// ============================================================

// GetUname: füllt buf (alloc(UTSNAME_SIZE)) mit dem vollen utsname-Struct.
pub fn GetUname(buf: int64): int64 {
  return sys_uname(buf);
}

// GetUnameSysname: kopiert das sysname-Feld ("Linux") nach outBuf.
// outBuf muss mindestens UTSNAME_FIELD_LEN (65) Bytes groß sein.
pub fn GetUnameSysname(outBuf: int64): int64 {
  var buf: int64 := alloc(UTSNAME_SIZE);
  if (buf == 0) { return -1; }
  var r: int64 := sys_uname(buf);
  if (r == 0) { _peCopyBytes(outBuf, buf +UTSNAME_SYSNAME, UTSNAME_FIELD_LEN);}
  free(buf, UTSNAME_SIZE);
  return r;
}

