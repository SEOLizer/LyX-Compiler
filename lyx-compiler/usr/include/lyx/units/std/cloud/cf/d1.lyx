// std/cloud/cf/d1.lyx — Cloudflare D1 Edge SQL Database
// WP-CF-10
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, system.env, system.time])

unit std.cloud.cf.d1;

import std.cloud.cf.transport;
import std.cloud.cf.core;
import std.alloc;
import std.io;

pub type CFD1Database = struct {
    uuid:       int64;  // pchar
    name:       int64;  // pchar
    version:    int64;  // pchar
    numTables:  int64;
    created:    int64;  // pchar
};

pub type D1Result = struct {
    success:      int64;
    results:      int64;  // pchar — JSON array of row objects
    duration:     int64;  // ms (stored as fixed-point int * 1000)
    lastRowId:    int64;
    rowsAffected: int64;
    changedDB:    int64;
    sizeAfter:    int64;
};

fn d1FreeIfSet(p: int64) {
    if (p != 0) { free(p, StrLen(p as pchar)+1); }
}

pub fn CFD1DatabaseFree(db: CFD1Database) {
    d1FreeIfSet(db.uuid); d1FreeIfSet(db.name);
    d1FreeIfSet(db.version); d1FreeIfSet(db.created);
}

pub fn D1ResultFree(r: D1Result) {
    d1FreeIfSet(r.results);
}

fn parseD1DB(json: int64, jl: int64): CFD1Database {
    var db: CFD1Database;
    db.uuid      := cfExtractValue(json, jl, "uuid"c);
    db.name      := cfExtractValue(json, jl, "name"c);
    db.version   := cfExtractValue(json, jl, "version"c);
    db.numTables := cfExtractInt(json, jl, "num_tables"c);
    db.created   := cfExtractValue(json, jl, "created_at"c);
    return db;
}

fn d1DbPath(accountId: pchar): int64 {
    var buf: int64 := alloc(256);
    var off: int64 := cftAppend(buf, 0, "/accounts/"c);
    off := cftAppend(buf, off, accountId);
    off := cftAppend(buf, off, "/d1/database"c);
    poke8(buf+off, 0); return buf;
}

fn d1QueryPath(accountId: pchar, dbId: pchar): int64 {
    var buf: int64 := alloc(512);
    var off: int64 := cftAppend(buf, 0, "/accounts/"c);
    off := cftAppend(buf, off, accountId);
    off := cftAppend(buf, off, "/d1/database/"c);
    off := cftAppend(buf, off, dbId);
    off := cftAppend(buf, off, "/query"c);
    poke8(buf+off, 0); return buf;
}

// Database management

pub fn D1Create(c: CFClient, accountId: pchar, name: pchar): CFD1Database {
    var path: int64 := d1DbPath(accountId);
    var jn: int64 := cfJsonEscape(name);
    var body: int64 := alloc(256);
    var off: int64 := cftAppend(body, 0, "{\"name\":\""c);
    off := cftAppend(body, off, jn as pchar);
    off := cftAppend(body, off, "\"}"c); poke8(body+off, 0);
    d1FreeIfSet(jn);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 256); free(body, 256);
    var db: CFD1Database;
    db.uuid:=0; db.name:=0; db.version:=0; db.numTables:=0; db.created:=0;
    if (r.success == 1 && r.result != 0) { db := parseD1DB(r.result, r.resultLen); }
    CFResponseFree(r); return db;
}

pub fn D1Delete(c: CFClient, accountId: pchar, dbId: pchar): int64 {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/d1/database/"c);
    po := cftAppend(path, po, dbId); poke8(path+po, 0);
    var r: CFResponse := CFDelete(c, path as pchar);
    free(path, 256);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

pub fn D1Get(c: CFClient, accountId: pchar, dbId: pchar): CFD1Database {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/d1/database/"c);
    po := cftAppend(path, po, dbId); poke8(path+po, 0);
    var r: CFResponse := CFGet(c, path as pchar);
    free(path, 256);
    var db: CFD1Database;
    db.uuid:=0; db.name:=0; db.version:=0; db.numTables:=0; db.created:=0;
    if (r.success == 1 && r.result != 0) { db := parseD1DB(r.result, r.resultLen); }
    CFResponseFree(r); return db;
}

pub fn D1GetByName(c: CFClient, accountId: pchar, name: pchar): CFD1Database {
    var path: int64 := alloc(512);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/d1/database?name="c);
    po := cftAppend(path, po, name); poke8(path+po, 0);
    var r: CFResponse := CFGet(c, path as pchar);
    free(path, 512);
    var db: CFD1Database;
    db.uuid:=0; db.name:=0; db.version:=0; db.numTables:=0; db.created:=0;
    if (r.success == 1 && r.result != 0) {
        var rl: int64 := r.resultLen;
        // result is array, find first element
        if (rl > 2 && (peek8(r.result) & 0xFF) == 91) {
            var j: int64 := 1;
            while (j < rl && (peek8(r.result+j) & 0xFF) != 123) { j := j+1; }
            if (j < rl) {
                var depth: int64 := 0; var k: int64 := j;
                while (k < rl) {
                    var ch: int64 := peek8(r.result+k) & 0xFF;
                    if (ch==123){depth:=depth+1;}
                    if (ch==125){depth:=depth-1;if(depth==0){k:=k+1;break;}}
                    k:=k+1;
                }
                var obj: int64 := cftDupN(r.result+j, k-j);
                db := parseD1DB(obj, k-j);
                free(obj, k-j+1);
            }
        }
    }
    CFResponseFree(r); return db;
}

pub fn D1List(c: CFClient, accountId: pchar): int64 {
    var path: int64 := d1DbPath(accountId);
    var result: int64 := CFGetAll(c, path as pchar, 100);
    free(path, 256); return result;
}

// SQL query execution

fn d1ParseResult(json: int64, jl: int64): D1Result {
    var r: D1Result;
    r.success      := cfExtractBool(json, jl, "success"c);
    r.results      := cfExtractValue(json, jl, "results"c);
    r.rowsAffected := 0;
    r.lastRowId    := 0;
    r.changedDB    := 0;
    r.sizeAfter    := 0;
    r.duration     := 0;
    var meta: int64 := cfExtractValue(json, jl, "meta"c);
    if (meta != 0) {
        var ml: int64 := StrLen(meta as pchar);
        r.rowsAffected := cfExtractInt(meta, ml, "rows_written"c);
        if (r.rowsAffected == 0) { r.rowsAffected := cfExtractInt(meta, ml, "rows_affected"c); }
        r.lastRowId    := cfExtractInt(meta, ml, "last_row_id"c);
        r.changedDB    := cfExtractBool(meta, ml, "changed_db"c);
        r.sizeAfter    := cfExtractInt(meta, ml, "size_after"c);
        free(meta, ml+1);
    }
    return r;
}

pub fn D1Query(c: CFClient, accountId: pchar, dbId: pchar,
               sql: pchar, params: pchar, paramCount: int64): D1Result {
    var path: int64 := d1QueryPath(accountId, dbId);
    var jsql: int64 := cfJsonEscape(sql);
    var body: int64 := alloc(4096);
    var off: int64 := cftAppend(body, 0, "{\"sql\":\""c);
    off := cftAppend(body, off, jsql as pchar);
    off := cftAppend(body, off, "\",\"params\":"c);
    if (params != 0 as pchar && paramCount > 0) {
        off := cftAppend(body, off, params);
    } else {
        off := cftAppend(body, off, "[]"c);
    }
    off := cftAppend(body, off, "}"c); poke8(body+off, 0);
    d1FreeIfSet(jsql);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 512); free(body, 4096);
    var result: D1Result;
    result.success:=0; result.results:=0; result.duration:=0;
    result.lastRowId:=0; result.rowsAffected:=0; result.changedDB:=0; result.sizeAfter:=0;
    if (r.success == 1 && r.result != 0) {
        var rl: int64 := r.resultLen;
        // result might be array of result objects
        if (rl > 2 && (peek8(r.result) & 0xFF) == 91) {
            var j: int64 := 1;
            while (j < rl && (peek8(r.result+j) & 0xFF) != 123) { j := j+1; }
            if (j < rl) {
                var depth: int64 := 0; var k: int64 := j;
                while (k < rl) {
                    var ch: int64 := peek8(r.result+k) & 0xFF;
                    if (ch==123){depth:=depth+1;}
                    if (ch==125){depth:=depth-1;if(depth==0){k:=k+1;break;}}
                    k:=k+1;
                }
                var obj: int64 := cftDupN(r.result+j, k-j);
                result := d1ParseResult(obj, k-j);
                free(obj, k-j+1);
            }
        } else {
            result := d1ParseResult(r.result, rl);
        }
    }
    CFResponseFree(r); return result;
}

pub fn D1Exec(c: CFClient, accountId: pchar, dbId: pchar, sql: pchar): D1Result {
    return D1Query(c, accountId, dbId, sql, 0 as pchar, 0);
}

pub fn D1ExecScript(c: CFClient, accountId: pchar, dbId: pchar, sqlScript: pchar): int64 {
    var path: int64 := alloc(512);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/d1/database/"c);
    po := cftAppend(path, po, dbId);
    po := cftAppend(path, po, "/export"c); poke8(path+po, 0);
    var jsql: int64 := cfJsonEscape(sqlScript);
    var body: int64 := alloc(StrLen(sqlScript)*2 + 64);
    var off: int64 := cftAppend(body, 0, "{\"sql\":\""c);
    off := cftAppend(body, off, jsql as pchar);
    off := cftAppend(body, off, "\"}"c); poke8(body+off, 0);
    d1FreeIfSet(jsql);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 512); free(body, StrLen(sqlScript)*2+64);
    var result: int64 := 0;
    if (r.success == 1 && r.result != 0) { result := cftDupN(r.result, r.resultLen); }
    CFResponseFree(r); return result;
}

// Result accessors — scan the results JSON array for a specific row/column

pub fn D1ResultRowCount(r: D1Result): int64 {
    if (r.results == 0) { return 0; }
    var rl: int64 := StrLen(r.results as pchar);
    if (rl < 2 || (peek8(r.results) & 0xFF) != 91) { return 0; }
    // Count top-level '{' at depth 1
    var count: int64 := 0; var depth: int64 := 0; var i: int64 := 0;
    while (i < rl) {
        var ch: int64 := peek8(r.results+i) & 0xFF;
        if (ch == 34) { // skip string
            i += 1;
            while (i < rl && (peek8(r.results+i)&0xFF) != 34) {
                if ((peek8(r.results+i)&0xFF)==92) { i:=i+1; }
                i += 1;
            }
        } else {
            if (ch==91||ch==123) { depth:=depth+1; if(ch==123&&depth==2){count:=count+1;} }
            if (ch==93||ch==125) { depth:=depth-1; }
        }
        i += 1;
    }
    return count;
}

// Get the Nth row as a JSON object string (0-indexed)
fn d1GetRow(r: D1Result, row: int64): int64 {
    if (r.results == 0) { return 0; }
    var rl: int64 := StrLen(r.results as pchar);
    if (rl < 2) { return 0; }
    var depth: int64 := 0; var i: int64 := 0;
    var rowCount: int64 := 0;
    while (i < rl) {
        var ch: int64 := peek8(r.results+i) & 0xFF;
        if (ch == 34) {
            i += 1;
            while (i < rl && (peek8(r.results+i)&0xFF) != 34) {
                if ((peek8(r.results+i)&0xFF)==92) { i:=i+1; }
                i += 1;
            }
        } else {
            if (ch==91||ch==123) {
                depth += 1;
                if (ch==123 && depth==2) {
                    if (rowCount == row) {
                        var start: int64 := i; var d2: int64 := 1; i:=i+1;
                        while (i < rl && d2 > 0) {
                            var c2: int64 := peek8(r.results+i) & 0xFF;
                            if (c2==34){i:=i+1;while(i<rl&&(peek8(r.results+i)&0xFF)!=34){if((peek8(r.results+i)&0xFF)==92){i:=i+1;}i:=i+1;}}
                            else {if(c2==123){d2:=d2+1;}if(c2==125){d2:=d2-1;}}
                            i += 1;
                        }
                        return cftDupN(r.results+start, i-start);
                    }
                    rowCount += 1;
                }
            }
            if (ch==93||ch==125) { depth:=depth-1; }
        }
        i += 1;
    }
    return 0;
}

pub fn D1ResultGetString(r: D1Result, row: int64, col: pchar): int64 {
    var rowObj: int64 := d1GetRow(r, row);
    if (rowObj == 0) { return 0; }
    var rl: int64 := StrLen(rowObj as pchar);
    var val: int64 := cfExtractValue(rowObj, rl, col);
    free(rowObj, rl+1);
    return val;
}

pub fn D1ResultGetInt(r: D1Result, row: int64, col: pchar): int64 {
    var rowObj: int64 := d1GetRow(r, row);
    if (rowObj == 0) { return 0; }
    var rl: int64 := StrLen(rowObj as pchar);
    var n: int64 := cfExtractInt(rowObj, rl, col);
    free(rowObj, rl+1);
    return n;
}

pub fn D1ResultGetBool(r: D1Result, row: int64, col: pchar): int64 {
    var rowObj: int64 := d1GetRow(r, row);
    if (rowObj == 0) { return 0; }
    var rl: int64 := StrLen(rowObj as pchar);
    var b: int64 := cfExtractBool(rowObj, rl, col);
    free(rowObj, rl+1);
    return b;
}

pub fn D1ResultIsNull(r: D1Result, row: int64, col: pchar): int64 {
    var rowObj: int64 := d1GetRow(r, row);
    if (rowObj == 0) { return 1; }
    var rl: int64 := StrLen(rowObj as pchar);
    var val: int64 := cfExtractValue(rowObj, rl, col);
    free(rowObj, rl+1);
    if (val == 0) { return 1; }
    var vl: int64 := StrLen(val as pchar);
    var isNull: int64 := 0;
    if (vl == 4 && (peek8(val)&0xFF)==110) { isNull := 1; } // "null"
    free(val, vl+1);
    return isNull;
}

pub fn D1ResultColumns(r: D1Result): int64 {
    // Get first row object keys as column names
    if (r.results == 0) { return 0; }
    var rowObj: int64 := d1GetRow(r, 0);
    if (rowObj == 0) { return 0; }
    // Return the row object JSON (caller parses keys)
    return rowObj;
}

// Batch execute

pub type D1Statement = struct {
    sql:        int64;  // pchar
    params:     int64;  // pchar — JSON array or 0
    paramCount: int64;
};

pub fn D1Batch(c: CFClient, accountId: pchar, dbId: pchar,
               stmts: int64, stmtCount: int64): int64 {
    var path: int64 := alloc(512);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/d1/database/"c);
    po := cftAppend(path, po, dbId);
    po := cftAppend(path, po, "/query"c); poke8(path+po, 0);

    var body: int64 := alloc(stmtCount * 1024 + 16);
    var off: int64 := cftAppend(body, 0, "["c);
    var i: int64 := 0;
    while (i < stmtCount) {
        if (i > 0) { off := cftAppend(body, off, ","c); }
        var stmt: int64 := stmts + i * 24; // D1Statement is 3*8=24 bytes
        var sql: pchar   := peek64(stmt) as pchar;
        var params: pchar := peek64(stmt + 8) as pchar;
        var jsql: int64 := cfJsonEscape(sql);
        off := cftAppend(body, off, "{\"sql\":\""c);
        off := cftAppend(body, off, jsql as pchar);
        off := cftAppend(body, off, "\",\"params\":"c);
        if (params != 0 as pchar) {
            off := cftAppend(body, off, params);
        } else {
            off := cftAppend(body, off, "[]"c);
        }
        off := cftAppend(body, off, "}"c);
        d1FreeIfSet(jsql);
        i += 1;
    }
    off := cftAppend(body, off, "]"c); poke8(body+off, 0);

    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 512); free(body, stmtCount*1024+16);
    var result: int64 := 0;
    if (r.success == 1 && r.result != 0) { result := cftDupN(r.result, r.resultLen); }
    CFResponseFree(r); return result;
}

// Schema info helpers

pub fn D1Tables(c: CFClient, accountId: pchar, dbId: pchar): int64 {
    var r: D1Result := D1Query(c, accountId, dbId,
        "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name"c,
        0 as pchar, 0);
    var result: int64 := r.results;
    r.results := 0;
    D1ResultFree(r);
    return result;
}

pub fn D1Schema(c: CFClient, accountId: pchar, dbId: pchar, tableName: pchar): int64 {
    var params: int64 := alloc(64);
    var po: int64 := cftAppend(params, 0, "[\""c);
    po := cftAppend(params, po, tableName);
    po := cftAppend(params, po, "\"]"c); poke8(params+po, 0);
    var r: D1Result := D1Query(c, accountId, dbId,
        "SELECT sql FROM sqlite_master WHERE name=?"c,
        params as pchar, 1);
    free(params, 64);
    var val: int64 := D1ResultGetString(r, 0, "sql"c);
    D1ResultFree(r);
    return val;
}

// Export / Import

pub fn D1Export(c: CFClient, accountId: pchar, dbId: pchar): int64 {
    var path: int64 := alloc(512);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/d1/database/"c);
    po := cftAppend(path, po, dbId);
    po := cftAppend(path, po, "/export"c); poke8(path+po, 0);
    var r: CFResponse := CFGet(c, path as pchar);
    free(path, 512);
    var result: int64 := 0;
    if (r.statusCode == 200 && r.result != 0) { result := cftDupN(r.result, r.resultLen); }
    CFResponseFree(r); return result;
}

pub fn D1Import(c: CFClient, accountId: pchar, dbId: pchar,
                sqlDump: int64, dumpLen: int64): int64 {
    var path: int64 := alloc(512);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/d1/database/"c);
    po := cftAppend(path, po, dbId);
    po := cftAppend(path, po, "/import"c); poke8(path+po, 0);
    var r: CFResponse := CFPutRaw(c, path as pchar, "application/sql"c, sqlDump, dumpLen);
    free(path, 512);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}
