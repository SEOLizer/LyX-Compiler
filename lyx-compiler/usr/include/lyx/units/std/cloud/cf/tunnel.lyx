    CFResponseFree(r); return result;
}

// Virtual Networks

pub fn TunnelVNetCreate(c: CFClient, accountId: pchar, name: pchar,
                        comment: pchar): int64 {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/teamnet/virtual_networks"c); poke8(path+po, 0);
    var jname: int64 := cfJsonEscape(name);
    var body: int64 := alloc(512);
    var off: int64 := cftAppend(body, 0, "{\"name\":\""c);
    off := cftAppend(body, off, jname as pchar);
    if (comment != 0 as pchar) {
        var jcmt: int64 := cfJsonEscape(comment);
        off := cftAppend(body, off, "\",\"comment\":\""c);
        off := cftAppend(body, off, jcmt as pchar);
        tnFreeIfSet(jcmt);
    }
    off := cftAppend(body, off, "\"}"c); poke8(body+off, 0);
    tnFreeIfSet(jname);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 256); free(body, 512);
    var result: int64 := 0;
    if (r.success == 1 && r.result != 0) { result := cfExtractValue(r.result, r.resultLen, "id"c); }
    CFResponseFree(r); return result;
}

pub fn TunnelVNetList(c: CFClient, accountId: pchar): int64 {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/teamnet/virtual_networks"c); poke8(path+po, 0);
    var result: int64 := CFGetAll(c, path as pchar, 100);
    free(path, 256); return result;
}

// IP Routes (Tunnel routing)

pub fn TunnelRouteCreate(c: CFClient, accountId: pchar, tunnelId: pchar,
                         network: pchar, comment: pchar): int64 {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/teamnet/routes"c); poke8(path+po, 0);
    var jnet: int64 := cfJsonEscape(network);
    var jtun: int64 := cfJsonEscape(tunnelId);
    var body: int64 := alloc(512);
    var off: int64 := cftAppend(body, 0, "{\"network\":\""c);
    off := cftAppend(body, off, jnet as pchar);
    off := cftAppend(body, off, "\",\"tunnel_id\":\""c);
    off := cftAppend(body, off, jtun as pchar);
    if (comment != 0 as pchar) {
        var jcmt: int64 := cfJsonEscape(comment);
        off := cftAppend(body, off, "\",\"comment\":\""c);
        off := cftAppend(body, off, jcmt as pchar);
        tnFreeIfSet(jcmt);
    }
    off := cftAppend(body, off, "\"}"c); poke8(body+off, 0);
    tnFreeIfSet(jnet); tnFreeIfSet(jtun);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 256); free(body, 512);
    var ok: int64 := r.success; CFResponseFree(r); return ok;
}

pub fn TunnelRouteList(c: CFClient, accountId: pchar): int64 {
    var path: int64 := alloc(256);
