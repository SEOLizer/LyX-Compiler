// Load Balancers

pub fn LBCreate(c: CFClient, zoneId: pchar,
                name: pchar, defaultPoolsJson: pchar, poolsLen: int64,
                fallbackPool: pchar, steering: pchar, proxied: int64): CFLoadBalancer {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId);
    po := cftAppend(path, po, "/load_balancers"c); poke8(path+po, 0);
    var jname:     int64 := cfJsonEscape(name);
    var jfallback: int64 := cfJsonEscape(fallbackPool);
    var jsteering: int64 := cfJsonEscape(steering);
    var body: int64 := alloc(poolsLen + 512);
    var off: int64 := cftAppend(body, 0, "{\"name\":\""c);
    off := cftAppend(body, off, jname as pchar);
    off := cftAppend(body, off, "\",\"default_pools\":"c);
    off := cftAppendN(body, off, defaultPoolsJson as int64, poolsLen);
    off := cftAppend(body, off, ",\"fallback_pool\":\""c);
    off := cftAppend(body, off, jfallback as pchar);
    off := cftAppend(body, off, "\",\"steering_policy\":\""c);
    off := cftAppend(body, off, jsteering as pchar);
    off := cftAppend(body, off, "\",\"session_affinity\":\"none\",\"proxied\":"c);
    if (proxied==1){off:=cftAppend(body,off,"true"c);}else{off:=cftAppend(body,off,"false"c);}
    off := cftAppend(body, off, ",\"enabled\":true}"c); poke8(body+off, 0);
    lbFreeIfSet(jname); lbFreeIfSet(jfallback); lbFreeIfSet(jsteering);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 256); free(body, poolsLen+512);
    var lb: CFLoadBalancer;
    lb.id:=0; lb.name:=0; lb.defaultPoolsJson:=0; lb.fallbackPool:=0;
    lb.steering:=0; lb.sessionAffinity:=0; lb.ttl:=0; lb.proxied:=0; lb.enabled:=0;
    if (r.success == 1 && r.result != 0) { lb := parseLB(r.result, r.resultLen); }
    CFResponseFree(r); return lb;
}

