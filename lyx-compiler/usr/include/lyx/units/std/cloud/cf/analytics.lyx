pub fn LogpushJobCheck(c: CFClient, zoneId: pchar, accountId: pchar,
                       jobId: int64): int64 {
    var base: int64;
    if (zoneId != 0 as pchar) { base := logpushPath(zoneId); }
    else { base := logpushAccountPath(accountId); }
    var bl: int64 := StrLen(base as pchar);
    var path: int64 := alloc(bl + 32);
    var po: int64 := cftAppend(path, 0, base as pchar);
    po := cftAppend(path, po, "/"c);
    var idBuf: int64 := alloc(24);
    var idStr: int64 := Int64ToStr(jobId, idBuf);
    po := cftAppend(path, po, idBuf as pchar);
    po := cftAppend(path, po, "/validate/origin"c); poke8(path+po, 0);
    free(base, 256); free(idBuf, 24);
    var r: CFResponse := CFGet(c, path as pchar);
    free(path, bl+32);
    var ok: int64 := r.success; CFResponseFree(r); return ok;
