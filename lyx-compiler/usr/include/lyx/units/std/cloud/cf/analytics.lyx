// GraphQL Analytics API

pub fn AnalyticsGraphQL(c: CFClient, query: pchar, variables: pchar): int64 {
    var jq: int64 := cfJsonEscape(query);
    var body: int64 := alloc(8192);
    var off: int64 := cftAppend(body, 0, "{\"query\":\""c);
    off := cftAppend(body, off, jq as pchar);
    if (variables != 0 as pchar) {
        off := cftAppend(body, off, "\",\"variables\":"c);
        off := cftAppend(body, off, variables);
        off := cftAppend(body, off, "}"c);
    } else {
        off := cftAppend(body, off, "\"}"c);
    }
    poke8(body+off, 0);
    anFreeIfSet(jq);
    var r: CFResponse := cfSend(c, "POST"c, "/graphql"c, body, off);
    free(body, 8192);
    var result: int64 := 0;
    if (r.result != 0) { result := cftDupN(r.result, r.resultLen); }
    else if (r.errors != 0) { result := cftDupN(r.errors, StrLen(r.errors as pchar)); }
    CFResponseFree(r); return result;
}

// Top 10 IPs — via GraphQL

pub fn AnalyticsTop10IPs(c: CFClient, zoneId: pchar, since: pchar): int64 {
    var query: int64 := alloc(1024);
    var qo: int64 := cftAppend(query, 0,
        "{ viewer { zones(filter: {zoneTag: \""c);
    qo := cftAppend(query, qo, zoneId);
    qo := cftAppend(query, qo, "\"}) { httpRequestsAdaptiveGroups(limit: 10, orderBy: [count_DESC], filter: {datetime_gt: \""c);
    if (since != 0 as pchar) { qo := cftAppend(query, qo, since); }
    else { qo := cftAppend(query, qo, "2024-01-01T00:00:00Z"c); }
    qo := cftAppend(query, qo, "\"}) { count dimensions { clientIP } } } } }"c);
    poke8(query+qo, 0);
    var result: int64 := AnalyticsGraphQL(c, query as pchar, 0 as pchar);
    free(query, 1024);
    return result;
}

