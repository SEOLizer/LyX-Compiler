fn anFreeIfSet(p: int64) {
    if (p != 0) { free(p, StrLen(p as pchar)+1); }
}

// Zone analytics dashboard (legacy API)

pub fn AnalyticsDashboard(c: CFClient, zoneId: pchar,
                          since: pchar, until_: pchar): int64 {
    var path: int64 := alloc(512);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId);
    po := cftAppend(path, po, "/analytics/dashboard?since="c);
    if (since != 0 as pchar) { po := cftAppend(path, po, since); }
    else { po := cftAppend(path, po, "-1440"c); }
    if (until_ != 0 as pchar) {
        po := cftAppend(path, po, "&until="c);
        po := cftAppend(path, po, until_);
    }
    poke8(path+po, 0);
    var r: CFResponse := CFGet(c, path as pchar);
    free(path, 512);
    var result: int64 := 0;
    if (r.result != 0) { result := cftDupN(r.result, r.resultLen); }
    CFResponseFree(r); return result;
}

