pub fn AnalyticsFirewallEvents(c: CFClient, zoneId: pchar, since: pchar,
                               limit: int64): int64 {
    var path: int64 := alloc(512);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId);
    po := cftAppend(path, po, "/firewall/events?since="c);
    if (since != 0 as pchar) { po := cftAppend(path, po, since); }
    if (limit > 0 && limit <= 1000) {
        po := cftAppend(path, po, "&per_page="c);
        var lbuf: int64 := alloc(16);
        var lstr: int64 := Int64ToStr(limit, lbuf);
        po := cftAppend(path, po, lbuf as pchar);
        free(lbuf, 16);
    }
    poke8(path+po, 0);
    var r: CFResponse := CFGet(c, path as pchar);
    free(path, 512);
    var result: int64 := 0;
    if (r.result != 0) { result := cftDupN(r.result, r.resultLen); }
    CFResponseFree(r); return result;
}

pub fn AnalyticsWorkerInvocations(c: CFClient, accountId: pchar,
                                   scriptName: pchar, since: pchar): int64 {
    var query: int64 := alloc(1024);
    var qo: int64 := cftAppend(query, 0,
        "{ viewer { accounts(filter: {accountTag: \""c);
    qo := cftAppend(query, qo, accountId);
    qo := cftAppend(query, qo, "\"}) { workersInvocationsAdaptive(limit: 100, filter: {scriptName: \""c);
    qo := cftAppend(query, qo, scriptName);
    qo := cftAppend(query, qo, "\", datetime_gt: \""c);
    if (since != 0 as pchar) { qo := cftAppend(query, qo, since); }
    else { qo := cftAppend(query, qo, "2024-01-01T00:00:00Z"c); }
    qo := cftAppend(query, qo, "\"}) { sum { requests errors } dimensions { datetime } } } } }"c);
    poke8(query+qo, 0);
    var result: int64 := AnalyticsGraphQL(c, query as pchar, 0 as pchar);
    free(query, 1024);
    return result;
}

// Web Analytics

pub fn WebAnalyticsSiteCreate(c: CFClient, accountId: pchar,
                               zoneTag: pchar, host: pchar): int64 {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/web3/namespaces"c); poke8(path+po, 0);
    var jhost: int64 := cfJsonEscape(host);
    var body: int64 := alloc(512);
    var off: int64 := cftAppend(body, 0, "{\"host\":\""c);
    off := cftAppend(body, off, jhost as pchar);
    if (zoneTag != 0 as pchar) {
        off := cftAppend(body, off, "\",\"zone_tag\":\""c);
        off := cftAppend(body, off, zoneTag);
    }
    off := cftAppend(body, off, "\"}"c); poke8(body+off, 0);
    anFreeIfSet(jhost);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 256); free(body, 512);
    var result: int64 := 0;
    if (r.success == 1 && r.result != 0) { result := cfExtractValue(r.result, r.resultLen, "site_tag"c); }
    CFResponseFree(r); return result;
}

pub fn WebAnalyticsSiteList(c: CFClient, accountId: pchar): int64 {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/web3/namespaces"c); poke8(path+po, 0);
    var r: CFResponse := CFGet(c, path as pchar);
    free(path, 256);
    var result: int64 := 0;
    if (r.result != 0) { result := cftDupN(r.result, r.resultLen); }
    CFResponseFree(r); return result;
}

// Logpush Jobs

fn logpushPath(zoneId: pchar): int64 {
    var buf: int64 := alloc(256);
    var off: int64 := cftAppend(buf, 0, "/zones/"c);
    off := cftAppend(buf, off, zoneId);
    off := cftAppend(buf, off, "/logpush/jobs"c);
    poke8(buf+off, 0); return buf;
}

fn logpushAccountPath(accountId: pchar): int64 {
    var buf: int64 := alloc(256);
    var off: int64 := cftAppend(buf, 0, "/accounts/"c);
    off := cftAppend(buf, off, accountId);
    off := cftAppend(buf, off, "/logpush/jobs"c);
    poke8(buf+off, 0); return buf;
}

pub fn LogpushJobCreate(c: CFClient, zoneId: pchar, accountId: pchar,
                        dataset: pchar, destination: pchar,
                        fields: pchar, enabled: int64): int64 {
    var path: int64;
    if (zoneId != 0 as pchar) { path := logpushPath(zoneId); }
    else { path := logpushAccountPath(accountId); }
    var jdest: int64 := cfJsonEscape(destination);
    var body: int64 := alloc(1024);
    var off: int64 := cftAppend(body, 0, "{\"dataset\":\""c);
    off := cftAppend(body, off, dataset);
    off := cftAppend(body, off, "\",\"destination_conf\":\""c);
    off := cftAppend(body, off, jdest as pchar);
    if (fields != 0 as pchar) {
        var jfields: int64 := cfJsonEscape(fields);
        off := cftAppend(body, off, "\",\"logpull_options\":\"fields="c);
        off := cftAppend(body, off, jfields as pchar);
        anFreeIfSet(jfields);
    }
    off := cftAppend(body, off, "\",\"enabled\":"c);
    if (enabled == 1) { off := cftAppend(body, off, "true"c); }
    else { off := cftAppend(body, off, "false"c); }
    off := cftAppend(body, off, "}"c); poke8(body+off, 0);
    anFreeIfSet(jdest);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 256); free(body, 1024);
    var jobId: int64 := 0;
    if (r.success == 1 && r.result != 0) { jobId := cfExtractInt(r.result, r.resultLen, "id"c); }
    CFResponseFree(r); return jobId;
}

pub fn LogpushJobUpdate(c: CFClient, zoneId: pchar, accountId: pchar,
                        jobId: int64, enabled: int64): int64 {
    var base: int64;
    if (zoneId != 0 as pchar) { base := logpushPath(zoneId); }
    else { base := logpushAccountPath(accountId); }
    var bl: int64 := StrLen(base as pchar);
    var path: int64 := alloc(bl + 32);
    var po: int64 := cftAppend(path, 0, base as pchar);
    po := cftAppend(path, po, "/"c);
    var idBuf: int64 := alloc(24);
    var idStr: int64 := Int64ToStr(jobId, idBuf);
    po := cftAppend(path, po, idBuf as pchar); poke8(path+po, 0);
    free(base, 256); free(idBuf, 24);
    var body: int64 := alloc(64);
    var off: int64 := cftAppend(body, 0, "{\"enabled\":"c);
    if (enabled == 1) { off := cftAppend(body, off, "true"c); }
    else { off := cftAppend(body, off, "false"c); }
    off := cftAppend(body, off, "}"c); poke8(body+off, 0);
    var r: CFResponse := CFPut(c, path as pchar, body, off);
    free(path, bl+32); free(body, 64);
    var ok: int64 := r.success; CFResponseFree(r); return ok;
}

