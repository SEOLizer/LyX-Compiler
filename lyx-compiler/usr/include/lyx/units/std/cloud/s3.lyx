// std/cloud/s3.lyx — AWS S3 Client (Full Implementation)
// WP-S3-01..09: SHA-256/HMAC via std.crypto.*, SigV4 via std.cloud.aws.sigv4,
// Transport via std.cloud.aws.transport. XML parsing via std.cloud.aws.xml.
//
// Public API (alphabetical within groups):
//   Connections:  S3Connect, S3ConnectEndpoint, S3ConnectR2, S3ConnectMinio, S3Close
//   Bucket:       S3BucketCreate, S3BucketDelete, S3BucketExists, S3ListBuckets
//                 S3BucketListCount, S3BucketListGetName, S3BucketListFree
//   Object:       S3PutObject, S3PutObjectFile, S3GetObject, S3GetObjectFile
//                 S3GetObjectRange, S3DeleteObject, S3DeleteObjects
//                 S3HeadObject, S3ObjectExists, S3CopyObject
//                 S3GetObjectSize, S3GetETag
//   Meta:         S3ObjectMetaFree
//   List:         S3ListObjects, S3ListObjectsNext, S3ListAll, S3ListWithDelimiter
//                 S3ListCount, S3ListGetKey, S3ListGetSize, S3ListGetETag
//                 S3ListGetModified, S3ListIsTruncated, S3ListGetToken
//                 S3ListGetPrefix, S3ListPrefixCount, S3ListFree
//   Multipart:    S3MultipartBegin, S3MultipartUploadPart, S3MultipartComplete
//                 S3MultipartAbort, S3PutObjectMultipart
//   Presigned:    S3PresignGet, S3PresignPut, S3PresignDelete, S3PresignHead
//                 S3PresignURL (legacy alias for S3PresignGet)
//   Errors:       S3LastStatus, S3LastError, S3LastErrorCode
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, system.env, system.time])

unit std.cloud.s3;

import std.cloud.aws.core;
import std.cloud.aws.transport;
import std.cloud.aws.xml;
import std.cloud.aws.sigv4;
import std.alloc;
import std.io;
import std.fs;

// ── S3Client — connection context ─────────────────────────────────────────────

pub type S3Client = struct {
    creds:      AWSCreds;
    region:     int64;  // pchar
    endpoint:   int64;  // pchar custom endpoint or 0 (use AWS default)
    pathStyle:  int64;  // 1 = path-style, 0 = virtual-hosted
    useTLS:     int64;  // 0 = HTTP (MinIO dev), 1 = HTTPS
    port:       int64;  // 443 or custom
    lastStatus: int64;
    lastError:  int64;  // pchar (alloc'd, last XML <Code>)
    lastErrMsg: int64;  // pchar (alloc'd, last XML <Message>)
};

// ── S3Object / S3ObjectMeta ───────────────────────────────────────────────────

pub type S3Object = struct {
    key:          int64;  // pchar
    size:         int64;
    etag:         int64;  // pchar
    lastModified: int64;  // pchar
    storageClass: int64;  // pchar
};

pub type S3ObjectMeta = struct {
    key:          int64;  // pchar
    etag:         int64;  // pchar
    size:         int64;
    lastModified: int64;  // pchar
    contentType:  int64;  // pchar
    versionId:    int64;  // pchar
};

pub fn S3ObjectFree(o: S3Object) {
    if (o.key          != 0) { free(o.key,          StrLen(o.key          as pchar)+1); }
    if (o.etag         != 0) { free(o.etag,         StrLen(o.etag         as pchar)+1); }
    if (o.lastModified != 0) { free(o.lastModified, StrLen(o.lastModified as pchar)+1); }
    if (o.storageClass != 0) { free(o.storageClass, StrLen(o.storageClass as pchar)+1); }
}

pub fn S3ObjectMetaFree(m: S3ObjectMeta) {
    if (m.key          != 0) { free(m.key,          StrLen(m.key          as pchar)+1); }
    if (m.etag         != 0) { free(m.etag,         StrLen(m.etag         as pchar)+1); }
    if (m.lastModified != 0) { free(m.lastModified, StrLen(m.lastModified as pchar)+1); }
    if (m.contentType  != 0) { free(m.contentType,  StrLen(m.contentType  as pchar)+1); }
    if (m.versionId    != 0) { free(m.versionId,    StrLen(m.versionId    as pchar)+1); }
}

// ── S3ObjectList ──────────────────────────────────────────────────────────────
// Layout: [count:i64][isTruncated:i64][continuationToken:i64][objects:i64*count][prefixCount:i64][prefixes:i64*]
// For simplicity we use a flat heap buffer. Accessor functions are the public API.

// Internal flat-list structure stored as heap-allocated int64 array:
//  [0]  count
//  [1]  isTruncated
//  [2]  continuation token (pchar ptr or 0)
//  [3]  prefix count
//  [4..4+count-1] S3Object pointers (each alloc'd)
//  [4+count..4+count+prefixCount-1] prefix pchar pointers
// Objects and prefixes alloc'd inline: we store S3Object values as
// contiguous structs after the header region.

// We use a simpler flat encoding:
//   int64 list[0] = count
//   int64 list[1] = isTruncated (0 or 1)
//   int64 list[2] = continuationToken ptr (or 0)
//   int64 list[3] = prefixCount
//   int64 list[4+i*5+0] = key ptr (i-th object)
//   int64 list[4+i*5+1] = size
//   int64 list[4+i*5+2] = etag ptr
//   int64 list[4+i*5+3] = lastModified ptr
//   int64 list[4+i*5+4] = storageClass ptr
// After count objects: prefix ptrs start at [4+count*5]

con S3LIST_MAX_OBJECTS: int64 := 1001;
con S3LIST_HDR: int64 := 4;  // header words
con S3LIST_OBJ: int64 := 5;  // words per object

fn s3ListAlloc(maxObjs: int64): int64 {
    var total: int64 := (S3LIST_HDR + maxObjs * S3LIST_OBJ + maxObjs) * 8 + 8;
    var buf: int64 := alloc(total);
    poke64(buf, 0); poke64(buf+8, 0); poke64(buf+16, 0); poke64(buf+24, 0);
    return buf;
}

pub fn S3ListCount(list: int64): int64 {
    if (list == 0) { return 0; }
    return peek64(list);
}

pub fn S3ListIsTruncated(list: int64): int64 {
    if (list == 0) { return 0; }
    return peek64(list + 8);
}

pub fn S3ListGetToken(list: int64): pchar {
    if (list == 0) { return 0 as pchar; }
    return peek64(list + 16) as pchar;
}

pub fn S3ListPrefixCount(list: int64): int64 {
    if (list == 0) { return 0; }
    return peek64(list + 24);
}

fn s3ListObjBase(list: int64, i: int64): int64 {
    return list + (S3LIST_HDR + i * S3LIST_OBJ) * 8;
}

pub fn S3ListGetKey(list: int64, i: int64): pchar {
    return peek64(s3ListObjBase(list, i)) as pchar;
}

pub fn S3ListGetSize(list: int64, i: int64): int64 {
    return peek64(s3ListObjBase(list, i) + 8);
}

pub fn S3ListGetETag(list: int64, i: int64): pchar {
    return peek64(s3ListObjBase(list, i) + 16) as pchar;
}

pub fn S3ListGetModified(list: int64, i: int64): pchar {
    return peek64(s3ListObjBase(list, i) + 24) as pchar;
}

pub fn S3ListGetPrefix(list: int64, i: int64): pchar {
    var count: int64 := peek64(list);
    var base: int64 := list + (S3LIST_HDR + count * S3LIST_OBJ) * 8;
    return peek64(base + i * 8) as pchar;
}

pub fn S3ListFree(list: int64) {
    if (list == 0) { return; }
    var count: int64 := peek64(list);
    var pc: int64    := peek64(list + 24);
    var tok: int64   := peek64(list + 16);
    if (tok != 0) { free(tok, StrLen(tok as pchar)+1); }
    var i: int64 := 0;
    while (i < count) {
        var base: int64 := s3ListObjBase(list, i);
        var key: int64 := peek64(base);
        var etag: int64 := peek64(base+16);
        var mod: int64 := peek64(base+24);
        var sc: int64 := peek64(base+32);
        if (key != 0) { free(key, StrLen(key as pchar)+1); }
        if (etag != 0) { free(etag, StrLen(etag as pchar)+1); }
        if (mod != 0) { free(mod, StrLen(mod as pchar)+1); }
        if (sc != 0) { free(sc, StrLen(sc as pchar)+1); }
        i += 1;
    }
    var prefixBase: int64 := list + (S3LIST_HDR + count * S3LIST_OBJ) * 8;
    i := 0;
    while (i < pc) {
        var p: int64 := peek64(prefixBase + i * 8);
        if (p != 0) { free(p, StrLen(p as pchar)+1); }
        i += 1;
    }
    var total: int64 := (S3LIST_HDR + S3LIST_MAX_OBJECTS * S3LIST_OBJ + S3LIST_MAX_OBJECTS) * 8 + 8;
    free(list, total);
}

// ── S3BucketList ──────────────────────────────────────────────────────────────

pub type S3BucketList = struct {
    count:  int64;
    names:  int64;  // ptr to alloc'd array of pchar ptrs
};

pub fn S3BucketListCount(bl: S3BucketList): int64 { return bl.count; }

pub fn S3BucketListGetName(bl: S3BucketList, i: int64): pchar {
    if (bl.names == 0 || i >= bl.count) { return ""c; }
    return peek64(bl.names + i * 8) as pchar;
}

pub fn S3BucketListFree(bl: S3BucketList) {
    if (bl.names == 0) { return; }
    var i: int64 := 0;
    while (i < bl.count) {
        var p: int64 := peek64(bl.names + i * 8);
        if (p != 0) { free(p, StrLen(p as pchar)+1); }
        i += 1;
    }
    free(bl.names, bl.count * 8 + 8);
}

// ── Internal helpers ──────────────────────────────────────────────────────────

fn s3StrDup(s: pchar): int64 {
    if (s == 0 as pchar) { return 0; }
    var n: int64 := StrLen(s);
    var buf: int64 := alloc(n+1);
    var i: int64 := 0;
    while (i < n) { poke8(buf+i, StrCharAt(s,i)&0xFF); i:=i+1; }
    poke8(buf+n, 0); return buf;
}

fn s3StrDupN(src: int64, n: int64): int64 {
    if (src == 0 || n == 0) { return 0; }
    var buf: int64 := alloc(n+1);
    var i: int64 := 0;
    while (i < n) { poke8(buf+i, peek8(src+i)); i:=i+1; }
    poke8(buf+n, 0); return buf;
}

fn s3Append(buf: int64, off: int64, s: pchar): int64 {
    var n: int64 := StrLen(s); var i: int64 := 0;
    while (i<n) { poke8(buf+off+i, StrCharAt(s,i)&0xFF); i:=i+1; }
    return off+n;
}

fn s3Int64ToStr(n: int64, buf: int64): pchar {
    if (n == 0) { poke8(buf, 48); poke8(buf+1, 0); return buf as pchar; }
    var tmp: int64 := alloc(24); var i: int64 := 0;
    var v: int64 := n;
    if (v < 0) { v := 0 - v; }
    while (v > 0) { poke8(tmp+i, 48+(v%10)); v:=v/10; i:=i+1; }
    var j: int64 := 0;
    while (j < i) { poke8(buf+j, peek8(tmp+(i-1-j))); j:=j+1; }
    if (n < 0) { var k: int64 := i; while(k>0){poke8(buf+k,peek8(buf+k-1));k:=k-1;} poke8(buf,45); i:=i+1; }
    poke8(buf+i, 0); free(tmp, 24); return buf as pchar;
}

fn s3StrToInt(s: pchar): int64 {
    if (s == 0 as pchar) { return 0; }
    var n: int64 := 0; var i: int64 := 0;
    while ((peek8(s as int64 + i) & 0xFF) >= 48 && (peek8(s as int64 + i) & 0xFF) <= 57) {
        n := n * 10 + ((peek8(s as int64 + i) & 0xFF) - 48); i := i + 1;
    }
    return n;
}

fn s3StrEq(a: pchar, b: pchar): int64 {
    var i: int64 := 0;
    while ((peek8(a as int64+i)&0xFF) != 0 && (peek8(b as int64+i)&0xFF) != 0) {
        if ((peek8(a as int64+i)&0xFF) != (peek8(b as int64+i)&0xFF)) { return 0; }
        i += 1;
    }
    if ((peek8(a as int64+i)&0xFF) != (peek8(b as int64+i)&0xFF)) { return 0; }
    return 1;
}

fn s3Host(client: S3Client, bucket: pchar): int64 {
    if (client.endpoint != 0) { return client.endpoint; }
    return AWSS3Endpoint(bucket, client.region as pchar, client.pathStyle);
}

fn s3Path(client: S3Client, bucket: pchar, key: pchar): int64 {
    var buf: int64 := alloc(2048);
    var off: int64 := 0;
    if (client.pathStyle == 1) {
        poke8(buf, 47); off := 1;
        var bl: int64 := StrLen(bucket); var i: int64 := 0;
        while(i<bl){poke8(buf+off+i, StrCharAt(bucket,i)&0xFF);i:=i+1;} off:=off+bl;
        poke8(buf+off, 47); off:=off+1;
        var kl: int64 := StrLen(key); i:=0;
        while(i<kl){poke8(buf+off+i, StrCharAt(key,i)&0xFF);i:=i+1;} off:=off+kl;
    } else {
        poke8(buf, 47); off := 1;
        var kl2: int64 := StrLen(key); var i2: int64 := 0;
        while(i2<kl2){poke8(buf+off+i2, StrCharAt(key,i2)&0xFF);i2:=i2+1;} off:=off+kl2;
    }
    poke8(buf+off, 0);
    return buf;
}

fn s3HostIsOwned(client: S3Client): int64 {
    // Returns 1 if host was alloc'd by s3Host and must be freed
    if (client.endpoint != 0) { return 0; }
    return 1;
}

fn s3SetError(client: int64, resp: AWSResponse) {
    if (resp.errorCode != 0) {
        var old: int64 := peek64(client + 64); // lastError offset
        if (old != 0) { free(old, StrLen(old as pchar)+1); }
        poke64(client + 64, s3StrDup(resp.errorCode as pchar));
    }
    if (resp.errorMessage != 0) {
        var old2: int64 := peek64(client + 72); // lastErrMsg
        if (old2 != 0) { free(old2, StrLen(old2 as pchar)+1); }
        poke64(client + 72, s3StrDup(resp.errorMessage as pchar));
    }
    poke64(client + 56, resp.statusCode); // lastStatus
}

// ── Connection ────────────────────────────────────────────────────────────────

pub fn S3Connect(creds: AWSCreds, region: pchar): S3Client {
    var c: S3Client;
    c.creds      := creds;
    c.region     := region as int64;
    c.endpoint   := 0;
    c.pathStyle  := 0;
    c.useTLS     := 1;
    c.port       := 443;
    c.lastStatus := 0;
    c.lastError  := 0;
    c.lastErrMsg := 0;
    return c;
}

pub fn S3ConnectEndpoint(creds: AWSCreds, region: pchar,
                         endpoint: pchar, useTLS: int64, pathStyle: int64): S3Client {
    var c: S3Client;
    c.creds      := creds;
    c.region     := region   as int64;
    c.endpoint   := endpoint as int64;
    c.pathStyle  := pathStyle;
    c.useTLS     := useTLS;
    c.port       := 443;
    if (useTLS == 0) { c.port := 9000; }
    c.lastStatus := 0;
    c.lastError  := 0;
    c.lastErrMsg := 0;
    return c;
}

pub fn S3ConnectR2(accountId: pchar, accessKey: pchar, secretKey: pchar): S3Client {
    var ep: int64 := alloc(128);
    var off: int64 := s3Append(ep, 0, accountId);
    off := s3Append(ep, off, ".r2.cloudflarestorage.com"c);
    poke8(ep+off, 0);
    var creds: AWSCreds := AWSCredentialsStatic(accessKey, secretKey);
    var c: S3Client;
    c.creds      := creds;
    c.region     := "auto"c as int64;
    c.endpoint   := ep;
    c.pathStyle  := 0;
    c.useTLS     := 1;
    c.port       := 443;
    c.lastStatus := 0;
    c.lastError  := 0;
    c.lastErrMsg := 0;
    return c;
}

pub fn S3ConnectMinio(host: pchar, port: int64, accessKey: pchar, secretKey: pchar): S3Client {
    var ep: int64 := alloc(256);
    var off: int64 := s3Append(ep, 0, host);
    poke8(ep+off, 58); off := off+1; // ':'
    var pbuf: int64 := alloc(16);
    s3Int64ToStr(port, pbuf);
    off := s3Append(ep, off, pbuf as pchar);
    free(pbuf, 16);
    poke8(ep+off, 0);
    var creds: AWSCreds := AWSCredentialsStatic(accessKey, secretKey);
    var c: S3Client;
    c.creds      := creds;
    c.region     := "us-east-1"c as int64;
    c.endpoint   := ep;
    c.pathStyle  := 1;
    c.useTLS     := 0;
    c.port       := port;
    c.lastStatus := 0;
    c.lastError  := 0;
    c.lastErrMsg := 0;
    return c;
}

pub fn S3ConnectConfig(creds: AWSCreds, cfg: AWSServiceConfig): S3Client {
    var c: S3Client;
    c.creds      := creds;
    c.region     := cfg.region;
    c.endpoint   := cfg.endpoint;
    c.pathStyle  := 0;
    c.useTLS     := 1;
    c.port       := 443;
    c.lastStatus := 0;
    c.lastError  := 0;
    c.lastErrMsg := 0;
    return c;
}

pub fn S3Close(client: S3Client) {
    AWSCredentialsFree(client.creds);
    if (client.lastError  != 0) { free(client.lastError,  StrLen(client.lastError  as pchar)+1); }
    if (client.lastErrMsg != 0) { free(client.lastErrMsg, StrLen(client.lastErrMsg as pchar)+1); }
}

pub fn S3LastStatus(client: S3Client): int64 { return client.lastStatus; }
pub fn S3LastError(client: S3Client): pchar   { return client.lastErrMsg as pchar; }
pub fn S3LastErrorCode(client: S3Client): pchar { return client.lastError as pchar; }

// ── Bucket operations ─────────────────────────────────────────────────────────

pub fn S3BucketCreate(client: S3Client, bucket: pchar): int64 {
    var host: int64 := s3Host(client, bucket);
    var region: pchar := client.region as pchar;
    var body: int64 := 0; var bodyLen: int64 := 0;
    if (!s3StrEq(region, "us-east-1"c)) {
        var xml: pchar := "<CreateBucketConfiguration><LocationConstraint>"c;
        var xml2: pchar := "</LocationConstraint></CreateBucketConfiguration>"c;
        var rl: int64 := StrLen(region);
        bodyLen := StrLen(xml) + rl + StrLen(xml2);
        body := alloc(bodyLen+1);
        var p: int64 := body; var i: int64 := 0; var n: int64 := StrLen(xml);
        while(i<n){poke8(p+i,StrCharAt(xml,i)&0xFF);i:=i+1;} p:=p+n;
        i:=0; while(i<rl){poke8(p+i,StrCharAt(region,i)&0xFF);i:=i+1;} p:=p+rl;
        n:=StrLen(xml2); i:=0;
        while(i<n){poke8(p+i,StrCharAt(xml2,i)&0xFF);i:=i+1;} p:=p+n;
        poke8(p,0);
    }
    var path: int64 := s3Path(client, bucket, ""c);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "PUT"c, path as pchar, 0 as pchar, body, bodyLen, client.region as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 200 || resp.statusCode == 409) { ok := 1; } // 409 = already owned
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048);
    if (body != 0) { free(body, bodyLen+1); }
    return ok;
}

pub fn S3BucketDelete(client: S3Client, bucket: pchar): int64 {
    var host: int64 := s3Host(client, bucket);
    var path: int64 := s3Path(client, bucket, ""c);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "DELETE"c, path as pchar, 0 as pchar, 0, 0, client.region as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 204) { ok := 1; }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); return ok;
}

pub fn S3BucketExists(client: S3Client, bucket: pchar): int64 {
    var host: int64 := s3Host(client, bucket);
    var path: int64 := s3Path(client, bucket, ""c);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "HEAD"c, path as pchar, 0 as pchar, 0, 0, client.region as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 200) { ok := 1; }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); return ok;
}

pub fn S3ListBuckets(client: S3Client): S3BucketList {
    var host: int64 := s3Host(client, 0 as pchar);
    if (host == 0) { host := AWSS3Endpoint(0 as pchar, client.region as pchar, 0); }
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "GET"c, "/"c, 0 as pchar, 0, 0, client.region as pchar);
    var bl: S3BucketList; bl.count := 0; bl.names := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        var body: int64 := resp.body; var bodyLen: int64 := resp.bodyLen;
        // Count <Name> tags inside <Bucket> elements
        var count: int64 := 0;
        var names: int64 := alloc(200 * 8); // max 200 buckets
        var i: int64 := 0;
        while (i < bodyLen - 6) {
            // Look for <Name>
            if ((peek8(body+i)&0xFF)==60 && (peek8(body+i+1)&0xFF)==78 &&
                (peek8(body+i+2)&0xFF)==97 && (peek8(body+i+3)&0xFF)==109 &&
                (peek8(body+i+4)&0xFF)==101 && (peek8(body+i+5)&0xFF)==62) {
                // Found <Name>, extract until </Name>
                var vs: int64 := i + 6;
                var ve: int64 := vs;
                while (ve < bodyLen && (peek8(body+ve)&0xFF) != 60) { ve:=ve+1; }
                if (count < 200) {
                    poke64(names + count*8, s3StrDupN(body+vs, ve-vs));
                    count += 1;
                }
                i := ve;
            } else { i := i + 1; }
        }
        bl.count := count; bl.names := names;
    }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    return bl;
}

// ── Object operations ─────────────────────────────────────────────────────────

pub fn S3PutObject(client: S3Client, bucket: pchar, key: pchar,
                   data: int64, dataLen: int64, contentType: pchar): int64 {
    var host: int64 := s3Host(client, bucket);
    var path: int64 := s3Path(client, bucket, key);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "PUT"c, path as pchar, 0 as pchar, data, dataLen, client.region as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 200) { ok := 1; }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); return ok;
}

pub fn S3PutObjectFile(client: S3Client, bucket: pchar, key: pchar,
                       localPath: pchar, contentType: pchar): int64 {
    var fd: int64 := sys_open(localPath, 0, 0);
    if (fd < 0) { return 0; }
    var sz: int64 := FileSize(localPath);
    if (sz <= 0) { sys_close(fd); return 0; }
    var data: int64 := alloc(sz);
    sys_read(fd, data, sz);
    sys_close(fd);
    var ok: int64 := S3PutObject(client, bucket, key, data, sz, contentType);
    free(data, sz); return ok;
}

pub fn S3GetObject(client: S3Client, bucket: pchar, key: pchar): int64 {
    var host: int64 := s3Host(client, bucket);
    var path: int64 := s3Path(client, bucket, key);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "GET"c, path as pchar, 0 as pchar, 0, 0, client.region as pchar);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); return result;
}

pub fn S3GetObjectFile(client: S3Client, bucket: pchar, key: pchar, localPath: pchar): int64 {
    var data: int64 := S3GetObject(client, bucket, key);
    if (data == 0) { return 0; }
    var n: int64 := StrLen(data as pchar);
    var fd: int64 := sys_open(localPath, 65, 420); // O_CREAT|O_WRONLY, 0644
    if (fd < 0) { munmap(data, n+1); return 0; }
    sys_write(fd, data, n);
    sys_close(fd);
    munmap(data, n+1); return 1;
}

pub fn S3GetObjectRange(client: S3Client, bucket: pchar, key: pchar,
                        offset: int64, length: int64, outLen: int64): int64 {
    var host: int64 := s3Host(client, bucket);
    var path: int64 := s3Path(client, bucket, key);

    // Build "Range: bytes=<offset>-<offset+length-1>" header
    var rangeBuf: int64 := alloc(64);
    var ro: int64 := s3Append(rangeBuf, 0, "bytes="c);
    var nbuf: int64 := alloc(24);
    s3Int64ToStr(offset, nbuf); ro := s3Append(rangeBuf, ro, nbuf as pchar);
    poke8(rangeBuf+ro, 45); ro:=ro+1; // '-'
    s3Int64ToStr(offset+length-1, nbuf); ro := s3Append(rangeBuf, ro, nbuf as pchar);
    poke8(rangeBuf+ro, 0);
    free(nbuf, 24);

    var extraH: int64 := alloc(16); // 1 header × 16 bytes
    poke64(extraH,     "Range"c as int64);
    poke64(extraH + 8, rangeBuf);

    var resp: AWSResponse := AWSS3RequestExt(client.creds, host as pchar,
        "GET"c, path as pchar, 0 as pchar, 0, 0, client.region as pchar,
        extraH, 1);
    free(rangeBuf, 64); free(extraH, 16);
    var result: int64 := 0;
    if ((resp.statusCode == 200 || resp.statusCode == 206) && resp.body != 0) {
        if (outLen != 0) { poke64(outLen, resp.bodyLen); }
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); return result;
}

pub fn S3DeleteObject(client: S3Client, bucket: pchar, key: pchar): int64 {
    var host: int64 := s3Host(client, bucket);
    var path: int64 := s3Path(client, bucket, key);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "DELETE"c, path as pchar, 0 as pchar, 0, 0, client.region as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 204) { ok := 1; }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); return ok;
}

// S3DeleteObjects — Multi-Object Delete (POST /<bucket>?delete with XML body)
pub fn S3DeleteObjects(client: S3Client, bucket: pchar,
                       keys: int64, keyCount: int64): int64 {
    var host: int64 := s3Host(client, bucket);
    var xmlBuf: int64 := alloc(keyCount * 256 + 64);
    var off: int64 := s3Append(xmlBuf, 0, "<?xml version=\"1.0\" encoding=\"UTF-8\"?><Delete>"c);
    var i: int64 := 0;
    while (i < keyCount) {
        var k: pchar := peek64(keys + i * 8) as pchar;
        off := s3Append(xmlBuf, off, "<Object><Key>"c);
        off := s3Append(xmlBuf, off, k);
        off := s3Append(xmlBuf, off, "</Key></Object>"c);
        i += 1;
    }
    off := s3Append(xmlBuf, off, "</Delete>"c);
    poke8(xmlBuf+off, 0);

    var path: int64 := s3Path(client, bucket, ""c);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "POST"c, path as pchar, "delete"c, xmlBuf, off, client.region as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 200) { ok := 1; }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); free(xmlBuf, keyCount*256+64); return ok;
}

pub fn S3HeadObject(client: S3Client, bucket: pchar, key: pchar): S3ObjectMeta {
    var host: int64 := s3Host(client, bucket);
    var path: int64 := s3Path(client, bucket, key);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "HEAD"c, path as pchar, 0 as pchar, 0, 0, client.region as pchar);
    var meta: S3ObjectMeta;
    meta.key:=0; meta.etag:=0; meta.size:=0;
    meta.lastModified:=0; meta.contentType:=0; meta.versionId:=0;
    if (resp.statusCode == 200) {
        meta.key := s3StrDup(key);
        var etag: pchar := AWSResponseGetHeader(resp, "etag"c);
        var lm:   pchar := AWSResponseGetHeader(resp, "last-modified"c);
        var ct:   pchar := AWSResponseGetHeader(resp, "content-type"c);
        var cl:   pchar := AWSResponseGetHeader(resp, "content-length"c);
        var vid:  pchar := AWSResponseGetHeader(resp, "x-amz-version-id"c);
        if (etag != 0 as pchar) { meta.etag := s3StrDup(etag); }
        if (lm   != 0 as pchar) { meta.lastModified := s3StrDup(lm); }
        if (ct   != 0 as pchar) { meta.contentType  := s3StrDup(ct); }
        if (cl   != 0 as pchar) { meta.size := s3StrToInt(cl); }
        if (vid  != 0 as pchar) { meta.versionId := s3StrDup(vid); }
    }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); return meta;
}

pub fn S3ObjectExists(client: S3Client, bucket: pchar, key: pchar): int64 {
    var host: int64 := s3Host(client, bucket);
    var path: int64 := s3Path(client, bucket, key);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "HEAD"c, path as pchar, 0 as pchar, 0, 0, client.region as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 200) { ok := 1; }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); return ok;
}

pub fn S3CopyObject(client: S3Client,
                    srcBucket: pchar, srcKey: pchar,
                    dstBucket: pchar, dstKey: pchar): int64 {
    var host: int64 := s3Host(client, dstBucket);
    var path: int64 := s3Path(client, dstBucket, dstKey);

    // x-amz-copy-source: /srcBucket/srcKey
    var csBuf: int64 := alloc(512);
    poke8(csBuf, 47); // '/'
    var bl: int64 := StrLen(srcBucket); var i: int64 := 0;
    while(i<bl){poke8(csBuf+1+i, StrCharAt(srcBucket,i)&0xFF);i:=i+1;}
    poke8(csBuf+1+bl, 47);
    var kl: int64 := StrLen(srcKey); i:=0;
    while(i<kl){poke8(csBuf+2+bl+i, StrCharAt(srcKey,i)&0xFF);i:=i+1;}
    poke8(csBuf+2+bl+kl, 0);

    var extraH: int64 := alloc(16);
    poke64(extraH,     "x-amz-copy-source"c as int64);
    poke64(extraH + 8, csBuf);

    var resp: AWSResponse := AWSS3RequestExt(client.creds, host as pchar,
        "PUT"c, path as pchar, 0 as pchar, 0, 0, client.region as pchar,
        extraH, 1);
    free(csBuf, 512); free(extraH, 16);
    var ok: int64 := 0;
    if (resp.statusCode == 200) { ok := 1; }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); return ok;
}

pub fn S3GetObjectSize(client: S3Client, bucket: pchar, key: pchar): int64 {
    var meta: S3ObjectMeta := S3HeadObject(client, bucket, key);
    var sz: int64 := meta.size;
    S3ObjectMetaFree(meta); return sz;
}

pub fn S3GetETag(client: S3Client, bucket: pchar, key: pchar): int64 {
    var meta: S3ObjectMeta := S3HeadObject(client, bucket, key);
    var etag: int64 := meta.etag;
    meta.etag := 0; // transfer ownership
    S3ObjectMetaFree(meta); return etag;
}

// ── ListObjects ───────────────────────────────────────────────────────────────

fn s3ParseListXML(body: int64, bodyLen: int64): int64 {
    var list: int64 := s3ListAlloc(S3LIST_MAX_OBJECTS);
    var count: int64 := 0; var pc: int64 := 0;
    var i: int64 := 0;
    var prefixBase: int64 := list + (S3LIST_HDR + S3LIST_MAX_OBJECTS * S3LIST_OBJ) * 8;

    while (i < bodyLen - 4) {
        // Look for <Key>
        if ((peek8(body+i)&0xFF)==60 && (peek8(body+i+1)&0xFF)==75 &&
            (peek8(body+i+2)&0xFF)==101 && (peek8(body+i+3)&0xFF)==121 &&
            (peek8(body+i+4)&0xFF)==62) {
            var vs: int64 := i+5; var ve: int64 := vs;
            while (ve < bodyLen && (peek8(body+ve)&0xFF)!=60) { ve:=ve+1; }
            if (count < S3LIST_MAX_OBJECTS) {
                var base: int64 := s3ListObjBase(list, count);
                poke64(base, s3StrDupN(body+vs, ve-vs));
                i := ve;
            }
        }
        // <Size>
        else if ((peek8(body+i)&0xFF)==60 && (peek8(body+i+1)&0xFF)==83 &&
                 (peek8(body+i+2)&0xFF)==105 && (peek8(body+i+3)&0xFF)==122 &&
                 (peek8(body+i+4)&0xFF)==101 && (peek8(body+i+5)&0xFF)==62) {
            if (count > 0) {
                var vs2: int64 := i+6; var ve2: int64 := vs2;
                while (ve2 < bodyLen && (peek8(body+ve2)&0xFF)!=60) { ve2:=ve2+1; }
                var szStr: int64 := s3StrDupN(body+vs2, ve2-vs2);
                poke64(s3ListObjBase(list, count-1) + 8, s3StrToInt(szStr as pchar));
                free(szStr, ve2-vs2+1);
                i := ve2;
            }
        }
        // <ETag>
        else if ((peek8(body+i)&0xFF)==60 && (peek8(body+i+1)&0xFF)==69 &&
                 (peek8(body+i+2)&0xFF)==84 && (peek8(body+i+3)&0xFF)==97 &&
                 (peek8(body+i+4)&0xFF)==103 && (peek8(body+i+5)&0xFF)==62) {
            if (count > 0) {
                var vs3: int64 := i+6; var ve3: int64 := vs3;
                while (ve3 < bodyLen && (peek8(body+ve3)&0xFF)!=60) { ve3:=ve3+1; }
                poke64(s3ListObjBase(list, count-1) + 16, s3StrDupN(body+vs3, ve3-vs3));
                i := ve3;
            }
        }
        // <LastModified>
        else if ((peek8(body+i)&0xFF)==60 && (peek8(body+i+1)&0xFF)==76 &&
                 (peek8(body+i+2)&0xFF)==97 && (peek8(body+i+3)&0xFF)==115) {
            // "Last" — check full tag
            if (i+14 < bodyLen &&
                (peek8(body+i+4)&0xFF)==116 && (peek8(body+i+5)&0xFF)==77) {
                // <LastModified>
                var vs4: int64 := i+14; var ve4: int64 := vs4;
                while (ve4 < bodyLen && (peek8(body+ve4)&0xFF)!=60) { ve4:=ve4+1; }
                if (count > 0) {
                    poke64(s3ListObjBase(list, count-1) + 24, s3StrDupN(body+vs4, ve4-vs4));
                }
                i := ve4;
            }
        }
        // </Contents> — increment object count
        else if ((peek8(body+i)&0xFF)==60 && (peek8(body+i+1)&0xFF)==47 &&
                 (peek8(body+i+2)&0xFF)==67 && (peek8(body+i+3)&0xFF)==111 &&
                 (peek8(body+i+4)&0xFF)==110) { // </Con...
            if (i+10 < bodyLen && (peek8(body+i+5)&0xFF)==116 &&
                (peek8(body+i+9)&0xFF)==115) { // </Contents>
                count += 1;
            }
        }
        // <IsTruncated>true</IsTruncated>
        else if ((peek8(body+i)&0xFF)==60 && (peek8(body+i+1)&0xFF)==73 &&
                 (peek8(body+i+2)&0xFF)==115) { // <Is...
            if (i+14 < bodyLen) {
                var vs5: int64 := i+14; var ve5: int64 := vs5;
                while (ve5 < bodyLen && (peek8(body+ve5)&0xFF)!=60) { ve5:=ve5+1; }
                if (ve5-vs5 == 4 &&
                    (peek8(body+vs5)&0xFF)==116 && (peek8(body+vs5+1)&0xFF)==114 &&
                    (peek8(body+vs5+2)&0xFF)==117 && (peek8(body+vs5+3)&0xFF)==101) {
                    poke64(list+8, 1);
                }
                i := ve5;
            }
        }
        // <NextContinuationToken>
        else if ((peek8(body+i)&0xFF)==60 && (peek8(body+i+1)&0xFF)==78 &&
                 (peek8(body+i+2)&0xFF)==101 && (peek8(body+i+3)&0xFF)==120) {
            if (i+22 < bodyLen) {
                var vs6: int64 := i+22; var ve6: int64 := vs6;
                while (ve6 < bodyLen && (peek8(body+ve6)&0xFF)!=60) { ve6:=ve6+1; }
                if (peek64(list+16) != 0) { free(peek64(list+16), StrLen(peek64(list+16) as pchar)+1); }
                poke64(list+16, s3StrDupN(body+vs6, ve6-vs6));
                i := ve6;
            }
        }
        // <Prefix> inside <CommonPrefixes>
        else if ((peek8(body+i)&0xFF)==60 && (peek8(body+i+1)&0xFF)==80 &&
                 (peek8(body+i+2)&0xFF)==114 && (peek8(body+i+3)&0xFF)==101 &&
                 (peek8(body+i+4)&0xFF)==102 && (peek8(body+i+5)&0xFF)==105 &&
                 (peek8(body+i+6)&0xFF)==120 && (peek8(body+i+7)&0xFF)==62) {
            var vs7: int64 := i+8; var ve7: int64 := vs7;
            while (ve7 < bodyLen && (peek8(body+ve7)&0xFF)!=60) { ve7:=ve7+1; }
            if (pc < S3LIST_MAX_OBJECTS) {
                poke64(prefixBase + pc*8, s3StrDupN(body+vs7, ve7-vs7));
                pc += 1;
            }
            i := ve7;
        }
        else { i := i + 1; }
    }
    poke64(list, count);
    poke64(list+24, pc);
    return list;
}

pub fn S3ListObjects(client: S3Client, bucket: pchar, prefix: pchar, maxKeys: int64): int64 {
    var host: int64 := s3Host(client, bucket);
    var queryBuf: int64 := alloc(512); var qoff: int64 := 0;
    qoff := s3Append(queryBuf, qoff, "list-type=2"c);
    if (prefix != 0 as pchar && StrLen(prefix) > 0) {
        qoff := s3Append(queryBuf, qoff, "&prefix="c);
        qoff := s3Append(queryBuf, qoff, prefix);
    }
    if (maxKeys > 0) {
        qoff := s3Append(queryBuf, qoff, "&max-keys="c);
        var nbuf: int64 := alloc(24);
        s3Int64ToStr(maxKeys, nbuf);
        qoff := s3Append(queryBuf, qoff, nbuf as pchar);
        free(nbuf, 24);
    }
    poke8(queryBuf+qoff, 0);
    var path: int64 := s3Path(client, bucket, ""c);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "GET"c, path as pchar, queryBuf as pchar, 0, 0, client.region as pchar);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := s3ParseListXML(resp.body, resp.bodyLen);
    }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); free(queryBuf, 512); return result;
}

pub fn S3ListObjectsNext(client: S3Client, bucket: pchar, prefix: pchar,
                         maxKeys: int64, prevList: int64): int64 {
    if (prevList == 0) { return 0; }
    if (peek64(prevList+8) == 0) { return 0; } // not truncated
    var token: pchar := peek64(prevList+16) as pchar;
    if (token == 0 as pchar) { return 0; }

    var host: int64 := s3Host(client, bucket);
    var queryBuf: int64 := alloc(1024); var qoff: int64 := 0;
    qoff := s3Append(queryBuf, qoff, "list-type=2"c);
    if (prefix != 0 as pchar && StrLen(prefix) > 0) {
        qoff := s3Append(queryBuf, qoff, "&prefix="c);
        qoff := s3Append(queryBuf, qoff, prefix);
    }
    if (maxKeys > 0) {
        qoff := s3Append(queryBuf, qoff, "&max-keys="c);
        var nbuf: int64 := alloc(24);
        s3Int64ToStr(maxKeys, nbuf);
        qoff := s3Append(queryBuf, qoff, nbuf as pchar);
        free(nbuf, 24);
    }
    qoff := s3Append(queryBuf, qoff, "&continuation-token="c);
    qoff := s3Append(queryBuf, qoff, token);
    poke8(queryBuf+qoff, 0);
    var path: int64 := s3Path(client, bucket, ""c);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "GET"c, path as pchar, queryBuf as pchar, 0, 0, client.region as pchar);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := s3ParseListXML(resp.body, resp.bodyLen);
    }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); free(queryBuf, 1024); return result;
}

pub fn S3ListAll(client: S3Client, bucket: pchar, prefix: pchar): int64 {
    // Returns accumulated list of all objects across all pages
    var accBuf: int64 := s3ListAlloc(S3LIST_MAX_OBJECTS);
    var accCount: int64 := 0;

    var cur: int64 := S3ListObjects(client, bucket, prefix, 1000);
    while (cur != 0) {
        var n: int64 := peek64(cur);
        var i: int64 := 0;
        while (i < n && accCount < S3LIST_MAX_OBJECTS) {
            var srcBase: int64 := s3ListObjBase(cur, i);
            var dstBase: int64 := s3ListObjBase(accBuf, accCount);
            // Dup each field
            var kp: pchar := peek64(srcBase) as pchar;
            var ep: pchar := peek64(srcBase+16) as pchar;
            var mp: pchar := peek64(srcBase+24) as pchar;
            poke64(dstBase,    s3StrDup(kp));
            poke64(dstBase+8,  peek64(srcBase+8));
            poke64(dstBase+16, s3StrDup(ep));
            poke64(dstBase+24, s3StrDup(mp));
            poke64(dstBase+32, 0);
            accCount += 1;
            i += 1;
        }
        var cont: int64 := S3ListIsTruncated(cur);
        var next: int64 := 0;
        if (cont == 1) { next := S3ListObjectsNext(client, bucket, prefix, 1000, cur); }
        S3ListFree(cur);
        cur := next;
    }
    poke64(accBuf, accCount);
    return accBuf;
}

pub fn S3ListWithDelimiter(client: S3Client, bucket: pchar,
                           prefix: pchar, delimiter: pchar): int64 {
    var host: int64 := s3Host(client, bucket);
    var queryBuf: int64 := alloc(512); var qoff: int64 := 0;
    qoff := s3Append(queryBuf, qoff, "list-type=2&delimiter="c);
    qoff := s3Append(queryBuf, qoff, delimiter);
    if (prefix != 0 as pchar && StrLen(prefix) > 0) {
        qoff := s3Append(queryBuf, qoff, "&prefix="c);
        qoff := s3Append(queryBuf, qoff, prefix);
    }
    poke8(queryBuf+qoff, 0);
    var path: int64 := s3Path(client, bucket, ""c);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "GET"c, path as pchar, queryBuf as pchar, 0, 0, client.region as pchar);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := s3ParseListXML(resp.body, resp.bodyLen);
    }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); free(queryBuf, 512); return result;
}

// ── Multipart Upload ─────────────────────────────────────────────────────────

pub fn S3MultipartBegin(client: S3Client, bucket: pchar, key: pchar,
                         contentType: pchar): int64 {
    var host: int64 := s3Host(client, bucket);
    var path: int64 := s3Path(client, bucket, key);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "POST"c, path as pchar, "uploads"c, 0, 0, client.region as pchar);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := XMLFind(resp.body, resp.bodyLen, "UploadId"c);
    }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); return result;
}

pub fn S3MultipartUploadPart(client: S3Client, bucket: pchar, key: pchar,
                              uploadId: pchar, partNum: int64,
                              data: int64, dataLen: int64): int64 {
    var host: int64 := s3Host(client, bucket);
    var path: int64 := s3Path(client, bucket, key);
    var queryBuf: int64 := alloc(256); var qoff: int64 := 0;
    qoff := s3Append(queryBuf, qoff, "partNumber="c);
    var nbuf: int64 := alloc(24);
    s3Int64ToStr(partNum, nbuf); qoff := s3Append(queryBuf, qoff, nbuf as pchar);
    qoff := s3Append(queryBuf, qoff, "&uploadId="c);
    qoff := s3Append(queryBuf, qoff, uploadId);
    poke8(queryBuf+qoff, 0); free(nbuf, 24);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "PUT"c, path as pchar, queryBuf as pchar,
        data, dataLen, client.region as pchar);
    var etag: int64 := 0;
    if (resp.statusCode == 200) {
        var etagHdr: pchar := AWSResponseGetHeader(resp, "etag"c);
        if (etagHdr != 0 as pchar) { etag := s3StrDup(etagHdr); }
    }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); free(queryBuf, 256); return etag;
}

pub fn S3MultipartComplete(client: S3Client, bucket: pchar, key: pchar,
                            uploadId: pchar, etags: int64, etagCount: int64): int64 {
    var host: int64 := s3Host(client, bucket);
    var path: int64 := s3Path(client, bucket, key);
    var queryBuf: int64 := alloc(256); var qoff: int64 := 0;
    qoff := s3Append(queryBuf, qoff, "uploadId="c);
    qoff := s3Append(queryBuf, qoff, uploadId);
    poke8(queryBuf+qoff, 0);

    var xmlBuf: int64 := alloc(etagCount * 128 + 64);
    var xoff: int64 := s3Append(xmlBuf, 0, "<CompleteMultipartUpload>"c);
    var i: int64 := 1;
    while (i <= etagCount) {
        var etag: pchar := peek64(etags + (i-1) * 8) as pchar;
        xoff := s3Append(xmlBuf, xoff, "<Part><PartNumber>"c);
        var nbuf: int64 := alloc(24);
        s3Int64ToStr(i, nbuf);
        xoff := s3Append(xmlBuf, xoff, nbuf as pchar); free(nbuf, 24);
        xoff := s3Append(xmlBuf, xoff, "</PartNumber><ETag>"c);
        xoff := s3Append(xmlBuf, xoff, etag);
        xoff := s3Append(xmlBuf, xoff, "</ETag></Part>"c);
        i += 1;
    }
    xoff := s3Append(xmlBuf, xoff, "</CompleteMultipartUpload>"c);
    poke8(xmlBuf+xoff, 0);

    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "POST"c, path as pchar, queryBuf as pchar,
        xmlBuf, xoff, client.region as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 200) { ok := 1; }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); free(queryBuf, 256); free(xmlBuf, etagCount*128+64);
    return ok;
}

pub fn S3MultipartAbort(client: S3Client, bucket: pchar, key: pchar,
                         uploadId: pchar): int64 {
    var host: int64 := s3Host(client, bucket);
    var path: int64 := s3Path(client, bucket, key);
    var queryBuf: int64 := alloc(256); var qoff: int64 := 0;
    qoff := s3Append(queryBuf, qoff, "uploadId="c);
    qoff := s3Append(queryBuf, qoff, uploadId);
    poke8(queryBuf+qoff, 0);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
        "DELETE"c, path as pchar, queryBuf as pchar,
        0, 0, client.region as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 204) { ok := 1; }
    AWSResponseFree(resp);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    free(path, 2048); free(queryBuf, 256); return ok;
}

pub fn S3PutObjectMultipart(client: S3Client, bucket: pchar, key: pchar,
                             data: int64, dataLen: int64,
                             contentType: pchar, partSize: int64): int64 {
    // Use single PUT for small objects
    if (dataLen <= 5 * 1024 * 1024) {
        return S3PutObject(client, bucket, key, data, dataLen, contentType);
    }
    // Choose part size
    var ps: int64 := partSize;
    if (ps < 5 * 1024 * 1024) { ps := 16 * 1024 * 1024; } // min 5MB

    var uploadId: int64 := S3MultipartBegin(client, bucket, key, contentType);
    if (uploadId == 0) { return 0; }

    var maxParts: int64 := dataLen / ps + 2;
    var etags: int64 := alloc(maxParts * 8);
    var partCount: int64 := 0;
    var offset: int64 := 0;
    var ok: int64 := 1;

    while (offset < dataLen && ok == 1) {
        var chunk: int64 := ps;
        if (offset + chunk > dataLen) { chunk := dataLen - offset; }
        var etag: int64 := S3MultipartUploadPart(client, bucket, key,
            uploadId as pchar, partCount+1, data+offset, chunk);
        if (etag == 0) { ok := 0; }
        else { poke64(etags + partCount*8, etag); partCount := partCount+1; }
        offset += chunk;
    }

    if (ok == 1) {
        ok := S3MultipartComplete(client, bucket, key, uploadId as pchar, etags, partCount);
    } else {
        S3MultipartAbort(client, bucket, key, uploadId as pchar);
    }

    // Free etags
    var i: int64 := 0;
    while (i < partCount) {
        var e: int64 := peek64(etags + i*8);
        if (e != 0) { free(e, StrLen(e as pchar)+1); }
        i += 1;
    }
    free(etags, maxParts*8);
    free(uploadId, StrLen(uploadId as pchar)+1);
    return ok;
}

// ── Presigned URLs ────────────────────────────────────────────────────────────

fn s3Presign(client: S3Client, method: pchar, bucket: pchar, key: pchar,
             expiresSec: int64): int64 {
    var host: int64 := s3Host(client, bucket);
    var path: int64 := s3Path(client, bucket, key);

    var dateBuf: int64     := alloc(16);
    var dateTimeBuf: int64 := alloc(24);
    SigV4DateNow(dateBuf, dateTimeBuf);

    var ctx: AWSSignCtx;
    ctx.accessKey    := client.creds.accessKey;
    ctx.secretKey    := client.creds.secretKey;
    ctx.sessionToken := client.creds.sessionToken;
    ctx.method       := method as int64;
    ctx.host         := host;
    ctx.path         := path;
    ctx.query        := 0;
    ctx.body         := 0;
    ctx.bodyLen      := 0;
    ctx.service      := "s3"c as int64;
    ctx.region       := client.region;
    ctx.date         := dateBuf;
    ctx.dateTime     := dateTimeBuf;
    ctx.authHeader   := 0;
    var query: int64 := SigV4SignQuery(ctx as int64, expiresSec);

    var urlBuf: int64 := alloc(2048);
    var off: int64 := s3Append(urlBuf, 0, "https://"c);
    off := s3Append(urlBuf, off, host as pchar);
    off := s3Append(urlBuf, off, path as pchar);
    poke8(urlBuf+off, 63); off:=off+1; // '?'
    if (query != 0) {
        var ql: int64 := StrLen(query as pchar);
        var i: int64 := 0;
        while(i<ql){poke8(urlBuf+off+i, peek8(query+i));i:=i+1;} off:=off+ql;
        free(query, ql+1);
    }
    poke8(urlBuf+off, 0);
    var result: int64 := s3StrDupN(urlBuf, off);
    free(urlBuf, 2048);
    free(dateBuf, 16); free(dateTimeBuf, 24);
    free(path, 2048);
    if (s3HostIsOwned(client) == 1) { free(host, StrLen(host as pchar)+1); }
    return result;
}

pub fn S3PresignGet(client: S3Client, bucket: pchar, key: pchar, expiresSec: int64): int64 {
    return s3Presign(client, "GET"c, bucket, key, expiresSec);
}

pub fn S3PresignPut(client: S3Client, bucket: pchar, key: pchar, expiresSec: int64): int64 {
    return s3Presign(client, "PUT"c, bucket, key, expiresSec);
}

pub fn S3PresignDelete(client: S3Client, bucket: pchar, key: pchar, expiresSec: int64): int64 {
    return s3Presign(client, "DELETE"c, bucket, key, expiresSec);
}

pub fn S3PresignHead(client: S3Client, bucket: pchar, key: pchar, expiresSec: int64): int64 {
    return s3Presign(client, "HEAD"c, bucket, key, expiresSec);
}

// Legacy alias
pub fn S3PresignURL(client: S3Client, bucket: pchar, key: pchar, expiresSec: int64): int64 {
    return S3PresignGet(client, bucket, key, expiresSec);
}
