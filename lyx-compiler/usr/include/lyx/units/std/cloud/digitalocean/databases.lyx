    var tl: int64 := StrLen(ruleType);
    i:=0; while(i<tl){poke8(buf+lh+i,StrCharAt(ruleType,i)&0xFF);i:=i+1;}
    var s: pchar := "\",\"value\":\""c; var ls: int64 := StrLen(s);
    var off: int64 := lh + tl;
    i:=0; while(i<ls){poke8(buf+off+i,StrCharAt(s,i)&0xFF);i:=i+1;} off:=off+ls;
    var vl: int64 := StrLen(value);
    i:=0; while(i<vl){poke8(buf+off+i,StrCharAt(value,i)&0xFF);i:=i+1;} off:=off+vl;
    var t: pchar := "\"}]}"c; var lt: int64 := StrLen(t);
    i:=0; while(i<lt){poke8(buf+off+i,StrCharAt(t,i)&0xFF);i:=i+1;} off:=off+lt;
    poke8(buf+off,0);
    var bodyLen: int64 := off;
    var pathBuf: int64 := alloc(256);
