}

pub fn DatabaseWait(creds: DOCredentials, id: pchar): DODatabase {
    var maxAttempts: int64 := 120; // 10 minutes at 5s intervals
    var attempt: int64 := 0;
    var db: DODatabase;
    db.id := 0; db.name := 0; db.engine := 0; db.version := 0; db.status := 0;
    db.region := 0; db.size := 0; db.numNodes := 0; db.host := 0; db.port := 0;
    db.dbUser := 0; db.dbPassword := 0; db.dbName := 0;
    while (attempt < maxAttempts) {
        db := DatabaseGet(creds, id);
        if (db.status != 0) {
            var online: pchar := "online"c;
            var slen: int64 := StrLen(db.status as pchar);
            var olen: int64 := StrLen(online);
            if (slen == olen) {
                var isMatch: int64 := 1; var j: int64 := 0;
                while(j<slen){if(peek8(db.status+j)!=(StrCharAt(online,j)&0xFF)){isMatch:=0;break;}j:=j+1;}
                if (isMatch == 1) { return db; }
            }
        }
        DODatabaseFree(db);
        db.id := 0; db.name := 0; db.engine := 0; db.version := 0; db.status := 0;
        db.region := 0; db.size := 0; db.numNodes := 0; db.host := 0; db.port := 0;
        db.dbUser := 0; db.dbPassword := 0; db.dbName := 0;
        Sleep(5000);
        attempt += 1;
    }
    return db;
}

pub fn DatabaseResize(creds: DOCredentials, id: pchar,
                      size: pchar, numNodes: int64): int64 {
    var cl: DOClient := doClientDB(creds);
    var buf: int64 := alloc(256);
    var h: pchar := "{\"size\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(buf+i,StrCharAt(h,i)&0xFF);i:=i+1;}
    var sl: int64 := StrLen(size);
    i:=0; while(i<sl){poke8(buf+lh+i,StrCharAt(size,i)&0xFF);i:=i+1;}
    var s2: pchar := "\",\"num_nodes\":"c; var l2: int64 := StrLen(s2);
    var off: int64 := lh + sl;
    i:=0; while(i<l2){poke8(buf+off+i,StrCharAt(s2,i)&0xFF);i:=i+1;} off:=off+l2;
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(numNodes, numBuf);
    var nn: int64 := StrLen(numStr);
    i:=0; while(i<nn){poke8(buf+off+i,StrCharAt(numStr,i)&0xFF);i:=i+1;} off:=off+nn;
    free(numBuf, 24);
    poke8(buf+off,125); poke8(buf+off+1,0);
    var bodyLen: int64 := off + 1;
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/databases/"c, id, "/resize"c);
    var resp: HTTPResponse := DOPut(cl, pathBuf as pchar, buf, bodyLen);
    var ok: int64 := 0;
    if (resp.statusCode == 202) { ok := 1; }
    HTTPResponseFree(resp);
    free(buf, 256);
    free(pathBuf, 256);
    return ok;
}

pub fn DatabaseMigrate(creds: DOCredentials, id: pchar, region: pchar): int64 {
    var cl: DOClient := doClientDB(creds);
    var buf: int64 := alloc(256);
    var h: pchar := "{\"region\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(buf+i,StrCharAt(h,i)&0xFF);i:=i+1;}
    var rl: int64 := StrLen(region);
    i:=0; while(i<rl){poke8(buf+lh+i,StrCharAt(region,i)&0xFF);i:=i+1;}
    var t: pchar := "\"}"c; var lt: int64 := StrLen(t);
    var off: int64 := lh + rl;
    i:=0; while(i<lt){poke8(buf+off+i,StrCharAt(t,i)&0xFF);i:=i+1;}
    poke8(buf+off+lt,0);
    var bodyLen: int64 := off + lt;
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/databases/"c, id, "/migrate"c);
    var resp: HTTPResponse := DOPut(cl, pathBuf as pchar, buf, bodyLen);
    var ok: int64 := 0;
    if (resp.statusCode == 202) { ok := 1; }
    HTTPResponseFree(resp);
    free(buf, 256);
    free(pathBuf, 256);
    return ok;
}

// ============================================================================
// Connection details
// ============================================================================

pub fn DatabaseGetConnection(creds: DOCredentials, id: pchar): DODBConnection {
    var c: DODBConnection;
    c.uri := 0; c.database := 0; c.host := 0; c.port := 0; c.user := 0; c.password := 0; c.sslMode := 0;
    var cl: DOClient := doClientDB(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/databases/"c, id, "/ca"c);
    // Actually the connection is in the main cluster info
    // Use /v2/databases/<id> and extract connection field
    var pathBuf2: int64 := alloc(128);
    doMakePath(pathBuf2, "/v2/databases/"c, id);
    var resp: HTTPResponse := DOGet(cl, pathBuf2 as pchar);
    if (resp.statusCode == 200 && resp.bodyPtr != 0) {
        c.uri      := doJsonStr(resp.bodyPtr, "uri"c);
        c.database := doJsonStr(resp.bodyPtr, "database"c);
        c.host     := doJsonStr(resp.bodyPtr, "host"c);
        c.port     := doJsonInt(resp.bodyPtr, "port"c);
        c.user     := doJsonStr(resp.bodyPtr, "user"c);
        c.password := doJsonStr(resp.bodyPtr, "password"c);
        c.sslMode  := doJsonStr(resp.bodyPtr, "ssl_mode"c);
    }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    free(pathBuf2, 128);
    return c;
}

pub fn DatabaseGetConnectionPool(creds: DOCredentials, id: pchar, poolName: pchar): DODBConnection {
    var c: DODBConnection;
    c.uri := 0; c.database := 0; c.host := 0; c.port := 0; c.user := 0; c.password := 0; c.sslMode := 0;
    var cl: DOClient := doClientDB(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/databases/"c, id, "/pools/"c);
    var existLen: int64 := StrLen(pathBuf as pchar);
    var pl: int64 := StrLen(poolName);
    var i: int64 := 0;
    while(i<pl){poke8(pathBuf+existLen+i,StrCharAt(poolName,i)&0xFF);i:=i+1;}
    poke8(pathBuf+existLen+pl,0);
    var resp: HTTPResponse := DOGet(cl, pathBuf as pchar);
    if (resp.statusCode == 200 && resp.bodyPtr != 0) {
        c.uri      := doJsonStr(resp.bodyPtr, "uri"c);
        c.host     := doJsonStr(resp.bodyPtr, "host"c);
        c.port     := doJsonInt(resp.bodyPtr, "port"c);
        c.user     := doJsonStr(resp.bodyPtr, "user"c);
        c.password := doJsonStr(resp.bodyPtr, "password"c);
        c.database := doJsonStr(resp.bodyPtr, "db"c);
    }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return c;
}

