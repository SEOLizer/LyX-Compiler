pub fn DatabaseFirewallAdd(creds: DOCredentials, id: pchar,
                            ruleType: pchar, value: pchar): int64 {
    var cl: DOClient := doClientDB(creds);
    var buf: int64 := alloc(512);
    var h: pchar := "{\"rules\":[{\"type\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
