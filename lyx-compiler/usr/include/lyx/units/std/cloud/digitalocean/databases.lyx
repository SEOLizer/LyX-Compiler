// Cluster CRUD
// ============================================================================

pub fn DatabaseCreate(creds: DOCredentials,
                      name: pchar, engine: pchar, version: pchar,
                      region: pchar, size: pchar, numNodes: int64): DODatabase {
    var db: DODatabase;
    db.id := 0; db.name := 0; db.engine := 0; db.version := 0; db.status := 0;
    db.region := 0; db.size := 0; db.numNodes := 0; db.host := 0; db.port := 0;
    db.dbUser := 0; db.dbPassword := 0; db.dbName := 0;
    var buf: int64 := alloc(2048);
    var p: int64 := buf;
    var h: pchar := "{\"name\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(p+i,StrCharAt(h,i)&0xFF);i:=i+1;} p:=p+lh;
    var nl: int64 := StrLen(name);
    i:=0; while(i<nl){poke8(p+i,StrCharAt(name,i)&0xFF);i:=i+1;} p:=p+nl;
    var s1: pchar := "\",\"engine\":\""c; var l1: int64 := StrLen(s1);
    i:=0; while(i<l1){poke8(p+i,StrCharAt(s1,i)&0xFF);i:=i+1;} p:=p+l1;
    var el: int64 := StrLen(engine);
    i:=0; while(i<el){poke8(p+i,StrCharAt(engine,i)&0xFF);i:=i+1;} p:=p+el;
    var s2: pchar := "\",\"version\":\""c; var l2: int64 := StrLen(s2);
    i:=0; while(i<l2){poke8(p+i,StrCharAt(s2,i)&0xFF);i:=i+1;} p:=p+l2;
    var vl: int64 := StrLen(version);
    i:=0; while(i<vl){poke8(p+i,StrCharAt(version,i)&0xFF);i:=i+1;} p:=p+vl;
    var s3: pchar := "\",\"region\":\""c; var l3: int64 := StrLen(s3);
    i:=0; while(i<l3){poke8(p+i,StrCharAt(s3,i)&0xFF);i:=i+1;} p:=p+l3;
    var rl: int64 := StrLen(region);
    i:=0; while(i<rl){poke8(p+i,StrCharAt(region,i)&0xFF);i:=i+1;} p:=p+rl;
    var s4: pchar := "\",\"size\":\""c; var l4: int64 := StrLen(s4);
    i:=0; while(i<l4){poke8(p+i,StrCharAt(s4,i)&0xFF);i:=i+1;} p:=p+l4;
    var sl: int64 := StrLen(size);
    i:=0; while(i<sl){poke8(p+i,StrCharAt(size,i)&0xFF);i:=i+1;} p:=p+sl;
    var s5: pchar := "\",\"num_nodes\":"c; var l5: int64 := StrLen(s5);
    i:=0; while(i<l5){poke8(p+i,StrCharAt(s5,i)&0xFF);i:=i+1;} p:=p+l5;
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(numNodes, numBuf);
    var nn: int64 := StrLen(numStr);
    i:=0; while(i<nn){poke8(p+i,StrCharAt(numStr,i)&0xFF);i:=i+1;} p:=p+nn;
    free(numBuf, 24);
    poke8(p,125); p:=p+1; poke8(p,0); // '}'
    var bodyLen: int64 := p - buf;
    var cl: DOClient := doClientDB(creds);
    var path: pchar := "/v2/databases"c;
    var resp: HTTPResponse := DOPost(cl, path, buf, bodyLen);
    free(buf, 2048);
    if (resp.statusCode == 201 && resp.bodyPtr != 0) { db := parseDB(resp.bodyPtr); }
    HTTPResponseFree(resp);
    return db;
}

pub fn DatabaseDelete(creds: DOCredentials, id: pchar): int64 {
    var cl: DOClient := doClientDB(creds);
    var pathBuf: int64 := alloc(128);
    var base: pchar := "/v2/databases/"c;
    doMakePath(pathBuf, base, id);
    var resp: HTTPResponse := DODelete(cl, pathBuf as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 204) { ok := 1; }
    HTTPResponseFree(resp);
    free(pathBuf, 128);
    return ok;
}

