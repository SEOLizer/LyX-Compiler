// ============================================================================
// Connection Pools (PostgreSQL)
// ============================================================================

fn parsePool(json: int64): DODBPool {
    var p: DODBPool;
    p.name := doJsonStr(json, "name"c);
    p.mode := doJsonStr(json, "mode"c);
    p.size := doJsonInt(json, "size"c);
    p.db   := doJsonStr(json, "db"c);
    p.user := doJsonStr(json, "user"c);
    p.host := doJsonStr(json, "host"c);
    p.port := doJsonInt(json, "port"c);
    p.uri  := doJsonStr(json, "uri"c);
    return p;
}

pub fn DatabasePoolCreate(creds: DOCredentials, id: pchar,
                          name: pchar, mode: pchar, size: int64,
                          db: pchar, user: pchar): DODBPool {
    var poolRec: DODBPool;
    poolRec.name := 0; poolRec.mode := 0; poolRec.size := 0; poolRec.db := 0;
    poolRec.user := 0; poolRec.host := 0; poolRec.port := 0; poolRec.uri := 0;
    var buf: int64 := alloc(512);
    var p: int64 := buf;
    var h: pchar := "{\"name\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(p+i,StrCharAt(h,i)&0xFF);i:=i+1;} p:=p+lh;
    var nl: int64 := StrLen(name);
    i:=0; while(i<nl){poke8(p+i,StrCharAt(name,i)&0xFF);i:=i+1;} p:=p+nl;
    var s1: pchar := "\",\"mode\":\""c; var l1: int64 := StrLen(s1);
    i:=0; while(i<l1){poke8(p+i,StrCharAt(s1,i)&0xFF);i:=i+1;} p:=p+l1;
    var ml: int64 := StrLen(mode);
    i:=0; while(i<ml){poke8(p+i,StrCharAt(mode,i)&0xFF);i:=i+1;} p:=p+ml;
    var s2: pchar := "\",\"size\":"c; var l2: int64 := StrLen(s2);
    i:=0; while(i<l2){poke8(p+i,StrCharAt(s2,i)&0xFF);i:=i+1;} p:=p+l2;
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(size, numBuf);
    var nn: int64 := StrLen(numStr);
    i:=0; while(i<nn){poke8(p+i,StrCharAt(numStr,i)&0xFF);i:=i+1;} p:=p+nn;
    free(numBuf, 24);
    var s3: pchar := ",\"db\":\""c; var l3: int64 := StrLen(s3);
    i:=0; while(i<l3){poke8(p+i,StrCharAt(s3,i)&0xFF);i:=i+1;} p:=p+l3;
    var dl: int64 := StrLen(db);
    i:=0; while(i<dl){poke8(p+i,StrCharAt(db,i)&0xFF);i:=i+1;} p:=p+dl;
    var s4: pchar := "\",\"user\":\""c; var l4: int64 := StrLen(s4);
    i:=0; while(i<l4){poke8(p+i,StrCharAt(s4,i)&0xFF);i:=i+1;} p:=p+l4;
    var ul: int64 := StrLen(user);
    i:=0; while(i<ul){poke8(p+i,StrCharAt(user,i)&0xFF);i:=i+1;} p:=p+ul;
    var t: pchar := "\"}"c; var lt: int64 := StrLen(t);
    i:=0; while(i<lt){poke8(p+i,StrCharAt(t,i)&0xFF);i:=i+1;} p:=p+lt;
    poke8(p,0);
    var bodyLen: int64 := p - buf;
    var cl: DOClient := doClientDB(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/databases/"c, id, "/pools"c);
    var resp: HTTPResponse := DOPost(cl, pathBuf as int64 as pchar, buf, bodyLen);
    free(buf, 512);
    if (resp.statusCode == 201 && resp.bodyPtr != 0) { poolRec := parsePool(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return poolRec;
}

