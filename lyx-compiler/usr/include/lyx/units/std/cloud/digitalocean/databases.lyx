pub type DODatabase = struct {
    id:        int64;  // pchar UUID (alloc'd)
    name:      int64;  // pchar (alloc'd)
    engine:    int64;  // pchar (alloc'd)
    version:   int64;  // pchar (alloc'd)
    status:    int64;  // pchar: "creating","online","migrating" (alloc'd)
    region:    int64;  // pchar (alloc'd)
    size:      int64;  // pchar (alloc'd)
    numNodes:  int64;
    host:      int64;  // pchar (alloc'd)
    port:      int64;
    dbUser:    int64;  // pchar (alloc'd)
    dbPassword:int64;  // pchar (alloc'd)
    dbName:    int64;  // pchar (alloc'd)
};

pub fn DODatabaseFree(db: DODatabase) {
    if (db.id         != 0) { free(db.id,         StrLen(db.id         as pchar) + 1); }
    if (db.name       != 0) { free(db.name,        StrLen(db.name       as pchar) + 1); }
    if (db.engine     != 0) { free(db.engine,      StrLen(db.engine     as pchar) + 1); }
    if (db.version    != 0) { free(db.version,     StrLen(db.version    as pchar) + 1); }
    if (db.status     != 0) { free(db.status,      StrLen(db.status     as pchar) + 1); }
    if (db.region     != 0) { free(db.region,      StrLen(db.region     as pchar) + 1); }
    if (db.size       != 0) { free(db.size,        StrLen(db.size       as pchar) + 1); }
    if (db.host       != 0) { free(db.host,        StrLen(db.host       as pchar) + 1); }
    if (db.dbUser     != 0) { free(db.dbUser,      StrLen(db.dbUser     as pchar) + 1); }
    if (db.dbPassword != 0) { free(db.dbPassword,  StrLen(db.dbPassword as pchar) + 1); }
    if (db.dbName     != 0) { free(db.dbName,      StrLen(db.dbName     as pchar) + 1); }
}

pub type DODBConnection = struct {
    uri:      int64;  // pchar (alloc'd)
    database: int64;  // pchar (alloc'd)
    host:     int64;  // pchar (alloc'd)
    port:     int64;
    user:     int64;  // pchar (alloc'd)
    password: int64;  // pchar (alloc'd)
    sslMode:  int64;  // pchar (alloc'd)
};

pub fn DODBConnectionFree(c: DODBConnection) {
    if (c.uri      != 0) { free(c.uri,      StrLen(c.uri      as pchar) + 1); }
    if (c.database != 0) { free(c.database, StrLen(c.database as pchar) + 1); }
    if (c.host     != 0) { free(c.host,     StrLen(c.host     as pchar) + 1); }
    if (c.user     != 0) { free(c.user,     StrLen(c.user     as pchar) + 1); }
    if (c.password != 0) { free(c.password, StrLen(c.password as pchar) + 1); }
    if (c.sslMode  != 0) { free(c.sslMode,  StrLen(c.sslMode  as pchar) + 1); }
}

pub type DODBUser = struct {
    name:     int64;  // pchar (alloc'd)
    role:     int64;  // pchar (alloc'd)
    password: int64;  // pchar (alloc'd)
};

pub fn DODBUserFree(u: DODBUser) {
    if (u.name     != 0) { free(u.name,     StrLen(u.name     as pchar) + 1); }
    if (u.role     != 0) { free(u.role,     StrLen(u.role     as pchar) + 1); }
    if (u.password != 0) { free(u.password, StrLen(u.password as pchar) + 1); }
}

pub type DODBPool = struct {
    name:     int64;  // pchar (alloc'd)
    mode:     int64;  // pchar (alloc'd)
    size:     int64;
    db:       int64;  // pchar (alloc'd)
    user:     int64;  // pchar (alloc'd)
    host:     int64;  // pchar (alloc'd)
    port:     int64;
    uri:      int64;  // pchar (alloc'd)
};

pub fn DODBPoolFree(p: DODBPool) {
    if (p.name != 0) { free(p.name, StrLen(p.name as pchar) + 1); }
    if (p.mode != 0) { free(p.mode, StrLen(p.mode as pchar) + 1); }
    if (p.db   != 0) { free(p.db,   StrLen(p.db   as pchar) + 1); }
    if (p.user != 0) { free(p.user, StrLen(p.user as pchar) + 1); }
    if (p.host != 0) { free(p.host, StrLen(p.host as pchar) + 1); }
    if (p.uri  != 0) { free(p.uri,  StrLen(p.uri  as pchar) + 1); }
}

// ============================================================================
// Internal helpers
// ============================================================================

fn doClientDB(creds: DOCredentials): DOClient {
    var c: DOClient; c.token := creds.token; c.tokenLen := creds.tokenLen; return c;
}

fn parseDB(json: int64): DODatabase {
    var db: DODatabase;
    db.id         := doJsonStr(json, "id"c);
    db.name       := doJsonStr(json, "name"c);
    db.engine     := doJsonStr(json, "engine"c);
    db.version    := doJsonStr(json, "version"c);
    db.status     := doJsonStr(json, "status"c);
    db.region     := doJsonStr(json, "region"c);
    db.size       := doJsonStr(json, "size"c);
    db.numNodes   := doJsonInt(json, "num_nodes"c);
    db.host       := doJsonStr(json, "host"c);
    db.port       := doJsonInt(json, "port"c);
    db.dbUser     := doJsonStr(json, "user"c);
    db.dbPassword := doJsonStr(json, "password"c);
    db.dbName     := doJsonStr(json, "database"c);
    return db;
}

