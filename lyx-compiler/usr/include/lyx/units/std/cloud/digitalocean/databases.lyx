pub fn DatabaseUserCreate(creds: DOCredentials, id: pchar, username: pchar): DODBUser {
    var u: DODBUser; u.name := 0; u.role := 0; u.password := 0;
    var buf: int64 := alloc(256);
    var h: pchar := "{\"name\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(buf+i,StrCharAt(h,i)&0xFF);i:=i+1;}
    var ul: int64 := StrLen(username);
    i:=0; while(i<ul){poke8(buf+lh+i,StrCharAt(username,i)&0xFF);i:=i+1;}
    var t: pchar := "\"}"c; var lt: int64 := StrLen(t);
    var off: int64 := lh + ul;
    i:=0; while(i<lt){poke8(buf+off+i,StrCharAt(t,i)&0xFF);i:=i+1;}
    poke8(buf+off+lt,0);
    var bodyLen: int64 := off + lt;
    var cl: DOClient := doClientDB(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/databases/"c, id, "/users"c);
    var resp: HTTPResponse := DOPost(cl, pathBuf as pchar, buf, bodyLen);
    free(buf, 256);
    if (resp.statusCode == 201 && resp.bodyPtr != 0) { u := parseDBUser(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return u;
}

