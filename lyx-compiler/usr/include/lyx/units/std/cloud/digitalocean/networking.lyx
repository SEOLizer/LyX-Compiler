// ============================================================================
// Structs
// ============================================================================

pub type DODomain = struct {
    name:     int64;  // pchar (alloc'd)
    ttl:      int64;
    zoneFile: int64;  // pchar (alloc'd)
};

pub fn DODomainFree(d: DODomain) {
    if (d.name     != 0) { free(d.name,     StrLen(d.name     as pchar) + 1); }
    if (d.zoneFile != 0) { free(d.zoneFile, StrLen(d.zoneFile as pchar) + 1); }
}

pub type DODNSRecord = struct {
    id:       int64;
    recType:  int64;  // pchar: "A","AAAA","CNAME","MX","TXT","NS","SRV","CAA" (alloc'd)
    name:     int64;  // pchar (alloc'd)
    data:     int64;  // pchar (alloc'd)
    priority: int64;
    port:     int64;
    ttl:      int64;
    weight:   int64;
};

pub fn DODNSRecordFree(r: DODNSRecord) {
    if (r.recType != 0) { free(r.recType, StrLen(r.recType as pchar) + 1); }
    if (r.name    != 0) { free(r.name,    StrLen(r.name    as pchar) + 1); }
    if (r.data    != 0) { free(r.data,    StrLen(r.data    as pchar) + 1); }
}

pub type DOLoadBalancer = struct {
    id:        int64;  // pchar UUID (alloc'd)
    name:      int64;  // pchar (alloc'd)
    ip:        int64;  // pchar (alloc'd)
    status:    int64;  // pchar (alloc'd)
    region:    int64;  // pchar (alloc'd)
    algorithm: int64;  // pchar (alloc'd)
};

pub fn DOLoadBalancerFree(lb: DOLoadBalancer) {
    if (lb.id        != 0) { free(lb.id,        StrLen(lb.id        as pchar) + 1); }
    if (lb.name      != 0) { free(lb.name,       StrLen(lb.name      as pchar) + 1); }
    if (lb.ip        != 0) { free(lb.ip,         StrLen(lb.ip        as pchar) + 1); }
    if (lb.status    != 0) { free(lb.status,     StrLen(lb.status    as pchar) + 1); }
    if (lb.region    != 0) { free(lb.region,     StrLen(lb.region    as pchar) + 1); }
    if (lb.algorithm != 0) { free(lb.algorithm,  StrLen(lb.algorithm as pchar) + 1); }
}

pub type DOFloatingIP = struct {
    ip:        int64;  // pchar (alloc'd)
    region:    int64;  // pchar (alloc'd)
    dropletId: int64;
