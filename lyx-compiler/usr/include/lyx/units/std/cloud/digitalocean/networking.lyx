// ============================================================================
// Internal helper
// ============================================================================

fn doClientNet(creds: DOCredentials): DOClient {
    var c: DOClient;
    c.token    := creds.token;
    c.tokenLen := creds.tokenLen;
    return c;
}

fn netStrDup(json: int64, key: pchar): int64 {
    return doJsonStr(json, key);
}

// ============================================================================
// DNS: Domains
// ============================================================================

pub fn DomainCreate(creds: DOCredentials, name: pchar, ipAddress: pchar): DODomain {
    var d: DODomain; d.name := 0; d.ttl := 0; d.zoneFile := 0;
    var buf: int64 := alloc(512);
    var p: int64 := buf;
    var h: pchar := "{\"name\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while (i < lh) { poke8(p+i, StrCharAt(h,i)&0xFF); i:=i+1; } p:=p+lh;
    var nl: int64 := StrLen(name);
    i:=0; while (i<nl) { poke8(p+i, StrCharAt(name,i)&0xFF); i:=i+1; } p:=p+nl;
    var s: pchar := "\",\"ip_address\":\""c; var ls: int64 := StrLen(s);
    i:=0; while (i<ls) { poke8(p+i, StrCharAt(s,i)&0xFF); i:=i+1; } p:=p+ls;
    var il: int64 := StrLen(ipAddress);
    i:=0; while (i<il) { poke8(p+i, StrCharAt(ipAddress,i)&0xFF); i:=i+1; } p:=p+il;
    var t: pchar := "\"}"c; var lt: int64 := StrLen(t);
    i:=0; while (i<lt) { poke8(p+i, StrCharAt(t,i)&0xFF); i:=i+1; } p:=p+lt;
    poke8(p,0);
    var bodyLen: int64 := p - buf;
    var c: DOClient := doClientNet(creds);
    var path: pchar := "/v2/domains"c;
    var resp: HTTPResponse := DOPost(c, path, buf, bodyLen);
    free(buf, 512);
    if (resp.statusCode == 201 && resp.bodyPtr != 0) {
        d.name    := netStrDup(resp.bodyPtr, "name"c);
        d.ttl     := doJsonInt(resp.bodyPtr, "ttl"c);
        d.zoneFile:= netStrDup(resp.bodyPtr, "zone_file"c);
    }
    HTTPResponseFree(resp);
    return d;
}

pub fn DomainDelete(creds: DOCredentials, name: pchar): int64 {
    var c: DOClient := doClientNet(creds);
    var pathBuf: int64 := alloc(256);
    var base: pchar := "/v2/domains/"c;
    doMakePath(pathBuf, base, name);
    var resp: HTTPResponse := DODelete(c, pathBuf as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 204) { ok := 1; }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return ok;
}

pub fn DomainGet(creds: DOCredentials, name: pchar): DODomain {
    var d: DODomain; d.name := 0; d.ttl := 0; d.zoneFile := 0;
    var c: DOClient := doClientNet(creds);
    var pathBuf: int64 := alloc(256);
    var base: pchar := "/v2/domains/"c;
    doMakePath(pathBuf, base, name);
    var resp: HTTPResponse := DOGet(c, pathBuf as pchar);
    if (resp.statusCode == 200 && resp.bodyPtr != 0) {
        d.name     := netStrDup(resp.bodyPtr, "name"c);
        d.ttl      := doJsonInt(resp.bodyPtr, "ttl"c);
        d.zoneFile := netStrDup(resp.bodyPtr, "zone_file"c);
    }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return d;
}

pub fn DomainList(creds: DOCredentials): int64 {
    var c: DOClient := doClientNet(creds);
    var path: pchar := "/v2/domains"c;
    return DOGetAll(c, path, "domains"c);
}

// ============================================================================
// DNS: Records
// ============================================================================

fn parseDNSRecord(json: int64): DODNSRecord {
    var r: DODNSRecord;
    r.id       := doJsonInt(json, "id"c);
    r.recType  := netStrDup(json, "type"c);
    r.name     := netStrDup(json, "name"c);
    r.data     := netStrDup(json, "data"c);
    r.priority := doJsonInt(json, "priority"c);
    r.port     := doJsonInt(json, "port"c);
    r.ttl      := doJsonInt(json, "ttl"c);
    r.weight   := doJsonInt(json, "weight"c);
    return r;
}

pub fn DomainRecordCreate(creds: DOCredentials, domain: pchar,
                          recType: pchar, name: pchar,
                          data: pchar, ttl: int64): DODNSRecord {
    var rec: DODNSRecord;
    rec.id := 0; rec.recType := 0; rec.name := 0; rec.data := 0;
    rec.priority := 0; rec.port := 0; rec.ttl := 0; rec.weight := 0;
    var buf: int64 := alloc(1024);
    var p: int64 := buf;
    var h: pchar := "{\"type\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while (i<lh) { poke8(p+i,StrCharAt(h,i)&0xFF); i:=i+1; } p:=p+lh;
    var tl: int64 := StrLen(recType);
    i:=0; while(i<tl){poke8(p+i,StrCharAt(recType,i)&0xFF);i:=i+1;} p:=p+tl;
    var s1: pchar := "\",\"name\":\""c; var l1: int64 := StrLen(s1);
    i:=0; while(i<l1){poke8(p+i,StrCharAt(s1,i)&0xFF);i:=i+1;} p:=p+l1;
    var nl: int64 := StrLen(name);
    i:=0; while(i<nl){poke8(p+i,StrCharAt(name,i)&0xFF);i:=i+1;} p:=p+nl;
    var s2: pchar := "\",\"data\":\""c; var l2: int64 := StrLen(s2);
    i:=0; while(i<l2){poke8(p+i,StrCharAt(s2,i)&0xFF);i:=i+1;} p:=p+l2;
    var dl: int64 := StrLen(data);
    i:=0; while(i<dl){poke8(p+i,StrCharAt(data,i)&0xFF);i:=i+1;} p:=p+dl;
    var s3: pchar := "\",\"ttl\":"c; var l3: int64 := StrLen(s3);
    i:=0; while(i<l3){poke8(p+i,StrCharAt(s3,i)&0xFF);i:=i+1;} p:=p+l3;
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(ttl, numBuf);
    var nn: int64 := StrLen(numStr);
    i:=0; while(i<nn){poke8(p+i,StrCharAt(numStr,i)&0xFF);i:=i+1;} p:=p+nn;
    free(numBuf, 24);
    poke8(p,125); p:=p+1; poke8(p,0); // '}'
    var bodyLen: int64 := p - buf;
    var cl: DOClient := doClientNet(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/domains/"c, domain, "/records"c);
    var resp: HTTPResponse := DOPost(cl, pathBuf as pchar, buf, bodyLen);
    free(buf, 1024);
    if (resp.statusCode == 201 && resp.bodyPtr != 0) { rec := parseDNSRecord(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return rec;
}

pub fn DomainRecordUpdate(creds: DOCredentials, domain: pchar,
                          id: int64, data: pchar, ttl: int64): DODNSRecord {
    var rec: DODNSRecord;
    rec.id := 0; rec.recType := 0; rec.name := 0; rec.data := 0;
    rec.priority := 0; rec.port := 0; rec.ttl := 0; rec.weight := 0;
    var buf: int64 := alloc(512);
    var p: int64 := buf;
    var h: pchar := "{\"data\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(p+i,StrCharAt(h,i)&0xFF);i:=i+1;} p:=p+lh;
    var dl: int64 := StrLen(data);
    i:=0; while(i<dl){poke8(p+i,StrCharAt(data,i)&0xFF);i:=i+1;} p:=p+dl;
    var t: pchar := "\"}"c; var lt: int64 := StrLen(t);
    i:=0; while(i<lt){poke8(p+i,StrCharAt(t,i)&0xFF);i:=i+1;} p:=p+lt;
    poke8(p,0);
    var bodyLen: int64 := p - buf;
    var cl: DOClient := doClientNet(creds);
    var pathBuf: int64 := alloc(256);
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(id, numBuf);
    doMakePath3(pathBuf, "/v2/domains/"c, domain, "/records/"c);
    var existLen: int64 := StrLen(pathBuf as pchar);
    var nn: int64 := StrLen(numStr);
    i:=0; while(i<nn){poke8(pathBuf+existLen+i,StrCharAt(numStr,i)&0xFF);i:=i+1;}
    poke8(pathBuf+existLen+nn,0);
    free(numBuf, 24);
    var resp: HTTPResponse := DOPut(cl, pathBuf as pchar, buf, bodyLen);
    free(buf, 512);
    if (resp.statusCode == 200 && resp.bodyPtr != 0) { rec := parseDNSRecord(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return rec;
}

