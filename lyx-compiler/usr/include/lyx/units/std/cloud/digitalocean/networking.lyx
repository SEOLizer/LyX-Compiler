fn parseVPC(json: int64): DOVPC {
    var v: DOVPC;
    v.id        := netStrDup(json, "id"c);
    v.name      := netStrDup(json, "name"c);
    v.region    := netStrDup(json, "region_slug"c);
    v.ipRange   := netStrDup(json, "ip_range"c);
    v.isDefault := doJsonBool(json, "default"c);
    return v;
}

pub fn VPCCreate(creds: DOCredentials, name: pchar, region: pchar, ipRange: pchar): DOVPC {
    var v: DOVPC; v.id := 0; v.name := 0; v.region := 0; v.ipRange := 0; v.isDefault := 0;
    var buf: int64 := alloc(512);
    var p: int64 := buf;
    var h: pchar := "{\"name\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(p+i,StrCharAt(h,i)&0xFF);i:=i+1;} p:=p+lh;
    var nl: int64 := StrLen(name);
    i:=0; while(i<nl){poke8(p+i,StrCharAt(name,i)&0xFF);i:=i+1;} p:=p+nl;
    var s1: pchar := "\",\"region\":\""c; var l1: int64 := StrLen(s1);
    i:=0; while(i<l1){poke8(p+i,StrCharAt(s1,i)&0xFF);i:=i+1;} p:=p+l1;
    var rl: int64 := StrLen(region);
    i:=0; while(i<rl){poke8(p+i,StrCharAt(region,i)&0xFF);i:=i+1;} p:=p+rl;
    var s2: pchar := "\",\"ip_range\":\""c; var l2: int64 := StrLen(s2);
    i:=0; while(i<l2){poke8(p+i,StrCharAt(s2,i)&0xFF);i:=i+1;} p:=p+l2;
    var il: int64 := StrLen(ipRange);
    i:=0; while(i<il){poke8(p+i,StrCharAt(ipRange,i)&0xFF);i:=i+1;} p:=p+il;
    var t: pchar := "\"}"c; var lt: int64 := StrLen(t);
    i:=0; while(i<lt){poke8(p+i,StrCharAt(t,i)&0xFF);i:=i+1;} p:=p+lt;
    poke8(p,0);
    var bodyLen: int64 := p - buf;
    var cl: DOClient := doClientNet(creds);
    var path: pchar := "/v2/vpcs"c;
    var resp: HTTPResponse := DOPost(cl, path, buf, bodyLen);
    free(buf, 512);
    if (resp.statusCode == 201 && resp.bodyPtr != 0) { v := parseVPC(resp.bodyPtr); }
    HTTPResponseFree(resp);
    return v;
}

