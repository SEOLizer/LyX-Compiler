fn parseLB(json: int64): DOLoadBalancer {
    var lb: DOLoadBalancer;
    lb.id        := netStrDup(json, "id"c);
    lb.name      := netStrDup(json, "name"c);
    lb.ip        := netStrDup(json, "ip"c);
    lb.status    := netStrDup(json, "status"c);
    lb.region    := netStrDup(json, "slug"c);
    lb.algorithm := netStrDup(json, "algorithm"c);
    return lb;
}

pub fn LBCreate(creds: DOCredentials,
                name: pchar, region: pchar,
                dropletIds: int64, dropletCount: int64): DOLoadBalancer {
    var lb: DOLoadBalancer;
    lb.id := 0; lb.name := 0; lb.ip := 0; lb.status := 0; lb.region := 0; lb.algorithm := 0;
    var buf: int64 := alloc(2048);
    var p: int64 := buf;
    var h: pchar := "{\"name\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(p+i,StrCharAt(h,i)&0xFF);i:=i+1;} p:=p+lh;
    var nl: int64 := StrLen(name);
    i:=0; while(i<nl){poke8(p+i,StrCharAt(name,i)&0xFF);i:=i+1;} p:=p+nl;
    var s1: pchar := "\",\"region\":\""c; var l1: int64 := StrLen(s1);
    i:=0; while(i<l1){poke8(p+i,StrCharAt(s1,i)&0xFF);i:=i+1;} p:=p+l1;
    var rl: int64 := StrLen(region);
    i:=0; while(i<rl){poke8(p+i,StrCharAt(region,i)&0xFF);i:=i+1;} p:=p+rl;
    var s2: pchar := "\",\"forwarding_rules\":[{\"entry_protocol\":\"http\",\"entry_port\":80,\"target_protocol\":\"http\",\"target_port\":80}]}"c;
    var l2: int64 := StrLen(s2);
    i:=0; while(i<l2){poke8(p+i,StrCharAt(s2,i)&0xFF);i:=i+1;} p:=p+l2;
    poke8(p,0);
    var bodyLen: int64 := p - buf;
    var cl: DOClient := doClientNet(creds);
    var path: pchar := "/v2/load_balancers"c;
    var resp: HTTPResponse := DOPost(cl, path, buf, bodyLen);
    free(buf, 2048);
    if ((resp.statusCode == 200 || resp.statusCode == 202) && resp.bodyPtr != 0) {
        lb := parseLB(resp.bodyPtr);
    }
    HTTPResponseFree(resp);
    return lb;
}

