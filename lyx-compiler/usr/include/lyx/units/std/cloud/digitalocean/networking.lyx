    i:=0; while(i<nn){poke8(buf+lh+i,StrCharAt(numStr,i)&0xFF);i:=i+1;}
    free(numBuf, 24);
    poke8(buf+lh+nn,125); poke8(buf+lh+nn+1,0); // '}'
    var bodyLen: int64 := lh + nn + 1;
    var pathBuf: int64 := alloc(128);
    var base: pchar := "/v2/floating_ips/"c;
    var sub: pchar := "/actions"c;
