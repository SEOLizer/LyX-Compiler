// ============================================================================
// Floating IPs
// ============================================================================

fn parseFloatingIP(json: int64): DOFloatingIP {
    var f: DOFloatingIP;
    f.ip        := netStrDup(json, "ip"c);
    f.region    := netStrDup(json, "slug"c);
    f.dropletId := doJsonInt(json, "id"c);
    return f;
}

pub fn FloatingIPCreate(creds: DOCredentials, region: pchar): DOFloatingIP {
    var f: DOFloatingIP; f.ip := 0; f.region := 0; f.dropletId := 0;
    var buf: int64 := alloc(256);
    var h: pchar := "{\"region\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(buf+i,StrCharAt(h,i)&0xFF);i:=i+1;}
    var rl: int64 := StrLen(region);
    i:=0; while(i<rl){poke8(buf+lh+i,StrCharAt(region,i)&0xFF);i:=i+1;}
    var t: pchar := "\"}"c; var lt: int64 := StrLen(t);
    var off: int64 := lh + rl;
    i:=0; while(i<lt){poke8(buf+off+i,StrCharAt(t,i)&0xFF);i:=i+1;}
    poke8(buf+off+lt,0);
    var bodyLen: int64 := off + lt;
    var cl: DOClient := doClientNet(creds);
    var path: pchar := "/v2/floating_ips"c;
    var resp: HTTPResponse := DOPost(cl, path, buf, bodyLen);
    free(buf, 256);
    if (resp.statusCode == 202 && resp.bodyPtr != 0) { f := parseFloatingIP(resp.bodyPtr); }
    HTTPResponseFree(resp);
    return f;
}

pub fn FloatingIPDelete(creds: DOCredentials, ip: pchar): int64 {
    var cl: DOClient := doClientNet(creds);
    var pathBuf: int64 := alloc(128);
    var base: pchar := "/v2/floating_ips/"c;
    doMakePath(pathBuf, base, ip);
    var resp: HTTPResponse := DODelete(cl, pathBuf as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 204) { ok := 1; }
    HTTPResponseFree(resp);
    free(pathBuf, 128);
    return ok;
}

pub fn FloatingIPAssign(creds: DOCredentials, ip: pchar, dropletId: int64): int64 {
    var cl: DOClient := doClientNet(creds);
    var buf: int64 := alloc(256);
    var h: pchar := "{\"type\":\"assign\",\"droplet_id\":"c;
    var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(buf+i,StrCharAt(h,i)&0xFF);i:=i+1;}
