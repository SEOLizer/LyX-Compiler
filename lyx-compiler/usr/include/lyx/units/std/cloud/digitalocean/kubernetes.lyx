pub fn K8sNodeRecycle(creds: DOCredentials, clusterId: pchar,
                      poolId: pchar, nodeId: pchar): int64 {
    var cl: DOClient := doClientK8s(creds);
    var buf: int64 := alloc(256);
    var h: pchar := "{\"nodes\":[\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(buf+i,StrCharAt(h,i)&0xFF);i:=i+1;}
    var nl: int64 := StrLen(nodeId);
    i:=0; while(i<nl){poke8(buf+lh+i,StrCharAt(nodeId,i)&0xFF);i:=i+1;}
    var t: pchar := "\"]}"c; var lt: int64 := StrLen(t);
    var off: int64 := lh + nl;
    i:=0; while(i<lt){poke8(buf+off+i,StrCharAt(t,i)&0xFF);i:=i+1;}
    poke8(buf+off+lt,0);
    var bodyLen: int64 := off + lt;
    var pathBuf: int64 := alloc(512);
    doMakePath3(pathBuf, "/v2/kubernetes/clusters/"c, clusterId, "/node_pools/"c);
    var existLen: int64 := StrLen(pathBuf as pchar);
    var pl: int64 := StrLen(poolId);
    i:=0; while(i<pl){poke8(pathBuf+existLen+i,StrCharAt(poolId,i)&0xFF);i:=i+1;}
    var sfx: pchar := "/recycle"c; var sl: int64 := StrLen(sfx);
    i:=0; while(i<sl){poke8(pathBuf+existLen+pl+i,StrCharAt(sfx,i)&0xFF);i:=i+1;}
    poke8(pathBuf+existLen+pl+sl,0);
    var resp: HTTPResponse := DOPost(cl, pathBuf as pchar, buf, bodyLen);
    var ok: int64 := 0;
    if (resp.statusCode == 202) { ok := 1; }
    HTTPResponseFree(resp);
    free(buf, 256);
    free(pathBuf, 512);
    return ok;
}

pub fn K8sNodeDelete(creds: DOCredentials, clusterId: pchar,
                     poolId: pchar, nodeId: pchar): int64 {
    var cl: DOClient := doClientK8s(creds);
