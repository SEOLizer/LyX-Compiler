pub type DOK8sCluster = struct {
    id:       int64;  // pchar UUID (alloc'd)
    name:     int64;  // pchar (alloc'd)
    region:   int64;  // pchar (alloc'd)
    version:  int64;  // pchar (alloc'd)
    status:   int64;  // pchar: "provisioning","running","degraded","error","deleted" (alloc'd)
    endpoint: int64;  // pchar (alloc'd)
    ipv4:     int64;  // pchar (alloc'd)
};

pub fn DOK8sClusterFree(c: DOK8sCluster) {
    if (c.id       != 0) { free(c.id,       StrLen(c.id       as pchar) + 1); }
    if (c.name     != 0) { free(c.name,      StrLen(c.name     as pchar) + 1); }
    if (c.region   != 0) { free(c.region,   StrLen(c.region   as pchar) + 1); }
    if (c.version  != 0) { free(c.version,  StrLen(c.version  as pchar) + 1); }
    if (c.status   != 0) { free(c.status,   StrLen(c.status   as pchar) + 1); }
    if (c.endpoint != 0) { free(c.endpoint, StrLen(c.endpoint as pchar) + 1); }
    if (c.ipv4     != 0) { free(c.ipv4,     StrLen(c.ipv4     as pchar) + 1); }
}

pub type DOK8sNodePool = struct {
    id:        int64;  // pchar (alloc'd)
    name:      int64;  // pchar (alloc'd)
    size:      int64;  // pchar (alloc'd)
    count:     int64;
    autoScale: int64;
    minNodes:  int64;
    maxNodes:  int64;
};

pub fn DOK8sNodePoolFree(p: DOK8sNodePool) {
    if (p.id   != 0) { free(p.id,   StrLen(p.id   as pchar) + 1); }
    if (p.name != 0) { free(p.name, StrLen(p.name as pchar) + 1); }
    if (p.size != 0) { free(p.size, StrLen(p.size as pchar) + 1); }
}

fn doClientK8s(creds: DOCredentials): DOClient {
    var c: DOClient; c.token := creds.token; c.tokenLen := creds.tokenLen; return c;
}

fn parseK8sCluster(json: int64): DOK8sCluster {
    var c: DOK8sCluster;
    c.id       := doJsonStr(json, "id"c);
    c.name     := doJsonStr(json, "name"c);
    c.region   := doJsonStr(json, "region"c);
    c.version  := doJsonStr(json, "version"c);
    c.status   := doJsonStr(json, "state"c);
    c.endpoint := doJsonStr(json, "endpoint"c);
    c.ipv4     := doJsonStr(json, "ipv4"c);
    return c;
}

fn parseNodePool(json: int64): DOK8sNodePool {
    var p: DOK8sNodePool;
    p.id        := doJsonStr(json, "id"c);
    p.name      := doJsonStr(json, "name"c);
    p.size      := doJsonStr(json, "size"c);
    p.count     := doJsonInt(json, "count"c);
    p.autoScale := doJsonBool(json, "auto_scale"c);
    p.minNodes  := doJsonInt(json, "min_nodes"c);
    p.maxNodes  := doJsonInt(json, "max_nodes"c);
    return p;
}

pub fn K8sClusterCreate(creds: DOCredentials,
                        name: pchar, region: pchar, version: pchar,
                        nodeSize: pchar, nodeCount: int64): DOK8sCluster {
    var cl2: DOK8sCluster;
    cl2.id := 0; cl2.name := 0; cl2.region := 0; cl2.version := 0;
    cl2.status := 0; cl2.endpoint := 0; cl2.ipv4 := 0;
    var buf: int64 := alloc(2048);
    var p: int64 := buf;
    var h: pchar := "{\"name\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(p+i,StrCharAt(h,i)&0xFF);i:=i+1;} p:=p+lh;
    var nl: int64 := StrLen(name);
    i:=0; while(i<nl){poke8(p+i,StrCharAt(name,i)&0xFF);i:=i+1;} p:=p+nl;
    var s1: pchar := "\",\"region\":\""c; var l1: int64 := StrLen(s1);
    i:=0; while(i<l1){poke8(p+i,StrCharAt(s1,i)&0xFF);i:=i+1;} p:=p+l1;
    var rl: int64 := StrLen(region);
    i:=0; while(i<rl){poke8(p+i,StrCharAt(region,i)&0xFF);i:=i+1;} p:=p+rl;
    var s2: pchar := "\",\"version\":\""c; var l2: int64 := StrLen(s2);
    i:=0; while(i<l2){poke8(p+i,StrCharAt(s2,i)&0xFF);i:=i+1;} p:=p+l2;
    var vl: int64 := StrLen(version);
    i:=0; while(i<vl){poke8(p+i,StrCharAt(version,i)&0xFF);i:=i+1;} p:=p+vl;
    var s3: pchar := "\",\"node_pools\":[{\"name\":\"default\",\"size\":\""c;
    var l3: int64 := StrLen(s3);
    i:=0; while(i<l3){poke8(p+i,StrCharAt(s3,i)&0xFF);i:=i+1;} p:=p+l3;
    var sl: int64 := StrLen(nodeSize);
    i:=0; while(i<sl){poke8(p+i,StrCharAt(nodeSize,i)&0xFF);i:=i+1;} p:=p+sl;
    var s4: pchar := "\",\"count\":"c; var l4: int64 := StrLen(s4);
    i:=0; while(i<l4){poke8(p+i,StrCharAt(s4,i)&0xFF);i:=i+1;} p:=p+l4;
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(nodeCount, numBuf);
    var nn: int64 := StrLen(numStr);
    i:=0; while(i<nn){poke8(p+i,StrCharAt(numStr,i)&0xFF);i:=i+1;} p:=p+nn;
    free(numBuf, 24);
    var t: pchar := "}]}"c; var lt: int64 := StrLen(t);
    i:=0; while(i<lt){poke8(p+i,StrCharAt(t,i)&0xFF);i:=i+1;} p:=p+lt;
    poke8(p,0);
    var bodyLen: int64 := p - buf;
    var cl: DOClient := doClientK8s(creds);
    var path: pchar := "/v2/kubernetes/clusters"c;
    var resp: HTTPResponse := DOPost(cl, path, buf, bodyLen);
    free(buf, 2048);
    if (resp.statusCode == 201 && resp.bodyPtr != 0) { cl2 := parseK8sCluster(resp.bodyPtr); }
    HTTPResponseFree(resp);
    return cl2;
}

pub fn K8sClusterDelete(creds: DOCredentials, id: pchar): int64 {
    var cl: DOClient := doClientK8s(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath(pathBuf, "/v2/kubernetes/clusters/"c, id);
    var resp: HTTPResponse := DODelete(cl, pathBuf as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 202 || resp.statusCode == 204) { ok := 1; }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return ok;
}

pub fn K8sClusterGet(creds: DOCredentials, id: pchar): DOK8sCluster {
    var c: DOK8sCluster;
    c.id := 0; c.name := 0; c.region := 0; c.version := 0;
    c.status := 0; c.endpoint := 0; c.ipv4 := 0;
    var cl: DOClient := doClientK8s(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath(pathBuf, "/v2/kubernetes/clusters/"c, id);
    var resp: HTTPResponse := DOGet(cl, pathBuf as pchar);
    if (resp.statusCode == 200 && resp.bodyPtr != 0) { c := parseK8sCluster(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return c;
}

pub fn K8sClusterList(creds: DOCredentials): int64 {
    var cl: DOClient := doClientK8s(creds);
    var path: pchar := "/v2/kubernetes/clusters"c;
    return DOGetAll(cl, path, "kubernetes_clusters"c);
}

pub fn K8sClusterWait(creds: DOCredentials, id: pchar): DOK8sCluster {
    var maxAttempts: int64 := 120;
    var attempt: int64 := 0;
    var c: DOK8sCluster;
    c.id := 0; c.name := 0; c.region := 0; c.version := 0;
    c.status := 0; c.endpoint := 0; c.ipv4 := 0;
    while (attempt < maxAttempts) {
        c := K8sClusterGet(creds, id);
        if (c.status != 0) {
            var running: pchar := "running"c;
            var slen: int64 := StrLen(c.status as pchar);
            var rlen: int64 := StrLen(running);
            if (slen == rlen) {
                var isMatch: int64 := 1; var j: int64 := 0;
                while(j<slen){if(peek8(c.status+j)!=(StrCharAt(running,j)&0xFF)){isMatch:=0;break;}j:=j+1;}
                if (isMatch == 1) { return c; }
            }
        }
        DOK8sClusterFree(c);
        c.id := 0; c.name := 0; c.region := 0; c.version := 0;
        c.status := 0; c.endpoint := 0; c.ipv4 := 0;
        Sleep(5000);
        attempt += 1;
    }
    return c;
}

pub fn K8sClusterUpgrade(creds: DOCredentials, id: pchar, version: pchar): int64 {
    var cl: DOClient := doClientK8s(creds);
    var buf: int64 := alloc(256);
    var h: pchar := "{\"version\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(buf+i,StrCharAt(h,i)&0xFF);i:=i+1;}
    var vl: int64 := StrLen(version);
    i:=0; while(i<vl){poke8(buf+lh+i,StrCharAt(version,i)&0xFF);i:=i+1;}
    var t: pchar := "\"}"c; var lt: int64 := StrLen(t);
    var off: int64 := lh + vl;
    i:=0; while(i<lt){poke8(buf+off+i,StrCharAt(t,i)&0xFF);i:=i+1;}
    poke8(buf+off+lt,0);
    var bodyLen: int64 := off + lt;
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/kubernetes/clusters/"c, id, "/upgrade"c);
    var resp: HTTPResponse := DOPost(cl, pathBuf as pchar, buf, bodyLen);
    var ok: int64 := 0;
    if (resp.statusCode == 202) { ok := 1; }
    HTTPResponseFree(resp);
    free(buf, 256);
    free(pathBuf, 256);
    return ok;
}

