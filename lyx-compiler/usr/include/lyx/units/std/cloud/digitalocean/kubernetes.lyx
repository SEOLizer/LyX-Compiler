// kubeconfig
pub fn K8sKubeconfig(creds: DOCredentials, id: pchar): int64 {
    var cl: DOClient := doClientK8s(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/kubernetes/clusters/"c, id, "/kubeconfig"c);
    var resp: HTTPResponse := DOGet(cl, pathBuf as pchar);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.bodyPtr != 0) {
        result := resp.bodyPtr;
        resp.bodyPtr := 0; // transfer ownership
    }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return result;
}

pub fn K8sKubeconfigSave(creds: DOCredentials, id: pchar, path: pchar): int64 {
    var yaml: int64 := K8sKubeconfig(creds, id);
    if (yaml == 0) { return 1; }
    var n: int64 := WriteFile(path, yaml as pchar, StrLen(yaml as pchar));
    free(yaml, StrLen(yaml as pchar) + 1);
    if (n > 0) { return 0; }
    return 1;
}

// Node Pools
pub fn K8sNodePoolCreate(creds: DOCredentials, clusterId: pchar,
                         name: pchar, size: pchar, count: int64): DOK8sNodePool {
    var poolRec: DOK8sNodePool;
    poolRec.id := 0; poolRec.name := 0; poolRec.size := 0; poolRec.count := 0;
    poolRec.autoScale := 0; poolRec.minNodes := 0; poolRec.maxNodes := 0;
    var buf: int64 := alloc(512);
    var p: int64 := buf;
    var h: pchar := "{\"name\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(p+i,StrCharAt(h,i)&0xFF);i:=i+1;} p:=p+lh;
    var nl: int64 := StrLen(name);
    i:=0; while(i<nl){poke8(p+i,StrCharAt(name,i)&0xFF);i:=i+1;} p:=p+nl;
    var s1: pchar := "\",\"size\":\""c; var l1: int64 := StrLen(s1);
    i:=0; while(i<l1){poke8(p+i,StrCharAt(s1,i)&0xFF);i:=i+1;} p:=p+l1;
    var sl: int64 := StrLen(size);
    i:=0; while(i<sl){poke8(p+i,StrCharAt(size,i)&0xFF);i:=i+1;} p:=p+sl;
    var s2: pchar := "\",\"count\":"c; var l2: int64 := StrLen(s2);
    i:=0; while(i<l2){poke8(p+i,StrCharAt(s2,i)&0xFF);i:=i+1;} p:=p+l2;
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(count, numBuf);
    var nn: int64 := StrLen(numStr);
    i:=0; while(i<nn){poke8(p+i,StrCharAt(numStr,i)&0xFF);i:=i+1;} p:=p+nn;
    free(numBuf, 24);
    poke8(p,125); p:=p+1; poke8(p,0); // '}'
    var bodyLen: int64 := p - buf;
    var cl: DOClient := doClientK8s(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/kubernetes/clusters/"c, clusterId, "/node_pools"c);
    var resp: HTTPResponse := DOPost(cl, pathBuf as pchar, buf, bodyLen);
    free(buf, 512);
    if (resp.statusCode == 201 && resp.bodyPtr != 0) { poolRec := parseNodePool(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return poolRec;
}

pub fn K8sNodePoolUpdate(creds: DOCredentials, clusterId: pchar, poolId: pchar,
                         count: int64, autoScale: int64, min: int64, max: int64): DOK8sNodePool {
    var poolRec: DOK8sNodePool;
    poolRec.id := 0; poolRec.name := 0; poolRec.size := 0; poolRec.count := 0;
    poolRec.autoScale := 0; poolRec.minNodes := 0; poolRec.maxNodes := 0;
    var cl: DOClient := doClientK8s(creds);
    var buf: int64 := alloc(256);
    var h: pchar := "{\"count\":"c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(buf+i,StrCharAt(h,i)&0xFF);i:=i+1;}
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(count, numBuf);
    var nn: int64 := StrLen(numStr);
    i:=0; while(i<nn){poke8(buf+lh+i,StrCharAt(numStr,i)&0xFF);i:=i+1;}
    free(numBuf, 24);
    poke8(buf+lh+nn,125); poke8(buf+lh+nn+1,0);
    var bodyLen: int64 := lh + nn + 1;
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/kubernetes/clusters/"c, clusterId, "/node_pools/"c);
    var existLen: int64 := StrLen(pathBuf as pchar);
    var pl: int64 := StrLen(poolId);
    i:=0; while(i<pl){poke8(pathBuf+existLen+i,StrCharAt(poolId,i)&0xFF);i:=i+1;}
    poke8(pathBuf+existLen+pl,0);
    var resp: HTTPResponse := DOPut(cl, pathBuf as pchar, buf, bodyLen);
    free(buf, 256);
    if (resp.statusCode == 202 && resp.bodyPtr != 0) { poolRec := parseNodePool(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return poolRec;
}

