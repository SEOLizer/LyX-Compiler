// std/cloud/gcp/jwt.lyx — JWT RS256 Builder (WP-GCP-02)
//
// Public API:
//   GCPServiceAccountFromJSON(json, jsonLen) -> GCPServiceAccount
//   GCPServiceAccountFree(sa)
//   GCPBuildJWT(sa, scope, now) -> ptr  (null-terminated JWT token, caller frees via GCPJWTFree)
//   GCPJWTFree(token, tokenLen)
//   base64urlEncodeBytes(src, srcLen, dst) -> int64  (written length)

unit std.cloud.gcp.jwt;

import std.crypto.rsa;
import std.crypto.sha256;
import std.alloc;

// ── GCPServiceAccount ─────────────────────────────────────────────────────────

pub type GCPServiceAccount = struct {
    projectId:   int64;   // pchar
    clientEmail: int64;   // pchar
    privateKey:  int64;   // EVP_PKEY* (from RSAKeyLoad)
    tokenUri:    int64;   // pchar  (default "https://oauth2.googleapis.com/token")
};

// ── Internal helpers ──────────────────────────────────────────────────────────

fn gcpStrLen(s: int64): int64 {
    if (s == 0) { return 0; }
    var i: int64 := 0;
    while (peek8(s + i) != 0) { i := i + 1; }
    return i;
}

fn gcpStrDupN(src: int64, n: int64): int64 {
    var buf: int64 := alloc(n + 1);
    var i: int64 := 0;
    while (i < n) { poke8(buf + i, peek8(src + i)); i := i + 1; }
    poke8(buf + n, 0);
    return buf;
}

fn gcpStrDup(src: int64): int64 {
    if (src == 0) { return 0; }
    return gcpStrDupN(src, gcpStrLen(src));
}

// Find value of JSON string field "key" in json buffer.
// Returns alloc'd null-terminated string, or 0 if not found.
fn gcpJSONExtract(json: int64, jsonLen: int64, key: int64): int64 {
    var kl: int64 := gcpStrLen(key);
    var i: int64 := 0;
    while (i < jsonLen - kl - 3) {
        if ((peek8(json + i) & 0xFF) == 34) {   // '"'
            var match: int64 := 1;
            var j: int64 := 0;
            while (j < kl) {
                if ((peek8(json + i + 1 + j) & 0xFF) != (peek8(key + j) & 0xFF)) {
                    match := 0;
                    break;
                }
                j += 1;
            }
            if ((match == 1) & ((peek8(json + i + 1 + kl) & 0xFF) == 34)) {
                var k: int64 := i + kl + 2;
                while ((k < jsonLen) & (peek8(json + k) == 32)) { k := k + 1; }
                if ((k < jsonLen) & ((peek8(json + k) & 0xFF) == 58)) {
                    k += 1;
                    while ((k < jsonLen) & (peek8(json + k) == 32)) { k := k + 1; }
                    if ((k < jsonLen) & ((peek8(json + k) & 0xFF) == 34)) {
                        k += 1;
                        var vs: int64 := k;
                        while ((k < jsonLen) & ((peek8(json + k) & 0xFF) != 34)) {
                            // Handle escape: skip \"
                            if ((peek8(json + k) & 0xFF) == 92) { k := k + 1; }
                            k += 1;
                        }
                        return gcpStrDupN(json + vs, k - vs);
                    }
                }
            }
        }
        i += 1;
    }
    return 0;
}

// Unescape JSON string (replace \\n → \n, \\r → \r, \\t → \t, \\\\ → \\, \\/ → /)
fn gcpJSONUnescape(s: int64, sLen: int64, out: int64): int64 {
    var i: int64 := 0;
    var j: int64 := 0;
    while (i < sLen) {
        var c: int64 := peek8(s + i) & 0xFF;
        if ((c == 92) & (i + 1 < sLen)) {   // backslash
            i += 1;
            var nc: int64 := peek8(s + i) & 0xFF;
            if (nc == 110) { poke8(out + j, 10); j := j + 1; }       // \n
            else if (nc == 114) { poke8(out + j, 13); j := j + 1; }  // \r
            else if (nc == 116) { poke8(out + j, 9); j := j + 1; }   // \t
            else { poke8(out + j, nc); j := j + 1; }                  // \\ or \/
        } else {
            poke8(out + j, c); j := j + 1;
        }
        i += 1;
    }
    poke8(out + j, 0);
    return j;
}

// base64url encode: URL-safe alphabet (-/_), no padding
pub fn base64urlEncodeBytes(src: int64, srcLen: int64, dst: int64): int64 {
    var alpha: int64 := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_" as int64;
    var out: int64 := 0;
    var i: int64 := 0;
    while (i + 3 <= srcLen) {
        var b0: int64 := peek8(src + i)     & 0xFF;
        var b1: int64 := peek8(src + i + 1) & 0xFF;
        var b2: int64 := peek8(src + i + 2) & 0xFF;
        poke8(dst + out, peek8(alpha + ((b0 >> 2) & 63)));       out := out + 1;
        poke8(dst + out, peek8(alpha + (((b0 & 3) << 4) | ((b1 >> 4) & 15)))); out := out + 1;
        poke8(dst + out, peek8(alpha + (((b1 & 15) << 2) | ((b2 >> 6) & 3)))); out := out + 1;
        poke8(dst + out, peek8(alpha + (b2 & 63)));              out := out + 1;
        i += 3;
    }
    var rem: int64 := srcLen - i;
    if (rem == 1) {
        var b0: int64 := peek8(src + i) & 0xFF;
        poke8(dst + out, peek8(alpha + ((b0 >> 2) & 63)));       out := out + 1;
        poke8(dst + out, peek8(alpha + ((b0 & 3) << 4)));        out := out + 1;
    } else if (rem == 2) {
        var b0: int64 := peek8(src + i)     & 0xFF;
        var b1: int64 := peek8(src + i + 1) & 0xFF;
        poke8(dst + out, peek8(alpha + ((b0 >> 2) & 63)));       out := out + 1;
        poke8(dst + out, peek8(alpha + (((b0 & 3) << 4) | ((b1 >> 4) & 15)))); out := out + 1;
        poke8(dst + out, peek8(alpha + ((b1 & 15) << 2)));       out := out + 1;
    }
    poke8(dst + out, 0);
    return out;
}

// Encode a null-terminated string in base64url. Returns alloc'd result.
fn gcpB64URL(src: int64, srcLen: int64): int64 {
    var outSz: int64 := (srcLen * 4 / 3) + 8;
    var buf: int64 := alloc(outSz);
    base64urlEncodeBytes(src, srcLen, buf);
    return buf;
}

// Append src bytes into dst starting at offset *off. Updates *off.
fn gcpAppend(dst: int64, off: int64, src: int64, n: int64): void {
    var cur: int64 := peek64(off);
    var i: int64 := 0;
    while (i < n) { poke8(dst + cur + i, peek8(src + i)); i := i + 1; }
    poke64(off, cur + n);
}

fn gcpAppendStr(dst: int64, off: int64, s: int64): void {
    gcpAppend(dst, off, s, gcpStrLen(s));
}

fn gcpAppendInt(dst: int64, off: int64, n: int64): void {
    var tmp: int64 := alloc(24);
    if (n == 0) {
        poke8(tmp, 48); poke8(tmp + 1, 0);
        gcpAppend(dst, off, tmp, 1);
        free(tmp, 24); return;
    }
    var len: int64 := 0;
    var v: int64 := n;
    while (v > 0) {
        poke8(tmp + len, 48 + (v - ((v / 10) * 10)));
        v := v / 10; len := len + 1;
    }
    // reverse
    var i: int64 := 0;
    var rev: int64 := alloc(24);
    while (i < len) { poke8(rev + i, peek8(tmp + len - 1 - i)); i := i + 1; }
    poke8(rev + len, 0);
    gcpAppend(dst, off, rev, len);
    free(tmp, 24); free(rev, 24);
}

// Build JWT header base64url: base64url({"alg":"RS256","typ":"JWT"})
fn jwtBuildHeader(): int64 {
    var hdr: int64 := "{\"alg\":\"RS256\",\"typ\":\"JWT\"}" as int64;
    var hdrLen: int64 := gcpStrLen(hdr);
    return gcpB64URL(hdr, hdrLen);
}

// Build JWT payload base64url
// ≤6 params: iss, sub, aud, iat, exp, scope
fn jwtBuildPayloadPart1(iss: int64, sub: int64, aud: int64, iat: int64, exp: int64, scope: int64): int64 {
    // Build JSON payload: {"iss":"...","sub":"...","aud":"...","iat":N,"exp":N,"scope":"..."}
    var issLen: int64 := gcpStrLen(iss);
    var subLen: int64 := gcpStrLen(sub);
    var audLen: int64 := gcpStrLen(aud);
    var scopeLen: int64 := gcpStrLen(scope);
    var total: int64 := 256 + issLen + subLen + audLen + scopeLen;
    var json: int64 := alloc(total);
    var off: int64 := alloc(8);
    poke64(off, 0);
    var q1: int64 := "{\"iss\":\"" as int64;
    gcpAppend(json, off, q1, 8);
    gcpAppend(json, off, iss, issLen);
    var q2: int64 := "\",\"sub\":\"" as int64;
    gcpAppend(json, off, q2, 9);
    gcpAppend(json, off, sub, subLen);
    var q3: int64 := "\",\"aud\":\"" as int64;
    gcpAppend(json, off, q3, 9);
    gcpAppend(json, off, aud, audLen);
    var q4: int64 := "\",\"iat\":" as int64;
    gcpAppend(json, off, q4, 8);
    gcpAppendInt(json, off, iat);
    var q5: int64 := ",\"exp\":" as int64;
    gcpAppend(json, off, q5, 7);
    gcpAppendInt(json, off, exp);
    var q6: int64 := ",\"scope\":\"" as int64;
    gcpAppend(json, off, q6, 10);
    gcpAppend(json, off, scope, scopeLen);
    var q7: int64 := "\"}" as int64;
    gcpAppend(json, off, q7, 2);
    var jsonLen: int64 := peek64(off);
    poke8(json + jsonLen, 0);
    free(off, 8);
    var encoded: int64 := gcpB64URL(json, jsonLen);
    free(json, total);
    return encoded;
}

// ── Public API ────────────────────────────────────────────────────────────────

// Parse GCP service account JSON (project_id, client_email, private_key, token_uri)
pub fn GCPServiceAccountFromJSON(json: int64, jsonLen: int64): GCPServiceAccount {
    var sa: GCPServiceAccount;
    sa.projectId   := gcpJSONExtract(json, jsonLen, "project_id" as int64);
    sa.clientEmail := gcpJSONExtract(json, jsonLen, "client_email" as int64);
    sa.tokenUri    := gcpJSONExtract(json, jsonLen, "token_uri" as int64);
    if (sa.tokenUri == 0) {
        sa.tokenUri := gcpStrDup("https://oauth2.googleapis.com/token" as int64);
    }
    // Extract private_key and unescape it for PEM loading
    var rawKey: int64 := gcpJSONExtract(json, jsonLen, "private_key" as int64);
    if (rawKey != 0) {
        var rawLen: int64 := gcpStrLen(rawKey);
        var pemBuf: int64 := alloc(rawLen + 1);
        var pemLen: int64 := gcpJSONUnescape(rawKey, rawLen, pemBuf);
        sa.privateKey := RSAKeyLoad(pemBuf, pemLen);
        free(pemBuf, rawLen + 1);
        free(rawKey, rawLen + 1);
    } else {
        sa.privateKey := 0;
    }
    return sa;
}

pub fn GCPServiceAccountFree(sa: GCPServiceAccount): void {
    if (sa.projectId   != 0) { free(sa.projectId,   gcpStrLen(sa.projectId)   + 1); }
    if (sa.clientEmail != 0) { free(sa.clientEmail, gcpStrLen(sa.clientEmail) + 1); }
    if (sa.tokenUri    != 0) { free(sa.tokenUri,    gcpStrLen(sa.tokenUri)    + 1); }
    if (sa.privateKey  != 0) { RSAKeyFree(sa.privateKey); }
}

// GCPBuildJWT — produce a signed JWT token string.
// Returns alloc'd null-terminated token (caller frees with GCPJWTFree).
// scope: OAuth 2.0 scope string, now: unix timestamp (seconds)
pub fn GCPBuildJWT(sa: GCPServiceAccount, scope: int64, now: int64): int64 {
    var hdr: int64    := jwtBuildHeader();
    var exp: int64    := now + 3600;
    var aud: int64    := sa.tokenUri;
    if (aud == 0) { aud := "https://oauth2.googleapis.com/token" as int64; }
    var payload: int64 := jwtBuildPayloadPart1(sa.clientEmail, sa.clientEmail, aud, now, exp, scope);

    // message = header + "." + payload
    var hdrLen: int64     := gcpStrLen(hdr);
    var payLen: int64     := gcpStrLen(payload);
    var msgLen: int64     := hdrLen + 1 + payLen;
    var msg: int64        := alloc(msgLen + 1);
    var i: int64 := 0;
    while (i < hdrLen)  { poke8(msg + i, peek8(hdr + i)); i := i + 1; }
    poke8(msg + i, 46); i := i + 1;   // '.'
    var j: int64 := 0;
    while (j < payLen)  { poke8(msg + i, peek8(payload + j)); i := i + 1; j := j + 1; }
    poke8(msg + msgLen, 0);

    // Sign message
    var keyBits: int64  := RSAKeyBits(sa.privateKey);
    var keyBytes: int64 := keyBits / 8;
    if (keyBytes == 0) { keyBytes := 256; }
    var sigBuf: int64   := alloc(keyBytes + 8);
    var sigLenBuf: int64 := alloc(8);
    poke64(sigLenBuf, 0);
    var rc: int64 := RSASign(sa.privateKey, msg, msgLen, sigBuf, sigLenBuf);
    var sigLen: int64 := peek64(sigLenBuf);
    free(sigLenBuf, 8);

    var sigEncSz: int64 := (sigLen * 4 / 3) + 8;
    var sigEnc: int64   := alloc(sigEncSz);
    if (rc == 1) {
        base64urlEncodeBytes(sigBuf, sigLen, sigEnc);
    } else {
        poke8(sigEnc, 0);
    }
    free(sigBuf, keyBytes + 8);

    // token = message + "." + sigEnc
    var sigEncLen: int64 := gcpStrLen(sigEnc);
    var tokenLen: int64  := msgLen + 1 + sigEncLen;
    var token: int64     := alloc(tokenLen + 1);
    i := 0;
    while (i < msgLen)    { poke8(token + i, peek8(msg + i)); i := i + 1; }
    poke8(token + i, 46); i := i + 1;  // '.'
    j := 0;
    while (j < sigEncLen) { poke8(token + i, peek8(sigEnc + j)); i := i + 1; j := j + 1; }
    poke8(token + tokenLen, 0);

    free(hdr, gcpStrLen(hdr) + 1);
    free(payload, gcpStrLen(payload) + 1);
    free(msg, msgLen + 1);
    free(sigEnc, sigEncSz);
    return token;
}

pub fn GCPJWTFree(token: int64): void {
    if (token == 0) { return; }
    var n: int64 := 0;
    while (peek8(token + n) != 0) { n := n + 1; }
    free(token, n + 1);
}
