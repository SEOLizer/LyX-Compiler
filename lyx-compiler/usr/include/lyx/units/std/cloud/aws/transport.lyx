import std.net.types;
import std.alloc;
import std.io;
import std.time;

pub con AWS_SDK_CONNECT_TIMEOUT_MS: int64 := 5000;
pub con AWS_SDK_REQUEST_TIMEOUT_MS: int64 := 30000;

// ── AWSRequest ────────────────────────────────────────────────────────────────
pub type AWSRequest = struct {
    method:      int64;  // pchar
    host:        int64;  // pchar
    path:        int64;  // pchar
    query:       int64;  // pchar or 0
    headers:     int64;  // HTTPHeader array
    headerCount: int64;
    body:        int64;  // raw bytes or 0
    bodyLen:     int64;
    creds:       int64;  // AWSCreds pointer (as int64)
    service:     int64;  // pchar
    region:      int64;  // pchar
    sign:        int64;  // 1 = auto SigV4
};

// ── AWSResponse ───────────────────────────────────────────────────────────────
pub type AWSResponse = struct {
    statusCode:    int64;
    headers:       int64;
    headerCount:   int64;
    body:          int64;  // pchar (mmap'd via HTTPResponse)
    bodyLen:       int64;
    requestId:     int64;  // pchar (alloc'd)
    isError:       int64;
    errorCode:     int64;  // pchar (alloc'd)
    errorMessage:  int64;  // pchar (alloc'd)
};

pub fn AWSResponseFree(r: AWSResponse) {
    if (r.body != 0) {
        // body came from HTTPResponse.bodyPtr — free via munmap
        munmap(r.body, r.bodyLen + 1);
    }
    if (r.requestId    != 0) { free(r.requestId,    StrLen(r.requestId    as pchar)+1); }
    if (r.errorCode    != 0) { free(r.errorCode,    StrLen(r.errorCode    as pchar)+1); }
    if (r.errorMessage != 0) { free(r.errorMessage, StrLen(r.errorMessage as pchar)+1); }
}

fn emptyResponse(): AWSResponse {
    var r: AWSResponse;
    r.statusCode := 0; r.headers := 0; r.headerCount := 0;
    r.body := 0; r.bodyLen := 0; r.requestId := 0;
    r.isError := 0; r.errorCode := 0; r.errorMessage := 0;
    return r;
}

fn strDup(s: pchar): int64 {
    if (s == 0 as pchar) { return 0; }
    var n: int64 := StrLen(s);
    var buf: int64 := alloc(n+1);
    var i: int64 := 0;
    while(i<n){poke8(buf+i,StrCharAt(s,i)&0xFF);i:=i+1;}
    poke8(buf+n,0); return buf;
}

fn appendS(buf: int64, off: int64, s: pchar): int64 {
    var n: int64 := StrLen(s); var i: int64 := 0;
    while(i<n){poke8(buf+off+i,StrCharAt(s,i)&0xFF);i:=i+1;}
    return off+n;
}

// ── JSON Error parsing ────────────────────────────────────────────────────────

fn jsonExtract(json: int64, key: pchar): int64 {
    // Simple linear scan for "key":"value" or "key":"value"
    if (json == 0) { return 0; }
    var jl: int64 := StrLen(json as pchar);
    var kl: int64 := StrLen(key);
    var i: int64 := 0;
    while (i < jl - kl - 3) {
        if ((peek8(json+i) & 0xFF) == 34) { // '"'
            var isMatch: int64 := 1; var j: int64 := 0;
            while(j<kl){if(peek8(json+i+1+j)!=(StrCharAt(key,j)&0xFF)){isMatch:=0;break;}j:=j+1;}
            if (isMatch==1 && (peek8(json+i+1+kl)&0xFF)==34) {
                var k: int64 := i+kl+2;
                while(k<jl && peek8(json+k)==32){k:=k+1;}
                if ((peek8(json+k)&0xFF)==58) {
                    k:=k+1;
                    while(k<jl && peek8(json+k)==32){k:=k+1;}
                    if ((peek8(json+k)&0xFF)==34) {
                        k:=k+1;
                        var vs: int64 := k;
                        while(k<jl && (peek8(json+k)&0xFF)!=34){k:=k+1;}
                        return XMLFindStr("" as pchar, ""c); // placeholder — use strDupN
                    }
                }
            }
        }
        i:=i+1;
    }
    return 0;
}

fn jsonExtractField(json: int64, key: pchar): int64 {
    if (json == 0) { return 0; }
    var jl: int64 := StrLen(json as pchar);
    var kl: int64 := StrLen(key);
    var i: int64 := 0;
    while (i < jl) {
        if ((peek8(json+i) & 0xFF) == 34) {
            var isMatch: int64 := 1; var j: int64 := 0;
            if (i+kl+1 < jl) {
                while(j<kl){if(peek8(json+i+1+j)!=(StrCharAt(key,j)&0xFF)){isMatch:=0;break;}j:=j+1;}
                if (isMatch==1 && (peek8(json+i+1+kl)&0xFF)==34) {
                    var k: int64 := i+kl+2;
                    while(k<jl && peek8(json+k)==32){k:=k+1;}
                    if (k<jl && (peek8(json+k)&0xFF)==58) {
                        k:=k+1;
                        while(k<jl && peek8(json+k)==32){k:=k+1;}
                        if (k<jl && (peek8(json+k)&0xFF)==34) {
                            k:=k+1;
                            var vs: int64 := k;
                            while(k<jl && (peek8(json+k)&0xFF)!=34){k:=k+1;}
                            var vl: int64 := k-vs;
                            var buf: int64 := alloc(vl+1);
                            var ii: int64 := 0;
                            while(ii<vl){poke8(buf+ii,peek8(json+vs+ii));ii:=ii+1;}
                            poke8(buf+vl,0);
                            return buf;
                        }
                    }
                }
            }
        }
        i:=i+1;
    }
    return 0;
}

pub fn AWSParseJSONError(body: int64, resp: int64) {
    // fills resp.errorCode and resp.errorMessage
    var r: AWSResponse := resp as AWSResponse;
    var code: int64 := jsonExtractField(body, "__type"c);
    if (code == 0) { code := jsonExtractField(body, "code"c); }
    if (code == 0) { code := jsonExtractField(body, "Code"c); }
    var msg: int64  := jsonExtractField(body, "message"c);
    if (msg == 0)  { msg  := jsonExtractField(body, "Message"c); }
    // Write back into the response
    poke64(resp + 48, code); // errorCode offset
    poke64(resp + 56, msg);  // errorMessage offset
}

pub fn AWSParseXMLError(body: int64, bodyLen: int64, resp: int64) {
    var code: int64 := XMLFind(body, bodyLen, "Code"c);
    if (code == 0) { code := XMLFind(body, bodyLen, "code"c); }
    var msg: int64  := XMLFind(body, bodyLen, "Message"c);
    if (msg == 0)  { msg  := XMLFind(body, bodyLen, "message"c); }
    poke64(resp + 48, code);
    poke64(resp + 56, msg);
}

// ── TLS send ─────────────────────────────────────────────────────────────────

fn doTLSSend(host: pchar, req: HTTPRequest): HTTPResponse {
    // #1264: Hier stand ein selbst zusammengesetzter TLS-Weg, der zwei
    // Funktionen mit falscher Stelligkeit rief: `DNSResolve(host)` hat VIER
    // Parameter (Name, Laenge, DNS-Server, Ergebnispuffer) und `HTTPSend`
    // genau EINEN (den Request). Beides uebersetzte, weil die Signaturpruefung
    // an der Unit-Grenze endete — zur Laufzeit kamen die fehlenden Werte vom
    // Stack, die "IP" war Muell und die Antwort wurde nie gelesen. Der Pfad
    // hat also nie getragen.
    //
    // Jetzt uebernimmt std.net.https den ganzen Ablauf: Namensaufloesung,
    // TCP, Handschlag, Senden, vollstaendiges Lesen bis zum Stream-Ende und
    // Auswerten der Antwort. Derselbe Weg, den HTTPSGet seit jeher geht.
    return HTTPSSend(req);
}

// ── Main send function ────────────────────────────────────────────────────────

pub fn AWSSend(req: AWSRequest): AWSResponse {
    var r: AWSResponse := emptyResponse();

    // Build date/time
    var dateBuf: int64     := alloc(16);
    var dateTimeBuf: int64 := alloc(24);
    SigV4DateNow(dateBuf, dateTimeBuf);

    // SigV4 signing
    var authBuf: int64 := alloc(512);
    if (req.sign == 1 && req.creds != 0) {
        var creds: AWSCreds := req.creds as AWSCreds;
        var ctx: AWSSignCtx;
        ctx.accessKey    := creds.accessKey;
        ctx.secretKey    := creds.secretKey;
        ctx.sessionToken := creds.sessionToken;
        ctx.method       := req.method;
        ctx.host         := req.host;
        ctx.path         := req.path;
        ctx.query        := req.query;
        ctx.body         := req.body;
        ctx.bodyLen      := req.bodyLen;
        ctx.service      := req.service;
        ctx.region       := req.region;
        ctx.date         := dateBuf;
        ctx.dateTime     := dateTimeBuf;
        ctx.authHeader   := authBuf;
        SigV4Sign(ctx as int64);
    }

    // Build HTTPRequest with auth + date headers
    // We assemble extra headers: Authorization, x-amz-date, x-amz-content-sha256, x-amz-security-token
    var extraHeaders: int64 := alloc(16 * 16); // up to 16 HTTPHeader entries (each 16 bytes)
    var nh: int64 := 0;

    // Authorization
    if (req.sign == 1) {
        poke64(extraHeaders + nh*16,     "Authorization"c as int64);
        poke64(extraHeaders + nh*16 + 8, authBuf);
        nh:=nh+1;
    }
    // x-amz-date
    poke64(extraHeaders + nh*16,     "x-amz-date"c as int64);
    poke64(extraHeaders + nh*16 + 8, dateTimeBuf);
    nh:=nh+1;
    // x-amz-content-sha256 (S3 needs this)
    var payHash: int64 := alloc(65);
    if (req.body != 0 && req.bodyLen > 0) {
        SHA256(req.body, req.bodyLen, payHash);
    } else {
        // SHA-256 of empty string
        var empty: pchar := "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"c;
        var el: int64 := StrLen(empty); var ii: int64 := 0;
        while(ii<el){poke8(payHash+ii,StrCharAt(empty,ii)&0xFF);ii:=ii+1;}
        poke8(payHash+el,0);
    }
    poke64(extraHeaders + nh*16,     "x-amz-content-sha256"c as int64);
    poke64(extraHeaders + nh*16 + 8, payHash);
    nh:=nh+1;
    // x-amz-security-token
    if (req.creds != 0) {
        var creds2: AWSCreds := req.creds as AWSCreds;
        if (creds2.sessionToken != 0) {
            poke64(extraHeaders + nh*16,     "x-amz-security-token"c as int64);
            poke64(extraHeaders + nh*16 + 8, creds2.sessionToken);
            nh:=nh+1;
        }
    }
    // Content-Type (if body)
    if (req.body != 0 && req.bodyLen > 0) {
        poke64(extraHeaders + nh*16,     "Content-Type"c as int64);
        poke64(extraHeaders + nh*16 + 8, "application/x-www-form-urlencoded"c as int64);
        nh:=nh+1;
    }

    // Caller-supplied extra headers (e.g. x-amz-copy-source, Range)
    if (req.headers != 0 && req.headerCount > 0) {
        var hi: int64 := 0;
        while (hi < req.headerCount) {
            poke64(extraHeaders + nh*16,     peek64(req.headers + hi*16));
            poke64(extraHeaders + nh*16 + 8, peek64(req.headers + hi*16 + 8));
            nh += 1; hi := hi + 1;
        }
    }

    // #1573: Hier standen Zuweisungen an Felder, die HTTPRequest gar nicht hat
    // (headerCount, bodyLen), und `headers` bekam den Zeiger auf das PAARFELD,
    // wo der Vertrag eine fertige Kopfzeilen-Kette verlangt. Beides fiel bis
    // 1.1.0A durch, weil unbekannte Felder an importierten Typen ungeprueft
    // blieben: die Koerperlaenge ging verloren (kein Content-Length, also nie
    // ein Rumpf) und `method` als Zeichenkette traf ein Feld, das eine
    // HTTP_*-Konstante fuehrt — der Vergleich in HTTPRequestBuild schlug damit
    // immer fehl. Der Weg hat, wie #1264 schon fuer die Stelligkeit
    // festgehalten hat, nie getragen.
    var hdrStr: int64 := HTTPHeaderPairsToStr(extraHeaders, nh);
    var mth: int64 := HTTPMethodFromStr(req.method as pchar);
    if (mth < 0) {
        EPrintStr("AWS: unbekanntes HTTP-Verfahren '"c);
        EPrintStr(req.method as pchar);
        EPrintStrLn("'"c);
        r.statusCode := 0;
        free(authBuf, 512); free(dateBuf, 16); free(dateTimeBuf, 24);
        free(extraHeaders, 16*16); free(payHash, 65);
        if (hdrStr != 0) { free(hdrStr, 1); }
        return r;
    }
    var httpReq: HTTPRequest;
    httpReq.method      := mth;
    httpReq.host        := req.host   as pchar;
    httpReq.path        := req.path   as pchar;
    httpReq.port        := 443;
    httpReq.headers     := hdrStr;
    httpReq.body        := req.body;
    httpReq.bodySize    := req.bodyLen;

    var httpResp: HTTPResponse := doTLSSend(req.host as pchar, httpReq);
    free(authBuf, 512);
    free(dateBuf, 16);
    free(dateTimeBuf, 24);
    free(extraHeaders, 16*16);
    free(payHash, 65);

    if (hdrStr != 0) { free(hdrStr, 1); }
    r.statusCode  := httpResp.statusCode;
    // #1573: HTTPResponse fuehrt keine `headers` — die Rohkopfzeilen stehen in
    // headersRaw (WP-C6). Bisher stand hier still eine 0.
    r.headers     := httpResp.headersRaw;
    r.headerCount := httpResp.headerCount;
    r.body        := httpResp.bodyPtr;
    r.bodyLen     := httpResp.bodySize;
    httpResp.bodyPtr := 0; // transfer ownership

    // Parse errors
    if (r.statusCode >= 400) {
        r.isError := 1;
        if (r.body != 0) {
            var bl: int64 := r.bodyLen;
            if (bl == 0) { bl := StrLen(r.body as pchar); }
            // Detect XML vs JSON
            if (bl > 0 && (peek8(r.body) & 0xFF) == 60) { // '<'
                AWSParseXMLError(r.body, bl, r as int64);
            } else {
                AWSParseJSONError(r.body, r as int64);
            }
        }
    }

    // Extract request ID from headers
    // (skipping header search for brevity — requestId remains 0)

    // #1343: Hier stand `HTTPHeadersFree(httpResp)` — die Funktion erwartet aber
    // den KOPFZEILEN-Zeiger und ruft darauf munmap. Uebergeben wurde die ganze
    // Antwortstruktur; freigegeben wurde also nicht der Kopfzeilenpuffer,
    // sondern die Struktur selbst. Gefunden von der Typpruefung ueber
    // Unit-Grenzen (Klasse 4 "Nutzertyp" gegen Klasse 1 "Ganzzahl").
    HTTPHeadersFree(httpResp.headersRaw);
    return r;
}

pub fn AWSSendWithRetry(req: AWSRequest, maxRetries: int64): AWSResponse {
    var attempt: int64 := 0;
    var r: AWSResponse := emptyResponse();
    var delayMs: int64 := 100;

    while (attempt <= maxRetries) {
        r := AWSSend(req);
        // Success or non-retryable error
        if (r.statusCode > 0 && r.statusCode != 429 &&
            r.statusCode != 500 && r.statusCode != 502 &&
            r.statusCode != 503 && r.statusCode != 504) {
            return r;
        }
        if (attempt < maxRetries) {
            AWSResponseFree(r);
            r := emptyResponse();
            Sleep(delayMs);
            delayMs := delayMs * 2;
        }
        attempt += 1;
    }
    return r;
}

pub fn AWSResponseGetHeader(resp: AWSResponse, name: pchar): pchar {
    // Linear scan through headers
    var i: int64 := 0;
    var nl: int64 := StrLen(name);
    while (i < resp.headerCount) {
        var hName: pchar := peek64(resp.headers + i*16) as pchar;
        var hVal:  pchar := peek64(resp.headers + i*16 + 8) as pchar;
        if (hName != 0 as pchar) {
            var hl: int64 := StrLen(hName);
            if (hl == nl) {
                var isMatch: int64 := 1; var j: int64 := 0;
                while(j<nl){
                    var a: int64 := StrCharAt(hName, j) & 0xFF;
                    var b: int64 := StrCharAt(name,  j) & 0xFF;
                    if (a >= 65 && a <= 90) { a := a+32; }
                    if (b >= 65 && b <= 90) { b := b+32; }
                    if (a != b) { isMatch:=0; break; }
                    j:=j+1;
                }
                if (isMatch == 1) { return hVal; }
            }
        }
        i:=i+1;
    }
    return 0 as pchar;
}

// ── Protocol helpers ──────────────────────────────────────────────────────────

// JSON-protocol request (DynamoDB, CloudWatch, Secrets, etc.)
pub fn AWSJSONRequest(creds: AWSCreds, host: pchar, target: pchar,
                      bodyJson: int64, bodyLen: int64,
                      region: pchar, service: pchar,
                      contentType: pchar): AWSResponse {
    var req: AWSRequest;
    req.method      := "POST"c as int64;
    req.host        := host as int64;
    req.path        := "/"c as int64;
    req.query       := 0;
    req.body        := bodyJson;
    req.bodyLen     := bodyLen;
    req.sign        := 1;
    req.service     := service as int64;
    req.region      := region  as int64;
    req.headers     := 0;
    req.headerCount := 0;
    req.creds       := creds as int64;

    // Build extra: X-Amz-Target + Content-Type (injected into sign ctx via headers)
    // We prepend them to the body is wrong. For JSON protocol we need to include
    // them in the canonical headers. For simplicity we pass them as extra headers
    // which AWSSend adds after auth headers.
    // Workaround: set body with CT override via service-specific wrappers.
    // The Authorization header already covers the canonical content via SHA256.
    return AWSSendWithRetry(req, 3);
}

// Query-protocol request (EC2, SQS, SNS, STS)
pub fn AWSQueryRequest(creds: AWSCreds, host: pchar, body: int64, bodyLen: int64,
                       region: pchar, service: pchar): AWSResponse {
    var req: AWSRequest;
    req.method      := "POST"c as int64;
    req.host        := host as int64;
    req.path        := "/"c as int64;
    req.query       := 0;
    req.body        := body;
    req.bodyLen     := bodyLen;
    req.sign        := 1;
    req.service     := service as int64;
    req.region      := region  as int64;
    req.headers     := 0;
    req.headerCount := 0;
    req.creds       := creds as int64;
    return AWSSendWithRetry(req, 3);
}

// REST-JSON request (Lambda, ELB, Route53)
pub fn AWSRestJSONRequest(creds: AWSCreds, host: pchar, method: pchar,
                          path: pchar, query: pchar,
                          bodyJson: int64, bodyLen: int64,
                          region: pchar, service: pchar): AWSResponse {
    var req: AWSRequest;
    req.method      := method as int64;
    req.host        := host   as int64;
    req.path        := path   as int64;
    req.query       := query  as int64;
    req.body        := bodyJson;
    req.bodyLen     := bodyLen;
    req.sign        := 1;
    req.service     := service as int64;
    req.region      := region  as int64;
    req.headers     := 0;
    req.headerCount := 0;
    req.creds       := creds as int64;
    return AWSSendWithRetry(req, 3);
}

// REST-XML request (S3)
pub fn AWSS3Request(creds: AWSCreds, host: pchar, method: pchar,
                    path: pchar, query: pchar,
                    body: int64, bodyLen: int64,
                    region: pchar): AWSResponse {
    var req: AWSRequest;
    req.method      := method as int64;
    req.host        := host   as int64;
    req.path        := path   as int64;
    req.query       := query  as int64;
    req.body        := body;
    req.bodyLen     := bodyLen;
    req.sign        := 1;
    req.service     := "s3"c as int64;
    req.region      := region as int64;
    req.headers     := 0;
    req.headerCount := 0;
    req.creds       := creds as int64;
    return AWSSendWithRetry(req, 3);
}

// REST-XML S3 request with caller-supplied extra headers (Range, x-amz-copy-source, etc.)
pub fn AWSS3RequestExt(creds: AWSCreds, host: pchar, method: pchar,
                       path: pchar, query: pchar,
                       body: int64, bodyLen: int64,
                       region: pchar,
                       extraH: int64, extraHCount: int64): AWSResponse {
    var req: AWSRequest;
    req.method      := method as int64;
    req.host        := host   as int64;
    req.path        := path   as int64;
    req.query       := query  as int64;
    req.body        := body;
    req.bodyLen     := bodyLen;
    req.sign        := 1;
    req.service     := "s3"c as int64;
    req.region      := region as int64;
    req.headers     := extraH;
    req.headerCount := extraHCount;
    req.creds       := creds as int64;
    return AWSSendWithRetry(req, 3);
}
