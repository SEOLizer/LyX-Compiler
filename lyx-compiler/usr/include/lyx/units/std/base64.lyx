// std/base64 - Base64 Encoding and Decoding

@description("Base64 encoding and decoding")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
unit std.base64;

// #1310: Hier stand eine extern-Bindung an malloc aus der libc. Programme, die
// diese Unit benutzen, sind statisch gelinkt — es gibt keine libc, an die
// gebunden werden koennte. Der Aufruf lieferte damit keinen Speicher, sondern
// einen unbrauchbaren Wert; der erste StrSetChar darauf toetete den Prozess.
// Betroffen war jeder Decode-Weg, weil beide ihre Umkehrtabelle so anlegten.
import std.alloc;

pub con ENCODE_STD: int64 := 0;
pub con ENCODE_URL_SAFE: int64 := 1;

// #1406: Rueckgabewerte von Decode/DecodeUrlSafe. Bisher gab es nur -1 fuer
// alles; wer einen zu kleinen Puffer uebergeben hatte, konnte das nicht von
// ungueltiger Eingabe unterscheiden. Benannt wie GZIP_OVERFLOW in std.gzip.
pub con BASE64_INVALID:  int64 := 0 - 1;   // Eingabe ist kein gueltiges Base64
pub con BASE64_OVERFLOW: int64 := 0 - 2;   // Ergebnis passt nicht in max_output_len

// #1407: Markierung fuer "dieses Zeichen ist kein Base64-Zeichen" in der
// Umkehrtabelle. Hier stand -1, gelesen wird die Tabelle aber mit StrCharAt,
// und das liefert VORZEICHENLOS: aus -1 wurde 255, und die Pruefung `v < 0`
// konnte nie zutreffen. Gueltige Werte sind 0..63, also ist alles darueber
// ungueltig — diese Pruefung haelt auch vorzeichenlos.
con B64_UNGUELTIG: int64 := 255;

// Encode a string to Base64
pub fn Encode(input: pchar, output: pchar): int64 {
    var input_len: int64 := 0;
    var i: int64 := 0;
    while (StrCharAt(input, i) != 0) {
        input_len += 1;
        i += 1;
    }
    return EncodeBytes(input, input_len, output);
}

// Encode bytes to Base64 with explicit length
pub fn EncodeBytes(input: pchar, input_len: int64, output: pchar): int64 {
    var alphabet: pchar := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

    var out_pos: int64 := 0;
    var i: int64 := 0;

    while (i + 3 <= input_len) {
        var b0: int64 := StrCharAt(input, i);
        var b1: int64 := StrCharAt(input, i + 1);
        var b2: int64 := StrCharAt(input, i + 2);

        var g0: int64 := (b0 >> 2) & 63;
        var g1: int64 := ((b0 & 3) << 4) | ((b1 >> 4) & 15);
        var g2: int64 := ((b1 & 15) << 2) | ((b2 >> 6) & 3);
        var g3: int64 := b2 & 63;

        StrSetChar(output, out_pos, StrCharAt(alphabet, g0)); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g1)); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g2)); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g3)); out_pos := out_pos + 1;

        i += 3;
    }

    var remaining: int64 := input_len - i;
    if (remaining == 1) {
        var b0: int64 := StrCharAt(input, i);
        var g0: int64 := (b0 >> 2) & 63;
        var g1: int64 := (b0 & 3) << 4;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g0)); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g1)); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, 61); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, 61); out_pos := out_pos + 1;
    } else if (remaining == 2) {
        var b0: int64 := StrCharAt(input, i);
        var b1: int64 := StrCharAt(input, i + 1);
        var g0: int64 := (b0 >> 2) & 63;
        var g1: int64 := ((b0 & 3) << 4) | ((b1 >> 4) & 15);
        var g2: int64 := (b1 & 15) << 2;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g0)); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g1)); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g2)); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, 61); out_pos := out_pos + 1;
    }

    StrSetChar(output, out_pos, 0);
    return out_pos;
}

// Encode URL-safe Base64 (- and _ instead of + and /, no padding)
pub fn EncodeUrlSafe(input: pchar, output: pchar): int64 {
    var alphabet: pchar := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

    var input_len: int64 := 0;
    var k: int64 := 0;
    while (StrCharAt(input, k) != 0) {
        input_len += 1;
        k += 1;
    }

    var out_pos: int64 := 0;
    var i: int64 := 0;

    while (i + 3 <= input_len) {
        var b0: int64 := StrCharAt(input, i);
        var b1: int64 := StrCharAt(input, i + 1);
        var b2: int64 := StrCharAt(input, i + 2);

        var g0: int64 := (b0 >> 2) & 63;
        var g1: int64 := ((b0 & 3) << 4) | ((b1 >> 4) & 15);
        var g2: int64 := ((b1 & 15) << 2) | ((b2 >> 6) & 3);
        var g3: int64 := b2 & 63;

        StrSetChar(output, out_pos, StrCharAt(alphabet, g0)); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g1)); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g2)); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g3)); out_pos := out_pos + 1;

        i += 3;
    }

    var remaining: int64 := input_len - i;
    if (remaining == 1) {
        var b0: int64 := StrCharAt(input, i);
        var g0: int64 := (b0 >> 2) & 63;
        var g1: int64 := (b0 & 3) << 4;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g0)); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g1)); out_pos := out_pos + 1;
    } else if (remaining == 2) {
        var b0: int64 := StrCharAt(input, i);
        var b1: int64 := StrCharAt(input, i + 1);
        var g0: int64 := (b0 >> 2) & 63;
        var g1: int64 := ((b0 & 3) << 4) | ((b1 >> 4) & 15);
        var g2: int64 := (b1 & 15) << 2;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g0)); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g1)); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, StrCharAt(alphabet, g2)); out_pos := out_pos + 1;
    }

    StrSetChar(output, out_pos, 0);
    return out_pos;
}

// Get encoded length for given input length
pub fn EncodedLen(input_len: int64): int64 {
    var tmp: int64 := input_len + 2;
    var blocks: int64 := tmp / 3;
    var result: int64 := blocks * 4;
    return result;
}

// #1408: Die beiden Umkehrtabellen haengen nicht von der Eingabe ab. Bisher
// legte JEDER Decode-Aufruf eine neue an (alloc(128), nie freigegeben) — in
// einem Server, der Basic-Auth-Header dekodiert, 128 Byte je Anfrage. Jetzt
// einmal aufgebaut und wiederverwendet; das spart nebenbei 256 StrSetChar je
// Dekodierung.
//
// Die Namen tragen das Praefix _b64: Globale werden ueber Unit-Grenzen hinweg
// ueber ihren NAMEN geteilt, ein knappes `_lookup` waere eine Kollision, die
// erst beim Zusammenspiel zweier Units auffaellt.
// Als int64 gefuehrt, nicht als pchar: `0 as pchar` ist kein zur
// Uebersetzungszeit bekannter Startwert, und der Codegen weist das ab.
var _b64LookupStd: int64 := 0;
var _b64LookupUrl: int64 := 0;

// Build standard Base64 reverse lookup (returns malloc'd 128-byte table)
fn buildLookupStd(): pchar {
    var lookup: pchar := alloc(128) as pchar;
    var i: int64 := 0;
    while (i < 128) {
        StrSetChar(lookup, i, B64_UNGUELTIG);
        i += 1;
    }
    var c: int64 := 65;
    var val: int64 := 0;
    while (c <= 90) { StrSetChar(lookup, c, val); val := val + 1; c := c + 1; }
    c := 97;
    while (c <= 122) { StrSetChar(lookup, c, val); val := val + 1; c := c + 1; }
    c := 48;
    while (c <= 57) { StrSetChar(lookup, c, val); val := val + 1; c := c + 1; }
    StrSetChar(lookup, 43, 62);
    StrSetChar(lookup, 47, 63);
    return lookup;
}

// Build URL-safe Base64 reverse lookup
fn buildLookupUrl(): pchar {
    var lookup: pchar := alloc(128) as pchar;
    var i: int64 := 0;
    while (i < 128) {
        StrSetChar(lookup, i, B64_UNGUELTIG);
        i += 1;
    }
    var c: int64 := 65;
    var val: int64 := 0;
    while (c <= 90) { StrSetChar(lookup, c, val); val := val + 1; c := c + 1; }
    c := 97;
    while (c <= 122) { StrSetChar(lookup, c, val); val := val + 1; c := c + 1; }
    c := 48;
    while (c <= 57) { StrSetChar(lookup, c, val); val := val + 1; c := c + 1; }
    StrSetChar(lookup, 45, 62);
    StrSetChar(lookup, 95, 63);
    return lookup;
}

// #1408: Zugriff auf die zwischengespeicherten Tabellen.
fn lookupStd(): pchar {
    if (_b64LookupStd == 0) { _b64LookupStd := buildLookupStd() as int64; }
    return _b64LookupStd as pchar;
}

fn lookupUrl(): pchar {
    if (_b64LookupUrl == 0) { _b64LookupUrl := buildLookupUrl() as int64; }
    return _b64LookupUrl as pchar;
}

fn decodeWithLookup(input: pchar, output: pchar, max_output_len: int64, lookup: pchar): int64 {
    var input_len: int64 := 0;
    var i: int64 := 0;
    while (StrCharAt(input, i) != 0) {
        input_len += 1;
        i += 1;
    }

    if (input_len == 0) {
        // #1406: auch die abschliessende Null ist ein Schreibzugriff. Bei
        // max_output_len == 0 gibt es dafuer keinen Platz.
        if (max_output_len < 1) { return BASE64_OVERFLOW; }
        StrSetChar(output, 0, 0);
        return 0;
    }

    var out_pos: int64 := 0;
    var j: int64 := 0;

    while (j + 4 <= input_len) {
        var c0: int64 := StrCharAt(input, j);
        var c1: int64 := StrCharAt(input, j + 1);
        var c2: int64 := StrCharAt(input, j + 2);
        var c3: int64 := StrCharAt(input, j + 3);

        if (c0 == 61) { break; }

        // Die Tabelle ist 128 Byte gross. Ein Zeichen darueber (jedes Byte mit
        // gesetztem oberstem Bit, also alles ausserhalb von ASCII) las bisher
        // HINTER der Tabelle und entschied ueber fremden Speicher, ob die
        // Eingabe gueltig ist. Im Issue nicht genannt, aber derselbe Weg.
        if (c0 > 127 || c1 > 127 || c2 > 127 || c3 > 127) { return BASE64_INVALID; }

        var v0: int64 := StrCharAt(lookup, c0);
        var v1: int64 := 0;
        var v2: int64 := 0;
        var v3: int64 := 0;

        if (c1 != 61) { v1 := StrCharAt(lookup, c1); }
        if (c2 != 61) { v2 := StrCharAt(lookup, c2); }
        if (c3 != 61) { v3 := StrCharAt(lookup, c3); }

        // #1407: Geprueft wird jetzt gegen die Obergrenze der gueltigen Werte
        // (0..63) statt auf ein negatives Vorzeichen, das StrCharAt nie
        // liefert. Vorher rechnete der Dekoder mit 255 weiter und meldete
        // Erfolg mit Datenmuell.
        if (v0 > 63) { return BASE64_INVALID; }
        if (c1 != 61 && v1 > 63) { return BASE64_INVALID; }
        if (c2 != 61 && v2 > 63) { return BASE64_INVALID; }
        if (c3 != 61 && v3 > 63) { return BASE64_INVALID; }

        // #1406: max_output_len wurde durchgereicht und nirgends ausgewertet.
        // Jeder Block schreibt bis zu drei Bytes; geprueft wird VOR dem
        // Schreiben, einzeln, damit auch der letzte unvollstaendige Block
        // nicht ein Byte zu weit geht.
        if (out_pos >= max_output_len) { return BASE64_OVERFLOW; }
        var b0: int64 := (v0 << 2) | ((v1 >> 4) & 3);
        StrSetChar(output, out_pos, b0); out_pos := out_pos + 1;

        if (c2 != 61) {
            if (out_pos >= max_output_len) { return BASE64_OVERFLOW; }
            var b1: int64 := ((v1 & 15) << 4) | ((v2 >> 2) & 15);
            StrSetChar(output, out_pos, b1); out_pos := out_pos + 1;
        }

        if (c3 != 61) {
            if (out_pos >= max_output_len) { return BASE64_OVERFLOW; }
            var b2: int64 := ((v2 & 3) << 6) | v3;
            StrSetChar(output, out_pos, b2); out_pos := out_pos + 1;
        }

        j += 4;
    }

    return out_pos;
}

// Decode a Base64 string
// Rueckgabe: Zahl der geschriebenen Bytes, BASE64_INVALID (-1) bei ungueltiger
// Eingabe, BASE64_OVERFLOW (-2) wenn das Ergebnis nicht in max_output_len
// passt. DecodedLen(Eingabelaenge) liefert die noetige Puffergroesse.
pub fn Decode(input: pchar, output: pchar, max_output_len: int64): int64 {
    return decodeWithLookup(input, output, max_output_len, lookupStd());
}

// Decode URL-safe Base64
pub fn DecodeUrlSafe(input: pchar, output: pchar, max_output_len: int64): int64 {
    return decodeWithLookup(input, output, max_output_len, lookupUrl());
}

// Get maximum decoded length for given input length
pub fn DecodedLen(input_len: int64): int64 {
    var blocks: int64 := input_len / 4;
    var result: int64 := blocks * 3;
    return result;
}

// Check if character is valid Base64
pub fn IsValidChar(c: int64): bool {
    if (c >= 65 && c <= 90) { return true; }
    if (c >= 97 && c <= 122) { return true; }
    if (c >= 48 && c <= 57) { return true; }
    if (c == 43 || c == 47) { return true; }
    if (c == 61) { return true; }
    return false;
}

// Check if string is valid Base64
pub fn IsValid(input: pchar): bool {
    var len: int64 := 0;
    var i: int64 := 0;
    while (StrCharAt(input, i) != 0) {
        len += 1;
        i += 1;
    }

    if (len == 0) { return true; }
    if (len % 4 != 0) { return false; }

    i := 0;
    while (i < len) {
        var c: int64 := StrCharAt(input, i);
        if (!IsValidChar(c)) { return false; }
        i += 1;
    }

    return HasValidPadding(input);
}

// Check if string has valid Base64 padding
pub fn HasValidPadding(input: pchar): bool {
    var len: int64 := 0;
    var i: int64 := 0;
    while (StrCharAt(input, i) != 0) {
        len += 1;
        i += 1;
    }

    if (len == 0) { return true; }
    if (len < 2) { return false; }

    // #1409: Hier standen drei Zweige, die zusammen jeden Fall abdeckten und
    // alle `true` lieferten — das abschliessende `return false` war
    // unerreichbar, die Funktion also fuer jede Eingabe ab zwei Zeichen
    // konstant wahr. `IsValid` endete mit ihr und erbte das: `a=b=` galt als
    // gueltig.
    //
    // Geprueft werden jetzt die Regeln aus RFC 4648 §4: '=' steht
    // ausschliesslich am Ende, hoechstens zweimal, und die Gesamtlaenge ist
    // ein Vielfaches von 4.
    if (len % 4 != 0) { return false; }

    // Erstes '=' suchen. Ab dort duerfen nur noch '=' folgen.
    var erstes: int64 := 0 - 1;
    i := 0;
    while (i < len) {
        if (StrCharAt(input, i) == 61) { erstes := i; break; }
        i += 1;
    }

    if (erstes < 0) { return true; }          // gar kein Padding — zulaessig

    var fuellzeichen: int64 := len - erstes;
    if (fuellzeichen > 2) { return false; }   // hoechstens zwei

    i := erstes;
    while (i < len) {
        if (StrCharAt(input, i) != 61) { return false; }   // '=' mitten drin
        i += 1;
    }

    return true;
}

// Strip padding from Base64 string
pub fn StripPadding(input: pchar, output: pchar): int64 {
    var in_len: int64 := 0;
    var i: int64 := 0;
    while (StrCharAt(input, i) != 0) {
        in_len += 1;
        i += 1;
    }

    var out_pos: int64 := 0;
    i := 0;
    while (i < in_len) {
        var c: int64 := StrCharAt(input, i);
        if (c != 61) {
            StrSetChar(output, out_pos, c);
            out_pos += 1;
        }
        i += 1;
    }

    StrSetChar(output, out_pos, 0);
    return out_pos;
}

// Add padding to Base64 string
pub fn AddPadding(input: pchar, output: pchar): int64 {
    var in_len: int64 := 0;
    var i: int64 := 0;
    while (StrCharAt(input, i) != 0) {
        in_len += 1;
        i += 1;
    }

    var out_pos: int64 := 0;
    i := 0;
    while (i < in_len) {
        StrSetChar(output, out_pos, StrCharAt(input, i));
        out_pos += 1;
        i += 1;
    }

    var remainder: int64 := in_len % 4;
    if (remainder == 1) {
        return -1;
    } else if (remainder == 2) {
        StrSetChar(output, out_pos, 61); out_pos := out_pos + 1;
        StrSetChar(output, out_pos, 61); out_pos := out_pos + 1;
    } else if (remainder == 3) {
        StrSetChar(output, out_pos, 61); out_pos := out_pos + 1;
    }

    StrSetChar(output, out_pos, 0);
    return out_pos;
}

// Encode "username:password" for HTTP Basic Auth header
pub fn EncodeBasicAuth(username: pchar, password: pchar, output: pchar): int64 {
    var user_len: int64 := 0;
    var i: int64 := 0;
    while (StrCharAt(username, i) != 0) { user_len := user_len + 1; i := i + 1; }

    var pass_len: int64 := 0;
    i := 0;
    while (StrCharAt(password, i) != 0) { pass_len := pass_len + 1; i := i + 1; }

    // Dieselben zwei Fehler wie in Decode, nur nicht gemeldet: der Puffer war
    // fest 512 Byte gross und wurde ungeprueft beschrieben, und beide
    // Zwischenpuffer wurden nie freigegeben. Ein Passwort ueber die Grenze
    // hinaus schrieb in fremden Speicher.
    if (user_len + pass_len + 2 > 512) { return BASE64_OVERFLOW; }
    if (EncodedLen(user_len + pass_len + 1) + 1 > 1024) { return BASE64_OVERFLOW; }

    var combined: pchar := alloc(512) as pchar;
    var pos: int64 := 0;

    i := 0;
    while (i < user_len) {
        StrSetChar(combined, pos, StrCharAt(username, i));
        pos += 1; i := i + 1;
    }
    StrSetChar(combined, pos, 58); pos := pos + 1;
    i := 0;
    while (i < pass_len) {
        StrSetChar(combined, pos, StrCharAt(password, i));
        pos += 1; i := i + 1;
    }
    StrSetChar(combined, pos, 0);

    var encoded: pchar := alloc(1024) as pchar;
    var encoded_len: int64 := EncodeBytes(combined, pos, encoded);

    var out_pos: int64 := 0;
    StrSetChar(output, out_pos, 66); out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 97); out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 115); out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 105); out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 99); out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 32); out_pos := out_pos + 1;

    i := 0;
    while (i < encoded_len) {
        StrSetChar(output, out_pos, StrCharAt(encoded, i));
        out_pos += 1; i := i + 1;
    }

    StrSetChar(output, out_pos, 0);
    free(combined as int64, 512);
    free(encoded as int64, 1024);
    return out_pos;
}

// Decode HTTP Authorization header into username/password
pub fn DecodeBasicAuth(auth_header: pchar, username: pchar, password: pchar): int64 {
    if (StrCharAt(auth_header, 0) != 66 ||
        StrCharAt(auth_header, 1) != 97 ||
        StrCharAt(auth_header, 2) != 115 ||
        StrCharAt(auth_header, 3) != 105 ||
        StrCharAt(auth_header, 4) != 99 ||
        StrCharAt(auth_header, 5) != 32) {
        return 0;
    }

    var encoded_start: int64 := 6;
    var decoded: pchar := alloc(512) as pchar;
    var decoded_len: int64 := Decode(auth_header + encoded_start, decoded, 512);

    if (decoded_len <= 0) { free(decoded as int64, 512); return 0; }

    var colon_pos: int64 := -1;
    var i: int64 := 0;
    while (i < decoded_len) {
        if (StrCharAt(decoded, i) == 58) { colon_pos := i; break; }
        i += 1;
    }

    if (colon_pos < 0) { free(decoded as int64, 512); return 0; }

    var user_pos: int64 := 0;
    i := 0;
    while (i < colon_pos) {
        StrSetChar(username, user_pos, StrCharAt(decoded, i));
        user_pos += 1; i := i + 1;
    }
    StrSetChar(username, user_pos, 0);

    var pass_pos: int64 := 0;
    i := colon_pos + 1;
    while (i < decoded_len) {
        StrSetChar(password, pass_pos, StrCharAt(decoded, i));
        pass_pos += 1; i := i + 1;
    }
    StrSetChar(password, pass_pos, 0);

    free(decoded as int64, 512);   // war ein Leck je Anfrage
    return 1;
}

// Encode binary data as Data URL: "data:<mime_type>;base64,<data>"
pub fn EncodeDataUrl(mime_type: pchar, data: pchar, output: pchar): int64 {
    var out_pos: int64 := 0;
    var i: int64 := 0;

    StrSetChar(output, out_pos, 100); out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 97);  out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 116); out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 97);  out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 58);  out_pos := out_pos + 1;

    i := 0;
    while (StrCharAt(mime_type, i) != 0) {
        StrSetChar(output, out_pos, StrCharAt(mime_type, i));
        out_pos += 1; i := i + 1;
    }

    StrSetChar(output, out_pos, 59);  out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 98);  out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 97);  out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 115); out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 101); out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 54);  out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 52);  out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 44);  out_pos := out_pos + 1;

    var data_len: int64 := 0;
    i := 0;
    while (StrCharAt(data, i) != 0) { data_len := data_len + 1; i := i + 1; }

    // Auch hier: fester Puffer, ungeprueft beschrieben, nie freigegeben.
    if (EncodedLen(data_len) + 1 > 4096) { return BASE64_OVERFLOW; }
    var encoded: pchar := alloc(4096) as pchar;
    var encoded_len: int64 := EncodeBytes(data, data_len, encoded);

    i := 0;
    while (i < encoded_len) {
        StrSetChar(output, out_pos, StrCharAt(encoded, i));
        out_pos += 1; i := i + 1;
    }

    StrSetChar(output, out_pos, 0);
    free(encoded as int64, 4096);
    return out_pos;
}
