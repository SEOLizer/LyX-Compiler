// std/astro/cr3bp.lyx
// Eingeschraenktes Dreikoerperproblem: Librationspunkte und Jacobi-Konstante.
//
// WARUM EINE EIGENE UNIT: der gesamte uebrige Bestand von std.astro rechnet
// im ZWEIkoerperproblem. AVisViva, APeriod, ASemiMajorAxis und alles Weitere
// setzen ein einziges Gravitationszentrum voraus. Librationspunkte existieren
// in diesem Modell ueberhaupt nicht — sie sind eine Eigenschaft des
// eingeschraenkten Dreikoerperproblems. Es gibt hier also nichts zu
// erweitern; diese Unit steht neben der bestehenden, nicht in ihr.
//
// UMFANG (#1997): diese Unit fuehrt die PUNKTE und die Erhaltungsgroesse.
// Halo-Bahnen — Richardsons Naeherung dritter Ordnung plus Differential
// Correction — sind ausdruecklich NICHT enthalten und werden als eigenes
// Paket gefuehrt. Eine halbe Halo-Bahn waere ein Stub, und die fuehrt dieses
// Repo nicht.
//
// KOORDINATEN: dimensionslos, im mitrotierenden System. Der Abstand der
// beiden Massen ist 1, ihre Summe ist 1, die Winkelgeschwindigkeit ist 1.
// Der Ursprung liegt im gemeinsamen Schwerpunkt; die grosse Masse sitzt bei
// -mu, die kleine bei 1-mu. Das ist die uebliche Form, und sie hat den
// praktischen Vorteil, dass dieselben Zahlen fuer Sonne-Erde und Erde-Mond
// gelten. ADimToMeters rechnet zurueck.

@description("Eingeschraenktes Dreikoerperproblem: Lagrange-Punkte, Jacobi")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.astro.cr3bp;

import std.math;
import std.astro.state;

// ── Massenparameter ───────────────────────────────────────────────────────

// mu = m2 / (m1 + m2), mit m2 als der KLEINEREN Masse.
//
// Die Funktion sortiert nicht selbst. Wer die Massen vertauscht, bekommt ein
// mu ueber 0.5 — und das ist eine ehrliche Antwort auf eine vertauschte
// Eingabe, kein Fehler. Die Punktrechnungen unten pruefen den Bereich.
pub fn ACr3bpMu(m1: f64, m2: f64): f64 {
  if (m1 <= 0.0 || m2 <= 0.0) { return AError(); }
  return m2 / (m1 + m2);
}

// Gebraeuchliche Systeme. Die Werte stammen aus den Massenverhaeltnissen,
// nicht aus einer eigenen Anpassung.
pub fn AMuSunEarth(): f64 { return 0.000003003480; }   // Erde+Mond gegen Sonne
pub fn AMuEarthMoon(): f64 { return 0.012150585; }
pub fn AMuSunJupiter(): f64 { return 0.000953875; }

// ── Hill-Radius ───────────────────────────────────────────────────────────
//
//   r_hill = a * (mu/3)^(1/3)
//
// Die Groessenordnung, in der die kleinere Masse gravitativ das Sagen hat —
// und zugleich der Startwert fuer die Punkte L1 und L2, die beide dicht
// daneben liegen.
pub fn AHillRadius(a: f64, mu: f64): f64 {
  if (a <= 0.0 || mu <= 0.0 || mu >= 1.0) { return AError(); }
  return a * PowF64(mu / 3.0, 1.0 / 3.0);
}

// ── Die kollinearen Punkte ────────────────────────────────────────────────
//
// L1, L2 und L3 liegen auf der Verbindungslinie. Ihre Lage folgt aus einem
// Polynom fuenften Grades, das sich nicht geschlossen loesen laesst; geloest
// wird per Newton, mit dem Hill-Radius als Startwert.
//
// Die drei Polynome unterscheiden sich nur in Vorzeichen. Sie stehen
// trotzdem getrennt und nicht als ein Rumpf mit Schaltern: ein Vorzeichen im
// falschen Zweig faellt in getrenntem Code auf, in einem geteilten nicht.

// Newton auf einem Polynom fuenften Grades, gegeben durch seine sechs
// Koeffizienten (c5..c0). Gemeinsamer Rumpf fuer die drei Punkte — hier ist
// das Teilen richtig, weil nur das VERFAHREN geteilt wird, nicht die Physik.
fn _newtonQuintic(c5: f64, c4: f64, c3: f64, c2: f64, c1: f64, c0: f64,
                  start: f64): f64 {
  var x: f64 := start;
  var i: int64 := 0;
  while (i < 200) {
    var f: f64 := (((((c5 * x) + c4) * x + c3) * x + c2) * x + c1) * x + c0;
    var d: f64 := ((((5.0 * c5 * x) + 4.0 * c4) * x + 3.0 * c3) * x
                   + 2.0 * c2) * x + c1;
    if (d == 0.0) { return AError(); }
    var xn: f64 := x - f / d;
    var s: f64 := xn - x;
    if (s < 0.0) { s := 0.0 - s; }
    x := xn;
    if (s < 0.000000000001) { return x; }
    i := i + 1;
  }
  return AError();                     // keine Konvergenz: melden, nicht raten
}

// Abstand von L1 zur KLEINEREN Masse, dimensionslos.
//
//   g^5 - (3-mu)g^4 + (3-2mu)g^3 - mu*g^2 + 2mu*g - mu = 0
pub fn ALagrange1Gamma(mu: f64): f64 {
  if (mu <= 0.0 || mu >= 1.0) { return AError(); }
  var g0: f64 := PowF64(mu / 3.0, 1.0 / 3.0);
  return _newtonQuintic(1.0, 0.0 - (3.0 - mu), 3.0 - 2.0 * mu,
                        0.0 - mu, 2.0 * mu, 0.0 - mu, g0);
}

// Abstand von L2 zur kleineren Masse, dimensionslos.
//
//   g^5 + (3-mu)g^4 + (3-2mu)g^3 - mu*g^2 - 2mu*g - mu = 0
pub fn ALagrange2Gamma(mu: f64): f64 {
  if (mu <= 0.0 || mu >= 1.0) { return AError(); }
  var g0: f64 := PowF64(mu / 3.0, 1.0 / 3.0);
  return _newtonQuintic(1.0, 3.0 - mu, 3.0 - 2.0 * mu,
                        0.0 - mu, 0.0 - 2.0 * mu, 0.0 - mu, g0);
}

// Abstand von L3 zur GROESSEREN Masse, dimensionslos — knapp unter 1, denn
// L3 liegt fast spiegelbildlich zur kleinen Masse.
//
//   g^5 + (2+mu)g^4 + (1+2mu)g^3 - (1-mu)g^2 - 2(1-mu)g - (1-mu) = 0
pub fn ALagrange3Gamma(mu: f64): f64 {
  if (mu <= 0.0 || mu >= 1.0) { return AError(); }
  var q: f64 := 1.0 - mu;
  return _newtonQuintic(1.0, 2.0 + mu, 1.0 + 2.0 * mu,
                        0.0 - q, 0.0 - 2.0 * q, 0.0 - q, 1.0);
}

// Die Punkte als Ortsvektoren im mitrotierenden System.
// Die kleine Masse sitzt bei x = 1-mu, die grosse bei x = -mu.
pub fn ALagrange1(mu: f64): AVec3 {
  var g: f64 := ALagrange1Gamma(mu);
  if (AIsError(g)) { return AVec(g, g, g); }
  return AVec(1.0 - mu - g, 0.0, 0.0);
}

pub fn ALagrange2(mu: f64): AVec3 {
  var g: f64 := ALagrange2Gamma(mu);
  if (AIsError(g)) { return AVec(g, g, g); }
  return AVec(1.0 - mu + g, 0.0, 0.0);
}

pub fn ALagrange3(mu: f64): AVec3 {
  var g: f64 := ALagrange3Gamma(mu);
  if (AIsError(g)) { return AVec(g, g, g); }
  return AVec(0.0 - mu - g, 0.0, 0.0);
}

// ── Die Dreieckspunkte ────────────────────────────────────────────────────
//
// L4 und L5 sind geschlossen bestimmt: sie bilden mit BEIDEN Massen ein
// gleichseitiges Dreieck der Seitenlaenge 1. Kein Newton, keine Naeherung —
// und damit die einzige Stelle dieser Unit, an der eine Pruefung ohne
// Literaturwert auskommt.
pub fn ALagrange4(mu: f64): AVec3 {
  if (mu <= 0.0 || mu >= 1.0) { return AVec(AError(), AError(), AError()); }
  return AVec(0.5 - mu, SqrtF64(3.0) / 2.0, 0.0);
}

pub fn ALagrange5(mu: f64): AVec3 {
  if (mu <= 0.0 || mu >= 1.0) { return AVec(AError(), AError(), AError()); }
  return AVec(0.5 - mu, 0.0 - SqrtF64(3.0) / 2.0, 0.0);
}

// ── Zurueck in Meter ──────────────────────────────────────────────────────
//
// Dimensionslos ist zum Rechnen richtig und zum Ablesen unbrauchbar. Diese
// Funktion nimmt den Abstand der beiden Massen und liefert Meter.
pub fn ADimToMeters(v: AVec3, separation: f64): AVec3 {
  if (separation <= 0.0) { return AVec(AError(), AError(), AError()); }
  return AScale(v, separation);
}

// Abstand eines Punktes von der KLEINEREN Masse, in Metern — die Form, in
// der L1- und L2-Abstaende ueblicherweise angegeben werden ("JWST steht 1.5
// Millionen Kilometer hinter der Erde").
pub fn ADistanceToSecondary(p: AVec3, mu: f64, separation: f64): f64 {
  if (separation <= 0.0 || mu <= 0.0 || mu >= 1.0) { return AError(); }
  var d: AVec3 := ASub(p, AVec(1.0 - mu, 0.0, 0.0));
  return AMagnitude(d) * separation;
}

// ── Jacobi-Konstante ──────────────────────────────────────────────────────
//
//   C = 2*U - v^2,   U = (x^2+y^2)/2 + (1-mu)/r1 + mu/r2
//
// Die einzige Erhaltungsgroesse des Problems. Sie ist nicht Zierde, sondern
// das Pruefmittel: bleibt sie entlang einer fortgeschriebenen Bahn nicht
// stehen, stimmen die Bewegungsgleichungen nicht. Ein Vorzeichenfehler faellt
// so auf, ein Ergebnisvergleich wuerde ihn verdecken.
pub fn AJacobiConstant(mu: f64, pos: AVec3, vel: AVec3): f64 {
  if (mu <= 0.0 || mu >= 1.0) { return AError(); }
  var d1: AVec3 := ASub(pos, AVec(0.0 - mu, 0.0, 0.0));
  var d2: AVec3 := ASub(pos, AVec(1.0 - mu, 0.0, 0.0));
  var r1: f64 := AMagnitude(d1);
  var r2: f64 := AMagnitude(d2);
  if (r1 == 0.0 || r2 == 0.0) { return AError(); }   // auf einer Masse
  var u: f64 := (pos.x * pos.x + pos.y * pos.y) / 2.0
              + (1.0 - mu) / r1 + mu / r2;
  var v2: f64 := ADot(vel, vel);
  return 2.0 * u - v2;
}

// Das effektive Potential allein — dieselbe Groesse ohne den Geschwindigkeits-
// anteil. An jedem der fuenf Punkte ist sein Gradient null; das ist die
// definierende Eigenschaft und damit die Pruefung, die ohne Literaturwert
// auskommt.
pub fn AEffectivePotential(mu: f64, pos: AVec3): f64 {
  if (mu <= 0.0 || mu >= 1.0) { return AError(); }
  var d1: AVec3 := ASub(pos, AVec(0.0 - mu, 0.0, 0.0));
  var d2: AVec3 := ASub(pos, AVec(1.0 - mu, 0.0, 0.0));
  var r1: f64 := AMagnitude(d1);
  var r2: f64 := AMagnitude(d2);
  if (r1 == 0.0 || r2 == 0.0) { return AError(); }
  return (pos.x * pos.x + pos.y * pos.y) / 2.0
       + (1.0 - mu) / r1 + mu / r2;
}
