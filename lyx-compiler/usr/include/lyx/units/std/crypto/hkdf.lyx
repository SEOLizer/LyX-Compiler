// std/crypto/hkdf.lyx — HMAC (RFC 2104) und HKDF (RFC 5869) ueber SHA-2,
// dazu HKDF-Expand-Label aus TLS 1.3 (RFC 8446 §7.1).
//
// Teil von #2096 (natives TLS ohne OpenSSL). Der Schluesselplan von TLS 1.3
// besteht aus nichts als Extract/Expand-Aufrufen; TLS 1.2 braucht dieselbe
// HMAC-Maschine fuer die PRF.
//
// Der Hash wird ueber `alg` gewaehlt — und zwar als DIGESTLAENGE in Byte:
//   32 = SHA-256, 48 = SHA-384, 64 = SHA-512.
// Das ist kein Enum, weil `as` in einen Enum nichts prueft (#1884) und ein
// `pub con` ueber Unit-Grenzen still -1 liefern kann (#2102). Ein unbekannter
// Wert scheitert laut (panic), er faellt nicht still auf SHA-256 zurueck.
//
// Oeffentliche API:
//   HmacCtxSize() / HmacInit(ctx, alg, key, keyLen) / HmacUpdate / HmacFinal
//   HmacHash(alg, key, keyLen, data, dataLen, out)
//   HkdfExtract(alg, salt, saltLen, ikm, ikmLen, prkOut)
//   HkdfExpand(alg, prk, prkLen, info, infoLen, out, outLen): bool
//   HkdfExpandLabel(alg, secret, label, labelLen, ctx, ctxLen, out, outLen): bool
//   HkdfDeriveSecret(alg, secret, label, labelLen, msgHash, out)

unit std.crypto.hkdf;

import std.alloc;
import std.crypto.sha256;
import std.crypto.sha512;

// ---------------------------------------------------------------------------
// Hash-Auswahl
// ---------------------------------------------------------------------------

// Blockgroesse der Kompressionsfunktion: 64 Byte bei SHA-256,
// 128 bei SHA-384/512 (RFC 4868).
fn hkdfBlockSize(alg: int64): int64 {
    if (alg == 32) { return 64; }
    if (alg == 48) { return 128; }
    if (alg == 64) { return 128; }
    panic("HKDF: unbekannte Digestlaenge — erlaubt sind 32, 48, 64");
    return 0;
}

fn hkdfHashCtxSize(): int64 {
    var a: int64 := Sha256CtxSize();
    var b: int64 := Sha512CtxSize();
    if (a > b) { return a; }
    return b;
}

fn hkdfHashInit(alg: int64, hctx: int64): void {
    if (alg == 32) { Sha256Init(hctx); return; }
    if (alg == 48) { Sha384Init(hctx); return; }
    if (alg == 64) { Sha512Init(hctx); return; }
    panic("HKDF: unbekannte Digestlaenge — erlaubt sind 32, 48, 64");
}

fn hkdfHashUpdate(alg: int64, hctx: int64, data: int64, len: int64): void {
    if (alg == 32) { Sha256Update(hctx, data, len); return; }
    if (alg == 48) { Sha512Update(hctx, data, len); return; }
    if (alg == 64) { Sha512Update(hctx, data, len); return; }
    panic("HKDF: unbekannte Digestlaenge — erlaubt sind 32, 48, 64");
}

fn hkdfHashFinal(alg: int64, hctx: int64, out: int64): void {
    if (alg == 32) { Sha256Final(hctx, out); return; }
    if (alg == 48) { Sha384Final(hctx, out); return; }
    if (alg == 64) { Sha512Final(hctx, out); return; }
    panic("HKDF: unbekannte Digestlaenge — erlaubt sind 32, 48, 64");
}

fn hkdfHashOneShot(alg: int64, data: int64, len: int64, out: int64): void {
    var hctx: int64 := alloc(hkdfHashCtxSize());
    if (hctx == 0) { panic("HKDF: kein Speicher fuer den Hashzustand"); }
    hkdfHashInit(alg, hctx);
    hkdfHashUpdate(alg, hctx, data, len);
    hkdfHashFinal(alg, hctx, out);
    free(hctx, hkdfHashCtxSize());
}

// ---------------------------------------------------------------------------
// HMAC (RFC 2104)
//
// Zustandslayout:
//   +0    alg (Digestlaenge)
//   +8    innerer Hashzustand (hkdfHashCtxSize Byte, derzeit 208)
//   +216  Blockpuffer fuer den aeusseren Durchgang (128 Byte, K xor opad)
// ---------------------------------------------------------------------------

con HMAC_ALG_OFF:  int64 := 0;
con HMAC_H_OFF:    int64 := 8;
con HMAC_OPAD_OFF: int64 := 216;
con HMAC_CTX_SIZE: int64 := 344;

pub fn HmacCtxSize(): int64 {
    return HMAC_CTX_SIZE;
}

pub fn HmacInit(ctx: int64, alg: int64, key: int64, keyLen: int64): void {
    var bs: int64 := hkdfBlockSize(alg);
    poke64(ctx + HMAC_ALG_OFF, alg);

    // K0: Schluessel auf Blocklaenge bringen — laengere Schluessel werden
    // gehasht (RFC 2104 §2), kuerzere mit Nullen aufgefuellt.
    var k0: int64 := alloc(bs);
    if (k0 == 0) { panic("HMAC: kein Speicher fuer den Schluesselblock"); }
    var i: int64 := 0;
    while (i < bs) { poke8(k0 + i, 0); i := i + 1; }
    if (keyLen > bs) {
        hkdfHashOneShot(alg, key, keyLen, k0);
    } else {
        i := 0;
        while (i < keyLen) { poke8(k0 + i, peek8(key + i)); i := i + 1; }
    }

    // ipad in den inneren Hash, opad fuer spaeter merken.
    var ipad: int64 := alloc(bs);
    if (ipad == 0) { panic("HMAC: kein Speicher fuer den ipad-Block"); }
    i := 0;
    while (i < bs) {
        var kb: int64 := peek8(k0 + i);
        poke8(ipad + i, kb ^ 0x36);
        poke8(ctx + HMAC_OPAD_OFF + i, kb ^ 0x5C);
        i += 1;
    }

    hkdfHashInit(alg, ctx + HMAC_H_OFF);
    hkdfHashUpdate(alg, ctx + HMAC_H_OFF, ipad, bs);

    // Schluesselabhaengige Zwischenstaende nicht liegen lassen.
    i := 0;
    while (i < bs) { poke8(k0 + i, 0); poke8(ipad + i, 0); i := i + 1; }
    free(k0, bs);
    free(ipad, bs);
}

pub fn HmacUpdate(ctx: int64, data: int64, len: int64): void {
    hkdfHashUpdate(peek64(ctx + HMAC_ALG_OFF), ctx + HMAC_H_OFF, data, len);
}

// Schreibt alg Byte (32/48/64) nach out.
pub fn HmacFinal(ctx: int64, out: int64): void {
    var alg: int64 := peek64(ctx + HMAC_ALG_OFF);
    var bs: int64 := hkdfBlockSize(alg);

    var inner: int64 := alloc(alg);
    if (inner == 0) { panic("HMAC: kein Speicher fuer den inneren Digest"); }
    hkdfHashFinal(alg, ctx + HMAC_H_OFF, inner);

    hkdfHashInit(alg, ctx + HMAC_H_OFF);
    hkdfHashUpdate(alg, ctx + HMAC_H_OFF, ctx + HMAC_OPAD_OFF, bs);
    hkdfHashUpdate(alg, ctx + HMAC_H_OFF, inner, alg);
    hkdfHashFinal(alg, ctx + HMAC_H_OFF, out);

    // Zwischenwerte loeschen: der innere Digest und der Schluesselblock sind
    // schluesselabhaengig. Der Zustand ist danach verbraucht, ein weiteres
    // HmacUpdate darauf waere ein Fehler.
    var i: int64 := 0;
    while (i < alg) { poke8(inner + i, 0); i := i + 1; }
    i := 0;
    while (i < bs) { poke8(ctx + HMAC_OPAD_OFF + i, 0); i := i + 1; }
    free(inner, alg);
}

// Einzelaufruf: HMAC-SHA-alg(key, data) nach out (alg Byte).
pub fn HmacHash(alg: int64, key: int64, keyLen: int64,
                data: int64, dataLen: int64, out: int64): void {
    var ctx: int64 := alloc(HMAC_CTX_SIZE);
    if (ctx == 0) { panic("HMAC: kein Speicher fuer den Zustand"); }
    HmacInit(ctx, alg, key, keyLen);
    HmacUpdate(ctx, data, dataLen);
    HmacFinal(ctx, out);
    free(ctx, HMAC_CTX_SIZE);
}

// ---------------------------------------------------------------------------
// HKDF (RFC 5869)
// ---------------------------------------------------------------------------

// PRK = HMAC(salt, IKM); salt darf 0/0 sein (dann alg Nullbytes, §2.2).
// prkOut nimmt alg Byte auf.
pub fn HkdfExtract(alg: int64, salt: int64, saltLen: int64,
                   ikm: int64, ikmLen: int64, prkOut: int64): void {
    if (salt == 0 || saltLen == 0) {
        var zero: int64 := alloc(alg);
        if (zero == 0) { panic("HKDF: kein Speicher fuer das Nullsalz"); }
        var i: int64 := 0;
        while (i < alg) { poke8(zero + i, 0); i := i + 1; }
        HmacHash(alg, zero, alg, ikm, ikmLen, prkOut);
        free(zero, alg);
        return;
    }
    HmacHash(alg, salt, saltLen, ikm, ikmLen, prkOut);
}

// OKM nach out (outLen Byte). Liefert false, wenn outLen die Grenze
// 255*alg ueberschreitet (RFC 5869 §2.3) — kein stiller Kurzschluss.
pub fn HkdfExpand(alg: int64, prk: int64, prkLen: int64,
                  info: int64, infoLen: int64, out: int64, outLen: int64): bool {
    if (outLen < 0) { return false; }
    if (outLen > 255 * alg) { return false; }
    if (outLen == 0) { return true; }

    var t: int64 := alloc(alg);
    var ctx: int64 := alloc(HMAC_CTX_SIZE);
    if (t == 0 || ctx == 0) { panic("HKDF: kein Speicher fuer Expand"); }

    var done: int64 := 0;
    var counter: int64 := 1;
    var tLen: int64 := 0;           // 0 im ersten Durchgang, danach alg
    while (done < outLen) {
        HmacInit(ctx, alg, prk, prkLen);
        if (tLen > 0) { HmacUpdate(ctx, t, tLen); }
        if (infoLen > 0) { HmacUpdate(ctx, info, infoLen); }
        var cbuf: int64 := alloc(1);
        poke8(cbuf, counter & 0xFF);
        HmacUpdate(ctx, cbuf, 1);
        free(cbuf, 1);
        HmacFinal(ctx, t);
        tLen := alg;

        var take: int64 := alg;
        if (outLen - done < take) { take := outLen - done; }
        var i: int64 := 0;
        while (i < take) { poke8(out + done + i, peek8(t + i)); i := i + 1; }
        done += take;
        counter += 1;
    }

    var z: int64 := 0;
    while (z < alg) { poke8(t + z, 0); z := z + 1; }
    free(t, alg);
    free(ctx, HMAC_CTX_SIZE);
    return true;
}

// ---------------------------------------------------------------------------
// TLS 1.3 (RFC 8446 §7.1)
//
//   HkdfLabel = uint16 length | opaque label<7..255> ("tls13 " + label)
//                             | opaque context<0..255>
// ---------------------------------------------------------------------------

pub fn HkdfExpandLabel(alg: int64, secret: int64, secretLen: int64,
                       label: int64, labelLen: int64,
                       context: int64, contextLen: int64,
                       out: int64, outLen: int64): bool {
    // "tls13 " sind 6 Byte; das Laengenfeld fasst hoechstens 255.
    if (labelLen < 0 || labelLen > 249) { return false; }
    if (contextLen < 0 || contextLen > 255) { return false; }
    if (outLen < 0 || outLen > 65535) { return false; }

    var total: int64 := 2 + 1 + 6 + labelLen + 1 + contextLen;
    var buf: int64 := alloc(total);
    if (buf == 0) { panic("HKDF-Expand-Label: kein Speicher"); }
    var p: int64 := 0;
    poke8(buf + p, (outLen >> 8) & 0xFF); p += 1;
    poke8(buf + p, outLen & 0xFF);        p += 1;
    poke8(buf + p, 6 + labelLen);         p += 1;
    poke8(buf + p, 116); p += 1;   // 't'
    poke8(buf + p, 108); p += 1;   // 'l'
    poke8(buf + p, 115); p += 1;   // 's'
    poke8(buf + p,  49); p += 1;   // '1'
    poke8(buf + p,  51); p += 1;   // '3'
    poke8(buf + p,  32); p += 1;   // ' '
    var i: int64 := 0;
    while (i < labelLen) { poke8(buf + p, peek8(label + i)); p += 1; i += 1; }
    poke8(buf + p, contextLen); p += 1;
    i := 0;
    while (i < contextLen) { poke8(buf + p, peek8(context + i)); p += 1; i += 1; }

    var ok: bool := HkdfExpand(alg, secret, secretLen, buf, total, out, outLen);
    free(buf, total);
    return ok;
}

// Derive-Secret(Secret, Label, Messages) mit bereits gebildetem
// Transkript-Hash (alg Byte). Schreibt alg Byte nach out.
pub fn HkdfDeriveSecret(alg: int64, secret: int64, secretLen: int64,
                        label: int64, labelLen: int64,
                        msgHash: int64, out: int64): bool {
    return HkdfExpandLabel(alg, secret, secretLen, label, labelLen,
                           msgHash, alg, out, alg);
}
