// std/crypto/rsa.lyx — RSA-PKCS1v15 via OpenSSL EVP (WP-GCP-01)
//
// Public API:
//   RSAKeyLoad(pem: int64, pemLen: int64) -> int64  (EVP_PKEY* as int64, or 0)
//   RSAKeyFree(key: int64)
//   RSASign(key: int64, data: int64, dataLen: int64, sig: int64, sigLen: int64) -> int64
//   RSAKeyBits(key: int64) -> int64

unit std.crypto.rsa;

import std.alloc;

// OpenSSL libcrypto EVP / BIO functions
extern fn BIO_new_mem_buf(buf: int64, len: int64): int64 link "libcrypto.so.3";
extern fn BIO_free(bio: int64): int64 link "libcrypto.so.3";
extern fn PEM_read_bio_PrivateKey(bp: int64, x: int64, cb: int64, u: int64): int64 link "libcrypto.so.3";
extern fn EVP_MD_CTX_new(): int64 link "libcrypto.so.3";
extern fn EVP_MD_CTX_free(ctx: int64) link "libcrypto.so.3";
extern fn EVP_sha256(): int64 link "libcrypto.so.3";
extern fn EVP_DigestSignInit(ctx: int64, pctx: int64, md: int64, e: int64, pkey: int64): int64 link "libcrypto.so.3";
extern fn EVP_DigestSignUpdate(ctx: int64, data: int64, dsize: int64): int64 link "libcrypto.so.3";
extern fn EVP_DigestSignFinal(ctx: int64, sigret: int64, siglen: int64): int64 link "libcrypto.so.3";
extern fn EVP_PKEY_free(key: int64) link "libcrypto.so.3";
extern fn EVP_PKEY_get_bits(key: int64): int64 link "libcrypto.so.3";

// RSAKeyLoad — load RSA private key from PEM bytes.
// pem: pointer to PEM data (not necessarily null-terminated)
// pemLen: byte count (-1 for null-terminated)
// Returns EVP_PKEY* cast to int64, or 0 on failure.
pub fn RSAKeyLoad(pem: int64, pemLen: int64): int64 {
    var bio: int64 := BIO_new_mem_buf(pem, pemLen);
    if (bio == 0) { return 0; }
    var key: int64 := PEM_read_bio_PrivateKey(bio, 0, 0, 0);
    BIO_free(bio);
    return key;
}

// RSAKeyFree — releases an EVP_PKEY loaded by RSAKeyLoad.
pub fn RSAKeyFree(key: int64): void {
    if (key != 0) { EVP_PKEY_free(key); }
}

// RSAKeyBits — returns key size in bits (e.g. 2048, 4096).
pub fn RSAKeyBits(key: int64): int64 {
    if (key == 0) { return 0; }
    return EVP_PKEY_get_bits(key);
}

// RSASign — produce PKCS1v15 SHA-256 signature.
// key:     EVP_PKEY* from RSAKeyLoad
// data:    pointer to bytes to sign
// dataLen: byte count
// sig:     output buffer (must be >= key size in bytes, i.e. RSAKeyBits(key)/8)
// sigLenOut: pointer to int64 that receives actual signature length
// Returns 1 on success, 0 on failure.
pub fn RSASign(key: int64, data: int64, dataLen: int64, sig: int64, sigLenOut: int64): int64 {
    if (key == 0) { return 0; }
    var ctx: int64 := EVP_MD_CTX_new();
    if (ctx == 0) { return 0; }
    var md: int64 := EVP_sha256();
    var rc: int64 := EVP_DigestSignInit(ctx, 0, md, 0, key);
    if (rc != 1) { EVP_MD_CTX_free(ctx); return 0; }
    rc := EVP_DigestSignUpdate(ctx, data, dataLen);
    if (rc != 1) { EVP_MD_CTX_free(ctx); return 0; }
    // First call with sig=0 to get required length
    var lenBuf: int64 := alloc(8);
    poke64(lenBuf, 0);
    rc := EVP_DigestSignFinal(ctx, 0, lenBuf);
    if (rc != 1) { EVP_MD_CTX_free(ctx); free(lenBuf, 8); return 0; }
    // Second call to actually produce signature
    rc := EVP_DigestSignFinal(ctx, sig, lenBuf);
    var sigLen: int64 := peek64(lenBuf);
    if (sigLenOut != 0) { poke64(sigLenOut, sigLen); }
    free(lenBuf, 8);
    EVP_MD_CTX_free(ctx);
    if (rc != 1) { return 0; }
    return 1;
}
