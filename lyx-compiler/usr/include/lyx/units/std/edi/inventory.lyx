// std/edi/inventory.lyx — Stock & sales: INVRPT + SLSRPT + SLSFCT (WP-EDI-07)
//
// INVRPT (BGM 35):  inventory report per article+warehouse, stock type
//   1=on-hand, 2=on-order, 3=in-transit (via QTY qualifier 1/2/3)
// SLSRPT (BGM 843): sales report per article+POS, period (617=week/610=month/102=day)
// SLSFCT (BGM 844): sales forecast — same as SLSRPT + FTX+ACB confidence (0-100)
//
// EdiInventoryLine (EDI_INV_LINE_SIZE bytes): GTIN, warehouse GLN, qty, unit, stock type
// EdiSalesLine (EDI_SLS_LINE_SIZE bytes): GTIN, POS GLN, period qual, date, qty, revenue, currency, confidence
//
// Public API:
//   EdiInvrptWrite(refNum, date, lines, lineCount, out, outMax) → bytes
//   EdiInvrptRead(buf, bufLen, lines, maxLines)                 → lineCount
//   EdiSlsrptWrite(refNum, date, lines, lineCount, out, outMax) → bytes
//   EdiSlsrptRead(buf, bufLen, lines, maxLines)                 → lineCount
//   EdiSlsfctWrite(refNum, date, lines, lineCount, out, outMax) → bytes
//   EdiSlsfctRead(buf, bufLen, lines, maxLines)                 → lineCount

unit std.edi.inventory;

import std.edi.core;
import std.alloc;

// ── EdiInventoryLine field offsets ────────────────────────────────────────────
pub con EDI_INV_LINE_GTIN:      int64 := 0;
pub con EDI_INV_LINE_GTINLEN:   int64 := 8;
pub con EDI_INV_LINE_WAREHOUSE: int64 := 16;   // ptr to warehouse GLN string
pub con EDI_INV_LINE_WHLEN:     int64 := 24;
pub con EDI_INV_LINE_QTY:       int64 := 32;
pub con EDI_INV_LINE_UNIT:      int64 := 40;   // ptr to unit-of-measure string
pub con EDI_INV_LINE_UNITLEN:   int64 := 48;
pub con EDI_INV_LINE_TYPE:      int64 := 56;   // 1=on-hand 2=on-order 3=in-transit
pub con EDI_INV_LINE_SIZE:      int64 := 64;

// ── EdiSalesLine field offsets ────────────────────────────────────────────────
pub con EDI_SLS_LINE_GTIN:       int64 := 0;
pub con EDI_SLS_LINE_GTINLEN:    int64 := 8;
pub con EDI_SLS_LINE_POSGLN:     int64 := 16;   // ptr to POS GLN string
pub con EDI_SLS_LINE_POSGLNLEN:  int64 := 24;
pub con EDI_SLS_LINE_PERIOD:     int64 := 32;   // period qualifier: 617=week, 610=month, 102=day
pub con EDI_SLS_LINE_DATE:       int64 := 40;   // ptr to period start date
pub con EDI_SLS_LINE_DATELEN:    int64 := 48;
pub con EDI_SLS_LINE_QTY:        int64 := 56;
pub con EDI_SLS_LINE_REVENUE:    int64 := 64;   // ×100 fixed-point (e.g. 199999 = 1999.99)
pub con EDI_SLS_LINE_CURRENCY:   int64 := 72;   // ptr to 3-char currency code
pub con EDI_SLS_LINE_CURRENCYLEN:int64 := 80;
pub con EDI_SLS_LINE_CONFIDENCE: int64 := 88;   // 0-100 forecast confidence (SLSFCT only)
pub con EDI_SLS_LINE_SIZE:       int64 := 96;

// ─────────────────────────────────────────────────────────────────────────────
// Private helpers
// ─────────────────────────────────────────────────────────────────────────────

fn invStrLen(ptr: int64): int64 {
    var n: int64 := 0;
    while (peek8(ptr + n) != 0) { n := n + 1; }
    return n;
}

fn invPutChar(out: int64, pos: int64, outMax: int64, ch: int64): int64 {
    if (pos < 0) { return 0 - 1; }
    if (pos >= outMax) { return 0 - 1; }
    poke8(out + pos, ch);
    return pos + 1;
}

fn invPutStr(out: int64, pos: int64, outMax: int64, src: int64, n: int64): int64 {
    if (pos < 0) { return 0 - 1; }
    var i: int64 := 0;
    while (i < n) {
        if (pos + i >= outMax) { return 0 - 1; }
        poke8(out + pos + i, peek8(src + i));
        i += 1;
    }
    return pos + n;
}

fn invPutInt(out: int64, pos: int64, outMax: int64, val: int64): int64 {
    if (pos < 0) { return 0 - 1; }
    if (val < 0)  { return 0 - 1; }
    if (val == 0) { return invPutChar(out, pos, outMax, 48); }
    var tmp: int64 := val;
    var digits: int64 := 0;
    while (tmp > 0) { tmp := tmp / 10; digits := digits + 1; }
    var buf: int64 := alloc(24);
    tmp := val;
    var idx: int64 := 1;
    while (idx <= digits) {
        var d: int64 := tmp - (tmp / 10) * 10;
        poke8(buf + digits - idx, 48 + d);
        tmp := tmp / 10;
        idx += 1;
    }
    var r: int64 := invPutStr(out, pos, outMax, buf, digits);
    free(buf, 24);
    return r;
}

// Write revenue as NNN.NN (val is ×100 fixed-point)
fn invPutRevenue(out: int64, pos: int64, outMax: int64, val: int64): int64 {
    var euros: int64 := val / 100;
    var cents: int64 := val - euros * 100;
    pos := invPutInt(out, pos, outMax, euros);
    pos := invPutChar(out, pos, outMax, 46);   // '.'
    if (cents < 10) { pos := invPutChar(out, pos, outMax, 48); }
    pos := invPutInt(out, pos, outMax, cents);
    return pos;
}

fn invParseInt(ptr: int64, len: int64): int64 {
    var v: int64 := 0;
    var i: int64 := 0;
    while (i < len) {
        var c: int64 := peek8(ptr + i);
        if (c >= 48 && c <= 57) { v := v * 10 + (c - 48); }
        i += 1;
    }
    return v;
}

// Parse NNN.NN or NNN,NN → ×100 int64
fn invParseRevenue(ptr: int64, len: int64): int64 {
    var v: int64 := 0;
    var afterDot: int64 := 0;
    var decimals: int64 := 0;
    var i: int64 := 0;
    while (i < len) {
        var c: int64 := peek8(ptr + i);
        if (c == 46 || c == 44) {
            afterDot := 1;
        } else {
            if (c >= 48 && c <= 57) {
                v := v * 10 + (c - 48);
                if (afterDot == 1) { decimals := decimals + 1; }
            }
        }
        i += 1;
    }
    if (afterDot == 0) { v := v * 100; }
    if (decimals == 1) { v := v * 10; }
    return v;
}

fn invTagIs(seg: int64, t0: int64, t1: int64, t2: int64): int64 {
    var p: int64 := peek64(seg + EDI_SEG_PTR);
    if (p == 0) { return 0; }
    if (peek8(p) != t0) { return 0; }
    if (peek8(p+1) != t1) { return 0; }
    if (peek8(p+2) != t2) { return 0; }
    return 1;
}

fn invElemPtr(elems: int64, idx: int64): int64 {
    return peek64(elems + idx * EDI_ELEM_SIZE + EDI_ELEM_PTR);
}
fn invElemLen(elems: int64, idx: int64): int64 {
    return peek64(elems + idx * EDI_ELEM_SIZE + EDI_ELEM_LEN);
}

// Common write header: BGM+code+refNum+9' and DTM+137:date:102'
fn invWriteHeader(out: int64, outMax: int64, bgmCode: int64, bgmCodeLen: int64, refNum: int64, date: int64): int64 {
    var pos: int64 := 0;
    var refLen: int64 := 0;
    if (refNum != 0) { refLen := invStrLen(refNum); }

    pos := invPutStr(out, pos, outMax, "BGM"c as int64, 3);
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := invPutStr(out, pos, outMax, bgmCode, bgmCodeLen);
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    if (refLen > 0) { pos := invPutStr(out, pos, outMax, refNum, refLen); }
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := invPutChar(out, pos, outMax, 57);
    pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);

    if (date != 0) {
        pos := invPutStr(out, pos, outMax, "DTM"c as int64, 3);
        pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := invPutStr(out, pos, outMax, "137"c as int64, 3);
        pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := invPutStr(out, pos, outMax, date, 8);
        pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := invPutStr(out, pos, outMax, "102"c as int64, 3);
        pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);
    }
    return pos;
}

// Common: write LIN+n++GTIN:SRV'
fn invWriteLin(out: int64, pos: int64, outMax: int64, n: int64, gtinPtr: int64, gtinLen: int64): int64 {
    pos := invPutStr(out, pos, outMax, "LIN"c as int64, 3);
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := invPutInt(out, pos, outMax, n);
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    if (gtinPtr != 0 && gtinLen > 0) {
        pos := invPutStr(out, pos, outMax, gtinPtr, gtinLen);
        pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := invPutStr(out, pos, outMax, "SRV"c as int64, 3);
    }
    pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);
    return pos;
}

// Common: write LOC+9:glnValue'
fn invWriteLoc(out: int64, pos: int64, outMax: int64, glnPtr: int64, glnLen: int64): int64 {
    pos := invPutStr(out, pos, outMax, "LOC"c as int64, 3);
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := invPutChar(out, pos, outMax, 57);   // '9'
    pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
    if (glnPtr != 0 && glnLen > 0) {
        pos := invPutStr(out, pos, outMax, glnPtr, glnLen);
    }
    pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);
    return pos;
}

// Common: write CNT+2:count'
fn invWriteCnt(out: int64, pos: int64, outMax: int64, cnt: int64): int64 {
    pos := invPutStr(out, pos, outMax, "CNT"c as int64, 3);
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := invPutChar(out, pos, outMax, 50);
    pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
    pos := invPutInt(out, pos, outMax, cnt);
    pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);
    return pos;
}

// ─────────────────────────────────────────────────────────────────────────────
// Public API — INVRPT
// ─────────────────────────────────────────────────────────────────────────────

// Write INVRPT. Each line has stock type (1=on-hand, 2=on-order, 3=in-transit).
// Written as QTY+type:qty[:unit]' per line (one LIN per stock-type combination).
pub fn EdiInvrptWrite(refNum: pchar, date: pchar, lines: int64, lineCount: int64, out: int64, outMax: int64): int64 {
  var refNumAdr: int64 := refNum as int64;   // #1613
  var dateAdr: int64 := date as int64;   // #1613
    var pos: int64 := invWriteHeader(out, outMax, "35"c as int64, 2, refNumAdr, dateAdr);

    var li: int64 := 0;
    while (li < lineCount) {
        var line: int64 := lines + li * EDI_INV_LINE_SIZE;
        var gtinPtr: int64 := peek64(line + EDI_INV_LINE_GTIN);
        var gtinLen: int64 := peek64(line + EDI_INV_LINE_GTINLEN);
        var whPtr:   int64 := peek64(line + EDI_INV_LINE_WAREHOUSE);
        var whLen:   int64 := peek64(line + EDI_INV_LINE_WHLEN);
        var qty:     int64 := peek64(line + EDI_INV_LINE_QTY);
        var unitPtr: int64 := peek64(line + EDI_INV_LINE_UNIT);
        var unitLen: int64 := peek64(line + EDI_INV_LINE_UNITLEN);
        var stype:   int64 := peek64(line + EDI_INV_LINE_TYPE);

        pos := invWriteLin(out, pos, outMax, li + 1, gtinPtr, gtinLen);
        pos := invWriteLoc(out, pos, outMax, whPtr, whLen);

        // QTY+type:qty[:unit]'
        pos := invPutStr(out, pos, outMax, "QTY"c as int64, 3);
        pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := invPutInt(out, pos, outMax, stype);
        pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := invPutInt(out, pos, outMax, qty);
        if (unitPtr != 0 && unitLen > 0) {
            pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
            pos := invPutStr(out, pos, outMax, unitPtr, unitLen);
        }
        pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);

        li += 1;
    }

    pos := invWriteCnt(out, pos, outMax, lineCount);
    return pos;
}

// Parse INVRPT. Returns line count.
pub fn EdiInvrptRead(buf: int64, bufLen: int64, lines: int64, maxLines: int64): int64 {
    var una: int64 := alloc(EDI_UNA_SIZE);
    EdiUnaRead(buf, bufLen, una);
    var startPos: int64 := 0;
    if (peek8(buf) == 85 && peek8(buf+1) == 78 && peek8(buf+2) == 65) { startPos := 9; }
    var sctx: int64 := alloc(EDI_SEGCTX_SIZE);
    EdiSegCtxInit(sctx, una, startPos);
    var seg: int64 := alloc(EDI_SEG_SIZE);
    var elems: int64 := alloc(8 * EDI_ELEM_SIZE);
    var count: int64 := 0;
    var curLine: int64 := 0;
    var done: int64 := 0;

    while (done == 0) {
        var r: int64 := EdiSegmentNext(buf, bufLen, sctx, seg);
        if (r == 0) { done := 1; }
        else {
            var n: int64 := EdiElementSplit(seg, elems, 8);

            // LIN → new line
            if (invTagIs(seg, 76, 73, 78) == 1) {   // "LIN"
                if (count < maxLines) {
                    curLine := lines + count * EDI_INV_LINE_SIZE;
                    var zi: int64 := 0;
                    while (zi < EDI_INV_LINE_SIZE) { poke8(curLine + zi, 0); zi := zi + 1; }
                    if (n > 2) {
                        var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                        EdiComponentSplit(invElemPtr(elems, 2), invElemLen(elems, 2), comps, 4);
                        poke64(curLine + EDI_INV_LINE_GTIN,    peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                        poke64(curLine + EDI_INV_LINE_GTINLEN, peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                        free(comps, 4 * EDI_ELEM_SIZE);
                    }
                    count += 1;
                }
            }

            // LOC → warehouse GLN from comp[1]
            if (invTagIs(seg, 76, 79, 67) == 1 && curLine != 0) {   // "LOC"
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(invElemPtr(elems, 0), invElemLen(elems, 0), comps, 4);
                    if (nc > 1) {
                        poke64(curLine + EDI_INV_LINE_WAREHOUSE, peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                        poke64(curLine + EDI_INV_LINE_WHLEN,     peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // QTY → stock type + qty + optional unit
            if (invTagIs(seg, 81, 84, 89) == 1 && curLine != 0) {   // "QTY"
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(invElemPtr(elems, 0), invElemLen(elems, 0), comps, 4);
                    if (nc > 1) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        var vp: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var vl: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        // qualifier "1"=49 "2"=50 "3"=51
                        if (ql == 1 && peek8(qp) >= 49 && peek8(qp) <= 51) {
                            poke64(curLine + EDI_INV_LINE_TYPE, peek8(qp) - 48);
                            poke64(curLine + EDI_INV_LINE_QTY,  invParseInt(vp, vl));
                        }
                        if (nc > 2) {
                            poke64(curLine + EDI_INV_LINE_UNIT,    peek64(comps + 2 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                            poke64(curLine + EDI_INV_LINE_UNITLEN, peek64(comps + 2 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }
        }
    }

    free(elems, 8 * EDI_ELEM_SIZE);
    free(seg, EDI_SEG_SIZE);
    free(sctx, EDI_SEGCTX_SIZE);
    free(una, EDI_UNA_SIZE);
    return count;
}

// ─────────────────────────────────────────────────────────────────────────────
// Public API — SLSRPT
// ─────────────────────────────────────────────────────────────────────────────

// Write one SLSRPT/SLSFCT line. withForecast=1 adds FTX+ACB confidence.
fn slsWriteLine(out: int64, pos: int64, outMax: int64, line: int64, lineno: int64, withForecast: int64): int64 {
    var gtinPtr:  int64 := peek64(line + EDI_SLS_LINE_GTIN);
    var gtinLen:  int64 := peek64(line + EDI_SLS_LINE_GTINLEN);
    var glnPtr:   int64 := peek64(line + EDI_SLS_LINE_POSGLN);
    var glnLen:   int64 := peek64(line + EDI_SLS_LINE_POSGLNLEN);
    var period:   int64 := peek64(line + EDI_SLS_LINE_PERIOD);
    var datePtr:  int64 := peek64(line + EDI_SLS_LINE_DATE);
    var dateLen:  int64 := peek64(line + EDI_SLS_LINE_DATELEN);
    var qty:      int64 := peek64(line + EDI_SLS_LINE_QTY);
    var revenue:  int64 := peek64(line + EDI_SLS_LINE_REVENUE);
    var curPtr:   int64 := peek64(line + EDI_SLS_LINE_CURRENCY);
    var curLen:   int64 := peek64(line + EDI_SLS_LINE_CURRENCYLEN);
    var confid:   int64 := peek64(line + EDI_SLS_LINE_CONFIDENCE);

    pos := invWriteLin(out, pos, outMax, lineno, gtinPtr, gtinLen);
    pos := invWriteLoc(out, pos, outMax, glnPtr, glnLen);

    // DTM+2:periodStart:qualifier'  (qualifier 617/610/102)
    if (datePtr != 0 && dateLen > 0) {
        pos := invPutStr(out, pos, outMax, "DTM"c as int64, 3);
        pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := invPutChar(out, pos, outMax, 50);   // '2'
        pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := invPutStr(out, pos, outMax, datePtr, dateLen);
        pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := invPutInt(out, pos, outMax, period);
        pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);
    }

    // QTY+12:qty'
    pos := invPutStr(out, pos, outMax, "QTY"c as int64, 3);
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := invPutStr(out, pos, outMax, "12"c as int64, 2);
    pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
    pos := invPutInt(out, pos, outMax, qty);
    pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);

    // MOA+9:revenue:currency'
    if (revenue > 0 && curPtr != 0 && curLen > 0) {
        pos := invPutStr(out, pos, outMax, "MOA"c as int64, 3);
        pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := invPutChar(out, pos, outMax, 57);   // '9'
        pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := invPutRevenue(out, pos, outMax, revenue);
        pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := invPutStr(out, pos, outMax, curPtr, curLen);
        pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);
    }

    // FTX+ACB+++confidence'  (SLSFCT only)
    if (withForecast == 1) {
        pos := invPutStr(out, pos, outMax, "FTX"c as int64, 3);
        pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := invPutStr(out, pos, outMax, "ACB"c as int64, 3);
        pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := invPutInt(out, pos, outMax, confid);
        pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);
    }

    return pos;
}

// Internal: read SLSRPT or SLSFCT body (withForecast=1 reads FTX confidence).
fn slsReadBody(buf: int64, bufLen: int64, lines: int64, maxLines: int64, withForecast: int64): int64 {
    var una: int64 := alloc(EDI_UNA_SIZE);
    EdiUnaRead(buf, bufLen, una);
    var startPos: int64 := 0;
    if (peek8(buf) == 85 && peek8(buf+1) == 78 && peek8(buf+2) == 65) { startPos := 9; }
    var sctx: int64 := alloc(EDI_SEGCTX_SIZE);
    EdiSegCtxInit(sctx, una, startPos);
    var seg: int64 := alloc(EDI_SEG_SIZE);
    var elems: int64 := alloc(8 * EDI_ELEM_SIZE);
    var count: int64 := 0;
    var curLine: int64 := 0;
    var done: int64 := 0;

    while (done == 0) {
        var r: int64 := EdiSegmentNext(buf, bufLen, sctx, seg);
        if (r == 0) { done := 1; }
        else {
            var n: int64 := EdiElementSplit(seg, elems, 8);

            // LIN → new line
            if (invTagIs(seg, 76, 73, 78) == 1) {   // "LIN"
                if (count < maxLines) {
                    curLine := lines + count * EDI_SLS_LINE_SIZE;
                    var zi: int64 := 0;
                    while (zi < EDI_SLS_LINE_SIZE) { poke8(curLine + zi, 0); zi := zi + 1; }
                    if (n > 2) {
                        var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                        EdiComponentSplit(invElemPtr(elems, 2), invElemLen(elems, 2), comps, 4);
                        poke64(curLine + EDI_SLS_LINE_GTIN,    peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                        poke64(curLine + EDI_SLS_LINE_GTINLEN, peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                        free(comps, 4 * EDI_ELEM_SIZE);
                    }
                    count += 1;
                }
            }

            // LOC → POS GLN from comp[1]
            if (invTagIs(seg, 76, 79, 67) == 1 && curLine != 0) {   // "LOC"
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(invElemPtr(elems, 0), invElemLen(elems, 0), comps, 4);
                    if (nc > 1) {
                        poke64(curLine + EDI_SLS_LINE_POSGLN,    peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                        poke64(curLine + EDI_SLS_LINE_POSGLNLEN, peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // DTM+2:periodStart:qualifier' → period qualifier + date
            if (invTagIs(seg, 68, 84, 77) == 1 && curLine != 0) {   // "DTM"
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(invElemPtr(elems, 0), invElemLen(elems, 0), comps, 4);
                    if (nc > 2) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        // qualifier "2" = 50
                        if (ql == 1 && peek8(qp) == 50) {
                            poke64(curLine + EDI_SLS_LINE_DATE,    peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                            poke64(curLine + EDI_SLS_LINE_DATELEN, peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                            var pq: int64 := invParseInt(peek64(comps + 2 * EDI_ELEM_SIZE + EDI_ELEM_PTR), peek64(comps + 2 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                            poke64(curLine + EDI_SLS_LINE_PERIOD, pq);
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // QTY+12:qty'
            if (invTagIs(seg, 81, 84, 89) == 1 && curLine != 0) {   // "QTY"
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(invElemPtr(elems, 0), invElemLen(elems, 0), comps, 4);
                    if (nc > 1) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        // "12" = 49,50
                        if (ql == 2 && peek8(qp) == 49 && peek8(qp+1) == 50) {
                            var vp: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                            var vl: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                            poke64(curLine + EDI_SLS_LINE_QTY, invParseInt(vp, vl));
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // MOA+9:revenue:currency'
            if (invTagIs(seg, 77, 79, 65) == 1 && curLine != 0) {   // "MOA"
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(invElemPtr(elems, 0), invElemLen(elems, 0), comps, 4);
                    if (nc > 1) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        // qualifier "9" = 57
                        if (ql == 1 && peek8(qp) == 57) {
                            var vp: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                            var vl: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                            poke64(curLine + EDI_SLS_LINE_REVENUE, invParseRevenue(vp, vl));
                            if (nc > 2) {
                                poke64(curLine + EDI_SLS_LINE_CURRENCY,    peek64(comps + 2 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                                poke64(curLine + EDI_SLS_LINE_CURRENCYLEN, peek64(comps + 2 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                            }
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // FTX+ACB+++confidence'  (SLSFCT confidence value)
            if (withForecast == 1 && invTagIs(seg, 70, 84, 88) == 1 && curLine != 0) {   // "FTX"
                if (n > 3) {
                    var qp: int64 := invElemPtr(elems, 0);
                    var ql: int64 := invElemLen(elems, 0);
                    // "ACB" = 65,67,66
                    if (ql >= 3 && peek8(qp) == 65 && peek8(qp+1) == 67 && peek8(qp+2) == 66) {
                        var vp: int64 := invElemPtr(elems, 3);
                        var vl: int64 := invElemLen(elems, 3);
                        poke64(curLine + EDI_SLS_LINE_CONFIDENCE, invParseInt(vp, vl));
                    }
                }
            }
        }
    }

    free(elems, 8 * EDI_ELEM_SIZE);
    free(seg, EDI_SEG_SIZE);
    free(sctx, EDI_SEGCTX_SIZE);
    free(una, EDI_UNA_SIZE);
    return count;
}

// Write SLSRPT (BGM 843).
pub fn EdiSlsrptWrite(refNum: pchar, date: pchar, lines: int64, lineCount: int64, out: int64, outMax: int64): int64 {
  var refNumAdr: int64 := refNum as int64;   // #1613
  var dateAdr: int64 := date as int64;   // #1613
    var pos: int64 := invWriteHeader(out, outMax, "843"c as int64, 3, refNumAdr, dateAdr);
    var li: int64 := 0;
    while (li < lineCount) {
        pos := slsWriteLine(out, pos, outMax, lines + li * EDI_SLS_LINE_SIZE, li + 1, 0);
        li += 1;
    }
    return invWriteCnt(out, pos, outMax, lineCount);
}

// Parse SLSRPT. Returns line count.
pub fn EdiSlsrptRead(buf: int64, bufLen: int64, lines: int64, maxLines: int64): int64 {
    return slsReadBody(buf, bufLen, lines, maxLines, 0);
}

// Write SLSFCT (BGM 844) — same as SLSRPT + FTX+ACB confidence per line.
pub fn EdiSlsfctWrite(refNum: pchar, date: pchar, lines: int64, lineCount: int64, out: int64, outMax: int64): int64 {
  var refNumAdr: int64 := refNum as int64;   // #1613
  var dateAdr: int64 := date as int64;   // #1613
    var pos: int64 := invWriteHeader(out, outMax, "844"c as int64, 3, refNumAdr, dateAdr);
    var li: int64 := 0;
    while (li < lineCount) {
        pos := slsWriteLine(out, pos, outMax, lines + li * EDI_SLS_LINE_SIZE, li + 1, 1);
        li += 1;
    }
    return invWriteCnt(out, pos, outMax, lineCount);
}

// Parse SLSFCT. Returns line count.
pub fn EdiSlsfctRead(buf: int64, bufLen: int64, lines: int64, maxLines: int64): int64 {
    return slsReadBody(buf, bufLen, lines, maxLines, 1);
}
