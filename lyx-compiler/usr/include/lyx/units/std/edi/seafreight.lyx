pub fn EdiBaplieWrite(hdr: int64, conts: int64, contCount: int64, out: int64, outMax: int64): int64 {
    poke64(hdr + EDI_SF_HDR_BGMQUAL, EDI_SF_BGM_BAPLIE);
    var pos: int64 := sfWriteHead(hdr, out, outMax);
    var i: int64 := 0;
    while (i < contCount) {
        pos := sfWriteCont(out, pos, outMax, conts + i * EDI_SF_CONT_SIZE_OFF);
        i += 1;
    }
    pos := sfWriteCnt(out, pos, outMax, contCount);
    return pos;
}

pub fn EdiBaplieRead(buf: int64, bufLen: int64, hdr: int64, conts: int64, maxConts: int64): int64 {
    sfReadHead(buf, bufLen, hdr);
    return sfReadConts(buf, bufLen, conts, maxConts);
}

