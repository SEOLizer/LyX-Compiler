// Kurzer Zeichenvergleich. std.time importiert std.string absichtlich nicht —
// ein Import allein fuer diesen Vergleich waere ein neuer Abhaengigkeitspfad
// zwischen zwei Units, die sich heute nicht kennen.
fn tzGleich(a: pchar, b: pchar): int64 {
  var i: int64 := 0;
  while (i < 8) {
    var ca: int64 := StrCharAt(a, i);
    var cb: int64 := StrCharAt(b, i);
    if (ca != cb) { return 0; }
    if (ca == 0) { return 1; }
    i := i + 1;
  }
  return 1;
}

// Baut eine Zone aus Kuerzel und Versatz.
pub fn ZoneMake(name: pchar, offset_seconds: int64): TimeZone {
  var z: TimeZone;
  z.name := name;
  z.offset_seconds := offset_seconds;
  return z;
}

// Zone zu einem Kuerzel. Unbekannt heisst: name = 0, offset 0 — deshalb
// daneben ZoneCodeKnown, damit sich "unbekannt" von "UTC" unterscheiden
// laesst.
//
// DREI Kuerzel sind doppelt belegt; hier gilt die haeufigere Lesart, und die
// andere hat eine eigene Funktion:
//   IST -> Indien +05:30      (Israel: ZoneIsrael, +02:00)
//   GST -> Golf +04:00        (South Georgia: ZoneSouthGeorgia, -02:00)
//   ICT -> Indochina +07:00   (Chagos: ZoneChagos, +06:00)
// Weitere Kuerzel kollidieren mit Belegungen AUSSERHALB dieser Liste (CST,
// BST, AST); auch dort gilt der Wert aus der Tabelle.
pub fn ZoneByCode(code: pchar): TimeZone {
  // UTC steht nicht in der Liste der 117 Zonenkuerzel (dort GMT und WET),
  // waere ueber ein Nachschlagen aber das erste, wonach jemand fragt.
  if (tzGleich(code, "UTC"c) != 0) { return ZoneMake("UTC"c, TZ_OFF_UTC); }
  // #1600: die drei mehrdeutigen Kuerzel zuerst, in der oben dokumentierten
  // Lesart — sonst entschiede die Reihenfolge der Tabelle (nach Versatz
  // sortiert), und IST waere Israel statt Indien.
  if (tzGleich(code, "IST"c) != 0) { return ZoneMake("IST"c, TZ_OFF_PLUS_0530);
  } else if (tzGleich(code, "GST"c) != 0) { return ZoneMake("GST"c, TZ_OFF_PLUS_0400);
  } else if (tzGleich(code, "ICT"c) != 0) { return ZoneMake("ICT"c, TZ_OFF_PLUS_0700);
  } else if (tzGleich(code, "NUT"c) != 0) { return ZoneMake("NUT"c, TZ_OFF_MINUS_1100);
  } else if (tzGleich(code, "SST"c) != 0) { return ZoneMake("SST"c, TZ_OFF_MINUS_1100);
  } else if (tzGleich(code, "CKT"c) != 0) { return ZoneMake("CKT"c, TZ_OFF_MINUS_1000);
  } else if (tzGleich(code, "TAHT"c) != 0) { return ZoneMake("TAHT"c, TZ_OFF_MINUS_1000);
  } else if (tzGleich(code, "MART"c) != 0) { return ZoneMake("MART"c, TZ_OFF_MINUS_0930);
  } else if (tzGleich(code, "GAMT"c) != 0) { return ZoneMake("GAMT"c, TZ_OFF_MINUS_0900);
  } else if (tzGleich(code, "PST"c) != 0) { return ZoneMake("PST"c, TZ_OFF_MINUS_0800);
  } else if (tzGleich(code, "EAST"c) != 0) { return ZoneMake("EAST"c, TZ_OFF_MINUS_0600);
  } else if (tzGleich(code, "GALT"c) != 0) { return ZoneMake("GALT"c, TZ_OFF_MINUS_0600);
  } else if (tzGleich(code, "FKT"c) != 0) { return ZoneMake("FKT"c, TZ_OFF_MINUS_0300);
  } else if (tzGleich(code, "GST"c) != 0) { return ZoneMake("GST"c, TZ_OFF_MINUS_0200);
  } else if (tzGleich(code, "AZOT"c) != 0) { return ZoneMake("AZOT"c, TZ_OFF_MINUS_0100);
  } else if (tzGleich(code, "CVT"c) != 0) { return ZoneMake("CVT"c, TZ_OFF_MINUS_0100);
  } else if (tzGleich(code, "GMT"c) != 0) { return ZoneMake("GMT"c, TZ_OFF_UTC);
  } else if (tzGleich(code, "WET"c) != 0) { return ZoneMake("WET"c, TZ_OFF_UTC);
  } else if (tzGleich(code, "CET"c) != 0) { return ZoneMake("CET"c, TZ_OFF_PLUS_0100);
  } else if (tzGleich(code, "WAT"c) != 0) { return ZoneMake("WAT"c, TZ_OFF_PLUS_0100);
  } else if (tzGleich(code, "CAT"c) != 0) { return ZoneMake("CAT"c, TZ_OFF_PLUS_0200);
  } else if (tzGleich(code, "EET"c) != 0) { return ZoneMake("EET"c, TZ_OFF_PLUS_0200);
  } else if (tzGleich(code, "IST"c) != 0) { return ZoneMake("IST"c, TZ_OFF_PLUS_0200);
  } else if (tzGleich(code, "SAST"c) != 0) { return ZoneMake("SAST"c, TZ_OFF_PLUS_0200);
  } else if (tzGleich(code, "AST"c) != 0) { return ZoneMake("AST"c, TZ_OFF_PLUS_0300);
  } else if (tzGleich(code, "EAT"c) != 0) { return ZoneMake("EAT"c, TZ_OFF_PLUS_0300);
  } else if (tzGleich(code, "MSK"c) != 0) { return ZoneMake("MSK"c, TZ_OFF_PLUS_0300);
