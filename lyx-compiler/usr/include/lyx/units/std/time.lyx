  } else if (tzGleich(code, "IRST"c) != 0) { return ZoneMake("IRST"c, TZ_OFF_PLUS_0330);
  } else if (tzGleich(code, "AMT"c) != 0) { return ZoneMake("AMT"c, TZ_OFF_PLUS_0400);
