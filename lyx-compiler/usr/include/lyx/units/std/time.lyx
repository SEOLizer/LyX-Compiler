  } else if (tzGleich(code, "TJT"c) != 0) { return ZoneMake("TJT"c, TZ_OFF_PLUS_0500);
  } else if (tzGleich(code, "TMT"c) != 0) { return ZoneMake("TMT"c, TZ_OFF_PLUS_0500);
  } else if (tzGleich(code, "UZT"c) != 0) { return ZoneMake("UZT"c, TZ_OFF_PLUS_0500);
  } else if (tzGleich(code, "VOST"c) != 0) { return ZoneMake("VOST"c, TZ_OFF_PLUS_0500);
  } else if (tzGleich(code, "YEKT"c) != 0) { return ZoneMake("YEKT"c, TZ_OFF_PLUS_0500);
