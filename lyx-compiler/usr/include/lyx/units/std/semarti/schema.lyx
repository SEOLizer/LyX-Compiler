// std/semarti/schema.lyx — strikte Eingabeprüfung für SemaRTI.
//
// DAS SCHEMA IST SELBST EIN SemaRTI-WERT. Damit gibt es genau ein Format im
// System: wer einen Deskriptor lesen kann, kann auch sein Schema lesen, und
// es braucht keinen zweiten Parser, der anders scheitert als der erste.
//
// DENY BY DEFAULT, UND ZWAR AN DREI STELLEN:
//   1. Ein unbekannter Typname wird ABGEWIESEN, nicht geraten. Ein
//      Catch-all, der etwas Plausibles tut, macht aus jeder Lücke eine
//      stille Fehlfunktion — in diesem Baum sind daran 16 verworfene
//      Opcodes samt Sicherheits-Asserts belegt.
//   2. Ein Feld, das das Schema nicht nennt, wird abgewiesen, SOLANGE NICHT
//      `additionalProperties: true` ausdrücklich dasteht. Fehlt die Angabe,
//      gilt das strenge Verhalten. Im JSON-Schema-Sinn ist das die
//      Umkehrung des Standardwerts, und sie ist hier Absicht: ein
//      Aufrufvorschlag von außen darf keine Felder einschmuggeln.
//   3. Fehlt eine Grenze (`maxLength`, `maxItems`), greift die harte Grenze
//      des Werttyps. Es gibt keinen unbegrenzten Fall.
//
// WAS DIE PRÜFUNG NICHT TUT: Sie liest keine Beschreibungstexte als
// Anweisung, und sie entscheidet nichts über Rechte. Ein Schema sagt, wie
// eine Eingabe AUSSIEHT — nicht, wer sie schicken darf.

@description("SemaRTI: strikte Schema-Prüfung auf strukturierten Werten")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.semarti.schema;

import std.string;
import std.semarti.wert;

// ── Befunde ─────────────────────────────────────────────────────────────────
// Jeder Befund ist ein eigener Wert. Nach AUSSEN gibt der Ablauf daraus ein
// einziges `invalid_input` — die Unterscheidung dient dem Betreiberlog, nicht
// dem Aufrufer. Ein Angreifer soll aus der Fehlermeldung nicht ablesen
// können, welches Feld welche Grenze hat.
pub con SRS_OK:                  int64 := 0;
pub con SRS_E_SCHEMA_KAPUTT:     int64 := 0 - 1;
pub con SRS_E_TYP_UNBEKANNT:     int64 := 0 - 2;
pub con SRS_E_TYP_FALSCH:        int64 := 0 - 3;
pub con SRS_E_PFLICHTFELD_FEHLT: int64 := 0 - 4;
pub con SRS_E_FELD_UNBEKANNT:    int64 := 0 - 5;
pub con SRS_E_ZU_LANG:           int64 := 0 - 6;
pub con SRS_E_ZU_KLEIN:          int64 := 0 - 7;
pub con SRS_E_ZU_GROSS:          int64 := 0 - 8;
pub con SRS_E_ZU_VIELE_GLIEDER:  int64 := 0 - 9;
pub con SRS_E_ZU_TIEF:           int64 := 0 - 10;

// Letzter Befund im Klartext, für das Betreiberlog. Bewusst ein einzelner
// Merker und keine Liste: der Ablauf bricht beim ersten Befund ab, eine
// zweite Zeile gäbe es also nie.
var _grundFeld: pchar := ""c;
var _grundCode: int64 := 0;

pub fn SchemaLetzterGrundCode(): int64 { return _grundCode; }
pub fn SchemaLetztesGrundFeld(): pchar { return _grundFeld; }

fn srsNein(code: int64, feld: pchar): int64 {
  _grundCode := code;
  _grundFeld := feld;
  return code;
}

// Typname -> Knotenart. -1 heisst "diesen Namen kennt das Schema nicht".
fn srsArtVonName(n: pchar): int64 {
  if (StrEq(n, "null"c) != 0)    { return SRW_NULL; }
  if (StrEq(n, "boolean"c) != 0) { return SRW_BOOL; }
  if (StrEq(n, "integer"c) != 0) { return SRW_ZAHL; }
  if (StrEq(n, "string"c) != 0)  { return SRW_TEXT; }
  if (StrEq(n, "array"c) != 0)   { return SRW_LISTE; }
  if (StrEq(n, "object"c) != 0)  { return SRW_OBJEKT; }
  return 0 - 1;
}

// Liest eine Zahlangabe aus dem Schema. `da` wird auf 1 gesetzt, wenn sie
// vorhanden UND eine Zahl ist. Eine vorhandene Angabe falschen Typs ist ein
// kaputtes Schema und kein fehlender Wert — sonst würde ein Tippfehler im
// Schema die Grenze still abschalten.
var _zahlDa: int64 := 0;

fn srsZahl(schema: int64, name: pchar): int64 {
  _zahlDa := 0;
  var f: int64 := WertFeld(schema, name);
  if (f < 0) { return 0; }
  if (WertArt(f) != SRW_ZAHL) { return SRS_E_SCHEMA_KAPUTT; }
  _zahlDa := 1;
  return WertZahlwert(f);
}

// ── Prüfung ─────────────────────────────────────────────────────────────────
// `tiefe` zählt die Verschachtelung mit; das Dokument wird damit nicht erst
// nach dem Aufbau gemessen, sondern beim Ablaufen.
fn srsPruefe(wert: int64, schema: int64, feldname: pchar, tiefe: int64): int64 {
  if (tiefe > SRW_MAX_TIEFE) { return srsNein(SRS_E_ZU_TIEF, feldname); }
  if (WertArt(schema) != SRW_OBJEKT) { return srsNein(SRS_E_SCHEMA_KAPUTT, feldname); }

  var tf: int64 := WertFeld(schema, "type"c);
  if (tf < 0) { return srsNein(SRS_E_SCHEMA_KAPUTT, feldname); }
  if (WertArt(tf) != SRW_TEXT) { return srsNein(SRS_E_SCHEMA_KAPUTT, feldname); }
  var soll: int64 := srsArtVonName(WertTextwert(tf));
  if (soll < 0) { return srsNein(SRS_E_TYP_UNBEKANNT, feldname); }

  var ist: int64 := WertArt(wert);
  if (ist < 0) { return srsNein(SRS_E_TYP_FALSCH, feldname); }
  if (ist != soll) { return srsNein(SRS_E_TYP_FALSCH, feldname); }

  if (soll == SRW_TEXT) {
    var maxL: int64 := srsZahl(schema, "maxLength"c);
    if (maxL == SRS_E_SCHEMA_KAPUTT && _zahlDa == 0) { return srsNein(SRS_E_SCHEMA_KAPUTT, feldname); }
    var grenze: int64 := SRW_MAX_TEXTLAENGE;
    if (_zahlDa != 0 && maxL < grenze) { grenze := maxL; }
    if (WertTextLaenge(wert) > grenze) { return srsNein(SRS_E_ZU_LANG, feldname); }
    return SRS_OK;
  }

  if (soll == SRW_ZAHL) {
    var mn: int64 := srsZahl(schema, "minimum"c);
    if (mn == SRS_E_SCHEMA_KAPUTT && _zahlDa == 0) { return srsNein(SRS_E_SCHEMA_KAPUTT, feldname); }
    var hatMn: int64 := _zahlDa;
    var mx: int64 := srsZahl(schema, "maximum"c);
    if (mx == SRS_E_SCHEMA_KAPUTT && _zahlDa == 0) { return srsNein(SRS_E_SCHEMA_KAPUTT, feldname); }
    var hatMx: int64 := _zahlDa;
    var z: int64 := WertZahlwert(wert);
    if (hatMn != 0 && z < mn) { return srsNein(SRS_E_ZU_KLEIN, feldname); }
    if (hatMx != 0 && z > mx) { return srsNein(SRS_E_ZU_GROSS, feldname); }
    return SRS_OK;
  }

  if (soll == SRW_NULL || soll == SRW_BOOL) { return SRS_OK; }

  if (soll == SRW_LISTE) {
    var maxI: int64 := srsZahl(schema, "maxItems"c);
    if (maxI == SRS_E_SCHEMA_KAPUTT && _zahlDa == 0) { return srsNein(SRS_E_SCHEMA_KAPUTT, feldname); }
    var ig: int64 := SRW_MAX_FELDER;
    if (_zahlDa != 0 && maxI < ig) { ig := maxI; }
    if (WertGliederZahl(wert) > ig) { return srsNein(SRS_E_ZU_VIELE_GLIEDER, feldname); }
    // `items` ist Pflicht: eine Liste ohne Gliedschema wäre eine Liste
    // beliebiger Werte, und das ist keine Prüfung.
    var its: int64 := WertFeld(schema, "items"c);
    if (its < 0) { return srsNein(SRS_E_SCHEMA_KAPUTT, feldname); }
    var g: int64 := WertErstesKind(wert);
    while (g >= 0) {
      var r: int64 := srsPruefe(g, its, feldname, tiefe + 1);
      if (r != SRS_OK) { return r; }
      g := WertNaechstes(g);
    }
    return SRS_OK;
  }

  // Objekt.
  var props: int64 := WertFeld(schema, "properties"c);
  if (props < 0 || WertArt(props) != SRW_OBJEKT) { return srsNein(SRS_E_SCHEMA_KAPUTT, feldname); }

  // Pflichtfelder.
  var req: int64 := WertFeld(schema, "required"c);
  if (req >= 0) {
    if (WertArt(req) != SRW_LISTE) { return srsNein(SRS_E_SCHEMA_KAPUTT, feldname); }
    var rn: int64 := WertErstesKind(req);
    while (rn >= 0) {
      if (WertArt(rn) != SRW_TEXT) { return srsNein(SRS_E_SCHEMA_KAPUTT, feldname); }
      var nm: pchar := WertTextwert(rn);
      if (WertHatFeld(wert, nm) == 0) { return srsNein(SRS_E_PFLICHTFELD_FEHLT, nm); }
      rn := WertNaechstes(rn);
    }
  }

  // Zusätzliche Felder: erlaubt NUR bei ausdrücklichem `true`.
  var zusatzErlaubt: int64 := 0;
  var ap: int64 := WertFeld(schema, "additionalProperties"c);
  if (ap >= 0) {
    if (WertArt(ap) != SRW_BOOL) { return srsNein(SRS_E_SCHEMA_KAPUTT, feldname); }
    if (WertZahlwert(ap) != 0) { zusatzErlaubt := 1; }
  }

  var k: int64 := WertErstesKind(wert);
  while (k >= 0) {
    var nm2: pchar := WertFeldName(k);
    var ps: int64 := WertFeld(props, nm2);
    if (ps < 0) {
      if (zusatzErlaubt == 0) { return srsNein(SRS_E_FELD_UNBEKANNT, nm2); }
    } else {
      var r2: int64 := srsPruefe(k, ps, nm2, tiefe + 1);
      if (r2 != SRS_OK) { return r2; }
    }
    k := WertNaechstes(k);
  }
  return SRS_OK;
}

pub fn SchemaPruefe(wert: int64, schema: int64): int64 {
  _grundCode := 0;
  _grundFeld := ""c;
  return srsPruefe(wert, schema, "<wurzel>"c, 1);
}
