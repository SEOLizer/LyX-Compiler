// std/semarti/registry.lyx — Deskriptoren und Registry für SemaRTI.
//
// ZWEI PHASEN, UND SIE SIND GETRENNT. In der AUFBAUPHASE registriert der Host
// seine Operationen; danach schliesst er die Registry ab. Ab dann ist sie
// unveränderlich, und `RegistryHinzufuegen` scheitert laut. Das ist keine
// Bequemlichkeit, sondern die Zusicherung, auf der alles Weitere ruht: eine
// Operation, die nach dem Abschluss dazukäme, hätte keine der Prüfungen
// durchlaufen, die der Host beim Aufbau gemacht hat.
//
// KEINE FÜNFTE LISTE VON CAPABILITY-NAMEN. In diesem Baum lebt eine
// Capability an vier Stellen (Registry, seccomp_gen, _capBitsFromPath,
// lbf_layout), und eine fünfte Kopie wäre eine Kopie zu viel. Diese Unit
// führt deshalb KEINE eigene Namensliste. Statt dessen übergibt der Host
// einmal die Liste, die auch in seinem `@capabilities`-Attribut steht, und
// jede Operation darf nur daraus schöpfen. Damit ist die Prüfung zweiseitig
// dicht:
//   * Ein Tippfehler im ATTRIBUT meldet der Übersetzer
//     (`sema error: unbekannte Capability`, nachgewiesen mit `fs.reed`).
//   * Ein Tippfehler in der OPERATION fällt hier auf, weil der Name nicht in
//     der Programmliste steht.
// Ohne diese zweite Prüfung hätte eine Operation ein Recht verlangen können,
// das es nicht gibt — und das wäre nie aufgefallen, weil niemand es prüft.
//
// VERGLICHEN WIRD AUF GLEICHHEIT, NIEMALS AUF PRÄFIX. Eine Präfixprüfung in
// einer Rechtezuordnung trifft auch jeden Namen, den es noch nicht gibt; in
// diesem Baum ist das dreimal belegt, einmal mit `process` für
// `process.exit`, was `PLEDGE_EXEC` setzte.

@description("SemaRTI: Deskriptoren und unveränderliche Registry")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.semarti.registry;

import std.alloc;
import std.string;
import std.semarti.wert;

// ── Risiko und Bestätigung ──────────────────────────────────────────────────
// Die Einteilung ist die aus der Spezifikation. Sie ist eine ANGABE des
// Anbieters und keine Garantie; die Policy des Hosts darf jederzeit strenger
// urteilen.
pub con SRR_RISIKO_NUR_LESEN:    int64 := 0;
pub con SRR_RISIKO_AENDERND:     int64 := 1;
pub con SRR_RISIKO_AUSSENWIRKUNG: int64 := 2;

pub con SRR_BESTAETIGUNG_NICHT_NOETIG: int64 := 0;
pub con SRR_BESTAETIGUNG_NOETIG:       int64 := 1;

pub con SRR_OK:                    int64 := 0;
pub con SRR_E_ABGESCHLOSSEN:       int64 := 0 - 1;
pub con SRR_E_VOLL:                int64 := 0 - 2;
pub con SRR_E_ID_LEER:             int64 := 0 - 3;
pub con SRR_E_ID_DOPPELT:          int64 := 0 - 4;
pub con SRR_E_CAP_NICHT_DEKLARIERT: int64 := 0 - 5;
pub con SRR_E_ZU_VIELE_CAPS:       int64 := 0 - 6;
pub con SRR_E_KEIN_HANDLER:        int64 := 0 - 7;
pub con SRR_E_SCHEMA_FEHLT:        int64 := 0 - 8;
pub con SRR_E_NICHT_GEFUNDEN:      int64 := 0 - 9;
pub con SRR_E_RISIKO_UNBEKANNT:    int64 := 0 - 10;
pub con SRR_E_NICHT_ABGESCHLOSSEN: int64 := 0 - 11;
pub con SRR_E_PROGRAMMLISTE_FEHLT: int64 := 0 - 12;

pub con SRR_MAX_OPERATIONEN: int64 := 128;
pub con SRR_MAX_CAPS_JE_OP:  int64 := 8;
pub con SRR_MAX_PROGRAMM_CAPS: int64 := 64;

// Ein Handler bekommt Eingabe- und Ausgabeknoten plus den Aufrufkontext und
// gibt einen Fehlercode zurück. KEIN eingefangener Zustand: ein `fn(...)`-Typ
// trägt in dieser Sprache nur die Adresse, ein Lambda mit Umgebung passt
// nicht hinein (der Übergang wird gemeldet). Was der Handler braucht, kommt
// also über den Kontext oder über Modulvariablen seiner eigenen Unit.
pub type SemaHandler = fn(int64, int64, int64): int64;

// ── Speicher der Registry ───────────────────────────────────────────────────
// Je Operation ein Satz aus festen Zellen. Flach gehalten, weil die Registry
// nach dem Abschluss nur noch gelesen wird.
con SRR_OP_BYTES: int64 := 128;
//  [0] id (pchar)          [8] version major     [16] minor      [24] patch
// [32] eingabeschema      [40] ausgabeschema     [48] handler
// [56] risiko             [64] bestaetigung      [72] capAnzahl
// [80] capListe (Puffer von pchar)               [88] titel
// [96] beschreibung

var _ops: int64 := 0;
var _opAnzahl: int64 := 0;
var _abgeschlossen: int64 := 0;
var _progCaps: int64 := 0;
var _progCapAnzahl: int64 := 0 - 1;
var _bereit: int64 := 0;

fn rInit(): void {
  if (_bereit != 0) { return; }
  _ops := alloc(SRR_MAX_OPERATIONEN * SRR_OP_BYTES);
  _progCaps := alloc(SRR_MAX_PROGRAMM_CAPS * 8);
  _bereit := 1;
}

fn rZelle(oi: int64, nr: int64): int64 { return _ops + oi * SRR_OP_BYTES + nr * 8; }

// ── Aufbauphase ─────────────────────────────────────────────────────────────
// Der Host nennt die Capabilities, die er in seinem `@capabilities`-Attribut
// deklariert hat. Ohne diese Liste nimmt die Registry keine Operation an, die
// ein Recht verlangt — Deny by default, und zwar an der Wurzel.
pub fn RegistryProgrammCapability(name: pchar): int64 {
  rInit();
  if (_abgeschlossen != 0) { return SRR_E_ABGESCHLOSSEN; }
  if (_progCapAnzahl < 0) { _progCapAnzahl := 0; }
  if (_progCapAnzahl >= SRR_MAX_PROGRAMM_CAPS) { return SRR_E_VOLL; }
  if (StrLen(name) == 0) { return SRR_E_ID_LEER; }
  poke64(_progCaps + _progCapAnzahl * 8, name as int64);
  _progCapAnzahl := _progCapAnzahl + 1;
  return SRR_OK;
}

fn rProgrammHatCap(name: pchar): int64 {
  if (_progCapAnzahl <= 0) { return 0; }
  var i: int64 := 0;
  while (i < _progCapAnzahl) {
    var n: pchar := peek64(_progCaps + i * 8) as pchar;
    // Gleichheit, nicht Präfix. Siehe Kopf dieser Datei.
    if (StrEq(n, name) != 0 && StrLen(n) == StrLen(name)) { return 1; }
    i := i + 1;
  }
  return 0;
}

pub fn RegistryFinde(id: pchar): int64 {
  rInit();
  var i: int64 := 0;
  while (i < _opAnzahl) {
    var oid: pchar := peek64(rZelle(i, 0)) as pchar;
    if (StrEq(oid, id) != 0 && StrLen(oid) == StrLen(id)) { return i; }
    i := i + 1;
  }
  return SRR_E_NICHT_GEFUNDEN;
}

// Registriert eine Operation. `caps` ist ein Puffer mit `capAnzahl` pchar;
// jeder Name muss in der Programmliste stehen.
pub fn RegistryHinzufuegen(id: pchar, major: int64, minor: int64, patch: int64,
                           titel: pchar, beschreibung: pchar,
                           eingabeschema: int64, ausgabeschema: int64,
                           handler: SemaHandler,
                           risiko: int64, bestaetigung: int64,
                           caps: int64, capAnzahl: int64): int64 {
  rInit();
  if (_abgeschlossen != 0) { return SRR_E_ABGESCHLOSSEN; }
  if (_opAnzahl >= SRR_MAX_OPERATIONEN) { return SRR_E_VOLL; }
  if (StrLen(id) == 0) { return SRR_E_ID_LEER; }
  if (RegistryFinde(id) >= 0) { return SRR_E_ID_DOPPELT; }
  if (handler as int64 == 0) { return SRR_E_KEIN_HANDLER; }
  // Ein Eingabeschema ist PFLICHT. Eine Operation ohne Schema nähme beliebige
  // Eingaben an, und dann wäre die Prüfung vor dem Aufruf wirkungslos.
  if (WertArt(eingabeschema) != SRW_OBJEKT) { return SRR_E_SCHEMA_FEHLT; }
  if (WertArt(ausgabeschema) != SRW_OBJEKT) { return SRR_E_SCHEMA_FEHLT; }
  if (risiko != SRR_RISIKO_NUR_LESEN && risiko != SRR_RISIKO_AENDERND
      && risiko != SRR_RISIKO_AUSSENWIRKUNG) { return SRR_E_RISIKO_UNBEKANNT; }
  if (capAnzahl < 0 || capAnzahl > SRR_MAX_CAPS_JE_OP) { return SRR_E_ZU_VIELE_CAPS; }
  if (capAnzahl > 0 && _progCapAnzahl < 0) { return SRR_E_PROGRAMMLISTE_FEHLT; }
  var i: int64 := 0;
  while (i < capAnzahl) {
    var cn: pchar := peek64(caps + i * 8) as pchar;
    if (rProgrammHatCap(cn) == 0) { return SRR_E_CAP_NICHT_DEKLARIERT; }
    i := i + 1;
  }

  var oi: int64 := _opAnzahl;
  poke64(rZelle(oi, 0),  id as int64);
  poke64(rZelle(oi, 1),  major);
  poke64(rZelle(oi, 2),  minor);
  poke64(rZelle(oi, 3),  patch);
  poke64(rZelle(oi, 4),  eingabeschema);
  poke64(rZelle(oi, 5),  ausgabeschema);
  poke64(rZelle(oi, 6),  handler as int64);
  poke64(rZelle(oi, 7),  risiko);
  poke64(rZelle(oi, 8),  bestaetigung);
  poke64(rZelle(oi, 9),  capAnzahl);
  poke64(rZelle(oi, 10), caps);
  poke64(rZelle(oi, 11), titel as int64);
  poke64(rZelle(oi, 12), beschreibung as int64);
  _opAnzahl := _opAnzahl + 1;
  return oi;
}

// Schliesst die Aufbauphase ab und setzt die Arena-Marke: ab hier überleben
// die Schemas jedes Zurücksetzen, die Werte einzelner Aufrufe nicht.
pub fn RegistryAbschliessen(): int64 {
  rInit();
  if (_abgeschlossen != 0) { return SRR_E_ABGESCHLOSSEN; }
  _abgeschlossen := 1;
  WertMarkeSetzen();
  return SRR_OK;
}

pub fn RegistryIstAbgeschlossen(): int64 { return _abgeschlossen; }
pub fn RegistryAnzahl(): int64 { rInit(); return _opAnzahl; }

// Nur für Tests: baut die Registry von vorn auf.
pub fn RegistryZuruecksetzenFuerTest(): void {
  rInit();
  _opAnzahl := 0;
  _abgeschlossen := 0;
  _progCapAnzahl := 0 - 1;
  WertAllesFreigeben();
}

// ── Lesen ───────────────────────────────────────────────────────────────────
pub fn OpId(oi: int64): pchar {
  if (oi < 0 || oi >= _opAnzahl) { return ""c; }
  return peek64(rZelle(oi, 0)) as pchar;
}
pub fn OpMajor(oi: int64): int64 { if (oi < 0 || oi >= _opAnzahl) { return 0 - 1; } return peek64(rZelle(oi, 1)); }
pub fn OpMinor(oi: int64): int64 { if (oi < 0 || oi >= _opAnzahl) { return 0 - 1; } return peek64(rZelle(oi, 2)); }
pub fn OpPatch(oi: int64): int64 { if (oi < 0 || oi >= _opAnzahl) { return 0 - 1; } return peek64(rZelle(oi, 3)); }
pub fn OpEingabeschema(oi: int64): int64 { if (oi < 0 || oi >= _opAnzahl) { return 0 - 1; } return peek64(rZelle(oi, 4)); }
pub fn OpAusgabeschema(oi: int64): int64 { if (oi < 0 || oi >= _opAnzahl) { return 0 - 1; } return peek64(rZelle(oi, 5)); }
pub fn OpHandler(oi: int64): SemaHandler { return peek64(rZelle(oi, 6)) as SemaHandler; }
pub fn OpRisiko(oi: int64): int64 { if (oi < 0 || oi >= _opAnzahl) { return 0 - 1; } return peek64(rZelle(oi, 7)); }
pub fn OpBestaetigung(oi: int64): int64 { if (oi < 0 || oi >= _opAnzahl) { return 0 - 1; } return peek64(rZelle(oi, 8)); }
pub fn OpCapAnzahl(oi: int64): int64 { if (oi < 0 || oi >= _opAnzahl) { return 0 - 1; } return peek64(rZelle(oi, 9)); }
pub fn OpCap(oi: int64, k: int64): pchar {
  if (oi < 0 || oi >= _opAnzahl) { return ""c; }
  if (k < 0 || k >= peek64(rZelle(oi, 9))) { return ""c; }
  return peek64(peek64(rZelle(oi, 10)) + k * 8) as pchar;
}
pub fn OpTitel(oi: int64): pchar { if (oi < 0 || oi >= _opAnzahl) { return ""c; } return peek64(rZelle(oi, 11)) as pchar; }
pub fn OpBeschreibung(oi: int64): pchar { if (oi < 0 || oi >= _opAnzahl) { return ""c; } return peek64(rZelle(oi, 12)) as pchar; }

// Versionsprüfung: gleiche Major-Version und die angeforderte Minor-Version
// nicht neuer als die angebotene. Eine andere Major-Version ist ein anderer
// Vertrag und wird abgewiesen, nicht zurechtgebogen.
pub fn OpVersionPasst(oi: int64, major: int64, minor: int64): int64 {
  if (OpMajor(oi) != major) { return 0; }
  if (minor > OpMinor(oi)) { return 0; }
  return 1;
}
