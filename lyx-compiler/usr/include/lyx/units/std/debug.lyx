// std/debug -- WP-18: Debugging & Performance-Monitoring
// Wrapper um sys_ptrace (101) und sys_perf_event_open (298).
//
// ptrace: Prozess-Debugging und Tracing (Attach, Peek/Poke, Singlestep).
// perf_event_open: Hardware/Software-Performance-Counter (CPU-Cycles,
//                  Instructions, Cache-Misses, Page-Faults usw.).

import std.alloc;

// ============================================================
// ptrace -- Konstanten
// ============================================================

pub con PTRACE_TRACEME:     int64 := 0;    // Kind markiert sich selbst als traceable
pub con PTRACE_PEEKTEXT:    int64 := 1;    // Wort aus Code-Segment lesen
pub con PTRACE_PEEKDATA:    int64 := 2;    // Wort aus Daten-Segment lesen
pub con PTRACE_POKETEXT:    int64 := 4;    // Wort in Code-Segment schreiben
pub con PTRACE_POKEDATA:    int64 := 5;    // Wort in Daten-Segment schreiben
pub con PTRACE_CONT:        int64 := 7;    // Tracee weiterlaufen lassen
pub con PTRACE_KILL:        int64 := 8;    // Tracee beenden
pub con PTRACE_SINGLESTEP:  int64 := 9;   // Eine Instruktion ausfuehren
pub con PTRACE_GETREGS:     int64 := 12;  // Register lesen (user_regs_struct)
pub con PTRACE_SETREGS:     int64 := 13;  // Register setzen
pub con PTRACE_ATTACH:      int64 := 16;  // An laufenden Prozess anheften
pub con PTRACE_DETACH:      int64 := 17;  // Lostrennten, Tracee laeuft weiter
pub con PTRACE_SYSCALL:     int64 := 24;  // Bei naechstem Syscall stoppen
pub con PTRACE_SETOPTIONS:  int64 := 16896;  // 0x4200 -- Optionen setzen
pub con PTRACE_GETEVENTMSG: int64 := 16897;  // 0x4201 -- Letztes Event-Datum
pub con PTRACE_GETSIGINFO:  int64 := 16898;  // 0x4202 -- Signalinfo lesen
pub con PTRACE_SEIZE:       int64 := 16902;  // 0x4206 -- Attach ohne Stop

// PTRACE_SETOPTIONS-Flags
pub con PTRACE_O_TRACESYSGOOD:  int64 := 1;
pub con PTRACE_O_TRACEFORK:     int64 := 2;
pub con PTRACE_O_TRACEVFORK:    int64 := 4;
pub con PTRACE_O_TRACECLONE:    int64 := 8;
pub con PTRACE_O_TRACEEXEC:     int64 := 16;
pub con PTRACE_O_TRACEEXIT:     int64 := 64;

// user_regs_struct Groesse (x86-64, 27 Register a 8 Bytes = 216 Bytes)
pub con PTRACE_REGS_SIZE: int64 := 216;

// ============================================================
// ptrace -- Funktionen
// ============================================================

// PtraceTraceme: markiert den aktuellen Prozess als traceable durch seinen Eltern.
// Muss vor einem exec() im Kind aufgerufen werden.
pub fn PtraceTraceme(): int64 {
  return sys_ptrace(PTRACE_TRACEME, 0, 0, 0);
}

// PtraceAttach: heftet sich an einen laufenden Prozess an.
// Der Prozess wird gestoppt und SIGSTOP empfangen.
pub fn PtraceAttach(pid: int64): int64 {
  return sys_ptrace(PTRACE_ATTACH, pid, 0, 0);
}

// PtraceDetach: loest die Verbindung zum Tracee; er laeuft weiter.
// sig: Signal das an den Tracee gesendet wird (0 = keins)
pub fn PtraceDetach(pid: int64, sig: int64): int64 {
  return sys_ptrace(PTRACE_DETACH, pid, 0, sig);
}

// PtraceCont: setzt den gestoppten Tracee fort.
// sig: weitergeleitetes Signal (0 = keins)
pub fn PtraceCont(pid: int64, sig: int64): int64 {
  return sys_ptrace(PTRACE_CONT, pid, 0, sig);
}

// PtraceSingleStep: fuehrt genau eine Instruktion im Tracee aus.
pub fn PtraceSingleStep(pid: int64): int64 {
  return sys_ptrace(PTRACE_SINGLESTEP, pid, 0, 0);
}

// PtracePeek: liest ein 64-Bit-Wort aus dem Adressraum des Tracee.
pub fn PtracePeek(pid: int64, addr: int64): int64 {
  return sys_ptrace(PTRACE_PEEKDATA, pid, addr, 0);
}

// PtracePoke: schreibt ein 64-Bit-Wort in den Adressraum des Tracee.
pub fn PtracePoke(pid: int64, addr: int64, val: int64): int64 {
  return sys_ptrace(PTRACE_POKEDATA, pid, addr, val);
}

// PtraceGetRegs: liest die Register des Tracee in einen Puffer (PTRACE_REGS_SIZE Bytes).
pub fn PtraceGetRegs(pid: int64, regsOut: int64): int64 {
  return sys_ptrace(PTRACE_GETREGS, pid, 0, regsOut);
}

// PtraceSetOptions: setzt Optionen fuer den Tracee.
pub fn PtraceSetOptions(pid: int64, opts: int64): int64 {
  return sys_ptrace(PTRACE_SETOPTIONS, pid, 0, opts);
}

// ============================================================
// perf_event_open -- Konstanten
// ============================================================

// Event-Typen
pub con PERF_TYPE_HARDWARE:   int64 := 0;
pub con PERF_TYPE_SOFTWARE:   int64 := 1;
pub con PERF_TYPE_TRACEPOINT: int64 := 2;
pub con PERF_TYPE_HW_CACHE:   int64 := 3;
pub con PERF_TYPE_RAW:        int64 := 4;
pub con PERF_TYPE_BREAKPOINT: int64 := 5;

// Hardware-Events (PERF_TYPE_HARDWARE)
pub con PERF_COUNT_HW_CPU_CYCLES:        int64 := 0;
pub con PERF_COUNT_HW_INSTRUCTIONS:      int64 := 1;
pub con PERF_COUNT_HW_CACHE_REFERENCES:  int64 := 2;
pub con PERF_COUNT_HW_CACHE_MISSES:      int64 := 3;
pub con PERF_COUNT_HW_BRANCH_INSTR:      int64 := 4;
pub con PERF_COUNT_HW_BRANCH_MISSES:     int64 := 5;

// Software-Events (PERF_TYPE_SOFTWARE)
pub con PERF_COUNT_SW_CPU_CLOCK:         int64 := 0;
pub con PERF_COUNT_SW_TASK_CLOCK:        int64 := 1;
pub con PERF_COUNT_SW_PAGE_FAULTS:       int64 := 2;
pub con PERF_COUNT_SW_CONTEXT_SWITCHES:  int64 := 3;
pub con PERF_COUNT_SW_CPU_MIGRATIONS:    int64 := 4;
pub con PERF_COUNT_SW_PAGE_FAULTS_MIN:   int64 := 5;
pub con PERF_COUNT_SW_PAGE_FAULTS_MAJ:   int64 := 6;

// perf_event_open-Flags
pub con PERF_FLAG_FD_CLOEXEC: int64 := 8;  // 0x8

// perf_event_attr-Groesse und Feld-Offsets (128-Byte-Struktur)
//   +0:  type (uint32)
//   +4:  size (uint32) -- muss PERF_ATTR_SIZE sein
//   +8:  config (uint64)
//   +16: sample_period (uint64)
//   +24: sample_type (uint64)
//   +32: read_format (uint64)
//   +40: flags (uint64, Bitfeld): disabled(bit0), inherit(bit1), ...
//   +48: wakeup_events (uint32)
//   ... (weitere Felder)
pub con PERF_ATTR_SIZE:         int64 := 128;
pub con PERF_ATTR_TYPE:         int64 := 0;
pub con PERF_ATTR_SIZE_FIELD:   int64 := 4;
pub con PERF_ATTR_CONFIG:       int64 := 8;
pub con PERF_ATTR_SAMPLE_PERIOD: int64 := 16;
pub con PERF_ATTR_SAMPLE_TYPE:  int64 := 24;
pub con PERF_ATTR_READ_FORMAT:  int64 := 32;
pub con PERF_ATTR_FLAGS:        int64 := 40;  // Bitfeld

// perf_event_attr.flags Bitpositionen
pub con PERF_ATTR_DISABLED:     int64 := 1;   // Bit 0: Counter startet nicht-aktiv
pub con PERF_ATTR_INHERIT:      int64 := 2;   // Bit 1: Kind-Prozesse erben Counter
pub con PERF_ATTR_EXCLUDE_KERNEL: int64 := 8; // Bit 3: Kernel-Zeit nicht messen

// ioctl-Codes fuer perf fd
pub con PERF_EVENT_IOC_ENABLE:  int64 := 9216;   // 0x2400
pub con PERF_EVENT_IOC_DISABLE: int64 := 9217;   // 0x2401
pub con PERF_EVENT_IOC_RESET:   int64 := 9219;   // 0x2403

// ============================================================
// perf_event_open -- Funktionen
// ============================================================

// PerfEventOpen: oeffnet ein Performance-Counter-Ereignis.
// attr:    Zeiger auf perf_event_attr (PERF_ATTR_SIZE Bytes)
// pid:     0 = aktueller Prozess, -1 = alle Prozesse (braucht root)
// cpu:     -1 = alle CPUs, >= 0 = spezifische CPU
// groupFd: -1 = neue Gruppe, >= 0 = in Gruppe einfuegen
// flags:   0 oder PERF_FLAG_FD_CLOEXEC
pub fn PerfEventOpen(attr: int64, pid: int64, cpu: int64, groupFd: int64, flags: int64): int64 {
  return sys_perf_event_open(attr, pid, cpu, groupFd, flags);
}

// PerfCount: oeffnet einen einfachen Software/Hardware-Counter fuer den aktuellen Prozess.
// type_:   PERF_TYPE_SOFTWARE oder PERF_TYPE_HARDWARE
// config:  z.B. PERF_COUNT_SW_CPU_CLOCK
// Gibt fd zurueck oder negativen Fehlercode.
pub fn PerfCount(type_: int64, config: int64): int64 {
  var attr: int64 := alloc(PERF_ATTR_SIZE);
  if (attr == 0) { return -12; }
  poke32(attr + PERF_ATTR_TYPE,       type_ as int32);
  poke32(attr + PERF_ATTR_SIZE_FIELD, PERF_ATTR_SIZE as int32);
  poke64(attr + PERF_ATTR_CONFIG,     config);
  poke64(attr + PERF_ATTR_FLAGS,      PERF_ATTR_EXCLUDE_KERNEL);
  var fd: int64 := sys_perf_event_open(attr, 0, -1, -1, 0);
  free(attr, PERF_ATTR_SIZE);
  return fd;
}

// PerfRead: liest den aktuellen Zaehlerstand aus einem perf-fd.
// Gibt den Zaehlerstand (uint64) oder -errno zurueck.
pub fn PerfRead(fd: int64): int64 {
  var buf: int64 := alloc(8);
  if (buf == 0) { return -12; }
  var r: int64 := read(fd, buf as pchar, 8);
  var v: int64 := 0;
  if (r == 8) { v := peek64(buf); }
  free(buf, 8);
  if (r < 0) { return r; }
  return v;
}

// PerfEnable: aktiviert den Counter (ioctl PERF_EVENT_IOC_ENABLE).
pub fn PerfEnable(fd: int64): int64 {
  return ioctl(fd, PERF_EVENT_IOC_ENABLE, 0);
}

// PerfDisable: deaktiviert den Counter.
pub fn PerfDisable(fd: int64): int64 {
  return ioctl(fd, PERF_EVENT_IOC_DISABLE, 0);
}

// PerfReset: setzt den Zaehlerstand auf 0 zurueck.
pub fn PerfReset(fd: int64): int64 {
  return ioctl(fd, PERF_EVENT_IOC_RESET, 0);
}
