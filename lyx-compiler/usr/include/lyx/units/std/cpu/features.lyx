// std/cpu/features.lyx
// CPU-Faehigkeiten ueber CPUID.
//
// #2187: Bis 1.2.18D parste diese Unit `/proc/cpuinfo` und suchte darin die
// Zeichenketten " sse2", " sse4_1" und " avx2". Drei Dinge waren daran falsch:
//
//   1. Sie trug `@capabilities([fs.read])`. Jedes Programm, das nur wissen
//      wollte, ob die CPU AVX2 kann, bekam damit Leserechte aufs Dateisystem.
//   2. Ohne `/proc` — auf lyxos, bare metal, in einem engen Container —
//      scheiterte `open` und die Funktion gab 0 zurueck, ununterscheidbar von
//      "diese CPU kann nichts davon". Ein stiller Default.
//   3. Drei Bits waren alles, was sie kannte.
//
// Jetzt wird die CPU selbst gefragt. `cpu_id(leaf, subleaf, welches)` ist ein
// Builtin (welches: 0=eax 1=ebx 2=ecx 3=edx), `cpu_xgetbv(index)` liefert
// XCR0. Beide gibt es auf jedem x86-64; auf anderen Architekturen liefern sie
// 0, und 0 ist dort die richtige Antwort auf jede x86-Faehigkeitsfrage.
//
// Geprueft wurde jedes Bit einzeln gegen `lscpu` auf einer Maschine mit
// AES-NI, AVX2, BMI1/2, FMA, POPCNT, SSE2 und SSE4.1 — und ohne SHA-NI und
// AVX-512, damit auch die Gegenrichtung belegt ist.

// #2384: Dazugekommen sind die kryptographischen Erweiterungen — PCLMULQDQ,
// RDRAND, RDSEED, VAES, VPCLMULQDQ, Key Locker, SHA512, SM3, SM4. Zwei
// Angaben der Epic-Beschreibung stimmten nicht und sind hier nach Intel SDM
// und den Kernel-Definitionen (arch/x86/include/asm/cpufeatures.h) gesetzt:
//
//   * Key Locker steht in CPUID.(EAX=7,ECX=0):ECX Bit 23, nicht in
//     Blatt 7 Unterblatt 1 EAX Bit 23 — dort liegt AVX-IFMA.
//   * Ein SHA-3-Bit gibt es auf x86 nicht. Blatt 7 Unterblatt 1 EAX Bit 1 ist
//     SM3 (Bit 0 SHA512, Bit 2 SM4).
//
// Die Erkennung sagt nur, was die CPU KANN; Schnellwege, die diese Befehle
// nutzen, sind eigene Vorgaenge.
@description("CPU-Faehigkeiten ueber CPUID: SSE2 bis AVX-512, AES-NI, BMI, FMA, SHA, Krypto-Erweiterungen")
@author("Andreas Röne")
@copyright("2025 Andreas Röne")
unit std.cpu.features;

// Faehigkeits-Bits. Die ersten drei haben ihre Werte aus der Zeit vor #2187
// behalten, damit vorhandener Code weiterliest.
//
// #2035: Diese Konstanten SIND die Schnittstelle. Die ganze Aufzaehlung ist
// oeffentlich, nicht nur die gerade benutzten Bits — eine halb exportierte
// Aufzaehlung ist die Inkonsistenz, die spaeter beisst.
pub con CPU_FEAT_SSE2:    int64 := 1;
pub con CPU_FEAT_SSE41:   int64 := 2;
pub con CPU_FEAT_AVX2:    int64 := 4;
pub con CPU_FEAT_SSE42:   int64 := 8;
pub con CPU_FEAT_POPCNT:  int64 := 16;
pub con CPU_FEAT_AESNI:   int64 := 32;
pub con CPU_FEAT_AVX:     int64 := 64;
pub con CPU_FEAT_FMA:     int64 := 128;
pub con CPU_FEAT_BMI1:    int64 := 256;
pub con CPU_FEAT_BMI2:    int64 := 512;
pub con CPU_FEAT_SHANI:   int64 := 1024;
pub con CPU_FEAT_AVX512F: int64 := 2048;
pub con CPU_FEAT_LZCNT:   int64 := 4096;

// #2384: kryptographische Erweiterungen.
pub con CPU_FEAT_PCLMUL:    int64 := 8192;      // CPUID.1:ECX Bit 1
pub con CPU_FEAT_RDRAND:    int64 := 16384;     // CPUID.1:ECX Bit 30
pub con CPU_FEAT_RDSEED:    int64 := 32768;     // CPUID.7.0:EBX Bit 18
pub con CPU_FEAT_VAES:      int64 := 65536;     // CPUID.7.0:ECX Bit 9
pub con CPU_FEAT_VPCLMUL:   int64 := 131072;    // CPUID.7.0:ECX Bit 10
pub con CPU_FEAT_KEYLOCKER: int64 := 262144;    // CPUID.7.0:ECX Bit 23
pub con CPU_FEAT_SHA512:    int64 := 524288;    // CPUID.7.1:EAX Bit 0
pub con CPU_FEAT_SM3:       int64 := 1048576;   // CPUID.7.1:EAX Bit 1
pub con CPU_FEAT_SM4:       int64 := 2097152;   // CPUID.7.1:EAX Bit 2

// Ermittelte Bitmaske. Das Flag ist noetig, weil 0 ein gueltiges Ergebnis ist:
// eine CPU ohne jede dieser Faehigkeiten (oder eine andere Architektur) liefert
// genau das, und ohne Flag wuerde jedes Mal neu gemessen.
var cpuFeaturesCache: int64 := 0;
var cpuFeaturesProbedFlag: int64 := 0;

// Trägt CPUID das Blatt `leaf` überhaupt? Blatt 0 nennt in eax die höchste
// unterstützte Nummer. Ohne diese Frage liest man auf einer älteren CPU das
// Ergebnis des höchsten vorhandenen Blattes und deutet fremde Bits.
fn cpu_leafVorhanden(leaf: int64): int64 {
  var max: int64 := cpu_id(0, 0, 0);
  if (max < leaf) { return 0; }
  return 1;
}

// Ermittelt die Faehigkeiten der laufenden CPU. Ergebnis wird gemerkt.
pub fn CpuFeatureDetect(): int64 {
  if (cpuFeaturesProbedFlag != 0) { return cpuFeaturesCache; }
  cpuFeaturesProbedFlag := 1;

  var feats: int64 := 0;

  // --- Blatt 1: die alten Faehigkeiten -------------------------------------
  if (cpu_leafVorhanden(1) != 0) {
    var ecx1: int64 := cpu_id(1, 0, 2);
    var edx1: int64 := cpu_id(1, 0, 3);

    if (((edx1 >> 26) & 1) != 0) { feats := feats | CPU_FEAT_SSE2; }
    if (((ecx1 >> 19) & 1) != 0) { feats := feats | CPU_FEAT_SSE41; }
    if (((ecx1 >> 20) & 1) != 0) { feats := feats | CPU_FEAT_SSE42; }
    if (((ecx1 >> 23) & 1) != 0) { feats := feats | CPU_FEAT_POPCNT; }
    if (((ecx1 >> 25) & 1) != 0) { feats := feats | CPU_FEAT_AESNI; }
    if (((ecx1 >> 1)  & 1) != 0) { feats := feats | CPU_FEAT_PCLMUL; }
    if (((ecx1 >> 30) & 1) != 0) { feats := feats | CPU_FEAT_RDRAND; }

    // AVX, FMA und alles Breitere brauchen ZWEI Zusagen: die CPU muss den
    // Befehlssatz haben UND das Betriebssystem muss den erweiterten
    // Registerzustand sichern. Fehlt das zweite, faultet der erste
    // ymm-Zugriff nach einem Kontextwechsel. Geprueft wird es ueber
    // OSXSAVE (ecx Bit 27) und dann XCR0: Bit 1 = SSE-Zustand,
    // Bit 2 = oberer YMM-Teil.
    var osxsave: int64 := (ecx1 >> 27) & 1;
    var ymmOk: int64 := 0;
    if (osxsave != 0) {
      var xcr0: int64 := cpu_xgetbv(0);
      if ((xcr0 & 6) == 6) { ymmOk := 1; }
    }

    if (ymmOk != 0 && ((ecx1 >> 28) & 1) != 0) { feats := feats | CPU_FEAT_AVX; }
    if (ymmOk != 0 && ((ecx1 >> 12) & 1) != 0) { feats := feats | CPU_FEAT_FMA; }

    // --- Blatt 7, Unterblatt 0 ---------------------------------------------
    if (cpu_leafVorhanden(7) != 0) {
      var ebx7: int64 := cpu_id(7, 0, 1);
      if (((ebx7 >> 3)  & 1) != 0) { feats := feats | CPU_FEAT_BMI1; }
      if (((ebx7 >> 8)  & 1) != 0) { feats := feats | CPU_FEAT_BMI2; }
      if (((ebx7 >> 29) & 1) != 0) { feats := feats | CPU_FEAT_SHANI; }
      if (((ebx7 >> 18) & 1) != 0) { feats := feats | CPU_FEAT_RDSEED; }

      // #2384: VAES und VPCLMULQDQ sind die 256/512-Bit-Formen von AESENC
      // bzw. PCLMULQDQ; ohne gesicherten YMM-Zustand ist der erste Zugriff
      // nach einem Kontextwechsel ein Fault, also dieselbe Doppelzusage wie
      // bei AVX. Key Locker haengt nicht am Registerzustand und wird roh
      // gelesen.
      var ecx7: int64 := cpu_id(7, 0, 2);
      if (ymmOk != 0 && ((ecx7 >> 9)  & 1) != 0) { feats := feats | CPU_FEAT_VAES; }
      if (ymmOk != 0 && ((ecx7 >> 10) & 1) != 0) { feats := feats | CPU_FEAT_VPCLMUL; }
      if (((ecx7 >> 23) & 1) != 0) { feats := feats | CPU_FEAT_KEYLOCKER; }

      // --- Blatt 7, Unterblatt 1 ---------------------------------------
      // Blatt 7 nennt seine hoechste Unterblattnummer in eax von
      // Unterblatt 0. Ohne diese Frage liest man auf einer CPU, die nur
      // Unterblatt 0 kennt, dessen eigene Bits erneut und deutet sie als
      // SHA512/SM3/SM4.
      var maxSub: int64 := cpu_id(7, 0, 0);
      if (maxSub >= 1) {
        var eax71: int64 := cpu_id(7, 1, 0);
        if (((eax71 >> 0) & 1) != 0) { feats := feats | CPU_FEAT_SHA512; }
        if (((eax71 >> 1) & 1) != 0) { feats := feats | CPU_FEAT_SM3; }
        if (((eax71 >> 2) & 1) != 0) { feats := feats | CPU_FEAT_SM4; }
      }
      if (ymmOk != 0 && ((ebx7 >> 5) & 1) != 0) { feats := feats | CPU_FEAT_AVX2; }

      // AVX-512 braucht zusaetzlich die Maskenregister (XCR0 Bit 5) und beide
      // ZMM-Haelften (Bit 6 und 7). AVX512F ist ausserdem nur die Grundmenge;
      // weitere Teilmengen sind EINZELN zu fragen, eine Sammelabfrage vergaebe
      // Rechte zu weit.
      if (osxsave != 0 && ((ebx7 >> 16) & 1) != 0) {
        var xcr0b: int64 := cpu_xgetbv(0);
        if ((xcr0b & 224) == 224) { feats := feats | CPU_FEAT_AVX512F; }
      }
    }
  }

  // --- erweitertes Blatt 0x80000001: LZCNT (bei AMD "ABM") -----------------
  // Die erweiterten Blaetter haben ihren eigenen Hoechstwert in eax von
  // 0x80000000; die Frage nach Blatt 0 beantwortet sie nicht.
  var maxExt: int64 := cpu_id(2147483648, 0, 0);
  if (maxExt >= 2147483649) {
    var ecxE: int64 := cpu_id(2147483649, 0, 2);
    if (((ecxE >> 5) & 1) != 0) { feats := feats | CPU_FEAT_LZCNT; }
  }

  cpuFeaturesCache := feats;
  return feats;
}

// Einzelabfragen
pub fn CpuHasSSE2(): int64    { return (CpuFeatureDetect() & CPU_FEAT_SSE2)    != 0; }
pub fn CpuHasSSE41(): int64   { return (CpuFeatureDetect() & CPU_FEAT_SSE41)   != 0; }
pub fn CpuHasSSE42(): int64   { return (CpuFeatureDetect() & CPU_FEAT_SSE42)   != 0; }
pub fn CpuHasPOPCNT(): int64  { return (CpuFeatureDetect() & CPU_FEAT_POPCNT)  != 0; }
pub fn CpuHasLZCNT(): int64   { return (CpuFeatureDetect() & CPU_FEAT_LZCNT)   != 0; }
pub fn CpuHasAESNI(): int64   { return (CpuFeatureDetect() & CPU_FEAT_AESNI)   != 0; }
pub fn CpuHasAVX(): int64     { return (CpuFeatureDetect() & CPU_FEAT_AVX)     != 0; }
pub fn CpuHasAVX2(): int64    { return (CpuFeatureDetect() & CPU_FEAT_AVX2)    != 0; }
pub fn CpuHasFMA(): int64     { return (CpuFeatureDetect() & CPU_FEAT_FMA)     != 0; }
pub fn CpuHasBMI1(): int64    { return (CpuFeatureDetect() & CPU_FEAT_BMI1)    != 0; }
pub fn CpuHasBMI2(): int64    { return (CpuFeatureDetect() & CPU_FEAT_BMI2)    != 0; }
pub fn CpuHasSHANI(): int64   { return (CpuFeatureDetect() & CPU_FEAT_SHANI)   != 0; }
pub fn CpuHasAVX512F(): int64 { return (CpuFeatureDetect() & CPU_FEAT_AVX512F) != 0; }
pub fn CpuHasPCLMUL(): int64    { return (CpuFeatureDetect() & CPU_FEAT_PCLMUL)    != 0; }
pub fn CpuHasRDRAND(): int64    { return (CpuFeatureDetect() & CPU_FEAT_RDRAND)    != 0; }
pub fn CpuHasRDSEED(): int64    { return (CpuFeatureDetect() & CPU_FEAT_RDSEED)    != 0; }
pub fn CpuHasVAES(): int64      { return (CpuFeatureDetect() & CPU_FEAT_VAES)      != 0; }
pub fn CpuHasVPCLMUL(): int64   { return (CpuFeatureDetect() & CPU_FEAT_VPCLMUL)   != 0; }
pub fn CpuHasKeyLocker(): int64 { return (CpuFeatureDetect() & CPU_FEAT_KEYLOCKER) != 0; }
pub fn CpuHasSHA512(): int64    { return (CpuFeatureDetect() & CPU_FEAT_SHA512)    != 0; }
pub fn CpuHasSM3(): int64       { return (CpuFeatureDetect() & CPU_FEAT_SM3)       != 0; }
pub fn CpuHasSM4(): int64       { return (CpuFeatureDetect() & CPU_FEAT_SM4)       != 0; }

// ── #2398: WARUM fehlt ein Bit? ─────────────────────────────────────────────
//
// CpuHas*() sagt "vorhanden UND nutzbar": die zustandsbehafteten Bits (AVX,
// AVX2, FMA, AVX512F, VAES, VPCLMULQDQ) sind oben schon gegen OSXSAVE und die
// zustaendigen XCR0-Bits gefiltert. Was fehlte, ist die BEGRUENDUNG: von
// aussen war nicht unterscheidbar, ob die CPU das Bit nicht hat, ob das
// Betriebssystem den Registerzustand nicht sichert oder ob ein Kernelparameter
// es abgeschaltet hat. Genau diese Kette braucht `lyx-cpu explain` (#2402).
//
// Die Zuordnung Bit -> benoetigte XCR0-Bits steht als EINE Tabelle
// (cpuXcr0Bedarf), nicht als zweite Kette von `if`. Ein Bit, das dort fehlt,
// laesst die Abfrage LAUT scheitern — nicht als "nutzbar" durchgehen. Das ist
// die Regel "unvollstaendige Aufzaehlung": eine neue Faehigkeit muss in beide
// Aufzaehlungen, und das Scheitern erinnert daran.

pub con CPU_NUTZBAR:              int64 := 0;   // vorhanden und nutzbar
pub con CPU_FEHLT_IN_HARDWARE:    int64 := 1;   // CPUID-Bit nicht gesetzt
pub con CPU_FEHLT_OSXSAVE:        int64 := 2;   // CPU kann es, OS sichert keinen XSAVE-Zustand
pub con CPU_FEHLT_XCR0:           int64 := 3;   // OSXSAVE da, aber der Zustand ist nicht freigegeben
pub con CPU_FEHLT_KEIN_X86:       int64 := 4;   // kein CPUID (arm64, riscv, Mikrocontroller)

// Welche XCR0-Bits braucht dieses Faehigkeitsbit? 0 = keine (zustandslos).
// Rueckgabe -1 = Bit nicht in der Tabelle.
fn cpuXcr0Bedarf(feat: int64): int64 {
  // Zustandslos: laufen ohne gesicherten erweiterten Registerzustand.
  if (feat == CPU_FEAT_SSE2 || feat == CPU_FEAT_SSE41 || feat == CPU_FEAT_SSE42) { return 0; }
  if (feat == CPU_FEAT_POPCNT || feat == CPU_FEAT_LZCNT) { return 0; }
  if (feat == CPU_FEAT_AESNI || feat == CPU_FEAT_PCLMUL) { return 0; }
  if (feat == CPU_FEAT_BMI1 || feat == CPU_FEAT_BMI2) { return 0; }
  if (feat == CPU_FEAT_SHANI || feat == CPU_FEAT_RDRAND || feat == CPU_FEAT_RDSEED) { return 0; }
  if (feat == CPU_FEAT_KEYLOCKER || feat == CPU_FEAT_SHA512) { return 0; }
  if (feat == CPU_FEAT_SM3 || feat == CPU_FEAT_SM4) { return 0; }
  // XMM- und YMM-Zustand (Bit 1 und 2).
  if (feat == CPU_FEAT_AVX || feat == CPU_FEAT_AVX2 || feat == CPU_FEAT_FMA) { return 6; }
  if (feat == CPU_FEAT_VAES || feat == CPU_FEAT_VPCLMUL) { return 6; }
  // Zusaetzlich Maskenregister und beide ZMM-Haelften (Bit 5, 6, 7).
  if (feat == CPU_FEAT_AVX512F) { return 230; }
  return 0 - 1;
}

// Rohes CPUID-Bit OHNE die Zustandsfilter — fuer die Begruendung gebraucht:
// nur so ist "Hardware kann es, OS gibt es nicht frei" von "Hardware kann es
// nicht" unterscheidbar.
fn cpuRohBit(feat: int64): int64 {
  if (cpu_leafVorhanden(1) == 0) { return 0; }
  var ecx1: int64 := cpu_id(1, 0, 2);
  var edx1: int64 := cpu_id(1, 0, 3);
  if (feat == CPU_FEAT_SSE2)   { return (edx1 >> 26) & 1; }
  if (feat == CPU_FEAT_SSE41)  { return (ecx1 >> 19) & 1; }
  if (feat == CPU_FEAT_SSE42)  { return (ecx1 >> 20) & 1; }
  if (feat == CPU_FEAT_POPCNT) { return (ecx1 >> 23) & 1; }
  if (feat == CPU_FEAT_AESNI)  { return (ecx1 >> 25) & 1; }
  if (feat == CPU_FEAT_PCLMUL) { return (ecx1 >> 1)  & 1; }
  if (feat == CPU_FEAT_RDRAND) { return (ecx1 >> 30) & 1; }
  if (feat == CPU_FEAT_AVX)    { return (ecx1 >> 28) & 1; }
  if (feat == CPU_FEAT_FMA)    { return (ecx1 >> 12) & 1; }
  if (feat == CPU_FEAT_LZCNT) {
    var maxExt: int64 := cpu_id(2147483648, 0, 0);
    if (maxExt < 2147483649) { return 0; }
    return (cpu_id(2147483649, 0, 2) >> 5) & 1;
  }
  if (cpu_leafVorhanden(7) == 0) { return 0; }
  var ebx7: int64 := cpu_id(7, 0, 1);
  var ecx7: int64 := cpu_id(7, 0, 2);
  if (feat == CPU_FEAT_BMI1)    { return (ebx7 >> 3)  & 1; }
  if (feat == CPU_FEAT_BMI2)    { return (ebx7 >> 8)  & 1; }
  if (feat == CPU_FEAT_SHANI)   { return (ebx7 >> 29) & 1; }
  if (feat == CPU_FEAT_RDSEED)  { return (ebx7 >> 18) & 1; }
  if (feat == CPU_FEAT_AVX2)    { return (ebx7 >> 5)  & 1; }
  if (feat == CPU_FEAT_AVX512F) { return (ebx7 >> 16) & 1; }
  if (feat == CPU_FEAT_VAES)    { return (ecx7 >> 9)  & 1; }
  if (feat == CPU_FEAT_VPCLMUL) { return (ecx7 >> 10) & 1; }
  if (feat == CPU_FEAT_KEYLOCKER) { return (ecx7 >> 23) & 1; }
  var maxSub: int64 := cpu_id(7, 0, 0);
  if (maxSub < 1) { return 0; }
  var eax71: int64 := cpu_id(7, 1, 0);
  if (feat == CPU_FEAT_SHA512) { return (eax71 >> 0) & 1; }
  if (feat == CPU_FEAT_SM3)    { return (eax71 >> 1) & 1; }
  if (feat == CPU_FEAT_SM4)    { return (eax71 >> 2) & 1; }
  return 0;
}

// Begruendung, warum ein Faehigkeitsbit nicht nutzbar ist — oder
// CPU_NUTZBAR. `feat` ist eine der CPU_FEAT_*-Konstanten.
//
// Scheitert LAUT, wenn `feat` keine bekannte Konstante ist: ein Tippfehler
// oder eine neu dazugekommene Faehigkeit soll auffallen und nicht als
// "nutzbar" oder "fehlt in Hardware" durchgehen.
pub fn CpuFeatureUnusableReason(feat: int64): int64 {
  if (CpuHasCpuid() == 0) { return CPU_FEHLT_KEIN_X86; }
  var bedarf: int64 := cpuXcr0Bedarf(feat);
  if (bedarf < 0) {
    panic("std.cpu.features: unbekanntes Faehigkeitsbit in CpuFeatureUnusableReason — Tabelle cpuXcr0Bedarf nachziehen (#2398)");
  }
  if (cpuRohBit(feat) == 0) { return CPU_FEHLT_IN_HARDWARE; }
  if (bedarf == 0) { return CPU_NUTZBAR; }
  var ecx1: int64 := cpu_id(1, 0, 2);
  if (((ecx1 >> 27) & 1) == 0) { return CPU_FEHLT_OSXSAVE; }
  var xcr0: int64 := cpu_xgetbv(0);
  if ((xcr0 & bedarf) != bedarf) { return CPU_FEHLT_XCR0; }
  return CPU_NUTZBAR;
}

// Name der Begruendung fuer Berichte.
pub fn CpuUnusableReasonName(grund: int64): pchar {
  if (grund == CPU_NUTZBAR)           { return "nutzbar"c; }
  if (grund == CPU_FEHLT_IN_HARDWARE) { return "nicht in Hardware"c; }
  if (grund == CPU_FEHLT_OSXSAVE)     { return "kein OSXSAVE (OS sichert keinen XSAVE-Zustand)"c; }
  if (grund == CPU_FEHLT_XCR0)        { return "XCR0-Bit fehlt (Zustand nicht freigegeben, z. B. noxsave)"c; }
  if (grund == CPU_FEHLT_KEIN_X86)    { return "kein CPUID (nicht x86)"c; }
  return "unbekannte Begruendung"c;
}

// Faehigkeitsbit zu einem Namen — die Liste, die `lyx-cpu explain` zulaesst.
// Rueckgabe 0 = Name unbekannt (der Aufrufer meldet das laut, siehe #2402).
pub fn CpuFeatureBitAusName(nm: pchar, nl: int64): int64 {
  if (cpuNameGleich(nm, nl, "sse2"c, 4))       { return CPU_FEAT_SSE2; }
  if (cpuNameGleich(nm, nl, "sse4_1"c, 6))     { return CPU_FEAT_SSE41; }
  if (cpuNameGleich(nm, nl, "sse4_2"c, 6))     { return CPU_FEAT_SSE42; }
  if (cpuNameGleich(nm, nl, "popcnt"c, 6))     { return CPU_FEAT_POPCNT; }
  if (cpuNameGleich(nm, nl, "abm"c, 3))        { return CPU_FEAT_LZCNT; }
  if (cpuNameGleich(nm, nl, "aes"c, 3))        { return CPU_FEAT_AESNI; }
  if (cpuNameGleich(nm, nl, "pclmulqdq"c, 9))  { return CPU_FEAT_PCLMUL; }
  if (cpuNameGleich(nm, nl, "avx"c, 3))        { return CPU_FEAT_AVX; }
  if (cpuNameGleich(nm, nl, "avx2"c, 4))       { return CPU_FEAT_AVX2; }
  if (cpuNameGleich(nm, nl, "avx512f"c, 7))    { return CPU_FEAT_AVX512F; }
  if (cpuNameGleich(nm, nl, "fma"c, 3))        { return CPU_FEAT_FMA; }
  if (cpuNameGleich(nm, nl, "bmi1"c, 4))       { return CPU_FEAT_BMI1; }
  if (cpuNameGleich(nm, nl, "bmi2"c, 4))       { return CPU_FEAT_BMI2; }
  if (cpuNameGleich(nm, nl, "sha_ni"c, 6))     { return CPU_FEAT_SHANI; }
  if (cpuNameGleich(nm, nl, "vaes"c, 4))       { return CPU_FEAT_VAES; }
  if (cpuNameGleich(nm, nl, "vpclmulqdq"c, 10)) { return CPU_FEAT_VPCLMUL; }
  if (cpuNameGleich(nm, nl, "rdrand"c, 6))     { return CPU_FEAT_RDRAND; }
  if (cpuNameGleich(nm, nl, "rdseed"c, 6))     { return CPU_FEAT_RDSEED; }
  if (cpuNameGleich(nm, nl, "keylocker"c, 9))  { return CPU_FEAT_KEYLOCKER; }
  if (cpuNameGleich(nm, nl, "sha512"c, 6))     { return CPU_FEAT_SHA512; }
  if (cpuNameGleich(nm, nl, "sm3"c, 3))        { return CPU_FEAT_SM3; }
  if (cpuNameGleich(nm, nl, "sm4"c, 3))        { return CPU_FEAT_SM4; }
  return 0;
}

// Die zulaessigen Namen als eine Zeile — fuer die Fehlermeldung bei einem
// unbekannten Namen (#2402: "nennt die zulaessigen Werte").
pub fn CpuFeatureNamenListe(): pchar {
  return "sse2 sse4_1 sse4_2 popcnt abm aes pclmulqdq avx avx2 avx512f fma bmi1 bmi2 sha_ni vaes vpclmulqdq rdrand rdseed keylocker sha512 sm3 sm4"c;
}

fn cpuNameGleich(a: pchar, al: int64, b: pchar, bl: int64): int64 {
  if (al != bl) { return 0; }
  var i: int64 := 0;
  while (i < al) {
    if (peek8((a as int64) + i) != peek8((b as int64) + i)) { return 0; }
    i := i + 1;
  }
  return 1;
}

// Ist diese Architektur ueberhaupt x86? CPUID gibt es nur dort; auf arm64,
// riscv und den Mikrocontroller-Zielen liefert das Builtin 0, und Blatt 0
// meldet dann eine Hoechstnummer von 0. Wer die Unterscheidung braucht, soll
// sie ausdruecklich treffen koennen statt aus lauter Nullen zu raten.
pub fn CpuHasCpuid(): int64 { return cpu_id(0, 0, 0) != 0; }
