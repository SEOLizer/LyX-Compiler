// std/cpu/features.lyx
// WP-GPU-02: CPU feature detection via /proc/cpuinfo parsing.
// Parses the flags field to detect SSE2, SSE4.1 and AVX2 capability.

@description("CPU feature detection: SSE2, SSE4.1, AVX2 via /proc/cpuinfo")
@author("Andreas Röne")
@copyright("2025 Andreas Röne")
@capabilities([fs.read])
unit std.cpu.features;

import std.alloc;
import std.io;

// Feature flag constants (bitmask)
con CPU_FEAT_SSE2:  int64 := 1;
con CPU_FEAT_SSE41: int64 := 2;
con CPU_FEAT_AVX2:  int64 := 4;

// Detected feature bitmask (0 = not yet probed)
var cpuFeaturesCache: int64 := 0;
var cpuFeaturesProbedFlag: int64 := 0;

// Returns 1 if needle is found within [haystack, haystack+hlen), else 0.
fn cpu_memmem(haystack: pchar, hlen: int64, needle: pchar, nlen: int64): int64 {
  if (nlen == 0) { return 1; }
  if (hlen < nlen) { return 0; }
  var i: int64 := 0;
  while (i <= hlen - nlen) {
    var j: int64 := 0;
    var ok: int64 := 1;
    while (j < nlen) {
      var hc: int64 := peek8(haystack + i + j) as int64;
      var nc: int64 := peek8(needle + j) as int64;
      if (hc != nc) { ok := 0; j := nlen; }
      j += 1;
    }
    if (ok != 0) { return 1; }
    i += 1;
  }
  return 0;
}

// Parse /proc/cpuinfo and return bitmask of detected CPU_FEAT_* flags.
// Result is cached after first call.
pub fn CpuFeatureDetect(): int64 {
  if (cpuFeaturesProbedFlag != 0) { return cpuFeaturesCache; }
  cpuFeaturesProbedFlag := 1;

  // Open /proc/cpuinfo for reading
  var fd: int64 := open("/proc/cpuinfo", 0);
  if (fd < 0) { return 0; }

  // Read up to 8 KB
  var bufSz: int64 := 8192;
  var tbuf: int64 := alloc(bufSz + 1);
  var nread: int64 := read(fd, tbuf as pchar, bufSz);
  close(fd);
  if (nread <= 0) { return 0; }
  poke8(tbuf + nread, 0);  // NUL-terminate

  var feats: int64 := 0;

  // Look for "flags" line — the flags are space-separated tokens after "flags\t: "
  // We scan the whole buffer for the token substrings.
  // SSE2 is represented as " sse2 " or at start/end of flags line.
  // We search for " sse2" (with leading space) to avoid matching "sse2_..."
  if (cpu_memmem(tbuf as pchar, nread, " sse2", 5) != 0) {
    feats := feats | CPU_FEAT_SSE2;
  }
  if (cpu_memmem(tbuf as pchar, nread, " sse4_1", 7) != 0) {
    feats := feats | CPU_FEAT_SSE41;
  }
  if (cpu_memmem(tbuf as pchar, nread, " avx2", 5) != 0) {
    feats := feats | CPU_FEAT_AVX2;
  }

  cpuFeaturesCache := feats;
  return feats;
}

// Convenience query functions
pub fn CpuHasSSE2(): int64  { return (CpuFeatureDetect() & CPU_FEAT_SSE2)  != 0; }
pub fn CpuHasSSE41(): int64 { return (CpuFeatureDetect() & CPU_FEAT_SSE41) != 0; }
pub fn CpuHasAVX2(): int64  { return (CpuFeatureDetect() & CPU_FEAT_AVX2)  != 0; }
