unit std.fs;

import std.alloc;
// ============================================================================
// Typen
// ============================================================================

// File descriptor/handle - abstrakt für Unix fd und Windows HANDLE
pub type fd = int64;

// ============================================================================
// Konstanten - Unix-Standard Flags (auf Windows gemappt)
// ============================================================================

// Zugriffsmodi
pub con O_RDONLY: int64 := 0;      // Nur Lesen
pub con O_WRONLY: int64 := 1;      // Nur Schreiben
pub con O_RDWR: int64 := 2;        // Lesen und Schreiben

// Creation/Status Flags
pub con O_CREAT: int64 := 64;      // 0100 - Erstellen falls nicht existiert
pub con O_TRUNC: int64 := 512;     // 01000 - Auf 0 Bytes kürzen
pub con O_APPEND: int64 := 1024;   // 02000 - Anhängen
pub con O_EXCL: int64 := 128;      // 0200 - Fehler falls existiert

// Datei-Rechte (Mode für open mit O_CREAT)
pub con S_IRUSR: int64 := 256;     // 0400 - Owner read
pub con S_IWUSR: int64 := 128;     // 0200 - Owner write
pub con S_IRGRP: int64 := 32;      // 0040 - Group read
pub con S_IWGRP: int64 := 16;      // 0020 - Group write
pub con S_IROTH: int64 := 4;       // 0004 - Other read
pub con S_IWOTH: int64 := 2;       // 0002 - Other write

// Standard file permissions: rw-r--r-- (0644)
pub con DEFAULT_MODE: int64 := 420; // 0644 octal

// Special file descriptors
pub con STDIN_FILENO: int64 := 0;
pub con STDOUT_FILENO: int64 := 1;
pub con STDERR_FILENO: int64 := 2;

// ============================================================================
// Syscall Nummern für Linux x86_64
// ============================================================================

con SYS_OPEN:  int64 := 2;
con SYS_UNLINK: int64 := 87;
con SYS_RENAME: int64 := 82;
con SYS_LSEEK: int64 := 8;
con SYS_EXIT: int64 := 60;

// ============================================================================
// Hinweis: open/read/write/close/lseek/unlink/rename sind Compiler-Builtins.
// Wrapper-Funktionen sind nicht nötig; die Hilfsfunktionen unten nutzen sie direkt.
// ============================================================================

// Directory open flag
pub con O_DIRECTORY: int64 := 65536;  // 0200000 octal — open must be a directory

// Directory entry types (d_type field from getdents64)
pub con DT_UNKNOWN: int64 := 0;
pub con DT_FIFO:    int64 := 1;
pub con DT_CHR:     int64 := 2;
pub con DT_DIR:     int64 := 4;
pub con DT_BLK:     int64 := 6;
pub con DT_REG:     int64 := 8;
pub con DT_LNK:     int64 := 10;
pub con DT_SOCK:    int64 := 12;

// ============================================================================
// Konstanten für lseek
// ============================================================================

pub con SEEK_SET: int64 := 0;  // Vom Dateianfang
pub con SEEK_CUR: int64 := 1;  // Von aktueller Position
pub con SEEK_END: int64 := 2;  // Vom Dateiende

// ============================================================================
// Hilfsfunktionen (pure Lyx)
// ============================================================================

// Prüft ob ein File Descriptor gültig ist
pub fn IsValidFd(f: fd): bool {
  return f >= 0;
}

// ============================================================================
// WP-FS-01: File-Existence & Type-Checks
// ============================================================================

// Prüft ob ein Pfad existiert (Datei oder Verzeichnis).
pub fn FileExists(path: pchar): bool {
  var f: fd := open(path, O_RDONLY, 0);
  if (f < 0) {
    return false;
  }
  close(f);
  return true;
}

// Prüft ob ein Pfad ein Verzeichnis ist.
pub fn IsDirectory(path: pchar): bool {
  var f: fd := open(path, O_RDONLY | O_DIRECTORY, 0);
  if (f < 0) {
    return false;
  }
  close(f);
  return true;
}

// Prüft ob ein Pfad eine reguläre Datei ist (kein Verzeichnis).
// Hinweis: Symlinks auf Verzeichnisse geben false zurück.
pub fn IsFile(path: pchar): bool {
  var f: fd := open(path, O_RDONLY, 0);
  if (f < 0) {
    return false;
  }
  close(f);
  var d: fd := open(path, O_RDONLY | O_DIRECTORY, 0);
  if (d >= 0) {
    close(d);
    return false;
  }
  return true;
}

// ============================================================================
// WP-FS-02: Verzeichnis-Schreib-Ops & Umbenennungen
// ============================================================================

// Zusätzliche Permission-Konstanten (rwx-Gruppen)
pub con S_IRWXU: int64 := 448;       // 0700 — Owner rwx
pub con S_IXUSR: int64 := 64;        // 0100 — Owner execute
pub con S_IRWXG: int64 := 56;        // 0070 — Group rwx
pub con S_IRWXO: int64 := 7;         // 0007 — Other rwx
pub con DEFAULT_DIR_MODE: int64 := 493;  // 0755 — Standard-Verzeichnis

// Erstellt ein Verzeichnis. mode typischerweise DEFAULT_DIR_MODE (0755).
// Gibt false zurück wenn das Verzeichnis bereits existiert oder der Pfad ungültig ist.
pub fn Mkdir(path: pchar, mode: int64): bool {
  return mkdir(path, mode) == 0;
}

// Löscht ein leeres Verzeichnis.
pub fn Rmdir(path: pchar): bool {
  return rmdir(path) == 0;
}

// Löscht eine Datei oder ein leeres Verzeichnis.
// Versucht zuerst unlink (Datei), dann rmdir (Verzeichnis).
pub fn Remove(path: pchar): bool {
  if (unlink(path) == 0) {
    return true;
  }
  return rmdir(path) == 0;
}

// Benennt eine Datei oder ein Verzeichnis um / verschiebt es.
pub fn Rename(oldPath: pchar, newPath: pchar): bool {
  return rename(oldPath, newPath) == 0;
}

// Setzt die Zugriffsrechte eines Pfades.
// mode: Oktalwert, z.B. 420 (0644), 493 (0755), 448 (0700).
pub fn Chmod(path: pchar, mode: int64): bool {
  return chmod(path, mode) == 0;
}

// ============================================================================
// WP-FS-03: File-Utilities — Copy, Move, ReadAll
// ============================================================================

// Kopiert eine Datei von src nach dest.
// Allokiert intern einen temporären mmap-Buffer; die Quelldatei wird
// vollständig gelesen und dann in einem Stück geschrieben.
// Gibt false zurück wenn src nicht lesbar, dest nicht schreibbar,
// oder die Quelldatei leer/nicht vorhanden ist.
pub fn FileCopy(src: pchar, dest: pchar): bool {
  var srcFd: fd := open(src, O_RDONLY, 0);
  if (srcFd < 0) {
    return false;
  }
  var size: int64 := lseek(srcFd, 0, SEEK_END);
  lseek(srcFd, 0, SEEK_SET);
  if (size <= 0) {
    close(srcFd);
    return false;
  }
  var buf: int64 := alloc(size);
  var nRead: int64 := read(srcFd, buf, size);
  close(srcFd);
  if (nRead != size) {
    free(buf, size);
    return false;
  }
  var dstFd: fd := open(dest, O_WRONLY | O_CREAT | O_TRUNC, DEFAULT_MODE);
  if (dstFd < 0) {
    free(buf, size);
    return false;
  }
  var nWritten: int64 := write(dstFd, buf, size);
  close(dstFd);
  free(buf, size);
  return nWritten == size;
}

// Verschiebt eine Datei. Versucht zuerst Rename (schnell, atomisch).
// Schlägt Rename fehl (z.B. EXDEV bei verschiedenen Dateisystemen),
// wird FileCopy + Remove als Fallback verwendet.
pub fn FileMove(src: pchar, dest: pchar): bool {
  if (Rename(src, dest)) {
    return true;
  }
  if (!FileCopy(src, dest)) {
    return false;
  }
  return Remove(src);
}

// FileReadAll(path): pchar  — Compiler-Builtin.
// Liest den gesamten Dateiinhalt, gibt null-terminierten pchar zurück (oder 0).
// Der Buffer hat exakt FileSize(path)+1 Bytes (mmap, anonym).
// Freigeben: FileReadFree(data) aufrufen.

// Gibt den von FileReadAll allokierten Buffer frei.
// Intern wird StrLen(data)+1 als munmap-Größe verwendet.
pub fn FileReadFree(data: pchar): void {
  if (data == 0 as pchar) {
    return;
  }
  var size: int64 := StrLen(data) + 1;
  free(data as int64, size);
}

// Liest kompletten Dateiinhalt in Buffer (max max_len Bytes)
// Returns: Anzahl gelesener Bytes oder -1 bei Fehler
pub fn ReadFile(path: pchar, buf: pchar, max_len: int64): int64 {
  var f: fd := open(path, O_RDONLY, 0);
  if (f < 0) {
    return -1;
  }

  var total: int64 := 0;
  var n: int64 := 0;

  while (total < max_len) {
    n := read(f, buf + total, max_len - total);
    if (n < 0) {
      close(f);
      return -1;  // Fehler
    }
    if (n == 0) {
      break;  // EOF
    }
    total += n;
  }

  close(f);
  return total;
}

// Schreibt Buffer in Datei (überschreibt existierende Datei)
// Returns: Anzahl geschriebener Bytes oder -1 bei Fehler
pub fn WriteFile(path: pchar, buf: pchar, len: int64): int64 {
  var f: fd := open(path, O_WRONLY | O_CREAT | O_TRUNC, DEFAULT_MODE);
  if (f < 0) {
    return -1;
  }

  var total: int64 := 0;
  var n: int64 := 0;

  while (total < len) {
    n := write(f, buf + total, len - total);
    if (n < 0) {
      close(f);
      return -1;
    }
    if (n == 0) {
      break;  // Kann nicht mehr schreiben
    }
    total += n;
  }

  close(f);
  return total;
}

// An Datei anhängen
// Returns: Anzahl geschriebener Bytes oder -1 bei Fehler
pub fn AppendFile(path: pchar, buf: pchar, len: int64): int64 {
  var f: fd := open(path, O_WRONLY | O_CREAT | O_APPEND, DEFAULT_MODE);
  if (f < 0) {
    return -1;
  }

  var n: int64 := write(f, buf, len);
  close(f);
  return n;
}

// Datei löschen (Wrapper)
pub fn DeleteFile(path: pchar): bool {
  return unlink(path) == 0;
}

// ============================================================================
// Dateigröße ermitteln
// ============================================================================

pub fn FileSize(path: pchar): int64 {
  var f: fd := open(path, O_RDONLY, 0);
  if (f < 0) {
    return -1;
  }

  // Gehe zum Ende der Datei
  var size: int64 := lseek(f, 0, SEEK_END);
  close(f);
  return size;
}

// ============================================================================
// Standard-I/O Wrapper (für Komfort)
// ============================================================================

// Text auf stdout ausgeben (low-level)
pub fn StdoutWrite(buf: pchar, len: int64): int64 {
  return write(STDOUT_FILENO, buf, len);
}

// Text auf stderr ausgeben
pub fn StderrWrite(buf: pchar, len: int64): int64 {
  return write(STDERR_FILENO, buf, len);
}

// Ein Zeichen ausgeben
pub fn PutChar(c: int64): int64 {
  var chbuf: int64 := alloc(8);
  if (chbuf == 0) { return -1; }
  poke8(chbuf, c);
  var ret: int64 := write(STDOUT_FILENO, chbuf, 1);
  free(chbuf, 8);
  return ret;
}

