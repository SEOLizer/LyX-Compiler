// ============================================================================
// Path-Funktionen (Pfad-Manipulation)
// ============================================================================

// Interner Puffer für Path-Operationen (max 4096 Zeichen)
con PATH_BUF_SIZE: int64 := 4096;

// Normalisiert einen Pfad: ./ und ../ und // auflösen
// "/home/user/./foo/../bar//baz" -> "/home/user/bar/baz"
//
// SICHERHEITSWARNUNG (SEC-BUG-05): PathNormalize ist rein LEXIKALISCH.
// Es löst KEINE Symlinks auf und erzwingt KEIN Root-Jail.
// Symlink-basierte Path-Traversal-Angriffe werden NICHT verhindert.
// Für Sicherheitsgrenzen (z.B. User-Upload-Pfade einschränken):
//   PathContainedIn(root, path) verwenden — prüft Präfix nach Normalisierung.
//   Für vollständigen Schutz zusätzlich realpath() aufrufen (löst Symlinks auf).
pub fn PathNormalize(dest: pchar, src: pchar): pchar {
  // SEC-BUG-05 fix: segment-stack algorithm — correct for all .. cases,
  // heap buffers (no fixed 80-byte literal overflow).
  var src_len: int64 := StrLen(src);
  var is_absolute: bool := false;
  if (src_len > 0 && StrCharAt(src, 0) == 47) { is_absolute := true; }  // '/'

  // Segment stack: store (start, len) pairs into src positions.
  // Max 512 segments (4096 bytes / 8 bytes per entry).
  var seg_starts: int64 := alloc(4096);
  var seg_lens:   int64 := alloc(4096);
  var seg_count:  int64 := 0;

  var i: int64 := 0;
  if (is_absolute) { i := 1; }
  var comp_start: int64 := i;

  // Process src char by char; flush segment at each '/' and at end.
  while (i <= src_len) {
    var c: int64 := 0;
    if (i < src_len) { c := StrCharAt(src, i); }
    if (c == 47 || i == src_len) {  // '/' or end
      var seg_len: int64 := i - comp_start;
      if (seg_len == 0) {
        // empty (multiple // or trailing slash) — skip
      } else if (seg_len == 1 && StrCharAt(src, comp_start) == 46) {
        // "." — skip
      } else if (seg_len == 2 && StrCharAt(src, comp_start) == 46
                               && StrCharAt(src, comp_start + 1) == 46) {
        // ".." — pop last segment (ignore if already at root)
        if (seg_count > 0) { seg_count := seg_count - 1; }
      } else {
        // normal segment — push
        if (seg_count < 512) {
          poke64(seg_starts + seg_count * 8, comp_start);
          poke64(seg_lens   + seg_count * 8, seg_len);
          seg_count += 1;
        }
      }
      comp_start := i + 1;
    }
    i += 1;
  }

  // Reconstruct dest from valid segments.
  var j: int64 := 0;
  if (is_absolute) { StrSetChar(dest, 0, 47); j := 1; }  // leading '/'

  var si: int64 := 0;
  while (si < seg_count) {
    var s: int64 := peek64(seg_starts + si * 8);
    var l: int64 := peek64(seg_lens   + si * 8);
    var k: int64 := 0;
    while (k < l && j < PATH_BUF_SIZE - 1) {
      StrSetChar(dest, j, StrCharAt(src, s + k));
      j += 1;
      k += 1;
    }
    // '/' between segments (not after last)
    if (si < seg_count - 1 && j < PATH_BUF_SIZE - 1) {
      StrSetChar(dest, j, 47);
      j += 1;
    }
    si += 1;
  }

  // Edge case: empty result (e.g. "/" or relative ".")
  if (j == 0 && is_absolute) { StrSetChar(dest, 0, 47); j := 1; }
  if (j == 0) { StrSetChar(dest, 0, 46); j := 1; }  // relative empty → "."

  StrSetChar(dest, j, 0);

  free(seg_starts, 4096);
  free(seg_lens,   4096);
  return dest;
}

// Prüft ob path lexikalisch innerhalb von root liegt (SEC-BUG-05).
//
// Normalisiert beide Pfade und prüft dass der normalisierte path-String
// mit dem normalisierten root-String beginnt, gefolgt von '/' oder Ende.
//
// Beispiele:
//   PathContainedIn("/srv/uploads", "/srv/uploads/img.png") → true
//   PathContainedIn("/srv/uploads", "/srv/uploads")         → true  (root selbst)
//   PathContainedIn("/srv/uploads", "/srv/uploads2/x")      → false (Präfix-Collision)
//   PathContainedIn("/srv/uploads", "/srv/uploads/../etc")  → false (traversal)
//   PathContainedIn("/srv/uploads", "/etc/passwd")          → false
//
// ACHTUNG: Rein lexikalisch — Symlinks werden NICHT aufgelöst.
// Für vollständigen Schutz: realpath() auf path aufrufen und Ergebnis prüfen.
pub fn PathContainedIn(root: pchar, path: pchar): bool {
  var normRoot: pchar := alloc(PATH_BUF_SIZE);
  var normPath: pchar := alloc(PATH_BUF_SIZE);

  PathNormalize(normRoot, root);
  PathNormalize(normPath, path);

  var rootLen: int64 := StrLen(normRoot);
  var pathLen: int64 := StrLen(normPath);

  // path kürzer als root → kann nicht enthalten sein
  if (pathLen < rootLen) {
    free(normRoot as int64, PATH_BUF_SIZE);
    free(normPath as int64, PATH_BUF_SIZE);
    return false;
  }

  // Präfix-Check: normPath muss mit normRoot beginnen
  var i: int64 := 0;
  while (i < rootLen) {
    if (StrCharAt(normPath, i) != StrCharAt(normRoot, i)) {
      free(normRoot as int64, PATH_BUF_SIZE);
      free(normPath as int64, PATH_BUF_SIZE);
      return false;
    }
    i += 1;
  }

  // Nach dem Root-Präfix muss '/' oder Ende folgen
  // (verhindert "/srv/uploads2" als false positive für root "/srv/uploads")
  var ok: bool := false;
  if (pathLen == rootLen) {
    ok := true;
  } else if (StrCharAt(normPath, rootLen) == 47) {  // '/'
    ok := true;
  } else if (rootLen > 0 && StrCharAt(normRoot, rootLen - 1) == 47) {
    ok := true;  // root endet selbst auf '/' (z.B. "/")
  }

  free(normRoot as int64, PATH_BUF_SIZE);
  free(normPath as int64, PATH_BUF_SIZE);
  return ok;
}

// Gibt den Verzeichnis-Teil eines Pfades zurück
// "/home/user/doc.lyx" -> "/home/user"
// Gibt "." zurück wenn kein Verzeichnis
pub fn PathDir(dest: pchar, path: pchar): pchar {
  var path_len: int64 := StrLen(path);
  if (path_len == 0) {
    StrSetChar(dest, 0, 46); StrSetChar(dest, 1, 0);  // "."
    return dest;
  }
  
  // Finde letzten Slash
  var last_slash: int64 := -1;
  var i: int64 := path_len - 1;
  while (i >= 0) {
    if (StrCharAt(path, i) == 47) {  // '/'
      last_slash := i;
      break;
    }
    i -= 1;
  }
  
  if (last_slash <= 0) {
    // Kein Slash oder nur root
    StrSetChar(dest, 0, 46); StrSetChar(dest, 1, 0);  // "."
    return dest;
  }
  
  // Kopiere Verzeichnis-Teil
  var j: int64 := 0;
  while (j < last_slash) {
    StrSetChar(dest, j, StrCharAt(path, j));
    j += 1;
  }
  StrSetChar(dest, last_slash, 0);
  return dest;
}

// Gibt die Datei-Extension zurück (mit Punkt)
// "archive.tar.gz" -> ".gz"
// "" wenn keine Extension
pub fn PathExt(dest: pchar, path: pchar): pchar {
  var path_len: int64 := StrLen(path);
  if (path_len == 0) {
    StrSetChar(dest, 0, 0);
    return dest;
  }
  
  // Finde letzten Slash (um nur im Dateinamen zu suchen)
  var last_slash: int64 := -1;
  var i: int64 := path_len - 1;
  while (i >= 0) {
    if (StrCharAt(path, i) == 47) {  // '/'
      last_slash := i;
      break;
    }
    i -= 1;
  }
  
  // Finde letzten Punkt nach dem letzten Slash
  var last_dot: int64 := -1;
  i := last_slash + 1;
  while (i < path_len) {
    if (StrCharAt(path, i) == 46) {  // '.'
      last_dot := i;
    }
    i += 1;
  }
  
  if (last_dot < 0 || last_dot == path_len - 1) {
    // Kein Punkt oder punkt am Ende
    StrSetChar(dest, 0, 0);
    return dest;
  }
  
  // Kopiere Extension (mit Punkt)
  i := last_dot;
  var j: int64 := 0;
  while (i < path_len) {
    StrSetChar(dest, j, StrCharAt(path, i));
    i += 1;
    j += 1;
  }
  StrSetChar(dest, j, 0);
  return dest;
}

// Gibt den Basis-Dateinamen ohne Extension zurück
// "/tmp/data.csv" -> "data"
// "/tmp/archive.tar.gz" -> "archive.tar"
pub fn PathBase(dest: pchar, path: pchar): pchar {
  var path_len: int64 := StrLen(path);
  if (path_len == 0) {
    StrSetChar(dest, 0, 0);
    return dest;
  }
  
  // Finde letzten Slash
  var last_slash: int64 := -1;
  var i: int64 := path_len - 1;
  while (i >= 0) {
    if (StrCharAt(path, i) == 47) {  // '/'
      last_slash := i;
      break;
    }
    i -= 1;
  }
  
  var file_start: int64 := last_slash + 1;
  
  // Finde letzten Punkt nach dem Slash
  var last_dot: int64 := -1;
  i := file_start;
  while (i < path_len) {
    if (StrCharAt(path, i) == 46) {  // '.'
      last_dot := i;
    }
    i += 1;
  }
  
  var file_end: int64 := path_len;
  if (last_dot > file_start) {
    file_end := last_dot;
  }
  
  // Kopiere Basis-Name
  var j: int64 := 0;
  i := file_start;
  while (i < file_end) {
    StrSetChar(dest, j, StrCharAt(path, i));
    i += 1;
    j += 1;
  }
  StrSetChar(dest, j, 0);
  return dest;
}

// ============================================================================
// Directory Listing — v0.3.2
// ============================================================================
//
// DirList returns an opaque handle (mmap'd buffer) with this layout:
//   [0..7]  count      int64 — number of entries (excludes . and ..)
//   [8..15] totalSize  int64 — full buffer size (needed for DirFree)
//   [16..]  entries    — each entry:
//             [+0..+7]  nameLen  int64
//             [+8]      type     byte  (DT_* constant)
//             [+9..]    name     bytes (nameLen bytes, null-terminated)
//
// Usage:
//   var d: int64 := DirList("/tmp");
//   var n: int64 := DirEntryCount(d);
//   var t: int64 := DirEntryType(d, "foo.txt", 7);
//   DirFree(d);

con DIR_BUF_CAPACITY: int64 := 524288;   // 512 KB — max total result buffer
con DIR_RAW_BUF_SIZE: int64 := 32768;    // 32 KB — getdents64 read chunk

pub fn DirList(path: pchar): int64 {
  var dirfd: int64 := open(path, O_RDONLY | O_DIRECTORY, 0);
  if (dirfd < 0) {
    return 0;
  }

  var rawBuf: int64 := alloc(DIR_RAW_BUF_SIZE);
  var resBuf: int64 := alloc(DIR_BUF_CAPACITY);
  var resPos: int64 := 16;  // skip count(8) + totalSize(8)
  var count:  int64 := 0;

  while (true) {
    var nRead: int64 := getdents64(dirfd, rawBuf, DIR_RAW_BUF_SIZE);
    if (nRead <= 0) {
      break;
    }

    var pos: int64 := 0;
    while (pos < nRead) {
      var entryLen: int64 := peek16(rawBuf + pos + 16);
      if (entryLen <= 0) {
        break;
      }

      var namePtr:   int64 := rawBuf + pos + 19;
      var firstChar: int64 := peek8(namePtr);

      // Skip . and ..
      if (firstChar != 46) {
        var dType:   int64 := peek8(rawBuf + pos + 18);
        var nameLen: int64 := 0;
        while (peek8(namePtr + nameLen) != 0) {
          nameLen += 1;
        }

        // Guard against buffer overflow
        if (resPos + 8 + 1 + nameLen + 1 < DIR_BUF_CAPACITY) {
          poke64(resBuf + resPos, nameLen);
          resPos += 8;
          poke8(resBuf + resPos, dType);
          resPos += 1;
          var i: int64 := 0;
          while (i < nameLen) {
            poke8(resBuf + resPos + i, peek8(namePtr + i));
            i += 1;
          }
          poke8(resBuf + resPos + nameLen, 0);
          resPos := resPos + nameLen + 1;
          count += 1;
        }
      }

      pos += entryLen;
    }
  }

  close(dirfd);
  free(rawBuf, DIR_RAW_BUF_SIZE);

  poke64(resBuf,     count);
  poke64(resBuf + 8, DIR_BUF_CAPACITY);
  return resBuf;
}

// Returns the number of entries in a DirList result (excludes . and ..)
pub fn DirEntryCount(dirlist: int64): int64 {
  if (dirlist == 0) {
    return 0;
  }
  return peek64(dirlist);
}

// Returns the DT_* type of the named entry, or DT_UNKNOWN if not found.
// nameLen must match the exact byte length of name (without null terminator).
pub fn DirEntryType(dirlist: int64, name: pchar, nameLen: int64): int64 {
  if (dirlist == 0) {
    return DT_UNKNOWN;
  }
  var count:  int64 := peek64(dirlist);
  var pos:    int64 := 16;
  var found:  int64 := 0;
  var eLen:   int64 := 0;
  var eType:  int64 := 0;
  var mismatch: int64 := 0;
  var i:      int64 := 0;
  while (found < count) {
    eLen  := peek64(dirlist + pos);
    pos   := pos + 8;
    eType := peek8(dirlist + pos);
    pos   := pos + 1;
    if (eLen == nameLen) {
      mismatch := 0;
      i := 0;
      while (i < nameLen) {
        if (peek8(dirlist + pos + i) != peek8(name + i)) {
          mismatch := 1;
          break;
        }
        i += 1;
      }
      if (mismatch == 0) {
        return eType;
      }
    }
    pos   := pos + eLen + 1;
    found += 1;
  }
  return DT_UNKNOWN;
}

// Returns the name of the idx-th entry (0-based) as a pointer into the DirList
// buffer. Returns null (0) if idx is out of range. The pointer stays valid
// until DirFree is called.
pub fn DirEntryName(dirlist: int64, idx: int64): pchar {
  if (dirlist == 0) { return 0 as pchar; }
  var count: int64 := peek64(dirlist);
  if (idx < 0 || idx >= count) { return 0 as pchar; }
  var pos: int64 := 16;
  var i: int64 := 0;
  while (i < idx) {
    var eLen: int64 := peek64(dirlist + pos);
    pos := pos + 8 + 1 + eLen + 1;  // nameLen + type + name + NUL
    i += 1;
  }
  return (dirlist + pos + 8 + 1) as pchar;  // skip nameLen(8) + type(1)
}

// Returns the DT_* type of the idx-th entry (0-based), or DT_UNKNOWN if out of range.
pub fn DirEntryTypeAt(dirlist: int64, idx: int64): int64 {
  if (dirlist == 0) { return DT_UNKNOWN; }
  var count: int64 := peek64(dirlist);
  if (idx < 0 || idx >= count) { return DT_UNKNOWN; }
  var pos: int64 := 16;
  var i: int64 := 0;
  while (i < idx) {
    var eLen: int64 := peek64(dirlist + pos);
    pos := pos + 8 + 1 + eLen + 1;
    i += 1;
  }
  return peek8(dirlist + pos + 8);  // type byte follows nameLen(8)
}

// Releases the memory allocated by DirList.
pub fn DirFree(dirlist: int64): void {
  if (dirlist != 0) {
    var totalSize: int64 := peek64(dirlist + 8);
    free(dirlist, totalSize);
  }
}

// JoinHoch / Resolve: kombiniert Basis-Pfad mit relativem Pfad
// resolve("/home/user/", "../other/file.txt") -> "/home/other/file.txt"
// resolve(".", "../foo.txt") -> basierend auf current dir (nicht implementiert - gibt nur normalize zurück)
pub fn PathResolve(dest: pchar, base: pchar, relative: pchar): pchar {
  // Prüfe ob relative Pfad absolut ist
  var rel_len: int64 := StrLen(relative);
  if (rel_len > 0 && StrCharAt(relative, 0) == 47) {
    // Absolute Pfad: nur normalisieren
    return PathNormalize(dest, relative);
  }
  
  // Kombiniere base + "/" + relative
  var combined: pchar := "                                                                                ";
  var base_len: int64 := StrLen(base);
  
  var i: int64 := 0;
  var j: int64 := 0;
  
  // Base kopieren
  while (i < base_len) {
    StrSetChar(combined, j, StrCharAt(base, i));
    i += 1;
    j += 1;
  }
  
  // Slash hinzufügen wenn nötig
  if (j > 0 && StrCharAt(combined, j - 1) != 47) {
    StrSetChar(combined, j, 47);  // '/'
    j += 1;
  }
  
  // Relative Pfad kopieren
  i := 0;
  while (i < rel_len) {
    StrSetChar(combined, j, StrCharAt(relative, i));
    i += 1;
    j += 1;
  }
  StrSetChar(combined, j, 0);
  
  // Normalisieren
  return PathNormalize(dest, combined);
}

// ============================================================================
// WP-FS-04: Pfad-Utilities — PathJoin, IsAbsolutePath
// ============================================================================

// Verbindet zwei Pfad-Segmente mit "/" (wenn nötig).
// Ergebnis wird in dest geschrieben (muss groß genug sein:
// StrLen(a) + StrLen(b) + 2 Bytes).
// Trailing "/" in a und leading "/" in b werden korrekt behandelt.
// Beispiele:
//   PathJoin(d, "/home/user",  "docs")   → "/home/user/docs"
//   PathJoin(d, "/home/user/", "docs")   → "/home/user/docs"
//   PathJoin(d, "",            "docs")   → "docs"
//   PathJoin(d, "/a",          "/b")     → "/a/b"  (b-Slash wird als Segment behandelt)
pub fn PathJoin(dest: pchar, a: pchar, b: pchar): pchar {
  var lenA: int64 := StrLen(a);
  var lenB: int64 := StrLen(b);
  var j:    int64 := 0;
  var i:    int64 := 0;

  // Kopiere a
  i := 0;
  while (i < lenA) {
    StrSetChar(dest, j, StrCharAt(a, i));
    i += 1;
    j += 1;
  }

  // Füge Trennzeichen ein wenn nötig
  if (lenA > 0 && lenB > 0) {
    var lastA: int64 := StrCharAt(a, lenA - 1);
    var firstB: int64 := StrCharAt(b, 0);
    if (lastA != 47 && firstB != 47) {  // keiner endet/beginnt mit '/'
      StrSetChar(dest, j, 47);
      j += 1;
    }
  }

  // Kopiere b
  i := 0;
  while (i < lenB) {
    StrSetChar(dest, j, StrCharAt(b, i));
    i += 1;
    j += 1;
  }

  StrSetChar(dest, j, 0);
  return dest;
}

// Gibt true zurück wenn path ein absoluter Pfad ist (beginnt mit '/').
pub fn IsAbsolutePath(path: pchar): bool {
  if (StrLen(path) == 0) {
    return false;
  }
  return StrCharAt(path, 0) == 47;  // '/'
}

// ============================================================================
// WP-FS-05: Stat — Datei-Metadaten
// ============================================================================
// struct stat Layout (x86_64 Linux, 144 Bytes):
//   +0:  st_dev    (8)
//   +8:  st_ino    (8)
//   +16: st_nlink  (8)
//   +24: st_mode   (4)  ← Dateityp + Berechtigungsbits
//   +28: st_uid    (4)
//   +32: st_gid    (4)
//   +36: __pad0    (4)
//   +40: st_rdev   (8)
//   +48: st_size   (8)  ← Dateigröße in Bytes
//   +56: st_blksize(8)
//   +64: st_blocks (8)
//   +72: st_atime  (8)  ← letzter Zugriff (Unix-Timestamp)
//   +80: st_atime_nsec (8)
//   +88: st_mtime  (8)  ← letzte Änderung (Unix-Timestamp)
//   +96: st_mtime_nsec (8)
//   +104: st_ctime (8)  ← letzte Status-Änderung
//   +112: st_ctime_nsec (8)
// #1533: Diese Tabelle liess die _nsec-Felder aus und war ab +80 um eine
// Zelle verschoben — FileModTime las danach st_atime_nsec und lieferte fuer
// jede Datei 0. Nachgemessen an einer Datei mit `touch -d`:
//   +72 = 1577930645 (atime)   +88 = 1577930645 (mtime)
//   +80 = 0 (atime_nsec)       +104 = 1786892058 (ctime)
//
// st_mode Bits für Dateityp (obere 4 Bits von Byte +24):
pub con S_IFMT:  int64 := 61440;  // 0xF000 — Typ-Maske
pub con S_IFREG: int64 := 32768;  // 0x8000 — reguläre Datei
pub con S_IFDIR: int64 := 16384;  // 0x4000 — Verzeichnis
pub con S_IFLNK: int64 := 40960;  // 0xA000 — symbolischer Link
pub con S_IFCHR: int64 := 8192;   // 0x2000 — Zeichen-Gerät
pub con S_IFBLK: int64 := 24576;  // 0x6000 — Block-Gerät
pub con S_IFIFO: int64 := 4096;   // 0x1000 — FIFO
pub con S_IFSOCK: int64 := 49152; // 0xC000 — Socket

con STAT_BUF_SIZE: int64 := 144;

// Füllt statBuf (muss mindestens 144 Bytes groß sein) via stat(2).
// Gibt true zurück bei Erfolg.
pub fn FileStat(path: pchar, statBuf: int64): bool {
  return stat(path, statBuf) == 0;
}

// Gibt die Dateigröße in Bytes zurück (via stat, kein fd nötig). -1 bei Fehler.
pub fn FileSizeFast(path: pchar): int64 {
  var buf: int64 := alloc(STAT_BUF_SIZE);
  if (stat(path, buf) < 0) {
    free(buf, STAT_BUF_SIZE);
    return -1;
  }
  var size: int64 := peek64(buf + 48);
  free(buf, STAT_BUF_SIZE);
  return size;
}

// Gibt den Zeitstempel der letzten Dateiänderung zurück (Unix-Sekunden). 0 bei Fehler.
pub fn FileModTime(path: pchar): int64 {
  var buf: int64 := alloc(STAT_BUF_SIZE);
  if (stat(path, buf) < 0) {
    free(buf, STAT_BUF_SIZE);
    return 0;
  }
  // #1533: Offset 80 ist st_atime_nsec, nicht st_mtime — FileModTime lieferte
  // deshalb fuer JEDE Datei 0 (die Nanosekunden eines mit Sekundenaufloesung
  // gesetzten Zeitstempels sind 0). In lpm lief eine 1-Stunden-TTL nie ab, weil
  // der Spiegel als "nie gesetzt" galt: jeder Aufruf ging erneut ins Netz.
  // st_mtime steht im struct stat von x86_64 Linux bei 88; FileAccessTime mit
  // 72 (st_atime) war immer richtig.
  var mtime: int64 := peek64(buf + 88);
  free(buf, STAT_BUF_SIZE);
  return mtime;
}

// Gibt den Zeitstempel des letzten Zugriffs zurück (Unix-Sekunden). 0 bei Fehler.
pub fn FileAccessTime(path: pchar): int64 {
  var buf: int64 := alloc(STAT_BUF_SIZE);
  if (stat(path, buf) < 0) {
    free(buf, STAT_BUF_SIZE);
    return 0;
  }
  var atime: int64 := peek64(buf + 72);
  free(buf, STAT_BUF_SIZE);
  return atime;
}

// Gibt die Berechtigungsbits zurück (untere 9 Bits von st_mode, z.B. 420 = 0644).
// -1 bei Fehler.
pub fn FilePerm(path: pchar): int64 {
  var buf: int64 := alloc(STAT_BUF_SIZE);
  if (stat(path, buf) < 0) {
    free(buf, STAT_BUF_SIZE);
    return -1;
  }
  var mode: int64 := peek64(buf + 24);  // liest 8 Bytes ab +24 (mode in unteren 32 Bit)
  free(buf, STAT_BUF_SIZE);
  return mode & 511;  // 511 = 0x1FF = alle 9 Berechtigungsbits
}

// Gibt true zurück wenn path ein symbolischer Link ist (via lstat, folgt Symlinks NICHT).
pub fn IsLink(path: pchar): bool {
  var buf: int64 := alloc(STAT_BUF_SIZE);
  if (lstat(path, buf) < 0) {
    free(buf, STAT_BUF_SIZE);
    return false;
  }
  var mode: int64 := peek64(buf + 24);
  free(buf, STAT_BUF_SIZE);
  return (mode & S_IFMT) == S_IFLNK;
}

// ============================================================================
// WP-FS-06: Symlinks — Symlink, ReadLink
// ============================================================================

// Erstellt einen symbolischen Link linkPath → target.
// Gibt false zurück wenn der Link bereits existiert oder der Pfad ungültig ist.
pub fn Symlink(target: pchar, linkPath: pchar): bool {
  return symlink(target, linkPath) == 0;
}

// Liest den Ziel-Pfad eines symbolischen Links in buf (max bufLen Bytes).
// Gibt die Anzahl geschriebener Bytes zurück, -1 bei Fehler.
// Hinweis: readlink setzt KEIN Null-Byte — Aufrufer muss buf[result] := 0 setzen.
pub fn ReadLink(path: pchar, buf: pchar, bufLen: int64): int64 {
  return readlink(path, buf, bufLen);
}

// Kombiniert ReadLink und Null-Terminierung in einem Schritt.
// Schreibt den aufgelösten Link-Pfad null-terminiert nach buf.
// Gibt die Länge des Pfades zurück, -1 bei Fehler oder kein Symlink.
pub fn ReadLinkStr(path: pchar, buf: pchar, bufLen: int64): int64 {
  var n: int64 := readlink(path, buf, bufLen - 1);
  if (n < 0) {
    return -1;
  }
  StrSetChar(buf, n, 0);
  return n;
}

// ============================================================================
// WP-FS-07: MkdirAll — Rekursives Verzeichnis erstellen
// ============================================================================

// Erstellt path und alle fehlenden Elternverzeichnisse (wie mkdir -p).
// Gibt true zurück wenn path am Ende existiert (auch wenn es schon existierte).
// Iterativer Algorithmus: Pfad-Komponenten werden mit temporärem NUL-Byte
// einzeln geprüft und bei Bedarf angelegt.
pub fn MkdirAll(path: pchar, mode: int64): bool {
  var len: int64 := StrLen(path);
  if (len == 0) {
    return false;
  }

  // Schon vorhanden?
  if (IsDirectory(path)) {
    return true;
  }

  var i: int64 := 0;

  // Überspringe führenden Slash bei absoluten Pfaden
  if (StrCharAt(path, 0) == 47) {
    i := 1;
  }

  while (i <= len) {
    if (i == len || StrCharAt(path, i) == 47) {
      // Temporär null-terminieren um Teilpfad zu prüfen/anlegen
      var saved: int64 := StrCharAt(path, i);
      StrSetChar(path, i, 0);

      if (!IsDirectory(path)) {
        if (!Mkdir(path, mode)) {
          // Race-condition: parallel angelegt? Nochmal prüfen
          if (!IsDirectory(path)) {
            StrSetChar(path, i, saved);
            return false;
          }
        }
      }

      StrSetChar(path, i, saved);
    }
    i += 1;
  }

  return IsDirectory(path);
}

// ============================================================================
// WP-FS-08: DirWalk — Rekursive Verzeichnis-Traversal
// ============================================================================
//
// Ergebnis-Buffer-Layout:
//   [0..7]   count     int64 — Anzahl Einträge gesamt
//   [8..15]  totalSize int64 — Puffergröße für DirWalkFree
//   [16..23] writePos  int64 — aktueller Schreib-Cursor (intern)
//   [24..]   Einträge  — je: pathLen(8) + type(1) + fullPath(pathLen) + NUL
//
// Symlinks auf Verzeichnisse werden NICHT verfolgt (verhindert Loops).
// Maximale Tiefe: 32 Ebenen. Puffer: 4 MB.

con DIRWALK_BUF_SIZE:  int64 := 4194304;  // 4 MB
con DIRWALK_MAX_DEPTH: int64 := 32;
con DIRWALK_HDR_SIZE:  int64 := 24;

// Privat: einen Eintrag in den Ergebnis-Buffer schreiben
fn dw_addEntry(resBuf: int64, fullPath: pchar, pathLen: int64, eType: int64): void {
  var wpos: int64 := peek64(resBuf + 16);
  var needed: int64 := 8 + 1 + pathLen + 1;
  if (wpos + needed >= DIRWALK_BUF_SIZE) {
    return;
  }
  poke64(resBuf + wpos, pathLen);
  wpos += 8;
  poke8(resBuf + wpos, eType);
  wpos += 1;
  var i: int64 := 0;
  while (i < pathLen) {
    poke8(resBuf + wpos + i, StrCharAt(fullPath, i));
    i += 1;
  }
  poke8(resBuf + wpos + pathLen, 0);
  wpos := wpos + pathLen + 1;
  poke64(resBuf + 16, wpos);
  poke64(resBuf, peek64(resBuf) + 1);
}

// Privat: rekursiver Traversal-Kern
fn dw_recurse(root: pchar, resBuf: int64, depth: int64): void {
  if (depth > DIRWALK_MAX_DEPTH) {
    return;
  }
  var d: int64 := DirList(root);
  if (d == 0) {
    return;
  }
  var count: int64 := peek64(d);
  var pos: int64 := 16;
  var pathBuf: pchar := StrNew(4096);
  var idx: int64 := 0;
  while (idx < count) {
    var nameLen: int64 := peek64(d + pos);
    pos += 8;
    var eType: int64 := peek8(d + pos);
    pos += 1;
    var namePtr: pchar := (d + pos) as pchar;
    PathJoin(pathBuf, root, namePtr);
    var fullLen: int64 := StrLen(pathBuf);
    dw_addEntry(resBuf, pathBuf, fullLen, eType);
    if (eType == DT_DIR) {
      dw_recurse(pathBuf, resBuf, depth + 1);
    }
    pos := pos + nameLen + 1;
    idx += 1;
  }
  DirFree(d);
  free(pathBuf as int64, 4096);
}

// Privat: lineares Suchen des i-ten Eintrags; gibt Zeiger auf Entry zurück (0 = nicht gefunden)
fn dw_findEntry(result: int64, index: int64): int64 {
  if (result == 0) {
    return 0;
  }
  var count: int64 := peek64(result);
  if (index < 0 || index >= count) {
    return 0;
  }
  var pos: int64 := DIRWALK_HDR_SIZE;
  var i: int64 := 0;
  while (i < index) {
    var nameLen: int64 := peek64(result + pos);
    pos := pos + 8 + 1 + nameLen + 1;
    i += 1;
  }
  return result + pos;
}

// Durchläuft root rekursiv. Gibt opakes Handle zurück (0 = Fehler).
// Symlinks auf Verzeichnisse werden nicht verfolgt.
pub fn DirWalk(root: pchar): int64 {
  if (!IsDirectory(root)) {
    return 0;
  }
  var buf: int64 := alloc(DIRWALK_BUF_SIZE);
  poke64(buf,      0);                 // count
  poke64(buf + 8,  DIRWALK_BUF_SIZE); // totalSize
  poke64(buf + 16, DIRWALK_HDR_SIZE); // writePos
  dw_recurse(root, buf, 0);
  return buf;
}

// Gibt die Anzahl der gefundenen Einträge zurück.
pub fn DirWalkCount(result: int64): int64 {
  if (result == 0) {
    return 0;
  }
  return peek64(result);
}

// Schreibt den vollständigen Pfad des index-ten Eintrags null-terminiert nach outBuf.
// Gibt die Pfad-Länge zurück, -1 bei ungültigem Index.
pub fn DirWalkPath(result: int64, index: int64, outBuf: pchar): int64 {
  var entry: int64 := dw_findEntry(result, index);
  if (entry == 0) {
    return -1;
  }
  var pathLen: int64 := peek64(entry);
  var namePtr: int64 := entry + 9;
  var i: int64 := 0;
  while (i < pathLen) {
    StrSetChar(outBuf, i, peek8(namePtr + i));
    i += 1;
  }
  StrSetChar(outBuf, pathLen, 0);
  return pathLen;
}

// Gibt den DT_*-Typ des index-ten Eintrags zurück.
pub fn DirWalkType(result: int64, index: int64): int64 {
  var entry: int64 := dw_findEntry(result, index);
  if (entry == 0) {
    return DT_UNKNOWN;
  }
  return peek8(entry + 8);
}

// Gibt den von DirWalk allokierten Buffer frei.
pub fn DirWalkFree(result: int64): void {
  if (result != 0) {
    free(result, DIRWALK_BUF_SIZE);
  }
}

// ============================================================================
// FEAT-02: MkDirAll, Readlink, MkTemp
// ============================================================================

// #1191: Hier stand `extern fn time(...) link "libc.so.6";`. Die Bindung wurde
// nur an zwei Stellen in MkTemp gebraucht — sie machte aber JEDES Programm,
// das std.fs importiert, dynamisch gelinkt. Fuer eine Zeitmarke im Dateinamen
// ist das ein hoher Preis: der Rest der Unit kommt mit Syscalls aus, und
// clock_gettime ist ein Builtin.
fn fs_now_unix(): int64 {
  var ts: int64 := alloc(16);
  var rc: int64 := clock_gettime(0, ts);   // CLOCK_REALTIME
  if (rc < 0) { free(ts, 16); return 0; }
  var sec: int64 := peek64(ts);
  free(ts, 16);
  return sec;
}

// Erstellt path und alle fehlenden Elterndirectories (wie mkdir -p).
// Ignoriert EEXIST. Gibt false zurück bei anderen Fehlern.
pub fn MkDirAll(path: pchar): bool {
  var len: int64 := StrLen(path);
  if (len == 0) { return false; }
  var buf: int64 := alloc(len + 1);
  var i: int64 := 0;
  // Skip leading '/'
  if (StrCharAt(path, 0) == 47) { poke8(buf, 47); i := 1; }
  while (i <= len) {
    var c: int64 := 0;
    if (i < len) { c := StrCharAt(path, i); }
    if (c == 47 || i == len) {  // '/' or end
      poke8(buf + i, 0);
      if (i > 0) {
        var r: int64 := mkdir(buf as pchar, 493);  // 0755
        if (r != 0) {
          // errno check: if EEXIST (17) continue, else fail
          // We use a heuristic: if IsDirectory succeeds, it's OK
          if (!IsDirectory(buf as pchar)) {
            free(buf, len + 1);
            return false;
          }
        }
      }
    }
    if (i < len) { poke8(buf + i, StrCharAt(path, i)); }
    i += 1;
  }
  free(buf, len + 1);
  return true;
}

// Liest das Ziel eines symbolischen Links.
// Gibt die Länge des Zielpfads zurück, oder -1 bei Fehler.
pub fn Readlink(path: pchar, buf: pchar, bufLen: int64): int64 {
  return readlink(path, buf, bufLen);
}

// Erstellt eine temporäre Datei unter /tmp/lyx_XXXXXXXX und gibt den fd zurück.
// path muss mindestens 32 Bytes groß sein; wird mit dem tatsächlichen Pfad befüllt.
pub fn MkTemp(pathBuf: int64): int64 {
  var ts: int64 := fs_now_unix();
  // Schreibe /tmp/lyx_ + 10 Ziffern des Timestamps als ASCII
  poke8(pathBuf,      47);  // '/'
  poke8(pathBuf + 1,  116); // 't'
  poke8(pathBuf + 2,  109); // 'm'
  poke8(pathBuf + 3,  112); // 'p'
  poke8(pathBuf + 4,  47);  // '/'
  poke8(pathBuf + 5,  108); // 'l'
  poke8(pathBuf + 6,  121); // 'y'
  poke8(pathBuf + 7,  120); // 'x'
  poke8(pathBuf + 8,  95);  // '_'
  var val: int64 := ts;
  var i: int64 := 18;
  poke8(pathBuf + 19, 0);
  while (i >= 9) {
    poke8(pathBuf + i, 48 + (val % 10));
    val := val / 10;
    i -= 1;
  }
  var fd: int64 := open(pathBuf as pchar, O_WRONLY | O_CREAT | O_EXCL, 384);  // 0600
  return fd;
}

// Creates a unique temporary file under /tmp and returns its path.
// The returned pchar is heap-allocated (32 bytes); caller must free(ptr, 32).
// The file remains on disk until explicitly removed with FileRemove/unlink.
pub fn TmpFile(): pchar {
  var buf: int64 := alloc(32);
  var ts:  int64 := fs_now_unix();
  var pid: int64 := getpid();
  // Template: /tmp/lyx_<pid8hex>_<ts8hex>
  poke8(buf,  47); poke8(buf+1,116); poke8(buf+2,109); poke8(buf+3,112);
  poke8(buf+4, 47); poke8(buf+5,108); poke8(buf+6,121); poke8(buf+7,120);
  poke8(buf+8, 95);  // '_'
  var hex: pchar := "0123456789abcdef";
  var i: int64 := 0;
  while (i < 8) {
    poke8(buf + 9  + i, peek8(hex as int64 + ((pid >> (28 - i * 4)) & 0xF)));
    poke8(buf + 17 + i, peek8(hex as int64 + ((ts  >> (28 - i * 4)) & 0xF)));
    i += 1;
  }
  poke8(buf + 25, 0);
  // Retry with a counter suffix if the file already exists
  var attempt: int64 := 0;
  var f: int64 := open(buf as pchar, O_WRONLY | O_CREAT | O_EXCL, 384);  // 0600
  while (f < 0 && attempt < 256) {
    attempt += 1;
    poke8(buf + 25, 95);  // '_'
    poke8(buf + 26, peek8(hex as int64 + ((attempt >> 4) & 0xF)));
    poke8(buf + 27, peek8(hex as int64 + (attempt & 0xF)));
    poke8(buf + 28, 0);
    f := open(buf as pchar, O_WRONLY | O_CREAT | O_EXCL, 384);
  }
  if (f >= 0) { close(f); }
  return buf as pchar;
}

// ============================================================================
// FEAT-02: FileGlob — Wildcard-Dateisuche
// Unterstützt: * (beliebige Zeichen außer /), ? (ein Zeichen außer /)
// Kein ** (rekursiv) in dieser Version.
//
// Ergebnis-Buffer-Format:
//   [count:int64][totalSize:int64]{[pathLen:int64][path+\0]}*
// Zugriff via GlobCount / GlobGet / GlobFree.
// ============================================================================

con GLOB_BUF_INIT: int64 := 65536;   // 64 KB Startgröße
con GLOB_HDR:      int64 := 16;      // count(8) + totalSize(8)

// Prüft ob name mit dem Wildcard-Pattern übereinstimmt.
// * = beliebig viele Zeichen (nicht /), ? = genau ein Zeichen (nicht /)
pub fn GlobMatch(pattern: pchar, name: pchar): bool {
  var plen: int64 := StrLen(pattern);
  var nlen: int64 := StrLen(name);
  var pi: int64 := 0;
  var ni: int64 := 0;
  var starPi: int64 := -1;   // letzter * in pattern
  var starNi: int64 := -1;   // Position in name beim letzten *

  while (ni < nlen) {
    var pc: int64 := -1;
    if (pi < plen) { pc := StrCharAt(pattern, pi); }

    if (pc == 42) {  // '*'
      starPi := pi;
      starNi := ni;
      pi += 1;
    } else if (pc == 63 && StrCharAt(name, ni) != 47) {  // '?', nicht '/'
      pi += 1;
      ni += 1;
    } else if (pc >= 0 && pc == StrCharAt(name, ni)) {
      pi += 1;
      ni += 1;
    } else if (starPi >= 0) {
      // Backtrack: * konsumiert ein weiteres Zeichen
      if (StrCharAt(name, starNi) == 47) { return false; }  // * überspringt kein /
      starNi += 1;
      pi := starPi + 1;
      ni := starNi;
    } else {
      return false;
    }
  }

  // Verbleibende Pattern-Zeichen müssen alle * sein
  while (pi < plen && StrCharAt(pattern, pi) == 42) {
    pi += 1;
  }
  return pi == plen;
}

// Gibt einen GlobMatch-Ergebnis-Buffer zurück.
// pattern darf einen führenden Pfad enthalten: "src/*.lyx", "/tmp/test_*"
// Bei reinem Dateinamen-Pattern (kein /) wird "." als Verzeichnis genutzt.
pub fn FileGlob(pattern: pchar): int64 {
  var plen: int64 := StrLen(pattern);

  // Trenne Verzeichnis- und Dateiname-Teil
  var lastSlash: int64 := -1;
  var i: int64 := 0;
  while (i < plen) {
    if (StrCharAt(pattern, i) == 47) { lastSlash := i; }
    i += 1;
  }

  var dirBuf: int64 := alloc(plen + 2);
  var filePat: pchar := pattern;

  if (lastSlash < 0) {
    // Kein Slash: Verzeichnis = "."
    poke8(dirBuf, 46); poke8(dirBuf + 1, 0);  // "."
  } else {
    // Verzeichnis = alles bis letztem Slash
    var di: int64 := 0;
    while (di < lastSlash) {
      poke8(dirBuf + di, StrCharAt(pattern, di));
      di += 1;
    }
    poke8(dirBuf + di, 0);
    // Dateiname-Pattern = alles nach letztem Slash
    filePat := (pattern as int64 + lastSlash + 1) as pchar;
  }

  // Verzeichnis auflisten
  var dl: int64 := DirList(dirBuf as pchar);
  if (dl == 0) {
    free(dirBuf, plen + 2);
    return 0;
  }

  // Ergebnis-Buffer aufbauen
  var resBuf: int64 := alloc(GLOB_BUF_INIT);
  var resPos: int64 := GLOB_HDR;
  var count:  int64 := 0;
  var dirLen: int64 := StrLen(dirBuf as pchar);

  var entryCount: int64 := DirEntryCount(dl);
  // Iteriere Einträge direkt aus DirList-Buffer
  var dlPos: int64 := 16;  // skip count(8)+totalSize(8)
  var ei: int64 := 0;
  while (ei < entryCount) {
    var eLen:  int64 := peek64(dl + dlPos);         dlPos := dlPos + 8;
    var eType: int64 := peek8(dl + dlPos);           dlPos := dlPos + 1;
    var namePtr: pchar := (dl + dlPos) as pchar;

    // Nur reguläre Dateien und Symlinks berücksichtigen (DT_REG=8, DT_LNK=10, DT_UNKNOWN=0)
    if (eType == DT_REG || eType == 10 || eType == DT_UNKNOWN) {
      if (GlobMatch(filePat, namePtr)) {
        // Vollständiger Pfad: dir + "/" + name
        var fullLen: int64 := dirLen + 1 + eLen;
        if (resPos + 8 + fullLen + 1 < GLOB_BUF_INIT) {
          poke64(resBuf + resPos, fullLen);
          resPos += 8;
          var ci: int64 := 0;
          while (ci < dirLen) {
            poke8(resBuf + resPos + ci, StrCharAt(dirBuf as pchar, ci));
            ci += 1;
          }
          poke8(resBuf + resPos + dirLen, 47);  // '/'
          ci := 0;
          while (ci < eLen) {
            poke8(resBuf + resPos + dirLen + 1 + ci, peek8(dl + dlPos + ci));
            ci += 1;
          }
          poke8(resBuf + resPos + fullLen, 0);
          resPos := resPos + fullLen + 1;
          count += 1;
        }
      }
    }

    dlPos := dlPos + eLen + 1;
    ei += 1;
  }

  DirFree(dl);
  free(dirBuf, plen + 2);

  poke64(resBuf,     count);
  poke64(resBuf + 8, GLOB_BUF_INIT);
  return resBuf;
}

pub fn GlobCount(result: int64): int64 {
  if (result == 0) { return 0; }
  return peek64(result);
}

// Kopiert den index-ten Pfad nach outBuf. Gibt Pfadlänge zurück, -1 bei Fehler.
// outBuf muss mindestens 4097 Bytes groß sein.
pub fn GlobGet(result: int64, index: int64, outBuf: pchar): int64 {
  if (result == 0 || index < 0 || index >= peek64(result)) { return -1; }
  var pos: int64 := GLOB_HDR;
  var i: int64 := 0;
  while (i < index) {
    var elen: int64 := peek64(result + pos);
    pos := pos + 8 + elen + 1;
    i += 1;
  }
  var plen: int64 := peek64(result + pos);
  pos += 8;
  var j: int64 := 0;
  while (j < plen) {
    StrSetChar(outBuf, j, peek8(result + pos + j));
    j += 1;
  }
  StrSetChar(outBuf, plen, 0);
  return plen;
}

pub fn GlobFree(result: int64): void {
  if (result == 0) { return; }
  free(result, GLOB_BUF_INIT);
}
