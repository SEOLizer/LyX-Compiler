// #1476: Beide Funktionen teilten das Skalarprodukt durch 1000000, als waere
// es ein Festkommawert — bei ganzzahligen Vektoren ist `dot` aber klein, und
// die Division ergab fast immer 0. Vec2Project lieferte damit den Nullvektor,
// Vec2Reflect gab den Eingabevektor unveraendert zurueck.
//
// Bei Vec2Project fehlte ausserdem der NENNER: len_sq wurde berechnet, gegen 0
// geprueft und dann nicht verwendet. Die Formel lautet (v·onto / |onto|²)·onto.
//
// Geteilt wird jetzt erst nach der Multiplikation — `(dot * onto.x) / len_sq`
// statt `(dot / len_sq) * onto.x`. Andernfalls faellt der Quotient bei
// ganzzahligen Vektoren wieder auf 0, und der Fehler waere nur verschoben.
pub fn Vec2Project(v: Vec2, onto: Vec2): Vec2 {
  var dot: int64 := Vec2Dot(v, onto);
  var len_sq: int64 := Vec2LengthSquared(onto);
  if (len_sq == 0) { return Vec2Zero(); }
  return Vec2New((dot * onto.x) / len_sq, (dot * onto.y) / len_sq);
}

// r = v - 2·(v·n / |n|²)·n. Fuer eine Einheitsnormale ist |n|² = 1 und der
// Nenner faellt weg; fuer jede andere Normale ist er noetig, und er fehlte.
pub fn Vec2Reflect(v: Vec2, normal: Vec2): Vec2 {
  var len_sq: int64 := Vec2LengthSquared(normal);
  if (len_sq == 0) { return v; }
  var dot2: int64 := Vec2Dot(v, normal) * 2;
  return Vec2New(v.x - (dot2 * normal.x) / len_sq,
                 v.y - (dot2 * normal.y) / len_sq);
}

pub fn Vec2AngleTo(v: Vec2, target: Vec2): int64 {
  var dot: int64 := Vec2Dot(v, target);
  var len_v: int64 := Vec2Length(v);
  var len_t: int64 := Vec2Length(target);
  if (len_v == 0 || len_t == 0) { return 0; }
  var dot_s: int64 := dot * 1000000;
  var len_prod: int64 := len_v * len_t;
  var cos_angle: int64 := dot_s / len_prod;
  return Cos64Inverse(cos_angle);
}

pub fn Vec2Heading(v: Vec2): int64 {
  var len: int64 := Vec2Length(v);
  if (len == 0) { return 0; }
  var vx_s: int64 := v.x * 1000000;
  var vy_s: int64 := v.y * 1000000;
  var nx: int64 := vx_s / len;
  var ny: int64 := vy_s / len;
  return Atan2Microdegrees(ny, nx);
}
