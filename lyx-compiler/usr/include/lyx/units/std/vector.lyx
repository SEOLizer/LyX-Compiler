pub type Vec2 = struct {
  x: int64;
  y: int64;
}

// Integer square root (floor(sqrt(n)))
fn IntSqrt(n: int64): int64 {
  if (n <= 0) { return 0; }
  if (n < 4) { return 1; }
  var x: int64 := n;
  var x1: int64 := x + 1;
  var y: int64 := x1 / 2;
  while (y < x) {
    x := y;
    var ndivx: int64 := n / x;
    var xpnd: int64 := x + ndivx;
    y := xpnd / 2;
  }
  return x;
}

