// std/inotify — WP-10: Dateisystem-Überwachung via inotify
// Wrapper um sys_inotify_init1, sys_inotify_add_watch, sys_inotify_rm_watch

// ============================================================
// Event-Masken (welche Ereignisse überwachen)
// ============================================================
pub con IN_ACCESS:        int64 := 1;       // Datei gelesen
pub con IN_MODIFY:        int64 := 2;       // Datei geändert
pub con IN_ATTRIB:        int64 := 4;       // Metadaten geändert
pub con IN_CLOSE_WRITE:   int64 := 8;       // Schreib-Datei geschlossen
pub con IN_CLOSE_NOWRITE: int64 := 16;      // Lese-Datei geschlossen
pub con IN_OPEN:          int64 := 32;      // Datei geöffnet
pub con IN_MOVED_FROM:    int64 := 64;      // Datei aus Verz. verschoben
pub con IN_MOVED_TO:      int64 := 128;     // Datei in Verz. verschoben
pub con IN_CREATE:        int64 := 256;     // Datei/Verz. erstellt
pub con IN_DELETE:        int64 := 512;     // Datei/Verz. gelöscht
pub con IN_DELETE_SELF:   int64 := 1024;    // Überwachtes Objekt gelöscht
pub con IN_MOVE_SELF:     int64 := 2048;    // Überwachtes Objekt verschoben
pub con IN_ALL_EVENTS:    int64 := 4095;    // 0xFFF — alle obigen Events
pub con IN_UNMOUNT:       int64 := 8192;    // Dateisystem ausgehängt
pub con IN_Q_OVERFLOW:    int64 := 16384;   // Event-Queue übergelaufen
pub con IN_IGNORED:       int64 := 32768;   // Watch automatisch entfernt
pub con IN_ISDIR:         int64 := 1073741824; // Ereignis betrifft Verzeichnis
pub con IN_ONESHOT:       int64 := -2147483648; // Nur ein Event, dann entfernen

// inotify_init1-Flags
pub con IN_NONBLOCK: int64 := 2048;    // 0x800
pub con IN_CLOEXEC:  int64 := 524288;  // 0x80000

// inotify_event-Struktur (x86-64 Linux):
//   +0:  wd      (int32)  — Watch-Deskriptor
//   +4:  mask    (uint32) — Ereignistyp
//   +8:  cookie  (uint32) — IN_MOVED_FROM/TO Korrelation
//   +12: len     (uint32) — Länge von name[] inkl. Padding
//   +16: name[]  (char[]) — Dateiname, null-terminiert + auf 4 Bytes aufgefüllt
pub con INOTIFY_EVENT_HDR_SIZE: int64 := 16;

// ============================================================
// inotify-fd erstellen und verwalten
// ============================================================

// InotifyCreate: erstellt eine neue inotify-Instanz (mit IN_CLOEXEC).
// Gibt den fd zurück, oder < 0 bei Fehler.
pub fn InotifyCreate(): int64 {
  return sys_inotify_init1(IN_CLOEXEC);
}

// InotifyWatch: überwacht path mit den angegebenen Event-Masken.
// Gibt den Watch-Deskriptor (wd > 0) zurück, oder < 0 bei Fehler.
pub fn InotifyWatch(fd: int64, path: pchar, mask: int64): int64 {
  return sys_inotify_add_watch(fd, path, mask);
}

// InotifyUnwatch: entfernt einen Watch-Deskriptor.
pub fn InotifyUnwatch(fd: int64, wd: int64): int64 {
  return sys_inotify_rm_watch(fd, wd);
}

// ============================================================
// Events lesen
// ============================================================

// InotifyRead: liest Events aus dem inotify-fd in buf.
// buf muss mindestens INOTIFY_EVENT_HDR_SIZE + max_name_len Bytes groß sein.
// Gibt Anzahl gelesener Bytes zurück, oder < 0 bei Fehler.
pub fn InotifyRead(fd: int64, buf: int64, bufSize: int64): int64 {
  return sys_read(fd, buf, bufSize);
}

// ============================================================
// inotify_event-Felder lesen (aus Lese-Puffer)
// ============================================================
// Alle Werte werden über peek64 + Bit-Masken extrahiert,
// um int8-Vorzeichenprobleme mit peek8/peek32 zu umgehen.

// InotifyEventWd: liefert den Watch-Deskriptor des Events (int32 an Offset 0).
pub fn InotifyEventWd(buf: int64): int64 {
  return peek64(buf) & 2147483647;
}

// InotifyEventMask: liefert die Ereignismaske (uint32 an Offset 4).
pub fn InotifyEventMask(buf: int64): int64 {
  return (peek64(buf) >> 32) & 4294967295;
}

// InotifyEventCookie: liefert den Bewegungs-Cookie (uint32 an Offset 8).
pub fn InotifyEventCookie(buf: int64): int64 {
  return peek64(buf + 8) & 4294967295;
}

// InotifyEventLen: liefert die Länge des name-Felds inkl. Padding (uint32 an Offset 12).
pub fn InotifyEventLen(buf: int64): int64 {
  return (peek64(buf + 8) >> 32) & 4294967295;
}

// InotifyEventName: gibt den Zeiger auf das name-Feld zurück (Offset 16).
// Der Name ist null-terminiert; nach dem Null folgt evtl. Padding.
pub fn InotifyEventName(buf: int64): int64 {
  return buf + INOTIFY_EVENT_HDR_SIZE;
}

// InotifyEventNext: gibt den Zeiger auf das nächste Event im Puffer zurück.
// Verwendung: while (ptr < buf + bytesRead) { ... ptr := InotifyEventNext(ptr); }
pub fn InotifyEventNext(buf: int64): int64 {
  return buf + INOTIFY_EVENT_HDR_SIZE + InotifyEventLen(buf);
}
