      v2 := (v2 << 31) | ((v2 >> 33) & 0x7FFFFFFF);
      v2 := v2 * XXH_PRIME1;

      var v3a: int64 := v3 + k3 * XXH_PRIME2; v3 := v3a;
      v3 := (v3 << 31) | ((v3 >> 33) & 0x7FFFFFFF);
      v3 := v3 * XXH_PRIME1;

      var v4a: int64 := v4 + k4 * XXH_PRIME2; v4 := v4a;
