    if (lo < 10) { StrSetChar(hex, j * 2 + 1, 48 + lo); } else { StrSetChar(hex, j * 2 + 1, 87 + lo); }
    j += 1;
  }
  StrSetChar(hex, 64, 0);
  free(sptr, 400);
  return hex;
}

