// ============================================================================
// MurmurHash3 32-bit
// ============================================================================

con MURMUR3_C1: int64 := 0xcc9e2d51;
con MURMUR3_C2: int64 := 0x1b873593;

fn MurmurMix(h: int64, k: int64): int64 {
  k := k * MURMUR3_C1;
  k := (k << 15) | ((k >> 17) & 32767);
  h := h ^ k;
  h := (h << 13) | ((h >> 19) & 8191);
  var h5: int64 := h * 5; h := h5 + 0xe6546b64;
  return h;
}

pub fn HashMurmur3_32(data: pchar, seed: int64): int64 {
  var h: int64 := seed;
  var len: int64 := StrLen(data);
  var i: int64 := 0;

  while ((i + 4) <= len) {
    var k: int64 := StrCharAt(data, i);
    k := k | (StrCharAt(data, i + 1) << 8);
    k := k | (StrCharAt(data, i + 2) << 16);
    k := k | (StrCharAt(data, i + 3) << 24);
    h := MurmurMix(h, k);
    i += 4;
  }

  var k: int64 := 0;
  var tail: int64 := len & 3;
  if (tail >= 1) { k := k ^ StrCharAt(data, i); }
  if (tail >= 2) { k := k ^ (StrCharAt(data, i + 1) << 8); }
  if (tail >= 3) { k := k ^ (StrCharAt(data, i + 2) << 16); }

  if (tail > 0) {
    k := k * MURMUR3_C1;
    k := (k << 15) | ((k >> 17) & 32767);
    h := h ^ k;
  }

  h := h ^ len;
  h := h ^ (h >> 16);
  h := h * 0x85ebca6b;
  h := h ^ (h >> 13);
  h := h * 0xc2b2ae35;
  h := h ^ (h >> 16);

  return h & 0xFFFFFFFF;
}

pub fn HashMurmur3_32Default(data: pchar): int64 {
  return HashMurmur3_32(data, 0);
}

