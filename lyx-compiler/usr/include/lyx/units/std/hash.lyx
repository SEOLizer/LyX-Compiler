pub fn HashxxHash64(data: pchar): int64 {
  var len: int64 := StrLen(data);
  var h1: int64 := XXH_PRIME1 + XXH_PRIME2;
  var h2: int64 := XXH_PRIME2;
  var i: int64 := 0;

  while ((i + 8) <= len) {
    var k: int64 := StrCharAt(data, i);
    k := k | (StrCharAt(data, i + 1) << 8);
