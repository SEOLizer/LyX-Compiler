      var k2: int64 := StrCharAt(data, i + 4) | (StrCharAt(data, i + 5) << 8)
                     | (StrCharAt(data, i + 6) << 16) | (StrCharAt(data, i + 7) << 24);
      var k3: int64 := StrCharAt(data, i + 8) | (StrCharAt(data, i + 9) << 8)
