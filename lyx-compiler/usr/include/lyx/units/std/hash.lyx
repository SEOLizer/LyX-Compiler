// ============================================================================
// CityHash32
// ============================================================================

con CITY_C1: int64 := 0xcc9e2d51;
con CITY_C2: int64 := 0x1b873593;

pub fn HashCity32(data: pchar): int64 {
  var len: int64 := StrLen(data);

  if (len <= 3) {
    var result: int64 := len;
    var i: int64 := 0;
    while (i < len) {
      var r5: int64 := result << 5;
      result := r5 - result + StrCharAt(data, i);
      i += 1;
    }
    return result;
  }

  var h1: int64 := len;
  var h2: int64 := 0;
  var i: int64 := 0;

  while ((i + 4) <= len) {
    var k1: int64 := StrCharAt(data, i);
    k1 := k1 | (StrCharAt(data, i + 1) << 8);
    k1 := k1 | (StrCharAt(data, i + 2) << 16);
    k1 := k1 | (StrCharAt(data, i + 3) << 24);

    k1 := k1 * CITY_C1;
    k1 := (k1 << 15) | ((k1 >> 17) & 32767);
    h1 := h1 * CITY_C2;
    h1 := h1 ^ k1;

    h1 := (h1 << 19) | ((h1 >> 13) & 524287);
    h1 += h2;

    i += 4;
  }

  var k2: int64 := 0;
  var tail: int64 := len & 3;

  if (tail >= 1) { k2 := k2 ^ StrCharAt(data, i); }
  if (tail >= 2) { k2 := k2 ^ (StrCharAt(data, i + 1) << 8); }
  if (tail >= 3) { k2 := k2 ^ (StrCharAt(data, i + 2) << 16); }

  var k2c: int64 := k2 * CITY_C1; h2 := h2 ^ k2c;
  h2 := (h2 << 15) | ((h2 >> 17) & 32767);
  h2 := h2 * CITY_C2;

  h1 := h1 ^ (h2 >> 18);
  var h1x5: int64 := h1 * 5; h1 := h1x5;
  h1 := h1 + 0xe6546b64;

  return h1 & 0xFFFFFFFF;
}

// ============================================================================
// CityHash64
// ============================================================================

con CITY_K1: int64 := 0xc6a4a7935bd1e995;
con CITY_K2: int64 := 0x9e3779b97f4a7c15;

pub fn HashCity64(data: pchar): int64 {
  var len: int64 := StrLen(data);

  if (len <= 16) {
    if (len <= 8) {
      var k1: int64 := 0;
      var k2: int64 := 0;
