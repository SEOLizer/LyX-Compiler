con SHA256_CTX_SIZE: int64 := 144;
con SHA256_H_OFF:    int64 := 0;   // 8 × int64 = 64 bytes for h0..h7
con SHA256_LEN_OFF:  int64 := 64;  // total bytes processed
con SHA256_FILL_OFF: int64 := 72;  // partial block fill level
con SHA256_BUF_OFF:  int64 := 80;  // 64-byte block buffer

// SHA-256 K constants (first 64)
