// Compress one 64-byte block into context state
fn sha256_compress(ctx: int64, block: int64): void {
  var w: int64 := alloc(64 * 8);
  var i: int64 := 0;
  // Load first 16 words from block (big-endian 32-bit)
  while (i < 16) {
    var off: int64 := i * 4;
    var b0: int64 := peek8(block + off);
    var b1: int64 := peek8(block + off + 1);
    var b2: int64 := peek8(block + off + 2);
    var b3: int64 := peek8(block + off + 3);
    poke64(w + i * 8, ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & 0xFFFFFFFF);
    i += 1;
  }
  // Expand to 64 words
  while (i < 64) {
    var w2:  int64 := peek64(w + (i-2)  * 8);
    var w7:  int64 := peek64(w + (i-7)  * 8);
    var w15: int64 := peek64(w + (i-15) * 8);
    var w16: int64 := peek64(w + (i-16) * 8);
    var s0: int64 := Gamma0(w15);
    var s1: int64 := Gamma1(w2);
    poke64(w + i * 8, (w16 + s0 + w7 + s1) & 0xFFFFFFFF);
    i += 1;
  }
  // Initialize working variables from state
  var a: int64 := peek64(ctx + SHA256_H_OFF);
  var b: int64 := peek64(ctx + SHA256_H_OFF + 8);
  var c: int64 := peek64(ctx + SHA256_H_OFF + 16);
  var d: int64 := peek64(ctx + SHA256_H_OFF + 24);
  var e: int64 := peek64(ctx + SHA256_H_OFF + 32);
  var f: int64 := peek64(ctx + SHA256_H_OFF + 40);
  var g: int64 := peek64(ctx + SHA256_H_OFF + 48);
  var h: int64 := peek64(ctx + SHA256_H_OFF + 56);
  // 64 rounds
  i := 0;
  while (i < 64) {
    var s1: int64 := Sigma1(e);
    var ch: int64 := Ch(e, f, g);
    var t1: int64 := (h + s1 + ch + sha256_k(i) + peek64(w + i * 8)) & 0xFFFFFFFF;
    var s0: int64 := Sigma0(a);
    var mj: int64 := Maj(a, b, c);
    var t2: int64 := (s0 + mj) & 0xFFFFFFFF;
    h := g; g := f; f := e;
    e := (d + t1) & 0xFFFFFFFF;
    d := c; c := b; b := a;
    a := (t1 + t2) & 0xFFFFFFFF;
    i += 1;
  }
  // Update state
  poke64(ctx + SHA256_H_OFF,      (peek64(ctx + SHA256_H_OFF)      + a) & 0xFFFFFFFF);
  poke64(ctx + SHA256_H_OFF + 8,  (peek64(ctx + SHA256_H_OFF + 8)  + b) & 0xFFFFFFFF);
  poke64(ctx + SHA256_H_OFF + 16, (peek64(ctx + SHA256_H_OFF + 16) + c) & 0xFFFFFFFF);
  poke64(ctx + SHA256_H_OFF + 24, (peek64(ctx + SHA256_H_OFF + 24) + d) & 0xFFFFFFFF);
  poke64(ctx + SHA256_H_OFF + 32, (peek64(ctx + SHA256_H_OFF + 32) + e) & 0xFFFFFFFF);
  poke64(ctx + SHA256_H_OFF + 40, (peek64(ctx + SHA256_H_OFF + 40) + f) & 0xFFFFFFFF);
  poke64(ctx + SHA256_H_OFF + 48, (peek64(ctx + SHA256_H_OFF + 48) + g) & 0xFFFFFFFF);
  poke64(ctx + SHA256_H_OFF + 56, (peek64(ctx + SHA256_H_OFF + 56) + h) & 0xFFFFFFFF);
  free(w, 64 * 8);
}

pub fn SHA256Init(ctx: int64): void {
  poke64(ctx + SHA256_H_OFF,       0x6a09e667);
  poke64(ctx + SHA256_H_OFF + 8,   0xbb67ae85);
  poke64(ctx + SHA256_H_OFF + 16,  0x3c6ef372);
  poke64(ctx + SHA256_H_OFF + 24,  0xa54ff53a);
  poke64(ctx + SHA256_H_OFF + 32,  0x510e527f);
  poke64(ctx + SHA256_H_OFF + 40,  0x9b05688c);
  poke64(ctx + SHA256_H_OFF + 48,  0x1f83d9ab);
  poke64(ctx + SHA256_H_OFF + 56,  0x5be0cd19);
  poke64(ctx + SHA256_LEN_OFF, 0);
  poke64(ctx + SHA256_FILL_OFF, 0);
}

pub fn SHA256Update(ctx: int64, data: int64, len: int64): void {
  var i: int64 := 0;
  var fill: int64 := peek64(ctx + SHA256_FILL_OFF);
  while (i < len) {
    poke8(ctx + SHA256_BUF_OFF + fill, peek8(data + i));
    fill += 1;
    if (fill == 64) {
      sha256_compress(ctx, ctx + SHA256_BUF_OFF);
      poke64(ctx + SHA256_LEN_OFF, peek64(ctx + SHA256_LEN_OFF) + 64);
      fill := 0;
    }
    i += 1;
  }
  poke64(ctx + SHA256_FILL_OFF, fill);
}

// Finalizes and writes 32-byte digest to outBuf (caller must allocate ≥32 bytes)
pub fn SHA256Final(ctx: int64, outBuf: int64): void {
  var fill: int64 := peek64(ctx + SHA256_FILL_OFF);
  var totalLen: int64 := peek64(ctx + SHA256_LEN_OFF) + fill;
  // Append 0x80
  poke8(ctx + SHA256_BUF_OFF + fill, 0x80);
  fill += 1;
  if (fill > 56) {
    while (fill < 64) { poke8(ctx + SHA256_BUF_OFF + fill, 0); fill := fill + 1; }
    sha256_compress(ctx, ctx + SHA256_BUF_OFF);
    fill := 0;
  }
  while (fill < 56) { poke8(ctx + SHA256_BUF_OFF + fill, 0); fill := fill + 1; }
  // Append length in bits as big-endian 64-bit
  var bitLen: int64 := totalLen * 8;
  var j: int64 := 7;
  while (j >= 0) {
    poke8(ctx + SHA256_BUF_OFF + 56 + (7 - j), (bitLen >> (j * 8)) & 0xFF);
    j -= 1;
  }
  sha256_compress(ctx, ctx + SHA256_BUF_OFF);
  // Write digest (big-endian 32-bit words)
  var hi: int64 := 0;
  while (hi < 8) {
    var word: int64 := peek64(ctx + SHA256_H_OFF + hi * 8);
    poke8(outBuf + hi * 4,     (word >> 24) & 0xFF);
    poke8(outBuf + hi * 4 + 1, (word >> 16) & 0xFF);
    poke8(outBuf + hi * 4 + 2, (word >>  8) & 0xFF);
    poke8(outBuf + hi * 4 + 3,  word        & 0xFF);
    hi += 1;
  }
}

// Convenience: hash a pchar, return alloc'd 32-byte digest
pub fn SHA256Hash(data: pchar): int64 {
  var ctx: int64 := alloc(SHA256_CTX_SIZE);
  SHA256Init(ctx);
  SHA256Update(ctx, data as int64, StrLen(data));
  var out: int64 := alloc(32);
  SHA256Final(ctx, out);
  free(ctx, SHA256_CTX_SIZE);
  return out;
}

// WP-PQC-02: hash arbitrary bytes into caller-allocated 32-byte digest
pub fn HashSHA256Bytes(data: int64, len: int64, out: int64): void {
  var ctx: int64 := alloc(SHA256_CTX_SIZE);
  SHA256Init(ctx);
  SHA256Update(ctx, data, len);
  SHA256Final(ctx, out);
  free(ctx, SHA256_CTX_SIZE);
}

// ============================================================================
// FEAT-07: HMAC-SHA256
// HMAC(key, msg) = SHA256((key XOR opad) || SHA256((key XOR ipad) || msg))
// ============================================================================

pub fn HMACSHA256(key: int64, keyLen: int64, msg: int64, msgLen: int64): int64 {
  var kblock: int64 := alloc(64);
  var i: int64 := 0;
  while (i < 64) { poke8(kblock + i, 0); i := i + 1; }
  if (keyLen > 64) {
    var kctx: int64 := alloc(SHA256_CTX_SIZE);
    SHA256Init(kctx);
    SHA256Update(kctx, key, keyLen);
    SHA256Final(kctx, kblock);
    free(kctx, SHA256_CTX_SIZE);
  } else {
    i := 0;
    while (i < keyLen) { poke8(kblock + i, peek8(key + i)); i := i + 1; }
  }
  // Inner hash: SHA256((key XOR ipad) || msg)
  var ipad: int64 := alloc(64);
  i := 0; while (i < 64) { poke8(ipad + i, peek8(kblock + i) ^ 0x36); i := i + 1; }
  var ictx: int64 := alloc(SHA256_CTX_SIZE);
  SHA256Init(ictx);
  SHA256Update(ictx, ipad, 64);
  SHA256Update(ictx, msg, msgLen);
  var innerHash: int64 := alloc(32);
  SHA256Final(ictx, innerHash);
  free(ictx, SHA256_CTX_SIZE);
  free(ipad, 64);
  // Outer hash: SHA256((key XOR opad) || innerHash)
  var opad: int64 := alloc(64);
  i := 0; while (i < 64) { poke8(opad + i, peek8(kblock + i) ^ 0x5C); i := i + 1; }
  var octx: int64 := alloc(SHA256_CTX_SIZE);
  SHA256Init(octx);
  SHA256Update(octx, opad, 64);
  SHA256Update(octx, innerHash, 32);
  var out: int64 := alloc(32);
  SHA256Final(octx, out);
  free(octx, SHA256_CTX_SIZE);
  free(opad, 64);
  free(innerHash, 32);
  free(kblock, 64);
  return out;
}

// ============================================================================
// FEAT-07: HashMap (open-addressing, pchar keys, int64 values)
// Header: [cap:int64][count:int64][bucketsPtr:int64]
// Bucket: [keyPtr:int64][keyLen:int64][value:int64][state:int64] (32 bytes)
//   state: 0=empty, 1=occupied, 2=deleted
// ============================================================================

con HM_HDR_CAP:     int64 := 0;
con HM_HDR_CNT:     int64 := 8;
con HM_HDR_PTR:     int64 := 16;
con HM_HDR_SIZE:    int64 := 24;
con HM_BUCKET_SIZE: int64 := 32;
con HM_BKT_KEY:     int64 := 0;
con HM_BKT_KLEN:    int64 := 8;
con HM_BKT_VAL:     int64 := 16;
con HM_BKT_STATE:   int64 := 24;
con HM_EMPTY:       int64 := 0;
con HM_OCCUPIED:    int64 := 1;
con HM_DELETED:     int64 := 2;

fn _hmHash(key: pchar, keyLen: int64, cap: int64): int64 {
  var h: int64 := HashFNV1a64(key);
  var idx: int64 := h % cap;
  if (idx < 0) { idx := 0 - idx; }
  return idx % cap;
}

fn _hmFind(hm: int64, key: pchar, keyLen: int64): int64 {
  var cap: int64 := peek64(hm + HM_HDR_CAP);
  var bptr: int64 := peek64(hm + HM_HDR_PTR);
  var idx: int64 := _hmHash(key, keyLen, cap);
  var probes: int64 := 0;
  while (probes < cap) {
    var boff: int64 := bptr + idx * HM_BUCKET_SIZE;
    var state: int64 := peek64(boff + HM_BKT_STATE);
    if (state == HM_EMPTY) { return -1; }
    if (state == HM_OCCUPIED) {
      var bklen: int64 := peek64(boff + HM_BKT_KLEN);
      if (bklen == keyLen) {
        var bkptr: int64 := peek64(boff + HM_BKT_KEY);
        var hmm: int64 := 1; var mj: int64 := 0;
        while (mj < keyLen && hmm != 0) {
          if (peek8(bkptr + mj) != StrCharAt(key, mj)) { hmm := 0; }
          mj += 1;
        }
        if (hmm != 0) { return idx; }
      }
    }
    idx := (idx + 1) % cap;
    probes += 1;
  }
  return -1;
}

fn _hmGrow(hm: int64): void {
  var oldCap: int64 := peek64(hm + HM_HDR_CAP);
  var newCap: int64 := oldCap * 2;
  var oldPtr: int64 := peek64(hm + HM_HDR_PTR);
  var newPtr: int64 := alloc(newCap * HM_BUCKET_SIZE);
  var j: int64 := 0;
  while (j < newCap * HM_BUCKET_SIZE) { poke8(newPtr + j, 0); j := j + 1; }
  poke64(hm + HM_HDR_CAP, newCap);
  poke64(hm + HM_HDR_PTR, newPtr);
  poke64(hm + HM_HDR_CNT, 0);
  // Re-insert all occupied entries
  var i: int64 := 0;
  while (i < oldCap) {
    var boff: int64 := oldPtr + i * HM_BUCKET_SIZE;
    if (peek64(boff + HM_BKT_STATE) == HM_OCCUPIED) {
      var kp: int64 := peek64(boff + HM_BKT_KEY);
      var kl: int64 := peek64(boff + HM_BKT_KLEN);
      var v:  int64 := peek64(boff + HM_BKT_VAL);
      HashMapSet(hm, kp as pchar, kl, v);
    }
    i += 1;
  }
  free(oldPtr, oldCap * HM_BUCKET_SIZE);
}

pub fn HashMapNew(capacity: int64): int64 {
  var cap: int64 := capacity;
  if (cap < 8) { cap := 8; }
  var hm: int64 := alloc(HM_HDR_SIZE);
  var bptr: int64 := alloc(cap * HM_BUCKET_SIZE);
  var j: int64 := 0;
  while (j < cap * HM_BUCKET_SIZE) { poke8(bptr + j, 0); j := j + 1; }
  poke64(hm + HM_HDR_CAP, cap);
  poke64(hm + HM_HDR_CNT, 0);
  poke64(hm + HM_HDR_PTR, bptr);
  return hm;
}

pub fn HashMapSet(hm: int64, key: pchar, keyLen: int64, value: int64): void {
  if (hm == 0) { return; }
  var cap: int64 := peek64(hm + HM_HDR_CAP);
  var cnt: int64 := peek64(hm + HM_HDR_CNT);
  // Grow if load > 75%
  if (cnt * 4 >= cap * 3) { _hmGrow(hm); cap := peek64(hm + HM_HDR_CAP); }
  var bptr: int64 := peek64(hm + HM_HDR_PTR);
  var idx: int64 := _hmHash(key, keyLen, cap);
  var probes: int64 := 0;
  while (probes < cap) {
    var boff: int64 := bptr + idx * HM_BUCKET_SIZE;
    var state: int64 := peek64(boff + HM_BKT_STATE);
    if (state == HM_EMPTY || state == HM_DELETED) {
      // Copy key
      var kp: int64 := alloc(keyLen + 1);
      var kj: int64 := 0;
      while (kj < keyLen) { poke8(kp + kj, StrCharAt(key, kj)); kj := kj + 1; }
      poke8(kp + keyLen, 0);
      poke64(boff + HM_BKT_KEY,   kp);
      poke64(boff + HM_BKT_KLEN,  keyLen);
      poke64(boff + HM_BKT_VAL,   value);
      poke64(boff + HM_BKT_STATE, HM_OCCUPIED);
      poke64(hm + HM_HDR_CNT, cnt + 1);
      return;
    }
    if (state == HM_OCCUPIED) {
      var bklen: int64 := peek64(boff + HM_BKT_KLEN);
      if (bklen == keyLen) {
        var bkptr: int64 := peek64(boff + HM_BKT_KEY);
        var hmm2: int64 := 1; var mj2: int64 := 0;
        while (mj2 < keyLen && hmm2 != 0) {
          if (peek8(bkptr + mj2) != StrCharAt(key, mj2)) { hmm2 := 0; }
          mj2 += 1;
        }
        if (hmm2 != 0) { poke64(boff + HM_BKT_VAL, value); return; }
      }
    }
    idx := (idx + 1) % cap;
    probes += 1;
  }
}

pub fn HashMapGet(hm: int64, key: pchar, keyLen: int64): int64 {
  if (hm == 0) { return 0; }
  var idx: int64 := _hmFind(hm, key, keyLen);
  if (idx < 0) { return 0; }
  return peek64(peek64(hm + HM_HDR_PTR) + idx * HM_BUCKET_SIZE + HM_BKT_VAL);
}

pub fn HashMapHas(hm: int64, key: pchar, keyLen: int64): bool {
  if (hm == 0) { return false; }
  return _hmFind(hm, key, keyLen) >= 0;
}

pub fn HashMapDel(hm: int64, key: pchar, keyLen: int64): void {
  if (hm == 0) { return; }
  var idx: int64 := _hmFind(hm, key, keyLen);
  if (idx < 0) { return; }
  var boff: int64 := peek64(hm + HM_HDR_PTR) + idx * HM_BUCKET_SIZE;
  poke64(boff + HM_BKT_STATE, HM_DELETED);
  poke64(hm + HM_HDR_CNT, peek64(hm + HM_HDR_CNT) - 1);
}

pub fn HashMapCount(hm: int64): int64 {
  if (hm == 0) { return 0; }
  return peek64(hm + HM_HDR_CNT);
}

pub fn HashMapFree(hm: int64): void {
  if (hm == 0) { return; }
  var cap: int64 := peek64(hm + HM_HDR_CAP);
  var bptr: int64 := peek64(hm + HM_HDR_PTR);
  var i: int64 := 0;
  while (i < cap) {
    var boff: int64 := bptr + i * HM_BUCKET_SIZE;
    if (peek64(boff + HM_BKT_STATE) == HM_OCCUPIED) {
      var klen: int64 := peek64(boff + HM_BKT_KLEN);
      free(peek64(boff + HM_BKT_KEY), klen + 1);
    }
    i += 1;
  }
  free(bptr, cap * HM_BUCKET_SIZE);
  free(hm, HM_HDR_SIZE);
}

// ============================================================================
// FEAT-07: RFC-konforme MD5 Streaming-API + HMAC-MD5
// Baut auf bestehenden _md5_k / MD5_ROTL / MD5_F/G/H/I auf.
// Kontext: [a:8][b:8][c:8][d:8][byteLen:8][fill:8][buf:64] = 112 Bytes
// ============================================================================

con MD5_CTX_SIZE: int64 := 112;
con MD5_A_OFF:   int64 := 0;
con MD5_B_OFF:   int64 := 8;
con MD5_C_OFF:   int64 := 16;
con MD5_D_OFF:   int64 := 24;
con MD5_LEN_OFF: int64 := 32;
con MD5_FIL_OFF: int64 := 40;
con MD5_BUF_OFF: int64 := 48;

fn md5_shift(i: int64): int64 {
  var r: int64 := i & 3;
  if (i < 16) {
    if (r == 0) { return 7; } if (r == 1) { return 12; }
    if (r == 2) { return 17; } return 22;
  }
  if (i < 32) {
    if (r == 0) { return 5; } if (r == 1) { return 9; }
    if (r == 2) { return 14; } return 20;
  }
  if (i < 48) {
    if (r == 0) { return 4; } if (r == 1) { return 11; }
    if (r == 2) { return 16; } return 23;
  }
  if (r == 0) { return 6; } if (r == 1) { return 10; }
  if (r == 2) { return 15; } return 21;
}

fn md5_msgidx(i: int64): int64 {
  if (i < 16) { return i; }
  if (i < 32) { return (5 * i + 1) & 15; }
  if (i < 48) { return (3 * i + 5) & 15; }
  return (7 * i) & 15;
}

// Liest ein little-endian 32-Bit-Wort aus dem Block
fn md5_word(block: int64, g: int64): int64 {
  var off: int64 := g * 4;
  return (peek8(block + off))       |
        ((peek8(block + off + 1)) << 8)  |
        ((peek8(block + off + 2)) << 16) |
        ((peek8(block + off + 3)) << 24);
}

fn md5_compress(ctx: int64, block: int64): void {
  var a: int64 := peek64(ctx + MD5_A_OFF);
  var b: int64 := peek64(ctx + MD5_B_OFF);
  var c: int64 := peek64(ctx + MD5_C_OFF);
  var d: int64 := peek64(ctx + MD5_D_OFF);
  var i: int64 := 0;
  while (i < 64) {
    var fv: int64 := 0;
    if (i < 16) { fv := MD5_F(b, c, d); }
    else if (i < 32) { fv := MD5_G(b, c, d); }
    else if (i < 48) { fv := MD5_H(b, c, d); }
    else { fv := MD5_I(b, c, d); }
    var g: int64 := md5_msgidx(i);
    var m: int64 := md5_word(block, g);
    var temp: int64 := (fv + a + _md5_k(i) + m) & 0xFFFFFFFF;
    a := d; d := c; c := b;
    b := (b + MD5_ROTL(temp, md5_shift(i))) & 0xFFFFFFFF;
    i += 1;
  }
  poke64(ctx + MD5_A_OFF, (peek64(ctx + MD5_A_OFF) + a) & 0xFFFFFFFF);
  poke64(ctx + MD5_B_OFF, (peek64(ctx + MD5_B_OFF) + b) & 0xFFFFFFFF);
  poke64(ctx + MD5_C_OFF, (peek64(ctx + MD5_C_OFF) + c) & 0xFFFFFFFF);
  poke64(ctx + MD5_D_OFF, (peek64(ctx + MD5_D_OFF) + d) & 0xFFFFFFFF);
}

pub fn MD5Init(ctx: int64): void {
  poke64(ctx + MD5_A_OFF,  MD5_A0);
  poke64(ctx + MD5_B_OFF,  MD5_B0);
  poke64(ctx + MD5_C_OFF,  MD5_C0);
  poke64(ctx + MD5_D_OFF,  MD5_D0);
  poke64(ctx + MD5_LEN_OFF, 0);
  poke64(ctx + MD5_FIL_OFF, 0);
}

pub fn MD5Update(ctx: int64, data: int64, len: int64): void {
  var i: int64 := 0;
  var fill: int64 := peek64(ctx + MD5_FIL_OFF);
  while (i < len) {
    poke8(ctx + MD5_BUF_OFF + fill, peek8(data + i));
    fill += 1;
    if (fill == 64) {
      md5_compress(ctx, ctx + MD5_BUF_OFF);
      poke64(ctx + MD5_LEN_OFF, peek64(ctx + MD5_LEN_OFF) + 64);
      fill := 0;
    }
    i += 1;
  }
  poke64(ctx + MD5_FIL_OFF, fill);
}

// Schreibt 16-Byte-Digest little-endian nach outBuf
pub fn MD5Final(ctx: int64, outBuf: int64): void {
  var fill: int64 := peek64(ctx + MD5_FIL_OFF);
  var totalLen: int64 := peek64(ctx + MD5_LEN_OFF) + fill;
  poke8(ctx + MD5_BUF_OFF + fill, 0x80);
  fill += 1;
  if (fill > 56) {
    while (fill < 64) { poke8(ctx + MD5_BUF_OFF + fill, 0); fill := fill + 1; }
    md5_compress(ctx, ctx + MD5_BUF_OFF);
    fill := 0;
  }
  while (fill < 56) { poke8(ctx + MD5_BUF_OFF + fill, 0); fill := fill + 1; }
  // Länge als little-endian 64-Bit
  var bitLen: int64 := totalLen * 8;
  var j: int64 := 0;
  while (j < 8) {
    poke8(ctx + MD5_BUF_OFF + 56 + j, (bitLen >> (j * 8)) & 0xFF);
    j += 1;
  }
  md5_compress(ctx, ctx + MD5_BUF_OFF);
  // Ausgabe little-endian
  var hi: int64 := 0;
  while (hi < 4) {
    var word: int64 := peek64(ctx + MD5_A_OFF + hi * 8);
    poke8(outBuf + hi * 4,      word        & 0xFF);
    poke8(outBuf + hi * 4 + 1, (word >>  8) & 0xFF);
    poke8(outBuf + hi * 4 + 2, (word >> 16) & 0xFF);
    poke8(outBuf + hi * 4 + 3, (word >> 24) & 0xFF);
    hi += 1;
  }
}

// Convenience: hash a pchar, return alloc'd 16-byte digest
pub fn MD5Hash(data: pchar): int64 {
  var ctx: int64 := alloc(MD5_CTX_SIZE);
  MD5Init(ctx);
  MD5Update(ctx, data as int64, StrLen(data));
  var out: int64 := alloc(16);
  MD5Final(ctx, out);
  free(ctx, MD5_CTX_SIZE);
  return out;
}

// HMAC-MD5: identisch zu HMAC-SHA256, aber mit MD5 (16-Byte-Digest)
pub fn HMACMD5(key: int64, keyLen: int64, msg: int64, msgLen: int64): int64 {
  var kblock: int64 := alloc(64);
  var i: int64 := 0;
  while (i < 64) { poke8(kblock + i, 0); i := i + 1; }
  if (keyLen > 64) {
    var kctx: int64 := alloc(MD5_CTX_SIZE);
    MD5Init(kctx);
    MD5Update(kctx, key, keyLen);
    MD5Final(kctx, kblock);
    free(kctx, MD5_CTX_SIZE);
  } else {
    i := 0; while (i < keyLen) { poke8(kblock + i, peek8(key + i)); i := i + 1; }
  }
  var ipad: int64 := alloc(64);
  i := 0; while (i < 64) { poke8(ipad + i, peek8(kblock + i) ^ 0x36); i := i + 1; }
  var ictx: int64 := alloc(MD5_CTX_SIZE);
  MD5Init(ictx);
  MD5Update(ictx, ipad, 64);
  MD5Update(ictx, msg, msgLen);
  var innerHash: int64 := alloc(16);
  MD5Final(ictx, innerHash);
  free(ictx, MD5_CTX_SIZE); free(ipad, 64);
  var opad: int64 := alloc(64);
  i := 0; while (i < 64) { poke8(opad + i, peek8(kblock + i) ^ 0x5C); i := i + 1; }
  var octx: int64 := alloc(MD5_CTX_SIZE);
  MD5Init(octx);
  MD5Update(octx, opad, 64);
  MD5Update(octx, innerHash, 16);
  var out: int64 := alloc(16);
  MD5Final(octx, out);
  free(octx, MD5_CTX_SIZE); free(opad, 64);
  free(innerHash, 16); free(kblock, 64);
  return out;
}

// ============================================================================
// FEAT-07: xxHash64 — schneller nicht-kryptografischer 64-Bit-Hash
// Ref: https://github.com/Cyan4973/xxHash — XXH64
// ============================================================================

con XXH_PRIME1: int64 := 0x9E3779B185EBCA87;
con XXH_PRIME2: int64 := 0xC2B2AE3D27D4EB4F;
con XXH_PRIME3: int64 := 0x165667B19E3779F9;
con XXH_PRIME4: int64 := 0x85EBCA77C2B2AE63;
con XXH_PRIME5: int64 := 0x27D4EB2F165667C5;

fn xxh_rotl64(x: int64, r: int64): int64 {
  return (x << r) | ((x as uint64) >> (64 - r));   // #1125: Rotation braucht den logischen Shift
}

fn xxh_round(acc: int64, input: int64): int64 {
  var v: int64 := acc + input * XXH_PRIME2;
  v := xxh_rotl64(v, 31);
  return v * XXH_PRIME1;
}

fn xxh_merge(acc: int64, val: int64): int64 {
  var v: int64 := acc ^ xxh_round(0, val);
  return v * XXH_PRIME1 + XXH_PRIME4;
}

fn xxh_read64le(p: int64): int64 {
  return peek8(p)         |
        (peek8(p+1) << 8)  |
        (peek8(p+2) << 16) |
        (peek8(p+3) << 24) |
        (peek8(p+4) << 32) |
        (peek8(p+5) << 40) |
        (peek8(p+6) << 48) |
        (peek8(p+7) << 56);
}

fn xxh_read32le(p: int64): int64 {
  return peek8(p)         |
        (peek8(p+1) << 8)  |
        (peek8(p+2) << 16) |
        (peek8(p+3) << 24);
}

// Hasht len Bytes ab data mit seed (meist 0)
pub fn XXHash64(data: int64, len: int64, seed: int64): int64 {
  var p:   int64 := data;
  var end: int64 := data + len;
  var h64: int64 := 0;

  if (len >= 32) {
    var v1: int64 := seed + XXH_PRIME1 + XXH_PRIME2;
    var v2: int64 := seed + XXH_PRIME2;
    var v3: int64 := seed;
    var v4: int64 := seed - XXH_PRIME1;

    var limit: int64 := end - 32;
    while (p <= limit) {
      v1 := xxh_round(v1, xxh_read64le(p));     p := p + 8;
      v2 := xxh_round(v2, xxh_read64le(p));     p := p + 8;
      v3 := xxh_round(v3, xxh_read64le(p));     p := p + 8;
      v4 := xxh_round(v4, xxh_read64le(p));     p := p + 8;
    }

    h64 := xxh_rotl64(v1, 1)  + xxh_rotl64(v2, 7)  +
           xxh_rotl64(v3, 12) + xxh_rotl64(v4, 18);
    h64 := xxh_merge(h64, v1);
    h64 := xxh_merge(h64, v2);
    h64 := xxh_merge(h64, v3);
    h64 := xxh_merge(h64, v4);
  } else {
    h64 := seed + XXH_PRIME5;
  }

  h64 += len;

  // Consume remaining bytes in 8-, 4-, and 1-byte chunks
  while (p + 8 <= end) {
    var k1: int64 := xxh_round(0, xxh_read64le(p));
    h64 := xxh_rotl64(h64 ^ k1, 27) * XXH_PRIME1 + XXH_PRIME4;
    p += 8;
  }
  if (p + 4 <= end) {
    h64 := xxh_rotl64(h64 ^ (xxh_read32le(p) * XXH_PRIME1), 23) * XXH_PRIME2 + XXH_PRIME3;
    p += 4;
  }
  while (p < end) {
    h64 := xxh_rotl64(h64 ^ (peek8(p) * XXH_PRIME5), 11) * XXH_PRIME1;
    p += 1;
  }

  // Final avalanche
  h64 := (h64 ^ (h64 >> 33)) * XXH_PRIME2;
  h64 := (h64 ^ (h64 >> 29)) * XXH_PRIME3;
  return h64 ^ (h64 >> 32);
}

// Kurzform: pchar mit seed=0
pub fn XXHash64Str(s: pchar): int64 {
  return XXHash64(s as int64, StrLen(s), 0);
}

// ============================================================================
// WP-1: Constant-Time Byte Comparison (1.9)
// ============================================================================

pub fn ConstantTimeCompareBytes(a: int64, b: int64, len: int64): bool {
  var diff: int64 := 0;
  var i: int64 := 0;
  while (i < len) {
    diff := diff | (peek8(a + i) ^ peek8(b + i));
    i += 1;
  }
  return diff == 0;
}

// ============================================================================
// WP-1: CSPRNG — reads from /dev/urandom (1.7)
// ============================================================================

pub fn GenerateSaltBytes(outBuf: int64, len: int64): bool {
  var fd: int64 := open("/dev/urandom", 0, 0);
  if (fd < 0) { return false; }
  var n: int64 := sys_read(fd, outBuf, len);
  sys_close(fd);
  return n == len;
}

// ============================================================================
// WP-1: PBKDF2-HMAC-SHA256 — RFC 2898 (1.4)
// Single 32-byte output block. outBuf must point to ≥32 alloc'd bytes.
// ============================================================================

pub fn PBKDF2HMACSHA256Bytes(password: int64, passwordLen: int64,
                              salt: int64, saltLen: int64,
                              iterations: int64, outBuf: int64) {
  var saltBuf: int64 := alloc(saltLen + 4);
  var i: int64 := 0;
  while (i < saltLen) { poke8(saltBuf + i, peek8(salt + i)); i := i + 1; }
  poke8(saltBuf + saltLen + 0, 0);
  poke8(saltBuf + saltLen + 1, 0);
  poke8(saltBuf + saltLen + 2, 0);
  poke8(saltBuf + saltLen + 3, 1);
  var u: int64 := HMACSHA256(password, passwordLen, saltBuf, saltLen + 4);
  free(saltBuf, saltLen + 4);
  var j: int64 := 0;
  while (j < 32) { poke8(outBuf + j, peek8(u + j)); j := j + 1; }
  i := 1;
  while (i < iterations) {
    var prev: int64 := u;
    u := HMACSHA256(password, passwordLen, prev, 32);
    free(prev, 32);
    j := 0;
    while (j < 32) {
      poke8(outBuf + j, peek8(outBuf + j) ^ peek8(u + j));
      j += 1;
    }
    i += 1;
  }
  free(u, 32);
}

// ============================================================================
// WP-1: SHA-512 / SHA-384 — FIPS 180-4 (1.2)
// Context layout (208 bytes):
//   +0:   h0..h7 (8 × int64 = 64 bytes)
//   +64:  total bytes processed (int64)
//   +72:  partial block fill level (int64)
//   +80:  128-byte block buffer
// ============================================================================

con SHA512_CTX_SIZE: int64 := 208;
con SHA512_H_OFF:    int64 := 0;
con SHA512_LEN_OFF:  int64 := 64;
con SHA512_FILL_OFF: int64 := 72;
con SHA512_BUF_OFF:  int64 := 80;

fn sha512_rotr(x: int64, n: int64): int64 {
  return (x >> n) | (x << (64 - n));
}

fn sha512_ch(x: int64, y: int64, z: int64): int64 {
  return (x & y) ^ ((x ^ 0xFFFFFFFFFFFFFFFF) & z);
}

fn sha512_maj(x: int64, y: int64, z: int64): int64 {
  return (x & y) ^ (x & z) ^ (y & z);
}

fn sha512_S0(x: int64): int64 {
  return sha512_rotr(x, 28) ^ sha512_rotr(x, 34) ^ sha512_rotr(x, 39);
}

fn sha512_S1(x: int64): int64 {
  return sha512_rotr(x, 14) ^ sha512_rotr(x, 18) ^ sha512_rotr(x, 41);
}

fn sha512_G0(x: int64): int64 {
  return sha512_rotr(x, 1) ^ sha512_rotr(x, 8) ^ (x >> 7);
}

fn sha512_G1(x: int64): int64 {
  return sha512_rotr(x, 19) ^ sha512_rotr(x, 61) ^ (x >> 6);
}

fn sha512_k(i: int64): int64 {
  if (i == 0)  { return 0x428a2f98d728ae22; } if (i == 1)  { return 0x7137449123ef65cd; }
  if (i == 2)  { return 0xb5c0fbcfec4d3b2f; } if (i == 3)  { return 0xe9b5dba58189dbbc; }
  if (i == 4)  { return 0x3956c25bf348b538; } if (i == 5)  { return 0x59f111f1b605d019; }
  if (i == 6)  { return 0x923f82a4af194f9b; } if (i == 7)  { return 0xab1c5ed5da6d8118; }
  if (i == 8)  { return 0xd807aa98a3030242; } if (i == 9)  { return 0x12835b0145706fbe; }
  if (i == 10) { return 0x243185be4ee4b28c; } if (i == 11) { return 0x550c7dc3d5ffb4e2; }
  if (i == 12) { return 0x72be5d74f27b896f; } if (i == 13) { return 0x80deb1fe3b1696b1; }
  if (i == 14) { return 0x9bdc06a725c71235; } if (i == 15) { return 0xc19bf174cf692694; }
  if (i == 16) { return 0xe49b69c19ef14ad2; } if (i == 17) { return 0xefbe4786384f25e3; }
  if (i == 18) { return 0x0fc19dc68b8cd5b5; } if (i == 19) { return 0x240ca1cc77ac9c65; }
  if (i == 20) { return 0x2de92c6f592b0275; } if (i == 21) { return 0x4a7484aa6ea6e483; }
  if (i == 22) { return 0x5cb0a9dcbd41fbd4; } if (i == 23) { return 0x76f988da831153b5; }
  if (i == 24) { return 0x983e5152ee66dfab; } if (i == 25) { return 0xa831c66d2db43210; }
  if (i == 26) { return 0xb00327c898fb213f; } if (i == 27) { return 0xbf597fc7beef0ee4; }
  if (i == 28) { return 0xc6e00bf33da88fc2; } if (i == 29) { return 0xd5a79147930aa725; }
  if (i == 30) { return 0x06ca6351e003826f; } if (i == 31) { return 0x142929670a0e6e70; }
  if (i == 32) { return 0x27b70a8546d22ffc; } if (i == 33) { return 0x2e1b21385c26c926; }
  if (i == 34) { return 0x4d2c6dfc5ac42aed; } if (i == 35) { return 0x53380d139d95b3df; }
  if (i == 36) { return 0x650a73548baf63de; } if (i == 37) { return 0x766a0abb3c77b2a8; }
  if (i == 38) { return 0x81c2c92e47edaee6; } if (i == 39) { return 0x92722c851482353b; }
  if (i == 40) { return 0xa2bfe8a14cf10364; } if (i == 41) { return 0xa81a664bbc423001; }
  if (i == 42) { return 0xc24b8b70d0f89791; } if (i == 43) { return 0xc76c51a30654be30; }
  if (i == 44) { return 0xd192e819d6ef5218; } if (i == 45) { return 0xd69906245565a910; }
  if (i == 46) { return 0xf40e35855771202a; } if (i == 47) { return 0x106aa07032bbd1b8; }
  if (i == 48) { return 0x19a4c116b8d2d0c8; } if (i == 49) { return 0x1e376c085141ab53; }
  if (i == 50) { return 0x2748774cdf8eeb99; } if (i == 51) { return 0x34b0bcb5e19b48a8; }
  if (i == 52) { return 0x391c0cb3c5c95a63; } if (i == 53) { return 0x4ed8aa4ae3418acb; }
  if (i == 54) { return 0x5b9cca4f7763e373; } if (i == 55) { return 0x682e6ff3d6b2b8a3; }
  if (i == 56) { return 0x748f82ee5defb2fc; } if (i == 57) { return 0x78a5636f43172f60; }
  if (i == 58) { return 0x84c87814a1f0ab72; } if (i == 59) { return 0x8cc702081a6439ec; }
  if (i == 60) { return 0x90befffa23631e28; } if (i == 61) { return 0xa4506cebde82bde9; }
  if (i == 62) { return 0xbef9a3f7b2c67915; } if (i == 63) { return 0xc67178f2e372532b; }
  if (i == 64) { return 0xca273eceea26619c; } if (i == 65) { return 0xd186b8c721c0c207; }
  if (i == 66) { return 0xeada7dd6cde0eb1e; } if (i == 67) { return 0xf57d4f7fee6ed178; }
  if (i == 68) { return 0x06f067aa72176fba; } if (i == 69) { return 0x0a637dc5a2c898a6; }
  if (i == 70) { return 0x113f9804bef90dae; } if (i == 71) { return 0x1b710b35131c471b; }
  if (i == 72) { return 0x28db77f523047d84; } if (i == 73) { return 0x32caab7b40c72493; }
  if (i == 74) { return 0x3c9ebe0a15c9bebc; } if (i == 75) { return 0x431d67c49c100d4c; }
  if (i == 76) { return 0x4cc5d4becb3e42b6; } if (i == 77) { return 0x597f299cfc657e2a; }
  if (i == 78) { return 0x5fcb6fab3ad6faec; } if (i == 79) { return 0x6c44198c4a475817; }
  return 0;
}

fn sha512_compress(ctx: int64, block: int64) {
  var w: int64 := alloc(80 * 8);
  var i: int64 := 0;
  while (i < 16) {
    var off: int64 := i * 8;
    var val: int64 := ((peek8(block + off) << 56) | (peek8(block + off + 1) << 48) |
                       (peek8(block + off + 2) << 40) | (peek8(block + off + 3) << 32) |
                       (peek8(block + off + 4) << 24) | (peek8(block + off + 5) << 16) |
                       (peek8(block + off + 6) << 8)  |  peek8(block + off + 7));
    poke64(w + i * 8, val);
    i += 1;
  }
  while (i < 80) {
    var w2:  int64 := peek64(w + (i - 2)  * 8);
    var w7:  int64 := peek64(w + (i - 7)  * 8);
    var w15: int64 := peek64(w + (i - 15) * 8);
    var w16: int64 := peek64(w + (i - 16) * 8);
    poke64(w + i * 8, sha512_G1(w2) + w7 + sha512_G0(w15) + w16);
    i += 1;
  }
  var a: int64 := peek64(ctx + SHA512_H_OFF);
  var b: int64 := peek64(ctx + SHA512_H_OFF + 8);
  var c: int64 := peek64(ctx + SHA512_H_OFF + 16);
  var d: int64 := peek64(ctx + SHA512_H_OFF + 24);
  var e: int64 := peek64(ctx + SHA512_H_OFF + 32);
  var f: int64 := peek64(ctx + SHA512_H_OFF + 40);
  var g: int64 := peek64(ctx + SHA512_H_OFF + 48);
  var h: int64 := peek64(ctx + SHA512_H_OFF + 56);
  i := 0;
  while (i < 80) {
    var t1: int64 := h + sha512_S1(e) + sha512_ch(e, f, g) + sha512_k(i) + peek64(w + i * 8);
    var t2: int64 := sha512_S0(a) + sha512_maj(a, b, c);
    h := g; g := f; f := e; e := d + t1;
    d := c; c := b; b := a; a := t1 + t2;
    i += 1;
  }
  poke64(ctx + SHA512_H_OFF,      peek64(ctx + SHA512_H_OFF)      + a);
  poke64(ctx + SHA512_H_OFF + 8,  peek64(ctx + SHA512_H_OFF + 8)  + b);
  poke64(ctx + SHA512_H_OFF + 16, peek64(ctx + SHA512_H_OFF + 16) + c);
  poke64(ctx + SHA512_H_OFF + 24, peek64(ctx + SHA512_H_OFF + 24) + d);
  poke64(ctx + SHA512_H_OFF + 32, peek64(ctx + SHA512_H_OFF + 32) + e);
  poke64(ctx + SHA512_H_OFF + 40, peek64(ctx + SHA512_H_OFF + 40) + f);
  poke64(ctx + SHA512_H_OFF + 48, peek64(ctx + SHA512_H_OFF + 48) + g);
  poke64(ctx + SHA512_H_OFF + 56, peek64(ctx + SHA512_H_OFF + 56) + h);
  free(w, 80 * 8);
}

pub fn SHA512Init(ctx: int64) {
  poke64(ctx + SHA512_H_OFF,      0x6a09e667f3bcc908);
  poke64(ctx + SHA512_H_OFF + 8,  0xbb67ae8584caa73b);
  poke64(ctx + SHA512_H_OFF + 16, 0x3c6ef372fe94f82b);
  poke64(ctx + SHA512_H_OFF + 24, 0xa54ff53a5f1d36f1);
  poke64(ctx + SHA512_H_OFF + 32, 0x510e527fade682d1);
  poke64(ctx + SHA512_H_OFF + 40, 0x9b05688c2b3e6c1f);
  poke64(ctx + SHA512_H_OFF + 48, 0x1f83d9abfb41bd6b);
  poke64(ctx + SHA512_H_OFF + 56, 0x5be0cd19137e2179);
  poke64(ctx + SHA512_LEN_OFF, 0);
  poke64(ctx + SHA512_FILL_OFF, 0);
}

pub fn SHA384Init(ctx: int64) {
  poke64(ctx + SHA512_H_OFF,      0xcbbb9d5dc1059ed8);
  poke64(ctx + SHA512_H_OFF + 8,  0x629a292a367cd507);
  poke64(ctx + SHA512_H_OFF + 16, 0x9159015a3070dd17);
  poke64(ctx + SHA512_H_OFF + 24, 0x152fecd8f70e5939);
  poke64(ctx + SHA512_H_OFF + 32, 0x67332667ffc00b31);
  poke64(ctx + SHA512_H_OFF + 40, 0x8eb44a8768581511);
  poke64(ctx + SHA512_H_OFF + 48, 0xdb0c2e0d64f98fa7);
  poke64(ctx + SHA512_H_OFF + 56, 0x47b5481dbefa4fa4);
  poke64(ctx + SHA512_LEN_OFF, 0);
  poke64(ctx + SHA512_FILL_OFF, 0);
}

pub fn SHA512Update(ctx: int64, data: int64, len: int64) {
  var fill: int64 := peek64(ctx + SHA512_FILL_OFF);
  var i: int64 := 0;
  while (i < len) {
    poke8(ctx + SHA512_BUF_OFF + fill, peek8(data + i));
    fill += 1;
    if (fill == 128) {
      sha512_compress(ctx, ctx + SHA512_BUF_OFF);
      poke64(ctx + SHA512_LEN_OFF, peek64(ctx + SHA512_LEN_OFF) + 128);
      fill := 0;
    }
    i += 1;
  }
  poke64(ctx + SHA512_FILL_OFF, fill);
}

pub fn SHA512Final(ctx: int64, outBuf: int64) {
  var fill: int64 := peek64(ctx + SHA512_FILL_OFF);
  var totalLen: int64 := peek64(ctx + SHA512_LEN_OFF) + fill;
  var bitLen: int64 := totalLen * 8;
  poke8(ctx + SHA512_BUF_OFF + fill, 0x80);
  fill += 1;
  if (fill > 112) {
    while (fill < 128) { poke8(ctx + SHA512_BUF_OFF + fill, 0); fill := fill + 1; }
    sha512_compress(ctx, ctx + SHA512_BUF_OFF);
    fill := 0;
  }
  while (fill < 112) { poke8(ctx + SHA512_BUF_OFF + fill, 0); fill := fill + 1; }
  // 16-byte big-endian bit length: upper 64 bits are 0 for msgs < 2^61 bytes
  var j: int64 := 0;
  while (j < 8)  { poke8(ctx + SHA512_BUF_OFF + 112 + j, 0); j := j + 1; }
  j := 0;
  while (j < 8)  {
    poke8(ctx + SHA512_BUF_OFF + 120 + (7 - j), (bitLen >> (j * 8)) & 0xFF);
    j += 1;
  }
  sha512_compress(ctx, ctx + SHA512_BUF_OFF);
  var hi: int64 := 0;
  while (hi < 8) {
    var word: int64 := peek64(ctx + SHA512_H_OFF + hi * 8);
    var base: int64 := hi * 8;
    poke8(outBuf + base + 0, (word >> 56) & 0xFF);
    poke8(outBuf + base + 1, (word >> 48) & 0xFF);
    poke8(outBuf + base + 2, (word >> 40) & 0xFF);
    poke8(outBuf + base + 3, (word >> 32) & 0xFF);
    poke8(outBuf + base + 4, (word >> 24) & 0xFF);
    poke8(outBuf + base + 5, (word >> 16) & 0xFF);
    poke8(outBuf + base + 6, (word >> 8)  & 0xFF);
    poke8(outBuf + base + 7,  word        & 0xFF);
    hi += 1;
  }
}

pub fn SHA512Hash(data: pchar): int64 {
  var ctx: int64 := alloc(SHA512_CTX_SIZE);
  SHA512Init(ctx);
  SHA512Update(ctx, data as int64, StrLen(data));
  var out: int64 := alloc(64);
  SHA512Final(ctx, out);
  free(ctx, SHA512_CTX_SIZE);
  return out;
}

pub fn SHA384Hash(data: pchar): int64 {
  var ctx: int64 := alloc(SHA512_CTX_SIZE);
  SHA384Init(ctx);
  SHA512Update(ctx, data as int64, StrLen(data));
  var out: int64 := alloc(48);
  SHA512Final(ctx, out);
  free(ctx, SHA512_CTX_SIZE);
  return out;
}
