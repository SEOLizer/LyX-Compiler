// Hash functions: FNV-1a, DJB2, MurmurHash, CRC32, SHA-256, MD5, BLAKE3, SHA-3,
// CityHash, FarmHash, MurmurHash3, xxHash, PBKDF2, bcrypt, Argon2, Scrypt

@description("Hash table (map) implementation")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
@capabilities([fs.read])
unit std.hash;

import std.alloc;
import std.string;

// FFI: libcrypt (bcrypt via crypt())
extern fn crypt(key: int64, setting: int64): int64 link "libcrypt.so.1";

// FFI: libsodium (Argon2id via crypto_pwhash_str)
extern fn crypto_pwhash_str(out: int64, passwd: int64, passwdlen: int64, opslimit: int64, memlimit: int64): int64 link "libsodium.so.23";
extern fn crypto_pwhash_str_verify(str: int64, passwd: int64, passwdlen: int64): int64 link "libsodium.so.23";

con CRYPTO_PWHASH_STRBYTES: int64 := 128;
con CRYPTO_PWHASH_OPSLIMIT_INTERACTIVE: int64 := 2;
con CRYPTO_PWHASH_MEMLIMIT_INTERACTIVE: int64 := 67108864;

// ============================================================================
// FNV-1a Constants
// ============================================================================

con FNV_OFFSET_BASIS_32: int64 := 2166136261;
con FNV_PRIME_32: int64 := 16777619;
con FNV_OFFSET_BASIS_64: int64 := 14695981039346656037;
con FNV_PRIME_64: int64 := 1099511628211;

// ============================================================================
// FNV-1a 32-bit
// ============================================================================

pub fn HashFNV1a32(data: pchar): int64 {
  var hash: int64 := FNV_OFFSET_BASIS_32;
  var i: int64 := 0;
  var len: int64 := StrLen(data);
  while (i < len) {
    var byte_val: int64 := StrCharAt(data, i);
    hash := hash ^ byte_val;
    hash := hash * FNV_PRIME_32;
    i += 1;
  }
  return hash & 4294967295;
}

pub fn HashFNV1a32Bytes(data: pchar, len: int64): int64 {
  var hash: int64 := FNV_OFFSET_BASIS_32;
  var i: int64 := 0;
  while (i < len) {
    var byte_val: int64 := StrCharAt(data, i);
    hash := hash ^ byte_val;
    hash := hash * FNV_PRIME_32;
    i += 1;
  }
  return hash & 4294967295;
}

// ============================================================================
// FNV-1a 64-bit
// ============================================================================

pub fn HashFNV1a64(data: pchar): int64 {
  var hash: int64 := FNV_OFFSET_BASIS_64;
  var i: int64 := 0;
  var len: int64 := StrLen(data);
  while (i < len) {
    var byte_val: int64 := StrCharAt(data, i);
    hash := hash ^ byte_val;
    hash := hash * FNV_PRIME_64;
    i += 1;
  }
  return hash;
}

pub fn HashFNV1a64Bytes(data: pchar, len: int64): int64 {
  var hash: int64 := FNV_OFFSET_BASIS_64;
  var i: int64 := 0;
  while (i < len) {
    var byte_val: int64 := StrCharAt(data, i);
    hash := hash ^ byte_val;
    hash := hash * FNV_PRIME_64;
    i += 1;
  }
  return hash;
}

// ============================================================================
// DJB2
// ============================================================================

pub fn HashDJB2(data: pchar): int64 {
  var hash: int64 := 5381;
  var i: int64 := 0;
  var len: int64 := StrLen(data);
  while (i < len) {
    var c: int64 := StrCharAt(data, i);
    var h33: int64 := hash * 33;
    hash := h33 + c;
    i += 1;
  }
  return hash;
}

// ============================================================================
// MurmurHash2
// ============================================================================

con MURMUR_M: int64 := 0x5bd1e995;
con MURMUR_R: int64 := 24;

pub fn HashMurmur2(data: pchar, seed: int64): int64 {
  var len: int64 := StrLen(data);
  var h: int64 := seed ^ len;
  var i: int64 := 0;
  while (i < len) {
    var k: int64 := StrCharAt(data, i);
    k := k * MURMUR_M;
    k := k ^ ((k as uint64) >> MURMUR_R);   // #1125: Mischung auf dem Bitmuster
    k := k * MURMUR_M;
    h := h * MURMUR_M;
    h := h ^ k;
    i += 1;
  }
  h := h ^ ((h as uint64) >> 13);        // #1125
  h := h * MURMUR_M;
  h := h ^ ((h as uint64) >> 15);        // #1125
  return h;
}

pub fn HashMurmur2Default(data: pchar): int64 {
  return HashMurmur2(data, 0);
}

// ============================================================================
// CRC32
// ============================================================================

pub fn HashCRC32(data: pchar): int64 {
  var crc: int64 := 0xFFFFFFFF;
  var i: int64 := 0;
  var len: int64 := StrLen(data);
  while (i < len) {
    crc := crc ^ (StrCharAt(data, i) & 255);
    var bit: int64 := 0;
    while (bit < 8) {
      if ((crc & 1) != 0) {
        crc := (crc >> 1) ^ 0xEDB88320;
      } else {
        crc := crc >> 1;
      }
      bit += 1;
    }
    i += 1;
  }
  return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF;
}

// ============================================================================
// SHA-256 Constants and Helpers
// ============================================================================

fn Ch(x: int64, y: int64, z: int64): int64 {
  return (x & y) ^ ((~x) & z);
}

fn Maj(x: int64, y: int64, z: int64): int64 {
  return (x & y) ^ (x & z) ^ (y & z);
}

fn Rotr(x: int64, n: int64): int64 {
  var sh: int64 := 32 - n;
  var left: int64 := x >> n;
  var right: int64 := x << sh;
  var rmasked: int64 := right & 0xFFFFFFFF;
  return left | rmasked;
}

fn Sigma0(x: int64): int64 {
  return Rotr(x, 2) ^ Rotr(x, 13) ^ Rotr(x, 22);
}

fn Sigma1(x: int64): int64 {
  return Rotr(x, 6) ^ Rotr(x, 11) ^ Rotr(x, 25);
}

fn Gamma0(x: int64): int64 {
  return Rotr(x, 7) ^ Rotr(x, 18) ^ (x >> 3);
}

fn Gamma1(x: int64): int64 {
  return Rotr(x, 17) ^ Rotr(x, 19) ^ (x >> 10);
}

fn SHA256Add(a: int64, b: int64): int64 {
  var s: int64 := a + b;
  return s & 0xFFFFFFFF;
}

fn SHA256RightShift(a: int64, n: int64): int64 {
  return a >> n;
}

// ============================================================================
// SHA-256 Hash — delegates to correct multi-block implementation (FEAT-07)
// Returns first 8 bytes of 32-byte digest as int64 for backwards compatibility.
// For the full 32-byte digest use SHA256Hash() / SHA256Final().
// ============================================================================

pub fn HashSHA256(data: pchar): int64 {
  var digest: int64 := SHA256Hash(data);
  var hi: int64 := (peek8(digest + 0) << 24) | (peek8(digest + 1) << 16) |
                   (peek8(digest + 2) << 8)  |  peek8(digest + 3);
  var lo: int64 := (peek8(digest + 4) << 24) | (peek8(digest + 5) << 16) |
                   (peek8(digest + 6) << 8)  |  peek8(digest + 7);
  free(digest, 32);
  return (hi << 32) | (lo & 0xFFFFFFFF);
}

// ============================================================================
// Password Hashing — uses PBKDF2-HMAC-SHA256 (WP-1 security fix)
// ============================================================================

pub fn HashPassword(password: pchar, salt: pchar): int64 {
  var plen: int64 := StrLen(password);
  var slen: int64 := StrLen(salt);
  var out: int64 := alloc(32);
  PBKDF2HMACSHA256Bytes(password as int64, plen, salt as int64, slen, 600000, out);
  var result: int64 := peek64(out);
  free(out, 32);
  return result;
}

// DEPRECATED: no constant-time salt, no key-stretching — use HashBCryptStr or HashArgon2idStr
pub fn HashPasswordSimple(password: pchar, salt: int64): int64 {
  var saltBuf: int64 := alloc(8);
  poke64(saltBuf, salt);
  var plen: int64 := StrLen(password);
  var out: int64 := alloc(32);
  PBKDF2HMACSHA256Bytes(password as int64, plen, saltBuf, 8, 100000, out);
  var result: int64 := peek64(out);
  free(out, 32);
  free(saltBuf, 8);
  return result;
}

// ============================================================================
// Hash Table Helper
// ============================================================================

pub fn HashTableIndex(key: pchar, table_size: int64): int64 {
  var hash: int64 := HashDJB2(key);
  if (hash < 0) { hash := -hash; }
  return hash % table_size;
}

// ============================================================================
// Byte Array Hash
// ============================================================================

pub fn HashBytes(data: pchar, len: int64): int64 {
  var hash: int64 := FNV_OFFSET_BASIS_64;
  var i: int64 := 0;
  while (i < len) {
    hash := hash ^ StrCharAt(data, i);
    hash := hash * FNV_PRIME_64;
    i += 1;
  }
  return hash;
}

// ============================================================================
// Integer Hash
// ============================================================================

pub fn HashInt64(key: int64): int64 {
  // #1125: Der Mischer arbeitet auf dem BITMUSTER — der Rechtsshift muss mit
  // Nullen auffuellen. Seit 1.0.13S zieht `>>` auf int64 das Vorzeichen nach,
  // `as uint64` fordert den logischen Shift ausdruecklich an.
  key := key ^ ((key as uint64) >> 33);
  key := key * 0xff51afd7ed558ccd;
  key := key ^ ((key as uint64) >> 33);
  key := key * 0xc4ceb9fe1a85ec53;
  key := key ^ ((key as uint64) >> 33);
  return key;
}

pub fn HashInt32(key: int64): int64 {
  key := key ^ ((key as uint64) >> 16);   // #1125
  key := key * 0x85ebca6b;
  key := key ^ ((key as uint64) >> 13);   // #1125
  key := key * 0xc2b2ae35;
  key := key ^ ((key as uint64) >> 16);   // #1125
  return key & 0xFFFFFFFF;
}

