}

// ============================================================================
// Hash Comparison Utilities
// ============================================================================

pub fn VerifyHash(data: pchar, algorithm: int64, expected_hex: pchar): bool {
  var computed_hex: pchar := "";

  if (algorithm == 1) {
    computed_hex := HashMD5StringHex(data);
  } else if (algorithm == 2) {
    computed_hex := HashBLAKE3Hex(data);
  } else if (algorithm == 3) {
    computed_hex := HashBLAKE3Hex(data);
  } else if (algorithm == 4) {
    computed_hex := HashCity64Hex(data);
  } else if (algorithm == 5) {
    computed_hex := HashFarm64Hex(data);
  } else {
    return false;
  }

  var i: int64 := 0;
  var expected_len: int64 := StrLen(expected_hex);
  while (i < expected_len) {
    if (computed_hex[i] != expected_hex[i]) {
      return false;
    }
    i += 1;
  }

  return true;
}

// ============================================================================
// PBKDF2-HMAC-SHA256 — RFC 2898, single 32-byte output block (WP-1 security fix)
// ============================================================================

con PBKDF2_ITERATIONS: int64 := 600000;

pub fn HashPBKDF2(password: pchar, salt: pchar, iterations: int64): int64 {
  if (iterations <= 0) { iterations := PBKDF2_ITERATIONS; }
  var plen: int64 := StrLen(password);
  var slen: int64 := StrLen(salt);
  var out: int64 := alloc(32);
  PBKDF2HMACSHA256Bytes(password as int64, plen, salt as int64, slen, iterations, out);
  var result: int64 := peek64(out);
  free(out, 32);
  return result;
}

pub fn HashPBKDF2Default(password: pchar, salt: pchar): int64 {
  return HashPBKDF2(password, salt, PBKDF2_ITERATIONS);
}

pub fn HashPBKDF2Hex(password: pchar, salt: pchar, iterations: int64): pchar {
  var hash: int64 := HashPBKDF2(password, salt, iterations);
  var hex: pchar := "                                ";
  var pos: int64 := 0;
  var i: int64 := 60;
  while (i >= 0) {
    var nibble: int64 := (hash >> i) & 15;
    if (nibble < 10) { hex[pos] := 48 + nibble; } else { hex[pos] := 55 + nibble; }
    pos += 1;
    i -= 4;
  }
  hex[pos] := 0;
  return hex;
}

// ============================================================================
// BCrypt — via libcrypt.so.1 FFI (WP-1 security fix)
// Use HashBCryptStr / BCryptVerifyStr for production.
// ============================================================================

con BCRYPT_COST: int64 := 12;
con BCRYPT_SALT_LEN: int64 := 16;
con BCRYPT_HASH_LEN: int64 := 64;

fn bcrypt_b64(n: int64): int64 {
  if (n < 2)  { return 46 + n; }              // 0='.', 1='/'
  if (n < 28) { return 65 + n - 2; }          // 2-27 → 'A'-'Z'
  if (n < 54) { return 97 + n - 28; }         // 28-53 → 'a'-'z'
  return 48 + n - 54;                          // 54-63 → '0'-'9'
}

fn bcrypt_build_setting(randBuf: int64, cost: int64, out: int64) {
  poke8(out + 0, 36); poke8(out + 1, 50); poke8(out + 2, 98); poke8(out + 3, 36);
  poke8(out + 4, 48 + cost / 10);
  poke8(out + 5, 48 + cost % 10);
  poke8(out + 6, 36);
  var pos: int64 := 7;
  var i: int64 := 0;
  while (i < 5) {
    var off: int64 := i * 3;
    var b0: int64 := peek8(randBuf + off);
    var b1: int64 := peek8(randBuf + off + 1);
    var b2: int64 := peek8(randBuf + off + 2);
    poke8(out + pos,     bcrypt_b64(b0 >> 2));
    poke8(out + pos + 1, bcrypt_b64(((b0 & 3) << 4) | (b1 >> 4)));
    poke8(out + pos + 2, bcrypt_b64(((b1 & 15) << 2) | (b2 >> 6)));
    poke8(out + pos + 3, bcrypt_b64(b2 & 63));
    pos += 4;
    i += 1;
  }
  var b0: int64 := peek8(randBuf + 15);
  poke8(out + pos,     bcrypt_b64(b0 >> 2));
  poke8(out + pos + 1, bcrypt_b64((b0 & 3) << 4));
  poke8(out + pos + 2, 0);
}

pub fn HashBCryptStr(password: pchar, cost: int64, outBuf: int64): bool {
  if (cost < 4 || cost > 31) { cost := BCRYPT_COST; }
  var randBuf: int64 := alloc(16);
  if (!GenerateSaltBytes(randBuf, 16)) { free(randBuf, 16); return false; }
  var setting: int64 := alloc(32);
  bcrypt_build_setting(randBuf, cost, setting);
  free(randBuf, 16);
  var result: pchar := crypt(password, setting as pchar);
  free(setting, 32);
  if (result == 0) { return false; }
  var i: int64 := 0;
  while (i < 63) {
    var c: int64 := peek8(result as int64 + i);
    poke8(outBuf + i, c);
    if (c == 0) { break; }
    i += 1;
  }
  poke8(outBuf + i, 0);
  return true;
}

pub fn BCryptVerifyStr(password: pchar, stored: pchar): bool {
  var result: pchar := crypt(password, stored);
  if (result == 0) { return false; }
  var rlen: int64 := StrLen(result);
  var slen: int64 := StrLen(stored);
  if (rlen != slen) { return false; }
  return ConstantTimeCompareBytes(result as int64, stored as int64, rlen);
}

