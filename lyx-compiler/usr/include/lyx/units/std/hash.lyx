      k2 := k2 * CITY_K1;
      var k2x: int64 := k2 ^ (k2 >> 47); k2 := k2x * CITY_K1;
      var lenK: int64 := len * CITY_K1;
      return (k1 ^ k2 ^ lenK) & 0xFFFFFFFFFFFFFFFF;
    }

    var k1: int64 := 0;
    var k2: int64 := 0;
    var k3: int64 := 0;
    var i: int64 := 0;
    while (i < len) {
      var shift1: int64 := (i & 7) * 8;
      k1 := k1 ^ (StrCharAt(data, i) << shift1);
      var shift2: int64 := (i & 7) * 8;
      k2 := k2 ^ (StrCharAt(data, i + 8) << shift2);
      var i8b: int64 := i + 8; var i8bm: int64 := i8b & 15; var shift3: int64 := i8bm * 8;
      k3 := k3 ^ (StrCharAt(data, i) << shift3);
      i += 1;
    }
    k1 := k1 * CITY_K1;
    var k1x: int64 := k1 ^ (k1 >> 47); k1 := k1x * CITY_K1;
    k2 := k2 * CITY_K1;
    var k2x: int64 := k2 ^ (k2 >> 47); k2 := k2x * CITY_K1;
    k3 := k3 * CITY_K1;
    var k3x: int64 := k3 ^ (k3 >> 47); k3 := k3x * CITY_K1;
    var lenK: int64 := len * CITY_K1;
    var kxyz: int64 := k1 ^ k2 ^ k3;
    return kxyz + lenK;
  }

  var h1: int64 := len * CITY_K1;
  var h2: int64 := 0;
  var h3: int64 := 0;
  var h4: int64 := 0;
  var i: int64 := 0;

  while ((i + 32) <= len) {
    var k1: int64 := StrCharAt(data, i);
    k1 := k1 | (StrCharAt(data, i + 1) << 8);
    k1 := k1 | (StrCharAt(data, i + 2) << 16);
    k1 := k1 | (StrCharAt(data, i + 3) << 24);
    k1 := k1 | (StrCharAt(data, i + 4) << 32);
    k1 := k1 | (StrCharAt(data, i + 5) << 40);
    k1 := k1 | (StrCharAt(data, i + 6) << 48);
    k1 := k1 | (StrCharAt(data, i + 7) << 56);

    k1 := k1 * CITY_K1;
    var k1x: int64 := k1 ^ (k1 >> 47); k1 := k1x * CITY_K1;
    h1 := h1 ^ k1;
    h1 := (h1 << 31) | ((h1 >> 33) & 0x7FFFFFFF);
    h1 := h1 * CITY_K2;

    var k2: int64 := StrCharAt(data, i + 8);
    k2 := k2 | (StrCharAt(data, i + 9) << 8);
    k2 := k2 | (StrCharAt(data, i + 10) << 16);
    k2 := k2 | (StrCharAt(data, i + 11) << 24);
    k2 := k2 | (StrCharAt(data, i + 12) << 32);
    k2 := k2 | (StrCharAt(data, i + 13) << 40);
    k2 := k2 | (StrCharAt(data, i + 14) << 48);
    k2 := k2 | (StrCharAt(data, i + 15) << 56);

    k2 := k2 * CITY_K2;
    var k2x: int64 := k2 ^ (k2 >> 47); k2 := k2x * CITY_K2;
    h2 := h2 ^ k2;
    h2 := (h2 << 31) | ((h2 >> 33) & 0x7FFFFFFF);
    h2 := h2 * CITY_K2;

    i += 16;
  }

  h1 := h1 ^ h2;
  h2 := h2 ^ h3;
  h3 := h3 ^ h4;

  var lenK: int64 := len * CITY_K1;
  h1 := h1 ^ lenK;
  var h1x: int64 := h1 ^ (h1 >> 33); h1 := h1x * CITY_K2;
  h1 := h1 ^ (h1 >> 33);

  return (h1 ^ h2 ^ h3) & 0xFFFFFFFFFFFFFFFF;
}

pub fn HashCity64WithSeed(data: pchar, seed: int64): int64 {
  var h: int64 := HashCity64(data);
  var hs: int64 := h ^ seed; return hs * CITY_K1;
}

pub fn HashCity64Hex(data: pchar): pchar {
  var hash: int64 := HashCity64(data);
  var hex: pchar := "                                ";
  var pos: int64 := 0;
  var i: int64 := 60;
  while (i >= 0) {
    var nibble: int64 := (hash >> i) & 15;
    if (nibble < 10) { hex[pos] := 48 + nibble; } else { hex[pos] := 55 + nibble; }
    pos += 1;
    i -= 4;
  }
  hex[pos] := 0;
  return hex;
}

// ============================================================================
// FarmHash32
// ============================================================================

con FARM_C1: int64 := 0x1e35a7bd;
con FARM_C2: int64 := 0x9e3779b9;

pub fn HashFarm32(data: pchar): int64 {
  var len: int64 := StrLen(data);

  if (len <= 4) {
    var k1: int64 := 0;
    var k2: int64 := len;
    var i: int64 := 0;
    while (i < len) {
      var kc: int64 := StrCharAt(data, i) * FARM_C1;
      k2 += kc;
      k1 := k1 * FARM_C2;
      k1 := k1 + StrCharAt(data, i);
      i += 1;
    }
    k1 := k1 * FARM_C1;
    var k1x: int64 := k1 ^ (k1 >> 16);
    var k1xc: int64 := k1x * FARM_C2;
    return k1xc & 0xFFFFFFFF;
  }

  var h: int64 := len;
  var i: int64 := 0;

  while ((i + 4) <= len) {
    var k1: int64 := StrCharAt(data, i);
    k1 := k1 | (StrCharAt(data, i + 1) << 8);
    k1 := k1 | (StrCharAt(data, i + 2) << 16);
    k1 := k1 | (StrCharAt(data, i + 3) << 24);

    var k1m: int64 := k1 * FARM_C1; k1 := k1m & 0xFFFFFFFF;
    k1 := (k1 << 15) | ((k1 >> 17) & 32767);
    var hm: int64 := h * FARM_C2; h := hm & 0xFFFFFFFF;
    h := h ^ k1;
    h := (h << 13) | ((h >> 19) & 8191);
    var hsh2: int64 := h << 2;
    var hadd: int64 := h + hsh2;
    h := hadd & 0xFFFFFFFF;

    i += 4;
  }

  var k: int64 := 0;
  var tail: int64 := len & 3;

  if (tail >= 1) { k := k ^ StrCharAt(data, i); }
  if (tail >= 2) { k := k ^ (StrCharAt(data, i + 1) << 8); }
  if (tail >= 3) { k := k ^ (StrCharAt(data, i + 2) << 16); }

  var kc: int64 := k * FARM_C1;
  var kcr: int64 := kc >> 15;
  h := h ^ kcr;
  h := h * FARM_C2;
  h := h ^ (h >> 16);

  return h & 0xFFFFFFFF;
}

