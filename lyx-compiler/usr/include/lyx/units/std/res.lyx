// std/res.lyx — Zugriff auf eingebettete Ressourcen (#1961 Stufe 2)
//
// Das Gegenstueck zu Delphis `.res`: Dateien, die mit `@resource("name",
// "pfad")` uebersetzt wurden, sind hier UEBER IHREN NAMEN auffindbar.
//
//     @resource("splash", "assets/splash.lyxi");
//
//     var bild: pchar := ResFind("splash");
//     var n: int64    := ResLen("splash");
//
// Unterschied zu `@embed`: dort steht der Pfad im Quelltext und der Zugriff
// wird zur Uebersetzungszeit aufgeloest. Hier entsteht eine TABELLE im
// Erzeugnis, in der zur Laufzeit gesucht wird — das ist der Punkt, an dem
// Werkzeuge die Ressourcen auflisten koennen und an dem sich eine Ressource
// waehlen laesst, deren Name erst zur Laufzeit feststeht.
//
// Aufbau der Tabelle (alles int64, vom Codegen ausgelegt):
//
//   [0]              Anzahl der Eintraege
//   [1 + i*4 + 0]    Zeiger auf den Namen (NUL-terminiert)
//   [1 + i*4 + 1]    Laenge des Namens
//   [1 + i*4 + 2]    Zeiger auf die Bytes
//   [1 + i*4 + 3]    Anzahl der Bytes
//
// `GetResTable()` ist ein Builtin und liefert 0, wenn das Programm keine
// einzige `@resource`-Angabe traegt. Jede Funktion hier faengt diesen Fall ab.
//
// #1971: NAMEN. Eine Ressource aus einer importierten Unit (auch aus einer
// vorkompilierten `.lyu`) heisst in der Tabelle `unit:name` — mit dem Namen,
// unter dem die Unit importiert wurde, etwa `std.icons:logo`. Die eigenen
// Ressourcen des Programms stehen ohne Vorsatz da.
//
//     ResFind("std.icons:logo")   // immer eindeutig
//     ResFind("logo")             // der Kurzname: das Stueck nach dem ':'
//
// Der Kurzname ist erlaubt, solange er im Programm EINDEUTIG ist; bringen
// zwei Units denselben mit, bricht schon die Uebersetzung ab und nennt beide
// Herkuenfte. Zur Laufzeit gibt es deshalb hoechstens einen Treffer.

unit std.res;

// Anzahl der eingebetteten Ressourcen. 0, wenn keine vorhanden sind.
pub fn ResCount(): int64 {
  var t: int64 := GetResTable();
  if (t == 0) { return 0; }
  return peek64(t);
}

// Name der i-ten Ressource, oder der Nullzeiger bei ungueltigem Index.
//
// Der Index ist die Reihenfolge der `@resource`-Angaben im Quelltext. Er ist
// fuer das Auflisten gedacht; zum Suchen ist der NAME gemeint.
pub fn ResName(i: int64): pchar {
  var t: int64 := GetResTable();
  if (t == 0) { return 0 as pchar; }
  if (i < 0 || i >= peek64(t)) { return 0 as pchar; }
  return peek64(t + 8 + i * 32) as pchar;
}

// Bytes der i-ten Ressource, oder der Nullzeiger.
pub fn ResBytesAt(i: int64): pchar {
  var t: int64 := GetResTable();
  if (t == 0) { return 0 as pchar; }
  if (i < 0 || i >= peek64(t)) { return 0 as pchar; }
  return peek64(t + 8 + i * 32 + 16) as pchar;
}

// Groesse der i-ten Ressource in Byte, oder -1 bei ungueltigem Index.
//
// -1 und nicht 0: eine Ressource DARF leer sein, und 0 waere dann von
// "gibt es nicht" nicht zu unterscheiden.
pub fn ResSizeAt(i: int64): int64 {
  var t: int64 := GetResTable();
  if (t == 0) { return 0 - 1; }
  if (i < 0 || i >= peek64(t)) { return 0 - 1; }
  return peek64(t + 8 + i * 32 + 24);
}

// Gleicht `name` (Laenge nl) mit dem Ausschnitt [ab, ab+al) von `p` ab?
fn _resGleich(p: pchar, ab: int64, al: int64, name: pchar, nl: int64): int64 {
  if (al != nl) { return 0; }
  var j: int64 := 0;
  while (j < nl) {
    if (StrCharAt(p, ab + j) != StrCharAt(name, j)) { return 0; }
    j := j + 1;
  }
  return 1;
}

// Index der Ressource mit diesem Namen, oder -1.
//
// Zuerst der volle Name (`unit:name`). Traegt die Anfrage keinen ':', zaehlt
// auch der Kurzname eines Eintrags — das Stueck nach seinem letzten ':'.
pub fn ResIndex(name: pchar): int64 {
  var t: int64 := GetResTable();
  if (t == 0) { return 0 - 1; }
  if (name == 0 as pchar) { return 0 - 1; }
  var gesucht: int64 := StrLen(name);
  var n: int64 := peek64(t);
  var i: int64 := 0;
  while (i < n) {
    var eintrag: int64 := t + 8 + i * 32;
    if (_resGleich(peek64(eintrag) as pchar, 0, peek64(eintrag + 8), name, gesucht) != 0) { return i; }
    i := i + 1;
  }
  var k: int64 := 0;
  while (k < gesucht) {
    if (StrCharAt(name, k) == 58) { return 0 - 1; }   // ':' — nur voll gemeint
    k := k + 1;
  }
  i := 0;
  while (i < n) {
    var e2: int64 := t + 8 + i * 32;
    var p: pchar := peek64(e2) as pchar;
    var pl: int64 := peek64(e2 + 8);
    var ab: int64 := 0;
    var q: int64 := 0;
    while (q < pl) {
      if (StrCharAt(p, q) == 58) { ab := q + 1; }
      q := q + 1;
    }
    if (ab > 0) {
      if (_resGleich(p, ab, pl - ab, name, gesucht) != 0) { return i; }
    }
    i := i + 1;
  }
  return 0 - 1;
}

// Bytes der Ressource mit diesem Namen, oder der Nullzeiger.
//
// Der Nullzeiger heisst "gibt es nicht" und nichts anderes. Einen leeren
// Puffer zurueckzugeben waere die schlimmere Antwort: das Programm liefe
// weiter und zeigte nichts, ohne dass jemand den Grund saehe.
pub fn ResFind(name: pchar): pchar {
  var i: int64 := ResIndex(name);
  if (i < 0) { return 0 as pchar; }
  return ResBytesAt(i);
}

// Groesse der Ressource mit diesem Namen, oder -1.
pub fn ResLen(name: pchar): int64 {
  var i: int64 := ResIndex(name);
  if (i < 0) { return 0 - 1; }
  return ResSizeAt(i);
}
