// Lyx Network Library - Android Syscall Wrapper
// WP-AND-04
//
// On both ARM64 and x86_64, Android uses the SAME syscall numbers as upstream
// Linux. The wrappers in syscalls_linux already produce correct kernel calls
// when the binary runs on Bionic. This module re-exports them under
// Android-explicit names and adds stubs for the syscalls that Bionic / SELinux
// refuse to issue from app processes.
//
// Restrictions (subject to SELinux policy on a real device):
//   * fork / vfork           — discouraged; Bionic provides clone-based pthread
//   * personality            — blocked by SELinux on app domain
//   * ptrace                 — restricted to debuggable apps and Trace API
//   * acct, swapon/swapoff   — kernel-only on Android
//   * reboot                 — power-mgmt only, blocked for apps
//   * kexec_load, init_module — root-only
//
// Anything network-related from syscalls_linux works unchanged; we just give
// callers a clear "I targeted Android on purpose" import path.
@capabilities([network.tcp.bind, network.tcp.connect, network.udp.connect])

unit std.net.internal.syscalls_android;

import std.net.internal.types;

// ---------------------------------------------------------------------------
// Re-exported network syscalls (numbers identical to Linux).
// ---------------------------------------------------------------------------

pub fn sca_socket(domain: int64, socktype: int64, protocol: int64): int64 {
  return sys_socket(domain, socktype, protocol);
}

pub fn sca_bind(sockfd: int64, addr: int64, addrlen: int64): int64 {
  return sys_bind(sockfd, addr, addrlen);
}

pub fn sca_listen(sockfd: int64, backlog: int64): int64 {
  return sys_listen(sockfd, backlog);
}

pub fn sca_accept(sockfd: int64, addr: int64, addrlen: int64): int64 {
  return sys_accept(sockfd, addr, addrlen);
}

pub fn sca_connect(sockfd: int64, addr: int64, addrlen: int64): int64 {
  return sys_connect(sockfd, addr, addrlen);
}

pub fn sca_recvfrom(sockfd: int64, buf: int64, len: int64, flags: int64, src_addr: int64, addrlen: int64): int64 {
  return sys_recvfrom(sockfd, buf, len, flags, src_addr, addrlen);
}

pub fn sca_sendto(sockfd: int64, buf: int64, len: int64, flags: int64, dest_addr: int64, addrlen: int64): int64 {
  return sys_sendto(sockfd, buf, len, flags, dest_addr, addrlen);
}

pub fn sca_close(sockfd: int64): int64 {
  return sys_close(sockfd);
}

pub fn sca_setsockopt(sockfd: int64, level: int64, optname: int64, optval: int64, optlen: int64): int64 {
  return sys_setsockopt(sockfd, level, optname, optval, optlen);
}

pub fn sca_getsockopt(sockfd: int64, level: int64, optname: int64, optval: int64, optlen: int64): int64 {
  return sys_getsockopt(sockfd, level, optname, optval, optlen);
}

pub fn sca_set_nonblock(sockfd: int64): int64 {
  var flags: int64 := sys_fcntl(sockfd, F_GETFL, 0);
  if (flags < 0) {
    return flags;
  }
  var newflags: int64 := flags | O_NONBLOCK;
  return sys_fcntl(sockfd, F_SETFL, newflags);
}

pub fn sca_shutdown(sockfd: int64, how: int64): int64 {
  return sys_shutdown(sockfd, how);
}

// ---------------------------------------------------------------------------
// Restricted-syscall stubs. These return -1 (ENOSYS-style) immediately rather
// than invoking the kernel. SELinux on a real device would have killed the
// process anyway; preferring an explicit failure makes the bug obvious in
// userland logs.
// ---------------------------------------------------------------------------

pub fn sca_fork_unsupported(): int64 {
  // Bionic strongly discourages fork from app processes. Use pthread / clone
  // semantics via std/thread instead.
  return -1;
}

pub fn sca_vfork_unsupported(): int64 {
  return -1;
}

pub fn sca_ptrace_unsupported(): int64 {
  // Ptrace is blocked on non-debuggable app processes. Use Android Trace API
  // or systrace from the host instead.
  return -1;
}

pub fn sca_personality_unsupported(): int64 {
  // personality() is blocked by SELinux on the app domain.
  return -1;
}

pub fn sca_reboot_unsupported(): int64 {
  // reboot() is reserved for the power-management daemon.
  return -1;
}
