// std/net/udp.lyx — Pure UDP header builder
//
// Kernel-safe: no imports, no syscalls, no dynamic allocation.
// All functions operate on caller-provided buffers.
//
// Public API:
//   UdpBuildHeader(buf, src_port, dst_port, payload_len) → int64 (8)
//
// Wire layout (8 bytes, RFC 768):
//   0-1  source port (big-endian)
//   2-3  destination port (big-endian)
//   4-5  length = 8 + payload_len (big-endian)
//   6-7  checksum (0 = disabled, valid for IPv4 UDP)

unit std.net.udp;

pub con UDP_HDR_SIZE: int64 := 8;

// Common UDP port numbers
pub con UDP_PORT_DHCP_SERVER: int64 := 67;
pub con UDP_PORT_DHCP_CLIENT: int64 := 68;
pub con UDP_PORT_DNS:         int64 := 53;
pub con UDP_PORT_NTP:         int64 := 123;

// UdpBuildHeader: writes an 8-byte UDP header into buf.
// src_port, dst_port: host byte order (0–65535).
// payload_len: length of data following the UDP header.
// Checksum is set to 0 (disabled; valid for IPv4 per RFC 768).
// Returns: bytes written (8 = UDP_HDR_SIZE).
pub fn UdpBuildHeader(buf: int64, src_port: int64, dst_port: int64, payload_len: int64): int64 {
    var udp_len: int64 := UDP_HDR_SIZE + payload_len;
    poke8(buf+0, (src_port >> 8) & 0xFF);
    poke8(buf+1, src_port & 0xFF);
    poke8(buf+2, (dst_port >> 8) & 0xFF);
    poke8(buf+3, dst_port & 0xFF);
    poke8(buf+4, (udp_len >> 8) & 0xFF);
    poke8(buf+5, udp_len & 0xFF);
    poke8(buf+6, 0);  // checksum disabled
    poke8(buf+7, 0);
    return UDP_HDR_SIZE;
}

// UdpReadSrcPort: reads source port (big-endian) from a received UDP segment.
pub fn UdpReadSrcPort(buf: int64): int64 {
    return ((peek8(buf+0) & 0xFF) << 8) | (peek8(buf+1) & 0xFF);
}

// UdpReadDstPort: reads destination port (big-endian) from a received UDP segment.
pub fn UdpReadDstPort(buf: int64): int64 {
    return ((peek8(buf+2) & 0xFF) << 8) | (peek8(buf+3) & 0xFF);
}

// UdpReadLength: reads UDP length field from a received UDP segment.
pub fn UdpReadLength(buf: int64): int64 {
    return ((peek8(buf+4) & 0xFF) << 8) | (peek8(buf+5) & 0xFF);
}
