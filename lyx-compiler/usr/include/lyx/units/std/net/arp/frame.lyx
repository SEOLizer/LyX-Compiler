// std/net/arp/frame.lyx — Pure ARP frame builder and parser (RFC 826)
//
// Kernel-safe: no imports, no syscalls, no dynamic allocation.
// All functions operate on caller-provided buffers.
//
// This unit contains the pure frame-manipulation subset of std.net.arp.
// For POSIX ARP cache lookup (SIOCGARP ioctl), use std.net.arp instead.
//
// Public API:
//   ArpBuildRequest(buf, srcMac, srcIP, dstIP)            → int64 (42)
//   ArpBuildReply(buf, srcMac, srcIP, dstMac, dstIP)      → int64 (42)
//   ArpParse(buf, len, result)
//
// Result struct (ARP_RESULT_SIZE = 48 bytes):
//   ARP_RESULT_SENDER_IP  +0   sender IP  (packed, big-endian)
//   ARP_RESULT_SENDER_MAC +8   sender MAC (6 bytes at +8..+13)
//   ARP_RESULT_TARGET_IP  +16  target IP
//   ARP_RESULT_TARGET_MAC +24  target MAC (6 bytes at +24..+29)
//   ARP_RESULT_OP         +32  operation code (1=request, 2=reply)
//   ARP_RESULT_OK         +40  1 = valid ARP frame
//
// ARP frame wire layout (42 bytes total, all multi-byte fields big-endian):
//   Ethernet header (bytes 0-13):
//     0-5   dst MAC
//     6-11  src MAC
//     12-13 EtherType = 0x0806
//   ARP payload (bytes 14-41):
//     14-15 hardware type = 0x0001 (Ethernet)
//     16-17 protocol type = 0x0800 (IPv4)
//     18    hardware addr length = 6
//     19    protocol addr length = 4
//     20-21 operation (1=REQUEST, 2=REPLY)
//     22-27 sender hardware addr (MAC)
//     28-31 sender protocol addr (IP)
//     32-37 target hardware addr (MAC)
//     38-41 target protocol addr (IP)

unit std.net.arp.frame;

// ── Frame field offsets ───────────────────────────────────────────────────────
pub con ARP_ETH_DST:       int64 := 0;   // 6 bytes: ethernet destination MAC
pub con ARP_ETH_SRC:       int64 := 6;   // 6 bytes: ethernet source MAC
pub con ARP_ETH_TYPE:      int64 := 12;  // 2 bytes: EtherType (0x0806)
pub con ARP_HRD:           int64 := 14;  // 2 bytes: hardware type
pub con ARP_PRO:           int64 := 16;  // 2 bytes: protocol type
pub con ARP_HLEN:          int64 := 18;  // 1 byte:  hardware addr length
pub con ARP_PLEN:          int64 := 19;  // 1 byte:  protocol addr length
pub con ARP_OP:            int64 := 20;  // 2 bytes: operation code
pub con ARP_SHA:           int64 := 22;  // 6 bytes: sender hardware addr
pub con ARP_SIP:           int64 := 28;  // 4 bytes: sender IP
pub con ARP_THA:           int64 := 32;  // 6 bytes: target hardware addr
pub con ARP_TIP:           int64 := 38;  // 4 bytes: target IP
pub con ARP_FRAME_SIZE:    int64 := 42;

// ── Operation codes ───────────────────────────────────────────────────────────
pub con ARP_OP_REQUEST:    int64 := 1;
pub con ARP_OP_REPLY:      int64 := 2;
pub con ARP_OP_RREQUEST:   int64 := 3;   // Reverse ARP request
pub con ARP_OP_RREPLY:     int64 := 4;   // Reverse ARP reply

// ── Wire constants ────────────────────────────────────────────────────────────
pub con ARP_HTYPE_ETHER:   int64 := 1;    // hardware type = Ethernet
pub con ARP_PROTO_IPV4:    int64 := 2048; // protocol type = IPv4 (0x0800)
pub con ARP_ETYPE_B0:      int64 := 8;    // EtherType high byte (0x08)
pub con ARP_ETYPE_B1:      int64 := 6;    // EtherType low byte  (0x06)

// ── Result struct offsets (48 bytes) ─────────────────────────────────────────
pub con ARP_RESULT_SENDER_IP:  int64 := 0;
pub con ARP_RESULT_SENDER_MAC: int64 := 8;
pub con ARP_RESULT_TARGET_IP:  int64 := 16;
pub con ARP_RESULT_TARGET_MAC: int64 := 24;
pub con ARP_RESULT_OP:         int64 := 32;
pub con ARP_RESULT_OK:         int64 := 40;
pub con ARP_RESULT_SIZE:       int64 := 48;

// ── Private helpers ───────────────────────────────────────────────────────────

fn arpfZero(buf: int64, size: int64) {
    var i: int64 := 0;
    while i < size { poke8(buf + i, 0); i := i + 1; }
}

fn arpfCopyMac(dst: int64, src: int64) {
    var i: int64 := 0;
    while i < 6 { poke8(dst + i, peek8(src + i)); i := i + 1; }
}

fn arpfWrite16BE(buf: int64, off: int64, val: int64) {
    poke8(buf + off,     (val >> 8) & 255);
    poke8(buf + off + 1, val & 255);
}

fn arpfRead16BE(buf: int64, off: int64): int64 {
    return ((peek8(buf + off) & 255) << 8) | (peek8(buf + off + 1) & 255);
}

fn arpfWrite32BE(buf: int64, off: int64, val: int64) {
    poke8(buf + off,     (val >> 24) & 255);
    poke8(buf + off + 1, (val >> 16) & 255);
    poke8(buf + off + 2, (val >> 8)  & 255);
    poke8(buf + off + 3, val & 255);
}

fn arpfRead32BE(buf: int64, off: int64): int64 {
    var b0: int64 := peek8(buf + off)     & 255;
    var b1: int64 := peek8(buf + off + 1) & 255;
    var b2: int64 := peek8(buf + off + 2) & 255;
    var b3: int64 := peek8(buf + off + 3) & 255;
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}

// ── Public API ────────────────────────────────────────────────────────────────

// ArpBuildRequest: writes a complete ARP REQUEST frame (Ethernet + ARP) into buf.
// buf must be >= ARP_FRAME_SIZE (42) bytes.
// Ethernet destination = ff:ff:ff:ff:ff:ff (broadcast).
// srcMac: pointer to 6-byte sender MAC.
// srcIP, dstIP: packed IPv4 (big-endian, e.g. (192<<24)|(168<<16)|(1<<8)|1).
// Returns ARP_FRAME_SIZE (42).
pub fn ArpBuildRequest(buf: int64, srcMac: int64, srcIP: int64, dstIP: int64): int64 {
    arpfZero(buf, ARP_FRAME_SIZE);
    poke8(buf,     255); poke8(buf + 1, 255); poke8(buf + 2, 255);
    poke8(buf + 3, 255); poke8(buf + 4, 255); poke8(buf + 5, 255);
    arpfCopyMac(buf + ARP_ETH_SRC, srcMac);
    poke8(buf + ARP_ETH_TYPE,     ARP_ETYPE_B0);
    poke8(buf + ARP_ETH_TYPE + 1, ARP_ETYPE_B1);
    arpfWrite16BE(buf, ARP_HRD, ARP_HTYPE_ETHER);
    arpfWrite16BE(buf, ARP_PRO, ARP_PROTO_IPV4);
    poke8(buf + ARP_HLEN, 6);
    poke8(buf + ARP_PLEN, 4);
    arpfWrite16BE(buf, ARP_OP, ARP_OP_REQUEST);
    arpfCopyMac(buf + ARP_SHA, srcMac);
    arpfWrite32BE(buf, ARP_SIP, srcIP);
    arpfWrite32BE(buf, ARP_TIP, dstIP);
    return ARP_FRAME_SIZE;
}

// ArpBuildReply: writes a complete ARP REPLY frame into buf.
// srcMac/srcIP: replying host (us). dstMac/dstIP: original requester.
// Returns ARP_FRAME_SIZE (42).
pub fn ArpBuildReply(buf: int64, srcMac: int64, srcIP: int64, dstMac: int64, dstIP: int64): int64 {
    arpfZero(buf, ARP_FRAME_SIZE);
    arpfCopyMac(buf + ARP_ETH_DST, dstMac);
    arpfCopyMac(buf + ARP_ETH_SRC, srcMac);
    poke8(buf + ARP_ETH_TYPE,     ARP_ETYPE_B0);
    poke8(buf + ARP_ETH_TYPE + 1, ARP_ETYPE_B1);
    arpfWrite16BE(buf, ARP_HRD, ARP_HTYPE_ETHER);
    arpfWrite16BE(buf, ARP_PRO, ARP_PROTO_IPV4);
    poke8(buf + ARP_HLEN, 6);
    poke8(buf + ARP_PLEN, 4);
    arpfWrite16BE(buf, ARP_OP, ARP_OP_REPLY);
    arpfCopyMac(buf + ARP_SHA, srcMac);
    arpfWrite32BE(buf, ARP_SIP, srcIP);
    arpfCopyMac(buf + ARP_THA, dstMac);
    arpfWrite32BE(buf, ARP_TIP, dstIP);
    return ARP_FRAME_SIZE;
}

// ArpParse: parses a raw ARP frame (full Ethernet+ARP, ARP_FRAME_SIZE bytes).
// result: pointer to ARP_RESULT_SIZE zeroed bytes (caller must zero it first).
// Sets ARP_RESULT_OK=1 if EtherType=0x0806, hlen=6, plen=4.
pub fn ArpParse(buf: int64, len: int64, result: int64) {
    poke64(result + ARP_RESULT_OK, 0);
    if len < ARP_FRAME_SIZE { return; }
    if (peek8(buf + ARP_ETH_TYPE)     & 255) != ARP_ETYPE_B0 { return; }
    if (peek8(buf + ARP_ETH_TYPE + 1) & 255) != ARP_ETYPE_B1 { return; }
    if (peek8(buf + ARP_HLEN) & 255) != 6 { return; }
    if (peek8(buf + ARP_PLEN) & 255) != 4 { return; }
    poke64(result + ARP_RESULT_SENDER_IP,  arpfRead32BE(buf, ARP_SIP));
    poke64(result + ARP_RESULT_TARGET_IP,  arpfRead32BE(buf, ARP_TIP));
    arpfCopyMac(result + ARP_RESULT_SENDER_MAC, buf + ARP_SHA);
    arpfCopyMac(result + ARP_RESULT_TARGET_MAC, buf + ARP_THA);
    poke64(result + ARP_RESULT_OP, arpfRead16BE(buf, ARP_OP));
    poke64(result + ARP_RESULT_OK, 1);
}
