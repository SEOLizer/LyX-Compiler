// Create a new IPv6 TCP socket.  Returns fd >= 0 on success, < 0 on error.
pub fn SocketNewV6(): int64 {
  return sys_socket(AF_INET6, SOCK_STREAM, IPPROTO_TCP);
}

// Bind fd to an IPv6 address and port.
// ip6Hi / ip6Lo: IPv6 address as high/low int64 halves (use IPv6MakeHi/Lo or
//   IPv6AnyHi/Lo, IPv6LoopbackHi/Lo from std/net/types).
// port: host byte order.  Returns 0 on success, negative on error.
pub fn BindV6(fd: int64, ip6Hi: int64, ip6Lo: int64, port: int64): int64 {
  var addr: int64 := mmap(0, 28, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (addr <= 0) { return -1; }
  SockAddrIn6Create(addr, ip6Hi, ip6Lo, port);
  var r: int64 := sys_bind(fd, addr, 28);
  munmap(addr, 28);
  return r;
}

// Connect fd to an IPv6 peer.
// Returns 0 on success, negative on error.
pub fn ConnectV6(fd: int64, ip6Hi: int64, ip6Lo: int64, port: int64): int64 {
  var addr: int64 := mmap(0, 28, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (addr <= 0) { return -1; }
  SockAddrIn6Create(addr, ip6Hi, ip6Lo, port);
  var r: int64 := sys_connect(fd, addr, 28);
  munmap(addr, 28);
  return r;
}

