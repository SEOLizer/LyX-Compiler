// Create a new IPv6 UDP socket
pub fn UDPSocketNewIPv6(): UDPSocket {
  var sock: UDPSocket;
  var fd: int64;

  fd := sys_socket(AF_INET6, SOCK_DGRAM, IPPROTO_UDP);
  if (fd < 0) {
    sock.fd := -1;
    return sock;
  }

  sock.fd := fd;
  return sock;
}

// Send a UDP datagram to an IPv6 address.
// ip6Hi / ip6Lo: destination IPv6 address (use IPv6Hi/IPv6Lo)
// port: destination port in host byte order
pub fn UDPSocketSendToIPv6(sock: UDPSocket, buf: int64, n: int64,
                            ip6Hi: int64, ip6Lo: int64, port: int64): int64 {
  var addr: int64;
  var ret: int64;

  addr := mmap(0, 28, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (addr <= 0) {
    return -1;
  }

  SockAddrIn6Create(addr, ip6Hi, ip6Lo, port);
  ret := sys_sendto(sock.fd, buf, n, 0, addr, 28);
  munmap(addr, 28);
  return ret;
}

// Bind an IPv6 UDP socket to a port (for receiving)
pub fn UDPSocketBindIPv6(sock: UDPSocket, ip6Hi: int64, ip6Lo: int64, port: int64): int64 {
  var addr: int64;
  var ret: int64;

  addr := mmap(0, 28, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (addr <= 0) {
    return -1;
  }

  SockAddrIn6Create(addr, ip6Hi, ip6Lo, port);
  ret := sys_bind(sock.fd, addr, 28);
  munmap(addr, 28);
  return ret;
}

