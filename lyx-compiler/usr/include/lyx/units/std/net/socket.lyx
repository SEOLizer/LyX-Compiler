// Set SO_REUSEADDR on UDP socket
pub fn UDPSocketSetReuseAddr(sock: UDPSocket): int64 {
  return sockSetzeInt(sock.fd, SOL_SOCKET, SO_REUSEADDR, 1);
}

// #1611: SO_BROADCAST fehlte ganz — ohne die Option weist der Kernel jeden
// Versand an eine Rundrufadresse mit EACCES ab.
pub fn UDPSocketSetBroadcast(sock: UDPSocket, an: bool): int64 {
  var wert: int64 := 0;
  if (an) { wert := 1; }
  return sockSetzeInt(sock.fd, SOL_SOCKET, SO_BROADCAST, wert);
}

// Set socket receive buffer size
pub fn UDPSocketSetRecvBuf(sock: UDPSocket, size: int64): int64 {
  return sockSetzeInt(sock.fd, SOL_SOCKET, SO_RCVBUF, size);
}

// Set socket send buffer size
pub fn UDPSocketSetSendBuf(sock: UDPSocket, size: int64): int64 {
  return sockSetzeInt(sock.fd, SOL_SOCKET, SO_SNDBUF, size);
}

// #1641: Empfangs-Zeitlimit setzen. Ohne eines blockiert UDPSocketRecv
// unbegrenzt — bei UDP ist eine ausbleibende Antwort der Normalfall, es gibt
// keine Verbindung, die abbricht. Ein verworfenes Paket haengte damit den
// ganzen Aufrufer auf.
//
// SO_RCVTIMEO nimmt eine `timeval`: zwei 64-Bit-Werte, Sekunden und
// Mikrosekunden. sockSetzeInt schreibt nur 4 Byte und taugt hier nicht.
// Rueckgabe 0 bei Erfolg, sonst der negative Fehlercode.
pub fn UDPSocketSetRecvTimeout(sock: UDPSocket, sek: int64, mikrosek: int64): int64 {
  var tv: int64 := BufferAlloc(16);
  if (tv == 0) { return 0 - 12; }          // ENOMEM
  poke64(tv, sek);
  poke64(tv + 8, mikrosek);
  var rc: int64 := sys_setsockopt(sock.fd, SOL_SOCKET, SO_RCVTIMEO, tv, 16);
  BufferFree(tv, 16);
  return rc;
}

// #1641: dasselbe fuer das Senden.
pub fn UDPSocketSetSendTimeout(sock: UDPSocket, sek: int64, mikrosek: int64): int64 {
  var tv: int64 := BufferAlloc(16);
  if (tv == 0) { return 0 - 12; }
  poke64(tv, sek);
  poke64(tv + 8, mikrosek);
  var rc: int64 := sys_setsockopt(sock.fd, SOL_SOCKET, SO_SNDTIMEO, tv, 16);
  BufferFree(tv, 16);
  return rc;
}

// Get socket error status
pub fn UDPSocketGetError(sock: UDPSocket): int64 {
  // #1611: siehe TCPConnGetError — der Wert statt der Adresse.
  return sockHoleInt(sock.fd, SOL_SOCKET, SO_ERROR);
}

