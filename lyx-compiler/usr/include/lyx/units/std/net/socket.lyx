// ── sockaddr_in6 Lese-Helfer ────────────────────────────────────────────────
// Lesen des IPv6-High-Halts aus einem 28-Byte sockaddr_in6-Puffer.
// Layout: [0..1]=family [2..3]=port(BE) [4..7]=flowinfo [8..15]=addr_hi [16..23]=addr_lo [24..27]=scope
fn sockAddrIn6ReadHi(addr: int64): int64 {
  return ((peek8(addr +  8) & 0xFF) << 56) | ((peek8(addr +  9) & 0xFF) << 48) |
         ((peek8(addr + 10) & 0xFF) << 40) | ((peek8(addr + 11) & 0xFF) << 32) |
         ((peek8(addr + 12) & 0xFF) << 24) | ((peek8(addr + 13) & 0xFF) << 16) |
         ((peek8(addr + 14) & 0xFF) <<  8) |  (peek8(addr + 15) & 0xFF);
}

fn sockAddrIn6ReadLo(addr: int64): int64 {
  return ((peek8(addr + 16) & 0xFF) << 56) | ((peek8(addr + 17) & 0xFF) << 48) |
         ((peek8(addr + 18) & 0xFF) << 40) | ((peek8(addr + 19) & 0xFF) << 32) |
         ((peek8(addr + 20) & 0xFF) << 24) | ((peek8(addr + 21) & 0xFF) << 16) |
         ((peek8(addr + 22) & 0xFF) <<  8) |  (peek8(addr + 23) & 0xFF);
}

fn sockAddrIn6ReadPort(addr: int64): int64 {
  return ((peek8(addr + 2) & 0xFF) << 8) | (peek8(addr + 3) & 0xFF);
}

// TCPListenerAcceptIPv6: Akzeptiert eine eingehende IPv6-Verbindung.
// outHi / outLo / outPort: Zeiger auf int64 (oder 0 wenn nicht benötigt).
// Gibt eine TCPConn zurück; conn.fd < 0 bei Fehler.
pub fn TCPListenerAcceptIPv6(listener: TCPListener,
                              outHi: int64, outLo: int64, outPort: int64): TCPConn {
  var conn: TCPConn;
  conn.fd := -1;
  var addr: int64 := mmap(0, 28, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (addr <= 0) { return conn; }
  var lenBuf: int64 := mmap(0, 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (lenBuf <= 0) { munmap(addr, 28); return conn; }
  poke32(lenBuf, 28);
  var fd: int64 := sys_accept(listener.fd, addr, lenBuf);
  if (fd >= 0) {
    conn.fd := fd;
    if (outHi   != 0) { poke64(outHi,   sockAddrIn6ReadHi(addr));   }
    if (outLo   != 0) { poke64(outLo,   sockAddrIn6ReadLo(addr));   }
    if (outPort != 0) { poke64(outPort, sockAddrIn6ReadPort(addr)); }
  }
  munmap(lenBuf, 8);
  munmap(addr, 28);
  return conn;
}

// UDPSocketRecvFromIPv6: Empfängt ein UDP-Datagramm und liefert die IPv6-Absenderadresse.
// outHi / outLo / outPort: Zeiger auf int64 (oder 0).
// Gibt empfangene Byte-Anzahl zurück (< 0 bei Fehler).
pub fn UDPSocketRecvFromIPv6(sock: UDPSocket, buf: int64, n: int64,
                              outHi: int64, outLo: int64, outPort: int64): int64 {
  var addr: int64 := mmap(0, 28, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (addr <= 0) { return -1; }
  var lenBuf: int64 := mmap(0, 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (lenBuf <= 0) { munmap(addr, 28); return -1; }
  poke32(lenBuf, 28);
  var r: int64 := sys_recvfrom(sock.fd, buf, n, 0, addr, lenBuf);
  if (r >= 0) {
    if (outHi   != 0) { poke64(outHi,   sockAddrIn6ReadHi(addr));   }
    if (outLo   != 0) { poke64(outLo,   sockAddrIn6ReadLo(addr));   }
    if (outPort != 0) { poke64(outPort, sockAddrIn6ReadPort(addr)); }
  }
  munmap(lenBuf, 8);
  munmap(addr, 28);
  return r;
}

// SocketGetPeerAddrIPv6: liest die Remote-IPv6-Adresse einer verbundenen Verbindung.
// outHi / outLo / outPort: Zeiger auf int64 (oder 0).
// Gibt 0 bei Erfolg zurück, negativ bei Fehler.
pub fn SocketGetPeerAddrIPv6(fd: int64,
                              outHi: int64, outLo: int64, outPort: int64): int64 {
  var addr: int64 := mmap(0, 28, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (addr <= 0) { return -1; }
  var lenBuf: int64 := mmap(0, 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (lenBuf <= 0) { munmap(addr, 28); return -1; }
  poke32(lenBuf, 28);
  var r: int64 := sys_getpeername(fd, addr, lenBuf);
  if (r == 0) {
    if (outHi   != 0) { poke64(outHi,   sockAddrIn6ReadHi(addr));   }
    if (outLo   != 0) { poke64(outLo,   sockAddrIn6ReadLo(addr));   }
    if (outPort != 0) { poke64(outPort, sockAddrIn6ReadPort(addr)); }
  }
  munmap(lenBuf, 8);
  munmap(addr, 28);
  return r;
}

// SocketGetOwnAddrIPv6: liest die eigene lokale IPv6-Adresse des Sockets.
pub fn SocketGetOwnAddrIPv6(fd: int64,
                             outHi: int64, outLo: int64, outPort: int64): int64 {
  var addr: int64 := mmap(0, 28, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (addr <= 0) { return -1; }
  var lenBuf: int64 := mmap(0, 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (lenBuf <= 0) { munmap(addr, 28); return -1; }
  poke32(lenBuf, 28);
  var r: int64 := sys_getsockname(fd, addr, lenBuf);
  if (r == 0) {
    if (outHi   != 0) { poke64(outHi,   sockAddrIn6ReadHi(addr));   }
    if (outLo   != 0) { poke64(outLo,   sockAddrIn6ReadLo(addr));   }
    if (outPort != 0) { poke64(outPort, sockAddrIn6ReadPort(addr)); }
  }
  munmap(lenBuf, 8);
  munmap(addr, 28);
  return r;
}

// ============================================================================
// WP-6: Netzwerk-Ergänzungen — Konstanten zuerst (Lyx: kein Forward-Lookup)
// ============================================================================

// Socket-Flags für accept4 / socket
pub con SOCK_NONBLOCK: int64 := 2048;    // 0x800
pub con SOCK_CLOEXEC:  int64 := 524288;  // 0x80000

// sockaddr-Puffer-Größen
pub con SOCKADDR_IN_SIZE:  int64 := 16;
pub con SOCKADDR_IN6_SIZE: int64 := 28;
pub con SOCKADDR_MAX_SIZE: int64 := 128;

// mmsghdr-Struktur (x86-64, 64 Bytes)
pub con MMSGHDR_SIZE:  int64 := 64;
pub con MSGHDR_SIZE:   int64 := 56;
pub con IOVEC_SIZE_MM: int64 := 16;  // { iov_base:8, iov_len:8 }

// SocketGetOwnAddr: liest die eigene (lokale) Adresse des Sockets.
// addrBuf: alloc(SOCKADDR_IN_SIZE), addrLen: Puffergröße.
pub fn SocketGetOwnAddr(fd: int64, addrBuf: int64, addrLen: int64): int64 {
  var lenBuf: int64 := mmap(0, 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (lenBuf <= 0) { return -1; }
  poke32(lenBuf, addrLen);
  var r: int64 := sys_getsockname(fd, addrBuf, lenBuf);
  munmap(lenBuf, 8);
  return r;
}

// SocketGetPeerAddr: liest die Remote-Adresse einer verbundenen Verbindung.
pub fn SocketGetPeerAddr(fd: int64, addrBuf: int64, addrLen: int64): int64 {
  var lenBuf: int64 := mmap(0, 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (lenBuf <= 0) { return -1; }
  poke32(lenBuf, addrLen);
  var r: int64 := sys_getpeername(fd, addrBuf, lenBuf);
  munmap(lenBuf, 8);
  return r;
}

// AcceptNonBlocking: akzeptiert eine Verbindung nicht-blockierend (SOCK_NONBLOCK|SOCK_CLOEXEC).
// Gibt neuen fd zurück; bei keiner wartenden Verbindung: -EAGAIN (-11).
pub fn AcceptNonBlocking(fd: int64, addrBuf: int64, addrLen: int64): int64 {
  var lenBuf: int64 := mmap(0, 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (lenBuf <= 0) { return -1; }
  poke32(lenBuf, addrLen);
  var r: int64 := sys_accept4(fd, addrBuf, lenBuf, SOCK_NONBLOCK | SOCK_CLOEXEC);
  munmap(lenBuf, 8);
  return r;
}

// AcceptBlocking: akzeptiert eine Verbindung blockierend (mit SOCK_CLOEXEC).
pub fn AcceptBlocking(fd: int64, addrBuf: int64, addrLen: int64): int64 {
  var lenBuf: int64 := mmap(0, 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (lenBuf <= 0) { return -1; }
  poke32(lenBuf, addrLen);
  var r: int64 := sys_accept4(fd, addrBuf, lenBuf, SOCK_CLOEXEC);
  munmap(lenBuf, 8);
  return r;
}

// ============================================================================
// mmsghdr-Helfer für sendmmsg / recvmmsg (Batch-I/O)
// ============================================================================

// MmsgAlloc: alloziert vec + iov-Array (je vlen Einträge).
// iovOut: alloc(8)-Buffer, erhält den iov-Zeiger.
// Gibt den vec-Zeiger zurück (0 bei Fehler).
pub fn MmsgAlloc(vlen: int64, iovOut: int64): int64 {
  var vec: int64 := mmap(0, MMSGHDR_SIZE * vlen, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (vec <= 0) { poke64(iovOut, 0); return 0; }
  var iov: int64 := mmap(0, IOVEC_SIZE_MM * vlen, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (iov <= 0) {
    munmap(vec, MMSGHDR_SIZE * vlen);
    poke64(iovOut, 0);
    return 0;
  }
  var i: int64 := 0;
  while (i < vlen) {
    var hdr: int64 := vec + i * MMSGHDR_SIZE;
    poke64(hdr,      0);                        // msg_name = NULL
    poke32(hdr + 8,  0);                        // msg_namelen = 0
    poke64(hdr + 16, iov + i * IOVEC_SIZE_MM);  // msg_iov
    poke64(hdr + 24, 1);                        // msg_iovlen = 1
    poke64(hdr + 32, 0);                        // msg_control = NULL
    poke64(hdr + 40, 0);                        // msg_controllen = 0
    poke32(hdr + 48, 0);                        // msg_flags = 0
    poke32(hdr + 56, 0);                        // msg_len = 0
    i += 1;
  }
  poke64(iovOut, iov);
  return vec;
}

// MmsgFree: gibt vec und iov frei.
pub fn MmsgFree(vec: int64, iov: int64, vlen: int64) {
  if (vec != 0) { munmap(vec, MMSGHDR_SIZE * vlen); }
  if (iov != 0) { munmap(iov, IOVEC_SIZE_MM * vlen); }
}

// MmsgSetBuf: setzt den Datenpuffer für Eintrag idx.
pub fn MmsgSetBuf(iov: int64, idx: int64, buf: int64, bufLen: int64) {
  var base: int64 := iov + idx * IOVEC_SIZE_MM;
  poke64(base,     buf);
  poke64(base + 8, bufLen);
}

// MmsgGetLen: liest die empfangene Byte-Anzahl aus mmsghdr[idx].msg_len.
pub fn MmsgGetLen(vec: int64, idx: int64): int64 {
  return peek64(vec + idx * MMSGHDR_SIZE + 56) & 4294967295;
}

// SendMmsg: sendet vlen Nachrichten in einem Syscall (Batch-Send).
pub fn SendMmsg(fd: int64, vec: int64, vlen: int64, flags: int64): int64 {
  return sys_sendmmsg(fd, vec, vlen, flags);
}

// RecvMmsg: empfängt bis zu vlen Nachrichten in einem Syscall (Batch-Receive).
pub fn RecvMmsg(fd: int64, vec: int64, vlen: int64, flags: int64): int64 {
  return sys_recvmmsg(fd, vec, vlen, flags, 0);
}
