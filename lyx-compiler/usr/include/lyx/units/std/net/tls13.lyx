// std/net/tls13.lyx — TLS 1.3 (RFC 8446) in Lyx, ohne OpenSSL, ohne FFI
//
// Teil von #2096. std/net/tls.lyx bleibt als OpenSSL-Wrapper daneben stehen;
// diese Unit kommt ohne Fremdbibliothek aus und laeuft damit auch unter
// --target=lyxos.
//
// Die Unit macht KEINE Ein-/Ausgabe. Sie bekommt empfangene Byte gefuettert
// und gibt zu sendende Byte heraus:
//
//   var c: int64 := TlsNeu(cfg);
//   // Schleife mit epoll:
//   TlsFuetter(c, puffer, n);                  // vom Socket gelesene Byte
//   var rc: int64 := TlsSchritt(c);            // Handschlag voranbringen
//   var m: int64 := TlsAusgabe(c, aus, cap);   // zu sendende Byte
//
// So bleibt die Unit mit nicht blockierenden Sockets und epoll benutzbar
// (TLS_WANT_READ/TLS_WANT_WRITE statt Blockieren) und ist ohne Netz
// pruefbar: zwei Zustaende koennen im selben Programm miteinander sprechen.
//
// Alle Puffer entstehen EINMAL bei TlsNeu. Je Record wird nichts belegt —
// #2096 verlangt das ausdruecklich, weil die Nutzer Langlaeufer ohne GC sind.
// TlsSpeicherBedarf() nennt den Bedarf je Verbindung.
//
// Stand dieser Etappe:
//   Rollen           Client und Server
//   Cipher-Suites    TLS_AES_128_GCM_SHA256, TLS_AES_256_GCM_SHA384,
//                    TLS_CHACHA20_POLY1305_SHA256
//   Schluesseltausch X25519
//   Signaturen       ecdsa_secp256r1_sha256 (eigene Signatur und Pruefung)
//   Erweiterungen    supported_versions, supported_groups, key_share,
//                    server_name (SNI), application_layer_protocol_negotiation
//   Nicht enthalten  HelloRetryRequest, PSK/0-RTT, Tickets, TLS 1.2,
//                    secp256r1-Schluesseltausch, RSA- und Ed25519-Signaturen.
//                    Jeder dieser Faelle wird mit einem benannten Fehler
//                    abgewiesen, nicht still uebergangen.

unit std.net.tls13;

import std.alloc;
import std.crypto.sha256;
import std.crypto.sha512;
import std.crypto.hkdf;
import std.crypto.aesgcm;
import std.crypto.chacha20poly1305;
import std.crypto.x25519;
import std.crypto.ec;
import std.crypto.rand;
import std.crypto.ct;
import std.crypto.der;
import std.crypto.x509;
import std.crypto.pkey;

// ---------------------------------------------------------------------------
// Rueckgabewerte von TlsSchritt / TlsLese / TlsSchreibe
//
// Als Funktionen abgefragt, weil ein `pub con` ueber Unit-Grenzen still -1
// liefern kann (#2102).
//   0   fertig bzw. Erfolg
//   1   TLS_WANT_READ   — es fehlen Byte von der Gegenseite
//   2   TLS_WANT_WRITE  — der Ausgabepuffer muss erst geleert werden
//  <0   Fehler, siehe TlsFehlerText
// ---------------------------------------------------------------------------

pub fn TlsOk(): int64 { return 0; }
pub fn TlsWantRead(): int64 { return 1; }
pub fn TlsWantWrite(): int64 { return 2; }

con E_FORMAT:        int64 := -1;    // Record oder Nachricht nicht lesbar
con E_VERSION:       int64 := -2;    // Gegenseite spricht nicht TLS 1.3
con E_SUITE:         int64 := -3;    // keine gemeinsame Cipher-Suite
con E_GRUPPE:        int64 := -4;    // keine gemeinsame Schluesselgruppe
con E_ENTSCHLUESS:   int64 := -5;    // AEAD-Tag falsch
con E_ZERTIFIKAT:    int64 := -6;    // Kette nicht gueltig
con E_SIGNATUR:      int64 := -7;    // CertificateVerify falsch
con E_FINISHED:      int64 := -8;    // Finished falsch
con E_ABLAUF:        int64 := -9;    // Nachricht an dieser Stelle unerwartet
con E_PUFFER:        int64 := -10;   // Puffer zu klein
con E_KONFIG:        int64 := -11;   // Konfiguration unvollstaendig
con E_UNTERSTUETZT:  int64 := -12;   // Verfahren nicht unterstuetzt
con E_WARNUNG:       int64 := -13;   // Alert der Gegenseite
con E_GESCHLOSSEN:   int64 := -14;   // close_notify

pub fn TlsFehlerText(rc: int64): pchar {
    if (rc == 0)  { return "ok"c; }
    if (rc == 1)  { return "want-read"c; }
    if (rc == 2)  { return "want-write"c; }
    if (rc == -1) { return "Record oder Handschlagnachricht nicht lesbar"c; }
    if (rc == -2) { return "Gegenseite bietet TLS 1.3 nicht an"c; }
    if (rc == -3) { return "keine gemeinsame Cipher-Suite"c; }
    if (rc == -4) { return "keine gemeinsame Schluesselgruppe (nur X25519)"c; }
    if (rc == -5) { return "Entschluesselung fehlgeschlagen (Tag falsch)"c; }
    if (rc == -6) { return "Zertifikatskette nicht gueltig"c; }
    if (rc == -7) { return "CertificateVerify falsch"c; }
    if (rc == -8) { return "Finished falsch"c; }
    if (rc == -9) { return "Nachricht an dieser Stelle unerwartet"c; }
    if (rc == -10) { return "Puffer zu klein"c; }
    if (rc == -11) { return "Konfiguration unvollstaendig"c; }
    if (rc == -12) { return "Verfahren nicht unterstuetzt"c; }
    if (rc == -13) { return "Alert der Gegenseite"c; }
    if (rc == -14) { return "Verbindung geschlossen (close_notify)"c; }
    return "unbekannter Fehler"c;
}

// Cipher-Suites (Zahlenwerte wie im Protokoll)
con CS_AES128_GCM_SHA256:   int64 := 0x1301;
con CS_AES256_GCM_SHA384:   int64 := 0x1302;
con CS_CHACHA20_SHA256:     int64 := 0x1303;

// Record-Typen
con RT_CCS:        int64 := 20;
con RT_ALERT:      int64 := 21;
con RT_HANDSHAKE:  int64 := 22;
con RT_APPDATA:    int64 := 23;

// Handschlagnachrichten
con HS_CLIENT_HELLO:  int64 := 1;
con HS_SERVER_HELLO:  int64 := 2;
con HS_NEW_TICKET:    int64 := 4;
con HS_EE:            int64 := 8;
con HS_CERT:          int64 := 11;
con HS_CERT_VERIFY:   int64 := 15;
con HS_FINISHED:      int64 := 20;
con HS_CERT_REQUEST:  int64 := 13;
con HS_KEY_UPDATE:    int64 := 24;

// Zustaende
con Z_START:        int64 := 0;
con Z_WARTE_SH:     int64 := 1;    // Client wartet auf ServerHello
con Z_WARTE_HS:     int64 := 2;    // Client wartet auf EE..Finished
con Z_WARTE_CH:     int64 := 3;    // Server wartet auf ClientHello
con Z_WARTE_CF:     int64 := 4;    // Server wartet auf Client-Finished
con Z_FERTIG:       int64 := 5;
con Z_FEHLER:       int64 := 6;
con Z_ZU:           int64 := 7;

// ---------------------------------------------------------------------------
// Konfiguration
//
// Layout (alles Zeiger und Laengen auf Puffer des Aufrufers; die Unit kopiert
// nichts und haelt keine Dateien offen):
// ---------------------------------------------------------------------------

con C_ROLLE:      int64 := 0;      // 1 Server, 2 Client
con C_CERT:       int64 := 8;      // DER der eigenen Kette: Block aus
con C_CERTN:      int64 := 16;     //   16-Byte-Eintraegen (Zeiger, Laenge)
con C_KEY:        int64 := 24;     // eigener Privatschluessel (DER)
con C_KEYLEN:     int64 := 32;
con C_TRUST:      int64 := 40;     // Trust-Store, gleiches Format wie C_CERT
con C_TRUSTN:     int64 := 48;
con C_HOST:       int64 := 56;     // SNI/zu pruefender Name (Client)
con C_HOSTLEN:    int64 := 64;
con C_ALPN:       int64 := 72;     // ALPN-Liste "h2,http/1.1"
con C_ALPNLEN:    int64 := 80;
con C_CLIENTAUTH: int64 := 88;     // 0 keine, 1 optional, 2 verlangt
con C_JETZT:      int64 := 96;     // Unix-Zeit fuer die Kettenpruefung
con C_PRUEFEN:    int64 := 104;    // 1 = Kette pruefen (Standard), 0 = nicht
con C_SIZE:       int64 := 112;

pub fn TlsConfigGroesse(): int64 { return C_SIZE; }

// rolle: 1 Server, 2 Client
pub fn TlsConfigNeu(cfg: int64, rolle: int64): void {
    var i: int64 := 0;
    while (i < C_SIZE) { poke8(cfg + i, 0); i := i + 1; }
    poke64(cfg + C_ROLLE, rolle);
    poke64(cfg + C_PRUEFEN, 1);
}

// Eigene Kette (Blatt zuerst) und Privatschluessel, beide als DER.
pub fn TlsConfigKette(cfg: int64, kette: int64, ketteN: int64,
                      key: int64, keyLen: int64): void {
    poke64(cfg + C_CERT, kette);
    poke64(cfg + C_CERTN, ketteN);
    poke64(cfg + C_KEY, key);
    poke64(cfg + C_KEYLEN, keyLen);
}

pub fn TlsConfigTrust(cfg: int64, trust: int64, trustN: int64): void {
    poke64(cfg + C_TRUST, trust);
    poke64(cfg + C_TRUSTN, trustN);
}

pub fn TlsConfigHost(cfg: int64, host: int64, hostLen: int64): void {
    poke64(cfg + C_HOST, host);
    poke64(cfg + C_HOSTLEN, hostLen);
}

pub fn TlsConfigAlpn(cfg: int64, alpn: int64, alpnLen: int64): void {
    poke64(cfg + C_ALPN, alpn);
    poke64(cfg + C_ALPNLEN, alpnLen);
}

// 0 keine, 1 optional, 2 verlangt (mTLS)
pub fn TlsConfigClientAuth(cfg: int64, modus: int64): void {
    poke64(cfg + C_CLIENTAUTH, modus);
}

pub fn TlsConfigZeit(cfg: int64, jetzt: int64): void {
    poke64(cfg + C_JETZT, jetzt);
}

// Nur fuer Pruefstaende: schaltet die Kettenpruefung ab. In der Anwendung
// bleibt sie an — darum ist der Standard 1 und nicht 0.
pub fn TlsConfigKettePruefen(cfg: int64, an: int64): void {
    poke64(cfg + C_PRUEFEN, an);
}

// ---------------------------------------------------------------------------
// Verbindungszustand
//
// Ein Block je Verbindung, einmal belegt. Die vier Puffer haengen hinten dran,
// damit TlsNeu nur eine Allokation braucht und TlsFrei nur eine Freigabe.
// ---------------------------------------------------------------------------

con V_CFG:        int64 := 0;
con V_ROLLE:      int64 := 8;
con V_ZUSTAND:    int64 := 16;
con V_SUITE:      int64 := 24;
con V_HASHLEN:    int64 := 32;
con V_KEYLEN:     int64 := 40;
con V_AEAD:       int64 := 48;     // 1 AES-GCM, 2 ChaCha20-Poly1305
con V_INPOS:      int64 := 56;
con V_OUTPOS:     int64 := 64;
con V_OUTGELESEN: int64 := 72;
con V_APPPOS:     int64 := 80;
con V_APPGELESEN: int64 := 88;
con V_SEQ_LESE:   int64 := 96;
con V_SEQ_SCHR:   int64 := 104;
con V_HSCTX:      int64 := 112;    // 208 Byte Transkript-Hashzustand
con V_SEC_HS:     int64 := 320;    // handshake_secret
con V_SEC_CHS:    int64 := 368;    // client_handshake_traffic_secret
con V_SEC_SHS:    int64 := 416;    // server_handshake_traffic_secret
con V_SEC_MAST:   int64 := 464;    // master_secret
con V_SEC_CAP:    int64 := 512;    // client_application_traffic_secret
con V_SEC_SAP:    int64 := 560;    // server_application_traffic_secret
con V_SEC_EXP:    int64 := 608;    // exporter_master_secret
con V_KEY_LESE:   int64 := 656;
con V_IV_LESE:    int64 := 688;
con V_KEY_SCHR:   int64 := 704;
con V_IV_SCHR:    int64 := 736;
con V_EPH_SK:     int64 := 752;
con V_EPH_PK:     int64 := 784;
con V_PEER_PK:    int64 := 816;
con V_SHARED:     int64 := 848;
con V_RANDOM:     int64 := 880;
con V_PEER_RAND:  int64 := 912;
con V_SESSID:     int64 := 944;
con V_SESSIDLEN:  int64 := 980;
con V_ALPNSEL:    int64 := 988;    // Position im ALPN-Puffer der Konfiguration
con V_ALPNSELLEN: int64 := 996;
con V_PEERCERT:   int64 := 1004;   // X509-Satz der Gegenseite (oder 0)
con V_PEERCERTOK: int64 := 1012;
con V_KRYPT_LESE: int64 := 1020;   // 0 Klartext, 1 Handschlag, 2 Anwendung
con V_KRYPT_SCHR: int64 := 1028;
con V_CERTREQ:    int64 := 1036;
con V_HSPOS:      int64 := 1044;
con V_HSGELESEN:  int64 := 1052;
con V_FEHLER:     int64 := 1060;
con V_CHLEN:      int64 := 1076;
// Das ausgehandelte ALPN-Protokoll wird HIER abgelegt, nicht als Zeiger in
// den Empfangspuffer: der Client liest es aus dem EncryptedExtensions, und
// dieser Puffer wird gleich danach wieder benutzt. Ein Zeiger darauf zeigte
// nach dem Handschlag auf fremde Byte.
con V_ALPNBUF:    int64 := 1088;
con V_KOPF:       int64 := 1120;   // Ende des Kopfteils

con B_IN:   int64 := 20480;
con B_OUT:  int64 := 20480;
con B_APP:  int64 := 17408;
con B_HS:   int64 := 16384;

// Die Puffer liegen hinter dem Kopf, auf 64 ausgerichtet angefuegt.
con O_IN:   int64 := 1152;
con O_OUT:  int64 := 21632;
con O_APP:  int64 := 42112;
con O_HS:   int64 := 59520;
// Der Client muss sein ClientHello aufbewahren: der Transkript-Hash haengt an
// der Cipher-Suite, und die kennt er erst mit dem ServerHello. Darum wird das
// ClientHello hier abgelegt und erst danach in den Hash gegeben.
con O_CH:   int64 := 75904;
con B_CH:   int64 := 2048;

// Kratzspeicher der Verbindung. Nach TlsNeu wird NICHTS mehr belegt: jede
// Funktion, die einen Zwischenpuffer braucht, nimmt ihr Stueck hier. Das
// erfuellt die Forderung aus #2096 ("kein Heap-Wachstum je Record") und
// umgeht zugleich defer, das in dieser Compilerfassung (1.2.31A) bei mehreren
// Eintraegen je Funktion und in verschachtelten Rahmen gemessen zu frueh
// freigab — zwei alloc(8) bekamen dieselbe Adresse, und der Schaden fiel erst
// im zweiten Handschlag auf.
con O_SCR:  int64 := 77952;      // 2048 Byte kleine Puffer
con S_TP:    int64 := 0;         // Typ/Position/Laenge beim Nachrichtenlesen
con S_PP:    int64 := 8;
con S_LP:    int64 := 16;
con S_EL:    int64 := 24;        // Laenge einer gefundenen Erweiterung
con S_KOPF:  int64 := 32;        // 5 Byte Recordkopf
con S_NONCE: int64 := 48;        // 12 Byte AEAD-Nonce
con S_TAG:   int64 := 64;        // 16 Byte AEAD-Tag
con S_TH:    int64 := 96;        // 64 Byte Transkript-Hash
con S_VD:    int64 := 160;       // 64 Byte verify_data
con S_HASH:  int64 := 224;       // 32 Byte Signaturhash
con S_R:     int64 := 256;       // 32 Byte r
con S_S:     int64 := 288;       // 32 Byte s
con S_DER:   int64 := 320;       // 80 Byte DER-Signatur
con S_CVBUF: int64 := 400;       // 128 Byte CertificateVerify-Rumpf
con S_PRIV:  int64 := 528;       // 48 Byte eigener Skalar
con S_SIG:   int64 := 576;       // 256 Byte Signaturinhalt (§4.4.3)
con S_HCTX:  int64 := 832;       // 208 Byte Kopie des Hashzustands
con S_K1:    int64 := 1040;      // 64 Byte: leerer Hash
con S_K2:    int64 := 1104;      // 64 Byte: Nullgeheimnis
con S_K3:    int64 := 1168;      // 64 Byte: early_secret
con S_K4:    int64 := 1232;      // 64 Byte: derived
con S_KETTE: int64 := 1296;      // 8 Eintraege (Zeiger, Laenge)
con S_WUNSCH:int64 := 1424;      // 3 Suites in Server-Vorliebe
con S_EXP1:  int64 := 1448;      // 64 Byte Exporter-Zwischenwert
con S_EXP2:  int64 := 1512;      // 64 Byte Exporter-Kontexthash
con S_FK:    int64 := 1576;      // 64 Byte finished_key

con O_REC:  int64 := 80000;      // 17408 Byte Recordzusammenbau
con O_MSG:  int64 := 97408;      // 8192 Byte Nachrichtenzusammenbau
con B_MSG:  int64 := 8192;
con V_SIZE: int64 := 105600;

pub fn TlsSpeicherBedarf(): int64 { return V_SIZE + X509Groesse(); }

fn pIn(c: int64): int64  { return c + O_IN; }
fn pOut(c: int64): int64 { return c + O_OUT; }
fn pApp(c: int64): int64 { return c + O_APP; }
fn pHs(c: int64): int64  { return c + O_HS; }
fn pCh(c: int64): int64  { return c + O_CH; }
fn pScr(c: int64): int64 { return c + O_SCR; }
fn pRec(c: int64): int64 { return c + O_REC; }
fn pMsg(c: int64): int64 { return c + O_MSG; }

pub fn TlsNeu(cfg: int64): int64 {
    var c: int64 := alloc(V_SIZE + X509Groesse());
    if (c == 0) { return 0; }
    var i: int64 := 0;
    while (i < V_KOPF) { poke8(c + i, 0); i := i + 1; }
    poke64(c + V_CFG, cfg);
    poke64(c + V_ROLLE, peek64(cfg + C_ROLLE));
    poke64(c + V_PEERCERT, c + V_SIZE);
    if (peek64(cfg + C_ROLLE) == 1) {
        poke64(c + V_ZUSTAND, Z_WARTE_CH);
    } else {
        poke64(c + V_ZUSTAND, Z_START);
    }
    return c;
}

pub fn TlsFrei(c: int64): void {
    if (c == 0) { return; }
    // Schluessel und Geheimnisse nicht im Speicher liegen lassen.
    SecureZero(c + V_SEC_HS, V_KOPF - V_SEC_HS);
    free(c, V_SIZE + X509Groesse());
}

pub fn TlsZustand(c: int64): int64 { return peek64(c + V_ZUSTAND); }
pub fn TlsFertig(c: int64): bool { return peek64(c + V_ZUSTAND) == Z_FERTIG; }
pub fn TlsSuite(c: int64): int64 { return peek64(c + V_SUITE); }

// Ausgewaehltes ALPN-Protokoll (Ausschnitt im ALPN-Puffer der Konfiguration).
pub fn TlsAlpnPos(c: int64): int64 { return peek64(c + V_ALPNSEL); }
pub fn TlsAlpnLen(c: int64): int64 { return peek64(c + V_ALPNSELLEN); }

// X509-Satz der Gegenseite, oder 0 wenn keines geprueft wurde.
pub fn TlsPeerZertifikat(c: int64): int64 {
    if (peek64(c + V_PEERCERTOK) == 0) { return 0; }
    return peek64(c + V_PEERCERT);
}

// ---------------------------------------------------------------------------
// Ein- und Ausgabe
// ---------------------------------------------------------------------------

// Empfangene Byte uebernehmen. Liefert die Anzahl uebernommener Byte; was
// nicht passt, bleibt beim Aufrufer (kein stilles Verwerfen).
pub fn TlsFuetter(c: int64, buf: int64, len: int64): int64 {
    var pos: int64 := peek64(c + V_INPOS);
    var platz: int64 := B_IN - pos;
    var n: int64 := len;
    if (n > platz) { n := platz; }
    var i: int64 := 0;
    while (i < n) { poke8(pIn(c) + pos + i, peek8(buf + i)); i := i + 1; }
    poke64(c + V_INPOS, pos + n);
    return n;
}

// Zu sendende Byte abholen.
pub fn TlsAusgabe(c: int64, buf: int64, cap: int64): int64 {
    var gelesen: int64 := peek64(c + V_OUTGELESEN);
    var vorhanden: int64 := peek64(c + V_OUTPOS) - gelesen;
    if (vorhanden <= 0) { return 0; }
    var n: int64 := vorhanden;
    if (n > cap) { n := cap; }
    var i: int64 := 0;
    while (i < n) { poke8(buf + i, peek8(pOut(c) + gelesen + i)); i := i + 1; }
    gelesen += n;
    if (gelesen == peek64(c + V_OUTPOS)) {
        poke64(c + V_OUTPOS, 0);
        poke64(c + V_OUTGELESEN, 0);
    } else {
        poke64(c + V_OUTGELESEN, gelesen);
    }
    return n;
}

pub fn TlsAusgabeOffen(c: int64): int64 {
    return peek64(c + V_OUTPOS) - peek64(c + V_OUTGELESEN);
}

fn outAnhaengen(c: int64, daten: int64, len: int64): int64 {
    var pos: int64 := peek64(c + V_OUTPOS);
    if (pos + len > B_OUT) { return E_PUFFER; }
    var i: int64 := 0;
    while (i < len) { poke8(pOut(c) + pos + i, peek8(daten + i)); i := i + 1; }
    poke64(c + V_OUTPOS, pos + len);
    return 0;
}

fn outByte(c: int64, b: int64): int64 {
    var pos: int64 := peek64(c + V_OUTPOS);
    if (pos + 1 > B_OUT) { return E_PUFFER; }
    poke8(pOut(c) + pos, b & 0xFF);
    poke64(c + V_OUTPOS, pos + 1);
    return 0;
}

// ---------------------------------------------------------------------------
// Hash und Schluesselplan
// ---------------------------------------------------------------------------

fn hashInit(c: int64): void {
    if (peek64(c + V_HASHLEN) == 48) { Sha384Init(c + V_HSCTX); }
    else { Sha256Init(c + V_HSCTX); }
}

fn hashUpdate(c: int64, daten: int64, len: int64): void {
    if (peek64(c + V_HASHLEN) == 48) { Sha512Update(c + V_HSCTX, daten, len); }
    else { Sha256Update(c + V_HSCTX, daten, len); }
}

// Transkript-Hash OHNE den laufenden Zustand zu verbrauchen: der Zustand wird
// kopiert und die Kopie abgeschlossen. Sha256- und Sha512-Zustand sind flache
// Bloecke, das Kopieren ist also vollstaendig.
fn hashJetzt(c: int64, out: int64): void {
    var gr: int64 := Sha512CtxSize();
    var k: int64 := pScr(c) + S_HCTX;
    var i: int64 := 0;
    while (i < gr) { poke8(k + i, peek8(c + V_HSCTX + i)); i := i + 1; }
    if (peek64(c + V_HASHLEN) == 48) { Sha384Final(k, out); }
    else { Sha256Final(k, out); }
}

fn hashLeer(c: int64, out: int64): void {
    if (peek64(c + V_HASHLEN) == 48) { Sha384(out, 0, out); }
    else { SHA256(out, 0, out); }
}

// Schluessel und IV eines Verkehrsgeheimnisses (RFC 8446 §7.3).
fn verkehrsSchluessel(c: int64, secret: int64, keyOut: int64, ivOut: int64): bool {
    var hl: int64 := peek64(c + V_HASHLEN);
    var kl: int64 := peek64(c + V_KEYLEN);
    if (!HkdfExpandLabel(hl, secret, hl, "key"c as int64, 3, 0, 0, keyOut, kl)) {
        return false;
    }
    return HkdfExpandLabel(hl, secret, hl, "iv"c as int64, 2, 0, 0, ivOut, 12);
}

// Der ganze Schluesselplan bis zu den Handschlagschluesseln.
fn planHandschlag(c: int64): bool {
    var hl: int64 := peek64(c + V_HASHLEN);
    var leer: int64 := pScr(c) + S_K1;
    var null0: int64 := pScr(c) + S_K2;
    var early: int64 := pScr(c) + S_K3;
    var derived: int64 := pScr(c) + S_K4;
    var th: int64 := pScr(c) + S_TH;
    var i: int64 := 0;
    while (i < 64) { poke8(null0 + i, 0); i := i + 1; }
    hashLeer(c, leer);

    // early_secret = HKDF-Extract(0, 0)
    HkdfExtract(hl, 0, 0, null0, hl, early);
    // derived = Derive-Secret(early, "derived", "")
    if (!HkdfExpandLabel(hl, early, hl, "derived"c as int64, 7, leer, hl, derived, hl)) {
        return false;
    }
    // handshake_secret = HKDF-Extract(derived, ECDHE)
    HkdfExtract(hl, derived, hl, c + V_SHARED, 32, c + V_SEC_HS);

    hashJetzt(c, th);
    if (!HkdfExpandLabel(hl, c + V_SEC_HS, hl, "c hs traffic"c as int64, 12,
                         th, hl, c + V_SEC_CHS, hl)) { return false; }
    if (!HkdfExpandLabel(hl, c + V_SEC_HS, hl, "s hs traffic"c as int64, 12,
                         th, hl, c + V_SEC_SHS, hl)) { return false; }

    // master_secret = HKDF-Extract(Derive-Secret(hs, "derived", ""), 0)
    if (!HkdfExpandLabel(hl, c + V_SEC_HS, hl, "derived"c as int64, 7,
                         leer, hl, derived, hl)) { return false; }
    HkdfExtract(hl, derived, hl, null0, hl, c + V_SEC_MAST);

    SecureZero(early, 64); SecureZero(derived, 64);
    return true;
}

// Anwendungsschluessel nach dem Server-Finished.
fn planAnwendung(c: int64): bool {
    var hl: int64 := peek64(c + V_HASHLEN);
    var th: int64 := pScr(c) + S_TH;
    hashJetzt(c, th);
    if (!HkdfExpandLabel(hl, c + V_SEC_MAST, hl, "c ap traffic"c as int64, 12,
                         th, hl, c + V_SEC_CAP, hl)) { return false; }
    if (!HkdfExpandLabel(hl, c + V_SEC_MAST, hl, "s ap traffic"c as int64, 12,
                         th, hl, c + V_SEC_SAP, hl)) { return false; }
    if (!HkdfExpandLabel(hl, c + V_SEC_MAST, hl, "exp master"c as int64, 10,
                         th, hl, c + V_SEC_EXP, hl)) { return false; }
    return true;
}

// RFC 8446 §7.5 / RFC 9266: Schluesselmaterial fuer die Anwendung.
pub fn TlsExportKeyingMaterial(c: int64, label: int64, labelLen: int64,
                               kontext: int64, kontextLen: int64,
                               out: int64, outLen: int64): bool {
    if (peek64(c + V_ZUSTAND) != Z_FERTIG) { return false; }
    var hl: int64 := peek64(c + V_HASHLEN);
    var s: int64 := pScr(c) + S_EXP1;
    var kh: int64 := pScr(c) + S_EXP2;
    if (!HkdfExpandLabel(hl, c + V_SEC_EXP, hl, label, labelLen, 0, 0, s, hl)) {
        return false;
    }
    if (hl == 48) { Sha384(kontext, kontextLen, kh); } else { SHA256(kontext, kontextLen, kh); }
    var ok: bool := HkdfExpandLabel(hl, s, hl, "exporter"c as int64, 8, kh, hl, out, outLen);
    SecureZero(s, 64);
    return ok;
}

// Schluessel je Richtung — getrennt, weil der Server beim Senden schon auf
// die Anwendungsschluessel umschaltet, waehrend er das Client-Finished noch
// mit den Handschlagschluesseln liest (RFC 8446 §4.4.4).
fn leseSchluessel(c: int64, secret: int64, stufe: int64): bool {
    if (!verkehrsSchluessel(c, secret, c + V_KEY_LESE, c + V_IV_LESE)) { return false; }
    poke64(c + V_SEQ_LESE, 0);
    poke64(c + V_KRYPT_LESE, stufe);
    return true;
}

fn schreibSchluessel(c: int64, secret: int64, stufe: int64): bool {
    if (!verkehrsSchluessel(c, secret, c + V_KEY_SCHR, c + V_IV_SCHR)) { return false; }
    poke64(c + V_SEQ_SCHR, 0);
    poke64(c + V_KRYPT_SCHR, stufe);
    return true;
}

// ---------------------------------------------------------------------------
// Record-Schicht (RFC 8446 §5)
//
// Nonce = IV xor Sequenznummer (big-endian in den letzten acht Byte),
// AAD = der Recordkopf. Der innere Klartext traegt den echten Typ als
// letztes Byte, danach darf Nullpolsterung folgen.
// ---------------------------------------------------------------------------

fn nonceBauen(iv: int64, seq: int64, out: int64): void {
    var i: int64 := 0;
    while (i < 12) { poke8(out + i, peek8(iv + i)); i := i + 1; }
    i := 0;
    while (i < 8) {
        var b: int64 := ((seq as uint64) >> ((7 - i) * 8)) & 0xFF;
        poke8(out + 4 + i, peek8(out + 4 + i) ^ b);
        i += 1;
    }
}

fn aeadSiegeln(c: int64, nonce: int64, aad: int64, aadLen: int64,
               daten: int64, len: int64, ct: int64, tag: int64): bool {
    if (peek64(c + V_AEAD) == 2) {
        return ChaChaPolySeal(c + V_KEY_SCHR, nonce, aad, aadLen, daten, len, ct, tag);
    }
    return AesGcmSeal(c + V_KEY_SCHR, peek64(c + V_KEYLEN), nonce, 12,
                      aad, aadLen, daten, len, ct, tag, 16);
}

fn aeadOeffnen(c: int64, nonce: int64, aad: int64, aadLen: int64,
               ct: int64, len: int64, tag: int64, pt: int64): bool {
    if (peek64(c + V_AEAD) == 2) {
        return ChaChaPolyOpen(c + V_KEY_LESE, nonce, aad, aadLen, ct, len, tag, pt);
    }
    return AesGcmOpen(c + V_KEY_LESE, peek64(c + V_KEYLEN), nonce, 12,
                      aad, aadLen, ct, len, tag, 16, pt);
}

// Einen Record schreiben. Bei gesetzter Schreibstufe wird verschluesselt und
// der aeussere Typ ist application_data (§5.2).
fn recordSenden(c: int64, typ: int64, daten: int64, len: int64): int64 {
    if (peek64(c + V_KRYPT_SCHR) == 0) {
        if (peek64(c + V_OUTPOS) + 5 + len > B_OUT) { return E_PUFFER; }
        var rc: int64 := outByte(c, typ);
        if (rc != 0) { return rc; }
        outByte(c, 3); outByte(c, 1);              // legacy_record_version 0x0301
        outByte(c, (len >> 8) & 0xFF); outByte(c, len & 0xFF);
        return outAnhaengen(c, daten, len);
    }

    var gesamt: int64 := len + 1 + 16;             // + Typbyte + Tag
    if (peek64(c + V_OUTPOS) + 5 + gesamt > B_OUT) { return E_PUFFER; }

    if (len + 1 > 17408) { return E_PUFFER; }
    var kopf: int64 := pScr(c) + S_KOPF;
    var nonce: int64 := pScr(c) + S_NONCE;
    var tag: int64 := pScr(c) + S_TAG;
    var innen: int64 := pRec(c);

    poke8(kopf, RT_APPDATA); poke8(kopf + 1, 3); poke8(kopf + 2, 3);
    poke8(kopf + 3, (gesamt >> 8) & 0xFF); poke8(kopf + 4, gesamt & 0xFF);

    var i: int64 := 0;
    while (i < len) { poke8(innen + i, peek8(daten + i)); i := i + 1; }
    poke8(innen + len, typ);

    nonceBauen(c + V_IV_SCHR, peek64(c + V_SEQ_SCHR), nonce);
    if (!aeadSiegeln(c, nonce, kopf, 5, innen, len + 1, innen, tag)) {
        return E_FORMAT;
    }
    poke64(c + V_SEQ_SCHR, peek64(c + V_SEQ_SCHR) + 1);

    outAnhaengen(c, kopf, 5);
    outAnhaengen(c, innen, len + 1);
    outAnhaengen(c, tag, 16);

    SecureZero(innen, len + 1);
    return 0;
}

// Den naechsten vollstaendigen Record aus dem Eingangspuffer verarbeiten:
// Handschlagbyte in den HS-Puffer, Anwendungsdaten in den App-Puffer,
// change_cipher_spec verwerfen, Alert melden.
// Liefert 0 (ein Record verarbeitet), 1 (noch nichts vollstaendig) oder
// einen Fehler.
fn recordVerarbeiten(c: int64): int64 {
    var vorhanden: int64 := peek64(c + V_INPOS);
    if (vorhanden < 5) { return 1; }
    var b: int64 := pIn(c);
    var typ: int64 := peek8(b) & 0xFF;
    var ver1: int64 := peek8(b + 1) & 0xFF;
    var len: int64 := ((peek8(b + 3) & 0xFF) << 8) | (peek8(b + 4) & 0xFF);
    if (ver1 != 3) { return E_VERSION; }
    if (len > 16640) { return E_FORMAT; }           // §5.2: 2^14 + 256
    if (vorhanden < 5 + len) { return 1; }

    var inhalt: int64 := b + 5;
    var echterTyp: int64 := typ;
    var nutzLen: int64 := len;

    if (typ == RT_APPDATA && peek64(c + V_KRYPT_LESE) != 0) {
        if (len < 17) { return E_FORMAT; }
        var nonce: int64 := pScr(c) + S_NONCE;
        nonceBauen(c + V_IV_LESE, peek64(c + V_SEQ_LESE), nonce);
        var ctLen: int64 := len - 16;
        if (!aeadOeffnen(c, nonce, b, 5, inhalt, ctLen, inhalt + ctLen, inhalt)) {
            return E_ENTSCHLUESS;
        }
        poke64(c + V_SEQ_LESE, peek64(c + V_SEQ_LESE) + 1);
        // Polsterung abschneiden und den echten Typ lesen (§5.4).
        var p: int64 := ctLen - 1;
        while (p >= 0 && (peek8(inhalt + p) & 0xFF) == 0) { p -= 1; }
        if (p < 0) { return E_FORMAT; }
        echterTyp := peek8(inhalt + p) & 0xFF;
        nutzLen := p;
    } else {
        if (typ == RT_APPDATA) { return E_ABLAUF; }  // unverschluesselt verboten
    }

    var rc: int64 := 0;
    if (echterTyp == RT_HANDSHAKE) {
        var hp: int64 := peek64(c + V_HSPOS);
        if (hp + nutzLen > B_HS) { rc := E_PUFFER; }
        else {
            var i: int64 := 0;
            while (i < nutzLen) { poke8(pHs(c) + hp + i, peek8(inhalt + i)); i := i + 1; }
            poke64(c + V_HSPOS, hp + nutzLen);
        }
    } else {
        if (echterTyp == RT_APPDATA) {
            var ap: int64 := peek64(c + V_APPPOS);
            if (ap + nutzLen > B_APP) { rc := E_PUFFER; }
            else {
                var i2: int64 := 0;
                while (i2 < nutzLen) { poke8(pApp(c) + ap + i2, peek8(inhalt + i2)); i2 += 1; }
                poke64(c + V_APPPOS, ap + nutzLen);
            }
        } else {
            if (echterTyp == RT_ALERT) {
                if (nutzLen >= 2) {
                    var stufe: int64 := peek8(inhalt) & 0xFF;
                    var grund: int64 := peek8(inhalt + 1) & 0xFF;
                    if (grund == 0) { rc := E_GESCHLOSSEN; }
                    else {
                        if (stufe == 1) { rc := E_WARNUNG; } else { rc := E_WARNUNG; }
                    }
                } else { rc := E_FORMAT; }
            }
            // change_cipher_spec wird verworfen (§5 Anhang D.4,
            // Middlebox-Kompatibilitaet) — aber nur unverschluesselt.
        }
    }

    // Verbrauchte Byte vorn abschneiden.
    var rest: int64 := vorhanden - (5 + len);
    var k: int64 := 0;
    while (k < rest) { poke8(b + k, peek8(b + 5 + len + k)); k := k + 1; }
    poke64(c + V_INPOS, rest);
    if (rc != 0) { return rc; }
    return 0;
}

// Alle vollstaendigen Records verarbeiten.
fn pumpe(c: int64): int64 {
    var rc: int64 := 0;
    while (rc == 0) { rc := recordVerarbeiten(c); }
    if (rc == 1) { return 0; }
    return rc;
}

// ---------------------------------------------------------------------------
// Handschlagnachrichten schreiben
// ---------------------------------------------------------------------------

// Schreibhilfe auf einem Puffer mit laufender Position.
fn wByte(buf: int64, pos: int64, v: int64): int64 {
    poke8(buf + pos, v & 0xFF);
    return pos + 1;
}

fn w16(buf: int64, pos: int64, v: int64): int64 {
    poke8(buf + pos, (v >> 8) & 0xFF);
    poke8(buf + pos + 1, v & 0xFF);
    return pos + 2;
}

fn w24(buf: int64, pos: int64, v: int64): int64 {
    poke8(buf + pos, (v >> 16) & 0xFF);
    poke8(buf + pos + 1, (v >> 8) & 0xFF);
    poke8(buf + pos + 2, v & 0xFF);
    return pos + 3;
}

fn wBytes(buf: int64, pos: int64, src: int64, len: int64): int64 {
    var i: int64 := 0;
    while (i < len) { poke8(buf + pos + i, peek8(src + i)); i := i + 1; }
    return pos + len;
}

fn r16(buf: int64, pos: int64): int64 {
    return ((peek8(buf + pos) & 0xFF) << 8) | (peek8(buf + pos + 1) & 0xFF);
}

fn r24(buf: int64, pos: int64): int64 {
    return ((peek8(buf + pos) & 0xFF) << 16) | ((peek8(buf + pos + 1) & 0xFF) << 8)
         |  (peek8(buf + pos + 2) & 0xFF);
}

// Eine Handschlagnachricht: Kopf anlegen, in den Transkript-Hash geben und
// als Record hinausschreiben.
fn hsSendenRoh(c: int64, typ: int64, rumpf: int64, len: int64, hashen: bool,
               kopieren: bool): int64 {
    if (len + 4 > B_MSG) { return E_PUFFER; }
    var n: int64 := pMsg(c);
    var p: int64 := wByte(n, 0, typ);
    p := w24(n, p, len);
    p := wBytes(n, p, rumpf, len);
    if (hashen) { hashUpdate(c, n, p); }
    if (kopieren) {
        if (p > B_CH) { return E_PUFFER; }
        var i: int64 := 0;
        while (i < p) { poke8(pCh(c) + i, peek8(n + i)); i := i + 1; }
        poke64(c + V_CHLEN, p);
    }
    return recordSenden(c, RT_HANDSHAKE, n, p);
}

fn hsSenden(c: int64, typ: int64, rumpf: int64, len: int64): int64 {
    return hsSendenRoh(c, typ, rumpf, len, true, false);
}

// Suite waehlen und die davon abhaengenden Groessen setzen.
fn suiteSetzen(c: int64, suite: int64): bool {
    if (suite == CS_AES128_GCM_SHA256) {
        poke64(c + V_SUITE, suite); poke64(c + V_HASHLEN, 32);
        poke64(c + V_KEYLEN, 16); poke64(c + V_AEAD, 1);
        return true;
    }
    if (suite == CS_AES256_GCM_SHA384) {
        poke64(c + V_SUITE, suite); poke64(c + V_HASHLEN, 48);
        poke64(c + V_KEYLEN, 32); poke64(c + V_AEAD, 1);
        return true;
    }
    if (suite == CS_CHACHA20_SHA256) {
        poke64(c + V_SUITE, suite); poke64(c + V_HASHLEN, 32);
        poke64(c + V_KEYLEN, 32); poke64(c + V_AEAD, 2);
        return true;
    }
    return false;
}

// Eigenes X25519-Paar und Zufall erzeugen.
fn eigeneWerte(c: int64, mitSessionId: bool): bool {
    var seed: int64 := pScr(c) + S_K1;
    if (RandBytesExact(seed, 32) != 32) { return false; }
    X25519KeyGen(seed, c + V_EPH_PK, c + V_EPH_SK);
    SecureZero(seed, 32);
    if (RandBytesExact(c + V_RANDOM, 32) != 32) { return false; }
    // Nur der Client erfindet eine session_id; der Server spiegelt die des
    // ClientHello zurueck und darf sie hier nicht ueberschreiben.
    if (mitSessionId) {
        if (RandBytesExact(c + V_SESSID, 32) != 32) { return false; }
        poke64(c + V_SESSIDLEN, 32);
    }
    return true;
}

// ALPN-Liste "h2,http/1.1" in das Protokollformat schreiben: je Eintrag ein
// Laengenbyte. Liefert die geschriebene Laenge.
fn alpnSchreiben(buf: int64, pos: int64, liste: int64, len: int64): int64 {
    var p: int64 := pos;
    var start: int64 := 0;
    var i: int64 := 0;
    while (i <= len) {
        if (i == len || (peek8(liste + i) & 0xFF) == 44) {       // ','
            var l: int64 := i - start;
            if (l > 0) {
                p := wByte(buf, p, l);
                p := wBytes(buf, p, liste + start, l);
            }
            start := i + 1;
        }
        i += 1;
    }
    return p;
}

fn clientHelloSenden(c: int64): int64 {
    var cfg: int64 := peek64(c + V_CFG);
    // Rumpf im hinteren Teil des Nachrichtenpuffers zusammenbauen; hsSendenRoh
    // setzt den Kopf davor und benutzt den vorderen Teil.
    var buf: int64 := pMsg(c) + 4096;

    var p: int64 := w16(buf, 0, 0x0303);                 // legacy_version
    p := wBytes(buf, p, c + V_RANDOM, 32);
    p := wByte(buf, p, 32);
    p := wBytes(buf, p, c + V_SESSID, 32);
    // Cipher-Suites
    p := w16(buf, p, 6);
    p := w16(buf, p, CS_AES128_GCM_SHA256);
    p := w16(buf, p, CS_AES256_GCM_SHA384);
    p := w16(buf, p, CS_CHACHA20_SHA256);
    p := wByte(buf, p, 1); p := wByte(buf, p, 0);        // legacy_compression

    var extLenPos: int64 := p;
    p += 2;
    var extStart: int64 := p;

    // supported_versions
    p := w16(buf, p, 43); p := w16(buf, p, 3);
    p := wByte(buf, p, 2); p := w16(buf, p, 0x0304);
    // supported_groups: nur x25519
    p := w16(buf, p, 10); p := w16(buf, p, 4);
    p := w16(buf, p, 2); p := w16(buf, p, 0x001d);
    // key_share
    p := w16(buf, p, 51); p := w16(buf, p, 38);
    p := w16(buf, p, 36);
    p := w16(buf, p, 0x001d); p := w16(buf, p, 32);
    p := wBytes(buf, p, c + V_EPH_PK, 32);
    // signature_algorithms: ecdsa_secp256r1_sha256
    p := w16(buf, p, 13); p := w16(buf, p, 4);
    p := w16(buf, p, 2); p := w16(buf, p, 0x0403);
    // server_name
    var hostLen: int64 := peek64(cfg + C_HOSTLEN);
    if (peek64(cfg + C_HOST) != 0 && hostLen > 0) {
        p := w16(buf, p, 0); p := w16(buf, p, hostLen + 5);
        p := w16(buf, p, hostLen + 3);
        p := wByte(buf, p, 0); p := w16(buf, p, hostLen);
        p := wBytes(buf, p, peek64(cfg + C_HOST), hostLen);
    }
    // ALPN
    var alpnLen: int64 := peek64(cfg + C_ALPNLEN);
    if (peek64(cfg + C_ALPN) != 0 && alpnLen > 0) {
        var merk: int64 := p;
        p := w16(buf, p, 16); p += 4;                     // Laengen spaeter
        var listenStart: int64 := p;
        p := alpnSchreiben(buf, p, peek64(cfg + C_ALPN), alpnLen);
        var listenLen: int64 := p - listenStart;
        w16(buf, merk + 2, listenLen + 2);
        w16(buf, merk + 4, listenLen);
    }

    w16(buf, extLenPos, p - extStart);
    // Nicht hashen, sondern aufbewahren (siehe O_CH).
    return hsSendenRoh(c, HS_CLIENT_HELLO, buf, p, false, true);
}

fn serverHelloSenden(c: int64): int64 {
    var buf: int64 := pMsg(c) + 4096;
    var p: int64 := w16(buf, 0, 0x0303);
    p := wBytes(buf, p, c + V_RANDOM, 32);
    p := wByte(buf, p, peek64(c + V_SESSIDLEN));
    p := wBytes(buf, p, c + V_SESSID, peek64(c + V_SESSIDLEN));
    p := w16(buf, p, peek64(c + V_SUITE));
    p := wByte(buf, p, 0);                                // compression
    var extLenPos: int64 := p;
    p += 2;
    var extStart: int64 := p;
    // supported_versions
    p := w16(buf, p, 43); p := w16(buf, p, 2); p := w16(buf, p, 0x0304);
    // key_share
    p := w16(buf, p, 51); p := w16(buf, p, 36);
    p := w16(buf, p, 0x001d); p := w16(buf, p, 32);
    p := wBytes(buf, p, c + V_EPH_PK, 32);
    w16(buf, extLenPos, p - extStart);
    return hsSenden(c, HS_SERVER_HELLO, buf, p);
}

fn eeSenden(c: int64): int64 {
    var buf: int64 := pMsg(c) + 4096;
    var p: int64 := 0;
    var extLenPos: int64 := p;
    p += 2;
    var extStart: int64 := p;
    if (peek64(c + V_ALPNSELLEN) > 0) {
        var l: int64 := peek64(c + V_ALPNSELLEN);
        p := w16(buf, p, 16); p := w16(buf, p, l + 3);
        p := w16(buf, p, l + 1); p := wByte(buf, p, l);
        p := wBytes(buf, p, peek64(c + V_ALPNSEL), l);
    }
    w16(buf, extLenPos, p - extStart);
    return hsSenden(c, HS_EE, buf, p);
}

fn certRequestSenden(c: int64): int64 {
    var buf: int64 := pMsg(c) + 4096;
    // certificate_request_context: leer
    var p: int64 := wByte(buf, 0, 0);
    var extLenPos: int64 := p;
    p += 2;
    var extStart: int64 := p;
    // signature_algorithms ist Pflicht in CertificateRequest (§4.3.2)
    p := w16(buf, p, 13); p := w16(buf, p, 4);
    p := w16(buf, p, 2); p := w16(buf, p, 0x0403);
    w16(buf, extLenPos, p - extStart);
    return hsSenden(c, HS_CERT_REQUEST, buf, p);
}

fn certSenden(c: int64): int64 {
    var cfg: int64 := peek64(c + V_CFG);
    var n: int64 := peek64(cfg + C_CERTN);
    var liste: int64 := peek64(cfg + C_CERT);
    var gesamt: int64 := 0;
    var i: int64 := 0;
    while (i < n) { gesamt += 5 + peek64(liste + i * 16 + 8); i += 1; }

    if (gesamt + 16 > 4000) { return E_PUFFER; }
    var buf: int64 := pMsg(c) + 4096;
    var p: int64 := wByte(buf, 0, 0);                     // request_context leer
    p := w24(buf, p, gesamt);
    i := 0;
    while (i < n) {
        var l: int64 := peek64(liste + i * 16 + 8);
        p := w24(buf, p, l);
        p := wBytes(buf, p, peek64(liste + i * 16), l);
        p := w16(buf, p, 0);                              // keine Erweiterungen
        i += 1;
    }
    return hsSenden(c, HS_CERT, buf, p);
}

// Der zu signierende Inhalt nach §4.4.3: 64 Leerzeichen, Kontextkennung,
// ein Nullbyte, dann der Transkript-Hash.
fn signaturInhalt(c: int64, serverRolle: bool, out: int64): int64 {
    var i: int64 := 0;
    while (i < 64) { poke8(out + i, 32); i := i + 1; }
    var ctx: pchar := "TLS 1.3, server CertificateVerify"c;
    if (!serverRolle) { ctx := "TLS 1.3, client CertificateVerify"c; }
    var l: int64 := StrLen(ctx);
    var p: int64 := wBytes(out, 64, ctx as int64, l);
    p := wByte(out, p, 0);
    var th: int64 := pScr(c) + S_TH;
    hashJetzt(c, th);
    p := wBytes(out, p, th, peek64(c + V_HASHLEN));
    return p;
}

fn certVerifySenden(c: int64, serverRolle: bool): int64 {
    var cfg: int64 := peek64(c + V_CFG);
    var priv: int64 := pScr(c) + S_PRIV;
    var kurve: int64 := PkeyLiesEcPrivat(peek64(cfg + C_KEY), peek64(cfg + C_KEYLEN), priv);
    if (kurve != 1) {                                     // nur secp256r1
        SecureZero(priv, 48);
        return E_UNTERSTUETZT;
    }

    var inhalt: int64 := pScr(c) + S_SIG;
    var hash: int64 := pScr(c) + S_HASH;
    var r: int64 := pScr(c) + S_R;
    var s: int64 := pScr(c) + S_S;
    var der: int64 := pScr(c) + S_DER;
    var buf: int64 := pScr(c) + S_CVBUF;
    var len: int64 := signaturInhalt(c, serverRolle, inhalt);
    SHA256(inhalt, len, hash);
    if (!EcdsaSign(EC_P256, hash, priv, r, s)) {
        SecureZero(priv, 48);
        return E_SIGNATUR;
    }
    var derLen: int64 := EcdsaSigToDer(r, s, der);
    var p: int64 := w16(buf, 0, 0x0403);                  // ecdsa_secp256r1_sha256
    p := w16(buf, p, derLen);
    p := wBytes(buf, p, der, derLen);
    var rc: int64 := hsSenden(c, HS_CERT_VERIFY, buf, p);
    SecureZero(priv, 48);
    return rc;
}

// verify_data = HMAC(finished_key, Transcript-Hash) (§4.4.4)
fn finishedWert(c: int64, secret: int64, out: int64): bool {
    var hl: int64 := peek64(c + V_HASHLEN);
    var fk: int64 := pScr(c) + S_FK;
    var th: int64 := pScr(c) + S_TH;
    if (!HkdfExpandLabel(hl, secret, hl, "finished"c as int64, 8, 0, 0, fk, hl)) {
        return false;
    }
    hashJetzt(c, th);
    HmacHash(hl, fk, hl, th, hl, out);
    SecureZero(fk, 64);
    return true;
}

fn finishedSenden(c: int64, secret: int64): int64 {
    var hl: int64 := peek64(c + V_HASHLEN);
    var vd: int64 := pScr(c) + S_VD;
    if (!finishedWert(c, secret, vd)) { return E_FINISHED; }
    return hsSenden(c, HS_FINISHED, vd, hl);
}

fn alertSenden(c: int64, stufe: int64, grund: int64): void {
    var a: int64 := pScr(c) + S_K1;
    poke8(a, stufe); poke8(a + 1, grund);
    recordSenden(c, RT_ALERT, a, 2);
}

// ---------------------------------------------------------------------------
// Handschlagnachrichten lesen
// ---------------------------------------------------------------------------

// Naechste vollstaendige Nachricht im HS-Puffer ansehen, ohne sie zu
// verbrauchen. typPtr/posPtr/lenPtr nehmen Typ, Rumpfposition (absolut) und
// Rumpflaenge auf.
fn hsAnsehen(c: int64, typPtr: int64, posPtr: int64, lenPtr: int64): bool {
    var gelesen: int64 := peek64(c + V_HSGELESEN);
    var vorhanden: int64 := peek64(c + V_HSPOS) - gelesen;
    if (vorhanden < 4) { return false; }
    var b: int64 := pHs(c) + gelesen;
    var len: int64 := r24(b, 1);
    if (len < 0 || len > B_HS) { return false; }
    if (vorhanden < 4 + len) { return false; }
    poke64(typPtr, peek8(b) & 0xFF);
    poke64(posPtr, b + 4);
    poke64(lenPtr, len);
    return true;
}

// Die angesehene Nachricht in den Transkript-Hash geben (oder nicht) und
// weiterruecken.
fn hsVerbrauchen(c: int64, len: int64, hashen: bool): void {
    var gelesen: int64 := peek64(c + V_HSGELESEN);
    if (hashen) { hashUpdate(c, pHs(c) + gelesen, 4 + len); }
    gelesen += 4 + len;
    if (gelesen == peek64(c + V_HSPOS)) {
        poke64(c + V_HSPOS, 0);
        poke64(c + V_HSGELESEN, 0);
    } else {
        poke64(c + V_HSGELESEN, gelesen);
    }
}

// Erweiterungsblock durchsuchen. `pos` ist ein Versatz in `buf`, der
// Rueckgabewert dagegen die ABSOLUTE Adresse des Inhalts (oder -1), weil die
// Aufrufer gleich daraus lesen. Der Block beginnt mit zwei Laengenbyte.
fn extSuchen(buf: int64, pos: int64, len: int64, typ: int64, lenPtr: int64): int64 {
    if (len < 2) { return -1; }
    var gesamt: int64 := r16(buf, pos);
    if (gesamt + 2 > len) { return -1; }
    var p: int64 := pos + 2;
    var ende: int64 := pos + 2 + gesamt;
    while (p + 4 <= ende) {
        var t: int64 := r16(buf, p);
        var l: int64 := r16(buf, p + 2);
        if (p + 4 + l > ende) { return -1; }
        if (t == typ) { poke64(lenPtr, l); return buf + p + 4; }
        p := p + 4 + l;
    }
    return -1;
}

// ServerHello (Client-Seite)
fn serverHelloLesen(c: int64, pos: int64, len: int64): int64 {
    if (len < 38) { return E_FORMAT; }
    if (r16(pos, 0) != 0x0303) { return E_VERSION; }
    var i: int64 := 0;
    while (i < 32) { poke8(c + V_PEER_RAND + i, peek8(pos + 2 + i)); i := i + 1; }
    var sidLen: int64 := peek8(pos + 34) & 0xFF;
    if (sidLen > 32) { return E_FORMAT; }
    var p: int64 := 35 + sidLen;
    if (len < p + 3) { return E_FORMAT; }
    // Die session_id muss die des ClientHello sein (§4.1.3).
    if (sidLen != peek64(c + V_SESSIDLEN)) { return E_FORMAT; }
    if (CTMemEqual(pos + 35, c + V_SESSID, sidLen) != -1) { return E_FORMAT; }

    var suite: int64 := r16(pos, p);
    if (!suiteSetzen(c, suite)) { return E_SUITE; }
    p += 2;
    if ((peek8(pos + p) & 0xFF) != 0) { return E_FORMAT; }
    p += 1;

    var extLen: int64 := pScr(c) + S_EL;
    var sv: int64 := extSuchen(pos, p, len - p, 43, extLen);
    if (sv < 0 || peek64(extLen) != 2 || r16(sv, 0) != 0x0304) { return E_VERSION; }
    var ks: int64 := extSuchen(pos, p, len - p, 51, extLen);
    if (ks < 0 || peek64(extLen) != 36) { return E_GRUPPE; }
    if (r16(ks, 0) != 0x001d || r16(ks, 2) != 32) { return E_GRUPPE; }
    i := 0;
    while (i < 32) { poke8(c + V_PEER_PK + i, peek8(ks + 4 + i)); i := i + 1; }
    return 0;
}

// ClientHello (Server-Seite): Suite waehlen, key_share und SNI/ALPN lesen.
fn clientHelloLesen(c: int64, pos: int64, len: int64): int64 {
    if (len < 38) { return E_FORMAT; }
    if (r16(pos, 0) != 0x0303) { return E_VERSION; }
    var i: int64 := 0;
    while (i < 32) { poke8(c + V_PEER_RAND + i, peek8(pos + 2 + i)); i := i + 1; }
    var sidLen: int64 := peek8(pos + 34) & 0xFF;
    if (sidLen > 32) { return E_FORMAT; }
    // Die session_id wird im ServerHello zurueckgespiegelt (§4.1.3).
    i := 0;
    while (i < sidLen) { poke8(c + V_SESSID + i, peek8(pos + 35 + i)); i := i + 1; }
    poke64(c + V_SESSIDLEN, sidLen);

    var p: int64 := 35 + sidLen;
    if (len < p + 2) { return E_FORMAT; }
    var csLen: int64 := r16(pos, p);
    p += 2;
    if (p + csLen > len) { return E_FORMAT; }

    // Reihenfolge der Server-Vorliebe, nicht die des Clients.
    var gewaehlt: int64 := 0;
    var wunsch: int64 := pScr(c) + S_WUNSCH;
    poke64(wunsch, CS_AES128_GCM_SHA256);
    poke64(wunsch + 8, CS_CHACHA20_SHA256);
    poke64(wunsch + 16, CS_AES256_GCM_SHA384);
    var w: int64 := 0;
    while (w < 3 && gewaehlt == 0) {
        var k: int64 := 0;
        while (k < csLen) {
            if (r16(pos, p + k) == peek64(wunsch + w * 8)) { gewaehlt := peek64(wunsch + w * 8); }
            k += 2;
        }
        w += 1;
    }
    if (gewaehlt == 0) { return E_SUITE; }
    if (!suiteSetzen(c, gewaehlt)) { return E_SUITE; }
    p += csLen;

    if (p + 1 > len) { return E_FORMAT; }
    var compLen: int64 := peek8(pos + p) & 0xFF;
    p := p + 1 + compLen;
    if (p + 2 > len) { return E_FORMAT; }

    var el: int64 := pScr(c) + S_EL;
    // supported_versions muss 0x0304 enthalten
    var sv: int64 := extSuchen(pos, p, len - p, 43, el);
    if (sv < 0) { return E_VERSION; }
    var svLen: int64 := peek8(sv) & 0xFF;
    var gefunden: bool := false;
    var q: int64 := 1;
    while (q + 1 < 1 + svLen + 1) {
        if (r16(sv, q) == 0x0304) { gefunden := true; }
        q += 2;
    }
    if (!gefunden) { return E_VERSION; }

    // key_share: x25519
    var ks: int64 := extSuchen(pos, p, len - p, 51, el);
    if (ks < 0) { return E_GRUPPE; }
    var ksGesamt: int64 := r16(ks, 0);
    var r: int64 := 2;
    var habe: bool := false;
    while (r + 4 <= 2 + ksGesamt && !habe) {
        var grp: int64 := r16(ks, r);
        var kl: int64 := r16(ks, r + 2);
        if (grp == 0x001d && kl == 32) {
            var j: int64 := 0;
            while (j < 32) { poke8(c + V_PEER_PK + j, peek8(ks + r + 4 + j)); j := j + 1; }
            habe := true;
        }
        r := r + 4 + kl;
    }
    if (!habe) { return E_GRUPPE; }

    // ALPN: erste gemeinsame Kennung in der Reihenfolge des Servers
    var cfg: int64 := peek64(c + V_CFG);
    if (peek64(cfg + C_ALPN) != 0 && peek64(cfg + C_ALPNLEN) > 0) {
        var ap: int64 := extSuchen(pos, p, len - p, 16, el);
        if (ap >= 0) {
            var listeLen: int64 := r16(ap, 0);
            var eigene: int64 := peek64(cfg + C_ALPN);
            var eigeneLen: int64 := peek64(cfg + C_ALPNLEN);
            var start: int64 := 0;
            var idx: int64 := 0;
            while (idx <= eigeneLen && peek64(c + V_ALPNSELLEN) == 0) {
                if (idx == eigeneLen || (peek8(eigene + idx) & 0xFF) == 44) {
                    var l2: int64 := idx - start;
                    if (l2 > 0) {
                        // in der Liste des Clients suchen
                        var t: int64 := 2;
                        while (t < 2 + listeLen) {
                            var pl: int64 := peek8(ap + t) & 0xFF;
                            if (pl == l2 && CTMemEqual(ap + t + 1, eigene + start, l2) == -1) {
                                poke64(c + V_ALPNSEL, eigene + start);
                                poke64(c + V_ALPNSELLEN, l2);
                                t := 2 + listeLen;
                            } else {
                                t := t + 1 + pl;
                            }
                        }
                    }
                    start := idx + 1;
                }
                idx += 1;
            }
        }
    }
    return 0;
}

// Certificate: erstes Zertifikat lesen und die Kette pruefen.
fn certLesen(c: int64, pos: int64, len: int64, serverSeite: bool): int64 {
    if (len < 4) { return E_FORMAT; }
    var ctxLen: int64 := peek8(pos) & 0xFF;
    var p: int64 := 1 + ctxLen;
    if (p + 3 > len) { return E_FORMAT; }
    var listeLen: int64 := r24(pos, p);
    p += 3;
    if (p + listeLen > len) { return E_FORMAT; }

    var cfg: int64 := peek64(c + V_CFG);
    var kette: int64 := pScr(c) + S_KETTE;
    var n: int64 := 0;
    var ende: int64 := p + listeLen;
    while (p + 3 <= ende && n < 8) {
        var cl: int64 := r24(pos, p);
        p += 3;
        if (p + cl > ende) { return E_FORMAT; }
        poke64(kette + n * 16, pos + p);
        poke64(kette + n * 16 + 8, cl);
        n += 1;
        p += cl;
        if (p + 2 > ende) { return E_FORMAT; }
        var extL: int64 := r16(pos, p);
        p := p + 2 + extL;
    }
    if (n == 0) { return E_FORMAT; }

    if (!X509Lies(peek64(kette), peek64(kette + 8), peek64(c + V_PEERCERT))) {
        return E_ZERTIFIKAT;
    }
    poke64(c + V_PEERCERTOK, 1);

    if (peek64(cfg + C_PRUEFEN) != 0) {
        var host: int64 := 0;
        var hostLen: int64 := 0;
        var zweck: int64 := 2;                      // clientAuth
        if (!serverSeite) {
            host := peek64(cfg + C_HOST);
            hostLen := peek64(cfg + C_HOSTLEN);
            zweck := 1;                             // serverAuth
        }
        var rc: int64 := X509PruefeKette(kette, n, peek64(cfg + C_TRUST),
                                         peek64(cfg + C_TRUSTN), host, hostLen,
                                         peek64(cfg + C_JETZT), zweck);
        if (rc != 0) { return E_ZERTIFIKAT; }
    }
    return 0;
}

// CertificateVerify gegen den Schluessel aus dem Zertifikat der Gegenseite.
fn certVerifyLesen(c: int64, pos: int64, len: int64, gegenseiteIstServer: bool): int64 {
    if (len < 4) { return E_FORMAT; }
    if (r16(pos, 0) != 0x0403) { return E_UNTERSTUETZT; }   // nur ecdsa_secp256r1_sha256
    var sigLen: int64 := r16(pos, 2);
    if (4 + sigLen > len) { return E_FORMAT; }

    var satz: int64 := peek64(c + V_PEERCERT);
    if (peek64(c + V_PEERCERTOK) == 0) { return E_ABLAUF; }
    if (X509KeyAlg(satz) != 1) { return E_UNTERSTUETZT; }
    var der: int64 := X509DerPuffer(satz);
    var kPos: int64 := der + X509PubKeyPos(satz);
    if (X509PubKeyLen(satz) != 65 || (peek8(kPos) & 0xFF) != 4) { return E_UNTERSTUETZT; }

    var inhalt: int64 := pScr(c) + S_SIG;
    var hash: int64 := pScr(c) + S_HASH;
    var r: int64 := pScr(c) + S_R;
    var s: int64 := pScr(c) + S_S;
    var l: int64 := signaturInhalt(c, gegenseiteIstServer, inhalt);
    SHA256(inhalt, l, hash);
    var ok: bool := false;
    if (EcdsaSigFromDer(pos + 4, sigLen, r, s)) {
        ok := EcdsaVerify(EC_P256, hash, kPos + 1, kPos + 33, r, s);
    }
    if (!ok) { return E_SIGNATUR; }
    return 0;
}

fn finishedLesen(c: int64, pos: int64, len: int64, secret: int64): int64 {
    var hl: int64 := peek64(c + V_HASHLEN);
    if (len != hl) { return E_FINISHED; }
    var vd: int64 := pScr(c) + S_VD;
    if (!finishedWert(c, secret, vd)) { return E_FINISHED; }
    var gleich: int64 := CTMemEqual(vd, pos, hl);
    if (gleich != -1) { return E_FINISHED; }
    return 0;
}

// ---------------------------------------------------------------------------
// Ablauf
// ---------------------------------------------------------------------------

fn fehlerSetzen(c: int64, rc: int64): int64 {
    poke64(c + V_ZUSTAND, Z_FEHLER);
    poke64(c + V_FEHLER, rc);
    return rc;
}

fn clientStart(c: int64): int64 {
    if (!eigeneWerte(c, true)) { return fehlerSetzen(c, E_KONFIG); }
    var rc: int64 := clientHelloSenden(c);
    if (rc != 0) { return fehlerSetzen(c, rc); }
    poke64(c + V_ZUSTAND, Z_WARTE_SH);
    return TlsWantRead();
}

fn clientServerHello(c: int64): int64 {
    var tp: int64 := pScr(c) + S_TP;
    var pp: int64 := pScr(c) + S_PP;
    var lp: int64 := pScr(c) + S_LP;
    if (!hsAnsehen(c, tp, pp, lp)) { return TlsWantRead(); }
    if (peek64(tp) != HS_SERVER_HELLO) { return fehlerSetzen(c, E_ABLAUF); }
    var rc: int64 := serverHelloLesen(c, peek64(pp), peek64(lp));
    if (rc != 0) { return fehlerSetzen(c, rc); }
    // Jetzt steht die Suite fest: Transkript beginnt mit dem aufbewahrten
    // ClientHello, dann das ServerHello.
    hashInit(c);
    hashUpdate(c, pCh(c), peek64(c + V_CHLEN));
    hsVerbrauchen(c, peek64(lp), true);

    X25519SharedSecret(c + V_EPH_SK, c + V_PEER_PK, c + V_SHARED);
    if (!planHandschlag(c)) { return fehlerSetzen(c, E_KONFIG); }
    if (!leseSchluessel(c, c + V_SEC_SHS, 1)) { return fehlerSetzen(c, E_KONFIG); }
    if (!schreibSchluessel(c, c + V_SEC_CHS, 1)) { return fehlerSetzen(c, E_KONFIG); }
    poke64(c + V_ZUSTAND, Z_WARTE_HS);
    return 0;
}

fn clientHandschlag(c: int64): int64 {
    var cfg: int64 := peek64(c + V_CFG);
    var tp: int64 := pScr(c) + S_TP;
    var pp: int64 := pScr(c) + S_PP;
    var lp: int64 := pScr(c) + S_LP;
    var el: int64 := pScr(c) + S_EL;

    while (hsAnsehen(c, tp, pp, lp)) {
        var typ: int64 := peek64(tp);
        var pos: int64 := peek64(pp);
        var len: int64 := peek64(lp);

        if (typ == HS_EE) {
            // ALPN-Auswahl des Servers uebernehmen
            var ap: int64 := extSuchen(pos, 0, len, 16, el);
            if (ap >= 0 && peek64(el) >= 4) {
                var pl: int64 := peek8(ap + 2) & 0xFF;
                if (pl > 32) { pl := 32; }
                var z2: int64 := 0;
                while (z2 < pl) { poke8(c + V_ALPNBUF + z2, peek8(ap + 3 + z2)); z2 += 1; }
                poke64(c + V_ALPNSEL, c + V_ALPNBUF);
                poke64(c + V_ALPNSELLEN, pl);
            }
            hsVerbrauchen(c, len, true);
        } else {
        if (typ == HS_CERT_REQUEST) {
            poke64(c + V_CERTREQ, 1);
            hsVerbrauchen(c, len, true);
        } else {
        if (typ == HS_CERT) {
            var rc: int64 := certLesen(c, pos, len, false);
            if (rc != 0) { return fehlerSetzen(c, rc); }
            hsVerbrauchen(c, len, true);
        } else {
        if (typ == HS_CERT_VERIFY) {
            var rc2: int64 := certVerifyLesen(c, pos, len, true);
            if (rc2 != 0) { return fehlerSetzen(c, rc2); }
            hsVerbrauchen(c, len, true);
        } else {
        if (typ == HS_FINISHED) {
            var rc3: int64 := finishedLesen(c, pos, len, c + V_SEC_SHS);
            if (rc3 != 0) { return fehlerSetzen(c, rc3); }
            hsVerbrauchen(c, len, true);

            // Die Anwendungsgeheimnisse haengen am Transkript BIS zum
            // Server-Finished (§7.1) — darum hier, vor dem eigenen Finished.
            if (!planAnwendung(c)) { return fehlerSetzen(c, E_KONFIG); }

            if (peek64(c + V_CERTREQ) != 0) {
                if (peek64(cfg + C_CERT) != 0 && peek64(cfg + C_CERTN) > 0) {
                    var rc4: int64 := certSenden(c);
                    if (rc4 == 0) { rc4 := certVerifySenden(c, false); }
                    if (rc4 != 0) { return fehlerSetzen(c, rc4); }
                } else {
                    // Leeres Certificate ist die vorgesehene Antwort, wenn man
                    // keines hat (§4.4.2) — der Server entscheidet dann.
                    var leer: int64 := pScr(c) + S_K1;
                    poke8(leer, 0); poke8(leer + 1, 0); poke8(leer + 2, 0); poke8(leer + 3, 0);
                    hsSenden(c, HS_CERT, leer, 4);
                }
            }

            var rc5: int64 := finishedSenden(c, c + V_SEC_CHS);
            if (rc5 != 0) { return fehlerSetzen(c, rc5); }
            if (!leseSchluessel(c, c + V_SEC_SAP, 2)) { return fehlerSetzen(c, E_KONFIG); }
            if (!schreibSchluessel(c, c + V_SEC_CAP, 2)) { return fehlerSetzen(c, E_KONFIG); }
            poke64(c + V_ZUSTAND, Z_FERTIG);
            free(el,8);
            return 0;
        } else {
        if (typ == HS_NEW_TICKET) {
            hsVerbrauchen(c, len, false);        // Tickets werden verworfen
        } else {
            free(el,8);
            return fehlerSetzen(c, E_ABLAUF);
        } } } } } }
    }
    free(el,8);
    return TlsWantRead();
}

fn serverClientHello(c: int64): int64 {
    var cfg: int64 := peek64(c + V_CFG);
    if (peek64(cfg + C_CERT) == 0 || peek64(cfg + C_CERTN) <= 0
        || peek64(cfg + C_KEY) == 0) {
        return fehlerSetzen(c, E_KONFIG);
    }
    var tp: int64 := pScr(c) + S_TP;
    var pp: int64 := pScr(c) + S_PP;
    var lp: int64 := pScr(c) + S_LP;
    if (!hsAnsehen(c, tp, pp, lp)) { return TlsWantRead(); }
    if (peek64(tp) != HS_CLIENT_HELLO) { return fehlerSetzen(c, E_ABLAUF); }
    var rc: int64 := clientHelloLesen(c, peek64(pp), peek64(lp));
    if (rc != 0) { return fehlerSetzen(c, rc); }
    if (!eigeneWerte(c, false)) { return fehlerSetzen(c, E_KONFIG); }

    hashInit(c);
    hsVerbrauchen(c, peek64(lp), true);

    rc := serverHelloSenden(c);
    if (rc != 0) { return fehlerSetzen(c, rc); }

    X25519SharedSecret(c + V_EPH_SK, c + V_PEER_PK, c + V_SHARED);
    if (!planHandschlag(c)) { return fehlerSetzen(c, E_KONFIG); }
    if (!schreibSchluessel(c, c + V_SEC_SHS, 1)) { return fehlerSetzen(c, E_KONFIG); }
    if (!leseSchluessel(c, c + V_SEC_CHS, 1)) { return fehlerSetzen(c, E_KONFIG); }

    rc := eeSenden(c);
    if (rc == 0 && peek64(cfg + C_CLIENTAUTH) != 0) { rc := certRequestSenden(c); }
    if (rc == 0) { rc := certSenden(c); }
    if (rc == 0) { rc := certVerifySenden(c, true); }
    if (rc == 0) { rc := finishedSenden(c, c + V_SEC_SHS); }
    if (rc != 0) { return fehlerSetzen(c, rc); }

    if (!planAnwendung(c)) { return fehlerSetzen(c, E_KONFIG); }
    // Nur die Schreibrichtung wechselt jetzt; gelesen wird das
    // Client-Finished noch mit dem Handschlagschluessel (§4.4.4).
    if (!schreibSchluessel(c, c + V_SEC_SAP, 2)) { return fehlerSetzen(c, E_KONFIG); }
    poke64(c + V_ZUSTAND, Z_WARTE_CF);
    return 0;
}

fn serverClientFinished(c: int64): int64 {
    var cfg: int64 := peek64(c + V_CFG);
    var tp: int64 := pScr(c) + S_TP;
    var pp: int64 := pScr(c) + S_PP;
    var lp: int64 := pScr(c) + S_LP;

    while (hsAnsehen(c, tp, pp, lp)) {
        var typ: int64 := peek64(tp);
        var pos: int64 := peek64(pp);
        var len: int64 := peek64(lp);
        if (typ == HS_CERT) {
            // Leeres Certificate: der Client hat keines.
            var leerKette: bool := false;
            if (len >= 4) {
                var ctxLen: int64 := peek8(pos) & 0xFF;
                if (r24(pos, 1 + ctxLen) == 0) { leerKette := true; }
            }
            if (leerKette) {
                if (peek64(cfg + C_CLIENTAUTH) == 2) {
                    return fehlerSetzen(c, E_ZERTIFIKAT);
                }
            } else {
                var rc: int64 := certLesen(c, pos, len, true);
                if (rc != 0) { return fehlerSetzen(c, rc); }
            }
            hsVerbrauchen(c, len, true);
        } else {
        if (typ == HS_CERT_VERIFY) {
            var rc2: int64 := certVerifyLesen(c, pos, len, false);
            if (rc2 != 0) { return fehlerSetzen(c, rc2); }
            hsVerbrauchen(c, len, true);
        } else {
        if (typ == HS_FINISHED) {
            var rc3: int64 := finishedLesen(c, pos, len, c + V_SEC_CHS);
            if (rc3 != 0) { return fehlerSetzen(c, rc3); }
            hsVerbrauchen(c, len, true);
            if (peek64(cfg + C_CLIENTAUTH) == 2 && peek64(c + V_PEERCERTOK) == 0) {
                return fehlerSetzen(c, E_ZERTIFIKAT);
            }
            if (!leseSchluessel(c, c + V_SEC_CAP, 2)) { return fehlerSetzen(c, E_KONFIG); }
            poke64(c + V_ZUSTAND, Z_FERTIG);
            return 0;
        } else {
            return fehlerSetzen(c, E_ABLAUF);
        } } }
    }
    return TlsWantRead();
}

// Ein Schritt der Zustandsmaschine mit dem, was schon im HS-Puffer liegt.
fn zustandSchritt(c: int64): int64 {
    var z: int64 := peek64(c + V_ZUSTAND);
    if (z == Z_WARTE_SH) { return clientServerHello(c); }
    if (z == Z_WARTE_HS) { return clientHandschlag(c); }
    if (z == Z_WARTE_CH) { return serverClientHello(c); }
    if (z == Z_WARTE_CF) { return serverClientFinished(c); }
    return 0;
}

// Bringt den Handschlag so weit wie moeglich voran. Liefert 0 (fertig),
// TlsWantRead/TlsWantWrite oder einen negativen Fehlercode. Der Aufrufer
// schreibt dazwischen die Ausgabe weg (TlsAusgabe) und fuettert Gelesenes
// nach (TlsFuetter).
//
// Wichtig: es wird IMMER nur ein Record entschluesselt und dann die
// Zustandsmaschine gefragt. Wer stattdessen alle vorliegenden Records in
// einem Zug verarbeitet, versucht das EncryptedExtensions noch mit dem
// Schluesselstand von vor dem ServerHello zu lesen — der ganze Flug des
// Servers kommt in einem TCP-Segment.
pub fn TlsSchritt(c: int64): int64 {
    var z: int64 := peek64(c + V_ZUSTAND);
    if (z == Z_FEHLER) { return peek64(c + V_FEHLER); }
    if (z == Z_FERTIG) { return 0; }
    if (z == Z_ZU) { return E_GESCHLOSSEN; }

    if (z == Z_START) {
        var rc0: int64 := clientStart(c);
        if (rc0 < 0) { return rc0; }
        if (TlsAusgabeOffen(c) > 0) { return TlsWantWrite(); }
        return TlsWantRead();
    }

    var weiter: bool := true;
    while (weiter) {
        weiter := false;
        var vor: int64 := peek64(c + V_ZUSTAND);
        var r: int64 := zustandSchritt(c);
        if (r < 0) { return r; }
        if (peek64(c + V_ZUSTAND) != vor) { weiter := true; }
        if (peek64(c + V_ZUSTAND) == Z_FERTIG) { weiter := false; }
        else {
            var rr: int64 := recordVerarbeiten(c);
            if (rr < 0) { return fehlerSetzen(c, rr); }
            if (rr == 0) { weiter := true; }
        }
    }

    if (peek64(c + V_ZUSTAND) == Z_FERTIG) {
        if (TlsAusgabeOffen(c) > 0) { return TlsWantWrite(); }
        return 0;
    }
    if (TlsAusgabeOffen(c) > 0) { return TlsWantWrite(); }
    return TlsWantRead();
}

// ---------------------------------------------------------------------------
// Anwendungsdaten
// ---------------------------------------------------------------------------

// Anwendungsdaten senden. Records werden auf 16384 Byte Klartext begrenzt
// (§5.2). Liefert die Anzahl verarbeiteter Byte oder einen Fehler.
pub fn TlsSchreibe(c: int64, buf: int64, len: int64): int64 {
    if (peek64(c + V_ZUSTAND) != Z_FERTIG) { return E_ABLAUF; }
    var pos: int64 := 0;
    while (pos < len) {
        var n: int64 := len - pos;
        if (n > 16384) { n := 16384; }
        // Passt der Record nicht mehr in den Ausgabepuffer, liefern wir das
        // bisher Verarbeitete zurueck, statt still zu verwerfen.
        if (peek64(c + V_OUTPOS) + n + 22 > B_OUT) {
            if (pos == 0) { return TlsWantWrite(); }
            return pos;
        }
        var rc: int64 := recordSenden(c, RT_APPDATA, buf + pos, n);
        if (rc != 0) { return rc; }
        pos += n;
    }
    return pos;
}

// Empfangene Anwendungsdaten abholen. 0 heisst "noch nichts da".
pub fn TlsLese(c: int64, buf: int64, cap: int64): int64 {
    var z: int64 := peek64(c + V_ZUSTAND);
    if (z == Z_FEHLER) { return peek64(c + V_FEHLER); }
    var rc: int64 := pumpe(c);
    if (rc != 0 && rc != E_GESCHLOSSEN) { return fehlerSetzen(c, rc); }
    if (rc == E_GESCHLOSSEN) { poke64(c + V_ZUSTAND, Z_ZU); }

    var gelesen: int64 := peek64(c + V_APPGELESEN);
    var da: int64 := peek64(c + V_APPPOS) - gelesen;
    if (da <= 0) {
        if (peek64(c + V_ZUSTAND) == Z_ZU) { return E_GESCHLOSSEN; }
        return 0;
    }
    var n: int64 := da;
    if (n > cap) { n := cap; }
    var i: int64 := 0;
    while (i < n) { poke8(buf + i, peek8(pApp(c) + gelesen + i)); i := i + 1; }
    gelesen += n;
    if (gelesen == peek64(c + V_APPPOS)) {
        poke64(c + V_APPPOS, 0);
        poke64(c + V_APPGELESEN, 0);
    } else {
        poke64(c + V_APPGELESEN, gelesen);
    }
    return n;
}

// close_notify senden (§6.1).
pub fn TlsSchliessen(c: int64): void {
    if (peek64(c + V_ZUSTAND) == Z_FERTIG) { alertSenden(c, 1, 0); }
    poke64(c + V_ZUSTAND, Z_ZU);
}
