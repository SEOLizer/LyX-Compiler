// std.strtype — owned, length-carrying String value type (class)
//
// Motivation: Lyx's `pchar` is a raw NUL-terminated C string. Its length is not
// carried (every query scans for NUL), embedded NUL bytes are impossible, and
// ownership is unclear. `String` fixes that: an explicit byte length + capacity
// over an owned, growable buffer, with a method-based OO API.
//
// Design:
//   - libc-free: memory comes from mmap/munmap only.
//   - Explicit length — no NUL scan, embedded NUL bytes are fine.
//   - A class (not a struct) so it carries methods — which also makes it the
//     receiver for the planned generic operator overloading (a + b -> a.Add(b)).
//   - Reference semantics: mutating methods (Append*) grow the buffer in place.
//   - Construct via the free functions StringNew / StringFromPchar /
//     StringFromBytes, or `new String()` + an Init* method.

@description("Owned, length-carrying String value type (class, libc-free)")
@author("Andreas Röne")
@copyright("2024-2026 Andreas Röne")
unit std.strtype;

// Length of a raw NUL-terminated pchar (byte scan).
fn _pcharLen(p: int64): int64 {
  if (p == 0) { return 0; }
  var n: int64 := 0;
  while ((peek8(p + n) & 255) != 0) { n += 1; }
  return n;
}

pub type String = class {
  data: int64;   // mmap'd byte region (raw bytes, NOT NUL-terminated)
  len: int64;    // number of bytes in use
  cap: int64;    // allocated capacity in bytes

  // --- constructors (call on a `new String()`) ---

  fn InitCap(cap: int64) {
    var c: int64 := cap;
    if (c < 1) { c := 1; }
    self.data := mmap(0, c, PROT_RW, MAP_ANON, FD_NONE, 0);
    if (self.data < 0) { self.data := 0; self.len := 0; self.cap := 0; return; }
    self.len := 0;
    self.cap := c;
  }

  fn InitFromBytes(ptr: int64, n: int64) {
    self.InitCap(n + 1);
    if (self.data != 0 && n > 0) { memcpy(self.data, ptr, n); self.len := n; }
  }

  fn InitFromPchar(p: int64) {
    self.InitFromBytes(p, _pcharLen(p));
  }

  // --- queries ---

  fn Length(): int64 { return self.len; }

  fn CharAt(i: int64): int64 {
    if (i < 0 || i >= self.len) { return 0; }
    return peek8(self.data + i) & 255;
  }

  // Raw data pointer (valid for Length() bytes; NOT NUL-terminated).
  fn Data(): int64 { return self.data; }

  // --- mutation ---

  // Ensure `need` more bytes fit; doubles capacity (mmap+memcpy+munmap).
  // Returns 1 on success, 0 on OOM (unchanged).
  fn Reserve(need: int64): int64 {
    if (self.data == 0) { return 0; }
    if (self.len + need <= self.cap) { return 1; }
    var newCap: int64 := self.cap;
    if (newCap < 1) { newCap := 1; }
    while (newCap < self.len + need) { newCap *= 2; }
    var nb: int64 := mmap(0, newCap, PROT_RW, MAP_ANON, FD_NONE, 0);
    if (nb < 0) { return 0; }
    memcpy(nb, self.data, self.len);
    munmap(self.data, self.cap);
    self.data := nb;
    self.cap := newCap;
    return 1;
  }

  fn AppendChar(c: int64): int64 {
    if (self.Reserve(1) == 0) { return 0; }
    poke8(self.data + self.len, c & 255);
    self.len += 1;
    return 1;
  }

  fn AppendBytes(ptr: int64, n: int64): int64 {
    if (n <= 0) { return 1; }
    if (self.Reserve(n) == 0) { return 0; }
    memcpy(self.data + self.len, ptr, n);
    self.len += n;
    return 1;
  }

  fn AppendPchar(p: int64): int64 {
    return self.AppendBytes(p, _pcharLen(p));
  }

  fn Append(other: String): int64 {
    return self.AppendBytes(other.data, other.len);
  }

  // --- deriving new strings ---

  // New String = self ++ other. (Operator-overloading target: a + b -> a.Add(b).)
  fn Add(other: String): String {
    var r: String := new String();
    r.InitCap(self.len + other.len + 1);
    r.AppendBytes(self.data, self.len);
    r.AppendBytes(other.data, other.len);
    return r;
  }

  fn Substring(start: int64, count: int64): String {
    var st: int64 := start;
    if (st < 0) { st := 0; }
    var n: int64 := count;
    if (st + n > self.len) { n := self.len - st; }
    if (n < 0) { n := 0; }
    var r: String := new String();
    r.InitFromBytes(self.data + st, n);
    return r;
  }

  // --- comparison ---

  fn Equals(other: String): int64 {
    if (self.len != other.len) { return 0; }
    var i: int64 := 0;
    while (i < self.len) {
      if ((peek8(self.data + i) & 255) != (peek8(other.data + i) & 255)) { return 0; }
      i += 1;
    }
    return 1;
  }

  fn EqualsPchar(p: int64): int64 {
    var pl: int64 := _pcharLen(p);
    if (self.len != pl) { return 0; }
    var i: int64 := 0;
    while (i < self.len) {
      if ((peek8(self.data + i) & 255) != (peek8(p + i) & 255)) { return 0; }
      i += 1;
    }
    return 1;
  }

  // --- operator-overloading methods ---
  // These carry the names the compiler's operator overloading looks for, so
  // `a == b`, `a != b`, `a < b`, …, `a[i]` and `a + b` work on String by content.
  // (Add is defined above.) `Compare` is a lexicographic byte comparison
  // returning -1/0/1; the relational operators derive from it.

  fn Eq(other: String): int64 { return self.Equals(other); }               // ==

  fn Ne(other: String): int64 {                                            // !=
    if (self.Equals(other) != 0) { return 0; }
    return 1;
  }

  fn Compare(other: String): int64 {
    var n: int64 := self.len;
    if (other.len < n) { n := other.len; }
    var i: int64 := 0;
    while (i < n) {
      var a: int64 := peek8(self.data + i) & 255;
      var b: int64 := peek8(other.data + i) & 255;
      if (a < b) { return 0 - 1; }
      if (a > b) { return 1; }
      i += 1;
    }
    if (self.len < other.len) { return 0 - 1; }
    if (self.len > other.len) { return 1; }
    return 0;
  }

  fn Lt(other: String): int64 { if (self.Compare(other) <  0) { return 1; } return 0; }  // <
  fn Le(other: String): int64 { if (self.Compare(other) <= 0) { return 1; } return 0; }  // <=
  fn Gt(other: String): int64 { if (self.Compare(other) >  0) { return 1; } return 0; }  // >
  fn Ge(other: String): int64 { if (self.Compare(other) >= 0) { return 1; } return 0; }  // >=

  fn Get(i: int64): int64 { return self.CharAt(i); }                       // a[i]

  // --- interop / lifetime ---

  // Fresh NUL-terminated copy (len+1 bytes) the caller owns. 0 on OOM.
  fn ToPchar(): int64 {
    var p: int64 := mmap(0, self.len + 1, PROT_RW, MAP_ANON, FD_NONE, 0);
    if (p < 0) { return 0; }
    if (self.len > 0) { memcpy(p, self.data, self.len); }
    poke8(p + self.len, 0);
    return p;
  }

  fn Free() {
    if (self.data != 0) { munmap(self.data, self.cap); }
    self.data := 0;
    self.len := 0;
    self.cap := 0;
  }
};

// --- free-function constructors (ergonomic construction) --------------------

pub fn StringNew(cap: int64): String {
  var s: String := new String();
  s.InitCap(cap);
  return s;
}

pub fn StringFromPchar(p: pchar): String {
  var s: String := new String();
  s.InitFromPchar(p);
  return s;
}

pub fn StringFromBytes(ptr: int64, n: int64): String {
  var s: String := new String();
  s.InitFromBytes(ptr, n);
  return s;
}
