// std/sysadmin -- WP-20: System-Administration (meist root-only)
// Wrapper um sys_mount (165), sys_umount2 (166), sys_chroot (161),
// sys_sethostname (170), sys_reboot (169), sys_sync (162).
// sys_statfs (137) ist bereits in std/xattr verfuegbar.
//
// ACHTUNG: Die meisten Funktionen erfordern CAP_SYS_ADMIN, CAP_SYS_CHROOT
// oder CAP_SYS_BOOT. Auf normalen Nutzersystemen geben sie -EPERM zurueck.

// ============================================================
// mount -- Flags
// ============================================================

pub con MS_RDONLY:      int64 := 1;      // Schreibgeschuetzt einhängen
pub con MS_NOSUID:      int64 := 2;      // SUID/SGID-Bits ignorieren
pub con MS_NODEV:       int64 := 4;      // Gerätedateien verbieten
pub con MS_NOEXEC:      int64 := 8;      // Ausfuehren verbieten
pub con MS_SYNCHRONOUS: int64 := 16;     // Synchrone Schreibvorgaenge
pub con MS_REMOUNT:     int64 := 32;     // Einhaengepunkt neu konfigurieren
pub con MS_NOATIME:     int64 := 1024;   // Zugriffszeiten nicht aktualisieren
pub con MS_BIND:        int64 := 4096;   // Bind-Mount
pub con MS_MOVE:        int64 := 8192;   // Mount verschieben
pub con MS_REC:         int64 := 16384;  // Rekursiver Bind/Unbind
pub con MS_SILENT:      int64 := 32768;  // Kernel-Meldungen unterdruecken
pub con MS_STRICTATIME: int64 := 16777216; // Zugriffszeiten immer schreiben

// umount2-Flags
pub con MNT_FORCE:   int64 := 1;   // Erzwingen (kann Datenverlust verursachen)
pub con MNT_DETACH:  int64 := 2;   // Aushängen unsichtbar machen (lazy)
pub con MNT_EXPIRE:  int64 := 4;   // Fuer abgelaufene Mounts markieren

// ============================================================
// reboot -- Kommandos und Magic-Nummern
// ============================================================

// Linux-Reboot-Magics (beide erforderlich fuer gueltigen sys_reboot-Aufruf)
pub con LINUX_REBOOT_MAGIC1:  int64 := 4276215469;   // 0xFEE1DEAD
pub con LINUX_REBOOT_MAGIC2:  int64 := 672274793;    // 0x28121969

// Reboot-Kommandos
pub con LINUX_REBOOT_CMD_RESTART:   int64 := 19088743;    // 0x01234567
pub con LINUX_REBOOT_CMD_HALT:      int64 := 3453033763;  // 0xCDEF0123
pub con LINUX_REBOOT_CMD_POWER_OFF: int64 := 1126301404;  // 0x4321FEDC
pub con LINUX_REBOOT_CMD_RESTART2:  int64 := 2712847316;  // 0xA1B2C3D4
pub con LINUX_REBOOT_CMD_CAD_ON:    int64 := 2309737967;  // 0x89ABCDEF
pub con LINUX_REBOOT_CMD_CAD_OFF:   int64 := 0;

// ============================================================
// Funktionen
// ============================================================

// SyncAll: schreibt alle gepufferten Daten auf die Speichermedien.
// Benötigt keine Rechte. Gibt immer 0 zurueck.
pub fn SyncAll(): int64 {
  return sys_sync();
}

// Chroot: setzt das Wurzelverzeichnis des Prozesses auf `path`.
// Erfordert CAP_SYS_CHROOT.
pub fn Chroot(path: pchar): int64 {
  return sys_chroot(path);
}

// SetHostname: setzt den Kernel-Hostnamen.
// Erfordert CAP_SYS_ADMIN.
pub fn SetHostname(name: pchar, len: int64): int64 {
  return sys_sethostname(name, len);
}

// Mount: haengt ein Dateisystem ein.
// source:  Quellgerät oder "none" fuer virtuelle Dateisysteme
// target:  Einhaengepunkt (muss existieren)
// fsType:  Dateisystemtyp (z.B. "ext4", "tmpfs", "proc")
// flags:   MS_* Kombination
// Erfordert CAP_SYS_ADMIN.
pub fn Mount(source: pchar, target: pchar, fsType: pchar, flags: int64): int64 {
  return sys_mount(source, target, fsType, flags, 0);
}

// MountData: wie Mount, aber mit zusaetzlichen Mount-Optionen als String.
// data: Mount-Optionen (z.B. "size=100m,mode=0755" fuer tmpfs)
pub fn MountData(source: pchar, target: pchar, fsType: pchar,
                 flags: int64, data: pchar): int64 {
  return sys_mount(source, target, fsType, flags, data as int64);
}

// Umount: haengt ein Dateisystem aus.
// Erfordert CAP_SYS_ADMIN.
pub fn Umount(target: pchar, flags: int64): int64 {
  return sys_umount2(target, flags);
}

// Reboot: initiiert einen Systemneustart, Halt oder Poweroff.
// cmd:  LINUX_REBOOT_CMD_* Konstante
// Die magischen Zahlen werden intern eingesetzt.
// ACHTUNG: fuehrt bei root sofort zur Systemabschaltung!
// Erfordert CAP_SYS_BOOT.
pub fn Reboot(cmd: int64): int64 {
  return sys_reboot(LINUX_REBOOT_MAGIC1, LINUX_REBOOT_MAGIC2, cmd, 0);
}
