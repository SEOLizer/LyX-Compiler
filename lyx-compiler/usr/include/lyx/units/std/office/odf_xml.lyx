pub fn odfGetContentOdtHeader(): pchar {
  return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<office:document-content xmlns:office=\"urn:oasis:names:tc:opendocument:xmlns:office:1.0\" xmlns:text=\"urn:oasis:names:tc:opendocument:xmlns:text:1.0\" xmlns:style=\"urn:oasis:names:tc:opendocument:xmlns:style:1.0\" xmlns:fo=\"urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0\" xmlns:table=\"urn:oasis:names:tc:opendocument:xmlns:table:1.0\" xmlns:draw=\"urn:oasis:names:tc:opendocument:xmlns:drawing:1.0\" office:version=\"1.3\">\n<office:automatic-styles>\n"c;
}

pub fn odfGetContentOdtBodyOpen(): pchar {
  return "</office:automatic-styles>\n<office:body>\n<office:text>\n"c;
}

pub fn odfGetContentOdtFooter(): pchar {
  return "</office:text>\n</office:body>\n</office:document-content>\n"c;
}

