// std/office/odf_xml.lyx — OFF-02: XML-Escape und Skeleton-Strings
//
// HINWEIS: `pub con : pchar` ist in Lyx fehlerhaft (liefert ungültige Adresse).
// Stattdessen werden Funktionen verwendet, die pchar-Literale zurückgeben.

unit std.office.odf_xml;

import std.alloc;
import std.string;

// Länge eines null-terminierten Strings via peek8.
pub fn odfStrLen(s: int64): int64 {
  var i: int64 := 0;
  while peek8(s + i) != 0 { i := i + 1; }
  return i;
}

// ============================================================================
// OFF-02: XML-Escaping
// ============================================================================
pub fn odfEscapeInto(src: int64, dst: int64, dstCap: int64): int64 {
  var rp: int64 := 0;
  var wp: int64 := 0;
  var slen: int64 := StrLen(src as pchar);
  while rp < slen {
    var c: int64 := peek8(src + rp) & 255;
    if c == 38 {
      if wp + 5 >= dstCap { return wp; }
      poke8(dst + wp, 38); poke8(dst + wp + 1, 97); poke8(dst + wp + 2, 109); poke8(dst + wp + 3, 112); poke8(dst + wp + 4, 59);
      wp += 5;
    } else if c == 60 {
      if wp + 4 >= dstCap { return wp; }
      poke8(dst + wp, 38); poke8(dst + wp + 1, 108); poke8(dst + wp + 2, 116); poke8(dst + wp + 3, 59);
      wp += 4;
    } else if c == 62 {
      if wp + 4 >= dstCap { return wp; }
      poke8(dst + wp, 38); poke8(dst + wp + 1, 103); poke8(dst + wp + 2, 116); poke8(dst + wp + 3, 59);
      wp += 4;
    } else if c == 34 {
      if wp + 6 >= dstCap { return wp; }
      poke8(dst + wp, 38); poke8(dst + wp + 1, 113); poke8(dst + wp + 2, 117); poke8(dst + wp + 3, 111); poke8(dst + wp + 4, 116); poke8(dst + wp + 5, 59);
      wp += 6;
    } else if c == 39 {
      if wp + 5 >= dstCap { return wp; }
      poke8(dst + wp, 38); poke8(dst + wp + 1, 35); poke8(dst + wp + 2, 51); poke8(dst + wp + 3, 57); poke8(dst + wp + 4, 59);
      wp += 5;
    } else {
      if wp + 1 >= dstCap { return wp; }
      poke8(dst + wp, c);
      wp += 1;
    }
    rp += 1;
  }
  poke8(dst + wp, 0);
  return wp;
}

