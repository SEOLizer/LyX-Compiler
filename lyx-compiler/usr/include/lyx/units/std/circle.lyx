unit std.circle;

import std.vector;
import std.math;
import std.rect;

// ============================================================================
// Circle - 2D Circle
// ============================================================================

pub type Circle = struct {
  center: Vec2;   // Center point
  radius: int64;   // Radius (same units as center coordinates)
}

// ============================================================================
// Circle Constructors
// ============================================================================

pub fn CircleNew(center: Vec2, radius: int64): Circle {
  var _sl28: Circle;
  _sl28.center := center;
  _sl28.radius := radius;
  return _sl28;
}

pub fn CircleFromXYR(x: int64, y: int64, r: int64): Circle {
  var _sl32: Circle;
  var _sl321: Vec2;
  _sl321.x := x;
  _sl321.y := y;
  _sl32.center := _sl321;
  _sl32.radius := r;
  return _sl32;
}

pub fn CircleFromPoints(p1: Vec2, p2: Vec2): Circle {
  var cx: int64 := p1.x + p2.x;
  var cy: int64 := p1.y + p2.y;
  var center: Vec2;
  center.x := cx / 2;
  center.y := cy / 2;
  var radius: int64 := Vec2Distance(p1, p2) / 2;
  var _sl40: Circle;
  _sl40.center := center;
  _sl40.radius := radius;
  return _sl40;
}

pub fn CircleUnit(): Circle {
  var _sl44: Circle;
  _sl44.center := Vec2Zero();
  _sl44.radius := 1000000  // 1.0 in fixed-point;
  return _sl44;
}

// ============================================================================
// Circle Properties
// ============================================================================

pub fn CircleDiameter(c: Circle): int64 {
  return c.radius * 2;
}

// #1489: Diese Funktion rechnete, als waere der Radius ein Festkommawert mit
// Faktor 1000000, CircleCircumference direkt darunter dagegen mit rohen
// Einheiten — zwei Annahmen ueber dieselbe Groesse in derselben Unit. Fuer
// jeden Radius unter 1000 ergab `(r * r) / 1000000` bereits 0, die Flaeche war
// also immer 0. Es gilt die Einheit des Umfangs: roher Radius, Pi als
// Festkomma.
pub fn CircleArea(c: Circle): int64 {
  return (3141593 * c.radius * c.radius) / 1000000;
}

pub fn CircleCircumference(c: Circle): int64 {
  // circumference = 2 * π * r
  return 6283185 * c.radius / 1000000;
}

pub fn CircleIsEmpty(c: Circle): bool {
  return c.radius <= 0;
}

// ============================================================================
// Circle Containment
// ============================================================================

pub fn CircleContainsPoint(c: Circle, p: Vec2): bool {
  var dist_sq: int64 := Vec2DistanceSquared(c.center, p);
  var rad_sq: int64 := c.radius * c.radius;
  return dist_sq <= rad_sq;
}

pub fn CircleContainsCircle(c: Circle, inner: Circle): bool {
  var dist: int64 := Vec2Distance(c.center, inner.center);
  return dist + inner.radius <= c.radius;
}

// ============================================================================
// Circle Intersection
// ============================================================================

pub fn CircleIntersectsCircle(a: Circle, b: Circle): bool {
  var dist: int64 := Vec2Distance(a.center, b.center);
  return dist < (a.radius + b.radius);
}

pub fn CircleIntersectsRect(c: Circle, r: Rect): bool {
  // Find closest point on rect to circle center
  var closest: Vec2 := RectClampPoint(r, c.center);
  return CircleContainsPoint(c, closest);
}

// ============================================================================
// Circle Expansion
// ============================================================================

pub fn CircleExpand(c: Circle, amount: int64): Circle {
  var _sl105: Circle;
  _sl105.center := c.center;
  _sl105.radius := c.radius + amount;
  return _sl105;
}

pub fn CircleUnion(a: Circle, b: Circle): Circle {
  var dist: int64 := Vec2Distance(a.center, b.center);
  
  // If one circle contains the other, return the larger
  if (dist + b.radius <= a.radius) {
    return a;
  }
  if (dist + a.radius <= b.radius) {
    return b;
  }
  
  // Otherwise, create bounding circle
  var sum_r: int64 := dist + a.radius + b.radius;
  var new_radius: int64 := sum_r / 2;
  var dir: Vec2 := Vec2Sub(b.center, a.center);
  if (dist == 0) {
    var _sl124: Circle;
    _sl124.center := a.center;
    _sl124.radius := new_radius;
    return _sl124;
  }
  
  // #1490: Hier stand `Vec2Mul(dir, (new_radius - a.radius) / dist)`. Der
  // Quotient ist bei ganzzahligen Koordinaten fast immer 0 — der Mittelpunkt
  // blieb auf a.center liegen, und der Ergebniskreis deckte den zweiten Kreis
  // nicht ab. Geteilt wird jetzt erst NACH der Multiplikation, je Komponente.
  var schub: int64 := new_radius - a.radius;
  var new_center: Vec2 := Vec2New(a.center.x + (dir.x * schub) / dist,
                                  a.center.y + (dir.y * schub) / dist);

  // #1490: Die Zusage lautet "deckt beide Kreise ab", und daran wird gemessen.
  // Abstand und Mittelpunkt sind ganzzahlig gerundet, der aus der Formel
  // gewonnene Radius liegt deshalb gelegentlich ein bis zwei Einheiten zu
  // niedrig — bei a=(-200,-200,r50), b=(200,200,r150) genau so. Statt die
  // Rundung zu erraten, wird der Radius am tatsaechlichen Mittelpunkt
  // nachgemessen.
  var brauchtA: int64 := Vec2Distance(new_center, a.center) + a.radius;
  var brauchtB: int64 := Vec2Distance(new_center, b.center) + b.radius;
  if (brauchtA > new_radius) { new_radius := brauchtA; }
  if (brauchtB > new_radius) { new_radius := brauchtB; }

  var _sl132: Circle;
  _sl132.center := new_center;
  _sl132.radius := new_radius;
  return _sl132;
}

// ============================================================================
// Distance from circle
// ============================================================================

pub fn CircleDistanceToPoint(c: Circle, p: Vec2): int64 {
  var dist: int64 := Vec2Distance(c.center, p);
  if (dist > c.radius) {
    return dist - c.radius;
  }
  return 0;
}

pub fn CircleDistanceToCircle(c: Circle, other: Circle): int64 {
  var dist: int64 := Vec2Distance(c.center, other.center);
  var min_dist: int64 := c.radius + other.radius;
  if (dist > min_dist) {
    return dist - min_dist;
  }
  return 0;
}

// ============================================================================
// Bounding Box
// ============================================================================

pub fn CircleBoundingRect(c: Circle): Rect {
  var _sl161: Rect;
  var _sl1611: Vec2;
  _sl1611.x := c.center.x - c.radius;
  _sl1611.y := c.center.y - c.radius;
  _sl161.min := _sl1611;
  var _sl1612: Vec2;
  _sl1612.x := c.center.x + c.radius;
  _sl1612.y := c.center.y + c.radius;
  _sl161.max := _sl1612;
  return _sl161;
}

// ============================================================================
// Comparison
// ============================================================================

pub fn CircleEqual(a: Circle, b: Circle): bool {
  return Vec2Equal(a.center, b.center) && (a.radius == b.radius);
}

// ============================================================================
// Range - 1D Interval (useful for numeric ranges)
// ============================================================================

pub type Range = struct {
  min: int64;
  max: int64;
}

// ============================================================================
// Range Constructors
// ============================================================================

pub fn RangeNew(min: int64, max: int64): Range {
  if (min > max) {
    var _sl187: Range;
    _sl187.min := max;
    _sl187.max := min;
    return _sl187;
  }
  var _sl189: Range;
  _sl189.min := min;
  _sl189.max := max;
  return _sl189;
}

pub fn RangeFromValue(value: int64, delta: int64): Range {
  var _sl193: Range;
  _sl193.min := value - delta;
  _sl193.max := value + delta;
  return _sl193;
}

pub fn RangeEmpty(): Range {
  var _sl197: Range;
  _sl197.min := 0;
  _sl197.max := 0;
  return _sl197;
}

// ============================================================================
// Range Properties
// ============================================================================

pub fn RangeLength(r: Range): int64 {
  return r.max - r.min;
}

pub fn RangeCenter(r: Range): int64 {
  var sum: int64 := r.min + r.max;
  return sum / 2;
}

pub fn RangeIsEmpty(r: Range): bool {
  return r.min >= r.max;
}

// ============================================================================
// Range Containment
// ============================================================================

pub fn RangeContains(r: Range, value: int64): bool {
  return (value >= r.min) && (value <= r.max);
}

pub fn RangeContainsExclusive(r: Range, value: int64): bool {
  return (value > r.min) && (value < r.max);
}

pub fn RangeContainsRange(r: Range, inner: Range): bool {
  return (inner.min >= r.min) && (inner.max <= r.max);
}

// ============================================================================
// Range Intersection
// ============================================================================

pub fn RangeIntersects(r: Range, other: Range): bool {
  return (r.min < other.max) && (r.max > other.min);
}

pub fn RangeIntersection(r: Range, other: Range): Range {
  return RangeNew(
    Max64(r.min, other.min),
    Min64(r.max, other.max)
  );
}

// ============================================================================
// Range Expansion
// ============================================================================

pub fn RangeExpand(r: Range, value: int64): Range {
  var _sl253: Range;
  _sl253.min := Min64(r.min, value);
  _sl253.max := Max64(r.max, value);
  return _sl253;
}

pub fn RangeUnion(r: Range, other: Range): Range {
  var _sl257: Range;
  _sl257.min := Min64(r.min, other.min);
  _sl257.max := Max64(r.max, other.max);
  return _sl257;
}

pub fn RangeInflate(r: Range, amount: int64): Range {
  var _sl261: Range;
  _sl261.min := r.min - amount;
  _sl261.max := r.max + amount;
  return _sl261;
}

// ============================================================================
// Range2D - 2D Range (bounding box in coordinate space)
// ============================================================================

pub type Range2D = struct {
  x: Range;
  y: Range;
}

// ============================================================================
// Range2D Constructors
// ============================================================================

pub fn Range2DNew(x_range: Range, y_range: Range): Range2D {
  var _sl278: Range2D;
  _sl278.x := x_range;
  _sl278.y := y_range;
  return _sl278;
}

pub fn Range2DFromPoints(p1: Vec2, p2: Vec2): Range2D {
  var _sl282: Range2D;
  _sl282.x := RangeNew(p1.x, p2.x);
  _sl282.y := RangeNew(p1.y, p2.y);
  return _sl282;
}

pub fn Range2DFromRect(r: Rect): Range2D {
  var _sl286: Range2D;
  _sl286.x := RangeNew(r.min.x, r.max.x);
  _sl286.y := RangeNew(r.min.y, r.max.y);
  return _sl286;
}

// ============================================================================
// Range2D Properties
// ============================================================================

pub fn Range2DToRect(r2d: Range2D): Rect {
  var _sl294: Rect;
  var _sl2941: Vec2;
  _sl2941.x := r2d.x.min;
  _sl2941.y := r2d.y.min;
  _sl294.min := _sl2941;
  var _sl2942: Vec2;
  _sl2942.x := r2d.x.max;
  _sl2942.y := r2d.y.max;
  _sl294.max := _sl2942;
  return _sl294;
}

pub fn Range2DContains(r2d: Range2D, p: Vec2): bool {
  return RangeContains(r2d.x, p.x) && RangeContains(r2d.y, p.y);
}

pub fn Range2DIntersects(r2d: Range2D, other: Range2D): bool {
  return RangeIntersects(r2d.x, other.x) && RangeIntersects(r2d.y, other.y);
}

