// Lyx Android Stdlib - Cryptographic Randomness
// WP-AND-04
//
// Reads entropy from /dev/urandom. This works on every Android version
// from 5.0 (API 21) onward and never blocks once the kernel pool is
// initialised, which Bionic guarantees before the dynamic linker hands
// control to the app entry point.
//
// On API 23+ the kernel exposes `getrandom(2)` which avoids the file-
// descriptor round-trip. We document the syscall numbers in
// std.android.restrictions and leave the actual sys_getrandom builtin
// for a future codegen extension (it is NOT yet wired into lyxc's
// builtin table — Linux/Android still go through /dev/urandom here).
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, system.time])

unit std.android.random;

import std.fs;

// Reads `len` bytes of cryptographic-quality random data into `buf`.
// Returns the number of bytes actually read, or -1 on failure.
pub fn AndroidRandomBytes(buf: pchar, len: int64): int64 {
  if (len <= 0) {
    return 0;
  }
  var f: fd := open("/dev/urandom"c, O_RDONLY, 0);
  if (f < 0) {
    return -1;
  }
  var total: int64 := 0;
  var n: int64 := 0;
  while (total < len) {
    n := read(f, buf + total, len - total);
    if (n < 0) {
      close(f);
      return -1;
    }
    if (n == 0) {
      break;  // EOF is unexpected on /dev/urandom, but handle gracefully.
    }
    total += n;
  }
  close(f);
  return total;
}

// Reads a single int64 (8 bytes) of randomness; returns 0 on failure.
pub fn AndroidRandomInt64(): int64 {
  var slot: int64 := 0;
  var rc: int64 := AndroidRandomBytes((slot as int64) as pchar, 8);
  if (rc != 8) {
    return 0;
  }
  return slot;
}
