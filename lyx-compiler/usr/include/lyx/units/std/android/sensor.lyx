// ---------------------------------------------------------------------------
// Standard delay constants in microseconds.
// ---------------------------------------------------------------------------

pub con ASENSOR_DELAY_FASTEST: int64 :=      0;
pub con ASENSOR_DELAY_GAME:    int64 :=  20000;     // 50 Hz
pub con ASENSOR_DELAY_UI:      int64 :=  66667;     // 15 Hz
pub con ASENSOR_DELAY_NORMAL:  int64 := 200000;     //  5 Hz

// ---------------------------------------------------------------------------
// Opaque types.
// ---------------------------------------------------------------------------

pub type ASensorManager   = int64;
pub type ASensor          = int64;
pub type ASensorList      = int64;     // const ASensor* const* in C
pub type ASensorEventQueue = int64;
pub type ALooper          = int64;

// ---------------------------------------------------------------------------
// ASensorVector: typically three f32 components in the NDK header. We
// expose the 16-byte payload as four int64 slots; user code reinterprets
// via std.math float-from-bits helpers.
// ---------------------------------------------------------------------------

pub type ASensorVector = struct {
  x:   int64;     // f32 bit-cast to int64 low half
  y:   int64;
  z:   int64;
  status: int64;
};

// ASensorEvent: minimal layout matching the first 32 bytes of NDK's
// ASensorEvent. The full union after offset 32 (acceleration / magnetic
// / gyro / vector / scalar / step_counter / etc.) shares storage; we
// expose it as one ASensorVector pointed-at by `payload`.
pub type ASensorEvent = struct {
  version:   int64;   // sizeof(ASensorEvent)
  sensor:    int64;   // sensor handle
  ev_type:   int64;
  reserved:  int64;
  timestamp: int64;   // monotonic nanoseconds
  payload:   ASensorVector;
};

