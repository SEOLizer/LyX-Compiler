// ---------------------------------------------------------------------------
// Status returned by ASensorEvent.status / ASensorEvent.meta_data sensors.
// ---------------------------------------------------------------------------

pub con ASENSOR_STATUS_NO_CONTACT:       int64 := -1;
pub con ASENSOR_STATUS_UNRELIABLE:       int64 :=  0;
pub con ASENSOR_STATUS_ACCURACY_LOW:     int64 :=  1;
pub con ASENSOR_STATUS_ACCURACY_MEDIUM:  int64 :=  2;
