// Lyx Android Stdlib - Native Window
// WP-AND-06
//
// Type aliases, pixel-format constants and transform flags for the NDK
// native_window.h API. Function calls (ANativeWindow_fromSurface,
// ANativeWindow_lock, ANativeWindow_unlockAndPost, ...) live in
// libandroid.so — blocked, see asset.lyx.
//
// Reference: $ANDROID_NDK/sysroot/usr/include/android/native_window.h

unit std.android.native_window;

// ---------------------------------------------------------------------------
// Pixel formats (AHardwareBuffer_Format values that the window can take).
// Numeric values come from system/graphics.h.
// ---------------------------------------------------------------------------

pub con WINDOW_FORMAT_RGBA_8888:  int64 := 1;
pub con WINDOW_FORMAT_RGBX_8888:  int64 := 2;
pub con WINDOW_FORMAT_RGB_888:    int64 := 3;
pub con WINDOW_FORMAT_RGB_565:    int64 := 4;
pub con WINDOW_FORMAT_BGRA_8888:  int64 := 5;

// ---------------------------------------------------------------------------
// Transform flags (ANativeWindow_setBuffersTransform).
// ---------------------------------------------------------------------------

pub con ANATIVEWINDOW_TRANSFORM_IDENTITY:      int64 := 0x00;
pub con ANATIVEWINDOW_TRANSFORM_MIRROR_HORIZONTAL: int64 := 0x01;
pub con ANATIVEWINDOW_TRANSFORM_MIRROR_VERTICAL:   int64 := 0x02;
pub con ANATIVEWINDOW_TRANSFORM_ROTATE_90:     int64 := 0x04;
pub con ANATIVEWINDOW_TRANSFORM_ROTATE_180:    int64 := 0x03;   // H + V
pub con ANATIVEWINDOW_TRANSFORM_ROTATE_270:    int64 := 0x07;   // 90 + 180

// ---------------------------------------------------------------------------
// Frame-rate compatibility (ANativeWindow_setFrameRate).
// ---------------------------------------------------------------------------

pub con ANATIVEWINDOW_FRAME_RATE_COMPATIBILITY_DEFAULT:      int64 := 0;
pub con ANATIVEWINDOW_FRAME_RATE_COMPATIBILITY_FIXED_SOURCE: int64 := 1;

// ---------------------------------------------------------------------------
// Opaque pointer types.
// ---------------------------------------------------------------------------

pub type ANativeWindow = int64;

// ANativeWindow_Buffer matches the NDK struct (40 bytes typical on
// arm64): width/height/stride are int32 in C but we slot them as
// int64 to stay aligned with Lyx pointer width. bits is the
// pixel buffer pointer that lock() returns.
pub type ANativeWindow_Buffer = struct {
  width:    int64;
  height:   int64;
  stride:   int64;
  format:   int64;
  bits:     int64;
  reserved: int64;
};

// ARect: simple integer rectangle used by lock() for dirty-region updates.
pub type ARect = struct {
  left:   int64;
  top:    int64;
  right:  int64;
  bottom: int64;
};

