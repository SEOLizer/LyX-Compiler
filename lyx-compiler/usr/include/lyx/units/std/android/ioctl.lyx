// Lyx Android Stdlib - ioctl Number Catalog
// WP-AND-04
//
// Pre-computed ioctl numbers for the four device classes most Lyx apps
// touch on Android: ASHMEM (shared memory), ALSA PCM (audio), V4L2
// (camera/video) and IIO (sensors).
//
// ioctl request numbers on Linux are encoded as
//   _IOC(dir, type, nr, size) = (dir << 30) | (size << 16) | (type << 8) | nr
//   IOC_NONE  = 0, IOC_WRITE = 1, IOC_READ = 2, IOC_RW = 3
//
// All numbers here are the pre-encoded 32-bit values; user code passes
// them directly to the existing `ioctl(fd, request, arg)` builtin.

unit std.android.ioctl;

// ---------------------------------------------------------------------------
// _IOC direction bits (for hand-built encodings).
// ---------------------------------------------------------------------------

pub con IOC_NONE:  int64 := 0;
pub con IOC_WRITE: int64 := 1;
pub con IOC_READ:  int64 := 2;
pub con IOC_RW:    int64 := 3;

// ---------------------------------------------------------------------------
// ASHMEM (Android shared memory) — /dev/ashmem on legacy, ashared mem fd on
// API 26+. Magic byte 0x77.
// ---------------------------------------------------------------------------

pub con ASHMEM_SET_NAME:       int64 := 0x41007701;  // _IOW(0x77, 1, "char[256]")
pub con ASHMEM_GET_NAME:       int64 := 0x81007702;  // _IOR
pub con ASHMEM_SET_SIZE:       int64 := 0x40047703;  // _IOW(0x77, 3, size_t)
pub con ASHMEM_GET_SIZE:       int64 := 0x00007704;  // _IO
pub con ASHMEM_SET_PROT_MASK:  int64 := 0x40047705;
pub con ASHMEM_GET_PROT_MASK:  int64 := 0x00007706;
pub con ASHMEM_PIN:            int64 := 0x40087707;
pub con ASHMEM_UNPIN:          int64 := 0x40087708;
pub con ASHMEM_PURGE_ALL:      int64 := 0x0000770A;

// ---------------------------------------------------------------------------
// ALSA PCM audio — /dev/snd/pcmC<X>D<Y>{p,c}. Magic byte 0x41.
// ---------------------------------------------------------------------------

pub con SNDRV_PCM_IOCTL_PVERSION: int64 := 0x80044100;  // _IOR
pub con SNDRV_PCM_IOCTL_INFO:     int64 := 0x81204101;
pub con SNDRV_PCM_IOCTL_TSTAMP:   int64 := 0x40044102;  // _IOW
pub con SNDRV_PCM_IOCTL_HW_PARAMS:int64 := 0xC2604111;
pub con SNDRV_PCM_IOCTL_PREPARE:  int64 := 0x00004140;
pub con SNDRV_PCM_IOCTL_START:    int64 := 0x00004142;
pub con SNDRV_PCM_IOCTL_DROP:     int64 := 0x00004143;
pub con SNDRV_PCM_IOCTL_PAUSE:    int64 := 0x40044145;
pub con SNDRV_PCM_IOCTL_WRITEI_FRAMES: int64 := 0x40184150;
pub con SNDRV_PCM_IOCTL_READI_FRAMES:  int64 := 0x80184151;

// ---------------------------------------------------------------------------
// Video4Linux2 — /dev/video<N>. Magic byte 'V' (0x56).
// ---------------------------------------------------------------------------

pub con VIDIOC_QUERYCAP:       int64 := 0x80685600;
pub con VIDIOC_ENUM_FMT:       int64 := 0xC0405602;
pub con VIDIOC_G_FMT:          int64 := 0xC0CC5604;
pub con VIDIOC_S_FMT:          int64 := 0xC0CC5605;
pub con VIDIOC_REQBUFS:        int64 := 0xC0145608;
pub con VIDIOC_QUERYBUF:       int64 := 0xC0445609;
pub con VIDIOC_QBUF:           int64 := 0xC044560F;
pub con VIDIOC_DQBUF:          int64 := 0xC0445611;
pub con VIDIOC_STREAMON:       int64 := 0x40045612;
pub con VIDIOC_STREAMOFF:      int64 := 0x40045613;
pub con VIDIOC_G_PARM:         int64 := 0xC0CC5615;
pub con VIDIOC_S_PARM:         int64 := 0xC0CC5616;

// ---------------------------------------------------------------------------
// IIO (Industrial I/O) — gyro/accel/magnetometer/etc via /dev/iio:device<N>.
// Magic byte 'i' (0x69).
// ---------------------------------------------------------------------------

pub con IIO_GET_EVENT_FD_IOCTL:    int64 := 0x80046990;
pub con IIO_BUFFER_GET_FD_IOCTL:   int64 := 0xC0046991;

// ---------------------------------------------------------------------------
// Reserved syscall numbers (for reference / future use).
// Binder, the Android IPC mechanism, is intentionally NOT exposed here —
// it has dozens of commands and a complex parcel format that warrants its
// own module (deferred to Phase 4, see WP-AND-06).
// ---------------------------------------------------------------------------

pub con BINDER_DEVICE_PATH_TODO: int64 := 0;  // /dev/binder — see WP-AND-06
