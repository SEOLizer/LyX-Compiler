// std/hardware/pci_types.lyx
// PCI-01: Konstanten des PCI-/PCIe-Konfigurationsraums.
//
// Reine Konstanten-Unit plus zwei kleine Nachschlagefunktionen. Enthaelt
// keine Zugriffslogik — damit haengt sie an keinem Backend und ist auf jedem
// Ziel (Linux, LyxOS, bare metal) verwendbar.
//
// Warum negative, sprechende Fehlercodes: 0 ist ein voellig gueltiger
// Registerinhalt. Ein Leser, der "ging nicht" als 0 zurueckgibt, macht aus
// jedem Fehlschlag ein plausibles Ergebnis — genau die stille Fehlfunktion,
// die dieses Repo an anderer Stelle schon teuer bezahlt hat.

@description("PCI configuration space constants")
@author("Andreas Roene")
unit std.hardware.pci_types;

// ============================================================
// Fehlercodes (alle negativ, keiner kollidiert mit Registerwerten)
// ============================================================

pub con PCI_E_NODEV:     int64 := -1;   // kein Geraet an dieser BDF
pub con PCI_E_PERM:      int64 := -2;   // Zugriff verweigert (root noetig)
pub con PCI_E_NOBACKEND: int64 := -3;   // Kontext hat kein Config-Backend
pub con PCI_E_CAPLOOP:   int64 := -4;   // Capability-Kette zeigt im Kreis
pub con PCI_E_NOTSUP:    int64 := -5;   // Weg auf diesem Ziel nicht verfuegbar
pub con PCI_E_NODB:      int64 := -6;   // pci.ids nicht gefunden
pub con PCI_E_NOIOMMU:   int64 := -7;   // VFIO ohne aktives IOMMU
pub con PCI_E_BADARG:    int64 := -8;   // unsinniges Argument (BDF, BAR-Index)
pub con PCI_E_IO:        int64 := -9;   // Lese-/Schreibfehler am Backend
pub con PCI_E_NOMEM:     int64 := -10;  // Allokation fehlgeschlagen
pub con PCI_E_RANGE:     int64 := -11;  // Offset ausserhalb des Config-Raums

// ============================================================
// Config-Space-Header, Typ 0 (Endpoint)
// ============================================================

pub con PCI_CFG_VENDOR_ID:      int64 := 0x00;  // 16 Bit; 0xFFFF = kein Geraet
pub con PCI_CFG_DEVICE_ID:      int64 := 0x02;  // 16 Bit
pub con PCI_CFG_COMMAND:        int64 := 0x04;  // 16 Bit
pub con PCI_CFG_STATUS:         int64 := 0x06;  // 16 Bit
pub con PCI_CFG_REVISION:       int64 := 0x08;  // 8 Bit
pub con PCI_CFG_PROG_IF:        int64 := 0x09;  // 8 Bit
pub con PCI_CFG_SUBCLASS:       int64 := 0x0A;  // 8 Bit
pub con PCI_CFG_CLASS:          int64 := 0x0B;  // 8 Bit
pub con PCI_CFG_CACHE_LINE:     int64 := 0x0C;  // 8 Bit
pub con PCI_CFG_LATENCY:        int64 := 0x0D;  // 8 Bit
pub con PCI_CFG_HEADER_TYPE:    int64 := 0x0E;  // 8 Bit
pub con PCI_CFG_BIST:           int64 := 0x0F;  // 8 Bit
pub con PCI_CFG_BAR0:           int64 := 0x10;  // 6 x 32 Bit bis 0x24
pub con PCI_CFG_CARDBUS_CIS:    int64 := 0x28;
pub con PCI_CFG_SUBSYS_VENDOR:  int64 := 0x2C;  // 16 Bit
pub con PCI_CFG_SUBSYS_ID:      int64 := 0x2E;  // 16 Bit
pub con PCI_CFG_ROM_BAR:        int64 := 0x30;  // 32 Bit
pub con PCI_CFG_CAP_PTR:        int64 := 0x34;  // 8 Bit
pub con PCI_CFG_INT_LINE:       int64 := 0x3C;  // 8 Bit
pub con PCI_CFG_INT_PIN:        int64 := 0x3D;  // 8 Bit

// Header Typ 1 (Bridge) — abweichende Felder
pub con PCI_CFG_PRIMARY_BUS:    int64 := 0x18;  // 8 Bit
pub con PCI_CFG_SECONDARY_BUS:  int64 := 0x19;  // 8 Bit
pub con PCI_CFG_SUBORDINATE:    int64 := 0x1A;  // 8 Bit

// Groessen des Konfigurationsraums
pub con PCI_CFG_SIZE_LEGACY: int64 := 256;   // ueber CF8/CFC erreichbar
pub con PCI_CFG_SIZE_PCIE:   int64 := 4096;  // nur ueber ECAM/sysfs

pub con PCI_BAR_COUNT: int64 := 6;

// ============================================================
// Header-Typ
// ============================================================

pub con PCI_HDR_TYPE_MASK:      int64 := 0x7F;
pub con PCI_HDR_MULTIFUNCTION:  int64 := 0x80;  // Bit 7

pub con PCI_HDR_ENDPOINT: int64 := 0x00;
pub con PCI_HDR_BRIDGE:   int64 := 0x01;
pub con PCI_HDR_CARDBUS:  int64 := 0x02;

// ============================================================
// Command-Register (0x04)
// ============================================================

pub con PCI_CMD_IO_SPACE:      int64 := 0x0001;  // Bit 0
pub con PCI_CMD_MEM_SPACE:     int64 := 0x0002;  // Bit 1
pub con PCI_CMD_BUS_MASTER:    int64 := 0x0004;  // Bit 2
pub con PCI_CMD_PARITY_ERR:    int64 := 0x0040;  // Bit 6
pub con PCI_CMD_SERR:          int64 := 0x0100;  // Bit 8
pub con PCI_CMD_INTX_DISABLE:  int64 := 0x0400;  // Bit 10

// ============================================================
// Status-Register (0x06)
// ============================================================

pub con PCI_STATUS_CAP_LIST:   int64 := 0x0010;  // Bit 4: Cap-Liste vorhanden
pub con PCI_STATUS_66MHZ:      int64 := 0x0020;
pub con PCI_STATUS_MASTER_ABORT:  int64 := 0x2000;
pub con PCI_STATUS_SYSTEM_ERR:    int64 := 0x4000;
pub con PCI_STATUS_PARITY_ERR:    int64 := 0x8000;

// ============================================================
// BAR-Flags
// ============================================================

pub con PCI_BAR_SPACE_MASK:    int64 := 0x1;  // Bit 0: 1 = I/O, 0 = Memory
pub con PCI_BAR_SPACE_IO:      int64 := 0x1;
pub con PCI_BAR_SPACE_MEM:     int64 := 0x0;

pub con PCI_BAR_MEM_TYPE_MASK: int64 := 0x6;  // Bits 2:1
pub con PCI_BAR_MEM_TYPE_32:   int64 := 0x0;
pub con PCI_BAR_MEM_TYPE_1M:   int64 := 0x2;  // veraltet (unter 1 MB)
pub con PCI_BAR_MEM_TYPE_64:   int64 := 0x4;  // belegt zwei BAR-Slots

pub con PCI_BAR_PREFETCH:      int64 := 0x8;  // Bit 3

pub con PCI_BAR_MEM_ADDR_MASK: int64 := -16;  // ~0xF, Adresse ab Bit 4
pub con PCI_BAR_IO_ADDR_MASK:  int64 := -4;   // ~0x3, Adresse ab Bit 2

// ============================================================
// Capability-IDs (Standard-Liste ab 0x34)
// ============================================================

pub con PCI_CAP_ID_PM:      int64 := 0x01;  // Power Management
pub con PCI_CAP_ID_AGP:     int64 := 0x02;
pub con PCI_CAP_ID_VPD:     int64 := 0x03;
pub con PCI_CAP_ID_MSI:     int64 := 0x05;
pub con PCI_CAP_ID_VENDOR:  int64 := 0x09;
pub con PCI_CAP_ID_PCIE:    int64 := 0x10;
pub con PCI_CAP_ID_MSIX:    int64 := 0x11;

// Extended Capabilities (nur PCIe, ab 0x100)
pub con PCI_EXT_CAP_START:  int64 := 0x100;
pub con PCI_EXT_CAP_ID_AER:  int64 := 0x0001;
pub con PCI_EXT_CAP_ID_VC:   int64 := 0x0002;
pub con PCI_EXT_CAP_ID_SN:   int64 := 0x0003;
pub con PCI_EXT_CAP_ID_SRIOV: int64 := 0x0010;

// Obergrenze fuer den Kettenlauf. 256 Bytes Config-Raum bei mindestens
// 4 Byte je Capability ergeben nie mehr als 64 Eintraege; 48 ist grosszuegig
// und begrenzt zugleich einen Zyklus.
pub con PCI_CAP_MAX_STEPS: int64 := 48;

// ============================================================
// Class-Codes (Basisklassen). Diese Tabelle ist bewusst klein und inline:
// sie steht in der Spezifikation fest und muss auch dann Namen liefern,
// wenn keine pci.ids-Datei gefunden wird.
// ============================================================

pub con PCI_CLASS_UNCLASSIFIED: int64 := 0x00;
pub con PCI_CLASS_STORAGE:      int64 := 0x01;
pub con PCI_CLASS_NETWORK:      int64 := 0x02;
pub con PCI_CLASS_DISPLAY:      int64 := 0x03;
pub con PCI_CLASS_MULTIMEDIA:   int64 := 0x04;
pub con PCI_CLASS_MEMORY:       int64 := 0x05;
pub con PCI_CLASS_BRIDGE:       int64 := 0x06;
pub con PCI_CLASS_COMM:         int64 := 0x07;
pub con PCI_CLASS_SYSTEM:       int64 := 0x08;
pub con PCI_CLASS_INPUT:        int64 := 0x09;
pub con PCI_CLASS_DOCKING:      int64 := 0x0A;
pub con PCI_CLASS_PROCESSOR:    int64 := 0x0B;
pub con PCI_CLASS_SERIAL_BUS:   int64 := 0x0C;
pub con PCI_CLASS_WIRELESS:     int64 := 0x0D;
pub con PCI_CLASS_INTELLIGENT:  int64 := 0x0E;
pub con PCI_CLASS_SATELLITE:    int64 := 0x0F;
pub con PCI_CLASS_ENCRYPTION:   int64 := 0x10;
pub con PCI_CLASS_SIGNAL:       int64 := 0x11;
pub con PCI_CLASS_ACCELERATOR:  int64 := 0x12;
pub con PCI_CLASS_INSTRUMENT:   int64 := 0x13;
pub con PCI_CLASS_UNASSIGNED:   int64 := 0xFF;

// Ausgewaehlte Subklassen, die haeufig gebraucht werden.
pub con PCI_SUBCLASS_STORAGE_SCSI:  int64 := 0x00;
pub con PCI_SUBCLASS_STORAGE_IDE:   int64 := 0x01;
pub con PCI_SUBCLASS_STORAGE_SATA:  int64 := 0x06;
pub con PCI_SUBCLASS_STORAGE_NVME:  int64 := 0x08;
pub con PCI_SUBCLASS_NETWORK_ETH:   int64 := 0x00;
pub con PCI_SUBCLASS_DISPLAY_VGA:   int64 := 0x00;
pub con PCI_SUBCLASS_BRIDGE_HOST:   int64 := 0x00;
pub con PCI_SUBCLASS_BRIDGE_ISA:    int64 := 0x01;
pub con PCI_SUBCLASS_BRIDGE_PCI:    int64 := 0x04;
pub con PCI_SUBCLASS_SERIAL_USB:    int64 := 0x03;

// Name der Basisklasse. Unbekannte Klasse liefert "Unknown class" — der
// Aufrufer bekommt einen Text, der ihn nicht in die Irre fuehrt.
pub fn PciClassNameBuiltin(cls: int64): pchar {
  if (cls == PCI_CLASS_UNCLASSIFIED) { return "Unclassified device"; }
  if (cls == PCI_CLASS_STORAGE)      { return "Mass storage controller"; }
  if (cls == PCI_CLASS_NETWORK)      { return "Network controller"; }
  if (cls == PCI_CLASS_DISPLAY)      { return "Display controller"; }
  if (cls == PCI_CLASS_MULTIMEDIA)   { return "Multimedia controller"; }
  if (cls == PCI_CLASS_MEMORY)       { return "Memory controller"; }
  if (cls == PCI_CLASS_BRIDGE)       { return "Bridge"; }
  if (cls == PCI_CLASS_COMM)         { return "Communication controller"; }
  if (cls == PCI_CLASS_SYSTEM)       { return "Generic system peripheral"; }
  if (cls == PCI_CLASS_INPUT)        { return "Input device controller"; }
  if (cls == PCI_CLASS_DOCKING)      { return "Docking station"; }
  if (cls == PCI_CLASS_PROCESSOR)    { return "Processor"; }
  if (cls == PCI_CLASS_SERIAL_BUS)   { return "Serial bus controller"; }
  if (cls == PCI_CLASS_WIRELESS)     { return "Wireless controller"; }
  if (cls == PCI_CLASS_INTELLIGENT)  { return "Intelligent controller"; }
  if (cls == PCI_CLASS_SATELLITE)    { return "Satellite communications controller"; }
  if (cls == PCI_CLASS_ENCRYPTION)   { return "Encryption controller"; }
  if (cls == PCI_CLASS_SIGNAL)       { return "Signal processing controller"; }
  if (cls == PCI_CLASS_ACCELERATOR)  { return "Processing accelerator"; }
  if (cls == PCI_CLASS_INSTRUMENT)   { return "Non-Essential Instrumentation"; }
  if (cls == PCI_CLASS_UNASSIGNED)   { return "Unassigned class"; }
  return "Unknown class";
}

// Name eines Fehlercodes — fuer Fehlermeldungen, damit nirgends eine nackte
// negative Zahl beim Anwender landet.
pub fn PciErrorName(code: int64): pchar {
  if (code == PCI_E_NODEV)     { return "no such PCI device"; }
  if (code == PCI_E_PERM)      { return "permission denied (root required?)"; }
  if (code == PCI_E_NOBACKEND) { return "no config space backend selected"; }
  if (code == PCI_E_CAPLOOP)   { return "capability list contains a loop"; }
  if (code == PCI_E_NOTSUP)    { return "not supported on this target"; }
  if (code == PCI_E_NODB)      { return "pci.ids database not found"; }
  if (code == PCI_E_NOIOMMU)   { return "no IOMMU / device not bound to vfio-pci"; }
  if (code == PCI_E_BADARG)    { return "invalid argument"; }
  if (code == PCI_E_IO)        { return "I/O error on config space"; }
  if (code == PCI_E_NOMEM)     { return "out of memory"; }
  if (code == PCI_E_RANGE)     { return "offset outside config space"; }
  if (code >= 0)               { return "success"; }
  return "unknown PCI error";
}
