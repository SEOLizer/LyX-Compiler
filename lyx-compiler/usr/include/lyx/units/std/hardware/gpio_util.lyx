// std/hardware/gpio_util.lyx
// WP-3.0: Hilfsfunktionen für ioctl (WP-3) und Erweiterungen (WP-5)
//
// Voraussetzung: WP-1 (Syscalls) abgeschlossen.
@capabilities([system.time])

unit std.hardware.gpio_util;

import std.alloc;

// ============================================================
// WP-3.0 AC-1/2: GpioCopyStringToBuf
//
// Kopiert null-terminierten String src in Puffer dst.
// Schreibt höchstens max_len-1 Bytes, dann immer NUL-Terminator.
// Rückgabe: Anzahl geschriebener Bytes ohne NUL.
// ============================================================
pub fn GpioCopyStringToBuf(src: pchar, dst: int64, max_len: int64): int64 {
  if (max_len <= 0) { return 0; }
  var i: int64     := 0;
  var limit: int64 := max_len - 1;
  var c: int64     := StrCharAt(src, 0);
  while (i < limit && c != 0) {
    poke8(dst + i, c);
    i += 1;
    c := StrCharAt(src, i);
  }
  poke8(dst + i, 0);   // NUL-Terminator immer setzen
  return i;
}

// ============================================================
// WP-3.0 AC-3/4: GpioDelayMicroseconds
//
// Busy-Wait für mindestens delay_us Mikrosekunden.
// Nutzt CLOCK_MONOTONIC (Linux x86-64 + ARM64).
// Bei delay_us <= 0: sofortige Rückkehr (AC-4).
//
// Genauigkeit: ± 1–2 µs (systemlastabhängig).
// Für Delays < 1 µs: nop-basierter Busy-Wait in gpio_mmio präziser.
// ============================================================

pub con GPIO_CLOCK_MONOTONIC: int64 := 1;
pub con GPIO_TIMESPEC_SIZE:   int64 := 16;   // sec(8) + nsec(8)
pub con GPIO_NS_PER_US:       int64 := 1000;
pub con GPIO_NS_PER_SEC:      int64 := 1000000000;

fn gpioGetNs(): int64 {
  var ts: int64 := alloc(GPIO_TIMESPEC_SIZE);
  if (ts == 0) { return 0; }
  clock_gettime(GPIO_CLOCK_MONOTONIC, ts);
  var sec:  int64 := peek64(ts);
  var nsec: int64 := peek64(ts + 8);
  free(ts, GPIO_TIMESPEC_SIZE);
  return sec * GPIO_NS_PER_SEC + nsec;
}

pub fn GpioDelayMicroseconds(delay_us: int64) {
  if (delay_us <= 0) { return; }
  var startNs:  int64 := gpioGetNs();
  var targetNs: int64 := delay_us * GPIO_NS_PER_US;
  var elapsed:  int64 := 0;
  while (elapsed < targetNs) {
    elapsed := gpioGetNs() - startNs;
  }
}
