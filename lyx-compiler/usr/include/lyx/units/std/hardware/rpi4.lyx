// std/hardware/rpi4.lyx
// WP-2.1: Hardware-Adressen und Register-Offsets für Raspberry Pi 4 (BCM2711)
//
// Basis: BCM2711 Datasheet, Peripheral Base = 0xFE000000
// GPIO-Basis: PERIPHERAL_BASE + 0x200000 = 0xFE200000

unit std.hardware.rpi4;

// ============================================================
// Plattform-Adressen
// ============================================================

pub con RPI4_PERIPHERAL_BASE: int64 := 0xFE000000;
pub con RPI4_GPIO_BASE:       int64 := 0xFE200000;  // = PERIPHERAL_BASE + 0x200000

// GPIO-Mapping-Größe (eine Seite reicht für alle GPIO-Register)
pub con RPI4_GPIO_MAP_SIZE: int64 := 4096;

// ============================================================
// Function-Select-Register (GPFSEL0–GPFSEL5)
// 3 Bits pro Pin; 10 Pins pro Register
// Bit-Kodierung: 000=Input  001=Output  100=Alt0  101=Alt1
//               110=Alt2   111=Alt3   011=Alt4  010=Alt5
// Byte-Offsets ab GPIO_BASE:
// ============================================================

pub con RPI4_GPFSEL0: int64 := 0x00;   // Pins  0– 9
pub con RPI4_GPFSEL1: int64 := 0x04;   // Pins 10–19
pub con RPI4_GPFSEL2: int64 := 0x08;   // Pins 20–29
pub con RPI4_GPFSEL3: int64 := 0x0C;   // Pins 30–39
pub con RPI4_GPFSEL4: int64 := 0x10;   // Pins 40–49
pub con RPI4_GPFSEL5: int64 := 0x14;   // Pins 50–53

// ============================================================
// Set/Clear/Level-Register (je 2 × 32 Bit für Pins 0–31 / 32–53)
// GPSET: Write-1-to-set  (atomares Setzen, kein RMW nötig)
// GPCLR: Write-1-to-clear
// GPLEV: Read-Only (aktueller Pin-Pegel)
// ============================================================

pub con RPI4_GPSET0: int64 := 0x1C;   // Pins  0–31 setzen
pub con RPI4_GPSET1: int64 := 0x20;   // Pins 32–53 setzen
pub con RPI4_GPCLR0: int64 := 0x28;   // Pins  0–31 löschen
pub con RPI4_GPCLR1: int64 := 0x2C;   // Pins 32–53 löschen
pub con RPI4_GPLEV0: int64 := 0x34;   // Pins  0–31 lesen
pub con RPI4_GPLEV1: int64 := 0x38;   // Pins 32–53 lesen

// ============================================================
// Pull-Widerstands-Register — Legacy (BCM2711 Rev < 1.2 / BCM2835)
// 3-Schritt-Protokoll: GPPUD → GPPUDCLK → Reset
// ============================================================

pub con RPI4_GPPUD:     int64 := 0x94;   // Pull-Control (0=None,1=Down,2=Up)
pub con RPI4_GPPUDCLK0: int64 := 0x98;   // Clock Pins  0–31
pub con RPI4_GPPUDCLK1: int64 := 0x9C;   // Clock Pins 32–53

// ============================================================
// Pull-Widerstands-Register — Neu (BCM2711 Rev >= 1.2)
// 2 Bits pro Pin: 00=None  01=PullDown  10=PullUp
// ============================================================

pub con RPI4_PUP_PDN_REG0: int64 := 0xE4;  // Pins  0–15
pub con RPI4_PUP_PDN_REG1: int64 := 0xE8;  // Pins 16–31
pub con RPI4_PUP_PDN_REG2: int64 := 0xEC;  // Pins 32–47
pub con RPI4_PUP_PDN_REG3: int64 := 0xF0;  // Pins 48–53

// ============================================================
// Pin-Modus-Codes (GPFSEL 3-Bit-Kodierung)
// ============================================================

pub con RPI4_MODE_INPUT:  int64 := 0;   // 000
pub con RPI4_MODE_OUTPUT: int64 := 1;   // 001
pub con RPI4_MODE_ALT0:   int64 := 4;   // 100
pub con RPI4_MODE_ALT1:   int64 := 5;   // 101
pub con RPI4_MODE_ALT2:   int64 := 6;   // 110
pub con RPI4_MODE_ALT3:   int64 := 7;   // 111
pub con RPI4_MODE_ALT4:   int64 := 3;   // 011
pub con RPI4_MODE_ALT5:   int64 := 2;   // 010

// ============================================================
// Pull-Modus-Codes (für neue BCM2711-Register)
// ============================================================

pub con RPI4_PULL_NONE: int64 := 0;
pub con RPI4_PULL_DOWN: int64 := 1;
pub con RPI4_PULL_UP:   int64 := 2;

// ============================================================
// Plattform-Fähigkeit: Welches Pull-Register-Format ist aktiv?
// HAS_NEW_PULL_REGS = 1 → neue Register (BCM2711 Rev >= 1.2)
// HAS_NEW_PULL_REGS = 0 → Legacy-Protokoll (ältere Boards)
// ============================================================

pub con RPI4_HAS_NEW_PULL_REGS: int64 := 1;

// ============================================================
// Hilfsmakros als Inline-Funktionen (Compile-Time-Konstanten)
// ============================================================

// GPIO_MAP_FAILED: mmap-Fehler-Sentinel (-1 als int64)
pub con RPI4_MAP_FAILED: int64 := -1;

// Maximale Pin-Nummer auf BCM2711
pub con RPI4_MAX_PIN: int64 := 53;
