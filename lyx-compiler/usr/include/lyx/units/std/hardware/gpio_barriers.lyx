// std/hardware/gpio_barriers.lyx
// WP-1b: Memory- und Instruction-Barrier-Intrinsics für GPIO-MMIO
//
// Hintergrund (ARM64 / BCM2711 Out-of-Order):
//   Der Cortex-A72 kann Schreibvorgänge umordnen. Bei MMIO-Zugriffen
//   auf GPIO-Register (GPFSEL, GPSET, GPCLR, GPPUD) muss sichergestellt
//   werden, dass jeder Schreibvorgang beim Peripherie-Controller ankommt,
//   bevor der nächste beginnt.
//
// Faustregeln (aus gpio.md WP-2.0):
//   - Nach jedem Schreibzugriff auf ein GPIO-Register: mem_barrier()
//   - Nach sys_mmap vor erstem Register-Zugriff: mem_barrier()
//   - Zwischen SetPinMode und erstem WritePin/ReadPin: mem_barrier()
//   - Lese-Zugriffe (GPLEV): keine Barriere nötig
//
// Compiler-Intrinsics:
//   mem_barrier()  → ARM64: DMB SY (0xD5033FBF)  x86-64: MFENCE (0F AE F0)
//   inst_barrier() → ARM64: ISB SY (0xD5033FDF)  x86-64: LFENCE (0F AE E8)
//
// AC-3: mem_barrier() erzeugt im Disassembly exakt eine dmb sy-Instruktion.

unit std.hardware.gpio_barriers;

// ============================================================
// GpioMemBarrier — Full-System-Memory-Barrier
//
// Stellt sicher, dass alle vorherigen Speicherzugriffe abgeschlossen
// sind, bevor neue beginnen. Nach jedem GPIO-Register-Schreibzugriff.
// ============================================================
pub fn GpioMemBarrier() {
  mem_barrier();
}

// ============================================================
// GpioInstBarrier — Instruction-Synchronization-Barrier
//
// Flusht die Instruktions-Pipeline. Benötigt nach MMU- oder
// Cache-Konfigurationsänderungen, nicht für normales GPIO.
// ============================================================
pub fn GpioInstBarrier() {
  inst_barrier();
}
