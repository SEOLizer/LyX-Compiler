// std/alloc.lyx
// Explizite Speicherverwaltung für Lyx

@description("Memory allocator and heap management utilities")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
unit std.alloc;

pub con ALIGNMENT: int64 := 8;
pub con ERR_ALLOC_OK: int64 := 0;
pub con ERR_ALLOC_OOM: int64 := 1;
pub con ERR_ALLOC_INVALID: int64 := 2;
pub con ERR_ALLOC_ALIGN: int64 := 3;

// mmap-Schutzflags
pub con MMAP_PROT_NONE: int64 := 0;
pub con MMAP_PROT_RW:   int64 := 3;   // PROT_READ | PROT_WRITE
pub con MMAP_PROT_RX:   int64 := 5;   // PROT_READ | PROT_EXEC
pub con MMAP_PROT_RWX:  int64 := 7;   // PROT_READ | PROT_WRITE | PROT_EXEC

// mmap-Flags
pub con MMAP_ANON:   int64 := 34;  // MAP_PRIVATE | MAP_ANONYMOUS
pub con MMAP_SHARED: int64 := 1;   // MAP_SHARED (für File-mmap)

// Anonymer Heap-Speicher — mmap-basiert, kein libc
pub fn alloc(size: int64): int64 {
  // WP-26: Zero-Alloc-Guard — verhindert Aliasing-Angriff (C-2)
  if size <= 0 { size := 1; }
  // WP-26: Integer-Overflow-Guard — max 1 GB (C-1)
  if size > 1073741824 { return 0; }
  var result: int64 := mmap(0, size, MMAP_PROT_RW, MMAP_ANON, -1, 0);
  // MAP_FAILED (-1) → 0 zurückgeben statt ungültigen Pointer
  if result < 0 { return 0; }
  return result;
}

// MAP_ANONYMOUS liefert bereits zero-initialisierte Seiten
pub fn allocZeroed(size: int64): int64 {
  return alloc(size);
}

// Speicher freigeben
pub fn free(ptr: int64, size: int64): void {
  munmap(ptr, size);
}

// Deprecated libc-Bindungen (behalten für Kompatibilität)
extern fn libc_malloc(size: int64): int64;
extern fn libc_free(ptr: int64): int64;
extern fn libc_realloc(ptr: int64, size: int64): int64;

// Gibt aligned size zurück: ceil(size/8)*8
fn align_to_8(size: int64): int64 {
  var tmp: int64 := size + 7;
  var blocks: int64 := tmp / 8;
  var result: int64 := blocks * 8;
  return result;
}

pub fn malloc(size: int64): int64 {
  if (size <= 0) {
    return 0;
  }
  return libc_malloc(align_to_8(size));
}

pub fn calloc(count: int64, elem_size: int64): int64 {
  var total_size: int64 := count * elem_size;
  var ptr: int64 := malloc(total_size);
  if (ptr == 0) {
    return 0;
  }
  var i: int64 := 0;
  while (i < total_size) {
    poke8(ptr + i, 0);
    i := i + 1;
  }
  return ptr;
}

pub fn free_mem(ptr: int64): int64 {
  if (ptr == 0) {
    return ERR_ALLOC_OK;
  }
  libc_free(ptr);
  return ERR_ALLOC_OK;
}

pub fn realloc_mem(ptr: int64, new_size: int64): int64 {
  if (new_size <= 0) {
    return 0;
  }
  return libc_realloc(ptr, align_to_8(new_size));
}

pub fn size_of_int64(): int64 { return 8; }
pub fn size_of_ptr(): int64 { return 8; }

pub fn is_aligned(ptr: int64): bool {
  return ((ptr / 8) * 8) == ptr;
}

pub fn malloc_safe(size: int64): int64 {
  var ptr: int64 := malloc(size);
  if (ptr == 0) {
    return 0;
  }
  return ptr;
}

pub fn malloc_orpanic(size: int64): int64 {
  var ptr: int64 := malloc(size);
  while (ptr == 0) {
    ptr := malloc(size);
  }
  return ptr;
}
