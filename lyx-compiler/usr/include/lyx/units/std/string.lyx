unit std.string;

import std.alloc;

// Lexikografischer Vergleich, -1/0/1. sema registriert `StrCmp` als Builtin,
// aber kein Backend implementiert es — der Aufruf bestand sema und scheiterte
// erst im Codegen. Die interne Kopie in src/std/string.lyx hatte die Funktion,
// die öffentliche stdlib nicht.
// Dezimal-Parser: führende Whitespaces, optionales Vorzeichen, dann Ziffern.
// Bricht beim ersten Nicht-Ziffern-Zeichen ab. `StrToInt` war in sema als
// Builtin registriert, ohne dass ein Backend es implementierte.
pub fn StrToInt(s: pchar): int64 {
  var i: int64 := 0;
  var c: int64 := StrCharAt(s, i) & 255;
  while (c == 32 || c == 9) { i += 1; c := StrCharAt(s, i) & 255; }
  var neg: int64 := 0;
  if (c == 45) { neg := 1; i += 1; }
  else if (c == 43) { i += 1; }
  var n: int64 := 0;
  c := StrCharAt(s, i) & 255;
  while (c >= 48 && c <= 57) {
    n := n * 10 + (c - 48);
    i += 1;
    c := StrCharAt(s, i) & 255;
  }
  if (neg != 0) { return 0 - n; }
  return n;
}

pub fn StrCmp(a: pchar, b: pchar): int64 {
  var i: int64 := 0;
  while (true) {
    var ca: int64 := StrCharAt(a, i) & 255;
    var cb: int64 := StrCharAt(b, i) & 255;
    if (ca != cb) {
      if (ca < cb) { return 0 - 1; }
      return 1;
    }
    if (ca == 0) { return 0; }
    i += 1;
  }
  return 0;
}

pub fn StrFind(haystack: pchar, needle: pchar): int64 {
  // Findet erste Occurrence von needle in haystack
  // Return: Index oder -1 wenn nicht gefunden
  var hay_len: int64 := StrLen(haystack);
  var needle_len: int64 := StrLen(needle);
  
  if (needle_len == 0) { return 0; }  // empty needle matches at start
  if (needle_len > hay_len) { return -1; }
  
  var i: int64 := 0;
  while (i <= hay_len - needle_len) {
    var isMatch: bool := true;
    var j: int64 := 0;
    
    while (j < needle_len && isMatch) {
      if (StrCharAt(haystack, i + j) != StrCharAt(needle, j)) {
        isMatch := false;
      }
      j += 1;
    }
    
    if (isMatch) { return i; }
    i += 1;
  }
  return -1;
}

pub fn StrSafeCharAt(s: pchar, index: int64): int64 {
  // Sicherer Character-Zugriff mit Bounds-Check
  // Return: Character-Code oder -1 wenn Index außerhalb
  var len: int64 := StrLen(s);
  if (index < 0 || index >= len) { return -1; }
  return StrCharAt(s, index);
}

// ============================================================================
// CASE CONVERSION
// ============================================================================

pub fn CharToLower(c: int64): int64 {
  // Konvertiert einzelnes Character zu lowercase
  if (c >= 65 && c <= 90) {  // 'A' bis 'Z'
    return c + 32;  // zu 'a' bis 'z'  
  }
  return c;
}

pub fn CharToUpper(c: int64): int64 {
  // Konvertiert einzelnes Character zu uppercase
  if (c >= 97 && c <= 122) {  // 'a' bis 'z'
    return c - 32;  // zu 'A' bis 'Z'
  }
  return c;
}

pub fn StrToLower(dest: pchar, src: pchar): pchar {
  // Konvertiert String zu lowercase (dest kann == src sein)
  var len: int64 := StrLen(src);
  var i: int64 := 0;
  while (i < len) {
    StrSetChar(dest, i, CharToLower(StrCharAt(src, i)));
    i += 1;
  }
  StrSetChar(dest, len, 0);  // null-terminator
  return dest;
}

pub fn StrToUpper(dest: pchar, src: pchar): pchar {
  // Konvertiert String zu uppercase (dest kann == src sein)
  var len: int64 := StrLen(src);
  var i: int64 := 0;
  while (i < len) {
    StrSetChar(dest, i, CharToUpper(StrCharAt(src, i)));
    i += 1;
  }
  StrSetChar(dest, len, 0);  // null-terminator
  return dest;
}

// ============================================================================
// BOOLEAN STRING TESTS
// ============================================================================

// StrEquals, StrStartsWith, StrEndsWith are builtins — not redefined here.

pub fn IsWhitespace(c: int64): bool {
  // Prüft ob Character Whitespace ist
  return (c == 32 || c == 9 || c == 10 || c == 13);  // ' ', '\t', '\n', '\r'
}

// ============================================================================
// STRING MODIFICATION FUNCTIONS
// ============================================================================

// StrConcat(s1, s2): pchar is a builtin — not redefined here.

pub fn StrReverse(s: pchar): pchar {
  // Kehrt String in-place um
  var len: int64 := StrLen(s);
  var i: int64 := 0;
  var j: int64 := len - 1;
  
  while (i < j) {
    var temp: int64 := StrCharAt(s, i);
    StrSetChar(s, i, StrCharAt(s, j));
    StrSetChar(s, j, temp);
    i += 1;
    j -= 1;
  }
  return s;
}

// ============================================================================
// CHARACTER POSITION FUNCTIONS
// ============================================================================

pub fn StrIndexOfChar(s: pchar, c: int64, startIndex: int64): int64 {
  // Findet erste Position von Zeichen c ab startIndex
  // Return: Index oder -1 wenn nicht gefunden
  var len: int64 := StrLen(s);
  if (startIndex < 0) { startIndex := 0; }
  if (startIndex >= len) { return -1; }
  
  var i: int64 := startIndex;
  while (i < len) {
    if (StrCharAt(s, i) == c) { return i; }
    i += 1;
  }
  return -1;
}

pub fn StrLastIndexOfChar(s: pchar, c: int64): int64 {
  // Findet letzte Position von Zeichen c
  // Return: Index oder -1 wenn nicht gefunden
  var len: int64 := StrLen(s);
  if (len == 0) { return -1; }
  
  var i: int64 := len - 1;
  while (i >= 0) {
    if (StrCharAt(s, i) == c) { return i; }
    i -= 1;
  }
  return -1;
}

// Hinweis: Lyx hat keine dynamischen Arrays in der stdlib,
// daher kann AllIndicesOfChar keinen Array zurückgeben.
// Als Alternative: Callback-basiert oder mit festem Buffer

pub fn StrAllIndicesOfCharCount(s: pchar, c: int64): int64 {
  // Zählt wie oft Zeichen c in s vorkommt
  var len: int64 := StrLen(s);
  var count: int64 := 0;
  var i: int64 := 0;
  
  while (i < len) {
    if (StrCharAt(s, i) == c) { count := count + 1; }
    i += 1;
  }
  return count;
}

pub fn StrTrimWhitespace(dest: pchar, src: pchar): pchar {
  // Entfernt führende und nachfolgende Whitespace
  var len: int64 := StrLen(src);
  
  // Führende Whitespace finden
  var start: int64 := 0;
  while (start < len && IsWhitespace(StrCharAt(src, start))) {
    start += 1;
  }
  
  // Nachfolgende Whitespace finden
  var end: int64 := len - 1;
  while (end >= start && IsWhitespace(StrCharAt(src, end))) {
    end -= 1;
  }
  
  // String kopieren
  var i: int64 := 0;
  while (start <= end) {
    StrSetChar(dest, i, StrCharAt(src, start));
    start += 1;
    i += 1;
  }
  StrSetChar(dest, i, 0);  // null-terminator
  
  return dest;
}

// ============================================================================
// SUBSTRING OPERATIONS
// ============================================================================

pub fn StrSubstring(dest: pchar, src: pchar, start: int64, len: int64): pchar {
  // Kopiert Teilstring von src nach dest
  // start: Startposition (0-basiert)
  // len: Anzahl Zeichen
  var src_len: int64 := StrLen(src);
  
  if (start < 0) { start := 0; }
  if (start >= src_len) { StrSetChar(dest, 0, 0); return dest; }
  if (len > src_len - start) { len := src_len - start; }
  
  var i: int64 := 0;
  while (i < len) {
    StrSetChar(dest, i, StrCharAt(src, start + i));
    i += 1;
  }
  StrSetChar(dest, len, 0);
  return dest;
}

// ============================================================================
// SEARCH AND REPLACE
// ============================================================================

pub fn StrContains(s: pchar, needle: pchar): bool {
  // Prüft ob String needle enthält
  return StrFind(s, needle) >= 0;
}

pub fn StrIndexOf(s: pchar, needle: pchar, startIndex: int64): int64 {
  // Findet Position von needle ab startIndex
  var hay_len: int64 := StrLen(s);
  var needle_len: int64 := StrLen(needle);
  
  if (needle_len == 0) { return 0; }
  if (needle_len > hay_len) { return -1; }
  
  var i: int64 := startIndex;
  if (i < 0) { i := 0; }
  
  while (i <= hay_len - needle_len) {
    var isMatch: bool := true;
    var j: int64 := 0;
    
    while (j < needle_len && isMatch) {
      if (StrCharAt(s, i + j) != StrCharAt(needle, j)) {
        isMatch := false;
      }
      j += 1;
    }
    
    if (isMatch) { return i; }
    i += 1;
  }
  return -1;
}

// #1259: Zwei Fehler in einer Funktion.
//
// (1) Der Text ZWISCHEN zwei Treffern fiel weg. `i` war zugleich Ziel- und
//     Quellindex: verglichen wurde gegen `pos - last` (die Laenge des aktuellen
//     Zwischenstuecks), gelesen wurde ab `last + i`. Nach dem ersten Treffer
//     stand `i` bereits hinter dem eingesetzten Ersatztext, die Bedingung war
//     sofort falsch. `aXbXc` mit `X`→`--` ergab `a----c` statt `a--b--c`.
//     Ziel und Quelle haben jetzt getrennte Zaehler.
//
// (2) Der Arbeitspuffer war ein 80-Zeichen-String-LITERAL. Ein laengeres
//     Ergebnis lief darueber hinaus in angrenzenden Speicher — ein
//     Pufferueberlauf mit fester, nirgends dokumentierter Grenze. Und der
//     uebergebene `dest` wurde erst ganz am Ende befuellt, die eigentliche
//     Arbeit lief immer ueber das Literal, unabhaengig davon, wie gross der
//     Aufrufer seinen Puffer gemacht hat.
//
//     Der Zwischenpuffer wird jetzt auf die tatsaechlich noetige Laenge
//     alloziert (und wieder freigegeben). Er bleibt noetig, damit `dest` und
//     `src` dieselbe Ablage sein duerfen.
pub fn StrReplace(dest: pchar, src: pchar, old: pchar, replacement: pchar): pchar {
  var srcLen:  int64 := StrLen(src);
  var oldLen:  int64 := StrLen(old);
  var replLen: int64 := StrLen(replacement);

  // Ein leeres Suchmuster haette keinen Fortschritt — unveraendert kopieren.
  if (oldLen == 0) {
    var c: int64 := 0;
    while (c < srcLen) {
      StrSetChar(dest, c, StrCharAt(src, c));
      c += 1;
    }
    StrSetChar(dest, srcLen, 0);
    return dest;
  }

  // Treffer zaehlen, um den Puffer genau zu bemessen.
  var hits: int64 := 0;
  var scan: int64 := 0;
  while (scan <= srcLen - oldLen) {
    var f: int64 := StrFind(src + scan, old);
    if (f < 0) { scan := srcLen + 1; }
    else {
      hits += 1;
      scan := scan + f + oldLen;
    }
  }

  var outLen: int64 := srcLen + hits * replLen - hits * oldLen;
  var result: pchar := alloc(outLen + 1) as pchar;

  var i:    int64 := 0;   // Zielindex im Ergebnis
  var last: int64 := 0;   // Quellindex hinter dem letzten Treffer
  var pos:  int64 := StrFind(src, old);

  while (pos >= 0) {
    var k: int64 := 0;    // #1259: eigener Zaehler fuer das Zwischenstueck
    while (k < pos - last) {
      StrSetChar(result, i, StrCharAt(src, last + k));
      i += 1;
      k += 1;
    }
    var j: int64 := 0;
    while (j < replLen) {
      StrSetChar(result, i, StrCharAt(replacement, j));
      i += 1;
      j += 1;
    }
    last := pos + oldLen;
    pos := StrFind(src + last, old);
    if (pos >= 0) { pos := pos + last; }
  }

  while (last < srcLen) {
    StrSetChar(result, i, StrCharAt(src, last));
    i += 1;
    last += 1;
  }
  StrSetChar(result, i, 0);

  var d: int64 := 0;
  while (d < i) {
    StrSetChar(dest, d, StrCharAt(result, d));
    d += 1;
  }
  StrSetChar(dest, i, 0);
  free(result as int64, outLen + 1);
  return dest;
}

// ============================================================================
// CHARACTER CASE OPERATIONS (FIRST/LAST CHAR)
// ============================================================================

pub fn StrFirstCharToUpper(s: pchar): pchar {
  if (StrLen(s) == 0) { return s; }
  var first: int64 := StrCharAt(s, 0);
  if (first >= 97 && first <= 122) { first := first - 32; }
  // #1259: war ein 80-Zeichen-String-LITERAL, das sich ALLE diese
  // Funktionen teilten — zwei Aufrufe hintereinander lieferten denselben
  // Zeiger, der zweite ueberschrieb das Ergebnis des ersten. Laengere
  // Zeichenketten liefen ausserdem darueber hinaus. Jetzt bekommt jeder
  // Aufruf seinen eigenen Speicher.
  var result: pchar := alloc(StrLen(s) + 2) as pchar;
  StrSetChar(result, 0, first);
  var i: int64 := 1;
  while (i < StrLen(s)) {
    StrSetChar(result, i, StrCharAt(s, i));
    i += 1;
  }
  StrSetChar(result, i, 0);
  return result;
}

