// ============================================================================
// STRING COUNT
// ============================================================================

pub fn StrCount(s: pchar, needle: pchar): int64 {
  var count: int64 := 0;
  var pos: int64 := 0;
  var needle_len: int64 := StrLen(needle);

  if (needle_len == 0) { return 0; }

  while (pos < StrLen(s)) {
    var found: int64 := StrIndexOf(s, needle, pos);
    if (found < 0) { return count; }
    count += 1;
    pos := found + needle_len;
  }
  return count;
}

// ============================================================================
// STRINGBUILDER CLASS — dynamic string accumulator using StrNew/StrAppendStr
// ============================================================================

pub type StringBuilder = class {
  buf: pchar;
  cap: int64;   // #1377: belegte Groesse des Puffers
  len: int64;   // #1377: benutzte Laenge (ohne die abschliessende 0)

  // #1377: Der Puffer wurde bei Init einmal angelegt und danach NIE
  // vergroessert. `StrAppendStr` haengt an Ort und Stelle an und kennt keine
  // Kapazitaet — wer mehr anhaengte, als hineinpasste, schrieb hinter das Ende
  // und zerschrieb den Heap. Ein `sb.Init(16)` mit drei Append war genug.
  //
  // Ausserdem stand hier zweimal `poke64(addr - 8, …)`, als traege StrNew ein
  // Laengenwort vor dem Puffer. Das tut es nicht: StrNew ist ein blankes mmap.
  // Die Schreibzugriffe gingen also in die Seite DAVOR.
  //
  // Jetzt fuehrt der Builder seine eigene Buchhaltung und waechst, wenn es eng
  // wird.
  fn Init(initialCap: int64) {
    var c: int64 := initialCap;
    if (c < 16) { c := 16; }
    self.buf := StrNew(c);
    self.cap := c;
    self.len := 0;
    StrSetChar(self.buf, 0, 0);
  }

  // Platz fuer `zusatz` weitere Zeichen schaffen (plus die abschliessende 0).
  fn Reserve(zusatz: int64) {
    var noetig: int64 := self.len + zusatz + 1;
    if (noetig <= self.cap) { return; }
    var neu: int64 := self.cap * 2;
    if (neu < 16) { neu := 16; }
    while (neu < noetig) { neu := neu * 2; }
    var nb: pchar := StrNew(neu);
    var i: int64 := 0;
    while (i < self.len) {
      StrSetChar(nb, i, StrCharAt(self.buf, i));
      i := i + 1;
    }
    StrSetChar(nb, self.len, 0);
    StrFree(self.buf);
    self.buf := nb;
    self.cap := neu;
  }

  fn Append(s: pchar) {
    if (s == 0 as pchar) { return; }
    var sl: int64 := StrLen(s);
    self.Reserve(sl);
    var i: int64 := 0;
    while (i < sl) {
      StrSetChar(self.buf, self.len + i, StrCharAt(s, i));
      i := i + 1;
    }
    self.len := self.len + sl;
    StrSetChar(self.buf, self.len, 0);
  }

  fn AppendChar(c: int64) {
    self.Reserve(1);
    StrSetChar(self.buf, self.len, c);
    self.len := self.len + 1;
    StrSetChar(self.buf, self.len, 0);
  }

  fn AppendInt(n: int64) {
    var ns: pchar := IntToStr(n);
    self.Append(ns);
    StrFree(ns);
  }

  fn Length(): int64 { return self.len; }
  fn Capacity(): int64 { return self.cap; }

  fn ToString(): pchar {
    return StrSub(self.buf, 0, self.len);
  }

  fn Clear() {
    self.len := 0;
    StrSetChar(self.buf, 0, 0);
  }

  fn FreeBuffer() {
    StrFree(self.buf);
    self.buf := 0 as pchar;
    self.cap := 0;
    self.len := 0;
  }
};
// ============================================================================
// STRTRIM — returns heap-allocated trimmed copy (distinct from StrTrimWhitespace)
// ============================================================================

pub fn StrTrim(s: pchar): pchar {
  var len: int64 := StrLen(s);
  var start: int64 := 0;
  while (start < len && IsWhitespace(StrCharAt(s, start))) {
    start += 1;
  }
  var end: int64 := len - 1;
  while (end >= start && IsWhitespace(StrCharAt(s, end))) {
    end -= 1;
  }
  var trimLen: int64 := end - start + 1;
  if (trimLen < 0) { trimLen := 0; }
  return StrSub(s, start, trimLen);
}

// ============================================================================
// STRSPLIT — splits string by delimiter, writes pchar pointers into out[0..n-1]
// out: raw int64 pointer to an array of int64-sized slots (8 bytes each)
// Each slot receives a heap-allocated pchar (caller must StrFree each part)
// Returns: number of parts written
// ============================================================================

pub fn StrSplit(s: pchar, delim: pchar, out: int64, maxParts: int64): int64 {
  var slen: int64 := StrLen(s);
  var dlen: int64 := StrLen(delim);
  var count: int64 := 0;
  var start: int64 := 0;

  if (dlen == 0) {
    if (maxParts > 0) {
      poke64(out, StrSub(s, 0, slen) as int64);
      count := 1;
    }
    return count;
  }

  var i: int64 := 0;
  while (i <= slen - dlen && count < maxParts - 1) {
    var isMatch: bool := true;
    var j: int64 := 0;
    while (j < dlen && isMatch) {
      if (StrCharAt(s, i + j) != StrCharAt(delim, j)) {
        isMatch := false;
      }
      j += 1;
    }
    if (isMatch) {
      poke64(out + count * 8, StrSub(s, start, i - start) as int64);
      count += 1;
      start := i + dlen;
      i := start;
    } else {
      i += 1;
    }
  }

  if (count < maxParts) {
    var remaining: int64 := slen - start;
    if (remaining < 0) { remaining := 0; }
    poke64(out + count * 8, StrSub(s, start, remaining) as int64);
    count += 1;
  }

  return count;
}
// ============================================================================
// FEAT-04: Erweiterungen — StrStartsWith/EndsWith, StrJoin, Pad, Repeat,
//          StrToInt64, StrToF64, Int64ToStr, F64ToStr
// ============================================================================

// StrStartsWith and StrEndsWith are builtins — see codegen_x86.lyx.

// Verbindet count Strings aus parts[]-Array mit Trennzeichen delim.
// parts ist ein int64-Array (Pointer auf pchar-Werte), Ergebnis alloc'd.
pub fn StrJoin(parts: int64, count: int64, delim: pchar): pchar {
  if (count <= 0) { return ""c; }
  var delimLen: int64 := StrLen(delim);
  var total: int64 := 0;
  var i: int64 := 0;
  while (i < count) {
    total := total + StrLen(peek64(parts + i * 8) as pchar);
    i += 1;
  }
  total := total + delimLen * (count - 1) + 1;
  var buf: int64 := alloc(total);
  var pos: int64 := 0;
  i := 0;
  while (i < count) {
    var part: pchar := peek64(parts + i * 8) as pchar;
    var plen: int64 := StrLen(part);
    var j: int64 := 0;
    while (j < plen) { poke8(buf + pos, StrCharAt(part, j)); pos := pos + 1; j := j + 1; }
    if (i < count - 1) {
      j := 0;
      while (j < delimLen) { poke8(buf + pos, StrCharAt(delim, j)); pos := pos + 1; j := j + 1; }
    }
    i += 1;
  }
  poke8(buf + pos, 0);
  return buf as pchar;
}

pub fn StrPadLeft(s: pchar, width: int64, padChar: int64): pchar {
  var slen: int64 := StrLen(s);
  if (slen >= width) { return s; }
  var buf: int64 := alloc(width + 1);
  var pad: int64 := width - slen;
  var i: int64 := 0;
  while (i < pad) { poke8(buf + i, padChar); i := i + 1; }
  i := 0;
  while (i < slen) { poke8(buf + pad + i, StrCharAt(s, i)); i := i + 1; }
  poke8(buf + width, 0);
  return buf as pchar;
}

pub fn StrPadRight(s: pchar, width: int64, padChar: int64): pchar {
  var slen: int64 := StrLen(s);
  if (slen >= width) { return s; }
  var buf: int64 := alloc(width + 1);
  var i: int64 := 0;
  while (i < slen)  { poke8(buf + i, StrCharAt(s, i)); i := i + 1; }
  while (i < width) { poke8(buf + i, padChar);          i := i + 1; }
  poke8(buf + width, 0);
  return buf as pchar;
}

pub fn StrRepeat(s: pchar, n: int64): pchar {
  if (n <= 0) { return ""c; }
  var slen: int64 := StrLen(s);
  var total: int64 := slen * n + 1;
  var buf: int64 := alloc(total);
  var pos: int64 := 0;
  var r: int64 := 0;
  while (r < n) {
    var i: int64 := 0;
    while (i < slen) { poke8(buf + pos, StrCharAt(s, i)); pos := pos + 1; i := i + 1; }
    r += 1;
  }
  poke8(buf + pos, 0);
  return buf as pchar;
}

// Parst einen dezimalen Integer-String. ok wird 1 gesetzt wenn erfolgreich.
pub fn StrToInt64(s: pchar, ok: int64): int64 {
  var len: int64 := StrLen(s);
  if (len == 0) { poke64(ok, 0); return 0; }
  var neg: int64 := 0;
  var i: int64 := 0;
  if (StrCharAt(s, 0) == 45) { neg := 1; i := 1; }   // '-'
  if (StrCharAt(s, 0) == 43) { i := 1; }               // '+'
  var result: int64 := 0;
  while (i < len) {
    var c: int64 := StrCharAt(s, i);
    if (c < 48 || c > 57) { poke64(ok, 0); return 0; }
    result := result * 10 + (c - 48);
    i += 1;
  }
  poke64(ok, 1);
  if (neg != 0) { return 0 - result; }
  return result;
}

// Konvertiert int64 → dezimaler String in einen callerseits alloc'd Buffer (min 22 Bytes).
pub fn Int64ToStr(n: int64, buf: int64): pchar {
  if (n == 0) { poke8(buf, 48); poke8(buf + 1, 0); return buf as pchar; }
  var neg: int64 := 0;
  var val: int64 := n;
  if (n < 0) { neg := 1; val := 0 - n; }
  var tmp: int64 := alloc(24);
  var pos: int64 := 0;
  while (val > 0) {
    poke8(tmp + pos, 48 + (val % 10));
    val := val / 10;
    pos += 1;
  }
  if (neg != 0) { poke8(tmp + pos, 45); pos := pos + 1; }
  var i: int64 := 0;
  while (i < pos) { poke8(buf + i, peek8(tmp + (pos - 1 - i))); i := i + 1; }
  poke8(buf + pos, 0);
  free(tmp, 24);
  return buf as pchar;
}

// Parst einen einfachen Dezimal-Float (kein Exponent). ok → 1 wenn ok.
// Parst Integer-Teil eines Float-Strings. Fractional-Teil erfordert f64-Division
// die aktuell FPE auslöst (Compiler-Bug: idiv statt divsd). Gibt Ganzzahl-Anteil zurück.
// TODO: Vollständig implementieren sobald f64-Division-Bug behoben ist.
pub fn StrToF64(s: pchar, ok: int64): f64 {
  var len: int64 := StrLen(s);
  if (len == 0) { poke64(ok, 0); return (0 as f64); }
  var neg: int64 := 0;
  var i: int64 := 0;
  if (StrCharAt(s, 0) == 45) { neg := 1; i := 1; }
  var intVal: int64 := 0;
  while (i < len) {
    var c: int64 := StrCharAt(s, i);
    if (c == 46) { i := len; }  // stop at decimal point
    else if (c >= 48 && c <= 57) { intVal := intVal * 10 + (c - 48); i := i + 1; }
    else { poke64(ok, 0); return (0 as f64); }
  }
  poke64(ok, 1);
  if (neg != 0) { return (0 - intVal) as f64; }
  return (intVal as f64);
}

// StrFormat: printf-artiges Format-String für bis zu 5 Argumente.
// Unterstützte Formatspezifizierer: %d %s %x %08x (zero-padded hex) %%.
// Rückgabe: heap-allozierter pchar; Aufrufer ist für free(ptr, len) verantwortlich.
// Hinweis: Max. 5 Argumente (6-Arg-Grenze des Lyx-Compilers: fmt + 5 = 6 Parameter).
pub fn StrFormat(fmt: pchar, a0: int64, a1: int64, a2: int64, a3: int64, a4: int64): pchar {
  var flen: int64 := StrLen(fmt);
  var outSize: int64 := flen * 8 + 256;  // grober Puffer
  var out: int64 := alloc(outSize);
  var pos: int64 := 0;
  var fi:  int64 := 0;
  var argIdx: int64 := 0;
  var hex: pchar := "0123456789abcdef";

  while (fi < flen) {
    var c: int64 := StrCharAt(fmt, fi);
    if (c != 37) {   // not '%'
      poke8(out + pos, c); pos := pos + 1; fi := fi + 1;
    } else {
      fi += 1;
      if (fi >= flen) {
        poke8(out + pos, 37); pos := pos + 1;
      } else {
        var spec: int64 := StrCharAt(fmt, fi);
        // Collect optional zero-padding prefix, e.g. %08x
        var zeroPad: int64 := 0;
        var padWidth: int64 := 0;
        if (spec == 48) {  // '0'
          zeroPad := 1; fi := fi + 1;
          while (fi < flen && StrCharAt(fmt, fi) >= 49 && StrCharAt(fmt, fi) <= 57) {
            padWidth := padWidth * 10 + (StrCharAt(fmt, fi) - 48);
            fi += 1;
          }
          spec := StrCharAt(fmt, fi);
        }

        var arg: int64 := 0;
        if (argIdx == 0) { arg := a0; }
        if (argIdx == 1) { arg := a1; }
        if (argIdx == 2) { arg := a2; }
        if (argIdx == 3) { arg := a3; }
        if (argIdx == 4) { arg := a4; }

        if (spec == 37) {  // '%%' → literal %
          poke8(out + pos, 37); pos := pos + 1;
        } else if (spec == 115) {  // '%s'
          var sptr: pchar := arg as pchar;
          var i: int64 := 0;
          while (peek8(sptr as int64 + i) != 0) {
            poke8(out + pos, peek8(sptr as int64 + i));
            pos += 1; i := i + 1;
          }
          argIdx += 1;
        } else if (spec == 100) {  // '%d'
          var tmp: int64 := alloc(22);
          var s: pchar := Int64ToStr(arg, tmp);
          var i: int64 := 0;
          while (peek8(s as int64 + i) != 0) {
            poke8(out + pos, peek8(s as int64 + i));
            pos += 1; i := i + 1;
          }
          free(tmp, 22);
          argIdx += 1;
        } else if (spec == 120) {  // '%x' or '%08x'
          var val: int64 := arg;
          var hbuf: int64 := alloc(18);
          var hpos: int64 := 17;
          poke8(hbuf + 17, 0);
          if (val == 0) {
            poke8(hbuf + 16, 48); hpos := 16;
          } else {
            while (val != 0 && hpos > 0) {
              hpos -= 1;
              poke8(hbuf + hpos, peek8(hex as int64 + (val & 0xF)));
              val := (val >> 4) & 0x0FFFFFFFFFFFFFFF;
            }
          }
          var hlen: int64 := 17 - hpos;
          if (zeroPad != 0 && hlen < padWidth) {
            var pad: int64 := padWidth - hlen;
            var pi: int64 := 0;
            while (pi < pad) { poke8(out + pos, 48); pos := pos + 1; pi := pi + 1; }
          }
          var hi: int64 := hpos;
          while (hi < 17) {
            poke8(out + pos, peek8(hbuf + hi)); pos := pos + 1; hi := hi + 1;
          }
          free(hbuf, 18);
          argIdx += 1;
        } else {
          poke8(out + pos, 37); pos := pos + 1;
          poke8(out + pos, spec); pos := pos + 1;
          argIdx += 1;
        }
        fi += 1;
      }
    }
  }
  poke8(out + pos, 0);
  return out as pchar;
}
