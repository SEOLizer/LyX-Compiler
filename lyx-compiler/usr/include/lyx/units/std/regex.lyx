// Standard-Regex-Unit für Lyx (Backtracking-Engine)

@description("Regular expression matching")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
unit std.regex;

import std.string;
import std.alloc;

// #1468: Diese Deklarationen standen frueher MITTEN in der Datei — hinter
// ihrer ersten Verwendung. Eine Zuweisung aus einer weiter oben stehenden
// Funktion ging dadurch ins Leere: regexLastCaps blieb 0, und die
// Capture-Tabelle wurde nie angelegt. Zustand gehoert vor seine Benutzer.
con REGEX_FLAG_IGNORE_CASE: int64 := 1;
con REGEX_FLAG_ANCHORED: int64 := 2;
con REGEX_FLAG_MULTILINE: int64 := 4;
con REGEX_MAX_CAPTURE_SLOTS: int64 := 32;
var regexLastCaps: int64 := 0;
var regexLastCapCount: int64 := 0;


pub fn isAlpha(c: int64): int64 {
  if ((c >= 65) && (c <= 90)) { return 1; }
  if ((c >= 97) && (c <= 122)) { return 1; }
  return 0;
}

pub fn isDigit(c: int64): int64 {
  if ((c >= 48) && (c <= 57)) { return 1; }
  return 0;
}

pub fn isAlnum(c: int64): int64 {
  if (isAlpha(c)) { return 1; }
  if (isDigit(c)) { return 1; }
  return 0;
}

pub fn isWhitespace(c: int64): int64 {
  if ((c == 32) || (c == 9) || (c == 10) || (c == 13)) { return 1; }
  return 0;
}

pub fn isWordChar(c: int64): int64 {
  if (isAlnum(c)) { return 1; }
  if (c == 95) { return 1; } // '_'
  return 0;
}

pub fn atomLen(pattern: pchar, start: int64): int64 {
  var plen: int64 := StrLen(pattern);
  if (start >= plen) { return 0; }
  var pc: int64 := StrSafeCharAt(pattern, start);

  if (pc == 92) {
    if (start + 1 < plen) { return 2; }
    return 1;
  }

  if (pc == 91) {
    var i: int64 := start + 1;
    var found: int64 := 0;
    while ((i < plen) && (found == 0)) {
      var ch: int64 := StrSafeCharAt(pattern, i);
      if (ch == 92) {
        if (i + 1 < plen) { i := i + 2; } else { i := i + 1; }
      } else if (ch == 93) {
        found := 1;
      } else {
        i += 1;
      }
    }
    if (found) { return (i - start) + 1; }
    return 0;
  }

  return 1;
}

// #1467: Die Muster-API nahm einen flags-Parameter entgegen und wertete ihn
// nicht aus — beide Zweige der Abfrage taten dasselbe. REGEX_FLAG_IGNORE_CASE,
// _ANCHORED und _MULTILINE waren damit wirkungslos.
//
// Die Flags liegen als Zustand der Unit, wie die Capture-Tabelle auch: der
// Abgleich reicht sie sonst durch ein Dutzend Rekursionsebenen, und jede
// vergessene Weitergabe waere ein stiller Teilausfall.
var _reFlags: int64 := 0;

// Kleinbuchstabe, wenn IGNORE_CASE gesetzt ist — sonst unveraendert.
fn _reFalte(c: int64): int64 {
  if ((_reFlags & REGEX_FLAG_IGNORE_CASE) == 0) { return c; }
  if ((c >= 65) && (c <= 90)) { return c + 32; }
  return c;
}

pub fn atomMatches(pattern: pchar, start: int64, cRoh: int64): int64 {
  var c: int64 := _reFalte(cRoh);
  var pc: int64 := StrSafeCharAt(pattern, start);

  if (pc == 46) { return 1; } // '.'

  if (pc == 92) {
    var esc: int64 := StrSafeCharAt(pattern, start + 1);
    if (esc == 100) { return isDigit(c); }      // \d
    if (esc == 119) { return isWordChar(c); }   // \w
    if (esc == 115) { return isWhitespace(c); } // \s
    if (esc == 110) { if (c == 10) { return 1; } else { return 0; } }
    if (esc == 114) { if (c == 13) { return 1; } else { return 0; } }
    if (esc == 116) { if (c == 9) { return 1; } else { return 0; } }
    if (esc == c) { return 1; } else { return 0; }
  }

  if (pc == 91) {
    var plen: int64 := StrLen(pattern);
    var i: int64 := start + 1;
    var negate: int64 := 0;
    if ((i < plen) && (StrSafeCharAt(pattern, i) == 94)) {
      negate := 1;
      i += 1;
    }
    var matched: int64 := 0;
    var done: int64 := 0;
    while ((i < plen) && (done == 0)) {
      var ch: int64 := StrSafeCharAt(pattern, i);   // roh; gefaltet wird beim Vergleich
      if (ch == 93) {
        done := 1;
      } else if (ch == 92) {
        i += 1;
        if (i < plen) {
          ch := _reFalte(StrSafeCharAt(pattern, i));
          if (ch == c) { matched := 1; }
          i += 1;
        }
      } else if ((i + 2 < plen) && (StrSafeCharAt(pattern, i + 1) == 45) && (StrSafeCharAt(pattern, i + 2) != 93)) {
        // Bereich: bei IGNORE_CASE zaehlt der gefaltete Bereich, damit
        // [A-Z] auch Kleinbuchstaben trifft und umgekehrt.
        var von: int64 := _reFalte(ch);
        var bis: int64 := _reFalte(StrSafeCharAt(pattern, i + 2));
        if ((c >= von) && (c <= bis)) { matched := 1; }
        i += 3;
      } else {
        if (_reFalte(ch) == c) { matched := 1; }
        i += 1;
      }
    }

    if (negate == 1) {
      if (matched == 0) { return 1; } else { return 0; }
    }
    return matched;
  }

  if (_reFalte(pc) == c) { return 1; } else { return 0; }
}

// #1313: Hilfsfunktionen fuer Gruppen und Alternation. Beide ueberspringen
// Escapes (`\x`) und Zeichenklassen (`[...]`), damit ein `|` oder `)` DARIN
// nicht als Struktur gelesen wird.

fn _reSkipAtomRaw(pattern: pchar, i: int64, pEnd: int64): int64 {
  var ch: int64 := StrSafeCharAt(pattern, i);
  if (ch == 92) {
    if (i + 1 < pEnd) { return i + 2; }
    return i + 1;
  }
  if (ch == 91) {
    var j: int64 := i + 1;
    while (j < pEnd) {
      var c2: int64 := StrSafeCharAt(pattern, j);
      if (c2 == 92) { j := j + 2; }
      else {
        if (c2 == 93) { return j + 1; }
        j := j + 1;
      }
    }
    return pEnd;
  }
  return i + 1;
}

// Index der schliessenden Klammer zu einem `(` an start, oder -1.
fn _reGroupEnd(pattern: pchar, start: int64, pEnd: int64): int64 {
  var depth: int64 := 0;
  var i: int64 := start;
  while (i < pEnd) {
    var ch: int64 := StrSafeCharAt(pattern, i);
    if (ch == 92) { i := i + 2; }
    else {
      if (ch == 91) { i := _reSkipAtomRaw(pattern, i, pEnd); }
      else {
        if (ch == 40) { depth := depth + 1; i := i + 1; }
        else {
          if (ch == 41) {
            depth := depth - 1;
            if (depth == 0) { return i; }
            i := i + 1;
          } else { i := i + 1; }
        }
      }
    }
  }
  return 0 - 1;
}

// Index eines `|` auf oberster Ebene in [from, pEnd), oder -1.
fn _reTopAlt(pattern: pchar, from: int64, pEnd: int64): int64 {
  var depth: int64 := 0;
  var i: int64 := from;
  while (i < pEnd) {
    var ch: int64 := StrSafeCharAt(pattern, i);
    if (ch == 92) { i := i + 2; }
    else {
      if (ch == 91) { i := _reSkipAtomRaw(pattern, i, pEnd); }
      else {
        if (ch == 40) { depth := depth + 1; i := i + 1; }
        else {
          if (ch == 41) { depth := depth - 1; i := i + 1; }
          else {
            if ((ch == 124) && (depth == 0)) { return i; }
            i := i + 1;
          }
        }
      }
    }
  }
  return 0 - 1;
}

// #1468: Der Abgleich kannte Gruppen (seit #1313), hielt ihre Grenzen aber
// nirgends fest — RegexCaptureCount lieferte 0 und jede Abfrage -1. Die
// Klammern waren damit nur Struktur, nie Ergebnis.
//
// Aufgezeichnet wird in derselben Tabelle, die die kompilierte API benutzt
// (regexLastCaps): je Gruppe zwei Slots, Anfang und Ende. Gruppe 0 ist der
// ganze Treffer und wird von regexSearchFrom gesetzt.

// Nummer der Gruppe, die bei pIdx oeffnet: die wievielte '(' im Muster ist es?
// Escapes und Zeichenklassen werden uebersprungen, damit `\(` und `[(]` nicht
// mitzaehlen.
fn _reGruppenNr(pattern: pchar, pIdx: int64): int64 {
  var i: int64 := 0;
  var nr: int64 := 0;
  while (i < pIdx) {
    var ch: int64 := StrSafeCharAt(pattern, i);
    if (ch == 92) { i += 2; }
    else if (ch == 91) {
      i += 1;
      while ((i < pIdx) && (StrSafeCharAt(pattern, i) != 93)) {
        if (StrSafeCharAt(pattern, i) == 92) { i += 1; }
        i += 1;
      }
      i += 1;
    }
    else {
      if (ch == 40) { nr += 1; }
      i += 1;
    }
  }
  return nr + 1;   // Gruppe 0 ist der ganze Treffer
}

// Der Puffer wird EAGER am Eintritt der oeffentlichen Funktion angelegt, nicht
// beim ersten Zugriff: ein Lazy-Init tief im Aufrufstapel stuerzt ab (bekannte
// Falle, siehe die Notiz zu Lazy-Init in der Projektdoku). Hier ist der Stapel
// durch die Rekursion des Abgleichs besonders tief.
fn _reCapsSichern(): void {
  if (regexLastCaps == 0) {
    regexLastCaps := alloc(REGEX_MAX_CAPTURE_SLOTS * 8);
  }
}

fn _reCapsLeeren(): void {
  if (regexLastCaps == 0) { return; }
  var i: int64 := 0;
  while (i < REGEX_MAX_CAPTURE_SLOTS) {
    poke64(regexLastCaps + i * 8, 0 - 1);
    i += 1;
  }
  regexLastCapCount := 0;
}

fn _reCapSetzen(nr: int64, start: int64, ende: int64): void {
  var slot: int64 := nr * 2;
  if (slot + 1 >= REGEX_MAX_CAPTURE_SLOTS) { return; }
  if (regexLastCaps == 0) { return; }
  poke64(regexLastCaps + slot * 8, start);
  poke64(regexLastCaps + (slot + 1) * 8, ende);
  if (nr + 1 > regexLastCapCount) { regexLastCapCount := nr + 1; }
}

fn _reMatchIn(pattern: pchar, pIdx: int64, pEnd: int64, text: pchar, tIdx: int64): int64 {
  var plen: int64 := pEnd;   // #1313: Kontextgrenze statt Musterende
  var tlen: int64 := StrLen(text);

  if (pIdx >= plen) { return tIdx; }

  // #1313: Alternation. `|` galt bisher als gewoehnliches Zeichen, `a|b` konnte
  // daher nie passen. Ein `|` auf oberster Ebene des aktuellen Bereichs teilt
  // ihn in zwei Zweige; passt der linke nicht, wird der rechte versucht.
  var altIdx: int64 := _reTopAlt(pattern, pIdx, pEnd);
  if (altIdx >= 0) {
    var ra: int64 := _reMatchIn(pattern, pIdx, altIdx, text, tIdx);
    if (ra >= 0) { return ra; }
    return _reMatchIn(pattern, altIdx + 1, pEnd, text, tIdx);
  }

  var pcg: int64 := StrSafeCharAt(pattern, pIdx);
  if (pcg == 40) {
    // #1313: Gruppen. atomLen lieferte fuer `(` eine 1, atomMatches verglich die
    // Klammer daraufhin WOERTLICH mit dem Text — `(a)(b)` gegen `ab` konnte
    // deshalb nie passen, und damit war auch jede Gruppen-Abfrage
    // (RegexCaptureCount und Geschwister) vom Programm aus unerreichbar.
    var gEnd: int64 := _reGroupEnd(pattern, pIdx, pEnd);
    if (gEnd < 0) { return -1; }
    var inStart: int64 := pIdx + 1;
    var afterG: int64 := gEnd + 1;
    var gq: int64 := 0;
    if (afterG < pEnd) { gq := StrSafeCharAt(pattern, afterG); }

    var gnr: int64 := _reGruppenNr(pattern, pIdx);   // #1468

    if (gq == 63) {
      var e1: int64 := _reMatchIn(pattern, inStart, gEnd, text, tIdx);
      if (e1 >= 0) {
        var r1: int64 := _reMatchIn(pattern, afterG + 1, pEnd, text, e1);
        if (r1 >= 0) { _reCapSetzen(gnr, tIdx, e1); return r1; }
      }
      return _reMatchIn(pattern, afterG + 1, pEnd, text, tIdx);
    }

    if ((gq == 42) || (gq == 43)) {
      // Gierig sammeln, dann rueckwaerts abbauen — wie bei den Zeichen-Atomen.
      var ends: int64 := alloc(2048);
      var cur: int64 := tIdx;
      poke64(ends, cur);
      var n: int64 := 1;
      var go: int64 := 1;
      while ((go == 1) && (n < 256)) {
        var ee: int64 := _reMatchIn(pattern, inStart, gEnd, text, cur);
        if (ee < 0) { go := 0; }
        else {
          if (ee == cur) { go := 0; }   // leerer Treffer: sonst Endlosschleife
          else { cur := ee; poke64(ends + n * 8, cur); n := n + 1; }
        }
      }
      var minReps: int64 := 0;
      if (gq == 43) { minReps := 1; }
      var k: int64 := n - 1;
      while (k >= minReps) {
        var rr: int64 := _reMatchIn(pattern, afterG + 1, pEnd, text, peek64(ends + k * 8));
        if (rr >= 0) {
          // Bei Wiederholung gilt die LETZTE Runde als Treffer der Gruppe —
          // so halten es POSIX und PCRE.
          if (k > 0) { _reCapSetzen(gnr, peek64(ends + (k - 1) * 8), peek64(ends + k * 8)); }
          free(ends, 2048);
          return rr;
        }
        k := k - 1;
      }
      free(ends, 2048);
      return -1;
    }

    // Ohne Quantor: Gruppe passen lassen, dann den Rest.
    var e0: int64 := _reMatchIn(pattern, inStart, gEnd, text, tIdx);
    if (e0 < 0) { return -1; }
    var r0: int64 := _reMatchIn(pattern, afterG, pEnd, text, e0);
    if (r0 >= 0) { _reCapSetzen(gnr, tIdx, e0); }   // #1468
    return r0;
  }

  var pc: int64 := StrSafeCharAt(pattern, pIdx);
  if ((pc == 36) && (pIdx == plen - 1)) {
    if (tIdx == tlen) { return tIdx; }
    // #1564: MULTILINE wurde entgegengenommen und in _reFlags geschrieben,
    // vom Abgleich aber nie gelesen — `$` meinte weiter das Textende statt
    // des Zeilenendes. Mit dem Flag gilt es auch unmittelbar vor \n.
    if ((_reFlags & REGEX_FLAG_MULTILINE) != 0) {
      if (StrSafeCharAt(text, tIdx) == 10) { return tIdx; }
    }
    return -1;
  }

  var aLen: int64 := atomLen(pattern, pIdx);
  if (aLen == 0) { return -1; }
  var nextIdx: int64 := pIdx + aLen;

  var q: int64 := 0;
  if (nextIdx < plen) { q := StrSafeCharAt(pattern, nextIdx); }

  if (q == 42) {
    var ti: int64 := tIdx;
    while ((ti < tlen) && (atomMatches(pattern, pIdx, StrSafeCharAt(text, ti)) != 0)) {
      ti += 1;
    }
    while (ti >= tIdx) {
      var res: int64 := _reMatchIn(pattern, nextIdx + 1, pEnd, text, ti);
      if (res >= 0) { return res; }
      ti -= 1;
    }
    return -1;
  }

  if (q == 43) {
    if ((tIdx >= tlen) || (atomMatches(pattern, pIdx, StrSafeCharAt(text, tIdx)) == 0)) {
      return -1;
    }
    var ti2: int64 := tIdx + 1;
    while ((ti2 < tlen) && (atomMatches(pattern, pIdx, StrSafeCharAt(text, ti2)) != 0)) {
      ti2 += 1;
    }
    while (ti2 >= tIdx + 1) {
      var res2: int64 := _reMatchIn(pattern, nextIdx + 1, pEnd, text, ti2);
      if (res2 >= 0) { return res2; }
      ti2 -= 1;
    }
    return -1;
  }

  if (q == 63) {
    if ((tIdx < tlen) && (atomMatches(pattern, pIdx, StrSafeCharAt(text, tIdx)) != 0)) {
      var res3: int64 := _reMatchIn(pattern, nextIdx + 1, pEnd, text, tIdx + 1);
      if (res3 >= 0) { return res3; }
    }
    return _reMatchIn(pattern, nextIdx + 1, pEnd, text, tIdx);
  }

  if (q == 123) {
    var idx: int64 := nextIdx + 1;
    var minCount: int64 := 0;
    var maxCount: int64 := -1;
    var hasDigits: int64 := 0;

    while ((idx < plen) && (isDigit(StrSafeCharAt(pattern, idx)) != 0)) {
      minCount := (minCount * 10) + (StrSafeCharAt(pattern, idx) - 48);
      idx += 1;
      hasDigits := 1;
    }
    if (hasDigits == 0) { return -1; }

    if ((idx < plen) && (StrSafeCharAt(pattern, idx) == 44)) {
      idx += 1;
      if ((idx < plen) && (isDigit(StrSafeCharAt(pattern, idx)) != 0)) {
        maxCount := 0;
        while ((idx < plen) && (isDigit(StrSafeCharAt(pattern, idx)) != 0)) {
          maxCount := (maxCount * 10) + (StrSafeCharAt(pattern, idx) - 48);
          idx += 1;
        }
      } else {
        maxCount := -1;
      }
    } else {
      maxCount := minCount;
    }

    if ((idx >= plen) || (StrSafeCharAt(pattern, idx) != 125)) { return -1; }
    var afterIdx: int64 := idx + 1;

    var ti3: int64 := tIdx;
    var c: int64 := 0;
    while (c < minCount) {
      if ((ti3 >= tlen) || (atomMatches(pattern, pIdx, StrSafeCharAt(text, ti3)) == 0)) {
        return -1;
      }
      ti3 += 1;
      c += 1;
    }

    var tiMax: int64 := ti3;
    if (maxCount < 0) {
      while ((tiMax < tlen) && (atomMatches(pattern, pIdx, StrSafeCharAt(text, tiMax)) != 0)) {
        tiMax += 1;
      }
    } else {
      var extra: int64 := 0;
      while ((extra < (maxCount - minCount)) && (tiMax < tlen) &&
             (atomMatches(pattern, pIdx, StrSafeCharAt(text, tiMax)) != 0)) {
        tiMax += 1;
        extra += 1;
      }
    }

    while (tiMax >= ti3) {
      var res4: int64 := _reMatchIn(pattern, afterIdx, pEnd, text, tiMax);
      if (res4 >= 0) { return res4; }
      tiMax -= 1;
    }

    return -1;
  }

  if ((tIdx < tlen) && (atomMatches(pattern, pIdx, StrSafeCharAt(text, tIdx)) != 0)) {
    return _reMatchIn(pattern, nextIdx, pEnd, text, tIdx + 1);
  }

  return -1;
}


// Bestehende Schnittstelle: das ganze Muster ist der Bereich.
pub fn matchHere(pattern: pchar, pIdx: int64, text: pchar, tIdx: int64): int64 {
  return _reMatchIn(pattern, pIdx, StrLen(pattern), text, tIdx);
}

pub fn regexSearchFrom(pattern: pchar, text: pchar, startIdx: int64): int64 {
  _reCapsSichern();          // #1468: eager, siehe _reCapsSichern
  var plen: int64 := StrLen(pattern);
  var tlen: int64 := StrLen(text);

  if (plen == 0) { return startIdx; }

  var pStart: int64 := 0;
  var anchored: int64 := 0;
  // #1564: Mit MULTILINE ist `^` nicht mehr nur der Textanfang, sondern jeder
  // Zeilenanfang. Die Verankerung bleibt bestehen — nur die Menge der
  // Ansatzpunkte waechst: Position 0 und jede Stelle hinter einem \n.
  var mlCaret: int64 := 0;
  if (StrSafeCharAt(pattern, 0) == 94) {
    pStart := 1;
    anchored := 1;
    if ((_reFlags & REGEX_FLAG_MULTILINE) != 0) {
      mlCaret := 1;
    } else {
      if (startIdx != 0) { return -1; }
    }
  }

  // #1467: ANCHORED wirkt wie ein vorangestelltes `^`.
  if ((_reFlags & REGEX_FLAG_ANCHORED) != 0) {
    anchored := 1;
    if (startIdx != 0) { return 0 - 1; }
  }

  var ti: int64 := startIdx;
  while (ti <= tlen) {
    _reCapsLeeren();                       // #1468: je Versuch neu
    var res: int64 := matchHere(pattern, pStart, text, ti);
    if (res >= 0) {
      _reCapSetzen(0, ti, res);            // #1468: Gruppe 0 = ganzer Treffer
      return ti;
    }
    // #1313: Bei verankertem Muster gibt es nur EINEN Ansatzpunkt. Vorher wurde
    // auch dann weitergerueckt: `^[a-z]+$` scheiterte an `Hallo` beim `H`, setzte
    // hinter dem `H` neu an und fand `allo` — Anker erfuellt, Ergebnis wahr.
    // Der `^`-Test stand nur vor der Schleife und griff daher bloss fuer den
    // ersten Versuch. Fuer Eingabepruefung, wo `^...$` fast immer steht, liess
    // das zu viel durch.
    // #1564: Mit MULTILINE bleibt `^` verankert, aber jeder Zeilenanfang ist
    // ein eigener Ansatzpunkt — also bis hinter das naechste \n weiterruecken
    // statt aufzugeben. Ohne MULTILINE gilt #1313 unveraendert.
    if (anchored != 0) {
      if (mlCaret == 0) { return -1; }
      var nl: int64 := ti;
      while (nl < tlen && StrSafeCharAt(text, nl) != 10) { nl := nl + 1; }
      if (nl >= tlen) { return -1; }
      ti := nl + 1;
      continue;
    }
    ti += 1;
  }
  return -1;
}

pub fn _RegexMatch(pattern: pchar, text: pchar): bool {
  if (regexSearchFrom(pattern, text, 0) >= 0) { return true; }
  return false;
}

pub fn _RegexSearch(pattern: pchar, text: pchar): int64 {
  return regexSearchFrom(pattern, text, 0);
}

// #1466: Diese Funktion hiess "Replace", zaehlte aber nur und benutzte
// `replacement` im ganzen Rumpf nicht. Sie heisst jetzt, was sie tut.
pub fn RegexCountMatches(pattern: pchar, text: pchar): int64 {
  var count: int64 := 0;
  var startIdx: int64 := 0;
  var plen: int64 := StrLen(pattern);
  var tlen: int64 := StrLen(text);

  if (plen == 0) { return 0; }

  var pos: int64 := regexSearchFrom(pattern, text, startIdx);
  var done: int64 := 0;
  while ((pos >= 0) && (done == 0)) {
    count += 1;
    var pStart: int64 := 0;
    if (StrSafeCharAt(pattern, 0) == 94) { pStart := 1; }
    var endPos: int64 := matchHere(pattern, pStart, text, pos);
    if (endPos <= pos) {
      startIdx := pos + 1;
    } else {
      startIdx := endPos;
    }

    if (startIdx > tlen) {
      done := 1;
    } else {
      pos := regexSearchFrom(pattern, text, startIdx);
    }
  }

  return count;
}

// Beibehalten fuer Aufrufer, die die Trefferzahl wollten. `_RegexReplace` war
// nie eine Ersetzung — der Name bleibt unit-intern erhalten, damit die
// Aenderung nachvollziehbar ist.
pub fn _RegexReplace(pattern: pchar, text: pchar, replacement: pchar): int64 {
  return RegexCountMatches(pattern, text);
}

// #1466: Die eigentliche Ersetzung. Sie kann nicht in `text` schreiben — das
// ist beim Aufrufer oft ein Literal, und Literale sind keine Schreibpuffer.
// Also entsteht ein neuer Puffer, den der Aufrufer freigibt.
//
// Die Groesse wird gerechnet, nicht geraten: Trefferzahl mal Laenge des
// Ersatztextes plus der Rest.
pub fn RegexReplaceAlloc(pattern: pchar, text: pchar, replacement: pchar): pchar {
  var treffer: int64 := RegexCountMatches(pattern, text);
  var tlen: int64 := StrLen(text);
  var rlen: int64 := StrLen(replacement);
  var groesse: int64 := tlen + treffer * rlen + 1;
  if (groesse < 1) { groesse := 1; }
  var dest: int64 := alloc(groesse);
  if (dest == 0) { return 0 as pchar; }
  RegexReplaceInto(dest as pchar, pattern, text, replacement);
  return dest as pchar;
}

pub fn Match(pattern: pchar, text: pchar): bool {
  return _RegexMatch(pattern, text);
}

pub fn Search(pattern: pchar, text: pchar): int64 {
  return _RegexSearch(pattern, text);
}

pub fn Replace(pattern: pchar, text: pchar, replacement: pchar): int64 {
  return _RegexReplace(pattern, text, replacement);
}

// ==========================================================================
// Erweiterte Regex-API (Flags, Captures, Compile-Time-Bytecode)
// ==========================================================================

con REGEX_STACK_MAX: int64 := 256;

pub type RegexProgramInfo = struct {
  instrStart: int64;
  classCount: int64;
  captureSlots: int64;
}

// regexLastCaps: pointer to alloc'd int64[32] buffer, lazy-initialized on first use

// #1563: Bytecode ist KEINE Zeichenkette. Bis 1.1.0A las der Leser das
// Programm mit StrSafeCharAt, und das misst seine Grenze mit StrLen — der Kopf
// traegt bei Offset 3 eine Null, also endete jedes Programm nach drei Bytes und
// jeder Lesezugriff dahinter lieferte -1. Damit war die kompilierte API auch
// dann nicht benutzbar, wenn jemand den Bytecode von Hand zusammengesetzt
// haette: es fehlte nicht nur der Schreiber, der Leser konnte nichts lesen.
fn regexReadU8(prog: pchar, idx: int64): int64 {
  if (idx < 0) { return -1; }
  return peek8((prog as int64) + idx) & 255;
}

fn regexReadU32(prog: pchar, idx: int64): int64 {
  // #1563: siehe regexReadU8 — roh lesen, nicht als Zeichenkette.
  var b0: int64 := regexReadU8(prog, idx);
  var b1: int64 := regexReadU8(prog, idx + 1);
  var b2: int64 := regexReadU8(prog, idx + 2);
  var b3: int64 := regexReadU8(prog, idx + 3);
  return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

fn regexFoldChar(c: int64): int64 {
  if ((c >= 65) && (c <= 90)) { return c + 32; }
  return c;
}

fn regexParseInfo(prog: pchar): RegexProgramInfo {
  var info: RegexProgramInfo;
  info.instrStart := -1;
  info.classCount := 0;
  info.captureSlots := 0;
  if (StrSafeCharAt(prog, 0) != 82) { return info; } // 'R'
  if (StrSafeCharAt(prog, 1) != 88) { return info; } // 'X'
  if (StrSafeCharAt(prog, 2) != 49) { return info; } // '1'
  info.captureSlots := regexReadU32(prog, 4);
  info.classCount := regexReadU32(prog, 8);
  var idx: int64 := 16;
  var c: int64 := 0;
  while (c < info.classCount) {
    var rangeCount: int64 := regexReadU32(prog, idx + 1);
    idx := idx + 1 + 4 + (rangeCount * 8);
    c += 1;
  }
  info.instrStart := idx;
  return info;
}

fn regexClassOffset(prog: pchar, classIndex: int64): int64 {
  var idx: int64 := 16;
  var c: int64 := 0;
  while (c < classIndex) {
    var rangeCount: int64 := regexReadU32(prog, idx + 1);
    idx := idx + 1 + 4 + (rangeCount * 8);
    c += 1;
  }
  return idx;
}

fn regexClassMatches(prog: pchar, classIndex: int64, c: int64, flags: int64,
                     info: RegexProgramInfo): int64 {
  var idx: int64 := regexClassOffset(prog, classIndex);
  var negated: int64 := 0;
  if (regexReadU8(prog, idx) == 1) { negated := 1; }
  var rangeCount: int64 := regexReadU32(prog, idx + 1);
  var i: int64 := 0;
  var pos: int64 := idx + 5;
  var matched2: int64 := 0;
  var ch: int64 := c;
  if ((flags & REGEX_FLAG_IGNORE_CASE) != 0) {
    ch := regexFoldChar(ch);
  }
  while (i < rangeCount) {
    var startc: int64 := regexReadU32(prog, pos);
    var endc: int64 := regexReadU32(prog, pos + 4);
    if ((flags & REGEX_FLAG_IGNORE_CASE) != 0) {
      startc := regexFoldChar(startc);
      endc := regexFoldChar(endc);
    }
    if ((ch >= startc) && (ch <= endc)) { matched2 := 1; }
    pos += 8;
    i += 1;
  }
  if (negated != 0) { if (matched2 == 0) { return 1; } else { return 0; } }
  return matched2;
}

fn regexRunAt(prog: pchar, progLen: int64, info: RegexProgramInfo, text: pchar,
              startPos: int64, flags: int64): int64 {
  if (info.instrStart < 0) { return -1; }
  if (info.captureSlots > REGEX_MAX_CAPTURE_SLOTS) { return -1; }
  var tlen: int64 := StrLen(text);
  // Use alloc'd buffers instead of array[N]int64 (not supported at parse level)
  var stackPc:   int64 := alloc(256 * 8) as int64;
  var stackPos:  int64 := alloc(256 * 8) as int64;
  var stackCaps: int64 := alloc(8192 * 8) as int64;
  var sp: int64 := 0;
  var i: int64 := 0;
  var spBase: int64 := 0;
  while (i < REGEX_MAX_CAPTURE_SLOTS) {
    poke64(stackCaps + i * 8, 0 - 1);
    i += 1;
  }
  poke64(stackPc + 0, 0);
  poke64(stackPos + 0, startPos);
  sp := 1;
  while (sp > 0) {
    sp -= 1;
    spBase := sp * 32;
    var pc: int64 := peek64(stackPc + sp * 8);
    var pos: int64 := peek64(stackPos + sp * 8);
    var caps: int64 := alloc(32 * 8) as int64;
    i := 0;
    while (i < info.captureSlots) {
      var capIdx: int64 := spBase + i;
      poke64(caps + i * 8, peek64(stackCaps + capIdx * 8));
      i += 1;
    }
    while (true) {
      var op: int64 := regexReadU8(prog, info.instrStart + pc);
      pc += 1;
      if (op == 1) {
        var ch: int64 := regexReadU32(prog, info.instrStart + pc);
        pc += 4;
        if (pos >= tlen) { break; }
        var tc: int64 := StrSafeCharAt(text, pos);
        if ((flags & REGEX_FLAG_IGNORE_CASE) != 0) {
          if (regexFoldChar(tc) != regexFoldChar(ch)) { break; }
        } else {
          if (tc != ch) { break; }
        }
        pos += 1;
      } else if (op == 2) {
        if (pos >= tlen) { break; }
        pos += 1;
      } else if (op == 3) {
        var cls: int64 := regexReadU32(prog, info.instrStart + pc);
        pc += 4;
        if (pos >= tlen) { break; }
        if (regexClassMatches(prog, cls, StrSafeCharAt(text, pos), flags, info) == 0) { break; }
        pos += 1;
      } else if (op == 4) {
        var t1: int64 := regexReadU32(prog, info.instrStart + pc);
        var t2: int64 := regexReadU32(prog, info.instrStart + pc + 4);
        pc := t1;
        if (sp < REGEX_STACK_MAX) {
          poke64(stackPc  + sp * 8, t2);
          poke64(stackPos + sp * 8, pos);
          spBase := sp * 32;
          i := 0;
          while (i < info.captureSlots) {
            var pushIdx: int64 := spBase + i;
            poke64(stackCaps + pushIdx * 8, peek64(caps + i * 8));
            i += 1;
          }
          sp += 1;
        }
      } else if (op == 5) {
        var t3: int64 := regexReadU32(prog, info.instrStart + pc);
        pc := t3;
      } else if (op == 6) {
        if (regexLastCaps == 0) { regexLastCaps := alloc(32 * 8) as int64; }
        i := 0;
        while (i < info.captureSlots) {
          poke64(regexLastCaps + i * 8, peek64(caps + i * 8));
          i += 1;
        }
        regexLastCapCount := info.captureSlots / 2;
        return pos;
      } else if (op == 7) {
        var slot: int64 := regexReadU32(prog, info.instrStart + pc);
        pc += 4;
        if (slot >= 0 && slot < info.captureSlots) {
          poke64(caps + slot * 8, pos);
        }
      } else if (op == 8) {
        if (pos != 0) {
          if ((flags & REGEX_FLAG_MULTILINE) == 0) { break; }
          if (StrSafeCharAt(text, pos - 1) != 10) { break; }
        }
      } else if (op == 9) {
        if (pos != tlen) {
          if ((flags & REGEX_FLAG_MULTILINE) == 0) { break; }
          if (StrSafeCharAt(text, pos) != 10) { break; }
        }
      } else {
        break;
      }
    }
  }
  return -1;
}

// ===========================================================================
// #1563: RegexCompile — der fehlende Schreiber zur kompilierten API
// ===========================================================================
//
// Die vier *Compiled-Funktionen lesen ein Bytecode-Programm, aber es gab keine
// Funktion, die eines erzeugt: die halbe API war von Lyx aus unbenutzbar, denn
// der Aufbau stand nirgends. Hier steht er, und RegexCompile schreibt ihn.
//
// FORMAT (little endian, so wie regexParseInfo und regexRunAt es lesen):
//
//   +0   'R' 'X' '1' 0
//   +4   u32 captureSlots      (2 je Gruppe, Gruppe 0 mitgezaehlt)
//   +8   u32 classCount
//   +12  u32 reserviert
//   +16  Klassentabelle, je Klasse:
//          u8  negiert (1 = [^...])
//          u32 rangeCount
//          rangeCount x { u32 von, u32 bis }
//   danach der Befehlsstrom; alle Sprungziele zaehlen AB DIESEM PUNKT.
//
// BEFEHLE (Opcode als u8, Operanden als u32):
//   1 CHAR c      2 ANY        3 CLASS idx    4 SPLIT z1 z2 (z1 zuerst)
//   5 JMP z       6 MATCH      7 SAVE slot    8 BOL (^)      9 EOL ($)
//
// Der Zeichenklassen-Abschnitt steht VOR dem Code, seine Groesse haengt aber
// vom Code ab (welche Klassen vorkommen). Deshalb zwei Durchgaenge: erst die
// Klassen einsammeln, dann den Code schreiben.

con RXC_MAX_CLASSES: int64 := 64;
con RXC_MAX_RANGES:  int64 := 32;

// Sammelzustand des laufenden Uebersetzens.
var rxcClsBuf:   int64 := 0;   // RXC_MAX_CLASSES x (negiert, count, ranges...)
var rxcClsCount: int64 := 0;
var rxcCode:     int64 := 0;   // Befehlsstrom
var rxcCodeLen:  int64 := 0;
var rxcCodeCap:  int64 := 0;
var rxcSlots:    int64 := 0;   // naechster freier Capture-Slot
var rxcFehler:   int64 := 0;

// Ein Klasseneintrag: 8 Byte Kopf (negiert, rangeCount) + 32 Bereiche a 16 Byte
con RXC_CLS_SZ: int64 := 8 + 8 + RXC_MAX_RANGES * 16;

fn rxcEmit8(v: int64) {
  if (rxcCodeLen + 1 > rxcCodeCap) { rxcFehler := 1; return; }
  poke8(rxcCode + rxcCodeLen, v & 255);
  rxcCodeLen := rxcCodeLen + 1;
}

fn rxcEmit32(v: int64) {
  rxcEmit8(v); rxcEmit8(v >> 8); rxcEmit8(v >> 16); rxcEmit8(v >> 24);
}

// u32 an einer bereits geschriebenen Stelle nachtragen (Sprungziele).
fn rxcPatch32(at: int64, v: int64) {
  if (at < 0 || at + 4 > rxcCodeLen) { rxcFehler := 1; return; }
  poke8(rxcCode + at,     v & 255);
  poke8(rxcCode + at + 1, (v >> 8) & 255);
  poke8(rxcCode + at + 2, (v >> 16) & 255);
  poke8(rxcCode + at + 3, (v >> 24) & 255);
}

// Eine Zeichenklasse anlegen; liefert ihren Index oder -1.
fn rxcClassNeu(negiert: int64): int64 {
  if (rxcClsCount >= RXC_MAX_CLASSES) { rxcFehler := 1; return -1; }
  var base: int64 := rxcClsBuf + rxcClsCount * RXC_CLS_SZ;
  poke64(base, negiert);
  poke64(base + 8, 0);
  var idx: int64 := rxcClsCount;
  rxcClsCount := rxcClsCount + 1;
  return idx;
}

fn rxcClassBereich(idx: int64, von: int64, bis: int64) {
  if (idx < 0) { return; }
  var base: int64 := rxcClsBuf + idx * RXC_CLS_SZ;
  var n: int64 := peek64(base + 8);
  if (n >= RXC_MAX_RANGES) { rxcFehler := 1; return; }
  poke64(base + 16 + n * 16,     von);
  poke64(base + 16 + n * 16 + 8, bis);
  poke64(base + 8, n + 1);
}

// \d \w \s (und die grossgeschriebenen Verneinungen) als Klasse ablegen —
// derselbe Zeichenvorrat, den atomMatches fuer die Muster-API benutzt.
fn rxcKlasseAusEscape(esc: int64): int64 {
  var neg: int64 := 0;
  var basis: int64 := esc;
  if (esc == 68) { neg := 1; basis := 100; }    // \D
  if (esc == 87) { neg := 1; basis := 119; }    // \W
  if (esc == 83) { neg := 1; basis := 115; }    // \S
  var idx: int64 := rxcClassNeu(neg);
  if (idx < 0) { return -1; }
  if (basis == 100) {                            // \d
    rxcClassBereich(idx, 48, 57);
  } else if (basis == 119) {                     // \w
    rxcClassBereich(idx, 48, 57);
    rxcClassBereich(idx, 65, 90);
    rxcClassBereich(idx, 97, 122);
    rxcClassBereich(idx, 95, 95);
  } else if (basis == 115) {                     // \s
    rxcClassBereich(idx, 32, 32);
    rxcClassBereich(idx, 9, 13);
  } else {
    rxcFehler := 1;
    return -1;
  }
  return idx;
}

// [...] uebersetzen. i zeigt auf '['; liefert den Index HINTER ']' oder -1.
fn rxcKlasseAusMenge(pattern: pchar, start: int64, plen: int64, clsOut: int64): int64 {
  var i: int64 := start + 1;
  var neg: int64 := 0;
  if (i < plen && StrSafeCharAt(pattern, i) == 94) { neg := 1; i := i + 1; }
  var idx: int64 := rxcClassNeu(neg);
  if (idx < 0) { return -1; }
  var fertig: int64 := 0;
  while (i < plen && fertig == 0) {
    var ch: int64 := StrSafeCharAt(pattern, i);
    if (ch == 93) { fertig := 1; i := i + 1; }
    else {
      if (ch == 92) {
        i := i + 1;
        if (i >= plen) { rxcFehler := 1; return -1; }
        var e: int64 := StrSafeCharAt(pattern, i);
        if (e == 110) { ch := 10; } else if (e == 114) { ch := 13; }
        else if (e == 116) { ch := 9; } else { ch := e; }
      }
      // Bereich a-z, aber nicht wenn '-' am Ende steht
      if (i + 2 < plen && StrSafeCharAt(pattern, i + 1) == 45
          && StrSafeCharAt(pattern, i + 2) != 93) {
        var bis: int64 := StrSafeCharAt(pattern, i + 2);
        rxcClassBereich(idx, ch, bis);
        i := i + 3;
      } else {
        rxcClassBereich(idx, ch, ch);
        i := i + 1;
      }
    }
  }
  if (fertig == 0) { rxcFehler := 1; return -1; }
  poke64(clsOut, idx);
  return i;
}

// Vorwaertsdeklaration ueber gegenseitige Rekursion ist in Lyx nicht noetig —
// rxcAlternative ruft rxcFolge, rxcFolge ruft ueber die Gruppe wieder
// rxcAlternative. Beide stehen deshalb in EINER Funktion mit Tiefenzaehler.
fn rxcAlternative(pattern: pchar, start: int64, plen: int64, tiefe: int64): int64 {
  if (tiefe > 32) { rxcFehler := 1; return start; }
  var i: int64 := start;
  var zweigStart: int64 := rxcCodeLen;
  var splitPos: int64 := -1;
  var sprungPos: int64 := -1;
  var offen: int64 := 1;

  while (offen == 1) {
    // ── eine Folge von Atomen ────────────────────────────────────────────
    while (i < plen) {
      var c: int64 := StrSafeCharAt(pattern, i);
      if (c == 124 || c == 41) { break; }        // '|' oder ')'
      var atomStart: int64 := rxcCodeLen;

      if (c == 94) {                              // ^
        rxcEmit8(8); i := i + 1;
      } else if (c == 36) {                       // $
        rxcEmit8(9); i := i + 1;
      } else if (c == 46) {                       // .
        rxcEmit8(2); i := i + 1;
      } else if (c == 40) {                       // ( ... )
        var slot: int64 := rxcSlots;
        if (slot + 2 > REGEX_MAX_CAPTURE_SLOTS) { rxcFehler := 1; return i; }
        rxcSlots := rxcSlots + 2;
        rxcEmit8(7); rxcEmit32(slot);
        i := rxcAlternative(pattern, i + 1, plen, tiefe + 1);
        if (rxcFehler != 0) { return i; }
        if (i >= plen || StrSafeCharAt(pattern, i) != 41) { rxcFehler := 1; return i; }
        i := i + 1;
        rxcEmit8(7); rxcEmit32(slot + 1);
      } else if (c == 91) {                       // [ ... ]
        var clsZelle: int64 := alloc(8);
        var nachher: int64 := rxcKlasseAusMenge(pattern, i, plen, clsZelle);
        var clsIdx: int64 := peek64(clsZelle);
        free(clsZelle, 8);
        if (nachher < 0) { rxcFehler := 1; return i; }
        rxcEmit8(3); rxcEmit32(clsIdx);
        i := nachher;
      } else if (c == 92) {                       // Escape
        if (i + 1 >= plen) { rxcFehler := 1; return i; }
        var e2: int64 := StrSafeCharAt(pattern, i + 1);
        if (e2 == 100 || e2 == 119 || e2 == 115 || e2 == 68 || e2 == 87 || e2 == 83) {
          var ci: int64 := rxcKlasseAusEscape(e2);
          if (ci < 0) { return i; }
          rxcEmit8(3); rxcEmit32(ci);
        } else {
          var lit: int64 := e2;
          if (e2 == 110) { lit := 10; } else if (e2 == 114) { lit := 13; }
          else if (e2 == 116) { lit := 9; }
          rxcEmit8(1); rxcEmit32(lit);
        }
        i := i + 2;
      } else {                                    // gewoehnliches Zeichen
        rxcEmit8(1); rxcEmit32(c);
        i := i + 1;
      }
      if (rxcFehler != 0) { return i; }

      // ── Wiederholung auf das eben geschriebene Atom ────────────────────
      if (i < plen) {
        var q: int64 := StrSafeCharAt(pattern, i);
        if (q == 42 || q == 43 || q == 63) {
          var atomLen2: int64 := rxcCodeLen - atomStart;
          var kopie: int64 := alloc(atomLen2);
          var k: int64 := 0;
          while (k < atomLen2) { poke8(kopie + k, peek8(rxcCode + atomStart + k)); k := k + 1; }
          if (q == 63) {
            // X? → SPLIT koerper, danach
            rxcCodeLen := atomStart;
            rxcEmit8(4);
            var sp1: int64 := rxcCodeLen; rxcEmit32(0);
            var sp2: int64 := rxcCodeLen; rxcEmit32(0);
            rxcPatch32(sp1, rxcCodeLen);
            k := 0;
            while (k < atomLen2) { rxcEmit8(peek8(kopie + k)); k := k + 1; }
            rxcPatch32(sp2, rxcCodeLen);
          } else if (q == 42) {
            // X* → L1: SPLIT koerper, ende; koerper: X; JMP L1; ende:
            rxcCodeLen := atomStart;
            var l1: int64 := rxcCodeLen;
            rxcEmit8(4);
            var sa1: int64 := rxcCodeLen; rxcEmit32(0);
            var sa2: int64 := rxcCodeLen; rxcEmit32(0);
            rxcPatch32(sa1, rxcCodeLen);
            k := 0;
            while (k < atomLen2) { rxcEmit8(peek8(kopie + k)); k := k + 1; }
            rxcEmit8(5); rxcEmit32(l1);
            rxcPatch32(sa2, rxcCodeLen);
          } else {
            // X+ → koerper: X; SPLIT koerper, ende
            var koerper: int64 := atomStart;
            rxcEmit8(4);
            var sb1: int64 := rxcCodeLen; rxcEmit32(0);
            var sb2: int64 := rxcCodeLen; rxcEmit32(0);
            rxcPatch32(sb1, koerper);
            rxcPatch32(sb2, rxcCodeLen);
          }
          free(kopie, atomLen2);
          i := i + 1;
          if (rxcFehler != 0) { return i; }
        }
      }
    }

    // ── Alternative? ─────────────────────────────────────────────────────
    if (i < plen && StrSafeCharAt(pattern, i) == 124) {
      // Vor den bisherigen Zweig ein SPLIT setzen und ihn mit einem JMP ans
      // Ende abschliessen. Der Code muss dafuer verschoben werden — er ist
      // kurz, und der Uebersetzer laeuft einmal je Muster.
      var zweigLen: int64 := rxcCodeLen - zweigStart;
      var puffer: int64 := alloc(zweigLen);
      var m: int64 := 0;
      while (m < zweigLen) { poke8(puffer + m, peek8(rxcCode + zweigStart + m)); m := m + 1; }
      rxcCodeLen := zweigStart;
      rxcEmit8(4);
      splitPos := rxcCodeLen; rxcEmit32(0);
      var altPos: int64 := rxcCodeLen; rxcEmit32(0);
      rxcPatch32(splitPos, rxcCodeLen);
      m := 0;
      while (m < zweigLen) { rxcEmit8(peek8(puffer + m)); m := m + 1; }
      free(puffer, zweigLen);
      rxcEmit8(5);
      sprungPos := rxcCodeLen; rxcEmit32(0);
      rxcPatch32(altPos, rxcCodeLen);
      i := i + 1;
      zweigStart := rxcCodeLen;
      if (rxcFehler != 0) { return i; }
      // naechster Zweig: Schleife laeuft weiter
    } else {
      offen := 0;
    }
    if (sprungPos >= 0 && offen == 0) { rxcPatch32(sprungPos, rxcCodeLen); }
  }
  return i;
}

// Uebersetzt `pattern` in ein Bytecode-Programm und schreibt es nach progOut.
// Rueckgabe: Laenge in Bytes, 0 bei Fehler (unbekanntes Muster, Puffer zu
// klein, zu viele Klassen oder Gruppen).
//
// Die kompilierte API kostet sich beim Suchen die Musteranalyse: dieselbe
// Frage wird einmal beantwortet statt bei jedem Zeichen erneut.
pub fn RegexCompile(pattern: pchar, progOut: pchar, progMax: int64): int64 {
  if (pattern == 0 as pchar || progOut == 0 as pchar) { return 0; }
  var plen: int64 := StrLen(pattern);
  if (plen == 0) { return 0; }

  rxcFehler   := 0;
  rxcClsCount := 0;
  rxcSlots    := 2;                    // Slot 0/1 = Gruppe 0 (ganzer Treffer)
  rxcCodeCap  := 16 + plen * 32;
  rxcCode     := alloc(rxcCodeCap);
  rxcCodeLen  := 0;
  rxcClsBuf   := alloc(RXC_MAX_CLASSES * RXC_CLS_SZ);

  rxcEmit8(7); rxcEmit32(0);           // SAVE 0 — Anfang des Treffers
  var ende: int64 := rxcAlternative(pattern, 0, plen, 0);
  if (rxcFehler != 0 || ende != plen) {
    free(rxcCode, rxcCodeCap);
    free(rxcClsBuf, RXC_MAX_CLASSES * RXC_CLS_SZ);
    return 0;
  }
  rxcEmit8(7); rxcEmit32(1);           // SAVE 1 — Ende des Treffers
  rxcEmit8(6);                         // MATCH
  if (rxcFehler != 0) {
    free(rxcCode, rxcCodeCap);
    free(rxcClsBuf, RXC_MAX_CLASSES * RXC_CLS_SZ);
    return 0;
  }

  // ── zusammensetzen ───────────────────────────────────────────────────────
  var clsBytes: int64 := 0;
  var ci2: int64 := 0;
  while (ci2 < rxcClsCount) {
    clsBytes := clsBytes + 1 + 4 + peek64(rxcClsBuf + ci2 * RXC_CLS_SZ + 8) * 8;
    ci2 := ci2 + 1;
  }
  var gesamt: int64 := 16 + clsBytes + rxcCodeLen;
  if (gesamt > progMax) {
    free(rxcCode, rxcCodeCap);
    free(rxcClsBuf, RXC_MAX_CLASSES * RXC_CLS_SZ);
    return 0;
  }

  var o: int64 := progOut as int64;
  poke8(o, 82); poke8(o + 1, 88); poke8(o + 2, 49); poke8(o + 3, 0);   // "RX1\0"
  var w: int64 := 4;
  poke8(o + w, rxcSlots & 255); poke8(o + w + 1, (rxcSlots >> 8) & 255);
  poke8(o + w + 2, (rxcSlots >> 16) & 255); poke8(o + w + 3, (rxcSlots >> 24) & 255);
  w := 8;
  poke8(o + w, rxcClsCount & 255); poke8(o + w + 1, (rxcClsCount >> 8) & 255);
  poke8(o + w + 2, (rxcClsCount >> 16) & 255); poke8(o + w + 3, (rxcClsCount >> 24) & 255);
  poke8(o + 12, 0); poke8(o + 13, 0); poke8(o + 14, 0); poke8(o + 15, 0);

  w := 16;
  ci2 := 0;
  while (ci2 < rxcClsCount) {
    var cb: int64 := rxcClsBuf + ci2 * RXC_CLS_SZ;
    var rn: int64 := peek64(cb + 8);
    poke8(o + w, peek64(cb) & 255); w := w + 1;
    poke8(o + w, rn & 255); poke8(o + w + 1, (rn >> 8) & 255);
    poke8(o + w + 2, (rn >> 16) & 255); poke8(o + w + 3, (rn >> 24) & 255);
    w := w + 4;
    var ri: int64 := 0;
    while (ri < rn) {
      var von: int64 := peek64(cb + 16 + ri * 16);
      var bis: int64 := peek64(cb + 16 + ri * 16 + 8);
      poke8(o + w, von & 255); poke8(o + w + 1, (von >> 8) & 255);
      poke8(o + w + 2, (von >> 16) & 255); poke8(o + w + 3, (von >> 24) & 255);
      poke8(o + w + 4, bis & 255); poke8(o + w + 5, (bis >> 8) & 255);
      poke8(o + w + 6, (bis >> 16) & 255); poke8(o + w + 7, (bis >> 24) & 255);
      w := w + 8;
      ri := ri + 1;
    }
    ci2 := ci2 + 1;
  }

  var q2: int64 := 0;
  while (q2 < rxcCodeLen) { poke8(o + w + q2, peek8(rxcCode + q2)); q2 := q2 + 1; }

  free(rxcCode, rxcCodeCap);
  free(rxcClsBuf, RXC_MAX_CLASSES * RXC_CLS_SZ);
  return gesamt;
}

pub fn RegexSearchCompiledEx(prog: pchar, progLen: int64, text: pchar,
                                flags: int64): int64 {
  var info: RegexProgramInfo := regexParseInfo(prog);
  var tlen: int64 := StrLen(text);
  regexLastCapCount := 0;
  if (info.instrStart < 0) { return -1; }
  if ((flags & REGEX_FLAG_ANCHORED) != 0) {
    if (regexRunAt(prog, progLen, info, text, 0, flags) >= 0) { return 0; }
    return -1;
  }
  var pos: int64 := 0;
  while (pos <= tlen) {
    if (regexRunAt(prog, progLen, info, text, pos, flags) >= 0) { return pos; }
    pos += 1;
  }
  return -1;
}

pub fn RegexMatchCompiledEx(prog: pchar, progLen: int64, text: pchar,
                               flags: int64): bool {
  return RegexSearchCompiledEx(prog, progLen, text, flags) >= 0;
}

pub fn RegexSearchCompiled(prog: pchar, progLen: int64, text: pchar): int64 {
  return RegexSearchCompiledEx(prog, progLen, text, 0);
}

pub fn RegexMatchCompiled(prog: pchar, progLen: int64, text: pchar): bool {
  return RegexMatchCompiledEx(prog, progLen, text, 0);
}

pub fn RegexReplaceCompiledEx(prog: pchar, progLen: int64, text: pchar,
                                 replacement: pchar, flags: int64): int64 {
  var info: RegexProgramInfo := regexParseInfo(prog);
  var tlen: int64 := StrLen(text);
  var count: int64 := 0;
  if (info.instrStart < 0) { return 0; }
  var pos: int64 := 0;
  while (pos <= tlen) {
    var endPos: int64 := regexRunAt(prog, progLen, info, text, pos, flags);
    if (endPos < 0) { break; }
    count += 1;
    if (endPos <= pos) {
      pos += 1;
    } else {
      pos := endPos;
    }
  }
  return count;
}

pub fn RegexReplaceCompiled(prog: pchar, progLen: int64, text: pchar,
                               replacement: pchar): int64 {
  return RegexReplaceCompiledEx(prog, progLen, text, replacement, 0);
}

// #1467: Diese drei hatten zwei identische Zweige — der flags-Parameter wurde
// entgegengenommen und nicht ausgewertet. Jetzt setzen sie den Zustand der
// Unit fuer die Dauer des Aufrufs und stellen ihn danach wieder her, damit ein
// Aufruf mit Flags einen spaeteren ohne nicht beeinflusst.
pub fn RegexMatchEx(pattern: pchar, text: pchar, flags: int64): bool {
  var vorher: int64 := _reFlags;
  _reFlags := flags;
  var erg: bool := _RegexMatch(pattern, text);
  _reFlags := vorher;
  return erg;
}

pub fn RegexSearchEx(pattern: pchar, text: pchar, flags: int64): int64 {
  var vorher: int64 := _reFlags;
  _reFlags := flags;
  var erg: int64 := _RegexSearch(pattern, text);
  _reFlags := vorher;
  return erg;
}

pub fn RegexReplaceEx(pattern: pchar, text: pchar, replacement: pchar,
                         flags: int64): int64 {
  var vorher: int64 := _reFlags;
  _reFlags := flags;
  var erg: int64 := RegexCountMatches(pattern, text);
  _reFlags := vorher;
  return erg;
}

// Ersetzung mit Flags — die Form, die #1466 und #1467 zusammen verlangen.
pub fn RegexReplaceAllocEx(pattern: pchar, text: pchar, replacement: pchar,
                           flags: int64): pchar {
  var vorher: int64 := _reFlags;
  _reFlags := flags;
  var erg: pchar := RegexReplaceAlloc(pattern, text, replacement);
  _reFlags := vorher;
  return erg;
}

pub fn RegexReplaceInto(dest: pchar, pattern: pchar, text: pchar,
                           replacement: pchar): int64 {
  var count: int64 := 0;
  var startIdx: int64 := 0;
  var outIdx: int64 := 0;
  var tlen: int64 := StrLen(text);
  var pos: int64 := regexSearchFrom(pattern, text, startIdx);
  while (pos >= 0) {
    var i: int64 := startIdx;
    while (i < pos) {
      StrSetChar(dest, outIdx, StrSafeCharAt(text, i));
      outIdx += 1;
      i += 1;
    }
    var rlen: int64 := StrLen(replacement);
    i := 0;
    while (i < rlen) {
      StrSetChar(dest, outIdx, StrSafeCharAt(replacement, i));
      outIdx += 1;
      i += 1;
    }
    count += 1;
    var pStart: int64 := 0;
    if (StrSafeCharAt(pattern, 0) == 94) { pStart := 1; }
    var endPos: int64 := matchHere(pattern, pStart, text, pos);
    if (endPos <= pos) {
      startIdx := pos + 1;
    } else {
      startIdx := endPos;
    }
    if (startIdx > tlen) { break; }
    pos := regexSearchFrom(pattern, text, startIdx);
  }
  var j: int64 := startIdx;
  while (j < tlen) {
    StrSetChar(dest, outIdx, StrSafeCharAt(text, j));
    outIdx += 1;
    j += 1;
  }
  StrSetChar(dest, outIdx, 0);
  return count;
}

pub fn RegexCaptureCount(): int64 {
  return regexLastCapCount;
}

pub fn RegexCaptureStart(group: int64): int64 {
  var slot: int64 := group * 2;
  if ((group < 0) || (group >= regexLastCapCount)) { return -1; }
  if ((slot < 0) || (slot >= REGEX_MAX_CAPTURE_SLOTS)) { return -1; }
  if (regexLastCaps == 0) { return -1; }
  return peek64(regexLastCaps + slot * 8);
}

pub fn RegexCaptureEnd(group: int64): int64 {
  var slot: int64 := (group * 2) + 1;
  if ((group < 0) || (group >= regexLastCapCount)) { return -1; }
  if ((slot < 0) || (slot >= REGEX_MAX_CAPTURE_SLOTS)) { return -1; }
  if (regexLastCaps == 0) { return -1; }
  return peek64(regexLastCaps + slot * 8);
}

pub fn RegexCaptureText(dest: pchar, text: pchar, group: int64): pchar {
  var startPos: int64 := RegexCaptureStart(group);
  var endPos: int64 := RegexCaptureEnd(group);
  if ((startPos < 0) || (endPos < 0) || (endPos < startPos)) {
    StrSetChar(dest, 0, 0);
    return dest;
  }
  return StrSubstring(dest, text, startPos, endPos - startPos);
}

pub fn MatchEx(pattern: pchar, text: pchar, flags: int64): bool {
  return RegexMatchEx(pattern, text, flags);
}

pub fn SearchEx(pattern: pchar, text: pchar, flags: int64): int64 {
  return RegexSearchEx(pattern, text, flags);
}

pub fn ReplaceEx(pattern: pchar, text: pchar, replacement: pchar,
                    flags: int64): int64 {
  return RegexReplaceEx(pattern, text, replacement, flags);
}

pub fn ReplaceInto(dest: pchar, pattern: pchar, text: pchar,
                      replacement: pchar): int64 {
  return RegexReplaceInto(dest, pattern, text, replacement);
}

pub fn CaptureCount(): int64 {
  return RegexCaptureCount();
}

pub fn CaptureStart(group: int64): int64 {
  return RegexCaptureStart(group);
}

pub fn CaptureEnd(group: int64): int64 {
  return RegexCaptureEnd(group);
}

pub fn CaptureText(dest: pchar, text: pchar, group: int64): pchar {
  return RegexCaptureText(dest, text, group);
}

// Canonical aliases used by regression tests and external code
pub fn RegexMatch(pattern: pchar, text: pchar): bool {
  return Match(pattern, text);
}

pub fn RegexSearch(pattern: pchar, text: pchar): int64 {
  return Search(pattern, text);
}

// #1466: Der Name verspricht eine Ersetzung, der Rueckgabetyp int64 kann sie
// nicht tragen — und der Rumpf hat sie nie ausgefuehrt. Beides bleibt fuer
// vorhandene Aufrufer bestehen (die Trefferzahl ist ein brauchbares Ergebnis),
// aber es steht jetzt dran, und die beiden Wege zur echten Ersetzung stehen
// daneben:
//
//   RegexReplaceAlloc(muster, text, ersatz)        -> neuer Puffer
//   RegexReplaceInto(ziel, muster, text, ersatz)   -> in vorhandenen Puffer
//
// Liefert die Zahl der Treffer, NICHT den ersetzten Text.
pub fn RegexReplace(pattern: pchar, text: pchar, replacement: pchar): int64 {
  return RegexCountMatches(pattern, text);
}

// ============================================================================
// WP-C7: Alternation |, RegexSearchSpan, RegexFindAll
// ============================================================================

// Returns position of the first top-level '|' at or after pIdx.
// Top-level means: not inside () or []. Returns -1 if none found.
fn findAltPos(pattern: pchar, pIdx: int64): int64 {
  var plen: int64 := StrLen(pattern);
  var depth: int64 := 0;
  var i: int64 := pIdx;
  while (i < plen) {
    var c: int64 := StrSafeCharAt(pattern, i);
    if (c == 92 && i + 1 < plen) {
      i += 2;
    } else if (c == 40) {
      depth += 1;
      i += 1;
    } else if (c == 41 && depth > 0) {
      depth -= 1;
      i += 1;
    } else if (c == 91) {
      i += 1;
      while (i < plen && StrSafeCharAt(pattern, i) != 93) {
        if (StrSafeCharAt(pattern, i) == 92 && i + 1 < plen) { i := i + 2; }
        else { i := i + 1; }
      }
      if (i < plen) { i := i + 1; }
    } else if (c == 124 && depth == 0) {
      return i;
    } else {
      i += 1;
    }
  }
  return -1;
}

// Extract pattern[pFrom..pEnd) into a newly alloc'd string.
fn subPattern(pattern: pchar, pFrom: int64, pEnd: int64): pchar {
  var len: int64 := pEnd - pFrom;
  var buf: pchar := alloc(len + 1) as pchar;
  var i: int64 := 0;
  while (i < len) {
    StrSetChar(buf, i, StrSafeCharAt(pattern, pFrom + i));
    i += 1;
  }
  StrSetChar(buf, len, 0);
  return buf;
}

// matchHere with alternation: tries left branch, then right branch if left fails.
fn matchHereAlt(pattern: pchar, pIdx: int64, text: pchar, tIdx: int64): int64 {
  var altPos: int64 := findAltPos(pattern, pIdx);
  if (altPos < 0) {
    return matchHere(pattern, pIdx, text, tIdx);
  }
  var leftPat: pchar := subPattern(pattern, pIdx, altPos);
  var leftRes: int64 := matchHere(leftPat, 0, text, tIdx);
  if (leftRes >= 0) { return leftRes; }
  return matchHereAlt(pattern, altPos + 1, text, tIdx);
}

// regexSearchFrom with alternation: returns leftmost match start across all branches.
fn regexSearchFromAlt(pattern: pchar, text: pchar, startIdx: int64): int64 {
  var altPos: int64 := findAltPos(pattern, 0);
  if (altPos < 0) {
    return regexSearchFrom(pattern, text, startIdx);
  }
  var plen: int64 := StrLen(pattern);
  var leftPat: pchar := subPattern(pattern, 0, altPos);
  var rightPat: pchar := subPattern(pattern, altPos + 1, plen);
  var leftRes: int64 := regexSearchFrom(leftPat, text, startIdx);
  var rightRes: int64 := regexSearchFromAlt(rightPat, text, startIdx);
  if (leftRes < 0) { return rightRes; }
  if (rightRes < 0) { return leftRes; }
  if (leftRes <= rightRes) { return leftRes; }
  return rightRes;
}

// Find the end position of a match starting at startPos (handles alternation).
fn regexMatchEndAlt(pattern: pchar, text: pchar, startPos: int64): int64 {
  var altPos: int64 := findAltPos(pattern, 0);
  if (altPos < 0) {
    var pStart: int64 := 0;
    if (StrSafeCharAt(pattern, 0) == 94) { pStart := 1; }
    return matchHere(pattern, pStart, text, startPos);
  }
  var plen: int64 := StrLen(pattern);
  var leftPat: pchar := subPattern(pattern, 0, altPos);
  var leftEnd: int64 := regexMatchEndAlt(leftPat, text, startPos);
  if (leftEnd >= 0) { return leftEnd; }
  var rightPat: pchar := subPattern(pattern, altPos + 1, plen);
  return regexMatchEndAlt(rightPat, text, startPos);
}

// RegexSearchSpan: find pattern in text and write match start/end to output addresses.
// startOut and endOut are int64 addresses (e.g. alloc(8)) written via poke64.
// Returns true if a match was found.
pub fn RegexSearchSpan(pattern: pchar, text: pchar, startOut: int64, endOut: int64): bool {
  var start: int64 := regexSearchFromAlt(pattern, text, 0);
  if (start < 0) { return false; }
  var end: int64 := regexMatchEndAlt(pattern, text, start);
  if (end < start) { end := start; }
  poke64(startOut, start);
  poke64(endOut, end);
  return true;
}

// RegexFindAll: find all non-overlapping matches of pattern in text.
// out: int64 address of a buffer that receives pchar pointers (8 bytes each).
//      Caller reads match i as: peek64(out + i*8) cast to pchar.
// maxMatches: maximum number of matches to store.
// Returns the number of matches found.
pub fn RegexFindAll(pattern: pchar, text: pchar, out: int64, maxMatches: int64): int64 {
  var tlen: int64 := StrLen(text);
  var count: int64 := 0;
  var startIdx: int64 := 0;
  while (count < maxMatches && startIdx <= tlen) {
    var matchStart: int64 := regexSearchFromAlt(pattern, text, startIdx);
    if (matchStart < 0) { break; }
    var matchEnd: int64 := regexMatchEndAlt(pattern, text, matchStart);
    if (matchEnd < matchStart) { matchEnd := matchStart; }
    var matchLen: int64 := matchEnd - matchStart;
    var buf: pchar := alloc(matchLen + 1) as pchar;
    var mi: int64 := 0;
    while (mi < matchLen) {
      StrSetChar(buf, mi, StrSafeCharAt(text, matchStart + mi));
      mi += 1;
    }
    StrSetChar(buf, matchLen, 0);
    poke64(out + count * 8, buf as int64);
    count += 1;
    if (matchEnd > matchStart) {
      startIdx := matchEnd;
    } else {
      startIdx := matchStart + 1;
    }
  }
  return count;
}
