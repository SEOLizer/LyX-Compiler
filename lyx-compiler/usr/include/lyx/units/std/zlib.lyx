// std/zlib - DEFLATE compression implementation (internal, no external links)
// Implements zlib/DEFLATE compression as per RFC 1950/1951

// ============================================================================
// Constants
// ============================================================================

// Compression levels
@description("DEFLATE/zlib compression (RFC 1950/1951)")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
unit std.zlib;

pub con Z_NO_COMPRESSION: int64 := 0;
pub con Z_BEST_SPEED: int64 := 1;
pub con Z_DEFAULT_COMPRESSION: int64 := 6;
pub con Z_BEST_COMPRESSION: int64 := 9;

// Window size (8KB for DEFLATE)
pub con DEFLATE_WINDOW_SIZE: int64 := 32768;
pub con DEFLATE_WINDOW_MASK: int64 := 32767;

// Hash table size for LZ77 (power of 2)
pub con HASH_SIZE: int64 := 4096;
pub con HASH_MASK: int64 := 4095;

// Min match length for LZ77
pub con MIN_MATCH: int64 := 3;
pub con MAX_MATCH: int64 := 258;

// Max distance
pub con MAX_DISTANCE: int64 := 32768;

// ============================================================================
// Bit Writer for DEFLATE output
// ============================================================================

// Write a single bit
pub fn BitWriteBit(output: pchar, pos: int64, bit: int64): int64 {
    var byte_pos: int64 := pos / 8;
    var bit_pos: int64 := pos & 7;
    var b: int64 := StrCharAt(output, byte_pos);
    if (bit == 1) {
        b := b | (1 << bit_pos);
    }
    StrSetChar(output, byte_pos, b);
    return pos + 1;
}

// Write multiple bits (LSB first)
pub fn BitWriteBits(output: pchar, pos: int64, value: int64, num_bits: int64): int64 {
    var i: int64 := 0;
    while (i < num_bits) {
        var bit: int64 := (value >> i) & 1;
        pos := BitWriteBit(output, pos, bit);
        i += 1;
    }
    return pos;
}

// Flush to byte boundary
pub fn BitFlush(output: pchar, pos: int64): int64 {
    if ((pos & 7) != 0) {
        var pad: int64 := 8 - (pos & 7);
        pos := BitWriteBits(output, pos, 0, pad);
    }
    return pos;
}

// Write byte-aligned
pub fn BitWriteByte(output: pchar, pos: int64, byte: int64): int64 {
    StrSetChar(output, pos / 8, byte);
    return pos + 8;
}

// ============================================================================
// Adler-32 Checksum
// ============================================================================

// Calculate Adler-32 checksum
// Much faster than CRC32 for long data, good enough for integrity
pub fn Adler32(data: pchar, len: int64): int64 {
    if (len <= 0) { return 1; }
    
    var a: int64 := 1;
    var b: int64 := 0;
    var i: int64 := 0;
    
    while (i < len) {
        a := a + StrCharAt(data, i);
        if (a >= 65521) { a := a - 65521; }
        b += a;
        if (b >= 65521) { b := b - 65521; }
        i += 1;
    }
    
    return b * 65536 + a;
}

// Update Adler-32 with more data
pub fn Adler32Update(current: int64, data: pchar, len: int64): int64 {
    if (len <= 0) { return current; }
    
    var a: int64 := current & 65535;
    var b: int64 := (current / 65536) & 65535;
    var i: int64 := 0;
    
    while (i < len) {
        a := a + StrCharAt(data, i);
        if (a >= 65521) { a := a - 65521; }
        b += a;
        if (b >= 65521) { b := b - 65521; }
        i += 1;
    }
    
    return b * 65536 + a;
}

// ============================================================================
// CRC32 Checksum (for completeness)
// ============================================================================

// Standard CRC-32 (ISO 3309 / zlib / PNG / gzip): reflektiert, Polynom 0xEDB88320,
// Init 0xFFFFFFFF, FinalXor 0xFFFFFFFF. (Früher: MSB-first-Variante mit 0x04C11DB7
// OHNE 32-Bit-Maskierung → `<<1`-Overflow → 64-Bit-Garbage, nicht zlib-kompatibel.)
pub fn CRC32(data: pchar, len: int64): int64 {
    var crc: int64 := 0xFFFFFFFF;
    var i: int64 := 0;
    while (i < len) {
        crc := crc ^ (StrCharAt(data, i) & 0xFF);
        var j: int64 := 0;
        while (j < 8) {
            if ((crc & 1) != 0) {
                crc := (crc >> 1) ^ 0xEDB88320;
            } else {
                crc := crc >> 1;
            }
            j += 1;
        }
        i += 1;
    }
    return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF;
}

// ============================================================================
// Huffman Codes for DEFLATE - Fixed Huffman Tables
// ============================================================================

// Fixed literal/length codes (0-255 = literals, 256 = end block, 257-285 = length)
pub con LITLEN_EOF: int64 := 256;

// Reverse the lowest `bits` bits of `code` (MSB↔LSB), for Huffman code emission.
// DEFLATE packs bits LSB-first in bytes, but Huffman codes are defined MSB-first.
fn bitRev(code: int64, bits: int64): int64 {
    var result: int64 := 0;
    var i: int64 := 0;
    while (i < bits) {
        result := result | (((code >> i) & 1) << (bits - 1 - i));
        i += 1;
    }
    return result;
}

// Get fixed Huffman code for literal/length
// Returns (code * 256) + bits
pub fn GetFixedLiteralCode(code: int64): int64 {
    var result: int64 := 0;
    if (code <= 143) {
        result := code + 48;
        result := result * 256;
        result += 8;
    } else if (code <= 255) {
        result := code - 256;
        result += 400;
        result := result * 256;
        result += 9;
    } else if (code <= 279) {
        result := code - 280;
        result := result * 2;
        result := result * 256;
        result += 7;
    } else {
        result := code - 280;
        result += 144;
        result := result * 256;
        result += 8;
    }
    return result;
}

// Get fixed Huffman code for distance
// Distance codes 0-31 are bit-complemented
pub fn GetFixedDistCode(dist: int64): int64 {
    if (dist == 0) { return 0; }
    var d: int64 := dist;
    var bits: int64 := 0;
    while (d > 1) {
        d := d / 2;
        bits += 1;
    }
    return dist * 256 + bits;
}

// ============================================================================
// DEFLATE Compress with LZ77 (Fixed Huffman)
// ============================================================================

// Encode a literal/length symbol with fixed Huffman (RFC 1951 §3.2.6).
// Codes are bit-reversed before writing because DEFLATE packs LSB-first
// but Huffman codes are defined MSB-first.
fn EncodeLitLen(output: pchar, bit_pos: int64, symbol: int64): int64 {
    var code: int64 := 0;
    var bits: int64 := 0;
    if (symbol <= 143) {
        code := symbol + 48;        // codes 48..191 (8-bit)
        bits := 8;
    } else if (symbol <= 255) {
        code := symbol - 144 + 400; // codes 400..511 (9-bit)
        bits := 9;
    } else if (symbol <= 279) {
        code := symbol - 256;        // codes 0..23 (7-bit)
        bits := 7;
    } else {
        code := symbol - 280 + 192;  // codes 192..199 (8-bit)
        bits := 8;
    }
    return BitWriteBits(output, bit_pos, bitRev(code, bits), bits);
}

// Encode a distance code (RFC 1951 §3.2.5, Table 2).
// In fixed DEFLATE, all distance codes are exactly 5 bits (codes 0-29),
// bit-reversed before LSB-first emission. Extra bits are written separately.
fn EncodeDist(output: pchar, bit_pos: int64, dist: int64): int64 {
    var code: int64 := 0;
    if (dist == 1) { code := 0; }
    else if (dist == 2) { code := 1; }
    else if (dist == 3) { code := 2; }
    else if (dist == 4) { code := 3; }
    else if (dist <= 6) { code := 4; }
    else if (dist <= 8) { code := 5; }
    else if (dist <= 12) { code := 6; }
    else if (dist <= 16) { code := 7; }
    else if (dist <= 24) { code := 8; }
    else if (dist <= 32) { code := 9; }
    else if (dist <= 48) { code := 10; }
    else if (dist <= 64) { code := 11; }
    else if (dist <= 96) { code := 12; }
    else if (dist <= 128) { code := 13; }
    else if (dist <= 192) { code := 14; }
    else if (dist <= 256) { code := 15; }
    else if (dist <= 384) { code := 16; }
    else if (dist <= 512) { code := 17; }
    else if (dist <= 768) { code := 18; }
    else if (dist <= 1024) { code := 19; }
    else if (dist <= 1536) { code := 20; }
    else if (dist <= 2048) { code := 21; }
    else if (dist <= 3072) { code := 22; }
    else if (dist <= 4096) { code := 23; }
    else if (dist <= 6144) { code := 24; }
    else if (dist <= 8192) { code := 25; }
    else if (dist <= 12288) { code := 26; }
    else if (dist <= 16384) { code := 27; }
    else if (dist <= 24576) { code := 28; }
    else { code := 29; }
    return BitWriteBits(output, bit_pos, bitRev(code, 5), 5);
}

// Get length code for LZ77 length (RFC 1951 §3.2.5, Table 1).
fn GetLengthCode(len: int64): int64 {
    if (len == 3)  { return 257; }
    if (len == 4)  { return 258; }
    if (len == 5)  { return 259; }
    if (len == 6)  { return 260; }
    if (len == 7)  { return 261; }
    if (len == 8)  { return 262; }
    if (len == 9)  { return 263; }
    if (len == 10) { return 264; }
    if (len <= 12) { return 265; }   // 11-12
    if (len <= 14) { return 266; }   // 13-14
    if (len <= 16) { return 267; }   // 15-16
    if (len <= 18) { return 268; }   // 17-18
    if (len <= 22) { return 269; }   // 19-22
    if (len <= 26) { return 270; }   // 23-26
    if (len <= 30) { return 271; }   // 27-30
    if (len <= 34) { return 272; }   // 31-34
    if (len <= 42) { return 273; }   // 35-42
    if (len <= 50) { return 274; }   // 43-50
    if (len <= 58) { return 275; }   // 51-58
    if (len <= 66) { return 276; }   // 59-66
    if (len <= 82) { return 277; }   // 67-82
    if (len <= 98) { return 278; }   // 83-98
    if (len <= 114) { return 279; }  // 99-114
    if (len <= 130) { return 280; }  // 115-130
    if (len <= 162) { return 281; }  // 131-162
    if (len <= 194) { return 282; }  // 163-194
    if (len <= 226) { return 283; }  // 195-226
    if (len <= 257) { return 284; }  // 227-257
    return 285;                       // 258
}

// Compress using LZ77 with fixed Huffman
pub fn DeflateCompressLZ77(input: pchar, input_len: int64, output: pchar): int64 {
    if (input_len <= 0) { return 0; }
    
    var bit_pos: int64 := 0;
    var pos: int64 := 0;
    var is_final: int64 := 1;
    
    while (pos < input_len) {
        // Check if this is the last block
        var remaining: int64 := input_len - pos;
        if (remaining <= 32768) {
            is_final := 1;
        } else {
            is_final := 0;
        }
        
        // Write block header: BFINAL + BTYPE=01 (fixed Huffman)
        // BTYPE=01: BTYPE[0]=1 (LSB, sent first), BTYPE[1]=0 (MSB, sent second)
        bit_pos := BitWriteBit(output, bit_pos, is_final);
        bit_pos := BitWriteBit(output, bit_pos, 1);  // BTYPE[0]=1
        bit_pos := BitWriteBit(output, bit_pos, 0);  // BTYPE[1]=0
        
        var block_end: int64 := pos + 32768;
        if (block_end > input_len) { block_end := input_len; }
        
        // Process block with LZ77
        while (pos < block_end) {
            // Find longest match
            var match_len: int64 := 0;
            var match_dist: int64 := 0;
            
            // Search in window
            var search_start: int64 := 0;
            if (pos > MAX_DISTANCE) { search_start := pos - MAX_DISTANCE; }
            
            var max_look: int64 := 258;
            if (block_end - pos < max_look) { max_look := block_end - pos; }
            
            if (max_look >= MIN_MATCH) {
                var i: int64 := search_start;
                while (i < pos) {
                    var m: int64 := 0;
                    while (m < max_look && m < MAX_MATCH) {
                        if (StrCharAt(input, i + m) != StrCharAt(input, pos + m)) {
                            break;
                        }
                        m += 1;
                    }
                    
                    if (m >= MIN_MATCH && m > match_len) {
                        match_len := m;
                        match_dist := pos - i;
                    }
                    
                    i += 1;
                }
            }
            
            if (match_len >= MIN_MATCH) {
                // Write length-distance pair
                var len_code: int64 := GetLengthCode(match_len);
                bit_pos := EncodeLitLen(output, bit_pos, len_code);
                
                // Write extra length bits (RFC 1951 Table 1; extra bits NOT reversed)
                if (len_code >= 265 && len_code <= 284) {
                    var extra_bits: int64 := 0;
                    var base_len: int64 := 0;
                    if (len_code <= 268) { extra_bits := 1; }
                    else if (len_code <= 272) { extra_bits := 2; }
                    else if (len_code <= 276) { extra_bits := 3; }
                    else if (len_code <= 280) { extra_bits := 4; }
                    else { extra_bits := 5; }
                    if (len_code == 265) { base_len := 11; }
                    else if (len_code == 266) { base_len := 13; }
                    else if (len_code == 267) { base_len := 15; }
                    else if (len_code == 268) { base_len := 17; }
                    else if (len_code == 269) { base_len := 19; }
                    else if (len_code == 270) { base_len := 23; }
                    else if (len_code == 271) { base_len := 27; }
                    else if (len_code == 272) { base_len := 31; }
                    else if (len_code == 273) { base_len := 35; }
                    else if (len_code == 274) { base_len := 43; }
                    else if (len_code == 275) { base_len := 51; }
                    else if (len_code == 276) { base_len := 59; }
                    else if (len_code == 277) { base_len := 67; }
                    else if (len_code == 278) { base_len := 83; }
                    else if (len_code == 279) { base_len := 99; }
                    else if (len_code == 280) { base_len := 115; }
                    else if (len_code == 281) { base_len := 131; }
                    else if (len_code == 282) { base_len := 163; }
                    else if (len_code == 283) { base_len := 195; }
                    else { base_len := 227; }
                    bit_pos := BitWriteBits(output, bit_pos, match_len - base_len, extra_bits);
                }
                
                // Write distance
                bit_pos := EncodeDist(output, bit_pos, match_dist);
                
                // Write extra distance bits (RFC 1951 Table 2; extra bits NOT reversed)
                var dbits: int64 := 0;
                var dbase: int64 := match_dist;
                if (match_dist <= 4) { dbits := 0; }
                else if (match_dist <= 6)   { dbits := 1; dbase := 5; }
                else if (match_dist <= 8)   { dbits := 1; dbase := 7; }
                else if (match_dist <= 12)  { dbits := 2; dbase := 9; }
                else if (match_dist <= 16)  { dbits := 2; dbase := 13; }
                else if (match_dist <= 24)  { dbits := 3; dbase := 17; }
                else if (match_dist <= 32)  { dbits := 3; dbase := 25; }
                else if (match_dist <= 48)  { dbits := 4; dbase := 33; }
                else if (match_dist <= 64)  { dbits := 4; dbase := 49; }
                else if (match_dist <= 96)  { dbits := 5; dbase := 65; }
                else if (match_dist <= 128) { dbits := 5; dbase := 97; }
                else if (match_dist <= 192) { dbits := 6; dbase := 129; }
                else if (match_dist <= 256) { dbits := 6; dbase := 193; }
                else if (match_dist <= 384) { dbits := 7; dbase := 257; }
                else if (match_dist <= 512) { dbits := 7; dbase := 385; }
                else if (match_dist <= 768) { dbits := 8; dbase := 513; }
                else if (match_dist <= 1024) { dbits := 8; dbase := 769; }
                else if (match_dist <= 1536) { dbits := 9; dbase := 1025; }
                else if (match_dist <= 2048) { dbits := 9; dbase := 1537; }
                else if (match_dist <= 3072) { dbits := 10; dbase := 2049; }
                else if (match_dist <= 4096) { dbits := 10; dbase := 3073; }
                else if (match_dist <= 6144) { dbits := 11; dbase := 4097; }
                else if (match_dist <= 8192) { dbits := 11; dbase := 6145; }
                else if (match_dist <= 12288) { dbits := 12; dbase := 8193; }
                else if (match_dist <= 16384) { dbits := 12; dbase := 12289; }
                else if (match_dist <= 24576) { dbits := 13; dbase := 16385; }
                else { dbits := 13; dbase := 24577; }
                if (dbits > 0) {
                    bit_pos := BitWriteBits(output, bit_pos, match_dist - dbase, dbits);
                }
                
                pos += match_len;
            } else {
                // Write literal
                var literal: int64 := StrCharAt(input, pos);
                bit_pos := EncodeLitLen(output, bit_pos, literal);
                pos += 1;
            }
        }
    }
    
    // Write EOF symbol
    bit_pos := EncodeLitLen(output, bit_pos, 256);
    
    // Flush bits
    bit_pos := BitFlush(output, bit_pos);
    
    // Convert bit position to byte position (rounded up)
    var result: int64 := bit_pos + 7;
    result := result / 8;
    return result;
}

// ============================================================================
// DEFLATE Compress (stored blocks only - simplest form)
// ============================================================================

// Compress using DEFLATE stored blocks (RFC 1951 BTYPE=00).
// Uses direct byte writes: 1 header byte + 4 LEN/NLEN bytes + raw data per block.
pub fn DeflateCompress(input: pchar, input_len: int64, output: pchar): int64 {
    if (input_len <= 0) { return 0; }
    var outPos: int64 := 0;
    var inPos: int64 := 0;
    while (inPos < input_len) {
        var remaining: int64 := input_len - inPos;
        var blockSize: int64 := 65535;
        if (remaining < blockSize) { blockSize := remaining; }
        var isFinal: int64 := 1;
        if (inPos + blockSize < input_len) { isFinal := 0; }
        // Header byte: BFINAL in bit0, BTYPE=00 in bits1-2, padding zeros in bits3-7
        StrSetChar(output, outPos, isFinal);
        outPos += 1;
        // LEN (16-bit little-endian)
        StrSetChar(output, outPos,     blockSize & 255);
        StrSetChar(output, outPos + 1, (blockSize / 256) & 255);
        // NLEN = ones complement of LEN (16-bit little-endian)
        var nlen: int64 := (blockSize ^ 65535) & 65535;
        StrSetChar(output, outPos + 2, nlen & 255);
        StrSetChar(output, outPos + 3, (nlen / 256) & 255);
        outPos += 4;
        // Raw data
        var i: int64 := 0;
        while (i < blockSize) {
            StrSetChar(output, outPos + i, StrCharAt(input, inPos + i));
            i += 1;
        }
        outPos += blockSize;
        inPos += blockSize;
    }
    return outPos;
}

// ============================================================================
// Zlib Compress with LZ77 (with header)
// ============================================================================

pub fn ZlibCompress(input: pchar, input_len: int64, output: pchar, level: int64): int64 {
    if (input_len <= 0) { return 0; }
    if (level < 0 || level > 9) { level := 6; }
    
    var pos: int64 := 0;
    
    // CMF: CM = 8 (DEFLATE), CINFO = 7 (32K-Fenster) → immer 0x78.
    // (Früher korrumpierte `cmf | 1` das CM-Feld.)
    var cmf: int64 := 0x78;
    StrSetChar(output, pos, cmf);
    pos += 1;

    // FLG: FLEVEL (Bits 6-7, nur informativ), FDICT=0, FCHECK (Bits 0-4) so
    // gewählt, dass (CMF*256 + FLG) ein Vielfaches von 31 ist (RFC 1950 §2.2).
    var flevel: int64 := 2;
    if (level <= 1) { flevel := 0; }
    else if (level < 6) { flevel := 1; }
    else if (level >= 7) { flevel := 3; }
    var flg: int64 := flevel << 6;
    var hsum: int64 := cmf * 256 + flg;
    var rem: int64 := hsum - (hsum / 31) * 31;
    if (rem != 0) { flg := flg + (31 - rem); }
    StrSetChar(output, pos, flg);
    pos += 1;
    
    // Compress data using LZ77 — NACH dem 2-Byte-Header schreiben (sonst Clobber!)
    var compressed: int64 := DeflateCompressLZ77(input, input_len, (output as int64 + pos) as pchar);
    pos += compressed;
    
    // Adler-32 checksum
    var adler: int64 := Adler32(input, input_len);
    StrSetChar(output, pos, (adler / 16777216) & 255);
    StrSetChar(output, pos + 1, (adler / 65536) & 255);
    StrSetChar(output, pos + 2, (adler / 256) & 255);
    StrSetChar(output, pos + 3, adler & 255);
    pos += 4;
    
    return pos;
}

// ============================================================================
// Compression Level Helper
// ============================================================================

pub fn ZlibCompressDefault(input: pchar, input_len: int64, output: pchar): int64 {
    return ZlibCompress(input, input_len, output, Z_DEFAULT_COMPRESSION);
}

// ============================================================================
// Get Compressed Size Estimate
// ============================================================================

pub fn ZlibCompressBound(input_len: int64): int64 {
    var a: int64 := input_len + 65534;
    var b: int64 := a / 65535;
    var c: int64 := b * 4;
    var d: int64 := 2 + input_len + c;
    return d + 4;
}

// ============================================================================
// DEFLATE Decompression (Inflate) - Simplified without structs
// ============================================================================

// Read bit from position
fn ReadBit(data: pchar, pos: int64, len: int64, bit_pos: int64): int64 {
    if (pos >= len) { return -1; }
    var byte_pos: int64 := pos;
    var bit_idx: int64 := bit_pos & 7;
    var byte_pos2: int64 := pos + bit_idx / 8;
    if (byte_pos2 >= len) { return -1; }
    var b: int64 := StrCharAt(data, byte_pos2);
    var bit: int64 := (b >> (bit_idx & 7)) & 1;
    return bit;
}

// Read multiple bits
fn ReadBits(data: pchar, pos: int64, len: int64, bit_pos: int64, num_bits: int64): int64 {
    var result: int64 := 0;
    var i: int64 := 0;
    while (i < num_bits) {
        var bit: int64 := ReadBit(data, pos, len, bit_pos + i);
        if (bit < 0) { return -1; }
        result := result + (bit << i);
        i += 1;
    }
    return result;
}

// Decode length from LZ77 length code
fn DecodeLengthValue(code: int64): int64 {
    if (code == 257) { return 3; }
    if (code == 258) { return 4; }
    if (code == 259) { return 5; }
    if (code == 260) { return 6; }
    if (code == 261) { return 7; }
    if (code == 262) { return 8; }
    if (code == 263) { return 9; }
    if (code == 264) { return 10; }
    if (code == 265) { return 11; }
    if (code == 266) { return 13; }
    if (code == 267) { return 15; }
    if (code == 268) { return 17; }
    if (code == 269) { return 19; }
    if (code == 270) { return 23; }
    if (code == 271) { return 27; }
    if (code == 272) { return 31; }
    if (code == 273) { return 35; }
    if (code == 274) { return 43; }
    if (code == 275) { return 51; }
    if (code == 276) { return 59; }
    if (code == 277) { return 67; }
    if (code == 278) { return 83; }
    if (code == 279) { return 99; }
    if (code == 280) { return 115; }
    if (code == 281) { return 131; }
    if (code == 282) { return 163; }
    if (code == 283) { return 195; }
    if (code == 284) { return 227; }
    return 258;
}

// Decode distance
fn DecodeDistanceValue(extra_bits: int64, extra: int64): int64 {
    // Distance base values for each code
    if (extra_bits == 0) {
        return 1 + extra;
    }
    if (extra_bits == 1) {
        return 1 + 2 + extra;
    }
    if (extra_bits == 2) {
        return 1 + 4 + extra;
    }
    if (extra_bits == 3) {
        return 1 + 8 + extra;
    }
    if (extra_bits == 4) {
        return 1 + 16 + extra;
    }
    if (extra_bits == 5) {
        return 1 + 32 + extra;
    }
    return 1 + extra;
}

// Decode fixed Huffman symbol (simplified)
fn DecodeHuffmanSymbol(data: pchar, len: int64, bit_pos: int64): int64 {
    var bits: int64 := ReadBits(data, 0, len, bit_pos, 7);
    if (bits < 96) {
        return bits + 48;  // 0-143
    }
    if (bits >= 128 && bits < 160) {
        return bits - 128 + 144;  // 144-175
    }
    if (bits >= 160 && bits < 192) {
        return bits - 160 + 256;  // 256-287 (but 257+ for lengths)
    }
    // Try 8 bits
    var bits8: int64 := ReadBits(data, 0, len, bit_pos, 8);
    if (bits8 < 256) {
        return bits8;
    }
    return bits8 - 256;
}

// ---------------------------------------------------------------------------
// RFC 1951 DEFLATE inflate — korrekte Implementierung (V-4).
//
// Ersetzt den alten Decoder, der (a) in ReadBit das Byte-Offset (bit_pos/8)
// ignorierte (las nur Byte 0), (b) Huffman-Codes LSB- statt MSB-first dekodierte,
// (c) Längen-/Distanz-Extrabits nicht las und (d) Dynamic-Huffman nicht konnte.
// Folge: SIGSEGV (Runaway-Copy) auf jedem komprimierten Stream → PNG/ZIP kaputt.
//
// Canonical-Huffman-Decode nach puff.c-Schema. Unterstützt stored (btype=0),
// fixed (btype=1) und dynamic (btype=2) Huffman.
// ---------------------------------------------------------------------------
pub type Inflater = class {
    input:     int64;   // Eingabe-Bytes (pchar as int64)
    input_len: int64;
    output:    int64;   // Ausgabe-Buffer
    bit_pos:   int64;   // absolute Bit-Position in input
    out_pos:   int64;   // geschriebene Ausgabe-Bytes
    out_max:   int64;   // #1070: Obergrenze; 0 = unbeschraenkt (Altverhalten)
    out_full:  int64;   // #1070: 1, wenn an out_max abgebrochen wurde

    lenBase:   int64;   // int64[29]  Längen-Basiswerte (Symbol 257..285)
    lenExtra:  int64;   // int64[29]  Längen-Extrabits
    distBase:  int64;   // int64[30]
    distExtra: int64;   // int64[30]

    litCnt:    int64;   // Huffman: count[16] für Literal/Längen-Baum
    litSym:    int64;   // Huffman: symbol[288]
    distCnt:   int64;   // count[16] für Distanz-Baum
    distSym:   int64;   // symbol[32]
    clCnt:     int64;   // count[16] für Code-Längen-Baum (dynamic)
    clSym:     int64;   // symbol[19]
    lensBuf:   int64;   // int64[320] Code-Längen-Scratch (288 lit + 32 dist)

    pub fn init(inp: int64, ilen: int64, outp: int64): void {
        self.input     := inp;
        self.input_len := ilen;
        self.output    := outp;
        self.bit_pos   := 0;
        self.out_pos   := 0;
        self.out_max   := 0;
        self.out_full  := 0;
        self.lenBase   := alloc(29 * 8);
        self.lenExtra  := alloc(29 * 8);
        self.distBase  := alloc(30 * 8);
        self.distExtra := alloc(30 * 8);
        self.litCnt    := alloc(16 * 8);
        self.litSym    := alloc(288 * 8);
        self.distCnt   := alloc(16 * 8);
        self.distSym   := alloc(32 * 8);
        self.clCnt     := alloc(16 * 8);
        self.clSym     := alloc(19 * 8);
        self.lensBuf   := alloc(320 * 8);
        self.fillTables();
    }

    // Ein Bit aus dem Strom (LSB-first innerhalb des Bytes).
    fn readBit(): int64 {
        var bp: int64 := self.bit_pos;
        var bytePos: int64 := bp >> 3;
        if (bytePos >= self.input_len) { return -1; }
        var b: int64 := peek8(self.input + bytePos);
        var bit: int64 := (b >> (bp & 7)) & 1;
        self.bit_pos := bp + 1;
        return bit;
    }

    // n Bits, LSB-first (für Header-Felder und Längen-/Distanz-Extrabits).
    fn readBits(n: int64): int64 {
        var v: int64 := 0;
        var i: int64 := 0;
        while (i < n) {
            var bit: int64 := self.readBit();
            if (bit < 0) { return -1; }
            v := v + (bit << i);
            i += 1;
        }
        return v;
    }

    // Canonical-Huffman aus Code-Längen lens[0..n-1] in cnt[16]/sym[n] bauen.
    fn buildHuff(lens: int64, n: int64, cnt: int64, sym: int64): void {
        var i: int64 := 0;
        while (i <= 15) { poke64(cnt + i * 8, 0); i := i + 1; }
        i := 0;
        while (i < n) {
            var l: int64 := peek64(lens + i * 8);
            poke64(cnt + l * 8, peek64(cnt + l * 8) + 1);
            i += 1;
        }
        // Offsets je Länge (Symbole der Länge 0 werden nicht platziert)
        var offs: int64 := alloc(16 * 8);
        poke64(offs + 1 * 8, 0);
        var ln: int64 := 1;
        while (ln < 15) {
            poke64(offs + (ln + 1) * 8, peek64(offs + ln * 8) + peek64(cnt + ln * 8));
            ln += 1;
        }
        i := 0;
        while (i < n) {
            var l2: int64 := peek64(lens + i * 8);
            if (l2 != 0) {
                var o: int64 := peek64(offs + l2 * 8);
                poke64(sym + o * 8, i);
                poke64(offs + l2 * 8, o + 1);
            }
            i += 1;
        }
    }

    // Ein Symbol aus dem Strom dekodieren (MSB-first Code-Akkumulation).
    fn decode(cnt: int64, sym: int64): int64 {
        var code:  int64 := 0;
        var first: int64 := 0;
        var index: int64 := 0;
        var ln:    int64 := 1;
        while (ln <= 15) {
            var bit: int64 := self.readBit();
            if (bit < 0) { return -1; }
            code := code | bit;
            var count: int64 := peek64(cnt + ln * 8);
            if ((code - first) < count) {
                return peek64(sym + (index + (code - first)) * 8);
            }
            index += count;
            first += count;
            first := first << 1;
            code  := code << 1;
            ln += 1;
        }
        return -1;
    }

    // Längen-/Distanz-Basis- und Extrabit-Tabellen füllen (RFC 1951 §3.2.5).
    fn fillTables(): void {
        var lb: int64 := self.lenBase;
        var le: int64 := self.lenExtra;
        self.put2(lb, le, 0, 3, 0);    self.put2(lb, le, 1, 4, 0);
        self.put2(lb, le, 2, 5, 0);    self.put2(lb, le, 3, 6, 0);
        self.put2(lb, le, 4, 7, 0);    self.put2(lb, le, 5, 8, 0);
        self.put2(lb, le, 6, 9, 0);    self.put2(lb, le, 7, 10, 0);
        self.put2(lb, le, 8, 11, 1);   self.put2(lb, le, 9, 13, 1);
        self.put2(lb, le, 10, 15, 1);  self.put2(lb, le, 11, 17, 1);
        self.put2(lb, le, 12, 19, 2);  self.put2(lb, le, 13, 23, 2);
        self.put2(lb, le, 14, 27, 2);  self.put2(lb, le, 15, 31, 2);
        self.put2(lb, le, 16, 35, 3);  self.put2(lb, le, 17, 43, 3);
        self.put2(lb, le, 18, 51, 3);  self.put2(lb, le, 19, 59, 3);
        self.put2(lb, le, 20, 67, 4);  self.put2(lb, le, 21, 83, 4);
        self.put2(lb, le, 22, 99, 4);  self.put2(lb, le, 23, 115, 4);
        self.put2(lb, le, 24, 131, 5); self.put2(lb, le, 25, 163, 5);
        self.put2(lb, le, 26, 195, 5); self.put2(lb, le, 27, 227, 5);
        self.put2(lb, le, 28, 258, 0);
        var db: int64 := self.distBase;
        var de: int64 := self.distExtra;
        self.put2(db, de, 0, 1, 0);     self.put2(db, de, 1, 2, 0);
        self.put2(db, de, 2, 3, 0);     self.put2(db, de, 3, 4, 0);
        self.put2(db, de, 4, 5, 1);     self.put2(db, de, 5, 7, 1);
        self.put2(db, de, 6, 9, 2);     self.put2(db, de, 7, 13, 2);
        self.put2(db, de, 8, 17, 3);    self.put2(db, de, 9, 25, 3);
        self.put2(db, de, 10, 33, 4);   self.put2(db, de, 11, 49, 4);
        self.put2(db, de, 12, 65, 5);   self.put2(db, de, 13, 97, 5);
        self.put2(db, de, 14, 129, 6);  self.put2(db, de, 15, 193, 6);
        self.put2(db, de, 16, 257, 7);  self.put2(db, de, 17, 385, 7);
        self.put2(db, de, 18, 513, 8);  self.put2(db, de, 19, 769, 8);
        self.put2(db, de, 20, 1025, 9); self.put2(db, de, 21, 1537, 9);
        self.put2(db, de, 22, 2049, 10); self.put2(db, de, 23, 3073, 10);
        self.put2(db, de, 24, 4097, 11); self.put2(db, de, 25, 6145, 11);
        self.put2(db, de, 26, 8193, 12); self.put2(db, de, 27, 12289, 12);
        self.put2(db, de, 28, 16385, 13); self.put2(db, de, 29, 24577, 13);
    }

    fn put2(base: int64, extra: int64, i: int64, b: int64, e: int64): void {
        poke64(base + i * 8, b);
        poke64(extra + i * 8, e);
    }

    // Fixed-Huffman-Bäume gemäß RFC 1951 §3.2.6 aufbauen.
    fn fixedTrees(): void {
        var lens: int64 := self.lensBuf;
        var i: int64 := 0;
        while (i < 144) { poke64(lens + i * 8, 8); i := i + 1; }
        while (i < 256) { poke64(lens + i * 8, 9); i := i + 1; }
        while (i < 280) { poke64(lens + i * 8, 7); i := i + 1; }
        while (i < 288) { poke64(lens + i * 8, 8); i := i + 1; }
        self.buildHuff(lens, 288, self.litCnt, self.litSym);
        i := 0;
        while (i < 30) { poke64(lens + i * 8, 5); i := i + 1; }
        self.buildHuff(lens, 30, self.distCnt, self.distSym);
    }

    // Dynamic-Huffman-Bäume aus dem Block-Header lesen (RFC 1951 §3.2.7).
    // Rückgabe: 0 = OK, -1 = Fehler.
    fn dynamicTrees(): int64 {
        var hlit:  int64 := self.readBits(5) + 257;
        var hdist: int64 := self.readBits(5) + 1;
        var hclen: int64 := self.readBits(4) + 4;
        if (hlit < 257 || hdist < 1 || hclen < 4) { return -1; }
        // Reihenfolge der Code-Längen-Code-Längen
        var order: int64 := alloc(19 * 8);
        self.fillOrder(order);
        var cl: int64 := alloc(19 * 8);
        var i: int64 := 0;
        while (i < 19) { poke64(cl + i * 8, 0); i := i + 1; }
        i := 0;
        while (i < hclen) {
            var v: int64 := self.readBits(3);
            if (v < 0) { return -1; }
            poke64(cl + peek64(order + i * 8) * 8, v);
            i += 1;
        }
        self.buildHuff(cl, 19, self.clCnt, self.clSym);
        // HLIT+HDIST Code-Längen mit dem CL-Baum dekodieren
        var lens: int64 := self.lensBuf;
        var total: int64 := hlit + hdist;
        var n: int64 := 0;
        while (n < total) {
            var s: int64 := self.decode(self.clCnt, self.clSym);
            if (s < 0) { return -1; }
            if (s < 16) {
                poke64(lens + n * 8, s);
                n += 1;
            } else if (s == 16) {
                if (n == 0) { return -1; }
                var prev: int64 := peek64(lens + (n - 1) * 8);
                var r: int64 := self.readBits(2) + 3;
                while (r > 0) { poke64(lens + n * 8, prev); n := n + 1; r := r - 1; }
            } else if (s == 17) {
                var r2: int64 := self.readBits(3) + 3;
                while (r2 > 0) { poke64(lens + n * 8, 0); n := n + 1; r2 := r2 - 1; }
            } else {
                var r3: int64 := self.readBits(7) + 11;
                while (r3 > 0) { poke64(lens + n * 8, 0); n := n + 1; r3 := r3 - 1; }
            }
        }
        if (n != total) { return -1; }
        // In Literal/Längen- und Distanz-Längen aufteilen
        self.buildHuff(lens, hlit, self.litCnt, self.litSym);
        // Distanz-Längen ans Array-Anfang verschieben
        var d: int64 := 0;
        while (d < hdist) {
            poke64(lens + d * 8, peek64(lens + (hlit + d) * 8));
            d += 1;
        }
        self.buildHuff(lens, hdist, self.distCnt, self.distSym);
        return 0;
    }

    fn fillOrder(order: int64): void {
        poke64(order + 0 * 8, 16);  poke64(order + 1 * 8, 17); poke64(order + 2 * 8, 18);
        poke64(order + 3 * 8, 0);   poke64(order + 4 * 8, 8);  poke64(order + 5 * 8, 7);
        poke64(order + 6 * 8, 9);   poke64(order + 7 * 8, 6);  poke64(order + 8 * 8, 10);
        poke64(order + 9 * 8, 5);   poke64(order + 10 * 8, 11); poke64(order + 11 * 8, 4);
        poke64(order + 12 * 8, 12); poke64(order + 13 * 8, 3);  poke64(order + 14 * 8, 13);
        poke64(order + 15 * 8, 2);  poke64(order + 16 * 8, 14); poke64(order + 17 * 8, 1);
        poke64(order + 18 * 8, 15);
    }

    // Einen komprimierten Block (fixed/dynamic) dekodieren. 0 = OK, -1 = Fehler.
    fn inflateBlock(): int64 {
        while (1 == 1) {
            var s: int64 := self.decode(self.litCnt, self.litSym);
            if (s < 0) { return -1; }
            if (s < 256) {
                if (self.out_max > 0 && self.out_pos >= self.out_max) { self.out_full := 1; return -1; }
                poke8(self.output + self.out_pos, s & 0xFF);
                self.out_pos += 1;
            } else if (s == 256) {
                return 0;
            } else {
                var si: int64 := s - 257;
                if (si < 0 || si >= 29) { return -1; }
                var length: int64 := peek64(self.lenBase + si * 8) + self.readBits(peek64(self.lenExtra + si * 8));
                var ds: int64 := self.decode(self.distCnt, self.distSym);
                if (ds < 0 || ds >= 30) { return -1; }
                var dist: int64 := peek64(self.distBase + ds * 8) + self.readBits(peek64(self.distExtra + ds * 8));
                if (dist < 1 || dist > self.out_pos) { return -1; }
                var k: int64 := 0;
                while (k < length) {
                    if (self.out_max > 0 && self.out_pos >= self.out_max) { self.out_full := 1; return -1; }
                    var b: int64 := peek8(self.output + (self.out_pos - dist));
                    poke8(self.output + self.out_pos, b);
                    self.out_pos += 1;
                    k += 1;
                }
            }
        }
        return 0;
    }

    pub fn run(): int64 {
        var fin: int64 := 0;
        while (fin == 0) {
            var bfinal: int64 := self.readBits(1);
            var btype:  int64 := self.readBits(2);
            if (bfinal < 0 || btype < 0) { return -1; }
            if (bfinal == 1) { fin := 1; }

            if (btype == 0) {
                // Stored: auf Byte-Grenze ausrichten
                var bp: int64 := (self.bit_pos + 7) & (0 - 8);
                var bytePos: int64 := bp >> 3;
                if (bytePos + 4 > self.input_len) { return -1; }
                var slen: int64 := peek8(self.input + bytePos) + peek8(self.input + bytePos + 1) * 256;
                bytePos += 4;
                if (bytePos + slen > self.input_len) { return -1; }
                var k: int64 := 0;
                while (k < slen) {
                    if (self.out_max > 0 && self.out_pos >= self.out_max) { self.out_full := 1; return -1; }
                    poke8(self.output + self.out_pos, peek8(self.input + bytePos + k));
                    self.out_pos += 1;
                    k += 1;
                }
                self.bit_pos := (bytePos + slen) << 3;
            } else if (btype == 1) {
                self.fixedTrees();
                if (self.inflateBlock() < 0) { return -1; }
            } else if (btype == 2) {
                if (self.dynamicTrees() < 0) { return -1; }
                if (self.inflateBlock() < 0) { return -1; }
            } else {
                return -1;
            }
        }
        return self.out_pos;
    }
}

// Inflate eines rohen DEFLATE-Streams (stored + fixed + dynamic Huffman, RFC 1951).
pub fn InflateDEFLATE(input: pchar, input_len: int64, output: pchar): int64 {
    var inf: Inflater := new Inflater();
    inf.init(input as int64, input_len, output as int64);
    return inf.run();
}

// #1070: Wie InflateDEFLATE, aber mit Obergrenze fuer die Ausgabe. Ohne sie
// schreibt der Inflater so weit, wie der Strom es verlangt -- bei fremden
// Daten also ueber jeden Puffer hinaus. Fuer gzip ist das Pflicht, weil dort
// die Groesse erst im Trailer steht und bis dahin nichts geprueft ist.
// consumedOut (oder 0) nimmt die Zahl der VERBRAUCHTEN EINGABEBYTES auf; die
// braucht ein Aufrufer, um hinter dem Strom weiterzulesen (gzip-Trailer,
// weitere Member).
pub fn InflateDEFLATEBounded(input: pchar, input_len: int64, output: pchar,
                             out_max: int64, consumedOut: int64): int64 {
    var inf: Inflater := new Inflater();
    inf.init(input as int64, input_len, output as int64);
    inf.out_max := out_max;
    var n: int64 := inf.run();
    if (consumedOut != 0) { poke64(consumedOut, (inf.bit_pos + 7) / 8); }
    // #1070: "Puffer zu klein" und "Strom kaputt" muessen unterscheidbar sein,
    // sonst meldet der Aufrufer einem zu kleinen Puffer Datenverfall.
    if ((n < 0) && (inf.out_full != 0)) { return -2; }
    return n;
}

// Zlib Decompress
pub fn ZlibDecompress(input: pchar, input_len: int64, output: pchar): int64 {
    if (input_len <= 0) { return 0; }
    if (input_len < 2) { return -1; }
    
    var cmf: int64 := StrCharAt(input, 0);
    var flg: int64 := StrCharAt(input, 1);
    
    if ((cmf & 15) != 8) { return -1; }
    
    // Check FCHECK
    var cmf_times_256: int64 := cmf * 256;
    var sum: int64 := cmf_times_256 + flg;
    var calc: int64 := sum;
    var tmp: int64 := calc / 31;
    tmp := tmp * 31;
    calc -= tmp;
    
    if (calc != 0) { return -1; }
    
    var fdict: int64 := flg / 32;
    fdict := fdict & 1;
    if (fdict != 0) { return -1; }
    
    // Skip zlib header (2 bytes); trailing 4-Byte-Adler ignoriert InflateDEFLATE
    // automatisch (stoppt am bfinal-Block).
    return InflateDEFLATE((input as int64 + 2) as pchar, input_len - 2, output);
}

// ZlibDecompressToBuffer
pub fn ZlibDecompressToBuffer(input: pchar, input_len: int64, output: pchar, max_out: int64): int64 {
    var result: int64 := ZlibDecompress(input, input_len, output);
    if (result > max_out) { return -1; }
    return result;
}