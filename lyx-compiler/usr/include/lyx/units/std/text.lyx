// ---- UTF-16 boundary converters --------------------------------------------
//
// Only for the boundary: reading UTF-16 files, talking to the Windows API.
// Nothing inside Lyx stores UTF-16 — see the UTF-8-canonical encoding decision.

// Decode `byteLen` bytes of UTF-16 at `ptr` into a Text (UTF-8).
//
// Malformed input does not fail — it yields U+FFFD, one per offending code
// unit: an unpaired high surrogate (no low surrogate follows), a stray low
// surrogate, a truncated pair at the end of the buffer, and a trailing odd
// byte. That keeps the result valid UTF-8; check for U+FFFD if you need to
// reject bad input rather than substitute.
pub fn TextFromUtf16(ptr: int64, byteLen: int64, endian: int64): Text {
  var units: int64 := byteLen / 2;
  var sz: int64 := units * 4 + 4;                 // worst case 4 UTF-8 bytes per unit
  var buf: int64 := mmap(0, sz, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (buf < 0) { return TextFromUtf8(0, 0); }
  var w: int64 := 0;
  var i: int64 := 0;
  while (i < units) {
    var u: int64 := _u16At(ptr, i * 2, endian);
    var cp: int64 := u;
    if (_isHighSurrogate(u) != 0) {
      if (i + 1 < units) {
        var lo: int64 := _u16At(ptr, (i + 1) * 2, endian);
        if (_isLowSurrogate(lo) != 0) {
          cp := 65536 + (((u - 55296) << 10) | (lo - 56320));
          i += 1;                                  // consumed the pair
        } else {
          cp := UNICODE_REPLACEMENT;               // high surrogate, no low
        }
      } else {
        cp := UNICODE_REPLACEMENT;                 // truncated pair
      }
    } else if (_isLowSurrogate(u) != 0) {
      cp := UNICODE_REPLACEMENT;                   // stray low surrogate
    }
    w += CodepointToUtf8(cp, buf + w);
    i += 1;
  }
  if (byteLen - units * 2 != 0) {                  // odd trailing byte
    w += CodepointToUtf8(UNICODE_REPLACEMENT, buf + w);
  }
  var r: Text := TextFromUtf8(buf, w);
  munmap(buf, sz);
  return r;
}

// Like TextFromUtf16, but takes the byte order from a leading BOM and strips
// it: U+FEFF -> big endian, U+FFFE -> little endian. With NO BOM the input is
// read as BIG endian, per RFC 2781 for plain "UTF-16" — note that this is the
// opposite of what most Windows-produced files without a BOM actually are, so
// pass the endianness explicitly when you know it.
pub fn TextFromUtf16Bom(ptr: int64, byteLen: int64): Text {
  if (byteLen >= 2) {
    var b0: int64 := peek8(ptr) & 255;
    var b1: int64 := peek8(ptr + 1) & 255;
    if (b0 == 254 && b1 == 255) {                  // FE FF -> BE BOM
      return TextFromUtf16(ptr + 2, byteLen - 2, UTF16_BE);
    }
    if (b0 == 255 && b1 == 254) {                  // FF FE -> LE BOM
      return TextFromUtf16(ptr + 2, byteLen - 2, UTF16_LE);
    }
  }
  return TextFromUtf16(ptr, byteLen, UTF16_BE);
}

// Bytes a UTF-16 encoding of `t` needs, without a BOM (add 2 for one).
pub fn TextUtf16Length(t: Text): int64 { return t.Utf16Length(); }

// Encode `t` as UTF-16 into `dest` (no BOM); returns bytes written.
pub fn TextToUtf16(t: Text, dest: int64, endian: int64): int64 {
  return t.Utf16Encode(dest, endian);
}

// Encode `t` as UTF-16 into `dest`, prefixed with a U+FEFF BOM in the chosen
// byte order; returns bytes written (BOM included). `dest` needs
// TextUtf16Length(t) + 2 bytes.
pub fn TextToUtf16Bom(t: Text, dest: int64, endian: int64): int64 {
  _u16Put(dest, 0, 65279, endian);                 // U+FEFF
  return 2 + t.Utf16Encode(dest + 2, endian);
}
