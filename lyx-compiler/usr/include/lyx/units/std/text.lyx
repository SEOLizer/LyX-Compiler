// std.text — UTF-8 Text type (validated, codepoint-aware)
//
// Per the string-encoding decision (UTF-8 canonical): `Text` is the UTF-8 layer
// on top of raw bytes. It validates UTF-8 at construction and offers codepoint-
// level operations (count, decode) — as opposed to `String`/pchar which are
// byte-level. This needs NO Unicode tables: UTF-8 decode/validate is pure byte
// patterns. Normalisation (NFC/NFD) and grapheme segmentation, which DO need
// tables, are a separate opt-in unit — not here.
//
// libc-free (mmap/munmap), owned bytes, byte length explicit.
//
// `Text` is a CLASS (it used to be a struct). That buys three things:
//   - a method API (t.CodepointCount(), t.Trim(), …) next to the free functions,
//   - operator overloading — `a + b`, `a == b`, `a < b`, `a[i]` (see below),
//   - reference semantics, so a mutating method like Free() actually affects the
//     caller's object instead of a by-value copy.
// Every free function of the old struct API is kept as a thin wrapper, so
// existing callers (std.unicode, std.unicode_case, std.grapheme, …) are
// unaffected.

@description("UTF-8 Text type: validated, codepoint-aware (libc-free)")
@author("Andreas Röne")
@copyright("2024-2026 Andreas Röne")
unit std.text;

fn _pcharLen(p: int64): int64 {
  if (p == 0) { return 0; }
  var n: int64 := 0;
  while ((peek8(p + n) & 255) != 0) { n += 1; }
  return n;
}

// Validate a byte range as UTF-8: correct leading/continuation byte patterns,
// no overlong encodings, no surrogates, codepoints <= U+10FFFF. Returns 1/0.
fn _utf8Validate(ptr: int64, n: int64): int64 {
  var i: int64 := 0;
  while (i < n) {
    var b: int64 := peek8(ptr + i) & 255;
    var extra: int64 := 0;
    var cp: int64 := 0;
    var minCp: int64 := 0;
    if (b < 128) {                       // 0xxxxxxx ASCII
      extra := 0; cp := b; minCp := 0;
    } else if (b >= 194 && b <= 223) {   // 110xxxxx (0xC2..0xDF)
      extra := 1; cp := b & 31; minCp := 128;
    } else if (b >= 224 && b <= 239) {   // 1110xxxx (0xE0..0xEF)
      extra := 2; cp := b & 15; minCp := 2048;
    } else if (b >= 240 && b <= 244) {   // 11110xxx (0xF0..0xF4)
      extra := 3; cp := b & 7; minCp := 65536;
    } else {
      return 0;                          // invalid leading byte (incl. overlong 0xC0/0xC1, 0xF5+)
    }
    if (i + extra >= n) { return 0; }     // truncated sequence
    var j: int64 := 1;
    while (j <= extra) {
      var c: int64 := peek8(ptr + i + j) & 255;
      if ((c & 192) != 128) { return 0; } // not a 10xxxxxx continuation byte
      cp := (cp << 6) | (c & 63);
      j += 1;
    }
    if (extra > 0) {
      if (cp < minCp) { return 0; }                    // overlong
      if (cp > 1114111) { return 0; }                  // > U+10FFFF
      if (cp >= 55296 && cp <= 57343) { return 0; }    // surrogate U+D800..U+DFFF
    }
    i += extra + 1;
  }
  return 1;
}

fn _isAsciiWs(b: int64): int64 {
  if (b == 32 || b == 9 || b == 10 || b == 13) { return 1; }
  return 0;
}

// ---- UTF-16 boundary helpers ------------------------------------------------
//
// UTF-16 is a BOUNDARY format only (Windows FFI, UTF-16 files) — never Lyx's
// internal representation. Everything inside stays UTF-8.

// Byte order for the UTF-16 converters.
pub con UTF16_BE: int64 := 0;
pub con UTF16_LE: int64 := 1;

// U+FFFD REPLACEMENT CHARACTER — what malformed UTF-16 (unpaired surrogate,
// truncated sequence, odd trailing byte) decodes to. Substituting keeps the
// resulting Text valid UTF-8 instead of propagating the damage.
pub con UNICODE_REPLACEMENT: int64 := 65533;

// Read the UTF-16 code unit at byte offset `off`.
fn _u16At(ptr: int64, off: int64, endian: int64): int64 {
  var b0: int64 := peek8(ptr + off) & 255;
  var b1: int64 := peek8(ptr + off + 1) & 255;
  if (endian == UTF16_LE) { return (b1 << 8) | b0; }
  return (b0 << 8) | b1;
}

// Write the UTF-16 code unit `u` at byte offset `off`.
fn _u16Put(dest: int64, off: int64, u: int64, endian: int64) {
  var hi: int64 := (u >> 8) & 255;
  var lo: int64 := u & 255;
  if (endian == UTF16_LE) { poke8(dest + off, lo); poke8(dest + off + 1, hi); }
  else { poke8(dest + off, hi); poke8(dest + off + 1, lo); }
}

fn _isHighSurrogate(u: int64): int64 {
  if (u >= 55296 && u <= 56319) { return 1; }      // U+D800..U+DBFF
  return 0;
}

fn _isLowSurrogate(u: int64): int64 {
  if (u >= 56320 && u <= 57343) { return 1; }      // U+DC00..U+DFFF
  return 0;
}

// Number of int64 slots one part occupies in the raw TextSplit output array:
// [data:8][byteLen:8][valid:8]. Kept as an explicit constant because `Text` is a
// class now, so sizeof(Text) is the handle size, not the field block size.
pub con TEXT_PART_STRIDE: int64 := 24;

pub type Text = class {
  data: int64;     // owned UTF-8 bytes
  byteLen: int64;  // length in bytes
  valid: int64;    // 1 if the bytes are valid UTF-8, else 0

  // --- constructors (call on a `new Text()`) ---------------------------------

  // Copy `n` raw bytes from `ptr` and validate them as UTF-8; the `valid` flag
  // reflects the result (the bytes are stored either way).
  fn InitFromUtf8(ptr: int64, n: int64) {
    var sz: int64 := n;
    if (sz < 1) { sz := 1; }
    self.data := mmap(0, sz, PROT_RW, MAP_ANON, FD_NONE, 0);
    if (self.data < 0) { self.data := 0; self.byteLen := 0; self.valid := 0; return; }
    if (n > 0) { memcpy(self.data, ptr, n); }
    self.byteLen := n;
    self.valid := _utf8Validate(self.data, n);
  }

  fn InitFromPchar(p: int64) {
    self.InitFromUtf8(p, _pcharLen(p));
  }

  // --- queries ---------------------------------------------------------------

  fn ByteLength(): int64 { return self.byteLen; }
  fn IsValid(): int64 { return self.valid; }
  fn Data(): int64 { return self.data; }

  // Raw byte at index `i` (0 if out of range).
  fn ByteAt(i: int64): int64 {
    if (i < 0 || i >= self.byteLen) { return 0; }
    return peek8(self.data + i) & 255;
  }

  // Number of Unicode codepoints (not bytes): count of non-continuation bytes.
  fn CodepointCount(): int64 {
    var cnt: int64 := 0;
    var i: int64 := 0;
    while (i < self.byteLen) {
      if (((peek8(self.data + i) & 255) & 192) != 128) { cnt += 1; }  // leading byte
      i += 1;
    }
    return cnt;
  }

  // Byte offset of the `idx`-th codepoint (-1 if out of range).
  fn ByteOffsetOfCodepoint(idx: int64): int64 {
    if (idx < 0) { return 0 - 1; }
    var seen: int64 := 0;
    var i: int64 := 0;
    while (i < self.byteLen) {
      if (((peek8(self.data + i) & 255) & 192) != 128) {
        if (seen == idx) { return i; }
        seen += 1;
      }
      i += 1;
    }
    return 0 - 1;
  }

  // Decode the `idx`-th codepoint (-1 if out of range).
  fn CodepointAt(idx: int64): int64 {
    var off: int64 := self.ByteOffsetOfCodepoint(idx);
    if (off < 0) { return 0 - 1; }
    var b: int64 := peek8(self.data + off) & 255;
    if (b < 128) { return b; }
    var extra: int64 := 0;
    var cp: int64 := 0;
    if (b < 224) { extra := 1; cp := b & 31; }
    else if (b < 240) { extra := 2; cp := b & 15; }
    else { extra := 3; cp := b & 7; }
    var j: int64 := 1;
    while (j <= extra) {
      cp := (cp << 6) | (peek8(self.data + off + j) & 63);
      j += 1;
    }
    return cp;
  }

  // --- deriving new Texts ----------------------------------------------------

  // self ++ other, as a new Text. Two complete valid UTF-8 sequences
  // concatenated are still valid, so no boundary re-check beyond the standard
  // validation InitFromUtf8 does.
  // (Operator-overloading target: a + b -> a.Add(b).)
  fn Add(other: Text): Text {
    var total: int64 := self.byteLen + other.byteLen;
    var sz: int64 := total;
    if (sz < 1) { sz := 1; }
    var tmp: int64 := mmap(0, sz, PROT_RW, MAP_ANON, FD_NONE, 0);
    var r: Text := new Text();
    if (tmp < 0) { r.InitFromUtf8(0, 0); return r; }
    if (self.byteLen > 0) { memcpy(tmp, self.data, self.byteLen); }
    if (other.byteLen > 0) { memcpy(tmp + self.byteLen, other.data, other.byteLen); }
    r.InitFromUtf8(tmp, total);
    munmap(tmp, sz);
    return r;
  }

  fn Concat(other: Text): Text { return self.Add(other); }

  // Substring by CODEPOINT index: `countCp` codepoints starting at codepoint
  // `startCp` (clamped to the end). Returns a new Text. Unicode-correct — never
  // splits a multibyte sequence.
  fn SubstringCp(startCp: int64, countCp: int64): Text {
    var r: Text := new Text();
    var startByte: int64 := self.ByteOffsetOfCodepoint(startCp);
    if (startByte < 0) { r.InitFromUtf8(0, 0); return r; }
    var endByte: int64 := self.ByteOffsetOfCodepoint(startCp + countCp);
    if (endByte < 0) { endByte := self.byteLen; }   // clamp past the end
    r.InitFromUtf8(self.data + startByte, endByte - startByte);
    return r;
  }

  // --- comparison ------------------------------------------------------------

  // Byte-wise equality. NOTE: equal only for the same Unicode normalisation form
  // (byte-equal). Normalisation-insensitive comparison needs the opt-in unicode
  // unit.
  fn Equals(other: Text): int64 {
    if (self.byteLen != other.byteLen) { return 0; }
    var i: int64 := 0;
    while (i < self.byteLen) {
      if ((peek8(self.data + i) & 255) != (peek8(other.data + i) & 255)) { return 0; }
      i += 1;
    }
    return 1;
  }

  fn EqualsPchar(p: int64): int64 {
    var pl: int64 := _pcharLen(p);
    if (self.byteLen != pl) { return 0; }
    var i: int64 := 0;
    while (i < self.byteLen) {
      if ((peek8(self.data + i) & 255) != (peek8(p + i) & 255)) { return 0; }
      i += 1;
    }
    return 1;
  }

  // True if `self` starts with the byte sequence of `prefix`.
  fn StartsWith(prefix: Text): int64 {
    if (prefix.byteLen > self.byteLen) { return 0; }
    var i: int64 := 0;
    while (i < prefix.byteLen) {
      if ((peek8(self.data + i) & 255) != (peek8(prefix.data + i) & 255)) { return 0; }
      i += 1;
    }
    return 1;
  }

  // --- operator-overloading methods ------------------------------------------
  // These carry the names the compiler's operator overloading looks for, so
  // `a + b`, `a == b`, `a != b`, `a < b`, …, `a[i]` work on Text. (Add is
  // defined above.) `Compare` is a lexicographic comparison of the UTF-8 bytes
  // returning -1/0/1 — which for UTF-8 is the same order as comparing
  // codepoints, so it is a real Unicode code-point ordering, not just a byte
  // artefact. It is NOT a locale collation, and NOT normalisation-insensitive.

  fn Eq(other: Text): int64 { return self.Equals(other); }                 // ==

  fn Ne(other: Text): int64 {                                              // !=
    if (self.Equals(other) != 0) { return 0; }
    return 1;
  }

  fn Compare(other: Text): int64 {
    var n: int64 := self.byteLen;
    if (other.byteLen < n) { n := other.byteLen; }
    var i: int64 := 0;
    while (i < n) {
      var a: int64 := peek8(self.data + i) & 255;
      var b: int64 := peek8(other.data + i) & 255;
      if (a < b) { return 0 - 1; }
      if (a > b) { return 1; }
      i += 1;
    }
    if (self.byteLen < other.byteLen) { return 0 - 1; }
    if (self.byteLen > other.byteLen) { return 1; }
    return 0;
  }

  fn Lt(other: Text): int64 { if (self.Compare(other) <  0) { return 1; } return 0; }  // <
  fn Le(other: Text): int64 { if (self.Compare(other) <= 0) { return 1; } return 0; }  // <=
  fn Gt(other: Text): int64 { if (self.Compare(other) >  0) { return 1; } return 0; }  // >
  fn Ge(other: Text): int64 { if (self.Compare(other) >= 0) { return 1; } return 0; }  // >=

  // a[i] -> the i-th CODEPOINT (not the i-th byte). Text is the codepoint-aware
  // layer, so indexing it by byte would be a trap; use ByteAt for raw bytes.
  fn Get(i: int64): int64 { return self.CodepointAt(i); }                   // a[i]

  // --- interop ---------------------------------------------------------------

  // Fresh NUL-terminated pchar copy (byteLen+1 bytes) the caller owns. 0 on OOM.
  fn ToPchar(): int64 {
    var p: int64 := mmap(0, self.byteLen + 1, PROT_RW, MAP_ANON, FD_NONE, 0);
    if (p < 0) { return 0; }
    if (self.byteLen > 0) { memcpy(p, self.data, self.byteLen); }
    poke8(p + self.byteLen, 0);
    return p;
  }

  // --- UTF-16 boundary (encode) ----------------------------------------------

  // Bytes a UTF-16 encoding of self would need, WITHOUT a BOM. Call this to
  // size the destination buffer before Utf16Encode — the count is not
  // derivable from ByteLength (UTF-8 and UTF-16 disagree per codepoint in both
  // directions: ASCII is 1 vs 2 bytes, U+0800..U+FFFF is 3 vs 2).
  fn Utf16Length(): int64 {
    var n: int64 := 0;
    var i: int64 := 0;
    while (i < self.byteLen) {
      var b: int64 := peek8(self.data + i) & 255;
      var clen: int64 := 1;
      var cp: int64 := b;
      if (b >= 240) { clen := 4; cp := 65536; }        // >= U+10000 -> surrogate pair
      else if (b >= 224) { clen := 3; cp := 2048; }
      else if (b >= 192) { clen := 2; cp := 128; }
      if (cp >= 65536) { n += 4; } else { n += 2; }
      i += clen;
    }
    return n;
  }

  // Encode self as UTF-16 into `dest` (no BOM); returns the bytes written.
  // `dest` must hold at least Utf16Length() bytes. Codepoints above U+FFFF
  // become a surrogate pair, which is the one place UTF-16 is variable-width —
  // and the reason indexing UTF-16 by code unit is a trap.
  fn Utf16Encode(dest: int64, endian: int64): int64 {
    var w: int64 := 0;
    var i: int64 := 0;
    while (i < self.byteLen) {
      var b: int64 := peek8(self.data + i) & 255;
      var clen: int64 := 1;
      var cp: int64 := b;
      if (b >= 240) {
        clen := 4;
        cp := ((b & 7) << 18) | ((peek8(self.data + i + 1) & 63) << 12)
              | ((peek8(self.data + i + 2) & 63) << 6) | (peek8(self.data + i + 3) & 63);
      } else if (b >= 224) {
        clen := 3;
        cp := ((b & 15) << 12) | ((peek8(self.data + i + 1) & 63) << 6)
              | (peek8(self.data + i + 2) & 63);
      } else if (b >= 192) {
        clen := 2;
        cp := ((b & 31) << 6) | (peek8(self.data + i + 1) & 63);
      }
      if (cp >= 65536) {
        var v: int64 := cp - 65536;
        _u16Put(dest, w, 55296 | ((v >> 10) & 1023), endian);        // high surrogate
        _u16Put(dest, w + 2, 56320 | (v & 1023), endian);            // low surrogate
        w += 4;
      } else {
        _u16Put(dest, w, cp, endian);
        w += 2;
      }
      i += clen;
    }
    return w;
  }

  // --- ASCII case ------------------------------------------------------------

  // ASCII-only upper/lower casing (A-Z <-> a-z); bytes >= 0x80 (all multibyte
  // UTF-8 bytes) are left untouched, so the result stays valid UTF-8. Full
  // Unicode case mapping needs the opt-in unicode / unicode_case units.
  fn AsciiUpper(): Text {
    var r: Text := new Text();
    r.InitFromUtf8(self.data, self.byteLen);
    var i: int64 := 0;
    while (i < r.byteLen) {
      var b: int64 := peek8(r.data + i) & 255;
      if (b >= 97 && b <= 122) { poke8(r.data + i, b - 32); }
      i += 1;
    }
    return r;
  }

  fn AsciiLower(): Text {
    var r: Text := new Text();
    r.InitFromUtf8(self.data, self.byteLen);
    var i: int64 := 0;
    while (i < r.byteLen) {
      var b: int64 := peek8(r.data + i) & 255;
      if (b >= 65 && b <= 90) { poke8(r.data + i, b + 32); }
      i += 1;
    }
    return r;
  }

  // --- search / trim / replace / split ---------------------------------------

  // Do `needle`'s bytes appear in self starting at byte offset `i`?
  fn BytesEqAt(i: int64, needle: Text): int64 {
    if (i + needle.byteLen > self.byteLen) { return 0; }
    var j: int64 := 0;
    while (j < needle.byteLen) {
      if ((peek8(self.data + i + j) & 255) != (peek8(needle.data + j) & 255)) { return 0; }
      j += 1;
    }
    return 1;
  }

  // Byte offset of the first occurrence of `needle`, or -1. Safe on UTF-8: the
  // encoding is self-synchronising, so a byte match is always a real match.
  fn Find(needle: Text): int64 {
    if (needle.byteLen == 0) { return 0; }
    if (needle.byteLen > self.byteLen) { return 0 - 1; }
    var i: int64 := 0;
    while (i + needle.byteLen <= self.byteLen) {
      if (self.BytesEqAt(i, needle) != 0) { return i; }
      i += 1;
    }
    return 0 - 1;
  }

  // Codepoint index of the first occurrence of `needle`, or -1.
  fn FindCp(needle: Text): int64 {
    var off: int64 := self.Find(needle);
    if (off < 0) { return 0 - 1; }
    var cp: int64 := 0;
    var i: int64 := 0;
    while (i < off) {
      if (((peek8(self.data + i) & 255) & 192) != 128) { cp += 1; }
      i += 1;
    }
    return cp;
  }

  fn Contains(needle: Text): int64 {
    if (self.Find(needle) >= 0) { return 1; }
    return 0;
  }

  // Trim leading/trailing ASCII whitespace (space, tab, LF, CR). ASCII bytes are
  // < 0x80 so this never touches a multibyte sequence. Unicode whitespace
  // trimming is for the opt-in unicode unit.
  fn Trim(): Text {
    var start: int64 := 0;
    while (start < self.byteLen && _isAsciiWs(peek8(self.data + start) & 255) != 0) { start += 1; }
    var end: int64 := self.byteLen;
    while (end > start && _isAsciiWs(peek8(self.data + end - 1) & 255) != 0) { end -= 1; }
    var r: Text := new Text();
    r.InitFromUtf8(self.data + start, end - start);
    return r;
  }

  // Replace every (non-overlapping) occurrence of `old` with `repl`; new Text.
  // (`new` is a reserved keyword, so the replacement is named `repl`.)
  fn Replace(old: Text, repl: Text): Text {
    var res: Text := new Text();
    if (old.byteLen == 0 || old.byteLen > self.byteLen) {
      res.InitFromUtf8(self.data, self.byteLen);
      return res;
    }
    // Pass 1: count occurrences to size the result exactly.
    var count: int64 := 0;
    var i: int64 := 0;
    while (i + old.byteLen <= self.byteLen) {
      if (self.BytesEqAt(i, old) != 0) { count += 1; i += old.byteLen; }
      else { i += 1; }
    }
    var resultLen: int64 := self.byteLen + count * (repl.byteLen - old.byteLen);
    var sz: int64 := resultLen;
    if (sz < 1) { sz := 1; }
    var buf: int64 := mmap(0, sz, PROT_RW, MAP_ANON, FD_NONE, 0);
    if (buf < 0) { res.InitFromUtf8(self.data, self.byteLen); return res; }
    // Pass 2: build.
    var w: int64 := 0;
    var r: int64 := 0;
    while (r < self.byteLen) {
      if (r + old.byteLen <= self.byteLen && self.BytesEqAt(r, old) != 0) {
        if (repl.byteLen > 0) { memcpy(buf + w, repl.data, repl.byteLen); }
        w += repl.byteLen;
        r += old.byteLen;
      } else {
        poke8(buf + w, peek8(self.data + r) & 255);
        w += 1;
        r += 1;
      }
    }
    res.InitFromUtf8(buf, resultLen);
    munmap(buf, sz);
    return res;
  }

  // Number of parts `self` splits into on `sep` (always >= 1 for a non-empty
  // separator). The OO counterpart to the raw Split below: SplitCount + PartAt
  // need no caller-managed output buffer.
  fn SplitCount(sep: Text): int64 {
    if (sep.byteLen == 0) { return 0; }
    var count: int64 := 0;
    var i: int64 := 0;
    while (i + sep.byteLen <= self.byteLen) {
      if (self.BytesEqAt(i, sep) != 0) { count += 1; i += sep.byteLen; }
      else { i += 1; }
    }
    return count + 1;
  }

  // The `idx`-th part of splitting `self` on `sep`, as a new Text (empty Text if
  // `idx` is out of range).
  fn PartAt(sep: Text, idx: int64): Text {
    var r: Text := new Text();
    if (sep.byteLen == 0 || idx < 0) { r.InitFromUtf8(0, 0); return r; }
    var seen: int64 := 0;
    var start: int64 := 0;
    var i: int64 := 0;
    while (i + sep.byteLen <= self.byteLen) {
      if (self.BytesEqAt(i, sep) != 0) {
        if (seen == idx) { r.InitFromUtf8(self.data + start, i - start); return r; }
        seen += 1;
        i += sep.byteLen;
        start := i;
      } else {
        i += 1;
      }
    }
    if (seen == idx) { r.InitFromUtf8(self.data + start, self.byteLen - start); return r; }
    r.InitFromUtf8(0, 0);
    return r;
  }

  // Split `self` on `sep`, writing up to `maxParts` raw field blocks into the
  // array at `out` (TEXT_PART_STRIDE bytes each: [data][byteLen][valid]).
  // Returns the total number of parts (which may exceed maxParts — only the
  // first maxParts are written). Prefer SplitCount + PartAt; this raw form
  // exists for callers that already manage their own buffer.
  fn Split(sep: Text, out: int64, maxParts: int64): int64 {
    if (sep.byteLen == 0) { return 0; }
    var stride: int64 := TEXT_PART_STRIDE;
    var count: int64 := 0;
    var start: int64 := 0;
    var i: int64 := 0;
    while (i + sep.byteLen <= self.byteLen) {
      if (self.BytesEqAt(i, sep) != 0) {
        if (count < maxParts) {
          var part: Text := new Text();
          part.InitFromUtf8(self.data + start, i - start);
          poke64(out + count * stride + 0,  part.data);
          poke64(out + count * stride + 8,  part.byteLen);
          poke64(out + count * stride + 16, part.valid);
        }
        count += 1;
        i += sep.byteLen;
        start := i;
      } else {
        i += 1;
      }
    }
    if (count < maxParts) {
      var last: Text := new Text();
      last.InitFromUtf8(self.data + start, self.byteLen - start);
      poke64(out + count * stride + 0,  last.data);
      poke64(out + count * stride + 8,  last.byteLen);
      poke64(out + count * stride + 16, last.valid);
    }
    count += 1;
    return count;
  }

  // --- lifetime --------------------------------------------------------------

  // Release the owned bytes. Now that Text is a class this really clears the
  // caller's object — as a struct it only cleared a by-value copy.
  fn Free() {
    if (self.data != 0) {
      var sz: int64 := self.byteLen;
      if (sz < 1) { sz := 1; }
      munmap(self.data, sz);
    }
    self.data := 0;
    self.byteLen := 0;
    self.valid := 0;
  }
};

// ---- free-function API (unchanged surface, delegates to the methods) --------

// Build a Text from `n` raw bytes at `ptr` (copied). Validates UTF-8; the
// `valid` flag reflects the result (the bytes are stored either way).
pub fn TextFromUtf8(ptr: int64, n: int64): Text {
  var t: Text := new Text();
  t.InitFromUtf8(ptr, n);
  return t;
}

// Build a Text from a NUL-terminated pchar (UTF-8).
pub fn TextFromPchar(p: pchar): Text {
  var t: Text := new Text();
  t.InitFromPchar(p);
  return t;
}

pub fn TextByteLength(t: Text): int64 { return t.ByteLength(); }
pub fn TextIsValid(t: Text): int64 { return t.IsValid(); }
pub fn TextData(t: Text): int64 { return t.Data(); }

pub fn TextByteAt(t: Text, i: int64): int64 { return t.ByteAt(i); }
pub fn TextCodepointCount(t: Text): int64 { return t.CodepointCount(); }

pub fn TextByteOffsetOfCodepoint(t: Text, idx: int64): int64 {
  return t.ByteOffsetOfCodepoint(idx);
}

pub fn TextCodepointAt(t: Text, idx: int64): int64 { return t.CodepointAt(idx); }

// UTF-8 byte length of a single codepoint (1..4; 0 if invalid).
pub fn CodepointUtf8Len(cp: int64): int64 {
  if (cp < 0) { return 0; }
  if (cp < 128) { return 1; }
  if (cp < 2048) { return 2; }
  if (cp < 65536) {
    if (cp >= 55296 && cp <= 57343) { return 0; }  // surrogate
    return 3;
  }
  if (cp <= 1114111) { return 4; }
  return 0;
}

// Encode codepoint `cp` as UTF-8 into `dest`; returns bytes written (0 if invalid).
pub fn CodepointToUtf8(cp: int64, dest: int64): int64 {
  var n: int64 := CodepointUtf8Len(cp);
  if (n == 1) {
    poke8(dest, cp & 127);
  } else if (n == 2) {
    poke8(dest,     192 | ((cp >> 6) & 31));
    poke8(dest + 1, 128 | (cp & 63));
  } else if (n == 3) {
    poke8(dest,     224 | ((cp >> 12) & 15));
    poke8(dest + 1, 128 | ((cp >> 6) & 63));
    poke8(dest + 2, 128 | (cp & 63));
  } else if (n == 4) {
    poke8(dest,     240 | ((cp >> 18) & 7));
    poke8(dest + 1, 128 | ((cp >> 12) & 63));
    poke8(dest + 2, 128 | ((cp >> 6) & 63));
    poke8(dest + 3, 128 | (cp & 63));
  }
  return n;
}

pub fn TextConcat(a: Text, b: Text): Text { return a.Add(b); }

