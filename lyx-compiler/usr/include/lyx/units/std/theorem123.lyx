// std/theorem123.lyx
// Das 123-Theorem (Alon/Yuster 1995) — Naehewahrscheinlichkeiten zweier
// unabhaengiger, identisch verteilter Zufallsvariablen.

@description("123 theorem: bounds on P(|X-Y| <= b) by P(|X-Y| <= a) for i.i.d. variables")
@author("Andreas Roene")
@copyright("2026 Andreas Roene")
unit std.theorem123;

import std.math;
import std.alloc;

// ── Was das Theorem sagt ─────────────────────────────────────────────────────
//
// Fuer zwei stochastisch unabhaengige und identisch verteilte reellwertige
// Zufallsvariablen X und Y gilt
//
//     P(|X - Y| <= 2)  <  3 * P(|X - Y| <= 1)
//
// und allgemein fuer 0 < a < b
//
//     P(|X - Y| <= b)  <  (2 * ceil(b/a) - 1) * P(|X - Y| <= a).
//
// Die Ungleichung ist STRIKT, und die Konstante ist nicht zu verbessern: sie
// wird beliebig genau erreicht, aber nie angenommen. Genau das macht sie als
// Pruefung brauchbar — wer eine Schaetzung von P(|X-Y| <= b) hat, die die
// Schranke erreicht oder ueberschreitet, hat einen Fehler in der Schaetzung,
// nicht ein Gegenbeispiel zum Theorem.
//
// ── Was diese Einheit rechnet ────────────────────────────────────────────────
//
// Zwei Darstellungen einer Verteilung:
//
//   STICHPROBE   n Messwerte, jeder mit Gewicht 1/n. Das ist die empirische
//                Verteilung; X und Y sind zwei unabhaengige Zuege MIT
//                Zuruecklegen. Der Fall i == j gehoert dazu — er ist der
//                Grund, warum P(|X-Y| <= a) fuer eine Stichprobe nie 0 ist.
//
//   GEWICHTET    n Werte mit n Gewichten (Summe 1). Fuer Verteilungen mit
//                wenigen Atomen die genauere Darstellung: 10^6 gleiche
//                Messwerte sind ein Gewicht, keine Million Eintraege.
//
// Gerechnet wird EXAKT ueber alle Paare, nicht geschaetzt: O(n^2)
// Vergleiche. Fuer die Groessenordnungen, in denen man ein Theorem
// nachprueft (n bis einige Tausend), ist das der richtige Tausch — eine
// Monte-Carlo-Schaetzung wuerde die STRIKTHEIT der Ungleichung verwischen,
// und gerade auf die kommt es hier an.
//
// ── Abgrenzung ───────────────────────────────────────────────────────────────
//
// std.prob rechnet beschreibende Masse und Verteilungen. Hier geht es um EINE
// Aussage ueber Paare — sie braucht kein Sortieren, keine Momente und keine
// Verteilungsannahme.

// ── Fehlerwerte ──────────────────────────────────────────────────────────────
//
// Die Funktionen geben NaN zurueck, wenn die Eingabe unbrauchbar ist, und
// melden den Grund auf der Standardfehlerausgabe. Ein stiller Ersatzwert (0
// oder 1) waere hier besonders unangenehm: 0 sieht wie "nie nahe beieinander"
// aus, 1 wie "immer" — beides plausibel, beides falsch.
//
// KEINE `con` fuer diesen Wert: eine Rechnung im Initialisierer einer f64-`con`
// wird still falsch uebersetzt — `0.0 / 0.0` kommt als 0.0 an, `0.0 - 0.5` als
// -8.0, `2.0 * 3.0` als 0.0 (gemessen mit 1.1.13A, siehe Issue). Reine
// Literale stimmen. Der Wert wird deshalb GERECHNET, mit Variablen als
// Operanden — so, wie es nachweislich funktioniert.
pub fn T123Fehlerwert(): f64 {
  var null1: f64 := 0.0;
  var null2: f64 := 0.0;
  return null1 / null2;                   // NaN
}

// Ist x NaN? (NaN ist der einzige Wert, der sich selbst ungleich ist.)
pub fn T123IstFehler(x: f64): bool {
  if (x != x) { return true; }
  return false;
}

// ── P(|X - Y| <= t) fuer eine STICHPROBE ─────────────────────────────────────
//
// data zeigt auf n aneinandergereihte f64. Jeder Wert traegt 1/n.
// Gezaehlt werden alle n*n geordneten Paare, EINSCHLIESSLICH i == j.
//
// Das i == j mitzunehmen ist keine Nachlaessigkeit, sondern die Definition:
// X und Y sind unabhaengig, sie duerfen denselben Wert treffen. Wer die
// Diagonale weglaesst, rechnet "zwei verschiedene Zuege OHNE Zuruecklegen" —
// eine andere Groesse, und fuer kleine n eine deutlich andere.
pub fn T123NahePaarStichprobe(data: int64, n: int64, t: f64): f64 {
  if (n <= 0) {
    EPrintStrLn("std.theorem123: leere Stichprobe (n <= 0)"c);
    return T123Fehlerwert();
  }
  if (t < 0.0) {
    EPrintStrLn("std.theorem123: negativer Abstand t — |X-Y| ist nie negativ"c);
    return T123Fehlerwert();
  }
  var treffer: int64 := 0;
  var i: int64 := 0;
  while (i < n) {
    var xi: f64 := peekf64(data + i * 8);
    var j: int64 := 0;
    while (j < n) {
      var d: f64 := AbsF64(xi - peekf64(data + j * 8));
      if (d <= t) { treffer := treffer + 1; }
      j := j + 1;
    }
    i := i + 1;
  }
  return (treffer as f64) / ((n as f64) * (n as f64));
}

// ── P(|X - Y| <= t) fuer eine GEWICHTETE Verteilung ──────────────────────────
//
// werte und gewichte zeigen je auf n f64. Die Gewichte muessen nicht exakt 1
// ergeben — geprueft wird auf eine Abweichung von hoechstens 1e-9, damit eine
// Summe aus Gleitkommaadditionen nicht an der letzten Stelle scheitert. Was
// darueber liegt, ist ein Eingabefehler und wird gemeldet.
pub fn T123NahePaar(werte: int64, gewichte: int64, n: int64, t: f64): f64 {
  if (n <= 0) {
    EPrintStrLn("std.theorem123: leere Verteilung (n <= 0)"c);
    return T123Fehlerwert();
  }
  if (t < 0.0) {
    EPrintStrLn("std.theorem123: negativer Abstand t — |X-Y| ist nie negativ"c);
    return T123Fehlerwert();
  }
  var summe: f64 := 0.0;
  var k: int64 := 0;
  while (k < n) {
    var g: f64 := peekf64(gewichte + k * 8);
    if (g < 0.0) {
      EPrintStrLn("std.theorem123: negatives Gewicht — das ist keine Verteilung"c);
      return T123Fehlerwert();
    }
    summe := summe + g;
    k := k + 1;
  }
  if (AbsF64(summe - 1.0) > 0.000000001) {
    EPrintStrLn("std.theorem123: Gewichte summieren sich nicht auf 1"c);
    return T123Fehlerwert();
  }

  var p: f64 := 0.0;
  var i: int64 := 0;
  while (i < n) {
    var xi: f64 := peekf64(werte + i * 8);
    var wi: f64 := peekf64(gewichte + i * 8);
    var j: int64 := 0;
    while (j < n) {
      var d: f64 := AbsF64(xi - peekf64(werte + j * 8));
      if (d <= t) { p := p + wi * peekf64(gewichte + j * 8); }
      j := j + 1;
    }
    i := i + 1;
  }
  return p;
}

// ── Die Schranke selbst ──────────────────────────────────────────────────────
//
// T123Schranke(a, b) = 2 * ceil(b/a) - 1.
//
// Fuer a = 1, b = 2 ergibt das 3 — das namensgebende "1 2 3".
//
// Die Aufrundung ist der springende Punkt: die Schranke haengt nur davon ab,
// WIE OFT a in b passt, nicht vom genauen Verhaeltnis. Fuer b/a knapp ueber
// einer ganzen Zahl springt sie um 2 nach oben, und das ist kein Rundungsfehler,
// sondern die Aussage.
pub fn T123Schranke(a: f64, b: f64): f64 {
  if (a <= 0.0) {
    EPrintStrLn("std.theorem123: a muss groesser als 0 sein"c);
    return T123Fehlerwert();
  }
  if (b < a) {
    EPrintStrLn("std.theorem123: b muss mindestens a sein"c);
    return T123Fehlerwert();
  }
  return 2.0 * CeilF64(b / a) - 1.0;
}

// ── Verhaeltnis P(<=b) / P(<=a) ──────────────────────────────────────────────
//
// Das ist die Zahl, die das Theorem nach oben begrenzt. Sie auszugeben ist
// nuetzlicher als ein blosses "gilt": man sieht, WIE nah eine Verteilung an
// die Schranke kommt.
//
// Der Nenner kann nicht 0 werden, solange die Eingabe eine Verteilung ist:
// P(|X-Y| <= a) >= P(X = Y) = Summe der Gewichtsquadrate > 0. Geprueft wird
// er trotzdem — eine kaputte Eingabe soll melden, nicht durch 0 teilen.
pub fn T123VerhaeltnisGewichtet(werte: int64, gewichte: int64, n: int64,
                                a: f64, b: f64): f64 {
  var pa: f64 := T123NahePaar(werte, gewichte, n, a);
  if (T123IstFehler(pa)) { return T123Fehlerwert(); }
  if (pa <= 0.0) {
    EPrintStrLn("std.theorem123: P(|X-Y| <= a) ist 0 — keine gueltige Verteilung"c);
    return T123Fehlerwert();
  }
  var pb: f64 := T123NahePaar(werte, gewichte, n, b);
  if (T123IstFehler(pb)) { return T123Fehlerwert(); }
  return pb / pa;
}

pub fn T123VerhaeltnisStichprobe(data: int64, n: int64, a: f64, b: f64): f64 {
  var pa: f64 := T123NahePaarStichprobe(data, n, a);
  if (T123IstFehler(pa)) { return T123Fehlerwert(); }
  if (pa <= 0.0) {
    EPrintStrLn("std.theorem123: P(|X-Y| <= a) ist 0 — Stichprobe leer?"c);
    return T123Fehlerwert();
  }
  var pb: f64 := T123NahePaarStichprobe(data, n, b);
  if (T123IstFehler(pb)) { return T123Fehlerwert(); }
  return pb / pa;
}

// ── Die Pruefung ─────────────────────────────────────────────────────────────
//
// Gibt true zurueck, wenn die Ungleichung fuer die uebergebene Verteilung
// haelt. Das ist KEIN Beweis und auch keine Suche nach einem Gegenbeispiel —
// das Theorem ist bewiesen. Der Nutzen liegt woanders: eine Verteilung, die
// hier durchfaellt, ist keine (Gewichte falsch, Werte vertauscht, Puffer zu
// kurz). Deshalb meldet die Funktion den Fall auch, statt nur false zu
// liefern.
pub fn T123GiltAllgemein(werte: int64, gewichte: int64, n: int64,
                         a: f64, b: f64): bool {
  var s: f64 := T123Schranke(a, b);
  if (T123IstFehler(s)) { return false; }
  var v: f64 := T123VerhaeltnisGewichtet(werte, gewichte, n, a, b);
  if (T123IstFehler(v)) { return false; }
  if (v < s) { return true; }
  EPrintStr("std.theorem123: Ungleichung verletzt — Verhaeltnis "c);
  EPrintFloat(v);
  EPrintStr(" nicht kleiner als Schranke "c);
  EPrintFloat(s);
  EPrintStrLn(". Das Theorem gilt fuer i.i.d. Variablen; pruefe die Eingabe."c);
  return false;
}

// Der namensgebende Fall: a = 1, b = 2, Schranke 3.
pub fn T123Gilt(werte: int64, gewichte: int64, n: int64): bool {
  return T123GiltAllgemein(werte, gewichte, n, 1.0, 2.0);
}

pub fn T123GiltStichprobe(data: int64, n: int64): bool {
  var v: f64 := T123VerhaeltnisStichprobe(data, n, 1.0, 2.0);
  if (T123IstFehler(v)) { return false; }
  if (v < 3.0) { return true; }
  EPrintStr("std.theorem123: Ungleichung verletzt — Verhaeltnis "c);
  EPrintFloat(v);
  EPrintStrLn(" nicht kleiner als 3."c);
  return false;
}
