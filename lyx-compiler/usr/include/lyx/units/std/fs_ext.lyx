// std/fs_ext — WP-1: Erweitertes Datei-I/O
// Wrapper um sys_fstat, sys_pread64, sys_pwrite64, sys_readv, sys_writev,
// sys_access, sys_fsync, sys_fdatasync, sys_truncate, sys_ftruncate,
// sys_getcwd, sys_chdir, sys_sendfile

import std.alloc;

// ============================================================
// stat-Buffer-Offsets (struct stat, x86-64 Linux)
// ============================================================
pub con STAT_SIZE:    int64 := 144;
pub con STAT_DEV:     int64 := 0;   // dev_t      (8 Bytes)
pub con STAT_INO:     int64 := 8;   // ino_t      (8 Bytes)
pub con STAT_NLINK:   int64 := 16;  // nlink_t    (8 Bytes)
pub con STAT_MODE:    int64 := 24;  // mode_t     (4 Bytes)
pub con STAT_UID:     int64 := 28;  // uid_t      (4 Bytes)
pub con STAT_GID:     int64 := 32;  // gid_t      (4 Bytes)
pub con STAT_SIZE_F:  int64 := 48;  // off_t      (8 Bytes) — Dateigröße
pub con STAT_BLKSIZE: int64 := 56;  // blksize_t  (8 Bytes)
pub con STAT_BLOCKS:  int64 := 64;  // blkcnt_t   (8 Bytes)
pub con STAT_ATIME:   int64 := 72;  // timespec   (16 Bytes)
pub con STAT_MTIME:   int64 := 88;  // timespec   (16 Bytes)
pub con STAT_CTIME:   int64 := 104; // timespec   (16 Bytes)

// Zugriffsmodus-Flags für FileAccess()
pub con F_OK: int64 := 0;  // Datei existiert
pub con R_OK: int64 := 4;  // lesbar
pub con W_OK: int64 := 2;  // schreibbar
pub con X_OK: int64 := 1;  // ausführbar

// iovec-Struktur: {base: int64, len: int64} = 16 Bytes
pub con IOVEC_SIZE: int64 := 16;

// PATH_MAX
pub con PATH_MAX: int64 := 4096;

// ============================================================
// Fstat — Dateiinfo über offenen fd
// ============================================================

// Fstat(fd, statBuf): int64
// statBuf = alloc(STAT_SIZE); danach: StatFileSize(statBuf), StatMtime(statBuf) etc.
pub fn Fstat(fd: int64, statBuf: int64): int64 {
  return sys_fstat(fd, statBuf);
}

// Hilfsfunktionen für stat-Buffer
pub fn StatFileSize(statBuf: int64): int64 {
  return peek64(statBuf + STAT_SIZE_F);
}

pub fn StatMtime(statBuf: int64): int64 {
  return peek64(statBuf + STAT_MTIME);
}

pub fn StatMode(statBuf: int64): int64 {
  return peek64(statBuf + STAT_MODE) & 0xFFFF;
}

pub fn StatIsDir(statBuf: int64): bool {
  return (peek64(statBuf + STAT_MODE) & 0xF000) == 0x4000;
}

pub fn StatIsFile(statBuf: int64): bool {
  return (peek64(statBuf + STAT_MODE) & 0xF000) == 0x8000;
}

// ============================================================
// Positioniertes Lesen / Schreiben (keine lseek nötig)
// ============================================================

pub fn PRead(fd: int64, buf: int64, n: int64, off: int64): int64 {
  return sys_pread64(fd, buf, n, off);
}

pub fn PWrite(fd: int64, buf: int64, n: int64, off: int64): int64 {
  return sys_pwrite64(fd, buf, n, off);
}

// ============================================================
// Scatter-Gather I/O (iovec)
// ============================================================

// iovec-Buffer-Helfer: setzt buf[idx] = {base, len}
pub fn IovecSet(buf: int64, idx: int64, base: int64, len: int64) {
  var off: int64 := buf + idx * IOVEC_SIZE;
  poke64(off,     base);
  poke64(off + 8, len);
}

pub fn IovecBase(buf: int64, idx: int64): int64 {
  return peek64(buf + idx * IOVEC_SIZE);
}

pub fn IovecLen(buf: int64, idx: int64): int64 {
  return peek64(buf + idx * IOVEC_SIZE + 8);
}

pub fn ReadV(fd: int64, iov: int64, iovcnt: int64): int64 {
  return sys_readv(fd, iov, iovcnt);
}

pub fn WriteV(fd: int64, iov: int64, iovcnt: int64): int64 {
  return sys_writev(fd, iov, iovcnt);
}

// ============================================================
// Zugriffsprüfung
// ============================================================

pub fn FileAccess(path: pchar, mode: int64): bool {
  return sys_access(path, mode) == 0;
}

pub fn FileExists(path: pchar): bool {
  return sys_access(path, F_OK) == 0;
}

pub fn FileReadable(path: pchar): bool {
  return sys_access(path, R_OK) == 0;
}

pub fn FileWritable(path: pchar): bool {
  return sys_access(path, W_OK) == 0;
}

// ============================================================
// Synchronisierung
// ============================================================

pub fn Fsync(fd: int64): int64 {
  return sys_fsync(fd);
}

pub fn Fdatasync(fd: int64): int64 {
  return sys_fdatasync(fd);
}

// ============================================================
// Dateigröße setzen
// ============================================================

pub fn Truncate(path: pchar, length: int64): int64 {
  return sys_truncate(path, length);
}

pub fn Ftruncate(fd: int64, length: int64): int64 {
  return sys_ftruncate(fd, length);
}

// ============================================================
// Arbeitsverzeichnis
// ============================================================

// GetCwd: schreibt aktuelles Verzeichnis in buf (alloc(PATH_MAX))
// Gibt Länge zurück oder < 0 bei Fehler
pub fn GetCwd(buf: int64, size: int64): int64 {
  return sys_getcwd(buf, size);
}

pub fn Chdir(path: pchar): int64 {
  return sys_chdir(path);
}

// ============================================================
// Sendfile — Kernel-seitige Dateiübertragung
// ============================================================

// Sendfile(outFd, inFd, offsetPtr, count): int64
// offsetPtr: Zeiger auf int64 (Leseposition); 0 = ab aktuellem fd-Offset
pub fn Sendfile(outFd: int64, inFd: int64, offsetPtr: int64, count: int64): int64 {
  return sys_sendfile(outFd, inFd, offsetPtr, count);
}

// ============================================================
// Convenience: Dateigröße ohne offenen fd ermitteln
// ============================================================

pub fn FileSize(path: pchar): int64 {
  var buf: int64 := alloc(STAT_SIZE);
  if (buf == 0) { return -1; }
  var fd: int64 := open(path, 0, 0);
  if (fd < 0) {
    free(buf, STAT_SIZE);
    return -1;
  }
  var r: int64 := sys_fstat(fd, buf);
  close(fd);
  var sz: int64;
  if (r == 0) {
    sz := StatFileSize(buf);
  } else {
    sz := -1;
  }
  free(buf, STAT_SIZE);
  return sz;
}
