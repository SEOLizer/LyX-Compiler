// std/meta_safe.lyx — WP-3.2: Secure Post-Patching runtime verifier
//
// Reads the .meta_safe section from /proc/self/exe, re-computes CRC32
// for each code page, and reports whether the binary is intact.
@capabilities([fs.meta, fs.read])

unit std.meta_safe;

import std.alloc;
// ============================================================================
// CRC32 (mirrors the compiler's ms_crc32 implementation)
// ============================================================================

fn _ms_crc32(data: int64, len: int64): int64 {
  var crc: int64 := 0xFFFFFFFF;
  var i: int64 := 0;
  while (i < len) {
    crc := crc ^ (peek8(data + i) & 0xFF);
    var b: int64 := 0;
    while (b < 8) {
      if ((crc & 1) != 0) {
        crc := ((crc >> 1) & 0x7FFFFFFF) ^ (0 - 306674912);
      } else {
        crc := (crc >> 1) & 0x7FFFFFFF;
      }
      b += 1;
    }
    i += 1;
  }
  return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF;
}

// ============================================================================
// ELF section finder: locate .meta_safe in /proc/self/exe
// Returns: pointer to the .meta_safe payload, or 0 if not found.
// Sets *outPayloadSize to the section size.
// ============================================================================

fn _ms_findSection(binBuf: int64, binSize: int64, outOff: int64, outSize: int64): int64 {
  // Validate ELF magic
  if (peek8(binBuf + 0) != 0x7F) { return 0; }
  if (peek8(binBuf + 1) != 69)   { return 0; }  // 'E'
  if (peek8(binBuf + 2) != 76)   { return 0; }  // 'L'
  if (peek8(binBuf + 3) != 70)   { return 0; }  // 'F'

  var shoff:    int64 := peek64(binBuf + 40);  // e_shoff
  var shnum:    int64 := peek16(binBuf + 60) as int64;  // e_shnum
  var shstrndx: int64 := peek16(binBuf + 62) as int64;  // e_shstrndx

  if (shoff == 0 || shnum == 0 || shstrndx == 0) { return 0; }

  // Get .shstrtab section
  var shstrHdr: int64 := binBuf + shoff + shstrndx * 64;
  var shstrOff: int64 := peek64(shstrHdr + 24);  // sh_offset
  var shstrBuf: int64 := binBuf + shstrOff;

  // Scan sections for ".meta_safe"
  var si: int64 := 0;
  while (si < shnum) {
    var shdr:    int64 := binBuf + shoff + si * 64;
    var nameOff: int64 := peek32(shdr) & 0xFFFFFFFF;  // sh_name
    var secOff:  int64 := peek64(shdr + 24);           // sh_offset
    var secSize: int64 := peek64(shdr + 32);           // sh_size

    // Compare name against ".meta_safe"
    var nptr: int64 := shstrBuf + nameOff;
    if (peek8(nptr + 0) == 46  &&   // '.'
        peek8(nptr + 1) == 109 &&   // 'm'
        peek8(nptr + 2) == 101 &&   // 'e'
        peek8(nptr + 3) == 116 &&   // 't'
        peek8(nptr + 4) == 97  &&   // 'a'
        peek8(nptr + 5) == 95  &&   // '_'
        peek8(nptr + 6) == 115 &&   // 's'
        peek8(nptr + 7) == 97  &&   // 'a'
        peek8(nptr + 8) == 102 &&   // 'f'
        peek8(nptr + 9) == 101) {   // 'e'
      poke64(outOff, secOff);
      poke64(outSize, secSize);
      return 1;
    }
    si += 1;
  }
  return 0;
}

// ============================================================================
// Public API
// ============================================================================

// MetaSafeVerify: reads /proc/self/exe, finds .meta_safe, re-checks CRC32s.
// Returns 0 if all pages match, -1 if any page is corrupted or section missing.
pub fn MetaSafeVerify(): int64 {
  var selfExe: pchar := "/proc/self/exe"c;
  var fd: int64 := open(selfExe, 0, 0);
  if (fd < 0) { return -1; }
  var binSize: int64 := lseek(fd, 0, 2);
  lseek(fd, 0, 0);
  var binBuf: int64 := alloc(binSize + 1);
  read(fd, binBuf as pchar, binSize);
  close(fd);

  // Scratch space for _ms_findSection output
  var secOffBuf:  int64 := alloc(16);
  var secSizeBuf: int64 := secOffBuf + 8;

  var found: int64 := _ms_findSection(binBuf, binSize, secOffBuf, secSizeBuf);
  if (found == 0) {
    free(binBuf, binSize + 1);
    free(secOffBuf, 16);
    return -1;
  }

  var secOff:  int64 := peek64(secOffBuf);
  var payload: int64 := binBuf + secOff;

  // Validate magic
  if (peek8(payload + 0) != 0x4D || peek8(payload + 1) != 0x45 ||
      peek8(payload + 2) != 0x54 || peek8(payload + 3) != 0x41) {
    free(binBuf, binSize + 1);
    free(secOffBuf, 16);
    return -1;
  }

  var pageCount: int64 := peek32(payload + 4) & 0xFFFFFFFF;
  var codeLen:   int64 := peek64(payload + 8);  // stored actual .text byte count
  var codeOff:   int64 := 176;  // static x86-64 ELF: .text starts at offset 176 (64-byte hdr + 2×56-byte phdr)
  var pageSize:  int64 := 4096;

  var result: int64 := 0;
  var pi: int64 := 0;
  while (pi < pageCount) {
    var entry:     int64 := payload + 16 + pi * 8;
    var pageOff:   int64 := peek32(entry) & 0xFFFFFFFF;
    var storedCrc: int64 := peek32(entry + 4) & 0xFFFFFFFF;

    var fileOff:   int64 := codeOff + pageOff;
    var remaining: int64 := codeLen - pageOff;
    var len:       int64 := pageSize;
    if (remaining < pageSize) { len := remaining; }
    if (len <= 0) { result := -1; break; }

    var computed: int64 := _ms_crc32(binBuf + fileOff, len);
    if (computed != storedCrc) { result := -1; break; }
    pi += 1;
  }

  free(binBuf, binSize + 1);
  free(secOffBuf, 16);
  return result;
}

// MetaSafeGetPageHash: returns the stored CRC32 for page `pageIdx`, or -1.
pub fn MetaSafeGetPageHash(pageIdx: int64): int64 {
  var selfExe: pchar := "/proc/self/exe"c;
  var fd: int64 := open(selfExe, 0, 0);
  if (fd < 0) { return -1; }
  var binSize: int64 := lseek(fd, 0, 2);
  lseek(fd, 0, 0);
  var binBuf: int64 := alloc(binSize + 1);
  read(fd, binBuf as pchar, binSize);
  close(fd);

  var secOffBuf:  int64 := alloc(16);
  var secSizeBuf: int64 := secOffBuf + 8;

  var found: int64 := _ms_findSection(binBuf, binSize, secOffBuf, secSizeBuf);
  if (found == 0) {
    free(binBuf, binSize + 1);
    free(secOffBuf, 16);
    return -1;
  }

  var payload:    int64 := binBuf + peek64(secOffBuf);
  var pageCount:  int64 := peek32(payload + 4) & 0xFFFFFFFF;

  var result: int64 := -1;
  if (pageIdx >= 0 && pageIdx < pageCount) {
    var entry: int64 := payload + 16 + pageIdx * 8;
    result := peek32(entry + 4) & 0xFFFFFFFF;
  }

  free(binBuf, binSize + 1);
  free(secOffBuf, 16);
  return result;
}
