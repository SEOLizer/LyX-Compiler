// std/pdf/outline.lyx
// PDF document outline (bookmarks) — WP-PDF-10

@description("PDF outlines: PdfOutlineAdd for nested bookmark trees")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, fs.write])
unit std.pdf.outline;

import std.alloc;
import std.pdf.builder;

fn _outlineStrDup(s: pchar): int64 {
  var len: int64 := StrLen(s) + 1;
  var buf: int64 := alloc(len);
  if (buf == 0) { return 0; }
  var i: int64 := 0;
  while (i < len) {
    poke8(buf + i, StrCharAt(s, i));
    i += 1;
  }
  return buf;
}

fn _outlineEnsure(doc: int64): int64 {
  var count: int64 := peek64(doc + PDF_DOC_OUTLINECOUNT);
  var cap:   int64 := peek64(doc + PDF_DOC_OUTLINECAP);
  var buf:   int64 := peek64(doc + PDF_DOC_OUTLINEBUF);
  if (count < cap) { return 1; }
  var newCap: int64 := cap * 2;
  var newBuf: int64 := alloc(newCap * PDF_OUTLINE_RECSIZE);
  if (newBuf == 0) { return 0; }
  var ci: int64 := 0;
  while (ci < count * PDF_OUTLINE_RECSIZE) {
    poke8(newBuf + ci, peek8(buf + ci));
    ci += 1;
  }
  while (ci < newCap * PDF_OUTLINE_RECSIZE) {
    poke8(newBuf + ci, 0);
    ci += 1;
  }
  free(buf, cap * PDF_OUTLINE_RECSIZE);
  poke64(doc + PDF_DOC_OUTLINEBUF, newBuf);
  poke64(doc + PDF_DOC_OUTLINECAP, newCap);
  return 1;
}

// Add a bookmark to the document outline.
// parentIdx = -1 for a root-level item, or the index returned by a prior PdfOutlineAdd.
// destPage  = the page index returned by PdfAddPage.
// Returns the outline index (pass as parentIdx for nested items), or -1 on error.
pub fn PdfOutlineAdd(doc: int64, parentIdx: int64, title: pchar, destPage: int64): int64 {
  if (doc == 0) { return -1; }
  if (_outlineEnsure(doc) == 0) { return -1; }
  var titLen: int64 := StrLen(title) + 1;
  var titBuf: int64 := _outlineStrDup(title);
  if (titBuf == 0) { return -1; }
  var count: int64 := peek64(doc + PDF_DOC_OUTLINECOUNT);
  var buf:   int64 := peek64(doc + PDF_DOC_OUTLINEBUF);
  var rec:   int64 := buf + count * PDF_OUTLINE_RECSIZE;
  poke64(rec + PDF_OUTLINE_PARENT,   parentIdx);
  poke64(rec + PDF_OUTLINE_DESTPAGE, destPage);
  poke64(rec + PDF_OUTLINE_TITLEBUF, titBuf);
  poke64(rec + PDF_OUTLINE_TITLELEN, titLen);
  poke64(doc + PDF_DOC_OUTLINECOUNT, count + 1);
  return count;
}
