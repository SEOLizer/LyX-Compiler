// ============================================================================
// PdfSave — serialize document to a PDF file
// Returns: 0 on success, negative on error
// ============================================================================

pub fn PdfSave(doc: int64, path: pchar): int64 {
  if (doc == 0) { return -1; }
  // WP-PDF-27: read conformance before encryption setup (PDF/A blocks encryption)
  var conformance: int64 := peek64(doc + PDF_DOC_CONFORMANCE);
  // Prepare encryption keys before reading nextId (WP-PDF-17)
  // Skipped in PDF/A mode (encryption incompatible with PDF/A)
  if (conformance == 0 && peek64(doc + PDF_DOC_ENCTYPE) != PDF_ENC_NONE) {
    _pdfPrepareEncryption(doc);
  }

  var pageCount:   int64 := peek64(doc + PDF_DOC_PAGECOUNT);
  var nextId:      int64 := peek64(doc + PDF_DOC_NEXTID);
  var pageIds:     int64 := peek64(doc + PDF_DOC_PAGEIDS);
  var contentIds:  int64 := peek64(doc + PDF_DOC_CONTENTIDS);
  var widths100:   int64 := peek64(doc + PDF_DOC_WIDTHS100);
  var heights100:  int64 := peek64(doc + PDF_DOC_HEIGHTS100);
  var contentBufs: int64 := peek64(doc + PDF_DOC_CONTENTBUFS);
  var contentLens: int64 := peek64(doc + PDF_DOC_CONTENTLENS);

  // Allocate output buffer (4 MB)
  var out: int64 := mmapAlloc(PDF_OUT_BUF_SIZE);
  if (out == 0) { return -2; }

  // Determine whether to write a /Info dict (metadata present?)
  var hasInfo: int64 := 0;
  if (peek8(doc + PDF_DOC_META_TITLE)    != 0 || peek8(doc + PDF_DOC_META_AUTHOR)   != 0 ||
      peek8(doc + PDF_DOC_META_SUBJECT)  != 0 || peek8(doc + PDF_DOC_META_KEYWORDS) != 0 ||
      peek8(doc + PDF_DOC_META_CREATOR)  != 0 || peek8(doc + PDF_DOC_META_PRODUCER) != 0) {
    hasInfo := 1;
  }
  var infoId: int64 := nextId;  // object ID for /Info dict (only when hasInfo != 0)

  var annotCount: int64 := peek64(doc + PDF_DOC_ANNOTCOUNT);
  var annotBuf:   int64 := peek64(doc + PDF_DOC_ANNOTBUF);
  var firstAnnotId: int64 := nextId + hasInfo;  // first annotation object ID

  var outlineCount:    int64 := peek64(doc + PDF_DOC_OUTLINECOUNT);
  var outlineBuf:      int64 := peek64(doc + PDF_DOC_OUTLINEBUF);
  var outlineObjCount: int64 := 0;
  if (outlineCount > 0) { outlineObjCount := outlineCount + 1; }
  var outlineRootId:   int64 := nextId + hasInfo + annotCount;

  var labelCount: int64 := peek64(doc + PDF_DOC_LABELCOUNT);
  var labelBuf:   int64 := peek64(doc + PDF_DOC_LABELBUF);

  var transCount: int64 := peek64(doc + PDF_DOC_TRANSCOUNT);
  var transBuf:   int64 := peek64(doc + PDF_DOC_TRANSBUF);

  var viewFlags:     int64 := peek64(doc + PDF_DOC_VIEWFLAGS);
  var openPage:      int64 := peek64(doc + PDF_DOC_VIEWOPENPAGE);

  var namedestCount: int64 := peek64(doc + PDF_DOC_NAMEDESTCOUNT);
  var namedestBuf:   int64 := peek64(doc + PDF_DOC_NAMEDESTBUF);

  var attachCount:    int64 := peek64(doc + PDF_DOC_ATTACHCOUNT);
  var attachBuf:      int64 := peek64(doc + PDF_DOC_ATTACHBUF);
  var attachObjCount: int64 := attachCount * 2;
  var attachBaseId:   int64 := nextId + hasInfo + annotCount + outlineObjCount;

  var layerCount:   int64 := peek64(doc + PDF_DOC_LAYERCOUNT);
  var layerBuf:     int64 := peek64(doc + PDF_DOC_LAYERBUF);
  var layerBaseId:  int64 := attachBaseId + attachObjCount;

  var shadCount:    int64 := peek64(doc + PDF_DOC_SHADCOUNT);
  var shadBuf:      int64 := peek64(doc + PDF_DOC_SHADBUF);
  var spotCount:    int64 := peek64(doc + PDF_DOC_SPOTCOUNT);
  var spotBuf:      int64 := peek64(doc + PDF_DOC_SPOTBUF);
  var formCount:    int64 := peek64(doc + PDF_DOC_FORMCOUNT);
  var formBuf:      int64 := peek64(doc + PDF_DOC_FORMBUF);
  var rgCount:      int64 := peek64(doc + PDF_DOC_RGCOUNT);
  var rgBuf:        int64 := peek64(doc + PDF_DOC_RGBUF);
  var formFlat:     int64 := peek64(doc + PDF_DOC_FORMFLAT);
  var acroObjId:    int64 := peek64(doc + PDF_DOC_ACROOBJID);
  var encType:      int64 := peek64(doc + PDF_DOC_ENCTYPE);
  var encReady:     int64 := peek64(doc + PDF_DOC_ENCREADY);
  var ttCount:      int64 := peek64(doc + PDF_DOC_TTCOUNT);
  var ttBuf:        int64 := peek64(doc + PDF_DOC_TTBUF);
  var xmpData:      int64 := peek64(doc + PDF_DOC_XMPDATAPTR);
  var xmpLen:       int64 := peek64(doc + PDF_DOC_XMPDATALEN);
  var xmpObjId:     int64 := peek64(doc + PDF_DOC_XMPOBJID);
  var iccProfId:    int64 := peek64(doc + PDF_DOC_ICCPROFID);    // WP-PDF-27
  var outIntentId:  int64 := peek64(doc + PDF_DOC_OUTINTENTID);  // WP-PDF-27

  // Allocate XRef offset table
  var encObjAlloc: int64 := 0;
  if (encType != PDF_ENC_NONE && encReady != 0) { encObjAlloc := 1; }
  var xrefSize: int64 := (nextId + hasInfo + annotCount + outlineObjCount + attachObjCount + layerCount + shadCount + spotCount + formCount + rgCount + encObjAlloc + ttCount * 5 + 8) * 8;
  var xrefs: int64 := mmapAlloc(xrefSize);
  if (xrefs == 0) {
    free(out, PDF_OUT_BUF_SIZE);
    return -3;
  }
  zeroMem(xrefs, xrefSize);

  var pos: int64 := 0;

  // --- PDF header ---
  pos := pdfStr(out, pos, "%PDF-1.4\n");
  poke8(out + pos, 37);   pos := pos + 1;
  poke8(out + pos, 0xE2); pos := pos + 1;
  poke8(out + pos, 0xE3); pos := pos + 1;
  poke8(out + pos, 0xCF); pos := pos + 1;
  poke8(out + pos, 0xD3); pos := pos + 1;
  poke8(out + pos, 10);   pos := pos + 1;

  // --- Object 1: Catalog ---
  poke64(xrefs + 1 * 8, pos);
  pos := pdfStr(out, pos, "1 0 obj\n<< /Type /Catalog /Pages 2 0 R");
  if (outlineCount > 0) {
    pos := pdfStr(out, pos, " /Outlines ");
    pos := pdfRef(out, pos, outlineRootId);
  }
  if (labelCount > 0) {
    pos := _pdfWritePageLabels(out, pos, labelBuf, labelCount);
  }
  if ((viewFlags & PDF_VIEW_FULLSCREEN) != 0) {
    pos := pdfStr(out, pos, " /PageMode /FullScreen");
  } else if ((viewFlags & PDF_VIEW_USE_OUTLINES) != 0) {
    pos := pdfStr(out, pos, " /PageMode /UseOutlines");
  }
  if ((viewFlags & PDF_VIEW_SINGLE_PAGE) != 0) {
    pos := pdfStr(out, pos, " /PageLayout /SinglePage");
  } else if ((viewFlags & PDF_VIEW_TWO_COLUMN_LEFT) != 0) {
    pos := pdfStr(out, pos, " /PageLayout /TwoColumnLeft");
  }
  if ((viewFlags & PDF_VIEW_OPEN_ACTION) != 0) {
    pos := pdfStr(out, pos, " /OpenAction [");
    pos := pdfRef(out, pos, arrGet(pageIds, openPage));
    pos := pdfStr(out, pos, " /XYZ null null null]");
  }
  var vpMask: int64 := viewFlags & 63;
  if (vpMask != 0) {
    pos := pdfStr(out, pos, " /ViewerPreferences <<");
    if ((vpMask & PDF_VIEW_HIDE_TOOLBAR) != 0)     { pos := pdfStr(out, pos, " /HideToolbar true"); }
