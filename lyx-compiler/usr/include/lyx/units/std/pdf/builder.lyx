    var fontDataLen: int64 := ttSize;
    var fontData:    int64 := ttData;
    if (subLen > 0) { fontDataLen := subLen; fontData := subBuf; }
    pos := pdfStr(out, pos, "<< /Length ");
    pos := pdfInt(out, pos, fontDataLen);
    pos := pdfStr(out, pos, " /Length1 ");
    pos := pdfInt(out, pos, fontDataLen);
    pos := pdfStr(out, pos, " >>\nstream\n");
    pos := pdfBytes(out, pos, fontData, fontDataLen);
    pos := pdfStr(out, pos, "\nendstream");
    pos := pdfObjFtr(out, pos);

    // FontDescriptor
    poke64(xrefs + ttDescId * 8, pos);
    pos := pdfObjHdr(out, pos, ttDescId);
    pos := pdfStr(out, pos, "<< /Type /FontDescriptor /FontName /DejaVuSans /Flags 32 /FontBBox [");
    pos := pdfInt(out, pos, ttXMin); poke8(out+pos,32); pos:=pos+1;
    pos := pdfInt(out, pos, ttYMin); poke8(out+pos,32); pos:=pos+1;
    pos := pdfInt(out, pos, ttXMax); poke8(out+pos,32); pos:=pos+1;
    pos := pdfInt(out, pos, ttYMax);
    pos := pdfStr(out, pos, "] /ItalicAngle 0 /Ascent 800 /Descent -200 /CapHeight 700 /StemV 80 /FontFile2 ");
    pos := pdfRef(out, pos, ttFid);
    pos := pdfStr(out, pos, " >>");
    pos := pdfObjFtr(out, pos);

    // ToUnicode CMap stream
    poke64(xrefs + ttTuId * 8, pos);
    pos := pdfObjHdr(out, pos, ttTuId);
    // Build ToUnicode CMap content
    var cmap1: pchar := "/CIDInit /ProcSet findresource begin 12 dict begin begincmap /CIDSystemInfo << /Registry (Adobe) /Ordering (UCS) /Supplement 0 >> def /CMapName /Adobe-Identity-UCS def /CMapType 2 def 1 begincodespacerange <0000> <FFFF> endcodespacerange "c;
    var cmap2: pchar := "beginbfchar\n"c;
    var cmap3: pchar := "endbfchar\nendcmap CMap currentdict end end\n"c;
    // Count mappings (glyph→unicode for used glyphs)
    var mapCount: int64 := 0;
    if (ttGused != 0) {
      var gii: int64 := 1;  // skip glyph 0 (notdef)
      while (gii < ttNG && gii < 65536) {
        if ((peek8(ttGused + (gii >> 3)) >> (gii & 7)) & 1 != 0) { mapCount := mapCount + 1; }
        gii += 1;
      }
    }
    var cmapLen: int64 := StrLen(cmap1) + StrLen(cmap2) + mapCount * 24 + StrLen(cmap3);
    pos := pdfStr(out, pos, "<< /Length ");
    pos := pdfInt(out, pos, cmapLen);
    pos := pdfStr(out, pos, " >>\nstream\n");
    pos := pdfStr(out, pos, cmap1);
    pos := pdfStr(out, pos, cmap2);
    // Write glyph→unicode mappings: <glyphId> <unicodeCodepoint>
    // We store unicode→glyph in cmap; for ToUnicode we need glyph→unicode.
    // Walk used glyphs and emit their Unicode mappings using the cmap4 reverse lookup.
    if (ttGused != 0) {
      var ttu_gi: int64 := 1;
      while (ttu_gi < ttNG && ttu_gi < 65536) {
        if ((peek8(ttGused + (ttu_gi >> 3)) >> (ttu_gi & 7)) & 1 != 0) {
          // Inline reverse cmap4 lookup: glyph ID → Unicode codepoint
          var ttc4d: int64 := peek64(ttrec + PDF_TT_DATA);
          var ttc4o: int64 := peek64(ttrec + PDF_TT_CMAP4_OFF);
          var uc: int64 := ttu_gi;  // fallback: identity
          if (ttc4d != 0 && ttc4o != 0) {
            var c4: int64 := ttc4d + ttc4o;
            var nSeg: int64 := (((peek8(c4+6)<<8)|peek8(c4+7)) & 0xFFFF) >> 1;
            var ea: int64 := c4 + 14;
            var sa: int64 := ea + nSeg*2 + 2;
            var da: int64 := sa + nSeg*2;
            var ra: int64 := da + nSeg*2;
            var si2: int64 := 0;
            while (si2 < nSeg) {
              var eEnd:   int64 := ((peek8(ea+si2*2)<<8)|peek8(ea+si2*2+1)) & 0xFFFF;
              var eStart: int64 := ((peek8(sa+si2*2)<<8)|peek8(sa+si2*2+1)) & 0xFFFF;
              var eDelta: int64 := ((peek8(da+si2*2)<<8)|peek8(da+si2*2+1)) & 0xFFFF;
              if (eDelta >= 32768) { eDelta := eDelta - 65536; }
              var eRoff:  int64 := ((peek8(ra+si2*2)<<8)|peek8(ra+si2*2+1)) & 0xFFFF;
              if (eRoff == 0) {
                var cp2: int64 := (ttu_gi - eDelta) & 0xFFFF;
                if (cp2 >= eStart && cp2 <= eEnd) { uc := cp2; si2 := nSeg; }
              } else {
                var cpS: int64 := eStart;
                while (cpS <= eEnd) {
                  var idx2: int64 := ra + si2*2 + eRoff + (cpS - eStart)*2;
                  var arrG: int64 := ((peek8(idx2)<<8)|peek8(idx2+1)) & 0xFFFF;
                  if (arrG != 0) {
                    arrG := (arrG + eDelta) & 0xFFFF;
                    if (arrG == ttu_gi) { uc := cpS; cpS := eEnd + 1; si2 := nSeg; }
                  }
                  cpS += 1;
                }
              }
              si2 += 1;
            }
          }
          if (uc > 0) {
            poke8(out+pos, 60); pos:=pos+1;  // <
            var g4: int64 := (ttu_gi >> 12)&0xF; if(g4<10){poke8(out+pos,48+g4);}else{poke8(out+pos,55+g4);} pos:=pos+1;
            g4:=(ttu_gi>>8)&0xF; if(g4<10){poke8(out+pos,48+g4);}else{poke8(out+pos,55+g4);} pos:=pos+1;
            g4:=(ttu_gi>>4)&0xF; if(g4<10){poke8(out+pos,48+g4);}else{poke8(out+pos,55+g4);} pos:=pos+1;
            g4:=ttu_gi&0xF;     if(g4<10){poke8(out+pos,48+g4);}else{poke8(out+pos,55+g4);} pos:=pos+1;
            pos := pdfStr(out, pos, "> <");
            var u4: int64 := (uc >> 12)&0xF; if(u4<10){poke8(out+pos,48+u4);}else{poke8(out+pos,55+u4);} pos:=pos+1;
            u4:=(uc>>8)&0xF; if(u4<10){poke8(out+pos,48+u4);}else{poke8(out+pos,55+u4);} pos:=pos+1;
            u4:=(uc>>4)&0xF; if(u4<10){poke8(out+pos,48+u4);}else{poke8(out+pos,55+u4);} pos:=pos+1;
            u4:=uc&0xF;      if(u4<10){poke8(out+pos,48+u4);}else{poke8(out+pos,55+u4);} pos:=pos+1;
            poke8(out+pos, 62); pos:=pos+1;  // >
            poke8(out+pos, 10); pos:=pos+1;  // \n
          }
        }
        ttu_gi += 1;
      }
    }
    pos := pdfStr(out, pos, cmap3);
    pos := pdfStr(out, pos, "\nendstream");
    pos := pdfObjFtr(out, pos);

    // CIDFont (CIDFontType2)
    poke64(xrefs + ttCidId * 8, pos);
    pos := pdfObjHdr(out, pos, ttCidId);
    pos := pdfStr(out, pos, "<< /Type /Font /Subtype /CIDFontType2 /BaseFont /DejaVuSans /CIDSystemInfo << /Registry (Adobe) /Ordering (Identity) /Supplement 0 >> /FontDescriptor ");
    pos := pdfRef(out, pos, ttDescId);
    pos := pdfStr(out, pos, " /DW 1000 /CIDToGIDMap /Identity >>");
    pos := pdfObjFtr(out, pos);

    // Type0 font
    poke64(xrefs + ttT0Id * 8, pos);
    pos := pdfObjHdr(out, pos, ttT0Id);
    pos := pdfStr(out, pos, "<< /Type /Font /Subtype /Type0 /BaseFont /DejaVuSans /Encoding /Identity-H /DescendantFonts [");
    pos := pdfRef(out, pos, ttCidId);
    pos := pdfStr(out, pos, "] /ToUnicode ");
    pos := pdfRef(out, pos, ttTuId);
    pos := pdfStr(out, pos, " >>");
    pos := pdfObjFtr(out, pos);

    tti += 1;
  }

  var xrefStart: int64 := pos;
  var xrefCount: int64 := nextId + hasInfo + annotCount + outlineObjCount + attachObjCount + layerCount;

  pos := pdfStr(out, pos, "xref\n0 ");
  pos := pdfInt(out, pos, xrefCount);
  poke8(out + pos, 10); pos := pos + 1;

  // Free entry for object 0
  pos := pdfXrefEntry(out, pos, 0, 65535, true);

  // In-use entries for objects 1..xrefCount-1
  var id: int64 := 1;
  while (id < xrefCount) {
    var off: int64 := peek64(xrefs + id * 8);
    pos := pdfXrefEntry(out, pos, off, 0, false);
    id += 1;
  }

  // --- Trailer ---
  pos := pdfStr(out, pos, "trailer\n<< /Size ");
  pos := pdfInt(out, pos, xrefCount);
  pos := pdfStr(out, pos, " /Root 1 0 R");
  if (hasInfo != 0) {
    pos := pdfStr(out, pos, " /Info ");
    pos := pdfRef(out, pos, infoId);
  }
  // /Encrypt reference (WP-PDF-17)
  if (encType != PDF_ENC_NONE && encReady != 0) {
    var encObjId: int64 := peek64(doc + PDF_DOC_ENCCURID);
    pos := pdfStr(out, pos, " /Encrypt ");
    pos := pdfRef(out, pos, encObjId);
    // /ID [<fileId> <fileId>] — use first 16 bytes of /U value as file ID
    var uid: int64 := peek64(doc + PDF_DOC_ENCUKEY);
    if (uid != 0) {
      pos := pdfStr(out, pos, " /ID [<");
      var ii: int64 := 0;
      while (ii < 16) {
        var hb: int64 := peek8(uid + ii);
        var hn: int64 := (hb >> 4) & 0xF;
        var ln: int64 := hb & 0xF;
        if (hn < 10) { poke8(out+pos, 48+hn); } else { poke8(out+pos, 55+hn); } pos:=pos+1;
        if (ln < 10) { poke8(out+pos, 48+ln); } else { poke8(out+pos, 55+ln); } pos:=pos+1;
        ii += 1;
      }
      pos := pdfStr(out, pos, "><");
      ii := 0;
      while (ii < 16) {
        var hb2: int64 := peek8(uid + ii);
        var hn2: int64 := (hb2 >> 4) & 0xF;
        var ln2: int64 := hb2 & 0xF;
        if (hn2 < 10) { poke8(out+pos, 48+hn2); } else { poke8(out+pos, 55+hn2); } pos:=pos+1;
        if (ln2 < 10) { poke8(out+pos, 48+ln2); } else { poke8(out+pos, 55+ln2); } pos:=pos+1;
        ii += 1;
      }
      pos := pdfStr(out, pos, ">]");
    }
  }
  pos := pdfStr(out, pos, " >>\nstartxref\n");
  pos := pdfInt(out, pos, xrefStart);
  pos := pdfStr(out, pos, "\n%%EOF\n");

  // --- Write to file ---
  var fd: int64 := open(path, 577, 420);
  if (fd < 0) {
    free(xrefs, xrefSize);
    free(out, PDF_OUT_BUF_SIZE);
    return -4;
  }

  var written: int64 := write(fd, out, pos);
  close(fd);

  free(xrefs, xrefSize);
  free(out, PDF_OUT_BUF_SIZE);

  if (written != pos) { return -5; }
  return 0;
}
