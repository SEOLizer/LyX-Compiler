// ============================================================================
// WP-PDF-23: Page/XObject routing helpers
// When pg >= 0: page arrays; when pg < 0: Form XObject record (handle=-(idx+1))
// These are pub so graphics.lyx can use them.
// ============================================================================

fn _xobjRec(doc: int64, handle: int64): int64 {
  var idx: int64 := 0 - handle - 1;
  return peek64(doc + PDF_DOC_XOBJBUF) + idx * PDF_XOBJ_RECSIZE;
}

pub fn pdfXBuf(doc: int64, pg: int64): int64 {
  if (pg < 0) { return peek64(_xobjRec(doc, pg) + PDF_XOBJ_CONTENTBUF); }
  return arrGet(peek64(doc + PDF_DOC_CONTENTBUFS), pg);
}

pub fn pdfXPos(doc: int64, pg: int64): int64 {
  if (pg < 0) { return peek64(_xobjRec(doc, pg) + PDF_XOBJ_CONTENTLEN); }
  return arrGet(peek64(doc + PDF_DOC_CONTENTLENS), pg);
}

pub fn pdfXSetPos(doc: int64, pg: int64, p: int64): void {
  if (pg < 0) { poke64(_xobjRec(doc, pg) + PDF_XOBJ_CONTENTLEN, p); return; }
  arrSet(peek64(doc + PDF_DOC_CONTENTLENS), pg, p);
}

pub fn pdfXFontIdx(doc: int64, pg: int64): int64 {
  if (pg < 0) { return peek64(_xobjRec(doc, pg) + PDF_XOBJ_CURFONTIDX); }
  return peek64(doc + PDF_DOC_CURFONTIDX + pg * 8);
}

pub fn pdfXSetFontIdx(doc: int64, pg: int64, idx: int64): void {
  if (pg < 0) { poke64(_xobjRec(doc, pg) + PDF_XOBJ_CURFONTIDX, idx); return; }
  poke64(doc + PDF_DOC_CURFONTIDX + pg * 8, idx);
}

pub fn pdfXFontSize100(doc: int64, pg: int64): int64 {
  if (pg < 0) { return peek64(_xobjRec(doc, pg) + PDF_XOBJ_CURFONTSIZE100); }
  return peek64(doc + PDF_DOC_CURFONTSIZE100 + pg * 8);
}

pub fn pdfXSetFontSize100(doc: int64, pg: int64, sz: int64): void {
  if (pg < 0) { poke64(_xobjRec(doc, pg) + PDF_XOBJ_CURFONTSIZE100, sz); return; }
  poke64(doc + PDF_DOC_CURFONTSIZE100 + pg * 8, sz);
}

pub fn pdfXTextColor(doc: int64, pg: int64): int64 {
  if (pg < 0) { return peek64(_xobjRec(doc, pg) + PDF_XOBJ_CURTEXTCOLOR); }
  return peek64(doc + PDF_DOC_CURTEXTCOLOR + pg * 8);
}

pub fn pdfXSetTextColor(doc: int64, pg: int64, color: int64): void {
  if (pg < 0) { poke64(_xobjRec(doc, pg) + PDF_XOBJ_CURTEXTCOLOR, color); return; }
  poke64(doc + PDF_DOC_CURTEXTCOLOR + pg * 8, color);
}

pub fn pdfXFontMask(doc: int64, pg: int64): int64 {
  if (pg < 0) { return peek64(_xobjRec(doc, pg) + PDF_XOBJ_FONTMASK); }
  return peek64(doc + PDF_DOC_PAGEFONTMASK + pg * 8);
}

pub fn pdfXSetFontMask(doc: int64, pg: int64, mask: int64): void {
  if (pg < 0) { poke64(_xobjRec(doc, pg) + PDF_XOBJ_FONTMASK, mask); return; }
  poke64(doc + PDF_DOC_PAGEFONTMASK + pg * 8, mask);
}

pub fn PdfContentEnsure(doc: int64, pageIdx: int64, needed: int64): int64 {
  // WP-PDF-23: route negative pageIdx to XObject content buffer
  if (pageIdx < 0) {
    var xrec: int64 := _xobjRec(doc, pageIdx);
    var buf: int64 := peek64(xrec + PDF_XOBJ_CONTENTBUF);
    var len: int64 := peek64(xrec + PDF_XOBJ_CONTENTLEN);
    var cap: int64 := peek64(xrec + PDF_XOBJ_CONTENTCAP);
    if (len + needed <= cap) { return 1; }
    var newCap: int64 := cap * 2;
    if (newCap < len + needed) { newCap := len + needed; }
    if (newCap < 4096) { newCap := 4096; }
    var newBuf: int64 := mmapAlloc(newCap);
    if (newBuf == 0) { return 0; }
    zeroMem(newBuf, newCap);
    var ci: int64 := 0;
    while (ci < len) { poke8(newBuf + ci, peek8(buf + ci)); ci := ci + 1; }
    if (buf != 0 && cap > 0) { free(buf, cap); }
    poke64(xrec + PDF_XOBJ_CONTENTBUF, newBuf);
    poke64(xrec + PDF_XOBJ_CONTENTCAP, newCap);
    return 1;
  }

  var contentBufs: int64 := peek64(doc + PDF_DOC_CONTENTBUFS);
  var contentLens: int64 := peek64(doc + PDF_DOC_CONTENTLENS);
  var contentCaps: int64 := peek64(doc + PDF_DOC_CONTENTCAPS);

  var buf: int64 := arrGet(contentBufs, pageIdx);
  var len: int64 := arrGet(contentLens, pageIdx);
  var cap: int64 := arrGet(contentCaps, pageIdx);

  if (len + needed <= cap) { return 1; }

  var newCap: int64 := cap * 2;
  if (newCap < len + needed) { newCap := len + needed; }
  if (newCap < 4096) { newCap := 4096; }

  var newBuf: int64 := mmapAlloc(newCap);
  if (newBuf == 0) { return 0; }
  zeroMem(newBuf, newCap);

  var i: int64 := 0;
  while (i < len) {
    poke8(newBuf + i, peek8(buf + i));
    i += 1;
  }

  if (buf != 0 && cap > 0) { free(buf, cap); }

  arrSet(contentBufs, pageIdx, newBuf);
  arrSet(contentCaps, pageIdx, newCap);
  return 1;
}

pub fn PdfContentAppendStr(doc: int64, pageIdx: int64, s: pchar): int64 {
  var slen: int64 := StrLen(s);
  if (slen == 0) { return 0; }
  if (PdfContentEnsure(doc, pageIdx, slen) == 0) { return 0; }
  var buf: int64 := pdfXBuf(doc, pageIdx);
  var pos: int64 := pdfXPos(doc, pageIdx);
  var i: int64 := 0;
  while (i < slen) { poke8(buf + pos + i, StrCharAt(s, i)); i := i + 1; }
  pdfXSetPos(doc, pageIdx, pos + slen);
  return slen;
}

pub fn PdfContentAppendBytes(doc: int64, pageIdx: int64, data: int64, len: int64): int64 {
  if (len == 0) { return 0; }
  if (PdfContentEnsure(doc, pageIdx, len) == 0) { return 0; }
  var buf: int64 := pdfXBuf(doc, pageIdx);
  var pos: int64 := pdfXPos(doc, pageIdx);
  var i: int64 := 0;
  while (i < len) { poke8(buf + pos + i, peek8(data + i)); i := i + 1; }
  pdfXSetPos(doc, pageIdx, pos + len);
  return len;
}

// Emit one /Info field: " /Key (escaped-value)" to the output buffer.
// src is the raw address of the NUL-terminated string in the doc block.
// Returns new pos; no-ops (returns pos unchanged) if the field is empty.
fn _pdfMetaField(out: int64, pos: int64, key: pchar, src: int64, maxLen: int64): int64 {
  if (peek8(src) == 0) { return pos; }
  pos := pdfStr(out, pos, key);
  poke8(out + pos, 40); pos := pos + 1;   // '('
  var i: int64 := 0;
  while (i < maxLen) {
    var c: int64 := peek8(src + i);
    if (c == 0) { break; }
    if (c == 40 || c == 41 || c == 92) { poke8(out + pos, 92); pos := pos + 1; }
    poke8(out + pos, c); pos := pos + 1;
    i += 1;
  }
  poke8(out + pos, 41); pos := pos + 1;   // ')'
  return pos;
}

// Write (escaped PDF literal string) from a NUL-terminated raw buffer.
fn _pdfEscStr(out: int64, pos: int64, src: int64): int64 {
  poke8(out + pos, 40); pos := pos + 1;
  var i: int64 := 0;
  while (1 == 1) {
    var c: int64 := peek8(src + i);
    if (c == 0) { break; }
    if (c == 40 || c == 41 || c == 92) { poke8(out + pos, 92); pos := pos + 1; }
    poke8(out + pos, c); pos := pos + 1;
    i += 1;
  }
  poke8(out + pos, 41); pos := pos + 1;
  return pos;
}

// Map transition type constant to PDF /S name string.
fn _pdfTransName(t: int64): pchar {
  if (t == PDF_TRANS_DISSOLVE) { return "Dissolve"; }
  if (t == PDF_TRANS_WIPE)     { return "Wipe"; }
  if (t == PDF_TRANS_PUSH)     { return "Push"; }
  if (t == PDF_TRANS_SPLIT)    { return "Split"; }
  if (t == PDF_TRANS_COVER)    { return "Cover"; }
  if (t == PDF_TRANS_UNCOVER)  { return "Uncover"; }
  if (t == PDF_TRANS_FADE)     { return "Fade"; }
  if (t == PDF_TRANS_GLITTER)  { return "Glitter"; }
  if (t == PDF_TRANS_BOX)      { return "Box"; }
  if (t == PDF_TRANS_FLY)      { return "Fly"; }
  return "Replace";
}

// Write " /Dests << /Names [...] >>" — the inner named-dest entry for the /Names dict.
fn _pdfWriteDestsTree(out: int64, pos: int64, buf: int64, count: int64, pageIds: int64): int64 {
  pos := pdfStr(out, pos, " /Dests << /Names [");
  var ndi: int64 := 0;
  while (ndi < count) {
    var nrec: int64 := buf + ndi * PDF_NAMEDEST_RECSIZE;
    if (ndi > 0) { poke8(out + pos, 32); pos := pos + 1; }
    pos := _pdfEscStr(out, pos, peek64(nrec + PDF_NAMEDEST_NAMEBUF));
    pos := pdfStr(out, pos, " [");
    pos := pdfRef(out, pos, arrGet(pageIds, peek64(nrec + PDF_NAMEDEST_PAGEIDX)));
    pos := pdfStr(out, pos, " /XYZ null null null]");
    ndi += 1;
  }
  pos := pdfStr(out, pos, "] >>");
  return pos;
}

// Write " /EmbeddedFiles << /Names [...] >>" — the inner attachment entry for the /Names dict.
fn _pdfWriteEmbedTree(out: int64, pos: int64, buf: int64, count: int64, baseId: int64): int64 {
  pos := pdfStr(out, pos, " /EmbeddedFiles << /Names [");
  var ai: int64 := 0;
  while (ai < count) {
    var arec: int64 := buf + ai * PDF_ATTACH_RECSIZE;
    if (ai > 0) { poke8(out + pos, 32); pos := pos + 1; }
    pos := _pdfEscStr(out, pos, peek64(arec + PDF_ATTACH_NAMEBUF));
    poke8(out + pos, 32); pos := pos + 1;
    pos := pdfRef(out, pos, baseId + ai * 2 + 1);
    ai += 1;
  }
  pos := pdfStr(out, pos, "] >>");
  return pos;
}

// Write " /Properties << /Lyr0 id0 0 R ... >>" into the page /Resources dict.
fn _pdfWriteLayerProps(out: int64, pos: int64, count: int64, baseId: int64): int64 {
  pos := pdfStr(out, pos, " /Properties <<");
  var li: int64 := 0;
  while (li < count) {
    pos := pdfStr(out, pos, " /Lyr");
    pos := pdfInt(out, pos, li);
    poke8(out + pos, 32); pos := pos + 1;
    pos := pdfRef(out, pos, baseId + li);
    li += 1;
  }
  pos := pdfStr(out, pos, " >>");
  return pos;
}

// Write " /OCProperties << ... >>" into the Catalog dict.
fn _pdfWriteOCProperties(out: int64, pos: int64, buf: int64, count: int64, baseId: int64): int64 {
  pos := pdfStr(out, pos, " /OCProperties << /OCGs [");
  var li: int64 := 0;
  while (li < count) {
    if (li > 0) { poke8(out + pos, 32); pos := pos + 1; }
    pos := pdfRef(out, pos, baseId + li);
    li += 1;
  }
  pos := pdfStr(out, pos, "] /D << /BaseState /ON /OFF [");
  var li2: int64 := 0;
  while (li2 < count) {
    if (peek64(buf + li2 * PDF_LAYER_RECSIZE + PDF_LAYER_VISIBLE) == 0) {
      pos := pdfRef(out, pos, baseId + li2);
      poke8(out + pos, 32); pos := pos + 1;
    }
    li2 += 1;
  }
  pos := pdfStr(out, pos, "] >> >>");
  return pos;
}

// Return pointer to the transition record for pageIdx, or 0 if none.
fn _pdfTransForPage(buf: int64, count: int64, pageIdx: int64): int64 {
  var j: int64 := 0;
  while (j < count) {
    var rec: int64 := buf + j * PDF_TRANS_RECSIZE;
    if (peek64(rec + PDF_TRANS_PAGEIDX) == pageIdx) { return rec; }
    j += 1;
  }
  return 0;
}

// ============================================================================
// WP-PDF-17: RC4-128 encryption (Standard Security Handler, V=2, R=3)
// ============================================================================

// MD5 round-constant table: 64 × uint32 stored as int64 in a mmap'd buffer.
fn _md5FillK(k: int64): void {
  poke64(k,    0xD76AA478); poke64(k+8,   0xE8C7B756); poke64(k+16,  0x242070DB); poke64(k+24,  0xC1BDCEEE);
  poke64(k+32, 0xF57C0FAF); poke64(k+40,  0x4787C62A); poke64(k+48,  0xA8304613); poke64(k+56,  0xFD469501);
  poke64(k+64, 0x698098D8); poke64(k+72,  0x8B44F7AF); poke64(k+80,  0xFFFF5BB1); poke64(k+88,  0x895CD7BE);
  poke64(k+96, 0x6B901122); poke64(k+104, 0xFD987193); poke64(k+112, 0xA679438E); poke64(k+120, 0x49B40821);
  poke64(k+128,0xF61E2562); poke64(k+136, 0xC040B340); poke64(k+144, 0x265E5A51); poke64(k+152, 0xE9B6C7AA);
  poke64(k+160,0xD62F105D); poke64(k+168, 0x02441453); poke64(k+176, 0xD8A1E681); poke64(k+184, 0xE7D3FBC8);
  poke64(k+192,0x21E1CDE6); poke64(k+200, 0xC33707D6); poke64(k+208, 0xF4D50D87); poke64(k+216, 0x455A14ED);
  poke64(k+224,0xA9E3E905); poke64(k+232, 0xFCEFA3F8); poke64(k+240, 0x676F02D9); poke64(k+248, 0x8D2A4C8A);
  poke64(k+256,0xFFFA3942); poke64(k+264, 0x8771F681); poke64(k+272, 0x6D9D6122); poke64(k+280, 0xFDE5380C);
  poke64(k+288,0xA4BEEA44); poke64(k+296, 0x4BDECFA9); poke64(k+304, 0xF6BB4B60); poke64(k+312, 0xBEBFBC70);
  poke64(k+320,0x289B7EC6); poke64(k+328, 0xEAA127FA); poke64(k+336, 0xD4EF3085); poke64(k+344, 0x04881D05);
  poke64(k+352,0xD9D4D039); poke64(k+360, 0xE6DB99E5); poke64(k+368, 0x1FA27CF8); poke64(k+376, 0xC4AC5665);
  poke64(k+384,0xF4292244); poke64(k+392, 0x432AFF97); poke64(k+400, 0xAB9423A7); poke64(k+408, 0xFC93A039);
  poke64(k+416,0x655B59C3); poke64(k+424, 0x8F0CCC92); poke64(k+432, 0xFFEFF47D); poke64(k+440, 0x85845DD1);
  poke64(k+448,0x6FA87E4F); poke64(k+456, 0xFE2CE6E0); poke64(k+464, 0xA3014314); poke64(k+472, 0x4E0811A1);
  poke64(k+480,0xF7537E82); poke64(k+488, 0xBD3AF235); poke64(k+496, 0x2AD7D2BB); poke64(k+504, 0xEB86D391);
}

// Process one 64-byte MD5 block. state = 4×int64 (a,b,c,d). kbuf = 64 K constants.
fn _md5Block(state: int64, block: int64, kbuf: int64): void {
  var a: int64 := peek64(state);
  var b: int64 := peek64(state + 8);
  var c: int64 := peek64(state + 16);
  var d: int64 := peek64(state + 24);
  var i: int64 := 0;
  while (i < 64) {
    var f: int64 := 0;  var g: int64 := 0;  var s: int64 := 0;
    var si: int64 := i & 3;
    if (i < 16) {
      f := (b & c) | ((~b) & 0xFFFFFFFF & d);
      g := i;
      if (si==0){s:=7;}else if(si==1){s:=12;}else if(si==2){s:=17;}else{s:=22;}
    } else if (i < 32) {
      f := (d & b) | ((~d) & 0xFFFFFFFF & c);
      g := (5 * i + 1) & 15;
      if (si==0){s:=5;}else if(si==1){s:=9;}else if(si==2){s:=14;}else{s:=20;}
    } else if (i < 48) {
      f := b ^ c ^ d;
      g := (3 * i + 5) & 15;
      if (si==0){s:=4;}else if(si==1){s:=11;}else if(si==2){s:=16;}else{s:=23;}
    } else {
      f := c ^ (b | ((~d) & 0xFFFFFFFF));
      g := (7 * i) & 15;
      if (si==0){s:=6;}else if(si==1){s:=10;}else if(si==2){s:=15;}else{s:=21;}
    }
    var wg: int64 := ( peek8(block+g*4) | (peek8(block+g*4+1)<<8) |
                       (peek8(block+g*4+2)<<16) | (peek8(block+g*4+3)<<24) ) & 0xFFFFFFFF;
    var tmp: int64 := (f + a + peek64(kbuf + i*8) + wg) & 0xFFFFFFFF;
    tmp := ((tmp << s) | ((tmp & 0xFFFFFFFF) >> (32 - s))) & 0xFFFFFFFF;
    a := d;  d := c;  c := b;
    b := (b + tmp) & 0xFFFFFFFF;
    i += 1;
  }
  poke64(state,      (peek64(state)      + a) & 0xFFFFFFFF);
  poke64(state + 8,  (peek64(state + 8)  + b) & 0xFFFFFFFF);
  poke64(state + 16, (peek64(state + 16) + c) & 0xFFFFFFFF);
  poke64(state + 24, (peek64(state + 24) + d) & 0xFFFFFFFF);
}

// Compute MD5(data, len) → 16 bytes at output.
fn _md5(data: int64, len: int64, output: int64): void {
  var state: int64 := alloc(32);
  var kbuf:  int64 := alloc(512);
  var pbuf:  int64 := alloc(128);
  if (state == 0 || kbuf == 0 || pbuf == 0) {
    if (state != 0) { free(state, 32); }
    if (kbuf  != 0) { free(kbuf,  512); }
    if (pbuf  != 0) { free(pbuf,  128); }
    return;
  }
  // Init state: a b c d
  poke64(state,      0x67452301);
  poke64(state + 8,  0xEFCDAB89);
  poke64(state + 16, 0x98BADCFE);
  poke64(state + 24, 0x10325476);
  _md5FillK(kbuf);
  // Process full 64-byte blocks
  var off: int64 := 0;
  while (off + 64 <= len) {
    _md5Block(state, data + off, kbuf);
    off += 64;
  }
  // Build padding block(s)
  var rem: int64 := len - off;
  var pi: int64 := 0;
  while (pi < rem) { poke8(pbuf + pi, peek8(data + off + pi)); pi := pi + 1; }
  poke8(pbuf + rem, 0x80);
  var fillTo: int64 := 56;
  if (rem >= 56) { fillTo := 120; }
  pi := rem + 1;
  while (pi < fillTo) { poke8(pbuf + pi, 0); pi := pi + 1; }
  // Length in bits, little-endian 64-bit
  var bits: int64 := len * 8;
  poke8(pbuf+fillTo,   bits        & 0xFF);
  poke8(pbuf+fillTo+1, (bits >>  8) & 0xFF);
  poke8(pbuf+fillTo+2, (bits >> 16) & 0xFF);
  poke8(pbuf+fillTo+3, (bits >> 24) & 0xFF);
  poke8(pbuf+fillTo+4, (bits >> 32) & 0xFF);
  poke8(pbuf+fillTo+5, (bits >> 40) & 0xFF);
  poke8(pbuf+fillTo+6, (bits >> 48) & 0xFF);
  poke8(pbuf+fillTo+7, (bits >> 56) & 0xFF);
  _md5Block(state, pbuf, kbuf);
  if (fillTo == 120) { _md5Block(state, pbuf + 64, kbuf); }
  // Output: 4 words in LE order
  var wi: int64 := 0;
  while (wi < 4) {
    var w: int64 := peek64(state + wi * 8);
    poke8(output + wi*4,   w        & 0xFF);
    poke8(output + wi*4+1, (w >> 8)  & 0xFF);
    poke8(output + wi*4+2, (w >> 16) & 0xFF);
    poke8(output + wi*4+3, (w >> 24) & 0xFF);
    wi += 1;
  }
  free(state, 32);  free(kbuf, 512);  free(pbuf, 128);
}

// RC4 Key-Scheduling Algorithm. state: 256-byte buffer, key: keyLen bytes.
fn _rc4Init(state: int64, key: int64, keyLen: int64): void {
  var i: int64 := 0;
  while (i < 256) { poke8(state + i, i); i := i + 1; }
  var j: int64 := 0;
  i := 0;
  while (i < 256) {
    j := (j + peek8(state+i) + peek8(key + (i & (keyLen-1)))) & 0xFF;  // keyLen must be power-of-2 for & trick
    // safer: j := (j + peek8(state+i) + peek8(key + (i % keyLen))) & 0xFF; but % not available
    var tmp: int64 := peek8(state+i); poke8(state+i, peek8(state+j)); poke8(state+j, tmp);
    i += 1;
  }
}

// RC4 encrypt/decrypt: data in-place (or outbuf != data for separate buffers).
fn _rc4Crypt(state: int64, data: int64, len: int64): void {
  var i: int64 := 0;  var j: int64 := 0;  var k: int64 := 0;
  while (k < len) {
    i := (i + 1) & 0xFF;
    j := (j + peek8(state + i)) & 0xFF;
    var tmp: int64 := peek8(state+i); poke8(state+i, peek8(state+j)); poke8(state+j, tmp);
    var ks: int64 := peek8(state + ((peek8(state+i) + peek8(state+j)) & 0xFF));
    poke8(data + k, peek8(data + k) ^ ks);
    k += 1;
  }
}

// RC4 with modulo keyLen (for non-power-of-2 key lengths like 16).
fn _rc4InitMod(state: int64, key: int64, keyLen: int64): void {
  var i: int64 := 0;
  while (i < 256) { poke8(state + i, i); i := i + 1; }
  var j: int64 := 0;
  i := 0;
  while (i < 256) {
    var ki: int64 := i;
    while (ki >= keyLen) { ki := ki - keyLen; }  // ki = i % keyLen
    j := (j + peek8(state+i) + peek8(key + ki)) & 0xFF;
    var tmp: int64 := peek8(state+i); poke8(state+i, peek8(state+j)); poke8(state+j, tmp);
    i += 1;
  }
}

// Compute per-object RC4 key: MD5(fileKey[0..15] + objId[0..2] + {0,0}).
// Output: 16 bytes at keyOut.
fn _pdfObjKey(fileKey: int64, objId: int64, keyOut: int64): void {
  var tmp: int64 := alloc(21);
  if (tmp == 0) { return; }
  var ti: int64 := 0;
  while (ti < 16) { poke8(tmp+ti, peek8(fileKey+ti)); ti:=ti+1; }
  poke8(tmp+16, objId         & 0xFF);
  poke8(tmp+17, (objId >>  8) & 0xFF);
  poke8(tmp+18, (objId >> 16) & 0xFF);
  poke8(tmp+19, 0);  poke8(tmp+20, 0);
  _md5(tmp, 21, keyOut);
  free(tmp, 21);
}

// Encrypt a mmap'd stream buffer in-place using RC4 with per-object key.
fn _pdfEncryptStream(doc: int64, objId: int64, buf: int64, len: int64): void {
  var fileKey: int64 := peek64(doc + PDF_DOC_ENCFKEY);
  if (fileKey == 0 || buf == 0 || len <= 0) { return; }
  var objKey:  int64 := alloc(16);
  var state:   int64 := alloc(256);
  if (objKey == 0 || state == 0) {
    if (objKey != 0) { free(objKey, 16); }
    if (state  != 0) { free(state,  256); }
    return;
  }
  _pdfObjKey(fileKey, objId, objKey);
  _rc4InitMod(state, objKey, 16);
  _rc4Crypt(state, buf, len);
  free(objKey, 16);  free(state, 256);
}

// Encrypt string bytes and write as hex <..> to output buffer. Returns new pos.
fn _pdfEncStr(out: int64, pos: int64, src: int64, len: int64, doc: int64, objId: int64): int64 {
  var fileKey: int64 := peek64(doc + PDF_DOC_ENCFKEY);
  if (fileKey == 0 || src == 0 || len <= 0) {
    // Fallback: write unencrypted as literal
    poke8(out+pos, 40); pos:=pos+1;
    var fi: int64 := 0;
    while (fi < len) { var fc: int64 := peek8(src+fi); if(fc==40||fc==41||fc==92){poke8(out+pos,92);pos:=pos+1;} poke8(out+pos,fc);pos:=pos+1;fi:=fi+1; }
    poke8(out+pos, 41); pos:=pos+1;
    return pos;
  }
  var objKey: int64 := alloc(16);
  var enc:    int64 := alloc(len);
  var state:  int64 := alloc(256);
  if (objKey == 0 || enc == 0 || state == 0) {
    if (objKey != 0) { free(objKey, 16); }
    if (enc    != 0) { free(enc, len); }
    if (state  != 0) { free(state, 256); }
    return pos;
  }
  var ci: int64 := 0;
  while (ci < len) { poke8(enc+ci, peek8(src+ci)); ci:=ci+1; }
  _pdfObjKey(fileKey, objId, objKey);
  _rc4InitMod(state, objKey, 16);
  _rc4Crypt(state, enc, len);
  poke8(out+pos, 60); pos:=pos+1;  // '<'
  var hi: int64 := 0;
  while (hi < len) {
    var hb: int64 := peek8(enc+hi);
    var hn: int64 := (hb >> 4) & 0xF;  var hl: int64 := hb & 0xF;
    if (hn < 10) { poke8(out+pos, 48+hn); } else { poke8(out+pos, 55+hn); } pos:=pos+1;
    if (hl < 10) { poke8(out+pos, 48+hl); } else { poke8(out+pos, 55+hl); } pos:=pos+1;
    hi += 1;
  }
  poke8(out+pos, 62); pos:=pos+1;  // '>'
  free(objKey, 16);  free(enc, len);  free(state, 256);
  return pos;
}

// PDF standard password padding string (32 bytes, Algorithm 2 step 1).
fn _pdfPadPwd(src: pchar, out: int64): void {
  var pad: pchar := "\x28\xBF\x4E\x5E\x4E\x75\x8A\x41\x64\x00\x4E\x56\xFF\xFA\x01\x08\x2E\x2E\x00\xB6\xD0\x68\x3E\x80\x2F\x0C\xA9\xFE\x64\x53\x69\x7A"c;
  var srcLen: int64 := 0;
  if (src != 0) { srcLen := StrLen(src); if (srcLen > 32) { srcLen := 32; } }
  var i: int64 := 0;
  while (i < srcLen) { poke8(out+i, StrCharAt(src, i)); i:=i+1; }
  while (i < 32) { poke8(out+i, StrCharAt(pad, i-srcLen)); i:=i+1; }
}

// Compute all encryption keys and store in doc struct.
// Implements PDF Standard Security Handler R=3, V=2, 128-bit RC4.
fn _pdfPrepareEncryption(doc: int64): void {
  if (peek64(doc + PDF_DOC_ENCREADY) != 0) { return; }
  // Allocate /Encrypt dict object ID
  var encId: int64 := peek64(doc + PDF_DOC_NEXTID);
  poke64(doc + PDF_DOC_NEXTID, encId + 1);
  poke64(doc + PDF_DOC_ENCCURID, encId);
  // Allocate output buffers
  var fileKey: int64 := alloc(16);
  var oKey:    int64 := alloc(32);
  var uKey:    int64 := alloc(32);
  var tmp:     int64 := alloc(128);
  var state:   int64 := alloc(256);
  if (fileKey==0||oKey==0||uKey==0||tmp==0||state==0) {
    if(fileKey!=0){free(fileKey,16);} if(oKey!=0){free(oKey,32);} if(uKey!=0){free(uKey,32);}
    if(tmp!=0){free(tmp,128);} if(state!=0){free(state,256);}
    return;
  }
  // --- Algorithm 3: Compute /O (owner key) ---
  var pwdBuf: int64 := alloc(32);
  if (pwdBuf == 0) {
    free(fileKey,16);free(oKey,32);free(uKey,32);free(tmp,128);free(state,256);
    return;
  }
  // 3a: MD5(pad(ownerPassword)) × 51
  var opwd: pchar := 0;
  var opwdBuf: int64 := peek64(doc + PDF_DOC_ENCOPWD);
  // Treat ownerPassword; if none, use userPassword
  var upwdBuf: int64 := peek64(doc + PDF_DOC_ENCUPWD);
  _pdfPadPwd(0, pwdBuf);  // pad with empty owner password → use padding only
  if (opwdBuf != 0) {
    var oi: int64 := 0;
    while (oi < 32) { poke8(pwdBuf+oi, peek8(opwdBuf+oi)); oi:=oi+1; }
  } else if (upwdBuf != 0) {
    // fallback: use user password as owner password
    var oi2: int64 := 0;
    while (oi2 < 32) { poke8(pwdBuf+oi2, peek8(upwdBuf+oi2)); oi2:=oi2+1; }
  }
  _md5(pwdBuf, 32, tmp);
  // 50 additional MD5 rounds
  var ri: int64 := 0;
  while (ri < 50) { _md5(tmp, 16, tmp); ri:=ri+1; }
  // tmp[0..15] = owner RC4 key
  // 3b: RC4-encrypt padded user password with owner RC4 key
  _pdfPadPwd(0, pwdBuf);  // pad(userPassword)
  if (upwdBuf != 0) {
    var ui2: int64 := 0;
    while (ui2 < 32) { poke8(pwdBuf+ui2, peek8(upwdBuf+ui2)); ui2:=ui2+1; }
  }
  _rc4InitMod(state, tmp, 16);
  _rc4Crypt(state, pwdBuf, 32);  // oKey intermediate
  // 3c: 19 more RC4 rounds with key XOR i
  var xorKey: int64 := alloc(16);
  if (xorKey != 0) {
    var step: int64 := 1;
    while (step <= 19) {
      var xi: int64 := 0;
      while (xi < 16) { poke8(xorKey+xi, peek8(tmp+xi) ^ step); xi:=xi+1; }
      _rc4InitMod(state, xorKey, 16);
      _rc4Crypt(state, pwdBuf, 32);
      step += 1;
    }
    free(xorKey, 16);
  }
  var oci: int64 := 0;
  while (oci < 32) { poke8(oKey+oci, peek8(pwdBuf+oci)); oci:=oci+1; }
  // --- Algorithm 2: Compute file encryption key ---
  // Input: pad(userPwd) + /O + P (4 bytes LE) + fileId (16 bytes zero)
  _pdfPadPwd(0, tmp);
  if (upwdBuf != 0) {
    var ui3: int64 := 0;
    while (ui3 < 32) { poke8(tmp+ui3, peek8(upwdBuf+ui3)); ui3:=ui3+1; }
  }
  var ti: int64 := 32;
  while (ti < 64) { poke8(tmp+ti, peek8(oKey+(ti-32))); ti:=ti+1; }
  var perms: int64 := peek64(doc + PDF_DOC_ENCPERMS);
  poke8(tmp+64, perms         & 0xFF);
  poke8(tmp+65, (perms >>  8) & 0xFF);
  poke8(tmp+66, (perms >> 16) & 0xFF);
  poke8(tmp+67, (perms >> 24) & 0xFF);
  // fileId: 16 zero bytes (positions 68..83)
  var zi: int64 := 68; while (zi < 84) { poke8(tmp+zi, 0); zi:=zi+1; }
  _md5(tmp, 84, fileKey);
  // 50 extra MD5 rounds
  var ri2: int64 := 0;
  while (ri2 < 50) { _md5(fileKey, 16, fileKey); ri2:=ri2+1; }
  // fileKey[0..15] = file encryption key
  // --- Algorithm 4a: Compute /U (R=3) ---
  // h = MD5(padding + fileId(16 zeros))
  var padBuf: int64 := alloc(48);
  if (padBuf != 0) {
    _pdfPadPwd(0, padBuf);  // 32 bytes padding
    var pi2: int64 := 32; while (pi2 < 48) { poke8(padBuf+pi2, 0); pi2:=pi2+1; }
    _md5(padBuf, 48, tmp);   // tmp[0..15] = h
    free(padBuf, 48);
  }
  // RC4-encrypt h with fileKey
  _rc4InitMod(state, fileKey, 16);
  _rc4Crypt(state, tmp, 16);
  // 19 more rounds XOR
  var xk2: int64 := alloc(16);
  if (xk2 != 0) {
    var step2: int64 := 1;
    while (step2 <= 19) {
      var xi2: int64 := 0;
      while (xi2 < 16) { poke8(xk2+xi2, peek8(fileKey+xi2) ^ step2); xi2:=xi2+1; }
      _rc4InitMod(state, xk2, 16);
      _rc4Crypt(state, tmp, 16);
      step2 += 1;
    }
    free(xk2, 16);
  }
  // /U = tmp[0..15] + 16 zero bytes
  var uki: int64 := 0;
  while (uki < 16) { poke8(uKey+uki, peek8(tmp+uki)); uki:=uki+1; }
  while (uki < 32) { poke8(uKey+uki, 0); uki:=uki+1; }
  // Store results
  poke64(doc + PDF_DOC_ENCFKEY, fileKey);
  poke64(doc + PDF_DOC_ENCOKEY, oKey);
  poke64(doc + PDF_DOC_ENCUKEY, uKey);
  poke64(doc + PDF_DOC_ENCREADY, 1);
  free(pwdBuf,32); free(tmp,128); free(state,256);
}

// ============================================================================
// WP-PDF-17: Public API — call before PdfSave
// ============================================================================

// Set user password (required for opening the document; max 32 bytes).
pub fn PdfSetUserPassword(doc: int64, pwd: pchar): void {
  if (doc == 0 || pwd == 0) { return; }
  var buf: int64 := peek64(doc + PDF_DOC_ENCUPWD);
  if (buf == 0) { buf := alloc(32); if (buf==0){return;} poke64(doc + PDF_DOC_ENCUPWD, buf); }
  var len: int64 := StrLen(pwd); if (len > 32) { len := 32; }
  var i: int64 := 0;
  while (i < len) { poke8(buf+i, StrCharAt(pwd, i)); i:=i+1; }
  while (i < 32) { poke8(buf+i, 0); i:=i+1; }
  poke64(doc + PDF_DOC_ENCREADY, 0);  // invalidate cached keys
}

// Set owner password (required for editing rights; max 32 bytes).
pub fn PdfSetOwnerPassword(doc: int64, pwd: pchar): void {
  if (doc == 0 || pwd == 0) { return; }
  var buf: int64 := peek64(doc + PDF_DOC_ENCOPWD);
  if (buf == 0) { buf := alloc(32); if (buf==0){return;} poke64(doc + PDF_DOC_ENCOPWD, buf); }
  var len: int64 := StrLen(pwd); if (len > 32) { len := 32; }
  var i: int64 := 0;
  while (i < len) { poke8(buf+i, StrCharAt(pwd, i)); i:=i+1; }
  while (i < 32) { poke8(buf+i, 0); i:=i+1; }
  poke64(doc + PDF_DOC_ENCREADY, 0);
}

// Set permission flags. OR together PDF_PERM_* constants for allowed operations.
// Default: PDF_PERM_ALL (-4 = all allowed). Restrictions take effect with user password.
pub fn PdfSetPermissions(doc: int64, flags: int64): void {
  if (doc == 0) { return; }
  // P = bits 13-32 all set (0xFFFFF000) | allowed bits 3-12 | bits 1-2 must be 0
  var p: int64 := (0xFFFFF000 | (flags & 0xFFC)) & 0xFFFFFFFC;
  poke64(doc + PDF_DOC_ENCPERMS, p);
  poke64(doc + PDF_DOC_ENCREADY, 0);
}

// Enable encryption. Only PDF_ENC_RC4_128 is implemented; others are accepted
// but degrade to RC4-128. Call PdfSetUserPassword before PdfSave.
pub fn PdfSetEncryption(doc: int64, encType: int64): void {
  if (doc == 0) { return; }
  if (encType == PDF_ENC_NONE) {
    poke64(doc + PDF_DOC_ENCTYPE,  PDF_ENC_NONE);
    poke64(doc + PDF_DOC_ENCREADY, 0);
    return;
  }
  poke64(doc + PDF_DOC_ENCTYPE, PDF_ENC_RC4_128);
  // Default permissions: all allowed
  if (peek64(doc + PDF_DOC_ENCPERMS) == 0) {
    poke64(doc + PDF_DOC_ENCPERMS, 0xFFFFFFFC & 0xFFFFFFFF);
  }
  poke64(doc + PDF_DOC_ENCREADY, 0);
}

// ============================================================================
// WP-PDF-27: minimal sRGB ICC v2 profile (420 bytes)
// ============================================================================

fn _pdfaFillICC(b: int64): void {
  // Header: 128 bytes
  poke8(b,0);poke8(b+1,0);poke8(b+2,1);poke8(b+3,0xA4);          // profileSize=420
  poke8(b+4,0);poke8(b+5,0);poke8(b+6,0);poke8(b+7,0);           // CMM=0
  poke8(b+8,2);poke8(b+9,0x10);poke8(b+10,0);poke8(b+11,0);      // ICC v2.1
  poke8(b+12,0x6D);poke8(b+13,0x6E);poke8(b+14,0x74);poke8(b+15,0x72); // 'mntr'
  poke8(b+16,0x52);poke8(b+17,0x47);poke8(b+18,0x42);poke8(b+19,0x20); // 'RGB '
  poke8(b+20,0x58);poke8(b+21,0x59);poke8(b+22,0x5A);poke8(b+23,0x20); // 'XYZ '
  var i: int64 := 24;
  while (i < 36) { poke8(b+i, 0); i := i+1; }                    // date/time
  poke8(b+36,0x61);poke8(b+37,0x63);poke8(b+38,0x73);poke8(b+39,0x70); // 'acsp'
  i := 40; while (i < 68) { poke8(b+i, 0); i := i+1; }           // platform..intent
  poke8(b+68,0);poke8(b+69,0);poke8(b+70,0xF6);poke8(b+71,0xD6); // illuminant X D50
  poke8(b+72,0);poke8(b+73,1);poke8(b+74,0);poke8(b+75,0);       // illuminant Y=1.0
  poke8(b+76,0);poke8(b+77,0);poke8(b+78,0xD3);poke8(b+79,0x2D); // illuminant Z
  i := 80; while (i < 128) { poke8(b+i, 0); i := i+1; }          // creator+ID+reserved
  // Tag table: 128-227
  poke8(b+128,0);poke8(b+129,0);poke8(b+130,0);poke8(b+131,8);   // 8 tags
  // 'desc' offset=228=0xE4 len=96=0x60
  poke8(b+132,0x64);poke8(b+133,0x65);poke8(b+134,0x73);poke8(b+135,0x63);
  poke8(b+136,0);poke8(b+137,0);poke8(b+138,0);poke8(b+139,0xE4);
  poke8(b+140,0);poke8(b+141,0);poke8(b+142,0);poke8(b+143,0x60);
  // 'wtpt' offset=324=0x144 len=20
  poke8(b+144,0x77);poke8(b+145,0x74);poke8(b+146,0x70);poke8(b+147,0x74);
  poke8(b+148,0);poke8(b+149,0);poke8(b+150,1);poke8(b+151,0x44);
  poke8(b+152,0);poke8(b+153,0);poke8(b+154,0);poke8(b+155,0x14);
  // 'rXYZ' offset=344=0x158 len=20
  poke8(b+156,0x72);poke8(b+157,0x58);poke8(b+158,0x59);poke8(b+159,0x5A);
  poke8(b+160,0);poke8(b+161,0);poke8(b+162,1);poke8(b+163,0x58);
  poke8(b+164,0);poke8(b+165,0);poke8(b+166,0);poke8(b+167,0x14);
  // 'gXYZ' offset=364=0x16C len=20
  poke8(b+168,0x67);poke8(b+169,0x58);poke8(b+170,0x59);poke8(b+171,0x5A);
  poke8(b+172,0);poke8(b+173,0);poke8(b+174,1);poke8(b+175,0x6C);
  poke8(b+176,0);poke8(b+177,0);poke8(b+178,0);poke8(b+179,0x14);
  // 'bXYZ' offset=384=0x180 len=20
  poke8(b+180,0x62);poke8(b+181,0x58);poke8(b+182,0x59);poke8(b+183,0x5A);
  poke8(b+184,0);poke8(b+185,0);poke8(b+186,1);poke8(b+187,0x80);
  poke8(b+188,0);poke8(b+189,0);poke8(b+190,0);poke8(b+191,0x14);
  // 'rTRC' offset=404=0x194 len=16
  poke8(b+192,0x72);poke8(b+193,0x54);poke8(b+194,0x52);poke8(b+195,0x43);
  poke8(b+196,0);poke8(b+197,0);poke8(b+198,1);poke8(b+199,0x94);
  poke8(b+200,0);poke8(b+201,0);poke8(b+202,0);poke8(b+203,0x10);
  // 'gTRC' offset=404 (shared) len=16
  poke8(b+204,0x67);poke8(b+205,0x54);poke8(b+206,0x52);poke8(b+207,0x43);
  poke8(b+208,0);poke8(b+209,0);poke8(b+210,1);poke8(b+211,0x94);
  poke8(b+212,0);poke8(b+213,0);poke8(b+214,0);poke8(b+215,0x10);
  // 'bTRC' offset=404 (shared) len=16
  poke8(b+216,0x62);poke8(b+217,0x54);poke8(b+218,0x52);poke8(b+219,0x43);
  poke8(b+220,0);poke8(b+221,0);poke8(b+222,1);poke8(b+223,0x94);
  poke8(b+224,0);poke8(b+225,0);poke8(b+226,0);poke8(b+227,0x10);
  // 'desc' tag data: 228-323 (96 bytes)
  poke8(b+228,0x64);poke8(b+229,0x65);poke8(b+230,0x73);poke8(b+231,0x63); // 'desc'
  poke8(b+232,0);poke8(b+233,0);poke8(b+234,0);poke8(b+235,0);             // reserved
