  poke8(b+240,0x73);poke8(b+241,0x52);poke8(b+242,0x47);poke8(b+243,0x42);poke8(b+244,0); // "sRGB\0"
  poke8(b+245,0);poke8(b+246,0);poke8(b+247,0);poke8(b+248,0);             // ucLangCode
  poke8(b+249,0);poke8(b+250,0);poke8(b+251,0);poke8(b+252,0);             // ucCount
  poke8(b+253,0);poke8(b+254,0);poke8(b+255,0);                            // scCode+scCount
  i := 256; while (i < 324) { poke8(b+i, 0); i := i+1; }                  // scDesc+pad
  // 'wtpt' tag data: 324-343
  poke8(b+324,0x58);poke8(b+325,0x59);poke8(b+326,0x5A);poke8(b+327,0x20); // 'XYZ '
  poke8(b+328,0);poke8(b+329,0);poke8(b+330,0);poke8(b+331,0);
  poke8(b+332,0);poke8(b+333,0);poke8(b+334,0xF6);poke8(b+335,0xD6);       // X=0.9642
  poke8(b+336,0);poke8(b+337,1);poke8(b+338,0);poke8(b+339,0);             // Y=1.0
  poke8(b+340,0);poke8(b+341,0);poke8(b+342,0xD3);poke8(b+343,0x2D);       // Z=0.8249
  // 'rXYZ' tag data: 344-363
  poke8(b+344,0x58);poke8(b+345,0x59);poke8(b+346,0x5A);poke8(b+347,0x20);
  poke8(b+348,0);poke8(b+349,0);poke8(b+350,0);poke8(b+351,0);
  poke8(b+352,0);poke8(b+353,0);poke8(b+354,0x6F);poke8(b+355,0xA2);       // X=0.4360
  poke8(b+356,0);poke8(b+357,0);poke8(b+358,0x38);poke8(b+359,0xF5);       // Y=0.2225
  poke8(b+360,0);poke8(b+361,0);poke8(b+362,0x09);poke8(b+363,0x3D);       // Z=0.0142
  // 'gXYZ' tag data: 364-383
  poke8(b+364,0x58);poke8(b+365,0x59);poke8(b+366,0x5A);poke8(b+367,0x20);
  poke8(b+368,0);poke8(b+369,0);poke8(b+370,0);poke8(b+371,0);
  poke8(b+372,0);poke8(b+373,0);poke8(b+374,0x62);poke8(b+375,0xB8);       // X=0.3851
  poke8(b+376,0);poke8(b+377,0);poke8(b+378,0xB7);poke8(b+379,0x85);       // Y=0.7169
  poke8(b+380,0);poke8(b+381,0);poke8(b+382,0x18);poke8(b+383,0x5E);       // Z=0.0952
  // 'bXYZ' tag data: 384-403
  poke8(b+384,0x58);poke8(b+385,0x59);poke8(b+386,0x5A);poke8(b+387,0x20);
  poke8(b+388,0);poke8(b+389,0);poke8(b+390,0);poke8(b+391,0);
  poke8(b+392,0);poke8(b+393,0);poke8(b+394,0x24);poke8(b+395,0xA0);       // X=0.1430
  poke8(b+396,0);poke8(b+397,0);poke8(b+398,0x0F);poke8(b+399,0x84);       // Y=0.0606
  poke8(b+400,0);poke8(b+401,0);poke8(b+402,0xB6);poke8(b+403,0xCF);       // Z=0.7142
