// std/pdf/namedest.lyx
// PDF named destinations (/Names /Dests) — WP-PDF-14

@description("PDF named destinations: PdfAddNamedDest for string-keyed jump targets")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, fs.write])
unit std.pdf.namedest;

import std.alloc;
import std.pdf.builder;

fn _namedestStrDup(s: pchar): int64 {
  var len: int64 := StrLen(s) + 1;
  var buf: int64 := alloc(len);
  if (buf == 0) { return 0; }
  var i: int64 := 0;
  while (i < len) {
    poke8(buf + i, StrCharAt(s, i));
    i += 1;
  }
  return buf;
}

fn _namedestEnsure(doc: int64): int64 {
  var count: int64 := peek64(doc + PDF_DOC_NAMEDESTCOUNT);
  var cap:   int64 := peek64(doc + PDF_DOC_NAMEDESTCAP);
  var buf:   int64 := peek64(doc + PDF_DOC_NAMEDESTBUF);
  if (count < cap) { return 1; }
  var newCap: int64 := cap * 2;
  var newBuf: int64 := alloc(newCap * PDF_NAMEDEST_RECSIZE);
  if (newBuf == 0) { return 0; }
  var ci: int64 := 0;
  while (ci < count * PDF_NAMEDEST_RECSIZE) {
    poke8(newBuf + ci, peek8(buf + ci));
    ci += 1;
  }
  while (ci < newCap * PDF_NAMEDEST_RECSIZE) {
    poke8(newBuf + ci, 0);
    ci += 1;
  }
  free(buf, cap * PDF_NAMEDEST_RECSIZE);
  poke64(doc + PDF_DOC_NAMEDESTBUF, newBuf);
  poke64(doc + PDF_DOC_NAMEDESTCAP, newCap);
  return 1;
}

// Register a named destination pointing to the top of pageIdx (0-based).
// The name can be referenced from URI fragment links or goto annotations.
// Returns 0 on success, -1 on error.
pub fn PdfAddNamedDest(doc: int64, name: pchar, pageIdx: int64): int64 {
  if (doc == 0) { return -1; }
  if (_namedestEnsure(doc) == 0) { return -1; }
  var nameBuf: int64 := _namedestStrDup(name);
  if (nameBuf == 0) { return -1; }
  var count: int64 := peek64(doc + PDF_DOC_NAMEDESTCOUNT);
  var buf:   int64 := peek64(doc + PDF_DOC_NAMEDESTBUF);
  var rec:   int64 := buf + count * PDF_NAMEDEST_RECSIZE;
  poke64(rec + PDF_NAMEDEST_NAMEBUF, nameBuf);
  poke64(rec + PDF_NAMEDEST_NAMELEN, StrLen(name) + 1);
  poke64(rec + PDF_NAMEDEST_PAGEIDX, pageIdx);
  poke64(doc + PDF_DOC_NAMEDESTCOUNT, count + 1);
  return 0;
}
