// std/pdf/imagefile.lyx
// PDF-Bilder aus einer Datei — #1254.
//
// `PdfAddImage` nimmt Rohpixel, Breite, Hoehe und Kanalzahl. Die Doku zeigte
// an mehreren Stellen `PdfAddImage(doc, "logo.png")`; eine solche Fassung gab
// es nie. Statt 
// die Doku auf den Rohdatenweg umzuschreiben, gibt es den Dateiweg jetzt —
// er ist duenn, weil beide Halften schon da waren: `ImageDecode` erkennt das
// Format selbst (BMP, PNG, JPEG, GIF, TIFF, WebP, AVIF), `PdfAddImage` nimmt
// die Pixel.
//
// EIGENE UNIT, nicht in std.pdf.image: wer nur Rohpixel einbettet, soll nicht
// saemtliche Bilddekoder mitschleppen.

@description("PDF-Bilder aus Datei: PdfAddImageFile")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.pdf.imagefile;

import std.alloc;
import std.pdf.image;
import std.image.core;
import std.image.image;

// Bild aus einer Datei einbetten. Rueckgabe wie PdfAddImage: der Bildindex
// fuer PdfDrawImage, oder -1.
//
// ALPHA WIRD VERWORFEN. Ein vierkanaliges Bild (RGBA) wird auf RGB gekuerzt,
// weil PDF-DeviceRGB keinen Alphakanal kennt; durchsichtige Bereiche werden
// also deckend. Der richtige Weg waere eine SMask — die gibt es hier noch
// nicht, und ein halb umgesetzter Alphakanal waere schlechter als eine
// benannte Grenze.
pub fn PdfAddImageFile(doc: int64, path: pchar): int64 {
  if (doc == 0) { return 0 - 1; }
  var img: int64 := alloc(GRF_SIZE);
  if (img == 0) { return 0 - 1; }

  if (ImageDecode(path, 0, img) == 0) {
    free(img, GRF_SIZE);
    return 0 - 1;
  }

  var w:  int64 := peek64(img + GRF_OFF_WIDTH);
  var h:  int64 := peek64(img + GRF_OFF_HEIGHT);
  var ch: int64 := peek64(img + GRF_OFF_CHANNELS);
  var px: int64 := peek64(img + GRF_OFF_PIXELS);
  var erg: int64 := 0 - 1;

  if (ch == 1 || ch == 3) {
    erg := PdfAddImage(doc, px, w, h, ch);
  } else if (ch == 4) {
    // RGBA → RGB. PdfAddImage komprimiert die Bytes in einen eigenen Puffer,
    // der Zwischenpuffer darf danach weg.
    var n:   int64 := w * h;
    var rgb: int64 := alloc(n * 3);
    if (rgb != 0) {
      var i: int64 := 0;
      while (i < n) {
        poke8(rgb + i * 3,     peek8(px + i * 4));
        poke8(rgb + i * 3 + 1, peek8(px + i * 4 + 1));
        poke8(rgb + i * 3 + 2, peek8(px + i * 4 + 2));
        i := i + 1;
      }
      erg := PdfAddImage(doc, rgb, w, h, 3);
      free(rgb, n * 3);
    }
  }
  // ch == 2 (Grau + Alpha) faellt durch: dafuer gaebe es keine sinnvolle
  // Abbildung ohne SMask, und stillschweigend den Alphakanal als Grauwert zu
  // nehmen waere schlimmer als -1.

  ImageFree(img);
  free(img, GRF_SIZE);
  return erg;
}
