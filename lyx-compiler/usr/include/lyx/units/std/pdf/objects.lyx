// std/pdf/objects.lyx
// PDF output buffer writing primitives

@description("PDF buffer writing primitives: bytes, integers, reals, names, strings")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.pdf.objects;

// Append single byte to output buffer at pos, return new pos
pub fn pdfByte(buf: int64, pos: int64, b: int64): int64 {
  poke8(buf + pos, b);
  return pos + 1;
}

// Append NUL-terminated string, return new pos
pub fn pdfStr(buf: int64, pos: int64, s: pchar): int64 {
  var i: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(s, i);
    if (c == 0) { break; }
    poke8(buf + pos, c);
    pos := pos + 1;
    i := i + 1;
  }
  return pos;
}

// Append n raw bytes from memory address src
pub fn pdfBytes(buf: int64, pos: int64, src: int64, n: int64): int64 {
  var i: int64 := 0;
  while (i < n) {
    poke8(buf + pos + i, peek8(src + i));
    i := i + 1;
  }
  return pos + n;
}

// Append decimal integer
pub fn pdfInt(buf: int64, pos: int64, v: int64): int64 {
  var vv: int64 := v;
  if (vv < 0) {
    poke8(buf + pos, 45); pos := pos + 1;
    vv := 0 - vv;
  }
  var s: pchar := IntToStr(vv);
  return pdfStr(buf, pos, s);
}

// Append zero-padded integer of exactly 'width' decimal digits
pub fn pdfIntPadded(buf: int64, pos: int64, v: int64, width: int64): int64 {
  var s: pchar := IntToStr(v);
  var slen: int64 := StrLen(s);
  var pad: int64 := width - slen;
  var i: int64 := 0;
  while (i < pad) {
    poke8(buf + pos, 48); pos := pos + 1; i := i + 1;
  }
  return pdfStr(buf, pos, s);
}

// Append signed real stored as int64 × 100; handles negative values correctly.
// pdfReal100 is broken for negative non-integer values (e.g. -3950 → "-39.-50").
pub fn pdfSignedReal100(buf: int64, pos: int64, v100: int64): int64 {
  if (v100 < 0) {
    poke8(buf + pos, 45); pos := pos + 1;
    v100 := 0 - v100;
  }
  return pdfReal100(buf, pos, v100);
}

// Append real stored as int64 × 100 (e.g. 59528 → "595.28", 61200 → "612")
pub fn pdfReal100(buf: int64, pos: int64, v100: int64): int64 {
  var ip: int64 := v100 / 100;
  var frac: int64 := v100 - ip * 100;
  pos := pdfInt(buf, pos, ip);
  if (frac != 0) {
    poke8(buf + pos, 46); pos := pos + 1;
    if (frac < 10) { poke8(buf + pos, 48); pos := pos + 1; }
    pos := pdfInt(buf, pos, frac);
  }
  return pos;
}

// f64 arithmetic (+,-,*,/) in Lyx operates on the IEEE 754 bit patterns as
// integers. Only comparisons and 'as int64' (MOVQ bit-cast) work correctly.
// These helpers extract numeric values from f64 using only integer operations
// on the raw IEEE bits.

// f64ToInt100: compute floor(v * 100 + 0.5) via IEEE bit manipulation.
// Works for positive v in the range expected for PDF dimensions (< 2^52).
pub fn f64ToInt100(v: f64): int64 {
  var bits: int64 := v as int64;
  bits := bits & 0x7FFFFFFFFFFFFFFF;   // absolute value (clear sign bit)
  if (bits == 0) { return 0; }
  var exp: int64 := ((bits >> 52) & 0x7FF) - 1023;
  // exp < -10 means v < ~0.001, so v*100 < 0.1, rounds to 0; also avoids
  // shift overflow in (1 << (shift-1)) since shift = 52-exp <= 62 when exp >= -10
  if (exp < -10) { return 0; }
  var mant: int64 := (bits & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
  if (exp >= 52) { return mant * 100 << (exp - 52); }
  var shift: int64 := 52 - exp;
  return (mant * 100 + (1 << (shift - 1))) >> shift;
}

// f64Trunc: extract integer part of a positive f64 via IEEE bit manipulation.
pub fn f64Trunc(v: f64): int64 {
  var bits: int64 := v as int64;
  if (bits == 0) { return 0; }
  var exp: int64 := ((bits >> 52) & 0x7FF) - 1023;
  if (exp < 0) { return 0; }
  var mant: int64 := (bits & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
  if (exp >= 52) { return mant << (exp - 52); }
  return mant >> (52 - exp);
}

// Append f64 value with up to 2 decimal places.
// Uses f64ToInt100 to avoid broken f64 arithmetic.
pub fn pdfReal(buf: int64, pos: int64, v: f64): int64 {
  if (v < 0.0) {
    poke8(buf + pos, 45); pos := pos + 1;
  }
  var v100: int64 := f64ToInt100(v);
  return pdfReal100(buf, pos, v100);
}

// Append "N 0 obj\n"
pub fn pdfObjHdr(buf: int64, pos: int64, id: int64): int64 {
  pos := pdfInt(buf, pos, id);
  return pdfStr(buf, pos, " 0 obj\n");
}

// Append "\nendobj\n"
pub fn pdfObjFtr(buf: int64, pos: int64): int64 {
  return pdfStr(buf, pos, "\nendobj\n");
}

// Append "N 0 R" (indirect reference)
pub fn pdfRef(buf: int64, pos: int64, id: int64): int64 {
  pos := pdfInt(buf, pos, id);
  return pdfStr(buf, pos, " 0 R");
}

// Append PDF literal string "(text)" with escaping of '(' ')' '\'
pub fn pdfLiteralStr(buf: int64, pos: int64, s: pchar): int64 {
  poke8(buf + pos, 40); pos := pos + 1;
  var i: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(s, i);
    if (c == 0) { break; }
    if (c == 40 || c == 41 || c == 92) {
      poke8(buf + pos, 92); pos := pos + 1;
    }
    poke8(buf + pos, c); pos := pos + 1;
    i := i + 1;
  }
  poke8(buf + pos, 41); pos := pos + 1;
  return pos;
}

// Append PDF Name "/name"
pub fn pdfName(buf: int64, pos: int64, name: pchar): int64 {
  poke8(buf + pos, 47); pos := pos + 1;
  return pdfStr(buf, pos, name);
}

// Return the PostScript name for a Standard-14 font index (0..13)
pub fn pdfFontName(idx: int64): pchar {
  if (idx == 0)  { return "Helvetica"; }
  if (idx == 1)  { return "Helvetica-Bold"; }
  if (idx == 2)  { return "Helvetica-Oblique"; }
  if (idx == 3)  { return "Helvetica-BoldOblique"; }
  if (idx == 4)  { return "Times-Roman"; }
  if (idx == 5)  { return "Times-Bold"; }
  if (idx == 6)  { return "Times-Italic"; }
  if (idx == 7)  { return "Times-BoldItalic"; }
  if (idx == 8)  { return "Courier"; }
  if (idx == 9)  { return "Courier-Bold"; }
  if (idx == 10) { return "Courier-Oblique"; }
  if (idx == 11) { return "Courier-BoldOblique"; }
  if (idx == 12) { return "Symbol"; }
  return "ZapfDingbats";
}

// Append one XRef entry: "OOOOOOOOOO GGGGG T\r\n" (exactly 20 bytes)
pub fn pdfXrefEntry(buf: int64, pos: int64, offset: int64, gen: int64, free: bool): int64 {
  pos := pdfIntPadded(buf, pos, offset, 10);
  poke8(buf + pos, 32); pos := pos + 1;
  pos := pdfIntPadded(buf, pos, gen, 5);
  poke8(buf + pos, 32); pos := pos + 1;
  if (free) {
    poke8(buf + pos, 102); pos := pos + 1;
  } else {
    poke8(buf + pos, 110); pos := pos + 1;
  }
  poke8(buf + pos, 13); pos := pos + 1;
  poke8(buf + pos, 10); pos := pos + 1;
  return pos;
}
