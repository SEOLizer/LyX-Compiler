unit std.pdf.fonts;

import std.pdf.objects;

// ============================================================================
// Standard-14 font index constants
// ============================================================================

pub con PDF_FONT_HELVETICA:            int64 := 0;
pub con PDF_FONT_HELVETICA_BOLD:       int64 := 1;
pub con PDF_FONT_HELVETICA_OBLIQUE:    int64 := 2;
pub con PDF_FONT_HELVETICA_BOLDOBLIQUE: int64 := 3;
pub con PDF_FONT_TIMES:                int64 := 4;
pub con PDF_FONT_TIMES_BOLD:           int64 := 5;
pub con PDF_FONT_TIMES_ITALIC:         int64 := 6;
pub con PDF_FONT_TIMES_BOLDITALIC:     int64 := 7;
pub con PDF_FONT_COURIER:              int64 := 8;
pub con PDF_FONT_COURIER_BOLD:         int64 := 9;
pub con PDF_FONT_COURIER_OBLIQUE:      int64 := 10;
pub con PDF_FONT_COURIER_BOLDOBLIQUE:  int64 := 11;
pub con PDF_FONT_SYMBOL:               int64 := 12;
pub con PDF_FONT_ZAPFDINGBATS:         int64 := 13;

// ============================================================================
// Helvetica AFM glyph widths (in 1/1000 of a point unit, per PDF spec)
// Used by PdfTextWidth.
// ============================================================================

fn helveticaWidth(c: int64): int64 {
  if (c == 32)  { return 278; }   // space
  if (c == 33)  { return 278; }   // !
  if (c == 34)  { return 355; }   // "
  if (c == 35)  { return 556; }   // #
  if (c == 36)  { return 556; }   // $
  if (c == 37)  { return 889; }   // %
  if (c == 38)  { return 667; }   // &
  if (c == 39)  { return 222; }   // '
  if (c == 40)  { return 333; }   // (
  if (c == 41)  { return 333; }   // )
  if (c == 42)  { return 389; }   // *
  if (c == 43)  { return 584; }   // +
  if (c == 44)  { return 278; }   // ,
  if (c == 45)  { return 333; }   // -
  if (c == 46)  { return 278; }   // .
  if (c == 47)  { return 278; }   // /
  if (c >= 48 && c <= 57) { return 556; }  // 0-9
  if (c == 58)  { return 278; }   // :
  if (c == 59)  { return 278; }   // ;
  if (c == 60)  { return 584; }   // <
  if (c == 61)  { return 584; }   // =
  if (c == 62)  { return 584; }   // >
  if (c == 63)  { return 556; }   // ?
  if (c == 64)  { return 1015; }  // @
  if (c == 65)  { return 667; }   // A
  if (c == 66)  { return 667; }   // B
  if (c == 67)  { return 722; }   // C
  if (c == 68)  { return 722; }   // D
  if (c == 69)  { return 667; }   // E
  if (c == 70)  { return 611; }   // F
  if (c == 71)  { return 778; }   // G
  if (c == 72)  { return 722; }   // H
  if (c == 73)  { return 278; }   // I
  if (c == 74)  { return 500; }   // J
  if (c == 75)  { return 667; }   // K
  if (c == 76)  { return 556; }   // L
  if (c == 77)  { return 833; }   // M
  if (c == 78)  { return 722; }   // N
  if (c == 79)  { return 778; }   // O
  if (c == 80)  { return 667; }   // P
  if (c == 81)  { return 778; }   // Q
  if (c == 82)  { return 722; }   // R
  if (c == 83)  { return 667; }   // S
  if (c == 84)  { return 611; }   // T
  if (c == 85)  { return 722; }   // U
  if (c == 86)  { return 667; }   // V
  if (c == 87)  { return 944; }   // W
  if (c == 88)  { return 667; }   // X
  if (c == 89)  { return 667; }   // Y
  if (c == 90)  { return 611; }   // Z
  if (c == 91)  { return 278; }   // [
  if (c == 92)  { return 278; }   // backslash
  if (c == 93)  { return 278; }   // ]
  if (c == 94)  { return 469; }   // ^
  if (c == 95)  { return 556; }   // _
  if (c == 96)  { return 222; }   // `
  if (c == 97)  { return 556; }   // a
  if (c == 98)  { return 556; }   // b
  if (c == 99)  { return 500; }   // c
  if (c == 100) { return 556; }   // d
  if (c == 101) { return 556; }   // e
  if (c == 102) { return 278; }   // f
  if (c == 103) { return 556; }   // g
  if (c == 104) { return 556; }   // h
  if (c == 105) { return 222; }   // i
  if (c == 106) { return 222; }   // j
  if (c == 107) { return 500; }   // k
  if (c == 108) { return 222; }   // l
  if (c == 109) { return 833; }   // m
  if (c == 110) { return 556; }   // n
  if (c == 111) { return 556; }   // o
  if (c == 112) { return 556; }   // p
  if (c == 113) { return 556; }   // q
  if (c == 114) { return 333; }   // r
  if (c == 115) { return 500; }   // s
  if (c == 116) { return 278; }   // t
  if (c == 117) { return 556; }   // u
  if (c == 118) { return 500; }   // v
  if (c == 119) { return 722; }   // w
  if (c == 120) { return 500; }   // x
  if (c == 121) { return 500; }   // y
  if (c == 122) { return 500; }   // z
  if (c == 123) { return 334; }   // {
  if (c == 124) { return 260; }   // |
  if (c == 125) { return 334; }   // }
  if (c == 126) { return 584; }   // ~
  return 556;  // default for unknown characters
}

// Courier is monospaced: all characters have width 600
fn courierWidth(c: int64): int64 {
  return 600;
}

// ============================================================================
// PdfCharWidth — return AFM width of character c for the given font (in 1/1000 pt)
// ============================================================================

pub fn PdfCharWidth(fontId: int64, c: int64): int64 {
  // Courier family: monospaced
  if (fontId == 8 || fontId == 9 || fontId == 10 || fontId == 11) {
    return courierWidth(c);
  }
  // Helvetica family: use AFM table
  if (fontId == 0 || fontId == 1 || fontId == 2 || fontId == 3) {
    return helveticaWidth(c);
  }
  // Times family: approximate with Helvetica metrics
  return helveticaWidth(c);
}

// ============================================================================
// PdfTextWidth — compute text width in points for given font and size
// Returns width as f64 (via CVTSI2SD from integer calculation)
// ============================================================================

pub fn PdfTextWidth(doc: int64, fontId: int64, size: f64, text: pchar): f64 {
  var sumMilli: int64 := 0;
  var i: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(text, i);
    if (c == 0) { break; }
    sumMilli := sumMilli + PdfCharWidth(fontId, c);
    i := i + 1;
  }
  // width_pt = sumMilli * size / 1000
  // Use integer arithmetic: size100 = f64ToInt100(size), size = size100 / 100
  // width_pt × 100 = sumMilli * size100 / 1000
  var size100: int64 := f64ToInt100(size);
  var width100: int64 := sumMilli * size100 / 1000;
  // Convert to f64 using numeric CVTSI2SD then divide by 100
  // Since f64 division is broken, return width100 / 100 as integer cast to f64
  var widthPt: int64 := width100 / 100;
  return widthPt as f64;
}
