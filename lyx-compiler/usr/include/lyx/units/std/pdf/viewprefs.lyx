// std/pdf/viewprefs.lyx
// PDF viewer preferences: page mode, layout, open action — WP-PDF-13

@description("PDF viewer preferences: PdfSetViewerFlags, PdfSetOpenAction")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, fs.write])
unit std.pdf.viewprefs;

import std.pdf.builder;

// Set viewer preference flags (OR together PDF_VIEW_* constants).
// Replaces any previously set flags.
pub fn PdfSetViewerFlags(doc: int64, flags: int64): void {
  if (doc == 0) { return; }
  poke64(doc + PDF_DOC_VIEWFLAGS, flags);
}

// Set the page that the viewer opens to (0-based index).
// Automatically sets the PDF_VIEW_OPEN_ACTION flag.
pub fn PdfSetOpenAction(doc: int64, pageIdx: int64): void {
  if (doc == 0) { return; }
  poke64(doc + PDF_DOC_VIEWOPENPAGE, pageIdx);
  var flags: int64 := peek64(doc + PDF_DOC_VIEWFLAGS);
  poke64(doc + PDF_DOC_VIEWFLAGS, flags | PDF_VIEW_OPEN_ACTION);
}
