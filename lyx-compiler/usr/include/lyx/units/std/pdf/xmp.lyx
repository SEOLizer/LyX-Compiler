// std/pdf/xmp.lyx
// XMP metadata stream for PDF (WP-PDF-26)
// Embeds an /Metadata XMP stream in the Catalog.

@description("XMP metadata: PdfSetXMP, PdfGenerateXMP")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, fs.write])
unit std.pdf.xmp;

import std.alloc;
import std.pdf.builder;

// ============================================================================
// Internal: write a NUL-terminated string to a buffer, returning new position
// ============================================================================

fn _xmpStr(buf: int64, pos: int64, s: pchar): int64 {
  var i: int64 := 0;
  while (1 == 1) {
    var c: int64 := StrCharAt(s, i);
    if (c == 0) { break; }
    poke8(buf + pos, c); pos := pos + 1;
    i += 1;
  }
  return pos;
}

// Write a metadata field value, escaping XML special chars (& < > " ')
fn _xmpField(buf: int64, pos: int64, src: int64, maxLen: int64): int64 {
  var i: int64 := 0;
  while (i < maxLen) {
    var c: int64 := peek8(src + i);
    if (c == 0) { break; }
    if (c == 38) {       // & → &amp;
      pos := _xmpStr(buf, pos, "&amp;"c);
    } else if (c == 60) { // < → &lt;
      pos := _xmpStr(buf, pos, "&lt;"c);
    } else if (c == 62) { // > → &gt;
      pos := _xmpStr(buf, pos, "&gt;"c);
    } else if (c == 34) { // " → &quot;
      pos := _xmpStr(buf, pos, "&quot;"c);
    } else {
      poke8(buf + pos, c); pos := pos + 1;
    }
    i += 1;
  }
  return pos;
}

// ============================================================================
// PdfSetXMP — store a raw XMP XML blob (replaces any previously set XMP)
//
// xmpXml: pointer to UTF-8 encoded XMP XML bytes
// len:    byte count (without NUL terminator)
// The bytes are copied into a mmap'd buffer owned by the doc.
// ============================================================================

pub fn PdfSetXMP(doc: int64, xmpXml: int64, len: int64): void {
  if (doc == 0 || xmpXml == 0 || len <= 0) { return; }
  // Free previous XMP data
  var old:    int64 := peek64(doc + PDF_DOC_XMPDATAPTR);
  var oldLen: int64 := peek64(doc + PDF_DOC_XMPDATALEN);
  if (old != 0 && oldLen > 0) { free(old, oldLen); }
  // Copy new data
  var buf: int64 := alloc(len);
  if (buf == 0) { return; }
  var i: int64 := 0;
  while (i < len) { poke8(buf + i, peek8(xmpXml + i)); i := i + 1; }
  poke64(doc + PDF_DOC_XMPDATAPTR, buf);
  poke64(doc + PDF_DOC_XMPDATALEN, len);
  // Allocate PDF object ID if not already done
  if (peek64(doc + PDF_DOC_XMPOBJID) == 0) {
    var oid: int64 := peek64(doc + PDF_DOC_NEXTID);
    poke64(doc + PDF_DOC_NEXTID, oid + 1);
    poke64(doc + PDF_DOC_XMPOBJID, oid);
  }
}

// ============================================================================
// PdfGenerateXMP — auto-generate XMP from the document's /Info metadata
//
// Reads title, author, subject, keywords, creator, producer from the doc
// block and builds a well-formed XMP packet. Equivalent to calling PdfSetXMP
// with the generated bytes.
//
// Call before PdfSave. Re-calling regenerates the XMP (useful if metadata
// was updated after a previous call).
// ============================================================================

pub fn PdfGenerateXMP(doc: int64): void {
  if (doc == 0) { return; }

  var title:    int64 := doc + PDF_DOC_META_TITLE;
  var author:   int64 := doc + PDF_DOC_META_AUTHOR;
  var subject:  int64 := doc + PDF_DOC_META_SUBJECT;
  var keywords: int64 := doc + PDF_DOC_META_KEYWORDS;
  var creator:  int64 := doc + PDF_DOC_META_CREATOR;
  var producer: int64 := doc + PDF_DOC_META_PRODUCER;

  // Allocate a generous buffer for the XMP XML
  var bufCap: int64 := 8192;
  var buf:    int64 := alloc(bufCap);
  if (buf == 0) { return; }
  var pos: int64 := 0;

  // XMP packet header
  pos := _xmpStr(buf, pos, "<?xpacket begin=\"\xEF\xBB\xBF\" id=\"W5M0MpCehiHzreSzNTczkc9d\"?>\n"c);
  pos := _xmpStr(buf, pos, "<x:xmpmeta xmlns:x=\"adobe:ns:meta/\">\n"c);
  pos := _xmpStr(buf, pos, " <rdf:RDF xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\">\n"c);
  pos := _xmpStr(buf, pos, "  <rdf:Description rdf:about=\"\"\n"c);
  pos := _xmpStr(buf, pos, "    xmlns:dc=\"http://purl.org/dc/elements/1.1/\"\n"c);
  pos := _xmpStr(buf, pos, "    xmlns:xmp=\"http://ns.adobe.com/xap/1.0/\"\n"c);
  var conformance: int64 := peek64(doc + PDF_DOC_CONFORMANCE);
  if (conformance != 0) {
    pos := _xmpStr(buf, pos, "    xmlns:pdf=\"http://ns.adobe.com/pdf/1.3/\"\n"c);
    pos := _xmpStr(buf, pos, "    xmlns:pdfaid=\"http://www.aiim.org/pdfa/ns/id/\">\n"c);
  } else {
    pos := _xmpStr(buf, pos, "    xmlns:pdf=\"http://ns.adobe.com/pdf/1.3/\">\n"c);
  }

  // dc:title
  if (peek8(title) != 0) {
    pos := _xmpStr(buf, pos, "   <dc:title><rdf:Alt><rdf:li xml:lang=\"x-default\">"c);
    pos := _xmpField(buf, pos, title, 256);
    pos := _xmpStr(buf, pos, "</rdf:li></rdf:Alt></dc:title>\n"c);
  }

  // dc:creator (author)
  if (peek8(author) != 0) {
    pos := _xmpStr(buf, pos, "   <dc:creator><rdf:Seq><rdf:li>"c);
    pos := _xmpField(buf, pos, author, 256);
    pos := _xmpStr(buf, pos, "</rdf:li></rdf:Seq></dc:creator>\n"c);
  }

  // dc:description (subject)
  if (peek8(subject) != 0) {
    pos := _xmpStr(buf, pos, "   <dc:description><rdf:Alt><rdf:li xml:lang=\"x-default\">"c);
    pos := _xmpField(buf, pos, subject, 256);
    pos := _xmpStr(buf, pos, "</rdf:li></rdf:Alt></dc:description>\n"c);
  }

  // dc:subject (keywords — split by comma or space)
  if (peek8(keywords) != 0) {
    pos := _xmpStr(buf, pos, "   <dc:subject><rdf:Bag>"c);
    // Emit the keywords as a single bag entry (simple approach)
    pos := _xmpStr(buf, pos, "<rdf:li>"c);
    pos := _xmpField(buf, pos, keywords, 256);
    pos := _xmpStr(buf, pos, "</rdf:li>"c);
    pos := _xmpStr(buf, pos, "</rdf:Bag></dc:subject>\n"c);
  }

  // xmp:CreatorTool (creator application)
  if (peek8(creator) != 0) {
    pos := _xmpStr(buf, pos, "   <xmp:CreatorTool>"c);
    pos := _xmpField(buf, pos, creator, 128);
    pos := _xmpStr(buf, pos, "</xmp:CreatorTool>\n"c);
  }

  // pdf:Producer
  if (peek8(producer) != 0) {
    pos := _xmpStr(buf, pos, "   <pdf:Producer>"c);
    pos := _xmpField(buf, pos, producer, 128);
    pos := _xmpStr(buf, pos, "</pdf:Producer>\n"c);
  }

  // pdfaid conformance tags (WP-PDF-27 PDF/A)
  if (conformance != 0) {
    pos := _xmpStr(buf, pos, "   <pdfaid:part>"c);
    if (conformance == 1) { pos := _xmpStr(buf, pos, "1"c); }
    else if (conformance == 2) { pos := _xmpStr(buf, pos, "2"c); }
    else { pos := _xmpStr(buf, pos, "3"c); }
    pos := _xmpStr(buf, pos, "</pdfaid:part>\n"c);
    pos := _xmpStr(buf, pos, "   <pdfaid:conformance>B</pdfaid:conformance>\n"c);
  }

  // Close tags
  pos := _xmpStr(buf, pos, "  </rdf:Description>\n"c);
  pos := _xmpStr(buf, pos, " </rdf:RDF>\n"c);
  pos := _xmpStr(buf, pos, "</x:xmpmeta>\n"c);
  pos := _xmpStr(buf, pos, "<?xpacket end=\"w\"?>"c);

  // Store via PdfSetXMP (copies the buffer)
  PdfSetXMP(doc, buf, pos);
  free(buf, bufCap);
}
