// std/validate/de_numbers.lyx
// German business/factual numbers: PZN, WKN, GND, Zählpunktbezeichnung

@description("German business IDs: DEPZNValidate, DEWKNValidate, DEGNDValidate, DEMeterIDValidate")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.de_numbers;

import std.alloc;
// --- Error codes ---

pub con DE_PZN_OK:          int64 := 0;
pub con DE_PZN_ERR_LENGTH:  int64 := 1;
pub con DE_PZN_ERR_CHAR:    int64 := 2;
pub con DE_PZN_ERR_CHECK:   int64 := 3;

pub con DE_WKN_OK:          int64 := 0;
pub con DE_WKN_ERR_LENGTH:  int64 := 1;
pub con DE_WKN_ERR_CHAR:    int64 := 2;
pub con DE_WKN_ERR_CHECK:   int64 := 3;

pub con DE_GND_OK:          int64 := 0;
pub con DE_GND_ERR_LENGTH:  int64 := 1;
pub con DE_GND_ERR_CHAR:    int64 := 2;
pub con DE_GND_ERR_CHECK:   int64 := 3;

pub con DE_METERID_OK:              int64 := 0;
pub con DE_METERID_ERR_LENGTH:      int64 := 1;
pub con DE_METERID_ERR_COUNTRY:     int64 := 2;
pub con DE_METERID_ERR_CHECK:       int64 := 3;

// --- Private helpers ---

fn _dnStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _dnIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

fn _dnIsAlphaNum(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  if (c >= 65 && c <= 90) { return 1; }
  if (c >= 97 && c <= 122) { return 1; }
  return 0;
}

fn _dnToUpper(c: int64): int64 {
  if (c >= 97 && c <= 122) { return c - 32; }
  return c;
}

// Alphanumeric value: '0'-'9'=0-9, 'A'-'Z'=10-35
fn _dnAlphaVal(c: int64): int64 {
  var u: int64 := _dnToUpper(c);
  if (u >= 48 && u <= 57) { return u - 48; }
  if (u >= 65 && u <= 90) { return u - 55; }
  return -1;
}

// =============================================================
//  2.1  Pharmazentralnummer (PZN)
// =============================================================

// Normalize a PZN to 8 digits (pad with leading zero if 7 digits).
// out_buf must hold at least 9 bytes. Returns 0 on success, -1 on error.
pub fn DEPZNNormalize(pzn: int64, out_buf: int64): int64 {
  if (out_buf == 0) { return -1; }
  var len: int64 := _dnStrLen(pzn);
  if (len < 7 || len > 8) { return -1; }
  if (len == 7) {
    poke8(out_buf + 0, 48);
    var i: int64 := 0;
    while (i < 7) { poke8(out_buf + 1 + i, peek8(pzn + i)); i := i + 1; }
    poke8(out_buf + 8, 0);
  } else {
    var i: int64 := 0;
    while (i < 8) { poke8(out_buf + i, peek8(pzn + i)); i := i + 1; }
    poke8(out_buf + 8, 0);
  }
  return 0;
}

// Compute PZN check digit for a normalized 8-digit PZN (uses first 7 digits).
// Weights: 2 3 4 5 6 7. Mod 11; rest 11 → invalid (-2); rest 10 → 0.
// Returns check digit (0–9), -1 on invalid chars, -2 if rest==11.
pub fn DEPZNCheckDigit(pzn: int64): int64 {
  var buf: int64 := alloc(10);
  if (buf == 0) { return -1; }
  if (DEPZNNormalize(pzn, buf) != 0) { free(buf, 10); return -1; }
  var weights: int64[6];
  // weights as local vars since Lyx has no local array literals for this
  var w0: int64 := 2; var w1: int64 := 3; var w2: int64 := 4;
  var w3: int64 := 5; var w4: int64 := 6; var w5: int64 := 7;
  var sum: int64 := 0;
  var d: int64 := 0;
  d := peek8(buf + 0) - 48; if (d < 0 || d > 9) { free(buf, 10); return -1; } sum := sum + d * w0;
  d := peek8(buf + 1) - 48; if (d < 0 || d > 9) { free(buf, 10); return -1; } sum := sum + d * w1;
  d := peek8(buf + 2) - 48; if (d < 0 || d > 9) { free(buf, 10); return -1; } sum := sum + d * w2;
  d := peek8(buf + 3) - 48; if (d < 0 || d > 9) { free(buf, 10); return -1; } sum := sum + d * w3;
  d := peek8(buf + 4) - 48; if (d < 0 || d > 9) { free(buf, 10); return -1; } sum := sum + d * w4;
  d := peek8(buf + 5) - 48; if (d < 0 || d > 9) { free(buf, 10); return -1; } sum := sum + d * w5;
  free(buf, 10);
  var rest: int64 := sum - (sum / 11) * 11;
  if (rest == 11) { return -2; }
  if (rest == 10) { return 0; }
  return rest;
}

// Validate a 7- or 8-digit PZN.
pub fn DEPZNValidate(pzn: int64): int64 {
  var len: int64 := _dnStrLen(pzn);
  if (len < 7 || len > 8) { return DE_PZN_ERR_LENGTH; }
  var i: int64 := 0;
  while (i < len) {
    if (_dnIsDigit(peek8(pzn + i)) == 0) { return DE_PZN_ERR_CHAR; }
    i := i + 1;
  }
  var cd: int64 := DEPZNCheckDigit(pzn);
  if (cd < 0) { return DE_PZN_ERR_CHECK; }
  var buf: int64 := alloc(10);
  if (buf == 0) { return DE_PZN_ERR_CHECK; }
  DEPZNNormalize(pzn, buf);
  var actual: int64 := peek8(buf + 7) - 48;
  free(buf, 10);
  if (cd != actual) { return DE_PZN_ERR_CHECK; }
  return DE_PZN_OK;
}

// =============================================================
//  2.2  Wertpapierkennnummer (WKN)
// =============================================================

// Compute WKN check digit for a 6-character alphanumeric WKN.
// Letters A–Z → 10–35; weights alternate 2 1 2 1 2 1; cross-sum if product > 9.
// Checkdigit = (10 - (sum mod 10)) mod 10.
pub fn DEWKNCheckDigit(wkn: int64): int64 {
  if (_dnStrLen(wkn) != 6) { return -1; }
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < 6) {
    var v: int64 := _dnAlphaVal(peek8(wkn + i));
    if (v < 0) { return -1; }
    var w: int64 := 0;
    if (i - (i / 2) * 2 == 0) { w := 2; } else { w := 1; }
    var p: int64 := v * w;
    if (p > 9) { p := (p / 10) + (p - (p / 10) * 10); }
    sum := sum + p;
    i := i + 1;
  }
  var r: int64 := sum - (sum / 10) * 10;
  return (10 - r) - ((10 - r) / 10) * 10;
}

// Validate a 7-character WKN (6 alphanumeric + 1 check digit).
pub fn DEWKNValidate(wkn: int64): int64 {
  if (_dnStrLen(wkn) != 7) { return DE_WKN_ERR_LENGTH; }
  var i: int64 := 0;
  while (i < 6) {
    if (_dnAlphaVal(peek8(wkn + i)) < 0) { return DE_WKN_ERR_CHAR; }
    i := i + 1;
  }
  var cd: int64 := DEWKNCheckDigit(wkn);
  if (cd < 0) { return DE_WKN_ERR_CHECK; }
  var actual: int64 := peek8(wkn + 6) - 48;
  if (actual < 0 || actual > 9) { return DE_WKN_ERR_CHAR; }
  if (cd != actual) { return DE_WKN_ERR_CHECK; }
  return DE_WKN_OK;
}

// =============================================================
//  2.3  GND-Nummer (Gemeinsame Normdatei)
// =============================================================

// Compute GND check character for a numeric string (up to 9 digits, without check char).
// Weights: 9 8 7 6 5 4 3 2 1. Rest 10 → 'X' (88), rest 0 → '0' (48).
// Returns ASCII character of check digit, or -1 on error.
pub fn DEGNDCheckDigit(gnd: int64): int64 {
  var len: int64 := _dnStrLen(gnd);
  // Strip trailing check char if present (X or digit)
  var useLen: int64 := len;
  if (len >= 2) {
    var last: int64 := _dnToUpper(peek8(gnd + len - 1));
    if (last == 88 || (last >= 48 && last <= 57)) { useLen := len - 1; }
  }
  if (useLen < 1 || useLen > 9) { return -1; }
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < useLen) {
    var c: int64 := peek8(gnd + i);
    if (_dnIsDigit(c) == 0) { return -1; }
    var w: int64 := 9 - i;
    sum := sum + (c - 48) * w;
    i := i + 1;
  }
  var rest: int64 := sum - (sum / 11) * 11;
  if (rest == 0) { return 48; }        // '0'
  if (rest == 1) { return -1; }        // invalid GND
  if (rest == 10) { return 88; }       // 'X'
  return (11 - rest) + 48;             // '1'..'9'
}

// Validate a GND-Nummer (up to 10 chars: 1–9 digits + check char 0–9 or X).
pub fn DEGNDValidate(gnd: int64): int64 {
  var len: int64 := _dnStrLen(gnd);
  if (len < 2 || len > 10) { return DE_GND_ERR_LENGTH; }
  var i: int64 := 0;
  while (i < len - 1) {
    if (_dnIsDigit(peek8(gnd + i)) == 0) { return DE_GND_ERR_CHAR; }
    i := i + 1;
  }
  var lastC: int64 := _dnToUpper(peek8(gnd + len - 1));
  if (lastC != 88 && (_dnIsDigit(lastC) == 0)) { return DE_GND_ERR_CHAR; }
  var expected: int64 := DEGNDCheckDigit(gnd);
  if (expected < 0) { return DE_GND_ERR_CHECK; }
  if (expected != lastC) { return DE_GND_ERR_CHECK; }
  return DE_GND_OK;
}

// =============================================================
//  2.4  Zählpunktbezeichnung (Stromzähler, 33 Zeichen)
// =============================================================

// Extract the 10-character network operator code from a meter ID into out_buf.
// out_buf must hold at least 11 bytes. Returns 0 on success, -1 on error.
pub fn DEMeterIDGetOperator(id: int64, out_buf: int64): int64 {
  if (_dnStrLen(id) != 33) { return -1; }
  if (out_buf == 0) { return -1; }
  var i: int64 := 0;
  while (i < 10) {
    poke8(out_buf + i, peek8(id + 2 + i));
    i := i + 1;
  }
  poke8(out_buf + 10, 0);
  return 0;
}

// Validate a 33-character Zählpunktbezeichnung.
// Chars 0–1: country code 'DE'; chars 2–11: operator (alphanumeric); chars 12–31: point ID; char 32: checkdigit.
// Check: Mod 10 over all 32 positions (letters via ordinal A=10..Z=35, digits face value), then (10 - sum%10)%10.
pub fn DEMeterIDValidate(id: int64): int64 {
  if (_dnStrLen(id) != 33) { return DE_METERID_ERR_LENGTH; }
  // Country code must be 'DE'
  if (_dnToUpper(peek8(id))     != 68) { return DE_METERID_ERR_COUNTRY; }  // D
  if (_dnToUpper(peek8(id + 1)) != 69) { return DE_METERID_ERR_COUNTRY; }  // E
  // Compute check over positions 0..31
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < 32) {
    var c: int64 := _dnToUpper(peek8(id + i));
    var v: int64 := 0;
    if (c >= 48 && c <= 57) { v := c - 48; }
    else if (c >= 65 && c <= 90) { v := c - 55; }
    else { return DE_METERID_ERR_CHECK; }
    sum := sum + v;
    i := i + 1;
  }
  var expected: int64 := (10 - (sum - (sum / 10) * 10)) - ((10 - (sum - (sum / 10) * 10)) / 10) * 10;
  var actual: int64 := _dnToUpper(peek8(id + 32));
  var actualVal: int64 := 0;
  if (actual >= 48 && actual <= 57) { actualVal := actual - 48; }
  else { return DE_METERID_ERR_CHECK; }
  if (expected != actualVal) { return DE_METERID_ERR_CHECK; }
  return DE_METERID_OK;
}
