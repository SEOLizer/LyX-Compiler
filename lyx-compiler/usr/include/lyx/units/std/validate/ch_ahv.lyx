// std/validate/ch_ahv.lyx
// Swiss AHV number (Sozialversicherungsnummer) — EAN-13 profile, prefix 756

@description("Swiss AHV number: CHAHVValidate, CHAHVCheckDigit, CHAHVNormalize")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.ch_ahv;

import std.alloc;
pub con CH_AHV_OK:            int64 := 0;
pub con CH_AHV_ERR_LENGTH:    int64 := 1;
pub con CH_AHV_ERR_PREFIX:    int64 := 2;
pub con CH_AHV_ERR_CHECK:     int64 := 3;

fn _ahvStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _ahvIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

// Normalize: strip dots and spaces. out_buf needs at least 14 bytes.
pub fn CHAHVNormalize(ahv: int64, out_buf: int64): int64 {
  if (out_buf == 0) { return -1; }
  var pos: int64 := 0;
  var i: int64 := 0;
  var len: int64 := _ahvStrLen(ahv);
  while (i < len && pos < 13) {
    var c: int64 := peek8(ahv + i);
    if (c != 32 && c != 46 && c != 45) {
      poke8(out_buf + pos, c); pos := pos + 1;
    }
    i := i + 1;
  }
  poke8(out_buf + pos, 0);
  return 0;
}

// Compute AHV check digit (EAN-13 weights: 1 3 1 3 ... for 12 digits).
// Returns 0–9 or -1 on error.
pub fn CHAHVCheckDigit(ahv: int64): int64 {
  var buf: int64 := alloc(15);
  if (buf == 0) { return -1; }
  CHAHVNormalize(ahv, buf);
  if (_ahvStrLen(buf) < 12) { free(buf, 15); return -1; }
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < 12) {
    var d: int64 := peek8(buf + i) - 48;
    if (d < 0 || d > 9) { free(buf, 15); return -1; }
    var w: int64 := 0;
    if (i - (i / 2) * 2 == 0) { w := 1; } else { w := 3; }
    sum := sum + d * w;
    i := i + 1;
  }
  free(buf, 15);
  var r: int64 := sum - (sum / 10) * 10;
  return (10 - r) - ((10 - r) / 10) * 10;
}

// Validate a 13-digit Swiss AHV number. Must start with 756 (ISO country code for CH).
pub fn CHAHVValidate(ahv: int64): int64 {
  var buf: int64 := alloc(15);
  if (buf == 0) { return CH_AHV_ERR_CHECK; }
  CHAHVNormalize(ahv, buf);
  if (_ahvStrLen(buf) != 13) { free(buf, 15); return CH_AHV_ERR_LENGTH; }
  // Prefix must be 756
  if (peek8(buf) != 55 || peek8(buf + 1) != 53 || peek8(buf + 2) != 54) {
    free(buf, 15); return CH_AHV_ERR_PREFIX;
  }
  var i: int64 := 0;
  while (i < 13) {
    if (_ahvIsDigit(peek8(buf + i)) == 0) { free(buf, 15); return CH_AHV_ERR_LENGTH; }
    i := i + 1;
  }
  var expected: int64 := CHAHVCheckDigit(buf);
  var actual: int64 := peek8(buf + 12) - 48;
  free(buf, 15);
  if (expected < 0) { return CH_AHV_ERR_CHECK; }
  if (expected != actual) { return CH_AHV_ERR_CHECK; }
  return CH_AHV_OK;
}
