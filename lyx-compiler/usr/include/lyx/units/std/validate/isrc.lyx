// std/validate/isrc.lyx
// International Standard Recording Code — ISO 3901

@description("ISRC validation: ISRCValidate, ISRCNormalize, ISRCGetCountry, ISRCGetYear")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.isrc;

import std.alloc;
pub con ISRC_OK:            int64 := 0;
pub con ISRC_ERR_LENGTH:    int64 := 1;
pub con ISRC_ERR_COUNTRY:   int64 := 2;
pub con ISRC_ERR_CHAR:      int64 := 3;

fn _isrcStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _isrcToUpper(c: int64): int64 {
  if (c >= 97 && c <= 122) { return c - 32; }
  return c;
}

fn _isrcIsUpper(c: int64): int64 {
  if (c >= 65 && c <= 90) { return 1; }
  return 0;
}

fn _isrcIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

fn _isrcIsAlphaNum(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  if (c >= 65 && c <= 90) { return 1; }
  return 0;
}

// Normalize: strip hyphens and spaces, uppercase. out_buf needs at least 13 bytes.
pub fn ISRCNormalize(isrc: int64, out_buf: int64): int64 {
  if (out_buf == 0) { return -1; }
  var pos: int64 := 0;
  var i: int64 := 0;
  var len: int64 := _isrcStrLen(isrc);
  while (i < len && pos < 12) {
    var c: int64 := peek8(isrc + i);
    if (c != 32 && c != 45) {
      poke8(out_buf + pos, _isrcToUpper(c)); pos := pos + 1;
    }
    i := i + 1;
  }
  poke8(out_buf + pos, 0);
  return 0;
}

// Validate a 12-character ISRC (CC-XXX-YY-NNNNN without hyphens).
pub fn ISRCValidate(isrc: int64): int64 {
  var buf: int64 := alloc(14);
  if (buf == 0) { return ISRC_ERR_LENGTH; }
  ISRCNormalize(isrc, buf);
  if (_isrcStrLen(buf) != 12) { free(buf, 14); return ISRC_ERR_LENGTH; }

  // CC: positions 0-1 — uppercase letters (country code)
  if (_isrcIsUpper(peek8(buf))     == 0) { free(buf, 14); return ISRC_ERR_COUNTRY; }
  if (_isrcIsUpper(peek8(buf + 1)) == 0) { free(buf, 14); return ISRC_ERR_COUNTRY; }

  // XXX: positions 2-4 — alphanumeric registrant
  var i: int64 := 2;
  while (i < 5) {
    if (_isrcIsAlphaNum(peek8(buf + i)) == 0) { free(buf, 14); return ISRC_ERR_CHAR; }
    i := i + 1;
  }

  // YY: positions 5-6 — 2-digit year
  if (_isrcIsDigit(peek8(buf + 5)) == 0 || _isrcIsDigit(peek8(buf + 6)) == 0) {
    free(buf, 14); return ISRC_ERR_CHAR;
  }

  // NNNNN: positions 7-11 — 5-digit serial
  i := 7;
  while (i < 12) {
    if (_isrcIsDigit(peek8(buf + i)) == 0) { free(buf, 14); return ISRC_ERR_CHAR; }
    i := i + 1;
  }
  free(buf, 14);
  return ISRC_OK;
}

// Copy 2-character country code into out_buf (needs 3 bytes).
pub fn ISRCGetCountry(isrc: int64, out_buf: int64): int64 {
  if (out_buf == 0) { return -1; }
  var buf: int64 := alloc(14);
  if (buf == 0) { return -1; }
  ISRCNormalize(isrc, buf);
  if (_isrcStrLen(buf) < 2) { free(buf, 14); return -1; }
  poke8(out_buf + 0, peek8(buf));
  poke8(out_buf + 1, peek8(buf + 1));
  poke8(out_buf + 2, 0);
  free(buf, 14);
  return 0;
}

// Return recording year (0–99) from a valid ISRC, or -1 on error.
pub fn ISRCGetYear(isrc: int64): int64 {
  var buf: int64 := alloc(14);
  if (buf == 0) { return -1; }
  ISRCNormalize(isrc, buf);
  if (_isrcStrLen(buf) < 7) { free(buf, 14); return -1; }
  var y0: int64 := peek8(buf + 5) - 48;
  var y1: int64 := peek8(buf + 6) - 48;
  free(buf, 14);
  if (y0 < 0 || y0 > 9 || y1 < 0 || y1 > 9) { return -1; }
  return y0 * 10 + y1;
}
