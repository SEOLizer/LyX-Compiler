// std/validate/ismn.lyx
// International Standard Music Number — ISO 10957

@description("ISMN validation: ISMNValidate, ISMNCheckDigit, ISMNNormalize")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.ismn;

import std.alloc;
pub con ISMN_OK:             int64 := 0;
pub con ISMN_ERR_LENGTH:     int64 := 1;
pub con ISMN_ERR_PREFIX:     int64 := 2;
pub con ISMN_ERR_CHECK:      int64 := 3;

fn _ismnStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _ismnIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

// Normalize: strip hyphens and spaces. out_buf needs at least 14 bytes.
pub fn ISMNNormalize(ismn: int64, out_buf: int64): int64 {
  if (out_buf == 0) { return -1; }
  var pos: int64 := 0;
  var i: int64 := 0;
  var len: int64 := _ismnStrLen(ismn);
  while (i < len && pos < 13) {
    var c: int64 := peek8(ismn + i);
    if (c != 32 && c != 45) {
      poke8(out_buf + pos, c); pos := pos + 1;
    }
    i += 1;
  }
  poke8(out_buf + pos, 0);
  return 0;
}

// Compute ISMN check digit (EAN-13 profile) for the first 12 digits.
// Weights: 1 3 1 3 1 3 1 3 1 3 1 3. Checkdigit = (10 - sum%10)%10.
pub fn ISMNCheckDigit(ismn: int64): int64 {
  var buf: int64 := alloc(15);
  if (buf == 0) { return -1; }
  ISMNNormalize(ismn, buf);
  if (_ismnStrLen(buf) < 12) { free(buf, 15); return -1; }
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < 12) {
    var d: int64 := peek8(buf + i) - 48;
    if (d < 0 || d > 9) { free(buf, 15); return -1; }
    var w: int64 := 0;
    if (i - (i / 2) * 2 == 0) { w := 1; } else { w := 3; }
    sum := sum + d * w;
    i += 1;
  }
  free(buf, 15);
  var r: int64 := sum - (sum / 10) * 10;
  return (10 - r) - ((10 - r) / 10) * 10;
}

// Validate a 13-digit ISMN. Must start with prefix 9790.
pub fn ISMNValidate(ismn: int64): int64 {
  var buf: int64 := alloc(15);
  if (buf == 0) { return ISMN_ERR_CHECK; }
  ISMNNormalize(ismn, buf);
  if (_ismnStrLen(buf) != 13) { free(buf, 15); return ISMN_ERR_LENGTH; }
  // Check prefix 9790
  if (peek8(buf)     != 57 || peek8(buf + 1) != 55 ||
      peek8(buf + 2) != 57 || peek8(buf + 3) != 48) {
    free(buf, 15); return ISMN_ERR_PREFIX;
  }
  var i: int64 := 0;
  while (i < 13) {
    if (_ismnIsDigit(peek8(buf + i)) == 0) { free(buf, 15); return ISMN_ERR_LENGTH; }
    i += 1;
  }
  var expected: int64 := ISMNCheckDigit(buf);
  var actual: int64 := peek8(buf + 12) - 48;
  free(buf, 15);
  if (expected < 0) { return ISMN_ERR_CHECK; }
  if (expected != actual) { return ISMN_ERR_CHECK; }
  return ISMN_OK;
}
