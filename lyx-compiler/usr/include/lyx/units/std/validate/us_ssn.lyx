// std/validate/us_ssn.lyx
// US Social Security Number — structural validation (no check digit)

@description("SSN validation: USSSNValidate, USSSNNormalize, USSSNGetArea")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.us_ssn;

pub con US_SSN_OK:                  int64 := 0;
pub con US_SSN_ERR_LENGTH:          int64 := 1;
pub con US_SSN_ERR_CHAR:            int64 := 2;
pub con US_SSN_ERR_AREA:            int64 := 3;
pub con US_SSN_ERR_GROUP:           int64 := 4;
pub con US_SSN_ERR_SERIAL:          int64 := 5;
pub con US_SSN_ERR_KNOWN_INVALID:   int64 := 6;

fn _ssnStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _ssnIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

// Normalize: strip hyphens and spaces. out_buf needs at least 10 bytes.
pub fn USSSNNormalize(ssn: int64, out_buf: int64): int64 {
  if (out_buf == 0) { return -1; }
  var pos: int64 := 0;
  var i: int64 := 0;
  var len: int64 := _ssnStrLen(ssn);
  while (i < len && pos < 9) {
    var c: int64 := peek8(ssn + i);
    if (c != 32 && c != 45) {
      poke8(out_buf + pos, c); pos := pos + 1;
    }
    i := i + 1;
  }
  poke8(out_buf + pos, 0);
  return 0;
}

// Return the 3-digit area number (001–899) from a normalized SSN, or -1 on error.
pub fn USSSNGetArea(ssn: int64): int64 {
  var buf: int64 := mmap(0, 11, 3, 34, -1, 0);
  if (buf == 0) { return -1; }
  USSSNNormalize(ssn, buf);
  if (_ssnStrLen(buf) < 3) { munmap(buf, 11); return -1; }
  var a: int64 := (peek8(buf) - 48) * 100 + (peek8(buf + 1) - 48) * 10 + (peek8(buf + 2) - 48);
  munmap(buf, 11);
  return a;
}

// Validate a 9-digit US Social Security Number (AAA-BB-CCCC).
pub fn USSSNValidate(ssn: int64): int64 {
  var buf: int64 := mmap(0, 11, 3, 34, -1, 0);
  if (buf == 0) { return US_SSN_ERR_LENGTH; }
  USSSNNormalize(ssn, buf);
  if (_ssnStrLen(buf) != 9) { munmap(buf, 11); return US_SSN_ERR_LENGTH; }

  // All characters must be digits
  var i: int64 := 0;
  while (i < 9) {
    if (_ssnIsDigit(peek8(buf + i)) == 0) { munmap(buf, 11); return US_SSN_ERR_CHAR; }
    i := i + 1;
  }

  // Area number (AAA): 001–899, not 666
  var area: int64 := (peek8(buf) - 48) * 100 + (peek8(buf + 1) - 48) * 10 + (peek8(buf + 2) - 48);
  if (area == 0 || area >= 900) { munmap(buf, 11); return US_SSN_ERR_AREA; }
  if (area == 666) { munmap(buf, 11); return US_SSN_ERR_AREA; }

  // Group number (BB): 01–99
  var group: int64 := (peek8(buf + 3) - 48) * 10 + (peek8(buf + 4) - 48);
  if (group == 0) { munmap(buf, 11); return US_SSN_ERR_GROUP; }

  // Serial number (CCCC): 0001–9999
  var serial: int64 := (peek8(buf + 5) - 48) * 1000 + (peek8(buf + 6) - 48) * 100 +
                       (peek8(buf + 7) - 48) * 10 + (peek8(buf + 8) - 48);
  if (serial == 0) { munmap(buf, 11); return US_SSN_ERR_SERIAL; }

  // Known invalid patterns
  // 078-05-1120 (Woolworth wallet insert SSN)
  var b0: int64 := peek8(buf); var b1: int64 := peek8(buf + 1); var b2: int64 := peek8(buf + 2);
  var b3: int64 := peek8(buf + 3); var b4: int64 := peek8(buf + 4);
  var b5: int64 := peek8(buf + 5); var b6: int64 := peek8(buf + 6);
  var b7: int64 := peek8(buf + 7); var b8: int64 := peek8(buf + 8);
  if (b0==48 && b1==55 && b2==56 && b3==48 && b4==53 &&
      b5==49 && b6==49 && b7==50 && b8==48) {
    munmap(buf, 11); return US_SSN_ERR_KNOWN_INVALID;
  }
  // 219-09-9999
  if (b0==50 && b1==49 && b2==57 && b3==48 && b4==57 &&
      b5==57 && b6==57 && b7==57 && b8==57) {
    munmap(buf, 11); return US_SSN_ERR_KNOWN_INVALID;
  }
  // 123-45-6789 (widely used in fiction)
  if (b0==49 && b1==50 && b2==51 && b3==52 && b4==53 &&
      b5==54 && b6==55 && b7==56 && b8==57) {
    munmap(buf, 11); return US_SSN_ERR_KNOWN_INVALID;
  }
  // All same digit (000000000 caught by area=0; but e.g. 111111111)
  if (b0==b1 && b1==b2 && b2==b3 && b3==b4 && b4==b5 && b5==b6 && b6==b7 && b7==b8) {
    munmap(buf, 11); return US_SSN_ERR_KNOWN_INVALID;
  }

  munmap(buf, 11);
  return US_SSN_OK;
}
