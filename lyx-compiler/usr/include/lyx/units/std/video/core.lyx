@description("Video metadata struct, format/codec constants, container detection")
@author("Andreas Röne")
@copyright("2025-2026 Andreas Röne")
unit std.video.core;

import std.alloc;

// ============================================================================
// VidMeta struct offsets (all int64 fields, 8 bytes each)
// ============================================================================

con VID_OFF_WIDTH:       int64 := 0;
con VID_OFF_HEIGHT:      int64 := 8;
con VID_OFF_DURATION_MS: int64 := 16;
con VID_OFF_FPS_NUM:     int64 := 24;
con VID_OFF_FPS_DEN:     int64 := 32;
con VID_OFF_FRAME_COUNT: int64 := 40;
con VID_OFF_FORMAT:      int64 := 48;
con VID_OFF_CODEC:       int64 := 56;
con VID_SIZE:            int64 := 64;

// ============================================================================
// Format constants
// ============================================================================

con VID_FMT_UNKNOWN: int64 := 0;
con VID_FMT_AVI:     int64 := 1;
con VID_FMT_MP4:     int64 := 2;

// ============================================================================
// Codec constants
// ============================================================================

con VID_CODEC_UNKNOWN: int64 := 0;
con VID_CODEC_MJPEG:   int64 := 1;
con VID_CODEC_H264:    int64 := 2;
con VID_CODEC_H265:    int64 := 3;
con VID_CODEC_AV1:     int64 := 4;
con VID_CODEC_MP4V:    int64 := 5;
con VID_CODEC_VP8:     int64 := 6;
con VID_CODEC_VP9:     int64 := 7;

// ============================================================================
// VidDetectFormat — identify container from first bytes
// ============================================================================

pub fn VidDetectFormat(buf: int64, len: int64): int64 {
    if (len < 12) { return VID_FMT_UNKNOWN; }
    // AVI: 'RIFF' at 0 + 'AVI ' at 8
    if (peek8(buf)    == 0x52 && peek8(buf+1)  == 0x49 &&
        peek8(buf+2)  == 0x46 && peek8(buf+3)  == 0x46 &&
        peek8(buf+8)  == 0x41 && peek8(buf+9)  == 0x56 &&
        peek8(buf+10) == 0x49 && peek8(buf+11) == 0x20) {
        return VID_FMT_AVI;
    }
    // MP4/ISOBMFF: 'ftyp' at offset 4
    if (len >= 8) {
        if (peek8(buf+4) == 0x66 && peek8(buf+5) == 0x74 &&
            peek8(buf+6) == 0x79 && peek8(buf+7) == 0x70) {
            return VID_FMT_MP4;
        }
    }
    return VID_FMT_UNKNOWN;
}
