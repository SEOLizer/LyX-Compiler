// std/stats.lyx
// Statistics & Aggregation functions for int64 arrays

@description("Statistical functions (mean, variance, correlation)")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
unit std.stats;

import std.sort;

fn StatsGet(arr: int64, i: int64): int64 {
  var off: int64 := i * 8;
  return peek64(arr + off);
}

pub fn ArraySum(arr: int64, n: int64): int64 {
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < n) {
    sum := sum + StatsGet(arr, i);
    i += 1;
  }
  return sum;
}

pub fn ArrayMin(arr: int64, n: int64): int64 {
  if (n == 0) { return 0; }
  var mn: int64 := StatsGet(arr, 0);
  var i: int64 := 1;
  while (i < n) {
    var v: int64 := StatsGet(arr, i);
    if (v < mn) { mn := v; }
    i += 1;
  }
  return mn;
}

pub fn ArrayMax(arr: int64, n: int64): int64 {
  if (n == 0) { return 0; }
  var mx: int64 := StatsGet(arr, 0);
  var i: int64 := 1;
  while (i < n) {
    var v: int64 := StatsGet(arr, i);
    if (v > mx) { mx := v; }
    i += 1;
  }
  return mx;
}

pub fn ArrayAvg(arr: int64, n: int64): int64 {
  if (n == 0) { return 0; }
  var s: int64 := ArraySum(arr, n);
  return s / n;
}

pub fn ArrayCount(arr: int64, n: int64): int64 {
  return n;
}

pub fn ArrayProduct(arr: int64, n: int64): int64 {
  if (n == 0) { return 0; }
  var product: int64 := 1;
  var i: int64 := 0;
  while (i < n) {
    product := product * StatsGet(arr, i);
    i += 1;
  }
  return product;
}

pub fn ArrayFirst(arr: int64, n: int64, fallback: int64): int64 {
  if (n == 0) { return fallback; }
  return StatsGet(arr, 0);
}

pub fn ArrayLast(arr: int64, n: int64, fallback: int64): int64 {
  if (n == 0) { return fallback; }
  var last: int64 := n - 1;
  return StatsGet(arr, last);
}

pub fn ArrayIndexOf(arr: int64, n: int64, value: int64): int64 {
  var i: int64 := 0;
  while (i < n) {
    if (StatsGet(arr, i) == value) { return i; }
    i += 1;
  }
  return -1;
}

pub fn ArrayLastIndexOf(arr: int64, n: int64, value: int64): int64 {
  var i: int64 := n - 1;
  while (i >= 0) {
    if (StatsGet(arr, i) == value) { return i; }
    i -= 1;
  }
  return -1;
}

pub fn ArrayContains(arr: int64, n: int64, value: int64): bool {
  return ArrayIndexOf(arr, n, value) >= 0;
}

pub fn ArrayCountValue(arr: int64, n: int64, value: int64): int64 {
  var count: int64 := 0;
  var i: int64 := 0;
  while (i < n) {
    if (StatsGet(arr, i) == value) { count := count + 1; }
    i += 1;
  }
  return count;
}

pub fn ArraySort(arr: int64, n: int64): void {
  SortInt64(arr, n);
}

pub fn ArrayMedian(arr: int64, n: int64): int64 {
  if (n == 0) { return 0; }
  SortInt64(arr, n);
  var mid: int64 := n / 2;
  return StatsGet(arr, mid);
}

pub fn ArrayRange(arr: int64, n: int64): int64 {
  return ArrayMax(arr, n) - ArrayMin(arr, n);
}

pub fn ArraySumSquares(arr: int64, n: int64): int64 {
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < n) {
    var v: int64 := StatsGet(arr, i);
    sum := sum + (v * v);
    i += 1;
  }
  return sum;
}

pub fn ArrayVariance(arr: int64, n: int64): int64 {
  if (n == 0) { return 0; }
  var mean: int64 := ArrayAvg(arr, n);
  var sumSqDiff: int64 := 0;
  var i: int64 := 0;
  while (i < n) {
    var diff: int64 := StatsGet(arr, i) - mean;
    sumSqDiff := sumSqDiff + (diff * diff);
    i += 1;
  }
  return sumSqDiff / n;
}

pub fn ArrayStdDev(arr: int64, n: int64): int64 {
  var variance: int64 := ArrayVariance(arr, n);
  if (variance <= 0) { return 0; }
  var x: int64 := variance;
  var x1: int64 := x + 1;
  var y: int64 := x1 / 2;
  while (y < x) {
    x := y;
    var vx: int64 := variance / x;
    var xvx: int64 := x + vx;
    y := xvx / 2;
  }
  return x;
}

// #1492: Clamp64 und InRange64 standen hier UND in std.math, beide `pub`. Wer
// beide Units importierte — naheliegend: std.stats fuer die Messreihe,
// std.math fuer IntSqrt — konnte nicht uebersetzen, und der flache Namensraum
// laesst keine Qualifizierung wie `math.Clamp64` zu.
//
// Beide sind mathematische Grundfunktionen und bleiben in std.math. Hier sind
// sie nur noch unit-intern vorhanden, damit die Aufrufer in dieser Datei
// unveraendert laufen; wer sie braucht, importiert std.math.
fn Clamp64(value: int64, minVal: int64, maxVal: int64): int64 {
  if (value < minVal) { return minVal; }
  if (value > maxVal) { return maxVal; }
  return value;
}

pub fn Percentage64(value: int64, total: int64): int64 {
  if (total == 0) { return 0; }
  var v100: int64 := value * 100;
  return v100 / total;
}

fn InRange64(value: int64, minVal: int64, maxVal: int64): bool {   // #1492, siehe Clamp64
  return (value >= minVal) && (value <= maxVal);
}

pub fn AbsDiff64(a: int64, b: int64): int64 {
  if (a > b) { return a - b; }
  return b - a;
}

// ============================================================================
// Map Aggregate Functions
// ============================================================================
// Operates on HashMap instances (the runtime representation of Map<K,V>).
// Pass your map as int64: MapSum(myMap as int64)
//
// #1491: Das hier angenommene Layout (VMT bei +0, Datenzeiger bei +8) gab es
// nicht — oder nicht mehr. Alle fuenf Funktionen lasen darum ins Leere und
// lieferten 0, unabhaengig vom Inhalt der Map.
//
// Gemessenes Laufzeitbild einer Map<K,V> (kein VMT, Buckets liegen INLINE
// hinter dem Kopf):
//   +0:  capacity — Zahl der Buckets
//   +8:  length   — Zahl der belegten Eintraege
//   +16: reserviert (0)
//   +24: erster Bucket, Schrittweite 24 Byte
// Bucket: Schluessel (+0), Wert (+8), Hash bzw. Schluesselkopie (+16)
//
// EIN Sonderfall: bei Map<int64,V> ist der Schluessel 0 ein gueltiger
// Schluessel und ein leerer Bucket traegt ebenfalls 0 — beide sind am Bucket
// nicht zu unterscheiden. Deshalb wird nicht auf die gefundenen Eintraege
// vertraut, sondern auf `length`: was die Schleife nicht findet, sind
// Eintraege mit Schluessel 0 und Wert 0, und die werden am Ende nachgetragen.
// MapCount liest `length` ohnehin direkt und ist davon nicht betroffen.

fn _mapKapazitaet(m: int64): int64 { return peek64(m); }
fn _mapBucket(m: int64, i: int64): int64 { return m + 24 + i * 24; }

// Ist der Bucket belegt? Schluessel, Wert oder Hash ungleich 0 reicht.
fn _mapBelegt(e: int64): bool {
  return peek64(e) != 0 || peek64(e + 8) != 0 || peek64(e + 16) != 0;
}

pub fn MapCount(m: int64): int64 {
  if (m == 0) { return 0; }
  return peek64(m + 8);
}

pub fn MapSum(m: int64): int64 {
  if (m == 0) { return 0; }
  var cap: int64 := _mapKapazitaet(m);
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < cap) {
    var e: int64 := _mapBucket(m, i);
    if (_mapBelegt(e)) { sum := sum + peek64(e + 8); }
    i += 1;
  }
  return sum;    // nicht gefundene Eintraege tragen 0 bei
}

pub fn MapMin(m: int64): int64 {
  if (m == 0) { return 0; }
  var cap: int64 := _mapKapazitaet(m);
  var found: int64 := 0;
  var minVal: int64 := 0;
  var i: int64 := 0;
  while (i < cap) {
    var e: int64 := _mapBucket(m, i);
    if (_mapBelegt(e)) {
      var v: int64 := peek64(e + 8);
      // found zaehlt die gefundenen Eintraege — nicht nur "einer war dabei".
      // Der Vergleich mit MapCount unten braucht die ZAHL.
      if (found == 0) { minVal := v; }
      else if (v < minVal) { minVal := v; }
      found += 1;
    }
    i += 1;
  }
  // Fehlende Eintraege tragen den Wert 0 — der kann das Minimum sein.
  if (found < MapCount(m)) {
    if (found == 0) { return 0; }
    if (0 < minVal) { return 0; }
  }
  return minVal;
}

pub fn MapMax(m: int64): int64 {
  if (m == 0) { return 0; }
  var cap: int64 := _mapKapazitaet(m);
  var found: int64 := 0;
  var maxVal: int64 := 0;
  var i: int64 := 0;
  while (i < cap) {
    var e: int64 := _mapBucket(m, i);
    if (_mapBelegt(e)) {
      var v: int64 := peek64(e + 8);
      // found zaehlt die gefundenen Eintraege — nicht nur "einer war dabei".
      // Der Vergleich mit MapCount unten braucht die ZAHL.
      if (found == 0) { maxVal := v; }
      else if (v > maxVal) { maxVal := v; }
      found += 1;
    }
    i += 1;
  }
  if (found < MapCount(m)) {
    if (found == 0) { return 0; }
    if (0 > maxVal) { return 0; }
  }
  return maxVal;
}

pub fn MapAvg(m: int64): int64 {
  var cnt: int64 := MapCount(m);
  if (cnt == 0) { return 0; }
  return MapSum(m) / cnt;
}
