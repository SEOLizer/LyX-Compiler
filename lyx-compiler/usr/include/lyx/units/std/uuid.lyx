// std/uuid - UUID Generation and Parsing
// Supports UUID v4 (random) and v7 (timestamp-based) generation

@description("UUID generation and parsing")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
@capabilities([fs.read, process.exec, process.fork, process.signal, system.env, system.rand, system.time])
unit std.uuid;

import std.alloc;
import std.io;
import std.os;   // #1473: unix_time/getpid fuer die Saat des Ausweichwegs

// UUID variants
con UUID_VARIANT_NCS: int64 := 0;
con UUID_VARIANT_RFC: int64 := 1;
con UUID_VARIANT_MICROSOFT: int64 := 2;
con UUID_VARIANT_FUTURE: int64 := 3;

// UUID version
con UUID_VERSION_4: int64 := 4;  // Random
con UUID_VERSION_7: int64 := 7;  // Unix timestamp-based

// ============================================================================
// UUID Structure (internal)
// ============================================================================

// UUID as 16 bytes
pub con UUID_SIZE: int64 := 16;

// ============================================================================
// Helper Functions
// ============================================================================

// Convert hex char to value
fn hexCharToInt(c: int64): int64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return -1;
}

// Convert int to hex char
fn intToHexChar(n: int64): int64 {
    if (n >= 0 && n <= 9) { return n + 48; }
    if (n >= 10 && n <= 15) { return n + 55; }
    return 48;
}

// String length helper (since StrLength may not be available)
fn StrLenManual(s: pchar): int64 {
    var i: int64 := 0;
    while (s[i] != 0) { i := i + 1; }
    return i;
}

// Seed counter for random byte generation
// #1473: Hier stand ein LCG mit fest einkompilierter Saat (12345). Der
// Zustand wurde nirgends aus einer Systemquelle gesetzt — jeder Prozessstart
// begann bei derselben Zahl und lieferte damit DIESELBE UUID-Folge. Fuer
// Kennungen, die eindeutig sein sollen, ist das der schlimmste Fehler: er
// faellt im Test nie auf, weil dort ohnehin nur ein Lauf stattfindet.
//
// Gezogen wird jetzt aus dem System: getrandom(2), sonst /dev/urandom. Beide
// Wege koennen fehlschlagen (alter Kernel, kein /dev) — dann bleibt der LCG,
// aber mit einer Saat aus Uhrzeit und Prozesskennung statt einer Konstante.
// Der Ausweichweg meldet sich einmal, damit niemand ihn fuer die Regel haelt.

var SeedCounter: int64 := 0;
var _uuidGemeldet: int64 := 0;

fn _uuidSaatSetzen(): void {
  if (SeedCounter != 0) { return; }
  var t: int64 := unix_time();
  var p: int64 := getpid();
  SeedCounter := (t * 1000003 + p * 7919) & 2147483647;
  if (SeedCounter == 0) { SeedCounter := 1; }
}

fn randomByte(): int64 {
  _uuidSaatSetzen();
  var temp: int64 := SeedCounter * 1103515245;
  temp += 12345;
  temp := temp & 2147483647;
  SeedCounter := temp;
  temp := temp >> 16;
  return temp & 255;
}

// Fuellt n Byte ab buf mit Zufall. Liefert 1 bei Systemzufall, 0 beim
// Ausweichweg.
fn _uuidZufall(buf: int64, n: int64): int64 {
  var geholt: int64 := sys_getrandom(buf, n, 0);
  if (geholt == n) { return 1; }

  var fd: int64 := open("/dev/urandom"c, 0, 0);
  if (fd >= 0) {
    var gelesen: int64 := 0;
    while (gelesen < n) {
      var r: int64 := read(fd, buf + gelesen, n - gelesen);
      if (r <= 0) { gelesen := n + 1; }
      else { gelesen := gelesen + r; }
    }
    close(fd);
    if (gelesen == n) { return 1; }
  }

  if (_uuidGemeldet == 0) {
    _uuidGemeldet := 1;
    EPrintStrLn("std.uuid: kein Systemzufall (getrandom/urandom) — UUIDs stammen aus dem Ersatzgenerator"c);
  }
  var i: int64 := 0;
  while (i < n) { poke8(buf + i, randomByte()); i := i + 1; }
  return 0;
}

// ============================================================================
// UUID Generation
// ============================================================================

// Generate UUID v4 (random)
// Output: 16 bytes UUID in buffer
pub fn GenerateV4(output: pchar): bool {
    if (output == 0) { return false; }

    // #1473: 16 Byte am Stueck aus der Systemquelle, statt sechzehnmal aus
    // einem LCG mit fester Saat.
    var roh: int64 := alloc(16);
    _uuidZufall(roh, 16);

    var i: int64 := 0;
    while (i < 16) {
        var b: int64 := peek8(roh + i) & 255;
        if (i == 6) { b := (b & 15) | 64; }    // Version 4
        if (i == 8) { b := (b & 63) | 128; }   // Variante RFC 4122
        StrSetChar(output, i, b);
        i += 1;
    }
    free(roh, 16);
    return true;
}

// Generate UUID v7 (Unix timestamp-based)
// Output: 16 bytes UUID in buffer
pub fn GenerateV7(output: pchar): bool {
    if (output == 0) { return false; }

    // #1475: Der Zeitstempel war `SeedCounter * 1000` — also der Zustand des
    // Zufallsgenerators, keine Zeit. Damit war die zeitliche Sortierbarkeit,
    // der einzige Grund fuer Version 7, nicht gegeben.
    //
    // RFC 9562 will die Millisekunden seit der Unix-Epoche als 48 Bit in
    // GROSS-Endian-Reihenfolge in den Bytes 0..5. Die alte Schleife schrieb
    // klein-endian, was die Sortierung selbst bei richtiger Zeit zerstoert
    // haette.
    var ms: int64 := unix_time() * 1000;
    var i: int64 := 0;
    while (i < 6) {
        var schub: int64 := (5 - i) * 8;
        StrSetChar(output, i, (ms >> schub) & 255);
        i += 1;
    }

    var roh: int64 := alloc(10);
    _uuidZufall(roh, 10);
    i := 6;
    while (i < 16) {
        StrSetChar(output, i, peek8(roh + i - 6) & 255);
        i += 1;
    }
    free(roh, 10);

    var b6: int64 := StrCharAt(output, 6);
    StrSetChar(output, 6, (b6 & 15) | 112);    // Version 7
    var b8: int64 := StrCharAt(output, 8);
    StrSetChar(output, 8, (b8 & 63) | 128);    // Variante RFC 4122

    return true;
}

// ============================================================================
// UUID String Conversion
// ============================================================================

// UUID to string (8-4-4-4-12 format)
// Input: 16 bytes UUID
// Output: 36 character string + null terminator
pub fn ToString(uuid: pchar, output: pchar): bool {
    if (uuid == 0 || output == 0) { return false; }
    
    var pos: int64 := 0;
    var i: int64 := 0;
    
    // 8 hex chars (bytes 0-3)
    i := 0;
    while (i < 4) {
        var b: int64 := StrCharAt(uuid, i);
        var hi: int64 := (b >> 4) & 15;
        var lo: int64 := b & 15;
        StrSetChar(output, pos, intToHexChar(hi)); pos := pos + 1;
        StrSetChar(output, pos, intToHexChar(lo)); pos := pos + 1;
        i += 1;
    }
    StrSetChar(output, pos, 45); pos := pos + 1;  // '-'
    
    // 4 hex chars (bytes 4-5)
    i := 4;
    while (i < 6) {
        var b: int64 := StrCharAt(uuid, i);
        var hi: int64 := (b >> 4) & 15;
        var lo: int64 := b & 15;
        StrSetChar(output, pos, intToHexChar(hi)); pos := pos + 1;
        StrSetChar(output, pos, intToHexChar(lo)); pos := pos + 1;
        i += 1;
    }
    StrSetChar(output, pos, 45); pos := pos + 1;  // '-'
    
    // 4 hex chars (bytes 6-7)
    i := 6;
    while (i < 8) {
        var b: int64 := StrCharAt(uuid, i);
        var hi: int64 := (b >> 4) & 15;
        var lo: int64 := b & 15;
        StrSetChar(output, pos, intToHexChar(hi)); pos := pos + 1;
        StrSetChar(output, pos, intToHexChar(lo)); pos := pos + 1;
        i += 1;
    }
    StrSetChar(output, pos, 45); pos := pos + 1;  // '-'

    // #1474: Hier wurden die Bytes 8..15 in EINER Schleife ausgegeben — der
    // vierte Bindestrich nach Byte 9 fehlte, die Ausgabe hatte 35 statt 36
    // Zeichen, und FromString(ToString(x)) schlug fehl. RFC 4122 verlangt
    // 8-4-4-4-12.
    i := 8;
    while (i < 10) {
        var b89: int64 := StrCharAt(uuid, i);
        StrSetChar(output, pos, intToHexChar((b89 >> 4) & 15)); pos := pos + 1;
        StrSetChar(output, pos, intToHexChar(b89 & 15)); pos := pos + 1;
        i += 1;
    }
    StrSetChar(output, pos, 45); pos := pos + 1;  // '-' (der fehlende)

    // 12 hex chars (bytes 10-15)
    i := 10;
    while (i < 16) {
        var b: int64 := StrCharAt(uuid, i);
        var hi: int64 := (b >> 4) & 15;
        var lo: int64 := b & 15;
        StrSetChar(output, pos, intToHexChar(hi)); pos := pos + 1;
        StrSetChar(output, pos, intToHexChar(lo)); pos := pos + 1;
        i += 1;
    }
    
    StrSetChar(output, pos, 0);  // Null terminator
    return true;
}

// Parse UUID from string
// Input: 36 character UUID string (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
// Output: 16 bytes UUID
pub fn FromString(str: pchar, output: pchar): bool {
    if (str == 0 || output == 0) { return false; }
    
    var len: int64 := StrLenManual(str);
    if (len < 36) { return false; }
    
    // Parse with or without dashes
    var pos: int64 := 0;
    var outPos: int64 := 0;
    var i: int64 := 0;
    
    while (i < len && outPos < 16) {
        var c: int64 := StrCharAt(str, i);
        
        // Skip dashes
        if (c == 45) {
            i += 1;
            continue;
        }
        
        // Parse hex pair
        var hi: int64 := hexCharToInt(c);
        if (hi < 0) { return false; }
        
        i += 1;
        if (i >= len) { return false; }
        
        var lo: int64 := hexCharToInt(StrCharAt(str, i));
        if (lo < 0) { return false; }
        
        var byte: int64 := (hi << 4) | lo;
        StrSetChar(output, outPos, byte);
        outPos += 1;
        i += 1;
    }
    
    return outPos == 16;
}

// ============================================================================
// UUID Comparison
// ============================================================================

// Compare two UUIDs
// Returns: 0 if equal, -1 if a < b, 1 if a > b
pub fn Compare(uuidA: pchar, uuidB: pchar): int64 {
    if (uuidA == 0 || uuidB == 0) { return 0; }
    
    var i: int64 := 0;
    while (i < 16) {
        var a: int64 := StrCharAt(uuidA, i);
        var b: int64 := StrCharAt(uuidB, i);
        
        if (a < b) { return -1; }
        if (a > b) { return 1; }
        
        i += 1;
    }
    
    return 0;
}

// Check if UUID is nil (all zeros)
pub fn IsNil(uuid: pchar): bool {
    if (uuid == 0) { return true; }
    
    var i: int64 := 0;
    while (i < 16) {
        if (StrCharAt(uuid, i) != 0) { return false; }
        i += 1;
    }
    
    return true;
}

// ============================================================================
// UUID Version/Variant
// ============================================================================

// Get UUID version (1, 4, or 7)
pub fn GetVersion(uuid: pchar): int64 {
    if (uuid == 0) { return 0; }
    
    var b6: int64 := StrCharAt(uuid, 6);
    return (b6 >> 4) & 15;
}

// Get UUID variant
pub fn GetVariant(uuid: pchar): int64 {
    if (uuid == 0) { return -1; }
    
    // #1475: Die Reihenfolge der Zweige machte UUID_VARIANT_RFC unerreichbar.
    // Die RFC-Variante hat die oberen Bits `10x`, also (b8 >> 5) in {4, 5} —
    // beide fielen in `variant < 6` und wurden als NCS gemeldet.
    //
    // Nach RFC 4122 gilt: 0xx = NCS, 10x = RFC 4122, 110 = Microsoft,
    // 111 = reserviert.
    var b8: int64 := StrCharAt(uuid, 8);
    var variant: int64 := (b8 >> 5) & 7;

    if (variant < 4) { return UUID_VARIANT_NCS; }
    if (variant < 6) { return UUID_VARIANT_RFC; }
    if (variant == 6) { return UUID_VARIANT_MICROSOFT; }
    return UUID_VARIANT_FUTURE;
}

// ============================================================================
// Convenience Functions
// ============================================================================

// Generate UUID v4 and return as string
// Output must be at least 37 bytes
pub fn GenerateV4String(output: pchar): bool {
    if (output == 0) { return false; }
    
    var uuid: int64 := alloc(16);
    if (not GenerateV4(uuid as pchar)) {   // #1272
        free(uuid, 16);                    // #1475: auch der Fehlerweg gibt frei
        return false;
    }

    var result: bool := ToString(uuid as pchar, output);   // #1272
    free(uuid, 16);                        // #1475: Leck pro Aufruf
    return result;
}

// Generate UUID v7 and return as string
// Output must be at least 37 bytes
pub fn GenerateV7String(output: pchar): bool {
    if (output == 0) { return false; }
    
    var uuid: int64 := alloc(16);
    if (not GenerateV7(uuid as pchar)) {   // #1272
        free(uuid, 16);                    // #1475
        return false;
    }

    var result: bool := ToString(uuid as pchar, output);   // #1272
    free(uuid, 16);                        // #1475
    return result;
}

// Validate UUID string format
pub fn IsValid(str: pchar): bool {
    if (str == 0) { return false; }
    
    var len: int64 := StrLenManual(str);
    
    // Check length (with or without dashes)
    if (len != 36 && len != 32) { return false; }
    
    var i: int64 := 0;
    while (i < len) {
        var c: int64 := StrCharAt(str, i);
        
        // Skip dashes
        if (c == 45) {
            i += 1;
            continue;
        }
        
        // Check if hex
        if (hexCharToInt(c) < 0) { return false; }
        
        i += 1;
    }
    
    return true;
}

// Nil UUID (all zeros)
pub fn SetNil(uuid: pchar): bool {
    if (uuid == 0) { return false; }
    
    var i: int64 := 0;
    while (i < 16) {
        StrSetChar(uuid, i, 0);
        i += 1;
    }
    
    return true;
}