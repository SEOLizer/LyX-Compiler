// std/crt_raw.lyx
// Rohmodus fuer das Terminal: Tasten ohne Zeilenpufferung und ohne Echo.
//
// #1874: SetRawMode und KeyPressed waren Platzhalter (-1 bzw. false), obwohl
// die termios-Huellen darunter seit #1179 arbeiten. ReadKeyRaw lief dadurch
// zeilengepuffert — die Taste kam erst nach der Eingabetaste an, und
// SetRawMode wird ueblicherweise ohne Pruefung des Rueckgabewerts gerufen, so
// dass das Programm danach scheinbar lief.

@description("Low-level raw terminal I/O")
@author("Andreas Röne")
@copyright("2024-2026 Andreas Röne")
unit std.crt_raw;

import std.alloc;

// #1179: beide ohne link-Klausel — nie gebunden, Rueckgabe still 0, also
// "hat geklappt". Der Rohmodus wurde damit nie gesetzt UND nie
// zurueckgenommen. tcgetattr/tcsetattr sind in der C-Bibliothek ohnehin nur
// Huellen um ioctl: TCGETS liest die termios-Struktur, TCSETS/TCSETSW/TCSETSF
// schreiben sie (optional_actions 0/1/2).
con TC_TCGETS: int64 := 0x5401;
con TC_TCSETS: int64 := 0x5402;

fn tcgetattr(fd: int64, termios_p: pchar): int64 {
  return sys_ioctl(fd, TC_TCGETS, termios_p as int64);
}

fn tcsetattr(fd: int64, optional_actions: int64, termios_p: pchar): int64 {
  return sys_ioctl(fd, TC_TCSETS + optional_actions, termios_p as int64);
}

// #1179: Diese Zeile deklarierte `sys_select` als externes Symbol OHNE
// link-Klausel und verdeckte damit das gleichnamige BUILTIN (Syscall 23), das
// der Compiler laengst emittiert. Der Aufruf lief ins Leere und lieferte
// still 0 — also "keine Deskriptoren bereit", dauerhaft. Ohne die Zeile
// greift wieder das Builtin.
fn ioctl(fd: int64, request: int64, argp: pchar): int64 { return sys_ioctl(fd, request, argp as int64); }

// POSIX-Konstanten
pub con TCSANOW: int64 := 0;

// ── termios auf Linux x86-64 ──────────────────────────────────────────────
//
//   0  c_iflag (u32)   4  c_oflag (u32)   8  c_cflag (u32)  12  c_lflag (u32)
//  16  c_line  (u8)   17  c_cc[32]       52  c_ispeed (u32) 56  c_ospeed (u32)
//
// 60 Byte; hier 64 belegt, damit ein Schreibzugriff des Kernels am Ende nicht
// an die Blockgrenze stoesst.
con TERMIOS_GROESSE: int64 := 64;
con OFF_IFLAG: int64 := 0;
con OFF_LFLAG: int64 := 12;
con OFF_CC:    int64 := 17;
// Die beiden Zaehler stehen IM c_cc-Feld, nicht daneben: VTIME ist Index 5,
// VMIN Index 6 (Linux, asm-generic/termbits.h).
con IDX_VTIME: int64 := 5;
con IDX_VMIN:  int64 := 6;

// c_lflag: Zeilenpufferung, Echo, Signaltasten.
con L_ISIG:   int64 := 0x0001;
con L_ICANON: int64 := 0x0002;
con L_ECHO:   int64 := 0x0008;
// c_iflag: CR→NL wandeln und Fluss-Steuerung per Strg-S/Strg-Q.
con I_ICRNL:  int64 := 0x0100;
con I_IXON:   int64 := 0x0400;

// Der Zustand VOR dem Umschalten. Ohne ihn laesst sich der Rohmodus nicht
// zuruecknehmen, und das Terminal bleibt nach dem Programmende ohne Echo
// stehen — der Grund, warum ein abgestuerztes TUI die Sitzung unbrauchbar
// macht.
var _crtRawAlt:    int64 := 0;
var _crtRawNeu:    int64 := 0;
var _crtRawAktiv:  int64 := 0;
var _crtRawBereit: int64 := 0;

// Eager, nicht faul: eine Erstbelegung tief im Aufrufstapel ist in Lyx schon
// mehrfach der Grund fuer einen Absturz gewesen.
fn _ensure(): void {
  if (_crtRawBereit != 0) { return; }
  _crtRawAlt := alloc(TERMIOS_GROESSE);
  _crtRawNeu := alloc(TERMIOS_GROESSE);
  _crtRawBereit := 1;
}

fn _lade32(basis: int64, off: int64): int64 {
  return peek8(basis + off)
       | (peek8(basis + off + 1) << 8)
       | (peek8(basis + off + 2) << 16)
       | (peek8(basis + off + 3) << 24);
}

fn _setze32(basis: int64, off: int64, wert: int64): void {
  poke8(basis + off + 0,  wert        & 0xFF);
  poke8(basis + off + 1, (wert >> 8)  & 0xFF);
  poke8(basis + off + 2, (wert >> 16) & 0xFF);
  poke8(basis + off + 3, (wert >> 24) & 0xFF);
}

// Schaltet den Rohmodus fuer stdin ein oder aus.
//
// Rueckgabe 0 bei Erfolg, -1 wenn stdin kein Terminal ist (tcgetattr scheitert
// mit ENOTTY, etwa in einer Pipe) oder das Setzen fehlschlaegt.
//
// Unter LCBS braucht das `ioctl` — heute nur ueber eine hardware.*-Capability
// erreichbar (#1867).
pub fn SetRawMode(enabled: bool): int64 {
  _ensure();

  if (!enabled) {
    // Ausschalten heisst: den gemerkten Zustand zurueckschreiben. Wer nie
    // eingeschaltet hat, hat nichts zu merken — das ist kein Fehler.
    if (_crtRawAktiv == 0) { return 0; }
    var rc: int64 := tcsetattr(0, TCSANOW, _crtRawAlt as pchar);
    if (rc < 0) { return -1; }
    _crtRawAktiv := 0;
    return 0;
  }

  if (_crtRawAktiv != 0) { return 0; }

  if (tcgetattr(0, _crtRawAlt as pchar) < 0) { return -1; }

  var i: int64 := 0;
  while (i < TERMIOS_GROESSE) { poke8(_crtRawNeu + i, peek8(_crtRawAlt + i)); i := i + 1; }

  var lflag: int64 := _lade32(_crtRawNeu, OFF_LFLAG);
  lflag := lflag & (~(L_ICANON | L_ECHO | L_ISIG));
  _setze32(_crtRawNeu, OFF_LFLAG, lflag);

  var iflag: int64 := _lade32(_crtRawNeu, OFF_IFLAG);
  iflag := iflag & (~(I_ICRNL | I_IXON));
  _setze32(_crtRawNeu, OFF_IFLAG, iflag);

  // Eine Taste genuegt, kein Zeitlimit.
  poke8(_crtRawNeu + OFF_CC + IDX_VMIN,  1);
  poke8(_crtRawNeu + OFF_CC + IDX_VTIME, 0);

  if (tcsetattr(0, TCSANOW, _crtRawNeu as pchar) < 0) { return -1; }
  _crtRawAktiv := 1;
  return 0;
}

// Liegt eine Taste an, ohne zu warten?
//
// pollfd ist { fd: int32, events: int16, revents: int16 } — acht Byte.
// POLLIN ist 1. Zeitlimit 0 heisst: sofort zurueck, egal was anliegt.
//
// Unter LCBS braucht das `poll` — heute von keiner Capability gedeckt (#1868).
pub fn KeyPressed(): bool {
  _ensure();
  var pfd: int64 := alloc(8);
  poke8(pfd + 0, 0); poke8(pfd + 1, 0); poke8(pfd + 2, 0); poke8(pfd + 3, 0);  // fd = 0
  poke8(pfd + 4, 1); poke8(pfd + 5, 0);                                        // events = POLLIN
  poke8(pfd + 6, 0); poke8(pfd + 7, 0);                                        // revents = 0
  var rc: int64 := sys_poll(pfd, 1, 0);
  if (rc <= 0) { return false; }
  var revents: int64 := peek8(pfd + 6) | (peek8(pfd + 7) << 8);
  return (revents & 1) != 0;
}

// Liest ein Byte von stdin. -1 bei Fehler oder Dateiende.
//
// #1874: Der Puffer war ein String-Literal ("\0"). In Lyx liegen Literale im
// schreibgeschuetzten Teil des Erzeugnisses — `read` schrieb also in den
// Literalpool. Das ist dieselbe Speicherzerstoerung, vor der die Projektregeln
// warnen, und sie faellt erst weit spaeter und woanders auf.
pub fn ReadKeyRaw(): int64 {
  _ensure();
  var buf: int64 := alloc(8);
  poke8(buf, 0);
  var r: int64 := read(0, buf as pchar, 1);
  if (r <= 0) { return -1; }
  return peek8(buf);
}

// End of std/crt_raw.lyx
