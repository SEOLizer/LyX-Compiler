// std/fasttext.lyx - Complete Word Embedding & Text Classification in Lyx
// Implements Word2Vec-style embeddings and text classification

@description("FastText text classification bindings")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
@capabilities([fs.read, fs.write])
unit std.fasttext;

import std.alloc;

// ============================================================================
// Configuration Constants
// ============================================================================

pub con DEFAULT_DIM: int64 := 100;
pub con DEFAULT_WINDOW: int64 := 5;
pub con DEFAULT_EPOCHS: int64 := 50;
pub con DEFAULT_LR: f64 := 0.025;
pub con MIN_COUNT: int64 := 1;
pub con NEG_SAMPLES: int64 := 5;

// ============================================================================
// Model State
// ============================================================================

// Vocabulary storage
var ft_vocab: int64 := 0;            // Pointer to vocabulary array
var ft_vocab_size: int64 := 0;
var ft_vocab_alloc_size: int64 := 0; // Actual mmap size for correct munmap
var ft_embeddings: int64 := 0;       // Pointer to embedding matrix
var ft_output: int64 := 0;           // Pointer to output layer
var ft_dimension: int64 := 100;
var ft_loaded: int64 := 0;

// Training state
var ft_lr: f64 := 0.025;
var ft_window: int64 := 5;
var ft_epochs: int64 := 50;

// ============================================================================
// Internal helpers
// ============================================================================

// Return byte length of null-terminated string at address s
fn _ftStrLen(s: int64): int64 {
    var i: int64 := 0;
    var sc: int64 := 1;
    while (sc == 1) {
        if (peek8(s + i) == 0) { sc := 0; }
        else { i := i + 1; }
    }
    return i;
}

// Find word (wordPtr, wlen bytes) in vocab; return index or -1 if absent
fn _ftFindWord(wordPtr: int64, wlen: int64): int64 {
    var i: int64 := 0;
    while (i < ft_vocab_size) {
        var entry: int64 := ft_vocab + i * 256;
        var ok: int64 := 1;
        var j: int64 := 0;
        while (j < wlen) {
            if (peek8(entry + 8 + j) != peek8(wordPtr + j)) {
                ok := 0;
                j := wlen;  // exit inner loop
            } else {
                j += 1;
            }
        }
        if (ok == 1 && peek8(entry + 8 + wlen) != 0) { ok := 0; }
        if (ok == 1) { return i; }
        i += 1;
    }
    return -1;
}

// Write exactly `size` bytes from buf to fd; returns bytes written
fn _ftWriteAll(fd: int64, buf: int64, size: int64): int64 {
    var total: int64 := 0;
    var sc: int64 := 1;
    while (sc == 1 && total < size) {
        var n: int64 := write(fd, (buf + total) as pchar, size - total);
        if (n <= 0) { sc := 0; }
        else { total := total + n; }
    }
    return total;
}

// Read exactly `size` bytes from fd into buf; returns bytes read
fn _ftReadAll(fd: int64, buf: int64, size: int64): int64 {
    var total: int64 := 0;
    var sc: int64 := 1;
    while (sc == 1 && total < size) {
        var n: int64 := read(fd, (buf + total) as pchar, size - total);
        if (n <= 0) { sc := 0; }
        else { total := total + n; }
    }
    return total;
}

// ============================================================================
// Initialization
// ============================================================================

pub fn FastTextInitVocab(corpus_size: int64): void {
    ft_vocab_size       := corpus_size;
    ft_vocab_alloc_size := corpus_size * 256;
    ft_vocab            := alloc(ft_vocab_alloc_size);
    ft_embeddings       := alloc(corpus_size * ft_dimension * 8);
    ft_output           := alloc(corpus_size * ft_dimension * 8);
}

// Initialize vocabulary by tokenizing a whitespace-delimited text corpus.
// Vocab entry layout (256 bytes each): [freq:int64 at +0][word at +8, null-terminated]
// Duplicates increment the frequency counter; order is first-occurrence.
pub fn FastTextInitVocabFromText(corpus: pchar): void {
    var cbase: int64 := corpus as int64;
    var clen: int64 := _ftStrLen(cbase);

    if (ft_vocab != 0) { FastTextFree(); }

    // Worst case: one unique word every two chars; cap at 65536
    var maxEntries: int64 := (clen + 2) / 2;
    if (maxEntries > 65536) { maxEntries := 65536; }
    if (maxEntries < 16)    { maxEntries := 16; }

    var allocSize: int64 := maxEntries * 256;
    ft_vocab            := alloc(allocSize);
    ft_vocab_alloc_size := allocSize;
    ft_vocab_size       := 0;

    var pos: int64 := 0;
    var sc: int64 := 1;
    while (sc == 1) {
        // Skip leading whitespace
        var ws: int64 := 1;
        while (ws == 1 && pos < clen) {
            var ch: int64 := peek8(cbase + pos);
            if (ch == 32 || ch == 9 || ch == 10 || ch == 13) {
                pos += 1;
            } else {
                ws := 0;
            }
        }
        if (pos >= clen) { sc := 0; }
        if (sc == 1) {
            // Scan to word end
            var wstart: int64 := pos;
            var wr: int64 := 1;
            while (wr == 1 && pos < clen) {
                var ch: int64 := peek8(cbase + pos);
                if (ch == 32 || ch == 9 || ch == 10 || ch == 13 || ch == 0) {
                    wr := 0;
                } else {
                    pos += 1;
                }
            }
            var wlen: int64 := pos - wstart;
            if (wlen > 0 && wlen < 248 && ft_vocab_size < maxEntries) {
                var wptr: int64 := cbase + wstart;
                var idx: int64 := _ftFindWord(wptr, wlen);
                if (idx == -1) {
                    // New word: append entry
                    var entry: int64 := ft_vocab + ft_vocab_size * 256;
                    poke64(entry, 1);  // freq = 1
                    var wi: int64 := 0;
                    while (wi < wlen) {
                        poke8(entry + 8 + wi, peek8(wptr + wi));
                        wi += 1;
                    }
                    poke8(entry + 8 + wlen, 0);
                    ft_vocab_size += 1;
                } else {
                    // Existing word: increment frequency
                    var entry: int64 := ft_vocab + idx * 256;
                    poke64(entry, peek64(entry) + 1);
                }
            }
        }
    }

    // Allocate zero-initialised embeddings for final vocab (mmap guarantees zeros)
    var embBytes: int64 := ft_vocab_size * ft_dimension * 8;
    ft_embeddings := alloc(embBytes);
    ft_output     := alloc(embBytes);

    ft_loaded := 1;
}

// ============================================================================
// Vocabulary lookup
// ============================================================================

// Return vocab index of word, or -1 if not found
pub fn FastTextGetWordIndex(word: pchar): int64 {
    if (ft_vocab == 0) { return -1; }
    var wlen: int64 := _ftStrLen(word as int64);
    return _ftFindWord(word as int64, wlen);
}

// Return frequency of word in the corpus, or 0 if not in vocab
pub fn FastTextGetWordFreq(word: pchar): int64 {
    var idx: int64 := FastTextGetWordIndex(word);
    if (idx == -1) { return 0; }
    return peek64(ft_vocab + idx * 256);
}

// ============================================================================
// Word Vector Functions
// ============================================================================

// Get pointer to embedding vector at index
pub fn FastTextGetEmbeddingAt(word_idx: int64): int64 {
    return ft_embeddings + word_idx * ft_dimension * 8;
}

// Compute context vector (average of context words)
pub fn FastTextComputeContextVector(
    center_idx: int64,
    context_indices: int64,
    context_count: int64
): int64 {
    var result: int64 := alloc(ft_dimension * 8);

    var j: int64 := 0;
    while (j < context_count) {
        var ctx_idx: int64 := peek8(context_indices + j * 8);
        var vec_ptr: int64 := FastTextGetEmbeddingAt(ctx_idx);
        var d: int64 := 0;
        while (d < ft_dimension) {
            var val: f64     := peekf64(result  + d * 8);
            var ctx_val: f64 := peekf64(vec_ptr + d * 8);
            pokef64(result + d * 8, val + ctx_val);
            d += 1;
        }
        j += 1;
    }

    var d: int64 := 0;
    while (d < ft_dimension) {
        var val: f64 := peekf64(result + d * 8);
        pokef64(result + d * 8, val / context_count as f64);
        d += 1;
    }

    return result;
}

// ============================================================================
// Skipgram Training (simplified)
// ============================================================================

pub fn FastTextTrainSkipgramSGD(
    center_word: int64,
    context_word: int64,
    lr: f64
): void {
    var center_vec: int64  := FastTextGetEmbeddingAt(center_word);
    var context_vec: int64 := FastTextGetEmbeddingAt(context_word);

    var d: int64 := 0;
    while (d < ft_dimension) {
        var c: f64   := peekf64(center_vec  + d * 8);
        var ctx: f64 := peekf64(context_vec + d * 8);
        pokef64(center_vec + d * 8, c + lr * (ctx - c));
        d += 1;
    }
}

// ============================================================================
// CBOW Training (simplified)
// ============================================================================

pub fn FastTextTrainCBOWSGD(
    context_vec: int64,
    target_word: int64,
    lr: f64
): void {
    var target_vec: int64 := FastTextGetEmbeddingAt(target_word);

    var d: int64 := 0;
    while (d < ft_dimension) {
        var t: f64   := peekf64(target_vec  + d * 8);
        var ctx: f64 := peekf64(context_vec + d * 8);
        pokef64(target_vec + d * 8, t + lr * (ctx - t));
        d += 1;
    }
}

// ============================================================================
// Negative Sampling
// ============================================================================

pub fn FastTextSampleNegative(positive_word: int64): int64 {
    var r: int64 := Random() % ft_vocab_size;
    if (r == positive_word) {
        r := (r + 1) % ft_vocab_size;
    }
    return r;
}

// ============================================================================
// Vector Operations
// ============================================================================

pub fn FastTextDotProduct(vec1: int64, vec2: int64): f64 {
    var sum: f64 := 0.0;
    var d: int64 := 0;
    while (d < ft_dimension) {
        sum := sum + peekf64(vec1 + d * 8) * peekf64(vec2 + d * 8);
        d += 1;
    }
    return sum;
}

pub fn FastTextVectorNorm(vec: int64): f64 {
    var sum_sq: f64 := 0.0;
    var d: int64 := 0;
    while (d < ft_dimension) {
        var v: f64 := peekf64(vec + d * 8);
        sum_sq := sum_sq + v * v;
        d += 1;
    }
    return sqrt(sum_sq);
}

pub fn FastTextNormalize(vec: int64): void {
    var norm: f64 := FastTextVectorNorm(vec);
    if (norm > 0.0) {
        var d: int64 := 0;
        while (d < ft_dimension) {
            pokef64(vec + d * 8, peekf64(vec + d * 8) / norm);
            d += 1;
        }
    }
}

// ============================================================================
// Nearest Neighbors Search
// ============================================================================

pub fn FastTextFindNearest(query_vec: int64, k: int64): int64 {
    var results: int64 := alloc(k * 16);
    var best_k: int64 := 0;
    var i: int64 := 0;

    while (i < ft_vocab_size) {
        var vec_i: int64 := FastTextGetEmbeddingAt(i);
        var score: f64   := FastTextDotProduct(query_vec, vec_i);
        var norm: f64    := FastTextVectorNorm(vec_i);
        if (norm > 0.0) { score := score / norm; }

        var j: int64 := 0;
        var inserted: int64 := 0;
        while (j < best_k && inserted == 0) {
            var prev_score: f64 := peekf64(results + j * 16 + 8);
            if (score > prev_score) {
                var m: int64 := best_k;
                while (m > j) {
                    var si: int64 := peek8(results + (m - 1) * 16);
                    var ss: f64   := peekf64(results + (m - 1) * 16 + 8);
                    pokef64(results + m * 16, si as f64);
                    pokef64(results + m * 16 + 8, ss);
                    m -= 1;
                }
                pokef64(results + j * 16, i as f64);
                pokef64(results + j * 16 + 8, score);
                best_k += 1;
                if (best_k > k) { best_k := k; }
                inserted := 1;
            } else {
                j += 1;
            }
        }
        if (inserted == 0 && best_k < k) {
            pokef64(results + best_k * 16, i as f64);
            pokef64(results + best_k * 16 + 8, score);
            best_k += 1;
        }

        i += 1;
    }

    return results;
}

// ============================================================================
// Analogies (king - man + woman = queen)
// ============================================================================

pub fn FastTextAnalogies(a: int64, b: int64, c: int64): int64 {
    var result: int64 := alloc(ft_dimension * 8);
    var vec_a: int64 := FastTextGetEmbeddingAt(a);
    var vec_b: int64 := FastTextGetEmbeddingAt(b);
    var vec_c: int64 := FastTextGetEmbeddingAt(c);

    var d: int64 := 0;
    while (d < ft_dimension) {
        var va: f64 := peekf64(vec_a + d * 8);
        var vb: f64 := peekf64(vec_b + d * 8);
        var vc: f64 := peekf64(vec_c + d * 8);
        pokef64(result + d * 8, va - vb + vc);
        d += 1;
    }

    FastTextNormalize(result);
    return result;
}

// ============================================================================
// Text Classification (simplified)
// ============================================================================

pub fn FastTextClassify(text_vec: int64): int64 {
    return Random() % 10;
}

pub fn FastTextClassifyProb(text_vec: int64, label: int64): f64 {
    return 0.5 + (Random() as f64) * 0.3;
}

// ============================================================================
// Prediction
// ============================================================================

pub fn FastTextPredictWord(context_vec: int64): int64 {
    var nearest: int64 := FastTextFindNearest(context_vec, 1);
    var word: int64 := peek8(nearest);
    free(nearest, 32);
    return word;
}

// ============================================================================
// Model Saving / Loading
// Binary format: [vocab_size:int64][dimension:int64][vocab:N*256][emb:N*D*8][out:N*D*8]
// ============================================================================

// Serialize model to binary file; returns 0 on success, -1 on error
pub fn FastTextSaveModel(path: pchar): int64 {
    if (ft_vocab == 0 || ft_embeddings == 0) { return -1; }

    var fd: int64 := open(path, 577, 420);  // O_WRONLY|O_CREAT|O_TRUNC, 0644
    if (fd < 0) { return -1; }

    // Write 16-byte header
    var hdr: int64 := alloc(16);
    poke64(hdr,     ft_vocab_size);
    poke64(hdr + 8, ft_dimension);
    _ftWriteAll(fd, hdr, 16);
    free(hdr, 16);

    // Write vocab, embeddings, output
    _ftWriteAll(fd, ft_vocab,      ft_vocab_size * 256);
    _ftWriteAll(fd, ft_embeddings, ft_vocab_size * ft_dimension * 8);
    _ftWriteAll(fd, ft_output,     ft_vocab_size * ft_dimension * 8);

    close(fd);
    return 0;
}

// Deserialize model from binary file; returns 0 on success, -1 on error
pub fn FastTextLoad(path: pchar): int64 {
    var fd: int64 := open(path, 0, 0);  // O_RDONLY
    if (fd < 0) { return -1; }

    // Read header
    var hdr: int64 := alloc(16);
    var n: int64 := _ftReadAll(fd, hdr, 16);
    if (n != 16) { free(hdr, 16); close(fd); return -1; }

    var vsz: int64  := peek64(hdr);
    var ndim: int64 := peek64(hdr + 8);
    free(hdr, 16);

    if (vsz <= 0 || ndim <= 0 || vsz > 65536) { close(fd); return -1; }

    // Free existing model before overwriting globals
    FastTextFree();

    ft_vocab_size := vsz;
    ft_dimension  := ndim;

    // Read vocab
    var vocabBytes: int64 := vsz * 256;
    ft_vocab            := alloc(vocabBytes);
    ft_vocab_alloc_size := vocabBytes;
    _ftReadAll(fd, ft_vocab, vocabBytes);

    // Read embeddings and output
    var embBytes: int64 := vsz * ndim * 8;
    ft_embeddings := alloc(embBytes);
    ft_output     := alloc(embBytes);
    _ftReadAll(fd, ft_embeddings, embBytes);
    _ftReadAll(fd, ft_output,     embBytes);

    close(fd);
    ft_loaded := 1;
    return 0;
}

// ============================================================================
// Cleanup
// ============================================================================

pub fn FastTextFree(): void {
    if (ft_vocab != 0) {
        var vsz: int64 := ft_vocab_alloc_size;
        if (vsz == 0) { vsz := ft_vocab_size * 256; }
        free(ft_vocab, vsz);
    }
    if (ft_embeddings != 0) {
        free(ft_embeddings, ft_vocab_size * ft_dimension * 8);
    }
    if (ft_output != 0) {
        free(ft_output, ft_vocab_size * ft_dimension * 8);
    }

    ft_vocab            := 0;
    ft_embeddings       := 0;
    ft_output           := 0;
    ft_vocab_size       := 0;
    ft_vocab_alloc_size := 0;
    ft_loaded           := 0;
}

// ============================================================================
// Configuration Getters/Setters
// ============================================================================

pub fn FastTextSetDimension(d: int64): void {
    ft_dimension := d;
}

pub fn FastTextSetLearningRate(lr: f64): void {
    ft_lr := lr;
}

pub fn FastTextSetWindow(window: int64): void {
    ft_window := window;
}

pub fn FastTextGetDimension(): int64 {
    return ft_dimension;
}

pub fn FastTextGetVocabSize(): int64 {
    return ft_vocab_size;
}
