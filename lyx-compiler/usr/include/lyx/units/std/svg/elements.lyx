// ============================================================================
// Internal: write all set style attributes to main buffer
// ============================================================================

fn _svgWriteStyles(doc: int64): void {
  var flags: int64 := peek64(doc + SVG_FLAGS);
  if (flags & SVG_FLAG_FILL != 0) {
    _svgW(doc, " fill=\"");
    _svgWinline(doc, SVG_FILL);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_FILL_OPA != 0) {
    _svgW(doc, " fill-opacity=\"");
    _svgWinline(doc, SVG_FILL_OPA);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_FILL_RULE != 0) {
    _svgW(doc, " fill-rule=\"");
    _svgWinline(doc, SVG_FILL_RULE);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_STROKE != 0) {
    _svgW(doc, " stroke=\"");
    _svgWinline(doc, SVG_STROKE);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_SW != 0) {
    _svgW(doc, " stroke-width=\"");
    _svgWinline(doc, SVG_SW);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_OPACITY != 0) {
    _svgW(doc, " opacity=\"");
    _svgWinline(doc, SVG_OPACITY);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_LCAP != 0) {
    _svgW(doc, " stroke-linecap=\"");
    _svgWinline(doc, SVG_LCAP);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_LJOIN != 0) {
    _svgW(doc, " stroke-linejoin=\"");
    _svgWinline(doc, SVG_LJOIN);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_MLIM != 0) {
    _svgW(doc, " stroke-miterlimit=\"");
    _svgWinline(doc, SVG_MLIM);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_DASH != 0) {
    _svgW(doc, " stroke-dasharray=\"");
    _svgWinline(doc, SVG_DASH);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_DASHOFF != 0) {
    _svgW(doc, " stroke-dashoffset=\"");
    _svgWinline(doc, SVG_DASHOFF);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_TRANSFORM != 0) {
    _svgW(doc, " transform=\"");
    _svgWinline(doc, SVG_TRANSFORM);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_FILTER != 0) {
    _svgW(doc, " filter=\"");
    _svgWinline(doc, SVG_FILTER);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_CLIP_PATH != 0) {
    _svgW(doc, " clip-path=\"");
    _svgWinline(doc, SVG_CLIP_PATH);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_MASK != 0) {
    _svgW(doc, " mask=\"");
    _svgWinline(doc, SVG_MASK);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_VIS != 0) {
    _svgW(doc, " visibility=\"hidden\"");
  }
  if (flags & SVG_FLAG_MRK_END != 0) {
    _svgW(doc, " marker-end=\"");
    _svgWinline(doc, SVG_MRK_END);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_MRK_STR != 0) {
    _svgW(doc, " marker-start=\"");
    _svgWinline(doc, SVG_MRK_STR);
    _svgWc(doc, 34);
  }
}

