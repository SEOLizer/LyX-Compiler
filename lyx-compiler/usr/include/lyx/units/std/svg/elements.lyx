// SvgPolylineN / SvgPolygonN: build points from two float arrays (ptr to int64 array of f64 bits)
fn _svgWritePointsN(doc: int64, xs: int64, ys: int64, n: int64): void {
  var i: int64 := 0;
  while (i < n) {
    if (i > 0) { _svgWc(doc, 32); }
    var xbits: int64 := peek64(xs + i * 8);
    var ybits: int64 := peek64(ys + i * 8);
    _svgWf(doc, xbits as f64);
    _svgWc(doc, 44);  // ','
    _svgWf(doc, ybits as f64);
    i += 1;
  }
}

pub fn SvgPolylineN(doc: int64, xs: int64, ys: int64, n: int64): void {
  if (doc == 0) { return; }
  _svgFlushPendingGroup(doc);
  _svgIndent(doc);
  _svgW(doc, "<polyline points=\"");
  _svgWritePointsN(doc, xs, ys, n);
  _svgWc(doc, 34);
  poke64(doc + SVG_CUR_ELEM, SVG_ELEM_POLYLINE);
}

pub fn SvgPolygonN(doc: int64, xs: int64, ys: int64, n: int64): void {
  if (doc == 0) { return; }
  _svgFlushPendingGroup(doc);
  _svgIndent(doc);
  _svgW(doc, "<polygon points=\"");
  _svgWritePointsN(doc, xs, ys, n);
  _svgWc(doc, 34);
  poke64(doc + SVG_CUR_ELEM, SVG_ELEM_POLYGON);
}

// ============================================================================
// SvgApply: finalize current element with styles
// ============================================================================

pub fn SvgApply(doc: int64): void {
  if (doc == 0) { return; }
  var elem: int64 := peek64(doc + SVG_CUR_ELEM);
  if (elem == SVG_ELEM_NONE) { return; }
  if (elem == SVG_ELEM_GROUP) {
    // Write group opening
    _svgIndent(doc);
    _svgW(doc, "<g");
    _svgWriteStyles(doc);
    _svgWriteIdClass(doc);
    _svgWc(doc, 62); _svgNL(doc);
    poke64(doc + SVG_DEPTH, peek64(doc + SVG_DEPTH) + 1);
    _svgClearStyles(doc);
    poke64(doc + SVG_CUR_ELEM, SVG_ELEM_NONE);
    return;
  }
  if (elem == SVG_ELEM_PATH) {
    _svgW(doc, " d=\"");
    _svgWbytes(doc, peek64(doc + SVG_PATH_PTR), peek64(doc + SVG_PATH_LEN));
    _svgWc(doc, 34);
    poke64(doc + SVG_PATH_LEN, 0);
  }
  if (elem == SVG_ELEM_TEXT) {
    _svgWriteTextStyles(doc);
  }
  // Auto-assign ID if pending animations need a target
  var hasAnim: int64 := 0;
  if (peek64(doc + SVG_ANIM_LEN) > 0) {
    hasAnim := 1;
    if ((peek64(doc + SVG_FLAGS) & SVG_FLAG_ID) == 0) {
      var aid: int64 := peek64(doc + SVG_ID_CNT);
      poke64(doc + SVG_ID_CNT, aid + 1);
      var idBuf: int64 := alloc(32);
      if (idBuf != 0) {
        poke8(idBuf, 95); poke8(idBuf + 1, 97);  // "_a"
        var aidStr: pchar := IntToStr(aid);
        var ki: int64 := 0;
        while (true) {
          var ch: int64 := StrCharAt(aidStr, ki);
          if (ch == 0) { break; }
          poke8(idBuf + 2 + ki, ch); ki := ki + 1;
        }
        poke8(idBuf + 2 + ki, 0);
        _svgSetInline(doc, SVG_CUR_ID, idBuf as pchar);
        poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_ID);
        free(idBuf, 32);
      }
    }
  }
  _svgWriteStyles(doc);
  _svgWriteIdClass(doc);
  if (hasAnim == 1) {
    _svgWc(doc, 62); _svgNL(doc);
    _svgWbytes(doc, doc + SVG_ANIM_BUF, peek64(doc + SVG_ANIM_LEN));
    poke64(doc + SVG_ANIM_LEN, 0);
    _svgIndent(doc);
    _svgWc(doc, 60); _svgWc(doc, 47);  // '</'
    if (elem == SVG_ELEM_RECT) { _svgW(doc, "rect"); }
    else { if (elem == SVG_ELEM_CIRCLE) { _svgW(doc, "circle"); }
    else { if (elem == SVG_ELEM_ELLIPSE) { _svgW(doc, "ellipse"); }
    else { if (elem == SVG_ELEM_LINE) { _svgW(doc, "line"); }
    else { if (elem == SVG_ELEM_POLYLINE) { _svgW(doc, "polyline"); }
    else { if (elem == SVG_ELEM_POLYGON) { _svgW(doc, "polygon"); }
    else { if (elem == SVG_ELEM_PATH) { _svgW(doc, "path"); }
    else { _svgW(doc, "image"); }
    } } } } } }
    _svgWc(doc, 62); _svgNL(doc);
  } else {
    _svgW(doc, "/>");
    _svgNL(doc);
  }
  _svgClearStyles(doc);
  poke64(doc + SVG_CUR_ELEM, SVG_ELEM_NONE);
}

// ============================================================================
// Groups
// ============================================================================

pub fn SvgGroupBegin(doc: int64): int64 {
  if (doc == 0) { return 0; }
  _svgFlushPendingGroup(doc);
  poke64(doc + SVG_CUR_ELEM, SVG_ELEM_GROUP);
  var gd: int64 := peek64(doc + SVG_GROUP_D);
  poke64(doc + SVG_GROUP_D, gd + 1);
  return gd + 1;
}

pub fn SvgGroupBeginId(doc: int64, id: pchar): int64 {
  if (doc == 0) { return 0; }
  _svgFlushPendingGroup(doc);
  _svgSetInline(doc, SVG_CUR_ID, id as pchar);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_ID);
  poke64(doc + SVG_CUR_ELEM, SVG_ELEM_GROUP);
  var gd: int64 := peek64(doc + SVG_GROUP_D);
  poke64(doc + SVG_GROUP_D, gd + 1);
  return gd + 1;
}

pub fn SvgGroupEnd(doc: int64): void {
  if (doc == 0) { return; }
  _svgFlushPendingGroup(doc);
  var gd: int64 := peek64(doc + SVG_GROUP_D);
  if (gd <= 0) { return; }
  var d: int64 := peek64(doc + SVG_DEPTH);
  if (d > 1) { poke64(doc + SVG_DEPTH, d - 1); }
  _svgIndent(doc);
  _svgW(doc, "</g>");
  _svgNL(doc);
  poke64(doc + SVG_GROUP_D, gd - 1);
}

pub fn SvgSetId(doc: int64, elem: int64, id: pchar): void {
  if (doc == 0) { return; }
  _svgSetInline(doc, SVG_CUR_ID, id as pchar);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_ID);
}

pub fn SvgSetClass(doc: int64, elem: int64, cls: pchar): void {
  if (doc == 0) { return; }
  _svgSetInline(doc, SVG_CUR_CLASS, cls as pchar);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_CLASS);
}

pub fn SvgSetVisible(doc: int64, elem: int64, visible: int64): void {
  if (doc == 0) { return; }
  if (visible == 0) {
    poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_VIS);
  } else {
    poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) & (0 - SVG_FLAG_VIS - 1));
  }
}

pub fn SvgSetFillGradient(doc: int64, gradId: int64): void {
  if (doc == 0) { return; }
  // gradId holds the def_counter value; build url(#gradN)
  var tmp: int64 := alloc(32);
  if (tmp == 0) { return; }
  var pos: int64 := svgBufStr(tmp, 0, "url(#grad");
  pos := svgBufInt(tmp, pos, gradId);
  poke8(tmp + pos, 41); pos := pos + 1;
  poke8(tmp + pos, 0);
  _svgSetInline(doc, SVG_FILL, tmp as pchar);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_FILL);
  free(tmp, 32);
}

