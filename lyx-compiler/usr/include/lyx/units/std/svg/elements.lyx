  }
  if (flags & SVG_FLAG_FONT_WT != 0) {
    _svgW(doc, " font-weight=\"");
    _svgWinline(doc, SVG_FONT_WT);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_FONT_ST != 0) {
    _svgW(doc, " font-style=\"");
    _svgWinline(doc, SVG_FONT_ST);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_TEXT_ANC != 0) {
    _svgW(doc, " text-anchor=\"");
    _svgWinline(doc, SVG_TEXT_ANC);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_DOM_BASE != 0) {
    _svgW(doc, " dominant-baseline=\"");
    _svgWinline(doc, SVG_DOM_BASE);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_LSPC != 0) {
