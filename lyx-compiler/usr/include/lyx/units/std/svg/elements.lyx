    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_TEXT_DEC != 0) {
    _svgW(doc, " text-decoration=\"");
    _svgWinline(doc, SVG_TEXT_DEC);
    _svgWc(doc, 34);
  }
}

fn _svgWriteIdClass(doc: int64): void {
  var flags: int64 := peek64(doc + SVG_FLAGS);
  if (flags & SVG_FLAG_ID != 0) {
    _svgW(doc, " id=\"");
    _svgWescAttr(doc, doc + SVG_CUR_ID);
    _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_CLASS != 0) {
    _svgW(doc, " class=\"");
    _svgWescAttr(doc, doc + SVG_CUR_CLASS);
    _svgWc(doc, 34);
  }
}

fn _svgClearStyles(doc: int64): void {
  poke64(doc + SVG_FLAGS, 0);
  poke8(doc + SVG_TRANSFORM, 0);
  poke8(doc + SVG_CUR_ID, 0);
  poke8(doc + SVG_CUR_CLASS, 0);
}

// ============================================================================
// Flush pending group (write <g ...> and increase depth)
// ============================================================================

pub fn _svgFlushPendingGroup(doc: int64): void {
  if (peek64(doc + SVG_CUR_ELEM) != SVG_ELEM_GROUP) { return; }
  _svgIndent(doc);
  _svgW(doc, "<g");
  _svgWriteStyles(doc);
  _svgWriteIdClass(doc);
  _svgWc(doc, 62); _svgNL(doc);
  var d: int64 := peek64(doc + SVG_DEPTH);
  poke64(doc + SVG_DEPTH, d + 1);
  _svgClearStyles(doc);
  poke64(doc + SVG_CUR_ELEM, SVG_ELEM_NONE);
}

// ============================================================================
// Geometric primitives
// ============================================================================

pub fn SvgRect(doc: int64, x: f64, y: f64, w: f64, h: f64): void {
  if (doc == 0) { return; }
  _svgFlushPendingGroup(doc);
  _svgIndent(doc);
  _svgW(doc, "<rect x=\""); _svgWf(doc, x); _svgWc(doc, 34);
  _svgW(doc, " y=\"");      _svgWf(doc, y); _svgWc(doc, 34);
  _svgW(doc, " width=\"");  _svgWf(doc, w); _svgWc(doc, 34);
  _svgW(doc, " height=\""); _svgWf(doc, h); _svgWc(doc, 34);
  poke64(doc + SVG_CUR_ELEM, SVG_ELEM_RECT);
}

pub fn SvgRoundRect(doc: int64, x: f64, y: f64, w: f64, h: f64): void {
  if (doc == 0) { return; }
  _svgFlushPendingGroup(doc);
  _svgIndent(doc);
  _svgW(doc, "<rect x=\""); _svgWf(doc, x); _svgWc(doc, 34);
  _svgW(doc, " y=\"");      _svgWf(doc, y); _svgWc(doc, 34);
  _svgW(doc, " width=\"");  _svgWf(doc, w); _svgWc(doc, 34);
  _svgW(doc, " height=\""); _svgWf(doc, h); _svgWc(doc, 34);
  var rx100: int64 := peek64(doc + SVG_ROUND_RX);
  var ry100: int64 := peek64(doc + SVG_ROUND_RY);
  if (rx100 != 0) {
    _svgW(doc, " rx=\""); _svgWi100(doc, rx100); _svgWc(doc, 34);   // #1684
  }
  if (ry100 != 0) {
    _svgW(doc, " ry=\""); _svgWi100(doc, ry100); _svgWc(doc, 34);   // #1684
  }
  poke64(doc + SVG_CUR_ELEM, SVG_ELEM_RECT);
}

pub fn SvgSetRounding(doc: int64, rx: f64, ry: f64): void {
  if (doc == 0) { return; }
  poke64(doc + SVG_ROUND_RX, svgF64x100(rx));
  poke64(doc + SVG_ROUND_RY, svgF64x100(ry));
}

