unit std.svg.path;

import std.alloc;
import std.svg.xml;
import std.svg.elements;

// ============================================================================
// Path begin / setup
// ============================================================================

pub fn SvgPathBegin(doc: int64): void {
  if (doc == 0) { return; }
  _svgFlushPendingGroup(doc);
  poke64(doc + SVG_PATH_LEN, 0);
  _svgIndent(doc);
  _svgW(doc, "<path");
  poke64(doc + SVG_CUR_ELEM, SVG_ELEM_PATH);
}

pub fn SvgPathBeginId(doc: int64, id: pchar): void {
  if (doc == 0) { return; }
  _svgFlushPendingGroup(doc);
  poke64(doc + SVG_PATH_LEN, 0);
  _svgSetInline(doc, SVG_PATH_ID, id as pchar);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_PATH_ID);
  _svgIndent(doc);
  _svgW(doc, "<path id=\"");
  _svgWescAttr(doc, id);
  _svgWc(doc, 34);
  poke64(doc + SVG_CUR_ELEM, SVG_ELEM_PATH);
}

pub fn SvgClosePath(doc: int64): void {
  if (doc == 0) { return; }
  _svgP(doc, "Z");
}

// Applies path as invisible (visibility:hidden, but still referenciable by ID)
pub fn SvgApplyHidden(doc: int64): void {
  if (doc == 0) { return; }
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_VIS);
  SvgApply(doc);
}

pub fn SvgSetFillRule(doc: int64, rule: int64): void {
  if (doc == 0) { return; }
  if (rule == 1) { _svgSetInline(doc, SVG_FILL_RULE, "evenodd"); }
  else { _svgSetInline(doc, SVG_FILL_RULE, "nonzero"); }
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_FILL_RULE);
}

// ============================================================================
// Absolute path commands
// ============================================================================

pub fn SvgMoveTo(doc: int64, x: f64, y: f64): void {
  if (doc == 0) { return; }
  if (peek64(doc + SVG_PATH_LEN) > 0) { _svgPc(doc, 32); }
  _svgPc(doc, 77);  // 'M'
  _svgPf(doc, x); _svgPc(doc, 32); _svgPf(doc, y);
}

pub fn SvgLineTo(doc: int64, x: f64, y: f64): void {
  if (doc == 0) { return; }
  _svgPc(doc, 32); _svgPc(doc, 76);  // 'L'
  _svgPf(doc, x); _svgPc(doc, 32); _svgPf(doc, y);
}

pub fn SvgHLineTo(doc: int64, x: f64): void {
  if (doc == 0) { return; }
  _svgPc(doc, 32); _svgPc(doc, 72);  // 'H'
  _svgPf(doc, x);
}

pub fn SvgVLineTo(doc: int64, y: f64): void {
  if (doc == 0) { return; }
  _svgPc(doc, 32); _svgPc(doc, 86);  // 'V'
  _svgPf(doc, y);
}

// SvgCurveSetCP sets control points; SvgCurveTo draws cubic bezier
pub fn SvgCurveSetCP(doc: int64, x1: f64, y1: f64, x2: f64, y2: f64): void {
  if (doc == 0) { return; }
  poke64(doc + SVG_PARAM_A, svgF64x100(x1));
  poke64(doc + SVG_PARAM_B, svgF64x100(y1));
  poke64(doc + SVG_PARAM_C, svgF64x100(x2));
  poke64(doc + SVG_PARAM_D, svgF64x100(y2));
}

pub fn SvgCurveTo(doc: int64, x: f64, y: f64): void {
  if (doc == 0) { return; }
  _svgPc(doc, 32); _svgPc(doc, 67);  // 'C'
  _svgPf(doc, svgBufF64r2x100(0, 0, peek64(doc + SVG_PARAM_A)) as f64);
  _svgPc(doc, 32);
  _svgPf(doc, svgBufF64r2x100(0, 0, peek64(doc + SVG_PARAM_B)) as f64);
  _svgPc(doc, 32);
  _svgPf(doc, svgBufF64r2x100(0, 0, peek64(doc + SVG_PARAM_C)) as f64);
  _svgPc(doc, 32);
  _svgPf(doc, svgBufF64r2x100(0, 0, peek64(doc + SVG_PARAM_D)) as f64);
  _svgPc(doc, 32);
  _svgPf(doc, x); _svgPc(doc, 32); _svgPf(doc, y);
}

// Actually for _svgPf with a stored int100, use a small inline helper
fn _svgPi100(doc: int64, v100: int64): void {
  var tmp: int64 := alloc(16);
  if (tmp == 0) { return; }
  var pos: int64 := svgBufF64r2x100(tmp, 0, v100);
  poke8(tmp + pos, 0);
  _svgP(doc, tmp as pchar);
  free(tmp, 16);
}

pub fn SvgCurveTo2(doc: int64, x: f64, y: f64): void {
  if (doc == 0) { return; }
  _svgPc(doc, 32); _svgPc(doc, 67);  // 'C'
  _svgPi100(doc, peek64(doc + SVG_PARAM_A)); _svgPc(doc, 32);
  _svgPi100(doc, peek64(doc + SVG_PARAM_B)); _svgPc(doc, 32);
  _svgPi100(doc, peek64(doc + SVG_PARAM_C)); _svgPc(doc, 32);
  _svgPi100(doc, peek64(doc + SVG_PARAM_D));
  _svgPc(doc, 32); _svgPf(doc, x); _svgPc(doc, 32); _svgPf(doc, y);
}

// Smooth cubic bezier (S command): SvgSmoothCurveSetCP + SvgSmoothCurveTo
pub fn SvgSmoothCurveSetCP(doc: int64, x2: f64, y2: f64): void {
  if (doc == 0) { return; }
  poke64(doc + SVG_PARAM_C, svgF64x100(x2));
  poke64(doc + SVG_PARAM_D, svgF64x100(y2));
}

pub fn SvgSmoothCurveTo(doc: int64, x: f64, y: f64): void {
  if (doc == 0) { return; }
  _svgPc(doc, 32); _svgPc(doc, 83);  // 'S'
  _svgPi100(doc, peek64(doc + SVG_PARAM_C)); _svgPc(doc, 32);
  _svgPi100(doc, peek64(doc + SVG_PARAM_D));
  _svgPc(doc, 32); _svgPf(doc, x); _svgPc(doc, 32); _svgPf(doc, y);
}

// Quadratic bezier (Q command): SvgQuadSetCP + SvgQuadTo
pub fn SvgQuadSetCP(doc: int64, x1: f64, y1: f64): void {
