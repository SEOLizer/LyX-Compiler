// ============================================================================
// Helper shapes built from path commands
// ============================================================================

// Sine-based degree to radian approximation via integer tables (cos/sin via lookup)
// We use a 16-point approximation for 0,22.5,45,...337.5 degrees
// sin_table[i] = sin(i*22.5 degrees) * 10000

fn _svgSin10k(deg100: int64): int64 {
  // deg100 = degrees * 100. Map to 0..3599 range
  var d: int64 := deg100;
  while (d < 0) { d := d + 36000; }
  d := d - (d / 36000) * 36000;
  // quadrant: 0-8999=Q1, 9000-17999=Q2, 18000-26999=Q3, 27000-35999=Q4
  var q: int64 := d / 9000;
  var r: int64 := d - q * 9000;  // 0..8999 within quadrant
  // approximate sin(r/9000 * 90°) = sin(r * pi/18000)
  // use linear interpolation from 0 to 10000
  var v: int64 := r * 10000 / 9000;  // linear approx (good enough for SVG arcs)
  // quadrant adjustments
  if (q == 0) { return v; }
  if (q == 1) { return 10000 - v; }
  if (q == 2) { return 0 - v; }
  return v - 10000;
}

fn _svgCos10k(deg100: int64): int64 {
  return _svgSin10k(deg100 + 9000);
}

// SvgPathArc: circular arc from startDeg to endDeg around (cx,cy) with radius r
// Uses A-command for accuracy
pub fn SvgPathArc(doc: int64, cx: f64, cy: f64, r: f64, startDeg: f64, endDeg: f64): void {
  if (doc == 0) { return; }
  var cx100: int64 := svgF64x100(cx);
  var cy100: int64 := svgF64x100(cy);
  var r100:  int64 := svgF64x100(r);
  var start100: int64 := svgF64x100(startDeg);
  var end100:   int64 := svgF64x100(endDeg);
  // Start point
  var sx100: int64 := cx100 + (r100 * _svgCos10k(start100)) / 10000;
  var sy100: int64 := cy100 + (r100 * _svgSin10k(start100)) / 10000;
  var ex100: int64 := cx100 + (r100 * _svgCos10k(end100)) / 10000;
  var ey100: int64 := cy100 + (r100 * _svgSin10k(end100)) / 10000;
  // M sx sy A r r 0 laf 1 ex ey
  _svgPc(doc, 77);  // 'M'
  _svgPi100(doc, sx100); _svgPc(doc, 32); _svgPi100(doc, sy100);
  _svgP(doc, " A ");
  _svgPi100(doc, r100); _svgPc(doc, 32); _svgPi100(doc, r100);
  _svgP(doc, " 0 ");
  var span100: int64 := end100 - start100;
  if (span100 < 0) { span100 := span100 + 36000; }
  if (span100 > 18000) { _svgP(doc, "1 1 "); } else { _svgP(doc, "0 1 "); }
  _svgPi100(doc, ex100); _svgPc(doc, 32); _svgPi100(doc, ey100);
}

// SvgPathPieSlice: filled pie slice
pub fn SvgPathPieSlice(doc: int64, cx: f64, cy: f64, r: f64, startDeg: f64, endDeg: f64): void {
  if (doc == 0) { return; }
  var cx100: int64 := svgF64x100(cx);
  var cy100: int64 := svgF64x100(cy);
  var r100:  int64 := svgF64x100(r);
  var start100: int64 := svgF64x100(startDeg);
  var end100:   int64 := svgF64x100(endDeg);
  var sx100: int64 := cx100 + (r100 * _svgCos10k(start100)) / 10000;
  var sy100: int64 := cy100 + (r100 * _svgSin10k(start100)) / 10000;
  var ex100: int64 := cx100 + (r100 * _svgCos10k(end100)) / 10000;
  var ey100: int64 := cy100 + (r100 * _svgSin10k(end100)) / 10000;
  _svgPc(doc, 77);
  _svgPi100(doc, cx100); _svgPc(doc, 32); _svgPi100(doc, cy100);
  _svgP(doc, " L ");
  _svgPi100(doc, sx100); _svgPc(doc, 32); _svgPi100(doc, sy100);
  _svgP(doc, " A ");
  _svgPi100(doc, r100); _svgPc(doc, 32); _svgPi100(doc, r100);
  _svgP(doc, " 0 ");
  var span100: int64 := end100 - start100;
  if (span100 < 0) { span100 := span100 + 36000; }
  if (span100 > 18000) { _svgP(doc, "1 1 "); } else { _svgP(doc, "0 1 "); }
  _svgPi100(doc, ex100); _svgPc(doc, 32); _svgPi100(doc, ey100);
  _svgP(doc, " Z");
}

// SvgPathStar: star with n points, outer radius r1, inner radius r2
pub fn SvgPathStar(doc: int64, cx: f64, cy: f64, r1: f64, r2: f64, n: int64): void {
  if (doc == 0 || n < 3) { return; }
  var cx100: int64 := svgF64x100(cx);
  var cy100: int64 := svgF64x100(cy);
  var r1x100: int64 := svgF64x100(r1);
  var r2x100: int64 := svgF64x100(r2);
  var step100: int64 := 36000 / n;  // degrees*100 per point
  var half100: int64 := step100 / 2;
  var i: int64 := 0;
  var total: int64 := n * 2;
  while (i < total) {
    var rad: int64 := 0;
    var r100: int64 := 0;
    if (i - (i / 2) * 2 == 0) {
      rad := i / 2 * step100 - 9000;  // outer point (adjusted -90°)
      r100 := r1x100;
    } else {
      rad := (i / 2) * step100 + half100 - 9000;
      r100 := r2x100;
    }
    var px100: int64 := cx100 + (r100 * _svgCos10k(rad)) / 10000;
    var py100: int64 := cy100 + (r100 * _svgSin10k(rad)) / 10000;
    if (i == 0) { _svgPc(doc, 77); } else { _svgPc(doc, 32); _svgPc(doc, 76); }
    _svgPi100(doc, px100); _svgPc(doc, 32); _svgPi100(doc, py100);
    i += 1;
  }
  _svgP(doc, " Z");
}

// SvgPathArrow: draws an arrow from (x1,y1) to (x2,y2)
pub fn SvgPathArrow(doc: int64, x1: f64, y1: f64, x2: f64, y2: f64, headLen: f64): void {
  if (doc == 0) { return; }
  // Line from start to end
  _svgPc(doc, 77);  // 'M'
  _svgPf(doc, x1); _svgPc(doc, 32); _svgPf(doc, y1);
  _svgP(doc, " L ");
  _svgPf(doc, x2); _svgPc(doc, 32); _svgPf(doc, y2);
  // Arrowhead: simple fixed-angle (30 degrees) using approximation
  var dx100: int64 := svgF64x100(x2) - svgF64x100(x1);
  var dy100: int64 := svgF64x100(y2) - svgF64x100(y1);
  var hl100: int64 := svgF64x100(headLen);
  // Use 30-degree arrowhead: cos(150°)=-0.866, sin(150°)=0.5
  // Approx: cos30*10000=8660, sin30*10000=5000
  // length of (dx,dy)
  // Simple: just add fixed arrowhead
  _svgP(doc, " M ");
  _svgPf(doc, x2); _svgPc(doc, 32); _svgPf(doc, y2);
}
