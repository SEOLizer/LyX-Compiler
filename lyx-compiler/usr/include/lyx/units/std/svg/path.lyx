// Arc: SvgArcSetup sets rx,ry,rot; SvgArcFlags sets laf,sf; SvgArcTo draws
pub fn SvgArcSetup(doc: int64, rx: f64, ry: f64, rot: f64): void {
  if (doc == 0) { return; }
  poke64(doc + SVG_ARC_RX, svgF64x100(rx));
  poke64(doc + SVG_ARC_RY, svgF64x100(ry));
  poke64(doc + SVG_ARC_ROT, svgF64x100(rot));
}

pub fn SvgArcFlags(doc: int64, laf: int64, sf: int64): void {
  if (doc == 0) { return; }
  poke64(doc + SVG_ARC_LAF, laf);
  poke64(doc + SVG_ARC_SF, sf);
}

pub fn SvgArcTo(doc: int64, x: f64, y: f64): void {
  if (doc == 0) { return; }
  _svgPc(doc, 32); _svgPc(doc, 65);  // 'A'
  _svgPi100(doc, peek64(doc + SVG_ARC_RX)); _svgPc(doc, 32);
  _svgPi100(doc, peek64(doc + SVG_ARC_RY)); _svgPc(doc, 32);
  _svgPi100(doc, peek64(doc + SVG_ARC_ROT)); _svgPc(doc, 32);
  _svgP(doc, IntToStr(peek64(doc + SVG_ARC_LAF))); _svgPc(doc, 32);
  _svgP(doc, IntToStr(peek64(doc + SVG_ARC_SF))); _svgPc(doc, 32);
  _svgPf(doc, x); _svgPc(doc, 32); _svgPf(doc, y);
}

