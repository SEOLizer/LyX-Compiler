// ============================================================================
// Timezone Handling
// ============================================================================

// Get local timezone offset in seconds east of UTC.
// Reads the TZ environment variable (POSIX format: e.g. "CET-1" → +3600,
// "EST5" → -18000). Returns 0 (UTC) if TZ is not set or cannot be parsed.
pub fn GetTimezoneOffset(): int64 {
    var tz: pchar := getenv("TZ");
    if (tz == 0) { return 0; }
    var len: int64 := StrLen(tz);
    if (len == 0) { return 0; }
    // Skip leading alphabetic characters (timezone name)
    var i: int64 := 0;
    var scanning: bool := true;
    while (scanning && i < len) {
        var c: int64 := StrCharAt(tz, i);
        var is_alpha: bool := (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
        if (is_alpha) {
            i += 1;
        } else {
            scanning := false;
        }
    }
    if (i >= len) { return 0; }
    // POSIX sign: '+' or no sign means west (positive offset = negative east-of-UTC)
    //             '-' means east (negative POSIX offset = positive east-of-UTC)
    var posix_sign: int64 := 1;
    var c0: int64 := StrCharAt(tz, i);
    if (c0 == 43) { posix_sign := 1; i := i + 1; }
    else if (c0 == 45) { posix_sign := -1; i := i + 1; }
    // Parse hours
    var hours: int64 := 0;
    var parsing: bool := true;
    while (parsing && i < len) {
        var c2: int64 := StrCharAt(tz, i);
        if (c2 >= 48 && c2 <= 57) {
            hours := hours * 10 + (c2 - 48);
            i += 1;
        } else {
            parsing := false;
        }
    }

    // #1416: Hier war Schluss — der Versatz wurde auf volle Stunden
    // abgeschnitten, ohne Hinweis. POSIX schreibt `hh[:mm[:ss]]`, und ein
    // halbstuendiger Versatz ist nichts Exotisches: Indien (+05:30), Iran
    // (+03:30), Nepal (+05:45), Neufundland (-03:30), Teile Australiens,
    // Chatham (+12:45). Fuer all diese Zonen lag die Zeit um eine halbe oder
    // dreiviertel Stunde daneben.
    var minutes: int64 := 0;
    var seconds: int64 := 0;
    if (i < len && StrCharAt(tz, i) == 58) {   // ':'
        i := i + 1;
        var mparse: bool := true;
        while (mparse && i < len) {
            var c3: int64 := StrCharAt(tz, i);
            if (c3 >= 48 && c3 <= 57) {
                minutes := minutes * 10 + (c3 - 48);
                i += 1;
            } else {
                mparse := false;
            }
        }
        if (i < len && StrCharAt(tz, i) == 58) {   // Sekunden, ebenfalls POSIX
            i := i + 1;
            var sparse: bool := true;
            while (sparse && i < len) {
                var c4: int64 := StrCharAt(tz, i);
                if (c4 >= 48 && c4 <= 57) {
                    seconds := seconds * 10 + (c4 - 48);
                    i += 1;
                } else {
                    sparse := false;
                }
            }
        }
    }

    // #1416: Die Sommerzeitregel hinter dem Zonennamen (`CET-1CEST,M3.5.0,...`)
    // wird weiterhin NICHT ausgewertet — das ist eine eigene Aufgabe und
    // braucht ein Datum, das diese Funktion gar nicht bekommt. Der zurueck-
    // gegebene Wert ist der Standardversatz der Zone; das steht jetzt hier,
    // damit es niemand fuer die aktuelle Ortszeit haelt.

    // east-of-UTC = -(POSIX offset)
    var gesamt: int64 := hours * 3600 + minutes * 60 + seconds;
    return 0 - (posix_sign * gesamt);
}

// Format timezone offset as "+HH:MM" or "-HH:MM"
pub fn FormatTimezoneOffset(offset_seconds: int64, output: pchar): int64 {
    var out_pos: int64 := 0;
    // Compute on absolute value — Lyx divides negative left operands as unsigned.
    var abs_off: int64 := offset_seconds;
    if (abs_off < 0) { abs_off := 0 - abs_off; }
    var offset_hours: int64 := abs_off / 3600;
    var offset_mins: int64 := (abs_off % 3600) / 60;
    if (offset_seconds >= 0) {
        StrSetChar(output, out_pos, 43); out_pos := out_pos + 1;
    } else {
        StrSetChar(output, out_pos, 45); out_pos := out_pos + 1;
    }
    StrSetChar(output, out_pos, (offset_hours / 10) + 48); out_pos := out_pos + 1;
    StrSetChar(output, out_pos, (offset_hours % 10) + 48); out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 58); out_pos := out_pos + 1;
    StrSetChar(output, out_pos, (offset_mins / 10) + 48); out_pos := out_pos + 1;
    StrSetChar(output, out_pos, (offset_mins % 10) + 48); out_pos := out_pos + 1;
    StrSetChar(output, out_pos, 0);
    return out_pos;
}

// ============================================================================
// Calendar Calculations
// ============================================================================

// #1820: DaysInMonth stand hier UND in std.time — der einzige Name, den
// beide Units exportierten. Wer beide importierte, bekam "mehrdeutiges
// Symbol" und konnte die Zeitbibliothek nicht zusammen benutzen. Die Fassung
// steht jetzt nur noch in std.time, von wo sie hier hereinkommt; die Rümpfe
// waren gleichwertig (std.time nutzt IsLeapYear statt der Bedingung inline).

// ISO 8601 week number (1–53).
pub fn WeekNumber(year: int64, month: int64, day: int64): int64 {
    var d: int64 := _dt_days_from_civil(year, month, day);
    // ISO day of week: 1=Monday, 7=Sunday. (d+3)%7: 0=Mon,6=Sun → +1 → 1..7
    var dow_raw: int64 := (d + 3) % 7;
    if (dow_raw < 0) { dow_raw := dow_raw + 7; }
    var dow_iso: int64 := dow_raw + 1;
    var doy: int64 := DayOfYear(year, month, day);
    var w: int64 := (doy - dow_iso + 10) / 7;
    if (w < 1) {
        // In last week of previous year — use Dec 28 of prev year (always in last week)
        var prev_doy: int64 := DayOfYear(year - 1, 12, 28);
        var prev_d: int64 := _dt_days_from_civil(year - 1, 12, 28);
        var prev_dow_raw: int64 := (prev_d + 3) % 7;
        if (prev_dow_raw < 0) { prev_dow_raw := prev_dow_raw + 7; }
        var prev_dow_iso: int64 := prev_dow_raw + 1;
        return (prev_doy - prev_dow_iso + 10) / 7;
    }
    if (w >= 53) {
        // May be week 1 of next year: check if this date is on or after next year's week 1 Monday
        var jan4_next: int64 := _dt_days_from_civil(year + 1, 1, 4);
        var jan4_dow_raw: int64 := (jan4_next + 3) % 7;
        if (jan4_dow_raw < 0) { jan4_dow_raw := jan4_dow_raw + 7; }
        var jan4_dow_iso: int64 := jan4_dow_raw + 1;
        var week1_start: int64 := jan4_next - (jan4_dow_iso - 1);
        if (d >= week1_start) { return 1; }
    }
    return w;
}

// ============================================================================
// #1601: Kalenderwerte <-> Zeitstempel
//
// Die Unit rechnete durchgehend auf Unix-Sekunden, bot aber keinen Weg, so
// einen Wert aus Jahr/Monat/Tag zu BAUEN oder ihn wieder zu ZERLEGEN. Die
// Helfer dafuer lagen seit jeher da, nur privat; der einzige Weg fuehrte ueber
// eine Zeichenkette (ISO-String zusammensetzen, ParseIso) beziehungsweise ueber
// Format("%Y") und Zurueckwandeln. Fuer eine Unit, die den Wert intern in
// Einzelteilen vorliegen hat, ist das ein Umweg ueber Textformatierung.
//
// std.time hat passende Funktionen, ist aber wegen DaysInMonth nicht gemeinsam
// mit std.datetime importierbar (#1262) — der Ausweg faellt also aus.
// ============================================================================

// Zeitstempel aus Kalenderwerten. Ohne Gueltigkeitspruefung: wer sie will,
// ruft vorher IsValidDateTime.
pub fn DatetimeFromYmdHms(year: int64, month: int64, day: int64,
                          hour: int64, minute: int64, second: int64): int64 {
    return _dt_days_from_civil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second;
}

pub fn DatetimeFromYmd(year: int64, month: int64, day: int64): int64 {
    return _dt_days_from_civil(year, month, day) * 86400;
}

pub fn YearOf(dt: int64): int64   { return _dt_year_from_days(_dt_days(dt)); }
pub fn MonthOf(dt: int64): int64  { return _dt_month_from_days(_dt_days(dt)); }
pub fn DayOf(dt: int64): int64    { return _dt_day_from_days(_dt_days(dt)); }
pub fn HourOf(dt: int64): int64   { return _dt_sod(dt) / 3600; }
pub fn MinuteOf(dt: int64): int64 { return (_dt_sod(dt) % 3600) / 60; }
pub fn SecondOf(dt: int64): int64 { return _dt_sod(dt) % 60; }

// Wochentag als ZAHL. WeekdayShort/WeekdayLong erwarten genau diese Zahl
// (0 = Sonntag), es gab in dieser Unit aber nichts, was sie liefert — die
// Namensfunktionen waren damit ohne Fremdhilfe nicht benutzbar.
pub fn DayOfWeek(dt: int64): int64 {
    var r: int64 := (_dt_days(dt) + 4) % 7;
    if (r < 0) { r := r + 7; }
    return r;
}

pub fn DayOfWeekYmd(year: int64, month: int64, day: int64): int64 {
    var r: int64 := (_dt_days_from_civil(year, month, day) + 4) % 7;
    if (r < 0) { r := r + 7; }
    return r;
}

// ISO-Wochenjahr. WeekNumber(2025, 12, 29) liefert 1 — das ist KW 1 von 2026.
// Ohne diese Funktion setzt der Aufrufer "2025-W01" zusammen und liegt um ein
// Jahr daneben.
pub fn WeekYear(year: int64, month: int64, day: int64): int64 {
    var w: int64 := WeekNumber(year, month, day);
    if (w >= 52 && month == 1)  { return year - 1; }
    if (w == 1  && month == 12) { return year + 1; }
    return year;
}

// #1601: die Einheiten zwischen Sekunde und Monat fehlten.
pub fn AddMinutes(datetime: int64, minutes: int64): int64 { return datetime + minutes * 60; }
pub fn AddHours(datetime: int64, hours: int64): int64     { return datetime + hours * 3600; }
pub fn AddWeeks(datetime: int64, weeks: int64): int64     { return datetime + weeks * 604800; }

// Vollstaendige Monate bzw. Jahre zwischen zwei Zeitpunkten — angefangene
// zaehlen nicht. Genau das braucht die haeufigste Anwendung ueberhaupt, das
// Alter aus einem Geburtsdatum; mit DiffDays und Division durch 365 wird es
// falsch.
pub fn DiffMonths(von: int64, bis: int64): int64 {
    var m: int64 := (YearOf(bis) - YearOf(von)) * 12 + (MonthOf(bis) - MonthOf(von));
    var tagRest: int64 := DayOf(bis) - DayOf(von);
    if (tagRest < 0) { m := m - 1; }
    else if (tagRest == 0 && _dt_sod(bis) < _dt_sod(von)) { m := m - 1; }
    return m;
}

pub fn DiffYears(von: int64, bis: int64): int64 { return DiffMonths(von, bis) / 12; }

// Tages- und Monatsgrenzen — der Normalfall jeder Auswertung.
pub fn StartOfDay(dt: int64): int64 { return _dt_days(dt) * 86400; }
pub fn EndOfDay(dt: int64): int64   { return _dt_days(dt) * 86400 + 86399; }

pub fn StartOfMonth(dt: int64): int64 {
    return _dt_days_from_civil(YearOf(dt), MonthOf(dt), 1) * 86400;
}

pub fn EndOfMonth(dt: int64): int64 {
    var j: int64 := YearOf(dt);
    var mo: int64 := MonthOf(dt);
    return _dt_days_from_civil(j, mo, DaysInMonth(j, mo)) * 86400 + 86399;
}

// Day of year (1–366)
pub fn DayOfYear(year: int64, month: int64, day: int64): int64 {
    var days: int64 := 0;
    var m: int64 := 1;
    while (m < month) {
        days := days + DaysInMonth(year, m);
        m += 1;
    }
    return days + day;
}

// ============================================================================
// Timestamp Conversions
// ============================================================================

// datetime IS a Unix timestamp — identity functions
pub fn ToUnixTimestamp(datetime: int64): int64 {
    return datetime;
}

pub fn FromUnixTimestamp(timestamp: int64): int64 {
    return timestamp;
}

pub fn ToMilliseconds(datetime: int64): int64 {
    return datetime * 1000;
}

pub fn FromMilliseconds(ms: int64): int64 {
    return ms / 1000;
}

// ============================================================================
// Validation
// ============================================================================

pub fn IsValidDate(year: int64, month: int64, day: int64): bool {
    if (month < 1 || month > 12) { return false; }
    if (day < 1) { return false; }
    var max_day: int64 := DaysInMonth(year, month);
    if (day > max_day) { return false; }
    return true;
}

pub fn IsValidTime(hour: int64, minute: int64, second: int64): bool {
    if (hour < 0 || hour > 23) { return false; }
    if (minute < 0 || minute > 59) { return false; }
    if (second < 0 || second > 59) { return false; }
    return true;
}

pub fn IsValidDateTime(year: int64, month: int64, day: int64, hour: int64, minute: int64, second: int64): bool {
    return IsValidDate(year, month, day) && IsValidTime(hour, minute, second);
}

// ============================================================================
// Arithmetic
// ============================================================================

pub fn AddSeconds(datetime: int64, seconds: int64): int64 {
    return datetime + seconds;
}

pub fn AddDays(datetime: int64, days: int64): int64 {
    return datetime + days * 86400;
}

// Add months, clamping day to the last valid day of the resulting month
pub fn AddMonths(datetime: int64, months: int64): int64 {
    var d: int64 := _dt_days(datetime);
    var sod: int64 := _dt_sod(datetime);
    var year: int64 := _dt_year_from_days(d);
    var month: int64 := _dt_month_from_days(d);
    var day: int64 := _dt_day_from_days(d);
    month += months;
    var reducing: bool := true;
    while (reducing && month > 12) { month := month - 12; year := year + 1; if (month <= 12) { reducing := false; } }
    var expanding: bool := true;
    while (expanding && month < 1) { month := month + 12; year := year - 1; if (month >= 1) { expanding := false; } }
    var max_day: int64 := DaysInMonth(year, month);
    if (day > max_day) { day := max_day; }
    var new_days: int64 := _dt_days_from_civil(year, month, day);
    return new_days * 86400 + sod;
}

pub fn AddYears(datetime: int64, years: int64): int64 {
    var d: int64 := _dt_days(datetime);
    var sod: int64 := _dt_sod(datetime);
    var year: int64 := _dt_year_from_days(d);
    var month: int64 := _dt_month_from_days(d);
    var day: int64 := _dt_day_from_days(d);
    year += years;
    var max_day: int64 := DaysInMonth(year, month);
    if (day > max_day) { day := max_day; }
    var new_days: int64 := _dt_days_from_civil(year, month, day);
    return new_days * 86400 + sod;
}

pub fn DiffSeconds(datetime1: int64, datetime2: int64): int64 {
    return datetime2 - datetime1;
}

pub fn DiffDays(year1: int64, month1: int64, day1: int64, year2: int64, month2: int64, day2: int64): int64 {
    var d1: int64 := _dt_days_from_civil(year1, month1, day1);
    var d2: int64 := _dt_days_from_civil(year2, month2, day2);
    return d2 - d1;
}
