unit std.datetime;

import std.time;
import std.env;
import std.alloc;

// datetime is a Unix timestamp (int64, seconds since epoch)

// #1179: ein Symbol, das es nirgends gibt — `FormatRelative` rechnete damit
// seit jeher gegen die Epoche statt gegen die aktuelle Zeit. clock_gettime
// (Syscall 228) ist die Quelle, die `system.time` durchlaesst.
fn now_unix(): int64 {
  var buf: int64 := alloc(16);
  sys_clock_gettime(0, buf);
  var sec: int64 := peek64(buf);
  free(buf, 16);
  return sec;
}
// #1179: Hier stand `extern fn getenv(name: pchar): pchar;` OHNE
// link-Klausel — das Symbol wurde nie gebunden, der Aufruf lieferte still 0,
// und jede Abfrage sah aus wie eine nicht gesetzte Variable. Die Umgebung
// liegt beim Start auf dem Stack; std.env liest sie ohne C-Bibliothek.
fn getenv(name: pchar): pchar { return EnvLookupRaw(name); }

// ============================================================================
// Format Strings
// ============================================================================

// Common format specifiers:
// %Y - 4-digit year (e.g., 2024)
// %y - 2-digit year (e.g., 24)
// %m - 2-digit month (01-12)
// %d - 2-digit day (01-31)
// %H - 2-digit hour (00-23)
// %M - 2-digit minute (00-59)
// %S - 2-digit second (00-59)
// %f - 6-digit microseconds
// %w - weekday (0-6, Sunday=0)
// %W - weekday name (Sunday, Monday, ...)
// %b - month name (Jan, Feb, ...)
// %B - full month name (January, February, ...)
// %p - AM/PM
// %z - timezone offset (e.g., +0200)
// %Z - timezone name (e.g., CET, UTC)

// ============================================================================
// Private: Civil calendar (Howard Hinnant algorithm)
// ============================================================================

// Days since Unix epoch from calendar date
fn _dt_days_from_civil(year: int64, month: int64, day: int64): int64 {
    var y: int64 := year;
    var m: int64 := month;
    var d: int64 := day;
    if (m <= 2) {
        y -= 1;
        m += 12;
    }
    var era: int64 := y / 400;
    if (y < 0) {
        if ((y % 400) != 0) { era := era - 1; }
    }
    var eraY: int64 := era * 400;
    var yoe: int64 := y - eraY;
    var m3: int64 := m - 3;
    var m3_153: int64 := 153 * m3;
    var m3_153_2: int64 := m3_153 + 2;
    var doy_part: int64 := m3_153_2 / 5;
    var doy1: int64 := doy_part + d;
    var doy: int64 := doy1 - 1;
    var yoe365: int64 := yoe * 365;
    var yoe4: int64 := yoe / 4;
    var yoe100: int64 := yoe / 100;
    var doe1: int64 := yoe365 + yoe4;
    var doe2: int64 := doe1 - yoe100;
    var doe: int64 := doe2 + doy;
    var era146097: int64 := era * 146097;
    var r1: int64 := era146097 + doe;
    return r1 - 719468;
}

fn _dt_year_from_days(days: int64): int64 {
    var z: int64 := days + 719468;
    var era: int64 := z / 146097;
    if (z < 0) {
        if ((z % 146097) != 0) { era := era - 1; }
    }
    var eraY: int64 := era * 146097;
    var doe: int64 := z - eraY;
    var doe1460: int64 := doe / 1460;
    var doe36524: int64 := doe / 36524;
    var doe146096: int64 := doe / 146096;
    var s1: int64 := doe - doe1460;
    var s2: int64 := s1 + doe36524;
    var s3: int64 := s2 - doe146096;
    var yoe: int64 := s3 / 365;
    var era400: int64 := era * 400;
    var y: int64 := yoe + era400;
    // Howard Hinnant algorithm uses a March-based year internally.
    // For January and February the civil year is one higher than the internal year.
    var m: int64 := _dt_month_from_days(days);
    if (m <= 2) { y := y + 1; }
    return y;
}

fn _dt_month_from_days(days: int64): int64 {
    var z: int64 := days + 719468;
    var era: int64 := z / 146097;
    if (z < 0) {
        if ((z % 146097) != 0) { era := era - 1; }
    }
    var eraY: int64 := era * 146097;
    var doe: int64 := z - eraY;
    var doe1460: int64 := doe / 1460;
    var doe36524: int64 := doe / 36524;
    var doe146096: int64 := doe / 146096;
    var s1: int64 := doe - doe1460;
    var s2: int64 := s1 + doe36524;
    var s3: int64 := s2 - doe146096;
    var yoe: int64 := s3 / 365;
    var yoe365: int64 := 365 * yoe;
    var yoe4: int64 := yoe / 4;
    var yoe100: int64 := yoe / 100;
    var yd1: int64 := yoe365 + yoe4;
    var yd2: int64 := yd1 - yoe100;
    var doy: int64 := doe - yd2;
    var doy5: int64 := 5 * doy;
    var doy5_2: int64 := doy5 + 2;
    var mp: int64 := doy5_2 / 153;
    var month: int64 := mp + 3;
    if (mp >= 10) { month := month - 12; }
    return month;
}

fn _dt_day_from_days(days: int64): int64 {
    var z: int64 := days + 719468;
    var era: int64 := z / 146097;
    if (z < 0) {
        if ((z % 146097) != 0) { era := era - 1; }
    }
    var eraY: int64 := era * 146097;
    var doe: int64 := z - eraY;
    var doe1460: int64 := doe / 1460;
    var doe36524: int64 := doe / 36524;
    var doe146096: int64 := doe / 146096;
    var s1: int64 := doe - doe1460;
    var s2: int64 := s1 + doe36524;
    var s3: int64 := s2 - doe146096;
    var yoe: int64 := s3 / 365;
    var yoe365: int64 := 365 * yoe;
    var yoe4: int64 := yoe / 4;
    var yoe100: int64 := yoe / 100;
    var yd1: int64 := yoe365 + yoe4;
    var yd2: int64 := yd1 - yoe100;
    var doy: int64 := doe - yd2;
    var doy5: int64 := 5 * doy;
    var doy5_2: int64 := doy5 + 2;
    var mp: int64 := doy5_2 / 153;
    var mp153: int64 := 153 * mp;
    var mp153_2: int64 := mp153 + 2;
    var mp153_2_5: int64 := mp153_2 / 5;
    return doy - mp153_2_5 + 1;
}

// Floor-divide days from unix timestamp.
// Lyx's / operator is unsigned for negative left operands, so we handle the
// sign manually: compute on the absolute value and restore the sign.
fn _dt_days(ts: int64): int64 {
    if (ts >= 0) { return ts / 86400; }
    var n: int64 := 0 - ts;
    var d: int64 := n / 86400;
    if ((n % 86400) != 0) { d := d + 1; }
    return 0 - d;
}

// Seconds within the day [0..86399] (always non-negative).
// Same workaround: avoid dividing/modding negative operand.
fn _dt_sod(ts: int64): int64 {
    if (ts >= 0) { return ts % 86400; }
    var n: int64 := 0 - ts;
    var r: int64 := n % 86400;
    if (r == 0) { return 0; }
    return 86400 - r;
}

// ============================================================================
// Private: Output helpers
// ============================================================================

// Emit 2-digit zero-padded integer at pos; return new pos
fn _dt_emit2(output: pchar, pos: int64, val: int64): int64 {
    // #1605: ausserhalb 0..99 gibt es keine zweistellige Darstellung.
    if (val < 0 || val > 99) { return _dt_emitNum(output, pos, val); }
    StrSetChar(output, pos,     (val / 10) + 48);
    StrSetChar(output, pos + 1, (val % 10) + 48);
    return pos + 2;
}

// Emit 4-digit zero-padded integer at pos; return new pos
fn _dt_emit4(output: pchar, pos: int64, val: int64): int64 {
    // #1605: Jahre ausserhalb 1000..9999 (auch negative) erzeugten Muell —
    // vollstaendig ausgeben ist die einzige ehrliche Antwort.
    if (val < 0 || val > 9999) { return _dt_emitNum(output, pos, val); }
    StrSetChar(output, pos,     (val / 1000) + 48);
    StrSetChar(output, pos + 1, ((val / 100) % 10) + 48);
    StrSetChar(output, pos + 2, ((val / 10) % 10) + 48);
    StrSetChar(output, pos + 3, (val % 10) + 48);
    return pos + 4;
}

// Emit string s at pos; return new pos
fn _dt_emitStr(output: pchar, pos: int64, s: pchar): int64 {
    var i: int64 := 0;
    var len: int64 := StrLen(s);
    while (i < len) {
        StrSetChar(output, pos + i, StrCharAt(s, i));
        i += 1;
    }
    return pos + len;
}

// Emit decimal integer (variable digit count) at pos; return new pos
//
// #1605: Die Funktion hoerte bei vier Stellen auf — ein groesserer Wert verlor
// alles darueber, und die verbleibenden Stellen sahen aus wie ein Ergebnis.
// Jetzt wird die Zahl gezaehlt statt geraten. Der Kalenderkern selbst rechnet
// richtig (7236 Datensaetze gegen Pythons datetime, null Abweichungen); falsch
// war allein die Zeichenausgabe.
fn _dt_emitNum(output: pchar, pos: int64, val: int64): int64 {
    var w: int64 := val;
    if (w < 0) {
        StrSetChar(output, pos, 45);      // '-'
        pos += 1;
        w := 0 - w;
    }
    if (w == 0) {
        StrSetChar(output, pos, 48);
        return pos + 1;
    }
    // Stellenzahl bestimmen, dann von hinten fuellen.
    var stellen: int64 := 0;
    var rest: int64 := w;
    while (rest > 0) { stellen := stellen + 1; rest := rest / 10; }
    var i: int64 := stellen - 1;
    rest := w;
    while (i >= 0) {
        StrSetChar(output, pos + i, (rest % 10) + 48);
        rest := rest / 10;
        i := i - 1;
    }
    return pos + stellen;
}

// #1605: zweistellig mit fuehrender Null — aber nur, wenn der Wert auch
// zweistellig IST. Ausserhalb von 0..99 wuerde die Stellenrechnung Zeichen
// unterhalb von '0' erzeugen (aus -45 wurde ",+"); dann lieber die Zahl
// vollstaendig ausgeben als etwas Falsches in der richtigen Breite.
fn _dt_emit2s(output: pchar, pos: int64, val: int64): int64 {
    if (val < 0 || val > 99) { return _dt_emitNum(output, pos, val); }
    StrSetChar(output, pos,     (val / 10) + 48);
    StrSetChar(output, pos + 1, (val % 10) + 48);
    return pos + 2;
}

// ============================================================================
// Private: Parsing helpers
// ============================================================================

// Parse 2-digit integer at position pos in string s
fn _dt_parse2(s: pchar, pos: int64): int64 {
    var a: int64 := StrCharAt(s, pos) - 48;
    var b: int64 := StrCharAt(s, pos + 1) - 48;
    return a * 10 + b;
}

// Parse 4-digit integer at position pos
fn _dt_parse4(s: pchar, pos: int64): int64 {
    var a: int64 := StrCharAt(s, pos) - 48;
    var b: int64 := StrCharAt(s, pos + 1) - 48;
    var c: int64 := StrCharAt(s, pos + 2) - 48;
    var d: int64 := StrCharAt(s, pos + 3) - 48;
    return a * 1000 + b * 100 + c * 10 + d;
}

// Parse 3-char month abbreviation at position pos; return month 1–12 or 0
fn _dt_parse_month(s: pchar, pos: int64): int64 {
    var c0: int64 := StrCharAt(s, pos);
    var c1: int64 := StrCharAt(s, pos + 1);
    var c2: int64 := StrCharAt(s, pos + 2);
    // Jan=74,97,110  Feb=70,101,98  Mar=77,97,114  Apr=65,112,114
    // May=77,97,121  Jun=74,117,110 Jul=74,117,108  Aug=65,117,103
    // Sep=83,101,112 Oct=79,99,116  Nov=78,111,118  Dec=68,101,99
    if (c0 == 74) {
        if (c2 == 110 && c1 == 97) { return 1; }   // Jan
        if (c2 == 110 && c1 == 117) { return 6; }  // Jun
        if (c2 == 108) { return 7; }               // Jul
    }
    if (c0 == 70) { return 2; }   // Feb
    if (c0 == 77) {
        if (c2 == 114) { return 3; }  // Mar
        return 5;                     // May
    }
    if (c0 == 65) {
        if (c1 == 112) { return 4; }  // Apr
        return 8;                     // Aug
    }
    if (c0 == 83) { return 9; }   // Sep
    if (c0 == 79) { return 10; }  // Oct
    if (c0 == 78) { return 11; }  // Nov
    if (c0 == 68) { return 12; }  // Dec
    return 0;
}

// ============================================================================
// Formatting Functions
// ============================================================================

// Format datetime using format string (see specifiers above).
// Returns length of written string, or -1 on error.
pub fn Format(datetime: int64, fmt: pchar, output: pchar): int64 {
    if (fmt == 0 || output == 0) { return -1; }
    var days: int64 := _dt_days(datetime);
    var sod: int64 := _dt_sod(datetime);
    var year: int64 := _dt_year_from_days(days);
    var month: int64 := _dt_month_from_days(days);
    var day: int64 := _dt_day_from_days(days);
    var hour: int64 := sod / 3600;
    var minute: int64 := (sod % 3600) / 60;
    var second: int64 := sod % 60;
    var dow_raw: int64 := (days + 4) % 7;
    if (dow_raw < 0) { dow_raw := dow_raw + 7; }
    var dow: int64 := dow_raw;  // 0=Sunday
    var fmt_len: int64 := StrLen(fmt);
    var out_pos: int64 := 0;
    var unbekannt: int64 := 0;      // #1602
    var i: int64 := 0;
    while (i < fmt_len) {
        var c: int64 := StrCharAt(fmt, i);
        if (c == 37) {
            i += 1;
            var spec: int64 := StrCharAt(fmt, i);
            if (spec == 89) {                             // %Y - year 4-digit
                out_pos := _dt_emit4(output, out_pos, year);
            } else if (spec == 121) {                    // %y - year 2-digit
                out_pos := _dt_emit2(output, out_pos, year % 100);
            } else if (spec == 109) {                    // %m - month 01-12
                out_pos := _dt_emit2(output, out_pos, month);
            } else if (spec == 100) {                    // %d - day 01-31
                out_pos := _dt_emit2(output, out_pos, day);
            } else if (spec == 72) {                     // %H - hour 00-23
                out_pos := _dt_emit2(output, out_pos, hour);
            } else if (spec == 77) {                     // %M - minute 00-59
                out_pos := _dt_emit2(output, out_pos, minute);
            } else if (spec == 83) {                     // %S - second 00-59
                out_pos := _dt_emit2(output, out_pos, second);
            } else if (spec == 102) {                    // %f - microseconds (always 000000)
                out_pos := _dt_emitStr(output, out_pos, "000000");
            } else if (spec == 119) {                    // %w - weekday 0=Sun
                StrSetChar(output, out_pos, dow + 48);
                out_pos += 1;
            } else if (spec == 87) {                     // %W - weekday long name
                out_pos := _dt_emitStr(output, out_pos, WeekdayLong(dow));
            } else if (spec == 98) {                     // %b - month short name
                out_pos := _dt_emitStr(output, out_pos, MonthShort(month));
            } else if (spec == 66) {                     // %B - month long name
                out_pos := _dt_emitStr(output, out_pos, MonthLong(month));
            } else if (spec == 112) {                    // %p - AM/PM
                if (hour < 12) {
                    out_pos := _dt_emitStr(output, out_pos, "AM");
                } else {
                    out_pos := _dt_emitStr(output, out_pos, "PM");
                }
            } else if (spec == 122) {                    // %z - offset +HHMM
                var tz_off: int64 := GetTimezoneOffset();
                var tz_abs: int64 := tz_off;
                if (tz_abs < 0) { tz_abs := 0 - tz_abs; }
                if (tz_off < 0) {
                    StrSetChar(output, out_pos, 45);
                } else {
                    StrSetChar(output, out_pos, 43);
                }
                out_pos += 1;
                out_pos := _dt_emit2(output, out_pos, tz_abs / 3600);
                out_pos := _dt_emit2(output, out_pos, (tz_abs % 3600) / 60);
            } else if (spec == 90) {                     // %Z - timezone name
                out_pos := _dt_emitStr(output, out_pos, "UTC");
            } else if (spec == 73) {                     // %I - Stunde 01-12
                // #1602: `%p` gab AM/PM aus, die 12-Stunden-Zahl gab es nicht —
                // damit war %p fuer sich genommen nutzlos ("14:30 PM"). Die
                // Umrechnung stand schon in FormatLocale fuer en_US.
                var h12: int64 := hour % 12;
                if (h12 == 0) { h12 := 12; }
                out_pos := _dt_emit2(output, out_pos, h12);
            } else if (spec == 106) {                    // %j - Tag im Jahr 001-366
                // #1602: DayOfYear ist in dieser Unit oeffentlich und rechnet
                // richtig; es fehlte allein die Anbindung.
                var doy: int64 := DayOfYear(year, month, day);
                out_pos := _dt_emit2(output, out_pos, doy / 10);
                StrSetChar(output, out_pos, (doy % 10) + 48);
                out_pos += 1;
            } else if (spec == 37) {                     // %% - ein Prozentzeichen
                // #1602: Ohne Escape liess sich ein Prozentzeichen ueberhaupt
                // nicht ausgeben.
                StrSetChar(output, out_pos, 37);
                out_pos += 1;
            } else {
                // #1602: Ein unbekannter Spezifizierer landete WOERTLICH in der
                // Ausgabe — der Aufruf meldete Erfolg, die Zeichenkette sah
                // plausibel aus, und ein Tippfehler im Formatstring fiel erst
                // beim Lesen auf. Er wird weiterhin durchgereicht (eine
                // Formatierung soll nicht mitten im Text abbrechen), aber der
                // Rueckgabewert sagt es jetzt: negativ heisst "es standen
                // unbekannte Spezifizierer darin".
                unbekannt := unbekannt + 1;
                StrSetChar(output, out_pos, 37);
                out_pos += 1;
                StrSetChar(output, out_pos, spec);
                out_pos += 1;
            }
        } else {
            StrSetChar(output, out_pos, c);
            out_pos += 1;
        }
        i += 1;
    }
    StrSetChar(output, out_pos, 0);
    // #1602: Die Ausgabe steht vollstaendig im Puffer; der Rueckgabewert
    // unterscheidet jetzt zwischen "alles verstanden" (Laenge) und "es waren
    // unbekannte Spezifizierer dabei" (negative Laenge). Wer ihn wie bisher
    // ignoriert, bekommt dieselbe Zeichenkette wie zuvor.
    if (unbekannt > 0) { return 0 - out_pos; }
    return out_pos;
}

// Format date only (YYYY-MM-DD)
pub fn FormatDate(year: int64, month: int64, day: int64, output: pchar): int64 {
    StrSetChar(output, 0, (year / 1000) + 48);
    StrSetChar(output, 1, ((year / 100) % 10) + 48);
    StrSetChar(output, 2, ((year / 10) % 10) + 48);
    StrSetChar(output, 3, (year % 10) + 48);
    StrSetChar(output, 4, 45);
    StrSetChar(output, 5, (month / 10) + 48);
    StrSetChar(output, 6, (month % 10) + 48);
    StrSetChar(output, 7, 45);
    StrSetChar(output, 8, (day / 10) + 48);
    StrSetChar(output, 9, (day % 10) + 48);
    StrSetChar(output, 10, 0);
    return 10;
}

// Format time only (HH:MM:SS)
pub fn FormatTime(hour: int64, minute: int64, second: int64, output: pchar): int64 {
    StrSetChar(output, 0, (hour / 10) + 48);
    StrSetChar(output, 1, (hour % 10) + 48);
    StrSetChar(output, 2, 58);
    StrSetChar(output, 3, (minute / 10) + 48);
    StrSetChar(output, 4, (minute % 10) + 48);
    StrSetChar(output, 5, 58);
    StrSetChar(output, 6, (second / 10) + 48);
    StrSetChar(output, 7, (second % 10) + 48);
    StrSetChar(output, 8, 0);
    return 8;
}

// Format ISO 8601: YYYY-MM-DDTHH:MM:SSZ
pub fn FormatIso(datetime: int64, output: pchar): int64 {
    var days: int64 := _dt_days(datetime);
    var sod: int64 := _dt_sod(datetime);
    var year: int64 := _dt_year_from_days(days);
    var month: int64 := _dt_month_from_days(days);
    var day: int64 := _dt_day_from_days(days);
    var hour: int64 := sod / 3600;
    var minute: int64 := (sod % 3600) / 60;
    var second: int64 := sod % 60;
    var pos: int64 := 0;
    pos := _dt_emit4(output, pos, year);
    StrSetChar(output, pos, 45); pos := pos + 1;
    pos := _dt_emit2(output, pos, month);
    StrSetChar(output, pos, 45); pos := pos + 1;
    pos := _dt_emit2(output, pos, day);
    StrSetChar(output, pos, 84); pos := pos + 1;  // 'T'
    pos := _dt_emit2(output, pos, hour);
    StrSetChar(output, pos, 58); pos := pos + 1;  // ':'
    pos := _dt_emit2(output, pos, minute);
    StrSetChar(output, pos, 58); pos := pos + 1;
    pos := _dt_emit2(output, pos, second);
    StrSetChar(output, pos, 90); pos := pos + 1;  // 'Z'
    StrSetChar(output, pos, 0);
    return pos;
}

// Format RFC 2822: Mon, 15 Jan 2024 14:30:00 +0000
pub fn FormatRfc2822(datetime: int64, output: pchar): int64 {
    var days: int64 := _dt_days(datetime);
    var sod: int64 := _dt_sod(datetime);
    var year: int64 := _dt_year_from_days(days);
    var month: int64 := _dt_month_from_days(days);
    var day: int64 := _dt_day_from_days(days);
    var hour: int64 := sod / 3600;
    var minute: int64 := (sod % 3600) / 60;
    var second: int64 := sod % 60;
    var dow_raw: int64 := (days + 4) % 7;
    if (dow_raw < 0) { dow_raw := dow_raw + 7; }
    var pos: int64 := 0;
    pos := _dt_emitStr(output, pos, WeekdayShort(dow_raw));
    StrSetChar(output, pos, 44); pos := pos + 1;  // ','
    StrSetChar(output, pos, 32); pos := pos + 1;  // ' '
    pos := _dt_emit2(output, pos, day);
    StrSetChar(output, pos, 32); pos := pos + 1;
    pos := _dt_emitStr(output, pos, MonthShort(month));
    StrSetChar(output, pos, 32); pos := pos + 1;
    pos := _dt_emit4(output, pos, year);
    StrSetChar(output, pos, 32); pos := pos + 1;
    pos := _dt_emit2(output, pos, hour);
    StrSetChar(output, pos, 58); pos := pos + 1;
    pos := _dt_emit2(output, pos, minute);
    StrSetChar(output, pos, 58); pos := pos + 1;
    pos := _dt_emit2(output, pos, second);
    StrSetChar(output, pos, 32); pos := pos + 1;
    pos := _dt_emitStr(output, pos, "+0000");
    StrSetChar(output, pos, 0);
    return pos;
}

// Format with locale (simplified: delegates to FormatIso)
// #1415: Hier stand `return FormatIso(datetime, output);` — der
// locale-Parameter wurde entgegengenommen und nie angesehen. Jeder Wert
// lieferte dieselbe ISO-Ausgabe, und weil eine gueltige Zeichenkette
// zurueckkam, fiel es niemandem auf; die Doku fuehrte die Funktion derweil
// als „formatiert lokalisiert nach Locale".
//
// Umgesetzt sind die Formen, die man an einer Oberflaeche wirklich braucht.
// Verglichen werden die ersten beiden Zeichen (die Sprache) und, wo es einen
// Unterschied macht, das Land:
//
//   de, at, ch      17.08.2026 07:45:12      Tag.Monat.Jahr, 24 Stunden
//   en_US           8/17/2026 7:45:12 AM     Monat/Tag/Jahr, 12 Stunden
//   en (sonst)      17/08/2026 07:45:12      Tag/Monat/Jahr, 24 Stunden
//   fr, es, it, pt  17/08/2026 07:45:12
//
// Eine unbekannte Locale liefert weiterhin ISO 8601 — aber nicht mehr
// stillschweigend: LocaleSupported sagt vorher, ob eine Form bekannt ist. Ein
// Fehlerwert waere hier falsch, denn eine technisch richtige Zeitangabe ist
// besser als keine.
pub fn LocaleSupported(locale: pchar): bool {
    if (locale == 0) { return false; }
    if (StrLen(locale) < 2) { return false; }
    var a: int64 := StrCharAt(locale, 0);
    var b: int64 := StrCharAt(locale, 1);
    if (a == 100 && b == 101) { return true; }   // de
    if (a == 97  && b == 116) { return true; }   // at
    if (a == 99  && b == 104) { return true; }   // ch
    if (a == 101 && b == 110) { return true; }   // en
    if (a == 102 && b == 114) { return true; }   // fr
    if (a == 101 && b == 115) { return true; }   // es
    if (a == 105 && b == 116) { return true; }   // it
    if (a == 112 && b == 116) { return true; }   // pt
    return false;
}

// Ein- oder zweistellig, ohne fuehrende Null (fuer en_US).
fn _dt_emit1or2(output: pchar, pos: int64, val: int64): int64 {
    var p: int64 := pos;
    if (val >= 10) {
        StrSetChar(output, p, (val / 10) + 48);
        p := p + 1;
    }
    StrSetChar(output, p, (val % 10) + 48);
    return p + 1;
}

pub fn FormatLocale(datetime: int64, locale: pchar, output: pchar): int64 {
    if (LocaleSupported(locale) == false) { return FormatIso(datetime, output); }

    var days: int64 := _dt_days(datetime);
    var sod:  int64 := _dt_sod(datetime);
    var year:   int64 := _dt_year_from_days(days);
    var month:  int64 := _dt_month_from_days(days);
    var day:    int64 := _dt_day_from_days(days);
    var hour:   int64 := sod / 3600;
    var minute: int64 := (sod % 3600) / 60;
    var second: int64 := sod % 60;

    var a: int64 := StrCharAt(locale, 0);
    var b: int64 := StrCharAt(locale, 1);

    // en_US: Monat/Tag/Jahr mit 12-Stunden-Zaehlung
    var istUS: int64 := 0;
    if (a == 101 && b == 110 && StrLen(locale) >= 5) {
        if (StrCharAt(locale, 3) == 85 && StrCharAt(locale, 4) == 83) { istUS := 1; }
    }

    var pos: int64 := 0;
    if (istUS == 1) {
        pos := _dt_emit1or2(output, pos, month);
        StrSetChar(output, pos, 47); pos := pos + 1;   // '/'
        pos := _dt_emit1or2(output, pos, day);
        StrSetChar(output, pos, 47); pos := pos + 1;
        pos := _dt_emit4(output, pos, year);
        StrSetChar(output, pos, 32); pos := pos + 1;

        var h12: int64 := hour % 12;
        if (h12 == 0) { h12 := 12; }
        pos := _dt_emit1or2(output, pos, h12);
        StrSetChar(output, pos, 58); pos := pos + 1;
        pos := _dt_emit2(output, pos, minute);
        StrSetChar(output, pos, 58); pos := pos + 1;
        pos := _dt_emit2(output, pos, second);
        StrSetChar(output, pos, 32); pos := pos + 1;
        if (hour < 12) { StrSetChar(output, pos, 65); } else { StrSetChar(output, pos, 80); }
        pos := pos + 1;
        StrSetChar(output, pos, 77); pos := pos + 1;   // 'M'
        StrSetChar(output, pos, 0);
        return pos;
    }

    // Alles uebrige: Tag zuerst. Der deutschsprachige Raum trennt mit Punkt,
    // die uebrigen mit Schraegstrich.
    var punkt: int64 := 0;
    if (a == 100 && b == 101) { punkt := 1; }   // de
    if (a == 97  && b == 116) { punkt := 1; }   // at
    if (a == 99  && b == 104) { punkt := 1; }   // ch

    pos := _dt_emit2(output, pos, day);
    if (punkt == 1) { StrSetChar(output, pos, 46); } else { StrSetChar(output, pos, 47); }
    pos := pos + 1;
    pos := _dt_emit2(output, pos, month);
    if (punkt == 1) { StrSetChar(output, pos, 46); } else { StrSetChar(output, pos, 47); }
    pos := pos + 1;
    pos := _dt_emit4(output, pos, year);
    StrSetChar(output, pos, 32); pos := pos + 1;
    pos := _dt_emit2(output, pos, hour);
    StrSetChar(output, pos, 58); pos := pos + 1;
    pos := _dt_emit2(output, pos, minute);
    StrSetChar(output, pos, 58); pos := pos + 1;
    pos := _dt_emit2(output, pos, second);
    StrSetChar(output, pos, 0);
    return pos;
}

// ============================================================================
// Parsing Functions
// ============================================================================

// Parse YYYY-MM-DD. year/month/day are int64 pointers (poke64 targets).
// Returns 1 on success, 0 on error.
pub fn ParseDate(input: pchar, year: int64, month: int64, day: int64): int64 {
    poke64(year, 0); poke64(month, 0); poke64(day, 0);   // #1603
    if (input == 0) { return 0; }
    var len: int64 := StrLen(input);
    if (len < 10) { return 0; }
    if (StrCharAt(input, 4) != 45) { return 0; }  // '-'
    if (StrCharAt(input, 7) != 45) { return 0; }
    var y: int64 := _dt_parse4(input, 0);
    var m: int64 := _dt_parse2(input, 5);
    var d: int64 := _dt_parse2(input, 8);
    if (m < 1 || m > 12 || d < 1 || d > 31) { return 0; }
    poke64(year, y);
    poke64(month, m);
    poke64(day, d);
    return 1;
}

// Parse HH:MM:SS or HH:MM. hour/minute/second are int64 pointers.
// Returns 1 on success, 0 on error.
pub fn ParseTime(input: pchar, hour: int64, minute: int64, second: int64): int64 {
    poke64(hour, 0); poke64(minute, 0); poke64(second, 0);   // #1603
    if (input == 0) { return 0; }
    var len: int64 := StrLen(input);
    if (len < 5) { return 0; }
    if (StrCharAt(input, 2) != 58) { return 0; }  // ':'
    var h: int64 := _dt_parse2(input, 0);
    var m: int64 := _dt_parse2(input, 3);
    var s: int64 := 0;
    if (len >= 8 && StrCharAt(input, 5) == 58) {
        s := _dt_parse2(input, 6);
    }
    if (h > 23 || m > 59 || s > 59) { return 0; }
    poke64(hour, h);
    poke64(minute, m);
    poke64(second, s);
    return 1;
}

// Parse ISO 8601 (YYYY-MM-DDTHH:MM:SSZ). result is int64 pointer.
// Returns 1 on success, 0 on error.
pub fn ParseIso(input: pchar, result: int64): int64 {
    poke64(result, 0);            // #1603: definierter Wert bei Misserfolg
    if (input == 0) { return 0; }
    var len: int64 := StrLen(input);
    if (len < 19) { return 0; }
    if (StrCharAt(input, 4) != 45) { return 0; }   // '-'
    if (StrCharAt(input, 7) != 45) { return 0; }
    if (StrCharAt(input, 10) != 84) { return 0; }  // 'T'
    if (StrCharAt(input, 13) != 58) { return 0; }  // ':'
    if (StrCharAt(input, 16) != 58) { return 0; }
    var y: int64 := _dt_parse4(input, 0);
    var mo: int64 := _dt_parse2(input, 5);
    var d: int64 := _dt_parse2(input, 8);
    var h: int64 := _dt_parse2(input, 11);
    var mi: int64 := _dt_parse2(input, 14);
    var s: int64 := _dt_parse2(input, 17);
    if (mo < 1 || mo > 12 || d < 1 || d > 31) { return 0; }
    if (h > 23 || mi > 59 || s > 59) { return 0; }
    var days: int64 := _dt_days_from_civil(y, mo, d);
    var ts: int64 := days * 86400 + h * 3600 + mi * 60 + s;
    poke64(result, ts);
    return 1;
}

// Parse RFC 2822 (Www, DD Mon YYYY HH:MM:SS +ZZZZ). result is int64 pointer.
// Returns 1 on success, 0 on error.
pub fn ParseRfc2822(input: pchar, result: int64): int64 {
    poke64(result, 0);            // #1603
    if (input == 0) { return 0; }
    var len: int64 := StrLen(input);
    if (len < 25) { return 0; }
    // Format: "Mon, 15 Jan 2024 14:30:00 +0000"
    // Skip weekday (3 chars) + ", " (2 chars) = position 5
    if (StrCharAt(input, 3) != 44) { return 0; }  // ','
    var pos: int64 := 5;
    var d: int64 := _dt_parse2(input, pos);
    pos += 3;  // DD + space
    var mo: int64 := _dt_parse_month(input, pos);
    if (mo == 0) { return 0; }
    pos += 4;  // Mon + space
    var y: int64 := _dt_parse4(input, pos);
    pos += 5;  // YYYY + space
    var h: int64 := _dt_parse2(input, pos);
    pos += 3;  // HH + ':'
    var mi: int64 := _dt_parse2(input, pos);
    pos += 3;  // MM + ':'
    var s: int64 := _dt_parse2(input, pos);
    pos += 3;  // SS + space
    // Parse timezone offset (+HHMM or -HHMM or "GMT")
    var tz_secs: int64 := 0;
    if (pos < len) {
        var tz_sign: int64 := 1;
        var tz_c: int64 := StrCharAt(input, pos);
        if (tz_c == 45) { tz_sign := -1; pos := pos + 1; }
        else if (tz_c == 43) { pos := pos + 1; }
        if (pos + 3 < len) {
            var tz_h: int64 := _dt_parse2(input, pos);
            var tz_m: int64 := _dt_parse2(input, pos + 2);
            tz_secs := tz_sign * (tz_h * 3600 + tz_m * 60);
        }
    }
    if (mo < 1 || mo > 12 || d < 1 || d > 31) { return 0; }
    if (h > 23 || mi > 59 || s > 59) { return 0; }
    var days: int64 := _dt_days_from_civil(y, mo, d);
    var ts: int64 := days * 86400 + h * 3600 + mi * 60 + s - tz_secs;
    poke64(result, ts);
    return 1;
}

// Try ISO 8601 first, then RFC 2822. result is int64 pointer.
pub fn ParseFlexible(input: pchar, result: int64): int64 {
    // #1603: "Flexible" versuchte genau ZWEI Formate — ausgerechnet das
    // haeufigste Eingabeformat, ein reines Datum ohne Uhrzeit, scheiterte.
    // Und der Zielpuffer blieb bei Misserfolg UNBERUEHRT: wer den
    // Rueckgabewert nicht prueft, liest beim Einlesen in einer Schleife den
    // zuletzt erfolgreich gelesenen Wert weiter — eine unlesbare Zeile in der
    // Mitte ergibt dann zwei gleiche Zeitstempel statt eines Fehlers.
    //
    // Deshalb: erst den Puffer auf einen offensichtlich falschen Wert setzen
    // (0 = 1970-01-01), dann der Reihe nach probieren.
    poke64(result, 0);
    if (input == 0 as pchar) { return 0; }
    if (ParseIso(input, result) == 1) { return 1; }
    if (ParseRfc2822(input, result) == 1) { return 1; }

    var len: int64 := StrLen(input);

    // ISO-Datum ohne Zeitanteil: 2026-08-17 → Mitternacht.
    if (len >= 10 && StrCharAt(input, 4) == 45 && StrCharAt(input, 7) == 45) {
        var jy: int64 := _dt_parse4(input, 0);
        var jm: int64 := _dt_parse2(input, 5);
        var jd: int64 := _dt_parse2(input, 8);
        if (jm >= 1 && jm <= 12 && jd >= 1 && jd <= 31) {
            poke64(result, _dt_days_from_civil(jy, jm, jd) * 86400);
            return 1;
        }
    }

    // Deutsche Schreibweise: 17.08.2026, optional mit " 14:30" oder
    // " 14:30:00". FormatLocale ERZEUGT dieses Format seit #1415 — bis hierher
    // gab es kein Gegenstueck zum Einlesen.
    if (len >= 10 && StrCharAt(input, 2) == 46 && StrCharAt(input, 5) == 46) {
        var dd: int64 := _dt_parse2(input, 0);
        var dm: int64 := _dt_parse2(input, 3);
        var dy: int64 := _dt_parse4(input, 6);
        if (dm >= 1 && dm <= 12 && dd >= 1 && dd <= 31) {
            var sek: int64 := 0;
            if (len >= 16 && StrCharAt(input, 10) == 32 && StrCharAt(input, 13) == 58) {
                var dh: int64 := _dt_parse2(input, 11);
                var dmin: int64 := _dt_parse2(input, 14);
                var dsec: int64 := 0;
                if (len >= 19 && StrCharAt(input, 16) == 58) { dsec := _dt_parse2(input, 17); }
                if (dh <= 23 && dmin <= 59 && dsec <= 59) { sek := dh * 3600 + dmin * 60 + dsec; }
            }
            poke64(result, _dt_days_from_civil(dy, dm, dd) * 86400 + sek);
            return 1;
        }
    }

    return 0;
}

// ============================================================================
// Relative Time Formatting
// ============================================================================

// Format relative time ("2 hours ago", "in 3 days").
// datetime is compared against the current UTC time.
pub fn FormatRelative(datetime: int64, output: pchar): int64 {
    var now: int64 := now_unix();
    var delta: int64 := now - datetime;
    var abs_delta: int64 := delta;
    if (abs_delta < 0) { abs_delta := 0 - abs_delta; }
    var future: bool := delta < 0;
    var pos: int64 := 0;
    if (!future) {
        if (abs_delta < 2) {
            pos := _dt_emitStr(output, pos, "just now");
        } else if (abs_delta < 60) {
            pos := _dt_emitNum(output, pos, abs_delta);
            pos := _dt_emitStr(output, pos, " seconds ago");
        } else if (abs_delta < 3600) {
            var mins: int64 := abs_delta / 60;
            pos := _dt_emitNum(output, pos, mins);
            if (mins == 1) {
                pos := _dt_emitStr(output, pos, " minute ago");
            } else {
                pos := _dt_emitStr(output, pos, " minutes ago");
            }
        } else if (abs_delta < 86400) {
            var hrs: int64 := abs_delta / 3600;
            pos := _dt_emitNum(output, pos, hrs);
            if (hrs == 1) {
                pos := _dt_emitStr(output, pos, " hour ago");
            } else {
                pos := _dt_emitStr(output, pos, " hours ago");
            }
        } else if (abs_delta < 604800) {
            var dys: int64 := abs_delta / 86400;
            pos := _dt_emitNum(output, pos, dys);
            if (dys == 1) {
                pos := _dt_emitStr(output, pos, " day ago");
            } else {
                pos := _dt_emitStr(output, pos, " days ago");
            }
        } else if (abs_delta < 2592000) {
            var wks: int64 := abs_delta / 604800;
            pos := _dt_emitNum(output, pos, wks);
            if (wks == 1) {
                pos := _dt_emitStr(output, pos, " week ago");
            } else {
                pos := _dt_emitStr(output, pos, " weeks ago");
            }
        } else if (abs_delta < 31536000) {
            var mos: int64 := abs_delta / 2592000;
            pos := _dt_emitNum(output, pos, mos);
            if (mos == 1) {
                pos := _dt_emitStr(output, pos, " month ago");
            } else {
                pos := _dt_emitStr(output, pos, " months ago");
            }
        } else {
            var yrs: int64 := abs_delta / 31536000;
            pos := _dt_emitNum(output, pos, yrs);
            if (yrs == 1) {
                pos := _dt_emitStr(output, pos, " year ago");
            } else {
                pos := _dt_emitStr(output, pos, " years ago");
            }
        }
    } else {
        if (abs_delta < 60) {
            pos := _dt_emitStr(output, pos, "in ");
            pos := _dt_emitNum(output, pos, abs_delta);
            pos := _dt_emitStr(output, pos, " seconds");
        } else if (abs_delta < 3600) {
            var mins: int64 := abs_delta / 60;
            pos := _dt_emitStr(output, pos, "in ");
            pos := _dt_emitNum(output, pos, mins);
            if (mins == 1) {
                pos := _dt_emitStr(output, pos, " minute");
            } else {
                pos := _dt_emitStr(output, pos, " minutes");
            }
        } else if (abs_delta < 86400) {
            var hrs: int64 := abs_delta / 3600;
            pos := _dt_emitStr(output, pos, "in ");
            pos := _dt_emitNum(output, pos, hrs);
            if (hrs == 1) {
                pos := _dt_emitStr(output, pos, " hour");
            } else {
                pos := _dt_emitStr(output, pos, " hours");
            }
        } else if (abs_delta < 604800) {
            var dys: int64 := abs_delta / 86400;
            pos := _dt_emitStr(output, pos, "in ");
            pos := _dt_emitNum(output, pos, dys);
            if (dys == 1) {
                pos := _dt_emitStr(output, pos, " day");
            } else {
                pos := _dt_emitStr(output, pos, " days");
            }
        } else if (abs_delta < 2592000) {
            var wks: int64 := abs_delta / 604800;
            pos := _dt_emitStr(output, pos, "in ");
            pos := _dt_emitNum(output, pos, wks);
            if (wks == 1) {
                pos := _dt_emitStr(output, pos, " week");
            } else {
                pos := _dt_emitStr(output, pos, " weeks");
            }
        } else if (abs_delta < 31536000) {
            var mos: int64 := abs_delta / 2592000;
            pos := _dt_emitStr(output, pos, "in ");
            pos := _dt_emitNum(output, pos, mos);
            if (mos == 1) {
                pos := _dt_emitStr(output, pos, " month");
            } else {
                pos := _dt_emitStr(output, pos, " months");
            }
        } else {
            var yrs: int64 := abs_delta / 31536000;
            pos := _dt_emitStr(output, pos, "in ");
            pos := _dt_emitNum(output, pos, yrs);
            if (yrs == 1) {
                pos := _dt_emitStr(output, pos, " year");
            } else {
                pos := _dt_emitStr(output, pos, " years");
            }
        }
    }
    StrSetChar(output, pos, 0);
    return pos;
}

// Format duration (e.g., "1h 30m 45s")
pub fn FormatDuration(seconds: int64, output: pchar): int64 {
    // #1605: Eine negative Dauer ergab Leerstring oder Muell — alle drei
    // Ausgabezweige haengen an `> 0`, und aus -45 wurde ",+s" ((-45/10)+48
    // = ',' ). Negativ ist kein exotischer Fall: DiffSeconds(a, b) rechnet
    // b - a, und wer "spaeter, frueher" uebergibt, bekommt genau das.
    // Deshalb Vorzeichen abspalten und mit dem Betrag weiterrechnen.
    var out_pos: int64 := 0;
    var rest: int64 := seconds;
    if (rest < 0) {
        StrSetChar(output, out_pos, 45);      // '-'
        out_pos := out_pos + 1;
        rest := 0 - rest;
    }
    var hours: int64 := rest / 3600;
    var mins: int64 := (rest % 3600) / 60;
    var secs: int64 := rest % 60;
    if (hours > 0) {
        // #1605: die Stundenzahl ist nach oben offen (1000 h sind 41 Tage).
        // Frueher endete die Handschrift bei drei Stellen, ab 1000 h stand
        // dort ein Zeichen unterhalb von '0'.
        out_pos := _dt_emitNum(output, out_pos, hours);
        StrSetChar(output, out_pos, 104); out_pos := out_pos + 1;   // 'h'
        // Das Leerzeichen nur, wenn wirklich etwas folgt — sonst endete die
        // Ausgabe auf einem Leerzeichen ("1h ").
        if (mins > 0 || secs > 0) { StrSetChar(output, out_pos, 32); out_pos := out_pos + 1; }
    }
    if (mins > 0 || (hours > 0 && secs > 0)) {
        out_pos := _dt_emit2s(output, out_pos, mins);
        StrSetChar(output, out_pos, 109); out_pos := out_pos + 1;   // 'm'
        if (secs > 0) {
            StrSetChar(output, out_pos, 32); out_pos := out_pos + 1;
        }
    }
    if (secs > 0 || (hours == 0 && mins == 0)) {
        out_pos := _dt_emit2s(output, out_pos, secs);
        StrSetChar(output, out_pos, 115); out_pos := out_pos + 1;   // 's'
    }
    StrSetChar(output, out_pos, 0);
    return out_pos;
}

// Format short duration (e.g., "1:30:45" or "30:45")
pub fn FormatDurationShort(seconds: int64, output: pchar): int64 {
    var out_pos: int64 := 0;
    var rest: int64 := seconds;
    if (rest < 0) {                            // #1605
        StrSetChar(output, out_pos, 45);
        out_pos := out_pos + 1;
        rest := 0 - rest;
    }
    var hours: int64 := rest / 3600;
    var mins: int64 := (rest % 3600) / 60;
    var secs: int64 := rest % 60;
    if (hours > 0) {
        out_pos := _dt_emitNum(output, out_pos, hours);    // #1605: unbegrenzt
        StrSetChar(output, out_pos, 58); out_pos := out_pos + 1;   // ':'
    }
    out_pos := _dt_emit2s(output, out_pos, mins);
    StrSetChar(output, out_pos, 58); out_pos := out_pos + 1;
    out_pos := _dt_emit2s(output, out_pos, secs);
    StrSetChar(output, out_pos, 0);
    return out_pos;
}

