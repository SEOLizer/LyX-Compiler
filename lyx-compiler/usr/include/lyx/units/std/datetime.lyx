    if (weekday == 0) { return "Sunday"; }
    if (weekday == 1) { return "Monday"; }
    if (weekday == 2) { return "Tuesday"; }
    if (weekday == 3) { return "Wednesday"; }
    if (weekday == 4) { return "Thursday"; }
    if (weekday == 5) { return "Friday"; }
    if (weekday == 6) { return "Saturday"; }
