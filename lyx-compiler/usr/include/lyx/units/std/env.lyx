// std/env.lyx
// Environment helpers: argv access and flag parsing

@description("Environment variable access")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
unit std.env;

// #1179: Zugriff auf die UMGEBUNG ohne C-Bibliothek.
//
// Sieben Units deklarierten dafuer `extern fn getenv(name: pchar): pchar;` —
// ohne link-Klausel. Das Symbol wurde nie gebunden, der Aufruf lieferte still
// 0, und jede Abfrage ("TZ", "AWS_ACCESS_KEY_ID", "HOME") sah aus wie eine
// nicht gesetzte Variable. Gemeldet wurde nichts.
//
// Die Umgebung braucht keine Bibliothek: der Kernel legt sie beim Start auf
// den Stack, direkt hinter argv (argc Eintraege, ein Nullzeiger, dann envp).
// `_start` sichert argc und argv; GetArgC()/GetArgV() liefern beide.

// Basisadresse des envp-Vektors, oder 0 wenn argv nicht gesichert wurde.
pub fn EnvBase(): int64 {
  var argv: int64 := GetArgV() as int64;
  if (argv == 0) { return 0; }
  return argv + (GetArgC() + 1) * 8;
}

// Vergleicht einen Eintrag "NAME=WERT" gegen NAME. Rueckgabe: Offset des
// Werts innerhalb des Eintrags, oder -1 wenn der Name nicht passt.
pub fn EnvEntryValueOff(entry: pchar, key: pchar): int64 {
  var i: int64 := 0;
  var klen: int64 := StrLen(key);
  while (i < klen) {
    if (StrCharAt(entry, i) != StrCharAt(key, i)) { return 0 - 1; }
    i := i + 1;
  }
  if (StrCharAt(entry, klen) != 61) { return 0 - 1; }   // '='
  return klen + 1;
}

// Wert einer Umgebungsvariablen, oder 0 wenn sie nicht gesetzt ist.
// Der zurueckgegebene Zeiger zeigt IN die Umgebung und wird nicht kopiert.
pub fn EnvLookupRaw(name: pchar): pchar {
  if (name == 0 as pchar) { return 0 as pchar; }
  // #1677: Unter Windows gibt es kein envp hinter argv — die Laufzeit legt
  // dort einen zusammenhaengenden Block ab: "NAME=WERT\0NAME=WERT\0\0".
  // Bis 1.1.3E rechnete EnvBase() das SysV-Bild aus und lief mit peek64 durch
  // fremden Speicher, bis das Programm fiel.
  var block: int64 := GetEnvBlock();
  if (block != 0) {
    var p: int64 := block;
    while (peek8(p) != 0) {
      var off2: int64 := EnvEntryValueOff(p as pchar, name);
      if (off2 >= 0) { return (p + off2) as pchar; }
      while (peek8(p) != 0) { p := p + 1; }   // bis zum Ende des Eintrags
      p := p + 1;                              // hinter dessen NUL
    }
    return 0 as pchar;
  }
  var base: int64 := EnvBase();
  if (base == 0) { return 0 as pchar; }
  var i: int64 := 0;
  while (i < 8192) {
    var ent: int64 := peek64(base + i * 8);
    if (ent == 0) { return 0 as pchar; }
    var off: int64 := EnvEntryValueOff(ent as pchar, name);
    if (off >= 0) { return (ent + off) as pchar; }
    i := i + 1;
  }
  return 0 as pchar;
}

// ArgvGetStr: find a named --flag=value argument.
// Returns the value part as pchar, or 0 if not found.
// Example: ArgvGetStr(argc, argv, "output") finds "--output=foo.bin" -> "foo.bin"
pub fn ArgvGetStr(argc: int64, argv: pchar, name: pchar): pchar {
  var nameLen: int64 := StrLen(name);
  var i: int64 := 1;
  while (i < argc) {
    var arg: pchar := ArgvGet(argv, i);
    var argLen: int64 := StrLen(arg);
    if (argLen > nameLen + 2) {
      if (StrCharAt(arg, 0) == 45 && StrCharAt(arg, 1) == 45) {
        var matchCount: int64 := 0;
        var j: int64 := 0;
        while (j < nameLen) {
          if (StrCharAt(arg, j + 2) == StrCharAt(name, j)) {
            matchCount += 1;
          }
          j += 1;
        }
        if (matchCount == nameLen && StrCharAt(arg, nameLen + 2) == 61) {
          var startPos: int64 := nameLen + 3;
          var subLen: int64 := argLen - startPos;
          return StrSub(arg, startPos, subLen);
        }
      }
    }
    i += 1;
  }
  return 0 as pchar;
}

// End of std/env.lyx
