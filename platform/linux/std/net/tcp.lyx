// Lyx Network Library - TCP, plattformunabhaengig (Linux-Fassung)
//
// #2480: Dieselbe Unit gibt es zweimal, mit gleichen Signaturen:
//   platform/linux/std/net/tcp.lyx  -> ueber std.net.socket (Syscalls)
//   platform/win64/std/net/tcp.lyx  -> ueber std.net.socket_win (Winsock)
// Ausgewaehlt wird NUR ueber den Include-Pfad, der Plattformpfad kommt als
// LETZTES -I (das letzte gewinnt) — dasselbe Muster wie Lyxspeak.Plat:
//
//   Linux: lyxc prog.lyx --std-path=<aurum> -I <aurum>/platform/linux
//   Win64: lyxc prog.lyx --std-path=<aurum> -I <aurum>/platform/win64 \
//            --target=win64 --format=pe -o prog.exe
//
// Keine Fabrikfunktion und kein Zweig zur Laufzeit: `extern fn` bindet hart,
// und ein Programm, das ws2_32 auch nur ERWAEHNT, traegt die DLL in seiner
// Import-Tabelle — auch unter Linux, wo es sie nicht gibt.
//
// Handles sind rohe int64 (Dateideskriptor bzw. SOCKET), kein Struct:
// die beiden Plattformen sind sich nur hier einig.

@capabilities([network.tcp.bind, network.tcp.connect])
unit std.net.tcp;

import std.net.socket;
import std.net.dns;

pub con TCP_UNGUELTIG: int64 := 0 - 1;

// Unter Linux nichts zu tun — unter Windows laeuft hier WSAStartup.
pub fn TcpInit(): int64 {
  return 0;
}

pub fn TcpEnde(): int64 {
  return 0;
}

pub fn TcpIPPack(a: int64, b: int64, c: int64, d: int64): int64 {
  return IPPack(a, b, c, d);
}

pub fn TcpConnect(ip: int64, port: int64): int64 {
  var conn: TCPConn := TCPConnect(ip, port);
  if conn.fd < 0 {
    return TCP_UNGUELTIG;
  }
  return conn.fd;
}

pub fn TcpConnectV4(a: int64, b: int64, c: int64, d: int64, port: int64): int64 {
  return TcpConnect(IPPack(a, b, c, d), port);
}

pub fn TcpRead(s: int64, buf: int64, n: int64): int64 {
  var conn: TCPConn;
  conn.fd := s;
  return TCPConnRead(conn, buf as pchar, n);
}

pub fn TcpWrite(s: int64, buf: int64, n: int64): int64 {
  var conn: TCPConn;
  conn.fd := s;
  return TCPConnWrite(conn, buf as pchar, n);
}

// write darf weniger schreiben, als verlangt wurde.
pub fn TcpWriteAll(s: int64, buf: int64, n: int64): int64 {
  var conn: TCPConn;
  conn.fd := s;
  var geschrieben: int64 := 0;
  while geschrieben < n {
    var r: int64 := TCPConnWrite(conn, (buf + geschrieben) as pchar, n - geschrieben);
    if r <= 0 {
      return 0 - 1;
    }
    geschrieben := geschrieben + r;
  }
  return geschrieben;
}

pub fn TcpClose(s: int64): int64 {
  var conn: TCPConn;
  conn.fd := s;
  TCPConnClose(conn);
  return 0;
}

// Zeitgrenzen in MILLISEKUNDEN. Linux will ein timeval, Windows einen DWORD —
// die Umrechnung steht deshalb je Plattform hier, nicht beim Aufrufer.
pub fn TcpSetRecvTimeoutMs(s: int64, ms: int64): int64 {
  var conn: TCPConn;
  conn.fd := s;
  return TCPConnSetRecvTimeout(conn, ms / 1000, (ms % 1000) * 1000);
}

pub fn TcpSetSendTimeoutMs(s: int64, ms: int64): int64 {
  var conn: TCPConn;
  conn.fd := s;
  return TCPConnSetSendTimeout(conn, ms / 1000, (ms % 1000) * 1000);
}

pub fn TcpSetNodelay(s: int64, an: bool): int64 {
  var conn: TCPConn;
  conn.fd := s;
  return TCPConnSetNodelay(conn, an);
}

pub fn TcpFehler(s: int64): int64 {
  var conn: TCPConn;
  conn.fd := s;
  return TCPConnGetError(conn);
}

// ip = 0 heisst INADDR_ANY.
pub fn TcpListen(ip: int64, port: int64, backlog: int64): int64 {
  var listener: TCPListener := TCPListenerNew();
  if listener.fd < 0 {
    return TCP_UNGUELTIG;
  }
  TCPListenerSetReuseAddr(listener);
  if TCPListenerBindTo(listener, ip, port) < 0 {
    TCPListenerClose(listener);
    return TCP_UNGUELTIG;
  }
  if TCPListenerListen(listener, backlog) < 0 {
    TCPListenerClose(listener);
    return TCP_UNGUELTIG;
  }
  return listener.fd;
}

pub fn TcpAccept(listener: int64): int64 {
  var l: TCPListener;
  l.fd := listener;
  var conn: TCPConn := TCPListenerAccept(l);
  if conn.fd < 0 {
    return TCP_UNGUELTIG;
  }
  return conn.fd;
}

// Namen aufloesen: Linux spricht selbst DNS (std.net.dns), Windows fragt den
// Loeser des Systems. Rueckgabe hier wie dort: IPv4 in Hostreihenfolge,
// 0 wenn der Name nicht aufloest.
pub fn TcpResolve(host: pchar): int64 {
  return GetHostByName(host);
}

pub fn TcpConnectHost(host: pchar, port: int64): int64 {
  var ip: int64 := TcpResolve(host);
  if ip == 0 {
    return TCP_UNGUELTIG;
  }
  return TcpConnect(ip, port);
}
