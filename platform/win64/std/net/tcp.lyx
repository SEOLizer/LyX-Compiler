// Lyx Network Library - TCP, plattformunabhaengig (Windows-Fassung)
//
// #2480: Gegenstueck zu platform/linux/std/net/tcp.lyx, gleiche
// Signaturen, Winsock darunter. Auswahl NUR ueber den Include-Pfad:
//
//   lyxc prog.lyx --std-path=<aurum> -I <aurum>/platform/win64 \
//     --target=win64 --format=pe -o prog.exe
//
// Zwei Unterschiede, die ein Aufrufer nicht sehen soll und deshalb hier
// abgefangen werden: WSAStartup muss vor dem ersten Aufruf gelaufen sein
// (TcpInit, und jede Verbindung ruft es vorsichtshalber selbst), und
// Zeitgrenzen sind ein DWORD in Millisekunden statt eines timeval.

@capabilities([network.tcp.bind, network.tcp.connect])
unit std.net.tcp;

import std.net.socket_win;

pub con TCP_UNGUELTIG: int64 := 0 - 1;

pub fn TcpInit(): int64 {
  return WinsockInit();
}

pub fn TcpEnde(): int64 {
  return WinsockEnde();
}

pub fn TcpIPPack(a: int64, b: int64, c: int64, d: int64): int64 {
  return WinIPPack(a, b, c, d);
}

pub fn TcpConnect(ip: int64, port: int64): int64 {
  return WinTCPConnect(ip, port);
}

pub fn TcpConnectV4(a: int64, b: int64, c: int64, d: int64, port: int64): int64 {
  return WinTCPConnectV4(a, b, c, d, port);
}

pub fn TcpRead(s: int64, buf: int64, n: int64): int64 {
  return WinTCPRead(s, buf, n);
}

pub fn TcpWrite(s: int64, buf: int64, n: int64): int64 {
  return WinTCPWrite(s, buf, n);
}

pub fn TcpWriteAll(s: int64, buf: int64, n: int64): int64 {
  return WinTCPWriteAll(s, buf, n);
}

pub fn TcpClose(s: int64): int64 {
  return WinTCPClose(s);
}

pub fn TcpSetRecvTimeoutMs(s: int64, ms: int64): int64 {
  return WinTCPSetRecvTimeout(s, ms);
}

pub fn TcpSetSendTimeoutMs(s: int64, ms: int64): int64 {
  return WinTCPSetSendTimeout(s, ms);
}

pub fn TcpSetNodelay(s: int64, an: bool): int64 {
  return WinTCPSetNodelay(s, an);
}

pub fn TcpFehler(s: int64): int64 {
  return WinTCPFehler(s);
}

pub fn TcpListen(ip: int64, port: int64, backlog: int64): int64 {
  return WinTCPListen(ip, port, backlog);
}

pub fn TcpAccept(listener: int64): int64 {
  return WinTCPAccept(listener);
}
