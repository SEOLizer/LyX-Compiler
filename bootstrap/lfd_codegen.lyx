// WP-BC-41: LFD Qt-UI-Builder — C++ code generator
// Reads NK_LFD_FORM/WIDGET/LAYOUT/PROPERTY/SIGNAL AST nodes and emits
// Qt5 .h / .cpp pairs.

import bootstrap.parser;

// ---------------------------------------------------------------------------
// Node kind constants (mirror parser.lyx)
// ---------------------------------------------------------------------------
con LFD_NK_FORM:     int64 := 95;
con LFD_NK_WIDGET:   int64 := 96;
con LFD_NK_LAYOUT:   int64 := 97;
con LFD_NK_PROPERTY: int64 := 98;
con LFD_NK_SIGNAL:   int64 := 99;

con LFD_NODE_SIZE: int64 := 88;

// ---------------------------------------------------------------------------
// LfdCodeGen class
// ---------------------------------------------------------------------------
pub type LfdCodeGen = class {
  pSrc:    pchar;   // source buffer (for sOff/nc1/nc2 string extraction)
  pNodes:  int64;   // parser node buffer base pointer

  out:     int64;   // output mmap buffer
  outLen:  int64;
  outCap:  int64;

  // temporary accumulators (used instead of nested functions)
  tmpCount: int64;  // counter for collect* helpers
  tmpBuf:   int64;  // buffer pointer for collect* helpers
  tmpCap:   int64;  // capacity for collect* helpers

  // ---------------------------------------------------------------------------
  // Init
  // ---------------------------------------------------------------------------
  pub fn Init(src: pchar, nodes: int64) {
    self.pSrc   := src;
    self.pNodes := nodes;
    self.outCap := 65536;
    self.out    := mmap(0, self.outCap, 3, 34, -1, 0);
    self.outLen := 0;
  }

  fn _resetOut() {
    self.outLen := 0;
  }

  // ---------------------------------------------------------------------------
  // Node accessors
  // ---------------------------------------------------------------------------
  fn _noff(i: int64): int64  { return self.pNodes + i * LFD_NODE_SIZE; }
  fn _nkind(i: int64): int64 { return peek64(self._noff(i)); }
  fn _nc0(i: int64):  int64  { return peek64(self._noff(i) + 8); }
  fn _nc1(i: int64):  int64  { return peek64(self._noff(i) + 16); }
  fn _nc2(i: int64):  int64  { return peek64(self._noff(i) + 24); }
  fn _nnext(i: int64): int64 { return peek64(self._noff(i) + 40); }
  fn _nival(i: int64): int64 { return peek64(self._noff(i) + 56); }
  fn _nsoff(i: int64): int64 { return peek64(self._noff(i) + 64); }
  fn _nslen(i: int64): int64 { return peek64(self._noff(i) + 72); }

  // ---------------------------------------------------------------------------
  // Output helpers
  // ---------------------------------------------------------------------------
  fn _grow(need: int64) {
    if (self.outLen + need <= self.outCap) { return; }
    var nc: int64 := self.outCap * 2;
    if (nc < self.outLen + need) { nc := self.outLen + need + 4096; }
    var nb: int64 := mmap(0, nc, 3, 34, -1, 0);
    var i: int64 := 0;
    while (i < self.outLen) { poke8(nb + i, peek8(self.out + i)); i := i + 1; }
    self.out    := nb;
    self.outCap := nc;
  }

  fn _emit(s: pchar, len: int64) {
    self._grow(len + 1);
    var i: int64 := 0;
    while (i < len) {
      poke8(self.out + self.outLen, StrCharAt(s, i) & 255);
      self.outLen := self.outLen + 1;
      i := i + 1;
    }
  }

  fn _emitS(s: pchar) {
    self._emit(s, StrLen(s));
  }

  // Emit source substring [off .. off+len)
  fn _emitSrc(off: int64, len: int64) {
    self._emit(self.pSrc + off, len);
  }

  // Emit a string literal token value without surrounding quotes / 'c' suffix
  fn _emitStrTok(off: int64, len: int64) {
    if (len >= 2 && StrCharAt(self.pSrc, off) == 34) {
      var start: int64 := off + 1;
      var end:   int64 := off + len - 1;
      if (end > start && StrCharAt(self.pSrc, end - 1) == 99) { end := end - 1; }
      self._emit(self.pSrc + start, end - start);
    } else {
      self._emitSrc(off, len);
    }
  }

  // ---------------------------------------------------------------------------
  // String equality helpers
  // ---------------------------------------------------------------------------
  fn _seq(a: pchar, alen: int64, b: pchar, blen: int64): int64 {
    if (alen != blen) { return 0; }
    var i: int64 := 0;
    while (i < alen) {
      if (StrCharAt(a, i) != StrCharAt(b, i)) { return 0; }
      i := i + 1;
    }
    return 1;
  }

  fn _srcEq(off: int64, len: int64, b: pchar): int64 {
    return self._seq(self.pSrc + off, len, b, StrLen(b));
  }

  // ---------------------------------------------------------------------------
  // Widget-type → Qt class / include name mapping
  // ---------------------------------------------------------------------------
  fn _widgetQtClass(tOff: int64, tLen: int64): pchar {
    if (self._srcEq(tOff, tLen, "Button"c))        { return "QPushButton"c; }
    if (self._srcEq(tOff, tLen, "PushButton"c))    { return "QPushButton"c; }
    if (self._srcEq(tOff, tLen, "Label"c))         { return "QLabel"c; }
    if (self._srcEq(tOff, tLen, "LineEdit"c))      { return "QLineEdit"c; }
    if (self._srcEq(tOff, tLen, "TextEdit"c))      { return "QTextEdit"c; }
    if (self._srcEq(tOff, tLen, "CheckBox"c))      { return "QCheckBox"c; }
    if (self._srcEq(tOff, tLen, "RadioButton"c))   { return "QRadioButton"c; }
    if (self._srcEq(tOff, tLen, "ComboBox"c))      { return "QComboBox"c; }
    if (self._srcEq(tOff, tLen, "SpinBox"c))       { return "QSpinBox"c; }
    if (self._srcEq(tOff, tLen, "Slider"c))        { return "QSlider"c; }
    if (self._srcEq(tOff, tLen, "ProgressBar"c))   { return "QProgressBar"c; }
    if (self._srcEq(tOff, tLen, "GroupBox"c))      { return "QGroupBox"c; }
    if (self._srcEq(tOff, tLen, "Frame"c))         { return "QFrame"c; }
    if (self._srcEq(tOff, tLen, "TabWidget"c))     { return "QTabWidget"c; }
    if (self._srcEq(tOff, tLen, "TableWidget"c))   { return "QTableWidget"c; }
    if (self._srcEq(tOff, tLen, "ListWidget"c))    { return "QListWidget"c; }
    if (self._srcEq(tOff, tLen, "TreeWidget"c))    { return "QTreeWidget"c; }
    if (self._srcEq(tOff, tLen, "ToolButton"c))    { return "QToolButton"c; }
    if (self._srcEq(tOff, tLen, "DateEdit"c))      { return "QDateEdit"c; }
    if (self._srcEq(tOff, tLen, "TimeEdit"c))      { return "QTimeEdit"c; }
    if (self._srcEq(tOff, tLen, "DoubleSpinBox"c)) { return "QDoubleSpinBox"c; }
    return 0 as pchar;
  }

  // Layout kind (iVal) → Qt class
  fn _layoutQtClass(kind: int64): pchar {
    if (kind == 2) { return "QHBoxLayout"c; }
    if (kind == 3) { return "QGridLayout"c; }
    if (kind == 4) { return "QFormLayout"c; }
    return "QVBoxLayout"c;
  }

  // Signal name → Qt signal identifier (no parentheses, for new-style connect())
  fn _signalToQt(sigOff: int64, sigLen: int64): pchar {
    if (self._srcEq(sigOff, sigLen, "OnClick"c))       { return "clicked"c; }
    if (self._srcEq(sigOff, sigLen, "OnToggle"c))      { return "toggled"c; }
    if (self._srcEq(sigOff, sigLen, "OnChange"c))      { return "textChanged"c; }
    if (self._srcEq(sigOff, sigLen, "OnEditDone"c))    { return "editingFinished"c; }
    if (self._srcEq(sigOff, sigLen, "OnReturn"c))      { return "returnPressed"c; }
    if (self._srcEq(sigOff, sigLen, "OnActivate"c))    { return "activated"c; }
    if (self._srcEq(sigOff, sigLen, "OnValueChange"c)) { return "valueChanged"c; }
    if (self._srcEq(sigOff, sigLen, "OnSelect"c))      { return "currentRowChanged"c; }
    if (self._srcEq(sigOff, sigLen, "OnPress"c))       { return "pressed"c; }
    if (self._srcEq(sigOff, sigLen, "OnRelease"c))     { return "released"c; }
    return 0 as pchar;
  }

  // Property name → setter method
  fn _propToSetter(pOff: int64, pLen: int64): pchar {
    if (self._srcEq(pOff, pLen, "Text"c))         { return "setText"c; }
    if (self._srcEq(pOff, pLen, "Placeholder"c))  { return "setPlaceholderText"c; }
    if (self._srcEq(pOff, pLen, "Tooltip"c))      { return "setToolTip"c; }
    if (self._srcEq(pOff, pLen, "Title"c))        { return "setTitle"c; }
    if (self._srcEq(pOff, pLen, "Enabled"c))      { return "setEnabled"c; }
    if (self._srcEq(pOff, pLen, "Visible"c))      { return "setVisible"c; }
    if (self._srcEq(pOff, pLen, "Checked"c))      { return "setChecked"c; }
    if (self._srcEq(pOff, pLen, "ReadOnly"c))     { return "setReadOnly"c; }
    if (self._srcEq(pOff, pLen, "Value"c))        { return "setValue"c; }
    if (self._srcEq(pOff, pLen, "Minimum"c))      { return "setMinimum"c; }
    if (self._srcEq(pOff, pLen, "Maximum"c))      { return "setMaximum"c; }
    if (self._srcEq(pOff, pLen, "MinWidth"c))     { return "setMinimumWidth"c; }
    if (self._srcEq(pOff, pLen, "MinHeight"c))    { return "setMinimumHeight"c; }
    if (self._srcEq(pOff, pLen, "MaxWidth"c))     { return "setMaximumWidth"c; }
    if (self._srcEq(pOff, pLen, "MaxHeight"c))    { return "setMaximumHeight"c; }
    if (self._srcEq(pOff, pLen, "FixedWidth"c))   { return "setFixedWidth"c; }
    if (self._srcEq(pOff, pLen, "FixedHeight"c))  { return "setFixedHeight"c; }
    if (self._srcEq(pOff, pLen, "StyleSheet"c))   { return "setStyleSheet"c; }
    if (self._srcEq(pOff, pLen, "ObjectName"c))   { return "setObjectName"c; }
    return 0 as pchar;
  }

  // True if property value is numeric/bool (no QString wrap)
  fn _propIsRaw(pOff: int64, pLen: int64): int64 {
    if (self._srcEq(pOff, pLen, "Enabled"c))     { return 1; }
    if (self._srcEq(pOff, pLen, "Visible"c))     { return 1; }
    if (self._srcEq(pOff, pLen, "Checked"c))     { return 1; }
    if (self._srcEq(pOff, pLen, "ReadOnly"c))    { return 1; }
    if (self._srcEq(pOff, pLen, "Value"c))       { return 1; }
    if (self._srcEq(pOff, pLen, "Minimum"c))     { return 1; }
    if (self._srcEq(pOff, pLen, "Maximum"c))     { return 1; }
    if (self._srcEq(pOff, pLen, "MinWidth"c))    { return 1; }
    if (self._srcEq(pOff, pLen, "MinHeight"c))   { return 1; }
    if (self._srcEq(pOff, pLen, "MaxWidth"c))    { return 1; }
    if (self._srcEq(pOff, pLen, "MaxHeight"c))   { return 1; }
    if (self._srcEq(pOff, pLen, "FixedWidth"c))  { return 1; }
    if (self._srcEq(pOff, pLen, "FixedHeight"c)) { return 1; }
    return 0;
  }

  // ---------------------------------------------------------------------------
  // Include deduplication helper (uses tmpBuf / tmpCount / tmpCap)
  // ---------------------------------------------------------------------------
  fn _addInclude(cls: pchar) {
    var clen: int64 := StrLen(cls);
    var i: int64 := 0;
    while (i < self.tmpCount) {
      var ep: pchar := peek64(self.tmpBuf + i * 16) as pchar;
      var el: int64 := peek64(self.tmpBuf + i * 16 + 8);
      if (self._seq(ep, el, cls, clen) != 0) { return; }
      i := i + 1;
    }
    if (self.tmpCount < self.tmpCap) {
      poke64(self.tmpBuf + self.tmpCount * 16,     cls as int64);
      poke64(self.tmpBuf + self.tmpCount * 16 + 8, clen);
      self.tmpCount := self.tmpCount + 1;
    }
  }

  // Walk a subtree collecting includes (recursive over next chain)
  fn _collectIncWalk(nd: int64) {
    if (nd < 0) { return; }
    var k: int64 := self._nkind(nd);
    if (k == LFD_NK_WIDGET) {
      var tOff: int64 := self._nsoff(nd);
      var tLen: int64 := self._nslen(nd);
      var cls: pchar  := self._widgetQtClass(tOff, tLen);
      if (cls != 0 as pchar) { self._addInclude(cls); }
      // recurse into layout children via sibling chain
      var child: int64 := self._nc0(nd);
      while (child >= 0) { child := self._nnext(child); }
    } else if (k == LFD_NK_LAYOUT) {
      var child: int64 := self._nc0(nd);
      while (child >= 0) {
        self._collectIncWalk(child);
        child := self._nnext(child);
      }
    }
    var sib: int64 := self._nnext(nd);
    if (sib >= 0) { self._collectIncWalk(sib); }
  }

  fn _collectIncludes(formNode: int64, incBuf: int64, incCap: int64): int64 {
    self.tmpBuf   := incBuf;
    self.tmpCap   := incCap;
    self.tmpCount := 0;
    var first: int64 := self._nc0(formNode);
    if (first >= 0) { self._collectIncWalk(first); }
    return self.tmpCount;
  }

  // ---------------------------------------------------------------------------
  // Widget collection (depth-first)
  // ---------------------------------------------------------------------------
  fn _collectWidgetsWalk(nd: int64) {
    if (nd < 0) { return; }
    var k: int64 := self._nkind(nd);
    if (k == LFD_NK_WIDGET) {
      if (self.tmpCount < self.tmpCap) {
        poke64(self.tmpBuf + self.tmpCount * 8, nd);
        self.tmpCount := self.tmpCount + 1;
      }
    } else if (k == LFD_NK_LAYOUT) {
      var child: int64 := self._nc0(nd);
      while (child >= 0) {
        self._collectWidgetsWalk(child);
        child := self._nnext(child);
      }
    }
    var sib: int64 := self._nnext(nd);
    if (sib >= 0) { self._collectWidgetsWalk(sib); }
  }

  fn _collectWidgets(formNode: int64, wBuf: int64, wCap: int64): int64 {
    self.tmpBuf   := wBuf;
    self.tmpCap   := wCap;
    self.tmpCount := 0;
    var first: int64 := self._nc0(formNode);
    if (first >= 0) { self._collectWidgetsWalk(first); }
    return self.tmpCount;
  }

  // ---------------------------------------------------------------------------
  // Signal collection (depth-first)
  // ---------------------------------------------------------------------------
  fn _collectSignalsWalk(nd: int64) {
    if (nd < 0) { return; }
    var k: int64 := self._nkind(nd);
    if (k == LFD_NK_WIDGET) {
      var prop: int64 := self._nc0(nd);
      while (prop >= 0) {
        if (self._nkind(prop) == LFD_NK_SIGNAL) {
          if (self.tmpCount < self.tmpCap) {
            poke64(self.tmpBuf + self.tmpCount * 8, prop);
            self.tmpCount := self.tmpCount + 1;
          }
        }
        prop := self._nnext(prop);
      }
    } else if (k == LFD_NK_LAYOUT) {
      var child: int64 := self._nc0(nd);
      while (child >= 0) {
        self._collectSignalsWalk(child);
        child := self._nnext(child);
      }
    }
    var sib: int64 := self._nnext(nd);
    if (sib >= 0) { self._collectSignalsWalk(sib); }
  }

  fn _collectSignals(formNode: int64, sBuf: int64, sCap: int64): int64 {
    self.tmpBuf   := sBuf;
    self.tmpCap   := sCap;
    self.tmpCount := 0;
    var first: int64 := self._nc0(formNode);
    if (first >= 0) { self._collectSignalsWalk(first); }
    return self.tmpCount;
  }

  // ---------------------------------------------------------------------------
  // Widget init emission
  // ---------------------------------------------------------------------------
  fn _emitWidgetSetup(wnd: int64, indent: pchar) {
    var tOff: int64  := self._nsoff(wnd);
    var tLen: int64  := self._nslen(wnd);
    var vnOff: int64 := self._nc1(wnd);
    var vnLen: int64 := self._nc2(wnd);

    self._emitS(indent);
    self._emitSrc(vnOff, vnLen);
    self._emitS(" = new "c);
    var cls: pchar := self._widgetQtClass(tOff, tLen);
    if (cls != 0 as pchar) { self._emitS(cls); }
    else                   { self._emitSrc(tOff, tLen); }
    self._emitS("(this);\n"c);

    var prop: int64 := self._nc0(wnd);
    while (prop >= 0) {
      if (self._nkind(prop) == LFD_NK_PROPERTY) {
        var pnOff: int64 := self._nsoff(prop);
        var pnLen: int64 := self._nslen(prop);
        var pvOff: int64 := self._nc1(prop);
        var pvLen: int64 := self._nc2(prop);
        var setter: pchar := self._propToSetter(pnOff, pnLen);
        if (setter != 0 as pchar) {
          self._emitS(indent);
          self._emitSrc(vnOff, vnLen);
          self._emitS("->"c);
          self._emitS(setter);
          self._emitS("("c);
          if (self._propIsRaw(pnOff, pnLen) != 0) {
            self._emitSrc(pvOff, pvLen);
          } else {
            self._emitS("QStringLiteral(\""c);
            self._emitStrTok(pvOff, pvLen);
            self._emitS("\")"c);
          }
          self._emitS(");\n"c);
        }
      }
      prop := self._nnext(prop);
    }
  }

  // Walk subtree emitting widget instantiations (depth-first)
  fn _emitWidgetInitsWalk(nd: int64, indent: pchar) {
    if (nd < 0) { return; }
    var k: int64 := self._nkind(nd);
    if (k == LFD_NK_WIDGET) {
      self._emitWidgetSetup(nd, indent);
    } else if (k == LFD_NK_LAYOUT) {
      var child: int64 := self._nc0(nd);
      while (child >= 0) {
        self._emitWidgetInitsWalk(child, indent);
        child := self._nnext(child);
      }
    }
    var sib: int64 := self._nnext(nd);
    if (sib >= 0) { self._emitWidgetInitsWalk(sib, indent); }
  }

  // ---------------------------------------------------------------------------
  // Layout setup emission (recursive for nested layouts)
  // layoutVar must be a null-terminated string of <= 60 bytes
  // ---------------------------------------------------------------------------
  fn _emitLayoutSetupNode(nd: int64, layoutVar: pchar, indent: pchar, subIdx: int64) {
    var lkind: int64  := self._nival(nd);
    var lclass: pchar := self._layoutQtClass(lkind);
    self._emitS(indent);
    self._emitS("auto "c);
    self._emitS(layoutVar);
    self._emitS(" = new "c);
    self._emitS(lclass);
    self._emitS("(this);\n"c);

    var child: int64 := self._nc0(nd);
    var idx: int64   := 0;
    while (child >= 0) {
      var ck: int64 := self._nkind(child);
      if (ck == LFD_NK_WIDGET) {
        self._emitS(indent);
        self._emitS(layoutVar);
        self._emitS("->addWidget("c);
        var vnOff: int64 := self._nc1(child);
        var vnLen: int64 := self._nc2(child);
        self._emitSrc(vnOff, vnLen);
        self._emitS(");\n"c);
      } else if (ck == LFD_NK_LAYOUT) {
        // Build sub-layout variable name: layoutVar + "s" + idx
        var subBuf: int64 := mmap(0, 128, 3, 34, -1, 0);
        var si: int64 := 0;
        var li: int64 := 0;
        while (StrCharAt(layoutVar, li) != 0 && si < 60) {
          poke8(subBuf + si, StrCharAt(layoutVar, li) & 255);
          si := si + 1; li := li + 1;
        }
        poke8(subBuf + si, 115); si := si + 1;  // 's'
        if (idx >= 10) {
          poke8(subBuf + si, 48 + (idx / 10) & 255); si := si + 1;
        }
        poke8(subBuf + si, 48 + idx % 10); si := si + 1;
        poke8(subBuf + si, 0);
        self._emitLayoutSetupNode(child, subBuf as pchar, indent, idx);
        self._emitS(indent);
        self._emitS(layoutVar);
        self._emitS("->addLayout("c);
        self._emitS(subBuf as pchar);
        self._emitS(");\n"c);
      }
      idx   := idx + 1;
      child := self._nnext(child);
    }
  }

  // ---------------------------------------------------------------------------
  // Signal-slot connection emission (depth-first)
  // ---------------------------------------------------------------------------
  fn _emitConnectionsWalk(nd: int64, indent: pchar, formNameOff: int64, formNameLen: int64) {
    if (nd < 0) { return; }
    var k: int64 := self._nkind(nd);
    if (k == LFD_NK_WIDGET) {
      var tOff: int64  := self._nsoff(nd);
      var tLen: int64  := self._nslen(nd);
      var vnOff: int64 := self._nc1(nd);
      var vnLen: int64 := self._nc2(nd);
      var prop: int64  := self._nc0(nd);
      while (prop >= 0) {
        if (self._nkind(prop) == LFD_NK_SIGNAL) {
          var sigOff: int64 := self._nsoff(prop);
          var sigLen: int64 := self._nslen(prop);
          var hOff: int64   := self._nc1(prop);
          var hLen: int64   := self._nc2(prop);
          self._emitS(indent);
          self._emitS("connect("c);
          self._emitSrc(vnOff, vnLen);
          self._emitS(", &"c);
          var cls: pchar := self._widgetQtClass(tOff, tLen);
          if (cls != 0 as pchar) { self._emitS(cls); }
          else                   { self._emitSrc(tOff, tLen); }
          self._emitS("::"c);
          var qtSig: pchar := self._signalToQt(sigOff, sigLen);
          if (qtSig != 0 as pchar) {
            self._emitS(qtSig);
          } else {
            self._emitSrc(sigOff, sigLen);
          }
          self._emitS(", this, &"c);
          self._emitSrc(formNameOff, formNameLen);
          self._emitS("::"c);
          self._emitSrc(hOff, hLen);
          self._emitS(");\n"c);
        }
        prop := self._nnext(prop);
      }
    } else if (k == LFD_NK_LAYOUT) {
      var child: int64 := self._nc0(nd);
      while (child >= 0) {
        self._emitConnectionsWalk(child, indent, formNameOff, formNameLen);
        child := self._nnext(child);
      }
    }
    var sib: int64 := self._nnext(nd);
    if (sib >= 0) { self._emitConnectionsWalk(sib, indent, formNameOff, formNameLen); }
  }

  // ---------------------------------------------------------------------------
  // GenerateHeader: emit Qt5 .h content for a NK_LFD_FORM node
  // ---------------------------------------------------------------------------
  pub fn GenerateHeader(formNode: int64): int64 {
    self._resetOut();

    var fnOff: int64 := self._nsoff(formNode);
    var fnLen: int64 := self._nslen(formNode);

    var incBuf: int64 := mmap(0, 64 * 16, 3, 34, -1, 0);
    var wBuf:   int64 := mmap(0, 256 * 8, 3, 34, -1, 0);
    var sBuf:   int64 := mmap(0, 256 * 8, 3, 34, -1, 0);

    var incCount: int64 := self._collectIncludes(formNode, incBuf, 64);
    var wCount:   int64 := self._collectWidgets(formNode, wBuf, 256);
    var sCount:   int64 := self._collectSignals(formNode, sBuf, 256);

    // Header guard
    self._emitS("#ifndef "c);
    self._emitSrc(fnOff, fnLen);
    self._emitS("_H\n#define "c);
    self._emitSrc(fnOff, fnLen);
    self._emitS("_H\n\n"c);

    // Base + widget includes
    self._emitS("#include <QWidget>\n"c);
    var i: int64 := 0;
    while (i < incCount) {
      var cls: pchar := peek64(incBuf + i * 16) as pchar;
      self._emitS("#include <"c);
      self._emitS(cls);
      self._emitS(">\n"c);
      i := i + 1;
    }
    // Layout includes (always emit all; compiler strips unused)
    self._emitS("#include <QVBoxLayout>\n"c);
    self._emitS("#include <QHBoxLayout>\n"c);
    self._emitS("#include <QGridLayout>\n"c);
    self._emitS("#include <QFormLayout>\n\n"c);

    // class declaration
    self._emitS("class "c);
    self._emitSrc(fnOff, fnLen);
    self._emitS(" : public QWidget {\n    Q_OBJECT\n\npublic:\n    explicit "c);
    self._emitSrc(fnOff, fnLen);
    self._emitS("(QWidget *parent = nullptr);\n\n"c);

    // private slots
    if (sCount > 0) {
      self._emitS("private slots:\n"c);
      i := 0;
      while (i < sCount) {
        var snd: int64  := peek64(sBuf + i * 8);
        var hOff: int64 := self._nc1(snd);
        var hLen: int64 := self._nc2(snd);
        self._emitS("    void "c);
        self._emitSrc(hOff, hLen);
        self._emitS("();\n"c);
        i := i + 1;
      }
      self._emitS("\n"c);
    }

    // private members
    if (wCount > 0) {
      self._emitS("private:\n"c);
      i := 0;
      while (i < wCount) {
        var wnd: int64   := peek64(wBuf + i * 8);
        var tOff: int64  := self._nsoff(wnd);
        var tLen: int64  := self._nslen(wnd);
        var vnOff: int64 := self._nc1(wnd);
        var vnLen: int64 := self._nc2(wnd);
        self._emitS("    "c);
        var cls: pchar := self._widgetQtClass(tOff, tLen);
        if (cls != 0 as pchar) { self._emitS(cls); }
        else                   { self._emitSrc(tOff, tLen); }
        self._emitS(" *"c);
        self._emitSrc(vnOff, vnLen);
        self._emitS(";\n"c);
        i := i + 1;
      }
    }

    self._emitS("};\n\n#endif // "c);
    self._emitSrc(fnOff, fnLen);
    self._emitS("_H\n"c);

    return self.outLen;
  }

  // ---------------------------------------------------------------------------
  // GenerateSource: emit Qt5 .cpp content for a NK_LFD_FORM node
  // ---------------------------------------------------------------------------
  pub fn GenerateSource(formNode: int64, headerName: pchar): int64 {
    self._resetOut();

    var fnOff: int64    := self._nsoff(formNode);
    var fnLen: int64    := self._nslen(formNode);
    var titleOff: int64 := self._nc1(formNode);
    var titleLen: int64 := self._nc2(formNode);

    self._emitS("#include \""c);
    self._emitS(headerName);
    self._emitS("\"\n\n"c);

    // Constructor opening
    self._emitSrc(fnOff, fnLen);
    self._emitS("::"c);
    self._emitSrc(fnOff, fnLen);
    self._emitS("(QWidget *parent)\n    : QWidget(parent)\n{\n"c);

    // setWindowTitle
    if (titleLen > 0) {
      self._emitS("    setWindowTitle(QStringLiteral(\""c);
      self._emitStrTok(titleOff, titleLen);
      self._emitS("\"));\n"c);
    }

    // Widget instantiation
    self._emitS("\n    // Widget instantiation\n"c);
    var first: int64 := self._nc0(formNode);
    self._emitWidgetInitsWalk(first, "    "c);

    // Layout setup for top-level layout nodes
    self._emitS("\n    // Layout setup\n"c);
    var nd: int64 := first;
    while (nd >= 0) {
      if (self._nkind(nd) == LFD_NK_LAYOUT) {
        self._emitLayoutSetupNode(nd, "mainLayout"c, "    "c, 0);
        self._emitS("    setLayout(mainLayout);\n"c);
      }
      nd := self._nnext(nd);
    }

    // Signal-slot connections
    self._emitS("\n    // Signal-slot connections\n"c);
    self._emitConnectionsWalk(first, "    "c, fnOff, fnLen);

    self._emitS("}\n"c);

    return self.outLen;
  }

  pub fn GetOut(): pchar    { return self.out as pchar; }
  pub fn GetOutLen(): int64 { return self.outLen; }
};
