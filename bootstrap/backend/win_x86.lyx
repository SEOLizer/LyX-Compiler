  // ------------------------------------------------------------------
  // Write PE64 binary to disk.
  // ------------------------------------------------------------------

  fn wxb_writePE64(path: pchar) {
    var codeLen: int64 := self.codeLen;
    var textRawSize: int64 := (codeLen + WIN_FILE_ALIGN - 1) & ~(WIN_FILE_ALIGN - 1);
    var rdataRVA: int64 := (WIN_TEXT_RVA + codeLen + WIN_SEC_ALIGN - 1) & ~(WIN_SEC_ALIGN - 1);
    var rdataFileOff: int64 := WIN_FILE_ALIGN + textRawSize;  // 512 header + text
    var imageSize: int64 := rdataRVA + WIN_SEC_ALIGN;
    var entryRVA: int64 := WIN_TEXT_RVA + WIN_ENTRY_OFF;

    // ---- DOS Header (64 bytes) + DOS Stub (64 bytes) ----
    self.wxb_writeDosHeader(128);  // PE signature at file offset 128
    self.wxb_writeDosStub();

    // ---- PE Signature "PE\0\0" ----
    self.wxb_oe8(80); self.wxb_oe8(69); self.wxb_oe8(0); self.wxb_oe8(0);

    // ---- COFF Header (20 bytes) ----
    self.wxb_oe16(0x8664);    // Machine = AMD64
    self.wxb_oe16(2);         // NumberOfSections
    self.wxb_oe32(0);         // TimeDateStamp
    self.wxb_oe32(0);         // PointerToSymbolTable
    self.wxb_oe32(0);         // NumberOfSymbols
    self.wxb_oe16(240);       // SizeOfOptionalHeader
    self.wxb_oe16(0x0022);    // IMAGE_FILE_EXECUTABLE_IMAGE | IMAGE_FILE_LARGE_ADDRESS_AWARE

    // ---- Optional Header PE32+ (240 bytes) ----
    self.wxb_oe16(0x020B);    // Magic = PE32+
    self.wxb_oe8(1);          // MajorLinkerVersion
    self.wxb_oe8(0);          // MinorLinkerVersion
    self.wxb_oe32(textRawSize);  // SizeOfCode
    self.wxb_oe32(WIN_FILE_ALIGN);  // SizeOfInitializedData (rdata raw)
    self.wxb_oe32(0);         // SizeOfUninitializedData
    self.wxb_oe32(entryRVA);  // AddressOfEntryPoint
    self.wxb_oe32(WIN_TEXT_RVA);  // BaseOfCode
    self.wxb_oe64(WIN_IMAGE_BASE); // ImageBase
    self.wxb_oe32(WIN_SEC_ALIGN);  // SectionAlignment = 4096
    self.wxb_oe32(WIN_FILE_ALIGN); // FileAlignment = 512
    self.wxb_oe16(6);  self.wxb_oe16(2);   // OS Version 6.2
    self.wxb_oe16(0);  self.wxb_oe16(0);   // Image Version
    self.wxb_oe16(6);  self.wxb_oe16(2);   // Subsystem Version 6.2
    self.wxb_oe32(0);         // Win32VersionValue
    self.wxb_oe32(imageSize); // SizeOfImage
    self.wxb_oe32(WIN_FILE_ALIGN);  // SizeOfHeaders = 512
    self.wxb_oe32(0);         // CheckSum
    self.wxb_oe16(3);         // Subsystem = IMAGE_SUBSYSTEM_WINDOWS_CUI
    self.wxb_oe16(0x0100);    // DllCharacteristics = NX_COMPAT
    self.wxb_oe64(0x100000);  // SizeOfStackReserve = 1 MB
    self.wxb_oe64(0x1000);    // SizeOfStackCommit = 4 KB
    self.wxb_oe64(0x100000);  // SizeOfHeapReserve = 1 MB
    self.wxb_oe64(0x1000);    // SizeOfHeapCommit = 4 KB
    self.wxb_oe32(0);         // LoaderFlags
    self.wxb_oe32(16);        // NumberOfRvaAndSizes

    // Data Directories (16 entries × 8 bytes = 128 bytes)
    self.wxb_oe32(0); self.wxb_oe32(0);  // [0] Export
    self.wxb_oe32(rdataRVA); self.wxb_oe32(40);  // [1] Import (IDT)
    self.wxb_oe32(0); self.wxb_oe32(0);  // [2] Resource
    self.wxb_oe32(0); self.wxb_oe32(0);  // [3] Exception
    self.wxb_oe32(0); self.wxb_oe32(0);  // [4] Security
    self.wxb_oe32(0); self.wxb_oe32(0);  // [5] BaseReloc
    self.wxb_oe32(0); self.wxb_oe32(0);  // [6] Debug
    self.wxb_oe32(0); self.wxb_oe32(0);  // [7] Architecture
    self.wxb_oe32(0); self.wxb_oe32(0);  // [8] GlobalPtr
    self.wxb_oe32(0); self.wxb_oe32(0);  // [9] TLS
    self.wxb_oe32(0); self.wxb_oe32(0);  // [10] LoadConfig
    self.wxb_oe32(0); self.wxb_oe32(0);  // [11] BoundImport
    self.wxb_oe32(rdataRVA + WIN_RDATA_IAT_OFF); self.wxb_oe32(32);  // [12] IAT
    self.wxb_oe32(0); self.wxb_oe32(0);  // [13] DelayImport
    self.wxb_oe32(0); self.wxb_oe32(0);  // [14] CLR
    self.wxb_oe32(0); self.wxb_oe32(0);  // [15] Reserved

    // ---- Section Header .text (40 bytes) ----
    self.wxb_oName8(".text"c, 5);
    self.wxb_oe32(codeLen);         // VirtualSize
    self.wxb_oe32(WIN_TEXT_RVA);    // VirtualAddress
    self.wxb_oe32(textRawSize);     // SizeOfRawData
    self.wxb_oe32(WIN_FILE_ALIGN);  // PointerToRawData = 512
    self.wxb_oe32(0);               // PointerToRelocations
    self.wxb_oe32(0);               // PointerToLinenumbers
    self.wxb_oe16(0);               // NumberOfRelocations
    self.wxb_oe16(0);               // NumberOfLinenumbers
    self.wxb_oe32(0x60000020);      // Characteristics: CODE|MEM_EXECUTE|MEM_READ

    // ---- Section Header .rdata (40 bytes) ----
    self.wxb_oName8(".rdata"c, 6);
    self.wxb_oe32(WIN_RDATA_SIZE);  // VirtualSize = 158
    self.wxb_oe32(rdataRVA);        // VirtualAddress
    self.wxb_oe32(WIN_FILE_ALIGN);  // SizeOfRawData = 512
    self.wxb_oe32(rdataFileOff);    // PointerToRawData
    self.wxb_oe32(0);               // PointerToRelocations
    self.wxb_oe32(0);               // PointerToLinenumbers
    self.wxb_oe16(0);               // NumberOfRelocations
    self.wxb_oe16(0);               // NumberOfLinenumbers
    self.wxb_oe32(0x40000040);      // Characteristics: INITIALIZED_DATA|MEM_READ

    // ---- Pad header to FILE_ALIGNMENT (512) ----
    self.wxb_oZeros(WIN_FILE_ALIGN - self.outLen);

    // ---- .text section ----
    var i: int64 := 0;
    while (i < codeLen) {
      self.wxb_oe8(peek8(self.code + i));
      i := i + 1;
    }
    self.wxb_oZeros(textRawSize - codeLen);

    // ---- .rdata section ----
    self.wxb_writeRdata(rdataRVA);

    // ---- Write to file (O_WRONLY|O_CREAT|O_TRUNC=577, mode 0755=493) ----
    var fd: int64 := open(path, 577, 493);
    if (fd < 0) {
      EPrintStr("error: cannot write output: "c);
      EPrintStrLn(path);
      return;
    }
    write(fd, self.out as pchar, self.outLen);
    close(fd);
  }

  // ------------------------------------------------------------------
  // Public API
  // ------------------------------------------------------------------

  pub fn Build(cgBuf: int64, cgLen: int64) {
    self.wxb_buildCode(cgBuf, cgLen);
  }

  pub fn WritePE64(path: pchar) {
    self.wxb_writePE64(path);
  }

  pub fn GetCodeSize(): int64 { return self.codeLen; }

  pub fn Init() {
    self.codeCap := 65536;
    self.code    := mmap(0, self.codeCap, 3, 34, -1, 0);
    self.codeLen := 0;
    self.outCap  := 65536;
    self.out     := mmap(0, self.outCap, 3, 34, -1, 0);
    self.outLen  := 0;
  }

};
