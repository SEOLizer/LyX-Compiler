// bootstrap/backend/win_arm64.lyx
// Windows ARM64 backend for the Lyx bootstrap compiler (WP-BC-35).
// Generates PE64-ARM64 executables (.exe) for Windows on ARM (ARM64/AArch64).
//
// Strategy: IR code generated by EmitARM64 + minimal _start stub.
// The stub calls main, passes return value to ExitProcess via IAT.
//
// PE64 layout:
//   file[0..511]         headers (DOS + PE + COFF + Optional + 2 section headers)
//   file[512..512+T-1]   .text  (padded to FILE_ALIGNMENT)
//   file[512+T..]        .rdata (import tables, padded to FILE_ALIGNMENT)
//   virtual: ImageBase=0x140000000, .text RVA=0x1000, .rdata RVA=dynamic
//
// _start stub layout (28 bytes at .text offset 0):
//   +00: STP x29, x30, [sp, #-48]!   ; save FP/LR, alloc 48 bytes (32 home + 16)
//   +04: MOV x29, sp
//   +08: BL main                      ; main at .text offset 28
//   +12: ADRP x16, <IAT page>         ; patched at WritePE64 time
//   +16: LDR x16, [x16, #<IAT off>]  ; patched at WritePE64 time
//   +20: BLR x16                      ; call ExitProcess(main_retval)
//   +24: BRK #0                       ; unreachable
//   +28: [main code from EmitARM64]
//
// .rdata import layout (99 bytes):
//   +0:  IDT[0] (20 bytes): KERNEL32.DLL / ExitProcess
//   +20: IDT[1] (20 bytes): null terminator
//   +40: INT[0] (8 bytes):  RVA of ExitProcess name entry
//   +48: INT[1] (8 bytes):  null
//   +56: IAT[0] (8 bytes):  RVA of ExitProcess name (loader writes VA)  ← ExitProcess IAT
//   +64: IAT[1] (8 bytes):  null
//   +72: "KERNEL32.DLL\0" (13 bytes)
//   +85: hint(2) + "ExitProcess\0" (14 bytes)
//   = 99 bytes total

// ============================================================================
// Layout constants
// ============================================================================

con WAB_IMAGE_BASE:   int64 := 0x140000000;
con WAB_TEXT_RVA:     int64 := 0x1000;
con WAB_ENTRY_OFF:    int64 := 0;       // _start is at .text offset 0
con WAB_START_SIZE:   int64 := 28;      // _start stub size in bytes
con WAB_FILE_ALIGN:   int64 := 0x200;   // 512 bytes
con WAB_SEC_ALIGN:    int64 := 0x1000;  // 4096 bytes

// .rdata relative offsets
con WAB_RDATA_IDT_OFF:  int64 := 0;    // Import Directory Table (40 bytes)
con WAB_RDATA_INT_OFF:  int64 := 40;   // Import Name Table (16 bytes)
con WAB_RDATA_IAT_OFF:  int64 := 56;   // Import Address Table (16 bytes)
con WAB_RDATA_DLL_OFF:  int64 := 72;   // "KERNEL32.DLL\0" (13 bytes)
con WAB_RDATA_EP_NAME:  int64 := 85;   // hint(2) + "ExitProcess\0" (14 bytes)
con WAB_RDATA_SIZE:     int64 := 99;   // total .rdata bytes used

// ============================================================================
// WinARM64Backend
// ============================================================================

pub type WinARM64Backend = class {
  code:    int64;   // code buffer (ARM64 bytes: _start stub + main)
  codeLen: int64;
  codeCap: int64;
  out:     int64;   // PE output buffer
  outLen:  int64;
  outCap:  int64;

  // -------------------------------------------------------------------------
  // Output buffer helpers
  // -------------------------------------------------------------------------

  fn wab_oe8(v: int64) {
    poke8(self.out + self.outLen, v & 0xFF);
    self.outLen := self.outLen + 1;
  }

  fn wab_oe16(v: int64) {
    self.wab_oe8(v);
    self.wab_oe8(v >> 8);
  }

  fn wab_oe32(v: int64) {
    self.wab_oe8(v);
    self.wab_oe8(v >> 8);
    self.wab_oe8(v >> 16);
    self.wab_oe8(v >> 24);
  }

  fn wab_oe64(v: int64) {
    self.wab_oe32(v);
    self.wab_oe32(v >> 32);
  }

  fn wab_oZeros(count: int64) {
    var i: int64 := 0;
    while i < count {
      self.wab_oe8(0);
      i := i + 1;
    }
  }

  fn wab_oName8(name: pchar, len: int64) {
    var i: int64 := 0;
    while i < 8 {
      if i < len { self.wab_oe8(name[i] as int64); }
      else        { self.wab_oe8(0); }
      i := i + 1;
    }
  }

  // -------------------------------------------------------------------------
  // Code buffer helpers
  // -------------------------------------------------------------------------

  fn wab_ce8(v: int64) {
    poke8(self.code + self.codeLen, v & 0xFF);
    self.codeLen := self.codeLen + 1;
  }

  fn wab_ce32(v: int64) {
    self.wab_ce8(v);
    self.wab_ce8(v >> 8);
    self.wab_ce8(v >> 16);
    self.wab_ce8(v >> 24);
  }

  // Patch 4 bytes at a code buffer offset (little-endian)
  fn wab_patch32(off: int64, val: int64) {
    poke8(self.code + off,     val & 0xFF);
    poke8(self.code + off + 1, (val >> 8)  & 0xFF);
    poke8(self.code + off + 2, (val >> 16) & 0xFF);
    poke8(self.code + off + 3, (val >> 24) & 0xFF);
  }

  // -------------------------------------------------------------------------
  // Alignment helper
  // -------------------------------------------------------------------------

  fn wab_alignUp(v: int64, a: int64): int64 {
    return (v + a - 1) & -a;
  }

  // -------------------------------------------------------------------------
  // _start stub emitter (28 bytes)
  // -------------------------------------------------------------------------

  fn wab_emitStart() {
    // STP x29, x30, [sp, #-48]!  (allocate 48 bytes: 32 home + 16 for x29/x30)
    // Encoding: 0xA9BC7BFD
    self.wab_ce32(0xA9BC7BFD);
    // MOV x29, sp  (ADD x29, sp, #0) = 0x910003FD
    self.wab_ce32(0x910003FD);
    // BL main at offset 28 from current PC (offset 8):
    //   delta = (28 - 8) / 4 = 5 instructions forward
    //   BL: 0x94000000 | 5 = 0x94000005
    self.wab_ce32(0x94000005);
    // ADRP x16, <IAT page>  (placeholder = 0, patched later)
    self.wab_ce32(0);
    // LDR x16, [x16, #<IAT offset>]  (placeholder = 0, patched later)
    self.wab_ce32(0);
    // BLR x16 = 0xD63F0200
    self.wab_ce32(0xD63F0200);
    // BRK #0 = 0xD4200000 (unreachable, defensive)
    self.wab_ce32(0xD4200000);
    // Total: 7 × 4 = 28 bytes ✓
  }

  // -------------------------------------------------------------------------
  // Patch ADRP + LDR for ExitProcess IAT call
  // Called after all code has been emitted (codeLen known).
  // -------------------------------------------------------------------------

  fn wab_patchIAT() {
    var rdataRVA: int64 := self.wab_alignUp(WAB_TEXT_RVA + self.codeLen, WAB_SEC_ALIGN);
    var iatVA:    int64 := WAB_IMAGE_BASE + rdataRVA + WAB_RDATA_IAT_OFF;

    // ADRP x16 at .text VA = WAB_IMAGE_BASE + WAB_TEXT_RVA + 12
    var adrpVA: int64 := WAB_IMAGE_BASE + WAB_TEXT_RVA + 12;

    // Page delta: (page(IAT_VA) - page(ADRP_PC)) / 4096
    var iatPage:  int64 := iatVA >> 12;
    var adrpPage: int64 := adrpVA >> 12;
    var pageDelta: int64 := iatPage - adrpPage;

    // ADRP encoding: 0x90000000 | (immlo<<29) | (immhi<<5) | Rd
    // immlo = pageDelta[1:0], immhi = pageDelta[20:2]
    var immlo: int64 := pageDelta & 3;
    var immhi: int64 := (pageDelta >> 2) & 0x7FFFF;
    var adrpEnc: int64 := 0x90000010 | (immlo << 29) | (immhi << 5);

    // LDR x16, [x16, #offset] at .text offset 16
    // offset = byte offset of IAT entry within its page
    var iatByteOff: int64 := iatVA & 0xFFF;
    // LDR Xt (64-bit): imm12 = byteOffset / 8
    var imm12: int64 := iatByteOff / 8;
    // LDR encoding: 0xF9400000 | (imm12<<10) | (Rn<<5) | Rt  (Rn=Rt=x16=16)
    var ldrEnc: int64 := 0xF9400000 | (imm12 << 10) | (16 << 5) | 16;

    // Patch code at offsets 12 (ADRP) and 16 (LDR)
    self.wab_patch32(12, adrpEnc);
    self.wab_patch32(16, ldrEnc);
  }

  // -------------------------------------------------------------------------
  // DOS header (64 bytes)
  // -------------------------------------------------------------------------

  fn wab_writeDosHeader(peOffset: int64) {
    self.wab_oe16(0x5A4D);  // e_magic "MZ"
    self.wab_oe16(0x0090);  // e_cblp
    self.wab_oe16(0x0003);  // e_cp
    self.wab_oe16(0x0000);  // e_crlc
    self.wab_oe16(0x0004);  // e_cparhdr
    self.wab_oe16(0x0000);  // e_minalloc
    self.wab_oe16(0xFFFF);  // e_maxalloc
    self.wab_oe16(0x0000);  // e_ss
    self.wab_oe16(0x00B8);  // e_sp
    self.wab_oe16(0x0000);  // e_csum
    self.wab_oe16(0x0000);  // e_ip
    self.wab_oe16(0x0000);  // e_cs
    self.wab_oe16(0x0040);  // e_lfarlc
    self.wab_oe16(0x0000);  // e_ovno
    // e_res (4 words)
    self.wab_oe16(0); self.wab_oe16(0); self.wab_oe16(0); self.wab_oe16(0);
    self.wab_oe16(0x0000);  // e_oemid
    self.wab_oe16(0x0000);  // e_oeminfo
    // e_res2 (10 words)
    var i: int64 := 0;
    while i < 10 { self.wab_oe16(0); i := i + 1; }
    self.wab_oe32(peOffset);  // e_lfanew
  }

  // -------------------------------------------------------------------------
  // DOS stub (64 bytes)
  // -------------------------------------------------------------------------

  fn wab_writeDosStub() {
    // push cs; pop ds; mov dx,0x000e; mov ah,9; int 0x21; mov ax,0x4c01; int 0x21
    self.wab_oe8(0x0E); self.wab_oe8(0x1F); self.wab_oe8(0xBA); self.wab_oe8(0x0E);
    self.wab_oe8(0x00); self.wab_oe8(0xB4); self.wab_oe8(0x09); self.wab_oe8(0xCD);
    self.wab_oe8(0x21); self.wab_oe8(0xB8); self.wab_oe8(0x01); self.wab_oe8(0x4C);
    self.wab_oe8(0xCD); self.wab_oe8(0x21);
    // "This program cannot be run in DOS mode.\r\n$"
    self.wab_oe8(84);  self.wab_oe8(104); self.wab_oe8(105); self.wab_oe8(115);
    self.wab_oe8(32);  self.wab_oe8(112); self.wab_oe8(114); self.wab_oe8(111);
    self.wab_oe8(103); self.wab_oe8(114); self.wab_oe8(97);  self.wab_oe8(109);
    self.wab_oe8(32);  self.wab_oe8(99);  self.wab_oe8(97);  self.wab_oe8(110);
    self.wab_oe8(110); self.wab_oe8(111); self.wab_oe8(116); self.wab_oe8(32);
    self.wab_oe8(98);  self.wab_oe8(101); self.wab_oe8(32);  self.wab_oe8(114);
    self.wab_oe8(117); self.wab_oe8(110); self.wab_oe8(32);  self.wab_oe8(105);
    self.wab_oe8(110); self.wab_oe8(32);  self.wab_oe8(68);  self.wab_oe8(79);
    self.wab_oe8(83);  self.wab_oe8(32);  self.wab_oe8(109); self.wab_oe8(111);
    self.wab_oe8(100); self.wab_oe8(101); self.wab_oe8(46);  self.wab_oe8(13);
    self.wab_oe8(10);  self.wab_oe8(36);
    // pad to 64 bytes: 14 + 42 = 56 bytes, need 8 more
    self.wab_oe8(0); self.wab_oe8(0); self.wab_oe8(0); self.wab_oe8(0);
    self.wab_oe8(0); self.wab_oe8(0); self.wab_oe8(0); self.wab_oe8(0);
  }

  // -------------------------------------------------------------------------
  // .rdata section (import tables for ExitProcess from KERNEL32.DLL)
  // -------------------------------------------------------------------------

  fn wab_writeRdata(rdataRVA: int64) {
    // Import Directory Table entry [0] (20 bytes)
    // OriginalFirstThunk = RVA of INT[0]
    self.wab_oe32(rdataRVA + WAB_RDATA_INT_OFF);
    self.wab_oe32(0);   // TimeDateStamp
    self.wab_oe32(0);   // ForwarderChain
    // Name = RVA of "KERNEL32.DLL\0"
    self.wab_oe32(rdataRVA + WAB_RDATA_DLL_OFF);
    // FirstThunk = RVA of IAT[0]
    self.wab_oe32(rdataRVA + WAB_RDATA_IAT_OFF);

    // Import Directory Table entry [1]: null terminator (20 bytes)
    self.wab_oe32(0); self.wab_oe32(0); self.wab_oe32(0);
    self.wab_oe32(0); self.wab_oe32(0);

    // INT[0] (8 bytes): RVA of ExitProcess name entry
    self.wab_oe64(rdataRVA + WAB_RDATA_EP_NAME);
    // INT[1] (8 bytes): null
    self.wab_oe64(0);

    // IAT[0] (8 bytes): RVA of ExitProcess name (loader writes VA)
    self.wab_oe64(rdataRVA + WAB_RDATA_EP_NAME);
    // IAT[1] (8 bytes): null
    self.wab_oe64(0);

    // DLL name: "KERNEL32.DLL\0" (13 bytes)
    self.wab_oe8(75);  // K
    self.wab_oe8(69);  // E
    self.wab_oe8(82);  // R
    self.wab_oe8(78);  // N
    self.wab_oe8(69);  // E
    self.wab_oe8(76);  // L
    self.wab_oe8(51);  // 3
    self.wab_oe8(50);  // 2
    self.wab_oe8(46);  // .
    self.wab_oe8(68);  // D
    self.wab_oe8(76);  // L
    self.wab_oe8(76);  // L
    self.wab_oe8(0);   // NUL

    // Hint + "ExitProcess\0" (14 bytes)
    self.wab_oe16(0);   // hint = 0
    self.wab_oe8(69);  self.wab_oe8(120); self.wab_oe8(105); self.wab_oe8(116); // Exit
    self.wab_oe8(80);  self.wab_oe8(114); self.wab_oe8(111); self.wab_oe8(99);  // Proc
    self.wab_oe8(101); self.wab_oe8(115); self.wab_oe8(115); self.wab_oe8(0);   // ess NUL

    // Total WAB_RDATA_SIZE = 99 bytes. Pad to FILE_ALIGNMENT.
    self.wab_oZeros(WAB_FILE_ALIGN - WAB_RDATA_SIZE);
  }

  // -------------------------------------------------------------------------
  // Full PE64-ARM64 writer
  // -------------------------------------------------------------------------

  fn wab_writePE64(path: pchar) {
    var codeLen:      int64 := self.codeLen;
    var textRawSize:  int64 := self.wab_alignUp(codeLen, WAB_FILE_ALIGN);
    var rdataRVA:     int64 := self.wab_alignUp(WAB_TEXT_RVA + codeLen, WAB_SEC_ALIGN);
    var rdataFileOff: int64 := WAB_FILE_ALIGN + textRawSize;
    var imageSize:    int64 := rdataRVA + WAB_SEC_ALIGN;
    var entryRVA:     int64 := WAB_TEXT_RVA + WAB_ENTRY_OFF;  // 0x1000

    // ---- DOS Header (64 bytes) ----
    self.wab_writeDosHeader(128);  // PE signature at offset 128

    // ---- DOS Stub (64 bytes) ----
    self.wab_writeDosStub();

    // ---- PE Signature "PE\0\0" (4 bytes) ----
    self.wab_oe8(80); self.wab_oe8(69); self.wab_oe8(0); self.wab_oe8(0);

    // ---- COFF Header (20 bytes) ----
    self.wab_oe16(0xAA64);   // Machine = IMAGE_FILE_MACHINE_ARM64
    self.wab_oe16(2);        // NumberOfSections
    self.wab_oe32(0);        // TimeDateStamp
    self.wab_oe32(0);        // PointerToSymbolTable
    self.wab_oe32(0);        // NumberOfSymbols
    self.wab_oe16(240);      // SizeOfOptionalHeader
    self.wab_oe16(0x0022);   // IMAGE_FILE_EXECUTABLE_IMAGE | IMAGE_FILE_LARGE_ADDRESS_AWARE

    // ---- Optional Header PE32+ (240 bytes) ----
    self.wab_oe16(0x020B);   // Magic = PE32+
    self.wab_oe8(14);        // MajorLinkerVersion
    self.wab_oe8(0);         // MinorLinkerVersion
    self.wab_oe32(textRawSize);       // SizeOfCode
    self.wab_oe32(WAB_FILE_ALIGN);    // SizeOfInitializedData (.rdata raw)
    self.wab_oe32(0);                 // SizeOfUninitializedData
    self.wab_oe32(entryRVA);          // AddressOfEntryPoint
    self.wab_oe32(WAB_TEXT_RVA);      // BaseOfCode
    self.wab_oe64(WAB_IMAGE_BASE);    // ImageBase
    self.wab_oe32(WAB_SEC_ALIGN);     // SectionAlignment = 4096
    self.wab_oe32(WAB_FILE_ALIGN);    // FileAlignment = 512
    self.wab_oe16(10); self.wab_oe16(0);   // OS Version 10.0 (Windows 10)
    self.wab_oe16(0);  self.wab_oe16(0);   // Image Version
    self.wab_oe16(10); self.wab_oe16(0);   // Subsystem Version 10.0
    self.wab_oe32(0);                 // Win32VersionValue
    self.wab_oe32(imageSize);         // SizeOfImage
    self.wab_oe32(WAB_FILE_ALIGN);    // SizeOfHeaders = 512
    self.wab_oe32(0);                 // CheckSum
    self.wab_oe16(3);                 // Subsystem = IMAGE_SUBSYSTEM_WINDOWS_CUI
    self.wab_oe16(0x0160);            // DllCharacteristics: HIGH_ENTROPY_VA|DYNAMIC_BASE|NX_COMPAT
    self.wab_oe64(0x100000);          // SizeOfStackReserve = 1 MB
    self.wab_oe64(0x1000);            // SizeOfStackCommit = 4 KB
    self.wab_oe64(0x100000);          // SizeOfHeapReserve = 1 MB
    self.wab_oe64(0x1000);            // SizeOfHeapCommit = 4 KB
    self.wab_oe32(0);                 // LoaderFlags
    self.wab_oe32(16);                // NumberOfRvaAndSizes

    // Data Directories (16 entries × 8 bytes = 128 bytes)
    self.wab_oe32(0); self.wab_oe32(0);                                    // [0] Export
    self.wab_oe32(rdataRVA); self.wab_oe32(40);                            // [1] Import (IDT, 40 bytes)
    self.wab_oe32(0); self.wab_oe32(0);                                    // [2] Resource
    self.wab_oe32(0); self.wab_oe32(0);                                    // [3] Exception
    self.wab_oe32(0); self.wab_oe32(0);                                    // [4] Security
    self.wab_oe32(0); self.wab_oe32(0);                                    // [5] BaseReloc
    self.wab_oe32(0); self.wab_oe32(0);                                    // [6] Debug
    self.wab_oe32(0); self.wab_oe32(0);                                    // [7] Architecture
    self.wab_oe32(0); self.wab_oe32(0);                                    // [8] GlobalPtr
    self.wab_oe32(0); self.wab_oe32(0);                                    // [9] TLS
    self.wab_oe32(0); self.wab_oe32(0);                                    // [10] LoadConfig
    self.wab_oe32(0); self.wab_oe32(0);                                    // [11] BoundImport
    self.wab_oe32(rdataRVA + WAB_RDATA_IAT_OFF); self.wab_oe32(16);       // [12] IAT (2×8)
    self.wab_oe32(0); self.wab_oe32(0);                                    // [13] DelayImport
    self.wab_oe32(0); self.wab_oe32(0);                                    // [14] CLR
    self.wab_oe32(0); self.wab_oe32(0);                                    // [15] Reserved

    // ---- Section Header .text (40 bytes) ----
    self.wab_oName8(".text"c, 5);
    self.wab_oe32(codeLen);           // VirtualSize
    self.wab_oe32(WAB_TEXT_RVA);      // VirtualAddress = 0x1000
    self.wab_oe32(textRawSize);       // SizeOfRawData
    self.wab_oe32(WAB_FILE_ALIGN);    // PointerToRawData = 512
    self.wab_oe32(0);                 // PointerToRelocations
    self.wab_oe32(0);                 // PointerToLinenumbers
    self.wab_oe16(0);                 // NumberOfRelocations
    self.wab_oe16(0);                 // NumberOfLinenumbers
    self.wab_oe32(0x60000020);        // CODE | MEM_EXECUTE | MEM_READ

    // ---- Section Header .rdata (40 bytes) ----
    self.wab_oName8(".rdata"c, 6);
    self.wab_oe32(WAB_RDATA_SIZE);    // VirtualSize = 99
    self.wab_oe32(rdataRVA);          // VirtualAddress
    self.wab_oe32(WAB_FILE_ALIGN);    // SizeOfRawData = 512
    self.wab_oe32(rdataFileOff);      // PointerToRawData
    self.wab_oe32(0);                 // PointerToRelocations
    self.wab_oe32(0);                 // PointerToLinenumbers
    self.wab_oe16(0);                 // NumberOfRelocations
    self.wab_oe16(0);                 // NumberOfLinenumbers
    self.wab_oe32(0x40000040);        // INITIALIZED_DATA | MEM_READ

    // ---- Pad headers to FILE_ALIGNMENT (512) ----
    self.wab_oZeros(WAB_FILE_ALIGN - self.outLen);

    // ---- .text section ----
    var i: int64 := 0;
    while i < codeLen {
      self.wab_oe8(peek8(self.code + i));
      i := i + 1;
    }
    self.wab_oZeros(textRawSize - codeLen);

    // ---- .rdata section ----
    self.wab_writeRdata(rdataRVA);

    // ---- Write to file ----
    var fd: int64 := open(path, 577, 493);
    if fd < 0 {
      EPrintStr("error: cannot write output: "c);
      EPrintStrLn(path);
      return;
    }
    write(fd, self.out as pchar, self.outLen);
    close(fd);
  }

  // -------------------------------------------------------------------------
  // Public API
  // -------------------------------------------------------------------------

  // Build: prepend _start stub, then append IR-emitted code
  pub fn Build(irBuf: int64, irLen: int64) {
    self.wab_emitStart();  // emit 28-byte _start stub at offset 0
    // Copy IR-emitted main code at offset WAB_START_SIZE
    var i: int64 := 0;
    while i < irLen {
      self.wab_ce8(peek8(irBuf + i));
      i := i + 1;
    }
    // Patch ADRP+LDR now that codeLen is known
    self.wab_patchIAT();
  }

  pub fn WritePE64(path: pchar) {
    self.wab_writePE64(path);
  }

  pub fn GetCodeSize(): int64 { return self.codeLen; }

  pub fn Init() {
    self.codeCap := 65536;
    self.code    := mmap(0, self.codeCap, 3, 34, -1, 0);
    self.codeLen := 0;
    self.outCap  := 131072;
    self.out     := mmap(0, self.outCap, 3, 34, -1, 0);
    self.outLen  := 0;
  }

};
