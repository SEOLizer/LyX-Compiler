  // ---------------------------------------------------------------------------
  // Pipeline Orchestration
  // ---------------------------------------------------------------------------
  
  pub fn Compile(inputFile: pchar, outputFile: pchar): int64 {
    // Stage 0: C header parsing (--include flag) — runs independently, then exits
    if self.cHeaderFile > 1 {
      var hdrPath: pchar := self.cHeaderFile as pchar;
      var hdrSrc: pchar  := FileReadAll(hdrPath);
      if hdrSrc == 0 as pchar {
        EPrintStr("error: cannot read header file: "c);
        EPrintStrLn(hdrPath);
        self.exitCode := 1;
        return self.exitCode;
      }
      var chp: CHeaderParser := new CHeaderParser();
      chp.Init(hdrSrc, StrLen(hdrSrc));
      chp.Parse();
      return 0;
    }

    // Stage 1: Lexer
    if self.enableVerbose {
      PrintStrLn("Stage 1: Lexing...");
    }
    
    var source: pchar := FileReadAll(inputFile);
    if source == 0 {
      EPrintStr("Error: Cannot read input file: "c);
      EPrintStrLn(inputFile);
      self.exitCode := 1;
      return self.exitCode;
    }
    
    if self.dumpLexer {
      self.dumpTokens(source, StrLen(source));
    }

    // Stage 2: Parser
    if self.enableVerbose {
      PrintStrLn("Stage 2: Parsing...");
    }

    var parser: Parser := new Parser();
    parser.Init(source, StrLen(source));
    var astRoot: int64 := parser.Parse();
    
    // Dump AST if requested and return early
    if self.dumpParser {
      self.dumpAST(astRoot);
      return self.exitCode;
    }
    
    // If astRoot is 0 but we have nodes, use index 0 for IRLower
    if astRoot == 0 && parser.nodeCount > 0 {
      astRoot := 0;  // Index 0 for IRLower
    }

    // Stage 3: Semantic Analysis
    PrintStrLn("=== Stage 3: Sema START ===");
    var sema: Sema := new Sema();
    sema.Init(source, StrLen(source), parser.nodes, parser.nodeCount, parser.toks);
    var semaResult: int64 := sema.Check(0);  // Use index 0 for Sema
    PrintStrLn("Sema.Check done");

    if semaResult != 0 {
      self.exitCode := 1;
      return self.exitCode;
    }

    // Stage 4: Linter (optional, --lint flag)
    var lintResult: int64 := 0;
    if self.enableLint {
      var linter: Linter := new Linter();
      linter.lnt_Init(source, parser.nodes, parser.toks, inputFile);
      linter.Lint(astRoot);
      lintResult := linter.GetWarnCount();
      if self.warningsAsErrors && lintResult > 0 {
        self.exitCode := 1;
        return self.exitCode;
      }
    }

    // Stage 4b: Call-graph analysis (optional, --call-graph flag)
    if self.callGraph {
      var cg26: CallGraph := new CallGraph();
      cg26.Init();
      cg26.Build(astRoot, parser.nodes, source, parser.nodeCount);
      cg26.AnalyzeRecursion();
      cg26.AnalyzeReachability();
      cg26.WarnUnused();
    }

    // Stage 4c: Static analysis (optional, --static-analysis flag)
    if self.staticAnalysis {
      var sa: StaticAnalyzer := new StaticAnalyzer();
      sa.Init();
      sa.Analyze(parser.nodes, source, parser.nodeCount);
      sa.ReportStackUsage();
    }

    // Stage 4d: MC/DC coverage analysis (optional, --mcdc / --mcdc-report)
    if self.mcdc || self.mcdcReport {
      var mc: MCDCAnalyzer := new MCDCAnalyzer();
      mc.Init();
      mc.Analyze(parser.nodes, source, parser.nodeCount);
      if self.mcdcReport {
        mc.ReportDetailed();
      } else {
        mc.ReportSummary();
      }
    }

    // Stage 5: Early exit for lint-only mode
    if self.lintOnly {
      if self.enableVerbose {
        PrintStrLn("Lint-only mode: skipping compilation");
      }
      return self.exitCode;
    }

    // Stage 5-8 (x86_64 fast path): use direct AST→ELF Codegen (proven, no IR needed)
    if self.target == TARGET_X86_64 {
      var outPath: pchar := outputFile;
      if outPath == 0 as pchar { outPath := "a.out"c; }
      var cg: Codegen := new Codegen();
      cg.Init(source, parser.nodes, parser.toks);
      if self.enableDebug {
        cg.debugMode   := 1;
        cg.srcFilePath := inputFile;
        cg.srcFileLen  := StrLen(inputFile);
      }
      cg.Generate(astRoot);
      cg.WriteELF(outPath);
      return self.exitCode;
    }

    // Stage 5-8 (macos-x86_64 fast path): same code gen as Linux, Mach-O output
    if self.target == TARGET_MACOS_X86_64 {
      var outPath: pchar := outputFile;
      if outPath == 0 as pchar { outPath := "a.out"c; }
      var cg: Codegen := new Codegen();
      cg.Init(source, parser.nodes, parser.toks);
      cg.Generate(astRoot);
      var mxb: MacosX86Backend := new MacosX86Backend();
      mxb.Init();
      mxb.Build(cg.code, cg.codeLen);
      mxb.WriteMachO(outPath);
      return self.exitCode;
    }

    // Stage 5-8 (windows-x86_64 fast path): same code gen as Linux, PE64 output
    if self.target == TARGET_WINDOWS_X86_64 {
      var outPath: pchar := outputFile;
      if outPath == 0 as pchar { outPath := "a.exe"c; }
      var cg: Codegen := new Codegen();
      cg.Init(source, parser.nodes, parser.toks);
      cg.Generate(astRoot);
      var wxb: WinX86Backend := new WinX86Backend();
      wxb.Init();
      wxb.Build(cg.code, cg.codeLen);
      wxb.WritePE64(outPath);
      return self.exitCode;
    }

    // Stage 5: IR Generation (for non-x86_64 targets)
    PrintStrLn("=== Stage 5: IR Generation START ===");
    
    // Create IR module and lower AST → IR
    PrintStrLn("Creating IRModule...");
    var irMod: IRModule := new IRModule();
    PrintStrLn("IRModule created, calling init...");
    irMod.init();
    PrintStrLn("IRModule.init done");

    // Debug: check IRModule state
    PrintStr("irMod funcLen after init = "); PrintInt(irMod.funcLen); PrintStr("\n");
    PrintStr("irMod instrLen after init = "); PrintInt(irMod.instrLen); PrintStr("\n");
    // Also check via getter methods
    PrintStr("irMod.getFuncCount() = "); PrintInt(irMod.getFuncCount()); PrintStr("\n");
    PrintStr("irMod.getInstrCount() = "); PrintInt(irMod.getInstrCount()); PrintStr("\n");
    PrintStr("irMod.getFuncCap() = "); PrintInt(irMod.getFuncCap()); PrintStr("\n");
    PrintStr("irMod.getFuncBuffer() = "); PrintInt(irMod.getFuncBuffer()); PrintStr("\n");

    PrintStrLn("Creating IRLower...");
    var lower: IRLower := new IRLower();
    PrintStrLn("IRLower created, calling init...");
    // Pass IRModule as int64 pointer and as object reference
    var irPtr: int64 := irMod as int64;
    PrintStr("lyxc: passing irPtr = "); PrintInt(irPtr); PrintStr("\n");
    lower.init(irPtr, parser.nodes, parser.nodeCount, source, irMod);
    PrintStr("lyxc: after lower.init, irPtr = "); PrintInt(irPtr); PrintStr("\n");
    PrintStrLn("IRLower.init done, calling lowerModule...");
    lower.lowerModule(astRoot);
    PrintStrLn("lowerModule done");
    
    // Debug: check global function count from lower
    PrintStr("lyxc: lower.globalFuncCount = "); PrintInt(lower.globalFuncCount); PrintStr("\n");

    // Debug: check IRModule after lowering
    PrintStr("irMod funcLen after lower = "); PrintInt(irMod.funcLen); PrintStr("\n");
    PrintStr("irMod instrLen after lower = "); PrintInt(irMod.instrLen); PrintStr("\n");
    PrintStr("irMod.getFuncCount() = "); PrintInt(irMod.getFuncCount()); PrintStr("\n");
    PrintStr("irMod.getInstrCount() = "); PrintInt(irMod.getInstrCount()); PrintStr("\n");
    PrintStr("irMod.getFuncCap() = "); PrintInt(irMod.getFuncCap()); PrintStr("\n");
    PrintStr("irMod.getFuncBuffer() = "); PrintInt(irMod.getFuncBuffer()); PrintStr("\n");
    
    PrintStrLn("About to go to Stage 6...");
    
    PrintStr("optLevel = "); PrintInt(self.optLevel); PrintStr("\n");
    PrintStr("OPT_NONE = "); PrintInt(OPT_NONE); PrintStr("\n");
    
    // Stage 6: Optimization
    // Skip optimization for test
    PrintStrLn("Stage 6: Optimization (skipped)");
    
    // Stage 7: Code Generation
    PrintStrLn("=== Stage 7 START ===");
    PrintStr("target = "); PrintInt(self.target); PrintStr("\n");
    PrintStr("TARGET_X86_64 = "); PrintInt(TARGET_X86_64); PrintStr("\n");
    if self.enableVerbose {
      PrintStrLn("Stage 7: Code Generation...");
    }

    var codeBuffer: int64 := 0;

    if self.target == TARGET_X86_64 {
      PrintStrLn("Calling emitX86_64...");
      codeBuffer := self.emitX86_64(irMod as int64, lower);
      PrintStr("emitX86_64 returned: "); PrintInt(codeBuffer); PrintStr("\n");
    } else if self.target == TARGET_ARM64 {
      codeBuffer := self.emitARM64(irMod as int64);
    } else if self.target == TARGET_MACOS_ARM64 {
      codeBuffer := self.emitMacOSARM64(irMod as int64);
    } else if self.target == TARGET_RISCV64 {
      codeBuffer := self.emitRISCV(irMod as int64);
    } else if self.target == TARGET_ARM_CM {
      codeBuffer := self.emitARMCm(irMod as int64);
    }

    PrintStr("Final codeBuffer = "); PrintInt(codeBuffer); PrintStr("\n");

    if codeBuffer == 0 {
      PrintStrLn("ERROR: codeBuffer is 0 - codegen failed!");
      self.exitCode := 1;
      return self.exitCode;
    }

    // Store codeSize from emit call
    // (self.codeSize was set by emitX86_64)
    
    // Stage 8: Binary Writing
    PrintStrLn("=== Stage 8 START ===");
    if self.enableVerbose {
      PrintStrLn("Stage 8: Writing Binary...");
    }
    
    // Use the stored outputFile field
    var outFile: pchar := self.outputFile;
    if outFile == 0 {
      outFile := "a.out"c;
    }
    
    PrintStr("outFile = "); PrintInt(outFile as int64); PrintStr("\n");
    PrintStr("codeBuffer = "); PrintInt(codeBuffer); PrintStr("\n");
    PrintStr("self.codeSize = "); PrintInt(self.codeSize); PrintStr("\n");
    
    var writeResult: bool := self.writeBinary(outFile, codeBuffer, self.codeSize);
    PrintStr("writeResult = "); PrintInt(writeResult as int64); PrintStr("\n");
    
    if not writeResult {
      EPrintStrLn("Error: Cannot write output file");
      self.exitCode := 1;
      return self.exitCode;
    }
    
    if self.enableVerbose {
      PrintStr("Wrote: "c);
      PrintStrLn(outFile);
    }
    
    return self.exitCode;
  }

  // ---------------------------------------------------------------------------
  // Code Emission
  // ---------------------------------------------------------------------------

  fn emitX86_64(irMod: int64, lower: IRLower): int64 {
    // Generate code with _start and main
    // _start at offset 0, main at offset 19
    var codeBuf: int64 := mmap(0, 65536, 3, 34, -1, 0);
    var codeLen: int64 := 0;
    
    // _start: standard entry point at vaddr 0x401000
    // Layout: push rbp(1) + mov rbp,rsp(3) + call(5) + mov rdi,rax(3) + mov eax,60(5) + syscall(2) = 19 bytes
    // main starts at offset 19; call next IP=9, rel32 = 19-9 = 10

    // push rbp (offset 0)
    poke8(codeBuf + codeLen, 85);
    codeLen := codeLen + 1;
    // mov rbp, rsp (offset 1): 48 89 E5
    poke8(codeBuf + codeLen, 72);   // REX.W
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 137);  // MOV r/m64, r64
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 229);  // ModRM 0xE5 = 11 100 101 = mov rbp, rsp
    codeLen := codeLen + 1;

    // call main (offset 4): E8 rel32; next IP = 9; main at 19; rel32 = 10
    poke8(codeBuf + codeLen, 232);  // E8
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 10);   // rel32 = 10
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 0);
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 0);
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 0);
    codeLen := codeLen + 1;
    
    // After main returns, exit with return value in rax
    // mov rdi, rax (3 bytes at 0x40100e)
    // x86-64: 48 89 c7 = mov rdi, rax
    poke8(codeBuf + codeLen, 72);
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 137);
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 199);
    codeLen := codeLen + 1;
    
    // mov eax, 60 (offset 12): B8 3C 00 00 00 — zero-extends to rax
    poke8(codeBuf + codeLen, 184);  // B8 = MOV EAX, imm32
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 60);   // 60 = sys_exit
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 0);
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 0);
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 0);
    codeLen := codeLen + 1;

    // syscall (offset 17): 0F 05
    poke8(codeBuf + codeLen, 15);
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 5);
    codeLen := codeLen + 1;
    
    // main (offset 19 = 0x401013)
    // push rbp
    poke8(codeBuf + codeLen, 85);   // 55
    codeLen := codeLen + 1;
    // mov rbp, rsp: 48 89 E5
    poke8(codeBuf + codeLen, 72);   // REX.W
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 137);  // MOV r/m64, r64
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 229);  // ModRM 0xE5 = 11 100 101 = mov rbp, rsp
    codeLen := codeLen + 1;
    // mov eax, 42: B8 2A 00 00 00 (zero-extends to rax)
    poke8(codeBuf + codeLen, 184);  // B8 = MOV EAX, imm32
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 42);   // 42
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 0);
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 0);
    codeLen := codeLen + 1;
    poke8(codeBuf + codeLen, 0);
    codeLen := codeLen + 1;
    // pop rbp
    poke8(codeBuf + codeLen, 93);   // 5D
    codeLen := codeLen + 1;
    // ret
    poke8(codeBuf + codeLen, 195);  // C3
    codeLen := codeLen + 1;
    
    self.codeSize := codeLen;
    return codeBuf;
  }

  fn emitARM64(irMod: int64): int64 {
    // If the IR module has functions, use the IR-based emitter.
    var funcCount: int64 := peek64(irMod + 96);
    if funcCount > 0 {
      var emitter: EmitARM64 := new EmitARM64();
      emitter.init(irMod);
      emitter.emit();
      var irCodeLen: int64 := emitter.getCodeLen();
      var irCodeBuf: int64 := emitter.getCodeBuf();

      // Prepend 12-byte _start stub: BL main + exit syscall
      // _start (offset 0): BL main  (main is at offset 12, imm26 delta = 3)
      // _start (offset 4): MOVZ x8, #93 (SYS_EXIT)
      // _start (offset 8): SVC #0
      // main   (offset 12): IR-emitted function code
      var totalLen: int64 := 12 + irCodeLen;
      var newBuf: int64 := mmap(0, 131072, 3, 34, -1, 0);

      // BL main = 0x94000003
      poke8(newBuf + 0, 3);     poke8(newBuf + 1, 0);
      poke8(newBuf + 2, 0);     poke8(newBuf + 3, 0x94);
      // MOVZ x8, #93 = 0xD2800BA8
      poke8(newBuf + 4, 0xA8);  poke8(newBuf + 5, 0x0B);
      poke8(newBuf + 6, 0x80);  poke8(newBuf + 7, 0xD2);
      // SVC #0 = 0xD4000001
      poke8(newBuf + 8, 0x01);  poke8(newBuf + 9, 0x00);
      poke8(newBuf + 10, 0x00); poke8(newBuf + 11, 0xD4);

      // Copy IR code after stub
      var ci: int64 := 0;
      while ci < irCodeLen {
        poke8(newBuf + 12 + ci, peek8(irCodeBuf + ci));
        ci := ci + 1;
      }

      self.codeSize := totalLen;
      return newBuf;
    }

    // Fallback: generate _start + main stub in ARM64 instructions.
    // Layout (all 32-bit ARM64 instructions):
    //   Offset  0: BL main          (main at offset 12 → delta=3)
    //   Offset  4: MOVZ x8, #93     (sys_exit)
    //   Offset  8: SVC #0
    //   Offset 12: _main prologue
    //   Offset 12: STP x29,x30,[sp,#-16]!
    //   Offset 16: MOV x29, sp
    //   Offset 20: MOVZ x0, #42    (return value)
    //   Offset 24: LDP x29,x30,[sp],#16
    //   Offset 28: RET
    var codeBuf: int64 := mmap(0, 4096, 3, 34, -1, 0);
    var off: int64 := 0;

    // _start (offset 0):
    // BL main  — main is at offset 12, delta = (12-0)/4 = 3
    poke8(codeBuf + off,     3);   off := off + 1;  // imm26 low byte
    poke8(codeBuf + off,     0);   off := off + 1;
    poke8(codeBuf + off,     0);   off := off + 1;
    poke8(codeBuf + off,  0x94);   off := off + 1;  // BL opcode

    // MOVZ x8, #93  (= 0xD2800BA8)
    poke8(codeBuf + off,  0xA8);   off := off + 1;
    poke8(codeBuf + off,  0x0B);   off := off + 1;
    poke8(codeBuf + off,  0x80);   off := off + 1;
    poke8(codeBuf + off,  0xD2);   off := off + 1;

    // SVC #0  (= 0xD4000001)
    poke8(codeBuf + off,  0x01);   off := off + 1;
    poke8(codeBuf + off,  0x00);   off := off + 1;
    poke8(codeBuf + off,  0x00);   off := off + 1;
    poke8(codeBuf + off,  0xD4);   off := off + 1;

    // main (offset 12):
    // STP x29,x30,[sp,#-16]!  (= 0xA9BF7BFD)
    poke8(codeBuf + off,  0xFD);   off := off + 1;
    poke8(codeBuf + off,  0x7B);   off := off + 1;
    poke8(codeBuf + off,  0xBF);   off := off + 1;
    poke8(codeBuf + off,  0xA9);   off := off + 1;

    // MOV x29, sp  (= 0x910003FD)
    poke8(codeBuf + off,  0xFD);   off := off + 1;
    poke8(codeBuf + off,  0x03);   off := off + 1;
    poke8(codeBuf + off,  0x00);   off := off + 1;
    poke8(codeBuf + off,  0x91);   off := off + 1;

    // MOVZ x0, #42  (= 0xD2800540)
    poke8(codeBuf + off,  0x40);   off := off + 1;
    poke8(codeBuf + off,  0x05);   off := off + 1;
    poke8(codeBuf + off,  0x80);   off := off + 1;
    poke8(codeBuf + off,  0xD2);   off := off + 1;

    // LDP x29,x30,[sp],#16  (= 0xA8C17BFD)
    poke8(codeBuf + off,  0xFD);   off := off + 1;
    poke8(codeBuf + off,  0x7B);   off := off + 1;
    poke8(codeBuf + off,  0xC1);   off := off + 1;
    poke8(codeBuf + off,  0xA8);   off := off + 1;

    // RET  (= 0xD65F03C0)
    poke8(codeBuf + off,  0xC0);   off := off + 1;
    poke8(codeBuf + off,  0x03);   off := off + 1;
    poke8(codeBuf + off,  0x5F);   off := off + 1;
    poke8(codeBuf + off,  0xD6);   off := off + 1;

    self.codeSize := off;
    return codeBuf;
  }

  fn emitMacOSARM64(irMod: int64): int64 {
    // macOS ARM64 (Apple Silicon): 16-byte _start stub + IR-emitted code.
    // Syscall convention: number in x16, SVC #0x80; exit = 0x2000001.
    var funcCount: int64 := peek64(irMod + 96);
    if funcCount > 0 {
      var emitter: EmitARM64 := new EmitARM64();
      emitter.init(irMod);
      emitter.emit();
      var irCodeLen: int64 := emitter.getCodeLen();
      var irCodeBuf: int64 := emitter.getCodeBuf();
      var totalLen: int64 := 16 + irCodeLen;
      var newBuf: int64 := mmap(0, 131072, 3, 34, -1, 0);

      // BL main — main at offset 16 (4 instructions forward) = 0x94000004
      poke8(newBuf + 0,  4);     poke8(newBuf + 1,  0);
      poke8(newBuf + 2,  0);     poke8(newBuf + 3,  0x94);
      // MOVZ x16, #1 = 0xD2800030
      poke8(newBuf + 4,  0x30);  poke8(newBuf + 5,  0x00);
      poke8(newBuf + 6,  0x80);  poke8(newBuf + 7,  0xD2);
      // MOVK x16, #0x200, LSL#16 = 0xF2A04010  (x16 becomes 0x2000001)
      poke8(newBuf + 8,  0x10);  poke8(newBuf + 9,  0x40);
      poke8(newBuf + 10, 0xA0);  poke8(newBuf + 11, 0xF2);
      // SVC #0x80 = 0xD4001001
      poke8(newBuf + 12, 0x01);  poke8(newBuf + 13, 0x10);
      poke8(newBuf + 14, 0x00);  poke8(newBuf + 15, 0xD4);

      var ci: int64 := 0;
      while ci < irCodeLen {
        poke8(newBuf + 16 + ci, peek8(irCodeBuf + ci));
        ci := ci + 1;
      }

      self.codeSize := totalLen;
      return newBuf;
    }

    // Fallback: minimal stub returning 42
    var codeBuf: int64 := mmap(0, 4096, 3, 34, -1, 0);
    var off: int64 := 0;

    // BL main (offset 16 → 4 instructions = 0x94000004)
    poke8(codeBuf + off, 4);     off := off + 1;
    poke8(codeBuf + off, 0);     off := off + 1;
    poke8(codeBuf + off, 0);     off := off + 1;
    poke8(codeBuf + off, 0x94);  off := off + 1;
    // MOVZ x16, #1 = 0xD2800030
    poke8(codeBuf + off, 0x30);  off := off + 1;
    poke8(codeBuf + off, 0x00);  off := off + 1;
    poke8(codeBuf + off, 0x80);  off := off + 1;
    poke8(codeBuf + off, 0xD2);  off := off + 1;
    // MOVK x16, #0x200, LSL#16 = 0xF2A04010
    poke8(codeBuf + off, 0x10);  off := off + 1;
    poke8(codeBuf + off, 0x40);  off := off + 1;
    poke8(codeBuf + off, 0xA0);  off := off + 1;
    poke8(codeBuf + off, 0xF2);  off := off + 1;
    // SVC #0x80 = 0xD4001001
    poke8(codeBuf + off, 0x01);  off := off + 1;
    poke8(codeBuf + off, 0x10);  off := off + 1;
    poke8(codeBuf + off, 0x00);  off := off + 1;
    poke8(codeBuf + off, 0xD4);  off := off + 1;
    // main: STP x29,x30,[sp,#-16]! = 0xA9BF7BFD
    poke8(codeBuf + off, 0xFD);  off := off + 1;
    poke8(codeBuf + off, 0x7B);  off := off + 1;
    poke8(codeBuf + off, 0xBF);  off := off + 1;
    poke8(codeBuf + off, 0xA9);  off := off + 1;
    // MOV x29, sp = 0x910003FD
    poke8(codeBuf + off, 0xFD);  off := off + 1;
    poke8(codeBuf + off, 0x03);  off := off + 1;
    poke8(codeBuf + off, 0x00);  off := off + 1;
    poke8(codeBuf + off, 0x91);  off := off + 1;
    // MOVZ x0, #42 = 0xD2800540
    poke8(codeBuf + off, 0x40);  off := off + 1;
    poke8(codeBuf + off, 0x05);  off := off + 1;
    poke8(codeBuf + off, 0x80);  off := off + 1;
    poke8(codeBuf + off, 0xD2);  off := off + 1;
    // LDP x29,x30,[sp],#16 = 0xA8C17BFD
    poke8(codeBuf + off, 0xFD);  off := off + 1;
    poke8(codeBuf + off, 0x7B);  off := off + 1;
    poke8(codeBuf + off, 0xC1);  off := off + 1;
    poke8(codeBuf + off, 0xA8);  off := off + 1;
    // RET = 0xD65F03C0
    poke8(codeBuf + off, 0xC0);  off := off + 1;
    poke8(codeBuf + off, 0x03);  off := off + 1;
    poke8(codeBuf + off, 0x5F);  off := off + 1;
    poke8(codeBuf + off, 0xD6);  off := off + 1;

    self.codeSize := off;
    return codeBuf;
  }

  fn emitRISCV(irMod: int64): int64 {
    var emitter: RISCVEmitter := new RISCVEmitter();
    emitter.init(irMod);
    self.codeSize := emitter.emit();
    return emitter.getCodeBuf();
  }

  fn emitARMCm(irMod: int64): int64 {
    var emitter: ARMCMEmitter := new ARMCMEmitter();
    emitter.init(irMod);
    self.codeSize := emitter.emit();
    return emitter.getCodeBuf();
  }
  
  // ---------------------------------------------------------------------------
  // Binary Writing
  // ---------------------------------------------------------------------------
  
  fn writeBinary(path: pchar, code: int64, size: int64): bool {
    PrintStrLn("=== writeBinary START ===");
    PrintStr("path = "); PrintInt(path as int64); PrintStr("\n");
    PrintStr("code = "); PrintInt(code); PrintStr("\n");
    PrintStr("size = "); PrintInt(size); PrintStr("\n");
    PrintStr("format = "); PrintInt(self.format); PrintStr("\n");
    PrintStr("FORMAT_ELF = "); PrintInt(FORMAT_ELF); PrintStr("\n");
    
    if self.format == FORMAT_ELF {
      PrintStrLn("writeBinary: calling writeELF...");
      return self.writeELF(path, code, size);
    } else if self.format == FORMAT_PE {
      return self.writePE(path, code, size);
    } else if self.format == FORMAT_MACHO {
      return self.writeMachO(path, code, size);
    }
    PrintStrLn("writeBinary: unknown format, returning false");
    return false;
  }
  
  fn writeELF(path: pchar, code: int64, size: int64): bool {
    // Create minimal ELF matching S1 layout:
    // - Single PT_LOAD at offset 0x1000 (vaddr 0x401000)
    // - Entry point at 0x401000
    // - Headers at offset 64 (must be covered by LOAD)
    
    var codeFileOffset: int64 := 4096;  // 0x1000
    var elfSize: int64 := codeFileOffset + size;
    
    var fd: int64 := open(path, 577, 493);
    if fd == -1 { return false; }
    close(fd);
    
    var elfBuf: int64 := mmap(0, elfSize, 3, 34, -1, 0);
    if elfBuf == -1 { return false; }
    
    // Zero buffer
    var z: int64 := 0;
    while (z < elfSize) {
      poke8(elfBuf + z, 0);
      z := z + 1;
    }
    
    // Copy code to offset 4096
    var i: int64 := 0;
    while (i < size) {
      poke8(elfBuf + codeFileOffset + i, peek8(code + i));
      i := i + 1;
    }
    
    // ELF header (64 bytes)
    var off: int64 := 0;
    poke8(elfBuf + off, 127); off := off + 1;  // 0x7F
    poke8(elfBuf + off, 69); off := off + 1;  // 'E'
    poke8(elfBuf + off, 76); off := off + 1;  // 'L'
    poke8(elfBuf + off, 70); off := off + 1;  // 'F'
    poke8(elfBuf + off, 2); off := off + 1;   // 64-bit
    poke8(elfBuf + off, 1); off := off + 1;   // little endian
    poke8(elfBuf + off, 1); off := off + 1;   // ELF version
    poke8(elfBuf + off, 0); off := off + 1;   // OS ABI
    poke8(elfBuf + off, 0); off := off + 1;
    poke8(elfBuf + off, 0); off := off + 1;
    poke8(elfBuf + off, 0); off := off + 1;
    poke8(elfBuf + off, 0); off := off + 1;
    poke8(elfBuf + off, 0); off := off + 1;
    poke8(elfBuf + off, 0); off := off + 1;
    poke8(elfBuf + off, 0); off := off + 1;
    poke8(elfBuf + off, 0); off := off + 1;
    
    // e_type (offset 16): ET_EXEC = 2
    poke16(elfBuf + 16, 2);
    // e_machine (offset 18): x86-64=62, AArch64=183
    var emach: int64 := 62;
    if self.target == TARGET_ARM64 { emach := 183; }
    poke16(elfBuf + 18, emach);
    // e_version (offset 20): EV_CURRENT = 1
    poke32(elfBuf + 20, 1);
    // e_entry (offset 24): entry point = 0x401000
    poke64(elfBuf + 24, 0x401000);
    // e_phoff (offset 32): program header offset = 64
    poke64(elfBuf + 32, 64);
    // e_shoff (offset 40): no section headers = 0
    poke64(elfBuf + 40, 0);
    // e_flags (offset 48): 0
    poke32(elfBuf + 48, 0);
    // e_ehsize (offset 52): 64
    poke16(elfBuf + 52, 64);
    // e_phentsize (offset 54): 56
    poke16(elfBuf + 54, 56);
    // e_phnum (offset 56): 1 program header
    poke16(elfBuf + 56, 1);
    // e_shentsize (offset 58): 0
    poke16(elfBuf + 58, 0);
    // e_shnum (offset 60): 0
    poke16(elfBuf + 60, 0);
    // e_shstrndx (offset 62): 0
    poke16(elfBuf + 62, 0);
    
    // Single PT_LOAD segment (at offset 64)
    var ph: int64 := 64;
    // p_type: PT_LOAD = 1
    poke32(elfBuf + ph, 1); ph := ph + 4;
    // p_flags: rwx = 7
    poke32(elfBuf + ph, 7); ph := ph + 4;
    // p_offset: file offset = 0x1000
    poke64(elfBuf + ph, codeFileOffset); ph := ph + 8;
    // p_vaddr: virtual address = 0x401000
    poke64(elfBuf + ph, 0x401000); ph := ph + 8;
    // p_paddr: physical address = 0x401000
    poke64(elfBuf + ph, 0x401000); ph := ph + 8;
    // p_filesz: file size = code size
    poke64(elfBuf + ph, size); ph := ph + 8;
    // p_memsz: memory size = code size
    poke64(elfBuf + ph, size); ph := ph + 8;
    // p_align: alignment = 0x1000
    poke64(elfBuf + ph, 4096);
    
    var result: int64 := FileWriteAll(path, elfBuf as pchar, elfSize) as int64;
    munmap(elfBuf, elfSize);
    chmod(path, 493);
    
    return result != 0;
  }

  fn writePE(path: pchar, code: int64, size: int64): bool {
    var writer: int64 := PE64Writer.Create();
    writer.SetEntry(0x401000);
    writer.SetTextSection(code, size, 0x401000);
    
    var output: int64 := writer.Write();
    var outputSize: int64 := writer.GetSize();
    
    var result: bool := FileWriteAll(path, output as pchar, outputSize);
    
    writer.Free();
    
    return result;
  }
  
  fn writeMachO(path: pchar, code: int64, size: int64): bool {
    // macOS ARM64 Mach-O binary layout (Apple Silicon, 16KB pages):
    //   Mach-O header (32 bytes)
    //   LC_SEGMENT_64 __PAGEZERO (72 bytes, 0 sections)
    //   LC_SEGMENT_64 __TEXT     (72+80=152 bytes, 1 section)
    //   LC_MAIN                  (24 bytes)
    //   Zeros to page boundary P
    //   Code section (size bytes)
    //
    // Page size: ARM64 macOS uses 0x4000 (16KB).

    var pageSize: int64 := 0x4000;
    var numCmds: int64 := 3;
    var segPZSize: int64 := 72;
    var segTextSize: int64 := 152;
    var lcMainSize: int64 := 24;
    var totalCmdSz: int64 := segPZSize + segTextSize + lcMainSize;  // 248
    var H: int64 := 32 + totalCmdSz;   // 280
    var P: int64 := pageSize;  // H=280 < 16KB so P = one page = 0x4000
    var textBase: int64 := 0x100000000;
    var textVMSz: int64 := P + size;

    var outCap: int64 := P + size;
    var outBuf: int64 := mmap(0, outCap, 3, 34, -1, 0);

    // Zero buffer
    var z: int64 := 0;
    while z < outCap {
      poke8(outBuf + z, 0);
      z := z + 1;
    }

    var off: int64 := 0;

    // --- Mach-O header (32 bytes) ---
    poke32(outBuf + off, 0xFEEDFACF); off := off + 4;  // magic MH_MAGIC_64
    if self.target == TARGET_MACOS_ARM64 {
      poke32(outBuf + off, 0x0100000C); off := off + 4;  // CPU_TYPE_ARM64
      poke32(outBuf + off, 0); off := off + 4;           // CPU_SUBTYPE_ARM64_ALL
    } else {
      poke32(outBuf + off, 0x01000007); off := off + 4;  // CPU_TYPE_X86_64
      poke32(outBuf + off, 3); off := off + 4;           // CPU_SUBTYPE_X86_64_ALL
    }
    poke32(outBuf + off, 2); off := off + 4;           // MH_EXECUTE
    poke32(outBuf + off, numCmds); off := off + 4;
    poke32(outBuf + off, totalCmdSz); off := off + 4;
    poke32(outBuf + off, 0x00200001); off := off + 4;  // MH_NOUNDEFS|MH_PIE
    poke32(outBuf + off, 0); off := off + 4;           // reserved

    // --- LC_SEGMENT_64 __PAGEZERO (72 bytes) ---
    poke32(outBuf + off, 0x19); off := off + 4;   // LC_SEGMENT_64
    poke32(outBuf + off, 72); off := off + 4;     // cmdsize
    // segname "__PAGEZERO" (16 bytes)
    poke8(outBuf + off,  95); off := off + 1;  // '_'
    poke8(outBuf + off,  95); off := off + 1;  // '_'
    poke8(outBuf + off,  80); off := off + 1;  // 'P'
    poke8(outBuf + off,  65); off := off + 1;  // 'A'
    poke8(outBuf + off,  71); off := off + 1;  // 'G'
    poke8(outBuf + off,  69); off := off + 1;  // 'E'
    poke8(outBuf + off,  90); off := off + 1;  // 'Z'
    poke8(outBuf + off,  69); off := off + 1;  // 'E'
    poke8(outBuf + off,  82); off := off + 1;  // 'R'
    poke8(outBuf + off,  79); off := off + 1;  // 'O'
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke64(outBuf + off, 0); off := off + 8;          // vmaddr = 0
    poke64(outBuf + off, textBase); off := off + 8;   // vmsize = 0x100000000
    poke64(outBuf + off, 0); off := off + 8;          // fileoff = 0
    poke64(outBuf + off, 0); off := off + 8;          // filesize = 0
    poke32(outBuf + off, 0); off := off + 4;          // maxprot = NONE
    poke32(outBuf + off, 0); off := off + 4;          // initprot = NONE
    poke32(outBuf + off, 0); off := off + 4;          // nsects = 0
    poke32(outBuf + off, 0); off := off + 4;          // flags = 0

    // --- LC_SEGMENT_64 __TEXT (152 bytes) ---
    poke32(outBuf + off, 0x19); off := off + 4;   // LC_SEGMENT_64
    poke32(outBuf + off, 152); off := off + 4;    // cmdsize
    // segname "__TEXT" (16 bytes)
    poke8(outBuf + off,  95); off := off + 1;  // '_'
    poke8(outBuf + off,  95); off := off + 1;  // '_'
    poke8(outBuf + off,  84); off := off + 1;  // 'T'
    poke8(outBuf + off,  69); off := off + 1;  // 'E'
    poke8(outBuf + off,  88); off := off + 1;  // 'X'
    poke8(outBuf + off,  84); off := off + 1;  // 'T'
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke64(outBuf + off, textBase); off := off + 8;   // vmaddr
    poke64(outBuf + off, textVMSz); off := off + 8;   // vmsize
    poke64(outBuf + off, 0); off := off + 8;          // fileoff = 0 (whole file)
    poke64(outBuf + off, textVMSz); off := off + 8;   // filesize
    poke32(outBuf + off, 5); off := off + 4;          // maxprot = R|X
    poke32(outBuf + off, 5); off := off + 4;          // initprot = R|X
    poke32(outBuf + off, 1); off := off + 4;          // nsects = 1
    poke32(outBuf + off, 0); off := off + 4;          // flags = 0

    // Section __text in __TEXT (80 bytes)
    // sectname "__text" (16 bytes)
    poke8(outBuf + off,  95); off := off + 1;  // '_'
    poke8(outBuf + off,  95); off := off + 1;  // '_'
    poke8(outBuf + off, 116); off := off + 1;  // 't'
    poke8(outBuf + off, 101); off := off + 1;  // 'e'
    poke8(outBuf + off, 120); off := off + 1;  // 'x'
    poke8(outBuf + off, 116); off := off + 1;  // 't'
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    // segname "__TEXT" (16 bytes)
    poke8(outBuf + off,  95); off := off + 1;  // '_'
    poke8(outBuf + off,  95); off := off + 1;  // '_'
    poke8(outBuf + off,  84); off := off + 1;  // 'T'
    poke8(outBuf + off,  69); off := off + 1;  // 'E'
    poke8(outBuf + off,  88); off := off + 1;  // 'X'
    poke8(outBuf + off,  84); off := off + 1;  // 'T'
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke8(outBuf + off, 0); off := off + 1;
    poke64(outBuf + off, textBase + P); off := off + 8;  // addr
    poke64(outBuf + off, size); off := off + 8;          // size
    poke32(outBuf + off, P); off := off + 4;             // offset in file
    poke32(outBuf + off, 4); off := off + 4;             // align = 2^4
    poke32(outBuf + off, 0); off := off + 4;             // reloff
    poke32(outBuf + off, 0); off := off + 4;             // nreloc
    poke32(outBuf + off, 0x80000400); off := off + 4;    // flags = PURE|SOME_INSTR
    poke32(outBuf + off, 0); off := off + 4;             // reserved1
    poke32(outBuf + off, 0); off := off + 4;             // reserved2
    poke32(outBuf + off, 0); off := off + 4;             // reserved3

    // --- LC_MAIN (24 bytes) ---
    poke32(outBuf + off, 0x80000028); off := off + 4;  // LC_MAIN
    poke32(outBuf + off, 24); off := off + 4;          // cmdsize
    poke64(outBuf + off, P); off := off + 8;           // entryoff (from __TEXT start)
    poke64(outBuf + off, 0); off := off + 8;           // stacksize = 0

    // Copy code at offset P (buffer already zeroed)
    var ci: int64 := 0;
    while ci < size {
      poke8(outBuf + P + ci, peek8(code + ci));
      ci := ci + 1;
    }

    // Write to file
    var fd: int64 := open(path, 577, 493);
    if fd < 0 {
      munmap(outBuf, outCap);
      return false;
    }
    write(fd, outBuf as pchar, outCap);
    close(fd);
    munmap(outBuf, outCap);
    return true;
  }
  
