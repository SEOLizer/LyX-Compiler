  // ---------------------------------------------------------------------------
  // Error Handling
  // ---------------------------------------------------------------------------
  
  pub fn ReportError(msg: pchar, line: int64, column: int64): void {
    EPrintStr("Error");
    if line > 0 {
      EPrintStr(": "c);
      EPrintInt(line);
      if column > 0 {
        EPrintStr(":"c);
        EPrintInt(column);
      }
    }
    EPrintStr(": "c);
    EPrintStrLn(msg);
    
    self.errorCount := self.errorCount + 1;
  }
  
  pub fn ReportWarning(msg: pchar, line: int64, column: int64): void {
    EPrintStr("Warning");
    if line > 0 {
      EPrintStr(": "c);
      EPrintInt(line);
      if column > 0 {
        EPrintStr(":"c);
        EPrintInt(column);
      }
    }
    EPrintStr(": "c);
    EPrintStrLn(msg);
    
    self.warningCount := self.warningCount + 1;
  }
  
  // ---------------------------------------------------------------------------
  // Statistics
  // ---------------------------------------------------------------------------
  
  pub fn PrintStats(): void {
    if self.enableVerbose {
      PrintStrLn("=== COMPILATION STATS ===");
      PrintStr("Errors: "c);
      PrintIntLn(self.errorCount);
      PrintStr("Warnings: "c);
      PrintIntLn(self.warningCount);
      PrintStr("Time: "c);
      PrintIntLn(self.buildTime);
    }
  }
  
  // ---------------------------------------------------------------------------
  // Memory Management
  // ---------------------------------------------------------------------------
  
  pub fn Free(): void {
    if self.unitCache != 0 {
      map_free(self.unitCache);
    }
    dispose self;
  }
