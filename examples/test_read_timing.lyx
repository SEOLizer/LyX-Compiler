// Debug sys_read
import std.net.socket;

fn main(): int64 {
    PrintLn("=== Test sys_read timing ===");
    
    var conn: TCPConn := TCPConnect(0x7F000001, 6379);
    if (conn.fd < 0) { PrintLn("Connect failed"); return 1; }
    PrintLn("Connected");
    
    // SET
    var req: pchar := "*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n";
    var sent: int64 := sys_write(conn.fd, req, 36);
    Print("SET sent: ");
    PrintLn(sent);
    PrintLn("About to read SET response...");
    
    var buf: pchar := "                    ";
    var n: int64 := sys_read(conn.fd, buf, 32);
    Print("SET response n = ");
    PrintLn(n);
    
    // GET
    PrintLn("About to send GET...");
    req := "*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n";
    sent := sys_write(conn.fd, req, 26);
    Print("GET sent: ");
    PrintLn(sent);
    PrintLn("About to read GET response...");
    
    n := sys_read(conn.fd, buf, 32);
    Print("GET response n = ");
    PrintLn(n);
    Print(", buf = [");
    Print(buf);
    PrintLn("]");
    
    sys_close(conn.fd);
    PrintLn("Done");
    
    return 0;
}