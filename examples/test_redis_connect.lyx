// Test just the connection part of std.db.redis
import std.db.redis;

fn main(): int64 {
    PrintLn("=== Redis Connect Test ===");
    
    // Connect to Redis - simplified call
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    
    Print("After RedisConnect, fd = ");
    PrintLn(conn.fd);
    
    if (conn.fd < 0) {
        PrintLn("Failed to connect");
        return 1;
    }
    
    PrintLn("Connected successfully!");
    
    // Just ping
    var ping_ok: bool := RedisPing(conn);
    Print("Ping: ");
    PrintLn(ping_ok as int64);
    
    RedisClose(conn);
    PrintLn("Done.");
    
    return 0;
}