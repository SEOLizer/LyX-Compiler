// Test with 16 byte mmap (like working test)
import std.alloc;
fn main(): int64 {
    PrintLn("start");
    var buf: int64 := alloc(16);  // 16 bytes like working test
    Print("mmap = ");
    PrintLn(buf);
    
    poke8(buf, 65);
    PrintLn("poke8 done");
    
    var v: int64 := peek8(buf);
    Print("peek8 done, value = ");
    PrintLn(v);
    
    free(buf, 16);
    PrintLn("done");
    return 0;
}