// Test with 16 byte mmap (like working test)
fn main(): int64 {
    PrintLn("start");
    var buf: int64 := mmap(0, 16, 3, 34, -1, 0);  // 16 bytes like working test
    Print("mmap = ");
    PrintLn(buf);
    
    poke8(buf, 65);
    PrintLn("poke8 done");
    
    var v: int64 := peek8(buf);
    Print("peek8 done, value = ");
    PrintLn(v);
    
    munmap(buf, 16);
    PrintLn("done");
    return 0;
}