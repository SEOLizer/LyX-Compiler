// Test if large int64 constants work
import std.alloc;
fn main(): int64 {
    var x: int64 := 12345678901234;
    Print("x = ");
    PrintLn(x);
    
    // Test if mmap result is being stored correctly
    var addr: int64 := alloc(4096);
    Print("mmap addr = ");
    PrintLn(addr);
    
    // Compare addresses
    if (addr > 1000000000) {
        PrintLn("addr is large (good)");
    } else {
        PrintLn("addr is small (bad)");
    }
    
    return 0;
}