// Test exact failing: LPUSH -> LPUSH -> LPOP -> LPOP
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    RedisDel(conn, "mylist");
    
    // 2 LPUSH
    var r: RedisReply := RedisLPush(conn, "mylist", "a");
    PrintLn("LPUSH1 done");
    
    r := RedisLPush(conn, "mylist", "b");
    PrintLn("LPUSH2 done");
    
    // 2 LPOP - this was failing!
    r := RedisLPop(conn, "mylist");
    PrintLn("LPOP1 done");
    
    r := RedisLPop(conn, "mylist");
    PrintLn("LPOP2 done");
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}