// Test if second write succeeds
import std.net.socket;

fn main(): int64 {
    PrintLn("=== Test write verification ===");
    
    var conn: TCPConn := TCPConnect(0x7F000001, 6379);
    if (conn.fd < 0) { PrintLn("Connect failed"); return 1; }
    Print("Connected, fd = ");
    PrintLn(conn.fd);
    
    // First command
    var req: pchar := "*1\r\n$4\r\nPING\r\n";
    PrintLn("Before first write");
    var n: int64 := sys_write(conn.fd, req, 18);
    Print("First write n = ");
    PrintLn(n);
    
    // Read response
    var buf: pchar := "                    ";
    n := sys_read(conn.fd, buf, 32);
    Print("First read n = ");
    PrintLn(n);
    Print(", buf = [");
    Print(buf);
    PrintLn("]");
    
    // Check socket state
    PrintLn("Checking socket state...");
    
    // Second command
    PrintLn("About to do second write");
    req := "*1\r\n$4\r\nPING\r\n";
    n := sys_write(conn.fd, req, 18);
    Print("Second write n = ");
    PrintLn(n);
    
    // If second write succeeds, try reading
    if (n > 0) {
        PrintLn("Second write succeeded, reading...");
        n := sys_read(conn.fd, buf, 32);
        Print("Second read n = ");
        PrintLn(n);
    } else {
        PrintLn("Second write failed!");
    }
    
    sys_close(conn.fd);
    PrintLn("Done");
    
    return 0;
}