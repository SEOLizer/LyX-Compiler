// Minimal test - just X11
import std.x11;

pub fn main(): int64 {
  var display: XDisplay := XOpen(0 as pchar);
  
  if (display.valid == 0) {
    PrintLn("Cannot open X display");
    return 1;
  }
  
  PrintLn("X11 display opened!");
  Print("Screen: ");
  // Print screen number
  
  XClose(display);
  PrintLn("Test completed!");
  return 0;
}