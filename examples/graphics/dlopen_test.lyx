// ÜBERSETZT ABSICHTLICH NICHT.
//
// `dlopen` steht auf der harten FFI-Blacklist: dynamisches Nachladen beliebiger
// Bibliotheken hebelt die Sandbox aus, weil danach jedes Symbol erreichbar ist,
// das der Compiler nie gesehen hat. Der Aufruf wird deshalb abgelehnt:
//
//   sema error: extern fn in FFI-Blacklist (Klasse 3) — direkter Aufruf verboten
//
// Diese Datei bleibt als Beleg für das Verhalten erhalten. Wer eine Bibliothek
// binden will, deklariert sie mit `extern fn … link "lib.so"` — dann kennt der
// Compiler das Symbol und kann es klassifizieren.
//
// Test dlopen only - no casts
extern fn dlopen(filename: pchar, flags: int64): int64 link "libdl.so.2";
extern fn dlclose(handle: int64): int64 link "libdl.so.2";

fn main(): int64 {
  var handle: int64 := dlopen("libGL.so.1", 1);
  if (handle == 0) { return 1; }
  dlclose(handle);
  PrintLn("dlopen OK");
  return 0;
}