// qt5_egl_test.lyx — Test für EGL Library
import std.qt5_egl;

pub fn main(): int64 {
  // EGL Display holen (direkt mit Default Display)
  var disp: EGLDisplay;
  var major: int64;
  var minor: int64;
  disp.display := eglGetDisplay(EGL_DEFAULT_DISPLAY);
  disp.initialized := 0;
  
  if disp.display == 0 {
    PrintLn("EGL: Kein Display verfuegbar");
    return 1;
  }
  
  // Initialize
  if eglInitialize(disp.display, 0, 0) == EGL_FALSE {
    PrintLn("EGL: Konnte nicht initialisieren");
    return 1;
  }
  disp.initialized := 1;
  
  if disp.initialized == 0 {
    PrintLn("EGL: Konnte nicht initialisieren");
    return 1;
  }
  
  PrintLn("EGL Display erhalten!");
  Print("EGL Version: ");
  
  // EGL Version abfragen
  var version_str: int64 := eglQueryString(disp.display, 12352);  // EGL_VERSION
  // Note: returning string pointer - we'd need pchar handling
  
  PrintLn("");
  
  // API binden
  if EGLBindOpenGL(disp) == EGL_TRUE {
    PrintLn("OpenGL API gebunden");
  } else {
    PrintLn("Konnte OpenGL nicht binden, versuche OpenGL ES");
    if EGLBindOpenGLES(disp) == EGL_TRUE {
      PrintLn("OpenGL ES API gebunden");
    }
  }
  
  // Cleanup
  EGLTerminate(disp);
  
  PrintLn("EGL Test abgeschlossen.");
  return 0;
}