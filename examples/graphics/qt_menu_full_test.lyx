// Qt Menu Full Test — Tests WP8 with real Menu implementation
import std.qt5_app;

pub fn main(): int64 {
  PrintLn("=== Qt Menu FULL Test (WP8) ===");
  
  // Initialize Qt
  var ok: int64 := qt_init();
  if (ok == 0) { PrintLn("Qt init failed"); return 1; }

  // Create main window
  var win: int64 := qt_create_window("Menu Test", 500, 300);
  
  // Test menu API (WP8) - jetzt mit echten calls!
  PrintLn("\n--- Testing REAL WP8 Menu API ---");
  
  // Create menu bar
  var menubar: int64 := qt_menubar_create(win);
  Print("MenuBar handle: "); PrintLn(menubar); PrintLn("");
  
  // Create menu
  var file_menu: int64 := qt_menu_create("File");
  Print("File Menu handle: "); PrintLn(file_menu); PrintLn("");
  
  // Create action 
  var exit_action: int64 := qt_action_create("Exit", 0);
  Print("Exit Action handle: "); PrintLn(exit_action); PrintLn("");
  
  // Add menu to menubar
  if (menubar != 0 && file_menu != 0) {
    qt_menu_add_menu(menubar, file_menu);
    PrintLn("Added File menu to menubar");
  }
  
  // Add action to menu
  if (file_menu != 0 && exit_action != 0) {
    qt_menu_add_action(file_menu, exit_action);
    PrintLn("Added Exit action to menu");
  }
  
  // Create toolbar
  var toolbar: int64 := qt_toolbar_create(win, "Main Toolbar");
  Print("Toolbar handle: "); PrintLn(toolbar); PrintLn("");
  
  // Test dialogs (WP9)
  PrintLn("\n--- Testing Dialogs ---");
  
  // Test message box (blocks, show for 1 sec)
  // qt_msgbox_show(0, "Test Message Box", 1); // type 1 = Warning
  PrintLn("MessageBox: (commented out to avoid blocking)");
  
  // Show window
  qt_show(win);
  PrintLn("\nWindow shown with menu - close it to exit");
  
  // Run event loop
  var code: int64 := qt_exec();
  
  Print("Qt exited with code: ");
  PrintLn(code);
  PrintLn("\n=== TEST COMPLETE ===");
  
  return code;
}