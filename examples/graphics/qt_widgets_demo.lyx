// Qt Widgets Demo — Showcases all input and selection widgets
//
// Requires: libqtlyx.so in LD_LIBRARY_PATH (or installed system-wide)
//   Build:  cd qt_wrapper && make
//   Run:    LD_LIBRARY_PATH=qt_wrapper ./qt_widgets_demo

import std.qt5_app;

// Helper to get input (simple blocking read via stdin)
fn get_input(): int64 {
  return 0; // Placeholder - in real app, use signals/slots
}

pub fn main(): int64 {
  PrintLn("=== Qt Widgets Demo ===");
  
  // Initialize Qt
  var ok: int64 := qt_init();
  if (ok == 0) {
    PrintLn("Qt init failed");
    return 1;
  }

  Print("Qt version: ");
  Print(qt_version());
  PrintLn("");

  // Create main window
  var win: int64 := qt_create_window("Qt Widgets Demo", 600, 500);
  if (win == 0) {
    PrintLn("Window creation failed");
    return 1;
  }

  // Create a container with vertical layout
  var container: int64 := qt_container_create_vbox(0);
  qt_widget_add_to(container, win);

  // --- LineEdit Demo ---
  PrintLn("Creating QLineEdit...");
  var edit: int64 := qt_lineedit_create(0, "Enter text here");
  qt_lineedit_set_placeholder(edit, "Type something...");
  qt_lineedit_set_max_length(edit, 100);
  qt_container_vbox_add_widget(container, edit);
  
  // --- SpinBox Demo ---
  PrintLn("Creating QSpinBox...");
  var spin: int64 := qt_spinbox_create(0);
  qt_spinbox_set_range(spin, 0, 100);
  qt_spinbox_set_value(spin, 42);
  qt_spinbox_set_suffix(spin, " items");
  qt_container_vbox_add_widget(container, spin);

  // --- DoubleSpinBox Demo ---
  PrintLn("Creating QDoubleSpinBox...");
  var dspin: int64 := qt_doublespinbox_create(0);
  qt_doublespinbox_set_range(dspin, 0, 1000);
  var pi_val: int64 := 314159; // 3.14159 * 100000 as int representation
  qt_doublespinbox_set_value(dspin, pi_val);
  qt_doublespinbox_set_decimals(dspin, 2);
  qt_container_vbox_add_widget(container, dspin);

  // --- Slider Demo ---
  PrintLn("Creating QSlider...");
  var slider: int64 := qt_slider_create(0, 0); // 0 = horizontal
  qt_slider_set_range(slider, 0, 100);
  qt_slider_set_value(slider, 50);
  qt_container_vbox_add_widget(container, slider);

  // --- CheckBox Demo ---
  PrintLn("Creating QCheckBox...");
  var checkbox: int64 := qt_checkbox_create(0, "Enable feature");
  qt_checkbox_set_checked(checkbox, 1);
  qt_container_vbox_add_widget(container, checkbox);

  // --- RadioButton Demo ---
  PrintLn("Creating QRadioButton...");
  var radio1: int64 := qt_radiobutton_create(0, "Option A");
  var radio2: int64 := qt_radiobutton_create(0, "Option B");
  qt_radiobutton_set_checked(radio1, 1);
  qt_container_vbox_add_widget(container, radio1);
  qt_container_vbox_add_widget(container, radio2);

  // --- ComboBox Demo ---
  PrintLn("Creating QComboBox...");
  var combo: int64 := qt_combobox_create(0);
  qt_combobox_add_item(combo, "Select an option");
  qt_combobox_add_item(combo, "Apple");
  qt_combobox_add_item(combo, "Banana");
  qt_combobox_add_item(combo, "Cherry");
  qt_container_vbox_add_widget(container, combo);

  // --- ProgressBar Demo ---
  PrintLn("Creating QProgressBar...");
  var progress: int64 := qt_progressbar_create(0);
  qt_progressbar_set_range(progress, 0, 100);
  qt_progressbar_set_value(progress, 75);
  qt_progressbar_set_text_visible(progress, 1);
  qt_container_vbox_add_widget(container, progress);

  // --- ListWidget Demo ---
  PrintLn("Creating QListWidget...");
  var list: int64 := qt_listwidget_create(0);
  qt_listwidget_add_item(list, "Item 1");
  qt_listwidget_add_item(list, "Item 2");
  qt_listwidget_add_item(list, "Item 3");
  qt_listwidget_add_item(list, "Item 4");
  qt_container_vbox_add_widget(container, list);

  // Show the window (with label as placeholder for now)
  // qt_set_label(win, "Qt Widgets Demo Loaded!\nCheck terminal for widget handles.");
  qt_show(win);

  PrintLn("\n--- Widget Handles ---");
  Print("QLineEdit:     "); PrintLn(edit); PrintLn("");
  Print("QSpinBox:      "); PrintLn(spin); PrintLn("");
  Print("QDoubleSpinBox: "); PrintLn(dspin); PrintLn("");
  Print("QSlider:       "); PrintLn(slider); PrintLn("");
  Print("QCheckBox:     "); PrintLn(checkbox); PrintLn("");
  Print("QRadioButton1: "); PrintLn(radio1); PrintLn("");
  Print("QRadioButton2: "); PrintLn(radio2); PrintLn("");
  Print("QComboBox:     "); PrintLn(combo); PrintLn("");
  Print("QProgressBar:  "); PrintLn(progress); PrintLn("");
  Print("QListWidget:   "); PrintLn(list); PrintLn("");

  // Demo: Query some values
  PrintLn("\n--- Initial Values ---");
  Print("SpinBox value:   "); PrintLn(qt_spinbox_get_value(spin)); PrintLn("");
  Print("Slider value:    "); PrintLn(qt_slider_get_value(slider)); PrintLn("");
  Print("CheckBox checked: "); PrintLn(qt_checkbox_is_checked(checkbox)); PrintLn("");
  Print("ComboBox count:  "); PrintLn(qt_combobox_count(combo)); PrintLn("");
  Print("Progress value:  "); PrintLn(qt_progressbar_get_value(progress)); PrintLn("");
  Print("List count:      "); PrintLn(qt_listwidget_count(list)); PrintLn("");

  // Update some values to demonstrate API
  PrintLn("\n--- Updating Values ---");
  qt_spinbox_set_value(spin, 99);
  PrintLn("Set SpinBox to 99");
  
  qt_progressbar_set_value(progress, 50);
  PrintLn("Set ProgressBar to 50");
  
  qt_combobox_set_current_index(combo, 2);
  PrintLn("Set ComboBox to index 2 (Cherry)");

  // Toggle checkbox
  if (qt_checkbox_is_checked(checkbox) == 1) {
    qt_checkbox_set_checked(checkbox, 0);
    PrintLn("Unchecked checkbox");
  } else {
    qt_checkbox_set_checked(checkbox, 1);
    PrintLn("Checked checkbox");
  }

  // Demonstrate widget control
  PrintLn("\n--- Widget Control ---");
  qt_widget_set_enabled(spin, 0);
  PrintLn("Disabled SpinBox");
  
  // Set custom style
  qt_widget_set_style(progress, "QProgressBar { border: 2px solid grey; }");
  PrintLn("Applied custom style to ProgressBar");

  PrintLn("\nWindow shown — close it to exit");
  
  // Run event loop
  var code: int64 := qt_exec();

  Print("Qt exited with code: ");
  PrintLn(code);
  
  return code;
}