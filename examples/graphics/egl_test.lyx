// Test EGL directly
// X11/GLX/EGL sprechen über einen Unix-Socket mit dem X-Server, deshalb
// `network.unix`. Die Annotation dokumentiert, was das Beispiel braucht —
// die FFI-Sandbox verlangt bei einem unbekannten Symbol lediglich, DASS eine
// Capability deklariert ist, nicht dass sie zum Symbol passt.
@cap(network.unix)
extern fn eglGetDisplay(displayId: int64): int64 link "libEGL.so.1";
@cap(network.unix)
extern fn eglInitialize(dpy: int64, major: int64, minor: int64): int64 link "libEGL.so.1";
@cap(network.unix)
extern fn eglTerminate(dpy: int64): int64 link "libEGL.so.1";

fn main(): int64 {
  var disp: int64 := eglGetDisplay(0);
  if (disp == 0) { return 1; }
  
  // Just initialize with 0 for version
  var result: int64 := eglInitialize(disp, 0, 0);
  if (result == 0) { return 2; }
  
  eglTerminate(disp);
  PrintLn("EGL OK");
  return 0;
}