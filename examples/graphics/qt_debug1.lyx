// Qt Debug Demo — Very simple, single widget test
//
// Requires: libqtlyx.so in LD_LIBRARY_PATH

import std.qt5_app;

pub fn main(): int64 {
  PrintLn("=== Qt Debug Demo ===");
  
  var ok: int64 := qt_init();
  if (ok == 0) {
    PrintLn("Qt init failed");
    return 1;
  }
  
  // Create window
  var win: int64 := qt_create_window("Debug", 400, 400);
  Print("Window: "); PrintLn(win); PrintLn("");
  
  // Create LABEL with parent=0 (no parent!)
  var label: int64 := 0;
  
  // Create label using qt_set_label - this sets it as central widget
  label := qt_set_label(win, "TEST LABEL");
  Print("Label (via set_label): "); PrintLn(label); PrintLn("");
  
  // Show
  qt_show(win);
  PrintLn("After show");
  
  // Set status
  qt_set_status(win, "LABEL SHOULD BE VISIBLE");
  PrintLn("Status set");
  
  PrintLn("Running event loop (close window manually)...");
  
  return qt_exec();
}