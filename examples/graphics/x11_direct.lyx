// Test X11 with extern functions outside unit
// X11/GLX/EGL sprechen über einen Unix-Socket mit dem X-Server, deshalb
// `network.unix`. Die Annotation dokumentiert, was das Beispiel braucht —
// die FFI-Sandbox verlangt bei einem unbekannten Symbol lediglich, DASS eine
// Capability deklariert ist, nicht dass sie zum Symbol passt.
@cap(network.unix)
extern fn XOpenDisplay(name: int64): int64 link "libX11.so.6";
@cap(network.unix)
extern fn XCloseDisplay(dpy: int64) link "libX11.so.6";
@cap(network.unix)
extern fn XDefaultScreen(dpy: int64): int64 link "libX11.so.6";

pub fn main(): int64 {
  var dpy: int64 := XOpenDisplay(0);
  
  if (dpy == 0) {
    PrintLn("Cannot open display");
    return 1;
  }
  
  PrintLn("Display opened!");
  Print("Screen: ");
  PrintLn(XDefaultScreen(dpy));
  PrintLn("");
  
  XCloseDisplay(dpy);
  PrintLn("Done");
  return 0;
}