// Qt Integration Test — Tests WP5 (Layout), WP6 (Signals), WP7 (Timer)
import std.qt5_app;

pub fn main(): int64 {
  PrintLn("=== Qt Integration Test (WP5+WP6+WP7) ===");
  
  // Initialize Qt
  var ok: int64 := qt_init();
  if (ok == 0) { PrintLn("Qt init failed"); return 1; }

  // Create main window (WP3)
  var win: int64 := qt_create_window("Integration Test", 500, 400);
  
  // Create container with VBox layout (WP5)
  var container: int64 := qt_container_create_vbox(0);
  qt_widget_add_to(container, win);
  
  // --- Test QVBoxLayout (WP5) ---
  PrintLn("Testing Layouts...");
  var edit: int64 := qt_lineedit_create(0, "Type here...");
  qt_container_vbox_add_widget(container, edit);
  
  var checkbox: int64 := qt_checkbox_create(0, "Enable timer");
  qt_container_vbox_add_widget(container, checkbox);
  
  // --- Test QTimer (WP7) ---
  PrintLn("Testing Timer...");
  var timer: int64 := qt_timer_create(500); // 500ms interval
  Print("Timer created: "); PrintLn(timer); PrintLn("");
  
  // Start timer
  qt_timer_start(timer);
  PrintLn("Timer started");
  
  // Check if active
  var active: int64 := qt_timer_is_active(timer);
  Print("Timer active: "); PrintLn(active); PrintLn("");
  
  // Stop timer
  qt_timer_stop(timer);
  PrintLn("Timer stopped");
  
  // Start again
  qt_timer_start(timer);
  
  // Change interval
  qt_timer_set_interval(timer, 1000);
  PrintLn("Timer interval changed to 1000ms");
  
  // Cleanup
  qt_timer_stop(timer);
  qt_timer_delete(timer);
  PrintLn("Timer deleted");
  
  // --- Test Widget values ---
  PrintLn("\n--- Widget Values ---");
  Print("SpinBox init: "); PrintLn(42); PrintLn("");
  
  // Update values
  qt_checkbox_set_checked(checkbox, 0);
  PrintLn("Checkbox unchecked");
  
  // Show window
  qt_show(win);
  PrintLn("\nWindow shown — close it to exit");
  
  // Run event loop
  var code: int64 := qt_exec();
  
  Print("Qt exited with code: ");
  PrintLn(code);
  PrintLn("\n=== TEST COMPLETE ===");
  
  return code;
}