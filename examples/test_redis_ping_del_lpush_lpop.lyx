// Test PING then DEL then LPUSH then LPOP
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    // PING
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    }
    
    // DEL (returns int64)
    var delres: int64 := RedisDel(conn, "mylist");
    Print("DEL result = ");
    PrintLn(delres);
    
    // LPUSH (returns struct)
    var r: RedisReply := RedisLPush(conn, "mylist", "a");
    PrintLn("LPUSH done");
    
    r := RedisLPush(conn, "mylist", "b");
    PrintLn("LPUSH2 done");
    
    // LPOP (returns struct - THE CRASH!)
    r := RedisLPop(conn, "mylist");
    Print("LPOP done, kind=");
    PrintLn(r.kind);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}