// Test poke8 ONLY, no peek8 after
import std.alloc;
fn main(): int64 {
    PrintLn("=== Test poke8 only ===");
    
    var buf: int64 := alloc(4096);
    Print("mmap = ");
    PrintLn(buf);
    
    // Just poke8, NO peek8 after
    poke8(buf, 65);
    PrintLn("Wrote 65");
    
    // Print something else to see if we get here
    PrintLn("After poke8");
    
    free(buf, 4096);
    PrintLn("Done");
    return 0;
}