// Test poke8 ONLY, no peek8 after
fn main(): int64 {
    PrintLn("=== Test poke8 only ===");
    
    var buf: int64 := mmap(0, 4096, 3, 34, -1, 0);
    Print("mmap = ");
    PrintLn(buf);
    
    // Just poke8, NO peek8 after
    poke8(buf, 65);
    PrintLn("Wrote 65");
    
    // Print something else to see if we get here
    PrintLn("After poke8");
    
    munmap(buf, 4096);
    PrintLn("Done");
    return 0;
}