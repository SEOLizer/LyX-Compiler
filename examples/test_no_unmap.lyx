// Test - DON'T munmap between reads
import std.net.syscalls;
import std.net.socket;
import std.alloc;

fn main(): int64 {
    var conn: TCPConn := TCPConnect(0x7F000001, 6379);
    if (conn.fd < 0) { return 1; }
    
    var my_fd: int64 := conn.fd;
    
    // First mmap
    var buf1: int64 := alloc(64);
    Print("buf1 = ");
    PrintLn(buf1);
    
    var req: pchar := "*1\r\n$4\r\nPING\r\n";
    write(my_fd, req, 18);
    
    var n: int64 := read(my_fd, buf1, 64);
    Print("read1 = ");
    PrintLn(n);
    Print("buf1[0] = ");
    PrintLn(peek8(buf1));
    PrintLn("");
    
    // DON'T munmap - keep buf1
    
    // Second mmap for different address
    var buf2: int64 := alloc(64);
    Print("buf2 = ");
    PrintLn(buf2);
    
    // Second command
    req := "*1\r\n$4\r\nPING\r\n";
    write(my_fd, req, 18);
    PrintLn("wrote2");
    
    n := read(my_fd, buf2, 64);
    Print("read2 = ");
    PrintLn(n);
    Print("buf2[0] = ");
    PrintLn(peek8(buf2));
    PrintLn("");
    
    free(buf1, 64);
    free(buf2, 64);
    close(conn.fd);
    return 0;
}