// Exact same test but different key name
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    }
    
    // Use "testlist2" instead of "mylist"
    var r: RedisReply := RedisLPush(conn, "testlist2", "a");
    PrintLn("LPUSH1 done");
    
    r := RedisLPush(conn, "testlist2", "b");
    PrintLn("LPUSH2 done");
    
    r := RedisLPop(conn, "testlist2");
    PrintLn("LPOP1 done");
    
    r := RedisLPop(conn, "testlist2");
    PrintLn("LPOP2 done");
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}