// Test poke8 with constant directly
fn main(): int64 {
    PrintLn("=== Test poke8 with constant ===");
    
    var buf: int64 := mmap(0, 4096, 3, 34, -1, 0);
    Print("mmap = ");
    PrintLn(buf);
    
    // Write constant 65 directly
    poke8(buf, 65);
    PrintLn("Wrote 65");
    
    // Read back
    var result: int64 := peek8(buf);
    Print("peek8 = ");
    PrintLn(result);
    
    // Write another constant
    poke8(buf + 1, 66);
    var result2: int64 := peek8(buf + 1);
    Print("peek8+1 = ");
    PrintLn(result2);
    
    munmap(buf, 4096);
    PrintLn("Done");
    return 0;
}