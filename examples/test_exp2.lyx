// test_exp2.lyx - Test ExpF64 with direct values
import std.ml;

pub fn main(): int64 {
  // Direct test of exp(0)
  var e0: f64 := 1.0;
  Print("1.0: ");
  PrintLn(e0 as int64);
  
  // exp(1) 
  var e1: f64 := 1.0 + 1.0 + (1.0 * 0.5) + (1.0 * 0.16667) + (1.0 * 0.04167) + (1.0 * 0.00833);
  Print("direct calc: ");
  PrintLn(e1 as int64);  // ~2.7
  PrintLn("");
  
  PrintLn("Done");
  return 0;
}