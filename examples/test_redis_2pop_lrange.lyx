// Test LRANGE after 2 LPOPs
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    }
    
    RedisDel(conn, "mylist");
    var r: RedisReply := RedisLPush(conn, "mylist", "first");
    r := RedisLPush(conn, "mylist", "second");
    r := RedisLPush(conn, "mylist", "last");
    PrintLn("Setup done");
    
    // TWO LPOPs
    r := RedisLPop(conn, "mylist");
    PrintLn("LPOP1 done");
    
    r := RedisLPop(conn, "mylist");
    PrintLn("LPOP2 done");
    
    // Now LRANGE - might crash
    r := RedisLRange(conn, "mylist", 0, -1);
    Print("LRANGE done, kind=");
    PrintLn(r.kind);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}