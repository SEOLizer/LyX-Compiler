// Minimal test - just LPUSH
import std.db.redis;

fn main(): int64 {
    PrintLn("=== Minimal Test ===");
    
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) { return 1; }
    PrintLn("Connected");
    
    // Just test LPUSH
    PrintLn("Calling LPUSH...");
    var r: RedisReply := RedisLPush(conn, "testlist", "value1");
    Print("LPUSH done, kind=");
    PrintLn(r.kind);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}