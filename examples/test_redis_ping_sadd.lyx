// Test just LPUSH after PING (no DEL)
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    // Just LPUSH - no prior DEL
    var r: RedisReply := RedisLPush(conn, "mylist", "a");
    Print("LPUSH done, kind=");
    PrintLn(r.kind);
    
    // SADD after LPUSH
    r := RedisSAdd(conn, "myset", "apple");
    Print("SADD apple done, kind=");
    PrintLn(r.kind);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}