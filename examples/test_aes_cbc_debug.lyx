// Debug test for AES-CBC mode
import std.crypto.aes;

fn PH(label: pchar, data: pchar, len: int64) {
    Print(label);
    var i: int64 := 0;
    while (i < len) {
        if (i > 0) { Print(" "); }
        if (StrCharAt(data, i) < 16) { Print("0"); }
        PrintLn(StrCharAt(data, i));
        i := i + 1;
    }
    PrintLn("");
}

fn main(): int64 {
    PrintLn("=== AES-CBC Debug Test ===\n");
    
    // Use known test vector
    var key: pchar := "                        ";
    var iv: pchar := "                        ";
    var plaintext: pchar := "                                ";
    
    var i: int64 := 0;
    while (i < 16) {
        StrSetChar(key, i, i);
        StrSetChar(iv, i, 16 + i);
        i := i + 1;
    }
    
    var pt: pchar := "This is a test of the CBC mode!";
    i := 0;
    while (i < 28) {
        StrSetChar(plaintext, i, StrCharAt(pt, i));
        i := i + 1;
    }
    
    PH("Key: ", key, 16);
    PH("IV:  ", iv, 16);
    PH("Plaintext: ", plaintext, 28);
    
    var cipher: pchar := "                                        ";
    var cipher_len: int64 := AES128CBCEncrypt(key, iv, plaintext, 28, cipher);
    
    Print("\nCiphertext (");
    PrintLn(cipher_len);
    Print(" bytes): ");
    PH("", cipher, cipher_len);
    
    var decrypted: pchar := "                                        ";
    var decrypted_len: int64 := AES128CBCDecrypt(key, iv, cipher, cipher_len, decrypted);
    
    Print("\nDecrypted (");
    PrintLn(decrypted_len);
    Print(" bytes): ");
    PH("", decrypted, decrypted_len);
    
    var isMatch: bool := true;
    if (decrypted_len != 28) { isMatch := false; }
    i := 0;
    while (i < 28) {
        if (StrCharAt(decrypted, i) != StrCharAt(plaintext, i)) {
            isMatch := false;
            Print("Mismatch at ");
            PrintLn(i);
        }
        i := i + 1;
    }
    
    if (isMatch) { PrintLn("\n*** CBC TEST PASSED! ***"); }
    else { PrintLn("\n*** CBC TEST FAILED! ***"); }
    
    // Single block roundtrip
    PrintLn("\n=== Single Block Roundtrip ===");
    var single: pchar := "                ";
    var single_key: pchar := "                ";
    var expanded: pchar := "                                                                ";
    
    i := 0;
    while (i < 16) {
        StrSetChar(single_key, i, i);
        i := i + 1;
    }
    
    AES128KeyExpand(single_key, expanded);
    
    var encrypted: pchar := "                ";
    var decrypted_single: pchar := "                ";
    
    i := 0;
    while (i < 16) {
        StrSetChar(encrypted, i, StrCharAt(single, i));
        i := i + 1;
    }
    
    PH("Original: ", encrypted, 16);
    
    AESEncryptBlockWithKey(encrypted, expanded, 10);
    
    PH("Encrypted: ", encrypted, 16);
    
    i := 0;
    while (i < 16) {
        StrSetChar(decrypted_single, i, StrCharAt(encrypted, i));
        i := i + 1;
    }
    
    AESDecryptBlockWithKey(decrypted_single, expanded, 10);
    
    PH("Decrypted: ", decrypted_single, 16);
    
    isMatch := true;
    i := 0;
    while (i < 16) {
        if (StrCharAt(decrypted_single, i) != StrCharAt(single, i)) { isMatch := false; }
        i := i + 1;
    }
    
    if (isMatch) { PrintLn("*** SINGLE BLOCK ROUNDTRIP PASSED! ***"); }
    else { PrintLn("*** SINGLE BLOCK ROUNDTRIP FAILED! ***"); }
    
    return 0;
}