// GPIO LED Blink - LED ein- und ausschalten
// Demonstrates: GPIO-Zugriff ueber Linux sysfs (vereinfacht)
// Hardware: Raspberry Pi mit LED an GPIO-Pin (BCM-Nummerierung)
// 
// WICHTIG: Dieses Programm muss mit Root-Rechten ausgefuehrt werden
// oder der Benutzer muss zur gpio-Gruppe gehoeren.
//
// Verkabelung:
// - LED: GPIO18 (Pin 12) -> Widerstand -> GND

fn main(): int64 {
    PrintLn("GPIO LED Blink Demo");
    PrintLn("===================");
    PrintLn("");
    
    // Info zum GPIO-Zugriff
    PrintLn("Dieses Beispiel zeigt das Prinzip des GPIO-Zugriffs.");
    PrintLn("Die tatsaechliche Implementierung erfordert:");
    PrintLn("1. Export: echo 18 > /sys/class/gpio/export");
    PrintLn("2. Richtung: echo out > /sys/class/gpio/gpio18/direction");
    PrintLn("3. Schreiben: echo 1 > /sys/class/gpio/gpio18/value");
    PrintLn("4. Lesen: cat /sys/class/gpio/gpio18/value");
    PrintLn("");
    
    // Simuliere Blink-Algorithmus
    PrintLn("Blink-Sequenz (simuliert):");
    var count: int64 := 3;
    var i: int64 := 0;
    
    while (i < count) {
        PrintLn("  LED AN  (GPIO18 = HIGH)");
        
        // Warte ~500ms
        var j: int64 := 0;
        while (j < 50000000) { j := j + 1; }
        
        PrintLn("  LED AUS (GPIO18 = LOW)");
        
        // Warte ~500ms
        j := 0;
        while (j < 50000000) { j := j + 1; }
        
        i := i + 1;
    }
    
    PrintLn("\nDemo abgeschlossen.");
    
    return 0;
}