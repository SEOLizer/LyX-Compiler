// GPIO Input - Taster-Status auslesen
// Demonstrates: GPIO-Input ueber Linux sysfs
// Hardware: Raspberry Pi mit Taster an GPIO-Pin (BCM-Nummerierung)
//
// Verkabelung:
// - Taster: GPIO17 (Pin 11) -> Taster -> GND
// - Pullup-Widerstand (oder interner Pullup aktivieren)
//
// WICHTIG: Muss mit Root-Rechten ausgefuehrt werden

fn main(): int64 {
    PrintLn("GPIO Input Demo");
    PrintLn("===============");
    PrintLn("");
    
    // Info zum GPIO-Input
    PrintLn("Dieses Beispiel zeigt das Auslesen eines GPIO-Input-Pins.");
    PrintLn("Beispiel: Taster an GPIO17");
    PrintLn("");
    PrintLn("Erforderliche Schritte:");
    PrintLn("1. Export: echo 17 > /sys/class/gpio/export");
    PrintLn("2. Richtung: echo in > /sys/class/gpio/gpio17/direction");
    PrintLn("3. Pullup: echo high > /sys/class/gpio/gpio17/direction");
    PrintLn("4. Lesen: cat /sys/class/gpio/gpio17/value");
    PrintLn("");
    
    // Simuliere Poll-Loop
    PrintLn("Poll-Loop (simuliert):");
    var poll_count: int64 := 5;
    var i: int64 := 0;
    
    while (i < poll_count) {
        // Wi rde normalerweise den GPIO-Wert lesen
        // var value: int64 := read_gpio(17);
        
        // Simuliere wechselnde Werte
        var value: int64 := i % 2;
        
        Print("  GPIO17 = ");
        PrintLn(value);
        if (value == 1) {
            Print(" (Taster NICHT gedrueckt)");
        } else {
            Print(" (Taster gedrueckt!)");
        }
        PrintLn("");
        
        // Warte ~1 Sekunde
        var j: int64 := 0;
        while (j < 100000000) { j := j + 1; }
        
        i := i + 1;
    }
    
    PrintLn("\nDemo abgeschlossen.");
    
    return 0;
}