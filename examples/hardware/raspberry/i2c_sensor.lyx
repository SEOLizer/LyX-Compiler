// I2C Sensor Demo - Auslesen eines I2C-Sensors
// Demonstrates: I2C-Kommunikation ueber /dev/i2c
// Hardware: Raspberry Pi mit I2C-Sensor (z.B. BMP280, BME280, ADXL345)
//
// I2C-Verkabelung:
// - SCL: GPIO3 (Pin 5) - Serial Clock
// - SDA: GPIO2 (Pin 3) - Serial Data
// - VCC: 3.3V (Pin 1)
// - GND: GND (Pin 6, 9, 14, 20, 25, 30, 34 oder 39)
//
// Typische I2C-Adressen:
// - BMP280/BME280: 0x76 oder 0x77
// - ADXL345: 0x53
// - OLED Display: 0x3C oder 0x3D
// - MPU6050: 0x68
//
// WICHTIG: I2C muss in raspi-config aktiviert sein!

fn main(): int64 {
    PrintLn("I2C Sensor Demo");
    PrintLn("===============");
    PrintLn("");
    
    // I2C-Erklaerung
    PrintLn("I2C-Bus (Inter-Integrated Circuit):");
    PrintLn("- Zwei Leitungen: SCL (Clock) und SDA (Data)");
    PrintLn("- Master (Raspberry Pi) steuert den Bus");
    PrintLn("- Slave-Geraete haben eindeutige Adressen (7-bit)");
    PrintLn("- Mehrere Geraete am selben Bus moeglich");
    PrintLn("");
    
    // Typische Sensor-Beispiele
    PrintLn("Typische I2C-Sensoren:");
    PrintLn("- BMP280: Luftdruck (Adresse 0x76)");
    PrintLn("- BME280: Luftdruck + Feuchtigkeit (0x76)");
    PrintLn("- ADXL345: Beschleunigung (0x53)");
    PrintLn("- MPU6050: Gyro + Beschleunigung (0x68)");
    PrintLn("- OLED: SSD1306 Display (0x3C)");
    PrintLn("");
    
    // Simuliere Daten-Auslesen
    PrintLn("Simulierte Sensordaten:\n");
    
    var count: int64 := 3;
    var i: int64 := 0;
    
    while (i < count) {
        // Simuliere Sensordaten
        var temperature: int64 := 20 + (i * 2);  // 20, 22, 24 Grad
        var pressure: int64 := 1013 + (i * 3);  // hPa
        var humidity: int64 := 50 + (i * 5);     // %
        
        Print("Messung ");
        PrintLn(i + 1);
        PrintLn(":");
        
        Print("  Temperatur: ");
        PrintLn(temperature);
        PrintLn(" Grad Celsius");
        
        Print("  Luftdruck: ");
        PrintLn(pressure);
        PrintLn(" hPa");
        
        Print("  Luftfeuchtigkeit: ");
        PrintLn(humidity);
        PrintLn(" %");
        
        PrintLn("");
        
        // Warten
        var j: int64 := 0;
        while (j < 50000000) { j := j + 1; }
        
        i := i + 1;
    }
    
    // I2C-Zugriffs-Erklaerung
    PrintLn("I2C-Zugriff unter Linux:");
    PrintLn("1. /dev/i2c-1 oeffnen (oder /dev/i2c-0)");
    PrintLn("2. ioctl mit I2C_SLAVE Adresse setzen");
    PrintLn("3. Schreiben: Register-Adresse senden");
    PrintLn("4. Lesen: Daten vom Slave empfangen");
    PrintLn("");
    
    PrintLn("Beispiel (BMP280 Lesen):");
    PrintLn("  write(fd, [0xF7], 1)  // Register 0xF7 (Druck MSB)");
    PrintLn("  read(fd, buffer, 2)    // 2 Bytes lesen");
    PrintLn("");
    
    PrintLn("Demo abgeschlossen.");
    
    return 0;
}