// HC-SR04 Ultraschall-Entfernungsmesser
// Demonstrates: GPIO-Trigger und Echo-Messung mit Zeitmessung
// Hardware: Raspberry Pi mit HC-SR04 Sensor
//
// Verkabelung:
// - VCC: +5V (Pin 2 oder 4)
// - GND: GND (Pin 6, 9, 14, 20, 25, 30, 34 oder 39)
// - Trig: GPIO23 (Pin 16) - sending of ultrasonic pulse
// - Echo: GPIO24 (Pin 18) - receives the reflected pulse
//
// Funktionsweise:
// 1. Trigger-Puls: 10us auf Trig-Pin
// 2. Echo-Signal: Distance proportional to echo pulse width
// 3. Berechnung: Distance (cm) = echo_duration / 58
//
// WICHTIG: HC-SR04 benoetigt 5V, aber GPIO ist 3.3V!
// Ein Spannungsteiler ist erforderlich fuer den Echo-Pin!

fn main(): int64 {
    PrintLn("HC-SR04 Ultraschall-Distanzsensor Demo");
    PrintLn("=======================================");
    PrintLn("");
    
    // Erklaerung
    PrintLn("HC-SR04 Funktionsweise:");
    PrintLn("1. 10us Trigger-Impuls auf Trig-Pin senden");
    PrintLn("2. Warten auf Echo-Puls (Zeit messen)");
    PrintLn("3. Distanz berechnen: Entfernung = Zeit / 58 (in cm)");
    PrintLn("");
    PrintLn("Elektrische Verbindung:");
    PrintLn("- Trig: GPIO23 (3.3V-tolerant)");
    PrintLn("- Echo: GPIO24 (Spannungsteiler 5V->3.3V!");
    PrintLn("- VCC: 5V, GND: GND");
    PrintLn("");
    
    // Simuliere Messungen
    PrintLn("Simulierte Messungen:\n");
    
    var distances: [5]int64;
    distances[0] := 10;   // 10 cm
    distances[1] := 25;   // 25 cm
    distances[2] := 50;   // 50 cm
    distances[3] := 100;  // 100 cm
    distances[4] := 200;  // 200 cm
    
    var i: int64 := 0;
    while (i < 5) {
        var dist: int64 := distances[i];
        
        // Berechne Echo-Dauer (vereinfacht)
        // echo_duration_us = dist_cm * 58
        var echo_us: int64 := dist * 58;
        
        Print("Messung ");
        PrintLn(i + 1);
        Print(": ");
        Print("Distanz = ");
        PrintLn(dist);
        Print(" cm");
        Print(", Echo-Dauer = ");
        PrintLn(echo_us);
        PrintLn(" us");
        
        // Warten
        var j: int64 := 0;
        while (j < 50000000) { j := j + 1; }
        
        i := i + 1;
    }
    
    // Laufzeit-Berechnung
    PrintLn("\nBerechnungsformel:");
    PrintLn("  Distanz (cm) = Echo_Dauer (us) / 58");
    PrintLn("  Distanz (inch) = Echo_Dauer (us) / 148");
    PrintLn("");
    
    PrintLn("Beispiel: 580 us -> 10 cm");
    PrintLn("Beispiel: 2900 us -> 50 cm");
    
    PrintLn("\nDemo abgeschlossen.");
    
    return 0;
}