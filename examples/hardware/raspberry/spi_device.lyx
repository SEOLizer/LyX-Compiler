// SPI Device Demo - Kommunikation mit SPI-Slave
// Demonstrates: SPI-Kommunikation ueber /dev/spi*
// Hardware: Raspberry Pi mit SPI-Geraet (z.B. Display, Sensor)
//
// SPI-Verkabelung (Beschriftung am Raspberry Pi):
// - SCLK: GPIO11 (Pin 23) - Serial Clock
// - MISO: GPIO9 (Pin 21) - Master In Slave Out
// - MOSI: GPIO10 (Pin 19) - Master Out Slave In
// - CE0: GPIO8 (Pin 24) - Chip Enable 0
// - CE1: GPIO7 (Pin 26) - Chip Enable 1
// - VCC: 3.3V (Pin 1)
// - GND: GND (Pin 6, 9, 14, 20, 25, 30, 34 oder 39)
//
// SPI-Modi:
// - Mode 0: CPOL=0, CPHA=0 (Clock low bei idle, Daten an steigender Flanke)
// - Mode 1: CPOL=0, CPHA=1 (Clock low bei idle, Daten an fallender Flanke)
// - Mode 2: CPOL=1, CPHA=0 (Clock high bei idle, Daten an fallender Flanke)
// - Mode 3: CPOL=1, CPHA=1 (Clock high bei idle, Daten an steigender Flanke)
//
// WICHTIG: SPI muss in raspi-config aktiviert sein!

fn main(): int64 {
    PrintLn("SPI Device Demo");
    PrintLn("===============");
    PrintLn("");
    
    // SPI-Erklaerung
    PrintLn("SPI (Serial Peripheral Interface):");
    PrintLn("- Voll-Duplex Kommunikation (gleichzeitig senden und empfangen)");
    PrintLn("- Master steuert Clock (SCLK)");
    PrintLn("- Mehrere Slaves ueber Chip-Select (CE0, CE1)");
    PrintLn("- Verschiedene Takt-Frequenzen moeglich");
    PrintLn("");
    
    // Typische SPI-Geraete
    PrintLn("Typische SPI-Geraete:");
    PrintLn("- ST7735: TFT Display (1.8\" Farbdisplay)");
    PrintLn("- MAX6675: Thermoelement-Verstaerker");
    PrintLn("- nRF24L01+: Funkmodul (2.4GHz)");
    PrintLn("- MFRC522: RFID-Leser");
    PrintLn("- MCP3008: 8-Kanal ADC");
    PrintLn("");
    
    // SPI-Parameter erklaeren
    PrintLn("SPI-Parameter:");
    PrintLn("- Takt-Frequenz: bis zu 32 MHz (Raspberry Pi 3)");
    PrintLn("- Bit-Order: MSB first oder LSB first");
    PrintLn("- Data-Mode: 0, 1, 2, oder 3");
    PrintLn("- Chip-Select: CE0 oder CE1");
    PrintLn("");
    
    // Simuliere SPI-Transaktion
    PrintLn("Simulierte SPI-Transaktion:\n");
    
    // Beispiel: ST7735 Display Initialisierung
    PrintLn("1. Display-Reset (CS=0, MOSI=0, SCLK toggeln)");
    PrintLn("2. Register 0x01 schreiben (Software Reset)");
    PrintLn("3. Warten 150ms");
    PrintLn("4. Register 0x11 schreiben (Sleep Out)");
    PrintLn("5. Warten 10ms");
    PrintLn("6. Register 0x29 schreiben (Display On)");
    PrintLn("");
    
    // Empfangene Daten anzeigen
    PrintLn("Empfangene Daten (simuliert):");
    var i: int64 := 0;
    while (i < 5) {
        Print("  Byte ");
        PrintLn(i);
        Print(": 0x");
        PrintLn(65 + i);  // 0x41, 0x42, ...
        Print(" (ASCII '");
        PrintLn(65 + i);
        PrintLn("')");
        i := i + 1;
    }
    
    PrintLn("\nLinux SPI-Zugriff:");
    PrintLn("1. /dev/spi0.0 oeffnen");
    PrintLn("2. ioctl mit SPI_IOC_WR_MODE setzen");
    PrintLn("3. write() mit struct spi_ioc_transfer");
    PrintLn("");
    
    PrintLn("Demo abgeschlossen.");
    
    return 0;
}