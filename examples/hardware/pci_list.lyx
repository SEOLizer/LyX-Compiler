// examples/hardware/pci_list.lyx
// Ein lspci-Klon auf Basis von std/hardware/pci.lyx.
//
// Uebersetzen und starten:
//   lyxc examples/hardware/pci_list.lyx -o pci_list && ./pci_list
//
// Lesen der ersten 64 Config-Bytes geht ohne root. Alles darueber —
// Capabilities, Link-Geschwindigkeit — laesst der Kernel nur den
// Berechtigten sehen; ohne root steht dort deshalb nichts, und das Programm
// sagt es einmal, statt Nullen zu zeigen.

unit examples.hardware.pci_list;

import std.hardware.pci;
import std.hardware.pci_types;
import std.hardware.pci_syscalls;
import std.hardware.pci_config;
import std.hardware.pci_enum;
import std.hardware.pci_bar;
import std.hardware.pci_caps;
import std.hardware.pci_ids;
import std.alloc;
import std.fs;
import std.io;

// Hinweis: die pchar-Zwischenvariable ist noetig. `Print(buf as pchar)`
// waehlt die int64-Ueberladung und druckt die Adresse statt des Textes
// (Compiler-Defekt #1316).
fn printHex(val: int64, digits: int64) {
  var buf: int64 := alloc(24);
  var s: pchar := buf as pchar;
  PciStrAppendHex(buf, 0, 24, val, digits);
  Print(s);
  free(buf, 24);
}

var nameBuf: int64 := 0;

// Der Zeiger wird bewusst hier erzeugt und nicht als globale pchar-Variable
// gehalten: ein globaler Startwert muss zur Uebersetzungszeit feststehen.
fn nameStr(): pchar {
  var s: pchar := nameBuf as pchar;
  return s;
}

// Gibt den Namen aus der Datenbank aus, sonst den Ersatztext.
fn printNameOr(rc: int64, fallback: pchar) {
  if (rc > 0) { Print(nameStr()); } else { Print(fallback); }
}

fn printDevice(dev: int64) {
  var addr: int64 := alloc(PCI_BDF_STR_LEN);
  var addrStr: pchar := addr as pchar;
  PciDevAddressStr(dev, addr);
  Print(addrStr);
  free(addr, PCI_BDF_STR_LEN);

  Print(" ");
  printNameOr(PciDevClassName(dev, nameBuf, 256),
              PciClassNameBuiltin(PciDevBaseClass(dev)));
  Print(": ");

  var vname: int64 := PciDevVendorName(dev, nameBuf, 256);
  if (vname > 0) { Print(nameStr()); Print(" "); }

  var dname: int64 := PciDevDeviceName(dev, nameBuf, 256);
  if (dname > 0) { Print(nameStr()); }
  else {
    printHex(PciDevVendorId(dev), 4);
    Print(":");
    printHex(PciDevDeviceId(dev), 4);
  }

  Print(" (rev ");
  printHex(PciDevRevision(dev), 2);
  Print(")");
  PrintLn("");

  // Regionen
  var i: int64 := 0;
  while (i < PCI_BAR_COUNT) {
    var size: int64 := PciDevBarSize(dev, i);
    if (size > 0) {
      Print("        Region ");
      Print(IntToStr(i));
      Print(": ");
      if (PciDevBarIsIo(dev, i) == 1) { Print("I/O bei 0x"); } else { Print("Speicher bei 0x"); }
      printHex(PciBarStart(PciDevBdf(dev), i), 8);
      Print(" [Groesse=");
      Print(IntToStr(size));
      PrintLn("]");
    }
    i := i + 1;
  }

  // Capabilities — ohne root nicht lesbar, dann steht hier nichts.
  var cap: int64 := PciDevCapFind(dev, PCI_CAP_ID_MSIX);
  if (cap > 0) {
    Print("        MSI-X: ");
    Print(IntToStr(PciDevMsixVectors(dev)));
    PrintLn(" Vektoren");
  }
  var speed: int64 := PciDevLinkSpeed(dev);
  if (speed > 0) {
    Print("        Link: ");
    Print(PciPcieSpeedName(speed));
    Print(" x");
    PrintLn(IntToStr(PciDevLinkWidth(dev)));
  }
}

fn main(): int64 {
  if (!IsDirectory(PCI_SYSFS_DEVICES)) {
    PrintLn("Kein /sys/bus/pci — dieser Kernel zeigt keinen PCI-Bus.");
    return 1;
  }

  nameBuf := alloc(256);

  // Eine Datenbank fuer alle Geraete: sie ist 1,4 MB gross und soll nicht
  // je Geraet neu gelesen werden.
  var db: int64 := PciIdsOpen();
  if (db < 0) {
    PrintLn("Hinweis: keine pci.ids gefunden — es werden numerische IDs gezeigt.");
    db := 0;
  }

  var buf: int64 := alloc(PCI_ENUM_MAX * 8);
  if (buf == 0) { PrintLn("Speicher erschoepft."); return 1; }

  var n: int64 := PciEnumSysfs(buf, PCI_ENUM_MAX);
  if (n < 0) {
    Print("Auflisten fehlgeschlagen: ");
    PrintLn(PciErrorName(n));
    free(buf, PCI_ENUM_MAX * 8);
    return 1;
  }

  var i: int64 := 0;
  while (i < n) {
    var dev: int64 := PciOpen(peek64(buf + i * 8));
    if (dev < 0) {
      Print("<nicht lesbar: ");
      Print(PciErrorName(dev));
      PrintLn(">");
    } else {
      if (db > 0) { PciAttachIds(dev, db); }
      printDevice(dev);
      PciClose(dev);
    }
    i := i + 1;
  }

  Print("--- ");
  Print(IntToStr(n));
  PrintLn(" Geraete");

  free(buf, PCI_ENUM_MAX * 8);
  if (db > 0) { PciIdsClose(db); }
  free(nameBuf, 256);
  return 0;
}
