// examples/hardware/pci_list.lyx
// Ein kleiner lspci-Klon auf Basis von std/hardware/pci_* (Phase 1).
//
// Uebersetzen und starten:
//   lyxc examples/hardware/pci_list.lyx -o pci_list && ./pci_list
//
// Lesen genuegt ohne root. Klarnamen zu Vendor- und Device-ID kommen erst
// mit PCI-07 (pci.ids); bis dahin zeigt die Ausgabe die numerischen IDs
// und den Klassennamen aus der eingebauten Tabelle.

unit examples.hardware.pci_list;

import std.hardware.pci_types;
import std.hardware.pci_syscalls;
import std.hardware.pci_config;
import std.hardware.pci_enum;
import std.alloc;
import std.fs;
import std.io;

// Hinweis: die pchar-Zwischenvariable ist noetig. `Print(buf as pchar)`
// waehlt die int64-Ueberladung und druckt die Adresse statt des Textes
// (Compiler-Defekt, siehe Issue zur Ueberladungsauswahl bei Cast-Argument).
fn printHex(val: int64, digits: int64) {
  var buf: int64 := alloc(24);
  var s: pchar := buf as pchar;
  PciStrAppendHex(buf, 0, 24, val, digits);
  Print(s);
  free(buf, 24);
}

fn printDevice(bdf: int64) {
  var path: int64 := alloc(PCI_PATH_MAX);
  var pathStr: pchar := path as pchar;
  PciBdfFormat(path, bdf);
  Print(pathStr);
  free(path, PCI_PATH_MAX);

  var ctx: int64 := PciCfgOpenSysfs(bdf);
  if (ctx <= 0) {
    Print("  <nicht lesbar: ");
    Print(PciErrorName(ctx));
    PrintLn(">");
    return;
  }

  Print(" ");
  Print(PciClassNameBuiltin(PciBaseClass(ctx)));
  Print(" [");
  printHex(PciBaseClass(ctx), 2);
  printHex(PciSubclass(ctx), 2);
  Print("]: ");
  printHex(PciVendorId(ctx), 4);
  Print(":");
  printHex(PciDeviceId(ctx), 4);
  Print(" (rev ");
  printHex(PciRevision(ctx), 2);
  Print(")");

  if (PciIsMultifunction(ctx) == 1) { Print(" [multifunction]"); }
  if (PciHeaderType(ctx) == PCI_HDR_BRIDGE) { Print(" [bridge]"); }

  var cmd: int64 := PciCfgRead16(ctx, PCI_CFG_COMMAND);
  if (cmd >= 0) {
    Print("  cmd:");
    if ((cmd & PCI_CMD_IO_SPACE) != 0)   { Print(" io"); }
    if ((cmd & PCI_CMD_MEM_SPACE) != 0)  { Print(" mem"); }
    if ((cmd & PCI_CMD_BUS_MASTER) != 0) { Print(" master"); }
    if ((cmd & PCI_CMD_INTX_DISABLE) != 0) { Print(" intx-off"); }
  }

  PrintLn("");
  PciCfgClose(ctx);
}

fn main(): int64 {
  if (!IsDirectory(PCI_SYSFS_DEVICES)) {
    PrintLn("Kein /sys/bus/pci — dieser Kernel zeigt keinen PCI-Bus.");
    return 1;
  }

  var buf: int64 := alloc(PCI_ENUM_MAX * 8);
  if (buf == 0) { PrintLn("Speicher erschoepft."); return 1; }

  var n: int64 := PciEnumSysfs(buf, PCI_ENUM_MAX);
  if (n < 0) {
    Print("Auflisten fehlgeschlagen: ");
    PrintLn(PciErrorName(n));
    free(buf, PCI_ENUM_MAX * 8);
    return 1;
  }

  var i: int64 := 0;
  while (i < n) {
    printDevice(peek64(buf + i * 8));
    i := i + 1;
  }

  Print("--- ");
  Print(IntToStr(n));
  PrintLn(" Geraete");

  free(buf, PCI_ENUM_MAX * 8);
  return 0;
}
