// Minimal LPOP test
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    // PING first
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    // Clear and setup list
    RedisDel(conn, "testlist");
    RedisLPush(conn, "testlist", "one");
    RedisLPush(conn, "testlist", "two");
    RedisLPush(conn, "testlist", "three");
    
    var llen: int64 := RedisLLen(conn, "testlist");
    Print("LLEN = ");
    PrintLn(llen);
    
    // Single LPOP
    var r: RedisReply := RedisLPop(conn, "testlist");
    Print("LPOP kind=");
    PrintLn(r.kind);
    Print(" str_len=");
    PrintLn(r.str_len);
    
    llen := RedisLLen(conn, "testlist");
    Print("LLEN after LPOP = ");
    PrintLn(llen);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}