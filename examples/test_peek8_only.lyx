// Test peek8 only - does it work at all?
fn main(): int64 {
    PrintLn("=== Test peek8 only ===");
    
    var buf: int64 := mmap(0, 4096, 3, 34, -1, 0);
    Print("mmap = ");
    PrintLn(buf);
    
    // Just peek8, NO poke before
    var val: int64 := peek8(buf);
    Print("peek8 (no poke before) = ");
    PrintLn(val);
    
    // Now poke and peek again
    poke8(buf, 65);
    var val2: int64 := peek8(buf);
    Print("peek8 (after poke) = ");
    PrintLn(val2);
    
    munmap(buf, 4096);
    PrintLn("Done");
    return 0;
}