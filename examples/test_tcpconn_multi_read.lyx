// Test multiple TCPConnRead calls with pchar buffer
import std.net.socket;

fn main(): int64 {
    var conn: TCPConn := TCPConnect(0x7F000001, 6379);
    if (conn.fd < 0) { return 1; }
    PrintLn("connected");
    
    // First command
    var req: pchar := "*1\r\n$4\r\nPING\r\n";
    TCPConnWrite(conn, req as pchar, 18);
    
    // First read with pchar buffer
    var buf: pchar := "                ";
    var n: int64 := TCPConnRead(conn, buf as pchar, 32);
    Print("read1 = ");
    PrintLn(n);
    Print(", buf = [");
    Print(buf);
    PrintLn("]");
    
    // Second command
    req := "*1\r\n$4\r\nPING\r\n";
    TCPConnWrite(conn, req as pchar, 18);
    
    // Second read with SAME pchar buffer
    n := TCPConnRead(conn, buf as pchar, 32);
    Print("read2 = ");
    PrintLn(n);
    
    TCPConnClose(conn);
    return 0;
}