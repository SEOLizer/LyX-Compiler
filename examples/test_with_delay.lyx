// Test with debug after first read
import std.net.socket;

fn main(): int64 {
    PrintLn("=== Test with debug ===");
    
    var conn: TCPConn := TCPConnect(0x7F000001, 6379);
    if (conn.fd < 0) { PrintLn("Connect failed"); return 1; }
    PrintLn("Connected");
    
    var buf: pchar := "                    ";
    var req: pchar;
    
    // PING 1
    req := "*1\r\n$4\r\nPING\r\n";
    PrintLn("Writing PING1...");
    sys_write(conn.fd, req, 18);
    PrintLn("Reading PING1...");
    var n: int64 := sys_read(conn.fd, buf, 32);
    Print("PING1 read n = ");
    PrintLn(n);
    
    PrintLn("After PING1, sleeping...");
    // Simple delay - just print something
    var i: int64 := 0;
    while (i < 100000000) { i := i + 1; }
    PrintLn("Sleep done");
    
    // PING 2
    req := "*1\r\n$4\r\nPING\r\n";
    PrintLn("Writing PING2...");
    sys_write(conn.fd, req, 18);
    PrintLn("Reading PING2...");
    n := sys_read(conn.fd, buf, 32);
    Print("PING2 read n = ");
    PrintLn(n);
    
    sys_close(conn.fd);
    PrintLn("Done");
    
    return 0;
}