// Add second read to working pattern
import std.alloc;
fn main(): int64 {
    PrintLn("=== Test with second read ===");
    
    var fd: int64 := sys_socket(2, 1, 0);
    Print("socket fd = ");
    PrintLn(fd);
    
    if (fd < 0) { return 1; }
    
    var addr: int64 := alloc(16);
    Print("mmap addr = ");
    PrintLn(addr);
    
    if (addr <= 0) {
        sys_close(fd);
        return 1;
    }
    
    poke8(addr, 2);
    poke8(addr + 2, 0x18);
    poke8(addr + 3, 0xEB);
    poke8(addr + 4, 0x7F);
    poke8(addr + 5, 0);
    poke8(addr + 6, 0);
    poke8(addr + 7, 1);
    
    var result: int64 := sys_connect(fd, addr, 16);
    Print("connect result = ");
    PrintLn(result);
    
    free(addr, 16);
    
    if (result < 0) {
        sys_close(fd);
        return 1;
    }
    
    PrintLn("Connected!");
    
    var req: pchar := "*1\r\n$4\r\nPING\r\n";
    var sent: int64 := sys_write(fd, req, 18);
    Print("write sent = ");
    PrintLn(sent);
    
    var buf: pchar := "                    ";
    var n: int64 := sys_read(fd, buf, 32);
    Print("read n = ");
    PrintLn(n);
    Print("\nResponse: [");
    Print(buf);
    PrintLn("]");
    
    // Second read - same pattern
    PrintLn("=== Second read ===");
    req := "*1\r\n$4\r\nPING\r\n";
    sent := sys_write(fd, req, 18);
    Print("write2 sent = ");
    PrintLn(sent);
    
    // Add debug before read
    PrintLn("About to call second read...");
    
    n := sys_read(fd, buf, 32);
    Print("read2 n = ");
    PrintLn(n);
    
    sys_close(fd);
    PrintLn("Done");
    
    return 0;
}