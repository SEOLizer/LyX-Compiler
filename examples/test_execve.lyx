import std.alloc;
fn main(): void {
  var argv: int64 := alloc(32);
  poke64(argv + 0, "/bin/echo" as int64);
  poke64(argv + 8, "hello_from_execve" as int64);
  poke64(argv + 16, 0);

  var pid: int64 := sys_fork();
  if (pid == 0) {
    sys_execve("/bin/echo", argv, 0);
    exit(127);
  }
  var st: int64 := alloc(8);
  sys_wait4(pid, st, 0);
  Print("done, status=");
  PrintLn((peek64(st) >> 8) & 255);
  PrintLn("");
  free(st, 8);
  free(argv, 32);
}
