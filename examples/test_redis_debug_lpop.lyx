// Debug LPOP issue specifically
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    }
    
    // Setup list the same way as test_redis_all_ops
    RedisDel(conn, "mylist");
    RedisLPush(conn, "mylist", "first");
    RedisLPush(conn, "mylist", "second");
    RedisLPush(conn, "mylist", "last");
    
    var llen: int64 := RedisLLen(conn, "mylist");
    Print("LLEN = ");
    PrintLn(llen);
    
    // LPOP
    var r: RedisReply := RedisLPop(conn, "mylist");
    Print("LPOP result: kind=");
    PrintLn(r.kind);
    Print(" int_val=");
    PrintLn(r.int_val);
    Print(" str_len=");
    PrintLn(r.str_len);
    
    // RPOP
    r := RedisRPop(conn, "mylist");
    Print("RPOP result: kind=");
    PrintLn(r.kind);
    Print(" int_val=");
    PrintLn(r.int_val);
    Print(" str_len=");
    PrintLn(r.str_len);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}