// Direct chain: mmap -> poke -> peek without intermediate storage
import std.alloc;
fn main(): int64 {
    PrintLn("=== Direct chain test ===");
    
    // Just mmap - don't store
    var addr: int64 := alloc(64);
    Print("mmap = ");
    PrintLn(addr);
    
    // Poke directly
    poke8(addr, 65);
    PrintLn("poke8 done");
    
    // Peek directly
    var v: int64 := peek8(addr);
    Print("peek8 = ");
    PrintLn(v);
    
    // Print hex
    Print("peek8 hex: ");
    PrintLn(v & 0xFF);
    
    // Second poke at offset
    poke8(addr + 1, 66);
    v := peek8(addr + 1);
    Print("peek8+1 = ");
    PrintLn(v);
    
    free(addr, 64);
    PrintLn("done");
    return 0;
}