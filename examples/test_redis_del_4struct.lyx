// Test DEL -> struct -> struct -> struct -> struct
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    // DEL returns int64
    var delres: int64 := RedisDel(conn, "testkey");
    Print("DEL result = ");
    PrintLn(delres);
    
    // 4 struct-returning functions
    var r: RedisReply := RedisLPush(conn, "testkey", "a");
    PrintLn("1 done");
    
    r := RedisRPush(conn, "testkey", "b");
    PrintLn("2 done");
    
    r := RedisLPop(conn, "testkey");
    PrintLn("3 done");
    
    r := RedisLPop(conn, "testkey");
    PrintLn("4 done");
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}