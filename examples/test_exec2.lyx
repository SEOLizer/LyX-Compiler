import std.os;
import std.alloc;

fn main(): void {
  PrintLn("1: before exec");
  var argv: int64 := alloc(48);
  Print("2: argv=");
  PrintLn(argv);

  var path: pchar := "/bin/echo";
  var a0: pchar := "hello";

  poke64(argv + 0, path as int64);
  poke64(argv + 8, a0 as int64);
  poke64(argv + 16, 0);
  PrintLn("3: argv filled");

  var pid: int64 := sys_fork();
  Print("4: pid=");
  PrintLn(pid);

  if (pid == 0) {
    PrintLn("5: child execve");
    sys_execve(path, argv, 0);
    PrintLn("6: execve failed");
    os_exit(127);
  }

  PrintLn("7: parent waiting");
  var st: int64 := alloc(8);
  sys_wait4(pid, st, 0);
  PrintLn("8: done");
  free(st, 8);
  free(argv, 48);
}
