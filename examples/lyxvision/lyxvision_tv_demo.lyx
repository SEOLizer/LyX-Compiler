// examples/lyxvision_tv_demo.lyx
// LyxVision Demo im Turbo Vision Stil
//
// Struktur wie bei Turbo Vision:
// - Menüleiste oben (Zeile 1)
// - Desktop in der Mitte (Zeilen 2-23)  
// - Statuszeile unten (Zeile 24)

import std.lyxvision.main;
import std.lyxvision.consts;
import std.lyxvision.window;

fn main(): int64 {
  // ===== Init =====
  Init();
  
  // ===== Desktop zeichnen (Zeilen 2-23) =====
  SetColors(colorLightGray, colorBlue);
  FillRect(1, 2, 80, 23);
  
  // ===== Menüleiste zeichnen (Zeile 1) =====
  SetColors(colorBlack, colorLightGray);
  FillRect(1, 1, 80, 1);
  WriteStr(2, 1, " Datei ");
  WriteStr(10, 1, " Bearbeiten ");
  WriteStr(24, 1, " Ansicht ");
  WriteStr(35, 1, " Hilfe ");
  
  // ===== Statuszeile zeichnen (Zeile 24) =====
  SetColors(colorBlack, colorCyan);
  FillRect(1, 24, 80, 24);
  WriteStr(2, 24, " ESC=Beenden ");
  WriteStr(17, 24, " F1=Hilfe ");
  WriteStr(29, 24, " F10=Menu ");
  
  // ===== Willkommensfenster =====
  var win: TWindow := WindowNew(18, 6, 44, 12, "Willkommen bei LyxVision");
  WindowDraw(win);
  
  // Text im Fenster
  SetColors(colorWhite, colorBlue);
  WriteStr(20, 8, "LyxVision - Turbo Vision Style");
  WriteStr(20, 10, "Eine TUI-Bibliothek fuer Lyx,");
  WriteStr(20, 11, "inspiriert von Borland TV 1990.");
  WriteStr(20, 13, "Features:");
  WriteStr(22, 14, "- Menueleiste (oben)");
  WriteStr(22, 15, "- Statuszeile (unten)");
  WriteStr(22, 16, "- Fenster mit Rahmen");
  
  // ===== Run (Event-Loop) =====
  RunSimple();
  
  // ===== Done =====
  Done();
  
  PrintLn("\nLyxVision TV Demo beendet.");
  return 0;
}
