// examples/lyxvision_app_demo.lyx
// LyxVision - Vereinfachte Demo (wegen Compiler-Bug bei struct-Feldzugriff)

import std.lyxvision.main;
import std.lyxvision.consts;
import std.lyxvision.window;

fn main(): int64 {
  Init();
  
  // Desktop zeichnen
  SetColors(colorLightGray, colorBlue);
  FillRect(1, 1, 80, 24);
  
  // Titelleiste
  SetColors(colorBlack, colorLightGray);
  FillRect(1, 1, 80, 1);
  WriteStr(25, 1, " LyxVision Application Demo ");
  
  // Statuszeile
  SetColors(colorBlack, colorCyan);
  FillRect(1, 24, 80, 24);
  WriteStr(2, 24, " ESC=Exit | q=Quit ");
  
  // Info-Fenster
  var win1: TWindow := WindowNew(5, 3, 35, 14, "Info");
  WindowDraw(win1);
  
  // Text im Fenster
  SetColors(colorWhite, colorBlue);
  WriteStr(7, 5, "LyxVision v0.2.0");
  WriteStr(7, 7, "Ein TUI Framework");
  WriteStr(7, 8, "fuer die Konsole.");
  WriteStr(7, 10, "Features:");
  WriteStr(9, 11, "- Fenstersystem");
  WriteStr(9, 12, "- Buttons");
  WriteStr(9, 13, "- Input-Felder");
  
  // Login-Fenster
  var win2: TWindow := WindowNew(42, 5, 35, 16, "Login");
  WindowDraw(win2);
  
  SetColors(colorWhite, colorBlue);
  WriteStr(44, 7, "Username:");
  WriteStr(44, 8, "[          ]");
  WriteStr(44, 10, "Password:");
  WriteStr(44, 11, "[          ]");
  WriteStr(45, 13, "[Login]  [Cancel]");
  
  // Hauptmenu
  SetColors(colorCyan, colorBlack);
  FillRect(1, 2, 80, 2);
  WriteStr(2, 2, " File  Edit  View  Help ");
  
  // Farbdemo
  var win3: TWindow := WindowNew(15, 17, 30, 6, "Colors");
  WindowDraw(win3);
  
  SetColors(colorBlack, colorBlack);
  WriteStr(17, 19, "Black   ");
  SetColors(colorBlue, colorBlack);
  WriteStr(25, 19, "Blue    ");
  SetColors(colorGreen, colorBlack);
  WriteStr(33, 19, "Green   ");
  SetColors(colorRed, colorBlack);
  WriteStr(17, 20, "Red     ");
  SetColors(colorMagenta, colorBlack);
  WriteStr(25, 20, "Magenta ");
  SetColors(colorYellow, colorBlack);
  WriteStr(33, 20, "Yellow  ");
  
  // Event-Loop
  RunSimple();
  
  Done();
  
  PrintLn("\nLyxVision Demo beendet.");
  return 0;
}
