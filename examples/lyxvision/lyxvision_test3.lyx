// Test mit StaticText
import std.lyxvision.main;
import std.lyxvision.consts;
import std.lyxvision.window;
import std.lyxvision.statictext;

fn main(): int64 {
  Init();
  
  SetColors(colorLightGray, colorBlue);
  FillRect(1, 1, 80, 24);
  
  var win1: TWindow := WindowNew(5, 3, 35, 14, "Test");
  WindowDraw(win1);
  
  var st1: TStaticText := StaticTextNew(7, 5, 25, "Hello World");
  StaticTextDraw(st1);
  
  WriteStr(2, 24, " Press ESC or q ");
  
  RunSimple();
  
  Done();
  PrintLn("\nOK");
  return 0;
}
