// examples/lyxvision_test.lyx
// LyxVision - Minimales Testprogramm mit ANSI-Support
// Demonstriert ANSI-Terminal-Steuerung mit \e und \xNN Escape-Sequenzen

// ============================================================================
// Terminal-Funktionen (ANSI)
// ============================================================================

fn ClearScreen() {
  Print("\x1b[2J");   // Clear screen
  Print("\x1b[H");    // Cursor home
}

fn MoveCursor(x: int64, y: int64) {
  Print("\x1b[");
  PrintLn(y);
  Print(";");
  PrintLn(x);
  Print("H");
}

fn HideCursor() {
  Print("\x1b[?25l");
}

fn ShowCursor() {
  Print("\x1b[?25h");
}

fn SetForeground(color: int64) {
  // 0=black, 1=red, 2=green, 3=yellow, 4=blue, 5=magenta, 6=cyan, 7=white
  Print("\x1b[");
  PrintLn(30 + color);
  Print("m");
}

fn SetBackground(color: int64) {
  Print("\x1b[");
  PrintLn(40 + color);
  Print("m");
}

fn SetBrightForeground(color: int64) {
  Print("\x1b[");
  PrintLn(90 + color);
  Print("m");
}

fn ResetColors() {
  Print("\x1b[0m");
}

fn SetBold() {
  Print("\x1b[1m");
}

fn SetReverse() {
  Print("\x1b[7m");
}

// ============================================================================
// Box-Zeichnung (Unicode)
// ============================================================================

fn DrawBox(x1: int64, y1: int64, x2: int64, y2: int64) {
  // Obere Zeile
  MoveCursor(x1, y1);
  Print("+");
  var x: int64 := x1 + 1;
  while (x < x2) {
    Print("-");
    x := x + 1;
  }
  Print("+");
  
  // Mittlere Zeilen
  var y: int64 := y1 + 1;
  while (y < y2) {
    MoveCursor(x1, y);
    Print("|");
    MoveCursor(x2, y);
    Print("|");
    y := y + 1;
  }
  
  // Untere Zeile
  MoveCursor(x1, y2);
  Print("+");
  x := x1 + 1;
  while (x < x2) {
    Print("-");
    x := x + 1;
  }
  Print("+");
}

fn FillRect(x1: int64, y1: int64, x2: int64, y2: int64) {
  var y: int64 := y1;
  while (y <= y2) {
    MoveCursor(x1, y);
    var x: int64 := x1;
    while (x <= x2) {
      Print(" ");
      x := x + 1;
    }
    y := y + 1;
  }
}

// ============================================================================
// Hauptprogramm
// ============================================================================

fn main(): int64 {
  // Terminal vorbereiten
  HideCursor();
  ClearScreen();
  
  // Hintergrund: Blau
  SetBackground(4);  // Blue
  FillRect(1, 1, 80, 24);
  
  // Titelleiste
  SetBackground(7);  // White/Light gray
  SetForeground(0);  // Black
  MoveCursor(1, 1);
  var i: int64 := 0;
  while (i < 80) {
    Print(" ");
    i := i + 1;
  }
  MoveCursor(28, 1);
  Print(" LyxVision Test v0.1.0 ");
  
  // Statuszeile
  MoveCursor(1, 24);
  i := 0;
  while (i < 80) {
    Print(" ");
    i := i + 1;
  }
  MoveCursor(2, 24);
  Print(" Press Enter to exit ");
  MoveCursor(60, 24);
  Print(" LyxVision 0.1.0 ");
  
  // Hauptbox
  SetBackground(4);  // Blue
  SetBrightForeground(3);  // Bright yellow
  DrawBox(20, 6, 60, 18);
  
  // Box-Inhalt
  SetBrightForeground(7);  // White
  MoveCursor(32, 8);
  Print("LyxVision");
  
  SetBrightForeground(6);  // Cyan
  MoveCursor(25, 10);
  Print("Text User Interface Framework");
  MoveCursor(28, 11);
  Print("for the Lyx Language");
  
  // Features
  SetBrightForeground(2);  // Green
  MoveCursor(24, 13);
  Print("Features:");
  
  SetForeground(7);  // Light gray
  MoveCursor(26, 14);
  Print("- ANSI Terminal Support");
  MoveCursor(26, 15);
  Print("- Escape sequences: \\e, \\xNN");
  MoveCursor(26, 16);
  Print("- Box drawing and colors");
  
  // Hinweis
  SetBrightForeground(3);  // Yellow
  MoveCursor(30, 20);
  Print("Press Enter...");
  
  // Warte auf Enter
  var buf: pchar := "          ";
  var n: int64 := read(0, buf, 1);
  
  // Aufräumen
  ResetColors();
  ShowCursor();
  ClearScreen();
  
  PrintLn("Goodbye from LyxVision!");
  
  return 0;
}
