// examples/lyxvision_minimal.lyx
// LyxVision - Minimales Testprogramm mit Unit-Import

import std.lyxvision.main;
import std.lyxvision.consts;

fn main(): int64 {
  // LyxVision initialisieren
  Init();
  
  // Bildschirm vorbereiten
  SetColors(colorLightGray, colorBlue);
  FillRect(1, 1, 80, 24);
  
  // Titelleiste
  SetColors(colorBlack, colorLightGray);
  FillRect(1, 1, 80, 1);
  WriteStr(30, 1, " LyxVision Minimal ");
  
  // Statuszeile
  FillRect(1, 24, 80, 24);
  WriteStr(2, 24, " Press ESC to exit ");
  WriteStr(60, 24, " v0.1.0 ");
  
  // Hauptbox
  SetColors(colorYellow, colorBlue);
  DrawBox(20, 8, 60, 18);
  
  // Inhalt
  SetColors(colorWhite, colorBlue);
  WriteStr(22, 10, "Minimales LyxVision Beispiel");
  WriteStr(22, 12, "Drücke ESC, um zu beenden.");
  
  // Event-Loop starten
  RunSimple();
  
  // LyxVision beenden
  Done();
  
  PrintLn("Goodbye from LyxVision!");
  return 0;
}
