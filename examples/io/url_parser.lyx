// URL Parser Demo
// Demonstrates: URL in Bestandteile zerlegen, String-Manipulation

fn main(): int64 {
    PrintLn("=== URL Parser Demo ===\n");
    
    // URL-Struktur erklaeren
    PrintLn("URL Struktur:");
    PrintLn("-------------");
    PrintLn("scheme://username:password@hostname:port/path?query#fragment");
    PrintLn("");
    
    PrintLn("Beispiel: https://user:pass@example.com:443/abc/def?x=1&y=2#section");
    PrintLn("");
    
    // Aufschluesseln
    PrintLn("Bestandteile:");
    PrintLn("-------------");
    PrintLn("  scheme:   https");
    PrintLn("  username: user");
    PrintLn("  password: pass");
    PrintLn("  hostname: example.com");
    PrintLn("  port:     443");
    PrintLn("  path:     /abc/def");
    PrintLn("  query:    x=1&y=2");
    PrintLn("  fragment: section");
    PrintLn("");
    
    // Parsing-Logik erklaeren
    PrintLn("Parsing-Logik:");
    PrintLn("--------------");
    PrintLn("1. Finde '://' -> Alles davor ist scheme");
    PrintLn("2. Nach '://': finde '@' fuer credentials");
    PrintLn("3. Vor '@': finde ':' fuer user:pass");
    PrintLn("4. Nach '@': finde ':' oder '/' fuer host:port");
    PrintLn("5. Nach host: finde '?' fuer query");
    PrintLn("6. Nach '?': finde '#' fuer fragment");
    PrintLn("");
    
    // Beispiel-Parsing
    PrintLn("Beispiel-Parsing:");
    PrintLn("-----------------");
    
    var url: pchar := "https://api.example.com:8080/v1/users?id=123#profile";
    
    Print("URL: ");
    Print(url);
    PrintLn("\n");
    
    // Scheme
    PrintLn("1. Scheme:");
    PrintLn("   Suche '://'");
    PrintLn("   -> 'https'\n");
    
    // Hostname
    PrintLn("2. Hostname:");
    PrintLn("   Nach '://' bis ':' oder '/' oder '?' oder '#'");
    PrintLn("   -> 'api.example.com'\n");
    
    // Port
    PrintLn("3. Port (optional):");
    PrintLn("   Nach ':' bis '/' oder '?'");
    PrintLn("   -> '8080'\n");
    
    // Path
    PrintLn("4. Path:");
    PrintLn("   Nach Host bis '?' oder '#' oder Ende");
    PrintLn("   -> '/v1/users'\n");
    
    // Query
    PrintLn("5. Query (optional):");
    PrintLn("   Nach '?' bis '#' oder Ende");
    PrintLn("   -> 'id=123'\n");
    
    // Fragment
    PrintLn("6. Fragment (optional):");
    PrintLn("   Nach '#' bis Ende");
    PrintLn("   -> 'profile'\n");
    
    // Praktische Beispiele
    PrintLn("Praktische Beispiele:");
    PrintLn("---------------------\n");
    
    // HTTP vs HTTPS
    PrintLn("HTTP vs HTTPS:");
    var http_url: pchar := "http://localhost:8080/api";
    var https_url: pchar := "https://secure.example.com/api";
    
    Print("  http:  ");
    Print(http_url);
    PrintLn(" -> scheme=http, port=8080");
    
    Print("  https: ");
    Print(https_url);
    PrintLn(" -> scheme=https, port=443 (default)");
    PrintLn("");
    
    // Query-Parameter
    PrintLn("Query-Parameter:");
    var query_url: pchar := "https://example.com/search?q=test&page=1&lang=de";
    
    Print("  URL: ");
    Print(query_url);
    PrintLn("");
    PrintLn("  Parameter:");
    PrintLn("    q=    test");
    PrintLn("    page= 1");
    PrintLn("    lang= de");
    PrintLn("");
    
    // URL-Encoding erklaeren
    PrintLn("URL-Encoding (Percent-Encoding):");
    PrintLn("---------------------------------");
    PrintLn("Sonderzeichen werden durch '%XX' ersetzt.");
    PrintLn("  Leerzeichen -> %20");
    PrintLn("  ! -> %21");
    PrintLn("  # -> %23");
    PrintLn("  ? -> %3F");
    PrintLn("");
    PrintLn("Beispiel: 'hello world' -> 'hello%20world'");
    PrintLn("");
    
    // Path-Variationen
    PrintLn("Path-Variationen:");
    PrintLn("----------------");
    PrintLn("  /                    -> Root");
    PrintLn("  /api/v1/users        -> Mehrere Segmente");
    PrintLn("  /api/v1/users/123    -> Mit ID");
    PrintLn("  /api/v1/users/123/orders -> Verschachtelt");
    PrintLn("");
    
    // IPv4 vs Hostname
    PrintLn("IPv4 vs Hostname:");
    PrintLn("-----------------");
    PrintLn("  http://192.168.1.1:80/ -> IP-Adresse");
    PrintLn("  http://localhost/      -> Hostname");
    PrintLn("  http://example.com/    -> Domain");
    PrintLn("");
    
    // Relative URLs erklaeren
    PrintLn("Relative URLs:");
    PrintLn("--------------");
    PrintLn("Ohne scheme/host - relativ zur aktuellen Seite:");
    PrintLn("  /api/users     -> absolut (vom Root)");
    PrintLn("  api/users      -> relativ");
    PrintLn("  ./users        -> relativ (aktuelles Verzeichnis)");
    PrintLn("  ../api         -> relativ (uebergeordnetes Verzeichnis)");
    
    PrintLn("\n=== Demo abgeschlossen ===");
    
    return 0;
}