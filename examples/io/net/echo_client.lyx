// Echo Client - Phase 1 Network Library Demo
// Connects to echo server and sends a message

import std.net.socket;

fn main(): int64 {
  PrintLn("Echo Client - Connecting to 127.0.0.1:8080");

  // Parse server address
  var addr, err := socket.ParseIPAddr("127.0.0.1:8080");
  if err != nil {
    Print("Failed to parse address: ");
    Print(err.Error());
    PrintLn("");
    return 1;
  }

  // Connect to server
  var conn, err := socket.TCPConnDial(addr);
  if err != nil {
    Print("Failed to connect: ");
    Print(err.Error());
    PrintLn("");
    return 1;
  }

  PrintLn("Connected to server!");

  // Send message
  var message: string := "Hello from Lyx Network Library!\n";
  var buf: array[uint8, 1024];

  // Convert string to bytes
  var i: int64 := 0;
  while i < len(message) {
    buf[i] = cast(uint8, message[i]);
    i := i + 1;
  }

  var _, err := conn.Write(buf[0:len(message)]);
  if err != nil {
    Print("Write error: ");
    Print(err.Error());
    PrintLn("");
    conn.Close();
    return 1;
  }

  Print("Sent: ");
  Print(message);

  // Receive echo
  var n, err := conn.Read(buf);
  if err != nil {
    Print("Read error: ");
    Print(err.Error());
    PrintLn("");
    conn.Close();
    return 1;
  }

  Print("Received: ");
  var j: int64 := 0;
  while j < n {
    var ch: string := "X";
    buf_put_byte(&ch[0], 0, cast(int64, buf[j]));
    Print(ch);
    j := j + 1;
  }
  PrintLn("");

  // Close connection
  conn.Close();
  PrintLn("Connection closed");

  return 0;
}
