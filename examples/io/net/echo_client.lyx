// Echo Client — Gegenstück zu echo_server.lyx
// Verbindet sich auf 127.0.0.1:8080, sendet eine Zeile und gibt die Antwort aus.
//
// Lyx hat weder Tupel-Destructuring (`var a, err := f()`) noch Slices
// (`buf[0:n]`) noch `nil`. Fehler kommen als negativer Rückgabewert.

import std.net.socket;
import std.alloc;
import std.string;

con SERVER_IP: int64 := 0x7F000001;   // 127.0.0.1
con SERVER_PORT: int64 := 8080;
con BUFSZ: int64 := 1024;

fn main(): int64 {
  PrintLn("Echo Client - Connecting to 127.0.0.1:8080");

  var conn: TCPConn := TCPConnect(SERVER_IP, SERVER_PORT);
  if (conn.fd < 0) {
    Print("Failed to connect: ");
    PrintLn(conn.fd);
    return 1;
  }
  PrintLn("Connected to server!");

  var message: pchar := "Hello from Lyx Network Library!\n";
  var mlen: int64 := StrLen(message);

  var nwritten: int64 := TCPConnWrite(conn, message, mlen);
  if (nwritten < 0) {
    Print("Write error: ");
    PrintLn(nwritten);
    TCPConnClose(conn);
    return 1;
  }
  Print("Sent: ");
  Print(message);

  var buf: int64 := alloc(BUFSZ);
  var n: int64 := TCPConnRead(conn, buf, BUFSZ);
  if (n < 0) {
    Print("Read error: ");
    PrintLn(n);
    free(buf, BUFSZ);
    TCPConnClose(conn);
    return 1;
  }

  Print("Received: ");
  var j: int64 := 0;
  while (j < n) {
    PrintChar(peek8(buf + j));
    j := j + 1;
  }
  PrintLn("");

  free(buf, BUFSZ);
  TCPConnClose(conn);
  PrintLn("Connection closed");
  return 0;
}
