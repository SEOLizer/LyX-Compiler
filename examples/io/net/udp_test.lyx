// UDP Socket Test
// Simple test to verify UDP socket creation and basic operations

import std.net.socket;
import std.net.types;

fn main(): int64 {
  var sock: UDPSocket;
  
  PrintLn("UDP Socket Test");
  PrintLn("================");
  
  // Create UDP socket
  sock := UDPSocketNew();
  if (sock.fd < 0) {
    PrintLn("Failed to create socket");
    return 1;
  }
  
  Print("Socket created, fd=");
  PrintLn(sock.fd);
  
  // Close socket
  UDPSocketClose(sock);
  PrintLn("Socket closed");
  PrintLn("Test PASSED");
  return 0;
}
