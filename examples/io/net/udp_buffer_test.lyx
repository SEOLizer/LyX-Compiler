// UDP Buffer Test
// Test buffer allocation and UDP socket

import std.net.socket;
import std.net.types;

fn main(): int64 {
  var sock: UDPSocket;
  var buf: int64;
  var clientAddr: int64;
  var n: int64;
  var sent: int64;
  
  PrintLn("UDP Buffer Test");
  PrintLn("================");
  
  // Allocate receive buffer (using explicit values to ensure correctness)
  buf := mmap(0, 4096, 3, 34, -1, 0);
  if (buf == 0) {
    PrintLn("Failed to allocate buffer");
    return 1;
  }
  
  Print("Buffer allocated at address: ");
  PrintLn(buf);
  
  // Create UDP socket
  sock := UDPSocketNew();
  if (sock.fd < 0) {
    PrintLn("Failed to create socket");
    munmap(buf, 4096);
    return 1;
  }
  
  Print("Socket created, fd=");
  PrintLn(sock.fd);
  
  // Allocate client address buffer
  clientAddr := mmap(0, 128, 3, 34, -1, 0);
  if (clientAddr == 0) {
    PrintLn("Failed to allocate client address buffer");
    UDPSocketClose(sock);
    munmap(buf, 4096);
    return 1;
  }
  
  Print("Client address buffer allocated at: ");
  PrintLn(clientAddr);
  
  // Cleanup
  UDPSocketClose(sock);
  munmap(buf, 4096);
  munmap(clientAddr, 128);
  
  PrintLn("Cleanup done");
  PrintLn("Test PASSED");
  return 0;
}
