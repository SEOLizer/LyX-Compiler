// ICMP/Ping Test
// Test raw socket and ICMP packet creation

import std.net.socket;
import std.net.types;

fn main(): int64 {
  var sock: RawSocket;
  var buf: int64;
  var addr: SockAddrIn;
  var n: int64;
  
  PrintLn("ICMP Test");
  PrintLn("========");
  
  // Try to create raw socket for ICMP
  sock := RawSocketNew(IPPROTO_ICMP);
  
  if (sock.fd < 0) {
    PrintLn("Note: Raw socket requires root privileges");
    Print("fd = ");
    PrintLn(sock.fd);
    PrintLn("This is expected when not running as root");
    return 0;
  }
  
  Print("Raw socket created, fd=");
  PrintLn(sock.fd);
  
  // Test ICMP header creation
  var hdr: ICMPHeader;
  hdr := ICMPMakeEchoRequest(1, 1);
  
  PrintLn("ICMP Header created:");
  Print("  type = ");
  PrintLn(hdr.icmp_type as int64);
  Print("  code = ");
  PrintLn(hdr.icmp_code as int64);
  Print("  id = ");
  PrintLn(hdr.icmp_id as int64);
  Print("  seq = ");
  PrintLn(hdr.icmp_seq as int64);
  
  // Test checksum calculation
  buf := BufferAlloc(64);
  if (buf > 0) {
    poke8(buf + 0, 8);   // type = echo request
    poke8(buf + 1, 0);    // code = 0
    poke8(buf + 2, 0);    // checksum (placeholder)
    poke8(buf + 3, 0);
    poke8(buf + 4, 1);    // id = 1
    poke8(buf + 5, 0);
    poke8(buf + 6, 1);    // seq = 1
    poke8(buf + 7, 0);
    
    var cksum: int64 := ICMPChecksum(buf, 8);
    Print("ICMP checksum = ");
    PrintLn(cksum as int64);
    
    BufferFree(buf, 64);
  }
  
  // Cleanup
  RawSocketClose(sock);
  PrintLn("Test completed");
  return 0;
}
