// Simple Echo Server - Testing Phase 1 Socket API

// Socket constants
con AF_INET: int64 := 2;
con SOCK_STREAM: int64 := 1;
con IPPROTO_TCP: int64 := 6;

// TCP Listener struct
type TCPListener = struct {
  fd: int64;
};

// TCP Connection struct
type TCPConn = struct {
  fd: int64;
};

fn main(): int64 {
  PrintLn("Simple Echo Server");
  PrintLn("==================");
  
  // Create socket
  var fd: int64 := sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
  if (fd < 0) {
    PrintLn("Failed to create socket");
    return 1;
  }
  Print("Socket created, fd = ");
  PrintLn(fd);
  
  // Start listening (will fail without bind, but tests the API)
  var ret: int64 := sys_listen(fd, 128);
  Print("Listen returned: ");
  PrintLn(ret);
  
  // Close
  close(fd);
  PrintLn("Done");
  return 0;
}
