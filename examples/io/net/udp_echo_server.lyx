// UDP Echo Server
// Receives datagrams and echoes them back to sender

import std.net.socket;
import std.net.types;

fn main(): int64 {
  PrintLn("UDP Echo Server");
  PrintLn("===============");
  
  // Create UDP socket
  var sock: UDPSocket := UDPSocketNew();
  if (sock.fd < 0) {
    PrintLn("Failed to create socket");
    return 1;
  }
  Print("Socket created, fd=");
  PrintLn(sock.fd);
  
  // Bind to 0.0.0.0:9000
  var ip: int64 := IPPack(0, 0, 0, 0);
  var ret: int64 := UDPSocketBindTo(sock, ip, 9000);
  if (ret < 0) {
    Print("Bind failed: ");
    PrintLn(ret);
    UDPSocketClose(sock);
    return 1;
  }
  PrintLn("Bound to port 9000");
  PrintLn("Waiting for datagrams...");
  
  // Allocate buffers
  var buf: int64 := BufferAlloc(1024);
  var senderIP: int64 := BufferAlloc(8);
  var senderPort: int64 := BufferAlloc(8);
  
  if (buf == 0) {
    PrintLn("Buffer allocation failed");
    UDPSocketClose(sock);
    return 1;
  }
  
  // Receive one datagram
  var nread: int64 := UDPSocketRecv(sock, buf, 1024, senderIP, senderPort);
  
  if (nread > 0) {
    // Read sender info
    var srcIP: int64 := peek8(senderIP) | (peek8(senderIP + 1) << 8) |
                        (peek8(senderIP + 2) << 16) | (peek8(senderIP + 3) << 24);
    var srcPort: int64 := peek8(senderPort) | (peek8(senderPort + 1) << 8);
    
    Print("Received ");
    PrintLn(nread);
    Print(" bytes from ");
    PrintLn((srcIP >> 24) & 0xFF); Print(".");
    PrintLn((srcIP >> 16) & 0xFF); Print(".");
    PrintLn((srcIP >> 8) & 0xFF); Print(".");
    PrintLn(srcIP & 0xFF);
    Print(":");
    PrintLn(srcPort);
    
    // Echo back
    var nsent: int64 := UDPSocketSendToAddr(sock, buf, nread, srcIP, srcPort);
    Print("Echoed ");
    PrintLn(nsent);
    PrintLn(" bytes");
  } else {
    Print("Receive failed: ");
    PrintLn(nread);
  }
  
  // Cleanup
  BufferFree(buf, 1024);
  BufferFree(senderIP, 8);
  BufferFree(senderPort, 8);
  UDPSocketClose(sock);
  
  PrintLn("Server finished");
  return 0;
}
