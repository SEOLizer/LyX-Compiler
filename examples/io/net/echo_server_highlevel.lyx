// Echo Server using High-Level Socket API
// Demonstrates the std.net.socket library

import std.net.socket;
import std.net.types;

fn main(): int64 {
  PrintLn("Echo Server (High-Level API)");
  PrintLn("============================");
  
  // Create TCP listener
  var listener: TCPListener := TCPListenerNew();
  if (listener.fd < 0) {
    PrintLn("Failed to create socket");
    return 1;
  }
  PrintLn("Socket created");
  
  // Set SO_REUSEADDR to allow quick restart
  var ret: int64 := TCPListenerSetReuseAddr(listener);
  if (ret < 0) {
    PrintLn("Warning: setsockopt failed");
  }
  
  // Bind to 0.0.0.0:8080
  var ip: int64 := IPPack(0, 0, 0, 0);  // INADDR_ANY
  ret := TCPListenerBindTo(listener, ip, 8080);
  if (ret < 0) {
    Print("Failed to bind: ");
    PrintLn(ret);
    TCPListenerClose(listener);
    return 1;
  }
  PrintLn("Bound to port 8080");
  
  // Start listening
  ret := TCPListenerListen(listener, 128);
  if (ret < 0) {
    Print("Failed to listen: ");
    PrintLn(ret);
    TCPListenerClose(listener);
    return 1;
  }
  PrintLn("Listening for connections...");
  
  // Accept one connection
  var conn: TCPConn := TCPListenerAccept(listener);
  if (conn.fd < 0) {
    PrintLn("Accept failed");
    TCPListenerClose(listener);
    return 1;
  }
  PrintLn("Client connected!");
  
  // Allocate buffer
  var buf: int64 := BufferAlloc(1024);
  if (buf == 0) {
    PrintLn("Buffer allocation failed");
    TCPConnClose(conn);
    TCPListenerClose(listener);
    return 1;
  }
  
  // Read data
  var nread: int64 := TCPConnRead(conn, buf as pchar, 1024);
  if (nread > 0) {
    Print("Received ");
    PrintLn(nread);
    PrintLn(" bytes");
    
    // Echo back
    var nwritten: int64 := TCPConnWrite(conn, buf as pchar, nread);
    Print("Sent ");
    PrintLn(nwritten);
    PrintLn(" bytes");
  } else {
    PrintLn("Read failed or connection closed");
  }
  
  // Cleanup
  BufferFree(buf, 1024);
  TCPConnClose(conn);
  TCPListenerClose(listener);
  
  PrintLn("Server finished");
  return 0;
}
