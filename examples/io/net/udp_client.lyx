// UDP Client
// Send a message to a UDP server and receive response

import std.net.socket;
import std.net.types;

fn main(): int64 {
  PrintLn("UDP Client");
  PrintLn("==========");
  
  // Create UDP socket
  var sock: UDPSocket := UDPSocketNew();
  if (sock.fd < 0) {
    PrintLn("Failed to create socket");
    return 1;
  }
  PrintLn("Socket created");
  
  // Allocate buffer
  var buf: int64 := BufferAlloc(256);
  if (buf == 0) {
    PrintLn("Buffer allocation failed");
    UDPSocketClose(sock);
    return 1;
  }
  
  // Write message to buffer: "Hello UDP!"
  poke8(buf + 0, 72);   // H
  poke8(buf + 1, 101);  // e
  poke8(buf + 2, 108);  // l
  poke8(buf + 3, 108);  // l
  poke8(buf + 4, 111);  // o
  poke8(buf + 5, 32);   // (space)
  poke8(buf + 6, 85);   // U
  poke8(buf + 7, 68);   // D
  poke8(buf + 8, 80);   // P
  poke8(buf + 9, 33);   // !
  
  // Send to localhost:9000
  var destIP: int64 := IPPack(127, 0, 0, 1);
  var nsent: int64 := UDPSocketSendToAddr(sock, buf, 10, destIP, 9000);
  
  Print("Sent ");
  PrintLn(nsent);
  PrintLn(" bytes to 127.0.0.1:9000");
  
  if (nsent < 0) {
    PrintLn("Send failed");
    BufferFree(buf, 256);
    UDPSocketClose(sock);
    return 1;
  }
  
  // Wait for response
  PrintLn("Waiting for response...");
  
  var senderIP: int64 := BufferAlloc(8);
  var senderPort: int64 := BufferAlloc(8);
  
  var nread: int64 := UDPSocketRecv(sock, buf, 256, senderIP, senderPort);
  
  if (nread > 0) {
    Print("Received ");
    PrintLn(nread);
    PrintLn(" bytes back");
  } else {
    PrintLn("No response received");
  }
  
  // Cleanup
  BufferFree(buf, 256);
  BufferFree(senderIP, 8);
  BufferFree(senderPort, 8);
  UDPSocketClose(sock);
  
  PrintLn("Client finished");
  return 0;
}
