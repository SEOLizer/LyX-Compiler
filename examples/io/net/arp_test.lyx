// ARP Test
// Test ARP packet creation and serialization

import std.net.socket;
import std.net.types;

fn main(): int64 {
  var buf: int64;
  var len: int64;
  
  PrintLn("ARP Test");
  PrintLn("========");
  
  // Create MAC addresses
  var broadcastMac: MacAddr := MacBroadcast();
  var myMac: MacAddr := broadcastMac;
  
  PrintLn("Broadcast MAC created");
  
  // Create IP addresses
  var myIP: int64 := IPPack(192, 168, 1, 100);
  var gatewayIP: int64 := IPPack(10, 0, 0, 1);
  
  Print("My IP: ");
  PrintLn(myIP);
  
  Print("Gateway IP: ");
  PrintLn(gatewayIP);
  
  // Create Ethernet header
  var eth: EthernetHeader;
  eth := EthernetHeaderCreate(broadcastMac, myMac, ETH_P_ARP);
  
  Print("Ethernet EtherType: ");
  PrintLn(eth.ethertype as int64);
  
  // Create ARP request
  var arp: ARPPacket;
  arp := ARPMakeRequest(myMac, myIP, gatewayIP);
  
  Print("ARP Operation: ");
  PrintLn(arp.ar_op as int64);
  
  // Serialize to buffer
  buf := BufferAlloc(128);
  if (buf == 0) {
    PrintLn("Failed to allocate buffer");
    return 1;
  }
  
  len := ARPSerializePacket(eth, arp, buf);
  
  Print("Serialized packet length: ");
  PrintLn(len);
  PrintLn(" bytes (expected 42)");
  
  // Print first few bytes of packet (Ethernet header)
  PrintLn("Ethernet header (first 14 bytes):");
  var i: int64 := 0;
  while (i < 14) {
    var b: int64 := peek8(buf + i);
    PrintLn(b);
    Print(" ");
    i := i + 1;
  }
  PrintLn("");
  
  // Print ARP part (bytes 14-41)
  PrintLn("ARP header (bytes 14-27):");
  i := 14;
  while (i < 28) {
    var b: int64 := peek8(buf + i);
    PrintLn(b);
    Print(" ");
    i := i + 1;
  }
  PrintLn("");
  
  // Test IP unpack
  var unpackedIP: IPAddr;
  unpackedIP := IPUnpack(gatewayIP);
  
  Print("Unpacked gateway IP: ");
  PrintLn(unpackedIP.a);
  Print(".");
  PrintLn(unpackedIP.b);
  Print(".");
  PrintLn(unpackedIP.c);
  Print(".");
  PrintLn(unpackedIP.d);
  
  // Cleanup
  BufferFree(buf, 128);
  
  PrintLn("Test PASSED");
  return 0;
}
