// Simple Echo Server - Testing Phase 1 Socket API

import std.net.socket;

fn main(): int64 {
  var listener: TCPListener;
  
  PrintLn("Simple Echo Server");
  
  // Create listener
  listener := TCPListenerNew();
  
  // Test field access
  if (listener.fd < 0) {
    PrintLn("Failed to create listener");
    return 1;
  }
  
  Print("Listener created, fd=");
  PrintLn(listener.fd);
  
  // Listen
  var res: int64 := TCPListenerListen(listener, 10);
  
  if (res < 0) {
    PrintLn("Listen failed");
    TCPListenerClose(listener);
    return 1;
  }
  
  PrintLn("Listening on 0.0.0.0:8080");
  PrintLn("Done");
  return 0;
}
