// Dateisystem-Operationen Demo
// Demonstrates: Datei-Operationen (konzeptuell)
// Hinweis: Die tatsaechliche Implementierung erfordert pchar-Handling

fn main(): int64 {
    PrintLn("=== Dateisystem Demo ===\n");
    
    //Dateioperationen erklaeren
    PrintLn("Dateisystem-Operationen:");
    PrintLn("========================\n");
    
    // Oeffnen
    PrintLn("1. Datei oeffnen:");
    PrintLn("   fd = open(\"/pfad/datei.txt\", O_RDONLY)");
    PrintLn("   O_RDONLY = 0 (nur lesen)");
    PrintLn("   O_WRONLY = 1 (nur schreiben)");
    PrintLn("   O_RDWR   = 2 (lesen + schreiben)\n");
    
    // Erstellen mit Flags
    PrintLn("2. Datei erstellen:");
    PrintLn("   fd = open(\"neu.txt\", O_WRONLY | O_CREAT | O_TRUNC, 0644)");
    PrintLn("   O_CREAT = 64  (erstellen falls nicht existent)");
    PrintLn("   O_TRUNC = 512 (auf 0 Bytes kuerzen)");
    PrintLn("   O_APPEND = 1024 (an Ende anhaengen)\n");
    
    // Lesen
    PrintLn("3. Datei lesen:");
    PrintLn("   bytes = read(fd, buffer, anzahl)");
    PrintLn("   Gibt Anzahl gelesener Bytes zurueck");
    PrintLn("   0 = EOF (Dateiende)");
    PrintLn("   -1 = Fehler\n");
    
    // Schreiben
    PrintLn("4. Datei schreiben:");
    PrintLn("   bytes = write(fd, buffer, anzahl)");
    PrintLn("   Gibt Anzahl geschriebener Bytes zurueck\n");
    
    // Positionieren
    PrintLn("5. Dateiposition:");
    PrintLn("   pos = lseek(fd, offset, SEEK_SET)");
    PrintLn("   SEEK_SET = 0 (vom Anfang)");
    PrintLn("   SEEK_CUR = 1 (von aktueller Position)");
    PrintLn("   SEEK_END = 2 (vom Ende)\n");
    
    // Schliessen
    PrintLn("6. Datei schliessen:");
    PrintLn("   close(fd)\n");
    
    // Loeschen
    PrintLn("7. Datei loeschen:");
    PrintLn("   unlink(\"/pfad/datei.txt\")");
    PrintLn("   gibt 0 zurueck bei Erfolg\n");
    
    // Datei-Informationen
    PrintLn("8. Datei-Informationen:");
    PrintLn("   fstat(fd, &stat_struct)");
    PrintLn("   Liefert: Groesse, Rechte, Timestamps\n");
    
    // Simulierte Verwendung
    PrintLn("Beispiel-Ablauf:");
    PrintLn("================\n");
    
    var count: int64 := 3;
    var i: int64 := 0;
    
    while (i < count) {
        Print("Schritt ");
        PrintLn(i + 1);
        PrintLn(":");
        
        if (i == 0) {
            PrintLn("  - open(\"test.txt\", O_RDONLY) -> fd=3");
            PrintLn("  - read(fd, buf, 100) -> n Bytes");
        } else if (i == 1) {
            PrintLn("  - lseek(fd, 0, SEEK_SET) -> pos=0");
            PrintLn("  - read(fd, buf, 50) -> n Bytes");
        } else {
            PrintLn("  - close(fd) -> 0");
        }
        
        PrintLn("");
        i := i + 1;
    }
    
    PrintLn("=== Demo abgeschlossen ===");
    
    return 0;
}