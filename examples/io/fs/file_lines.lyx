// File Lines Demo - Zeilenweises Lesen
// Demonstrates: Zeilen aus Datei lesen, Datei-Handling

import std.fs;

fn main(): int64 {
    PrintLn("=== Zeilenweises Lesen Demo ===\n");
    
    // Erstelle Test-Datei mit mehreren Zeilen
    var test_file: pchar := "/tmp/lyx_lines.txt";
    var lines: pchar := "Zeile 1: Hallo\nZeile 2: Welt\nZeile 3: Lyx\nZeile 4: Programmieren\n";
    
    WriteFile(test_file, lines, 56);
    
    PrintLn("Test-Datei erstellt mit 4 Zeilen.\n");
    
    // Oeffne Datei zum Lesen
    var fd: int64 := open(test_file, O_RDONLY, 0);
    
    if (fd < 0) {
        PrintLn("Fehler: Konnte Datei nicht oeffnen");
        return 1;
    }
    
    // Lese Zeichen fuer Zeichen und suche Newlines
    var buffer: [256]int64;
    var pos: int64 := 0;
    var total_read: int64 := 0;
    var line_num: int64 := 1;
    
    PrintLn("Inhalt der Datei:");
    PrintLn("-----------------");
    
    // Einfaches zeilenweises Lesen
    // Wir lesen solange bis EOF
    var eof: bool := false;
    
    while (!eof) {
        var n: int64 := read(fd, buffer + pos, 1);
        
        if (n <= 0) {
            eof := true;
            if (pos > 0) {
                // Letzte Zeile ohne Newline
                Print("  Zeile ");
                PrintLn(line_num);
                PrintLn(": [ohne Newline]");
            }
            break;
        }
        
        total_read := total_read + 1;
        
        // Check for newline
        if (buffer[pos] == 10) {  // newline (ASCII 10)
            // Zeile fertig
            Print("  Zeile ");
            PrintLn(line_num);
            Print(": (");
            PrintLn(pos);
            PrintLn(" Zeichen)");
            
            line_num := line_num + 1;
            pos := 0;
        } else {
            pos := pos + 1;
            
            // Wenn Puffer voll, zeige trotzdem
            if (pos >= 255) {
                Print("  Zeile ");
                PrintLn(line_num);
                PrintLn(": (Puffer voll)");
                line_num := line_num + 1;
                pos := 0;
            }
        }
    }
    
    close(fd);
    
    Print("\nSumme: ");
    PrintLn(line_num);
    PrintLn(" Zeilen gelesen");
    Print("Bytes gelesen: ");
    PrintLn(total_read);
    
    // Cleanup
    DeleteFile(test_file);
    PrintLn("Test-Datei geloescht.");
    
    PrintLn("\n=== Demo abgeschlossen ===");
    
    return 0;
}