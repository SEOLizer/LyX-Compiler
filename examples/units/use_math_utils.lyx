import math_utils;
import string_utils;

fn main(): int64 {
    // Verwendung von math_utils
    var a: int64 := 10;
    var b: int64 := 5;
    
    Print("10 + 5 = ");
    PrintLn(math_utils.add(a, b));
    PrintLn("");
    
    Print("10 - 5 = ");
    PrintLn(math_utils.sub(a, b));
    PrintLn("");
    
    Print("10 * 5 = ");
    PrintLn(math_utils.mul(a, b));
    PrintLn("");
    
    Print("10 / 5 = ");
    PrintLn(math_utils.div(a, b));
    PrintLn("");
    
    Print("2^10 = ");
    PrintLn(math_utils.power(2, 10));
    PrintLn("");
    
    Print("5! = ");
    PrintLn(math_utils.factorial(5));
    PrintLn("");
    
    return 0;
}