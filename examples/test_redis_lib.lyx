// Test full Redis operations with std.db.redis
import std.db.redis;

fn main(): int64 {
    PrintLn("=== Redis SET/GET Test ===");
    
    // Connect to Redis
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    
    if (conn.fd < 0) {
        PrintLn("Failed to connect");
        return 1;
    }
    
    PrintLn("Connected!");
    
    // Ping
    var ping_ok: bool := RedisPing(conn);
    Print("Ping: ");
    if (ping_ok) { PrintLn("OK"); } else { PrintLn("FAILED"); }
    
    // Set key
    PrintLn("Setting testkey = helloworld...");
    var set_reply: RedisReply := RedisSet(conn, "testkey", "helloworld");
    Print("SET reply kind: ");
    PrintLn(set_reply.kind);
    if (set_reply.str_val != "") {
        Print("SET reply: ");
        Print(set_reply.str_val);
        PrintLn("");
    }
    
    // Get key
    PrintLn("Getting testkey...");
    var get_reply: RedisReply := RedisGet(conn, "testkey");
    Print("GET reply kind: ");
    PrintLn(get_reply.kind);
    if (get_reply.str_val != "") {
        Print("GET value: ");
        Print(get_reply.str_val);
        PrintLn("");
    }
    
    // Close
    RedisClose(conn);
    PrintLn("Done.");
    
    return 0;
}