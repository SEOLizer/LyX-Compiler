// Debug - 3 LPUSH + LLEN + LPOP + RPOP (crash after RPOP)
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    }
    
    RedisDel(conn, "mylist");
    
    var r: RedisReply := RedisLPush(conn, "mylist", "first");
    PrintLn("LPUSH1 done");
    
    r := RedisLPush(conn, "mylist", "second");
    PrintLn("LPUSH2 done");
    
    r := RedisLPush(conn, "mylist", "last");
    PrintLn("LPUSH3 done");
    
    var llen: int64 := RedisLLen(conn, "mylist");
    Print("LLEN = ");
    PrintLn(llen);
    
    r := RedisLPop(conn, "mylist");
    Print("LPOP result: kind=");
    PrintLn(r.kind);
    
    // Now RPOP - this is where the crash happens
    r := RedisRPop(conn, "mylist");
    Print("RPOP result: kind=");
    PrintLn(r.kind);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}