// Test peek16 on mmap buffer after any write
import std.alloc;
fn main(): int64 {
    PrintLn("=== Test peek16 after mmap ===");
    
    var buf: int64 := alloc(4096);
    Print("mmap = ");
    PrintLn(buf);
    
    // Try to read BEFORE any poke - should be 0
    var val1: int64 := peek16(buf);
    Print("peek16 (before poke) = ");
    PrintLn(val1);
    
    // Now write
    poke16(buf, 65);
    PrintLn("Wrote 65");
    
    // Read after write
    var val2: int64 := peek16(buf);
    Print("peek16 (after poke) = ");
    PrintLn(val2);
    
    free(buf, 4096);
    PrintLn("Done");
    return 0;
}