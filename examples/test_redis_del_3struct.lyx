// Test DEL -> struct -> struct -> struct
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    // DEL returns int64
    var delres: int64 := RedisDel(conn, "testkey");
    Print("DEL result = ");
    PrintLn(delres);
    
    // LPUSH returns struct
    var r: RedisReply := RedisLPush(conn, "testkey", "value");
    PrintLn("LPUSH done");
    
    // RPUSH returns struct
    r := RedisRPush(conn, "testkey", "value2");
    PrintLn("RPUSH done");
    
    // LPOP returns struct - the 3rd one!
    r := RedisLPop(conn, "testkey");
    PrintLn("LPOP done");
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}