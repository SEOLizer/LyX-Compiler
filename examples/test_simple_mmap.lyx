// Simplest mmap test
import std.alloc;
fn main(): int64 {
    PrintLn("=== Simple mmap test ===");
    
    var buf: int64 := alloc(4096);
    Print("mmap = ");
    PrintLn(buf);
    
    Print("Before poke: ");
    PrintLn(peek8(buf));
    PrintLn("");
    
    poke8(buf, 65);
    
    Print("After poke: ");
    PrintLn(peek8(buf));
    PrintLn("");
    
    Print("After poke+1: ");
    PrintLn(peek8(buf + 1));
    PrintLn("");
    
    free(buf, 4096);
    PrintLn("Done");
    return 0;
}