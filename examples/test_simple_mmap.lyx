// Simplest mmap test
fn main(): int64 {
    PrintLn("=== Simple mmap test ===");
    
    var buf: int64 := mmap(0, 4096, 3, 34, -1, 0);
    Print("mmap = ");
    PrintLn(buf);
    
    Print("Before poke: ");
    PrintLn(peek8(buf));
    PrintLn("");
    
    poke8(buf, 65);
    
    Print("After poke: ");
    PrintLn(peek8(buf));
    PrintLn("");
    
    Print("After poke+1: ");
    PrintLn(peek8(buf + 1));
    PrintLn("");
    
    munmap(buf, 4096);
    PrintLn("Done");
    return 0;
}