// Test simpler: just add SADD after LPOP/RPOP
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    // Setup list and pop
    RedisDel(conn, "mylist");
    RedisLPush(conn, "mylist", "a");
    RedisLPush(conn, "mylist", "b");
    
    var r: RedisReply := RedisLPop(conn, "mylist");
    Print("LPOP done, kind=");
    PrintLn(r.kind);
    
    r := RedisRPop(conn, "mylist");
    Print("RPOP done, kind=");
    PrintLn(r.kind);
    
    // SADD after LPOP/RPOP - struct return
    r := RedisSAdd(conn, "myset", "apple");
    Print("SADD apple done, kind=");
    PrintLn(r.kind);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}