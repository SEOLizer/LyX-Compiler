// Test PING + 2x LPUSH + LPOP (all struct returns)
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    RedisDel(conn, "testlist");
    
    // 2x LPUSH (struct returns)
    var r: RedisReply := RedisLPush(conn, "testlist", "one");
    PrintLn("LPUSH one done");
    
    r := RedisLPush(conn, "testlist", "two");
    PrintLn("LPUSH two done");
    
    // LPOP (struct return)
    r := RedisLPop(conn, "testlist");
    Print("LPOP done, kind=");
    PrintLn(r.kind);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}