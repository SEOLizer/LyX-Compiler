// Bitwise Operators Demo
// Demonstrates: AND, OR, XOR, NOT, Shifts

fn main(): int64 {
    PrintLn("=== Bitwise Operators Demo ===\n");
    
    // AND
    PrintLn("AND (&) - Beide Bits muessen 1 sein");
    PrintLn("-----------------------------------");
    PrintLn("  0 & 0 = 0");
    PrintLn("  0 & 1 = 0");
    PrintLn("  1 & 0 = 0");
    PrintLn("  1 & 1 = 1");
    PrintLn("");
    PrintLn("Beispiel: 12 & 5 = 4");
    PrintLn("  12 = 1100");
    PrintLn("   5 = 0101");
    PrintLn("       ----");
    PrintLn("       0100 = 4");
    PrintLn("");
    
    // OR
    PrintLn("OR (|) - Mindestens ein Bit ist 1");
    PrintLn("-----------------------------------");
    PrintLn("  0 | 0 = 0");
    PrintLn("  0 | 1 = 1");
    PrintLn("  1 | 0 = 1");
    PrintLn("  1 | 1 = 1");
    PrintLn("");
    PrintLn("Beispiel: 12 | 5 = 13");
    PrintLn("  12 = 1100");
    PrintLn("   5 = 0101");
    PrintLn("       ----");
    PrintLn("       1101 = 13");
    PrintLn("");
    
    // XOR
    PrintLn("XOR (^) - Bits verschieden = 1");
    PrintLn("-----------------------------------");
    PrintLn("  0 ^ 0 = 0");
    PrintLn("  0 ^ 1 = 1");
    PrintLn("  1 ^ 0 = 1");
    PrintLn("  1 ^ 1 = 0");
    PrintLn("");
    PrintLn("Beispiel: 12 ^ 5 = 9");
    PrintLn("  12 = 1100");
    PrintLn("   5 = 0101");
    PrintLn("       ----");
    PrintLn("       1001 = 9");
    PrintLn("");
    
    // NOT
    PrintLn("NOT (~) - Bit umkehren");
    PrintLn("-----------------------------------");
    PrintLn("  ~0 = 1");
    PrintLn("  ~1 = 0");
    PrintLn("");
    PrintLn("Beispiel: ~5 (8-bit) = 250");
    PrintLn("  5 = 00000101");
    PrintLn("  ~5 = 11111010 = 250");
    PrintLn("");
    
    // Left Shift
    PrintLn("Left Shift (<<) - Nach links schieben");
    PrintLn("---------------------------------------");
    PrintLn("  x << n = x * 2^n");
    PrintLn("");
    PrintLn("Beispiel: 5 << 2 = 20");
    PrintLn("  5 = 00000101");
    PrintLn("  5 << 2 = 00010100 = 20");
    PrintLn("");
    PrintLn("  1 << 3 = 8 (2^3 = 8)");
    PrintLn("  1 << 0 = 1");
    PrintLn("");
    
    // Right Shift
    PrintLn("Right Shift (>>) - Nach rechts schieben");
    PrintLn("-----------------------------------------");
    PrintLn("  x >> n = x / 2^n (Integer-Division)");
    PrintLn("");
    PrintLn("Beispiel: 20 >> 2 = 5");
    PrintLn("  20 = 00010100");
    PrintLn("  20 >> 2 = 00000101 = 5");
    PrintLn("");
    PrintLn("  10 >> 1 = 5");
    PrintLn("  10 >> 2 = 2 (10/4 = 2)");
    
    PrintLn("\n=== Demo abgeschlossen ===");
    
    return 0;
}