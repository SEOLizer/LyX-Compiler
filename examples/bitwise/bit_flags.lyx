// Bit Flags Demo
// Demonstrates: Flags setzen, loeschen, pruefen, maskieren

fn main(): int64 {
    PrintLn("=== Bit Flags Demo ===\n");
    
    // Flags erklaeren
    PrintLn("Bit Flags - Flags als einzelne Bits speichern");
    PrintLn("---------------------------------------------");
    PrintLn("Ein 64-bit int64 kann bis zu 64 verschiedene Flags speichern.");
    PrintLn("");
    
    // Flag-Definitionen
    PrintLn("Flag-Definitionen:");
    PrintLn("------------------");
    var FLAG_READ: int64 := 1;     // Bit 0
    var FLAG_WRITE: int64 := 2;    // Bit 1
    var FLAG_EXEC: int64 := 4;     // Bit 2
    var FLAG_APPEND: int64 := 8;   // Bit 3
    var FLAG_SYNC: int64 := 16;    // Bit 4
    var FLAG_CREAT: int64 := 32;   // Bit 5
    var FLAG_TRUNC: int64 := 64;   // Bit 6
    var FLAG_DSYNC: int64 := 128;  // Bit 7
    
    Print("FLAG_READ   = ");
    PrintLn(FLAG_READ);
    PrintLn(" (1 << 0)");
    Print("FLAG_WRITE  = ");
    PrintLn(FLAG_WRITE);
    PrintLn(" (1 << 1)");
    Print("FLAG_EXEC   = ");
    PrintLn(FLAG_EXEC);
    PrintLn(" (1 << 2)");
    Print("FLAG_APPEND = ");
    PrintLn(FLAG_APPEND);
    PrintLn(" (1 << 3)");
    PrintLn("...");
    PrintLn("");
    
    // Flag setzen (OR)
    PrintLn("Flag setzen (OR mit Maske):");
    PrintLn("----------------------------");
    PrintLn("flags = flags | FLAG_WRITE");
    PrintLn("  00000000 | 00000010 = 00000010");
    PrintLn("");
    PrintLn("Beispiel: flags = 5 | 2 = 7");
    PrintLn("  5 =  00000101");
    PrintLn("  2 =  00000010");
    PrintLn("       --------");
    PrintLn("  7 =  00000111");
    PrintLn("");
    
    // Flag loeschen (AND mit NOT)
    PrintLn("Flag loeschen (AND mit ~Maske):");
    PrintLn("--------------------------------");
    PrintLn("flags = flags & ~FLAG_WRITE");
    PrintLn("  00000111 & 11111101 = 00000101");
    PrintLn("");
    PrintLn("Beispiel: flags = 7 & ~2 = 5");
    PrintLn("  7 =  00000111");
    PrintLn(" ~2 =  11111101");
    PrintLn("       --------");
    PrintLn("  5 =  00000101");
    PrintLn("");
    
    // Flag pruefen (AND)
    PrintLn("Flag pruefen (AND mit Maske):");
    PrintLn("-----------------------------");
    PrintLn("if (flags & FLAG_WRITE) != 0 { ... }");
    PrintLn("");
    PrintLn("Beispiel: 5 & 2 = 0 (nicht gesetzt)");
    PrintLn("  5 =  00000101");
    PrintLn("  2 =  00000010");
    PrintLn("       --------");
    PrintLn("  0 =  00000000");
    PrintLn("");
    PrintLn("Beispiel: 5 & 1 = 1 (gesetzt)");
    PrintLn("  5 =  00000101");
    PrintLn("  1 =  00000001");
    PrintLn("       --------");
    PrintLn("  1 =  00000001");
    PrintLn("");
    
    // Toggle (XOR)
    PrintLn("Flag toggeln (XOR mit Maske):");
    PrintLn("-----------------------------");
    PrintLn("flags = flags ^ FLAG_WRITE");
    PrintLn("");
    PrintLn("Beispiel: 5 ^ 2 = 7");
    PrintLn("  5 =  00000101");
    PrintLn("  2 =  00000010");
    PrintLn("       --------");
    PrintLn("  7 =  00000111");
    PrintLn("");
    PrintLn("Beispiel: 7 ^ 2 = 5");
    PrintLn("  7 =  00000111");
    PrintLn("  2 =  00000010");
    PrintLn("       --------");
    PrintLn("  5 =  00000101");
    PrintLn("");
    
    // Praktisches Beispiel
    PrintLn("Praktisches Beispiel: Datei-Modus");
    PrintLn("----------------------------------");
    var mode: int64 := 0;
    
    // O_RDONLY = 0, O_WRONLY = 1, O_RDWR = 2
    mode := 1; // O_WRONLY
    Print("O_WRONLY: ");
    PrintLn(mode);
    
    mode := mode | 64; // O_CREAT hinzufuegen
    Print("| O_CREAT (64): ");
    PrintLn(mode);
    
    mode := mode | 512; // O_TRUNC hinzufuegen
    Print("| O_TRUNC (512): ");
    PrintLn(mode);
    
    // Pruefen
    var has_creat: int64 := mode & 64;
    Print("\nO_CREAT gesetzt? ");
    if (has_creat != 0) { Print("Ja"); }
    else { Print("Nein"); }
    PrintLn("");
    
    var has_rdonly: int64 := mode & 1;
    Print("O_RDONLY gesetzt? ");
    if (has_rdonly != 0) { Print("Ja"); }
    else { Print("Nein"); }
    PrintLn("");
    
    PrintLn("\n=== Demo abgeschlossen ===");
    
    return 0;
}