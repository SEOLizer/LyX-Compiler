// Simple LDAP String Test

import std.net.ldap;
import std.io;

pub fn main(): int64 {
  var result: int64 := 0;
  
  // Test LDAPErrorToStr
  var errMsg: int64 := LDAPErrorToStr(0);
  if (errMsg != 0) {
    Print("LDAPErrorToStr(0): ");
    Print(errMsg);
    PrintLn("");
    result := result + 1;
  }
  
  // Test error message for invalid credentials
  errMsg := LDAPErrorToStr(49);
  if (errMsg != 0) {
    Print("LDAPErrorToStr(49): ");
    Print(errMsg);
    PrintLn("");
    result := result + 1;
  }
  
  Print("Basic tests passed: ");
  PrintIntLn(result);
  
  return 0;
}