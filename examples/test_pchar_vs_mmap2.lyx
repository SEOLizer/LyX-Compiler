// Test with pchar buffer instead of mmap
import std.db.redis;
import std.alloc;

fn main(): int64 {
    PrintLn("=== Test pchar buffer ===");
    
    // Manual setup
    var fd: int64 := sys_socket(2, 1, 0);
    var addr: int64 := alloc(16);
    poke8(addr, 2);
    poke8(addr + 1, 0);
    poke8(addr + 2, 0x18);
    poke8(addr + 3, 0xEB);
    poke8(addr + 4, 0x7F);
    poke8(addr + 5, 0);
    poke8(addr + 6, 0);
    poke8(addr + 7, 1);
    sys_connect(fd, addr, 16);
    free(addr, 16);
    
    PrintLn("Connected");
    
    // Send PING
    var reqbuf: int64 := alloc(64);
    var pos: int64 := 0;
    poke8(reqbuf + pos, 42); pos := pos + 1;
    poke8(reqbuf + pos, 49); pos := pos + 1;
    poke8(reqbuf + pos, 13); pos := pos + 1;
    poke8(reqbuf + pos, 10); pos := pos + 1;
    poke8(reqbuf + pos, 36); pos := pos + 1;
    poke8(reqbuf + pos, 52); pos := pos + 1;
    poke8(reqbuf + pos, 13); pos := pos + 1;
    poke8(reqbuf + pos, 10); pos := pos + 1;
    poke8(reqbuf + pos, 80); pos := pos + 1;
    poke8(reqbuf + pos, 73); pos := pos + 1;
    poke8(reqbuf + pos, 78); pos := pos + 1;
    poke8(reqbuf + pos, 71); pos := pos + 1;
    poke8(reqbuf + pos, 13); pos := pos + 1;
    poke8(reqbuf + pos, 10); pos := pos + 1;
    
    sys_write(fd, reqbuf, pos);
    free(reqbuf, 64);
    
    // Read into pchar buffer
    var pbuf: pchar := "                    ";
    var n: int64 := sys_read(fd, pbuf, 32);
    Print("pchar read n = ");
    PrintLn(n);
    Print(", buf = [");
    Print(pbuf);
    PrintLn("]");
    
    // Now read into mmap buffer
    var mbuf: int64 := alloc(64);
    n := sys_read(fd, mbuf, 64);
    Print("mmap read n = ");
    PrintLn(n);
    Print("\nbytes: ");
    var i: int64 := 0;
    while (i < n) {
        PrintLn(peek8(mbuf + i));
        Print(" ");
        i := i + 1;
    }
    PrintLn("");
    
    free(mbuf, 64);
    sys_close(fd);
    
    PrintLn("Done");
    return 0;
}