// test_logistic2.lyx - Test Logistic Regression with simpler data
import std.ml;

pub fn main(): int64 {
  // Very simple: x=0 -> 0, x=10 -> 1
  // Should learn threshold around x=5
  LogisticRegressionInit();
  
  // Higher learning rate, more epochs
LogisticRegressionFit(0.0, 10.0, 0.0, 1.0, 1.0, 5000);
  
  Print("Weight: ");
  PrintLn(LogisticRegressionWeight() as int64);
  Print("\nBias: ");
  PrintLn(LogisticRegressionBias() as int64);
  Print("\nLoss: ");
  PrintLn(LogisticRegressionLoss() as int64);
  Print("\nAcc: ");
  PrintLn(LogisticRegressionAccuracy() as int64);
  PrintLn("");
  
  // Test
  Print("P(0): ");
  PrintLn(LogisticRegressionPredictProb(0.0) as int64);
  Print("\nP(5): ");
  PrintLn(LogisticRegressionPredictProb(5.0) as int64);
  Print("\nP(10): ");
  PrintLn(LogisticRegressionPredictProb(10.0) as int64);
  PrintLn("\nDone");
  
  return 0;
}