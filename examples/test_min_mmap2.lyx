// Minimal test with early print
import std.alloc;
fn main(): int64 {
    PrintLn("start");
    var buf: int64 := alloc(64);
    PrintLn("after mmap");
    PrintLn(buf);
    poke8(buf, 65);
    PrintLn("after poke");
    var v: int64 := peek8(buf);
    PrintLn("after peek");
    PrintLn(v);
    free(buf, 64);
    PrintLn("after munmap");
    return 0;
}