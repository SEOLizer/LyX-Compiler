// Minimal test with early print
fn main(): int64 {
    PrintLn("start");
    var buf: int64 := mmap(0, 64, 3, 34, -1, 0);
    PrintLn("after mmap");
    PrintLn(buf);
    poke8(buf, 65);
    PrintLn("after poke");
    var v: int64 := peek8(buf);
    PrintLn("after peek");
    PrintLn(v);
    munmap(buf, 64);
    PrintLn("after munmap");
    return 0;
}