// Test PING + 2x LPUSH + LPOP + LPOP
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    RedisDel(conn, "testlist");
    
    var r: RedisReply := RedisLPush(conn, "testlist", "one");
    PrintLn("LPUSH one done");
    
    r := RedisLPush(conn, "testlist", "two");
    PrintLn("LPUSH two done");
    
    r := RedisLPop(conn, "testlist");
    Print("LPOP 1 done, kind=");
    PrintLn(r.kind);
    
    r := RedisLPop(conn, "testlist");
    Print("LPOP 2 done, kind=");
    PrintLn(r.kind);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}