// Test poke8 THEN peek16 after
import std.alloc;
fn main(): int64 {
    PrintLn("=== Test poke8 then peek16 ===");
    
    var buf: int64 := alloc(4096);
    Print("mmap = ");
    PrintLn(buf);
    
    // Just poke8
    poke8(buf, 65);
    PrintLn("Wrote 65");
    
    // Now peek16 (NOT peek8)
    var val: int64 := peek16(buf);
    Print("peek16 = ");
    PrintLn(val);
    
    free(buf, 4096);
    PrintLn("Done");
    return 0;
}