// Test poke8 THEN peek16 after
fn main(): int64 {
    PrintLn("=== Test poke8 then peek16 ===");
    
    var buf: int64 := mmap(0, 4096, 3, 34, -1, 0);
    Print("mmap = ");
    PrintLn(buf);
    
    // Just poke8
    poke8(buf, 65);
    PrintLn("Wrote 65");
    
    // Now peek16 (NOT peek8)
    var val: int64 := peek16(buf);
    Print("peek16 = ");
    PrintLn(val);
    
    munmap(buf, 4096);
    PrintLn("Done");
    return 0;
}