// Test PING then DEL
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    // PING first
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    // Then DEL
    var delres: int64 := RedisDel(conn, "nonexistent");
    Print("DEL result = ");
    PrintLn(delres);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}