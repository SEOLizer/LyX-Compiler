// Simple Redis SET/GET test - larger buffer
import std.net.socket;

fn main(): int64 {
    PrintLn("=== Redis SET/GET Debug ===");
    
    // Connect
    var conn: TCPConn := TCPConnect(0x7F000001, 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    // SET key
    var req: pchar := "*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n";
    var sent: int64 := TCPConnWrite(conn, req as pchar, 36);
    Print("SET sent: ");
    PrintLn(sent);
    
    // Use larger buffer for GET response
    var buf: pchar := "                                                                                                                                ";
    var n: int64 := TCPConnRead(conn, buf as pchar, 64);
    Print("SET response: [");
    Print(buf);
    PrintLn("]");
    
    // GET key
    req := "*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n";
    sent := TCPConnWrite(conn, req as pchar, 26);
    Print("GET sent: ");
    PrintLn(sent);
    
    // Read with larger buffer
    n := TCPConnRead(conn, buf as pchar, 64);
    Print("GET response: [");
    Print(buf);
    PrintLn("]");
    Print("GET n: ");
    PrintLn(n);
    
    TCPConnClose(conn);
    PrintLn("Done");
    
    return 0;
}