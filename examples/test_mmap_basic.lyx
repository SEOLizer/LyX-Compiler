// Test mmap basic functionality - no sockets
import std.alloc;
fn main(): int64 {
    PrintLn("=== Test mmap ===");
    
    // Allocate
    var addr: int64 := alloc(4096);
    Print("mmap returned: ");
    PrintLn(addr);
    
    if (addr <= 0) {
        PrintLn("mmap failed");
        return 1;
    }
    
    // Write
    PrintLn("Writing 65 to addr...");
    poke8(addr, 65);
    PrintLn("poke8 done");
    
    // Read
    var v: int64 := peek8(addr);
    Print("peek8 returned: ");
    PrintLn(v);
    
    if (v == 65) {
        PrintLn("SUCCESS!");
    } else {
        PrintLn("FAILED - expected 65");
    }
    
    // Write more
    poke8(addr + 1, 66);
    poke8(addr + 2, 67);
    
    // Read back
    var v2: int64 := peek8(addr + 1);
    var v3: int64 := peek8(addr + 2);
    Print("v2 = ");
    PrintLn(v2);
    Print(", v3 = ");
    PrintLn(v3);
    
    // Free
    free(addr, 4096);
    PrintLn("munmap done");
    
    return 0;
}