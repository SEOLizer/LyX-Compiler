// Test poke8 with variable value
fn main(): int64 {
    PrintLn("=== Test poke8 with variable ===");
    
    var buf: int64 := mmap(0, 4096, 3, 34, -1, 0);
    Print("mmap = ");
    PrintLn(buf);
    
    // Store value in variable first
    var val: int64 := 65;
    
    // Write using variable
    poke8(buf, val);
    PrintLn("Wrote via variable");
    
    // Read back
    var result: int64 := peek8(buf);
    Print("peek8 = ");
    PrintLn(result);
    
    // Test with constant
    poke8(buf + 1, 66);
    var result2: int64 := peek8(buf + 1);
    Print("peek8+1 = ");
    PrintLn(result2);
    
    munmap(buf, 4096);
    PrintLn("Done");
    return 0;
}