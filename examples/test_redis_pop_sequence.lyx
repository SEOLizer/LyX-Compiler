// Test where crash happens after LPOP
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    RedisDel(conn, "mylist");
    
    // 3x LPUSH
    var r: RedisReply := RedisLPush(conn, "mylist", "first");
    PrintLn("LPUSH first done");
    
    r := RedisLPush(conn, "mylist", "second");
    PrintLn("LPUSH second done");
    
    r := RedisLPush(conn, "mylist", "third");
    PrintLn("LPUSH third done");
    
    // LLEN
    var llen: int64 := RedisLLen(conn, "mylist");
    Print("LLEN = ");
    PrintLn(llen);
    
    // FIRST LPOP
    r := RedisLPop(conn, "mylist");
    Print("LPOP 1 done, kind=");
    PrintLn(r.kind);
    Print(" str_len=");
    PrintLn(r.str_len);
    
    // SECOND LPOP - this is where it might crash
    r := RedisLPop(conn, "mylist");
    Print("LPOP 2 done, kind=");
    PrintLn(r.kind);
    Print(" str_len=");
    PrintLn(r.str_len);
    
    // Third LPOP
    r := RedisLPop(conn, "mylist");
    Print("LPOP 3 done, kind=");
    PrintLn(r.kind);
    Print(" str_len=");
    PrintLn(r.str_len);
    
    // Fourth LPOP on empty list
    r := RedisLPop(conn, "mylist");
    Print("LPOP 4 (empty) done, kind=");
    PrintLn(r.kind);
    
    // Try LLEN after all pops
    llen := RedisLLen(conn, "mylist");
    Print("LLEN after all pops = ");
    PrintLn(llen);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}