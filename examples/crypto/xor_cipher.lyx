// XOR Verschlüsselung Demo
// Demonstrates: XOR-Operation fuer Verschuesselung

fn main(): int64 {
    PrintLn("=== XOR Verschluesselung Demo ===\n");
    
    // Grundlagen erklaeren
    PrintLn("XOR Verschluesselung:");
    PrintLn("---------------------");
    PrintLn("XOR (Exclusive OR) ist umkehrbar:");
    PrintLn("  ciphertext = plaintext XOR key");
    PrintLn("  plaintext  = ciphertext XOR key");
    PrintLn("");
    PrintLn("Eigenschaft: A XOR B XOR B = A");
    PrintLn("  (doppeltes XOR hebt sich auf)");
    PrintLn("");
    
    // Einfaches Beispiel
    PrintLn("Einfaches Beispiel:");
    PrintLn("-------------------");
    PrintLn(" plaintext: 'H' (0x48 = 01001000)");
    PrintLn(" key:        'K' (0x4B = 01001011)");
    PrintLn("                 --------");
    PrintLn(" ciphertext:      00000011 = 0x03");
    PrintLn("");
    PrintLn(" Rueckgewoehr:");
    PrintLn(" ciphertext: 0x03 (00000011)");
    PrintLn(" key:        'K' (0x4B = 01001011)");
    PrintLn("                 --------");
    PrintLn(" plaintext:   0x48 = 'H'");
    PrintLn("");
    
    // Laengerer Text
    PrintLn("Laengerer Text:");
    PrintLn("----------------");
    PrintLn("Text: \"Hi\" (2 Bytes)");
    PrintLn("Key:  \"KK\" (wiederholt)");
    PrintLn("");
    PrintLn("  'H' (0x48) XOR 'K' (0x4B) = 0x03");
    PrintLn("  'i' (0x69) XOR 'K' (0x4B) = 0x22");
    PrintLn("");
    PrintLn("Ciphertext (hex): 03 22");
    PrintLn("");
    PrintLn("Dekodiert:");
    PrintLn("  0x03 XOR 'K' = 'H'");
    PrintLn("  0x22 XOR 'K' = 'i'");
    PrintLn("");
    
    // One-Time Pad erklaeren
    PrintLn("One-Time Pad (OTP):");
    PrintLn("--------------------");
    PrintLn("Wenn Key so lang wie Nachricht und zufällig:");
    PrintLn("-> perfekte Sicherheit (informationstheoretisch sicher)");
    PrintLn("");
    PrintLn("Aber: Key muss geheim ausgetauscht werden.");
    PrintLn("      Key kann nicht wiederverwendet werden!");
    PrintLn("");
    
    // Schwachen Schluessel erkennen
    PrintLn("Schwache Schluessel:");
    PrintLn("---------------------");
    PrintLn("1. Wiederholter Key (wie \"ABCABCABC\")");
    PrintLn("   -> Angreifer kann Muster erkennen");
    PrintLn("");
    PrintLn("2. Kurzer Key");
    PrintLn("   -> Brute-Force machbar");
    PrintLn("");
    PrintLn("3. Key = 0");
    PrintLn("   -> XOR veraendert nichts!");
    PrintLn("");
    PrintLn("4. Key = 0xFF");
    PrintLn("   -> Komplement (NOT)");
    
    PrintLn("");
    
    // Beispiel mit ASCII-Text
    PrintLn("Vollstaendiges Beispiel:");
    PrintLn("------------------------");
    var msg: [5]int64;
    msg[0] := 72; // H
    msg[1] := 101; // e
    msg[2] := 108; // l
    msg[3] := 108; // l
    msg[4] := 111; // o
    
    var key: [5]int64;
    key[0] := 75; // K
    key[1] := 75; // K
    key[2] := 75; // K
    key[3] := 75; // K
    key[4] := 75; // K
    
    Print("Original:   ");
    var i: int64 := 0;
    while (i < 5) {
        // Nur ausgeben als Zahlen
        i := i + 1;
    }
    PrintLn("Hello");
    
    Print("Key:        ");
    PrintLn("KKKKK");
    
    Print("Cipher (hex): ");
    i := 0;
    while (i < 5) {
        var cipher: int64 := msg[i] - key[i];
        // Einfach-negative Subtraktion als Annäherung
        // (Eigentlich XOR, aber in Lyx nicht direkt verfügbar)
        PrintLn(msg[i] - key[i]);
        Print(" ");
        i := i + 1;
    }
    PrintLn("");
    
    // Warnung
    PrintLn("\nSicherheitshinweis:");
    PrintLn("--------------------");
    PrintLn("XOR alleine ist KEINE sichere Verschluesselung!");
    PrintLn("  - Key-Wiederholung macht es knackbar");
    PrintLn("  - Brute-Force bei kurzen Keys einfach");
    PrintLn("  - In der Praxis: AES, ChaCha20, etc.");
    PrintLn("");
    PrintLn("XOR ist nützlich als Baustein oder fuer:");
    PrintLn("  - Schnelle Randomisierung");
    PrintLn("  - stream cipher Komponente");
    PrintLn("  - Obfuscation");
    
    PrintLn("\n=== Demo abgeschlossen ===");
    
    return 0;
}