// Base64 Encoding Demo
// Demonstrates: Base64-Kodierung und Dekodierung

fn main(): int64 {
    PrintLn("=== Base64 Encoding Demo ===\n");
    
    // Grundlagen erklaeren
    PrintLn("Base64 Grundlagen:");
    PrintLn("------------------");
    PrintLn("Base64 kodiert 3 Bytes (24 Bits) zu 4 Zeichen (24 Bits).");
    PrintLn("Zeichensatz: A-Z, a-z, 0-9, +, / (64 Zeichen)");
    PrintLn("Padding: = oder == am Ende falls noetig");
    PrintLn("");
    
    // Umrechnungstabelle
    PrintLn("Base64 Tabelle:");
    PrintLn("---------------");
    PrintLn("0-25:  A-Z");
    PrintLn("26-51: a-z");
    PrintLn("52-61: 0-9");
    PrintLn("62:    +");
    PrintLn("63:    /");
    PrintLn("");
    
    // Beispiel 1: 1 Byte
    PrintLn("Beispiel 1: 'M' (1 Byte)");
    PrintLn("-------------------------");
    PrintLn("  'M' = 0x4D = 01001101 (8 Bits)");
    PrintLn("  Auf 24 Bits auffuellen: 01001101 00000000 00000000");
    PrintLn("  In 6-Bit Gruppen: 010011 010000 000000 000000");
    PrintLn("  Dezimal: 19, 16, 0, 0");
    PrintLn("  Base64:  T, Q, A, A");
    PrintLn("  Ergebnis: 'TQ=='");
    PrintLn("");
    
    // Beispiel 2: 2 Bytes
    PrintLn("Beispiel 2: 'Ma' (2 Bytes)");
    PrintLn("---------------------------");
    PrintLn("  'M' = 0x4D = 01001101");
    PrintLn("  'a' = 0x61 = 01100001");
    PrintLn("  Kombiniert: 01001101 01100001 00000000");
    PrintLn("  6-Bit Gruppen: 010011 010110 000100 000000");
    PrintLn("  Dezimal: 19, 22, 4, 0");
    PrintLn("  Base64:  T, W, E, A");
    PrintLn("  Ergebnis: 'TWE='");
    PrintLn("");
    
    // Beispiel 3: 3 Bytes
    PrintLn("Beispiel 3: 'Man' (3 Bytes)");
    PrintLn("---------------------------");
    PrintLn("  'M' = 0x4D = 01001101");
    PrintLn("  'a' = 0x61 = 01100001");
    PrintLn("  'n' = 0x6E = 01101110");
    PrintLn("  Kombiniert: 01001101 01100001 01101110");
    PrintLn("  6-Bit Gruppen: 010011 010110 000101 101110");
    PrintLn("  Dezimal: 19, 22, 5, 46");
    PrintLn("  Base64:  T, W, F, u");
    PrintLn("  Ergebnis: 'TWFu'");
    PrintLn("");
    
    // Praxisanwendung
    PrintLn("Praxisanwendungen:");
    PrintLn("------------------");
    PrintLn("1. E-Mail (MIME): Binärdateien in Text umwandeln");
    PrintLn("2. HTTP Basic Auth: user:pass -> base64 -> Header");
    PrintLn("3. Data URLs: data:image/png;base64,...");
    PrintLn("4. JSON/APIs: Binärdaten in JSON-Strukturen");
    PrintLn("");
    
    // Dekodierung erklaeren
    PrintLn("Dekodierung:");
    PrintLn("-------------");
    PrintLn("1. Base64 Zeichen zu 6-Bit-Werten konvertieren");
    PrintLn("2. 4 Zeichen zu 3 Bytes kombinieren");
    PrintLn("3. Padding '=' entfernen");
    PrintLn("");
    PrintLn("Beispiel: 'TWFu' -> 'Man'");
    PrintLn("  T=19 -> 010011");
    PrintLn("  W=22 -> 010110");
    PrintLn("  F=5  -> 000101");
    PrintLn("  u=46 -> 101110");
    PrintLn("  Zusammen: 01001101 01100001 01101110");
    PrintLn("  = 'Man'");
    
    PrintLn("\n=== Demo abgeschlossen ===");
    
    return 0;
}