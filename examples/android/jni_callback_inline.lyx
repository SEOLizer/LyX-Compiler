// WP-AND-upstream demo: a @jni-callable Lyx function that calls BACK into
// the Java side via the JNIEnv vtable -- using inline _indirect_call_N
// rather than the std/android/jni.lyx wrapper functions.
//
// The wrapper functions in std/android/jni.lyx (JNI_NewStringUTF etc.)
// compile correctly, but the current ir_lower.lyx cannot lower a
// regular Lyx function CALL to a user-defined function in the same
// translation unit chain: it falls through to a broken IRO_CALL_BUILTIN
// dispatch. Until that path lands, write JNI callbacks inline as below.
//
// The mechanism: peek the JNIEnv vtable, load the slot for the function
// we want, and call through it with _indirect_call_N. AArch64 only.

import std.android.jni;

@jni(class="com.example.MyClass", method="nativeJNIVersion")
fn nativeJNIVersion(env: JNIEnv, thiz: jobject): jint {
  // env is a JNIEnv*, i.e. a pointer to a vtable pointer. Dereference once
  // to get the JNINativeInterface vtable, load slot 4 (GetVersion), call.
  var vtable: int64 := peek64(env);
  var fnPtr:  int64 := peek64(vtable + JNI_SLOT_GetVersion * 8);
  return _indirect_call_1(fnPtr, env);
}

@jni(class="com.example.MyClass", method="nativeGreet")
fn nativeGreet(env: JNIEnv, thiz: jobject): jstring {
  // Call NewStringUTF(env, "Hello from Lyx!") via inline vtable lookup.
  var msg:    pchar := "Hello from Lyx!"c;
  var vtable: int64 := peek64(env);
  var fnPtr:  int64 := peek64(vtable + JNI_SLOT_NewStringUTF * 8);
  return _indirect_call_2(fnPtr, env, msg as int64);
}

fn main(): int64 { return 0; }
