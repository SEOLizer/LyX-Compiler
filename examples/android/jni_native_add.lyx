// WP-AND-05 example: a JNI-callable pure-compute function.
//
// Build:
//   lyxc --target=android-arm64 --shared --android-api=26 \
//        examples/android/jni_native_add.lyx -o libnative_add.so
//
// Use from Kotlin / Java:
//   package com.example;
//   class MyClass {
//       init { System.loadLibrary("native_add") }
//       external fun nativeAdd(a: Long, b: Long): Long
//       external fun nativeMul(a: Long, b: Long): Long
//   }
//
// readelf -D --syms -W libnative_add.so confirms:
//   Java_com_example_MyClass_nativeAdd  FUNC GLOBAL
//   Java_com_example_MyClass_nativeMul  FUNC GLOBAL

import std.android.jni;

// The two leading parameters (env, thiz) are the JNI convention; Kotlin/Java
// supplies them automatically. They are unused here because this is a
// pure-compute function — see the upstream-blocker note in work/android.md
// for status of JNIEnv-vtable helpers.

@jni(class="com.example.MyClass", method="nativeAdd")
fn nativeAdd(env: JNIEnv, thiz: jobject, a: jlong, b: jlong): jlong {
  return a + b;
}

@jni(class="com.example.MyClass", method="nativeMul")
fn nativeMul(env: JNIEnv, thiz: jobject, a: jlong, b: jlong): jlong {
  return a * b;
}

// A non-@jni helper stays internal (not exported, no Java_ mangling).
fn shiftLeft(v: jlong, n: jlong): jlong {
  return v * 2;   // placeholder — Lyx `<<` lowering is target-dependent
}

@jni(class="com.example.MyClass", method="nativeDouble")
fn nativeDouble(env: JNIEnv, thiz: jobject, a: jlong): jlong {
  return shiftLeft(a, 1);
}

fn main(): int64 { return 0; }
