// WP-AND-08 demo: assemble an UNSIGNED APK from synthetic blobs.
// Hardcodes input bytes because the current bootstrap's GetArgC/GetArg
// builtins are stubs (argv not saved at startup yet); a real toolchain
// invocation would read the AXML and Dex from disk after running
// aapt2 / d8.
//
//   ./lyxc examples/android/build_apk_demo.lyx -o /tmp/build_apk_demo
//   /tmp/build_apk_demo
//   unzip -l /tmp/demo.unsigned.apk
//
// Expected entries:
//   AndroidManifest.xml      (placeholder bytes here)
//   classes.dex              (placeholder bytes here)
//   lib/arm64-v8a/libdemo.so (placeholder bytes here)
//
// Real pipeline: replace the three placeholder buffers with aapt2-compiled
// AXML, d8-compiled dex, and a real Lyx --shared .so, then sign with
// `apksigner sign --ks debug.keystore ...`.

import std.android.apk_builder;
import std.io;
import std.fs;

fn _fill(buf: int64, len: int64, byte: int64): void {
  var i: int64 := 0;
  while i < len {
    poke8(buf + i, byte);
    i := i + 1;
  }
}

fn main(): int64 {
  // Synthetic AXML / DEX / SO. Real inputs come from aapt2 / d8 / lyxc.
  var axmlLen: int64 := 128;
  var dexLen:  int64 := 256;
  var soLen:   int64 := 512;
  var axml: int64 := mmap(0, axmlLen, 3, 34, -1, 0);
  var dex:  int64 := mmap(0, dexLen,  3, 34, -1, 0);
  var so:   int64 := mmap(0, soLen,   3, 34, -1, 0);
  _fill(axml, axmlLen, 65);   // 'A'
  _fill(dex,  dexLen,  68);   // 'D'
  _fill(so,   soLen,   83);   // 'S'

  var apk: ApkBuilder := new ApkBuilder();
  apk.Init();
  apk.AddAxmlManifest(axml, axmlLen);
  apk.AddDexStub(dex, dexLen);
  apk.AddSharedLib(APK_ARCH_ARM64, "demo"c, so, soLen);
  apk.Finalize();

  var apkBuf: int64 := apk.GetBuf();
  var apkLen: int64 := apk.GetLen();

  var rc: int64 := WriteFile("/tmp/demo.unsigned.apk"c, apkBuf as pchar, apkLen);
  if rc < 0 {
    EPrintStrLn("error: cannot write /tmp/demo.unsigned.apk");
    return 1;
  }

  PrintStrLn("wrote /tmp/demo.unsigned.apk"c);
  PrintStrLn("verify with: unzip -l /tmp/demo.unsigned.apk"c);
  return 0;
}
