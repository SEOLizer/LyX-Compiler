// WP-AND-upstream-fix v2 demo: @jni callback using a LOCAL helper that
// wraps the JNIEnv-vtable indirect call. The wrapper is defined in the
// same translation unit as the caller, so ir_lower's user-function-call
// lookup finds it.
//
// (When ir_lower learns to walk NK_IMPORT bodies into the same IR module,
// you'll be able to just `import std.android.jni` and call JNI_NewStringUTF
// directly. Until then, keep the helper local — or use the fully-inline
// pattern shown in jni_callback_inline.lyx.)

con JNI_SLOT_NewStringUTF: int64 := 167;
con JNI_SLOT_GetVersion:   int64 :=   4;

fn LocalNewStringUTF(env: int64, str: pchar): int64 {
  var vtable: int64 := peek64(env);
  var fnPtr:  int64 := peek64(vtable + JNI_SLOT_NewStringUTF * 8);
  return _indirect_call_2(fnPtr, env, str as int64);
}

fn LocalGetVersion(env: int64): int64 {
  var vtable: int64 := peek64(env);
  var fnPtr:  int64 := peek64(vtable + JNI_SLOT_GetVersion * 8);
  return _indirect_call_1(fnPtr, env);
}

@jni(class="com.example.MyClass", method="nativeGreet")
fn nativeGreet(env: int64, thiz: int64): int64 {
  return LocalNewStringUTF(env, "Hello from Lyx (via local wrapper)!"c);
}

@jni(class="com.example.MyClass", method="nativeJNIVersion")
fn nativeJNIVersion(env: int64, thiz: int64): int64 {
  return LocalGetVersion(env);
}

fn main(): int64 { return 0; }
