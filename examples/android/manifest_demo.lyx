// WP-AND-07 example: emit an AndroidManifest.xml from Lyx.
//
//   ./lyxc examples/android/manifest_demo.lyx -o /tmp/manifest_demo
//   /tmp/manifest_demo > /tmp/AndroidManifest.xml
//   cat /tmp/AndroidManifest.xml

import std.io;
import std.android.manifest_gen;

fn main(): int64 {
  var xml: pchar := GenerateNativeActivityManifestDefault(
    "com.example.lyxapp"c,
    "Lyx Demo"c,
    "lyxapp"c
  );
  PrintStr(xml);
  return 0;
}
