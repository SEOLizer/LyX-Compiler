// Test PING + LPUSH + LLEN + LPOP
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    RedisDel(conn, "testlist");
    
    // Just LPUSH - returns RedisReply struct
    var r: RedisReply := RedisLPush(conn, "testlist", "one");
    Print("LPUSH done, kind=");
    PrintLn(r.kind);
    
    // LLEN - returns int64
    var llen: int64 := RedisLLen(conn, "testlist");
    Print("LLEN = ");
    PrintLn(llen);
    
    // LPOP - returns RedisReply struct (bulk string)
    r := RedisLPop(conn, "testlist");
    Print("LPOP kind=");
    PrintLn(r.kind);
    Print(" str_len=");
    PrintLn(r.str_len);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}