// Use integer pointer instead of pchar
import std.alloc;
fn main(): int64 {
    PrintLn("=== Test with int64 pointer ===");
    
    var fd: int64 := sys_socket(2, 1, 0);
    Print("socket = ");
    PrintLn(fd);
    
    var addr: int64 := alloc(16);
    poke8(addr, 2);
    poke8(addr + 2, 0x18);
    poke8(addr + 3, 0xEB);
    poke8(addr + 4, 0x7F);
    poke8(addr + 5, 0);
    poke8(addr + 6, 0);
    poke8(addr + 7, 1);
    
    sys_connect(fd, addr, 16);
    free(addr, 16);
    
    PrintLn("connected");
    
    var req: pchar := "*1\r\n$4\r\nPING\r\n";
    sys_write(fd, req, 18);
    
    // Allocate buffer and convert to int64
    var buf: int64 := alloc(64);
    Print("buf = ");
    PrintLn(buf);
    
    // First read
    var n: int64 := sys_read(fd, buf, 32);
    Print("read1 = ");
    PrintLn(n);
    
    // Second read
    sys_write(fd, req, 18);
    PrintLn("write2 done");
    
    n := sys_read(fd, buf, 32);
    Print("read2 = ");
    PrintLn(n);
    
    sys_close(fd);
    free(buf, 64);
    return 0;
}