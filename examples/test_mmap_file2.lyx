// Test mmap with a simple file write/read cycle
import std.fs;
import std.alloc;

fn main(): int64 {
    PrintLn("=== Test mmap with file ===");
    
    // Create file
    var fd: int64 := open("/tmp/mmap_test.txt", 65, 384);  // O_WRONLY|O_CREAT
    if (fd < 0) {
        PrintLn("open failed");
        return 1;
    }
    PrintLn("file opened");
    
    // mmap a buffer
    var buf: int64 := alloc(64);
    Print("mmap = ");
    PrintLn(buf);
    
    // Write to mmap
    poke8(buf, 65);  // 'A'
    poke8(buf + 1, 66);  // 'B'
    poke8(buf + 2, 67);  // 'C'
    PrintLn("wrote ABC to mmap");
    
    // Write mmap content to file
    var n: int64 := write(fd, buf, 3);
    Print("wrote to file: ");
    PrintLn(n);
    
    // Close and reopen
    close(fd);
    fd := open("/tmp/mmap_test.txt", 0, 0);  // O_RDONLY
    
    // Read file into mmap
    n := read(fd, buf, 64);
    Print("read from file: ");
    PrintLn(n);
    
    // Check what we read
    var v1: int64 := peek8(buf);
    var v2: int64 := peek8(buf + 1);
    var v3: int64 := peek8(buf + 2);
    Print("read: ");
    PrintLn(v1);
    Print(" ");
    PrintLn(v2);
    Print(" ");
    PrintLn(v3);
    
    close(fd);
    free(buf, 64);
    PrintLn("done");
    
    return 0;
}