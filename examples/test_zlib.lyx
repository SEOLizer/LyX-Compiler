// Test zlib compression and decompression roundtrip
import std.zlib;
import std.alloc;

fn main(): int64 {
    // Test data - simple string
    var test_data: pchar := "Hello World! This is a test of zlib compression and decompression.";
    var data_len: int64 := 0;
    var i: int64 := 0;
    while (StrCharAt(test_data, i) != 0) {
        data_len := data_len + 1;
        i := i + 1;
    }
    
    PrintLn("=== Zlib Roundtrip Test ===");
    Print("Original length: ");
    PrintLn(data_len);
    
    // Calculate Adler-32 of original
    var adler_orig: int64 := Adler32(test_data, data_len);
    Print("Original Adler32: ");
    PrintLn(adler_orig);
    
    // Use stored block compression (DeflateCompress) - simpler than LZ77
    var comp_size: int64 := data_len + 100;
    var comp_buf: int64 := malloc(comp_size);
    
    if (comp_buf == 0) {
        PrintLn("ERROR: Failed to allocate compression buffer");
        return 1;
    }
    
    Print("Compression buffer size: ");
    PrintLn(comp_size);
    
    // Compress using stored blocks (no LZ77 for simpler testing)
    var actual_comp: int64 := DeflateCompress(test_data as pchar, data_len, comp_buf as pchar);
    
    if (actual_comp <= 0) {
        PrintLn("ERROR: Compression failed");
        free_mem(comp_buf);   // #1264: zu `malloc` gehoert `free_mem` (ein Argument); `free` nimmt Adresse UND Groesse
        return 1;
    }
    
    Print("Compressed size: ");
    PrintLn(actual_comp);
    
    // Allocate decompression buffer (original size is safe upper bound)
    var decomp_buf: int64 := malloc(data_len + 100);
    
    if (decomp_buf == 0) {
        PrintLn("ERROR: Failed to allocate decompression buffer");
        free_mem(comp_buf);   // #1264: zu `malloc` gehoert `free_mem` (ein Argument); `free` nimmt Adresse UND Groesse
        return 1;
    }
    
    // Decompress using InflateDEFLATE (note: stored block decompression)
    var actual_decomp: int64 := InflateDEFLATE(comp_buf as pchar, actual_comp, decomp_buf as pchar);
    
    if (actual_decomp <= 0) {
        PrintLn("ERROR: Decompression failed");
        Print("actual_decomp = ");
        PrintLn(actual_decomp);
        free_mem(comp_buf);   // #1264: zu `malloc` gehoert `free_mem` (ein Argument); `free` nimmt Adresse UND Groesse
        free_mem(decomp_buf);   // #1264: zu `malloc` gehoert `free_mem` (ein Argument); `free` nimmt Adresse UND Groesse
        return 1;
    }
    
    Print("Decompressed size: ");
    PrintLn(actual_decomp);
    
    // Verify size matches
    if (actual_decomp != data_len) {
        PrintLn("ERROR: Decompressed size mismatch!");
        free_mem(comp_buf);   // #1264: zu `malloc` gehoert `free_mem` (ein Argument); `free` nimmt Adresse UND Groesse
        free_mem(decomp_buf);   // #1264: zu `malloc` gehoert `free_mem` (ein Argument); `free` nimmt Adresse UND Groesse
        return 1;
    }
    
    PrintLn("=== Test Complete ===");
    PrintLn("Roundtrip successful!");
    
    // Cleanup
    free_mem(comp_buf);   // #1264: zu `malloc` gehoert `free_mem` (ein Argument); `free` nimmt Adresse UND Groesse
    free_mem(decomp_buf);   // #1264: zu `malloc` gehoert `free_mem` (ein Argument); `free` nimmt Adresse UND Groesse
    
    return 0;
}