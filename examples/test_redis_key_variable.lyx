// Same test but pass key as variable
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    }
    
    var key: pchar := "mylist";
    
    var r: RedisReply := RedisLPush(conn, key, "a");
    PrintLn("LPUSH1 done");
    
    r := RedisLPush(conn, key, "b");
    PrintLn("LPUSH2 done");
    
    r := RedisLPop(conn, key);
    PrintLn("LPOP1 done");
    
    r := RedisLPop(conn, key);
    PrintLn("LPOP2 done");
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}