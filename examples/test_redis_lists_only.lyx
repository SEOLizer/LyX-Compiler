// Simple test - just Lists
import std.db.redis;

fn main(): int64 {
    PrintLn("=== Redis List Test ===");
    
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) { return 1; }
    PrintLn("Connected");
    
    // Clean up
    RedisDel(conn, "testlist");
    
    // LPUSH
    var r: RedisReply := RedisLPush(conn, "testlist", "first");
    Print("LPUSH: kind=");
    PrintLn(r.kind);
    Print(" int_val=");
    PrintLn(r.int_val);
    
    // RPUSH
    r := RedisRPush(conn, "testlist", "last");
    Print("RPUSH: kind=");
    PrintLn(r.kind);
    
    // LLEN
    var len: int64 := RedisLLen(conn, "testlist");
    Print("LLEN: ");
    PrintLn(len);
    
    // LRANGE
    r := RedisLRange(conn, "testlist", 0, -1);
    Print("LRANGE: kind=");
    PrintLn(r.kind);
    Print(" len=");
    PrintLn(r.str_len);
    
    // LPOP
    r := RedisLPop(conn, "testlist");
    Print("LPOP: kind=");
    PrintLn(r.kind);
    
    // RPOP
    r := RedisRPop(conn, "testlist");
    Print("RPOP: kind=");
    PrintLn(r.kind);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}