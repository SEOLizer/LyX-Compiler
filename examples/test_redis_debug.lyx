// Minimal Redis test - debug syscalls
import std.net.socket;
import std.alloc;

fn main(): int64 {
    PrintLn("1. Starting");
    
    // Create socket
    var fd: int64 := sys_socket(2, 1, 0);  // AF_INET, SOCK_STREAM
    Print("2. socket fd = ");
    PrintLn(fd);
    
    if (fd < 0) {
        PrintLn("socket failed");
        return 1;
    }
    
    PrintLn("3. Creating sockaddr");
    var addr: int64 := alloc(16);
    Print("4. mmap addr = ");
    PrintLn(addr);
    
    if (addr <= 0) {
        PrintLn("mmap failed");
        sys_close(fd);
        return 1;
    }
    
    // Fill sockaddr_in: 127.0.0.1:6379
    poke8(addr, 2);           // sin_family = AF_INET (2)
    poke8(addr + 2, 0x18);     // port high byte (6379 = 0x18EB)
    poke8(addr + 3, 0xEB);     // port low byte
    poke8(addr + 4, 0x7F);    // IP first byte (127)
    poke8(addr + 5, 0);       // IP second byte
    poke8(addr + 6, 0);       // IP third byte  
    poke8(addr + 7, 1);       // IP fourth byte (1)
    
    PrintLn("5. Calling connect");
    var result: int64 := sys_connect(fd, addr, 16);
    Print("6. connect result = ");
    PrintLn(result);
    
    free(addr, 16);
    
    if (result < 0) {
        PrintLn("connect failed");
        sys_close(fd);
        return 1;
    }
    
    PrintLn("7. Connected! Now writing...");
    
    // Write PING
    var req: pchar := "*1\r\n$4\r\nPING\r\n";
    var sent: int64 := sys_write(fd, req, 18);
    Print("8. write result = ");
    PrintLn(sent);
    
    if (sent <= 0) {
        PrintLn("write failed");
        sys_close(fd);
        return 1;
    }
    
    PrintLn("9. Reading response...");
    
    // Read response
    var buf: pchar := "                        ";
    var n: int64 := sys_read(fd, buf, 32);
    Print("10. read n = ");
    PrintLn(n);
    Print("\nResponse: [");
    Print(buf);
    PrintLn("]");
    
    sys_close(fd);
    PrintLn("11. Done");
    
    return 0;
}