// Minimal test for Redis library
import std.db.redis;

fn main(): int64 {
    PrintLn("=== Test Redis ===");
    
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    Print("conn.fd = ");
    PrintLn(conn.fd);
    
    if (conn.fd < 0) {
        PrintLn("connect failed");
        return 1;
    }
    
    PrintLn("connected, now pinging...");
    var ok: bool := RedisPing(conn);
    Print("ping result = ");
    PrintLn(ok as int64);
    
    RedisClose(conn);
    PrintLn("done");
    return 0;
}