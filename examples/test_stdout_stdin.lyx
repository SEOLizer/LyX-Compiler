// Test with stdout as sanity check
fn main(): int64 {
    PrintLn("=== Test stdout write ===");
    
    var buf: pchar := "ABCDEFGHIJ";
    var n: int64 := sys_write(1, buf, 10);  // Write to stdout
    Print("\nWrote ");
    PrintLn(n);
    PrintLn(" bytes to stdout");
    
    // Now read from stdin
    PrintLn("=== Test stdin read ===");
    PrintLn("Enter some text:");
    
    var readbuf: pchar := "                    ";
    var rn: int64 := sys_read(0, readbuf, 10);  // Read from stdin
    Print("Read ");
    PrintLn(rn);
    Print(" bytes: [");
    Print(readbuf);
    PrintLn("]");
    
    return 0;
}