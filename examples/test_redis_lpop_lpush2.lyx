// Test simpler: just LPOP then another LPUSH (different key)
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    RedisDel(conn, "mylist");
    RedisLPush(conn, "mylist", "a");
    RedisLPush(conn, "mylist", "b");
    
    var r: RedisReply := RedisLPop(conn, "mylist");
    PrintLn("LPOP done");
    
    // Another LPUSH with different key
    r := RedisLPush(conn, "mylist2", "x");
    PrintLn("LPUSH2 done");
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}