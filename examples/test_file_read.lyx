// Test with a file instead of socket
import std.fs;

fn main(): int64 {
    PrintLn("=== Test with file ===");
    
    // Create a test file
    var fd: int64 := sys_open("/tmp/testfile.txt", 65, 384);  // O_WRONLY|O_CREAT, 0600
    if (fd < 0) { 
        PrintLn("open failed"); 
        return 1; 
    }
    PrintLn("File opened for writing");
    
    // Write test data
    var data: pchar := "Line 1\nLine 2\nLine 3\n";
    var n: int64 := sys_write(fd, data, 18);
    Print("Wrote ");
    PrintLn(n);
    PrintLn(" bytes");
    
    sys_close(fd);
    PrintLn("Closed file");
    
    // Now open for reading
    fd := sys_open("/tmp/testfile.txt", 0, 0);  // O_RDONLY
    if (fd < 0) { 
        PrintLn("open for read failed"); 
        return 1; 
    }
    PrintLn("File opened for reading");
    
    var buf: pchar := "                    ";
    
    // First read
    n := sys_read(fd, buf, 32);
    Print("First read n = ");
    PrintLn(n);
    Print(", buf = [");
    Print(buf);
    PrintLn("]");
    
    // Second read
    n := sys_read(fd, buf, 32);
    Print("Second read n = ");
    PrintLn(n);
    Print(", buf = [");
    Print(buf);
    PrintLn("]");
    
    sys_close(fd);
    PrintLn("Done");
    
    return 0;
}