// examples/math/matrix3d.lyx
// std.matrix: eine vollstaendige Transformationskette in f64.
//
// Gezeigt wird der uebliche Weg vom Modell zum Bildschirm — Modellmatrix,
// Blickmatrix, Projektion — und was passiert, wenn eine Eingabe entartet ist.
//
//   lyxc --std-path=. examples/math/matrix3d.lyx -o /tmp/matrix3d && /tmp/matrix3d

import std.matrix;
import std.math;

fn zeigeVec3(name: pchar, v: Vec3) {
  Print(name);
  Print(" = (");
  // Die Werte gehen einzeln in Variablen: PrintLn auf einem f64-Ausdruck
  // druckt derzeit die Rohbits (#1497).
  var x: f64 := v.x;
  var y: f64 := v.y;
  var z: f64 := v.z;
  Print(x); Print(", ");
  Print(y); Print(", ");
  Print(z); PrintLn(")");
}

fn main(): int64 {
  PrintLn("=== std.matrix — Transformationskette ===");
  PrintLn("");

  // --- Modell: erst drehen, dann verschieben -------------------------------
  // Die Reihenfolge im Produkt ist die umgekehrte der Wirkung: M = T * R
  // dreht zuerst und verschiebt danach.
  var viertel: f64 := 1.5707963267948966;          // 90 Grad in Radiant
  var drehung: Mat4 := Mat4RotateZ(viertel);
  var schub: Mat4 := Mat4Translate(Vec3New(0.0, 0.0, 2.0));
  var modell: Mat4 := Mat4Mul(schub, drehung);

  var punkt: Vec3 := Vec3New(1.0, 0.0, 0.0);
  var imModell: Vec3 := Mat4MulPoint3(modell, punkt);
  PrintLn("Modellmatrix (erst Drehung um z, dann Schub entlang z):");
  zeigeVec3("  Punkt   ", punkt);
  zeigeVec3("  bewegt  ", imModell);

  // Eine Richtung nimmt die Drehung mit, den Schub nicht.
  var richtung: Vec3 := Mat4MulDir3(modell, punkt);
  zeigeVec3("  Richtung", richtung);
  PrintLn("");

  // --- Kamera --------------------------------------------------------------
  var auge: Vec3 := Vec3New(0.0, 0.0, 8.0);
  var blick: Mat4 := Mat4LookAt(auge, Vec3Zero(), Vec3UnitY());
  var imBlick: Vec3 := Mat4MulPoint3(blick, imModell);
  PrintLn("Blickmatrix (Kamera bei z = 8, Blick auf den Ursprung):");
  zeigeVec3("  im Kamerasystem", imBlick);
  PrintLn("");

  // --- Projektion ----------------------------------------------------------
  var oeffnung: f64 := 1.0471975511965976;         // 60 Grad
  var projektion: Mat4 := Mat4Perspective(oeffnung, 1.3333333333333333, 0.1, 100.0);
  var mvp: Mat4 := Mat4Mul(projektion, Mat4Mul(blick, modell));

  var aufSchirm: Vec3Result := Mat4ProjectPoint3(mvp, punkt);
  if (aufSchirm.ok) {
    PrintLn("Projektion (Punkt liegt im Bild):");
    zeigeVec3("  Bildkoordinate", aufSchirm.v);
  } else {
    PrintLn("Projektion: der Punkt liegt in der Fluchtebene, w ist 0.");
  }
  PrintLn("");

  // --- Umkehrung -----------------------------------------------------------
  // Die Modellmatrix rueckwaerts angewandt muss den Ausgangspunkt treffen.
  var umkehr: Mat4Inv := Mat4Inverse(modell);
  if (umkehr.ok) {
    var zurueck: Vec3 := Mat4MulPoint3(umkehr.m, imModell);
    PrintLn("Umkehrung der Modellmatrix:");
    zeigeVec3("  zurueckgerechnet", zurueck);
  } else {
    PrintLn("Modellmatrix ist singulaer — nicht umkehrbar.");
  }
  PrintLn("");

  // --- Und der Fall, in dem es nicht geht ----------------------------------
  // Eine Matrix, deren dritte Zeile das Doppelte der ersten ist, hat keine
  // Umkehrung. Die Unit sagt das, statt etwas Plausibles zu liefern.
  var entartet: Mat4 := Mat4Zero();
  entartet.m00 := 1.0; entartet.m01 := 2.0; entartet.m02 := 3.0; entartet.m03 := 4.0;
  entartet.m10 := 5.0; entartet.m11 := 6.0; entartet.m12 := 7.0; entartet.m13 := 8.0;
  entartet.m20 := 2.0; entartet.m21 := 4.0; entartet.m22 := 6.0; entartet.m23 := 8.0;
  entartet.m30 := 1.0; entartet.m31 := 1.0; entartet.m32 := 1.0; entartet.m33 := 1.0;

  var versuch: Mat4Inv := Mat4Inverse(entartet);
  if (versuch.ok) {
    PrintLn("FEHLER: eine singulaere Matrix haette nicht umkehrbar sein duerfen.");
    return 1;
  }
  PrintLn("Singulaere Matrix: Mat4Inverse meldet ok == false. Richtig so.");

  var determinante: f64 := Mat4Det(entartet);
  Print("  ihre Determinante ist ");
  PrintLn(determinante);

  return 0;
}
