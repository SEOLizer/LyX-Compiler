// Matrix Demo
// Demonstrates: 2D-Matrizen, Operationen, Speicherlayout

fn main(): int64 {
    PrintLn("=== Matrix Demo ===\n");
    
    // Matrix-Erklaerung
    PrintLn("Matrix Grundlagen:");
    PrintLn("------------------");
    PrintLn("Eine Matrix ist ein 2-dimensionales Array.");
    PrintLn("Notation: matrix[rows][cols] oder matrix[Zeilen][Spalten]");
    PrintLn("");
    PrintLn("Speicherlayout (Row-Major):");
    PrintLn("  [0,0] [0,1] [0,2] | [1,0] [1,1] [1,2] | [2,0] [2,1] [2,2]");
    PrintLn("  ---- Zeile 0 ---- | ---- Zeile 1 ---- | ---- Zeile 2 ----");
    PrintLn("");
    
    // Beispiel-Matrix
    PrintLn("Beispiel: 3x3 Matrix");
    PrintLn("-------------------");
    var m: array[9]int64;
    // Zeile 0
    m[0] := 1; m[1] := 2; m[2] := 3;
    // Zeile 1
    m[3] := 4; m[4] := 5; m[5] := 6;
    // Zeile 2
    m[6] := 7; m[7] := 8; m[8] := 9;
    
    PrintLn("1  2  3");
    PrintLn("4  5  6");
    PrintLn("7  8  9");
    PrintLn("");
    
    // Auf Element zugreifen
    PrintLn("Element-Zugriff (row-major):");
    PrintLn("  matrix[row * cols + col]");
    PrintLn("  element[1][2] = 1 * 3 + 2 = index 5");
    var idx: int64 := 1 * 3 + 2;
    Print("  Wert an [1][2] = ");
    PrintLn(m[idx]);
    PrintLn("\n");
    
    // Matrix-Addition
    PrintLn("Matrix-Addition (A + B):");
    PrintLn("------------------------");
    PrintLn("Beide Matrizen muessen gleiche Dimension haben.");
    PrintLn("Element-wise Addition: C[i][j] = A[i][j] + B[i][j]");
    PrintLn("");
    PrintLn("Beispiel:");
    PrintLn("  A = [1 2]   B = [5 6]   C = [6 8]");
    PrintLn("      [3 4]       [7 8]       [10 12]");
    PrintLn("");
    
    // Matrix-Multiplikation
    PrintLn("Matrix-Multiplikation (A * B):");
    PrintLn("-------------------------------");
    PrintLn("A (m x n) * B (n x p) = C (m x p)");
    PrintLn("C[i][j] = Sum(A[i][k] * B[k][j]) fuer k = 0 bis n-1");
    PrintLn("");
    PrintLn("Beispiel 2x2:");
    PrintLn("  A = [1 2]   B = [7 8]   C = [1*7+2*9  1*8+2*10]");
    PrintLn("      [3 4]       [9 10]      [3*7+4*9  3*8+4*10]");
    PrintLn("                    = [25 28]");
    PrintLn("                      [57 64]");
    PrintLn("");
    
    // Transposition
    PrintLn("Matrix-Transposition (A^T):");
    PrintLn("---------------------------");
    PrintLn("Zeilen und Spalten werden getauscht.");
    PrintLn("A[i][j] -> A^T[j][i]");
    PrintLn("");
    PrintLn("Beispiel:");
    PrintLn("  A = [1 2 3]   A^T = [1 4 7]");
    PrintLn("      [4 5 6]           [2 5 8]");
    PrintLn("      [7 8 9]           [3 6 9]");
    PrintLn("");
    
    // Identitaetsmatrix
    PrintLn("Einheitsmatrix (I):");
    PrintLn("--------------------");
    PrintLn("Diagonale = 1, sonst 0");
    PrintLn("");
    PrintLn("  I = [1 0 0]");
    PrintLn("      [0 1 0]");
    PrintLn("      [0 0 1]");
    PrintLn("");
    PrintLn("Eigenschaft: A * I = I * A = A");
    PrintLn("");
    
    // Skalar-Multiplikation
    PrintLn("Skalar-Multiplikation:");
    PrintLn("----------------------");
    PrintLn("Jedes Element wird mit Skalar multipliziert.");
    PrintLn("k * A = [k*a_ij]");
    PrintLn("");
    PrintLn("Beispiel: 2 * [1 2] = [2 4]");
    PrintLn("               [3 4]    [6 8]");
    
    PrintLn("\n=== Demo abgeschlossen ===");
    
    return 0;
}