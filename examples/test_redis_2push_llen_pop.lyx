// Debug LPOP - LPUSH x2 + LLEN + LPOP
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    }
    
    var r: RedisReply := RedisLPush(conn, "mylist", "first");
    PrintLn("LPUSH1 done");
    
    r := RedisLPush(conn, "mylist", "second");
    PrintLn("LPUSH2 done");
    
    // Add LLEN
    var llen: int64 := RedisLLen(conn, "mylist");
    Print("LLEN = ");
    PrintLn(llen);
    
    // Now LPOP - this is where it might crash
    r := RedisLPop(conn, "mylist");
    Print("LPOP result: kind=");
    PrintLn(r.kind);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}