// Test select on stdout (sanity check for select)
import std.net.syscalls;
import std.alloc;

fn main(): int64 {
    PrintLn("=== Test select on stdout ===");
    
    // Prepare fd_set for stdout (fd=1)
    var readfds: int64 := alloc(128);
    
    // FD_ZERO
    var i: int64 := 0;
    while (i < 128) {
        poke8(readfds + i, 0);
        i := i + 1;
    }
    
    // FD_SET stdout
    var byte_idx: int64 := 1 / 8;
    var bit_idx: int64 := 1 % 8;
    var current: int64 := peek8(readfds + byte_idx);
    current := current | (1 << bit_idx);
    poke8(readfds + byte_idx, current);
    
    // Timeout 0
    var timeout: int64 := alloc(16);
    poke8(timeout, 0);  // tv_sec = 0
    
    var n: int64 := Select(2, readfds, 0, 0, timeout);
    Print("select(stdout) n = ");
    PrintLn(n);
    
    // Try reading from stdout (should fail - not readable)
    var buf: pchar := "                    ";
    var r: int64 := Read(1, buf, 32);
    Print("Read(stdout) = ");
    PrintLn(r);
    
    free(readfds, 128);
    free(timeout, 16);
    
    // Test select on stdin with input
    PrintLn("=== Test select on stdin ===");
    
    readfds := alloc(128);
    i := 0;
    while (i < 128) {
        poke8(readfds + i, 0);
        i := i + 1;
    }
    
    // FD_SET stdin (fd=0)
    poke8(readfds, 1);  // set bit 0
    
    timeout := alloc(16);
    poke8(timeout, 2);  // 2 second timeout
    
    n := Select(1, readfds, 0, 0, timeout);
    Print("select(stdin) n = ");
    PrintLn(n);
    
    if (n > 0) {
        r := Read(0, buf, 10);
        Print("Read(stdin) = ");
        PrintLn(r);
        Print(", [");
        Print(buf);
        PrintLn("]");
    }
    
    free(readfds, 128);
    free(timeout, 16);
    
    PrintLn("Done");
    return 0;
}