// Verify mmap address is correct by writing THEN reading
import std.net.syscalls;
import std.net.socket;
import std.alloc;

fn main(): int64 {
    var conn: TCPConn := TCPConnect(0x7F000001, 6379);
    if (conn.fd < 0) { return 1; }
    PrintLn("connected");
    
    var my_fd: int64 := conn.fd;
    
    // Allocate mmap
    var mbuf: int64 := alloc(64);
    Print("mmap = ");
    PrintLn(mbuf);
    
    // Write to mmap BEFORE reading
    poke8(mbuf, 65);  // 'A'
    poke8(mbuf + 1, 66);  // 'B'
    PrintLn("Wrote AB to mmap");
    
    // Verify what we wrote
    Print("peek8(mbuf) = ");
    PrintLn(peek8(mbuf));
    PrintLn("");
    Print("peek8(mbuf+1) = ");
    PrintLn(peek8(mbuf + 1));
    PrintLn("");
    
    // Now write PING
    var req: pchar := "*1\r\n$4\r\nPING\r\n";
    write(my_fd, req, 18);
    PrintLn("wrote PING");
    
    // Now read into same mmap buffer
    var n: int64 := read(my_fd, mbuf, 64);
    Print("read n = ");
    PrintLn(n);
    
    // Check what we got
    Print("peek8(mbuf) after read = ");
    PrintLn(peek8(mbuf));
    PrintLn("");
    Print("peek8(mbuf+1) = ");
    PrintLn(peek8(mbuf + 1));
    PrintLn("");
    
    // Print as string
    var i: int64 := 0;
    Print("read content: ");
    while (i < 10) {
        var b: int64 := peek8(mbuf + i);
        if (b >= 32 && b < 127) {
            var c: pchar := " ";
            StrSetChar(c, 0, b);
            Print(c);
        }
        i := i + 1;
    }
    PrintLn("");
    
    free(mbuf, 64);
    close(conn.fd);
    return 0;
}