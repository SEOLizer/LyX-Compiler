// Test PING -> DEL -> LPUSH -> LPUSH -> LPOP -> RPOP
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    RedisDel(conn, "mylist");
    PrintLn("DEL done");
    
    var r: RedisReply := RedisLPush(conn, "mylist", "one");
    PrintLn("LPUSH1 done");
    
    r := RedisLPush(conn, "mylist", "two");
    PrintLn("LPUSH2 done");
    
    r := RedisLPop(conn, "mylist");
    PrintLn("LPOP done");
    
    r := RedisRPop(conn, "mylist");
    PrintLn("RPOP done");
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}