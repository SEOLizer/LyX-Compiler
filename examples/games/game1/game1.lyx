// read/write/sys_* sind Builtins — sie als `extern fn` zu deklarieren war
// überflüssig und lief in die FFI-Sandbox (unbekanntes Symbol, fail-closed).

import std.alloc;

fn read_int(): int64 {
  // Lesepuffer und Ziffernpuffer muessen GETRENNT sein. Vorher lasen beide
  // auf dieselbe Adresse: read(0, buf, 1) schrieb jedes Zeichen nach buf[0]
  // und ueberschrieb damit die erste schon gesammelte Ziffer. Bei Eingabe
  // "23" blieb "\n3" stehen, 10-48 ergab -377, und das Spiel meldete
  // "Zahl muss zwischen 0 und 100 liegen". Auf JEDEM Ziel, nicht nur win64.
  var inbuf: pchar := alloc(8) as pchar;
  var buf: pchar := alloc(32) as pchar;
  var i: int64 := 0;
  var ch: int64 := 0;

  read(0, inbuf, 1);
  ch := StrCharAt(inbuf, 0);

  while (ch != 10 && i < 20) {
    if (ch >= 48 && ch <= 57) {
      StrSetChar(buf, i, ch);
      i := i + 1;
    }
    read(0, inbuf, 1);
    ch := StrCharAt(inbuf, 0);
  }

  StrSetChar(buf, i, 0);

  var result: int64 := 0;
  var j: int64 := 0;
  while (j < i) {
    var digit: int64 := StrCharAt(buf, j) - 48;
    result := result * 10 + digit;
    j := j + 1;
  }

  free(inbuf as int64, 8);
  free(buf as int64, 32);
  return result;
}

fn main(): int64 {
  var secret: int64 := 0;
  var guess: int64 := 0;
  var attempts: int64 := 0;
  var won: bool := false;
  
  PrintLn("=== ZAHLENRATEN ===");
  PrintLn("");
  Print("GAMEMASTER: Bitte geheime Zahl eingeben (0-100): ");
  secret := read_int();
  PrintLn("");
  
  if (secret < 0 || secret > 100) {
    PrintLn("FEHLER: Zahl muss zwischen 0 und 100 liegen!");
    return 1;
  }
  
  PrintLn("");
  PrintLn("=== SPIEL STARTET ===");
  PrintLn("Rate die Zahl! Du hast 10 Versuche.");
  PrintLn("");
  
  attempts := 0;
  won := false;
  
  while (attempts < 10) {
    Print("Versuch ");
    PrintLn(attempts + 1);
    Print("/10 - Dein Tipp: ");
    guess := read_int();
    PrintLn("");
    
    if (guess == secret) {
      won := true;
      attempts := 10;
    } else {
      if (guess < secret) {
        PrintLn("Die Zahl ist GROESSER!");
      } else {
        PrintLn("Die Zahl ist KLEINER!");
      }
      attempts := attempts + 1;
    }
    PrintLn("");
  }
  
  if (won) {
    PrintLn("=== GEWONNEN! ===");
    PrintLn("Du hast die Zahl erraten!");
  } else {
    PrintLn("=== VERLOREN! ===");
    Print("Die Zahl war: ");
    PrintLn(secret);
    PrintLn("Mehr Glueck beim naechsten Mal!");
  }
  
  return 0;
}
