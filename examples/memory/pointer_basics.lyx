// Pointer Basics Demo
// Demonstrates: Pointer-Konzepte, Speicheradressen, Dereferenzierung

fn main(): int64 {
    PrintLn("=== Pointer Basics Demo ===\n");
    
    // Pointer erklaeren
    PrintLn("Pointer Grundlagen:");
    PrintLn("-------------------");
    PrintLn("Ein Pointer speichert eine Speicheradresse.");
    PrintLn("Syntax: var p: Pointer");
    PrintLn("Dereferenzierung: p as int64 gibt den Wert an der Adresse");
    PrintLn("");
    
    // Speichergroessen erklaeren
    PrintLn("Speichergroessen (64-bit System):");
    PrintLn("----------------------------------");
    PrintLn("Pointer:  8 Bytes (64 bits)");
    PrintLn("int64:   8 Bytes");
    PrintLn("int32:   4 Bytes");
    PrintLn("int16:   2 Bytes");
    PrintLn("int8:    1 Byte");
    PrintLn("");
    
    // Adress-Berechnung erklaeren
    PrintLn("Adress-Berechnung:");
    PrintLn("------------------");
    PrintLn("Wenn Variable bei Adresse 0x1000 liegt:");
    PrintLn("  - int64 (8 Bytes) naechste Adresse: 0x1008");
    PrintLn("  - int32 (4 Bytes) naechste Adresse: 0x1004");
    PrintLn("  - int16 (2 Bytes) naechste Adresse: 0x1002");
    PrintLn("  - int8  (1 Byte) naechste Adresse: 0x1001");
    PrintLn("");
    
    // Pointer-Operationen erklaeren
    PrintLn("Pointer-Operationen:");
    PrintLn("--------------------");
    PrintLn("1. Adresse nehmen:  &var (nicht in Lyx verfuegbar)");
    PrintLn("2. Dereferenzieren: *ptr -> wert");
    PrintLn("3. Arithmetik:      ptr + 1 -> naechstes Element");
    PrintLn("4. Vergleiche:      ptr1 == ptr2");
    PrintLn("");
    
    // Beispiel-Speicher-Layout
    PrintLn("Beispiel Speicher-Layout:");
    PrintLn("-------------------------");
    PrintLn("Adresse   Wert    Variable");
    PrintLn("--------   -----   --------");
    PrintLn("0x1000     42      x");
    PrintLn("0x1008     3.14    pi (f64)");
    PrintLn("0x1010     0x1020  ptr (Pointer)");
    PrintLn("0x1020     99      y");
    PrintLn("");
    
    // NULL-Pointer erklaeren
    PrintLn("NULL-Pointer:");
    PrintLn("-------------");
    PrintLn("NULL = ungueltige Adresse (0)");
    PrintLn("Pruefung: if (ptr == 0) { ... }");
    PrintLn("Wichtig: Vor Dereferenzierung immer auf NULL pruefen!");
    PrintLn("");
    
    // void* erklaeren
    PrintLn("Generic Pointer (void*):");
    PrintLn("-------------------------");
    PrintLn("void* kann auf beliebige Typen zeigen");
    PrintLn("Vor Verwendung: cast zu konkretem Typ");
    PrintLn("Beispiel: ptr as int64");
    PrintLn("");
    
    // Konstante Pointer vs Pointer auf Konstante
    PrintLn("Konstante Pointer:");
    PrintLn("------------------");
    PrintLn("const int64* p  - Pointer auf Konstante (kann erhoeht werden, Wert nicht aenderbar)");
    PrintLn("int64* const p  - Konstanter Pointer (Adresse fest, Wert aenderbar)");
    PrintLn("const int64* const p - Beides konstant");
    PrintLn("");
    
    // Typische Fehler
    PrintLn("Typische Pointer-Fehler:");
    PrintLn("------------------------");
    PrintLn("1. Dereferenzieren von NULL -> Crash");
    PrintLn("2. Nach freigegebenem Speicher zugreifen -> Crash");
    PrintLn("3. Benutzen von uninitialisierten Pointern -> Crash");
    PrintLn("4. Pointer auf lokale Variable nach Funktionsende -> Crash");
    PrintLn("");
    
    PrintLn("=== Demo abgeschlossen ===");
    
    return 0;
}