// Memory Management Demo
// Demonstrates: Speicherallokation, malloc, free, mmap

fn main(): int64 {
    PrintLn("=== Memory Management Demo ===\n");
    
    // Speicherallokation erklaeren
    PrintLn("Speicherallokation:");
    PrintLn("--------------------");
    PrintLn("malloc(bytes)  - Allokiere Speicher (malloc wrapper)");
    PrintLn("mmap(addr, len, prot, flags, fd, offset) - Memory-Mapped I/O");
    PrintLn("free(ptr)      - Speicher freigeben");
    PrintLn("realloc(ptr, size) - Speichergroesse aendern");
    PrintLn("");
    
    // mmap erklaeren
    PrintLn("mmap Parameter:");
    PrintLn("----------------");
    PrintLn("addr:  Gewuenschte Adresse (0 = automatisch)");
    PrintLn("len:   Groesse in Bytes");
    PrintLn("prot:  Protection Bits (lesen=1, schreiben=2, ausfuehren=4)");
    PrintLn("flags: Map-Typ (shared=1, private=2, anonymous=32)");
    PrintLn("fd:    Datei-Descriptor (0 fuer anonymous)");
    PrintLn("offset: Offset in Datei (muss page-aligned sein)");
    PrintLn("");
    
    // Typische prot-Werte
    PrintLn("Protection-Werte:");
    PrintLn("-----------------");
    PrintLn("PROT_READ  = 1  (lesen erlaubt)");
    PrintLn("PROT_WRITE = 2  (schreiben erlaubt)");
    PrintLn("PROT_EXEC  = 4  (ausfuehren erlaubt)");
    PrintLn("PROT_NONE  = 0  (kein Zugriff)");
    PrintLn("");
    PrintLn("Kombinationen:");
    PrintLn("  PROT_READ           = 1");
    PrintLn("  PROT_READ|PROT_WRITE = 3");
    PrintLn("  PROT_READ|PROT_EXEC  = 5");
    PrintLn("  PROT_READ|PROT_WRITE|PROT_EXEC = 7");
    PrintLn("");
    
    // Typische flags-Werte
    PrintLn("Flags-Werte:");
    PrintLn("------------");
    PrintLn("MAP_SHARED  = 1   (Aenderungen fuer andere sichtbar)");
    PrintLn("MAP_PRIVATE = 2  (Aenderungen nur fuer diesen Prozess)");
    PrintLn("MAP_ANONYMOUS = 32 (keine Datei, nur RAM)");
    PrintLn("MAP_FIXED    = 16 (genau an angegebene Adresse mappen)");
    PrintLn("");
    
    // mmap mit anonymous (ohne Datei)
    PrintLn("Anonymous mmap (ohne Datei):");
    PrintLn("------------------------------");
    PrintLn("ptr = mmap(0, 4096, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)");
    PrintLn("");
    PrintLn("Ergebnis:");
    PrintLn("  - 4096 Bytes (1 Page) allokiert");
    PrintLn("  - Im virtuellen Adressraum des Prozesses");
    PrintLn("  - Mit dem physikalischen RAM verbunden");
    PrintLn("  - Keine Datei dahinter (anonymous)");
    PrintLn("");
    
    // Page-Groesse erklaeren
    PrintLn("Page-Groesse:");
    PrintLn("-------------");
    PrintLn("Typische Page-Groesse: 4096 Bytes (4 KB)");
    PrintLn("mmap allokiert immer ganzzahlige Pages");
    PrintLn("Beispiel: mmap(0, 1000, ...) -> tatsaechlich 4096 Bytes");
    PrintLn("");
    
    // Speicher freigeben
    PrintLn("Speicher freigeben:");
    PrintLn("--------------------");
    PrintLn("munmap(ptr, len) - Speicherbereich freigeben");
    PrintLn("len muss mit mmap-Groesse uebereinstimmen");
    PrintLn("");
    
    // Beispiel-Ablauf
    PrintLn("Beispiel-Ablauf:");
    PrintLn("-----------------");
    PrintLn("1. mmap(0, 8192, R|W, PRIVATE|ANONYMOUS, -1, 0)");
    PrintLn("   -> Adresse 0x7f...000, 8192 Bytes");
    PrintLn("");
    PrintLn("2. Speicher beschreiben (Schreiben)");
    PrintLn("   ptr[0] = 42");
    PrintLn("   *(ptr + 100) = 99");
    PrintLn("");
    PrintLn("3. Speicher lesen");
    PrintLn("   value = ptr[0]");
    PrintLn("   value = *(ptr + 100)");
    PrintLn("");
    PrintLn("4. munmap(ptr, 8192)");
    PrintLn("   -> Speicher freigegeben");
    PrintLn("");
    
    // Typische Nutzung in Lyx
    PrintLn("Nutzung in Lyx (Beispiel):");
    PrintLn("---------------------------");
    PrintLn("var buffer: pchar := mmap(0, 1024, 3, 34, -1, 0) as pchar;");
    PrintLn("// 3 = R|W, 34 = PRIVATE|ANONYMOUS");
    PrintLn("");
    PrintLn("if (buffer as int64 != -1) {");
    PrintLn("    // Speicher nutzen");
    PrintLn("    free(buffer);  // via munmap");
    PrintLn("}");
    PrintLn("");
    
    PrintLn("=== Demo abgeschlossen ===");
    
    return 0;
}