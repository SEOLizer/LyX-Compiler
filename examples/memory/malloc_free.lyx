// Malloc & Free Demo
// Demonstrates: Dynamische Speicherallokation

fn main(): int64 {
    PrintLn("=== malloc & free Demo ===\n");
    
    // malloc erklaeren
    PrintLn("malloc (memory allocation):");
    PrintLn("----------------------------");
    PrintLn("malloc(size) - Allokiert 'size' Bytes auf dem Heap");
    PrintLn("Returns: Pointer auf Speicherbereich oder NULL bei Fehler");
    PrintLn("Initialer Inhalt: unbestimmt (nicht inititalisiert)");
    PrintLn("");
    
    // free erklaeren
    PrintLn("free:");
    PrintLn("-----");
    PrintLn("free(ptr) - Gibt previously allokierten Speicher frei");
    PrintLn("Nach free(): Pointer sollte nicht mehr verwendet werden");
    PrintLn("Doppeltes free: undefined behavior");
    PrintLn("");
    
    // calloc
    PrintLn("calloc (cleared allocation):");
    PrintLn("------------------------------");
    PrintLn("calloc(n, size) - Allokiert n * size Bytes");
    PrintLn("Alle Bytes werden auf 0 initialisiert");
    PrintLn("Nützlich für Arrays");
    PrintLn("");
    
    // realloc
    PrintLn("realloc:");
    PrintLn("---------");
    PrintLn("realloc(ptr, new_size) - Aendert Groesse");
    PrintLn("Falls moeglich: erweitert am gleichen Ort");
    PrintLn("Falls nicht: kopiert zu neuer Adresse");
    PrintLn("Returns neuen Pointer (kann sich aendern!)");
    PrintLn("");
    
    // Typische Nutzung
    PrintLn("Typische Nutzung:");
    PrintLn("------------------");
    
    // Array-Allokation erklaeren
    PrintLn("Array allokieren:");
    var elements: int64 := 10;
    var element_size: int64 := 8;  // sizeof(int64)
    var total_size: int64 := elements * element_size;
    
    Print("  elements = ");
    PrintLn(elements);
    Print("  element_size = ");
    PrintLn(element_size);
    PrintLn(" Bytes");
    Print("  total = ");
    PrintLn(total_size);
    PrintLn(" Bytes");
    PrintLn("");
    
    // String-Allokation
    PrintLn("String allokieren:");
    var str_len: int64 := 80;
    var str_size: int64 := str_len + 1;  // +1 fuer null-terminator
    
    Print("  Laenge = ");
    PrintLn(str_len);
    PrintLn(" Zeichen");
    Print("  Groesse = ");
    PrintLn(str_size);
    PrintLn(" Bytes (inkl. Null-Terminator)");
    PrintLn("");
    
    // Struct-Allokation erklaeren
    PrintLn("Struct allokieren:");
    PrintLn("  sizeof(Point) = 16 Bytes (2 x int64)");
    PrintLn("  malloc(16) -> Pointer auf Point");
    PrintLn("");
    
    // Fehlerbehandlung
    PrintLn("Fehlerbehandlung:");
    PrintLn("-----------------");
    PrintLn("Nach malloc/calloc/realloc IMMER auf NULL pruefen!");
    PrintLn("");
    PrintLn("Beispiel:");
    PrintLn("  ptr = malloc(1000);");
    PrintLn("  if (ptr == 0) {");
    PrintLn("    // Fehler behandeln");
    PrintLn("    return -1;");
    PrintLn("  }");
    PrintLn("");
    
    // Memory Leak erklaeren
    PrintLn("Memory Leaks:");
    PrintLn("-------------");
    PrintLn("Ein Speicherbereich wird allokiert aber nie freigegeben.");
    PrintLn("Faellt erst bei laenger laufenden Programmen auf.");
    PrintLn("Tools: valgrind, AddressSanitizer");
    PrintLn("");
    PrintLn("Beispiel Leak:");
    PrintLn("  fn leak() {");
    PrintLn("    var p: pchar := malloc(100);");
    PrintLn("    // p wird nie freigegeben!");
    PrintLn("    return;");
    PrintLn("  }");
    PrintLn("");
    
    // Double Free erklaeren
    PrintLn("Double Free:");
    PrintLn("------------");
    PrintLn("Derselbe Speicher wird zweimal freigegeben.");
    PrintLn("Resultat: undefined behavior, moeglicher Crash");
    PrintLn("");
    PrintLn("Beispiel:");
    PrintLn("  free(ptr);");
    PrintLn("  free(ptr);  // CRASH!");
    PrintLn("");
    
    PrintLn("=== Demo abgeschlossen ===");
    
    return 0;
}