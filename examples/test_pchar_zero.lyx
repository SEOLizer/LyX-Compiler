import std.alloc;
fn test1(v: int64, dst: int64): void {
  poke64(dst + 0, v);
}
fn test2(path: pchar, dst: int64): void {
  poke64(dst + 8, path as int64);
}
fn test3(path: pchar, dst: int64): void {
  poke64(dst + 0, path as int64);
}

fn main(): void {
  var buf: int64 := alloc(32);
  test1(12345, buf);
  Print("t1: ");
  PrintLn(peek64(buf + 0));
  PrintLn("");
  test2("/hello", buf);
  Print("t2: ");
  PrintLn(peek64(buf + 8));
  PrintLn("");
  PrintLn("t3: start");
  test3("/world", buf);
  PrintLn("t3: done");
  free(buf, 32);
}
