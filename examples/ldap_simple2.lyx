// Simple LDAP Test - just strings

import std.net.ldap;
import std.io;

pub fn main(): int64 {
  var errMsg: int64 := LDAPErrorToStr(0);
  if (errMsg != 0) {
    Print("Error(0): ");
    Print(errMsg);
    PrintLn("");
  }
  errMsg := LDAPErrorToStr(49);
  if (errMsg != 0) {
    Print("Error(49): ");
    Print(errMsg);
    PrintLn("");
  }
  return 0;
}