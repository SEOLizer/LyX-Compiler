// Test individual commands
import std.net.socket;

fn main(): int64 {
    PrintLn("=== Test commands individually ===");
    
    var conn: TCPConn := TCPConnect(0x7F000001, 6379);
    if (conn.fd < 0) { PrintLn("Connect failed"); return 1; }
    PrintLn("Connected");
    
    var buf: pchar := "                    ";
    var n: int64;
    var req: pchar;
    
    // PING 1
    req := "*1\r\n$4\r\nPING\r\n";
    sys_write(conn.fd, req, 18);
    n := sys_read(conn.fd, buf, 32);
    Print("PING1 n = ");
    PrintLn(n);
    
    // PING 2
    req := "*1\r\n$4\r\nPING\r\n";
    sys_write(conn.fd, req, 18);
    n := sys_read(conn.fd, buf, 32);
    Print("PING2 n = ");
    PrintLn(n);
    
    // PING 3
    req := "*1\r\n$4\r\nPING\r\n";
    sys_write(conn.fd, req, 18);
    n := sys_read(conn.fd, buf, 32);
    Print("PING3 n = ");
    PrintLn(n);
    
    sys_close(conn.fd);
    PrintLn("Done");
    
    return 0;
}