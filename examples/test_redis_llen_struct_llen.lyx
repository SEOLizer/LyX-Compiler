// Test PING + 2x LPUSH + LLEN + LPOP + LLEN
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    RedisDel(conn, "testlist");
    
    var r: RedisReply := RedisLPush(conn, "testlist", "one");
    PrintLn("LPUSH one done");
    
    r := RedisLPush(conn, "testlist", "two");
    PrintLn("LPUSH two done");
    
    // First LLEN returns int64
    var llen: int64 := RedisLLen(conn, "testlist");
    Print("LLEN 1 = ");
    PrintLn(llen);
    
    // LPOP returns struct
    r := RedisLPop(conn, "testlist");
    Print("LPOP done, kind=");
    PrintLn(r.kind);
    
    // Second LLEN - this might be problematic
    llen := RedisLLen(conn, "testlist");
    Print("LLEN 2 = ");
    PrintLn(llen);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}