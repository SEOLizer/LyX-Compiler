// Test exact sequence from all_ops: LPOP + RPOP + DEL + SADD + SADD + SISMEMBER
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    // Setup list and pop
    RedisDel(conn, "mylist");
    RedisLPush(conn, "mylist", "a");
    RedisLPush(conn, "mylist", "b");
    
    var r: RedisReply := RedisLPop(conn, "mylist");
    Print("LPOP done, kind=");
    PrintLn(r.kind);
    
    r := RedisRPop(conn, "mylist");
    Print("RPOP done, kind=");
    PrintLn(r.kind);
    
    // Int64 return (DEL)
    var delres: int64 := RedisDel(conn, "myset");
    Print("DEL result = ");
    PrintLn(delres);
    
    // Struct returns (SADD)
    r := RedisSAdd(conn, "myset", "apple");
    Print("SADD apple done, kind=");
    PrintLn(r.kind);
    
    r := RedisSAdd(conn, "myset", "banana");
    Print("SADD banana done, kind=");
    PrintLn(r.kind);
    
    // Int64 return (SISMEMBER)
    var ismem: int64 := RedisSIsMember(conn, "myset", "apple");
    Print("SISMEMBER apple = ");
    PrintLn(ismem);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}