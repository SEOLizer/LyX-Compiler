// test_exp.lyx - Test ExpF64 Taylor series
import std.ml;

pub fn main(): int64 {
  // Test exp(0) should be 1
  var e0: f64 := ExpF64(0.0);
  Print("exp(0): ");
  PrintLn(e0 as int64);
  
  // Test exp(1) should be ~2.718
  var e1: f64 := ExpF64(1.0);
  Print("exp(1): ");
  PrintLn(e1 as int64);  // ~2
  PrintLn("");
  
  // Test sigmoid
  var s0: f64 := SigmoidF64(0.0);
  Print("sigmoid(0): ");
  PrintLn(s0 as int64);  // sollte 0.5 sein ~0
  PrintLn("");
  
  var s1: f64 := SigmoidF64(10.0);
  Print("sigmoid(10): ");
  PrintLn(s1 as int64);  // sollte 1 sein
  PrintLn("");
  
  var s_1: f64 := SigmoidF64(0.0 - 10.0);
  Print("sigmoid(-10): ");
  PrintLn(s_1 as int64);  // sollte 0 sein
  PrintLn("");
  
  PrintLn("Done");
  return 0;
}