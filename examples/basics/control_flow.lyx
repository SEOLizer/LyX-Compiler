// Kontrollstrukturen: if, else, while
// Demonstrates: if-else, while-Schleife

fn main(): int64 {
    var a: int64 := 5;
    var b: int64 := 10;
    
    // if-else Verzweigung
    if (a < b) {
        PrintLn("a ist kleiner als b");
    } else {
        PrintLn("a ist groesser oder gleich b");
    }
    
    // Verschachtelte if-else
    var x: int64 := 42;
    if (x > 0) {
        if (x > 100) {
            PrintLn("x > 100");
        } else {
            PrintLn("0 < x <= 100");
        }
    } else {
        PrintLn("x <= 0");
    }
    
    // while-Schleife
    var i: int64 := 0;
    Print("While-Schleife: ");
    while (i < 5) {
        PrintLn(i);
        Print(" ");
        i += 1;
    }
    PrintLn("");
    
    return 0;
}