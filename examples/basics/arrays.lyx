// Arrays in Lyx
// Demonstrates: statische Arrays, Array-Zugriff

fn main(): int64 {
    // Statisches Array mit vorgegebenen Werten
    var arr: array := [1, 2, 3, 4, 5];
    
    // Array-Elemente lesen
    Print("Element 0: ");
    PrintLn(arr[0]);
    
    Print("Element 4: ");
    PrintLn(arr[4]);
    
    // Array-Element aendern
    arr[0] := 100;
    Print("Element 0 nach Aenderung: ");
    PrintLn(arr[0]);
    
    // Array mit neuen Werten erstellen
    var squares: array := [0, 1, 4, 9, 16, 25, 36, 49, 64, 81];
    
    // Array ausgeben
    Print("Quadratzahlen: ");
    var i: int64 := 0;
    while (i < 10) {
        PrintLn(squares[i]);
        Print(" ");
        i += 1;
    }
    PrintLn("");
    
    // Dynamische Arrays verwaltet der Compiler; ein free gibt es hier nicht.
    
    return 0;
}