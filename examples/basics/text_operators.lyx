// std.text.Text — the UTF-8 layer, with a method API and operators.
//
// Text is codepoint-aware: it validates UTF-8 at construction and counts,
// indexes and slices by CODEPOINT, not by byte. Being a class, it takes part in
// operator overloading like String does:
//   a + b   concatenation          a == b / a != b   content equality
//   a < b   codepoint order        a[i]              the i-th CODEPOINT
//
// For raw bytes use ByteAt / ByteLength — a[i] deliberately does not do that.

import std.text;

fn main(): int64 {
  var a: Text := TextFromPchar("héllo");        // 5 codepoints, 6 bytes
  var b: Text := TextFromPchar(" wörld");

  PrintStr("valid UTF-8   : "); PrintInt(a.IsValid());         PrintStr("\n");  // 1
  PrintStr("byte length   : "); PrintInt(a.ByteLength());      PrintStr("\n");  // 6
  PrintStr("codepoints    : "); PrintInt(a.CodepointCount());  PrintStr("\n");  // 5

  // a[i] is the i-th codepoint — U+00E9 (233), not the 0xC3 lead byte.
  PrintStr("a[1] codepoint: "); PrintInt(a[1]);                PrintStr("\n");  // 233
  PrintStr("a byte 1      : "); PrintInt(a.ByteAt(1));         PrintStr("\n");  // 195

  // concatenation via +
  var joined: Text := a + b;
  PrintStr("joined cps    : "); PrintInt(joined.CodepointCount()); PrintStr("\n");  // 11

  // content comparison: a different object with the same bytes is equal
  var a2: Text := TextFromPchar("héllo");
  PrintStr("a == a2       : "); PrintInt(a == a2); PrintStr("\n");  // 1
  PrintStr("a != b        : "); PrintInt(a != b);  PrintStr("\n");  // 1
  PrintStr("b <  a        : "); PrintInt(b < a);   PrintStr("\n");  // 1 (' ' < 'h')

  // codepoint-correct slicing — never splits a multibyte sequence
  var head: Text := a.SubstringCp(0, 2);
  PrintStr("first 2 cps   : "); PrintInt(head.ByteLength()); PrintStr("\n");  // 3 bytes

  // search, trim, replace, split
  var csv: Text := TextFromPchar("a,b,c");
  var comma: Text := TextFromPchar(",");
  PrintStr("parts         : "); PrintInt(csv.SplitCount(comma)); PrintStr("\n");  // 3
  var second: Text := csv.PartAt(comma, 1);
  PrintStr("part 1 cp     : "); PrintInt(second[0]); PrintStr("\n");             // 98 'b'

  // (A method call on a method *result* is not an overload/dispatch site yet, so
  // bind the intermediate Text to a variable first.)
  var padded: Text := TextFromPchar("  hi  ");
  var trimmed: Text := padded.Trim();
  PrintStr("trimmed bytes : "); PrintInt(trimmed.ByteLength()); PrintStr("\n");  // 2

  // Text owns its bytes; Free() releases them (and really clears the object,
  // because Text is a class — reference semantics).
  a.Free();
  PrintStr("after Free    : "); PrintInt(a.ByteLength()); PrintStr("\n");  // 0

  return 0;
}
