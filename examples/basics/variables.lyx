// Variablen und Speicherklassen
// Demonstrates: var, let, co, const, Zuweisungen

fn main(): int64 {
    // var: mutable, zur Laufzeit änderbar
    var count: int64 := 0;
    count += 1;
    PrintLn(count);  // Ausgabe: 1
    PrintLn("");
    
    // let: immutable, einmaliger Initialisierungswert
    let name: int64 := 42;
    // name := 100;  // Würde einen Fehler erzeugen!
    PrintLn(name);  // Ausgabe: 42
    PrintLn("");
    
    // Konstanten zur Kompilierzeit
    con PI: int64 := 314159;
    con MAX_SIZE: int64 := 1000;
    
    PrintLn(PI);
    PrintLn(MAX_SIZE);
    
    // Rechnen mit Variablen
    var a: int64 := 10;
    var b: int64 := 3;
    var sum: int64 := a + b;
    var diff: int64 := a - b;
    var prod: int64 := a * b;
    var quot: int64 := a / b;
    var rest: int64 := a % b;
    
    Print("Sum: ");
    PrintLn(sum);
    
    Print("Diff: ");
    PrintLn(diff);
    
    Print("Prod: ");
    PrintLn(prod);
    
    Print("Quot: ");
    PrintLn(quot);
    
    Print("Rest: ");
    PrintLn(rest);
    
    return 0;
}