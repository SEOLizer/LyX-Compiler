// Funktionen und Rekursion
// Demonstrates: Funktionen, Rekursion, Return-Werte

fn factorial(n: int64): int64 {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

fn fibonacci(n: int64): int64 {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

fn sum_values(a: int64, b: int64, c: int64, d: int64, e: int64): int64 {
    return a + b + c + d + e;
}

fn is_even(n: int64): int64 {
    if (n % 2 == 0) {
        return 1;
    }
    return 0;
}

fn main(): int64 {
    // Fakultaet (rekursiv)
    var f: int64 := 5;
    var result: int64 := factorial(f);
    Print("Fakultat von ");
    PrintLn(f);
    Print(": ");
    PrintLn(result);
    
    // Fibonacci (rekursiv)
    var fib_n: int64 := 10;
    result := fibonacci(fib_n);
    Print("Fibonacci ");
    PrintLn(fib_n);
    Print(": ");
    PrintLn(result);
    
    // Summe von Werten
    result := sum_values(1, 2, 3, 4, 5);
    Print("Summe 1+2+3+4+5: ");
    PrintLn(result);
    
    // Even/Odd Check
    var num: int64 := 42;
    result := is_even(num);
    Print("Ist ");
    PrintLn(num);
    Print(" gerade? ");
    PrintLn(result);
    
    num := 7;
    result := is_even(num);
    Print("Ist ");
    PrintLn(num);
    Print(" gerade? ");
    PrintLn(result);
    
    return 0;
}