// Operator overloading — a class that defines the right methods gets operators.
//
// The compiler maps operators to methods on the left operand's class:
//   + Add · - Sub · * Mul · / Div · % Mod
//   == Eq · != Ne · < Lt · <= Le · > Gt · >= Ge
//   a[i] Get
// It's generic: any class with these methods works (here a 2D vector), and the
// standard String type (std.strtype) defines them, so strings compare by content.

import std.strtype;

type Vec = class {
  x: int64;
  y: int64;

  fn Init(px: int64, py: int64) { self.x := px; self.y := py; }

  fn Add(o: Vec): Vec {                       // enables  a + b
    var r: Vec := new Vec();
    r.Init(self.x + o.x, self.y + o.y);
    return r;
  }

  fn Sub(o: Vec): Vec {                       // enables  a - b
    var r: Vec := new Vec();
    r.Init(self.x - o.x, self.y - o.y);
    return r;
  }

  fn Eq(o: Vec): int64 {                      // enables  a == b
    if (self.x == o.x && self.y == o.y) { return 1; }
    return 0;
  }

  fn Get(i: int64): int64 {                   // enables  a[i]
    if (i == 0) { return self.x; }
    return self.y;
  }
};

fn main(): int64 {
  var a: Vec := new Vec(); a.Init(1, 2);
  var b: Vec := new Vec(); b.Init(10, 20);
  var c: Vec := new Vec(); c.Init(100, 200);

  // arithmetic, including chained expressions
  var sum: Vec := a + b + c;                  // (a.Add(b)).Add(c) = (111, 222)
  PrintStr("a + b + c = ("); PrintInt(sum[0]); PrintStr(", "); PrintInt(sum[1]); PrintStr(")\n");

  var diff: Vec := b - a;                      // (9, 18)
  PrintStr("b - a = ("); PrintInt(diff[0]); PrintStr(", "); PrintInt(diff[1]); PrintStr(")\n");

  // equality by content (a and a copy are equal, a and b are not)
  var a2: Vec := new Vec(); a2.Init(1, 2);
  PrintStr("a == a2 : "); PrintInt(a == a2); PrintStr("\n");   // 1
  PrintStr("a == b  : "); PrintInt(a == b);  PrintStr("\n");   // 0

  // strings: content comparison + concatenation + indexing
  var s1: String := StringFromPchar("apple");
  var s2: String := StringFromPchar("apple");   // different object, same content
  var s3: String := StringFromPchar("banana");
  PrintStr("s1 == s2 : "); PrintInt(s1 == s2); PrintStr("\n");   // 1 (by content)
  PrintStr("s1 <  s3 : "); PrintInt(s1 < s3);  PrintStr("\n");   // 1 (apple < banana)
  PrintStr("s1[0]    : "); PrintInt(s1[0]);    PrintStr("\n");   // 97 ('a')

  // Note: an operator's left operand must be an identifier (or another operator
  // expression) — bind function results to a variable first. `hello + world`
  // works; `StringFromPchar(..) + StringFromPchar(..)` does not (yet).
  var hello: String := StringFromPchar("Hello, ");
  var world: String := StringFromPchar("World!");
  var greeting: String := hello + world;
  PrintStr("concat length: "); PrintInt(greeting.Length()); PrintStr("\n");  // 13

  return 0;
}
