// Increment/Decrement und Compound-Assignment (seit lyxc 1.0.7B)
// Demonstrates: ++ -- += -= *= /= %=
//
// Alle sind reines Parser-Desugaring:
//   i++     ->  i := i + 1
//   x += y  ->  x := x + y   (ebenso -= *= /= %=)
// -> funktioniert in allen Backends, kein Sonderfall im Codegen.

fn main(): int64 {
    // --- Inkrement / Dekrement ---
    var c: int64 := 0;
    c++;            // 1
    c++;            // 2
    c--;            // 1
    Print("c = "); PrintLn(c);            // erwartet 1

    // --- Compound-Assignment ---
    var x: int64 := 10;
    x += 5;         // 15
    x -= 3;         // 12
    x *= 2;         // 24
    x /= 4;         // 6
    x %= 4;         // 2
    Print("x = "); PrintLn(x);            // erwartet 2

    // --- typischer Loop: Counter + Akkumulator ---
    var sum: int64 := 0;
    var i: int64 := 1;
    while (i <= 5) {
        sum += i;   // 1+2+3+4+5
        i++;
    }
    Print("sum(1..5) = "); PrintLn(sum);  // erwartet 15

    // --- auch auf f64 ---
    var f: f64 := 1.5;
    f += 2.0;       // 3.5
    f *= 2.0;       // 7.0
    Print("f*1 (as int) = "); PrintLn(f as int64);  // erwartet 7

    // --- Vorsicht: Praezedenz ---
    // x := x - a + b  ist NICHT  x -= a + b   (letzteres = x - (a+b)).
    // Compound-Assign nur nutzen, wenn die rechte Seite ein einzelnes Atom ist
    // oder du die Klammerung bewusst willst.

    return 0;
}
