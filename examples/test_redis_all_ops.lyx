// Test all Redis data structure operations
import std.db.redis;

fn main(): int64 {
    PrintLn("=== Redis Data Structures Test ===");
    
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Failed to connect");
        return 1;
    }
    PrintLn("Connected!");
    
    // PING
    if (RedisPing(conn)) {
        PrintLn("PING: OK");
    } else {
        PrintLn("PING: FAILED");
    }
    
    // ========== STRING Operations ==========
    PrintLn("\n--- Strings ---");
    var r: RedisReply := RedisSet(conn, "mykey", "Hello Redis!");
    Print("SET mykey: kind=");
    PrintLn(r.kind);
    
    r := RedisGet(conn, "mykey");
    Print("GET mykey: kind=");
    PrintLn(r.kind);
    Print(" str_len=");
    PrintLn(r.str_len);
    
    var exists: int64 := RedisExists(conn, "mykey");
    Print("EXISTS mykey: ");
    PrintLn(exists);
    
    // ========== LIST Operations ==========
    PrintLn("\n--- Lists ---");
    
    // Clear test list
    RedisDel(conn, "mylist");
    
    // LPUSH
    r := RedisLPush(conn, "mylist", "first");
    Print("LPUSH: kind=");
    PrintLn(r.kind);
    
    r := RedisLPush(conn, "mylist", "second");
    Print("LPUSH again: kind=");
    PrintLn(r.kind);
    
    // RPUSH
    r := RedisRPush(conn, "mylist", "last");
    Print("RPUSH: kind=");
    PrintLn(r.kind);
    
    // LLEN
    var llen: int64 := RedisLLen(conn, "mylist");
    Print("LLEN mylist: ");
    PrintLn(llen);
    
    // LRANGE
    r := RedisLRange(conn, "mylist", 0, -1);
    Print("LRANGE 0,-1: kind=");
    PrintLn(r.kind);
    Print(" len=");
    PrintLn(r.str_len);
    
    // LPOP
    r := RedisLPop(conn, "mylist");
    Print("LPOP: kind=");
    PrintLn(r.kind);
    
    // RPOP
    r := RedisRPop(conn, "mylist");
    Print("RPOP: kind=");
    PrintLn(r.kind);
    
    // ========== HASH Operations ==========
    PrintLn("\n--- Hashes ---");
    
    // Clear test hash
    RedisDel(conn, "myhash");
    
    // HSET
    r := RedisHSet(conn, "myhash", "name", "Alice");
    Print("HSET name: kind=");
    PrintLn(r.kind);
    
    r := RedisHSet(conn, "myhash", "age", "30");
    Print("HSET age: kind=");
    PrintLn(r.kind);
    
    // HGET
    r := RedisHGet(conn, "myhash", "name");
    Print("HGET name: kind=");
    PrintLn(r.kind);
    
    // HGETALL
    r := RedisHGetAll(conn, "myhash");
    Print("HGETALL: kind=");
    PrintLn(r.kind);
    
    // HINCRBY
    r := RedisHIncrBy(conn, "myhash", "age", 1);
    Print("HINCRBY age +1: kind=");
    PrintLn(r.kind);
    
    // HDEL
    var hdel: int64 := RedisHDel(conn, "myhash", "age");
    Print("HDEL age: ");
    PrintLn(hdel);
    
    // ========== SET Operations ==========
    PrintLn("\n--- Sets ---");
    
    // Clear test set
    RedisDel(conn, "myset");
    
    // SADD
    r := RedisSAdd(conn, "myset", "apple");
    Print("SADD apple: kind=");
    PrintLn(r.kind);
    
    r := RedisSAdd(conn, "myset", "banana");
    Print("SADD banana: kind=");
    PrintLn(r.kind);
    
    // SISMEMBER
    var ismem: int64 := RedisSIsMember(conn, "myset", "apple");
    Print("SISMEMBER apple: ");
    PrintLn(ismem);
    
    ismem := RedisSIsMember(conn, "myset", "cherry");
    Print("SISMEMBER cherry: ");
    PrintLn(ismem);
    
    // SREM
    r := RedisSRem(conn, "myset", "banana");
    Print("SREM banana: kind=");
    PrintLn(r.kind);
    
    // ========== SORTED SET Operations ==========
    PrintLn("\n--- Sorted Sets ---");
    
    // Clear test zset
    RedisDel(conn, "myzset");
    
    // ZADD
    r := RedisZAdd(conn, "myzset", 100, "player1");
    Print("ZADD player1: kind=");
    PrintLn(r.kind);
    
    r := RedisZAdd(conn, "myzset", 200, "player2");
    Print("ZADD player2: kind=");
    PrintLn(r.kind);
    
    r := RedisZAdd(conn, "myzset", 150, "player3");
    Print("ZADD player3: kind=");
    PrintLn(r.kind);
    
    // ZRANGE
    r := RedisZRange(conn, "myzset", 0, -1);
    Print("ZRANGE: kind=");
    PrintLn(r.kind);
    
    // ZREVRANK
    var rank: int64 := RedisZRevRank(conn, "myzset", "player1");
    Print("ZREVRANK player1: ");
    PrintLn(rank);
    
    // ========== KEY Expiration ==========
    PrintLn("\n--- Key Expiration ---");
    
    // Set a key with expiration
    RedisSet(conn, "tempkey", "expires");
    var expire: int64 := RedisExpire(conn, "tempkey", 60);
    Print("EXPIRE tempkey 60: ");
    PrintLn(expire);
    
    var ttl: int64 := RedisTTL(conn, "tempkey");
    Print("TTL tempkey: ");
    PrintLn(ttl);
    
    // UNLINK
    var unlink: int64 := RedisUnlink(conn, "tempkey");
    Print("UNLINK tempkey: ");
    PrintLn(unlink);
    
    // ========== Cleanup ==========
    PrintLn("\n--- Cleanup ---");
    RedisDel(conn, "mylist");
    RedisDel(conn, "myhash");
    RedisDel(conn, "myset");
    RedisDel(conn, "myzset");
    RedisDel(conn, "mykey");
    PrintLn("Cleaned up test keys");
    
    RedisClose(conn);
    PrintLn("\nDone!");
    return 0;
}