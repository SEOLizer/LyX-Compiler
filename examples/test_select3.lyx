// Fixed: reset fd_set before second select
import std.net.syscalls;
import std.net.socket;
import std.alloc;

fn main(): int64 {
    var conn: TCPConn := TCPConnect(0x7F000001, 6379);
    if (conn.fd < 0) { return 1; }
    PrintLn("connected");
    
    // Reusable buffers
    var readfds: int64 := alloc(128);
    var timeout: int64 := alloc(16);
    poke8(timeout, 1);  // 1 second
    
    // First command
    var req: pchar := "*1\r\n$4\r\nPING\r\n";
    Write(conn.fd, req, 18);
    
    // Reset and set fd
    var i: int64 := 0;
    while (i < 128) { poke8(readfds + i, 0); i := i + 1; }
    poke8(readfds, 1);  // FD_SET fd=3
    
    var n: int64 := Select(conn.fd + 1, readfds, 0, 0, timeout);
    Print("select1 = ");
    PrintLn(n);
    
    if (n > 0) {
        var buf: pchar := "                    ";
        var r: int64 := Read(conn.fd, buf, 32);
        Print("read1 = ");
        PrintLn(r);
    }
    
    // Second command
    req := "*1\r\n$4\r\nPING\r\n";
    Write(conn.fd, req, 18);
    PrintLn("wrote2");
    
    // RESET fd_set before second select!
    i := 0;
    while (i < 128) { poke8(readfds + i, 0); i := i + 1; }
    poke8(readfds, 1);  // FD_SET fd=3 again
    
    n := Select(conn.fd + 1, readfds, 0, 0, timeout);
    Print("select2 = ");
    PrintLn(n);
    
    if (n > 0) {
        var buf: pchar := "                    ";
        PrintLn("about to read2...");
        var r: int64 := Read(conn.fd, buf, 32);
        Print("read2 = ");
        PrintLn(r);
    }
    
    // Third command - let's see if it works
    req := "*1\r\n$4\r\nPING\r\n";
    Write(conn.fd, req, 18);
    PrintLn("wrote3");
    
    i := 0;
    while (i < 128) { poke8(readfds + i, 0); i := i + 1; }
    poke8(readfds, 1);
    
    n := Select(conn.fd + 1, readfds, 0, 0, timeout);
    Print("select3 = ");
    PrintLn(n);
    
    if (n > 0) {
        var buf: pchar := "                    ";
        var r: int64 := Read(conn.fd, buf, 32);
        Print("read3 = ");
        PrintLn(r);
    }
    
    free(readfds, 128);
    free(timeout, 16);
    Close(conn.fd);
    PrintLn("Done");
    return 0;
}