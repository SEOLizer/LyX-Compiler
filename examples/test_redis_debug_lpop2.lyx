// Debug LPOP - just LPUSH and LPOP
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    }
    
    // Just LPUSH + LPOP - no LLEN in between
    var r: RedisReply := RedisLPush(conn, "mylist", "first");
    Print("LPUSH done, kind=");
    PrintLn(r.kind);
    
    // Now LPOP
    r := RedisLPop(conn, "mylist");
    Print("LPOP result: kind=");
    PrintLn(r.kind);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}