// Test updated std.db.redis
import std.db.redis;

fn main(): int64 {
    PrintLn("=== Test Redis Library ===");
    
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    
    if (conn.fd < 0) {
        PrintLn("Failed to connect");
        return 1;
    }
    
    PrintLn("Connected!");
    
    // Ping
    var ok: bool := RedisPing(conn);
    Print("Ping: ");
    if (ok) { PrintLn("OK"); } else { PrintLn("FAILED"); }
    
    // Set
    var reply: RedisReply := RedisSet(conn, "testkey", "hello");
    Print("SET: kind=");
    PrintLn(reply.kind);
    
    // Get
    reply := RedisGet(conn, "testkey");
    Print("GET: kind=");
    PrintLn(reply.kind);
    Print(", val=[");
    Print(reply.str_val);
    PrintLn("]");
    
    RedisClose(conn);
    PrintLn("Done");
    
    return 0;
}