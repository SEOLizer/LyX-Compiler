// Test Redis client - simplified version
import std.db.redis;

fn main(): int64 {
    PrintLn("=== Redis Client Test ===");
    
    // Connect to Redis
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    
    if (conn.fd < 0) {
        PrintLn("Failed to connect to Redis (fd < 0)");
        return 1;
    }
    
    PrintLn("Connected to Redis!");
    
    // Ping
    if (RedisPing(conn)) {
        PrintLn("PING: OK");
    } else {
        PrintLn("PING: failed");
    }
    
    RedisClose(conn);
    PrintLn("Done.");
    
    return 0;
}