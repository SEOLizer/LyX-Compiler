// Test just LRANGE specifically
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    }
    
    // Setup list
    RedisDel(conn, "mylist");
    RedisLPush(conn, "mylist", "first");
    RedisLPush(conn, "mylist", "second");
    RedisLPush(conn, "mylist", "last");
    
    // LRANGE - try different stop values
    var r: RedisReply := RedisLRange(conn, "mylist", 0, -1);
    Print("LRANGE 0,-1: kind=");
    PrintLn(r.kind);
    Print(" str_len=");
    PrintLn(r.str_len);
    
    r := RedisLRange(conn, "mylist", 0, 2);
    Print("LRANGE 0,2: kind=");
    PrintLn(r.kind);
    Print(" str_len=");
    PrintLn(r.str_len);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}