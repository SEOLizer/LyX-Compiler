// Test DEL (int64) -> GET (struct) -> GET (struct)
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    // SET first
    RedisSet(conn, "testkey", "value1");
    PrintLn("SET done");
    
    // DEL returns int64
    var delres: int64 := RedisDel(conn, "testkey");
    Print("DEL result = ");
    PrintLn(delres);
    
    // GET returns struct - first one
    var r: RedisReply := RedisGet(conn, "testkey");
    PrintLn("GET 1 done");
    
    // GET returns struct - second one
    r := RedisGet(conn, "nonexistent");
    PrintLn("GET 2 done");
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}