// mmap, poke, then peek
import std.alloc;
fn main(): int64 {
    var addr: int64 := alloc(16);
    Print("addr: ");
    PrintLn(addr);
    
    poke8(addr, 65);
    PrintLn("poke done");
    
    // Now peek - this may crash
    var v: int64 := peek8(addr);
    Print("peek done: ");
    PrintLn(v);
    
    return 0;
}