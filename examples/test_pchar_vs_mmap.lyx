// Compare pchar vs mmap buffer for same operation
import std.net.syscalls;
import std.net.socket;

fn main(): int64 {
    var conn: TCPConn := TCPConnect(0x7F000001, 6379);
    if (conn.fd < 0) { return 1; }
    PrintLn("connected");
    
    var my_fd: int64 := conn.fd;
    
    // Test 1: pchar buffer
    var req: pchar := "*1\r\n$4\r\nPING\r\n";
    Write(my_fd, req, 18);
    
    var pbuf: pchar := "                    ";
    var n: int64 := Read(my_fd, pbuf, 32);
    Print("pchar read n = ");
    PrintLn(n);
    Print(", pbuf = [");
    Print(pbuf);
    PrintLn("]");
    
    // Test 2: mmap buffer (same operation)
    Write(my_fd, req, 18);
    
    var mbuf: int64 := mmap(0, 64, 3, 34, -1, 0);
    Print("mmap returned = ");
    PrintLn(mbuf);
    
    n := Read(my_fd, mbuf, 64);
    Print("mmap read n = ");
    PrintLn(n);
    
    // Check bytes
    var i: int64 := 0;
    Print("mmap bytes: ");
    while (i < 10) {
        PrintLn(peek8(mbuf + i));
        Print(" ");
        i := i + 1;
    }
    PrintLn("");
    
    munmap(mbuf, 64);
    Close(conn.fd);
    return 0;
}