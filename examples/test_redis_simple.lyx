// Simple Redis test - using TCPConn
import std.net.socket;

fn main(): int64 {
    PrintLn("=== Redis Simple Test ===");
    
    // Connect using high-level TCPConn
    var conn: TCPConn := TCPConnect(0x7F000001, 6379);  // 127.0.0.1 in network byte order
    
    if (conn.fd < 0) {
        PrintLn("Failed to connect");
        return 1;
    }
    
    Print("Connected! FD = ");
    PrintLn(conn.fd);
    
    // Send PING using TCPConn
    var req: pchar := "*1\r\n$4\r\nPING\r\n";
    var sent: int64 := TCPConnWrite(conn, req as pchar, 18);
    
    Print("Sent bytes: ");
    PrintLn(sent);
    
    // Read response
    var buf: pchar := "                ";
    var n: int64 := TCPConnRead(conn, buf as pchar, 32);
    
    Print("Read bytes: ");
    PrintLn(n);
    Print("\nResponse: ");
    Print(buf);
    PrintLn("");
    
    // Close
    TCPConnClose(conn);
    PrintLn("Done.");
    
    return 0;
}