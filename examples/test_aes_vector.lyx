// Simple AES block test using known test vector
//
// Die Puffer kommen aus alloc(), nicht aus String-Literalen. Bis 1.2.11H stand
// hier `var key: pchar := "                ";` und danach StrSetChar darauf —
// ein Literal ist aber kein Schreibpuffer, und der expandierte Schluessel
// (176 Byte) lief in ein Literal von 64 Zeichen. Auf x86 kam das Programm
// durch und meldete DECRYPT TEST FAILED, auf riscv stuerzte es beim ersten
// Schreibzugriff ab, auf arm64 ueberschrieb es, was hinter dem Literal lag.
import std.crypto.aes;
import std.alloc;

fn PrintHexBytes(label: pchar, data: pchar, len: int64) {
    Print(label);
    var i: int64 := 0;
    while (i < len) {
        var b: int64 := StrCharAt(data, i);
        if (b < 16) { Print("0"); }
        PrintLn(b);
        Print(" ");
        i := i + 1;
    }
    PrintLn("");
}

fn StrEqual(a: pchar, b: pchar, len: int64): bool {
    var i: int64 := 0;
    while (i < len) {
        if (StrCharAt(a, i) != StrCharAt(b, i)) { return false; }
        i := i + 1;
    }
    return true;
}

fn main(): int64 {
    PrintLn("=== AES Known Vector Test ===\n");
    
    // Test from FIPS-197 Appendix B
    // Key: 2b 7e 15 16 28 ae d2 a6 ab f7 15 88 09 cf 4f 3c
    // Plaintext: 32 43 f6 a8 88 5a 30 8d 31 31 98 a2 e0 37 07 34
    // Ciphertext: 39 25 84 1d 02 dc 09 fb dc 11 85 97 19 6a 0b 32
    //
    // Der Vektor aus FIPS-197, Anhang B. Hier standen bis 1.2.11H sechzehn Bytes,
    // die nur in den ersten drei stimmten — der Test meldete deshalb FAILED,
    // obwohl die Bibliothek richtig rechnet. Nachgerechnet mit:
    //   printf '\x32\x43\xf6\xa8\x88\x5a\x30\x8d\x31\x31\x98\xa2\xe0\x37\x07\x34' |
    //     openssl enc -aes-128-ecb -nopad -K 2b7e151628aed2a6abf7158809cf4f3c | xxd -p
    
    var key: pchar := alloc(16) as pchar;
    StrSetChar(key, 0, 0x2b); StrSetChar(key, 1, 0x7e); StrSetChar(key, 2, 0x15); StrSetChar(key, 3, 0x16);
    StrSetChar(key, 4, 0x28); StrSetChar(key, 5, 0xae); StrSetChar(key, 6, 0xd2); StrSetChar(key, 7, 0xa6);
    StrSetChar(key, 8, 0xab); StrSetChar(key, 9, 0xf7); StrSetChar(key, 10, 0x15); StrSetChar(key, 11, 0x88);
    StrSetChar(key, 12, 0x09); StrSetChar(key, 13, 0xcf); StrSetChar(key, 14, 0x4f); StrSetChar(key, 15, 0x3c);
    
    var plaintext: pchar := alloc(16) as pchar;
    StrSetChar(plaintext, 0, 0x32); StrSetChar(plaintext, 1, 0x43); StrSetChar(plaintext, 2, 0xf6); StrSetChar(plaintext, 3, 0xa8);
    StrSetChar(plaintext, 4, 0x88); StrSetChar(plaintext, 5, 0x5a); StrSetChar(plaintext, 6, 0x30); StrSetChar(plaintext, 7, 0x8d);
    StrSetChar(plaintext, 8, 0x31); StrSetChar(plaintext, 9, 0x31); StrSetChar(plaintext, 10, 0x98); StrSetChar(plaintext, 11, 0xa2);
    StrSetChar(plaintext, 12, 0xe0); StrSetChar(plaintext, 13, 0x37); StrSetChar(plaintext, 14, 0x07); StrSetChar(plaintext, 15, 0x34);
    
    // Expected ciphertext from FIPS-197
    var expected: pchar := alloc(16) as pchar;
    StrSetChar(expected, 0, 0x39); StrSetChar(expected, 1, 0x25); StrSetChar(expected, 2, 0x84); StrSetChar(expected, 3, 0x1d);
    StrSetChar(expected, 4, 0x02); StrSetChar(expected, 5, 0xdc); StrSetChar(expected, 6, 0x09); StrSetChar(expected, 7, 0xfb);
    StrSetChar(expected, 8, 0xdc); StrSetChar(expected, 9, 0x11); StrSetChar(expected, 10, 0x85); StrSetChar(expected, 11, 0x97);
    StrSetChar(expected, 12, 0x19); StrSetChar(expected, 13, 0x6a); StrSetChar(expected, 14, 0x0b); StrSetChar(expected, 15, 0x32);
    
    PrintHexBytes("Key:       ", key, 16);
    PrintHexBytes("Plaintext: ", plaintext, 16);
    PrintHexBytes("Expected:  ", expected, 16);
    
    // Expand key
    var expanded: pchar := alloc(176) as pchar;   // 11 Rundenschluessel zu 16 Byte
    AES128KeyExpand(key, expanded);
    
    // Test single block encryption
    var work: pchar := alloc(16) as pchar;
    var i: int64 := 0;
    while (i < 16) {
        StrSetChar(work, i, StrCharAt(plaintext, i));
        i := i + 1;
    }
    
    AESEncryptBlockWithKey(work, expanded, 10);
    
    PrintHexBytes("Got:       ", work, 16);
    
    if (StrEqual(work, expected, 16)) {
        PrintLn("\n*** AES BLOCK TEST PASSED! ***");
    } else {
        PrintLn("\n*** AES BLOCK TEST FAILED! ***");
    }
    
    // Now test decryption (roundtrip)
    PrintLn("\n--- Roundtrip Test ---");
    var cipher: pchar := alloc(16) as pchar;
    i := 0;
    while (i < 16) {
        StrSetChar(cipher, i, StrCharAt(expected, i));
        i := i + 1;
    }
    
    // Decrypt
    var decrypted: pchar := alloc(16) as pchar;
    i := 0;
    while (i < 16) {
        StrSetChar(decrypted, i, StrCharAt(cipher, i));
        i := i + 1;
    }
    
    AESDecryptBlockWithKey(decrypted, expanded, 10);
    
    PrintHexBytes("Original plaintext: ", plaintext, 16);
    PrintHexBytes("After decrypt:       ", decrypted, 16);
    
    if (StrEqual(decrypted, plaintext, 16)) {
        PrintLn("\n*** DECRYPT TEST PASSED! ***");
    } else {
        PrintLn("\n*** DECRYPT TEST FAILED! ***");
    }
    
    return 0;
}