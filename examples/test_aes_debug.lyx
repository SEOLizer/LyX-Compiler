// Debug test for AES components
import std.crypto.aes;

fn PrintHexBytes(label: pchar, data: pchar, len: int64) {
    Print(label);
    var i: int64 := 0;
    while (i < len) {
        var b: int64 := StrCharAt(data, i);
        Print(" ");
        PrintLn(b);
        i := i + 1;
    }
    PrintLn("");
}

fn main(): int64 {
    PrintLn("=== AES Component Debug Test ===\n");
    
    // Test GF inverse for known values
    PrintLn("Testing GF_inv:");
    Print("GF_inv(1) = ");
    PrintLn(GF_inv_simple(1));
    PrintLn(" (should be 1)");
    
    Print("GF_inv(2) = ");
    PrintLn(GF_inv_simple(2));
    PrintLn(" (should be 0xD4)");
    
    Print("GF_inv(3) = ");
    PrintLn(GF_inv_simple(3));
    PrintLn(" (should be 0xB4)");
    
    PrintLn("\nTesting SubByte:");
    Print("SubByte(0) = ");
    PrintLn(SubByte(0));
    PrintLn(" (should be 0x63)");
    
    Print("SubByte(0xFF) = ");
    PrintLn(SubByte(0xFF));
    PrintLn(" (should be 0x16)");
    
    PrintLn("\nTesting InvSubByte:");
    // Known S-Box values
    Print("InvSubByte(0x63) = ");
    PrintLn(InvSubByte(0x63));
    PrintLn(" (should be 0)");
    
    Print("InvSubByte(0x7C) = ");
    PrintLn(InvSubByte(0x7C));
    PrintLn(" (should be 0x77)");
    
    // Test roundtrip
    PrintLn("\nTesting SubByte/InvSubByte roundtrip:");
    var test_val: int64 := 0xAB;
    var subbed: int64 := SubByte(test_val);
    var unsubbed: int64 := InvSubByte(subbed);
    Print("Original: ");
    PrintLn(test_val);
    Print(", Subbed: ");
    PrintLn(subbed);
    Print(", Unsubbed: ");
    PrintLn(unsubbed);
    if (unsubbed == test_val) {
        PrintLn(" - PASS");
    } else {
        PrintLn(" - FAIL");
    }
    
    // Test GF multiplication
    PrintLn("\nTesting GF_mul:");
    Print("GF_mul(141, 2) = ");
    PrintLn(GF_mul(141, 2));
    PrintLn(" (should be 1)");
    
    Print("GF_mul(212, 2) = ");
    PrintLn(GF_mul(212, 2));
    PrintLn(" (should be 1)");
    
    // Test roundtrip with more values
    var k: int64 := 0;
    var failures: int64 := 0;
    while (k < 256) {
        var s: int64 := SubByte(k);
        var u: int64 := InvSubByte(s);
        if (u != k) {
            if (failures < 5) {
                Print("FAIL at ");
                PrintLn(k);
                Print(": Sub=");
                PrintLn(s);
                Print(" InvSub=");
                PrintLn(u);
            }
            failures := failures + 1;
        }
        k := k + 1;
    }
    Print("Total SubByte/InvSubByte failures: ");
    PrintLn(failures);
    
    // Test key expansion
    PrintLn("\nTesting Key Expansion:");
    var test_key: pchar := "                ";
    StrSetChar(test_key, 0, 0x2b);
    StrSetChar(test_key, 1, 0x7e);
    StrSetChar(test_key, 2, 0x15);
    StrSetChar(test_key, 3, 0x16);
    StrSetChar(test_key, 4, 0x28);
    StrSetChar(test_key, 5, 0xae);
    StrSetChar(test_key, 6, 0xd2);
    StrSetChar(test_key, 7, 0xa6);
    StrSetChar(test_key, 8, 0xab);
    StrSetChar(test_key, 9, 0xf7);
    StrSetChar(test_key, 10, 0x15);
    StrSetChar(test_key, 11, 0x88);
    StrSetChar(test_key, 12, 0x09);
    StrSetChar(test_key, 13, 0xcf);
    StrSetChar(test_key, 14, 0x4f);
    StrSetChar(test_key, 15, 0x3c);
    
    var expanded: pchar := "                                                                ";
    AES128KeyExpand(test_key, expanded);
    
    Print("Expanded key[0-15]: ");
    var i: int64 := 0;
    while (i < 16) {
        PrintLn(StrCharAt(expanded, i));
        Print(" ");
        i := i + 1;
    }
    PrintLn("");
    
    // Known AES-128 test vector (from FIPS-197)
    // Key: 2b 7e 15 16 28 ae d2 a6 ab f7 15 88 09 cf 4f 3c
    // Expected first round key word: a0 fa fe 17
    PrintLn("Expected first round key[0-3]: 160 250 254 23");
    
    PrintLn("\n=== Test Complete ===");
    exit(0);
}