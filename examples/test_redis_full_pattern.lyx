// Test: PING (struct) -> DEL (int64) -> LPUSH -> LPUSH -> LPOP -> RPOP
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    // PING returns bool (int64)
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    // DEL returns int64
    var delres: int64 := RedisDel(conn, "mylist");
    Print("DEL = ");
    PrintLn(delres);
    
    // LPUSH returns struct
    var r: RedisReply := RedisLPush(conn, "mylist", "first");
    PrintLn("LPUSH1 done");
    
    // LPUSH returns struct
    r := RedisLPush(conn, "mylist", "second");
    PrintLn("LPUSH2 done");
    
    // LPOP returns struct (BULK string)
    r := RedisLPop(conn, "mylist");
    Print("LPOP done, kind=");
    PrintLn(r.kind);
    
    // RPOP returns struct
    r := RedisRPop(conn, "mylist");
    Print("RPOP done, kind=");
    PrintLn(r.kind);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}