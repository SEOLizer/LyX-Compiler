// Threading Library Test

import std.thread;
import std.io;

pub fn main(): int64 {
  // Test 1: ThreadSelf
  var tid: int64 := ThreadSelf();
  Print("ThreadSelf: ");
  PrintIntLn(tid);
  
  // Test 2: Mutex
  var mutex: Mutex := MutexNew();
  MutexLock(mutex);
  PrintLn("Mutex lock: OK");
  MutexUnlock(mutex);
  PrintLn("Mutex unlock: OK");
  
  // Test 3: Atomic
  var atomic: Atomic := AtomicNew(10);
  var old: int64 := AtomicAdd(atomic, 5);
  Print("AtomicAdd new value: ");
  PrintIntLn(old);
  
  // Test 4: CAS
  var result: int64 := CAS(atomic, 15, 20);
  Print("CAS result: ");
  PrintIntLn(result);
  
  // Test 5: Shared memory
  var mem: SharedMem := SharedMemCreate(1024);
  if (mem.data != 0) {
    PrintLn("SharedMemCreate: OK");
    SharedMemFree(mem);
  }
  
  PrintLn("All tests passed!");
  
  return 0;
}