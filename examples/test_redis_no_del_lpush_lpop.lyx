// Test: just LPUSH, LPUSH, LPOP, LPOP - without any DEL first
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    }
    
    // NO DEL! Just LPUSH, LPUSH, LPOP, LPOP
    var r: RedisReply := RedisLPush(conn, "mylist", "a");
    PrintLn("LPUSH1 done");
    
    r := RedisLPush(conn, "mylist", "b");
    PrintLn("LPUSH2 done");
    
    r := RedisLPop(conn, "mylist");
    PrintLn("LPOP1 done");
    
    r := RedisLPop(conn, "mylist");
    PrintLn("LPOP2 done");
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}