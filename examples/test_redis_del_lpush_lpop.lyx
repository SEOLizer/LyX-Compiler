// Test DEL (int64) -> LPOP (struct)
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    // DEL returns int64
    var delres: int64 := RedisDel(conn, "mylist");
    Print("DEL result = ");
    PrintLn(delres);
    
    // Setup list
    RedisLPush(conn, "mylist", "a");
    RedisLPush(conn, "mylist", "b");
    PrintLn("Setup done");
    
    // LPOP returns struct
    var r: RedisReply := RedisLPop(conn, "mylist");
    Print("LPOP done, kind=");
    PrintLn(r.kind);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}