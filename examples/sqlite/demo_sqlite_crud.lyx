// Demo 1 — SQLite CRUD-Grundlagen
// Tabelle anlegen, 5 Zeilen einfügen, SELECT, UPDATE, DELETE

import std.io;
import std.db.sqlite;

pub fn main(): int64 {
  PrintStr("=== Demo 1: SQLite CRUD-Grundlagen ===\n\n");

  var db: int64 := SQLiteOpen(":memory:");
  SQLiteExec(db, "CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, age INTEGER)");

  // INSERT 5 Zeilen
  var ins: int64 := SQLiteStmtPrepare(db, "INSERT INTO users (name, age) VALUES (?, ?)");
  SQLiteBindStr(ins, 1, "Alice");   SQLiteBindInt(ins, 2, 30); SQLiteStmtStep(ins); SQLiteStmtReset(ins);
  SQLiteBindStr(ins, 1, "Bob");     SQLiteBindInt(ins, 2, 25); SQLiteStmtStep(ins); SQLiteStmtReset(ins);
  SQLiteBindStr(ins, 1, "Charlie"); SQLiteBindInt(ins, 2, 35); SQLiteStmtStep(ins); SQLiteStmtReset(ins);
  SQLiteBindStr(ins, 1, "Diana");   SQLiteBindInt(ins, 2, 28); SQLiteStmtStep(ins); SQLiteStmtReset(ins);
  SQLiteBindStr(ins, 1, "Eve");     SQLiteBindInt(ins, 2, 22); SQLiteStmtStep(ins);
  SQLiteStmtFinalize(ins);

  // SELECT alle
  PrintStr("--- Initiale Tabelle ---\n");
  var sel: int64 := SQLiteStmtPrepare(db, "SELECT id, name, age FROM users ORDER BY id");
  while (SQLiteStmtStep(sel) == SQLITE_ROW) {
    PrintInt(SQLiteColumnInt(sel, 0)); PrintStr("  ");
    PrintStr(SQLiteColumnText(sel, 1)); PrintStr("  (");
    PrintInt(SQLiteColumnInt(sel, 2)); PrintStr(")\n");
  }
  SQLiteStmtFinalize(sel);

  // UPDATE
  SQLiteExec(db, "UPDATE users SET age=31 WHERE name='Alice'");
  PrintStr("\nUPDATE: Alice -> age=31\n");
  PrintStr("Geänderte Zeilen: "); PrintInt(SQLiteChanges(db)); PrintStr("\n");

  // DELETE
  SQLiteExec(db, "DELETE FROM users WHERE name='Eve'");
  PrintStr("\nDELETE: Eve entfernt\n");

  // SELECT nach Änderungen
  PrintStr("\n--- Tabelle nach UPDATE + DELETE ---\n");
  sel := SQLiteStmtPrepare(db, "SELECT id, name, age FROM users ORDER BY id");
  while (SQLiteStmtStep(sel) == SQLITE_ROW) {
    PrintInt(SQLiteColumnInt(sel, 0)); PrintStr("  ");
    PrintStr(SQLiteColumnText(sel, 1)); PrintStr("  (");
    PrintInt(SQLiteColumnInt(sel, 2)); PrintStr(")\n");
  }
  SQLiteStmtFinalize(sel);

  SQLiteClose(db);
  return 0;
}
