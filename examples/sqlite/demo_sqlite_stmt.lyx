// Demo 3 — Prepared Statement Re-Use
// Einzelnes Prepared Statement 100× mit verschiedenen Bindings wiederverwenden

import std.io;
import std.db.sqlite;

pub fn main(): int64 {
  PrintStr("=== Demo 3: Prepared Statement Re-Use ===\n\n");

  var db: int64 := SQLiteOpen(":memory:");
  SQLiteExec(db, "CREATE TABLE scores (id INTEGER PRIMARY KEY, player TEXT, points INTEGER)");

  // Einmal vorbereiten, 100× ausführen
  var ins: int64 := SQLiteStmtPrepare(db, "INSERT INTO scores (player, points) VALUES (?, ?)");
  var nameBuf: int64 := mmap(0, 32, 3, 34, -1, 0);

  var i: int64 := 0;
  while (i < 100) {
    // Spielername "Player_NN" zusammenbauen
    poke8(nameBuf,      80);  // P
    poke8(nameBuf + 1,  108); // l
    poke8(nameBuf + 2,  97);  // a
    poke8(nameBuf + 3,  121); // y
    poke8(nameBuf + 4,  101); // e
    poke8(nameBuf + 5,  114); // r
    poke8(nameBuf + 6,  95);  // _
    // Nummer (2-stellig)
    var tens: int64 := i / 10;
    var ones: int64 := i % 10;
    poke8(nameBuf + 7,  48 + tens);
    poke8(nameBuf + 8,  48 + ones);
    poke8(nameBuf + 9,  0);

    SQLiteBindStr(ins, 1, nameBuf);
    SQLiteBindInt(ins, 2, i * 10 + 5);
    SQLiteStmtStep(ins);
    SQLiteStmtReset(ins);
    i := i + 1;
  }
  SQLiteStmtFinalize(ins);
  munmap(nameBuf, 32);

  // Alle 100 Zeilen prüfen
  var sel: int64 := SQLiteStmtPrepare(db, "SELECT COUNT(*) FROM scores");
  SQLiteStmtStep(sel);
  var cnt: int64 := SQLiteColumnInt(sel, 0);
  SQLiteStmtFinalize(sel);
  PrintStr("Eingefügte Zeilen: "); PrintInt(cnt); PrintStr(" (erwartet 100)\n\n");

  // Erste und letzte Zeile ausgeben
  sel := SQLiteStmtPrepare(db, "SELECT id, player, points FROM scores ORDER BY id LIMIT 3");
  PrintStr("Erste 3 Einträge:\n");
  while (SQLiteStmtStep(sel) == SQLITE_ROW) {
    PrintInt(SQLiteColumnInt(sel, 0)); PrintStr("  ");
    PrintStr(SQLiteColumnText(sel, 1)); PrintStr("  ");
    PrintInt(SQLiteColumnInt(sel, 2)); PrintStr(" Punkte\n");
  }
  SQLiteStmtFinalize(sel);

  sel := SQLiteStmtPrepare(db, "SELECT id, player, points FROM scores ORDER BY id DESC LIMIT 3");
  PrintStr("\nLetzte 3 Einträge:\n");
  while (SQLiteStmtStep(sel) == SQLITE_ROW) {
    PrintInt(SQLiteColumnInt(sel, 0)); PrintStr("  ");
    PrintStr(SQLiteColumnText(sel, 1)); PrintStr("  ");
    PrintInt(SQLiteColumnInt(sel, 2)); PrintStr(" Punkte\n");
  }
  SQLiteStmtFinalize(sel);

  // Punktesumme als Integritätscheck: sum(i*10+5 for i in 0..99) = 10*sum(0..99)+500 = 49500+500 = 50000
  sel := SQLiteStmtPrepare(db, "SELECT SUM(points) FROM scores");
  SQLiteStmtStep(sel);
  var total: int64 := SQLiteColumnInt(sel, 0);
  SQLiteStmtFinalize(sel);
  PrintStr("\nPunktesumme: "); PrintInt(total); PrintStr(" (erwartet 50000)\n");

  SQLiteClose(db);
  return 0;
}
