// Demo 4 — NULL & Typprüfung
// Tabelle mit INTEGER, REAL, TEXT, BLOB, NULL-Spalten
// SQLiteColumnType / SQLiteColumnIsNull für jede Spalte prüfen

import std.io;
import std.db.sqlite;

fn typeName(t: int64): pchar {
  if (t == SQLITE_INTEGER) { return "INTEGER"; }
  if (t == SQLITE_FLOAT)   { return "FLOAT";   }
  if (t == SQLITE_TEXT)    { return "TEXT";     }
  if (t == SQLITE_BLOB)    { return "BLOB";     }
  if (t == SQLITE_NULL)    { return "NULL";     }
  return "UNKNOWN";
}

pub fn main(): int64 {
  PrintLn("=== Demo 4: NULL & Typprüfung ===\n");

  var db: int64 := SQLiteOpen(":memory:");
  SQLiteExec(db, "CREATE TABLE mixed (a INTEGER, b REAL, c TEXT, d BLOB, e INTEGER)");

  // Zeile mit allen Typen + einer NULL-Spalte einfügen
  var blob: int64 := mmap(0, 4, 3, 34, -1, 0);
  poke8(blob, 0xDE); poke8(blob + 1, 0xAD); poke8(blob + 2, 0xBE); poke8(blob + 3, 0xEF);

  var ins: int64 := SQLiteStmtPrepare(db, "INSERT INTO mixed VALUES (?, ?, ?, ?, ?)");
  SQLiteBindInt(ins, 1, 42);
  SQLiteBindFloat(ins, 2, 3.14);
  SQLiteBindStr(ins, 3, "hello");
  SQLiteBindBlob(ins, 4, blob, 4);
  SQLiteBindNull(ins, 5);
  SQLiteStmtStep(ins);
  SQLiteStmtFinalize(ins);
  munmap(blob, 4);

  // Jeden Spaltentyp prüfen
  var sel: int64 := SQLiteStmtPrepare(db, "SELECT a, b, c, d, e FROM mixed");
  SQLiteStmtStep(sel);

  PrintLn("Spalte  Typ       IsNull  Wert");
  PrintLn("------  --------  ------  --------");

  // a: INTEGER
  var t: int64 := SQLiteColumnType(sel, 0);
  Print("a       "); Print(typeName(t)); Print("  ");
  if (SQLiteColumnIsNull(sel, 0)) { Print("true  "); } else { Print("false  "); }
  PrintLn(StrFromInt(SQLiteColumnInt(sel, 0)));

  // b: FLOAT
  t := SQLiteColumnType(sel, 1);
  Print("b       "); Print(typeName(t)); Print("     ");
  if (SQLiteColumnIsNull(sel, 1)) { Print("true  "); } else { Print("false  "); }
  PrintFloat(SQLiteColumnFloat(sel, 1)); PrintLn("");

  // c: TEXT
  t := SQLiteColumnType(sel, 2);
  Print("c       "); Print(typeName(t)); Print("      ");
  if (SQLiteColumnIsNull(sel, 2)) { Print("true  "); } else { Print("false  "); }
  PrintLn(SQLiteColumnText(sel, 2));

  // d: BLOB
  t := SQLiteColumnType(sel, 3);
  var bLen: int64 := SQLiteColumnBytes(sel, 3);
  Print("d       "); Print(typeName(t)); Print("      ");
  if (SQLiteColumnIsNull(sel, 3)) { Print("true  "); } else { Print("false  "); }
  Print("("); Print(StrFromInt(bLen)); PrintLn(" Bytes)");

  // e: NULL
  t := SQLiteColumnType(sel, 4);
  Print("e       "); Print(typeName(t)); Print("       ");
  if (SQLiteColumnIsNull(sel, 4)) { Print("true  "); } else { Print("false  "); }
  PrintLn("(null)");

  SQLiteStmtFinalize(sel);
  SQLiteClose(db);
  return 0;
}
