// Demo 2 — Transaktion Batch-Insert
// 10.000 Rows ohne Transaktion vs. in einer Transaktion
// Zeigt Zeitdifferenz via clock_gettime (CLOCK_MONOTONIC)

import std.io;
import std.db.sqlite;

fn msNow(): int64 {
  var ts: int64 := mmap(0, 16, 3, 34, -1, 0);
  clock_gettime(1, ts);
  var ms: int64 := peek64(ts) * 1000 + peek64(ts + 8) / 1000000;
  munmap(ts, 16);
  return ms;
}

pub fn main(): int64 {
  PrintLn("=== Demo 2: Transaktion Batch-Insert ===\n");

  var N: int64 := 10000;
  var i: int64 := 0;
  var stmt: int64 := 0;
  var t0: int64 := 0;

  // ── Ohne Transaktion ────────────────────────────────────────────────────────
  var db: int64 := SQLiteOpen("/tmp/demo_sqlite_notx.db");
  SQLiteExec(db, "PRAGMA synchronous=FULL");
  SQLiteExec(db, "CREATE TABLE IF NOT EXISTS t (v INTEGER)");
  stmt := SQLiteStmtPrepare(db, "INSERT INTO t VALUES (?)");

  t0 := msNow();
  i := 0;
  while (i < N) {
    SQLiteBindInt(stmt, 1, i);
    SQLiteStmtStep(stmt);
    SQLiteStmtReset(stmt);
    i := i + 1;
  }
  var tNoTx: int64 := msNow() - t0;
  SQLiteStmtFinalize(stmt);
  SQLiteClose(db);

  // ── Mit Transaktion ─────────────────────────────────────────────────────────
  db := SQLiteOpen("/tmp/demo_sqlite_tx.db");
  SQLiteExec(db, "PRAGMA synchronous=FULL");
  SQLiteExec(db, "CREATE TABLE IF NOT EXISTS t (v INTEGER)");
  stmt := SQLiteStmtPrepare(db, "INSERT INTO t VALUES (?)");

  t0 := msNow();
  SQLiteBegin(db);
  i := 0;
  while (i < N) {
    SQLiteBindInt(stmt, 1, i);
    SQLiteStmtStep(stmt);
    SQLiteStmtReset(stmt);
    i := i + 1;
  }
  SQLiteCommit(db);
  var tTx: int64 := msNow() - t0;
  SQLiteStmtFinalize(stmt);
  SQLiteClose(db);

  // ── Ergebnis ────────────────────────────────────────────────────────────────
  Print("10.000 Inserts ohne Transaktion: "); Print(StrFromInt(tNoTx)); PrintLn(" ms");
  Print("10.000 Inserts mit  Transaktion: "); Print(StrFromInt(tTx));   PrintLn(" ms");
  Print("Speedup: ~"); Print(StrFromInt(tNoTx / (tTx + 1))); PrintLn("x");

  return 0;
}
