// Demo 5 — Blob-Roundtrip
// 1 KB Buffer mit deterministischen Daten per mmap anlegen,
// als BLOB in SQLite speichern, lesen und byteweise vergleichen

import std.io;
import std.db.sqlite;
import std.alloc;

pub fn main(): int64 {
  PrintLn("=== Demo 5: Blob-Roundtrip ===\n");

  var BUF_LEN: int64 := 1024;

  // 1 KB Puffer mit deterministischem Muster füllen
  // Muster: byte[i] = (i*7 + 13) & 0xFF  → alle 256 Werte gut verteilt
  var src: int64 := alloc(BUF_LEN);
  var i: int64 := 0;
  while (i < BUF_LEN) {
    poke8(src + i, (i * 7 + 13) & 0xFF);
    i := i + 1;
  }
  Print("Puffer angelegt: "); Print(StrFromInt(BUF_LEN)); PrintLn(" Bytes");
  Print("Erste 4 Bytes: ");
  Print(StrFromInt(peek8(src)));     Print(" ");
  Print(StrFromInt(peek8(src + 1))); Print(" ");
  Print(StrFromInt(peek8(src + 2))); Print(" ");
  Print(StrFromInt(peek8(src + 3))); PrintLn("\n");

  var db: int64 := SQLiteOpen(":memory:");
  SQLiteExec(db, "CREATE TABLE blobs (id INTEGER PRIMARY KEY, data BLOB)");

  // INSERT
  var ins: int64 := SQLiteStmtPrepare(db, "INSERT INTO blobs (data) VALUES (?)");
  SQLiteBindBlob(ins, 1, src, BUF_LEN);
  SQLiteStmtStep(ins);
  SQLiteStmtFinalize(ins);
  Print("BLOB gespeichert (id="); Print(StrFromInt(SQLiteLastInsertId(db))); PrintLn(")");

  // SELECT & Vergleich
  var sel: int64 := SQLiteStmtPrepare(db, "SELECT data FROM blobs WHERE id=1");
  SQLiteStmtStep(sel);

  var readLen: int64 := SQLiteColumnBytes(sel, 0);
  var readPtr: int64 := SQLiteColumnBlob(sel, 0);

  Print("Gelesene Länge: "); Print(StrFromInt(readLen)); PrintLn(" Bytes");

  var mismatches: int64 := 0;
  if (readLen == BUF_LEN) {
    i := 0;
    while (i < BUF_LEN) {
      if (peek8(readPtr + i) != peek8(src + i)) {
        mismatches := mismatches + 1;
      }
      i := i + 1;
    }
  } else {
    mismatches := -1;
  }

  SQLiteStmtFinalize(sel);

  if (mismatches == 0) {
    PrintLn("Byte-Vergleich: 0 Unterschiede — Roundtrip erfolgreich!");
  } else {
    Print("Byte-Vergleich: "); Print(StrFromInt(mismatches)); PrintLn(" Unterschiede");
  }

  free(src, BUF_LEN);
  SQLiteClose(db);
  return 0;
}
