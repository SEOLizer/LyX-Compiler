// Zeit & Datum Demo
// Demonstrates: Zeitberechnungen, Datumsfunktionen

fn main(): int64 {
    PrintLn("=== Zeit und Datum Demo ===\n");
    
    // Unix Epoch erklaeren
    PrintLn("Unix Epoch (Zeit seit 1.1.1970):");
    PrintLn("-------------------------------");
    PrintLn("1 Tag = 86400 Sekunden");
    PrintLn("1 Jahr (365 Tage) = 31536000 Sekunden");
    PrintLn("");
    
    // Aktuelle Zeit (simuliert)
    PrintLn("Aktuelle Zeit (Beispielwerte):");
    PrintLn("-------------------------------");
    
    var timestamps: [4]int64;
    timestamps[0] := 0;           // 1.1.1970 00:00:00
    timestamps[1] := 86400;        // 2.1.1970 00:00:00
    timestamps[2] := 1000000000;  // ~9.9.2001
    timestamps[3] := 1700000000;  // ~15.11.2023
    
    var i: int64 := 0;
    while (i < 4) {
        Print("Timestamp ");
        PrintLn(timestamps[i]);
        Print(" = ");
        
        // Berechne Tage
        var days: int64 := timestamps[i] / 86400;
        PrintLn(days);
        PrintLn(" Tage seit Epoch");
        
        i := i + 1;
    }
    
    PrintLn("");
    
    // Datumsberechnung erklaeren
    PrintLn("Datum aus Timestamp berechnen:");
    PrintLn("-----------------------------");
    PrintLn("1. Tage seit Epoch / 365 = Jahre (grob)");
    PrintLn("2. Rest-Tage in Monate/Tage aufteilen");
    PrintLn("3. Schaltjahre beachten!");
    PrintLn("");
    
    // Schaltjahr-Check erklaeren
    PrintLn("Schaltjahr-Check:");
    PrintLn("-----------------");
    PrintLn("Ist teilbar durch 4? -> Ja");
    PrintLn("  Ist teilbar durch 100? -> Nein -> Schaltjahr");
    PrintLn("  Ist teilbar durch 400? -> Ja -> Schaltjahr");
    PrintLn("");
    
    // Beispiel-Berechnungen
    PrintLn("Beispiel-Berechnungen:");
    PrintLn("----------------------");
    
    var years: [5]int64;
    years[0] := 2020;
    years[1] := 2021;
    years[2] := 2022;
    years[3] := 2023;
    years[4] := 2024;
    
    i := 0;
    while (i < 5) {
        var y: int64 := years[i];
        
        Print("Jahr ");
        PrintLn(y);
        Print(": ");
        
        // Schaltjahr-Check
        if ((y % 4) == 0) {
            if ((y % 100) == 0) {
                if ((y % 400) == 0) {
                    PrintLn("Schaltjahr (durch 400)");
                } else {
                    PrintLn("Kein Schaltjahr");
                }
            } else {
                PrintLn("Schaltjahr (durch 4)");
            }
        } else {
            PrintLn("Kein Schaltjahr");
        }
        
        i := i + 1;
    }
    
    PrintLn("");
    
    // Zeit-Formate erklaeren
    PrintLn("Zeit-Formate:");
    PrintLn("-------------");
    PrintLn("Unix Timestamp: Sekunden seit Epoch (int64)");
    PrintLn("ISO 8601:      2024-01-15T14:30:00Z");
    PrintLn("RFC 2822:      Mon, 15 Jan 2024 14:30:00 +0000");
    PrintLn("Clock Time:    HH:MM:SS");
    PrintLn("");
    
    // Tageslaengen
    PrintLn("Tageslaengen (in Sekunden):");
    PrintLn("---------------------------");
    PrintLn("Normaler Tag:  86400");
    PrintLn("Schalttag:    86401");
    
    PrintLn("\n=== Demo abgeschlossen ===");
    
    return 0;
}