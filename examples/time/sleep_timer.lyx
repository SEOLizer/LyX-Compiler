// Sleep & Timer Demo
// Demonstrates: Zeit messen, Delays, Timer-Handling

fn main(): int64 {
    PrintLn("=== Sleep & Timer Demo ===\n");
    
    // Warte-Funktionen erklaeren
    PrintLn("Warte-Funktionen:");
    PrintLn("-----------------");
    PrintLn("sleep(seconds)    - Sekunden warten");
    PrintLn("usleep(microsek)  - Mikrosekunden warten");
    PrintLn("nanosleep(ns)    - Nanosekunden warten");
    PrintLn("");
    
    // Timer-Genauigkeit
    PrintLn("Timer-Genauigkeit:");
    PrintLn("------------------");
    PrintLn("Sekunde:      1.000.000.000 ns");
    PrintLn("Millisekunde: 1.000.000 ns");
    PrintLn("Mikrosekunde: 1.000 ns");
    PrintLn("Nanosekunde:  1 ns");
    PrintLn("");
    
    // Zeitmessung erklaeren
    PrintLn("Zeitmessung:");
    PrintLn("------------");
    PrintLn("clock()          - CPU-Zeit");
    PrintLn("time()           - Wall-Clock Zeit");
    PrintLn("gettimeofday()   - Mikrosekunden-Genauigkeit");
    PrintLn("clock_gettime()  - Nanosekunden-Genauigkeit");
    PrintLn("");
    
    // Simuliere Zeitmessung
    PrintLn("Simulierte Zeitmessung:");
    PrintLn("-----------------------");
    
    var iterations: int64 := 3;
    var i: int64 := 0;
    
    while (i < iterations) {
        Print("Iteration ");
        PrintLn(i + 1);
        PrintLn(" startet...");
        
        // Simuliere verschiedene Wartezeiten
        var wait_ms: int64 := (i + 1) * 100;
        
        Print("  Wartezeit: ");
        PrintLn(wait_ms);
        PrintLn(" ms");
        
        // Zeit vergeht...
        var j: int64 := 0;
        while (j < wait_ms * 100000) { j := j + 1; }
        
        Print("  Iteration ");
        PrintLn(i + 1);
        PrintLn(" abgeschlossen");
        
        i := i + 1;
    }
    
    PrintLn("");
    
    // Timer-Vergleich
    PrintLn("Timer-Typen:");
    PrintLn("------------");
    PrintLn("REALTIME     - Wall-Clock (echte Zeit)");
    PrintLn("MONOTONIC    - monotonische Zeit (Bootzeit)");
    PrintLn("PROCESS_CPUTIME - CPU-Zeit des Prozesses");
    PrintLn("THREAD_CPUTIME  - CPU-Zeit des Threads");
    PrintLn("");
    
    // Beispiel: Intervall-Timer
    PrintLn("Intervall-Timer Beispiel:");
    PrintLn("-------------------------");
    PrintLn("100ms Intervall -> 10 Updates pro Sekunde");
    PrintLn("1s Intervall    -> 1 Update pro Sekunde");
    PrintLn("10ms Intervall  -> 100 Updates pro Sekunde");
    PrintLn("");
    
    PrintLn("=== Demo abgeschlossen ===");
    
    return 0;
}