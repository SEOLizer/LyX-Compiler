// Stoppuhr Demo - Zeit messen
// Demonstrates: Zeitmessung, Stoppuhr-Funktionalitaet

fn main(): int64 {
    PrintLn("=== Stoppuhr Demo ===\n");
    
    // Stoppuhr-Erklaerung
    PrintLn("Stoppuhr-Funktionen:");
    PrintLn("---------------------");
    PrintLn("1. Start:  Zeit merken (Start-Zeitstempel)");
    PrintLn("2. Run:   Aktuelle Zeit - Start-Zeit");
    PrintLn("3. Stop:  Ende-Zeitstempel merken");
    PrintLn("4. Reset: Zeit auf 0 zuruecksetzen");
    PrintLn("");
    
    // Simuliere Stoppuhr
    PrintLn("Simulierte Stoppuhr:");
    PrintLn("====================\n");
    
    // Startzeit (simuliert)
    var start_time: int64 := 0;
    
    PrintLn("STOPPUHR GESTARTET");
    PrintLn("-------------------");
    
    // Run 1
    start_time := 0;
    var run1: int64 := 1000; // 1 Sekunde
    PrintLn("Run 1: 1000 ms = 1.000 s");
    PrintLn("        = 0 Min, 1.000 Sek");
    
    // Run 2
    start_time := 1000;
    var run2: int64 := 2500; // 2.5 Sekunden
    PrintLn("Run 2: 2500 ms = 2.500 s");
    PrintLn("        = 0 Min, 2.500 Sek");
    
    // Run 3
    start_time := 3500;
    var run3: int64 := 4520; // 4.52 Sekunden
    PrintLn("Run 3: 4520 ms = 4.520 s");
    PrintLn("        = 0 Min, 4.520 Sek");
    
    PrintLn("");
    
    // Runden-Zeiten (Lap Times)
    PrintLn("Runden-Zeiten (Laps):");
    PrintLn("----------------------");
    
    var lap_times: array[5]int64;
    lap_times[0] := 1000;   // Run 1
    lap_times[1] := 1500;   // Run 2 (1.5s nach Run 1)
    lap_times[2] := 2020;   // Run 3
    lap_times[3] := 3550;   // Run 4
    lap_times[4] := 5100;   // Run 5
    
    var total: int64 := 0;
    var i: int64 := 0;
    while (i < 5) {
        total := total + lap_times[i];
        
        Print("Run ");
        PrintLn(i + 1);
        Print(": ");
        
        // Zeit formatieren
        var seconds: int64 := lap_times[i] / 1000;
        var ms: int64 := lap_times[i] % 1000;
        
        PrintLn(seconds);
        Print(".");
        
        if (ms < 100) { Print("0"); }
        if (ms < 10) { Print("0"); }
        
        PrintLn(ms);
        PrintLn(" s");
        
        i := i + 1;
    }
    
    PrintLn("-------------------");
    Print("Gesamt: ");
    PrintLn(total);
    Print(" ms = ");
    PrintLn(total / 1000);
    Print(".");
    PrintLn(total % 1000);
    PrintLn(" s");
    
    PrintLn("");
    
    // Zeitformatierung erklaeren
    PrintLn("Zeitformatierung:");
    PrintLn("-----------------");
    PrintLn("mm:ss.ms   - Minuten, Sekunden, Millisekunden");
    PrintLn("hh:mm:ss   - Stunden, Minuten, Sekunden");
    PrintLn("ss.ms      - Sekunden mit Dezimalstellen");
    PrintLn("");
    
    // Umrechnung
    PrintLn("Umrechnungen:");
    PrintLn("-------------");
    PrintLn("1 Minute  = 60 Sekunden = 60000 ms");
    PrintLn("1 Stunde   = 3600 Sekunden = 3600000 ms");
    PrintLn("1 Tag      = 86400 Sekunden");
    PrintLn("");
    
    PrintLn("=== Demo abgeschlossen ===");
    
    return 0;
}