// Test mmap + poke16 + peek16 without any syscalls
fn main(): int64 {
    PrintLn("=== Simple mmap test ===");
    
    // mmap a buffer
    var buf: int64 := mmap(0, 4096, 3, 34, -1, 0);
    Print("mmap = ");
    PrintLn(buf);
    
    // Write a value
    poke16(buf, 65);  // 65 = 'A'
    PrintLn("Wrote 65");
    
    // Read it back
    var val: int64 := peek16(buf);
    Print("peek16 = ");
    PrintLn(val);
    
    // Write another value at offset 2
    poke16(buf + 2, 66);  // 66 = 'B'
    PrintLn("Wrote 66 at offset 2");
    
    // Read both
    var val2: int64 := peek16(buf);
    var val3: int64 := peek16(buf + 2);
    Print("peek16(buf) = ");
    PrintLn(val2);
    Print("peek16(buf+2) = ");
    PrintLn(val3);
    
    munmap(buf, 4096);
    PrintLn("Done");
    return 0;
}