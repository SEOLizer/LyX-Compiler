// Quick Sort Demo
// Demonstrates: Quick Sort Algorithmus (in-place partitioning)

fn main(): int64 {
    PrintLn("=== Quick Sort Demo ===\n");
    
    // Algorithmus erklaeren
    PrintLn("Quick Sort Algorithmus:");
    PrintLn("-----------------------");
    PrintLn("1. Waehle ein Pivot-Element (z.B. letztes Element)");
    PrintLn("2. Partitioniere: Alle kleineren links, alle groesseren rechts");
    PrintLn("3. Rekursiv: Sortiere linke und rechte Haelfte");
    PrintLn("");
    PrintLn("Zeitkomplexitaet:");
    PrintLn("  Durchschnitt: O(n log n)");
    PrintLn("  Schlimmster Fall: O(n^2) (wenn Pivot schlecht gewaehlt)");
    PrintLn("Speicher: O(log n) fuer Rekursion");
    PrintLn("");
    
    // Simuliere Quick Sort
    PrintLn("Beispiel-Array: [5, 2, 9, 1, 7, 6, 3]\n");
    
    // Array definieren
    var arr: [7]int64;
    arr[0] := 5;
    arr[1] := 2;
    arr[2] := 9;
    arr[3] := 1;
    arr[4] := 7;
    arr[5] := 6;
    arr[6] := 3;
    
    var len: int64 := 7;
    
    // Ausgabe vor dem Sortieren
    PrintLn("Vor dem Sortieren:");
    var i: int64 := 0;
    while (i < len) {
        PrintLn(arr[i]);
        Print(" ");
        i := i + 1;
    }
    PrintLn("\n");
    
    // Simuliere Partition-Schritte
    PrintLn("Partition-Schritte:");
    PrintLn("--------------------");
    PrintLn("Pivot = 3 (letztes Element)");
    PrintLn("Durchlauf: [1] 3 [5, 2, 9, 7, 6]");
    PrintLn("");
    PrintLn("Pivot = 6 (rechte Seite)");
    PrintLn("Links: [5, 2] 6 [9, 7]");
    PrintLn("");
    PrintLn("Pivot = 5");
    PrintLn("Links: [2] 5 [7, 9]");
    PrintLn("");
    PrintLn("Alle Teile sortiert.\n");
    
    // Ergebnis (simuliert)
    arr[0] := 1;
    arr[1] := 2;
    arr[2] := 3;
    arr[3] := 5;
    arr[4] := 6;
    arr[5] := 7;
    arr[6] := 9;
    
    PrintLn("Nach dem Sortieren:");
    i := 0;
    while (i < len) {
        PrintLn(arr[i]);
        Print(" ");
        i := i + 1;
    }
    PrintLn("\n");
    
    // Weitere Beispiele
    PrintLn("Weitere Beispiele:");
    PrintLn("------------------");
    
    var examples: [4]int64;
    examples[0] := 10;
    examples[1] := 8;
    examples[2] := 4;
    examples[3] := 2;
    
    PrintLn("[10, 8, 4, 2] -> [2, 4, 8, 10]");
    PrintLn("[3, 3, 3, 3] -> [3, 3, 3, 3] (alle gleich)");
    PrintLn("[1] -> [1] (ein Element)");
    PrintLn("[] -> [] (leer)");
    
    PrintLn("");
    
    // In-place Partition erklaeren
    PrintLn("In-Place Partition (Lomuto-Schema):");
    PrintLn("--------------------------------------");
    PrintLn("1. pivot = arr[rechts]");
    PrintLn("2. i = links - 1");
    PrintLn("3. fuer j = links bis rechts-1:");
    PrintLn("     wenn arr[j] <= pivot:");
    PrintLn("       i = i + 1");
    PrintLn("       tausche arr[i] und arr[j]");
    PrintLn("4. tausche arr[i+1] und arr[rechts]");
    PrintLn("5. return i + 1 (Pivot-Position)");
    
    PrintLn("\n=== Demo abgeschlossen ===");
    
    return 0;
}