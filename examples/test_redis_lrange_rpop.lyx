// Test: LRANGE + RPOP (no LPOP)
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    }
    
    RedisDel(conn, "mylist");
    var r: RedisReply := RedisLPush(conn, "mylist", "first");
    r := RedisLPush(conn, "mylist", "second");
    r := RedisRPush(conn, "mylist", "last");
    PrintLn("Setup done");
    
    var llen: int64 := RedisLLen(conn, "mylist");
    PrintLn("LLEN done");
    
    r := RedisLRange(conn, "mylist", 0, -1);
    PrintLn("LRANGE done");
    
    // RPOP - the 2nd struct return after LRANGE
    r := RedisRPop(conn, "mylist");
    PrintLn("RPOP done");
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}