// Try reading with larger count
import std.net.socket;

fn main(): int64 {
    PrintLn("=== Test larger read ===");
    
    var conn: TCPConn := TCPConnect(0x7F000001, 6379);
    if (conn.fd < 0) { PrintLn("Connect failed"); return 1; }
    PrintLn("Connected");
    
    // SET
    var req: pchar := "*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n";
    sys_write(conn.fd, req, 36);
    
    var buf: pchar := "                                                                                                                                ";
    var n: int64 := sys_read(conn.fd, buf, 128);  // Read up to 128 bytes
    Print("SET response n = ");
    PrintLn(n);
    
    // GET - use same large buffer
    req := "*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n";
    sys_write(conn.fd, req, 26);
    
    n := sys_read(conn.fd, buf, 128);  // Read up to 128 bytes
    Print("GET response n = ");
    PrintLn(n);
    Print(", buf = [");
    Print(buf);
    PrintLn("]");
    
    sys_close(conn.fd);
    PrintLn("Done");
    
    return 0;
}