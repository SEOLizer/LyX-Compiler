// Test RPOP specifically
import std.db.redis;

fn main(): int64 {
    PrintLn("Connecting...");
    var conn: RedisConn := RedisConnect("127.0.0.1", 6379);
    if (conn.fd < 0) {
        PrintLn("Connect failed");
        return 1;
    }
    PrintLn("Connected");
    
    if (RedisPing(conn)) {
        PrintLn("PING OK");
    } else {
        PrintLn("PING failed");
    }
    
    RedisDel(conn, "testlist");
    
    // Setup with RPUSH (since lists are typically used with RPUSH)
    var r: RedisReply := RedisRPush(conn, "testlist", "one");
    PrintLn("RPUSH one done");
    
    r := RedisRPush(conn, "testlist", "two");
    PrintLn("RPUSH two done");
    
    r := RedisRPush(conn, "testlist", "three");
    PrintLn("RPUSH three done");
    
    var llen: int64 := RedisLLen(conn, "testlist");
    Print("LLEN = ");
    PrintLn(llen);
    
    // First RPOP
    r := RedisRPop(conn, "testlist");
    Print("RPOP 1 done, kind=");
    PrintLn(r.kind);
    
    // Second RPOP
    r := RedisRPop(conn, "testlist");
    Print("RPOP 2 done, kind=");
    PrintLn(r.kind);
    
    RedisClose(conn);
    PrintLn("Done");
    return 0;
}