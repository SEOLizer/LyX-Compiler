// tools/tls_server.lyx — ein TLS-Server auf den nativen Units (#2096).
//
// Zweck: etwas, das fremde Gegenstellen beklopfen koennen — tlsfuzzer,
// `openssl s_client`, Browser. Er nimmt Verbindungen in einer Schleife an,
// damit ein Pruefwerkzeug hunderte Handschlaege hintereinander fahren kann;
// der Testserver in tests/ beantwortet nur einen.
//
// Aufruf:
//   tls_server <port> <kette.pem> <key.pem> [<ca.pem>] [schalter...]
// Schalter:
//   tls12    TLS 1.2 zusaetzlich freischalten (Standard: nur 1.3)
//   nur12    TLS 1.3 abschalten
//   mtls     Client-Zertifikat verlangen (braucht <ca.pem>)
//   N=<zahl> nach <zahl> Verbindungen beenden (Standard: 0 = endlos)
//   still    je Verbindung nichts ausgeben
//   echo     Anwendungsdaten zurueckschicken statt einer HTTP-Antwort
//   http11   nur http/1.1 als ALPN anbieten (ohne h2) -- fuer Browser, die
//            sonst HTTP/2 waehlen, waehrend dieser Server HTTP/1.1 spricht
//   tickets  NewSessionTicket ausgeben (Wiederaufnahme, #2577)
//   frueh    fruehe Daten annehmen (0-RTT, #2578) -- schaltet `tickets` mit
//            ein, weil 0-RTT ohne Ticket nicht vorkommt
//
// Jede Verbindung wird einzeln und ohne gemeinsamen Zustand gefahren: ein
// Fehlschlag beendet die Verbindung, nicht den Server. Das ist fuer einen
// Fuzzer die Voraussetzung — sonst messen die letzten 999 Faelle nur noch,
// dass der Server weg ist.
unit main;

@capabilities([network.tcp.bind, io.wait, fs.read, system.rand, system.time, memory.mmap])

import std.io;
import std.string;
import std.alloc;
import std.fs;
import std.net.socket;
import std.crypto.der;
import std.crypto.x509;
import std.net.tls_config;
import std.net.tls13;

fn ladeDer(pfad: pchar, label: pchar, derOut: int64, cap: int64): int64 {
  var pem: int64 := alloc(32768);
  var n: int64 := ReadFile(pfad, pem as pchar, 32767);
  if (n <= 0) { return -1; }
  var l: int64 := PemDekodiere(pem, n, label as int64, StrLen(label), derOut, cap);
  free(pem, 32768);
  return l;
}

fn hatSchalter(name: pchar): int64 {
  var i: int64 := 4;
  while (i < GetArgC()) {
    if (StrEquals(GetArg(i) as pchar, name)) { return 1; }
    i := i + 1;
  }
  return 0;
}

// "N=<zahl>" aus den Schaltern lesen; 0 = endlos.
fn grenzeLesen(): int64 {
  var i: int64 := 4;
  while (i < GetArgC()) {
    var a: pchar := GetArg(i) as pchar;
    if (StrLen(a) > 2) {
      if (StrCharAt(a, 0) == 78 && StrCharAt(a, 1) == 61) {
        return StrToInt((a as int64 + 2) as pchar);
      }
    }
    i := i + 1;
  }
  return 0;
}

fn main(): int64 {
  if (GetArgC() < 4) {
    PrintLn("Aufruf: tls_server <port> <kette.pem> <key.pem> [<ca.pem>] [tls12|nur12|mtls|tickets|frueh|N=<zahl>|still|echo]");
    return 2;
  }
  var port: int64 := StrToInt(GetArg(1) as pchar);
  var dCert: int64 := alloc(16384);
  var lCert: int64 := ladeDer(GetArg(2) as pchar, "CERTIFICATE"c, dCert, 16384);
  var dKey: int64 := alloc(16384);
  var lKey: int64 := ladeDer(GetArg(3) as pchar, "PRIVATE KEY"c, dKey, 16384);
  if (lCert <= 0 || lKey <= 0) { PrintLn("LADEFEHLER Kette oder Schluessel"); return 1; }
  var dCa: int64 := alloc(16384);
  var lCa: int64 := 0;
  if (GetArgC() > 4) {
    if (StrLen(GetArg(4) as pchar) > 4) {
      lCa := ladeDer(GetArg(4) as pchar, "CERTIFICATE"c, dCa, 16384);
    }
  }

  var kette: int64 := alloc(16);
  poke64(kette, dCert); poke64(kette + 8, lCert);
  var cfg: int64 := alloc(TlsConfigGroesse());
  // #2613: Mit `h2` in der Liste waehlt ein Browser HTTP/2 und schickt als
  // erstes die h2-Praeambel. Dieser Server antwortet HTTP/1.1; die Pruefung
  // scheiterte dann an der ANWENDUNGSschicht, obwohl der Handschlag stand
  // (gemessen in tests/tls13_interop_clients_2096_test.sh mit curl:
  // "Remote peer returned unexpected data while we expected SETTINGS frame").
  // Der Schalter `http11` bietet darum nur http/1.1 an.
  var alpn: pchar := "h2,http/1.1"c;
  if (hatSchalter("http11"c) == 1) { alpn := "http/1.1"c; }
  TlsConfigNeu(cfg, 1);
  TlsConfigKette(cfg, kette, 1, dKey, lKey);
  TlsConfigAlpn(cfg, alpn as int64, StrLen(alpn));
  TlsConfigZeit(cfg, 1800000000);
  if (hatSchalter("tls12"c) == 1) { TlsConfigMinVersion(cfg, TlsVersion12()); }
  if (hatSchalter("nur12"c) == 1) {
    TlsConfigMinVersion(cfg, TlsVersion12());
    TlsConfigMaxVersion(cfg, TlsVersion12());
  }
  if (hatSchalter("mtls"c) == 1) {
    if (lCa <= 0) { PrintLn("mtls braucht <ca.pem>"); return 1; }
    var trust: int64 := alloc(16);
    poke64(trust, dCa); poke64(trust + 8, lCa);
    TlsConfigTrust(cfg, trust, 1);
    TlsConfigClientAuth(cfg, 2);
  }
  // #2577/#2578: Wiederaufnahme und fruehe Daten. Der Ticketschluessel ist
  // hier FEST und steht im Quelltext -- dieses Werkzeug ist ein Pruefstand,
  // kein Dienst. Wer es als Dienst betreibt, setzt einen eigenen Schluessel
  // (TlsConfigTicketSchluessel) und liest ihn von aussen.
  var frueh: int64 := hatSchalter("frueh"c);
  if (hatSchalter("tickets"c) == 1 || frueh == 1) {
    var tkkey: int64 := alloc(32);
    var ti: int64 := 0;
    while (ti < 32) { poke8(tkkey + ti, (ti * 11 + 29) & 255); ti := ti + 1; }
    TlsConfigTicketSchluessel(cfg, 1, tkkey, 7200);
  }
  if (frueh == 1) {
    // Der Wiederholungsschutz-Speicher kommt von HIER -- die Unit belegt
    // keinen. 1024 Plaetze bei einem Fenster von 600 s: fuer einen
    // Pruefstand reichlich, fuer einen Dienst eine Betriebsentscheidung.
    var arKap: int64 := 1024;
    var ar: int64 := alloc(arKap * TlsArSlotGroesse());
    TlsConfigFrueheDaten(cfg, 16384);
    TlsConfigWiederholungsschutz(cfg, ar, arKap, 600);
  }
  var still: int64 := hatSchalter("still"c);
  var echo: int64 := hatSchalter("echo"c);
  var grenze: int64 := grenzeLesen();

  var l: TCPListener := TCPListenerNew();
  TCPListenerSetReuseAddr(l);
  if (TCPListenerBindTo(l, 0, port) != 0) { PrintLn("BINDFEHLER"); return 1; }
  TCPListenerListen(l, 64);
  Print("bereit port "); PrintInt(port); PrintLn("");

  var puf: int64 := alloc(32768);
  var ein: int64 := alloc(32768);
  var antwort: pchar := "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 12\r\nConnection: close\r\n\r\nLyx TLS ok\r\n"c;
  var gezaehlt: int64 := 0;
  var fertige: int64 := 0;
  var gescheiterte: int64 := 0;

  while (grenze == 0 || gezaehlt < grenze) {
    var conn: TCPConn := TCPListenerAccept(l);
    gezaehlt := gezaehlt + 1;
    var c: int64 := TlsNeu(cfg);
    var runden: int64 := 0;
    var rc: int64 := 1;
    while (!TlsFertig(c) && runden < 100 && rc >= 0) {
      rc := TlsSchritt(c);
      if (rc >= 0) {
        var m: int64 := TlsAusgabe(c, puf, 32768);
        if (m > 0) { TCPConnWrite(conn, puf as pchar, m); }
        if (!TlsFertig(c)) {
          var n: int64 := TCPConnRead(conn, puf as pchar, 32768);
          if (n <= 0) { rc := -100; }
          else { TlsFuetter(c, puf, n); }
        }
      }
      runden := runden + 1;
    }
    if (TlsFertig(c)) {
      fertige := fertige + 1;
      if (still == 0) {
        Print("verbindung "); PrintInt(gezaehlt);
        Print(" version "); PrintInt(TlsVersion(c));
        Print(" suite "); PrintInt(TlsSuite(c));
        Print(" gruppe "); PrintInt(TlsGruppe(c));
        Print(" wiederaufgenommen "); PrintInt(TlsWiederaufgenommen(c));
        Print(" frueh "); PrintInt(TlsFruehZustand(c));
        Print(" fruehbyte "); PrintInt(TlsFruehGelesen(c));
        PrintLn("");
      }
      // Anfrage lesen, antworten, und danach WEITER lesen, bis die
      // Gegenseite geht. Wer nach der Antwort sofort schliesst, laesst ein
      // Pruefwerkzeug ins Leere senden: tlsfuzzer meldete dann einen
      // Fehlschlag beim SENDEN (broken pipe), und gemessen war nichts.
      var geantwortet: int64 := 0;
      var stille: int64 := 0;
      var schleife: int64 := 0;
      // #2675: ZUERST fragen, was schon entschluesselt bereitliegt, und nur
      // dann vom Socket lesen. Unter Last koaleszieren Finished und die
      // Anfrage in EIN TCP-Segment; die Handschlagschleife oben liest das
      // Segment ganz, die Anfrage steckt also bereits im TLS-Puffer. Wer in
      // dieser Lage mit `read` anfaengt, blockiert, bis die Gegenseite
      // schliesst -- gemessen in #2418 mit `strace -T`:
      // read(4, "", 32768) = 0 <39.948270>. Die Antwort ging danach hinaus,
      // aber `s_client` war schon in seinem Zeitlimit getoetet; der Test war
      // rot, obwohl beide Seiten den Handschlag als gelungen meldeten.
      //
      // DIESELBE REIHENFOLGE wie in tests/tls13_interop_openssl_test.sh und
      // tests/tls12_interop_openssl_test.sh (je Server und Client) -- die
      // vier Stellen dort wurden in 1.2.46A umgestellt, diese fuenfte nicht,
      // und genau sie faellt in #2675 weiter unter Last aus. Die fuenf
      // muessen uebereinstimmen.
      while (schleife < 200 && stille < 3) {
        var g: int64 := TlsLese(c, ein, 32768);
        if (g <= 0) {
          var n2: int64 := TCPConnRead(conn, puf as pchar, 32768);
          if (n2 > 0) {
            TlsFuetter(c, puf, n2);
            stille := 0;
            g := TlsLese(c, ein, 32768);
          } else {
            stille := stille + 1;
          }
        }
        if (g < 0) { schleife := 200; }          // close_notify oder Fehler
        if (g > 0) {
          stille := 0;
          // Im Echo-Betrieb geht der Inhalt zurueck, sonst eine feste
          // HTTP-Antwort. Echo braucht es fuer Pruefwerkzeuge, die die
          // Laenge der Antwort gegen die ihrer Anfrage halten (tlsfuzzer
          // test-tls13-lengths schickt bis zu 10 000 Byte und erwartet
          // genau sie zurueck).
          if (echo == 1) { TlsSchreibe(c, ein, g); }
          else {
            if (geantwortet == 0) {
              TlsSchreibe(c, antwort as int64, StrLen(antwort));
              geantwortet := 1;
            }
          }
        }
        var m2: int64 := TlsAusgabe(c, puf, 32768);
        if (m2 > 0) { TCPConnWrite(conn, puf as pchar, m2); }
        schleife := schleife + 1;
      }
      TlsSchliessen(c);
      var m3: int64 := TlsAusgabe(c, puf, 32768);
      if (m3 > 0) { TCPConnWrite(conn, puf as pchar, m3); }
    } else {
      gescheiterte := gescheiterte + 1;
      if (still == 0) {
        Print("verbindung "); PrintInt(gezaehlt);
        Print(" abgewiesen rc "); PrintInt(rc);
        Print(" "); PrintLn(TlsFehlerText(rc));
      }
      // Ein Alert liegt vielleicht noch im Ausgangspuffer.
      var m3: int64 := TlsAusgabe(c, puf, 32768);
      if (m3 > 0) { TCPConnWrite(conn, puf as pchar, m3); }
    }
    TlsFrei(c);
    TCPConnClose(conn);
  }
  Print("ende verbindungen "); PrintInt(gezaehlt);
  Print(" fertig "); PrintInt(fertige);
  Print(" abgewiesen "); PrintInt(gescheiterte); PrintLn("");
  TCPListenerClose(l);
  return 0;
}
