// std/pipe — WP-2: Pipes & fd-Duplikation
// Wrapper um sys_pipe, sys_pipe2, sys_dup, sys_dup2, sys_dup3

import std.alloc;

// Flags für pipe2() / dup3()
pub con O_CLOEXEC:  int64 := 524288;  // 0x80000
pub con O_NONBLOCK: int64 := 2048;    // 0x800

// ============================================================
// Pipe-Erstellung
// ============================================================

// PipeCreate: erstellt ein unidirektionales Pipe-Paar.
// readFdOut / writeFdOut: je alloc(8)-Buffer; nach Aufruf via peek64 lesen.
// Gibt 0 zurück bei Erfolg, < 0 bei Fehler.
pub fn PipeCreate(readFdOut: int64, writeFdOut: int64): int64 {
  var fds: int64 := alloc(8);
  if (fds == 0) { return -1; }
  var r: int64 := sys_pipe(fds);
  if (r == 0) {
    // kernel schreibt zwei int32-Werte (little-endian); peek64 liefert beide
    var both: int64 := peek64(fds);
    poke64(readFdOut,  both & 2147483647);         // bits 0-30 (int32 fd, positiv)
    poke64(writeFdOut, (both >> 32) & 2147483647);
  }
  free(fds, 8);
  return r;
}

// Pipe2: wie PipeCreate, aber mit O_CLOEXEC / O_NONBLOCK-Flags.
pub fn Pipe2(readFdOut: int64, writeFdOut: int64, flags: int64): int64 {
  var fds: int64 := alloc(8);
  if (fds == 0) { return -1; }
  var r: int64 := sys_pipe2(fds, flags);
  if (r == 0) {
    var both: int64 := peek64(fds);
    poke64(readFdOut,  both & 2147483647);
    poke64(writeFdOut, (both >> 32) & 2147483647);
  }
  free(fds, 8);
  return r;
}

// ============================================================
// fd-Duplikation
// ============================================================

// FdDup: dupliziert oldFd auf den nächst-freien fd.
// Gibt den neuen fd zurück, oder < 0 bei Fehler.
pub fn FdDup(oldFd: int64): int64 {
  return sys_dup(oldFd);
}

// FdDup2: dupliziert oldFd auf newFd (schließt newFd falls offen).
// Gibt newFd zurück, oder < 0 bei Fehler.
pub fn FdDup2(oldFd: int64, newFd: int64): int64 {
  return sys_dup2(oldFd, newFd);
}

// FdDup3: wie FdDup2, aber mit Flags (z.B. O_CLOEXEC).
pub fn FdDup3(oldFd: int64, newFd: int64, flags: int64): int64 {
  return sys_dup3(oldFd, newFd, flags);
}
