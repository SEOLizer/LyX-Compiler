// std/validate/bic.lyx
// BIC/SWIFT-Code — structural validation (no mathematical check digit)

@description("BIC/SWIFT validation: BICValidate, BICNormalize, BICGetBankCode, BICGetCountry, BICIsHeadOffice")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.bic;

import std.alloc;
pub con BIC_OK:               int64 := 0;
pub con BIC_ERR_LENGTH:       int64 := 1;
pub con BIC_ERR_BANKCODE:     int64 := 2;
pub con BIC_ERR_COUNTRY:      int64 := 3;
pub con BIC_ERR_LOCATION:     int64 := 4;

fn _bicStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _bicToUpper(c: int64): int64 {
  if (c >= 97 && c <= 122) { return c - 32; }
  return c;
}

fn _bicIsUpper(c: int64): int64 {
  if (c >= 65 && c <= 90) { return 1; }
  return 0;
}

fn _bicIsAlphaNum(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  if (c >= 65 && c <= 90) { return 1; }
  return 0;
}

// Normalize: uppercase, strip spaces. out_buf needs at least 12 bytes.
pub fn BICNormalize(bic: pchar, out_buf: int64): int64 {
  var bicAdr: int64 := bic as int64;   // #1613
  if (out_buf == 0) { return -1; }
  var pos: int64 := 0;
  var i: int64 := 0;
  var len: int64 := _bicStrLen(bicAdr);
  while (i < len && pos < 11) {
    var c: int64 := peek8(bicAdr + i);
    if (c != 32) {
      poke8(out_buf + pos, _bicToUpper(c)); pos := pos + 1;
    }
    i += 1;
  }
  poke8(out_buf + pos, 0);
  return 0;
}

// Validate a BIC (8 or 11 characters after normalization).
pub fn BICValidate(bic: pchar): int64 {
  var bicAdr: int64 := bic as int64;   // #1613
  var buf: int64 := alloc(12);
  if (buf == 0) { return BIC_ERR_LENGTH; }
  BICNormalize(bicAdr as pchar, buf);
  var len: int64 := _bicStrLen(buf);
  if (len != 8 && len != 11) { free(buf, 12); return BIC_ERR_LENGTH; }

  // Chars 0–3: bank code — must be A-Z
  var i: int64 := 0;
  while (i < 4) {
    if (_bicIsUpper(peek8(buf + i)) == 0) { free(buf, 12); return BIC_ERR_BANKCODE; }
    i += 1;
  }

  // Chars 4–5: country code — must be A-Z
  if (_bicIsUpper(peek8(buf + 4)) == 0 || _bicIsUpper(peek8(buf + 5)) == 0) {
    free(buf, 12); return BIC_ERR_COUNTRY;
  }

  // Chars 6–7: location code — A-Z or 0-9, second char must not be 'O'
  if (_bicIsAlphaNum(peek8(buf + 6)) == 0) { free(buf, 12); return BIC_ERR_LOCATION; }
  var loc2: int64 := peek8(buf + 7);
  if (_bicIsAlphaNum(loc2) == 0) { free(buf, 12); return BIC_ERR_LOCATION; }
  if (loc2 == 79) { free(buf, 12); return BIC_ERR_LOCATION; }  // 'O' not allowed

  // Chars 8–10 (optional): branch code — A-Z or 0-9
  if (len == 11) {
    i := 8;
    while (i < 11) {
      if (_bicIsAlphaNum(peek8(buf + i)) == 0) { free(buf, 12); return BIC_ERR_LOCATION; }
      i += 1;
    }
  }
  free(buf, 12);
  return BIC_OK;
}

// Copy the 4-character bank code into out_buf (needs 5 bytes).
pub fn BICGetBankCode(bic: pchar, out_buf: int64): int64 {
  var bicAdr: int64 := bic as int64;   // #1613
  if (out_buf == 0) { return -1; }
  var buf: int64 := alloc(12);
  if (buf == 0) { return -1; }
  BICNormalize(bicAdr as pchar, buf);
  if (_bicStrLen(buf) < 4) { free(buf, 12); return -1; }
  var i: int64 := 0;
  while (i < 4) { poke8(out_buf + i, peek8(buf + i)); i := i + 1; }
  poke8(out_buf + 4, 0);
  free(buf, 12);
  return 0;
}

// Copy the 2-character country code into out_buf (needs 3 bytes).
pub fn BICGetCountry(bic: pchar, out_buf: int64): int64 {
  var bicAdr: int64 := bic as int64;   // #1613
  if (out_buf == 0) { return -1; }
  var buf: int64 := alloc(12);
  if (buf == 0) { return -1; }
  BICNormalize(bicAdr as pchar, buf);
  if (_bicStrLen(buf) < 6) { free(buf, 12); return -1; }
  poke8(out_buf + 0, peek8(buf + 4));
  poke8(out_buf + 1, peek8(buf + 5));
  poke8(out_buf + 2, 0);
  free(buf, 12);
  return 0;
}

// Returns 1 if BIC is a head office code (8 chars or branch code 'XXX'), 0 otherwise.
pub fn BICIsHeadOffice(bic: pchar): int64 {
  var bicAdr: int64 := bic as int64;   // #1613
  var buf: int64 := alloc(12);
  if (buf == 0) { return 0; }
  BICNormalize(bicAdr as pchar, buf);
  var len: int64 := _bicStrLen(buf);
  if (len == 8) { free(buf, 12); return 1; }
  if (len == 11) {
    var isXXX: int64 := 0;
    if (peek8(buf + 8) == 88 && peek8(buf + 9) == 88 && peek8(buf + 10) == 88) {
      isXXX := 1;
    }
    free(buf, 12);
    return isXXX;
  }
  free(buf, 12);
  return 0;
}
