// std/validate/iso6346.lyx
// Shipping container number — ISO 6346

@description("ISO 6346 container number: ContainerValidate, ContainerCheckDigit, ContainerGetOwner, ContainerGetSerial")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.iso6346;

pub con CONTAINER_OK:               int64 := 0;
pub con CONTAINER_ERR_LENGTH:       int64 := 1;
pub con CONTAINER_ERR_CATEGORY:     int64 := 2;
pub con CONTAINER_ERR_CHAR:         int64 := 3;
pub con CONTAINER_ERR_CHECK:        int64 := 4;

fn _ctnStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _ctnToUpper(c: int64): int64 {
  if (c >= 97 && c <= 122) { return c - 32; }
  return c;
}

fn _ctnIsUpper(c: int64): int64 {
  if (c >= 65 && c <= 90) { return 1; }
  return 0;
}

fn _ctnIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

// ISO 6346 letter value: A=10, B=12, C=13, ... skipping multiples of 11.
fn _ctnLetterVal(c: int64): int64 {
  var u: int64 := _ctnToUpper(c);
  if (u < 65 || u > 90) { return -1; }
  var pos: int64 := u - 64;  // A=1..Z=26
  // Add 10, then skip multiples of 11
  var val: int64 := pos + 10;
  // Skip each multiple of 11 that is <= val (there's one per 11 values in 10-45 range)
  var skips: int64 := val / 11;
  val += skips;
  // Re-check: iterate from 10 for each letter
  // Correct formula: start from A=10, skip 11,22,33,44
  var result: int64 := 0;
  var n: int64 := 10;
  var letter: int64 := 0;
  while (letter < pos) {
    if (n - (n / 11) * 11 == 0) { n := n + 1; }
    letter += 1;
    result := n;
    n += 1;
  }
  return result;
}

// Compute check digit for the first 10 characters of a container number.
// Weights are powers of 2: 2^0, 2^1, ..., 2^9.
// Checkdigit = (sum mod 11) mod 10.
pub fn ContainerCheckDigit(id: int64): int64 {
  if (_ctnStrLen(id) < 10) { return -1; }
  var sum: int64 := 0;
  var power: int64 := 1;  // 2^0
  var i: int64 := 0;
  while (i < 10) {
    var c: int64 := peek8(id + i);
    var v: int64 := 0;
    if (_ctnIsDigit(c) == 1) {
      v := c - 48;
    } else {
      v := _ctnLetterVal(c);
      if (v < 0) { return -1; }
    }
    sum := sum + v * power;
    power := power * 2;
    i += 1;
  }
  var rest: int64 := sum - (sum / 11) * 11;
  return rest - (rest / 10) * 10;
}

// Validate an 11-character container number.
pub fn ContainerValidate(id: int64): int64 {
  if (_ctnStrLen(id) != 11) { return CONTAINER_ERR_LENGTH; }
  // Positions 0–2: owner code — uppercase letters
  var i: int64 := 0;
  while (i < 3) {
    if (_ctnIsUpper(_ctnToUpper(peek8(id + i))) == 0) { return CONTAINER_ERR_CHAR; }
    i += 1;
  }
  // Position 3: category identifier — must be U, J, or Z
  var cat: int64 := _ctnToUpper(peek8(id + 3));
  if (cat != 85 && cat != 74 && cat != 90) { return CONTAINER_ERR_CATEGORY; } // U J Z
  // Positions 4–9: 6-digit serial
  i := 4;
  while (i < 10) {
    if (_ctnIsDigit(peek8(id + i)) == 0) { return CONTAINER_ERR_CHAR; }
    i += 1;
  }
  // Position 10: check digit
  var expected: int64 := ContainerCheckDigit(id);
  if (expected < 0) { return CONTAINER_ERR_CHECK; }
  var actual: int64 := peek8(id + 10) - 48;
  if (expected != actual) { return CONTAINER_ERR_CHECK; }
  return CONTAINER_OK;
}

// Copy 3-character owner code into out_buf (needs 4 bytes).
pub fn ContainerGetOwner(id: int64, out_buf: int64): int64 {
  if (_ctnStrLen(id) < 3) { return -1; }
  if (out_buf == 0) { return -1; }
  var i: int64 := 0;
  while (i < 3) {
    poke8(out_buf + i, _ctnToUpper(peek8(id + i)));
    i += 1;
  }
  poke8(out_buf + 3, 0);
  return 0;
}

// Copy 6-character serial number into out_buf (needs 7 bytes).
pub fn ContainerGetSerial(id: int64, out_buf: int64): int64 {
  if (_ctnStrLen(id) < 10) { return -1; }
  if (out_buf == 0) { return -1; }
  var i: int64 := 0;
  while (i < 6) {
    poke8(out_buf + i, peek8(id + 4 + i));
    i += 1;
  }
  poke8(out_buf + 6, 0);
  return 0;
}
