// std/validate/issn.lyx
// International Standard Serial Number — ISO 3297

@description("ISSN validation: ISSNValidate, ISSNCheckDigit, ISSNNormalize")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.issn;

import std.alloc;
pub con ISSN_OK:           int64 := 0;
pub con ISSN_ERR_LENGTH:   int64 := 1;
pub con ISSN_ERR_CHAR:     int64 := 2;
pub con ISSN_ERR_CHECK:    int64 := 3;

fn _issnStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _issnToUpper(c: int64): int64 {
  if (c >= 97 && c <= 122) { return c - 32; }
  return c;
}

fn _issnIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

// Normalize: strip hyphens and spaces, uppercase. out_buf needs at least 9 bytes.
pub fn ISSNNormalize(issn: int64, out_buf: int64): int64 {
  if (out_buf == 0) { return -1; }
  var pos: int64 := 0;
  var i: int64 := 0;
  var len: int64 := _issnStrLen(issn as int64);
  while (i < len && pos < 8) {
    var c: int64 := peek8((issn as int64) + i);
    if (c != 32 && c != 45) {
      poke8(out_buf + pos, _issnToUpper(c)); pos := pos + 1;
    }
    i += 1;
  }
  poke8(out_buf + pos, 0);
  return 0;
}

// Compute ISSN check character for the first 7 digits.
// Weights: 8 7 6 5 4 3 2; sum mod 11 must be 0.
// Rest 10 → 'X'; rest 0 → '0'. Returns ASCII char or -1 on error.
pub fn ISSNCheckDigit(issn: pchar): int64 {
  var buf: int64 := alloc(10);
  if (buf == 0) { return -1; }
  ISSNNormalize(issn as int64, buf);   // #1343
  var len: int64 := _issnStrLen(buf);
  if (len < 7) { free(buf, 10); return -1; }
  var weights: int64[7];
  var w0: int64 := 8; var w1: int64 := 7; var w2: int64 := 6;
  var w3: int64 := 5; var w4: int64 := 4; var w5: int64 := 3; var w6: int64 := 2;
  var sum: int64 := 0;
  var d: int64 := 0;
  d := peek8(buf + 0) - 48; if (d < 0 || d > 9) { free(buf, 10); return -1; } sum := sum + d * w0;
  d := peek8(buf + 1) - 48; if (d < 0 || d > 9) { free(buf, 10); return -1; } sum := sum + d * w1;
  d := peek8(buf + 2) - 48; if (d < 0 || d > 9) { free(buf, 10); return -1; } sum := sum + d * w2;
  d := peek8(buf + 3) - 48; if (d < 0 || d > 9) { free(buf, 10); return -1; } sum := sum + d * w3;
  d := peek8(buf + 4) - 48; if (d < 0 || d > 9) { free(buf, 10); return -1; } sum := sum + d * w4;
  d := peek8(buf + 5) - 48; if (d < 0 || d > 9) { free(buf, 10); return -1; } sum := sum + d * w5;
  d := peek8(buf + 6) - 48; if (d < 0 || d > 9) { free(buf, 10); return -1; } sum := sum + d * w6;
  free(buf, 10);
  // #1690: Die Pruefziffer ist (11 - sum mod 11) mod 11, Wert 10 wird 'X'.
  // Fruehere Fassung hatte die beiden Randfaelle vertauscht: rest 1 galt als
  // ungueltig statt als 'X', und rest 10 lieferte 'X' statt '1'. Damit wies
  // ISSNValidate die kanonische Beispiel-ISSN 0317-8471 ab (Summe 120,
  // rest 10, richtige Pruefziffer '1').
  var rest: int64 := sum - (sum / 11) * 11;
  if (rest == 0) { return 48; }   // '0'
  if (rest == 1) { return 88; }   // 11 - 1 = 10 -> 'X'
  return (11 - rest) + 48;
}

// Validate an 8-character ISSN (may contain one hyphen: XXXX-XXXX).
pub fn ISSNValidate(issn: pchar): int64 {
  var buf: int64 := alloc(10);
  if (buf == 0) { return ISSN_ERR_CHECK; }
  ISSNNormalize(issn as int64, buf);   // #1343
  var len: int64 := _issnStrLen(buf);
  if (len != 8) { free(buf, 10); return ISSN_ERR_LENGTH; }
  var i: int64 := 0;
  while (i < 7) {
    if (_issnIsDigit(peek8(buf + i)) == 0) { free(buf, 10); return ISSN_ERR_CHAR; }
    i += 1;
  }
  var lastC: int64 := _issnToUpper(peek8(buf + 7));
  if (lastC != 88 && (_issnIsDigit(lastC) == 0)) { free(buf, 10); return ISSN_ERR_CHAR; }
  var expected: int64 := ISSNCheckDigit(buf as pchar);
  free(buf, 10);
  if (expected < 0) { return ISSN_ERR_CHECK; }
  if (expected != lastC) { return ISSN_ERR_CHECK; }
  return ISSN_OK;
}
