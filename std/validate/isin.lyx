// std/validate/isin.lyx
// International Securities Identification Number — ISO 6166

@description("ISIN validation: ISINValidate, ISINCheckDigit, ISINGetCountry, ISINNormalize")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.isin;

import std.alloc;
pub con ISIN_OK:            int64 := 0;
pub con ISIN_ERR_LENGTH:    int64 := 1;
pub con ISIN_ERR_COUNTRY:   int64 := 2;
pub con ISIN_ERR_CHAR:      int64 := 3;
pub con ISIN_ERR_CHECK:     int64 := 4;

fn _isinStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _isinToUpper(c: int64): int64 {
  if (c >= 97 && c <= 122) { return c - 32; }
  return c;
}

fn _isinIsUpper(c: int64): int64 {
  if (c >= 65 && c <= 90) { return 1; }
  return 0;
}

fn _isinIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

// Compute Luhn check digit on an all-digit string (for ISIN: after letter expansion).
// Returns 0 if valid (last digit is correct check digit), 1 if not.
fn _isinLuhnCheck(digits: int64, len: int64): int64 {
  var sum: int64 := 0;
  var parity: int64 := len - (len / 2) * 2;  // 1 if odd length
  var i: int64 := 0;
  while (i < len) {
    var d: int64 := peek8(digits + i) - 48;
    if ((i - (i / 2) * 2) == parity) {
      d := d * 2;
      if (d > 9) { d := d - 9; }
    }
    sum := sum + d;
    i := i + 1;
  }
  return sum - (sum / 10) * 10;
}

// Compute ISIN check digit.
// Returns check digit (0–9), or -1 on invalid input.
pub fn ISINCheckDigit(isin: int64): int64 {
  if (_isinStrLen(isin) < 11) { return -1; }
  // Expand to digit string: letters A-Z → two digits 10-35
  var buf: int64 := alloc(26);
  if (buf == 0) { return -1; }
  var pos: int64 := 0;
  var i: int64 := 0;
  while (i < 11) {
    var c: int64 := _isinToUpper(peek8(isin + i));
    if (c >= 65 && c <= 90) {
      var v: int64 := c - 55;  // A=10..Z=35
      poke8(buf + pos, (v / 10) + 48); pos := pos + 1;
      poke8(buf + pos, (v - (v / 10) * 10) + 48); pos := pos + 1;
    } else if (c >= 48 && c <= 57) {
      poke8(buf + pos, c); pos := pos + 1;
    } else {
      free(buf, 26); return -1;
    }
    i := i + 1;
  }
  poke8(buf + pos, 0);
  // Compute Luhn check digit over expanded string + one placeholder
  // Using standard Luhn: double every second digit from right
  var sum: int64 := 0;
  var len: int64 := pos;
  i := 0;
  while (i < len) {
    var d: int64 := peek8(buf + i) - 48;
    var fromRight: int64 := len - 1 - i;
    if (fromRight - (fromRight / 2) * 2 == 0) {
      d := d * 2;
      if (d > 9) { d := d - 9; }
    }
    sum := sum + d;
    i := i + 1;
  }
  free(buf, 26);
  return (10 - (sum - (sum / 10) * 10)) - ((10 - (sum - (sum / 10) * 10)) / 10) * 10;
}

// Validate a 12-character ISIN.
pub fn ISINValidate(isin: int64): int64 {
  if (_isinStrLen(isin) != 12) { return ISIN_ERR_LENGTH; }
  // First two chars: uppercase letters (country code)
  if (_isinIsUpper(_isinToUpper(peek8(isin)))     == 0) { return ISIN_ERR_COUNTRY; }
  if (_isinIsUpper(_isinToUpper(peek8(isin + 1))) == 0) { return ISIN_ERR_COUNTRY; }
  // Chars 2–10: alphanumeric
  var i: int64 := 2;
  while (i < 11) {
    var c: int64 := _isinToUpper(peek8(isin + i));
    if (_isinIsUpper(c) == 0 && _isinIsDigit(c) == 0) { return ISIN_ERR_CHAR; }
    i := i + 1;
  }
  // Char 11: check digit
  if (_isinIsDigit(peek8(isin + 11)) == 0) { return ISIN_ERR_CHAR; }
  var expected: int64 := ISINCheckDigit(isin);
  if (expected < 0) { return ISIN_ERR_CHECK; }
  var actual: int64 := peek8(isin + 11) - 48;
  if (expected != actual) { return ISIN_ERR_CHECK; }
  return ISIN_OK;
}

// Copy the 2-character country code from an ISIN into out_buf (needs 3 bytes).
pub fn ISINGetCountry(isin: int64, out_buf: int64): int64 {
  if (_isinStrLen(isin) < 2) { return -1; }
  if (out_buf == 0) { return -1; }
  poke8(out_buf + 0, _isinToUpper(peek8(isin)));
  poke8(out_buf + 1, _isinToUpper(peek8(isin + 1)));
  poke8(out_buf + 2, 0);
  return 0;
}

// Normalize: uppercase, strip spaces. out_buf needs at least 13 bytes.
pub fn ISINNormalize(isin: int64, out_buf: int64): int64 {
  if (out_buf == 0) { return -1; }
  var pos: int64 := 0;
  var i: int64 := 0;
  var len: int64 := _isinStrLen(isin);
  while (i < len && pos < 12) {
    var c: int64 := peek8(isin + i);
    if (c != 32 && c != 45) {
      poke8(out_buf + pos, _isinToUpper(c)); pos := pos + 1;
    }
    i := i + 1;
  }
  poke8(out_buf + pos, 0);
  return 0;
}
