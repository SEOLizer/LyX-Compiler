// std/validate/us_cusip.lyx
// CUSIP — Committee on Uniform Security Identification Procedures (US)

@description("CUSIP validation: USCUSIPValidate, USCUSIPCheckDigit")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.us_cusip;

pub con US_CUSIP_OK:           int64 := 0;
pub con US_CUSIP_ERR_LENGTH:   int64 := 1;
pub con US_CUSIP_ERR_CHAR:     int64 := 2;
pub con US_CUSIP_ERR_CHECK:    int64 := 3;

fn _cusipStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _cusipToUpper(c: int64): int64 {
  if (c >= 97 && c <= 122) { return c - 32; }
  return c;
}

// Character value: 0-9 → 0-9; A-Z → 10-35; * → 36; @ → 37; # → 38.
fn _cusipCharVal(c: int64): int64 {
  var u: int64 := _cusipToUpper(c);
  if (u >= 48 && u <= 57) { return u - 48; }
  if (u >= 65 && u <= 90) { return u - 55; }
  if (u == 42) { return 36; }   // *
  if (u == 64) { return 37; }   // @
  if (u == 35) { return 38; }   // #
  return -1;
}

// Compute CUSIP check digit for the first 8 characters.
// Weights alternate 1 2 1 2 1 2 1 2; cross-sum if product > 9.
// Checkdigit = (10 - (sum mod 10)) mod 10.
// Returns check digit (0–9) or -1 on invalid input.
pub fn USCUSIPCheckDigit(cusip: int64): int64 {
  if (_cusipStrLen(cusip) < 8) { return -1; }
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < 8) {
    var v: int64 := _cusipCharVal(peek8(cusip + i));
    if (v < 0) { return -1; }
    var w: int64 := 0;
    if (i - (i / 2) * 2 == 0) { w := 1; } else { w := 2; }
    var p: int64 := v * w;
    if (p > 9) { p := (p / 10) + (p - (p / 10) * 10); }
    sum := sum + p;
    i := i + 1;
  }
  var r: int64 := sum - (sum / 10) * 10;
  return (10 - r) - ((10 - r) / 10) * 10;
}

// Validate a 9-character CUSIP (8 payload chars + 1 check digit).
pub fn USCUSIPValidate(cusip: int64): int64 {
  if (_cusipStrLen(cusip) != 9) { return US_CUSIP_ERR_LENGTH; }
  var i: int64 := 0;
  while (i < 8) {
    if (_cusipCharVal(peek8(cusip + i)) < 0) { return US_CUSIP_ERR_CHAR; }
    i := i + 1;
  }
  if ((peek8(cusip + 8) - 48) < 0 || (peek8(cusip + 8) - 48) > 9) {
    return US_CUSIP_ERR_CHAR;
  }
  var expected: int64 := USCUSIPCheckDigit(cusip);
  if (expected < 0) { return US_CUSIP_ERR_CHECK; }
  if (expected != (peek8(cusip + 8) - 48)) { return US_CUSIP_ERR_CHECK; }
  return US_CUSIP_OK;
}
