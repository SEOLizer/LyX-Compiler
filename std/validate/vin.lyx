// std/validate/vin.lyx
// Vehicle Identification Number (FIN/VIN) — FMVSS 565 / ISO 3779

@description("VIN/FIN validation: VINValidate, VINCheckDigit, VINGetModelYear, VINGetManufacturer")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.vin;

pub con VIN_OK:                   int64 := 0;
pub con VIN_ERR_LENGTH:           int64 := 1;
pub con VIN_ERR_FORBIDDEN_CHAR:   int64 := 2;
pub con VIN_ERR_CHECK:            int64 := 3;

fn _vinStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _vinToUpper(c: int64): int64 {
  if (c >= 97 && c <= 122) { return c - 32; }
  return c;
}

// Transliteration table per FMVSS 565 (I, O, Q are forbidden).
fn _vinTranslit(c: int64): int64 {
  var u: int64 := _vinToUpper(c);
  if (u >= 48 && u <= 57) { return u - 48; }
  // A=1 B=2 C=3 D=4 E=5 F=6 G=7 H=8
  if (u == 65) { return 1; } if (u == 66) { return 2; }
  if (u == 67) { return 3; } if (u == 68) { return 4; }
  if (u == 69) { return 5; } if (u == 70) { return 6; }
  if (u == 71) { return 7; } if (u == 72) { return 8; }
  // I forbidden
  // J=1 K=2 L=3 M=4 N=5
  if (u == 74) { return 1; } if (u == 75) { return 2; }
  if (u == 76) { return 3; } if (u == 77) { return 4; }
  if (u == 78) { return 5; }
  // O forbidden
  // P=7 Q forbidden R=9
  if (u == 80) { return 7; }
  if (u == 82) { return 9; }
  // S=2 T=3 U=4 V=5 W=6 X=7 Y=8 Z=9
  if (u == 83) { return 2; } if (u == 84) { return 3; }
  if (u == 85) { return 4; } if (u == 86) { return 5; }
  if (u == 87) { return 6; } if (u == 88) { return 7; }
  if (u == 89) { return 8; } if (u == 90) { return 9; }
  return -1;
}

// Positional weights for VIN positions 1–17 (0-indexed 0–16).
fn _vinWeight(pos: int64): int64 {
  if (pos == 0)  { return 8; }  if (pos == 1)  { return 7; }
  if (pos == 2)  { return 6; }  if (pos == 3)  { return 5; }
  if (pos == 4)  { return 4; }  if (pos == 5)  { return 3; }
  if (pos == 6)  { return 2; }  if (pos == 7)  { return 10; }
  if (pos == 8)  { return 0; }  // check digit position
  if (pos == 9)  { return 9; }  if (pos == 10) { return 8; }
  if (pos == 11) { return 7; }  if (pos == 12) { return 6; }
  if (pos == 13) { return 5; }  if (pos == 14) { return 4; }
  if (pos == 15) { return 3; }  if (pos == 16) { return 2; }
  return 0;
}

// Compute VIN check digit (position 9, 0-indexed 8).
// Returns ASCII char: '0'–'9' or 'X', or 0 on error.
pub fn VINCheckDigit(vin: int64): int64 {
  if (_vinStrLen(vin) < 17) { return 0; }
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < 17) {
    if (i == 8) { i := i + 1; }
    if (i >= 17) { i := 17; }
    else {
      var t: int64 := _vinTranslit(peek8(vin + i));
      if (t < 0) { return 0; }
      sum := sum + t * _vinWeight(i);
      i := i + 1;
    }
  }
  var rest: int64 := sum - (sum / 11) * 11;
  if (rest == 10) { return 88; }  // 'X'
  return rest + 48;
}

// Model year encoding (position 10, 0-indexed 9).
// Returns 4-digit year or -1 if unrecognised.
pub fn VINGetModelYear(vin: int64): int64 {
  if (_vinStrLen(vin) < 17) { return -1; }
  var c: int64 := _vinToUpper(peek8(vin + 9));
  // Cycle repeats every 30 years from 1980
  if (c == 65) { return 1980; } if (c == 66) { return 1981; }
  if (c == 67) { return 1982; } if (c == 68) { return 1983; }
  if (c == 69) { return 1984; } if (c == 70) { return 1985; }
  if (c == 71) { return 1986; } if (c == 72) { return 1987; }
  if (c == 74) { return 1988; } if (c == 75) { return 1989; }
  if (c == 76) { return 1990; } if (c == 77) { return 1991; }
  if (c == 78) { return 1992; } if (c == 80) { return 1993; }
  if (c == 82) { return 1994; } if (c == 83) { return 1995; }
  if (c == 84) { return 1996; } if (c == 86) { return 1997; }
  if (c == 87) { return 1998; } if (c == 88) { return 1999; }
  if (c == 89) { return 2000; } if (c == 49) { return 2001; }
  if (c == 50) { return 2002; } if (c == 51) { return 2003; }
  if (c == 52) { return 2004; } if (c == 53) { return 2005; }
  if (c == 54) { return 2006; } if (c == 55) { return 2007; }
  if (c == 56) { return 2008; } if (c == 57) { return 2009; }
  if (c == 65) { return 2010; }  // cycle restarts
  return -1;
}

// Copy WMI (World Manufacturer Identifier, first 3 chars) into out_buf (needs 4 bytes).
pub fn VINGetManufacturer(vin: int64, out_buf: int64): int64 {
  if (_vinStrLen(vin) < 3) { return -1; }
  if (out_buf == 0) { return -1; }
  var i: int64 := 0;
  while (i < 3) {
    poke8(out_buf + i, _vinToUpper(peek8(vin + i)));
    i := i + 1;
  }
  poke8(out_buf + 3, 0);
  return 0;
}

// Validate a 17-character VIN.
pub fn VINValidate(vin: int64): int64 {
  if (_vinStrLen(vin) != 17) { return VIN_ERR_LENGTH; }
  var i: int64 := 0;
  while (i < 17) {
    var u: int64 := _vinToUpper(peek8(vin + i));
    if (u == 73 || u == 79 || u == 81) { return VIN_ERR_FORBIDDEN_CHAR; }  // I O Q
    if (_vinTranslit(u) < 0) { return VIN_ERR_FORBIDDEN_CHAR; }
    i := i + 1;
  }
  var expected: int64 := VINCheckDigit(vin);
  if (expected == 0) { return VIN_ERR_CHECK; }
  var actual: int64 := _vinToUpper(peek8(vin + 8));
  if (expected != actual) { return VIN_ERR_CHECK; }
  return VIN_OK;
}
