// std/validate/nl_bsn.lyx
// Burgerservicenummer (Netherlands) — 9-Proef (Mod 11 with negative last weight)

@description("BSN validation: NLBSNValidate, NLBSNCheckSum")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.nl_bsn;

pub con NL_BSN_OK:           int64 := 0;
pub con NL_BSN_ERR_LENGTH:   int64 := 1;
pub con NL_BSN_ERR_CHAR:     int64 := 2;
pub con NL_BSN_ERR_CHECK:    int64 := 3;

fn _bsnStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _bsnIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

// Compute the weighted sum (9-Proef) for a 9-digit BSN.
// Weights: 9 8 7 6 5 4 3 2 −1 (last weight is negative).
// Valid if sum mod 11 == 0.
// Returns the sum, or -1 on invalid chars.
pub fn NLBSNCheckSum(bsn: int64): int64 {
  if (_bsnStrLen(bsn) != 9) { return -1; }
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < 8) {
    var d: int64 := peek8(bsn + i) - 48;
    if (d < 0 || d > 9) { return -1; }
    sum := sum + d * (9 - i);
    i += 1;
  }
  // Last digit has weight −1
  var last: int64 := peek8(bsn + 8) - 48;
  if (last < 0 || last > 9) { return -1; }
  sum -= last;
  return sum;
}

// Validate a 9-digit Dutch BSN.
pub fn NLBSNValidate(bsn: int64): int64 {
  if (_bsnStrLen(bsn) != 9) { return NL_BSN_ERR_LENGTH; }
  var i: int64 := 0;
  while (i < 9) {
    if (_bsnIsDigit(peek8(bsn + i)) == 0) { return NL_BSN_ERR_CHAR; }
    i += 1;
  }
  var sum: int64 := NLBSNCheckSum(bsn);
  if (sum < 0) { return NL_BSN_ERR_CHECK; }
  if (sum - (sum / 11) * 11 != 0) { return NL_BSN_ERR_CHECK; }
  return NL_BSN_OK;
}
