// std/validate/uic.lyx
// UIC railway vehicle number — European rail standard

@description("UIC vehicle number: UICVehicleValidate, UICVehicleCheckDigit, UICVehicleGetCountry")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.uic;

pub con UIC_OK:           int64 := 0;
pub con UIC_ERR_LENGTH:   int64 := 1;
pub con UIC_ERR_CHAR:     int64 := 2;
pub con UIC_ERR_CHECK:    int64 := 3;

fn _uicStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _uicIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

// Compute UIC check digit for 11-digit string (Luhn-style with weights 2 1 cycling).
// Cross-sum if product > 9. Returns (10 - sum%10) % 10.
pub fn UICVehicleCheckDigit(nr: int64): int64 {
  if (_uicStrLen(nr) < 11) { return -1; }
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < 11) {
    var d: int64 := peek8(nr + i) - 48;
    if (d < 0 || d > 9) { return -1; }
    var w: int64 := 0;
    if (i - (i / 2) * 2 == 0) { w := 2; } else { w := 1; }
    var p: int64 := d * w;
    if (p > 9) { p := (p / 10) + (p - (p / 10) * 10); }
    sum := sum + p;
    i := i + 1;
  }
  var r: int64 := sum - (sum / 10) * 10;
  return (10 - r) - ((10 - r) / 10) * 10;
}

// Validate a 12-digit UIC vehicle number.
pub fn UICVehicleValidate(nr: int64): int64 {
  if (_uicStrLen(nr) != 12) { return UIC_ERR_LENGTH; }
  var i: int64 := 0;
  while (i < 12) {
    if (_uicIsDigit(peek8(nr + i)) == 0) { return UIC_ERR_CHAR; }
    i := i + 1;
  }
  var expected: int64 := UICVehicleCheckDigit(nr);
  if (expected < 0) { return UIC_ERR_CHECK; }
  var actual: int64 := peek8(nr + 11) - 48;
  if (expected != actual) { return UIC_ERR_CHECK; }
  return UIC_OK;
}

// Return ISO numeric country code from first two digits (e.g. 80 = Germany).
pub fn UICVehicleGetCountry(nr: int64): int64 {
  if (_uicStrLen(nr) < 2) { return -1; }
  var d0: int64 := peek8(nr) - 48;
  var d1: int64 := peek8(nr + 1) - 48;
  if (d0 < 0 || d0 > 9 || d1 < 0 || d1 > 9) { return -1; }
  return d0 * 10 + d1;
}
