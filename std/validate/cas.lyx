// std/validate/cas.lyx
// CAS Registry Number — Chemical Abstracts Service

@description("CAS number validation: CASValidate, CASCheckDigit, CASNormalize")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.cas;

import std.alloc;
pub con CAS_OK:           int64 := 0;
pub con CAS_ERR_FORMAT:   int64 := 1;
pub con CAS_ERR_CHAR:     int64 := 2;
pub con CAS_ERR_CHECK:    int64 := 3;

fn _casStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _casIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

// Normalize: strip hyphens. out_buf needs at least 12 bytes.
pub fn CASNormalize(cas: int64, out_buf: int64): int64 {
  if (out_buf == 0) { return -1; }
  var pos: int64 := 0;
  var i: int64 := 0;
  var len: int64 := _casStrLen(cas);
  while (i < len && pos < 11) {
    var c: int64 := peek8(cas + i);
    if (c != 45) {
      poke8(out_buf + pos, c); pos := pos + 1;
    }
    i := i + 1;
  }
  poke8(out_buf + pos, 0);
  return 0;
}

// Compute CAS check digit for a normalized digit string (all digits, no hyphens).
// All digits (without last = check) multiplied from right to left with 1, 2, 3, ...
// Sum mod 10 = check digit. Returns 0–9 or -1 on error.
pub fn CASCheckDigit(cas: int64): int64 {
  var buf: int64 := alloc(12);
  if (buf == 0) { return -1; }
  CASNormalize(cas, buf);
  var len: int64 := _casStrLen(buf);
  if (len < 3 || len > 11) { free(buf, 12); return -1; }
  // Verify all chars are digits
  var i: int64 := 0;
  while (i < len) {
    if (_casIsDigit(peek8(buf + i)) == 0) { free(buf, 12); return -1; }
    i := i + 1;
  }
  // Sum: digits from position 0 to len-2 (excluding last = checkdigit),
  // multiplied from right to left: rightmost of payload gets weight 1, next 2, etc.
  var sum: int64 := 0;
  var payload: int64 := len - 1;
  var weight: int64 := 1;
  i := payload - 1;
  while (i >= 0) {
    var d: int64 := peek8(buf + i) - 48;
    sum := sum + d * weight;
    weight := weight + 1;
    i := i - 1;
  }
  free(buf, 12);
  return sum - (sum / 10) * 10;
}

// Validate a CAS number (format NNNNNN-NN-N, 5–10 digits total).
pub fn CASValidate(cas: int64): int64 {
  var buf: int64 := alloc(12);
  if (buf == 0) { return CAS_ERR_CHECK; }
  CASNormalize(cas, buf);
  var len: int64 := _casStrLen(buf);
  if (len < 3 || len > 11) { free(buf, 12); return CAS_ERR_FORMAT; }
  var i: int64 := 0;
  while (i < len) {
    if (_casIsDigit(peek8(buf + i)) == 0) { free(buf, 12); return CAS_ERR_CHAR; }
    i := i + 1;
  }
  var expected: int64 := CASCheckDigit(buf);
  var actual: int64 := peek8(buf + len - 1) - 48;
  free(buf, 12);
  if (expected < 0) { return CAS_ERR_CHECK; }
  if (expected != actual) { return CAS_ERR_CHECK; }
  return CAS_OK;
}
