// std/validate/iata.lyx
// IATA ticket number & Air Waybill — Mod 7 check digit

@description("IATA ticket/AWB: IATATicketValidate, IATAAWBValidate, IATACheckDigit")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.iata;

import std.alloc;
pub con IATA_OK:           int64 := 0;
pub con IATA_ERR_LENGTH:   int64 := 1;
pub con IATA_ERR_CHAR:     int64 := 2;
pub con IATA_ERR_CHECK:    int64 := 3;

fn _iataStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _iataIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

// Compute Mod 7 check digit for a pure digit string (without trailing check digit).
// Interprets the digit string as an integer mod 7.
// Returns the check digit (0–6), or -1 on invalid input.
pub fn IATACheckDigit(number_str: int64): int64 {
  var len: int64 := _iataStrLen(number_str);
  if (len < 1) { return -1; }
  var remainder: int64 := 0;
  var i: int64 := 0;
  while (i < len) {
    var c: int64 := peek8(number_str + i);
    if (_iataIsDigit(c) == 0) { return -1; }
    remainder := remainder * 10 + (c - 48);
    remainder := remainder - (remainder / 7) * 7;
    i += 1;
  }
  return remainder;
}

// Validate an IATA ticket number.
// Format: 3-digit airline code + 10 digits (last digit = check digit).
// Total: 13 characters, all digits.
pub fn IATATicketValidate(ticket: int64): int64 {
  var len: int64 := _iataStrLen(ticket);
  if (len != 13) { return IATA_ERR_LENGTH; }
  var i: int64 := 0;
  while (i < 13) {
    if (_iataIsDigit(peek8(ticket + i)) == 0) { return IATA_ERR_CHAR; }
    i += 1;
  }
  // Check digit is last digit; number is digits 3..11 (9 digits before check)
  var buf: int64 := alloc(12);
  if (buf == 0) { return IATA_ERR_CHECK; }
  i := 0;
  while (i < 9) {
    poke8(buf + i, peek8(ticket + 3 + i));
    i += 1;
  }
  poke8(buf + 9, 0);
  var expected: int64 := IATACheckDigit(buf);
  free(buf, 12);
  if (expected < 0) { return IATA_ERR_CHECK; }
  var actual: int64 := peek8(ticket + 12) - 48;
  if (expected != actual) { return IATA_ERR_CHECK; }
  return IATA_OK;
}

// Validate an IATA Air Waybill (AWB) number.
// Format: 3-digit airline code + 8 digits (last digit = check digit).
// Total: 11 characters, all digits.
pub fn IATAAWBValidate(awb: int64): int64 {
  var len: int64 := _iataStrLen(awb);
  if (len != 11) { return IATA_ERR_LENGTH; }
  var i: int64 := 0;
  while (i < 11) {
    if (_iataIsDigit(peek8(awb + i)) == 0) { return IATA_ERR_CHAR; }
    i += 1;
  }
  // Number: digits 3..9 (7 digits), check at position 10
  var buf: int64 := alloc(10);
  if (buf == 0) { return IATA_ERR_CHECK; }
  i := 0;
  while (i < 7) {
    poke8(buf + i, peek8(awb + 3 + i));
    i += 1;
  }
  poke8(buf + 7, 0);
  var expected: int64 := IATACheckDigit(buf);
  free(buf, 10);
  if (expected < 0) { return IATA_ERR_CHECK; }
  var actual: int64 := peek8(awb + 10) - 48;
  if (expected != actual) { return IATA_ERR_CHECK; }
  return IATA_OK;
}
