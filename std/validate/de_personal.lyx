unit std.validate.de_personal;

import std.alloc;
// --- Error codes ---

pub con DE_IDCARD_OK:            int64 := 0;
pub con DE_IDCARD_ERR_LENGTH:    int64 := 1;
pub con DE_IDCARD_ERR_CHAR:      int64 := 2;
pub con DE_IDCARD_ERR_CHECK:     int64 := 3;

pub con DE_STEUERID_OK:              int64 := 0;
pub con DE_STEUERID_ERR_LENGTH:      int64 := 1;
pub con DE_STEUERID_ERR_FIRST_DIGIT: int64 := 2;
pub con DE_STEUERID_ERR_CONSECUTIVE: int64 := 3;
pub con DE_STEUERID_ERR_CHECK:       int64 := 4;

pub con DE_RVNR_OK:           int64 := 0;
pub con DE_RVNR_ERR_LENGTH:   int64 := 1;
pub con DE_RVNR_ERR_FORMAT:   int64 := 2;
pub con DE_RVNR_ERR_CHECK:    int64 := 3;

pub con DE_GKV_OK:              int64 := 0;
pub con DE_GKV_ERR_LENGTH:      int64 := 1;
pub con DE_GKV_ERR_FIRST_CHAR:  int64 := 2;
pub con DE_GKV_ERR_CHECK:       int64 := 3;

// --- Private helpers ---

fn _dpStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _dpIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

fn _dpIsUpper(c: int64): int64 {
  if (c >= 65 && c <= 90) { return 1; }
  return 0;
}

fn _dpToUpper(c: int64): int64 {
  if (c >= 97 && c <= 122) { return c - 32; }
  return c;
}

// MRZ character value: '0'-'9'=face value, 'A'-'Z'=10-35, '<'=0
fn _dpMRZCharVal(c: int64): int64 {
  var u: int64 := _dpToUpper(c);
  if (u >= 48 && u <= 57) { return u - 48; }
  if (u >= 65 && u <= 90) { return u - 55; }
  if (u == 60) { return 0; }
  return -1;
}

// =============================================================
//  1.1  MRZ Prüfziffer & Personalausweis / Reisepass
// =============================================================

// Compute MRZ check digit for a field (weights 7,3,1 cycling, sum mod 10).
// Returns -1 if field contains an invalid character.
pub fn DEMRZCheckDigit(field: int64): int64 {
  var weights: int64 := 0;  // index into [7,3,1]
  var w0: int64 := 7;
  var w1: int64 := 3;
  var w2: int64 := 1;
  var sum: int64 := 0;
  var i: int64 := 0;
  var len: int64 := _dpStrLen(field);
  while (i < len) {
    var c: int64 := peek8(field + i);
    var v: int64 := _dpMRZCharVal(c);
    if (v < 0) { return -1; }
    var w: int64 := 0;
    var m: int64 := i - (i / 3) * 3;
    if (m == 0) { w := w0; }
    if (m == 1) { w := w1; }
    if (m == 2) { w := w2; }
    sum := sum + v * w;
    i := i + 1;
  }
  return sum - (sum / 10) * 10;
}

// Validate 2-line Personalausweis/ID-card MRZ.
// line1: 30-char TD1 line 1, line2: 30-char TD1 line 2.
// Check digits at positions: line1[14] covers line1[5..13],
// line1[19] covers line1[15..18], line1[29] covers line2[0..6],
// line2[14] covers line2[0..6]+line1[0..4]+line1[5..18] composite.
pub fn DEIDCardValidate(mrz_line1: int64, mrz_line2: int64): int64 {
  if (_dpStrLen(mrz_line1) != 30) { return DE_IDCARD_ERR_LENGTH; }
  if (_dpStrLen(mrz_line2) != 30) { return DE_IDCARD_ERR_LENGTH; }
  var buf: int64 := alloc(32);
  if (buf == 0) { return DE_IDCARD_ERR_CHECK; }

  // Check digit at line1[14] covers line1[5..13] (document number field)
  var i: int64 := 0;
  while (i < 9) {
    poke8(buf + i, peek8(mrz_line1 + 5 + i));
    i := i + 1;
  }
  poke8(buf + 9, 0);
  var cd: int64 := DEMRZCheckDigit(buf);
  if (cd < 0) { free(buf, 32); return DE_IDCARD_ERR_CHAR; }
  if (cd != (peek8(mrz_line1 + 14) - 48)) { free(buf, 32); return DE_IDCARD_ERR_CHECK; }

  // Check digit at line1[19] covers line1[15..18] (date of birth, excl. check)
  i := 0;
  while (i < 4) {
    poke8(buf + i, peek8(mrz_line1 + 15 + i));
    i := i + 1;
  }
  poke8(buf + 4, 0);
  cd := DEMRZCheckDigit(buf);
  if (cd < 0) { free(buf, 32); return DE_IDCARD_ERR_CHAR; }
  if (cd != (peek8(mrz_line1 + 19) - 48)) { free(buf, 32); return DE_IDCARD_ERR_CHECK; }

  // Check digit at line1[24] covers line1[20..23] (expiry date field)
  i := 0;
  while (i < 4) {
    poke8(buf + i, peek8(mrz_line1 + 20 + i));
    i := i + 1;
  }
  poke8(buf + 4, 0);
  cd := DEMRZCheckDigit(buf);
  if (cd < 0) { free(buf, 32); return DE_IDCARD_ERR_CHAR; }
  if (cd != (peek8(mrz_line1 + 24) - 48)) { free(buf, 32); return DE_IDCARD_ERR_CHECK; }

  free(buf, 32);
  return DE_IDCARD_OK;
}

// Validate 3-line biometric passport MRZ (TD3 format, lines 44 chars each).
pub fn DEPassportValidate(mrz_line1: int64, mrz_line2: int64, mrz_line3: int64): int64 {
  if (_dpStrLen(mrz_line1) != 44) { return DE_IDCARD_ERR_LENGTH; }
  if (_dpStrLen(mrz_line2) != 44) { return DE_IDCARD_ERR_LENGTH; }
  if (mrz_line3 != 0 && _dpStrLen(mrz_line3) != 44) { return DE_IDCARD_ERR_LENGTH; }
  var buf: int64 := alloc(48);
  if (buf == 0) { return DE_IDCARD_ERR_CHECK; }

  // Document number check digit: line1[5..13], check at line1[14]
  var i: int64 := 0;
  while (i < 9) {
    poke8(buf + i, peek8(mrz_line1 + 5 + i));
    i := i + 1;
  }
  poke8(buf + 9, 0);
  var cd: int64 := DEMRZCheckDigit(buf);
  if (cd < 0) { free(buf, 48); return DE_IDCARD_ERR_CHAR; }
  if (cd != (peek8(mrz_line1 + 14) - 48)) { free(buf, 48); return DE_IDCARD_ERR_CHECK; }

  // Date of birth check digit: line2[0..5], check at line2[6]
  i := 0;
  while (i < 6) {
    poke8(buf + i, peek8(mrz_line2 + i));
    i := i + 1;
  }
  poke8(buf + 6, 0);
  cd := DEMRZCheckDigit(buf);
  if (cd < 0) { free(buf, 48); return DE_IDCARD_ERR_CHAR; }
  if (cd != (peek8(mrz_line2 + 6) - 48)) { free(buf, 48); return DE_IDCARD_ERR_CHECK; }

  // Expiry date check digit: line2[8..13], check at line2[14]
  i := 0;
  while (i < 6) {
    poke8(buf + i, peek8(mrz_line2 + 8 + i));
    i := i + 1;
  }
  poke8(buf + 6, 0);
  cd := DEMRZCheckDigit(buf);
  if (cd < 0) { free(buf, 48); return DE_IDCARD_ERR_CHAR; }
  if (cd != (peek8(mrz_line2 + 14) - 48)) { free(buf, 48); return DE_IDCARD_ERR_CHECK; }

  // Final composite check digit: line2[0..9] + line1[5..14] + line2[8..14] + line2[18..42], check at line2[43]
  // Simplified: just validate line2[0..41] composite check at line2[42] per ICAO 9303
  i := 0;
  while (i < 43) {
    poke8(buf + i, peek8(mrz_line2 + i));
    i := i + 1;
  }
  poke8(buf + 43, 0);
  cd := DEMRZCheckDigit(buf);
  if (cd < 0) { free(buf, 48); return DE_IDCARD_ERR_CHAR; }
  if (cd != (peek8(mrz_line2 + 43) - 48)) { free(buf, 48); return DE_IDCARD_ERR_CHECK; }

  free(buf, 48);
  return DE_IDCARD_OK;
}

// =============================================================
//  1.2  Steueridentifikationsnummer
// =============================================================

// Compute check digit for an 11-digit Steuer-ID string (uses first 10 digits).
// Returns the expected check digit (0–9), or -1 on invalid input.
pub fn DESteuerIDCheckDigit(id: int64): int64 {
  if (_dpStrLen(id) < 10) { return -1; }
  var sum: int64 := 10;
  var i: int64 := 0;
  while (i < 10) {
    var d: int64 := peek8(id + i) - 48;
    if (d < 0 || d > 9) { return -1; }
    var product: int64 := (d + sum) - ((d + sum) / 10) * 10;
    if (product == 0) { product := 10; }
    sum := (product * 2) - ((product * 2) / 11) * 11;
    i := i + 1;
  }
  return (11 - sum) - ((11 - sum) / 10) * 10;
}

// Validate an 11-digit German Steueridentifikationsnummer.
pub fn DESteuerIDValidate(id: int64): int64 {
  if (_dpStrLen(id) != 11) { return DE_STEUERID_ERR_LENGTH; }
  // First digit must not be 0
  var first: int64 := peek8(id) - 48;
  if (first <= 0 || first > 9) { return DE_STEUERID_ERR_FIRST_DIGIT; }
  // No digit may appear 3 or more times consecutively
  var i: int64 := 1;
  while (i < 10) {
    var c: int64 := peek8(id + i);
    if (!_dpIsDigit(c)) { return DE_STEUERID_ERR_LENGTH; }
    if (i >= 2) {
      if (c == peek8(id + i - 1) && c == peek8(id + i - 2)) {
        return DE_STEUERID_ERR_CONSECUTIVE;
      }
    }
    i := i + 1;
  }
  // Validate check digit
  var expected: int64 := DESteuerIDCheckDigit(id);
  if (expected < 0) { return DE_STEUERID_ERR_CHECK; }
  var actual: int64 := peek8(id + 10) - 48;
  if (expected != actual) { return DE_STEUERID_ERR_CHECK; }
  return DE_STEUERID_OK;
}

// =============================================================
//  1.3  Rentenversicherungsnummer
// =============================================================

// Compute check digit for a 12-character RVNR.
// The letter at position 8 (0-based) is expanded to its 2-digit ordinal (A=01..Z=26).
// Weights: 2 1 2 1 2 1 2 1 2 1 2 1 applied to the resulting 12-digit string.
// Returns expected check digit (0–9), or -1 on error.
pub fn DERVNRCheckDigit(rvnr: int64): int64 {
  if (_dpStrLen(rvnr) < 11) { return -1; }
  var weights: int64 := alloc(12);
  if (weights == 0) { return -1; }
  poke8(weights + 0, 2); poke8(weights + 1, 1); poke8(weights + 2, 2);
  poke8(weights + 3, 1); poke8(weights + 4, 2); poke8(weights + 5, 1);
  poke8(weights + 6, 2); poke8(weights + 7, 1); poke8(weights + 8, 2);
  poke8(weights + 9, 1); poke8(weights + 10, 2); poke8(weights + 11, 1);

  // Build 13-digit numeric string in a local buffer
  var num: int64 := alloc(14);
  if (num == 0) { free(weights, 12); return -1; }
  var pos: int64 := 0;
  var i: int64 := 0;
  while (i < 11) {
    var c: int64 := peek8(rvnr + i);
    if (i == 8) {
      // Letter → ordinal (A=01..Z=26)
      var u: int64 := _dpToUpper(c);
      if (u < 65 || u > 90) { free(weights, 12); free(num, 14); return -1; }
      var ord: int64 := u - 64;  // A=1..Z=26
      poke8(num + pos, (ord / 10) + 48); pos := pos + 1;
      poke8(num + pos, (ord - (ord / 10) * 10) + 48); pos := pos + 1;
    } else {
      if (_dpIsDigit(c) == 0) { free(weights, 12); free(num, 14); return -1; }
      poke8(num + pos, c); pos := pos + 1;
    }
    i := i + 1;
  }
  poke8(num + pos, 0);

  // Apply weights to first 12 digits
  var sum: int64 := 0;
  i := 0;
  while (i < 12) {
    var d: int64 := peek8(num + i) - 48;
    var w: int64 := peek8(weights + i);
    var p: int64 := d * w;
    if (p > 9) { p := (p / 10) + (p - (p / 10) * 10); }
    sum := sum + p;
    i := i + 1;
  }
  free(weights, 12);
  free(num, 14);
  return sum - (sum / 10) * 10;
}

// Validate a 12-character Rentenversicherungsnummer.
pub fn DERVNRValidate(rvnr: int64): int64 {
  if (_dpStrLen(rvnr) != 12) { return DE_RVNR_ERR_LENGTH; }
  // First 8 must be digits
  var i: int64 := 0;
  while (i < 8) {
    if (_dpIsDigit(peek8(rvnr + i)) == 0) { return DE_RVNR_ERR_FORMAT; }
    i := i + 1;
  }
  // Position 8 must be a letter
  var u: int64 := _dpToUpper(peek8(rvnr + 8));
  if (u < 65 || u > 90) { return DE_RVNR_ERR_FORMAT; }
  // Positions 9–10 must be digits
  i := 9;
  while (i < 11) {
    if (_dpIsDigit(peek8(rvnr + i)) == 0) { return DE_RVNR_ERR_FORMAT; }
    i := i + 1;
  }
  // Check digit
  var expected: int64 := DERVNRCheckDigit(rvnr);
  if (expected < 0) { return DE_RVNR_ERR_CHECK; }
  var actual: int64 := peek8(rvnr + 11) - 48;
  if (expected != actual) { return DE_RVNR_ERR_CHECK; }
  return DE_RVNR_OK;
}

// Extract birthdate (DDMMYY at chars[2..7]) from a valid RVNR into out_buf (needs 7 bytes).
// Returns 0 on success, -1 on error.
pub fn DERVNRGetBirthdate(rvnr: int64, out_buf: int64): int64 {
  if (_dpStrLen(rvnr) < 8) { return -1; }
  if (out_buf == 0) { return -1; }
  var i: int64 := 0;
  while (i < 6) {
    poke8(out_buf + i, peek8(rvnr + 2 + i));
    i := i + 1;
  }
  poke8(out_buf + 6, 0);
  return 0;
}

// =============================================================
//  1.4  Krankenkassen-Versichertennummer (eGK)
// =============================================================

// Compute check digit for a 10-character GKV number.
// char[0] = letter → ordinal 01–26; chars[1..8] = 8 digits; char[9] = checkdigit.
// Returns expected check digit (0–9), or -1 on error.
pub fn DEGKVCheckDigit(nr: int64): int64 {
  if (_dpStrLen(nr) < 9) { return -1; }
  // Expand first char (letter) to 2-digit ordinal
  var letter: int64 := _dpToUpper(peek8(nr));
  if (letter < 65 || letter > 90) { return -1; }
  var ord: int64 := letter - 64;  // A=1..Z=26
  var d0: int64 := ord / 10;
  var d1: int64 := ord - d0 * 10;

  var weights_arr: int64 := alloc(11);
  if (weights_arr == 0) { return -1; }
  poke8(weights_arr + 0, 2); poke8(weights_arr + 1, 1); poke8(weights_arr + 2, 2);
  poke8(weights_arr + 3, 1); poke8(weights_arr + 4, 2); poke8(weights_arr + 5, 1);
  poke8(weights_arr + 6, 2); poke8(weights_arr + 7, 1); poke8(weights_arr + 8, 2);
  poke8(weights_arr + 9, 1); poke8(weights_arr + 10, 2);

  var digits: int64 := alloc(11);
  if (digits == 0) { free(weights_arr, 11); return -1; }
  poke8(digits + 0, d0);
  poke8(digits + 1, d1);
  var i: int64 := 0;
  while (i < 8) {
    var c: int64 := peek8(nr + 1 + i);
    if (_dpIsDigit(c) == 0) { free(weights_arr, 11); free(digits, 11); return -1; }
    poke8(digits + 2 + i, c - 48);
    i := i + 1;
  }

  var sum: int64 := 0;
  i := 0;
  while (i < 10) {
    var d: int64 := peek8(digits + i);
    var w: int64 := peek8(weights_arr + i);
    var p: int64 := d * w;
    if (p > 9) { p := (p / 10) + (p - (p / 10) * 10); }
    sum := sum + p;
    i := i + 1;
  }
  free(weights_arr, 11);
  free(digits, 11);
  return sum - (sum / 10) * 10;
}

// Validate a 10-character GKV Krankenversichertennummer.
pub fn DEGKVValidate(nr: int64): int64 {
  if (_dpStrLen(nr) != 10) { return DE_GKV_ERR_LENGTH; }
  var first: int64 := _dpToUpper(peek8(nr));
  if (first < 65 || first > 90) { return DE_GKV_ERR_FIRST_CHAR; }
  var i: int64 := 1;
  while (i < 9) {
    if (_dpIsDigit(peek8(nr + i)) == 0) { return DE_GKV_ERR_LENGTH; }
    i := i + 1;
  }
  var expected: int64 := DEGKVCheckDigit(nr);
  if (expected < 0) { return DE_GKV_ERR_CHECK; }
  var actual: int64 := peek8(nr + 9) - 48;
  if (expected != actual) { return DE_GKV_ERR_CHECK; }
  return DE_GKV_OK;
}
