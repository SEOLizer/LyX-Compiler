// German personal identification numbers: MRZ, Steuer-ID, RVNR, GKV

@description("German personal IDs: DEIDCardValidate, DEPassportValidate, DESteuerIDValidate, DERVNRValidate, DEGKVValidate")
@author("Andreas Röne")
