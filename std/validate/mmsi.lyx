// std/validate/mmsi.lyx
// Maritime Mobile Service Identity — ITU structural validation

@description("MMSI validation: MMSIValidate, MMSIGetCountry, MMSIGetType")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.mmsi;

pub con MMSI_OK:                int64 := 0;
pub con MMSI_ERR_LENGTH:        int64 := 1;
pub con MMSI_ERR_CHAR:          int64 := 2;
pub con MMSI_ERR_INVALID_MID:   int64 := 3;

// MMSI type constants
pub con MMSI_TYPE_SHIP:         int64 := 1;
pub con MMSI_TYPE_COAST:        int64 := 2;
pub con MMSI_TYPE_GROUP:        int64 := 3;
pub con MMSI_TYPE_SAR:          int64 := 4;
pub con MMSI_TYPE_UNKNOWN:      int64 := 0;

fn _mmsiStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _mmsiIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

// Decode 3-digit MID from the MMSI and return ISO country name in out_buf.
// out_buf needs at least 4 bytes for the numeric MID string.
// Returns MID (100–799) or -1 if not a ship MMSI.
pub fn MMSIGetCountry(mmsi: int64, out_buf: int64): int64 {
  if (_mmsiStrLen(mmsi) < 3) { return -1; }
  var d0: int64 := peek8(mmsi)     - 48;
  var d1: int64 := peek8(mmsi + 1) - 48;
  var d2: int64 := peek8(mmsi + 2) - 48;
  if (d0 < 0 || d1 < 0 || d2 < 0) { return -1; }
  // Coastal stations start with 00, SAR with 970, group with 0
  if (d0 == 0) { return -1; }
  if (d0 == 9 && d1 == 7 && d2 == 0) { return -1; }
  var mid: int64 := d0 * 100 + d1 * 10 + d2;
  if (out_buf != 0) {
    poke8(out_buf + 0, d0 + 48);
    poke8(out_buf + 1, d1 + 48);
    poke8(out_buf + 2, d2 + 48);
    poke8(out_buf + 3, 0);
  }
  return mid;
}

// Return MMSI type based on prefix pattern.
pub fn MMSIGetType(mmsi: int64): int64 {
  if (_mmsiStrLen(mmsi) < 9) { return MMSI_TYPE_UNKNOWN; }
  var d0: int64 := peek8(mmsi)     - 48;
  var d1: int64 := peek8(mmsi + 1) - 48;
  var d2: int64 := peek8(mmsi + 2) - 48;
  if (d0 < 0 || d1 < 0 || d2 < 0) { return MMSI_TYPE_UNKNOWN; }
  // SAR aircraft: prefix 970
  if (d0 == 9 && d1 == 7 && d2 == 0) { return MMSI_TYPE_SAR; }
  // Coastal station: prefix 00
  if (d0 == 0 && d1 == 0) { return MMSI_TYPE_COAST; }
  // Group call: prefix 0
  if (d0 == 0) { return MMSI_TYPE_GROUP; }
  // Ship: MID in range 100-799
  var mid: int64 := d0 * 100 + d1 * 10 + d2;
  if (mid >= 100 && mid <= 799) { return MMSI_TYPE_SHIP; }
  return MMSI_TYPE_UNKNOWN;
}

// Validate a 9-digit MMSI.
pub fn MMSIValidate(mmsi: int64): int64 {
  if (_mmsiStrLen(mmsi) != 9) { return MMSI_ERR_LENGTH; }
  var i: int64 := 0;
  while (i < 9) {
    if (_mmsiIsDigit(peek8(mmsi + i)) == 0) { return MMSI_ERR_CHAR; }
    i := i + 1;
  }
  var t: int64 := MMSIGetType(mmsi);
  if (t == MMSI_TYPE_UNKNOWN) { return MMSI_ERR_INVALID_MID; }
  return MMSI_OK;
}
