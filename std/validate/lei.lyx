// std/validate/lei.lyx
// Legal Entity Identifier — ISO 17442

@description("LEI validation: LEIValidate, LEIGetLOU (ISO 7064 Mod 97)")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.lei;

import std.alloc;
pub con LEI_OK:           int64 := 0;
pub con LEI_ERR_LENGTH:   int64 := 1;
pub con LEI_ERR_CHAR:     int64 := 2;
pub con LEI_ERR_CHECK:    int64 := 3;

fn _leiStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _leiToUpper(c: int64): int64 {
  if (c >= 97 && c <= 122) { return c - 32; }
  return c;
}

fn _leiIsAlphaNum(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  if (c >= 65 && c <= 90) { return 1; }
  return 0;
}

// ISO 7064 Mod 97 check on LEI (same algorithm as IBAN):
// Move last 2 chars to front, replace letters A=10..Z=35, compute mod 97.
// Valid if result == 1.
fn _leiMod97(lei: int64): int64 {
  // Build rearranged string: positions 0..17 + positions 18..19 (check chars at end → moved to start)
  // Actually for LEI the check digits ARE at positions 4..5 (indices 4,5), prefix is 0..3.
  // Rearrange: positions 4..19 then 0..3, then expand.
  var buf: int64 := alloc(48);
  if (buf == 0) { return -1; }
  var pos: int64 := 0;
  // Add chars 4..19 first
  var i: int64 := 4;
  while (i < 20) {
    var c: int64 := _leiToUpper(peek8(lei + i));
    if (c >= 65 && c <= 90) {
      var v: int64 := c - 55;
      poke8(buf + pos, (v / 10) + 48); pos := pos + 1;
      poke8(buf + pos, (v - (v / 10) * 10) + 48); pos := pos + 1;
    } else {
      poke8(buf + pos, c); pos := pos + 1;
    }
    i := i + 1;
  }
  // Add chars 0..3 (LOU prefix)
  i := 0;
  while (i < 4) {
    var c: int64 := _leiToUpper(peek8(lei + i));
    if (c >= 65 && c <= 90) {
      var v: int64 := c - 55;
      poke8(buf + pos, (v / 10) + 48); pos := pos + 1;
      poke8(buf + pos, (v - (v / 10) * 10) + 48); pos := pos + 1;
    } else {
      poke8(buf + pos, c); pos := pos + 1;
    }
    i := i + 1;
  }
  poke8(buf + pos, 0);

  // Compute mod 97 on digit string (process in chunks to avoid overflow)
  var remainder: int64 := 0;
  i := 0;
  while (i < pos) {
    var d: int64 := peek8(buf + i) - 48;
    remainder := remainder * 10 + d;
    remainder := remainder - (remainder / 97) * 97;
    i := i + 1;
  }
  free(buf, 48);
  return remainder;
}

// Validate a 20-character LEI.
pub fn LEIValidate(lei: int64): int64 {
  if (_leiStrLen(lei) != 20) { return LEI_ERR_LENGTH; }
  var i: int64 := 0;
  while (i < 20) {
    if (_leiIsAlphaNum(_leiToUpper(peek8(lei + i))) == 0) { return LEI_ERR_CHAR; }
    i := i + 1;
  }
  var mod: int64 := _leiMod97(lei);
  if (mod != 1) { return LEI_ERR_CHECK; }
  return LEI_OK;
}

// Copy the 4-character LOU prefix from a LEI into out_buf (needs 5 bytes).
pub fn LEIGetLOU(lei: int64, out_buf: int64): int64 {
  if (_leiStrLen(lei) < 4) { return -1; }
  if (out_buf == 0) { return -1; }
  var i: int64 := 0;
  while (i < 4) {
    poke8(out_buf + i, _leiToUpper(peek8(lei + i)));
    i := i + 1;
  }
  poke8(out_buf + 4, 0);
  return 0;
}
