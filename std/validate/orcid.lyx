// std/validate/orcid.lyx
// ORCID iD — ISO/IEC 7064 MOD 11-2

@description("ORCID iD validation: ORCIDValidate, ORCIDCheckDigit, ORCIDNormalize")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.orcid;

pub con ORCID_OK:           int64 := 0;
pub con ORCID_ERR_LENGTH:   int64 := 1;
pub con ORCID_ERR_CHAR:     int64 := 2;
pub con ORCID_ERR_CHECK:    int64 := 3;

fn _orcidStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _orcidToUpper(c: int64): int64 {
  if (c >= 97 && c <= 122) { return c - 32; }
  return c;
}

fn _orcidIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

// Normalize: strip hyphens and spaces, uppercase. out_buf needs at least 17 bytes.
pub fn ORCIDNormalize(orcid: int64, out_buf: int64): int64 {
  if (out_buf == 0) { return -1; }
  var pos: int64 := 0;
  var i: int64 := 0;
  var len: int64 := _orcidStrLen(orcid);
  while (i < len && pos < 16) {
    var c: int64 := peek8(orcid + i);
    if (c != 32 && c != 45) {
      poke8(out_buf + pos, _orcidToUpper(c)); pos := pos + 1;
    }
    i := i + 1;
  }
  poke8(out_buf + pos, 0);
  return 0;
}

// Compute ORCID check character (ISO/IEC 7064 MOD 11-2) for the first 15 digits.
// total = 0; for each digit: total = (total + digit) * 2; end: (12 - total%11) % 11.
// Rest 10 → 'X'. Returns ASCII char ('0'-'9' or 'X'), or -1 on error.
pub fn ORCIDCheckDigit(orcid: int64): int64 {
  var buf: int64 := mmap(0, 18, 3, 34, -1, 0);
  if (buf == 0) { return -1; }
  ORCIDNormalize(orcid, buf);
  if (_orcidStrLen(buf) < 15) { munmap(buf, 18); return -1; }
  var total: int64 := 0;
  var i: int64 := 0;
  while (i < 15) {
    var c: int64 := peek8(buf + i);
    if (_orcidIsDigit(c) == 0) { munmap(buf, 18); return -1; }
    total := (total + (c - 48)) * 2;
    i := i + 1;
  }
  munmap(buf, 18);
  var result: int64 := (12 - (total - (total / 11) * 11)) - ((12 - (total - (total / 11) * 11)) / 11) * 11;
  if (result == 10) { return 88; }   // 'X'
  return result + 48;
}

// Validate a 16-digit ORCID iD (may be formatted as XXXX-XXXX-XXXX-XXXC).
pub fn ORCIDValidate(orcid: int64): int64 {
  var buf: int64 := mmap(0, 18, 3, 34, -1, 0);
  if (buf == 0) { return ORCID_ERR_CHECK; }
  ORCIDNormalize(orcid, buf);
  if (_orcidStrLen(buf) != 16) { munmap(buf, 18); return ORCID_ERR_LENGTH; }
  var i: int64 := 0;
  while (i < 15) {
    if (_orcidIsDigit(peek8(buf + i)) == 0) { munmap(buf, 18); return ORCID_ERR_CHAR; }
    i := i + 1;
  }
  var lastC: int64 := peek8(buf + 15);
  if (lastC != 88 && (_orcidIsDigit(lastC) == 0)) { munmap(buf, 18); return ORCID_ERR_CHAR; }
  var expected: int64 := ORCIDCheckDigit(buf);
  munmap(buf, 18);
  if (expected < 0) { return ORCID_ERR_CHECK; }
  if (expected != lastC) { return ORCID_ERR_CHECK; }
  return ORCID_OK;
}
