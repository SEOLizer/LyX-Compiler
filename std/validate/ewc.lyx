// std/validate/ewc.lyx
// European Waste Catalogue (EWC/AVV) code validation — Decision 2000/532/EC

@description("EWC/AVV waste code: EWCValidate, EWCIsHazardous, EWCNormalize")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.validate.ewc;

import std.alloc;
pub con EWC_OK:                 int64 := 0;
pub con EWC_ERR_FORMAT:         int64 := 1;
pub con EWC_ERR_UNKNOWN_CODE:   int64 := 2;

fn _ewcStrLen(s: int64): int64 {
  if (s == 0) { return 0; }
  var i: int64 := 0;
  while (peek8(s + i) != 0) { i := i + 1; }
  return i;
}

fn _ewcIsDigit(c: int64): int64 {
  if (c >= 48 && c <= 57) { return 1; }
  return 0;
}

// Normalize: strip spaces and spaces/dots between groups, strip trailing '*'.
// Produces a 6-digit string in out_buf (needs 8 bytes) + optional trailing '*'.
// Returns 1 if hazardous (trailing * present), 0 otherwise, -1 on format error.
pub fn EWCNormalize(code: pchar, out_buf: int64): int64 {
  if (out_buf == 0) { return -1; }
  var pos: int64 := 0;
  var i: int64 := 0;
  var len: int64 := _ewcStrLen(code as int64);
  var hazardous: int64 := 0;
  while (i < len) {
    var c: int64 := peek8(code + i);
    if (c == 42) { hazardous := 1; }         // '*'
    else if (c != 32 && c != 32) {
      if (_ewcIsDigit(c) == 1 && pos < 6) {
        poke8(out_buf + pos, c); pos := pos + 1;
      }
    }
    i += 1;
  }
  if (hazardous == 1) {
    poke8(out_buf + pos, 42); pos := pos + 1;  // append '*'
  }
  poke8(out_buf + pos, 0);
  return hazardous;
}

// Returns 1 if the EWC code is marked as hazardous (trailing '*'), 0 otherwise.
pub fn EWCIsHazardous(code: pchar): int64 {
  var len: int64 := _ewcStrLen(code as int64);
  if (len == 0) { return 0; }
  var last: int64 := peek8(code + len - 1);
  if (last == 42) { return 1; }
  return 0;
}

// Validate an EWC code structurally.
// Format: 6 digits in format XX XX XX (chapter-subchapter-entry), optional trailing '*'.
// Chapter codes must be 01–20 (valid EWC chapters).
// Returns EWC_OK, EWC_ERR_FORMAT, or EWC_ERR_UNKNOWN_CODE.
pub fn EWCValidate(code: pchar): int64 {
  var buf: int64 := alloc(10);
  if (buf == 0) { return EWC_ERR_FORMAT; }
  EWCNormalize(code, buf);
  // After normalize, buf starts with 6 digits (+ optional '*')
  var len: int64 := _ewcStrLen(buf);
  if (len < 6) { free(buf, 10); return EWC_ERR_FORMAT; }
  var i: int64 := 0;
  while (i < 6) {
    if (_ewcIsDigit(peek8(buf + i)) == 0) { free(buf, 10); return EWC_ERR_FORMAT; }
    i += 1;
  }
  // Chapter (first 2 digits): must be 01–20
  var chap: int64 := (peek8(buf) - 48) * 10 + (peek8(buf + 1) - 48);
  if (chap < 1 || chap > 20) { free(buf, 10); return EWC_ERR_UNKNOWN_CODE; }
  // Subchapter (digits 3–4): must be 01–99 (non-zero)
  var sub: int64 := (peek8(buf + 2) - 48) * 10 + (peek8(buf + 3) - 48);
  if (sub == 0) { free(buf, 10); return EWC_ERR_UNKNOWN_CODE; }
  // Entry (digits 5–6): must be non-zero
  var entry: int64 := (peek8(buf + 4) - 48) * 10 + (peek8(buf + 5) - 48);
  if (entry == 0) { free(buf, 10); return EWC_ERR_UNKNOWN_CODE; }
  free(buf, 10);
  return EWC_OK;
}
