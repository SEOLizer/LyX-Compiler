unit std.result;

import std.math;
import std.vector;

// ============================================================================
// Error Codes
// ============================================================================

con ERR_NONE: int64 := 0;
con ERR_UNKNOWN: int64 := 1;
con ERR_INVALID_INPUT: int64 := 2;
con ERR_OUT_OF_BOUNDS: int64 := 3;
con ERR_DIVISION_BY_ZERO: int64 := 4;
con ERR_OVERFLOW: int64 := 5;
con ERR_UNDERFLOW: int64 := 6;
con ERR_PARSE_ERROR: int64 := 7;
con ERR_NOT_FOUND: int64 := 8;
con ERR_ALREADY_EXISTS: int64 := 9;
con ERR_PERMISSION_DENIED: int64 := 10;
con ERR_IO: int64 := 11;
con ERR_OUT_OF_MEMORY: int64 := 12;
con ERR_NOT_IMPLEMENTED: int64 := 13;

// ============================================================================
// ResultInt64 - Result with int64 value and int64 error code
// ============================================================================

pub type ResultInt64 = struct {
  success: bool;
  value: int64;
  error_code: int64;
}

// ============================================================================
// ResultInt64 Constructors
// ============================================================================

pub fn OkInt64(value: int64): ResultInt64 {
  var _sl47: ResultInt64;
  _sl47.success := true;
  _sl47.value := value;
  _sl47.error_code := ERR_NONE;
  return _sl47;
}

pub fn ErrInt64(error_code: int64): ResultInt64 {
  var _sl51: ResultInt64;
  _sl51.success := false;
  _sl51.value := 0;
  _sl51.error_code := error_code;
  return _sl51;
}

pub fn ErrInt64WithValue(error_code: int64, value: int64): ResultInt64 {
  var _sl55: ResultInt64;
  _sl55.success := false;
  _sl55.value := value;
  _sl55.error_code := error_code;
  return _sl55;
}

// ============================================================================
// ResultInt64 Methods
// ============================================================================

pub fn ResultInt64IsOk(r: ResultInt64): bool {
  return r.success;
}

pub fn ResultInt64IsErr(r: ResultInt64): bool {
  return not r.success;
}

pub fn ResultInt64Unwrap(r: ResultInt64): int64 {
  if (r.success) {
    return r.value;
  }
  panic("unwrap called on Err ResultInt64");
}

pub fn ResultInt64UnwrapOr(r: ResultInt64, fallback: int64): int64 {
  if (r.success) {
    return r.value;
  }
  return fallback;
}

// #1457: Hier stand `return default_fn;` — der uebergebene Wert selbst, also
// bei `f as int64` die CODEADRESSE. Der Parameter heisst default_fn, die Doku
// verspricht "das Ergebnis der Fallback-Funktion"; geliefert wurde eine Zahl,
// die zufaellig im gueltigen Bereich liegt und niemandem auffaellt.
pub fn ResultInt64UnwrapOrElse(r: ResultInt64, default_fn: int64): int64 {
  if (r.success) {
    return r.value;
  }
  if (default_fn == 0) { return 0; }
  return _indirect_call_0(default_fn);
}

pub fn ResultInt64Expect(r: ResultInt64, msg: pchar): int64 {
  if (r.success) {
    return r.value;
  }
  panic(msg);
}

pub fn ResultInt64Error(r: ResultInt64): int64 {
  return r.error_code;
}

// #1243: Diese vier Funktionen verpackten die ADRESSE der uebergebenen
// Funktion als Nutzwert, statt sie aufzurufen — `ResultInt64Map(Ok(21), f)`
// lieferte 4262147 statt 42. Bei `AndThen` wog es schwerer: die verkettete
// Funktion lief nie, konnte also keinen Fehler melden, und ein `Err` wurde zu
// einem `Ok` mit Muellwert.
//
// Die Signaturen bleiben `int64`, damit vorhandene Aufrufer mit `f as int64`
// unveraendert weiterlaufen; gerufen wird ueber einen Zeigertyp (der Wert IST
// die Codeadresse, siehe #1274).
type ResMapFn   = fn(int64): int64;
type ResChainFn = fn(int64): ResultInt64;

pub fn ResultInt64Map(r: ResultInt64, fn_val: int64): ResultInt64 {
  if (r.success) {
    var f: ResMapFn := fn_val as ResMapFn;
    return OkInt64(f(r.value));
  }
  return r;
}

pub fn ResultInt64MapErr(r: ResultInt64, fn_err: int64): ResultInt64 {
  if (r.success) {
    return r;
  }
  var g: ResMapFn := fn_err as ResMapFn;
  return ErrInt64(g(r.error_code));
}

pub fn ResultInt64AndThen(r: ResultInt64, fn_op: int64): ResultInt64 {
  if (r.success) {
    var h: ResChainFn := fn_op as ResChainFn;
    return h(r.value);
  }
  return r;
}

