// std/office/ods.lyx — OFF-05: ODS Tabellen-Writer
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, system.time])

unit std.office.ods;

import std.office.odf_doc;
import std.office.odf_xml;
import std.alloc;
import std.string;

fn odsEmptyCell(doc: OdfDocument) {
  doc._appendContent("<table:table-cell/>\n"c);
}

fn odsEnsureRow(doc: OdfDocument, targetRow: int64) {
  if doc.odsRowOpen != 0 {
    doc._appendContent("</table:table-row>\n"c);
    doc.odsRowOpen := 0;
  }
  var r: int64 := doc.odsCurRow + 1;
  while r < targetRow {
    doc._appendContent("<table:table-row/>\n"c);
    r += 1;
  }
  doc._appendContent("<table:table-row>\n"c);
  doc.odsRowOpen  := 1;
  doc.odsCurRow   := targetRow;
  doc.odsCurCol   := 0 - 1;
}

fn odsEnsureCol(doc: OdfDocument, targetCol: int64) {
  var startCol: int64 := doc.odsCurCol + 1;
  var c: int64 := startCol;
  while c < targetCol {
    odsEmptyCell(doc);
    c += 1;
  }
}

pub fn OdsAddSheet(doc: OdfDocument, name: pchar) {
  if doc.odsRowOpen != 0 {
    doc._appendContent("</table:table-row>\n"c);
    doc.odsRowOpen := 0;
  }
  if doc.odsSheetOpen != 0 {
    doc._appendContent("</table:table>\n"c);
    doc.odsSheetOpen := 0;
  }
  doc._appendContent("<table:table table:name=\""c);
  doc._appendEscaped(name);
  doc._appendContent("\">\n"c);
  doc.odsSheetOpen := 1;
  doc.odsCurRow    := 0 - 1;
  doc.odsCurCol    := 0 - 1;
}

pub fn OdsFlushSheet(doc: OdfDocument) {
  if doc.odsRowOpen != 0 {
    doc._appendContent("</table:table-row>\n"c);
    doc.odsRowOpen := 0;
  }
  if doc.odsSheetOpen != 0 {
    doc._appendContent("</table:table>\n"c);
    doc.odsSheetOpen := 0;
  }
  doc.odsCurRow := 0 - 1;
  doc.odsCurCol := 0 - 1;
}

pub fn OdsSetCell(doc: OdfDocument, row: int64, col: int64, text: pchar) {
  if row > doc.odsCurRow || doc.odsRowOpen == 0 {
    odsEnsureRow(doc, row);
  }
  odsEnsureCol(doc, col);
  doc._appendContent("<table:table-cell office:value-type=\"string\">\n<text:p>"c);
  doc._appendEscaped(text);
  doc._appendContent("</text:p>\n</table:table-cell>\n"c);
  doc.odsCurCol := col;
}

pub fn OdsSetCellInt(doc: OdfDocument, row: int64, col: int64, val: int64) {
  if row > doc.odsCurRow || doc.odsRowOpen == 0 {
    odsEnsureRow(doc, row);
  }
  odsEnsureCol(doc, col);

  var vbuf: int64 := alloc(24);
  Int64ToStr(val, vbuf);

  doc._appendContent("<table:table-cell office:value-type=\"float\" office:value=\""c);
  doc._appendContent(vbuf as pchar);
  doc._appendContent("\">\n<text:p>"c);
  doc._appendContent(vbuf as pchar);
  doc._appendContent("</text:p>\n</table:table-cell>\n"c);
  doc.odsCurCol := col;

  free(vbuf, 24);
}

// val = integer × 10^decimals  (Beispiel: 3.14 → val=314, decimals=2)
pub fn OdsSetCellFloat(doc: OdfDocument, row: int64, col: int64, val: int64, decimals: int64) {
  if row > doc.odsCurRow || doc.odsRowOpen == 0 {
    odsEnsureRow(doc, row);
  }
  odsEnsureCol(doc, col);

  var negative: int64 := 0;
  var absVal: int64 := val;
  if val < 0 { negative := 1; absVal := 0 - val; }

  var dbuf: int64 := alloc(64);
  var dpos: int64 := 0;

  if negative != 0 {
    poke8(dbuf + dpos, 45);
    dpos += 1;
  }

  if decimals <= 0 {
    var ibuf: int64 := alloc(24);
    Int64ToStr(absVal, ibuf);
    var ilen: int64 := StrLen(ibuf as pchar);
    var ii: int64 := 0;
    while ii < ilen { poke8(dbuf + dpos, peek8(ibuf + ii)); dpos := dpos + 1; ii := ii + 1; }
    free(ibuf, 24);
  } else {
    var divisor: int64 := 1;
    var d: int64 := 0;
    while d < decimals { divisor := divisor * 10; d := d + 1; }

    var wholePart: int64 := absVal / divisor;
    var fracPart:  int64 := absVal - wholePart * divisor;

    var wbuf: int64 := alloc(24);
    Int64ToStr(wholePart, wbuf);
    var wlen: int64 := StrLen(wbuf as pchar);
    var wi: int64 := 0;
    while wi < wlen { poke8(dbuf + dpos, peek8(wbuf + wi)); dpos := dpos + 1; wi := wi + 1; }
    free(wbuf, 24);

    poke8(dbuf + dpos, 46);
    dpos += 1;

    var fbuf: int64 := alloc(24);
    Int64ToStr(fracPart, fbuf);
    var flen: int64 := StrLen(fbuf as pchar);
    var pad: int64 := decimals - flen;
    var pi: int64 := 0;
    while pi < pad { poke8(dbuf + dpos, 48); dpos := dpos + 1; pi := pi + 1; }
    var fi: int64 := 0;
    while fi < flen { poke8(dbuf + dpos, peek8(fbuf + fi)); dpos := dpos + 1; fi := fi + 1; }
    free(fbuf, 24);
  }

  poke8(dbuf + dpos, 0);

  doc._appendContent("<table:table-cell office:value-type=\"float\" office:value=\""c);
  doc._appendContent(dbuf as pchar);
  doc._appendContent("\">\n<text:p>"c);
  doc._appendContent(dbuf as pchar);
  doc._appendContent("</text:p>\n</table:table-cell>\n"c);
  doc.odsCurCol := col;

  free(dbuf, 64);
}
