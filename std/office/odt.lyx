// std/office/odt.lyx — OFF-04: ODT Text-Writer
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, system.time])

unit std.office.odt;

import std.office.odf_doc;
import std.office.odf_xml;
import std.alloc;
import std.string;

pub fn OdtAddParagraph(doc: OdfDocument, text: pchar) {
  doc._appendContent("<text:p text:style-name=\"Standard\">"c);
  doc._appendEscaped(text);
  doc._appendContent("</text:p>\n"c);
}

pub fn OdtAddLineBreak(doc: OdfDocument) {
  doc._appendContent("<text:p text:style-name=\"Standard\"/>\n"c);
}

pub fn OdtAddHorizontalRule(doc: OdfDocument) {
  doc._appendContent("<text:p text:style-name=\"Standard\">──────────────────────────────────────</text:p>\n"c);
}

pub fn OdtAddHeading(doc: OdfDocument, text: pchar, level: int64) {
  var lvl: int64 := level;
  if lvl < 1 { lvl := 1; }
  if lvl > 6 { lvl := 6; }

  var lbuf: int64 := alloc(4);
  Int64ToStr(lvl, lbuf);

  doc._appendContent("<text:h text:style-name=\"Heading_"c);
  doc._appendContent(lbuf as pchar);
  doc._appendContent("\" text:outline-level=\""c);
  doc._appendContent(lbuf as pchar);
  doc._appendContent("\">"c);
  doc._appendEscaped(text);
  doc._appendContent("</text:h>\n"c);

  free(lbuf, 4);
}

pub fn OdtAddParagraphStyled(doc: OdfDocument, text: pchar, bold: int64, italic: int64) {
  if bold == 0 && italic == 0 {
    OdtAddParagraph(doc, text);
    return;
  }

  var sIdx: int64 := doc._getOrCreateStyle(bold, italic);

  var sibuf: int64 := alloc(8);
  Int64ToStr(sIdx, sibuf);

  doc._appendContent("<text:p text:style-name=\"Standard\"><text:span text:style-name=\"as"c);
  doc._appendContent(sibuf as pchar);
  doc._appendContent("\">"c);
  doc._appendEscaped(text);
  doc._appendContent("</text:span></text:p>\n"c);

  free(sibuf, 8);
}
