// std/signal — WP-3: Signalbehandlung
// Wrapper um sys_rt_sigaction, sys_rt_sigprocmask, sys_signalfd4, sys_kill, sys_tgkill
//
// Signal-Restorer: eigenes Trampolin (siehe _sigRestorer, #1267). Einen
// vDSO-Restorer, den rt_sigaction von sich aus benutzen wuerde, gibt es auf
// x86-64 NICHT — die libc liefert ihn sonst mit.
// Das funktioniert auf allen Linux-Kerneln >= 2.6 ohne eigenen Trampolin-Code.

import std.alloc;

// ============================================================
// Signalnummern (POSIX / Linux x86-64)
// ============================================================
pub con SIGHUP:  int64 := 1;
pub con SIGINT:  int64 := 2;
pub con SIGQUIT: int64 := 3;
pub con SIGILL:  int64 := 4;
pub con SIGTRAP: int64 := 5;
pub con SIGABRT: int64 := 6;
pub con SIGBUS:  int64 := 7;
pub con SIGFPE:  int64 := 8;
pub con SIGKILL: int64 := 9;
pub con SIGUSR1: int64 := 10;
pub con SIGSEGV: int64 := 11;
pub con SIGUSR2: int64 := 12;
pub con SIGPIPE: int64 := 13;
pub con SIGALRM: int64 := 14;
pub con SIGTERM: int64 := 15;
pub con SIGSTKFLT: int64 := 16;
pub con SIGCHLD: int64 := 17;
pub con SIGCONT: int64 := 18;
pub con SIGSTOP: int64 := 19;
pub con SIGTSTP: int64 := 20;
pub con SIGTTIN: int64 := 21;
pub con SIGTTOU: int64 := 22;
pub con SIGURG:  int64 := 23;
pub con SIGXCPU: int64 := 24;
pub con SIGXFSZ: int64 := 25;
pub con SIGVTALRM: int64 := 26;
pub con SIGPROF: int64 := 27;
pub con SIGWINCH: int64 := 28;
pub con SIGIO:   int64 := 29;
pub con SIGPWR:  int64 := 30;
pub con SIGSYS:  int64 := 31;

// Standard-Handler
pub con SIG_DFL: int64 := 0;  // Standard-Verhalten
pub con SIG_IGN: int64 := 1;  // Signal ignorieren

// ============================================================
// sigaction-Struktur (x86-64 Linux, 32 Bytes)
//   +0:  sa_handler / sa_sigaction  (8 Bytes)
//   +8:  sa_flags                   (8 Bytes)
//   +16: sa_restorer                (8 Bytes, Pflicht auf x86-64)
//   +24: sa_mask (kernel_sigset_t)  (8 Bytes)
// ============================================================
pub con SIGACTION_SIZE: int64 := 32;

// sa_flags-Bits
pub con SA_NOCLDSTOP: int64 := 1;
pub con SA_NOCLDWAIT: int64 := 2;
pub con SA_SIGINFO:   int64 := 4;
pub con SA_RESTORER:  int64 := 67108864;   // 0x04000000 (#1267: wird gesetzt)
pub con SA_RESTART:   int64 := 268435456;  // 0x10000000
pub con SA_NODEFER:   int64 := 1073741824; // 0x40000000
pub con SA_RESETHAND: int64 := 2147483648; // 0x80000000

// rt_sigprocmask: how-Werte
pub con SIG_BLOCK:   int64 := 0;
pub con SIG_UNBLOCK: int64 := 1;
pub con SIG_SETMASK: int64 := 2;

// signalfd-Flags
pub con SFD_CLOEXEC:  int64 := 524288;  // 0x80000
pub con SFD_NONBLOCK: int64 := 2048;    // 0x800

// signalfd_siginfo: 128 Bytes; ssi_signo (uint32) an Offset 0
pub con SIGNALFD_SIGINFO_SIZE: int64 := 128;

// ============================================================
// Signal-Handler registrieren
// ============================================================

// SignalSet: Registriert handler für signum.
// handler: Adresse einer Lyx-Funktion fn(signo: int64) oder SIG_DFL / SIG_IGN.
// Unterbrochene Syscalls werden bei echten Handlern automatisch neu gestartet (SA_RESTART).
// Der Kernel-vDSO-Restorer wird verwendet — kein eigener Trampolin nötig.
// #1267: Das Restorer-Trampolin. Der Kernel springt es nach dem Handler an,
// und zwar OHNE Aufrufrahmen: rsp zeigt auf den Sigframe, den `rt_sigreturn`
// (Nr. 15) genau dort erwartet. Eine gewoehnliche Lyx-Funktion taugt deshalb
// nicht — ihr Prolog verschiebt rsp und damit den Frame. Uebrig bleiben zwei
// Befehle in einer eigenen ausfuehrbaren Seite:
//
//     48 c7 c0 0f 00 00 00    mov rax, 15   (rt_sigreturn)
//     0f 05                   syscall
//
// Ohne diesen Zeiger UND das Flag SA_RESTORER kehrt der Handler nicht zurueck:
// der Kernel springt eine Null an, der Prozess stirbt an SIGSEGV. Vorher stand
// hier eine 0 mit dem Vermerk "Kernel nutzt vDSO" — den gibt es nicht.
var _sigRestorerAddr: int64 := 0;

fn _sigRestorer(): int64 {
  if (_sigRestorerAddr != 0) { return _sigRestorerAddr; }
  // PROT_READ|WRITE|EXEC = 7, MAP_PRIVATE|MAP_ANONYMOUS = 0x22
  var pg: int64 := mmap(0, 4096, 7, 34, 0 - 1, 0);
  if (pg <= 0) { return 0; }
  poke8(pg + 0, 72); poke8(pg + 1, 199); poke8(pg + 2, 192);
  poke8(pg + 3, 15); poke8(pg + 4, 0); poke8(pg + 5, 0); poke8(pg + 6, 0);
  poke8(pg + 7, 15); poke8(pg + 8, 5);
  _sigRestorerAddr := pg;
  return pg;
}

pub fn SignalSet(signum: int64, handler: int64): int64 {
  var act: int64 := alloc(SIGACTION_SIZE);
  if (act == 0) { return -1; }
  poke64(act + 0,  handler);
  var flags: int64 := 0;
  var restorer: int64 := 0;
  if (handler != SIG_DFL && handler != SIG_IGN) {
    restorer := _sigRestorer();
    // Fail-loud: ohne Trampolin wuerde die Registrierung gelingen und der
    // Prozess erst bei der Zustellung sterben — weit weg von der Ursache.
    if (restorer == 0) { free(act, SIGACTION_SIZE); return -1; }
    flags := SA_RESTART + SA_RESTORER;
  }
  poke64(act + 8,  flags);
  poke64(act + 16, restorer);
  poke64(act + 24, 0);  // sa_mask leer
  var r: int64 := sys_rt_sigaction(signum, act, 0, 8);
  free(act, SIGACTION_SIZE);
  return r;
}

// SignalIgnore: Signal dauerhaft ignorieren (SIG_IGN).
pub fn SignalIgnore(signum: int64): int64 {
  return SignalSet(signum, SIG_IGN);
}

// SignalDefault: Standard-Verhalten wiederherstellen (SIG_DFL).
pub fn SignalDefault(signum: int64): int64 {
  return SignalSet(signum, SIG_DFL);
}

// ============================================================
// Signal-Maske (pro Thread / Prozess)
// ============================================================

// SignalMaskBlock: Fügt signum zur Blockiermaske hinzu (Signal wird zurückgehalten).
pub fn SignalMaskBlock(signum: int64): int64 {
  var mask: int64 := alloc(8);
  if (mask == 0) { return -1; }
  poke64(mask, 1 << (signum - 1));
  var r: int64 := sys_rt_sigprocmask(SIG_BLOCK, mask, 0, 8);
  free(mask, 8);
  return r;
}

// SignalMaskUnblock: Entfernt signum aus der Blockiermaske.
pub fn SignalMaskUnblock(signum: int64): int64 {
  var mask: int64 := alloc(8);
  if (mask == 0) { return -1; }
  poke64(mask, 1 << (signum - 1));
  var r: int64 := sys_rt_sigprocmask(SIG_UNBLOCK, mask, 0, 8);
  free(mask, 8);
  return r;
}

// SignalMaskGet: Schreibt die aktuelle Blockiermaske in outMask (alloc(8)).
pub fn SignalMaskGet(outMask: int64): int64 {
  return sys_rt_sigprocmask(SIG_BLOCK, 0, outMask, 8);
}

// ============================================================
// Signal senden
// ============================================================

// SignalSend: Sendet signum an den Prozess pid (kill-Syscall).
// pid = 0 → Prozessgruppe, pid = -1 → alle Prozesse (mit Berechtigung).
pub fn SignalSend(pid: int64, signum: int64): int64 {
  return sys_kill(pid, signum);
}

// SignalSendSelf: Sendet signum an den eigenen Prozess.
pub fn SignalSendSelf(signum: int64): int64 {
  return sys_kill(sys_getpid(), signum);
}

// SignalSendThread: Sendet signum an einen spezifischen Thread (tgkill).
// tgid: Thread-Group-ID (= PID des Prozesses), tid: Thread-ID.
pub fn SignalSendThread(tgid: int64, tid: int64, signum: int64): int64 {
  return sys_tgkill(tgid, tid, signum);
}

// ============================================================
// signalfd — Signal-Empfang über fd (epoll-integrierbar)
// ============================================================

// SignalFd: Erstellt einen signalfd für signum.
// WICHTIG: signum muss VORHER via SignalMaskBlock blockiert werden,
//          sonst kann das Signal vor dem signalfd-read ausgeliefert werden.
// Gibt den fd zurück, oder < 0 bei Fehler.
pub fn SignalFd(signum: int64): int64 {
  var mask: int64 := alloc(8);
  if (mask == 0) { return -1; }
  poke64(mask, 1 << (signum - 1));
  var fd: int64 := sys_signalfd4(-1, mask, 8, SFD_CLOEXEC);
  free(mask, 8);
  return fd;
}

// SignalFdRead: Liest ein signalfd_siginfo-Struct vom signalfd.
// buf: alloc(SIGNALFD_SIGINFO_SIZE) — muss 128 Bytes groß sein.
// Gibt 128 bei Erfolg zurück, < 0 bei Fehler.
pub fn SignalFdRead(fd: int64, buf: int64): int64 {
  return sys_read(fd, buf, SIGNALFD_SIGINFO_SIZE);
}

// SignalFdSigno: Extrahiert die Signalnummer aus einem signalfd_siginfo-Buffer.
// ssi_signo ist uint32 an Offset 0; für Signale 1-64 reicht das erste Byte.
pub fn SignalFdSigno(buf: int64): int64 {
  return peek64(buf) & 255;
}
