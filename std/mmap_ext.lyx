// std/mmap_ext — WP-9: erweiterte Memory-Operationen
// Wrapper um sys_mremap, sys_madvise, sys_msync,
// sys_memfd_create, sys_mlock, sys_munlock, sys_mincore

// ============================================================
// Konstanten
// ============================================================

// madvise-Hinweise
pub con MADV_NORMAL:     int64 := 0;
pub con MADV_RANDOM:     int64 := 1;
pub con MADV_SEQUENTIAL: int64 := 2;
pub con MADV_WILLNEED:   int64 := 3;
pub con MADV_DONTNEED:   int64 := 4;
pub con MADV_FREE:       int64 := 8;
pub con MADV_REMOVE:     int64 := 9;
pub con MADV_HUGEPAGE:   int64 := 14;
pub con MADV_NOHUGEPAGE: int64 := 15;
pub con MADV_COLD:       int64 := 20;
pub con MADV_PAGEOUT:    int64 := 21;

// msync-Flags
pub con MS_ASYNC:      int64 := 1;
pub con MS_SYNC:       int64 := 4;
pub con MS_INVALIDATE: int64 := 2;

// mremap-Flags
pub con MREMAP_MAYMOVE:   int64 := 1;
pub con MREMAP_FIXED:     int64 := 2;
pub con MREMAP_DONTUNMAP: int64 := 4;

// memfd_create-Flags
pub con MFD_CLOEXEC:       int64 := 1;
pub con MFD_ALLOW_SEALING: int64 := 2;
pub con MFD_HUGETLB:       int64 := 4;

// Seitengröße (x86-64 Linux)
pub con PAGE_SIZE: int64 := 4096;

// ============================================================
// mremap — Puffer vergrößern / verkleinern
// ============================================================

// MmapResize: ändert die Größe eines mmap'd Bereichs.
// Gibt die neue Adresse zurück (kann sich ändern!), oder < 0 bei Fehler.
// Verwendet MREMAP_MAYMOVE — der Kernel darf den Bereich verschieben.
pub fn MmapResize(addr: int64, oldSize: int64, newSize: int64): int64 {
  return sys_mremap(addr, oldSize, newSize, MREMAP_MAYMOVE, 0);
}

// MmapResizeFixed: verschiebt und ändert Größe auf eine feste Zieladresse.
// Erfordert MREMAP_MAYMOVE | MREMAP_FIXED und eine freie Zieladresse.
pub fn MmapResizeFixed(addr: int64, oldSize: int64, newSize: int64, newAddr: int64): int64 {
  return sys_mremap(addr, oldSize, newSize, MREMAP_MAYMOVE | MREMAP_FIXED, newAddr);
}

// ============================================================
// madvise — Zugriffshinweise an den Kernel
// ============================================================

// MmapAdvise: gibt dem Kernel einen Hinweis über das Zugriffsverhalten.
// advice: MADV_SEQUENTIAL, MADV_RANDOM, MADV_WILLNEED, MADV_DONTNEED, ...
pub fn MmapAdvise(addr: int64, len: int64, advice: int64): int64 {
  return sys_madvise(addr, len, advice);
}

// MmapFreePages: gibt physikalische Seiten zurück (Mapping bleibt gültig).
// Nächster Zugriff gibt nullisierte Seiten. Entspricht MADV_DONTNEED.
pub fn MmapFreePages(addr: int64, len: int64): int64 {
  return sys_madvise(addr, len, MADV_DONTNEED);
}

// ============================================================
// msync — Memory-gemappte Dateien auf Disk synchronisieren
// ============================================================

// MmapSync: synchronisiert einen mmap'd Bereich mit der zugrunde liegenden Datei.
// flags: MS_SYNC (blockierend), MS_ASYNC (nicht-blockierend), MS_INVALIDATE.
// Auf anonymen Mappings ist dies ein No-Op (gibt 0 zurück).
pub fn MmapSync(addr: int64, len: int64, flags: int64): int64 {
  return sys_msync(addr, len, flags);
}

// ============================================================
// memfd_create — In-Memory-Datei als fd
// ============================================================

// MemFdCreate: erstellt eine anonyme In-Memory-Datei.
// name: Debug-Name (sichtbar in /proc/pid/fd), flags: MFD_CLOEXEC etc.
// Gibt den fd zurück, oder < 0 bei Fehler.
// Nutzung: ftruncate → mmap für shared memory ohne Filesystem.
pub fn MemFdCreate(name: pchar, flags: int64): int64 {
  return sys_memfd_create(name, flags);
}

// ============================================================
// mlock / munlock — Seiten im RAM fixieren
// ============================================================

// MemLock: sperrt Seiten im RAM (kein Swapping). Erfordert CAP_IPC_LOCK
// oder RLIMIT_MEMLOCK-Budget. Gibt 0 bei Erfolg, < 0 bei Fehler.
pub fn MemLock(addr: int64, len: int64): int64 {
  return sys_mlock(addr, len);
}

// MemUnlock: hebt die Sperre auf (Seiten dürfen wieder ausgelagert werden).
pub fn MemUnlock(addr: int64, len: int64): int64 {
  return sys_munlock(addr, len);
}

// ============================================================
// mincore — prüfen welche Seiten im RAM sind
// ============================================================

// MemInCore: füllt vecOut mit dem Residency-Status der Seiten.
// vecOut: alloc(ceil(len / PAGE_SIZE)) Bytes — Bit 0 jedes Bytes = 1 → Seite im RAM.
// Gibt 0 bei Erfolg, < 0 bei Fehler.
pub fn MemInCore(addr: int64, len: int64, vecOut: int64): int64 {
  return sys_mincore(addr, len, vecOut);
}

// MemIsResident: gibt true zurück wenn die erste Seite von addr im RAM ist.
pub fn MemIsResident(addr: int64): bool {
  var vec: int64 := mmap(0, 8, 3, 34, -1, 0);
  if (vec == 0) { return false; }
  poke8(vec, 0);
  var r: int64 := sys_mincore(addr, PAGE_SIZE, vec);
  var resident: bool := false;
  if (r == 0) {
    resident := (peek8(vec) & 1) != 0;
  }
  munmap(vec, 8);
  return resident;
}
