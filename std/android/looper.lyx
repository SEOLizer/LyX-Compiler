// Lyx Android Stdlib - ALooper
// WP-AND-07
//
// Constants and opaque type for the NDK android/looper.h API. ALooper is
// the per-thread event-dispatch primitive that Android uses to multiplex
// input events, sensor events and arbitrary file-descriptor wakeups in
// the main loop of a NativeActivity. Real function calls live in
// libandroid.so — blocked, see asset.lyx in WP-AND-06.
//
// Reference: $ANDROID_NDK/sysroot/usr/include/android/looper.h

unit std.android.looper;

// ---------------------------------------------------------------------------
// ALooper_pollOnce / ALooper_pollAll return codes.
// ---------------------------------------------------------------------------

pub con ALOOPER_POLL_WAKE:     int64 := -1;   // wake() called from another thread
pub con ALOOPER_POLL_CALLBACK: int64 := -2;   // one or more callbacks fired
pub con ALOOPER_POLL_TIMEOUT:  int64 := -3;   // timeout expired with no events
pub con ALOOPER_POLL_ERROR:    int64 := -4;   // descriptor error

// ---------------------------------------------------------------------------
// ALooper_addFd event-set bits and dispatch flags.
// ---------------------------------------------------------------------------

pub con ALOOPER_EVENT_INPUT:   int64 := 0x01;
pub con ALOOPER_EVENT_OUTPUT:  int64 := 0x02;
pub con ALOOPER_EVENT_ERROR:   int64 := 0x04;
pub con ALOOPER_EVENT_HANGUP:  int64 := 0x08;
pub con ALOOPER_EVENT_INVALID: int64 := 0x10;

// ALooper_prepare flag: registers the looper even if no callbacks will be
// installed; required for ident-based polling.
pub con ALOOPER_PREPARE_ALLOW_NON_CALLBACKS: int64 := 1;

// ---------------------------------------------------------------------------
// Opaque looper handle.
// ---------------------------------------------------------------------------

pub type ALooper = int64;

// Standard ident slots used by android_app_glue.
pub con LOOPER_ID_MAIN:  int64 := 1;   // main pipe (lifecycle commands)
pub con LOOPER_ID_INPUT: int64 := 2;   // AInputQueue
pub con LOOPER_ID_USER:  int64 := 3;   // first free ident; user code may bump

