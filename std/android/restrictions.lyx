// Lyx Android Stdlib - Restricted Syscall Catalog
// WP-AND-04
//
// Bionic / Android SELinux policy denies a fixed set of upstream-Linux
// syscalls to app processes. This unit exposes their syscall numbers and
// human-readable names as `pub con` constants so user code can reference
// them in seccomp filters, audit reports, or static-analysis passes
// without re-deriving the table.
//
// Numbers below are the AArch64 generic-Linux assignments (same as
// Android-ARM64). Where the x86_64 assignment differs, both are listed.
//
// Reference: bionic/libc/SECCOMP_ALLOWLIST_APP.TXT (NDK r25+).

unit std.android.restrictions;

// ---------------------------------------------------------------------------
// Forbidden on app processes (SELinux denies; seccomp filter typically EPERM).
// ---------------------------------------------------------------------------

pub con SYS_AND_FORK_ARM64:        int64 := -1;   // arm64: fork removed; use clone
pub con SYS_AND_FORK_X86_64:       int64 := 57;   // x86_64: fork() blocked by policy
pub con SYS_AND_VFORK_X86_64:      int64 := 58;   // x86_64: vfork() blocked
pub con SYS_AND_PERSONALITY:       int64 := 92;   // generic: blocked on app domain
pub con SYS_AND_ACCT:              int64 := 89;   // process accounting (root only)
pub con SYS_AND_KEXEC_LOAD:        int64 := 104;  // root only
pub con SYS_AND_INIT_MODULE:       int64 := 105;  // root only
pub con SYS_AND_DELETE_MODULE:     int64 := 106;  // root only
pub con SYS_AND_REBOOT:            int64 := 142;  // power-management daemon only
pub con SYS_AND_SWAPON:            int64 := 224;
pub con SYS_AND_SWAPOFF:           int64 := 225;

// ---------------------------------------------------------------------------
// Restricted: callable but trace-back to debuggable apps only.
// ---------------------------------------------------------------------------

pub con SYS_AND_PTRACE:            int64 := 117;  // debuggable apps + Trace API only
pub con SYS_AND_PROCESS_VM_READV:  int64 := 270;  // app-domain restricted
pub con SYS_AND_PROCESS_VM_WRITEV: int64 := 271;

// ---------------------------------------------------------------------------
// API-level-gated syscalls (available on newer Android only).
// ---------------------------------------------------------------------------

pub con SYS_AND_GETRANDOM_ARM64:   int64 := 278;  // available from Android 6.0 (API 23)
pub con SYS_AND_GETRANDOM_X86_64:  int64 := 318;  // ditto
pub con SYS_AND_MEMFD_CREATE_ARM64:  int64 := 279; // memfd_create — API 26+
pub con SYS_AND_MEMFD_CREATE_X86_64: int64 := 319;
pub con SYS_AND_PIDFD_OPEN_ARM64:    int64 := 434; // pidfd_open — API 30+
pub con SYS_AND_PIDFD_OPEN_X86_64:   int64 := 434;
pub con SYS_AND_CLONE3_ARM64:        int64 := 435; // clone3 — API 30+, often filtered
pub con SYS_AND_CLONE3_X86_64:       int64 := 435;

// ---------------------------------------------------------------------------
// API-level constants for "is this syscall safe to use?" decisions.
// Pair these with the --android-api compiler flag.
// ---------------------------------------------------------------------------

pub con ANDROID_API_GETRANDOM:     int64 := 23;
pub con ANDROID_API_MEMFD_CREATE:  int64 := 26;
pub con ANDROID_API_PIDFD_OPEN:    int64 := 30;
pub con ANDROID_API_CLONE3:        int64 := 30;
