// Lyx Android Stdlib - AndroidManifest.xml generator
// WP-AND-07
//
// Builds a minimal AndroidManifest.xml string for a NativeActivity-only
// app. Pure string concatenation; no upstream blockers. The output is
// the XML text that gets compiled to binary AXML by aapt2 at packaging
// time (WP-AND-08).
//
// Generated layout (NativeActivity entry, single activity, no extras):
//
//   <?xml version="1.0" encoding="utf-8"?>
//   <manifest xmlns:android="http://schemas.android.com/apk/res/android"
//             package="com.example.myapp" >
//     <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />
//     <application android:label="MyApp" android:hasCode="false" >
//       <activity android:name="android.app.NativeActivity"
//                 android:label="MyApp"
//                 android:exported="true" >
//         <meta-data android:name="android.app.lib_name" android:value="myapp" />
//         <intent-filter>
//           <action android:name="android.intent.action.MAIN" />
//           <category android:name="android.intent.category.LAUNCHER" />
//         </intent-filter>
//       </activity>
//     </application>
//   </manifest>

unit std.android.manifest_gen;

import std.string;

// Build an AndroidManifest.xml for a NativeActivity app.
//   packageName : reverse-DNS app id ("com.example.myapp")
//   appLabel    : human-readable display name shown in the launcher
//   libName     : base name of the .so without "lib" prefix or ".so" suffix
//                 (the loader looks for lib<libName>.so)
//   minSdk      : minimum API level the app supports
//   targetSdk   : API level the app is tested against (drives behavioural opt-ins)
//
// Returns a heap-allocated pchar; caller owns it.
pub fn GenerateNativeActivityManifest(packageName: pchar, appLabel: pchar,
                                      libName: pchar, minSdk: int64, targetSdk: int64): pchar {
  var sb: StringBuilder := new StringBuilder();
  sb.Init(1024);

  sb.Append("<?xml version=\"1.0\" encoding=\"utf-8\"?>\n"c);
  sb.Append("<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\"\n"c);
  sb.Append("          package=\""c);
  sb.Append(packageName);
  sb.Append("\" >\n"c);

  sb.Append("  <uses-sdk android:minSdkVersion=\""c);
  sb.AppendInt(minSdk);
  sb.Append("\" android:targetSdkVersion=\""c);
  sb.AppendInt(targetSdk);
  sb.Append("\" />\n"c);

  sb.Append("  <application android:label=\""c);
  sb.Append(appLabel);
  sb.Append("\" android:hasCode=\"false\" >\n"c);

  sb.Append("    <activity android:name=\"android.app.NativeActivity\"\n"c);
  sb.Append("              android:label=\""c);
  sb.Append(appLabel);
  sb.Append("\"\n"c);
  sb.Append("              android:exported=\"true\" >\n"c);

  sb.Append("      <meta-data android:name=\"android.app.lib_name\" android:value=\""c);
  sb.Append(libName);
  sb.Append("\" />\n"c);

  sb.Append("      <intent-filter>\n"c);
  sb.Append("        <action android:name=\"android.intent.action.MAIN\" />\n"c);
  sb.Append("        <category android:name=\"android.intent.category.LAUNCHER\" />\n"c);
  sb.Append("      </intent-filter>\n"c);

  sb.Append("    </activity>\n"c);
  sb.Append("  </application>\n"c);
  sb.Append("</manifest>\n"c);

  return sb.ToString();
}

// Convenience: same as above but without configuring SDK versions. Defaults
// match WP-AND-03 / WP-AND-01: API 21 minimum (64-bit ARM), API 34 target
// (Android 14, current stable as of 2026).
pub fn GenerateNativeActivityManifestDefault(packageName: pchar,
                                             appLabel: pchar, libName: pchar): pchar {
  return GenerateNativeActivityManifest(packageName, appLabel, libName, 21, 34);
}
