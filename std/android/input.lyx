// Lyx Android Stdlib - Input Events
// WP-AND-06
//
// Type aliases, event-type/action/source/key-code constants for NDK
// input.h. Function calls (AInputQueue_*, AInputEvent_*) live in
// libandroid.so — blocked, see asset.lyx.
//
// Reference: $ANDROID_NDK/sysroot/usr/include/android/input.h

unit std.android.input;

// ---------------------------------------------------------------------------
// Top-level event types (AInputEvent_getType).
// ---------------------------------------------------------------------------

pub con AINPUT_EVENT_TYPE_KEY:     int64 := 1;
pub con AINPUT_EVENT_TYPE_MOTION:  int64 := 2;
pub con AINPUT_EVENT_TYPE_FOCUS:   int64 := 3;

// ---------------------------------------------------------------------------
// Key event actions (AKeyEvent_getAction).
// ---------------------------------------------------------------------------

pub con AKEY_EVENT_ACTION_DOWN:     int64 := 0;
pub con AKEY_EVENT_ACTION_UP:       int64 := 1;
pub con AKEY_EVENT_ACTION_MULTIPLE: int64 := 2;

// ---------------------------------------------------------------------------
// Key event flags.
// ---------------------------------------------------------------------------

pub con AKEY_EVENT_FLAG_WOKE_HERE:               int64 := 0x00000001;
pub con AKEY_EVENT_FLAG_SOFT_KEYBOARD:           int64 := 0x00000002;
pub con AKEY_EVENT_FLAG_KEEP_TOUCH_MODE:         int64 := 0x00000004;
pub con AKEY_EVENT_FLAG_FROM_SYSTEM:             int64 := 0x00000008;
pub con AKEY_EVENT_FLAG_EDITOR_ACTION:           int64 := 0x00000010;
pub con AKEY_EVENT_FLAG_CANCELED:                int64 := 0x00000020;
