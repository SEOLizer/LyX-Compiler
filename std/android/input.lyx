pub con AKEYCODE_POWER:          int64 := 26;
pub con AKEYCODE_CAMERA:         int64 := 27;
pub con AKEYCODE_DPAD_UP:        int64 := 19;
pub con AKEYCODE_DPAD_DOWN:      int64 := 20;
pub con AKEYCODE_DPAD_LEFT:      int64 := 21;
pub con AKEYCODE_DPAD_RIGHT:     int64 := 22;
pub con AKEYCODE_DPAD_CENTER:    int64 := 23;
pub con AKEYCODE_0:              int64 :=  7;
pub con AKEYCODE_9:              int64 := 16;
pub con AKEYCODE_A:              int64 := 29;
pub con AKEYCODE_Z:              int64 := 54;
pub con AKEYCODE_SPACE:          int64 := 62;
pub con AKEYCODE_ENTER:          int64 := 66;
pub con AKEYCODE_DEL:            int64 := 67;
