pub con AKEY_EVENT_FLAG_LONG_PRESS:              int64 := 0x00000080;
pub con AKEY_EVENT_FLAG_CANCELED_LONG_PRESS:     int64 := 0x00000100;
pub con AKEY_EVENT_FLAG_TRACKING:                int64 := 0x00000200;
