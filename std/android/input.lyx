// ---------------------------------------------------------------------------
// Meta key states (key-event modifier bitmask).
// ---------------------------------------------------------------------------

pub con AMETA_NONE:        int64 := 0x00000000;
pub con AMETA_ALT_ON:      int64 := 0x00000002;
pub con AMETA_SHIFT_ON:    int64 := 0x00000001;
pub con AMETA_SYM_ON:      int64 := 0x00000004;
pub con AMETA_FUNCTION_ON: int64 := 0x00000008;
pub con AMETA_CTRL_ON:     int64 := 0x00001000;
pub con AMETA_META_ON:     int64 := 0x00010000;
pub con AMETA_CAPS_LOCK_ON:int64 := 0x00100000;
pub con AMETA_NUM_LOCK_ON: int64 := 0x00200000;
pub con AMETA_SCROLL_LOCK_ON: int64 := 0x00400000;

// ---------------------------------------------------------------------------
// Opaque types.
// ---------------------------------------------------------------------------

pub type AInputEvent  = int64;
pub type AInputQueue  = int64;

