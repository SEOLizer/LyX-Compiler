pub con AMOTION_EVENT_ACTION_BUTTON_RELEASE:int64 := 12;

// ---------------------------------------------------------------------------
// Input source classes / sources (AInputEvent_getSource).
// ---------------------------------------------------------------------------

pub con AINPUT_SOURCE_CLASS_MASK:      int64 := 0x000000FF;
pub con AINPUT_SOURCE_CLASS_NONE:      int64 := 0;
pub con AINPUT_SOURCE_CLASS_BUTTON:    int64 := 1;
pub con AINPUT_SOURCE_CLASS_POINTER:   int64 := 2;
pub con AINPUT_SOURCE_CLASS_NAVIGATION:int64 := 4;
pub con AINPUT_SOURCE_CLASS_POSITION:  int64 := 8;
pub con AINPUT_SOURCE_CLASS_JOYSTICK:  int64 := 16;

pub con AINPUT_SOURCE_UNKNOWN:        int64 := 0x00000000;
pub con AINPUT_SOURCE_KEYBOARD:       int64 := 0x00000101;
pub con AINPUT_SOURCE_DPAD:           int64 := 0x00000201;
