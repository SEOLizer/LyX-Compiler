pub con AMOTION_EVENT_ACTION_HOVER_MOVE:    int64 := 7;
pub con AMOTION_EVENT_ACTION_SCROLL:        int64 := 8;
pub con AMOTION_EVENT_ACTION_HOVER_ENTER:   int64 := 9;
