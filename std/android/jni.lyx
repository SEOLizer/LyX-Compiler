// ---------------------------------------------------------------------------
// JNIEnv helper wrappers (Phase B — unlocked by the _indirect_call_N
// builtin family in ir_lower + emit_arm64).
//
// All helpers follow the same pattern:
//   1. Dereference env (JNIEnv** in C) to get the vtable pointer.
//   2. Load the slot at vtable + JNI_SLOT_<name> * 8.
//   3. Invoke through it with the original env + user args.
//
// AArch64 only (the x86_64 IR emitter in lyxc.lyx is a stub today).
// ---------------------------------------------------------------------------

fn _vtableSlot(env: JNIEnv, slot: int64): int64 {
  var vtable: int64 := peek64(env);
  return peek64(vtable + slot * 8);
}

pub fn JNI_GetVersion(env: JNIEnv): jint {
  return _indirect_call_1(_vtableSlot(env, JNI_SLOT_GetVersion), env);
}

pub fn JNI_FindClass(env: JNIEnv, name: pchar): jclass {
  return _indirect_call_2(_vtableSlot(env, JNI_SLOT_FindClass), env, name as int64);
}

pub fn JNI_GetObjectClass(env: JNIEnv, obj: jobject): jclass {
  return _indirect_call_2(_vtableSlot(env, JNI_SLOT_GetObjectClass), env, obj);
}

pub fn JNI_GetMethodID(env: JNIEnv, cls: jclass, name: pchar, sig: pchar): jmethodID {
  return _indirect_call_4(_vtableSlot(env, JNI_SLOT_GetMethodID),
                          env, cls, name as int64, sig as int64);
}

pub fn JNI_GetStaticMethodID(env: JNIEnv, cls: jclass, name: pchar, sig: pchar): jmethodID {
  return _indirect_call_4(_vtableSlot(env, JNI_SLOT_GetStaticMethodID),
                          env, cls, name as int64, sig as int64);
}

pub fn JNI_NewStringUTF(env: JNIEnv, str: pchar): jstring {
  return _indirect_call_2(_vtableSlot(env, JNI_SLOT_NewStringUTF), env, str as int64);
}

pub fn JNI_GetStringUTFChars(env: JNIEnv, jstr: jstring, isCopy: int64): int64 {
  return _indirect_call_3(_vtableSlot(env, JNI_SLOT_GetStringUTFChars),
                          env, jstr, isCopy);
}

pub fn JNI_ReleaseStringUTFChars(env: JNIEnv, jstr: jstring, chars: int64): int64 {
  return _indirect_call_3(_vtableSlot(env, JNI_SLOT_ReleaseStringUTFChars),
                          env, jstr, chars);
}

pub fn JNI_NewByteArray(env: JNIEnv, len: jsize): jbyteArray {
  return _indirect_call_2(_vtableSlot(env, JNI_SLOT_NewByteArray), env, len);
}

pub fn JNI_GetByteArrayElements(env: JNIEnv, arr: jbyteArray, isCopy: int64): int64 {
  return _indirect_call_3(_vtableSlot(env, JNI_SLOT_GetByteArrayElements),
                          env, arr, isCopy);
}

pub fn JNI_ReleaseByteArrayElements(env: JNIEnv, arr: jbyteArray, elems: int64, mode: int64): int64 {
  return _indirect_call_4(_vtableSlot(env, JNI_SLOT_ReleaseByteArrayElements),
                          env, arr, elems, mode);
}

pub fn JNI_GetArrayLength(env: JNIEnv, arr: jarray): jsize {
  return _indirect_call_2(_vtableSlot(env, JNI_SLOT_GetArrayLength), env, arr);
}

pub fn JNI_ExceptionCheck(env: JNIEnv): jboolean {
  return _indirect_call_1(_vtableSlot(env, JNI_SLOT_ExceptionCheck), env);
}

pub fn JNI_ExceptionClear(env: JNIEnv): int64 {
  return _indirect_call_1(_vtableSlot(env, JNI_SLOT_ExceptionClear), env);
}

pub fn JNI_DeleteLocalRef(env: JNIEnv, ref: jobject): int64 {
  return _indirect_call_2(_vtableSlot(env, JNI_SLOT_DeleteLocalRef), env, ref);
}

pub fn JNI_NewGlobalRef(env: JNIEnv, ref: jobject): jobject {
  return _indirect_call_2(_vtableSlot(env, JNI_SLOT_NewGlobalRef), env, ref);
}

pub fn JNI_DeleteGlobalRef(env: JNIEnv, ref: jobject): int64 {
  return _indirect_call_2(_vtableSlot(env, JNI_SLOT_DeleteGlobalRef), env, ref);
}

pub fn JNI_GetJavaVM(env: JNIEnv, vmOut: int64): jint {
  return _indirect_call_2(_vtableSlot(env, JNI_SLOT_GetJavaVM), env, vmOut);
}
