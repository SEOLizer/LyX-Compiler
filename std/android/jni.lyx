// Lyx Android Stdlib - JNI Type Definitions
// WP-AND-05
//
// Provides the standard JNI 1.6 type aliases plus the JNIEnv / JavaVM
// opaque pointer types. Native functions can use these names so their
// signatures match what Kotlin/Java expects on the other side of a JNI
// call.
//
// Reference: $ANDROID_NDK/sysroot/usr/include/jni.h
//
// All Lyx-side primitive types are int64; the aliases below carry the
// JNI "logical" type information for the reader. Multi-byte values
// (jboolean, jbyte, jchar, jshort, jint, jfloat) are stored in the
// low bits of an int64 slot, which matches the AArch64 / x86_64 ABI
// rule that arguments are passed and returned in 64-bit registers.

unit std.android.jni;

// ---------------------------------------------------------------------------
// Primitive JNI types. All int64-backed; the alias documents the JNI
// view of the value.
// ---------------------------------------------------------------------------

pub type jboolean = int64;   //   8-bit unsigned (0 = JNI_FALSE, 1 = JNI_TRUE)
pub type jbyte    = int64;   //   8-bit signed
pub type jchar    = int64;   //  16-bit unsigned (UTF-16 code unit)
pub type jshort   = int64;   //  16-bit signed
pub type jint     = int64;   //  32-bit signed
pub type jlong    = int64;   //  64-bit signed (native size of Lyx int64)
pub type jfloat   = int64;   //  32-bit IEEE-754 (low half of register)
pub type jdouble  = int64;   //  64-bit IEEE-754 (use std.math float helpers)
pub type jsize    = int64;   //  jint alias used for length / index values

// ---------------------------------------------------------------------------
// JNI reference types — all opaque pointers from the Lyx side.
// ---------------------------------------------------------------------------

pub type jobject       = int64;
pub type jclass        = int64;   // sub-type of jobject — a java.lang.Class
pub type jthrowable    = int64;   // sub-type of jobject — a java.lang.Throwable
pub type jstring       = int64;   // sub-type of jobject — a java.lang.String
pub type jarray        = int64;   // sub-type of jobject — any array
pub type jbooleanArray = int64;
pub type jbyteArray    = int64;
pub type jcharArray    = int64;
pub type jshortArray   = int64;
pub type jintArray     = int64;
pub type jlongArray    = int64;
pub type jfloatArray   = int64;
pub type jdoubleArray  = int64;
pub type jobjectArray  = int64;

// ---------------------------------------------------------------------------
// Method / field ID types — also opaque pointers.
// ---------------------------------------------------------------------------

pub type jmethodID = int64;
pub type jfieldID  = int64;
pub type jweak     = int64;   // weak global reference (JNI 1.2+)

// ---------------------------------------------------------------------------
// Environment pointers. JNIEnv is a "double pointer" in C
// (struct JNINativeInterface **), but on the Lyx side we treat it as an
// opaque int64. Helpers in WP-AND-05 Phase B reach through the vtable
// via inline indirect calls (see vtable slot table below).
// ---------------------------------------------------------------------------

pub type JNIEnv = int64;
pub type JavaVM = int64;

// ---------------------------------------------------------------------------
// JNI constants
// ---------------------------------------------------------------------------

pub con JNI_FALSE:  int64 := 0;
pub con JNI_TRUE:   int64 := 1;

pub con JNI_OK:     int64 := 0;
pub con JNI_ERR:    int64 := -1;       // generic error
pub con JNI_EDETACHED: int64 := -2;    // thread detached from VM
pub con JNI_EVERSION:  int64 := -3;    // JNI version error
pub con JNI_ENOMEM:    int64 := -4;
pub con JNI_EEXIST:    int64 := -5;
pub con JNI_EINVAL:    int64 := -6;

pub con JNI_COMMIT: int64 := 1;        // ReleaseArrayElements mode
pub con JNI_ABORT:  int64 := 2;

pub con JNI_VERSION_1_1: int64 := 0x00010001;
pub con JNI_VERSION_1_2: int64 := 0x00010002;
pub con JNI_VERSION_1_4: int64 := 0x00010004;
pub con JNI_VERSION_1_6: int64 := 0x00010006;
pub con JNI_VERSION_1_8: int64 := 0x00010008;

// ---------------------------------------------------------------------------
// JNINativeInterface vtable slot offsets (in pointers; multiply by 8 for
// the byte offset on 64-bit). These match Android NDK jni.h and stay
// stable across JNI versions — new entries are only appended.
//
// User code reaches the function pointer with:
//   *(*(env as ^int64) + slot * 8)
// then casts to the appropriate fn-pointer type before calling.
//
// We list the most commonly used slots only; the full table is ~230 entries.
// ---------------------------------------------------------------------------

