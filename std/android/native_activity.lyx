// Lyx Android Stdlib - NativeActivity
// WP-AND-07
//
// The ANativeActivity struct + callback table that the Android system
// hands to a native entry point. A real Lyx NativeActivity app would
// implement ANativeActivity_onCreate as an @export-ed Lyx function;
// the system calls it once per activity instance and the function is
// expected to fill in the 15 ANativeActivityCallbacks slots and
// usually spawn a worker thread.
//
// The actual onCreate entry point cannot be wired today because Lyx
// has no IRO_CALL_INDIRECT yet (the system would call BACK into our
// onCreate via a libandroid-managed function pointer; we would call
// the system via the JavaVM, AssetManager, etc. — all blocked). The
// struct layout below is still useful as documentation and lets users
// write the right field offsets when manually setting things up via
// peek/poke from outside the type system.
//
// Reference: $ANDROID_NDK/sysroot/usr/include/android/native_activity.h

unit std.android.native_activity;

// ---------------------------------------------------------------------------
// Opaque NDK types referenced by the struct.
// ---------------------------------------------------------------------------

pub type ANativeActivity         = int64;
pub type ANativeActivityCallbacks = int64;
pub type JNIInvokeInterface      = int64;   // JavaVM** in C
pub type AConfiguration          = int64;

// ---------------------------------------------------------------------------
// Layout of ANativeActivity (matches NDK; offsets are in bytes assuming
// 8-byte pointer width, i.e. ARM64 / x86_64).
//
//   off  field
//     0  callbacks      ANativeActivityCallbacks*   (set by the loader)
//     8  vm             JavaVM*
//    16  env            JNIEnv*    (only valid on the activity's UI thread)
//    24  clazz          jobject of the NativeActivity instance
//    32  internalDataPath  pchar
//    40  externalDataPath  pchar
//    48  sdkVersion     int32       (Android API level)
//    56  instance       void*       (free slot for user state)
//    64  assetManager   AAssetManager*
//    72  obbPath        pchar
//
// Total: 80 bytes.
// ---------------------------------------------------------------------------

pub con OFF_ANA_CALLBACKS:        int64 :=  0;
pub con OFF_ANA_VM:               int64 :=  8;
pub con OFF_ANA_ENV:              int64 := 16;
pub con OFF_ANA_CLAZZ:            int64 := 24;
pub con OFF_ANA_INTERNAL_DATAPATH:int64 := 32;
pub con OFF_ANA_EXTERNAL_DATAPATH:int64 := 40;
pub con OFF_ANA_SDK_VERSION:      int64 := 48;
pub con OFF_ANA_INSTANCE:         int64 := 56;
pub con OFF_ANA_ASSET_MANAGER:    int64 := 64;
pub con OFF_ANA_OBB_PATH:         int64 := 72;
pub con ANATIVEACTIVITY_SIZE:     int64 := 80;

// ---------------------------------------------------------------------------
// ANativeActivityCallbacks layout. 15 function pointers, in NDK order.
// Each slot is one 8-byte pointer; the table is 120 bytes total.
//
//   slot  callback                          fires when
//      0  onStart                           activity becomes visible
//      1  onResume                          activity comes to the foreground
//      2  onSaveInstanceState               system wants to persist state (outSize: int64*)
//      3  onPause                           activity is going to the background
//      4  onStop                            activity is no longer visible
//      5  onDestroy                         activity is being torn down
//      6  onWindowFocusChanged              (hasFocus: int)
//      7  onNativeWindowCreated             (ANativeWindow*)
//      8  onNativeWindowResized             (ANativeWindow*)
//      9  onNativeWindowRedrawNeeded        (ANativeWindow*)
//     10  onNativeWindowDestroyed           (ANativeWindow*)
//     11  onInputQueueCreated               (AInputQueue*)
//     12  onInputQueueDestroyed             (AInputQueue*)
//     13  onContentRectChanged              (const ARect*)
//     14  onConfigurationChanged            ()
//     15  onLowMemory                       ()
// ---------------------------------------------------------------------------

pub con ANA_CB_onStart:                    int64 :=  0;
pub con ANA_CB_onResume:                   int64 :=  1;
pub con ANA_CB_onSaveInstanceState:        int64 :=  2;
pub con ANA_CB_onPause:                    int64 :=  3;
pub con ANA_CB_onStop:                     int64 :=  4;
pub con ANA_CB_onDestroy:                  int64 :=  5;
pub con ANA_CB_onWindowFocusChanged:       int64 :=  6;
pub con ANA_CB_onNativeWindowCreated:      int64 :=  7;
pub con ANA_CB_onNativeWindowResized:      int64 :=  8;
pub con ANA_CB_onNativeWindowRedrawNeeded: int64 :=  9;
pub con ANA_CB_onNativeWindowDestroyed:    int64 := 10;
pub con ANA_CB_onInputQueueCreated:        int64 := 11;
pub con ANA_CB_onInputQueueDestroyed:      int64 := 12;
pub con ANA_CB_onContentRectChanged:       int64 := 13;
pub con ANA_CB_onConfigurationChanged:     int64 := 14;
pub con ANA_CB_onLowMemory:                int64 := 15;
pub con ANATIVEACTIVITYCALLBACKS_COUNT:    int64 := 16;
pub con ANATIVEACTIVITYCALLBACKS_SIZE:     int64 := 128;   // 16 * 8 bytes

// ---------------------------------------------------------------------------
// Entry-point convention.
//
// The Android loader looks for a symbol named exactly `ANativeActivity_onCreate`
// in the loaded .so. Its signature in C is:
//
//   void ANativeActivity_onCreate(ANativeActivity *activity,
//                                 void *savedState, size_t savedStateSize)
//
// In Lyx that would be (once @export bare-name works without @jni mangling):
//
//   @export
//   fn ANativeActivity_onCreate(activity: ANativeActivity, saved: int64, savedLen: int64): void { ... }
//
// Inside that function the user would set the 16 callback pointers in
// the table at `peek64(activity + OFF_ANA_CALLBACKS)` and optionally
// stash an `instance` pointer at `OFF_ANA_INSTANCE`. With Lyx's current
// lack of IRO_CALL_INDIRECT, however, no callback can actually invoke
// the libandroid `ANativeActivity_finish` / `AInputQueue_*` / etc.
// helpers — see the wider blocker note in work/android.md.
//
// TODO (blocked):
//
//   pub fn ANativeActivity_finish(act: ANativeActivity): void;
//   pub fn ANativeActivity_setWindowFlags(act: ANativeActivity, addFlags: int64, removeFlags: int64): void;
//   pub fn ANativeActivity_setWindowFormat(act: ANativeActivity, format: int64): void;
//   pub fn ANativeActivity_showSoftInput(act: ANativeActivity, flags: int64): void;
//   pub fn ANativeActivity_hideSoftInput(act: ANativeActivity, flags: int64): void;
