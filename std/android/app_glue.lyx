// Lyx Android Stdlib - android_native_app_glue equivalent
// WP-AND-07
//
// android_native_app_glue is the NDK helper library that wraps a
// NativeActivity in a worker-thread + command-pipe model so the app's
// main loop can be linear instead of callback-driven. This unit lists
// the constants and struct field offsets the glue uses; an actual
// Lyx implementation of the glue is gated on:
//
//   * threading primitives (pthread_create / pthread_mutex / pthread_cond)
//   * IRO_CALL_INDIRECT from ir_lower (for callback dispatch)
//   * PLT linking against libandroid.so (for ALooper / AInputQueue / etc.)
//
// All three are blocked upstream — see asset.lyx in WP-AND-06.
//
// Reference: $ANDROID_NDK/sources/android/native_app_glue/android_native_app_glue.h

unit std.android.app_glue;

// ---------------------------------------------------------------------------
// APP_CMD_*: messages flowing from the activity-callback thread (the one
// the Android system calls into) to the worker thread that the app loop
// runs on. Glue dispatches them via the command pipe.
// ---------------------------------------------------------------------------

pub con APP_CMD_INPUT_CHANGED:        int64 :=  0;
pub con APP_CMD_INIT_WINDOW:          int64 :=  1;
pub con APP_CMD_TERM_WINDOW:          int64 :=  2;
pub con APP_CMD_WINDOW_RESIZED:       int64 :=  3;
pub con APP_CMD_WINDOW_REDRAW_NEEDED: int64 :=  4;
pub con APP_CMD_CONTENT_RECT_CHANGED: int64 :=  5;
pub con APP_CMD_GAINED_FOCUS:         int64 :=  6;
pub con APP_CMD_LOST_FOCUS:           int64 :=  7;
pub con APP_CMD_CONFIG_CHANGED:       int64 :=  8;
pub con APP_CMD_LOW_MEMORY:           int64 :=  9;
pub con APP_CMD_START:                int64 := 10;
pub con APP_CMD_RESUME:               int64 := 11;
pub con APP_CMD_SAVE_STATE:           int64 := 12;
pub con APP_CMD_PAUSE:                int64 := 13;
pub con APP_CMD_STOP:                 int64 := 14;
pub con APP_CMD_DESTROY:              int64 := 15;

// ---------------------------------------------------------------------------
// android_poll_source: handed back by ALooper_pollOnce when the source has
// fired. Layout (16 bytes):
//   off  field
//     0  id          int32   (one of LOOPER_ID_MAIN / LOOPER_ID_INPUT / ...)
//     8  app         android_app*
//    16  process     void (*)(android_app*, android_poll_source*)
// ---------------------------------------------------------------------------

pub con OFF_POLLSOURCE_ID:      int64 :=  0;
pub con OFF_POLLSOURCE_APP:     int64 :=  8;
pub con OFF_POLLSOURCE_PROCESS: int64 := 16;
pub con POLLSOURCE_SIZE:        int64 := 24;

// ---------------------------------------------------------------------------
// android_app struct field offsets (ARM64 / x86_64 layout).
// Total size: 192 bytes (rounded; field set tracks NDK r25).
//
//   off  field                  type
//     0  userData               void*       — user-controlled per-app state
//     8  onAppCmd               fn-ptr      — user callback for APP_CMD_*
//    16  onInputEvent           fn-ptr      — user callback for AInputEvent*
//    24  activity               ANativeActivity*
//    32  config                 AConfiguration*
//    40  savedState             void*
//    48  savedStateSize         int64
//    56  looper                 ALooper*
//    64  inputQueue             AInputQueue*
//    72  window                 ANativeWindow*
//    80  contentRect            ARect (32 bytes embedded)
//   112  activityState          int32  (0/1/2 = paused / resumed / saved)
//   120  destroyRequested       int32  — set when system asks app to exit
//   128  msgread                int32  (fd) — command pipe read end
//   132  msgwrite               int32  (fd) — command pipe write end
//   136  pthread                pthread_t — glue worker thread
//   144  cmdPollSource          android_poll_source (24 bytes embedded)
//   168  inputPollSource        android_poll_source (24 bytes embedded)
// ---------------------------------------------------------------------------

pub con OFF_APP_USERDATA:          int64 :=   0;
pub con OFF_APP_ON_APP_CMD:        int64 :=   8;
pub con OFF_APP_ON_INPUT_EVENT:    int64 :=  16;
pub con OFF_APP_ACTIVITY:          int64 :=  24;
pub con OFF_APP_CONFIG:            int64 :=  32;
pub con OFF_APP_SAVED_STATE:       int64 :=  40;
pub con OFF_APP_SAVED_STATE_SIZE:  int64 :=  48;
pub con OFF_APP_LOOPER:            int64 :=  56;
pub con OFF_APP_INPUT_QUEUE:       int64 :=  64;
pub con OFF_APP_WINDOW:            int64 :=  72;
pub con OFF_APP_CONTENT_RECT:      int64 :=  80;
pub con OFF_APP_ACTIVITY_STATE:    int64 := 112;
pub con OFF_APP_DESTROY_REQUESTED: int64 := 120;
pub con OFF_APP_MSGREAD:           int64 := 128;
pub con OFF_APP_MSGWRITE:          int64 := 132;
pub con OFF_APP_PTHREAD:           int64 := 136;
pub con OFF_APP_CMD_POLLSOURCE:    int64 := 144;
pub con OFF_APP_INPUT_POLLSOURCE:  int64 := 168;
pub con ANDROIDAPP_SIZE:           int64 := 192;

// Activity-state values stored in OFF_APP_ACTIVITY_STATE.
pub con APP_STATE_NONE:    int64 := 0;
pub con APP_STATE_PAUSED:  int64 := 1;
pub con APP_STATE_RESUMED: int64 := 2;

// ---------------------------------------------------------------------------
// Opaque app pointer (Lyx-side handle).
// ---------------------------------------------------------------------------

pub type android_app          = int64;
pub type android_poll_source  = int64;

