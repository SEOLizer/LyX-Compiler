// Lyx Android Stdlib - Logging
// WP-AND-06
//
// Writes log lines to stderr (fd 2). The Android runtime captures stderr
// of debuggable processes and routes them to logcat with the prefix
// already in place, so a line like
//   I/MyTag: hello
// appears in logcat under tag "MyTag" with INFO priority.
//
// The "proper" Android API would call __android_log_print() from liblog.so,
// which writes a structured binary record to /dev/socket/logdw. That path
// needs DT_NEEDED-style PLT linking, which is blocked upstream — see
// work/android.md WP-AND-06 notes. A future Phase B will replace the
// stderr fallback with a direct AF_UNIX-socket implementation (no liblog
// needed: the wire format is documented and Lyx already supports
// AF_UNIX sockets via std.net).

unit std.android.log;

import std.io;

// ---------------------------------------------------------------------------
// Android log priorities (match android/log.h #define ANDROID_LOG_*).
// ---------------------------------------------------------------------------

pub con ANDROID_LOG_UNKNOWN: int64 := 0;
pub con ANDROID_LOG_DEFAULT: int64 := 1;
pub con ANDROID_LOG_VERBOSE: int64 := 2;
pub con ANDROID_LOG_DEBUG:   int64 := 3;
pub con ANDROID_LOG_INFO:    int64 := 4;
pub con ANDROID_LOG_WARN:    int64 := 5;
pub con ANDROID_LOG_ERROR:   int64 := 6;
pub con ANDROID_LOG_FATAL:   int64 := 7;
pub con ANDROID_LOG_SILENT:  int64 := 8;

// ---------------------------------------------------------------------------
// Internal helper: write "P/<tag>: <msg>\n" to stderr where P is the
// single-character priority code.
// ---------------------------------------------------------------------------

fn _logPrefixChar(prio: int64): int64 {
  if prio == 2 { return 86; }   // 'V'
  if prio == 3 { return 68; }   // 'D'
  if prio == 4 { return 73; }   // 'I'
  if prio == 5 { return 87; }   // 'W'
  if prio == 6 { return 69; }   // 'E'
  if prio == 7 { return 70; }   // 'F'
  return 73;                    // default 'I'
}

fn _logWrite(prio: int64, tag: pchar, msg: pchar): int64 {
  var ch: int64 := _logPrefixChar(prio);
  // "P/"
  var prefix: pchar := " /"c;
  poke8(prefix as int64, ch);
  write(2, prefix, 2);

  if (tag as int64) != 0 {
    var tagLen: int64 := StrLen(tag);
    if tagLen > 0 { write(2, tag, tagLen); }
  }
  write(2, ": "c, 2);

  if (msg as int64) != 0 {
    var msgLen: int64 := StrLen(msg);
    if msgLen > 0 { write(2, msg, msgLen); }
  }
  write(2, "\n"c, 1);
  return 0;
}

// ---------------------------------------------------------------------------
// Public log functions. Same signature surface as liblog's __android_log_print
// fixed-priority wrappers.
// ---------------------------------------------------------------------------

pub fn LogV(tag: pchar, msg: pchar): int64 { return _logWrite(ANDROID_LOG_VERBOSE, tag, msg); }
pub fn LogD(tag: pchar, msg: pchar): int64 { return _logWrite(ANDROID_LOG_DEBUG,   tag, msg); }
pub fn LogI(tag: pchar, msg: pchar): int64 { return _logWrite(ANDROID_LOG_INFO,    tag, msg); }
pub fn LogW(tag: pchar, msg: pchar): int64 { return _logWrite(ANDROID_LOG_WARN,    tag, msg); }
pub fn LogE(tag: pchar, msg: pchar): int64 { return _logWrite(ANDROID_LOG_ERROR,   tag, msg); }
pub fn LogF(tag: pchar, msg: pchar): int64 { return _logWrite(ANDROID_LOG_FATAL,   tag, msg); }

// Explicit-priority variant for callers that compute the level at runtime.
pub fn LogPrio(prio: int64, tag: pchar, msg: pchar): int64 {
  return _logWrite(prio, tag, msg);
}
