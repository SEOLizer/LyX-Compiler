// Lyx Android Stdlib - OpenGL ES 2.0 essentials
// WP-AND-07
//
// The OpenGL ES 2 API surface is huge (~2000 #define values and ~140
// entry points); this module ships the subset needed to set up a context,
// load a shader pair, upload geometry and issue glDrawArrays — the
// "render-a-triangle" baseline.
//
// Function calls (glClear, glDrawArrays, glUseProgram, ...) live in
// libGLESv2.so — blocked by the same upstream PLT gaps; see asset.lyx.
//
// Reference: $ANDROID_NDK/sysroot/usr/include/GLES2/gl2.h

unit std.android.gles2;

// ---------------------------------------------------------------------------
// Boolean values.
// ---------------------------------------------------------------------------

pub con GL_FALSE: int64 := 0;
pub con GL_TRUE:  int64 := 1;

// ---------------------------------------------------------------------------
// Clear masks (glClear).
// ---------------------------------------------------------------------------

pub con GL_DEPTH_BUFFER_BIT:   int64 := 0x00000100;
pub con GL_STENCIL_BUFFER_BIT: int64 := 0x00000400;
pub con GL_COLOR_BUFFER_BIT:   int64 := 0x00004000;

// ---------------------------------------------------------------------------
// Primitive types (glDrawArrays / glDrawElements).
// ---------------------------------------------------------------------------

pub con GL_POINTS:         int64 := 0x0000;
pub con GL_LINES:          int64 := 0x0001;
pub con GL_LINE_LOOP:      int64 := 0x0002;
pub con GL_LINE_STRIP:     int64 := 0x0003;
pub con GL_TRIANGLES:      int64 := 0x0004;
pub con GL_TRIANGLE_STRIP: int64 := 0x0005;
pub con GL_TRIANGLE_FAN:   int64 := 0x0006;

// ---------------------------------------------------------------------------
// Data types.
// ---------------------------------------------------------------------------

pub con GL_BYTE:           int64 := 0x1400;
pub con GL_UNSIGNED_BYTE:  int64 := 0x1401;
pub con GL_SHORT:          int64 := 0x1402;
pub con GL_UNSIGNED_SHORT: int64 := 0x1403;
pub con GL_INT:            int64 := 0x1404;
pub con GL_UNSIGNED_INT:   int64 := 0x1405;
pub con GL_FLOAT:          int64 := 0x1406;

// ---------------------------------------------------------------------------
// Shader types (glCreateShader).
// ---------------------------------------------------------------------------

pub con GL_FRAGMENT_SHADER: int64 := 0x8B30;
pub con GL_VERTEX_SHADER:   int64 := 0x8B31;

// ---------------------------------------------------------------------------
// glGetShaderiv / glGetProgramiv pnames.
// ---------------------------------------------------------------------------

pub con GL_COMPILE_STATUS:    int64 := 0x8B81;
pub con GL_LINK_STATUS:       int64 := 0x8B82;
pub con GL_INFO_LOG_LENGTH:   int64 := 0x8B84;
pub con GL_SHADER_TYPE:       int64 := 0x8B4F;
pub con GL_DELETE_STATUS:     int64 := 0x8B80;
pub con GL_ATTACHED_SHADERS:  int64 := 0x8B85;
pub con GL_ACTIVE_UNIFORMS:   int64 := 0x8B86;
pub con GL_ACTIVE_ATTRIBUTES: int64 := 0x8B89;

// ---------------------------------------------------------------------------
// Buffer targets / usage (glBindBuffer / glBufferData).
// ---------------------------------------------------------------------------

pub con GL_ARRAY_BUFFER:         int64 := 0x8892;
pub con GL_ELEMENT_ARRAY_BUFFER: int64 := 0x8893;
pub con GL_STREAM_DRAW:          int64 := 0x88E0;
pub con GL_STATIC_DRAW:          int64 := 0x88E4;
pub con GL_DYNAMIC_DRAW:         int64 := 0x88E8;

// ---------------------------------------------------------------------------
// Texture targets / pnames / formats.
// ---------------------------------------------------------------------------

pub con GL_TEXTURE_2D:               int64 := 0x0DE1;
pub con GL_TEXTURE_CUBE_MAP:         int64 := 0x8513;
pub con GL_TEXTURE0:                 int64 := 0x84C0;
pub con GL_TEXTURE_WRAP_S:           int64 := 0x2802;
pub con GL_TEXTURE_WRAP_T:           int64 := 0x2803;
pub con GL_TEXTURE_MIN_FILTER:       int64 := 0x2801;
pub con GL_TEXTURE_MAG_FILTER:       int64 := 0x2800;
pub con GL_NEAREST:                  int64 := 0x2600;
pub con GL_LINEAR:                   int64 := 0x2601;
pub con GL_CLAMP_TO_EDGE:            int64 := 0x812F;
pub con GL_REPEAT:                   int64 := 0x2901;

pub con GL_RGB:    int64 := 0x1907;
pub con GL_RGBA:   int64 := 0x1908;
pub con GL_ALPHA:  int64 := 0x1906;

// ---------------------------------------------------------------------------
// Blend modes / capabilities (glEnable / glBlendFunc).
// ---------------------------------------------------------------------------

pub con GL_BLEND:            int64 := 0x0BE2;
pub con GL_DEPTH_TEST:       int64 := 0x0B71;
pub con GL_STENCIL_TEST:     int64 := 0x0B90;
pub con GL_CULL_FACE:        int64 := 0x0B44;

pub con GL_ZERO:             int64 := 0x0000;
pub con GL_ONE:              int64 := 0x0001;
pub con GL_SRC_COLOR:        int64 := 0x0300;
pub con GL_ONE_MINUS_SRC_COLOR: int64 := 0x0301;
pub con GL_SRC_ALPHA:        int64 := 0x0302;
pub con GL_ONE_MINUS_SRC_ALPHA: int64 := 0x0303;
pub con GL_DST_ALPHA:        int64 := 0x0304;
pub con GL_ONE_MINUS_DST_ALPHA: int64 := 0x0305;

// ---------------------------------------------------------------------------
// Error codes (glGetError).
// ---------------------------------------------------------------------------

pub con GL_NO_ERROR:          int64 := 0;
pub con GL_INVALID_ENUM:      int64 := 0x0500;
pub con GL_INVALID_VALUE:     int64 := 0x0501;
pub con GL_INVALID_OPERATION: int64 := 0x0502;
pub con GL_OUT_OF_MEMORY:     int64 := 0x0505;
pub con GL_INVALID_FRAMEBUFFER_OPERATION: int64 := 0x0506;

// ---------------------------------------------------------------------------
// Opaque ID types (GLuint / GLint / GLsizei are all Lyx int64).
// ---------------------------------------------------------------------------

pub type GLuint  = int64;
pub type GLint   = int64;
pub type GLsizei = int64;
pub type GLenum  = int64;
pub type GLfloat = int64;   // f32 bit-cast packed into the low half

