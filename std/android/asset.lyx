// Lyx Android Stdlib - Asset Manager
// WP-AND-06
//
// Type aliases and access-mode constants for Android's NDK asset_manager.h API.
// The actual function calls (AAssetManager_open, AAsset_read, AAsset_close, ...)
// live in libandroid.so and need DT_NEEDED + PLT linking to invoke from
// Lyx — that path is blocked upstream until WP-AND-02 Phase C gains real
// external-symbol support and lyx_lower emits IRO_CALL_INDIRECT for
// dynamically-linked calls. Once that lands, only function-signature
// wrappers need to be added here; the constants and types below already
// reflect the NDK contract.
//
// Reference: $ANDROID_NDK/sysroot/usr/include/android/asset_manager.h

unit std.android.asset;

// ---------------------------------------------------------------------------
// AAsset access modes (passed to AAssetManager_open).
// ---------------------------------------------------------------------------

pub con AASSET_MODE_UNKNOWN:    int64 := 0;
pub con AASSET_MODE_RANDOM:     int64 := 1;   // any access pattern; may seek
pub con AASSET_MODE_STREAMING:  int64 := 2;   // forward read only
pub con AASSET_MODE_BUFFER:     int64 := 3;   // tries to map the whole asset into a buffer

// ---------------------------------------------------------------------------
// AAssetManager directory entry flags (poll-style file enumeration).
// ---------------------------------------------------------------------------

pub con AASSET_DIR_ENTRY_FILE:  int64 := 0;
pub con AASSET_DIR_ENTRY_DIR:   int64 := 1;

// ---------------------------------------------------------------------------
// Opaque pointer types (all int64 from the Lyx side).
// ---------------------------------------------------------------------------

pub type AAssetManager = int64;
pub type AAssetDir     = int64;
pub type AAsset        = int64;

