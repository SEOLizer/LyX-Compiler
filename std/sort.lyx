// std/sort.lyx
// Effiziente Sortieralgorithmen für int64-Arrays

@description("Sorting algorithms (quicksort, mergesort)")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
unit std.sort;

pub fn SortInt64(arr: int64, len: int64): void {
  if (len <= 1) {
    return;
  }
  QuickSortInternal(arr, 0, len - 1);
}

// #2228: Gerechnet wird auf Zeigern, Vertauschen und Lesen stehen direkt
// da. Bis 1.2.19H lief jeder Elementzugriff ueber SortGet/SortSwap — zwei
// Aufrufe mit Rahmen und Canary je Vergleich, und `pivot`, `low`, `mid`
// passten nicht mehr in die vier Register der Zuteilung (#2114). Gemessen
// ~2x beim Sortieren. Der Ablauf ist derselbe: Median aus drei, Lomuto,
// Einfuegesortierung unter zehn Elementen — dieselben Vertauschungen in
// derselben Reihenfolge.

// #1458: Die alte Aufteilung mischte zwei Verfahren. Sie lief mit zwei
// Zeigern aufeinander zu (Hoare), setzte danach aber den Pivot an die Stelle
// `i` und meldete `i` als endgueltige Position (Lomuto). Beides zusammen
// stimmt nicht: nach der Schleife kann arr[i] KLEINER als der Pivot sein, und
// dann steht der Pivot hinterher links von Elementen, die groesser sind.
// Deshalb war das Ergebnis eine Permutation der Eingabe — alle Elemente da,
// ein bis zwei an der falschen Stelle.
//
// Jetzt sauberes Lomuto: ein Zeiger laeuft durch, alles nicht Groessere
// wandert nach vorn, am Ende kommt der Pivot hinter diesen Bereich. Damit
// gilt die Zusage, auf die der Aufrufer sich verlaesst — links vom
// Rueckgabewert steht nichts Groesseres, rechts nichts Kleineres.
fn Partition(arr: int64, low: int64, high: int64): int64 {
  // low + (high - low) / 2 statt (low + high) / 2: die Summe kann bei sehr
  // grossen Indizes ueberlaufen.
  var mid: int64 := low + (high - low) / 2;
  var pl: int64 := arr + low * 8;
  var pm: int64 := arr + mid * 8;
  var ph: int64 := arr + high * 8;
  // Median aus drei, danach steht er bei high.
  var t: int64 := 0;
  if (peek64(pl) > peek64(pm)) { t := peek64(pl); poke64(pl, peek64(pm)); poke64(pm, t); }
  if (peek64(pm) > peek64(ph)) { t := peek64(pm); poke64(pm, peek64(ph)); poke64(ph, t); }
  if (peek64(pl) > peek64(pm)) { t := peek64(pl); poke64(pl, peek64(pm)); poke64(pm, t); }
  t := peek64(pm); poke64(pm, peek64(ph)); poke64(ph, t);

  var pivot: int64 := peek64(ph);
  // pi zeigt auf arr[i + 1] des Index-Verfahrens, pj auf arr[j].
  var pi: int64 := pl;
  var pj: int64 := pl;
  while (pj < ph) {
    var v: int64 := peek64(pj);
    if (v <= pivot) {
      poke64(pj, peek64(pi));
      poke64(pi, v);
      pi += 8;
    }
    pj += 8;
  }
  poke64(ph, peek64(pi));
  poke64(pi, pivot);
  return (pi - arr) / 8;
}

fn InsertionSort(arr: int64, low: int64, high: int64): void {
  var lo: int64 := arr + low * 8;
  var i: int64 := low + 1;
  while (i <= high) {
    var key: int64 := peek64(arr + i * 8);
    var p: int64 := arr + (i - 1) * 8;
    while (p >= lo && peek64(p) > key) {
      poke64(p + 8, peek64(p));
      p -= 8;
    }
    poke64(p + 8, key);
    i += 1;
  }
}

fn QuickSortInternal(arr: int64, low: int64, high: int64): void {
  if (low >= high) {
    return;
  }
  var size: int64 := high - low + 1;
  if (size < 10) {
    InsertionSort(arr, low, high);
    return;
  }
  var pivotIdx: int64 := Partition(arr, low, high);
  if (pivotIdx > low) {
    QuickSortInternal(arr, low, pivotIdx - 1);
  }
  QuickSortInternal(arr, pivotIdx + 1, high);
}
