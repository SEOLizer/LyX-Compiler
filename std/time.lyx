unit std.time;

import std.alloc;

pub type date      = int64; // days since epoch
pub type time      = int64; // seconds since midnight
pub type datetime  = int64; // Unix seconds
pub type timestamp = int64; // Unix microseconds

pub fn DaysFromCivil(year: int64, month: int64, day: int64): int64 {
  var y: int64 := year;
  var m: int64 := month;
  var d: int64 := day;

  if (m <= 2) {
    y -= 1;
    m += 12;
  }

  var era: int64 := y / 400;
  if (y < 0) {
    if ((y % 400) != 0) {
      era -= 1;
    }
  }

  var eraY: int64 := era * 400;
  var yoe: int64 := y - eraY;
  var m3: int64 := m - 3;
  var m3_153: int64 := 153 * m3;
  var m3_153_2: int64 := m3_153 + 2;
  var doy_part: int64 := m3_153_2 / 5;
  var doy1: int64 := doy_part + d;
  var doy: int64 := doy1 - 1;
  var yoe365: int64 := yoe * 365;
  var yoe4: int64 := yoe / 4;
  var yoe100: int64 := yoe / 100;
  var doe1: int64 := yoe365 + yoe4;
  var doe2: int64 := doe1 - yoe100;
  var doe: int64 := doe2 + doy;
  var era146097: int64 := era * 146097;
  var r1: int64 := era146097 + doe;
  return r1 - 719468;
}

pub fn CivilYearFromDays(days: int64): int64 {
  var z: int64 := days + 719468;
  var era: int64 := z / 146097;
  if (z < 0) {
    if ((z % 146097) != 0) {
      era -= 1;
    }
  }
  var eraY: int64 := era * 146097;
  var doe: int64 := z - eraY;
  var doe1460: int64 := doe / 1460;
  var doe36524: int64 := doe / 36524;
  var doe146096: int64 := doe / 146096;
  var s1: int64 := doe - doe1460;
  var s2: int64 := s1 + doe36524;
  var s3: int64 := s2 - doe146096;
  var yoe: int64 := s3 / 365;
  var era400: int64 := era * 400;
  return yoe + era400;
}

pub fn CivilMonthFromDays(days: int64): int64 {
  var z: int64 := days + 719468;
  var era: int64 := z / 146097;
  if (z < 0) {
    if ((z % 146097) != 0) {
      era -= 1;
    }
  }
  var eraY: int64 := era * 146097;
  var doe: int64 := z - eraY;
  var doe1460: int64 := doe / 1460;
  var doe36524: int64 := doe / 36524;
  var doe146096: int64 := doe / 146096;
  var s1: int64 := doe - doe1460;
  var s2: int64 := s1 + doe36524;
  var s3: int64 := s2 - doe146096;
  var yoe: int64 := s3 / 365;
  var era400: int64 := era * 400;
  var yoe365: int64 := 365 * yoe;
  var yoe4: int64 := yoe / 4;
  var yoe100: int64 := yoe / 100;
  var yd1: int64 := yoe365 + yoe4;
  var yd2: int64 := yd1 - yoe100;
  var doy: int64 := doe - yd2;
  var doy5: int64 := 5 * doy;
  var doy5_2: int64 := doy5 + 2;
  var mp: int64 := doy5_2 / 153;
  var month: int64 := mp + 3;
  if (mp >= 10) {
    month -= 12;
  }
  return month;
}

pub fn CivilDayFromDays(days: int64): int64 {
  var z: int64 := days + 719468;
  var era: int64 := z / 146097;
  if (z < 0) {
    if ((z % 146097) != 0) {
      era -= 1;
    }
  }
  var eraY: int64 := era * 146097;
  var doe: int64 := z - eraY;
  var doe1460: int64 := doe / 1460;
  var doe36524: int64 := doe / 36524;
  var doe146096: int64 := doe / 146096;
  var s1: int64 := doe - doe1460;
  var s2: int64 := s1 + doe36524;
  var s3: int64 := s2 - doe146096;
  var yoe: int64 := s3 / 365;
  var era400: int64 := era * 400;
  var yoe365: int64 := 365 * yoe;
  var yoe4: int64 := yoe / 4;
  var yoe100: int64 := yoe / 100;
  var yd1: int64 := yoe365 + yoe4;
  var yd2: int64 := yd1 - yoe100;
  var doy: int64 := doe - yd2;
  var doy5: int64 := 5 * doy;
  var doy5_2: int64 := doy5 + 2;
  var mp: int64 := doy5_2 / 153;
  var mp153: int64 := 153 * mp;
  var mp153_2: int64 := mp153 + 2;
  var mp153_2_5: int64 := mp153_2 / 5;
  var r1: int64 := doy - mp153_2_5;
  return r1 + 1;
}

pub fn IsLeapYear(y: int64): bool {
  if ((y % 4) != 0) { return false; }
  if ((y % 100) != 0) { return true; }
  if ((y % 400) == 0) { return true; }
  return false;
}

pub fn DateFromYmd(year: int64, month: int64, day: int64): date {
  var d: int64 := DaysFromCivil(year, month, day);
  return d;
}

pub fn YearFromDate(d: date): int64 {
  return CivilYearFromDays(d);
}

pub fn MonthFromDate(d: date): int64 {
  return CivilMonthFromDays(d);
}

pub fn DayFromDate(d: date): int64 {
  return CivilDayFromDays(d);
}

pub fn TimeFromHms(hour: int64, minute: int64, second: int64): time {
  var h3600: int64 := hour * 3600;
  var m60: int64 := minute * 60;
  var hm: int64 := h3600 + m60;
  return hm + second;
}

pub fn HourFromTime(t: time): int64 {
  var ti: int64 := t;
  return ti / 3600;
}

pub fn MinuteFromTime(t: time): int64 {
  var ti: int64 := t;
  var t3600: int64 := ti % 3600;
  return t3600 / 60;
}

pub fn SecondFromTime(t: time): int64 {
  var ti: int64 := t;
  return ti % 60;
}

pub fn DatetimeFromUnixSeconds(sec: int64): datetime {
  return sec;
}

pub fn DatetimeToUnixSeconds(dt: datetime): int64 {
  return dt;
}

pub fn TimestampFromUnixSeconds(sec: int64): timestamp {
  var r: int64 := sec * 1000000;
  return r;
}

pub fn UnixSecondsFromTimestamp(ts: timestamp): int64 {
  var tsi: int64 := ts;
  return tsi / 1000000;
}

// #1179: Hier standen `extern fn now_unix()` und `now_unix_ms()` OHNE
// link-Klausel. Solche Symbole gibt es in keiner Bibliothek — sie wurden nie
// gebunden, der Aufruf lieferte still 0, und damit gaben `Now()`, `NowUs()`
// und `NowMs()` seit jeher 0 zurueck, ohne dass irgendetwas meldete.
//
// Ersetzt durch clock_gettime (Syscall 228, CLOCK_REALTIME). Das ist die
// Zeitquelle, die der seccomp-Filter unter `system.time` durchlaesst —
// `gettimeofday` (96) und `time` (201) laesst er NICHT durch. Kein libc
// noetig, das Programm bleibt statisch linkbar.
con TIME_CLOCK_REALTIME: int64 := 0;

// timespec: { tv_sec: int64, tv_nsec: int64 } — 16 Byte.
fn _timeNowSpec(buf: int64): int64 {
  return sys_clock_gettime(TIME_CLOCK_REALTIME, buf);
}

pub fn Now(): datetime {
  var buf: int64 := alloc(16);
  _timeNowSpec(buf);
  var sec: int64 := peek64(buf);
  free(buf, 16);
  return sec;
}

pub fn NowUs(): timestamp {
  var buf: int64 := alloc(16);
  _timeNowSpec(buf);
  var sec: int64 := peek64(buf);
  var nsec: int64 := peek64(buf + 8);
  free(buf, 16);
  return sec * 1000000 + nsec / 1000;
}

pub fn NowMs(): int64 {
  var buf: int64 := alloc(16);
  _timeNowSpec(buf);
  var sec: int64 := peek64(buf);
  var nsec: int64 := peek64(buf + 8);
  free(buf, 16);
  return sec * 1000 + nsec / 1000000;
}

pub fn DayOfWeekFromDate(d: date): int64 {
  var d4: int64 := d + 4;
  var dow: int64 := d4 % 7;
  if (dow < 0) {
    dow += 7;
  }
  return dow;
}

pub fn DaysInMonth(year: int64, month: int64): int64 {
  if (month == 2) {
    if (IsLeapYear(year)) { return 29; }
    return 28;
  }
  if ((month == 4) || (month == 6) || (month == 9) || (month == 11)) {
    return 30;
  }
  return 31;
}

pub con SECOND: int64 := 1000000;
pub con MINUTE: int64 := 60000000;
pub con HOUR: int64 := 3600000000;
pub con DAY: int64 := 86400000000;

pub type TimeZone = struct {
  name: pchar;
  offset_seconds: int64;
};

pub fn ZoneUTC(): TimeZone {
  var z: TimeZone;
  z.name := "UTC";
  z.offset_seconds := 0;
  return z;
}

pub fn ZoneCET(): TimeZone {
  var z: TimeZone;
  z.name := "CET";
  z.offset_seconds := 3600;
  return z;
}

pub fn ZoneCEST(): TimeZone {
  var z: TimeZone;
  z.name := "CEST";
  z.offset_seconds := 7200;
  return z;
}

pub fn ApplyTimeZone(dt: datetime, zone: TimeZone): datetime {
  var off: int64 := zone.offset_seconds;
  return dt + off;
}

// ============================================================
// WP-4: Syscall-basierte Zeit- und Timer-Funktionen
// ============================================================

// Clock-IDs (POSIX)
pub con CLOCK_REALTIME:            int64 := 0;
pub con CLOCK_MONOTONIC:           int64 := 1;
pub con CLOCK_PROCESS_CPUTIME_ID:  int64 := 2;
pub con CLOCK_THREAD_CPUTIME_ID:   int64 := 3;
pub con CLOCK_MONOTONIC_RAW:       int64 := 4;
pub con CLOCK_BOOTTIME:            int64 := 7;

// clock_nanosleep / timerfd Flags
pub con TIMER_ABSTIME:      int64 := 1;  // absoluter Zeitpunkt statt relativ

// timerfd Flags
pub con TFD_CLOEXEC:        int64 := 524288;  // 0x80000
pub con TFD_NONBLOCK:       int64 := 2048;    // 0x800
pub con TFD_TIMER_ABSTIME:  int64 := 1;
pub con TFD_TIMER_CANCEL_ON_SET: int64 := 2;

// timespec / timeval Struktur-Größen
pub con TIMESPEC_SIZE:  int64 := 16;  // { tv_sec:8, tv_nsec:8 }
pub con TIMEVAL_SIZE:   int64 := 16;  // { tv_sec:8, tv_usec:8 }
pub con ITIMERSPEC_SIZE: int64 := 32; // { it_interval:timespec, it_value:timespec }

// Nanosekunden-Konstanten
pub con NS_PER_MS:  int64 := 1000000;      // 1 ms  in ns
pub con NS_PER_SEC: int64 := 1000000000;   // 1 s   in ns
pub con US_PER_SEC: int64 := 1000000;      // 1 s   in µs

// ============================================================
// Schlafen
// ============================================================

// Sleep: schläft mindestens ms Millisekunden.
// Gibt 0 bei Erfolg, -EINTR wenn durch Signal unterbrochen.
pub fn Sleep(ms: int64): int64 {
  var ts: int64 := alloc(TIMESPEC_SIZE);
  if (ts == 0) { return -1; }
  poke64(ts,     ms / 1000);           // tv_sec
  poke64(ts + 8, (ms % 1000) * NS_PER_MS); // tv_nsec
  var r: int64 := sys_nanosleep(ts, 0);
  free(ts, TIMESPEC_SIZE);
  return r;
}

// SleepNs: schläft mindestens ns Nanosekunden.
pub fn SleepNs(ns: int64): int64 {
  var ts: int64 := alloc(TIMESPEC_SIZE);
  if (ts == 0) { return -1; }
  poke64(ts,     ns / NS_PER_SEC);
  poke64(ts + 8, ns % NS_PER_SEC);
  var r: int64 := sys_nanosleep(ts, 0);
  free(ts, TIMESPEC_SIZE);
  return r;
}

// SleepUntil: schläft bis zum absoluten Zeitpunkt absNs (Nanosekunden seit Epoche).
// clockId: CLOCK_MONOTONIC oder CLOCK_REALTIME.
pub fn SleepUntil(clockId: int64, absNs: int64): int64 {
  var ts: int64 := alloc(TIMESPEC_SIZE);
  if (ts == 0) { return -1; }
  poke64(ts,     absNs / NS_PER_SEC);
  poke64(ts + 8, absNs % NS_PER_SEC);
  var r: int64 := sys_clock_nanosleep(clockId, TIMER_ABSTIME, ts, 0);
  free(ts, TIMESPEC_SIZE);
  return r;
}

// ============================================================
// Uhrzeit lesen
// ============================================================

// GetTimeNs: liefert die aktuelle Zeit in Nanosekunden (via clock_gettime).
// clockId: CLOCK_REALTIME, CLOCK_MONOTONIC, etc.
pub fn GetTimeNs(clockId: int64): int64 {
  var ts: int64 := alloc(TIMESPEC_SIZE);
  if (ts == 0) { return 0; }
  clock_gettime(clockId, ts);
  var sec:  int64 := peek64(ts);
  var nsec: int64 := peek64(ts + 8);
  free(ts, TIMESPEC_SIZE);
  return sec * NS_PER_SEC + nsec;
}

// GetTimeMs: liefert Millisekunden seit CLOCK_MONOTONIC-Epoche.
pub fn GetTimeMs(): int64 {
  return GetTimeNs(CLOCK_MONOTONIC) / NS_PER_MS;
}

// GetTimeOfDay: schreibt Unix-Sekunden und Mikrosekunden in die Ausgabe-Buffer.
// tvSecOut / tvUsecOut: je alloc(8); danach via peek64() lesen.
pub fn GetTimeOfDay(tvSecOut: int64, tvUsecOut: int64): int64 {
  var tv: int64 := alloc(TIMEVAL_SIZE);
  if (tv == 0) { return -1; }
  var r: int64 := sys_gettimeofday(tv, 0);
  if (r == 0) {
    poke64(tvSecOut,  peek64(tv));
    poke64(tvUsecOut, peek64(tv + 8));
  }
  free(tv, TIMEVAL_SIZE);
  return r;
}

// GetUnixMs: liefert aktuelle Zeit als Millisekunden seit Unix-Epoche.
pub fn GetUnixMs(): int64 {
  var tv: int64 := alloc(TIMEVAL_SIZE);
  if (tv == 0) { return 0; }
  sys_gettimeofday(tv, 0);
  var sec:  int64 := peek64(tv);
  var usec: int64 := peek64(tv + 8);
  free(tv, TIMEVAL_SIZE);
  return sec * 1000 + usec / 1000;
}

// ============================================================
// timerfd — Kernel-Timer über fd (epoll-integrierbar)
// ============================================================

// TimerFdCreate: erstellt einen neuen timerfd.
// clockId: CLOCK_REALTIME oder CLOCK_MONOTONIC.
// flags: TFD_CLOEXEC | TFD_NONBLOCK (oder 0).
pub fn TimerFdCreate(clockId: int64, flags: int64): int64 {
  return sys_timerfd_create(clockId, flags);
}

// TimerFdSetTime: stellt den Timer ein.
// intervalNs: Wiederholintervall in ns (0 = einmalig).
// valueNs:    erste Ablaufzeit in ns (relativ, ab sofort).
pub fn TimerFdSetTime(fd: int64, intervalNs: int64, valueNs: int64): int64 {
  var its: int64 := alloc(ITIMERSPEC_SIZE);
  if (its == 0) { return -1; }
  // it_interval (Offset 0): Wiederholungsintervall
  poke64(its,      intervalNs / NS_PER_SEC);
  poke64(its + 8,  intervalNs % NS_PER_SEC);
  // it_value (Offset 16): erste Ablaufzeit
  poke64(its + 16, valueNs / NS_PER_SEC);
  poke64(its + 24, valueNs % NS_PER_SEC);
  var r: int64 := sys_timerfd_settime(fd, 0, its, 0);
  free(its, ITIMERSPEC_SIZE);
  return r;
}

// TimerFdGetTime: liest die verbleibende Zeit bis zum nächsten Ablauf.
// Gibt Nanosekunden zurück, oder 0 wenn abgelaufen.
pub fn TimerFdGetTime(fd: int64): int64 {
  var its: int64 := alloc(ITIMERSPEC_SIZE);
  if (its == 0) { return 0; }
  sys_timerfd_gettime(fd, its);
  var sec:  int64 := peek64(its + 16);
  var nsec: int64 := peek64(its + 24);
  free(its, ITIMERSPEC_SIZE);
  return sec * NS_PER_SEC + nsec;
}

// TimerFdRead: liest die Anzahl der Abläufe seit letztem Lesen (blockierend).
// Gibt die Ablauf-Anzahl zurück (uint64), oder < 0 bei Fehler.
pub fn TimerFdRead(fd: int64): int64 {
  var buf: int64 := alloc(8);
  if (buf == 0) { return -1; }
  var n: int64 := sys_read(fd, buf, 8);
  var count: int64 := 0;
  if (n == 8) {
    count := peek64(buf);
  }
  free(buf, 8);
  return count;
}
