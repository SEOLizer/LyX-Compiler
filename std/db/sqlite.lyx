extern fn sqlite3_errmsg(db: int64): pchar link "libsqlite3.so.0";
extern fn sqlite3_errcode(db: int64): int64 link "libsqlite3.so.0";

// ============================================================================
// Konstanten — Rückgabecodes
// ============================================================================

pub con SQLITE_OK:         int64 := 0;
pub con SQLITE_ERROR:      int64 := 1;
pub con SQLITE_BUSY:       int64 := 5;
pub con SQLITE_NOMEM:      int64 := 7;
pub con SQLITE_NOTFOUND:   int64 := 12;
pub con SQLITE_MISUSE:     int64 := 21;
pub con SQLITE_CONSTRAINT: int64 := 19;
pub con SQLITE_ROW:        int64 := 100;
pub con SQLITE_DONE:       int64 := 101;

// ============================================================================
// Konstanten — Spalten-Typkodes
// ============================================================================

pub con SQLITE_INTEGER: int64 := 1;
pub con SQLITE_FLOAT:   int64 := 2;
pub con SQLITE_TEXT:    int64 := 3;
pub con SQLITE_BLOB:    int64 := 4;
pub con SQLITE_NULL:    int64 := 5;

// ============================================================================
// Konstanten — Destruktor-Sentinels (für sqlite3_bind_text / _blob)
// ============================================================================

pub con SQLITE_STATIC:    int64 := 0;
pub con SQLITE_TRANSIENT: int64 := -1;

// ============================================================================
// Typ: SQLiteDB
//
// Speicherlayout (mmap, 24 Bytes):
//   +0  handle       (int64) — sqlite3*
//   +8  _reserved    (int64) — 0, reserviert für path-Pointer
//   +16 last_errcode (int64) — Fehlercode der letzten Operation
// ============================================================================

pub type SQLiteDB = struct {
    handle:       int64;
    _reserved:    int64;
    last_errcode: int64;
};

con _SQ_DB_SIZE: int64 := 24;

// ============================================================================
// WP-SQ-02: Verbindungsverwaltung
// ============================================================================

// SQLiteOpen öffnet oder erstellt eine SQLite-Datenbank.
// Gibt einen SQLiteDB-Pointer (int64) zurück; 0 bei Fehler.
// Für In-Memory-DBs: SQLiteOpen(":memory:")
pub fn SQLiteOpen(path: pchar): int64 {
    var p: int64 := alloc(_SQ_DB_SIZE);
    if (p <= 0) { return 0; }
    // sqlite3_open schreibt den sqlite3*-Handle in ein vom Aufrufer bereitgestelltes Slot
    var slot: int64 := alloc(8);
    if (slot <= 0) { free(p, _SQ_DB_SIZE); return 0; }
    var rc: int64 := sqlite3_open(path, slot);
    var handle: int64 := peek64(slot);
    free(slot, 8);
    if (rc != SQLITE_OK) {
        if (handle != 0) { sqlite3_close(handle); }
        free(p, _SQ_DB_SIZE);
        return 0;
    }
    poke64(p,      handle);
    poke64(p + 8,  0);
    poke64(p + 16, 0);
    return p;
}

// SQLiteClose schließt die Verbindung und gibt den SQLiteDB-Speicher frei.
pub fn SQLiteClose(db: int64): void {
    if (db == 0) { return; }
    var handle: int64 := peek64(db);
    if (handle != 0) { sqlite3_close(handle); }
    free(db, _SQ_DB_SIZE);
}

// SQLiteExec führt ein SQL-Statement ohne Ergebnismenge aus
// (CREATE TABLE, INSERT ohne Bind, PRAGMA, …).
// Gibt true bei Erfolg zurück.
pub fn SQLiteExec(db: int64, sql: pchar): bool {
    var handle: int64 := peek64(db);
    var rc: int64 := sqlite3_exec(handle, sql, 0, 0, 0);
    poke64(db + 16, rc);
    return rc == SQLITE_OK;
}

// WP-8: SQLiteExecParam — führt parameterisiertes SQL aus (ein Schritt).
// params: int64-Pointer auf pchar-Array mit nparams Einträgen (String-Parameter).
// Bindet alle Parameter via sqlite3_bind_text und führt einen sqlite3_step aus.
pub fn SQLiteExecParam(db: int64, sql: pchar, params: int64, nparams: int64): bool {
    var stmt: int64 := SQLiteStmtPrepare(db, sql);
    if (stmt == 0) { return false; }
    var i: int64 := 0;
    while (i < nparams) {
        var p: pchar := peek64(params + i * 8) as pchar;
        SQLiteBindStr(stmt, i + 1, p);
        i += 1;
    }
    var rc: int64 := SQLiteStmtStep(stmt);
    SQLiteStmtFinalize(stmt);
    return rc == 100 || rc == 101;  // SQLITE_ROW=100 or SQLITE_DONE=101
}

// SQLiteErrmsg gibt die Fehlermeldung der letzten Operation zurück.
pub fn SQLiteErrmsg(db: int64): pchar {
    return sqlite3_errmsg(peek64(db));
}

// SQLiteErrno gibt den Fehlercode der letzten Operation zurück.
pub fn SQLiteErrno(db: int64): int64 {
    return sqlite3_errcode(peek64(db));
}

// ============================================================================
// Typ: SQLiteStmt
//
// Speicherlayout (mmap, 24 Bytes):
//   +0  handle       (int64) — sqlite3_stmt*
//   +8  db           (int64) — Pointer auf parent SQLiteDB (für Fehler-Rückschreiben)
//   +16 column_count (int64) — Spaltenanzahl (gesetzt bei Prepare)
// ============================================================================

pub type SQLiteStmt = struct {
    handle:       int64;
    db:           int64;
    column_count: int64;
};

con _SQ_STMT_SIZE: int64 := 24;

// ============================================================================
// WP-SQ-03: Prepared Statements & Parameter-Binding
// ============================================================================

// SQLiteStmtPrepare kompiliert ein SQL-Statement und gibt einen SQLiteStmt-Pointer zurück.
// Gibt 0 zurück bei Fehler (Fehlertext via SQLiteErrmsg(db)).
pub fn SQLiteStmtPrepare(db: int64, sql: pchar): int64 {
    var dbHandle: int64 := peek64(db);
    var slot: int64 := alloc(8);
    if (slot <= 0) { return 0; }
    var rc: int64 := sqlite3_prepare_v2(dbHandle, sql, 0 - 1, slot, 0);
    var stmtHandle: int64 := peek64(slot);
    free(slot, 8);
    if (rc != SQLITE_OK) {
        poke64(db + 16, rc);
        return 0;
    }
    var p: int64 := alloc(_SQ_STMT_SIZE);
    if (p <= 0) {
        sqlite3_finalize(stmtHandle);
        return 0;
    }
    poke64(p,      stmtHandle);
    poke64(p + 8,  db);
    poke64(p + 16, sqlite3_column_count(stmtHandle));
    return p;
}

// SQLiteStmtFinalize gibt das Prepared Statement frei.
pub fn SQLiteStmtFinalize(stmt: int64): void {
    if (stmt == 0) { return; }
    sqlite3_finalize(peek64(stmt));
    free(stmt, _SQ_STMT_SIZE);
}

// SQLiteStmtReset setzt das Statement auf den Anfangszustand zurück.
// Bindings bleiben erhalten — geeignet für Re-Execution mit neuen Werten.
pub fn SQLiteStmtReset(stmt: int64): void {
    sqlite3_reset(peek64(stmt));
}

// SQLiteClearBindings setzt alle Bindungen auf NULL zurück.
pub fn SQLiteClearBindings(stmt: int64): void {
    sqlite3_clear_bindings(peek64(stmt));
}

// SQLiteBindInt bindet einen int64-Wert an Parameter i (1-basiert).
pub fn SQLiteBindInt(stmt: int64, i: int64, v: int64): bool {
    var rc: int64 := sqlite3_bind_int64(peek64(stmt), i, v);
    return rc == SQLITE_OK;
}

// SQLiteBindFloat bindet einen f64-Wert an Parameter i (1-basiert).
pub fn SQLiteBindFloat(stmt: int64, i: int64, v: f64): bool {
    var rc: int64 := sqlite3_bind_double(peek64(stmt), i, v);
    return rc == SQLITE_OK;
}

// SQLiteBindStr bindet einen null-terminierten String an Parameter i (1-basiert).
// Der String muss bis zum nächsten Step/Reset/Finalize gültig bleiben (SQLITE_STATIC).
pub fn SQLiteBindStr(stmt: int64, i: int64, v: pchar): bool {
    var rc: int64 := sqlite3_bind_text(peek64(stmt), i, v, 0 - 1, SQLITE_STATIC);
    return rc == SQLITE_OK;
}

// SQLiteBindNull bindet NULL an Parameter i (1-basiert).
pub fn SQLiteBindNull(stmt: int64, i: int64): bool {
    var rc: int64 := sqlite3_bind_null(peek64(stmt), i);
    return rc == SQLITE_OK;
}

// ============================================================================
// WP-SQ-04: Result-Set — Step & Column-Accessors
// ============================================================================

// SQLiteStmtStep führt einen Schritt aus.
// Gibt SQLITE_ROW (100) zurück wenn eine Zeile verfügbar ist,
// SQLITE_DONE (101) wenn alle Zeilen verarbeitet wurden,
// oder SQLITE_ERROR (1) bei einem Fehler.
pub fn SQLiteStmtStep(stmt: int64): int64 {
    var rc: int64 := sqlite3_step(peek64(stmt));
    if (rc != SQLITE_ROW && rc != SQLITE_DONE) {
        var db: int64 := peek64(stmt + 8);
        if (db != 0) { poke64(db + 16, rc); }
    }
    return rc;
}

// SQLiteColumnInt liest eine INTEGER-Spalte (0-basierter Index).
pub fn SQLiteColumnInt(stmt: int64, i: int64): int64 {
    return sqlite3_column_int64(peek64(stmt), i);
}

// SQLiteColumnFloat liest eine REAL-Spalte (0-basierter Index).
pub fn SQLiteColumnFloat(stmt: int64, i: int64): f64 {
    return sqlite3_column_double(peek64(stmt), i);
}

// SQLiteColumnText liest eine TEXT-Spalte (0-basierter Index).
// Der zurückgegebene Pointer ist bis zum nächsten Step/Reset/Finalize gültig.
pub fn SQLiteColumnText(stmt: int64, i: int64): pchar {
    return sqlite3_column_text(peek64(stmt), i);
}

// SQLiteColumnIsNull gibt true zurück wenn die Spalte NULL ist (0-basierter Index).
pub fn SQLiteColumnIsNull(stmt: int64, i: int64): bool {
    return sqlite3_column_type(peek64(stmt), i) == SQLITE_NULL;
}

// SQLiteColumnType gibt den Typ-Code der Spalte zurück (0-basierter Index).
// Mögliche Werte: SQLITE_INTEGER(1), SQLITE_FLOAT(2), SQLITE_TEXT(3),
//                 SQLITE_BLOB(4), SQLITE_NULL(5)
pub fn SQLiteColumnType(stmt: int64, i: int64): int64 {
    return sqlite3_column_type(peek64(stmt), i);
}

// SQLiteColumnCount gibt die Anzahl der Spalten im Ergebnis zurück.
pub fn SQLiteColumnCount(stmt: int64): int64 {
    return peek64(stmt + 16);
}

// SQLiteColumnName gibt den Namen der Spalte zurück (0-basierter Index).
pub fn SQLiteColumnName(stmt: int64, i: int64): pchar {
    return sqlite3_column_name(peek64(stmt), i);
}

// ============================================================================
// WP-SQ-05: Transaktionen
// ============================================================================

// SQLiteBegin startet eine Transaktion (BEGIN TRANSACTION).
pub fn SQLiteBegin(db: int64): bool {
    return SQLiteExec(db, "BEGIN TRANSACTION");
}

// SQLiteCommit schreibt eine Transaktion fest (COMMIT).
pub fn SQLiteCommit(db: int64): bool {
    return SQLiteExec(db, "COMMIT");
}

// SQLiteRollback macht eine Transaktion rückgängig (ROLLBACK).
pub fn SQLiteRollback(db: int64): bool {
    return SQLiteExec(db, "ROLLBACK");
}

// SQLiteBeginImmediate startet eine Transaktion mit sofortigem Schreib-Lock.
pub fn SQLiteBeginImmediate(db: int64): bool {
    return SQLiteExec(db, "BEGIN IMMEDIATE");
}

// SQLiteBeginExclusive startet eine exklusive Transaktion.
pub fn SQLiteBeginExclusive(db: int64): bool {
    return SQLiteExec(db, "BEGIN EXCLUSIVE");
}

// SQLiteInTransaction gibt true zurück wenn eine Transaktion aktiv ist.
// sqlite3_get_autocommit gibt 0 zurück wenn eine Transaktion läuft.
pub fn SQLiteInTransaction(db: int64): bool {
    return sqlite3_get_autocommit(peek64(db)) == 0;
}

// ============================================================================
// WP-SQ-06: Hilfsfunktionen & Metadaten
// ============================================================================

// Privater Helper: kopiert null-terminierten String pchar nach dst,
// gibt Pointer hinter das abschließende Null-Byte zurück.
fn _sqWriteStr(dst: int64, src: pchar): int64 {
    var i: int64 := 0;
    while (peek8(src + i) != 0) {
        poke8(dst + i, peek8(src + i));
        i += 1;
    }
    poke8(dst + i, 0);
    return dst + i;
}

// Privater Helper: schreibt nicht-negative int64 dezimal nach dst,
// gibt Pointer hinter das abschließende Null-Byte zurück.
fn _sqWriteInt(dst: int64, n: int64): int64 {
    if (n == 0) {
        poke8(dst, 48);
        poke8(dst + 1, 0);
        return dst + 1;
    }
    var len: int64 := 0;
    var v: int64 := n;
    while (v > 0) {
        poke8(dst + len, 48 + (v % 10));
        v := v / 10;
        len += 1;
    }
    // Ziffern umkehren
    var l: int64 := 0;
    var r: int64 := len - 1;
    while (l < r) {
        var tmp: int64 := peek8(dst + l);
        poke8(dst + l, peek8(dst + r));
        poke8(dst + r, tmp);
        l += 1;
        r -= 1;
    }
    poke8(dst + len, 0);
    return dst + len;
}

// SQLiteLastInsertId gibt die Rowid des letzten erfolgreichen INSERT zurück.
pub fn SQLiteLastInsertId(db: int64): int64 {
    return sqlite3_last_insert_rowid(peek64(db));
}

// SQLiteChanges gibt die Anzahl der durch das letzte INSERT/UPDATE/DELETE
// betroffenen Zeilen zurück.
pub fn SQLiteChanges(db: int64): int64 {
    return sqlite3_changes(peek64(db));
}

// SQLiteTableExists gibt true zurück wenn die Tabelle existiert.
pub fn SQLiteTableExists(db: int64, table: pchar): bool {
    var stmt: int64 := SQLiteStmtPrepare(db,
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name=? LIMIT 1");
    if (stmt == 0) { return false; }
    SQLiteBindStr(stmt, 1, table);
    var rc: int64 := SQLiteStmtStep(stmt);
    SQLiteStmtFinalize(stmt);
    return rc == SQLITE_ROW;
}

// WP-8: Prüft ob name nur sichere SQL-Identifier-Zeichen enthält [a-zA-Z0-9_.].
fn sqValidateIdentifier(name: pchar): bool {
  if (name == 0 as pchar) { return false; }
  var i: int64 := 0;
  var c: int64 := StrCharAt(name, i) & 255;
  if (c == 0) { return false; }
  while (c != 0) {
    var safe: int64 := 0;
    if (c >= 65 && c <= 90)  { safe := 1; }  // A-Z
    if (c >= 97 && c <= 122) { safe := 1; }  // a-z
    if (c >= 48 && c <= 57)  { safe := 1; }  // 0-9
    if (c == 95)              { safe := 1; }  // _
    if (c == 46)              { safe := 1; }  // .
    if (safe == 0) { return false; }
    i += 1;
    c := StrCharAt(name, i) & 255;
  }
  return true;
}

// SQLiteDropTable führt DROP TABLE IF EXISTS aus.
// WP-8: Identifier-Validierung — lehnt Namen mit Sonderzeichen ab.
pub fn SQLiteDropTable(db: int64, table: pchar): bool {
    if (!sqValidateIdentifier(table)) { return false; }
    var buf: int64 := alloc(256);
    var p: int64 := _sqWriteStr(buf, "DROP TABLE IF EXISTS ");
    _sqWriteStr(p, table);
    var ok: bool := SQLiteExec(db, buf as pchar);
    free(buf, 256);
    return ok;
}

// SQLiteVacuum gibt ungenutzten Speicher in der DB-Datei frei.
pub fn SQLiteVacuum(db: int64): bool {
    return SQLiteExec(db, "VACUUM");
}

// SQLiteSetJournalMode setzt den Journal-Modus (z. B. "WAL" oder "DELETE").
// WP-8: Whitelist-Validierung — nur bekannte sichere Modi erlaubt.
pub fn SQLiteSetJournalMode(db: int64, mode: pchar): bool {
    if (mode == 0 as pchar) { return false; }
    var valid: int64 := 0;
    if (StrCmp(mode, "WAL"c)      == 0) { valid := 1; }
    if (StrCmp(mode, "DELETE"c)   == 0) { valid := 1; }
    if (StrCmp(mode, "TRUNCATE"c) == 0) { valid := 1; }
    if (StrCmp(mode, "PERSIST"c)  == 0) { valid := 1; }
    if (StrCmp(mode, "MEMORY"c)   == 0) { valid := 1; }
    if (StrCmp(mode, "OFF"c)      == 0) { valid := 1; }
    if (valid == 0) { return false; }
    var buf: int64 := alloc(64);
    var p: int64 := _sqWriteStr(buf, "PRAGMA journal_mode=");
    _sqWriteStr(p, mode);
    var res: bool := SQLiteExec(db, buf as pchar);
    free(buf, 64);
    return res;
}

// SQLiteSetCacheSize setzt die Cache-Größe in Seiten (PRAGMA cache_size).
pub fn SQLiteSetCacheSize(db: int64, pages: int64): bool {
    var buf: int64 := alloc(64);
    var p: int64 := _sqWriteStr(buf, "PRAGMA cache_size=");
    _sqWriteInt(p, pages);
    var ok: bool := SQLiteExec(db, buf as pchar);
    free(buf, 64);
    return ok;
}

// ============================================================================
// WP-SQ-07: Blob-Support
// ============================================================================

// SQLiteBindBlob bindet Binärdaten (ptr, len Bytes) an Parameter i (1-basiert).
// Der Puffer muss bis zum nächsten Step/Reset/Finalize gültig bleiben (SQLITE_STATIC).
pub fn SQLiteBindBlob(stmt: int64, i: int64, ptr: int64, len: int64): bool {
    var rc: int64 := sqlite3_bind_blob(peek64(stmt), i, ptr, len, SQLITE_STATIC);
    return rc == SQLITE_OK;
}

// SQLiteColumnBlob gibt den Raw-Pointer auf Blob-Daten der Spalte i (0-basiert) zurück.
// Gültig bis zum nächsten Step/Reset/Finalize.
// Gibt 0 zurück wenn die Spalte NULL ist.
pub fn SQLiteColumnBlob(stmt: int64, i: int64): int64 {
    if (sqlite3_column_type(peek64(stmt), i) == SQLITE_NULL) { return 0; }
    return sqlite3_column_blob(peek64(stmt), i);
}

// SQLiteColumnBytes gibt die Länge der Blob- oder Text-Spalte i (0-basiert) in Bytes zurück.
pub fn SQLiteColumnBytes(stmt: int64, i: int64): int64 {
    return sqlite3_column_bytes(peek64(stmt), i);
}
