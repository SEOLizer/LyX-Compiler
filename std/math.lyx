// Sinus fuer Winkel in Mikrograd (0 bis 360000000).
// Rueckgabe in Festkomma (Wert * 1.000.000): Sin64(90000000) = 1000000.
//
// #1444: Zwischen zwei Gradstuetzstellen wird linear interpoliert — sonst
// waeren alle Mikrograd innerhalb eines Grades derselbe Wert, und Aufrufer,
// die in Mikrograd rechnen (geo, vector), saehen Stufen.
public fn Sin64(degrees: int64): int64 {
  var mikro: int64 := degrees;
  var vollkreis: int64 := 360000000;
  while (mikro < 0) { mikro := mikro + vollkreis; }
  mikro := mikro % vollkreis;

  // Vorzeichen und Spiegelung an 180 bzw. 90 Grad.
  var neg: int64 := 1;
  if (mikro >= 180000000) {
    neg := 0 - 1;
    mikro := mikro - 180000000;
  }
  if (mikro > 90000000) {
    mikro := 180000000 - mikro;
  }

  var grad: int64 := mikro / 1000000;
  var rest: int64 := mikro % 1000000;
  var unten: int64 := _sinTabelle(grad);
  var oben:  int64 := _sinTabelle(grad + 1);
  var wert:  int64 := unten + ((oben - unten) * rest) / 1000000;
  return wert * neg;
}

// Cosinus: cos(x) = sin(90° - x)
public fn Cos64(degrees: int64): int64 {
  return Sin64(90000000 - degrees);
}

// ============================================================
// Bit-Manipulation
// ============================================================

// Prüft ob Zahl gerade ist
public fn IsEven(x: int64): bool {
  return (x % 2) == 0;
}

// Prüft ob Zahl ungerade ist
// #1448: `x % 2` ist bei negativen Zahlen -1, nicht 1 — jede ungerade
// negative Zahl galt damit als gerade.
public fn IsOdd(x: int64): bool {
  var r: int64 := x % 2;
  return r == 1 || r == 0 - 1;
}

// Nächste Potenz von 2 (für Speicherverwaltung, Texturgrößen)
// Beispiel: NextPowerOfTwo(1000) = 1024
// HINWEIS: Bitweise Operatoren & und | sind in Lyx v0.3.x nicht unterstützt
// public fn NextPowerOfTwo(x: int64): int64 { ... }

// Prüft ob Zahl eine Potenz von 2 ist
// HINWEIS: Bitweise Operatoren & und | sind in Lyx v0.3.x nicht unterstützt
// public fn IsPowerOfTwo(x: int64): bool { ... }

// Anzahl der gesetzten Bits (Population Count)
// Wichtig für Hashing und Bit-Maschinen
// HINWEIS: Bitweise Operatoren & und | sind in Lyx v0.3.x nicht unterstützt
// public fn PopCount(x: int64): int64 { ... }

// Logarithmisch zur Basis 2 (für Hierarchien)
// Beispiel: Log2(1024) = 10
public fn Log2(x: int64): int64 {
  if (x <= 0) { return 0; }
  var result: int64 := 0;
  while (x > 1) {
    x := x / 2;
    result += 1;
  }
  return result;
}

