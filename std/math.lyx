// ============================================================================
// FEAT-03: f64-Mathematik und Zahlentheorie
// Nutzt die f64-Builtins fAdd/fSub/fMul/fDiv/fNeg/fAbs/fLt/fGt/fToInt/fFloor/fCeil
// ============================================================================

// -- Integer-Zahlentheorie --

pub fn GCD(a: int64, b: int64): int64 {
  var x: int64 := Abs64(a);
  var y: int64 := Abs64(b);
  while (y != 0) { var t: int64 := y; y := x % t; x := t; }
  return x;
}

pub fn LCM(a: int64, b: int64): int64 {
  var g: int64 := GCD(a, b);
  if (g == 0) { return 0; }
  return Abs64(a / g * b);
}

pub fn IsPowerOfTwo(x: int64): bool {
  return x > 0 && (x & (x - 1)) == 0;
}

pub fn NextPowerOfTwo(x: int64): int64 {
  if (x <= 1) { return 1; }
  var n: int64 := 1;
  while (n < x) { n := n * 2; }
  return n;
}

// #1545/#1448: Bei einer negativen Zahl ist `v / 2` eine Division mit
// Abrundung gegen null: -1 / 2 ist 0, die Schleife endete nach einem
// Durchgang und lieferte 1 — fuer JEDE negative Zahl. Bitmasken und Hashwerte
// haben regelmaessig das oberste Bit gesetzt und sind als int64 negativ.
//
// Gezaehlt wird jetzt ueber alle 64 Stellen mit logischer Verschiebung; das
// Vorzeichenbit ist eine Stelle wie jede andere.
pub fn PopCount(x: int64): int64 {
  var c: int64 := 0;
  var i: int64 := 0;
  while (i < 64) {
    if (((x >> i) & 1) != 0) { c := c + 1; }
    i := i + 1;
  }
  return c;
}

pub fn IsPrime(n: int64): bool {
  if (n < 2) { return false; }
  if (n == 2) { return true; }
  if ((n & 1) == 0) { return false; }
  var i: int64 := 3;
  while (i * i <= n) {
    if (n % i == 0) { return false; }
    i += 2;
  }
  return true;
}

pub fn NextPrime(n: int64): int64 {
  var p: int64 := n + 1;
  if (p < 2) { p := 2; }
  while (!IsPrime(p)) { p := p + 1; }
  return p;
}

// -- Ganzzahlige Grundoperationen --
//
// #1150: Es gab AbsF64/MinF64/MaxF64, aber nichts fuer Ganzzahlen. Drei
// Regressionstests riefen `abs(...)` als Builtin — das war es nie, und die
// Unit bot auch keinen Ersatz. Wer den Betrag einer Ganzzahl braucht,
// schrieb ihn bisher jedesmal selbst hin.

pub fn Abs(x: int64): int64 {
  if (x < 0) { return 0 - x; }
  return x;
}

pub fn Min(a: int64, b: int64): int64 {
  if (a < b) { return a; }
  return b;
}

pub fn Max(a: int64, b: int64): int64 {
  if (a > b) { return a; }
  return b;
}

// Vorzeichen: -1, 0 oder 1.
pub fn Sign(x: int64): int64 {
  if (x < 0) { return 0 - 1; }
  if (x > 0) { return 1; }
  return 0;
}

// -- f64-Grundoperationen (Wrapping der Builtins für Lesbarkeit) --

pub fn AbsF64(x: f64): f64 { return fAbs(x); }
pub fn NegF64(x: f64): f64 { return fNeg(x); }

pub fn MinF64(a: f64, b: f64): f64 {
  if (fLt(a, b) != 0) { return a; }
  return b;
}

pub fn MaxF64(a: f64, b: f64): f64 {
  if (fGt(a, b) != 0) { return a; }
  return b;
}

pub fn FloorF64(x: f64): f64 { return fFloor(x); }
pub fn CeilF64(x: f64): f64  { return fCeil(x);  }
pub fn RoundF64(x: f64): f64 { return fRound(x); }

// #1540: Der Umweg ueber fToInt traegt nur, solange der Wert in einen int64
// passt. Ab 2^63 lieferte er Muell — dabei ist jeder f64 dieser Groesse
// ohnehin schon ganzzahlig, weil die Mantisse keine Nachkommastellen mehr
// darstellen kann. FloorF64 und CeilF64 rechnen direkt und waren nie
// betroffen; TruncF64 zieht jetzt nach.
// #1820: Grundstock, der bisher fehlte. Die Namen sind die aus dem
// Pascal-Erbe der Sprache (odd/frac/hi/lo/swap), hier in der Schreibweise
// dieser Unit. Sie stehen in std.math und damit auf jedem Ziel bereit,
// nicht nur dort, wo ein Backend zufaellig ein Builtin dafuer kennt.

// Ungerade bzw. gerade. Fuer negative Zahlen liefert % in Lyx ein negatives
// Ergebnis (-7 % 2 == -1), der Vergleich geht deshalb gegen 0, nicht gegen 1.
pub fn Odd(n: int64): bool { return (n % 2) != 0; }
pub fn Even(n: int64): bool { return (n % 2) == 0; }

// Nachkommaanteil mit dem Vorzeichen der Zahl: Frac(5.25) == 0.25,
// Frac(-5.25) == -0.25 — wie Pascals frac, nicht wie ein Modulo.
pub fn Frac(x: f64): f64 { return x - TruncF64(x); }

// Kreiszahl als Funktion, damit sie auch dort verfuegbar ist, wo con-Faltung
// fuer f64 nicht greift.
pub fn Pi(): f64 { return 3.141592653589793; }

// Obere und untere 32 Bit eines int64. Hi schiebt logisch, damit bei
// negativen Werten nicht das Vorzeichen die oberen Bits fuellt.
pub fn HiWord(n: int64): int64 { return (n >> 32) & 4294967295; }
pub fn LoWord(n: int64): int64 { return n & 4294967295; }

// Vertauscht die beiden 32-Bit-Haelften.
pub fn SwapWords(n: int64): int64 { return (LoWord(n) << 32) | HiWord(n); }

pub fn TruncF64(x: f64): f64 {
  var grenze: f64 := 9223372036854775808.0;   // 2^63
  if (fGe(fAbs(x), grenze) != 0) { return x; }
  return (fToInt(x) as f64);
}

// #1820: Square gab es nur in src/std/math.lyx — der Kopie, die der
// Compiler selbst benutzt. Wer std.math importierte, fand sie nicht.
pub fn Square(x: f64): f64 { return x * x; }

pub fn SqrtF64(x: f64): f64 { return sqrt(x); }

// -- f64-Trigonometrie --
//
// Bis 1.0.12A rechneten Sinus und Kosinus mit PI = 355/113 und einer
// Taylor-Reihe, die nach x^9 abbrach. Beides zusammen kostete rund fuenf
// Stellen: cos(0) kam als 1.000003 heraus, cos(PI/2) als 0.006925 statt 6e-17.
// Fuer eine Drehmatrix ist das unbrauchbar — sie erhaelt dann keine Laengen
// mehr, und der Fehler waechst mit jeder verketteten Drehung.
//
// ExpF64 und LogF64 haben ihre Argumentreduktion in #1449 bekommen, die
// Trigonometrie blieb dabei liegen. Sie bekommt sie hier:
//
//   1. Reduktion auf ein Viertelintervall ueber k = round(x / (PI/2)), Rest
//      r = x - k*(PI/2). PI/2 steht dabei in zwei Teilen (hi + lo), damit
//      k*(PI/2) selbst kein Rundungsfehler ist — bei k=1 loescht sich in
//      x - k*hi die fuehrende Stelle aus, und ohne lo bliebe genau dort der
//      Fehler stehen (Cody-Waite).
//   2. Reihe auf |r| <= PI/4, wo sie schnell konvergiert: sin bis r^17, cos
//      bis r^16. Das naechste Glied traegt dort unter 1e-16.
//
// GRENZE: fuer sehr grosse |x| (jenseits von rund 1e15) ist k selbst nicht
// mehr exakt darstellbar; die Reduktion verliert dann Stellen. Wer dort
// rechnet, reduziert vorher selbst.

fn f64_pi(): f64 {
  return 3.141592653589793;
}

// PI/2, aufgeteilt in einen Teil mit abgeschnittener Mantisse (hi) und den
// Rest (lo). hi ist exakt in f64 darstellbar, k*hi bleibt damit exakt.
fn f64_pi2_hi(): f64 {
  return 1.5707963267948966;
}

fn f64_pi2_lo(): f64 {
  return 0.00000000000000006123233995736766;
}

// sin(r) fuer |r| <= PI/4, Taylor bis r^17.
fn f64_sinCore(r: f64): f64 {
  var r2: f64 := fMul(r, r);
  var r3: f64 := fMul(r2, r);
  var r5: f64 := fMul(r3, r2);
  var r7: f64 := fMul(r5, r2);
  var r9: f64 := fMul(r7, r2);
  var r11: f64 := fMul(r9, r2);
  var r13: f64 := fMul(r11, r2);
  var r15: f64 := fMul(r13, r2);
  var r17: f64 := fMul(r15, r2);
  var s: f64 := r;
  s := fSub(s, fDiv(r3,  (6 as f64)));
  s := fAdd(s, fDiv(r5,  (120 as f64)));
  s := fSub(s, fDiv(r7,  (5040 as f64)));
  s := fAdd(s, fDiv(r9,  (362880 as f64)));
  s := fSub(s, fDiv(r11, (39916800 as f64)));
  s := fAdd(s, fDiv(r13, (6227020800 as f64)));
  s := fSub(s, fDiv(r15, (1307674368000 as f64)));
  s := fAdd(s, fDiv(r17, (355687428096000 as f64)));
  return s;
}

// cos(r) fuer |r| <= PI/4, Taylor bis r^16.
fn f64_cosCore(r: f64): f64 {
  var r2: f64 := fMul(r, r);
  var r4: f64 := fMul(r2, r2);
  var r6: f64 := fMul(r4, r2);
  var r8: f64 := fMul(r6, r2);
  var r10: f64 := fMul(r8, r2);
  var r12: f64 := fMul(r10, r2);
  var r14: f64 := fMul(r12, r2);
  var r16: f64 := fMul(r14, r2);
  var c: f64 := (1 as f64);
  c := fSub(c, fDiv(r2,  (2 as f64)));
  c := fAdd(c, fDiv(r4,  (24 as f64)));
  c := fSub(c, fDiv(r6,  (720 as f64)));
  c := fAdd(c, fDiv(r8,  (40320 as f64)));
  c := fSub(c, fDiv(r10, (3628800 as f64)));
  c := fAdd(c, fDiv(r12, (479001600 as f64)));
  c := fSub(c, fDiv(r14, (87178291200 as f64)));
  c := fAdd(c, fDiv(r16, (20922789888000 as f64)));
  return c;
}

// Anzahl der Viertelkreise in x, kaufmaennisch gerundet.
// #1537: Bei sehr grossen Argumenten trug die Reduktion nicht mehr — der Rest
// blieb riesig, das Polynom lief davon und die Funktion gab praktisch ihr
// eigenes Argument zurueck statt eines Wertes in [-1, 1].
//
// Zwei Stufen: erst modulo 2*PI in f64 (das haelt den Wert klein genug fuer
// die Viertelkreis-Reduktion), danach die uebliche Rechnung. GRENZE DER
// AUSSAGE: ab etwa 1e15 traegt ein double die Phase nicht mehr — dort ist das
// Ergebnis zwar im Wertebereich, sagt ueber den tatsaechlichen Sinus aber
// nichts mehr. Das ist eine Eigenschaft der Zahlendarstellung, keine der
// Umsetzung; wer dort genaue Werte braucht, muss das Argument selbst klein
// halten.
fn f64_modZweiPi(ax: f64): f64 {
  var zweiPi: f64 := 6.283185307179586;
  if (fLt(ax, zweiPi) != 0) { return ax; }
  var q: f64 := fDiv(ax, zweiPi);
  var qi: f64 := FloorF64(q);
  return fSub(ax, fMul(qi, zweiPi));
}

fn f64_quadrant(ax: f64): int64 {
  var hi: f64 := f64_pi2_hi();
  var kf: f64 := fDiv(ax, hi);
  var k: int64 := kf as int64;
  var kfi: f64 := k as f64;
  var frac: f64 := fSub(kf, kfi);
  if (fGe(frac, fDiv((1 as f64), (2 as f64))) != 0) { k := k + 1; }
  return k;
}

// Rest nach Abzug von k Viertelkreisen, zweistufig (Cody-Waite).
fn f64_reduce(ax: f64, k: int64): f64 {
  var kf: f64 := k as f64;
  var r: f64 := fSub(ax, fMul(kf, f64_pi2_hi()));
  return fSub(r, fMul(kf, f64_pi2_lo()));
}

fn f64_e(): f64 {
  // e ≈ 1 + 1 + 1/2 + 1/6 + 1/24 + 1/120 + 1/720 + 1/5040 + 1/40320
  // ≈ 2718/1000 als Näherung
  return fDiv((2718281828 as f64), (1000000000 as f64));
}

// sin(x). Reduktion auf den Viertelkreis, dann je nach Quadrant sin oder cos
// der Restgroesse. Ungerade Symmetrie: sin(-x) = -sin(x).
pub fn SinF64(x: f64): f64 {
  var ax: f64 := x;
  var flip: bool := false;
  if (fLt(x, (0 as f64)) != 0) {
    ax := fNeg(x);
    flip := true;
  }
  ax := f64_modZweiPi(ax);                       // #1537
  var k: int64 := f64_quadrant(ax);
  var r: f64 := f64_reduce(ax, k);
  var q: int64 := k % 4;

  var res: f64 := (0 as f64);
  if (q == 0) { res := f64_sinCore(r); }
  if (q == 1) { res := f64_cosCore(r); }
  if (q == 2) { res := fNeg(f64_sinCore(r)); }
  if (q == 3) { res := fNeg(f64_cosCore(r)); }

  if (flip) { return fNeg(res); }
  return res;
}

// cos(x). Gerade Symmetrie: cos(-x) = cos(x), deshalb kein Vorzeichen am Ende.
// Nicht ueber sin(x + PI/2) — das haette den Reduktionsfehler von PI/2
// zusaetzlich eingeschleppt.
pub fn CosF64(x: f64): f64 {
  var ax: f64 := x;
  if (fLt(x, (0 as f64)) != 0) { ax := fNeg(x); }
  ax := f64_modZweiPi(ax);                       // #1537
  var k: int64 := f64_quadrant(ax);
  var r: f64 := f64_reduce(ax, k);
  var q: int64 := k % 4;

  if (q == 0) { return f64_cosCore(r); }
  if (q == 1) { return fNeg(f64_sinCore(r)); }
  if (q == 2) { return fNeg(f64_cosCore(r)); }
  return f64_sinCore(r);
}

// tan(x) = sin(x)/cos(x).
//
// An den Polen (PI/2 + n*PI) ist der Tangens unendlich. Bis 1.0.12A gab die
// Funktion dort 0 zurueck — den Wert, der dem richtigen am weitesten
// entgegensteht, und ohne jeden Hinweis. Die Sonderbehandlung ist deshalb
// weg: die Division liefert an einem exakten Pol das IEEE-Unendlich, und in
// jedem anderen Fall den richtigen Wert. Wer den Pol abfangen will, prueft
// CosF64 vorher selbst.
pub fn TanF64(x: f64): f64 {
  var s: f64 := SinF64(x);
  var c: f64 := CosF64(x);
  return fDiv(s, c);
}

// ExpF64 via Taylor: e^x = 1 + x + x²/2 + x³/6 + x⁴/24 + x⁵/120 + x⁶/720 + x⁷/5040
// #1449: Beide Reihen liefen OHNE Argumentreduktion. Die Taylor-Reihe fuer
// exp brach nach x^7 ab — bei x=5 fehlen damit 13 Prozent — und LogF64
// kuendigte im Kommentar eine Normalisierung an ("x = m * 2^k"), fuehrte sie
// aber nicht aus: die arctanh-Reihe konvergiert nur nahe 1, und LogF64(100)
// lag um 26 Prozent daneben. Log10F64 und PowF64 erbten beides, PowF64(2,10)
// ergab 623 statt 1024.
//
// Beide bekommen jetzt die Reduktion, die im Kommentar schon stand.

con MATH_LN2:  f64 := 0.6931471805599453;
con MATH_LN10: f64 := 2.302585092994046;

// exp(x) = 2^k * exp(r) mit x = k*ln2 + r und |r| <= ln2/2.
// Fuer so kleines r traegt die Reihe bis x^9 rund 1e-16 Fehler — mehr als
// genug fuer f64.
pub fn ExpF64(x: f64): f64 {
  var one: f64 := (1 as f64);
  if (fLt(x, fNeg((745 as f64))) != 0) { return (0 as f64); }   // unterlaeuft f64

  // k = round(x / ln2)
  var kf: f64 := fDiv(x, MATH_LN2);
  var k: int64 := kf as int64;
  var kfi: f64 := k as f64;
  if (fGt(fSub(kf, kfi), fDiv(one, (2 as f64))) != 0) { k := k + 1; }
  if (fLt(fSub(kf, kfi), fNeg(fDiv(one, (2 as f64)))) != 0) { k := k - 1; }

  var r: f64 := fSub(x, fMul(k as f64, MATH_LN2));

  var r2: f64 := fMul(r, r);
  var r3: f64 := fMul(r2, r);
  var r4: f64 := fMul(r3, r);
  var r5: f64 := fMul(r4, r);
  var r6: f64 := fMul(r5, r);
  var r7: f64 := fMul(r6, r);
  var r8: f64 := fMul(r7, r);
  var r9: f64 := fMul(r8, r);
  var er: f64 := fAdd(fAdd(fAdd(fAdd(fAdd(fAdd(fAdd(fAdd(fAdd(
    one,
    r),
    fDiv(r2, (2 as f64))),
    fDiv(r3, (6 as f64))),
    fDiv(r4, (24 as f64))),
    fDiv(r5, (120 as f64))),
    fDiv(r6, (720 as f64))),
    fDiv(r7, (5040 as f64))),
    fDiv(r8, (40320 as f64))),
    fDiv(r9, (362880 as f64)));

  // mal 2^k, ueber wiederholtes Verdoppeln bzw. Halbieren
  //
  // #1536: Ohne Schranke lief diese Schleife bei grossen Argumenten
  // praktisch endlos — fuer x = 1e9 ist k rund 1,4 Milliarden. Das Ergebnis
  // steht laengst fest: oberhalb von 2^1024 ist es unendlich, unterhalb von
  // 2^-1075 null. Beides wird jetzt sofort geliefert, statt es zu erlaufen.
  if (k > 1024) { return fDiv((1 as f64), (0 as f64)); }        // +inf
  if (k < 0 - 1075) { return (0 as f64); }
  var res: f64 := er;
  var n: int64 := k;
  while (n > 0) { res := fMul(res, (2 as f64)); n := n - 1; }
  while (n < 0) { res := fDiv(res, (2 as f64)); n := n + 1; }
  return res;
}

// ln(x) = k*ln2 + ln(m) mit x = m * 2^k und m in [1, 2).
// Fuer m in diesem Bereich liegt y = (m-1)/(m+1) zwischen 0 und 1/3, und die
// arctanh-Reihe bis y^9 traegt unter 1e-11.
pub fn LogF64(x: f64): f64 {
  if (fLe(x, (0 as f64)) != 0) { return fNeg((1 as f64)); }  // undefiniert

  var one: f64 := (1 as f64);
  var two: f64 := (2 as f64);
  var m: f64 := x;
  var k: int64 := 0;
  while (fGe(m, two) != 0) { m := fDiv(m, two); k := k + 1; }
  while (fLt(m, one) != 0)  { m := fMul(m, two); k := k - 1; }

  var y: f64 := fDiv(fSub(m, one), fAdd(m, one));
  var y2: f64 := fMul(y, y);
  var y3: f64 := fMul(y2, y);
  var y5: f64 := fMul(y3, y2);
  var y7: f64 := fMul(y5, y2);
  var y9: f64 := fMul(y7, y2);
  var y11: f64 := fMul(y9, y2);
  var series: f64 := fAdd(fAdd(fAdd(fAdd(fAdd(
    y,
    fDiv(y3, (3 as f64))),
    fDiv(y5, (5 as f64))),
    fDiv(y7, (7 as f64))),
    fDiv(y9, (9 as f64))),
    fDiv(y11, (11 as f64)));

  return fAdd(fMul(k as f64, MATH_LN2), fMul(two, series));
}

pub fn Log10F64(x: f64): f64 {
  return fDiv(LogF64(x), MATH_LN10);
}

pub fn PowF64(base: f64, exp: f64): f64 {
  var one: f64 := (1 as f64);
  var zero: f64 := (0 as f64);
  if (fEq(exp, zero) != 0) { return one; }
  if (fEq(base, zero) != 0) { return zero; }

  // #1449: Ganzzahlige Exponenten ueber wiederholtes Quadrieren — das ist
  // exakt, waehrend exp(b*ln a) bei 2^10 schon in der letzten Stelle
  // abweicht. Und nur so ist eine negative Basis ueberhaupt behandelbar:
  // ln(-2) gibt es nicht.
  var ei: int64 := exp as int64;
  if (fEq(exp, ei as f64) != 0) {
    var neg: int64 := 0;
    var n: int64 := ei;
    if (n < 0) { neg := 1; n := 0 - n; }
    var acc: f64 := one;
    var b: f64 := base;
    while (n > 0) {
      if ((n % 2) == 1) { acc := fMul(acc, b); }
      b := fMul(b, b);
      n := n / 2;
    }
    if (neg == 1) { return fDiv(one, acc); }
    return acc;
  }

  if (fLt(base, zero) != 0) { return zero; }   // nicht ganzzahlig und negativ
  return ExpF64(fMul(exp, LogF64(base)));
}

// AtanF64: Arkustangens, Fehler < 1e-10.
// Zweistufige Argument-Reduktion auf |x| <= 0.5, dann 13-gliedrige Taylor-Reihe.
//   |x| > 1  → atan(x) = π/2 − atan(1/x)
//    x  > 0.5 → atan(x) = π/4 + atan((x−1)/(x+1))
pub fn AtanF64(x: f64): f64 {
  var QPI: f64 := fDiv((7853981633974483 as f64), (10000000000000000 as f64));
  var HPI: f64 := fMul(QPI, (2 as f64));
  var neg: int64 := 0;
  var flip: int64 := 0;
  var red: int64 := 0;
  if (fLt(x, (0 as f64))) { x := fNeg(x); neg := 1; }
  if (fGt(x, (1 as f64))) { x := fDiv((1 as f64), x); flip := 1; }
  if (fGt(x, fDiv((1 as f64), (2 as f64)))) {
    x := fDiv(fAdd(x, fNeg((1 as f64))), fAdd(x, (1 as f64)));
    red := 1;
  }
  var x2: f64 := fMul(x, x);
  var xn: f64 := x;
  var r:  f64 := x;
  var k: int64 := 1;
  while (k <= 12) {
    xn := fMul(xn, x2);
    var dn: f64 := ((k * 2 + 1) as f64);
    if (k % 2 == 0) { r := fAdd(r, fDiv(xn, dn)); }
    else            { r := fAdd(r, fNeg(fDiv(xn, dn))); }
    k += 1;
  }
  if (red  != 0) { r := fAdd(QPI, r); }
  if (flip != 0) { r := fAdd(HPI, fNeg(r)); }
  if (neg  != 0) { r := fNeg(r); }
  return r;
}

// Atan2F64: Quadranten-korrekter Arkustangens von (y, x).
// #1577: Vorzeichenbit einer f64 — OHNE Speicher und OHNE Import.
//
// Zwei Wege schieden aus: std.feq (FeqSignBit) importiert selbst std.math, ein
// Import zurueck waere ein Zyklus — er meldet sich als "undefined function
// 'AbsF64'" mitten in feq und nennt die Ursache nicht. Und ein alloc-Puffer
// haette std.math von std.alloc abhaengig gemacht; diese Unit kam bisher ohne
// jeden Import aus, und die erste Fassung brach prompt 24 Programme, die
// std.math ohne std.alloc benutzen.
//
// Also die Rechnung selbst: 1/(-0) ist minus unendlich, 1/(+0) plus unendlich.
// Fuer alles andere genuegt der Vergleich.
fn mathSignBit(x: f64): bool {
  if (fEq(x, (0 as f64))) { return fLt(fDiv((1 as f64), x), (0 as f64)); }
  return fLt(x, (0 as f64));
}

// #1577: Das VORZEICHEN einer Null zaehlt. Bis 1.1.0A pruefte diese Funktion
// nur mit `fEq`/`fGe` gegen 0 — und -0.0 ist gleich +0.0. Auf der negativen
// reellen Achse kam damit die falsche Halbebene heraus: atan2(-0, -1) lieferte
// +pi statt -pi, atan2(-0, +1) lieferte +0.0 statt -0.0. Still, denn das
// Ergebnis ist eine plausible Zahl mit falschem Vorzeichen — und PrintFloat
// zeigt das Vorzeichen einer Null ohnehin nicht.
//
// Die Faelle stehen in C99 F.10.1.4 und werden hier der Reihe nach behandelt.
// Massgeblich ist das Vorzeichenbit (FeqSignBit), nicht der Vergleich.
pub fn Atan2F64(y: f64, x: f64): f64 {
  var QPI: f64 := fDiv((7853981633974483 as f64), (10000000000000000 as f64));
  var HPI: f64 := fMul(QPI, (2 as f64));
  var PI:  f64 := fMul(QPI, (4 as f64));
  var yNeg: bool := mathSignBit(y);
  var xNeg: bool := mathSignBit(x);
  var yNull: bool := fEq(y, (0 as f64));
  var xNull: bool := fEq(x, (0 as f64));

  // y = +-0
  if (yNull) {
    if (xNull) {
      // atan2(+-0, +0) = +-0 ; atan2(+-0, -0) = +-pi
      if (xNeg) { if (yNeg) { return fNeg(PI); } return PI; }
      if (yNeg) { return fNeg((0 as f64)); }
      return (0 as f64);
    }
    if (xNeg) { if (yNeg) { return fNeg(PI); } return PI; }
    if (yNeg) { return fNeg((0 as f64)); }
    return (0 as f64);
  }

  // x = +-0, y != 0: +-pi/2 nach dem Vorzeichen von y
  if (xNull) {
    if (yNeg) { return fNeg(HPI); }
    return HPI;
  }

  var r: f64 := AtanF64(fDiv(y, x));
  if (!xNeg) { return r; }
  // Linke Halbebene: um +-pi verschieben, Richtung nach dem Vorzeichen von y
  if (yNeg) { return fAdd(r, fNeg(PI)); }
  return fAdd(r, PI);
}

// AsinF64: Arkussinus via asin(x) = atan(x / sqrt(1 − x²))
pub fn AsinF64(x: f64): f64 {
  var inner: f64 := SqrtF64(fAdd((1 as f64), fNeg(fMul(x, x))));
  return AtanF64(fDiv(x, inner));
}

// AcosF64: Arkuskosinus via acos(x) = π/2 − asin(x)
pub fn AcosF64(x: f64): f64 {
  var QPI: f64 := fDiv((7853981633974483 as f64), (10000000000000000 as f64));
  return fAdd(fMul(QPI, (2 as f64)), fNeg(AsinF64(x)));
}

// Log2F64: Logarithmus zur Basis 2.
// Argument-Reduktion auf [1,2] via Halbierung/Verdopplung, dann ln(m)/ln(2).
pub fn Log2F64(x: f64): f64 {
  var two:  f64 := (2 as f64);
  var half: f64 := fDiv((1 as f64), two);
  var ln2:  f64 := LogF64(two);
  var k: int64 := 0;
  while (fGe(x, two)) { x := fMul(x, half); k := k + 1; }
  while (fLt(x, (1 as f64))) { x := fMul(x, two); k := k - 1; }
  return fAdd((k as f64), fDiv(LogF64(x), ln2));
}
