// Integer Square Root (alias for Sqrt64)
public fn IntSqrt(n: int64): int64 {
  return Sqrt64(n);
}

// Atan2 in microdegrees: returns angle in microdegrees (-180000000 to 180000000)
// #1447: Das Verhaeltnis wurde mit 1e6 gerechnet und dann mit `(ratio * 45) /
// 100000` in Mikrograd gewandelt — fuer ratio = 1e6 (also 45 Grad) ergab das
// 450 statt 45000000, Faktor 100000 zu klein. Die Quadrantenkorrektur setzte
// darauf auf, also landete praktisch jedes Ergebnis bei 0 oder 90 Grad.
//
// Jetzt: atan(t) fuer t in [0,1] ueber die Naeherung von Sun/Rajan
//   atan(t) ~ (pi/4)*t - t*(|t|-1)*(0,2447 + 0,0663*|t|)
// in Festkomma. Ihr Fehler liegt unter 0,01 Grad — das reicht fuer alles,
// was diese Unit sonst rechnet, und braucht keine Tabelle.
fn _atanEinheit(t_mikro: int64): int64 {
  // t_mikro ist t * 1e6 mit 0 <= t <= 1e6; Rueckgabe in Mikrograd.
  var t: int64 := t_mikro;
  var einsMinus: int64 := t - 1000000;                       // (t - 1)
  var klammer: int64 := 244700 + (66300 * t) / 1000000;      // 0,2447 + 0,0663 t
  var korrektur: int64 := (t * einsMinus) / 1000000;         // t*(t-1)
  korrektur := (korrektur * klammer) / 1000000;
  // (pi/4)*t in Bogenmass, dann nach Grad: t * 45 Grad
  var grad: int64 := (t * 45000000) / 1000000;
  // Die Korrektur steht in Bogenmass; ein Bogenmass sind 57295780 Mikrograd.
  var korrGrad: int64 := (korrektur * 57295780) / 1000000;
  return grad - korrGrad;
}

public fn Atan2Microdegrees(y: int64, x: int64): int64 {
  if (x == 0) {
    if (y > 0) { return 90000000; }
    if (y < 0) { return 0 - 90000000; }
    return 0;
  }

  var ay: int64 := Abs64(y);
  var ax: int64 := Abs64(x);
  var angle: int64 := 0;

  if (ax >= ay) {
    var t1: int64 := (ay * 1000000) / ax;
    angle := _atanEinheit(t1);
  } else {
    var t2: int64 := (ax * 1000000) / ay;
    angle := 90000000 - _atanEinheit(t2);
  }

  if (x < 0) {
    if (y >= 0) { angle := 180000000 - angle; }
    else { angle := 0 - (180000000 - angle); }
  } else {
    if (y < 0) { angle := 0 - angle; }
  }
  return angle;
}

// Inverse Cosine (returns angle in microdegrees)
// Input: value in fixed-point (-1000000 to 1000000)
public fn Cos64Inverse(cos_value: int64): int64 {
  if (cos_value > 1000000) { cos_value := 1000000; }
  if (cos_value < -1000000) { cos_value := -1000000; }
  
  // Simplified: use lookup approximation
  // For small angles, acos(x) ≈ π/2 - x
  // This is a simplified implementation
  var abs_cos: int64 := Abs64(cos_value);
  
  if (abs_cos >= 999990) {
    if (cos_value >= 0) { return 0; }
    return 180000000;
  }
  
  // Binary search approximation
  var lo: int64 := 0;
  var hi: int64 := 180000000;
  
  var i: int64 := 0;
  while (i < 30) {
    var lohi: int64 := lo + hi;
    var mid: int64 := lohi / 2;
    var cos_mid: int64 := Cos64(mid);
    if (cos_mid < cos_value) {
      hi := mid;
    } else {
      lo := mid;
    }
    i += 1;
  }

  var lohif: int64 := lo + hi;
  return lohif / 2;
}

