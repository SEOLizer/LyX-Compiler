unit std.math;

public fn Abs64(x: int64): int64 {
  if (x < 0) {
    return -x;
  }
  return x;
}

public fn Min64(a: int64, b: int64): int64 {
  if (a < b) { return a; }
  return b;
}

public fn Max64(a: int64, b: int64): int64 {
  if (a > b) { return a; }
  return b;
}

public fn Div64(a: int64, b: int64): int64 {
  // ganzzahlige Division (signed). Verhalten bei Division durch 0 ist nicht definiert;
  // aufgerufen sollte geprüft werden, oder caller kann exit(1) verwenden.
  return a / b;
}

public fn Mod64(a: int64, b: int64): int64 {
  return a % b;
}

// Convenience
public fn TimesTwo(x: int64): int64 {
  return x * 2;
}

// ============================================================
// Pseudozufallszahlen
// ============================================================
// Random() und RandomSeed() sind Builtins (siehe sema.pas/x86_64_emit.pas)
// Hier nur die Convenience-Funktionen:

// Gibt eine Pseudozufallszahl im Bereich [0, max) zurück
// #1446: `Random()` liefert einen vollen int64 und ist in der Haelfte der
// Faelle negativ; `%` uebernimmt in Lyx das Vorzeichen des Dividenden. Damit
// verliess die Funktion den zugesagten Bereich [0, max) — und der Aufrufer
// bekam einen negativen Index, ohne dass etwas darauf hinwies.
//
// Der Betrag wird deshalb vor der Restrechnung gebildet. int64-Minimum hat
// keinen positiven Betrag und wird gesondert behandelt.
public fn RandomRange(max: int64): int64 {
  if (max <= 0) {
    return 0;
  }
  var r: int64 := Random();
  if (r == 0 - 9223372036854775807 - 1) { r := 0; }
  if (r < 0) { r := 0 - r; }
  return r % max;
}

// Gibt eine Pseudozufallszahl im Bereich [min, max] zurück
public fn RandomBetween(min: int64, max: int64): int64 {
  if (max <= min) {
    return min;
  }
  return min + RandomRange(max - min + 1);
}

// ============================================================
// Integer Mathematik
// ============================================================

// Ganzzahlige Quadratwurzel (Newton-Verfahren)
// Berechnet floor(sqrt(n)) für int64
public fn Sqrt64(n: int64): int64 {
  if (n < 0) { return 0; }
  if (n < 2) { return n; }
  
  var x: int64 := n;
  var xp1: int64 := x + 1;
  var y: int64 := xp1 / 2;
  while (y < x) {
    x := y;
    var nx: int64 := n / x;
    var xnx: int64 := x + nx;
    y := xnx / 2;
  }
  return x;
}

// Begrenzt einen Wert innerhalb von min und max
public fn Clamp64(val: int64, min: int64, max: int64): int64 {
  if (val < min) { return min; }
  if (val > max) { return max; }
  return val;
}

// Vorzeichen-Funktion: gibt -1, 0 oder 1 zurück
public fn Sign64(x: int64): int64 {
  if (x < 0) { return -1; }
  if (x > 0) { return 1; }
  return 0;
}

// Potenz-Funktion: base^exp (für nicht-negative Exponenten)
public fn Pow64(base: int64, exp: int64): int64 {
  if (exp < 0) { return 0; }
  if (exp == 0) { return 1; }
  
  var result: int64 := 1;
  var i: int64 := 0;
  while (i < exp) {
    result := result * base;
    i += 1;
  }
  return result;
}

// Minimum von drei Werten
public fn Min3(a: int64, b: int64, c: int64): int64 {
  var min: int64 := a;
  if (b < min) { min := b; }
  if (c < min) { min := c; }
  return min;
}

// Maximum von drei Werten
public fn Max3(a: int64, b: int64, c: int64): int64 {
  var max: int64 := a;
  if (b > max) { max := b; }
  if (c > max) { max := c; }
  return max;
}

// Prüft ob Wert im Bereich [min, max] liegt
public fn InRange64(val: int64, min: int64, max: int64): bool {
  return (val >= min) && (val <= max);
}

// #1450: Hier stand `return x;` unter dem Kommentar "rundet auf naechste
// Ganzzahl" — der Parameter ist bereits ganzzahlig, es gab nichts zu runden.
// Am Aufrufort las sich `Round64(v)` wie eine Rundung und war ein No-op.
//
// Was gemeint war, ist die Rundung eines FESTKOMMA-Wertes. Die Funktion nimmt
// deshalb den Wert samt seinem Nenner und rundet kaufmaennisch (bei genau der
// Haelfte weg von null), wie der alte Kommentar es zusagte.
public fn Round64Fixed(wert: int64, nenner: int64): int64 {
  if (nenner <= 0) { return wert; }
  if (wert >= 0) { return (wert + nenner / 2) / nenner; }
  return 0 - ((0 - wert + nenner / 2) / nenner);
}

// ============================================================
// Fixed-Point Interpolation & Mapping
// ============================================================

// Lineare Interpolation: t ist 0 bis 1000 (repräsentiert 0.0 bis 1.0)
// Beispiel: Lerp64(100, 200, 500) = 150 (50%)
public fn Lerp64(a: int64, b: int64, t_permille: int64): int64 {
  if (t_permille <= 0) { return a; }
  if (t_permille >= 1000) { return b; }
  return a + (b - a) * t_permille / 1000;
}

// Überträgt einen Wert von einem Bereich in einen anderen
// Beispiel: Map64(512, 0, 1023, 0, 100) = 50
public fn Map64(val: int64, in_min: int64, in_max: int64, out_min: int64, out_max: int64): int64 {
  if (in_max == in_min) { return out_min; }
  return (val - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
}

// ============================================================
// Pythagoras & Distanz
// ============================================================

// Berechnet sqrt(x^2 + y^2) mit Überlaufschutz
// Verwendet: wenn |x| > |y|, dann sqrt(x^2 + y^2) = |x| * sqrt(1 + (y/x)^2)
// #1445: Hier stand die Naeherung `x + y*y/(2x)`, aber mit einem Verhaeltnis,
// das um 1000 hochskaliert und nie wieder heruntergeteilt wurde: Hypot64(3,4)
// ergab 285 statt 5. Die Naeherung selbst ist ausserdem nur fuer y << x gut.
//
// Jetzt wird exakt gerechnet: Sqrt64(x*x + y*y), mit dem Ausweichweg fuer
// grosse Werte, den die Naeherung eigentlich abdecken sollte — sonst laeuft
// das Quadrat ueber.
public fn Hypot64(x: int64, y: int64): int64 {
  x := Abs64(x);
  y := Abs64(y);
  if (x == 0) { return y; }
  if (y == 0) { return x; }
  if (y > x) {
    var tmp: int64 := x;
    x := y;
    y := tmp;
  }
  // x*x darf nicht ueberlaufen: ab etwa 2^31,5 wird skaliert gerechnet.
  if (x <= 2147483647) {
    return Sqrt64(x * x + y * y);
  }
  // Grosse Werte: beide Seiten um 2^16 verkleinern, Ergebnis zurueckskalieren.
  var xs: int64 := x / 65536;
  var ys: int64 := y / 65536;
  if (xs == 0) { return x; }
  return Sqrt64(xs * xs + ys * ys) * 65536;
}

