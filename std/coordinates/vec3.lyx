// std/coordinates/vec3.lyx — Dreidimensionale Vektoren in f64
//
// Die Lücke, die diese Unit füllt: `std/vector.lyx` führt `Vec2` mit `int64` —
// gut für Bildschirmkoordinaten, untauglich für alles Physikalische. `std/quat`
// erzeugt Drehungen, hat aber keinen Vektortyp, auf den es sie anwenden
// könnte. Und jede Rechnung mit Kräften, Geschwindigkeiten oder Positionen im
// Raum braucht drei Komponenten in Gleitkomma.
//
// WAS HIER DIE FALLEN SIND:
//
//   * DAS KREUZPRODUKT IST NICHT KOMMUTATIV. a×b = −(b×a). Wer die Reihenfolge
//     vertauscht, bekommt ein Drehmoment, das in die falsche Richtung zeigt —
//     und das fällt an einem symmetrischen Aufbau nicht auf.
//
//   * NORMIEREN EINES NULLVEKTORS IST UNDEFINIERT. Nicht "ergibt den
//     Nullvektor": die Richtung eines Vektors der Länge null existiert nicht.
//     `V3Normalize` liefert deshalb Fehlerwerte und keine stille Null.
//
//   * DER WINKEL ÜBER acos(a·b/(|a||b|)) IST BEI FAST PARALLELEN VEKTOREN
//     UNGENAU. Das Argument liegt dann dicht an ±1, wo der Arkuskosinus
//     senkrecht verläuft; kleine Rundungsfehler werden zu großen
//     Winkelfehlern. `V3Angle` rechnet deshalb über atan2 von Kreuz- und
//     Skalarprodukt — dieselbe Zahl, aber über den ganzen Bereich stabil.

unit std.coordinates.vec3;

import std.math;

pub type V3 = struct {
  x: f64;
  y: f64;
  z: f64;
}

// ── Fehlerwert ─────────────────────────────────────────────────────────────

pub fn V3ErrorValue(): f64 {
  var nix: f64 := 0.0;
  return nix / nix;
}

pub fn V3IsErrorValue(x: f64): bool { return x != x; }

pub fn V3Error(): V3 {
  var e: f64 := V3ErrorValue();
  return V3New(e, e, e);
}

pub fn V3IsError(v: V3): bool {
  return V3IsErrorValue(v.x) || V3IsErrorValue(v.y) || V3IsErrorValue(v.z);
}

// ── Erzeugen ───────────────────────────────────────────────────────────────

pub fn V3New(x: f64, y: f64, z: f64): V3 {
  var v: V3;
  v.x := x;
  v.y := y;
  v.z := z;
  return v;
}

pub fn V3Zero(): V3 { return V3New(0.0, 0.0, 0.0); }
pub fn V3UnitX(): V3 { return V3New(1.0, 0.0, 0.0); }
pub fn V3UnitY(): V3 { return V3New(0.0, 1.0, 0.0); }
pub fn V3UnitZ(): V3 { return V3New(0.0, 0.0, 1.0); }

// ── Grundrechenarten ───────────────────────────────────────────────────────

pub fn V3Add(a: V3, b: V3): V3 {
  return V3New(a.x + b.x, a.y + b.y, a.z + b.z);
}

pub fn V3Sub(a: V3, b: V3): V3 {
  return V3New(a.x - b.x, a.y - b.y, a.z - b.z);
}

pub fn V3Scale(v: V3, s: f64): V3 {
  return V3New(v.x * s, v.y * s, v.z * s);
}

pub fn V3Neg(v: V3): V3 { return V3New(0.0 - v.x, 0.0 - v.y, 0.0 - v.z); }

// Skalarprodukt — eine ZAHL, kein Vektor.
pub fn V3Dot(a: V3, b: V3): f64 {
  return a.x * b.x + a.y * b.y + a.z * b.z;
}

// Kreuzprodukt — ein VEKTOR, senkrecht auf beiden. Die Reihenfolge entscheidet
// über das Vorzeichen: a×b = −(b×a).
pub fn V3Cross(a: V3, b: V3): V3 {
  return V3New(a.y * b.z - a.z * b.y,
               a.z * b.x - a.x * b.z,
               a.x * b.y - a.y * b.x);
}

// ── Länge und Richtung ─────────────────────────────────────────────────────

// Quadrat der Länge — ohne Wurzel, für Vergleiche.
pub fn V3Norm2(v: V3): f64 { return V3Dot(v, v); }

pub fn V3Norm(v: V3): f64 { return SqrtF64(V3Norm2(v)); }

// Einheitsvektor. Der Nullvektor hat KEINE Richtung — deshalb der Fehlerwert
// und nicht der Nullvektor, der wie ein Ergebnis aussähe.
pub fn V3Normalize(v: V3): V3 {
  var n: f64 := V3Norm(v);
  if (n == 0.0) { return V3Error(); }
  return V3Scale(v, 1.0 / n);
}

pub fn V3Distance(a: V3, b: V3): f64 { return V3Norm(V3Sub(a, b)); }

// Winkel zwischen zwei Vektoren im Bogenmaß.
//
// Über atan2(|a×b|, a·b) und NICHT über acos(a·b/(|a||b|)): der Arkuskosinus
// verläuft bei fast parallelen Vektoren senkrecht, dort werden aus winzigen
// Rundungsfehlern große Winkelfehler. Die atan2-Form ist über den ganzen
// Bereich gleich genau.
pub fn V3Angle(a: V3, b: V3): f64 {
  var na: f64 := V3Norm(a);
  var nb: f64 := V3Norm(b);
  if (na == 0.0 || nb == 0.0) { return V3ErrorValue(); }
  var kreuz: f64 := V3Norm(V3Cross(a, b));
  return Atan2F64(kreuz, V3Dot(a, b));
}

// Projektion von a auf b — der Anteil von a, der in Richtung b zeigt.
pub fn V3Project(a: V3, b: V3): V3 {
  var n2: f64 := V3Norm2(b);
  if (n2 == 0.0) { return V3Error(); }
  return V3Scale(b, V3Dot(a, b) / n2);
}

// Der Rest: der Anteil von a SENKRECHT zu b.
pub fn V3Reject(a: V3, b: V3): V3 {
  var p: V3 := V3Project(a, b);
  if (V3IsError(p)) { return p; }
  return V3Sub(a, p);
}

// Lineare Interpolation. t = 0 liefert a, t = 1 liefert b.
pub fn V3Lerp(a: V3, b: V3, t: f64): V3 {
  return V3Add(a, V3Scale(V3Sub(b, a), t));
}

// Spatprodukt a·(b×c) — das mit Vorzeichen versehene Volumen des von den drei
// Vektoren aufgespannten Parallelepipeds. Null heisst: sie liegen in einer
// Ebene.
pub fn V3Triple(a: V3, b: V3, c: V3): f64 {
  return V3Dot(a, V3Cross(b, c));
}
