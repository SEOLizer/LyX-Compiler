// std/coordinates/transform.lyx — kartesisch, zylindrisch, sphärisch
//
// WAS HIER DIE FALLEN SIND — beide kosten regelmäßig Stunden:
//
//   * ES GIBT ZWEI KONVENTIONEN FÜR DEN ZWEITEN WINKEL, und sie unterscheiden
//     sich um 90°. Die Physik zählt den POLARWINKEL θ von der z-Achse nach
//     unten (0 am Nordpol, π/2 am Äquator). Geodäsie und Astronomie zählen die
//     ELEVATION von der xy-Ebene nach oben (0 am Äquator, π/2 am Nordpol). Wer
//     sie verwechselt, bekommt sin und cos vertauscht — und das Ergebnis sieht
//     bis auf die Werte völlig richtig aus.
//
//     Deshalb steht die Konvention hier IM NAMEN: `SphPolar` für den
//     Polarwinkel, `SphElev` für die Elevation. Eine Funktion, die einfach
//     `ToSpherical` hiesse, wäre die Einladung zum Fehler.
//
//   * DIE POLACHSE IST SINGULÄR. Auf ihr ist der Azimut nicht null, sondern
//     UNBESTIMMT: jeder Wert beschreibt denselben Punkt. Die Rückrechnung
//     liefert dort deshalb 0 als Vereinbarung — der Kommentar sagt das, damit
//     niemand daraus schliesst, die Richtung sei bekannt. Wer eine Bahn über
//     den Pol interpoliert, bekommt an genau dieser Stelle einen Sprung, den
//     keine Formel wegrechnet.
//
//   * atan2 UND NICHT atan(y/x). Letzteres verliert den Quadranten: aus einem
//     Punkt im dritten Quadranten wird einer im ersten. Alle Rückrechnungen
//     hier benutzen atan2.

unit std.coordinates.transform;

import std.math;
import std.coordinates.vec3;

// ── Zylinderkoordinaten (r, phi, z) ────────────────────────────────────────
//
// r  Abstand von der z-Achse (nie negativ)
// phi Azimut in der xy-Ebene, von der x-Achse aus, im Bogenmaß
// z  Höhe, unverändert

pub type Cyl = struct {
  r:   f64;
  phi: f64;
  z:   f64;
}

pub fn CylNew(r: f64, phi: f64, z: f64): Cyl {
  var c: Cyl;
  c.r := r;
  c.phi := phi;
  c.z := z;
  return c;
}

pub fn CylToCart(c: Cyl): V3 {
  return V3New(c.r * CosF64(c.phi), c.r * SinF64(c.phi), c.z);
}

pub fn CartToCyl(v: V3): Cyl {
  var r: f64 := SqrtF64(v.x * v.x + v.y * v.y);
  // Auf der z-Achse ist der Azimut unbestimmt; 0 ist Vereinbarung, keine
  // Aussage über die Richtung.
  var phi: f64 := 0.0;
  if (r != 0.0) { phi := Atan2F64(v.y, v.x); }
  return CylNew(r, phi, v.z);
}

// ── Kugelkoordinaten, POLARWINKEL-Konvention (r, theta, phi) ───────────────
//
// theta wird von der z-ACHSE gezählt: 0 am Nordpol, π/2 am Äquator, π am
// Südpol. Das ist die Konvention der Physik (ISO 80000-2).

pub type SphPolar = struct {
  r:     f64;
  theta: f64;
  phi:   f64;
}

pub fn SphPolarNew(r: f64, theta: f64, phi: f64): SphPolar {
  var s: SphPolar;
  s.r := r;
  s.theta := theta;
  s.phi := phi;
  return s;
}

pub fn SphPolarToCart(s: SphPolar): V3 {
  var st: f64 := SinF64(s.theta);
  return V3New(s.r * st * CosF64(s.phi),
               s.r * st * SinF64(s.phi),
               s.r * CosF64(s.theta));
}

pub fn CartToSphPolar(v: V3): SphPolar {
  var r: f64 := V3Norm(v);
  if (r == 0.0) { return SphPolarNew(0.0, 0.0, 0.0); }
  // theta über atan2(√(x²+y²), z) statt acos(z/r): bei Punkten nahe der
  // Polachse ist das Argument des Arkuskosinus dicht an ±1, wo er senkrecht
  // verläuft — dort werden Rundungsfehler zu Winkelfehlern.
  var rho: f64 := SqrtF64(v.x * v.x + v.y * v.y);
  var theta: f64 := Atan2F64(rho, v.z);
  var phi: f64 := 0.0;
  if (rho != 0.0) { phi := Atan2F64(v.y, v.x); }
  return SphPolarNew(r, theta, phi);
}

// ── Kugelkoordinaten, ELEVATIONS-Konvention (r, elev, azim) ────────────────
//
// elev wird von der xy-EBENE gezählt: 0 am Äquator, +π/2 am Nordpol, −π/2 am
// Südpol. Das ist die Konvention der Geodäsie, der Astronomie und jedes
// Horizontsystems — und sie ist gegenüber theta um 90° verschoben:
//
//     elev = π/2 − theta
//
// Beide Formen stehen hier nebeneinander, damit niemand sie im Kopf umrechnen
// muss. Genau dabei geht es schief.

pub type SphElev = struct {
  r:    f64;
  elev: f64;
  azim: f64;
}

pub fn SphElevNew(r: f64, elev: f64, azim: f64): SphElev {
  var s: SphElev;
  s.r := r;
  s.elev := elev;
  s.azim := azim;
  return s;
}

pub fn SphElevToCart(s: SphElev): V3 {
  var ce: f64 := CosF64(s.elev);
  return V3New(s.r * ce * CosF64(s.azim),
               s.r * ce * SinF64(s.azim),
               s.r * SinF64(s.elev));
}

pub fn CartToSphElev(v: V3): SphElev {
  var r: f64 := V3Norm(v);
  if (r == 0.0) { return SphElevNew(0.0, 0.0, 0.0); }
  var rho: f64 := SqrtF64(v.x * v.x + v.y * v.y);
  var elev: f64 := Atan2F64(v.z, rho);
  var azim: f64 := 0.0;
  if (rho != 0.0) { azim := Atan2F64(v.y, v.x); }
  return SphElevNew(r, elev, azim);
}

// ── Zwischen den beiden Konventionen ───────────────────────────────────────
//
// Die Funktionen, die den 90°-Versatz EINMAL an einer Stelle erledigen,
// statt ihn an jeder Aufrufstelle neu hinzuschreiben.

pub fn SphPolarToElev(s: SphPolar): SphElev {
  return SphElevNew(s.r, Pi() / 2.0 - s.theta, s.phi);
}

pub fn SphElevToPolar(s: SphElev): SphPolar {
  return SphPolarNew(s.r, Pi() / 2.0 - s.elev, s.azim);
}

// ── Winkelmaße ─────────────────────────────────────────────────────────────

pub fn DegToRad(deg: f64): f64 { return deg * Pi() / 180.0; }
pub fn RadToDeg(rad: f64): f64 { return rad * 180.0 / Pi(); }
