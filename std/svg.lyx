// std/svg.lyx
// SVG library public API — 11 sub-units for writing, styling, and reading SVG

@description("SVG library: create, style and save SVG documents; parse SVG files")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, fs.write])
unit std.svg;

import std.svg.xml;
import std.svg.builder;
import std.svg.style;
import std.svg.elements;
import std.svg.path;
import std.svg.text;
import std.svg.defs;
import std.svg.filter;
import std.svg.image;
import std.svg.anim;
import std.svg.parser;

// All public symbols are re-exported from the sub-units:
//
// From std.svg.builder:
//   SvgNew(width, height: f64)                    → int64  (doc handle)
//   SvgSetViewBox(doc, x, y, w, h: f64)
//   SvgSetPrettyPrint(doc, enabled: int64)
//   SvgToString(doc)                              → pchar  (NUL-terminated SVG)
//   SvgSave(doc, path: pchar)                     → int64  (0 = OK)
//   SvgFree(doc)
//
// From std.svg.style:
//   SVG_CAP_BUTT/ROUND/SQUARE, SVG_JOIN_MITER/ROUND/BEVEL  (int64 constants)
//   SVG_FILL_NONZERO, SVG_FILL_EVENODD
//   SvgSetFill(doc, r, g, b: f64)
//   SvgSetFillAlpha(doc, r, g, b, a: f64)
//   SvgSetFillHex(doc, hex: pchar)
//   SvgSetFillNone(doc)
//   SvgSetStroke(doc, r, g, b: f64)
//   SvgSetStrokeNone(doc)
//   SvgSetStrokeWidth(doc, w: f64)
//   SvgSetOpacity(doc, a: f64)
//   SvgSetLineCap(doc, cap: int64)
//   SvgSetLineJoin(doc, join: int64)
//   SvgSetMiterLimit(doc, limit: f64)
//   SvgSetDashArray(doc, pattern: pchar)
//   SvgSetDashOffset(doc, offset: f64)
//   SvgSetDashArrayN(doc, dashes, n: int64)
//   SvgTranslate(doc, tx, ty: f64)
//   SvgScale(doc, sx, sy: f64)
//   SvgRotate(doc, angle: f64)
//   SvgRotateAround(doc, angle, cx, cy: f64)
//   SvgSkewX(doc, angle: f64)
//   SvgSkewY(doc, angle: f64)
//   SvgMatrixABCD(doc, a, b, c, d: f64)
//   SvgMatrix(doc, e, f: f64)
//
// From std.svg.elements:
//   SvgRect(doc, x, y, w, h: f64)
//   SvgRoundRect(doc, x, y, w, h: f64)           uses SvgSetRounding
//   SvgSetRounding(doc, rx, ry: f64)
//   SvgCircle(doc, cx, cy, r: f64)
//   SvgEllipse(doc, cx, cy, rx, ry: f64)
//   SvgLine(doc, x1, y1, x2, y2: f64)
//   SvgPolyline(doc, points: pchar)
//   SvgPolygon(doc, points: pchar)
//   SvgPolylineN(doc, xs, ys, n: int64)
//   SvgPolygonN(doc, xs, ys, n: int64)
//   SvgApply(doc)                                 — flush pending element
//   SvgGroupBegin(doc)                            → int64  (group handle)
//   SvgGroupBeginId(doc, id: pchar)               → int64
//   SvgGroupEnd(doc)
//   SvgSetId(doc, elem, id: pchar)
//   SvgSetClass(doc, elem, cls: pchar)
//   SvgSetVisible(doc, elem, visible: int64)
//   SvgSetFillGradient(doc, gradId: int64)
//   SvgSetStrokeGradient(doc, gradId: int64)
//   SvgSetFilter(doc, filterId: int64)
//   SvgSetClipPath(doc, clipId: int64)
//   SvgSetMask(doc, maskId: int64)
//   SvgSetMarkerEnd(doc, markerId: int64)
//   SvgSetMarkerStart(doc, markerId: int64)
//
// From std.svg.path:
//   SvgPathBegin(doc)
//   SvgPathBeginId(doc, id: pchar)
//   SvgClosePath(doc)
//   SvgApplyHidden(doc)                           — invisible path for text-on-path
//   SvgSetFillRule(doc, rule: int64)
//   SvgMoveTo(doc, x, y: f64)
//   SvgLineTo(doc, x, y: f64)
//   SvgHLineTo(doc, x: f64)
//   SvgVLineTo(doc, y: f64)
//   SvgCurveSetCP(doc, x1, y1, x2, y2: f64)
//   SvgCurveTo(doc, x, y: f64)
//   SvgCurveTo2(doc, x, y: f64)
//   SvgSmoothCurveSetCP(doc, x2, y2: f64)
//   SvgSmoothCurveTo(doc, x, y: f64)
//   SvgQuadSetCP(doc, x1, y1: f64)
//   SvgQuadTo(doc, x, y: f64)
//   SvgSmoothQuadTo(doc, x, y: f64)
//   SvgArcSetup(doc, rx, ry, rot: f64)
//   SvgArcFlags(doc, laf, sf: int64)
//   SvgArcTo(doc, x, y: f64)
//   SvgMoveToRel/SvgLineToRel/SvgHLineToRel/SvgVLineToRel/SvgCurveToRel/SvgArcToRel
//   SvgPathArc(doc, cx, cy, r, startDeg, endDeg: f64)
//   SvgPathPieSlice(doc, cx, cy, r, startDeg, endDeg: f64)
//   SvgPathStar(doc, cx, cy, r1, r2: f64, n: int64)
//   SvgPathArrow(doc, x1, y1, x2, y2, headLen: f64)
//
// From std.svg.text:
//   SVG_ANCHOR_START/MIDDLE/END, SVG_WEIGHT_NORMAL/BOLD  (int64 constants)
//   SVG_STYLE_NORMAL/ITALIC, SVG_DECO_NONE/UNDERLINE/STRIKE/OVERLINE
//   SVG_BASELINE_AUTO/MIDDLE/HANGING
//   SvgSetFont(doc, family: pchar, size: f64)
//   SvgSetFontWeight(doc, weight: int64)
//   SvgSetFontStyle(doc, style: int64)
//   SvgSetTextAnchor(doc, anchor: int64)
//   SvgSetDominantBaseline(doc, baseline: int64)
//   SvgSetLetterSpacing(doc, spacing: f64)
//   SvgSetWordSpacing(doc, spacing: f64)
//   SvgSetTextDecoration(doc, deco: int64)
//   SvgTextAt(doc, x, y: f64, text: pchar)
//   SvgTextBegin(doc, x, y: f64)                 → int64  (text handle)
//   SvgTspan(doc, text: pchar, dx, dy: f64)
//   SvgTspanStyle(doc, text: pchar, weight: int64, dx, dy: f64)
//   SvgTextEnd(doc)
//   SvgTextOnPath(doc, pathId, text: pchar, offset: f64)
//
// From std.svg.defs:
//   SVG_SPREAD_PAD/REFLECT/REPEAT  (int64 constants)
//   SvgLinearGradient(doc, id: pchar, x1, y1, x2, y2: f64) → int64 (gradId)
//   SvgGradientStop(doc, gid, offset, r, g, b: f64)
//   SvgGradientStopA(doc, gid, offset, hex, a: f64)
//   SvgGradientEnd(doc, gid: int64)
//   SvgGradientSpread(doc, gid, spread: int64)
//   SvgGradientUserSpace(doc, gid: int64)
//   SvgGradientRotate(doc, gid: int64, angle: f64)
//   SvgRadialGradient(doc, id: pchar, cx, cy, r: f64)       → int64 (gradId)
//   SvgGradientFocus(doc, fx, fy: f64)
//   SvgRadialGradientEnd(doc, gid: int64)
//   SvgPatternBegin(doc, id: pchar, x, y, w, h: f64)        → int64 (patId)
//   SvgPatternEnd(doc)
//   SvgSetFillPattern(doc, patId: int64)
//   SvgSymbolBegin(doc, id: pchar, vw, vh: f64)             → int64 (symId)
//   SvgSymbolEnd(doc)
//   SvgUse(doc, id: pchar, x, y, w, h: f64)
//   SvgMarkerBegin(doc, id: pchar, mw, mh, rx, ry: f64)     → int64 (markerId)
//   SvgMarkerEnd(doc)
//   SvgClipPathBegin(doc, id: pchar)                        → int64 (clipId)
//   SvgClipPathEnd(doc)
//
// From std.svg.filter:
//   SVG_COMP_OVER/IN/OUT/ATOP/XOR  (int64 constants)
//   SVG_CM_MATRIX/SATURATE/HUE_ROTATE/LUM_ALPHA
//   SvgDropShadow(doc, dx, dy, blur, opacity: f64)          → int64 (filterId)
//   SvgBlur(doc, stdDeviation: f64)                         → int64 (filterId)
//   SvgGrayscale(doc)                                       → int64 (filterId)
//   SvgSepia(doc)                                           → int64 (filterId)
//   SvgInvert(doc)                                          → int64 (filterId)
//   SvgBrightnessContrast(doc, brightness, contrast: f64)   → int64 (filterId)
//   SvgFilterBegin(doc, id: pchar, x, y, w, h: f64)         → int64 (filterId)
//   SvgFilterEnd(doc)
//   SvgFeGaussianBlur(doc, flt, src: pchar, stdX, stdY: f64)
//   SvgFeOffset(doc, flt, src: pchar, dx, dy: f64)
//   SvgFeComposite(doc, flt, in1, in2: pchar, op: int64)
//   SvgFeColorMatrix(doc, flt, src: pchar, cmType: int64, val: f64)
//   SvgMaskBegin(doc, id: pchar)                            → int64 (maskId)
//   SvgMaskEnd(doc)
//
// From std.svg.image:
//   SvgAddImageJpeg(doc, path: pchar)            → int64  (imgId, -1=error)
//   SvgAddImagePng(doc, path: pchar)             → int64  (imgId, -1=error)
//   SvgAddImageRGB(doc, ptr, w, h: int64)        → int64  (imgId, -1=error)
//   SvgDrawImage(doc, imgId, x, y, w, h: f64)
//   SvgDrawImageFit(doc, imgId, x, y, mw, mh: f64)
//   SvgImageFile(doc, path: pchar, x, y, w, h: f64)
//
// From std.svg.anim:
//   SVG_AT_TRANSLATE/SCALE/ROTATE/SKEWX/SKEWY  (int64 constants)
//   SvgAnimRepeat(doc, repeat: int64)            — set repeat count (0=indefinite)
//   SvgAnimate(doc, elem, attrName, fromV, toV: pchar, dur: f64)
//   SvgAnimateTransform(doc, elem, atType: int64, fromV, toV: pchar, dur: f64)
//   SvgAnimateMotion(doc, elem, motionPath: pchar, dur: f64, repeat: int64)
//   SvgAnimateMotionRotate(doc, elem, motionPath: pchar, dur: f64, repeat: int64)
//   SvgAnimateColor(doc, elem, attrName, fromHex, toHex: pchar, dur: f64)
//   SvgKeyframesBegin(doc, elem: int64, attrName: pchar)    → int64 (kf handle)
//   SvgKeyframe(doc, kf: int64, time: f64, value: pchar)
//   SvgKeyframesEnd(doc, kf: int64, dur: f64, repeat: int64)
//   SvgAnimateBeginOn(doc, anim, otherId: int64, eventName: pchar)
//
// From std.svg.parser:
//   SvgOpen(path: pchar)                         → int64  (parser doc, 0=error)
//   SvgReadWidth(doc)                            → f64
//   SvgReadHeight(doc)                           → f64
//   SvgReadViewBox(doc)                          → pchar
//   SvgRootElement(doc)                          → int64  (element pointer)
//   SvgFirstChild(elem)                          → int64  (element pointer, 0=none)
//   SvgNextSibling(elem)                         → int64  (element pointer, 0=none)
//   SvgElementTag(elem)                          → pchar
//   SvgElementId(elem)                           → pchar
//   SvgAttrStr(elem, name: pchar)                → pchar  (0=not found)
//   SvgAttrF64(elem, name: pchar, defaultVal: f64) → f64
//   SvgPathData(elem)                            → pchar  ("d" attribute)
//   SvgGetError(doc)                             → pchar
//   SvgFindId(doc, id: pchar)                    → int64  (element pointer, 0=none)
//   SvgCountByTag(doc, tag: pchar)               → int64
//   SvgParserFree(doc)
