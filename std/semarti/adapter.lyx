// std/semarti/adapter.lyx — die Grenze nach außen.
//
// WARUM DAS EINE EIGENE UNIT IST. Der Kern bleibt modellfrei: `wert`,
// `schema`, `registry`, `objekte` und `ablauf` kennen kein Austauschformat
// und keine Modell-API. Wer SemaRTI nur innerhalb des Programms benutzt,
// bindet diese Unit nicht ein und zahlt nichts für sie.
//
// ZWEI RICHTUNGEN, UND SIE SIND NICHT GLEICH VERTRAUENSWÜRDIG:
//
//   HINAUS  Deskriptoren werden zu einer Werkzeugbeschreibung. Das ist
//           unsere eigene, geprüfte Datenlage; die Aufgabe ist Maskierung,
//           damit ein Name oder eine Beschreibung das Format nicht brechen
//           kann.
//
//   HEREIN  Ein Vorschlag wird zu einem `std.semarti.wert`. Das ist
//           ANGREIFEREINGABE, auch wenn sie formal wohlgeformt ist. Hier
//           liegt die eigentliche Arbeit: jede Grenze des Werttyps muss
//           schon beim LESEN greifen, nicht erst danach — ein zu tiefes
//           Dokument darf nicht erst im Speicher stehen und dann abgewiesen
//           werden.
//
// WAS AUS EINER BESCHREIBUNG NIEMALS WIRD. Ein Beschreibungstext ist Daten.
// Er kann keine Richtlinie ändern, kein Recht erteilen und keine Operation
// freigeben. Diese Unit schreibt ihn hinaus und liest ihn nie als Anweisung
// zurück.
//
// WARUM EIN EIGENER LESER UND NICHT `std.json`. `std.json` ist textbasiert
// (`pchar` hinein, `pchar` heraus) und liefert keinen Werttyp, keine
// Navigation und keine Grenzen. Für die Richtung HINAUS wird es aber
// benutzt: `JSONEscape` maskiert, und das ist hier NICHT nachgebaut.

@description("SemaRTI: Serialisierung nach außen und geprüftes Lesen von außen")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.semarti.adapter;

import std.alloc;
import std.string;
import std.json;
import std.semarti.wert;
import std.semarti.registry;

pub con SRA_A_OK:              int64 := 0;
pub con SRA_A_E_SYNTAX:        int64 := 0 - 1;
pub con SRA_A_E_ZU_TIEF:       int64 := 0 - 2;
pub con SRA_A_E_ZU_LANG:       int64 := 0 - 3;
pub con SRA_A_E_ARENA:         int64 := 0 - 4;
pub con SRA_A_E_PUFFER_VOLL:   int64 := 0 - 5;
pub con SRA_A_E_UNERWARTETES_ENDE: int64 := 0 - 6;
pub con SRA_A_E_ZAHL_ZU_GROSS: int64 := 0 - 7;
pub con SRA_A_E_NICHT_UNTERSTUETZT: int64 := 0 - 8;

// ── Hinaus: Wert als JSON ───────────────────────────────────────────────────
// Schreibt in einen Puffer mit Deckel. Gibt die Anzahl geschriebener Bytes
// oder einen Befund. Ein voller Puffer ist ein FEHLER und keine
// abgeschnittene Ausgabe: halber JSON-Text wäre für den Empfänger nicht von
// vollständigem zu unterscheiden.
var _puf: int64 := 0;
var _pufLen: int64 := 0;
var _pufMax: int64 := 0;
var _pufVoll: int64 := 0;

fn aSchreibe(s: pchar, n: int64): void {
  if (_pufVoll != 0) { return; }
  if (_pufLen + n >= _pufMax) { _pufVoll := 1; return; }
  var i: int64 := 0;
  while (i < n) { poke8(_puf + _pufLen + i, peek8(s + i)); i := i + 1; }
  _pufLen := _pufLen + n;
}

fn aSchreibeStr(s: pchar): void { aSchreibe(s, StrLen(s)); }

// Maskiert über JSONEscape aus std.json — hier nicht nachgebaut.
//
// ACHTUNG: `JSONEscape` setzt die ANFÜHRUNGSZEICHEN SELBST. Der Name sagt
// das nicht, und der erste Entwurf legte eigene dazu — die Ausgabe lautete
// `""key""` und war kein gültiges JSON. Gefunden hat es nicht der Name,
// sondern der Lauf: fremde Funktionen am Verhalten prüfen, nicht an ihrer
// Bezeichnung.
fn aSchreibeText(s: pchar): void {
  var tmp: int64 := alloc(StrLen(s) * 6 + 8);
  JSONEscape(tmp as pchar, s);
  aSchreibeStr(tmp as pchar);
}

fn aWertSchreiben(ni: int64, tiefe: int64): int64 {
  if (tiefe > SRW_MAX_TIEFE) { return SRA_A_E_ZU_TIEF; }
  var art: int64 := WertArt(ni);
  if (art == SRW_NULL) { aSchreibeStr("null"c); return SRA_A_OK; }
  if (art == SRW_BOOL) {
    if (WertZahlwert(ni) != 0) { aSchreibeStr("true"c); } else { aSchreibeStr("false"c); }
    return SRA_A_OK;
  }
  if (art == SRW_ZAHL) { aSchreibeStr(IntToStr(WertZahlwert(ni))); return SRA_A_OK; }
  if (art == SRW_TEXT) { aSchreibeText(WertTextwert(ni)); return SRA_A_OK; }
  if (art == SRW_LISTE) {
    aSchreibeStr("["c);
    var k: int64 := WertErstesKind(ni);
    var erst: int64 := 1;
    while (k >= 0) {
      if (erst == 0) { aSchreibeStr(","c); }
      erst := 0;
      var r: int64 := aWertSchreiben(k, tiefe + 1);
      if (r != SRA_A_OK) { return r; }
      k := WertNaechstes(k);
    }
    aSchreibeStr("]"c);
    return SRA_A_OK;
  }
  if (art == SRW_OBJEKT) {
    aSchreibeStr("{"c);
    var k2: int64 := WertErstesKind(ni);
    var erst2: int64 := 1;
    while (k2 >= 0) {
      if (erst2 == 0) { aSchreibeStr(","c); }
      erst2 := 0;
      aSchreibeText(WertFeldName(k2));
      aSchreibeStr(":"c);
      var r2: int64 := aWertSchreiben(k2, tiefe + 1);
      if (r2 != SRA_A_OK) { return r2; }
      k2 := WertNaechstes(k2);
    }
    aSchreibeStr("}"c);
    return SRA_A_OK;
  }
  // Kein stiller Default: eine unbekannte Art ist ein Fehler im Aufrufer.
  return SRA_A_E_NICHT_UNTERSTUETZT;
}

pub fn AdapterWertNachJson(ni: int64, ziel: pchar, max: int64): int64 {
  _puf := ziel as int64;
  _pufLen := 0;
  _pufMax := max;
  _pufVoll := 0;
  var r: int64 := aWertSchreiben(ni, 1);
  if (r != SRA_A_OK) { return r; }
  if (_pufVoll != 0) { return SRA_A_E_PUFFER_VOLL; }
  poke8(_puf + _pufLen, 0);
  return _pufLen;
}

// ── Hinaus: Werkzeugbeschreibung aus der Registry ───────────────────────────
// Nur die Operationen, die der Aufrufer sehen darf — die Auswahl trifft der
// HOST und übergibt sie als Liste von Indizes. Diese Unit entscheidet nichts
// über Sichtbarkeit; sie schreibt nur, was ihr gegeben wird.
//
// Geschrieben werden Name, Beschreibung, Version, Risiko, Bestätigungspflicht
// und Instanzbindung. NICHT geschrieben werden die verlangten Capabilities:
// sie sind eine Innensicht des Programms, und ein Empfänger könnte daraus
// ableiten, welche Rechte zu erraten lohnen.
pub fn AdapterWerkzeugeNachJson(indizes: int64, anzahl: int64, ziel: pchar, max: int64): int64 {
  _puf := ziel as int64;
  _pufLen := 0;
  _pufMax := max;
  _pufVoll := 0;
  aSchreibeStr("["c);
  var i: int64 := 0;
  while (i < anzahl) {
    if (i > 0) { aSchreibeStr(","c); }
    var oi: int64 := peek64(indizes + i * 8);
    aSchreibeStr("{\"name\":"c);
    aSchreibeText(OpId(oi));
    aSchreibeStr(",\"title\":"c);
    aSchreibeText(OpTitel(oi));
    aSchreibeStr(",\"description\":"c);
    aSchreibeText(OpBeschreibung(oi));
    aSchreibeStr(",\"version\":"c);
    var v: pchar := StrConcat(IntToStr(OpMajor(oi)), "."c);
    v := StrConcat(v, IntToStr(OpMinor(oi)));
    v := StrConcat(v, "."c);
    v := StrConcat(v, IntToStr(OpPatch(oi)));
    aSchreibeText(v);
    aSchreibeStr(",\"risk\":"c);
    if (OpRisiko(oi) == SRR_RISIKO_NUR_LESEN) { aSchreibeText("read_only"c); }
    else if (OpRisiko(oi) == SRR_RISIKO_AENDERND) { aSchreibeText("mutating"c); }
    else { aSchreibeText("external_side_effect"c); }
    aSchreibeStr(",\"confirmation\":"c);
    if (OpBestaetigung(oi) == SRR_BESTAETIGUNG_NOETIG) { aSchreibeStr("true"c); } else { aSchreibeStr("false"c); }
    aSchreibeStr(",\"needs_instance\":"c);
    if (OpObjektbindung(oi) == SRR_OBJEKT_NOETIG) { aSchreibeStr("true"c); } else { aSchreibeStr("false"c); }
    aSchreibeStr(",\"input_schema\":"c);
    var r: int64 := aWertSchreiben(OpEingabeschema(oi), 1);
    if (r != SRA_A_OK) { return r; }
    aSchreibeStr("}"c);
    i := i + 1;
  }
  aSchreibeStr("]"c);
  if (_pufVoll != 0) { return SRA_A_E_PUFFER_VOLL; }
  poke8(_puf + _pufLen, 0);
  return _pufLen;
}

// ── Herein: JSON als Wert, mit Grenzen beim LESEN ───────────────────────────
// Jede Grenze greift, während gelesen wird. Ein zu tiefes oder zu großes
// Dokument steht damit nie vollständig im Speicher — anders als bei einem
// Leser, der erst baut und dann prüft.
var _q: int64 := 0;
var _qLen: int64 := 0;
var _qPos: int64 := 0;
var _letzterFehler: int64 := 0;

pub fn AdapterLetzterFehler(): int64 { return _letzterFehler; }
pub fn AdapterLetztePosition(): int64 { return _qPos; }

fn aIstWs(c: int64): int64 {
  if (c == 32 || c == 9 || c == 10 || c == 13) { return 1; }
  return 0;
}

fn aWs(): void {
  while (_qPos < _qLen && aIstWs(peek8(_q + _qPos)) != 0) { _qPos := _qPos + 1; }
}

fn aZeichen(): int64 {
  if (_qPos >= _qLen) { return 0 - 1; }
  return peek8(_q + _qPos);
}

// Liest einen JSON-Text in einen Puffer. Die Längengrenze greift ZEICHENWEISE
// und nicht am Ende: ein überlanger Text wird abgewiesen, sobald er zu lang
// ist, und nicht erst nachdem er abgelegt wurde.
fn aTextLesen(ziel: int64, max: int64): int64 {
  if (aZeichen() != 34) { return SRA_A_E_SYNTAX; }
  _qPos := _qPos + 1;
  var n: int64 := 0;
  while (1 == 1) {
    var c: int64 := aZeichen();
    if (c < 0) { return SRA_A_E_UNERWARTETES_ENDE; }
    if (c == 34) { _qPos := _qPos + 1; poke8(ziel + n, 0); return n; }
    if (n >= max) { return SRA_A_E_ZU_LANG; }
    if (c == 92) {
      _qPos := _qPos + 1;
      var e: int64 := aZeichen();
      if (e < 0) { return SRA_A_E_UNERWARTETES_ENDE; }
      if (e == 110) { poke8(ziel + n, 10); }
      else if (e == 116) { poke8(ziel + n, 9); }
      else if (e == 114) { poke8(ziel + n, 13); }
      else if (e == 98) { poke8(ziel + n, 8); }
      else if (e == 102) { poke8(ziel + n, 12); }
      else if (e == 34 || e == 92 || e == 47) { poke8(ziel + n, e); }
      else if (e == 117) {
        // \uXXXX wird NICHT unterstützt und ausdrücklich abgewiesen. Eine
        // halbe Unterstützung (etwa nur ASCII, Ersatzzeichen für den Rest)
        // wäre ein stiller Default: der Empfänger bekäme einen Text, der
        // anders lautet als der gesendete.
        return SRA_A_E_NICHT_UNTERSTUETZT;
      }
      else { return SRA_A_E_SYNTAX; }
      _qPos := _qPos + 1;
      n := n + 1;
    } else {
      poke8(ziel + n, c);
      _qPos := _qPos + 1;
      n := n + 1;
    }
  }
  return SRA_A_E_SYNTAX;
}

fn aZahlLesen(): int64 {
  var neg: int64 := 0;
  if (aZeichen() == 45) { neg := 1; _qPos := _qPos + 1; }
  var c: int64 := aZeichen();
  if (c < 48 || c > 57) { _letzterFehler := SRA_A_E_SYNTAX; return 0 - 1; }
  var w: int64 := 0;
  var ziffern: int64 := 0;
  while (1 == 1) {
    c := aZeichen();
    if (c < 48 || c > 57) { break; }
    // Überlauf VOR der Multiplikation prüfen: 922337203685477580 ist
    // int64_max / 10. Eine Prüfung danach käme zu spät, und ein
    // übergelaufener Wert wäre vom Empfänger nicht zu erkennen.
    if (w > 922337203685477580) { _letzterFehler := SRA_A_E_ZAHL_ZU_GROSS; return 0 - 1; }
    w := w * 10 + (c - 48);
    if (w < 0) { _letzterFehler := SRA_A_E_ZAHL_ZU_GROSS; return 0 - 1; }
    ziffern := ziffern + 1;
    if (ziffern > 19) { _letzterFehler := SRA_A_E_ZAHL_ZU_GROSS; return 0 - 1; }
    _qPos := _qPos + 1;
  }
  // Gleitkomma wird nicht unterstützt und laut abgewiesen; ein stilles
  // Abschneiden auf die Ganzzahl wäre ein anderer Wert als der gesendete.
  if (aZeichen() == 46 || aZeichen() == 101 || aZeichen() == 69) {
    _letzterFehler := SRA_A_E_NICHT_UNTERSTUETZT;
    return 0 - 1;
  }
  if (neg != 0) { w := 0 - w; }
  _letzterFehler := SRA_A_OK;
  return w;
}

fn aWertLesen(tiefe: int64): int64 {
  if (tiefe > SRW_MAX_TIEFE) { _letzterFehler := SRA_A_E_ZU_TIEF; return 0 - 1; }
  aWs();
  var c: int64 := aZeichen();
  if (c < 0) { _letzterFehler := SRA_A_E_UNERWARTETES_ENDE; return 0 - 1; }

  if (c == 110) {   // null
    if (_qPos + 4 > _qLen) { _letzterFehler := SRA_A_E_UNERWARTETES_ENDE; return 0 - 1; }
    _qPos := _qPos + 4;
    return WertNull();
  }
  if (c == 116) {   // true
    if (_qPos + 4 > _qLen) { _letzterFehler := SRA_A_E_UNERWARTETES_ENDE; return 0 - 1; }
    _qPos := _qPos + 4;
    return WertBool(1);
  }
  if (c == 102) {   // false
    if (_qPos + 5 > _qLen) { _letzterFehler := SRA_A_E_UNERWARTETES_ENDE; return 0 - 1; }
    _qPos := _qPos + 5;
    return WertBool(0);
  }
  if (c == 34) {
    var tmp: int64 := alloc(SRW_MAX_TEXTLAENGE + 8);
    var n: int64 := aTextLesen(tmp, SRW_MAX_TEXTLAENGE);
    if (n < 0) { _letzterFehler := n; return 0 - 1; }
    return WertText(tmp as pchar);
  }
  if (c == 45 || (c >= 48 && c <= 57)) {
    var z: int64 := aZahlLesen();
    if (_letzterFehler != SRA_A_OK) { return 0 - 1; }
    return WertZahl(z);
  }
  if (c == 91) {    // [
    _qPos := _qPos + 1;
    var l: int64 := WertListe();
    if (l < 0) { _letzterFehler := SRA_A_E_ARENA; return 0 - 1; }
    aWs();
    if (aZeichen() == 93) { _qPos := _qPos + 1; return l; }
    while (1 == 1) {
      var g: int64 := aWertLesen(tiefe + 1);
      if (g < 0) { return 0 - 1; }
      var r: int64 := WertGliedAnhaengen(l, g);
      if (r != SRW_OK) { _letzterFehler := SRA_A_E_ARENA; return 0 - 1; }
      aWs();
      var d: int64 := aZeichen();
      if (d == 44) { _qPos := _qPos + 1; }
      else if (d == 93) { _qPos := _qPos + 1; return l; }
      else { _letzterFehler := SRA_A_E_SYNTAX; return 0 - 1; }
    }
  }
  if (c == 123) {   // {
    _qPos := _qPos + 1;
    var o: int64 := WertObjekt();
    if (o < 0) { _letzterFehler := SRA_A_E_ARENA; return 0 - 1; }
    aWs();
    if (aZeichen() == 125) { _qPos := _qPos + 1; return o; }
    while (1 == 1) {
      aWs();
      var nm: int64 := alloc(SRW_MAX_NAME + 8);
      var nl: int64 := aTextLesen(nm, SRW_MAX_NAME);
      if (nl < 0) { _letzterFehler := nl; return 0 - 1; }
      aWs();
      if (aZeichen() != 58) { _letzterFehler := SRA_A_E_SYNTAX; return 0 - 1; }
      _qPos := _qPos + 1;
      var w: int64 := aWertLesen(tiefe + 1);
      if (w < 0) { return 0 - 1; }
      var r2: int64 := WertFeldSetzen(o, nm as pchar, w);
      if (r2 != SRW_OK) { _letzterFehler := SRA_A_E_ARENA; return 0 - 1; }
      aWs();
      var d2: int64 := aZeichen();
      if (d2 == 44) { _qPos := _qPos + 1; }
      else if (d2 == 125) { _qPos := _qPos + 1; return o; }
      else { _letzterFehler := SRA_A_E_SYNTAX; return 0 - 1; }
    }
  }
  _letzterFehler := SRA_A_E_SYNTAX;
  return 0 - 1;
}

// Liest einen Vorschlag. Gibt den Wurzelknoten oder -1; der Grund steht in
// `AdapterLetzterFehler()`, die Stelle in `AdapterLetztePosition()`.
//
// Hinter dem Wert darf nur noch Weißraum stehen: ein zweites Dokument im
// selben Text wäre eine Stelle, an der Sender und Empfänger verschieden
// lesen könnten.
pub fn AdapterJsonNachWert(text: pchar): int64 {
  _q := text as int64;
  _qLen := StrLen(text);
  _qPos := 0;
  _letzterFehler := SRA_A_OK;
  var w: int64 := aWertLesen(1);
  if (w < 0) { return 0 - 1; }
  aWs();
  if (_qPos < _qLen) { _letzterFehler := SRA_A_E_SYNTAX; return 0 - 1; }
  return w;
}
