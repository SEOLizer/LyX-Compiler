// std/semarti/ablauf.lyx — Discovery, Autorisierung, Policy, Ausführung.
//
// DIE REIHENFOLGE IST DER SICHERHEITSKERN. Ein Aufruf erreicht den Handler
// erst, wenn ALLES davor bestanden ist:
//
//   1. Operations-ID auflösen   -> unbekannt?        operation_not_found
//   2. Version prüfen           -> passt nicht?      unsupported_version
//   3. Eingabe gegen Schema     -> ungültig?         invalid_input
//   4. Autorisierung            -> kein Recht?       unauthorized
//   5. Policy                   -> verweigert?       policy_denied
//   6. Bestätigung              -> fehlt?            confirmation_required
//   7. HANDLER
//   8. Ausgabe gegen Schema     -> ungültig?         invalid_output
//   9. Audit
//
// Es gibt KEINEN Zweig, der eine dieser Stufen überspringt, und keinen
// Rückfall, der eine fehlende Berechtigung in etwas Milderes verwandelt. Ein
// Catch-all, der etwas Plausibles tut, macht aus jeder Lücke eine stille
// Fehlfunktion.
//
// DENY BY DEFAULT, UND ZWAR WIRKSAM. Ohne gesetzten Authorizer lehnt diese
// Unit JEDEN Aufruf ab. Das ist der Unterschied zwischen einer Vorgabe, die
// hält, und einer, die nur so aussieht: eine Voreinstellung „alles erlaubt,
// bis der Host etwas setzt" hätte jedes Programm offen gelassen, das die
// Einrichtung vergisst.
//
// WAS EIN VORSCHLAG IST UND WAS NICHT. Die Eingabe kommt von außen und ist
// nicht vertrauenswürdig, auch wenn sie formal wohlgeformt ist. Der Principal
// wird NICHT aus der Eingabe gelesen, sondern vom Host übergeben — sonst
// könnte sich ein Vorschlag seine eigene Identität geben.

@description("SemaRTI: Discovery und geprüfte Ausführung")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.semarti.ablauf;

import std.string;
import std.semarti.wert;
import std.semarti.schema;
import std.semarti.registry;

// ── Ergebniscodes (die Namen der Spezifikation) ─────────────────────────────
pub con SRA_OK:                    int64 := 0;
pub con SRA_OPERATION_NOT_FOUND:   int64 := 0 - 1;
pub con SRA_UNSUPPORTED_VERSION:   int64 := 0 - 2;
pub con SRA_INVALID_INPUT:         int64 := 0 - 3;
pub con SRA_UNAUTHORIZED:          int64 := 0 - 4;
pub con SRA_POLICY_DENIED:         int64 := 0 - 5;
pub con SRA_CONFIRMATION_REQUIRED: int64 := 0 - 6;
pub con SRA_CANCELLED:             int64 := 0 - 7;
pub con SRA_DEADLINE_EXCEEDED:     int64 := 0 - 8;
pub con SRA_HANDLER_FAILED:        int64 := 0 - 9;
pub con SRA_INVALID_OUTPUT:        int64 := 0 - 10;
pub con SRA_NOT_READY:             int64 := 0 - 11;

// Policy-Entscheidungen.
pub con SRA_POLICY_ERLAUBT:      int64 := 0;
pub con SRA_POLICY_ABGELEHNT:    int64 := 1;
pub con SRA_POLICY_BESTAETIGUNG: int64 := 2;

// ── Haken, die der Host setzt ───────────────────────────────────────────────
// Authorizer: darf dieser Principal diese Operation? Bekommt den
// Operationsindex und den Principal, NICHT die Eingabe — ein Recht hängt
// nicht am Argument.
pub type SemaAuthorizer = fn(int64, pchar): int64;
// Policy: urteilt über Wirkung, Risiko und Kontext. Bekommt zusätzlich die
// Eingabe, weil eine Policy sehr wohl am Argument hängen darf
// („löschen unter /tmp ja, sonst nein").
pub type SemaPolicy = fn(int64, int64, pchar): int64;
// Audit: Metadaten eines abgeschlossenen Versuchs. Bekommt KEINE Eingabe und
// keine Ausgabe — was protokolliert wird, entscheidet der Host in seiner
// eigenen Funktion, und eine Bibliothek soll ihm nicht ungefragt Nutzdaten
// in das Log schieben.
pub type SemaAudit = fn(int64, int64, pchar): void;

var _auth: SemaAuthorizer := 0 as SemaAuthorizer;
var _policy: SemaPolicy := 0 as SemaPolicy;
var _audit: SemaAudit := 0 as SemaAudit;

pub fn AblaufAuthorizerSetzen(f: SemaAuthorizer): void { _auth := f; }
pub fn AblaufPolicySetzen(f: SemaPolicy): void { _policy := f; }
pub fn AblaufAuditSetzen(f: SemaAudit): void { _audit := f; }

pub fn AblaufZuruecksetzenFuerTest(): void {
  _auth := 0 as SemaAuthorizer;
  _policy := 0 as SemaPolicy;
  _audit := 0 as SemaAudit;
}

// Letzter Ausgabeknoten eines erfolgreichen Aufrufs. Gilt bis zum nächsten
// Zurücksetzen der Arena.
var _letzteAusgabe: int64 := 0 - 1;
pub fn AblaufLetzteAusgabe(): int64 { return _letzteAusgabe; }

// Der Grund im Klartext gehört ins Betreiberlog, nicht zum Aufrufer: nach
// außen geht ein einziges `invalid_input`, damit niemand aus der Meldung
// ablesen kann, welches Feld welche Grenze hat.
var _letzterGrund: pchar := ""c;
pub fn AblaufLetzterGrund(): pchar { return _letzterGrund; }

fn aNein(code: int64, oi: int64, principal: pchar, grund: pchar): int64 {
  _letzterGrund := grund;
  if (_audit as int64 != 0) { _audit(oi, code, principal); }
  return code;
}

// ── Discovery ───────────────────────────────────────────────────────────────
// Gibt nur zurück, was dieser Principal auch aufrufen dürfte: Autorisierung
// UND Policy werden gefragt. Eine Operation, die die Policy verweigert,
// erscheint nicht — sonst würde die Liste ein Werkzeug anbieten, dessen
// Aufruf gleich darauf scheitert, und ein Modell würde es trotzdem versuchen.
//
// Ohne Authorizer ist die Liste LEER. Siehe Kopf dieser Datei.
pub fn AblaufSichtbar(oi: int64, principal: pchar): int64 {
  if (RegistryIstAbgeschlossen() == 0) { return 0; }
  if (_auth as int64 == 0) { return 0; }
  if (oi < 0 || oi >= RegistryAnzahl()) { return 0; }
  if (_auth(oi, principal) == 0) { return 0; }
  if (_policy as int64 != 0) {
    var d: int64 := _policy(oi, 0 - 1, principal);
    if (d == SRA_POLICY_ABGELEHNT) { return 0; }
  }
  return 1;
}

pub fn AblaufSichtbareZahl(principal: pchar): int64 {
  var n: int64 := 0;
  var i: int64 := 0;
  while (i < RegistryAnzahl()) {
    if (AblaufSichtbar(i, principal) != 0) { n := n + 1; }
    i := i + 1;
  }
  return n;
}

// ── Aufruf ──────────────────────────────────────────────────────────────────
// `bestaetigt` ist die Zusage des HOSTS, dass ein Mensch diese konkrete
// Operation freigegeben hat. Sie ist kein Eingabefeld: ein Vorschlag darf
// sich nicht selbst bestätigen.
pub fn AblaufAufrufen(id: pchar, major: int64, minor: int64,
                      eingabe: int64, principal: pchar, bestaetigt: int64): int64 {
  _letzteAusgabe := 0 - 1;
  _letzterGrund := ""c;

  // Eine nicht abgeschlossene Registry ist ein Einrichtungsfehler des Hosts
  // und kein Aufruffehler. Sie wird laut gemeldet, statt die Prüfungen mit
  // halb aufgebauten Deskriptoren zu fahren.
  if (RegistryIstAbgeschlossen() == 0) { return aNein(SRA_NOT_READY, 0 - 1, principal, "Registry nicht abgeschlossen"c); }

  // 1. Identität
  var oi: int64 := RegistryFinde(id);
  if (oi < 0) { return aNein(SRA_OPERATION_NOT_FOUND, 0 - 1, principal, "unbekannte Operations-ID"c); }

  // 2. Version
  if (OpVersionPasst(oi, major, minor) == 0) { return aNein(SRA_UNSUPPORTED_VERSION, oi, principal, "Version nicht unterstuetzt"c); }

  // 3. Eingabe. Vor jeder Rechteprüfung, damit eine missgebildete Eingabe
  //    nicht erst den Authorizer beschäftigt — und nach der Identität, weil
  //    ohne Operation kein Schema bekannt ist.
  if (SchemaPruefe(eingabe, OpEingabeschema(oi)) != SRS_OK) {
    return aNein(SRA_INVALID_INPUT, oi, principal, SchemaLetztesGrundFeld());
  }

  // 4. Autorisierung. Ohne Authorizer: abgelehnt.
  if (_auth as int64 == 0) { return aNein(SRA_UNAUTHORIZED, oi, principal, "kein Authorizer gesetzt"c); }
  if (_auth(oi, principal) == 0) { return aNein(SRA_UNAUTHORIZED, oi, principal, "Authorizer verweigert"c); }

  // 5. Policy. Ohne Policy gilt die Angabe der Operation; eine fehlende
  //    Policy ist kein Freibrief, sondern lässt die Bestätigungspflicht aus
  //    dem Deskriptor stehen.
  var noetig: int64 := OpBestaetigung(oi);
  if (_policy as int64 != 0) {
    var d: int64 := _policy(oi, eingabe, principal);
    if (d == SRA_POLICY_ABGELEHNT) { return aNein(SRA_POLICY_DENIED, oi, principal, "Policy verweigert"c); }
    if (d == SRA_POLICY_BESTAETIGUNG) { noetig := SRR_BESTAETIGUNG_NOETIG; }
    else if (d != SRA_POLICY_ERLAUBT) {
      // Eine unbekannte Entscheidung ist ein Fehler im Host und wird NICHT
      // als „erlaubt" gelesen.
      return aNein(SRA_POLICY_DENIED, oi, principal, "Policy gab eine unbekannte Entscheidung"c);
    }
  }

  // 6. Bestätigung
  if (noetig == SRR_BESTAETIGUNG_NOETIG && bestaetigt == 0) {
    return aNein(SRA_CONFIRMATION_REQUIRED, oi, principal, "Bestaetigung fehlt"c);
  }

  // 7. Handler
  var ausgabe: int64 := WertObjekt();
  if (ausgabe < 0) { return aNein(SRA_HANDLER_FAILED, oi, principal, "Arena erschoepft"c); }
  var h: SemaHandler := OpHandler(oi);
  if (h as int64 == 0) { return aNein(SRA_HANDLER_FAILED, oi, principal, "kein Handler"c); }
  var hr: int64 := h(eingabe, ausgabe, principal as int64);
  if (hr != 0) { return aNein(SRA_HANDLER_FAILED, oi, principal, "Handler meldete einen Fehler"c); }

  // 8. Ausgabe. Auch die eigene Ausgabe wird geprüft: ein Handler, der etwas
  //    anderes liefert als zugesagt, bricht den Vertrag nach außen genauso
  //    wie eine falsche Eingabe ihn nach innen bräche.
  if (SchemaPruefe(ausgabe, OpAusgabeschema(oi)) != SRS_OK) {
    return aNein(SRA_INVALID_OUTPUT, oi, principal, SchemaLetztesGrundFeld());
  }

  _letzteAusgabe := ausgabe;
  if (_audit as int64 != 0) { _audit(oi, SRA_OK, principal); }
  return SRA_OK;
}
