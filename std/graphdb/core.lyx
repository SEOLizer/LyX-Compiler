// std/graphdb/core.lyx
// WP-GRP-01: ID-Erzeugung und Timestamps

@description("GraphDB core: ID generation and timestamps")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, system.time])
unit std.graphdb.core;

import std.alloc;
import std.hash;
import std.time;

pub con GRAPH_ID_INVALID: int64 := 0;

var _graphSeed: int64 := 6364136223846793005;

// GraphNow: Unix-Millisekunden via CLOCK_REALTIME
pub fn GraphNow(): int64 {
    return GetTimeNs(CLOCK_REALTIME) / 1000000;
}

// GraphIDFromStr: deterministischer int64-ID-Hash (FNV-1a, immer > 0)
pub fn GraphIDFromStr(s: pchar, slen: int64): int64 {
    var h: int64 := HashFNV1a64Bytes(s, slen);
    var id: int64 := h & 0x7FFFFFFFFFFFFFFF;
    if (id == 0) { id := 1; }
    return id;
}

fn _graphNextSeed(): int64 {
    _graphSeed := _graphSeed * 6364136223846793005 + 1442695040888963407;
    return _graphSeed;
}

// GraphIDNew: einmalige ID (Zeit XOR LCG, immer > 0)
pub fn GraphIDNew(): int64 {
    var t: int64 := GraphNow();
    var r: int64 := _graphNextSeed();
    var id: int64 := (t ^ r) & 0x7FFFFFFFFFFFFFFF;
    if (id == 0) { id := 1; }
    return id;
}
