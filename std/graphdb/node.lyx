// std/graphdb/node.lyx
// WP-GRP-02: GraphNode mit Labels, TLV-Properties und f64-Vektor

@description("GraphDB node: labels, TLV properties, f64 embedding vector")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, system.time])
unit std.graphdb.node;

import std.alloc;
import std.graphdb.core;

pub con GPROP_INT64: int64 := 0;
pub con GPROP_PCHAR: int64 := 1;
pub con GPROP_F64:   int64 := 2;
pub con GPROP_BOOL:  int64 := 3;

con NODE_LABELS_INIT_CAP: int64 := 64;
con NODE_PROPS_INIT_CAP:  int64 := 256;

pub con GNODE_OFF_ID:          int64 := 0;
pub con GNODE_OFF_LABELSBUF:   int64 := 8;
pub con GNODE_OFF_LABELSLEN:   int64 := 16;
pub con GNODE_OFF_LABELSCAP:   int64 := 24;
pub con GNODE_OFF_LABELSCOUNT: int64 := 32;
pub con GNODE_OFF_PROPSBUF:    int64 := 40;
pub con GNODE_OFF_PROPSLEN:    int64 := 48;
pub con GNODE_OFF_PROPSCAP:    int64 := 56;
pub con GNODE_OFF_VECBUF:      int64 := 64;
pub con GNODE_OFF_VECDIMS:     int64 := 72;
pub con GNODE_SIZE:            int64 := 80;

// ============================================================
// Init / Free
// ============================================================

pub fn GraphNodeInit(n: int64) {
    poke64(n + GNODE_OFF_ID,          GRAPH_ID_INVALID);
    var lb: int64 := alloc(NODE_LABELS_INIT_CAP);
    poke64(n + GNODE_OFF_LABELSBUF,   lb);
    poke64(n + GNODE_OFF_LABELSLEN,   0);
    poke64(n + GNODE_OFF_LABELSCAP,   NODE_LABELS_INIT_CAP);
    poke64(n + GNODE_OFF_LABELSCOUNT, 0);
    var pb: int64 := alloc(NODE_PROPS_INIT_CAP);
    poke64(n + GNODE_OFF_PROPSBUF,    pb);
    poke64(n + GNODE_OFF_PROPSLEN,    0);
    poke64(n + GNODE_OFF_PROPSCAP,    NODE_PROPS_INIT_CAP);
    poke64(n + GNODE_OFF_VECBUF,      0);
    poke64(n + GNODE_OFF_VECDIMS,     0);
}

pub fn GraphNodeFree(n: int64) {
    var lb: int64 := peek64(n + GNODE_OFF_LABELSBUF);
    var lc: int64 := peek64(n + GNODE_OFF_LABELSCAP);
    if (lb != 0) { free(lb, lc); }
    var pb: int64 := peek64(n + GNODE_OFF_PROPSBUF);
    var pc: int64 := peek64(n + GNODE_OFF_PROPSCAP);
    if (pb != 0) { free(pb, pc); }
    var vb: int64 := peek64(n + GNODE_OFF_VECBUF);
    var vd: int64 := peek64(n + GNODE_OFF_VECDIMS);
    if (vb != 0) { free(vb, vd * 8); }
}

// ============================================================
// Labels
// ============================================================

fn _nodeGrowLabels(n: int64, need: int64) {
    var cap: int64 := peek64(n + GNODE_OFF_LABELSCAP);
    var len: int64 := peek64(n + GNODE_OFF_LABELSLEN);
    if (len + need <= cap) { return; }
    var nc: int64 := cap * 2;
    if (nc < len + need) { nc := len + need + 64; }
    var nb: int64 := alloc(nc);
    var ob: int64 := peek64(n + GNODE_OFF_LABELSBUF);
    memcpy(nb, ob, len);
    free(ob, cap);
    poke64(n + GNODE_OFF_LABELSBUF, nb);
    poke64(n + GNODE_OFF_LABELSCAP, nc);
}

pub fn GraphNodeAddLabel(n: int64, label: pchar, llen: int64) {
    _nodeGrowLabels(n, llen + 1);
    var buf: int64 := peek64(n + GNODE_OFF_LABELSBUF);
    var pos: int64 := peek64(n + GNODE_OFF_LABELSLEN);
    var i: int64 := 0;
    while (i < llen) {
        poke8(buf + pos + i, StrCharAt(label, i));
        i += 1;
    }
    poke8(buf + pos + llen, 0);
    poke64(n + GNODE_OFF_LABELSLEN,   pos + llen + 1);
    poke64(n + GNODE_OFF_LABELSCOUNT, peek64(n + GNODE_OFF_LABELSCOUNT) + 1);
}

// Vergleicht segLen Bytes ab buf+segStart mit label
fn _labelsSegEq(buf: int64, segStart: int64, segLen: int64, label: pchar, llen: int64): int64 {
    if (segLen != llen) { return 0; }
    var j: int64 := 0;
    var ca: int64 := 0;
    var cb: int64 := 0;
    while (j < llen) {
        ca := peek8(buf + segStart + j);
        cb := StrCharAt(label, j);
        if (ca != cb) { return 0; }
        j += 1;
    }
    return 1;
}

// Flacher Scan über \0-separierten Label-Buffer
pub fn GraphNodeHasLabel(n: int64, label: pchar, llen: int64): int64 {
    var buf: int64   := peek64(n + GNODE_OFF_LABELSBUF);
    var total: int64 := peek64(n + GNODE_OFF_LABELSLEN);
    var pos: int64   := 0;
    var start: int64 := 0;
    var c: int64     := 0;
    while (pos <= total) {
        c := 0;
        if (pos < total) { c := peek8(buf + pos); }
        if (c == 0) {
            if (_labelsSegEq(buf, start, pos - start, label, llen) != 0) { return 1; }
            start := pos + 1;
        }
        pos += 1;
    }
    return 0;
}

// ============================================================
// TLV-Properties (intern)
// ============================================================

fn _nodeGrowProps(n: int64, need: int64) {
    var cap: int64 := peek64(n + GNODE_OFF_PROPSCAP);
    var len: int64 := peek64(n + GNODE_OFF_PROPSLEN);
    if (len + need <= cap) { return; }
    var nc: int64 := cap * 2;
    if (nc < len + need) { nc := len + need + 256; }
    var nb: int64 := alloc(nc);
    var ob: int64 := peek64(n + GNODE_OFF_PROPSBUF);
    memcpy(nb, ob, len);
    free(ob, cap);
    poke64(n + GNODE_OFF_PROPSBUF, nb);
    poke64(n + GNODE_OFF_PROPSCAP, nc);
}

fn _nodePropWrite(n: int64, typ: int64, key: pchar, klen: int64, valBuf: int64, vsize: int64) {
    _nodeGrowProps(n, 2 + klen + vsize);
    var buf: int64 := peek64(n + GNODE_OFF_PROPSBUF);
    var pos: int64 := peek64(n + GNODE_OFF_PROPSLEN);
    var i: int64   := 0;
    poke8(buf + pos, typ);
    poke8(buf + pos + 1, klen);
    pos += 2;
    while (i < klen) {
        poke8(buf + pos + i, StrCharAt(key, i));
        i += 1;
    }
    pos += klen;
    memcpy(buf + pos, valBuf, vsize);
    poke64(n + GNODE_OFF_PROPSLEN, pos + vsize);
}

fn _readLen4(p: int64): int64 {
    return peek8(p) + peek8(p + 1) * 256 + peek8(p + 2) * 65536 + peek8(p + 3) * 16777216;
}

// Vergleicht klen Bytes ab buf+kstart mit key
fn _keyEq(buf: int64, kstart: int64, key: pchar, klen: int64): int64 {
    var j: int64  := 0;
    var ca: int64 := 0;
    var cb: int64 := 0;
    while (j < klen) {
        ca := peek8(buf + kstart + j);
        cb := StrCharAt(key, j);
        if (ca != cb) { return 0; }
        j += 1;
    }
    return 1;
}

// Sucht Value-Pointer für (typ, key, klen). Gibt 0 wenn nicht gefunden.
fn _nodePropFind(n: int64, typ: int64, key: pchar, klen: int64): int64 {
    var buf: int64    := peek64(n + GNODE_OFF_PROPSBUF);
    var total: int64  := peek64(n + GNODE_OFF_PROPSLEN);
    var pos: int64    := 0;
    var ptyp: int64   := 0;
    var pklen: int64  := 0;
    var kstart: int64 := 0;
    var vstart: int64 := 0;
    var found: int64  := 0;
    var slen: int64   := 0;
    while (pos < total) {
        ptyp   := peek8(buf + pos);
        pklen  := peek8(buf + pos + 1);
        kstart := pos + 2;
        vstart := kstart + pklen;
        found  := 0;
        if (ptyp == typ) {
            if (pklen == klen) { found := _keyEq(buf, kstart, key, klen); }
        }
        if (found != 0) { return buf + vstart; }
        if (ptyp == GPROP_INT64)       { pos := vstart + 8; }
        else if (ptyp == GPROP_F64)    { pos := vstart + 8; }
        else if (ptyp == GPROP_BOOL)   { pos := vstart + 1; }
        else if (ptyp == GPROP_PCHAR)  {
            slen := _readLen4(buf + vstart);
            pos  := vstart + 4 + slen;
        } else { pos := total; }
    }
    return 0;
}

// ============================================================
// Properties: Set
// ============================================================

pub fn GraphNodeSetInt(n: int64, key: pchar, klen: int64, val: int64) {
    var tmp: int64 := alloc(8);
    poke64(tmp, val);
    _nodePropWrite(n, GPROP_INT64, key, klen, tmp, 8);
    free(tmp, 8);
}

// bits = IEEE-754-Bits des f64-Werts: (myF64Val as f64) as int64
pub fn GraphNodeSetF64(n: int64, key: pchar, klen: int64, bits: int64) {
    var tmp: int64 := alloc(8);
    poke64(tmp, bits);
    _nodePropWrite(n, GPROP_F64, key, klen, tmp, 8);
    free(tmp, 8);
}

pub fn GraphNodeSetBool(n: int64, key: pchar, klen: int64, val: int64) {
    var tmp: int64 := alloc(1);
    poke8(tmp, val & 1);
    _nodePropWrite(n, GPROP_BOOL, key, klen, tmp, 1);
    free(tmp, 1);
}

pub fn GraphNodeSetStr(n: int64, key: pchar, klen: int64, val: pchar, vlen: int64) {
    var tmp: int64 := alloc(4 + vlen);
    var i: int64   := 0;
    poke8(tmp,     vlen & 255);
    poke8(tmp + 1, (vlen >> 8) & 255);
    poke8(tmp + 2, (vlen >> 16) & 255);
    poke8(tmp + 3, (vlen >> 24) & 255);
    while (i < vlen) {
        poke8(tmp + 4 + i, StrCharAt(val, i));
        i += 1;
    }
    _nodePropWrite(n, GPROP_PCHAR, key, klen, tmp, 4 + vlen);
    free(tmp, 4 + vlen);
}

// ============================================================
// Properties: Get
// ============================================================

pub fn GraphNodeGetInt(n: int64, key: pchar, klen: int64): int64 {
    var p: int64 := _nodePropFind(n, GPROP_INT64, key, klen);
    if (p == 0) { return 0; }
    return peek64(p);
}

pub fn GraphNodeGetF64(n: int64, key: pchar, klen: int64): int64 {
    var p: int64 := _nodePropFind(n, GPROP_F64, key, klen);
    if (p == 0) { return 0; }
    return peek64(p);
}

pub fn GraphNodeGetBool(n: int64, key: pchar, klen: int64): int64 {
    var p: int64 := _nodePropFind(n, GPROP_BOOL, key, klen);
    if (p == 0) { return 0; }
    return peek8(p);
}

// Gibt Pointer direkt in propsBuf. outLen: Pointer auf int64 (oder 0).
pub fn GraphNodeGetStr(n: int64, key: pchar, klen: int64, outLen: int64): pchar {
    var p: int64 := _nodePropFind(n, GPROP_PCHAR, key, klen);
    if (p == 0) {
        if (outLen != 0) { poke64(outLen, 0); }
        return 0 as pchar;
    }
    var slen: int64 := _readLen4(p);
    if (outLen != 0) { poke64(outLen, slen); }
    return (p + 4) as pchar;
}

// ============================================================
// Vektor (f64-Array)
// ============================================================

pub fn GraphNodeSetVec(n: int64, dims: int64, data: int64) {
    var old: int64     := peek64(n + GNODE_OFF_VECBUF);
    var oldDims: int64 := peek64(n + GNODE_OFF_VECDIMS);
    if (old != 0) { free(old, oldDims * 8); }
    var nb: int64 := alloc(dims * 8);
    memcpy(nb, data, dims * 8);
    poke64(n + GNODE_OFF_VECBUF,  nb);
    poke64(n + GNODE_OFF_VECDIMS, dims);
}

pub fn GraphNodeGetVecDim(n: int64, i: int64): f64 {
    var vb: int64 := peek64(n + GNODE_OFF_VECBUF);
    if (vb == 0) { return 0 as f64; }
    return peek64(vb + i * 8) as f64;
}
