// std/geodesy/ellipsoid.lyx — Referenzellipsoide und ihre Krümmungsradien
//
// Das ellipsoidische Gegenstück zu `std/geo/sphere`. Der Unterschied ist keine
// Feinheit: die Kugelnäherung weicht in der Entfernung um bis zu 0,5 % ab —
// auf 1000 km sind das 5 km. Für eine Kartendarstellung belanglos, für
// Vermessung, Navigation oder eine Landebahnrechnung nicht.
//
// WAS HIER DIE FALLEN SIND:
//
//   * DIE ABPLATTUNG WIRD ALS KEHRWERT ANGEGEBEN. In jeder Tabelle steht
//     1/f = 298,257223563, nicht f selbst. Wer die Zahl direkt als f einsetzt,
//     bekommt ein Ellipsoid, das um den Faktor 89000 falsch ist — und weil
//     alle Formeln weiterrechnen, fällt es erst am Ergebnis auf.
//
//   * ES GIBT ZWEI EXZENTRIZITÄTEN. e² = f(2−f) ist die erste, e'² = e²/(1−e²)
//     die zweite. Die Rückrechnung von ECEF nach geodätisch braucht die
//     ZWEITE; wer dort die erste einsetzt, bekommt eine Breite, die um
//     Bogenminuten danebenliegt.
//
//   * ES GIBT ZWEI KRÜMMUNGSRADIEN, und sie sind verschieden. M ist der
//     Meridiankrümmungsradius (Nord-Süd), N der Querkrümmungsradius
//     (Ost-West). Am Äquator ist M kleiner als N, am Pol sind beide gleich.
//     Wer für eine Nord-Süd-Strecke N nimmt, liegt am Äquator um 0,7 % daneben.
//
//   * EIN ALTES DATUM IST NICHT WGS84. Bessel 1841 liegt in Deutschland rund
//     600 m neben WGS84. Wer Koordinaten aus einer alten Karte ohne
//     Datumsübergang benutzt, ist entsprechend daneben — die Ellipsoide sind
//     hier deshalb benannt und nicht als "das" Ellipsoid geführt.

unit std.geodesy.ellipsoid;

import std.math;

// Ein Referenzellipsoid: große Halbachse und Abplattung. Alles andere wird
// daraus gerechnet, damit die Werte nicht auseinanderlaufen können.
pub type Ellipsoid = struct {
  a:    f64;   // große Halbachse [m]
  f:    f64;   // Abplattung (NICHT ihr Kehrwert)
}

pub fn EllNew(a: f64, f: f64): Ellipsoid {
  var e: Ellipsoid;
  e.a := a;
  e.f := f;
  return e;
}

// Aus großer Halbachse und dem KEHRWERT der Abplattung — der Form, in der
// jede Tabelle sie nennt.
pub fn EllFromInvF(a: f64, invF: f64): Ellipsoid {
  if (invF == 0.0) { return EllNew(a, 0.0); }
  return EllNew(a, 1.0 / invF);
}

// ── Benannte Ellipsoide ────────────────────────────────────────────────────

pub fn EllWgs84(): Ellipsoid  { return EllFromInvF(6378137.0, 298.257223563); }
pub fn EllGrs80(): Ellipsoid  { return EllFromInvF(6378137.0, 298.257222101); }
pub fn EllBessel1841(): Ellipsoid { return EllFromInvF(6377397.155, 299.1528128); }
pub fn EllClarke1866(): Ellipsoid { return EllFromInvF(6378206.4, 294.9786982); }

// Eine Kugel als Grenzfall — nützlich, um eine Rechnung gegen die
// Kugelformeln aus std.geo.sphere zu halten.
pub fn EllSphere(radius: f64): Ellipsoid { return EllNew(radius, 0.0); }

// ── Abgeleitete Größen ─────────────────────────────────────────────────────

// Kleine Halbachse b = a(1−f).
pub fn EllB(e: Ellipsoid): f64 { return e.a * (1.0 - e.f); }

// Erste numerische Exzentrizität im Quadrat: e² = f(2−f).
pub fn EllE2(e: Ellipsoid): f64 { return e.f * (2.0 - e.f); }

// ZWEITE numerische Exzentrizität im Quadrat: e'² = e²/(1−e²).
// Die Rückrechnung ECEF → geodätisch braucht genau diese.
pub fn EllEp2(e: Ellipsoid): f64 {
  var e2: f64 := EllE2(e);
  var n: f64 := 1.0 - e2;
  if (n == 0.0) { return 0.0; }
  return e2 / n;
}

// Querkrümmungsradius N(φ) — der Krümmungsradius in OST-WEST-Richtung.
// Er geht in die ECEF-Umrechnung ein.
pub fn EllN(e: Ellipsoid, latRad: f64): f64 {
  var s: f64 := SinF64(latRad);
  var w: f64 := 1.0 - EllE2(e) * s * s;
  if (w <= 0.0) { return 0.0; }
  return e.a / SqrtF64(w);
}

// Meridiankrümmungsradius M(φ) — der Krümmungsradius in NORD-SÜD-Richtung.
// Am Äquator KLEINER als N, am Pol gleich. Für eine Nord-Süd-Strecke ist
// dieser der richtige.
pub fn EllM(e: Ellipsoid, latRad: f64): f64 {
  var e2: f64 := EllE2(e);
  var s: f64 := SinF64(latRad);
  var w: f64 := 1.0 - e2 * s * s;
  if (w <= 0.0) { return 0.0; }
  return e.a * (1.0 - e2) / (w * SqrtF64(w));
}

// Mittlerer Krümmungsradius √(M·N) — die Größe, mit der eine lokale
// Kugelnäherung am wenigsten falsch ist.
pub fn EllMeanRadius(e: Ellipsoid, latRad: f64): f64 {
  return SqrtF64(EllM(e, latRad) * EllN(e, latRad));
}

// Länge eines Breitengrads in Metern (Nord-Süd, also über M).
pub fn EllLatDegreeM(e: Ellipsoid, latRad: f64): f64 {
  return EllM(e, latRad) * Pi() / 180.0;
}

// Länge eines Längengrads in Metern (Ost-West, also über N mal cos φ).
// Am Äquator rund 111,3 km, bei 60° Breite nur noch die Hälfte.
pub fn EllLonDegreeM(e: Ellipsoid, latRad: f64): f64 {
  return EllN(e, latRad) * CosF64(latRad) * Pi() / 180.0;
}
