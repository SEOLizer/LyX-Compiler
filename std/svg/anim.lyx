// std/svg/anim.lyx
// SVG SMIL animations: <animate>, <animateTransform>, <animateMotion>, keyframes

@description("SVG SMIL: SvgAnimate, SvgAnimateTransform, SvgAnimateMotion, keyframes")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.svg.anim;

import std.alloc;
import std.svg.xml;

// ============================================================================
// Animation type constants
// ============================================================================

pub con SVG_AT_TRANSLATE: int64 := 0;
pub con SVG_AT_SCALE:     int64 := 1;
pub con SVG_AT_ROTATE:    int64 := 2;
pub con SVG_AT_SKEWX:     int64 := 3;
pub con SVG_AT_SKEWY:     int64 := 4;

// ============================================================================
// Internal helpers: write animation elements to the pending anim buffer
// (elem=0) or directly to the main buffer (elem>0, href targeting)
// ============================================================================

fn _animDurStr(tmp: int64, dur: f64): void {
  var pos: int64 := 0;
  var d100: int64 := svgF64x100(dur);
  var ip: int64 := d100 / 100;
  var frac: int64 := d100 - ip * 100;
  var s: pchar := IntToStr(ip);
  var si: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(s, si);
    if (c == 0) { break; }
    poke8(tmp + pos, c); pos := pos + 1; si := si + 1;
  }
  if (frac != 0) {
    poke8(tmp + pos, 46); pos := pos + 1;
    var d1: int64 := frac / 10;
    var d2: int64 := frac - d1 * 10;
    poke8(tmp + pos, 48 + d1); pos := pos + 1;
    if (d2 != 0) { poke8(tmp + pos, 48 + d2); pos := pos + 1; }
  }
  poke8(tmp + pos, 115); pos := pos + 1;  // 's'
  poke8(tmp + pos, 0);
}

// Write "repeatCount" attribute to buffer (0 = indefinite)
fn _animRepeatStr(tmp: int64, repeatCount: int64): void {
  if (repeatCount == 0) {
    var s: pchar := "indefinite";
    var i: int64 := 0;
    while (true) {
      var c: int64 := StrCharAt(s, i);
      poke8(tmp + i, c);
      if (c == 0) { break; }
      i += 1;
    }
  } else {
    var s: pchar := IntToStr(repeatCount);
    var i: int64 := 0;
    while (true) {
      var c: int64 := StrCharAt(s, i);
      poke8(tmp + i, c);
      if (c == 0) { break; }
      i += 1;
    }
  }
}

// ============================================================================
// Write animate/animateTransform/animateMotion to pending buffer (elem=0)
// or directly to main buffer with href (elem>0)
// ============================================================================

fn _animWriteBegin(doc: int64, elem: int64, tag: pchar): void {
  if (elem == 0) {
    _svgA(doc, "  "); _svgA(doc, tag as pchar); _svgAc(doc, 32);
  } else {
    _svgIndent(doc);
    _svgW(doc, tag as pchar); _svgWc(doc, 32);
    _svgW(doc, "href=\"#_a"); _svgWi(doc, elem); _svgWc(doc, 34); _svgWc(doc, 32);
  }
}

fn _animWriteEnd(doc: int64, elem: int64, dur: f64, repeatCount: int64): void {
  var tmp: int64 := alloc(32);
  if (tmp == 0) { return; }
  _animDurStr(tmp, dur);
  if (elem == 0) {
    _svgA(doc, " dur=\""); _svgA(doc, tmp as pchar);
    _svgAc(doc, 34);
    _svgA(doc, " repeatCount=\"");
    _animRepeatStr(tmp, repeatCount);
    _svgA(doc, tmp as pchar); _svgAc(doc, 34);
    _svgA(doc, "/>");
    _svgAc(doc, 10);  // newline
  } else {
    _svgW(doc, " dur=\""); _svgW(doc, tmp as pchar);   // #1343
    _svgWc(doc, 34);
    _svgW(doc, " repeatCount=\"");
    _animRepeatStr(tmp, repeatCount);
    _svgW(doc, tmp as pchar); _svgWc(doc, 34);   // #1343
    _svgW(doc, "/>"); _svgNL(doc);
  }
  free(tmp, 32);
}

// ============================================================================
// Public API
// ============================================================================

// Set the animation repeatCount count for next animation call.
// 0 = indefinite (default), n = exactly n times.
pub fn SvgAnimRepeat(doc: int64, repeatCount: int64): void {
  if (doc == 0) { return; }
  poke64(doc + SVG_ANIM_REPEAT, repeatCount);
}

// Animate a numeric or string attribute from→to over dur seconds.
// elem=0: queued as child of next SvgApply element.
// elem>0: written directly with href="#_a{elem}".
// Use SvgAnimRepeat to set repeatCount count (default 0=indefinite).
pub fn SvgAnimate(doc: int64, elem: int64, attrName: pchar, fromV: pchar, toV: pchar, dur: f64): void {
  if (doc == 0) { return; }
  var repeatCount: int64 := peek64(doc + SVG_ANIM_REPEAT);
  _animWriteBegin(doc, elem, "<animate");
  if (elem == 0) {
    _svgA(doc, "attributeName=\""); _svgA(doc, attrName as pchar); _svgAc(doc, 34);
    _svgA(doc, " from=\""); _svgA(doc, fromV as pchar); _svgAc(doc, 34);
    _svgA(doc, " to=\""); _svgA(doc, toV as pchar); _svgAc(doc, 34);
  } else {
    _svgW(doc, "attributeName=\""); _svgW(doc, attrName); _svgWc(doc, 34);
    _svgW(doc, " from=\""); _svgW(doc, fromV); _svgWc(doc, 34);
    _svgW(doc, " to=\""); _svgW(doc, toV); _svgWc(doc, 34);
  }
  _animWriteEnd(doc, elem, dur, repeatCount);
}

// Animate a transform attribute (translate/scale/rotate/skewX/skewY).
// Use SvgAnimRepeat to set repeatCount count (default 0=indefinite).
pub fn SvgAnimateTransform(doc: int64, elem: int64, atType: int64, fromV: pchar, toV: pchar, dur: f64): void {
  if (doc == 0) { return; }
  var repeatCount: int64 := peek64(doc + SVG_ANIM_REPEAT);
  _animWriteBegin(doc, elem, "<animateTransform");
  var typeName: pchar := "translate";
  if (atType == SVG_AT_SCALE)    { typeName := "scale"; }
  if (atType == SVG_AT_ROTATE)   { typeName := "rotate"; }
  if (atType == SVG_AT_SKEWX)    { typeName := "skewX"; }
  if (atType == SVG_AT_SKEWY)    { typeName := "skewY"; }
  if (elem == 0) {
    _svgA(doc, "attributeName=\"transform\" type=\""); _svgA(doc, typeName as pchar); _svgAc(doc, 34);
    _svgA(doc, " from=\""); _svgA(doc, fromV as pchar); _svgAc(doc, 34);
    _svgA(doc, " to=\"");   _svgA(doc, toV as pchar);   _svgAc(doc, 34);
    _svgA(doc, " additive=\"sum\"");
  } else {
    _svgW(doc, "attributeName=\"transform\" type=\""); _svgW(doc, typeName); _svgWc(doc, 34);
    _svgW(doc, " from=\""); _svgW(doc, fromV); _svgWc(doc, 34);
    _svgW(doc, " to=\"");   _svgW(doc, toV);   _svgWc(doc, 34);
    _svgW(doc, " additive=\"sum\"");
  }
  _animWriteEnd(doc, elem, dur, repeatCount);
}

// Animate along an SVG path string.
pub fn SvgAnimateMotion(doc: int64, elem: int64, motionPath: pchar, dur: f64, repeatCount: int64): void {
  if (doc == 0) { return; }
  if (elem == 0) {
    _svgA(doc, "  <animateMotion path=\""); _svgA(doc, motionPath as pchar); _svgAc(doc, 34);
  } else {
    _svgIndent(doc);
    _svgW(doc, "<animateMotion href=\"#_a"); _svgWi(doc, elem); _svgWc(doc, 34);
    _svgWc(doc, 32);
    _svgW(doc, "path=\""); _svgW(doc, motionPath); _svgWc(doc, 34);
  }
  _animWriteEnd(doc, elem, dur, repeatCount);
}

// Animate along a path with auto-rotation (object follows direction of travel).
pub fn SvgAnimateMotionRotate(doc: int64, elem: int64, motionPath: pchar, dur: f64, repeatCount: int64): void {
  if (doc == 0) { return; }
  if (elem == 0) {
    _svgA(doc, "  <animateMotion path=\""); _svgA(doc, motionPath as pchar); _svgAc(doc, 34);
    _svgA(doc, " rotate=\"auto\"");
  } else {
    _svgIndent(doc);
    _svgW(doc, "<animateMotion href=\"#_a"); _svgWi(doc, elem); _svgWc(doc, 34);
    _svgWc(doc, 32);
    _svgW(doc, "path=\""); _svgW(doc, motionPath); _svgWc(doc, 34);
    _svgW(doc, " rotate=\"auto\"");
  }
  _animWriteEnd(doc, elem, dur, repeatCount);
}

// Animate a color attribute.
// Use SvgAnimRepeat to set repeatCount count (default 0=indefinite).
pub fn SvgAnimateColor(doc: int64, elem: int64, attrName: pchar, fromHex: pchar, toHex: pchar, dur: f64): void {
  if (doc == 0) { return; }
  var repeatCount: int64 := peek64(doc + SVG_ANIM_REPEAT);
  _animWriteBegin(doc, elem, "<animate");
  if (elem == 0) {
    _svgA(doc, "attributeName=\""); _svgA(doc, attrName as pchar); _svgAc(doc, 34);
    _svgA(doc, " from=\""); _svgA(doc, fromHex as pchar); _svgAc(doc, 34);
    _svgA(doc, " to=\"");   _svgA(doc, toHex as pchar);   _svgAc(doc, 34);
  } else {
    _svgW(doc, "attributeName=\""); _svgW(doc, attrName); _svgWc(doc, 34);
    _svgW(doc, " from=\""); _svgW(doc, fromHex); _svgWc(doc, 34);
    _svgW(doc, " to=\"");   _svgW(doc, toHex);   _svgWc(doc, 34);
  }
  _animWriteEnd(doc, elem, dur, repeatCount);
}

// ============================================================================
// Keyframe animation (multi-value animate)
// Builds <animate> with values and keyTimes attributes.
// Uses SVG_KF_* fields in the doc struct for temporary storage.
// ============================================================================

// Begin a keyframe sequence. Returns a "kf handle" (same as doc pointer).
pub fn SvgKeyframesBegin(doc: int64, elem: int64, attrName: pchar): int64 {
  if (doc == 0) { return 0; }
  // Store attrName in KF_ATTR, clear KF_COUNT, record elem in KF_TPTR (reuse)
  _svgSetInline(doc, SVG_KF_ATTR, attrName as pchar);
  poke64(doc + SVG_KF_COUNT, 0);
  poke64(doc + SVG_KF_TPTR, elem);
  // Allocate buffers for values and keyTimes strings
  var vbuf: int64 := alloc(2048);
  if (vbuf != 0) { poke64(doc + SVG_KF_VPTR, vbuf); poke64(doc + SVG_KF_VLEN, 0); }
  var tbuf: int64 := alloc(512);
  if (tbuf != 0) { poke64(doc + SVG_PARAM_D, tbuf); poke64(doc + SVG_KF_TLEN, 0); }
  return doc;
}

// Add a keyframe: time in [0.0, 1.0], value as string.
pub fn SvgKeyframe(doc: int64, kf: int64, time: f64, value: pchar): void {
  if (doc == 0) { return; }
  var vbuf: int64 := peek64(doc + SVG_KF_VPTR);
  var tbuf: int64 := peek64(doc + SVG_PARAM_D);
  if (vbuf == 0) { return; }
  var count: int64 := peek64(doc + SVG_KF_COUNT);
  // Separator
  if (count > 0) {
    var vlen: int64 := peek64(doc + SVG_KF_VLEN);
    poke8(vbuf + vlen, 59); poke64(doc + SVG_KF_VLEN, vlen + 1);  // ';'
    if (tbuf != 0) {
      var tlen: int64 := peek64(doc + SVG_KF_TLEN);
      poke8(tbuf + tlen, 59); poke64(doc + SVG_KF_TLEN, tlen + 1);
    }
  }
  // Append value string
  var vlen2: int64 := peek64(doc + SVG_KF_VLEN);
  var vi: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(value, vi);
    if (c == 0) { break; }
    if (vlen2 < 2046) { poke8(vbuf + vlen2, c); vlen2 := vlen2 + 1; }
    vi += 1;
  }
  poke64(doc + SVG_KF_VLEN, vlen2);
  // Append time string
  if (tbuf != 0) {
    var tlen2: int64 := peek64(doc + SVG_KF_TLEN);
    var tmp: int64 := alloc(16);
    if (tmp != 0) {
      var pos: int64 := svgBufF64(tmp, 0, time);
      poke8(tmp + pos, 0);
      var ti: int64 := 0;
      while (true) {
        var c: int64 := StrCharAt(tmp, ti);
        if (c == 0) { break; }
        if (tlen2 < 510) { poke8(tbuf + tlen2, c); tlen2 := tlen2 + 1; }
        ti += 1;
      }
      poke64(doc + SVG_KF_TLEN, tlen2);
      free(tmp, 16);
    }
  }
  poke64(doc + SVG_KF_COUNT, count + 1);
}

// Finalize keyframe animation and write to pending buffer or main buffer.
pub fn SvgKeyframesEnd(doc: int64, kf: int64, dur: f64, repeatCount: int64): void {
  if (doc == 0) { return; }
  var vbuf: int64 := peek64(doc + SVG_KF_VPTR);
  var tbuf: int64 := peek64(doc + SVG_PARAM_D);
  var vlen: int64 := peek64(doc + SVG_KF_VLEN);
  var tlen: int64 := peek64(doc + SVG_KF_TLEN);
  var elem: int64 := peek64(doc + SVG_KF_TPTR);
  if (vbuf == 0) { return; }
  // NUL-terminate
  poke8(vbuf + vlen, 0);
  if (tbuf != 0) { poke8(tbuf + tlen, 0); }

  _animWriteBegin(doc, elem, "<animate");
  if (elem == 0) {
    _svgA(doc, "attributeName=\""); _svgA(doc, doc + SVG_KF_ATTR); _svgAc(doc, 34);
    _svgA(doc, " values=\""); _svgA(doc, vbuf as pchar); _svgAc(doc, 34);
    if (tbuf != 0) { _svgA(doc, " keyTimes=\""); _svgA(doc, tbuf as pchar); _svgAc(doc, 34); }
  } else {
    // #1343: alles rohe Zeiger in int64 — _svgW benennt sie als pchar.
    _svgW(doc, "attributeName=\""); _svgW(doc, (doc + SVG_KF_ATTR) as pchar); _svgWc(doc, 34);
    _svgW(doc, " values=\""); _svgW(doc, vbuf as pchar); _svgWc(doc, 34);
    if (tbuf != 0) { _svgW(doc, " keyTimes=\""); _svgW(doc, tbuf as pchar); _svgWc(doc, 34); }
    _svgW(doc, " calcMode=\"spline\"");
  }
  _animWriteEnd(doc, elem, dur, repeatCount);

  free(vbuf, 2048);
  if (tbuf != 0) { free(tbuf, 512); }
  poke64(doc + SVG_KF_VPTR, 0);
  poke64(doc + SVG_PARAM_D, 0);
  poke64(doc + SVG_KF_COUNT, 0);
}

// Set animation begin trigger (e.g. "otherAnimId.end")
pub fn SvgAnimateBeginOn(doc: int64, anim: int64, otherId: int64, eventName: pchar): void {
  if (doc == 0) { return; }
  // Writes a <set> element targeting anim with begin="_a{otherId}.{event}"
  _svgIndent(doc);
  _svgW(doc, "<set href=\"#_a"); _svgWi(doc, anim); _svgWc(doc, 34);
  _svgW(doc, " begin=\"_a"); _svgWi(doc, otherId);
  _svgWc(doc, 46); _svgW(doc, eventName as pchar); _svgWc(doc, 34);
  _svgW(doc, " fill=\"freeze\"/>"); _svgNL(doc);
}
