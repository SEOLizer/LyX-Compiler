// ============================================================================
// f64 IEEE bit utilities (f64 arithmetic is broken in Lyx — use bit manipulation)
// ============================================================================

// Convert positive f64 to integer × 100 (2 decimal places, rounded)
pub fn svgF64x100(v: f64): int64 {
  var bits: int64 := v as int64;
  bits := bits & 0x7FFFFFFFFFFFFFFF;
  if (bits == 0) { return 0; }
  var exp: int64 := ((bits >> 52) & 0x7FF) - 1023;
  if (exp < -7) { return 0; }
  var mant: int64 := (bits & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
  if (exp >= 52) { return mant * 100 << (exp - 52); }
  var shift: int64 := 52 - exp;
  return (mant * 100 + (1 << (shift - 1))) >> shift;
}

// Extract integer part of positive f64
pub fn svgF64Trunc(v: f64): int64 {
  var bits: int64 := v as int64;
  bits := bits & 0x7FFFFFFFFFFFFFFF;
  if (bits == 0) { return 0; }
  var exp: int64 := ((bits >> 52) & 0x7FF) - 1023;
  if (exp < 0) { return 0; }
  var mant: int64 := (bits & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
  if (exp >= 52) { return mant << (exp - 52); }
  return mant >> (52 - exp);
}

// ============================================================================
// Buffer grow helper (reallocates buffer when capacity is insufficient)
// ============================================================================

fn _svgGrow(doc: int64, ptrOff: int64, lenOff: int64, capOff: int64): void {
  var cap: int64 := peek64(doc + capOff);
  var newcap: int64 := cap * 2;
  var oldptr: int64 := peek64(doc + ptrOff);
  var newptr: int64 := alloc(newcap);
  if (newptr == 0) { return; }
  var len: int64 := peek64(doc + lenOff);
  var i: int64 := 0;
  while (i < len) {
    poke8(newptr + i, peek8(oldptr + i));
    i += 1;
  }
  free(oldptr, cap);
  poke64(doc + ptrOff, newptr);
  poke64(doc + capOff, newcap);
}

fn _svgEnsureMain(doc: int64, needed: int64): void {
  while (peek64(doc + SVG_BUF_CAP) - peek64(doc + SVG_BUF_LEN) < needed) {
    _svgGrow(doc, SVG_BUF_PTR, SVG_BUF_LEN, SVG_BUF_CAP);
  }
}

fn _svgEnsureDefs(doc: int64, needed: int64): void {
  while (peek64(doc + SVG_DEFS_CAP) - peek64(doc + SVG_DEFS_LEN) < needed) {
    _svgGrow(doc, SVG_DEFS_PTR, SVG_DEFS_LEN, SVG_DEFS_CAP);
  }
}

fn _svgEnsurePath(doc: int64, needed: int64): void {
  while (peek64(doc + SVG_PATH_CAP) - peek64(doc + SVG_PATH_LEN) < needed) {
    _svgGrow(doc, SVG_PATH_PTR, SVG_PATH_LEN, SVG_PATH_CAP);
  }
}

// ============================================================================
// Write to main buffer
// ============================================================================

pub fn _svgWc(doc: int64, c: int64): void {
  var len: int64 := peek64(doc + SVG_BUF_LEN);
  if (len >= peek64(doc + SVG_BUF_CAP) - 1) { _svgEnsureMain(doc, 256); }
  poke8(peek64(doc + SVG_BUF_PTR) + len, c);
  poke64(doc + SVG_BUF_LEN, len + 1);
}

pub fn _svgW(doc: int64, s: pchar): void {
  var i: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(s, i);
    if (c == 0) { break; }
    _svgWc(doc, c);
    i += 1;
  }
}

pub fn _svgWi(doc: int64, v: int64): void {
  _svgW(doc, IntToStr(v));
}

pub fn _svgWf(doc: int64, v: f64): void {
  var tmp: int64 := alloc(32);
  if (tmp == 0) { return; }
  var bits: int64 := v as int64;
  var pos: int64 := 0;
  if (bits < 0) { poke8(tmp, 45); pos := 1; }
  var v100: int64 := svgF64x100(v);
  var ip: int64 := v100 / 100;
  var frac: int64 := v100 - ip * 100;
  var s: pchar := IntToStr(ip);
  var si: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(s, si);
    if (c == 0) { break; }
    poke8(tmp + pos, c); pos := pos + 1; si := si + 1;
  }
  if (frac != 0) {
    poke8(tmp + pos, 46); pos := pos + 1;
    var d1: int64 := frac / 10;
    var d2: int64 := frac - d1 * 10;
    poke8(tmp + pos, 48 + d1); pos := pos + 1;
    if (d2 != 0) { poke8(tmp + pos, 48 + d2); pos := pos + 1; }
  }
  poke8(tmp + pos, 0);
  _svgW(doc, tmp as pchar);   // #1272
  free(tmp, 32);
}

pub fn _svgWbytes(doc: int64, src: int64, n: int64): void {
  _svgEnsureMain(doc, n + 1);
  var len: int64 := peek64(doc + SVG_BUF_LEN);
  var buf: int64 := peek64(doc + SVG_BUF_PTR);
  var i: int64 := 0;
  while (i < n) {
    poke8(buf + len + i, peek8(src + i));
    i += 1;
  }
  poke64(doc + SVG_BUF_LEN, len + n);
}

pub fn _svgWinline(doc: int64, offset: int64): void {
  var i: int64 := 0;
  while (true) {
    var c: int64 := peek8(doc + offset + i);
    if (c == 0) { break; }
    _svgWc(doc, c);
    i += 1;
  }
}

