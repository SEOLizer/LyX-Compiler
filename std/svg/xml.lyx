// ============================================================================
// Indentation / newline helpers
// ============================================================================

pub fn _svgIndent(doc: int64): void {
  if (peek64(doc + SVG_PRETTY) == 0) { return; }
  var d: int64 := peek64(doc + SVG_DEPTH);
  var i: int64 := 0;
  while (i < d * 2) { _svgWc(doc, 32); i := i + 1; }
}

pub fn _svgNL(doc: int64): void {
  if (peek64(doc + SVG_PRETTY) != 0) { _svgWc(doc, 10); }
}

pub fn _defsIndent(doc: int64): void {
  if (peek64(doc + SVG_PRETTY) != 0) { _svgD(doc, "    "); }
}

pub fn _defsNL(doc: int64): void {
  if (peek64(doc + SVG_PRETTY) != 0) { _svgDc(doc, 10); }
}

// ============================================================================
// Inline string helpers
// ============================================================================

pub fn _svgSetInline(doc: int64, offset: int64, s: pchar): void {
  var i: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(s, i);
    poke8(doc + offset + i, c);
    if (c == 0) { break; }
    i += 1;
  }
}

pub fn _svgInlineLen(doc: int64, offset: int64): int64 {
  var i: int64 := 0;
  while (peek8(doc + offset + i) != 0) { i := i + 1; }
  return i;
}

// Copy inline string from doc struct to output buffer, return new pos
pub fn _svgCopyInline(out: int64, pos: int64, doc: int64, offset: int64): int64 {
  var i: int64 := 0;
  while (true) {
    var c: int64 := peek8(doc + offset + i);
    if (c == 0) { break; }
    poke8(out + pos, c);
    pos += 1;
    i += 1;
  }
  return pos;
}

// Append s to inline transform buffer (SVG_TRANSFORM, 512 bytes)
pub fn _svgTransformAppend(doc: int64, s: pchar): void {
  var len: int64 := _svgInlineLen(doc, SVG_TRANSFORM);
  var i: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(s, i);
    if (c == 0) { break; }
    if (len < 510) { poke8(doc + SVG_TRANSFORM + len, c); len := len + 1; }
    i += 1;
  }
  poke8(doc + SVG_TRANSFORM + len, 0);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_TRANSFORM);
}

// ============================================================================
// Color conversion: r,g,b f64 [0..1] → "#rrggbb\0" (8 bytes written to out)
// ============================================================================

fn _svgHexByte(v: int64, out: int64): void {
  var hi: int64 := v >> 4;
  var lo: int64 := v & 15;
  if (hi < 10) { poke8(out, 48 + hi); } else { poke8(out, 87 + hi); }
  if (lo < 10) { poke8(out + 1, 48 + lo); } else { poke8(out + 1, 87 + lo); }
}

pub fn svgColorHex(r: f64, g: f64, b: f64, out: int64): void {
  poke8(out, 35);
  var rv: int64 := svgF64x100(r);
  var gv: int64 := svgF64x100(g);
  var bv: int64 := svgF64x100(b);
  if (rv > 100) { rv := 100; }
  if (gv > 100) { gv := 100; }
  if (bv > 100) { bv := 100; }
  _svgHexByte((rv * 255 + 50) / 100, out + 1);
  _svgHexByte((gv * 255 + 50) / 100, out + 3);
  _svgHexByte((bv * 255 + 50) / 100, out + 5);
  poke8(out + 7, 0);
}

// Write "rgb 100-based value as 2dp decimal" to buffer at pos, return new pos
pub fn svgBufF64r2x100(buf: int64, pos: int64, v100: int64): int64 {
  if (v100 < 0) {
    poke8(buf + pos, 45); pos := pos + 1;
    v100 := 0 - v100;
  }
  var ip: int64 := v100 / 100;
  var frac: int64 := v100 - ip * 100;
  var s: pchar := IntToStr(ip);
  var i: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(s, i);
    if (c == 0) { break; }
    poke8(buf + pos, c); pos := pos + 1; i := i + 1;
  }
  if (frac == 0) { return pos; }
  poke8(buf + pos, 46); pos := pos + 1;
  var d1: int64 := frac / 10;
  var d2: int64 := frac - d1 * 10;
  poke8(buf + pos, 48 + d1); pos := pos + 1;
  if (d2 != 0) { poke8(buf + pos, 48 + d2); pos := pos + 1; }
  return pos;
}

// Write integer to buffer at pos, return new pos
pub fn svgBufInt(buf: int64, pos: int64, v: int64): int64 {
  var s: pchar := IntToStr(v);
  var i: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(s, i);
    if (c == 0) { break; }
    poke8(buf + pos, c); pos := pos + 1; i := i + 1;
  }
  return pos;
}

// Write string to buffer at pos, return new pos
pub fn svgBufStr(buf: int64, pos: int64, s: pchar): int64 {
  var i: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(s, i);
    if (c == 0) { break; }
    poke8(buf + pos, c); pos := pos + 1; i := i + 1;
  }
  return pos;
}

// Write f64 (2 decimal places) to buffer at pos, return new pos
pub fn svgBufF64(buf: int64, pos: int64, v: f64): int64 {
  var bits: int64 := v as int64;
  if (bits < 0) { poke8(buf + pos, 45); pos := pos + 1; }
  return svgBufF64r2x100(buf, pos, svgF64x100(v));
}

// XML-escape text content to main buffer
pub fn _svgWescText(doc: int64, s: pchar): void {
  var i: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(s, i);
    if (c == 0) { break; }
    if (c == 38) { _svgW(doc, "&amp;"); }
    else { if (c == 60) { _svgW(doc, "&lt;"); }
    else { if (c == 62) { _svgW(doc, "&gt;"); }
    else { _svgWc(doc, c); } } }
    i += 1;
  }
}

// XML-escape attribute value to main buffer
pub fn _svgWescAttr(doc: int64, s: pchar): void {
  var i: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(s, i);
    if (c == 0) { break; }
    if (c == 38) { _svgW(doc, "&amp;"); }
    else { if (c == 60) { _svgW(doc, "&lt;"); }
    else { if (c == 62) { _svgW(doc, "&gt;"); }
    else { if (c == 34) { _svgW(doc, "&quot;"); }
    else { _svgWc(doc, c); } } } }
    i += 1;
  }
}

// ============================================================================
// Pending animation buffer (SVG_ANIM_BUF: 1020 bytes inline in doc struct)
// Used by anim.lyx to queue child <animate> elements before SvgApply flushes them.
// ============================================================================

pub fn _svgAc(doc: int64, c: int64): void {
  var len: int64 := peek64(doc + SVG_ANIM_LEN);
  if (len < 1019) {
    poke8(doc + SVG_ANIM_BUF + len, c);
    poke64(doc + SVG_ANIM_LEN, len + 1);
  }
}

pub fn _svgA(doc: int64, s: pchar): void {
  var i: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(s, i);
    if (c == 0) { break; }
    _svgAc(doc, c);
    i += 1;
  }
}

pub fn _svgAi(doc: int64, v: int64): void {
  _svgA(doc, IntToStr(v));
}

pub fn _svgAf(doc: int64, v: f64): void {
  var tmp: int64 := alloc(32);
  if (tmp == 0) { return; }
  var bits: int64 := v as int64;
  var pos: int64 := 0;
  if (bits < 0) { poke8(tmp, 45); pos := 1; }
  var v100: int64 := svgF64x100(v);
  var ip: int64 := v100 / 100;
  var frac: int64 := v100 - ip * 100;
  var s: pchar := IntToStr(ip);
  var si: int64 := 0;
  while (true) {
    var c: int64 := StrCharAt(s, si);
    if (c == 0) { break; }
    poke8(tmp + pos, c); pos := pos + 1; si := si + 1;
  }
  if (frac != 0) {
    poke8(tmp + pos, 46); pos := pos + 1;
    var d1: int64 := frac / 10;
    var d2: int64 := frac - d1 * 10;
    poke8(tmp + pos, 48 + d1); pos := pos + 1;
    if (d2 != 0) { poke8(tmp + pos, 48 + d2); pos := pos + 1; }
  }
  poke8(tmp + pos, 0);
  _svgA(doc, tmp as pchar);   // #1272
  free(tmp, 32);
}

// ============================================================================
// Integer × 100 → f64 conversion (inverse of svgF64x100)
// Constructs valid IEEE 754 bits via bit manipulation (f64 arithmetic broken)
// ============================================================================

pub fn svgInt100ToF64(v100: int64): f64 {
  if (v100 == 0) { return 0 as f64; }
  var sign: int64 := 0;
  if (v100 < 0) { sign := 1; v100 := 0 - v100; }
  // Find binary exponent e: 2^e <= v100/100 < 2^(e+1)
  var e: int64 := 0;
  var intPart: int64 := v100 / 100;
  if (intPart >= 1) {
    var tmp: int64 := intPart;
    while (tmp > 1) { tmp := tmp >> 1; e := e + 1; }
  } else {
    e := -1;
    var tmp: int64 := v100 + v100;  // v100 * 2
    while (tmp < 100) { tmp := tmp + tmp; e := e - 1; }
  }
  // Compute mantissa numerator and denominator
  var num: int64 := 0;
  var denom: int64 := 0;
  if (e >= 0) {
    var twoE: int64 := 1;
    var k: int64 := 0;
    while (k < e) { twoE := twoE + twoE; k := k + 1; }
    num := v100 - 100 * twoE;
    denom := 100 * twoE;
  } else {
    var twoNegE: int64 := 1;
    var k: int64 := 0;
    var negE: int64 := 0 - e;
    while (k < negE) { twoNegE := twoNegE + twoNegE; k := k + 1; }
    num := v100 * twoNegE - 100;
    denom := 100;
  }
  // Bit-by-bit mantissa: floor(num * 2^52 / denom)
  var mant: int64 := 0;
  var bit: int64 := 51;
  while (bit >= 0) {
    num += num;
    if (num >= denom) { mant := mant | (1 << bit); num := num - denom; }
    bit -= 1;
  }
  var biasedExp: int64 := e + 1023;
  var hi: int64 := (sign << 31) | (biasedExp << 20) | (mant >> 32);
  var lo: int64 := mant & 0xFFFFFFFF;
  var bits: int64 := (hi << 32) | lo;
  return bits as f64;
}
