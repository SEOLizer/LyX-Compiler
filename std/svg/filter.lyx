pub fn SvgBrightnessContrast(doc: int64, brightness: f64, contrast: f64): int64 {
  if (doc == 0) { return -1; }
  var fid: int64 := _svgNextId(doc);
  _defsIndent(doc);
  _svgD(doc, "<filter id=\"flt");
  _svgDi(doc, fid);
  _svgD(doc, "\">");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "  <feComponentTransfer>");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "    <feFuncR type=\"linear\" slope=\"");
  _svgDf(doc, contrast);
  _svgD(doc, "\" intercept=\"");
  _svgDf(doc, brightness);
  _svgD(doc, "\"/>");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "    <feFuncG type=\"linear\" slope=\"");
  _svgDf(doc, contrast);
  _svgD(doc, "\" intercept=\"");
  _svgDf(doc, brightness);
  _svgD(doc, "\"/>");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "    <feFuncB type=\"linear\" slope=\"");
  _svgDf(doc, contrast);
  _svgD(doc, "\" intercept=\"");
  _svgDf(doc, brightness);
  _svgD(doc, "\"/>");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "  </feComponentTransfer>");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "</filter>");
  _defsNL(doc);
  return fid;
}

// ============================================================================
// Manual filter builder
// ============================================================================

pub fn SvgFilterBegin(doc: int64, id: pchar, x: f64, y: f64, w: f64, h: f64): int64 {
  if (doc == 0) { return -1; }
  var fid: int64 := _svgNextId(doc);
  _defsIndent(doc);
  _svgD(doc, "<filter id=\"flt");
  _svgDi(doc, fid);
  _svgDc(doc, 34);
  _svgD(doc, " x=\""); _svgDf(doc, x); _svgDc(doc, 34);
  _svgD(doc, " y=\""); _svgDf(doc, y); _svgDc(doc, 34);
  _svgD(doc, " width=\""); _svgDf(doc, w); _svgDc(doc, 34);
  _svgD(doc, " height=\""); _svgDf(doc, h); _svgDc(doc, 34);
  _svgD(doc, ">");
  _defsNL(doc);
  return fid;
}

pub fn SvgFilterEnd(doc: int64): void {
  if (doc == 0) { return; }
  _defsIndent(doc);
  _svgD(doc, "</filter>");
  _defsNL(doc);
}

pub fn SvgFeGaussianBlur(doc: int64, flt: int64, src: pchar, stdX: f64, stdY: f64): void {
  if (doc == 0) { return; }
  _defsIndent(doc);
  _svgD(doc, "  <feGaussianBlur in=\"");
  if (src == 0) { _svgD(doc, "SourceGraphic"); }
  else {
    var c: int64 := StrCharAt(src, 0);
    if (c == 0) { _svgD(doc, "SourceGraphic"); } else { _svgD(doc, src); }
  }
  _svgD(doc, "\" stdDeviation=\"");
  _svgDf(doc, stdX); _svgDc(doc, 32); _svgDf(doc, stdY);
  _svgD(doc, "\"/>");
  _defsNL(doc);
}

pub fn SvgFeOffset(doc: int64, flt: int64, src: pchar, dx: f64, dy: f64): void {
  if (doc == 0) { return; }
  _defsIndent(doc);
  _svgD(doc, "  <feOffset");
  if (src != 0) {
    var c: int64 := StrCharAt(src, 0);
    if (c != 0) {
      _svgD(doc, " in=\""); _svgD(doc, src); _svgDc(doc, 34);
    }
  }
  _svgD(doc, " dx=\""); _svgDf(doc, dx);
  _svgD(doc, "\" dy=\""); _svgDf(doc, dy);
  _svgD(doc, "\"/>");
  _defsNL(doc);
}

pub fn SvgFeComposite(doc: int64, flt: int64, in1: pchar, in2: pchar, op: int64): void {
  if (doc == 0) { return; }
  _defsIndent(doc);
  _svgD(doc, "  <feComposite");
  if (in1 != 0) {
    var c: int64 := StrCharAt(in1, 0);
    if (c != 0) { _svgD(doc, " in=\""); _svgD(doc, in1); _svgDc(doc, 34); }
  }
  if (in2 != 0) {
    var c2: int64 := StrCharAt(in2, 0);
    if (c2 != 0) { _svgD(doc, " in2=\""); _svgD(doc, in2); _svgDc(doc, 34); }
  }
  _svgD(doc, " operator=\"");
  if (op == SVG_COMP_IN) { _svgD(doc, "in"); }
  else { if (op == SVG_COMP_OUT) { _svgD(doc, "out"); }
  else { if (op == SVG_COMP_ATOP) { _svgD(doc, "atop"); }
  else { if (op == SVG_COMP_XOR) { _svgD(doc, "xor"); }
  else { _svgD(doc, "over"); } } } }
  _svgD(doc, "\"/>");
  _defsNL(doc);
}

pub fn SvgFeColorMatrix(doc: int64, flt: int64, src: pchar, cmType: int64, val: f64): void {
  if (doc == 0) { return; }
  _defsIndent(doc);
  _svgD(doc, "  <feColorMatrix type=\"");
  if (cmType == SVG_CM_SATURATE) { _svgD(doc, "saturate"); }
  else { if (cmType == SVG_CM_HUE_ROTATE) { _svgD(doc, "hueRotate"); }
  else { if (cmType == SVG_CM_LUM_ALPHA) { _svgD(doc, "luminanceToAlpha"); }
  else { _svgD(doc, "matrix"); } } }
  _svgD(doc, "\" values=\"");
  _svgDf(doc, val);
  _svgD(doc, "\"/>");
  _defsNL(doc);
}

// ============================================================================
// Mask
// ============================================================================

pub fn SvgMaskBegin(doc: int64, id: pchar): int64 {
  if (doc == 0) { return -1; }
  var mid: int64 := _svgNextId(doc);
  _defsIndent(doc);
  _svgD(doc, "<mask id=\"msk");
  _svgDi(doc, mid);
  _svgD(doc, "\" maskUnits=\"userSpaceOnUse\">");
  _defsNL(doc);
  return mid;
}

pub fn SvgMaskEnd(doc: int64): void {
  if (doc == 0) { return; }
  _defsIndent(doc);
  _svgD(doc, "</mask>");
  _defsNL(doc);
}
