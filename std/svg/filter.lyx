// std/svg/filter.lyx
// SVG filter effects: blur, drop shadow, grayscale, sepia, masks

@description("SVG filters: SvgDropShadow, SvgBlur, SvgGrayscale, SvgSepia, SvgMask")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.svg.filter;

import std.svg.xml;

pub con SVG_COMP_OVER:  int64 := 0;
pub con SVG_COMP_IN:    int64 := 1;
pub con SVG_COMP_OUT:   int64 := 2;
pub con SVG_COMP_ATOP:  int64 := 3;
pub con SVG_COMP_XOR:   int64 := 4;
pub con SVG_CM_MATRIX:      int64 := 0;
pub con SVG_CM_SATURATE:    int64 := 1;
pub con SVG_CM_HUE_ROTATE:  int64 := 2;
pub con SVG_CM_LUM_ALPHA:   int64 := 3;

fn _svgNextId(doc: int64): int64 {
  var id: int64 := peek64(doc + SVG_DEF_CNT);
  poke64(doc + SVG_DEF_CNT, id + 1);
  return id;
}

// ============================================================================
// Drop shadow filter
// ============================================================================

pub fn SvgDropShadow(doc: int64, dx: f64, dy: f64, blur: f64, opacity: f64): int64 {
  if (doc == 0) { return -1; }
  var fid: int64 := _svgNextId(doc);
  _defsIndent(doc);
  _svgD(doc, "<filter id=\"flt");
  _svgDi(doc, fid);
  _svgD(doc, "\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "  <feGaussianBlur in=\"SourceAlpha\" stdDeviation=\"");
  _svgDf(doc, blur);
  _svgD(doc, "\" result=\"blur\"/>");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "  <feOffset dx=\"");
  _svgDf(doc, dx);
  _svgD(doc, "\" dy=\"");
  _svgDf(doc, dy);
  _svgD(doc, "\" result=\"shadow\"/>");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "  <feFlood flood-color=\"#000000\" flood-opacity=\"");
  _svgDf(doc, opacity);
  _svgD(doc, "\" result=\"color\"/>");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "  <feComposite in=\"color\" in2=\"shadow\" operator=\"in\" result=\"shadow2\"/>");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "  <feMerge>");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "    <feMergeNode in=\"shadow2\"/>");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "    <feMergeNode in=\"SourceGraphic\"/>");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "  </feMerge>");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "</filter>");
  _defsNL(doc);
  return fid;
}

// ============================================================================
// Blur filter
// ============================================================================

pub fn SvgBlur(doc: int64, stdDeviation: f64): int64 {
  if (doc == 0) { return -1; }
  var fid: int64 := _svgNextId(doc);
  _defsIndent(doc);
  _svgD(doc, "<filter id=\"flt");
  _svgDi(doc, fid);
  _svgD(doc, "\">");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "  <feGaussianBlur stdDeviation=\"");
  _svgDf(doc, stdDeviation);
  _svgD(doc, "\"/>");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "</filter>");
  _defsNL(doc);
  return fid;
}

// ============================================================================
// Color matrix filters (grayscale, sepia, invert)
// ============================================================================

pub fn SvgGrayscale(doc: int64): int64 {
  if (doc == 0) { return -1; }
  var fid: int64 := _svgNextId(doc);
  _defsIndent(doc);
  _svgD(doc, "<filter id=\"flt");
  _svgDi(doc, fid);
  _svgD(doc, "\">");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "  <feColorMatrix type=\"saturate\" values=\"0\"/>");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "</filter>");
  _defsNL(doc);
  return fid;
}

pub fn SvgSepia(doc: int64): int64 {
  if (doc == 0) { return -1; }
  var fid: int64 := _svgNextId(doc);
  _defsIndent(doc);
  _svgD(doc, "<filter id=\"flt");
  _svgDi(doc, fid);
  _svgD(doc, "\">");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "  <feColorMatrix type=\"matrix\"");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "    values=\"0.393 0.769 0.189 0 0");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "            0.349 0.686 0.168 0 0");
  _defsNL(doc);
  _defsIndent(doc);
  _svgD(doc, "            0.272 0.534 0.131 0 0");
  _defsNL(doc);
  _defsIndent(doc);
