unit std.svg.text;

import std.alloc;
import std.svg.xml;
import std.svg.elements;

// ============================================================================
// Text constants
// ============================================================================
pub con SVG_ANCHOR_START:   int64 := 0;
pub con SVG_ANCHOR_MIDDLE:  int64 := 1;
pub con SVG_ANCHOR_END:     int64 := 2;
pub con SVG_WEIGHT_NORMAL:  int64 := 0;
pub con SVG_WEIGHT_BOLD:    int64 := 1;
pub con SVG_STYLE_NORMAL:   int64 := 0;
pub con SVG_STYLE_ITALIC:   int64 := 1;
pub con SVG_DECO_NONE:      int64 := 0;
pub con SVG_DECO_UNDERLINE: int64 := 1;
pub con SVG_DECO_STRIKE:    int64 := 2;
pub con SVG_DECO_OVERLINE:  int64 := 3;
pub con SVG_BASELINE_AUTO:    int64 := 0;
pub con SVG_BASELINE_MIDDLE:  int64 := 1;
pub con SVG_BASELINE_HANGING: int64 := 2;

// ============================================================================
// Font / text style setters
// ============================================================================

pub fn SvgSetFont(doc: int64, family: pchar, size: f64): void {
  if (doc == 0) { return; }
  _svgSetInline(doc, SVG_FONT_FAM, family as pchar);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_FONT_FAM);
  var tmp: int64 := alloc(16);
  if (tmp == 0) { return; }
  var pos: int64 := svgBufF64(tmp, 0, size);
  poke8(tmp + pos, 0);
  _svgSetInline(doc, SVG_FONT_SZ, tmp as pchar);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_FONT_SZ);
  free(tmp, 16);
}

pub fn SvgSetFontWeight(doc: int64, weight: int64): void {
  if (doc == 0) { return; }
  if (weight == SVG_WEIGHT_BOLD) { _svgSetInline(doc, SVG_FONT_WT, "bold"); }
  else { _svgSetInline(doc, SVG_FONT_WT, "normal"); }
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_FONT_WT);
}

pub fn SvgSetFontStyle(doc: int64, style: int64): void {
  if (doc == 0) { return; }
  if (style == SVG_STYLE_ITALIC) { _svgSetInline(doc, SVG_FONT_ST, "italic"); }
  else { _svgSetInline(doc, SVG_FONT_ST, "normal"); }
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_FONT_ST);
}

pub fn SvgSetTextAnchor(doc: int64, anchor: int64): void {
  if (doc == 0) { return; }
  if (anchor == SVG_ANCHOR_MIDDLE) { _svgSetInline(doc, SVG_TEXT_ANC, "middle"); }
  else { if (anchor == SVG_ANCHOR_END) { _svgSetInline(doc, SVG_TEXT_ANC, "end"); }
  else { _svgSetInline(doc, SVG_TEXT_ANC, "start"); } }
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_TEXT_ANC);
}

pub fn SvgSetDominantBaseline(doc: int64, baseline: int64): void {
  if (doc == 0) { return; }
  if (baseline == SVG_BASELINE_MIDDLE) { _svgSetInline(doc, SVG_DOM_BASE, "middle"); }
  else { if (baseline == SVG_BASELINE_HANGING) { _svgSetInline(doc, SVG_DOM_BASE, "hanging"); }
  else { _svgSetInline(doc, SVG_DOM_BASE, "auto"); } }
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_DOM_BASE);
}

pub fn SvgSetLetterSpacing(doc: int64, spacing: f64): void {
  if (doc == 0) { return; }
  var tmp: int64 := alloc(16);
  if (tmp == 0) { return; }
  var pos: int64 := svgBufF64(tmp, 0, spacing);
  poke8(tmp + pos, 0);
  _svgSetInline(doc, SVG_LSPC, tmp as pchar);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_LSPC);
  free(tmp, 16);
}

pub fn SvgSetWordSpacing(doc: int64, spacing: f64): void {
  if (doc == 0) { return; }
  var tmp: int64 := alloc(16);
  if (tmp == 0) { return; }
  var pos: int64 := svgBufF64(tmp, 0, spacing);
  poke8(tmp + pos, 0);
  _svgSetInline(doc, SVG_WSPC, tmp as pchar);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_WSPC);
  free(tmp, 16);
}

pub fn SvgSetTextDecoration(doc: int64, deco: int64): void {
  if (doc == 0) { return; }
  if (deco == SVG_DECO_UNDERLINE)  { _svgSetInline(doc, SVG_TEXT_DEC, "underline"); }
  else { if (deco == SVG_DECO_STRIKE) { _svgSetInline(doc, SVG_TEXT_DEC, "line-through"); }
  else { if (deco == SVG_DECO_OVERLINE) { _svgSetInline(doc, SVG_TEXT_DEC, "overline"); }
  else { _svgSetInline(doc, SVG_TEXT_DEC, "none"); } } }
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_TEXT_DEC);
}

// ============================================================================
// Text element with SvgApply pattern
// ============================================================================

// _svgWriteTextCommonAttrs: writes x,y plus all font/text-style attrs + fill/stroke
fn _svgWriteTextAttrs(doc: int64, x: f64, y: f64): void {
  _svgW(doc, " x=\""); _svgWf(doc, x); _svgWc(doc, 34);
  _svgW(doc, " y=\""); _svgWf(doc, y); _svgWc(doc, 34);
}

// SvgTextAt: single-line text. Call SvgSetFont etc. before, then SvgApply.
// Uses SVG_ELEM_TEXT so SvgApply also writes text-style attrs.
pub fn SvgTextAt(doc: int64, x: f64, y: f64, text: pchar): void {
  if (doc == 0) { return; }
  _svgFlushPendingGroup(doc);
  // Write inline text element directly (no pending style for text content)
  _svgIndent(doc);
  _svgW(doc, "<text");
  _svgWriteTextAttrs(doc, x, y);
  // write text styles from flags
  var flags: int64 := peek64(doc + SVG_FLAGS);
  if (flags & SVG_FLAG_FONT_FAM != 0) {
    _svgW(doc, " font-family=\""); _svgWinline(doc, SVG_FONT_FAM); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_FONT_SZ != 0) {
    _svgW(doc, " font-size=\""); _svgWinline(doc, SVG_FONT_SZ); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_FONT_WT != 0) {
    _svgW(doc, " font-weight=\""); _svgWinline(doc, SVG_FONT_WT); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_FONT_ST != 0) {
    _svgW(doc, " font-style=\""); _svgWinline(doc, SVG_FONT_ST); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_TEXT_ANC != 0) {
    _svgW(doc, " text-anchor=\""); _svgWinline(doc, SVG_TEXT_ANC); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_DOM_BASE != 0) {
    _svgW(doc, " dominant-baseline=\""); _svgWinline(doc, SVG_DOM_BASE); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_LSPC != 0) {
    _svgW(doc, " letter-spacing=\""); _svgWinline(doc, SVG_LSPC); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_WSPC != 0) {
    _svgW(doc, " word-spacing=\""); _svgWinline(doc, SVG_WSPC); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_TEXT_DEC != 0) {
    _svgW(doc, " text-decoration=\""); _svgWinline(doc, SVG_TEXT_DEC); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_FILL != 0) {
    _svgW(doc, " fill=\""); _svgWinline(doc, SVG_FILL); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_OPACITY != 0) {
    _svgW(doc, " opacity=\""); _svgWinline(doc, SVG_OPACITY); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_TRANSFORM != 0) {
    _svgW(doc, " transform=\""); _svgWinline(doc, SVG_TRANSFORM); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_ID != 0) {
    _svgW(doc, " id=\""); _svgWescAttr(doc, doc + SVG_CUR_ID); _svgWc(doc, 34);
  }
  poke8(doc + SVG_FLAGS, 0); poke64(doc + SVG_FLAGS, 0);
  poke8(doc + SVG_TRANSFORM, 0);
  _svgWc(doc, 62);  // '>'
  _svgWescText(doc, text);
  _svgW(doc, "</text>");
  _svgNL(doc);
}

// ============================================================================
// Multi-line text block
// ============================================================================

pub fn SvgTextBegin(doc: int64, x: f64, y: f64): int64 {
  if (doc == 0) { return 0; }
  _svgFlushPendingGroup(doc);
  _svgIndent(doc);
  _svgW(doc, "<text");
  _svgW(doc, " x=\""); _svgWf(doc, x); _svgWc(doc, 34);
  _svgW(doc, " y=\""); _svgWf(doc, y); _svgWc(doc, 34);
  var flags: int64 := peek64(doc + SVG_FLAGS);
  if (flags & SVG_FLAG_FONT_FAM != 0) {
    _svgW(doc, " font-family=\""); _svgWinline(doc, SVG_FONT_FAM); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_FONT_SZ != 0) {
    _svgW(doc, " font-size=\""); _svgWinline(doc, SVG_FONT_SZ); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_TEXT_ANC != 0) {
    _svgW(doc, " text-anchor=\""); _svgWinline(doc, SVG_TEXT_ANC); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_FILL != 0) {
    _svgW(doc, " fill=\""); _svgWinline(doc, SVG_FILL); _svgWc(doc, 34);
  }
  poke64(doc + SVG_FLAGS, 0);
  poke8(doc + SVG_TRANSFORM, 0);
  _svgWc(doc, 62); _svgNL(doc);
  poke64(doc + SVG_DEPTH, peek64(doc + SVG_DEPTH) + 1);
  poke64(doc + SVG_TEXT_OPEN, 1);
  return 1;
}

pub fn SvgTspan(doc: int64, text: pchar, dx: f64, dy: f64): void {
  if (doc == 0) { return; }
  _svgIndent(doc);
  _svgW(doc, "<tspan");
  if ((dx as int64) != 0) {
    _svgW(doc, " dx=\""); _svgWf(doc, dx); _svgWc(doc, 34);
  }
  if ((dy as int64) != 0) {
    _svgW(doc, " dy=\""); _svgWf(doc, dy); _svgWc(doc, 34);
  }
  _svgWc(doc, 62);
  _svgWescText(doc, text);
  _svgW(doc, "</tspan>");
  _svgNL(doc);
}

pub fn SvgTspanStyle(doc: int64, text: pchar, weight: int64, dx: f64, dy: f64): void {
  if (doc == 0) { return; }
  _svgIndent(doc);
  _svgW(doc, "<tspan");
  if (weight == SVG_WEIGHT_BOLD) { _svgW(doc, " font-weight=\"bold\""); }
  if ((dx as int64) != 0) {
    _svgW(doc, " dx=\""); _svgWf(doc, dx); _svgWc(doc, 34);
  }
  if ((dy as int64) != 0) {
    _svgW(doc, " dy=\""); _svgWf(doc, dy); _svgWc(doc, 34);
  }
  _svgWc(doc, 62);
  _svgWescText(doc, text);
  _svgW(doc, "</tspan>");
  _svgNL(doc);
}

pub fn SvgTextEnd(doc: int64): void {
  if (doc == 0) { return; }
  poke64(doc + SVG_TEXT_OPEN, 0);
  var d: int64 := peek64(doc + SVG_DEPTH);
  if (d > 1) { poke64(doc + SVG_DEPTH, d - 1); }
  _svgIndent(doc);
  _svgW(doc, "</text>");
  _svgNL(doc);
}

// ============================================================================
// Text on path
// ============================================================================

pub fn SvgTextOnPath(doc: int64, pathId: pchar, text: pchar, offset: f64): void {
  if (doc == 0) { return; }
  _svgFlushPendingGroup(doc);
  _svgIndent(doc);
  _svgW(doc, "<text");
  var flags: int64 := peek64(doc + SVG_FLAGS);
  if (flags & SVG_FLAG_FONT_FAM != 0) {
    _svgW(doc, " font-family=\""); _svgWinline(doc, SVG_FONT_FAM); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_FONT_SZ != 0) {
    _svgW(doc, " font-size=\""); _svgWinline(doc, SVG_FONT_SZ); _svgWc(doc, 34);
  }
  if (flags & SVG_FLAG_FILL != 0) {
    _svgW(doc, " fill=\""); _svgWinline(doc, SVG_FILL); _svgWc(doc, 34);
  }
  poke64(doc + SVG_FLAGS, 0);
  poke8(doc + SVG_TRANSFORM, 0);
  _svgWc(doc, 62); _svgNL(doc);
  poke64(doc + SVG_DEPTH, peek64(doc + SVG_DEPTH) + 1);
  _svgIndent(doc);
  _svgW(doc, "<textPath href=\"#");
  _svgW(doc, pathId);
  _svgW(doc, "\" startOffset=\"");
  _svgWf(doc, offset);
  _svgW(doc, "%\">");
  _svgWescText(doc, text);
  _svgW(doc, "</textPath>");
  _svgNL(doc);
  var d: int64 := peek64(doc + SVG_DEPTH);
  if (d > 1) { poke64(doc + SVG_DEPTH, d - 1); }
  _svgIndent(doc);
  _svgW(doc, "</text>");
  _svgNL(doc);
}
