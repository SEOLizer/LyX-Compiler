// SvgMatrixABCD sets a,b,c,d components; SvgMatrix completes with e,f
pub fn SvgMatrixABCD(doc: int64, a: f64, b: f64, c: f64, d: f64): void {
  if (doc == 0) { return; }
  poke64(doc + SVG_PARAM_A, svgF64x100(a));
  poke64(doc + SVG_PARAM_B, svgF64x100(b));
  poke64(doc + SVG_PARAM_C, svgF64x100(c));
  poke64(doc + SVG_PARAM_D, svgF64x100(d));
}

pub fn SvgMatrix(doc: int64, e: f64, f2: f64): void {
  if (doc == 0) { return; }
  var tmp: int64 := alloc(128);
  if (tmp == 0) { return; }
  var pos: int64 := svgBufStr(tmp, 0, "matrix(");
  pos := svgBufF64r2x100(tmp, pos, peek64(doc + SVG_PARAM_A));
  poke8(tmp + pos, 32); pos := pos + 1;
  pos := svgBufF64r2x100(tmp, pos, peek64(doc + SVG_PARAM_B));
  poke8(tmp + pos, 32); pos := pos + 1;
  pos := svgBufF64r2x100(tmp, pos, peek64(doc + SVG_PARAM_C));
  poke8(tmp + pos, 32); pos := pos + 1;
  pos := svgBufF64r2x100(tmp, pos, peek64(doc + SVG_PARAM_D));
  poke8(tmp + pos, 32); pos := pos + 1;
  pos := svgBufF64(tmp, pos, e);
  poke8(tmp + pos, 32); pos := pos + 1;
  pos := svgBufF64(tmp, pos, f2);
  poke8(tmp + pos, 41); pos := pos + 1;
  poke8(tmp + pos, 32); pos := pos + 1;
  poke8(tmp + pos, 0);
  _svgTransformAppend(doc, tmp as pchar);
  free(tmp, 128);
}
