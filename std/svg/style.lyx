// Build dash-array string from f64 array (6 arg max: doc, dashes ptr, n)
pub fn SvgSetDashArrayN(doc: int64, dashes: int64, n: int64): void {
  if (doc == 0 || dashes == 0 || n == 0) { return; }
  var tmp: int64 := alloc(64);
  if (tmp == 0) { return; }
  var pos: int64 := 0;
  var i: int64 := 0;
  while (i < n && pos < 60) {
    if (i > 0) { poke8(tmp + pos, 32); pos := pos + 1; }
    // dashes[i] is a f64 stored at dashes + i*8; read bits and interpret
    var bits: int64 := peek64(dashes + i * 8);
    // treat as f64 bit pattern
    var fv: f64 := bits as f64;
    pos := svgBufF64(tmp, pos, fv);
    i += 1;
  }
  poke8(tmp + pos, 0);
  _svgSetInline(doc, SVG_DASH, tmp as pchar);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_DASH);
  free(tmp, 64);
}

// ============================================================================
// Transforms
// ============================================================================

pub fn SvgTranslate(doc: int64, tx: f64, ty: f64): void {
  if (doc == 0) { return; }
  var tmp: int64 := alloc(64);
  if (tmp == 0) { return; }
  var pos: int64 := svgBufStr(tmp, 0, "translate(");
  pos := svgBufF64(tmp, pos, tx);
  poke8(tmp + pos, 32); pos := pos + 1;
  pos := svgBufF64(tmp, pos, ty);
  poke8(tmp + pos, 41); pos := pos + 1;
  poke8(tmp + pos, 32); pos := pos + 1;
  poke8(tmp + pos, 0);
  _svgTransformAppend(doc, tmp as pchar);
  free(tmp, 64);
}

