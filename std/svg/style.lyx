unit std.svg.style;

import std.alloc;
import std.svg.xml;

// SVG_CAP / SVG_JOIN / SVG_SPREAD constants
pub con SVG_CAP_BUTT:    int64 := 0;
pub con SVG_CAP_ROUND:   int64 := 1;
pub con SVG_CAP_SQUARE:  int64 := 2;
pub con SVG_JOIN_MITER:  int64 := 0;
pub con SVG_JOIN_ROUND:  int64 := 1;
pub con SVG_JOIN_BEVEL:  int64 := 2;
pub con SVG_FILL_NONZERO: int64 := 0;
pub con SVG_FILL_EVENODD: int64 := 1;

// ============================================================================
// Fill
// ============================================================================

pub fn SvgSetFill(doc: int64, r: f64, g: f64, b: f64): void {
  if (doc == 0) { return; }
  svgColorHex(r, g, b, doc + SVG_FILL);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_FILL);
}

pub fn SvgSetFillAlpha(doc: int64, r: f64, g: f64, b: f64, a: f64): void {
  if (doc == 0) { return; }
  svgColorHex(r, g, b, doc + SVG_FILL);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_FILL);
  var tmp: int64 := alloc(16);
  if (tmp == 0) { return; }
  var pos: int64 := svgBufF64(tmp, 0, a);
  poke8(tmp + pos, 0);
  _svgSetInline(doc, SVG_FILL_OPA, tmp as pchar);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_FILL_OPA);
  free(tmp, 16);
}

pub fn SvgSetFillNone(doc: int64): void {
  if (doc == 0) { return; }
  _svgSetInline(doc, SVG_FILL, "none");
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_FILL);
}

pub fn SvgSetFillHex(doc: int64, hex: pchar): void {
  if (doc == 0) { return; }
  _svgSetInline(doc, SVG_FILL, hex as pchar);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_FILL);
}

