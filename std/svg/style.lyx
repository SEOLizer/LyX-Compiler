// ============================================================================
// Line style
// ============================================================================

pub fn SvgSetLineCap(doc: int64, cap: int64): void {
  if (doc == 0) { return; }
  if (cap == SVG_CAP_ROUND)   { _svgSetInline(doc, SVG_LCAP, "round"); }
  else { if (cap == SVG_CAP_SQUARE) { _svgSetInline(doc, SVG_LCAP, "square"); }
  else { _svgSetInline(doc, SVG_LCAP, "butt"); } }
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_LCAP);
}

pub fn SvgSetLineJoin(doc: int64, join: int64): void {
  if (doc == 0) { return; }
  if (join == SVG_JOIN_ROUND) { _svgSetInline(doc, SVG_LJOIN, "round"); }
  else { if (join == SVG_JOIN_BEVEL) { _svgSetInline(doc, SVG_LJOIN, "bevel"); }
  else { _svgSetInline(doc, SVG_LJOIN, "miter"); } }
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_LJOIN);
}

