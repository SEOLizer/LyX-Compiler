  // For a proper SVG, use SvgLinearGradient and edit the output
  // Here: no-op since we've already written the opening tag
}

pub fn SvgGradientUserSpace(doc: int64, gid: int64): void {
  // Cannot modify already-written tag; accepted as no-op in this implementation
}

pub fn SvgGradientRotate(doc: int64, gid: int64, angle: f64): void {
  if (doc == 0) { return; }
  // Write a gradientTransform on a linked gradient element
  _defsIndent(doc);
  _svgD(doc, "<linearGradient id=\"grad");
  _svgDi(doc, gid);
  _svgD(doc, "r\" href=\"#grad");
  _svgDi(doc, gid);
  _svgD(doc, "\" gradientTransform=\"rotate(");
  _svgDf(doc, angle);
  _svgD(doc, " 0.5 0.5)\"/>");
  _defsNL(doc);
}

// ============================================================================
// Radial gradient
// ============================================================================

pub fn SvgRadialGradient(doc: int64, id: pchar, cx: f64, cy: f64, r: f64): int64 {
  if (doc == 0) { return -1; }
  var gid: int64 := _svgNextId(doc);
  // read stored focal point from doc struct (set via SvgGradientFocus)
  var fx100: int64 := peek64(doc + SVG_GRAD_FX);
  var fy100: int64 := peek64(doc + SVG_GRAD_FY);
  _defsIndent(doc);
  _svgD(doc, "<radialGradient id=\"grad");
  _svgDi(doc, gid);
  _svgDc(doc, 34);
  _svgD(doc, " cx=\""); _svgDf(doc, cx); _svgDc(doc, 34);
  _svgD(doc, " cy=\""); _svgDf(doc, cy); _svgDc(doc, 34);
  _svgD(doc, " r=\"");  _svgDf(doc, r);  _svgDc(doc, 34);
  if (fx100 != 0 || fy100 != 0) {
    _svgD(doc, " fx=\""); _svgDi(doc, fx100 / 100); _svgDc(doc, 34);
    _svgD(doc, " fy=\""); _svgDi(doc, fy100 / 100); _svgDc(doc, 34);
  }
  _svgD(doc, " gradientUnits=\"objectBoundingBox\">");
  _defsNL(doc);
  poke64(doc + SVG_GRAD_FX, 0);
  poke64(doc + SVG_GRAD_FY, 0);
  return gid;
}

pub fn SvgGradientFocus(doc: int64, fx: f64, fy: f64): void {
  if (doc == 0) { return; }
  poke64(doc + SVG_GRAD_FX, svgF64x100(fx));
  poke64(doc + SVG_GRAD_FY, svgF64x100(fy));
}

pub fn SvgRadialGradientEnd(doc: int64, gid: int64): void {
  if (doc == 0) { return; }
  _defsIndent(doc);
  _svgD(doc, "</radialGradient>");
  _defsNL(doc);
}

// ============================================================================
// Pattern
// ============================================================================

pub fn SvgPatternBegin(doc: int64, id: pchar, x: f64, y: f64, w: f64, h: f64): int64 {
  if (doc == 0) { return -1; }
  var pid: int64 := _svgNextId(doc);
  _defsIndent(doc);
  _svgD(doc, "<pattern id=\"pat");
  _svgDi(doc, pid);
  _svgDc(doc, 34);
  _svgD(doc, " x=\""); _svgDf(doc, x); _svgDc(doc, 34);
  _svgD(doc, " y=\""); _svgDf(doc, y); _svgDc(doc, 34);
  _svgD(doc, " width=\""); _svgDf(doc, w); _svgDc(doc, 34);
  _svgD(doc, " height=\""); _svgDf(doc, h); _svgDc(doc, 34);
  _svgD(doc, " patternUnits=\"userSpaceOnUse\">");
  _defsNL(doc);
  return pid;
}

pub fn SvgPatternEnd(doc: int64): void {
  if (doc == 0) { return; }
  _defsIndent(doc);
  _svgD(doc, "</pattern>");
  _defsNL(doc);
}

pub fn SvgSetFillPattern(doc: int64, patId: int64): void {
  if (doc == 0) { return; }
  var tmp: int64 := alloc(32);
  if (tmp == 0) { return; }
  var pos: int64 := svgBufStr(tmp, 0, "url(#pat");
  pos := svgBufInt(tmp, pos, patId);
  poke8(tmp + pos, 41); pos := pos + 1;
  poke8(tmp + pos, 0);
  _svgSetInline(doc, SVG_FILL, tmp as pchar);
  poke64(doc + SVG_FLAGS, peek64(doc + SVG_FLAGS) | SVG_FLAG_FILL);
  free(tmp, 32);
}

// ============================================================================
// Symbol
// ============================================================================

pub fn SvgSymbolBegin(doc: int64, id: pchar, vw: f64, vh: f64): int64 {
  if (doc == 0) { return -1; }
  var sid: int64 := _svgNextId(doc);
  _defsIndent(doc);
  _svgD(doc, "<symbol id=\"sym");
  _svgDi(doc, sid);
  _svgDc(doc, 34);
  if (id != 0) {
    var c: int64 := StrCharAt(id, 0);
    if (c != 0) {
      _svgD(doc, " class=\""); _svgD(doc, id); _svgDc(doc, 34);
    }
  }
  _svgD(doc, " viewBox=\"0 0 ");
  _svgDf(doc, vw); _svgDc(doc, 32); _svgDf(doc, vh);
  _svgD(doc, "\" overflow=\"hidden\">");
  _defsNL(doc);
  return sid;
}

pub fn SvgSymbolEnd(doc: int64): void {
  if (doc == 0) { return; }
  _defsIndent(doc);
  _svgD(doc, "</symbol>");
  _defsNL(doc);
}

pub fn SvgUse(doc: int64, id: pchar, x: f64, y: f64, w: f64, h: f64): void {
  if (doc == 0) { return; }
  _svgFlushPendingGroup(doc);
  _svgIndent(doc);
  _svgW(doc, "<use href=\"#");
  _svgW(doc, id);
  _svgWc(doc, 34);
  _svgW(doc, " x=\""); _svgWf(doc, x); _svgWc(doc, 34);
  _svgW(doc, " y=\""); _svgWf(doc, y); _svgWc(doc, 34);
  _svgW(doc, " width=\""); _svgWf(doc, w); _svgWc(doc, 34);
  _svgW(doc, " height=\""); _svgWf(doc, h); _svgWc(doc, 34);
  _svgW(doc, "/>");
  _svgNL(doc);
}

