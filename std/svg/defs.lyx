  _svgD(doc, " markerHeight=\""); _svgDf(doc, mh); _svgDc(doc, 34);
  _svgD(doc, " refX=\""); _svgDf(doc, rx); _svgDc(doc, 34);
  _svgD(doc, " refY=\""); _svgDf(doc, ry); _svgDc(doc, 34);
