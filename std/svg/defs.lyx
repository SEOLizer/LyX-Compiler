unit std.svg.defs;

import std.alloc;
import std.svg.xml;
import std.svg.elements;

pub con SVG_SPREAD_PAD:     int64 := 0;
pub con SVG_SPREAD_REFLECT: int64 := 1;
pub con SVG_SPREAD_REPEAT:  int64 := 2;

// Allocate next def ID from counter
fn _svgNextId(doc: int64): int64 {
  var id: int64 := peek64(doc + SVG_DEF_CNT);
  poke64(doc + SVG_DEF_CNT, id + 1);
  return id;
}

// ============================================================================
// Linear gradient
// ============================================================================

pub fn SvgLinearGradient(doc: int64, id: pchar, x1: f64, y1: f64, x2: f64, y2: f64): int64 {
  if (doc == 0) { return -1; }
  var gid: int64 := _svgNextId(doc);
  _defsIndent(doc);
  _svgD(doc, "<linearGradient id=\"grad");
  _svgDi(doc, gid);
  _svgDc(doc, 34);
  if (id != 0) {
    var c: int64 := StrCharAt(id, 0);
    if (c != 0) {
      _svgD(doc, " class=\"");
      _svgD(doc, id);
      _svgDc(doc, 34);
    }
  }
  _svgD(doc, " x1=\""); _svgDf(doc, x1); _svgDc(doc, 34);
  _svgD(doc, " y1=\""); _svgDf(doc, y1); _svgDc(doc, 34);
  _svgD(doc, " x2=\""); _svgDf(doc, x2); _svgDc(doc, 34);
  _svgD(doc, " y2=\""); _svgDf(doc, y2); _svgDc(doc, 34);
  _svgD(doc, " gradientUnits=\"objectBoundingBox\">");
  _defsNL(doc);
  // Store open state: need to close when next gradient is started or at SvgApply
  poke64(doc + SVG_DEF_CNT, peek64(doc + SVG_DEF_CNT));  // keep counter
  return gid;
}

// SvgGradientStop: add a stop to the last opened gradient (gid only for context)
pub fn SvgGradientStop(doc: int64, gid: int64, offset: f64, r: f64, g: f64, b: f64): void {
  if (doc == 0) { return; }
  var colbuf: int64 := alloc(8);
  if (colbuf == 0) { return; }
  svgColorHex(r, g, b, colbuf);
  _defsIndent(doc);
  _svgD(doc, "  <stop offset=\"");
  _svgDf(doc, offset);
  _svgD(doc, "\" stop-color=\"");
  _svgDbytes(doc, colbuf, 7);
  _svgD(doc, "\"/>");
  _defsNL(doc);
  free(colbuf, 8);
}

// SvgGradientStopAlpha: stop with opacity
pub fn SvgGradientStopA(doc: int64, gid: int64, offset: f64, hex: pchar, a: f64): void {
  if (doc == 0) { return; }
  _defsIndent(doc);
  _svgD(doc, "  <stop offset=\"");
  _svgDf(doc, offset);
  _svgD(doc, "\" stop-color=\"");
  _svgD(doc, hex);
  _svgD(doc, "\" stop-opacity=\"");
  _svgDf(doc, a);
  _svgD(doc, "\"/>");
  _defsNL(doc);
}

pub fn SvgGradientEnd(doc: int64, gid: int64): void {
  if (doc == 0) { return; }
  _defsIndent(doc);
  _svgD(doc, "</linearGradient>");
  _defsNL(doc);
}

