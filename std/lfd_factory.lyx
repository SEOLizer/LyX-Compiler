// std.lfd_factory — LFD Widget Factory
//
// Diese Unit soll aus einem LFD-Syntaxbaum (std.lfd_parser) Bedienelemente
// bauen. Der Kopfkommentar nannte dafuer frueher "Maps LFD AST nodes to Qt
// widgets via libqtlyx.so" — es gab aber weder eine `extern fn`-Deklaration
// noch eine `link`-Klausel. libqtlyx.so wird nirgends gebunden (#1391).
//
// STAND: Die Anbindung fehlt. Die Unit erkennt und pruefet Typen, Eigenschaften
// und Ereignisse — sie kann aber kein Fenster erzeugen. Das wird jetzt GESAGT,
// statt Nullwerte zurueckzugeben, die wie ein Ergebnis aussehen: der erste
// erzeugende Aufruf meldet einmal auf stderr, dass die Anbindung fehlt.
//
// Erkennen und Bauen sind bewusst getrennt: LFDFactoryKennt* beantwortet
// heute schon richtig, was das Format hergibt (dafuer war #1392 zu beheben),
// und bleibt gueltig, wenn die Anbindung nachgereicht wird.

@description("Widget-Factory fuer LFD-Syntaxbaeume — Qt-Anbindung fehlt, siehe #1391")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
unit std.lfd_factory;

import std.io;
import std.string;
import std.lfd_parser;

// Einmalige Meldung: ein Formular hat viele Elemente, und eine Zeile je
// Element waere Rauschen statt Auskunft.
var lfdf_gemeldet: int64 := 0;

fn _lfdfMelde(): void {
  if (lfdf_gemeldet != 0) { return; }
  lfdf_gemeldet := 1;
  EPrintStrLn("std.lfd_factory: keine Qt-Anbindung gebunden — es entstehen keine Bedienelemente (#1391)"c);
}

// ============================================================================
// Typerkennung
//
// #1392: Hier stand ueberall `widgetType == "Button"`. Bei pchar vergleicht
// `==` die ADRESSEN, nicht den Inhalt — zwei gleich geschriebene Literale
// haben verschiedene Adressen, der Zweig wurde also nie genommen. Verglichen
// wird jetzt mit StrEquals.
//
// Die Namen folgen dem Parser (kleingeschrieben, #1397) und umfassen alle
// sechzehn Typen; die alte Liste kannte acht.
// ============================================================================

pub fn LFDFactoryKenntWidget(widgetType: pchar): bool {
  if (StrEquals(widgetType, "button"c))      { return true; }
  if (StrEquals(widgetType, "label"c))       { return true; }
  if (StrEquals(widgetType, "input"c))       { return true; }
  if (StrEquals(widgetType, "checkbox"c))    { return true; }
  if (StrEquals(widgetType, "radiobutton"c)) { return true; }
  if (StrEquals(widgetType, "combobox"c))    { return true; }
  if (StrEquals(widgetType, "spinbox"c))     { return true; }
  if (StrEquals(widgetType, "slider"c))      { return true; }
  if (StrEquals(widgetType, "listbox"c))     { return true; }
  if (StrEquals(widgetType, "textedit"c))    { return true; }
  if (StrEquals(widgetType, "progressbar"c)) { return true; }
  if (StrEquals(widgetType, "image"c))       { return true; }
  if (StrEquals(widgetType, "custom"c))      { return true; }
  return false;
}

pub fn LFDFactoryKenntLayout(layoutType: pchar): bool {
  if (StrEquals(layoutType, "layout"c))     { return true; }
  if (StrEquals(layoutType, "vertical"c))   { return true; }
  if (StrEquals(layoutType, "horizontal"c)) { return true; }
  if (StrEquals(layoutType, "grid"c))       { return true; }
  if (StrEquals(layoutType, "stack"c))      { return true; }
  if (StrEquals(layoutType, "groupbox"c))   { return true; }
  if (StrEquals(layoutType, "tabwidget"c))  { return true; }
  if (StrEquals(layoutType, "splitter"c))   { return true; }
  return false;
}

pub fn LFDFactoryKenntProperty(propertyName: pchar): bool {
  if (StrEquals(propertyName, "text"c))     { return true; }
  if (StrEquals(propertyName, "tooltip"c))  { return true; }
  if (StrEquals(propertyName, "enabled"c))  { return true; }
  if (StrEquals(propertyName, "visible"c))  { return true; }
  if (StrEquals(propertyName, "width"c))    { return true; }
  if (StrEquals(propertyName, "height"c))   { return true; }
  return false;
}

pub fn LFDFactoryKenntEvent(eventName: pchar): bool {
  if (StrEquals(eventName, "onclick"c))  { return true; }
  if (StrEquals(eventName, "onchange"c)) { return true; }
  return false;
}

// Ist die Anbindung vorhanden? Heute nein — der Aufrufer kann danach fragen,
// statt aus einer 0 raten zu muessen.
pub fn LFDFactoryAvailable(): bool {
  return false;
}

// ============================================================================
// Erzeugung — ohne Anbindung nicht moeglich
//
// #1391: Diese Funktionen lieferten stumm 0 bzw. false und sahen damit aus wie
// eine benutzbare API. Sie liefern weiterhin 0/false (etwas anderes gibt es
// ohne Anbindung nicht), melden das aber einmal deutlich.
// ============================================================================

pub fn createWidget(widgetType: pchar, parent: int64): int64 {
  if (!LFDFactoryKenntWidget(widgetType)) {
    EPrintStr("std.lfd_factory: unbekannter Widget-Typ '"c);
    EPrintStr(widgetType);
    EPrintStrLn("'"c);
    return 0;
  }
  _lfdfMelde();
  return 0;
}

pub fn createLayout(layoutType: pchar): int64 {
  if (!LFDFactoryKenntLayout(layoutType)) {
    EPrintStr("std.lfd_factory: unbekannte Anordnung '"c);
    EPrintStr(layoutType);
    EPrintStrLn("'"c);
    return 0;
  }
  _lfdfMelde();
  return 0;
}

pub fn setWidgetProperty(wid: int64, propertyName: pchar, value: pchar): bool {
  if (wid == 0) { return false; }
  if (!LFDFactoryKenntProperty(propertyName)) { return false; }
  _lfdfMelde();
  return false;
}

pub fn setWidgetIntProperty(wid: int64, propertyName: pchar, value: int64): bool {
  if (wid == 0) { return false; }
  if (!LFDFactoryKenntProperty(propertyName)) { return false; }
  _lfdfMelde();
  return false;
}

pub fn addWidgetToLayout(lay: int64, wid: int64): bool {
  if (lay == 0 || wid == 0) { return false; }
  _lfdfMelde();
  return false;
}

pub fn setLayoutOnWidget(wid: int64, lay: int64): bool {
  if (wid == 0 || lay == 0) { return false; }
  _lfdfMelde();
  return false;
}

pub fn bindEvent(wid: int64, eventName: pchar, handler: pchar): bool {
  if (wid == 0) { return false; }
  if (!LFDFactoryKenntEvent(eventName)) { return false; }
  _lfdfMelde();
  return false;
}

// renderForm gab seinen Parameter nicht einmal weiter und lieferte konstant 0.
// Solange die Anbindung fehlt, kann es nichts anderes — es sagt es jetzt.
pub fn renderForm(parser: int64): int64 {
  _lfdfMelde();
  return 0;
}

pub fn parseAndRender(lfdSource: pchar): int64 {
  var wurzel: int64 := LFDParseString(lfdSource);
  if (wurzel <= 0 || LFDGetErrorCount(0) > 0) {
    EPrintStr("LFD Parse Error: "c);
    EPrintStrLn(LFDGetLastError(0));
    return 0;
  }
  return renderForm(wurzel);
}

// End of std/lfd_factory.lyx
