// Lyx Bluetooth Library — std/hardware/bluetooth_rfcomm.lyx
//
// WP-3: RFCOMM (Classic Bluetooth) — Client & Server
//
// RFCOMM emuliert eine serielle Schnittstelle über Bluetooth.
// Typische Anwendungsfälle: GPS-Mäuse, serielle Adapter, Drucker, SPP-Profile.
//
// Ablauf Client:
//   fd := RFCommConnect(bdaddr, channel)
//   RFCommSend(fd, buf, len)
//   RFCommRecv(fd, buf, len)
//   RFCommClose(fd)
//
// Ablauf Server:
//   listenFd := RFCommListen(channel, backlog)
//   clientFd := RFCommAccept(listenFd, remoteAddrOut)
//   RFCommSend/Recv(clientFd, ...)
//   RFCommClose(clientFd) ; RFCommClose(listenFd)
@capabilities([network.tcp.bind, network.tcp.connect, network.udp.connect])

unit std.hardware.bluetooth_rfcomm;

import std.hardware.bluetooth_types;
import std.alloc;

// ============================================================================
// WP-3.1: RFCommConnect — Client-Verbindung zu einem RFCOMM-Server
//
// bdaddr:  Bluetooth-Adresse des Remote-Geräts (int64 aus BTStrToAddr)
// channel: RFCOMM-Kanal (1..30, typisch 1)
// Rückgabe: Socket-FD (≥ 0) bei Erfolg, -1 bei Fehler
// ============================================================================
pub fn RFCommConnect(bdaddr: int64, channel: int64): int64 {
  var fd: int64 := sys_socket(AF_BLUETOOTH, 1, BTPROTO_RFCOMM);
  if (fd < 0) { return -1; }

  var buf: int64 := alloc(BT_SOCKADDR_RC_SIZE);
  if (buf == 0) { sys_close(fd); return -1; }

  BTSockAddrRcCreate(buf, bdaddr, channel);

  var ret: int64 := sys_connect(fd, buf, BT_SOCKADDR_RC_SIZE);
  free(buf, BT_SOCKADDR_RC_SIZE);

  if (ret < 0) { sys_close(fd); return -1; }
  return fd;
}

// ============================================================================
// WP-3.2: RFCommSend — Daten über offenen RFCOMM-Socket senden
//
// Rückgabe: gesendete Bytes (≥ 0) oder -1 bei Fehler/Verbindungsabbruch
// ============================================================================
pub fn RFCommSend(fd: int64, buf: int64, len: int64): int64 {
  return sys_sendto(fd, buf, len, 0, 0, 0);
}

// ============================================================================
// WP-3.2: RFCommRecv — Daten von offenem RFCOMM-Socket empfangen
//
// Blockiert bis Daten ankommen oder die Verbindung geschlossen wird.
// Rückgabe: empfangene Bytes (> 0), 0 bei geordnetem Verbindungsabbau,
//           -1 bei Fehler
// ============================================================================
pub fn RFCommRecv(fd: int64, buf: int64, len: int64): int64 {
  return sys_recvfrom(fd, buf, len, 0, 0, 0);
}

// ============================================================================
// WP-3.3: RFCommListen — RFCOMM-Server starten
//
// channel: lokaler RFCOMM-Kanal (1..30)
// backlog: maximale Länge der Warteschlange für eingehende Verbindungen
// Rückgabe: Listening-Socket-FD (≥ 0) oder -1 bei Fehler
// ============================================================================
pub fn RFCommListen(channel: int64, backlog: int64): int64 {
  var fd: int64 := sys_socket(AF_BLUETOOTH, 1, BTPROTO_RFCOMM);
  if (fd < 0) { return -1; }

  var buf: int64 := alloc(BT_SOCKADDR_RC_SIZE);
  if (buf == 0) { sys_close(fd); return -1; }

  // Bind an beliebige lokale Bluetooth-Adresse (bdaddr = 0 = BDADDR_ANY)
  BTSockAddrRcCreate(buf, 0, channel);

  var ret: int64 := sys_bind(fd, buf, BT_SOCKADDR_RC_SIZE);
  free(buf, BT_SOCKADDR_RC_SIZE);

  if (ret < 0) { sys_close(fd); return -1; }

  ret := sys_listen(fd, backlog);
  if (ret < 0) { sys_close(fd); return -1; }

  return fd;
}

// ============================================================================
// WP-3.3: RFCommAccept — Eingehende RFCOMM-Verbindung annehmen
//
// listenFd:      Listening-Socket aus RFCommListen
// remoteAddrOut: Zeiger auf int64, der die Remote-BDAddr aufnimmt (0 = ignorieren)
// Rückgabe: Client-Socket-FD (≥ 0) oder -1 bei Fehler
// ============================================================================
pub fn RFCommAccept(listenFd: int64, remoteAddrOut: int64): int64 {
  var addrBuf: int64 := alloc(BT_SOCKADDR_RC_SIZE);
  if (addrBuf == 0) { return -1; }

  // addrLenBuf: int32 mit initialer Puffergröße; wird von accept beschrieben
  var addrLenBuf: int64 := alloc(4);
  if (addrLenBuf == 0) { free(addrBuf, BT_SOCKADDR_RC_SIZE); return -1; }
  poke32(addrLenBuf, BT_SOCKADDR_RC_SIZE);

  var clientFd: int64 := sys_accept(listenFd, addrBuf, addrLenBuf);

  if (clientFd >= 0 && remoteAddrOut != 0) {
    poke64(remoteAddrOut, BTSockAddrRcReadAddr(addrBuf));
  }

  free(addrLenBuf, 4);
  free(addrBuf, BT_SOCKADDR_RC_SIZE);

  if (clientFd < 0) { return -1; }
  return clientFd;
}

// ============================================================================
// RFCommClose — Socket schließen
// ============================================================================
pub fn RFCommClose(fd: int64): int64 {
  return sys_close(fd);
}

// ============================================================================
// RFCommSetSecurity — Sicherheitsmodus setzen (optional)
//
// flags: Kombination aus BT_LM_AUTH (2), BT_LM_ENCRYPT (4), BT_LM_SECURE (8)
// Muss vor sys_connect / sys_accept gesetzt werden.
// Rückgabe: 0 = OK, < 0 = Fehler
// ============================================================================
pub fn RFCommSetSecurity(fd: int64, flags: int64): int64 {
  var optBuf: int64 := alloc(4);
  if (optBuf == 0) { return -1; }
  poke32(optBuf, flags);
  var ret: int64 := sys_setsockopt(fd, SOL_RFCOMM, RFCOMM_LM, optBuf, 4);
  free(optBuf, 4);
  return ret;
}

// ============================================================================
// RFCommPoll — Warten auf lesbare Daten mit Timeout
//
// timeoutMs: Wartezeit in Millisekunden (-1 = unendlich, 0 = sofort)
// Rückgabe: 1 = Daten verfügbar, 0 = Timeout, -1 = Fehler / Verbindungsabbruch
// ============================================================================
pub fn RFCommPoll(fd: int64, timeoutMs: int64): int64 {
  // pollfd: { int32 fd, int16 events, int16 revents } = 8 Bytes
  var pfd: int64 := alloc(8);
  if (pfd == 0) { return -1; }
  BTPollFdSet(pfd, fd, POLLIN);

  var ret: int64 := sys_poll(pfd, 1, timeoutMs);
  var revents: int64 := BTPollFdRevents(pfd);
  free(pfd, 8);

  if (ret < 0) { return -1; }
  if (ret == 0) { return 0; }   // Timeout

  // POLLHUP oder POLLERR → Verbindungsabbruch (WP-3 Abnahmekriterium 4)
  if ((revents & POLLHUP) != 0 || (revents & POLLERR) != 0) { return -1; }
  if ((revents & POLLIN) != 0) { return 1; }
  return 0;
}

// ============================================================================
// RFCommSendAll — sendet alle len Bytes (wiederholt bei Teilübertragung)
//
// Rückgabe: len bei Erfolg, -1 bei Fehler/Verbindungsabbruch
// ============================================================================
pub fn RFCommSendAll(fd: int64, buf: int64, len: int64): int64 {
  var sent: int64 := 0;
  while (sent < len) {
    var n: int64 := sys_sendto(fd, buf + sent, len - sent, 0, 0, 0);
    if (n <= 0) { return -1; }
    sent += n;
  }
  return sent;
}
