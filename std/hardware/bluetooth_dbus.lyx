// ============================================================================
// BlueZFindDeviceAddress — Bluetooth-Adresse aus GetManagedObjects-Reply extrahieren
//
// Sucht heuristisch im rohen D-Bus-Reply-Buffer nach der BDAddr eines Geräts.
// Strategie: Suche nach "Address" (7 Bytes) gefolgt von einem D-Bus-String
// mit dem Format "XX:XX:XX:XX:XX:XX".
//
// data/dataLen: GetManagedObjects-Reply-Buffer
// addrBuf:     Puffer für die gefundene Adresse (mind. 18 Bytes)
// Rückgabe: 1 = Adresse gefunden, 0 = nicht gefunden
// ============================================================================
pub fn BlueZFindDeviceAddress(data: int64, dataLen: int64, addrBuf: int64): int64 {
  // Suche nach ASCII "Address" (65,100,100,114,101,115,115)
  var i: int64 := 0;
  while (i < dataLen - 24) {
    if (peek8(data+i)==65 && peek8(data+i+1)==100 && peek8(data+i+2)==100 &&
        peek8(data+i+3)==114 && peek8(data+i+4)==101 && peek8(data+i+5)==115 &&
        peek8(data+i+6)==115) {
      // "Address" gefunden; suche nachfolgendes "XX:XX:XX:XX:XX:XX"-Muster
      var j: int64 := i + 7;
      while (j < i + 64 && j < dataLen - 17) {
        // Prüfe ob ab j ein MAC-Format steht: X X : X X : X X : X X : X X : X X
        if (peek8(data+j+2)==58 && peek8(data+j+5)==58 && peek8(data+j+8)==58 &&
            peek8(data+j+11)==58 && peek8(data+j+14)==58) {
          // Adresse kopieren
          var k: int64 := 0;
          while (k < 17) {
            poke8(addrBuf + k, peek8(data + j + k));
            k += 1;
          }
          poke8(addrBuf + 17, 0);
          return 1;
        }
        j += 1;
      }
    }
    i += 1;
  }
  return 0;
}

// ============================================================================
// BlueZDiscoverDevices — Kompletter Discovery-Zyklus
//
// 1. StartDiscovery
// 2. Warte timeoutMs Millisekunden (sys_poll mit nfds=0 als Sleep)
// 3. StopDiscovery
// 4. GetManagedObjects → outBuf
// Rückgabe: Bytes im outBuf (Aufrufer parst mit BlueZFindDeviceAddress)
// ============================================================================
pub fn BlueZDiscoverDevices(fd: int64, adapterPath: int64, pathLen: int64,
                            timeoutMs: int64, outBuf: int64, maxLen: int64): int64 {
  BlueZStartDiscovery(fd, adapterPath, pathLen);
  // Sleep via poll(NULL, 0, timeoutMs)
  sys_poll(0, 0, timeoutMs);
  BlueZStopDiscovery(fd, adapterPath, pathLen);
  return BlueZGetManagedObjects(fd, outBuf, maxLen);
}

// ============================================================================
// BlueZClose — D-Bus-Verbindung schließen
// ============================================================================
pub fn BlueZClose(fd: int64) {
  sys_close(fd);
}
