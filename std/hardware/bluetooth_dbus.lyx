// Rückgabe: 0 = OK, -1 = Fehler
// ============================================================================
pub fn BlueZConnectDevice(fd: int64, devicePath: int64, pathLen: int64): int64 {
  var iface:  int64 := "org.bluez.Device1"c as int64;
  var member: int64 := "Connect"c           as int64;
  return _bluez_call(fd, 6, devicePath, pathLen, iface, 17, member, 7);
}

// ============================================================================
// BlueZDisconnectDevice — Verbindung trennen
// ============================================================================
pub fn BlueZDisconnectDevice(fd: int64, devicePath: int64, pathLen: int64): int64 {
  var iface:  int64 := "org.bluez.Device1"c as int64;
  var member: int64 := "Disconnect"c        as int64;
  return _bluez_call(fd, 7, devicePath, pathLen, iface, 17, member, 10);
