// std/hardware/gpio_ioctl.lyx
// WP-3: Variante B — Linux GPIO-v2 ioctl-Interface (/dev/gpiochipX)
//
// Struct-Layouts und ioctl-Codes verifiziert gegen Linux-Header
// /usr/include/linux/gpio.h auf x86-64 (Kernel >= 5.10).
//
// WP-3.1: Konstanten + Struct-Größen/Offsets
// WP-3.2: GpioGetChipInfo
// WP-3.3: GpioRequestLines, GpioSetLineValues, GpioGetLineValues,
//          GpioReleaseLine
@capabilities([fs.read, hardware.gpio, system.time])

unit std.hardware.gpio_ioctl;

import std.hardware.gpio_syscalls;
import std.hardware.gpio_util;
import std.alloc;

// ============================================================
// WP-3.1: Konstanten (Linux GPIO-v2-API)
// ============================================================

pub con GPIO_MAX_NAME_SIZE:         int64 := 32;
pub con GPIO_V2_LINES_MAX:          int64 := 64;
pub con GPIO_V2_LINE_NUM_ATTRS_MAX: int64 := 10;

// Line-Flags (gpio_v2_line_flag)
pub con GPIO_V2_LINE_FLAG_USED:          int64 := 1;    // Bit 0
pub con GPIO_V2_LINE_FLAG_ACTIVE_LOW:    int64 := 2;    // Bit 1
pub con GPIO_V2_LINE_FLAG_INPUT:         int64 := 4;    // Bit 2
pub con GPIO_V2_LINE_FLAG_OUTPUT:        int64 := 8;    // Bit 3
pub con GPIO_V2_LINE_FLAG_EDGE_RISING:   int64 := 16;   // Bit 4
pub con GPIO_V2_LINE_FLAG_EDGE_FALLING:  int64 := 32;   // Bit 5
pub con GPIO_V2_LINE_FLAG_OPEN_DRAIN:    int64 := 64;   // Bit 6
pub con GPIO_V2_LINE_FLAG_OPEN_SOURCE:   int64 := 128;  // Bit 7
pub con GPIO_V2_LINE_FLAG_BIAS_PULL_UP:  int64 := 256;  // Bit 8
pub con GPIO_V2_LINE_FLAG_BIAS_PULL_DOWN: int64 := 512; // Bit 9
pub con GPIO_V2_LINE_FLAG_BIAS_DISABLED: int64 := 1024; // Bit 10

// Line-Attribute-IDs
pub con GPIO_V2_LINE_ATTR_ID_FLAGS:         int64 := 1;
pub con GPIO_V2_LINE_ATTR_ID_OUTPUT_VALUES: int64 := 2;
pub con GPIO_V2_LINE_ATTR_ID_DEBOUNCE:      int64 := 3;

// ioctl-Codes — verifiziert via sizeof() gegen /usr/include/linux/gpio.h
// _IOR (0x80000000) / _IOWR (0xC0000000) | (size<<16) | (type<<8) | nr
// type = 0xB4
pub con GPIO_GET_CHIPINFO_IOCTL:         int64 := 0x8044B401;  // _IOR(0xB4, 0x01, 68)
pub con GPIO_V2_GET_LINE_IOCTL:          int64 := 0xC250B407;  // _IOWR(0xB4, 0x07, 592)
pub con GPIO_V2_LINE_GET_VALUES_IOCTL:   int64 := 0xC010B40E;  // _IOWR(0xB4, 0x0E, 16)
pub con GPIO_V2_LINE_SET_VALUES_IOCTL:   int64 := 0xC010B40F;  // _IOWR(0xB4, 0x0F, 16)

// ============================================================
// WP-3.1: Struct-Größen (aus sizeof() verifiziert)
// ============================================================

// gpiochip_info: name[32] + label[32] + lines(u32) = 68 Bytes
pub con GPIO_CHIP_INFO_SIZE:  int64 := 68;
pub con GPIO_CHIP_INFO_NAME:  int64 := 0;   // char[32]
pub con GPIO_CHIP_INFO_LABEL: int64 := 32;  // char[32]
pub con GPIO_CHIP_INFO_LINES: int64 := 64;  // uint32

// gpio_v2_line_values: bits(u64) + mask(u64) = 16 Bytes
pub con GPIO_LINE_VALUES_SIZE: int64 := 16;
pub con GPIO_LINE_VALUES_BITS: int64 := 0;  // uint64
pub con GPIO_LINE_VALUES_MASK: int64 := 8;  // uint64

// gpio_v2_line_attribute: id(u32) + padding(u32) + value(u64) = 16 Bytes
pub con GPIO_LINE_ATTR_SIZE:    int64 := 16;
pub con GPIO_LINE_ATTR_ID:      int64 := 0;  // uint32
pub con GPIO_LINE_ATTR_PADDING: int64 := 4;  // uint32
pub con GPIO_LINE_ATTR_VALUE:   int64 := 8;  // uint64 (union)

// gpio_v2_line_config_attribute: attr(16) + mask(u64) = 24 Bytes
pub con GPIO_LINE_CFG_ATTR_SIZE: int64 := 24;
pub con GPIO_LINE_CFG_ATTR_MASK: int64 := 16;  // uint64

// gpio_v2_line_config: flags(u64) + num_attrs(u32) + padding[5](u32) +
//   attrs[10](24) = 272 Bytes
// Offset 32: attrs-Array-Start
pub con GPIO_LINE_CONFIG_SIZE:      int64 := 272;
pub con GPIO_LINE_CONFIG_FLAGS:     int64 := 0;   // uint64
pub con GPIO_LINE_CONFIG_NUM_ATTRS: int64 := 8;   // uint32
pub con GPIO_LINE_CONFIG_PADDING:   int64 := 12;  // uint32[5]
pub con GPIO_LINE_CONFIG_ATTRS:     int64 := 32;  // gpio_v2_line_config_attribute[10]

// gpio_v2_line_request (592 Bytes):
//   offsets[64](u32×64=256) + consumer[32] + config(272) +
//   num_lines(u32) + event_buffer_size(u32) + padding[5](u32) + fd(s32)
pub con GPIO_LINE_REQUEST_SIZE:        int64 := 592;
pub con GPIO_LINE_REQUEST_OFFSETS:     int64 := 0;    // uint32[64]
pub con GPIO_LINE_REQUEST_CONSUMER:    int64 := 256;  // char[32]
pub con GPIO_LINE_REQUEST_CONFIG:      int64 := 288;  // gpio_v2_line_config
pub con GPIO_LINE_REQUEST_NUM_LINES:   int64 := 560;  // uint32
pub con GPIO_LINE_REQUEST_EVENT_BUF:   int64 := 564;  // uint32
pub con GPIO_LINE_REQUEST_PADDING:     int64 := 568;  // uint32[5]
pub con GPIO_LINE_REQUEST_FD:          int64 := 588;  // int32

// ============================================================
// Hilfsfunktion: Puffer nullen
// ============================================================
fn gpioZeroMem(ptr: int64, size: int64) {
  var i: int64 := 0;
  while (i < size) { poke8(ptr + i, 0); i := i + 1; }
}

// ============================================================
// WP-3.2: GpioGetChipInfo
//
// Öffnet chip_path (/dev/gpiochipX) und liest gpiochip_info via ioctl.
// Rückgabe: heap-allokierter Puffer (GPIO_CHIP_INFO_SIZE Bytes),
//           Caller ruft GpioChipInfoFree() auf.
//           0 = Fehler (Gerät nicht gefunden oder ioctl fehlgeschlagen).
//
// AC-WP3.2.1: Liefert korrekte Anzahl Lines auf echtem RPi4-GPIO-Chip.
// AC-WP3.2.2: Gibt 0 zurück, wenn chip_path nicht existiert.
// ============================================================
pub fn GpioGetChipInfo(chip_path: pchar): int64 {
  var fd: int64 := GpioOpen(chip_path, GPIO_O_RDWR);
  if (fd < 0) { return 0; }

  var info: int64 := alloc(GPIO_CHIP_INFO_SIZE);
  if (info == 0) { GpioSysClose(fd); return 0; }
  gpioZeroMem(info, GPIO_CHIP_INFO_SIZE);

  var r: int64 := GpioIoctl(fd, GPIO_GET_CHIPINFO_IOCTL, info);
  GpioSysClose(fd);

  if (r < 0) { free(info, GPIO_CHIP_INFO_SIZE); return 0; }
  return info;
}

pub fn GpioChipInfoFree(info: int64) {
  free(info, GPIO_CHIP_INFO_SIZE);
}

// Gibt die Anzahl Lines zurück (Feld 'lines' bei Offset 64).
pub fn GpioChipInfoLines(info: int64): int64 {
  return peek32(info + GPIO_CHIP_INFO_LINES) & 0xFFFFFFFF;
}

// ============================================================
// WP-3.3: GpioRequestLines
//
// Öffnet chip_path und fordert num_lines Pins (im Array pins_ptr,
// je int32 pro Pin-Offset) mit der Konfiguration flags an.
// consumer: Label-String (max. 31 Zeichen).
//
// Rückgabe: Line-Fd (>= 0) bei Erfolg, -1 bei Fehler.
//   Der Caller schließt den Fd mit GpioReleaseLine().
//
// AC-WP3.3.1: num_lines > GPIO_V2_LINES_MAX → sofort -1.
// AC-WP3.3.2: Nicht existierender chip_path → -1.
// AC-WP3.3.3: SetLineValues und GetLineValues auf dem Fd.
// ============================================================
pub fn GpioRequestLines(chip_path: pchar, pins_ptr: int64, num_lines: int64,
                         flags: int64, consumer: pchar): int64 {
  if (num_lines > GPIO_V2_LINES_MAX || num_lines <= 0) { return -1; }

  var fd: int64 := GpioOpen(chip_path, GPIO_O_RDWR);
  if (fd < 0) { return -1; }

  var req: int64 := alloc(GPIO_LINE_REQUEST_SIZE);
  if (req == 0) { GpioSysClose(fd); return -1; }
  gpioZeroMem(req, GPIO_LINE_REQUEST_SIZE);

  // Pin-Offsets eintragen
  var i: int64 := 0;
  while (i < num_lines) {
    var pin: int64 := peek32(pins_ptr + i * 4) & 0xFFFFFFFF;
    poke32(req + GPIO_LINE_REQUEST_OFFSETS + i * 4, pin);
    i += 1;
  }

  // Consumer-Label kopieren
  GpioCopyStringToBuf(consumer, req + GPIO_LINE_REQUEST_CONSUMER, GPIO_MAX_NAME_SIZE);

  // config.flags setzen
  poke64(req + GPIO_LINE_REQUEST_CONFIG + GPIO_LINE_CONFIG_FLAGS, flags);

  // num_lines setzen
  poke32(req + GPIO_LINE_REQUEST_NUM_LINES, num_lines);

  var r: int64 := GpioIoctl(fd, GPIO_V2_GET_LINE_IOCTL, req);
  GpioSysClose(fd);

  if (r < 0) { free(req, GPIO_LINE_REQUEST_SIZE); return -1; }

  // Line-Fd auslesen (int32 bei Offset 588)
  var lineFd: int64 := peek32(req + GPIO_LINE_REQUEST_FD);
  // Vorzeichenerweiterung: negativer fd = Fehler
  if (lineFd < 0) { lineFd := lineFd | (0xFFFFFFFF << 32); }
  free(req, GPIO_LINE_REQUEST_SIZE);
  return lineFd;
}

// ============================================================
// WP-3.3: GpioSetLineValues
//
// Setzt die Ausgangspegel der Lines im line_fd.
// mask: Bitmap der zu ändernden Lines (Bit N = Line-Index N im Request).
// bits: Zielwerte (1 = aktiv, 0 = inaktiv).
// Rückgabe: 1 = Erfolg, 0 = Fehler.
// ============================================================
pub fn GpioSetLineValues(line_fd: int64, mask: int64, bits: int64): int64 {
  var v: int64 := alloc(GPIO_LINE_VALUES_SIZE);
  if (v == 0) { return 0; }
  poke64(v + GPIO_LINE_VALUES_BITS, bits);
  poke64(v + GPIO_LINE_VALUES_MASK, mask);
  var r: int64 := GpioIoctl(line_fd, GPIO_V2_LINE_SET_VALUES_IOCTL, v);
  free(v, GPIO_LINE_VALUES_SIZE);
  if (r < 0) { return 0; }
  return 1;
}

// ============================================================
// WP-3.3: GpioGetLineValues
//
// Liest die aktuellen Pegel der Lines im line_fd.
// mask: Bitmap der abzufragenden Lines.
// bits_out: Puffer (min. 8 Bytes) — nach Rückkehr enthält peek64(bits_out)
//           die Pegelwerte.
// Rückgabe: 1 = Erfolg, 0 = Fehler.
// ============================================================
pub fn GpioGetLineValues(line_fd: int64, mask: int64, bits_out: int64): int64 {
  var v: int64 := alloc(GPIO_LINE_VALUES_SIZE);
  if (v == 0) { return 0; }
  poke64(v + GPIO_LINE_VALUES_BITS, 0);
  poke64(v + GPIO_LINE_VALUES_MASK, mask);
  var r: int64 := GpioIoctl(line_fd, GPIO_V2_LINE_GET_VALUES_IOCTL, v);
  if (r < 0) { free(v, GPIO_LINE_VALUES_SIZE); return 0; }
  poke64(bits_out, peek64(v + GPIO_LINE_VALUES_BITS));
  free(v, GPIO_LINE_VALUES_SIZE);
  return 1;
}

// ============================================================
// WP-3.3: GpioReleaseLine
//
// Schließt den Line-Dateideskriptor.
// ============================================================
pub fn GpioReleaseLine(line_fd: int64) {
  GpioSysClose(line_fd);
}
