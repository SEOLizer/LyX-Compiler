// std/hardware/usb_types.lyx
// WP-2: USB-Descriptor-Typen abbilden
// Plattform: Linux ARM64 / x86_64
@capabilities([fs.meta, fs.read, fs.write, hardware.usb])

unit std.hardware.usb_types;

import std.hardware.usb_util;
import std.alloc;

// ============================================================
// Descriptor-Typ-Konstanten (bDescriptorType)
// ============================================================

pub con USB_DT_DEVICE:    int64 := 1;
pub con USB_DT_CONFIG:    int64 := 2;
pub con USB_DT_STRING:    int64 := 3;
pub con USB_DT_INTERFACE: int64 := 4;
pub con USB_DT_ENDPOINT:  int64 := 5;
pub con USB_DT_HID:       int64 := 33;  // 0x21 — Class-spezifisch, wird übersprungen
pub con USB_DT_REPORT:    int64 := 34;  // 0x22

// ============================================================
// Rohe Descriptor-Größen (AC-1: diese Konstanten ARE die Wahrheit)
// USB 2.0 Spec §9.6.x — byte-packed Strukturen
// ============================================================

pub con USB_SIZEOF_DESC_HDR:       int64 := 2;   // bLength + bDescriptorType
pub con USB_SIZEOF_DEVICE_DESC:    int64 := 18;
pub con USB_SIZEOF_CONFIG_DESC:    int64 := 9;
pub con USB_SIZEOF_INTERFACE_DESC: int64 := 9;
pub con USB_SIZEOF_ENDPOINT_DESC:  int64 := 7;

// ============================================================
// Endpunkt-Richtung (aus Bit 7 von bEndpointAddress)
// ============================================================

pub con USB_EP_DIR_OUT: int64 := 0;   // Host → Device
pub con USB_EP_DIR_IN:  int64 := 1;   // Device → Host

// ============================================================
// Transfer-Typen (aus Bits 1-0 von bmAttributes)
// ============================================================

pub con USB_TRANS_CONTROL:   int64 := 0;
pub con USB_TRANS_ISO:       int64 := 1;
pub con USB_TRANS_BULK:      int64 := 2;
pub con USB_TRANS_INTERRUPT: int64 := 3;

// ============================================================
// Struct-Größen der höheren Lyx-Typen
// Alle Felder int64 → 8 Bytes pro Feld (keine Padding-Überraschungen)
// ============================================================

pub con USB_SIZEOF_ENDPOINT:      int64 := 48;  // 6 Felder × 8
pub con USB_SIZEOF_INTERFACE:     int64 := 56;  // 7 Felder × 8
pub con USB_SIZEOF_CONFIGURATION: int64 := 40;  // 5 Felder × 8
pub con USB_SIZEOF_DEVICE:        int64 := 72;  // 9 Felder × 8

// ============================================================
// USBDescriptorHeader Accessoren (2 Bytes)
// Layout: [0] bLength  [1] bDescriptorType
// ============================================================

pub fn UsbDescHdr_bLength(buf: int64): int64 {
  return peek8(buf);
}

pub fn UsbDescHdr_bDescType(buf: int64): int64 {
  return peek8(buf + 1);
}

// ============================================================
// USBDeviceDescriptor Accessoren (18 Bytes)
// USB 2.0 Spec §9.6.1
// Offset  0: bLength            (1)
// Offset  1: bDescriptorType    (1) = 1
// Offset  2: bcdUSB             (2) LE
// Offset  4: bDeviceClass       (1)
// Offset  5: bDeviceSubClass    (1)
// Offset  6: bDeviceProtocol    (1)
// Offset  7: bMaxPacketSize0    (1)
// Offset  8: idVendor           (2) LE
// Offset 10: idProduct          (2) LE
// Offset 12: bcdDevice          (2) LE
// Offset 14: iManufacturer      (1)
// Offset 15: iProduct           (1)
// Offset 16: iSerialNumber      (1)
// Offset 17: bNumConfigurations (1)
// ============================================================

pub fn UsbDevDesc_bLength(buf: int64): int64            { return peek8(buf); }
pub fn UsbDevDesc_bDescriptorType(buf: int64): int64    { return peek8(buf + 1); }
pub fn UsbDevDesc_bcdUSB(buf: int64): int64             { return peek16(buf + 2) & 0xFFFF; }
pub fn UsbDevDesc_bDeviceClass(buf: int64): int64       { return peek8(buf + 4); }
pub fn UsbDevDesc_bDeviceSubClass(buf: int64): int64    { return peek8(buf + 5); }
pub fn UsbDevDesc_bDeviceProtocol(buf: int64): int64    { return peek8(buf + 6); }
pub fn UsbDevDesc_bMaxPacketSize0(buf: int64): int64    { return peek8(buf + 7); }
pub fn UsbDevDesc_idVendor(buf: int64): int64           { return peek16(buf + 8)  & 0xFFFF; }
pub fn UsbDevDesc_idProduct(buf: int64): int64          { return peek16(buf + 10) & 0xFFFF; }
pub fn UsbDevDesc_bcdDevice(buf: int64): int64          { return peek16(buf + 12) & 0xFFFF; }
pub fn UsbDevDesc_iManufacturer(buf: int64): int64      { return peek8(buf + 14); }
pub fn UsbDevDesc_iProduct(buf: int64): int64           { return peek8(buf + 15); }
pub fn UsbDevDesc_iSerialNumber(buf: int64): int64      { return peek8(buf + 16); }
pub fn UsbDevDesc_bNumConfigurations(buf: int64): int64 { return peek8(buf + 17); }

// ============================================================
// USBConfigurationDescriptor Accessoren (9 Bytes)
// USB 2.0 Spec §9.6.3
// Offset  0: bLength             (1)
// Offset  1: bDescriptorType     (1) = 2
// Offset  2: wTotalLength        (2) LE
// Offset  4: bNumInterfaces      (1)
// Offset  5: bConfigurationValue (1)
// Offset  6: iConfiguration      (1)
// Offset  7: bmAttributes        (1)
// Offset  8: bMaxPower           (1)  in 2-mA-Einheiten
// ============================================================

pub fn UsbCfgDesc_bLength(buf: int64): int64              { return peek8(buf); }
pub fn UsbCfgDesc_bDescriptorType(buf: int64): int64      { return peek8(buf + 1); }
pub fn UsbCfgDesc_wTotalLength(buf: int64): int64         { return peek16(buf + 2) & 0xFFFF; }
pub fn UsbCfgDesc_bNumInterfaces(buf: int64): int64       { return peek8(buf + 4); }
pub fn UsbCfgDesc_bConfigurationValue(buf: int64): int64  { return peek8(buf + 5); }
pub fn UsbCfgDesc_iConfiguration(buf: int64): int64       { return peek8(buf + 6); }
pub fn UsbCfgDesc_bmAttributes(buf: int64): int64         { return peek8(buf + 7); }
pub fn UsbCfgDesc_bMaxPower(buf: int64): int64            { return peek8(buf + 8); }

// ============================================================
// USBInterfaceDescriptor Accessoren (9 Bytes)
// USB 2.0 Spec §9.6.5
// Offset  0: bLength            (1)
// Offset  1: bDescriptorType    (1) = 4
// Offset  2: bInterfaceNumber   (1)
// Offset  3: bAlternateSetting  (1)
// Offset  4: bNumEndpoints      (1)
// Offset  5: bInterfaceClass    (1)
// Offset  6: bInterfaceSubClass (1)
// Offset  7: bInterfaceProtocol (1)
// Offset  8: iInterface         (1)
// ============================================================

pub fn UsbIfDesc_bLength(buf: int64): int64            { return peek8(buf); }
pub fn UsbIfDesc_bDescriptorType(buf: int64): int64    { return peek8(buf + 1); }
pub fn UsbIfDesc_bInterfaceNumber(buf: int64): int64   { return peek8(buf + 2); }
pub fn UsbIfDesc_bAlternateSetting(buf: int64): int64  { return peek8(buf + 3); }
pub fn UsbIfDesc_bNumEndpoints(buf: int64): int64      { return peek8(buf + 4); }
pub fn UsbIfDesc_bInterfaceClass(buf: int64): int64    { return peek8(buf + 5); }
pub fn UsbIfDesc_bInterfaceSubClass(buf: int64): int64 { return peek8(buf + 6); }
pub fn UsbIfDesc_bInterfaceProtocol(buf: int64): int64 { return peek8(buf + 7); }
pub fn UsbIfDesc_iInterface(buf: int64): int64         { return peek8(buf + 8); }

// ============================================================
// USBEndpointDescriptor Accessoren (7 Bytes)
// USB 2.0 Spec §9.6.6
// Offset  0: bLength          (1)
// Offset  1: bDescriptorType  (1) = 5
// Offset  2: bEndpointAddress (1)  Bit 7: 0=OUT, 1=IN; Bits 0-3: Nr
// Offset  3: bmAttributes     (1)  Bits 1-0: 0=Ctrl, 1=Iso, 2=Bulk, 3=Int
// Offset  4: wMaxPacketSize   (2) LE
// Offset  6: bInterval        (1)
// ============================================================

pub fn UsbEpDesc_bLength(buf: int64): int64           { return peek8(buf); }
pub fn UsbEpDesc_bDescriptorType(buf: int64): int64   { return peek8(buf + 1); }
pub fn UsbEpDesc_bEndpointAddress(buf: int64): int64  { return peek8(buf + 2); }
pub fn UsbEpDesc_bmAttributes(buf: int64): int64      { return peek8(buf + 3); }
pub fn UsbEpDesc_wMaxPacketSize(buf: int64): int64    { return peek16(buf + 4) & 0xFFFF; }
pub fn UsbEpDesc_bInterval(buf: int64): int64         { return peek8(buf + 6); }

// ============================================================
// AC-3: bEndpointAddress Bit 7 → Richtung
// AC-4: bmAttributes Bits 1-0 → Transfer-Typ
// ============================================================

pub fn UsbEpDirection(epAddr: int64): int64 {
  if ((epAddr & 0x80) != 0) { return USB_EP_DIR_IN; }
  return USB_EP_DIR_OUT;
}

pub fn UsbEpNumber(epAddr: int64): int64 {
  return epAddr & 0x0F;
}

pub fn UsbEpTransferType(bmAttrs: int64): int64 {
  return bmAttrs & 0x03;
}

// ============================================================
// Höhere Lyx-Typen
// Alle Felder int64 (8 Bytes), damit Pointer und Zahlen einheitlich sind.
// Arrays: alloc(n * USB_SIZEOF_*) + manuelle Offset-Arithmetik.
// ============================================================

pub type UsbEndpoint = struct {
  address:       int64;   // bEndpointAddress (roh)
  direction:     int64;   // USB_EP_DIR_OUT / USB_EP_DIR_IN
  number:        int64;   // Bits 0-3 von bEndpointAddress
  transfer_type: int64;   // USB_TRANS_*
  max_packet:    int64;   // wMaxPacketSize
  interval:      int64;   // bInterval
};

pub type UsbInterface = struct {
  interface_number:  int64;
  alternate_setting: int64;
  class_code:        int64;
  subclass_code:     int64;
  protocol_code:     int64;
  num_endpoints:     int64;
  endpoints:         int64;  // Zeiger auf UsbEndpoint-Array (alloc'd)
};

pub type UsbConfiguration = struct {
  configuration_value: int64;
  attributes:          int64;
  max_power_ma:        int64;   // bMaxPower * 2
  num_interfaces:      int64;
  interfaces:          int64;   // Zeiger auf UsbInterface-Array (alloc'd)
};

pub type UsbDevice = struct {
  vendor_id:    int64;
  product_id:   int64;
  device_class: int64;
  usb_version:  int64;   // bcdUSB
  bus_num:      int64;
  dev_num:      int64;
  handle:       int64;   // fd aus usb_open (bleibt offen)
  num_configs:  int64;
  configs:      int64;   // Zeiger auf UsbConfiguration-Array (alloc'd)
};

// ============================================================
// Array-Navigations-Hilfsfunktionen
// ============================================================

// Gibt den Zeiger auf UsbEndpoint[i] zurück.
pub fn UsbEndpointAt(base: int64, i: int64): int64 {
  return base + i * USB_SIZEOF_ENDPOINT;
}

// Gibt den Zeiger auf UsbInterface[i] zurück.
pub fn UsbInterfaceAt(base: int64, i: int64): int64 {
  return base + i * USB_SIZEOF_INTERFACE;
}

// Gibt den Zeiger auf UsbConfiguration[i] zurück.
pub fn UsbConfigAt(base: int64, i: int64): int64 {
  return base + i * USB_SIZEOF_CONFIGURATION;
}

// ============================================================
// UsbEndpoint aus rohem Descriptor-Buffer befüllen
// ============================================================

pub fn UsbEndpointFromDesc(ep: int64, epDescBuf: int64) {
  var addr: int64  := UsbEpDesc_bEndpointAddress(epDescBuf);
  var attrs: int64 := UsbEpDesc_bmAttributes(epDescBuf);
  // ep.address
  poke64(ep,      addr);
  // ep.direction
  poke64(ep + 8,  UsbEpDirection(addr));
  // ep.number
  poke64(ep + 16, UsbEpNumber(addr));
  // ep.transfer_type
  poke64(ep + 24, UsbEpTransferType(attrs));
  // ep.max_packet
  poke64(ep + 32, UsbEpDesc_wMaxPacketSize(epDescBuf));
  // ep.interval
  poke64(ep + 40, UsbEpDesc_bInterval(epDescBuf));
}
