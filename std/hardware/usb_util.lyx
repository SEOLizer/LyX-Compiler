// std/hardware/usb_util.lyx
// WP-1.1: Hilfstypen und -funktionen für USB-Geräteerkennung
// Plattform: Linux ARM64 / x86_64
@capabilities([fs.meta, fs.read, fs.write, hardware.usb])

unit std.hardware.usb_util;

import std.hardware.usb_syscalls;

// ============================================================
// LinuxDirent64-Accessoren
//
// struct linux_dirent64 (variabel lang):
//   +0:  d_ino    uint64  (8 Bytes) — Inode-Nummer
//   +8:  d_off    int64   (8 Bytes) — Offset zum nächsten Eintrag
//   +16: d_reclen uint16  (2 Bytes) — Gesamtlänge dieses Eintrags
//   +18: d_type   uint8   (1 Byte)  — Dateityp (DT_REG, DT_DIR, ...)
//   +19: d_name   char[]            — Null-terminierter Name
// ============================================================

// Gibt die Inode-Nummer des Eintrags zurück.
pub fn Dirent64Ino(entry: int64): int64 {
  return peek64(entry);
}

// Gibt die Gesamtlänge des Eintrags zurück (für die Weiterschaltung des Offset).
pub fn Dirent64RecLen(entry: int64): int64 {
  return peek16(entry + 16);
}

// Gibt den Dateityp zurück (USB_DT_REG, USB_DT_DIR, ...).
pub fn Dirent64Type(entry: int64): int64 {
  return peek8(entry + 18);
}

// Gibt einen Zeiger auf den Dateinamen (null-terminiert) zurück.
pub fn Dirent64Name(entry: int64): int64 {
  return entry + 19;
}

// ============================================================
// IsNumeric — prüft ob alle Zeichen des Strings Dezimalziffern sind
// ptr: Zeiger auf null-terminierten String (als int64).
// Gibt 1 zurück wenn alle Zeichen 0–9 sind und der String nicht leer ist.
// ============================================================
pub fn UsbIsNumeric(ptr: int64): int64 {
  var c: int64 := peek8(ptr);
  if (c == 0) {
    return 0;
  }
  var i: int64 := 0;
  while (true) {
    c := peek8(ptr + i);
    if (c == 0) {
      return 1;
    }
    if ((c < 48) | (c > 57)) {
      return 0;
    }
    i += 1;
  }
  return 0;
}

// ============================================================
// ParseNum — parst Dezimal-String als int64
// ptr: Zeiger auf null-terminierten Dezimal-String.
// Gibt den numerischen Wert zurück (0 bei leerem/nicht-numerischem String).
// ============================================================
pub fn UsbParseNum(ptr: int64): int64 {
  var result: int64 := 0;
  var i: int64 := 0;
  while (true) {
    var c: int64 := peek8(ptr + i);
    if (c == 0) {
      return result;
    }
    if ((c < 48) | (c > 57)) {
      return result;
    }
    result := result * 10 + (c - 48);
    i += 1;
  }
  return result;
}

// ============================================================
// BuildPath — fügt Pfadsegmente zusammen
// Schreibt in buf (max buf_size Bytes inkl. NUL-Terminator).
// Beispiel: BuildPath("/dev/bus/usb/", "001", "/", buf, 64)
//           → "/dev/bus/usb/001/"
// ============================================================
pub fn UsbBuildPath(base: int64, segment: int64, suffix: int64, buf: int64, buf_size: int64) {
  var i: int64 := 0;
  // Basis kopieren
  while (i < buf_size - 1) {
    var c: int64 := peek8(base + i);
    if (c == 0) {
      break;
    }
    poke8(buf + i, c);
    i += 1;
  }
  // Segment anhängen
  var j: int64 := 0;
  while (i < buf_size - 1) {
    var c: int64 := peek8(segment + j);
    if (c == 0) {
      break;
    }
    poke8(buf + i, c);
    i += 1;
    j += 1;
  }
  // Suffix anhängen
  j := 0;
  while (i < buf_size - 1) {
    var c: int64 := peek8(suffix + j);
    if (c == 0) {
      break;
    }
    poke8(buf + i, c);
    i += 1;
    j += 1;
  }
  poke8(buf + i, 0);
}

// ============================================================
// StrLen — Länge eines null-terminierten Strings (als int64-Ptr)
// ============================================================
pub fn UsbStrLen(ptr: int64): int64 {
  var n: int64 := 0;
  while (peek8(ptr + n) != 0) {
    n += 1;
  }
  return n;
}
