// std/hardware/gpio_pin.lyx
// WP-4b: Typsichere Pin-Wrapper (Makro-Fallback ohne Generics)
//
// Implementiert ein Konventions-basiertes Typsystem:
//   GpioOutputPin* — nur Write, kein Read
//   GpioInputPin*  — nur Read, kein Write
//
// Sicherheitseigenschaft: Ruft Code GpioOutputPinRead() oder
// GpioInputPinWrite() auf, schlägt die Kompilierung mit "unknown
// function" fehl — analoges Verhalten zu WP-4a Linker-Fehler.
//
// Pin-Kontext (16 Bytes):
//   +0: gpio_ctx  (int64) — Zeiger auf MMIO-Kontext (gpio_mmio)
//   +8: pin_nr    (int64) — Pin-Nummer (0–53)
//
// Voraussetzungen: WP-2 (gpio_mmio), WP-2.5 (pull), WP-2.3 (SetPinMode)
@capabilities([fs.read, hardware.gpio])

unit std.hardware.gpio_pin;

import std.hardware.gpio_mmio;
import std.alloc;

pub con GPIO_PIN_CTX_SIZE: int64 := 16;

// ============================================================
// Interne Hilfsfunktionen
// ============================================================

fn pinCtxAlloc(gpio_ctx: int64, pin_nr: int64): int64 {
  var ctx: int64 := alloc(GPIO_PIN_CTX_SIZE);
  if (ctx == 0) { return 0; }
  poke64(ctx,     gpio_ctx);
  poke64(ctx + 8, pin_nr);
  return ctx;
}

fn pinCtxGpioCtx(ctx: int64): int64 { return peek64(ctx); }
fn pinCtxPinNr(ctx: int64):  int64  { return peek64(ctx + 8); }

// ============================================================
// OutputPin — nur Write, kein Read
//
// GpioOutputPinAlloc  — allokiert Pin-Kontext
// GpioOutputPinInit   — setzt Pin-Modus auf OUTPUT + optionaler Pull
// GpioOutputPinWrite  — setzt Pegel HIGH oder LOW
// GpioOutputPinFree   — gibt Pin-Kontext frei
//
// NICHT vorhanden: GpioOutputPinRead → Compiler-Fehler bei Aufruf
// ============================================================
pub fn GpioOutputPinAlloc(gpio_ctx: int64, pin_nr: int64): int64 {
  return pinCtxAlloc(gpio_ctx, pin_nr);
}

// pull: GPIO_PULL_NONE / GPIO_PULL_DOWN / GPIO_PULL_UP
// Rückgabe: 1 = Erfolg, 0 = Fehler (ungültiger Pin oder nicht gemappt)
pub fn GpioOutputPinInit(pin_ctx: int64, pull: int64): int64 {
  var gc:  int64 := pinCtxGpioCtx(pin_ctx);
  var pin: int64 := pinCtxPinNr(pin_ctx);
  var r:   int64 := GpioSetPinMode(gc, pin, GPIO_PIN_OUTPUT);
  if (r == 0) { return 0; }
  if (pull != GPIO_PULL_NONE) {
    GpioSetPullMode(gc, pin, pull);
  }
  return 1;
}

// state: GPIO_PIN_HIGH oder GPIO_PIN_LOW
// Rückgabe: 1 = Erfolg, 0 = Fehler
pub fn GpioOutputPinWrite(pin_ctx: int64, state: int64): int64 {
  return GpioWritePin(pinCtxGpioCtx(pin_ctx), pinCtxPinNr(pin_ctx), state);
}

pub fn GpioOutputPinFree(pin_ctx: int64) {
  free(pin_ctx, GPIO_PIN_CTX_SIZE);
}

// ============================================================
// InputPin — nur Read, kein Write
//
// GpioInputPinAlloc  — allokiert Pin-Kontext
// GpioInputPinInit   — setzt Pin-Modus auf INPUT + optionaler Pull
// GpioInputPinRead   — liest aktuellen Pegel (0/1, -1 bei Fehler)
// GpioInputPinFree   — gibt Pin-Kontext frei
//
// NICHT vorhanden: GpioInputPinWrite → Compiler-Fehler bei Aufruf
// ============================================================
pub fn GpioInputPinAlloc(gpio_ctx: int64, pin_nr: int64): int64 {
  return pinCtxAlloc(gpio_ctx, pin_nr);
}

// pull: typischerweise GPIO_PULL_UP oder GPIO_PULL_DOWN für Taster
pub fn GpioInputPinInit(pin_ctx: int64, pull: int64): int64 {
  var gc:  int64 := pinCtxGpioCtx(pin_ctx);
  var pin: int64 := pinCtxPinNr(pin_ctx);
  var r:   int64 := GpioSetPinMode(gc, pin, GPIO_PIN_INPUT);
  if (r == 0) { return 0; }
  if (pull != GPIO_PULL_NONE) {
    GpioSetPullMode(gc, pin, pull);
  }
  return 1;
}

// Rückgabe: 0 = LOW, 1 = HIGH, -1 = Fehler (ungültiger Pin / nicht gemappt)
pub fn GpioInputPinRead(pin_ctx: int64): int64 {
  return GpioReadPin(pinCtxGpioCtx(pin_ctx), pinCtxPinNr(pin_ctx));
}

pub fn GpioInputPinFree(pin_ctx: int64) {
  free(pin_ctx, GPIO_PIN_CTX_SIZE);
}
