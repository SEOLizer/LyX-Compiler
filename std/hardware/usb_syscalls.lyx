// std/hardware/usb_syscalls.lyx
// WP-1: Low-Level-Syscalls für USB via Linux usbdevfs
// Plattform: Linux ARM64 / x86_64
@capabilities([fs.meta, fs.read, fs.write, hardware.usb])

unit std.hardware.usb_syscalls;

// ============================================================
// Konstanten
// ============================================================

pub con USB_AT_FDCWD: int64 := -100;   // dirfd=aktuelles Verzeichnis

pub con USB_O_RDONLY:    int64 := 0;
pub con USB_O_WRONLY:    int64 := 1;
pub con USB_O_RDWR:      int64 := 2;
pub con USB_O_DIRECTORY: int64 := 65536;  // 0x10000 — muss ein Verzeichnis sein

pub con USB_SEEK_SET: int64 := 0;
pub con USB_SEEK_CUR: int64 := 1;
pub con USB_SEEK_END: int64 := 2;

pub con USB_DT_UNKNOWN: int64 := 0;
pub con USB_DT_DIR:     int64 := 4;
pub con USB_DT_REG:     int64 := 8;

pub con USB_POLLIN:  int64 := 1;   // Daten verfügbar / URB abgeschlossen
pub con USB_POLLOUT: int64 := 4;
pub con USB_POLLERR: int64 := 8;

// ============================================================
// Syscall-Wrapper
// ============================================================

// Öffnet eine Datei oder ein Verzeichnis.
// Entspricht openat(AT_FDCWD, path, flags) — da Lyx open() ohne Modus-Arg arbeitet,
// wird mode=0 übergeben (kein O_CREAT → mode ignoriert).
pub fn usb_open(path: pchar, flags: int64): int64 {
  return open(path, flags, 0);
}

// Liest bis zu len Bytes aus fd in buf.
// Rückgabe: gelesene Bytes (>= 0) oder negativer Fehlercode.
pub fn usb_read(fd: int64, buf: int64, len: int64): int64 {
  return read(fd, buf, len);
}

// Schreibt len Bytes aus buf nach fd.
pub fn usb_write(fd: int64, buf: int64, len: int64): int64 {
  return write(fd, buf, len);
}

// Führt ein ioctl aus — für usbdevfs: Control, Bulk, Claim, URB.
// arg: Zeiger auf das Transfer-Struct (als int64 übergeben).
pub fn usb_ioctl(fd: int64, request: int64, arg: int64): int64 {
  return sys_ioctl(fd, request, arg);
}

// Schließt einen Dateideskriptor.
pub fn usb_close(fd: int64): int64 {
  return close(fd);
}

// Setzt den Datei-Lesezeiger.
// whence: USB_SEEK_SET (0), USB_SEEK_CUR (1), USB_SEEK_END (2).
pub fn usb_lseek(fd: int64, offset: int64, whence: int64): int64 {
  return lseek(fd, offset, whence);
}

// Liest Verzeichniseinträge aus einem geöffneten Verzeichnis-fd.
// buf: Pufferadresse (int64), count: Puffergröße in Bytes.
// Rückgabe: Anzahl gelesener Bytes oder 0 (EOF) oder < 0 (Fehler).
pub fn usb_getdents64(fd: int64, buf: int64, count: int64): int64 {
  return getdents64(fd, buf, count);
}

// Wartet auf Ereignisse auf einem oder mehreren Dateideskriptoren.
// fds_ptr: Zeiger auf pollfd-Array (je 8 Bytes: int32 fd, int16 events, int16 revents).
// nfds: Anzahl der Einträge. timeout_ms: -1 = unbegrenzt, 0 = sofortig.
// Rückgabe: Anzahl der Fds mit Ereignissen, 0 bei Timeout, < 0 bei Fehler.
pub fn usb_poll(fds_ptr: int64, nfds: int64, timeout_ms: int64): int64 {
  return sys_poll(fds_ptr, nfds, timeout_ms);
}

// ============================================================
// pollfd Hilfsfunktionen
// pollfd-Layout: { int32 fd (+0), int16 events (+4), int16 revents (+6) } = 8 Bytes
// ============================================================

// Schreibt eine pollfd-Struktur in den Puffer an der Adresse ptr.
pub fn usb_pollfd_set(ptr: int64, fd: int64, events: int64) {
  poke32(ptr,     fd);
  poke16(ptr + 4, events);
  poke16(ptr + 6, 0);
}

// Liest den revents-Wert aus einer pollfd-Struktur.
pub fn usb_pollfd_revents(ptr: int64): int64 {
  return peek16(ptr + 6);
}
