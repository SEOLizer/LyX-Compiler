// std/hardware/pci_config.lyx
// PCI-03: Zugriff auf den Konfigurationsraum, unabhaengig vom Weg dorthin.
//
// Vier Backends teilen sich eine Schnittstelle:
//   1 sysfs  — /sys/bus/pci/devices/<bdf>/config (Linux)
//   2 portio — 0xCF8/0xCFC (PCI-11)
//   3 ecam   — memory-mapped Config-Space (PCI-12)
//   4 mem    — ein Puffer im Speicher; kein Hardwarezugriff, sondern ein
//              vollwertiger Weg fuer Momentaufnahmen und fuer Tests ohne
//              Geraet. Bewusst oeffentlich, nicht heimlich.
//
// Der Zweig fuer ein nicht gesetztes oder unbekanntes Backend meldet
// PCI_E_NOBACKEND. Er tut NICHT ersatzweise etwas Plausibles: ein
// stillschweigendes 0 waere von einem echten Registerwert nicht zu
// unterscheiden und verwandelte jede Luecke in eine Fehlfunktion.

@description("PCI configuration space access with pluggable backend")
@author("Andreas Roene")
unit std.hardware.pci_config;

import std.hardware.pci_types;
import std.hardware.pci_syscalls;
import std.hardware.pci_portio;
import std.alloc;

// ============================================================
// Backend-Kennungen
// ============================================================

pub con PCI_BACKEND_NONE:   int64 := 0;
pub con PCI_BACKEND_SYSFS:  int64 := 1;
pub con PCI_BACKEND_PORTIO: int64 := 2;
pub con PCI_BACKEND_ECAM:   int64 := 3;
pub con PCI_BACKEND_MEM:    int64 := 4;

// ============================================================
// Kontext (heap-allokiert, 32 Bytes)
//   +0   backend
//   +8   fd (sysfs) | Basisadresse (ecam/mem) | 0 (portio)
//   +16  bdf, gepackt
//   +24  Groesse des erreichbaren Config-Raums in Bytes
// ============================================================

pub con PCI_CFG_CTX_SIZE: int64 := 32;

pub fn PciCfgBackend(ctx: int64): int64 { return peek64(ctx); }
pub fn PciCfgHandle(ctx: int64): int64  { return peek64(ctx + 8); }
pub fn PciCfgBdf(ctx: int64): int64     { return peek64(ctx + 16); }
pub fn PciCfgSize(ctx: int64): int64    { return peek64(ctx + 24); }

fn ctxAlloc(backend: int64, handle: int64, bdf: int64, size: int64): int64 {
  var ctx: int64 := alloc(PCI_CFG_CTX_SIZE);
  if (ctx == 0) { return PCI_E_NOMEM; }
  poke64(ctx,      backend);
  poke64(ctx + 8,  handle);
  poke64(ctx + 16, bdf);
  poke64(ctx + 24, size);
  return ctx;
}

// ============================================================
// Oeffnen und Schliessen
// ============================================================

// sysfs: lesend genuegt der Aufruf ohne root, schreibend nicht. Deshalb
// zuerst O_RDWR versuchen und bei Verweigerung auf O_RDONLY zurueckfallen —
// der Rueckfall ist gewollt und sichtbar: PciCfgWritable() sagt hinterher,
// was moeglich ist.
pub fn PciCfgOpenSysfs(bdf: int64): int64 {
  if (bdf < 0) { return PCI_E_BADARG; }
  var path: int64 := alloc(PCI_PATH_MAX);
  if (path == 0) { return PCI_E_NOMEM; }
  var r: int64 := PciSysfsPath(path, bdf, "config");
  if (r < 0) { free(path, PCI_PATH_MAX); return r; }

  var fd: int64 := PciOpenFile(path as pchar, PCI_O_RDWR);
  if (fd < 0) {
    fd := PciOpenFile(path as pchar, PCI_O_RDONLY);
  }
  free(path, PCI_PATH_MAX);
  if (fd < 0) { return PCI_E_NODEV; }

  // Erreichbare Groesse feststellen: PCIe-Geraete liefern 4096 Bytes,
  // reine PCI-Geraete 256. Ein Leseversuch am oberen Ende entscheidet das,
  // statt es zu raten.
  var probe: int64 := alloc(4);
  var size: int64 := PCI_CFG_SIZE_LEGACY;
  if (probe != 0) {
    if (PciPread(fd, probe, 4, PCI_CFG_SIZE_PCIE - 4) == 4) {
      size := PCI_CFG_SIZE_PCIE;
    }
    free(probe, 4);
  }

  var ctx: int64 := ctxAlloc(PCI_BACKEND_SYSFS, fd, bdf, size);
  if (ctx < 0) { PciCloseFile(fd); return ctx; }
  return ctx;
}

// Puffer-Backend: len Bytes ab buf sind der Config-Space.
pub fn PciCfgOpenMem(buf: int64, len: int64, bdf: int64): int64 {
  if (buf == 0) { return PCI_E_BADARG; }
  if (len < 64) { return PCI_E_BADARG; }
  return ctxAlloc(PCI_BACKEND_MEM, buf, bdf, len);
}

// ECAM/portio werden von PCI-11/PCI-12 gefuellt; hier steht nur der
// Konstruktor, damit die Umschaltung unten vollstaendig ist.
pub fn PciCfgOpenEcam(base: int64, bdf: int64): int64 {
  if (base == 0) { return PCI_E_BADARG; }
  return ctxAlloc(PCI_BACKEND_ECAM, base, bdf, PCI_CFG_SIZE_PCIE);
}

// Legacy-Portweg (PCI-11). Der Deskriptor auf /dev/port ist der Griff;
// ohne ihn gibt es keinen Zugriff, deshalb scheitert das Oeffnen hier und
// nicht erst beim ersten Lesen.
pub fn PciCfgOpenPortIo(bdf: int64): int64 {
  if (bdf < 0) { return PCI_E_BADARG; }
  var fd: int64 := PciPortOpen();
  if (fd < 0) { return fd; }
  var ctx: int64 := ctxAlloc(PCI_BACKEND_PORTIO, fd, bdf, PCI_CFG_SIZE_LEGACY);
  if (ctx < 0) { PciPortClose(fd); return ctx; }
  return ctx;
}

pub fn PciCfgClose(ctx: int64) {
  if (ctx <= 0) { return; }
  if (peek64(ctx) == PCI_BACKEND_SYSFS)  { PciCloseFile(peek64(ctx + 8)); }
  if (peek64(ctx) == PCI_BACKEND_PORTIO) { PciPortClose(peek64(ctx + 8)); }
  free(ctx, PCI_CFG_CTX_SIZE);
}

// ============================================================
// Lesen
// ============================================================

fn readRaw(ctx: int64, off: int64, width: int64): int64 {
  if (ctx <= 0) { return PCI_E_BADARG; }
  if (off < 0)  { return PCI_E_BADARG; }
  if ((off + width) > peek64(ctx + 24)) { return PCI_E_RANGE; }

  var backend: int64 := peek64(ctx);
  var handle:  int64 := peek64(ctx + 8);

  if (backend == PCI_BACKEND_SYSFS) {
    var tmp: int64 := alloc(8);
    if (tmp == 0) { return PCI_E_NOMEM; }
    poke64(tmp, 0);
    var n: int64 := PciPread(handle, tmp, width, off);
    var v: int64 := 0;
    if (width == 1) { v := peek8(tmp); }
    if (width == 2) { v := peek16(tmp); }
    if (width == 4) { v := peek32(tmp) & 4294967295; }
    free(tmp, 8);
    if (n != width) { return PCI_E_IO; }
    return v;
  }

  if (backend == PCI_BACKEND_MEM || backend == PCI_BACKEND_ECAM) {
    if (width == 1) { return peek8(handle + off); }
    if (width == 2) { return peek16(handle + off); }
    if (width == 4) { return peek32(handle + off) & 4294967295; }
    return PCI_E_BADARG;
  }

  if (backend == PCI_BACKEND_PORTIO) {
    return PciPortIoCfgRead(handle, peek64(ctx + 16), off, width);
  }

  return PCI_E_NOBACKEND;
}

pub fn PciCfgRead8(ctx: int64, off: int64): int64  { return readRaw(ctx, off, 1); }
pub fn PciCfgRead16(ctx: int64, off: int64): int64 { return readRaw(ctx, off, 2); }
pub fn PciCfgRead32(ctx: int64, off: int64): int64 { return readRaw(ctx, off, 4); }

// ============================================================
// Schreiben
// ============================================================

fn writeRaw(ctx: int64, off: int64, val: int64, width: int64): int64 {
  if (ctx <= 0) { return PCI_E_BADARG; }
  if (off < 0)  { return PCI_E_BADARG; }
  if ((off + width) > peek64(ctx + 24)) { return PCI_E_RANGE; }

  var backend: int64 := peek64(ctx);
  var handle:  int64 := peek64(ctx + 8);

  if (backend == PCI_BACKEND_SYSFS) {
    var tmp: int64 := alloc(8);
    if (tmp == 0) { return PCI_E_NOMEM; }
    poke64(tmp, 0);
    if (width == 1) { poke8(tmp, val & 255); }
    if (width == 2) { poke16(tmp, val & 65535); }
    if (width == 4) { poke32(tmp, val & 4294967295); }
    var n: int64 := PciPwrite(handle, tmp, width, off);
    free(tmp, 8);
    if (n != width) { return PCI_E_PERM; }
    return 0;
  }

  if (backend == PCI_BACKEND_MEM || backend == PCI_BACKEND_ECAM) {
    if (width == 1) { poke8(handle + off, val & 255); return 0; }
    if (width == 2) { poke16(handle + off, val & 65535); return 0; }
    if (width == 4) { poke32(handle + off, val & 4294967295); return 0; }
    return PCI_E_BADARG;
  }

  if (backend == PCI_BACKEND_PORTIO) {
    return PciPortIoCfgWrite(handle, peek64(ctx + 16), off, val, width);
  }

  return PCI_E_NOBACKEND;
}

pub fn PciCfgWrite8(ctx: int64, off: int64, val: int64): int64  { return writeRaw(ctx, off, val, 1); }
pub fn PciCfgWrite16(ctx: int64, off: int64, val: int64): int64 { return writeRaw(ctx, off, val, 2); }
pub fn PciCfgWrite32(ctx: int64, off: int64, val: int64): int64 { return writeRaw(ctx, off, val, 4); }

// ============================================================
// Benannte Felder
// ============================================================

pub fn PciVendorId(ctx: int64): int64   { return PciCfgRead16(ctx, PCI_CFG_VENDOR_ID); }
pub fn PciDeviceId(ctx: int64): int64   { return PciCfgRead16(ctx, PCI_CFG_DEVICE_ID); }
pub fn PciRevision(ctx: int64): int64   { return PciCfgRead8(ctx, PCI_CFG_REVISION); }
pub fn PciProgIf(ctx: int64): int64     { return PciCfgRead8(ctx, PCI_CFG_PROG_IF); }
pub fn PciSubclass(ctx: int64): int64   { return PciCfgRead8(ctx, PCI_CFG_SUBCLASS); }
pub fn PciBaseClass(ctx: int64): int64  { return PciCfgRead8(ctx, PCI_CFG_CLASS); }
pub fn PciSubsysVendor(ctx: int64): int64 { return PciCfgRead16(ctx, PCI_CFG_SUBSYS_VENDOR); }
pub fn PciSubsysId(ctx: int64): int64     { return PciCfgRead16(ctx, PCI_CFG_SUBSYS_ID); }
pub fn PciIntPin(ctx: int64): int64     { return PciCfgRead8(ctx, PCI_CFG_INT_PIN); }
pub fn PciIntLine(ctx: int64): int64    { return PciCfgRead8(ctx, PCI_CFG_INT_LINE); }

// Roher Header-Typ inklusive Multifunction-Bit.
pub fn PciHeaderTypeRaw(ctx: int64): int64 { return PciCfgRead8(ctx, PCI_CFG_HEADER_TYPE); }

// Header-Typ ohne Bit 7.
pub fn PciHeaderType(ctx: int64): int64 {
  var v: int64 := PciCfgRead8(ctx, PCI_CFG_HEADER_TYPE);
  if (v < 0) { return v; }
  return v & PCI_HDR_TYPE_MASK;
}

pub fn PciIsMultifunction(ctx: int64): int64 {
  var v: int64 := PciCfgRead8(ctx, PCI_CFG_HEADER_TYPE);
  if (v < 0) { return v; }
  if ((v & PCI_HDR_MULTIFUNCTION) != 0) { return 1; }
  return 0;
}

// Existiert an dieser Adresse ueberhaupt ein Geraet?
pub fn PciCfgDevicePresent(ctx: int64): int64 {
  var v: int64 := PciVendorId(ctx);
  if (v < 0) { return v; }
  if (v == 65535 || v == 0) { return 0; }
  return 1;
}

// ============================================================
// Command-Register: benannte Schalter statt Handarbeit
//
// Wer Bus-Mastering von Hand setzt, liest 16 Bit, verodert und schreibt
// zurueck. Das dreimal im Anwendercode zu wiederholen ist die Stelle, an
// der irgendwann ein anderes Bit mit geloescht wird.
// ============================================================

fn cmdSet(ctx: int64, bits: int64, on: int64): int64 {
  var cur: int64 := PciCfgRead16(ctx, PCI_CFG_COMMAND);
  if (cur < 0) { return cur; }
  var next: int64 := cur;
  if (on == 1) { next := cur | bits; } else { next := cur & (~bits); }
  if (next == cur) { return 0; }
  return PciCfgWrite16(ctx, PCI_CFG_COMMAND, next);
}

pub fn PciEnableBusMaster(ctx: int64): int64  { return cmdSet(ctx, PCI_CMD_BUS_MASTER, 1); }
pub fn PciDisableBusMaster(ctx: int64): int64 { return cmdSet(ctx, PCI_CMD_BUS_MASTER, 0); }
pub fn PciEnableMemSpace(ctx: int64): int64   { return cmdSet(ctx, PCI_CMD_MEM_SPACE, 1); }
pub fn PciDisableMemSpace(ctx: int64): int64  { return cmdSet(ctx, PCI_CMD_MEM_SPACE, 0); }
pub fn PciEnableIoSpace(ctx: int64): int64    { return cmdSet(ctx, PCI_CMD_IO_SPACE, 1); }
pub fn PciDisableIoSpace(ctx: int64): int64   { return cmdSet(ctx, PCI_CMD_IO_SPACE, 0); }
pub fn PciDisableIntx(ctx: int64): int64      { return cmdSet(ctx, PCI_CMD_INTX_DISABLE, 1); }
pub fn PciEnableIntx(ctx: int64): int64       { return cmdSet(ctx, PCI_CMD_INTX_DISABLE, 0); }

// Prueft, ob Schreibzugriffe ueberhaupt ankommen koennen.
pub fn PciCfgWritable(ctx: int64): int64 {
  if (ctx <= 0) { return 0; }
  var backend: int64 := peek64(ctx);
  if (backend == PCI_BACKEND_MEM || backend == PCI_BACKEND_ECAM) { return 1; }
  if (backend == PCI_BACKEND_SYSFS) {
    // Ein Schreibversuch auf die Cache-Line-Size mit dem gelesenen Wert
    // veraendert nichts und beantwortet die Frage.
    var v: int64 := PciCfgRead8(ctx, PCI_CFG_CACHE_LINE);
    if (v < 0) { return 0; }
    if (PciCfgWrite8(ctx, PCI_CFG_CACHE_LINE, v) == 0) { return 1; }
    return 0;
  }
  return 0;
}
