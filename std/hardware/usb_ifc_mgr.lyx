// std/hardware/usb_ifc_mgr.lyx
// WP-8.2: Claim/Release-Manager für USB-Interfaces
//
// Wraps UsbClaimInterface/UsbReleaseInterface mit einem
// idempotenten Zustandsautomaten: doppeltes Claim ist ein No-op.
@capabilities([fs.meta, fs.read, fs.write, hardware.usb])

unit std.hardware.usb_ifc_mgr;

import std.hardware.usb_control;
import std.alloc;

// ============================================================
// Manager-Layout (24 Bytes, heap-allokiert)
//   +0:  dev_fd        (int64)
//   +8:  interface_num (int64)
//   +16: is_claimed    (int64) — 0 oder 1
// ============================================================
pub con USB_IFC_MGR_SIZE: int64 := 24;

// ============================================================
// UsbIfcMgrAlloc — legt einen neuen Claim-Manager an (unclaimed)
// ============================================================
pub fn UsbIfcMgrAlloc(dev_fd: int64, ifc_num: int64): int64 {
  var ptr: int64 := alloc(USB_IFC_MGR_SIZE);
  if (ptr == 0) { return 0; }
  poke64(ptr,      dev_fd);
  poke64(ptr + 8,  ifc_num);
  poke64(ptr + 16, 0);     // is_claimed = 0
  return ptr;
}

pub fn UsbIfcMgrFree(mgrPtr: int64) {
  free(mgrPtr, USB_IFC_MGR_SIZE);
}

// ============================================================
// UsbIfcAcquire — beansprucht das Interface (idempotent)
// Zweiter Aufruf ohne Release dazwischen ist ein No-op.
// Rückgabe: 1 = erfolgreich geclaimt (oder bereits geclaimt), 0 = Fehler.
// (AC-1: doppeltes Claim ist idempotent)
// ============================================================
pub fn UsbIfcAcquire(mgrPtr: int64): int64 {
  if (peek64(mgrPtr + 16) == 1) { return 1; }    // bereits geclaimt → No-op
  var fd:  int64 := peek64(mgrPtr);
  var ifc: int64 := peek64(mgrPtr + 8);
  if (UsbClaimInterface(fd, ifc) >= 0) {
    poke64(mgrPtr + 16, 1);
    return 1;
  }
  return 0;
}

// ============================================================
// UsbIfcRelease — gibt das Interface frei (No-op wenn nicht geclaimt)
// (AC-2: Release → Acquire funktioniert ohne Fehler)
// ============================================================
pub fn UsbIfcRelease(mgrPtr: int64) {
  if (peek64(mgrPtr + 16) == 0) { return; }       // nicht geclaimt → No-op
  var fd:  int64 := peek64(mgrPtr);
  var ifc: int64 := peek64(mgrPtr + 8);
  UsbReleaseInterface(fd, ifc);
  poke64(mgrPtr + 16, 0);
}

// ============================================================
// UsbIfcIsClaimed — gibt aktuellen Claim-Status zurück (1 oder 0)
// ============================================================
pub fn UsbIfcIsClaimed(mgrPtr: int64): int64 {
  return peek64(mgrPtr + 16);
}

// ============================================================
// UsbIfcDevFd — gibt den gespeicherten fd zurück
// ============================================================
pub fn UsbIfcDevFd(mgrPtr: int64): int64 {
  return peek64(mgrPtr);
}

// ============================================================
// UsbIfcNum — gibt die Interface-Nummer zurück
// ============================================================
pub fn UsbIfcNum(mgrPtr: int64): int64 {
  return peek64(mgrPtr + 8);
}
