// std/hardware/usb_bulk.lyx
// WP-5: Bulk-Transfers
// Plattform: Linux ARM64 / x86_64 — usbdevfs ioctl-Schnittstelle
@capabilities([hardware.usb])

unit std.hardware.usb_bulk;

import std.alloc;

// ============================================================
// IOCTL-Code (64-Bit Linux)
// USBDEVFS_BULK = _IOW('U', 2, struct usbdevfs_bulktransfer)
// sizeof(usbdevfs_bulktransfer) auf 64-Bit = 24
//   (4+4+4 + 4 Padding + 8 Pointer)
// = (1<<30)|(24<<16)|(0x55<<8)|2 = 0x40185502
// ============================================================
pub con USBDEVFS_BULK: int64 := 0x40185502;

// ============================================================
// usbdevfs_bulktransfer — Layout (24 Bytes auf 64-Bit Linux)
//
//   +0:  ep      (uint32) — Endpunkt-Adresse (Bit 7: 0=OUT, 1=IN)
//   +4:  len     (uint32) — Anzahl zu übertragender Bytes
//   +8:  timeout (uint32) — in Millisekunden (0 = unbegrenzt)
//   +12: _pad    (uint32) — Padding für 8-Byte-Pointer-Alignment → 0
//   +16: data    (void *) — Datenpuffer, 8 Bytes auf 64-Bit
// ============================================================
pub con USB_BULK_STRUCT_SIZE: int64 := 24;

// ============================================================
// UsbBuildBulkTransfer — befüllt einen 24-Byte-Puffer
// buf muss auf ≥ USB_BULK_STRUCT_SIZE Bytes zeigen.
// (5 Parameter ≤ 6-Arg-Limit)
// ============================================================
pub fn UsbBuildBulkTransfer(buf: int64, ep: int64, data: int64,
                              length: int64, timeout: int64) {
  poke32(buf,      ep      & 0xFFFFFFFF);
  poke32(buf + 4,  length  & 0xFFFFFFFF);
  poke32(buf + 8,  timeout & 0xFFFFFFFF);
  poke32(buf + 12, 0);
  poke64(buf + 16, data);
}

// ============================================================
// UsbBulkTransfer — führt einen Bulk-Transfer aus
//
// ep:      Endpunkt-Adresse (z.B. 0x01 = OUT EP1, 0x81 = IN EP1)
// data:    Zeiger auf Sende- oder Empfangspuffer
// length:  Anzahl der Bytes
// timeout: Wartezeit in ms (0 = unbegrenzt, nicht empfohlen)
//
// Rückgabe: Anzahl übertragener Bytes (≥ 0) oder negativer Fehlercode.
//   -ETIMEDOUT bei Timeout, -ENODEV wenn Gerät abgesteckt.
// (5 Parameter ≤ 6-Arg-Limit)
// ============================================================
pub fn UsbBulkTransfer(dev_fd: int64, ep: int64, data: int64,
                        length: int64, timeout: int64): int64 {
  var buf: int64 := alloc(USB_BULK_STRUCT_SIZE);
  UsbBuildBulkTransfer(buf, ep, data, length, timeout);
  var ret: int64 := sys_ioctl(dev_fd, USBDEVFS_BULK, buf);
  free(buf, USB_BULK_STRUCT_SIZE);
  return ret;
}

// ============================================================
// UsbBulkWrite — sendet Daten an einen OUT-Endpunkt
// endpoint muss Bit 7 = 0 haben (z.B. 0x01, 0x02).
// Rückgabe: gesendete Bytes (≥ 0) oder negativer Fehlercode.
// (5 Parameter)
// ============================================================
pub fn UsbBulkWrite(dev_fd: int64, endpoint: int64, data: int64,
                     length: int64, timeout: int64): int64 {
  return UsbBulkTransfer(dev_fd, endpoint, data, length, timeout);
}

// ============================================================
// UsbBulkRead — empfängt Daten von einem IN-Endpunkt
// endpoint muss Bit 7 = 1 haben (z.B. 0x81, 0x82).
// Rückgabe: empfangene Bytes (≥ 0) oder negativer Fehlercode.
// (5 Parameter)
// ============================================================
pub fn UsbBulkRead(dev_fd: int64, endpoint: int64, buffer: int64,
                    length: int64, timeout: int64): int64 {
  return UsbBulkTransfer(dev_fd, endpoint, buffer, length, timeout);
}
