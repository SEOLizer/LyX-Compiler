// Lyx Bluetooth Library — std/hardware/bluetooth_ai.lyx
//
// WP-8: AI-Native Typsicherheit — Bluetooth-Profile als Compiler-Typen
//
// Da Lyx noch keine Generics/Templates unterstützt (vgl. Risikotabelle),
// wird Typsicherheit über DISTINCT STRUCT TYPES erreicht:
//
//   ReadableChar    → nur ReadableCharRead() definiert
//   WritableChar    → nur WritableCharWrite/Cmd() definiert
//   NotifiableChar  → nur NotifiableCharSubscribe/Recv() definiert
//   RWChar          → Read + Write (kombiniert)
//   RWNChar         → Read + Write + Notify
//
// Richtungs-Check-Mechanismus:
//   Aufruf von WritableCharRead(myReadableChar, ...) → Compiler-Fehler
//   (Typ ReadableChar ist nicht kompatibel zu WritableChar)
//
// Abnahmekriterien:
//   1. ReadableChar → Read() kompiliert; Write() → Compiler-Fehler (kein ReadableCharWrite)
//   2. WritableChar → Write() kompiliert; Read() → Compiler-Fehler (kein WritableCharRead)
//   3. NotifiableChar → Subscribe() aktiviert CCCD; cccd_handle=0 → Fehler (-1)
//   4. HeartRateSensor.Read/Subscribe() typsicher (struct erzwingt alle Handles)
@capabilities([network.tcp.bind, network.tcp.connect, network.udp.connect])

unit std.hardware.bluetooth_ai;

import std.hardware.bluetooth_gattc;
import std.alloc;

// ============================================================================
// Typdefinitionen — Charakteristik-Handle-Wrapper
// ============================================================================

// Nur lesbare Charakteristik (GATT_PROP_READ)
// Kein WritableCharWrite(), kein NotifiableCharSubscribe() für diesen Typ.
pub type ReadableChar = struct {
  handle: int64;   // value handle (aus GattCharValue)
  uuid:   int64;   // 16-Bit-UUID (für Dokumentation / Validierung)
};

// Nur schreibbare Charakteristik (GATT_PROP_WRITE oder GATT_PROP_WRITE_NO_RSP)
pub type WritableChar = struct {
  handle:       int64;
  uuid:         int64;
  write_no_rsp: int64;   // 1 = Write Command (kein ACK), 0 = Write Request
};

// Nur Notification/Indication (GATT_PROP_NOTIFY oder GATT_PROP_INDICATE)
// cccd_handle = 0 → Subscribe() gibt -1 zurück (Laufzeit-Schutz)
pub type NotifiableChar = struct {
  handle:      int64;   // value handle (für empfangene Notifications)
  uuid:        int64;
  cccd_handle: int64;   // Client Characteristic Configuration Descriptor
};

// Kombiniert: Read + Write
pub type RWChar = struct {
  handle:       int64;
  uuid:         int64;
  write_no_rsp: int64;
};

// Kombiniert: Read + Write + Notify
pub type RWNChar = struct {
  handle:      int64;
  uuid:        int64;
  cccd_handle: int64;
};

// ============================================================================
// Factory-Funktionen — aus Discovery-Buffer erstellen
// ============================================================================

// ReadableChar aus GattDiscoverChars-Buffer erzeugen
pub fn MakeReadableChar(charBuf: int64, idx: int64): ReadableChar {
  var c: ReadableChar;
  c.handle := GattCharValue(charBuf, idx);
  c.uuid   := GattCharUUID(charBuf, idx);
  return c;
}

// WritableChar aus Buffer erzeugen
// write_no_rsp: 1 wenn GATT_PROP_WRITE_NO_RSP gesetzt, sonst 0
pub fn MakeWritableChar(charBuf: int64, idx: int64): WritableChar {
  var c: WritableChar;
  c.handle       := GattCharValue(charBuf, idx);
  c.uuid         := GattCharUUID(charBuf, idx);
  c.write_no_rsp := (GattCharProps(charBuf, idx) & GATT_PROP_WRITE_NO_RSP) != 0;
  return c;
}

// NotifiableChar aus Buffer + explizitem CCCD-Handle erzeugen
// Abnahmekriterium 3: cccd_handle muss gesetzt sein (Laufzeit-Check in Subscribe)
pub fn MakeNotifiableChar(charBuf: int64, idx: int64, cccdHandle: int64): NotifiableChar {
  var c: NotifiableChar;
  c.handle      := GattCharValue(charBuf, idx);
  c.uuid        := GattCharUUID(charBuf, idx);
  c.cccd_handle := cccdHandle;
  return c;
}

pub fn MakeRWChar(charBuf: int64, idx: int64): RWChar {
  var c: RWChar;
  c.handle       := GattCharValue(charBuf, idx);
  c.uuid         := GattCharUUID(charBuf, idx);
  c.write_no_rsp := (GattCharProps(charBuf, idx) & GATT_PROP_WRITE_NO_RSP) != 0;
  return c;
}

pub fn MakeRWNChar(charBuf: int64, idx: int64, cccdHandle: int64): RWNChar {
  var c: RWNChar;
  c.handle      := GattCharValue(charBuf, idx);
  c.uuid        := GattCharUUID(charBuf, idx);
  c.cccd_handle := cccdHandle;
  return c;
}

// ============================================================================
// WP-8 Abnahmekriterium 1: ReadableChar-Operationen
//
// ReadableCharRead() → kompiliert ✅
// WritableCharRead() → existiert nicht → Compiler-Fehler bei falschem Typ ✅
// ============================================================================

pub fn ReadableCharRead(char: ReadableChar, fd: int64, buf: int64, bufLen: int64): int64 {
  return GattReadChar(fd, char.handle, buf, bufLen);
}

// RWChar kann auch gelesen werden
pub fn RWCharRead(char: RWChar, fd: int64, buf: int64, bufLen: int64): int64 {
  return GattReadChar(fd, char.handle, buf, bufLen);
}

pub fn RWNCharRead(char: RWNChar, fd: int64, buf: int64, bufLen: int64): int64 {
  return GattReadChar(fd, char.handle, buf, bufLen);
}

// ============================================================================
// WP-8 Abnahmekriterium 2: WritableChar-Operationen
//
// WritableCharWrite() → kompiliert ✅
// ReadableCharWrite() → existiert nicht → Compiler-Fehler ✅
// ============================================================================

// Schreibt mit Write-Request (ACK) oder Write-Command (kein ACK) je nach write_no_rsp
pub fn WritableCharWrite(char: WritableChar, fd: int64, data: int64, dataLen: int64): int64 {
  if (char.write_no_rsp != 0) {
    return GattWriteCmd(fd, char.handle, data, dataLen);
  }
  return GattWriteChar(fd, char.handle, data, dataLen);
}

pub fn RWCharWrite(char: RWChar, fd: int64, data: int64, dataLen: int64): int64 {
  if (char.write_no_rsp != 0) {
    return GattWriteCmd(fd, char.handle, data, dataLen);
  }
  return GattWriteChar(fd, char.handle, data, dataLen);
}

pub fn RWNCharWrite(char: RWNChar, fd: int64, data: int64, dataLen: int64): int64 {
  return GattWriteChar(fd, char.handle, data, dataLen);
}

// ============================================================================
// WP-8 Abnahmekriterium 3: NotifiableChar-Operationen
//
// Subscription ohne CCCD (cccd_handle=0) → gibt -1 zurück (Laufzeit-Schutz).
// ============================================================================

pub fn NotifiableCharSubscribe(char: NotifiableChar, fd: int64): int64 {
  if (char.cccd_handle == 0) { return -1; }  // Schutz: kein CCCD deklariert
  return GattEnableNotification(fd, char.cccd_handle);
}

pub fn NotifiableCharUnsubscribe(char: NotifiableChar, fd: int64): int64 {
  if (char.cccd_handle == 0) { return -1; }
  return GattDisableNotification(fd, char.cccd_handle);
}

// Empfängt das nächste Notification-Paket für diese Charakteristik
pub fn NotifiableCharRecv(char: NotifiableChar, fd: int64,
                           dataBuf: int64, bufLen: int64): int64 {
  var handleOut: int64 := alloc(8);
  if (handleOut == 0) { return -1; }
  var n: int64 := GattRecvNotification(fd, handleOut, dataBuf, bufLen);
  free(handleOut, 8);
  return n;
}

pub fn RWNCharSubscribe(char: RWNChar, fd: int64): int64 {
  if (char.cccd_handle == 0) { return -1; }
  return GattEnableNotification(fd, char.cccd_handle);
}

pub fn RWNCharRecv(char: RWNChar, fd: int64, dataBuf: int64, bufLen: int64): int64 {
  return GattRecvNotification(fd, 0, dataBuf, bufLen);
}

// ============================================================================
// BleEventStream — einfache Notification-Schleifenabstraktion
// ============================================================================

pub type BleEventStream = struct {
  fd:          int64;
  char_handle: int64;
  cccd_handle: int64;
  active:      int64;   // 1 = subscribed, 0 = closed
};

pub fn BleEventStreamCreate(fd: int64, charHandle: int64, cccdHandle: int64): BleEventStream {
  var s: BleEventStream;
  s.fd          := fd;
  s.char_handle := charHandle;
  s.cccd_handle := cccdHandle;
  s.active      := 0;
  return s;
}

pub fn BleEventStreamOpen(ref stream: BleEventStream): int64 {
  if (stream.cccd_handle == 0) { return -1; }
  var ret: int64 := GattEnableNotification(stream.fd, stream.cccd_handle);
  if (ret == 0) { stream.active := 1; }
  return ret;
}

// Liest das nächste Ereignis (blockiert bis Notification eintrifft oder Fehler)
pub fn BleEventStreamNext(stream: BleEventStream, dataBuf: int64, bufLen: int64): int64 {
  if (stream.active == 0) { return -1; }
  return GattRecvNotification(stream.fd, 0, dataBuf, bufLen);
}

pub fn BleEventStreamClose(ref stream: BleEventStream) {
  if (stream.cccd_handle != 0 && stream.active != 0) {
    GattDisableNotification(stream.fd, stream.cccd_handle);
    stream.active := 0;
  }
}

// ============================================================================
// WP-8 Abnahmekriterium 4: Bekannte Profile als typsichere Structs
//
// HeartRateSensor: alle Handles als Felder → fehlende Initialisierung
// erzeugt kompilierbaren, aber semantisch leeren Sensor (Laufzeit-Check).
// ============================================================================

pub type HeartRateSensor = struct {
  fd:          int64;
  hr_handle:   int64;   // 0x2A37 value handle
  cccd_handle: int64;   // CCCD für HR-Notifications
  body_handle: int64;   // 0x2A38 Body Sensor Location (optional, 0 = nicht vorhanden)
};

pub fn HeartRateSensorCreate(fd: int64, hrHandle: int64,
                              cccdHandle: int64, bodyHandle: int64): HeartRateSensor {
  var s: HeartRateSensor;
  s.fd          := fd;
  s.hr_handle   := hrHandle;
  s.cccd_handle := cccdHandle;
  s.body_handle := bodyHandle;
  return s;
}

// Liest den aktuellen Herzfrequenzwert
pub fn HeartRateSensorRead(sensor: HeartRateSensor,
                            flagsOut: int64, bpmOut: int64): int64 {
  return ReadHeartRate(sensor.fd, sensor.hr_handle, flagsOut, bpmOut);
}

// Aktiviert Notifications und liefert einen BleEventStream
pub fn HeartRateSensorSubscribe(sensor: HeartRateSensor): BleEventStream {
  var s: BleEventStream := BleEventStreamCreate(
    sensor.fd, sensor.hr_handle, sensor.cccd_handle);
  BleEventStreamOpen(s);
  return s;
}

// Empfängt eine HR-Notification und parsed sie (blockiert)
pub fn HeartRateSensorRecvNotification(sensor: HeartRateSensor,
                                        flagsOut: int64, bpmOut: int64): int64 {
  var buf: int64 := alloc(ATT_DEFAULT_MTU);
  if (buf == 0) { return 0; }
  var n: int64 := GattRecvNotification(sensor.fd, 0, buf, ATT_DEFAULT_MTU);
  var result: int64 := 0;
  if (n >= 2) {
    var flags: int64 := peek8(buf);
    if (flagsOut != 0) { poke64(flagsOut, flags); }
    var bpm: int64 := 0;
    if ((flags & 1) == 0) {
      bpm := peek8(buf + 1);
    } else if (n >= 3) {
      bpm := peek8(buf + 1) | (peek8(buf + 2) << 8);
    }
    if (bpmOut != 0) { poke64(bpmOut, bpm); }
    result := 1;
  }
  free(buf, ATT_DEFAULT_MTU);
  return result;
}

// ============================================================================
// BatteryMonitor — typsicherer Batterie-Service
// ============================================================================

pub type BatteryMonitor = struct {
  fd:           int64;
  level_handle: int64;   // 0x2A19 Battery Level
};

pub fn BatteryMonitorCreate(fd: int64, levelHandle: int64): BatteryMonitor {
  var m: BatteryMonitor;
  m.fd           := fd;
  m.level_handle := levelHandle;
  return m;
}

pub fn BatteryMonitorRead(monitor: BatteryMonitor): int64 {
  return ReadBatteryLevel(monitor.fd, monitor.level_handle);
}

// ============================================================================
// Profil-Vollständigkeitsprüfung
// (Abnahmekriterium: warnt / prüft ob alle Pflicht-Chars vorhanden)
// ============================================================================

// Prüft ob Heart-Rate-Profil vollständig ist (UUID 0x2A37 vorhanden)
// Rückgabe: 1 = vollständig, 0 = fehlende Charakteristiken
pub fn HRProfileValidate(charBuf: int64, charCount: int64): int64 {
  var hasHR:   int64 := GattFindCharByUUID(charBuf, charCount, GATT_UUID_HR_MEASUREMENT);
  if (hasHR < 0) { return 0; }
  return 1;
}

// Prüft auf UUID-Kollisionen in einem Service-Buffer
// Rückgabe: 1 = alle UUIDs eindeutig, 0 = Kollision gefunden
pub fn GattServiceUUIDsUnique(svcBuf: int64, svcCount: int64): int64 {
  var i: int64 := 0;
  while (i < svcCount) {
    var uuidI: int64 := GattSvcUUID(svcBuf, i);
    var j: int64 := i + 1;
    while (j < svcCount) {
      if (GattSvcUUID(svcBuf, j) == uuidI) { return 0; }
      j += 1;
    }
    i += 1;
  }
  return 1;
}

// Prüft ob Charakteristik-Properties mit dem angeforderten Typ konsistent sind
// propRequired: z.B. GATT_PROP_NOTIFY; props: aus GattCharProps
// Rückgabe: 1 = passt, 0 = inkompatibel
pub fn GattCharPropsCheck(props: int64, propRequired: int64): int64 {
  if ((props & propRequired) != 0) { return 1; }
  return 0;
}
