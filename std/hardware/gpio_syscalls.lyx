// std/hardware/gpio_syscalls.lyx
// WP-1a: Low-Level-Syscalls für GPIO-Zugriff
// Plattform: Linux ARM64 (Raspberry Pi 4 / BCM2711)
@capabilities([fs.read, hardware.gpio])

unit std.hardware.gpio_syscalls;

import std.alloc;

// ============================================================
// Konstanten — Dateiöffnungs-Flags
// ============================================================

pub con GPIO_O_RDONLY: int64 := 0;
pub con GPIO_O_WRONLY: int64 := 1;
pub con GPIO_O_RDWR:   int64 := 2;
pub con GPIO_O_SYNC:   int64 := 4096;    // 0x1000 — synchronous I/O

// ============================================================
// mmap-Konstanten (auch als Builtins vorhanden, hier explizit)
// ============================================================

pub con GPIO_PROT_READ:  int64 := 1;
pub con GPIO_PROT_WRITE: int64 := 2;
pub con GPIO_PROT_RW:    int64 := 3;

pub con GPIO_MAP_SHARED:  int64 := 1;
pub con GPIO_MAP_FAILED:  int64 := -1;   // mmap Fehler-Sentinel

// ============================================================
// poll Event-Flags
// ============================================================

pub con GPIO_POLLIN:  int64 := 1;
pub con GPIO_POLLOUT: int64 := 4;
pub con GPIO_POLLERR: int64 := 8;

// ============================================================
// WP-1a: Syscall-Wrapper
// AC-1: Jeder Syscall ist deklariert und aufrufbar.
// ============================================================

// sys_openat(AT_FDCWD, path, flags) → fd
// Öffnet /dev/gpiomem oder /dev/gpiochipX.
// Rückgabe: fd ≥ 0 bei Erfolg, < 0 bei Fehler.
pub fn GpioOpen(path: pchar, flags: int64): int64 {
  return open(path, flags, 0);
}

// sys_close(fd) → 0 oder Fehlercode
pub fn GpioSysClose(fd: int64): int64 {
  return close(fd);
}

// sys_read(fd, buf, count) → gelesene Bytes oder < 0
pub fn GpioRead(fd: int64, buf: int64, count: int64): int64 {
  return read(fd, buf, count);
}

// sys_ioctl(fd, request, arg) → 0 bei Erfolg oder < 0
pub fn GpioIoctl(fd: int64, request: int64, arg: int64): int64 {
  return sys_ioctl(fd, request, arg);
}

// sys_poll(fds_ptr, nfds, timeout_ms)
// fds_ptr: pollfd-Array (je 8 Bytes: int32 fd, int16 events, int16 revents)
pub fn GpioPoll(fds_ptr: int64, nfds: int64, timeout_ms: int64): int64 {
  return sys_poll(fds_ptr, nfds, timeout_ms);
}

// sys_mmap(addr, length, prot, flags, fd, offset) → Mapping-Adresse oder MAP_FAILED
// Für GPIO: addr=0, length=4096, prot=PROT_RW, flags=MAP_SHARED, fd=gpiomem_fd, offset=0
// Der Kernel mappt physische Register ab dem angegebenen Offset.
// Rückgabe: Virtuelle Adresse des Mappings oder GPIO_MAP_FAILED (-1).
pub fn GpioMmap(addr: int64, length: int64, prot: int64, flags: int64, fd: int64, offset: int64): int64 {
  return mmap(addr, length, prot, flags, fd, offset);
}

// sys_munmap(addr, length) → 0 bei Erfolg oder < 0
pub fn GpioMunmap(addr: int64, length: int64): int64 {
  return munmap(addr, length);
}

// ============================================================
// pollfd-Hilfsfunktionen
// pollfd: { int32 fd (+0), int16 events (+4), int16 revents (+6) } = 8 Bytes
// ============================================================

pub fn GpioPollFdSet(ptr: int64, fd: int64, events: int64) {
  poke32(ptr,     fd & 0xFFFFFFFF);
  poke16(ptr + 4, events & 0xFFFF);
  poke16(ptr + 6, 0);
}

pub fn GpioPollFdRevents(ptr: int64): int64 {
  return peek16(ptr + 6) & 0xFFFF;
}
