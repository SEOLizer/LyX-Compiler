// std/crt_raw.lyx
// Raw-Mode extensions for std/crt
// - Provides non-blocking read, KeyPressed, SetRawMode
// - Implemented via external libc/termios functions
// - Experimental: requires dynamic linking with libc

@description("Low-level raw terminal I/O")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
unit std.crt_raw;

// External functions (libc) — dynamically linked
// #1179: beide ohne link-Klausel — nie gebunden, Rueckgabe still 0, also
// "hat geklappt". Der Rohmodus wurde damit nie gesetzt UND nie
// zurueckgenommen. tcgetattr/tcsetattr sind in der C-Bibliothek ohnehin nur
// Huellen um ioctl: TCGETS liest die termios-Struktur, TCSETS/TCSETSW/TCSETSF
// schreiben sie (optional_actions 0/1/2).
con TC_TCGETS: int64 := 0x5401;
con TC_TCSETS: int64 := 0x5402;

fn tcgetattr(fd: int64, termios_p: pchar): int64 {
  return sys_ioctl(fd, TC_TCGETS, termios_p as int64);
}

fn tcsetattr(fd: int64, optional_actions: int64, termios_p: pchar): int64 {
  return sys_ioctl(fd, TC_TCSETS + optional_actions, termios_p as int64);
}
// #1179: Diese Zeile deklarierte `sys_select` als externes Symbol OHNE
// link-Klausel und verdeckte damit das gleichnamige BUILTIN (Syscall 23), das
// der Compiler laengst emittiert. Der Aufruf lief ins Leere und lieferte
// still 0 — also "keine Deskriptoren bereit", dauerhaft. Ohne die Zeile
// greift wieder das Builtin.
// #1179: ohne link-Klausel nie gebunden — der Aufruf lieferte still 0, also
// scheinbaren Erfolg. `sys_ioctl` ist das Builtin fuer Syscall 16.
fn ioctl(fd: int64, request: int64, argp: pchar): int64 { return sys_ioctl(fd, request, argp as int64); }

// POSIX constants
con TCSANOW: int64 := 0;

// API
pub fn SetRawMode(enabled: bool): int64 {
  // Placeholder: requires platform-specific termios implementation
  return -1;
}

pub fn KeyPressed(): bool {
  // Placeholder: requires fd-set helpers for select()
  return false;
}

pub fn ReadKeyRaw(): int64 {
  // Reads one byte from stdin in raw mode. Returns -1 on error or EOF.
  var buf: pchar := "\0";
  var r: int64 := read(0, buf, 1);
  if (r <= 0) { return -1; }
  return buf[0];
}

// End of std/crt_raw.lyx
