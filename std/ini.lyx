// Load INI from file — returns doc handle (heap buffer), or 0 on error.
pub fn LoadFile(path: pchar): int64 {
    if (path == 0) { return 0; }
    var fd: int64 := open(path, 0, 0);  // O_RDONLY
    if (fd < 0) { return 0; }
    var buf: pchar := mmap(0, INI_BUFFER_SIZE, 3, 34, -1, 0);
    if (buf == 0) { close(fd); return 0; }
    var total: int64 := 0;
    var running: int64 := 1;
    while (running == 1 && total < INI_BUFFER_SIZE - 1) {
        var n: int64 := read(fd, buf + total, INI_BUFFER_SIZE - 1 - total);
        if (n <= 0) { running := 0; }
        else { total := total + n; }
    }
    close(fd);
    StrSetChar(buf, total, 0);
    return buf as int64;
}

// Save INI doc (raw text) to file — returns true on success.
pub fn SaveFile(doc: int64, path: pchar): bool {
    return WriteFile(doc, path);
}

// Check if section exists
pub fn HasSection(doc: int64, section: pchar): bool {
    if (doc == 0 || section == 0) { return false; }
    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var slen: int64 := StrLen(section);
    return _iniFindSection(content, clen, section, slen) >= 0;
}

// Check if key exists in section
pub fn HasKey(doc: int64, section: pchar, key: pchar): bool {
    if (doc == 0 || section == 0 || key == 0) { return false; }
    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var slen: int64 := StrLen(section);
    var klen: int64 := StrLen(key);
    var spos: int64 := _iniFindSection(content, clen, section, slen);
    if (spos < 0) { return false; }
    return _iniFindKeyValue(content, clen, spos, key, klen) >= 0;
}

// Get number of sections (count '['-started lines)
pub fn GetSectionCount(doc: int64): int64 {
    if (doc == 0) { return 0; }
    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var count: int64 := 0;
    var pos: int64 := 0;
    while (pos < clen) {
        while (pos < clen && (StrCharAt(content, pos) == 32 || StrCharAt(content, pos) == 9)) {
            pos := pos + 1;
        }
        if (pos < clen && StrCharAt(content, pos) == 91) { count := count + 1; }
        while (pos < clen && StrCharAt(content, pos) != 10 && StrCharAt(content, pos) != 13) {
            pos := pos + 1;
        }
        while (pos < clen && (StrCharAt(content, pos) == 10 || StrCharAt(content, pos) == 13)) {
            pos := pos + 1;
        }
    }
    return count;
}

