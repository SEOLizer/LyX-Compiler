// Load INI from file — returns doc handle (heap buffer), or 0 on error.
pub fn LoadFile(path: pchar): int64 {
    if (path == 0) { return 0; }
    var fd: int64 := open(path, 0, 0);  // O_RDONLY
    if (fd < 0) { return 0; }
    var buf: pchar := alloc(INI_BUFFER_SIZE);
    if (buf == 0) { close(fd); return 0; }
    var total: int64 := 0;
    var running: int64 := 1;
    while (running == 1 && total < INI_BUFFER_SIZE - 1) {
        var n: int64 := read(fd, buf + total, INI_BUFFER_SIZE - 1 - total);
        if (n <= 0) { running := 0; }
        else { total := total + n; }
    }
    close(fd);
    StrSetChar(buf, total, 0);
    return buf as int64;
}

// Save INI doc (raw text) to file — returns true on success.
pub fn SaveFile(doc: int64, path: pchar): bool {
    return WriteFile(doc, path);
}

// Check if section exists
pub fn HasSection(doc: int64, section: pchar): bool {
    if (doc == 0 || section == 0) { return false; }
    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var slen: int64 := StrLen(section);
    return _iniFindSection(content, clen, section, slen) >= 0;
}

// Check if key exists in section
pub fn HasKey(doc: int64, section: pchar, key: pchar): bool {
    if (doc == 0 || section == 0 || key == 0) { return false; }
    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var slen: int64 := StrLen(section);
    var klen: int64 := StrLen(key);
    var spos: int64 := _iniFindSection(content, clen, section, slen);
    if (spos < 0) { return false; }
    return _iniFindKeyValue(content, clen, spos, key, klen) >= 0;
}

// Get number of sections (count '['-started lines)
pub fn GetSectionCount(doc: int64): int64 {
    if (doc == 0) { return 0; }
    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var count: int64 := 0;
    var pos: int64 := 0;
    while (pos < clen) {
        while (pos < clen && (StrCharAt(content, pos) == 32 || StrCharAt(content, pos) == 9)) {
            pos += 1;
        }
        if (pos < clen && StrCharAt(content, pos) == 91) { count := count + 1; }
        while (pos < clen && StrCharAt(content, pos) != 10 && StrCharAt(content, pos) != 13) {
            pos += 1;
        }
        while (pos < clen && (StrCharAt(content, pos) == 10 || StrCharAt(content, pos) == 13)) {
            pos += 1;
        }
    }
    return count;
}

// Get list of all section names — each name is null-terminated in output.
// Returns number of sections written.
pub fn GetSections(doc: int64, output: pchar, max_count: int64): int64 {
    if (doc == 0 || output == 0 || max_count <= 0) { return 0; }
    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var count: int64 := 0;
    var pos: int64 := 0;
    var outPos: int64 := 0;
    while (pos < clen && count < max_count) {
        var lp: int64 := pos;
        while (lp < clen && (StrCharAt(content, lp) == 32 || StrCharAt(content, lp) == 9)) {
            lp += 1;
        }
        if (lp < clen && StrCharAt(content, lp) == 91) {
            lp += 1;
            while (lp < clen && (StrCharAt(content, lp) == 32 || StrCharAt(content, lp) == 9)) {
                lp += 1;
            }
            while (lp < clen && StrCharAt(content, lp) != 93 && StrCharAt(content, lp) != 10 && StrCharAt(content, lp) != 13 && StrCharAt(content, lp) != 0) {
                StrSetChar(output, outPos, StrCharAt(content, lp));
                outPos += 1;
                lp += 1;
            }
            StrSetChar(output, outPos, 0);
            outPos += 1;
            count += 1;
        }
        pos := _iniLineAfter(content, clen, pos);
    }
    return count;
}

// Get number of key=value entries in section.
pub fn GetKeyCount(doc: int64, section: pchar): int64 {
    if (doc == 0 || section == 0) { return 0; }
    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var slen: int64 := StrLen(section);
    var spos: int64 := _iniFindSection(content, clen, section, slen);
    if (spos < 0) { return 0; }
    var count: int64 := 0;
    var pos: int64 := spos;
    while (pos < clen) {
        var lp: int64 := pos;
        while (lp < clen && (StrCharAt(content, lp) == 32 || StrCharAt(content, lp) == 9)) {
            lp += 1;
        }
        if (lp >= clen) { break; }
        var c: int64 := StrCharAt(content, lp);
        if (c == 91) { break; }
        if (c != 35 && c != 59 && c != 10 && c != 13 && c != 0) {
            var ep: int64 := lp;
            while (ep < clen && StrCharAt(content, ep) != 10 && StrCharAt(content, ep) != 13 && StrCharAt(content, ep) != 0) {
                if (StrCharAt(content, ep) == 61) { count := count + 1; break; }
                ep += 1;
            }
        }
        pos := _iniLineAfter(content, clen, pos);
    }
    return count;
}

// Get key names in section — each name is null-terminated in output.
// Returns number of keys written.
pub fn GetKeys(doc: int64, section: pchar, output: pchar, max_count: int64): int64 {
    if (doc == 0 || section == 0 || output == 0 || max_count <= 0) { return 0; }
    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var slen: int64 := StrLen(section);
    var spos: int64 := _iniFindSection(content, clen, section, slen);
    if (spos < 0) { return 0; }
    var count: int64 := 0;
    var pos: int64 := spos;
    var outPos: int64 := 0;
    while (pos < clen && count < max_count) {
        var lp: int64 := pos;
        while (lp < clen && (StrCharAt(content, lp) == 32 || StrCharAt(content, lp) == 9)) {
            lp += 1;
        }
        if (lp >= clen) { break; }
        var c: int64 := StrCharAt(content, lp);
        if (c == 91) { break; }
        if (c != 35 && c != 59 && c != 10 && c != 13 && c != 0) {
            var keyStart: int64 := lp;
            var ep: int64 := lp;
            var found: int64 := 0;
            while (ep < clen && StrCharAt(content, ep) != 10 && StrCharAt(content, ep) != 13 && StrCharAt(content, ep) != 0) {
                if (StrCharAt(content, ep) == 61) { found := 1; break; }
                ep += 1;
            }
            if (found == 1) {
                var keyEnd: int64 := ep;
                while (keyEnd > keyStart && (StrCharAt(content, keyEnd - 1) == 32 || StrCharAt(content, keyEnd - 1) == 9)) {
                    keyEnd -= 1;
                }
                var ki: int64 := keyStart;
                while (ki < keyEnd) {
                    StrSetChar(output, outPos, StrCharAt(content, ki));
                    outPos += 1;
                    ki += 1;
                }
                StrSetChar(output, outPos, 0);
                outPos += 1;
                count += 1;
            }
        }
        pos := _iniLineAfter(content, clen, pos);
    }
    return count;
}

