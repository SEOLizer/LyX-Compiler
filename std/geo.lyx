// std/geo.lyx - Geolocation utilities mit Vektor-Architektur
// Alle Koordinaten in Microdegrees (int64), 1.000.000 µ° = 1°

@description("Geographic coordinate utilities")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
unit std.geo;

import std.math;   // #1481/#1482: gepruefte Winkel- und Wurzelfunktionen
import std.alloc;  // #1483: Puffer fuer FormatDMS

// GeoPoint: x = Longitude, y = Latitude (both in microdegrees)
pub type GeoPoint = struct {
  x: int64;
  y: int64;
}

// WP-C10: GeoBBox — Bounding-Box-Paar (entspricht [GeoPoint, GeoPoint] Tuple-Return)
// Flache Felder statt nested structs (Codegen unterstützt keine a.b.c-Zugriffe).
// minX/minY: untere-linke Ecke; maxX/maxY: obere-rechte Ecke (alles Microdegrees)
pub type GeoBBox = struct {
  minX: int64;
  minY: int64;
  maxX: int64;
  maxY: int64;
}

// ============================================================================
// Parsing: String -> Microdegrees
// ============================================================================

pub fn ParseLat(s: pchar): int64 {
  return ParseCoord(s);
}

pub fn ParseLon(s: pchar): int64 {
  return ParseCoord(s);
}

// Parse decimal degrees (ddd.dddd) to microdegrees
fn ParseCoord(s: pchar): int64 {
  var i: int64 := 0;
  var sign: int64 := 1;
  var first_char: int64 := StrCharAt(s, 0);
  if (first_char == 45) { // '-'
    sign := -1;
    i := 1;
  }
  var whole: int64 := 0;
  var ch: int64 := StrCharAt(s, i);
  while (ch >= 48 && ch <= 57) { // '0' to '9'
    whole := whole * 10 + (ch - 48);
    i += 1;
    ch := StrCharAt(s, i);
  }
  var frac: int64 := 0;
  var frac_len: int64 := 0;
  if (ch == 46) { // '.'
    i += 1;
    ch := StrCharAt(s, i);
    while (ch >= 48 && ch <= 57 && frac_len < 6) {
      frac := frac * 10 + (ch - 48);
      frac_len += 1;
      i += 1;
      ch := StrCharAt(s, i);
    }
    while (ch >= 48 && ch <= 57) {
      i += 1;
      ch := StrCharAt(s, i);
    }
  }
  while (frac_len < 6) {
    frac := frac * 10;
    frac_len += 1;
  }
  var result: int64 := whole * 1000000 + frac;
  return sign * result;
}

// ============================================================================
// Formatting: Microdegrees -> String
// ============================================================================

pub fn FormatDecimal(coord: int64): pchar {
  var sign: int64 := 1;
  if (coord < 0) {
    sign := -1;
    coord := -coord;
  }
  var deg: int64 := coord / 1000000;
  var frac: int64 := coord % 1000000;
  var buf: pchar := "                               ";
  var pos: int64 := 0;
  if (sign < 0) {
    StrSetChar(buf, 0, 45);
    pos := 1;
  }
  var deg_str: pchar := IntToStr(deg);
  var i: int64 := 0;
  var deg_len: int64 := StrLen(deg_str);
  while (i < deg_len) {
    StrSetChar(buf, pos + i, StrCharAt(deg_str, i));
    i += 1;
  }
  pos += deg_len;
  StrSetChar(buf, pos, 46); // '.'
  pos += 1;
  if (frac < 100000) {
    StrSetChar(buf, pos, 48);
    pos += 1;
  }
  if (frac < 10000) {
    StrSetChar(buf, pos, 48);
    pos += 1;
  }
  if (frac < 1000) {
    StrSetChar(buf, pos, 48);
    pos += 1;
  }
  if (frac < 100) {
    StrSetChar(buf, pos, 48);
    pos += 1;
  }
  if (frac < 10) {
    StrSetChar(buf, pos, 48);
    pos += 1;
  }
  var frac_str: pchar := IntToStr(frac);
  i := 0;
  var frac_len: int64 := StrLen(frac_str);
  while (i < frac_len) {
    StrSetChar(buf, pos + i, StrCharAt(frac_str, i));
    i += 1;
  }
  pos += frac_len;
  StrSetChar(buf, pos, 0);
  return buf;
}

// ============================================================================
// Validation
// ============================================================================

pub fn IsValidLat(lat: int64): bool {
  // Valid: -90.0 to +90.0 degrees (-90000000 to 90000000 microdegrees)
  return (lat >= -90000000) && (lat <= 90000000);
}

pub fn IsValidLon(lon: int64): bool {
  // Valid: -180.0 to +180.0 degrees (-180000000 to 180000000 microdegrees)
  return (lon >= -180000000) && (lon <= 180000000);
}

pub fn IsValidGeoPoint(p: GeoPoint): bool {
  return IsValidLat(p.y) && IsValidLon(p.x);
}

// ============================================================================
// Helper: Create GeoPoint from lat/lon
// ============================================================================

pub fn GeoPointNew(lon: int64, lat: int64): GeoPoint {
  var p: GeoPoint;
  p.x := lon;
  p.y := lat;
  return p;
}

// ============================================================================
// Distance Functions (using Vektor operations)
// ============================================================================

// Earth radius in meters (approximately)
con EARTH_RADIUS_METERS: int64 := 6371000;

// Berechnet Distanz in Metern zwischen zwei GeoPoints
// Verwendet Vektor-Operationen intern
// #1482: Zwei Fehler, die sich addierten. Die Laengendifferenz wurde wie eine
// Breitendifferenz behandelt (beide mal 111319 m) — ein Laengengrad ist bei
// 53° Nord aber nur rund 67 km breit, nicht 111,3 km. Und die Wurzel war durch
// `groesserer + halber kleinerer` ersetzt, was die Hypotenuse um bis zu 12 %
// ueberschaetzt. Berlin–Hamburg kam so auf 437 km statt 255 km.
//
// Jetzt: Kosinus-Korrektur ueber die mittlere Breite und Hypot64 aus std.math
// (seit #1447 exakt statt genaehert).
pub fn DistanceM(p1: GeoPoint, p2: GeoPoint): int64 {
  var dx: int64 := p2.x - p1.x;
  var dy: int64 := p2.y - p1.y;
  if (dx < 0) { dx := 0 - dx; }
  if (dy < 0) { dy := 0 - dy; }

  // Kosinus der mittleren Breite; p.y traegt Mikrograd, CosLatTable Grad.
  var midLat: int64 := (p1.y + p2.y) / 2;
  var cosLat: int64 := CosLatTable(midLat / 1000000);

  var x_m: int64 := ((dx * 111319) / 1000000 * cosLat) / 1000000;
  var y_m: int64 := (dy * 111319) / 1000000;
  return Hypot64(x_m, y_m);
}

// Legacy-Funktion für Abwärtskompatibilität
pub fn DistanceMLegacy(lat1: int64, lon1: int64, lat2: int64, lon2: int64): int64 {
  var p1: GeoPoint := GeoPointNew(lon1, lat1);
  var p2: GeoPoint := GeoPointNew(lon2, lat2);
  return DistanceM(p1, p2);
}

// Distanz in Kilometern
pub fn DistanceKm(p1: GeoPoint, p2: GeoPoint): int64 {
  return DistanceM(p1, p2) / 1000;
}

// Distanz-Quadrat (für Vergleiche ohne sqrt)
pub fn DistanceSq(p1: GeoPoint, p2: GeoPoint): int64 {
  var dx: int64 := p2.x - p1.x;
  var dy: int64 := p2.y - p1.y;
  return dx * dx + dy * dy;
}

// Prüft ob Distanz kleiner als threshold (in Metern)
pub fn IsWithinDistanceM(p1: GeoPoint, p2: GeoPoint, thresholdM: int64): bool {
  var distM: int64 := DistanceM(p1, p2);
  return distM < thresholdM;
}

// ============================================================================
// Midpoint Functions (using Vektor operations)
// ============================================================================

// Mittelpunkt zwischen zwei GeoPoints
pub fn Midpoint(p1: GeoPoint, p2: GeoPoint): GeoPoint {
  var cx: int64 := p1.x + p2.x;
  var cy: int64 := p1.y + p2.y;
  var m: GeoPoint;
  m.x := cx / 2;
  m.y := cy / 2;
  return m;
}

// Legacy-Funktionen für Abwärtskompatibilität
pub fn MidpointLat(lat1: int64, lat2: int64): int64 {
  var p1: GeoPoint := GeoPointNew(0, lat1);
  var p2: GeoPoint := GeoPointNew(0, lat2);
  var mid: GeoPoint := Midpoint(p1, p2);
  return mid.y;
}

pub fn MidpointLon(lon1: int64, lon2: int64): int64 {
  var p1: GeoPoint := GeoPointNew(lon1, 0);
  var p2: GeoPoint := GeoPointNew(lon2, 0);
  var mid: GeoPoint := Midpoint(p1, p2);
  
  // Handle longitude wrap-around
  var diff: int64 := lon2 - lon1;
  if (diff > 180000000) {
    var wrapDiff: int64 := 360000000 - diff;
    mid.x := lon1 - wrapDiff / 2;
  } else {
    if (diff < -180000000) {
      var wrapSum: int64 := 360000000 + diff;
      mid.x := lon1 + wrapSum / 2;
    }
  }
  return mid.x;
}

// ============================================================================
// BoundingBox Functions
// ============================================================================

// Prüft ob Punkt innerhalb eines Rechtecks liegt
// min: untere linke Ecke (kleinste x und y)
// max: obere rechte Ecke (größte x und y)
pub fn IsPointInRect(p: GeoPoint, min: GeoPoint, max: GeoPoint): bool {
  return (p.x >= min.x) && (p.x <= max.x) &&
         (p.y >= min.y) && (p.y <= max.y);
}

// BoundingBoxMin: returns minimum corner of bounding box of two points
pub fn BoundingBoxMin(p1: GeoPoint, p2: GeoPoint): GeoPoint {
  var minX: int64 := p1.x;
  var minY: int64 := p1.y;
  if (p2.x < minX) { minX := p2.x; }
  if (p2.y < minY) { minY := p2.y; }
  var r: GeoPoint; r.x := minX; r.y := minY;
  return r;
}

// BoundingBoxMax: returns maximum corner of bounding box of two points
pub fn BoundingBoxMax(p1: GeoPoint, p2: GeoPoint): GeoPoint {
  var maxX: int64 := p1.x;
  var maxY: int64 := p1.y;
  if (p2.x > maxX) { maxX := p2.x; }
  if (p2.y > maxY) { maxY := p2.y; }
  var r: GeoPoint; r.x := maxX; r.y := maxY;
  return r;
}

// Prüft ob zwei BoundingBoxes überlappen
pub fn DoBoundingBoxesOverlap(min1: GeoPoint, max1: GeoPoint, min2: GeoPoint, max2: GeoPoint): bool {
  return (min1.x <= max2.x) && (max1.x >= min2.x) &&
         (min1.y <= max2.y) && (max1.y >= min2.y);
}

// Zentrum einer BoundingBox
pub fn BoundingBoxCenter(min: GeoPoint, max: GeoPoint): GeoPoint {
  var cx: int64 := min.x + max.x;
  var cy: int64 := min.y + max.y;
  var c: GeoPoint; c.x := cx / 2; c.y := cy / 2;
  return c;
}

// ============================================================================
// Bearing/Heading Calculation
// ============================================================================

// Berechnet Initial-Bearing zwischen zwei Punkten in Grad
// #1483: Die vier Achsenrichtungen waren als Sonderfaelle verdrahtet, dazwischen
// stand eine lineare Verhaeltnisrechnung (`90000000 - y*90000000/x`), die schon
// fuer Nordost 0 lieferte. Ein Kurs ist ein Winkel — dafuer gibt es Atan2, und
// std.math fuehrt es seit #1447 gepruft.
//
// Gezaehlt wird im Uhrzeigersinn ab Nord: atan2(Ost, Nord). Die Ostkomponente
// braucht die Kosinus-Korrektur, sonst zeigt jeder Kurs zu weit nach Osten, je
// naeher man dem Pol kommt.
// #1888: Auch dieser Kurs ist eine NAHBEREICHS-Naeherung. Sie rechnet in der
// Ebene mit einer Kosinus-Korrektur auf der Mittelbreite; auf dem Grosskreis
// ist der Kurs weder konstant noch der hier gelieferte. Gemessen:
// Hamburg -> New York gibt 257.3 statt 293.2 Grad — 34 Grad daneben, der
// Unterschied zwischen West-Suedwest und West-Nordwest.
//
// Die Datumsgrenze wird auch hier nicht behandelt.
//
// Fuer einen Kurs, den man steuern kann: GeoKurs (Anfangskurs) oder
// GeoLoxodromKurs (fester Kurs) aus std.geo.sphere.
pub fn Bearing(p1: GeoPoint, p2: GeoPoint): int64 {
  var dLon: int64 := p2.x - p1.x;
  var dLat: int64 := p2.y - p1.y;
  if (dLon == 0 && dLat == 0) { return 0; }

  var midLat: int64 := (p1.y + p2.y) / 2;
  var cosLat: int64 := CosLatTable(midLat / 1000000);
  var ost: int64 := (dLon * cosLat) / 1000000;

  var winkel: int64 := Atan2Microdegrees(ost, dLat);
  while (winkel < 0) { winkel := winkel + 360000000; }
  return winkel % 360000000;
}

// ============================================================================
// Fixed-Point Trigonometry (Lookup-Tabelle)
// ============================================================================

// Cosinus-Lookup-Tabelle für Breitengrade (0° bis 90° in 1° Schritten)
// Wert * 1.000.000 = cos(lat) in Fixed-Point
// Gespeichert als int64 für Mikro-Grade Cosinus
con COS_TABLE_SIZE: int64 := 91;

// Cosinus für Breitengrade (vereinfacht, Fixed-Point)
// cos(°) * 1.000.000
// #1481: Der Kommentar beschrieb `(deg² × 1000000) / 16500`, der Code rechnete
// `(deg² × 1000) / 165` — ein Zehntel davon. cos(90°) kam damit als 0,95
// heraus statt 0, und JEDE Laengenkorrektur war praktisch wirkungslos.
//
// Die Parabel wird nicht repariert, sondern ersetzt: std.math fuehrt seit
// #1444 eine Sinustabelle mit Interpolation, und Cos64 liefert denselben
// Festkommawert (1000000 = 1,0), den diese Funktion zurueckgeben soll — nur
// eben ueber den ganzen Bereich richtig. Eine zweite, schlechtere Meinung
// ueber den Kosinus braucht die Bibliothek nicht.
//
// Erwartet werden GRAD (nicht Mikrograd); Cos64 rechnet in Mikrograd.
fn CosLatTable(latDeg: int64): int64 {
  var deg: int64 := latDeg;
  if (deg < 0) { deg := 0 - deg; }
  if (deg > 90) { deg := 90; }
  var wert: int64 := Cos64(deg * 1000000);
  if (wert < 0) { wert := 0; }
  return wert;
}

// ============================================================================
// Naeherungsweise Entfernung im NAHBEREICH
// ============================================================================
//
// #1888: Diese Funktion hiess HaversineDistanceM und war als "Praezise
// Distanzberechnung" ueberschrieben. Beides stimmte nicht — gerechnet wird
// Pythagoras auf der flachen Erde mit einer Kosinus-Korrektur aus einer
// Tabelle, und der Name war die Zusicherung, die niemand nachprueft.
//
// GEMESSEN (1.1.14C), damit der Gueltigkeitsbereich hier steht und nicht in
// der Doku:
//
//     Hamburg -> Bremen (95 km)      95 579 m   statt     95 000 m   +0.6 %
//     Hamburg -> New York         6 535 376 m   statt  6 134 000 m   +6.5 %
//     Sydney -> Buenos Aires     19 342 830 m   statt 11 800 000 m   +64 %
//     179 Ost -> 179 West        39 852 202 m   statt    222 000 m   Faktor 180
//
// Die Datumsgrenze wird gar nicht behandelt: aus 179 Ost und 179 West werden
// 358 Grad Laengendifferenz statt 2.
//
// BRAUCHBAR bis rund 100 km, wenn die Strecke die Datumsgrenze nicht kreuzt.
// Fuer alles andere: std.geo.sphere, das in f64 auf der Kugel rechnet, echte
// Haversine benutzt und weltweit gilt.
//
// Warum die Naeherung bleibt: diese Unit ist bewusst ohne Fliesskomma gebaut
// (Bounding-Boxen, Rechteckschnitte, Nahbereichsvergleiche in Mikrograd).
// Sie durch die f64-Fassung zu ersetzen waere eine andere Entscheidung als
// die, die dieses Issue verlangt — hier geht es um den NAMEN.
pub fn DistanceMApprox(p1: GeoPoint, p2: GeoPoint): int64 {
  // Umrechnung zu Radiant-ähnlichen Werten (Fixed-Point)
  // Wir nutzen eine vereinfachte Näherung
  
  var lat1: int64 := p1.y;
  var lat2: int64 := p2.y;
  var dLat: int64 := lat2 - lat1;
  var p2hx: int64 := p2.x;
  var p1hx: int64 := p1.x;
  var dLon: int64 := p2hx - p1hx;

  if (dLat < 0) { dLat := -dLat; }
  if (dLon < 0) { dLon := -dLon; }

  // Cosinus-Korrektur für Längengrad
  // Längengrad-Distanz skaliert mit cos(Latitude)
  // cos(0°) = 1.000.000, cos(60°) = 500.000, cos(90°) = 0
  var latSum: int64 := lat1 + lat2;
  var midLat: int64 := latSum / 2;
  var cosLat: int64 := CosLatTable(midLat / 1000000);
  
  // Korrekturfaktor für Längengrad (Fixed-Point)
  var dLonCorr: int64 := (dLon * cosLat) / 1000000;
  
  // Vereinfachte Haversine-Approximation
  // a = sin²(Δlat/2) + cos(lat1) * cos(lat2) * sin²(Δlon/2)
  // c = 2 * atan2(√a, √(1-a))
  
  // Vereinfacht: verwende Pythagoras mit Cosinus-Korrektur
  // Distanz ≈ √((dLat * 111319)² + (dLonCorr * 111319)²)
  
  // Da sqrt() nicht verfügbar, verwenden wir die frühere Approximation
  var x_m_tmp: int64 := dLonCorr * 111319;
  var x_m: int64 := x_m_tmp / 1000000;
  var y_m_tmp: int64 := dLat * 111319;
  var y_m: int64 := y_m_tmp / 1000000;
  
  if (x_m < 0) { x_m := -x_m; }
  if (y_m < 0) { y_m := -y_m; }
  
  // Bessere Approximation als bisher
  // Nutzt Pythagoras statt vereinfachter Equirectangular
  var distSq: int64 := x_m * x_m + y_m * y_m;
  
  // Vereinfachte Wurzel-Approximation (Taylor für sqrt)
  // √n ≈ (n + 1) / 2 für große n
  // Oder: iterativ verbessern
  var guess: int64 := x_m + y_m;
  if (guess < 1) { guess := 1; }
  
  // Newton-Raphson für sqrt (2 Iterationen)
  var i: int64 := 0;
  while (i < 3) {
    var gTerm: int64 := distSq / guess;
    var gSum: int64 := guess + gTerm;
    guess := gSum / 2;
    i += 1;
  }
  
  return guess;
}

// #1888: Der alte Name bleibt als Weiterleitung stehen, damit vorhandener
// Code weiterlaeuft — aber er ist FALSCH und wird verschwinden. Es ist keine
// Haversine, und "praezise" ist sie nur im Nahbereich. Wer weltweite Werte
// braucht, nimmt std.geo.sphere; wer die Naeherung will, ruft
// DistanceMApprox und sieht am Namen, was er bekommt.
pub fn HaversineDistanceM(p1: GeoPoint, p2: GeoPoint): int64 {
  return DistanceMApprox(p1, p2);
}

// ============================================================================
// DMS Parsing & Formatting (Grad, Minuten, Sekunden)
// ============================================================================

// Fehlerwert fuer die Ganzzahl-Schnittstelle.
//
// Sie kann kein NaN fuehren, und 0 waere die gefaehrlichste Antwort — es ist
// eine gueltige Koordinate (Nullmeridian am Aequator). 999000000 Mikrograd
// sind 999 Grad und damit ausserhalb jedes Bereichs, den es gibt; wer den
// Wert ungeprueft weiterreicht, bekommt an der naechsten Bereichspruefung
// einen Fehler statt einer stillen Fehlposition.
pub con GEO_DMS_FEHLER: int64 := 999000000;

pub fn GeoIstDmsFehler(v: int64): bool { return v == GEO_DMS_FEHLER; }

// Konvertiert Grad/Minuten/Sekunden zu Mikrograd.
// direction: 'N' (78), 'S' (83), 'E' (69), 'W' (87).
//
// #1888: Zwei Fehler waren hier drin.
//
// 1. Die Umrechnung nutzte die gerundeten Festkommafaktoren 16667 und 278
//    statt 1000000/60 und 1000000/3600. Damit ergaben 0 Grad 60 Minuten
//    1000020 statt exakt 1000000 — rund 2 m daneben, systematisch und mit dem
//    Winkel wachsend. Jetzt wird ganzzahlig exakt gerechnet: Minuten und
//    Sekunden gehen ueber einen gemeinsamen Nenner, damit nichts zweimal
//    gerundet wird.
//
// 2. Eine UNBEKANNTE Himmelsrichtung wurde still angenommen und der Wert
//    positiv zurueckgegeben, als waere Nord gemeint — nur 'S' und 'W' kehrten
//    das Vorzeichen um, alles andere fiel durch. Ein Tippfehler im
//    Richtungsbuchstaben spiegelte damit eine Position auf die andere
//    Erdhalbkugel, ohne dass es auffiel.
//
// Ebenfalls abgewiesen werden Minuten oder Sekunden ab 60: das ist keine
// Schreibweise, sondern ein Tippfehler, und 0 Grad 61 Minuten liegen 1.85 km
// neben der gemeinten Stelle.
pub fn ParseDMS(degrees: int64, minutes: int64, seconds: int64, direction: int64): int64 {
  if (degrees < 0 || minutes < 0 || seconds < 0) { return GEO_DMS_FEHLER; }
  if (minutes > 59 || seconds > 59) { return GEO_DMS_FEHLER; }

  // Exakt und ohne Zwischenrundung: alles ueber den Nenner 3600.
  //   mikro = (grad * 3600 + minuten * 60 + sekunden) * 1000000 / 3600
  var bogensekunden: int64 := degrees * 3600 + minutes * 60 + seconds;
  var result: int64 := (bogensekunden * 1000000) / 3600;

  if (direction == 78 || direction == 69) { return result; }          // 'N', 'E'
  if (direction == 83 || direction == 87) { return 0 - result; }      // 'S', 'W'
  return GEO_DMS_FEHLER;                                              // unbekannt: melden
}

// Formatiert Koordinate als DMS-String
// direction: 'N', 'S', 'E', 'W'
// #1483: Grad, Minuten und Sekunden wurden berechnet und dann VERWORFEN —
// zurueck kam die feste Zeichenkette "000\u00b0 00' 00\" X", mit einem Kommentar,
// der die eigentliche Arbeit ankuendigte. Die Himmelsrichtung landete ebenso
// wenig in der Ausgabe. Jetzt wird wirklich formatiert.
//
// Der Puffer kommt aus alloc und gehoert dem Aufrufer. Das Gradzeichen ist in
// UTF-8 zwei Byte (0xC2 0xB0) — als Literal waere es von der Kodierung der
// Quelldatei abhaengig, deshalb byteweise.
fn _dmsZahl(buf: int64, pos: int64, wert: int64, stellen: int64): int64 {
  var p: int64 := pos;
  var teiler: int64 := 1;
  var i: int64 := 1;
  while (i < stellen) { teiler := teiler * 10; i := i + 1; }
  while (teiler > 0) {
    poke8(buf + p, 48 + ((wert / teiler) % 10));
    p := p + 1;
    teiler := teiler / 10;
  }
  return p;
}

pub fn FormatDMS(coord: int64, isLatitude: bool): pchar {
  var dir: int64 := 78;                      // 'N'
  var wert: int64 := coord;
  if (wert < 0) {
    wert := 0 - wert;
    if (isLatitude) { dir := 83; } else { dir := 87; }   // 'S' / 'W'
  } else {
    if (!isLatitude) { dir := 69; }                      // 'E'
  }

  var deg: int64 := wert / 1000000;
  var rest: int64 := wert % 1000000;
  // 1 Grad = 60 Minuten = 3600 Sekunden; gerechnet wird in Mikrograd, damit
  // die Rundung nicht schon bei den Minuten verloren geht.
  var sekGesamt: int64 := (rest * 3600) / 1000000;
  var minuten: int64 := sekGesamt / 60;
  var sekunden: int64 := sekGesamt % 60;

  var buf: int64 := alloc(24);
  if (buf == 0) { return 0 as pchar; }
  var p: int64 := 0;
  var stellen: int64 := 2;
  if (deg >= 100) { stellen := 3; }
  p := _dmsZahl(buf, p, deg, stellen);
  poke8(buf + p, 0xC2); p := p + 1;          // Gradzeichen, UTF-8
  poke8(buf + p, 0xB0); p := p + 1;
  poke8(buf + p, 32);   p := p + 1;
  p := _dmsZahl(buf, p, minuten, 2);
  poke8(buf + p, 39);   p := p + 1;          // '
  poke8(buf + p, 32);   p := p + 1;
  p := _dmsZahl(buf, p, sekunden, 2);
  poke8(buf + p, 34);   p := p + 1;          // "
  poke8(buf + p, 32);   p := p + 1;
  poke8(buf + p, dir);  p := p + 1;
  poke8(buf + p, 0);
  return buf as pchar;
}

// ============================================================================
// Point-in-Polygon (Ray Casting Algorithmus)
// ============================================================================


// Vereinfachte Version für Rechteck (BoundingBox)
pub fn IsPointInRect2(p: GeoPoint, minLat: int64, minLon: int64, maxLat: int64, maxLon: int64): bool {
  return (p.y >= minLat) && (p.y <= maxLat) &&
         (p.x >= minLon) && (p.x <= maxLon);
}

// ============================================================================
// BoundingBox mit Radius (für Umkreis-Suchen)
// ============================================================================

// Berechnet minimalen Eckpunkt der BoundingBox um einen Punkt (Radius in Metern)
pub fn CalculateBoundingBoxMin(center: GeoPoint, radiusM: int64): GeoPoint {
  var cminY: int64 := center.y;
  var cminX: int64 := center.x;
  var latR: int64 := radiusM * 8982;
  var latOffset: int64 := latR / 1000;
  // #1483: Hier wurde MIT dem Kosinus multipliziert und die Skalierung /1000
  // aus der Breitenzeile vergessen. Beides zusammen ergab eine Laengenspanne
  // von ueber 176 Grad statt 0,29 — eine Umkreissuche haette den halben Globus
  // umfasst. Ein Meter entspricht in Ost-West-Richtung MEHR Grad, je naeher man
  // dem Pol kommt: also geteilt, nicht multipliziert.
  var cosLat: int64 := CosLatTable(cminY / 1000000);
  var lonOffset: int64 := latOffset;
  if (cosLat > 0) { lonOffset := (latOffset * 1000000) / cosLat; }
  var r: GeoPoint; r.x := cminX - lonOffset; r.y := cminY - latOffset;
  return r;
}

// Berechnet maximalen Eckpunkt der BoundingBox um einen Punkt (Radius in Metern)
pub fn CalculateBoundingBoxMax(center: GeoPoint, radiusM: int64): GeoPoint {
  var cmaxY: int64 := center.y;
  var latR: int64 := radiusM * 8982;
  var latOffset: int64 := latR / 1000;
  var cosLat: int64 := CosLatTable(cmaxY / 1000000);   // #1483, siehe Min
  var lonOffset: int64 := latOffset;
  if (cosLat > 0) { lonOffset := (latOffset * 1000000) / cosLat; }
  var r: GeoPoint; r.x := center.x + lonOffset; r.y := center.y + latOffset;
  return r;
}

// ============================================================================
// Offset / Destination Point Calculation
// ============================================================================

// Berechnet neuen Punkt basierend auf Startpunkt, Entfernung und Richtung
// bearing: in Microdegrees (0 = Nord, 90000000 = Ost)
// distanceM: Entfernung in Metern
pub fn AddOffsetM(center: GeoPoint, bearing: int64, distanceM: int64): GeoPoint {
  // Umrechnung: 1 Meter in Microdegrees
  var meterToDeg: int64 := 8982; // ≈ 1/111.319 Grad in Mikrograd
  
  // Entfernung in Grad
  var dLat: int64 := 0;
  var dLon: int64 := 0;
  
  // Vereinfachte Berechnung
  // #1483: Die Ost-West-Komponente wurde MIT dem Kosinus multipliziert (statt
  // geteilt) und zusaetzlich mit 1000 skaliert — eine Bewegung von 10 km nach
  // NORDEN zerstoerte damit die Laenge (lon = -88334714706). Und die Richtung
  // ging nur als Vorzeichen ein: jeder Kurs zwischen den Achsen bewegte den
  // Punkt um die volle Strecke in BEIDE Richtungen.
  //
  // Jetzt wird der Kurs zerlegt — Nordanteil cos(bearing), Ostanteil
  // sin(bearing) —, und der Ostanteil durch den Kosinus der Breite geteilt.
  var strecke: int64 := (distanceM * meterToDeg) / 1000;   // Mikrograd
  dLat := (strecke * Cos64(bearing)) / 1000000;

  var ostGrad: int64 := (strecke * Sin64(bearing)) / 1000000;
  var cosLat: int64 := CosLatTable(center.y / 1000000);
  if (cosLat > 0) { dLon := (ostGrad * 1000000) / cosLat; } else { dLon := 0; }

  var ao: GeoPoint; ao.x := center.x + dLon; ao.y := center.y + dLat;
  return ao;
}

// ============================================================================
// Cosinus-Korrektur für Längengrade (WICHTIG!)
// ============================================================================

// Korrigiert Längengrad-Differenz für Breitengrad
// Ohne dies: 40% Fehler in Deutschland (52° N)
pub fn CorrectLongitudeForLatitude(dLon: int64, lat: int64): int64 {
  var cosLat: int64 := CosLatTable(lat / 1000000);
  var tmp: int64 := dLon * cosLat;
  return tmp / 1000000;
}

// Aktualisierte DistanceM mit Cosinus-Korrektur
pub fn DistanceMCorrected(p1: GeoPoint, p2: GeoPoint): int64 {
  var p2dcy: int64 := p2.y;
  var p1dcy: int64 := p1.y;
  var p2dcx: int64 := p2.x;
  var p1dcx: int64 := p1.x;
  var dLat: int64 := p2dcy - p1dcy;
  var dLon: int64 := p2dcx - p1dcx;
  
  if (dLat < 0) { dLat := -dLat; }
  if (dLon < 0) { dLon := -dLon; }
  
  // WICHTIG: Cosinus-Korrektur für Längengrad
  var midLatSum: int64 := p1.y + p2.y;
  var midLat: int64 := midLatSum / 2;
  var dLonCorr: int64 := CorrectLongitudeForLatitude(dLon, midLat);
  
  // Umrechnung zu Metern
  var x_m_tmp: int64 := dLonCorr * 111319;
  var x_m: int64 := x_m_tmp / 1000000;
  var y_m_tmp: int64 := dLat * 111319;
  var y_m: int64 := y_m_tmp / 1000000;
  
  // #1482: auch hier stand die Oktagon-Naeherung; sie ueberschaetzt die
  // Hypotenuse um bis zu 12 %. Hypot64 rechnet exakt.
  return Hypot64(x_m, y_m);
  if (x_m > y_m) {
    return x_m + (y_m / 2);
  } else {
    return y_m + (x_m / 2);
  }
}

// ============================================================================
// WP-C10: BoundingBox-Funktionen mit GeoBBox-Rückgabe
// Entspricht dem Tuple-Return [GeoPoint, GeoPoint] aus der Spec.
// ============================================================================

// BoundingBoxFromPoints: gibt das kleinste Rechteck zurück, das p1 und p2 enthält.
// min = (min(p1.x,p2.x), min(p1.y,p2.y)), max = (max(...), max(...))
pub fn BoundingBoxFromPoints(p1: GeoPoint, p2: GeoPoint): GeoBBox {
  var minX: int64 := p1.x;
  var minY: int64 := p1.y;
  var maxX: int64 := p1.x;
  var maxY: int64 := p1.y;
  if (p2.x < minX) { minX := p2.x; }
  if (p2.y < minY) { minY := p2.y; }
  if (p2.x > maxX) { maxX := p2.x; }
  if (p2.y > maxY) { maxY := p2.y; }
  var bb: GeoBBox;
  bb.minX := minX; bb.minY := minY;
  bb.maxX := maxX; bb.maxY := maxY;
  return bb;
}

// CalculateBoundingBox: gibt das Rechteck zurück, das einen Kreis mit Radius radiusM
// um center (in Metern) umschließt.
pub fn CalculateBoundingBox(center: GeoPoint, radiusM: int64): GeoBBox {
  var mn: GeoPoint := CalculateBoundingBoxMin(center, radiusM);
  var mx: GeoPoint := CalculateBoundingBoxMax(center, radiusM);
  var bb2: GeoBBox;
  bb2.minX := mn.x; bb2.minY := mn.y;
  bb2.maxX := mx.x; bb2.maxY := mx.y;
  return bb2;
}

// GeoBBoxGetMin: extrahiert den Min-Punkt als GeoPoint
pub fn GeoBBoxGetMin(bb: GeoBBox): GeoPoint {
  var p: GeoPoint; p.x := bb.minX; p.y := bb.minY;
  return p;
}

// GeoBBoxGetMax: extrahiert den Max-Punkt als GeoPoint
pub fn GeoBBoxGetMax(bb: GeoBBox): GeoPoint {
  var p: GeoPoint; p.x := bb.maxX; p.y := bb.maxY;
  return p;
}

// GeoBBoxContains: prüft ob ein Punkt innerhalb der Bounding Box liegt
pub fn GeoBBoxContains(bb: GeoBBox, p: GeoPoint): bool {
  return (p.x >= bb.minX) && (p.x <= bb.maxX) &&
         (p.y >= bb.minY) && (p.y <= bb.maxY);
}

// GeoBBoxOverlaps: prüft ob zwei Bounding Boxes sich überlappen
pub fn GeoBBoxOverlaps(a: GeoBBox, b: GeoBBox): bool {
  return (a.minX <= b.maxX) && (a.maxX >= b.minX) &&
         (a.minY <= b.maxY) && (a.maxY >= b.minY);
}

// GeoBBoxCenter: gibt den Mittelpunkt einer Bounding Box zurück
pub fn GeoBBoxCenter(bb: GeoBBox): GeoPoint {
  var c: GeoPoint;
  c.x := (bb.minX + bb.maxX) / 2;
  c.y := (bb.minY + bb.maxY) / 2;
  return c;
}

