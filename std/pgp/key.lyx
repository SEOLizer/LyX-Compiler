// std/pgp/key.lyx — OpenPGP public-key packet parsing (RFC 4880 §5.5)
//
// Public API:
//   PgpKeyVersion(body, blen)          → version (3 or 4), or 0
//   PgpKeyAlgo(body, blen)             → public-key algorithm ID (PGP_ALG_*)
//   PgpKeyTimestamp(body, blen)        → creation timestamp (v4: Unix seconds)
//   PgpKeyFingerprint(body, blen, out) → 1 on success; out = 20-byte SHA-1 digest
//   PgpKeyId(body, blen, out)          → 1 on success; out = 8-byte key ID (last 8 of fingerprint)
//
// body/blen refer to the packet body (without packet header tag+length bytes).
// Only v4 keys are supported for fingerprinting; v3 keys return version/algo/timestamp only.

@description("OpenPGP v4 key packet parsing: version, algo, fingerprint, key ID")
@author("Andreas Röne")
@copyright("2025-2026 Andreas Röne")
unit std.pgp.key;

import std.pgp.core;
import std.crypto.sha1;
import std.alloc;

// ============================================================================
// PgpKeyVersion — version byte of public-key packet body
// ============================================================================
pub fn PgpKeyVersion(body: int64, blen: int64): int64 {
    if (blen < 6) { return 0; }
    return peek8(body);
}

// ============================================================================
// PgpKeyAlgo — public-key algorithm from packet body
// v4: byte 5 (after version[1] + timestamp[4])
// v3: byte 7 (after version[1] + timestamp[4] + valid_days[2])
// ============================================================================
pub fn PgpKeyAlgo(body: int64, blen: int64): int64 {
    if (blen < 6) { return 0; }
    var ver: int64 := peek8(body);
    if (ver == 4) { return peek8(body + 5); }
    if (ver == 3 && blen >= 8) { return peek8(body + 7); }
    return 0;
}

// ============================================================================
// PgpKeyTimestamp — creation time (Unix epoch seconds, big-endian 4 bytes at body+1)
// ============================================================================
pub fn PgpKeyTimestamp(body: int64, blen: int64): int64 {
    if (blen < 5) { return 0; }
    return (peek8(body+1) << 24) | (peek8(body+2) << 16) | (peek8(body+3) << 8) | peek8(body+4);
}

// ============================================================================
// PgpKeyFingerprint — v4 SHA-1 fingerprint (RFC 4880 §12.2)
// Hash: 0x99 || uint16_BE(blen) || body
// out must be at least 20 bytes
// ============================================================================
pub fn PgpKeyFingerprint(body: int64, blen: int64, out: int64): int64 {
    if (blen < 6) { return 0; }
    if (peek8(body) != 4) { return 0; }
    if (blen > 0xFFFF) { return 0; }

    var hashIn: int64 := alloc(blen + 3);
    poke8(hashIn,     0x99);
    poke8(hashIn + 1, (blen >> 8) & 255);
    poke8(hashIn + 2, blen & 255);
    var i: int64 := 0;
    while (i < blen) { poke8(hashIn + 3 + i, peek8(body + i)); i := i + 1; }
    SHA1(hashIn, blen + 3, out);
    free(hashIn, blen + 3);
    return 1;
}

// ============================================================================
// PgpKeyId — last 8 bytes of v4 fingerprint
// out must be at least 8 bytes
// ============================================================================
pub fn PgpKeyId(body: int64, blen: int64, out: int64): int64 {
    var fp: int64 := alloc(20);
    var r: int64 := PgpKeyFingerprint(body, blen, fp);
    if (r != 0) {
        var i: int64 := 0;
        while (i < 8) { poke8(out + i, peek8(fp + 12 + i)); i := i + 1; }
    }
    free(fp, 20);
    return r;
}
