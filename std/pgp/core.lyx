// ============================================================================
// CRC-24 — RFC 4880 §6.1
// Init: 0xB704CE   Poly: 0x1864CFB
// ============================================================================
pub fn PgpCrc24(data: int64, len: int64): int64 {
    var crc: int64 := 0xB704CE;
    var i: int64 := 0;
    while (i < len) {
        crc := crc ^ (peek8(data + i) << 16);
        var j: int64 := 0;
        while (j < 8) {
            crc := crc << 1;
            if ((crc & 0x1000000) != 0) { crc := crc ^ 0x1864CFB; }
            j += 1;
        }
        i += 1;
    }
    return crc & 0xFFFFFF;
}
