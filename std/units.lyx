// std/units.lyx
// Unit Types / Dimensional Analysis — standard physical units

@description("Physical unit types and conversions")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
unit std.units;

// ============================================================================
// 1. Base Dimensions
// ============================================================================

pub dim Length;
pub dim Time;
pub dim Mass;
pub dim Temperature;
pub dim Angle;
pub dim Data;
pub dim ElectricCurrent;
pub dim Voltage;
pub dim Power;

// ============================================================================
// 2. Derived Dimensions
// ============================================================================

pub dim Speed        = Length / Time;
pub dim Acceleration = Speed / Time;
pub dim Area         = Length * Length;
pub dim Volume       = Area * Length;
pub dim Force        = Mass * Acceleration;
pub dim Energy       = Force * Length;
// #1953: stand hier als `= Time` — eine Frequenz galt damit als
// dimensionsgleich mit einer DAUER, und `var f: Hz := dauer;` ging durch.
// Genau der Fehler, den ein Dimensionssystem verhindern soll. Der Kommentar
// gab zu, dass der Kehrwert nicht ausdrueckbar sei; seit #1962 ist er es.
pub dim Frequency    = 1 / Time;
pub dim Resistance   = Voltage / ElectricCurrent;

// ============================================================================
// 3. Length Units
// ============================================================================

pub utype m:   Length = 1.0;         // metre (SI base)
pub utype km:  Length = 1000.0;      // kilometre
pub utype cm:  Length = 0.01;        // centimetre
pub utype mm:  Length = 0.001;       // millimetre
pub utype nmi: Length = 1852.0;      // nautical mile
pub utype mi:  Length = 1609.344;    // statute mile
pub utype ft:  Length = 0.3048;      // foot
pub utype inch: Length = 0.0254;     // inch

// ============================================================================
// 4. Time Units
// ============================================================================

pub utype s:   Time = 1.0;           // second (SI base)
pub utype ms:  Time = 0.001;         // millisecond
pub utype us:  Time = 0.000001;      // microsecond
pub utype min: Time = 60.0;          // minute
pub utype h:   Time = 3600.0;        // hour
pub utype day: Time = 86400.0;       // day

// ============================================================================
// 5. Mass Units
// ============================================================================

pub utype kg:  Mass = 1.0;           // kilogram (SI base)
pub utype g:   Mass = 0.001;         // gram
pub utype mg:  Mass = 0.000001;      // milligram
pub utype lb:  Mass = 0.45359237;    // pound (exakt, internationales Pfund)
pub utype oz:  Mass = 0.028349523125; // ounce (exakt, lb/16)
pub utype t:   Mass = 1000.0;        // metric tonne

// ============================================================================
// 6. Speed Units
// ============================================================================

pub utype mps:  Speed = 1.0;         // metres per second (SI)
pub utype kmh:  Speed = 0.27777777777778; // km/h = 5/18 m/s (periodisch, 14 Stellen)
pub utype kts:  Speed = 0.51444444444444; // Knoten = 1852/3600 m/s (periodisch)
pub utype mph:  Speed = 0.44704;     // miles per hour
pub utype fps:  Speed = 0.3048;      // feet per second

// ============================================================================
// 7. Angle Units
// ============================================================================

pub utype rad: Angle = 1.0;          // radian (SI base)
pub utype deg: Angle = 0.01745329251994;  // Grad = pi/180 (irrational, 14 Stellen)
pub utype grad: Angle = 0.01570796326795; // Gon = pi/200 (irrational, 14 Stellen)

// ============================================================================
// 8. Temperature Units
//    (factors relative to Kelvin base; conversion is affine — only scaling here)
// ============================================================================

pub utype K:   Temperature = 1.0;    // Kelvin (SI base)

// #1953: `C` und `F` standen hier als Einheitentypen mit den Faktoren 1.0 und
// 0.5556, mit dem Vermerk "offset handled in code" — es gab aber keinen Code,
// der den Versatz behandelte. `var k: K := celsius;` rechnete 20 Grad Celsius
// in 20 Kelvin um.
//
// Celsius und Fahrenheit sind AFFIN, nicht skalar: sie haben einen Nullpunkt,
// der nicht der absolute ist. Ein rein multiplikatives System kann sie nicht
// tragen; ein Faktor allein ist fuer sie immer falsch. Sie gehoeren deshalb
// nicht in die Einheitenliste, sondern als Funktionen daneben — dort ist der
// Versatz sichtbar und nachlesbar.
//
// Wer Temperaturen als Einheitentyp fuehren will, nimmt K und rechnet an der
// Systemgrenze um.

pub fn CelsiusToKelvin(c: f64): f64    { return c + 273.15; }
pub fn KelvinToCelsius(k: f64): f64    { return k - 273.15; }
pub fn FahrenheitToCelsius(f: f64): f64 { return (f - 32.0) * 5.0 / 9.0; }
pub fn CelsiusToFahrenheit(c: f64): f64 { return c * 9.0 / 5.0 + 32.0; }
pub fn FahrenheitToKelvin(f: f64): f64 { return FahrenheitToCelsius(f) + 273.15; }
pub fn KelvinToFahrenheit(k: f64): f64 { return CelsiusToFahrenheit(k - 273.15); }

// ============================================================================
// 7b. Units of the remaining derived dimensions
//     #1953: Acceleration, Area, Volume, Force und Energy waren wie Frequency
//     deklariert, hatten aber KEINE EINZIGE Einheit — Dimensionen, die niemand
//     benutzen konnte. Seit #1962 traegt die Algebra sie, also lohnen sie sich.
// ============================================================================

pub utype mps2: Acceleration = 1.0;  // metre per second squared (SI)
pub utype gee:  Acceleration = 9.80665; // standard gravity (exakt, CGPM 1901)

pub utype m2:   Area = 1.0;          // square metre (SI)
pub utype ha:   Area = 10000.0;      // hectare
pub utype km2:  Area = 1000000.0;    // square kilometre

pub utype m3:   Volume = 1.0;        // cubic metre (SI)
pub utype l:    Volume = 0.001;      // litre
pub utype ml:   Volume = 0.000001;   // millilitre

pub utype N:    Force = 1.0;         // newton (SI)
pub utype kN:   Force = 1000.0;      // kilonewton

pub utype J:    Energy = 1.0;        // joule (SI)
pub utype kJ:   Energy = 1000.0;     // kilojoule
pub utype MJ:   Energy = 1000000.0;  // megajoule
pub utype Wh:   Energy = 3600.0;     // watt hour
pub utype kWh:  Energy = 3600000.0;  // kilowatt hour

// ============================================================================
// 8b. Frequency Units
//     #1953: `dim Frequency` stand seit jeher ohne eine einzige Einheit da —
//     eine Dimension, die niemand benutzen konnte. Seit #1962 traegt sie mit
//     `1 / Time` auch den richtigen Exponenten.
// ============================================================================

pub utype Hz:  Frequency = 1.0;         // hertz (SI)
pub utype kHz: Frequency = 1000.0;      // kilohertz
pub utype MHz: Frequency = 1000000.0;   // megahertz
pub utype GHz: Frequency = 1000000000.0; // gigahertz

// ============================================================================
// 9. Digital Data Units
// ============================================================================

pub utype B:   Data = 1.0;           // byte
pub utype KB:  Data = 1024.0;        // kibibyte
pub utype MB:  Data = 1048576.0;     // mebibyte
pub utype GB:  Data = 1073741824.0;  // gibibyte
pub utype TB:  Data = 1099511627776.0; // tebibyte

// ============================================================================
// 10. Electrical Units
// ============================================================================

pub utype V:   Voltage = 1.0;        // volt (SI)
pub utype mV:  Voltage = 0.001;      // millivolt
pub utype kV:  Voltage = 1000.0;     // kilovolt

pub utype A:   ElectricCurrent = 1.0;    // ampere (SI)
pub utype mA:  ElectricCurrent = 0.001;  // milliampere
pub utype uA:  ElectricCurrent = 0.000001; // microampere

pub utype W:   Power = 1.0;          // watt (SI)
pub utype kW:  Power = 1000.0;       // kilowatt
pub utype MW:  Power = 1000000.0;    // megawatt
pub utype mW:  Power = 0.001;        // milliwatt

pub utype Ohm: Resistance = 1.0;     // ohm (SI)
pub utype kOhm: Resistance = 1000.0; // kilohm
pub utype MOhm: Resistance = 1000000.0; // megaohm

// ============================================================================
// End of std/units.lyx
