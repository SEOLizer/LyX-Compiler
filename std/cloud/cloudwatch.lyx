// std/cloud/cloudwatch.lyx — AWS CloudWatch Metrics + Logs Client
// WP-AWS-12
// Metrics: Query protocol; Logs: JSON protocol
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, system.env, system.time])

unit std.cloud.cloudwatch;

import std.cloud.aws.core;
import std.cloud.aws.transport;
import std.cloud.aws.xml;
import std.alloc;
import std.io;

// Lyx hat keinen if-Ausdruck; die frühere Fassung schrieb
// `if(v<10){48+v}else{87+v}` mitten in eine Argumentliste und parste nicht.
fn _hexDigit(v: int64): int64 {
  if (v < 10) { return 48 + v; }
  return 87 + v;
}


pub type CWClient = struct {
    creds:  AWSCreds;
    region: int64;
    host:   int64;  // metrics endpoint
};

pub type CWLogsClient = struct {
    creds:  AWSCreds;
    region: int64;
    host:   int64;  // logs endpoint
};

pub type CWMetricDatum = struct {
    metricName: int64;  // pchar
    value:      int64;  // int64 bits of f64
    unitName:       int64;  // pchar (e.g. "Count", "Bytes", "Milliseconds", "None")
    timestamp:  int64;  // epoch seconds (0 = now)
};

fn cwAppend(buf: int64, off: int64, s: pchar): int64 {
    var n: int64 := StrLen(s); var i: int64 := 0;
    while(i<n){poke8(buf+off+i,StrCharAt(s,i)&0xFF);i:=i+1;}
    return off+n;
}

fn cwUrlEncode(s: pchar, buf: int64, off: int64): int64 {
    var n: int64 := StrLen(s); var i: int64 := 0;
    while(i<n){
        var c: int64 := StrCharAt(s,i) & 0xFF;
        if ((c>=65&&c<=90)||(c>=97&&c<=122)||(c>=48&&c<=57)||c==45||c==95||c==46||c==126) {
            poke8(buf+off,c); off:=off+1;
        } else {
            poke8(buf+off,37);
            poke8(buf+off+1,_hexDigit((c>>4)));
            poke8(buf+off+2,_hexDigit((c&0xF)));
            off:=off+3;
        }
        i:=i+1;
    }
    return off;
}

fn cwJsonEscape(s: pchar, buf: int64, off: int64): int64 {
    if (s == 0 as pchar) { return off; }
    var n: int64 := StrLen(s); var i: int64 := 0;
    while (i < n) {
        var c: int64 := StrCharAt(s,i) & 0xFF;
        if (c == 34) { poke8(buf+off,92); poke8(buf+off+1,34); off:=off+2; }
        else if (c == 92) { poke8(buf+off,92); poke8(buf+off+1,92); off:=off+2; }
        else if (c == 10) { poke8(buf+off,92); poke8(buf+off+1,110); off:=off+2; }
        else { poke8(buf+off,c); off:=off+1; }
        i:=i+1;
    }
    return off;
}

fn cwSend(client: CWClient, body: int64, bodyLen: int64): AWSResponse {
    return AWSQueryRequest(client.creds, client.host as pchar,
                           body, bodyLen,
                           client.region as pchar, "monitoring"c);
}

fn cwLogsSend(client: CWLogsClient, target: pchar, body: int64, bodyLen: int64): AWSResponse {
    return AWSJSONRequest(client.creds, client.host as pchar, target,
                          body, bodyLen,
                          client.region as pchar, "logs"c,
                          "application/x-amz-json-1.1"c);
}

pub fn CWConnect(creds: AWSCreds, region: pchar): CWClient {
    var c: CWClient;
    c.creds  := creds;
    c.region := region as int64;
    c.host   := AWSEndpoint("monitoring"c, region) as int64;
    return c;
}

pub fn CWClose(client: CWClient) {
    AWSCredentialsFree(client.creds);
    if (client.host != 0) { free(client.host, StrLen(client.host as pchar)+1); }
}

pub fn CWLogsConnect(creds: AWSCreds, region: pchar): CWLogsClient {
    var c: CWLogsClient;
    c.creds  := creds;
    c.region := region as int64;
    c.host   := AWSEndpoint("logs"c, region) as int64;
    return c;
}

pub fn CWLogsClose(client: CWLogsClient) {
    AWSCredentialsFree(client.creds);
    if (client.host != 0) { free(client.host, StrLen(client.host as pchar)+1); }
}

// ── Metrics ───────────────────────────────────────────────────────────────────

pub fn CWListMetrics(client: CWClient, ns: pchar, metricName: pchar): int64 {
    var buf: int64 := alloc(512); var off: int64 := 0;
    off := cwAppend(buf, off, "Action=ListMetrics&Version=2010-08-01"c);
    if (ns != 0 as pchar && StrLen(ns) > 0) {
        off := cwAppend(buf, off, "&Namespace="c);
        off := cwUrlEncode(ns, buf, off);
    }
    if (metricName != 0 as pchar && StrLen(metricName) > 0) {
        off := cwAppend(buf, off, "&MetricName="c);
        off := cwUrlEncode(metricName, buf, off);
    }
    poke8(buf+off, 0);
    var resp: AWSResponse := cwSend(client, buf, off);
    free(buf, 512);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

pub fn CWGetMetricStatistics(client: CWClient,
                              ns: pchar, metricName: pchar,
                              startTime: pchar, endTime: pchar,
                              period: int64, statistic: pchar,
                              unitName: pchar): int64 {
    var buf: int64 := alloc(2048); var off: int64 := 0;
    off := cwAppend(buf, off, "Action=GetMetricStatistics&Version=2010-08-01&Namespace="c);
    off := cwUrlEncode(ns, buf, off);
    off := cwAppend(buf, off, "&MetricName="c);
    off := cwUrlEncode(metricName, buf, off);
    off := cwAppend(buf, off, "&StartTime="c);
    off := cwUrlEncode(startTime, buf, off);
    off := cwAppend(buf, off, "&EndTime="c);
    off := cwUrlEncode(endTime, buf, off);
    off := cwAppend(buf, off, "&Period="c);
    var tmp: int64 := alloc(24); Int64ToStr(period, tmp as pchar);
    off := cwAppend(buf, off, tmp as pchar); free(tmp, 24);
    off := cwAppend(buf, off, "&Statistics.member.1="c);
    off := cwUrlEncode(statistic, buf, off);
    if (unitName != 0 as pchar && StrLen(unitName) > 0) {
        off := cwAppend(buf, off, "&Unit="c);
        off := cwUrlEncode(unitName, buf, off);
    }
    poke8(buf+off, 0);
    var resp: AWSResponse := cwSend(client, buf, off);
    free(buf, 2048);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

pub fn CWPutMetricData(client: CWClient, ns: pchar,
                        data: int64, count: int64): int64 {
    // data: array of CWMetricDatum structs (each 32 bytes: metricName, value, unit, timestamp)
    var buf: int64 := alloc(8192); var off: int64 := 0;
    off := cwAppend(buf, off, "Action=PutMetricData&Version=2010-08-01&Namespace="c);
    off := cwUrlEncode(ns, buf, off);
    var i: int64 := 0;
    while (i < count) {
        var datum: int64 := data + i*32;
        var name: pchar := peek64(datum)   as pchar;
        var val:  int64 := peek64(datum+8);
        var unitName: pchar := peek64(datum+16) as pchar;
        var ts:   int64 := peek64(datum+24);
        var idx: int64 := alloc(24); Int64ToStr(i+1, idx as pchar);
        off := cwAppend(buf, off, "&MetricData.member."c);
        off := cwAppend(buf, off, idx as pchar);
        off := cwAppend(buf, off, ".MetricName="c);
        off := cwUrlEncode(name, buf, off);
        off := cwAppend(buf, off, "&MetricData.member."c);
        off := cwAppend(buf, off, idx as pchar);
        off := cwAppend(buf, off, ".Value="c);
        // val is an integer representing the value (as int64)
        var vtmp: int64 := alloc(32); Int64ToStr(val, vtmp as pchar);
        off := cwAppend(buf, off, vtmp as pchar);
        free(vtmp, 32);
        if (unitName != 0 as pchar && StrLen(unitName) > 0) {
            off := cwAppend(buf, off, "&MetricData.member."c);
            off := cwAppend(buf, off, idx as pchar);
            off := cwAppend(buf, off, ".Unit="c);
            off := cwUrlEncode(unitName, buf, off);
        }
        if (ts > 0) {
            off := cwAppend(buf, off, "&MetricData.member."c);
            off := cwAppend(buf, off, idx as pchar);
            off := cwAppend(buf, off, ".Timestamp="c);
            var tstmp: int64 := alloc(32); Int64ToStr(ts, tstmp as pchar);
            off := cwAppend(buf, off, tstmp as pchar);
            free(tstmp, 32);
        }
        free(idx, 24);
        i:=i+1;
    }
    poke8(buf+off, 0);
    var resp: AWSResponse := cwSend(client, buf, off);
    free(buf, 8192);
    var ok: int64 := 0; if (resp.statusCode == 200) { ok:=1; }
    AWSResponseFree(resp);
    return ok;
}

