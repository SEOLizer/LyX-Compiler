pub fn CWLogsPutLogEvents(client: CWLogsClient,
                           groupName: pchar, streamName: pchar,
                           messages: int64, timestamps: int64, count: int64,
                           sequenceToken: pchar): int64 {
    // messages: array of pchar; timestamps: array of int64 (epoch ms)
    var buf: int64 := alloc(65536); var off: int64 := 0;
    off := cwAppend(buf, off, "{\"logGroupName\":\""c);
    off := cwJsonEscape(groupName, buf, off);
    off := cwAppend(buf, off, "\",\"logStreamName\":\""c);
    off := cwJsonEscape(streamName, buf, off);
    off := cwAppend(buf, off, "\""c);
    if (sequenceToken != 0 as pchar && StrLen(sequenceToken) > 0) {
        off := cwAppend(buf, off, ",\"sequenceToken\":\""c);
        off := cwJsonEscape(sequenceToken, buf, off);
        off := cwAppend(buf, off, "\""c);
    }
    off := cwAppend(buf, off, ",\"logEvents\":["c);
    var i: int64 := 0;
    while (i < count) {
        if (i > 0) { poke8(buf+off,44); off:=off+1; }
        var msg: pchar := peek64(messages + i*8) as pchar;
        var ts: int64  := peek64(timestamps + i*8);
        off := cwAppend(buf, off, "{\"timestamp\":"c);
        var tmp: int64 := alloc(24); Int64ToStr(ts, tmp as pchar);
        off := cwAppend(buf, off, tmp as pchar); free(tmp, 24);
        off := cwAppend(buf, off, ",\"message\":\""c);
        off := cwJsonEscape(msg, buf, off);
        off := cwAppend(buf, off, "\"}"c);
        i:=i+1;
    }
    off := cwAppend(buf, off, "]}"c);
    poke8(buf+off, 0);
    var resp: AWSResponse := cwLogsSend(client, "Logs_20140328.PutLogEvents"c, buf, off);
    free(buf, 65536);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

