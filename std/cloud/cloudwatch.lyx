    off := cwAppend(buf, off, "\""c);
    if (startTime > 0) {
        off := cwAppend(buf, off, ",\"startTime\":"c);
        var tmp: int64 := alloc(24); Int64ToStr(startTime, tmp as pchar);
        off := cwAppend(buf, off, tmp as pchar); free(tmp, 24);
    }
    if (endTime > 0) {
        off := cwAppend(buf, off, ",\"endTime\":"c);
        var tmp2: int64 := alloc(24); Int64ToStr(endTime, tmp2 as pchar);
