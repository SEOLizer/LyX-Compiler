pub fn CWPutMetricAlarm(client: CWClient,
                         alarmName: pchar, ns: pchar, metricName: pchar,
                         comparison: pchar, threshold: int64,
                         period: int64, evalPeriods: int64, statistic: pchar,
                         actionsEnabled: int64, alarmArn: pchar): int64 {
    var buf: int64 := alloc(4096); var off: int64 := 0;
    off := cwAppend(buf, off, "Action=PutMetricAlarm&Version=2010-08-01&AlarmName="c);
    off := cwUrlEncode(alarmName, buf, off);
    off := cwAppend(buf, off, "&Namespace="c);
    off := cwUrlEncode(ns, buf, off);
    off := cwAppend(buf, off, "&MetricName="c);
    off := cwUrlEncode(metricName, buf, off);
    off := cwAppend(buf, off, "&ComparisonOperator="c);
    off := cwUrlEncode(comparison, buf, off);
    off := cwAppend(buf, off, "&Threshold="c);
    var tmp: int64 := alloc(24); Int64ToStr(threshold, tmp as pchar);
    off := cwAppend(buf, off, tmp as pchar);
    off := cwAppend(buf, off, "&Period="c);
    Int64ToStr(period, tmp as pchar);
    off := cwAppend(buf, off, tmp as pchar);
    off := cwAppend(buf, off, "&EvaluationPeriods="c);
    Int64ToStr(evalPeriods, tmp as pchar);
    off := cwAppend(buf, off, tmp as pchar);
    free(tmp, 24);
    off := cwAppend(buf, off, "&Statistic="c);
    off := cwUrlEncode(statistic, buf, off);
    if (actionsEnabled != 0) {
        off := cwAppend(buf, off, "&ActionsEnabled=true"c);
    }
    if (alarmArn != 0 as pchar && StrLen(alarmArn) > 0) {
        off := cwAppend(buf, off, "&AlarmActions.member.1="c);
        off := cwUrlEncode(alarmArn, buf, off);
    }
    poke8(buf+off, 0);
    var resp: AWSResponse := cwSend(client, buf, off);
    free(buf, 4096);
    var ok: int64 := 0; if (resp.statusCode == 200) { ok:=1; }
    AWSResponseFree(resp);
    return ok;
}

