// ── Platform Applications (push notifications) ────────────────────────────────

pub fn SNSCreatePlatformApplication(client: SNSClient, name: pchar,
                                     platform: pchar, credential: pchar): int64 {
    // platform: "APNS" | "GCM" | "APNS_SANDBOX" etc.
    var buf: int64 := alloc(2048); var off: int64 := 0;
    off := snsAppend(buf, off, "Action=CreatePlatformApplication&Version=2010-03-31&Name="c);
    off := snsUrlEncode(name, buf, off);
    off := snsAppend(buf, off, "&Platform="c);
    off := snsUrlEncode(platform, buf, off);
    off := snsAppend(buf, off, "&Attributes.entry.1.key=PlatformCredential&Attributes.entry.1.value="c);
    off := snsUrlEncode(credential, buf, off);
    poke8(buf+off, 0);
    var resp: AWSResponse := snsSend(client, buf, off);
    free(buf, 2048);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := XMLFind(resp.body, resp.bodyLen, "PlatformApplicationArn"c);
    }
    AWSResponseFree(resp);
    return result;
}

pub fn SNSCreatePlatformEndpoint(client: SNSClient, platformAppArn: pchar,
                                  deviceToken: pchar, userData: pchar): int64 {
    var buf: int64 := alloc(2048); var off: int64 := 0;
    off := snsAppend(buf, off, "Action=CreatePlatformEndpoint&Version=2010-03-31&PlatformApplicationArn="c);
    off := snsUrlEncode(platformAppArn, buf, off);
    off := snsAppend(buf, off, "&Token="c);
    off := snsUrlEncode(deviceToken, buf, off);
    if (userData != 0 as pchar && StrLen(userData) > 0) {
        off := snsAppend(buf, off, "&CustomUserData="c);
        off := snsUrlEncode(userData, buf, off);
    }
    poke8(buf+off, 0);
    var resp: AWSResponse := snsSend(client, buf, off);
    free(buf, 2048);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := XMLFind(resp.body, resp.bodyLen, "EndpointArn"c);
    }
    AWSResponseFree(resp);
    return result;
}
