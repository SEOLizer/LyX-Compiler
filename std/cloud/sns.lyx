// ── Publishing ────────────────────────────────────────────────────────────────

pub fn SNSPublish(client: SNSClient, topicArn: pchar, subject: pchar, message: pchar): int64 {
    var buf: int64 := alloc(8192); var off: int64 := 0;
    off := snsAppend(buf, off, "Action=Publish&Version=2010-03-31&TopicArn="c);
    off := snsUrlEncode(topicArn, buf, off);
    if (subject != 0 as pchar && StrLen(subject) > 0) {
        off := snsAppend(buf, off, "&Subject="c);
        off := snsUrlEncode(subject, buf, off);
    }
    off := snsAppend(buf, off, "&Message="c);
    off := snsUrlEncode(message, buf, off);
    poke8(buf+off, 0);
    var resp: AWSResponse := snsSend(client, buf, off);
    free(buf, 8192);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := XMLFind(resp.body, resp.bodyLen, "MessageId"c);
    }
    AWSResponseFree(resp);
    return result;
}

pub fn SNSPublishToPhone(client: SNSClient, phoneNumber: pchar, message: pchar): int64 {
    var buf: int64 := alloc(4096); var off: int64 := 0;
    off := snsAppend(buf, off, "Action=Publish&Version=2010-03-31&PhoneNumber="c);
    off := snsUrlEncode(phoneNumber, buf, off);
    off := snsAppend(buf, off, "&Message="c);
    off := snsUrlEncode(message, buf, off);
    poke8(buf+off, 0);
    var resp: AWSResponse := snsSend(client, buf, off);
    free(buf, 4096);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := XMLFind(resp.body, resp.bodyLen, "MessageId"c);
    }
    AWSResponseFree(resp);
    return result;
}

pub fn SNSPublishBatch(client: SNSClient, topicArn: pchar,
                        messages: int64, count: int64): int64 {
    // messages: array of pchar message bodies
    var buf: int64 := alloc(65536); var off: int64 := 0;
    off := snsAppend(buf, off, "Action=PublishBatch&Version=2010-03-31&TopicArn="c);
    off := snsUrlEncode(topicArn, buf, off);
    var i: int64 := 0;
    while (i < count) {
        var msg: pchar := peek64(messages + i*8) as pchar;
        var tmp: int64 := alloc(24); Int64ToStr(i+1, tmp as pchar);
        off := snsAppend(buf, off, "&PublishBatchRequestEntries.member."c);
        off := snsAppend(buf, off, tmp as pchar);
        off := snsAppend(buf, off, ".Id="c);
        off := snsAppend(buf, off, tmp as pchar);
        off := snsAppend(buf, off, "&PublishBatchRequestEntries.member."c);
        off := snsAppend(buf, off, tmp as pchar);
        off := snsAppend(buf, off, ".Message="c);
        free(tmp, 24);
        off := snsUrlEncode(msg, buf, off);
        i:=i+1;
    }
    poke8(buf+off, 0);
    var resp: AWSResponse := snsSend(client, buf, off);
    free(buf, 65536);
    var ok: int64 := 0; if (resp.statusCode == 200) { ok:=1; }
    AWSResponseFree(resp);
    return ok;
}

// ── Subscriptions ─────────────────────────────────────────────────────────────

pub fn SNSSubscribe(client: SNSClient, topicArn: pchar,
                    protocol: pchar, endpoint: pchar): int64 {
    var buf: int64 := alloc(2048); var off: int64 := 0;
    off := snsAppend(buf, off, "Action=Subscribe&Version=2010-03-31&TopicArn="c);
    off := snsUrlEncode(topicArn, buf, off);
    off := snsAppend(buf, off, "&Protocol="c);
    off := snsUrlEncode(protocol, buf, off);
    off := snsAppend(buf, off, "&Endpoint="c);
    off := snsUrlEncode(endpoint, buf, off);
    poke8(buf+off, 0);
    var resp: AWSResponse := snsSend(client, buf, off);
    free(buf, 2048);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := XMLFind(resp.body, resp.bodyLen, "SubscriptionArn"c);
    }
    AWSResponseFree(resp);
    return result;
}

