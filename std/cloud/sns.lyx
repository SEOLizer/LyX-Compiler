// std/cloud/sns.lyx — AWS SNS Client
// WP-AWS-11 (messaging part 2)
// Query protocol (POST form-urlencoded → XML responses)
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, system.env, system.time])

unit std.cloud.sns;

import std.cloud.aws.core;
import std.cloud.aws.transport;
import std.cloud.aws.xml;
import std.alloc;
import std.io;

// Lyx hat keinen if-Ausdruck; die frühere Fassung schrieb
// `if(v<10){48+v}else{87+v}` mitten in eine Argumentliste und parste nicht.
fn _hexDigit(v: int64): int64 {
  if (v < 10) { return 48 + v; }
  return 87 + v;
}


pub type SNSClient = struct {
    creds:  AWSCreds;
    region: int64;
    host:   int64;
};

fn snsAppend(buf: int64, off: int64, s: pchar): int64 {
    var n: int64 := StrLen(s); var i: int64 := 0;
    while(i<n){poke8(buf+off+i,StrCharAt(s,i)&0xFF);i:=i+1;}
    return off+n;
}

fn snsUrlEncode(s: pchar, buf: int64, off: int64): int64 {
    var n: int64 := StrLen(s); var i: int64 := 0;
    while(i<n){
        var c: int64 := StrCharAt(s,i) & 0xFF;
        if ((c>=65&&c<=90)||(c>=97&&c<=122)||(c>=48&&c<=57)||c==45||c==95||c==46||c==126) {
            poke8(buf+off,c); off:=off+1;
        } else {
            poke8(buf+off,37);
            poke8(buf+off+1,_hexDigit((c>>4)));
            poke8(buf+off+2,_hexDigit((c&0xF)));
            off:=off+3;
        }
        i:=i+1;
    }
    return off;
}

fn snsSend(client: SNSClient, body: int64, bodyLen: int64): AWSResponse {
    return AWSQueryRequest(client.creds, client.host as pchar,
                           body, bodyLen,
                           client.region as pchar, "sns"c);
}

pub fn SNSConnect(creds: AWSCreds, region: pchar): SNSClient {
    var c: SNSClient;
    c.creds  := creds;
    c.region := region as int64;
    c.host   := AWSEndpoint("sns"c, region) as int64;
    return c;
}

pub fn SNSClose(client: SNSClient) {
    AWSCredentialsFree(client.creds);
    if (client.host != 0) { free(client.host, StrLen(client.host as pchar)+1); }
}

// ── Topics ────────────────────────────────────────────────────────────────────

pub fn SNSListTopics(client: SNSClient): int64 {
    var body: pchar := "Action=ListTopics&Version=2010-03-31"c;
    var resp: AWSResponse := snsSend(client, body as int64, StrLen(body));
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

pub fn SNSCreateTopic(client: SNSClient, name: pchar): int64 {
    var buf: int64 := alloc(256); var off: int64 := 0;
    off := snsAppend(buf, off, "Action=CreateTopic&Version=2010-03-31&Name="c);
    off := snsUrlEncode(name, buf, off);
    poke8(buf+off, 0);
    var resp: AWSResponse := snsSend(client, buf, off);
    free(buf, 256);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := XMLFind(resp.body, resp.bodyLen, "TopicArn"c);
    }
    AWSResponseFree(resp);
    return result;
}

pub fn SNSCreateFIFOTopic(client: SNSClient, name: pchar): int64 {
    var buf: int64 := alloc(512); var off: int64 := 0;
    off := snsAppend(buf, off, "Action=CreateTopic&Version=2010-03-31&Name="c);
    off := snsUrlEncode(name, buf, off);
    off := snsAppend(buf, off, "&Attributes.entry.1.key=FifoTopic&Attributes.entry.1.value=true"c);
    poke8(buf+off, 0);
    var resp: AWSResponse := snsSend(client, buf, off);
    free(buf, 512);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := XMLFind(resp.body, resp.bodyLen, "TopicArn"c);
    }
    AWSResponseFree(resp);
    return result;
}

pub fn SNSDeleteTopic(client: SNSClient, topicArn: pchar): int64 {
    var buf: int64 := alloc(512); var off: int64 := 0;
    off := snsAppend(buf, off, "Action=DeleteTopic&Version=2010-03-31&TopicArn="c);
    off := snsUrlEncode(topicArn, buf, off);
    poke8(buf+off, 0);
    var resp: AWSResponse := snsSend(client, buf, off);
    free(buf, 512);
    var ok: int64 := 0; if (resp.statusCode == 200) { ok:=1; }
    AWSResponseFree(resp);
    return ok;
}

