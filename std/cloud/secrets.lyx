// ── SSM Parameter Store ───────────────────────────────────────────────────────

pub fn SSMGetParameter(client: SSMClient, name: pchar, withDecryption: int64): int64 {
    var buf: int64 := alloc(256); var off: int64 := 0;
    off := secAppend(buf, off, "{\"Name\":\""c);
    off := secJsonEscape(name, buf, off);
    off := secAppend(buf, off, "\""c);
    if (withDecryption != 0) {
        off := secAppend(buf, off, ",\"WithDecryption\":true"c);
    }
    off := secAppend(buf, off, "}"c);
    poke8(buf+off, 0);
    var resp: AWSResponse := ssmSend(client, "AmazonSSM.GetParameter"c, buf, off);
    free(buf, 256);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

pub fn SSMGetParameterValue(client: SSMClient, name: pchar): int64 {
    // Returns the Value string directly (alloc'd) or 0
    var resp: int64 := SSMGetParameter(client, name, 1);
    if (resp == 0) { return 0; }
    var respLen: int64 := StrLen(resp as pchar);
    var key: pchar := "\"Value\":\""c;
    var kl: int64 := StrLen(key);
    var i: int64 := 0;
    while (i < respLen - kl) {
        var isMatch: int64 := 1; var j: int64 := 0;
        while(j<kl){if(peek8(resp+i+j)!=(StrCharAt(key,j)&0xFF)){isMatch:=0;break;}j:=j+1;}
        if (isMatch == 1) {
            var start: int64 := i + kl;
            var end: int64 := start;
            while (end < respLen) {
                var c: int64 := peek8(resp+end) & 0xFF;
                if (c == 92 && end+1 < respLen) { end:=end+2; continue; }
                if (c == 34) { break; }
                end:=end+1;
            }
            var result: int64 := alloc(end-start+1);
            var k: int64 := 0; while(k<end-start){poke8(result+k,peek8(resp+start+k));k:=k+1;}
            poke8(result+end-start,0);
            free(resp, respLen+1);
            return result;
        }
        i:=i+1;
    }
    free(resp, respLen+1);
    return 0;
}

pub fn SSMPutParameter(client: SSMClient, name: pchar, value: pchar,
                        paramType: pchar, overwrite: int64, kmsKeyId: pchar): int64 {
    // paramType: "String" | "SecureString" | "StringList"
    var buf: int64 := alloc(4096); var off: int64 := 0;
    off := secAppend(buf, off, "{\"Name\":\""c);
    off := secJsonEscape(name, buf, off);
    off := secAppend(buf, off, "\",\"Value\":\""c);
    off := secJsonEscape(value, buf, off);
    off := secAppend(buf, off, "\",\"Type\":\""c);
    off := secAppend(buf, off, paramType);
    off := secAppend(buf, off, "\""c);
    if (overwrite != 0) {
        off := secAppend(buf, off, ",\"Overwrite\":true"c);
    }
    if (kmsKeyId != 0 as pchar && StrLen(kmsKeyId) > 0) {
        off := secAppend(buf, off, ",\"KeyId\":\""c);
        off := secJsonEscape(kmsKeyId, buf, off);
        off := secAppend(buf, off, "\""c);
    }
    off := secAppend(buf, off, "}"c);
    poke8(buf+off, 0);
    var resp: AWSResponse := ssmSend(client, "AmazonSSM.PutParameter"c, buf, off);
    free(buf, 4096);
    var ok: int64 := 0; if (resp.statusCode == 200) { ok:=1; }
    AWSResponseFree(resp);
    return ok;
}

