pub fn SSMGetParametersByPath(client: SSMClient, path: pchar,
                               recursive: int64, withDecryption: int64): int64 {
    var buf: int64 := alloc(512); var off: int64 := 0;
    off := secAppend(buf, off, "{\"Path\":\""c);
    off := secJsonEscape(path, buf, off);
    off := secAppend(buf, off, "\""c);
    if (recursive != 0) {
        off := secAppend(buf, off, ",\"Recursive\":true"c);
    }
    if (withDecryption != 0) {
        off := secAppend(buf, off, ",\"WithDecryption\":true"c);
    }
    off := secAppend(buf, off, ",\"MaxResults\":50}"c);
    poke8(buf+off, 0);
    var resp: AWSResponse := ssmSend(client, "AmazonSSM.GetParametersByPath"c, buf, off);
    free(buf, 512);
