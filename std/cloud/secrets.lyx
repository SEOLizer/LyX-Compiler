    }
    AWSResponseFree(resp);
    return result;
}

pub fn SSMDescribeParameters(client: SSMClient, filter: pchar): int64 {
    var buf: int64 := alloc(512); var off: int64 := 0;
    poke8(buf,123); off:=1;
    if (filter != 0 as pchar && StrLen(filter) > 0) {
        off := secAppend(buf, off, "\"ParameterFilters\":[{\"Key\":\"Name\",\"Option\":\"Contains\",\"Values\":[\""c);
        off := secJsonEscape(filter, buf, off);
        off := secAppend(buf, off, "\"]}]"c);
    }
    poke8(buf+off,125); off:=off+1;
    poke8(buf+off, 0);
    var resp: AWSResponse := ssmSend(client, "AmazonSSM.DescribeParameters"c, buf, off);
    free(buf, 512);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

pub fn SSMSendCommand(client: SSMClient, instanceId: pchar,
                      documentName: pchar, parameters: pchar): int64 {
    var buf: int64 := alloc(2048); var off: int64 := 0;
    off := secAppend(buf, off, "{\"InstanceIds\":[\""c);
    off := secJsonEscape(instanceId, buf, off);
    off := secAppend(buf, off, "\"],\"DocumentName\":\""c);
    off := secJsonEscape(documentName, buf, off);
    off := secAppend(buf, off, "\""c);
    if (parameters != 0 as pchar && StrLen(parameters) > 0) {
        off := secAppend(buf, off, ",\"Parameters\":"c);
        var pl: int64 := StrLen(parameters);
        var i: int64 := 0; while(i<pl){poke8(buf+off+i,StrCharAt(parameters,i)&0xFF);i:=i+1;} off:=off+pl;
    }
    off := secAppend(buf, off, "}"c);
    poke8(buf+off, 0);
    var resp: AWSResponse := ssmSend(client, "AmazonSSM.SendCommand"c, buf, off);
    free(buf, 2048);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

