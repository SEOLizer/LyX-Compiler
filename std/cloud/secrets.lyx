pub fn SecretsDeleteSecret(client: SecretsClient, secretId: pchar,
                            recoveryWindowDays: int64, forceDelete: int64): int64 {
    var buf: int64 := alloc(256); var off: int64 := 0;
    off := secAppend(buf, off, "{\"SecretId\":\""c);
    off := secJsonEscape(secretId, buf, off);
    off := secAppend(buf, off, "\""c);
    if (forceDelete != 0) {
        off := secAppend(buf, off, ",\"ForceDeleteWithoutRecovery\":true"c);
    } else if (recoveryWindowDays > 0) {
        off := secAppend(buf, off, ",\"RecoveryWindowInDays\":"c);
        var tmp: int64 := alloc(24); Int64ToStr(recoveryWindowDays, tmp as pchar);
        off := secAppend(buf, off, tmp as pchar); free(tmp, 24);
    }
    off := secAppend(buf, off, "}"c);
    poke8(buf+off, 0);
    var resp: AWSResponse := secSend(client, "secretsmanager.DeleteSecret"c, buf, off);
    free(buf, 256);
    var ok: int64 := 0; if (resp.statusCode == 200) { ok:=1; }
    AWSResponseFree(resp);
    return ok;
}

