// std/cloud/secrets.lyx — AWS Secrets Manager + SSM Parameter Store
// WP-AWS-13
// Secrets Manager: JSON protocol; SSM: JSON protocol
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, system.env, system.time])

unit std.cloud.secrets;

import std.cloud.aws.core;
import std.cloud.aws.transport;
import std.alloc;
import std.io;

pub type SecretsClient = struct {
    creds:  AWSCreds;
    region: int64;
    host:   int64;
};

pub type SSMClient = struct {
    creds:  AWSCreds;
    region: int64;
    host:   int64;
};

fn secAppend(buf: int64, off: int64, s: pchar): int64 {
    var n: int64 := StrLen(s); var i: int64 := 0;
    while(i<n){poke8(buf+off+i,StrCharAt(s,i)&0xFF);i:=i+1;}
    return off+n;
}

fn secJsonEscape(s: pchar, buf: int64, off: int64): int64 {
    if (s == 0 as pchar) { return off; }
    var n: int64 := StrLen(s); var i: int64 := 0;
    while (i < n) {
        var c: int64 := StrCharAt(s,i) & 0xFF;
        if (c == 34) { poke8(buf+off,92); poke8(buf+off+1,34); off:=off+2; }
        else if (c == 92) { poke8(buf+off,92); poke8(buf+off+1,92); off:=off+2; }
        else if (c == 10) { poke8(buf+off,92); poke8(buf+off+1,110); off:=off+2; }
        else if (c == 13) { poke8(buf+off,92); poke8(buf+off+1,114); off:=off+2; }
        else if (c == 9)  { poke8(buf+off,92); poke8(buf+off+1,116); off:=off+2; }
        else { poke8(buf+off,c); off:=off+1; }
        i:=i+1;
    }
    return off;
}

fn secSend(client: SecretsClient, target: pchar, body: int64, bodyLen: int64): AWSResponse {
    return AWSJSONRequest(client.creds, client.host as pchar, target,
                          body, bodyLen,
                          client.region as pchar, "secretsmanager"c,
                          "application/x-amz-json-1.1"c);
}

fn ssmSend(client: SSMClient, target: pchar, body: int64, bodyLen: int64): AWSResponse {
    return AWSJSONRequest(client.creds, client.host as pchar, target,
                          body, bodyLen,
                          client.region as pchar, "ssm"c,
                          "application/x-amz-json-1.1"c);
}

pub fn SecretsConnect(creds: AWSCreds, region: pchar): SecretsClient {
    var c: SecretsClient;
    c.creds  := creds;
    c.region := region as int64;
    c.host   := AWSEndpoint("secretsmanager"c, region) as int64;
    return c;
}

pub fn SecretsClose(client: SecretsClient) {
    AWSCredentialsFree(client.creds);
    if (client.host != 0) { free(client.host, StrLen(client.host as pchar)+1); }
}

pub fn SSMConnect(creds: AWSCreds, region: pchar): SSMClient {
    var c: SSMClient;
    c.creds  := creds;
    c.region := region as int64;
    c.host   := AWSEndpoint("ssm"c, region) as int64;
    return c;
}

pub fn SSMClose(client: SSMClient) {
    AWSCredentialsFree(client.creds);
    if (client.host != 0) { free(client.host, StrLen(client.host as pchar)+1); }
}

// ── Secrets Manager ───────────────────────────────────────────────────────────

pub fn SecretsGetValue(client: SecretsClient, secretId: pchar): int64 {
    var buf: int64 := alloc(512); var off: int64 := 0;
    off := secAppend(buf, off, "{\"SecretId\":\""c);
    off := secJsonEscape(secretId, buf, off);
    off := secAppend(buf, off, "\"}"c);
    poke8(buf+off, 0);
    var resp: AWSResponse := secSend(client, "secretsmanager.GetSecretValue"c, buf, off);
    free(buf, 512);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

pub fn SecretsGetValueVersion(client: SecretsClient, secretId: pchar, versionId: pchar): int64 {
    var buf: int64 := alloc(512); var off: int64 := 0;
    off := secAppend(buf, off, "{\"SecretId\":\""c);
    off := secJsonEscape(secretId, buf, off);
    off := secAppend(buf, off, "\""c);
    if (versionId != 0 as pchar && StrLen(versionId) > 0) {
        off := secAppend(buf, off, ",\"VersionId\":\""c);
        off := secJsonEscape(versionId, buf, off);
        off := secAppend(buf, off, "\""c);
    }
    off := secAppend(buf, off, "}"c);
    poke8(buf+off, 0);
    var resp: AWSResponse := secSend(client, "secretsmanager.GetSecretValue"c, buf, off);
    free(buf, 512);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

pub fn SecretsGetString(client: SecretsClient, secretId: pchar): int64 {
    // Returns SecretString value directly (alloc'd pchar) or 0
    var resp: int64 := SecretsGetValue(client, secretId);
    if (resp == 0) { return 0; }
    // Parse "SecretString":"value" from JSON response
    var respLen: int64 := StrLen(resp as pchar);
    var key: pchar := "\"SecretString\":\""c;
    var kl: int64 := StrLen(key);
    var i: int64 := 0;
    while (i < respLen - kl) {
        var isMatch: int64 := 1; var j: int64 := 0;
        while(j<kl){if(peek8(resp+i+j)!=(StrCharAt(key,j)&0xFF)){isMatch:=0;break;}j:=j+1;}
        if (isMatch == 1) {
            var start: int64 := i + kl;
            // Find closing quote (handle escaped quotes)
            var end: int64 := start;
            while (end < respLen) {
                var c: int64 := peek8(resp+end) & 0xFF;
                if (c == 92 && end+1 < respLen) { end:=end+2; continue; } // skip escape
                if (c == 34) { break; }
                end:=end+1;
            }
            var result: int64 := alloc(end-start+1);
            var k: int64 := 0; while(k<end-start){poke8(result+k,peek8(resp+start+k));k:=k+1;}
            poke8(result+end-start,0);
            free(resp, respLen+1);
            return result;
        }
        i:=i+1;
    }
    free(resp, respLen+1);
    return 0;
}

pub fn SecretsCreateSecret(client: SecretsClient, name: pchar,
                            secretString: pchar, desc: pchar, kmsKeyId: pchar): int64 {
    var buf: int64 := alloc(4096); var off: int64 := 0;
    off := secAppend(buf, off, "{\"Name\":\""c);
    off := secJsonEscape(name, buf, off);
    off := secAppend(buf, off, "\",\"SecretString\":\""c);
    off := secJsonEscape(secretString, buf, off);
    off := secAppend(buf, off, "\""c);
    if (desc != 0 as pchar && StrLen(desc) > 0) {
        off := secAppend(buf, off, ",\"Description\":\""c);
        off := secJsonEscape(desc, buf, off);
        off := secAppend(buf, off, "\""c);
    }
    if (kmsKeyId != 0 as pchar && StrLen(kmsKeyId) > 0) {
        off := secAppend(buf, off, ",\"KmsKeyId\":\""c);
        off := secJsonEscape(kmsKeyId, buf, off);
        off := secAppend(buf, off, "\""c);
    }
    off := secAppend(buf, off, "}"c);
    poke8(buf+off, 0);
    var resp: AWSResponse := secSend(client, "secretsmanager.CreateSecret"c, buf, off);
    free(buf, 4096);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

