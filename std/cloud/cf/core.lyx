// Lyx kennt kein `pub use`-Re-Export — die beiden Units sind oben bereits
// importiert. Wer ihre Symbole braucht, importiert sie direkt; ein Re-Export
// würde hier nur so aussehen, als gäbe es ihn.

// Path-building helpers used by all service modules
pub fn cfPathBuild(parts: int64, count: int64): int64 {
    var buf: int64 := alloc(2048);
    var off: int64 := 0;
    var i: int64 := 0;
    while (i < count) {
        var part: pchar := peek64(parts + i * 8) as pchar;
        if (part != 0 as pchar) {
            off := cftAppend(buf, off, "/"c);
            off := cftAppend(buf, off, part);
        }
        i += 1;
    }
    poke8(buf + off, 0);
    return buf;
}

// Build simple JSON body: {"key":"value",...}
pub fn cfJsonBody(keys: int64, vals: int64, count: int64): int64 {
    var buf: int64 := alloc(4096);
    var off: int64 := 0;
    off := cftAppend(buf, off, "{"c);
    var i: int64 := 0;
    while (i < count) {
        if (i > 0) { off := cftAppend(buf, off, ","c); }
        off := cftAppend(buf, off, "\""c);
        off := cftAppend(buf, off, peek64(keys + i * 8) as pchar);
        off := cftAppend(buf, off, "\":\""c);
        off := cftAppend(buf, off, peek64(vals + i * 8) as pchar);
        off := cftAppend(buf, off, "\""c);
        i += 1;
    }
    off := cftAppend(buf, off, "}"c);
    poke8(buf + off, 0);
    return buf;
}

// Escape JSON string (handles ", \, and control chars)
pub fn cfJsonEscape(s: pchar): int64 {
    if (s == 0 as pchar) {
        var empty: int64 := alloc(1); poke8(empty, 0); return empty;
    }
    var sl: int64 := StrLen(s);
    var buf: int64 := alloc(sl * 2 + 1);
    var off: int64 := 0; var i: int64 := 0;
    while (i < sl) {
        var ch: int64 := StrCharAt(s, i) & 0xFF;
        if (ch == 34) { poke8(buf+off,92); off:=off+1; poke8(buf+off,34); off:=off+1; }
        else if (ch == 92) { poke8(buf+off,92); off:=off+1; poke8(buf+off,92); off:=off+1; }
        else if (ch == 10) { poke8(buf+off,92); off:=off+1; poke8(buf+off,110); off:=off+1; }
        else if (ch == 13) { poke8(buf+off,92); off:=off+1; poke8(buf+off,114); off:=off+1; }
        else { poke8(buf+off,ch); off:=off+1; }
        i += 1;
    }
    poke8(buf+off, 0);
    return buf;
}
