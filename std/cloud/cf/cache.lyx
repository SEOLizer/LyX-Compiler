pub fn HeaderRuleCreate(c: CFClient, zoneId: pchar,
                         description: pchar, expression: pchar,
                         reqHeaders: pchar, respHeaders: pchar): int64 {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId);
    po := cftAppend(path, po, "/rulesets/phases/http_request_late_transform/entrypoint/rules"c);
    poke8(path+po, 0);
    var jdesc: int64 := cfJsonEscape(description);
    var jexpr: int64 := cfJsonEscape(expression);
    var body: int64 := alloc(2048);
    var off: int64 := cftAppend(body, 0, "{\"description\":\""c);
    off := cftAppend(body, off, jdesc as pchar);
    off := cftAppend(body, off, "\",\"expression\":\""c);
    off := cftAppend(body, off, jexpr as pchar);
    off := cftAppend(body, off, "\",\"action\":\"rewrite\",\"enabled\":true,\"action_parameters\":{\"headers\":"c);
    if (reqHeaders != 0 as pchar && StrLen(reqHeaders) > 0) {
        off := cftAppend(body, off, reqHeaders as pchar);
    } else {
        off := cftAppend(body, off, "{}"c);
    }
    off := cftAppend(body, off, "}}"c); poke8(body+off, 0);
    free(jdesc, StrLen(jdesc as pchar)+1);
    free(jexpr, StrLen(jexpr as pchar)+1);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 256); free(body, 2048);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

