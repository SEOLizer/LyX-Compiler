pub fn PageRuleRedirect(c: CFClient, zoneId: pchar,
                        fromPattern: pchar, toURL: pchar, statusCode: int64): CFPageRule {
    var jto: int64 := cfJsonEscape(toURL);
    var actions: int64 := alloc(512);
    var ao: int64 := cftAppend(actions, 0, "[{\"id\":\"forwarding_url\",\"value\":{\"url\":\""c);
    ao := cftAppend(actions, ao, jto as pchar);
    ao := cftAppend(actions, ao, "\",\"status_code\":"c);
    ao := cftAppendInt(actions, ao, statusCode);
    ao := cftAppend(actions, ao, "}}]"c); poke8(actions+ao, 0);
    free(jto, StrLen(jto as pchar)+1);
    var pr: CFPageRule := PageRuleCreate(c, zoneId, fromPattern, actions as pchar, ao, 1);
    free(actions, 512); return pr;
}

pub fn PageRuleForceHTTPS(c: CFClient, zoneId: pchar, pattern: pchar): CFPageRule {
    var actions: pchar := "[{\"id\":\"always_use_https\"}]"c;
    return PageRuleCreate(c, zoneId, pattern, actions, StrLen(actions), 1);
}

pub fn PageRuleCacheEverything(c: CFClient, zoneId: pchar, pattern: pchar, ttl: int64): CFPageRule {
    var actions: int64 := alloc(256);
    var ao: int64 := cftAppend(actions, 0, "[{\"id\":\"cache_level\",\"value\":\"cache_everything\"},{\"id\":\"edge_cache_ttl\",\"value\":"c);
    ao := cftAppendInt(actions, ao, ttl);
    ao := cftAppend(actions, ao, "}]"c); poke8(actions+ao, 0);
    var pr: CFPageRule := PageRuleCreate(c, zoneId, pattern, actions as pchar, ao, 1);
    free(actions, 256); return pr;
}

// Transform Rules

pub fn CFTransformRuleFree(tr: CFTransformRule) {
    freeIfSet(tr.id); freeIfSet(tr.description);
    freeIfSet(tr.expression); freeIfSet(tr.action);
    freeIfSet(tr.pathValue); freeIfSet(tr.queryValue);
}

pub fn TransformRuleCreate(c: CFClient, zoneId: pchar,
                            description: pchar, expression: pchar, newPath: pchar): int64 {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId);
    po := cftAppend(path, po, "/rulesets/phases/http_request_transform/entrypoint/rules"c);
    poke8(path+po, 0);
    var jdesc: int64 := cfJsonEscape(description);
    var jexpr: int64 := cfJsonEscape(expression);
    var jpath: int64 := cfJsonEscape(newPath);
    var body: int64 := alloc(1024);
    var off: int64 := cftAppend(body, 0, "{\"description\":\""c);
    off := cftAppend(body, off, jdesc as pchar);
    off := cftAppend(body, off, "\",\"expression\":\""c);
    off := cftAppend(body, off, jexpr as pchar);
    off := cftAppend(body, off, "\",\"action\":\"rewrite\",\"enabled\":true,\"action_parameters\":{\"uri\":{\"path\":{\"type\":\"static\",\"value\":\""c);
    off := cftAppend(body, off, jpath as pchar);
    off := cftAppend(body, off, "\"}}}}"c); poke8(body+off, 0);
    free(jdesc,StrLen(jdesc as pchar)+1);
    free(jexpr,StrLen(jexpr as pchar)+1);
    free(jpath,StrLen(jpath as pchar)+1);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 256); free(body, 1024);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

