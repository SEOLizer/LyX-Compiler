// std/cloud/cf/credentials.lyx — Cloudflare credentials loading
// WP-CF-01
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, system.env, system.time])

unit std.cloud.cf.credentials;

import std.env;

import std.alloc;
import std.io;
import std.fs;

// #1179: Hier stand `extern fn getenv(name: pchar): pchar;` OHNE
// link-Klausel — das Symbol wurde nie gebunden, der Aufruf lieferte still 0,
// und jede Abfrage sah aus wie eine nicht gesetzte Variable. Die Umgebung
// liegt beim Start auf dem Stack; std.env liest sie ohne C-Bibliothek.
fn getenv(name: pchar): pchar { return EnvLookupRaw(name); }

pub con CF_AUTH_TOKEN:   int64 := 1;
pub con CF_AUTH_KEY:     int64 := 2;
pub con CF_AUTH_SERVICE: int64 := 3;

pub type CFCredentials = struct {
    authType:  int64;   // CF_AUTH_TOKEN | CF_AUTH_KEY | CF_AUTH_SERVICE
    token:     int64;   // pchar — Bearer Token or Service Key
    apiKey:    int64;   // pchar — Legacy API-Key
    email:     int64;   // pchar — Legacy Email
    accountId: int64;   // pchar — default account ID
    zoneId:    int64;   // pchar — default zone ID (optional)
};

fn cfsDup(s: pchar): int64 {
    if (s == 0 as pchar) { return 0; }
    var n: int64 := StrLen(s);
    var buf: int64 := alloc(n + 1);
    var i: int64 := 0;
    while (i < n) { poke8(buf + i, StrCharAt(s, i) & 0xFF); i := i + 1; }
    poke8(buf + n, 0);
    return buf;
}

fn cfsDupN(s: int64, n: int64): int64 {
    var buf: int64 := alloc(n + 1);
    var i: int64 := 0;
    while (i < n) { poke8(buf + i, peek8(s + i)); i := i + 1; }
    poke8(buf + n, 0);
    return buf;
}

fn cfsAppend(buf: int64, off: int64, s: pchar): int64 {
    var n: int64 := StrLen(s); var i: int64 := 0;
    while (i < n) { poke8(buf + off + i, StrCharAt(s, i) & 0xFF); i := i + 1; }
    return off + n;
}

fn cfEmptyCreds(): CFCredentials {
    var c: CFCredentials;
    c.authType := 0; c.token := 0; c.apiKey := 0;
    c.email := 0; c.accountId := 0; c.zoneId := 0;
    return c;
}

pub fn CFCredentialsFromToken(token: pchar, accountId: pchar): CFCredentials {
    var c: CFCredentials;
    c.authType  := CF_AUTH_TOKEN;
    c.token     := cfsDup(token);
    c.apiKey    := 0;
    c.email     := 0;
    c.accountId := cfsDup(accountId);
    c.zoneId    := 0;
    return c;
}

pub fn CFCredentialsFromKey(apiKey: pchar, email: pchar, accountId: pchar): CFCredentials {
    var c: CFCredentials;
    c.authType  := CF_AUTH_KEY;
    c.token     := 0;
    c.apiKey    := cfsDup(apiKey);
    c.email     := cfsDup(email);
    c.accountId := cfsDup(accountId);
    c.zoneId    := 0;
    return c;
}

pub fn CFCredentialsFree(c: CFCredentials) {
    if (c.token     != 0) { free(c.token,     StrLen(c.token     as pchar) + 1); }
    if (c.apiKey    != 0) { free(c.apiKey,    StrLen(c.apiKey    as pchar) + 1); }
    if (c.email     != 0) { free(c.email,     StrLen(c.email     as pchar) + 1); }
    if (c.accountId != 0) { free(c.accountId, StrLen(c.accountId as pchar) + 1); }
    if (c.zoneId    != 0) { free(c.zoneId,    StrLen(c.zoneId    as pchar) + 1); }
}

pub fn CFCredentialsFromEnv(): CFCredentials {
    var tok: pchar := getenv("CLOUDFLARE_API_TOKEN"c);
    if (tok != 0 as pchar && StrLen(tok) > 0) {
        var aid: pchar := getenv("CLOUDFLARE_ACCOUNT_ID"c);
        var c: CFCredentials := CFCredentialsFromToken(tok, aid);
        var zid: pchar := getenv("CLOUDFLARE_ZONE_ID"c);
        if (zid != 0 as pchar && StrLen(zid) > 0) { c.zoneId := cfsDup(zid); }
        return c;
    }
    var key: pchar := getenv("CLOUDFLARE_API_KEY"c);
    var email: pchar := getenv("CLOUDFLARE_EMAIL"c);
    if (key != 0 as pchar && StrLen(key) > 0) {
        var aid2: pchar := getenv("CLOUDFLARE_ACCOUNT_ID"c);
        return CFCredentialsFromKey(key, email, aid2);
    }
    return cfEmptyCreds();
}

// Simple JSON field extractor for config file parsing
fn cfsJsonField(json: int64, jsonLen: int64, key: pchar): int64 {
    var kl: int64 := StrLen(key);
    var i: int64 := 0;
    while (i < jsonLen - kl - 3) {
        if ((peek8(json + i) & 0xFF) == 34) {
            var isMatch: int64 := 1; var j: int64 := 0;
            while (j < kl) {
                if ((peek8(json + i + 1 + j) & 0xFF) != (StrCharAt(key, j) & 0xFF)) {
                    isMatch := 0; break;
                }
                j += 1;
            }
            if (isMatch == 1 && (peek8(json + i + 1 + kl) & 0xFF) == 34) {
                var k: int64 := i + kl + 2;
                while (k < jsonLen && (peek8(json + k) & 0xFF) == 32) { k := k + 1; }
                if (k < jsonLen && (peek8(json + k) & 0xFF) == 58) { // ':'
                    k += 1;
                    while (k < jsonLen && (peek8(json + k) & 0xFF) == 32) { k := k + 1; }
                    if (k < jsonLen && (peek8(json + k) & 0xFF) == 34) { // '"'
                        k += 1;
                        var vs: int64 := k;
                        while (k < jsonLen && (peek8(json + k) & 0xFF) != 34) {
                            if ((peek8(json + k) & 0xFF) == 92) { k := k + 1; }
                            k += 1;
                        }
                        return cfsDupN(json + vs, k - vs);
                    }
                }
            }
        }
        i += 1;
    }
    return 0;
}

pub fn CFConfigLoad(path: pchar): CFCredentials {
    var c: CFCredentials := cfEmptyCreds();
    var sz: int64 := FileSize(path);
    if (sz <= 0) { return c; }
    var buf: int64 := alloc(sz + 1);
    ReadFile(path, buf as pchar, sz);
    poke8(buf + sz, 0);

    var tok: int64 := cfsJsonField(buf, sz, "token"c);
    var aid: int64 := cfsJsonField(buf, sz, "account_id"c);
    var zid: int64 := cfsJsonField(buf, sz, "default_zone"c);
    free(buf, sz + 1);

    if (tok != 0) {
        c.authType  := CF_AUTH_TOKEN;
        c.token     := tok;
        c.accountId := aid;
        c.zoneId    := zid;
    }
    return c;
}

pub fn CFConfigSave(c: CFCredentials, path: pchar): int64 {
    var buf: int64 := alloc(2048);
    var off: int64 := 0;
    off := cfsAppend(buf, off, "{"c);
    off := cfsAppend(buf, off, "\"token\":\""c);
    if (c.token != 0) { off := cfsAppend(buf, off, c.token as pchar); }
    off := cfsAppend(buf, off, "\","c);
    off := cfsAppend(buf, off, "\"account_id\":\""c);
    if (c.accountId != 0) { off := cfsAppend(buf, off, c.accountId as pchar); }
    off := cfsAppend(buf, off, "\","c);
    off := cfsAppend(buf, off, "\"default_zone\":\""c);
    if (c.zoneId != 0) { off := cfsAppend(buf, off, c.zoneId as pchar); }
    off := cfsAppend(buf, off, "\"}"c);
    poke8(buf + off, 10); off := off + 1;
    poke8(buf + off, 0);
    WriteFile(path, buf as pchar, off);
    free(buf, 2048);
    return 1;
}

pub fn CFCredentialsDefault(): CFCredentials {
    // 1. Environment vars
    var c: CFCredentials := CFCredentialsFromEnv();
    if (c.authType != 0) { return c; }
    // 2. Config file ~/.config/lyxcf/config.json
    var home: pchar := getenv("HOME"c);
    if (home != 0 as pchar) {
        var pbuf: int64 := alloc(512);
        var po: int64 := cfsAppend(pbuf, 0, home);
        po := cfsAppend(pbuf, po, "/.config/lyxcf/config.json"c);
        poke8(pbuf + po, 0);
        c := CFConfigLoad(pbuf as pchar);
        free(pbuf, 512);
        if (c.authType != 0) { return c; }
    }
    return c;
}
