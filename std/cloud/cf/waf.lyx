// Quick firewall helpers

pub fn FirewallBlockIP(c: CFClient, zoneId: pchar, ip: pchar, note: pchar): CFFirewallRule {
    var expr: int64 := alloc(256);
    var eo: int64 := cftAppend(expr, 0, "(ip.src eq "c);
    eo := cftAppend(expr, eo, ip);
    eo := cftAppend(expr, eo, ")"c); poke8(expr+eo, 0);
    var rule: CFFirewallRule := FirewallRuleCreate(c, zoneId, note, expr as pchar, "block"c, 100, 1);
    free(expr, 256); return rule;
}

pub fn FirewallBlockCountry(c: CFClient, zoneId: pchar,
                             countryCodes: int64, count: int64, note: pchar): CFFirewallRule {
    var expr: int64 := alloc(count * 8 + 64);
    var eo: int64 := cftAppend(expr, 0, "(ip.src.country in {"c);
    var i: int64 := 0;
    while (i < count) {
        if (i > 0) { eo := cftAppend(expr, eo, " "c); }
        var code: pchar := peek64(countryCodes + i * 8) as pchar;
        eo := cftAppend(expr, eo, "\""c);
        eo := cftAppend(expr, eo, code);
        eo := cftAppend(expr, eo, "\""c);
        i += 1;
    }
    eo := cftAppend(expr, eo, "})"c); poke8(expr+eo, 0);
    var rule: CFFirewallRule := FirewallRuleCreate(c, zoneId, note, expr as pchar, "block"c, 100, 1);
    free(expr, count*8+64); return rule;
}

pub fn FirewallAllowIP(c: CFClient, zoneId: pchar, ip: pchar, note: pchar): CFFirewallRule {
    var expr: int64 := alloc(256);
    var eo: int64 := cftAppend(expr, 0, "(ip.src eq "c);
    eo := cftAppend(expr, eo, ip);
    eo := cftAppend(expr, eo, ")"c); poke8(expr+eo, 0);
    var rule: CFFirewallRule := FirewallRuleCreate(c, zoneId, note, expr as pchar, "allow"c, 50, 1);
    free(expr, 256); return rule;
}

pub fn FirewallChallengePath(c: CFClient, zoneId: pchar, pathPrefix: pchar, note: pchar): CFFirewallRule {
    var jp: int64 := cfJsonEscape(pathPrefix);
    var expr: int64 := alloc(512);
    var eo: int64 := cftAppend(expr, 0, "(http.request.uri.path contains \""c);
    eo := cftAppend(expr, eo, jp as pchar);
    eo := cftAppend(expr, eo, "\")"c); poke8(expr+eo, 0);
    free(jp, StrLen(jp as pchar)+1);
    var rule: CFFirewallRule := FirewallRuleCreate(c, zoneId, note, expr as pchar, "challenge"c, 100, 1);
    free(expr, 512); return rule;
}

