pub con CF_IP_RULE_WHITELIST:    int64 := "whitelist"c as int64;
pub con CF_IP_RULE_BLOCK:        int64 := "block"c as int64;
pub con CF_IP_RULE_CHALLENGE:    int64 := "challenge"c as int64;
pub con CF_IP_RULE_JS_CHALLENGE: int64 := "js_challenge"c as int64;

pub type CFFirewallRule = struct {
    id:          int64;  // pchar
    description: int64;  // pchar
    expression:  int64;  // pchar — Wirefilter expression
    action:      int64;  // pchar: "block","challenge","js_challenge","managed_challenge","allow","log"
    enabled:     int64;
    priority:    int64;
    paused:      int64;
};

pub type CFIPAccessRule = struct {
    id:       int64;  // pchar
    mode:     int64;  // pchar
    notes:    int64;  // pchar
    target:   int64;  // pchar: "ip","ip_range","country","asn"
    value:    int64;  // pchar
    scope:    int64;  // pchar: "zone","account"
    created:  int64;  // pchar
};

pub type CFRateLimit = struct {
    id:          int64;  // pchar
    description: int64;  // pchar
    urlPattern:  int64;  // pchar
    threshold:   int64;
    period:      int64;
    action:      int64;  // pchar: "simulate","ban","challenge"
    timeout:     int64;  // ban duration seconds
    enabled:     int64;
};

fn wafFreeIfSet(p: int64) {
    if (p != 0) { free(p, StrLen(p as pchar)+1); }
}

pub fn CFFirewallRuleFree(r: CFFirewallRule) {
    wafFreeIfSet(r.id); wafFreeIfSet(r.description);
    wafFreeIfSet(r.expression); wafFreeIfSet(r.action);
}

pub fn CFIPAccessRuleFree(r: CFIPAccessRule) {
    wafFreeIfSet(r.id); wafFreeIfSet(r.mode); wafFreeIfSet(r.notes);
    wafFreeIfSet(r.target); wafFreeIfSet(r.value); wafFreeIfSet(r.scope);
    wafFreeIfSet(r.created);
}

pub fn CFRateLimitFree(r: CFRateLimit) {
    wafFreeIfSet(r.id); wafFreeIfSet(r.description);
    wafFreeIfSet(r.urlPattern); wafFreeIfSet(r.action);
}

fn parseFirewallRule(json: int64, jl: int64): CFFirewallRule {
    var r: CFFirewallRule;
    r.id          := cfExtractValue(json, jl, "id"c);
    r.description := cfExtractValue(json, jl, "description"c);
    r.expression  := cfExtractValue(json, jl, "expression"c);
    r.action      := cfExtractValue(json, jl, "action"c);
    r.enabled     := cfExtractBool(json, jl, "enabled"c);
    r.priority    := cfExtractInt(json, jl, "priority"c);
    r.paused      := cfExtractBool(json, jl, "paused"c);
    return r;
}

fn parseIPRule(json: int64, jl: int64): CFIPAccessRule {
    var r: CFIPAccessRule;
    r.id      := cfExtractValue(json, jl, "id"c);
    r.mode    := cfExtractValue(json, jl, "mode"c);
    r.notes   := cfExtractValue(json, jl, "notes"c);
    r.created := cfExtractValue(json, jl, "created_on"c);
    // configuration is nested
    var cfg: int64 := cfExtractValue(json, jl, "configuration"c);
    if (cfg != 0) {
        var cl: int64 := StrLen(cfg as pchar);
        r.target := cfExtractValue(cfg, cl, "target"c);
        r.value  := cfExtractValue(cfg, cl, "value"c);
        free(cfg, cl+1);
    }
    return r;
}

// Firewall Custom Rules (Ruleset API)

fn fwRulesPath(zoneId: pchar): int64 {
    var buf: int64 := alloc(512);
    var off: int64 := cftAppend(buf, 0, "/zones/"c);
    off := cftAppend(buf, off, zoneId);
    off := cftAppend(buf, off, "/rulesets/phases/http_request_firewall_custom/entrypoint/rules"c);
    poke8(buf+off, 0); return buf;
}

pub fn FirewallRuleCreate(c: CFClient, zoneId: pchar,
                          description: pchar, expression: pchar, action: pchar,
                          priority: int64, enabled: int64): CFFirewallRule {
    var path: int64 := fwRulesPath(zoneId);
    var jdesc: int64 := cfJsonEscape(description);
    var jexpr: int64 := cfJsonEscape(expression);
    var jact:  int64 := cfJsonEscape(action);
    var body: int64 := alloc(1024);
    var off: int64 := cftAppend(body, 0, "{\"description\":\""c);
    off := cftAppend(body, off, jdesc as pchar);
    off := cftAppend(body, off, "\",\"expression\":\""c);
    off := cftAppend(body, off, jexpr as pchar);
    off := cftAppend(body, off, "\",\"action\":\""c);
    off := cftAppend(body, off, jact as pchar);
    off := cftAppend(body, off, "\",\"enabled\":"c);
    if (enabled==1){off:=cftAppend(body,off,"true"c);}else{off:=cftAppend(body,off,"false"c);}
    if (priority > 0) {
        off := cftAppend(body, off, ",\"priority\":"c);
        off := cftAppendInt(body, off, priority);
    }
    off := cftAppend(body, off, "}"c); poke8(body+off, 0);
    free(jdesc,StrLen(jdesc as pchar)+1);
    free(jexpr,StrLen(jexpr as pchar)+1);
    free(jact,StrLen(jact as pchar)+1);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 512); free(body, 1024);
    var rule: CFFirewallRule;
    rule.id:=0; rule.description:=0; rule.expression:=0; rule.action:=0;
    rule.enabled:=0; rule.priority:=0; rule.paused:=0;
    if (r.success == 1 && r.result != 0) { rule := parseFirewallRule(r.result, r.resultLen); }
    CFResponseFree(r); return rule;
}

