// Rate Limiting

pub fn RateLimitCreate(c: CFClient, zoneId: pchar,
                       urlPattern: pchar, threshold: int64,
                       period: int64, action: pchar, timeout: int64): CFRateLimit {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId);
    po := cftAppend(path, po, "/rate_limits"c); poke8(path+po, 0);
    var jurl:    int64 := cfJsonEscape(urlPattern);
    var jaction: int64 := cfJsonEscape(action);
    var body: int64 := alloc(512);
    var off: int64 := cftAppend(body, 0, "{\"match\":{\"request\":{\"url_pattern\":\""c);
    off := cftAppend(body, off, jurl as pchar);
    off := cftAppend(body, off, "\",\"methods\":[\"_ALL_\"]}},\"threshold\":"c);
    off := cftAppendInt(body, off, threshold);
    off := cftAppend(body, off, ",\"period\":"c);
    off := cftAppendInt(body, off, period);
    off := cftAppend(body, off, ",\"action\":{\"mode\":\""c);
    off := cftAppend(body, off, jaction as pchar);
    off := cftAppend(body, off, "\",\"timeout\":"c);
    off := cftAppendInt(body, off, timeout);
    off := cftAppend(body, off, "},\"enabled\":true}"c); poke8(body+off, 0);
    free(jurl,StrLen(jurl as pchar)+1);
    free(jaction,StrLen(jaction as pchar)+1);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 256); free(body, 512);
    var rl: CFRateLimit;
    rl.id:=0; rl.description:=0; rl.urlPattern:=0;
    rl.threshold:=0; rl.period:=0; rl.action:=0; rl.timeout:=0; rl.enabled:=0;
    if (r.success == 1 && r.result != 0) {
        rl.id         := cfExtractValue(r.result, r.resultLen, "id"c);
        rl.threshold  := cfExtractInt(r.result, r.resultLen, "threshold"c);
        rl.period     := cfExtractInt(r.result, r.resultLen, "period"c);
        rl.enabled    := cfExtractBool(r.result, r.resultLen, "enabled"c);
    }
    CFResponseFree(r); return rl;
}

