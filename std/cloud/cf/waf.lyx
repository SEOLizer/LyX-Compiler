pub fn IPRuleCreate(c: CFClient, zoneId: pchar,
                    mode: pchar, target: pchar, value: pchar, notes: pchar): CFIPAccessRule {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId);
    po := cftAppend(path, po, "/firewall/access_rules/rules"c); poke8(path+po, 0);
    var jmode:  int64 := cfJsonEscape(mode);
    var jtarget:int64 := cfJsonEscape(target);
    var jvalue: int64 := cfJsonEscape(value);
    var jnotes: int64 := cfJsonEscape(notes);
    var body: int64 := alloc(512);
    var off: int64 := cftAppend(body, 0, "{\"mode\":\""c);
    off := cftAppend(body, off, jmode as pchar);
    off := cftAppend(body, off, "\",\"configuration\":{\"target\":\""c);
    off := cftAppend(body, off, jtarget as pchar);
    off := cftAppend(body, off, "\",\"value\":\""c);
    off := cftAppend(body, off, jvalue as pchar);
    off := cftAppend(body, off, "\"},\"notes\":\""c);
    off := cftAppend(body, off, jnotes as pchar);
    off := cftAppend(body, off, "\"}"c); poke8(body+off, 0);
    free(jmode,StrLen(jmode as pchar)+1);
    free(jtarget,StrLen(jtarget as pchar)+1);
    free(jvalue,StrLen(jvalue as pchar)+1);
    free(jnotes,StrLen(jnotes as pchar)+1);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 256); free(body, 512);
    var rule: CFIPAccessRule;
    rule.id:=0; rule.mode:=0; rule.notes:=0;
    rule.target:=0; rule.value:=0; rule.scope:=0; rule.created:=0;
    if (r.success == 1 && r.result != 0) { rule := parseIPRule(r.result, r.resultLen); }
    CFResponseFree(r); return rule;
}

