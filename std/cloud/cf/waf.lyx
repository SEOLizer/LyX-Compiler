fn wafGroupSetMode(c: CFClient, zoneId: pchar, packageId: pchar, groupId: pchar, mode: pchar): int64 {
    var path: int64 := alloc(512);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId);
    po := cftAppend(path, po, "/firewall/waf/packages/"c);
    po := cftAppend(path, po, packageId);
    po := cftAppend(path, po, "/groups/"c);
    po := cftAppend(path, po, groupId); poke8(path+po, 0);
    var jm: int64 := cfJsonEscape(mode);
    var body: int64 := alloc(64);
    var off: int64 := cftAppend(body, 0, "{\"mode\":\""c);
    off := cftAppend(body, off, jm as pchar);
    off := cftAppend(body, off, "\"}"c); poke8(body+off, 0);
    free(jm, StrLen(jm as pchar)+1);
    var r: CFResponse := CFPatch(c, path as pchar, body, off);
    free(path, 512); free(body, 64);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

