    po := cftAppend(path, po, bucket); poke8(path+po, 0);
    var r: CFResponse := CFDelete(c, path as pchar);
    free(path, 256);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

pub fn R2BucketList(creds: CFCredentials, accountId: pchar): int64 {
    var c: CFClient := CFClientNew(creds);
