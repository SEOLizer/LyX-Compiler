// R2 Access Key management

pub fn R2AccessKeyCreate(creds: CFCredentials, accountId: pchar,
                          name: pchar, permissions: pchar): int64 {
    var c: CFClient := CFClientNew(creds);
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/r2/tokens"c); poke8(path+po, 0);
    var jname: int64 := cfJsonEscape(name);
    var body: int64 := alloc(512);
    var off: int64 := cftAppend(body, 0, "{\"name\":\""c);
    off := cftAppend(body, off, jname as pchar);
    off := cftAppend(body, off, "\",\"policies\":"c);
    if (permissions != 0 as pchar && StrLen(permissions) > 0) {
        off := cftAppend(body, off, permissions);
    } else {
        off := cftAppend(body, off, "[{\"effect\":\"allow\",\"resources\":{\"com.cloudflare.edge.r2.bucket.*\":\"*\"},\"permission_groups\":[{\"id\":\"2efd5506f9c8494dacb1fa10a43e7b92\",\"name\":\"Workers R2 Storage Write\"}]}]"c);
    }
    off := cftAppend(body, off, "}"c); poke8(body+off, 0);
    free(jname, StrLen(jname as pchar)+1);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 256); free(body, 512);
    var result: int64 := 0;
    if (r.success == 1 && r.result != 0) { result = cftDupN(r.result, r.resultLen); }
    CFResponseFree(r); return result;
}

