// Public access

pub fn R2BucketEnablePublic(creds: CFCredentials, accountId: pchar, bucket: pchar): int64 {
    var c: CFClient := CFClientNew(creds);
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/r2/buckets/"c);
    po := cftAppend(path, po, bucket);
    po := cftAppend(path, po, "/domains/managed"c); poke8(path+po, 0);
    var body: pchar := "{\"enabled\":true}"c;
    var r: CFResponse := CFPut(c, path as pchar, body as int64, StrLen(body));
    free(path, 256);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

pub fn R2PublicURL(accountId: pchar, bucket: pchar, key: pchar): int64 {
    // Returns "https://pub-<hash>.r2.dev/<key>" — hash is account/bucket specific
    // Without knowing the actual hash, we construct a placeholder
    var buf: int64 := alloc(1024);
    var off: int64 := cftAppend(buf, 0, "https://"c);
    off := cftAppend(buf, off, accountId);
    off := cftAppend(buf, off, "."c);
    off := cftAppend(buf, off, bucket);
    off := cftAppend(buf, off, ".r2.dev/"c);
    off := cftAppend(buf, off, key);
    poke8(buf+off, 0); return buf;
}

pub fn R2CustomDomainAdd(creds: CFCredentials, accountId: pchar,
                          bucket: pchar, domain: pchar, zoneId: pchar): int64 {
    var c: CFClient := CFClientNew(creds);
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/r2/buckets/"c);
    po := cftAppend(path, po, bucket);
    po := cftAppend(path, po, "/domains/custom"c); poke8(path+po, 0);
    var jd: int64 := cfJsonEscape(domain);
    var jz: int64 := cfJsonEscape(zoneId);
    var body: int64 := alloc(256);
    var off: int64 := cftAppend(body, 0, "{\"domain\":\""c);
    off := cftAppend(body, off, jd as pchar);
    off := cftAppend(body, off, "\",\"zone_id\":\""c);
    off := cftAppend(body, off, jz as pchar);
    off := cftAppend(body, off, "\",\"enabled\":true}"c); poke8(body+off, 0);
    free(jd, StrLen(jd as pchar)+1); free(jz, StrLen(jz as pchar)+1);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 256); free(body, 256);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

pub fn R2CustomDomainList(creds: CFCredentials, accountId: pchar, bucket: pchar): int64 {
    var c: CFClient := CFClientNew(creds);
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/r2/buckets/"c);
    po := cftAppend(path, po, bucket);
    po := cftAppend(path, po, "/domains/custom"c); poke8(path+po, 0);
    var r: CFResponse := CFGet(c, path as pchar);
    free(path, 256);
    var result: int64 := 0;
    if (r.success == 1 && r.result != 0) { result = cftDupN(r.result, r.resultLen); }
    CFResponseFree(r); return result;
}

pub fn R2CustomDomainRemove(creds: CFCredentials, accountId: pchar,
                             bucket: pchar, domain: pchar): int64 {
    var c: CFClient := CFClientNew(creds);
    var path: int64 := alloc(512);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
