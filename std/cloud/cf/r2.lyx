// #1179: Hier stand `extern fn getenv(name: pchar): pchar;` OHNE
// link-Klausel — das Symbol wurde nie gebunden, der Aufruf lieferte still 0,
// und jede Abfrage sah aus wie eine nicht gesetzte Variable. Die Umgebung
// liegt beim Start auf dem Stack; std.env liest sie ohne C-Bibliothek.
fn getenv(name: pchar): pchar { return EnvLookupRaw(name); }

pub type R2Conn = struct {
    s3:        int64;   // S3Client (by value, stored as 32 bytes)
    accountId: int64;   // pchar
};

// Connect R2 via S3-compatible endpoint using R2 access keys
pub fn R2Connect(creds: CFCredentials, accountId: pchar): R2Conn {
    var r2AccessKey: pchar := getenv("R2_ACCESS_KEY_ID"c);
    var r2SecretKey: pchar := getenv("R2_SECRET_ACCESS_KEY"c);

    // Build endpoint: <accountId>.r2.cloudflarestorage.com
    var endpointBuf: int64 := alloc(256);
    var eo: int64 := cftAppend(endpointBuf, 0, accountId);
    eo := cftAppend(endpointBuf, eo, ".r2.cloudflarestorage.com"c);
    poke8(endpointBuf + eo, 0);

    // #1264: Beide Aufrufe hatten zu viele Argumente — `AWSCredentialsStatic`
    // nimmt Schluessel und Geheimnis (vier wurden uebergeben), und
    // `S3ConnectConfig` nimmt Zugangsdaten und eine KONFIGURATION, nicht vier
    // Einzelwerte. Uebersetzt hat es trotzdem, weil die Signaturpruefung an
    // der Unit-Grenze endete; die ueberzaehligen Werte fielen weg und die
    // fehlenden kamen vom Stack. R2 war damit nie erreichbar.
    var awsCreds: AWSCreds := AWSCredentialsStatic(r2AccessKey, r2SecretKey);
    var r2Cfg: AWSServiceConfig := AWSServiceConfigDefault("auto"c);
    r2Cfg.endpoint := endpointBuf;
    var s3Client: S3Client := S3ConnectConfig(awsCreds, r2Cfg);
    free(endpointBuf, 256);

    var conn: R2Conn;
    conn.s3        := s3Client as int64;
    conn.accountId := cftDup(accountId);
    return conn;
}

pub fn R2Disconnect(c: R2Conn) {
    var s3: S3Client := c.s3 as S3Client;
    S3Close(s3);
    if (c.accountId != 0) { free(c.accountId, StrLen(c.accountId as pchar)+1); }
}

// Bucket management via CF API

pub fn R2BucketCreate(creds: CFCredentials, accountId: pchar,
                       bucket: pchar, location: pchar): int64 {
    var c: CFClient := CFClientNew(creds);
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/r2/buckets"c); poke8(path+po, 0);
    var jb: int64 := cfJsonEscape(bucket);
    var body: int64 := alloc(256);
    var off: int64 := cftAppend(body, 0, "{\"name\":\""c);
    off := cftAppend(body, off, jb as pchar);
    off := cftAppend(body, off, "\""c);
    if (location != 0 as pchar && StrLen(location) > 0) {
        var jl: int64 := cfJsonEscape(location);
        off := cftAppend(body, off, ",\"locationHint\":\""c);
        off := cftAppend(body, off, jl as pchar);
        off := cftAppend(body, off, "\""c);
        free(jl, StrLen(jl as pchar)+1);
    }
    off := cftAppend(body, off, "}"c); poke8(body+off, 0);
    free(jb, StrLen(jb as pchar)+1);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 256); free(body, 256);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

pub fn R2BucketDelete(creds: CFCredentials, accountId: pchar, bucket: pchar): int64 {
    var c: CFClient := CFClientNew(creds);
    var path: int64 := alloc(256);
