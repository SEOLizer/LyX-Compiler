// Object operations via S3 API

pub fn R2Upload(c: R2Conn, bucket: pchar, key: pchar, data: int64, dataLen: int64): int64 {
    var s3: S3Client := c.s3 as S3Client;
    var ok: int64 := S3PutObject(s3, bucket, key, data, dataLen, "application/octet-stream"c);
    if (ok == 0) { return 1; }
    return 0;
}

pub fn R2Download(c: R2Conn, bucket: pchar, key: pchar): int64 {
    var s3: S3Client := c.s3 as S3Client;
    return S3GetObject(s3, bucket, key);
}

pub fn R2Delete(c: R2Conn, bucket: pchar, key: pchar): int64 {
    var s3: S3Client := c.s3 as S3Client;
    return S3DeleteObject(s3, bucket, key);
}

pub fn R2Exists(c: R2Conn, bucket: pchar, key: pchar): int64 {
    var s3: S3Client := c.s3 as S3Client;
    return S3ObjectExists(s3, bucket, key);
}

pub fn R2List(c: R2Conn, bucket: pchar, prefix: pchar): int64 {
    var s3: S3Client := c.s3 as S3Client;
    // #1264: `S3ListObjects` nimmt zusaetzlich die Obergrenze der Schluessel.
    // Sie fehlte; der vierte Wert kam vom Stack. 1000 ist die Vorgabe des
    // Dienstes fuer eine Seite.
    return S3ListObjects(s3, bucket, prefix, 1000);
}

pub fn R2GetMeta(c: R2Conn, bucket: pchar, key: pchar): int64 {
    var s3: S3Client := c.s3 as S3Client;
    var obj: S3Object := S3HeadObject(s3, bucket, key);
    // Return JSON of metadata
    if (obj.key == 0) { return 0; }
    var buf: int64 := alloc(512);
    var off: int64 := cftAppend(buf, 0, "{\"key\":\""c);
    if (obj.key != 0) { off := cftAppend(buf, off, obj.key as pchar); }
    off := cftAppend(buf, off, "\",\"size\":"c);
    off := cftAppendInt(buf, off, obj.size);
    off := cftAppend(buf, off, ",\"etag\":\""c);
    if (obj.etag != 0) { off := cftAppend(buf, off, obj.etag as pchar); }
    off := cftAppend(buf, off, "\",\"lastModified\":\""c);
    if (obj.lastModified != 0) { off := cftAppend(buf, off, obj.lastModified as pchar); }
    off := cftAppend(buf, off, "\"}"c); poke8(buf+off, 0);
    if (obj.key != 0) { free(obj.key, StrLen(obj.key as pchar)+1); }
    if (obj.etag != 0) { free(obj.etag, StrLen(obj.etag as pchar)+1); }
    if (obj.lastModified != 0) { free(obj.lastModified, StrLen(obj.lastModified as pchar)+1); }
    if (obj.storageClass != 0) { free(obj.storageClass, StrLen(obj.storageClass as pchar)+1); }
    return buf;
}

pub fn R2Copy(c: R2Conn, srcBucket: pchar, srcKey: pchar, dstBucket: pchar, dstKey: pchar): int64 {
    var s3: S3Client := c.s3 as S3Client;
    return S3CopyObject(s3, srcBucket, srcKey, dstBucket, dstKey);
}

