fn workerSubdomainToggle(c: CFClient, accountId: pchar, scriptName: pchar, enabled: int64): int64 {
    var path: int64 := workerPath(accountId, scriptName);
    var p2: int64 := alloc(StrLen(path as pchar) + 32);
    var po: int64 := cftAppend(p2, 0, path as pchar);
    po := cftAppend(p2, po, "/subdomain"c); poke8(p2+po, 0);
    free(path, 512);
    var body: int64 := alloc(32);
    var off: int64 := cftAppend(body, 0, "{\"enabled\":"c);
    if (enabled==1){off:=cftAppend(body,off,"true"c);}else{off:=cftAppend(body,off,"false"c);}
    off := cftAppend(body, off, "}"c); poke8(body+off, 0);
    var r: CFResponse := CFPost(c, p2 as pchar, body, off);
    free(p2, StrLen(path as pchar)+32); free(body, 32);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

pub fn WorkerEnableSubdomain(c: CFClient, accountId: pchar, scriptName: pchar): int64 {
    return workerSubdomainToggle(c, accountId, scriptName, 1);
}
pub fn WorkerDisableSubdomain(c: CFClient, accountId: pchar, scriptName: pchar): int64 {
    return workerSubdomainToggle(c, accountId, scriptName, 0);
}

// Secrets

pub fn WorkerSecretSet(c: CFClient, accountId: pchar,
                        scriptName: pchar, key: pchar, value: pchar): int64 {
    var path: int64 := workerPath(accountId, scriptName);
    var p2: int64 := alloc(StrLen(path as pchar) + 32);
    var po: int64 := cftAppend(p2, 0, path as pchar);
    po := cftAppend(p2, po, "/secrets"c); poke8(p2+po, 0);
    free(path, 512);
    var jkey: int64 := cfJsonEscape(key);
    var jval: int64 := cfJsonEscape(value);
    var body: int64 := alloc(512);
    var off: int64 := cftAppend(body, 0, "{\"name\":\""c);
    off := cftAppend(body, off, jkey as pchar);
    off := cftAppend(body, off, "\",\"text\":\""c);
    off := cftAppend(body, off, jval as pchar);
    off := cftAppend(body, off, "\",\"type\":\"secret_text\"}"c); poke8(body+off, 0);
    wkFreeIfSet(jkey); wkFreeIfSet(jval);
    var r: CFResponse := CFPut(c, p2 as pchar, body, off);
    free(p2, StrLen(p2 as pchar)+1); free(body, 512);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

pub fn WorkerSecretDelete(c: CFClient, accountId: pchar, scriptName: pchar, key: pchar): int64 {
    var path: int64 := workerPath(accountId, scriptName);
    var pl: int64 := StrLen(path as pchar);
    var p2: int64 := alloc(pl + 64);
    var po: int64 := cftAppend(p2, 0, path as pchar);
    po := cftAppend(p2, po, "/secrets/"c);
    po := cftAppend(p2, po, key); poke8(p2+po, 0);
    free(path, 512);
    var r: CFResponse := CFDelete(c, p2 as pchar);
    free(p2, pl+64);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

pub fn WorkerSecretList(c: CFClient, accountId: pchar, scriptName: pchar): int64 {
    var path: int64 := workerPath(accountId, scriptName);
