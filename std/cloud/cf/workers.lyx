// Wasm module upload (multipart)

pub fn WorkerDeployWasm(c: CFClient, accountId: pchar,
                         scriptName: pchar,
                         jsScript: int64, jsLen: int64,
                         wasmModule: int64, wasmLen: int64): int64 {
    var path: int64 := workerPath(accountId, scriptName);
    var boundary: pchar := "lyxcf-wasm-boundary"c;
    var body: int64 := alloc(jsLen + wasmLen + 1024);
    var off: int64 := cftAppend(body, 0, "--"c);
    off := cftAppend(body, off, boundary);
    off := cftAppend(body, off, "\r\nContent-Disposition: form-data; name=\"metadata\"\r\nContent-Type: application/json\r\n\r\n"c);
    off := cftAppend(body, off, "{\"main_module\":\"main.js\",\"bindings\":[{\"type\":\"wasm_module\",\"name\":\"WASM\",\"part\":\"worker.wasm\"}]}"c);
    off := cftAppend(body, off, "\r\n--"c);
    off := cftAppend(body, off, boundary);
    off := cftAppend(body, off, "\r\nContent-Disposition: form-data; name=\"main.js\"; filename=\"main.js\"\r\nContent-Type: application/javascript+module\r\n\r\n"c);
    off := cftAppendN(body, off, jsScript, jsLen);
    off := cftAppend(body, off, "\r\n--"c);
    off := cftAppend(body, off, boundary);
    off := cftAppend(body, off, "\r\nContent-Disposition: form-data; name=\"worker.wasm\"; filename=\"worker.wasm\"\r\nContent-Type: application/wasm\r\n\r\n"c);
    off := cftAppendN(body, off, wasmModule, wasmLen);
    off := cftAppend(body, off, "\r\n--"c);
    off := cftAppend(body, off, boundary);
    off := cftAppend(body, off, "--\r\n"c); poke8(body+off, 0);
    var ctBuf: int64 := alloc(128);
    var cto: int64 := cftAppend(ctBuf, 0, "multipart/form-data; boundary="c);
    cto := cftAppend(ctBuf, cto, boundary); poke8(ctBuf+cto, 0);
    var r: CFResponse := CFPutRaw(c, path as pchar, ctBuf as pchar, body, off);
    free(path, 512); free(body, jsLen+wasmLen+1024); free(ctBuf, 128);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}
