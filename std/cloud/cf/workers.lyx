pub fn WorkerSubdomainCreate(c: CFClient, accountId: pchar, subdomain: pchar): int64 {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/workers/subdomain"c); poke8(path+po, 0);
    var js: int64 := cfJsonEscape(subdomain);
    var body: int64 := alloc(256);
    var off: int64 := cftAppend(body, 0, "{\"subdomain\":\""c);
