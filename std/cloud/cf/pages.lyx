@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, system.env, system.time])

unit std.cloud.cf.pages;

import std.cloud.cf.transport;
import std.cloud.cf.core;
import std.alloc;
import std.io;

pub type CFPagesProject = struct {
    id:           int64;  // pchar
    name:         int64;  // pchar
    subdomain:    int64;  // pchar
    productionBranch: int64; // pchar
    buildCmd:     int64;  // pchar
    rootDir:      int64;  // pchar
    distDir:      int64;  // pchar
    created:      int64;  // pchar
    deployHookUrl: int64; // pchar
};

pub type CFPagesDeployment = struct {
    id:            int64;  // pchar
    shortId:       int64;  // pchar
    projectId:     int64;  // pchar
    projectName:   int64;  // pchar
    environment:   int64;  // pchar
    url:           int64;  // pchar
    latestStage:   int64;  // pchar
    created:       int64;  // pchar
    modified:      int64;  // pchar
};

fn pgFreeIfSet(p: int64) {
    if (p != 0) { free(p, StrLen(p as pchar)+1); }
}

pub fn CFPagesProjectFree(p: CFPagesProject) {
    pgFreeIfSet(p.id); pgFreeIfSet(p.name); pgFreeIfSet(p.subdomain);
    pgFreeIfSet(p.productionBranch); pgFreeIfSet(p.buildCmd);
    pgFreeIfSet(p.rootDir); pgFreeIfSet(p.distDir);
    pgFreeIfSet(p.created); pgFreeIfSet(p.deployHookUrl);
}

pub fn CFPagesDeploymentFree(d: CFPagesDeployment) {
    pgFreeIfSet(d.id); pgFreeIfSet(d.shortId); pgFreeIfSet(d.projectId);
    pgFreeIfSet(d.projectName); pgFreeIfSet(d.environment);
    pgFreeIfSet(d.url); pgFreeIfSet(d.latestStage);
    pgFreeIfSet(d.created); pgFreeIfSet(d.modified);
}

fn parsePagesProject(json: int64, jl: int64): CFPagesProject {
    var p: CFPagesProject;
    p.id              := cfExtractValue(json, jl, "id"c);
    p.name            := cfExtractValue(json, jl, "name"c);
    p.subdomain       := cfExtractValue(json, jl, "subdomain"c);
    p.productionBranch := cfExtractValue(json, jl, "production_branch"c);
    p.buildCmd        := cfExtractValue(json, jl, "build_command"c);
    p.rootDir         := cfExtractValue(json, jl, "root_dir"c);
    p.distDir         := cfExtractValue(json, jl, "destination_dir"c);
    p.created         := cfExtractValue(json, jl, "created_on"c);
    p.deployHookUrl   := cfExtractValue(json, jl, "deploy_hook_url"c);
    return p;
}

fn parsePagesDeployment(json: int64, jl: int64): CFPagesDeployment {
    var d: CFPagesDeployment;
    d.id          := cfExtractValue(json, jl, "id"c);
    d.shortId     := cfExtractValue(json, jl, "short_id"c);
    d.projectId   := cfExtractValue(json, jl, "project_id"c);
    d.projectName := cfExtractValue(json, jl, "project_name"c);
    d.environment := cfExtractValue(json, jl, "environment"c);
    d.url         := cfExtractValue(json, jl, "url"c);
    d.created     := cfExtractValue(json, jl, "created_on"c);
    d.modified    := cfExtractValue(json, jl, "modified_on"c);
    // Latest stage name from stages array first element
    var stages: int64 := cfExtractValue(json, jl, "latest_stage"c);
    if (stages != 0) {
        var sl: int64 := StrLen(stages as pchar);
        d.latestStage := cfExtractValue(stages, sl, "name"c);
        free(stages, sl+1);
    } else { d.latestStage := 0; }
    return d;
}

fn pagesPath(accountId: pchar, rest: pchar): int64 {
    var buf: int64 := alloc(512);
    var off: int64 := cftAppend(buf, 0, "/accounts/"c);
    off := cftAppend(buf, off, accountId);
    off := cftAppend(buf, off, "/pages/projects"c);
    if (rest != 0 as pchar) { off := cftAppend(buf, off, rest); }
    poke8(buf+off, 0); return buf;
}

fn pagesProjectPath(accountId: pchar, projectName: pchar, rest: pchar): int64 {
    var buf: int64 := alloc(512);
    var off: int64 := cftAppend(buf, 0, "/accounts/"c);
    off := cftAppend(buf, off, accountId);
    off := cftAppend(buf, off, "/pages/projects/"c);
    off := cftAppend(buf, off, projectName);
    if (rest != 0 as pchar) { off := cftAppend(buf, off, rest); }
    poke8(buf+off, 0); return buf;
}

fn pagesDeployPath(accountId: pchar, projectName: pchar,
                   deployId: pchar, rest: pchar): int64 {
    var buf: int64 := alloc(512);
    var off: int64 := cftAppend(buf, 0, "/accounts/"c);
    off := cftAppend(buf, off, accountId);
    off := cftAppend(buf, off, "/pages/projects/"c);
    off := cftAppend(buf, off, projectName);
    off := cftAppend(buf, off, "/deployments"c);
    if (deployId != 0 as pchar) {
        off := cftAppend(buf, off, "/"c);
        off := cftAppend(buf, off, deployId);
    }
    if (rest != 0 as pchar) { off := cftAppend(buf, off, rest); }
    poke8(buf+off, 0); return buf;
}

// Project management

pub fn PagesProjectCreate(c: CFClient, accountId: pchar, name: pchar,
                          productionBranch: pchar, buildCmd: pchar,
                          rootDir: pchar, distDir: pchar): CFPagesProject {
    var path: int64 := pagesPath(accountId, 0 as pchar);
    var jname: int64 := cfJsonEscape(name);
    var body: int64 := alloc(1024);
    var off: int64 := cftAppend(body, 0, "{\"name\":\""c);
    off := cftAppend(body, off, jname as pchar);
    off := cftAppend(body, off, "\",\"production_branch\":\""c);
    var jbranch: int64 := cfJsonEscape(productionBranch);
    off := cftAppend(body, off, jbranch as pchar);
    off := cftAppend(body, off, "\",\"build_config\":{"c);
    if (buildCmd != 0 as pchar) {
        var jcmd: int64 := cfJsonEscape(buildCmd);
        off := cftAppend(body, off, "\"build_command\":\""c);
        off := cftAppend(body, off, jcmd as pchar);
        off := cftAppend(body, off, "\""c);
        pgFreeIfSet(jcmd);
        if (distDir != 0 as pchar) {
            var jdist: int64 := cfJsonEscape(distDir);
            off := cftAppend(body, off, ",\"destination_dir\":\""c);
            off := cftAppend(body, off, jdist as pchar);
            off := cftAppend(body, off, "\""c);
            pgFreeIfSet(jdist);
        }
        if (rootDir != 0 as pchar) {
            var jroot: int64 := cfJsonEscape(rootDir);
            off := cftAppend(body, off, ",\"root_dir\":\""c);
            off := cftAppend(body, off, jroot as pchar);
            off := cftAppend(body, off, "\""c);
            pgFreeIfSet(jroot);
        }
    }
    off := cftAppend(body, off, "}}"c); poke8(body+off, 0);
    pgFreeIfSet(jname); pgFreeIfSet(jbranch);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 512); free(body, 1024);
    var proj: CFPagesProject;
    proj.id:=0; proj.name:=0; proj.subdomain:=0; proj.productionBranch:=0;
    proj.buildCmd:=0; proj.rootDir:=0; proj.distDir:=0; proj.created:=0; proj.deployHookUrl:=0;
    if (r.success == 1 && r.result != 0) { proj := parsePagesProject(r.result, r.resultLen); }
    CFResponseFree(r); return proj;
}

pub fn PagesProjectDelete(c: CFClient, accountId: pchar, projectName: pchar): int64 {
    var path: int64 := pagesProjectPath(accountId, projectName, 0 as pchar);
    var r: CFResponse := CFDelete(c, path as pchar);
    free(path, 512);
    var ok: int64 := r.success; CFResponseFree(r); return ok;
}

