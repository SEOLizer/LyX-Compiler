// Custom domain management

pub fn PagesDomainAdd(c: CFClient, accountId: pchar, projectName: pchar,
                      domain: pchar): int64 {
    var path: int64 := pagesProjectPath(accountId, projectName, "/domains"c);
    var jd: int64 := cfJsonEscape(domain);
    var body: int64 := alloc(256);
    var off: int64 := cftAppend(body, 0, "{\"name\":\""c);
    off := cftAppend(body, off, jd as pchar);
    off := cftAppend(body, off, "\"}"c); poke8(body+off, 0);
    pgFreeIfSet(jd);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 512); free(body, 256);
    var ok: int64 := r.success; CFResponseFree(r); return ok;
}

pub fn PagesDomainDelete(c: CFClient, accountId: pchar, projectName: pchar,
                         domain: pchar): int64 {
    var path: int64 := alloc(512);
    var po: int64 := cftAppend(path, 0, "/accounts/"c);
    po := cftAppend(path, po, accountId);
    po := cftAppend(path, po, "/pages/projects/"c);
    po := cftAppend(path, po, projectName);
    po := cftAppend(path, po, "/domains/"c);
    po := cftAppend(path, po, domain); poke8(path+po, 0);
    var r: CFResponse := CFDelete(c, path as pchar);
    free(path, 512);
    var ok: int64 := r.success; CFResponseFree(r); return ok;
}

pub fn PagesDomainList(c: CFClient, accountId: pchar, projectName: pchar): int64 {
    var path: int64 := pagesProjectPath(accountId, projectName, "/domains"c);
    var r: CFResponse := CFGet(c, path as pchar);
    free(path, 512);
    var result: int64 := 0;
    if (r.result != 0) { result := cftDupN(r.result, r.resultLen); }
    CFResponseFree(r); return result;
}

// Environment variable management

pub fn PagesEnvSet(c: CFClient, accountId: pchar, projectName: pchar,
                   envKey: pchar, envValue: pchar, isSecret: int64,
                   environment: pchar): int64 {
    var path: int64 := pagesProjectPath(accountId, projectName, 0 as pchar);
    var jk: int64 := cfJsonEscape(envKey);
    var jv: int64 := cfJsonEscape(envValue);
    var jenv: int64 := cfJsonEscape(environment);
    var typeStr: pchar := "plain_text"c;
    if (isSecret == 1) { typeStr := "secret_text"c; }
    var body: int64 := alloc(1024);
    var off: int64 := cftAppend(body, 0, "{\"deployment_configs\":{\""c);
    off := cftAppend(body, off, jenv as pchar);
    off := cftAppend(body, off, "\":{\"env_vars\":{\""c);
    off := cftAppend(body, off, jk as pchar);
    off := cftAppend(body, off, "\":{\"value\":\""c);
    off := cftAppend(body, off, jv as pchar);
    off := cftAppend(body, off, "\",\"type\":\""c);
    off := cftAppend(body, off, typeStr);
    off := cftAppend(body, off, "\"}}}}}"c); poke8(body+off, 0);
    pgFreeIfSet(jk); pgFreeIfSet(jv); pgFreeIfSet(jenv);
    var r: CFResponse := CFPatch(c, path as pchar, body, off);
    free(path, 512); free(body, 1024);
    var ok: int64 := r.success; CFResponseFree(r); return ok;
}

pub fn PagesEnvDelete(c: CFClient, accountId: pchar, projectName: pchar,
                      envKey: pchar, environment: pchar): int64 {
    var path: int64 := pagesProjectPath(accountId, projectName, 0 as pchar);
    var jk: int64 := cfJsonEscape(envKey);
    var jenv: int64 := cfJsonEscape(environment);
    var body: int64 := alloc(512);
    var off: int64 := cftAppend(body, 0, "{\"deployment_configs\":{\""c);
    off := cftAppend(body, off, jenv as pchar);
    off := cftAppend(body, off, "\":{\"env_vars\":{\""c);
    off := cftAppend(body, off, jk as pchar);
    off := cftAppend(body, off, "\":null}}}}"c); poke8(body+off, 0);
    pgFreeIfSet(jk); pgFreeIfSet(jenv);
    var r: CFResponse := CFPatch(c, path as pchar, body, off);
    free(path, 512); free(body, 512);
    var ok: int64 := r.success; CFResponseFree(r); return ok;
}

pub fn PagesEnvList(c: CFClient, accountId: pchar, projectName: pchar): int64 {
    var proj: CFPagesProject := PagesProjectGet(c, accountId, projectName);
    // Return project JSON so caller can inspect deployment_configs.env_vars
    if (proj.name == 0) { return 0; }
    var path: int64 := pagesProjectPath(accountId, projectName, 0 as pchar);
    var r: CFResponse := CFGet(c, path as pchar);
    free(path, 512);
    var result: int64 := 0;
    if (r.result != 0) { result := cftDupN(r.result, r.resultLen); }
    CFResponseFree(r);
    CFPagesProjectFree(proj);
    return result;
}
