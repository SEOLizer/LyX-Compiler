pub fn PagesProjectUpdate(c: CFClient, accountId: pchar, projectName: pchar,
                          body: int64, bodyLen: int64): CFPagesProject {
    var path: int64 := pagesProjectPath(accountId, projectName, 0 as pchar);
    var r: CFResponse := CFPatch(c, path as pchar, body, bodyLen);
    free(path, 512);
    var proj: CFPagesProject;
    proj.id:=0; proj.name:=0; proj.subdomain:=0; proj.productionBranch:=0;
    proj.buildCmd:=0; proj.rootDir:=0; proj.distDir:=0; proj.created:=0; proj.deployHookUrl:=0;
    if (r.success == 1 && r.result != 0) { proj := parsePagesProject(r.result, r.resultLen); }
    CFResponseFree(r); return proj;
}

// Deploy from URL / branch

pub fn PagesDeploy(c: CFClient, accountId: pchar, projectName: pchar,
                   branch: pchar): CFPagesDeployment {
    var path: int64 := pagesDeployPath(accountId, projectName, 0 as pchar, 0 as pchar);
    var body: int64 := alloc(256);
    var off: int64 := 0;
    if (branch != 0 as pchar) {
        var jb: int64 := cfJsonEscape(branch);
        off := cftAppend(body, 0, "{\"branch\":\""c);
        off := cftAppend(body, off, jb as pchar);
        off := cftAppend(body, off, "\"}"c);
        pgFreeIfSet(jb);
    } else {
        off := cftAppend(body, 0, "{}"c);
    }
    poke8(body+off, 0);
    var r: CFResponse := CFPost(c, path as pchar, body, off);
    free(path, 512); free(body, 256);
    var dep: CFPagesDeployment;
    dep.id:=0; dep.shortId:=0; dep.projectId:=0; dep.projectName:=0;
    dep.environment:=0; dep.url:=0; dep.latestStage:=0; dep.created:=0; dep.modified:=0;
    if (r.success == 1 && r.result != 0) { dep := parsePagesDeployment(r.result, r.resultLen); }
    CFResponseFree(r); return dep;
}

pub fn PagesDeployDir(c: CFClient, accountId: pchar, projectName: pchar,
                      localDir: pchar, branch: pchar): CFPagesDeployment {
    // Direct Upload — builds multipart from directory listing
    // This is a simplified implementation that sends a placeholder bundle
    // Real implementation would recursively read files and multipart encode
    var path: int64 := pagesDeployPath(accountId, projectName, 0 as pchar, 0 as pchar);
    var boundary: pchar := "LyxPagesBoundary12345"c;
    var body: int64 := alloc(1024);
    var off: int64 := cftAppend(body, 0, "--"c);
    off := cftAppend(body, off, boundary);
    off := cftAppend(body, off, "\r\nContent-Disposition: form-data; name=\"branch\"\r\n\r\n"c);
    if (branch != 0 as pchar) { off := cftAppend(body, off, branch); }
    else { off := cftAppend(body, off, "main"c); }
    off := cftAppend(body, off, "\r\n--"c);
    off := cftAppend(body, off, boundary);
    off := cftAppend(body, off, "--\r\n"c); poke8(body+off, 0);
    var ct: int64 := alloc(128);
    var cto: int64 := cftAppend(ct, 0, "multipart/form-data; boundary="c);
    cto := cftAppend(ct, cto, boundary); poke8(ct+cto, 0);
    var r: CFResponse := CFPutRaw(c, path as pchar, ct as pchar, body, off);
    free(body, 1024); free(ct, 128); free(path, 512);
    var dep: CFPagesDeployment;
    dep.id:=0; dep.shortId:=0; dep.projectId:=0; dep.projectName:=0;
    dep.environment:=0; dep.url:=0; dep.latestStage:=0; dep.created:=0; dep.modified:=0;
    if (r.success == 1 && r.result != 0) { dep := parsePagesDeployment(r.result, r.resultLen); }
    CFResponseFree(r); return dep;
}

