unit std.cloud.cf.zones;

import std.cloud.cf.transport;
import std.cloud.cf.core;
import std.alloc;
import std.io;

pub type CFZone = struct {
    id:          int64;  // pchar
    name:        int64;  // pchar
    status:      int64;  // pchar: "active","pending","initializing","moved","deleted"
    paused:      int64;  // 0/1
    zoneType:    int64;  // pchar: "full","partial","secondary"
    plan:        int64;  // pchar: "free","pro","business","enterprise"
    nameServers: int64;  // pchar (comma-separated)
    accountId:   int64;  // pchar
    accountName: int64;  // pchar
    created:     int64;  // pchar
};

pub type CFSetting = struct {
    id:         int64;  // pchar
    value:      int64;  // pchar (JSON value)
    modifiable: int64;
    modified:   int64;  // pchar
};

fn czDup(s: pchar): int64 { return cftDup(s); }
fn czDupN(s: int64, n: int64): int64 { return cftDupN(s, n); }

fn czExtract(json: int64, jl: int64, key: pchar): int64 {
    return cfExtractValue(json, jl, key);
}
fn czExtractBool(json: int64, jl: int64, key: pchar): int64 {
    return cfExtractBool(json, jl, key);
}

fn czEmptyZone(): CFZone {
    var z: CFZone;
    z.id:=0; z.name:=0; z.status:=0; z.paused:=0;
    z.zoneType:=0; z.plan:=0; z.nameServers:=0;
    z.accountId:=0; z.accountName:=0; z.created:=0;
    return z;
}

pub fn CFZoneFree(z: CFZone) {
    if (z.id          != 0) { free(z.id,          StrLen(z.id          as pchar)+1); }
    if (z.name        != 0) { free(z.name,         StrLen(z.name        as pchar)+1); }
    if (z.status      != 0) { free(z.status,       StrLen(z.status      as pchar)+1); }
    if (z.zoneType    != 0) { free(z.zoneType,     StrLen(z.zoneType    as pchar)+1); }
    if (z.plan        != 0) { free(z.plan,         StrLen(z.plan        as pchar)+1); }
    if (z.nameServers != 0) { free(z.nameServers,  StrLen(z.nameServers as pchar)+1); }
    if (z.accountId   != 0) { free(z.accountId,    StrLen(z.accountId   as pchar)+1); }
    if (z.accountName != 0) { free(z.accountName,  StrLen(z.accountName as pchar)+1); }
    if (z.created     != 0) { free(z.created,      StrLen(z.created     as pchar)+1); }
}

fn parseZone(json: int64, jl: int64): CFZone {
    var z: CFZone := czEmptyZone();
    z.id          := czExtract(json, jl, "id"c);
    z.name        := czExtract(json, jl, "name"c);
    z.status      := czExtract(json, jl, "status"c);
    z.paused      := czExtractBool(json, jl, "paused"c);
    z.zoneType    := czExtract(json, jl, "type"c);
    z.plan        := czExtract(json, jl, "plan"c);
    z.accountId   := czExtract(json, jl, "account"c);  // simplified
    z.created     := czExtract(json, jl, "created_on"c);
    return z;
}

// Zone CRUD

pub fn ZoneCreate(c: CFClient, domain: pchar, accountId: pchar, zoneType: pchar): CFZone {
    var zt: pchar := zoneType;
    if (zt == 0 as pchar || StrLen(zt) == 0) { zt := "full"c; }
    var jt: int64 := cfJsonEscape(zt);
    var jd: int64 := cfJsonEscape(domain);
    var ja: int64 := cfJsonEscape(accountId);
    var body: int64 := alloc(512);
    var off: int64 := 0;
    off := cftAppend(body, off, "{\"name\":\""c);
    off := cftAppend(body, off, jd as pchar);
    off := cftAppend(body, off, "\",\"account\":{\"id\":\""c);
    off := cftAppend(body, off, ja as pchar);
    off := cftAppend(body, off, "\"},\"jump_start\":true,\"type\":\""c);
    off := cftAppend(body, off, jt as pchar);
    off := cftAppend(body, off, "\"}"c);
    poke8(body+off,0);
    free(jt, StrLen(jt as pchar)+1);
    free(jd, StrLen(jd as pchar)+1);
    free(ja, StrLen(ja as pchar)+1);
    var r: CFResponse := CFPost(c, "/zones"c, body, off);
    free(body, 512);
    var z: CFZone := czEmptyZone();
    if (r.success == 1 && r.result != 0) {
        z := parseZone(r.result, r.resultLen);
    }
    CFResponseFree(r);
    return z;
}

pub fn ZoneDelete(c: CFClient, zoneId: pchar): int64 {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId); poke8(path+po, 0);
    var r: CFResponse := CFDelete(c, path as pchar);
    free(path, 256);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

pub fn ZoneGet(c: CFClient, zoneId: pchar): CFZone {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId); poke8(path+po, 0);
    var r: CFResponse := CFGet(c, path as pchar);
    free(path, 256);
    var z: CFZone := czEmptyZone();
    if (r.success == 1 && r.result != 0) { z := parseZone(r.result, r.resultLen); }
    CFResponseFree(r); return z;
}

pub fn ZoneGetByDomain(c: CFClient, domain: pchar): CFZone {
    var path: int64 := alloc(512);
    var po: int64 := cftAppend(path, 0, "/zones?name="c);
    po := cftAppend(path, po, domain); poke8(path+po, 0);
    var r: CFResponse := CFGet(c, path as pchar);
    free(path, 512);
    var z: CFZone := czEmptyZone();
    if (r.success == 1 && r.result != 0) {
        // result is an array, take first element
        var rl: int64 := r.resultLen;
        if (rl > 2 && (peek8(r.result) & 0xFF) == 91) { // '['
            // Find first '{' inside the array
            var j: int64 := 1;
            while (j < rl && (peek8(r.result+j) & 0xFF) != 123) { j := j+1; } // '{'
            if (j < rl) {
                var depth: int64 := 0; var k: int64 := j;
                while (k < rl) {
                    var ch: int64 := peek8(r.result+k) & 0xFF;
                    if (ch==123) { depth:=depth+1; }
                    if (ch==125) { depth:=depth-1; if (depth==0) { k:=k+1; break; } }
                    k:=k+1;
                }
                var objLen: int64 := k-j;
                var obj: int64 := cftDupN(r.result+j, objLen);
                z := parseZone(obj, objLen);
                free(obj, objLen+1);
            }
        }
    }
    CFResponseFree(r); return z;
}

pub fn ZoneList(c: CFClient): int64 {
    return CFGetAll(c, "/zones"c, 100);
}

pub fn ZoneListAccount(c: CFClient, accountId: pchar): int64 {
    var path: int64 := alloc(512);
    var po: int64 := cftAppend(path, 0, "/zones?account.id="c);
    po := cftAppend(path, po, accountId); poke8(path+po, 0);
    var result: int64 := CFGetAll(c, path as pchar, 100);
    free(path, 512); return result;
}

pub fn ZonePause(c: CFClient, zoneId: pchar): int64 {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId); poke8(path+po, 0);
    var body: pchar := "{\"paused\":true}"c;
    var r: CFResponse := CFPatch(c, path as pchar, body as int64, StrLen(body));
    free(path, 256);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

pub fn ZoneUnpause(c: CFClient, zoneId: pchar): int64 {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId); poke8(path+po, 0);
    var body: pchar := "{\"paused\":false}"c;
    var r: CFResponse := CFPatch(c, path as pchar, body as int64, StrLen(body));
    free(path, 256);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

pub fn ZoneActivationCheck(c: CFClient, zoneId: pchar): int64 {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId);
    po := cftAppend(path, po, "/activation_check"c); poke8(path+po, 0);
    var empty: pchar := "{}"c;
    var r: CFResponse := CFPut(c, path as pchar, empty as int64, StrLen(empty));
    free(path, 256);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

// Zone settings

pub fn ZoneSettingGet(c: CFClient, zoneId: pchar, setting: pchar): CFSetting {
    var path: int64 := alloc(512);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId);
    po := cftAppend(path, po, "/settings/"c);
    po := cftAppend(path, po, setting); poke8(path+po, 0);
    var r: CFResponse := CFGet(c, path as pchar);
    free(path, 512);
    var s: CFSetting;
    s.id := 0; s.value := 0; s.modifiable := 0; s.modified := 0;
    if (r.success == 1 && r.result != 0) {
        var rl: int64 := r.resultLen;
        s.id         := cfExtractValue(r.result, rl, "id"c);
        s.value      := cfExtractValue(r.result, rl, "value"c);
        s.modifiable := cfExtractBool(r.result, rl, "editable"c);
        s.modified   := cfExtractValue(r.result, rl, "modified_on"c);
    }
    CFResponseFree(r); return s;
}

pub fn ZoneSettingSet(c: CFClient, zoneId: pchar, setting: pchar, value: pchar): int64 {
    var path: int64 := alloc(512);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId);
    po := cftAppend(path, po, "/settings/"c);
    po := cftAppend(path, po, setting); poke8(path+po, 0);
    var jv: int64 := cfJsonEscape(value);
    var body: int64 := alloc(512);
    var bo: int64 := cftAppend(body, 0, "{\"value\":\""c);
    bo := cftAppend(body, bo, jv as pchar);
    bo := cftAppend(body, bo, "\"}"c); poke8(body+bo, 0);
    free(jv, StrLen(jv as pchar)+1);
    var r: CFResponse := CFPatch(c, path as pchar, body, bo);
    free(path, 512); free(body, 512);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

pub fn ZoneSettingsGetAll(c: CFClient, zoneId: pchar): int64 {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId);
    po := cftAppend(path, po, "/settings"c); poke8(path+po, 0);
    var r: CFResponse := CFGet(c, path as pchar);
    free(path, 256);
    var result: int64 := 0;
    if (r.success == 1 && r.result != 0) {
        result := cftDupN(r.result, r.resultLen);
    }
    CFResponseFree(r); return result;
}

pub fn ZoneSettingsSetBulk(c: CFClient, zoneId: pchar, itemsJson: pchar, itemsLen: int64): int64 {
    var path: int64 := alloc(256);
    var po: int64 := cftAppend(path, 0, "/zones/"c);
    po := cftAppend(path, po, zoneId);
    po := cftAppend(path, po, "/settings"c); poke8(path+po, 0);
    var body: int64 := alloc(itemsLen + 64);
    var bo: int64 := cftAppend(body, 0, "{\"items\":"c);
    bo := cftAppendN(body, bo, itemsJson as int64, itemsLen);
    bo := cftAppend(body, bo, "}"c); poke8(body+bo, 0);
    var r: CFResponse := CFPatch(c, path as pchar, body, bo);
    free(path, 256); free(body, itemsLen+64);
    var ok: int64 := r.success;
    CFResponseFree(r); return ok;
}

// Convenience setting functions

fn zoneSetOnOff(c: CFClient, zoneId: pchar, setting: pchar, enabled: int64): int64 {
    if (enabled == 1) { return ZoneSettingSet(c, zoneId, setting, "on"c); }
    return ZoneSettingSet(c, zoneId, setting, "off"c);
}

pub fn ZoneSetSSL(c: CFClient, zoneId: pchar, mode: pchar): int64 {
    return ZoneSettingSet(c, zoneId, "ssl"c, mode);
}
pub fn ZoneSetHTTPS(c: CFClient, zoneId: pchar, enabled: int64): int64 {
    return zoneSetOnOff(c, zoneId, "always_use_https"c, enabled);
}
pub fn ZoneSetMinTLS(c: CFClient, zoneId: pchar, version: pchar): int64 {
    return ZoneSettingSet(c, zoneId, "min_tls_version"c, version);
}
pub fn ZoneSetCacheTTL(c: CFClient, zoneId: pchar, ttl: int64): int64 {
    var vs: int64 := alloc(24);
    Int64ToStr(ttl, vs as pchar);
    var r: int64 := ZoneSettingSet(c, zoneId, "browser_cache_ttl"c, vs as pchar);
    free(vs, 24); return r;
}
