    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

// ── Event Source Mappings ─────────────────────────────────────────────────────

pub fn LambdaCreateEventSourceMapping(client: LambdaClient,
                                       functionName: pchar, eventSourceArn: pchar,
                                       batchSize: int64): int64 {
    var buf: int64 := alloc(512); var boff: int64 := 0;
    boff := lambdaAppend(buf, boff, "{\"FunctionName\":\""c);
    boff := lambdaJsonEscape(functionName, buf, boff);
    boff := lambdaAppend(buf, boff, "\",\"EventSourceArn\":\""c);
    boff := lambdaJsonEscape(eventSourceArn, buf, boff);
    boff := lambdaAppend(buf, boff, "\",\"BatchSize\":"c);
    var tmp: int64 := alloc(24); Int64ToStr(batchSize, tmp as pchar);
    boff := lambdaAppend(buf, boff, tmp as pchar);
    free(tmp, 24);
    boff := lambdaAppend(buf, boff, ",\"StartingPosition\":\"TRIM_HORIZON\"}"c);
    poke8(buf+boff, 0);
    var resp: AWSResponse := lambdaSend(client, "POST"c, "/2015-03-31/event-source-mappings"c,
                                        0 as pchar, buf, boff);
    free(buf, 512);
    var result: int64 := 0;
    if ((resp.statusCode == 200 || resp.statusCode == 202) && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

pub fn LambdaListEventSourceMappings(client: LambdaClient, functionName: pchar): int64 {
    var queryBuf: int64 := alloc(256); var off: int64 := 0;
    if (functionName != 0 as pchar && StrLen(functionName) > 0) {
        off := lambdaAppend(queryBuf, off, "FunctionName="c);
        off := lambdaAppend(queryBuf, off, functionName);
    }
    poke8(queryBuf+off, 0);
    // Lyx hat keinen if-Ausdruck — Argument vorher bestimmen.
    var qArg: pchar := 0 as pchar;
    if (off > 0) { qArg := queryBuf as pchar; }
    var resp: AWSResponse := lambdaSend(client, "GET"c, "/2015-03-31/event-source-mappings"c,
                                        qArg, 0, 0);
    free(queryBuf, 256);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}
