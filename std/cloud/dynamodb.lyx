// ── Item operations ───────────────────────────────────────────────────────────

pub fn DDBPutItem(client: DDBClient, tableName: pchar, item: DDBItem): int64 {
    var itemBuf: int64 := alloc(8192);
    ddbItemToJson(item, itemBuf);
    var buf: int64 := alloc(512 + StrLen(itemBuf as pchar));
    var off: int64 := ddbAppend(buf, 0, "{\"TableName\":\""c);
    off := ddbJsonEscape(tableName, buf, off);
    off := ddbAppend(buf, off, "\",\"Item\":"c);
    var il: int64 := StrLen(itemBuf as pchar);
    var i: int64 := 0; while(i<il){poke8(buf+off+i,peek8(itemBuf+i));i:=i+1;} off:=off+il;
    off := ddbAppend(buf, off, "}"c);
    poke8(buf+off, 0);
    free(itemBuf, 8192);
    var resp: AWSResponse := ddbSend(client, "DynamoDB_20120810.PutItem"c, buf, off);
    free(buf, 512 + il);
    var ok: int64 := 0; if (resp.statusCode == 200) { ok:=1; }
    AWSResponseFree(resp);
    return ok;
}

pub fn DDBGetItem(client: DDBClient, tableName: pchar,
                  keyName: pchar, keyType: pchar, keyVal: pchar): int64 {
    var keyBuf: int64 := alloc(512);
    ddbKeyJson(keyName, keyType, keyVal, keyBuf);
    var buf: int64 := alloc(256 + StrLen(keyBuf as pchar));
    var off: int64 := ddbAppend(buf, 0, "{\"TableName\":\""c);
    off := ddbJsonEscape(tableName, buf, off);
    off := ddbAppend(buf, off, "\",\"Key\":"c);
    var kl: int64 := StrLen(keyBuf as pchar);
    var i: int64 := 0; while(i<kl){poke8(buf+off+i,peek8(keyBuf+i));i:=i+1;} off:=off+kl;
    off := ddbAppend(buf, off, "}"c);
    poke8(buf+off, 0);
    free(keyBuf, 512);
    var resp: AWSResponse := ddbSend(client, "DynamoDB_20120810.GetItem"c, buf, off);
    free(buf, 256 + kl);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

