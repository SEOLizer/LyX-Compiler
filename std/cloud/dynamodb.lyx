pub fn DDBQuery(client: DDBClient, tableName: pchar,
                keyCondition: pchar, exprNames: pchar, exprVals: pchar,
                limit: int64): int64 {
    var buf: int64 := alloc(4096); var off: int64 := 0;
    off := ddbAppend(buf, off, "{\"TableName\":\""c);
    off := ddbJsonEscape(tableName, buf, off);
    off := ddbAppend(buf, off, "\",\"KeyConditionExpression\":\""c);
    off := ddbJsonEscape(keyCondition, buf, off);
    off := ddbAppendChar(buf, off, 34);
    if (exprNames != 0 as pchar && StrLen(exprNames) > 0) {
        off := ddbAppend(buf, off, ",\"ExpressionAttributeNames\":"c);
        var nl: int64 := StrLen(exprNames);
        var i: int64 := 0; while(i<nl){poke8(buf+off+i,StrCharAt(exprNames,i)&0xFF);i:=i+1;} off:=off+nl;
    }
    if (exprVals != 0 as pchar && StrLen(exprVals) > 0) {
        off := ddbAppend(buf, off, ",\"ExpressionAttributeValues\":"c);
        var vl: int64 := StrLen(exprVals);
        var i: int64 := 0; while(i<vl){poke8(buf+off+i,StrCharAt(exprVals,i)&0xFF);i:=i+1;} off:=off+vl;
    }
    if (limit > 0) {
        off := ddbAppend(buf, off, ",\"Limit\":"c);
        var tmp: int64 := alloc(24); Int64ToStr(limit, tmp as pchar);
        off := ddbAppend(buf, off, tmp as pchar);
        free(tmp, 24);
    }
    off := ddbAppend(buf, off, "}"c);
    poke8(buf+off, 0);
    var resp: AWSResponse := ddbSend(client, "DynamoDB_20120810.Query"c, buf, off);
    free(buf, 4096);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

pub fn DDBScan(client: DDBClient, tableName: pchar,
               filterExpr: pchar, exprVals: pchar, limit: int64): int64 {
    var buf: int64 := alloc(4096); var off: int64 := 0;
    off := ddbAppend(buf, off, "{\"TableName\":\""c);
    off := ddbJsonEscape(tableName, buf, off);
    off := ddbAppendChar(buf, off, 34);
    if (filterExpr != 0 as pchar && StrLen(filterExpr) > 0) {
        off := ddbAppend(buf, off, ",\"FilterExpression\":\""c);
        off := ddbJsonEscape(filterExpr, buf, off);
        off := ddbAppendChar(buf, off, 34);
    }
    if (exprVals != 0 as pchar && StrLen(exprVals) > 0) {
        off := ddbAppend(buf, off, ",\"ExpressionAttributeValues\":"c);
        var vl: int64 := StrLen(exprVals);
        var i: int64 := 0; while(i<vl){poke8(buf+off+i,StrCharAt(exprVals,i)&0xFF);i:=i+1;} off:=off+vl;
    }
    if (limit > 0) {
        off := ddbAppend(buf, off, ",\"Limit\":"c);
        var tmp: int64 := alloc(24); Int64ToStr(limit, tmp as pchar);
        off := ddbAppend(buf, off, tmp as pchar);
        free(tmp, 24);
    }
    off := ddbAppend(buf, off, "}"c);
    poke8(buf+off, 0);
    var resp: AWSResponse := ddbSend(client, "DynamoDB_20120810.Scan"c, buf, off);
    free(buf, 4096);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

pub fn DDBUpdateItem(client: DDBClient, tableName: pchar,
                     keyName: pchar, keyType: pchar, keyVal: pchar,
                     updateExpr: pchar, exprVals: pchar): int64 {
    var keyBuf: int64 := alloc(512);
    ddbKeyJson(keyName, keyType, keyVal, keyBuf);
    var buf: int64 := alloc(2048); var off: int64 := 0;
    off := ddbAppend(buf, off, "{\"TableName\":\""c);
    off := ddbJsonEscape(tableName, buf, off);
    off := ddbAppend(buf, off, "\",\"Key\":"c);
    var kl: int64 := StrLen(keyBuf as pchar);
    var i: int64 := 0; while(i<kl){poke8(buf+off+i,peek8(keyBuf+i));i:=i+1;} off:=off+kl;
    off := ddbAppend(buf, off, ",\"UpdateExpression\":\""c);
    off := ddbJsonEscape(updateExpr, buf, off);
    off := ddbAppendChar(buf, off, 34);
    if (exprVals != 0 as pchar && StrLen(exprVals) > 0) {
        off := ddbAppend(buf, off, ",\"ExpressionAttributeValues\":"c);
        var vl: int64 := StrLen(exprVals);
        i:=0; while(i<vl){poke8(buf+off+i,StrCharAt(exprVals,i)&0xFF);i:=i+1;} off:=off+vl;
    }
    off := ddbAppend(buf, off, ",\"ReturnValues\":\"ALL_NEW\"}"c);
    poke8(buf+off, 0);
    free(keyBuf, 512);
    var resp: AWSResponse := ddbSend(client, "DynamoDB_20120810.UpdateItem"c, buf, off);
    free(buf, 2048);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

pub fn DDBBatchWriteItem(client: DDBClient, tableName: pchar,
                         items: int64, count: int64): int64 {
    // items: array of DDBItem pointers
    var buf: int64 := alloc(65536); var off: int64 := 0;
    off := ddbAppend(buf, off, "{\"RequestItems\":{\""c);
    off := ddbJsonEscape(tableName, buf, off);
    off := ddbAppend(buf, off, "\":["c);
    var i: int64 := 0;
    while (i < count) {
        if (i > 0) { off := ddbAppendChar(buf, off, 44); }
        var item: DDBItem := peek64(items + i*8) as DDBItem; // not valid Lyx — use int64 directly
        // Build put request object
        var itemBuf: int64 := alloc(4096);
        // item is stored as pointer to DDBItem struct: read fields
        var iAttrs: int64 := peek64(items + i*8);     // attrs
        var iCount: int64 := peek64(items + i*8 + 8); // count
        var tmpItem: DDBItem;
        tmpItem.attrs := iAttrs;
        tmpItem.count := iCount;
        ddbItemToJson(tmpItem, itemBuf);
        off := ddbAppend(buf, off, "{\"PutRequest\":{\"Item\":"c);
        var il: int64 := StrLen(itemBuf as pchar);
        var j: int64 := 0; while(j<il){poke8(buf+off+j,peek8(itemBuf+j));j:=j+1;} off:=off+il;
        off := ddbAppend(buf, off, "}}"c);
        free(itemBuf, 4096);
        i:=i+1;
    }
    off := ddbAppend(buf, off, "]}}"c);
    poke8(buf+off, 0);
    var resp: AWSResponse := ddbSend(client, "DynamoDB_20120810.BatchWriteItem"c, buf, off);
    free(buf, 65536);
    var ok: int64 := 0; if (resp.statusCode == 200) { ok:=1; }
    AWSResponseFree(resp);
    return ok;
}

pub fn DDBTransactWriteItems(client: DDBClient, txJson: pchar): int64 {
    var buf: int64 := alloc(256 + StrLen(txJson)); var off: int64 := 0;
    off := ddbAppend(buf, off, "{\"TransactItems\":"c);
    var nl: int64 := StrLen(txJson);
    var i: int64 := 0; while(i<nl){poke8(buf+off+i,StrCharAt(txJson,i)&0xFF);i:=i+1;} off:=off+nl;
