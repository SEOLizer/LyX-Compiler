pub fn EC2AuthorizeSGIngress(client: EC2Client, sgId: pchar,
                              proto: pchar, fromPort: int64, toPort: int64, cidr: pchar): int64 {
    var buf: int64 := alloc(1024); var off: int64 := 0;
    var s: pchar := "Action=AuthorizeSecurityGroupIngress&Version=2016-11-15&GroupId="c;
    var n: int64 := StrLen(s);
    var i: int64 := 0; while(i<n){poke8(buf+i,StrCharAt(s,i)&0xFF);i:=i+1;} off:=n;
    n:=StrLen(sgId); i:=0; while(i<n){poke8(buf+off+i,StrCharAt(sgId,i)&0xFF);i:=i+1;} off:=off+n;
    var p1: pchar := "&IpPermissions.1.IpProtocol="c; n:=StrLen(p1);
    i:=0; while(i<n){poke8(buf+off+i,StrCharAt(p1,i)&0xFF);i:=i+1;} off:=off+n;
    n:=StrLen(proto); i:=0; while(i<n){poke8(buf+off+i,StrCharAt(proto,i)&0xFF);i:=i+1;} off:=off+n;
    var p2: pchar := "&IpPermissions.1.FromPort="c; n:=StrLen(p2);
    i:=0; while(i<n){poke8(buf+off+i,StrCharAt(p2,i)&0xFF);i:=i+1;} off:=off+n;
    var tmp: int64 := alloc(24); Int64ToStr(fromPort, tmp as pchar);
    n:=StrLen(tmp as pchar); i:=0; while(i<n){poke8(buf+off+i,StrCharAt(tmp as pchar,i)&0xFF);i:=i+1;} off:=off+n;
    var p3: pchar := "&IpPermissions.1.ToPort="c; n:=StrLen(p3);
    i:=0; while(i<n){poke8(buf+off+i,StrCharAt(p3,i)&0xFF);i:=i+1;} off:=off+n;
    Int64ToStr(toPort, tmp as pchar);
    n:=StrLen(tmp as pchar); i:=0; while(i<n){poke8(buf+off+i,StrCharAt(tmp as pchar,i)&0xFF);i:=i+1;} off:=off+n;
    free(tmp, 24);
    var p4: pchar := "&IpPermissions.1.IpRanges.1.CidrIp="c; n:=StrLen(p4);
    i:=0; while(i<n){poke8(buf+off+i,StrCharAt(p4,i)&0xFF);i:=i+1;} off:=off+n;
    n:=StrLen(cidr); i:=0; while(i<n){poke8(buf+off+i,StrCharAt(cidr,i)&0xFF);i:=i+1;} off:=off+n;
    poke8(buf+off,0);
    var resp: AWSResponse := ec2Send(client, buf, off);
    free(buf, 1024);
    var ok: int64 := 0; if (resp.statusCode == 200) { ok:=1; }
    AWSResponseFree(resp);
    return ok;
}

