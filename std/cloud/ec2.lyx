pub fn EC2DescribeInstanceById(client: EC2Client, instanceId: pchar): EC2Instance {
    var buf: int64 := alloc(512); var off: int64 := 0;
    var s: pchar := "Action=DescribeInstances&Version=2016-11-15&InstanceId.1="c;
    var n: int64 := StrLen(s);
    var i: int64 := 0; while(i<n){poke8(buf+i,StrCharAt(s,i)&0xFF);i:=i+1;} off:=n;
    n := StrLen(instanceId);
    i:=0; while(i<n){poke8(buf+off+i,StrCharAt(instanceId,i)&0xFF);i:=i+1;} off:=off+n;
    poke8(buf+off,0);
    var resp: AWSResponse := ec2Send(client, buf, off);
    free(buf, 512);
    var inst: EC2Instance;
    if (resp.statusCode == 200 && resp.body != 0) {
        var item: int64 := XMLFind(resp.body, resp.bodyLen, "item"c);
        if (item != 0) {
            inst := parseEC2Instance(item, StrLen(item as pchar));
            free(item, StrLen(item as pchar)+1);
        }
    }
    AWSResponseFree(resp);
    return inst;
}

