pub fn EC2InstanceFree(i: EC2Instance) {
    if (i.instanceId   != 0) { free(i.instanceId,   StrLen(i.instanceId   as pchar)+1); }
    if (i.state        != 0) { free(i.state,        StrLen(i.state        as pchar)+1); }
    if (i.instanceType != 0) { free(i.instanceType, StrLen(i.instanceType as pchar)+1); }
    if (i.publicIP     != 0) { free(i.publicIP,     StrLen(i.publicIP     as pchar)+1); }
    if (i.privateIP    != 0) { free(i.privateIP,    StrLen(i.privateIP    as pchar)+1); }
    if (i.imageId      != 0) { free(i.imageId,      StrLen(i.imageId      as pchar)+1); }
    if (i.keyName      != 0) { free(i.keyName,      StrLen(i.keyName      as pchar)+1); }
    if (i.launchTime   != 0) { free(i.launchTime,   StrLen(i.launchTime   as pchar)+1); }
}

// Append-Helfer auf Unit-Ebene, wie lambdaAppend/cwAppend in den Schwester-Units.
// Vorher waren das verschachtelte Funktionen, die `buf` und `off` der umgebenden
// Funktion mutierten — verschachtelte Funktionen bekommen aber keinen Static Link,
// der Zugriff lief ins Leere. Jetzt wandert der Cursor durch Rückgabewert.
fn ec2Append(buf: int64, off: int64, s: pchar): int64 {
    var n: int64 := StrLen(s); var i: int64 := 0;
    while(i<n){poke8(buf+off+i,StrCharAt(s,i)&0xFF);i:=i+1;}
    return off+n;
}

fn ec2AppendNum(buf: int64, off: int64, n: int64): int64 {
    var tmp: int64 := alloc(24);
    Int64ToStr(n, tmp as pchar);
    var r: int64 := ec2Append(buf, off, tmp as pchar);
    free(tmp, 24);
    return r;
}

fn ec2StrDup(s: pchar): int64 {
    if (s == 0 as pchar) { return 0; }
    var n: int64 := StrLen(s)+1;
    var b: int64 := alloc(n);
    var i: int64 := 0;
    while(i<n){poke8(b+i,StrCharAt(s,i)&0xFF);i:=i+1;}
    return b;
}

pub fn EC2Connect(creds: AWSCreds, region: pchar): EC2Client {
    var c: EC2Client;
    c.creds  := creds;
    c.region := region as int64;
    c.host   := AWSEndpoint("ec2"c, region) as int64;
    return c;
}

pub fn EC2Close(client: EC2Client) {
    AWSCredentialsFree(client.creds);
    if (client.host != 0) { free(client.host, StrLen(client.host as pchar)+1); }
}

fn ec2Query(client: EC2Client, params: int64, count: int64): AWSResponse {
    var body: int64 := AWSQueryBuild("DescribeInstances"c, "2016-11-15"c, params, 0);
    // body is replaced by caller's action; we just need the transport call
    // caller passes full body directly
    // Actually, rebuild properly per call — this helper is action-agnostic for body
    var resp: AWSResponse := AWSQueryRequest(client.creds, client.host as pchar,
                                             body, StrLen(body as pchar),
                                             client.region as pchar, "ec2"c);
    free(body, StrLen(body as pchar)+1);
    return resp;
}

fn ec2Send(client: EC2Client, body: int64, bodyLen: int64): AWSResponse {
    return AWSQueryRequest(client.creds, client.host as pchar,
                           body, bodyLen,
                           client.region as pchar, "ec2"c);
}

// ── Instances ─────────────────────────────────────────────────────────────────

fn parseEC2Instance(xml: int64, xmlLen: int64): EC2Instance {
    var inst: EC2Instance;
    var idBuf:   int64 := XMLFind(xml, xmlLen, "instanceId"c);
    var stBuf:   int64 := XMLFindIn(xml, xmlLen, "instanceState"c, "name"c);
    var typBuf:  int64 := XMLFind(xml, xmlLen, "instanceType"c);
    var pubBuf:  int64 := XMLFind(xml, xmlLen, "ipAddress"c);
    var privBuf: int64 := XMLFind(xml, xmlLen, "privateIpAddress"c);
    var imgBuf:  int64 := XMLFind(xml, xmlLen, "imageId"c);
    var keyBuf:  int64 := XMLFind(xml, xmlLen, "keyName"c);
    var ltBuf:   int64 := XMLFind(xml, xmlLen, "launchTime"c);
    inst.instanceId   := idBuf;
    inst.state        := stBuf;
    inst.instanceType := typBuf;
    inst.publicIP     := pubBuf;
    inst.privateIP    := privBuf;
    inst.imageId      := imgBuf;
    inst.keyName      := keyBuf;
    inst.launchTime   := ltBuf;
    return inst;
}

pub fn EC2DescribeInstances(client: EC2Client): int64 {
    var body: int64 := AWSQueryBuild("DescribeInstances"c, "2016-11-15"c, 0, 0);
    var bodyLen: int64 := StrLen(body as pchar);
    var resp: AWSResponse := ec2Send(client, body, bodyLen);
    free(body, bodyLen+1);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

pub fn EC2RunInstances(client: EC2Client, imageId: pchar, instanceType: pchar,
                       minCount: int64, maxCount: int64, keyName: pchar,
                       subnetId: pchar, sgId: pchar): int64 {
    var buf: int64 := alloc(2048); var off: int64 := 0;
    off := ec2Append(buf, off, "Action=RunInstances&Version=2016-11-15"c);
    off := ec2Append(buf, off, "&ImageId="c);      off := ec2Append(buf, off, imageId);
    off := ec2Append(buf, off, "&InstanceType="c); off := ec2Append(buf, off, instanceType);
    off := ec2Append(buf, off, "&MinCount="c);     off := ec2AppendNum(buf, off, minCount);
    off := ec2Append(buf, off, "&MaxCount="c);     off := ec2AppendNum(buf, off, maxCount);
    if (keyName != 0 as pchar && StrLen(keyName) > 0) {
        off := ec2Append(buf, off, "&KeyName="c);  off := ec2Append(buf, off, keyName);
    }
    if (subnetId != 0 as pchar && StrLen(subnetId) > 0) {
        off := ec2Append(buf, off, "&SubnetId="c); off := ec2Append(buf, off, subnetId);
    }
    if (sgId != 0 as pchar && StrLen(sgId) > 0) {
        off := ec2Append(buf, off, "&SecurityGroupId.1="c); off := ec2Append(buf, off, sgId);
    }
    poke8(buf+off, 0);
    var resp: AWSResponse := ec2Send(client, buf, off);
    free(buf, 2048);
    var result: int64 := 0;
    if (resp.statusCode == 200) {
        var body: int64 := resp.body;
        result := XMLFind(body, resp.bodyLen, "instanceId"c);
        resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

pub fn EC2TerminateInstances(client: EC2Client, instanceId: pchar): int64 {
    var buf: int64 := alloc(512); var off: int64 := 0;
    var s: pchar := "Action=TerminateInstances&Version=2016-11-15&InstanceId.1="c;
    var n: int64 := StrLen(s);
    var i: int64 := 0; while(i<n){poke8(buf+i,StrCharAt(s,i)&0xFF);i:=i+1;} off:=n;
    n := StrLen(instanceId);
    i:=0; while(i<n){poke8(buf+off+i,StrCharAt(instanceId,i)&0xFF);i:=i+1;} off:=off+n;
    poke8(buf+off,0);
    var resp: AWSResponse := ec2Send(client, buf, off);
    free(buf, 512);
    var ok: int64 := 0; if (resp.statusCode == 200) { ok:=1; }
    AWSResponseFree(resp);
    return ok;
}

