pub fn EC2CreateImage(client: EC2Client, instanceId: pchar, name: pchar,
                      noReboot: int64): int64 {
    var buf: int64 := alloc(1024); var off: int64 := 0;
    var s: pchar := "Action=CreateImage&Version=2016-11-15&InstanceId="c;
    var n: int64 := StrLen(s);
    var i: int64 := 0; while(i<n){poke8(buf+i,StrCharAt(s,i)&0xFF);i:=i+1;} off:=n;
    n:=StrLen(instanceId);
    i:=0; while(i<n){poke8(buf+off+i,StrCharAt(instanceId,i)&0xFF);i:=i+1;} off:=off+n;
    var nm: pchar := "&Name="c; n:=StrLen(nm);
    i:=0; while(i<n){poke8(buf+off+i,StrCharAt(nm,i)&0xFF);i:=i+1;} off:=off+n;
    n:=StrLen(name);
    i:=0; while(i<n){poke8(buf+off+i,StrCharAt(name,i)&0xFF);i:=i+1;} off:=off+n;
    if (noReboot == 1) {
        var nr: pchar := "&NoReboot=true"c; n:=StrLen(nr);
        i:=0; while(i<n){poke8(buf+off+i,StrCharAt(nr,i)&0xFF);i:=i+1;} off:=off+n;
    }
    poke8(buf+off,0);
    var resp: AWSResponse := ec2Send(client, buf, off);
    free(buf, 1024);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := XMLFind(resp.body, resp.bodyLen, "imageId"c);
    }
    AWSResponseFree(resp);
    return result;
}

