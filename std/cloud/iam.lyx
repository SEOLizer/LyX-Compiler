// std/cloud/iam.lyx — AWS IAM + STS Client
// WP-AWS-08
// Query protocol (POST form-urlencoded → XML responses)
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, system.env, system.time])

unit std.cloud.iam;

import std.cloud.aws.core;
import std.cloud.aws.transport;
import std.cloud.aws.xml;
import std.alloc;
import std.io;

// Lyx hat keinen if-Ausdruck; die frühere Fassung schrieb
// `if(v<10){48+v}else{87+v}` mitten in eine Argumentliste und parste nicht.
fn _hexDigit(v: int64): int64 {
  if (v < 10) { return 48 + v; }
  return 87 + v;
}


pub type IAMClient = struct {
    creds:  AWSCreds;
    region: int64;  // pchar (always "us-east-1" for IAM global)
    host:   int64;  // pchar alloc'd
};

pub type STSClient = struct {
    creds:  AWSCreds;
    region: int64;  // pchar
    host:   int64;  // pchar alloc'd
};

pub type IAMUser = struct {
    userId:   int64;  // pchar
    userName: int64;  // pchar
    arn:      int64;  // pchar
    path:     int64;  // pchar
    created:  int64;  // pchar
};

pub type IAMRole = struct {
    roleId:   int64;  // pchar
    roleName: int64;  // pchar
    arn:      int64;  // pchar
    path:     int64;  // pchar
    created:  int64;  // pchar
};

pub type STSCredentials = struct {
    accessKeyId:     int64;  // pchar
    secretAccessKey: int64;  // pchar
    sessionToken:    int64;  // pchar
    expiration:      int64;  // pchar
};

pub fn IAMUserFree(u: IAMUser) {
    if (u.userId   != 0) { free(u.userId,   StrLen(u.userId   as pchar)+1); }
    if (u.userName != 0) { free(u.userName, StrLen(u.userName as pchar)+1); }
    if (u.arn      != 0) { free(u.arn,      StrLen(u.arn      as pchar)+1); }
    if (u.path     != 0) { free(u.path,     StrLen(u.path     as pchar)+1); }
    if (u.created  != 0) { free(u.created,  StrLen(u.created  as pchar)+1); }
}

pub fn IAMRoleFree(r: IAMRole) {
    if (r.roleId   != 0) { free(r.roleId,   StrLen(r.roleId   as pchar)+1); }
    if (r.roleName != 0) { free(r.roleName, StrLen(r.roleName as pchar)+1); }
    if (r.arn      != 0) { free(r.arn,      StrLen(r.arn      as pchar)+1); }
    if (r.path     != 0) { free(r.path,     StrLen(r.path     as pchar)+1); }
    if (r.created  != 0) { free(r.created,  StrLen(r.created  as pchar)+1); }
}

pub fn STSCredentialsFree(c: STSCredentials) {
    if (c.accessKeyId     != 0) { free(c.accessKeyId,     StrLen(c.accessKeyId     as pchar)+1); }
    if (c.secretAccessKey != 0) { free(c.secretAccessKey, StrLen(c.secretAccessKey as pchar)+1); }
    if (c.sessionToken    != 0) { free(c.sessionToken,    StrLen(c.sessionToken    as pchar)+1); }
    if (c.expiration      != 0) { free(c.expiration,      StrLen(c.expiration      as pchar)+1); }
}

fn iamSend(client: IAMClient, body: int64, bodyLen: int64): AWSResponse {
    return AWSQueryRequest(client.creds, client.host as pchar,
                           body, bodyLen,
                           client.region as pchar, "iam"c);
}

fn stsSend(client: STSClient, body: int64, bodyLen: int64): AWSResponse {
    return AWSQueryRequest(client.creds, client.host as pchar,
                           body, bodyLen,
                           client.region as pchar, "sts"c);
}

// ── IAM Client ────────────────────────────────────────────────────────────────

pub fn IAMConnect(creds: AWSCreds): IAMClient {
    var c: IAMClient;
    c.creds  := creds;
    c.region := "us-east-1"c as int64;
    c.host   := AWSEndpoint("iam"c, "us-east-1"c) as int64;
    return c;
}

pub fn IAMClose(client: IAMClient) {
    AWSCredentialsFree(client.creds);
    if (client.host != 0) { free(client.host, StrLen(client.host as pchar)+1); }
}

