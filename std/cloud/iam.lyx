pub fn IAMCreateRole(client: IAMClient, roleName: pchar,
                     trustPolicy: pchar, path: pchar): IAMRole {
    var buf: int64 := alloc(4096); var off: int64 := 0;
    var s: pchar := "Action=CreateRole&Version=2010-05-08&RoleName="c;
    var n: int64 := StrLen(s);
    var i: int64 := 0; while(i<n){poke8(buf+i,StrCharAt(s,i)&0xFF);i:=i+1;} off:=n;
    n:=StrLen(roleName); i:=0; while(i<n){poke8(buf+off+i,StrCharAt(roleName,i)&0xFF);i:=i+1;} off:=off+n;
    var tp: pchar := "&AssumeRolePolicyDocument="c; n:=StrLen(tp);
    i:=0; while(i<n){poke8(buf+off+i,StrCharAt(tp,i)&0xFF);i:=i+1;} off:=off+n;
    // URL-encode the trust policy JSON
    n:=StrLen(trustPolicy); i:=0;
    while(i<n){
        var c: int64 := StrCharAt(trustPolicy,i)&0xFF;
        if ((c>=65&&c<=90)||(c>=97&&c<=122)||(c>=48&&c<=57)||c==45||c==95||c==46||c==126) {
            poke8(buf+off,c); off:=off+1;
        } else {
            poke8(buf+off,37);
            poke8(buf+off+1,_hexDigit((c>>4)));
            poke8(buf+off+2,_hexDigit((c&0xF)));
            off:=off+3;
        }
        i:=i+1;
    }
    if (path != 0 as pchar && StrLen(path) > 0) {
        var p: pchar := "&Path="c; n:=StrLen(p);
        i:=0; while(i<n){poke8(buf+off+i,StrCharAt(p,i)&0xFF);i:=i+1;} off:=off+n;
        n:=StrLen(path); i:=0; while(i<n){poke8(buf+off+i,StrCharAt(path,i)&0xFF);i:=i+1;} off:=off+n;
    }
    poke8(buf+off,0);
    var resp: AWSResponse := iamSend(client, buf, off);
    free(buf, 4096);
    var r: IAMRole;
    if (resp.statusCode == 200 && resp.body != 0) {
        var role: int64 := XMLFind(resp.body, resp.bodyLen, "Role"c);
        if (role != 0) {
            var rl: int64 := StrLen(role as pchar);
            r.roleId   := XMLFind(role, rl, "RoleId"c);
            r.roleName := XMLFind(role, rl, "RoleName"c);
            r.arn      := XMLFind(role, rl, "Arn"c);
            r.path     := XMLFind(role, rl, "Path"c);
            r.created  := XMLFind(role, rl, "CreateDate"c);
            free(role, rl+1);
        }
    }
    AWSResponseFree(resp);
    return r;
}

