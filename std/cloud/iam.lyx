pub fn STSAssumeRole(client: STSClient, roleArn: pchar, sessionName: pchar,
                     durationSec: int64): STSCredentials {
    var buf: int64 := alloc(1024); var off: int64 := 0;
    var s: pchar := "Action=AssumeRole&Version=2011-06-15&RoleArn="c;
    var n: int64 := StrLen(s);
    var i: int64 := 0; while(i<n){poke8(buf+i,StrCharAt(s,i)&0xFF);i:=i+1;} off:=n;
    // URL-encode roleArn
    n:=StrLen(roleArn); i:=0;
    while(i<n){
        var c: int64 := StrCharAt(roleArn,i)&0xFF;
        if ((c>=65&&c<=90)||(c>=97&&c<=122)||(c>=48&&c<=57)||c==45||c==95||c==46||c==126||c==47) {
            poke8(buf+off,c); off:=off+1;
        } else {
            poke8(buf+off,37);
            poke8(buf+off+1,_hexDigit((c>>4)));
            poke8(buf+off+2,_hexDigit((c&0xF)));
            off:=off+3;
        }
        i:=i+1;
    }
    var sn: pchar := "&RoleSessionName="c; n:=StrLen(sn);
    i:=0; while(i<n){poke8(buf+off+i,StrCharAt(sn,i)&0xFF);i:=i+1;} off:=off+n;
    n:=StrLen(sessionName); i:=0; while(i<n){poke8(buf+off+i,StrCharAt(sessionName,i)&0xFF);i:=i+1;} off:=off+n;
    var dur: pchar := "&DurationSeconds="c; n:=StrLen(dur);
    i:=0; while(i<n){poke8(buf+off+i,StrCharAt(dur,i)&0xFF);i:=i+1;} off:=off+n;
    var tmp: int64 := alloc(24); Int64ToStr(durationSec, tmp as pchar);
