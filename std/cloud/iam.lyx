pub fn IAMListUsers(client: IAMClient): int64 {
    var body: pchar := "Action=ListUsers&Version=2010-05-08"c;
    var resp: AWSResponse := iamSend(client, body as int64, StrLen(body));
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

pub fn IAMGetUser(client: IAMClient, userName: pchar): IAMUser {
    var buf: int64 := alloc(256); var off: int64 := 0;
    var s: pchar := "Action=GetUser&Version=2010-05-08"c;
    var n: int64 := StrLen(s);
    var i: int64 := 0; while(i<n){poke8(buf+i,StrCharAt(s,i)&0xFF);i:=i+1;} off:=n;
    if (userName != 0 as pchar && StrLen(userName) > 0) {
        var un: pchar := "&UserName="c; n:=StrLen(un);
        i:=0; while(i<n){poke8(buf+off+i,StrCharAt(un,i)&0xFF);i:=i+1;} off:=off+n;
        n:=StrLen(userName); i:=0; while(i<n){poke8(buf+off+i,StrCharAt(userName,i)&0xFF);i:=i+1;} off:=off+n;
    }
    poke8(buf+off,0);
    var resp: AWSResponse := iamSend(client, buf, off);
    free(buf, 256);
    var u: IAMUser;
    if (resp.statusCode == 200 && resp.body != 0) {
        var user: int64 := XMLFind(resp.body, resp.bodyLen, "User"c);
        if (user != 0) {
            var ul: int64 := StrLen(user as pchar);
            u.userId   := XMLFind(user, ul, "UserId"c);
            u.userName := XMLFind(user, ul, "UserName"c);
            u.arn      := XMLFind(user, ul, "Arn"c);
            u.path     := XMLFind(user, ul, "Path"c);
            u.created  := XMLFind(user, ul, "CreateDate"c);
            free(user, ul+1);
        }
    }
    AWSResponseFree(resp);
    return u;
}

