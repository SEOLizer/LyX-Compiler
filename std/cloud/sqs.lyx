// ── Message operations ────────────────────────────────────────────────────────

pub fn SQSSendMessage(client: SQSClient, queueUrl: pchar,
                      body: pchar, delaySeconds: int64): int64 {
    var buf: int64 := alloc(4096); var off: int64 := 0;
    off := sqsAppend(buf, off, "Action=SendMessage&Version=2012-11-05&QueueUrl="c);
    off := sqsUrlEncode(queueUrl, buf, off);
    off := sqsAppend(buf, off, "&MessageBody="c);
    off := sqsUrlEncode(body, buf, off);
    if (delaySeconds > 0) {
        off := sqsAppend(buf, off, "&DelaySeconds="c);
        var tmp: int64 := alloc(24); Int64ToStr(delaySeconds, tmp as pchar);
        off := sqsAppend(buf, off, tmp as pchar); free(tmp, 24);
    }
    poke8(buf+off, 0);
    var resp: AWSResponse := sqsSend(client, 0 as pchar, buf, off);
    free(buf, 4096);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := XMLFind(resp.body, resp.bodyLen, "MessageId"c);
    }
    AWSResponseFree(resp);
    return result;
}

pub fn SQSSendMessageFIFO(client: SQSClient, queueUrl: pchar,
                           body: pchar, groupId: pchar, dedupeId: pchar): int64 {
    var buf: int64 := alloc(4096); var off: int64 := 0;
    off := sqsAppend(buf, off, "Action=SendMessage&Version=2012-11-05&QueueUrl="c);
    off := sqsUrlEncode(queueUrl, buf, off);
    off := sqsAppend(buf, off, "&MessageBody="c);
    off := sqsUrlEncode(body, buf, off);
    off := sqsAppend(buf, off, "&MessageGroupId="c);
    off := sqsUrlEncode(groupId, buf, off);
    if (dedupeId != 0 as pchar && StrLen(dedupeId) > 0) {
        off := sqsAppend(buf, off, "&MessageDeduplicationId="c);
        off := sqsUrlEncode(dedupeId, buf, off);
    }
    poke8(buf+off, 0);
    var resp: AWSResponse := sqsSend(client, 0 as pchar, buf, off);
    free(buf, 4096);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := XMLFind(resp.body, resp.bodyLen, "MessageId"c);
    }
    AWSResponseFree(resp);
    return result;
}

pub fn SQSReceiveMessages(client: SQSClient, queueUrl: pchar,
                           maxMessages: int64, waitSeconds: int64): int64 {
    var buf: int64 := alloc(512); var off: int64 := 0;
    off := sqsAppend(buf, off, "Action=ReceiveMessage&Version=2012-11-05&QueueUrl="c);
    off := sqsUrlEncode(queueUrl, buf, off);
    if (maxMessages > 0 && maxMessages <= 10) {
        off := sqsAppend(buf, off, "&MaxNumberOfMessages="c);
        var tmp: int64 := alloc(24); Int64ToStr(maxMessages, tmp as pchar);
        off := sqsAppend(buf, off, tmp as pchar); free(tmp, 24);
    }
    if (waitSeconds > 0) {
        off := sqsAppend(buf, off, "&WaitTimeSeconds="c);
        var tmp2: int64 := alloc(24); Int64ToStr(waitSeconds, tmp2 as pchar);
        off := sqsAppend(buf, off, tmp2 as pchar); free(tmp2, 24);
    }
    off := sqsAppend(buf, off, "&AttributeName.1=All&MessageAttributeName.1=All"c);
    poke8(buf+off, 0);
    var resp: AWSResponse := sqsSend(client, 0 as pchar, buf, off);
    free(buf, 512);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

