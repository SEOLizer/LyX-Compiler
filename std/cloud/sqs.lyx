// Parse first message from ReceiveMessage XML response
pub fn SQSParseFirstMessage(xml: int64, xmlLen: int64): SQSMessage {
    var msg: SQSMessage;
    var item: int64 := XMLFind(xml, xmlLen, "Message"c);
    if (item == 0) { return msg; }
    var il: int64 := StrLen(item as pchar);
    msg.messageId     := XMLFind(item, il, "MessageId"c);
    msg.receiptHandle := XMLFind(item, il, "ReceiptHandle"c);
    msg.body          := XMLFind(item, il, "Body"c);
    msg.md5           := XMLFind(item, il, "MD5OfBody"c);
    free(item, il+1);
    return msg;
}
