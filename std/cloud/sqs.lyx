// std/cloud/sqs.lyx — AWS SQS Client
// WP-AWS-11 (messaging part 1)
// Query protocol (POST form-urlencoded → XML responses)
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, system.env, system.time])

unit std.cloud.sqs;

import std.cloud.aws.core;
import std.cloud.aws.transport;
import std.cloud.aws.xml;
import std.alloc;
import std.io;

// Lyx hat keinen if-Ausdruck; die frühere Fassung schrieb
// `if(v<10){48+v}else{87+v}` mitten in eine Argumentliste und parste nicht.
fn _hexDigit(v: int64): int64 {
  if (v < 10) { return 48 + v; }
  return 87 + v;
}


pub type SQSClient = struct {
    creds:       AWSCreds;
    region:      int64;  // pchar
    host:        int64;  // pchar alloc'd
    accountId:   int64;  // pchar (optional, for URL building)
};

pub type SQSMessage = struct {
    messageId:     int64;  // pchar
    receiptHandle: int64;  // pchar
    body:          int64;  // pchar
    md5:           int64;  // pchar
    attributes:    int64;  // pchar (raw XML/JSON)
};

pub fn SQSMessageFree(m: SQSMessage) {
    if (m.messageId     != 0) { free(m.messageId,     StrLen(m.messageId     as pchar)+1); }
    if (m.receiptHandle != 0) { free(m.receiptHandle, StrLen(m.receiptHandle as pchar)+1); }
    if (m.body          != 0) { free(m.body,          StrLen(m.body          as pchar)+1); }
    if (m.md5           != 0) { free(m.md5,           StrLen(m.md5           as pchar)+1); }
    if (m.attributes    != 0) { free(m.attributes,    StrLen(m.attributes    as pchar)+1); }
}

fn sqsAppend(buf: int64, off: int64, s: pchar): int64 {
    var n: int64 := StrLen(s); var i: int64 := 0;
    while(i<n){poke8(buf+off+i,StrCharAt(s,i)&0xFF);i:=i+1;}
    return off+n;
}

fn sqsUrlEncode(s: pchar, buf: int64, off: int64): int64 {
    var n: int64 := StrLen(s); var i: int64 := 0;
    while(i<n){
        var c: int64 := StrCharAt(s,i) & 0xFF;
        if ((c>=65&&c<=90)||(c>=97&&c<=122)||(c>=48&&c<=57)||c==45||c==95||c==46||c==126) {
            poke8(buf+off,c); off:=off+1;
        } else {
            poke8(buf+off,37);
            poke8(buf+off+1,_hexDigit((c>>4)));
            poke8(buf+off+2,_hexDigit((c&0xF)));
            off:=off+3;
        }
        i:=i+1;
    }
    return off;
}

fn sqsSend(client: SQSClient, queuePath: pchar, body: int64, bodyLen: int64): AWSResponse {
    // SQS uses path-based queue URLs: host + "/" + accountId + "/" + queueName
    return AWSQueryRequest(client.creds, client.host as pchar,
                           body, bodyLen,
                           client.region as pchar, "sqs"c);
}

pub fn SQSConnect(creds: AWSCreds, region: pchar): SQSClient {
    var c: SQSClient;
    c.creds     := creds;
    c.region    := region as int64;
    c.host      := AWSEndpoint("sqs"c, region) as int64;
    c.accountId := 0;
    return c;
}

pub fn SQSClose(client: SQSClient) {
    AWSCredentialsFree(client.creds);
    if (client.host != 0) { free(client.host, StrLen(client.host as pchar)+1); }
}

// ── Queue operations ──────────────────────────────────────────────────────────

pub fn SQSListQueues(client: SQSClient, prefix: pchar): int64 {
    var buf: int64 := alloc(256); var off: int64 := 0;
    off := sqsAppend(buf, off, "Action=ListQueues&Version=2012-11-05"c);
    if (prefix != 0 as pchar && StrLen(prefix) > 0) {
        off := sqsAppend(buf, off, "&QueueNamePrefix="c);
        off := sqsUrlEncode(prefix, buf, off);
    }
    poke8(buf+off, 0);
    var resp: AWSResponse := sqsSend(client, 0 as pchar, buf, off);
    free(buf, 256);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    return result;
}

pub fn SQSCreateQueue(client: SQSClient, name: pchar,
                      visibilityTimeout: int64, retentionSec: int64): int64 {
    var buf: int64 := alloc(512); var off: int64 := 0;
    off := sqsAppend(buf, off, "Action=CreateQueue&Version=2012-11-05&QueueName="c);
    off := sqsUrlEncode(name, buf, off);
    if (visibilityTimeout > 0) {
        off := sqsAppend(buf, off, "&Attribute.1.Name=VisibilityTimeout&Attribute.1.Value="c);
        var tmp: int64 := alloc(24); Int64ToStr(visibilityTimeout, tmp as pchar);
        off := sqsAppend(buf, off, tmp as pchar); free(tmp, 24);
    }
    if (retentionSec > 0) {
        off := sqsAppend(buf, off, "&Attribute.2.Name=MessageRetentionPeriod&Attribute.2.Value="c);
        var tmp2: int64 := alloc(24); Int64ToStr(retentionSec, tmp2 as pchar);
        off := sqsAppend(buf, off, tmp2 as pchar); free(tmp2, 24);
    }
    poke8(buf+off, 0);
    var resp: AWSResponse := sqsSend(client, 0 as pchar, buf, off);
    free(buf, 512);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := XMLFind(resp.body, resp.bodyLen, "QueueUrl"c);
    }
    AWSResponseFree(resp);
    return result;
}

pub fn SQSCreateFIFOQueue(client: SQSClient, name: pchar): int64 {
    // FIFO queue names must end in .fifo
    var buf: int64 := alloc(512); var off: int64 := 0;
    off := sqsAppend(buf, off, "Action=CreateQueue&Version=2012-11-05&QueueName="c);
    off := sqsUrlEncode(name, buf, off);
    off := sqsAppend(buf, off, "&Attribute.1.Name=FifoQueue&Attribute.1.Value=true"c);
    off := sqsAppend(buf, off, "&Attribute.2.Name=ContentBasedDeduplication&Attribute.2.Value=true"c);
    poke8(buf+off, 0);
    var resp: AWSResponse := sqsSend(client, 0 as pchar, buf, off);
    free(buf, 512);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := XMLFind(resp.body, resp.bodyLen, "QueueUrl"c);
    }
    AWSResponseFree(resp);
    return result;
}

