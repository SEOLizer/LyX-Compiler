pub fn SQSDeleteMessageBatch(client: SQSClient, queueUrl: pchar,
                              handles: int64, count: int64): int64 {
    // handles: array of pchar receiptHandles
    var buf: int64 := alloc(65536); var off: int64 := 0;
    off := sqsAppend(buf, off, "Action=DeleteMessageBatch&Version=2012-11-05&QueueUrl="c);
    off := sqsUrlEncode(queueUrl, buf, off);
    var i: int64 := 0;
    while (i < count) {
        var rh: pchar := peek64(handles + i*8) as pchar;
        off := sqsAppend(buf, off, "&DeleteMessageBatchRequestEntry."c);
        var tmp: int64 := alloc(24); Int64ToStr(i+1, tmp as pchar);
        off := sqsAppend(buf, off, tmp as pchar); free(tmp, 24);
        off := sqsAppend(buf, off, ".Id="c);
        var idbuf: int64 := alloc(24); Int64ToStr(i+1, idbuf as pchar);
        off := sqsAppend(buf, off, idbuf as pchar); free(idbuf, 24);
        off := sqsAppend(buf, off, "&DeleteMessageBatchRequestEntry."c);
        var tmp2: int64 := alloc(24); Int64ToStr(i+1, tmp2 as pchar);
        off := sqsAppend(buf, off, tmp2 as pchar); free(tmp2, 24);
        off := sqsAppend(buf, off, ".ReceiptHandle="c);
        off := sqsUrlEncode(rh, buf, off);
        i:=i+1;
    }
    poke8(buf+off, 0);
    var resp: AWSResponse := sqsSend(client, 0 as pchar, buf, off);
    free(buf, 65536);
    var ok: int64 := 0; if (resp.statusCode == 200) { ok:=1; }
    AWSResponseFree(resp);
    return ok;
}

