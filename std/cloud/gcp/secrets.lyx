// std/cloud/gcp/secrets.lyx — Secret Manager + IAM (WP-GCP-12)
//
// Public API (Secret Manager):
//   SecretConnect(credsPtr, project) -> SecretConn
//   SecretDisconnect(c)
//   SecretCreate(c, name, payload, payloadLen) -> int64 (status)
//   SecretGet(c, name) -> int64 (pchar secret value, caller frees, or 0)
//   SecretList(c) -> GCPResponse
//   SecretDelete(c, name) -> int64 (status)
//   SecretAddVersion(c, name, payload, payloadLen) -> int64 (status)
//   SecretGetLatest(c, name) -> int64 (pchar decrypted value, caller frees)
//
// Public API (IAM):
//   IAMConnect(credsPtr, project) -> IAMConn
//   IAMDisconnect(c)
//   IAMListServiceAccounts(c) -> GCPResponse
//   IAMCreateServiceAccount(c, accountId, displayName) -> int64 (status)
//   IAMDeleteServiceAccount(c, email) -> int64 (status)
//   IAMGetIAMPolicy(c, resource) -> GCPResponse
//   IAMSetIAMPolicy(c, resource, policy, policyLen) -> int64 (status)
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, process.exec, process.fork, process.signal, system.env, system.time])

unit std.cloud.gcp.secrets;

import std.cloud.gcp.transport;
import std.cloud.gcp.jwt;
import std.alloc;

// ── Types ─────────────────────────────────────────────────────────────────────

pub type SecretConn = struct {
    client:  GCPClient;
    project: int64;   // pchar
};

pub type IAMConn = struct {
    client:  GCPClient;
    project: int64;   // pchar
};

// ── Internal helpers ──────────────────────────────────────────────────────────

fn secStrLen(s: int64): int64 {
    if (s == 0) { return 0; }
    var i: int64 := 0; while (peek8(s + i) != 0) { i := i + 1; } return i;
}

fn secStrDup(src: int64): int64 {
    if (src == 0) { return 0; }
    var n: int64 := secStrLen(src);
    var buf: int64 := alloc(n + 1);
    var i: int64 := 0;
    while (i < n) { poke8(buf + i, peek8(src + i)); i := i + 1; }
    poke8(buf + n, 0); return buf;
}

fn secAppend(dst: int64, pos: int64, src: int64, n: int64): int64 {
    var i: int64 := 0;
    while (i < n) { poke8(dst + pos + i, peek8(src + i)); i := i + 1; }
    return pos + n;
}

fn secAppendStr(dst: int64, pos: int64, s: int64): int64 {
    return secAppend(dst, pos, s, secStrLen(s));
}

fn secJSONExtract(json: int64, jl: int64, key: int64): int64 {
    var kl: int64 := secStrLen(key);
    var i: int64 := 0;
    while (i < jl - kl - 3) {
        if ((peek8(json + i) & 0xFF) == 34) {
            var isMatch: int64 := 1; var j: int64 := 0;
            while (j < kl) {
                if ((peek8(json + i + 1 + j) & 0xFF) != (peek8(key + j) & 0xFF)) { isMatch := 0; break; }
                j += 1;
            }
            if ((isMatch == 1) & ((peek8(json + i + 1 + kl) & 0xFF) == 34)) {
                var k: int64 := i + kl + 2;
                while ((k < jl) & (peek8(json + k) == 32)) { k := k + 1; }
                if ((k < jl) & ((peek8(json + k) & 0xFF) == 58)) {
                    k += 1; while ((k < jl) & (peek8(json + k) == 32)) { k := k + 1; }
                    if ((k < jl) & ((peek8(json + k) & 0xFF) == 34)) {
                        k += 1; var vs: int64 := k;
                        while ((k < jl) & ((peek8(json + k) & 0xFF) != 34)) { k := k + 1; }
                        var n: int64 := k - vs;
                        var buf: int64 := alloc(n + 1);
                        var ii: int64 := 0;
                        while (ii < n) { poke8(buf + ii, peek8(json + vs + ii)); ii := ii + 1; }
                        poke8(buf + n, 0); return buf;
                    }
                }
            }
        }
        i += 1;
    }
    return 0;
}

// Build Secret Manager path: /v1/projects/{proj}/secrets[/{name}]
fn secPath(proj: int64, name: int64): int64 {
    var pfx: int64    := "/v1/projects/" as int64;
    var mid: int64    := "/secrets" as int64;
    var pl: int64     := secStrLen(proj);
    var nl: int64     := secStrLen(name);
    var pfxLen: int64 := secStrLen(pfx);
    var midLen: int64 := secStrLen(mid);
    var total: int64  := pfxLen + pl + midLen + 1 + nl + 1;
    var buf: int64    := alloc(total);
    var pos: int64 := 0;
    pos := secAppend(buf, pos, pfx, pfxLen);
    pos := secAppend(buf, pos, proj, pl);
    pos := secAppend(buf, pos, mid, midLen);
    if (nl > 0) {
        poke8(buf + pos, 47); pos := pos + 1;
        pos := secAppend(buf, pos, name, nl);
    }
    poke8(buf + pos, 0); return buf;
}

// Build version path: /v1/projects/{proj}/secrets/{name}/versions/latest
fn secVersionPath(proj: int64, name: int64, version: int64): int64 {
    var base: int64    := secPath(proj, name);
    var bl: int64      := secStrLen(base);
    var vl: int64      := secStrLen(version);
    var total: int64   := bl + 10 + vl + 1;
    var buf: int64     := alloc(total);
    var pos: int64 := 0;
    pos := secAppend(buf, pos, base, bl);
    pos := secAppendStr(buf, pos, "/versions/" as int64);
    pos := secAppend(buf, pos, version, vl);
    poke8(buf + pos, 0);
    free(base, bl + 1); return buf;
}

// ── Secret Manager Public API ─────────────────────────────────────────────────

pub fn SecretConnect(creds: GCPCredentials, project: pchar): SecretConn {
  var projectAdr: int64 := project as int64;   // #1613
    var credsPtr: int64 := creds as int64;   // #1616
    var c: SecretConn;
    c.client  := GCPClientNew(credsPtr, project, "secretmanager.googleapis.com"c);
    c.project := secStrDup(projectAdr);
    return c;
}

pub fn SecretDisconnect(c: SecretConn): void {
    GCPClientFree(c.client);
    if (c.project != 0) { free(c.project, secStrLen(c.project) + 1); }
}

// SecretCreate — create a secret and add an initial version
pub fn SecretCreate(c: SecretConn, name: int64, payload: int64, payloadLen: int64): int64 {
    // Step 1: create secret
    var pl: int64  := secStrLen(c.project);
    var nl: int64  := secStrLen(name);
    var path: int64 := alloc(pl + 32);
    var pos: int64 := 0;
    pos := secAppendStr(path, pos, "/v1/projects/" as int64);
    pos := secAppend(path, pos, c.project, pl);
    pos := secAppendStr(path, pos, "/secrets?secretId=" as int64);
    pos := secAppend(path, pos, name, nl);
    poke8(path + pos, 0);

    var createBody: int64 := "{\"replication\":{\"automatic\":{}}}" as int64;
    var r: GCPResponse := GCPPost(c.client, path as pchar, createBody, secStrLen(createBody));
    var sc: int64 := r.statusCode;
    GCPResponseFree(r);
    free(path, pl + 32);
    if (sc != 200) { return sc; }

    // Step 2: add version with base64-encoded payload
    return SecretAddVersion(c, name, payload, payloadLen);
}

// SecretAddVersion — add a new version to an existing secret
pub fn SecretAddVersion(c: SecretConn, name: int64, payload: int64, payloadLen: int64): int64 {
    var basePath: int64 := secPath(c.project, name);
    var bpl: int64      := secStrLen(basePath);
    var addPath: int64  := alloc(bpl + 14);
    var pos: int64 := 0;
    pos := secAppend(addPath, pos, basePath, bpl);
    pos := secAppendStr(addPath, pos, ":addVersion" as int64);
    poke8(addPath + pos, 0);
    free(basePath, bpl + 1);

    // base64-encode payload
    var b64Sz: int64  := (payloadLen * 4 / 3) + 8;
    var b64Buf: int64 := alloc(b64Sz);
    base64urlEncodeBytes(payload, payloadLen, b64Buf);
    var b64Len: int64 := secStrLen(b64Buf);

    var bodySz: int64 := 40 + b64Len + 1;
    var body: int64   := alloc(bodySz);
    pos := 0;
    pos := secAppendStr(body, pos, "{\"payload\":{\"data\":\"" as int64);
    pos := secAppend(body, pos, b64Buf, b64Len);
    pos := secAppendStr(body, pos, "\"}}" as int64);
    poke8(body + pos, 0);
    free(b64Buf, b64Sz);

    var r: GCPResponse := GCPPost(c.client, addPath as pchar, body, pos);
    var sc: int64 := r.statusCode;
    GCPResponseFree(r);
    free(body, bodySz);
    free(addPath, bpl + 14);
    return sc;
}

// SecretGetLatest — access and decode the latest secret version
// Returns alloc'd null-terminated decoded payload, or 0 on error
pub fn SecretGetLatest(c: SecretConn, name: int64): int64 {
    var accessPath: int64 := secVersionPath(c.project, name, "latest" as int64);
    var apl: int64        := secStrLen(accessPath);
    var fullPath: int64   := alloc(apl + 10);
    var pos: int64 := 0;
    pos := secAppend(fullPath, pos, accessPath, apl);
    pos := secAppendStr(fullPath, pos, ":access" as int64);
    poke8(fullPath + pos, 0);
    free(accessPath, apl + 1);

    var r: GCPResponse := GCPGet(c.client, fullPath as pchar);
    free(fullPath, apl + 10);

    if (r.statusCode != 200) { GCPResponseFree(r); return 0; }

    // Parse "data" field from JSON response (base64-encoded)
    var b64: int64 := secJSONExtract(r.body, r.bodyLen, "data" as int64);
    GCPResponseFree(r);
    if (b64 == 0) { return 0; }

    // base64url decode
    var b64Len: int64  := secStrLen(b64);
    var outBuf: int64  := alloc(b64Len + 4);
    // Simple base64url decode
    var out: int64 := 0;
    var i: int64 := 0;
    while (i + 3 < b64Len) {
        var c0: int64 := peek8(b64 + i)     & 0xFF;
        var c1: int64 := peek8(b64 + i + 1) & 0xFF;
        var c2: int64 := peek8(b64 + i + 2) & 0xFF;
        var c3: int64 := peek8(b64 + i + 3) & 0xFF;
        // Decode base64url char to 6-bit value
        var v0: int64 := 0; var v1: int64 := 0; var v2: int64 := 0; var v3: int64 := 0;
        if ((c0 >= 65) & (c0 <= 90))  { v0 := c0 - 65; }
        if ((c0 >= 97) & (c0 <= 122)) { v0 := c0 - 71; }
        if ((c0 >= 48) & (c0 <= 57))  { v0 := c0 + 4; }
        if (c0 == 45) { v0 := 62; } if (c0 == 95) { v0 := 63; }
        if ((c1 >= 65) & (c1 <= 90))  { v1 := c1 - 65; }
        if ((c1 >= 97) & (c1 <= 122)) { v1 := c1 - 71; }
        if ((c1 >= 48) & (c1 <= 57))  { v1 := c1 + 4; }
        if (c1 == 45) { v1 := 62; } if (c1 == 95) { v1 := 63; }
        if ((c2 >= 65) & (c2 <= 90))  { v2 := c2 - 65; }
        if ((c2 >= 97) & (c2 <= 122)) { v2 := c2 - 71; }
        if ((c2 >= 48) & (c2 <= 57))  { v2 := c2 + 4; }
        if (c2 == 45) { v2 := 62; } if (c2 == 95) { v2 := 63; }
        if ((c3 >= 65) & (c3 <= 90))  { v3 := c3 - 65; }
        if ((c3 >= 97) & (c3 <= 122)) { v3 := c3 - 71; }
        if ((c3 >= 48) & (c3 <= 57))  { v3 := c3 + 4; }
        if (c3 == 45) { v3 := 62; } if (c3 == 95) { v3 := 63; }
        poke8(outBuf + out, (v0 << 2) | (v1 >> 4)); out := out + 1;
        if (c2 != 61) { poke8(outBuf + out, ((v1 & 15) << 4) | (v2 >> 2)); out := out + 1; }
        if (c3 != 61) { poke8(outBuf + out, ((v2 & 3) << 6) | v3); out := out + 1; }
        i += 4;
    }
    poke8(outBuf + out, 0);
    free(b64, b64Len + 1);
    return outBuf;
}

pub fn SecretGet(c: SecretConn, name: int64): int64 {
    return SecretGetLatest(c, name);
}

pub fn SecretDelete(c: SecretConn, name: int64): int64 {
    var path: int64 := secPath(c.project, name);
    var r: GCPResponse := GCPDelete(c.client, path as pchar);
    var sc: int64 := r.statusCode;
    GCPResponseFree(r);
    free(path, secStrLen(path) + 1);
    return sc;
}

pub fn SecretList(c: SecretConn): GCPResponse {
    var path: int64 := secPath(c.project, 0);
    var r: GCPResponse := GCPGet(c.client, path as pchar);
    free(path, secStrLen(path) + 1);
    return r;
}

// ── IAM Public API ────────────────────────────────────────────────────────────

pub fn IAMConnect(creds: GCPCredentials, project: pchar): IAMConn {
  var projectAdr: int64 := project as int64;   // #1613
    var credsPtr: int64 := creds as int64;   // #1616
    var c: IAMConn;
    c.client  := GCPClientNew(credsPtr, project, "iam.googleapis.com"c);
    c.project := secStrDup(projectAdr);
    return c;
}

pub fn IAMDisconnect(c: IAMConn): void {
    GCPClientFree(c.client);
    if (c.project != 0) { free(c.project, secStrLen(c.project) + 1); }
}

pub fn IAMListServiceAccounts(c: IAMConn): GCPResponse {
    var pl: int64   := secStrLen(c.project);
    var path: int64 := alloc(pl + 64);
    var pos: int64 := 0;
    pos := secAppendStr(path, pos, "/v1/projects/" as int64);
    pos := secAppend(path, pos, c.project, pl);
    pos := secAppendStr(path, pos, "/serviceAccounts" as int64);
    poke8(path + pos, 0);
    var r: GCPResponse := GCPGet(c.client, path as pchar);
    free(path, pl + 64);
    return r;
}

pub fn IAMCreateServiceAccount(c: IAMConn, accountId: int64, displayName: int64): int64 {
    var pl: int64   := secStrLen(c.project);
    var al: int64   := secStrLen(accountId);
    var dl: int64   := secStrLen(displayName);
    var path: int64 := alloc(pl + 64);
    var pos: int64 := 0;
    pos := secAppendStr(path, pos, "/v1/projects/" as int64);
    pos := secAppend(path, pos, c.project, pl);
    pos := secAppendStr(path, pos, "/serviceAccounts" as int64);
    poke8(path + pos, 0);

    var bodySz: int64 := 128 + al + dl;
    var body: int64   := alloc(bodySz);
    pos := 0;
    pos := secAppendStr(body, pos, "{\"accountId\":\"" as int64);
    pos := secAppend(body, pos, accountId, al);
    pos := secAppendStr(body, pos, "\",\"serviceAccount\":{\"displayName\":\"" as int64);
    pos := secAppend(body, pos, displayName, dl);
    pos := secAppendStr(body, pos, "\"}}" as int64);
    poke8(body + pos, 0);

    var r: GCPResponse := GCPPost(c.client, path as pchar, body, pos);
    var sc: int64 := r.statusCode;
    GCPResponseFree(r);
    free(body, bodySz);
    free(path, pl + 64);
    return sc;
}

pub fn IAMDeleteServiceAccount(c: IAMConn, email: int64): int64 {
    var el: int64   := secStrLen(email);
    var path: int64 := alloc(el + 32);
    var pos: int64 := 0;
    pos := secAppendStr(path, pos, "/v1/projects/-/serviceAccounts/" as int64);
    pos := secAppend(path, pos, email, el);
    poke8(path + pos, 0);
    var r: GCPResponse := GCPDelete(c.client, path as pchar);
    var sc: int64 := r.statusCode;
    GCPResponseFree(r);
    free(path, el + 32);
    return sc;
}

pub fn IAMGetIAMPolicy(c: IAMConn, resource: int64): GCPResponse {
    var rl: int64   := secStrLen(resource);
    var path: int64 := alloc(rl + 16);
    var pos: int64 := 0;
    pos := secAppend(path, pos, resource, rl);
    pos := secAppendStr(path, pos, ":getIamPolicy" as int64);
    poke8(path + pos, 0);
    var r: GCPResponse := GCPPost(c.client, path as pchar, "{}" as int64, 2);
    free(path, rl + 16);
    return r;
}

pub fn IAMSetIAMPolicy(c: IAMConn, resource: int64, policy: int64, policyLen: int64): int64 {
    var rl: int64   := secStrLen(resource);
    var path: int64 := alloc(rl + 16);
    var pos: int64 := 0;
    pos := secAppend(path, pos, resource, rl);
    pos := secAppendStr(path, pos, ":setIamPolicy" as int64);
    poke8(path + pos, 0);
    var bodySz: int64 := policyLen + 16;
    var body: int64   := alloc(bodySz);
    pos := 0;
    pos := secAppendStr(body, pos, "{\"policy\":" as int64);
    pos := secAppend(body, pos, policy, policyLen);
    poke8(body + pos, 125); pos := pos + 1; poke8(body + pos, 0);
    var r: GCPResponse := GCPPost(c.client, path as pchar, body, pos);
    var sc: int64 := r.statusCode;
    GCPResponseFree(r);
    free(body, bodySz);
    free(path, rl + 16);
    return sc;
}
