// std/cloud/gcp/compute.lyx — Compute Engine (WP-GCP-07)
//
// Public API:
//   GCEConnect(credsPtr, project, zone) -> GCEConn
//   GCEDisconnect(c)
//   GCEInstanceCreate(c, name, machineType, image, diskSizeGB) -> GCEOperation
//   GCEInstanceDelete(c, name) -> GCEOperation
//   GCEInstanceStart(c, name) -> GCEOperation
//   GCEInstanceStop(c, name) -> GCEOperation
//   GCEInstanceGet(c, name) -> int64 (JSON body pchar, caller frees)
//   GCEInstanceList(c) -> GCPResponse
//   GCEOperationWait(c, opName) -> int64 (1=done,0=error)
//   GCEOperationFree(op)
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, process.exec, process.fork, process.signal, system.env, system.time])

unit std.cloud.gcp.compute;

import std.cloud.gcp.transport;
import std.alloc;
import std.time;
import std.os;

// ── Types ─────────────────────────────────────────────────────────────────────

pub type GCEConn = struct {
    client:  GCPClient;
    project: int64;   // pchar
    zone:    int64;   // pchar
};

pub type GCEOperation = struct {
    name:       int64;   // pchar (alloc'd)
    status:     int64;   // pchar "RUNNING" | "DONE"
    targetLink: int64;   // pchar
    error:      int64;   // pchar or 0
    done:       int64;   // 1 if done
};

// ── Internal helpers ──────────────────────────────────────────────────────────

fn gceStrLen(s: int64): int64 {
    if (s == 0) { return 0; }
    var i: int64 := 0; while (peek8(s + i) != 0) { i := i + 1; } return i;
}

fn gceStrDupN(src: int64, n: int64): int64 {
    var buf: int64 := alloc(n + 1);
    var i: int64 := 0;
    while (i < n) { poke8(buf + i, peek8(src + i)); i := i + 1; }
    poke8(buf + n, 0); return buf;
}

fn gceStrDup(src: int64): int64 {
    if (src == 0) { return 0; }
    return gceStrDupN(src, gceStrLen(src));
}

fn gceJSONExtract(json: int64, jl: int64, key: int64): int64 {
    var kl: int64 := gceStrLen(key);
    var i: int64 := 0;
    while (i < jl - kl - 3) {
        if ((peek8(json + i) & 0xFF) == 34) {
            var isMatch: int64 := 1;
            var j: int64 := 0;
            while (j < kl) {
                if ((peek8(json + i + 1 + j) & 0xFF) != (peek8(key + j) & 0xFF)) { isMatch := 0; break; }
                j += 1;
            }
            if ((isMatch == 1) & ((peek8(json + i + 1 + kl) & 0xFF) == 34)) {
                var k: int64 := i + kl + 2;
                while ((k < jl) & (peek8(json + k) == 32)) { k := k + 1; }
                if ((k < jl) & ((peek8(json + k) & 0xFF) == 58)) {
                    k += 1; while ((k < jl) & (peek8(json + k) == 32)) { k := k + 1; }
                    if ((k < jl) & ((peek8(json + k) & 0xFF) == 34)) {
                        k += 1; var vs: int64 := k;
                        while ((k < jl) & ((peek8(json + k) & 0xFF) != 34)) { k := k + 1; }
                        return gceStrDupN(json + vs, k - vs);
                    }
                }
            }
        }
        i += 1;
    }
    return 0;
}

fn gceEmptyOp(): GCEOperation {
    var op: GCEOperation;
    op.name := 0; op.status := 0; op.targetLink := 0; op.error := 0; op.done := 0;
    return op;
}

// Build base path: /compute/v1/projects/{proj}/zones/{zone}
fn gcePath(proj: int64, zone: int64): int64 {
    var pfx: int64    := "/compute/v1/projects/" as int64;
    var mid: int64    := "/zones/" as int64;
    var pfxLen: int64 := gceStrLen(pfx);
    var midLen: int64 := gceStrLen(mid);
    var pl: int64 := gceStrLen(proj);
    var zl: int64 := gceStrLen(zone);
    var buf: int64 := alloc(pfxLen + pl + midLen + zl + 1);
    var pos: int64 := 0;
    var i: int64 := 0;
    while (i < pfxLen) { poke8(buf + pos, peek8(pfx + i)); pos := pos + 1; i := i + 1; }
    i := 0; while (i < pl) { poke8(buf + pos, peek8(proj + i)); pos := pos + 1; i := i + 1; }
    i := 0; while (i < midLen) { poke8(buf + pos, peek8(mid + i)); pos := pos + 1; i := i + 1; }
    i := 0; while (i < zl) { poke8(buf + pos, peek8(zone + i)); pos := pos + 1; i := i + 1; }
    poke8(buf + pos, 0);
    return buf;
}

fn gceAppend(dst: int64, pos: int64, src: int64, n: int64): int64 {
    var i: int64 := 0;
    while (i < n) { poke8(dst + pos + i, peek8(src + i)); i := i + 1; }
    return pos + n;
}

// Parse operation from JSON response
fn gceParseOp(json: int64, jl: int64): GCEOperation {
    var op: GCEOperation := gceEmptyOp();
    op.name   := gceJSONExtract(json, jl, "name" as int64);
    op.status := gceJSONExtract(json, jl, "status" as int64);
    op.targetLink := gceJSONExtract(json, jl, "targetLink" as int64);
    // Check if DONE
    if (op.status != 0) {
        var done: int64 := "DONE" as int64;
        var sl: int64 := gceStrLen(op.status);
        if (sl == 4) {
            if ((peek8(op.status) == 68) & (peek8(op.status + 1) == 79) &
                (peek8(op.status + 2) == 78) & (peek8(op.status + 3) == 69)) {
                op.done := 1;
            }
        }
    }
    return op;
}

// ── Public API ────────────────────────────────────────────────────────────────

pub fn GCEConnect(creds: GCPCredentials, project: pchar, zone: pchar): GCEConn {
  var projectAdr: int64 := project as int64;   // #1613
  var zoneAdr: int64 := zone as int64;   // #1613
    var credsPtr: int64 := creds as int64;   // #1616
    var c: GCEConn;
    c.client  := GCPClientNew(credsPtr, project, "compute.googleapis.com"c);
    c.project := gceStrDup(projectAdr);
    c.zone    := gceStrDup(zoneAdr);
    if (c.zone == 0) { c.zone := gceStrDup("europe-west1-b" as int64); }
    return c;
}

pub fn GCEDisconnect(c: GCEConn): void {
    GCPClientFree(c.client);
    if (c.project != 0) { free(c.project, gceStrLen(c.project) + 1); }
    if (c.zone    != 0) { free(c.zone,    gceStrLen(c.zone)    + 1); }
}

pub fn GCEOperationFree(op: GCEOperation): void {
    if (op.name       != 0) { free(op.name,       gceStrLen(op.name)       + 1); }
    if (op.status     != 0) { free(op.status,     gceStrLen(op.status)     + 1); }
    if (op.targetLink != 0) { free(op.targetLink, gceStrLen(op.targetLink) + 1); }
    if (op.error      != 0) { free(op.error,      gceStrLen(op.error)      + 1); }
}

// GCEInstanceCreate — POST new VM instance
pub fn GCEInstanceCreate(c: GCEConn, name: int64, machineType: int64, image: int64, diskSizeGB: int64): GCEOperation {
    var basePath: int64 := gcePath(c.project, c.zone);
    var sfx: int64      := "/instances" as int64;
    var bpl: int64      := gceStrLen(basePath);
    var sfxLen: int64   := gceStrLen(sfx);
    var path: int64     := alloc(bpl + sfxLen + 1);
    var pos: int64 := 0;
    pos := gceAppend(path, pos, basePath, bpl);
    pos := gceAppend(path, pos, sfx, sfxLen);
    poke8(path + pos, 0);
    free(basePath, bpl + 1);

    var nl: int64   := gceStrLen(name);
    var mtl: int64  := gceStrLen(machineType);
    var il: int64   := gceStrLen(image);
    var pl: int64   := gceStrLen(c.project);
    var zl: int64   := gceStrLen(c.zone);
    // Build machine type URL: zones/{zone}/machineTypes/{machineType}
    var mtPfx: int64    := "zones/" as int64;
    var mtMid: int64    := "/machineTypes/" as int64;
    var mtPfxLen: int64 := 6;
    var mtMidLen: int64 := gceStrLen(mtMid);
    // Full JSON body
    var bodySz: int64 := 512 + nl + mtl + il + zl + mtMidLen + 10;
    var body: int64   := alloc(bodySz);
    pos := 0;
    var p1: int64 := "{\"name\":\"" as int64;
    pos := gceAppend(body, pos, p1, 9);
    pos := gceAppend(body, pos, name, nl);
    var p2: int64 := "\",\"machineType\":\"zones/" as int64;
    pos := gceAppend(body, pos, p2, gceStrLen(p2));
    pos := gceAppend(body, pos, c.zone, zl);
    var p2b: int64 := "/machineTypes/" as int64;
    pos := gceAppend(body, pos, p2b, gceStrLen(p2b));
    pos := gceAppend(body, pos, machineType, mtl);
    var p3: int64 := "\",\"disks\":[{\"boot\":true,\"autoDelete\":true,\"initializeParams\":{\"sourceImage\":\"" as int64;
    pos := gceAppend(body, pos, p3, gceStrLen(p3));
    pos := gceAppend(body, pos, image, il);
    var p4: int64 := "\"}}],\"networkInterfaces\":[{\"network\":\"global/networks/default\",\"accessConfigs\":[{\"type\":\"ONE_TO_ONE_NAT\"}]}]}" as int64;
    pos := gceAppend(body, pos, p4, gceStrLen(p4));
    poke8(body + pos, 0);

    var r: GCPResponse := GCPPost(c.client, path as pchar, body, pos);
    var op: GCEOperation := gceEmptyOp();
    if (r.statusCode == 200) {
        op := gceParseOp(r.body, r.bodyLen);
    }
    GCPResponseFree(r);
    free(body, bodySz);
    free(path, bpl + sfxLen + 1);
    return op;
}

pub fn GCEInstanceDelete(c: GCEConn, name: int64): GCEOperation {
    var basePath: int64 := gcePath(c.project, c.zone);
    var bpl: int64      := gceStrLen(basePath);
    var nl: int64       := gceStrLen(name);
    var path: int64     := alloc(bpl + nl + 12);
    var pos: int64 := 0;
    pos := gceAppend(path, pos, basePath, bpl);
    var sfx: int64 := "/instances/" as int64;
    pos := gceAppend(path, pos, sfx, gceStrLen(sfx));
    pos := gceAppend(path, pos, name, nl);
    poke8(path + pos, 0);
    free(basePath, bpl + 1);
    var r: GCPResponse := GCPDelete(c.client, path as pchar);
    var op: GCEOperation := gceEmptyOp();
    if (r.statusCode == 200) { op := gceParseOp(r.body, r.bodyLen); }
    GCPResponseFree(r);
    free(path, bpl + nl + 12);
    return op;
}

pub fn GCEInstanceStart(c: GCEConn, name: int64): GCEOperation {
    var basePath: int64 := gcePath(c.project, c.zone);
    var bpl: int64      := gceStrLen(basePath);
    var nl: int64       := gceStrLen(name);
    var path: int64     := alloc(bpl + nl + 20);
    var pos: int64 := 0;
    pos := gceAppend(path, pos, basePath, bpl);
    var sfx: int64 := "/instances/" as int64;
    pos := gceAppend(path, pos, sfx, gceStrLen(sfx));
    pos := gceAppend(path, pos, name, nl);
    var act: int64 := "/start" as int64;
    pos := gceAppend(path, pos, act, 6);
    poke8(path + pos, 0);
    free(basePath, bpl + 1);
    var r: GCPResponse := GCPPost(c.client, path as pchar, 0, 0);
    var op: GCEOperation := gceEmptyOp();
    if (r.statusCode == 200) { op := gceParseOp(r.body, r.bodyLen); }
    GCPResponseFree(r);
    free(path, bpl + nl + 20);
    return op;
}

pub fn GCEInstanceStop(c: GCEConn, name: int64): GCEOperation {
    var basePath: int64 := gcePath(c.project, c.zone);
    var bpl: int64      := gceStrLen(basePath);
    var nl: int64       := gceStrLen(name);
    var path: int64     := alloc(bpl + nl + 20);
    var pos: int64 := 0;
    pos := gceAppend(path, pos, basePath, bpl);
    var sfx: int64 := "/instances/" as int64;
    pos := gceAppend(path, pos, sfx, gceStrLen(sfx));
    pos := gceAppend(path, pos, name, nl);
    var act: int64 := "/stop" as int64;
    pos := gceAppend(path, pos, act, 5);
    poke8(path + pos, 0);
    free(basePath, bpl + 1);
    var r: GCPResponse := GCPPost(c.client, path as pchar, 0, 0);
    var op: GCEOperation := gceEmptyOp();
    if (r.statusCode == 200) { op := gceParseOp(r.body, r.bodyLen); }
    GCPResponseFree(r);
    free(path, bpl + nl + 20);
    return op;
}

pub fn GCEInstanceGet(c: GCEConn, name: int64): int64 {
    var basePath: int64 := gcePath(c.project, c.zone);
    var bpl: int64      := gceStrLen(basePath);
    var nl: int64       := gceStrLen(name);
    var path: int64     := alloc(bpl + nl + 12);
    var pos: int64 := 0;
    pos := gceAppend(path, pos, basePath, bpl);
    var sfx: int64 := "/instances/" as int64;
    pos := gceAppend(path, pos, sfx, gceStrLen(sfx));
    pos := gceAppend(path, pos, name, nl);
    poke8(path + pos, 0);
    free(basePath, bpl + 1);
    var r: GCPResponse := GCPGet(c.client, path as pchar);
    var body: int64 := 0;
    if (r.statusCode == 200) { body := r.body; r.body := 0; }
    GCPResponseFree(r);
    free(path, bpl + nl + 12);
    return body;
}

pub fn GCEInstanceList(c: GCEConn): GCPResponse {
    var basePath: int64 := gcePath(c.project, c.zone);
    var bpl: int64      := gceStrLen(basePath);
    var sfx: int64      := "/instances" as int64;
    var sfxLen: int64   := gceStrLen(sfx);
    var path: int64     := alloc(bpl + sfxLen + 1);
    var pos: int64 := 0;
    pos := gceAppend(path, pos, basePath, bpl);
    pos := gceAppend(path, pos, sfx, sfxLen);
    poke8(path + pos, 0);
    free(basePath, bpl + 1);
    var r: GCPResponse := GCPGet(c.client, path as pchar);
    free(path, bpl + sfxLen + 1);
    return r;
}

// GCEOperationWait — poll until operation is done (max 60s)
pub fn GCEOperationWait(c: GCEConn, opName: int64): int64 {
    if (opName == 0) { return 0; }
    var basePath: int64 := gcePath(c.project, c.zone);
    var bpl: int64      := gceStrLen(basePath);
    var nl: int64       := gceStrLen(opName);
    var path: int64     := alloc(bpl + nl + 14);
    var pos: int64 := 0;
    pos := gceAppend(path, pos, basePath, bpl);
    var sfx: int64 := "/operations/" as int64;
    pos := gceAppend(path, pos, sfx, gceStrLen(sfx));
    pos := gceAppend(path, pos, opName, nl);
    poke8(path + pos, 0);
    free(basePath, bpl + 1);

    var attempts: int64 := 0;
    var done: int64 := 0;
    while ((attempts < 30) & (done == 0)) {
        var r: GCPResponse := GCPGet(c.client, path as pchar);
        if (r.statusCode == 200) {
            var op: GCEOperation := gceParseOp(r.body, r.bodyLen);
            done := op.done;
            GCEOperationFree(op);
        }
        GCPResponseFree(r);
        if (done == 0) { sleep(2000); }
        attempts += 1;
    }
    free(path, bpl + nl + 14);
    return done;
}
