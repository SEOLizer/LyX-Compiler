// std/cloud/gcp/firestore.lyx — Firestore (WP-GCP-08)
//
// Public API:
//   FirestoreConnect(credsPtr, project) -> FirestoreConn
//   FirestoreDisconnect(c)
//   FSDocNew() -> int64 (opaque FSDoc handle)
//   FSDocFree(doc)
//   FSDocSetString(doc, key, val)
//   FSDocSetInt(doc, key, val)
//   FSDocSetBool(doc, key, val)
//   FSDocGetString(doc, key) -> int64 (pchar or 0)
//   FSDocGetInt(doc, key) -> int64
//   FSCreate(c, collection, docId, doc) -> int64 (status)
//   FSGet(c, collection, docId) -> int64 (FSDoc handle)
//   FSUpdate(c, collection, docId, doc) -> int64 (status)
//   FSDelete(c, collection, docId) -> int64 (status)
//   FSExists(c, collection, docId) -> int64 (1=yes,0=no)
//   FSDocToJSON(doc) -> int64 (alloc'd JSON pchar)
//   FSDocFreeJSON(json)
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, process.exec, process.fork, process.signal, system.env, system.time])

unit std.cloud.gcp.firestore;

import std.cloud.gcp.transport;
import std.alloc;

// ── Types ─────────────────────────────────────────────────────────────────────

pub type FirestoreConn = struct {
    client:   GCPClient;
    project:  int64;   // pchar
    database: int64;   // pchar  "(default)"
};

// FSDoc is a simple linked-list of key-value fields.
// Each node: [next:int64][keyLen:int64][key:bytes][type:int64][valLen:int64][val:bytes]
// Stored in a flat alloc'd buffer, max 64 fields, 4 KB per field.

pub con FS_TYPE_STRING: int64 := 1;
pub con FS_TYPE_INT:    int64 := 2;
pub con FS_TYPE_BOOL:   int64 := 3;
pub con FS_TYPE_NULL:   int64 := 4;

// FSDoc layout: [count:int64][entries: count × {keyPtr:int64, type:int64, valPtr:int64}]
// Uses a simple dynamic array. Max 64 fields.
pub con FS_DOC_MAX_FIELDS: int64 := 64;

// ── Internal helpers ──────────────────────────────────────────────────────────

fn fsStrLen(s: int64): int64 {
    if (s == 0) { return 0; }
    var i: int64 := 0; while (peek8(s + i) != 0) { i := i + 1; } return i;
}

fn fsStrDupN(src: int64, n: int64): int64 {
    var buf: int64 := alloc(n + 1);
    var i: int64 := 0;
    while (i < n) { poke8(buf + i, peek8(src + i)); i := i + 1; }
    poke8(buf + n, 0); return buf;
}

fn fsStrDup(src: int64): int64 {
    if (src == 0) { return 0; }
    return fsStrDupN(src, fsStrLen(src));
}

fn fsStrEq(a: int64, b: int64): int64 {
    var i: int64 := 0;
    while (1 == 1) {
        var ca: int64 := peek8(a + i) & 0xFF;
        var cb: int64 := peek8(b + i) & 0xFF;
        if (ca != cb) { return 0; }
        if (ca == 0) { return 1; }
        i += 1;
    }
    return 0;
}

fn fsAppend(dst: int64, pos: int64, src: int64, n: int64): int64 {
    var i: int64 := 0;
    while (i < n) { poke8(dst + pos + i, peek8(src + i)); i := i + 1; }
    return pos + n;
}

fn fsAppendStr(dst: int64, pos: int64, s: int64): int64 {
    return fsAppend(dst, pos, s, fsStrLen(s));
}

// Append int64 as decimal string
fn fsAppendInt(dst: int64, pos: int64, n: int64): int64 {
    if (n == 0) { poke8(dst + pos, 48); return pos + 1; }
    var tmp: int64 := alloc(24); var tl: int64 := 0; var v: int64 := n;
    if (v < 0) { poke8(dst + pos, 45); pos := pos + 1; v := 0 - v; }
    while (v > 0) { poke8(tmp + tl, 48 + (v - ((v / 10) * 10))); v := v / 10; tl := tl + 1; }
    var i: int64 := 0;
    while (i < tl) { poke8(dst + pos + i, peek8(tmp + tl - 1 - i)); i := i + 1; }
    free(tmp, 24); return pos + tl;
}

// FSDoc alloc: 8 bytes count + 64 × 24 bytes (keyPtr + type + valPtr)
fn fsDocAlloc(): int64 {
    var sz: int64 := 8 + FS_DOC_MAX_FIELDS * 24;
    var buf: int64 := alloc(sz);
    poke64(buf, 0);
    return buf;
}

fn fsDocCount(doc: int64): int64 { return peek64(doc); }

fn fsDocSetCount(doc: int64, n: int64): void { poke64(doc, n); }

fn fsDocEntryPtr(doc: int64, i: int64): int64 { return doc + 8 + i * 24; }

// FSDoc: entry layout at offset: [keyPtr:int64][type:int64][valPtr:int64]
fn fsDocEntryKey(doc: int64, i: int64): int64  { return peek64(fsDocEntryPtr(doc, i)); }
fn fsDocEntryType(doc: int64, i: int64): int64 { return peek64(fsDocEntryPtr(doc, i) + 8); }
fn fsDocEntryVal(doc: int64, i: int64): int64  { return peek64(fsDocEntryPtr(doc, i) + 16); }

fn fsDocSetEntry(doc: int64, i: int64, keyPtr: int64, typ: int64, valPtr: int64): void {
    var p: int64 := fsDocEntryPtr(doc, i);
    poke64(p, keyPtr); poke64(p + 8, typ); poke64(p + 16, valPtr);
}

// Find existing field by key, return index or -1
fn fsDocFind(doc: int64, key: int64): int64 {
    var n: int64 := fsDocCount(doc);
    var i: int64 := 0;
    while (i < n) {
        if (fsStrEq(fsDocEntryKey(doc, i), key) == 1) { return i; }
        i += 1;
    }
    return 0 - 1;
}

// ── Public FSDoc API ──────────────────────────────────────────────────────────

pub fn FSDocNew(): int64 { return fsDocAlloc(); }

pub fn FSDocFree(doc: int64): void {
    if (doc == 0) { return; }
    var n: int64 := fsDocCount(doc);
    var i: int64 := 0;
    while (i < n) {
        var kp: int64 := fsDocEntryKey(doc, i);
        var vp: int64 := fsDocEntryVal(doc, i);
        if (kp != 0) { free(kp, fsStrLen(kp) + 1); }
        if (vp != 0) { free(vp, fsStrLen(vp) + 1); }
        i += 1;
    }
    free(doc, 8 + FS_DOC_MAX_FIELDS * 24);
}

pub fn FSDocSetString(doc: int64, key: pchar, val: pchar): void {
  var keyAdr: int64 := key as int64;   // #1613
  var valAdr: int64 := val as int64;   // #1613
    var idx: int64 := fsDocFind(doc, keyAdr);
    var keyDup: int64; var valDup: int64;
    if (idx < 0) {
        var n: int64 := fsDocCount(doc);
        if (n >= FS_DOC_MAX_FIELDS) { return; }
        keyDup := fsStrDup(keyAdr);
        valDup := fsStrDup(valAdr);
        fsDocSetEntry(doc, n, keyDup, FS_TYPE_STRING, valDup);
        fsDocSetCount(doc, n + 1);
    } else {
        var vp: int64 := fsDocEntryVal(doc, idx);
        if (vp != 0) { free(vp, fsStrLen(vp) + 1); }
        valDup := fsStrDup(valAdr);
        var p: int64 := fsDocEntryPtr(doc, idx);
        poke64(p + 8, FS_TYPE_STRING);
        poke64(p + 16, valDup);
    }
}

pub fn FSDocSetInt(doc: int64, key: pchar, val: int64): void {
  var keyAdr: int64 := key as int64;   // #1613
    var tmp: int64 := alloc(32);
    fsAppendInt(tmp, 0, val);
    FSDocSetString(doc, key, tmp as pchar);
    free(tmp, 32);
    var idx: int64 := fsDocFind(doc, keyAdr);
    if (idx >= 0) { poke64(fsDocEntryPtr(doc, idx) + 8, FS_TYPE_INT); }
}

pub fn FSDocSetBool(doc: int64, key: pchar, val: int64): void {
  var keyAdr: int64 := key as int64;   // #1613
    var s: int64;
    if (val != 0) { s := "true" as int64; } else { s := "false" as int64; }
    FSDocSetString(doc, key, s as pchar);
    var idx: int64 := fsDocFind(doc, keyAdr);
    if (idx >= 0) { poke64(fsDocEntryPtr(doc, idx) + 8, FS_TYPE_BOOL); }
}

pub fn FSDocGetString(doc: int64, key: pchar): int64 {
  var keyAdr: int64 := key as int64;   // #1613
    var idx: int64 := fsDocFind(doc, keyAdr);
    if (idx < 0) { return 0; }
    return fsDocEntryVal(doc, idx);
}

pub fn FSDocGetInt(doc: int64, key: pchar): int64 {
  var keyAdr: int64 := key as int64;   // #1613
    var s: int64 := FSDocGetString(doc, key);
    if (s == 0) { return 0; }
    var v: int64 := 0;
    var neg: int64 := 0;
    var i: int64 := 0;
    if ((peek8(s + i) & 0xFF) == 45) { neg := 1; i := i + 1; }
    while ((peek8(s + i) & 0xFF) >= 48) {
        v := v * 10 + ((peek8(s + i) & 0xFF) - 48); i := i + 1;
    }
    if (neg == 1) { v := 0 - v; }
    return v;
}

pub fn FSDocHasField(doc: int64, key: pchar): int64 {
  var keyAdr: int64 := key as int64;   // #1613
    if (fsDocFind(doc, keyAdr) >= 0) { return 1; }
    return 0;
}

pub fn FSDocFieldCount(doc: int64): int64 { return fsDocCount(doc); }

// FSDocToJSON — Firestore REST API format with typed wrappers
pub fn FSDocToJSON(doc: int64): int64 {
    if (doc == 0) { return 0; }
    var n: int64 := fsDocCount(doc);
    var bufSz: int64 := 64 + n * 256;
    var buf: int64   := alloc(bufSz);
    var pos: int64 := 0;
    pos := fsAppend(buf, pos, "{\"fields\":{" as int64, 11);
    var i: int64 := 0;
    while (i < n) {
        if (i > 0) { poke8(buf + pos, 44); pos := pos + 1; }
        var kp: int64  := fsDocEntryKey(doc, i);
        var typ: int64 := fsDocEntryType(doc, i);
        var vp: int64  := fsDocEntryVal(doc, i);
        poke8(buf + pos, 34); pos := pos + 1;
        pos := fsAppendStr(buf, pos, kp);
        poke8(buf + pos, 34); pos := pos + 1;
        poke8(buf + pos, 58); pos := pos + 1;  // ':'
        if (typ == FS_TYPE_STRING) {
            pos := fsAppendStr(buf, pos, "{\"stringValue\":\"" as int64);
            pos := fsAppendStr(buf, pos, vp);
            poke8(buf + pos, 34); pos := pos + 1;
            poke8(buf + pos, 125); pos := pos + 1;
        } else if (typ == FS_TYPE_INT) {
            pos := fsAppendStr(buf, pos, "{\"integerValue\":\"" as int64);
            pos := fsAppendStr(buf, pos, vp);
            poke8(buf + pos, 34); pos := pos + 1;
            poke8(buf + pos, 125); pos := pos + 1;
        } else if (typ == FS_TYPE_BOOL) {
            pos := fsAppendStr(buf, pos, "{\"booleanValue\":" as int64);
            pos := fsAppendStr(buf, pos, vp);
            poke8(buf + pos, 125); pos := pos + 1;
        } else {
            pos := fsAppendStr(buf, pos, "{\"nullValue\":null}" as int64);
        }
        i += 1;
    }
    poke8(buf + pos, 125); pos := pos + 1;  // }
    poke8(buf + pos, 125); pos := pos + 1;  // }
    poke8(buf + pos, 0);
    return buf;
}

pub fn FSDocFreeJSON(json: int64): void {
    if (json != 0) { free(json, fsStrLen(json) + 1); }
}

// Parse Firestore JSON response into FSDoc
fn fsParseDoc(json: int64, jl: int64): int64 {
    var doc: int64 := FSDocNew();
    // Simple scan for "stringValue":"..." patterns
    // Full parsing would require a proper JSON parser - this handles common cases
    var i: int64 := 0;
    var key: int64 := alloc(256);
    var val: int64 := alloc(1024);
    while (i < jl - 20) {
        // Look for field name pattern: "fieldName":{"stringValue":"value"}
        // This is a simplified approach; a full implementation would use std.json
        i += 1;
    }
    free(key, 256);
    free(val, 1024);
    return doc;
}

// ── Firestore Connection ──────────────────────────────────────────────────────

pub fn FirestoreConnect(creds: GCPCredentials, project: pchar): FirestoreConn {
    var credsPtr: int64 := creds as int64;   // #1616
  var projectAdr: int64 := project as int64;   // #1613
    var c: FirestoreConn;
    c.client   := GCPClientNew(credsPtr, project, "firestore.googleapis.com"c);
    c.project  := fsStrDup(projectAdr);
    c.database := fsStrDup("(default)" as int64);
    return c;
}

pub fn FirestoreDisconnect(c: FirestoreConn): void {
    GCPClientFree(c.client);
    if (c.project  != 0) { free(c.project,  fsStrLen(c.project)  + 1); }
    if (c.database != 0) { free(c.database, fsStrLen(c.database) + 1); }
}

// Build Firestore path: /v1/projects/{proj}/databases/(default)/documents/{col}/{docId}
fn fsPath(c: FirestoreConn, collection: int64, docId: int64): int64 {
    var pfx: int64 := "/v1/projects/" as int64;
    var mid: int64 := "/databases/(default)/documents/" as int64;
    var pl: int64  := fsStrLen(c.project);
    var cl: int64  := fsStrLen(collection);
    var dl: int64  := fsStrLen(docId);
    var pfxLen: int64 := fsStrLen(pfx);
    var midLen: int64 := fsStrLen(mid);
    var total: int64 := pfxLen + pl + midLen + cl + 1 + dl + 1;
    var buf: int64   := alloc(total);
    var pos: int64 := 0;
    pos := fsAppend(buf, pos, pfx, pfxLen);
    pos := fsAppend(buf, pos, c.project, pl);
    pos := fsAppend(buf, pos, mid, midLen);
    pos := fsAppend(buf, pos, collection, cl);
    if (dl > 0) { poke8(buf + pos, 47); pos := pos + 1; }
    pos := fsAppend(buf, pos, docId, dl);
    poke8(buf + pos, 0);
    return buf;
}

pub fn FSCreate(c: FirestoreConn, collection: pchar, docId: pchar, doc: int64): int64 {
  var collectionAdr: int64 := collection as int64;   // #1613
  var docIdAdr: int64 := docId as int64;   // #1613
    var path: int64 := fsPath(c, collectionAdr, docIdAdr);
    var body: int64 := FSDocToJSON(doc);
    var bl: int64   := fsStrLen(body);
    var r: GCPResponse := GCPPut(c.client, path as pchar, body, bl);
    var sc: int64 := r.statusCode;
    GCPResponseFree(r);
    FSDocFreeJSON(body);
    free(path, fsStrLen(path) + 1);
    return sc;
}

pub fn FSGet(c: FirestoreConn, collection: pchar, docId: pchar): int64 {
  var collectionAdr: int64 := collection as int64;   // #1613
  var docIdAdr: int64 := docId as int64;   // #1613
    var path: int64 := fsPath(c, collectionAdr, docIdAdr);
    var r: GCPResponse := GCPGet(c.client, path as pchar);
    var doc: int64 := FSDocNew();
    if (r.statusCode == 200) {
        // Minimal parsing: return raw JSON as a doc with one "json" field
        FSDocSetString(doc, "json", r.body);
    }
    GCPResponseFree(r);
    free(path, fsStrLen(path) + 1);
    return doc;
}

pub fn FSUpdate(c: FirestoreConn, collection: pchar, docId: pchar, doc: int64): int64 {
  var collectionAdr: int64 := collection as int64;   // #1613
  var docIdAdr: int64 := docId as int64;   // #1613
    var path: int64 := fsPath(c, collectionAdr, docIdAdr);
    var body: int64 := FSDocToJSON(doc);
    var bl: int64   := fsStrLen(body);
    var r: GCPResponse := GCPPatch(c.client, path as pchar, body, bl);
    var sc: int64 := r.statusCode;
    GCPResponseFree(r);
    FSDocFreeJSON(body);
    free(path, fsStrLen(path) + 1);
    return sc;
}

pub fn FSSet(c: FirestoreConn, collection: pchar, docId: pchar, doc: int64): int64 {
  var collectionAdr: int64 := collection as int64;   // #1613
  var docIdAdr: int64 := docId as int64;   // #1613
    return FSCreate(c, collection, docId, doc);
}

pub fn FSDelete(c: FirestoreConn, collection: pchar, docId: pchar): int64 {
  var collectionAdr: int64 := collection as int64;   // #1613
  var docIdAdr: int64 := docId as int64;   // #1613
    var path: int64 := fsPath(c, collectionAdr, docIdAdr);
    var r: GCPResponse := GCPDelete(c.client, path as pchar);
    var sc: int64 := r.statusCode;
    GCPResponseFree(r);
    free(path, fsStrLen(path) + 1);
    return sc;
}

pub fn FSExists(c: FirestoreConn, collection: pchar, docId: pchar): int64 {
  var collectionAdr: int64 := collection as int64;   // #1613
  var docIdAdr: int64 := docId as int64;   // #1613
    var path: int64 := fsPath(c, collectionAdr, docIdAdr);
    var r: GCPResponse := GCPGet(c.client, path as pchar);
    var sc: int64 := r.statusCode;
    GCPResponseFree(r);
    free(path, fsStrLen(path) + 1);
    if (sc == 200) { return 1; }
    return 0;
}

// FSList — returns raw GCPResponse with documents list JSON
pub fn FSList(c: FirestoreConn, collection: pchar, pageSize: int64): GCPResponse {
  var collectionAdr: int64 := collection as int64;   // #1613
    var pfx: int64    := "/v1/projects/" as int64;
    var mid: int64    := "/databases/(default)/documents/" as int64;
    var pl: int64     := fsStrLen(c.project);
    var cl: int64     := fsStrLen(collectionAdr);
    var pfxLen: int64 := fsStrLen(pfx);
    var midLen: int64 := fsStrLen(mid);
    var path: int64   := alloc(pfxLen + pl + midLen + cl + 32);
    var pos: int64 := 0;
    pos := fsAppend(path, pos, pfx, pfxLen);
    pos := fsAppend(path, pos, c.project, pl);
    pos := fsAppend(path, pos, mid, midLen);
    pos := fsAppend(path, pos, collectionAdr, cl);
    var psSfx: int64 := "?pageSize=" as int64;
    pos := fsAppend(path, pos, psSfx, fsStrLen(psSfx));
    pos := fsAppendInt(path, pos, pageSize);
    poke8(path + pos, 0);
    var r: GCPResponse := GCPGet(c.client, path as pchar);
    free(path, pfxLen + pl + midLen + cl + 32);
    return r;
}
