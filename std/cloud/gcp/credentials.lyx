// std/cloud/gcp/credentials.lyx — Application Default Credentials (WP-GCP-04)
//
// Public API:
//   GCPCredentialsFromFile(path, scope) -> GCPCredentials
//   GCPCredentialsFromEnv(scope) -> GCPCredentials
//   GCPCredentialsFromADC(scope) -> GCPCredentials
//   GCPCredentialsDefault(scope) -> GCPCredentials
//   GCPGetToken(creds) -> int64  (access_token pchar, valid until refreshed)
//   GCPCredentialsFree(creds)
//   GCPIsRunningOnGCE() -> int64 (1=yes, 0=no)

unit std.cloud.gcp.credentials;

import std.env;

import std.cloud.gcp.jwt;
import std.cloud.gcp.oauth;
import std.alloc;
import std.fs;
import std.net.dns;
import std.net.types;
import std.net.socket;

// #1179: Hier stand `extern fn getenv(name: pchar): pchar;` OHNE
// link-Klausel — das Symbol wurde nie gebunden, der Aufruf lieferte still 0,
// und jede Abfrage sah aus wie eine nicht gesetzte Variable. Die Umgebung
// liegt beim Start auf dem Stack; std.env liest sie ohne C-Bibliothek.
fn getenv(name: pchar): pchar { return EnvLookupRaw(name); }

// ── Credential type constants ─────────────────────────────────────────────────

pub con GCP_CREDS_SERVICE_ACCOUNT: int64 := 1;
pub con GCP_CREDS_REFRESH_TOKEN:   int64 := 2;
pub con GCP_CREDS_METADATA:        int64 := 3;

// ── GCPCredentials ────────────────────────────────────────────────────────────

// GCPRefreshCreds holds OAuth 2.0 refresh-token credentials
pub type GCPRefreshCreds = struct {
    clientId:     int64;   // pchar
    clientSecret: int64;   // pchar
    refreshToken: int64;   // pchar
};

pub type GCPCredentials = struct {
    credType:  int64;   // GCP_CREDS_* constant
    project:   int64;   // pchar (may be 0)
    sa:        GCPServiceAccount;  // valid when credType == GCP_CREDS_SERVICE_ACCOUNT
    refresh:   GCPRefreshCreds;    // valid when credType == GCP_CREDS_REFRESH_TOKEN
    scope:     int64;   // pchar (OAuth scope used during refresh)
    // Cached token
    token:     GCPToken;
};

// ── Internal helpers ──────────────────────────────────────────────────────────

fn credsStrLen(s: int64): int64 {
    if (s == 0) { return 0; }
    var i: int64 := 0;
    while (peek8(s + i) != 0) { i := i + 1; }
    return i;
}

fn credsStrDupN(src: int64, n: int64): int64 {
    var buf: int64 := alloc(n + 1);
    var i: int64 := 0;
    while (i < n) { poke8(buf + i, peek8(src + i)); i := i + 1; }
    poke8(buf + n, 0);
    return buf;
}

fn credsStrDup(src: int64): int64 {
    if (src == 0) { return 0; }
    return credsStrDupN(src, credsStrLen(src));
}

fn credsJSONExtract(json: int64, jsonLen: int64, key: int64): int64 {
    var kl: int64 := credsStrLen(key);
    var i: int64 := 0;
    while (i < jsonLen - kl - 3) {
        if ((peek8(json + i) & 0xFF) == 34) {
            var isMatch: int64 := 1;
            var j: int64 := 0;
            while (j < kl) {
                if ((peek8(json + i + 1 + j) & 0xFF) != (peek8(key + j) & 0xFF)) {
                    isMatch := 0; break;
                }
                j += 1;
            }
            if ((isMatch == 1) & ((peek8(json + i + 1 + kl) & 0xFF) == 34)) {
                var k: int64 := i + kl + 2;
                while ((k < jsonLen) & (peek8(json + k) == 32)) { k := k + 1; }
                if ((k < jsonLen) & ((peek8(json + k) & 0xFF) == 58)) {
                    k += 1;
                    while ((k < jsonLen) & (peek8(json + k) == 32)) { k := k + 1; }
                    if ((k < jsonLen) & ((peek8(json + k) & 0xFF) == 34)) {
                        k += 1;
                        var vs: int64 := k;
                        while ((k < jsonLen) & ((peek8(json + k) & 0xFF) != 34)) { k := k + 1; }
                        return credsStrDupN(json + vs, k - vs);
                    }
                }
            }
        }
        i += 1;
    }
    return 0;
}

// Check if JSON has a string field matching a value
fn credsJSONHasValue(json: int64, jsonLen: int64, key: int64, val: int64): int64 {
    var found: int64 := credsJSONExtract(json, jsonLen, key);
    if (found == 0) { return 0; }
    var fl: int64 := credsStrLen(found);
    var vl: int64 := credsStrLen(val);
    var isMatch: int64 := 0;
    if (fl == vl) {
        isMatch := 1;
        var i: int64 := 0;
        while (i < fl) {
            if ((peek8(found + i) & 0xFF) != (peek8(val + i) & 0xFF)) { isMatch := 0; break; }
            i += 1;
        }
    }
    free(found, fl + 1);
    return isMatch;
}

fn emptyToken(): GCPToken {
    var t: GCPToken;
    t.accessToken := 0; t.tokenLen := 0; t.expiresAt := 0; t.tokenType := 0;
    return t;
}

fn emptyRefresh(): GCPRefreshCreds {
    var r: GCPRefreshCreds;
    r.clientId := 0; r.clientSecret := 0; r.refreshToken := 0;
    return r;
}

fn emptySA(): GCPServiceAccount {
    var sa: GCPServiceAccount;
    sa.projectId := 0; sa.clientEmail := 0; sa.privateKey := 0; sa.tokenUri := 0;
    return sa;
}

fn credsEmpty(): GCPCredentials {
    var c: GCPCredentials;
    c.credType := 0; c.project := 0; c.scope := 0;
    c.sa      := emptySA();
    c.refresh  := emptyRefresh();
    c.token    := emptyToken();
    return c;
}

// Parse JSON from a credentials file. Determines type and fills sa/refresh.
fn credsParseJSON(json: int64, jsonLen: int64, scope: int64): GCPCredentials {
    var c: GCPCredentials := credsEmpty();
    c.scope := credsStrDup(scope);
    var typ: int64 := credsJSONExtract(json, jsonLen, "type" as int64);
    if (typ == 0) { return c; }

    var saType: int64   := "service_account" as int64;
    var authType: int64 := "authorized_user" as int64;
    if (credsJSONHasValue(json, jsonLen, "type" as int64, saType) == 1) {
        c.credType := GCP_CREDS_SERVICE_ACCOUNT;
        c.sa       := GCPServiceAccountFromJSON(json, jsonLen);
        c.project  := credsStrDup(c.sa.projectId as int64);
    } else if (credsJSONHasValue(json, jsonLen, "type" as int64, authType) == 1) {
        c.credType            := GCP_CREDS_REFRESH_TOKEN;
        c.refresh.clientId    := credsJSONExtract(json, jsonLen, "client_id" as int64);
        c.refresh.clientSecret := credsJSONExtract(json, jsonLen, "client_secret" as int64);
        c.refresh.refreshToken := credsJSONExtract(json, jsonLen, "refresh_token" as int64);
        c.project             := credsJSONExtract(json, jsonLen, "quota_project_id" as int64);
    }
    var tl: int64 := credsStrLen(typ);
    free(typ, tl + 1);
    return c;
}

// ── Public API ────────────────────────────────────────────────────────────────

// Load credentials from a JSON file (service account or authorized_user)
pub fn GCPCredentialsFromFile(path: int64, scope: int64): GCPCredentials {
    var c: GCPCredentials := credsEmpty();
    var data: pchar := FileReadAll(path as pchar);
    if (data == 0 as pchar) { return c; }
    var dl: int64 := credsStrLen(data as int64);
    c := credsParseJSON(data as int64, dl, scope);
    FileReadFree(data);
    return c;
}

// Load credentials from GOOGLE_APPLICATION_CREDENTIALS env var
pub fn GCPCredentialsFromEnv(scope: int64): GCPCredentials {
    var c: GCPCredentials := credsEmpty();
    var path: pchar := getenv("GOOGLE_APPLICATION_CREDENTIALS"c);
    if (path == 0 as pchar) { return c; }
    return GCPCredentialsFromFile(path as int64, scope);
}

// Load from ~/.config/gcloud/application_default_credentials.json (ADC)
pub fn GCPCredentialsFromADC(scope: int64): GCPCredentials {
    var c: GCPCredentials := credsEmpty();
    var home: pchar := getenv("HOME"c);
    if (home == 0 as pchar) { return c; }
    var homeLen: int64 := credsStrLen(home as int64);
    var suffix: int64  := "/.config/gcloud/application_default_credentials.json" as int64;
    var sfxLen: int64  := credsStrLen(suffix);
    var pathBuf: int64 := alloc(homeLen + sfxLen + 1);
    var i: int64 := 0;
    while (i < homeLen) { poke8(pathBuf + i, peek8(home as int64 + i)); i := i + 1; }
    var j: int64 := 0;
    while (j < sfxLen)  { poke8(pathBuf + i, peek8(suffix + j)); i := i + 1; j := j + 1; }
    poke8(pathBuf + homeLen + sfxLen, 0);
    c := GCPCredentialsFromFile(pathBuf, scope);
    free(pathBuf, homeLen + sfxLen + 1);
    return c;
}

pub fn GCPCredentialsFromMetadata(scope: int64): GCPCredentials {
    var c: GCPCredentials := credsEmpty();
    c.credType := GCP_CREDS_METADATA;
    c.scope    := credsStrDup(scope);
    return c;
}

// GCPIsRunningOnGCE — checks if GCE metadata server is reachable
pub fn GCPIsRunningOnGCE(): int64 {
    var host: int64 := "metadata.google.internal" as int64;
    var ip: int64   := GetHostByName(host);
    if (ip == 0) { return 0; }
    return 1;
}

// GCPCredentialsDefault — credential chain (env → ADC → metadata)
pub fn GCPCredentialsDefault(scope: int64): GCPCredentials {
    var c: GCPCredentials := GCPCredentialsFromEnv(scope);
    if (c.credType != 0) { return c; }
    c := GCPCredentialsFromADC(scope);
    if (c.credType != 0) { return c; }
    if (GCPIsRunningOnGCE() == 1) {
        return GCPCredentialsFromMetadata(scope);
    }
    return credsEmpty();
}

// GCPGetToken — get (and auto-refresh) access token string.
// Returns pchar pointer into creds.token.accessToken (valid until next call).
pub fn GCPGetToken(creds: int64): int64 {
    var c: GCPCredentials := creds as GCPCredentials;
    // Check if cached token is still valid
    if ((c.token.accessToken != 0) & (GCPTokenIsExpired(c.token) == 0)) {
        return c.token.accessToken;
    }
    // Free old token
    GCPTokenFree(c.token);
    poke64(creds + 96, 0); // reset token.accessToken
    poke64(creds + 104, 0);
    poke64(creds + 112, 0);
    poke64(creds + 120, 0);

    var newToken: GCPToken;
    newToken.accessToken := 0; newToken.tokenLen := 0; newToken.expiresAt := 0; newToken.tokenType := 0;

    if (c.credType == GCP_CREDS_SERVICE_ACCOUNT) {
        newToken := GCPTokenFromServiceAccount(c.sa, c.scope);
    } else if (c.credType == GCP_CREDS_REFRESH_TOKEN) {
        newToken := GCPTokenFromRefresh(c.refresh.clientId, c.refresh.clientSecret, c.refresh.refreshToken);
    } else if (c.credType == GCP_CREDS_METADATA) {
        newToken := GCPTokenFromMetadata();
    }

    // Store new token in creds struct (offset 96 = after credType+project+sa+refresh+scope)
    // GCPCredentials layout:
    //   credType   int64  @ 0
    //   project    int64  @ 8
    //   sa:        GCPServiceAccount (4 fields × 8 = 32) @ 16
    //   refresh:   GCPRefreshCreds   (3 fields × 8 = 24) @ 48
    //   scope      int64  @ 72
    //   token:     GCPToken (4 fields × 8 = 32) @ 80
    poke64(creds + 80, newToken.accessToken);
    poke64(creds + 88, newToken.tokenLen);
    poke64(creds + 96, newToken.expiresAt);
    poke64(creds + 104, newToken.tokenType);

    return newToken.accessToken;
}

pub fn GCPCredentialsFree(creds: GCPCredentials): void {
    if (creds.project != 0) { free(creds.project, credsStrLen(creds.project) + 1); }
    if (creds.scope   != 0) { free(creds.scope,   credsStrLen(creds.scope)   + 1); }
    if (creds.credType == GCP_CREDS_SERVICE_ACCOUNT) {
        GCPServiceAccountFree(creds.sa);
    } else if (creds.credType == GCP_CREDS_REFRESH_TOKEN) {
        if (creds.refresh.clientId    != 0) { free(creds.refresh.clientId,    credsStrLen(creds.refresh.clientId)    + 1); }
        if (creds.refresh.clientSecret != 0) { free(creds.refresh.clientSecret, credsStrLen(creds.refresh.clientSecret) + 1); }
        if (creds.refresh.refreshToken != 0) { free(creds.refresh.refreshToken, credsStrLen(creds.refresh.refreshToken) + 1); }
    }
    GCPTokenFree(creds.token);
}
