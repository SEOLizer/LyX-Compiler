// std/cloud/gcp/logging.lyx — Cloud Logging + Cloud Monitoring (WP-GCP-11)
//
// Public API (Logging):
//   LogConnect(credsPtr, project) -> LogConn
//   LogDisconnect(c)
//   LogWrite(c, logName, severity, message) -> int64 (status)
//   LogWriteJSON(c, logName, severity, jsonPayload, jsonLen) -> int64 (status)
//   LogList(c, logName, filter, pageSize) -> GCPResponse
//
// Public API (Monitoring):
//   MonConnect(credsPtr, project) -> MonConn
//   MonDisconnect(c)
//   MonWriteMetric(c, metricType, value, labels) -> int64 (status)
//   MonListMetrics(c, filter) -> GCPResponse
//   MonCreateAlertPolicy(c, policy, policyLen) -> int64 (status)
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, process.exec, process.fork, process.signal, system.env, system.time])

unit std.cloud.gcp.logging;

import std.cloud.gcp.transport;
import std.alloc;
import std.time;

// ── Types ─────────────────────────────────────────────────────────────────────

pub type LogConn = struct {
    client:  GCPClient;
    project: int64;   // pchar
};

pub type MonConn = struct {
    client:  GCPClient;
    project: int64;   // pchar
};

// Log severity constants
pub con LOG_DEFAULT:   int64 := 0;
pub con LOG_DEBUG:     int64 := 100;
pub con LOG_INFO:      int64 := 200;
pub con LOG_NOTICE:    int64 := 300;
pub con LOG_WARNING:   int64 := 400;
pub con LOG_ERROR:     int64 := 500;
pub con LOG_CRITICAL:  int64 := 600;
pub con LOG_ALERT:     int64 := 700;
pub con LOG_EMERGENCY: int64 := 800;

// ── Internal helpers ──────────────────────────────────────────────────────────

fn logStrLen(s: int64): int64 {
    if (s == 0) { return 0; }
    var i: int64 := 0; while (peek8(s + i) != 0) { i := i + 1; } return i;
}

fn logStrDup(src: int64): int64 {
    if (src == 0) { return 0; }
    var n: int64 := logStrLen(src);
    var buf: int64 := alloc(n + 1);
    var i: int64 := 0;
    while (i < n) { poke8(buf + i, peek8(src + i)); i := i + 1; }
    poke8(buf + n, 0); return buf;
}

fn logAppend(dst: int64, pos: int64, src: int64, n: int64): int64 {
    var i: int64 := 0;
    while (i < n) { poke8(dst + pos + i, peek8(src + i)); i := i + 1; }
    return pos + n;
}

fn logAppendStr(dst: int64, pos: int64, s: int64): int64 {
    return logAppend(dst, pos, s, logStrLen(s));
}

fn logAppendInt(dst: int64, pos: int64, n: int64): int64 {
    if (n == 0) { poke8(dst + pos, 48); return pos + 1; }
    var tmp: int64 := alloc(24); var tl: int64 := 0; var v: int64 := n;
    if (v < 0) { poke8(dst + pos, 45); pos := pos + 1; v := 0 - v; }
    while (v > 0) { poke8(tmp + tl, 48 + (v - ((v / 10) * 10))); v := v / 10; tl := tl + 1; }
    var i: int64 := 0;
    while (i < tl) { poke8(dst + pos + i, peek8(tmp + tl - 1 - i)); i := i + 1; }
    free(tmp, 24); return pos + tl;
}

// severity code → string
fn logSeverityStr(sev: int64): int64 {
    if (sev >= LOG_EMERGENCY) { return "EMERGENCY" as int64; }
    if (sev >= LOG_ALERT)     { return "ALERT" as int64; }
    if (sev >= LOG_CRITICAL)  { return "CRITICAL" as int64; }
    if (sev >= LOG_ERROR)     { return "ERROR" as int64; }
    if (sev >= LOG_WARNING)   { return "WARNING" as int64; }
    if (sev >= LOG_NOTICE)    { return "NOTICE" as int64; }
    if (sev >= LOG_INFO)      { return "INFO" as int64; }
    if (sev >= LOG_DEBUG)     { return "DEBUG" as int64; }
    return "DEFAULT" as int64;
}

// ── Cloud Logging ─────────────────────────────────────────────────────────────

pub fn LogConnect(creds: GCPCredentials, project: pchar): LogConn {
  var projectAdr: int64 := project as int64;   // #1613
    var credsPtr: int64 := creds as int64;   // #1616
    var c: LogConn;
    c.client  := GCPClientNew(credsPtr, project, "logging.googleapis.com"c);
    c.project := logStrDup(projectAdr);
    return c;
}

pub fn LogDisconnect(c: LogConn): void {
    GCPClientFree(c.client);
    if (c.project != 0) { free(c.project, logStrLen(c.project) + 1); }
}

// LogWrite — write a text message to Cloud Logging
pub fn LogWrite(c: LogConn, logName: int64, severity: int64, message: int64): int64 {
    var pl: int64   := logStrLen(c.project);
    var lnl: int64  := logStrLen(logName);
    var ml: int64   := logStrLen(message);
    var sevStr: int64 := logSeverityStr(severity);
    var sevLen: int64 := logStrLen(sevStr);

    // Build log name: projects/{project}/logs/{logName}
    var fullLogName: int64 := alloc(pl + lnl + 32);
    var flnLen: int64 := 0;
    flnLen := logAppendStr(fullLogName, flnLen, "projects/" as int64);
    flnLen := logAppend(fullLogName, flnLen, c.project, pl);
    flnLen := logAppendStr(fullLogName, flnLen, "/logs/" as int64);
    flnLen := logAppend(fullLogName, flnLen, logName, lnl);
    poke8(fullLogName + flnLen, 0);

    var bodySz: int64 := 256 + pl + lnl + ml + sevLen + 32;
    var body: int64   := alloc(bodySz);
    var pos: int64 := 0;
    pos := logAppendStr(body, pos, "{\"logName\":\"" as int64);
    pos := logAppend(body, pos, fullLogName, flnLen);
    pos := logAppendStr(body, pos, "\",\"resource\":{\"type\":\"global\"},\"entries\":[{\"severity\":\"" as int64);
    pos := logAppend(body, pos, sevStr, sevLen);
    pos := logAppendStr(body, pos, "\",\"textPayload\":\"" as int64);
    pos := logAppend(body, pos, message, ml);
    pos := logAppendStr(body, pos, "\"}]}" as int64);
    poke8(body + pos, 0);

    free(fullLogName, pl + lnl + 32);

    var r: GCPResponse := GCPPost(c.client, "/v2/entries:write", body, pos);
    var sc: int64 := r.statusCode;
    GCPResponseFree(r);
    free(body, bodySz);
    return sc;
}

// LogWriteJSON — write a structured JSON payload
pub fn LogWriteJSON(c: LogConn, logName: int64, severity: int64, jsonPayload: int64, jsonLen: int64): int64 {
    var pl: int64     := logStrLen(c.project);
    var lnl: int64    := logStrLen(logName);
    var sevStr: int64 := logSeverityStr(severity);
    var sevLen: int64 := logStrLen(sevStr);

    var fullLogName: int64 := alloc(pl + lnl + 32);
    var flnLen: int64 := 0;
    flnLen := logAppendStr(fullLogName, flnLen, "projects/" as int64);
    flnLen := logAppend(fullLogName, flnLen, c.project, pl);
    flnLen := logAppendStr(fullLogName, flnLen, "/logs/" as int64);
    flnLen := logAppend(fullLogName, flnLen, logName, lnl);
    poke8(fullLogName + flnLen, 0);

    var bodySz: int64 := 256 + flnLen + jsonLen + sevLen;
    var body: int64   := alloc(bodySz);
    var pos: int64 := 0;
    pos := logAppendStr(body, pos, "{\"logName\":\"" as int64);
    pos := logAppend(body, pos, fullLogName, flnLen);
    pos := logAppendStr(body, pos, "\",\"resource\":{\"type\":\"global\"},\"entries\":[{\"severity\":\"" as int64);
    pos := logAppend(body, pos, sevStr, sevLen);
    pos := logAppendStr(body, pos, "\",\"jsonPayload\":" as int64);
    pos := logAppend(body, pos, jsonPayload, jsonLen);
    pos := logAppendStr(body, pos, "}]}" as int64);
    poke8(body + pos, 0);

    free(fullLogName, pl + lnl + 32);
    var r: GCPResponse := GCPPost(c.client, "/v2/entries:write", body, pos);
    var sc: int64 := r.statusCode;
    GCPResponseFree(r);
    free(body, bodySz);
    return sc;
}

// LogList — list log entries
pub fn LogList(c: LogConn, logName: int64, filter: int64, pageSize: int64): GCPResponse {
    var pl: int64    := logStrLen(c.project);
    var fl: int64    := logStrLen(filter);
    var bodySz: int64 := 128 + pl + fl + 1;
    var body: int64   := alloc(bodySz);
    var pos: int64 := 0;
    pos := logAppendStr(body, pos, "{\"resourceNames\":[\"projects/" as int64);
    pos := logAppend(body, pos, c.project, pl);
    pos := logAppendStr(body, pos, "\"],\"pageSize\":" as int64);
    if (pageSize <= 0) { pageSize := 100; }
    pos := logAppendInt(body, pos, pageSize);
    if (fl > 0) {
        pos := logAppendStr(body, pos, ",\"filter\":\"" as int64);
        pos := logAppend(body, pos, filter, fl);
        poke8(body + pos, 34); pos := pos + 1;
    }
    poke8(body + pos, 125); pos := pos + 1; poke8(body + pos, 0);
    var r: GCPResponse := GCPPost(c.client, "/v2/entries:list", body, pos);
    free(body, bodySz);
    return r;
}

// ── Cloud Monitoring ──────────────────────────────────────────────────────────

pub fn MonConnect(creds: GCPCredentials, project: pchar): MonConn {
  var projectAdr: int64 := project as int64;   // #1613
    var credsPtr: int64 := creds as int64;   // #1616
    var c: MonConn;
    c.client  := GCPClientNew(credsPtr, project, "monitoring.googleapis.com"c);
    c.project := logStrDup(projectAdr);
    return c;
}

pub fn MonDisconnect(c: MonConn): void {
    GCPClientFree(c.client);
    if (c.project != 0) { free(c.project, logStrLen(c.project) + 1); }
}

// MonWriteMetric — write a custom metric time series point
// metricType: e.g. "custom.googleapis.com/my_metric"
// value: integer gauge value
// labels: JSON object string or 0
pub fn MonWriteMetric(c: MonConn, metricType: int64, value: int64, labels: int64): int64 {
    var pl: int64   := logStrLen(c.project);
    var mtl: int64  := logStrLen(metricType);
    var ll: int64   := logStrLen(labels);
    var now: int64  := Now();

    var bodySz: int64 := 512 + pl + mtl + ll + 32;
    var body: int64   := alloc(bodySz);
    var pos: int64 := 0;
    pos := logAppendStr(body, pos, "{\"timeSeries\":[{\"metric\":{\"type\":\"" as int64);
    pos := logAppend(body, pos, metricType, mtl);
    pos := logAppendStr(body, pos, "\"" as int64);
    if (ll > 0) {
        pos := logAppendStr(body, pos, ",\"labels\":" as int64);
        pos := logAppend(body, pos, labels, ll);
    }
    pos := logAppendStr(body, pos, "},\"resource\":{\"type\":\"global\",\"labels\":{\"project_id\":\"" as int64);
    pos := logAppend(body, pos, c.project, pl);
    pos := logAppendStr(body, pos, "\"}},\"points\":[{\"interval\":{\"endTime\":\"" as int64);
    // RFC 3339 timestamp (simplified: just unix seconds)
    pos := logAppendInt(body, pos, now);
    pos := logAppendStr(body, pos, "Z\"},\"value\":{\"int64Value\":\"" as int64);
    pos := logAppendInt(body, pos, value);
    pos := logAppendStr(body, pos, "\"}}]}]}" as int64);
    poke8(body + pos, 0);

    var pathBuf: int64 := alloc(pl + 64);
    var pathPos: int64 := 0;
    pathPos := logAppendStr(pathBuf, pathPos, "/v3/projects/" as int64);
    pathPos := logAppend(pathBuf, pathPos, c.project, pl);
    pathPos := logAppendStr(pathBuf, pathPos, "/timeSeries" as int64);
    poke8(pathBuf + pathPos, 0);

    var r: GCPResponse := GCPPost(c.client, pathBuf as pchar, body, pos);
    var sc: int64 := r.statusCode;
    GCPResponseFree(r);
    free(body, bodySz);
    free(pathBuf, pl + 64);
    return sc;
}

// MonListMetrics — list time series for a metric
pub fn MonListMetrics(c: MonConn, filter: int64): GCPResponse {
    var pl: int64  := logStrLen(c.project);
    var fl: int64  := logStrLen(filter);
    var pathBuf: int64 := alloc(pl + fl + 64);
    var pos: int64 := 0;
    pos := logAppendStr(pathBuf, pos, "/v3/projects/" as int64);
    pos := logAppend(pathBuf, pos, c.project, pl);
    pos := logAppendStr(pathBuf, pos, "/timeSeries?filter=" as int64);
    if (fl > 0) { pos := logAppend(pathBuf, pos, filter, fl); }
    poke8(pathBuf + pos, 0);
    var r: GCPResponse := GCPGet(c.client, pathBuf as pchar);
    free(pathBuf, pl + fl + 64);
    return r;
}

// MonCreateAlertPolicy — create an alert policy
pub fn MonCreateAlertPolicy(c: MonConn, policy: int64, policyLen: int64): int64 {
    var pl: int64 := logStrLen(c.project);
    var pathBuf: int64 := alloc(pl + 64);
    var pos: int64 := 0;
    pos := logAppendStr(pathBuf, pos, "/v3/projects/" as int64);
    pos := logAppend(pathBuf, pos, c.project, pl);
    pos := logAppendStr(pathBuf, pos, "/alertPolicies" as int64);
    poke8(pathBuf + pos, 0);
    var r: GCPResponse := GCPPost(c.client, pathBuf as pchar, policy, policyLen);
    var sc: int64 := r.statusCode;
    GCPResponseFree(r);
    free(pathBuf, pl + 64);
    return sc;
}
