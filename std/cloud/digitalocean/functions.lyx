pub fn FunctionInvoke(creds: DOCredentials, namespaceId: pchar,
                      functionName: pchar, paramsJson: int64, paramsLen: int64): int64 {
    var cl: DOClient := doClientFunctions(creds);
    var pathBuf: int64 := alloc(512);
    doMakePath3(pathBuf, "/v2/functions/namespaces/"c, namespaceId, "/actions/"c);
    var existLen: int64 := StrLen(pathBuf as pchar);
    var fl: int64 := StrLen(functionName);
    var i: int64 := 0;
    while(i<fl){poke8(pathBuf+existLen+i,StrCharAt(functionName,i)&0xFF);i:=i+1;}
    var sfx: pchar := "?blocking=true"c; var sl: int64 := StrLen(sfx);
    i:=0; while(i<sl){poke8(pathBuf+existLen+fl+i,StrCharAt(sfx,i)&0xFF);i:=i+1;}
    poke8(pathBuf+existLen+fl+sl,0);
    var resp: HTTPResponse := DOPost(cl, pathBuf as pchar, paramsJson, paramsLen);
    var result: int64 := 0;
    if ((resp.statusCode == 200 || resp.statusCode == 202) && resp.bodyPtr != 0) {
        result := resp.bodyPtr;
        resp.bodyPtr := 0;
    }
    HTTPResponseFree(resp);
    free(pathBuf, 512);
    return result;
}

pub fn FunctionUpdate(creds: DOCredentials, namespaceId: pchar,
                      functionName: pchar, source: pchar, runtime: pchar): DOFunction {
    var f: DOFunction;
    f.name := 0; f.namespace := 0; f.runtime := 0; f.updatedAt := 0;
    var cl: DOClient := doClientFunctions(creds);
    var buf: int64 := alloc(4096);
    var off: int64 := 0;
    poke8(buf,123); off:=1; // '{'
    if (source != 0 as pchar) {
        var h: pchar := "\"source\":\""c; var lh: int64 := StrLen(h);
        var i: int64 := 0;
        while(i<lh){poke8(buf+off+i,StrCharAt(h,i)&0xFF);i:=i+1;} off:=off+lh;
        var sl: int64 := StrLen(source);
        i:=0; while(i<sl){poke8(buf+off+i,StrCharAt(source,i)&0xFF);i:=i+1;} off:=off+sl;
        poke8(buf+off,34); off:=off+1; // '"'
    }
    if (runtime != 0 as pchar) {
        if (off > 1) { poke8(buf+off,44); off:=off+1; } // ','
        var h2: pchar := "\"runtime\":\""c; var lh2: int64 := StrLen(h2);
        var i2: int64 := 0;
        while(i2<lh2){poke8(buf+off+i2,StrCharAt(h2,i2)&0xFF);i2:=i2+1;} off:=off+lh2;
        var rl: int64 := StrLen(runtime);
        i2:=0; while(i2<rl){poke8(buf+off+i2,StrCharAt(runtime,i2)&0xFF);i2:=i2+1;} off:=off+rl;
        poke8(buf+off,34); off:=off+1;
    }
    poke8(buf+off,125); off:=off+1; poke8(buf+off,0); // '}'
    var pathBuf: int64 := alloc(512);
    doMakePath3(pathBuf, "/v2/functions/namespaces/"c, namespaceId, "/actions/"c);
    var existLen: int64 := StrLen(pathBuf as pchar);
    var fl: int64 := StrLen(functionName);
    var j: int64 := 0;
    while(j<fl){poke8(pathBuf+existLen+j,StrCharAt(functionName,j)&0xFF);j:=j+1;}
    poke8(pathBuf+existLen+fl,0);
    var resp: HTTPResponse := DOPut(cl, pathBuf as pchar, buf, off);
    free(buf, 4096);
    if (resp.statusCode == 200 && resp.bodyPtr != 0) { f := parseFunction(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 512);
    return f;
}

pub fn TriggerCreate(creds: DOCredentials, namespaceId: pchar,
                     functionName: pchar, triggerName: pchar,
                     cronExpr: pchar): int64 {
    var cl: DOClient := doClientFunctions(creds);
    var buf: int64 := alloc(512);
    var h: pchar := "{\"name\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(buf+i,StrCharAt(h,i)&0xFF);i:=i+1;}
    var tnl: int64 := StrLen(triggerName);
    i:=0; while(i<tnl){poke8(buf+lh+i,StrCharAt(triggerName,i)&0xFF);i:=i+1;}
    var s2: pchar := "\",\"function\":\""c; var l2: int64 := StrLen(s2);
    var off: int64 := lh+tnl;
    i:=0; while(i<l2){poke8(buf+off+i,StrCharAt(s2,i)&0xFF);i:=i+1;} off:=off+l2;
    var fnl: int64 := StrLen(functionName);
    i:=0; while(i<fnl){poke8(buf+off+i,StrCharAt(functionName,i)&0xFF);i:=i+1;} off:=off+fnl;
    var s3: pchar := "\",\"type\":\"SCHEDULED\",\"is_enabled\":true,\"scheduled_details\":{\"cron\":\""c;
    var l3: int64 := StrLen(s3);
    i:=0; while(i<l3){poke8(buf+off+i,StrCharAt(s3,i)&0xFF);i:=i+1;} off:=off+l3;
    var cl2: int64 := StrLen(cronExpr);
    i:=0; while(i<cl2){poke8(buf+off+i,StrCharAt(cronExpr,i)&0xFF);i:=i+1;} off:=off+cl2;
    var tail: pchar := "\"}}"c; var tl: int64 := StrLen(tail);
    i:=0; while(i<tl){poke8(buf+off+i,StrCharAt(tail,i)&0xFF);i:=i+1;} off:=off+tl;
    poke8(buf+off,0);
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/functions/namespaces/"c, namespaceId, "/triggers"c);
    var resp: HTTPResponse := DOPost(cl, pathBuf as pchar, buf, off);
    var ok: int64 := 0;
    if (resp.statusCode == 200 || resp.statusCode == 201) { ok := 1; }
    HTTPResponseFree(resp);
    free(buf, 512);
    free(pathBuf, 256);
    return ok;
}

