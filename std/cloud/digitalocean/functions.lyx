// std/cloud/do/functions.lyx — DigitalOcean Serverless Functions (Namespaces + Functions)
// WP-DO-11
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, system.env, system.time])

unit std.cloud.digitalocean.functions;

import std.cloud.digitalocean.transport;
import std.cloud.digitalocean.credentials;
import std.alloc;
import std.io;
import std.time;

pub type DONamespace = struct {
    uuid:      int64;  // pchar (alloc'd)
    label:     int64;  // pchar (alloc'd)
    region:    int64;  // pchar (alloc'd)
    apiHost:   int64;  // pchar (alloc'd)
    uuid2:     int64;  // alias namespace field
};

pub fn DONamespaceFree(n: DONamespace) {
    if (n.uuid    != 0) { free(n.uuid,    StrLen(n.uuid    as pchar) + 1); }
    if (n.label   != 0) { free(n.label,   StrLen(n.label   as pchar) + 1); }
    if (n.region  != 0) { free(n.region,  StrLen(n.region  as pchar) + 1); }
    if (n.apiHost != 0) { free(n.apiHost, StrLen(n.apiHost as pchar) + 1); }
}

pub type DOFunction = struct {
    name:      int64;  // pchar (alloc'd)
    namespace: int64;  // pchar (alloc'd)
    runtime:   int64;  // pchar e.g. "nodejs:14" (alloc'd)
    updatedAt: int64;  // pchar (alloc'd)
};

pub fn DOFunctionFree(f: DOFunction) {
    if (f.name      != 0) { free(f.name,      StrLen(f.name      as pchar) + 1); }
    if (f.namespace != 0) { free(f.namespace, StrLen(f.namespace as pchar) + 1); }
    if (f.runtime   != 0) { free(f.runtime,   StrLen(f.runtime   as pchar) + 1); }
    if (f.updatedAt != 0) { free(f.updatedAt, StrLen(f.updatedAt as pchar) + 1); }
}

fn doClientFunctions(creds: DOCredentials): DOClient {
    var c: DOClient; c.token := creds.token; c.tokenLen := creds.tokenLen; return c;
}

fn parseNamespace(json: int64): DONamespace {
    var n: DONamespace;
    n.uuid    := doJsonStr(json, "uuid"c);
    n.label   := doJsonStr(json, "label"c);
    n.region  := doJsonStr(json, "region"c);
    n.apiHost := doJsonStr(json, "api_host"c);
    n.uuid2   := 0;
    return n;
}

fn parseFunction(json: int64): DOFunction {
    var f: DOFunction;
    f.name      := doJsonStr(json, "name"c);
    f.namespace := doJsonStr(json, "namespace"c);
    f.runtime   := doJsonStr(json, "runtime"c);
    f.updatedAt := doJsonStr(json, "updated_at"c);
    return f;
}

pub fn NamespaceCreate(creds: DOCredentials, region: pchar, label: pchar): DONamespace {
    var ns: DONamespace;
    ns.uuid := 0; ns.label := 0; ns.region := 0; ns.apiHost := 0; ns.uuid2 := 0;
    var buf: int64 := alloc(256);
    var h: pchar := "{\"region\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(buf+i,StrCharAt(h,i)&0xFF);i:=i+1;}
    var rl: int64 := StrLen(region);
    i:=0; while(i<rl){poke8(buf+lh+i,StrCharAt(region,i)&0xFF);i:=i+1;}
    var s2: pchar := "\",\"label\":\""c; var l2: int64 := StrLen(s2);
    i:=0; while(i<l2){poke8(buf+lh+rl+i,StrCharAt(s2,i)&0xFF);i:=i+1;}
    var ll: int64 := StrLen(label);
    var off: int64 := lh+rl+l2;
    i:=0; while(i<ll){poke8(buf+off+i,StrCharAt(label,i)&0xFF);i:=i+1;} off:=off+ll;
    var tail: pchar := "\"}"c; var tl: int64 := StrLen(tail);
    i:=0; while(i<tl){poke8(buf+off+i,StrCharAt(tail,i)&0xFF);i:=i+1;} off:=off+tl;
    poke8(buf+off,0);
    var cl: DOClient := doClientFunctions(creds);
    var resp: HTTPResponse := DOPost(cl, "/v2/functions/namespaces"c, buf, off);
    free(buf, 256);
    if ((resp.statusCode == 200 || resp.statusCode == 201) && resp.bodyPtr != 0) {
        ns := parseNamespace(resp.bodyPtr);
    }
    HTTPResponseFree(resp);
    return ns;
}

pub fn NamespaceDelete(creds: DOCredentials, namespaceId: pchar): int64 {
    var cl: DOClient := doClientFunctions(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath(pathBuf, "/v2/functions/namespaces/"c, namespaceId);
    var resp: HTTPResponse := DODelete(cl, pathBuf as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 200 || resp.statusCode == 204) { ok := 1; }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return ok;
}

pub fn NamespaceGet(creds: DOCredentials, namespaceId: pchar): DONamespace {
    var ns: DONamespace;
    ns.uuid := 0; ns.label := 0; ns.region := 0; ns.apiHost := 0; ns.uuid2 := 0;
    var cl: DOClient := doClientFunctions(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath(pathBuf, "/v2/functions/namespaces/"c, namespaceId);
    var resp: HTTPResponse := DOGet(cl, pathBuf as pchar);
    if (resp.statusCode == 200 && resp.bodyPtr != 0) { ns := parseNamespace(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return ns;
}

pub fn NamespaceList(creds: DOCredentials): int64 {
    var cl: DOClient := doClientFunctions(creds);
    return DOGetAll(cl, "/v2/functions/namespaces"c, "namespaces"c);
}

pub fn FunctionCreate(creds: DOCredentials, namespaceId: pchar,
                      name: pchar, runtime: pchar, source: pchar): DOFunction {
    var f: DOFunction;
    f.name := 0; f.namespace := 0; f.runtime := 0; f.updatedAt := 0;
    var buf: int64 := alloc(4096);
    var h: pchar := "{\"name\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(buf+i,StrCharAt(h,i)&0xFF);i:=i+1;}
    var nl: int64 := StrLen(name);
    i:=0; while(i<nl){poke8(buf+lh+i,StrCharAt(name,i)&0xFF);i:=i+1;}
    var s2: pchar := "\",\"runtime\":\""c; var l2: int64 := StrLen(s2);
    var off: int64 := lh+nl;
    i:=0; while(i<l2){poke8(buf+off+i,StrCharAt(s2,i)&0xFF);i:=i+1;} off:=off+l2;
    var rtl: int64 := StrLen(runtime);
    i:=0; while(i<rtl){poke8(buf+off+i,StrCharAt(runtime,i)&0xFF);i:=i+1;} off:=off+rtl;
    if (source != 0 as pchar) {
        var s3: pchar := "\",\"source\":\""c; var l3: int64 := StrLen(s3);
        i:=0; while(i<l3){poke8(buf+off+i,StrCharAt(s3,i)&0xFF);i:=i+1;} off:=off+l3;
        var sl: int64 := StrLen(source);
        i:=0; while(i<sl){poke8(buf+off+i,StrCharAt(source,i)&0xFF);i:=i+1;} off:=off+sl;
    }
    var tail: pchar := "\"}"c; var tl: int64 := StrLen(tail);
    i:=0; while(i<tl){poke8(buf+off+i,StrCharAt(tail,i)&0xFF);i:=i+1;} off:=off+tl;
    poke8(buf+off,0);
    var cl: DOClient := doClientFunctions(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/functions/namespaces/"c, namespaceId, "/actions"c);
    var resp: HTTPResponse := DOPost(cl, pathBuf as pchar, buf, off);
    free(buf, 4096);
    if ((resp.statusCode == 200 || resp.statusCode == 201) && resp.bodyPtr != 0) {
        f := parseFunction(resp.bodyPtr);
    }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return f;
}

pub fn FunctionDelete(creds: DOCredentials, namespaceId: pchar, functionName: pchar): int64 {
    var cl: DOClient := doClientFunctions(creds);
    var pathBuf: int64 := alloc(512);
    doMakePath3(pathBuf, "/v2/functions/namespaces/"c, namespaceId, "/actions/"c);
    var existLen: int64 := StrLen(pathBuf as pchar);
    var fl: int64 := StrLen(functionName);
    var i: int64 := 0;
    while(i<fl){poke8(pathBuf+existLen+i,StrCharAt(functionName,i)&0xFF);i:=i+1;}
    poke8(pathBuf+existLen+fl,0);
    var resp: HTTPResponse := DODelete(cl, pathBuf as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 200 || resp.statusCode == 204) { ok := 1; }
    HTTPResponseFree(resp);
    free(pathBuf, 512);
    return ok;
}

