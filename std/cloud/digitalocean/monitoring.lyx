unit std.cloud.digitalocean.monitoring;

import std.cloud.digitalocean.transport;
import std.cloud.digitalocean.credentials;
import std.alloc;
import std.io;

pub type DOAlert = struct {
    uuid:        int64;  // pchar (alloc'd)
    name:        int64;  // pchar (alloc'd)
    alertType:   int64;  // pchar (alloc'd)
    compare:     int64;  // pchar "GreaterThan" | "LessThan" (alloc'd)
    value:       int64;  // threshold as int64 * 100 (e.g. 80.5 -> 8050)
    window:      int64;  // pchar "5m" | "10m" | "30m" | "1h" (alloc'd)
    enabled:     int64;
    emails:      int64;  // pchar comma-separated (alloc'd)
    slackChannel: int64; // pchar (alloc'd)
};

pub fn DOAlertFree(a: DOAlert) {
    if (a.uuid         != 0) { free(a.uuid,         StrLen(a.uuid         as pchar) + 1); }
    if (a.name         != 0) { free(a.name,          StrLen(a.name         as pchar) + 1); }
    if (a.alertType    != 0) { free(a.alertType,    StrLen(a.alertType    as pchar) + 1); }
    if (a.compare      != 0) { free(a.compare,      StrLen(a.compare      as pchar) + 1); }
    if (a.window       != 0) { free(a.window,       StrLen(a.window       as pchar) + 1); }
    if (a.emails       != 0) { free(a.emails,       StrLen(a.emails       as pchar) + 1); }
    if (a.slackChannel != 0) { free(a.slackChannel, StrLen(a.slackChannel as pchar) + 1); }
}

pub type DOMetricResult = struct {
    metric:     int64;  // pchar key (alloc'd)
    timestamps: int64;  // pchar comma-separated epoch seconds (alloc'd)
    values:     int64;  // pchar comma-separated floats (alloc'd)
};

pub fn DOMetricResultFree(m: DOMetricResult) {
    if (m.metric     != 0) { free(m.metric,     StrLen(m.metric     as pchar) + 1); }
    if (m.timestamps != 0) { free(m.timestamps, StrLen(m.timestamps as pchar) + 1); }
    if (m.values     != 0) { free(m.values,     StrLen(m.values     as pchar) + 1); }
}

fn doClientMonitoring(creds: DOCredentials): DOClient {
    var c: DOClient; c.token := creds.token; c.tokenLen := creds.tokenLen; return c;
}

fn parseAlert(json: int64): DOAlert {
    var a: DOAlert;
    a.uuid         := doJsonStr(json, "uuid"c);
    a.name         := doJsonStr(json, "name"c);
    a.alertType    := doJsonStr(json, "type"c);
    a.compare      := doJsonStr(json, "compare"c);
    a.value        := doJsonInt(json, "value"c);
    a.window       := doJsonStr(json, "window"c);
    a.enabled      := doJsonBool(json, "enabled"c);
    a.emails       := doJsonStr(json, "emails"c);
    a.slackChannel := doJsonStr(json, "channel"c);
    return a;
}

fn buildAlertJSON(buf: int64,
                  name: pchar, alertType: pchar, compare: pchar,
                  value: int64, window: pchar,
                  email: pchar, entityIds: pchar): int64 {
    var p: int64 := buf;
    var i: int64 := 0;
    var h: pchar := "{\"name\":\""c; var lh: int64 := StrLen(h);
    while(i<lh){poke8(p+i,StrCharAt(h,i)&0xFF);i:=i+1;} p:=p+lh;
    var nl: int64 := StrLen(name);
    i:=0; while(i<nl){poke8(p+i,StrCharAt(name,i)&0xFF);i:=i+1;} p:=p+nl;
    var s2: pchar := "\",\"type\":\""c; var l2: int64 := StrLen(s2);
    i:=0; while(i<l2){poke8(p+i,StrCharAt(s2,i)&0xFF);i:=i+1;} p:=p+l2;
    var tl: int64 := StrLen(alertType);
    i:=0; while(i<tl){poke8(p+i,StrCharAt(alertType,i)&0xFF);i:=i+1;} p:=p+tl;
    var s3: pchar := "\",\"compare\":\""c; var l3: int64 := StrLen(s3);
    i:=0; while(i<l3){poke8(p+i,StrCharAt(s3,i)&0xFF);i:=i+1;} p:=p+l3;
    var cml: int64 := StrLen(compare);
    i:=0; while(i<cml){poke8(p+i,StrCharAt(compare,i)&0xFF);i:=i+1;} p:=p+cml;
    var s4: pchar := "\",\"value\":"c; var l4: int64 := StrLen(s4);
    i:=0; while(i<l4){poke8(p+i,StrCharAt(s4,i)&0xFF);i:=i+1;} p:=p+l4;
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(value, numBuf);
    var nn: int64 := StrLen(numStr);
    i:=0; while(i<nn){poke8(p+i,StrCharAt(numStr,i)&0xFF);i:=i+1;} p:=p+nn;
    free(numBuf, 24);
    var s5: pchar := ",\"window\":\""c; var l5: int64 := StrLen(s5);
    i:=0; while(i<l5){poke8(p+i,StrCharAt(s5,i)&0xFF);i:=i+1;} p:=p+l5;
    var wl: int64 := StrLen(window);
    i:=0; while(i<wl){poke8(p+i,StrCharAt(window,i)&0xFF);i:=i+1;} p:=p+wl;
    var s6: pchar := "\",\"enabled\":true"c; var l6: int64 := StrLen(s6);
    i:=0; while(i<l6){poke8(p+i,StrCharAt(s6,i)&0xFF);i:=i+1;} p:=p+l6;
    if (email != 0 as pchar) {
        var s7: pchar := ",\"notifications\":{\"email\":[\""c; var l7: int64 := StrLen(s7);
        i:=0; while(i<l7){poke8(p+i,StrCharAt(s7,i)&0xFF);i:=i+1;} p:=p+l7;
        var el: int64 := StrLen(email);
        i:=0; while(i<el){poke8(p+i,StrCharAt(email,i)&0xFF);i:=i+1;} p:=p+el;
        var s8: pchar := "\"]}"c; var l8: int64 := StrLen(s8);
        i:=0; while(i<l8){poke8(p+i,StrCharAt(s8,i)&0xFF);i:=i+1;} p:=p+l8;
    }
    if (entityIds != 0 as pchar) {
        var s9: pchar := ",\"entities\":[\""c; var l9: int64 := StrLen(s9);
        i:=0; while(i<l9){poke8(p+i,StrCharAt(s9,i)&0xFF);i:=i+1;} p:=p+l9;
        var eil: int64 := StrLen(entityIds);
        i:=0; while(i<eil){poke8(p+i,StrCharAt(entityIds,i)&0xFF);i:=i+1;} p:=p+eil;
        poke8(p,34); p:=p+1; poke8(p,93); p:=p+1; // '"]'
    }
    poke8(p,125); p:=p+1; poke8(p,0); // '}'
    return p - buf;
}

pub fn AlertCreate(creds: DOCredentials,
                   name: pchar, alertType: pchar, compare: pchar,
                   value: int64, window: pchar,
                   email: pchar, entityIds: pchar): DOAlert {
    var a: DOAlert;
    a.uuid := 0; a.name := 0; a.alertType := 0; a.compare := 0; a.value := 0;
    a.window := 0; a.enabled := 0; a.emails := 0; a.slackChannel := 0;
    var buf: int64 := alloc(2048);
    var bodyLen: int64 := buildAlertJSON(buf, name, alertType, compare, value, window, email, entityIds);
    var cl: DOClient := doClientMonitoring(creds);
    var resp: HTTPResponse := DOPost(cl, "/v2/monitoring/alerts"c, buf, bodyLen);
    free(buf, 2048);
    if ((resp.statusCode == 200 || resp.statusCode == 201) && resp.bodyPtr != 0) {
        a := parseAlert(resp.bodyPtr);
    }
    HTTPResponseFree(resp);
    return a;
}

pub fn AlertDelete(creds: DOCredentials, uuid: pchar): int64 {
    var cl: DOClient := doClientMonitoring(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath(pathBuf, "/v2/monitoring/alerts/"c, uuid);
    var resp: HTTPResponse := DODelete(cl, pathBuf as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 204) { ok := 1; }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return ok;
}

pub fn AlertGet(creds: DOCredentials, uuid: pchar): DOAlert {
    var a: DOAlert;
    a.uuid := 0; a.name := 0; a.alertType := 0; a.compare := 0; a.value := 0;
    a.window := 0; a.enabled := 0; a.emails := 0; a.slackChannel := 0;
    var cl: DOClient := doClientMonitoring(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath(pathBuf, "/v2/monitoring/alerts/"c, uuid);
    var resp: HTTPResponse := DOGet(cl, pathBuf as pchar);
    if (resp.statusCode == 200 && resp.bodyPtr != 0) { a := parseAlert(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return a;
}

pub fn AlertList(creds: DOCredentials): int64 {
    var cl: DOClient := doClientMonitoring(creds);
    return DOGetAll(cl, "/v2/monitoring/alerts"c, "policies"c);
}

pub fn AlertUpdate(creds: DOCredentials, uuid: pchar,
                   name: pchar, alertType: pchar, compare: pchar,
                   value: int64, window: pchar,
                   email: pchar, entityIds: pchar): DOAlert {
    var a: DOAlert;
    a.uuid := 0; a.name := 0; a.alertType := 0; a.compare := 0; a.value := 0;
    a.window := 0; a.enabled := 0; a.emails := 0; a.slackChannel := 0;
    var buf: int64 := alloc(2048);
    var bodyLen: int64 := buildAlertJSON(buf, name, alertType, compare, value, window, email, entityIds);
    var cl: DOClient := doClientMonitoring(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath(pathBuf, "/v2/monitoring/alerts/"c, uuid);
    var resp: HTTPResponse := DOPut(cl, pathBuf as pchar, buf, bodyLen);
    free(buf, 2048);
    if (resp.statusCode == 200 && resp.bodyPtr != 0) { a := parseAlert(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return a;
}

// Metrics queries

fn buildMetricsPath(buf: int64, metricType: pchar, hostId: pchar,
                    start: int64, end2: int64): pchar {
    // /v2/monitoring/metrics/<type>?host_id=<id>&start=<ts>&end=<ts>
    var prefix: pchar := "/v2/monitoring/metrics/"c;
    var pl: int64 := StrLen(prefix);
    var i: int64 := 0;
    while(i<pl){poke8(buf+i,StrCharAt(prefix,i)&0xFF);i:=i+1;}
    var ml: int64 := StrLen(metricType);
    i:=0; while(i<ml){poke8(buf+pl+i,StrCharAt(metricType,i)&0xFF);i:=i+1;}
    var q: pchar := "?host_id="c; var ql: int64 := StrLen(q);
    var off: int64 := pl+ml;
    i:=0; while(i<ql){poke8(buf+off+i,StrCharAt(q,i)&0xFF);i:=i+1;} off:=off+ql;
    var hl: int64 := StrLen(hostId);
    i:=0; while(i<hl){poke8(buf+off+i,StrCharAt(hostId,i)&0xFF);i:=i+1;} off:=off+hl;
    var s2: pchar := "&start="c; var l2: int64 := StrLen(s2);
    i:=0; while(i<l2){poke8(buf+off+i,StrCharAt(s2,i)&0xFF);i:=i+1;} off:=off+l2;
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(start, numBuf);
    var nn: int64 := StrLen(numStr);
    i:=0; while(i<nn){poke8(buf+off+i,StrCharAt(numStr,i)&0xFF);i:=i+1;} off:=off+nn;
    var s3: pchar := "&end="c; var l3: int64 := StrLen(s3);
    i:=0; while(i<l3){poke8(buf+off+i,StrCharAt(s3,i)&0xFF);i:=i+1;} off:=off+l3;
    numStr := Int64ToStr(end2, numBuf);
    nn := StrLen(numStr);
    i:=0; while(i<nn){poke8(buf+off+i,StrCharAt(numStr,i)&0xFF);i:=i+1;} off:=off+nn;
    free(numBuf, 24);
    poke8(buf+off,0);
    return buf as pchar;
}

pub fn MetricDropletCPU(creds: DOCredentials, dropletId: pchar,
                        start: int64, end2: int64): int64 {
    var cl: DOClient := doClientMonitoring(creds);
    var pathBuf: int64 := alloc(512);
    buildMetricsPath(pathBuf, "droplet/cpu"c, dropletId, start, end2);
    var resp: HTTPResponse := DOGet(cl, pathBuf as pchar);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.bodyPtr != 0) { result := resp.bodyPtr; resp.bodyPtr := 0; }
    HTTPResponseFree(resp);
    free(pathBuf, 512);
    return result;
}

