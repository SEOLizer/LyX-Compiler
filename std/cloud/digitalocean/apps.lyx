pub fn AppDeploymentCancel(creds: DOCredentials, appId: pchar, deployId: pchar): int64 {
    var cl: DOClient := doClientApps(creds);
    var pathBuf: int64 := alloc(512);
    doMakePath3(pathBuf, "/v2/apps/"c, appId, "/deployments/"c);
    var existLen: int64 := StrLen(pathBuf as pchar);
    var dl: int64 := StrLen(deployId);
    var i: int64 := 0;
    while(i<dl){poke8(pathBuf+existLen+i,StrCharAt(deployId,i)&0xFF);i:=i+1;}
    var sfx: pchar := "/cancel"c; var sl: int64 := StrLen(sfx);
    i:=0; while(i<sl){poke8(pathBuf+existLen+dl+i,StrCharAt(sfx,i)&0xFF);i:=i+1;}
    poke8(pathBuf+existLen+dl+sl,0);
    var resp: HTTPResponse := DOPost(cl, pathBuf as pchar, 0, 0);
    var ok: int64 := 0;
    if (resp.statusCode == 200) { ok := 1; }
    HTTPResponseFree(resp);
    free(pathBuf, 512);
    return ok;
}

pub fn AppDeploymentWait(creds: DOCredentials, appId: pchar, deployId: pchar): DODeployment {
    var maxAttempts: int64 := 120;
    var attempt: int64 := 0;
    var d: DODeployment;
    d.id := 0; d.appId := 0; d.phase := 0; d.createdAt := 0;
    while (attempt < maxAttempts) {
        d := AppDeploymentGet(creds, appId, deployId);
        if (d.phase != 0) {
            var active: pchar := "ACTIVE"c;
            var al: int64 := StrLen(active);
            var pl: int64 := StrLen(d.phase as pchar);
            if (pl == al) {
                var isMatch: int64 := 1; var j: int64 := 0;
                while(j<al){if(peek8(d.phase+j)!=(StrCharAt(active,j)&0xFF)){isMatch:=0;break;}j:=j+1;}
                if (isMatch == 1) { return d; }
            }
            var errphase: pchar := "ERROR"c;
            var el: int64 := StrLen(errphase);
            if (pl == el) {
                var match2: int64 := 1; var j2: int64 := 0;
                while(j2<el){if(peek8(d.phase+j2)!=(StrCharAt(errphase,j2)&0xFF)){match2:=0;break;}j2:=j2+1;}
                if (match2 == 1) { return d; }
            }
        }
        DODeploymentFree(d);
        d.id := 0; d.appId := 0; d.phase := 0; d.createdAt := 0;
        Sleep(5000);
        attempt += 1;
    }
    return d;
}

pub fn AppLogs(creds: DOCredentials, appId: pchar, component: pchar, logType: pchar): int64 {
    // logType: BUILD, DEPLOY, RUN
    var cl: DOClient := doClientApps(creds);
    var pathBuf: int64 := alloc(512);
    doMakePath3(pathBuf, "/v2/apps/"c, appId, "/logs?type="c);
    var existLen: int64 := StrLen(pathBuf as pchar);
    var ltl: int64 := StrLen(logType);
    var i: int64 := 0;
    while(i<ltl){poke8(pathBuf+existLen+i,StrCharAt(logType,i)&0xFF);i:=i+1;}
    if (component != 0 as pchar) {
        var sfx: pchar := "&component_name="c; var sl: int64 := StrLen(sfx);
        i:=0; while(i<sl){poke8(pathBuf+existLen+ltl+i,StrCharAt(sfx,i)&0xFF);i:=i+1;}
        var cl2: int64 := StrLen(component);
        i:=0; while(i<cl2){poke8(pathBuf+existLen+ltl+sl+i,StrCharAt(component,i)&0xFF);i:=i+1;}
        poke8(pathBuf+existLen+ltl+sl+cl2,0);
    } else {
        poke8(pathBuf+existLen+ltl,0);
    }
    var resp: HTTPResponse := DOGet(cl, pathBuf as pchar);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.bodyPtr != 0) {
        result := resp.bodyPtr;
        resp.bodyPtr := 0;
    }
    HTTPResponseFree(resp);
    free(pathBuf, 512);
    return result;
}

