pub type DOApp = struct {
    id:         int64;  // pchar (alloc'd)
    name:       int64;  // pchar (alloc'd)
    region:     int64;  // pchar (alloc'd)
    status:     int64;  // pchar: active, building, deploying, error (alloc'd)
    liveURL:    int64;  // pchar (alloc'd)
    updatedAt:  int64;  // pchar (alloc'd)
};

pub fn DOAppFree(a: DOApp) {
    if (a.id        != 0) { free(a.id,        StrLen(a.id        as pchar) + 1); }
    if (a.name      != 0) { free(a.name,      StrLen(a.name      as pchar) + 1); }
    if (a.region    != 0) { free(a.region,    StrLen(a.region    as pchar) + 1); }
    if (a.status    != 0) { free(a.status,    StrLen(a.status    as pchar) + 1); }
    if (a.liveURL   != 0) { free(a.liveURL,   StrLen(a.liveURL   as pchar) + 1); }
    if (a.updatedAt != 0) { free(a.updatedAt, StrLen(a.updatedAt as pchar) + 1); }
}

pub type DODeployment = struct {
    id:        int64;  // pchar (alloc'd)
    appId:     int64;  // pchar (alloc'd)
    phase:     int64;  // pchar: ACTIVE, BUILDING, DEPLOYING, ERROR (alloc'd)
    createdAt: int64;  // pchar (alloc'd)
};

pub fn DODeploymentFree(d: DODeployment) {
    if (d.id        != 0) { free(d.id,        StrLen(d.id        as pchar) + 1); }
    if (d.appId     != 0) { free(d.appId,     StrLen(d.appId     as pchar) + 1); }
    if (d.phase     != 0) { free(d.phase,     StrLen(d.phase     as pchar) + 1); }
    if (d.createdAt != 0) { free(d.createdAt, StrLen(d.createdAt as pchar) + 1); }
}

fn doClientApps(creds: DOCredentials): DOClient {
    var c: DOClient; c.token := creds.token; c.tokenLen := creds.tokenLen; return c;
}

fn parseApp(json: int64): DOApp {
    var a: DOApp;
    a.id        := doJsonStr(json, "id"c);
    a.name      := doJsonStr(json, "owner_uuid"c);
    a.region    := doJsonStr(json, "region"c);
    a.status    := doJsonStr(json, "active_deployment_id"c);
    a.liveURL   := doJsonStr(json, "live_url"c);
    a.updatedAt := doJsonStr(json, "updated_at"c);
    return a;
}

fn parseDeployment(json: int64): DODeployment {
    var d: DODeployment;
    d.id        := doJsonStr(json, "id"c);
    d.appId     := doJsonStr(json, "spec"c);
    d.phase     := doJsonStr(json, "phase"c);
    d.createdAt := doJsonStr(json, "created_at"c);
    return d;
}

// Build minimal App Spec JSON for a static site or service from a GitHub repo
fn buildAppSpec(buf: int64, name: pchar, region: pchar,
                repoURL: pchar, branch: pchar, buildCmd: pchar, runCmd: pchar): int64 {
    var p: int64 := buf;
    var h: pchar := "{\"spec\":{\"name\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(p+i,StrCharAt(h,i)&0xFF);i:=i+1;} p:=p+lh;
    var nl: int64 := StrLen(name);
    i:=0; while(i<nl){poke8(p+i,StrCharAt(name,i)&0xFF);i:=i+1;} p:=p+nl;
    var r1: pchar := "\",\"region\":\""c; var l1: int64 := StrLen(r1);
    i:=0; while(i<l1){poke8(p+i,StrCharAt(r1,i)&0xFF);i:=i+1;} p:=p+l1;
    var rl: int64 := StrLen(region);
    i:=0; while(i<rl){poke8(p+i,StrCharAt(region,i)&0xFF);i:=i+1;} p:=p+rl;
    var r2: pchar := "\",\"services\":[{\"name\":\"web\",\"github\":{\"repo\":\""c;
    var l2: int64 := StrLen(r2);
    i:=0; while(i<l2){poke8(p+i,StrCharAt(r2,i)&0xFF);i:=i+1;} p:=p+l2;
    var repoLen: int64 := StrLen(repoURL);
    i:=0; while(i<repoLen){poke8(p+i,StrCharAt(repoURL,i)&0xFF);i:=i+1;} p:=p+repoLen;
    var r3: pchar := "\",\"branch\":\""c; var l3: int64 := StrLen(r3);
    i:=0; while(i<l3){poke8(p+i,StrCharAt(r3,i)&0xFF);i:=i+1;} p:=p+l3;
    var bl: int64 := StrLen(branch);
    i:=0; while(i<bl){poke8(p+i,StrCharAt(branch,i)&0xFF);i:=i+1;} p:=p+bl;
    if (buildCmd != 0 as pchar) {
        var r4: pchar := "\",\"build_command\":\""c; var l4: int64 := StrLen(r4);
        i:=0; while(i<l4){poke8(p+i,StrCharAt(r4,i)&0xFF);i:=i+1;} p:=p+l4;
        var bcl: int64 := StrLen(buildCmd);
        i:=0; while(i<bcl){poke8(p+i,StrCharAt(buildCmd,i)&0xFF);i:=i+1;} p:=p+bcl;
    }
    if (runCmd != 0 as pchar) {
        var r5: pchar := "\",\"run_command\":\""c; var l5: int64 := StrLen(r5);
        i:=0; while(i<l5){poke8(p+i,StrCharAt(r5,i)&0xFF);i:=i+1;} p:=p+l5;
        var rcl: int64 := StrLen(runCmd);
        i:=0; while(i<rcl){poke8(p+i,StrCharAt(runCmd,i)&0xFF);i:=i+1;} p:=p+rcl;
    }
    var tail: pchar := "\"}}]}}c"; tail := "\"}}]}}"c; var tl: int64 := StrLen(tail);
    i:=0; while(i<tl){poke8(p+i,StrCharAt(tail,i)&0xFF);i:=i+1;} p:=p+tl;
    poke8(p,0);
    return p - buf;
}

pub fn AppCreate(creds: DOCredentials, name: pchar, region: pchar,
                 repoURL: pchar, branch: pchar,
                 buildCmd: pchar, runCmd: pchar): DOApp {
    var a: DOApp;
    a.id := 0; a.name := 0; a.region := 0; a.status := 0; a.liveURL := 0; a.updatedAt := 0;
    var buf: int64 := alloc(2048);
    var bodyLen: int64 := buildAppSpec(buf, name, region, repoURL, branch, buildCmd, runCmd);
    var cl: DOClient := doClientApps(creds);
    var resp: HTTPResponse := DOPost(cl, "/v2/apps"c, buf, bodyLen);
    free(buf, 2048);
    if (resp.statusCode == 200 || resp.statusCode == 201) {
        if (resp.bodyPtr != 0) { a := parseApp(resp.bodyPtr); }
    }
    HTTPResponseFree(resp);
    return a;
}

pub fn AppCreateFromSpec(creds: DOCredentials, specJson: int64, specLen: int64): DOApp {
    var a: DOApp;
    a.id := 0; a.name := 0; a.region := 0; a.status := 0; a.liveURL := 0; a.updatedAt := 0;
    var cl: DOClient := doClientApps(creds);
    var resp: HTTPResponse := DOPost(cl, "/v2/apps"c, specJson, specLen);
    if (resp.statusCode == 200 || resp.statusCode == 201) {
        if (resp.bodyPtr != 0) { a := parseApp(resp.bodyPtr); }
    }
    HTTPResponseFree(resp);
    return a;
}

pub fn AppDelete(creds: DOCredentials, id: pchar): int64 {
    var cl: DOClient := doClientApps(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath(pathBuf, "/v2/apps/"c, id);
    var resp: HTTPResponse := DODelete(cl, pathBuf as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 200 || resp.statusCode == 204) { ok := 1; }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return ok;
}

pub fn AppGet(creds: DOCredentials, id: pchar): DOApp {
    var a: DOApp;
    a.id := 0; a.name := 0; a.region := 0; a.status := 0; a.liveURL := 0; a.updatedAt := 0;
    var cl: DOClient := doClientApps(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath(pathBuf, "/v2/apps/"c, id);
    var resp: HTTPResponse := DOGet(cl, pathBuf as pchar);
    if (resp.statusCode == 200 && resp.bodyPtr != 0) { a := parseApp(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return a;
}

pub fn AppList(creds: DOCredentials): int64 {
    var cl: DOClient := doClientApps(creds);
    return DOGetAll(cl, "/v2/apps"c, "apps"c);
}

pub fn AppUpdate(creds: DOCredentials, id: pchar, specJson: int64, specLen: int64): DOApp {
    var a: DOApp;
    a.id := 0; a.name := 0; a.region := 0; a.status := 0; a.liveURL := 0; a.updatedAt := 0;
    var cl: DOClient := doClientApps(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath(pathBuf, "/v2/apps/"c, id);
    var resp: HTTPResponse := DOPut(cl, pathBuf as pchar, specJson, specLen);
    if (resp.statusCode == 200 && resp.bodyPtr != 0) { a := parseApp(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return a;
}

pub fn AppDeploy(creds: DOCredentials, id: pchar, forceRebuild: int64): DODeployment {
    var d: DODeployment;
    d.id := 0; d.appId := 0; d.phase := 0; d.createdAt := 0;
    var cl: DOClient := doClientApps(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/apps/"c, id, "/deployments"c);
    var body: pchar := "{\"force_build\":false}"c;
    if (forceRebuild == 1) { body := "{\"force_build\":true}"c; }
    var bl: int64 := StrLen(body);
    var resp: HTTPResponse := DOPost(cl, pathBuf as pchar, body as int64, bl);
    if (resp.statusCode == 200 || resp.statusCode == 201) {
        if (resp.bodyPtr != 0) { d := parseDeployment(resp.bodyPtr); }
    }
    HTTPResponseFree(resp);
    free(pathBuf, 256);
    return d;
}

pub fn AppDeploymentGet(creds: DOCredentials, appId: pchar, deployId: pchar): DODeployment {
    var d: DODeployment;
    d.id := 0; d.appId := 0; d.phase := 0; d.createdAt := 0;
    var cl: DOClient := doClientApps(creds);
    var pathBuf: int64 := alloc(512);
    doMakePath3(pathBuf, "/v2/apps/"c, appId, "/deployments/"c);
    var existLen: int64 := StrLen(pathBuf as pchar);
    var dl: int64 := StrLen(deployId);
    var i: int64 := 0;
    while(i<dl){poke8(pathBuf+existLen+i,StrCharAt(deployId,i)&0xFF);i:=i+1;}
    poke8(pathBuf+existLen+dl,0);
    var resp: HTTPResponse := DOGet(cl, pathBuf as pchar);
    if (resp.statusCode == 200 && resp.bodyPtr != 0) { d := parseDeployment(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 512);
    return d;
}

