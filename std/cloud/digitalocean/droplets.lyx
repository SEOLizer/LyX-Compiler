// ============================================================================
// Structs
// ============================================================================

pub type DODroplet = struct {
    id:      int64;   // droplet ID
    name:    int64;   // pchar (alloc'd)
    status:  int64;   // pchar: "new","active","off","archive" (alloc'd)
    region:  int64;   // pchar: slug e.g. "fra1" (alloc'd)
    size:    int64;   // pchar: slug e.g. "s-1vcpu-1gb" (alloc'd)
    image:   int64;   // pchar: slug or id (alloc'd)
    vcpus:   int64;
    memory:  int64;   // MB
    disk:    int64;   // GB
    pubIPv4: int64;   // pchar: first public IPv4 (alloc'd, or 0)
    created: int64;   // pchar (alloc'd)
};

pub fn DODropletFree(d: DODroplet) {
    if (d.name    != 0) { free(d.name,    StrLen(d.name    as pchar) + 1); }
    if (d.status  != 0) { free(d.status,  StrLen(d.status  as pchar) + 1); }
    if (d.region  != 0) { free(d.region,  StrLen(d.region  as pchar) + 1); }
    if (d.size    != 0) { free(d.size,    StrLen(d.size    as pchar) + 1); }
    if (d.image   != 0) { free(d.image,   StrLen(d.image   as pchar) + 1); }
    if (d.pubIPv4 != 0) { free(d.pubIPv4, StrLen(d.pubIPv4 as pchar) + 1); }
    if (d.created != 0) { free(d.created, StrLen(d.created as pchar) + 1); }
}

pub type DOAction = struct {
    id:          int64;
    status:      int64;  // pchar: "in-progress","completed","errored" (alloc'd)
    actionType:  int64;  // pchar (alloc'd)
    resourceId:  int64;
};

pub fn DOActionFree(a: DOAction) {
    if (a.status     != 0) { free(a.status,     StrLen(a.status     as pchar) + 1); }
    if (a.actionType != 0) { free(a.actionType, StrLen(a.actionType as pchar) + 1); }
}

pub type DOSSHKey = struct {
    id:          int64;
    name:        int64;  // pchar (alloc'd)
    fingerprint: int64;  // pchar (alloc'd)
    publicKey:   int64;  // pchar (alloc'd)
};

pub fn DOSSHKeyFree(k: DOSSHKey) {
    if (k.name        != 0) { free(k.name,        StrLen(k.name        as pchar) + 1); }
    if (k.fingerprint != 0) { free(k.fingerprint, StrLen(k.fingerprint as pchar) + 1); }
    if (k.publicKey   != 0) { free(k.publicKey,   StrLen(k.publicKey   as pchar) + 1); }
}

