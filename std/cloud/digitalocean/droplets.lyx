// ============================================================================
// Internal: parse a droplet from JSON body
// ============================================================================

fn doClientFromCreds(creds: DOCredentials): DOClient {
    var c: DOClient;
    c.token    := creds.token;
    c.tokenLen := creds.tokenLen;
    return c;
}

fn parseDroplet(json: int64): DODroplet {
    var d: DODroplet;
    d.id      := doJsonInt(json, "id"c);
    d.name    := doJsonStr(json, "name"c);
    d.status  := doJsonStr(json, "status"c);
    d.vcpus   := doJsonInt(json, "vcpus"c);
    d.memory  := doJsonInt(json, "memory"c);
    d.disk    := doJsonInt(json, "disk"c);
    d.created := doJsonStr(json, "created_at"c);
    d.pubIPv4 := 0;
    d.region  := doJsonStr(json, "slug"c);  // region slug lives one level inside "region":{...}
    d.size    := doJsonStr(json, "slug"c);  // size slug — extracted same way (first slug wins)
    d.image   := 0;
    // Try to get ip_address from networks.v4 array (search for "ip_address" in body)
    var ipKey: pchar := "ip_address"c;
    d.pubIPv4 := doJsonStr(json, ipKey);
    return d;
}

fn parseAction(json: int64): DOAction {
    var a: DOAction;
    a.id         := doJsonInt(json, "id"c);
    a.status     := doJsonStr(json, "status"c);
    a.actionType := doJsonStr(json, "type"c);
    a.resourceId := doJsonInt(json, "resource_id"c);
    return a;
}

// ============================================================================
// Droplet CRUD
// ============================================================================

pub fn DropletCreateSimple(creds: DOCredentials,
                           name: pchar, region: pchar,
                           size: pchar, image: pchar): DODroplet {
    var d: DODroplet;
    d.id      := 0; d.name := 0; d.status := 0; d.region := 0;
    d.size    := 0; d.image := 0; d.vcpus := 0; d.memory := 0;
    d.disk    := 0; d.pubIPv4 := 0; d.created := 0;

    // Build JSON body
    var buf: int64 := alloc(2048);
    var p: int64 := buf;
    var parts: pchar := "{\"name\":\""c;
    var lp: int64 := StrLen(parts);
    var i: int64 := 0;
    while (i < lp) { poke8(p + i, StrCharAt(parts, i) & 0xFF); i := i + 1; }
    p += lp;
    var nl: int64 := StrLen(name);
    i := 0; while (i < nl) { poke8(p + i, StrCharAt(name, i) & 0xFF); i := i + 1; } p := p + nl;
    var sep1: pchar := "\",\"region\":\""c;
    var ls1: int64 := StrLen(sep1);
    i := 0; while (i < ls1) { poke8(p + i, StrCharAt(sep1, i) & 0xFF); i := i + 1; } p := p + ls1;
    var rl: int64 := StrLen(region);
    i := 0; while (i < rl) { poke8(p + i, StrCharAt(region, i) & 0xFF); i := i + 1; } p := p + rl;
    var sep2: pchar := "\",\"size\":\""c;
    var ls2: int64 := StrLen(sep2);
    i := 0; while (i < ls2) { poke8(p + i, StrCharAt(sep2, i) & 0xFF); i := i + 1; } p := p + ls2;
    var sl: int64 := StrLen(size);
    i := 0; while (i < sl) { poke8(p + i, StrCharAt(size, i) & 0xFF); i := i + 1; } p := p + sl;
    var sep3: pchar := "\",\"image\":\""c;
    var ls3: int64 := StrLen(sep3);
    i := 0; while (i < ls3) { poke8(p + i, StrCharAt(sep3, i) & 0xFF); i := i + 1; } p := p + ls3;
    var il: int64 := StrLen(image);
    i := 0; while (i < il) { poke8(p + i, StrCharAt(image, i) & 0xFF); i := i + 1; } p := p + il;
    var tail: pchar := "\"}"c;
    var lt: int64 := StrLen(tail);
    i := 0; while (i < lt) { poke8(p + i, StrCharAt(tail, i) & 0xFF); i := i + 1; } p := p + lt;
    poke8(p, 0);
    var bodyLen: int64 := p - buf;

    var c: DOClient := doClientFromCreds(creds);
    var path: pchar := "/v2/droplets"c;
    var resp: HTTPResponse := DOPost(c, path, buf, bodyLen);
    free(buf, 2048);

    if (resp.statusCode == 202 && resp.bodyPtr != 0) {
        d := parseDroplet(resp.bodyPtr);
    }
    HTTPResponseFree(resp);
    return d;
}

pub fn DropletCreate(creds: DOCredentials,
                     name: pchar, region: pchar,
                     size: pchar, image: pchar,
                     userData: pchar, ipv6: int64): DODroplet {
    // If no userData, use simple form
    if (userData == 0 as pchar) {
        return DropletCreateSimple(creds, name, region, size, image);
    }
    var buf: int64 := alloc(4096);
    var p: int64 := buf;
    var header: pchar := "{\"name\":\""c;
    var lh: int64 := StrLen(header);
    var i: int64 := 0;
    while (i < lh) { poke8(p + i, StrCharAt(header, i) & 0xFF); i := i + 1; } p := p + lh;
    var nl: int64 := StrLen(name);
    i := 0; while (i < nl) { poke8(p + i, StrCharAt(name, i) & 0xFF); i := i + 1; } p := p + nl;
    var s1: pchar := "\",\"region\":\""c; var l1: int64 := StrLen(s1);
    i := 0; while (i < l1) { poke8(p + i, StrCharAt(s1, i) & 0xFF); i := i + 1; } p := p + l1;
    var rl: int64 := StrLen(region);
    i := 0; while (i < rl) { poke8(p + i, StrCharAt(region, i) & 0xFF); i := i + 1; } p := p + rl;
    var s2: pchar := "\",\"size\":\""c; var l2: int64 := StrLen(s2);
    i := 0; while (i < l2) { poke8(p + i, StrCharAt(s2, i) & 0xFF); i := i + 1; } p := p + l2;
    var sl: int64 := StrLen(size);
    i := 0; while (i < sl) { poke8(p + i, StrCharAt(size, i) & 0xFF); i := i + 1; } p := p + sl;
    var s3: pchar := "\",\"image\":\""c; var l3: int64 := StrLen(s3);
    i := 0; while (i < l3) { poke8(p + i, StrCharAt(s3, i) & 0xFF); i := i + 1; } p := p + l3;
    var il: int64 := StrLen(image);
    i := 0; while (i < il) { poke8(p + i, StrCharAt(image, i) & 0xFF); i := i + 1; } p := p + il;
    var s4: pchar := "\",\"user_data\":\""c; var l4: int64 := StrLen(s4);
    i := 0; while (i < l4) { poke8(p + i, StrCharAt(s4, i) & 0xFF); i := i + 1; } p := p + l4;
    var ul: int64 := StrLen(userData);
    i := 0; while (i < ul) { poke8(p + i, StrCharAt(userData, i) & 0xFF); i := i + 1; } p := p + ul;
    var tail: pchar := "\"}"c; var lt: int64 := StrLen(tail);
    i := 0; while (i < lt) { poke8(p + i, StrCharAt(tail, i) & 0xFF); i := i + 1; } p := p + lt;
    poke8(p, 0);
    var bodyLen: int64 := p - buf;
    var cl: DOClient := doClientFromCreds(creds);
    var path: pchar := "/v2/droplets"c;
    var resp: HTTPResponse := DOPost(cl, path, buf, bodyLen);
    free(buf, 4096);
    var d: DODroplet;
    d.id := 0; d.name := 0; d.status := 0; d.region := 0;
    d.size := 0; d.image := 0; d.vcpus := 0; d.memory := 0;
    d.disk := 0; d.pubIPv4 := 0; d.created := 0;
    if (resp.statusCode == 202 && resp.bodyPtr != 0) { d := parseDroplet(resp.bodyPtr); }
    HTTPResponseFree(resp);
    return d;
}

pub fn DropletDelete(creds: DOCredentials, id: int64): int64 {
    var c: DOClient := doClientFromCreds(creds);
    var pathBuf: int64 := alloc(64);
    var path: pchar := doMakePathI(pathBuf, "/droplets/"c, id);
    var resp: HTTPResponse := DODelete(c, path);
    var ok: int64 := 0;
    if (resp.statusCode == 204) { ok := 1; }
    HTTPResponseFree(resp);
    free(pathBuf, 64);
    return ok;
}

pub fn DropletGet(creds: DOCredentials, id: int64): DODroplet {
    var d: DODroplet;
    d.id := 0; d.name := 0; d.status := 0; d.region := 0;
    d.size := 0; d.image := 0; d.vcpus := 0; d.memory := 0;
    d.disk := 0; d.pubIPv4 := 0; d.created := 0;
    var c: DOClient := doClientFromCreds(creds);
    var pathBuf: int64 := alloc(64);
    var path: pchar := doMakePathI(pathBuf, "/droplets/"c, id);
    var resp: HTTPResponse := DOGet(c, path);
    if (resp.statusCode == 200 && resp.bodyPtr != 0) { d := parseDroplet(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 64);
    return d;
}

pub fn DropletList(creds: DOCredentials): int64 {
    var c: DOClient := doClientFromCreds(creds);
    var path: pchar := "/v2/droplets"c;
    return DOGetAll(c, path, "droplets"c);
}

pub fn DropletListByTag(creds: DOCredentials, tag: pchar): int64 {
    var c: DOClient := doClientFromCreds(creds);
    var pathBuf: int64 := alloc(256);
    var base: pchar := "/v2/droplets?tag_name="c;
    doMakePath(pathBuf, base, tag);
    var result: int64 := DOGetAll(c, pathBuf as pchar, "droplets"c);
    free(pathBuf, 256);
    return result;
}

// ============================================================================
// DropletWait: poll until status matches, max 300s
// ============================================================================

pub fn DropletWait(creds: DOCredentials, id: int64, status: pchar): DODroplet {
    var maxAttempts: int64 := 60;
    var attempt: int64 := 0;
    var d: DODroplet;
    d.id := 0; d.name := 0; d.status := 0; d.region := 0;
    d.size := 0; d.image := 0; d.vcpus := 0; d.memory := 0;
    d.disk := 0; d.pubIPv4 := 0; d.created := 0;
    while (attempt < maxAttempts) {
        d := DropletGet(creds, id);
        if (d.status != 0) {
            var slen: int64 := StrLen(d.status as pchar);
            var tlen: int64 := StrLen(status);
            if (slen == tlen) {
                var isMatch: int64 := 1;
                var j: int64 := 0;
                while (j < slen) {
                    if (peek8(d.status + j) != (StrCharAt(status, j) & 0xFF)) { isMatch := 0; break; }
                    j += 1;
                }
                if (isMatch == 1) { return d; }
            }
        }
        DODropletFree(d);
        d.id := 0; d.name := 0; d.status := 0; d.region := 0;
        d.size := 0; d.image := 0; d.vcpus := 0; d.memory := 0;
        d.disk := 0; d.pubIPv4 := 0; d.created := 0;
        Sleep(5000); // wait 5 seconds
        attempt += 1;
    }
    return d;
}

pub fn DropletGetIP(creds: DOCredentials, id: int64): int64 {
    var d: DODroplet := DropletGet(creds, id);
    var ip: int64 := d.pubIPv4;
    // detach ip from droplet (don't free it — caller owns it)
    d.pubIPv4 := 0;
    DODropletFree(d);
    return ip;
}

// ============================================================================
// Actions
// ============================================================================

fn dropletActionBody(actionType: pchar, params: pchar): int64 {
    var buf: int64 := alloc(1024);
    var p: int64 := buf;
    var header: pchar := "{\"type\":\""c;
    var lh: int64 := StrLen(header);
    var i: int64 := 0;
    while (i < lh) { poke8(p + i, StrCharAt(header, i) & 0xFF); i := i + 1; } p := p + lh;
    var al: int64 := StrLen(actionType);
    i := 0; while (i < al) { poke8(p + i, StrCharAt(actionType, i) & 0xFF); i := i + 1; } p := p + al;
    if (params != 0 as pchar) {
        var sep: pchar := "\","c; var ls: int64 := StrLen(sep);
        i := 0; while (i < ls) { poke8(p + i, StrCharAt(sep, i) & 0xFF); i := i + 1; } p := p + ls;
        var pl: int64 := StrLen(params);
        i := 0; while (i < pl) { poke8(p + i, StrCharAt(params, i) & 0xFF); i := i + 1; } p := p + pl;
        poke8(p, 125); p := p + 1; // '}'
    } else {
        var tail: pchar := "\"}"c; var lt: int64 := StrLen(tail);
        i := 0; while (i < lt) { poke8(p + i, StrCharAt(tail, i) & 0xFF); i := i + 1; } p := p + lt;
    }
    poke8(p, 0);
    return buf;
}

pub fn DropletAction(creds: DOCredentials, id: int64, action: pchar): DOAction {
    var a: DOAction; a.id := 0; a.status := 0; a.actionType := 0; a.resourceId := 0;
    var buf: int64 := dropletActionBody(action, 0 as pchar);
    var bodyLen: int64 := StrLen(buf as pchar);
    var c: DOClient := doClientFromCreds(creds);
    var pathBuf: int64 := alloc(128);
    var path: pchar := doMakePathIS(pathBuf, "/droplets/"c, id, "/actions"c);
    var resp: HTTPResponse := DOPost(c, path, buf, bodyLen);
    free(buf, 1024);
    if (resp.statusCode == 201 && resp.bodyPtr != 0) { a := parseAction(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 128);
    return a;
}

pub fn DropletActionWait(creds: DOCredentials, dropletId: int64, actionId: int64): DOAction {
    var a: DOAction; a.id := 0; a.status := 0; a.actionType := 0; a.resourceId := 0;
    var c: DOClient := doClientFromCreds(creds);
    var maxAttempts: int64 := 60;
    var attempt: int64 := 0;
    while (attempt < maxAttempts) {
        var pathBuf: int64 := alloc(128);
        var numBuf: int64 := alloc(24);
        var numStr: pchar := Int64ToStr(actionId, numBuf);
        // path: /v2/droplets/<dropletId>/actions/<actionId>
        var base: pchar := "/droplets/"c;
        var mid:  pchar := "/actions/"c;
        doMakePathI(pathBuf, base, dropletId);
        // append /actions/<actionId>
        var existLen: int64 := StrLen(pathBuf as pchar);
        var midLen: int64 := StrLen(mid);
        var ni: int64 := 0;
        while (ni < midLen) { poke8(pathBuf + existLen + ni, StrCharAt(mid, ni) & 0xFF); ni := ni + 1; }
        var numLen: int64 := StrLen(numStr);
        ni := 0;
        while (ni < numLen) { poke8(pathBuf + existLen + midLen + ni, StrCharAt(numStr, ni) & 0xFF); ni := ni + 1; }
        poke8(pathBuf + existLen + midLen + numLen, 0);
        free(numBuf, 24);
        var resp: HTTPResponse := DOGet(c, pathBuf as pchar);
        if (resp.statusCode == 200 && resp.bodyPtr != 0) {
            if (a.status != 0) { DOActionFree(a); }
            a := parseAction(resp.bodyPtr);
            if (a.status != 0) {
                var scomp: pchar := "completed"c;
                var serr:  pchar := "errored"c;
                var slen: int64 := StrLen(a.status as pchar);
                var lc: int64 := StrLen(scomp);
                var le: int64 := StrLen(serr);
                var done: int64 := 0;
                if (slen == lc) {
                    var m: int64 := 1; var j: int64 := 0;
                    while (j < slen) { if (peek8(a.status+j)!=(StrCharAt(scomp,j)&0xFF)){m:=0;break;} j:=j+1; }
                    if (m == 1) { done := 1; }
                }
                if (done == 0 && slen == le) {
                    var m: int64 := 1; var j: int64 := 0;
                    while (j < slen) { if (peek8(a.status+j)!=(StrCharAt(serr,j)&0xFF)){m:=0;break;} j:=j+1; }
                    if (m == 1) { done := 1; }
                }
                if (done == 1) { HTTPResponseFree(resp); free(pathBuf, 128); return a; }
            }
        }
        HTTPResponseFree(resp);
        free(pathBuf, 128);
        Sleep(5000);
        attempt += 1;
    }
    return a;
}

pub fn DropletPowerOn(creds: DOCredentials, id: int64): DOAction {
    return DropletAction(creds, id, DO_ACTION_POWER_ON);
}
pub fn DropletPowerOff(creds: DOCredentials, id: int64): DOAction {
