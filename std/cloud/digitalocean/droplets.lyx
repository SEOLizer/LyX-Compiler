pub con DO_ACTION_POWER_ON:    pchar := "power_on"c;
pub con DO_ACTION_POWER_OFF:   pchar := "power_off"c;
pub con DO_ACTION_REBOOT:      pchar := "reboot"c;
pub con DO_ACTION_SHUTDOWN:    pchar := "shutdown"c;
pub con DO_ACTION_RESET_PASS:  pchar := "password_reset"c;
pub con DO_ACTION_ENABLE_IPV6: pchar := "enable_ipv6"c;
pub con DO_ACTION_SNAPSHOT:    pchar := "snapshot"c;
