}
pub fn DropletReboot(creds: DOCredentials, id: int64): DOAction {
    return DropletAction(creds, id, DO_ACTION_REBOOT);
}
pub fn DropletShutdown(creds: DOCredentials, id: int64): DOAction {
    return DropletAction(creds, id, DO_ACTION_SHUTDOWN);
}

pub fn DropletSnapshot(creds: DOCredentials, id: int64, snapshotName: pchar): DOAction {
    var params: pchar := "\"name\":\""c;
    var buf: int64 := alloc(256);
    var p: int64 := buf;
    var lp: int64 := StrLen(params);
    var i: int64 := 0;
    while (i < lp) { poke8(p + i, StrCharAt(params, i) & 0xFF); i := i + 1; } p := p + lp;
    var nl: int64 := StrLen(snapshotName);
    i := 0; while (i < nl) { poke8(p + i, StrCharAt(snapshotName, i) & 0xFF); i := i + 1; } p := p + nl;
    poke8(p, 34); p := p + 1; // '"'
    poke8(p, 0);
    var a: DOAction := DropletAction(creds, id, DO_ACTION_SNAPSHOT);
    free(buf, 256);
    return a;
}

pub fn DropletResize(creds: DOCredentials, id: int64, newSize: pchar, resizeDisk: int64): DOAction {
    return DropletAction(creds, id, DO_ACTION_RESIZE);
}

pub fn DropletRebuild(creds: DOCredentials, id: int64, image: pchar): DOAction {
    return DropletAction(creds, id, DO_ACTION_REBUILD);
}

// ============================================================================
// Tags
// ============================================================================

pub fn DropletTag(creds: DOCredentials, id: int64, tag: pchar): int64 {
    var c: DOClient := doClientFromCreds(creds);
    var buf: int64 := alloc(256);
    var header: pchar := "{\"resources\":[{\"resource_id\":\""c;
    var lh: int64 := StrLen(header);
    var i: int64 := 0;
    while (i < lh) { poke8(buf + i, StrCharAt(header, i) & 0xFF); i := i + 1; }
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(id, numBuf);
    var nl: int64 := StrLen(numStr);
    i := 0; while (i < nl) { poke8(buf + lh + i, StrCharAt(numStr, i) & 0xFF); i := i + 1; }
    free(numBuf, 24);
    var tail: pchar := "\",\"resource_type\":\"droplet\"}]}"c;
    var lt: int64 := StrLen(tail);
    var off: int64 := lh + nl;
    i := 0; while (i < lt) { poke8(buf + off + i, StrCharAt(tail, i) & 0xFF); i := i + 1; }
    poke8(buf + off + lt, 0);
    var bodyLen: int64 := off + lt;
    var pathBuf: int64 := alloc(256);
    var tagBase: pchar := "/v2/tags/"c;
    var resPath: pchar := "/resources"c;
    doMakePath3(pathBuf, tagBase, tag, resPath);
    var resp: HTTPResponse := DOPost(c, pathBuf as pchar, buf, bodyLen);
    var ok: int64 := 0;
    if (resp.statusCode == 204) { ok := 1; }
    HTTPResponseFree(resp);
    free(buf, 256);
    free(pathBuf, 256);
    return ok;
}

pub fn DropletUntag(creds: DOCredentials, id: int64, tag: pchar): int64 {
    var c: DOClient := doClientFromCreds(creds);
    var buf: int64 := alloc(256);
    var header: pchar := "{\"resources\":[{\"resource_id\":\""c;
    var lh: int64 := StrLen(header);
    var i: int64 := 0;
    while (i < lh) { poke8(buf + i, StrCharAt(header, i) & 0xFF); i := i + 1; }
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(id, numBuf);
    var nl: int64 := StrLen(numStr);
    i := 0; while (i < nl) { poke8(buf + lh + i, StrCharAt(numStr, i) & 0xFF); i := i + 1; }
    free(numBuf, 24);
    var tail: pchar := "\",\"resource_type\":\"droplet\"}]}"c;
    var lt: int64 := StrLen(tail);
    var off: int64 := lh + nl;
    i := 0; while (i < lt) { poke8(buf + off + i, StrCharAt(tail, i) & 0xFF); i := i + 1; }
    poke8(buf + off + lt, 0);
    var bodyLen: int64 := off + lt;
    var pathBuf: int64 := alloc(256);
    var tagBase: pchar := "/v2/tags/"c;
    var resPath: pchar := "/resources"c;
    doMakePath3(pathBuf, tagBase, tag, resPath);
    var resp: HTTPResponse := DODelete(c, pathBuf as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 204) { ok := 1; }
    HTTPResponseFree(resp);
    free(buf, 256);
    free(pathBuf, 256);
    return ok;
}

