// ============================================================================
// SSH Keys
// ============================================================================

fn parseSSHKey(json: int64): DOSSHKey {
    var k: DOSSHKey;
    k.id          := doJsonInt(json, "id"c);
    k.name        := doJsonStr(json, "name"c);
    k.fingerprint := doJsonStr(json, "fingerprint"c);
    k.publicKey   := doJsonStr(json, "public_key"c);
    return k;
}

pub fn SSHKeyCreate(creds: DOCredentials, name: pchar, publicKey: pchar): DOSSHKey {
    var k: DOSSHKey; k.id := 0; k.name := 0; k.fingerprint := 0; k.publicKey := 0;
    var buf: int64 := alloc(4096);
    var p: int64 := buf;
    var h: pchar := "{\"name\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while (i < lh) { poke8(p + i, StrCharAt(h, i) & 0xFF); i := i + 1; } p := p + lh;
    var nl: int64 := StrLen(name);
    i := 0; while (i < nl) { poke8(p + i, StrCharAt(name, i) & 0xFF); i := i + 1; } p := p + nl;
    var s: pchar := "\",\"public_key\":\""c; var ls: int64 := StrLen(s);
    i := 0; while (i < ls) { poke8(p + i, StrCharAt(s, i) & 0xFF); i := i + 1; } p := p + ls;
    var kl: int64 := StrLen(publicKey);
    i := 0; while (i < kl) { poke8(p + i, StrCharAt(publicKey, i) & 0xFF); i := i + 1; } p := p + kl;
    var t: pchar := "\"}"c; var lt: int64 := StrLen(t);
    i := 0; while (i < lt) { poke8(p + i, StrCharAt(t, i) & 0xFF); i := i + 1; } p := p + lt;
    poke8(p, 0);
    var bodyLen: int64 := p - buf;
    var c: DOClient := doClientFromCreds(creds);
    var path: pchar := "/v2/account/keys"c;
    var resp: HTTPResponse := DOPost(c, path, buf, bodyLen);
    free(buf, 4096);
    if (resp.statusCode == 201 && resp.bodyPtr != 0) { k := parseSSHKey(resp.bodyPtr); }
    HTTPResponseFree(resp);
    return k;
}

pub fn SSHKeyDelete(creds: DOCredentials, id: int64): int64 {
    var c: DOClient := doClientFromCreds(creds);
    var pathBuf: int64 := alloc(64);
    var path: pchar := doMakePathI(pathBuf, "/account/keys/"c, id);
    var resp: HTTPResponse := DODelete(c, path);
    var ok: int64 := 0;
    if (resp.statusCode == 204) { ok := 1; }
    HTTPResponseFree(resp);
    free(pathBuf, 64);
    return ok;
}

pub fn SSHKeyList(creds: DOCredentials): int64 {
    var c: DOClient := doClientFromCreds(creds);
