pub fn SpacesObjectGetFile(creds: DOCredentials, bucket: pchar, region: pchar,
                           key: pchar, localPath: pchar): int64 {
    var data: int64 := SpacesObjectGet(creds, bucket, region, key);
    if (data == 0) { return 1; }
    var n: int64 := WriteFile(localPath, data as pchar, StrLen(data as pchar));
    free(data, StrLen(data as pchar) + 1);
    if (n > 0) { return 0; }
    return 1;
}

