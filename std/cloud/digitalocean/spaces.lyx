// std/cloud/do/spaces.lyx — DigitalOcean Spaces (S3-compatible object storage)
// WP-DO-04
// Uses SigV4-compatible HMAC-SHA256 auth.
// Spaces endpoints: <bucket>.nyc3.digitaloceanspaces.com (region-specific)

unit std.cloud.digitalocean.spaces;

