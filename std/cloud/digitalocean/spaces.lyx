    poke8(pathBuf+1+kl,0);
    var resp: HTTPResponse := spacesSendRequest(hostBuf as pchar, "GET"c,
                                                 pathBuf as pchar, 0, 0, 0, 0);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.bodyPtr != 0) {
        result := resp.bodyPtr;
        resp.bodyPtr := 0;
    }
    HTTPResponseFree(resp);
