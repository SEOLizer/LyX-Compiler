pub fn SpacesObjectList(creds: DOCredentials, bucket: pchar, region: pchar,
                        prefix: pchar): int64 {
    var hostBuf: int64 := alloc(128);
    buildSpacesHost(hostBuf, bucket, region);
    var pathBuf: int64 := alloc(512);
    var path: pchar := "/?list-type=2"c;
    var pl: int64 := StrLen(path);
    var i: int64 := 0;
    while(i<pl){poke8(pathBuf+i,StrCharAt(path,i)&0xFF);i:=i+1;}
    if (prefix != 0 as pchar) {
        var pfx: pchar := "&prefix="c;
        var pfxl: int64 := StrLen(pfx);
        i:=0; while(i<pfxl){poke8(pathBuf+pl+i,StrCharAt(pfx,i)&0xFF);i:=i+1;} pl:=pl+pfxl;
        var encodedBuf: int64 := alloc(1024);
        var encodedLen: int64 := urlEncode(prefix, encodedBuf);
        i:=0; while(i<encodedLen){poke8(pathBuf+pl+i,peek8(encodedBuf+i)&0xFF);i:=i+1;}
        pl:=pl+encodedLen;
        free(encodedBuf, 1024);
    }
    poke8(pathBuf+pl,0);
    var resp: HTTPResponse := spacesSendRequest(hostBuf as pchar, "GET"c,
                                                 pathBuf as pchar, 0, 0, 0, 0);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.bodyPtr != 0) {
        result := resp.bodyPtr;
        resp.bodyPtr := 0;
    }
    HTTPResponseFree(resp);
    free(hostBuf, 128);
    free(pathBuf, 512);
    return result;
}

pub fn SpacesObjectCopy(creds: DOCredentials,
                        srcBucket: pchar, srcRegion: pchar, srcKey: pchar,
                        dstBucket: pchar, dstRegion: pchar, dstKey: pchar): int64 {
    var hostBuf: int64 := alloc(128);
    buildSpacesHost(hostBuf, dstBucket, dstRegion);
    var pathBuf: int64 := alloc(512);
    poke8(pathBuf, 47);
    var kl: int64 := StrLen(dstKey);
    var i: int64 := 0;
    while(i<kl){poke8(pathBuf+1+i,StrCharAt(dstKey,i)&0xFF);i:=i+1;}
    poke8(pathBuf+1+kl,0);
    // x-amz-copy-source: /srcBucket/srcKey
    var copySourceBuf: int64 := alloc(512);
    poke8(copySourceBuf, 47);
    var sl: int64 := StrLen(srcBucket);
    i:=0; while(i<sl){poke8(copySourceBuf+1+i,StrCharAt(srcBucket,i)&0xFF);i:=i+1;}
    poke8(copySourceBuf+1+sl, 47);
    var skl: int64 := StrLen(srcKey);
    i:=0; while(i<skl){poke8(copySourceBuf+2+sl+i,StrCharAt(srcKey,i)&0xFF);i:=i+1;}
    poke8(copySourceBuf+2+sl+skl,0);
    // Build header array: {name, value} as inline struct
    // We encode it as a flat buffer: name\0value\0 pairs
    // HTTPRequestBuild expects headers as HTTPHeader array; we use extraHeaders=0 for simplicity
    // and rely on the COPY to go through with a raw PUT with x-amz-copy-source.
    var resp: HTTPResponse := spacesSendRequest(hostBuf as pchar, "PUT"c,
                                                 pathBuf as pchar, copySourceBuf, 1, 0, 0);
    var ok: int64 := 0;
    if (resp.statusCode == 200) { ok := 1; }
    HTTPResponseFree(resp);
    free(hostBuf, 128);
    free(pathBuf, 512);
    free(copySourceBuf, 512);
    return ok;
}

pub fn SpacesObjectSetACL(creds: DOCredentials, bucket: pchar, region: pchar,
                          key: pchar, acl: pchar): int64 {
    // PUT /<key>?acl
    var hostBuf: int64 := alloc(128);
    buildSpacesHost(hostBuf, bucket, region);
    var pathBuf: int64 := alloc(512);
    poke8(pathBuf, 47);
    var kl: int64 := StrLen(key);
    var i: int64 := 0;
    while(i<kl){poke8(pathBuf+1+i,StrCharAt(key,i)&0xFF);i:=i+1;}
    var sfx: pchar := "?acl"c; var sl: int64 := StrLen(sfx);
    i:=0; while(i<sl){poke8(pathBuf+1+kl+i,StrCharAt(sfx,i)&0xFF);i:=i+1;}
    poke8(pathBuf+1+kl+sl,0);
    var resp: HTTPResponse := spacesSendRequest(hostBuf as pchar, "PUT"c,
                                                 pathBuf as pchar, 0, 0, 0, 0);
    var ok: int64 := 0;
    if (resp.statusCode == 200) { ok := 1; }
    HTTPResponseFree(resp);
    free(hostBuf, 128);
    free(pathBuf, 512);
    return ok;
}

pub fn SpacesBucketSetCORS(creds: DOCredentials, bucket: pchar, region: pchar,
                            allowedOrigin: pchar): int64 {
    var hostBuf: int64 := alloc(128);
    buildSpacesHost(hostBuf, bucket, region);
    var xmlPre: pchar := "<?xml version=\"1.0\" encoding=\"UTF-8\"?><CORSConfiguration><CORSRule><AllowedOrigin>"c;
    var xmlMid: pchar := "</AllowedOrigin><AllowedMethod>GET</AllowedMethod><AllowedMethod>PUT</AllowedMethod><AllowedMethod>DELETE</AllowedMethod></CORSRule></CORSConfiguration>"c;
    var ol: int64 := StrLen(allowedOrigin);
    var xmlLen: int64 := StrLen(xmlPre) + ol + StrLen(xmlMid);
    var body: int64 := alloc(xmlLen + 1);
    var p: int64 := body;
    var i: int64 := 0;
    var xpl: int64 := StrLen(xmlPre);
    while(i<xpl){poke8(p+i,StrCharAt(xmlPre,i)&0xFF);i:=i+1;} p:=p+xpl;
    i:=0; while(i<ol){poke8(p+i,StrCharAt(allowedOrigin,i)&0xFF);i:=i+1;} p:=p+ol;
    var xml2l: int64 := StrLen(xmlMid);
    i:=0; while(i<xml2l){poke8(p+i,StrCharAt(xmlMid,i)&0xFF);i:=i+1;} p:=p+xml2l;
    poke8(p,0);
    var resp: HTTPResponse := spacesSendRequest(hostBuf as pchar, "PUT"c,
                                                 "/?cors"c, 0, 0,
                                                 body, xmlLen);
    var ok: int64 := 0;
    if (resp.statusCode == 200) { ok := 1; }
    HTTPResponseFree(resp);
    free(hostBuf, 128);
    free(body, xmlLen + 1);
    return ok;
}

pub fn SpacesPresignURL(creds: DOCredentials, bucket: pchar, region: pchar,
                        key: pchar, expiresSeconds: int64): int64 {
    // Build a pre-signed URL (unsigned path for public read objects, or basic auth).
    // Format: https://<bucket>.<region>.digitaloceanspaces.com/<key>?
    //   X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=...&X-Amz-Expires=<n>&X-Amz-SignedHeaders=host&X-Amz-Signature=...
    var buf: int64 := alloc(2048);
    var p: int64 := buf;
    var https: pchar := "https://"c; var hl: int64 := StrLen(https);
    var i: int64 := 0;
    while(i<hl){poke8(p+i,StrCharAt(https,i)&0xFF);i:=i+1;} p:=p+hl;
    var hostBuf: int64 := alloc(128);
    buildSpacesHost(hostBuf, bucket, region);
    var hbl: int64 := StrLen(hostBuf as pchar);
    i:=0; while(i<hbl){poke8(p+i,peek8(hostBuf+i)&0xFF);i:=i+1;} p:=p+hbl;
    free(hostBuf, 128);
    poke8(p,47); p:=p+1;
    var kl: int64 := StrLen(key);
    i:=0; while(i<kl){poke8(p+i,StrCharAt(key,i)&0xFF);i:=i+1;} p:=p+kl;
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(expiresSeconds, numBuf);
    var nn: int64 := StrLen(numStr);
    var sfx: pchar := "?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Expires="c;
    var sl: int64 := StrLen(sfx);
    i:=0; while(i<sl){poke8(p+i,StrCharAt(sfx,i)&0xFF);i:=i+1;} p:=p+sl;
    i:=0; while(i<nn){poke8(p+i,StrCharAt(numStr,i)&0xFF);i:=i+1;} p:=p+nn;
    free(numBuf, 24);
    poke8(p,0);
    var resultLen: int64 := p - buf;
    var result: int64 := alloc(resultLen + 1);
    i:=0; while(i<resultLen){poke8(result+i,peek8(buf+i));i:=i+1;}
    poke8(result+resultLen,0);
    free(buf, 2048);
    return result;
}
