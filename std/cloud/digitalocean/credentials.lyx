// std/cloud/do/credentials.lyx — DigitalOcean Credential Management
// WP-DO-02: PAT/OAuth2 token load from env var, config file, and direct.
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, system.env, system.time])

unit std.cloud.digitalocean.credentials;

import std.env;

import std.cloud.digitalocean.transport;
import std.alloc;
import std.io;
import std.fs;

// #1179: Hier stand `extern fn getenv(name: pchar): pchar;` OHNE
// link-Klausel — das Symbol wurde nie gebunden, der Aufruf lieferte still 0,
// und jede Abfrage sah aus wie eine nicht gesetzte Variable. Die Umgebung
// liegt beim Start auf dem Stack; std.env liest sie ohne C-Bibliothek.
fn getenv(name: pchar): pchar { return EnvLookupRaw(name); }

// ============================================================================
// Constants
// ============================================================================

pub con DO_TOKEN_PAT:    int64 := 1;
pub con DO_TOKEN_OAUTH2: int64 := 2;

pub con DO_CONFIG_DIR:  pchar := "/.config/lyxdo"c;
pub con DO_CONFIG_FILE: pchar := "/.config/lyxdo/config.json"c;

// ============================================================================
// DOCredentials struct
// ============================================================================

pub type DOCredentials = struct {
    token:         int64;  // pchar: Bearer token (alloc'd)
    tokenLen:      int64;
    tokenType:     int64;  // DO_TOKEN_PAT | DO_TOKEN_OAUTH2
    refreshToken:  int64;  // pchar: OAuth2 refresh token (alloc'd, or 0)
    expiresAt:     int64;  // Unix-TS, 0 = never (PAT)
    defaultRegion: int64;  // pchar: e.g. "fra1" (alloc'd, or 0)
    spacesKey:     int64;  // pchar: Spaces access key (alloc'd, or 0)
    spacesSecret:  int64;  // pchar: Spaces secret key (alloc'd, or 0)
};

// ============================================================================
// Memory helpers
// ============================================================================

fn doStrDup(s: int64): int64 {
    if (s == 0) { return 0; }
    var len: int64 := StrLen(s as pchar);
    var buf: int64 := alloc(len + 1);
    var i: int64 := 0;
    while (i < len) { poke8(buf + i, peek8(s + i)); i := i + 1; }
    poke8(buf + len, 0);
    return buf;
}

fn doPcharDup(s: pchar): int64 {
    return doStrDup(s as int64);
}

// ============================================================================
// DOCredentialsFree
// ============================================================================

pub fn DOCredentialsFree(creds: DOCredentials) {
    if (creds.token         != 0) { free(creds.token,         creds.tokenLen + 1); }
    if (creds.refreshToken  != 0) { free(creds.refreshToken,  StrLen(creds.refreshToken  as pchar) + 1); }
    if (creds.defaultRegion != 0) { free(creds.defaultRegion, StrLen(creds.defaultRegion as pchar) + 1); }
    if (creds.spacesKey     != 0) { free(creds.spacesKey,     StrLen(creds.spacesKey     as pchar) + 1); }
    if (creds.spacesSecret  != 0) { free(creds.spacesSecret,  StrLen(creds.spacesSecret  as pchar) + 1); }
}

// ============================================================================
// Create from explicit token
// ============================================================================

pub fn DOCredentialsFromToken(token: pchar): DOCredentials {
    var c: DOCredentials;
    c.tokenLen      := StrLen(token);
    c.token         := doStrDup(token as int64);
    c.tokenType     := DO_TOKEN_PAT;
    c.refreshToken  := 0;
    c.expiresAt     := 0;
    c.defaultRegion := 0;
    c.spacesKey     := 0;
    c.spacesSecret  := 0;
    return c;
}

// ============================================================================
// Load from environment variables
// ============================================================================

pub fn DOCredentialsFromEnv(): DOCredentials {
    var c: DOCredentials;
    c.tokenLen      := 0;
    c.token         := 0;
    c.tokenType     := DO_TOKEN_PAT;
    c.refreshToken  := 0;
    c.expiresAt     := 0;
    c.defaultRegion := 0;
    c.spacesKey     := 0;
    c.spacesSecret  := 0;

    var envName: pchar := "DIGITALOCEAN_TOKEN"c;
    var tok: pchar := getenv(envName);
    if (tok != 0 as pchar) {
        c.tokenLen := StrLen(tok);
        c.token    := doStrDup(tok as int64);
    }

    var skName: pchar := "DIGITALOCEAN_SPACES_ACCESS_KEY"c;
    var sk: pchar := getenv(skName);
    if (sk != 0 as pchar) { c.spacesKey := doStrDup(sk as int64); }

    var ssName: pchar := "DIGITALOCEAN_SPACES_SECRET_KEY"c;
    var ss: pchar := getenv(ssName);
    if (ss != 0 as pchar) { c.spacesSecret := doStrDup(ss as int64); }

    return c;
}

// ============================================================================
// Config file path helper
// ============================================================================

pub fn DOConfigPath(): pchar {
    var homeEnv: pchar := "HOME"c;
    var home: pchar := getenv(homeEnv);
    if (home == 0 as pchar) { return 0 as pchar; }
    var homeLen: int64 := StrLen(home);
    var cfgLen: int64 := StrLen(DO_CONFIG_FILE);
    var buf: int64 := alloc(homeLen + cfgLen + 1);
    var i: int64 := 0;
    while (i < homeLen)           { poke8(buf + i, StrCharAt(home, i)              & 0xFF); i := i + 1; }
    while (i < homeLen + cfgLen)  { poke8(buf + i, StrCharAt(DO_CONFIG_FILE, i - homeLen) & 0xFF); i := i + 1; }
    poke8(buf + homeLen + cfgLen, 0);
    return buf as pchar;
}

fn doCfgDirPath(): int64 {
    var homeEnv: pchar := "HOME"c;
    var home: pchar := getenv(homeEnv);
    if (home == 0 as pchar) { return 0; }
    var homeLen: int64 := StrLen(home);
    var dirLen: int64 := StrLen(DO_CONFIG_DIR);
    var buf: int64 := alloc(homeLen + dirLen + 1);
    var i: int64 := 0;
    while (i < homeLen)          { poke8(buf + i, StrCharAt(home, i)             & 0xFF); i := i + 1; }
    while (i < homeLen + dirLen) { poke8(buf + i, StrCharAt(DO_CONFIG_DIR, i - homeLen) & 0xFF); i := i + 1; }
    poke8(buf + homeLen + dirLen, 0);
    return buf;
}

// ============================================================================
// Load from config file (JSON)
// ============================================================================

pub fn DOCredentialsFromFile(path: pchar): DOCredentials {
    var c: DOCredentials;
    c.tokenLen      := 0;
    c.token         := 0;
    c.tokenType     := DO_TOKEN_PAT;
    c.refreshToken  := 0;
    c.expiresAt     := 0;
    c.defaultRegion := 0;
    c.spacesKey     := 0;
    c.spacesSecret  := 0;

    var fsize: int64 := FileSize(path);
    if (fsize <= 0 || fsize > 65536) { return c; }

    var jsonBuf: int64 := alloc(fsize + 1);
    var n: int64 := ReadFile(path, jsonBuf as pchar, fsize);
    if (n <= 0) { free(jsonBuf, fsize + 1); return c; }
    poke8(jsonBuf + n, 0);

    var tokKey:    pchar := "token"c;
    var regKey:    pchar := "default_region"c;
    var skKey:     pchar := "spaces_access_key"c;
    var ssKey:     pchar := "spaces_secret_key"c;
    var rtKey:     pchar := "refresh_token"c;

    var tok: int64 := doJsonStr(jsonBuf, tokKey);
    if (tok != 0) {
        c.token    := tok;
        c.tokenLen := StrLen(tok as pchar);
    }
    c.defaultRegion := doJsonStr(jsonBuf, regKey);
    c.spacesKey     := doJsonStr(jsonBuf, skKey);
    c.spacesSecret  := doJsonStr(jsonBuf, ssKey);
    c.refreshToken  := doJsonStr(jsonBuf, rtKey);

    free(jsonBuf, fsize + 1);
    return c;
}

pub fn DOConfigLoad(path: pchar): DOCredentials {
    return DOCredentialsFromFile(path);
}

// ============================================================================
// Default credential chain: env → config file → error
// ============================================================================

pub fn DOCredentialsDefault(): DOCredentials {
    // 1. Try environment variable
    var envName: pchar := "DIGITALOCEAN_TOKEN"c;
    var tok: pchar := getenv(envName);
    if (tok != 0 as pchar && StrLen(tok) > 0) {
        return DOCredentialsFromEnv();
    }
    // 2. Try config file
    var cfgPath: pchar := DOConfigPath();
    if (cfgPath != 0 as pchar) {
        if (FileExists(cfgPath)) {
            var c: DOCredentials := DOCredentialsFromFile(cfgPath);
            free(cfgPath as int64, StrLen(cfgPath) + 1);
            if (c.token != 0) { return c; }
        } else {
            free(cfgPath as int64, StrLen(cfgPath) + 1);
        }
    }
    // 3. Return empty credentials (token==0 signals error to caller)
    var empty: DOCredentials;
    empty.token         := 0;
    empty.tokenLen      := 0;
    empty.tokenType     := DO_TOKEN_PAT;
    empty.refreshToken  := 0;
    empty.expiresAt     := 0;
    empty.defaultRegion := 0;
    empty.spacesKey     := 0;
    empty.spacesSecret  := 0;
    return empty;
}

// ============================================================================
// Save config file (mode 0600 — chmod after write)
// ============================================================================

pub fn DOConfigSave(creds: DOCredentials, path: pchar): int64 {
    // Build JSON: {"token":"...","default_region":"...","spaces_access_key":"...","spaces_secret_key":"..."}
    var buf: int64 := alloc(4096);
    var p: int64 := buf;

    // Write '{'
    poke8(p, 123); p := p + 1;

    // "token":"..."
    var t1: pchar := "\"token\":\""c;
    var l1: int64 := StrLen(t1);
    var i: int64 := 0;
    while (i < l1) { poke8(p + i, StrCharAt(t1, i) & 0xFF); i := i + 1; }
    p += l1;
    if (creds.token != 0) {
        var tl: int64 := creds.tokenLen;
        i := 0;
        while (i < tl) { poke8(p + i, peek8(creds.token + i)); i := i + 1; }
        p += tl;
    }
    poke8(p, 34); poke8(p+1, 44); p := p + 2; // ","

    // "default_region":"..."
    if (creds.defaultRegion != 0) {
        var t2: pchar := "\"default_region\":\""c;
        var l2: int64 := StrLen(t2);
        i := 0;
        while (i < l2) { poke8(p + i, StrCharAt(t2, i) & 0xFF); i := i + 1; }
        p += l2;
        var rl: int64 := StrLen(creds.defaultRegion as pchar);
        i := 0;
        while (i < rl) { poke8(p + i, peek8(creds.defaultRegion + i)); i := i + 1; }
        p += rl;
        poke8(p, 34); poke8(p+1, 44); p := p + 2;
    }

    // "spaces_access_key":"..."
    if (creds.spacesKey != 0) {
        var t3: pchar := "\"spaces_access_key\":\""c;
        var l3: int64 := StrLen(t3);
        i := 0;
        while (i < l3) { poke8(p + i, StrCharAt(t3, i) & 0xFF); i := i + 1; }
        p += l3;
        var sl: int64 := StrLen(creds.spacesKey as pchar);
        i := 0;
        while (i < sl) { poke8(p + i, peek8(creds.spacesKey + i)); i := i + 1; }
        p += sl;
        poke8(p, 34); poke8(p+1, 44); p := p + 2;
    }

    // "spaces_secret_key":"..."
    if (creds.spacesSecret != 0) {
        var t4: pchar := "\"spaces_secret_key\":\""c;
        var l4: int64 := StrLen(t4);
        i := 0;
        while (i < l4) { poke8(p + i, StrCharAt(t4, i) & 0xFF); i := i + 1; }
        p += l4;
        var ssl: int64 := StrLen(creds.spacesSecret as pchar);
        i := 0;
        while (i < ssl) { poke8(p + i, peek8(creds.spacesSecret + i)); i := i + 1; }
        p += ssl;
        poke8(p, 34); poke8(p+1, 44); p := p + 2;
    }

    // Remove trailing comma if any and close object
    if (peek8(p - 1) == 44) { p := p - 1; }
    poke8(p, 125); p := p + 1; // '}'
    poke8(p, 0);

    var jsonLen: int64 := p - buf;
    var n: int64 := WriteFile(path, buf as pchar, jsonLen);
    free(buf, 4096);
    // Set mode 0600 (only owner can read/write)
    Chmod(path, 384); // 0600 octal = 384 decimal
    if (n == jsonLen) { return 0; }
    return 1;
}

// ============================================================================
// Token validity check
// ============================================================================

pub fn DOTokenIsExpired(creds: DOCredentials): int64 {
    if (creds.expiresAt == 0) { return 0; }
    // Compare with current time (not implemented without std.time import cycle)
    return 0;
}

pub fn DOValidateToken(creds: DOCredentials): int64 {
    if (creds.token == 0) { return 0; }
    var c: DOClient := DOClientNew(creds.token as pchar);
    var path: pchar := "/v2/account"c;
    var resp: HTTPResponse := DOGet(c, path);
    var ok: int64 := 0;
    if (resp.statusCode == 200) { ok := 1; }
    HTTPResponseFree(resp);
    return ok;
}

// ============================================================================
// OAuth2 token refresh (stub: returns creds unchanged if no refreshToken)
// ============================================================================

pub fn DOTokenRefresh(creds: DOCredentials): DOCredentials {
    // OAuth2 refresh: POST to /v1/oauth/token with refresh_token grant
    if (creds.refreshToken == 0) { return creds; }
    // Build OAuth2 host and path
    var host: pchar := "cloud.digitalocean.com"c;
    var path: pchar := "/v1/oauth/token"c;
    // Build body: grant_type=refresh_token&refresh_token=...
    var rtLen: int64 := StrLen(creds.refreshToken as pchar);
    var prefix: pchar := "grant_type=refresh_token&refresh_token="c;
    var pl: int64 := StrLen(prefix);
    var bodyBuf: int64 := alloc(pl + rtLen + 1);
    var i: int64 := 0;
    while (i < pl)          { poke8(bodyBuf + i, StrCharAt(prefix, i) & 0xFF); i := i + 1; }
    while (i < pl + rtLen)  { poke8(bodyBuf + i, peek8(creds.refreshToken + i - pl)); i := i + 1; }
    poke8(bodyBuf + pl + rtLen, 0);
    // Build minimal client with no auth header (OAuth2 refresh)
    var hdrs: int64 := 0;
    var ctKey: pchar := "Content-Type"c;
    var ctVal: pchar := "application/x-www-form-urlencoded"c;
    hdrs := HTTPSetHeader(hdrs, ctKey as int64, ctVal as int64);
    var ctx: TLSContext := TLSInit();
    var newCreds: DOCredentials := creds;
    if (ctx.initialized != 0) {
        var ip: int64 := GetHostByName(host as int64);
        if (ip != 0) {
            var tcpConn: TCPConn := TCPConnect(ip, HTTPS_PORT);
            if (tcpConn.fd >= 0) {
                var conn: TLSConn := TLSConnect(ctx, tcpConn.fd, host as int64);
                if (conn.connected != 0) {
                    var req: HTTPRequest;
                    req.method   := HTTP_POST;
                    req.host     := host as int64;
                    req.path     := path as int64;
                    req.port     := HTTPS_PORT;
                    req.headers  := hdrs;
                    req.body     := bodyBuf;
                    req.bodySize := pl + rtLen;
                    var reqBuf: int64 := HTTPRequestBuild(req);
                    if (reqBuf != 0) {
                        var allocSz: int64 := peek64(reqBuf);
                        var reqSz:   int64 := peek64(reqBuf + 8);
                        TLSWrite(conn, reqBuf + 16, reqSz);
                        munmap(reqBuf, allocSz);
                        var respBuf: int64 := mmap(0, 16384, PROT_RW, MAP_ANON, FD_NONE, 0);
                        if (respBuf != 0) {
                            var n: int64 := TLSRead(conn, respBuf, 16383);
                            if (n > 0) {
                                poke8(respBuf + n, 0);
                                // Find body after \r\n\r\n
                                var bi: int64 := 0;
                                while (bi < n - 4) {
                                    if (peek8(respBuf+bi)==13 && peek8(respBuf+bi+1)==10 &&
                                        peek8(respBuf+bi+2)==13 && peek8(respBuf+bi+3)==10) {
                                        bi += 4; break;
                                    }
                                    bi += 1;
                                }
                                var body: int64 := respBuf + bi;
                                var atKey: pchar := "access_token"c;
                                var rtKey: pchar := "refresh_token"c;
                                var newTok: int64 := doJsonStr(body, atKey);
                                var newRt:  int64 := doJsonStr(body, rtKey);
                                if (newTok != 0) {
                                    if (newCreds.token != 0) { free(newCreds.token, newCreds.tokenLen + 1); }
                                    newCreds.token    := newTok;
                                    newCreds.tokenLen := StrLen(newTok as pchar);
                                }
                                if (newRt != 0) {
                                    if (newCreds.refreshToken != 0) {
                                        free(newCreds.refreshToken, StrLen(newCreds.refreshToken as pchar) + 1);
                                    }
                                    newCreds.refreshToken := newRt;
                                }
                            }
                            munmap(respBuf, 16384);
                        }
                    }
                    TLSClose(conn);
                }
                sys_close(tcpConn.fd);
            }
        }
        TLSFree(ctx);
    }
    HTTPHeadersFree(hdrs);
    free(bodyBuf, pl + rtLen + 1);
    return newCreds;
}
