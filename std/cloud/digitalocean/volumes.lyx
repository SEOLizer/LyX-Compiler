@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, system.env, system.time])

unit std.cloud.digitalocean.volumes;

import std.cloud.digitalocean.transport;
import std.cloud.digitalocean.credentials;
import std.alloc;
import std.io;
import std.time;

pub type DOVolume = struct {
    id:          int64;  // pchar UUID (alloc'd)
    name:        int64;  // pchar (alloc'd)
    region:      int64;  // pchar (alloc'd)
    sizeGB:      int64;
    status:      int64;  // pchar (alloc'd)
    filesystemType: int64; // pchar (alloc'd)
};

pub fn DOVolumeFree(v: DOVolume) {
    if (v.id             != 0) { free(v.id,             StrLen(v.id             as pchar) + 1); }
    if (v.name           != 0) { free(v.name,           StrLen(v.name           as pchar) + 1); }
    if (v.region         != 0) { free(v.region,         StrLen(v.region         as pchar) + 1); }
    if (v.status         != 0) { free(v.status,         StrLen(v.status         as pchar) + 1); }
    if (v.filesystemType != 0) { free(v.filesystemType, StrLen(v.filesystemType as pchar) + 1); }
}

pub type DOSnapshot = struct {
    id:           int64;  // pchar (alloc'd)
    name:         int64;  // pchar (alloc'd)
    createdAt:    int64;  // pchar (alloc'd)
    resourceType: int64;  // pchar: "droplet","volume" (alloc'd)
    minDiskSize:  int64;
};

pub fn DOSnapshotFree(s: DOSnapshot) {
    if (s.id           != 0) { free(s.id,           StrLen(s.id           as pchar) + 1); }
    if (s.name         != 0) { free(s.name,         StrLen(s.name         as pchar) + 1); }
    if (s.createdAt    != 0) { free(s.createdAt,    StrLen(s.createdAt    as pchar) + 1); }
    if (s.resourceType != 0) { free(s.resourceType, StrLen(s.resourceType as pchar) + 1); }
}

fn doClientVol(creds: DOCredentials): DOClient {
    var c: DOClient; c.token := creds.token; c.tokenLen := creds.tokenLen; return c;
}

fn parseVolume(json: int64): DOVolume {
    var v: DOVolume;
    v.id             := doJsonStr(json, "id"c);
    v.name           := doJsonStr(json, "name"c);
    v.region         := doJsonStr(json, "slug"c);
    v.sizeGB         := doJsonInt(json, "size_gigabytes"c);
    v.status         := doJsonStr(json, "status"c);
    v.filesystemType := doJsonStr(json, "filesystem_type"c);
    return v;
}

fn parseSnapshot(json: int64): DOSnapshot {
    var s: DOSnapshot;
    s.id           := doJsonStr(json, "id"c);
    s.name         := doJsonStr(json, "name"c);
    s.createdAt    := doJsonStr(json, "created_at"c);
    s.resourceType := doJsonStr(json, "resource_type"c);
    s.minDiskSize  := doJsonInt(json, "min_disk_size"c);
    return s;
}

pub fn VolumeCreate(creds: DOCredentials,
                    name: pchar, region: pchar,
                    sizeGB: int64, filesystemType: pchar): DOVolume {
    var v: DOVolume;
    v.id := 0; v.name := 0; v.region := 0; v.sizeGB := 0; v.status := 0; v.filesystemType := 0;
    var buf: int64 := alloc(1024);
    var p: int64 := buf;
    var h: pchar := "{\"name\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(p+i,StrCharAt(h,i)&0xFF);i:=i+1;} p:=p+lh;
    var nl: int64 := StrLen(name);
    i:=0; while(i<nl){poke8(p+i,StrCharAt(name,i)&0xFF);i:=i+1;} p:=p+nl;
    var s1: pchar := "\",\"region\":\""c; var l1: int64 := StrLen(s1);
    i:=0; while(i<l1){poke8(p+i,StrCharAt(s1,i)&0xFF);i:=i+1;} p:=p+l1;
    var rl: int64 := StrLen(region);
    i:=0; while(i<rl){poke8(p+i,StrCharAt(region,i)&0xFF);i:=i+1;} p:=p+rl;
    var s2: pchar := "\",\"size_gigabytes\":"c; var l2: int64 := StrLen(s2);
    i:=0; while(i<l2){poke8(p+i,StrCharAt(s2,i)&0xFF);i:=i+1;} p:=p+l2;
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(sizeGB, numBuf);
    var nn: int64 := StrLen(numStr);
    i:=0; while(i<nn){poke8(p+i,StrCharAt(numStr,i)&0xFF);i:=i+1;} p:=p+nn;
    free(numBuf, 24);
    var s3: pchar := ",\"filesystem_type\":\""c; var l3: int64 := StrLen(s3);
    i:=0; while(i<l3){poke8(p+i,StrCharAt(s3,i)&0xFF);i:=i+1;} p:=p+l3;
    var fl: int64 := StrLen(filesystemType);
    i:=0; while(i<fl){poke8(p+i,StrCharAt(filesystemType,i)&0xFF);i:=i+1;} p:=p+fl;
    var t: pchar := "\"}"c; var lt: int64 := StrLen(t);
    i:=0; while(i<lt){poke8(p+i,StrCharAt(t,i)&0xFF);i:=i+1;} p:=p+lt;
    poke8(p,0);
    var bodyLen: int64 := p - buf;
    var cl: DOClient := doClientVol(creds);
    var path: pchar := "/v2/volumes"c;
    var resp: HTTPResponse := DOPost(cl, path, buf, bodyLen);
    free(buf, 1024);
    if (resp.statusCode == 201 && resp.bodyPtr != 0) { v := parseVolume(resp.bodyPtr); }
    HTTPResponseFree(resp);
    return v;
}

pub fn VolumeDelete(creds: DOCredentials, id: pchar): int64 {
    var cl: DOClient := doClientVol(creds);
    var pathBuf: int64 := alloc(128);
    var base: pchar := "/v2/volumes/"c;
    doMakePath(pathBuf, base, id);
    var resp: HTTPResponse := DODelete(cl, pathBuf as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 204) { ok := 1; }
    HTTPResponseFree(resp);
    free(pathBuf, 128);
    return ok;
}

pub fn VolumeGet(creds: DOCredentials, id: pchar): DOVolume {
    var v: DOVolume;
    v.id := 0; v.name := 0; v.region := 0; v.sizeGB := 0; v.status := 0; v.filesystemType := 0;
    var cl: DOClient := doClientVol(creds);
    var pathBuf: int64 := alloc(128);
    var base: pchar := "/v2/volumes/"c;
    doMakePath(pathBuf, base, id);
    var resp: HTTPResponse := DOGet(cl, pathBuf as pchar);
    if (resp.statusCode == 200 && resp.bodyPtr != 0) { v := parseVolume(resp.bodyPtr); }
    HTTPResponseFree(resp);
    free(pathBuf, 128);
    return v;
}

pub fn VolumeList(creds: DOCredentials): int64 {
    var cl: DOClient := doClientVol(creds);
    var path: pchar := "/v2/volumes"c;
    return DOGetAll(cl, path, "volumes"c);
}

fn volumeAction(creds: DOCredentials, id: pchar, actionType: pchar, dropletId: int64): int64 {
    var cl: DOClient := doClientVol(creds);
    var buf: int64 := alloc(256);
    var p: int64 := buf;
    var h: pchar := "{\"type\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(p+i,StrCharAt(h,i)&0xFF);i:=i+1;} p:=p+lh;
    var al: int64 := StrLen(actionType);
    i:=0; while(i<al){poke8(p+i,StrCharAt(actionType,i)&0xFF);i:=i+1;} p:=p+al;
    if (dropletId > 0) {
        var s: pchar := "\",\"droplet_id\":"c; var ls: int64 := StrLen(s);
        i:=0; while(i<ls){poke8(p+i,StrCharAt(s,i)&0xFF);i:=i+1;} p:=p+ls;
        var numBuf: int64 := alloc(24);
        var numStr: pchar := Int64ToStr(dropletId, numBuf);
        var nn: int64 := StrLen(numStr);
        i:=0; while(i<nn){poke8(p+i,StrCharAt(numStr,i)&0xFF);i:=i+1;} p:=p+nn;
        free(numBuf, 24);
        poke8(p,125); p:=p+1; // '}'
    } else {
        var t: pchar := "\"}"c; var lt: int64 := StrLen(t);
        i:=0; while(i<lt){poke8(p+i,StrCharAt(t,i)&0xFF);i:=i+1;} p:=p+lt;
    }
    poke8(p,0);
    var bodyLen: int64 := p - buf;
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/volumes/"c, id, "/actions"c);
    var resp: HTTPResponse := DOPost(cl, pathBuf as pchar, buf, bodyLen);
    var actionId: int64 := 0;
    if (resp.statusCode == 202 && resp.bodyPtr != 0) {
        actionId := doJsonInt(resp.bodyPtr, "id"c);
    }
    HTTPResponseFree(resp);
    free(buf, 256);
    free(pathBuf, 256);
    return actionId;
}

pub fn VolumeAttach(creds: DOCredentials, id: pchar, dropletId: int64): int64 {
    return volumeAction(creds, id, "attach"c, dropletId);
}

pub fn VolumeDetach(creds: DOCredentials, id: pchar, dropletId: int64): int64 {
    return volumeAction(creds, id, "detach"c, dropletId);
}

pub fn VolumeResize(creds: DOCredentials, id: pchar, newSizeGB: int64): int64 {
    var cl: DOClient := doClientVol(creds);
    var buf: int64 := alloc(256);
    var h: pchar := "{\"type\":\"resize\",\"size_gigabytes\":"c;
    var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(buf+i,StrCharAt(h,i)&0xFF);i:=i+1;}
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(newSizeGB, numBuf);
    var nn: int64 := StrLen(numStr);
    i:=0; while(i<nn){poke8(buf+lh+i,StrCharAt(numStr,i)&0xFF);i:=i+1;}
    free(numBuf, 24);
    poke8(buf+lh+nn,125); poke8(buf+lh+nn+1,0);
    var bodyLen: int64 := lh + nn + 1;
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/volumes/"c, id, "/actions"c);
    var resp: HTTPResponse := DOPost(cl, pathBuf as pchar, buf, bodyLen);
    var actionId: int64 := 0;
    if (resp.statusCode == 202 && resp.bodyPtr != 0) { actionId := doJsonInt(resp.bodyPtr, "id"c); }
    HTTPResponseFree(resp);
    free(buf, 256);
    free(pathBuf, 256);
    return actionId;
}

pub fn VolumeWaitAttached(creds: DOCredentials, id: pchar): DOVolume {
    var maxAttempts: int64 := 30;
    var attempt: int64 := 0;
    var v: DOVolume;
    v.id := 0; v.name := 0; v.region := 0; v.sizeGB := 0; v.status := 0; v.filesystemType := 0;
    while (attempt < maxAttempts) {
        v := VolumeGet(creds, id);
        if (v.status != 0) {
            var attached: pchar := "attached"c;
            var slen: int64 := StrLen(v.status as pchar);
            var alen: int64 := StrLen(attached);
            if (slen == alen) {
                var isMatch: int64 := 1; var j: int64 := 0;
                while(j<slen){if(peek8(v.status+j)!=(StrCharAt(attached,j)&0xFF)){isMatch:=0;break;}j:=j+1;}
                if (isMatch == 1) { return v; }
            }
        }
        DOVolumeFree(v);
        v.id := 0; v.name := 0; v.region := 0; v.sizeGB := 0; v.status := 0; v.filesystemType := 0;
        Sleep(5000);
        attempt += 1;
    }
    return v;
}

pub fn VolumeWaitDetached(creds: DOCredentials, id: pchar): DOVolume {
    var maxAttempts: int64 := 30;
    var attempt: int64 := 0;
    var v: DOVolume;
    v.id := 0; v.name := 0; v.region := 0; v.sizeGB := 0; v.status := 0; v.filesystemType := 0;
    while (attempt < maxAttempts) {
        v := VolumeGet(creds, id);
        if (v.status != 0) {
            var avail: pchar := "available"c;
            var slen: int64 := StrLen(v.status as pchar);
            var alen: int64 := StrLen(avail);
            if (slen == alen) {
                var isMatch: int64 := 1; var j: int64 := 0;
                while(j<slen){if(peek8(v.status+j)!=(StrCharAt(avail,j)&0xFF)){isMatch:=0;break;}j:=j+1;}
                if (isMatch == 1) { return v; }
            }
        }
        DOVolumeFree(v);
        v.id := 0; v.name := 0; v.region := 0; v.sizeGB := 0; v.status := 0; v.filesystemType := 0;
        Sleep(5000);
        attempt += 1;
    }
    return v;
}

pub fn VolumeSnapshotCreate(creds: DOCredentials, id: pchar, name: pchar): int64 {
    var cl: DOClient := doClientVol(creds);
    var buf: int64 := alloc(256);
    var h: pchar := "{\"name\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(buf+i,StrCharAt(h,i)&0xFF);i:=i+1;}
    var nl: int64 := StrLen(name);
    i:=0; while(i<nl){poke8(buf+lh+i,StrCharAt(name,i)&0xFF);i:=i+1;}
    var t: pchar := "\"}"c; var lt: int64 := StrLen(t);
    var off: int64 := lh + nl;
    i:=0; while(i<lt){poke8(buf+off+i,StrCharAt(t,i)&0xFF);i:=i+1;}
    poke8(buf+off+lt,0);
    var bodyLen: int64 := off + lt;
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/volumes/"c, id, "/snapshots"c);
    var resp: HTTPResponse := DOPost(cl, pathBuf as pchar, buf, bodyLen);
    var snapId: int64 := 0;
    if (resp.statusCode == 201 && resp.bodyPtr != 0) { snapId := doJsonStr(resp.bodyPtr, "id"c); }
    HTTPResponseFree(resp);
    free(buf, 256);
    free(pathBuf, 256);
    return snapId;
}

pub fn VolumeSnapshotList(creds: DOCredentials, id: pchar): int64 {
    var cl: DOClient := doClientVol(creds);
    var pathBuf: int64 := alloc(256);
    doMakePath3(pathBuf, "/v2/volumes/"c, id, "/snapshots"c);
