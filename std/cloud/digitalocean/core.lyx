// std/cloud/do/core.lyx — DigitalOcean SDK umbrella module
// Import this single module to get all DO SDK exports.
// WP-DO re-export module
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect, system.env, system.time])

unit std.cloud.digitalocean.core;

