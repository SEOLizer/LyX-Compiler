// Re-export all public symbols by forwarding calls.
// Lyx does not have re-export semantics, so callers should import
// std.cloud.digitalocean.core and then import the specific submodule they need.
// core.lyx serves as the canonical dependency list and documentation
// entry point for the DO SDK.

// Convenience constructor: build DOCredentials from environment and validate token.
// Returns credentials with tokenLen == 0 on failure.
pub fn DOInit(): DOCredentials {
    var creds: DOCredentials := DOCredentialsDefault();
    if (creds.tokenLen == 0) { return creds; }
    var valid: int64 := DOValidateToken(creds);
    if (valid == 0) {
        DOCredentialsFree(creds);
        var empty: DOCredentials;
        empty.token := 0; empty.tokenLen := 0; empty.tokenType := 0;
        empty.refreshToken := 0; empty.expiresAt := 0; empty.defaultRegion := 0;
        empty.spacesKey := 0; empty.spacesSecret := 0;
        return empty;
    }
    return creds;
}

// DOVersion returns the SDK version string (statically allocated).
pub fn DOVersion(): pchar {
    return "0.1.0"c;
}
