pub fn RegistryDockerLogin(creds: DOCredentials): int64 {
    // Returns Docker credentials JSON: {"auths":{"registry.digitalocean.com":{"auth":"<base64>"}}}
    var cl: DOClient := doClientRegistry(creds);
    var resp: HTTPResponse := DOGet(cl, "/v2/registry/docker-credentials"c);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.bodyPtr != 0) { result := resp.bodyPtr; resp.bodyPtr := 0; }
    HTTPResponseFree(resp);
    return result;
}

pub fn RegistryValidateName(creds: DOCredentials, name: pchar): int64 {
    var cl: DOClient := doClientRegistry(creds);
    var buf: int64 := alloc(128);
    var h: pchar := "{\"name\":\""c; var lh: int64 := StrLen(h);
    var i: int64 := 0;
    while(i<lh){poke8(buf+i,StrCharAt(h,i)&0xFF);i:=i+1;}
    var nl: int64 := StrLen(name);
    i:=0; while(i<nl){poke8(buf+lh+i,StrCharAt(name,i)&0xFF);i:=i+1;}
    poke8(buf+lh+nl,34); poke8(buf+lh+nl+1,125); poke8(buf+lh+nl+2,0); // '"}'
    var bodyLen: int64 := lh + nl + 2;
    var resp: HTTPResponse := DOPost(cl, "/v2/registry/validate-name"c, buf, bodyLen);
    var ok: int64 := 0;
    if (resp.statusCode == 204) { ok := 1; }
    HTTPResponseFree(resp);
    free(buf, 128);
    return ok;
}
