// ============================================================================
// JSON helpers (pub — used by service modules)
// ============================================================================

// Find first occurrence of "key":"value" and return allocated copy of value.
// Returns 0 if not found. Caller frees with free(result, StrLen(result)+1).
pub fn doJsonStr(json: int64, key: pchar): int64 {
    if (json == 0) { return 0; }
    var keyLen: int64 := StrLen(key);
    var jsonLen: int64 := StrLen(json as pchar);
    var i: int64 := 0;
    while (i < jsonLen - keyLen - 2) {
        if (peek8(json + i) == 34) {
            var isMatch: int64 := 1;
            var j: int64 := 0;
            while (j < keyLen) {
                if (peek8(json + i + 1 + j) != (StrCharAt(key, j) & 0xFF)) { isMatch := 0; break; }
                j += 1;
            }
            if (isMatch == 1 && peek8(json + i + 1 + keyLen) == 34) {
                var k: int64 := i + 2 + keyLen;
                while (k < jsonLen && peek8(json + k) == 32) { k := k + 1; }
                if (k < jsonLen && peek8(json + k) == 58) {
                    k += 1;
                    while (k < jsonLen && peek8(json + k) == 32) { k := k + 1; }
                    if (k < jsonLen && peek8(json + k) == 34) {
                        k += 1;
                        var start: int64 := k;
                        while (k < jsonLen && peek8(json + k) != 34) {
                            if (peek8(json + k) == 92) { k := k + 1; }
                            k += 1;
                        }
                        var len: int64 := k - start;
                        var result: int64 := alloc(len + 1);
                        var ci: int64 := 0;
                        while (ci < len) { poke8(result + ci, peek8(json + start + ci)); ci := ci + 1; }
                        poke8(result + len, 0);
                        return result;
                    }
                }
            }
        }
        i += 1;
    }
    return 0;
}

// Find first occurrence of "key":N and return N as int64. Returns 0 if not found.
pub fn doJsonInt(json: int64, key: pchar): int64 {
    if (json == 0) { return 0; }
    var keyLen: int64 := StrLen(key);
    var jsonLen: int64 := StrLen(json as pchar);
    var i: int64 := 0;
    while (i < jsonLen - keyLen - 2) {
        if (peek8(json + i) == 34) {
            var isMatch: int64 := 1;
            var j: int64 := 0;
            while (j < keyLen) {
                if (peek8(json + i + 1 + j) != (StrCharAt(key, j) & 0xFF)) { isMatch := 0; break; }
                j += 1;
            }
            if (isMatch == 1 && peek8(json + i + 1 + keyLen) == 34) {
                var k: int64 := i + 2 + keyLen;
                while (k < jsonLen && peek8(json + k) == 32) { k := k + 1; }
                if (k < jsonLen && peek8(json + k) == 58) {
                    k += 1;
                    while (k < jsonLen && peek8(json + k) == 32) { k := k + 1; }
                    var neg: int64 := 0;
                    if (k < jsonLen && peek8(json + k) == 45) { neg := 1; k := k + 1; }
                    if (k < jsonLen && peek8(json + k) >= 48 && peek8(json + k) <= 57) {
                        var val: int64 := 0;
                        while (k < jsonLen && peek8(json + k) >= 48 && peek8(json + k) <= 57) {
                            val := val * 10 + (peek8(json + k) - 48);
                            k += 1;
                        }
                        if (neg == 1) { val := 0 - val; }
                        return val;
                    }
                }
            }
        }
        i += 1;
    }
    return 0;
}

// Returns 1 for true, 0 for false/not found.
pub fn doJsonBool(json: int64, key: pchar): int64 {
    if (json == 0) { return 0; }
    var keyLen: int64 := StrLen(key);
    var jsonLen: int64 := StrLen(json as pchar);
    var i: int64 := 0;
    while (i < jsonLen - keyLen - 2) {
        if (peek8(json + i) == 34) {
            var isMatch: int64 := 1;
            var j: int64 := 0;
            while (j < keyLen) {
                if (peek8(json + i + 1 + j) != (StrCharAt(key, j) & 0xFF)) { isMatch := 0; break; }
                j += 1;
            }
            if (isMatch == 1 && peek8(json + i + 1 + keyLen) == 34) {
                var k: int64 := i + 2 + keyLen;
                while (k < jsonLen && peek8(json + k) == 32) { k := k + 1; }
                if (k < jsonLen && peek8(json + k) == 58) {
                    k += 1;
                    while (k < jsonLen && peek8(json + k) == 32) { k := k + 1; }
                    // 't' = 116 for "true"
                    if (k < jsonLen && peek8(json + k) == 116) { return 1; }
                    return 0;
                }
            }
        }
        i += 1;
    }
    return 0;
}

// ============================================================================
// Path helpers (pub — used by service modules)
// ============================================================================

// Concatenate two path strings into a 512-byte stack buffer (caller provides buf).
pub fn doMakePath(buf: int64, a: pchar, b: pchar): pchar {
    var la: int64 := StrLen(a);
    var lb: int64 := StrLen(b);
    var i: int64 := 0;
    while (i < la)      { poke8(buf + i,      StrCharAt(a, i)      & 0xFF); i := i + 1; }
    while (i < la + lb) { poke8(buf + i, StrCharAt(b, i - la) & 0xFF); i := i + 1; }
    poke8(buf + la + lb, 0);
    return buf as pchar;
}

pub fn doMakePath3(buf: int64, a: pchar, b: pchar, c: pchar): pchar {
    var la: int64 := StrLen(a);
    var lb: int64 := StrLen(b);
    var lc: int64 := StrLen(c);
    var i: int64 := 0;
    while (i < la)           { poke8(buf + i, StrCharAt(a, i)           & 0xFF); i := i + 1; }
    while (i < la + lb)      { poke8(buf + i, StrCharAt(b, i - la)      & 0xFF); i := i + 1; }
    while (i < la + lb + lc) { poke8(buf + i, StrCharAt(c, i - la - lb) & 0xFF); i := i + 1; }
    poke8(buf + la + lb + lc, 0);
    return buf as pchar;
}

// Build "/v2/<base>/<id>" path in caller-provided 512-byte buf.
pub fn doMakePathI(buf: int64, base: pchar, id: int64): pchar {
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(id, numBuf);
    var result: pchar := doMakePath3(buf, DO_API_BASE, base, numStr);
    free(numBuf, 24);
    return result;
}

// Build "/v2/<base>/<id>/<suffix>" in caller-provided 512-byte buf.
pub fn doMakePathIS(buf: int64, base: pchar, id: int64, suffix: pchar): pchar {
    var numBuf: int64 := alloc(24);
    var numStr: pchar := Int64ToStr(id, numBuf);
    var la: int64 := StrLen(DO_API_BASE);
    var lb: int64 := StrLen(base);
    var lc: int64 := StrLen(numStr);
    var ld: int64 := StrLen(suffix);
    var i: int64 := 0;
    while (i < la)               { poke8(buf + i, StrCharAt(DO_API_BASE, i)      & 0xFF); i := i + 1; }
    while (i < la + lb)          { poke8(buf + i, StrCharAt(base, i - la)        & 0xFF); i := i + 1; }
    while (i < la + lb + lc)     { poke8(buf + i, StrCharAt(numStr, i-la-lb)     & 0xFF); i := i + 1; }
    while (i < la + lb + lc + ld){ poke8(buf + i, StrCharAt(suffix, i-la-lb-lc)  & 0xFF); i := i + 1; }
    poke8(buf + la + lb + lc + ld, 0);
    free(numBuf, 24);
    return buf as pchar;
}

// Build path with string ID: "/v2/<base>/<strid>/<suffix>"
// Bis hierher war das ein Einzeiler, der `doMakePath3` mit drei statt vier
// Argumenten aufrief und zwei Puffer ineinander schachtelte. Er hat nie
// übersetzt. Jetzt analog zu doMakePathIS aufgebaut, nur mit String-ID.
pub fn doMakePathSS(buf: int64, base: pchar, strId: pchar, suffix: pchar): pchar {
    var la: int64 := StrLen(DO_API_BASE);
    var lb: int64 := StrLen(base);
    var lc: int64 := StrLen(strId);
    var ld: int64 := StrLen(suffix);
    var i: int64 := 0;
    while (i < la)               { poke8(buf + i, StrCharAt(DO_API_BASE, i)      & 0xFF); i := i + 1; }
    while (i < la + lb)          { poke8(buf + i, StrCharAt(base, i - la)        & 0xFF); i := i + 1; }
    while (i < la + lb + lc)     { poke8(buf + i, StrCharAt(strId, i-la-lb)      & 0xFF); i := i + 1; }
    while (i < la + lb + lc + ld){ poke8(buf + i, StrCharAt(suffix, i-la-lb-lc)  & 0xFF); i := i + 1; }
    poke8(buf + la + lb + lc + ld, 0);
    return buf as pchar;
}

// ============================================================================
// DOParseError: extract id and message from DO error JSON
// ============================================================================

pub fn DOParseError(body: int64, bodyLen: int64): DOError {
    var e: DOError;
    e.id      := 0;
    e.message := 0;
    e.errors  := 0;
    if (body == 0) { return e; }
    var idKey:  pchar := "id"c;
    var msgKey: pchar := "message"c;
    e.id      := doJsonStr(body, idKey);
    e.message := doJsonStr(body, msgKey);
    return e;
}

// ============================================================================
// DOGetAll: collect all pages of a resource into one JSON array body
// Returns allocated JSON array string, caller must free with free(result, StrLen+1)
// ============================================================================

pub fn DOGetAll(c: DOClient, path: pchar, resourceKey: pchar): int64 {
    var pathBuf: int64 := alloc(512);
    var page: int64 := 1;
    var result: int64 := alloc(8192);
    var resultLen: int64 := 0;
    var resultCap: int64 := 8192;
    poke8(result, 91); // '['
    resultLen := 1;
    var first: int64 := 1;
    var done: int64 := 0;

    while (done == 0) {
        // Build paged path: path + "?page=N&per_page=200"
        var la: int64 := StrLen(path);
        var i: int64 := 0;
        while (i < la) { poke8(pathBuf + i, StrCharAt(path, i) & 0xFF); i := i + 1; }
        // Append "?page=" + page + "&per_page=200"
        var pageSuffix: pchar := "?per_page=200&page="c;
        var lp: int64 := StrLen(pageSuffix);
        var j: int64 := 0;
        while (j < lp) { poke8(pathBuf + i + j, StrCharAt(pageSuffix, j) & 0xFF); j := j + 1; }
        i += lp;
        var numBuf: int64 := alloc(24);
        var numStr: pchar := Int64ToStr(page, numBuf);
        var ln: int64 := StrLen(numStr);
        var k: int64 := 0;
        while (k < ln) { poke8(pathBuf + i + k, StrCharAt(numStr, k) & 0xFF); k := k + 1; }
        poke8(pathBuf + i + k, 0);
        free(numBuf, 24);

        var resp: HTTPResponse := DOGet(c, pathBuf as pchar);
        if (resp.statusCode != 200 || resp.bodyPtr == 0) {
            HTTPResponseFree(resp);
            done := 1;
        } else {
            // Find the resource array in the JSON body
            var arrKey: int64 := alloc(StrLen(resourceKey) + 5);
            var ki: int64 := 0;
            poke8(arrKey + ki, 34); ki := ki + 1; // '"'
            while (ki <= StrLen(resourceKey)) {
                poke8(arrKey + ki, StrCharAt(resourceKey, ki - 1) & 0xFF); ki := ki + 1;
            }
            poke8(arrKey + ki, 34); ki := ki + 1; // '"'
            poke8(arrKey + ki, 58); ki := ki + 1; // ':'
            poke8(arrKey + ki, 91); ki := ki + 1; // '['
            poke8(arrKey + ki, 0);

            // Find resourceKey":[ in body
            var bodyPtr: int64 := resp.bodyPtr;
            var bodyLen2: int64 := resp.bodySize;
            var arrStart: int64 := 0;
            var si: int64 := 0;
            var arrKeyLen: int64 := ki; // length of pattern including '['
            while (si < bodyLen2 - arrKeyLen) {
                var mok: int64 := 1;
                var mi: int64 := 0;
                while (mi < arrKeyLen) {
                    if (peek8(bodyPtr + si + mi) != peek8(arrKey + mi)) { mok := 0; break; }
                    mi += 1;
                }
                if (mok == 1) { arrStart := si + arrKeyLen - 1; break; }
                si += 1;
            }
            free(arrKey, StrLen(resourceKey) + 5);

            if (arrStart > 0) {
                // Find matching ] for the array
                var depth: int64 := 1;
                var inStr: int64 := 0;
                var ai: int64 := arrStart + 1;
                while (ai < bodyLen2 && depth > 0) {
                    var ch: int64 := peek8(bodyPtr + ai);
                    if (inStr == 1) {
                        if (ch == 92) { ai := ai + 1; }
                        else if (ch == 34) { inStr := 0; }
                    } else {
                        if (ch == 34) { inStr := 1; }
                        else if (ch == 91) { depth := depth + 1; }
                        else if (ch == 93) { depth := depth - 1; }
                    }
                    ai += 1;
                }
                // arrStart..ai-1 is the full array including [ and ]
                var arrLen: int64 := ai - arrStart;
                // Append inner items (skip outer [ and ])
                if (arrLen > 2) {
                    // Items between [ and ]
                    var innerStart: int64 := arrStart + 1;
                    var innerLen:   int64 := arrLen - 2;
                    // Grow result if needed
                    if (resultLen + innerLen + 2 > resultCap) {
                        var newCap: int64 := resultCap * 2;
                        if (newCap < resultLen + innerLen + 2) { newCap := resultLen + innerLen + 8192; }
                        var newResult: int64 := alloc(newCap);
                        var ri: int64 := 0;
                        while (ri < resultLen) { poke8(newResult + ri, peek8(result + ri)); ri := ri + 1; }
                        free(result, resultCap);
                        result := newResult; resultCap := newCap;
                    }
                    if (first == 0) {
                        poke8(result + resultLen, 44); // ','
                        resultLen += 1;
                    }
                    var ii: int64 := 0;
                    while (ii < innerLen) {
                        poke8(result + resultLen + ii, peek8(bodyPtr + innerStart + ii));
                        ii += 1;
                    }
                    resultLen += innerLen;
                    first := 0;
                }
            }

            // Check for "next" page link
            var nextKey: pchar := "next"c;
            var nextVal: int64 := doJsonStr(resp.bodyPtr, nextKey);
            if (nextVal == 0) {
                done := 1;
            } else {
                free(nextVal, StrLen(nextVal as pchar) + 1);
                page += 1;
            }
            HTTPResponseFree(resp);
        }
    }

    poke8(result + resultLen, 93); resultLen := resultLen + 1; // ']'
    poke8(result + resultLen, 0);
    free(pathBuf, 512);
    return result;
}

// ============================================================================
// Pagination iterator
// ============================================================================

pub fn DOPageNew(c: DOClient, path: pchar, perPage: int64): DOPage {
    var p: DOPage;
    p.client  := c;
    var plen: int64 := StrLen(path);
    p.path    := alloc(plen + 1);
    var i: int64 := 0;
    while (i < plen) { poke8(p.path + i, StrCharAt(path, i) & 0xFF); i := i + 1; }
    poke8(p.path + plen, 0);
    p.perPage := perPage;
    p.page    := 0;
    p.total   := 0;
    p.hasNext := 1;
    return p;
}

pub fn DOPageHasNext(p: DOPage): int64 {
    return p.hasNext;
}

pub fn DOPageTotal(p: DOPage): int64 {
    return p.total;
}

pub fn DOPageNext(ref p: DOPage): HTTPResponse {
    p.page    := p.page + 1;
    var pathBuf: int64 := alloc(512);
    var plen: int64 := StrLen(p.path as pchar);
    var i: int64 := 0;
    while (i < plen) { poke8(pathBuf + i, peek8(p.path + i)); i := i + 1; }
    var suffix: pchar := "?per_page=N&page=N"c;
    // Write ?per_page=<perPage>&page=<page>
    var numBuf: int64 := alloc(48);
    var nbA: pchar := Int64ToStr(p.perPage, numBuf);
    var nbAlen: int64 := StrLen(nbA);
    var nbB: pchar := Int64ToStr(p.page, numBuf + 24);
    var nbBlen: int64 := StrLen(nbB);
    var q: pchar := "?per_page="c;
    var amp: pchar := "&page="c;
    var lq: int64 := StrLen(q);
    var la: int64 := StrLen(amp);
    var j: int64 := 0;
    while (j < lq)   { poke8(pathBuf + plen + j, StrCharAt(q,   j)       & 0xFF); j := j + 1; }
    while (j < lq + nbAlen) { poke8(pathBuf + plen + j, StrCharAt(nbA, j - lq) & 0xFF); j := j + 1; }
    while (j < lq + nbAlen + la) { poke8(pathBuf + plen + j, StrCharAt(amp, j - lq - nbAlen) & 0xFF); j := j + 1; }
    var off: int64 := lq + nbAlen + la;
    var k: int64 := 0;
    while (k < nbBlen) { poke8(pathBuf + plen + off + k, StrCharAt(nbB, k) & 0xFF); k := k + 1; }
    poke8(pathBuf + plen + off + nbBlen, 0);
    free(numBuf, 48);

    var resp: HTTPResponse := DOGet(p.client, pathBuf as pchar);
    free(pathBuf, 512);

    if (resp.bodyPtr != 0) {
        var totalKey: pchar := "total"c;
        var nextKey:  pchar := "next"c;
        p.total := doJsonInt(resp.bodyPtr, totalKey);
        var nextVal: int64 := doJsonStr(resp.bodyPtr, nextKey);
        if (nextVal == 0) {
            p.hasNext := 0;
        } else {
            free(nextVal, StrLen(nextVal as pchar) + 1);
        }
    } else {
        p.hasNext := 0;
    }
    return resp;
}

pub fn DOPageFree(p: DOPage) {
    if (p.path != 0) {
        free(p.path, StrLen(p.path as pchar) + 1);
    }
}
