// std/cloud/do/transport.lyx — DigitalOcean REST/JSON Transport Layer
// WP-DO-01: HTTPS client with Bearer auth, pagination, retry/backoff
//
// Public API:
//   DOClientNew(token)               -> DOClient
//   DOGet/DOPost/DOPut/DOPatch/DODelete
//   DOGetAll(c, path, resourceKey)   -> int64 (allocated JSON array, caller frees)
//   DOPageNew/DOPageNext/DOPageHasNext/DOPageTotal
//   DOParseError/DOErrorFree
//   doJsonStr/doJsonInt/doJsonBool   (pub helpers for service modules)
//   doMakePath/doMakePath3/doMakePathI (pub helpers)

unit std.cloud.digitalocean.transport;

import std.net.http;
import std.net.socket;
import std.net.dns;
import std.net.tls;
import std.net.types;
import std.alloc;
import std.io;
import std.time;

// ============================================================================
// Constants
// ============================================================================

pub con DO_API_HOST:   pchar := "api.digitalocean.com"c;
pub con DO_API_BASE:   pchar := "/v2"c;
pub con DO_RETRY_MAX:  int64 := 3;
pub con DO_TIMEOUT_MS: int64 := 30000;

// ============================================================================
// DOClient struct
// ============================================================================

pub type DOClient = struct {
    token:    int64;   // pchar: Bearer token (caller-owned)
    tokenLen: int64;
};

pub fn DOClientNew(token: pchar): DOClient {
    var c: DOClient;
    c.token    := token as int64;
    c.tokenLen := StrLen(token);
    return c;
}

// ============================================================================
// DOError struct
// ============================================================================

pub type DOError = struct {
    id:      int64;   // pchar: "not_found", "unauthorized", ...
    message: int64;   // pchar
    errors:  int64;   // pchar: raw errors JSON array (422)
};

pub fn DOErrorFree(e: DOError) {
    if (e.id      != 0) { free(e.id,      StrLen(e.id      as pchar) + 1); }
    if (e.message != 0) { free(e.message, StrLen(e.message as pchar) + 1); }
    if (e.errors  != 0) { free(e.errors,  StrLen(e.errors  as pchar) + 1); }
}

// ============================================================================
// DOPage struct (pagination iterator)
// ============================================================================

pub type DOPage = struct {
    client:  DOClient;
    path:    int64;   // pchar: base path (alloc'd, owned)
    perPage: int64;
    page:    int64;
    total:   int64;
    hasNext: int64;   // 0 or 1
};

// ============================================================================
// Internal: build Authorization + Content-Type headers
// ============================================================================

fn doBuildHeaders(token: pchar): int64 {
  var tokenAdr: int64 := token as int64;   // #1613
    var hdrs: int64 := 0;
    hdrs := HTTPSetBearerToken(hdrs, token);
    var ctKey: pchar := "Content-Type"c;
    var ctVal: pchar := "application/json"c;
    hdrs := HTTPSetHeader(hdrs, ctKey as int64, ctVal as int64);
    var uaKey: pchar := "User-Agent"c;
    var uaVal: pchar := "lyxdo/1.0"c;
    hdrs := HTTPSetHeader(hdrs, uaKey as int64, uaVal as int64);
    return hdrs;
}

// ============================================================================
// Internal: low-level HTTPS send over TLS
// ============================================================================

fn doSendTLS(method: int64, host: int64, path: int64,
             hdrs: int64, body: int64, bodyLen: int64): HTTPResponse {
    var response: HTTPResponse;
    response.statusCode    := 0;
    response.statusText    := 0;
    response.headerCount   := 0;
    response.contentLength := 0;
    response.bodyPtr       := 0;
    response.bodySize      := 0;
    response.headersRaw    := 0;
    response.headersSize   := 0;

    var ctx: TLSContext := TLSInit();
    if (ctx.initialized == 0) { return response; }

    var ip: int64 := GetHostByName(host as pchar);
    if (ip == 0) { TLSFree(ctx); return response; }

    var tcpConn: TCPConn := TCPConnect(ip, HTTPS_PORT);
    if (tcpConn.fd < 0) { TLSFree(ctx); return response; }

    var conn: TLSConn := TLSConnect(ctx, tcpConn.fd, host as pchar);
    if (conn.connected == 0) { sys_close(tcpConn.fd); TLSFree(ctx); return response; }

    var req: HTTPRequest;
    req.method   := method;
    req.host     := host;
    req.path     := path;
    req.port     := HTTPS_PORT;
    req.headers  := hdrs;
    req.body     := body;
    req.bodySize := bodyLen;

    var reqBuf: int64 := HTTPRequestBuild(req);
    if (reqBuf == 0) { TLSClose(conn); sys_close(tcpConn.fd); TLSFree(ctx); return response; }

    var allocSz: int64 := peek64(reqBuf);
    var reqSz:   int64 := peek64(reqBuf + 8);
    var n: int64 := TLSWrite(conn, reqBuf + 16, reqSz);
    munmap(reqBuf, allocSz);

    if (n <= 0) { TLSClose(conn); sys_close(tcpConn.fd); TLSFree(ctx); return response; }

    // Read response with growable buffer
    var cap: int64 := 65536;
    var buf: int64 := mmap(0, cap, PROT_RW, MAP_ANON, FD_NONE, 0);
    if (buf == 0) { TLSClose(conn); sys_close(tcpConn.fd); TLSFree(ctx); return response; }

    var total: int64 := 0;
    var done:  int64 := 0;
    while (done == 0) {
        if (total + 16384 > cap) {
            var newCap: int64 := cap * 2;
            var newBuf: int64 := mmap(0, newCap, PROT_RW, MAP_ANON, FD_NONE, 0);
            if (newBuf == 0) { done := 1; }
            else {
                var ci: int64 := 0;
                while (ci < total) { poke8(newBuf + ci, peek8(buf + ci)); ci := ci + 1; }
                munmap(buf, cap);
                buf := newBuf; cap := newCap;
            }
        }
        if (done == 0) {
            n := TLSRead(conn, buf + total, 16384);
            if (n <= 0) { done := 1; } else { total := total + n; }
        }
    }
    TLSClose(conn); sys_close(tcpConn.fd); TLSFree(ctx);

    // Parse HTTP status code from "HTTP/1.1 NNN "
    var i: int64 := 0;
    while (i < total - 13) {
        if (peek8(buf+i)==72 && peek8(buf+i+1)==84 && peek8(buf+i+2)==84 &&
            peek8(buf+i+3)==80 && peek8(buf+i+4)==47) {
            i += 9;
            response.statusCode := (peek8(buf+i)-48)*100 + (peek8(buf+i+1)-48)*10 + (peek8(buf+i+2)-48);
            break;
        }
        i += 1;
    }

    // Find body start (\r\n\r\n)
    var bodyStart: int64 := 0;
    i := 0;
    while (i < total - 4) {
        if (peek8(buf+i)==13 && peek8(buf+i+1)==10 &&
            peek8(buf+i+2)==13 && peek8(buf+i+3)==10) {
            bodyStart := i + 4;
            break;
        }
        i += 1;
    }

    if (bodyStart > 0 && total > bodyStart) {
        var bodyLen2: int64 := total - bodyStart;
        response.bodyPtr := mmap(0, bodyLen2 + 1, PROT_RW, MAP_ANON, FD_NONE, 0);
        if (response.bodyPtr != 0) {
            var j: int64 := 0;
            while (j < bodyLen2) { poke8(response.bodyPtr + j, peek8(buf + bodyStart + j)); j := j + 1; }
            poke8(response.bodyPtr + bodyLen2, 0);
            response.bodySize := bodyLen2;
        }
    }

    munmap(buf, cap);
    return response;
}

// ============================================================================
// Internal: retry helpers
// ============================================================================

fn doShouldRetry(statusCode: int64): int64 {
    if (statusCode == 429) { return 1; }
    if (statusCode == 500) { return 1; }
    if (statusCode == 502) { return 1; }
    if (statusCode == 503) { return 1; }
    if (statusCode == 504) { return 1; }
    return 0;
}

fn doRetryDelay(attempt: int64): void {
    var ms: int64 := 200;
    var i: int64 := 0;
    while (i < attempt) { ms := ms * 2; i := i + 1; }
    if (ms > 16000) { ms := 16000; }
    Sleep(ms);
}

// ============================================================================
// Public HTTP methods
// ============================================================================

pub fn DOGet(c: DOClient, path: pchar): HTTPResponse {
    var hdrs: int64 := doBuildHeaders(c.token);
    var host: pchar := DO_API_HOST;
    var attempt: int64 := 0;
    var resp: HTTPResponse;
    resp.statusCode := 0; resp.bodyPtr := 0; resp.bodySize := 0;
    resp.headersRaw := 0; resp.headersSize := 0;
    resp.statusText := 0; resp.headerCount := 0; resp.contentLength := 0;
    while (attempt < DO_RETRY_MAX) {
        resp := doSendTLS(HTTP_GET, host as int64, path as int64, hdrs, 0, 0);
        if (doShouldRetry(resp.statusCode) == 0) { break; }
        HTTPResponseFree(resp);
        doRetryDelay(attempt);
        attempt += 1;
    }
    HTTPHeadersFree(hdrs);
    return resp;
}

