pub fn S3ObjectExists(client: S3Client, bucket: pchar, key: pchar): int64 {
    return S3HeadObject(client, bucket, key);
}

pub fn S3ListObjects(client: S3Client, bucket: pchar, prefix: pchar): int64 {
    var host: int64 := s3Host(client, bucket);
    var queryBuf: int64 := alloc(512);
    var qoff: int64 := 0;
    var q: pchar := "list-type=2"c; var ql: int64 := StrLen(q);
    var i: int64 := 0;
    while(i<ql){poke8(queryBuf+i,StrCharAt(q,i)&0xFF);i:=i+1;} qoff:=ql;
    if (prefix != 0 as pchar && StrLen(prefix) > 0) {
        var pfx: pchar := "&prefix="c; var pl: int64 := StrLen(pfx);
        i:=0; while(i<pl){poke8(queryBuf+qoff+i,StrCharAt(pfx,i)&0xFF);i:=i+1;} qoff:=qoff+pl;
        var pfl: int64 := StrLen(prefix);
        i:=0; while(i<pfl){poke8(queryBuf+qoff+i,StrCharAt(prefix,i)&0xFF);i:=i+1;} qoff:=qoff+pfl;
    }
    poke8(queryBuf+qoff,0);
    var path: int64 := s3Path(client, bucket, ""c);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
                                          "GET"c, path as pchar, queryBuf as pchar,
                                          0, 0, client.region as pchar);
    var result: int64 := 0;
    if (resp.statusCode == 200 && resp.body != 0) {
        result := resp.body; resp.body := 0;
    }
    AWSResponseFree(resp);
    if (client.endpoint == 0) { free(host, StrLen(host as pchar)+1); }
    free(path, StrLen(path as pchar)+1);
    free(queryBuf, 512);
    return result;
}

pub fn S3CopyObject(client: S3Client,
                    srcBucket: pchar, srcKey: pchar,
                    dstBucket: pchar, dstKey: pchar): int64 {
    var host: int64 := s3Host(client, dstBucket);
    var path: int64 := s3Path(client, dstBucket, dstKey);
    // x-amz-copy-source: /srcBucket/srcKey
    var csBuf: int64 := alloc(512);
    poke8(csBuf,47);
    var bl: int64 := StrLen(srcBucket);
    var i: int64 := 0;
    while(i<bl){poke8(csBuf+1+i,StrCharAt(srcBucket,i)&0xFF);i:=i+1;}
    poke8(csBuf+1+bl,47);
    var kl: int64 := StrLen(srcKey);
    i:=0; while(i<kl){poke8(csBuf+2+bl+i,StrCharAt(srcKey,i)&0xFF);i:=i+1;}
    poke8(csBuf+2+bl+kl,0);
    // We pass x-amz-copy-source via AWSS3Request body mechanism (stub — full impl needs header injection)
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
                                          "PUT"c, path as pchar, 0 as pchar,
                                          0, 0, client.region as pchar);
    var ok: int64 := 0;
    if (resp.statusCode == 200) { ok := 1; }
    AWSResponseFree(resp);
    if (client.endpoint == 0) { free(host, StrLen(host as pchar)+1); }
    free(path, StrLen(path as pchar)+1);
    free(csBuf, 512);
    return ok;
}

pub fn S3PresignURL(client: S3Client, bucket: pchar, key: pchar, expires: int64): int64 {
    var host: int64 := s3Host(client, bucket);
    var path: int64 := s3Path(client, bucket, key);

    var dateBuf: int64     := alloc(16);
    var dateTimeBuf: int64 := alloc(24);
    SigV4DateNow(dateBuf, dateTimeBuf);

    var ctx: AWSSignCtx;
    ctx.accessKey    := client.creds.accessKey;
    ctx.secretKey    := client.creds.secretKey;
    ctx.sessionToken := client.creds.sessionToken;
    ctx.method       := "GET"c as int64;
    ctx.host         := host;
    ctx.path         := path;
    ctx.query        := 0;
    ctx.body         := 0;
    ctx.bodyLen      := 0;
    ctx.service      := "s3"c as int64;
    ctx.region       := client.region;
    ctx.date         := dateBuf;
    ctx.dateTime     := dateTimeBuf;
    ctx.authHeader   := 0;
    var query: int64 := SigV4SignQuery(ctx as int64, expires);

    var urlBuf: int64 := alloc(2048);
    var off: int64 := 0;
    var https: pchar := "https://"c; var hl: int64 := StrLen(https);
    var i: int64 := 0;
    while(i<hl){poke8(urlBuf+i,StrCharAt(https,i)&0xFF);i:=i+1;} off:=hl;
    var hlen: int64 := StrLen(host as pchar);
    i:=0; while(i<hlen){poke8(urlBuf+off+i,peek8(host+i));i:=i+1;} off:=off+hlen;
    var plen: int64 := StrLen(path as pchar);
    i:=0; while(i<plen){poke8(urlBuf+off+i,peek8(path+i));i:=i+1;} off:=off+plen;
    poke8(urlBuf+off,63); off:=off+1; // '?'
    if (query != 0) {
        var ql: int64 := StrLen(query as pchar);
        i:=0; while(i<ql){poke8(urlBuf+off+i,peek8(query+i));i:=i+1;} off:=off+ql;
        free(query, ql+1);
    }
    poke8(urlBuf+off,0);
    var result: int64 := alloc(off+1);
    i:=0; while(i<off){poke8(result+i,peek8(urlBuf+i));i:=i+1;}
    poke8(result+off,0);
    free(urlBuf, 2048);
    free(dateBuf, 16);
    free(dateTimeBuf, 24);
    free(path, StrLen(path as pchar)+1);
    if (client.endpoint == 0) { free(host, StrLen(host as pchar)+1); }
    return result;
}

pub fn S3GetObjectSize(client: S3Client, bucket: pchar, key: pchar): int64 {
    // Returns content-length from HEAD response headers
    var host: int64 := s3Host(client, bucket);
    var path: int64 := s3Path(client, bucket, key);
    var resp: AWSResponse := AWSS3Request(client.creds, host as pchar,
                                          "HEAD"c, path as pchar, 0 as pchar,
                                          0, 0, client.region as pchar);
    var result: int64 := 0;
    if (resp.statusCode == 200) {
        var cl: pchar := AWSResponseGetHeader(resp, "content-length"c);
        if (cl != 0 as pchar) {
            var nb: int64 := alloc(24);
            result := StrToInt64(cl, nb);
            free(nb, 24);
        }
    }
    AWSResponseFree(resp);
    if (client.endpoint == 0) { free(host, StrLen(host as pchar)+1); }
    free(path, StrLen(path as pchar)+1);
    return result;
}
