// std/hl7/scheduling.lyx — HL7 v2 Scheduling: SIU^S12..S26 (WP-HL7-04)
//
// Public API:
//   Hl7SchParse(seg, segLen, sch)         — SCH segment → struct
//   Hl7AisParse(seg, segLen, ais)         — AIS segment → struct
//   Hl7AigParse(seg, segLen, aig)         — AIG segment → struct
//   Hl7AilParse(seg, segLen, ail)         — AIL segment → struct
//   Hl7SiuParse(msg, len, appt)           — SIU^Sxx → appt struct
//   Hl7SiuWrite(appt, out, outMax)        → int64 (bytes written)

unit std.hl7.scheduling;

import std.hl7.core;
import std.alloc;

// ── Hl7Sch struct offsets ─────────────────────────────────────────────────────
pub con HL7_SCH_PLACER:        int64 := 0;    // SCH-1  placer appointment ID
pub con HL7_SCH_PLACER_LEN:    int64 := 8;
pub con HL7_SCH_FILLER:        int64 := 16;   // SCH-2  filler appointment ID
pub con HL7_SCH_FILLER_LEN:    int64 := 24;
pub con HL7_SCH_REASON:        int64 := 32;   // SCH-6  event reason
pub con HL7_SCH_REASON_LEN:    int64 := 40;
pub con HL7_SCH_TYPE:          int64 := 48;   // SCH-7  appointment type
pub con HL7_SCH_TYPE_LEN:      int64 := 56;
pub con HL7_SCH_DURATION:      int64 := 64;   // SCH-9  appointment duration
pub con HL7_SCH_DURATION_LEN:  int64 := 72;
pub con HL7_SCH_DUR_UNITS:     int64 := 80;   // SCH-10 duration units
pub con HL7_SCH_DUR_UNITS_LEN: int64 := 88;
pub con HL7_SCH_START_DT:      int64 := 96;   // SCH-11 start date/time
pub con HL7_SCH_START_DT_LEN:  int64 := 104;
pub con HL7_SCH_STATUS:        int64 := 112;  // SCH-25 filler status code
pub con HL7_SCH_STATUS_LEN:    int64 := 120;
pub con HL7_SCH_SIZE:          int64 := 128;

// ── Hl7Ais struct offsets ─────────────────────────────────────────────────────
pub con HL7_AIS_SETID:         int64 := 0;    // AIS-1 set ID
pub con HL7_AIS_SETID_LEN:     int64 := 8;
pub con HL7_AIS_SERVICE:       int64 := 16;   // AIS-3 universal service ID (CWE)
pub con HL7_AIS_SERVICE_LEN:   int64 := 24;
pub con HL7_AIS_START_DT:      int64 := 32;   // AIS-4 start date/time
pub con HL7_AIS_START_DT_LEN:  int64 := 40;
pub con HL7_AIS_SIZE:          int64 := 48;

// ── Hl7Aig struct offsets ─────────────────────────────────────────────────────
pub con HL7_AIG_SETID:         int64 := 0;    // AIG-1 set ID
pub con HL7_AIG_SETID_LEN:     int64 := 8;
pub con HL7_AIG_RESOURCE:      int64 := 16;   // AIG-3 resource ID (CWE)
pub con HL7_AIG_RESOURCE_LEN:  int64 := 24;
pub con HL7_AIG_RESTYPE:       int64 := 32;   // AIG-4 resource type (CWE)
pub con HL7_AIG_RESTYPE_LEN:   int64 := 40;
pub con HL7_AIG_SIZE:          int64 := 48;

// ── Hl7Ail struct offsets ─────────────────────────────────────────────────────
pub con HL7_AIL_SETID:         int64 := 0;    // AIL-1 set ID
pub con HL7_AIL_SETID_LEN:     int64 := 8;
pub con HL7_AIL_LOCATION:      int64 := 16;   // AIL-3 location resource ID (PL)
pub con HL7_AIL_LOCATION_LEN:  int64 := 24;
pub con HL7_AIL_SIZE:          int64 := 32;

// ── Hl7Appointment struct offsets ─────────────────────────────────────────────
pub con HL7_APPT_PLACER:       int64 := 0;    // SCH-1  placer appointment ID
pub con HL7_APPT_PLACER_LEN:   int64 := 8;
pub con HL7_APPT_FILLER:       int64 := 16;   // SCH-2  filler appointment ID
pub con HL7_APPT_FILLER_LEN:   int64 := 24;
pub con HL7_APPT_START_DT:     int64 := 32;   // SCH-11 start date/time
pub con HL7_APPT_START_DT_LEN: int64 := 40;
pub con HL7_APPT_DURATION:     int64 := 48;   // SCH-9  appointment duration
pub con HL7_APPT_DURATION_LEN: int64 := 56;
pub con HL7_APPT_SERVICE:      int64 := 64;   // AIS-3  service type
pub con HL7_APPT_SERVICE_LEN:  int64 := 72;
pub con HL7_APPT_PAT_ID:       int64 := 80;   // PID-3.1 patient ID
pub con HL7_APPT_PAT_ID_LEN:   int64 := 88;
pub con HL7_APPT_STATUS:       int64 := 96;   // SCH-25 filler status
pub con HL7_APPT_STATUS_LEN:   int64 := 104;
pub con HL7_APPT_EVENT:        int64 := 112;  // MSH-9.2 trigger event (S12/S13/…)
pub con HL7_APPT_EVENT_LEN:    int64 := 120;
pub con HL7_APPT_ISCANCEL:     int64 := 128;  // 1 if event = S15 (cancel)
pub con HL7_APPT_ISDELETE:     int64 := 136;  // 1 if event = S17 (delete)
pub con HL7_APPT_ISNOSHOW:     int64 := 144;  // 1 if event = S26 (no-show)
pub con HL7_APPT_SIZE:         int64 := 152;

// ── Private helpers ───────────────────────────────────────────────────────────

fn siuCopy(dst: int64, src: int64, count: int64) {
    var i: int64 := 0;
    while (i < count) { poke8(dst + i, peek8(src + i)); i := i + 1; }
}

fn siuFieldGet(seg: int64, segLen: int64, sep: int64, fieldNum: int64, outPtr: int64, outLen: int64) {
    var pos:  int64 := 0;
    var fnum: int64 := 0;
    while (pos < segLen && peek8(seg + pos) != sep) { pos := pos + 1; }
    while (pos < segLen && fnum < fieldNum) {
        pos := pos + 1;
        fnum := fnum + 1;
        if (fnum == fieldNum) {
            var start: int64 := pos;
            while (pos < segLen && peek8(seg+pos) != sep && peek8(seg+pos) != 13 && peek8(seg+pos) != 10) {
                pos := pos + 1;
            }
            poke64(outPtr, seg + start);
            poke64(outLen, pos - start);
            return;
        }
        while (pos < segLen && peek8(seg + pos) != sep && peek8(seg + pos) != 13) {
            pos := pos + 1;
        }
    }
    poke64(outPtr, 0);
    poke64(outLen, 0);
}

fn siuCompGet(fldPtr: int64, fldLen: int64, csep: int64, compNum: int64, outPtr: int64, outLen: int64) {
    var pos:   int64 := 0;
    var cnum:  int64 := 1;
    var start: int64 := 0;
    while (cnum < compNum && pos < fldLen) {
        if (peek8(fldPtr + pos) == csep) { cnum := cnum + 1; start := pos + 1; }
        pos := pos + 1;
    }
    var end: int64 := start;
    while (end < fldLen && peek8(fldPtr + end) != csep) { end := end + 1; }
    poke64(outPtr, fldPtr + start);
    poke64(outLen, end - start);
}

fn siuFindSeg(msg: int64, len: int64, n1: int64, n2: int64, n3: int64, fsep: int64): int64 {
    if (len >= 4 && peek8(msg)==n1 && peek8(msg+1)==n2 && peek8(msg+2)==n3 && peek8(msg+3)==fsep) {
        return msg;
    }
    var i: int64 := 0;
    while (i < len - 4) {
        if (peek8(msg + i) == 13) {
            if (peek8(msg+i+1)==n1 && peek8(msg+i+2)==n2 && peek8(msg+i+3)==n3 && peek8(msg+i+4)==fsep) {
                return msg + i + 1;
            }
        }
        i := i + 1;
    }
    return 0;
}

fn siuSegLen(msgStart: int64, msgLen: int64, segStart: int64): int64 {
    var offset: int64 := segStart - msgStart;
    var pos:    int64 := offset;
    while (pos < msgLen && peek8(msgStart + pos) != 13 && peek8(msgStart + pos) != 10) {
        pos := pos + 1;
    }
    return pos - offset;
}

fn siuWriteField(out: int64, pos: int64, ptr: int64, len: int64): int64 {
    siuCopy(out + pos, ptr, len);
    return pos + len;
}

// ── Public API ────────────────────────────────────────────────────────────────

pub fn Hl7SchParse(seg: int64, segLen: int64, sch: int64) {
    var fsep: int64 := 124;
    var fptr: int64 := alloc(16);
    var flen: int64 := alloc(16);
    siuFieldGet(seg, segLen, fsep, 1, fptr, flen);
    poke64(sch + HL7_SCH_PLACER, peek64(fptr));
    poke64(sch + HL7_SCH_PLACER_LEN, peek64(flen));
    siuFieldGet(seg, segLen, fsep, 2, fptr, flen);
    poke64(sch + HL7_SCH_FILLER, peek64(fptr));
    poke64(sch + HL7_SCH_FILLER_LEN, peek64(flen));
    siuFieldGet(seg, segLen, fsep, 6, fptr, flen);
    poke64(sch + HL7_SCH_REASON, peek64(fptr));
    poke64(sch + HL7_SCH_REASON_LEN, peek64(flen));
    siuFieldGet(seg, segLen, fsep, 7, fptr, flen);
    poke64(sch + HL7_SCH_TYPE, peek64(fptr));
    poke64(sch + HL7_SCH_TYPE_LEN, peek64(flen));
    siuFieldGet(seg, segLen, fsep, 9, fptr, flen);
    poke64(sch + HL7_SCH_DURATION, peek64(fptr));
    poke64(sch + HL7_SCH_DURATION_LEN, peek64(flen));
    siuFieldGet(seg, segLen, fsep, 10, fptr, flen);
    poke64(sch + HL7_SCH_DUR_UNITS, peek64(fptr));
    poke64(sch + HL7_SCH_DUR_UNITS_LEN, peek64(flen));
    siuFieldGet(seg, segLen, fsep, 11, fptr, flen);
    poke64(sch + HL7_SCH_START_DT, peek64(fptr));
    poke64(sch + HL7_SCH_START_DT_LEN, peek64(flen));
    siuFieldGet(seg, segLen, fsep, 25, fptr, flen);
    poke64(sch + HL7_SCH_STATUS, peek64(fptr));
    poke64(sch + HL7_SCH_STATUS_LEN, peek64(flen));
}

pub fn Hl7AisParse(seg: int64, segLen: int64, ais: int64) {
    var fsep: int64 := 124;
    var fptr: int64 := alloc(16);
    var flen: int64 := alloc(16);
    siuFieldGet(seg, segLen, fsep, 1, fptr, flen);
    poke64(ais + HL7_AIS_SETID, peek64(fptr));
    poke64(ais + HL7_AIS_SETID_LEN, peek64(flen));
    siuFieldGet(seg, segLen, fsep, 3, fptr, flen);
    poke64(ais + HL7_AIS_SERVICE, peek64(fptr));
    poke64(ais + HL7_AIS_SERVICE_LEN, peek64(flen));
    siuFieldGet(seg, segLen, fsep, 4, fptr, flen);
    poke64(ais + HL7_AIS_START_DT, peek64(fptr));
    poke64(ais + HL7_AIS_START_DT_LEN, peek64(flen));
}

pub fn Hl7AigParse(seg: int64, segLen: int64, aig: int64) {
    var fsep: int64 := 124;
    var fptr: int64 := alloc(16);
    var flen: int64 := alloc(16);
    siuFieldGet(seg, segLen, fsep, 1, fptr, flen);
    poke64(aig + HL7_AIG_SETID, peek64(fptr));
    poke64(aig + HL7_AIG_SETID_LEN, peek64(flen));
    siuFieldGet(seg, segLen, fsep, 3, fptr, flen);
    poke64(aig + HL7_AIG_RESOURCE, peek64(fptr));
    poke64(aig + HL7_AIG_RESOURCE_LEN, peek64(flen));
    siuFieldGet(seg, segLen, fsep, 4, fptr, flen);
    poke64(aig + HL7_AIG_RESTYPE, peek64(fptr));
    poke64(aig + HL7_AIG_RESTYPE_LEN, peek64(flen));
}

pub fn Hl7AilParse(seg: int64, segLen: int64, ail: int64) {
    var fsep: int64 := 124;
    var fptr: int64 := alloc(16);
    var flen: int64 := alloc(16);
    siuFieldGet(seg, segLen, fsep, 1, fptr, flen);
    poke64(ail + HL7_AIL_SETID, peek64(fptr));
    poke64(ail + HL7_AIL_SETID_LEN, peek64(flen));
    siuFieldGet(seg, segLen, fsep, 3, fptr, flen);
    poke64(ail + HL7_AIL_LOCATION, peek64(fptr));
    poke64(ail + HL7_AIL_LOCATION_LEN, peek64(flen));
}

// Parse full SIU^Sxx message into appt struct.
// Reads MSH trigger event, SCH, PID (for patient ID) and AIS (for service type).
pub fn Hl7SiuParse(msg: int64, len: int64, appt: int64) {
    poke64(appt + HL7_APPT_ISCANCEL, 0);
    poke64(appt + HL7_APPT_ISDELETE, 0);
    poke64(appt + HL7_APPT_ISNOSHOW, 0);
    var mshBuf: int64 := alloc(HL7_MSH_SIZE);
    Hl7MshParse(msg, len, mshBuf);
    var evtPtr: int64 := peek64(mshBuf + HL7_MSH_TRIGGER);
    var evtLen: int64 := peek64(mshBuf + HL7_MSH_TRIGGER_LEN);
    poke64(appt + HL7_APPT_EVENT, evtPtr);
    poke64(appt + HL7_APPT_EVENT_LEN, evtLen);
    if (evtLen >= 3) {
        var e1: int64 := peek8(evtPtr)     as int64;
        var e2: int64 := peek8(evtPtr + 1) as int64;
        var e3: int64 := peek8(evtPtr + 2) as int64;
        // S15 = Cancel, S17 = Delete, S26 = NoShow
        if (e1 == 83 && e2 == 49 && e3 == 53) { poke64(appt + HL7_APPT_ISCANCEL, 1); }
        if (e1 == 83 && e2 == 49 && e3 == 55) { poke64(appt + HL7_APPT_ISDELETE, 1); }
        if (e1 == 83 && e2 == 50 && e3 == 54) { poke64(appt + HL7_APPT_ISNOSHOW, 1); }
    }
    // SCH: S=83, C=67, H=72
    var schSeg: int64 := siuFindSeg(msg, len, 83, 67, 72, 124);
    if (schSeg != 0) {
        var schLen: int64 := siuSegLen(msg, len, schSeg);
        var sch: int64 := alloc(HL7_SCH_SIZE);
        Hl7SchParse(schSeg, schLen, sch);
        poke64(appt + HL7_APPT_PLACER, peek64(sch + HL7_SCH_PLACER));
        poke64(appt + HL7_APPT_PLACER_LEN, peek64(sch + HL7_SCH_PLACER_LEN));
        poke64(appt + HL7_APPT_FILLER, peek64(sch + HL7_SCH_FILLER));
        poke64(appt + HL7_APPT_FILLER_LEN, peek64(sch + HL7_SCH_FILLER_LEN));
        poke64(appt + HL7_APPT_START_DT, peek64(sch + HL7_SCH_START_DT));
        poke64(appt + HL7_APPT_START_DT_LEN, peek64(sch + HL7_SCH_START_DT_LEN));
        poke64(appt + HL7_APPT_DURATION, peek64(sch + HL7_SCH_DURATION));
        poke64(appt + HL7_APPT_DURATION_LEN, peek64(sch + HL7_SCH_DURATION_LEN));
        poke64(appt + HL7_APPT_STATUS, peek64(sch + HL7_SCH_STATUS));
        poke64(appt + HL7_APPT_STATUS_LEN, peek64(sch + HL7_SCH_STATUS_LEN));
    }
    // PID: P=80, I=73, D=68
    var pidSeg: int64 := siuFindSeg(msg, len, 80, 73, 68, 124);
    if (pidSeg != 0) {
        var pidLen: int64 := siuSegLen(msg, len, pidSeg);
        var fptr: int64 := alloc(16);
        var flen: int64 := alloc(16);
        var cptr: int64 := alloc(16);
        var clen: int64 := alloc(16);
        siuFieldGet(pidSeg, pidLen, 124, 3, fptr, flen);
        var f3p: int64 := peek64(fptr);
        var f3l: int64 := peek64(flen);
        siuCompGet(f3p, f3l, 94, 1, cptr, clen);
        poke64(appt + HL7_APPT_PAT_ID, peek64(cptr));
        poke64(appt + HL7_APPT_PAT_ID_LEN, peek64(clen));
    }
    // AIS: A=65, I=73, S=83
    var aisSeg: int64 := siuFindSeg(msg, len, 65, 73, 83, 124);
    if (aisSeg != 0) {
        var aisLen: int64 := siuSegLen(msg, len, aisSeg);
        var ais: int64 := alloc(HL7_AIS_SIZE);
        Hl7AisParse(aisSeg, aisLen, ais);
        poke64(appt + HL7_APPT_SERVICE, peek64(ais + HL7_AIS_SERVICE));
        poke64(appt + HL7_APPT_SERVICE_LEN, peek64(ais + HL7_AIS_SERVICE_LEN));
    }
}

// Write SIU^Sxx message from appt struct.
// Event code taken from appt.EVENT (3 chars); defaults to S12 when absent.
// Produces: MSH + SCH + optional AIS (when SERVICE_LEN > 0).
// Returns bytes written.
pub fn Hl7SiuWrite(appt: int64, out: int64, outMax: int64): int64 {
    var pos:  int64 := 0;
    var fsep: int64 := 124;
    var csep: int64 := 94;
    // MSH
    poke8(out+pos, 77); pos := pos + 1;    // M
    poke8(out+pos, 83); pos := pos + 1;    // S
    poke8(out+pos, 72); pos := pos + 1;    // H
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, csep); pos := pos + 1;
    poke8(out+pos, 126); pos := pos + 1;   // ~
    poke8(out+pos, 92);  pos := pos + 1;   // backslash
    poke8(out+pos, 38);  pos := pos + 1;   // &
    poke8(out+pos, fsep); pos := pos + 1;  // MSH-3
    poke8(out+pos, fsep); pos := pos + 1;  // MSH-4
    poke8(out+pos, fsep); pos := pos + 1;  // MSH-5
    poke8(out+pos, fsep); pos := pos + 1;  // MSH-6
    poke8(out+pos, fsep); pos := pos + 1;  // MSH-7
    poke8(out+pos, fsep); pos := pos + 1;  // MSH-8
    poke8(out+pos, fsep); pos := pos + 1;  // → MSH-9
    // MSH-9: SIU^{event}
    poke8(out+pos, 83); pos := pos + 1;    // S
    poke8(out+pos, 73); pos := pos + 1;    // I
    poke8(out+pos, 85); pos := pos + 1;    // U
    poke8(out+pos, csep); pos := pos + 1;
    var evtPtr: int64 := peek64(appt + HL7_APPT_EVENT);
    var evtLen: int64 := peek64(appt + HL7_APPT_EVENT_LEN);
    if (evtLen >= 3 && evtPtr != 0) {
        poke8(out+pos, peek8(evtPtr));     pos := pos + 1;
        poke8(out+pos, peek8(evtPtr + 1)); pos := pos + 1;
        poke8(out+pos, peek8(evtPtr + 2)); pos := pos + 1;
    } else {
        poke8(out+pos, 83); pos := pos + 1;  // S
        poke8(out+pos, 49); pos := pos + 1;  // 1
        poke8(out+pos, 50); pos := pos + 1;  // 2
    }
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;  // MSH-10
    poke8(out+pos, 80); pos := pos + 1;    // P
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, 50); pos := pos + 1;    // 2
    poke8(out+pos, 46); pos := pos + 1;    // .
    poke8(out+pos, 53); pos := pos + 1;    // 5
    poke8(out+pos, 46); pos := pos + 1;    // .
    poke8(out+pos, 49); pos := pos + 1;    // 1
    poke8(out+pos, 13); pos := pos + 1;    // CR
    // SCH
    poke8(out+pos, 83); pos := pos + 1;    // S
    poke8(out+pos, 67); pos := pos + 1;    // C
    poke8(out+pos, 72); pos := pos + 1;    // H
    poke8(out+pos, fsep); pos := pos + 1;  // before f1
    var plPtr: int64 := peek64(appt + HL7_APPT_PLACER);
    var plLen: int64 := peek64(appt + HL7_APPT_PLACER_LEN);
    if (plLen > 0) { pos := siuWriteField(out, pos, plPtr, plLen); }
    poke8(out+pos, fsep); pos := pos + 1;  // before f2
    var flPtr: int64 := peek64(appt + HL7_APPT_FILLER);
    var flLen: int64 := peek64(appt + HL7_APPT_FILLER_LEN);
    if (flLen > 0) { pos := siuWriteField(out, pos, flPtr, flLen); }
    // 7 separators: f3,f4,f5,f6,f7,f8 empty → reaches f9
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    var durPtr: int64 := peek64(appt + HL7_APPT_DURATION);
    var durLen: int64 := peek64(appt + HL7_APPT_DURATION_LEN);
    if (durLen > 0) { pos := siuWriteField(out, pos, durPtr, durLen); }
    // 2 separators: f10 empty → reaches f11
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    var dtPtr: int64 := peek64(appt + HL7_APPT_START_DT);
    var dtLen: int64 := peek64(appt + HL7_APPT_START_DT_LEN);
    if (dtLen > 0) { pos := siuWriteField(out, pos, dtPtr, dtLen); }
    // 14 separators: f12..f24 empty → reaches f25
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    poke8(out+pos, fsep); pos := pos + 1;
    var stPtr: int64 := peek64(appt + HL7_APPT_STATUS);
    var stLen: int64 := peek64(appt + HL7_APPT_STATUS_LEN);
    if (stLen > 0) { pos := siuWriteField(out, pos, stPtr, stLen); }
    poke8(out+pos, 13); pos := pos + 1;    // CR
    // AIS (when service type set)
    var svcPtr: int64 := peek64(appt + HL7_APPT_SERVICE);
    var svcLen: int64 := peek64(appt + HL7_APPT_SERVICE_LEN);
    if (svcLen > 0) {
        poke8(out+pos, 65); pos := pos + 1;  // A
        poke8(out+pos, 73); pos := pos + 1;  // I
        poke8(out+pos, 83); pos := pos + 1;  // S
        poke8(out+pos, fsep); pos := pos + 1;
        poke8(out+pos, 49); pos := pos + 1;  // 1 (set ID)
        poke8(out+pos, fsep); pos := pos + 1;
        poke8(out+pos, fsep); pos := pos + 1;
        pos := siuWriteField(out, pos, svcPtr, svcLen);
        poke8(out+pos, 13); pos := pos + 1;  // CR
    }
    return pos;
}
