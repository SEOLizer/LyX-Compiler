// std/stats.lyx
// Statistics & Aggregation functions for int64 arrays

@description("Statistical functions (mean, variance, correlation)")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
unit std.stats;

import std.sort;

fn StatsGet(arr: int64, i: int64): int64 {
  var off: int64 := i * 8;
  return peek64(arr + off);
}

pub fn ArraySum(arr: int64, n: int64): int64 {
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < n) {
    sum := sum + StatsGet(arr, i);
    i += 1;
  }
  return sum;
}

pub fn ArrayMin(arr: int64, n: int64): int64 {
  if (n == 0) { return 0; }
  var mn: int64 := StatsGet(arr, 0);
  var i: int64 := 1;
  while (i < n) {
    var v: int64 := StatsGet(arr, i);
    if (v < mn) { mn := v; }
    i += 1;
  }
  return mn;
}

pub fn ArrayMax(arr: int64, n: int64): int64 {
  if (n == 0) { return 0; }
  var mx: int64 := StatsGet(arr, 0);
  var i: int64 := 1;
  while (i < n) {
    var v: int64 := StatsGet(arr, i);
    if (v > mx) { mx := v; }
    i += 1;
  }
  return mx;
}

pub fn ArrayAvg(arr: int64, n: int64): int64 {
  if (n == 0) { return 0; }
  var s: int64 := ArraySum(arr, n);
  return s / n;
}

pub fn ArrayCount(arr: int64, n: int64): int64 {
  return n;
}

pub fn ArrayProduct(arr: int64, n: int64): int64 {
  if (n == 0) { return 0; }
  var product: int64 := 1;
  var i: int64 := 0;
  while (i < n) {
    product := product * StatsGet(arr, i);
    i += 1;
  }
  return product;
}

pub fn ArrayFirst(arr: int64, n: int64, fallback: int64): int64 {
  if (n == 0) { return fallback; }
  return StatsGet(arr, 0);
}

pub fn ArrayLast(arr: int64, n: int64, fallback: int64): int64 {
  if (n == 0) { return fallback; }
  var last: int64 := n - 1;
  return StatsGet(arr, last);
}

pub fn ArrayIndexOf(arr: int64, n: int64, value: int64): int64 {
  var i: int64 := 0;
  while (i < n) {
    if (StatsGet(arr, i) == value) { return i; }
    i += 1;
  }
  return -1;
}

pub fn ArrayLastIndexOf(arr: int64, n: int64, value: int64): int64 {
  var i: int64 := n - 1;
  while (i >= 0) {
    if (StatsGet(arr, i) == value) { return i; }
    i -= 1;
  }
  return -1;
}

pub fn ArrayContains(arr: int64, n: int64, value: int64): bool {
  return ArrayIndexOf(arr, n, value) >= 0;
}

pub fn ArrayCountValue(arr: int64, n: int64, value: int64): int64 {
  var count: int64 := 0;
  var i: int64 := 0;
  while (i < n) {
    if (StatsGet(arr, i) == value) { count := count + 1; }
    i += 1;
  }
  return count;
}

pub fn ArraySort(arr: int64, n: int64): void {
  SortInt64(arr, n);
}

pub fn ArrayMedian(arr: int64, n: int64): int64 {
  if (n == 0) { return 0; }
  SortInt64(arr, n);
  var mid: int64 := n / 2;
  return StatsGet(arr, mid);
}

pub fn ArrayRange(arr: int64, n: int64): int64 {
  return ArrayMax(arr, n) - ArrayMin(arr, n);
}

pub fn ArraySumSquares(arr: int64, n: int64): int64 {
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < n) {
    var v: int64 := StatsGet(arr, i);
    sum := sum + (v * v);
    i += 1;
  }
  return sum;
}

pub fn ArrayVariance(arr: int64, n: int64): int64 {
  if (n == 0) { return 0; }
  var mean: int64 := ArrayAvg(arr, n);
  var sumSqDiff: int64 := 0;
  var i: int64 := 0;
  while (i < n) {
    var diff: int64 := StatsGet(arr, i) - mean;
    sumSqDiff := sumSqDiff + (diff * diff);
    i += 1;
  }
  return sumSqDiff / n;
}

pub fn ArrayStdDev(arr: int64, n: int64): int64 {
  var variance: int64 := ArrayVariance(arr, n);
  if (variance <= 0) { return 0; }
  var x: int64 := variance;
  var x1: int64 := x + 1;
  var y: int64 := x1 / 2;
  while (y < x) {
    x := y;
    var vx: int64 := variance / x;
    var xvx: int64 := x + vx;
    y := xvx / 2;
  }
  return x;
}

pub fn Clamp64(value: int64, minVal: int64, maxVal: int64): int64 {
  if (value < minVal) { return minVal; }
  if (value > maxVal) { return maxVal; }
  return value;
}

pub fn Percentage64(value: int64, total: int64): int64 {
  if (total == 0) { return 0; }
  var v100: int64 := value * 100;
  return v100 / total;
}

pub fn InRange64(value: int64, minVal: int64, maxVal: int64): bool {
  return (value >= minVal) && (value <= maxVal);
}

pub fn AbsDiff64(a: int64, b: int64): int64 {
  if (a > b) { return a - b; }
  return b - a;
}

// ============================================================================
// Map Aggregate Functions
// ============================================================================
// Operates on HashMap instances (the runtime representation of Map<K,V>).
// Pass your map as int64: MapSum(myMap as int64)
//
// HashMap runtime layout (class → VMT at +0, fields at +8):
//   +0:  VMT pointer
//   +8:  data     (int64) — bucket array pointer
//   +16: capacity (int64) — number of buckets
//   +24: length   (int64) — number of filled entries
// Bucket entry (24 bytes): keyPtr(+0), keyLen(+8), val(+16)
// Empty slot: keyPtr == 0

pub fn MapCount(m: int64): int64 {
  if (m == 0) { return 0; }
  return peek64(m + 24);
}

pub fn MapSum(m: int64): int64 {
  if (m == 0) { return 0; }
  var data: int64 := peek64(m + 8);
  var cap: int64 := peek64(m + 16);
  var sum: int64 := 0;
  var i: int64 := 0;
  while (i < cap) {
    var entry: int64 := data + i * 24;
    if (peek64(entry) != 0) {
      sum := sum + peek64(entry + 16);
    }
    i += 1;
  }
  return sum;
}

pub fn MapMin(m: int64): int64 {
  if (m == 0) { return 0; }
  var data: int64 := peek64(m + 8);
  var cap: int64 := peek64(m + 16);
  var found: bool := false;
  var minVal: int64 := 0;
  var i: int64 := 0;
  while (i < cap) {
    var entry: int64 := data + i * 24;
    if (peek64(entry) != 0) {
      var v: int64 := peek64(entry + 16);
      if (!found) { minVal := v; found := true; }
      else if (v < minVal) { minVal := v; }
    }
    i += 1;
  }
  return minVal;
}

pub fn MapMax(m: int64): int64 {
  if (m == 0) { return 0; }
  var data: int64 := peek64(m + 8);
  var cap: int64 := peek64(m + 16);
  var found: bool := false;
  var maxVal: int64 := 0;
  var i: int64 := 0;
  while (i < cap) {
    var entry: int64 := data + i * 24;
    if (peek64(entry) != 0) {
      var v: int64 := peek64(entry + 16);
      if (!found) { maxVal := v; found := true; }
      else if (v > maxVal) { maxVal := v; }
    }
    i += 1;
  }
  return maxVal;
}

pub fn MapAvg(m: int64): int64 {
  var cnt: int64 := MapCount(m);
  if (cnt == 0) { return 0; }
  return MapSum(m) / cnt;
}
