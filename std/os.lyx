// std/os.lyx
// Operating system utilities

// ============================================================================
// External libc functions
// ============================================================================

@description("Operating system utilities")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
@capabilities([fs.read, process.exec, process.fork, process.signal, system.env, system.time])
unit std.os;

import std.alloc;
import std.env;

// ============================================================================
// Constants
// ============================================================================

con SC_CLK_TCK:          int64 := 2;
con SC_PAGESIZE:         int64 := 47;
con SC_NPROCESSORS_ONLN: int64 := 84;

// #1179: Hier standen dreizehn `extern fn ... ;` OHNE link-Klausel. Keines
// dieser Symbole wurde je gebunden — jeder Aufruf lieferte still 0. `env_get`
// gab damit immer "", `get_cwd` immer "", `get_pid` immer 0, `time_ms` immer
// 0, und `abort()` beendete nichts. Gemeldet wurde nie etwas, weil 0 bei
// diesen Funktionen ein plausibler Wert ist.
//
// Ersetzt durch Syscalls. libc wird dafuer nicht gebraucht, das Programm
// bleibt statisch linkbar — und die Aufrufe unterliegen demselben
// seccomp-Filter wie der uebrige Code, statt an ihm vorbei in eine
// Bibliothek zu gehen.

con OS_CLOCK_REALTIME: int64 := 0;
con OS_SIGABRT:        int64 := 6;

// #1179: `setenv`/`unsetenv` gibt es als Syscall nicht — die Umgebung ist eine
// Sache der C-Bibliothek bzw. des Startstacks. Gefuehrt wird deshalb eine
// eigene Ueberlagerung: sie gilt fuer DIESEN Prozess und geht `env_get` vor.
// Ein per execve gestartetes Kind bekommt sie nicht mit; das ist die Grenze
// und steht so auch in der Doku.
var _envOverKeys: int64 := 0;
var _envOverVals: int64 := 0;
var _envOverCount: int64 := 0;
var _envOverCap: int64 := 0;

fn _envOverFind(key: pchar): int64 {
  var i: int64 := 0;
  while (i < _envOverCount) {
    var k: pchar := peek64(_envOverKeys + i * 8) as pchar;
    if (StrEq(k, key)) { return i; }
    i := i + 1;
  }
  return 0 - 1;
}

fn _envOverSet(key: pchar, val: pchar): int64 {
  var idx: int64 := _envOverFind(key);
  if (idx >= 0) { poke64(_envOverVals + idx * 8, val as int64); return 1; }
  if (_envOverCount >= _envOverCap) {
    var nc: int64 := _envOverCap * 2;
    if (nc < 8) { nc := 8; }
    var nk: int64 := alloc(nc * 8);
    var nv: int64 := alloc(nc * 8);
    var j: int64 := 0;
    while (j < _envOverCount) {
      poke64(nk + j * 8, peek64(_envOverKeys + j * 8));
      poke64(nv + j * 8, peek64(_envOverVals + j * 8));
      j := j + 1;
    }
    _envOverKeys := nk; _envOverVals := nv; _envOverCap := nc;
  }
  poke64(_envOverKeys + _envOverCount * 8, key as int64);
  poke64(_envOverVals + _envOverCount * 8, val as int64);
  _envOverCount := _envOverCount + 1;
  return 1;
}

fn getenv(name: pchar): pchar {
  if (name == 0 as pchar) { return 0 as pchar; }
  var oi: int64 := _envOverFind(name);
  if (oi >= 0) {
    var ov: int64 := peek64(_envOverVals + oi * 8);
    if (ov == 0) { return 0 as pchar; }        // per unsetenv geloescht
    return ov as pchar;
  }
  return EnvLookupRaw(name);
}

fn setenv(name: pchar, val: pchar, overwrite: int64): int64 {
  if (overwrite == 0 && getenv(name) != 0 as pchar) { return 0; }
  _envOverSet(name, val);
  return 0;
}

fn unsetenv(name: pchar): int64 {
  _envOverSet(name, 0 as pchar);
  return 0;
}

fn getcwd(buf: pchar, size: int64): pchar {
  var r: int64 := sys_getcwd(buf as int64, size);
  if (r < 0) { return 0 as pchar; }
  return buf;
}

fn chdir(path: pchar): int64  { return sys_chdir(path as int64); }
fn getpid(): int64            { return sys_getpid(); }
fn getuid(): int64            { return sys_getuid(); }
fn getppid(): int64           { return sys_getppid(); }
fn access(path: pchar, mode: int64): int64 { return sys_access(path as int64, mode); }
fn raise(sig: int64): int64   { return sys_kill(sys_getpid(), sig); }

fn time(tloc: int64): int64 {
  var buf: int64 := alloc(16);
  sys_clock_gettime(OS_CLOCK_REALTIME, buf);
  var sec: int64 := peek64(buf);
  free(buf, 16);
  if (tloc != 0) { poke64(tloc, sec); }
  return sec;
}

fn nanosleep(req: int64, rem: int64): int64 { return sys_nanosleep(req, rem); }

// sysconf gibt es nur in der C-Bibliothek. Die drei im Bestand benutzten
// Werte stehen anders zur Verfuegung: die Taktrate ist auf Linux/x86-64 fest
// 100, die Seitengroesse 4096, und die Kernzahl liefert sched_getaffinity.
fn sysconf(name: int64): int64 {
  if (name == SC_CLK_TCK)  { return 100; }
  if (name == SC_PAGESIZE) { return 4096; }
  // Die Kernzahl liefert allein sched_getaffinity (Syscall 204). Der steht in
  // KEINER Capability-Erlaubnisliste; unter dem seccomp-Filter beendet sein
  // Aufruf den Prozess mit SIGSYS. Deshalb wird er hier nicht gerufen und die
  // Zahl als UNBEKANNT gemeldet (-1) — eine erfundene 1 waere auf einer
  // Achtkernmaschine schlicht falsch.
  return 0 - 1;
}


// ============================================================================
// Sleep Functions
// ============================================================================

pub fn sleep(milliseconds: int64): void {
  if (milliseconds <= 0) { return; }
  var ts: int64 := alloc(16);
  if (ts == 0) { return; }
  var secs: int64 := milliseconds / 1000;
  var ns: int64 := (milliseconds - secs * 1000) * 1000000;
  poke64(ts, secs);
  poke64(ts + 8, ns);
  nanosleep(ts, 0);
  free(ts, 16);
}

pub fn sleep_seconds(seconds: int64): void {
  if (seconds <= 0) { return; }
  var ts: int64 := alloc(16);
  if (ts == 0) { return; }
  poke64(ts, seconds);
  poke64(ts + 8, 0);
  nanosleep(ts, 0);
  free(ts, 16);
}

pub fn sleep_microseconds(microseconds: int64): void {
  if (microseconds <= 0) { return; }
  var ts: int64 := alloc(16);
  if (ts == 0) { return; }
  var secs: int64 := microseconds / 1000000;
  var ns: int64 := (microseconds - secs * 1000000) * 1000;
  poke64(ts, secs);
  poke64(ts + 8, ns);
  nanosleep(ts, 0);
  free(ts, 16);
}

// ============================================================================
// Process Information
// ============================================================================

pub fn get_pid(): int64 {
  return getpid();
}

pub fn get_uid(): int64 {
  return getuid();
}

pub fn get_ppid(): int64 {
  return getppid();
}

// ============================================================================
// Environment Variables
// ============================================================================

pub fn env_get(key: pchar): pchar {
  if (key == 0) {
    return "";
  }
  var result: pchar := getenv(key);
  if (result == 0) {
    return "";
  }
  return result;
}

pub fn env_set(key: pchar, val: pchar): bool {
  if (key == 0) {
    return false;
  }
  if (val == 0) {
    return false;
  }
  return setenv(key, val, 1) == 0;
}

pub fn env_unset(key: pchar): bool {
  if (key == 0) {
    return false;
  }
  return unsetenv(key) == 0;
}

pub fn env_has(key: pchar): bool {
  var val: pchar := getenv(key);
  return val != 0;
}

// ============================================================================
// Working Directory
// ============================================================================

pub fn get_cwd(): pchar {
  var buf: int64 := alloc(4096);
  if (buf == 0) { return ""; }
  var result: pchar := getcwd(buf as pchar, 4096);
  if (result == 0) {
    free(buf, 4096);
    return "";
  }
  return result;
}

pub fn set_cwd(path: pchar): bool {
  if (path == 0) {
    return false;
  }
  return chdir(path) == 0;
}

// ============================================================================
// Time
// ============================================================================

// #1179: Die Unit exportierte bisher unfreiwillig das rohe `time` — eine
// extern-Deklaration liegt im flachen Namensraum und war damit von aussen
// rufbar (tests/regression/stdlib/test_os.lyx tut das). Gebunden war sie nie,
// der Aufruf lieferte still 0. Der Ersatz ist eine benannte oeffentliche
// Funktion; die Huelle darunter bleibt unit-intern.
pub fn unix_time(): int64 {
  return time(0);
}

pub fn time_ms(): int64 {
  var t: int64 := time(0);
  return t * 1000;
}

pub fn time_us(): int64 {
  var t: int64 := time(0);
  return t * 1000000;
}

// ============================================================================
// System Information
// ============================================================================

// #1179: Vorher lieferte das immer 1 — sysconf war nie gebunden, gab still 0,
// und die Ersatzregel machte daraus eine 1. Die Zahl war also nie gemessen.
// Ermitteln laesst sie sich nur ueber sched_getaffinity, und dieser Syscall
// ist unter dem seccomp-Filter nicht erlaubt (siehe sysconf). Deshalb jetzt
// -1 fuer "unbekannt", statt eine Zahl zu behaupten.
pub fn get_num_cores(): int64 {
  return sysconf(SC_NPROCESSORS_ONLN);
}

pub fn get_page_size(): int64 {
  var pagesize: int64 := sysconf(SC_PAGESIZE);
  if (pagesize <= 0) {
    return 4096;
  }
  return pagesize;
}

// ============================================================================
// Memory Information
// ============================================================================

// Reads a numeric value (in kB) from /proc/meminfo for the given label.
// label must include the trailing colon, e.g. "MemTotal:".
fn _readMemInfoKB(label: pchar): int64 {
  var buf: int64 := alloc(4096);
  if (buf == 0) { return 0; }
  var f: int64 := open("/proc/meminfo", 0, 0);
  if (f < 0) { free(buf, 4096); return 0; }
  var n: int64 := read(f, buf as pchar, 4095);
  close(f);
  if (n <= 0) { free(buf, 4096); return 0; }
  poke8(buf + n, 0);

  var labelLen: int64 := StrLen(label);
  var i: int64 := 0;
  var pos: int64 := -1;
  while (i + labelLen <= n && pos < 0) {
    var j: int64 := 0;
    var mismatch: bool := false;
    while (j < labelLen && !mismatch) {
      if (peek8(buf + i + j) != StrCharAt(label, j)) {
        mismatch := true;
      } else {
        j += 1;
      }
    }
    if (!mismatch) {
      pos := i + labelLen;
    } else {
      i += 1;
    }
  }
  if (pos < 0) { free(buf, 4096); return 0; }

  while (pos < n && peek8(buf + pos) == 32) {
    pos += 1;
  }

  var val: int64 := 0;
  var done: bool := false;
  while (pos < n && !done) {
    var ch: int64 := peek8(buf + pos);
    if (ch < 48 || ch > 57) {
      done := true;
    } else {
      val := val * 10 + ch - 48;
      pos += 1;
    }
  }

  free(buf, 4096);
  return val;
}

pub fn get_total_memory_mb(): int64 {
  return _readMemInfoKB("MemTotal:") / 1024;
}

pub fn get_available_memory_mb(): int64 {
  return _readMemInfoKB("MemAvailable:") / 1024;
}

// ============================================================================
// Process Control
// ============================================================================

pub fn os_exit(code: int64): void {
  exit(code);
}

pub fn abort(): void {
  raise(6);
  exit(1);
}

// exec(path, a0..a4): fork + execve + wait4
// Returns exit status of child, or -1 on error.
// Pass "" for unused args (a1..a4).
pub fn exec(path: pchar, a0: pchar, a1: pchar, a2: pchar, a3: pchar): int64 {
  // Build argv[] array in anonymous mmap: 6 pointers x 8 bytes = 48 bytes
  var argv: int64 := alloc(48);
  if (argv == 0) {
    return -1;
  }
  poke64(argv + 0,  path as int64);
  poke64(argv + 8,  a0   as int64);
  poke64(argv + 16, a1   as int64);
  poke64(argv + 24, a2   as int64);
  poke64(argv + 32, a3   as int64);
  poke64(argv + 40, 0);

  var pid: int64 := sys_fork();
  if (pid < 0) {
    free(argv, 48);
    return -1;
  }
  if (pid == 0) {
    sys_execve(path, argv, 0);
    os_exit(127);
  }
  var status: int64 := alloc(8);
  var ret: int64 := sys_wait4(pid, status, 0);
  var exitCode: int64 := (peek64(status) >> 8) & 255;
  free(status, 8);
  free(argv, 48);
  return exitCode;
}

// ============================================================================
// File Operations
// ============================================================================

pub fn path_exists(path: pchar): bool {
  if (path == 0) {
    return false;
  }
  return access(path, 0) == 0;
}

pub fn is_directory(path: pchar): bool {
  return false;
}

pub fn is_file(path: pchar): bool {
  return false;
}

// ============================================================================
// Version Information
// ============================================================================

pub fn get_os_name(): pchar {
  return "Linux";
}

pub fn get_os_version(): pchar {
  return "";
}

pub fn get_arch(): pchar {
  return "x86_64";
}

// ============================================================================
// User Information
// ============================================================================

pub fn get_home_dir(): pchar {
  var home: pchar := env_get("HOME");
  if (home != "") {
    return home;
  }
  return "";
}

pub fn get_temp_dir(): pchar {
  var tmp: pchar := env_get("TMPDIR");
  if (tmp != "") {
    return tmp;
  }
  return "/tmp";
}

pub fn get_user_name(): pchar {
  var user: pchar := env_get("USER");
  if (user != "") {
    return user;
  }
  return "";
}

// ============================================================================
// Path Utilities
// ============================================================================

pub fn path_filename(path: pchar): pchar {
  if (path == 0) {
    return "";
  }
  var i: int64 := 0;
  var last_slash: int64 := -1;
  while (path[i] != 0) {
    if (path[i] == 47) {
      last_slash := i;
    }
    i += 1;
  }
  if (last_slash < 0) {
    return path;
  }
  return path + last_slash + 1;
}

pub fn path_dirname(path: pchar): pchar {
  return "";
}

pub fn path_is_absolute(path: pchar): bool {
  if (path == 0) {
    return false;
  }
  return path[0] == 47;
}

