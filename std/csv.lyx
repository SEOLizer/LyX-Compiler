// std/csv.lyx
// Tabellen aus Textdateien: trennzeichen- oder spaltenweise, mit
// Anfuehrungszeichen, Kommentaren und fehlenden Werten.

@description("Delimited text tables: CSV/TSV and whitespace-separated columns, quoted fields, comments, missing-value markers, numeric matrix extraction")
@author("Andreas Roene")
@copyright("2026 Andreas Roene")
unit std.csv;

import std.string;
import std.alloc;
import std.fs;
import std.io;      // FloatToStr fuer den Schreibteil

// ── Worum es geht ────────────────────────────────────────────────────────────
//
// Eine Datentabelle liegt fast immer als Text vor, und fast nie genau als
// "Komma getrennt": die Datensaetze des maschinellen Lernens trennen mit
// Leerzeichenfolgen, Messreihen mit Tabulatoren, Exporte mit Semikolon. Diese
// Unit liest alle vier Formen und liefert die Felder als Zeichenketten; die
// Umrechnung in Zahlen ist ein getrennter Schritt, damit ein nicht lesbares
// Feld auffaellt statt still zu 0 zu werden.
//
// ── Was NICHT still passiert ─────────────────────────────────────────────────
//
// Ein leeres oder als fehlend markiertes Feld (etwa "?" oder "NA") ist kein
// Nullwert. CsvIsMissing sagt es, CsvFloat meldet es ueber das ok-Feld, und
// CsvToMatrix bricht ab, statt eine Lücke mit 0 zu fuellen. Wer Zeilen mit
// Lücken ueberspringen will, nimmt CsvToMatrixSkip -- dort steht die Zahl der
// uebersprungenen Zeilen im Rueckgabefeld, also im Blick.
//
// Ebenso bleibt eine ZACKIGE Tabelle (unterschiedlich viele Felder je Zeile)
// sichtbar: CsvRowFieldCount nennt die Zahl je Zeile, CsvIsRagged die Tabelle
// als Ganzes. Ein Zugriff hinter das Ende einer kurzen Zeile liefert 0 und
// gilt als FEHLEND (CSV_E_MISSING), nicht als leere Zeichenkette; eine Zeile
// oder Spalte, die es in der Tabelle gar nicht gibt, ist dagegen ein
// Aufruffehler (CSV_E_RANGE). CsvFieldState nennt den Unterschied.
//
// ── Speicher ─────────────────────────────────────────────────────────────────
//
// Die Datei wird EINMAL gelesen und bleibt im Puffer. Die Felder sind Zeiger
// IN diesen Puffer; sie sind an ihrem Ende mit einem Nullbyte abgeschlossen,
// weil das Trennzeichen dort ohnehin ueberschrieben werden kann. Darum gilt:
// jeder von CsvField gelieferte Zeiger lebt bis CsvFree und ist danach
// ungueltig. Wer ihn laenger braucht, kopiert ihn.

// ── Fehlerschluessel ─────────────────────────────────────────────────────────

pub con CSV_OK: int64        := 0;
pub con CSV_E_ARGS: int64    := 1;   // Zeiger 0, leerer Pfad, Unsinn im Aufruf
pub con CSV_E_FILE: int64    := 2;   // Datei fehlt, ist leer oder zu gross
pub con CSV_E_MEM: int64     := 3;   // Speicher nicht zu bekommen
pub con CSV_E_QUOTE: int64   := 4;   // Anfuehrungszeichen nicht geschlossen
pub con CSV_E_MISSING: int64 := 5;   // Feld fehlt, wo eine Zahl stehen muss
pub con CSV_E_NUMBER: int64  := 6;   // Feld ist keine Zahl
pub con CSV_E_RANGE: int64   := 7;   // Zeile oder Spalte gibt es nicht
pub con CSV_E_SPACE: int64   := 8;   // Zielpuffer zu klein
pub con CSV_E_UNQUOTABLE: int64 := 9;   // Feld braucht Anfuehrungszeichen, es gibt keins
pub con CSV_E_EMPTYROW: int64   := 10;  // Zeile ohne Felder

// Trennzeichen 0 heisst: an Folgen von Leerzeichen und Tabulatoren trennen
pub con CSV_SEP_WHITESPACE: int64 := 0;
pub con CSV_SEP_COMMA: int64 := 44;
pub con CSV_SEP_SEMICOLON: int64 := 59;
pub con CSV_SEP_TAB: int64 := 9;

// Kein Anfuehrungs- bzw. Kommentarzeichen
pub con CSV_NO_QUOTE: int64 := 0;
pub con CSV_NO_COMMENT: int64 := 0;
pub con CSV_QUOTE_DOUBLE: int64 := 34;
pub con CSV_COMMENT_HASH: int64 := 35;

var _csv_err: int64 := 0;

// Letzter Fehler. Ohne ihn waere ein 0-Handle oder ein 0-Wert nicht
// unterscheidbar von "ging nicht".
pub fn CsvError(): int64 {
  return _csv_err;
}

// Kopf der Tabelle, Slots je 8 Byte
con H_MAGIC: int64    := 0;
con H_BUF: int64      := 1;
con H_BUFLEN: int64   := 2;
con H_ROWS: int64     := 3;    // Datenzeilen (ohne Kopfzeile)
con H_COLS: int64     := 4;    // groesste Feldzahl einer Zeile
con H_ROWOFF: int64   := 5;    // je Zeile: Index in das Feldverzeichnis
con H_ROWLEN: int64   := 6;    // je Zeile: Feldzahl
con H_ROWCAP: int64   := 7;
con H_FIELDS: int64   := 8;    // je Feld: Byte-Offset im Puffer
con H_FIELDCNT: int64 := 9;
con H_FIELDCAP: int64 := 10;
con H_SEP: int64      := 11;
con H_QUOTE: int64    := 12;
con H_COMMENT: int64  := 13;
con H_HDR: int64      := 14;   // 1 = erste Zeile ist Kopfzeile
con H_HDROFF: int64   := 15;   // Index der Kopffelder, -1 ohne Kopfzeile
con H_HDRLEN: int64   := 16;
con H_MISS: int64     := 17;   // eigene Kopie der Fehlend-Marke, 0 = keine
con H_RLCAP: int64    := 18;   // Fassungsvermoegen der Laengenliste
con H_SLOTS: int64    := 19;

con CSV_MAGIC: int64 := 6517491;   // 'csv'

fn _hg(t: int64, slot: int64): int64 { return peek64(t + slot * 8); }
fn _hs(t: int64, slot: int64, v: int64): void { poke64(t + slot * 8, v); }

fn _isTab(t: int64): bool {
  if (t == 0) { return false; }
  if (_hg(t, H_MAGIC) != CSV_MAGIC) { return false; }
  return true;
}

fn _failI(code: int64): int64 {
  _csv_err := code;
  return 0;
}

fn _failB(code: int64): bool {
  _csv_err := code;
  return false;
}

// ── Wachsende int64-Felder ───────────────────────────────────────────────────
//
// Verdoppeln statt um eins wachsen: std.alloc holt je Allokation eine eigene
// mmap-Abbildung, und eine Tabelle mit 400 Zeilen wuerde sonst 400 davon
// anfordern und wieder freigeben.

fn _grow(ptrSlot: int64, t: int64, capSlot: int64, needed: int64): bool {
  var cap: int64 := _hg(t, capSlot);
  if (needed <= cap) { return true; }
  var neu: int64 := cap * 2;
  if (neu < 16) { neu := 16; }
  while (neu < needed) { neu := neu * 2; }
  var alt: int64 := _hg(t, ptrSlot);
  var frisch: int64 := alloc(neu * 8);
  if (frisch == 0) { return false; }
  var i: int64 := 0;
  while (i < cap) {
    poke64(frisch + i * 8, peek64(alt + i * 8));
    i := i + 1;
  }
  while (i < neu) {
    poke64(frisch + i * 8, 0);
    i := i + 1;
  }
  if (alt != 0) { free(alt, cap * 8); }
  _hs(t, ptrSlot, frisch);
  _hs(t, capSlot, neu);
  return true;
}

fn _isSpace(c: int64): bool {
  if (c == 32) { return true; }
  if (c == 9) { return true; }
  return false;
}

// ── Lesen ────────────────────────────────────────────────────────────────────

pub fn CsvMaxFileBytes(): int64 {
  return 268435456;      // 256 MiB -- ohne Deckel bestimmt die Datei den Bedarf
}

fn _newTable(sep: int64, quote: int64, comment: int64, hasHeader: bool): int64 {
  var t: int64 := allocZeroed(H_SLOTS * 8);
  if (t == 0) { return 0; }
  _hs(t, H_MAGIC, CSV_MAGIC);
  _hs(t, H_SEP, sep);
  _hs(t, H_QUOTE, quote);
  _hs(t, H_COMMENT, comment);
  if (hasHeader) { _hs(t, H_HDR, 1); } else { _hs(t, H_HDR, 0); }
  _hs(t, H_HDROFF, -1);
  return t;
}

// Ein Feld vermerken: Offset im Puffer, Nullbyte an sein Ende
fn _addField(t: int64, off: int64): bool {
  var cnt: int64 := _hg(t, H_FIELDCNT);
  if (_grow(H_FIELDS, t, H_FIELDCAP, cnt + 1) == false) { return false; }
  poke64(_hg(t, H_FIELDS) + cnt * 8, off);
  _hs(t, H_FIELDCNT, cnt + 1);
  return true;
}

// Eintragen; gewachsen ist vorher (_grow + _syncRowLen in _parse)
fn _addRow(t: int64, firstField: int64, count: int64): bool {
  var rows: int64 := _hg(t, H_ROWS);
  if (rows >= _hg(t, H_ROWCAP)) { return false; }
  if (rows >= _hg(t, H_RLCAP)) { return false; }
  poke64(_hg(t, H_ROWOFF) + rows * 8, firstField);
  poke64(_hg(t, H_ROWLEN) + rows * 8, count);
  _hs(t, H_ROWS, rows + 1);
  if (count > _hg(t, H_COLS)) { _hs(t, H_COLS, count); }
  return true;
}

// Die Laengenliste wird mit DEMSELBEN Fassungsvermoegen wie die Offsetliste
// gefuehrt, wandert aber nicht mit _grow mit -- darum ein eigener Schritt
// direkt nach jedem Wachstum. Zwei Listen mit getrennter Buchfuehrung waeren
// die naechste Stelle, an der eine vergessen wird.
fn _syncRowLen(t: int64): bool {
  var cap: int64 := _hg(t, H_ROWCAP);
  if (cap == 0) { return true; }
  var have: int64 := _hg(t, H_RLCAP);
  if (have >= cap) { return true; }
  var rows: int64 := _hg(t, H_ROWS);
  var lenPtr: int64 := _hg(t, H_ROWLEN);
  var frisch: int64 := allocZeroed(cap * 8);
  if (frisch == 0) { return false; }
  var i: int64 := 0;
  while (i < rows) {
    poke64(frisch + i * 8, peek64(lenPtr + i * 8));
    i := i + 1;
  }
  if (lenPtr != 0) { free(lenPtr, have * 8); }
  _hs(t, H_ROWLEN, frisch);
  _hs(t, H_RLCAP, cap);
  return true;
}

// Zerlegt den Puffer. Rueckgabe false mit gesetztem _csv_err.
//
// Ein Feld wird mit einem Nullbyte abgeschlossen, und das steht entweder auf
// dem Trennzeichen oder innerhalb des Feldes (bei abgeschnittenem Leerraum,
// bei ausgepackten Anfuehrungszeichen). Darum wird das Trennzeichen GELESEN,
// BEVOR das Nullbyte geschrieben wird -- sonst entscheidet der Parser danach
// anhand des Nullbytes, das er selbst gesetzt hat.

fn _lineEnd(t: int64, i: int64): int64 {
  var buf: int64 := _hg(t, H_BUF);
  var len: int64 := _hg(t, H_BUFLEN);
  var k: int64 := i;
  while (k < len) {
    if ((peek8(buf + k) & 255) == 10) { return k + 1; }
    k := k + 1;
  }
  return len;
}

fn _parse(t: int64): bool {
  var buf: int64 := _hg(t, H_BUF);
  var len: int64 := _hg(t, H_BUFLEN);
  var sep: int64 := _hg(t, H_SEP);
  var quote: int64 := _hg(t, H_QUOTE);
  var comment: int64 := _hg(t, H_COMMENT);
  var i: int64 := 0;
  while (i < len) {
    var c: int64 := peek8(buf + i) & 255;
    // Leerzeile
    if (c == 10) { i := i + 1; continue; }
    if (c == 13) { i := i + 1; continue; }
    // Kommentarzeile: Kommentarzeichen als erstes Zeichen nach Leerraum
    if (comment != CSV_NO_COMMENT) {
      var j: int64 := i;
      while (j < len) {
        var cj: int64 := peek8(buf + j) & 255;
        if (_isSpace(cj) == false) { break; }
        j := j + 1;
      }
      if (j < len) {
        if ((peek8(buf + j) & 255) == comment) {
          i := _lineEnd(t, j);
          continue;
        }
      }
    }

    var firstField: int64 := _hg(t, H_FIELDCNT);
    var anzahl: int64 := 0;
    var fertig: bool := false;
    while (fertig == false) {
      // Bei Leerraumtrennung: Leerraum vor dem Feld verwerfen
      if (sep == CSV_SEP_WHITESPACE) {
        while (i < len) {
          var cs: int64 := peek8(buf + i) & 255;
          if (_isSpace(cs) == false) { break; }
          i := i + 1;
        }
        if (i >= len) { fertig := true; break; }
        var ce: int64 := peek8(buf + i) & 255;
        if (ce == 13) { i := i + 1; continue; }
        if (ce == 10) {
          i := i + 1;
          fertig := true;
          break;
        }
      }

      var start: int64 := i;
      var feldEnde: int64 := i;         // Stelle fuer das Nullbyte
      var termPos: int64 := i;          // Stelle des Trennzeichens danach
      var quoted: bool := false;
      if (quote != CSV_NO_QUOTE) {
        if ((peek8(buf + i) & 255) == quote) { quoted := true; }
      }

      if (quoted) {
        i := i + 1;
        start := i;
        var schreib: int64 := i;
        var zu: bool := false;
        while (i < len) {
          var cq: int64 := peek8(buf + i) & 255;
          if (cq == quote) {
            // verdoppeltes Anfuehrungszeichen steht fuer sich selbst
            if (i + 1 < len) {
              if ((peek8(buf + i + 1) & 255) == quote) {
                poke8(buf + schreib, quote);
                schreib := schreib + 1;
                i := i + 2;
                continue;
              }
            }
            i := i + 1;
            zu := true;
            break;
          }
          poke8(buf + schreib, cq);
          schreib := schreib + 1;
          i := i + 1;
        }
        if (zu == false) { return _failB(CSV_E_QUOTE); }
        feldEnde := schreib;
        // hinter dem schliessenden Zeichen bis zum Trennzeichen
        while (i < len) {
          var ca: int64 := peek8(buf + i) & 255;
          if (_isSpace(ca)) { i := i + 1; continue; }
          break;
        }
        termPos := i;
      } else {
        while (i < len) {
          var cu: int64 := peek8(buf + i) & 255;
          if (cu == 10) { break; }
          if (cu == 13) { break; }
          if (sep == CSV_SEP_WHITESPACE) {
            if (_isSpace(cu)) { break; }
          } else {
            if (cu == sep) { break; }
          }
          i := i + 1;
        }
        termPos := i;
        feldEnde := i;
        // bei Trennzeichen den Leerraum um das Feld verwerfen
        if (sep != CSV_SEP_WHITESPACE) {
          while (start < feldEnde) {
            if (_isSpace(peek8(buf + start) & 255) == false) { break; }
            start := start + 1;
          }
          while (feldEnde > start) {
            if (_isSpace(peek8(buf + feldEnde - 1) & 255) == false) { break; }
            feldEnde := feldEnde - 1;
          }
        }
      }

      // Das Trennzeichen LESEN, bevor das Nullbyte es ueberschreiben kann
      var term: int64 := -1;
      if (termPos < len) { term := peek8(buf + termPos) & 255; }
      poke8(buf + feldEnde, 0);
      if (_addField(t, start) == false) { return _failB(CSV_E_MEM); }
      anzahl := anzahl + 1;

      if (term < 0) {
        fertig := true;
      } else if (term == 10) {
        i := termPos + 1;
        fertig := true;
      } else if (term == 13) {
        i := termPos + 1;
        if (i < len) {
          if ((peek8(buf + i) & 255) == 10) { i := i + 1; }
        }
        fertig := true;
      } else {
        i := termPos + 1;         // Trennzeichen bzw. Leerraum ueberlesen
      }
    }

    if (anzahl > 0) {
      if (_hg(t, H_HDR) == 1) {
        if (_hg(t, H_HDROFF) < 0) {
          _hs(t, H_HDROFF, firstField);
          _hs(t, H_HDRLEN, anzahl);
          continue;
        }
      }
      if (_grow(H_ROWOFF, t, H_ROWCAP, _hg(t, H_ROWS) + 1) == false) {
        return _failB(CSV_E_MEM);
      }
      if (_syncRowLen(t) == false) { return _failB(CSV_E_MEM); }
      if (_addRow(t, firstField, anzahl) == false) { return _failB(CSV_E_MEM); }
    }
  }
  return true;
}

// Tabelle aus einer Datei. sep ist CSV_SEP_WHITESPACE oder ein Zeichencode,
// quote/comment sind CSV_NO_QUOTE/CSV_NO_COMMENT oder ein Zeichencode.
// Rueckgabe 0 bei Fehler, CsvError() nennt den Grund.
pub fn CsvOpen(path: pchar, sep: int64, quote: int64, comment: int64,
               hasHeader: bool): int64 {
  _csv_err := CSV_OK;
  if (path == 0 as pchar) { return _failI(CSV_E_ARGS); }
  var size: int64 := FileSize(path);
  if (size < 1) { return _failI(CSV_E_FILE); }
  if (size > CsvMaxFileBytes()) { return _failI(CSV_E_FILE); }
  // ein Byte mehr: das letzte Feld braucht Platz fuer sein Nullbyte, auch
  // wenn die Datei ohne Zeilenumbruch endet
  var buf: int64 := alloc(size + 1);
  if (buf == 0) { return _failI(CSV_E_MEM); }
  var got: int64 := ReadFile(path, buf as pchar, size);
  if (got != size) {
    free(buf, size + 1);
    return _failI(CSV_E_FILE);
  }
  poke8(buf + size, 0);
  var t: int64 := _newTable(sep, quote, comment, hasHeader);
  if (t == 0) {
    free(buf, size + 1);
    return _failI(CSV_E_MEM);
  }
  _hs(t, H_BUF, buf);
  _hs(t, H_BUFLEN, size);
  if (_parse(t) == false) {
    CsvFree(t);
    return 0;                  // _csv_err steht schon
  }
  return t;
}

// Kurzform fuer Spalten, die mit Leerzeichenfolgen getrennt sind
pub fn CsvOpenWhitespace(path: pchar, hasHeader: bool): int64 {
  return CsvOpen(path, CSV_SEP_WHITESPACE, CSV_QUOTE_DOUBLE,
                 CSV_NO_COMMENT, hasHeader);
}

// Kurzform fuer Komma mit Anfuehrungszeichen
pub fn CsvOpenCsv(path: pchar, hasHeader: bool): int64 {
  return CsvOpen(path, CSV_SEP_COMMA, CSV_QUOTE_DOUBLE,
                 CSV_NO_COMMENT, hasHeader);
}

pub fn CsvFree(t: int64): void {
  if (_isTab(t) == false) { return; }
  var buf: int64 := _hg(t, H_BUF);
  if (buf != 0) { free(buf, _hg(t, H_BUFLEN) + 1); }
  var fo: int64 := _hg(t, H_FIELDS);
  if (fo != 0) { free(fo, _hg(t, H_FIELDCAP) * 8); }
  var ro: int64 := _hg(t, H_ROWOFF);
  if (ro != 0) { free(ro, _hg(t, H_ROWCAP) * 8); }
  var rl: int64 := _hg(t, H_ROWLEN);
  if (rl != 0) { free(rl, _hg(t, H_RLCAP) * 8); }
  var mi: int64 := _hg(t, H_MISS);
  if (mi != 0) { free(mi, 64); }
  _hs(t, H_MAGIC, 0);
  free(t, H_SLOTS * 8);
}

// ── Fehlend-Marke ────────────────────────────────────────────────────────────

// Zeichenkette, die ein fehlendes Feld bedeutet (etwa "?" oder "NA").
// Hoechstens 63 Zeichen. Ein leeres Feld gilt immer als fehlend, auch ohne
// Marke.
pub fn CsvSetMissing(t: int64, marker: pchar): bool {
  _csv_err := CSV_OK;
  if (_isTab(t) == false) { return _failB(CSV_E_ARGS); }
  if (marker == 0 as pchar) { return _failB(CSV_E_ARGS); }
  var n: int64 := StrLen(marker);
  if (n < 1) { return _failB(CSV_E_ARGS); }
  if (n > 63) { return _failB(CSV_E_ARGS); }
  var alt: int64 := _hg(t, H_MISS);
  if (alt != 0) { free(alt, 64); }
  var p: int64 := alloc(64);
  if (p == 0) { return _failB(CSV_E_MEM); }
  var i: int64 := 0;
  while (i < n) {
    poke8(p + i, peek8((marker as int64) + i));
    i := i + 1;
  }
  poke8(p + n, 0);
  _hs(t, H_MISS, p);
  return true;
}

// ── Abfragen ─────────────────────────────────────────────────────────────────

pub fn CsvRowCount(t: int64): int64 {
  if (_isTab(t) == false) { return 0; }
  return _hg(t, H_ROWS);
}

pub fn CsvColCount(t: int64): int64 {
  if (_isTab(t) == false) { return 0; }
  return _hg(t, H_COLS);
}

pub fn CsvRowFieldCount(t: int64, row: int64): int64 {
  if (_isTab(t) == false) { return 0; }
  if (row < 0) { return 0; }
  if (row >= _hg(t, H_ROWS)) { return 0; }
  return peek64(_hg(t, H_ROWLEN) + row * 8);
}

// Haben nicht alle Zeilen gleich viele Felder? Eine zackige Tabelle ist nicht
// verboten, sie soll nur nicht unbemerkt bleiben.
pub fn CsvIsRagged(t: int64): bool {
  if (_isTab(t) == false) { return false; }
  var rows: int64 := _hg(t, H_ROWS);
  if (rows < 2) { return false; }
  var erste: int64 := CsvRowFieldCount(t, 0);
  var i: int64 := 1;
  while (i < rows) {
    if (CsvRowFieldCount(t, i) != erste) { return true; }
    i := i + 1;
  }
  return false;
}

pub fn CsvHasHeader(t: int64): bool {
  if (_isTab(t) == false) { return false; }
  if (_hg(t, H_HDROFF) < 0) { return false; }
  return true;
}

pub fn CsvHeaderCount(t: int64): int64 {
  if (CsvHasHeader(t) == false) { return 0; }
  return _hg(t, H_HDRLEN);
}

// Name der Spalte col oder 0. Zeiger IN den Puffer, gilt bis CsvFree.
pub fn CsvHeader(t: int64, col: int64): pchar {
  if (CsvHasHeader(t) == false) { return 0 as pchar; }
  if (col < 0) { return 0 as pchar; }
  if (col >= _hg(t, H_HDRLEN)) { return 0 as pchar; }
  var idx: int64 := _hg(t, H_HDROFF) + col;
  var off: int64 := peek64(_hg(t, H_FIELDS) + idx * 8);
  return (_hg(t, H_BUF) + off) as pchar;
}

// Spaltennummer zu einem Namen aus der Kopfzeile, oder -1.
pub fn CsvColumnIndex(t: int64, name: pchar): int64 {
  if (CsvHasHeader(t) == false) { return -1; }
  if (name == 0 as pchar) { return -1; }
  var n: int64 := _hg(t, H_HDRLEN);
  var i: int64 := 0;
  while (i < n) {
    if (StrCmp(CsvHeader(t, i), name) == 0) { return i; }
    i := i + 1;
  }
  return -1;
}

// Zustand eines Zugriffs: CSV_OK, CSV_E_RANGE (die Zeile oder Spalte gibt es
// in der Tabelle nicht) oder CSV_E_MISSING (die Zeile ist kuerzer, das Feld
// fehlt also). Der Unterschied ist nicht Haarspalterei: "Spalte 7 gibt es
// nicht" ist ein Fehler im Aufruf, "diese Zeile hat nur 5 Felder" eine
// Eigenschaft der Daten. Dieselbe Einteilung benutzen CsvIsMissing, CsvFloat
// und CsvInt -- drei Stellen, eine Regel.
fn _state(t: int64, row: int64, col: int64): int64 {
  if (_isTab(t) == false) { return CSV_E_ARGS; }
  if (row < 0) { return CSV_E_RANGE; }
  if (row >= _hg(t, H_ROWS)) { return CSV_E_RANGE; }
  if (col < 0) { return CSV_E_RANGE; }
  if (col >= _hg(t, H_COLS)) { return CSV_E_RANGE; }
  if (col >= CsvRowFieldCount(t, row)) { return CSV_E_MISSING; }
  return CSV_OK;
}

// Zustand eines Zugriffs von aussen: CSV_OK, CSV_E_RANGE oder CSV_E_MISSING.
pub fn CsvFieldState(t: int64, row: int64, col: int64): int64 {
  return _state(t, row, col);
}

// Feld als Zeichenkette oder 0, wenn Zeile oder Spalte fehlen. Zeiger IN den
// Puffer, gilt bis CsvFree.
pub fn CsvField(t: int64, row: int64, col: int64): pchar {
  if (_isTab(t) == false) { return 0 as pchar; }
  if (row < 0) { return 0 as pchar; }
  if (row >= _hg(t, H_ROWS)) { return 0 as pchar; }
  if (col < 0) { return 0 as pchar; }
  if (col >= CsvRowFieldCount(t, row)) { return 0 as pchar; }
  var base: int64 := peek64(_hg(t, H_ROWOFF) + row * 8);
  var off: int64 := peek64(_hg(t, H_FIELDS) + (base + col) * 8);
  return (_hg(t, H_BUF) + off) as pchar;
}

// Fehlt das Feld? Leer, hinter dem Zeilenende oder gleich der Fehlend-Marke.
pub fn CsvIsMissing(t: int64, row: int64, col: int64): bool {
  var f: pchar := CsvField(t, row, col);
  if (f == 0 as pchar) { return true; }
  if (StrLen(f) == 0) { return true; }
  var mi: int64 := _hg(t, H_MISS);
  if (mi != 0) {
    if (StrCmp(f, mi as pchar) == 0) { return true; }
  }
  return false;
}

// Feld als f64. ok ist ein int64-Feld mit einem Eintrag: 1 bei Erfolg, sonst
// 0 -- der Rueckgabewert 0.0 allein waere nicht unterscheidbar von einer
// gelesenen Null. Ohne ok (0) steht der Grund in CsvError().
pub fn CsvFloat(t: int64, row: int64, col: int64, ok: int64): f64 {
  _csv_err := CSV_OK;
  if (ok != 0) { poke64(ok, 0); }
  var st: int64 := _state(t, row, col);
  if (st != CSV_OK) {
    _csv_err := st;
    return (0 as f64);
  }
  var f: pchar := CsvField(t, row, col);
  if (CsvIsMissing(t, row, col)) {
    _csv_err := CSV_E_MISSING;
    return (0 as f64);
  }
  var innerOk: int64 := alloc(8);
  if (innerOk == 0) {
    _csv_err := CSV_E_MEM;
    return (0 as f64);
  }
  poke64(innerOk, 0);
  var v: f64 := StrToF64(f, innerOk);
  var gut: int64 := peek64(innerOk);
  free(innerOk, 8);
  if (gut == 0) {
    _csv_err := CSV_E_NUMBER;
    return (0 as f64);
  }
  if (ok != 0) { poke64(ok, 1); }
  return v;
}

// Feld als int64, gleiche Spielregeln wie CsvFloat.
pub fn CsvInt(t: int64, row: int64, col: int64, ok: int64): int64 {
  _csv_err := CSV_OK;
  if (ok != 0) { poke64(ok, 0); }
  var st: int64 := _state(t, row, col);
  if (st != CSV_OK) {
    _csv_err := st;
    return 0;
  }
  var f: pchar := CsvField(t, row, col);
  if (CsvIsMissing(t, row, col)) {
    _csv_err := CSV_E_MISSING;
    return 0;
  }
  var innerOk: int64 := alloc(8);
  if (innerOk == 0) {
    _csv_err := CSV_E_MEM;
    return 0;
  }
  poke64(innerOk, 0);
  var v: int64 := StrToInt64(f, innerOk);
  var gut: int64 := peek64(innerOk);
  free(innerOk, 8);
  if (gut == 0) {
    _csv_err := CSV_E_NUMBER;
    return 0;
  }
  if (ok != 0) { poke64(ok, 1); }
  return v;
}

// ── Zahlenmatrix ─────────────────────────────────────────────────────────────

// Taugt die Zeile fuer die genannten Spalten? Alle Felder vorhanden, nicht
// als fehlend markiert und als Zahl lesbar.
pub fn CsvRowUsable(t: int64, row: int64, cols: int64, nCols: int64): bool {
  if (_isTab(t) == false) { return false; }
  if (cols == 0) { return false; }
  if (nCols < 1) { return false; }
  var j: int64 := 0;
  while (j < nCols) {
    var c: int64 := peek64(cols + j * 8);
    var okBox: int64 := alloc(8);
    if (okBox == 0) { return false; }
    var v: f64 := CsvFloat(t, row, c, okBox);
    var gut: int64 := peek64(okBox);
    free(okBox, 8);
    if (gut == 0) { return false; }
    j := j + 1;
  }
  return true;
}

// Die genannten Spalten als f64-Matrix (zeilenweise, nCols Spalten) nach out.
// cols ist ein int64-Feld mit nCols Spaltennummern.
//
// Rueckgabe ist die Zahl der geschriebenen Zeilen oder -1. Eine Zeile mit
// fehlendem oder nicht lesbarem Feld laesst den Aufruf SCHEITERN -- sie
// stillschweigend mit 0 zu fuellen waere genau der Fehler, der sich spaeter
// als "das Modell lernt nichts" zeigt. Wer Lücken ueberspringen will, nimmt
// CsvToMatrixSkip.
pub fn CsvToMatrix(t: int64, cols: int64, nCols: int64,
                   out: int64, maxRows: int64): int64 {
  _csv_err := CSV_OK;
  if (_isTab(t) == false) { _csv_err := CSV_E_ARGS; return -1; }
  if (cols == 0) { _csv_err := CSV_E_ARGS; return -1; }
  if (out == 0) { _csv_err := CSV_E_ARGS; return -1; }
  if (nCols < 1) { _csv_err := CSV_E_ARGS; return -1; }
  var rows: int64 := _hg(t, H_ROWS);
  if (rows > maxRows) { _csv_err := CSV_E_SPACE; return -1; }
  var i: int64 := 0;
  while (i < rows) {
    var j: int64 := 0;
    while (j < nCols) {
      var c: int64 := peek64(cols + j * 8);
      var okBox: int64 := alloc(8);
      if (okBox == 0) { _csv_err := CSV_E_MEM; return -1; }
      var v: f64 := CsvFloat(t, i, c, okBox);
      var gut: int64 := peek64(okBox);
      free(okBox, 8);
      if (gut == 0) { return -1; }        // _csv_err steht schon
      pokef64(out + (i * nCols + j) * 8, v);
      j := j + 1;
    }
    i := i + 1;
  }
  return rows;
}

// Wie CsvToMatrix, ueberspringt aber unbrauchbare Zeilen. skipped ist ein
// int64-Feld mit einem Eintrag und nimmt deren Zahl auf -- damit steht die
// Lücke im Bericht statt in den Daten.
pub fn CsvToMatrixSkip(t: int64, cols: int64, nCols: int64,
                       out: int64, maxRows: int64, skipped: int64): int64 {
  _csv_err := CSV_OK;
  if (skipped != 0) { poke64(skipped, 0); }
  if (_isTab(t) == false) { _csv_err := CSV_E_ARGS; return -1; }
  if (cols == 0) { _csv_err := CSV_E_ARGS; return -1; }
  if (out == 0) { _csv_err := CSV_E_ARGS; return -1; }
  if (nCols < 1) { _csv_err := CSV_E_ARGS; return -1; }
  var rows: int64 := _hg(t, H_ROWS);
  var geschrieben: int64 := 0;
  var weg: int64 := 0;
  var i: int64 := 0;
  while (i < rows) {
    if (CsvRowUsable(t, i, cols, nCols)) {
      if (geschrieben >= maxRows) { _csv_err := CSV_E_SPACE; return -1; }
      var j: int64 := 0;
      while (j < nCols) {
        var c: int64 := peek64(cols + j * 8);
        var v: f64 := CsvFloat(t, i, c, 0);
        pokef64(out + (geschrieben * nCols + j) * 8, v);
        j := j + 1;
      }
      geschrieben := geschrieben + 1;
    } else {
      weg := weg + 1;
    }
    i := i + 1;
  }
  if (skipped != 0) { poke64(skipped, weg); }
  _csv_err := CSV_OK;
  return geschrieben;
}

// Zahl der Zeilen, die fuer die genannten Spalten brauchbar sind -- fuer die
// Groesse des Zielpuffers, bevor etwas geschrieben wird.
pub fn CsvUsableRowCount(t: int64, cols: int64, nCols: int64): int64 {
  if (_isTab(t) == false) { return 0; }
  var rows: int64 := _hg(t, H_ROWS);
  var i: int64 := 0;
  var n: int64 := 0;
  while (i < rows) {
    if (CsvRowUsable(t, i, cols, nCols)) { n := n + 1; }
    i := i + 1;
  }
  return n;
}

// ── Schreiben ────────────────────────────────────────────────────────────────
//
// Der Schreiber sammelt die Tabelle in einem wachsenden Puffer und legt sie am
// Ende als Datei ab (oder gibt den Puffer heraus, etwa fuer eine
// Datenbankspalte). Felder werden in der Reihenfolge geschrieben, in der sie
// stehen sollen; CsvEndRow schliesst eine Zeile ab.
//
// ── Wann Anfuehrungszeichen gesetzt werden ───────────────────────────────────
//
// Immer dann, wenn das Feld sonst nicht wieder einzulesen waere: wenn es das
// Trennzeichen, ein Anfuehrungszeichen, einen Zeilenumbruch oder fuehrenden
// bzw. abschliessenden Leerraum enthaelt. Anfuehrungszeichen im Feld werden
// verdoppelt. Wer `quoteAlways` setzt, bekommt sie um jedes Feld.
//
// Gibt es KEIN Anfuehrungszeichen (CSV_NO_QUOTE) und braeuchte das Feld eines,
// scheitert der Aufruf mit CSV_E_UNQUOTABLE. Eine Datei zu schreiben, die sich
// nicht mehr lesen laesst, waere der schlimmere Ausgang: der Fehler faellt
// dann erst beim Einlesen auf, und niemand sucht ihn beim Schreiber.

con W_MAGIC: int64  := 0;
con W_BUF: int64    := 1;
con W_CAP: int64    := 2;
con W_LEN: int64    := 3;
con W_SEP: int64    := 4;
con W_QUOTE: int64  := 5;
con W_ALWAYS: int64 := 6;
con W_MISS: int64   := 7;
con W_FIELDS: int64 := 8;   // Felder in der laufenden Zeile
con W_ROWS: int64   := 9;
con W_CRLF: int64   := 10;
con W_SLOTS: int64  := 11;

con CSVW_MAGIC: int64 := 6517495;   // 'csw'

fn _isW(w: int64): bool {
  if (w == 0) { return false; }
  if (peek64(w + W_MAGIC * 8) != CSVW_MAGIC) { return false; }
  return true;
}

fn _wg(w: int64, slot: int64): int64 { return peek64(w + slot * 8); }
fn _ws(w: int64, slot: int64, v: int64): void { poke64(w + slot * 8, v); }

// Platz fuer weitere n Bytes schaffen. Verdoppeln, nicht nachlegen: std.alloc
// holt je Allokation eine eigene mmap-Abbildung.
fn _wNeed(w: int64, n: int64): bool {
  var len: int64 := _wg(w, W_LEN);
  var cap: int64 := _wg(w, W_CAP);
  if (len + n + 1 <= cap) { return true; }
  var neu: int64 := cap * 2;
  if (neu < 256) { neu := 256; }
  while (neu < len + n + 1) { neu := neu * 2; }
  var frisch: int64 := alloc(neu);
  if (frisch == 0) { return false; }
  var alt: int64 := _wg(w, W_BUF);
  var i: int64 := 0;
  while (i < len) {
    poke8(frisch + i, peek8(alt + i));
    i := i + 1;
  }
  if (alt != 0) { free(alt, cap); }
  _ws(w, W_BUF, frisch);
  _ws(w, W_CAP, neu);
  return true;
}

fn _wByte(w: int64, c: int64): bool {
  if (_wNeed(w, 1) == false) { return false; }
  var len: int64 := _wg(w, W_LEN);
  poke8(_wg(w, W_BUF) + len, c);
  _ws(w, W_LEN, len + 1);
  return true;
}

fn _wStr(w: int64, s: pchar): bool {
  var n: int64 := StrLen(s);
  if (_wNeed(w, n) == false) { return false; }
  var len: int64 := _wg(w, W_LEN);
  var buf: int64 := _wg(w, W_BUF);
  var i: int64 := 0;
  while (i < n) {
    poke8(buf + len + i, peek8((s as int64) + i));
    i := i + 1;
  }
  _ws(w, W_LEN, len + n);
  return true;
}

// Neuer Schreiber. sep ist das Trennzeichen (CSV_SEP_COMMA, CSV_SEP_TAB, 32
// fuer Leerzeichen ...); CSV_SEP_WHITESPACE wird abgelehnt, denn beim
// Schreiben muss ein konkretes Zeichen zwischen die Felder.
pub fn CsvWriterNew(sep: int64, quote: int64, quoteAlways: bool): int64 {
  _csv_err := CSV_OK;
  if (sep == CSV_SEP_WHITESPACE) { return _failI(CSV_E_ARGS); }
  if (sep < 1) { return _failI(CSV_E_ARGS); }
  if (sep > 255) { return _failI(CSV_E_ARGS); }
  if (sep == 10) { return _failI(CSV_E_ARGS); }
  if (sep == 13) { return _failI(CSV_E_ARGS); }
  if (quote < 0) { return _failI(CSV_E_ARGS); }
  if (quote > 255) { return _failI(CSV_E_ARGS); }
  if (quote == sep) { return _failI(CSV_E_ARGS); }
  if (quoteAlways) {
    if (quote == CSV_NO_QUOTE) { return _failI(CSV_E_ARGS); }
  }
  var w: int64 := allocZeroed(W_SLOTS * 8);
  if (w == 0) { return _failI(CSV_E_MEM); }
  _ws(w, W_MAGIC, CSVW_MAGIC);
  _ws(w, W_SEP, sep);
  _ws(w, W_QUOTE, quote);
  if (quoteAlways) { _ws(w, W_ALWAYS, 1); } else { _ws(w, W_ALWAYS, 0); }
  _ws(w, W_CRLF, 0);
  return w;
}

pub fn CsvWriterFree(w: int64): void {
  if (_isW(w) == false) { return; }
  var b: int64 := _wg(w, W_BUF);
  if (b != 0) { free(b, _wg(w, W_CAP)); }
  var mi: int64 := _wg(w, W_MISS);
  if (mi != 0) { free(mi, 64); }
  _ws(w, W_MAGIC, 0);
  free(w, W_SLOTS * 8);
}

// Zeichenkette, die fuer ein fehlendes Feld geschrieben wird (etwa "?" oder
// "NA"). Ohne sie bleibt das Feld leer.
pub fn CsvWriterSetMissing(w: int64, marker: pchar): bool {
  _csv_err := CSV_OK;
  if (_isW(w) == false) { return _failB(CSV_E_ARGS); }
  if (marker == 0 as pchar) { return _failB(CSV_E_ARGS); }
  var n: int64 := StrLen(marker);
  if (n > 63) { return _failB(CSV_E_ARGS); }
  var alt: int64 := _wg(w, W_MISS);
  if (alt != 0) { free(alt, 64); }
  var p: int64 := alloc(64);
  if (p == 0) { return _failB(CSV_E_MEM); }
  var i: int64 := 0;
  while (i < n) {
    poke8(p + i, peek8((marker as int64) + i));
    i := i + 1;
  }
  poke8(p + n, 0);
  _ws(w, W_MISS, p);
  return true;
}

// Zeilenende CRLF statt LF (fuer Empfaenger, die darauf bestehen).
pub fn CsvWriterSetCrlf(w: int64, on: bool): void {
  if (_isW(w) == false) { return; }
  if (on) { _ws(w, W_CRLF, 1); } else { _ws(w, W_CRLF, 0); }
}

// Braucht dieses Feld Anfuehrungszeichen?
fn _needsQuote(w: int64, s: pchar): bool {
  var sep: int64 := _wg(w, W_SEP);
  var quote: int64 := _wg(w, W_QUOTE);
  var n: int64 := StrLen(s);
  if (n == 0) { return false; }
  var erst: int64 := peek8((s as int64)) & 255;
  if (_isSpace(erst)) { return true; }
  var letzt: int64 := peek8((s as int64) + n - 1) & 255;
  if (_isSpace(letzt)) { return true; }
  var i: int64 := 0;
  while (i < n) {
    var c: int64 := peek8((s as int64) + i) & 255;
    if (c == sep) { return true; }
    if (c == 10) { return true; }
    if (c == 13) { return true; }
    if (quote != CSV_NO_QUOTE) {
      if (c == quote) { return true; }
    }
    i := i + 1;
  }
  return false;
}

// Ein Feld schreiben. Trennzeichen davor setzt die Funktion selbst, wenn in
// dieser Zeile schon ein Feld steht.
pub fn CsvWriteField(w: int64, s: pchar): bool {
  _csv_err := CSV_OK;
  if (_isW(w) == false) { return _failB(CSV_E_ARGS); }
  if (s == 0 as pchar) { return _failB(CSV_E_ARGS); }
  var sep: int64 := _wg(w, W_SEP);
  var quote: int64 := _wg(w, W_QUOTE);
  if (_wg(w, W_FIELDS) > 0) {
    if (_wByte(w, sep) == false) { return _failB(CSV_E_MEM); }
  }
  var mitQuote: bool := false;
  if (_wg(w, W_ALWAYS) == 1) { mitQuote := true; }
  if (_needsQuote(w, s)) {
    if (quote == CSV_NO_QUOTE) { return _failB(CSV_E_UNQUOTABLE); }
    mitQuote := true;
  }
  if (mitQuote) {
    if (_wByte(w, quote) == false) { return _failB(CSV_E_MEM); }
    var n: int64 := StrLen(s);
    var i: int64 := 0;
    while (i < n) {
      var c: int64 := peek8((s as int64) + i) & 255;
      if (c == quote) {
        if (_wByte(w, quote) == false) { return _failB(CSV_E_MEM); }
      }
      if (_wByte(w, c) == false) { return _failB(CSV_E_MEM); }
      i := i + 1;
    }
    if (_wByte(w, quote) == false) { return _failB(CSV_E_MEM); }
  } else {
    if (_wStr(w, s) == false) { return _failB(CSV_E_MEM); }
  }
  _ws(w, W_FIELDS, _wg(w, W_FIELDS) + 1);
  return true;
}

pub fn CsvWriteInt(w: int64, v: int64): bool {
  _csv_err := CSV_OK;
  if (_isW(w) == false) { return _failB(CSV_E_ARGS); }
  return CsvWriteField(w, IntToStr(v));
}

// Gleitkommazahl mit decimals Nachkommastellen. decimals < 0 wird abgelehnt:
// eine stillschweigend gewaehlte Genauigkeit ist beim Schreiben von Messwerten
// genau die Art Entscheidung, die niemand bemerkt.
pub fn CsvWriteFloat(w: int64, v: f64, decimals: int64): bool {
  _csv_err := CSV_OK;
  if (_isW(w) == false) { return _failB(CSV_E_ARGS); }
  if (decimals < 0) { return _failB(CSV_E_ARGS); }
  if (decimals > 17) { return _failB(CSV_E_ARGS); }
  // NaN und Unendlich haben in einer Zahlenspalte nichts zu suchen: beim
  // Einlesen waeren sie keine Zahl. Wer eine Luecke schreiben will, nimmt
  // CsvWriteMissing. (Nebenbei: FloatToStr gibt fuer diese Faelle ein
  // String-LITERAL zurueck, das nicht freigegeben werden darf -- der Zweig
  // unten gibt 96 Byte zurueck.)
  if (v != v) { return _failB(CSV_E_NUMBER); }
  var maxFinite: f64 := 1.7976931348623157e308;
  if (v > maxFinite) { return _failB(CSV_E_NUMBER); }
  var negMax: f64 := 0.0 - maxFinite;
  if (v < negMax) { return _failB(CSV_E_NUMBER); }
  var s: pchar := FloatToStr(v, decimals);
  if (s == 0 as pchar) { return _failB(CSV_E_MEM); }
  var okb: bool := CsvWriteField(w, s);
  free(s as int64, 96);        // FloatToStr legt 96 Byte an
  if (okb == false) { return false; }
  return true;
}

// Fehlendes Feld: die Marke aus CsvWriterSetMissing, sonst ein leeres Feld.
pub fn CsvWriteMissing(w: int64): bool {
  _csv_err := CSV_OK;
  if (_isW(w) == false) { return _failB(CSV_E_ARGS); }
  var mi: int64 := _wg(w, W_MISS);
  if (mi == 0) { return CsvWriteField(w, ""c); }
  return CsvWriteField(w, mi as pchar);
}

// Zeile abschliessen. Eine Zeile OHNE Feld wird abgelehnt: beim Einlesen
// verschwindet eine Leerzeile wieder, der Bestand waere also nach dem
// Rundlauf ein anderer.
pub fn CsvEndRow(w: int64): bool {
  _csv_err := CSV_OK;
  if (_isW(w) == false) { return _failB(CSV_E_ARGS); }
  if (_wg(w, W_FIELDS) < 1) { return _failB(CSV_E_EMPTYROW); }
  if (_wg(w, W_CRLF) == 1) {
    if (_wByte(w, 13) == false) { return _failB(CSV_E_MEM); }
  }
  if (_wByte(w, 10) == false) { return _failB(CSV_E_MEM); }
  _ws(w, W_FIELDS, 0);
  _ws(w, W_ROWS, _wg(w, W_ROWS) + 1);
  return true;
}

// Eine ganze Zeile aus Zeichenketten: names ist ein int64-Feld mit n Zeigern.
pub fn CsvWriteRowStrings(w: int64, names: int64, n: int64): bool {
  _csv_err := CSV_OK;
  if (_isW(w) == false) { return _failB(CSV_E_ARGS); }
  if (names == 0) { return _failB(CSV_E_ARGS); }
  if (n < 1) { return _failB(CSV_E_ARGS); }
  var i: int64 := 0;
  while (i < n) {
    var s: int64 := peek64(names + i * 8);
    if (s == 0) { return _failB(CSV_E_ARGS); }
    if (CsvWriteField(w, s as pchar) == false) { return false; }
    i := i + 1;
  }
  return CsvEndRow(w);
}

// Eine f64-Matrix (zeilenweise, cols Spalten) als rows Zeilen.
pub fn CsvWriteMatrix(w: int64, M: int64, rows: int64, cols: int64,
                      decimals: int64): bool {
  _csv_err := CSV_OK;
  if (_isW(w) == false) { return _failB(CSV_E_ARGS); }
  if (M == 0) { return _failB(CSV_E_ARGS); }
  if (rows < 1) { return _failB(CSV_E_ARGS); }
  if (cols < 1) { return _failB(CSV_E_ARGS); }
  var i: int64 := 0;
  while (i < rows) {
    var j: int64 := 0;
    while (j < cols) {
      var v: f64 := peekf64(M + (i * cols + j) * 8);
      if (CsvWriteFloat(w, v, decimals) == false) { return false; }
      j := j + 1;
    }
    if (CsvEndRow(w) == false) { return false; }
    i := i + 1;
  }
  return true;
}

pub fn CsvWriterRowCount(w: int64): int64 {
  if (_isW(w) == false) { return 0; }
  return _wg(w, W_ROWS);
}

// Felder in der noch offenen Zeile (0, wenn gerade keine offen ist)
pub fn CsvWriterPendingFields(w: int64): int64 {
  if (_isW(w) == false) { return 0; }
  return _wg(w, W_FIELDS);
}

pub fn CsvWriterLen(w: int64): int64 {
  if (_isW(w) == false) { return 0; }
  return _wg(w, W_LEN);
}

// Zeiger auf die gesammelten Bytes; gilt bis zum naechsten Schreibschritt
// (der Puffer kann wachsen) und bis CsvWriterFree. Der Inhalt ist mit einem
// Nullbyte abgeschlossen, damit er auch als pchar durchgereicht werden kann.
pub fn CsvWriterData(w: int64): int64 {
  if (_isW(w) == false) { return 0; }
  var buf: int64 := _wg(w, W_BUF);
  if (buf == 0) { return 0; }
  poke8(buf + _wg(w, W_LEN), 0);
  return buf;
}

// In eine Datei schreiben. Rueckgabe ist die Zahl der Bytes oder -1.
// Eine offene Zeile (Felder ohne CsvEndRow) wird abgelehnt, statt sie
// stillschweigend abzuschliessen -- sonst entscheidet der Schreiber, wo die
// Tabelle endet.
pub fn CsvWriterSave(w: int64, path: pchar): int64 {
  _csv_err := CSV_OK;
  if (_isW(w) == false) { _csv_err := CSV_E_ARGS; return -1; }
  if (path == 0 as pchar) { _csv_err := CSV_E_ARGS; return -1; }
  if (_wg(w, W_FIELDS) > 0) { _csv_err := CSV_E_EMPTYROW; return -1; }
  var len: int64 := _wg(w, W_LEN);
  if (len < 1) { _csv_err := CSV_E_FILE; return -1; }
  var buf: int64 := _wg(w, W_BUF);
  var n: int64 := WriteFile(path, buf as pchar, len);
  if (n != len) { _csv_err := CSV_E_FILE; return -1; }
  return n;
}

// Kurzform: eine f64-Matrix als Datei, mit Kopfzeile wenn names != 0.
pub fn CsvSaveMatrix(path: pchar, M: int64, rows: int64, cols: int64,
                     decimals: int64, sep: int64, names: int64): int64 {
  _csv_err := CSV_OK;
  var w: int64 := CsvWriterNew(sep, CSV_QUOTE_DOUBLE, false);
  if (w == 0) { return -1; }
  if (names != 0) {
    if (CsvWriteRowStrings(w, names, cols) == false) {
      CsvWriterFree(w);
      return -1;
    }
  }
  if (CsvWriteMatrix(w, M, rows, cols, decimals) == false) {
    CsvWriterFree(w);
    return -1;
  }
  var n: int64 := CsvWriterSave(w, path);
  CsvWriterFree(w);
  return n;
}
