// std/yaml - YAML Parser and Generator
// Read and write YAML configuration files
// Supports: scalars, sequences, mappings, anchors, aliases

@description("YAML parsing and serialization")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
@capabilities([fs.read, fs.write])
unit std.yaml;

import std.alloc;
import std.string;

// ============================================================================
// Constants
// ============================================================================

// YAML node types
con YAML_NULL: int64 := 0;
con YAML_BOOL: int64 := 1;
con YAML_INT: int64 := 2;
con YAML_FLOAT: int64 := 3;
con YAML_STRING: int64 := 4;
con YAML_SEQ: int64 := 5;      // sequence (array)
con YAML_MAP: int64 := 6;      // mapping (object)

// Error codes
con ERR_YAML_OK: int64 := 0;
con ERR_YAML_INVALID: int64 := 1;
con ERR_YAML_PARSE: int64 := 2;
con ERR_YAML_EOF: int64 := 3;
con ERR_YAML_INDENT: int64 := 4;
con ERR_YAML_TYPE: int64 := 5;

// ============================================================================
// Helper Functions
// ============================================================================

// Check if character is whitespace
fn isWhitespace(c: int64): bool {
    return c == 32 || c == 9;
}

// Check if character is line break
fn isLineBreak(c: int64): bool {
    return c == 10 || c == 13;
}

// Check if character is digit
fn isDigit(c: int64): bool {
    return c >= 48 && c <= 57;
}

// Check if character is alphabetic
fn isAlpha(c: int64): bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
}

// Find line end position
fn findLineEnd(s: pchar, pos: int64): int64 {
    while (StrCharAt(s, pos) != 0 &&
           StrCharAt(s, pos) != 10 &&
           StrCharAt(s, pos) != 13) {
        pos += 1;
    }
    return pos;
}

// Skip whitespace
fn skipWhitespace(s: pchar, pos: int64): int64 {
    while (isWhitespace(StrCharAt(s, pos))) {
        pos += 1;
    }
    return pos;
}

// Skip to next line
fn skipLine(s: pchar, pos: int64): int64 {
    while (StrCharAt(s, pos) != 0 && not isLineBreak(StrCharAt(s, pos))) {
        pos += 1;
    }
    while (isLineBreak(StrCharAt(s, pos))) {
        pos += 1;
    }
    return pos;
}

// Count indent level
fn countIndent(s: pchar, pos: int64): int64 {
    var indent: int64 := 0;
    while (isWhitespace(StrCharAt(s, pos))) {
        indent += 1;
        pos += 1;
    }
    return indent;
}

// Check if line is a comment
fn isComment(s: pchar, pos: int64): bool {
    var c: int64 := StrCharAt(s, pos);
    return c == 35;  // '#'
}

// Check if line is empty
fn isEmptyLine(s: pchar, pos: int64): bool {
    var c: int64 := StrCharAt(s, pos);
    return c == 0 || c == 10 || c == 13 || c == 35;
}

// ============================================================================
// Parsing
// ============================================================================

// Internal: scan for "key: value" at the top-level (indent=0).
// Returns position of value start, or -1 if not found.
// #1312: Pfadaufloesung ueber Ebenen.
//
// _yamlFindKey suchte den GESAMTEN Pfad als einen einzigen Schluesselnamen und
// nur auf oberster Ebene. "server.host" wurde also als Schluessel dieses Namens
// gesucht, den es nicht gibt — Get lieferte still die Vorgabe, HasPath false.
// Da eingerueckte Zeilen ausdruecklich uebersprungen wurden, war jede
// verschachtelte Struktur unerreichbar.
//
// Die Einrueckung ist in YAML die Struktur; hier wird sie entsprechend gelesen:
// je Pfadabschnitt wird der Schluessel auf der erwarteten Einrueckung gesucht,
// danach steigt die Suche in den Block darunter ab.

fn _yamlIndentAt(content: pchar, pos: int64, clen: int64): int64 {
    var n: int64 := 0;
    while (pos + n < clen) {
        var c: int64 := StrCharAt(content, pos + n);
        if (c == 32) { n := n + 1; } else { return n; }
    }
    return n;
}

fn _yamlLineEnd(content: pchar, pos: int64, clen: int64): int64 {
    var i: int64 := pos;
    while (i < clen && StrCharAt(content, i) != 10 && StrCharAt(content, i) != 13) { i := i + 1; }
    return i;
}

fn _yamlNextLine(content: pchar, pos: int64, clen: int64): int64 {
    var i: int64 := _yamlLineEnd(content, pos, clen);
    while (i < clen && (StrCharAt(content, i) == 10 || StrCharAt(content, i) == 13)) { i := i + 1; }
    return i;
}

// Sucht den Schluessel [segStart,segEnd) auf Einrueckung `indent` im Bereich
// [from,to). Liefert den Zeilenanfang, oder -1.
fn _yamlFindSegLine(content: pchar, clen: int64, fromPos: int64, toPos: int64,
                    path: pchar, segStart: int64, segEnd: int64, indent: int64): int64 {
    var seglen: int64 := segEnd - segStart;
    var pos: int64 := fromPos;
    while (pos < toPos) {
        var ind: int64 := _yamlIndentAt(content, pos, clen);
        var c: int64 := StrCharAt(content, pos + ind);
        var skip: int64 := 0;
        if (c == 35 || c == 10 || c == 13 || c == 0) { skip := 1; }
        if (ind < indent) { return 0 - 1; }   // Block zu Ende
        if (skip == 0 && ind == indent) {
            var pi: int64 := 0;
            while (pi < seglen && pos + ind + pi < clen &&
                   StrCharAt(content, pos + ind + pi) == StrCharAt(path, segStart + pi)) {
                pi := pi + 1;
            }
            if (pi == seglen) {
                var after: int64 := pos + ind + pi;
                while (after < clen && (StrCharAt(content, after) == 32 || StrCharAt(content, after) == 9)) {
                    after := after + 1;
                }
                if (after < clen && StrCharAt(content, after) == 58) { return pos; }
            }
        }
        pos := _yamlNextLine(content, pos, clen);
    }
    return 0 - 1;
}

// Liefert den Anfang des WERTES zum Pfad, oder -1.
// outLine, wenn != 0, bekommt den Zeilenanfang der Fundstelle.
fn _yamlFindPath(content: pchar, clen: int64, path: pchar, plen: int64, outLine: int64): int64 {
    var fromPos: int64 := 0;
    var toPos: int64 := clen;
    var indent: int64 := 0;
    var segStart: int64 := 0;

    while (segStart <= plen) {
        var segEnd: int64 := segStart;
        while (segEnd < plen && StrCharAt(path, segEnd) != 46) { segEnd := segEnd + 1; }
        if (segEnd == segStart) { return 0 - 1; }

        var line: int64 := _yamlFindSegLine(content, clen, fromPos, toPos, path, segStart, segEnd, indent);
        if (line < 0) { return 0 - 1; }

        var ind: int64 := _yamlIndentAt(content, line, clen);
        var after: int64 := line + ind + (segEnd - segStart);
        while (after < clen && (StrCharAt(content, after) == 32 || StrCharAt(content, after) == 9)) {
            after := after + 1;
        }
        if (after < clen && StrCharAt(content, after) == 58) { after := after + 1; }
        while (after < clen && (StrCharAt(content, after) == 32 || StrCharAt(content, after) == 9)) {
            after := after + 1;
        }

        if (segEnd >= plen) {
            if (outLine != 0) { poke64(outLine, line); }
            return after;
        }

        // Absteigen: der Block sind die folgenden Zeilen mit groesserer Einrueckung.
        var nl: int64 := _yamlNextLine(content, line, clen);
        if (nl >= clen) { return 0 - 1; }
        var childIndent: int64 := _yamlIndentAt(content, nl, clen);
        if (childIndent <= ind) { return 0 - 1; }
        var blockEnd: int64 := nl;
        var scan: int64 := nl;
        while (scan < clen) {
            var si: int64 := _yamlIndentAt(content, scan, clen);
            var sc: int64 := StrCharAt(content, scan + si);
            if (si < childIndent && sc != 10 && sc != 13 && sc != 0 && sc != 35) { scan := clen; }
            else { blockEnd := _yamlNextLine(content, scan, clen); scan := blockEnd; }
        }
        fromPos := nl;
        toPos := blockEnd;
        indent := childIndent;
        segStart := segEnd + 1;
    }
    return 0 - 1;
}

fn _yamlFindKey(content: pchar, clen: int64, path: pchar, plen: int64): int64 {
    return _yamlFindPath(content, clen, path, plen, 0);
}

fn _yamlFindKeyFlat(content: pchar, clen: int64, path: pchar, plen: int64): int64 {
    var pos: int64 := 0;
    while (pos < clen) {
        // Only match top-level keys (no leading indent)
        var c: int64 := StrCharAt(content, pos);
        if (c == 35 || c == 10 || c == 13 || c == 0) {
            // comment or blank line — skip
        } else if (c == 32 || c == 9) {
            // indented line — skip (nested content)
        } else if (c == 45 && StrCharAt(content, pos + 1) == 45 && StrCharAt(content, pos + 2) == 45) {
            // "---" document marker — skip line
        } else {
            var pi: int64 := 0;
            while (pi < plen && pos + pi < clen && StrCharAt(content, pos + pi) == StrCharAt(path, pi)) {
                pi += 1;
            }
            if (pi == plen) {
                var after: int64 := pos + pi;
                while (after < clen && (StrCharAt(content, after) == 32 || StrCharAt(content, after) == 9)) {
                    after += 1;
                }
                if (after < clen && StrCharAt(content, after) == 58) {  // ':'
                    after += 1;
                    while (after < clen && (StrCharAt(content, after) == 32 || StrCharAt(content, after) == 9)) {
                        after += 1;
                    }
                    return after;
                }
            }
        }
        while (pos < clen && StrCharAt(content, pos) != 10 && StrCharAt(content, pos) != 13) {
            pos += 1;
        }
        while (pos < clen && (StrCharAt(content, pos) == 10 || StrCharAt(content, pos) == 13)) {
            pos += 1;
        }
    }
    return -1;
}

// Parse YAML string — copies input into a heap buffer, returned as doc handle.
pub fn ParseString(input: pchar): int64 {
    if (input == 0) { return 0; }
    var len: int64 := StrLen(input);
    // #1312: Hier stand alloc(len + 1). Der Schreibweg (_yamlSetKey) legt das
    // geaenderte Dokument in denselben Puffer zurueck und nimmt laut eigenem
    // Kommentar 65536 Byte an — so gross legt auch LoadFile an. Ein per
    // ParseString erzeugtes Dokument war damit zu klein: schon eine
    // Wertaenderung gleicher Laenge schrieb ueber das Ende hinaus, und
    // Zurueckgelesenes war verstuemmelt ("example.oex" statt "example.org").
    var YAML_BUF: int64 := 65536;
    if (len + 1 > YAML_BUF) { return 0; }
    var buf: pchar := alloc(YAML_BUF) as pchar;
    if (buf == 0) { return 0; }
    var i: int64 := 0;
    while (i < len) {
        StrSetChar(buf, i, StrCharAt(input, i));
        i += 1;
    }
    StrSetChar(buf, len, 0);
    return buf as int64;
}

// Get value as string (flat top-level key lookup).
pub fn GetString(doc: int64, path: pchar, default_val: pchar): pchar {
    if (doc == 0 || path == 0) { return default_val; }
    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var plen: int64 := StrLen(path);
    var vstart: int64 := _yamlFindKey(content, clen, path, plen);
    if (vstart < 0) { return default_val; }
    // Find value end: stop at newline, comment, or NUL
    var vend: int64 := vstart;
    var sc: int64 := 1;
    while (sc == 1 && vend < clen) {
        var vc: int64 := StrCharAt(content, vend);
        if (vc == 10 || vc == 13 || vc == 0 || vc == 35) { sc := 0; }
        else { vend := vend + 1; }
    }
    // Trim trailing whitespace
    while (vend > vstart && (StrCharAt(content, vend - 1) == 32 || StrCharAt(content, vend - 1) == 9)) {
        vend -= 1;
    }
    var vlen: int64 := vend - vstart;
    if (vlen <= 0) { return default_val; }
    var result: pchar := alloc(vlen + 1) as pchar;
    var ri: int64 := 0;
    while (ri < vlen) {
        StrSetChar(result, ri, StrCharAt(content, vstart + ri));
        ri += 1;
    }
    StrSetChar(result, vlen, 0);
    return result;
}

// Get value as integer
pub fn GetInt(doc: int64, path: pchar, default_val: int64): int64 {
    if (doc == 0 || path == 0) { return default_val; }
    var val: pchar := GetString(doc, path, "");
    if (val == 0 || StrCharAt(val, 0) == 0) { return default_val; }
    var result: int64 := 0;
    var neg: int64 := 0;
    var pos: int64 := 0;
    if (StrCharAt(val, 0) == 45) { neg := 1; pos := 1; }
    while (StrCharAt(val, pos) >= 48 && StrCharAt(val, pos) <= 57) {
        result := result * 10 + (StrCharAt(val, pos) - 48);
        pos += 1;
    }
    if (neg == 1) { result := 0 - result; }
    return result;
}

// Get value as float
pub fn GetFloat(doc: int64, path: pchar, default_val: f64): f64 {
    if (doc == 0 || path == 0) { return default_val; }
    var val: pchar := GetString(doc, path, "");
    if (val == 0 || StrCharAt(val, 0) == 0) { return default_val; }
    return ParseYamlFloat(val);
}

// Get value as boolean (true/yes/on/1 → true)
pub fn GetBool(doc: int64, path: pchar, default_val: bool): bool {
    if (doc == 0 || path == 0) { return default_val; }
    var val: pchar := GetString(doc, path, "");
    if (val == 0 || StrCharAt(val, 0) == 0) { return default_val; }
    var first: int64 := StrCharAt(val, 0);
    if (first == 116 || first == 84 || first == 121 || first == 89 || first == 49) { return true; }
    if (first == 111 || first == 79) { return true; }
    return false;
}

// Get value as array (sequence)
pub fn GetArray(doc: int64, path: pchar): int64 {
    if (doc == 0) { return 0; }
    return 0;
}

// Get value as object (mapping)
pub fn GetObject(doc: int64, path: pchar): int64 {
    if (doc == 0) { return 0; }
    return 0;
}

// ============================================================================
// Writing
// ============================================================================

// Write YAML document to string (copies raw content)
pub fn WriteString(doc: int64, output: pchar, max_len: int64): int64 {
    if (doc == 0 || output == 0 || max_len <= 0) { return -1; }
    var content: pchar := doc as pchar;
    var len: int64 := StrLen(content);
    if (len >= max_len) { len := max_len - 1; }
    var i: int64 := 0;
    while (i < len) {
        StrSetChar(output, i, StrCharAt(content, i));
        i += 1;
    }
    StrSetChar(output, len, 0);
    return len;
}

// Write YAML doc (raw text) to file
pub fn WriteFile(doc: int64, path: pchar): bool {
    if (doc == 0 || path == 0) { return false; }
    var content: pchar := doc as pchar;
    var len: int64 := StrLen(content);
    if (len == 0) { return false; }
    var fd: int64 := open(path, 577, 420);  // O_WRONLY|O_CREAT|O_TRUNC=577, mode 0644=420
    if (fd < 0) { return false; }
    var total: int64 := 0;
    var running: int64 := 1;
    while (running == 1 && total < len) {
        var n: int64 := write(fd, content + total, len - total);
        if (n <= 0) { running := 0; }
        else { total := total + n; }
    }
    close(fd);
    return total == len;
}

// ============================================================================
// Modification
// ============================================================================

// #1312: Schreibt einen verschachtelten Pfad. Liefert 1, wenn zustaendig und
// erledigt, sonst 0 (dann uebernimmt der flache Weg).
//
// Vorhandener Pfad: die gefundene Zeile wird durch "<Einrueckung><letzter
// Abschnitt>: <Wert>" ersetzt, die Einrueckung also beibehalten.
// Fehlender Pfad: die fehlenden Ebenen werden am Ende angelegt, je Ebene zwei
// Leerzeichen tiefer — dieselbe Schreibweise, die der Leseweg erwartet.
fn _yamlSetNested(doc: int64, path: pchar, value_str: pchar): int64 {
    var plen: int64 := StrLen(path);
    var hasDot: int64 := 0;
    var i: int64 := 0;
    while (i < plen) { if (StrCharAt(path, i) == 46) { hasDot := 1; } i := i + 1; }
    if (hasDot == 0) { return 0; }

    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var vlen: int64 := StrLen(value_str);
    var BUF: int64 := 65536;
    var lineBox: int64 := alloc(8);
    poke64(lineBox, 0 - 1);
    var vstart: int64 := _yamlFindPath(content, clen, path, plen, lineBox);
    var line: int64 := peek64(lineBox);
    free(lineBox, 8);

    var tmp: int64 := alloc(BUF);
    if (tmp == 0) { return 1; }
    var out: int64 := 0;

    // letzter Abschnitt des Pfades
    var lastStart: int64 := 0;
    i := 0;
    while (i < plen) { if (StrCharAt(path, i) == 46) { lastStart := i + 1; } i := i + 1; }

    if (vstart >= 0) {
        var ind: int64 := _yamlIndentAt(content, line, clen);
        var j: int64 := 0;
        while (j < line && out < BUF - 1) { poke8(tmp + out, StrCharAt(content, j)); out := out + 1; j := j + 1; }
        var k: int64 := 0;
        while (k < ind && out < BUF - 1) { poke8(tmp + out, 32); out := out + 1; k := k + 1; }
        var si: int64 := lastStart;
        while (si < plen && out < BUF - 1) { poke8(tmp + out, StrCharAt(path, si)); out := out + 1; si := si + 1; }
        if (out < BUF - 1) { poke8(tmp + out, 58); out := out + 1; }
        if (out < BUF - 1) { poke8(tmp + out, 32); out := out + 1; }
        var vi: int64 := 0;
        while (vi < vlen && out < BUF - 1) { poke8(tmp + out, StrCharAt(value_str, vi)); out := out + 1; vi := vi + 1; }
        if (out < BUF - 1) { poke8(tmp + out, 10); out := out + 1; }
        var rest: int64 := _yamlNextLine(content, line, clen);
        while (rest < clen && out < BUF - 1) { poke8(tmp + out, StrCharAt(content, rest)); out := out + 1; rest := rest + 1; }
    } else {
        var j2: int64 := 0;
        while (j2 < clen && out < BUF - 1) { poke8(tmp + out, StrCharAt(content, j2)); out := out + 1; j2 := j2 + 1; }
        if (out > 0 && peek8(tmp + out - 1) != 10 && out < BUF - 1) { poke8(tmp + out, 10); out := out + 1; }
        // fehlende Ebenen anlegen
        var segStart: int64 := 0;
        var depth: int64 := 0;
        while (segStart <= plen) {
            var segEnd: int64 := segStart;
            while (segEnd < plen && StrCharAt(path, segEnd) != 46) { segEnd := segEnd + 1; }
            var sp: int64 := 0;
            while (sp < depth * 2 && out < BUF - 1) { poke8(tmp + out, 32); out := out + 1; sp := sp + 1; }
            var ci: int64 := segStart;
            while (ci < segEnd && out < BUF - 1) { poke8(tmp + out, StrCharAt(path, ci)); out := out + 1; ci := ci + 1; }
            if (out < BUF - 1) { poke8(tmp + out, 58); out := out + 1; }
            if (segEnd >= plen) {
                if (out < BUF - 1) { poke8(tmp + out, 32); out := out + 1; }
                var vj: int64 := 0;
                while (vj < vlen && out < BUF - 1) { poke8(tmp + out, StrCharAt(value_str, vj)); out := out + 1; vj := vj + 1; }
            }
            if (out < BUF - 1) { poke8(tmp + out, 10); out := out + 1; }
            if (segEnd >= plen) { segStart := plen + 1; }
            else { segStart := segEnd + 1; depth := depth + 1; }
        }
    }
    poke8(tmp + out, 0);
    var w: int64 := 0;
    while (w <= out) { poke8(doc + w, peek8(tmp + w)); w := w + 1; }
    free(tmp, BUF);
    return 1;
}

// Internal: replace or append "path: value_str\n" in the doc buffer.
// The doc buffer is assumed to be 65536 bytes (from LoadFile/ParseString).
fn _yamlSetKey(doc: int64, path: pchar, value_str: pchar): void {
    if (doc == 0 || path == 0 || value_str == 0) { return; }
    // #1312: Bei einem Pfad mit Punkt legte der Weg unten einen Schluessel
    // WOERTLICH dieses Namens an ("server.host: …" auf oberster Ebene), statt in
    // die Struktur zu schreiben. Ein anschliessendes Get fand weiterhin den
    // alten Wert — die Aenderung war also spurlos verpufft, ohne Meldung.
    if (_yamlSetNested(doc, path, value_str) != 0) { return; }
    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var plen: int64 := StrLen(path);
    var vlen: int64 := StrLen(value_str);
    var BUF: int64 := 65536;
    var tmp: int64 := alloc(BUF);
    if (tmp == 0) { return; }
    var out: int64 := 0;
    var pos: int64 := 0;
    var found: bool := false;
    while (pos < clen) {
        var c0: int64 := StrCharAt(content, pos);
        var isMatch: bool := false;
        if (c0 != 32 && c0 != 9 && c0 != 35 && c0 != 10 && c0 != 13 && c0 != 0 && !found) {
            var pi: int64 := 0;
            var ok: bool := true;
            while (pi < plen && ok) {
                if (StrCharAt(content, pos + pi) != StrCharAt(path, pi)) { ok := false; }
                else { pi := pi + 1; }
            }
            if (ok) {
                var after: int64 := pos + plen;
                while (StrCharAt(content, after) == 32 || StrCharAt(content, after) == 9) {
                    after += 1;
                }
                if (StrCharAt(content, after) == 58) { isMatch := true; }
            }
        }
        if (isMatch) {
            found := true;
            var ki: int64 := 0;
            while (ki < plen && out < BUF - 1) {
                poke8(tmp + out, StrCharAt(path, ki)); out := out + 1; ki := ki + 1;
            }
            if (out < BUF - 1) { poke8(tmp + out, 58); out := out + 1; }
            if (out < BUF - 1) { poke8(tmp + out, 32); out := out + 1; }
            var vi: int64 := 0;
            while (vi < vlen && out < BUF - 1) {
                poke8(tmp + out, StrCharAt(value_str, vi)); out := out + 1; vi := vi + 1;
            }
            if (out < BUF - 1) { poke8(tmp + out, 10); out := out + 1; }
            while (pos < clen && StrCharAt(content, pos) != 10 && StrCharAt(content, pos) != 13) {
                pos += 1;
            }
            while (pos < clen && (StrCharAt(content, pos) == 10 || StrCharAt(content, pos) == 13)) {
                pos += 1;
            }
        } else {
            while (pos < clen && StrCharAt(content, pos) != 10 && StrCharAt(content, pos) != 13) {
                if (out < BUF - 1) { poke8(tmp + out, StrCharAt(content, pos)); out := out + 1; }
                pos += 1;
            }
            while (pos < clen && (StrCharAt(content, pos) == 10 || StrCharAt(content, pos) == 13)) {
                if (out < BUF - 1) { poke8(tmp + out, StrCharAt(content, pos)); out := out + 1; }
                pos += 1;
            }
        }
    }
    if (!found) {
        var ki: int64 := 0;
        while (ki < plen && out < BUF - 1) {
            poke8(tmp + out, StrCharAt(path, ki)); out := out + 1; ki := ki + 1;
        }
        if (out < BUF - 1) { poke8(tmp + out, 58); out := out + 1; }
        if (out < BUF - 1) { poke8(tmp + out, 32); out := out + 1; }
        var vi: int64 := 0;
        while (vi < vlen && out < BUF - 1) {
            poke8(tmp + out, StrCharAt(value_str, vi)); out := out + 1; vi := vi + 1;
        }
        if (out < BUF - 1) { poke8(tmp + out, 10); out := out + 1; }
    }
    poke8(tmp + out, 0);
    var i: int64 := 0;
    while (i <= out) { poke8(doc + i, peek8(tmp + i)); i := i + 1; }
    free(tmp, BUF);
}

// Set string value
pub fn SetString(doc: int64, path: pchar, value: pchar): void {
    _yamlSetKey(doc, path, value);
}

// Set integer value
pub fn SetInt(doc: int64, path: pchar, value: int64): void {
    if (doc == 0 || path == 0) { return; }
    _yamlSetKey(doc, path, IntToStr(value));
}

// Set float value — 6 decimal places
pub fn SetFloat(doc: int64, path: pchar, value: f64): void {
    if (doc == 0 || path == 0) { return; }
    var buf: int64 := alloc(64);
    if (buf == 0) { return; }
    var bpos: int64 := 0;
    var v: f64 := value;
    if (v < 0.0) { poke8(buf + bpos, 45); bpos := bpos + 1; v := 0.0 - v; }
    var ipart: int64 := v as int64;
    var ipf: f64 := ipart as f64;
    var fpart: f64 := v - ipf;
    var istr: pchar := IntToStr(ipart);
    var ilen: int64 := StrLen(istr);
    var ii: int64 := 0;
    while (ii < ilen && bpos < 60) { poke8(buf + bpos, StrCharAt(istr, ii)); bpos := bpos + 1; ii := ii + 1; }
    if (bpos < 60) { poke8(buf + bpos, 46); bpos := bpos + 1; }
    var d: int64 := 0;
    while (d < 6 && bpos < 60) {
        fpart := fpart * 10.0;
        var digit: int64 := fpart as int64;
        poke8(buf + bpos, digit + 48); bpos := bpos + 1;
        var digitF: f64 := digit as f64;
        fpart -= digitF;
        d += 1;
    }
    poke8(buf + bpos, 0);
    _yamlSetKey(doc, path, buf as pchar);
    free(buf, 64);
}

// Set boolean value
pub fn SetBool(doc: int64, path: pchar, value: bool): void {
    if (doc == 0 || path == 0) { return; }
    if (value) { _yamlSetKey(doc, path, "true"); }
    else { _yamlSetKey(doc, path, "false"); }
}

