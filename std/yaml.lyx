// Escape string for YAML
pub fn EscapeString(input: pchar, output: pchar): int64 {
    if (input == 0 || output == 0) { return 0; }
    
    var in_pos: int64 := 0;
    var out_pos: int64 := 0;
    
    while (StrCharAt(input, in_pos) != 0) {
        var c: int64 := StrCharAt(input, in_pos);
        
        // Handle special characters that need escaping in YAML
        if (c == 92) {  // backslash
            StrSetChar(output, out_pos, 92); out_pos := out_pos + 1;
            StrSetChar(output, out_pos, 92); out_pos := out_pos + 1;
        } else if (c == 34) {  // double quote
            StrSetChar(output, out_pos, 92); out_pos := out_pos + 1;
            StrSetChar(output, out_pos, 34); out_pos := out_pos + 1;
        } else if (c == 10) {  // newline
            StrSetChar(output, out_pos, 92); out_pos := out_pos + 1;
            StrSetChar(output, out_pos, 110); out_pos := out_pos + 1;
        } else if (c == 13) {  // carriage return
            StrSetChar(output, out_pos, 92); out_pos := out_pos + 1;
            StrSetChar(output, out_pos, 114); out_pos := out_pos + 1;
        } else if (c == 9) {  // tab
            StrSetChar(output, out_pos, 92); out_pos := out_pos + 1;
            StrSetChar(output, out_pos, 116); out_pos := out_pos + 1;
        } else {
            StrSetChar(output, out_pos, c); out_pos := out_pos + 1;
        }
        
        in_pos += 1;
    }
    
    StrSetChar(output, out_pos, 0);
    return out_pos;
}

// Unescape YAML string
pub fn UnescapeString(input: pchar, output: pchar): int64 {
    if (input == 0 || output == 0) { return 0; }
    
    var in_pos: int64 := 0;
    var out_pos: int64 := 0;
    
    while (StrCharAt(input, in_pos) != 0) {
        var c: int64 := StrCharAt(input, in_pos);
        
        if (c == 92) {  // escape sequence
            var next: int64 := StrCharAt(input, in_pos + 1);
            if (next == 92) {
                StrSetChar(output, out_pos, 92); out_pos := out_pos + 1;
            } else if (next == 34) {
                StrSetChar(output, out_pos, 34); out_pos := out_pos + 1;
            } else if (next == 110) {
                StrSetChar(output, out_pos, 10); out_pos := out_pos + 1;
            } else if (next == 114) {
                StrSetChar(output, out_pos, 13); out_pos := out_pos + 1;
            } else if (next == 116) {
                StrSetChar(output, out_pos, 9); out_pos := out_pos + 1;
            }
            in_pos += 2;
        } else {
            StrSetChar(output, out_pos, c); out_pos := out_pos + 1;
            in_pos += 1;
        }
    }
    
    StrSetChar(output, out_pos, 0);
    return out_pos;
}

// ============================================================================
// Type Conversion
// ============================================================================

// Parse YAML string to int64
pub fn ParseYamlInt(s: pchar): int64 {
    if (s == 0) { return 0; }
    
    var i: int64 := 0;
    var negative: bool := false;
    var value: int64 := 0;
    
    // Handle sign
    if (StrCharAt(s, 0) == 45) {  // '-'
        negative := true;
        i += 1;
    }
    
    // Parse digits
    while (isDigit(StrCharAt(s, i))) {
        value := value * 10 + (StrCharAt(s, i) - 48);
        i += 1;
    }
    
    if (negative) { value := -value; }
    return value;
}

// Parse YAML string to bool
pub fn ParseYamlBool(s: pchar): bool {
    if (s == 0) { return false; }
    
    var first: int64 := StrCharAt(s, 0);
    
    // true values: true, yes, on, 1
    if (first == 116 || first == 84 || first == 121 || first == 89 || first == 111 || first == 49) {
        return true;
    }
    
    // false values: false, no, off, 0
    return false;
}

// Parse YAML string to float ("±integer.fraction")
pub fn ParseYamlFloat(s: pchar): f64 {
    if (s == 0) { return 0.0; }
    var neg: bool := false;
    var pos: int64 := 0;
    if (StrCharAt(s, 0) == 45) { neg := true; pos := 1; }
    var int_part: f64 := 0.0;
    while (isDigit(StrCharAt(s, pos))) {
        var d: int64 := StrCharAt(s, pos) - 48;
        var df: f64 := d as f64;
        int_part := int_part * 10.0 + df;
        pos += 1;
    }
    var frac_part: f64 := 0.0;
    if (StrCharAt(s, pos) == 46) {
        pos += 1;
        var scale: f64 := 0.1;
        while (isDigit(StrCharAt(s, pos))) {
            var d: int64 := StrCharAt(s, pos) - 48;
            var df: f64 := d as f64;
            frac_part := frac_part + df * scale;
            scale := scale / 10.0;
            pos += 1;
        }
    }
    var result: f64 := int_part + frac_part;
    if (neg) { result := 0.0 - result; }
    return result;
}

// ============================================================================
// Validation
// ============================================================================

// Check if string is valid YAML identifier
pub fn IsValidKey(s: pchar): bool {
    if (s == 0) { return false; }
    
    var i: int64 := 0;
    while (StrCharAt(s, i) != 0) {
        var c: int64 := StrCharAt(s, i);
        
        // Allow: alphanumeric, underscore, hyphen
        var valid: bool := false;
        if (c >= 65 && c <= 90) { valid := true; }      // A-Z
        if (c >= 97 && c <= 122) { valid := true; }     // a-z
        if (c >= 48 && c <= 57) { valid := true; }      // 0-9
        if (c == 95 || c == 45) { valid := true; }      // _ -
        
        if not valid { return false; }
        i += 1;
    }
    
    return true;
}

// Check if string needs quoting in YAML
pub fn NeedsQuoting(s: pchar): bool {
    if (s == 0) { return true; }
    
    var i: int64 := 0;
    while (StrCharAt(s, i) != 0) {
        var c: int64 := StrCharAt(s, i);
        
        // Needs quoting if contains: colon, hash, special chars
        if (c == 58 || c == 35 || c == 91 || c == 93 || c == 123 || c == 125 ||
            c == 44 || c == 38 || c == 42 || c == 33 || c == 124) {
            return true;
        }
        
        // Needs quoting if starts with special characters
        if (i == 0 && (c == 45 || c == 46 || c == 39 || c == 34 || c == 64 || c == 33)) {
            return true;
        }
        
        i += 1;
    }
    
    return false;
}