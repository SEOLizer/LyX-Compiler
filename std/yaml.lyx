// Load YAML from file — returns doc handle, or 0 on error.
pub fn LoadFile(path: pchar): int64 {
    if (path == 0) { return 0; }
    var fd: int64 := open(path, 0, 0);  // O_RDONLY
    if (fd < 0) { return 0; }
    var YAML_BUF: int64 := 65536;
    var buf: pchar := alloc(YAML_BUF) as pchar;
    if (buf == 0) { close(fd); return 0; }
    var total: int64 := 0;
    var running: int64 := 1;
    while (running == 1 && total < YAML_BUF - 1) {
        var n: int64 := read(fd, buf + total, YAML_BUF - 1 - total);
        if (n <= 0) { running := 0; }
        else { total := total + n; }
    }
    close(fd);
    StrSetChar(buf, total, 0);
    return buf as int64;
}

// Save YAML doc (raw text) to file — returns true on success.
pub fn SaveFile(doc: int64, path: pchar): bool {
    return WriteFile(doc, path);
}

// Check if path exists
pub fn HasPath(doc: int64, path: pchar): bool {
    if (doc == 0 || path == 0) { return false; }
    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var plen: int64 := StrLen(path);
    return _yamlFindKey(content, clen, path, plen) >= 0;
}

// Get type of value at path
pub fn GetType(doc: int64, path: pchar): int64 {
    if (doc == 0 || path == 0) { return YAML_NULL; }
    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var plen: int64 := StrLen(path);
    var vstart: int64 := _yamlFindKey(content, clen, path, plen);
    if (vstart < 0) { return YAML_NULL; }
    var first: int64 := StrCharAt(content, vstart);
    if (first == 0 || first == 10 || first == 13) { return YAML_NULL; }
    if (first == 116 || first == 84 || first == 102 || first == 70 ||
        first == 121 || first == 89 || first == 110 || first == 78) {
        return YAML_BOOL;
    }
    if (isDigit(first) || first == 45) {
        var p: int64 := vstart;
        var hasDot: bool := false;
        while (p < clen && StrCharAt(content, p) != 10 && StrCharAt(content, p) != 13 && StrCharAt(content, p) != 0) {
            if (StrCharAt(content, p) == 46) { hasDot := true; }
            p += 1;
        }
        if (hasDot) { return YAML_FLOAT; }
        return YAML_INT;
    }
    return YAML_STRING;
}

// Get all top-level keys; writes consecutive null-terminated strings into output.
// Returns number of keys found (up to max_count).
pub fn GetKeys(doc: int64, path: pchar, output: pchar, max_count: int64): int64 {
    if (doc == 0 || output == 0 || max_count <= 0) { return 0; }
    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var count: int64 := 0;
    var pos: int64 := 0;
    var outPos: int64 := 0;
    while (pos < clen && count < max_count) {
        var c0: int64 := StrCharAt(content, pos);
        if (c0 != 32 && c0 != 9 && c0 != 35 && c0 != 10 && c0 != 13 && c0 != 0 &&
            !(c0 == 45 && StrCharAt(content, pos + 1) == 45 && StrCharAt(content, pos + 2) == 45)) {
            var kp: int64 := pos;
            var hasColon: bool := false;
            while (kp < clen && StrCharAt(content, kp) != 10 && StrCharAt(content, kp) != 13 && StrCharAt(content, kp) != 0 && !hasColon) {
                if (StrCharAt(content, kp) == 58) { hasColon := true; }
                else { kp := kp + 1; }
            }
            if (hasColon) {
                var kend: int64 := pos;
                while (kend < clen && StrCharAt(content, kend) != 58 && StrCharAt(content, kend) != 10 && StrCharAt(content, kend) != 13) {
                    StrSetChar(output, outPos, StrCharAt(content, kend));
                    outPos += 1; kend := kend + 1;
                }
                while (outPos > 0 && (StrCharAt(output, outPos - 1) == 32 || StrCharAt(output, outPos - 1) == 9)) {
                    outPos -= 1;
                }
                StrSetChar(output, outPos, 0);
                outPos += 1;
                count += 1;
            }
        }
        while (pos < clen && StrCharAt(content, pos) != 10 && StrCharAt(content, pos) != 13) {
            pos += 1;
        }
        while (pos < clen && (StrCharAt(content, pos) == 10 || StrCharAt(content, pos) == 13)) {
            pos += 1;
        }
    }
    return count;
}

// Get array length — counts indented "- " lines immediately after the key.
pub fn GetArrayLen(doc: int64, path: pchar): int64 {
    if (doc == 0 || path == 0) { return 0; }
    var content: pchar := doc as pchar;
    var clen: int64 := StrLen(content);
    var plen: int64 := StrLen(path);
    var vstart: int64 := _yamlFindKey(content, clen, path, plen);
    if (vstart < 0) { return 0; }
    var pos: int64 := vstart;
    while (pos < clen && StrCharAt(content, pos) != 10 && StrCharAt(content, pos) != 13) {
        pos += 1;
    }
    while (pos < clen && (StrCharAt(content, pos) == 10 || StrCharAt(content, pos) == 13)) {
        pos += 1;
    }
    var count: int64 := 0;
    var scanning: bool := true;
    while (pos < clen && scanning) {
        var c0: int64 := StrCharAt(content, pos);
        if (c0 == 32 || c0 == 9) {
            var ip: int64 := pos;
            while (ip < clen && (StrCharAt(content, ip) == 32 || StrCharAt(content, ip) == 9)) {
                ip += 1;
            }
            if (StrCharAt(content, ip) == 45 && (StrCharAt(content, ip + 1) == 32 || StrCharAt(content, ip + 1) == 9)) {
                count += 1;
            }
            while (pos < clen && StrCharAt(content, pos) != 10 && StrCharAt(content, pos) != 13) {
                pos += 1;
            }
            while (pos < clen && (StrCharAt(content, pos) == 10 || StrCharAt(content, pos) == 13)) {
                pos += 1;
            }
        } else {
            scanning := false;
        }
    }
    return count;
}

