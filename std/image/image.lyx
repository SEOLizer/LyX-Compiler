// std/image/image.lyx — GRF-08: Unified Image API (Facade)
// Dispatches decode to the appropriate format handler.

@description("Unified image API: auto-detect format, decode BMP/PNG/JPEG/GIF/TIFF/WebP/AVIF")
@author("Andreas Röne")
@copyright("2025-2026 Andreas Röne")
@capabilities([fs.create, fs.delete, fs.meta, fs.perm, fs.read, fs.write, system.time])
unit std.image.image;

import std.image.core;
import std.image.bmp;
import std.image.png;
import std.image.jpeg;
import std.image.gif;
import std.image.tiff;
import std.image.webp;
import std.image.avif;
import std.alloc;
import std.fs;

// ============================================================================
// ImageDecodeFromMem — decode from memory buffer, auto-detect format
// Returns 1 on success (img filled with pixel data), 0 on error.
// ============================================================================

pub fn ImageDecodeFromMem(buf: int64, len: int64, img: int64): int64 {
    var fmt: int64 := GrfDetectFormat(buf, len);
    if (fmt == GRF_FMT_BMP)  { return BmpDecode(buf, len, img); }
    if (fmt == GRF_FMT_PNG)  { return PngDecode(buf, len, img); }
    if (fmt == GRF_FMT_JPEG) { return JpegDecode(buf, len, img); }
    if (fmt == GRF_FMT_GIF)  { return GifDecode(buf, len, img); }
    if (fmt == GRF_FMT_TIFF) { return TiffDecode(buf, len, img); }
    if (fmt == GRF_FMT_WEBP) { return WebpDecode(buf, len, img); }
    if (fmt == GRF_FMT_AVIF) { return AvifDecode(buf, len, img); }
    return 0;
}

// ============================================================================
// ImageDecode — decode from file path, auto-detect format
// ============================================================================

pub fn ImageDecode(path: pchar, plen: int64, img: int64): int64 {
  var pathAdr: int64 := path as int64;   // #1613
    var fsize: int64 := FileSize(pathAdr);
    if (fsize <= 0) { return 0; }
    var buf: int64 := alloc(fsize);
    if (buf == 0) { return 0; }
    var n: int64 := ReadFile(pathAdr as pchar, buf as pchar, fsize);
    var ret: int64 := 0;
    if (n == fsize) {
        ret := ImageDecodeFromMem(buf, fsize, img);
        if (plen != 0) { poke64(plen, fsize); }
    }
    free(buf, fsize);
    return ret;
}

// ============================================================================
// Convenience accessors
// ============================================================================

pub fn ImageFree(img: int64): void {
    GrfImageFree(img);
}

pub fn ImageGetWidth(img: int64): int64 {
    return peek64(img + GRF_OFF_WIDTH);
}

pub fn ImageGetHeight(img: int64): int64 {
    return peek64(img + GRF_OFF_HEIGHT);
}

pub fn ImageGetChannels(img: int64): int64 {
    return peek64(img + GRF_OFF_CHANNELS);
}

pub fn ImagePixelAt(img: int64, x: int64, y: int64): int64 {
    return GrfImageGetPixel(img, x, y);
}
