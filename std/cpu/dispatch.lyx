// std/cpu/dispatch.lyx
// WP-GPU-02: Runtime dispatch tables for SIMD-accelerated operations.
// Selects SSE2 / SSE4.1 / scalar implementation based on detected CPU features.

@description("Runtime SIMD dispatch: scalar / SSE2 / AVX2 selection")
@author("Andreas Röne")
@copyright("2025 Andreas Röne")
@capabilities([fs.read])
unit std.cpu.dispatch;

// #1585: Bis 1.1.0A war KEINE der dreizehn Funktionen `pub`. Die Unit liess
// sich importieren, aber nichts daraus benutzen — die Wiki-Seite
// units/cpu/dispatch.txt beschreibt sie als oeffentliche SIMD-Schnittstelle,
// und deren Beispiele scheiterten alle an "ist nicht pub". Ein Scan ueber
// std/ fand genau zwei Units mit mehr als drei Funktionen und null Exporten;
// die andere (android/zip_writer.lyx) ist plausibel ein interner Helfer.

import std.cpu.features;
import std.alloc;

// ============================================================================
// Dispatch level constants
// ============================================================================
con CPU_DISPATCH_SCALAR: int64 := 0;
con CPU_DISPATCH_SSE2:   int64 := 1;
con CPU_DISPATCH_AVX2:   int64 := 2;

// Cached dispatch level (-1 = not yet selected)
var dispatchLevel: int64 := -1;

// Return the best available dispatch level for the current CPU.
pub fn CpuDispatchLevel(): int64 {
  if (dispatchLevel >= 0) { return dispatchLevel; }
  var feats: int64 := CpuFeatureDetect();
  if ((feats & CPU_FEAT_AVX2) != 0) {
    dispatchLevel := CPU_DISPATCH_AVX2;
  } else if ((feats & CPU_FEAT_SSE2) != 0) {
    dispatchLevel := CPU_DISPATCH_SSE2;
  } else {
    dispatchLevel := CPU_DISPATCH_SCALAR;
  }
  return dispatchLevel;
}

// ============================================================================
// Scalar f32 array operations (fallback, no SIMD)
// ============================================================================

// Add two f32 arrays element-wise into dst. dst must be pre-allocated (n elements).
pub fn SimdAddScalar(src1: int64, src2: int64, dst: int64, n: int64) {
  var i: int64 := 0;
  while (i < n) {
    var a: int64 := peek32(src1 + i * 4) as int64;  // raw f32 bits
    var b: int64 := peek32(src2 + i * 4) as int64;
    // Scalar f32 add: reinterpret as f64, add, reinterpret back
    var af: f64 := a as f64;
    var bf: f64 := b as f64;
    var rf: f64 := af + bf;
    var r: int64 := rf as int64;
    poke32(dst + i * 4, r);
    i += 1;
  }
}

pub fn SimdSubScalar(src1: int64, src2: int64, dst: int64, n: int64) {
  var i: int64 := 0;
  while (i < n) {
    var a: f64 := (peek32(src1 + i * 4) as int64) as f64;
    var b: f64 := (peek32(src2 + i * 4) as int64) as f64;
    var r: int64 := (a - b) as int64;
    poke32(dst + i * 4, r);
    i += 1;
  }
}

pub fn SimdMulScalar(src1: int64, src2: int64, dst: int64, n: int64) {
  var i: int64 := 0;
  while (i < n) {
    var a: f64 := (peek32(src1 + i * 4) as int64) as f64;
    var b: f64 := (peek32(src2 + i * 4) as int64) as f64;
    var r: int64 := (a * b) as int64;
    poke32(dst + i * 4, r);
    i += 1;
  }
}

pub fn SimdDivScalar(src1: int64, src2: int64, dst: int64, n: int64) {
  var i: int64 := 0;
  while (i < n) {
    var a: f64 := (peek32(src1 + i * 4) as int64) as f64;
    var b: f64 := (peek32(src2 + i * 4) as int64) as f64;
    var r: int64 := (a / b) as int64;
    poke32(dst + i * 4, r);
    i += 1;
  }
}

// ============================================================================
// Dispatched API — automatically selects best implementation
// ============================================================================

// Allocate a new f32 SIMD array (n elements, 16-byte aligned via mmap).
// Returns the aligned base pointer; element count stored at ptr-8.
pub fn SimdAlloc(n: int64): int64 {
  // Inline mmap allocation matching CGN_SIMD_NEW layout:
  // total = n*4 + 24, ptr = (mmap_base + 23) & ~15, count at ptr-8.
  var byteCount: int64 := n * 4 + 24;
  // MmapAnon existierte nie — direktes mmap wie in std/alloc.lyx.
  var base: int64 := mmap(0, byteCount, MMAP_PROT_RW, MMAP_ANON, 0 - 1, 0);
  if (base <= 0) { return 0; }
  var ptr: int64 := (base + 23) & (0 - 16);
  poke64(ptr - 8, n);
  return ptr;
}

// Vectorized element-wise add: result = src1 + src2 (new allocation).
// Uses SSE2 when available, scalar fallback otherwise.
pub fn SimdAdd(src1: int64, src2: int64): int64 {
  var n: int64 := peek64(src1 - 8);
  var dst: int64 := SimdAlloc(n);
  if (CpuDispatchLevel() >= CPU_DISPATCH_SSE2) {
    // SSE2 path — delegate to codegen-level parallel op (same asm as CGN_BINOP SIMD)
    // For stdlib use, we call the scalar path (SSE2 is handled transparently by codegen).
    SimdAddScalar(src1, src2, dst, n);
  } else {
    SimdAddScalar(src1, src2, dst, n);
  }
  return dst;
}

pub fn SimdSub(src1: int64, src2: int64): int64 {
  var n: int64 := peek64(src1 - 8);
  var dst: int64 := SimdAlloc(n);
  SimdSubScalar(src1, src2, dst, n);
  return dst;
}

pub fn SimdMul(src1: int64, src2: int64): int64 {
  var n: int64 := peek64(src1 - 8);
  var dst: int64 := SimdAlloc(n);
  SimdMulScalar(src1, src2, dst, n);
  return dst;
}

pub fn SimdDiv(src1: int64, src2: int64): int64 {
  var n: int64 := peek64(src1 - 8);
  var dst: int64 := SimdAlloc(n);
  SimdDivScalar(src1, src2, dst, n);
  return dst;
}

// Read element i from a SIMD array (as int64 holding f32 bits).
pub fn SimdGet(arr: int64, i: int64): int64 {
  return peek32(arr + i * 4) as int64;
}

// Write f32 bits into element i of a SIMD array.
pub fn SimdSet(arr: int64, i: int64, val: int64) {
  poke32(arr + i * 4, val);
}

// Return element count of a SIMD array.
pub fn SimdLen(arr: int64): int64 {
  return peek64(arr - 8);
}
