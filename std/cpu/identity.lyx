// std/cpu/identity.lyx — Identitaet der CPU (#2397, Teil von #2396)
//
// Vendor, Familie/Modell/Stepping, Markenname und Mikroarchitektur. Der
// Bestand hatte davon nichts: `std/cpu/features.lyx` kennt die Faehigkeits-
// bits, `std/systeminfo.lyx` die Kernzahl — WER die CPU ist, war nicht
// abfragbar.
//
// Zur Mikroarchitektur: die Tabelle Familie/Modell -> Name ist unvollstaendig
// und wird es bleiben, weil jedes Jahr neue Modelle dazukommen. Genau deshalb
// scheitert der Default-Zweig LAUT: `CpuMikroarchitektur` liefert einen
// Traeger mit CPU_ST_UNSUPPORTED und den Rohwerten in der Quelle, statt einen
// Namen zu raten. Ein geratener Name waere die schlimmste Sorte stiller
// Default — er sieht richtig aus und steuert Codegen-Entscheidungen (#2198).

@description("CPU-Identitaet: Vendor, Familie/Modell/Stepping, Markenname, Mikroarchitektur")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.cpu.identity;

import std.alloc;
import std.cpu.status;

// Vier Byte eines CPUID-Registers als Zeichen in einen Puffer schreiben.
fn idVier(ziel: int64, pos: int64, reg: int64): int64 {
  poke8(ziel + pos + 0,  reg        & 255);
  poke8(ziel + pos + 1, (reg >>  8) & 255);
  poke8(ziel + pos + 2, (reg >> 16) & 255);
  poke8(ziel + pos + 3, (reg >> 24) & 255);
  return pos + 4;
}

// Vendor-Zeichenkette (12 Zeichen) aus CPUID.0: ebx, edx, ecx — in dieser
// Reihenfolge, nicht ebx/ecx/edx. "GenuineIntel", "AuthenticAMD".
// Rueckgabe: neu angelegte Zeichenkette; leer, wenn es kein CPUID gibt.
pub fn CpuVendor(): pchar {
  if (cpu_id(0, 0, 0) == 0) { return ""c; }
  var p: int64 := alloc(16);
  var pos: int64 := 0;
  pos := idVier(p, pos, cpu_id(0, 0, 1));   // ebx
  pos := idVier(p, pos, cpu_id(0, 0, 3));   // edx
  pos := idVier(p, pos, cpu_id(0, 0, 2));   // ecx
  poke8(p + pos, 0);
  return p as pchar;
}

// Markenname aus den erweiterten Blaettern 0x80000002..0x80000004 (48 Byte,
// nullterminiert, oft mit Leerzeichen vorn). Fehlt das Blatt, ist die
// Zeichenkette leer — das ist der ehrliche Zustand, nicht "Unknown CPU".
pub fn CpuMarkenname(): pchar {
  var maxExt: int64 := cpu_id(2147483648, 0, 0);          // 0x80000000
  if (maxExt < 2147483652) { return ""c; }                 // braucht 0x80000004
  var p: int64 := alloc(64);
  var pos: int64 := 0;
  var blatt: int64 := 2147483650;                          // 0x80000002
  while (blatt <= 2147483652) {
    pos := idVier(p, pos, cpu_id(blatt, 0, 0));
    pos := idVier(p, pos, cpu_id(blatt, 0, 1));
    pos := idVier(p, pos, cpu_id(blatt, 0, 2));
    pos := idVier(p, pos, cpu_id(blatt, 0, 3));
    blatt := blatt + 1;
  }
  poke8(p + 48, 0);
  // Fuehrende Leerzeichen abschneiden: Intel fuellt den Namen rechtsbuendig.
  var anf: int64 := 0;
  while (anf < 48 && peek8(p + anf) == 32) { anf := anf + 1; }
  return (p + anf) as pchar;
}

// Familie nach Intel/AMD-Regel: Basisfamilie 0xF heisst "erweiterte Familie
// addieren". Wer nur die Basisfamilie liest, haelt jede moderne AMD-CPU fuer
// Familie 15.
pub fn CpuFamilie(): int64 {
  if (cpu_id(0, 0, 0) == 0) { return 0 - 1; }
  var eax: int64 := cpu_id(1, 0, 0);
  var basis: int64 := (eax >> 8) & 15;
  if (basis == 15) { return basis + ((eax >> 20) & 255); }
  return basis;
}

// Modell: bei Basisfamilie 6 ODER 15 kommt das erweiterte Modell als obere
// vier Bit dazu. Ohne diese Regel ist ein i5-8250U (Modell 0x8E) ein
// "Modell 14".
pub fn CpuModell(): int64 {
  if (cpu_id(0, 0, 0) == 0) { return 0 - 1; }
  var eax: int64 := cpu_id(1, 0, 0);
  var basis: int64 := (eax >> 8) & 15;
  var modell: int64 := (eax >> 4) & 15;
  if (basis == 6 || basis == 15) { modell := modell + (((eax >> 16) & 15) << 4); }
  return modell;
}

pub fn CpuStepping(): int64 {
  if (cpu_id(0, 0, 0) == 0) { return 0 - 1; }
  return cpu_id(1, 0, 0) & 15;
}

fn idIstIntel(): int64 {
  // "GenuineIntel": ebx = 0x756E6547 ("Genu")
  if (cpu_id(0, 0, 1) == 1970169159) { return 1; }
  return 0;
}

fn idIstAmd(): int64 {
  // "AuthenticAMD": ebx = 0x68747541 ("Auth")
  if (cpu_id(0, 0, 1) == 1752462657) { return 1; }
  return 0;
}

pub fn CpuIstIntel(): int64 { return idIstIntel(); }
pub fn CpuIstAmd(): int64 { return idIstAmd(); }

// Mikroarchitektur als Traeger: bei einem Treffer der Name in der Quelle und
// der Modellwert im Wert; sonst CPU_ST_UNSUPPORTED mit "cpuid.1" als Quelle.
// Der Aufrufer bekommt also entweder einen belegten Namen oder die Auskunft
// "nicht in der Tabelle" — nie einen geratenen Namen.
//
// Die Tabelle deckt, was hier belegbar ist (Intel Familie 6) und was in den
// Messprotokollen auftaucht. Sie ist ausdruecklich unvollstaendig.
pub fn CpuMikroarchitekturName(): pchar {
  if (idIstIntel() == 0) { return ""c; }
  if (CpuFamilie() != 6) { return ""c; }
  var m: int64 := CpuModell();
  if (m == 142 || m == 158) { return "Kaby Lake / Coffee Lake"c; }   // 0x8E / 0x9E
  if (m == 94  || m == 78)  { return "Skylake"c; }                    // 0x5E / 0x4E
  if (m == 85)              { return "Skylake-SP / Cascade Lake"c; }  // 0x55
  if (m == 61  || m == 71)  { return "Broadwell"c; }                  // 0x3D / 0x47
  if (m == 60  || m == 69 || m == 70) { return "Haswell"c; }          // 0x3C / 0x45 / 0x46
  if (m == 58  || m == 62)  { return "Ivy Bridge"c; }                 // 0x3A / 0x3E
  if (m == 42  || m == 45)  { return "Sandy Bridge"c; }               // 0x2A / 0x2D
  if (m == 125 || m == 126) { return "Ice Lake"c; }                   // 0x7D / 0x7E
  if (m == 140 || m == 141) { return "Tiger Lake"c; }                 // 0x8C / 0x8D
  if (m == 151 || m == 154) { return "Alder Lake"c; }                 // 0x97 / 0x9A
  if (m == 183 || m == 186) { return "Raptor Lake"c; }                // 0xB7 / 0xBA
  if (m == 189 || m == 170) { return "Lunar Lake / Meteor Lake"c; }   // 0xBD / 0xAA
  return ""c;
}

// Mikroarchitektur als Traeger (Wert = Modellnummer).
pub fn CpuMikroarchitektur(t: int64): void {
  if (cpu_id(0, 0, 0) == 0) {
    CpuWertFehlt(t, CPU_ST_UNSUPPORTED, "kein CPUID auf dieser Architektur"c);
    return;
  }
  var nm: pchar := CpuMikroarchitekturName();
  if (StrLenRoh(nm) == 0) {
    // Kein Treffer: die Rohwerte stehen in der Quelle, damit der Bericht
    // nachvollziehbar bleibt, und der Status sagt "nicht in der Tabelle".
    CpuWertFehlt(t, CPU_ST_UNSUPPORTED, "cpuid.1 (Familie/Modell nicht in der Tabelle)"c);
    return;
  }
  CpuWertSetzen(t, CpuModell(), nm);
}

// Laenge einer Zeichenkette, ohne std.string zu importieren (die Unit soll
// unterhalb der Zeichenkettenbibliothek benutzbar bleiben).
fn StrLenRoh(s: pchar): int64 {
  var i: int64 := 0;
  while (peek8((s as int64) + i) != 0) { i := i + 1; }
  return i;
}
