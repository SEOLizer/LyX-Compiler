// std/ee/dc.lyx — Gleichstromnetzwerke: Ohm, Kirchhoff, Teiler, Leitungen
//
// WAS HIER DIE FALLEN SIND:
//
//   * DIE PARALLELFORMEL HAT EINEN POL. `1/(1/R1 + 1/R2)` ist für R = 0 nicht
//     definiert — und R = 0 ist kein exotischer Fall, sondern der Kurzschluss,
//     den man gerade nachrechnen will. Jede Funktion hier prüft das und
//     liefert einen Fehlerwert statt einer Division durch null.
//
//   * DER SPANNUNGSTEILER GILT NUR UNBELASTET. Die Formel U2 = U·R2/(R1+R2)
//     setzt voraus, dass am Abgriff KEIN Strom fließt. Wer einen Verbraucher
//     anhängt und trotzdem so rechnet, bekommt eine zu hohe Spannung — bei
//     einem hochohmigen Teiler um Größenordnungen. Deshalb gibt es hier
//     `DcVoltageDividerLoaded`, und der unbelastete Fall heißt ausdrücklich so.
//
//   * LEITUNGSQUERSCHNITT IST FLÄCHE. mm² nach m² ist der Faktor 10⁻⁶, nicht
//     10⁻³. Alle Funktionen nehmen deshalb mm² entgegen — die Einheit, die im
//     Datenblatt steht — und rechnen selbst um.
//
//   * DER SPANNUNGSFALL GEHT ÜBER HIN- UND RÜCKLEITER. Bei Gleichstrom ist die
//     wirksame Länge die DOPPELTE einfache Länge. Genau dieser Faktor 2 fehlt
//     in den meisten Überschlagsrechnungen und macht aus 3 % Spannungsfall 6 %.
//
//   * DER TEMPERATURKOEFFIZIENT IST EINE NÄHERUNG ERSTER ORDNUNG. Für Kupfer
//     zwischen -50 °C und +200 °C brauchbar; wer damit Glühwendeln bei 2500 K
//     rechnet, liegt um ein Vielfaches daneben.

unit std.ee.dc;

import std.ee.const;

// ── Ohmsches Gesetz ────────────────────────────────────────────────────────

// Spannung aus Strom und Widerstand.
pub fn DcVoltage(iA: f64, rOhm: f64): f64 { return iA * rOhm; }

// Strom aus Spannung und Widerstand. R = 0 ist der Kurzschluss: kein Strom
// ist "unendlich", und ein Rückgabewert von 0 wäre die gefährlichste Antwort.
pub fn DcCurrent(uV: f64, rOhm: f64): f64 {
  if (rOhm == 0.0) { return EeError(); }
  return uV / rOhm;
}

// Widerstand aus Spannung und Strom.
pub fn DcResistance(uV: f64, iA: f64): f64 {
  if (iA == 0.0) { return EeError(); }
  return uV / iA;
}

// ── Leistung ───────────────────────────────────────────────────────────────

pub fn DcPowerUI(uV: f64, iA: f64): f64 { return uV * iA; }

pub fn DcPowerU2R(uV: f64, rOhm: f64): f64 {
  if (rOhm == 0.0) { return EeError(); }
  return uV * uV / rOhm;
}

pub fn DcPowerI2R(iA: f64, rOhm: f64): f64 { return iA * iA * rOhm; }

// ── Zusammenschaltungen ────────────────────────────────────────────────────

pub fn DcSeries2(r1: f64, r2: f64): f64 { return r1 + r2; }

// Parallelschaltung zweier Widerstände über das Produkt durch die Summe.
//
// Diese Form ist der Kehrwertformel vorzuziehen: sie kommt mit EINER Division
// aus und ist bei stark verschiedenen Werten genauer. R = 0 an einem der
// beiden ergibt 0 — ein Kurzschluss parallel zu irgendetwas IST ein
// Kurzschluss, das ist kein Fehlerfall.
pub fn DcParallel2(r1: f64, r2: f64): f64 {
  if (r1 < 0.0 || r2 < 0.0) { return EeError(); }
  var s: f64 := r1 + r2;
  if (s == 0.0) { return 0.0; }
  return r1 * r2 / s;
}

// Drei parallel, über zweimal die obige Formel.
pub fn DcParallel3(r1: f64, r2: f64, r3: f64): f64 {
  var t: f64 := DcParallel2(r1, r2);
  if (EeIsError(t)) { return t; }
  return DcParallel2(t, r3);
}

// n gleiche Widerstände parallel.
pub fn DcParallelN(rOhm: f64, n: int64): f64 {
  if (n <= 0 || rOhm < 0.0) { return EeError(); }
  return rOhm / (n as f64);
}

// ── Teiler ─────────────────────────────────────────────────────────────────

// UNBELASTETER Spannungsteiler. Gilt nur, wenn am Abgriff kein Strom fließt.
pub fn DcVoltageDivider(uInV: f64, r1: f64, r2: f64): f64 {
  var s: f64 := r1 + r2;
  if (s == 0.0) { return EeError(); }
  return uInV * r2 / s;
}

// BELASTETER Spannungsteiler: der Lastwiderstand liegt parallel zu R2.
//
// Der Unterschied ist kein Feinschliff. Ein 100-kΩ-Teiler mit 10 kΩ Last
// liefert statt der halben Eingangsspannung nur noch rund ein Sechstel.
pub fn DcVoltageDividerLoaded(uInV: f64, r1: f64, r2: f64, rLoad: f64): f64 {
  var rp: f64 := DcParallel2(r2, rLoad);
  if (EeIsError(rp)) { return rp; }
  return DcVoltageDivider(uInV, r1, rp);
}

// Stromteiler: der Anteil, der durch R1 fließt.
pub fn DcCurrentDivider(iInA: f64, r1: f64, r2: f64): f64 {
  var s: f64 := r1 + r2;
  if (s == 0.0) { return EeError(); }
  // Der Strom nimmt den KLEINEREN Widerstand — deshalb steht im Zähler R2,
  // wenn der Strom durch R1 gesucht ist. Das ist genau andersherum als beim
  // Spannungsteiler und wird regelmäßig verwechselt.
  return iInA * r2 / s;
}

// ── Leitungen ──────────────────────────────────────────────────────────────

// Spezifischer Widerstand in Ω·mm²/m — die Form, in der Tabellen ihn nennen.
pub fn DcRhoCopper():    f64 { return 0.01724; }
pub fn DcRhoAluminium(): f64 { return 0.02650; }
pub fn DcRhoSilver():    f64 { return 0.01587; }

// Leitungswiderstand. `lenM` ist die EINFACHE Länge; ob Hin- und Rückleiter
// zählen, entscheidet der Aufrufer — für den Spannungsfall gibt es unten eine
// eigene Funktion, die den Faktor 2 selbst setzt.
pub fn DcWireResistanceOhm(rhoOhmMm2M: f64, lenM: f64, aMm2: f64): f64 {
  if (aMm2 <= 0.0 || lenM < 0.0) { return EeError(); }
  return rhoOhmMm2M * lenM / aMm2;
}

// Spannungsfall auf einer Gleichstromleitung, HIN UND ZURÜCK.
//
// Der Faktor 2 ist der Grund, warum diese Funktion existiert: er fehlt in
// Überschlagsrechnungen fast immer, und dann ist der Fall doppelt so groß wie
// gerechnet.
pub fn DcVoltageDropV(iA: f64, rhoOhmMm2M: f64, lenM: f64, aMm2: f64): f64 {
  var r: f64 := DcWireResistanceOhm(rhoOhmMm2M, lenM, aMm2);
  if (EeIsError(r)) { return r; }
  return 2.0 * iA * r;
}

// Derselbe Fall als Anteil der Betriebsspannung in Prozent — die Größe, gegen
// die Normen ihre Grenzwerte stellen (VDE: 3 % Beleuchtung, 5 % übrige).
pub fn DcVoltageDropPercent(iA: f64, uV: f64, rhoOhmMm2M: f64, lenM: f64, aMm2: f64): f64 {
  if (uV == 0.0) { return EeError(); }
  var du: f64 := DcVoltageDropV(iA, rhoOhmMm2M, lenM, aMm2);
  if (EeIsError(du)) { return du; }
  return 100.0 * du / uV;
}

// Der Querschnitt, den ein zulässiger Spannungsfall verlangt. Die Umkehrung
// der obigen Rechnung — das, was man beim Auslegen tatsächlich sucht.
pub fn DcRequiredAreaMm2(iA: f64, rhoOhmMm2M: f64, lenM: f64, maxDropV: f64): f64 {
  if (maxDropV <= 0.0 || lenM < 0.0) { return EeError(); }
  return 2.0 * iA * rhoOhmMm2M * lenM / maxDropV;
}

// ── Temperaturgang ─────────────────────────────────────────────────────────

// Temperaturkoeffizienten in 1/K bei 20 °C.
pub fn DcAlphaCopper():    f64 { return 0.00393; }
pub fn DcAlphaAluminium(): f64 { return 0.00403; }

// Widerstand bei abweichender Temperatur, lineare Näherung:
// R(T) = R20 · (1 + α·(T − 20 °C)).
//
// Brauchbar für Leitungen und Wicklungen im üblichen Bereich. Für große
// Temperaturhübe — Glühwendel, Sicherungsdraht — ist sie es NICHT; dort steigt
// der Widerstand nichtlinear, und die Formel liefert deutlich zu kleine Werte.
pub fn DcResistanceAtTemp(r20Ohm: f64, alphaPerK: f64, tempC: f64): f64 {
  if (r20Ohm < 0.0) { return EeError(); }
  return r20Ohm * (1.0 + alphaPerK * (tempC - 20.0));
}

// ── Quellen ────────────────────────────────────────────────────────────────

// Klemmenspannung einer realen Quelle unter Last.
pub fn DcTerminalVoltage(uSourceV: f64, rInnerOhm: f64, iLoadA: f64): f64 {
  return uSourceV - rInnerOhm * iLoadA;
}

// Kurzschlussstrom einer realen Quelle.
pub fn DcShortCircuitCurrent(uSourceV: f64, rInnerOhm: f64): f64 {
  if (rInnerOhm <= 0.0) { return EeError(); }
  return uSourceV / rInnerOhm;
}

// Wirkungsgrad der Leistungsübertragung an einen Lastwiderstand.
//
// Das Leistungsanpassungs-Maximum (RLast = Ri) liefert die GRÖSSTE Leistung,
// aber nur 50 % Wirkungsgrad — in der Energietechnik ist das der falsche
// Arbeitspunkt, in der Nachrichtentechnik der richtige. Wer beides
// verwechselt, heizt seine Endstufe.
pub fn DcEfficiency(rLoadOhm: f64, rInnerOhm: f64): f64 {
  var s: f64 := rLoadOhm + rInnerOhm;
  if (s == 0.0) { return EeError(); }
  return rLoadOhm / s;
}
