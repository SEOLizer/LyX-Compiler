// std/ee/const.lyx — Naturkonstanten, SI-Vorsätze und der Fehlerwert
//
// Fundament der Elektrotechnik-Sammlung. Alles hier ist Zahlenwerk ohne
// Rechenweg — aber genau darin stecken zwei Fehlerquellen, die in der Praxis
// teuer sind:
//
//   * EIN ABGESCHNITTENER VORSATZ IST EIN RECHENFEHLER. Wer µ mit 0.000001
//     ansetzt, ist genau; wer 1e-6 als "ungefähr" behandelt und unterwegs
//     rundet, verschiebt eine Zeitkonstante um Prozente. Die Vorsätze stehen
//     deshalb als exakte Zehnerpotenzen und werden nicht aus Zeichenketten
//     geparst.
//
//   * EINHEITEN WERDEN VERWECHSELT, NICHT ZAHLEN. Der häufigste Fehler in
//     Leitungsrechnungen ist nicht die Formel, sondern mm² gegen m². Deshalb
//     tragen alle Funktionen dieser Sammlung die Einheit IM NAMEN
//     (`WireResistanceOhm(... aMm2 ...)`), und wo eine Umrechnung nötig ist,
//     gibt es sie hier als eigene Funktion statt als Faktor im Kopf des
//     Aufrufers.
//
// Die Zahlenwerte folgen dem SI von 2019: Elementarladung, Boltzmann-Konstante
// und Lichtgeschwindigkeit sind seither EXAKT definiert, nicht gemessen. µ0
// ist es seitdem NICHT mehr — der alte Wert 4π·10⁻⁷ ist nur noch eine sehr
// gute Näherung, und der Kommentar sagt das an Ort und Stelle.

unit std.ee.const;

// ── Fehlerwert ─────────────────────────────────────────────────────────────
//
// Wie in std.aero: NaN, erkannt über `x != x`. Eine 0 wäre hier untauglich —
// 0 V, 0 A und 0 Ω sind gültige Ergebnisse, und ein Fehler, der wie ein
// gültiger Wert aussieht, ist schlimmer als gar keine Antwort.

pub fn EeError(): f64 {
  // `null` ist in Lyx ein reserviertes Wort und taugt nicht als Name.
  var nix: f64 := 0.0;
  return nix / nix;
}

pub fn EeIsError(x: f64): bool { return x != x; }

// ── Naturkonstanten ────────────────────────────────────────────────────────

// Elementarladung in Coulomb. Seit 2019 EXAKT definiert.
pub fn EeElementaryCharge(): f64 { return 1.602176634e-19; }

// Boltzmann-Konstante in J/K. Seit 2019 EXAKT definiert.
pub fn EeBoltzmann(): f64 { return 1.380649e-23; }

// Lichtgeschwindigkeit im Vakuum in m/s. EXAKT definiert.
pub fn EeSpeedOfLight(): f64 { return 299792458.0; }

// Elektrische Feldkonstante in F/m (Vakuumpermittivität).
pub fn EeEpsilon0(): f64 { return 8.8541878128e-12; }

// Magnetische Feldkonstante in H/m.
//
// ACHTUNG: seit der SI-Revision 2019 ist µ0 nicht mehr exakt 4π·10⁻⁷.
// Der alte Wert weicht erst in der zehnten Stelle ab und taugt für jede
// Anwendung — aber wer µ0 als "exakt" in eine Fehlerrechnung einsetzt,
// begründet damit eine Genauigkeit, die es nicht gibt.
pub fn EeMu0(): f64 { return 1.25663706212e-6; }

// Freiraumwellenwiderstand in Ohm (Z0 = µ0·c). Grundgröße jeder
// Antennen- und Leitungsrechnung.
pub fn EeZ0(): f64 { return EeMu0() * EeSpeedOfLight(); }

// Thermospannung kT/q bei der angegebenen Temperatur in Kelvin.
// Bei 300 K rund 25,85 mV — die Zahl, die in jeder Diodenkennlinie steckt.
pub fn EeThermalVoltage(tempK: f64): f64 {
  if (tempK <= 0.0) { return EeError(); }
  return EeBoltzmann() * tempK / EeElementaryCharge();
}

// Kelvin aus Grad Celsius. Steht hier und nicht im Kopf des Aufrufers, weil
// die Thermospannung KELVIN verlangt und der Datenblattwert in Celsius steht.
pub fn EeCelsiusToKelvin(c: f64): f64 { return c + 273.15; }

// ── SI-Vorsätze ────────────────────────────────────────────────────────────
//
// Als Funktionen und nicht als con-Werte, damit sie sich wie die übrigen
// Größen dieser Sammlung benutzen lassen und in jedem Ziel gleich rechnen.

pub fn EePico():  f64 { return 1.0e-12; }
pub fn EeNano():  f64 { return 1.0e-9; }
pub fn EeMicro(): f64 { return 1.0e-6; }
pub fn EeMilli(): f64 { return 1.0e-3; }
pub fn EeKilo():  f64 { return 1.0e3; }
pub fn EeMega():  f64 { return 1.0e6; }
pub fn EeGiga():  f64 { return 1.0e9; }
pub fn EeTera():  f64 { return 1.0e12; }

// ── Umrechnungen, die erfahrungsgemäß schiefgehen ──────────────────────────

// Querschnitt: mm² nach m². Der Klassiker in Leitungsrechnungen — der Faktor
// ist 10⁻⁶ und nicht 10⁻³, weil die Fläche quadratisch eingeht.
pub fn EeMm2ToM2(aMm2: f64): f64 { return aMm2 * 1.0e-6; }

// Und zurück.
pub fn EeM2ToMm2(aM2: f64): f64 { return aM2 * 1.0e6; }

// Durchmesser in mm nach Querschnitt in mm². Datenblätter nennen mal das eine,
// mal das andere; wer den Durchmesser für den Querschnitt hält, rechnet um den
// Faktor π/4 daneben.
pub fn EeDiameterMmToAreaMm2(dMm: f64): f64 {
  if (dMm < 0.0) { return EeError(); }
  var r: f64 := dMm / 2.0;
  return 3.14159265358979323846 * r * r;
}

pub fn EePi(): f64 { return 3.14159265358979323846; }

// Kreisfrequenz aus der Frequenz. ω = 2πf — die Verwechslung von f und ω ist
// der häufigste Vorzeichen- und Faktorfehler in Wechselstromrechnungen.
pub fn EeOmega(fHz: f64): f64 { return 2.0 * EePi() * fHz; }

// Und zurück, für die Fälle, in denen eine Bandbreite als ω vorliegt.
pub fn EeFreqHz(omega: f64): f64 { return omega / (2.0 * EePi()); }
