unit std.json;

import std.string;
import std.alloc;   // #1432: Puffer statt String-Literalen

// ============================================================================
// Type Constants
// ============================================================================

pub con JSON_NULL: int64 := 0;
pub con JSON_BOOL: int64 := 1;
pub con JSON_NUMBER: int64 := 2;
pub con JSON_STRING: int64 := 3;
pub con JSON_ARRAY: int64 := 4;
pub con JSON_OBJECT: int64 := 5;

pub con ERR_JSON_OK: int64 := 0;
pub con ERR_JSON_INVALID: int64 := 1;
pub con ERR_JSON_EXPECTED: int64 := 2;
pub con ERR_JSON_EOF: int64 := 3;
pub con ERR_JSON_ESCAPE: int64 := 4;

// #1435: Bis hierher meldete parseValue fuer alles, was auf keinen bekannten
// Fall passte, JSON_NUMBER — auch fuer `Muell` und fuer abgeschnittene
// Eingaben. Einen Fehlerwert gab es nicht.
pub con JSON_INVALID: int64 := 0 - 1;

// ============================================================================
// Internal helpers
// ============================================================================

fn json_is_ws(c: int64): int64 {
  if (c == 32 || c == 9 || c == 10 || c == 13) { return 1; }
  return 0;
}

// Find matching close bracket; returns index or -1
//
// #1269: `start` ist der Index DER OEFFNENDEN KLAMMER, nicht der Position
// dahinter. Die Aufrufer uebergaben 1 statt 0; damit wurde die oeffnende
// Klammer nie gezaehlt, `depth` fiel beim Schliessen auf -1 und traf die 0 nie
// — die Funktion lieferte immer -1. Folge: isValidJSON hielt gueltiges JSON
// fuer ungueltig und parseArray/toArray lieferten nichts.
fn find_matching(s: pchar, start: int64, open: int64, close: int64): int64 {
  var depth: int64 := 0;
  var i: int64 := start;
  var len: int64 := StrLen(s);
  var in_str: int64 := 0;

  while (i < len) {
    var c: int64 := StrCharAt(s, i);

    if (c == 34) {
      if (i == 0) {
        if (in_str != 0) { in_str := 0; } else { in_str := 1; }
      } else {
        var iprev: int64 := i - 1;
        if (StrCharAt(s, iprev) != 92) {
          if (in_str != 0) { in_str := 0; } else { in_str := 1; }
        }
      }
    } else if (in_str == 0) {
      if (c == open) { depth := depth + 1; }
      else if (c == close) {
        depth -= 1;
        if (depth == 0) { return i; }
      }
    }

    i += 1;
  }

  return -1;
}

// Count comma-separated elements in array slice [start, end)
fn count_array_elements(s: pchar, start: int64, end: int64): int64 {
  var count: int64 := 0;
  var i: int64 := start;
  var in_str: int64 := 0;
  var depth: int64 := 0;

  while (i < end) {
    var c: int64 := StrCharAt(s, i);

    if (c == 34) {
      if (i == 0) {
        if (in_str != 0) { in_str := 0; } else { in_str := 1; }
      } else {
        var iprev2: int64 := i - 1;
        if (StrCharAt(s, iprev2) != 92) {
          if (in_str != 0) { in_str := 0; } else { in_str := 1; }
        }
      }
    } else if (in_str == 0) {
      if (c == 91) { depth := depth + 1; }
      else if (c == 93) { depth := depth - 1; }
      else if (c == 123) { depth := depth + 1; }
      else if (c == 125) { depth := depth - 1; }
      else if (depth == 0 && c == 44) {
        count += 1;
      }
    }

    i += 1;
  }

  return count + 1;
}

// ============================================================================
// String Escaping
// ============================================================================

pub fn JSONEscape(dest: pchar, src: pchar): pchar {
  var src_len: int64 := StrLen(src);
  var j: int64 := 0;
  var i: int64 := 0;

  StrSetChar(dest, j, 34);
  j += 1;

  while (i < src_len) {
    var c: int64 := StrCharAt(src, i);

    if (c == 34) {
      StrSetChar(dest, j, 92); j := j + 1;
      StrSetChar(dest, j, 34); j := j + 1;
    } else if (c == 92) {
      StrSetChar(dest, j, 92); j := j + 1;
      StrSetChar(dest, j, 92); j := j + 1;
    } else if (c == 10) {
      StrSetChar(dest, j, 92); j := j + 1;
      StrSetChar(dest, j, 110); j := j + 1;
    } else if (c == 13) {
      StrSetChar(dest, j, 92); j := j + 1;
      StrSetChar(dest, j, 114); j := j + 1;
    } else if (c == 9) {
      StrSetChar(dest, j, 92); j := j + 1;
      StrSetChar(dest, j, 116); j := j + 1;
    } else if (c == 8) {
      StrSetChar(dest, j, 92); j := j + 1;
      StrSetChar(dest, j, 98); j := j + 1;    // \b
    } else if (c == 12) {
      StrSetChar(dest, j, 92); j := j + 1;
      StrSetChar(dest, j, 102); j := j + 1;   // \f
    } else if (c < 32) {
      // #1433: RFC 8259 §7 verlangt, dass JEDES Zeichen unter U+0020 maskiert
      // wird. Vorher uebernahm der else-Zweig sie roh — das Ergebnis war kein
      // gueltiges JSON, und ein strenger Parser (python json, jq, Browser)
      // wies es zurueck. Solche Bytes kommen aus Dateien, Datenbankfeldern und
      // Protokollzeilen, also genau aus den Daten, die man vor dem Versenden
      // maskiert.
      StrSetChar(dest, j, 92);  j := j + 1;
      StrSetChar(dest, j, 117); j := j + 1;   // 'u'
      StrSetChar(dest, j, 48);  j := j + 1;   // '0'
      StrSetChar(dest, j, 48);  j := j + 1;   // '0'
      var hi: int64 := c / 16;
      var lo: int64 := c % 16;
      if (hi < 10) { StrSetChar(dest, j, 48 + hi); } else { StrSetChar(dest, j, 87 + hi); }
      j := j + 1;
      if (lo < 10) { StrSetChar(dest, j, 48 + lo); } else { StrSetChar(dest, j, 87 + lo); }
      j := j + 1;
    } else {
      StrSetChar(dest, j, c); j := j + 1;
    }

    i += 1;
  }

  StrSetChar(dest, j, 34);
  j += 1;
  StrSetChar(dest, j, 0);

  return dest;
}

fn JSONUnescape(dest: pchar, src: pchar): pchar {
  var src_len: int64 := StrLen(src);
  var j: int64 := 0;
  var i: int64 := 0;

  if (src_len > 0 && StrCharAt(src, 0) == 34) {
    i += 1;
  }

  while (i < src_len) {
    var c: int64 := StrCharAt(src, i);
    var inext: int64 := i + 1;

    if (c == 92 && inext < src_len) {
      i += 1;
      c := StrCharAt(src, i);

      if (c == 34) { StrSetChar(dest, j, 34); }
      else if (c == 92) { StrSetChar(dest, j, 92); }
      else if (c == 110) { StrSetChar(dest, j, 10); }
      else if (c == 114) { StrSetChar(dest, j, 13); }
      else if (c == 116) { StrSetChar(dest, j, 9); }
      else { StrSetChar(dest, j, c); }
    } else if (c == 34) {
      break;
    } else {
      StrSetChar(dest, j, c);
    }

    i += 1;
    j += 1;
  }

  StrSetChar(dest, j, 0);
  return dest;
}

// ============================================================================
// Public API
// ============================================================================

// #1434: Bei Arrays und Objekten wurde nur geprueft, ob sich zur oeffnenden
// Klammer eine schliessende finden laesst — `[abc]` und `{,,,}` kamen durch.
// Fuer die Skalare war die Pruefung seit #1269 in Ordnung; offen waren die
// zusammengesetzten Typen.
//
// Umgesetzt ist die erste der beiden vorgeschlagenen Varianten: eine echte
// Strukturpruefung. Die folgenden Funktionen laufen ueber den Text und geben
// die Position HINTER dem gelesenen Teil zurueck, oder -1.
fn jsonSkipWs(s: pchar, pos: int64, len: int64): int64 {
  var p: int64 := pos;
  while (p < len && json_is_ws(StrCharAt(s, p)) != 0) { p := p + 1; }
  return p;
}

fn jsonSkipString(s: pchar, pos: int64, len: int64): int64 {
  if (pos >= len || StrCharAt(s, pos) != 34) { return 0 - 1; }
  var p: int64 := pos + 1;
  while (p < len) {
    var c: int64 := StrCharAt(s, p);
    if (c == 92) {
      p := p + 2;    // Maskierung: naechstes Zeichen gehoert dazu
    }
    if (c != 92) {
      if (c == 34) { return p + 1; }
      if (c < 32) { return 0 - 1; }   // rohes Steuerzeichen ist unzulaessig
      p := p + 1;
    }
  }
  return 0 - 1;   // nie geschlossen
}

fn jsonSkipNumber(s: pchar, pos: int64, len: int64): int64 {
  var p: int64 := pos;
  if (p < len && StrCharAt(s, p) == 45) { p := p + 1; }
  var ziffern: int64 := 0;
  while (p < len && StrCharAt(s, p) >= 48 && StrCharAt(s, p) <= 57) { p := p + 1; ziffern := 1; }
  if (ziffern == 0) { return 0 - 1; }
  if (p < len && StrCharAt(s, p) == 46) {
    p := p + 1;
    var nach: int64 := 0;
    while (p < len && StrCharAt(s, p) >= 48 && StrCharAt(s, p) <= 57) { p := p + 1; nach := 1; }
    if (nach == 0) { return 0 - 1; }
  }
  if (p < len && (StrCharAt(s, p) == 101 || StrCharAt(s, p) == 69)) {
    p := p + 1;
    if (p < len && (StrCharAt(s, p) == 43 || StrCharAt(s, p) == 45)) { p := p + 1; }
    var exp: int64 := 0;
    while (p < len && StrCharAt(s, p) >= 48 && StrCharAt(s, p) <= 57) { p := p + 1; exp := 1; }
    if (exp == 0) { return 0 - 1; }
  }
  return p;
}

fn jsonSkipWort(s: pchar, pos: int64, len: int64, w: pchar, wlen: int64): int64 {
  if (pos + wlen > len) { return 0 - 1; }
  var k: int64 := 0;
  while (k < wlen) {
    if (StrCharAt(s, pos + k) != StrCharAt(w, k)) { return 0 - 1; }
    k := k + 1;
  }
  return pos + wlen;
}

// Tiefe begrenzen: die Pruefung ist rekursiv, und eine Eingabe aus lauter
// oeffnenden Klammern soll den Stapel nicht sprengen.
con JSON_MAX_TIEFE: int64 := 128;

fn jsonSkipValue(s: pchar, pos: int64, len: int64, tiefe: int64): int64 {
  if (tiefe > JSON_MAX_TIEFE) { return 0 - 1; }
  var p: int64 := jsonSkipWs(s, pos, len);
  if (p >= len) { return 0 - 1; }
  var c: int64 := StrCharAt(s, p);

  if (c == 34)  { return jsonSkipString(s, p, len); }
  if (c == 116) { return jsonSkipWort(s, p, len, "true"c,  4); }
  if (c == 102) { return jsonSkipWort(s, p, len, "false"c, 5); }
  if (c == 110) { return jsonSkipWort(s, p, len, "null"c,  4); }

  if (c == 91) {
    // Array
    p := jsonSkipWs(s, p + 1, len);
    if (p < len && StrCharAt(s, p) == 93) { return p + 1; }   // []
    var weiter: int64 := 1;
    while (weiter == 1) {
      p := jsonSkipValue(s, p, len, tiefe + 1);
      if (p < 0) { return 0 - 1; }
      p := jsonSkipWs(s, p, len);
      if (p >= len) { return 0 - 1; }
      var t: int64 := StrCharAt(s, p);
      if (t == 44) { p := p + 1; }
      if (t == 93) { return p + 1; }
      if (t != 44 && t != 93) { return 0 - 1; }
    }
    return 0 - 1;
  }

  if (c == 123) {
    // Objekt
    p := jsonSkipWs(s, p + 1, len);
    if (p < len && StrCharAt(s, p) == 125) { return p + 1; }   // {}
    var weiter2: int64 := 1;
    while (weiter2 == 1) {
      p := jsonSkipWs(s, p, len);
      p := jsonSkipString(s, p, len);        // Schluessel MUSS eine Zeichenkette sein
      if (p < 0) { return 0 - 1; }
      p := jsonSkipWs(s, p, len);
      if (p >= len || StrCharAt(s, p) != 58) { return 0 - 1; }   // ':'
      p := jsonSkipValue(s, p + 1, len, tiefe + 1);
      if (p < 0) { return 0 - 1; }
      p := jsonSkipWs(s, p, len);
      if (p >= len) { return 0 - 1; }
      var t2: int64 := StrCharAt(s, p);
      if (t2 == 44) { p := p + 1; }
      if (t2 == 125) { return p + 1; }
      if (t2 != 44 && t2 != 125) { return 0 - 1; }
    }
    return 0 - 1;
  }

  return jsonSkipNumber(s, p, len);
}

pub fn isValidJSON(s: pchar): bool {
  var len: int64 := StrLen(s);
  if (len == 0) { return false; }
  var p: int64 := jsonSkipValue(s, 0, len, 0);
  if (p < 0) { return false; }
  p := jsonSkipWs(s, p, len);
  if (p != len) { return false; }   // Rest hinter dem Wert
  return true;
}

pub fn parseArray(dest: pchar, src: pchar): int64 {
  var len: int64 := StrLen(src);
  if (len == 0) {
    StrSetChar(dest, 0, 0);
    return ERR_JSON_INVALID;
  }

  if (StrCharAt(src, 0) != 91) {
    StrSetChar(dest, 0, 0);
    return ERR_JSON_EXPECTED;
  }

  var aend: int64 := find_matching(src, 0, 91, 93);   // #1269
  if (aend < 0) {
    StrSetChar(dest, 0, 0);
    return ERR_JSON_EOF;
  }

  var i: int64 := 1;
  var elem_start: int64 := 1;
  var in_str: int64 := 0;
  var depth: int64 := 0;
  var result_len: int64 := 0;

  while (i <= aend) {
    var c: int64 := 0;
    if (i < len) { c := StrCharAt(src, i); }

    if (i < len && c == 34) {
      if (i == 0) {
        if (in_str != 0) { in_str := 0; } else { in_str := 1; }
      } else {
        var iprev3: int64 := i - 1;
        if (StrCharAt(src, iprev3) != 92) {
          if (in_str != 0) { in_str := 0; } else { in_str := 1; }
        }
      }
    } else if (in_str == 0) {
      if (c == 91 || c == 123) { depth := depth + 1; }
      else if (c == 93 || c == 125) { depth := depth - 1; }
    }

    var is_sep: int64 := 0;
    if (i == aend) { is_sep := 1; }
    else if (depth == 0 && in_str == 0 && c == 44) { is_sep := 1; }

    if (is_sep != 0) {
      var elem_len: int64 := i - elem_start;
      if (elem_len > 0) {
        // Trim leading whitespace
        var wc1: int64 := StrCharAt(src, elem_start);
        while (elem_len > 0 && json_is_ws(wc1) != 0) {
          elem_start += 1;
          elem_len -= 1;
          if (elem_len > 0) { wc1 := StrCharAt(src, elem_start); }
        }
        // Trim trailing whitespace
        var tailpos: int64 := elem_start + elem_len;
        tailpos -= 1;
        var wc2: int64 := StrCharAt(src, tailpos);
        while (elem_len > 0 && json_is_ws(wc2) != 0) {
          elem_len -= 1;
          if (elem_len > 0) {
            tailpos -= 1;
            wc2 := StrCharAt(src, tailpos);
          }
        }

        // #1432: Das Pipe-Format kannte keine Maskierung — ein Pipe-Zeichen
        // IM WERT zerlegte das Array beim Zurueckwandeln in zwei Elemente.
        // Beim Kopieren werden deshalb '\\' und '|' maskiert; serializeArray
        // nimmt es zurueck.
        var j: int64 := 0;
        while (j < elem_len) {
          var src_idx: int64 := elem_start + j;
          var ec: int64 := StrCharAt(src, src_idx);
          if (ec == 92 || ec == 124) {
            StrSetChar(dest, result_len, 92);
            result_len += 1;
          }
          StrSetChar(dest, result_len, ec);
          result_len += 1;
          j += 1;
        }

        if (i < aend) {
          StrSetChar(dest, result_len, 124);
          result_len += 1;
        }
      }

      elem_start := i + 1;
    }

    i += 1;
  }

  StrSetChar(dest, result_len, 0);
  return ERR_JSON_OK;
}

// #1432: Hier wurde JEDES Element in Anfuehrungszeichen gesetzt und maskiert,
// unabhaengig davon, was es war. `[1,2,3]` kam als `["1","2","3"]` zurueck,
// aus `["a","b"]` wurde `["\"a\"","\"b\""]` (die Anfuehrungszeichen des
// Originals nochmals maskiert), und ein inneres Array ueberlebte als Text.
//
// Das Zwischenformat traegt die Elemente als ROHEN JSON-Text. Wer es
// zurueckwandelt, muss deshalb ansehen, WAS dort steht: sieht es aus wie ein
// JSON-Wert, wird es unveraendert uebernommen; alles andere ist eine nackte
// Zeichenkette und wird maskiert. Damit ueberleben Zahlen, Wahrheitswerte,
// null und Verschachtelung den Rundlauf.
//
// Ausserdem standen hier zwei STRING-LITERALE als Schreibpuffer (Klasse
// #1259/#1260/#1431) — mit fester Laenge 80 und ohne Pruefung, ein Element
// darueber schrieb daneben.
fn jsonLooksLikeValue(s: pchar): int64 {
  var c: int64 := StrCharAt(s, 0);
  if (c == 34)  { return 1; }                    // Zeichenkette
  if (c == 91)  { return 1; }                    // Array
  if (c == 123) { return 1; }                    // Objekt
  if (c == 45)  { return 1; }                    // negative Zahl
  if (c >= 48 && c <= 57) { return 1; }          // Zahl
  if (StrCmp(s, "true"c)  == 0) { return 1; }
  if (StrCmp(s, "false"c) == 0) { return 1; }
  if (StrCmp(s, "null"c)  == 0) { return 1; }
  return 0;
}

pub fn serializeArray(dest: pchar, src: pchar): pchar {
  var src_len: int64 := StrLen(src);
  var i: int64 := 0;
  var j: int64 := 0;

  StrSetChar(dest, j, 91);
  j += 1;

  var elem_buf: pchar := alloc(src_len + 2) as pchar;
  var escaped:  pchar := alloc(src_len * 6 + 8) as pchar;
  var erstes: int64 := 1;

  while (i <= src_len) {
    // ein Element bis zum naechsten UNMASKIERTEN '|' einsammeln
    var k: int64 := 0;
    while (i < src_len && StrCharAt(src, i) != 124) {
      var c: int64 := StrCharAt(src, i);
      if (c == 92) {
        i := i + 1;                       // Maskierung aufloesen
        if (i < src_len) { c := StrCharAt(src, i); }
      }
      StrSetChar(elem_buf, k, c);
      k := k + 1;
      i := i + 1;
    }
    StrSetChar(elem_buf, k, 0);

    if (k > 0) {
      if (erstes == 0) { StrSetChar(dest, j, 44); j := j + 1; }
      erstes := 0;

      if (jsonLooksLikeValue(elem_buf) != 0) {
        var q: int64 := 0;
        while (q < k) {
          StrSetChar(dest, j, StrCharAt(elem_buf, q));
          j := j + 1;
          q := q + 1;
        }
      }
      if (jsonLooksLikeValue(elem_buf) == 0) {
        JSONEscape(escaped, elem_buf);
        var e: int64 := 0;
        while (StrCharAt(escaped, e) != 0) {
          StrSetChar(dest, j, StrCharAt(escaped, e));
          j := j + 1;
          e := e + 1;
        }
      }
    }

    i := i + 1;
  }

  free(elem_buf as int64, src_len + 2);
  free(escaped as int64, src_len * 6 + 8);

  StrSetChar(dest, j, 93);
  j += 1;
  StrSetChar(dest, j, 0);

  return dest;
}

pub fn parseValue(dest: pchar, src: pchar): int64 {
  var len: int64 := StrLen(src);
  if (len == 0) { return JSON_NULL; }

  var c: int64 := StrCharAt(src, 0);

  if (c == 34) {
    JSONUnescape(dest, src);
    return JSON_STRING;
  }

  if (c == 91) {
    parseArray(dest, src);
    return JSON_ARRAY;
  }

  if (c == 123) {
    // #1435: Der Puffer blieb hier UNANGETASTET — wer den Rueckgabewert nicht
    // prueft, las die Daten des vorherigen Aufrufs weiter. Objekte fuehrt die
    // Unit (noch) nicht in ein Zwischenformat ueber; bis dahin ist ein leerer
    // Puffer die ehrliche Antwort.
    StrSetChar(dest, 0, 0);
    return JSON_OBJECT;
  }

  if (len >= 4 && StrCharAt(src, 0) == 110 && StrCharAt(src, 1) == 117 &&
      StrCharAt(src, 2) == 108 && StrCharAt(src, 3) == 108) {
    StrSetChar(dest, 0, 110); StrSetChar(dest, 1, 117);
    StrSetChar(dest, 2, 108); StrSetChar(dest, 3, 108); StrSetChar(dest, 4, 0);
    return JSON_NULL;
  }

  if (len >= 4 && StrCharAt(src, 0) == 116 && StrCharAt(src, 1) == 114 &&
      StrCharAt(src, 2) == 117 && StrCharAt(src, 3) == 101) {
    StrSetChar(dest, 0, 116); StrSetChar(dest, 1, 114);
    StrSetChar(dest, 2, 117); StrSetChar(dest, 3, 101); StrSetChar(dest, 4, 0);
    return JSON_BOOL;
  }

  if (len >= 5 && StrCharAt(src, 0) == 102 && StrCharAt(src, 1) == 97 &&
      StrCharAt(src, 2) == 108 && StrCharAt(src, 3) == 115 && StrCharAt(src, 4) == 101) {
    StrSetChar(dest, 0, 102); StrSetChar(dest, 1, 97);
    StrSetChar(dest, 2, 108); StrSetChar(dest, 3, 115);
    StrSetChar(dest, 4, 101); StrSetChar(dest, 5, 0);
    return JSON_BOOL;
  }

  // #1435: Nur was wirklich wie eine Zahl aussieht, wird als Zahl gemeldet.
  // Alles andere bekommt JSON_INVALID statt einer Zahl, die es nicht ist.
  var ni2: int64 := 0;
  if (StrCharAt(src, 0) == 45) { ni2 := 1; }
  var sawD: int64 := 0;
  var sawP: int64 := 0;
  var istZahl: int64 := 1;
  if (ni2 >= len) { istZahl := 0; }
  while (istZahl == 1 && ni2 < len) {
    var nc2: int64 := StrCharAt(src, ni2);
    if (nc2 >= 48 && nc2 <= 57) { sawD := 1; }
    if (nc2 == 46) {
      if (sawP != 0) { istZahl := 0; }
      sawP := 1;
    }
    if ((nc2 < 48 || nc2 > 57) && nc2 != 46) { istZahl := 0; }
    ni2 += 1;
  }
  if (sawD == 0) { istZahl := 0; }

  if (istZahl == 0) {
    StrSetChar(dest, 0, 0);
    return JSON_INVALID;
  }

  var vi: int64 := 0;
  while (vi < len) {
    StrSetChar(dest, vi, StrCharAt(src, vi));
    vi += 1;
  }
  StrSetChar(dest, len, 0);

  return JSON_NUMBER;
}

pub fn serializeValue(dest: pchar, value: pchar, json_type: int64): pchar {
  if (json_type == JSON_STRING) {
    return JSONEscape(dest, value);
  }

  var si: int64 := 0;
  while (StrCharAt(value, si) != 0) {
    StrSetChar(dest, si, StrCharAt(value, si));
    si += 1;
  }
  StrSetChar(dest, si, 0);

  return dest;
}

pub fn toArray(dest: pchar, json_str: pchar): pchar {
  var result: int64 := parseArray(dest, json_str);
  if (result != ERR_JSON_OK) {
    StrSetChar(dest, 0, 0);
  }
  return dest;
}

pub fn stringify(dest: pchar, pipe_str: pchar): pchar {
  return serializeArray(dest, pipe_str);
}

