// std/xattr -- WP-14: Erweiterte Dateiattribute & Dateisystem-Statistik
// Wrapper um sys_setxattr (188), sys_getxattr (191), sys_listxattr (194),
// sys_removexattr (197), sys_fsetxattr (190), sys_fgetxattr (193),
// sys_flistxattr (196), sys_fremovexattr (199), sys_fallocate (285),
// sys_statfs (137).
//
// Erweiterte Attribute (xattr) speichern beliebige Name-Wert-Paare an
// Dateien/Verzeichnissen. Namen sind Strings der Form "namespace.name"
// (z.B. "user.comment", "security.selinux", "trusted.md5sum").
// Der "user."-Namespace ist fuer normale Anwendungen zugaenglich.

// ============================================================
// xattr -- Flags
// ============================================================

pub con XATTR_CREATE:  int64 := 1;  // Fehler wenn Attribut schon existiert
pub con XATTR_REPLACE: int64 := 2;  // Fehler wenn Attribut nicht existiert

// ============================================================
// xattr -- Pfad-basiert
// ============================================================

// XattrSet: setzt ein erweitertes Attribut an einem Pfad.
// path:  Dateipfad
// name:  Attributname (z.B. "user.comment")
// val:   Zeiger auf den Wert
// size:  Groesse des Werts in Bytes
// flags: 0 (anlegen oder ersetzen), XATTR_CREATE, XATTR_REPLACE
pub fn XattrSet(path: pchar, name: pchar, val: int64, size: int64, flags: int64): int64 {
  return sys_setxattr(path, name, val, size, flags);
}

// XattrGet: liest ein erweitertes Attribut eines Pfads.
// buf:  Empfangspuffer; 0 um nur die benoetigte Groesse abzufragen
// size: Groesse von buf; 0 liefert die benoetigte Groesse zurueck
// Gibt Anzahl gelesener Bytes zurueck, oder -ENODATA/-ERANGE bei Fehler.
pub fn XattrGet(path: pchar, name: pchar, buf: int64, size: int64): int64 {
  return sys_getxattr(path, name, buf, size);
}

// XattrList: listet alle Attributnamen eines Pfads auf.
// buf:  Empfangspuffer fuer null-separierte Namen; 0 = Groesse abfragen
// size: Groesse von buf
// Gibt Gesamtgroesse der Namen-Liste zurueck.
pub fn XattrList(path: pchar, buf: int64, size: int64): int64 {
  return sys_listxattr(path, buf, size);
}

// XattrRemove: loescht ein erweitertes Attribut eines Pfads.
pub fn XattrRemove(path: pchar, name: pchar): int64 {
  return sys_removexattr(path, name);
}

// ============================================================
// xattr -- fd-basiert
// ============================================================

// FXattrSet: setzt ein erweitertes Attribut ueber einen Dateideskriptor.
pub fn FXattrSet(fd: int64, name: pchar, val: int64, size: int64, flags: int64): int64 {
  return sys_fsetxattr(fd, name, val, size, flags);
}

// FXattrGet: liest ein erweitertes Attribut ueber einen Dateideskriptor.
pub fn FXattrGet(fd: int64, name: pchar, buf: int64, size: int64): int64 {
  return sys_fgetxattr(fd, name, buf, size);
}

// FXattrList: listet alle Attributnamen ueber einen Dateideskriptor auf.
pub fn FXattrList(fd: int64, buf: int64, size: int64): int64 {
  return sys_flistxattr(fd, buf, size);
}

// FXattrRemove: loescht ein erweitertes Attribut ueber einen Dateideskriptor.
pub fn FXattrRemove(fd: int64, name: pchar): int64 {
  return sys_fremovexattr(fd, name);
}

// ============================================================
// statfs -- Dateisystem-Statistik
// ============================================================

// struct statfs auf x86-64 (120 Bytes):
//   +0:  f_type    (int64)  -- Dateisystem-Typ (Magic Number)
//   +8:  f_bsize   (int64)  -- optimale Blockgroesse in Bytes
//   +16: f_blocks  (uint64) -- Gesamtanzahl Datenbloecke
//   +24: f_bfree   (uint64) -- freie Bloecke (nur root)
//   +32: f_bavail  (uint64) -- freie Bloecke fuer nicht-root
//   +40: f_files   (uint64) -- Gesamtanzahl Inodes
//   +48: f_ffree   (uint64) -- freie Inodes
//   +56: f_fsid    (8 Bytes)
//   +64: f_namelen (int64)  -- maximale Dateinamenlaenge
//   +72: f_frsize  (int64)  -- Fragment-Groesse
//   +80: f_flags   (int64)  -- Mount-Flags
//   +88: f_spare[4] (32 Bytes)
pub con STATFS_SIZE:    int64 := 120;
pub con STATFS_BSIZE:   int64 := 8;    // f_bsize
pub con STATFS_BLOCKS:  int64 := 16;   // f_blocks
pub con STATFS_BFREE:   int64 := 24;   // f_bfree
pub con STATFS_BAVAIL:  int64 := 32;   // f_bavail (fuer nicht-root)
pub con STATFS_FILES:   int64 := 40;   // f_files
pub con STATFS_FFREE:   int64 := 48;   // f_ffree
pub con STATFS_NAMELEN: int64 := 64;   // f_namelen

// StatFs: liest Dateisystem-Statistiken fuer den Pfad.
// buf: Puffer der Groesse STATFS_SIZE (alloc(STATFS_SIZE))
// Gibt 0 bei Erfolg oder negativen Fehlercode zurueck.
pub fn StatFs(path: pchar, buf: int64): int64 {
  return sys_statfs(path, buf);
}

// StatFsBlockSize: Blockgroesse in Bytes.
pub fn StatFsBlockSize(buf: int64): int64 {
  return peek64(buf + STATFS_BSIZE);
}

// StatFsTotalBlocks: Gesamtanzahl Datenbloecke.
pub fn StatFsTotalBlocks(buf: int64): int64 {
  return peek64(buf + STATFS_BLOCKS);
}

// StatFsFreeBlocks: fuer nicht-root verfuegbare freie Bloecke.
pub fn StatFsFreeBlocks(buf: int64): int64 {
  return peek64(buf + STATFS_BAVAIL);
}

// StatFsTotalBytes: Gesamtkapazitaet in Bytes (Bloecke * Blockgroesse).
pub fn StatFsTotalBytes(buf: int64): int64 {
  return peek64(buf + STATFS_BLOCKS) * peek64(buf + STATFS_BSIZE);
}

// StatFsFreeBytes: verfuegbarer Speicher in Bytes fuer nicht-root.
pub fn StatFsFreeBytes(buf: int64): int64 {
  return peek64(buf + STATFS_BAVAIL) * peek64(buf + STATFS_BSIZE);
}

// ============================================================
// fallocate -- Speicher-Vorabzuweisung
// ============================================================

// Fallocate-Modus-Flags
pub con FALLOC_FL_KEEP_SIZE:    int64 := 1;   // Dateigroesse nicht aendern
pub con FALLOC_FL_PUNCH_HOLE:   int64 := 2;   // Hole stanzen (braucht KEEP_SIZE)
pub con FALLOC_FL_COLLAPSE_RANGE: int64 := 8; // Bereich entfernen und zusammenfuehren
pub con FALLOC_FL_INSERT_RANGE: int64 := 32;  // Bereich einfuegen (Luecke oeffnen)

// FileAllocate: weist Speicherplatz fuer eine Datei vor (ohne Nullen zu schreiben).
// fd:     offener Dateideskriptor (O_WRONLY oder O_RDWR)
// offset: Startoffset in Bytes
// size:   Anzahl zu reservierender Bytes
// Gibt 0 bei Erfolg oder negativen Fehlercode zurueck.
pub fn FileAllocate(fd: int64, offset: int64, size: int64): int64 {
  return sys_fallocate(fd, 0, offset, size);
}

// FileAllocateMode: wie FileAllocate aber mit explizitem Modus-Flag.
pub fn FileAllocateMode(fd: int64, mode: int64, offset: int64, size: int64): int64 {
  return sys_fallocate(fd, mode, offset, size);
}
