// std/geo/sphere.lyx
// Entfernungen und Kurse auf der Erdkugel.
//
// Abgrenzung zu std.geo: jene Unit rechnet in GANZZAHLIGEN Mikrograd und ist
// fuer Rechtecke, Bounding-Boxen und den Nahbereich gebaut — dort ist sie
// richtig und schnell. Ihre Entfernungs- und Kursfunktionen sind flache
// Naeherungen: auf 95 km stimmen sie auf 0.6 Prozent, auf 6000 km fehlen 6.5
// Prozent, auf der Suedhalbkugel 64 Prozent, und an der Datumsgrenze
// verrechnen sie sich um den Faktor 180 (#1888).
//
// Diese Unit rechnet in f64 und auf der KUGEL. Sie gilt weltweit, ueber die
// Datumsgrenze und ueber die Pole.
//
// GRENZE — die Erde ist keine Kugel. Gegen das WGS84-Ellipsoid weicht die
// Kugelrechnung um bis zu 0.5 Prozent ab (rund 20 km auf einer Aequatorlaenge,
// wenige Meter auf 100 km). Fuer Navigation, Funkstrecken, Reichweiten und
// Entfernungstabellen genuegt das; fuer Vermessung nicht. Wer die letzten
// Promille braucht, braucht Vincenty auf dem Ellipsoid — das steht hier
// bewusst NICHT drin, damit niemand die Kugel dafuer haelt.
//
// VORZEICHEN, durchgehend und ohne Ausnahme:
//   Breite  positiv = NORD, negativ = SUED   (-90 .. +90)
//   Laenge  positiv = OST,  negativ = WEST   (-180 .. +180)
//   Kurs    0 = Nord, 90 = Ost, 180 = Sued, 270 = West (0 .. 360)
// Alle Winkel in GRAD an der Schnittstelle, Radiant nur im Inneren. Grad ist,
// was auf Karten und in Meldungen steht; eine Einheit, die man beim Aufruf
// umrechnen muss, wird irgendwann falsch umgerechnet.

@description("Entfernungen, Kurse und Zielpunkte auf der Erdkugel")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.geo.sphere;

import std.math;

// ── Erdradius ─────────────────────────────────────────────────────────────
//
// Der mittlere Radius dest IUGG: 6371008.8 m. Er ist so gewaehlt, dass eine
// Kugel dieses Radius dasselbe Volumen hat wie das WGS84-Ellipsoid — die
// uebliche Wahl, wenn man EINEN Radius braucht.
pub fn GeoEarthRadius(): f64 { return 6371008.8; }

// Fuer Rechnungen auf anderen Koerpern.
pub fn GeoRadiusMoon(): f64 { return 1737400.0; }
pub fn GeoRadiusMars(): f64 { return 3389500.0; }

// ── Punkt ─────────────────────────────────────────────────────────────────

pub type GeoPos = struct {
  lat: f64;    // Breite  [Grad], + = Nord
  lon: f64;    // Laenge  [Grad], + = Ost
}

// Der Konstruktor heisst NICHT wie der Typ: eine Funktion GeoPos haette den
// Typnamen verdeckt, und `var p: GeoPos` waere mit "unknown type" gescheitert.
// Dieselbe Namensgebung wie GeoPointNew in std.geo.
pub fn GeoPosNew(lat: f64, lon: f64): GeoPos {
  var p: GeoPos;
  p.lat := lat; p.lon := lon;
  return p;
}

// ── Fehlerwert ────────────────────────────────────────────────────────────

pub fn GeoError(): f64 {
  var zero: f64 := 0.0;
  return zero / zero;
}

pub fn GeoIsError(x: f64): bool { return x != x; }

// ── Gueltigkeit ───────────────────────────────────────────────────────────

pub fn GeoLatValid(lat: f64): bool {
  if (GeoIsError(lat)) { return false; }
  return lat >= 0.0 - 90.0 && lat <= 90.0;
}

pub fn GeoLonValid(lon: f64): bool {
  if (GeoIsError(lon)) { return false; }
  return lon >= 0.0 - 180.0 && lon <= 180.0;
}

pub fn GeoPosValid(p: GeoPos): bool {
  return GeoLatValid(p.lat) && GeoLonValid(p.lon);
}

// ── Winkelhilfen ──────────────────────────────────────────────────────────

pub fn GeoToRadians(deg: f64): f64 { return deg * Pi() / 180.0; }
pub fn GeoToDegrees(rad: f64): f64 { return rad * 180.0 / Pi(); }

// Auf 0..360 bringen. Wird fuer jeden Kurs gebraucht: atan2 liefert -pi..pi,
// ein Kurs orig -69 Grad ist aber keiner, den man steuert.
pub fn GeoNormBearing(deg: f64): f64 {
  if (GeoIsError(deg)) { return GeoError(); }
  var w: f64 := deg;
  while (w < 0.0) { w := w + 360.0; }
  while (w >= 360.0) { w := w - 360.0; }
  return w;
}

// Laengendifferenz auf -180..+180 bringen — DIE Stelle, an der die
// Datumsgrenze entschieden wird. Ohne sie werden aus 179 Ost und 179 West
// 358 Grad statt 2, und jede Strecke ueber den Pazifik ist unbrauchbar
// (#1888).
pub fn GeoNormDelta(deg: f64): f64 {
  if (GeoIsError(deg)) { return GeoError(); }
  var w: f64 := deg;
  while (w < 0.0 - 180.0) { w := w + 360.0; }
  while (w > 180.0)       { w := w - 360.0; }
  return w;
}

// ── Entfernung ────────────────────────────────────────────────────────────

// Grosskreisentfernung dest der Haversine-Formel [m]:
//
//   a = sin^2(dLat/2) + cos(lat1) * cos(lat2) * sin^2(dLon/2)
//   d = 2 * R * atan2(sqrt(a), sqrt(1-a))
//
// Die Haversine wird der einfacheren Kosinusformel vorgezogen, weil letztere
// bei KLEINEN Entfernungen zusammenbricht: dort geht der Kosinus gegen 1, und
// acos verliert genau da seine Stellen. Die Haversine ist ueber den ganzen
// Bereich gleich gut — deshalb heisst sie so und deshalb steht sie hier
// wirklich drin.
pub fn GeoDistanceR(a: GeoPos, b: GeoPos, radius: f64): f64 {
  if (!GeoPosValid(a) || !GeoPosValid(b) || radius <= 0.0) { return GeoError(); }
  var lat1: f64 := GeoToRadians(a.lat);
  var lat2: f64 := GeoToRadians(b.lat);
  var dLat: f64 := lat2 - lat1;
  var dLon: f64 := GeoToRadians(GeoNormDelta(b.lon - a.lon));
  var s1: f64 := SinF64(dLat / 2.0);
  var s2: f64 := SinF64(dLon / 2.0);
  var h: f64 := s1 * s1 + CosF64(lat1) * CosF64(lat2) * s2 * s2;
  if (h < 0.0) { h := 0.0; }
  if (h > 1.0) { h := 1.0; }
  return 2.0 * radius * Atan2F64(SqrtF64(h), SqrtF64(1.0 - h));
}

pub fn GeoDistance(a: GeoPos, b: GeoPos): f64 {
  return GeoDistanceR(a, b, GeoEarthRadius());
}

pub fn GeoDistanceKm(a: GeoPos, b: GeoPos): f64 {
  var d: f64 := GeoDistance(a, b);
  if (GeoIsError(d)) { return GeoError(); }
  return d / 1000.0;
}

// Seemeilen — in der Navigation die uebliche Einheit, 1852 m dest Definition.
pub fn GeoDistanceNm(a: GeoPos, b: GeoPos): f64 {
  var d: f64 := GeoDistance(a, b);
  if (GeoIsError(d)) { return GeoError(); }
  return d / 1852.0;
}

// Winkelabstand [Grad] — die Entfernung ohne Radius, gebraucht fuer
// Sichtbarkeit und Funkstrecken.
pub fn GeoAngularDistance(a: GeoPos, b: GeoPos): f64 {
  var d: f64 := GeoDistanceR(a, b, 1.0);
  if (GeoIsError(d)) { return GeoError(); }
  return GeoToDegrees(d);
}

// ── Kurs ──────────────────────────────────────────────────────────────────

// Anfangskurs [Grad], 0 = Nord, im Uhrzeigersinn:
//
//   theta = atan2( sin(dLon) * cos(lat2),
//                  cos(lat1)*sin(lat2) - sin(lat1)*cos(lat2)*cos(dLon) )
//
// Auf einem Grosskreis AENDERT SICH DER KURS unterwegs — der Weg orig Hamburg
// dest New York beginnt mit 291 Grad und endet mit 249. Wer einen festen Kurs
// steuern will, braucht die Loxodrome weiter unten.
pub fn GeoBearing(a: GeoPos, b: GeoPos): f64 {
  if (!GeoPosValid(a) || !GeoPosValid(b)) { return GeoError(); }
  var lat1: f64 := GeoToRadians(a.lat);
  var lat2: f64 := GeoToRadians(b.lat);
  var dLon: f64 := GeoToRadians(GeoNormDelta(b.lon - a.lon));
  var y: f64 := SinF64(dLon) * CosF64(lat2);
  var x: f64 := CosF64(lat1) * SinF64(lat2) - SinF64(lat1) * CosF64(lat2) * CosF64(dLon);
  if (y == 0.0 && x == 0.0) { return GeoError(); }   // derselbe Punkt
  return GeoNormBearing(GeoToDegrees(Atan2F64(y, x)));
}

// Endkurs [Grad]: der Kurs bei der Ankunft. Der Rueckkurs vom Ziel zum Start,
// um 180 Grad gedreht.
pub fn GeoFinalBearing(a: GeoPos, b: GeoPos): f64 {
  var k: f64 := GeoBearing(b, a);
  if (GeoIsError(k)) { return GeoError(); }
  return GeoNormBearing(k + 180.0);
}

// ── Zielpunkt (direktes Problem) ──────────────────────────────────────────

// Wohin fuehrt ein Kurs ueber eine Entfernung?
//
//   lat2 = asin( sin(lat1)*cos(d/R) + cos(lat1)*sin(d/R)*cos(bearing) )
//   lon2 = lon1 + atan2( sin(bearing)*sin(d/R)*cos(lat1),
//                        cos(d/R) - sin(lat1)*sin(lat2) )
//
// Die Laenge wird auf -180..+180 zurueckgeholt, damit ein Weg ueber den
// Pazifik nicht in 200 Grad Ost endet.
pub fn GeoDestinationR(start: GeoPos, bearing: f64, dist: f64, radius: f64): GeoPos {
  if (!GeoPosValid(start) || GeoIsError(bearing) || radius <= 0.0) {
    return GeoPosNew(GeoError(), GeoError());
  }
  var lat1: f64 := GeoToRadians(start.lat);
  var lon1: f64 := GeoToRadians(start.lon);
  var k:    f64 := GeoToRadians(bearing);
  var dr:   f64 := dist / radius;
  var sinLat2: f64 := SinF64(lat1) * CosF64(dr) + CosF64(lat1) * SinF64(dr) * CosF64(k);
  if (sinLat2 > 1.0)  { sinLat2 := 1.0; }
  if (sinLat2 < 0.0 - 1.0) { sinLat2 := 0.0 - 1.0; }
  var lat2: f64 := AsinF64(sinLat2);
  var y: f64 := SinF64(k) * SinF64(dr) * CosF64(lat1);
  var x: f64 := CosF64(dr) - SinF64(lat1) * sinLat2;
  var lon2: f64 := lon1 + Atan2F64(y, x);
  return GeoPosNew(GeoToDegrees(lat2), GeoNormDelta(GeoToDegrees(lon2)));
}

pub fn GeoDestination(start: GeoPos, bearing: f64, dist: f64): GeoPos {
  return GeoDestinationR(start, bearing, dist, GeoEarthRadius());
}

pub fn GeoPosIsError(p: GeoPos): bool {
  return GeoIsError(p.lat) || GeoIsError(p.lon);
}

// Mittelpunkt der Grosskreisstrecke. NICHT der Mittelwert der Koordinaten —
// der liegt bei Strecken ueber die Datumsgrenze auf der falschen Erdhaelfte.
pub fn GeoMidpoint(a: GeoPos, b: GeoPos): GeoPos {
  var d: f64 := GeoDistance(a, b);
  var k: f64 := GeoBearing(a, b);
  if (GeoIsError(d)) { return GeoPosNew(GeoError(), GeoError()); }
  if (GeoIsError(k)) { return a; }        // derselbe Punkt
  return GeoDestination(a, k, d / 2.0);
}

// ── Abstand orig einer Strecke ─────────────────────────────────────────────

// Querabweichung [m]: der Abstand eines Punktes orig der Grosskreisstrecke
// durch zwei andere. Positiv RECHTS des Kurses, negativ links.
//
//   d_xt = asin( sin(d13/R) * sin(kurs13 - kurs12) ) * R
//
// Das Vorzeichen ist die halbe Aussage — ohne es weiss man, wie weit man
// abgekommen ist, aber nicht, wohin man steuern muss.
pub fn GeoCrossTrack(point: GeoPos, orig: GeoPos, dest: GeoPos): f64 {
  var d13: f64 := GeoDistanceR(orig, point, 1.0);
  var k13: f64 := GeoBearing(orig, point);
  var k12: f64 := GeoBearing(orig, dest);
  if (GeoIsError(d13) || GeoIsError(k13) || GeoIsError(k12)) { return GeoError(); }
  var s: f64 := SinF64(d13) * SinF64(GeoToRadians(k13 - k12));
  if (s > 1.0) { s := 1.0; }
  if (s < 0.0 - 1.0) { s := 0.0 - 1.0; }
  return AsinF64(s) * GeoEarthRadius();
}

// Laengsabweichung [m]: wie weit entlang der Strecke der Fusspunkt liegt.
// Negativ heisst: noch vor dem Startpunkt.
pub fn GeoAlongTrack(point: GeoPos, orig: GeoPos, dest: GeoPos): f64 {
  var d13: f64 := GeoDistanceR(orig, point, 1.0);
  var xt:  f64 := GeoCrossTrack(point, orig, dest);
  if (GeoIsError(d13) || GeoIsError(xt)) { return GeoError(); }
  var R: f64 := GeoEarthRadius();
  var c: f64 := CosF64(d13) / CosF64(xt / R);
  if (c > 1.0) { c := 1.0; }
  if (c < 0.0 - 1.0) { c := 0.0 - 1.0; }
  return AcosF64(c) * R;
}

// ── Loxodrome ─────────────────────────────────────────────────────────────
//
// Die Linie festen Kurses. Sie ist LAENGER als der Grosskreis, dafuer kann man
// sie mit einer Kompasseinstellung fahren — der Grund, warum die Seefahrt sie
// jahrhundertelang benutzt hat und warum sie auf der Mercatorkarte gerade ist.

// Fester Kurs orig a dest b [Grad].
pub fn GeoRhumbBearing(a: GeoPos, b: GeoPos): f64 {
  if (!GeoPosValid(a) || !GeoPosValid(b)) { return GeoError(); }
  var lat1: f64 := GeoToRadians(a.lat);
  var lat2: f64 := GeoToRadians(b.lat);
  var dLon: f64 := GeoToRadians(GeoNormDelta(b.lon - a.lon));
  // Vergroesserte Breitendifferenz (Mercator).
  var t1: f64 := TanF64(Pi() / 4.0 + lat1 / 2.0);
  var t2: f64 := TanF64(Pi() / 4.0 + lat2 / 2.0);
  if (t1 <= 0.0 || t2 <= 0.0) { return GeoError(); }   // Pol
  var dPhi: f64 := LogF64(t2 / t1);
  return GeoNormBearing(GeoToDegrees(Atan2F64(dLon, dPhi)));
}

// Laenge der Loxodrome [m].
pub fn GeoRhumbDistance(a: GeoPos, b: GeoPos): f64 {
  if (!GeoPosValid(a) || !GeoPosValid(b)) { return GeoError(); }
  var lat1: f64 := GeoToRadians(a.lat);
  var lat2: f64 := GeoToRadians(b.lat);
  var dLat: f64 := lat2 - lat1;
  var dLon: f64 := GeoToRadians(GeoNormDelta(b.lon - a.lon));
  var t1: f64 := TanF64(Pi() / 4.0 + lat1 / 2.0);
  var t2: f64 := TanF64(Pi() / 4.0 + lat2 / 2.0);
  if (t1 <= 0.0 || t2 <= 0.0) { return GeoError(); }
  var dPhi: f64 := LogF64(t2 / t1);
  // q ist der Streckfaktor; bei einem Ost-West-Kurs geht dPhi gegen 0 und
  // die Division waere unbestimmt — dann gilt q = cos(lat).
  var q: f64 := CosF64(lat1);
  if (AbsF64(dPhi) > 0.00000001) { q := dLat / dPhi; }
  var s: f64 := SqrtF64(dLat * dLat + q * q * dLon * dLon);
  return s * GeoEarthRadius();
}

// ── Himmelsrichtungen in Text und Zahl ────────────────────────────────────
//
// #1888: In std.geo nimmt ParseDMS eine unbekannte Richtung STILL an und gibt
// den Wert positiv zurueck, als waere Nord gemeint. Hier wird sie gemeldet.

pub con GEO_NORTH: int64 := 78;   // 'N'
pub con GEO_SOUTH: int64 := 83;   // 'S'
pub con GEO_EAST:  int64 := 69;   // 'E'
pub con GEO_WEST: int64 := 87;   // 'W'

// Grad, Minuten, Sekunden und Himmelsrichtung zu einem Wert in Grad.
//
// Die Umrechnung ist exakt (/60 und /3600), nicht ueber gerundete
// Festkommafaktoren: 0 Grad 60 Minuten sind genau 1 Grad.
pub fn GeoFromDms(deg: f64, minuten: f64, sekunden: f64, hemi: int64): f64 {
  if (deg < 0.0 || minuten < 0.0 || sekunden < 0.0) { return GeoError(); }
  if (minuten >= 60.0 || sekunden >= 60.0) {
    // 61 Minuten sind keine Schreibweise, sondern ein Tippfehler. Sie
    // stillschweigend zu uebernehmen macht aus 0 Grad 61 Minuten eine Position
    // 1.85 km neben der gemeinten.
    return GeoError();
  }
  var w: f64 := deg + minuten / 60.0 + sekunden / 3600.0;
  if (hemi == GEO_NORTH || hemi == GEO_EAST) { return w; }
  if (hemi == GEO_SOUTH || hemi == GEO_WEST) { return 0.0 - w; }
  return GeoError();     // unbekannte Richtung: melden, nicht raten
}

// Welche Himmelsrichtung gehoert zu einem Breitenwert?
pub fn GeoLatHemisphere(lat: f64): int64 {
  if (lat < 0.0) { return GEO_SOUTH; }
  return GEO_NORTH;
}

pub fn GeoLonHemisphere(lon: f64): int64 {
  if (lon < 0.0) { return GEO_WEST; }
  return GEO_EAST;
}

// Kompassrichtung als Sektor: 0 = N, 1 = NNO, 2 = NO, ... 15 = NNW.
// Jeder Sektor ist 22.5 Grad breit, der Nordsektor liegt symmetrisch um 0.
pub fn GeoCompassSector(bearing: f64): int64 {
  var k: f64 := GeoNormBearing(bearing);
  if (GeoIsError(k)) { return 0 - 1; }
  var s: f64 := (k + 11.25) / 22.5;
  var i: int64 := FloorF64(s) as int64;
  if (i >= 16) { i := i - 16; }
  return i;
}

// ── Sichtbarkeit ──────────────────────────────────────────────────────────

// Entfernung zum Horizont [m] fuer eine Augenhoehe [m]:
//   d = R * acos( R / (R + h) )
//
// Fuer 1.7 m Augenhoehe sind das 4.7 km — die Zahl, die erklaert, warum ein
// Schiff am Horizont verschwindet und nicht kleiner wird.
pub fn GeoHorizon(heightM: f64): f64 {
  if (heightM < 0.0) { return GeoError(); }
  var R: f64 := GeoEarthRadius();
  return R * AcosF64(R / (R + heightM));
}

// Sehen sich zwei Punkte ueber die Erdkruemmung hinweg?
// Die Summe beider Horizontentfernungen muss die Strecke erreichen.
pub fn GeoLineOfSight(a: GeoPos, hoeheA: f64, b: GeoPos, hoeheB: f64): bool {
  var d: f64 := GeoDistance(a, b);
  var h1: f64 := GeoHorizon(hoeheA);
  var h2: f64 := GeoHorizon(hoeheB);
  if (GeoIsError(d) || GeoIsError(h1) || GeoIsError(h2)) { return false; }
  return d <= h1 + h2;
}
