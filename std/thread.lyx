// std/thread.lyx
// Native Linux threading via clone(2) + futex(2), no libpthread dependency.
//
// Thread creation:  sys_clone(CLONE_VM|...) — shares address space.
//                   Child calls the function via _indirect_call_1(func, arg).
// Thread join:      CLONE_PARENT_SETTID schreibt die TID synchron, bevor clone
//                   zurueckkehrt; CLONE_CHILD_CLEARTID nullt denselben Slot beim
//                   Thread-Ende und weckt den futex.
// Mutex:            futex-basiert, Zustandswechsel per atomic_cas/xchg.
// Condition var:    futex on a sequence counter at cond.ptr (mmap'd).
// Atomics:          echte lock-Instruktionen ueber die atomic_*-Builtins.
// TLS:              global mmap table, tid → slot → key values (Option A).

@description("Thread creation and synchronization via clone(2) + futex(2)")
@author("Andreas Röne")
@copyright("2024-2026 Andreas Röne")
unit std.thread;

import std.alloc;
// ============================================================================
// clone(2) flags (x86-64 Linux)
// ============================================================================
con CLONE_VM:             int64 := 256;
con CLONE_FS:             int64 := 512;
con CLONE_FILES:          int64 := 1024;
con CLONE_SIGHAND:        int64 := 2048;
con CLONE_THREAD:         int64 := 65536;
con CLONE_SYSVSEM:        int64 := 262144;
con CLONE_CHILD_SETTID:   int64 := 16777216;
con CLONE_CHILD_CLEARTID: int64 := 2097152;
con CLONE_PARENT_SETTID:  int64 := 1048576;

// THREAD_FLAGS = VM|FS|FILES|SIGHAND|THREAD|SYSVSEM|PARENT_SETTID|CHILD_CLEARTID
//
// PARENT_SETTID statt CHILD_SETTID: CHILD_SETTID schreibt die TID erst, wenn der
// Kindthread zum ersten Mal laeuft. Der Elternprozess las den Slot direkt nach
// clone und fand dort noch die 0, mit der er ihn selbst vorbelegt hatte --
// ThreadJoin hielt den Thread damit fuer bereits beendet, kehrte sofort zurueck
// und gab den TID-Slot frei, waehrend der Kindthread gerade erst startete.
// PARENT_SETTID schreibt die TID synchron, bevor clone zurueckkehrt.
con THREAD_FLAGS: int64 := 3477248;

con THREAD_STACK_SIZE: int64 := 2097152;  // 2 MB per thread

// ============================================================================
// TLS constants
// ============================================================================
con MAX_TLS_THREADS: int64 := 64;   // max concurrent threads tracked
con MAX_TLS_KEYS:    int64 := 32;   // max TLS keys per thread
// slot layout: 8 bytes tid + 32*8 bytes values = 264 bytes
con TLS_SLOT_SIZE:   int64 := 264;
con TLS_TABLE_SIZE:  int64 := 16896; // 64 * 264

// Global TLS table (mmap pointer, 0 = not yet initialised).
// Initialised lazily by TLSKeyCreate(); must be called before TLSSetValue/Get.
var g_tls_table:     int64 := 0;
var g_tls_key_count: int64 := 0;

// ============================================================================
// futex(2) operations
// ============================================================================
con FUTEX_WAIT:     int64 := 0;
con FUTEX_WAKE:     int64 := 1;
con FUTEX_WAKE_ALL: int64 := 2147483647;  // INT_MAX

// ============================================================================
// Public types
// ============================================================================

// Thread handle: mmap'd 4-byte TID slot.
// Kernel writes TID here at start (CLONE_CHILD_SETTID) and zeroes it at exit
// (CLONE_CHILD_CLEARTID) with a futex wake — used by ThreadJoin.
pub type Thread = struct {
  handle: int64;   // ptr to mmap'd 32-bit TID slot; 0 = invalid
  tid:    int64;   // TID as returned by clone() in parent
  stack:  int64;   // Basis des Kind-Stacks; von ThreadJoin freigegeben
};

// Mutex: futex on a mmap'd 32-bit word.
// 0 = unlocked, 1 = locked (no waiters), 2 = locked (waiters present).
pub type Mutex = struct {
  ptr:   int64;   // ptr to mmap'd 32-bit futex word
  owner: int64;   // TID of owner (informational)
};

// Condition variable: futex on a mmap'd 32-bit sequence counter.
pub type Cond = struct {
  ptr: int64;
};

// Thread-local storage key (index into the per-thread slot, ≥ 1)
pub type TLSKey = int64;

// Shared memory buffer accessible by all threads.
pub type SharedMem = struct {
  data: int64;
  size: int64;
};

// Atomic word (64-bit, pointer-based).
pub type Atomic = struct {
  ptr: int64;   // ptr to mmap'd int64
};

// ============================================================================
// Thread creation and management
// ============================================================================

// Handoff-Block fuer die Uebergabe an den Kindthread:
//   [0] func   [8] arg   [16] uebernommen-Flag   [24] Spawn-Lock
//
// clone(2) setzt im Kind nur RSP, RBP bleibt unveraendert -- der Kindthread
// sieht also zunaechst den Frame des Elternteils. Die fruehere Fassung nutzte
// das aus und las 'func' und 'arg' direkt daraus. Das ist ueber die MAPPING-
// Frage hinaus falsch: CLONE_VM garantiert den geteilten Adressraum, nicht die
// LEBENSDAUER des Frames. Sobald ThreadCreate zurueckkehrte, wurde genau dieser
// Speicher wiederverwendet -- schon ein direkt folgendes ThreadJoin genuegte --
// und der Kindthread sprang auf einen ueberschriebenen Funktionszeiger.
// Ohne Frame-Wiederverwendung lief es zufaellig durch, mit Join segfaultete es.
//
// Jetzt liegen func und arg in diesem Heap-Block, und der Kindthread springt
// zuerst in _thrTrampoline: dessen Prologue legt einen eigenen Frame auf dem
// KIND-Stack an, ab da sind Locals dort sicher. Der Elternteil kehrt erst
// zurueck, wenn der Kindthread die Werte uebernommen hat.
pub var _thrCtl: int64;

fn _thrCtlEnsure(): int64 {
  if (_thrCtl == 0) { _thrCtl := alloc(32); }
  return _thrCtl;
}

// Laeuft bereits mit eigenem Frame auf dem Kind-Stack.
fn _thrTrampoline(unused: int64): int64 {
  var c: int64 := _thrCtl;
  var f: int64 := peek64(c);
  var g: int64 := peek64(c + 8);
  var taken: int64 := atomic_store(c + 16, 1);   // Elternteil freigeben
  _indirect_call_1(f, g);
  return 0;
}

// ThreadCreate: spawns a new thread that calls func(arg).
// Returns a Thread; handle == 0 on allocation failure.
pub fn ThreadCreate(func: int64, arg: int64): Thread {
  var t: Thread;
  t.handle := 0;
  t.tid    := 0;
  t.stack  := 0;

  var ctl: int64 := _thrCtlEnsure();
  if (ctl == 0) { return t; }

  // Spawns serialisieren: der Handoff-Block ist prozessweit einer.
  while (atomic_cas(ctl + 24, 0, 1) != 0) { }
  poke64(ctl, func);
  poke64(ctl + 8, arg);
  var resetTaken: int64 := atomic_store(ctl + 16, 0);

  var childStack: int64 := alloc(THREAD_STACK_SIZE);
  if (childStack == 0) {
    var ul1: int64 := atomic_store(ctl + 24, 0);
    return t;
  }

  // TID slot: kernel writes the TID here on start and zeroes it on exit.
  var tidSlot: int64 := alloc(8);
  if (tidSlot == 0) {
    free(childStack, THREAD_STACK_SIZE);
    var ul2: int64 := atomic_store(ctl + 24, 0);
    return t;
  }
  poke32(tidSlot, 0);

  var stackTop: int64 := childStack + THREAD_STACK_SIZE;

  // sys_clone(flags, stack_top, parent_tidptr, child_tidptr, tls=0)
  // tidSlot dient beidem: PARENT_SETTID schreibt die TID synchron hinein,
  // CHILD_CLEARTID nullt ihn beim Thread-Ende und weckt den futex.
  var tid: int64 := sys_clone(THREAD_FLAGS, stackTop, tidSlot, tidSlot, 0);

  if (tid == 0) {
    // Kind: NUR Konstanten verwenden -- kein Zugriff auf Frame-Locals, deren
    // Lebensdauer hier nicht garantiert ist. _thrTrampoline holt func und arg
    // aus dem Handoff-Block, sobald es einen eigenen Frame hat.
    _indirect_call_1(_thrTrampoline, 0);
    exit(0);  // syscall 60 — beendet nur diesen Thread
  }

  if (tid < 0) {
    free(tidSlot, 8);
    free(childStack, THREAD_STACK_SIZE);
    var ul3: int64 := atomic_store(ctl + 24, 0);
    return t;
  }

  // Warten, bis der Kindthread func und arg uebernommen hat -- erst danach darf
  // der Handoff-Block neu belegt und dieser Frame aufgegeben werden.
  while (atomic_load(ctl + 16) == 0) { }
  var ul4: int64 := atomic_store(ctl + 24, 0);

  t.handle := tidSlot;
  t.tid    := tid;
  t.stack  := childStack;
  return t;
}

// ThreadSelf: returns the TID of the calling thread.
pub fn ThreadSelf(): int64 {
  return sys_gettid();
}

// ThreadIsRunning: 1 while the thread is still alive.
pub fn ThreadIsRunning(t: Thread): int64 {
  if (t.handle == 0) { return 0; }
  if (peek32(t.handle) != 0) { return 1; }
  return 0;
}

// ThreadJoin: blocks until the thread exits, then frees the TID slot.
pub fn ThreadJoin(t: Thread): void {
  if (t.handle == 0) { return; }
  // futex_wait returns EAGAIN immediately if *tidSlot already changed;
  // the while loop handles both spurious wakeups and the already-exited case.
  var cur: int64 := peek32(t.handle);
  while (cur != 0) {
    sys_futex(t.handle, FUTEX_WAIT, cur, 0, 0, 0);
    cur := peek32(t.handle);
  }
  free(t.handle, 8);

  // Kind-Stack freigeben. Sicher genau ab hier: den TID-Slot nullt und den
  // futex weckt der Kernel in mm_release() waehrend do_exit() -- zu diesem
  // Zeitpunkt fuehrt der Thread keinen Nutzercode mehr aus, er laeuft nur noch
  // auf seinem Kernel-Stack. Wer die Schleife oben verlassen hat, weiss also,
  // dass dieser Speicher nicht mehr benutzt wird. musl macht es in
  // pthread_join genauso.
  //
  // Ohne die Freigabe leckte jeder verbundene Thread THREAD_STACK_SIZE
  // (2 MB): unter `ulimit -v 1048576` scheiterte ThreadCreate reproduzierbar
  // beim 509. Thread.
  //
  // Hier steht bewusst munmap und nicht free: `free` ist im Compiler als
  // Builtin registriert, das NICHTS tut ("no-op in bootstrap ... leaks are
  // acceptable", src/codegen_x86.lyx). Dieses Builtin verdeckt das free aus
  // std/alloc.lyx, das eigentlich munmap aufruft -- mit free bliebe der Stack
  // also liegen. Gemessen: 1000x alloc(2 MB)+free(2 MB) scheitert unter
  // `ulimit -v 262144` beim 127. Durchlauf, dieselbe Schleife mit munmap
  // laeuft durch.
  if (t.stack != 0) { munmap(t.stack, THREAD_STACK_SIZE); }
}

// ============================================================================
// Mutex
// ============================================================================

// MutexNew: allocates a new mutex backed by mmap'd memory.
pub fn MutexNew(): Mutex {
  var m: Mutex;
  m.ptr   := alloc(8);
  m.owner := 0;
  if (m.ptr != 0) { poke32(m.ptr, 0); }
  return m;
}

// MutexFree: releases the mutex memory.
pub fn MutexFree(m: Mutex): void {
  if (m.ptr != 0) { free(m.ptr, 8); }
}

// MutexLock: acquires the mutex, sleeping via futex when contended.
//
// Zustaende: 0 = frei, 1 = gehalten, 2 = gehalten mit Wartenden.
// Die fruehere Fassung las den Zustand mit peek32 und schrieb ihn mit poke32 --
// zwei Threads konnten beide die 0 sehen und beide "gewinnen". Jetzt wird der
// Uebergang 0 -> 1 mit einem einzigen atomic_cas gemacht; im umkaempften Fall
// setzt ein atomic_store (xchg) auf 2 und liefert zugleich den alten Wert.
pub fn MutexLock(m: Mutex): void {
  if (m.ptr == 0) { return; }
  // Schneller Pfad: unbestritten frei
  if (atomic_cas(m.ptr, 0, 1) == 0) { return; }
  // Umkaempft: auf 2 setzen und schlafen, bis der alte Wert 0 war
  while (atomic_store(m.ptr, 2) != 0) {
    sys_futex(m.ptr, FUTEX_WAIT, 2, 0, 0, 0);
  }
}

// MutexUnlock: releases the mutex and wakes one waiter if any.
pub fn MutexUnlock(m: Mutex): void {
  if (m.ptr == 0) { return; }
  // Freigeben und alten Zustand in einem Schritt lesen: nur bei 2 gab es Warter.
  if (atomic_store(m.ptr, 0) == 2) {
    sys_futex(m.ptr, FUTEX_WAKE, 1, 0, 0, 0);
  }
}

// MutexTryLock: non-blocking attempt.  Returns 1 on success, 0 if busy.
pub fn MutexTryLock(m: Mutex): int64 {
  if (m.ptr == 0) { return 0; }
  if (atomic_cas(m.ptr, 0, 1) == 0) { return 1; }
  return 0;
}

// ============================================================================
// Condition variable
// ============================================================================

// CondNew: allocates a new condition variable.
pub fn CondNew(): Cond {
  var c: Cond;
  c.ptr := alloc(8);
  if (c.ptr != 0) { poke32(c.ptr, 0); }
  return c;
}

// CondFree: releases the condition variable memory.
pub fn CondFree(c: Cond): void {
  if (c.ptr != 0) { free(c.ptr, 8); }
}

// CondWait: releases mutex, waits for a signal, reacquires mutex.
pub fn CondWait(c: Cond, m: Mutex): void {
  if (c.ptr == 0) { return; }
  var seq: int64 := peek32(c.ptr);
  MutexUnlock(m);
  sys_futex(c.ptr, FUTEX_WAIT, seq, 0, 0, 0);
  MutexLock(m);
}

// CondSignal: wakes one thread waiting on the condition.
pub fn CondSignal(c: Cond): void {
  if (c.ptr == 0) { return; }
  poke32(c.ptr, peek32(c.ptr) + 1);
  sys_futex(c.ptr, FUTEX_WAKE, 1, 0, 0, 0);
}

// CondBroadcast: wakes all threads waiting on the condition.
pub fn CondBroadcast(c: Cond): void {
  if (c.ptr == 0) { return; }
  poke32(c.ptr, peek32(c.ptr) + 1);
  sys_futex(c.ptr, FUTEX_WAKE, FUTEX_WAKE_ALL, 0, 0, 0);
}

// ============================================================================
// Shared memory
// ============================================================================

pub fn SharedMemCreate(size: int64): SharedMem {
  var mem: SharedMem;
  mem.data := alloc(size);
  mem.size := size;
  return mem;
}

pub fn SharedMemFree(mem: SharedMem): void {
  if (mem.data != 0) { free(mem.data, mem.size); }
}

// ============================================================================
// Atomic operations
// Note: peek64/poke64 on naturally aligned addresses are single-bus-cycle
// Alle Operationen laufen ueber die atomic_*-Builtins und sind damit echt
// atomar (lock xadd / lock cmpxchg / xchg auf x86-64).
//
// Frueher war das nicht so: AtomicAdd und CAS lasen mit peek64 und schrieben
// mit poke64, waren also trotz des Namens ein Read-Modify-Write mit Rennen --
// zwei Threads konnten denselben Ausgangswert lesen und einer der beiden
// Zuwaechse ging verloren. Der Kommentar an dieser Stelle wies auf das Rennen
// hin und nannte als Grund, Lyx biete kein lock-cmpxchg; seit die
// atomic_*-Builtins auch im ELF-Codegen emittiert werden, gilt das nicht mehr.
// ============================================================================

pub fn AtomicNew(initial: int64): Atomic {
  var a: Atomic;
  a.ptr := alloc(8);
  if (a.ptr != 0) { poke64(a.ptr, initial); }
  return a;
}

pub fn AtomicFree(a: Atomic): void {
  if (a.ptr != 0) { free(a.ptr, 8); }
}

pub fn AtomicLoad(a: Atomic): int64 {
  if (a.ptr == 0) { return 0; }
  return atomic_load(a.ptr);
}

pub fn AtomicStore(a: Atomic, val: int64): void {
  if (a.ptr == 0) { return; }
  // atomic_store liefert den alten Wert; hier nicht gebraucht.
  var prev: int64 := atomic_store(a.ptr, val);
}

// AtomicAdd: addiert delta und liefert den NEUEN Wert (unveraenderter Vertrag).
// atomic_fetch_add liefert den alten Wert, daher delta addieren.
pub fn AtomicAdd(a: Atomic, delta: int64): int64 {
  if (a.ptr == 0) { return 0; }
  return atomic_fetch_add(a.ptr, delta) + delta;
}

// CAS: liefert 1 bei Erfolg, 0 wenn der aktuelle Wert nicht expected war.
// atomic_cas liefert den alten Wert; Erfolg heisst "alter Wert == expected".
pub fn CAS(a: Atomic, expected: int64, newVal: int64): int64 {
  if (a.ptr == 0) { return 0; }
  if (atomic_cas(a.ptr, expected, newVal) == expected) { return 1; }
  return 0;
}

// ============================================================================
// Thread-local storage
//
// Implementation: a process-global mmap'd table, indexed by thread slot.
// Each slot holds the TID of the owning thread plus MAX_TLS_KEYS int64 values.
// Slot lookup is O(MAX_TLS_THREADS) linear scan; allocation is first-fit.
//
// Note: TLSKeyCreate() initialises the table and must be called (from any
// thread) before TLSSetValue/GetValue. Key allocation is not thread-safe —
// call TLSKeyCreate() during single-threaded startup only.
// ============================================================================

// Internal: initialise the TLS table on first call.
fn _tlsInit(): void {
    if (g_tls_table != 0) { return; }
    // MAP_ANONYMOUS pages are zero-initialised, so tid fields start at 0 (unused).
    g_tls_table     := alloc(TLS_TABLE_SIZE);
    g_tls_key_count := 1;  // key 0 reserved; valid keys start at 1
}

// Internal: find (or allocate) the TLS slot for `tid`.
// Returns slot base address, or 0 if the table is full.
fn _tlsFindSlot(tid: int64): int64 {
    if (g_tls_table == 0) { return 0; }
    var i: int64 := 0;
    var firstEmpty: int64 := -1;
    while (i < MAX_TLS_THREADS) {
        var slotBase: int64 := g_tls_table + i * TLS_SLOT_SIZE;
        var slotTid: int64 := peek64(slotBase);
        if (slotTid == tid) { return slotBase; }
        if (slotTid == 0 && firstEmpty < 0) { firstEmpty := i; }
        i += 1;
    }
    if (firstEmpty < 0) { return 0; }  // table full
    var newBase: int64 := g_tls_table + firstEmpty * TLS_SLOT_SIZE;
    poke64(newBase, tid);  // claim slot
    return newBase;
}

// TLSKeyCreate: allocate a new TLS key. Returns the key (≥ 1), or 0 on error.
pub fn TLSKeyCreate(): TLSKey {
    _tlsInit();
    if (g_tls_key_count >= MAX_TLS_KEYS) { return 0; }
    var key: int64 := g_tls_key_count;
    g_tls_key_count += 1;
    return key;
}

// TLSSetValue: store `value` under `key` for the calling thread.
// Returns 0 on success, -1 on error.
pub fn TLSSetValue(key: TLSKey, value: int64): int64 {
    if (g_tls_table == 0 || key <= 0 || key >= MAX_TLS_KEYS) { return -1; }
    var tid: int64 := sys_gettid();
    var slot: int64 := _tlsFindSlot(tid);
    if (slot == 0) { return -1; }
    poke64(slot + 8 + key * 8, value);
    return 0;
}

// TLSGetValue: retrieve the value stored under `key` for the calling thread.
// Returns 0 if the key is unset or invalid.
pub fn TLSGetValue(key: TLSKey): int64 {
    if (g_tls_table == 0 || key <= 0 || key >= MAX_TLS_KEYS) { return 0; }
    var tid: int64 := sys_gettid();
    var slot: int64 := _tlsFindSlot(tid);
    if (slot == 0) { return 0; }
    return peek64(slot + 8 + key * 8);
}

// ============================================================================
// WP-17: futex2 -- Neue Synchronisierungs-API (Kernel 5.16+/6.7+)
//
// futex_wait/wake/requeue (454-456) ersetzen die alten FUTEX_WAIT/WAKE-Ops
// mit einer aufgeraeumt(er)en API. futex_waitv (449) erlaubt das simultane
// Warten auf mehrere Futexe -- wie poll(2) fuer Synchronisationsprimitive.
// ============================================================================

// futex2-Groessen-Flags (welche Breite hat die futex-Variable)
pub con FUTEX2_SIZE_U8:  int64 := 0;
pub con FUTEX2_SIZE_U16: int64 := 1;
pub con FUTEX2_SIZE_U32: int64 := 2;  // Standard-Fall: 32-Bit-Futex
pub con FUTEX2_SIZE_U64: int64 := 3;

// FUTEX2_PRIVATE: Futex ist prozess-privat (kein Shared-Memory-Overhead).
pub con FUTEX2_PRIVATE: int64 := 128;  // 0x80

// FUTEX_BITSET_MATCH_ANY: kein Bitset-Filter -- alle Wartenden treffen zu.
pub con FUTEX_BITSET_MATCH_ANY: int64 := 4294967295;  // 0xFFFFFFFF

// CLOCK_MONOTONIC fuer Timeout-Berechnungen
pub con FUTEX2_CLOCK_MONOTONIC: int64 := 1;
pub con FUTEX2_CLOCK_REALTIME:  int64 := 0;

// futex_waitv-Eintrag (24 Bytes):
//   +0:  val   (uint64) -- erwarteter Wert
//   +8:  uaddr (uint64) -- Futex-Adresse
//   +16: flags (uint32) -- FUTEX2_SIZE_* | FUTEX2_PRIVATE
//   +20: reserved (uint32) -- muss 0 sein
pub con FUTEX_WAITV_SIZE:  int64 := 24;
pub con FUTEX_WAITV_VAL:   int64 := 0;
pub con FUTEX_WAITV_UADDR: int64 := 8;
pub con FUTEX_WAITV_FLAGS: int64 := 16;

// Futex2Wait: wartet bis *addr != val (blockiert). Gibt 0 bei Erfolg,
// -EAGAIN (-11) wenn addr schon != val, -ETIMEDOUT (-110) bei Timeout.
// flags: z.B. FUTEX2_SIZE_U32 | FUTEX2_PRIVATE
pub fn Futex2Wait(addr: int64, val: int64, flags: int64): int64 {
  return sys_futex_wait(addr, val, FUTEX_BITSET_MATCH_ANY, flags, 0,
                        FUTEX2_CLOCK_MONOTONIC);
}

// Futex2Wake: weckt bis zu `nr` Wartende an `addr`.
// Gibt Anzahl geweckter Threads zurueck (0 wenn keine warten).
pub fn Futex2Wake(addr: int64, nr: int64, flags: int64): int64 {
  return sys_futex_wake(addr, FUTEX_BITSET_MATCH_ANY, nr, flags);
}

// Futex2WakeAll: weckt alle Wartenden an `addr`.
pub fn Futex2WakeAll(addr: int64, flags: int64): int64 {
  return sys_futex_wake(addr, FUTEX_BITSET_MATCH_ANY, 2147483647, flags);
}

// Futex2WaitV: wartet simultan auf mehrere Futexe (erster EAGAIN-freier gewinnt).
// waiters: Zeiger auf Array von FUTEX_WAITV_SIZE-Byte-Eintraegen (alloc/mmap).
// count:   Anzahl Eintraege (max. 128 laut Kernel).
// Gibt Index des ausloesenden Futex zurueck, oder -EAGAIN/-ETIMEOUT.
pub fn Futex2WaitV(waiters: int64, count: int64): int64 {
  return sys_futex_waitv(waiters, count, 0, 0, FUTEX2_CLOCK_MONOTONIC);
}

// Futex2WaitVEntry: hilfsfunktion -- befuellt einen waitv-Eintrag.
pub fn Futex2WaitVEntry(entry: int64, uaddr: int64, val: int64, flags: int64): int64 {
  poke64(entry + FUTEX_WAITV_VAL,   val);
  poke64(entry + FUTEX_WAITV_UADDR, uaddr);
  poke32(entry + FUTEX_WAITV_FLAGS, flags as int32);
  poke32(entry + FUTEX_WAITV_FLAGS + 4, 0);
  return 0;
}

// Futex2Requeue: verschiebt Wartende von fromAddr nach toAddr.
// flags:     FUTEX2_SIZE_* | FUTEX2_PRIVATE (gilt fuer beide Futexe)
// cmpVal:    erwarteter Wert an fromAddr -- bei Nichtübereinstimmung -EAGAIN.
// nrWake:    diese Anzahl an fromAddr direkt wecken.
// nrRequeue: diese Anzahl nach toAddr umleiten.
// Struct-Layout: val(8)+uaddr(8)+flags(4)+reserved(4) = 24 Bytes je Eintrag (wie futex_waitv).
// Gibt Anzahl gesamtbehandelter Threads zurueck.
pub fn Futex2Requeue(fromAddr: int64, toAddr: int64, flags: int64,
                     cmpVal: int64, nrWake: int64, nrRequeue: int64): int64 {
  var params: int64 := alloc(48);
  if (params == 0) { return -12; }
  poke64(params,      cmpVal);            // waitobj[0].val (compare-Wert)
  poke64(params + 8,  fromAddr);          // waitobj[0].uaddr
  poke32(params + 16, flags as int32);    // waitobj[0].flags
  poke32(params + 20, 0);                 // waitobj[0].reserved
  poke64(params + 24, 0);                 // waitobj[1].val = 0 (unused)
  poke64(params + 32, toAddr);            // waitobj[1].uaddr
  poke32(params + 40, flags as int32);    // waitobj[1].flags
  poke32(params + 44, 0);                 // waitobj[1].reserved
  var r: int64 := sys_futex_requeue(params, 0, nrWake, nrRequeue);
  free(params, 48);
  return r;
}

// ============================================================================
// POSIX-Schicht (#1246)
// ============================================================================
//
// Die Unit-Doku fuehrt diese Namen seit jeher in ihren Funktionstabellen; die
// Huelle dazu fehlte. Der Compiler stellt die Systemaufrufe laengst als
// Builtins bereit (sys_futex, sys_gettid, exit …) — was fehlte, war die
// benannte Schicht darueber.
//
// WICHTIG zur Schreibweise: Diese Funktionen arbeiten mit ROHEN ZEIGERN, so
// wie ihre C-Vorbilder. Ein `pthread_mutex_t` ist hier ein vom Aufrufer
// bereitgestellter Speicherblock von mindestens 4 Byte:
//
//     var m: int64 := alloc(8);
//     pthread_mutex_init(m, 0);
//     pthread_mutex_lock(m);
//     …
//     pthread_mutex_unlock(m);
//     pthread_mutex_destroy(m);
//
// Wer keine C-Schnittstelle nachbauen muss, nimmt besser die Lyx-Form
// (MutexNew/MutexLock/…): sie verwaltet den Speicher selbst.
//
// Kein `extern fn` und kein libc: die Zustandsuebergaenge sind dieselben
// atomaren Operationen, die MutexLock/CondWait benutzen. Eine Zeile wie
// `extern fn pthread_mutex_lock(...)` OHNE link-Klausel haette gar nichts
// gebunden und still 0 geliefert (#1179).

// --- Mutex ------------------------------------------------------------------

// Initialisiert den Mutex-Speicher. `attr` wird nicht ausgewertet (POSIX
// erlaubt 0 fuer die Vorgabe); ein anderer Wert wird NICHT stillschweigend
// uebergangen, sondern gemeldet.
pub fn pthread_mutex_init(mutex: int64, attr: int64): int64 {
  if (mutex == 0) { return -1; }
  if (attr != 0) { return -1; }   // Attribute sind nicht umgesetzt
  poke32(mutex, 0);
  return 0;
}

// Zustaende wie bei MutexLock: 0 = frei, 1 = gehalten, 2 = gehalten mit
// Wartenden. Der Uebergang 0 -> 1 laeuft ueber ein einziges atomic_cas.
pub fn pthread_mutex_lock(mutex: int64): int64 {
  if (mutex == 0) { return -1; }
  if (atomic_cas(mutex, 0, 1) == 0) { return 0; }
  while (atomic_store(mutex, 2) != 0) {
    sys_futex(mutex, FUTEX_WAIT, 2, 0, 0, 0);
  }
  return 0;
}

pub fn pthread_mutex_trylock(mutex: int64): int64 {
  if (mutex == 0) { return -1; }
  if (atomic_cas(mutex, 0, 1) == 0) { return 0; }
  return 16;   // EBUSY
}

pub fn pthread_mutex_unlock(mutex: int64): int64 {
  if (mutex == 0) { return -1; }
  if (atomic_store(mutex, 0) == 2) {
    sys_futex(mutex, FUTEX_WAKE, 1, 0, 0, 0);
  }
  return 0;
}

// POSIX verlangt, dass ein zerstoerter Mutex nicht gehalten wird. Das wird
// geprueft statt angenommen: ein gehaltener Mutex meldet EBUSY, wie in der
// Spezifikation vorgesehen.
pub fn pthread_mutex_destroy(mutex: int64): int64 {
  if (mutex == 0) { return -1; }
  if (peek32(mutex) != 0) { return 16; }   // EBUSY
  return 0;
}

// --- Bedingungsvariablen -----------------------------------------------------

pub fn pthread_cond_init(cond: int64, attr: int64): int64 {
  if (cond == 0) { return -1; }
  if (attr != 0) { return -1; }
  poke32(cond, 0);
  return 0;
}

// Gibt den Mutex frei, wartet auf das Signal und nimmt ihn wieder. Die
// Sequenznummer wird VOR dem Freigeben gelesen — sonst ginge ein Signal
// verloren, das zwischen Freigabe und Warten eintrifft.
pub fn pthread_cond_wait(cond: int64, mutex: int64): int64 {
  if (cond == 0 || mutex == 0) { return -1; }
  var seq: int64 := peek32(cond);
  pthread_mutex_unlock(mutex);
  sys_futex(cond, FUTEX_WAIT, seq, 0, 0, 0);
  pthread_mutex_lock(mutex);
  return 0;
}

pub fn pthread_cond_signal(cond: int64): int64 {
  if (cond == 0) { return -1; }
  poke32(cond, peek32(cond) + 1);
  sys_futex(cond, FUTEX_WAKE, 1, 0, 0, 0);
  return 0;
}

pub fn pthread_cond_broadcast(cond: int64): int64 {
  if (cond == 0) { return -1; }
  poke32(cond, peek32(cond) + 1);
  sys_futex(cond, FUTEX_WAKE, FUTEX_WAKE_ALL, 0, 0, 0);
  return 0;
}

pub fn pthread_cond_destroy(cond: int64): int64 {
  if (cond == 0) { return -1; }
  return 0;
}

// --- Thread-lokaler Speicher --------------------------------------------------

// Schreibt den erzeugten Schluessel nach `key` (ein int64-Zeiger, wie bei
// C). `destructor` ist nicht umgesetzt — und das wird gemeldet, statt einen
// Destruktor zuzusagen, der nie laeuft.
pub fn pthread_key_create(key: int64, destructor: int64): int64 {
  if (key == 0) { return -1; }
  if (destructor != 0) { return -1; }
  var k: int64 := TLSKeyCreate();
  if (k == 0) { return -1; }
  poke64(key, k);
  return 0;
}

pub fn pthread_key_delete(key: int64): int64 {
  if (key <= 0) { return -1; }
  return 0;   // Schluessel werden nicht wiederverwendet
}

pub fn pthread_setspecific(key: int64, value: int64): int64 {
  return TLSSetValue(key, value);
}

pub fn pthread_getspecific(key: int64): int64 {
  return TLSGetValue(key);
}

// --- Beenden -------------------------------------------------------------------

// Beendet NUR den aufrufenden Thread (Systemaufruf 60), nicht den Prozess.
// Genau darin unterscheidet er sich von `_exit`, das mit exit_group (231)
// alle Threads beendet — wer die beiden verwechselt, beendet aus Versehen das
// ganze Programm.
pub fn pthread_exit(code: int64): void {
  sys_exit(code);
}

pub fn _exit(code: int64): void {
  sys_exit_group(code);
}
