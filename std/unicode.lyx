// std.unicode — opt-in Unicode-aware operations on Text (codepoints)
//
// Per the string-encoding decision, Unicode correctness lives in a SEPARATE
// opt-in unit — not baked into the base String/Text. This first slice is
// rule-based and needs NO Unicode data tables:
//   - case folding for ASCII + Latin-1 Supplement (covers most European text)
//   - Unicode whitespace / ASCII digit-letter classification
//   - Text-level TextToUpper / TextToLower (decode -> fold -> re-encode)
//
// NOT here yet (need generated tables from the Unicode database — follow-up):
//   - full case folding beyond Latin-1 (Latin Extended, Greek, Cyrillic, ...)
//   - normalisation NFC / NFD (canonical decomposition + reordering)
//   - grapheme-cluster segmentation
// Known Latin-1 gaps (special-cased, currently left unchanged): ß (U+00DF),
// ÿ (U+00FF) -> Ÿ (U+0178).

@description("Opt-in Unicode-aware operations (case folding, classification) on Text")
@author("Andreas Röne")
@copyright("2024-2026 Andreas Röne")
unit std.unicode;

import std.text;

// ---- codepoint case folding (ASCII + Latin-1 Supplement) -------------------

pub fn UnicodeToLower(cp: int64): int64 {
  if (cp >= 65 && cp <= 90) { return cp + 32; }                    // A-Z -> a-z
  if (cp >= 192 && cp <= 222 && cp != 215) { return cp + 32; }     // À-Þ -> à-þ (except × U+00D7)
  return cp;
}

pub fn UnicodeToUpper(cp: int64): int64 {
  if (cp >= 97 && cp <= 122) { return cp - 32; }                   // a-z -> A-Z
  if (cp >= 224 && cp <= 254 && cp != 247) { return cp - 32; }     // à-þ -> À-Þ (except ÷ U+00F7; ÿ U+00FF not covered)
  return cp;
}

// ---- classification --------------------------------------------------------

// Unicode White_Space property.
pub fn UnicodeIsWhitespace(cp: int64): int64 {
  if (cp >= 9 && cp <= 13) { return 1; }                           // TAB LF VT FF CR
  if (cp == 32 || cp == 133 || cp == 160 || cp == 5760) { return 1; }  // SP NEL NBSP OGHAM
  if (cp >= 8192 && cp <= 8202) { return 1; }                      // EN QUAD .. HAIR SPACE
  if (cp == 8232 || cp == 8233 || cp == 8239 || cp == 8287 || cp == 12288) { return 1; }  // LS PS NNBSP MMSP IDEO
  return 0;
}

pub fn UnicodeIsAsciiDigit(cp: int64): int64 {
  if (cp >= 48 && cp <= 57) { return 1; }
  return 0;
}

pub fn UnicodeIsAsciiLetter(cp: int64): int64 {
  if (cp >= 65 && cp <= 90) { return 1; }
  if (cp >= 97 && cp <= 122) { return 1; }
  return 0;
}

// ---- Text-level case transforms (Unicode-aware, decode -> fold -> encode) ---

// Decode the codepoint at byte offset `off` in `t`; returns the codepoint and
// writes its UTF-8 byte length to *lenOut.
fn _decodeAt(t: Text, off: int64, lenOut: int64): int64 {
  var d: int64 := TextData(t);
  var b: int64 := peek8(d + off) & 255;
  if (b < 128) { poke64(lenOut, 1); return b; }
  if (b < 224) {
    poke64(lenOut, 2);
    return ((b & 31) << 6) | (peek8(d + off + 1) & 63);
  }
  if (b < 240) {
    poke64(lenOut, 3);
    return ((b & 15) << 12) | ((peek8(d + off + 1) & 63) << 6) | (peek8(d + off + 2) & 63);
  }
  poke64(lenOut, 4);
  return ((b & 7) << 18) | ((peek8(d + off + 1) & 63) << 12) | ((peek8(d + off + 2) & 63) << 6) | (peek8(d + off + 3) & 63);
}

// Apply a per-codepoint transform (0 = ToLower, 1 = ToUpper) across `t`,
// returning a new Text. Requires valid UTF-8 input.
fn _caseMap(t: Text, toUpper: int64): Text {
  var byteLen: int64 := TextByteLength(t);
  var sz: int64 := byteLen * 4 + 4;
  var buf: int64 := mmap(0, sz, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (buf < 0) { return TextFromUtf8(TextData(t), byteLen); }
  var lenCell: int64 := mmap(0, 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  var w: int64 := 0;
  var i: int64 := 0;
  while (i < byteLen) {
    var cp: int64 := _decodeAt(t, i, lenCell);
    var clen: int64 := peek64(lenCell);
    var folded: int64 := cp;
    if (toUpper != 0) { folded := UnicodeToUpper(cp); }
    else { folded := UnicodeToLower(cp); }
    w += CodepointToUtf8(folded, buf + w);
    i += clen;
  }
  var r: Text := TextFromUtf8(buf, w);
  munmap(buf, sz);
  munmap(lenCell, 8);
  return r;
}

pub fn TextToLower(t: Text): Text { return _caseMap(t, 0); }
pub fn TextToUpper(t: Text): Text { return _caseMap(t, 1); }

// ============================================================================
// Normalisation NFD / NFC — Latin-1 Supplement subset (curated, no full table)
// ============================================================================
//
// Covers the Latin-1 precomposed letters (À-ÿ), which each canonically
// decompose to an ASCII base letter + one combining diacritical mark. This is
// the "é composed == decomposed" correctness for Western-European text without
// the full Unicode decomposition database. Each Latin-1 letter has exactly ONE
// combining mark, so no canonical reordering (by combining class) is needed.
//
// Covered: Hangul (algorithmic, all 11,172 syllables) + Latin-1 precomposed.
// NOT covered (need generated Unicode tables — follow-up): decompositions beyond
// Latin-1 (Latin Extended, Greek, Cyrillic, CJK-compat), multi-mark canonical
// ordering, compatibility forms (NFKC/NFKD).

// Canonical decomposition of a Latin-1 precomposed letter. Returns the base
// codepoint and writes the combining mark to `markCell` (or -1 if `cp` has no
// canonical decomposition, in which case the return value is `cp` itself).
fn _decomp1(cp: int64, markCell: int64): int64 {
  poke64(markCell, 0 - 1);
  // ÿ is the lowercase exception (uppercase is Ÿ U+0178, not in Latin-1).
  if (cp == 255) { poke64(markCell, 776); return 121; }            // ÿ -> y + diaeresis
  var lower: int64 := 0;
  var u: int64 := cp;
  if (cp >= 224 && cp <= 254) { lower := 1; u := cp - 32; }        // à-þ -> À-Þ equivalent
  if (u < 192 || u > 221) { return cp; }                           // outside the decomposable range
  var base: int64 := 0;
  var mark: int64 := 0;
  if (u == 192) { base := 65; mark := 768; }        // À A grave
  else if (u == 193) { base := 65; mark := 769; }   // Á acute
  else if (u == 194) { base := 65; mark := 770; }   // Â circumflex
  else if (u == 195) { base := 65; mark := 771; }   // Ã tilde
  else if (u == 196) { base := 65; mark := 776; }   // Ä diaeresis
  else if (u == 197) { base := 65; mark := 778; }   // Å ring
  else if (u == 199) { base := 67; mark := 807; }   // Ç C cedilla
  else if (u == 200) { base := 69; mark := 768; }   // È E grave
  else if (u == 201) { base := 69; mark := 769; }   // É acute
  else if (u == 202) { base := 69; mark := 770; }   // Ê circumflex
  else if (u == 203) { base := 69; mark := 776; }   // Ë diaeresis
  else if (u == 204) { base := 73; mark := 768; }   // Ì I grave
  else if (u == 205) { base := 73; mark := 769; }   // Í acute
  else if (u == 206) { base := 73; mark := 770; }   // Î circumflex
  else if (u == 207) { base := 73; mark := 776; }   // Ï diaeresis
  else if (u == 209) { base := 78; mark := 771; }   // Ñ N tilde
  else if (u == 210) { base := 79; mark := 768; }   // Ò O grave
  else if (u == 211) { base := 79; mark := 769; }   // Ó acute
  else if (u == 212) { base := 79; mark := 770; }   // Ô circumflex
  else if (u == 213) { base := 79; mark := 771; }   // Õ tilde
  else if (u == 214) { base := 79; mark := 776; }   // Ö diaeresis
  else if (u == 217) { base := 85; mark := 768; }   // Ù U grave
  else if (u == 218) { base := 85; mark := 769; }   // Ú acute
  else if (u == 219) { base := 85; mark := 770; }   // Û circumflex
  else if (u == 220) { base := 85; mark := 776; }   // Ü diaeresis
  else if (u == 221) { base := 89; mark := 769; }   // Ý Y acute
  else { return cp; }                               // 198 Æ, 208 Ð, 215 ×, 216 Ø: no decomposition
  if (lower != 0) { base += 32; }
  poke64(markCell, mark);
  return base;
}

// Canonical composition of a base letter + combining mark -> precomposed
// codepoint, or -1 if the pair does not compose (Latin-1 subset).
fn _composeUpper(base: int64, mark: int64): int64 {
  if (base == 65) {  // A
    if (mark == 768) { return 192; } if (mark == 769) { return 193; }
    if (mark == 770) { return 194; } if (mark == 771) { return 195; }
    if (mark == 776) { return 196; } if (mark == 778) { return 197; }
  }
  if (base == 67) { if (mark == 807) { return 199; } }
  if (base == 69) {  // E
    if (mark == 768) { return 200; } if (mark == 769) { return 201; }
    if (mark == 770) { return 202; } if (mark == 776) { return 203; }
  }
  if (base == 73) {  // I
    if (mark == 768) { return 204; } if (mark == 769) { return 205; }
    if (mark == 770) { return 206; } if (mark == 776) { return 207; }
  }
  if (base == 78) { if (mark == 771) { return 209; } }              // N tilde
  if (base == 79) {  // O
    if (mark == 768) { return 210; } if (mark == 769) { return 211; }
    if (mark == 770) { return 212; } if (mark == 771) { return 213; }
    if (mark == 776) { return 214; }
  }
  if (base == 85) {  // U
    if (mark == 768) { return 217; } if (mark == 769) { return 218; }
    if (mark == 770) { return 219; } if (mark == 776) { return 220; }
  }
  if (base == 89) {  // Y
    if (mark == 769) { return 221; }
    if (mark == 776) { return 376; }                                // Ÿ U+0178
  }
  return 0 - 1;
}

fn _compose(base: int64, mark: int64): int64 {
  var up: int64 := _composeUpper(base, mark);
  if (up >= 0) { return up; }
  if (base >= 97 && base <= 122) {                                  // lowercase base
    var u: int64 := _composeUpper(base - 32, mark);
    if (u < 0) { return 0 - 1; }
    if (u == 376) { return 255; }                                   // Ÿ -> ÿ
    if (u >= 192 && u <= 221) { return u + 32; }
    return 0 - 1;
  }
  return 0 - 1;
}

// True if `cp` is a combining mark handled by this Latin-1 NFC/NFD subset.
fn _isSubsetMark(cp: int64): int64 {
  if (cp == 768 || cp == 769 || cp == 770 || cp == 771 || cp == 776 || cp == 778 || cp == 807) { return 1; }
  return 0;
}

// ---- Hangul syllable composition/decomposition (algorithmic; Unicode §3.12) --
// Covers all 11,172 modern Hangul syllables (U+AC00..U+D7A3) with no table.
// L 0x1100.., V 0x1161.., T 0x11A7..; LCount 19, VCount 21, TCount 28.

// Decompose Hangul syllable `cp` into 2 (LV) or 3 (LVT) jamo, written to the
// int64 array `out`. Returns the count (0 if `cp` is not a Hangul syllable).
fn _hangulDecompose(cp: int64, out: int64): int64 {
  if (cp < 44032 || cp > 55203) { return 0; }
  var si: int64 := cp - 44032;
  var l: int64 := 4352 + si / 588;
  var vt: int64 := si - (si / 588) * 588;
  var v: int64 := 4449 + vt / 28;
  var tmod: int64 := vt - (vt / 28) * 28;
  poke64(out + 0, l);
  poke64(out + 8, v);
  if (tmod > 0) { poke64(out + 16, 4519 + tmod); return 3; }
  return 2;
}

// Compose leading consonant `l` + vowel `v` into an LV syllable, or -1.
fn _hangulComposeLV(l: int64, v: int64): int64 {
  if (l < 4352 || l >= 4371) { return 0 - 1; }
  if (v < 4449 || v >= 4470) { return 0 - 1; }
  return 44032 + ((l - 4352) * 21 + (v - 4449)) * 28;
}

// Compose an LV syllable + trailing consonant `t` into an LVT syllable, or -1.
fn _hangulComposeLVT(lv: int64, t: int64): int64 {
  if (lv < 44032 || lv > 55203) { return 0 - 1; }
  if (((lv - 44032) - (((lv - 44032) / 28) * 28)) != 0) { return 0 - 1; }  // must be an LV (T-index 0)
  if (t <= 4519 || t >= 4547) { return 0 - 1; }
  return lv + (t - 4519);
}

// Decompose `t` to NFD: Hangul syllables (algorithmic) + the Latin-1 precomposed
// letters (curated). Other codepoints pass through unchanged.
pub fn TextToNFD(t: Text): Text {
  var byteLen: int64 := TextByteLength(t);
  var sz: int64 := byteLen * 4 + 8;
  var buf: int64 := mmap(0, sz, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (buf < 0) { return TextFromUtf8(TextData(t), byteLen); }
  var lenCell: int64 := mmap(0, 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  var markCell: int64 := mmap(0, 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  var hCell: int64 := mmap(0, 24, PROT_RW, MAP_ANON, FD_NONE, 0);
  var w: int64 := 0;
  var i: int64 := 0;
  while (i < byteLen) {
    var cp: int64 := _decodeAt(t, i, lenCell);
    var clen: int64 := peek64(lenCell);
    var hn: int64 := _hangulDecompose(cp, hCell);
    if (hn > 0) {
      w += CodepointToUtf8(peek64(hCell + 0), buf + w);
      w += CodepointToUtf8(peek64(hCell + 8), buf + w);
      if (hn == 3) { w += CodepointToUtf8(peek64(hCell + 16), buf + w); }
    } else {
      var base: int64 := _decomp1(cp, markCell);
      var mark: int64 := peek64(markCell);
      if (mark >= 0) {
        w += CodepointToUtf8(base, buf + w);
        w += CodepointToUtf8(mark, buf + w);
      } else {
        w += CodepointToUtf8(cp, buf + w);
      }
    }
    i += clen;
  }
  var r: Text := TextFromUtf8(buf, w);
  munmap(buf, sz); munmap(lenCell, 8); munmap(markCell, 8); munmap(hCell, 24);
  return r;
}

// Compose `t` to NFC: Hangul jamo (L+V, LV+T — algorithmic) and Latin-1 base +
// combining mark become the precomposed forms; everything else is unchanged.
pub fn TextToNFC(t: Text): Text {
  var byteLen: int64 := TextByteLength(t);
  var sz: int64 := byteLen + 8;
  var buf: int64 := mmap(0, sz, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (buf < 0) { return TextFromUtf8(TextData(t), byteLen); }
  var lc: int64 := mmap(0, 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  var w: int64 := 0;
  var i: int64 := 0;
  while (i < byteLen) {
    var cp: int64 := _decodeAt(t, i, lc);
    var clen: int64 := peek64(lc);
    var handled: int64 := 0;
    // decode the following codepoint (if any)
    var hasNext: int64 := 0;
    var nextCp: int64 := 0;
    var nextLen: int64 := 0;
    if (i + clen < byteLen) {
      nextCp := _decodeAt(t, i + clen, lc);
      nextLen := peek64(lc);
      hasNext := 1;
    }
    // Hangul: L + V (+ optional T)
    if (hasNext != 0 && cp >= 4352 && cp < 4371) {
      var lv: int64 := _hangulComposeLV(cp, nextCp);
      if (lv >= 0) {
        var consumed: int64 := clen + nextLen;
        var out2: int64 := lv;
        if (i + consumed < byteLen) {
          var tCp: int64 := _decodeAt(t, i + consumed, lc);
          var tLen: int64 := peek64(lc);
          var lvt: int64 := _hangulComposeLVT(lv, tCp);
          if (lvt >= 0) { out2 := lvt; consumed += tLen; }
        }
        w += CodepointToUtf8(out2, buf + w);
        i += consumed;
        handled := 1;
      }
    }
    // Latin-1: base + combining mark
    if (handled == 0 && hasNext != 0 && _isSubsetMark(nextCp) != 0) {
      var composed: int64 := _compose(cp, nextCp);
      if (composed >= 0) {
        w += CodepointToUtf8(composed, buf + w);
        i += clen + nextLen;
        handled := 1;
      }
    }
    if (handled == 0) {
      w += CodepointToUtf8(cp, buf + w);
      i += clen;
    }
  }
  var r: Text := TextFromUtf8(buf, w);
  munmap(buf, sz); munmap(lc, 8);
  return r;
}

// Normalisation-insensitive equality (Latin-1 subset): compares NFC forms.
pub fn TextEqualsNormalized(a: Text, b: Text): int64 {
  var na: Text := TextToNFC(a);
  var nb: Text := TextToNFC(b);
  var eq: int64 := TextEquals(na, nb);
  TextFree(na); TextFree(nb);
  return eq;
}
