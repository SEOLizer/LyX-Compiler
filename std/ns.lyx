// std/ns -- WP-16: Namespaces, pidfd & Prozess-Isolation
// Wrapper um sys_pidfd_open (434), sys_pidfd_send_signal (424),
// sys_pidfd_getfd (438), sys_unshare (272), sys_setns (308).
//
// pidfd: stabiler Prozess-Deskriptor -- bleibt gueltig auch wenn die PID
// wiederverwendet wird. Ermoeglicht race-condition-freie Signal-Zustellung
// und fd-Duplikation zwischen Prozessen.
//
// Namespaces isolieren Systemressourcen (PID, Netzwerk, Mounts, User, UTS,
// IPC) zwischen Prozessgruppen.

// ============================================================
// Namespace-Flags (CLONE_NEW*)
// ============================================================

pub con CLONE_NEWTIME: int64 := 128;          // 0x00000080 -- Zeit-Namespace (5.6+)
pub con CLONE_NEWNS:   int64 := 131072;       // 0x00020000 -- Mount-Namespace
pub con CLONE_NEWUTS:  int64 := 67108864;     // 0x04000000 -- UTS-Namespace (Hostname)
pub con CLONE_NEWIPC:  int64 := 134217728;    // 0x08000000 -- IPC-Namespace
pub con CLONE_NEWUSER: int64 := 268435456;    // 0x10000000 -- User-Namespace
pub con CLONE_NEWPID:  int64 := 536870912;    // 0x20000000 -- PID-Namespace
pub con CLONE_NEWNET:  int64 := 1073741824;   // 0x40000000 -- Netzwerk-Namespace
pub con CLONE_NEWCGROUP: int64 := 33554432;   // 0x02000000 -- cgroup-Namespace

// Namespace-Typen fuer NamespaceJoin (setns nstype-Parameter)
// 0 = automatisch vom fd ableiten
pub con NSTYPE_ANY:    int64 := 0;
pub con NSTYPE_IPC:    int64 := 134217728;    // CLONE_NEWIPC
pub con NSTYPE_UTS:    int64 := 67108864;     // CLONE_NEWUTS
pub con NSTYPE_NET:    int64 := 1073741824;   // CLONE_NEWNET
pub con NSTYPE_PID:    int64 := 536870912;    // CLONE_NEWPID
pub con NSTYPE_USER:   int64 := 268435456;    // CLONE_NEWUSER
pub con NSTYPE_MNT:    int64 := 131072;       // CLONE_NEWNS

// ============================================================
// pidfd -- Prozess-Deskriptoren
// ============================================================

// PidFdOpen: oeffnet einen stabilen Prozess-Deskriptor fuer `pid`.
// flags: reserviert, muss 0 sein.
// Gibt pidfd (>= 0) oder -errno zurueck.
pub fn PidFdOpen(pid: int64, flags: int64): int64 {
  return sys_pidfd_open(pid, flags);
}

// PidFdSendSignal: sendet ein Signal an den Prozess hinter pidfd.
// sig:  Signalnummer (z.B. 9 = SIGKILL, 15 = SIGTERM, 0 = Existenz-Check)
// Race-condition-frei: kein PID-Reuse-Problem.
pub fn PidFdSendSignal(pidfd: int64, sig: int64): int64 {
  return sys_pidfd_send_signal(pidfd, sig, 0, 0);
}

// PidFdGetFd: dupliziert Dateideskriptor `targetFd` des Prozesses pidfd
// in den aktuellen Prozess. Gibt neuen fd zurueck oder -errno.
// Benoetigt CAP_SYS_PTRACE oder denselben User-Namespace wie der Zielprozess.
pub fn PidFdGetFd(pidfd: int64, targetFd: int64): int64 {
  return sys_pidfd_getfd(pidfd, targetFd, 0);
}

// ============================================================
// Namespaces -- Isolation
// ============================================================

// NamespaceUnshare: erzeugt neue Namespaces fuer den aktuellen Prozess.
// flags: CLONE_NEW*-Kombination.
// CLONE_NEWUSER erfordert kein root (seit Kernel 3.8, sofern aktiviert).
// Andere Flags erfordern CAP_SYS_ADMIN.
pub fn NamespaceUnshare(flags: int64): int64 {
  return sys_unshare(flags);
}

// NamespaceJoin: tritt einem bestehenden Namespace bei (via Namespace-fd).
// fd:     offen auf /proc/<pid>/ns/<type> (z.B. "/proc/1/ns/net")
// nsType: NSTYPE_* oder NSTYPE_ANY (0 = automatisch erkennen)
pub fn NamespaceJoin(fd: int64, nsType: int64): int64 {
  return sys_setns(fd, nsType);
}
