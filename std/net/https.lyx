// Lyx HTTPS Client - Secure HTTP over TLS
// Uses std.net.tls (OpenSSL) for encryption
//
// CAPABILITIES (#1348): Wer dieses Modul unter @capabilities nutzt, braucht
//   network.tcp.connect   Verbindung zum Server
//   memory.mmap           OpenSSL-Puffer
//   fs.read UND fs.meta   Zertifikatspruefung gegen den CA-Store des Systems:
//                         OpenSSL scannt /usr/lib/ssl/certs und stattet die
//                         Kandidaten ab (getdents64, stat, lstat, statx) —
//                         das haengt an fs.meta, nicht an fs.read.
// Fehlt fs.meta, laeuft der Handshake bis zur Zertifikatspruefung und der
// Prozess stirbt dann an SIGSYS: kein Rueckgabewert, keine Meldung. Der
// Compiler warnt beim Uebersetzen, wenn dieses Modul importiert ist und die
// beiden Capabilities fehlen.
//
// Usage:
//   import std.net.https;
//   var resp: HTTPResponse := HTTPSGet("example.com", "/index.html");
//   PrintStr(resp.bodyPtr);
//   HTTPResponseFree(resp);
@capabilities([fs.read, network.tcp.bind, network.tcp.connect, network.udp.connect])

unit std.net.https;

import std.net.http;
import std.net.socket;
import std.net.dns;
import std.net.tls;
import std.net.types;

// HTTPS GET request
// host: hostname (e.g., "example.com")
// path: URL path (e.g., "/index.html")
// Returns HTTPResponse with body allocated via mmap (caller must free)
pub fn HTTPSGet(host: pchar, path: pchar): HTTPResponse {
  var response: HTTPResponse;
  var ctx: TLSContext;
  var conn: TLSConn;
  var ip: int64;
  var tcpConn: TCPConn;
  var requestBuf: int64;
  var buf: int64;
  var n: int64;
  var i: int64;
  
  // Initialize response
  response.statusCode := 0;
  response.statusText := 0;
  response.headerCount := 0;
  response.contentLength := 0;
  response.bodyPtr := 0;
  response.bodySize := 0;
  // #1534: Diese beiden fehlten. HTTPResponseFree prueft `headersRaw != 0` und
  // ruft dann munmap darauf — bei nie gesetztem Feld entschied Stack-Rauschen
  // ueber Adresse UND Laenge. Meist scheiterte der Aufruf mit EINVAL und fiel
  // nicht auf; traf der Muellwert eine gemappte Adresse, wurde fremder
  // Speicher freigegeben.
  response.headersRaw := 0;
  response.headersSize := 0;
  
  // Initialize TLS
  ctx := TLSInit();
  if (ctx.initialized == 0) {
    return response;
  }
  
  // Resolve hostname
  ip := GetHostByName(host as pchar);
  if (ip == 0) {
    TLSFree(ctx);
    return response;
  }
  
  // Connect TCP
  tcpConn := TCPConnect(ip, HTTPS_PORT);
  if (tcpConn.fd < 0) {
    TLSFree(ctx);
    return response;
  }
  
  // TLS handshake
  conn := TLSConnect(ctx, tcpConn.fd, host as pchar);
  if (conn.connected == 0) {
    sys_close(tcpConn.fd);
    TLSFree(ctx);
    return response;
  }
  
  // Build HTTP request
  var req: HTTPRequest;
  req.method := HTTP_GET;
  req.host := host;
  req.path := path;
  req.port := HTTPS_PORT;
  req.headers := 0;
  req.body := 0;
  req.bodySize := 0;
  
  requestBuf := HTTPRequestBuild(req);
  if (requestBuf == 0) {
    TLSClose(conn);
    sys_close(tcpConn.fd);
    TLSFree(ctx);
    return response;
  }
  
  // Send request over TLS
  // #1346: HTTPRequestBuild liefert einen Puffer mit 16-Byte-Kopf
  // ([0..7] allocSize, [8..15] reqSize), der Text beginnt bei +16. Bis
  // hierher gingen die 16 Byte Binaerdaten mit ueber die Leitung, dahinter
  // Nullpadding bis 4096 — der Server sah keine gueltige Requestzeile und
  // antwortete 400. HTTPSSend machte es von Anfang an richtig; nur die
  // beiden Komfortfunktionen lasen den Puffer roh.
  //
  // Auch das Freigeben war falsch: 4096 statt der wirklich abgebildeten
  // allocSize — bei langen Pfaden blieb Speicher liegen, bei kurzen wurde
  // ueber die Mappinggrenze hinaus unmapped.
  n := TLSWrite(conn, requestBuf + 16, peek64(requestBuf + 8));
  munmap(requestBuf, peek64(requestBuf));
  
  if (n <= 0) {
    TLSClose(conn);
    sys_close(tcpConn.fd);
    TLSFree(ctx);
    return response;
  }
  
  // Receive the full response. The request sends "Connection: close", so the
  // server ends the TLS stream when done; we read into a growable buffer until
  // TLSRead reports the close (<= 0). This handles responses far larger than a
  // single TLS record — e.g. multi-MB package archives.
  var cap: int64 := 65536;
  buf := mmap(0, cap, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (buf == 0) {
    TLSClose(conn);
    sys_close(tcpConn.fd);
    TLSFree(ctx);
    return response;
  }
  var total: int64 := 0;
  while (true) {
    // Grow before each read so there is always room for a full chunk.
    if (total + 16384 > cap) {
      var newCap: int64 := cap * 2;
      var nb: int64 := mmap(0, newCap, PROT_RW, MAP_ANON, FD_NONE, 0);
      if (nb == 0) { break; }
      var k: int64 := 0;
      while (k < total) { poke8(nb + k, peek8(buf + k)); k := k + 1; }
      munmap(buf, cap);
      buf := nb;
      cap := newCap;
    }
    var r: int64 := TLSRead(conn, buf + total, 16384);
    if (r <= 0) { break; }
    total += r;
    if (total >= 67108864) { break; }   // 64 MiB safety cap
  }
  TLSClose(conn);
  sys_close(tcpConn.fd);
  TLSFree(ctx);

  if (total <= 0) {
    munmap(buf, cap);
    return response;
  }
  n := total;   // der Parser sieht die vollstaendig gelesene Antwort

  // #1534/#1539: Hier stand eine eigene, kuerzere Auswertung — nur die
  // Statuszeile und der Rumpf ab \r\n\r\n. Kopfzeilen wurden nicht uebernommen
  // (#1534) und `Transfer-Encoding: chunked` nicht aufgeloest (#1539); ab der
  // ersten gechunkten Antwort kam der Rumpf mit Laengenrahmen durchsetzt an.
  //
  // Es gilt jetzt derselbe Parser wie ueber TCP. Er liest nicht vom Socket,
  // deshalb passt er auch auf den TLS-Weg.
  response := HTTPParseResponse(response, buf, n);
  munmap(buf, cap);
  return response;
}

// HTTPS POST request
// #1264: Ein VOLLSTAENDIGER Request ueber TLS — Methode, Kopfzeilen und Rumpf
// bestimmt der Aufrufer. Die drei Cloud-Transporte (aws, cf, digitalocean)
// hatten sich diesen Weg selbst zusammengesetzt und dabei zwei Funktionen mit
// falscher Stelligkeit gerufen: `DNSResolve(host)` (vier Parameter) und
// `HTTPSend(tlsConn, conn)` (einer). Beides uebersetzte, weil die Pruefung an
// der Unit-Grenze endete; zur Laufzeit kamen die fehlenden Werte vom Stack.
// Statt den Fehler dreimal zu flicken, steht der Weg jetzt EINMAL hier — als
// dieselbe Abfolge, die HTTPSGet seit jeher benutzt.
pub fn HTTPSSend(req: HTTPRequest): HTTPResponse {
  var host: int64 := req.host;
  var response: HTTPResponse;
  var ctx: TLSContext;
  var conn: TLSConn;
  var ip: int64;
  var tcpConn: TCPConn;
  var requestBuf: int64;
  var buf: int64;
  var n: int64;
  var i: int64;
  
  // Initialize response
  response.statusCode := 0;
  response.statusText := 0;
  response.headerCount := 0;
  response.contentLength := 0;
  response.bodyPtr := 0;
  response.bodySize := 0;
  // #1534: Diese beiden fehlten. HTTPResponseFree prueft `headersRaw != 0` und
  // ruft dann munmap darauf — bei nie gesetztem Feld entschied Stack-Rauschen
  // ueber Adresse UND Laenge. Meist scheiterte der Aufruf mit EINVAL und fiel
  // nicht auf; traf der Muellwert eine gemappte Adresse, wurde fremder
  // Speicher freigegeben.
  response.headersRaw := 0;
  response.headersSize := 0;
  
  // Initialize TLS
  ctx := TLSInit();
  if (ctx.initialized == 0) {
    return response;
  }
  
  // Resolve hostname
  ip := GetHostByName(host as pchar);
  if (ip == 0) {
    TLSFree(ctx);
    return response;
  }
  
  // Connect TCP
  tcpConn := TCPConnect(ip, HTTPS_PORT);
  if (tcpConn.fd < 0) {
    TLSFree(ctx);
    return response;
  }
  
  // TLS handshake
  conn := TLSConnect(ctx, tcpConn.fd, host as pchar);
  if (conn.connected == 0) {
    sys_close(tcpConn.fd);
    TLSFree(ctx);
    return response;
  }
  
  requestBuf := HTTPRequestBuild(req);
  if (requestBuf == 0) {
    TLSClose(conn);
    sys_close(tcpConn.fd);
    TLSFree(ctx);
    return response;
  }
  
  // Senden: der Puffer traegt Belegungs- und Nutzgroesse im Kopf (je 8 Byte).
  // HTTPSGet schreibt hier feste 4096 Byte — das ist eine eigene Unsauberkeit
  // und bleibt unberuehrt; hier wird die wirkliche Laenge benutzt.
  var reqAlloc: int64 := peek64(requestBuf);
  var reqSize:  int64 := peek64(requestBuf + 8);
  n := TLSWrite(conn, requestBuf + 16, reqSize);
  munmap(requestBuf, reqAlloc);
  
  if (n <= 0) {
    TLSClose(conn);
    sys_close(tcpConn.fd);
    TLSFree(ctx);
    return response;
  }
  
  // Receive the full response. The request sends "Connection: close", so the
  // server ends the TLS stream when done; we read into a growable buffer until
  // TLSRead reports the close (<= 0). This handles responses far larger than a
  // single TLS record — e.g. multi-MB package archives.
  var cap: int64 := 65536;
  buf := mmap(0, cap, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (buf == 0) {
    TLSClose(conn);
    sys_close(tcpConn.fd);
    TLSFree(ctx);
    return response;
  }
  var total: int64 := 0;
  while (true) {
    // Grow before each read so there is always room for a full chunk.
    if (total + 16384 > cap) {
      var newCap: int64 := cap * 2;
      var nb: int64 := mmap(0, newCap, PROT_RW, MAP_ANON, FD_NONE, 0);
      if (nb == 0) { break; }
      var k: int64 := 0;
      while (k < total) { poke8(nb + k, peek8(buf + k)); k := k + 1; }
      munmap(buf, cap);
      buf := nb;
      cap := newCap;
    }
    var r: int64 := TLSRead(conn, buf + total, 16384);
    if (r <= 0) { break; }
    total += r;
    if (total >= 67108864) { break; }   // 64 MiB safety cap
  }
  TLSClose(conn);
  sys_close(tcpConn.fd);
  TLSFree(ctx);

  if (total <= 0) {
    munmap(buf, cap);
    return response;
  }
  n := total;   // der Parser sieht die vollstaendig gelesene Antwort

  // #1534/#1539: Hier stand eine eigene, kuerzere Auswertung — nur die
  // Statuszeile und der Rumpf ab \r\n\r\n. Kopfzeilen wurden nicht uebernommen
  // (#1534) und `Transfer-Encoding: chunked` nicht aufgeloest (#1539); ab der
  // ersten gechunkten Antwort kam der Rumpf mit Laengenrahmen durchsetzt an.
  //
  // Es gilt jetzt derselbe Parser wie ueber TCP. Er liest nicht vom Socket,
  // deshalb passt er auch auf den TLS-Weg.
  response := HTTPParseResponse(response, buf, n);
  munmap(buf, cap);
  return response;
}

// HTTPS POST request

pub fn HTTPSPost(host: int64, path: int64, body: int64, bodySize: int64): HTTPResponse {
  var response: HTTPResponse;
  var ctx: TLSContext;
  var conn: TLSConn;
  var ip: int64;
  var tcpConn: TCPConn;
  var requestBuf: int64;
  var buf: int64;
  var n: int64;
  var i: int64;
  
  response.statusCode := 0;
  response.statusText := 0;
  response.headerCount := 0;
  response.contentLength := 0;
  response.bodyPtr := 0;
  response.bodySize := 0;
  // #1534: Diese beiden fehlten. HTTPResponseFree prueft `headersRaw != 0` und
  // ruft dann munmap darauf — bei nie gesetztem Feld entschied Stack-Rauschen
  // ueber Adresse UND Laenge. Meist scheiterte der Aufruf mit EINVAL und fiel
  // nicht auf; traf der Muellwert eine gemappte Adresse, wurde fremder
  // Speicher freigegeben.
  response.headersRaw := 0;
  response.headersSize := 0;
  
  ctx := TLSInit();
  if (ctx.initialized == 0) {
    return response;
  }
  
  ip := GetHostByName(host as pchar);
  if (ip == 0) {
    TLSFree(ctx);
    return response;
  }
  
  tcpConn := TCPConnect(ip, HTTPS_PORT);
  if (tcpConn.fd < 0) {
    TLSFree(ctx);
    return response;
  }
  
  conn := TLSConnect(ctx, tcpConn.fd, host as pchar);
  if (conn.connected == 0) {
    sys_close(tcpConn.fd);
    TLSFree(ctx);
    return response;
  }
  
  var req: HTTPRequest;
  req.method := HTTP_POST;
  req.host := host;
  req.path := path;
  req.port := HTTPS_PORT;
  req.headers := 0;
  req.body := body;
  req.bodySize := bodySize;
  
  requestBuf := HTTPRequestBuild(req);
  if (requestBuf == 0) {
    TLSClose(conn);
    sys_close(tcpConn.fd);
    TLSFree(ctx);
    return response;
  }
  
  // #1346: HTTPRequestBuild liefert einen Puffer mit 16-Byte-Kopf
  // ([0..7] allocSize, [8..15] reqSize), der Text beginnt bei +16. Bis
  // hierher gingen die 16 Byte Binaerdaten mit ueber die Leitung, dahinter
  // Nullpadding bis 4096 — der Server sah keine gueltige Requestzeile und
  // antwortete 400. HTTPSSend machte es von Anfang an richtig; nur die
  // beiden Komfortfunktionen lasen den Puffer roh.
  //
  // Auch das Freigeben war falsch: 4096 statt der wirklich abgebildeten
  // allocSize — bei langen Pfaden blieb Speicher liegen, bei kurzen wurde
  // ueber die Mappinggrenze hinaus unmapped.
  n := TLSWrite(conn, requestBuf + 16, peek64(requestBuf + 8));
  munmap(requestBuf, peek64(requestBuf));
  
  if (n <= 0) {
    TLSClose(conn);
    sys_close(tcpConn.fd);
    TLSFree(ctx);
    return response;
  }
  
  buf := mmap(0, 8192, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (buf == 0) {
    TLSClose(conn);
    sys_close(tcpConn.fd);
    TLSFree(ctx);
    return response;
  }
  
  n := TLSRead(conn, buf, 8192);
  TLSClose(conn);
  sys_close(tcpConn.fd);
  TLSFree(ctx);
  
  if (n <= 0) {
    munmap(buf, 8192);
    return response;
  }
  
  // #1534/#1539: siehe HTTPSGet — derselbe Parser wie ueber TCP, statt der
  // dritten Teilkopie im Baum.
  response := HTTPParseResponse(response, buf, n);
  munmap(buf, 8192);
  return response;
}
