// std/net/tls13.lyx — TLS 1.3 (RFC 8446) in Lyx, ohne OpenSSL, ohne FFI,
// und das gemeinsame Tor fuer TLS 1.2 (std.net.tls12)
//
// Teil von #2096. std/net/tls.lyx bleibt als OpenSSL-Wrapper daneben stehen;
// diese Unit kommt ohne Fremdbibliothek aus und laeuft damit auch unter
// --target=lyxos.
//
// Die Anwendung ruft IMMER die Funktionen dieser Unit. Ist TLS 1.2 ueber
// TlsConfigMinVersion freigeschaltet und einigen sich beide Seiten darauf,
// uebernimmt std.net.tls12 den Handschlag und jede Funktion hier delegiert
// dorthin; TlsVersion(c) sagt, was ausgehandelt wurde. Ohne Zutun bleibt es
// bei TLS 1.3, und der Flug ist dann byteweise derselbe wie vorher. Der
// Abschnitt "Verteiler" weiter unten beschreibt die Uebergabe.
//
// Die Unit macht KEINE Ein-/Ausgabe. Sie bekommt empfangene Byte gefuettert
// und gibt zu sendende Byte heraus:
//
//   var c: int64 := TlsNeu(cfg);
//   // Schleife mit epoll:
//   TlsFuetter(c, puffer, n);                  // vom Socket gelesene Byte
//   var rc: int64 := TlsSchritt(c);            // Handschlag voranbringen
//   var m: int64 := TlsAusgabe(c, aus, cap);   // zu sendende Byte
//
// So bleibt die Unit mit nicht blockierenden Sockets und epoll benutzbar
// (TLS_WANT_READ/TLS_WANT_WRITE statt Blockieren) und ist ohne Netz
// pruefbar: zwei Zustaende koennen im selben Programm miteinander sprechen.
//
// Alle Puffer entstehen EINMAL bei TlsNeu. Je Record wird nichts belegt —
// #2096 verlangt das ausdruecklich, weil die Nutzer Langlaeufer ohne GC sind.
// TlsSpeicherBedarf() nennt den Bedarf je Verbindung.
//
// Stand dieser Etappe:
//   Rollen           Client und Server
//   Cipher-Suites    TLS_AES_128_GCM_SHA256, TLS_AES_256_GCM_SHA384,
//                    TLS_CHACHA20_POLY1305_SHA256
//   Schluesseltausch X25519 und secp256r1, je Rolle ueber TlsConfigGruppen
//                    waehlbar; passt der Anteil des Clients nicht, schickt
//                    der Server einen HelloRetryRequest
//   Signaturen       ecdsa_secp256r1_sha256, rsa_pss_rsae_sha256/384/512,
//                    ed25519 — je mit eigener Signatur und Pruefung
//   Erweiterungen    supported_versions, supported_groups, key_share,
//                    server_name (SNI), application_layer_protocol_negotiation,
//                    cookie (HRR-Echo)
//   Nachhandschlag   KeyUpdate in beiden Richtungen (§4.6.3);
//                    NewSessionTicket wird verworfen
//   Server-Ketten    eine einzelne (TlsConfigKette) oder mehrere nach SNI
//                    (TlsConfigKetten) mit Jokernamen, Standardeintrag und
//                    Austausch im Betrieb (Hot-Reload)
//   Widerruf         Hook der Anwendung (OCSP/CRL), TlsConfigWiderrufHook
//   TLS 1.2          ueber die Weiche, siehe std.net.tls12 (nur ECDHE mit
//                    AEAD, Extended Master Secret als Pflicht,
//                    Renegotiation abgewiesen); Standard ist "aus"
//   Kurven           x25519, secp256r1 und secp384r1 als Schluesseltausch;
//                    ecdsa_secp256r1_sha256 und ecdsa_secp384r1_sha384 als
//                    Signaturverfahren (secp384r1 seit #2096, vorher stand
//                    hier "nicht enthalten")
//   Nicht enthalten  PSK, Tickets und 0-RTT (#2577, #2578), OCSP-Stapling
//                    (#2579), DTLS (#2580), secp521r1, x448, FFDHE.
//                    Jeder dieser Faelle wird mit einem benannten Fehler
//                    abgewiesen, nicht still uebergangen. rsa_pkcs1_* ist in
//                    CertificateVerify nach RFC 8446 §4.2.3 verboten und wird
//                    darum auch abgewiesen.

// CAPABILITIES (#2096): diese Unit macht KEINE Ein-/Ausgabe. Sie bekommt
// Byte gefuettert und gibt Byte heraus; Socket, Datei und Uhr gehoeren der
// Anwendung. Gebraucht werden nur der Speicher fuer den Verbindungsblock
// (memory.mmap) und Zufall fuer Schluessel und Nonces (system.rand, auf
// LyXOS ein implizites Recht).
//
// Was ein TLS-SERVER darueber hinaus fuehren muss, ist damit abschliessend:
// network.tcp.bind und io.wait fuer den Listener, system.time, wenn er die
// Uhr fuer TlsConfigZeit selbst liest. KEIN fs.read und KEIN fs.meta — den
// Trust-Store bekommt die Unit als Puffer uebergeben, ein CA-Store wird
// nicht abgestattet. Belegt in tests/tls_capabilities_test.sh.
@capabilities([memory.mmap, system.rand])

unit std.net.tls13;

import std.alloc;
import std.crypto.ocsp;   // #2579: Leser und Pruefer fuer OCSP-Antworten
import std.crypto.sha256;
import std.crypto.sha512;
import std.crypto.hkdf;
import std.crypto.aesgcm;
import std.crypto.chacha20poly1305;
import std.crypto.x25519;
import std.crypto.ec;
import std.crypto.rand;
import std.crypto.ct;
import std.crypto.der;
import std.crypto.x509;
import std.crypto.pkey;
import std.crypto.rsa_native;
import std.crypto.ed25519;
import std.net.tls_config;
import std.net.tls_kern;
import std.net.tls12;

// ---------------------------------------------------------------------------
// Rueckgabewerte von TlsSchritt / TlsLese / TlsSchreibe
//
// Als Funktionen abgefragt, weil ein `pub con` ueber Unit-Grenzen still -1
// liefern kann (#2102).
//   0   fertig bzw. Erfolg
//   1   TLS_WANT_READ   — es fehlen Byte von der Gegenseite
//   2   TLS_WANT_WRITE  — der Ausgabepuffer muss erst geleert werden
//  <0   Fehler, siehe TlsFehlerText
// ---------------------------------------------------------------------------

pub fn TlsOk(): int64 { return 0; }
pub fn TlsWantRead(): int64 { return 1; }
pub fn TlsWantWrite(): int64 { return 2; }

con E_FORMAT:        int64 := -1;    // Record oder Nachricht nicht lesbar
con E_VERSION:       int64 := -2;    // Gegenseite spricht nicht TLS 1.3
con E_SUITE:         int64 := -3;    // keine gemeinsame Cipher-Suite
con E_GRUPPE:        int64 := -4;    // keine gemeinsame Schluesselgruppe
con E_ENTSCHLUESS:   int64 := -5;    // AEAD-Tag falsch
con E_ZERTIFIKAT:    int64 := -6;    // Kette nicht gueltig
con E_SIGNATUR:      int64 := -7;    // CertificateVerify falsch
con E_FINISHED:      int64 := -8;    // Finished falsch
con E_ABLAUF:        int64 := -9;    // Nachricht an dieser Stelle unerwartet
con E_PUFFER:        int64 := -10;   // Puffer zu klein
con E_KONFIG:        int64 := -11;   // Konfiguration unvollstaendig
con E_UNTERSTUETZT:  int64 := -12;   // Verfahren nicht unterstuetzt
con E_WARNUNG:       int64 := -13;   // Alert der Gegenseite
con E_GESCHLOSSEN:   int64 := -14;   // close_notify
con E_WIDERRUFEN:    int64 := -15;   // Widerruf-Hook der Anwendung lehnt ab
con E_HRR:           int64 := -16;   // HelloRetryRequest unzulaessig
// Ein Feld mit einem Wert, den das Protokoll nicht kennt (RFC 8446 §4.6.3:
// request_update ausser 0 und 1 MUSS illegal_parameter geben). Getrennt von
// E_FORMAT, weil die Gegenseite an der Alertnummer erkennen soll, ob die
// Nachricht verstuemmelt oder der WERT falsch war.
con E_PARAM:         int64 := -19;

// #2579: Die beigelegte OCSP-Antwort traegt kein gueltiges `good` fuer DIESES
// Zertifikat, und die Vorgabe ist `hart`. Getrennt von E_WIDERRUFEN (-15),
// weil das der Hook der Anwendung ist: wer die Alertnummer liest, soll sehen,
// WER abgelehnt hat.
con E_OCSP:          int64 := -20;

pub fn TlsFehlerText(rc: int64): pchar {
    if (rc == 0)  { return "ok"c; }
    if (rc == 1)  { return "want-read"c; }
    if (rc == 2)  { return "want-write"c; }
    if (rc == -1) { return "Record oder Handschlagnachricht nicht lesbar"c; }
    if (rc == -2) { return "Gegenseite bietet TLS 1.3 nicht an"c; }
    if (rc == -3) { return "keine gemeinsame Cipher-Suite"c; }
    if (rc == -4) { return "keine gemeinsame Schluesselgruppe (nur X25519)"c; }
    if (rc == -5) { return "Entschluesselung fehlgeschlagen (Tag falsch)"c; }
    if (rc == -6) { return "Zertifikatskette nicht gueltig"c; }
    if (rc == -7) { return "CertificateVerify falsch"c; }
    if (rc == -8) { return "Finished falsch"c; }
    if (rc == -9) { return "Nachricht an dieser Stelle unerwartet"c; }
    if (rc == -10) { return "Puffer zu klein"c; }
    if (rc == -11) { return "Konfiguration unvollstaendig"c; }
    if (rc == -12) { return "Verfahren nicht unterstuetzt"c; }
    if (rc == -13) { return "Alert der Gegenseite"c; }
    if (rc == -14) { return "Verbindung geschlossen (close_notify)"c; }
    if (rc == -15) { return "Zertifikat vom Widerruf-Hook abgelehnt"c; }
    if (rc == -16) { return "HelloRetryRequest unzulaessig (zweites HRR oder unbekannte Gruppe)"c; }
    if (rc == -19) { return "unzulaessiger Wert in einem Protokollfeld"c; }
    if (rc == -20) { return "OCSP: kein gueltiges 'good' fuer dieses Zertifikat (Vorgabe hart)"c; }
    return "unbekannter Fehler"c;
}

// Cipher-Suites (Zahlenwerte wie im Protokoll)
con CS_AES128_GCM_SHA256:   int64 := 0x1301;
con CS_AES256_GCM_SHA384:   int64 := 0x1302;
con CS_CHACHA20_SHA256:     int64 := 0x1303;

// Schluesselgruppen (RFC 8446 §4.2.7, Zahlenwerte wie im Protokoll)
con GRP_X25519:    int64 := 0x001d;
con GRP_SECP256R1: int64 := 0x0017;
con GRP_SECP384R1: int64 := 0x0018;
// Die Bitmaske dafuer (C_GRUPPEN) definiert std.net.tls_config.

// Record-Typen
con RT_CCS:        int64 := 20;
con RT_ALERT:      int64 := 21;
con RT_HANDSHAKE:  int64 := 22;
con RT_APPDATA:    int64 := 23;

// Handschlagnachrichten
con HS_CLIENT_HELLO:  int64 := 1;
con HS_SERVER_HELLO:  int64 := 2;
con HS_NEW_TICKET:    int64 := 4;
con HS_EE:            int64 := 8;
con HS_CERT:          int64 := 11;
con HS_CERT_VERIFY:   int64 := 15;
con HS_FINISHED:      int64 := 20;
con HS_CERT_REQUEST:  int64 := 13;
con HS_KEY_UPDATE:    int64 := 24;
con HS_EOED:          int64 := 5;      // end_of_early_data (§4.5)
con HS_MESSAGE_HASH:  int64 := 254;    // §4.4.1, Ersatz fuer ClientHello1 bei HRR
// Erweiterung early_data (§4.2.10). Sie steht an DREI Stellen mit DREI
// Bedeutungen: im ClientHello leer ("ich sende fruehe Daten"), in den
// EncryptedExtensions leer ("angenommen") und im NewSessionTicket mit vier
// Byte max_early_data_size.
con EXT_EARLY:        int64 := 42;

// Zustaende
con Z_START:        int64 := 0;
con Z_WARTE_SH:     int64 := 1;    // Client wartet auf ServerHello
con Z_WARTE_HS:     int64 := 2;    // Client wartet auf EE..Finished
con Z_WARTE_CH:     int64 := 3;    // Server wartet auf ClientHello
con Z_WARTE_CF:     int64 := 4;    // Server wartet auf Client-Finished
con Z_FERTIG:       int64 := 5;
con Z_FEHLER:       int64 := 6;
con Z_ZU:           int64 := 7;
con Z_WARTE_CH2:    int64 := 8;    // Server wartet nach HRR auf ClientHello2


// ---------------------------------------------------------------------------
// Verbindungszustand
//
// Ein Block je Verbindung, einmal belegt. Die vier Puffer haengen hinten dran,
// damit TlsNeu nur eine Allokation braucht und TlsFrei nur eine Freigabe.
// ---------------------------------------------------------------------------

con V_CFG:        int64 := 0;
con V_ROLLE:      int64 := 8;
con V_ZUSTAND:    int64 := 16;
con V_SUITE:      int64 := 24;
con V_HASHLEN:    int64 := 32;
con V_KEYLEN:     int64 := 40;
con V_AEAD:       int64 := 48;     // 1 AES-GCM, 2 ChaCha20-Poly1305
con V_INPOS:      int64 := 56;
con V_OUTPOS:     int64 := 64;
con V_OUTGELESEN: int64 := 72;
con V_APPPOS:     int64 := 80;
con V_APPGELESEN: int64 := 88;
con V_SEQ_LESE:   int64 := 96;
con V_SEQ_SCHR:   int64 := 104;
con V_HSCTX:      int64 := 112;    // 208 Byte Transkript-Hashzustand
con V_SEC_HS:     int64 := 320;    // handshake_secret
con V_SEC_CHS:    int64 := 368;    // client_handshake_traffic_secret
con V_SEC_SHS:    int64 := 416;    // server_handshake_traffic_secret
con V_SEC_MAST:   int64 := 464;    // master_secret
con V_SEC_CAP:    int64 := 512;    // client_application_traffic_secret
con V_SEC_SAP:    int64 := 560;    // server_application_traffic_secret
con V_SEC_EXP:    int64 := 608;    // exporter_master_secret
con V_KEY_LESE:   int64 := 656;
con V_IV_LESE:    int64 := 688;
con V_KEY_SCHR:   int64 := 704;
con V_IV_SCHR:    int64 := 736;
con V_EPH_SK:     int64 := 752;
con V_EPH_PK:     int64 := 784;
con V_PEER_PK:    int64 := 816;
// V_SHARED liegt am Ende des Blocks, weil ein P-384-Geheimnis 48 Byte hat
// und hier nur 32 frei waren (siehe unten bei O_SHARED).
con V_RANDOM:     int64 := 880;
con V_PEER_RAND:  int64 := 912;
con V_SESSID:     int64 := 944;
con V_SESSIDLEN:  int64 := 980;
con V_ALPNSEL:    int64 := 988;    // Position im ALPN-Puffer der Konfiguration
con V_ALPNSELLEN: int64 := 996;
con V_PEERCERT:   int64 := 1004;   // X509-Satz der Gegenseite (oder 0)
con V_PEERCERTOK: int64 := 1012;
con V_KRYPT_LESE: int64 := 1020;   // 0 Klartext, 1 Handschlag, 2 Anwendung
con V_KRYPT_SCHR: int64 := 1028;
con V_CERTREQ:    int64 := 1036;
con V_HSPOS:      int64 := 1044;
con V_HSGELESEN:  int64 := 1052;
con V_FEHLER:     int64 := 1060;
con V_CHLEN:      int64 := 1076;
// Das ausgehandelte ALPN-Protokoll wird HIER abgelegt, nicht als Zeiger in
// den Empfangspuffer: der Client liest es aus dem EncryptedExtensions, und
// dieser Puffer wird gleich danach wieder benutzt. Ein Zeiger darauf zeigte
// nach dem Handschlag auf fremde Byte.
con V_ALPNBUF:    int64 := 1088;
// Schluesselgruppe dieses Handschlags und das Material dazu. X25519 nutzt
// V_EPH_*, secp256r1 die EC-Felder: der Punkt ist 65 Byte (0x04||X||Y) und
// passt nicht in die 32-Byte-Felder.
con V_GRUPPE:     int64 := 1120;
con V_HRR:        int64 := 1128;   // 1 = HRR gesendet/empfangen, 2 = HRR faellig
// V_EC_SK, V_EC_PK und V_EC_PEER liegen ebenfalls am Ende (siehe unten):
// P-384 braucht 48 Byte Skalar und 97 Byte Punkt, hier waren 32 und 72 frei.
con V_KETTE:      int64 := 1312;   // gewaehlter Eintrag der SNI-Tabelle, 0 = keiner
con V_SNILEN:     int64 := 1320;
con V_KUSEND:     int64 := 1328;   // 1 = KeyUpdate der Gegenseite beantworten
con V_SNIBUF:     int64 := 1336;   // 256 Byte SNI der Gegenseite (Server)
// Cookie aus einem HelloRetryRequest. Der Client MUSS es im ClientHello2
// unveraendert zuruecksenden (§4.2.2); ein Server, der zustandslos arbeitet,
// bricht sonst ab.
con V_COOKIELEN:  int64 := 1592;
con V_COOKIE:     int64 := 1600;   // 256 Byte
// Gruppe, die ein HelloRetryRequest verlangt hat — das ClientHello2 muss
// genau diese bringen, sonst wird abgewiesen.
con V_HRRGRP:     int64 := 1856;
// Zeiger auf einen uebernommenen TLS-1.2-Zustand, oder 0. Ist er gesetzt,
// delegiert JEDE oeffentliche Funktion dieser Unit dorthin — diese Unit ist
// dann nur noch das Tor (siehe "Verteiler" weiter unten).
con V_12:         int64 := 1864;
// Das Signaturverfahren, auf das sich beide Seiten einigen. Es muss aus der
// Liste des Clients kommen (RFC 8446 §4.4.2.2) und zu unserem Schluessel
// passen; 0 heisst "noch nicht gewaehlt".
con V_SIGALG:     int64 := 1872;
// Ort und Laenge der signature_algorithms-Liste im ClientHello. Sie zeigt in
// den Empfangspuffer und ist nur SO LANGE gueltig, wie das ClientHello dort
// liegt — gewaehlt wird darum im selben Schritt, nicht spaeter.
con V_SIGLISTE:    int64 := 1880;
con V_SIGLISTELEN: int64 := 1888;
// Haben wir schon ein close_notify gesendet? RFC 8446 §6.1 verlangt, dass
// auf ein empfangenes close_notify EIN eigenes folgt — aber nur eines.
con V_CLOSEGESENDET: int64 := 1896;
// #2579: OCSP-Stapling.
//   V_OCSPWUNSCH  Server: der Client hat status_request gesendet (1/0).
//   V_OCSPPOS/LEN Client: Ort und Laenge der beigelegten DER-Antwort in den
//                 Erweiterungen des Blatt-CertificateEntry.
// Frei war hier 1904..1919 (zwischen V_CLOSEGESENDET und V_KOPF).
con V_OCSPWUNSCH: int64 := 1904;
con V_OCSPPOS:    int64 := 1912;
con V_OCSPLEN:    int64 := 1920;
// #2579: Der Kopfteil ist um 16 Byte gewachsen (drei Plaetze fuer OCSP, frei
// waren nur zwei). ALLE Bereichsanfaenge ab O_IN sind um dieselben 16 Byte
// nachgezogen -- O_IN lag genau auf 1920 und damit auf dem dritten neuen
// Platz. Der erste Versuch ohne dieses Nachziehen schrieb V_OCSPLEN in den
// EINGANGSPUFFER: jeder empfangene Record ueberschrieb ihn, und der
// Handschlag scheiterte mit -2 ("Gegenseite bietet TLS 1.3 nicht an").
// Wer hier einen Platz ergaenzt, zieht O_IN und alles danach mit.
con V_KOPF:       int64 := 1936;   // Ende des Kopfteils

// Ein Record traegt bis zu 2^14 Byte Klartext (RFC 8446 §5.2), und was
// davon nicht sofort abgeholt wird, bleibt im Puffer liegen. Mit B_HS =
// 16384 (genau 2^14) wies diese Unit darum eine ZULAESSIGE Nachricht ab,
// sobald vorher ein Byte im Puffer lag — tlsfuzzer
// (test-tls13-record-layer-limits, #2096) hat das an Finished-Nachrichten
// maximaler Groesse gezeigt. 24576 laesst einen vollen Record und einen
// angefangenen zweiten zu.
con B_IN:   int64 := 20480;
con B_OUT:  int64 := 20480;
con B_APP:  int64 := 24576;
con B_HS:   int64 := 24576;

// Die Puffer liegen hinter dem Kopf, auf 64 ausgerichtet angefuegt.
con O_IN:   int64 := 1936;
con O_OUT:  int64 := 22416;
con O_APP:  int64 := 42896;
con O_HS:   int64 := 67472;
// Der Client muss sein ClientHello aufbewahren: der Transkript-Hash haengt an
// der Cipher-Suite, und die kennt er erst mit dem ServerHello. Darum wird das
// ClientHello hier abgelegt und erst danach in den Hash gegeben.
con O_CH:   int64 := 92048;
con B_CH:   int64 := 2048;

// Kratzspeicher der Verbindung. Nach TlsNeu wird NICHTS mehr belegt: jede
// Funktion, die einen Zwischenpuffer braucht, nimmt ihr Stueck hier. Das
// erfuellt die Forderung aus #2096 ("kein Heap-Wachstum je Record") und
// umgeht zugleich defer, das in dieser Compilerfassung (1.2.31A) bei mehreren
// Eintraegen je Funktion und in verschachtelten Rahmen gemessen zu frueh
// freigab — zwei alloc(8) bekamen dieselbe Adresse, und der Schaden fiel erst
// im zweiten Handschlag auf.
con O_SCR:  int64 := 94096;      // 3584 Byte kleine Puffer (war 2560, bis
                                 // #2096 die SHA-384-Breite dazukam)
con S_TP:    int64 := 0;         // Typ/Position/Laenge beim Nachrichtenlesen
con S_PP:    int64 := 8;
con S_LP:    int64 := 16;
con S_EL:    int64 := 24;        // Laenge einer gefundenen Erweiterung
con S_KOPF:  int64 := 32;        // 5 Byte Recordkopf
con S_NONCE: int64 := 48;        // 12 Byte AEAD-Nonce
con S_TAG:   int64 := 64;        // 16 Byte AEAD-Tag
con S_TH:    int64 := 96;        // 64 Byte Transkript-Hash
con S_VD:    int64 := 160;       // 64 Byte verify_data
con S_CVBUF: int64 := 400;       // 128 Byte CertificateVerify-Rumpf
con S_PRIV:  int64 := 528;       // 48 Byte eigener Skalar
con S_SIG:   int64 := 576;       // 256 Byte Signaturinhalt (§4.4.3)
con S_HCTX:  int64 := 832;       // 208 Byte Kopie des Hashzustands
con S_K1:    int64 := 1040;      // 64 Byte: leerer Hash
con S_K2:    int64 := 1104;      // 64 Byte: Nullgeheimnis
con S_K3:    int64 := 1168;      // 64 Byte: early_secret
con S_K4:    int64 := 1232;      // 64 Byte: derived
con S_KETTE: int64 := 1296;      // 8 Eintraege (Zeiger, Laenge)
con S_WUNSCH:int64 := 1424;      // 3 Suites in Server-Vorliebe
con S_EXP1:  int64 := 1448;      // 64 Byte Exporter-Zwischenwert
con S_EXP2:  int64 := 1512;      // 64 Byte Exporter-Kontexthash
con S_FK:    int64 := 1576;      // 64 Byte finished_key
con S_ARID:  int64 := 1640;      // 16 Byte Kennung fuer den Wiederholungsschutz (#2578)
con S_RAHMEN: int64 := 1656;     // 56 Byte Rahmenblock von TkChRahmen/TkShRahmen (#2619)
con S_SIGLIST: int64 := 1712;    // 8 Schemata je int64 fuer TkExtSigAlgs (#2619)
con S_SIGBUF: int64 := 1640;     // 512 Byte fertige Signatur (RSA bis 4096 Bit)
con S_SEED:  int64 := 2152;      // 32 Byte Ed25519-Seed

con S_MH:    int64 := 2248;      // 64 Byte Hash des ClientHello1 (HRR, §4.4.1)
con S_KU:    int64 := 2312;      // 64 Byte neues Verkehrsgeheimnis (KeyUpdate)
con S_HRRC:  int64 := 2376;      // 32 Byte erwarteter HRR-Zufallswert
con S_TKPT:  int64 := 2816;      // 96 Byte Ticketklartext (#2577)
con S_TKT:   int64 := 2912;      // 128 Byte gesiegeltes Ticket
con S_TKADD: int64 := 3040;      // 4 Byte ticket_age_add
con S_BINDER: int64 := 3072;     // 64 Byte PSK-Binder
con S_FINKEY: int64 := 3136;     // 64 Byte finished_key des Binders
con S_TKPSK:  int64 := 3200;     // 64 Byte PSK aus dem Ticket (Server)
con S_TKSUITE: int64 := 3264;    // 8 Byte Suite aus dem Ticket
con S_TKHL:   int64 := 3272;     // 8 Byte Hashlaenge aus dem Ticket
con S_TKNONCE: int64 := 3280;    // 8 Byte ticket_nonce

// Alles, was mit der Breite der Kurve oder des Hashes waechst, steht hier am
// Ende und ist nach der GROESSTEN bemessenen Kombination ausgelegt
// (secp384r1 mit SHA-384). Vorher lagen diese Felder im Block oben mit
// 32 bzw. 80 Byte — also genau auf P-256 mit SHA-256 zugeschnitten; ein
// 48-Byte-Hash haette das jeweils folgende Feld ueberschrieben, und zwar
// ohne Fehlermeldung.
con S_HASH:  int64 := 2408;      // bis 48 Byte Signaturhash (SHA-384)
con S_R:     int64 := 2456;      // bis 48 Byte r
con S_S:     int64 := 2504;      // bis 48 Byte s
con S_DER:   int64 := 2552;      // bis 112 Byte DER-Signatur (P-384: 102)
con S_ECX:   int64 := 2664;      // bis 48 Byte X des ECDH-Punktes
con S_ECY:   int64 := 2712;      // bis 48 Byte Y des ECDH-Punktes
// 3288 belegt (S_TKPT, S_TKT, S_TKADD, S_BINDER, S_FINKEY, S_TKPSK,
// S_TKSUITE, S_TKHL, S_TKNONCE) —
// der Bereich ist darum auf 3584 gewachsen.

con O_REC:  int64 := 97680;      // 17408 Byte Recordzusammenbau
con O_MSG:  int64 := 115088;      // 8192 Byte Nachrichtenzusammenbau
con B_MSG:  int64 := 8192;
// Das Zertifikat der Gegenseite wird HIERHER kopiert, bevor es gelesen wird.
// Der X509-Satz haelt nur Positionen in seinem DER-Puffer; stand dieser
// Puffer im Empfangsbereich, zeigte der Satz nach dem naechsten Record auf
// fremde Byte. Gemessen: mit ECDSA und Ed25519 fiel es nicht auf (die
// folgende CertificateVerify-Nachricht ist kurz), mit RSA wurde der Modulus
// ueberschrieben und die Pruefung lehnte den eigenen Partner ab.
con O_CERT:   int64 := 123280;      // 8192 Byte Blattzertifikat
con B_CERT:   int64 := 8192;
// Dahinter der RSA-Schluessel der eigenen Seite; seine Groesse kommt aus der
// Unit, darum als Summe in TlsSpeicherBedarf.

// ── Schluesseltausch: bemessen nach der GROESSTEN Gruppe ──────────────────
//
// Diese vier Felder standen bis #2096 im dicht gepackten Feldblock oben, mit
// 32 Byte Skalar und 65 Byte Punkt — also genau auf P-256 bemessen. secp384r1
// braucht 48 und 97. Sie stehen jetzt hier am Ende, damit kein Offset
// dahinter verschoben werden musste: eine Verschiebung in diesem Block hat
// keine sichtbare Wirkung, bis zwei Felder sich ueberlappen, und dann liest
// eine Rolle, was eine andere geschrieben hat.
//
// Die Laenge des Geheimnisses ist NICHT konstant (32 bei x25519 und P-256,
// 48 bei P-384) und steht darum in V_SHAREDLEN; der Schluesselplan liest sie
// von dort, statt 32 anzunehmen.
con V_EC_SK:      int64 := 130944;   // bis 48 Byte Skalar
con V_EC_PK:      int64 := 130992;   // bis 97 Byte eigener Punkt
con V_EC_PEER:    int64 := 131096;   // bis 97 Byte Punkt der Gegenseite
con V_SHARED:     int64 := 131200;   // bis 48 Byte gemeinsames Geheimnis
con V_SHAREDLEN:  int64 := 131248;   // dessen tatsaechliche Laenge
con V_PEERALERT:  int64 := 131768;   // Alertnummer der Gegenseite, -1 = keiner
con V_PEERALERTST: int64 := 131776;  // deren Stufe (1 warning, 2 fatal)
// ── Wiederaufnahme (#2577) ───────────────────────────────────────────────
// resumption_master_secret, bis 64 Byte. Entsteht nach dem Finished des
// Clients und ist die Wurzel jedes spaeteren PSK.
con V_SEC_RES:    int64 := 131784;   // bis 64 Byte
con V_RESDA:      int64 := 131848;   // 1 = das Geheimnis steht
// Der Client bewahrt EIN Ticket auf. Mehrere waeren eine Verwaltung mit
// Auswahlregel; wer sie braucht, nimmt TlsTicketAusgeben und legt sie selbst
// ab — diese Unit haelt keinen Vorrat, weil sie keinen Speicher belegt, der
// ihr nicht gehoert.
con V_TKT:        int64 := 131856;   // bis TK_MAX Byte rohes Ticket
con V_TKTLEN:     int64 := 131984;
con V_TKTPSK:     int64 := 131992;   // bis 64 Byte abgeleiteter PSK
con V_TKTHL:      int64 := 132056;   // Hashlaenge des Tickets
con V_TKTSUITE:   int64 := 132064;   // Suite, zu der es gehoert
con V_TKTAGEADD:  int64 := 132072;   // ticket_age_add der Gegenseite
con V_TKTLEBEN:   int64 := 132080;   // ticket_lifetime in Sekunden
con V_TKTZEIT:    int64 := 132088;   // Empfangszeit (eigene Uhr)
// Serverseite: Ort und Laenge der pre_shared_key-Erweiterung im zuletzt
// gelesenen ClientHello, und ob der PSK angenommen wurde.
con V_PSKPOS:     int64 := 132096;
con V_PSKLEN:     int64 := 132104;
con V_PSKDA:      int64 := 132112;   // 1 = angenommen
// Zaehler gesendeter Nachrichten (Nachweis, nicht Betrieb).
con V_ZCERT:      int64 := 132120;
con V_ZCV:        int64 := 132128;
con V_ZNST:       int64 := 132136;
// ── 0-RTT (#2578) ────────────────────────────────────────────────────────
// Die Felder liegen HINTEN, wie schon die der Wiederaufnahme: eine
// Verschiebung im Kopfteil hat keine sichtbare Wirkung, bis zwei Felder
// sich ueberlappen, und dann liest eine Rolle, was eine andere geschrieben
// hat (#2579 hat das einmal mit dem Eingangspuffer vorgemacht).
//
// V_EDZUSTAND ist der ganze Ablauf in einer Zahl:
//   0  kein 0-RTT
//   1  angeboten (Client: ClientHello traegt early_data; Schreibschluessel
//      steht auf dem fruehen Geheimnis)
//   2  angenommen (Client: EncryptedExtensions sagt ja; Server: er nimmt an)
//   3  abgelehnt (Client: EE sagt nichts; Server: er nimmt nicht an)
con V_EDZUSTAND:  int64 := 132144;
con V_EDWUNSCH:   int64 := 132152;   // Server: ClientHello traegt early_data
con V_EDMAX:      int64 := 132160;   // Obergrenze dieser Verbindung in Byte
con V_EDGESCHR:   int64 := 132168;   // Client: frueh gesendete Byte
con V_EDGELESEN:  int64 := 132176;   // Server: frueh empfangene Byte
con V_EDFLAG:     int64 := 132184;   // 1 = das letzte TlsLese war frueh
// Bis zu dieser Stelle im Anwendungspuffer sind die Byte FRUEH. Alles
// danach kam unter den Anwendungsschluesseln. Eine Grenze und kein Flag je
// Record: der Puffer ist fortlaufend, und ein Flag je Record koennte nicht
// sagen, wo in einem Lesevorgang die Grenze liegt.
con V_EDGRENZE:   int64 := 132192;
con V_EOEDGES:    int64 := 132200;   // Client: end_of_early_data gesendet
con V_EOEDEMP:    int64 := 132208;   // Server: end_of_early_data gesehen
// Ablehnungsweg (§4.2.10): der Server kennt den fruehen Schluessel nicht und
// MUSS die Records verwerfen koennen, ohne sie zu entschluesseln. Wie viele
// es sind, weiss er nicht — verworfen wird, bis einer sich mit dem
// Handschlagschluessel oeffnen laesst.
con V_SKIPUNDEC:  int64 := 132216;
con V_SKIPZAHL:   int64 := 132224;
// Client: max_early_data_size aus dem NewSessionTicket. Ohne diesen Wert
// bietet der Client kein 0-RTT an — der Server hat dann nie gesagt, dass er
// es annimmt.
con V_TKTEDMAX:   int64 := 132232;
// Server: Ausstellzeit des vorgelegten Tickets (aus dem Ticket selbst, nicht
// aus der Behauptung des Clients) und dessen Kennung fuer den
// Wiederholungsschutz. Die Kennung IST die GCM-Nonce des Tickets: sie ist
// zufaellig, je Ticket einmalig, und steht im Klartextkopf.
con V_TKTAUSZEIT: int64 := 132240;
con V_TKTID:      int64 := 132248;   // 16 Byte
// client_early_traffic_secret (§7.1). Eigenes Feld und nicht V_SEC_CHS
// mitbenutzt: beim Ablehnen laeuft der Handschlag mit den
// Handschlaggeheimnissen weiter, und beide muessen gleichzeitig gelten.
con V_SEC_CET:    int64 := 132264;   // bis 64 Byte
// Wurde das Dummy-CCS (Anhang D.4) schon gesendet? Es gehoert UNMITTELBAR
// hinter die erste eigene Handschlagnachricht, und bei einem
// HelloRetryRequest ist das der HRR und nicht das ServerHello. Ein zweites
// waere nicht verboten, aber dieser Zaehler macht die Stelle eindeutig.
con V_CCSGES:     int64 := 132328;
// Erst hinter den neuen Feldern beginnt der dynamische Teil: RSA-Schluessel,
// dann der Zertifikatssatz. O_RSAKEY MUSS gleich V_SIZE sein — stand es
// davor, lag der RSA-Modulus auf den EC-Feldern, und beim ersten Handschlag
// mit RSA-Kette haette eine Rolle gelesen, was die andere geschrieben hat.
// V_SIZE ist um die 0-RTT-Felder gewachsen (#2578). O_RSAKEY MUSS gleich
// V_SIZE bleiben — stand es davor, lag der RSA-Modulus auf den neuen
// Feldern.
con V_SIZE:   int64 := 132352;
con O_RSAKEY: int64 := 132352;

pub fn TlsSpeicherBedarf(): int64 {
    // #2579: zwei X509-Saetze und ein OCSP-Satz. Der zweite Satz ist der
    // AUSSTELLER -- die CertID bindet an dessen Namen und Schluessel, und die
    // Signatur der Antwort wird gegen denselben Schluessel geprueft. Ihn in
    // denselben Satz zu lesen wie das Blatt waere die Rolle-Ueberlappung, die
    // in dieser Unit schon einmal mit RSA den eigenen Partner abgelehnt hat.
    return V_SIZE + RsaSchluesselGroesse() + 2 * X509Groesse() + OcspGroesse();
}

// #2579: Aussteller-Satz und OCSP-Befund, hinter dem Blatt-Satz.
fn pAussteller(c: int64): int64 {
    return c + V_SIZE + RsaSchluesselGroesse() + X509Groesse();
}
fn pOcspSatz(c: int64): int64 {
    return c + V_SIZE + RsaSchluesselGroesse() + 2 * X509Groesse();
}

fn pIn(c: int64): int64  { return c + O_IN; }
fn pOut(c: int64): int64 { return c + O_OUT; }
fn pApp(c: int64): int64 { return c + O_APP; }
fn pHs(c: int64): int64  { return c + O_HS; }
fn pCh(c: int64): int64  { return c + O_CH; }
fn pScr(c: int64): int64 { return c + O_SCR; }
fn pRec(c: int64): int64 { return c + O_REC; }
fn pMsg(c: int64): int64 { return c + O_MSG; }
fn pRsa(c: int64): int64 { return c + O_RSAKEY; }
fn pCert(c: int64): int64 { return c + O_CERT; }

pub fn TlsNeu(cfg: int64): int64 {
    var c: int64 := alloc(TlsSpeicherBedarf());
    if (c == 0) { return 0; }
    var i: int64 := 0;
    while (i < V_KOPF) { poke8(c + i, 0); i := i + 1; }
    // -1 und nicht 0: die 0 ist close_notify und damit eine Aussage.
    poke64(c + V_PEERALERT, 0 - 1);
    poke64(c + V_PEERALERTST, 0);
    poke64(c + V_CFG, cfg);
    poke64(c + V_ROLLE, TlsCfgRolle(cfg));
    // #2578: Die Nullschleife oben laeuft nur bis V_KOPF — alles, was HINTER
    // den Puffern liegt, bleibt unberuehrt. Fuer die 0-RTT-Felder ist das
    // nicht hinnehmbar: ein Muellwert in V_EDZUSTAND hiesse "angeboten",
    // und V_EDMAX wuerde ueber die Grenze der fruehen Daten entscheiden.
    // Dass alloc() heute genullte Seiten liefert, ist eine Eigenschaft des
    // Allokators und keine Zusage dieser Unit (es gibt zwei davon, und der
    // Arena-Allokator gibt Speicher wieder heraus).
    poke64(c + V_EDZUSTAND, 0);
    poke64(c + V_EDWUNSCH, 0);
    poke64(c + V_EDMAX, 0);
    poke64(c + V_EDGESCHR, 0);
    poke64(c + V_EDGELESEN, 0);
    poke64(c + V_EDFLAG, 0);
    poke64(c + V_EDGRENZE, 0);
    poke64(c + V_EOEDGES, 0);
    poke64(c + V_EOEDEMP, 0);
    poke64(c + V_SKIPUNDEC, 0);
    poke64(c + V_SKIPZAHL, 0);
    poke64(c + V_TKTEDMAX, 0);
    poke64(c + V_TKTAUSZEIT, 0);
    poke64(c + V_CCSGES, 0);
    poke64(c + V_PEERCERT, c + V_SIZE + RsaSchluesselGroesse());
    if (TlsCfgRolle(cfg) == 1) {
        poke64(c + V_ZUSTAND, Z_WARTE_CH);
    } else {
        poke64(c + V_ZUSTAND, Z_START);
    }
    return c;
}

pub fn TlsFrei(c: int64): void {
    if (c == 0) { return; }
    if (peek64(c + V_12) != 0) { Tls12Frei(peek64(c + V_12)); poke64(c + V_12, 0); }
    // Schluessel und Geheimnisse nicht im Speicher liegen lassen.
    SecureZero(c + V_SEC_HS, V_KOPF - V_SEC_HS);
    free(c, TlsSpeicherBedarf());
}

pub fn TlsZustand(c: int64): int64 {
    if (peek64(c + V_12) != 0) { return Tls12Zustand(peek64(c + V_12)); }
    return peek64(c + V_ZUSTAND);
}
pub fn TlsFertig(c: int64): bool {
    if (peek64(c + V_12) != 0) { return Tls12Fertig(peek64(c + V_12)); }
    return peek64(c + V_ZUSTAND) == Z_FERTIG;
}
pub fn TlsSuite(c: int64): int64 {
    if (peek64(c + V_12) != 0) { return Tls12Suite(peek64(c + V_12)); }
    return peek64(c + V_SUITE);
}

// Ausgehandelte Protokollversion: 0x0303 oder 0x0304. Erst nach dem
// Handschlag verlaesslich.
pub fn TlsVersion(c: int64): int64 {
    if (peek64(c + V_12) != 0) { return 0x0303; }
    return 0x0304;
}

// Ausgewaehltes ALPN-Protokoll (Ausschnitt im ALPN-Puffer der Konfiguration).
pub fn TlsAlpnPos(c: int64): int64 {
    if (peek64(c + V_12) != 0) { return Tls12AlpnPos(peek64(c + V_12)); }
    return peek64(c + V_ALPNSEL);
}
pub fn TlsAlpnLen(c: int64): int64 {
    if (peek64(c + V_12) != 0) { return Tls12AlpnLen(peek64(c + V_12)); }
    return peek64(c + V_ALPNSELLEN);
}

// Ausgehandelte Schluesselgruppe (0x001d x25519, 0x0017 secp256r1).
// Ein Ticket aus dieser Verbindung siegeln — fuer die Ticketschicht und fuer
// Pruefstaende. Rueckgabe ist die Laenge, 0 wenn kein Ticket moeglich ist
// (kein Ticketschluessel in der Konfiguration oder noch kein
// resumption_master_secret).
pub fn TlsTicketSiegeln(c: int64, jetzt: int64, nonce: int64, nonceLen: int64,
                        out: int64, cap: int64): int64 {
    if (cap < TlsTicketMax()) { return 0; }
    if (nonce == 0 || nonceLen <= 0) { return 0; }
    return ticketSiegeln(c, jetzt, nonce, nonceLen, out);
}

// Gegenstueck. Rueckgabe ist die Laenge des Geheimnisses, 0 bei "nicht
// brauchbar" — und das ist kein Fehler, sondern der Normalfall eines
// abgelaufenen oder fremden Tickets (RFC 8446 §4.2.11).
pub fn TlsTicketOeffnen(c: int64, tkt: int64, tktLen: int64, jetzt: int64,
                        suiteOut: int64, hlOut: int64, secOut: int64): int64 {
    return ticketOeffnen(c, tkt, tktLen, jetzt, suiteOut, hlOut, secOut);
}

pub fn TlsTicketMax(): int64 { return TK_MAX; }

// Hat der Client ein brauchbares Ticket gemerkt? Rueckgabe ist seine Laenge,
// 0 wenn keines da ist. Fuer Diagnose und Pruefstaende — und fuer eine
// Anwendung, die Tickets selbst ablegen will.
pub fn TlsTicketDa(c: int64): int64 { return peek64(c + V_TKTLEN); }

// Wurde diese Verbindung ueber einen PSK WIEDERAUFGENOMMEN? 1 = ja.
// Das ist die Frage, an der eine Wiederaufnahme messbar ist — zusammen
// damit, dass im Serverflug kein CertificateVerify steht.
pub fn TlsWiederaufgenommen(c: int64): int64 { return peek64(c + V_PSKDA); }

// Zaehler der SELBST gesendeten Handschlagnachrichten je Typ — fuer den
// Nachweis, dass bei einer Wiederaufnahme KEIN Certificate und KEIN
// CertificateVerify im Flug steht (§4.1.1). Ohne diesen Zaehler waere der
// Beleg nur "es war schneller", und das ist keine Aussage: ein voller
// Handschlag auf schneller Maschine sieht genauso aus.
pub fn TlsGesendet(c: int64, typ: int64): int64 {
    if (typ == HS_CERT) { return peek64(c + V_ZCERT); }
    if (typ == HS_CERT_VERIFY) { return peek64(c + V_ZCV); }
    if (typ == HS_NEW_TICKET) { return peek64(c + V_ZNST); }
    return 0;
}

// Ein Ticket von aussen EINSETZEN: so nimmt eine Anwendung eine Sitzung in
// einer NEUEN Verbindung wieder auf. `psk` ist der aus dem Ticket
// abgeleitete Schluessel (TlsTicketPsk), `suite` und `hl` gehoeren dazu.
//
// Ohne diese Funktion waere die Wiederaufnahme auf dieselbe
// Verbindungsstruktur beschraenkt — und damit sinnlos, denn genau die wird
// ja geschlossen.
pub fn TlsTicketEinsetzen(c: int64, tkt: int64, tktLen: int64,
                          psk: int64, hl: int64, suite: int64,
                          ageAdd: int64, empfangen: int64): bool {
    if (tktLen <= 0 || tktLen > TK_MAX) { return false; }
    if (hl != 32 && hl != 48) { return false; }
    if (tkt == 0 || psk == 0) { return false; }
    var i: int64 := 0;
    while (i < tktLen) { poke8(c + V_TKT + i, peek8(tkt + i)); i := i + 1; }
    i := 0;
    while (i < hl) { poke8(c + V_TKTPSK + i, peek8(psk + i)); i := i + 1; }
    poke64(c + V_TKTLEN, tktLen);
    poke64(c + V_TKTHL, hl);
    poke64(c + V_TKTSUITE, suite);
    poke64(c + V_TKTAGEADD, ageAdd);
    poke64(c + V_TKTZEIT, empfangen);
    return true;
}

// Die Angaben, die zu einem Ticket gehoeren und beim Einsetzen gebraucht
// werden. Ohne sie koennte der Aufrufer das Ticket nicht wiederverwenden.
// #2578: max_early_data_size dieses Tickets. 0 heisst "der Server erlaubt
// damit kein 0-RTT" — und ohne diese Zahl bietet der Client auch keines an.
// Beim Uebertragen eines Tickets in eine neue Verbindung gehoert sie
// mitgenommen, sonst ist das Ticket brauchbar und 0-RTT trotzdem aus.
pub fn TlsTicketFruehMax(c: int64): int64 { return peek64(c + V_TKTEDMAX); }
pub fn TlsTicketFruehMaxEinsetzen(c: int64, max: int64): void {
    if (max < 0) { poke64(c + V_TKTEDMAX, 0); return; }
    poke64(c + V_TKTEDMAX, max);
}

pub fn TlsTicketSuite(c: int64): int64   { return peek64(c + V_TKTSUITE); }
pub fn TlsTicketAgeAdd(c: int64): int64  { return peek64(c + V_TKTAGEADD); }
pub fn TlsTicketZeit(c: int64): int64    { return peek64(c + V_TKTZEIT); }
pub fn TlsTicketRoh(c: int64, out: int64, cap: int64): int64 {
    var tl: int64 := peek64(c + V_TKTLEN);
    if (tl <= 0 || cap < tl) { return 0; }
    var i: int64 := 0;
    while (i < tl) { poke8(out + i, peek8(c + V_TKT + i)); i := i + 1; }
    return tl;
}

// Der aus dem Ticket abgeleitete PSK. Rueckgabe ist die Laenge, 0 wenn es
// keinen gibt. GEHEIMNIS: wer ihn kennt, nimmt die Sitzung wieder auf.
pub fn TlsTicketPsk(c: int64, out: int64, cap: int64): int64 {
    var hl: int64 := peek64(c + V_TKTHL);
    if (peek64(c + V_TKTLEN) <= 0 || hl <= 0 || cap < hl) { return 0; }
    var i: int64 := 0;
    while (i < hl) { poke8(out + i, peek8(c + V_TKTPSK + i)); i := i + 1; }
    return hl;
}

// Das resumption_master_secret nach aussen geben — nur fuer Pruefstaende und
// fuer die Ticketschicht. Rueckgabe ist die Laenge, 0 wenn es (noch) keines
// gibt. Es ist ein GEHEIMNIS: wer es kennt, kann sich als diese Sitzung
// ausgeben, darum steht hier kein Zugang zum Setzen.
pub fn TlsWiederaufnahmeGeheimnis(c: int64, out: int64, cap: int64): int64 {
    if (peek64(c + V_RESDA) != 1) { return 0; }
    var hl: int64 := peek64(c + V_HASHLEN);
    if (cap < hl) { return 0; }
    var i: int64 := 0;
    while (i < hl) { poke8(out + i, peek8(c + V_SEC_RES + i)); i := i + 1; }
    return hl;
}

// Welchen Alert hat die Gegenseite geschickt? -1 heisst "keinen".
// Die Nummern stehen in RFC 8446 §6: 40 handshake_failure,
// 42 bad_certificate, 46 certificate_unknown, 47 illegal_parameter,
// 48 unknown_ca, 50 decode_error, 51 decrypt_error, 70 protocol_version,
// 109 missing_extension, 112 unrecognized_name.
pub fn TlsPeerAlert(c: int64): int64 {
    return peek64(c + V_PEERALERT);
}

// Stufe des empfangenen Alerts (1 Warnung, 2 fatal), 0 wenn keiner kam.
// In TLS 1.3 ist sie fuer die Behandlung bedeutungslos (§6.1) und nur fuer
// die Diagnose da.
pub fn TlsPeerAlertStufe(c: int64): int64 {
    return peek64(c + V_PEERALERTST);
}

pub fn TlsGruppe(c: int64): int64 {
    if (peek64(c + V_12) != 0) { return Tls12Gruppe(peek64(c + V_12)); }
    return peek64(c + V_GRUPPE);
}

// SNI der Gegenseite (Server-Rolle): Zeiger und Laenge, 0 wenn keines kam.
pub fn TlsSniPos(c: int64): int64 {
    if (peek64(c + V_12) != 0) { return Tls12SniPos(peek64(c + V_12)); }
    if (peek64(c + V_SNILEN) == 0) { return 0; }
    return c + V_SNIBUF;
}
pub fn TlsSniLen(c: int64): int64 {
    if (peek64(c + V_12) != 0) { return Tls12SniLen(peek64(c + V_12)); }
    return peek64(c + V_SNILEN);
}

// X509-Satz der Gegenseite, oder 0 wenn keines geprueft wurde.
pub fn TlsPeerZertifikat(c: int64): int64 {
    if (peek64(c + V_12) != 0) { return Tls12PeerZertifikat(peek64(c + V_12)); }
    if (peek64(c + V_PEERCERTOK) == 0) { return 0; }
    return peek64(c + V_PEERCERT);
}

// ---------------------------------------------------------------------------
// Ein- und Ausgabe
// ---------------------------------------------------------------------------

// Empfangene Byte uebernehmen. Liefert die Anzahl uebernommener Byte; was
// nicht passt, bleibt beim Aufrufer (kein stilles Verwerfen).
pub fn TlsFuetter(c: int64, buf: int64, len: int64): int64 {
    if (peek64(c + V_12) != 0) { return Tls12Fuetter(peek64(c + V_12), buf, len); }
    var pos: int64 := peek64(c + V_INPOS);
    var platz: int64 := B_IN - pos;
    var n: int64 := len;
    if (n > platz) { n := platz; }
    var i: int64 := 0;
    while (i < n) { poke8(pIn(c) + pos + i, peek8(buf + i)); i := i + 1; }
    poke64(c + V_INPOS, pos + n);
    return n;
}

// Zu sendende Byte abholen.
pub fn TlsAusgabe(c: int64, buf: int64, cap: int64): int64 {
    if (peek64(c + V_12) != 0) { return Tls12Ausgabe(peek64(c + V_12), buf, cap); }
    var gelesen: int64 := peek64(c + V_OUTGELESEN);
    var vorhanden: int64 := peek64(c + V_OUTPOS) - gelesen;
    if (vorhanden <= 0) { return 0; }
    var n: int64 := vorhanden;
    if (n > cap) { n := cap; }
    var i: int64 := 0;
    while (i < n) { poke8(buf + i, peek8(pOut(c) + gelesen + i)); i := i + 1; }
    gelesen += n;
    if (gelesen == peek64(c + V_OUTPOS)) {
        poke64(c + V_OUTPOS, 0);
        poke64(c + V_OUTGELESEN, 0);
    } else {
        poke64(c + V_OUTGELESEN, gelesen);
    }
    return n;
}

pub fn TlsAusgabeOffen(c: int64): int64 {
    if (peek64(c + V_12) != 0) { return Tls12AusgabeOffen(peek64(c + V_12)); }
    return peek64(c + V_OUTPOS) - peek64(c + V_OUTGELESEN);
}

fn outAnhaengen(c: int64, daten: int64, len: int64): int64 {
    var pos: int64 := peek64(c + V_OUTPOS);
    if (pos + len > B_OUT) { return E_PUFFER; }
    var i: int64 := 0;
    while (i < len) { poke8(pOut(c) + pos + i, peek8(daten + i)); i := i + 1; }
    poke64(c + V_OUTPOS, pos + len);
    return 0;
}

fn outByte(c: int64, b: int64): int64 {
    var pos: int64 := peek64(c + V_OUTPOS);
    if (pos + 1 > B_OUT) { return E_PUFFER; }
    poke8(pOut(c) + pos, b & 0xFF);
    poke64(c + V_OUTPOS, pos + 1);
    return 0;
}

// ---------------------------------------------------------------------------
// Hash und Schluesselplan
// ---------------------------------------------------------------------------

fn hashInit(c: int64): void {
    if (peek64(c + V_HASHLEN) == 48) { Sha384Init(c + V_HSCTX); }
    else { Sha256Init(c + V_HSCTX); }
}

fn hashUpdate(c: int64, daten: int64, len: int64): void {
    if (peek64(c + V_HASHLEN) == 48) { Sha512Update(c + V_HSCTX, daten, len); }
    else { Sha256Update(c + V_HSCTX, daten, len); }
}

// Transkript-Hash OHNE den laufenden Zustand zu verbrauchen: der Zustand wird
// kopiert und die Kopie abgeschlossen. Sha256- und Sha512-Zustand sind flache
// Bloecke, das Kopieren ist also vollstaendig.
fn hashJetzt(c: int64, out: int64): void {
    var gr: int64 := Sha512CtxSize();
    var k: int64 := pScr(c) + S_HCTX;
    var i: int64 := 0;
    while (i < gr) { poke8(k + i, peek8(c + V_HSCTX + i)); i := i + 1; }
    if (peek64(c + V_HASHLEN) == 48) { Sha384Final(k, out); }
    else { Sha256Final(k, out); }
}

fn hashLeer(c: int64, out: int64): void {
    TkHashLeer(peek64(c + V_HASHLEN), out);
}

// Schluessel und IV eines Verkehrsgeheimnisses (RFC 8446 §7.3).
fn verkehrsSchluessel(c: int64, secret: int64, keyOut: int64, ivOut: int64): bool {
    return TkVerkehrsSchluessel(peek64(c + V_HASHLEN), peek64(c + V_KEYLEN),
                                secret, keyOut, ivOut);
}

// Das early_secret — der einzige Unterschied zwischen vollem Handschlag und
// Wiederaufnahme (RFC 8446 §7.1):
//
//     voll:            early_secret = HKDF-Extract(0, 0)
//     Wiederaufnahme:  early_secret = HKDF-Extract(0, PSK)
//
// `psk` == 0 heisst "kein PSK". Ein Parameter statt zweier Fassungen des
// Plans: zwei Rechnungen derselben Art nebeneinander sind in diesem Repo
// regelmaessig auseinandergelaufen.
// `hl` wird UEBERGEBEN und nicht aus V_HASHLEN gelesen: beim ClientHello
// steht die Suite noch nicht fest, V_HASHLEN ist dort 0, und der Binder
// rechnet ohnehin mit dem Hash des TICKETS (§4.2.11.2) — nicht mit dem der
// noch nicht verhandelten Suite. Gefunden durch einen Panic aus HKDF
// ("unbekannte Digestlaenge"), also durch laut Scheitern und nicht durch
// stilles Weiterrechnen.
fn planEarly(c: int64, hl: int64, psk: int64, pskLen: int64, early: int64): void {
    // Der Nullplatz bleibt S_K2 -- der Bereich gehoert dieser Rolle, und die
    // Rechnung steht seit #2619 in std.net.tls_kern.
    TkPlanEarly(hl, psk, pskLen, pScr(c) + S_K2, early);
}

// finished_key aus einem Geheimnis (§4.4.4). Dieselbe Rechnung braucht das
// Finished und der PSK-Binder — der Binder IST ein Finished ueber das halbe
// ClientHello, darum EINE Funktion fuer beide.
fn finishedKey(c: int64, hl: int64, secret: int64, out: int64): bool {
    return TkFinishedKey(hl, secret, out);
}

// binder_key = Derive-Secret(early_secret, "res binder", "") (§7.1).
// Danach daraus der finished_key, mit dem der Binder gerechnet wird.
fn binderKey(c: int64, hl: int64, psk: int64, pskLen: int64, out: int64): bool {
    // Dieselben drei Kratzplaetze wie vorher (S_K1 leerer Hash, S_K3
    // early_secret, S_K4 binder_key), nur dass die Rechnung seit #2619 in
    // std.net.tls_kern liegt. Sie werden EINZELN uebergeben, damit die
    // Zuordnung Bereich-zu-Rolle hier sichtbar bleibt und nicht in einer
    // Abstandsrechnung der anderen Unit verschwindet.
    return TkBinderKey(hl, psk, pskLen,
                       pScr(c) + S_K1, pScr(c) + S_K3, pScr(c) + S_K4, out);
}

// client_early_traffic_secret (RFC 8446 §7.1, #2578):
//
//     cet = Derive-Secret(early_secret, "c e traffic", ClientHello)
//
// Zwei Dinge sind hier anders als im uebrigen Plan, und beide sind schon
// einmal Fehlerquellen gewesen:
//
//   * Die HASHLAENGE kommt vom TICKET und nicht aus V_HASHLEN. Beim Client
//     steht die Suite noch nicht fest, wenn er die fruehen Daten schreibt —
//     V_HASHLEN ist dort 0, und HKDF scheitert laut mit "unbekannte
//     Digestlaenge". Dieselbe Regel wie beim Binder (§4.2.11.2).
//   * Der Transkriptstand ist GENAU das ClientHello, einschliesslich der
//     Binder. Gerechnet wird darum ueber die aufbewahrten Byte und nicht
//     ueber den laufenden Hashzustand: der beginnt beim Client erst mit dem
//     ServerHello, und auf der Serverseite laeuft er zu diesem Zeitpunkt
//     schon weiter.
fn planFrueh(c: int64, hl: int64, psk: int64, pskLen: int64,
             chPos: int64, chLen: int64): bool {
    var early: int64 := pScr(c) + S_K3;
    var th: int64 := pScr(c) + S_TH;
    planEarly(c, hl, psk, pskLen, early);
    if (hl == 48) { Sha384(chPos, chLen, th); } else { SHA256(chPos, chLen, th); }
    var ok: bool := HkdfExpandLabel(hl, early, hl, "c e traffic"c as int64, 11,
                                    th, hl, c + V_SEC_CET, hl);
    SecureZero(early, 64);
    return ok;
}

// Der ganze Schluesselplan bis zu den Handschlagschluesseln. `psk` == 0
// heisst voller Handschlag.
fn planHandschlagPsk(c: int64, psk: int64, pskLen: int64): bool {
    var hl: int64 := peek64(c + V_HASHLEN);
    var leer: int64 := pScr(c) + S_K1;
    var null0: int64 := pScr(c) + S_K2;
    var early: int64 := pScr(c) + S_K3;
    var derived: int64 := pScr(c) + S_K4;
    var th: int64 := pScr(c) + S_TH;
    var i: int64 := 0;
    while (i < 64) { poke8(null0 + i, 0); i := i + 1; }
    hashLeer(c, leer);

    planEarly(c, hl, psk, pskLen, early);
    // derived = Derive-Secret(early, "derived", "")
    if (!HkdfExpandLabel(hl, early, hl, "derived"c as int64, 7, leer, hl, derived, hl)) {
        return false;
    }
    // handshake_secret = HKDF-Extract(derived, ECDHE)
    // Laenge aus dem Feld, nicht geraten: bei secp384r1 sind es 48 Byte.
    HkdfExtract(hl, derived, hl, c + V_SHARED, peek64(c + V_SHAREDLEN),
                c + V_SEC_HS);

    hashJetzt(c, th);
    if (!HkdfExpandLabel(hl, c + V_SEC_HS, hl, "c hs traffic"c as int64, 12,
                         th, hl, c + V_SEC_CHS, hl)) { return false; }
    if (!HkdfExpandLabel(hl, c + V_SEC_HS, hl, "s hs traffic"c as int64, 12,
                         th, hl, c + V_SEC_SHS, hl)) { return false; }

    // master_secret = HKDF-Extract(Derive-Secret(hs, "derived", ""), 0)
    if (!HkdfExpandLabel(hl, c + V_SEC_HS, hl, "derived"c as int64, 7,
                         leer, hl, derived, hl)) { return false; }
    HkdfExtract(hl, derived, hl, null0, hl, c + V_SEC_MAST);

    SecureZero(early, 64); SecureZero(derived, 64);
    return true;
}

// Der volle Handschlag ist der Plan ohne PSK — eine Zeile, damit die
// bestehenden Aufrufstellen unveraendert bleiben.
fn planHandschlag(c: int64): bool {
    return planHandschlagPsk(c, 0, 0);
}

// ── Ticketformat (#2577) ──────────────────────────────────────────────────
//
// Fassung | Generation | Nonce(12) | AES-256-GCM(Klartext) | Tag(16)
//
// Die ersten zwei Byte sind Klartext UND assoziierte Daten: der Leser
// braucht die Generation, um ueberhaupt den richtigen Schluessel zu waehlen,
// und weil sie in der AAD steht, laesst ein gekipptes Byte das Tag
// scheitern. Die Nonce ist ZUFAELLIG und nicht gezaehlt — zwei Server mit
// demselben Ticketschluessel und je einem Zaehler bei 0 benutzten sonst
// dieselbe Nonce zweimal, und eine wiederholte GCM-Nonce gibt den
// Authentifizierungsschluessel her.
con TK_FASSUNG:   int64 := 1;
con TK_KOPF:      int64 := 14;    // Fassung + Generation + Nonce
con TK_TAG:       int64 := 16;
// Klartext: Suite(2) Hashlaenge(1) Ausstellzeit(8) Lebensdauer(4)
// Geheimnislaenge(1) Geheimnis(hl)
con TK_RUMPF_FEST: int64 := 16;
con TK_MAX:       int64 := 128;   // 14 + 16 + 64 + 16 = 110, aufgerundet

// Schreibt ein Ticket nach `out`. Rueckgabe ist die Laenge, 0 bei Fehler.
// Der Aufrufer stellt sicher, dass out mindestens TK_MAX Byte hat.
// `nonce`/`nonceLen` ist die ticket_nonce, die mit dem NewSessionTicket
// hinausgeht. Gesiegelt wird der daraus ABGELEITETE PSK
//
//     PSK = HKDF-Expand-Label(res master, "resumption", nonce, hl)
//
// und nicht das resumption_master_secret selbst. Der Client rechnet genau
// diese Ableitung (§4.6.1); wer serverseitig das res_master siegelt und
// spaeter direkt als PSK benutzt, hat ein anderes Geheimnis als die
// Gegenseite — der Binder stimmt dann nie. Genau so ist es beim Bauen
// passiert, und der Lauf hat es als E_SIGNATUR gemeldet.
// ACHTUNG, zwei verschiedene Nonces in einer Funktion:
//   tnonce  die ticket_nonce aus dem NewSessionTicket — sie geht in die
//           PSK-Ableitung (§4.6.1)
//   gnonce  die AES-GCM-Nonce dieses Tickets, 12 zufaellige Byte
// Der erste Entwurf nannte den Parameter `nonce`, und die lokale GCM-Nonce
// hiess ebenso: sie UEBERSCHATTETE ihn ab ihrer Deklaration, und der PSK
// wurde aus dem ersten Byte der Zufallsnonce abgeleitet statt aus der
// ticket_nonce. Der Client rechnete richtig, der Server falsch, und der
// Lauf meldete E_SIGNATUR am Binder. Dieselbe Falle wie bei `n` gegen die
// Kurvenordnung in std/crypto/ec.lyx — darum hier Namen, die sich nicht
// verwechseln lassen.
fn ticketSiegeln(c: int64, jetzt: int64, tnonce: int64, tnonceLen: int64,
                 out: int64): int64 {
    var cfg: int64 := peek64(c + V_CFG);
    var gen: int64 := TlsCfgTicketGen(cfg);
    if (gen == 0) { return 0; }                  // kein Schluessel: keine Tickets
    var key: int64 := TlsCfgTicketKey(cfg, gen);
    if (key == 0) { return 0; }
    if (peek64(c + V_RESDA) != 1) { return 0; }  // ohne Geheimnis kein Ticket
    var hl: int64 := peek64(c + V_HASHLEN);
    var leben: int64 := TlsCfgTicketLeben(cfg);

    poke8(out, TK_FASSUNG);
    poke8(out + 1, gen);
    var gnonce: int64 := out + 2;
    if (RandBytesExact(gnonce, 12) != 12) { return 0; }

    // Klartext zusammenstellen
    // Eigener Kratzplatz: der Rumpf braucht 16 + hl, also bis 64 Byte, und
    // S_K1 und die anderen 64-Byte-Plaetze sind beim Schluesselplan belegt.
    var scr: int64 := pScr(c);
    var pt: int64 := scr + S_TKPT;
    var sw: int64 := peek64(c + V_SUITE);
    poke8(pt, (sw >> 8) & 0xFF);
    poke8(pt + 1, sw & 0xFF);
    poke8(pt + 2, hl);
    var i: int64 := 0;
    while (i < 8) { poke8(pt + 3 + i, (jetzt >> (56 - i * 8)) & 0xFF); i := i + 1; }
    i := 0;
    while (i < 4) { poke8(pt + 11 + i, (leben >> (24 - i * 8)) & 0xFF); i := i + 1; }
    poke8(pt + 15, hl);
    // Der ABGELEITETE PSK, nicht das res_master.
    if (!HkdfExpandLabel(hl, c + V_SEC_RES, hl, "resumption"c as int64, 10,
                         tnonce, tnonceLen, pt + 16, hl)) {
        SecureZero(pt, TK_RUMPF_FEST + hl);
        return 0;
    }
    var ptLen: int64 := TK_RUMPF_FEST + hl;

    var ct: int64 := out + TK_KOPF;
    var tag: int64 := ct + ptLen;
    if (!AesGcmSeal(key, 32, gnonce, 12, out, 2, pt, ptLen, ct, tag, TK_TAG)) {
        SecureZero(pt, ptLen);
        return 0;
    }
    SecureZero(pt, ptLen);
    return TK_KOPF + ptLen + TK_TAG;
}

// Liest ein Ticket. Schreibt Suite nach `suiteOut`, Hashlaenge nach
// `hlOut`, das Geheimnis nach `secOut` und liefert dessen Laenge; 0 heisst
// "nicht brauchbar".
//
// NICHT brauchbar ist KEIN Fehler: RFC 8446 §4.2.11 erlaubt dem Server, ein
// Ticket zu ignorieren und einen vollen Handschlag zu fuehren. Ein Abbruch
// waere hier falsch — ein abgelaufenes Ticket ist Alltag, kein Angriff.
fn ticketOeffnen(c: int64, tkt: int64, tktLen: int64, jetzt: int64,
                 suiteOut: int64, hlOut: int64, secOut: int64): int64 {
    if (tktLen < TK_KOPF + TK_RUMPF_FEST + TK_TAG) { return 0; }
    if (tktLen > TK_MAX) { return 0; }
    if ((peek8(tkt) & 0xFF) != TK_FASSUNG) { return 0; }
    var gen: int64 := peek8(tkt + 1) & 0xFF;
    var cfg: int64 := peek64(c + V_CFG);
    // BEIDE Generationen sind annehmbar, solange sie gesetzt sind — die
    // vorige deshalb, damit ein Schluesselwechsel nicht alle ausgegebenen
    // Tickets im selben Augenblick wertlos macht.
    var key: int64 := TlsCfgTicketKey(cfg, gen);
    if (key == 0) { return 0; }

    var ctLen: int64 := tktLen - TK_KOPF - TK_TAG;
    if (ctLen < TK_RUMPF_FEST) { return 0; }
    var scr: int64 := pScr(c);
    var pt: int64 := scr + S_TKPT;
    var ct: int64 := tkt + TK_KOPF;
    if (!AesGcmOpen(key, 32, tkt + 2, 12, tkt, 2, ct, ctLen,
                    ct + ctLen, TK_TAG, pt)) {
        // Tag falsch: verfaelscht, fremder Schluessel oder Muell. Kein
        // Klartext verlassen diese Funktion.
        SecureZero(pt, ctLen);
        return 0;
    }

    var hl: int64 := peek8(pt + 2) & 0xFF;
    if (hl != 32 && hl != 48) { SecureZero(pt, ctLen); return 0; }
    if (ctLen != TK_RUMPF_FEST + hl) { SecureZero(pt, ctLen); return 0; }
    if ((peek8(pt + 15) & 0xFF) != hl) { SecureZero(pt, ctLen); return 0; }

    var aus: int64 := 0;
    var i: int64 := 0;
    while (i < 8) { aus := (aus << 8) | (peek8(pt + 3 + i) & 0xFF); i := i + 1; }
    var leben: int64 := 0;
    i := 0;
    while (i < 4) { leben := (leben << 8) | (peek8(pt + 11 + i) & 0xFF); i := i + 1; }

    // Zu alt oder aus der Zukunft: beides ist unbrauchbar. Die Uhr des
    // SERVERS entscheidet, nicht die Altersangabe des Clients — die ist
    // dessen Behauptung.
    if (jetzt < aus) { SecureZero(pt, ctLen); return 0; }
    if (jetzt - aus > leben) { SecureZero(pt, ctLen); return 0; }

    poke64(suiteOut, ((peek8(pt) & 0xFF) << 8) | (peek8(pt + 1) & 0xFF));
    poke64(hlOut, hl);
    // #2578: Die Ausstellzeit wird aufbewahrt. Der Wiederholungsschutz
    // braucht sie, und zwar DIESE aus dem gesiegelten Ticket — das vom
    // Client gemeldete Alter ist seine Behauptung.
    poke64(c + V_TKTAUSZEIT, aus);
    i := 0;
    while (i < hl) { poke8(secOut + i, peek8(pt + 16 + i)); i := i + 1; }
    SecureZero(pt, ctLen);
    return hl;
}

// NewSessionTicket senden (§4.6.1). 0 = gesendet oder bewusst nicht
// gesendet, negativ = Fehler.
//
// Ohne Ticketschluessel in der Konfiguration wird NICHTS gesendet, und das
// ist kein Fehler: ein Server ohne Wiederaufnahme ist ein gueltiger Server.
// Sichtbar ist es am ausbleibenden NewSessionTicket, nicht an einer
// Fehlermeldung, die niemand lesen wuerde.
fn ticketSenden(c: int64): int64 {
    var cfg: int64 := peek64(c + V_CFG);
    if (TlsCfgTicketGen(cfg) == 0) { return 0; }
    if (peek64(c + V_RESDA) != 1) { return 0; }

    var jetzt: int64 := TlsCfgJetzt(cfg);
    var buf: int64 := pMsg(c) + 2048;
    var tkt: int64 := pScr(c) + S_TKT;
    // Die Nonce steht VOR dem Siegeln fest: der PSK im Ticket wird mit ihr
    // abgeleitet, und dieselbe Nonce geht in der Nachricht hinaus.
    var nonce: int64 := pScr(c) + S_TKNONCE;
    poke8(nonce, 0);
    var tl: int64 := ticketSiegeln(c, jetzt, nonce, 1, tkt);
    if (tl <= 0) { return 0; }

    // ticket_age_add: ZUFAELLIG je Ticket. Ohne ihn verraet das vom Client
    // gemeldete Alter den Ausstellzeitpunkt.
    var addBuf: int64 := pScr(c) + S_TKADD;
    if (RandBytesExact(addBuf, 4) != 4) { return E_KONFIG; }

    var p: int64 := 0;
    var leben: int64 := TlsCfgTicketLeben(cfg);
    p := wByte(buf, p, (leben >> 24) & 0xFF);
    p := wByte(buf, p, (leben >> 16) & 0xFF);
    p := wByte(buf, p, (leben >> 8) & 0xFF);
    p := wByte(buf, p, leben & 0xFF);
    var i: int64 := 0;
    while (i < 4) { p := wByte(buf, p, peek8(addBuf + i) & 0xFF); i := i + 1; }
    // ticket_nonce: ein Byte genuegt, solange je Verbindung EIN Ticket
    // ausgegeben wird. Es steht trotzdem da, weil der PSK ohne Nonce bei
    // zwei Tickets derselben Verbindung zweimal derselbe waere.
    p := wByte(buf, p, 1);
    p := wByte(buf, p, 0);
    p := w16(buf, p, tl);
    p := wBytes(buf, p, tkt, tl);
    // #2578: early_data mit max_early_data_size (§4.6.1). Ohne diese
    // Erweiterung darf der Client mit diesem Ticket kein 0-RTT versuchen —
    // sie ist die Erlaubnis, nicht bloss eine Zahl. Darum steht sie nur
    // drin, wenn 0-RTT wirklich eingeschaltet ist (Vorgabe UND
    // Wiederholungsschutz, siehe TlsCfgFruehAn).
    if (TlsCfgFruehAn(cfg)) {
        p := w16(buf, p, 8);                       // Laenge der Erweiterungen
        p := TkExtEarlyMax(buf, p, TlsCfgFruehMax(cfg));
    } else {
        p := w16(buf, p, 0);           // keine Erweiterungen
    }
    return hsSenden(c, HS_NEW_TICKET, buf, p);
}

// NewSessionTicket lesen (Client). Gemerkt wird EIN Ticket; ein weiteres
// ueberschreibt es. 0 = uebernommen oder bewusst verworfen.
fn ticketLesen(c: int64, pos: int64, len: int64): int64 {
    if (len < 13) { return E_FORMAT; }
    var leben: int64 := 0;
    var i: int64 := 0;
    while (i < 4) { leben := (leben << 8) | (peek8(pos + i) & 0xFF); i := i + 1; }
    var ageAdd: int64 := 0;
    i := 0;
    while (i < 4) { ageAdd := (ageAdd << 8) | (peek8(pos + 4 + i) & 0xFF); i := i + 1; }
    var nl: int64 := peek8(pos + 8) & 0xFF;
    if (9 + nl + 2 > len) { return E_FORMAT; }
    var noncePos: int64 := pos + 9;
    var tp: int64 := pos + 9 + nl;
    var tl: int64 := r16(tp, 0);
    if (9 + nl + 2 + tl + 2 > len) { return E_FORMAT; }

    // Ein Ticket ohne Lebensdauer ist keines (§4.6.1: 0 heisst "nicht
    // benutzen"); eines ueber sieben Tagen verletzt den RFC. Beides wird
    // verworfen, nicht gekuerzt.
    if (leben == 0 || leben > 604800) { return 0; }
    if (tl <= 0 || tl > TK_MAX) { return 0; }

    var hl: int64 := peek64(c + V_HASHLEN);
    if (peek64(c + V_RESDA) != 1) { return 0; }

    // PSK = HKDF-Expand-Label(res master, "resumption", ticket_nonce, hl)
    if (!HkdfExpandLabel(hl, c + V_SEC_RES, hl, "resumption"c as int64, 10,
                         noncePos, nl, c + V_TKTPSK, hl)) {
        return E_KONFIG;
    }
    i := 0;
    while (i < tl) { poke8(c + V_TKT + i, peek8(tp + 2 + i)); i := i + 1; }
    poke64(c + V_TKTLEN, tl);
    poke64(c + V_TKTHL, hl);
    poke64(c + V_TKTSUITE, peek64(c + V_SUITE));
    poke64(c + V_TKTAGEADD, ageAdd);
    poke64(c + V_TKTLEBEN, leben);
    poke64(c + V_TKTZEIT, TlsCfgJetzt(peek64(c + V_CFG)));

    // #2578: max_early_data_size. Fehlt die Erweiterung, bleibt die Zahl 0
    // und der Client bietet mit diesem Ticket kein 0-RTT an. Das ist kein
    // Mangel, sondern die Aussage des Servers.
    poke64(c + V_TKTEDMAX, 0);
    var extPos: int64 := 9 + nl + 2 + tl;
    if (extPos + 2 <= len) {
        var extLen: int64 := r16(pos, extPos);
        if (extPos + 2 + extLen <= len) {
            var elT: int64 := pScr(c) + S_EL;
            var edp: int64 := extSuchen(pos, extPos, 2 + extLen, EXT_EARLY, elT);
            if (edp >= 0 && peek64(elT) >= 4) {
                var m: int64 := 0;
                var q: int64 := 0;
                while (q < 4) { m := (m << 8) | (peek8(edp + q) & 0xFF); q := q + 1; }
                poke64(c + V_TKTEDMAX, m);
            }
        }
    }
    return 0;
}

// pre_shared_key des ClientHello auswerten (#2577, §4.2.11).
//
// `chAnf` zeigt auf den HANDSCHLAGKOPF der Nachricht (Typ + 3 Byte Laenge),
// `pskPos`/`pskLen` auf Inhalt und Laenge der Erweiterung.
//
// Rueckgabe:
//    1  angenommen, der PSK steht in V_TKTPSK und die Suite in V_SUITE
//    0  nicht brauchbar — voller Handschlag, KEIN Fehler
//   <0  Abbruch (falscher Binder)
fn pskAnnehmen(c: int64, chAnf: int64, chLen: int64,
               pskPos: int64, pskLen: int64): int64 {
    if (pskLen < 2) { return 0; }
    var identGesamt: int64 := r16(pskPos, 0);
    if (identGesamt + 2 > pskLen) { return 0; }
    // Nur die ERSTE Identitaet wird betrachtet. Mehrere anzunehmen hiesse,
    // eine Auswahlregel zu erfinden; eine, die immer die erste nimmt, ist
    // vorhersagbar und genuegt.
    if (identGesamt < 6) { return 0; }
    var tLen: int64 := r16(pskPos, 2);
    if (tLen <= 0 || tLen > TK_MAX) { return 0; }
    if (2 + 2 + tLen + 4 > 2 + identGesamt) { return 0; }
    var tPos: int64 := pskPos + 4;

    // Hinter den Identitaeten die Binderliste.
    var bListPos: int64 := pskPos + 2 + identGesamt;
    if (bListPos + 2 > pskPos + pskLen) { return 0; }
    var bGesamt: int64 := r16(bListPos, 0);
    if (bListPos + 2 + bGesamt > pskPos + pskLen) { return 0; }
    if (bGesamt < 2) { return 0; }
    var bLen: int64 := peek8(bListPos + 2) & 0xFF;
    if (bLen < 32 || bLen > 64) { return 0; }
    if (1 + bLen > bGesamt) { return 0; }
    var bPos: int64 := bListPos + 3;

    // Ticket oeffnen. Scheitert das, wird voll verhandelt — ein abgelaufenes
    // oder fremdes Ticket ist Alltag.
    var cfg: int64 := peek64(c + V_CFG);
    var jetzt: int64 := TlsCfgJetzt(cfg);
    // Eigene Plaetze: S_TKADD gehoert dem ticket_age_add. Ein Bereich, eine
    // Rolle — zwei Rollen auf demselben Speicher sind in diesem Repo
    // mehrfach als "jeder zweite Aufruf falsch" aufgefallen.
    var suiteBuf: int64 := pScr(c) + S_TKSUITE;
    var hlBuf: int64 := pScr(c) + S_TKHL;
    var sec: int64 := pScr(c) + S_TKPSK;
    var sl: int64 := ticketOeffnen(c, tPos, tLen, jetzt, suiteBuf, hlBuf, sec);
    if (sl <= 0) { return 0; }
    var hlT: int64 := peek64(hlBuf);
    if (hlT != bLen) { SecureZero(sec, 64); return 0; }

    // Die Suite des Tickets MUSS zur gewaehlten passen: der Hash des
    // Schluesselplans haengt daran, und ein PSK aus einer SHA-384-Sitzung in
    // einer SHA-256-Verbindung waere eine andere Rechnung.
    if (peek64(suiteBuf) != peek64(c + V_SUITE)) { SecureZero(sec, 64); return 0; }

    // Binder nachrechnen: HMAC(finished_key(binder_key(PSK)), Hash(CH bis
    // zum Laengenfeld der Binderliste)).
    var fk: int64 := pScr(c) + S_FINKEY;
    if (!binderKey(c, hlT, sec, hlT, fk)) { SecureZero(sec, 64); return E_KONFIG; }
    var vorLen: int64 := bListPos - chAnf;
    var th: int64 := pScr(c) + S_TH;
    if (hlT == 48) { Sha384(chAnf, vorLen, th); } else { SHA256(chAnf, vorLen, th); }
    var soll: int64 := pScr(c) + S_BINDER;
    HmacHash(hlT, fk, hlT, th, hlT, soll);
    SecureZero(fk, 64);

    // KONSTANTZEITIG vergleichen: der Binder ist ein Authentifizierungswert.
    //
    // CTMemEqual liefert eine MASKE: -1 bei Gleichheit, 0 sonst — keinen
    // Wahrheitswert. `!x` waere hier zufaellig richtig (weil !(-1) == 0),
    // aber auf diesen Zufall darf sich niemand verlassen; im Repo ist
    // genau diese Verwechslung schon vermerkt (CTIsZero gibt eine Maske).
    // Darum der ausdrueckliche Vergleich mit 0.
    if (CTMemEqual(soll, bPos, hlT) == 0) {
        SecureZero(sec, 64);
        SecureZero(soll, 64);
        // §4.2.11.2: "the server MUST abort". Ein gueltiges Ticket mit
        // falschem Binder heisst, dass jemand das Ticket hat und den PSK
        // nicht kennt — das ist kein Alltag, das ist ein Angriff.
        return E_SIGNATUR;
    }
    SecureZero(soll, 64);

    var i: int64 := 0;
    while (i < hlT) { poke8(c + V_TKTPSK + i, peek8(sec + i)); i := i + 1; }
    poke64(c + V_TKTHL, hlT);
    SecureZero(sec, 64);

    // #2578: Kennung dieses Tickets fuer den Wiederholungsschutz. Die
    // GCM-Nonce des Tickets (tPos+2, 12 Byte) ist zufaellig und je Ticket
    // einmalig; das erste Byte markiert die ART der Kennung, damit eine
    // Ticketkennung nie mit einer ClientHello-Kennung zusammenfaellt.
    poke8(c + V_TKTID, 1);
    var n: int64 := 0;
    while (n < 12) { poke8(c + V_TKTID + 1 + n, peek8(tPos + 2 + n)); n := n + 1; }
    poke8(c + V_TKTID + 13, 0);
    poke8(c + V_TKTID + 14, 0);
    poke8(c + V_TKTID + 15, 0);
    return 1;
}

// resumption_master_secret (RFC 8446 §7.1), die Wurzel der Wiederaufnahme.
//
// Der Transkriptstand MUSS das Finished des Clients einschliessen. Mit einem
// frueheren Stand rechnen beide Seiten verschiedene Geheimnisse, und das
// faellt erst viel spaeter auf — beim Binder einer Wiederaufnahme, also in
// einer anderen Verbindung. Darum wird diese Funktion genau einmal
// aufgerufen, unmittelbar nachdem das Client-Finished im Transkript steht.
fn planWiederaufnahme(c: int64): bool {
    var hl: int64 := peek64(c + V_HASHLEN);
    var th: int64 := pScr(c) + S_TH;
    hashJetzt(c, th);
    if (!HkdfExpandLabel(hl, c + V_SEC_MAST, hl, "res master"c as int64, 10,
                         th, hl, c + V_SEC_RES, hl)) {
        return false;
    }
    poke64(c + V_RESDA, 1);
    return true;
}

// Anwendungsschluessel nach dem Server-Finished.
fn planAnwendung(c: int64): bool {
    var hl: int64 := peek64(c + V_HASHLEN);
    var th: int64 := pScr(c) + S_TH;
    hashJetzt(c, th);
    if (!HkdfExpandLabel(hl, c + V_SEC_MAST, hl, "c ap traffic"c as int64, 12,
                         th, hl, c + V_SEC_CAP, hl)) { return false; }
    if (!HkdfExpandLabel(hl, c + V_SEC_MAST, hl, "s ap traffic"c as int64, 12,
                         th, hl, c + V_SEC_SAP, hl)) { return false; }
    if (!HkdfExpandLabel(hl, c + V_SEC_MAST, hl, "exp master"c as int64, 10,
                         th, hl, c + V_SEC_EXP, hl)) { return false; }
    return true;
}

// RFC 8446 §7.5 / RFC 9266: Schluesselmaterial fuer die Anwendung.
pub fn TlsExportKeyingMaterial(c: int64, label: int64, labelLen: int64,
                               kontext: int64, kontextLen: int64,
                               out: int64, outLen: int64): bool {
    // Der Exporter von RFC 5705 (TLS 1.2) ist nicht umgesetzt; wer ihn
    // braucht, bekommt hier FALSE und nicht etwas Plausibles.
    if (peek64(c + V_12) != 0) { return false; }
    if (peek64(c + V_ZUSTAND) != Z_FERTIG) { return false; }
    var hl: int64 := peek64(c + V_HASHLEN);
    var s: int64 := pScr(c) + S_EXP1;
    var kh: int64 := pScr(c) + S_EXP2;
    if (!HkdfExpandLabel(hl, c + V_SEC_EXP, hl, label, labelLen, 0, 0, s, hl)) {
        return false;
    }
    if (hl == 48) { Sha384(kontext, kontextLen, kh); } else { SHA256(kontext, kontextLen, kh); }
    var ok: bool := HkdfExpandLabel(hl, s, hl, "exporter"c as int64, 8, kh, hl, out, outLen);
    SecureZero(s, 64);
    return ok;
}

// Schluessel je Richtung — getrennt, weil der Server beim Senden schon auf
// die Anwendungsschluessel umschaltet, waehrend er das Client-Finished noch
// mit den Handschlagschluesseln liest (RFC 8446 §4.4.4).
fn leseSchluessel(c: int64, secret: int64, stufe: int64): bool {
    if (!verkehrsSchluessel(c, secret, c + V_KEY_LESE, c + V_IV_LESE)) { return false; }
    poke64(c + V_SEQ_LESE, 0);
    poke64(c + V_KRYPT_LESE, stufe);
    return true;
}

fn schreibSchluessel(c: int64, secret: int64, stufe: int64): bool {
    if (!verkehrsSchluessel(c, secret, c + V_KEY_SCHR, c + V_IV_SCHR)) { return false; }
    poke64(c + V_SEQ_SCHR, 0);
    poke64(c + V_KRYPT_SCHR, stufe);
    return true;
}

// ---------------------------------------------------------------------------
// Record-Schicht (RFC 8446 §5)
//
// Nonce = IV xor Sequenznummer (big-endian in den letzten acht Byte),
// AAD = der Recordkopf. Der innere Klartext traegt den echten Typ als
// letztes Byte, danach darf Nullpolsterung folgen.
// ---------------------------------------------------------------------------

fn nonceBauen(iv: int64, seq: int64, out: int64): void {
    TkNonce(iv, seq, out);
}

fn aeadSiegeln(c: int64, nonce: int64, aad: int64, aadLen: int64,
               daten: int64, len: int64, ct: int64, tag: int64): bool {
    if (peek64(c + V_AEAD) == 2) {
        return ChaChaPolySeal(c + V_KEY_SCHR, nonce, aad, aadLen, daten, len, ct, tag);
    }
    return AesGcmSeal(c + V_KEY_SCHR, peek64(c + V_KEYLEN), nonce, 12,
                      aad, aadLen, daten, len, ct, tag, 16);
}

fn aeadOeffnen(c: int64, nonce: int64, aad: int64, aadLen: int64,
               ct: int64, len: int64, tag: int64, pt: int64): bool {
    if (peek64(c + V_AEAD) == 2) {
        return ChaChaPolyOpen(c + V_KEY_LESE, nonce, aad, aadLen, ct, len, tag, pt);
    }
    return AesGcmOpen(c + V_KEY_LESE, peek64(c + V_KEYLEN), nonce, 12,
                      aad, aadLen, ct, len, tag, 16, pt);
}

// Einen Record schreiben. Bei gesetzter Schreibstufe wird verschluesselt und
// der aeussere Typ ist application_data (§5.2).
fn recordSenden(c: int64, typ: int64, daten: int64, len: int64): int64 {
    if (peek64(c + V_KRYPT_SCHR) == 0) {
        if (peek64(c + V_OUTPOS) + 5 + len > B_OUT) { return E_PUFFER; }
        var rc: int64 := outByte(c, typ);
        if (rc != 0) { return rc; }
        outByte(c, 3); outByte(c, 1);              // legacy_record_version 0x0301
        outByte(c, (len >> 8) & 0xFF); outByte(c, len & 0xFF);
        return outAnhaengen(c, daten, len);
    }

    var gesamt: int64 := len + 1 + 16;             // + Typbyte + Tag
    if (peek64(c + V_OUTPOS) + 5 + gesamt > B_OUT) { return E_PUFFER; }

    if (len + 1 > 17408) { return E_PUFFER; }
    var kopf: int64 := pScr(c) + S_KOPF;
    var nonce: int64 := pScr(c) + S_NONCE;
    var tag: int64 := pScr(c) + S_TAG;
    var innen: int64 := pRec(c);

    poke8(kopf, RT_APPDATA); poke8(kopf + 1, 3); poke8(kopf + 2, 3);
    poke8(kopf + 3, (gesamt >> 8) & 0xFF); poke8(kopf + 4, gesamt & 0xFF);

    var i: int64 := 0;
    while (i < len) { poke8(innen + i, peek8(daten + i)); i := i + 1; }
    poke8(innen + len, typ);

    nonceBauen(c + V_IV_SCHR, peek64(c + V_SEQ_SCHR), nonce);
    if (!aeadSiegeln(c, nonce, kopf, 5, innen, len + 1, innen, tag)) {
        return E_FORMAT;
    }
    poke64(c + V_SEQ_SCHR, peek64(c + V_SEQ_SCHR) + 1);

    outAnhaengen(c, kopf, 5);
    outAnhaengen(c, innen, len + 1);
    outAnhaengen(c, tag, 16);

    SecureZero(innen, len + 1);
    return 0;
}

// Den naechsten vollstaendigen Record aus dem Eingangspuffer verarbeiten:
// Handschlagbyte in den HS-Puffer, Anwendungsdaten in den App-Puffer,
// change_cipher_spec verwerfen, Alert melden.
// Liefert 0 (ein Record verarbeitet), 1 (noch nichts vollstaendig) oder
// einen Fehler.
fn recordVerarbeiten(c: int64): int64 {
    var vorhanden: int64 := peek64(c + V_INPOS);
    if (vorhanden < 5) { return 1; }
    var b: int64 := pIn(c);
    var typ: int64 := peek8(b) & 0xFF;
    var ver1: int64 := peek8(b + 1) & 0xFF;
    var len: int64 := ((peek8(b + 3) & 0xFF) << 8) | (peek8(b + 4) & 0xFF);
    if (ver1 != 3) { return E_VERSION; }
    // §5.2: ein verschluesselter Record traegt hoechstens 2^14 + 256 Byte,
    // ein unverschluesselter 2^14. Zu gross ist KEIN Formatfehler, sondern
    // record_overflow — tlsfuzzer prueft die Alertnummer, und mit
    // decode_error fielen 52 Faelle (#2096).
    if (peek64(c + V_KRYPT_LESE) != 0) {
        if (len > 16640) { return E_PUFFER; }
    } else {
        if (len > 16384) { return E_PUFFER; }
    }
    if (vorhanden < 5 + len) { return 1; }

    var inhalt: int64 := b + 5;
    var echterTyp: int64 := typ;
    var nutzLen: int64 := len;

    if (typ == RT_APPDATA && peek64(c + V_KRYPT_LESE) != 0) {
        if (len < 17) { return E_FORMAT; }
        var nonce: int64 := pScr(c) + S_NONCE;
        nonceBauen(c + V_IV_LESE, peek64(c + V_SEQ_LESE), nonce);
        var ctLen: int64 := len - 16;
        if (!aeadOeffnen(c, nonce, b, 5, inhalt, ctLen, inhalt + ctLen, inhalt)) {
            // #2578: Abgelehntes 0-RTT. Der Server kennt den fruehen
            // Schluessel nicht und MUSS die Records verwerfen koennen, ohne
            // sie zu entschluesseln (§4.2.10). Wie viele es sind, steht
            // nirgends — verworfen wird, bis einer sich mit dem
            // Handschlagschluessel oeffnen laesst.
            //
            // Die Sequenznummer wird dabei NICHT erhoeht: sie zaehlt die
            // Records UNTER DIESEM Schluessel, und der verworfene gehoerte
            // zu einem anderen. Wer sie mitzaehlt, kann den ersten echten
            // Record nicht mehr oeffnen.
            //
            // Der Deckel ist kein Schoenheitswert: ohne ihn koennte eine
            // Gegenseite beliebig viele unlesbare Records schicken, und
            // diese Schleife verwirft sie geduldig weiter.
            if (peek64(c + V_SKIPUNDEC) == 1 && peek64(c + V_SKIPZAHL) < 64) {
                poke64(c + V_SKIPZAHL, peek64(c + V_SKIPZAHL) + 1);
                var restS: int64 := vorhanden - (5 + len);
                var kS: int64 := 0;
                while (kS < restS) { poke8(b + kS, peek8(b + 5 + len + kS)); kS := kS + 1; }
                poke64(c + V_INPOS, restS);
                return 0;
            }
            return E_ENTSCHLUESS;
        }
        // Ein Record, der sich oeffnen liess, beendet das Verwerfen: ab hier
        // spricht die Gegenseite wieder unter einem Schluessel, den wir
        // haben. Bliebe das Verwerfen an, wuerde ein spaeterer echter
        // Entschluesselungsfehler still uebergangen.
        poke64(c + V_SKIPUNDEC, 0);
        poke64(c + V_SEQ_LESE, peek64(c + V_SEQ_LESE) + 1);
        // Der INNERE Klartext darf 2^14 + 1 Byte nicht ueberschreiten
        // (§5.2: Inhalt plus Polsterung plus das Typbyte). Der Deckel auf
        // dem Chiffrat (2^14 + 256) laesst mehr durch, als innen erlaubt
        // ist; ohne diese Pruefung meldete die Unit decrypt_error, wo
        // record_overflow hingehoert (tlsfuzzer, #2096).
        if (ctLen > 16385) { return E_PUFFER; }
        // Polsterung abschneiden und den echten Typ lesen (§5.4).
        var p: int64 := ctLen - 1;
        while (p >= 0 && (peek8(inhalt + p) & 0xFF) == 0) { p -= 1; }
        if (p < 0) { return E_FORMAT; }
        echterTyp := peek8(inhalt + p) & 0xFF;
        nutzLen := p;
    } else {
        if (typ == RT_APPDATA) {
            // #2578: Im Ablehnungsweg kommen die fruehen Records des Clients
            // an, BEVOR ueberhaupt ein Leseschluessel steht — dann ist die
            // Lesestufe noch 0 und der Record waere "unverschluesselte
            // Anwendungsdaten", also verboten. Verworfen wird er trotzdem,
            // denn genau das verlangt §4.2.10: die fruehen Records sind
            // unlesbar, und der Handschlag darf daran nicht scheitern.
            // Gemessen an tlsfuzzer test-tls13-0rtt-garbage ("fake 0-RTT
            // resumption with HRR"): der Client schickt sein
            // application_data unmittelbar hinter dem ClientHello, noch vor
            // dem HelloRetryRequest.
            if (peek64(c + V_SKIPUNDEC) == 1 && peek64(c + V_SKIPZAHL) < 64) {
                poke64(c + V_SKIPZAHL, peek64(c + V_SKIPZAHL) + 1);
                var restK: int64 := vorhanden - (5 + len);
                var kK: int64 := 0;
                while (kK < restK) { poke8(b + kK, peek8(b + 5 + len + kK)); kK := kK + 1; }
                poke64(c + V_INPOS, restK);
                return 0;
            }
            return E_ABLAUF;                        // unverschluesselt verboten
        }
    }

    var rc: int64 := 0;
    // RFC 8446 §5.1: nulllange Fragmente von Handschlag und Alert sind
    // verboten, und wer eines empfaengt, MUSS mit unexpected_message
    // abbrechen. Vorher gab es dafuer decode_error (tlsfuzzer
    // test-tls13-empty-alert, #2096).
    if (nutzLen == 0 && (echterTyp == RT_HANDSHAKE || echterTyp == RT_ALERT)) {
        return E_ABLAUF;
    }
    if (echterTyp == RT_HANDSHAKE) {
        var hp: int64 := peek64(c + V_HSPOS);
        if (hp + nutzLen > B_HS) { rc := E_PUFFER; }
        else {
            var i: int64 := 0;
            while (i < nutzLen) { poke8(pHs(c) + hp + i, peek8(inhalt + i)); i := i + 1; }
            poke64(c + V_HSPOS, hp + nutzLen);
        }
    } else {
        if (echterTyp == RT_APPDATA) {
            // Anwendungsdaten gibt es erst nach dem Handschlag. Vorher sind
            // sie ein Ablauffehler (RFC 8446 §5.1) — tls12 hat diese
            // Pruefung von Anfang an, hier fehlte sie.
            // #2578: FRUEHE Daten kommen vor dem Handschlagende an — sie
            // sind die eine Ausnahme von "Anwendungsdaten erst nach dem
            // Handschlag". Erkannt werden sie an der Lesestufe 3 und nicht
            // am Zustand: die Stufe sagt, unter WELCHEM Schluessel der
            // Record ankam, und genau das ist die Aussage.
            var frueh: bool := peek64(c + V_KRYPT_LESE) == 3;
            if (!frueh && peek64(c + V_ZUSTAND) != Z_FERTIG) { return E_ABLAUF; }
            if (frueh) {
                // §4.2.10: mehr als max_early_data_size beendet die
                // Verbindung. Gezaehlt wird, was ANKOMMT, nicht was der
                // Client behauptet.
                if (peek64(c + V_EDGELESEN) + nutzLen > peek64(c + V_EDMAX)) {
                    return E_ABLAUF;
                }
                poke64(c + V_EDGELESEN, peek64(c + V_EDGELESEN) + nutzLen);
            }
            var ap: int64 := peek64(c + V_APPPOS);
            if (ap + nutzLen > B_APP) { rc := E_PUFFER; }
            else {
                var i2: int64 := 0;
                while (i2 < nutzLen) { poke8(pApp(c) + ap + i2, peek8(inhalt + i2)); i2 += 1; }
                poke64(c + V_APPPOS, ap + nutzLen);
                // Die Grenze wandert nur bei FRUEHEN Daten mit. Alles
                // dahinter kam unter den Anwendungsschluesseln, und die
                // Anwendung muss die beiden unterscheiden koennen.
                if (frueh) { poke64(c + V_EDGRENZE, ap + nutzLen); }
            }
        } else {
            if (echterTyp == RT_ALERT) {
                if (nutzLen >= 2) {
                    var stufe: int64 := peek8(inhalt) & 0xFF;
                    var grund: int64 := peek8(inhalt + 1) & 0xFF;
                    // Die Nummer AUFBEWAHREN. Vorher wurde sie gelesen und
                    // weggeworfen; die Unit meldete "Alert der Gegenseite"
                    // und verschwieg, welcher. Gegen eine
                    // Fremdimplementierung ist das die einzige Angabe, die
                    // weiterhilft (TlsPeerAlert).
                    poke64(c + V_PEERALERT, grund);
                    poke64(c + V_PEERALERTST, stufe);
                    if (grund == 0) { rc := E_GESCHLOSSEN; }
                    else {
                        // Die STUFE wird bewusst nicht ausgewertet: RFC 8446
                        // §6.1 — ausser close_notify und user_canceled sind
                        // in TLS 1.3 alle Alerts fatal, gleich welche Stufe
                        // davorsteht. Hier stand eine Verzweigung, die in
                        // beiden Armen dasselbe tat.
                        rc := E_WARNUNG;
                    }
                } else { rc := E_FORMAT; }
            } else {
                if (echterTyp == RT_CCS) {
                    // change_cipher_spec wird verworfen (Anhang D.4,
                    // Middlebox-Kompatibilitaet) — aber nur, wenn es
                    // RICHTIG aussieht. RFC 8446 §5: ein anderer Wert als
                    // 0x01 oder ein CCS mit anderer Laenge MUSS mit
                    // unexpected_message abgewiesen werden. Vorher wurde
                    // alles verworfen, was als CCS kam; tlsfuzzer
                    // (test-tls13-ccs, #2096) prueft genau das.
                    if (nutzLen != 1 || (peek8(inhalt) & 0xFF) != 1) {
                        rc := E_ABLAUF;
                    }
                } else {
                    // Ein unbekannter Recordtyp ist kein Grund
                    // weiterzumachen.
                    rc := E_FORMAT;
                }
            }
        }
    }

    // Verbrauchte Byte vorn abschneiden.
    var rest: int64 := vorhanden - (5 + len);
    var k: int64 := 0;
    while (k < rest) { poke8(b + k, peek8(b + 5 + len + k)); k := k + 1; }
    poke64(c + V_INPOS, rest);
    if (rc != 0) { return rc; }
    return 0;
}

// Alle vollstaendigen Records verarbeiten.
fn pumpe(c: int64): int64 {
    var rc: int64 := 0;
    while (rc == 0) { rc := recordVerarbeiten(c); }
    if (rc == 1) { return 0; }
    return rc;
}

// ---------------------------------------------------------------------------
// Handschlagnachrichten schreiben
// ---------------------------------------------------------------------------

// Schreibhilfe auf einem Puffer mit laufender Position.
//
// #2619: Die Rechnungen liegen in std.net.tls_kern, weil DTLS 1.3 dieselben
// braucht. Was hier bleibt, ist die WEITERLEITUNG -- so blieben die
// Aufrufstellen unveraendert und der Nachweis liefert dieselben Zahlen.
// Zwei Fassungen von w24 koennten auseinanderlaufen, ohne dass es auffaellt;
// 24-Bit-Laengen stehen in jeder Handschlagnachricht.
fn wByte(buf: int64, pos: int64, v: int64): int64 { return TkByte(buf, pos, v); }
fn w16(buf: int64, pos: int64, v: int64): int64 { return TkW16(buf, pos, v); }
fn w24(buf: int64, pos: int64, v: int64): int64 { return TkW24(buf, pos, v); }
fn wBytes(buf: int64, pos: int64, src: int64, len: int64): int64 {
    return TkBytes(buf, pos, src, len);
}
fn r16(buf: int64, pos: int64): int64 { return TkR16(buf, pos); }
fn r24(buf: int64, pos: int64): int64 { return TkR24(buf, pos); }

// Eine Handschlagnachricht: Kopf anlegen, in den Transkript-Hash geben und
// als Record hinausschreiben.
fn hsSendenRoh(c: int64, typ: int64, rumpf: int64, len: int64, hashen: bool,
               kopieren: bool): int64 {
    if (len + 4 > B_MSG) { return E_PUFFER; }
    // Mitzaehlen, was hinausgeht — die Zaehler sind der Nachweis, dass eine
    // Wiederaufnahme ohne Zertifikat auskommt (TlsGesendet).
    if (typ == HS_CERT) { poke64(c + V_ZCERT, peek64(c + V_ZCERT) + 1); }
    if (typ == HS_CERT_VERIFY) { poke64(c + V_ZCV, peek64(c + V_ZCV) + 1); }
    if (typ == HS_NEW_TICKET) { poke64(c + V_ZNST, peek64(c + V_ZNST) + 1); }
    var n: int64 := pMsg(c);
    var p: int64 := wByte(n, 0, typ);
    p := w24(n, p, len);
    p := wBytes(n, p, rumpf, len);
    if (hashen) { hashUpdate(c, n, p); }
    if (kopieren) {
        if (p > B_CH) { return E_PUFFER; }
        var i: int64 := 0;
        while (i < p) { poke8(pCh(c) + i, peek8(n + i)); i := i + 1; }
        poke64(c + V_CHLEN, p);
    }
    return recordSenden(c, RT_HANDSHAKE, n, p);
}

// Ein ClientHello mit PSK-Binder senden (#2577, RFC 8446 §4.2.11.2).
//
// `binderOff` ist der Abstand vom Rumpfanfang bis zum LAENGENFELD der
// Binderliste. Gehasht wird der Kopf plus alles davor; der Binder selbst
// gehoert nicht in seinen eigenen Hash.
//
// Reihenfolge siehe Kopf dieser Aenderung: Rumpf fertig (mit Nullen an der
// Binderstelle), Kopf davor, hashen, Binder eintragen, dann senden.
fn hsSendenMitBinder(c: int64, hl: int64, rumpf: int64, len: int64,
                     binderOff: int64, finKey: int64): int64 {
    if (len + 4 > B_MSG) { return E_PUFFER; }
    var n: int64 := pMsg(c);
    var p: int64 := wByte(n, 0, HS_CLIENT_HELLO);
    p := w24(n, p, len);
    p := wBytes(n, p, rumpf, len);

    // Hash ueber Kopf + Rumpf bis zum Laengenfeld der Binderliste.
    var vorLen: int64 := 4 + binderOff;
    var th: int64 := pScr(c) + S_TH;
    if (hl == 48) { Sha384(n, vorLen, th); } else { SHA256(n, vorLen, th); }

    // binder = HMAC(finished_key, Transcript-Hash(abgeschnittenes CH))
    var bind: int64 := pScr(c) + S_BINDER;
    HmacHash(hl, finKey, hl, th, hl, bind);

    // An die Stelle schreiben: Laengenfeld der Liste (2) und des Eintrags (1)
    // stehen schon, der Wert kommt dahinter.
    var ziel: int64 := n + 4 + binderOff + 3;
    var i: int64 := 0;
    while (i < hl) { poke8(ziel + i, peek8(bind + i)); i := i + 1; }

    hashUpdate(c, n, p);
    if (p > B_CH) { return E_PUFFER; }
    i := 0;
    while (i < p) { poke8(pCh(c) + i, peek8(n + i)); i := i + 1; }
    poke64(c + V_CHLEN, p);
    return recordSenden(c, RT_HANDSHAKE, n, p);
}

fn hsSenden(c: int64, typ: int64, rumpf: int64, len: int64): int64 {
    return hsSendenRoh(c, typ, rumpf, len, true, false);
}

// Suite waehlen und die davon abhaengenden Groessen setzen.
fn suiteSetzen(c: int64, suite: int64): bool {
    if (suite == CS_AES128_GCM_SHA256) {
        poke64(c + V_SUITE, suite); poke64(c + V_HASHLEN, 32);
        poke64(c + V_KEYLEN, 16); poke64(c + V_AEAD, 1);
        return true;
    }
    if (suite == CS_AES256_GCM_SHA384) {
        poke64(c + V_SUITE, suite); poke64(c + V_HASHLEN, 48);
        poke64(c + V_KEYLEN, 32); poke64(c + V_AEAD, 1);
        return true;
    }
    if (suite == CS_CHACHA20_SHA256) {
        poke64(c + V_SUITE, suite); poke64(c + V_HASHLEN, 32);
        poke64(c + V_KEYLEN, 32); poke64(c + V_AEAD, 2);
        return true;
    }
    return false;
}

// Erlaubte Gruppen der Konfiguration; 0 heisst alle drei.
// Bit 0 = x25519, Bit 1 = secp256r1, Bit 2 = secp384r1.
fn gruppenMaske(c: int64): int64 {
    var m: int64 := TlsCfgGruppen(peek64(c + V_CFG));
    if (m == 0) { return 7; }
    return m;
}

// Laenge des key_share-Anteils einer Gruppe im Protokoll.
fn gruppenRohLen(grp: int64): int64 { return TkGruppenRohLen(grp); }

// Die Kurvenkennung von std.crypto.ec zur Gruppenkennung des Protokolls.
// -1 heisst "keine Weierstrass-Kurve" (also x25519).
fn gruppenKurve(grp: int64): int64 { return TkGruppenKurve(grp); }

// Laenge des gemeinsamen Geheimnisses der Gruppe in Byte.
fn gruppenGeheimLen(grp: int64): int64 { return TkGruppenGeheimLen(grp); }

// Ein key_share-Eintrag fuer eine Gruppe, die wir koennen, MUSS die Laenge
// dieser Gruppe haben und bei P-256 ein gueltiger Punkt in unkomprimierter
// Form sein; sonst verlangt RFC 8446 §4.2.8.2 illegal_parameter. Vorher wurde
// ein solcher Eintrag still uebersprungen — der Handschlag endete dann mit
// einem HelloRetryRequest oder handshake_failure, und die Gegenseite erfuhr
// nicht, dass ihr Anteil kaputt war (16 Faelle in tlsfuzzers
// test-tls13-ecdhe-curves, #2096).
fn ksEintragPruefen(grp: int64, roh: int64, rohLen: int64): int64 {
    if (rohLen != gruppenRohLen(grp)) { return E_PARAM; }
    var kurve: int64 := gruppenKurve(grp);
    if (kurve >= 0) {
        // Unkomprimiert, also 0x04 || X || Y. Komprimierte Punkte sind in
        // TLS 1.3 nicht zugelassen (§4.2.8.2).
        if ((peek8(roh) & 0xFF) != 4) { return E_PARAM; }
        var fb: int64 := EcFieldBytes(kurve);
        if (!EcValidatePublicKey(kurve, roh + 1, roh + 1 + fb)) {
            // Faengt Punkt im Unendlichen (0,0), Punkt ausserhalb der Kurve
            // und Koordinaten >= p.
            return E_PARAM;
        }
    }
    return 0;
}

fn gruppeErlaubt(c: int64, grp: int64): bool {
    var m: int64 := gruppenMaske(c);
    if (grp == GRP_X25519) { return (m & 1) != 0; }
    if (grp == GRP_SECP256R1) { return (m & 2) != 0; }
    if (grp == GRP_SECP384R1) { return (m & 4) != 0; }
    return false;
}

// Reihenfolge der eigenen Vorliebe. EINE Aufzaehlung fuer alle Stellen, die
// Gruppen durchprobieren — vorher stand die Reihenfolge an drei Stellen als
// `while (wg < 2)` mit einer if-Kette, und eine neue Gruppe haette in alle
// drei muessen.
con GRP_ANZAHL: int64 := 3;

fn gruppeNachRang(i: int64): int64 { return TkGruppeNachRang(i); }

// Eigenes Paar fuer die gewaehlte Gruppe erzeugen. Wird bei HRR ein zweites
// Mal mit einer anderen Gruppe aufgerufen.
fn gruppenPaar(c: int64): bool {
    var grp: int64 := peek64(c + V_GRUPPE);
    var kurve: int64 := gruppenKurve(grp);
    if (kurve >= 0) {
        var fb: int64 := EcFieldBytes(kurve);
        var x: int64 := pScr(c) + S_ECX;
        var y: int64 := pScr(c) + S_ECY;
        if (!EcGenerateKey(kurve, c + V_EC_SK, x, y)) { return false; }
        poke8(c + V_EC_PK, 4);
        var i: int64 := 0;
        while (i < fb) {
            poke8(c + V_EC_PK + 1 + i, peek8(x + i));
            poke8(c + V_EC_PK + 1 + fb + i, peek8(y + i));
            i += 1;
        }
        return true;
    }
    if (grp != GRP_X25519) { return false; }
    var seed: int64 := pScr(c) + S_K1;
    if (RandBytesExact(seed, 32) != 32) { return false; }
    X25519KeyGen(seed, c + V_EPH_PK, c + V_EPH_SK);
    SecureZero(seed, 32);
    return true;
}

// Laenge des eigenen oeffentlichen Anteils in der gewaehlten Gruppe.
fn gruppenPkLen(c: int64): int64 {
    return gruppenRohLen(peek64(c + V_GRUPPE));
}

fn gruppenPk(c: int64): int64 {
    if (gruppenKurve(peek64(c + V_GRUPPE)) >= 0) { return c + V_EC_PK; }
    return c + V_EPH_PK;
}

// Gemeinsames Geheimnis nach V_SHARED. Der Punkt der Gegenseite wird
// geprueft, nicht geglaubt: ein Punkt ausserhalb der Kurve ist ein
// Angriffsversuch, kein Formatfehler.
fn gruppenGeheimnis(c: int64): bool {
    var grp0: int64 := peek64(c + V_GRUPPE);
    poke64(c + V_SHAREDLEN, gruppenGeheimLen(grp0));
    var kurve: int64 := gruppenKurve(grp0);
    if (kurve >= 0) {
        if ((peek8(c + V_EC_PEER) & 0xFF) != 4) { return false; }
        var fb: int64 := EcFieldBytes(kurve);
        var px: int64 := c + V_EC_PEER + 1;
        var py: int64 := c + V_EC_PEER + 1 + fb;
        if (!EcValidatePublicKey(kurve, px, py)) { return false; }
        if (!EcdhSharedSecret(kurve, c + V_EC_SK, px, py, c + V_SHARED)) {
            return false;
        }
        return !nullGeheimnis(c + V_SHARED, fb);
    }
    X25519SharedSecret(c + V_EPH_SK, c + V_PEER_PK, c + V_SHARED);
    // RFC 8446 §7.4.2: ergibt der Austausch das NULL-Geheimnis, MUSS
    // abgebrochen werden. Das passiert bei Punkten kleiner Ordnung — die
    // Wycheproof-Vektoren (x25519_test, #2096) enthalten 31 solche Faelle,
    // und ohne diese Pruefung lief der Handschlag damit durch: beide Seiten
    // haetten ihre Schluessel aus einem Geheimnis abgeleitet, das der
    // Angreifer kennt, weil es fest ist.
    return !nullGeheimnis(c + V_SHARED, 32);
}

// Alle Byte null? Ueber ALLE Byte, ohne fruehen Ausstieg: das Ergebnis ist
// oeffentlich (es beendet die Verbindung), die Eingabe ist ein Geheimnis.
fn nullGeheimnis(p: int64, n: int64): bool {
    var acc: int64 := 0;
    var i: int64 := 0;
    while (i < n) { acc := acc | (peek8(p + i) & 0xFF); i := i + 1; }
    return acc == 0;
}

// Eigenes Schluesselpaar und Zufall erzeugen.
fn eigeneWerte(c: int64, mitSessionId: bool): bool {
    if (peek64(c + V_GRUPPE) == 0) {
        // Die erste erlaubte Gruppe der eigenen Rangfolge.
        var rg: int64 := 0;
        while (rg < GRP_ANZAHL && peek64(c + V_GRUPPE) == 0) {
            if (gruppeErlaubt(c, gruppeNachRang(rg))) {
                poke64(c + V_GRUPPE, gruppeNachRang(rg));
            }
            rg += 1;
        }
        // Eine Konfiguration ohne jede Gruppe ist ein Fehler, kein stiller
        // Rueckfall auf etwas Plausibles.
        if (peek64(c + V_GRUPPE) == 0) { return false; }
    }
    if (!gruppenPaar(c)) { return false; }
    if (RandBytesExact(c + V_RANDOM, 32) != 32) { return false; }
    // Nur der Client erfindet eine session_id; der Server spiegelt die des
    // ClientHello zurueck und darf sie hier nicht ueberschreiben.
    if (mitSessionId) {
        if (RandBytesExact(c + V_SESSID, 32) != 32) { return false; }
        poke64(c + V_SESSIDLEN, 32);
    }
    return true;
}

// ALPN-Liste "h2,http/1.1" in das Protokollformat schreiben: je Eintrag ein
// Laengenbyte. Liefert die geschriebene Laenge.
fn alpnSchreiben(buf: int64, pos: int64, liste: int64, len: int64): int64 {
    var p: int64 := pos;
    var start: int64 := 0;
    var i: int64 := 0;
    while (i <= len) {
        if (i == len || (peek8(liste + i) & 0xFF) == 44) {       // ','
            var l: int64 := i - start;
            if (l > 0) {
                p := wByte(buf, p, l);
                p := wBytes(buf, p, liste + start, l);
            }
            start := i + 1;
        }
        i += 1;
    }
    return p;
}

// `zweites` unterscheidet ClientHello1 (wird aufbewahrt, nicht gehasht, weil
// die Suite noch nicht feststeht) von ClientHello2 nach einem HRR (Suite
// steht, geht also direkt in den Hash).
fn clientHelloBauen(c: int64, zweites: bool): int64 {
    var cfg: int64 := peek64(c + V_CFG);
    // Rumpf im hinteren Teil des Nachrichtenpuffers zusammenbauen; hsSendenRoh
    // setzt den Kopf davor und benutzt den vorderen Teil.
    var buf: int64 := pMsg(c) + 4096;

    var p: int64 := w16(buf, 0, 0x0303);                 // legacy_version
    p := wBytes(buf, p, c + V_RANDOM, 32);
    p := wByte(buf, p, 32);
    p := wBytes(buf, p, c + V_SESSID, 32);
    // Cipher-Suites. Mit freigeschaltetem TLS 1.2 kommen dessen Suiten
    // dahinter: ein 1.3-Server nimmt eine der ersten drei, ein Server ohne
    // 1.3 eine der hinteren. EIN ClientHello fuer beide Versionen, weil das
    // Transkript an den gesendeten Byte haengt und zwei verschiedene
    // ClientHellos nicht zusammenpassen wuerden.
    var mit12: bool := TlsCfgErlaubt12(cfg) && !zweites;
    if (mit12) {
        p := w16(buf, p, 18);
        p := w16(buf, p, CS_AES128_GCM_SHA256);
        p := w16(buf, p, CS_AES256_GCM_SHA384);
        p := w16(buf, p, CS_CHACHA20_SHA256);
        p := w16(buf, p, 0xC02B);                // ECDHE_ECDSA_AES128_GCM
        p := w16(buf, p, 0xC02F);                // ECDHE_RSA_AES128_GCM
        p := w16(buf, p, 0xCCA9);                // ECDHE_ECDSA_CHACHA20
        p := w16(buf, p, 0xCCA8);                // ECDHE_RSA_CHACHA20
        p := w16(buf, p, 0xC02C);                // ECDHE_ECDSA_AES256_GCM
        p := w16(buf, p, 0xC030);                // ECDHE_RSA_AES256_GCM
    } else {
        p := w16(buf, p, 6);
        p := w16(buf, p, CS_AES128_GCM_SHA256);
        p := w16(buf, p, CS_AES256_GCM_SHA384);
        p := w16(buf, p, CS_CHACHA20_SHA256);
    }
    p := wByte(buf, p, 1); p := wByte(buf, p, 0);        // legacy_compression

    var extLenPos: int64 := p;
    p += 2;
    var extStart: int64 := p;

    // supported_versions -- die Byte baut std.net.tls_kern (#2619).
    p := TkExtSupportedVersionsCh(buf, p, mit12);
    // supported_groups: alles, was die Konfiguration erlaubt, in der eigenen
    // Rangfolge — und nur, was diese Unit auch rechnen kann. Was hier steht,
    // darf der Server waehlen; eine Gruppe anzubieten, die wir nicht koennen,
    // waere eine Einladung in den Abbruch (genau das war 0x0503 in tls12).
    // Die ERLAUBNIS bleibt hier (sie haengt an der Vorgabe), die Byte
    // schreibt std.net.tls_kern. Uebergeben wird eine Maske in der
    // Rangfolge: Bit i gehoert zu Rang i.
    var grMaske: int64 := 0;
    var rg1: int64 := 0;
    while (rg1 < GRP_ANZAHL) {
        if (gruppeErlaubt(c, gruppeNachRang(rg1))) { grMaske := grMaske | (1 << rg1); }
        rg1 := rg1 + 1;
    }
    p := TkExtSupportedGroups(buf, p, grMaske);
    // key_share: ein Anteil, in der Gruppe aus V_GRUPPE. Bietet der Server
    // sie nicht an, kommt ein HelloRetryRequest — darum reicht einer.
    var pkLen: int64 := gruppenPkLen(c);
    p := TkExtKeyShareCh(buf, p, peek64(c + V_GRUPPE), gruppenPk(c), pkLen);
    // signature_algorithms (RFC 8446 §4.2.3), in unserer Vorliebe:
    // ecdsa_secp256r1_sha256, ecdsa_secp384r1_sha384,
    // rsa_pss_rsae_sha256/384/512, ed25519.
    // Was hier steht, darf die Gegenseite waehlen — es gehoert also nur
    // hinein, was die Pruefung unten auch kann.
    // Die LISTE ist die eigene Vorliebe und bleibt hier; die Byte schreibt
    // std.net.tls_kern. Sechs Schemata, je ein int64 im Kratzbereich.
    var sl: int64 := pScr(c) + S_SIGLIST;
    poke64(sl,      0x0403);     // ecdsa_secp256r1_sha256
    poke64(sl +  8, 0x0503);     // ecdsa_secp384r1_sha384
    poke64(sl + 16, 0x0804);     // rsa_pss_rsae_sha256
    poke64(sl + 24, 0x0805);     // rsa_pss_rsae_sha384
    poke64(sl + 32, 0x0806);     // rsa_pss_rsae_sha512
    poke64(sl + 40, 0x0807);     // ed25519
    p := TkExtSigAlgs(buf, p, sl, 6);
    // #2579: status_request (RFC 6066 Paragraph 8, Typ 5). NUR wenn die
    // Vorgabe das Pruefen ueberhaupt will -- eine Erweiterung anzubieten und
    // die Antwort dann wegzuwerfen waere eine Zusage ohne Deckung, und die
    // Gegenseite zahlt den Aufwand.
    //
    //   CertificateStatusRequest:
    //     status_type            1 Byte  = 1 (ocsp)
    //     responder_id_list      2 Byte Laenge = 0 (wir benennen keinen)
    //     request_extensions     2 Byte Laenge = 0
    //
    // Leere Listen heissen "der Server waehlt" -- das ist die Form, die auch
    // Browser senden.
    if (TlsCfgOcspModus(cfg) != 0) { p := TkExtStatusRequest(buf, p); }
    // server_name
    var hostLen: int64 := TlsCfgHostLen(cfg);
    if (TlsCfgHost(cfg) != 0 && hostLen > 0) {
        p := TkExtSni(buf, p, TlsCfgHost(cfg), hostLen);
    }
    // ALPN
    var alpnLen: int64 := TlsCfgAlpnLen(cfg);
    if (TlsCfgAlpn(cfg) != 0 && alpnLen > 0) {
        p := TkExtAlpn(buf, p, TlsCfgAlpn(cfg), alpnLen);
    }

    // Die Zutaten, die TLS 1.2 braucht: ohne sie lehnt die 1.2-Maschine den
    // Handschlag ab (Extended Master Secret ist dort Pflicht).
    if (mit12) {
        p := w16(buf, p, 23); p := w16(buf, p, 0);        // extended_master_secret
        p := w16(buf, p, 0xFF01); p := w16(buf, p, 1);    // renegotiation_info
        p := wByte(buf, p, 0);
        p := w16(buf, p, 11); p := w16(buf, p, 2);        // ec_point_formats
        p := wByte(buf, p, 1); p := wByte(buf, p, 0);
    }

    // Cookie aus dem HelloRetryRequest unveraendert zurueckgeben (§4.2.2).
    var ckLen: int64 := peek64(c + V_COOKIELEN);
    if (zweites && ckLen > 0) { p := TkExtCookie(buf, p, c + V_COOKIE, ckLen); }

    // ── Wiederaufnahme (#2577) ───────────────────────────────────────────
    //
    // Nur mit einem Ticket, und nur im ERSTEN ClientHello: nach einem
    // HelloRetryRequest waere der Binder ueber ein anderes Transkript zu
    // rechnen (§4.2.11.2 nennt dafuer eigene Regeln), und das ist nicht
    // umgesetzt — also wird dann gar nicht angeboten statt falsch.
    var tktLen: int64 := peek64(c + V_TKTLEN);
    var binderOff: int64 := 0;
    var hlT: int64 := peek64(c + V_TKTHL);
    if (!zweites && tktLen > 0 && hlT > 0
        && peek64(c + V_TKTSUITE) != 0) {
        // #2578: early_data, leer. Sie steht VOR pre_shared_key, weil
        // pre_shared_key die LETZTE Erweiterung sein muss (§4.2.11) — der
        // Binder rechnet ueber alles davor.
        //
        // Angeboten wird nur, wenn drei Dinge zusammenkommen: die eigene
        // Vorgabe erlaubt es, das Ticket nennt ein max_early_data_size, und
        // es ist das erste ClientHello. Nach einem HelloRetryRequest ist
        // 0-RTT ausgeschlossen (§4.2.10) — der Server hat die fruehen Daten
        // dann ohnehin schon verworfen.
        var edMaxC: int64 := TlsCfgFruehMax(cfg);
        if (edMaxC > peek64(c + V_TKTEDMAX)) { edMaxC := peek64(c + V_TKTEDMAX); }
        if (edMaxC > 0) {
            p := TkExtEarlyLeer(buf, p);
            poke64(c + V_EDMAX, edMaxC);
            poke64(c + V_EDZUSTAND, 1);
        }
        // psk_key_exchange_modes: NUR psk_dhe_ke (1).
        p := TkExtPskModes(buf, p);

        // pre_shared_key, als LETZTE Erweiterung.
        //   identities<7..2^16-1>:  identity<1..2^16-1> + obfuscated_age(4)
        //   binders<33..2^16-1>:    binder<32..255>
        var identLen: int64 := 2 + tktLen + 4;
        var binderLen: int64 := 1 + hlT;
        p := w16(buf, p, 41);
        p := w16(buf, p, 2 + identLen + 2 + binderLen);
        p := w16(buf, p, identLen);
        p := w16(buf, p, tktLen);
        p := wBytes(buf, p, c + V_TKT, tktLen);

        // obfuscated_ticket_age: (Alter in MILLISEKUNDEN + age_add) mod 2^32.
        // Die Millisekunden sind der Grund fuer die 1000: unsere Uhr laeuft
        // in Sekunden, das Feld nicht.
        var alterS: int64 := TlsCfgJetzt(cfg) - peek64(c + V_TKTZEIT);
        if (alterS < 0) { alterS := 0; }
        var obf: int64 := (alterS * 1000 + peek64(c + V_TKTAGEADD)) & 0xFFFFFFFF;
        p := wByte(buf, p, (obf >> 24) & 0xFF);
        p := wByte(buf, p, (obf >> 16) & 0xFF);
        p := wByte(buf, p, (obf >> 8) & 0xFF);
        p := wByte(buf, p, obf & 0xFF);

        // Hier beginnt die Binderliste — genau dieser Abstand ist das, was
        // gehasht NICHT mehr dazugehoert.
        binderOff := p;
        p := w16(buf, p, binderLen);
        p := wByte(buf, p, hlT);
        var z: int64 := 0;
        while (z < hlT) { p := wByte(buf, p, 0); z := z + 1; }
    }

    w16(buf, extLenPos, p - extStart);

    if (binderOff > 0) {
        // Der Schluessel fuer den Binder haengt am PSK aus dem Ticket.
        var fk: int64 := pScr(c) + S_FINKEY;
        if (!binderKey(c, hlT, c + V_TKTPSK, hlT, fk)) { return E_KONFIG; }
        // Das erste ClientHello wird aufbewahrt statt gehasht (siehe O_CH),
        // und hsSendenMitBinder tut beides an der richtigen Stelle.
        var rcB: int64 := hsSendenMitBinder(c, hlT, buf, p, binderOff, fk);
        SecureZero(fk, 64);
        return rcB;
    }

    if (zweites) {
        return hsSendenRoh(c, HS_CLIENT_HELLO, buf, p, true, false);
    }
    // Nicht hashen, sondern aufbewahren (siehe O_CH).
    return hsSendenRoh(c, HS_CLIENT_HELLO, buf, p, false, true);
}

fn clientHelloSenden(c: int64): int64 { return clientHelloBauen(c, false); }
fn clientHello2Senden(c: int64): int64 { return clientHelloBauen(c, true); }

fn serverHelloSenden(c: int64): int64 {
    var buf: int64 := pMsg(c) + 4096;
    var p: int64 := w16(buf, 0, 0x0303);
    p := wBytes(buf, p, c + V_RANDOM, 32);
    p := wByte(buf, p, peek64(c + V_SESSIDLEN));
    p := wBytes(buf, p, c + V_SESSID, peek64(c + V_SESSIDLEN));
    p := w16(buf, p, peek64(c + V_SUITE));
    p := wByte(buf, p, 0);                                // compression
    var extLenPos: int64 := p;
    p += 2;
    var extStart: int64 := p;
    // supported_versions
    p := TkExtSupportedVersionsSh(buf, p);
    // pre_shared_key: WELCHE Identitaet genommen wurde (#2577, §4.2.11).
    // Wir betrachten nur die erste, also immer 0. Ohne diese Erweiterung
    // wuesste der Client nicht, dass sein PSK angenommen wurde — und wuerde
    // auf ein Zertifikat warten, das nicht kommt.
    if (peek64(c + V_PSKDA) == 1) {
        p := w16(buf, p, 41); p := w16(buf, p, 2); p := w16(buf, p, 0);
    }
    // key_share
    var pkLen: int64 := gruppenPkLen(c);
    p := TkExtKeyShareSh(buf, p, peek64(c + V_GRUPPE), gruppenPk(c), pkLen);
    w16(buf, extLenPos, p - extStart);
    return hsSenden(c, HS_SERVER_HELLO, buf, p);
}

// Der feste Zufallswert, der ein ServerHello als HelloRetryRequest
// kennzeichnet (RFC 8446 §4.1.3): SHA-256 von "HelloRetryRequest".
fn hrrRandom(out: int64): void { TkHrrRandom(out); }

fn istHrr(c: int64, zufall: int64): bool {
    // #2619: derselbe feste Wert und derselbe Vergleich in beiden
    // Protokollen -- darum in std.net.tls_kern. Der Kratzplatz bleibt S_HRRC,
    // damit die Rolle dieses Bereichs hier sichtbar ist.
    return TkIstHrr(zufall, pScr(c) + S_HRRC);
}

// Das Transkript bei HRR: ClientHello1 wird durch eine synthetische
// message_hash-Nachricht ersetzt (RFC 8446 §4.4.1). Danach HRR und
// ClientHello2 wie gewoehnlich.
fn transkriptMessageHash(c: int64, ch: int64, chLen: int64): void {
    var hl: int64 := peek64(c + V_HASHLEN);
    var mh: int64 := pScr(c) + S_MH;
    if (hl == 48) { Sha384(ch, chLen, mh); } else { SHA256(ch, chLen, mh); }
    var kopf: int64 := pScr(c) + S_KOPF;
    poke8(kopf, HS_MESSAGE_HASH);
    poke8(kopf + 1, 0); poke8(kopf + 2, 0); poke8(kopf + 3, hl & 0xFF);
    hashInit(c);
    hashUpdate(c, kopf, 4);
    hashUpdate(c, mh, hl);
}

// HelloRetryRequest senden: ServerHello-Form mit dem festen Zufallswert und
// einem key_share, das NUR die gewaehlte Gruppe nennt (§4.1.4).
fn hrrSenden(c: int64): int64 {
    var buf: int64 := pMsg(c) + 4096;
    var p: int64 := w16(buf, 0, 0x0303);
    hrrRandom(buf + p);
    p += 32;
    p := wByte(buf, p, peek64(c + V_SESSIDLEN));
    p := wBytes(buf, p, c + V_SESSID, peek64(c + V_SESSIDLEN));
    p := w16(buf, p, peek64(c + V_SUITE));
    p := wByte(buf, p, 0);
    var extLenPos: int64 := p;
    p += 2;
    var extStart: int64 := p;
    p := TkExtSupportedVersionsSh(buf, p);
    p := TkExtKeyShareHrr(buf, p, peek64(c + V_GRUPPE));
    w16(buf, extLenPos, p - extStart);
    return hsSenden(c, HS_SERVER_HELLO, buf, p);
}

fn eeSenden(c: int64): int64 {
    var buf: int64 := pMsg(c) + 4096;
    var p: int64 := 0;
    var extLenPos: int64 := p;
    p += 2;
    var extStart: int64 := p;
    if (peek64(c + V_ALPNSELLEN) > 0) {
        var l: int64 := peek64(c + V_ALPNSELLEN);
        p := w16(buf, p, 16); p := w16(buf, p, l + 3);
        p := w16(buf, p, l + 1); p := wByte(buf, p, l);
        p := wBytes(buf, p, peek64(c + V_ALPNSEL), l);
    }
    // #2578: early_data, leer — das IST die Annahme (§4.2.10). Es gibt kein
    // Feld fuer "abgelehnt": fehlt die Erweiterung, sind die fruehen Daten
    // abgelehnt.
    if (peek64(c + V_EDZUSTAND) == 2) { p := TkExtEarlyLeer(buf, p); }
    w16(buf, extLenPos, p - extStart);
    return hsSenden(c, HS_EE, buf, p);
}

fn certRequestSenden(c: int64): int64 {
    var buf: int64 := pMsg(c) + 4096;
    // certificate_request_context: leer
    var p: int64 := wByte(buf, 0, 0);
    var extLenPos: int64 := p;
    p += 2;
    var extStart: int64 := p;
    // signature_algorithms ist Pflicht in CertificateRequest (§4.3.2)
    p := w16(buf, p, 13); p := w16(buf, p, 14);
    p := w16(buf, p, 12);
    p := w16(buf, p, 0x0403);
    p := w16(buf, p, 0x0503);
    p := w16(buf, p, 0x0804);
    p := w16(buf, p, 0x0805);
    p := w16(buf, p, 0x0806);
    p := w16(buf, p, 0x0807);
    w16(buf, extLenPos, p - extStart);
    return hsSenden(c, HS_CERT_REQUEST, buf, p);
}

fn certSenden(c: int64): int64 {
    var n: int64 := aktKetteN(c);
    var liste: int64 := aktKette(c);
    var gesamt: int64 := 0;
    var i: int64 := 0;
    while (i < n) { gesamt += 5 + peek64(liste + i * 16 + 8); i += 1; }

    // #2579: die beigelegte OCSP-Antwort haengt am BLATT, also am ersten
    // Eintrag (RFC 8446 Paragraph 4.4.2.1). Sie wird nur gesendet, wenn der
    // Client danach gefragt hat UND eine hinterlegt ist; fehlt sie, bleibt die
    // Erweiterung WEG. Ein leeres certificate_status waere eine Aussage, die
    // keine ist.
    var cfgCS: int64 := peek64(c + V_CFG);
    var ocsp: int64 := 0;
    var ocspLen: int64 := 0;
    if (peek64(c + V_OCSPWUNSCH) != 0) {
        ocsp := TlsCfgOcsp(cfgCS);
        ocspLen := TlsCfgOcspLen(cfgCS);
        if (ocsp == 0 || ocspLen <= 0) { ocsp := 0; ocspLen := 0; }
    }
    // Die Erweiterung kostet 2 (Typ) + 2 (Laenge) + 1 (status_type)
    // + 3 (Laenge der OCSPResponse) + die Antwort selbst.
    if (ocsp != 0) { gesamt += 8 + ocspLen; }

    if (gesamt + 16 > 4000) { return E_PUFFER; }
    var buf: int64 := pMsg(c) + 4096;
    var p: int64 := wByte(buf, 0, 0);                     // request_context leer
    p := w24(buf, p, gesamt);
    i := 0;
    while (i < n) {
        var l: int64 := peek64(liste + i * 16 + 8);
        p := w24(buf, p, l);
        p := wBytes(buf, p, peek64(liste + i * 16), l);
        if (i == 0 && ocsp != 0) {
            p := w16(buf, p, 4 + ocspLen + 4);            // Laenge der Erweiterungen
            p := w16(buf, p, 5);                          // status_request
            p := w16(buf, p, 4 + ocspLen);
            p := wByte(buf, p, 1);                        // status_type = ocsp
            p := w24(buf, p, ocspLen);
            p := wBytes(buf, p, ocsp, ocspLen);
        } else {
            p := w16(buf, p, 0);                          // keine Erweiterungen
        }
        i += 1;
    }
    return hsSenden(c, HS_CERT, buf, p);
}

// Der zu signierende Inhalt nach §4.4.3: 64 Leerzeichen, Kontextkennung,
// ein Nullbyte, dann der Transkript-Hash.
fn signaturInhalt(c: int64, serverRolle: bool, out: int64): int64 {
    // #2619: Die Byte baut std.net.tls_kern; HIER bleibt nur, WELCHER
    // Transkriptstand gemeint ist -- und das ist die Stelle, an der schon
    // einmal etwas schiefgegangen ist (ein Stand zu frueh, und die
    // Gegenseite lehnt die Signatur ab).
    var th: int64 := pScr(c) + S_TH;
    hashJetzt(c, th);
    return TkSignaturInhalt(serverRolle, th, peek64(c + V_HASHLEN), out);
}

// ---------------------------------------------------------------------------
// Eigene Kette: entweder die einzelne aus TlsConfigKette oder der nach SNI
// gewaehlte Eintrag der Tabelle aus TlsConfigKetten.
// ---------------------------------------------------------------------------

fn aktKette(c: int64): int64 {
    var e: int64 := peek64(c + V_KETTE);
    if (e != 0) { return peek64(e + 16); }
    return TlsCfgCert(peek64(c + V_CFG));
}

fn aktKetteN(c: int64): int64 {
    var e: int64 := peek64(c + V_KETTE);
    if (e != 0) { return peek64(e + 24); }
    return TlsCfgCertN(peek64(c + V_CFG));
}

fn aktKey(c: int64): int64 {
    var e: int64 := peek64(c + V_KETTE);
    if (e != 0) { return peek64(e + 32); }
    return TlsCfgKey(peek64(c + V_CFG));
}

fn aktKeyLen(c: int64): int64 {
    var e: int64 := peek64(c + V_KETTE);
    if (e != 0) { return peek64(e + 40); }
    return TlsCfgKeyLen(peek64(c + V_CFG));
}

// Kette nach dem SNI des ClientHello waehlen. Die Tabelle wird JE
// HANDSCHLAG gelesen; damit wirkt ein Austausch im Betrieb sofort
// (Hot-Reload) ohne Neustart und ohne Zwischenspeicher.
//
// Reihenfolge: genauer Name, dann Jokereintrag "*.beispiel.de", dann der
// Eintrag mit Namenslaenge 0 als Standard. Passt nichts, wird abgewiesen —
// ein beliebiges anderes Zertifikat auszuliefern waere der stille Default,
// der in diesem Repo schon oft genug Schaden gemacht hat.
fn ketteWaehlen(c: int64): int64 {
    var cfg: int64 := peek64(c + V_CFG);
    poke64(c + V_KETTE, 0);
    var tab: int64 := TlsCfgKetten(cfg);
    var n: int64 := TlsCfgKettenN(cfg);

    if (tab != 0 && n > 0) {
        var host: int64 := c + V_SNIBUF;
        var hostLen: int64 := peek64(c + V_SNILEN);
        var treffer: int64 := 0;
        var standard: int64 := 0;
        var joker: int64 := 0;
        var i: int64 := 0;
        while (i < n) {
            var e: int64 := tab + i * 48;
            var nm: int64 := peek64(e);
            var nl: int64 := peek64(e + 8);
            if (nl == 0) {
                if (standard == 0) { standard := e; }
            } else {
                if (hostLen > 0 && treffer == 0) {
                    if (namenGleichKlein(nm, nl, host, hostLen)) { treffer := e; }
                    else {
                        if (joker == 0 && jokerPasst(nm, nl, host, hostLen)) { joker := e; }
                    }
                }
            }
            i += 1;
        }
        if (treffer == 0) { treffer := joker; }
        if (treffer == 0) { treffer := standard; }
        if (treffer == 0) { return E_KONFIG; }
        if (peek64(treffer + 16) == 0 || peek64(treffer + 24) <= 0
            || peek64(treffer + 32) == 0) { return E_KONFIG; }
        poke64(c + V_KETTE, treffer);
        return 0;
    }

    if (TlsCfgCert(cfg) == 0 || TlsCfgCertN(cfg) <= 0
        || TlsCfgKey(cfg) == 0) { return E_KONFIG; }
    return 0;
}

fn kleinbuchstabe(b: int64): int64 {
    if (b >= 65 && b <= 90) { return b + 32; }
    return b;
}

fn namenGleichKlein(a: int64, aLen: int64, b: int64, bLen: int64): bool {
    if (aLen != bLen) { return false; }
    var i: int64 := 0;
    while (i < aLen) {
        if (kleinbuchstabe(peek8(a + i) & 0xFF) != kleinbuchstabe(peek8(b + i) & 0xFF)) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Jokereintrag "*.rest": ersetzt GENAU die linkeste Marke, und der Rest muss
// selbst noch mindestens zwei Marken haben — "*.de" trifft damit nichts.
fn jokerPasst(muster: int64, musterLen: int64, host: int64, hostLen: int64): bool {
    if (musterLen < 3) { return false; }
    if ((peek8(muster) & 0xFF) != 42) { return false; }
    if ((peek8(muster + 1) & 0xFF) != 46) { return false; }
    var rest: int64 := muster + 2;
    var restLen: int64 := musterLen - 2;
    var punkte: int64 := 0;
    var i: int64 := 0;
    while (i < restLen) {
        if ((peek8(rest + i) & 0xFF) == 46) { punkte += 1; }
        i += 1;
    }
    if (punkte < 1) { return false; }
    var ersterPunkt: int64 := -1;
    i := 0;
    while (i < hostLen) {
        if ((peek8(host + i) & 0xFF) == 46 && ersterPunkt < 0) { ersterPunkt := i; }
        i += 1;
    }
    if (ersterPunkt <= 0) { return false; }
    return namenGleichKlein(rest, restLen,
                            host + ersterPunkt + 1, hostLen - ersterPunkt - 1);
}

// Eigene Schluesselart bestimmen: 1 = EC secp256r1, 3 = RSA, 4 = Ed25519,
// 0 = nicht lesbar. Die Reihenfolge der Versuche ist festgelegt, damit ein
// Schluessel nicht zufaellig als etwas anderes gelesen wird.
fn eigeneSchluesselart(c: int64): int64 {
    var der: int64 := aktKey(c);
    var len: int64 := aktKeyLen(c);
    if (der == 0 || len <= 0) { return 0; }
    var priv: int64 := pScr(c) + S_PRIV;
    // PkeyLiesEcPrivat liefert die KURVE (1 = secp256r1, 2 = secp384r1),
    // nicht nur "ist EC". Bis #2096 wurde nur die 1 ausgewertet; ein
    // P-384-Schluessel fiel durch alle Zweige und endete als "keine
    // Schluesselart", also E_KONFIG — eine gueltige Kette war damit
    // unbenutzbar, ohne dass die Meldung die Kurve genannt haette.
    var eck: int64 := PkeyLiesEcPrivat(der, len, priv);
    if (eck == 1) { return 1; }
    if (eck == 2) { return 5; }
    if (RsaPrivAusPkcs8(der, len, pRsa(c))) { return 3; }
    if (RsaPrivAusPkcs1(der, len, pRsa(c))) { return 3; }
    if (Ed25519PrivAusPkcs8(der, len, pScr(c) + S_SEED)) { return 4; }
    return 0;
}

// Welche Signaturverfahren koennen wir mit unserem Schluessel leisten, in
// unserer Vorliebe? Die Liste ist kurz und ausdruecklich: ein Verfahren, das
// hier nicht steht, wird auch nicht gesendet.
//   EC P-256     ecdsa_secp256r1_sha256
//   EC P-384     ecdsa_secp384r1_sha384
//   RSA          rsa_pss_rsae_sha256, dann sha384, dann sha512
//   Ed25519      ed25519
//
// Art 5 ist EC mit secp384r1. Die Kurve gehoert in die ART und nicht in eine
// zweite Abfrage am Erzeugungsort: ein P-384-Schluessel unter
// ecdsa_secp256r1_sha256 waere eine Signatur, die niemand pruefen kann, und
// der Fehler faellt erst an der Gegenstelle auf.
fn eigeneSchemata(art: int64, out: int64): int64 {
    if (art == 1) { poke64(out, 0x0403); return 1; }
    if (art == 5) { poke64(out, 0x0503); return 1; }
    if (art == 3) {
        poke64(out, 0x0804); poke64(out + 8, 0x0805); poke64(out + 16, 0x0806);
        return 3;
    }
    if (art == 4) { poke64(out, 0x0807); return 1; }
    return 0;
}

// Steht `schema` in der signature_algorithms-Liste des ClientHello?
fn clientBietetSchema(liste: int64, listeLen: int64, schema: int64): bool {
    var i: int64 := 0;
    while (i + 1 < listeLen) {
        if (r16(liste, i) == schema) { return true; }
        i += 2;
    }
    return false;
}

// Waehlt das Signaturverfahren fuer CertificateVerify. Bietet der Client
// keines an, das wir mit unserem Schluessel leisten koennen, wird
// ABGEBROCHEN — ein Verfahren zu senden, das der Client nicht genannt hat,
// waere ein Protokollfehler (und genau den hat tlsfuzzer gefunden: mit einem
// EC-Schluessel und einem Client, der nur RSA-PSS anbietet, signierte diese
// Unit trotzdem mit ecdsa_secp256r1_sha256).
fn schemaWaehlen(c: int64, liste: int64, listeLen: int64): int64 {
    var art: int64 := eigeneSchluesselart(c);
    if (art == 0) { return E_KONFIG; }
    var kand: int64 := pScr(c) + S_WUNSCH;
    var n: int64 := eigeneSchemata(art, kand);
    var i: int64 := 0;
    while (i < n) {
        var sch: int64 := peek64(kand + i * 8);
        if (listeLen <= 0) {
            // Ohne die Erweiterung gibt es in TLS 1.3 keinen Handschlag
            // (RFC 8446 §9.2: signature_algorithms ist Pflicht, wenn der
            // Server ein Zertifikat sendet).
            return E_UNTERSTUETZT;
        }
        if (clientBietetSchema(liste, listeLen, sch)) {
            poke64(c + V_SIGALG, sch);
            return 0;
        }
        i += 1;
    }
    return E_UNTERSTUETZT;
}

fn certVerifySenden(c: int64, serverRolle: bool): int64 {
    var scr: int64 := pScr(c);
    var art: int64 := eigeneSchluesselart(c);
    if (art == 0) { return E_KONFIG; }

    var inhalt: int64 := scr + S_SIG;
    var len: int64 := signaturInhalt(c, serverRolle, inhalt);
    var buf: int64 := scr + S_CVBUF;
    var sigBuf: int64 := scr + S_SIGBUF;

    // Das gewaehlte Verfahren steht in V_SIGALG (Server: aus der Liste des
    // Clients; Client: unsere Vorliebe, der Server hat sie in
    // CertificateRequest genannt).
    var schema: int64 := peek64(c + V_SIGALG);
    if (schema == 0) {
        var kand0: int64 := pScr(c) + S_WUNSCH;
        if (eigeneSchemata(art, kand0) <= 0) { return E_KONFIG; }
        schema := peek64(kand0);
        poke64(c + V_SIGALG, schema);
    }

    if (art == 1) {
        // ecdsa_secp256r1_sha256
        var priv: int64 := scr + S_PRIV;
        var hash: int64 := scr + S_HASH;
        var r: int64 := scr + S_R;
        var s: int64 := scr + S_S;
        var der: int64 := scr + S_DER;
        SHA256(inhalt, len, hash);
        if (!EcdsaSign(EC_P256, hash, priv, r, s)) { SecureZero(priv, 48); return E_SIGNATUR; }
        var derLen: int64 := EcdsaSigToDer(r, s, 32, der);
        var p1: int64 := TkCvRumpf(buf, 0, 0x0403, der, derLen);
        SecureZero(priv, 48);
        return hsSenden(c, HS_CERT_VERIFY, buf, p1);
    }

    if (art == 5) {
        // ecdsa_secp384r1_sha384
        var priv5: int64 := scr + S_PRIV;
        var hash5: int64 := scr + S_HASH;
        var r5: int64 := scr + S_R;
        var s5: int64 := scr + S_S;
        var der5: int64 := scr + S_DER;
        Sha384(inhalt, len, hash5);
        if (!EcdsaSign(EC_P384, hash5, priv5, r5, s5)) {
            SecureZero(priv5, 48);
            return E_SIGNATUR;
        }
        var derLen5: int64 := EcdsaSigToDer(r5, s5, 48, der5);
        var p5: int64 := TkCvRumpf(buf, 0, 0x0503, der5, derLen5);
        SecureZero(priv5, 48);
        return hsSenden(c, HS_CERT_VERIFY, buf, p5);
    }

    if (art == 3) {
        // RSASSA-PSS (RFC 8446 §4.2.3: PSS ist fuer TLS 1.3 Pflicht,
        // PKCS#1 v1.5 ist dort NICHT erlaubt). Die Hashlaenge kommt aus dem
        // gewaehlten Schema: 0x0804 sha256, 0x0805 sha384, 0x0806 sha512.
        var hl2: int64 := 32;
        if (schema == 0x0805) { hl2 := 48; }
        if (schema == 0x0806) { hl2 := 64; }
        var hash2: int64 := scr + S_HASH;
        if (hl2 == 32) { SHA256(inhalt, len, hash2); }
        if (hl2 == 48) { Sha384(inhalt, len, hash2); }
        if (hl2 == 64) { Sha512(inhalt, len, hash2); }
        var sl: int64 := RsaSignPss(pRsa(c), hl2, hash2, sigBuf);
        if (sl <= 0) { return E_SIGNATUR; }
        if (sl > 480) { return E_PUFFER; }
        var p2: int64 := w16(buf, 0, schema);
        p2 := w16(buf, p2, sl);
        // Der Rumpf passt nicht in S_CVBUF (128 Byte) — darum direkt in den
        // Nachrichtenpuffer schreiben.
        var mb: int64 := pMsg(c) + 4096;
        var p3: int64 := TkCvRumpf(mb, 0, schema, sigBuf, sl);
        return hsSenden(c, HS_CERT_VERIFY, mb, p3);
    }

    // Ed25519 signiert den Inhalt selbst, ohne Vorhash.
    var seed: int64 := scr + S_SEED;
    Ed25519Sign(seed, inhalt, len, sigBuf);
    SecureZero(seed, 32);
    var p4: int64 := TkCvRumpf(buf, 0, 0x0807, sigBuf, 64);
    return hsSenden(c, HS_CERT_VERIFY, buf, p4);
}

// verify_data = HMAC(finished_key, Transcript-Hash) (§4.4.4)
fn finishedWert(c: int64, secret: int64, out: int64): bool {
    var th: int64 := pScr(c) + S_TH;
    hashJetzt(c, th);
    return TkFinishedWert(peek64(c + V_HASHLEN), secret, th, pScr(c) + S_FK, out);
}

fn finishedSenden(c: int64, secret: int64): int64 {
    var hl: int64 := peek64(c + V_HASHLEN);
    var vd: int64 := pScr(c) + S_VD;
    if (!finishedWert(c, secret, vd)) { return E_FINISHED; }
    return hsSenden(c, HS_FINISHED, vd, hl);
}

// Ein Dummy-ChangeCipherSpec im KLARTEXT (RFC 8446 Anhang D.4,
// "middlebox compatibility mode"). Es gehoert NICHT in den Transkript-Hash
// und wird von der Gegenseite verworfen; sein Zweck ist allein, dass der
// Handschlag auf der Leitung wie TLS 1.2 aussieht.
//
// Der Record muss unverschluesselt hinausgehen, auch wenn die Schreibstufe
// schon steht — darum nicht ueber recordSenden, das ab dann verschluesselt.
// Dass es noetig ist, hat tlsfuzzer gezeigt (#2096): dessen
// Grundgespraechstest erwartet das CCS, weil praktisch jeder Server es
// sendet, und ohne es verwerfen Mittelboxen den Handschlag.
fn ccsDummySenden(c: int64): int64 {
    // Genau EINMAL je Verbindung. Nach einem HelloRetryRequest geht es schon
    // dort hinaus (siehe serverClientHello), und der Aufruf hinter dem
    // ServerHello darf es dann nicht wiederholen.
    if (peek64(c + V_CCSGES) == 1) { return 0; }
    poke64(c + V_CCSGES, 1);
    var pos: int64 := peek64(c + V_OUTPOS);
    if (pos + 6 > B_OUT) { return E_PUFFER; }
    poke8(pOut(c) + pos, RT_CCS);
    poke8(pOut(c) + pos + 1, 3);
    poke8(pOut(c) + pos + 2, 3);
    poke8(pOut(c) + pos + 3, 0);
    poke8(pOut(c) + pos + 4, 1);
    poke8(pOut(c) + pos + 5, 1);
    poke64(c + V_OUTPOS, pos + 6);
    return 0;
}

fn alertSenden(c: int64, stufe: int64, grund: int64): void {
    var a: int64 := pScr(c) + S_K1;
    poke8(a, stufe); poke8(a + 1, grund);
    recordSenden(c, RT_ALERT, a, 2);
}

// ---------------------------------------------------------------------------
// Handschlagnachrichten lesen
// ---------------------------------------------------------------------------

// Naechste vollstaendige Nachricht im HS-Puffer ansehen, ohne sie zu
// verbrauchen. typPtr/posPtr/lenPtr nehmen Typ, Rumpfposition (absolut) und
// Rumpflaenge auf.
fn hsAnsehen(c: int64, typPtr: int64, posPtr: int64, lenPtr: int64): bool {
    var gelesen: int64 := peek64(c + V_HSGELESEN);
    var vorhanden: int64 := peek64(c + V_HSPOS) - gelesen;
    if (vorhanden < 4) { return false; }
    var b: int64 := pHs(c) + gelesen;
    var len: int64 := r24(b, 1);
    if (len < 0 || len > B_HS) { return false; }
    if (vorhanden < 4 + len) { return false; }
    poke64(typPtr, peek8(b) & 0xFF);
    poke64(posPtr, b + 4);
    poke64(lenPtr, len);
    return true;
}

// Die angesehene Nachricht in den Transkript-Hash geben (oder nicht) und
// weiterruecken.
fn hsVerbrauchen(c: int64, len: int64, hashen: bool): void {
    var gelesen: int64 := peek64(c + V_HSGELESEN);
    if (hashen) { hashUpdate(c, pHs(c) + gelesen, 4 + len); }
    gelesen += 4 + len;
    if (gelesen == peek64(c + V_HSPOS)) {
        poke64(c + V_HSPOS, 0);
        poke64(c + V_HSGELESEN, 0);
    } else {
        poke64(c + V_HSGELESEN, gelesen);
    }
}

// Erweiterungsblock durchsuchen. `pos` ist ein Versatz in `buf`, der
// Rueckgabewert dagegen die ABSOLUTE Adresse des Inhalts (oder -1), weil die
// Aufrufer gleich daraus lesen. Der Block beginnt mit zwei Laengenbyte.
fn extSuchen(buf: int64, pos: int64, len: int64, typ: int64, lenPtr: int64): int64 {
    return TkExtSuchen(buf, pos, len, typ, lenPtr);
}

// ServerHello (Client-Seite)
fn serverHelloLesen(c: int64, pos: int64, len: int64): int64 {
    // #2619: Rahmen aus std.net.tls_kern, Entscheidung hier. Siehe
    // clientHelloLesen -- derselbe Schnitt, derselbe Grund.
    // Vor dem Lesen zuruecksetzen: ein ServerHello OHNE pre_shared_key
    // heisst "PSK nicht angenommen", und das muss den Stand eines frueheren
    // Versuchs loeschen.
    poke64(c + V_PSKDA, 0);
    if (r16(pos, 0) != 0x0303) { return E_VERSION; }

    var rh: int64 := pScr(c) + S_RAHMEN;
    var rr: int64 := TkShRahmen(pos, len, rh);
    if (rr == TkRahmenKomp()) { return E_FORMAT; }
    if (rr != TkRahmenOk()) { return E_FORMAT; }

    var i: int64 := 0;
    while (i < 32) {
        poke8(c + V_PEER_RAND + i, peek8(TkRahmenRandom(rh) + i));
        i := i + 1;
    }
    var sidLen: int64 := TkRahmenSidLen(rh);
    // Die session_id muss die des ClientHello sein (§4.1.3).
    if (sidLen != peek64(c + V_SESSIDLEN)) { return E_FORMAT; }
    if (CTMemEqual(TkRahmenSidPos(rh), c + V_SESSID, sidLen) != 0 - 1) { return E_FORMAT; }

    var suite: int64 := r16(pos, TkRahmenSuitePos(rh) - pos);
    if (!suiteSetzen(c, suite)) { return E_SUITE; }
    var p: int64 := TkRahmenExtPos(rh);

    var extLen: int64 := pScr(c) + S_EL;
    var sv: int64 := extSuchen(pos, p, len - p, 43, extLen);
    if (sv < 0 || peek64(extLen) != 2 || r16(sv, 0) != 0x0304) { return E_VERSION; }

    // pre_shared_key: der Server sagt, WELCHE Identitaet er genommen hat
    // (#2577, §4.2.11). Wir bieten genau eine an, also ist alles ausser 0
    // ein Protokollfehler — und ein angenommener PSK, den wir nie angeboten
    // haben, erst recht.
    var pk: int64 := extSuchen(pos, p, len - p, 41, extLen);
    if (pk >= 0) {
        if (peek64(extLen) != 2) { return E_FORMAT; }
        if (r16(pk, 0) != 0) { return E_PARAM; }
        if (peek64(c + V_TKTLEN) <= 0) { return E_PARAM; }
        poke64(c + V_PSKDA, 1);
    }

    var ks: int64 := extSuchen(pos, p, len - p, 51, extLen);

    // HelloRetryRequest: key_share nennt nur die Gruppe, ohne Anteil.
    // Rueckgabe 1 statt 0, damit der Aufrufer den anderen Weg geht.
    if (istHrr(c, pos + 2)) {
        if (peek64(c + V_HRR) != 0) { return E_HRR; }   // zweites HRR verboten
        if (ks < 0 || peek64(extLen) != 2) { return E_HRR; }
        var neu: int64 := r16(ks, 0);
        if (!gruppeErlaubt(c, neu)) { return E_HRR; }
        // Dieselbe Gruppe erneut zu verlangen ist nach §4.1.4 verboten.
        if (neu == peek64(c + V_GRUPPE)) { return E_HRR; }
        poke64(c + V_GRUPPE, neu);
        // Cookie mitnehmen, falls eines dabei ist.
        poke64(c + V_COOKIELEN, 0);
        var ck: int64 := extSuchen(pos, p, len - p, 44, extLen);
        if (ck >= 0 && peek64(extLen) >= 2) {
            var ckL: int64 := r16(ck, 0);
            if (ckL <= 0 || ckL > 256 || ckL + 2 > peek64(extLen)) { return E_FORMAT; }
            var z: int64 := 0;
            while (z < ckL) { poke8(c + V_COOKIE + z, peek8(ck + 2 + z)); z += 1; }
            poke64(c + V_COOKIELEN, ckL);
        }
        return 1;
    }

    var roh: int64 := 0;
    if (ks < 0) { return E_GRUPPE; }
    var grp: int64 := r16(ks, 0);
    roh := gruppenRohLen(grp);
    if (roh == 0 || !gruppeErlaubt(c, grp)) { return E_GRUPPE; }
    // Der Server darf nur die Gruppe nehmen, zu der wir einen Anteil
    // geschickt haben.
    if (grp != peek64(c + V_GRUPPE)) { return E_GRUPPE; }
    if (peek64(extLen) != roh + 4 || r16(ks, 2) != roh) { return E_GRUPPE; }
    // Dieselbe Pruefung wie auf der Serverseite (ksEintragPruefen) — die
    // beiden muessen uebereinstimmen, sonst nimmt eine Rolle an, was die
    // andere abweist.
    var pr2: int64 := ksEintragPruefen(grp, ks + 4, roh);
    if (pr2 != 0) { return pr2; }
    var ziel: int64 := c + V_PEER_PK;
    if (gruppenKurve(grp) >= 0) { ziel := c + V_EC_PEER; }
    i := 0;
    while (i < roh) { poke8(ziel + i, peek8(ks + 4 + i)); i := i + 1; }
    return 0;
}

// ClientHello (Server-Seite): Suite waehlen, key_share und SNI/ALPN lesen.
fn clientHelloLesen(c: int64, pos: int64, len: int64): int64 {
    // #2619: Der RAHMEN kommt aus std.net.tls_kern -- wo die Felder liegen
    // und ob die Laengen zusammenpassen, ist in TLS 1.3 und DTLS 1.3
    // dasselbe (RFC 9147 §5.3). Was hier bleibt, ist die ENTSCHEIDUNG:
    // Suite, Gruppe, HelloRetryRequest, PSK. Vorher standen beide
    // zusammen, und genau das machte den Leser fuer DTLS unbrauchbar.
    //
    // legacy_version prueft der Rahmen bewusst nicht (§4.2.1: wer ueber
    // supported_versions verhandelt, muss es ignorieren -- die alte
    // Pruefung auf 0x0303 wies 193 von 202 Faellen in tlsfuzzers
    // test-tls13-version-negotiation ab, alle zu Unrecht, #2096).
    var rh: int64 := pScr(c) + S_RAHMEN;
    var rr: int64 := TkChRahmen(pos, len, rh);
    if (rr == TkRahmenSidZuLang()) { return E_FORMAT; }
    if (rr != TkRahmenOk()) { return E_FORMAT; }

    var i: int64 := 0;
    while (i < 32) {
        poke8(c + V_PEER_RAND + i, peek8(TkRahmenRandom(rh) + i));
        i := i + 1;
    }
    // Die session_id wird im ServerHello zurueckgespiegelt (§4.1.3).
    var sidLen: int64 := TkRahmenSidLen(rh);
    i := 0;
    while (i < sidLen) {
        poke8(c + V_SESSID + i, peek8(TkRahmenSidPos(rh) + i));
        i := i + 1;
    }
    poke64(c + V_SESSIDLEN, sidLen);

    var csLen: int64 := TkRahmenSuiteLen(rh);
    // Die Suiteliste als ABSTAND im Puffer: der Rest dieser Funktion
    // rechnet mit Abstaenden (r16(pos, p)), und zwei Schreibweisen
    // nebeneinander waere die Verwechslung, auf die niemand wartet.
    var p: int64 := TkRahmenSuitePos(rh) - pos;
    // Reihenfolge der Server-Vorliebe, nicht die des Clients.
    var gewaehlt: int64 := 0;
    var wunsch: int64 := pScr(c) + S_WUNSCH;
    poke64(wunsch, CS_AES128_GCM_SHA256);
    poke64(wunsch + 8, CS_CHACHA20_SHA256);
    poke64(wunsch + 16, CS_AES256_GCM_SHA384);
    var w: int64 := 0;
    while (w < 3 && gewaehlt == 0) {
        var k: int64 := 0;
        while (k < csLen) {
            if (r16(pos, p + k) == peek64(wunsch + w * 8)) { gewaehlt := peek64(wunsch + w * 8); }
            k += 2;
        }
        w += 1;
    }
    if (gewaehlt == 0) { return E_SUITE; }
    if (!suiteSetzen(c, gewaehlt)) { return E_SUITE; }

    // Ab hier die Erweiterungen. Der Abstand kommt aus dem Rahmen -- die
    // Kompressionsliste hat er schon uebersprungen und die Laengen geprueft.
    p := TkRahmenExtPos(rh);

    var el: int64 := pScr(c) + S_EL;
    // #2578: early_data im ClientHello ist leer und heisst nur "ich sende
    // fruehe Daten". Ob sie angenommen werden, entscheidet serverClientHello
    // — hier wird nur VERMERKT. Die Entscheidung braucht den PSK, und der
    // ist an dieser Stelle noch nicht geprueft.
    poke64(c + V_EDWUNSCH, 0);
    if (extSuchen(pos, p, len - p, EXT_EARLY, el) >= 0) {
        poke64(c + V_EDWUNSCH, 1);
    }
    // supported_versions muss 0x0304 enthalten
    var sv: int64 := extSuchen(pos, p, len - p, 43, el);
    if (sv < 0) { return E_VERSION; }
    var svLen: int64 := peek8(sv) & 0xFF;
    var gefunden: bool := false;
    var q: int64 := 1;
    while (q + 1 < 1 + svLen + 1) {
        if (r16(sv, q) == 0x0304) { gefunden := true; }
        q += 2;
    }
    if (!gefunden) { return E_VERSION; }

    // key_share: einen Anteil in einer erlaubten Gruppe suchen. Die
    // Reihenfolge ist die des Servers (x25519 vor secp256r1), nicht die des
    // Clients.
    var ks: int64 := extSuchen(pos, p, len - p, 51, el);
    if (ks < 0) { return E_GRUPPE; }
    var ksGesamt: int64 := r16(ks, 0);
    var habe: bool := false;
    var wunschG: int64 := 0;
    var wg: int64 := 0;
    while (wg < GRP_ANZAHL && !habe) {
        wunschG := gruppeNachRang(wg);
        if (gruppeErlaubt(c, wunschG)) {
            var r: int64 := 2;
            while (r + 4 <= 2 + ksGesamt && !habe) {
                var grp: int64 := r16(ks, r);
                var kl: int64 := r16(ks, r + 2);
                if (grp == wunschG) {
                    var pr: int64 := ksEintragPruefen(grp, ks + r + 4, kl);
                    if (pr != 0) { return pr; }
                    poke64(c + V_GRUPPE, wunschG);
                    var ziel: int64 := c + V_PEER_PK;
                    if (gruppenKurve(wunschG) >= 0) { ziel := c + V_EC_PEER; }
                    var j: int64 := 0;
                    while (j < kl) { poke8(ziel + j, peek8(ks + r + 4 + j)); j := j + 1; }
                    habe := true;
                }
                r := r + 4 + kl;
            }
        }
        wg += 1;
    }

    // Kein brauchbarer Anteil: nennt der Client in supported_groups eine
    // Gruppe, die wir koennen, wird ein HelloRetryRequest faellig (§4.1.4).
    // Sonst ist hier Schluss — und zwar mit Meldung, nicht mit stillem
    // Rueckfall auf etwas Plausibles.
    if (!habe) {
        var sg: int64 := extSuchen(pos, p, len - p, 10, el);
        if (sg < 0) { return E_GRUPPE; }
        var sgLen: int64 := r16(sg, 0);
        var gWahl: int64 := 0;
        var wg2: int64 := 0;
        while (wg2 < GRP_ANZAHL && gWahl == 0) {
            var kand: int64 := gruppeNachRang(wg2);
            if (gruppeErlaubt(c, kand)) {
                var t2: int64 := 2;
                while (t2 + 2 <= 2 + sgLen) {
                    if (r16(sg, t2) == kand) { gWahl := kand; }
                    t2 += 2;
                }
            }
            wg2 += 1;
        }
        if (gWahl == 0) { return E_GRUPPE; }
        if (peek64(c + V_HRR) != 0) { return E_HRR; }   // zweites HRR ist verboten
        poke64(c + V_GRUPPE, gWahl);
        poke64(c + V_HRR, 2);                            // HRR faellig
    }

    // pre_shared_key merken (#2577). Hier wird sie nur GEFUNDEN: der Binder
    // haengt am Anfang der ganzen Handschlagnachricht, und den kennt erst
    // der Aufrufer. Ausserdem muss psk_key_exchange_modes psk_dhe_ke
    // nennen — ohne frisches Diffie-Hellman gibt es keine
    // Vorwaertssicherheit, und dann nehmen wir den PSK gar nicht.
    poke64(c + V_PSKPOS, 0);
    poke64(c + V_PSKLEN, 0);
    poke64(c + V_PSKDA, 0);
    var pskm: int64 := extSuchen(pos, p, len - p, 45, el);
    var dheOk: bool := false;
    if (pskm >= 0 && peek64(el) >= 1) {
        var ml: int64 := peek8(pskm) & 0xFF;
        var mi: int64 := 0;
        while (mi < ml && mi + 1 < peek64(el)) {
            if ((peek8(pskm + 1 + mi) & 0xFF) == 1) { dheOk := true; }
            mi += 1;
        }
    }
    if (dheOk) {
        var pske: int64 := extSuchen(pos, p, len - p, 41, el);
        if (pske >= 0 && peek64(el) > 4) {
            poke64(c + V_PSKPOS, pske);
            poke64(c + V_PSKLEN, peek64(el));
        }
    }

    // #2579: Hat der Client status_request gesendet? Nur dann legt der Server
    // etwas bei -- unverlangt eine Antwort anzuhaengen waere Bytes fuer
    // niemanden, und RFC 8446 Paragraph 4.4.2.1 verlangt die Anfrage.
    // Der INHALT der Anfrage wird nicht ausgewertet: wir fuehren genau eine
    // Antwort, und eine responder_id_list waehlt daran nichts aus.
    poke64(c + V_OCSPWUNSCH, 0);
    if (extSuchen(pos, p, len - p, 5, el) >= 0) {
        poke64(c + V_OCSPWUNSCH, 1);
    }

    // signature_algorithms des Clients merken. Gewaehlt wird erst nach der
    // Kettenwahl (die Schluesselart kann vom SNI abhaengen), darum hier nur
    // Ort und Laenge der Liste.
    poke64(c + V_SIGLISTE, 0);
    poke64(c + V_SIGLISTELEN, 0);
    var sa: int64 := extSuchen(pos, p, len - p, 13, el);
    if (sa >= 0 && peek64(el) >= 2) {
        var saLen: int64 := r16(sa, 0);
        if (saLen > 0 && saLen + 2 <= peek64(el)) {
            poke64(c + V_SIGLISTE, sa + 2);
            poke64(c + V_SIGLISTELEN, saLen);
        }
    }

    // SNI aufbewahren: der Zeiger in den Empfangspuffer ueberlebt den
    // naechsten Record nicht, der Name wird aber fuer die Kettenwahl und von
    // der Anwendung gebraucht.
    poke64(c + V_SNILEN, 0);
    var sn: int64 := extSuchen(pos, p, len - p, 0, el);
    if (sn >= 0 && peek64(el) >= 5) {
        var listeLen2: int64 := r16(sn, 0);
        if ((peek8(sn + 2) & 0xFF) == 0 && listeLen2 >= 3) {
            var nl: int64 := r16(sn, 3);
            if (nl > 0 && nl <= 256 && 5 + nl <= peek64(el)) {
                var z: int64 := 0;
                while (z < nl) { poke8(c + V_SNIBUF + z, peek8(sn + 5 + z)); z += 1; }
                poke64(c + V_SNILEN, nl);
            }
        }
    }

    // ALPN: erste gemeinsame Kennung in der Reihenfolge des Servers
    var cfg: int64 := peek64(c + V_CFG);
    if (TlsCfgAlpn(cfg) != 0 && TlsCfgAlpnLen(cfg) > 0) {
        var ap: int64 := extSuchen(pos, p, len - p, 16, el);
        if (ap >= 0) {
            var listeLen: int64 := r16(ap, 0);
            var eigene: int64 := TlsCfgAlpn(cfg);
            var eigeneLen: int64 := TlsCfgAlpnLen(cfg);
            var start: int64 := 0;
            var idx: int64 := 0;
            while (idx <= eigeneLen && peek64(c + V_ALPNSELLEN) == 0) {
                if (idx == eigeneLen || (peek8(eigene + idx) & 0xFF) == 44) {
                    var l2: int64 := idx - start;
                    if (l2 > 0) {
                        // in der Liste des Clients suchen
                        var t: int64 := 2;
                        while (t < 2 + listeLen) {
                            var pl: int64 := peek8(ap + t) & 0xFF;
                            if (pl == l2 && CTMemEqual(ap + t + 1, eigene + start, l2) == -1) {
                                poke64(c + V_ALPNSEL, eigene + start);
                                poke64(c + V_ALPNSELLEN, l2);
                                t := 2 + listeLen;
                            } else {
                                t := t + 1 + pl;
                            }
                        }
                    }
                    start := idx + 1;
                }
                idx += 1;
            }
        }
    }
    return 0;
}

// Widerruf-Hook der Anwendung: bekommt den X509-Satz des Blattes, liefert 0
// fuer "gueltig". Der Umweg ueber int64 ist nötig, weil die Konfiguration ein
// reiner Byteblock ist.
type TlsWiderrufFn = fn(int64): int64;

fn widerrufRufen(f: TlsWiderrufFn, satz: int64): int64 { return f(satz); }

// Certificate: erstes Zertifikat lesen und die Kette pruefen.
fn certLesen(c: int64, pos: int64, len: int64, serverSeite: bool): int64 {
    if (len < 4) { return E_FORMAT; }
    var ctxLen: int64 := peek8(pos) & 0xFF;
    var p: int64 := 1 + ctxLen;
    if (p + 3 > len) { return E_FORMAT; }
    var listeLen: int64 := r24(pos, p);
    p += 3;
    if (p + listeLen > len) { return E_FORMAT; }

    var cfg: int64 := peek64(c + V_CFG);
    var kette: int64 := pScr(c) + S_KETTE;
    var n: int64 := 0;
    var ende: int64 := p + listeLen;
    // #2579: zuruecksetzen, BEVOR gesucht wird. Ein Verbindungsblock kann
    // wiederverwendet werden, und ein alter Zeiger waere hier schlimmer als
    // keiner: er zeigt in einen laengst ueberschriebenen Empfangspuffer, und
    // was dort steht, wuerde als Antwort der Gegenseite gelesen.
    poke64(c + V_OCSPPOS, 0);
    poke64(c + V_OCSPLEN, 0);
    while (p + 3 <= ende && n < 8) {
        var cl: int64 := r24(pos, p);
        p += 3;
        if (p + cl > ende) { return E_FORMAT; }
        poke64(kette + n * 16, pos + p);
        poke64(kette + n * 16 + 8, cl);
        n += 1;
        p += cl;
        if (p + 2 > ende) { return E_FORMAT; }
        var extL: int64 := r16(pos, p);
        // #2579: Die beigelegte OCSP-Antwort haengt am BLATT (RFC 8446
        // Paragraph 4.4.2.1). Hier wird nur Ort und Laenge gemerkt; geprueft
        // wird weiter unten, SOLANGE DER EMPFANGSPUFFER NOCH GUELTIG IST --
        // der Befund haelt Positionen hinein, keine Kopien.
        if (n == 1 && extL >= 4) {
            var ep: int64 := p + 2;
            var eEnde: int64 := ep + extL;
            while (ep + 4 <= eEnde) {
                var et: int64 := r16(pos, ep);
                var el2: int64 := r16(pos, ep + 2);
                if (ep + 4 + el2 > eEnde) { ep := eEnde; }
                else {
                    if (et == 5 && el2 >= 4) {
                        // CertificateStatus: status_type(1) + Laenge(3) + DER
                        if ((peek8(pos + ep + 4) & 0xFF) == 1) {
                            var ol: int64 := r24(pos, ep + 5);
                            if (ol > 0 && 4 + ol <= el2) {
                                poke64(c + V_OCSPPOS, pos + ep + 8);
                                poke64(c + V_OCSPLEN, ol);
                            }
                        }
                    }
                    ep := ep + 4 + el2;
                }
            }
        }
        p := p + 2 + extL;
    }
    if (n == 0) { return E_FORMAT; }

    // Das Blatt in den Verbindungsblock kopieren: der Satz lebt laenger als
    // der Empfangspuffer, aus dem es gerade stammt.
    var bl: int64 := peek64(kette + 8);
    if (bl > B_CERT) { return E_PUFFER; }
    var kop: int64 := 0;
    while (kop < bl) { poke8(pCert(c) + kop, peek8(peek64(kette) + kop)); kop += 1; }
    if (!X509Lies(pCert(c), bl, peek64(c + V_PEERCERT))) {
        return E_ZERTIFIKAT;
    }
    poke64(c + V_PEERCERTOK, 1);

    if (TlsCfgPruefen(cfg) != 0) {
        var host: int64 := 0;
        var hostLen: int64 := 0;
        var zweck: int64 := 2;                      // clientAuth
        if (!serverSeite) {
            host := TlsCfgHost(cfg);
            hostLen := TlsCfgHostLen(cfg);
            zweck := 1;                             // serverAuth
        }
        var rc: int64 := X509PruefeKette(kette, n, TlsCfgTrust(cfg),
                                         TlsCfgTrustN(cfg), host, hostLen,
                                         TlsCfgJetzt(cfg), zweck);
        if (rc != 0) { return E_ZERTIFIKAT; }
    }

    // #2579: Die beigelegte OCSP-Antwort. VOR dem Hook der Anwendung, weil
    // dies der eingebaute Beleg ist und der Hook die Anwendungsentscheidung.
    //
    // Die Unit liefert einen BEFUND, kein Urteil -- das Urteil steht in der
    // Vorgabe (0 aus, 1 weich, 2 hart). `revoked` beendet in BEIDEN
    // Pruefmodi: ein Widerruf ist eine Aussage, kein Zweifel. Alles andere
    // (fehlt, unleserlich, falsch signiert, fremde CertID, abgelaufen,
    // unknown) ist KEIN Beweis fuer Gueltigkeit und keiner fuer Widerruf --
    // und wird darum nur im harten Modus zum Abbruch.
    var ocspModus: int64 := TlsCfgOcspModus(cfg);
    if (ocspModus != 0 && !serverSeite) {
        var ocspGut: bool := false;
        var ocspWiderrufen: bool := false;
        var op: int64 := peek64(c + V_OCSPPOS);
        var ol2: int64 := peek64(c + V_OCSPLEN);
        if (op != 0 && ol2 > 0 && n >= 2) {
            var osatz: int64 := pOcspSatz(c);
            if (OcspLesen(op, ol2, osatz) == 0) {
                // Der Aussteller ist der ZWEITE Eintrag der Kette. Ohne ihn
                // ist die Antwort nicht pruefbar: CertID und Signatur haengen
                // beide an seinem Namen und Schluessel. Das certs-Feld der
                // Antwort wird dafuer NICHT genommen -- es kommt von der
                // Gegenseite und ist kein Vertrauensanker.
                var aus: int64 := pAussteller(c);
                if (X509Lies(peek64(kette + 16), peek64(kette + 24), aus)) {
                    if (OcspPasstZu(osatz, peek64(c + V_PEERCERT), aus)) {
                        if (OcspSignaturPruefen(osatz, aus) == 0) {
                            if (OcspZeitlichGueltig(osatz, TlsCfgJetzt(cfg), 300)) {
                                var cs: int64 := OcspCertStatus(osatz);
                                if (cs == OCSP_GOOD) { ocspGut := true; }
                                if (cs == OCSP_REVOKED) { ocspWiderrufen := true; }
                            } else {
                                // Abgelaufen, aber lesbar und richtig
                                // signiert: ein `revoked` darin bleibt eine
                                // Aussage ueber das Zertifikat.
                                if (OcspCertStatus(osatz) == OCSP_REVOKED) {
                                    ocspWiderrufen := true;
                                }
                            }
                        }
                    }
                }
            }
        }
        if (ocspWiderrufen) { return E_WIDERRUFEN; }
        if (ocspModus == 2 && !ocspGut) { return E_OCSP; }
    }

    // Widerruf (OCSP/CRL) macht die Anwendung: sie bekommt den geprueften
    // Satz des Blattes und entscheidet. 0 = gueltig.
    var hook: int64 := TlsCfgWiderruf(cfg);
    if (hook != 0) {
        if (widerrufRufen(hook as TlsWiderrufFn, peek64(c + V_PEERCERT)) != 0) {
            return E_WIDERRUFEN;
        }
    }
    return 0;
}

// CertificateVerify gegen den Schluessel aus dem Zertifikat der Gegenseite.
fn certVerifyLesen(c: int64, pos: int64, len: int64, gegenseiteIstServer: bool): int64 {
    if (len < 4) { return E_FORMAT; }
    var schema: int64 := r16(pos, 0);
    var sigLen: int64 := r16(pos, 2);
    if (4 + sigLen > len) { return E_FORMAT; }
    var sig: int64 := pos + 4;

    var satz: int64 := peek64(c + V_PEERCERT);
    if (peek64(c + V_PEERCERTOK) == 0) { return E_ABLAUF; }
    var der: int64 := X509DerPuffer(satz);
    var kPos: int64 := der + X509PubKeyPos(satz);
    var kLen: int64 := X509PubKeyLen(satz);
    var keyAlg: int64 := X509KeyAlg(satz);

    var scr: int64 := pScr(c);
    var inhalt: int64 := scr + S_SIG;
    var l: int64 := signaturInhalt(c, gegenseiteIstServer, inhalt);
    var hash: int64 := scr + S_HASH;

    if (schema == 0x0403) {
        if (keyAlg != 1 || kLen != 65 || (peek8(kPos) & 0xFF) != 4) { return E_UNTERSTUETZT; }
        var r: int64 := scr + S_R;
        var s: int64 := scr + S_S;
        SHA256(inhalt, l, hash);
        if (!EcdsaSigFromDer(sig, sigLen, r, s, 32)) { return E_SIGNATUR; }
        if (!EcdsaVerify(EC_P256, hash, kPos + 1, kPos + 33, r, s)) { return E_SIGNATUR; }
        return 0;
    }

    if (schema == 0x0503) {
        // keyAlg 2 ist secp384r1 (std.crypto.x509). Ein P-256-Schluessel
        // unter diesem Schema wird NICHT durchgelassen — sonst wuerde die
        // Kurve aus dem Signaturverfahren geraten statt aus dem Zertifikat
        // gelesen.
        if (keyAlg != 2 || kLen != 97 || (peek8(kPos) & 0xFF) != 4) {
            return E_UNTERSTUETZT;
        }
        var r3: int64 := scr + S_R;
        var s3: int64 := scr + S_S;
        Sha384(inhalt, l, hash);
        if (!EcdsaSigFromDer(sig, sigLen, r3, s3, 48)) { return E_SIGNATUR; }
        if (!EcdsaVerify(EC_P384, hash, kPos + 1, kPos + 49, r3, s3)) {
            return E_SIGNATUR;
        }
        return 0;
    }

    if (schema == 0x0804 || schema == 0x0805 || schema == 0x0806) {
        if (keyAlg != 3) { return E_UNTERSTUETZT; }
        if (!RsaPubAusDer(kPos, kLen, pRsa(c))) { return E_UNTERSTUETZT; }
        var hl: int64 := 32;
        if (schema == 0x0805) { hl := 48; }
        if (schema == 0x0806) { hl := 64; }
        if (hl == 32) { SHA256(inhalt, l, hash); }
        if (hl == 48) { Sha384(inhalt, l, hash); }
        if (hl == 64) { Sha512(inhalt, l, hash); }
        if (!RsaVerifyPss(pRsa(c), hl, hash, sig, sigLen)) { return E_SIGNATUR; }
        return 0;
    }

    if (schema == 0x0807) {
        if (keyAlg != 4 || kLen != 32) { return E_UNTERSTUETZT; }
        if (sigLen != 64) { return E_SIGNATUR; }
        if (!Ed25519Verify(sig, inhalt, l, kPos)) { return E_SIGNATUR; }
        return 0;
    }

    // Alles andere — darunter rsa_pkcs1_*, das RFC 8446 §4.2.3 fuer
    // CertificateVerify ausdruecklich verbietet — wird abgewiesen.
    return E_UNTERSTUETZT;
}

fn finishedLesen(c: int64, pos: int64, len: int64, secret: int64): int64 {
    var hl: int64 := peek64(c + V_HASHLEN);
    // Eine falsche LAENGE ist ein Dekodierfehler, kein falscher Abschluss:
    // verify_data hat eine feste Groesse, eine andere Nachricht ist
    // verstuemmelt. Der Unterschied steht im Alert (decode_error gegen
    // decrypt_error) und wird von tlsfuzzer geprueft (#2096).
    if (len != hl) { return E_FORMAT; }
    var vd: int64 := pScr(c) + S_VD;
    if (!finishedWert(c, secret, vd)) { return E_FINISHED; }
    var gleich: int64 := CTMemEqual(vd, pos, hl);
    if (gleich != -1) { return E_FINISHED; }
    return 0;
}

