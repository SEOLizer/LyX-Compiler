// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Verteiler zwischen TLS 1.3 und TLS 1.2
//
// Diese Unit ist das gemeinsame Tor: die Anwendung stellt EINE Konfiguration
// auf, ruft TlsNeu/TlsSchritt/TlsLese/TlsSchreibe und bekommt die Version,
// auf die sich beide Seiten einigen. TLS 1.2 muss dafuer ausdruecklich
// freigeschaltet sein (TlsConfigMinVersion), sonst gibt es nur 1.3 — so
// verlangt es #2096.
//
// Uebergeben wird NICHT der Zustand, sondern der angefangene Handschlag:
//   Server: das ClientHello liegt noch unausgepackt im Eingangspuffer. Steht
//           darin kein supported_versions mit 0x0304, wird alles Rohmaterial
//           an die 1.2-Maschine gefuettert und diese fuehrt den Handschlag
//           von Anfang an.
//   Client: das ClientHello ist schon gesendet und in O_CH aufbewahrt. Die
//           1.2-Maschine uebernimmt Zufallswort, Gruppe, Schluesselpaar und
//           die gesendeten Byte (Tls12UebernehmenClient) und bekommt dann die
//           bereits ausgepackten Handschlagbyte (Tls12FuetterHandschlag)
//           sowie den noch rohen Rest des Eingangspuffers.
// ---------------------------------------------------------------------------

// Sucht im Erweiterungsblock eines ClientHello nach supported_versions und
// sagt, ob 0x0304 darin steht. Arbeitet auf den ROHEN Byte einer
// Handschlagnachricht (ohne Recordkopf).
fn chBietet13(ch: int64, len: int64, elPtr: int64): bool {
    if (len < 38) { return false; }
    var sidLen: int64 := peek8(ch + 34) & 0xFF;
    if (sidLen > 32) { return false; }
    var p: int64 := 35 + sidLen;
    if (p + 2 > len) { return false; }
    var csLen: int64 := r16(ch, p);
    p := p + 2 + csLen;
    if (p + 1 > len) { return false; }
    var compLen: int64 := peek8(ch + p) & 0xFF;
    p := p + 1 + compLen;
    if (p + 2 > len) { return false; }
    var sv: int64 := extSuchen(ch, p, len - p, 43, elPtr);
    if (sv < 0) { return false; }
    var svLen: int64 := peek8(sv) & 0xFF;
    var q: int64 := 1;
    var gefunden: bool := false;
    while (q + 1 < 1 + svLen + 1) {
        if (r16(sv, q) == 0x0304) { gefunden := true; }
        q += 2;
    }
    return gefunden;
}

// Server: steht im Eingangspuffer ein vollstaendiges ClientHello, das kein
// TLS 1.3 anbietet? Dann uebernimmt die 1.2-Maschine.
// Rueckgabe: 1 uebergeben, 0 noch nichts zu entscheiden, <0 Fehler.
// Traegt dieses ClientHello die genannte Erweiterung? Dieselbe Wanderung
// durch den Rumpf wie chBietet13 — der Unterschied ist nur die Nummer.
fn chExtDa(ch: int64, len: int64, typ: int64, elPtr: int64): bool {
    if (len < 38) { return false; }
    var sidLen: int64 := peek8(ch + 34) & 0xFF;
    if (sidLen > 32) { return false; }
    var p: int64 := 35 + sidLen;
    if (p + 2 > len) { return false; }
    var csLen: int64 := r16(ch, p);
    p := p + 2 + csLen;
    if (p + 1 > len) { return false; }
    var compLen: int64 := peek8(ch + p) & 0xFF;
    p := p + 1 + compLen;
    if (p + 2 > len) { return false; }
    return extSuchen(ch, p, len - p, typ, elPtr) >= 0;
}

fn verteilerServer(c: int64): int64 {
    var cfg: int64 := peek64(c + V_CFG);
    if (!TlsCfgErlaubt12(cfg)) { return 0; }
    var vorhanden: int64 := peek64(c + V_INPOS);
    if (vorhanden < 5) { return 0; }
    var b: int64 := pIn(c);
    if ((peek8(b) & 0xFF) != RT_HANDSHAKE) { return 0; }
    var len: int64 := ((peek8(b + 3) & 0xFF) << 8) | (peek8(b + 4) & 0xFF);
    if (vorhanden < 5 + len) { return 0; }          // noch nicht ganz da
    if (len < 4) { return 0; }
    if ((peek8(b + 5) & 0xFF) != HS_CLIENT_HELLO) { return 0; }
    var chLen: int64 := r24(b + 5, 1);
    if (chLen + 4 > len) { return 0; }
    var el: int64 := pScr(c) + S_EL;
    // Auf 1.2 wird umgeschaltet, wenn der Client KEIN 1.3 anbietet oder wenn
    // WIR keines erlauben (TlsConfigMaxVersion). Beides einzeln geprueft: ein
    // Server mit abgeschaltetem 1.3 darf nicht doch 1.3 sprechen, bloss weil
    // der Client es anbietet.
    if (TlsCfgErlaubt13(cfg) && chBietet13(b + 9, chLen, el)) { return 0; }
    // #2578: Hat das ClientHello fruehe Daten angeboten und wird auf TLS 1.2
    // umgeschaltet, liegen hinter dem ClientHello Records, die NIEMAND lesen
    // kann: sie stehen unter einem 1.3-Schluessel, und die 1.2-Maschine
    // kennt weder ihn noch 0-RTT. Sie werden hier entfernt, nicht
    // weitergegeben — sonst sieht die 1.2-Maschine Anwendungsdaten vor dem
    // Handschlag und bricht ab. Gemessen an tlsfuzzer
    // test-tls13-0rtt-garbage ("invalid 0-RTT and unknown version (downgrade
    // to TLS 1.2)").
    if (chExtDa(b + 9, chLen, EXT_EARLY, el)) {
        var schreib: int64 := 5 + len;
        var lese: int64 := 5 + len;
        var geworfen: int64 := 0;
        while (lese + 5 <= vorhanden) {
            var rtyp: int64 := peek8(b + lese) & 0xFF;
            var rlen: int64 := ((peek8(b + lese + 3) & 0xFF) << 8)
                             |  (peek8(b + lese + 4) & 0xFF);
            if (lese + 5 + rlen > vorhanden) {
                lese := vorhanden;          // unvollstaendig: liegen lassen
            } else {
                if (rtyp == RT_APPDATA) {
                    geworfen := geworfen + 1;
                } else {
                    var kv: int64 := 0;
                    while (kv < 5 + rlen) {
                        poke8(b + schreib + kv, peek8(b + lese + kv));
                        kv := kv + 1;
                    }
                    schreib := schreib + 5 + rlen;
                }
                lese := lese + 5 + rlen;
            }
        }
        poke64(c + V_SKIPZAHL, peek64(c + V_SKIPZAHL) + geworfen);
        vorhanden := schreib;
    }

    var c12: int64 := Tls12Neu(cfg);
    if (c12 == 0) { return E_KONFIG; }
    // ALLES Rohmaterial weitergeben; die 1.2-Maschine packt selbst aus.
    if (Tls12Fuetter(c12, b, vorhanden) != vorhanden) {
        Tls12Frei(c12);
        return E_PUFFER;
    }
    poke64(c + V_INPOS, 0);
    poke64(c + V_12, c12);
    return 1;
}

// Client: das ServerHello liegt schon ausgepackt im Handschlagpuffer. Sagt
// es nicht 0x0304, uebernimmt die 1.2-Maschine den angefangenen Handschlag.
fn verteilerClient(c: int64): int64 {
    var cfg: int64 := peek64(c + V_CFG);
    if (!TlsCfgErlaubt12(cfg)) { return 0; }
    var tp: int64 := pScr(c) + S_TP;
    var pp: int64 := pScr(c) + S_PP;
    var lp: int64 := pScr(c) + S_LP;
    if (!hsAnsehen(c, tp, pp, lp)) { return 0; }
    if (peek64(tp) != HS_SERVER_HELLO) { return 0; }
    var pos: int64 := peek64(pp);
    var len: int64 := peek64(lp);
    if (len < 38) { return 0; }
    var sidLen: int64 := peek8(pos + 34) & 0xFF;
    if (sidLen > 32) { return 0; }
    var q: int64 := 35 + sidLen + 3;
    var el: int64 := pScr(c) + S_EL;
    var ist13: bool := false;
    if (len > q) {
        var sv: int64 := extSuchen(pos, q, len - q, 43, el);
        if (sv >= 0 && peek64(el) == 2 && r16(sv, 0) == 0x0304) { ist13 := true; }
    }
    if (ist13) { return 0; }

    var c12: int64 := Tls12Neu(cfg);
    if (c12 == 0) { return E_KONFIG; }
    var grp: int64 := peek64(c + V_GRUPPE);
    if (!Tls12UebernehmenClient(c12, c + V_RANDOM, grp, c + V_EPH_SK,
                                gruppenPk(c), pCh(c), peek64(c + V_CHLEN))) {
        Tls12Frei(c12);
        return E_VERSION;
    }
    // die schon ausgepackten Handschlagbyte (ServerHello und was mit im
    // Record stand) weitergeben ...
    var hsOffen: int64 := peek64(c + V_HSPOS) - peek64(c + V_HSGELESEN);
    if (hsOffen > 0) {
        if (Tls12FuetterHandschlag(c12, pHs(c) + peek64(c + V_HSGELESEN),
                                   hsOffen) != 0) {
            Tls12Frei(c12);
            return E_PUFFER;
        }
    }
    poke64(c + V_HSPOS, 0);
    poke64(c + V_HSGELESEN, 0);
    // ... und den noch rohen Rest des Eingangspuffers.
    var roh: int64 := peek64(c + V_INPOS);
    if (roh > 0) {
        if (Tls12Fuetter(c12, pIn(c), roh) != roh) {
            Tls12Frei(c12);
            return E_PUFFER;
        }
        poke64(c + V_INPOS, 0);
    }
    poke64(c + V_12, c12);
    return 1;
}

// Welcher Alert gehoert zu welchem Fehler (RFC 8446 §6.2, RFC 5246 §7.2)?
// 0 heisst "keiner" — das gilt fuer die Faelle, in denen die GEGENSEITE
// einen Alert geschickt hat.
fn alertFuer(rc: int64): int64 {
    if (rc == E_FORMAT)       { return 50; }   // decode_error
    if (rc == E_VERSION)      { return 70; }   // protocol_version
    if (rc == E_SUITE)        { return 40; }   // handshake_failure
    if (rc == E_GRUPPE)       { return 40; }
    if (rc == E_ENTSCHLUESS)  { return 20; }   // bad_record_mac
    if (rc == E_ZERTIFIKAT)   { return 42; }   // bad_certificate
    if (rc == E_SIGNATUR)     { return 51; }   // decrypt_error
    if (rc == E_FINISHED)     { return 51; }
    if (rc == E_ABLAUF)       { return 10; }   // unexpected_message
    if (rc == E_PUFFER)       { return 22; }   // record_overflow
    if (rc == E_KONFIG)       { return 80; }   // internal_error
    if (rc == E_UNTERSTUETZT) { return 40; }
    if (rc == E_WIDERRUFEN)   { return 44; }   // certificate_revoked
    if (rc == E_HRR)          { return 47; }   // illegal_parameter
    if (rc == E_PARAM)        { return 47; }
    return 0;
}

fn fehlerSetzen(c: int64, rc: int64): int64 {
    // Ein fataler Fehler MUSS der Gegenseite als Alert gesagt werden, sonst
    // sieht sie nur eine abgeschnittene Verbindung und raet. tlsfuzzer
    // (#2096) wartet an vielen Stellen genau darauf; ohne Alert lief es dort
    // in sein Zeitlimit.
    //
    // Nur einmal: ist der Zustand schon Z_FEHLER, ist der Alert heraus.
    if (peek64(c + V_ZUSTAND) != Z_FEHLER) {
        var a: int64 := alertFuer(rc);
        if (a != 0) { alertSenden(c, 2, a); }
    }
    poke64(c + V_ZUSTAND, Z_FEHLER);
    poke64(c + V_FEHLER, rc);
    return rc;
}

fn clientStart(c: int64): int64 {
    if (!eigeneWerte(c, true)) { return fehlerSetzen(c, E_KONFIG); }
    var rc: int64 := clientHelloSenden(c);
    if (rc != 0) { return fehlerSetzen(c, rc); }

    // #2578: Hat das ClientHello early_data angeboten, steht ab jetzt der
    // fruehe Schreibschluessel. Erst danach darf TlsSchreibeFrueh etwas
    // senden — und genau darum wird hier gestellt und nicht beim ersten
    // Schreibaufruf: ein Aufrufer, der zu frueh schreibt, bekaeme sonst
    // Klartext auf die Leitung.
    if (peek64(c + V_EDZUSTAND) == 1) {
        // Die Suite des TICKETS gilt vorlaeufig. Ohne sie ist V_HASHLEN 0,
        // und verkehrsSchluessel koennte den Schluessel nicht bilden. Waehlt
        // der Server eine andere Suite, nimmt er den PSK nicht an, und die
        // fruehen Daten sind damit abgelehnt — serverHelloLesen setzt die
        // Suite dann neu.
        if (!suiteSetzen(c, peek64(c + V_TKTSUITE))) {
            poke64(c + V_EDZUSTAND, 0);
            poke64(c + V_ZUSTAND, Z_WARTE_SH);
            return TlsWantRead();
        }
        var hlT: int64 := peek64(c + V_TKTHL);
        if (!planFrueh(c, hlT, c + V_TKTPSK, hlT, pCh(c), peek64(c + V_CHLEN))) {
            return fehlerSetzen(c, E_KONFIG);
        }
        if (!schreibSchluessel(c, c + V_SEC_CET, 3)) { return fehlerSetzen(c, E_KONFIG); }
    }

    poke64(c + V_ZUSTAND, Z_WARTE_SH);
    return TlsWantRead();
}

fn clientServerHello(c: int64): int64 {
    var tp: int64 := pScr(c) + S_TP;
    var pp: int64 := pScr(c) + S_PP;
    var lp: int64 := pScr(c) + S_LP;
    if (!hsAnsehen(c, tp, pp, lp)) { return TlsWantRead(); }
    if (peek64(tp) != HS_SERVER_HELLO) { return fehlerSetzen(c, E_ABLAUF); }
    var rc: int64 := serverHelloLesen(c, peek64(pp), peek64(lp));
    if (rc < 0) { return fehlerSetzen(c, rc); }

    if (rc == 1) {
        // HelloRetryRequest (§4.1.4): Transkript auf message_hash umstellen,
        // neues Schluesselpaar in der verlangten Gruppe, ClientHello2.
        transkriptMessageHash(c, pCh(c), peek64(c + V_CHLEN));
        hsVerbrauchen(c, peek64(lp), true);
        poke64(c + V_HRR, 1);
        if (!gruppenPaar(c)) { return fehlerSetzen(c, E_KONFIG); }
        // ClientHello2 geht diesmal direkt in den Hash: die Suite steht fest.
        var rc2: int64 := clientHello2Senden(c);
        if (rc2 != 0) { return fehlerSetzen(c, rc2); }
        return 0;
    }

    // Jetzt steht die Suite fest: Transkript beginnt mit dem aufbewahrten
    // ClientHello, dann das ServerHello. Nach einem HRR laeuft der Hash
    // bereits (message_hash, HRR, ClientHello2) und darf NICHT neu beginnen.
    if (peek64(c + V_HRR) == 0) {
        hashInit(c);
        hashUpdate(c, pCh(c), peek64(c + V_CHLEN));
    }
    hsVerbrauchen(c, peek64(lp), true);

    if (!gruppenGeheimnis(c)) { return fehlerSetzen(c, E_GRUPPE); }
    // Dieselbe Weiche wie auf der Serverseite — die beiden muessen
    // uebereinstimmen, sonst rechnen sie verschiedene Schluessel und das
    // Finished scheitert.
    var planOkC: bool := false;
    if (peek64(c + V_PSKDA) == 1) {
        planOkC := planHandschlagPsk(c, c + V_TKTPSK, peek64(c + V_TKTHL));
    } else {
        planOkC := planHandschlag(c);
    }
    if (!planOkC) { return fehlerSetzen(c, E_KONFIG); }
    if (!leseSchluessel(c, c + V_SEC_SHS, 1)) { return fehlerSetzen(c, E_KONFIG); }
    // #2578: Hat der Client fruehe Daten angeboten, bleibt der
    // SCHREIBschluessel auf dem fruehen Geheimnis. Er braucht ihn noch fuer
    // das end_of_early_data (§4.5: "MUST be encrypted with the 0-RTT traffic
    // keys"), und zwischen ServerHello und EncryptedExtensions sendet der
    // Client nichts. Umgestellt wird entweder beim Ablehnen oder nach dem
    // end_of_early_data — beide Stellen stehen in clientHandschlag.
    if (peek64(c + V_EDZUSTAND) != 1) {
        if (!schreibSchluessel(c, c + V_SEC_CHS, 1)) { return fehlerSetzen(c, E_KONFIG); }
    }
    poke64(c + V_ZUSTAND, Z_WARTE_HS);
    return 0;
}

fn clientHandschlag(c: int64): int64 {
    var cfg: int64 := peek64(c + V_CFG);
    var tp: int64 := pScr(c) + S_TP;
    var pp: int64 := pScr(c) + S_PP;
    var lp: int64 := pScr(c) + S_LP;
    var el: int64 := pScr(c) + S_EL;

    while (hsAnsehen(c, tp, pp, lp)) {
        var typ: int64 := peek64(tp);
        var pos: int64 := peek64(pp);
        var len: int64 := peek64(lp);

        if (typ == HS_EE) {
            // ALPN-Auswahl des Servers uebernehmen
            var ap: int64 := extSuchen(pos, 0, len, 16, el);
            if (ap >= 0 && peek64(el) >= 4) {
                var pl: int64 := peek8(ap + 2) & 0xFF;
                if (pl > 32) { pl := 32; }
                var z2: int64 := 0;
                while (z2 < pl) { poke8(c + V_ALPNBUF + z2, peek8(ap + 3 + z2)); z2 += 1; }
                poke64(c + V_ALPNSEL, c + V_ALPNBUF);
                poke64(c + V_ALPNSELLEN, pl);
            }
            // #2578: early_data in den EncryptedExtensions heisst
            // ANGENOMMEN (§4.2.10). Fehlt sie, sind die fruehen Daten
            // abgelehnt, und der Schreibschluessel wechselt sofort — es
            // folgt kein end_of_early_data.
            if (peek64(c + V_EDZUSTAND) == 1) {
                var edp: int64 := extSuchen(pos, 0, len, EXT_EARLY, el);
                if (edp >= 0) {
                    poke64(c + V_EDZUSTAND, 2);
                } else {
                    poke64(c + V_EDZUSTAND, 3);
                    if (!schreibSchluessel(c, c + V_SEC_CHS, 1)) {
                        return fehlerSetzen(c, E_KONFIG);
                    }
                }
            }
            hsVerbrauchen(c, len, true);
        } else {
        if (typ == HS_CERT_REQUEST) {
            poke64(c + V_CERTREQ, 1);
            hsVerbrauchen(c, len, true);
        } else {
        if (typ == HS_CERT) {
            var rc: int64 := certLesen(c, pos, len, false);
            if (rc != 0) { return fehlerSetzen(c, rc); }
            hsVerbrauchen(c, len, true);
        } else {
        if (typ == HS_CERT_VERIFY) {
            var rc2: int64 := certVerifyLesen(c, pos, len, true);
            if (rc2 != 0) { return fehlerSetzen(c, rc2); }
            hsVerbrauchen(c, len, true);
        } else {
        if (typ == HS_FINISHED) {
            var rc3: int64 := finishedLesen(c, pos, len, c + V_SEC_SHS);
            if (rc3 != 0) { return fehlerSetzen(c, rc3); }
            hsVerbrauchen(c, len, true);

            // Die Anwendungsgeheimnisse haengen am Transkript BIS zum
            // Server-Finished (§7.1) — darum hier, vor dem eigenen Finished.
            if (!planAnwendung(c)) { return fehlerSetzen(c, E_KONFIG); }

            // Dummy-CCS unmittelbar vor dem zweiten Flug (Anhang D.4). Es
            // geht im Klartext hinaus, obwohl die Schreibstufe schon steht.
            var rcc: int64 := ccsDummySenden(c);
            if (rcc != 0) { return fehlerSetzen(c, rcc); }

            // #2578: end_of_early_data (§4.5) — ZUERST, noch unter dem
            // fruehen Schluessel, und danach erst der Wechsel auf den
            // Handschlagschluessel. Die Nachricht gehoert ins Transkript
            // (§4.4.1 zaehlt sie zwischen EncryptedExtensions und dem
            // Finished des Clients auf); wer sie auslaesst, rechnet ein
            // anderes verify_data als der Server.
            if (peek64(c + V_EDZUSTAND) == 2 && peek64(c + V_EOEDGES) == 0) {
                var leerE: int64 := pScr(c) + S_K1;
                var rcE: int64 := hsSenden(c, HS_EOED, leerE, 0);
                if (rcE != 0) { return fehlerSetzen(c, rcE); }
                poke64(c + V_EOEDGES, 1);
                if (!schreibSchluessel(c, c + V_SEC_CHS, 1)) {
                    return fehlerSetzen(c, E_KONFIG);
                }
            }

            if (peek64(c + V_CERTREQ) != 0) {
                if (TlsCfgCert(cfg) != 0 && TlsCfgCertN(cfg) > 0) {
                    var rc4: int64 := certSenden(c);
                    if (rc4 == 0) { rc4 := certVerifySenden(c, false); }
                    if (rc4 != 0) { return fehlerSetzen(c, rc4); }
                } else {
                    // Leeres Certificate ist die vorgesehene Antwort, wenn man
                    // keines hat (§4.4.2) — der Server entscheidet dann.
                    var leer: int64 := pScr(c) + S_K1;
                    poke8(leer, 0); poke8(leer + 1, 0); poke8(leer + 2, 0); poke8(leer + 3, 0);
                    hsSenden(c, HS_CERT, leer, 4);
                }
            }

            var rc5: int64 := finishedSenden(c, c + V_SEC_CHS);
            if (rc5 != 0) { return fehlerSetzen(c, rc5); }
            // Dasselbe Geheimnis wie auf der Serverseite, an derselben
            // Transkriptstelle: finishedSenden hat das eigene Finished
            // gerade in den Hash gelegt (#2577). Wer es eine Zeile frueher
            // bildet, bekommt eine andere Zahl als die Gegenseite — und
            // merkt es erst am Binder einer spaeteren Verbindung.
            if (!planWiederaufnahme(c)) { return fehlerSetzen(c, E_KONFIG); }
            if (!leseSchluessel(c, c + V_SEC_SAP, 2)) { return fehlerSetzen(c, E_KONFIG); }
            if (!schreibSchluessel(c, c + V_SEC_CAP, 2)) { return fehlerSetzen(c, E_KONFIG); }
            poke64(c + V_ZUSTAND, Z_FERTIG);
            return 0;
        } else {
        if (typ == HS_NEW_TICKET) {
            // Seit #2577 wird es gelesen. Es geht NICHT ins Transkript
            // (§4.4.1: der Hash endet mit dem Finished), darum
            // hsVerbrauchen mit false.
            var rct: int64 := ticketLesen(c, pos, len);
            hsVerbrauchen(c, len, false);
            if (rct < 0) { return fehlerSetzen(c, rct); }
        } else {
            return fehlerSetzen(c, E_ABLAUF);
        } } } } } }
    }
    return TlsWantRead();
}

fn serverClientHello(c: int64): int64 {
    var cfg: int64 := peek64(c + V_CFG);
    var tp: int64 := pScr(c) + S_TP;
    var pp: int64 := pScr(c) + S_PP;
    var lp: int64 := pScr(c) + S_LP;
    if (!hsAnsehen(c, tp, pp, lp)) { return TlsWantRead(); }
    if (peek64(tp) != HS_CLIENT_HELLO) { return fehlerSetzen(c, E_ABLAUF); }
    var zweites: bool := peek64(c + V_ZUSTAND) == Z_WARTE_CH2;
    // #2578: Mit dem zweiten ClientHello ist die fruehe Phase vorbei. Das
    // Verwerfen unlesbarer Records MUSS hier enden, sonst wird ein spaeterer
    // echter Entschluesselungsfehler still uebergangen — tlsfuzzer prueft
    // genau das ("0-RTT, HRR and early data after 2nd Client Hello" erwartet
    // bad_record_mac fuer einen Klartextrecord nach dem Handschlag).
    if (zweites) { poke64(c + V_SKIPUNDEC, 0); }
    var rc: int64 := clientHelloLesen(c, peek64(pp), peek64(lp));
    if (rc != 0) { return fehlerSetzen(c, rc); }
    // Nach einem HRR muss das ClientHello2 genau die verlangte Gruppe
    // bringen; alles andere ist ein Protokollfehler, kein Verhandeln.
    if (zweites && peek64(c + V_GRUPPE) != peek64(c + V_HRRGRP)) {
        return fehlerSetzen(c, E_HRR);
    }

    // pre_shared_key auswerten (#2577). HIER, weil der Binder ueber den
    // Anfang der GANZEN Handschlagnachricht rechnet — peek64(pp) zeigt auf
    // den Rumpf, der Kopf liegt vier Byte davor.
    if (peek64(c + V_PSKPOS) != 0) {
        var chAnf: int64 := peek64(pp) - 4;
        var rcp: int64 := pskAnnehmen(c, chAnf, peek64(lp) + 4,
                                      peek64(c + V_PSKPOS), peek64(c + V_PSKLEN));
        if (rcp < 0) { return fehlerSetzen(c, rcp); }
        poke64(c + V_PSKDA, rcp);
    }

    // ── 0-RTT: annehmen oder ablehnen (#2578) ────────────────────────────
    //
    // HIER und nicht weiter unten, weil beides noch die ClientHello-Byte
    // braucht: das fruehe Geheimnis rechnet ueber sie, und hsVerbrauchen
    // raeumt sie gleich weg.
    //
    // Angenommen wird nur, wenn ALLES zusammenkommt:
    //   * der Client hat early_data angeboten,
    //   * der PSK ist angenommen (ohne Wiederaufnahme gibt es kein 0-RTT),
    //   * die Vorgabe erlaubt es UND ein Wiederholungsschutz steht
    //     (TlsCfgFruehAn prueft beides zusammen),
    //   * das Ticket ist innerhalb des Fensters ausgestellt (§8.2) und
    //   * weder das Ticket noch dieses ClientHello wurden schon gesehen.
    //
    // Fehlt eines davon, wird abgelehnt — nicht abgebrochen. Ein abgelehntes
    // 0-RTT ist ein gueltiger Handschlag (§4.2.10), und der Client sendet
    // seine Daten danach normal.
    // Nach einem HelloRetryRequest gibt es kein 0-RTT (§4.2.10): der Client
    // darf dann keine fruehen Daten senden, und ein Server, der sie
    // trotzdem annimmt, rechnet mit einem Transkript, das die Gegenseite
    // nicht hat. V_HRR == 2 heisst "HRR faellig" und ist hier schon gesetzt
    // (clientHelloLesen hat die Gruppen bewertet).
    if (peek64(c + V_EDWUNSCH) == 1 && peek64(c + V_PSKDA) == 1
        && peek64(c + V_HRR) != 2 && !zweites
        && TlsCfgFruehAn(cfg)) {
        var jetztE: int64 := TlsCfgJetzt(cfg);
        var alterE: int64 := jetztE - peek64(c + V_TKTAUSZEIT);
        if (alterE >= 0 && alterE <= TlsCfgArFenster(cfg)) {
            // Zwei Kennungen, zwei Luecken (RFC 8446 §8.1 und §8.2):
            //   Ticketkennung  macht das Ticket EINMALIG — eine Wiederholung
            //                  mit demselben Ticket und anderem ClientHello
            //                  faellt damit auch.
            //   ClientHello    faengt die Wiederholung des IDENTISCHEN Flugs
            //                  innerhalb des Fensters.
            // Mit nur einer von beiden bliebe die jeweils andere Luecke
            // offen; darum beide, und 0-RTT nur, wenn BEIDE neu sind.
            var rid: int64 := pScr(c) + S_ARID;
            poke8(rid, 2);
            var ri: int64 := 0;
            while (ri < 15) { poke8(rid + 1 + ri, peek8(c + V_PEER_RAND + ri)); ri := ri + 1; }
            var neuT: int64 := TlsArVermerken(cfg, c + V_TKTID, jetztE);
            var neuR: int64 := TlsArVermerken(cfg, rid, jetztE);
            if (neuT == 1 && neuR == 1) {
                var hlE: int64 := peek64(c + V_TKTHL);
                if (planFrueh(c, hlE, c + V_TKTPSK, hlE,
                              peek64(pp) - 4, peek64(lp) + 4)) {
                    poke64(c + V_EDZUSTAND, 2);
                    poke64(c + V_EDMAX, TlsCfgFruehMax(cfg));
                }
            }
        }
    }
    if (peek64(c + V_EDZUSTAND) != 2 && peek64(c + V_EDWUNSCH) == 1) {
        // Abgelehnt, und der Client hat trotzdem schon gesendet: seine
        // Records liegen unter einem Schluessel, den dieser Server nicht
        // kennt. Sie MUESSEN verworfen werden koennen, ohne sie zu
        // entschluesseln (§4.2.10) — wie viele es sind, weiss niemand.
        poke64(c + V_EDZUSTAND, 3);
        poke64(c + V_SKIPUNDEC, 1);
    }

    // Kette nach SNI waehlen, bevor irgendetwas gesendet wird: ohne
    // brauchbare Kette gibt es keinen Handschlag.
    //
    // Bei angenommenem PSK entfaellt die Kette: der PSK IST die
    // Authentifizierung (§4.1.1), und ein Server, der dann trotzdem ein
    // Zertifikat verlangt, kann keine Wiederaufnahme.
    if (peek64(c + V_PSKDA) != 1) {
        rc := ketteWaehlen(c);
        if (rc != 0) { return fehlerSetzen(c, rc); }
        if (eigeneSchluesselart(c) == 0) { return fehlerSetzen(c, E_KONFIG); }
    }
    // Signaturverfahren aus der Liste des Clients waehlen, passend zum
    // Schluessel der gewaehlten Kette. Ohne gemeinsames Verfahren gibt es
    // keinen Handschlag — mit Alert, damit die Gegenseite den Grund erfaehrt
    // statt eine abgeschnittene Verbindung zu sehen.
    rc := schemaWaehlen(c, peek64(c + V_SIGLISTE), peek64(c + V_SIGLISTELEN));
    if (rc != 0) {
        alertSenden(c, 2, 40);                   // fatal handshake_failure
        return fehlerSetzen(c, rc);
    }

    // HelloRetryRequest faellig (§4.1.4): Transkript auf message_hash
    // umstellen, HRR senden, auf ClientHello2 warten.
    if (peek64(c + V_HRR) == 2) {
        if (zweites) { return fehlerSetzen(c, E_HRR); }
        poke64(c + V_HRR, 1);
        poke64(c + V_HRRGRP, peek64(c + V_GRUPPE));
        var chPos: int64 := peek64(pp) - 4;
        var chLen: int64 := peek64(lp) + 4;
        transkriptMessageHash(c, chPos, chLen);
        hsVerbrauchen(c, peek64(lp), false);
        var rh: int64 := hrrSenden(c);
        if (rh != 0) { return fehlerSetzen(c, rh); }
        // Dummy-CCS unmittelbar hinter der ERSTEN eigenen
        // Handschlagnachricht (Anhang D.4) — bei einem HelloRetryRequest ist
        // das der HRR. Bis #2578 ging es erst hinter dem ServerHello hinaus;
        // tlsfuzzer erwartet es an dieser Stelle (test-tls13-0rtt-garbage,
        // Faelle mit HRR), und der RFC-Text nennt ausdruecklich beide
        // Moeglichkeiten mit "immediately after its first handshake
        // message".
        var rhc: int64 := ccsDummySenden(c);
        if (rhc != 0) { return fehlerSetzen(c, rhc); }
        poke64(c + V_ZUSTAND, Z_WARTE_CH2);
        return 0;
    }

    if (!eigeneWerte(c, false)) { return fehlerSetzen(c, E_KONFIG); }

    // Nach einem HRR laeuft der Hash schon (message_hash, HRR) und darf
    // nicht neu beginnen.
    if (!zweites) { hashInit(c); }
    hsVerbrauchen(c, peek64(lp), true);

    rc := serverHelloSenden(c);
    if (rc != 0) { return fehlerSetzen(c, rc); }
    // Dummy-CCS zwischen ServerHello und verschluesseltem Flug (D.4).
    rc := ccsDummySenden(c);
    if (rc != 0) { return fehlerSetzen(c, rc); }

    if (!gruppenGeheimnis(c)) { return fehlerSetzen(c, E_GRUPPE); }
    // Bei angenommenem PSK tritt er an die Stelle des Nullgeheimnisses
    // (§7.1) — das ist der EINZIGE Unterschied im ganzen Plan.
    var planOk: bool := false;
    if (peek64(c + V_PSKDA) == 1) {
        planOk := planHandschlagPsk(c, c + V_TKTPSK, peek64(c + V_TKTHL));
    } else {
        planOk := planHandschlag(c);
    }
    if (!planOk) { return fehlerSetzen(c, E_KONFIG); }
    if (!schreibSchluessel(c, c + V_SEC_SHS, 1)) { return fehlerSetzen(c, E_KONFIG); }
    // #2578: Bei angenommenen fruehen Daten liest der Server zuerst mit dem
    // FRUEHEN Schluessel. Umgestellt wird beim end_of_early_data
    // (serverClientFinished) — und damit erzwingt die Entschluesselung die
    // Reihenfolge: ein Finished vor dem end_of_early_data liegt unter einem
    // anderen Schluessel und laesst sich hier gar nicht oeffnen.
    if (peek64(c + V_EDZUSTAND) == 2) {
        if (!leseSchluessel(c, c + V_SEC_CET, 3)) { return fehlerSetzen(c, E_KONFIG); }
    } else {
        if (!leseSchluessel(c, c + V_SEC_CHS, 1)) { return fehlerSetzen(c, E_KONFIG); }
    }

    rc := eeSenden(c);
    // Bei angenommenem PSK entfallen Certificate UND CertificateVerify
    // (§4.1.1: der PSK ist die Authentifizierung). Das ist nicht nur eine
    // Ersparnis — es ist das MESSBARE Merkmal einer Wiederaufnahme: fehlt
    // CertificateVerify im Flug, wurde wirklich wiederaufgenommen und nicht
    // nur schnell voll verhandelt.
    if (peek64(c + V_PSKDA) == 1) {
        if (rc == 0) { rc := finishedSenden(c, c + V_SEC_SHS); }
    } else {
        if (rc == 0 && TlsCfgClientAuth(cfg) != 0) { rc := certRequestSenden(c); }
        if (rc == 0) { rc := certSenden(c); }
        if (rc == 0) { rc := certVerifySenden(c, true); }
        if (rc == 0) { rc := finishedSenden(c, c + V_SEC_SHS); }
    }
    if (rc != 0) { return fehlerSetzen(c, rc); }

    if (!planAnwendung(c)) { return fehlerSetzen(c, E_KONFIG); }
    // Nur die Schreibrichtung wechselt jetzt; gelesen wird das
    // Client-Finished noch mit dem Handschlagschluessel (§4.4.4).
    if (!schreibSchluessel(c, c + V_SEC_SAP, 2)) { return fehlerSetzen(c, E_KONFIG); }
    poke64(c + V_ZUSTAND, Z_WARTE_CF);
    return 0;
}

fn serverClientFinished(c: int64): int64 {
    var cfg: int64 := peek64(c + V_CFG);
    var tp: int64 := pScr(c) + S_TP;
    var pp: int64 := pScr(c) + S_PP;
    var lp: int64 := pScr(c) + S_LP;

    while (hsAnsehen(c, tp, pp, lp)) {
        var typ: int64 := peek64(tp);
        var pos: int64 := peek64(pp);
        var len: int64 := peek64(lp);
        // #2578: end_of_early_data (§4.5). Es gehoert INS TRANSKRIPT und
        // steht dort zwischen den EncryptedExtensions und dem Finished des
        // Clients (§4.4.1) — wer es nur verwirft, rechnet ein anderes
        // verify_data als der Client. Danach wird der Leseschluessel auf
        // das Handschlaggeheimnis umgestellt; alles Weitere kommt von dort.
        if (typ == HS_EOED) {
            if (peek64(c + V_EDZUSTAND) != 2) { return fehlerSetzen(c, E_ABLAUF); }
            if (len != 0) { return fehlerSetzen(c, E_FORMAT); }
            hsVerbrauchen(c, len, true);
            poke64(c + V_EOEDEMP, 1);
            if (!leseSchluessel(c, c + V_SEC_CHS, 1)) { return fehlerSetzen(c, E_KONFIG); }
        } else {
        if (typ == HS_CERT) {
            // Leeres Certificate: der Client hat keines.
            var leerKette: bool := false;
            if (len >= 4) {
                var ctxLen: int64 := peek8(pos) & 0xFF;
                if (r24(pos, 1 + ctxLen) == 0) { leerKette := true; }
            }
            if (leerKette) {
                if (TlsCfgClientAuth(cfg) == 2) {
                    return fehlerSetzen(c, E_ZERTIFIKAT);
                }
            } else {
                var rc: int64 := certLesen(c, pos, len, true);
                if (rc != 0) { return fehlerSetzen(c, rc); }
            }
            hsVerbrauchen(c, len, true);
        } else {
        if (typ == HS_CERT_VERIFY) {
            var rc2: int64 := certVerifyLesen(c, pos, len, false);
            if (rc2 != 0) { return fehlerSetzen(c, rc2); }
            hsVerbrauchen(c, len, true);
        } else {
        if (typ == HS_FINISHED) {
            // #2578: Bei angenommenen fruehen Daten MUSS das
            // end_of_early_data vorher gekommen sein (§4.5). Praktisch
            // erzwingt das schon die Entschluesselung — das Finished liegt
            // unter dem Handschlagschluessel, und auf den wird erst beim
            // end_of_early_data umgestellt. Die Pruefung steht trotzdem da:
            // sie meldet den Ablauffehler statt eines Tagfehlers, und der
            // naechste Leser sucht dann nicht in der Krypto.
            if (peek64(c + V_EDZUSTAND) == 2 && peek64(c + V_EOEDEMP) == 0) {
                return fehlerSetzen(c, E_ABLAUF);
            }
            var rc3: int64 := finishedLesen(c, pos, len, c + V_SEC_CHS);
            if (rc3 != 0) { return fehlerSetzen(c, rc3); }
            hsVerbrauchen(c, len, true);
            if (TlsCfgClientAuth(cfg) == 2 && peek64(c + V_PEERCERTOK) == 0) {
                return fehlerSetzen(c, E_ZERTIFIKAT);
            }
            // Das Geheimnis fuer spaetere Wiederaufnahmen (#2577) entsteht
            // GENAU HIER: der Transkripthash enthaelt jetzt das Finished des
            // Clients, und nach RFC 8446 §7.1 ist das der Stand, mit dem
            // beide Seiten rechnen muessen.
            if (!planWiederaufnahme(c)) { return fehlerSetzen(c, E_KONFIG); }
            if (!leseSchluessel(c, c + V_SEC_CAP, 2)) { return fehlerSetzen(c, E_KONFIG); }
            poke64(c + V_ZUSTAND, Z_FERTIG);
            // Erst JETZT ein Ticket: es traegt das
            // resumption_master_secret, und das steht eine Zeile weiter
            // oben. Ohne Ticketschluessel in der Konfiguration tut
            // ticketSenden nichts und meldet 0 — ein Server ohne
            // Wiederaufnahme ist ein gueltiger Server (#2577).
            var rct: int64 := ticketSenden(c);
            if (rct < 0) { return fehlerSetzen(c, rct); }
            return 0;
        } else {
            return fehlerSetzen(c, E_ABLAUF);
        } } } }
    }
    return TlsWantRead();
}

// Ein Schritt der Zustandsmaschine mit dem, was schon im HS-Puffer liegt.
fn zustandSchritt(c: int64): int64 {
    var z: int64 := peek64(c + V_ZUSTAND);
    if (z == Z_WARTE_SH) { return clientServerHello(c); }
    if (z == Z_WARTE_HS) { return clientHandschlag(c); }
    if (z == Z_WARTE_CH) { return serverClientHello(c); }
    if (z == Z_WARTE_CH2) { return serverClientHello(c); }
    if (z == Z_WARTE_CF) { return serverClientFinished(c); }
    // Nach dem Handschlag wartende Handschlagnachrichten auch HIER
    // abarbeiten — NewSessionTicket und KeyUpdate.
    //
    // Bis #2577 geschah das nur in TlsLese. Damit bekam ein Client, der
    // nichts liest, sein Ticket nie: der Server schickt es unmittelbar nach
    // dem Client-Finished, also bevor irgendwelche Anwendungsdaten
    // anliegen. Gemessen in tests/tls_wiederaufnahme_test.sh — der Server
    // sendete (voll-nst 1), der Client merkte sich nichts.
    //
    // TlsSchritt heisst "bring den Zustand voran"; eine Nachricht liegen zu
    // lassen, bis die Anwendung zufaellig liest, widerspricht dem.
    if (z == Z_FERTIG) {
        if (peek64(c + V_HSPOS) > peek64(c + V_HSGELESEN)) {
            return nachHandschlag(c);
        }
    }
    return 0;
}

// Bringt den Handschlag so weit wie moeglich voran. Liefert 0 (fertig),
// TlsWantRead/TlsWantWrite oder einen negativen Fehlercode. Der Aufrufer
// schreibt dazwischen die Ausgabe weg (TlsAusgabe) und fuettert Gelesenes
// nach (TlsFuetter).
//
// Wichtig: es wird IMMER nur ein Record entschluesselt und dann die
// Zustandsmaschine gefragt. Wer stattdessen alle vorliegenden Records in
// einem Zug verarbeitet, versucht das EncryptedExtensions noch mit dem
// Schluesselstand von vor dem ServerHello zu lesen — der ganze Flug des
// Servers kommt in einem TCP-Segment.
pub fn TlsSchritt(c: int64): int64 {
    if (peek64(c + V_12) != 0) { return Tls12Schritt(peek64(c + V_12)); }
    var z: int64 := peek64(c + V_ZUSTAND);
    if (z == Z_FEHLER) { return peek64(c + V_FEHLER); }
    if (z == Z_FERTIG) { return 0; }
    if (z == Z_ZU) { return E_GESCHLOSSEN; }

    // #2647: Eine Pruefung, die bei fehlender Vertrauensliste stillschweigend
    // durchwinkt, ist schlechter als gar keine -- sie sieht von aussen aus wie
    // Sicherheit. Gemeldet wurde genau das: ein Client brachte den Handschlag
    // zu einem echten Server zu Ende, obwohl `TlsConfigTrust(cfg, t, 0)` ihm
    // KEINE Wurzel gab.
    //
    // Darum hier, VOR dem ersten Byte: ist die Kettenpruefung verlangt und ist
    // die Vertrauensliste leer, dann ist diese Verbindung nicht
    // authentifizierbar, egal was danach passiert. Das ist eine Aussage ueber
    // die KONFIGURATION und braucht keine Kenntnis der Ursache -- sie greift
    // deshalb auf jedem Ziel, auch dort, wo der eigentliche Befund noch offen
    // ist.
    //
    // Nur die CLIENTrolle: ein Server mit Vorgabe-Pruefung, der keine
    // Client-Zertifikate verlangt, braucht keine Vertrauensliste, und ihn hier
    // abzuweisen waere eine Verschaerfung ohne Befund. Wer die Pruefung
    // bewusst abschaltet (`TlsConfigKettePruefen(cfg, 0)`), ist nicht
    // betroffen -- dann ist die Lage dem Aufrufer bekannt.
    if (peek64(c + V_ROLLE) != 1) {
        var cfgP: int64 := peek64(c + V_CFG);
        if (TlsCfgPruefen(cfgP) != 0 && TlsCfgTrustN(cfgP) <= 0) {
            return fehlerSetzen(c, E_KONFIG);
        }
    }

    if (z == Z_START) {
        // Ist 1.3 abgeschaltet, baut die 1.2-Maschine das ClientHello selbst
        // — ein 1.3-ClientHello zu senden und danach umzusteigen waere
        // Unsinn, weil die Gegenseite 1.3 annehmen koennte.
        if (!TlsCfgErlaubt13(peek64(c + V_CFG))
            && TlsCfgErlaubt12(peek64(c + V_CFG))) {
            var c12n: int64 := Tls12Neu(peek64(c + V_CFG));
            if (c12n == 0) { return fehlerSetzen(c, E_KONFIG); }
            poke64(c + V_12, c12n);
            return Tls12Schritt(c12n);
        }
        var rc0: int64 := clientStart(c);
        if (rc0 < 0) { return rc0; }
        if (TlsAusgabeOffen(c) > 0) { return TlsWantWrite(); }
        return TlsWantRead();
    }

    // Server: vor dem ersten Record entscheiden, welche Version laeuft.
    if (z == Z_WARTE_CH) {
        var rv: int64 := verteilerServer(c);
        if (rv < 0) { return fehlerSetzen(c, rv); }
        if (rv == 1) { return Tls12Schritt(peek64(c + V_12)); }
    }

    var weiter: bool := true;
    while (weiter) {
        weiter := false;
        var vor: int64 := peek64(c + V_ZUSTAND);
        // Client: antwortet die Gegenseite nicht mit 1.3, uebernimmt die
        // 1.2-Maschine den angefangenen Handschlag.
        if (vor == Z_WARTE_SH) {
            var rv2: int64 := verteilerClient(c);
            if (rv2 < 0) { return fehlerSetzen(c, rv2); }
            if (rv2 == 1) { return Tls12Schritt(peek64(c + V_12)); }
        }
        var r: int64 := zustandSchritt(c);
        if (r < 0) { return r; }
        if (peek64(c + V_ZUSTAND) != vor) { weiter := true; }
        if (peek64(c + V_ZUSTAND) == Z_FERTIG) { weiter := false; }
        else {
            var rr: int64 := recordVerarbeiten(c);
            if (rr < 0) { return fehlerSetzen(c, rr); }
            if (rr == 0) { weiter := true; }
        }
    }

    if (peek64(c + V_ZUSTAND) == Z_FERTIG) {
        if (TlsAusgabeOffen(c) > 0) { return TlsWantWrite(); }
        return 0;
    }
    if (TlsAusgabeOffen(c) > 0) { return TlsWantWrite(); }
    return TlsWantRead();
}

// ---------------------------------------------------------------------------
// Anwendungsdaten
// ---------------------------------------------------------------------------

// Anwendungsdaten senden. Records werden auf 16384 Byte Klartext begrenzt
// (§5.2). Liefert die Anzahl verarbeiteter Byte oder einen Fehler.
pub fn TlsSchreibe(c: int64, buf: int64, len: int64): int64 {
    if (peek64(c + V_12) != 0) { return Tls12Schreibe(peek64(c + V_12), buf, len); }
    if (peek64(c + V_ZUSTAND) != Z_FERTIG) { return E_ABLAUF; }
    var pos: int64 := 0;
    while (pos < len) {
        var n: int64 := len - pos;
        if (n > 16384) { n := 16384; }
        // Passt der Record nicht mehr in den Ausgabepuffer, liefern wir das
        // bisher Verarbeitete zurueck, statt still zu verwerfen.
        if (peek64(c + V_OUTPOS) + n + 22 > B_OUT) {
            if (pos == 0) { return TlsWantWrite(); }
            return pos;
        }
        var rc: int64 := recordSenden(c, RT_APPDATA, buf + pos, n);
        if (rc != 0) { return rc; }
        pos += n;
    }
    return pos;
}

// Empfangene Anwendungsdaten abholen. 0 heisst "noch nichts da".
pub fn TlsLese(c: int64, buf: int64, cap: int64): int64 {
    if (peek64(c + V_12) != 0) { return Tls12Lese(peek64(c + V_12), buf, cap); }
    var z: int64 := peek64(c + V_ZUSTAND);
    if (z == Z_FEHLER) { return peek64(c + V_FEHLER); }
    var rc: int64 := pumpe(c);
    if (rc != 0 && rc != E_GESCHLOSSEN) { return fehlerSetzen(c, rc); }
    if (rc == E_GESCHLOSSEN) {
        // Auf ein close_notify gehoert ein eigenes close_notify (§6.1).
        // Ohne das wartet die Gegenseite auf einen Abschluss, den es nie
        // gibt — tlsfuzzer lief dort in sein Zeitlimit (#2096).
        if (peek64(c + V_CLOSEGESENDET) == 0) {
            alertSenden(c, 1, 0);
            poke64(c + V_CLOSEGESENDET, 1);
        }
        poke64(c + V_ZUSTAND, Z_ZU);
    }

    // Nach dem Handschlag koennen Handschlagnachrichten kommen (KeyUpdate,
    // NewSessionTicket). Wer sie liegen laesst, liest nach einem KeyUpdate
    // der Gegenseite nur noch Muell und meldet -5.
    if (peek64(c + V_HSPOS) > peek64(c + V_HSGELESEN)) {
        var rp: int64 := nachHandschlag(c);
        if (rp != 0) { return fehlerSetzen(c, rp); }
    }

    var gelesen: int64 := peek64(c + V_APPGELESEN);
    var da: int64 := peek64(c + V_APPPOS) - gelesen;
    if (da <= 0) {
        if (peek64(c + V_ZUSTAND) == Z_ZU) { return E_GESCHLOSSEN; }
        return 0;
    }
    var n: int64 := da;
    if (n > cap) { n := cap; }
    // #2578: Stammen diese Byte aus 0-RTT? Entschieden wird an der Grenze im
    // Puffer, und ein Lesevorgang wird NICHT ueber sie hinaus gefuehrt:
    // sonst traege ein einzelner Rueckgabewert zwei Herkuenfte, und die
    // Anwendung koennte sie nicht trennen. Lieber zwei Aufrufe als ein
    // Ergebnis, dessen zweite Haelfte etwas anderes bedeutet.
    var grenze: int64 := peek64(c + V_EDGRENZE);
    if (gelesen < grenze) {
        if (gelesen + n > grenze) { n := grenze - gelesen; }
        poke64(c + V_EDFLAG, 1);
    } else {
        poke64(c + V_EDFLAG, 0);
    }
    var i: int64 := 0;
    while (i < n) { poke8(buf + i, peek8(pApp(c) + gelesen + i)); i := i + 1; }
    gelesen += n;
    if (gelesen == peek64(c + V_APPPOS)) {
        poke64(c + V_APPPOS, 0);
        poke64(c + V_APPGELESEN, 0);
    } else {
        poke64(c + V_APPGELESEN, gelesen);
    }
    return n;
}

// ---------------------------------------------------------------------------
// KeyUpdate (RFC 8446 §4.6.3)
//
// Jede Richtung hat ihr eigenes Verkehrsgeheimnis; ein KeyUpdate ersetzt
// GENAU eines davon durch
//   application_traffic_secret_N+1 =
//       HKDF-Expand-Label(secret_N, "traffic upd", "", Hash.length)
// und setzt die Sequenznummer dieser Richtung auf 0. Das Transkript bleibt
// unberuehrt — KeyUpdate steht nicht darin.
// ---------------------------------------------------------------------------

fn eigenesSecret(c: int64): int64 {
    if (peek64(c + V_ROLLE) == 1) { return c + V_SEC_SAP; }
    return c + V_SEC_CAP;
}

fn fremdesSecret(c: int64): int64 {
    if (peek64(c + V_ROLLE) == 1) { return c + V_SEC_CAP; }
    return c + V_SEC_SAP;
}

fn secretFortschreiben(c: int64, secret: int64): bool {
    var hl: int64 := peek64(c + V_HASHLEN);
    var neu: int64 := pScr(c) + S_KU;
    if (!HkdfExpandLabel(hl, secret, hl, "traffic upd"c as int64, 11,
                         0, 0, neu, hl)) { return false; }
    var i: int64 := 0;
    while (i < hl) { poke8(secret + i, peek8(neu + i)); i := i + 1; }
    SecureZero(neu, 64);
    return true;
}

// Eigenen Schreibschluessel erneuern und das der Gegenseite ankuendigen.
// `anfordern` setzt request_update, verlangt also auch von der Gegenseite
// ein KeyUpdate.
pub fn TlsKeyUpdateSenden(c: int64, anfordern: bool): int64 {
    // TLS 1.2 kennt kein KeyUpdate; dort gaebe es nur Renegotiation, und
    // die wird abgewiesen.
    if (peek64(c + V_12) != 0) { return E_UNTERSTUETZT; }
    if (peek64(c + V_ZUSTAND) != Z_FERTIG) { return E_ABLAUF; }
    var b: int64 := pScr(c) + S_KOPF;
    if (anfordern) { poke8(b, 1); } else { poke8(b, 0); }
    var rc: int64 := hsSendenRoh(c, HS_KEY_UPDATE, b, 1, false, false);
    if (rc != 0) { return rc; }
    if (!secretFortschreiben(c, eigenesSecret(c))) { return E_KONFIG; }
    if (!schreibSchluessel(c, eigenesSecret(c), 2)) { return E_KONFIG; }
    return 0;
}

// Nach dem Handschlag eintreffende Handschlagnachrichten: KeyUpdate wirkt,
// NewSessionTicket wird verworfen (PSK-Resumption ist Stufe 3). Alles andere
// ist an dieser Stelle ein Ablauffehler und wird gemeldet.
fn nachHandschlag(c: int64): int64 {
    var tp: int64 := pScr(c) + S_TP;
    var pp: int64 := pScr(c) + S_PP;
    var lp: int64 := pScr(c) + S_LP;
    while (hsAnsehen(c, tp, pp, lp)) {
        var typ: int64 := peek64(tp);
        var pos: int64 := peek64(pp);
        var len: int64 := peek64(lp);
        if (typ == HS_KEY_UPDATE) {
            if (len != 1) { return E_FORMAT; }
            var anf: int64 := peek8(pos) & 0xFF;
            // §4.6.3: ein anderer Wert als 0 oder 1 MUSS illegal_parameter
            // geben. Mit decode_error fielen 56 Faelle in tlsfuzzers
            // test-tls13-keyupdate (#2096).
            if (anf > 1) { return E_PARAM; }
            hsVerbrauchen(c, len, false);
            if (!secretFortschreiben(c, fremdesSecret(c))) { return E_KONFIG; }
            if (!leseSchluessel(c, fremdesSecret(c), 2)) { return E_KONFIG; }
            // Eine Anforderung wird mit genau EINEM eigenen KeyUpdate
            // beantwortet, und das traegt request_update = 0 (§4.6.3) —
            // sonst schaukeln sich zwei Seiten gegenseitig hoch.
            if (anf == 1) {
                var rc: int64 := TlsKeyUpdateSenden(c, false);
                if (rc != 0) { return rc; }
            }
        } else {
            if (typ == HS_NEW_TICKET) {
                // ZWEITE Stelle, an der NewSessionTicket ankommt: hier im
                // Nachhandschlag, oben im Handschlagfluss. Beide muessen
                // dasselbe tun — in diesem Repo sind zwei solche Stellen
                // schon oefter auseinandergelaufen (#1787, #1806), und ein
                // Ticket, das nur auf einem der zwei Wege gemerkt wird,
                // waere eine Wiederaufnahme, die "manchmal" geht.
                var rct: int64 := ticketLesen(c, pos, len);
                hsVerbrauchen(c, len, false);
                if (rct < 0) { return rct; }
            } else {
                return E_ABLAUF;
            }
        }
    }
    return 0;
}

// close_notify senden (§6.1).
// ── 0-RTT: oeffentliche Schnittstelle (#2578) ─────────────────────────────

// Fruehe Anwendungsdaten senden (Client). Rueckgabe wie TlsSchreibe: die
// Zahl der uebernommenen Byte, TlsWantWrite() wenn der Ausgabepuffer voll
// ist, sonst ein Fehler.
//
// Aufzurufen NACH dem ersten TlsSchritt (das ClientHello muss draussen sein,
// und der fruehe Schluessel steht erst danach) und VOR dem Handschlagende.
// Ein Aufruf zu einem anderen Zeitpunkt liefert E_ABLAUF statt still etwas
// anderes zu tun — ein stiller Default waere hier besonders teuer, weil er
// Klartext bedeuten koennte.
pub fn TlsSchreibeFrueh(c: int64, buf: int64, len: int64): int64 {
    if (peek64(c + V_12) != 0) { return E_UNTERSTUETZT; }
    if (peek64(c + V_ROLLE) != 2) { return E_ABLAUF; }       // nur der Client
    if (peek64(c + V_EDZUSTAND) != 1) { return E_ABLAUF; }
    if (peek64(c + V_KRYPT_SCHR) != 3) { return E_ABLAUF; }
    if (len < 0) { return E_PUFFER; }
    // §4.2.10: mehr als max_early_data_size darf nicht gesendet werden. Die
    // Grenze ist das Kleinere aus eigener Vorgabe und Ticketangabe; sie
    // steht in V_EDMAX und wurde beim Bauen des ClientHello gesetzt.
    if (peek64(c + V_EDGESCHR) + len > peek64(c + V_EDMAX)) { return E_PUFFER; }
    var pos: int64 := 0;
    while (pos < len) {
        var nn: int64 := len - pos;
        if (nn > 16384) { nn := 16384; }
        if (peek64(c + V_OUTPOS) + nn + 22 > B_OUT) {
            if (pos == 0) { return TlsWantWrite(); }
            poke64(c + V_EDGESCHR, peek64(c + V_EDGESCHR) + pos);
            return pos;
        }
        var rc: int64 := recordSenden(c, RT_APPDATA, buf + pos, nn);
        if (rc != 0) { return rc; }
        pos += nn;
    }
    poke64(c + V_EDGESCHR, peek64(c + V_EDGESCHR) + pos);
    return pos;
}

// Der Stand der fruehen Daten: 0 keine, 1 angeboten, 2 angenommen,
// 3 abgelehnt. Fuer den Client ist 3 die Aufforderung, die Daten normal zu
// senden; fuer den Server sagt 2, dass gelesene Byte aus 0-RTT stammen
// koennen.
pub fn TlsFruehZustand(c: int64): int64 { return peek64(c + V_EDZUSTAND); }

// Wurden die fruehen Daten angenommen? Eine eigene Funktion, weil das die
// Frage ist, die die Anwendung wirklich stellt.
pub fn TlsFruehAngenommen(c: int64): int64 {
    if (peek64(c + V_EDZUSTAND) == 2) { return 1; }
    return 0;
}

// Stammen die Byte des LETZTEN TlsLese aus 0-RTT? Diese Frage muss die
// Anwendung stellen koennen, bevor sie eine nicht-wiederholbare Anfrage
// ausfuehrt: 0-RTT-Daten sind wiederholbar, und ein TlsLese, das sie wie
// normale Daten liefert, verlagert das Problem still auf jeden Aufrufer
// (#2578).
pub fn TlsLetzteLeseFrueh(c: int64): int64 { return peek64(c + V_EDFLAG); }

// Wie viele fruehe Byte sind angekommen (Server) bzw. hinausgegangen
// (Client)? Zahlen fuer Protokoll und Nachweis.
pub fn TlsFruehGelesen(c: int64): int64 { return peek64(c + V_EDGELESEN); }
pub fn TlsFruehGesendet(c: int64): int64 { return peek64(c + V_EDGESCHR); }

// Wie viele unlesbare Records hat diese Verbindung verworfen? Nach einem
// abgelehnten 0-RTT ist das die Zahl der fruehen Records der Gegenseite --
// und 0, wenn nichts verworfen werden musste.
pub fn TlsVerworfeneRecords(c: int64): int64 { return peek64(c + V_SKIPZAHL); }

pub fn TlsSchliessen(c: int64): void {
    if (peek64(c + V_12) != 0) { Tls12Schliessen(peek64(c + V_12)); return; }
    if (peek64(c + V_ZUSTAND) == Z_FERTIG && peek64(c + V_CLOSEGESENDET) == 0) {
        alertSenden(c, 1, 0);
        poke64(c + V_CLOSEGESENDET, 1);
    }
    poke64(c + V_ZUSTAND, Z_ZU);
}
