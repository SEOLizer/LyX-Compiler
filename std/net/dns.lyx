// Generic DNS Resolve (supports any record type)
// ============================================================================

// #1641: Anfrage senden und mit Zeitgrenze auf die Antwort warten. Kommt keine,
// wird wiederholt; nach DNS_VERSUCHE Anlaeufen gibt die Funktion auf und
// liefert eine Laenge < 0. Vorher stand hier ein blockierendes
// UDPSocketRecv ohne jede Grenze.
fn dns_frage_mit_zeitlimit(sock: UDPSocket, buf: int64, queryLen: int64,
                           dnsServerIP: int64): int64 {
  // Ein Fehlschlag beim Setzen der Grenze ist kein Grund aufzugeben — dann
  // verhaelt sich der Aufruf wie bisher, statt gar nicht zu fragen. Gemeldet
  // wird er ueber den Rueckgabewert von UDPSocketSetRecvTimeout, den der
  // Aufrufer hier nicht braucht.
  UDPSocketSetRecvTimeout(sock, DNS_TIMEOUT_SEK, 0);
  var versuch: int64 := 0;
  while (versuch < DNS_VERSUCHE) {
    var sendRet: int64 := UDPSocketSendToAddr(sock, buf, queryLen, dnsServerIP, DNS_PORT);
    if (sendRet < 0) { return 0 - 1; }
    var nread: int64 := UDPSocketRecv(sock, buf, 512, 0, 0);
    if (nread >= 12) { return nread; }
    // nread < 0 heisst hier in aller Regel EAGAIN/EWOULDBLOCK: die Zeit ist
    // abgelaufen. Ein zu kurzer Kopf ist ebenso unbrauchbar — beides fuehrt
    // zum naechsten Versuch.
    versuch := versuch + 1;
  }
  return 0 - 1;
}

// Resolve hostname using specified DNS server and record type
// queryType: DNS_TYPE_A, DNS_TYPE_AAAA, DNS_TYPE_MX, DNS_TYPE_CNAME
// resultPtr: pointer to a 128-byte result buffer (NICHT 64 — siehe dns_parse_response_ex)
// Returns: true on success, false on error
pub fn DNSResolveEx(hostname: int64, hostnameLen: int64, dnsServerIP: int64, queryType: int64, resultPtr: int64): bool {
  var sock: UDPSocket;
  var buf: int64;
  var queryLen: int64;
  var nread: int64;

  // Initialize result
  poke8(resultPtr + 0, 0);
  poke8(resultPtr + 8, 0);
  poke8(resultPtr + 16, 0);
  poke8(resultPtr + 24, -1);
  poke8(resultPtr + 32, 0);

  // Create UDP socket
  sock := UDPSocketNew();
  if (sock.fd < 0) {
    return false;
  }

  buf := BufferAlloc(512);
  if (buf == 0) {
    UDPSocketClose(sock);
    return false;
  }

  queryLen := dns_build_query(buf, hostname, hostnameLen, queryType);

  nread := dns_frage_mit_zeitlimit(sock, buf, queryLen, dnsServerIP);
  if (nread < 12) {
    BufferFree(buf, 512);
    UDPSocketClose(sock);
    return false;
  }

  return dns_parse_response_ex(buf, nread, resultPtr, queryType);
}

