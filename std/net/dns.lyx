// Lyx Network Library - DNS Resolver
// DNS client for A, AAAA, MX, CNAME record lookups

@capabilities([network.udp.connect, fs.read])
unit std.net.dns;

import std.net.socket;
import std.net.types;
import std.net.tls;

// ============================================================================
// DNS Constants
// ============================================================================

// DNS header flags
pub con DNS_QR_QUERY: int64 := 0;       // Query
pub con DNS_QR_RESPONSE: int64 := 1;    // Response
pub con DNS_OPCODE_QUERY: int64 := 0;   // Standard query
pub con DNS_RD: int64 := 1;             // Recursion Desired
pub con DNS_RA: int64 := 1;             // Recursion Available

// DNS record types
pub con DNS_TYPE_A: int64 := 1;         // IPv4 address
pub con DNS_TYPE_AAAA: int64 := 28;     // IPv6 address
pub con DNS_TYPE_CNAME: int64 := 5;     // Canonical name
pub con DNS_TYPE_MX: int64 := 15;       // Mail exchange
pub con DNS_TYPE_TXT: int64 := 16;      // Text record
pub con DNS_TYPE_NS: int64 := 2;        // Name server
pub con DNS_TYPE_SOA: int64 := 6;       // Start of authority
pub con DNS_TYPE_PTR: int64 := 12;      // Pointer record
pub con DNS_TYPE_SRV: int64 := 33;      // Service record
pub con DNS_TYPE_CAA: int64 := 257;     // Certification Authority Authorization
pub con DNS_TYPE_DS: int64 := 43;       // Delegation Signer
pub con DNS_TYPE_DNSKEY: int64 := 48;   // DNS Key
pub con DNS_TYPE_ANY: int64 := 255;     // Any record type

// DNS classes
pub con DNS_CLASS_IN: int64 := 1;       // Internet

// DNS response codes
pub con DNS_RCODE_OK: int64 := 0;       // No error
pub con DNS_RCODE_FORMERR: int64 := 1;  // Format error
pub con DNS_RCODE_SERVFAIL: int64 := 2; // Server failure
pub con DNS_RCODE_NXDOMAIN: int64 := 3; // Non-existent domain
pub con DNS_RCODE_NOTIMP: int64 := 4;   // Not implemented
pub con DNS_RCODE_REFUSED: int64 := 5;  // Query refused

// Default DNS servers
pub con DNS_PORT: int64 := 53;
// #1641: Zeitgrenze und Zahl der Versuche fuer eine Anfrage. Bleibt die
// Antwort aus — verworfene Anfrage, Paketverlust, unerreichbarer Server —,
// war der Aufrufer vorher fuer immer blockiert. Zwei Sekunden je Versuch,
// dreimal, danach false: das ist das Verhalten eines System-Resolvers.
pub con DNS_TIMEOUT_SEK: int64 := 2;
pub con DNS_VERSUCHE: int64 := 3;
pub con DNS_DOH_PORT: int64 := 443;

// Cache settings
con DNS_CACHE_SLOTS: int64 := 16;
con DNS_CACHE_ENTRY_SIZE: int64 := 224;
con DNS_CACHE_DEFAULT_TTL: int64 := 300;

@cap(system.time)
extern fn time(tloc: int64): int64 link "libc.so.6";

// ============================================================================
// DNS Result Structures
// ============================================================================

// Generic DNS Result using dynamic allocation
// Supports all standard DNS record types
// For use with mmap - caller allocates and provides pointer
// 
// Memory layout (128 bytes total):
// Offset 0: success (bool, 1 byte) + padding
// Offset 8: recordType (int64)
// Offset 16: ttl (int64)
// Offset 24: rcode (int64)
// Offset 32: data length (int64)
// Offset 40: data (up to 88 bytes for complex records)
// 
// For static use, allocate 128 bytes with mmap
pub type DNSResult = struct {
  success: bool;
  recordType: int64;
  ttl: int64;
  rcode: int64;
  dataLen: int64;
  // Note: data field removed - access via pointer arithmetic
  // Use resultPtr + 40 to access data area
};

// ============================================================================
// Internal: Random ID generator (simple LCG)
// ============================================================================

var g_dns_seed: int64 := 12345;

fn dns_random_id(): int64 {
  var step1: int64 := g_dns_seed * 1103515245;
  var step2: int64 := step1 + 12345;
  g_dns_seed := step2 & 0x7FFFFFFF;
  return g_dns_seed & 0xFFFF;
}

// ============================================================================
// Internal: Encode domain name in DNS format
// ============================================================================

fn dns_encode_name(buf: int64, offset: int64, name: int64, nameLen: int64): int64 {
  var i: int64 := 0;
  var labelStart: int64 := offset;
  var pos: int64 := offset + 1;
  var c: int64;
  var labelLen: int64 := 0;
  
  while (i < nameLen) {
    c := peek8(name + i);
    
    if (c == 46) {  // '.' character
      poke8(buf + labelStart, labelLen);
      labelStart := pos;
      pos += 1;
      labelLen := 0;
    } else {
      poke8(buf + pos, c);
      pos += 1;
      labelLen += 1;
    }
    i += 1;
  }
  
  poke8(buf + labelStart, labelLen);
  poke8(buf + pos, 0);
  pos += 1;
  
  return pos - offset;
}

// ============================================================================
// Internal: Build DNS query packet
// ============================================================================

fn dns_build_query(buf: int64, name: int64, nameLen: int64, queryType: int64): int64 {
  var offset: int64 := 0;
  var id: int64 := dns_random_id();
  
  // DNS Header (12 bytes)
  poke8(buf + 0, (id >> 8) & 0xFF);
  poke8(buf + 1, id & 0xFF);
  poke8(buf + 2, 0x01);  // Flags: RD=1
  poke8(buf + 3, 0x00);
  poke8(buf + 4, 0x00);  // QDCOUNT = 1
  poke8(buf + 5, 0x01);
  poke8(buf + 6, 0x00);  // ANCOUNT = 0
  poke8(buf + 7, 0x00);
  poke8(buf + 8, 0x00);  // NSCOUNT = 0
  poke8(buf + 9, 0x00);
  poke8(buf + 10, 0x00); // ARCOUNT = 0
  poke8(buf + 11, 0x00);
  
  offset := 12;
  
  // Question section
  var nameBytes: int64 := dns_encode_name(buf, offset, name, nameLen);
  offset += nameBytes;
  
  poke8(buf + offset, (queryType >> 8) & 0xFF);
  poke8(buf + offset + 1, queryType & 0xFF);
  offset += 2;
  
  poke8(buf + offset, 0x00);
  poke8(buf + offset + 1, 0x01);
  offset += 2;
  
  return offset;
}

// ============================================================================
// Internal: Skip DNS name (handles compression)
// ============================================================================

fn dns_skip_name(buf: int64, offset: int64, maxLen: int64): int64 {
  var pos: int64 := offset;
  var len: int64;
  // WP-14.1: RFC 1035 — max 255 Bytes pro Domain-Name
  var totalBytes: int64 := 0;
  // WP-14.2: max 100 Pointer-Hops gegen zirkuläre Komprimierungsketten
  var ptrHops: int64 := 0;

  while (pos < maxLen) {
    len := peek8(buf + pos);

    if (len == 0) {
      return pos + 1;
    }

    if ((len & 0xC0) == 0xC0) {
      // WP-14.2: Hop zählen; bei zu vielen Hops Fehler signalisieren
      ptrHops += 1;
      if (ptrHops > 100) { return maxLen; }
      return pos + 2;
    }

    // WP-14.1: Label-Länge akkumulieren; bei > 255 Bytes abbrechen
    totalBytes := totalBytes + 1 + len;
    if (totalBytes > 255) { return maxLen; }

    pos := pos + 1 + len;
  }

  return pos;
}

// ============================================================================
// Internal: Parse DNS response (extended)
// Supports A, AAAA, MX, CNAME records
// resultPtr: pointer to a 128-byte result buffer (Layout siehe oben; Daten-Region
//   Offset 40..127 = 88 Bytes). WICHTIG: NICHT 64 Bytes allozieren — NS/TXT/SOA/PTR
//   schreiben bis zu 64 Daten-Bytes ab Offset 40 (→ bis Offset 103). Ein 64-Byte-
//   Puffer würde überlaufen (SEC-BUG-03-Folge: Doku war widersprüchlich).
// queryType: the type of record we asked for
// Returns: true on success, false on error
// ============================================================================

fn dns_parse_response_ex(buf: int64, bufLen: int64, resultPtr: int64, queryType: int64): bool {
  var flags: int64;
  var qdcount: int64;
  var ancount: int64;
  var offset: int64;
  var i: int64;
  var rtype: int64;
  var rclass: int64;
  var ttl: int64;
  var rdlength: int64;
  
  // Initialize result header fields (Reader liest Daten nur bis dataLen → kein Leak)
  poke8(resultPtr + 0, 0);     // success = false
  poke8(resultPtr + 8, 0);     // recordType = 0
  poke8(resultPtr + 16, 0);    // ttl = 0
  poke8(resultPtr + 24, -1);   // rcode = -1 (error)
  poke8(resultPtr + 32, 0);     // dataLen = 0
  
  if (bufLen < 12) {
    return false;
  }
  // WP-14.3: DNS-UDP-Maximum ist 65535 Bytes; größere Antworten ablehnen
  if (bufLen > 65535) {
    return false;
  }

  // Parse header
  flags := (peek8(buf + 2) << 8) | peek8(buf + 3);
  
  // Check QR bit (must be response)
  if ((flags & 0x8000) == 0) {
    poke8(resultPtr + 24, -2);  // rcode = -2
    return false;
  }
  
  // Extract RCODE
  var rcode: int64 := flags & 0x000F;
  poke8(resultPtr + 24, rcode);
  
  if (rcode != DNS_RCODE_OK) {
    return false;
  }
  
  // Get counts
  qdcount := (peek8(buf + 4) << 8) | peek8(buf + 5);
  ancount := (peek8(buf + 6) << 8) | peek8(buf + 7);

  // WP-14.2: qdcount/ancount aus dem Paket begrenzen — CPU-Exhaustion verhindern
  if (qdcount > 100 || ancount > 100) {
    return false;
  }

  if (ancount == 0) {
    poke8(resultPtr + 24, DNS_RCODE_NXDOMAIN);
    return false;
  }
  
  // Skip header
  offset := 12;
  
  // Skip question section
  i := 0;
  while (i < qdcount) {
    offset := dns_skip_name(buf, offset, bufLen);
    offset += 4;
    i += 1;
  }
  
  // Parse answer section
  i := 0;
  while (i < ancount) {
    offset := dns_skip_name(buf, offset, bufLen);
    
    if (offset + 10 > bufLen) {
      return false;
    }
    
    rtype := (peek8(buf + offset) << 8) | peek8(buf + offset + 1);
    offset += 2;
    
    rclass := (peek8(buf + offset) << 8) | peek8(buf + offset + 1);
    offset += 2;
    
    ttl := (peek8(buf + offset) << 24) | (peek8(buf + offset + 1) << 16) |
           (peek8(buf + offset + 2) << 8) | peek8(buf + offset + 3);
    offset += 4;
    
    rdlength := (peek8(buf + offset) << 8) | peek8(buf + offset + 1);
    offset += 2;

    // SEC-BUG-03: rdata-Bounds-Check — rdlength kommt aus dem Netzwerk (untrusted).
    // Ohne diesen Check liest jeder Record-Handler OOB wenn rdlength über bufLen zeigt.
    if (offset + rdlength > bufLen) {
      return false;
    }

    // Check if this is the record type we're looking for
    if (rclass != DNS_CLASS_IN) {
      offset += rdlength;
      i += 1;
      continue;
    }
    
    // A record (IPv4)
    if ((rtype == DNS_TYPE_A) && (queryType == DNS_TYPE_A) && (rdlength == 4)) {
      // Store as IPv4 in first 4 bytes of data
      poke8(resultPtr + 40, peek8(buf + offset));
      poke8(resultPtr + 41, peek8(buf + offset + 1));
      poke8(resultPtr + 42, peek8(buf + offset + 2));
      poke8(resultPtr + 43, peek8(buf + offset + 3));
      
      // Store TTL
      poke8(resultPtr + 16, ttl & 0xFF);
      poke8(resultPtr + 17, (ttl >> 8) & 0xFF);
      poke8(resultPtr + 18, (ttl >> 16) & 0xFF);
      poke8(resultPtr + 19, (ttl >> 24) & 0xFF);
      
      // Store record type and data length
      poke8(resultPtr + 8, DNS_TYPE_A);
      poke8(resultPtr + 32, 4);
      
      poke8(resultPtr + 0, 1);  // success = true
      return true;
    }
    
    // AAAA record (IPv6)
    if ((rtype == DNS_TYPE_AAAA) && (queryType == DNS_TYPE_AAAA) && (rdlength == 16)) {
      var j: int64 := 0;
      while (j < 16) {
        poke8(resultPtr + 40 + j, peek8(buf + offset + j));
        j += 1;
      }
      
      // Store TTL
      poke8(resultPtr + 16, ttl & 0xFF);
      poke8(resultPtr + 17, (ttl >> 8) & 0xFF);
      poke8(resultPtr + 18, (ttl >> 16) & 0xFF);
      poke8(resultPtr + 19, (ttl >> 24) & 0xFF);
      
      // Store record type and data length
      poke8(resultPtr + 8, DNS_TYPE_AAAA);
      poke8(resultPtr + 32, 16);
      
      poke8(resultPtr + 0, 1);  // success = true
      return true;
    }
    
    // CNAME record (canonical name)
    if ((rtype == DNS_TYPE_CNAME) && (queryType == DNS_TYPE_CNAME)) {
      // Skip the name and read the canonical name
      var nameOffset: int64 := dns_skip_name(buf, offset, bufLen);
      
      // Copy the canonical name (up to 24 bytes)
      var copyLen: int64 := rdlength;
      if (copyLen > 24) {
        copyLen := 24;
      }
      
      var j: int64 := 0;
      while (j < copyLen) {
        poke8(resultPtr + 40 + j, peek8(buf + offset + j));
        j += 1;
      }
      
      // Store TTL
      poke8(resultPtr + 16, ttl & 0xFF);
      poke8(resultPtr + 17, (ttl >> 8) & 0xFF);
      poke8(resultPtr + 18, (ttl >> 16) & 0xFF);
      poke8(resultPtr + 19, (ttl >> 24) & 0xFF);
      
      // Store record type and data length
      poke8(resultPtr + 8, DNS_TYPE_CNAME);
      poke8(resultPtr + 32, copyLen);
      
      poke8(resultPtr + 0, 1);  // success = true
      return true;
    }
    
    // MX record (mail exchange)
    if ((rtype == DNS_TYPE_MX) && (queryType == DNS_TYPE_MX)) {
      // MX format: 2-byte priority, then domain name
      // Read priority (2 bytes, big-endian)
      var priority: int64 := (peek8(buf + offset) << 8) | peek8(buf + offset + 1);
      
      // Store priority in first 2 bytes of data
      poke8(resultPtr + 40, (priority >> 8) & 0xFF);
      poke8(resultPtr + 41, priority & 0xFF);
      
      // Skip past the priority to the domain name
      var nameOffset: int64 := dns_skip_name(buf, offset + 2, bufLen);
      
      // Copy domain name (up to 22 bytes to fit in 24)
      var copyLen: int64 := rdlength - 2;
      if (copyLen > 22) {
        copyLen := 22;
      }
      
      var j: int64 := 0;
      while (j < copyLen) {
        poke8(resultPtr + 42 + j, peek8(buf + offset + 2 + j));
        j += 1;
      }
      
      // Store TTL
      poke8(resultPtr + 16, ttl & 0xFF);
      poke8(resultPtr + 17, (ttl >> 8) & 0xFF);
      poke8(resultPtr + 18, (ttl >> 16) & 0xFF);
      poke8(resultPtr + 19, (ttl >> 24) & 0xFF);
      
      // Store record type and data length
      poke8(resultPtr + 8, DNS_TYPE_MX);
      poke8(resultPtr + 32, 2 + copyLen);  // priority + domain
      
      poke8(resultPtr + 0, 1);  // success = true
      return true;
    }
    
    // NS record (name server)
    if ((rtype == DNS_TYPE_NS) && (queryType == DNS_TYPE_NS)) {
      // Copy the nameserver domain name (up to 64 bytes)
      var copyLen: int64 := rdlength;
      if (copyLen > 64) {
        copyLen := 64;
      }
      
      var j: int64 := 0;
      while (j < copyLen) {
        poke8(resultPtr + 40 + j, peek8(buf + offset + j));
        j += 1;
      }
      
      // Store TTL
      poke8(resultPtr + 16, ttl & 0xFF);
      poke8(resultPtr + 17, (ttl >> 8) & 0xFF);
      poke8(resultPtr + 18, (ttl >> 16) & 0xFF);
      poke8(resultPtr + 19, (ttl >> 24) & 0xFF);
      
      // Store record type and data length
      poke8(resultPtr + 8, DNS_TYPE_NS);
      poke8(resultPtr + 32, copyLen);
      
      poke8(resultPtr + 0, 1);  // success = true
      return true;
    }
    
    // TXT record (text)
    if ((rtype == DNS_TYPE_TXT) && (queryType == DNS_TYPE_TXT)) {
      // TXT records can have multiple strings
      // Copy first string (up to 64 bytes)
      var copyLen: int64 := rdlength;
      if (copyLen > 64) {
        copyLen := 64;
      }
      
      var j: int64 := 0;
      while (j < copyLen) {
        poke8(resultPtr + 40 + j, peek8(buf + offset + j));
        j += 1;
      }
      
      // Store TTL
      poke8(resultPtr + 16, ttl & 0xFF);
      poke8(resultPtr + 17, (ttl >> 8) & 0xFF);
      poke8(resultPtr + 18, (ttl >> 16) & 0xFF);
      poke8(resultPtr + 19, (ttl >> 24) & 0xFF);
      
      // Store record type and data length
      poke8(resultPtr + 8, DNS_TYPE_TXT);
      poke8(resultPtr + 32, copyLen);
      
      poke8(resultPtr + 0, 1);  // success = true
      return true;
    }
    
    // SOA record (start of authority)
    // Format: MNAME, RNAME, SERIAL, REFRESH, RETRY, EXPIRE, MINIMUM
    if ((rtype == DNS_TYPE_SOA) && (queryType == DNS_TYPE_SOA)) {
      // Copy entire SOA data (up to 64 bytes)
      var copyLen: int64 := rdlength;
      if (copyLen > 64) {
        copyLen := 64;
      }
      
      var j: int64 := 0;
      while (j < copyLen) {
        poke8(resultPtr + 40 + j, peek8(buf + offset + j));
        j += 1;
      }
      
      // Store TTL
      poke8(resultPtr + 16, ttl & 0xFF);
      poke8(resultPtr + 17, (ttl >> 8) & 0xFF);
      poke8(resultPtr + 18, (ttl >> 16) & 0xFF);
      poke8(resultPtr + 19, (ttl >> 24) & 0xFF);
      
      // Store record type and data length
      poke8(resultPtr + 8, DNS_TYPE_SOA);
      poke8(resultPtr + 32, copyLen);
      
      poke8(resultPtr + 0, 1);  // success = true
      return true;
    }
    
    // PTR record (pointer)
    if ((rtype == DNS_TYPE_PTR) && (queryType == DNS_TYPE_PTR)) {
      // Copy the pointer target (up to 64 bytes)
      var copyLen: int64 := rdlength;
      if (copyLen > 64) {
        copyLen := 64;
      }
      
      var j: int64 := 0;
      while (j < copyLen) {
        poke8(resultPtr + 40 + j, peek8(buf + offset + j));
        j += 1;
      }
      
      // Store TTL
      poke8(resultPtr + 16, ttl & 0xFF);
      poke8(resultPtr + 17, (ttl >> 8) & 0xFF);
      poke8(resultPtr + 18, (ttl >> 16) & 0xFF);
      poke8(resultPtr + 19, (ttl >> 24) & 0xFF);
      
      // Store record type and data length
      poke8(resultPtr + 8, DNS_TYPE_PTR);
      poke8(resultPtr + 32, copyLen);
      
      poke8(resultPtr + 0, 1);  // success = true
      return true;
    }
    
    // SRV record (service)
    // Format: Priority (2), Weight (2), Port (2), Target (domain)
    if ((rtype == DNS_TYPE_SRV) && (queryType == DNS_TYPE_SRV)) {
      // Copy priority, weight, port (6 bytes) + target
      var copyLen: int64 := rdlength;
      if (copyLen > 64) {
        copyLen := 64;
      }
      
      var j: int64 := 0;
      while (j < copyLen) {
        poke8(resultPtr + 40 + j, peek8(buf + offset + j));
        j += 1;
      }
      
      // Store TTL
      poke8(resultPtr + 16, ttl & 0xFF);
      poke8(resultPtr + 17, (ttl >> 8) & 0xFF);
      poke8(resultPtr + 18, (ttl >> 16) & 0xFF);
      poke8(resultPtr + 19, (ttl >> 24) & 0xFF);
      
      // Store record type and data length
      poke8(resultPtr + 8, DNS_TYPE_SRV);
      poke8(resultPtr + 32, copyLen);
      
      poke8(resultPtr + 0, 1);  // success = true
      return true;
    }
    
    // CAA record (certification authority authorization)
    // Format: Flags (1), Tag Length (1), Tag, Value
    if ((rtype == DNS_TYPE_CAA) && (queryType == DNS_TYPE_CAA)) {
      var copyLen: int64 := rdlength;
      if (copyLen > 64) {
        copyLen := 64;
      }
      
      var j: int64 := 0;
      while (j < copyLen) {
        poke8(resultPtr + 40 + j, peek8(buf + offset + j));
        j += 1;
      }
      
      // Store TTL
      poke8(resultPtr + 16, ttl & 0xFF);
      poke8(resultPtr + 17, (ttl >> 8) & 0xFF);
      poke8(resultPtr + 18, (ttl >> 16) & 0xFF);
      poke8(resultPtr + 19, (ttl >> 24) & 0xFF);
      
      // Store record type and data length
      poke8(resultPtr + 8, DNS_TYPE_CAA);
      poke8(resultPtr + 32, copyLen);
      
      poke8(resultPtr + 0, 1);  // success = true
      return true;
    }
    
    // DS record (delegation signer)
    // Format: Key Tag (2), Algorithm (1), Digest Type (1), Digest
    if ((rtype == DNS_TYPE_DS) && (queryType == DNS_TYPE_DS)) {
      var copyLen: int64 := rdlength;
      if (copyLen > 64) {
        copyLen := 64;
      }
      
      var j: int64 := 0;
      while (j < copyLen) {
        poke8(resultPtr + 40 + j, peek8(buf + offset + j));
        j += 1;
      }
      
      // Store TTL
      poke8(resultPtr + 16, ttl & 0xFF);
      poke8(resultPtr + 17, (ttl >> 8) & 0xFF);
      poke8(resultPtr + 18, (ttl >> 16) & 0xFF);
      poke8(resultPtr + 19, (ttl >> 24) & 0xFF);
      
      // Store record type and data length
      poke8(resultPtr + 8, DNS_TYPE_DS);
      poke8(resultPtr + 32, copyLen);
      
      poke8(resultPtr + 0, 1);  // success = true
      return true;
    }
    
    // DNSKEY record (DNS key)
    // Format: Flags (2), Protocol (1), Algorithm (1), Public Key
    if ((rtype == DNS_TYPE_DNSKEY) && (queryType == DNS_TYPE_DNSKEY)) {
      var copyLen: int64 := rdlength;
      if (copyLen > 64) {
        copyLen := 64;
      }
      
      var j: int64 := 0;
      while (j < copyLen) {
        poke8(resultPtr + 40 + j, peek8(buf + offset + j));
        j += 1;
      }
      
      // Store TTL
      poke8(resultPtr + 16, ttl & 0xFF);
      poke8(resultPtr + 17, (ttl >> 8) & 0xFF);
      poke8(resultPtr + 18, (ttl >> 16) & 0xFF);
      poke8(resultPtr + 19, (ttl >> 24) & 0xFF);
      
      // Store record type and data length
      poke8(resultPtr + 8, DNS_TYPE_DNSKEY);
      poke8(resultPtr + 32, copyLen);
      
      poke8(resultPtr + 0, 1);  // success = true
      return true;
    }
    
    offset += rdlength;
    i += 1;
  }
  
  return false;
}

// ============================================================================
// Public API: DNS Resolve
// ============================================================================

// Resolve hostname to IPv4 address using specified DNS server
// resultPtr: pointer to 32-byte result buffer
// Returns: true on success, false on error
pub fn DNSResolve(hostname: int64, hostnameLen: int64, dnsServerIP: int64, resultPtr: int64): bool {
  var sock: UDPSocket;
  var buf: int64;
  var queryLen: int64;
  var nread: int64;

  // Initialize result
  poke8(resultPtr + 0, 0);
  poke8(resultPtr + 8, 0);
  poke8(resultPtr + 16, 0);
  poke8(resultPtr + 24, -1);

  // Create UDP socket
  sock := UDPSocketNew();
  if (sock.fd < 0) {
    return false;
  }

  buf := BufferAlloc(512);
  if (buf == 0) {
    UDPSocketClose(sock);
    return false;
  }

  queryLen := dns_build_query(buf, hostname, hostnameLen, DNS_TYPE_A);

  nread := dns_frage_mit_zeitlimit(sock, buf, queryLen, dnsServerIP);
  if (nread < 12) {
    BufferFree(buf, 512);
    UDPSocketClose(sock);
    return false;
  }

  return dns_parse_response_ex(buf, nread, resultPtr, DNS_TYPE_A);
}

