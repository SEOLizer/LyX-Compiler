// std/net/eth.lyx — Pure Ethernet II frame builder
//
// Kernel-safe: no imports, no syscalls, no dynamic allocation.
// All functions operate on caller-provided buffers.
//
// Public API:
//   EthBuildFrame(buf, dst_mac, src_mac, ethertype) → int64 (14)
//   EthBroadcastMac(buf)
//   EthZeroMac(buf)
//   EthCopyMac(dst, src)
//
// Wire layout (14 bytes):
//   0-5   destination MAC
//   6-11  source MAC
//   12-13 EtherType (big-endian)

unit std.net.eth;

// EtherType constants
pub con ETH_HDR_SIZE: int64 := 14;
pub con ETH_P_IP:     int64 := 2048;   // 0x0800 — IPv4
pub con ETH_P_ARP:    int64 := 2054;   // 0x0806 — ARP
pub con ETH_P_IPV6:   int64 := 34525;  // 0x86DD — IPv6

// EthBuildFrame: writes a 14-byte Ethernet II header into buf.
// dst_mac, src_mac: pointers to 6-byte MAC address buffers.
// ethertype: e.g. ETH_P_IP
// Returns: bytes written (14)
pub fn EthBuildFrame(buf: int64, dst_mac: int64, src_mac: int64, ethertype: int64): int64 {
    poke8(buf+0,  peek8(dst_mac+0)); poke8(buf+1,  peek8(dst_mac+1));
    poke8(buf+2,  peek8(dst_mac+2)); poke8(buf+3,  peek8(dst_mac+3));
    poke8(buf+4,  peek8(dst_mac+4)); poke8(buf+5,  peek8(dst_mac+5));
    poke8(buf+6,  peek8(src_mac+0)); poke8(buf+7,  peek8(src_mac+1));
    poke8(buf+8,  peek8(src_mac+2)); poke8(buf+9,  peek8(src_mac+3));
    poke8(buf+10, peek8(src_mac+4)); poke8(buf+11, peek8(src_mac+5));
    poke8(buf+12, (ethertype >> 8) & 0xFF);
    poke8(buf+13, ethertype & 0xFF);
    return 14;
}

// EthBroadcastMac: fills a 6-byte buffer with ff:ff:ff:ff:ff:ff.
pub fn EthBroadcastMac(buf: int64): void {
    poke8(buf+0, 255); poke8(buf+1, 255); poke8(buf+2, 255);
    poke8(buf+3, 255); poke8(buf+4, 255); poke8(buf+5, 255);
}

// EthZeroMac: fills a 6-byte buffer with 00:00:00:00:00:00.
pub fn EthZeroMac(buf: int64): void {
    poke8(buf+0, 0); poke8(buf+1, 0); poke8(buf+2, 0);
    poke8(buf+3, 0); poke8(buf+4, 0); poke8(buf+5, 0);
}

// EthCopyMac: copies 6 bytes from src to dst MAC buffer.
pub fn EthCopyMac(dst: int64, src: int64): void {
    poke8(dst+0, peek8(src+0)); poke8(dst+1, peek8(src+1));
    poke8(dst+2, peek8(src+2)); poke8(dst+3, peek8(src+3));
    poke8(dst+4, peek8(src+4)); poke8(dst+5, peek8(src+5));
}

// EthReadType: reads EtherType from a received frame (big-endian at offset 12).
pub fn EthReadType(buf: int64): int64 {
    return ((peek8(buf+12) & 0xFF) << 8) | (peek8(buf+13) & 0xFF);
}
