// Lyx Network Library - HTTP Client
// Simple HTTP/1.1 client implementation

unit std.net.http;

import std.net.socket;
import std.net.dns;
import std.net.types;
import std.net.tls;
import std.string;   // #1573: StrCmp fuer HTTPMethodFromStr

// HTTP constants
pub con HTTP_PORT: int64 := 80;
pub con HTTPS_PORT: int64 := 443;

// WP-9.5: Default receive timeout in milliseconds (30 seconds)
pub con HTTP_RECV_TIMEOUT_MS: int64 := 30000;

// HTTP methods
pub con HTTP_GET: int64 := 1;
pub con HTTP_POST: int64 := 2;
pub con HTTP_PUT: int64 := 3;
pub con HTTP_DELETE: int64 := 4;
pub con HTTP_PATCH: int64 := 5;
pub con HTTP_HEAD: int64 := 6;

// Max redirects to follow automatically
pub con HTTP_MAX_REDIRECTS: int64 := 10;

// HTTP status codes
pub con HTTP_OK: int64 := 200;
pub con HTTP_CREATED: int64 := 201;
pub con HTTP_NO_CONTENT: int64 := 204;
pub con HTTP_BAD_REQUEST: int64 := 400;
pub con HTTP_UNAUTHORIZED: int64 := 401;
pub con HTTP_FORBIDDEN: int64 := 403;
pub con HTTP_NOT_FOUND: int64 := 404;
pub con HTTP_SERVER_ERROR: int64 := 500;

// HTTP Response structure (uses mmap for body)
pub type HTTPResponse = struct {
  statusCode: int64;
  statusText: int64;    // Pointer to status text
  headerCount: int64;
  contentLength: int64;
  bodyPtr: int64;       // Pointer to response body
  bodySize: int64;
  headersRaw: int64;    // WP-C6: raw response headers (mmap'd, null-terminated)
  headersSize: int64;   // WP-C6: raw headers byte count
};

// HTTP Request structure
pub type HTTPRequest = struct {
  method: int64;       // HTTP_GET, HTTP_POST, etc.
  host: int64;         // Pointer to host string
  path: int64;         // Pointer to path string
  port: int64;
  headers: int64;      // Pointer to headers string
  body: int64;         // Pointer to body data
  bodySize: int64;
};

// ============================================================================
// WP-9: Hilfsfunktionen
// ============================================================================

// WP-9.5: Read from socket with timeout.
// Returns bytes read, 0 on timeout, <0 on error.
fn http_readTimeout(sock: int64, buf: int64, size: int64, timeoutMs: int64): int64 {
  var ready: int64 := SocketCanRead(sock, timeoutMs);
  if (ready <= 0) { return ready; }
  return sys_read(sock, buf, size);
}

// WP-9.1/9.2: Gibt 1 zurück wenn ptr CR (\r=13) oder LF (\n=10) enthält.
fn http_hasCrLf(ptr: int64, maxLen: int64): int64 {
  var i: int64 := 0;
  while (i < maxLen) {
    var c: int64 := peek8(ptr + i);
    if (c == 0) { return 0; }
    if (c == 13) { return 1; }
    if (c == 10) { return 1; }
    i += 1;
  }
  return 0;
}

// WP-30: Gibt 1 zurück wenn ptr eine doppelte CRLF-Sequenz (\r\n\r\n) oder
// ein nacktes CR/LF (nicht Teil von \r\n) enthält — beides ermöglicht
// Header-Injection und Request-Smuggling in Header-Blöcken.
fn http_hasInjectionCrLf(ptr: int64, maxLen: int64): int64 {
  var i: int64 := 0;
  while (i < maxLen) {
    var c: int64 := peek8(ptr + i);
    if (c == 0) { return 0; }
    if (c == 13) {
      // Nacktes \r ohne folgendes \n → Fehler
      if peek8(ptr + i + 1) != 10 { return 1; }
      // \r\n gefunden — ist es ein doppeltes? (\r\n\r\n)
      if peek8(ptr + i + 2) == 13 && peek8(ptr + i + 3) == 10 { return 1; }
      i += 2;
    } else if (c == 10) {
      // Nacktes \n ohne vorangehendes \r → Fehler
      return 1;
    } else {
      i += 1;
    }
  }
  return 0;
}

// Berechnet die Länge eines null-terminierten Strings.
fn http_strLen(ptr: int64): int64 {
  var i: int64 := 0;
  while (peek8(ptr + i) != 0) { i := i + 1; }
  return i;
}

// Schreibt n Bytes aus src nach dst, gibt neue dst-Position zurück.
fn http_writeMem(dst: int64, src: int64, n: int64): int64 {
  var i: int64 := 0;
  while (i < n) { poke8(dst + i, peek8(src + i)); i := i + 1; }
  return dst + n;
}

// Schreibt einen pchar-String nach dst, gibt neue dst-Position zurück.
fn http_writeStr(dst: int64, src: int64): int64 {
  var i: int64 := 0;
  while (peek8(src + i) != 0) { poke8(dst + i, peek8(src + i)); i := i + 1; }
  return dst + i;
}

// Schreibt "key: value\r\n" Header nach dst.
fn http_writeHeader(dst: int64, key: int64, val: int64): int64 {
  dst := http_writeStr(dst, key);
  poke8(dst, 58); poke8(dst + 1, 32); dst := dst + 2;  // ": "
  dst := http_writeStr(dst, val);
  poke8(dst, 13); poke8(dst + 1, 10); dst := dst + 2;  // "\r\n"
  return dst;
}

// Schreibt eine dezimale int64 nach dst, gibt neue dst-Position zurück.
fn http_writeInt(dst: int64, n: int64): int64 {
  if (n == 0) { poke8(dst, 48); return dst + 1; }
  var tmp: int64 := mmap(0, 24, PROT_RW, MAP_ANON, FD_NONE, 0);
  var len: int64 := 0;
  var v: int64 := n;
  while (v > 0) {
    poke8(tmp + len, 48 + (v - ((v / 10) * 10)));
    v := v / 10;
    len += 1;
  }
  var i: int64 := 0;
  while (i < len) { poke8(dst + i, peek8(tmp + (len - 1 - i))); i := i + 1; }
  munmap(tmp, 24);
  return dst + len;
}

// ============================================================================
// Build HTTP request string
// WP-9.1/9.2: Validiert Host und Path auf CR/LF-Injection.
// WP-9.3: Alloziert dynamisch basierend auf tatsächlicher Anfragegröße.
// Gibt Pointer zurück; die ersten 8 Bytes sind die Allokationsgröße,
// die nächsten 8 Bytes die tatsächliche Request-Länge.
// Eigentlicher Request-Content ab Offset 16.
// ============================================================================
pub fn HTTPRequestBuild(req: HTTPRequest): int64 {
  var hostLen: int64 := http_strLen(req.host);
  var pathLen: int64 := http_strLen(req.path);

  // WP-9.1: Host auf CR/LF prüfen
  if (http_hasCrLf(req.host, hostLen) != 0) { return 0; }
  // WP-9.2: Path auf CR/LF prüfen
  if (http_hasCrLf(req.path, pathLen) != 0) { return 0; }

  // WP-9.3: Allokationsgröße dynamisch berechnen
  // 16 Byte Metadaten + Method + Path + HTTP-Version + Host-Header +
  // Connection-Header + Content-Length + CRLF + Body + custom headers
  var customHdrsLen: int64 := 0;
  if (req.headers != 0) { customHdrsLen := http_strLen(req.headers); }
  var allocSize: int64 := 16 + 8 + pathLen + 12 + 7 + hostLen + 2 +
                          21 + 32 + 2 + req.bodySize + 16 + customHdrsLen;
  var buf: int64 := mmap(0, allocSize, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (buf == 0) { return 0; }

  var p: int64 := buf + 16;  // request content starts after metadata

  // Method
  if (req.method == HTTP_GET) {
    poke8(p, 71); poke8(p+1, 69); poke8(p+2, 84); poke8(p+3, 32);
    p += 4;
  } else if (req.method == HTTP_POST) {
    poke8(p, 80); poke8(p+1, 79); poke8(p+2, 83); poke8(p+3, 84); poke8(p+4, 32);
    p += 5;
  } else if (req.method == HTTP_PUT) {
    poke8(p, 80); poke8(p+1, 85); poke8(p+2, 84); poke8(p+3, 32);
    p += 4;
  } else if (req.method == HTTP_DELETE) {
    poke8(p, 68); poke8(p+1, 69); poke8(p+2, 76); poke8(p+3, 69); poke8(p+4, 84);
    poke8(p+5, 69); poke8(p+6, 32);
    p += 7;
  } else if (req.method == HTTP_PATCH) {
    poke8(p,80);poke8(p+1,65);poke8(p+2,84);poke8(p+3,67);poke8(p+4,72);poke8(p+5,32);
    p += 6;
  } else if (req.method == HTTP_HEAD) {
    poke8(p,72);poke8(p+1,69);poke8(p+2,65);poke8(p+3,68);poke8(p+4,32);
    p += 5;
  }

  // Path + " HTTP/1.1\r\n"
  p := http_writeStr(p, req.path);
  poke8(p,32);poke8(p+1,72);poke8(p+2,84);poke8(p+3,84);poke8(p+4,80);
  poke8(p+5,47);poke8(p+6,49);poke8(p+7,46);poke8(p+8,49);poke8(p+9,13);poke8(p+10,10);
  p += 11;

  // Host header
  poke8(p,72);poke8(p+1,111);poke8(p+2,115);poke8(p+3,116);poke8(p+4,58);poke8(p+5,32);
  p += 6;
  p := http_writeStr(p, req.host);
  poke8(p,13);poke8(p+1,10); p := p + 2;

  // Connection: close
  poke8(p,67);poke8(p+1,111);poke8(p+2,110);poke8(p+3,110);poke8(p+4,101);
  poke8(p+5,99);poke8(p+6,116);poke8(p+7,105);poke8(p+8,111);poke8(p+9,110);
  poke8(p+10,58);poke8(p+11,32);poke8(p+12,99);poke8(p+13,108);poke8(p+14,111);
  poke8(p+15,115);poke8(p+16,101);poke8(p+17,13);poke8(p+18,10);
  p += 19;

  // WP-30: Custom headers — CRLF-Injektion verhindern
  if (req.headers != 0) {
    var hlen: int64 := http_strLen(req.headers);
    if (http_hasInjectionCrLf(req.headers, hlen) != 0) { munmap(buf, allocSize); return 0; }
    p := http_writeMem(p, req.headers, hlen);
  }

  // Content-Length for POST/PUT/PATCH with body
  if ((req.method == HTTP_POST || req.method == HTTP_PUT || req.method == HTTP_PATCH) && req.bodySize > 0) {
    poke8(p,67);poke8(p+1,111);poke8(p+2,110);poke8(p+3,116);poke8(p+4,101);
    poke8(p+5,110);poke8(p+6,116);poke8(p+7,45);poke8(p+8,76);poke8(p+9,101);
    poke8(p+10,110);poke8(p+11,103);poke8(p+12,116);poke8(p+13,104);poke8(p+14,58);poke8(p+15,32);
    p += 16;
    p := http_writeInt(p, req.bodySize);
    poke8(p,13);poke8(p+1,10); p := p + 2;
  }

  // End of headers
  poke8(p,13);poke8(p+1,10); p := p + 2;

  // Body
  if ((req.method == HTTP_POST || req.method == HTTP_PUT || req.method == HTTP_PATCH) && req.bodySize > 0 && req.body != 0) {
    p := http_writeMem(p, req.body, req.bodySize);
  }

  // Store metadata: [allocSize][reqSize]
  var reqSize: int64 := p - (buf + 16);
  poke64(buf,     allocSize);
  poke64(buf + 8, reqSize);

  return buf;
}

// ============================================================================
// Send HTTP request and get response
// WP-9.3: Sendet nur tatsächliche Request-Bytes.
// WP-9.4: Liest Response-Body basierend auf Content-Length in einer Schleife.
// ============================================================================
// #1534/#1539: Der Response-Parser stand VIERMAL im Baum — einmal hier und
// dreimal in std/net/https.lyx (dort jeweils nur die Statuszeile). Was die
// Kopien nicht mitbekommen hatten, fehlte dort einfach: keine Kopfzeilen
// (#1534, mit einem munmap auf einen nie gesetzten Zeiger als Folge) und keine
// Aufloesung von `Transfer-Encoding: chunked` (#1539, ab der ersten gechunkten
// Antwort kam der Rumpf mit Laengenrahmen durchsetzt an).
//
// Er steht jetzt EINMAL hier. Die Funktion liest NICHT vom Socket — sie
// bekommt den vollstaendig gelesenen Puffer und wertet ihn aus. Damit koennen
// TCP- und TLS-Weg denselben Parser benutzen, obwohl sie verschieden lesen.
//
// buf gehoert weiter dem Aufrufer; hier wird nichts freigegeben.
pub fn HTTPParseResponse(response: HTTPResponse, buf: int64, totalRead: int64): HTTPResponse {
  var res: HTTPResponse := response;
  if (buf == 0 || totalRead <= 0) { return res; }

  // --- Statuszeile ---
  var i: int64 := 0;
  while (i < totalRead - 13) {
    if (peek8(buf + i) == 72 && peek8(buf + i + 1) == 84 &&
        peek8(buf + i + 2) == 84 && peek8(buf + i + 3) == 80 &&
        peek8(buf + i + 4) == 47) {
      i += 9;
      res.statusCode := 0;
      res.statusCode := res.statusCode * 10 + (peek8(buf + i)     - 48);
      res.statusCode := res.statusCode * 10 + (peek8(buf + i + 1) - 48);
      res.statusCode := res.statusCode * 10 + (peek8(buf + i + 2) - 48);
      i := totalRead;
    } else {
      i += 1;
    }
  }

  // --- Content-Length ---
  // Kopfzeilennamen sind laut RFC 9110 case-insensitiv, und CDNs (Cloudflare)
  // senden sie klein. Verglichen wird deshalb auf (Byte | 0x20) — so wie es
  // die HTTPS-Fassung schon tat und diese hier bisher NICHT: `content-length`
  // in Kleinschreibung wurde ueberlesen.
  i := 0;
  while (i < totalRead - 16) {
    if ((peek8(buf + i)      | 32) == 99  && (peek8(buf + i + 1)  | 32) == 111 &&
        (peek8(buf + i + 2)  | 32) == 110 && (peek8(buf + i + 3)  | 32) == 116 &&
        (peek8(buf + i + 4)  | 32) == 101 && (peek8(buf + i + 5)  | 32) == 110 &&
        (peek8(buf + i + 6)  | 32) == 116 && (peek8(buf + i + 7)  | 32) == 45  &&
        (peek8(buf + i + 8)  | 32) == 108 && (peek8(buf + i + 9)  | 32) == 101 &&
        (peek8(buf + i + 10) | 32) == 110 && (peek8(buf + i + 11) | 32) == 103 &&
        (peek8(buf + i + 12) | 32) == 116 && (peek8(buf + i + 13) | 32) == 104) {
      i += 14;
      while (i < totalRead && (peek8(buf + i) < 48 || peek8(buf + i) > 57)) { i += 1; }
      res.contentLength := 0;
      while (i < totalRead) {
        var c: int64 := peek8(buf + i);
        if (c < 48 || c > 57) { i := totalRead; }
        else {
          res.contentLength := res.contentLength * 10 + (c - 48);
          i += 1;
        }
      }
    } else {
      i += 1;
    }
  }

  // --- Ende der Kopfzeilen ---
  var bodyStart: int64 := 0;
  i := 0;
  while (i < totalRead - 4) {
    if (peek8(buf + i) == 13 && peek8(buf + i + 1) == 10 &&
        peek8(buf + i + 2) == 13 && peek8(buf + i + 3) == 10) {
      bodyStart := i + 4;
      i := totalRead;
    } else {
      i += 1;
    }
  }

  // --- Rohe Kopfzeilen sichern (WP-C6, #1453) ---
  if (bodyStart > 0) {
    var hdrLen: int64 := bodyStart - 2;
    res.headersRaw := mmap(0, hdrLen + 1, PROT_RW, MAP_ANON, FD_NONE, 0);
    if (res.headersRaw != 0) {
      var hj: int64 := 0;
      while (hj < hdrLen) { poke8(res.headersRaw + hj, peek8(buf + hj)); hj := hj + 1; }
      poke8(res.headersRaw + hdrLen, 0);
      res.headersSize := hdrLen;
      var hcnt: int64 := 0;
      var hk: int64 := 0;
      while (hk < hdrLen) {
        if (peek8(res.headersRaw + hk) == 10) { hcnt := hcnt + 1; }
        hk := hk + 1;
      }
      if (hcnt > 0) { hcnt := hcnt - 1; }   // die Statuszeile zaehlt nicht mit
      res.headerCount := hcnt;
    }
  }

  // --- Transfer-Encoding: chunked erkennen ---
  //
  // Die alte Erkennung verglich FESTE Offsets ab dem "T" von "Transfer"
  // (+18 fuer das "c" von "chunked") und traf damit nur die Schreibweise OHNE
  // Leerzeichen hinter dem Doppelpunkt. Reale Server senden
  // "Transfer-Encoding: chunked" mit Leerzeichen — dort war das "c" bei +19,
  // die Erkennung schlug fehl, und der Rumpf blieb gerahmt (#1539).
  //
  // Gesucht wird jetzt das Wort selbst, case-insensitiv, irgendwo im
  // Kopfbereich. Es kommt dort in keiner anderen Bedeutung vor.
  var isChunked: int64 := 0;
  if (res.headersRaw != 0 && res.headersSize >= 7) {
    var hptr: int64 := res.headersRaw;
    var hcheck: int64 := 0;
    while (hcheck <= res.headersSize - 7) {
      if ((peek8(hptr + hcheck)     | 32) == 99  &&   // c
          (peek8(hptr + hcheck + 1) | 32) == 104 &&   // h
          (peek8(hptr + hcheck + 2) | 32) == 117 &&   // u
          (peek8(hptr + hcheck + 3) | 32) == 110 &&   // n
          (peek8(hptr + hcheck + 4) | 32) == 107 &&   // k
          (peek8(hptr + hcheck + 5) | 32) == 101 &&   // e
          (peek8(hptr + hcheck + 6) | 32) == 100) {   // d
        isChunked := 1;
        hcheck := res.headersSize;
      } else {
        hcheck += 1;
      }
    }
  }

  // --- Rumpf: gechunkt aufloesen oder unveraendert uebernehmen ---
  if (isChunked != 0 && bodyStart > 0) {
    var chunkBody: int64 := mmap(0, totalRead + 1, PROT_RW, MAP_ANON, FD_NONE, 0);
    if (chunkBody != 0) {
      var cpos: int64 := bodyStart;
      var wpos: int64 := 0;
      var doneChunk: int64 := 0;
      while (doneChunk == 0 && cpos < totalRead) {
        var chunkSz: int64 := 0;
        while (cpos < totalRead) {
          var hc: int64 := peek8(buf + cpos);
          if (hc == 13 || hc == 10) { cpos := cpos; break; }
          if (hc >= 48 && hc <= 57)       { chunkSz := chunkSz * 16 + (hc - 48); }
          else if (hc >= 65 && hc <= 70)  { chunkSz := chunkSz * 16 + (hc - 55); }
          else if (hc >= 97 && hc <= 102) { chunkSz := chunkSz * 16 + (hc - 87); }
          cpos += 1;
        }
        if (cpos < totalRead && peek8(buf + cpos) == 13) { cpos := cpos + 1; }
        if (cpos < totalRead && peek8(buf + cpos) == 10) { cpos := cpos + 1; }
        if (chunkSz == 0) { doneChunk := 1; }
        else {
          var cj: int64 := 0;
          while (cj < chunkSz && cpos < totalRead) {
            poke8(chunkBody + wpos, peek8(buf + cpos));
            wpos += 1; cpos := cpos + 1; cj := cj + 1;
          }
          if (cpos < totalRead && peek8(buf + cpos) == 13) { cpos := cpos + 1; }
          if (cpos < totalRead && peek8(buf + cpos) == 10) { cpos := cpos + 1; }
        }
      }
      poke8(chunkBody + wpos, 0);
      res.bodyPtr := chunkBody;
      res.bodySize := wpos;
    }
    return res;
  }

  if (bodyStart > 0) {
    var bodyLen: int64 := totalRead - bodyStart;
    if (res.contentLength > 0 && res.contentLength < bodyLen) {
      bodyLen := res.contentLength;
    }
    if (bodyLen > 0) {
      res.bodyPtr := mmap(0, bodyLen + 1, PROT_RW, MAP_ANON, FD_NONE, 0);
      if (res.bodyPtr != 0) {
        var j: int64 := 0;
        while (j < bodyLen) {
          poke8(res.bodyPtr + j, peek8(buf + bodyStart + j));
          j += 1;
        }
        poke8(res.bodyPtr + bodyLen, 0);
        res.bodySize := bodyLen;
      }
    }
  }
  return res;
}

// Wieviele Bytes fehlen laut Content-Length noch? 0 = nichts oder unbekannt.
// Wird vor dem Parsen gebraucht, damit der Leser weiterlesen kann.
pub fn HTTPBodyRest(buf: int64, totalRead: int64): int64 {
  var probe: HTTPResponse;
  probe.statusCode := 0; probe.statusText := 0; probe.headerCount := 0;
  probe.contentLength := 0; probe.bodyPtr := 0; probe.bodySize := 0;
  probe.headersRaw := 0; probe.headersSize := 0;
  var bodyStart: int64 := 0;
  var i: int64 := 0;
  while (i < totalRead - 4) {
    if (peek8(buf + i) == 13 && peek8(buf + i + 1) == 10 &&
        peek8(buf + i + 2) == 13 && peek8(buf + i + 3) == 10) {
      bodyStart := i + 4;
      i := totalRead;
    } else {
      i += 1;
    }
  }
  if (bodyStart == 0) { return 0; }
  var g: HTTPResponse := HTTPParseResponse(probe, buf, totalRead);
  if (g.bodyPtr != 0) { munmap(g.bodyPtr, g.bodySize + 1); }
  if (g.headersRaw != 0) { munmap(g.headersRaw, g.headersSize + 1); }
  if (g.contentLength <= 0) { return 0; }
  var da: int64 := totalRead - bodyStart;
  if (g.contentLength <= da) { return 0; }
  return g.contentLength - da;
}

pub fn HTTPSend(request: HTTPRequest): HTTPResponse {
  var response: HTTPResponse;
  response.statusCode := 0;
  response.statusText := 0;
  response.headerCount := 0;
  response.contentLength := 0;
  response.bodyPtr := 0;
  response.bodySize := 0;
  response.headersRaw := 0;
  response.headersSize := 0;

  // Resolve hostname
  var ip: int64 := GetHostByName(request.host);
  if (ip == 0) { return response; }

  // Connect
  var conn: TCPConn := TCPConnect(ip, request.port);
  if (conn.fd < 0) { return response; }
  var sock: int64 := conn.fd;

  // Build request (validated + dynamically sized)
  var reqBuf: int64 := HTTPRequestBuild(request);
  if (reqBuf == 0) { sys_close(sock); return response; }

  // Read metadata from buffer header
  var allocSize: int64 := peek64(reqBuf);
  var reqSize:   int64 := peek64(reqBuf + 8);

  // WP-9.3: Sende nur tatsächliche Request-Bytes
  var n: int64 := sys_write(sock, reqBuf + 16, reqSize);
  munmap(reqBuf, allocSize);

  if (n < 0) { sys_close(sock); return response; }

  // WP-9.4: Lese Response in Schleife basierend auf Content-Length
  // Initial read: 8192 bytes (response header + start of body)
  var bufSize: int64 := 8192;
  var buf: int64 := mmap(0, bufSize, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (buf == 0) { sys_close(sock); return response; }

  // WP-9.5: Erstes Lesen mit Timeout
  n := http_readTimeout(sock, buf, bufSize, HTTP_RECV_TIMEOUT_MS);
  if (n <= 0) { sys_close(sock); munmap(buf, bufSize); return response; }
  var totalRead: int64 := n;

  // #1534/#1539: Hier stand der Parser ein zweites Mal (Statuszeile,
  // Content-Length, Kopfzeilen, chunked). Er steht jetzt EINMAL in
  // HTTPParseResponse; hier bleibt nur, was diesen Weg ausmacht: bei bekannter
  // Content-Length nachlesen, bis der Rumpf vollstaendig ist.
  var rest: int64 := HTTPBodyRest(buf, totalRead);
  if (rest > 0) {
    var newSize: int64 := totalRead + rest + 1;
    var newBuf: int64 := mmap(0, newSize, PROT_RW, MAP_ANON, FD_NONE, 0);
    if (newBuf != 0) {
      var j: int64 := 0;
      while (j < totalRead) { poke8(newBuf + j, peek8(buf + j)); j := j + 1; }
      munmap(buf, bufSize);
      buf := newBuf; bufSize := newSize;
      var pos: int64 := totalRead;
      var remaining: int64 := rest;
      while (remaining > 0) {
        var ck: int64 := http_readTimeout(sock, buf + pos, remaining, HTTP_RECV_TIMEOUT_MS);
        if (ck <= 0) { remaining := 0; }
        else { pos += ck; remaining := remaining - ck; }
      }
      totalRead := pos;
    }
  }

  sys_close(sock);
  response := HTTPParseResponse(response, buf, totalRead);
  munmap(buf, bufSize);
  return response;
}

// Free HTTP response body and headers
pub fn HTTPResponseFree(response: HTTPResponse) {
  if (response.bodyPtr != 0) {
    munmap(response.bodyPtr, response.bodySize + 1);
  }
  // WP-C6: free headersRaw
  if (response.headersRaw != 0) {
    munmap(response.headersRaw, response.headersSize + 1);
  }
}

