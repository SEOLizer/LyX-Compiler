// std/net/rest.lyx — REST API client (RFC 7230/7231) built on std/net/http + tls
//
// Provides a session-based REST client with base URL, Bearer/API-Key auth,
// automatic Content-Type for JSON requests, URL path builder and query string
// helper. Supports both HTTP and HTTPS transparently.
//
// Public API:
//   RestClientInit(client, baseUrl, token)        parse URL, set Bearer token
//   RestClientSetBearerToken(client, token)       replace/add Bearer auth
//   RestClientSetApiKey(client, name, value)      add arbitrary header (e.g. X-API-Key)
//   RestClientFree(client)                        free all resources
//
//   RestGet(client, path)                → HTTPResponse
//   RestPost(client, path, body, blen)   → HTTPResponse
//   RestPut(client, path, body, blen)    → HTTPResponse
//   RestDelete(client, path)             → HTTPResponse
//   RestPatch(client, path, body, blen)  → HTTPResponse
//
//   RestJsonPost(client, path, json, jlen) → HTTPResponse  (+Content-Type: application/json)
//   RestJsonPut(client, path, json, jlen)  → HTTPResponse  (+Content-Type: application/json)
//
//   RestBuildPath(client, path, out, outMax) → int64   full path length
//   RestQueryAppend(buf, bufMax, key, value) → int64   new buf length
//
//   RestIsSuccess(code)     → 1 if 2xx
//   RestIsClientError(code) → 1 if 4xx
//   RestIsServerError(code) → 1 if 5xx

@description("Session-based REST client: base URL, auth headers, JSON helpers, HTTP+HTTPS")
@author("Andreas Röne")
@copyright("2025-2026 Andreas Röne")
unit std.net.rest;

import std.net.http;
import std.net.socket;
import std.net.dns;
import std.net.tls;
import std.net.types;
import std.alloc;

// ============================================================================
// RestClient struct layout (REST_SIZE bytes, caller allocs)
// ============================================================================
pub con REST_OFF_HOST:     int64 := 0;   // int64: alloc'd host string ptr
pub con REST_OFF_HOSTLEN:  int64 := 8;   // int64: host string length
pub con REST_OFF_BASEPATH: int64 := 16;  // int64: alloc'd base path ptr
pub con REST_OFF_PATHLEN:  int64 := 24;  // int64: base path length
pub con REST_OFF_AUTHHDRS: int64 := 32;  // int64: mmap'd auth header string (or 0)
pub con REST_OFF_HTTPS:    int64 := 40;  // int64: 0=HTTP, 1=HTTPS
pub con REST_OFF_PORT:     int64 := 48;  // int64: 0=default (80/443)
pub con REST_SIZE:         int64 := 56;

// ============================================================================
// Internal helpers
// ============================================================================

fn restStrLen(p: int64): int64 {
    var n: int64 := 0;
    while (peek8(p + n) != 0) { n := n + 1; }
    return n;
}

fn restCopyN(dst: int64, src: int64, n: int64): void {
    var i: int64 := 0;
    while (i < n) { poke8(dst + i, peek8(src + i)); i := i + 1; }
}

// Compare n bytes of buf[pos..] against pchar literal s
fn restMatchN(buf: int64, s: pchar, n: int64): int64 {
    var i: int64 := 0;
    while (i < n) {
        if (peek8(buf + i) != StrCharAt(s, i)) { return 0; }
        i += 1;
    }
    return 1;
}

fn restIsUrlSafe(c: int64): int64 {
    if (c >= 0x41 && c <= 0x5A) { return 1; }   // A-Z
    if (c >= 0x61 && c <= 0x7A) { return 1; }   // a-z
    if (c >= 0x30 && c <= 0x39) { return 1; }   // 0-9
    if (c == 0x2D || c == 0x2E || c == 0x5F || c == 0x7E) { return 1; }  // - . _ ~
    return 0;
}

fn restHexChar(v: int64): int64 {
    if (v < 10) { return 0x30 + v; }  // '0'-'9'
    return 0x41 + v - 10;              // 'A'-'F'
}

// Duplicate an mmap'd header string (so we can safely append to it)
fn restCopyHeaders(hdrs: int64): int64 {
    if (hdrs == 0) { return 0; }
    var len: int64 := restStrLen(hdrs);
    var nb: int64 := mmap(0, len + 1, PROT_RW, MAP_ANON, FD_NONE, 0);
    if (nb == 0) { return 0; }
    restCopyN(nb, hdrs, len + 1);
    return nb;
}

// ============================================================================
// Response parser — shared by restSendHttp and restSendHttps
// Scans raw HTTP response bytes, extracts status code + body.
// ============================================================================
fn restParseResponse(buf: int64, total: int64): HTTPResponse {
    var resp: HTTPResponse;
    resp.statusCode   := 0;
    resp.statusText   := 0;
    resp.headerCount  := 0;
    resp.contentLength:= 0;
    resp.bodyPtr      := 0;
    resp.bodySize     := 0;
    resp.headersRaw   := 0;
    resp.headersSize  := 0;

    if (total <= 0) { return resp; }

    // Status code: scan for "HTTP/" then skip 4 bytes ("1.1 ") and read 3 digits
    var i: int64 := 0;
    while (i < total - 12) {
        if (peek8(buf+i)==72 && peek8(buf+i+1)==84 && peek8(buf+i+2)==84 &&
            peek8(buf+i+3)==80 && peek8(buf+i+4)==47) {
            i += 9;
            resp.statusCode := (peek8(buf+i)-48)*100 + (peek8(buf+i+1)-48)*10 + (peek8(buf+i+2)-48);
            break;
        }
        i += 1;
    }

    // Content-Length — case-insensitive scan for "content-length"
    i := 0;
    while (i < total - 16) {
        if ((peek8(buf+i)|32)==99 && (peek8(buf+i+1)|32)==111 && (peek8(buf+i+2)|32)==110 &&
            (peek8(buf+i+3)|32)==116 && (peek8(buf+i+4)|32)==101 && (peek8(buf+i+5)|32)==110 &&
            (peek8(buf+i+6)|32)==116 && (peek8(buf+i+7)|32)==45 &&
            (peek8(buf+i+8)|32)==108 && (peek8(buf+i+9)|32)==101 && (peek8(buf+i+10)|32)==110 &&
            (peek8(buf+i+11)|32)==103 && (peek8(buf+i+12)|32)==116 && (peek8(buf+i+13)|32)==104) {
            i += 14;
            while (i < total && (peek8(buf+i) < 48 || peek8(buf+i) > 57)) { i := i + 1; }
            resp.contentLength := 0;
            while (i < total) {
                var d: int64 := peek8(buf + i);
                if (d < 48 || d > 57) { break; }
                resp.contentLength := resp.contentLength * 10 + (d - 48);
                i += 1;
            }
            break;
        }
        i += 1;
    }

    // Body start: scan for \r\n\r\n
    i := 0;
    var bodyStart: int64 := 0;
    while (i < total - 4) {
        if (peek8(buf+i)==13 && peek8(buf+i+1)==10 && peek8(buf+i+2)==13 && peek8(buf+i+3)==10) {
            bodyStart := i + 4;
            break;
        }
        i += 1;
    }

    if (bodyStart > 0 && bodyStart < total) {
        var bodyLen: int64 := total - bodyStart;
        resp.bodyPtr := mmap(0, bodyLen + 1, PROT_RW, MAP_ANON, FD_NONE, 0);
        if (resp.bodyPtr != 0) {
            restCopyN(resp.bodyPtr, buf + bodyStart, bodyLen);
            poke8(resp.bodyPtr + bodyLen, 0);  // NUL-terminate for string use
            resp.bodySize := bodyLen;
        }
    }

    return resp;
}

// ============================================================================
// restSendHttps — HTTPS request with custom headers and all HTTP methods
// ============================================================================
fn restSendHttps(host: int64, path: int64, method: int64, body: int64, bodyLen: int64, hdrs: int64): HTTPResponse {
    var response: HTTPResponse;
    response.statusCode    := 0;
    response.statusText    := 0;
    response.headerCount   := 0;
    response.contentLength := 0;
    response.bodyPtr       := 0;
    response.bodySize      := 0;
    response.headersRaw    := 0;
    response.headersSize   := 0;

    var ctx: TLSContext := TLSInit();
    if (ctx.initialized == 0) { return response; }

    var ip: int64 := GetHostByName(host as pchar);
    if (ip == 0) { TLSFree(ctx); return response; }

    var tcpConn: TCPConn := TCPConnect(ip, HTTPS_PORT);
    if (tcpConn.fd < 0) { TLSFree(ctx); return response; }

    var conn: TLSConn := TLSConnect(ctx, tcpConn.fd, host as pchar);
    if (conn.connected == 0) { sys_close(tcpConn.fd); TLSFree(ctx); return response; }

    var req: HTTPRequest;
    req.method   := method;
    req.host     := host;
    req.path     := path;
    req.port     := HTTPS_PORT;
    req.headers  := hdrs;
    req.body     := body;
    req.bodySize := bodyLen;

    var reqBuf: int64 := HTTPRequestBuild(req);
    if (reqBuf == 0) { TLSClose(conn); sys_close(tcpConn.fd); TLSFree(ctx); return response; }

    var allocSz: int64 := peek64(reqBuf);
    var reqSz:   int64 := peek64(reqBuf + 8);
    TLSWrite(conn, reqBuf + 16, reqSz);
    munmap(reqBuf, allocSz);

    // Read full response into growable buffer (server closes on "Connection: close")
    var cap: int64 := 65536;
    var buf: int64 := mmap(0, cap, PROT_RW, MAP_ANON, FD_NONE, 0);
    if (buf == 0) { TLSClose(conn); sys_close(tcpConn.fd); TLSFree(ctx); return response; }
    var total: int64 := 0;
    while (true) {
        if (total + 16384 > cap) {
            var newCap: int64 := cap * 2;
            var nb: int64 := mmap(0, newCap, PROT_RW, MAP_ANON, FD_NONE, 0);
            if (nb == 0) { break; }
            restCopyN(nb, buf, total);
            munmap(buf, cap);
            buf := nb;
            cap := newCap;
        }
        var r: int64 := TLSRead(conn, buf + total, 16384);
        if (r <= 0) { break; }
        total += r;
        if (total >= 67108864) { break; }  // 64 MiB safety cap
    }
    TLSClose(conn);
    sys_close(tcpConn.fd);
    TLSFree(ctx);

    response := restParseResponse(buf, total);
    munmap(buf, cap);
    return response;
}

// ============================================================================
// restSendHttp — plain HTTP request with custom headers and all HTTP methods
// ============================================================================
fn restSendHttp(host: int64, path: int64, method: int64, body: int64, bodyLen: int64, hdrs: int64): HTTPResponse {
    var req: HTTPRequest;
    req.method   := method;
    req.host     := host;
    req.path     := path;
    req.port     := HTTP_PORT;
    req.headers  := hdrs;
    req.body     := body;
    req.bodySize := bodyLen;
    return HTTPSend(req);
}

// ============================================================================
// restBuildFullPath — merge basePath from client with the request path
// ============================================================================
fn restBuildFullPath(client: int64, path: int64, out: int64, outMax: int64): int64 {
    var basePath: int64 := peek64(client + REST_OFF_BASEPATH);
    var baseLen:  int64 := peek64(client + REST_OFF_PATHLEN);
    var pos: int64 := 0;

    // Write basePath into out
    var i: int64 := 0;
    while (i < baseLen && pos < outMax - 1) {
        poke8(out + pos, peek8(basePath + i));
        pos += 1;
        i += 1;
    }

    // Determine where to start appending path
    var pathStart: int64 := path;
    var pathLen: int64 := restStrLen(path);

    if (pathLen > 0) {
        // If basePath ends with '/' and path starts with '/', skip the leading '/' of path
        if (pos > 0 && peek8(out + pos - 1) == 0x2F && peek8(pathStart) == 0x2F) {
            pathStart += 1;
            pathLen   := pathLen - 1;
        }
        // If neither side has '/', insert one
        if (pos > 0 && peek8(out + pos - 1) != 0x2F && peek8(pathStart) != 0x2F) {
            poke8(out + pos, 0x2F); pos := pos + 1;
        }
        i := 0;
        while (i < pathLen && pos < outMax - 1) {
            poke8(out + pos, peek8(pathStart + i)); pos := pos + 1; i := i + 1;
        }
    }

    if (pos == 0) { poke8(out, 0x2F); poke8(out+1, 0); return 1; }
    poke8(out + pos, 0);
    return pos;
}

// ============================================================================
// restSend — dispatch to HTTP or HTTPS based on client config
// ============================================================================
fn restSend(client: int64, path: int64, method: int64, body: int64, bodyLen: int64, hdrs: int64): HTTPResponse {
    var fullPath: int64 := alloc(2048);
    restBuildFullPath(client, path, fullPath, 2048);
    var host:     int64 := peek64(client + REST_OFF_HOST);
    var useHttps: int64 := peek64(client + REST_OFF_HTTPS);
    var resp: HTTPResponse;
    if (useHttps != 0) {
        resp := restSendHttps(host, fullPath, method, body, bodyLen, hdrs);
    } else {
        resp := restSendHttp(host, fullPath, method, body, bodyLen, hdrs);
    }
    free(fullPath, 2048);
    return resp;
}

// ============================================================================
// RestClientInit — parse base URL, optionally set Bearer token
//   baseUrl: "https://api.example.com/v1" or "http://localhost:8080"
//   token:   Bearer token string (or 0 for none)
// ============================================================================
pub fn RestClientInit(client: int64, baseUrl: int64, token: int64): void {
    // Zero the struct
    var zi: int64 := 0;
    while (zi < REST_SIZE) { poke8(client + zi, 0); zi := zi + 1; }

    // Determine scheme
    var p: int64 := baseUrl;
    var useHttps: int64 := 0;
    if (restMatchN(p, "https://"c, 8) != 0) { useHttps := 1; p := p + 8; }
    if (useHttps == 0 && restMatchN(p, "http://"c, 7) != 0) { p := p + 7; }

    // Extract host: p to first '/' or '\0'
    var hostEnd: int64 := p;
    while (peek8(hostEnd) != 0 && peek8(hostEnd) != 0x2F) { hostEnd := hostEnd + 1; }
    var hostLen: int64 := hostEnd - p;

    var hostBuf: int64 := alloc(hostLen + 1);
    restCopyN(hostBuf, p, hostLen);
    poke8(hostBuf + hostLen, 0);
    poke64(client + REST_OFF_HOST,    hostBuf);
    poke64(client + REST_OFF_HOSTLEN, hostLen);

    // Extract basePath: from first '/' onward (or default "/")
    var pathSrc: int64 := hostEnd;
    var pathLen: int64 := restStrLen(pathSrc);
    if (pathLen == 0) { pathLen := 1; }  // default "/"
    var pathBuf: int64 := alloc(pathLen + 1);
    if (peek8(pathSrc) == 0x2F) {
        restCopyN(pathBuf, pathSrc, pathLen);
    } else {
        poke8(pathBuf, 0x2F);  // '/'
    }
    poke8(pathBuf + pathLen, 0);
    poke64(client + REST_OFF_BASEPATH, pathBuf);
    poke64(client + REST_OFF_PATHLEN,  pathLen);

    poke64(client + REST_OFF_HTTPS, useHttps);
    poke64(client + REST_OFF_PORT,  0);

    // Optional Bearer token
    if (token != 0) {
        var authHdrs: int64 := HTTPSetBearerToken(0, token);
        poke64(client + REST_OFF_AUTHHDRS, authHdrs);
    }
}

// ============================================================================
// RestClientSetBearerToken — add/replace "Authorization: Bearer <token>"
// (appends to any existing auth headers)
// ============================================================================
pub fn RestClientSetBearerToken(client: int64, token: int64): void {
    var existing: int64 := peek64(client + REST_OFF_AUTHHDRS);
    var newHdrs: int64 := HTTPSetBearerToken(existing, token);
    poke64(client + REST_OFF_AUTHHDRS, newHdrs);
}

// ============================================================================
// RestClientSetApiKey — add arbitrary header (e.g. "X-API-Key: secret")
// ============================================================================
pub fn RestClientSetApiKey(client: int64, headerName: int64, value: int64): void {
    var existing: int64 := peek64(client + REST_OFF_AUTHHDRS);
    var newHdrs: int64 := HTTPSetHeader(existing, headerName, value);
    poke64(client + REST_OFF_AUTHHDRS, newHdrs);
}

// ============================================================================
// RestClientFree — release all resources held by the client struct
// ============================================================================
pub fn RestClientFree(client: int64): void {
    var hostBuf:  int64 := peek64(client + REST_OFF_HOST);
    var hostLen:  int64 := peek64(client + REST_OFF_HOSTLEN);
    if (hostBuf != 0)  { free(hostBuf, hostLen + 1); }

    var pathBuf:  int64 := peek64(client + REST_OFF_BASEPATH);
    var pathLen:  int64 := peek64(client + REST_OFF_PATHLEN);
    if (pathBuf != 0)  { free(pathBuf, pathLen + 1); }

    var authHdrs: int64 := peek64(client + REST_OFF_AUTHHDRS);
    if (authHdrs != 0) { HTTPHeadersFree(authHdrs); }

    var zi: int64 := 0;
    while (zi < REST_SIZE) { poke8(client + zi, 0); zi := zi + 1; }
}

// ============================================================================
// RestBuildPath — public path builder for URL construction
// ============================================================================
pub fn RestBuildPath(client: int64, path: int64, out: int64, outMax: int64): int64 {
    return restBuildFullPath(client, path, out, outMax);
}

// ============================================================================
// Basic HTTP methods
// ============================================================================
pub fn RestGet(client: int64, path: int64): HTTPResponse {
    var authHdrs: int64 := peek64(client + REST_OFF_AUTHHDRS);
    return restSend(client, path, HTTP_GET, 0, 0, authHdrs);
}

pub fn RestPost(client: int64, path: int64, body: int64, bodyLen: int64): HTTPResponse {
    var authHdrs: int64 := peek64(client + REST_OFF_AUTHHDRS);
    return restSend(client, path, HTTP_POST, body, bodyLen, authHdrs);
}

pub fn RestPut(client: int64, path: int64, body: int64, bodyLen: int64): HTTPResponse {
    var authHdrs: int64 := peek64(client + REST_OFF_AUTHHDRS);
    return restSend(client, path, HTTP_PUT, body, bodyLen, authHdrs);
}

pub fn RestDelete(client: int64, path: int64): HTTPResponse {
    var authHdrs: int64 := peek64(client + REST_OFF_AUTHHDRS);
    return restSend(client, path, HTTP_DELETE, 0, 0, authHdrs);
}

pub fn RestPatch(client: int64, path: int64, body: int64, bodyLen: int64): HTTPResponse {
    var authHdrs: int64 := peek64(client + REST_OFF_AUTHHDRS);
    return restSend(client, path, HTTP_PATCH, body, bodyLen, authHdrs);
}

// ============================================================================
// JSON convenience methods — auto-add Content-Type: application/json
// ============================================================================
pub fn RestJsonPost(client: int64, path: int64, json: int64, jsonLen: int64): HTTPResponse {
    var baseHdrs: int64 := peek64(client + REST_OFF_AUTHHDRS);
    var hdrs: int64 := restCopyHeaders(baseHdrs);
    var ctName: pchar := "Content-Type"c;
    var ctVal:  pchar := "application/json"c;
    hdrs := HTTPSetHeader(hdrs, ctName as int64, ctVal as int64);
    var resp: HTTPResponse := restSend(client, path, HTTP_POST, json, jsonLen, hdrs);
    if (hdrs != 0) { HTTPHeadersFree(hdrs); }
    return resp;
}

pub fn RestJsonPut(client: int64, path: int64, json: int64, jsonLen: int64): HTTPResponse {
    var baseHdrs: int64 := peek64(client + REST_OFF_AUTHHDRS);
    var hdrs: int64 := restCopyHeaders(baseHdrs);
    var ctName: pchar := "Content-Type"c;
    var ctVal:  pchar := "application/json"c;
    hdrs := HTTPSetHeader(hdrs, ctName as int64, ctVal as int64);
    var resp: HTTPResponse := restSend(client, path, HTTP_PUT, json, jsonLen, hdrs);
    if (hdrs != 0) { HTTPHeadersFree(hdrs); }
    return resp;
}

// ============================================================================
// RestQueryAppend — append ?key=value or &key=value to a URL buffer
// Scans for existing '?' to decide separator. Percent-encodes the value.
// Returns new string length (excluding NUL).
// ============================================================================
pub fn RestQueryAppend(buf: int64, bufMax: int64, key: int64, value: int64): int64 {
    // Find current end and whether '?' already exists
    var len: int64 := 0;
    var hasQ: int64 := 0;
    while (peek8(buf + len) != 0) {
        if (peek8(buf + len) == 0x3F) { hasQ := 1; }
        len += 1;
    }

    if (len >= bufMax - 1) { return len; }
    if (hasQ != 0) {
        poke8(buf + len, 0x26); len := len + 1;  // '&'
    } else {
        poke8(buf + len, 0x3F); len := len + 1;  // '?'
    }

    // Append key (no encoding — assume safe identifier)
    var i: int64 := 0;
    while (peek8(key + i) != 0 && len < bufMax - 1) {
        poke8(buf + len, peek8(key + i)); len := len + 1; i := i + 1;
    }

    if (len < bufMax - 1) { poke8(buf + len, 0x3D); len := len + 1; }  // '='

    // Append value with percent encoding
    i := 0;
    while (peek8(value + i) != 0 && len < bufMax - 4) {
        var c: int64 := peek8(value + i);
        if (restIsUrlSafe(c) != 0) {
            poke8(buf + len, c); len := len + 1;
        } else {
            poke8(buf + len,     0x25);                // '%'
            poke8(buf + len + 1, restHexChar((c >> 4) & 15));
            poke8(buf + len + 2, restHexChar(c & 15));
            len += 3;
        }
        i += 1;
    }

    poke8(buf + len, 0);
    return len;
}

// ============================================================================
// Status code helpers
// ============================================================================
pub fn RestIsSuccess(statusCode: int64): int64 {
    if (statusCode >= 200 && statusCode < 300) { return 1; }
    return 0;
}

pub fn RestIsClientError(statusCode: int64): int64 {
    if (statusCode >= 400 && statusCode < 500) { return 1; }
    return 0;
}

pub fn RestIsServerError(statusCode: int64): int64 {
    if (statusCode >= 500 && statusCode < 600) { return 1; }
    return 0;
}
