// Lyx MongoDB Client
// MongoDB wire protocol client
//
// Features:
//   - TCP connection to MongoDB
//   - BSON type constants and document buffer
//   - Wire protocol opcodes
//   - CRUD send/read operations
//   - Collection name builder
//   - Authentication constants
//   - Connection pool struct
//
// Usage:
//   import std.net.mongo;
//   var conn: MongoConn := MongoConnect("localhost", 27017);
//   if (MongoIsConnected(conn)) {
//     // perform operations
//   }
//   MongoDisconnect(conn);
@capabilities([fs.read, fs.write, network.tcp.bind, network.tcp.connect, network.udp.connect])

unit std.net.mongo;

import std.alloc;
import std.net.socket;
import std.net.dns;
import std.net.tls;

// OpenSSL crypto for SCRAM-SHA-256 (WP-4.2)
extern fn EVP_sha256(): int64 link "libcrypto.so.3";
extern fn HMAC(evp: int64, key: int64, keylen: int64, data: int64, datalen: int64, md: int64, mdlen: int64): int64 link "libcrypto.so.3";
extern fn PKCS5_PBKDF2_HMAC(pass: int64, passlen: int64, salt: int64, saltlen: int64, iter: int64, digest: int64, keylen: int64, out: int64): int64 link "libcrypto.so.3";
extern fn SHA256(data: int64, n: int64, md: int64): int64 link "libcrypto.so.3";

// OpenSSL base64 (WP-4.2)
extern fn EVP_EncodeBlock(out: int64, in_: int64, inl: int64): int64 link "libcrypto.so.3";
extern fn EVP_DecodeBlock(out: int64, in_: int64, inl: int64): int64 link "libcrypto.so.3";

// /dev/urandom for SCRAM nonce (WP-4.2)
// #1179: ein erfundenes Symbol ohne link-Klausel — nie gebunden, Rueckgabe
// still 0. Null ist ein GUELTIGER Deskriptor (stdin), das anschliessende Lesen
// holte die Zufallsbytes also von der Standardeingabe. `sys_open` ist das
// Builtin fuer Syscall 2.
fn mongo_urandom_open(path: int64, flags: int64, mode: int64): int64 {
  return sys_open(path, flags, mode);
}

// MongoDB port
pub con MONGO_PORT: int64 := 27017;

// WP7: Connection pool
pub type MongoPool = struct {
  host: int64;
  port: int64;
  count: int64;
  max: int64;
};

// MongoDB connection
pub type MongoConn = struct {
  fd: int64;           // TCP socket fd
  connected: int64;    // 1 if connected
  host: int64;         // host string pointer
  port: int64;         // port number
  tls_enabled: int64;  // 1 if TLS active (WP-4.1)
  tls_ssl: int64;      // raw SSL* pointer
  tls_ctx: int64;      // raw SSL_CTX* pointer
};

// WP1: Connect to MongoDB
pub fn MongoConnect(host: int64, port: int64): MongoConn {
  var conn: MongoConn;
  var ip: int64;
  
  conn.fd := -1;
  conn.connected := 0;
  conn.host := host;
  conn.port := port;
  
  ip := GetHostByName(host as pchar);
  if (ip == 0) {
    return conn;
  }
  
  var tcp: TCPConn := TCPConnect(ip, port);
  if (tcp.fd < 0) {
    return conn;
  }
  
  TCPConnSetNodelay(tcp, true);
  
  conn.fd := tcp.fd;
  conn.connected := 1;
  conn.tls_enabled := 0;
  conn.tls_ssl := 0;
  conn.tls_ctx := 0;

  return conn;
}

// WP1: Disconnect from MongoDB
pub fn MongoDisconnect(ref conn: MongoConn) {
  if (conn.tls_enabled != 0) {
    if (conn.tls_ssl != 0) {
      SSL_shutdown(conn.tls_ssl);
      SSL_free(conn.tls_ssl);
    }
    if (conn.tls_ctx != 0) {
      SSL_CTX_free(conn.tls_ctx);
    }
    conn.tls_ssl := 0;
    conn.tls_ctx := 0;
    conn.tls_enabled := 0;
  }
  if (conn.fd >= 0) {
    sys_close(conn.fd);
  }
  conn.fd := -1;
  conn.connected := 0;
}

// WP1: Check if connected
pub fn MongoIsConnected(conn: MongoConn): bool {
  if (conn.connected == 1 && conn.fd >= 0) {
    return true;
  }
  return false;
}

// WP2: BSON type constants
pub con BSON_DOUBLE: int64 := 1;
pub con BSON_STRING: int64 := 2;
pub con BSON_DOCUMENT: int64 := 3;
pub con BSON_ARRAY: int64 := 4;
pub con BSON_BINARY: int64 := 5;
pub con BSON_UNDEFINED: int64 := 6;
pub con BSON_OBJECTID: int64 := 7;
pub con BSON_BOOL: int64 := 8;
pub con BSON_NULL: int64 := 9;
pub con BSON_INT32: int64 := 16;
pub con BSON_TIMESTAMP: int64 := 17;
pub con BSON_INT64: int64 := 18;
pub con BSON_MINKEY: int64 := 255;
pub con BSON_MAXKEY: int64 := 127;

// WP2: BSON document buffer
pub type MongoDoc = struct {
  data: int64;     // pointer to buffer
  size: int64;     // buffer size
  len: int64;     // used length
};

// WP2: Create new document — len starts at 4 to reserve BSON length header
pub fn MongoDocNew(): MongoDoc {
  var doc: MongoDoc;
  doc.data := mmap(0, 4096, PROT_RW, MAP_ANON, FD_NONE, 0);
  doc.size := 4096;
  doc.len := 4;  // reserve 4 bytes for BSON document length (written by Finalize)
  return doc;
}

// WP2 / WP-4.3: Add UTF-8 string field — BSON type 0x02
// BSON element: type(1) + key(cstring) + strLen(int32 LE) + value(bytes) + null(1)
pub fn MongoDocAddString(ref doc: MongoDoc, key: int64, value: int64): int64 {
  if (doc.data == 0) { return -1; }
  var keyLen: int64 := 0;
  while (peek8(key + keyLen) != 0) { keyLen := keyLen + 1; }
  var valLen: int64 := 0;
  while (peek8(value + valLen) != 0) { valLen := valLen + 1; }
  var need: int64 := 1 + keyLen + 1 + 4 + valLen + 1;
  if (doc.len + need >= doc.size) { return -1; }
  var pos: int64 := doc.len;
  poke8(doc.data + pos, 2); pos := pos + 1;  // BSON_STRING
  var i: int64 := 0;
  while (i < keyLen) { poke8(doc.data + pos, peek8(key + i)); pos := pos + 1; i := i + 1; }
  poke8(doc.data + pos, 0); pos := pos + 1;
  var slen: int64 := valLen + 1;
  poke8(doc.data + pos, slen & 0xFF);         pos := pos + 1;
  poke8(doc.data + pos, (slen >> 8) & 0xFF);  pos := pos + 1;
  poke8(doc.data + pos, (slen >> 16) & 0xFF); pos := pos + 1;
  poke8(doc.data + pos, (slen >> 24) & 0xFF); pos := pos + 1;
  i := 0;
  while (i < valLen) { poke8(doc.data + pos, peek8(value + i)); pos := pos + 1; i := i + 1; }
  poke8(doc.data + pos, 0); pos := pos + 1;
  doc.len := pos;
  return 0;
}

// WP-4.3: Add int32 field — BSON type 0x10
pub fn MongoDocAddInt32(ref doc: MongoDoc, key: int64, value: int64): int64 {
  if (doc.data == 0) { return -1; }
  var keyLen: int64 := 0;
  while (peek8(key + keyLen) != 0) { keyLen := keyLen + 1; }
  var need: int64 := 1 + keyLen + 1 + 4;
  if (doc.len + need >= doc.size) { return -1; }
  var pos: int64 := doc.len;
  poke8(doc.data + pos, 16); pos := pos + 1;  // BSON_INT32
  var i: int64 := 0;
  while (i < keyLen) { poke8(doc.data + pos, peek8(key + i)); pos := pos + 1; i := i + 1; }
  poke8(doc.data + pos, 0); pos := pos + 1;
  poke8(doc.data + pos, value & 0xFF);         pos := pos + 1;
  poke8(doc.data + pos, (value >> 8) & 0xFF);  pos := pos + 1;
  poke8(doc.data + pos, (value >> 16) & 0xFF); pos := pos + 1;
  poke8(doc.data + pos, (value >> 24) & 0xFF); pos := pos + 1;
  doc.len := pos;
  return 0;
}

// WP-4.3: Add binary field — BSON type 0x05, subtype 0x00
pub fn MongoDocAddBinary(ref doc: MongoDoc, key: int64, data: int64, datalen: int64): int64 {
  if (doc.data == 0) { return -1; }
  var keyLen: int64 := 0;
  while (peek8(key + keyLen) != 0) { keyLen := keyLen + 1; }
  var need: int64 := 1 + keyLen + 1 + 4 + 1 + datalen;
  if (doc.len + need >= doc.size) { return -1; }
  var pos: int64 := doc.len;
  poke8(doc.data + pos, 5); pos := pos + 1;  // BSON_BINARY
  var i: int64 := 0;
  while (i < keyLen) { poke8(doc.data + pos, peek8(key + i)); pos := pos + 1; i := i + 1; }
  poke8(doc.data + pos, 0); pos := pos + 1;
  poke8(doc.data + pos, datalen & 0xFF);         pos := pos + 1;
  poke8(doc.data + pos, (datalen >> 8) & 0xFF);  pos := pos + 1;
  poke8(doc.data + pos, (datalen >> 16) & 0xFF); pos := pos + 1;
  poke8(doc.data + pos, (datalen >> 24) & 0xFF); pos := pos + 1;
  poke8(doc.data + pos, 0); pos := pos + 1;  // subtype = generic binary
  i := 0;
  while (i < datalen) { poke8(doc.data + pos, peek8(data + i)); pos := pos + 1; i := i + 1; }
  doc.len := pos;
  return 0;
}

// WP-4.3: Finalize document — writes BSON length header + trailing null
// Returns total document length in bytes.
pub fn MongoDocFinalize(ref doc: MongoDoc): int64 {
  if (doc.data == 0) { return 0; }
  poke8(doc.data + doc.len, 0);
  var total: int64 := doc.len + 1;
  doc.len := total;
  poke8(doc.data + 0, total & 0xFF);
  poke8(doc.data + 1, (total >> 8) & 0xFF);
  poke8(doc.data + 2, (total >> 16) & 0xFF);
  poke8(doc.data + 3, (total >> 24) & 0xFF);
  return total;
}

// WP3: Wire protocol opcodes
pub con MONGO_OP_REPLY: int64 := 1;
pub con MONGO_OP_MSG: int64 := 1000;
pub con MONGO_OP_UPDATE: int64 := 2001;
pub con MONGO_OP_INSERT: int64 := 2002;
pub con MONGO_OP_QUERY: int64 := 2004;
pub con MONGO_OP_GET_MORE: int64 := 2005;
pub con MONGO_OP_DELETE: int64 := 2006;
pub con MONGO_OP_KILL_CURSORS: int64 := 2007;

// WP4: Send request to MongoDB (TLS-aware, WP-4.1)
pub fn MongoSend(conn: MongoConn, data: int64, len: int64): int64 {
  if (conn.fd < 0 || conn.connected == 0) { return -1; }
  if (conn.tls_enabled != 0) {
    return SSL_write(conn.tls_ssl, data, len);
  }
  return sys_write(conn.fd, data, len);
}

// WP4: Read response from MongoDB (TLS-aware, WP-4.1)
pub fn MongoRead(conn: MongoConn, data: int64, len: int64): int64 {
  if (conn.fd < 0 || conn.connected == 0) { return -1; }
  if (conn.tls_enabled != 0) {
    return SSL_read(conn.tls_ssl, data, len);
  }
  return sys_read(conn.fd, data, len);
}

// WP5: Build full collection name (db.collection)
pub fn MongoCollectionName(db: int64, coll: int64): int64 {
  var buf: int64;
  var pos: int64;
  var dbLen: int64;
  var collLen: int64;
  
  dbLen := 0;
  while (peek8(db + dbLen) != 0) { dbLen := dbLen + 1; }
  collLen := 0;
  while (peek8(coll + collLen) != 0) { collLen := collLen + 1; }
  
  var mongoSz1: int64 := dbLen + 1;
  var mongoSz2: int64 := mongoSz1 + collLen;
  var mongoSz3: int64 := mongoSz2 + 1;
  buf := mmap(0, mongoSz3, PROT_RW, MAP_ANON, FD_NONE, 0);
  if (buf == 0) {
    return 0;
  }
  
  pos := 0;
  var i: int64 := 0;
  while (i < dbLen) {
    poke8(buf + pos, peek8(db + i));
    pos += 1;
    i += 1;
  }
  poke8(buf + pos, 46);  // dot
  pos += 1;
  i := 0;
  while (i < collLen) {
    poke8(buf + pos, peek8(coll + i));
    pos += 1;
    i += 1;
  }
  poke8(buf + pos, 0);
  
  return buf;
}

// WP6: Authentication constants
pub con MONGO_AUTH_PLAIN: int64 := 0;          // plaintext — only allowed over TLS (WP-4.4)
pub con MONGO_AUTH_SCRAM_SHA1: int64 := 1;     // legacy, not recommended
pub con MONGO_AUTH_SCRAM_SHA256: int64 := 2;   // recommended (WP-4.2)

