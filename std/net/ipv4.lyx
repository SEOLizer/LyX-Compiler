// std/net/ipv4.lyx — Pure IPv4 header builder + checksum
//
// Kernel-safe: no imports, no syscalls, no dynamic allocation.
// All functions operate on caller-provided buffers.
//
// Public API:
//   IpAddr(a, b, c, d)                                   → int64 (packed IP)
//   IpBroadcast()                                         → int64 (0xFFFFFFFF)
//   IpChecksum(hdr)                                       → int64 (16-bit ones-complement)
//   IpBuildHeader(buf, src, dst, proto, payload_len)      → int64 (20)
//
// Wire layout (20 bytes, RFC 791):
//   0     version+IHL (0x45 = IPv4, 5×4=20 bytes)
//   1     DSCP/ECN
//   2-3   total length (big-endian)
//   4-5   identification
//   6-7   flags+fragment offset (DF=0x4000)
//   8     TTL
//   9     protocol
//   10-11 header checksum
//   12-15 source address (big-endian)
//   16-19 destination address (big-endian)

unit std.net.ipv4;

pub con IPV4_HDR_SIZE: int64 := 20;

// IP protocol numbers
pub con IP_PROTO_ICMP: int64 := 1;
pub con IP_PROTO_TCP:  int64 := 6;
pub con IP_PROTO_UDP:  int64 := 17;
pub con IP_PROTO_RAW:  int64 := 255;

// IpAddr: packs four octets into a network-byte-order int64.
// IpAddr(192, 168, 1, 1) → 0xC0A80101
pub fn IpAddr(a: int64, b: int64, c: int64, d: int64): int64 {
    return (a << 24) | (b << 16) | (c << 8) | d;
}

// IpBroadcast: returns 255.255.255.255.
pub fn IpBroadcast(): int64 {
    return 0xFFFFFFFF;
}

// IpChecksum: RFC 1071 ones-complement checksum over a 20-byte IPv4 header.
// The checksum field (bytes 10-11) must be zeroed before calling.
// Returns the 16-bit checksum to store at offset 10.
pub fn IpChecksum(hdr: int64): int64 {
    var sum: int64 := 0;
    var i:   int64 := 0;
    while i < 20 {
        sum := sum + ((peek8(hdr+i) & 0xFF) << 8) + (peek8(hdr+i+1) & 0xFF);
        i := i + 2;
    }
    while (sum >> 16) != 0 {
        sum := (sum & 0xFFFF) + (sum >> 16);
    }
    return (~sum) & 0xFFFF;
}

// IpBuildHeader: writes a complete 20-byte IPv4 header into buf.
// src, dst: packed IPs (use IpAddr or IpBroadcast).
// proto:    IP_PROTO_UDP, IP_PROTO_TCP, etc.
// payload_len: length of the payload following the IP header (not including the 20-byte header).
// Returns: bytes written (20 = IPV4_HDR_SIZE).
pub fn IpBuildHeader(buf: int64, src: int64, dst: int64, proto: int64, payload_len: int64): int64 {
    var total: int64 := IPV4_HDR_SIZE + payload_len;
    poke8(buf+0,  0x45);                         // version=4, IHL=5 (20 bytes)
    poke8(buf+1,  0);                             // DSCP/ECN
    poke8(buf+2,  (total >> 8) & 0xFF);           // total length hi
    poke8(buf+3,  total & 0xFF);                  // total length lo
    poke8(buf+4,  0); poke8(buf+5, 0);            // identification
    poke8(buf+6,  0x40); poke8(buf+7, 0);         // DF flag, no fragment offset
    poke8(buf+8,  64);                            // TTL = 64
    poke8(buf+9,  proto & 0xFF);                  // protocol
    poke8(buf+10, 0); poke8(buf+11, 0);           // checksum placeholder (must be zero)
    poke8(buf+12, (src >> 24) & 0xFF);            // src IP byte 0
    poke8(buf+13, (src >> 16) & 0xFF);
    poke8(buf+14, (src >> 8)  & 0xFF);
    poke8(buf+15, src & 0xFF);
    poke8(buf+16, (dst >> 24) & 0xFF);            // dst IP byte 0
    poke8(buf+17, (dst >> 16) & 0xFF);
    poke8(buf+18, (dst >> 8)  & 0xFF);
    poke8(buf+19, dst & 0xFF);
    var ck: int64 := IpChecksum(buf);
    poke8(buf+10, (ck >> 8) & 0xFF);
    poke8(buf+11, ck & 0xFF);
    return IPV4_HDR_SIZE;
}
