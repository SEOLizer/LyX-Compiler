// std/net/dhcp.lyx — DHCP Client (RFC 2131)
//
// Public API:
//   DhcpBuildDiscover(buf, mac, xid)              → int64 (bytes written)
//   DhcpBuildRequest(buf, mac, xid, offIP, srvIP) → int64 (bytes written)
//   DhcpParseReply(buf, len, result)               — fills result struct
//   DhcpDiscover(mac, xid, result)                 → int64 (0=ok, -1=err)
//   DhcpRequest(mac, xid, result)                  → int64 (0=ok, -1=err)
//   DhcpLease(mac, result)                         → int64 (0=ok, -1=err)
//
// DHCP Result struct layout (DHCP_RESULT_SIZE = 72 bytes):
//   DHCP_RESULT_IP     +0   leased IP (packed like IPPack)
//   DHCP_RESULT_MASK   +8   subnet mask
//   DHCP_RESULT_GW    +16   default gateway
//   DHCP_RESULT_DNS   +24   primary DNS server
//   DHCP_RESULT_LEASE +32   lease time in seconds
//   DHCP_RESULT_SERVER+40   DHCP server IP (option 54)
//   DHCP_RESULT_XID   +48   transaction ID
//   DHCP_RESULT_TYPE  +56   DHCP message type (2=OFFER, 5=ACK, 6=NAK)
//   DHCP_RESULT_OK    +64   1 if lease obtained successfully
//
// Requires: root / CAP_NET_BIND_SERVICE to bind port 68.
@capabilities([network.tcp.bind, network.tcp.connect, network.udp.connect])

unit std.net.dhcp;

import std.net.socket;
import std.net.syscalls;
import std.net.types;
import std.alloc;

// ── Ports ─────────────────────────────────────────────────────────────────────
pub con DHCP_PORT_SERVER:   int64 := 67;
pub con DHCP_PORT_CLIENT:   int64 := 68;

// ── Operation codes ───────────────────────────────────────────────────────────
pub con DHCP_OP_REQUEST:    int64 := 1;   // BOOTREQUEST (client → server)
pub con DHCP_OP_REPLY:      int64 := 2;   // BOOTREPLY   (server → client)

// ── Hardware types ────────────────────────────────────────────────────────────
pub con DHCP_HTYPE_ETHER:   int64 := 1;

// ── DHCP message types (option 53) ───────────────────────────────────────────
pub con DHCP_MSG_DISCOVER:  int64 := 1;
pub con DHCP_MSG_OFFER:     int64 := 2;
pub con DHCP_MSG_REQUEST:   int64 := 3;
pub con DHCP_MSG_DECLINE:   int64 := 4;
pub con DHCP_MSG_ACK:       int64 := 5;
pub con DHCP_MSG_NAK:       int64 := 6;
pub con DHCP_MSG_RELEASE:   int64 := 7;
pub con DHCP_MSG_INFORM:    int64 := 8;

// ── DHCP option codes ─────────────────────────────────────────────────────────
pub con DHCP_OPT_SUBNET:    int64 := 1;   // Subnet Mask
pub con DHCP_OPT_ROUTER:    int64 := 3;   // Default Gateway
pub con DHCP_OPT_DNS:       int64 := 6;   // DNS Server
pub con DHCP_OPT_HOSTNAME:  int64 := 12;  // Hostname
pub con DHCP_OPT_DOMAIN:    int64 := 15;  // Domain Name
pub con DHCP_OPT_REQIP:     int64 := 50;  // Requested IP Address
pub con DHCP_OPT_LEASE:     int64 := 51;  // IP Address Lease Time
pub con DHCP_OPT_MSGTYPE:   int64 := 53;  // DHCP Message Type
pub con DHCP_OPT_SERVERID:  int64 := 54;  // Server Identifier
pub con DHCP_OPT_PARAMREQ:  int64 := 55;  // Parameter Request List
pub con DHCP_OPT_PAD:       int64 := 0;
pub con DHCP_OPT_END:       int64 := 255;

// ── Packet field offsets (RFC 2131 §2) ───────────────────────────────────────
pub con DHCP_OFFS_OP:       int64 := 0;
pub con DHCP_OFFS_HTYPE:    int64 := 1;
pub con DHCP_OFFS_HLEN:     int64 := 2;
pub con DHCP_OFFS_HOPS:     int64 := 3;
pub con DHCP_OFFS_XID:      int64 := 4;   // 4 bytes, big-endian
pub con DHCP_OFFS_SECS:     int64 := 8;   // 2 bytes
pub con DHCP_OFFS_FLAGS:    int64 := 10;  // 2 bytes (bit 15 = broadcast)
pub con DHCP_OFFS_CIADDR:   int64 := 12;  // client IP address
pub con DHCP_OFFS_YIADDR:   int64 := 16;  // your (offered/leased) IP
pub con DHCP_OFFS_SIADDR:   int64 := 20;  // next server IP
pub con DHCP_OFFS_GIADDR:   int64 := 24;  // relay agent IP
pub con DHCP_OFFS_CHADDR:   int64 := 28;  // client hardware address (16 bytes)
pub con DHCP_OFFS_SNAME:    int64 := 44;  // server host name  (64 bytes)
pub con DHCP_OFFS_FILE:     int64 := 108; // boot file name   (128 bytes)
pub con DHCP_OFFS_COOKIE:   int64 := 236; // magic cookie (4 bytes)
pub con DHCP_OFFS_OPTIONS:  int64 := 240; // options start here
pub con DHCP_MIN_LEN:       int64 := 300; // minimum packet (BOOTP compat)

// ── Magic cookie bytes (0x63825363) ──────────────────────────────────────────
pub con DHCP_MAGIC_B0:      int64 := 99;  // 0x63
pub con DHCP_MAGIC_B1:      int64 := 130; // 0x82
pub con DHCP_MAGIC_B2:      int64 := 83;  // 0x53
pub con DHCP_MAGIC_B3:      int64 := 99;  // 0x63

// Broadcast flag: bit 15 of flags field = byte 10 high bit
pub con DHCP_FLAG_BROADCAST: int64 := 128; // 0x80

// ── Result struct offsets ─────────────────────────────────────────────────────
pub con DHCP_RESULT_IP:     int64 := 0;
pub con DHCP_RESULT_MASK:   int64 := 8;
pub con DHCP_RESULT_GW:     int64 := 16;
pub con DHCP_RESULT_DNS:    int64 := 24;
pub con DHCP_RESULT_LEASE:  int64 := 32;
pub con DHCP_RESULT_SERVER: int64 := 40;
pub con DHCP_RESULT_XID:    int64 := 48;
pub con DHCP_RESULT_TYPE:   int64 := 56;
pub con DHCP_RESULT_OK:     int64 := 64;
pub con DHCP_RESULT_SIZE:   int64 := 72;

// SO_BROADCAST = 6 on Linux (not in std.net.types)
con DHCP_SO_BROADCAST: int64 := 6;

// ── Private helpers ───────────────────────────────────────────────────────────

fn dhcpZero(buf: int64, size: int64) {
    var i: int64 := 0;
    while (i < size) { poke8(buf + i, 0); i := i + 1; }
}

fn dhcpCopy(dst: int64, src: int64, n: int64) {
    var i: int64 := 0;
    while (i < n) { poke8(dst + i, peek8(src + i)); i := i + 1; }
}

// Write 32-bit value big-endian (network byte order)
fn dhcpWrite32(buf: int64, offset: int64, val: int64) {
    poke8(buf + offset,     (val >> 24) & 255);
    poke8(buf + offset + 1, (val >> 16) & 255);
    poke8(buf + offset + 2, (val >> 8)  & 255);
    poke8(buf + offset + 3, val & 255);
}

// Read big-endian 4 bytes → packed IP (same format as IPPack)
fn dhcpRead32(buf: int64, offset: int64): int64 {
    var b0: int64 := peek8(buf + offset);
    var b1: int64 := peek8(buf + offset + 1);
    var b2: int64 := peek8(buf + offset + 2);
    var b3: int64 := peek8(buf + offset + 3);
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}

fn dhcpWriteCookie(buf: int64) {
    poke8(buf + DHCP_OFFS_COOKIE,     DHCP_MAGIC_B0);
    poke8(buf + DHCP_OFFS_COOKIE + 1, DHCP_MAGIC_B1);
    poke8(buf + DHCP_OFFS_COOKIE + 2, DHCP_MAGIC_B2);
    poke8(buf + DHCP_OFFS_COOKIE + 3, DHCP_MAGIC_B3);
}

fn dhcpCheckCookie(buf: int64): int64 {
    if (peek8(buf + DHCP_OFFS_COOKIE)     != DHCP_MAGIC_B0) { return 0; }
    if (peek8(buf + DHCP_OFFS_COOKIE + 1) != DHCP_MAGIC_B1) { return 0; }
    if (peek8(buf + DHCP_OFFS_COOKIE + 2) != DHCP_MAGIC_B2) { return 0; }
    if (peek8(buf + DHCP_OFFS_COOKIE + 3) != DHCP_MAGIC_B3) { return 0; }
    return 1;
}

// ── Public API ────────────────────────────────────────────────────────────────

// Build a DHCPDISCOVER packet into buf (must be >= DHCP_MIN_LEN bytes).
// mac: pointer to 6-byte Ethernet MAC address.
// xid: 32-bit transaction ID (only low 32 bits used).
// Returns DHCP_MIN_LEN.
pub fn DhcpBuildDiscover(buf: int64, mac: int64, xid: int64): int64 {
    dhcpZero(buf, DHCP_MIN_LEN);
    poke8(buf + DHCP_OFFS_OP,    DHCP_OP_REQUEST);
    poke8(buf + DHCP_OFFS_HTYPE, DHCP_HTYPE_ETHER);
    poke8(buf + DHCP_OFFS_HLEN,  6);
    poke8(buf + DHCP_OFFS_HOPS,  0);
    dhcpWrite32(buf, DHCP_OFFS_XID, xid & 0xFFFFFFFF);
    poke8(buf + DHCP_OFFS_FLAGS, DHCP_FLAG_BROADCAST);
    dhcpCopy(buf + DHCP_OFFS_CHADDR, mac, 6);
    dhcpWriteCookie(buf);
    // Options
    var o: int64 := DHCP_OFFS_OPTIONS;
    poke8(buf + o, DHCP_OPT_MSGTYPE);  o := o + 1;
    poke8(buf + o, 1);                  o := o + 1;
    poke8(buf + o, DHCP_MSG_DISCOVER);  o := o + 1;
    poke8(buf + o, DHCP_OPT_PARAMREQ); o := o + 1;
    poke8(buf + o, 4);                  o := o + 1;
    poke8(buf + o, DHCP_OPT_SUBNET);   o := o + 1;
    poke8(buf + o, DHCP_OPT_ROUTER);   o := o + 1;
    poke8(buf + o, DHCP_OPT_DNS);      o := o + 1;
    poke8(buf + o, DHCP_OPT_DOMAIN);   o := o + 1;
    poke8(buf + o, DHCP_OPT_END);
    return DHCP_MIN_LEN;
}

// Build a DHCPREQUEST packet into buf.
// offeredIP: IP address offered by server (packed like IPPack).
// serverIP:  DHCP server identifier (from OFFER option 54).
// Returns DHCP_MIN_LEN.
pub fn DhcpBuildRequest(buf: int64, mac: int64, xid: int64, offeredIP: int64, serverIP: int64): int64 {
    dhcpZero(buf, DHCP_MIN_LEN);
    poke8(buf + DHCP_OFFS_OP,    DHCP_OP_REQUEST);
    poke8(buf + DHCP_OFFS_HTYPE, DHCP_HTYPE_ETHER);
    poke8(buf + DHCP_OFFS_HLEN,  6);
    poke8(buf + DHCP_OFFS_HOPS,  0);
    dhcpWrite32(buf, DHCP_OFFS_XID, xid & 0xFFFFFFFF);
    poke8(buf + DHCP_OFFS_FLAGS, DHCP_FLAG_BROADCAST);
    dhcpCopy(buf + DHCP_OFFS_CHADDR, mac, 6);
    dhcpWriteCookie(buf);
    var o: int64 := DHCP_OFFS_OPTIONS;
    poke8(buf + o, DHCP_OPT_MSGTYPE);   o := o + 1;
    poke8(buf + o, 1);                   o := o + 1;
    poke8(buf + o, DHCP_MSG_REQUEST);    o := o + 1;
    poke8(buf + o, DHCP_OPT_REQIP);     o := o + 1;
    poke8(buf + o, 4);                   o := o + 1;
    dhcpWrite32(buf, o, offeredIP);      o := o + 4;
    poke8(buf + o, DHCP_OPT_SERVERID);  o := o + 1;
    poke8(buf + o, 4);                   o := o + 1;
    dhcpWrite32(buf, o, serverIP);       o := o + 4;
    poke8(buf + o, DHCP_OPT_PARAMREQ);  o := o + 1;
    poke8(buf + o, 4);                   o := o + 1;
    poke8(buf + o, DHCP_OPT_SUBNET);    o := o + 1;
    poke8(buf + o, DHCP_OPT_ROUTER);    o := o + 1;
    poke8(buf + o, DHCP_OPT_DNS);       o := o + 1;
    poke8(buf + o, DHCP_OPT_DOMAIN);    o := o + 1;
    poke8(buf + o, DHCP_OPT_END);
    return DHCP_MIN_LEN;
}

// Parse a DHCP server reply (OFFER or ACK) from buf into result struct.
// result must point to DHCP_RESULT_SIZE zeroed bytes.
// Sets DHCP_RESULT_OK=1 on OFFER or ACK; 0 on NAK, invalid packet, or error.
pub fn DhcpParseReply(buf: int64, len: int64, result: int64) {
    poke64(result + DHCP_RESULT_OK,   0);
    poke64(result + DHCP_RESULT_TYPE, 0);
    if (len < DHCP_OFFS_OPTIONS) { return; }
    if (peek8(buf + DHCP_OFFS_OP) != DHCP_OP_REPLY) { return; }
    if (dhcpCheckCookie(buf) == 0) { return; }
    poke64(result + DHCP_RESULT_IP, dhcpRead32(buf, DHCP_OFFS_YIADDR));
    var pos:     int64 := DHCP_OFFS_OPTIONS;
    var msgType: int64 := 0;
    var done:    int64 := 0;
    while (pos < len && done == 0) {
        var t: int64 := peek8(buf + pos);
        if (t == DHCP_OPT_PAD) { pos := pos + 1; }
        if (t == DHCP_OPT_END) { done := 1; }
        if (t != DHCP_OPT_PAD && t != DHCP_OPT_END) {
            if (pos + 1 >= len) { done := 1; }
            if (pos + 1 < len) {
                var l:    int64 := peek8(buf + pos + 1);
                var doff: int64 := pos + 2;
                if (t == DHCP_OPT_MSGTYPE && l == 1 && doff < len) {
                    msgType := peek8(buf + doff);
                }
                if (t == DHCP_OPT_SERVERID && l == 4 && doff + 3 < len) {
                    poke64(result + DHCP_RESULT_SERVER, dhcpRead32(buf, doff));
                }
                if (t == DHCP_OPT_LEASE && l == 4 && doff + 3 < len) {
                    poke64(result + DHCP_RESULT_LEASE, dhcpRead32(buf, doff));
                }
                if (t == DHCP_OPT_SUBNET && l == 4 && doff + 3 < len) {
                    poke64(result + DHCP_RESULT_MASK, dhcpRead32(buf, doff));
                }
                if (t == DHCP_OPT_ROUTER && l == 4 && doff + 3 < len) {
                    poke64(result + DHCP_RESULT_GW, dhcpRead32(buf, doff));
                }
                if (t == DHCP_OPT_DNS && l >= 4 && doff + 3 < len) {
                    poke64(result + DHCP_RESULT_DNS, dhcpRead32(buf, doff));
                }
                pos := pos + 2 + l;
            }
        }
    }
    poke64(result + DHCP_RESULT_TYPE, msgType);
    if (msgType == DHCP_MSG_ACK)   { poke64(result + DHCP_RESULT_OK, 1); }
    if (msgType == DHCP_MSG_OFFER) { poke64(result + DHCP_RESULT_OK, 1); }
}

// Send DHCPDISCOVER broadcast and receive a DHCPOFFER.
// mac: pointer to 6-byte MAC. xid: transaction ID.
// result: pointer to DHCP_RESULT_SIZE zeroed bytes.
// Returns 0 on success (OFFER received), -1 on error or timeout.
// Requires root / CAP_NET_BIND_SERVICE (port 68 < 1024).
pub fn DhcpDiscover(mac: int64, xid: int64, result: int64): int64 {
    var sock: UDPSocket := UDPSocketNew();
    if (sock.fd < 0) { return 0 - 1; }
    UDPSocketSetReuseAddr(sock);
    SetSockOpt(sock.fd, SOL_SOCKET, DHCP_SO_BROADCAST, 1, 4);
    var bindRet: int64 := UDPSocketBindTo(sock, 0, DHCP_PORT_CLIENT);
    if (bindRet < 0) { UDPSocketClose(sock); return 0 - 1; }
    var pkt: int64 := alloc(DHCP_MIN_LEN);
    DhcpBuildDiscover(pkt, mac, xid);
    var bcast: int64 := IPPack(255, 255, 255, 255);
    var ret:   int64 := UDPSocketSendToAddr(sock, pkt, DHCP_MIN_LEN, bcast, DHCP_PORT_SERVER);
    free(pkt, DHCP_MIN_LEN);
    if (ret < 0) { UDPSocketClose(sock); return 0 - 1; }
    var canRead: int64 := SocketCanRead(sock.fd, 5000);
    if (canRead != 1) { UDPSocketClose(sock); return 0 - 1; }
    var reply: int64 := alloc(1024);
    var nread: int64 := UDPSocketRecv(sock, reply, 1024, 0, 0);
    UDPSocketClose(sock);
    if (nread < DHCP_OFFS_OPTIONS) { free(reply, 1024); return 0 - 1; }
    DhcpParseReply(reply, nread, result);
    free(reply, 1024);
    poke64(result + DHCP_RESULT_XID, xid);
    if (peek64(result + DHCP_RESULT_OK) == 0) { return 0 - 1; }
    return 0;
}

// Send DHCPREQUEST for the IP offered in result and receive DHCPACK.
// Reads offeredIP and serverIP from result struct (filled by DhcpDiscover).
// Overwrites result with ACK data on success.
// Returns 0 on success (ACK with DHCP_MSG_ACK received), -1 on error.
pub fn DhcpRequest(mac: int64, xid: int64, result: int64): int64 {
    var offeredIP: int64 := peek64(result + DHCP_RESULT_IP);
    var serverIP:  int64 := peek64(result + DHCP_RESULT_SERVER);
    var sock: UDPSocket := UDPSocketNew();
    if (sock.fd < 0) { return 0 - 1; }
    UDPSocketSetReuseAddr(sock);
    SetSockOpt(sock.fd, SOL_SOCKET, DHCP_SO_BROADCAST, 1, 4);
    var bindRet: int64 := UDPSocketBindTo(sock, 0, DHCP_PORT_CLIENT);
    if (bindRet < 0) { UDPSocketClose(sock); return 0 - 1; }
    var pkt: int64 := alloc(DHCP_MIN_LEN);
    DhcpBuildRequest(pkt, mac, xid, offeredIP, serverIP);
    var bcast: int64 := IPPack(255, 255, 255, 255);
    var ret:   int64 := UDPSocketSendToAddr(sock, pkt, DHCP_MIN_LEN, bcast, DHCP_PORT_SERVER);
    free(pkt, DHCP_MIN_LEN);
    if (ret < 0) { UDPSocketClose(sock); return 0 - 1; }
    var canRead: int64 := SocketCanRead(sock.fd, 5000);
    if (canRead != 1) { UDPSocketClose(sock); return 0 - 1; }
    var reply: int64 := alloc(1024);
    var nread: int64 := UDPSocketRecv(sock, reply, 1024, 0, 0);
    UDPSocketClose(sock);
    if (nread < DHCP_OFFS_OPTIONS) { free(reply, 1024); return 0 - 1; }
    DhcpParseReply(reply, nread, result);
    free(reply, 1024);
    poke64(result + DHCP_RESULT_XID, xid);
    if (peek64(result + DHCP_RESULT_OK) == 0) { return 0 - 1; }
    if (peek64(result + DHCP_RESULT_TYPE) != DHCP_MSG_ACK) { return 0 - 1; }
    return 0;
}

// Full DHCP lease acquisition: DISCOVER → OFFER → REQUEST → ACK.
// mac: pointer to 6-byte Ethernet MAC address.
// result: pointer to DHCP_RESULT_SIZE zeroed bytes; filled on success.
// XID derived from first 4 MAC bytes.
// Returns 0 on success, -1 on failure.
// On success, result contains the full lease parameters.
pub fn DhcpLease(mac: int64, result: int64): int64 {
    var xid: int64 := peek8(mac);
    xid := (xid << 8) | peek8(mac + 1);
    xid := (xid << 8) | peek8(mac + 2);
    xid := (xid << 8) | peek8(mac + 3);
    xid := xid & 0xFFFFFFFF;
    var ret: int64 := DhcpDiscover(mac, xid, result);
    if (ret < 0) { return 0 - 1; }
    ret := DhcpRequest(mac, xid, result);
    return ret;
}
