// std/net/tls_kern.lyx — der gemeinsame Kern von TLS 1.3 und DTLS 1.3
// (#2619, Voraussetzung fuer #2580 Stufe 5).
//
// ── Warum diese Unit ─────────────────────────────────────────────────────
//
// DTLS 1.3 (RFC 9147) hat eine eigene Record-Schicht und einen eigenen
// Ablauf, teilt mit TLS 1.3 aber den Schluesselplan, die Kodierung der
// Nachrichtenfelder, die Erweiterungssuche und die Gruppen. Diese Rechnungen
// lagen bis 1.2.46A ausschliesslich in std/net/tls13.lyx und waren dort
// privat. Fuer DTLS gab es damit drei Wege, und zwei davon sind falsch:
//
//   * eine ZWEITE Fassung in dtls13.lyx -- das ist die "zweite Stelle", fuer
//     die die Arbeitsregeln dieses Repos eine eigene Ursachenrubrik fuehren
//     ("Die zweite Stelle wurde nicht nachgezogen", belegt an cg_foldConst
//     gegen cg_evalConExpr (#1799), an der f64-Sperre (#1803) und an
//     _findLocalSlot (#1806)). Bei Krypto ist der Preis hoeher als bei
//     Codegen: eine Erweiterung, die nur in einer der beiden Fassungen
//     nachgezogen wird, ist eine Luecke in einer von zwei
//     Protokollfamilien.
//   * alles in tls13.lyx `pub` machen -- dann ist das Innenleben der Unit
//     ihre Schnittstelle, und jede Umstellung im Schluesselplan waere eine
//     API-Aenderung.
//
// Hier steht darum jede dieser Rechnungen EINMAL. tls13.lyx ruft sie auf
// (seine privaten Funktionen sind seit #2619 duenne Weiterleitungen, damit
// die Aufrufstellen unveraendert blieben und der Nachweis dieselben Zahlen
// liefert), dtls13.lyx ebenso.
//
// ── Was hier NICHT steht ─────────────────────────────────────────────────
//
// Der Bau und das Lesen der Handschlagnachrichten (ClientHello,
// ServerHello, Certificate, ...) haengen heute am Verbindungszustand von
// tls13.lyx -- an V_RANDOM, V_SESSID, V_TKT, V_COOKIE und einem Dutzend
// weiterer Felder. Sie herauszuziehen heisst, diesen Zustand als
// uebergebenen Block zu fassen; das ist ein eigener Schritt mit eigenem
// Nachweis und steht weiter in #2619. Diese Unit nimmt bewusst nur die
// Rechnungen, die sich mit ihren Eingaben vollstaendig beschreiben lassen
// -- dafuer ohne jede Verhaltensaenderung.
unit std.net.tls_kern;

import std.crypto.hkdf;
import std.crypto.sha256;
import std.crypto.sha512;
import std.crypto.ec;
import std.crypto.ct;
import std.string;

// ── Schluesselgruppen ────────────────────────────────────────────────────
//
// Zahlenwerte wie im Protokoll (RFC 8446 §4.2.7). Sie stehen hier, weil die
// Laengen daran haengen und beide Protokolle dieselben Gruppen fuehren.
pub fn TkGrpX25519(): int64    { return 0x001d; }
pub fn TkGrpSecp256r1(): int64 { return 0x0017; }
pub fn TkGrpSecp384r1(): int64 { return 0x0018; }
pub fn TkGruppenAnzahl(): int64 { return 3; }

// Die Rangfolge der eigenen Vorliebe: X25519 zuerst, dann P-256, dann P-384.
pub fn TkGruppeNachRang(i: int64): int64 {
    if (i == 0) { return 0x001d; }
    if (i == 1) { return 0x0017; }
    return 0x0018;
}

// Laenge des ROHEN oeffentlichen Anteils auf der Leitung. Bei den
// Weierstrass-Kurven ist es der unkomprimierte Punkt (0x04 || X || Y), bei
// X25519 der nackte Schluessel.
pub fn TkGruppenRohLen(grp: int64): int64 {
    if (grp == 0x0017) { return 65; }
    if (grp == 0x0018) { return 97; }
    if (grp == 0x001d) { return 32; }
    return 0;
}

// Laenge des gemeinsamen Geheimnisses. Sie ist NICHT gleich der Rohlaenge
// und nicht fuer alle Gruppen 32: bei P-384 sind es 48. Wer hier 32 annimmt,
// rechnet den Schluesselplan ueber zwei Drittel des Geheimnisses -- und das
// faellt erst beim Finished der Gegenseite auf.
pub fn TkGruppenGeheimLen(grp: int64): int64 {
    if (grp == 0x0017) { return 32; }
    if (grp == 0x0018) { return 48; }
    if (grp == 0x001d) { return 32; }
    return 0;
}

// Die Kurvennummer von std.crypto.ec, oder -1 fuer X25519 (das keine
// Weierstrass-Kurve ist und einen eigenen Weg hat).
pub fn TkGruppenKurve(grp: int64): int64 {
    if (grp == 0x0017) { return EC_P256; }
    if (grp == 0x0018) { return EC_P384; }
    return 0 - 1;
}

// ── Kodierung von Feldern ────────────────────────────────────────────────
//
// Reine Pufferschreiber mit laufender Position. Sie sehen klein aus, und
// genau deshalb gehoeren sie hierher: zwei Fassungen von w24 koennten
// auseinanderlaufen, ohne dass es irgendwo auffaellt -- 24-Bit-Laengen
// stehen in jeder Handschlagnachricht.
pub fn TkByte(buf: int64, pos: int64, v: int64): int64 {
    poke8(buf + pos, v & 0xFF);
    return pos + 1;
}

pub fn TkW16(buf: int64, pos: int64, v: int64): int64 {
    poke8(buf + pos, (v >> 8) & 0xFF);
    poke8(buf + pos + 1, v & 0xFF);
    return pos + 2;
}

pub fn TkW24(buf: int64, pos: int64, v: int64): int64 {
    poke8(buf + pos, (v >> 16) & 0xFF);
    poke8(buf + pos + 1, (v >> 8) & 0xFF);
    poke8(buf + pos + 2, v & 0xFF);
    return pos + 3;
}

pub fn TkBytes(buf: int64, pos: int64, src: int64, len: int64): int64 {
    var i: int64 := 0;
    while (i < len) { poke8(buf + pos + i, peek8(src + i)); i := i + 1; }
    return pos + len;
}

pub fn TkR16(buf: int64, pos: int64): int64 {
    return ((peek8(buf + pos) & 0xFF) << 8) | (peek8(buf + pos + 1) & 0xFF);
}

pub fn TkR24(buf: int64, pos: int64): int64 {
    return ((peek8(buf + pos) & 0xFF) << 16) | ((peek8(buf + pos + 1) & 0xFF) << 8)
         |  (peek8(buf + pos + 2) & 0xFF);
}

// Eine Erweiterung in einer Erweiterungsliste suchen. `pos` zeigt auf das
// Laengenfeld der LISTE. Rueckgabe ist die Adresse des Rumpfes, oder -1;
// die Laenge landet in `lenPtr`.
//
// Die Laengen werden gegen das Listenende geprueft und nicht gegen den
// Puffer: eine Erweiterung, die ueber die Liste hinausragt, ist ein
// Formatfehler und kein "fast passend". Ohne diese Pruefung liest der
// naechste Schritt fremde Byte als Feldinhalt.
pub fn TkExtSuchen(buf: int64, pos: int64, len: int64, typ: int64,
                   lenPtr: int64): int64 {
    if (len < 2) { return 0 - 1; }
    var gesamt: int64 := TkR16(buf, pos);
    if (gesamt + 2 > len) { return 0 - 1; }
    var p: int64 := pos + 2;
    var ende: int64 := pos + 2 + gesamt;
    while (p + 4 <= ende) {
        var t: int64 := TkR16(buf, p);
        var l: int64 := TkR16(buf, p + 2);
        if (p + 4 + l > ende) { return 0 - 1; }
        if (t == typ) { poke64(lenPtr, l); return buf + p + 4; }
        p := p + 4 + l;
    }
    return 0 - 1;
}

// ── Schluesselplan (RFC 8446 §7.1, RFC 9147 benutzt denselben) ───────────

// Der leere Hash der gewaehlten Laenge. Er steht in mehreren Ableitungen als
// Kontext und ist darum eine eigene Funktion -- `Sha384(out, 0, out)` liest
// sich wie ein Fehler und ist genau richtig.
pub fn TkHashLeer(hashLen: int64, out: int64): void {
    if (hashLen == 48) { Sha384(out, 0, out); } else { SHA256(out, 0, out); }
}

// Hash ueber `len` Byte, in der gewaehlten Laenge.
pub fn TkHash(hashLen: int64, daten: int64, len: int64, out: int64): void {
    if (hashLen == 48) { Sha384(daten, len, out); } else { SHA256(daten, len, out); }
}

// Schluessel und IV eines Verkehrsgeheimnisses (§7.3).
pub fn TkVerkehrsSchluessel(hashLen: int64, keyLen: int64, secret: int64,
                            keyOut: int64, ivOut: int64): bool {
    if (!HkdfExpandLabel(hashLen, secret, hashLen, "key"c as int64, 3,
                         0, 0, keyOut, keyLen)) { return false; }
    return HkdfExpandLabel(hashLen, secret, hashLen, "iv"c as int64, 2,
                           0, 0, ivOut, 12);
}

// Das early_secret -- der einzige Unterschied zwischen vollem Handschlag und
// Wiederaufnahme (§7.1):
//
//     voll:            early_secret = HKDF-Extract(0, 0)
//     Wiederaufnahme:  early_secret = HKDF-Extract(0, PSK)
//
// `psk` == 0 heisst "kein PSK". EIN Parameter statt zweier Fassungen des
// Plans: zwei Rechnungen derselben Art nebeneinander sind in diesem Repo
// regelmaessig auseinandergelaufen.
//
// `null64` zeigt auf 64 Byte Kratzspeicher, die die Funktion nullt und als
// Nullgeheimnis benutzt. Sie belegt selbst keinen Speicher -- der Aufrufer
// weiss, wo sein Kratzbereich liegt, und ein Bereich gehoert genau EINER
// Rolle.
pub fn TkPlanEarly(hashLen: int64, psk: int64, pskLen: int64,
                   null64: int64, early: int64): void {
    var i: int64 := 0;
    while (i < 64) { poke8(null64 + i, 0); i := i + 1; }
    if (psk == 0 || pskLen <= 0) {
        HkdfExtract(hashLen, 0, 0, null64, hashLen, early);
    } else {
        HkdfExtract(hashLen, 0, 0, psk, pskLen, early);
    }
}

// finished_key aus einem Geheimnis (§4.4.4). Dieselbe Rechnung braucht das
// Finished und der PSK-Binder -- der Binder IST ein Finished ueber das halbe
// ClientHello, darum EINE Funktion fuer beide.
pub fn TkFinishedKey(hashLen: int64, secret: int64, out: int64): bool {
    return HkdfExpandLabel(hashLen, secret, hashLen, "finished"c as int64, 8,
                           0, 0, out, hashLen);
}

// binder_key = Derive-Secret(early_secret, "res binder", "") (§7.1), danach
// daraus der finished_key.
//
// Die drei Kratzplaetze werden EINZELN uebergeben (je 64 Byte) und nicht als
// eine Grundadresse mit Abstaenden. Der Grund steht in den Arbeitsregeln
// dieses Repos: ein Bereich gehoert genau EINER Rolle. Wer hier eine Basis
// uebergibt, legt drei Rollen auf 192 Byte, die der Aufrufer anderweitig
// belegt haben kann -- genau so ist in diesem Repo mehrfach "jeder zweite
// Aufruf falsch" entstanden.
//
// Die HASHLAENGE ist die des TICKETS und nicht die der verhandelten Suite:
// beim ClientHello steht die Suite noch nicht fest (§4.2.11.2). Genau das
// hat beim Bauen von #2577 einen Panic aus HKDF gegeben ("unbekannte
// Digestlaenge") -- also laut gescheitert statt still falsch gerechnet.
pub fn TkBinderKey(hashLen: int64, psk: int64, pskLen: int64,
                   leer64: int64, early64: int64, bk64: int64,
                   out: int64): bool {
    TkHashLeer(hashLen, leer64);
    TkPlanEarly(hashLen, psk, pskLen, bk64, early64);   // bk64 zuerst als Null64
    if (!HkdfExpandLabel(hashLen, early64, hashLen, "res binder"c as int64, 10,
                         leer64, hashLen, bk64, hashLen)) {
        SecureZero(early64, 64);
        return false;
    }
    var ok: bool := TkFinishedKey(hashLen, bk64, out);
    SecureZero(early64, 64);
    SecureZero(bk64, 64);
    return ok;
}

// Nonce = IV xor Sequenznummer, big endian in den letzten acht Byte
// (RFC 8446 §5.3, RFC 9147 §4.2.2 -- dieselbe Rechnung, darum EINE
// Funktion).
pub fn TkNonce(iv: int64, seq: int64, out: int64): void {
    var i: int64 := 0;
    while (i < 12) { poke8(out + i, peek8(iv + i)); i := i + 1; }
    i := 0;
    while (i < 8) {
        var b: int64 := ((seq as uint64) >> ((7 - i) * 8)) & 0xFF;
        poke8(out + 4 + i, peek8(out + 4 + i) ^ b);
        i := i + 1;
    }
}

// ── Rahmen von ClientHello und ServerHello (#2619, Schritt 2a) ───────────
//
// Beide Nachrichten haben in TLS 1.3 und DTLS 1.3 DENSELBEN Aufbau
// (RFC 9147 §5.3: "the DTLS ClientHello is identical to the TLS 1.3
// ClientHello except ..."), und beide Protokolle muessen ihn vor jeder
// Entscheidung auseinandernehmen. Diese Trennung ist der Punkt:
//
//   HIER steht das LESEN des Rahmens -- wo die Felder liegen und ob die
//   Laengen zusammenpassen. Das ist fuer beide Protokolle gleich.
//
//   DORT (in tls13.lyx bzw. dtls13.lyx) bleibt die ENTSCHEIDUNG -- welche
//   Suite genommen wird, welche Gruppe, ob ein HelloRetryRequest faellig
//   ist, ob ein PSK angenommen wird. Das ist Politik, und sie unterscheidet
//   sich je Protokoll und je Vorgabe.
//
// Wer beides zusammenlegt, bekommt eine Funktion, die nicht wiederverwendbar
// ist, weil jede Entscheidung mitkommt. Genau daran haengt #2580 Stufe 5.
//
// Der Rahmen landet in einem uebergebenen Block (TkRahmenGroesse Byte) mit
// festen Abstaenden. Ein Block und keine zwanzig Ausgabezeiger: die Felder
// gehoeren zusammen, und eine Funktion mit zwanzig Parametern ruft niemand
// richtig auf.
con TR_RANDOM:   int64 := 0;     // Adresse der 32 Zufallsbyte IM PUFFER
con TR_SIDPOS:   int64 := 8;     // Adresse der session_id
con TR_SIDLEN:   int64 := 16;
con TR_SUITEPOS: int64 := 24;    // ClientHello: Liste; ServerHello: die eine
con TR_SUITELEN: int64 := 32;    // ClientHello: Laenge der Liste, sonst 2
con TR_EXTPOS:   int64 := 40;    // Abstand des Erweiterungs-Laengenfeldes
                                 // VOM NACHRICHTENANFANG (nicht Adresse:
                                 // TkExtSuchen nimmt Puffer und Abstand)
con TR_EXTLEN:   int64 := 48;    // noch verfuegbare Byte ab TR_EXTPOS
con TR_GROESSE:  int64 := 56;

pub fn TkRahmenGroesse(): int64 { return TR_GROESSE; }
pub fn TkRahmenRandom(r: int64): int64   { return peek64(r + TR_RANDOM); }
pub fn TkRahmenSidPos(r: int64): int64   { return peek64(r + TR_SIDPOS); }
pub fn TkRahmenSidLen(r: int64): int64   { return peek64(r + TR_SIDLEN); }
pub fn TkRahmenSuitePos(r: int64): int64 { return peek64(r + TR_SUITEPOS); }
pub fn TkRahmenSuiteLen(r: int64): int64 { return peek64(r + TR_SUITELEN); }
pub fn TkRahmenExtPos(r: int64): int64   { return peek64(r + TR_EXTPOS); }
pub fn TkRahmenExtLen(r: int64): int64   { return peek64(r + TR_EXTLEN); }

// Rueckgabewerte. Sie sind EIGENE Zahlen und nicht die Fehlercodes von
// tls13.lyx: diese Unit kennt die Fehlertabelle des Aufrufers nicht, und ein
// geteilter Zahlenraum waere eine Kopplung, die niemand braucht. Der
// Aufrufer bildet sie auf seine eigenen Codes ab -- sichtbar an genau einer
// Stelle.
pub fn TkRahmenOk(): int64        { return 0; }
pub fn TkRahmenKurz(): int64      { return 0 - 1; }   // Laengen passen nicht
pub fn TkRahmenSidZuLang(): int64 { return 0 - 2; }   // session_id > 32
pub fn TkRahmenKomp(): int64      { return 0 - 3; }   // Kompression != null

// ClientHello-Rahmen lesen. `pos` zeigt auf den RUMPF (hinter den vier Byte
// Handschlagkopf), `len` ist seine Laenge.
//
// legacy_version wird NICHT geprueft. RFC 8446 §4.2.1: wer ueber
// supported_versions verhandelt, muss legacy_version ignorieren -- dort darf
// 0x0301 stehen, und der Handschlag ist gueltig. Die alte Pruefung auf
// 0x0303 wies in tlsfuzzers test-tls13-version-negotiation 193 von 202
// Faellen ab (#2096), alle zu Unrecht.
pub fn TkChRahmen(pos: int64, len: int64, r: int64): int64 {
    if (len < 38) { return 0 - 1; }
    poke64(r + TR_RANDOM, pos + 2);
    var sidLen: int64 := peek8(pos + 34) & 0xFF;
    if (sidLen > 32) { return 0 - 2; }
    poke64(r + TR_SIDPOS, pos + 35);
    poke64(r + TR_SIDLEN, sidLen);

    var p: int64 := 35 + sidLen;
    if (len < p + 2) { return 0 - 1; }
    var csLen: int64 := TkR16(pos, p);
    p := p + 2;
    if (p + csLen > len) { return 0 - 1; }
    poke64(r + TR_SUITEPOS, pos + p);
    poke64(r + TR_SUITELEN, csLen);
    p := p + csLen;

    if (p + 1 > len) { return 0 - 1; }
    var kLen: int64 := peek8(pos + p) & 0xFF;
    p := p + 1 + kLen;
    if (p + 2 > len) { return 0 - 1; }
    poke64(r + TR_EXTPOS, p);
    poke64(r + TR_EXTLEN, len - p);
    return 0;
}

// ServerHello-Rahmen lesen. Hier WIRD legacy_version geprueft: §4.1.3 legt
// 0x0303 fest, und die Verhandlung laeuft ueber supported_versions, das der
// Aufrufer prueft.
pub fn TkShRahmen(pos: int64, len: int64, r: int64): int64 {
    if (len < 38) { return 0 - 1; }
    poke64(r + TR_RANDOM, pos + 2);
    var sidLen: int64 := peek8(pos + 34) & 0xFF;
    if (sidLen > 32) { return 0 - 2; }
    poke64(r + TR_SIDPOS, pos + 35);
    poke64(r + TR_SIDLEN, sidLen);

    var p: int64 := 35 + sidLen;
    if (len < p + 3) { return 0 - 1; }
    poke64(r + TR_SUITEPOS, pos + p);
    poke64(r + TR_SUITELEN, 2);
    p := p + 2;
    if ((peek8(pos + p) & 0xFF) != 0) { return 0 - 3; }
    p := p + 1;
    if (p + 2 > len) { return 0 - 1; }
    poke64(r + TR_EXTPOS, p);
    poke64(r + TR_EXTLEN, len - p);
    return 0;
}

// Der feste Zufallswert, mit dem ein ServerHello als HelloRetryRequest
// kenntlich ist (RFC 8446 §4.1.3, SHA-256 von "HelloRetryRequest"). Er ist
// in DTLS derselbe.
pub fn TkHrrRandom(out: int64): void {
    poke8(out +  0, 0xCF); poke8(out +  1, 0x21); poke8(out +  2, 0xAD);
    poke8(out +  3, 0x74); poke8(out +  4, 0xE5); poke8(out +  5, 0x9A);
    poke8(out +  6, 0x61); poke8(out +  7, 0x11); poke8(out +  8, 0xBE);
    poke8(out +  9, 0x1D); poke8(out + 10, 0x8C); poke8(out + 11, 0x02);
    poke8(out + 12, 0x1E); poke8(out + 13, 0x65); poke8(out + 14, 0xB8);
    poke8(out + 15, 0x91); poke8(out + 16, 0xC2); poke8(out + 17, 0xA2);
    poke8(out + 18, 0x11); poke8(out + 19, 0x16); poke8(out + 20, 0x7A);
    poke8(out + 21, 0xBB); poke8(out + 22, 0x8C); poke8(out + 23, 0x5E);
    poke8(out + 24, 0x07); poke8(out + 25, 0x9E); poke8(out + 26, 0x09);
    poke8(out + 27, 0xE2); poke8(out + 28, 0xC8); poke8(out + 29, 0xA8);
    poke8(out + 30, 0x33); poke8(out + 31, 0x9C);
}

// Ist dieser Zufallswert der HRR-Wert? `scr32` sind 32 Byte Kratzspeicher
// des Aufrufers -- diese Unit belegt keinen.
//
// Verglichen wird NICHT konstantzeitig, und das ist richtig: der Wert ist
// oeffentlich und steht im RFC. Wer hier CTMemEqual nimmt, suggeriert ein
// Geheimnis, wo keines ist.
pub fn TkIstHrr(zufall: int64, scr32: int64): bool {
    TkHrrRandom(scr32);
    var i: int64 := 0;
    var gleich: bool := true;
    while (i < 32) {
        if ((peek8(zufall + i) & 0xFF) != (peek8(scr32 + i) & 0xFF)) { gleich := false; }
        i := i + 1;
    }
    return gleich;
}

// ── Erweiterungen schreiben (#2619, Schritt 2b) ──────────────────────────
//
// Jede Erweiterung EINZELN und nicht ein Bauer fuer die ganze Nachricht.
// Der Grund ist nicht Geschmack:
//
//   * Die ENTSCHEIDUNG, welche Erweiterung ueberhaupt hinein gehoert,
//     gehoert dem Protokoll und der Vorgabe. Ein Bauer, der sie faellt,
//     braeuchte dafuer einen Vorgabenblock mit zwanzig Feldern -- und wer
//     den fuellt, kann ihn genauso falsch fuellen wie die Bytes selbst.
//   * So kann DTLS seine Nachricht aus denselben Stuecken in seiner eigenen
//     Reihenfolge zusammensetzen (RFC 9147 §5.3 verlangt ein paar andere,
//     etwa KEINE early_data nach einem Cookie-Austausch).
//   * Jedes Stueck ist mit seinen Eingaben vollstaendig beschrieben und
//     darum einzeln pruefbar. Ein Monolith ist nur als Ganzes pruefbar, und
//     dann steht im Protokoll "ClientHello falsch" statt "key_share falsch".
//
// Alle Funktionen nehmen Puffer und laufende Position und liefern die neue
// Position -- dieselbe Form wie TkW16 und die uebrigen Schreiber.

// supported_versions im ClientHello (§4.2.1). `mit12` nimmt TLS 1.2 dazu:
// EIN ClientHello fuer beide Fassungen, weil das Transkript an den
// gesendeten Byte haengt und zwei verschiedene nicht zusammenpassen.
pub fn TkExtSupportedVersionsCh(buf: int64, pos: int64, mit12: bool): int64 {
    var p: int64 := pos;
    if (mit12) {
        p := TkW16(buf, p, 43); p := TkW16(buf, p, 5);
        p := TkByte(buf, p, 4); p := TkW16(buf, p, 0x0304); p := TkW16(buf, p, 0x0303);
        return p;
    }
    p := TkW16(buf, p, 43); p := TkW16(buf, p, 3);
    p := TkByte(buf, p, 2); p := TkW16(buf, p, 0x0304);
    return p;
}

// supported_versions im ServerHello und im HelloRetryRequest: genau eine
// Fassung, ohne Laengenbyte der Liste (§4.2.1).
pub fn TkExtSupportedVersionsSh(buf: int64, pos: int64): int64 {
    var p: int64 := TkW16(buf, pos, 43);
    p := TkW16(buf, p, 2);
    return TkW16(buf, p, 0x0304);
}

// supported_groups (§4.2.7). `maske` ist die Bitmaske der erlaubten Gruppen
// in der Rangfolge von TkGruppeNachRang; Bit i gehoert zu Rang i.
//
// Angeboten wird nur, was der Aufrufer auch RECHNEN kann -- eine Gruppe
// anzubieten, die man nicht beherrscht, ist eine Einladung in den Abbruch.
// Darum ist die Maske ein Parameter und keine Annahme.
pub fn TkExtSupportedGroups(buf: int64, pos: int64, maske: int64): int64 {
    var anz: int64 := 0;
    var i: int64 := 0;
    while (i < TkGruppenAnzahl()) {
        if (((maske >> i) & 1) == 1) { anz := anz + 1; }
        i := i + 1;
    }
    var p: int64 := TkW16(buf, pos, 10);
    p := TkW16(buf, p, 2 + anz * 2);
    p := TkW16(buf, p, anz * 2);
    i := 0;
    while (i < TkGruppenAnzahl()) {
        if (((maske >> i) & 1) == 1) { p := TkW16(buf, p, TkGruppeNachRang(i)); }
        i := i + 1;
    }
    return p;
}

// key_share im ClientHello: EIN Anteil (§4.2.8). Bietet der Server die
// Gruppe nicht an, kommt ein HelloRetryRequest -- darum reicht einer, und
// zwei waeren doppelte Rechenarbeit fuer den haeufigen Fall.
pub fn TkExtKeyShareCh(buf: int64, pos: int64, gruppe: int64,
                       pk: int64, pkLen: int64): int64 {
    var p: int64 := TkW16(buf, pos, 51);
    p := TkW16(buf, p, pkLen + 6);
    p := TkW16(buf, p, pkLen + 4);
    p := TkW16(buf, p, gruppe);
    p := TkW16(buf, p, pkLen);
    return TkBytes(buf, p, pk, pkLen);
}

// key_share im ServerHello: der Anteil des Servers, OHNE die aeussere Liste.
pub fn TkExtKeyShareSh(buf: int64, pos: int64, gruppe: int64,
                       pk: int64, pkLen: int64): int64 {
    var p: int64 := TkW16(buf, pos, 51);
    p := TkW16(buf, p, pkLen + 4);
    p := TkW16(buf, p, gruppe);
    p := TkW16(buf, p, pkLen);
    return TkBytes(buf, p, pk, pkLen);
}

// key_share im HelloRetryRequest: NUR die Gruppe, kein Anteil (§4.1.4).
pub fn TkExtKeyShareHrr(buf: int64, pos: int64, gruppe: int64): int64 {
    var p: int64 := TkW16(buf, pos, 51);
    p := TkW16(buf, p, 2);
    return TkW16(buf, p, gruppe);
}

// server_name (RFC 6066 §3). Nur der Typ host_name (0) -- andere gibt es
// nicht, und ein Server, der einen anderen bekommt, darf abbrechen.
pub fn TkExtSni(buf: int64, pos: int64, host: int64, hostLen: int64): int64 {
    var p: int64 := TkW16(buf, pos, 0);
    p := TkW16(buf, p, hostLen + 5);
    p := TkW16(buf, p, hostLen + 3);
    p := TkByte(buf, p, 0);
    p := TkW16(buf, p, hostLen);
    return TkBytes(buf, p, host, hostLen);
}

// ALPN (RFC 7301). `liste` ist eine Zeichenkette mit Komma als Trenner
// ("h2,http/1.1"); geschrieben wird die Protokollliste mit je einem
// Laengenbyte. Das Komma ist eine Entscheidung der Vorgabe-Schnittstelle und
// nicht des Protokolls -- hier wird sie umgesetzt, damit beide Protokolle
// dieselbe Schreibweise lesen.
pub fn TkExtAlpn(buf: int64, pos: int64, liste: int64, listeLen: int64): int64 {
    var p: int64 := TkW16(buf, pos, 16);
    var merk: int64 := p;
    p := p + 4;                       // zwei Laengen, spaeter nachgetragen
    var start: int64 := p;
    var i: int64 := 0;
    while (i < listeLen) {
        var j: int64 := i;
        while (j < listeLen && (peek8(liste + j) & 0xFF) != 44) { j := j + 1; }
        var l: int64 := j - i;
        if (l > 0 && l < 256) {
            p := TkByte(buf, p, l);
            p := TkBytes(buf, p, liste + i, l);
        }
        i := j + 1;
    }
    var listenLen: int64 := p - start;
    TkW16(buf, merk, listenLen + 2);
    TkW16(buf, merk + 2, listenLen);
    return p;
}

// signature_algorithms (§4.2.3). Die Liste kommt vom Aufrufer: was hier
// steht, darf die Gegenseite WAEHLEN, es gehoert also nur hinein, was die
// eigene Pruefung auch kann. `schemata` zeigt auf `anzahl` Werte von je
// 8 Byte (int64 je Schema) -- so kann der Aufrufer sie aus seiner Vorliebe
// zusammenstellen, ohne ein Byteformat zu bauen.
pub fn TkExtSigAlgs(buf: int64, pos: int64, schemata: int64, anzahl: int64): int64 {
    var p: int64 := TkW16(buf, pos, 13);
    p := TkW16(buf, p, 2 + anzahl * 2);
    p := TkW16(buf, p, anzahl * 2);
    var i: int64 := 0;
    while (i < anzahl) {
        p := TkW16(buf, p, peek64(schemata + i * 8));
        i := i + 1;
    }
    return p;
}

// psk_key_exchange_modes (§4.2.9): NUR psk_dhe_ke. Reines psk_ke (ohne
// frischen Schluesselaustausch) ist bewusst nicht umgesetzt -- es gibt keine
// Vorwaertsgeheimhaltung.
pub fn TkExtPskModes(buf: int64, pos: int64): int64 {
    var p: int64 := TkW16(buf, pos, 45);
    p := TkW16(buf, p, 2);
    p := TkByte(buf, p, 1);
    return TkByte(buf, p, 1);
}

// cookie (§4.2.2). Im ClientHello2 unveraendert zurueck, im
// HelloRetryRequest vom Server gesetzt -- dieselben Byte, darum eine
// Funktion.
pub fn TkExtCookie(buf: int64, pos: int64, cookie: int64, ckLen: int64): int64 {
    var p: int64 := TkW16(buf, pos, 44);
    p := TkW16(buf, p, ckLen + 2);
    p := TkW16(buf, p, ckLen);
    return TkBytes(buf, p, cookie, ckLen);
}

// early_data, leer (§4.2.10). Im ClientHello heisst sie "ich sende fruehe
// Daten", in den EncryptedExtensions "angenommen" -- gleiche Byte, zwei
// Bedeutungen, und beide Male diese Funktion.
pub fn TkExtEarlyLeer(buf: int64, pos: int64): int64 {
    var p: int64 := TkW16(buf, pos, 42);
    return TkW16(buf, p, 0);
}

// early_data im NewSessionTicket: mit max_early_data_size (§4.6.1).
pub fn TkExtEarlyMax(buf: int64, pos: int64, max: int64): int64 {
    var p: int64 := TkW16(buf, pos, 42);
    p := TkW16(buf, p, 4);
    p := TkByte(buf, p, (max >> 24) & 0xFF);
    p := TkByte(buf, p, (max >> 16) & 0xFF);
    p := TkByte(buf, p, (max >> 8) & 0xFF);
    return TkByte(buf, p, max & 0xFF);
}

// status_request (RFC 6066 §8): leere Listen heissen "der Server waehlt".
// Das ist die Form, die auch Browser senden.
pub fn TkExtStatusRequest(buf: int64, pos: int64): int64 {
    var p: int64 := TkW16(buf, pos, 5);
    p := TkW16(buf, p, 5);
    p := TkByte(buf, p, 1);
    p := TkW16(buf, p, 0);
    return TkW16(buf, p, 0);
}

// ── Signaturinhalt und Finished-Wert (#2619) ─────────────────────────────

// Der Inhalt, ueber den CertificateVerify signiert wird (RFC 8446 §4.4.3):
//
//     64 Byte 0x20 || Kontextzeichenkette || 0x00 || Transkripthash
//
// DTLS 1.3 benutzt DIESELBEN Kontextzeichenketten ("TLS 1.3, server
// CertificateVerify"), nicht etwa "DTLS 1.3" -- RFC 9147 uebernimmt die
// Konstruktion unveraendert. Wer hier "DTLS" einsetzt, bekommt eine
// Signatur, die keine Gegenstelle prueft, und sucht den Fehler in der
// Kurvenarithmetik.
//
// Die 64 Byte 0x20 sind kein Schmuck: sie trennen diesen Inhalt von einem
// TLS-1.2-Signaturinhalt, damit eine Signatur nicht in der anderen Fassung
// gueltig ist.
pub fn TkSignaturInhalt(serverRolle: bool, transkript: int64, hashLen: int64,
                        out: int64): int64 {
    var i: int64 := 0;
    while (i < 64) { poke8(out + i, 32); i := i + 1; }
    var ctx: pchar := "TLS 1.3, server CertificateVerify"c;
    if (!serverRolle) { ctx := "TLS 1.3, client CertificateVerify"c; }
    var l: int64 := StrLen(ctx);
    var p: int64 := TkBytes(out, 64, ctx as int64, l);
    p := TkByte(out, p, 0);
    return TkBytes(out, p, transkript, hashLen);
}

// verify_data des Finished (§4.4.4):
//
//     HMAC(HKDF-Expand-Label(secret, "finished", "", hl), Transkripthash)
//
// `fk64` sind 64 Byte Kratzspeicher des Aufrufers fuer den finished_key; er
// wird vor der Rueckkehr geloescht. Ein eigener Platz und keine
// Grundadresse: ein Bereich gehoert genau einer Rolle.
pub fn TkFinishedWert(hashLen: int64, secret: int64, transkript: int64,
                      fk64: int64, out: int64): bool {
    if (!HkdfExpandLabel(hashLen, secret, hashLen, "finished"c as int64, 8,
                         0, 0, fk64, hashLen)) {
        return false;
    }
    HmacHash(hashLen, fk64, hashLen, transkript, hashLen, out);
    SecureZero(fk64, 64);
    return true;
}

// ── Rumpfe von Certificate und CertificateVerify (#2619, Rest) ───────────

// Der Rumpf von CertificateVerify (§4.4.3): Verfahren, Laenge, Signatur.
// Vier Stellen in tls13.lyx schrieben dieselben drei Zeilen (je eine
// Schluesselart), dtls13.lyx eine fuenfte. Jetzt EINE.
pub fn TkCvRumpf(buf: int64, pos: int64, schema: int64,
                 sig: int64, sigLen: int64): int64 {
    var p: int64 := TkW16(buf, pos, schema);
    p := TkW16(buf, p, sigLen);
    return TkBytes(buf, p, sig, sigLen);
}

// Der Rumpf von Certificate mit EINEM Eintrag und ohne Erweiterungen
// (§4.4.2):
//
//     certificate_request_context  1 Byte (leer)
//     certificate_list             3 Byte Laenge
//       cert_data                  3 Byte Laenge + DER
//       extensions                 2 Byte Laenge (leer)
//
// Die Ketten- und OCSP-Form von std.net.tls13 bleibt DORT: sie schreibt
// mehrere Eintraege und haengt an den Blatt-Eintrag die
// status_request-Antwort (#2579). Diese Funktion ist der haeufige Fall und
// genau der, den DTLS heute braucht -- eine Funktion, die beides kann,
// haette einen Schalter, und der waere die Verzweigung, die hier niemand
// will.
pub fn TkCertEinEintrag(buf: int64, pos: int64, der: int64, derLen: int64): int64 {
    var p: int64 := TkByte(buf, pos, 0);
    p := TkW24(buf, p, derLen + 5);
    p := TkW24(buf, p, derLen);
    p := TkBytes(buf, p, der, derLen);
    return TkW16(buf, p, 0);
}
