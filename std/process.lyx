// std/process.lyx
// Process Management API

@description("Process creation and management")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
@capabilities([process.exec, process.exit, process.fork, process.signal])
unit std.process;

import std.pipe;
import std.alloc;

pub type Process = int64;
pub type ExitCode = int64;

// Prozess-Primitive kommen aus den Compiler-Builtins (sys_fork/sys_execve/
// sys_wait4/sys_kill/sys_getpid), nicht aus rohem FFI. `execve`/`execvp` stehen
// auf der harten FFI-Blacklist — beliebiges exec über ein dynamisch gelinktes
// Symbol ist ein Sandbox-Escape —, weshalb diese Unit sich zuvor überhaupt nicht
// übersetzen ließ. Über die Builtins geht derselbe Syscall durch den
// kontrollierten Pfad des Compilers.

pub con WNOHANG: int64 := 1;
pub con SIGTERM: int64 := 15;
pub con SIGKILL: int64 := 9;

// argv für execve: NULL-terminiertes Array aus Zeigern. Die frühere Fassung
// übergab den Programmpfad direkt als argv (`execve(prog, prog, 0)`) — das ist
// kein Zeiger-Array, der Aufruf wäre auch mit erlaubtem FFI fehlgeschlagen.
fn _argv1(prog: pchar): int64 {
  var v: int64 := alloc(16);
  poke64(v, prog as int64);
  poke64(v + 8, 0);
  return v;
}

// argv für `/bin/sh -c <cmd>`: {"/bin/sh", "-c", cmd, NULL}
fn _argvShell(cmd: pchar): int64 {
  var v: int64 := alloc(32);
  poke64(v,      "/bin/sh" as int64);
  poke64(v + 8,  "-c" as int64);
  poke64(v + 16, cmd as int64);
  poke64(v + 24, 0);
  return v;
}

// wait4 schreibt den Status an eine Adresse. Die frühere Fassung übergab die
// Zahl 0 als „Zeiger" und las den Status nie zurück — Exit-Codes waren damit
// immer 0. Hier: 8-Byte-Puffer, Status auslesen, Exit-Code extrahieren.
fn _waitStatus(pid: int64, options: int64, outCode: int64): int64 {
  var st: int64 := alloc(8);
  poke64(st, 0);
  var r: int64 := sys_wait4(pid, st, options);
  var raw: int64 := peek64(st);
  free(st, 8);
  poke64(outCode, (raw >> 8) & 255);
  return r;
}

pub fn spawn(prog: pchar): Process {
  var pid: int64 := sys_fork();
  if (pid < 0) {
    return 0 - 1;
  }
  if (pid == 0) {
    sys_execve(prog as int64, _argv1(prog), 0);
    exit(127);          // execve gescheitert: Kind muss enden
    return 0 - 1;
  }
  return pid;
}

pub fn run(prog: pchar): ExitCode {
  var pid: int64 := sys_fork();
  if (pid < 0) {
    return 0 - 1;
  }
  if (pid == 0) {
    sys_execve(prog as int64, _argv1(prog), 0);
    exit(127);
    return 0 - 1;
  }
  var codeBuf: int64 := alloc(8);
  _waitStatus(pid, 0, codeBuf);
  var code: int64 := peek64(codeBuf);
  free(codeBuf, 8);
  return code;
}

pub fn wait_for(pid: int64): ExitCode {
  var codeBuf: int64 := alloc(8);
  _waitStatus(pid, 0, codeBuf);
  var code: int64 := peek64(codeBuf);
  free(codeBuf, 8);
  return code;
}

pub fn try_wait(pid: int64): ExitCode {
  var codeBuf: int64 := alloc(8);
  var result: int64 := _waitStatus(pid, WNOHANG, codeBuf);
  var code: int64 := peek64(codeBuf);
  free(codeBuf, 8);
  if (result == 0) { return 0 - 2; }     // läuft noch
  if (result < 0)  { return 0 - 1; }
  return code;
}

pub fn proc_kill(pid: int64, sig: int64): int64 {
  return sys_kill(pid, sig);
}

pub fn terminate(pid: int64): int64 {
  return sys_kill(pid, SIGTERM);
}

pub fn terminate_force(pid: int64): int64 {
  return sys_kill(pid, SIGKILL);
}

pub fn is_running(pid: int64): bool {
  var codeBuf: int64 := alloc(8);
  var r: int64 := _waitStatus(pid, WNOHANG, codeBuf);
  free(codeBuf, 8);
  return r == 0;
}

pub fn self_pid(): int64 {
  return sys_getpid();
}

pub fn shell(cmd: pchar): ExitCode {
  var pid: int64 := sys_fork();
  if (pid < 0) {
    return 0 - 1;
  }
  if (pid == 0) {
    sys_execve("/bin/sh" as int64, _argvShell(cmd), 0);
    exit(127);
    return 0 - 1;
  }
  var codeBuf: int64 := alloc(8);
  _waitStatus(pid, 0, codeBuf);
  var code: int64 := peek64(codeBuf);
  free(codeBuf, 8);
  return code;
}

// ============================================================
// WP-2: Subprocess mit Pipe-verbundenen stdin/stdout
// ============================================================

// SpawnWithPipes: forkt einen Kindprozess und verbindet seine
// stdin und stdout mit je einer Pipe.
//
// prog:        Pfad zum ausführbaren Programm
// stdinFdOut:  alloc(8)-Buffer — nach Aufruf enthält peek64() den fd,
//              auf den der Elternprozess schreibt (→ Kind liest)
// stdoutFdOut: alloc(8)-Buffer — nach Aufruf enthält peek64() den fd,
//              von dem der Elternprozess liest (← Kind schreibt)
//
// Gibt die Kind-PID zurück (> 0), oder < 0 bei Fehler.
pub fn SpawnWithPipes(prog: pchar, stdinFdOut: int64, stdoutFdOut: int64): int64 {
  // Pipe für stdin: Eltern schreibt auf stdinWrite, Kind liest von stdinRead
  var stdinRead:  int64 := alloc(8);
  var stdinWrite: int64 := alloc(8);
  if (PipeCreate(stdinRead, stdinWrite) < 0) {
    free(stdinRead, 8); free(stdinWrite, 8);
    return -1;
  }

  // Pipe für stdout: Kind schreibt auf stdoutWrite, Eltern liest von stdoutRead
  var stdoutRead:  int64 := alloc(8);
  var stdoutWrite: int64 := alloc(8);
  if (PipeCreate(stdoutRead, stdoutWrite) < 0) {
    close(peek64(stdinRead)); close(peek64(stdinWrite));
    free(stdinRead, 8); free(stdinWrite, 8);
    free(stdoutRead, 8); free(stdoutWrite, 8);
    return -1;
  }

  var pid: int64 := sys_fork();

  if (pid < 0) {
    // fork fehlgeschlagen — alle fds schließen
    close(peek64(stdinRead));  close(peek64(stdinWrite));
    close(peek64(stdoutRead)); close(peek64(stdoutWrite));
    free(stdinRead, 8); free(stdinWrite, 8);
    free(stdoutRead, 8); free(stdoutWrite, 8);
    return -1;
  }

  if (pid == 0) {
    // Kindprozess: stdin ← stdinRead, stdout → stdoutWrite
    sys_dup2(peek64(stdinRead),  0);  // stdin  = 0
    sys_dup2(peek64(stdoutWrite), 1); // stdout = 1
    // Pipe-Enden des Kindes schließen (dup2 hat Kopien angelegt)
    close(peek64(stdinRead));  close(peek64(stdinWrite));
    close(peek64(stdoutRead)); close(peek64(stdoutWrite));
    sys_execve(prog as int64, _argv1(prog), 0);
    // execve scheitert: Kind beendet sich
    exit(1);
    return 0;
  }

  // Elternprozess: unbenutzte Pipe-Enden schließen
  close(peek64(stdinRead));
  close(peek64(stdoutWrite));

  // Ergebnis-fds an Caller liefern
  poke64(stdinFdOut,  peek64(stdinWrite));
  poke64(stdoutFdOut, peek64(stdoutRead));

  free(stdinRead, 8); free(stdinWrite, 8);
  free(stdoutRead, 8); free(stdoutWrite, 8);

  return pid;
}

// ============================================================================
// POSIX-Schicht (#1246)
// ============================================================================
//
// Die Unit-Doku fuehrt diese Namen in ihrer Funktionstabelle; die Huelle
// fehlte. Der Compiler stellt die Systemaufrufe als Builtins bereit
// (sys_fork, sys_execve, sys_wait4, sys_kill) — hier bekommen sie ihre
// gewohnten Namen.
//
// Wer nicht an C gebunden ist, nimmt besser die hoehere Ebene weiter oben in
// dieser Unit: spawn, run, wait_for, try_wait, terminate, shell. Sie nimmt
// einem die argv-Verwaltung und die Statusauswertung ab.
//
// Zur Warnung aus #1179: eine Zeile wie `extern fn fork(): int64;` OHNE
// link-Klausel bindet NICHTS — der Aufruf war ein No-op, der still 0 lieferte.
// Deshalb steht hier kein extern, sondern der Systemaufruf selbst.

// Erzeugt einen Kindprozess. Rueckgabe: im Kind 0, im Elternprozess die PID
// des Kindes, im Fehlerfall negativ.
pub fn fork(): int64 {
  return sys_fork();
}

// Ersetzt das Prozessabbild. Kehrt nur im Fehlerfall zurueck (negativ).
// `argv` und `envp` sind Zeiger auf nullterminierte Zeigerfelder, wie bei C.
pub fn execve(path: pchar, argv: int64, envp: int64): int64 {
  return sys_execve(path as int64, argv, envp);
}

// Wie execve, sucht das Programm aber ueber die ueblichen Verzeichnisse, wenn
// der Name keinen Schraegstrich enthaelt.
//
// BEWUSST NICHT die volle PATH-Auswertung: die Umgebungsvariable wird hier
// nicht gelesen. Gesucht wird in /usr/local/bin, /usr/bin und /bin — in dieser
// Reihenfolge. Wer PATH braucht, baut den Pfad selbst zusammen und nimmt
// execve; eine halbe PATH-Auswertung waere schlimmer als gar keine, weil sie
// in der Doku wie die echte aussaehe.
pub fn execvp(file: pchar, argv: int64): int64 {
  if (file == 0 as pchar) { return -1; }
  // Enthaelt der Name einen Schraegstrich, ist es ein Pfad — direkt versuchen.
  var i: int64 := 0;
  var n: int64 := StrLen(file);
  while (i < n) {
    if ((StrCharAt(file, i) & 255) == 47) { return sys_execve(file as int64, argv, 0); }
    i := i + 1;
  }
  var rc: int64 := _execvpVersuch("/usr/local/bin/"c, file, argv);
  if (rc >= 0) { return rc; }
  rc := _execvpVersuch("/usr/bin/"c, file, argv);
  if (rc >= 0) { return rc; }
  return _execvpVersuch("/bin/"c, file, argv);
}

fn _execvpVersuch(dir: pchar, file: pchar, argv: int64): int64 {
  var dl: int64 := StrLen(dir);
  var fl: int64 := StrLen(file);
  var buf: pchar := StrNew(dl + fl + 1);
  if (buf == 0 as pchar) { return -1; }
  var i: int64 := 0;
  while (i < dl) { StrSetChar(buf, i, StrCharAt(dir, i)); i := i + 1; }
  var j: int64 := 0;
  while (j < fl) { StrSetChar(buf, dl + j, StrCharAt(file, j)); j := j + 1; }
  StrSetChar(buf, dl + fl, 0);
  return sys_execve(buf as int64, argv, 0);
}

// Wartet auf eine Statusaenderung eines Kindprozesses. `status` ist ein
// int64-Zeiger (0 = kein Interesse), `options` wie bei waitpid (0 = warten,
// 1 = WNOHANG).
pub fn waitpid(pid: int64, status: int64, options: int64): int64 {
  return sys_wait4(pid, status, options, 0);
}

// Sendet ein Signal. Rueckgabe 0 bei Erfolg, sonst negativ.
pub fn kill(pid: int64, sig: int64): int64 {
  return sys_kill(pid, sig);
}
