// std/pdf/layer.lyx
// PDF optional content groups (viewer-toggleable layers) — WP-PDF-16

@description("PDF layers (OCG): PdfAddLayer, PdfLayerBegin, PdfLayerEnd, PdfLayerSetVisible")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, fs.write])
unit std.pdf.layer;

import std.alloc;
import std.pdf.builder;

fn _layerStrDup(s: pchar): int64 {
  var len: int64 := StrLen(s) + 1;
  var buf: int64 := alloc(len);
  if (buf == 0) { return 0; }
  var i: int64 := 0;
  while (i < len) {
    poke8(buf + i, StrCharAt(s, i));
    i += 1;
  }
  return buf;
}

fn _layerEnsure(doc: int64): int64 {
  var count: int64 := peek64(doc + PDF_DOC_LAYERCOUNT);
  var cap:   int64 := peek64(doc + PDF_DOC_LAYERCAP);
  var buf:   int64 := peek64(doc + PDF_DOC_LAYERBUF);
  if (count < cap) { return 1; }
  var newCap: int64 := cap * 2;
  var newBuf: int64 := alloc(newCap * PDF_LAYER_RECSIZE);
  if (newBuf == 0) { return 0; }
  var ci: int64 := 0;
  while (ci < count * PDF_LAYER_RECSIZE) {
    poke8(newBuf + ci, peek8(buf + ci));
    ci += 1;
  }
  while (ci < newCap * PDF_LAYER_RECSIZE) {
    poke8(newBuf + ci, 0);
    ci += 1;
  }
  free(buf, cap * PDF_LAYER_RECSIZE);
  poke64(doc + PDF_DOC_LAYERBUF, newBuf);
  poke64(doc + PDF_DOC_LAYERCAP, newCap);
  return 1;
}

// Write the layer index as decimal digits to the content stream.
fn _layerAppendInt(doc: int64, page: int64, n: int64): void {
  var buf: int64 := alloc(8);
  if (buf == 0) { return; }
  var bpos: int64 := 0;
  if (n >= 100) {
    poke8(buf + bpos, (n / 100) + 48);       bpos := bpos + 1;
    poke8(buf + bpos, ((n / 10) % 10) + 48); bpos := bpos + 1;
    poke8(buf + bpos, (n % 10) + 48);        bpos := bpos + 1;
  } else if (n >= 10) {
    poke8(buf + bpos, (n / 10) + 48); bpos := bpos + 1;
    poke8(buf + bpos, (n % 10) + 48); bpos := bpos + 1;
  } else {
    poke8(buf + bpos, n + 48); bpos := bpos + 1;
  }
  poke8(buf + bpos, 0);
  PdfContentAppendStr(doc, page, buf as pchar);   // #1343
  free(buf, 8);
}

// Register an optional content group (layer) with the given display name.
// Returns the layer index (0-based) on success, -1 on error.
// The layer is visible by default; call PdfLayerSetVisible to change.
pub fn PdfAddLayer(doc: int64, name: pchar): int64 {
  if (doc == 0) { return -1; }
  if (_layerEnsure(doc) == 0) { return -1; }
  var nameBuf: int64 := _layerStrDup(name);
  if (nameBuf == 0) { return -1; }
  var count: int64 := peek64(doc + PDF_DOC_LAYERCOUNT);
  var buf:   int64 := peek64(doc + PDF_DOC_LAYERBUF);
  var rec:   int64 := buf + count * PDF_LAYER_RECSIZE;
  poke64(rec + PDF_LAYER_NAMEBUF, nameBuf);
  poke64(rec + PDF_LAYER_NAMELEN, StrLen(name) + 1);
  poke64(rec + PDF_LAYER_VISIBLE, 1);
  poke64(doc + PDF_DOC_LAYERCOUNT, count + 1);
  return count;
}

// Begin a layer-marked region in the page content stream (/OC /LyrN BDC).
// All drawing commands until PdfLayerEnd belong to this layer.
pub fn PdfLayerBegin(doc: int64, page: int64, layerIdx: int64): void {
  if (doc == 0) { return; }
  PdfContentAppendStr(doc, page, "/OC /Lyr");
  _layerAppendInt(doc, page, layerIdx);
  PdfContentAppendStr(doc, page, " BDC\n");
}

// End the layer-marked region (EMC).
pub fn PdfLayerEnd(doc: int64, page: int64): void {
  if (doc == 0) { return; }
  PdfContentAppendStr(doc, page, "EMC\n");
}

// Set default visibility for a layer: 1 = visible (on), 0 = hidden (off).
pub fn PdfLayerSetVisible(doc: int64, layerIdx: int64, visible: int64): void {
  if (doc == 0) { return; }
  var count: int64 := peek64(doc + PDF_DOC_LAYERCOUNT);
  if (layerIdx < 0 || layerIdx >= count) { return; }
  var buf: int64 := peek64(doc + PDF_DOC_LAYERBUF);
  poke64(buf + layerIdx * PDF_LAYER_RECSIZE + PDF_LAYER_VISIBLE, visible);
}
