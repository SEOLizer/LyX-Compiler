// std/pdf/pagelabels.lyx
// PDF page label ranges (viewer page numbering) — WP-PDF-11

@description("PDF page labels: PdfSetPageLabel for roman/decimal/alpha numbering")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, fs.write])
unit std.pdf.pagelabels;

import std.alloc;
import std.pdf.builder;

fn _labelStrDup(s: pchar): int64 {
  var len: int64 := StrLen(s) + 1;
  var buf: int64 := alloc(len);
  if (buf == 0) { return 0; }
  var i: int64 := 0;
  while (i < len) {
    poke8(buf + i, StrCharAt(s, i));
    i += 1;
  }
  return buf;
}

fn _labelEnsure(doc: int64): int64 {
  var count: int64 := peek64(doc + PDF_DOC_LABELCOUNT);
  var cap:   int64 := peek64(doc + PDF_DOC_LABELCAP);
  var buf:   int64 := peek64(doc + PDF_DOC_LABELBUF);
  if (count < cap) { return 1; }
  var newCap: int64 := cap * 2;
  var newBuf: int64 := alloc(newCap * PDF_LABEL_RECSIZE);
  if (newBuf == 0) { return 0; }
  var ci: int64 := 0;
  while (ci < count * PDF_LABEL_RECSIZE) {
    poke8(newBuf + ci, peek8(buf + ci));
    ci += 1;
  }
  while (ci < newCap * PDF_LABEL_RECSIZE) {
    poke8(newBuf + ci, 0);
    ci += 1;
  }
  free(buf, cap * PDF_LABEL_RECSIZE);
  poke64(doc + PDF_DOC_LABELBUF, newBuf);
  poke64(doc + PDF_DOC_LABELCAP, newCap);
  return 1;
}

// Define how pages are numbered starting at firstPage (0-based page index).
// style:    PDF_LABEL_DECIMAL / ROMAN_L / ROMAN_U / ALPHA_L / ALPHA_U / NONE
// prefix:   string prepended to the number (e.g. "A-"), or "" for none
// startNum: first number in this range (typically 1)
// Ranges must be added in ascending firstPage order.
// Returns 0 on success, -1 on error.
pub fn PdfSetPageLabel(doc: int64, firstPage: int64, style: int64, prefix: pchar, startNum: int64): int64 {
  if (doc == 0) { return -1; }
  if (_labelEnsure(doc) == 0) { return -1; }
  var pfxLen: int64 := 0;
  var pfxBuf: int64 := 0;
  if (StrLen(prefix) > 0) {
    pfxLen := StrLen(prefix) + 1;
    pfxBuf := _labelStrDup(prefix);
    if (pfxBuf == 0) { return -1; }
  }
  var count: int64 := peek64(doc + PDF_DOC_LABELCOUNT);
  var buf:   int64 := peek64(doc + PDF_DOC_LABELBUF);
  var rec:   int64 := buf + count * PDF_LABEL_RECSIZE;
  poke64(rec + PDF_LABEL_FIRSTPAGE,  firstPage);
  poke64(rec + PDF_LABEL_STYLE,      style);
  poke64(rec + PDF_LABEL_STARTNUM,   startNum);
  poke64(rec + PDF_LABEL_PREFIXBUF,  pfxBuf);
  poke64(rec + PDF_LABEL_PREFIXLEN,  pfxLen);
  poke64(doc + PDF_DOC_LABELCOUNT,   count + 1);
  return 0;
}
