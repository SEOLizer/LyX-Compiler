// std/pdf/compress.lyx
// zlib/DEFLATE (RFC 1950/1951) für den PDF-Filter FlateDecode (WP-PDF-05)
//
// #1071: Diese Datei trug bis 1.0.11D eine ZWEITE, unabhängige
// DEFLATE-Implementierung — eigener Bitschreiber, eigene Symbolemission,
// eigene Hashtabelle — neben der in std/zlib.lyx. Beide lösten dasselbe
// Problem mit denselben Parametern, und ein Fix in der einen erreichte die
// andere nicht.
//
// Genau das war eingetreten: die Fassung in std/zlib.lyx schrieb je 32768 Byte
// einen neuen Blockkopf, setzte das End-of-Block-Symbol aber nur einmal ganz
// am Schluss, und erzeugte damit ab 32 kB Eingabe ungültige Ströme — während
// die Fassung hier korrekt war. Aufgefallen ist das erst, als beide auf
// dieselbe Eingabe geworfen und mit einem fremden Inflater gegengelesen
// wurden.
//
// Aufgelöst wurde es in die Richtung, die der Messung standhielt: der Rumpf
// von hier ist jetzt die einzige DEFLATE-Kompression der stdlib und steht in
// std/zlib.lyx. Übrig bleibt hier der Adapter, den PDF braucht.

@description("zlib/DEFLATE compression: zlibCompress, zlibMaxOutputSize")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.pdf.compress;

import std.zlib;

// Höchstzahl Bytes, die zlibCompress für inLen Eingabebytes schreibt.
pub fn zlibMaxOutputSize(inLen: int64): int64 {
  return ZlibCompressBound(inLen);
}

// Komprimiert input[0..inLen) nach output im zlib-Format (RFC 1950) mit
// DEFLATE-Rumpf. output braucht mindestens zlibMaxOutputSize(inLen) Bytes.
// Gibt die Zahl der geschriebenen Bytes zurück, 0 bei leerer Eingabe.
//
// Die Zeiger kommen bei PDF als int64 an, in std/zlib.lyx heißen sie pchar —
// derselbe Wert, andere Schreibweise.
pub fn zlibCompress(input: int64, inLen: int64, output: int64): int64 {
  if (inLen <= 0) { return 0; }
  return ZlibCompress(input as pchar, inLen, output as pchar, Z_DEFAULT_COMPRESSION);
}
