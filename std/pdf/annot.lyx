// std/pdf/annot.lyx
// PDF annotations: URI links, GoTo page links, text notes (WP-PDF-08)
// Note: functions are capped at 6 arguments to avoid the 7-arg register-shift bug.

@description("PDF annotations: PdfAddLink, PdfLinkSetURI, PdfAddLinkGoto, PdfLinkSetGoto, PdfAddNote")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, fs.write])
unit std.pdf.annot;

import std.alloc;
import std.pdf.builder;

fn _annotEnsure(doc: int64): int64 {
  var count: int64 := peek64(doc + PDF_DOC_ANNOTCOUNT);
  var cap:   int64 := peek64(doc + PDF_DOC_ANNOTCAP);
  var buf:   int64 := peek64(doc + PDF_DOC_ANNOTBUF);
  if (count < cap) { return 1; }
  var newCap: int64 := cap * 2;
  var newBuf: int64 := alloc(newCap * PDF_ANNOT_RECSIZE);
  if (newBuf == 0) { return 0; }
  var ci: int64 := 0;
  while (ci < count * PDF_ANNOT_RECSIZE) {
    poke8(newBuf + ci, peek8(buf + ci));
    ci += 1;
  }
  while (ci < newCap * PDF_ANNOT_RECSIZE) {
    poke8(newBuf + ci, 0);
    ci += 1;
  }
  free(buf, cap * PDF_ANNOT_RECSIZE);
  poke64(doc + PDF_DOC_ANNOTBUF, newBuf);
  poke64(doc + PDF_DOC_ANNOTCAP, newCap);
  return 1;
}

fn _strDup(s: pchar): int64 {
  var len: int64 := StrLen(s) + 1;
  var buf: int64 := alloc(len);
  if (buf == 0) { return 0; }
  var i: int64 := 0;
  while (i < len) {
    poke8(buf + i, StrCharAt(s, i));
    i += 1;
  }
  return buf;
}

// Add a link annotation (clickable rect) — returns annotIdx for follow-up calls.
// Call PdfLinkSetURI or PdfLinkSetGoto immediately after to set the link action.
pub fn PdfAddLink(doc: int64, page: int64, x1: f64, y1: f64, x2: f64, y2: f64): int64 {
  if (doc == 0) { return -1; }
  if (_annotEnsure(doc) == 0) { return -1; }
  var count: int64 := peek64(doc + PDF_DOC_ANNOTCOUNT);
  var buf:   int64 := peek64(doc + PDF_DOC_ANNOTBUF);
  var rec:   int64 := buf + count * PDF_ANNOT_RECSIZE;
  poke64(rec + PDF_ANNOT_TYPE,     1);
  poke64(rec + PDF_ANNOT_PAGE,     page);
  poke64(rec + PDF_ANNOT_X1_100,   f64ToInt100(x1));
  poke64(rec + PDF_ANNOT_Y1_100,   f64ToInt100(y1));
  poke64(rec + PDF_ANNOT_X2_100,   f64ToInt100(x2));
  poke64(rec + PDF_ANNOT_Y2_100,   f64ToInt100(y2));
  poke64(rec + PDF_ANNOT_DATA1,    0);
  poke64(rec + PDF_ANNOT_DATA1LEN, 0);
  poke64(rec + PDF_ANNOT_DATA2,    0);
  poke64(rec + PDF_ANNOT_DATA2LEN, 0);
  poke64(rec + PDF_ANNOT_EXTRA,    0);
  poke64(doc + PDF_DOC_ANNOTCOUNT, count + 1);
  return count;
}

// Set the URI for a link annotation created by PdfAddLink.
pub fn PdfLinkSetURI(doc: int64, annotIdx: int64, url: pchar): void {
  if (doc == 0) { return; }
  var buf: int64 := peek64(doc + PDF_DOC_ANNOTBUF);
  var rec: int64 := buf + annotIdx * PDF_ANNOT_RECSIZE;
  var old: int64 := peek64(rec + PDF_ANNOT_DATA1);
  var oln: int64 := peek64(rec + PDF_ANNOT_DATA1LEN);
  if (old != 0 && oln > 0) { free(old, oln); }
  var urlLen: int64 := StrLen(url) + 1;
  var urlBuf: int64 := _strDup(url);
  poke64(rec + PDF_ANNOT_DATA1,    urlBuf);
  poke64(rec + PDF_ANNOT_DATA1LEN, urlLen);
}

// Add a GoTo link annotation (jumps to another page in the same document).
// Call PdfLinkSetGoto immediately after to set the destination page.
pub fn PdfAddLinkGoto(doc: int64, page: int64, x1: f64, y1: f64, x2: f64, y2: f64): int64 {
  if (doc == 0) { return -1; }
  if (_annotEnsure(doc) == 0) { return -1; }
  var count: int64 := peek64(doc + PDF_DOC_ANNOTCOUNT);
  var buf:   int64 := peek64(doc + PDF_DOC_ANNOTBUF);
  var rec:   int64 := buf + count * PDF_ANNOT_RECSIZE;
  poke64(rec + PDF_ANNOT_TYPE,     3);
  poke64(rec + PDF_ANNOT_PAGE,     page);
  poke64(rec + PDF_ANNOT_X1_100,   f64ToInt100(x1));
  poke64(rec + PDF_ANNOT_Y1_100,   f64ToInt100(y1));
  poke64(rec + PDF_ANNOT_X2_100,   f64ToInt100(x2));
  poke64(rec + PDF_ANNOT_Y2_100,   f64ToInt100(y2));
  poke64(rec + PDF_ANNOT_DATA1,    0);
  poke64(rec + PDF_ANNOT_DATA1LEN, 0);
  poke64(rec + PDF_ANNOT_DATA2,    0);
  poke64(rec + PDF_ANNOT_DATA2LEN, 0);
  poke64(rec + PDF_ANNOT_EXTRA,    0);
  poke64(doc + PDF_DOC_ANNOTCOUNT, count + 1);
  return count;
}

// Set the destination page for a GoTo link created by PdfAddLinkGoto.
pub fn PdfLinkSetGoto(doc: int64, annotIdx: int64, destPage: int64): void {
  if (doc == 0) { return; }
  var buf: int64 := peek64(doc + PDF_DOC_ANNOTBUF);
  var rec: int64 := buf + annotIdx * PDF_ANNOT_RECSIZE;
  poke64(rec + PDF_ANNOT_EXTRA, destPage);
}

// Add a text note (sticky-note icon) annotation. Returns annotIdx.
pub fn PdfAddNote(doc: int64, page: int64, x: f64, y: f64, title: pchar, content: pchar): int64 {
  if (doc == 0) { return -1; }
  if (_annotEnsure(doc) == 0) { return -1; }
  var contLen: int64 := StrLen(content) + 1;
  var contBuf: int64 := _strDup(content);
  if (contBuf == 0) { return -1; }
  var titLen:  int64 := StrLen(title) + 1;
  var titBuf:  int64 := _strDup(title);
  if (titBuf == 0) { free(contBuf, contLen); return -1; }
  var x1: int64 := f64ToInt100(x);
  var y1: int64 := f64ToInt100(y);
  var count: int64 := peek64(doc + PDF_DOC_ANNOTCOUNT);
  var buf:   int64 := peek64(doc + PDF_DOC_ANNOTBUF);
  var rec:   int64 := buf + count * PDF_ANNOT_RECSIZE;
  poke64(rec + PDF_ANNOT_TYPE,     2);
  poke64(rec + PDF_ANNOT_PAGE,     page);
  poke64(rec + PDF_ANNOT_X1_100,   x1);
  poke64(rec + PDF_ANNOT_Y1_100,   y1);
  poke64(rec + PDF_ANNOT_X2_100,   x1 + 2000);
  poke64(rec + PDF_ANNOT_Y2_100,   y1 + 2000);
  poke64(rec + PDF_ANNOT_DATA1,    contBuf);
  poke64(rec + PDF_ANNOT_DATA1LEN, contLen);
  poke64(rec + PDF_ANNOT_DATA2,    titBuf);
  poke64(rec + PDF_ANNOT_DATA2LEN, titLen);
  poke64(rec + PDF_ANNOT_EXTRA,    0);
  poke64(doc + PDF_DOC_ANNOTCOUNT, count + 1);
  return count;
}
