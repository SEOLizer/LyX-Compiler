// std/pdf/meta.lyx
// PDF document metadata: /Info dictionary fields (WP-PDF-07)
// Fields are stored inline in the 4096-byte doc block (no extra allocation).

@description("PDF document metadata: PdfSetTitle, PdfSetAuthor, etc.")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, fs.write])
unit std.pdf.meta;

import std.pdf.builder;

// Copy src string into the doc block at offset, truncating to maxLen-1 chars.
fn _metaCopy(dst: int64, src: pchar, maxLen: int64): void {
  var i: int64 := 0;
  while (i < maxLen - 1) {
    var c: int64 := StrCharAt(src, i);
    poke8(dst + i, c);
    if (c == 0) { return; }
    i += 1;
  }
  poke8(dst + maxLen - 1, 0);
}

pub fn PdfSetTitle(doc: int64, title: pchar): void {
  if (doc == 0) { return; }
  _metaCopy(doc + PDF_DOC_META_TITLE, title, 256);
}

pub fn PdfSetAuthor(doc: int64, author: pchar): void {
  if (doc == 0) { return; }
  _metaCopy(doc + PDF_DOC_META_AUTHOR, author, 256);
}

pub fn PdfSetSubject(doc: int64, subject: pchar): void {
  if (doc == 0) { return; }
  _metaCopy(doc + PDF_DOC_META_SUBJECT, subject, 256);
}

pub fn PdfSetKeywords(doc: int64, keywords: pchar): void {
  if (doc == 0) { return; }
  _metaCopy(doc + PDF_DOC_META_KEYWORDS, keywords, 256);
}

pub fn PdfSetCreator(doc: int64, creator: pchar): void {
  if (doc == 0) { return; }
  _metaCopy(doc + PDF_DOC_META_CREATOR, creator, 128);
}

pub fn PdfSetProducer(doc: int64, producer: pchar): void {
  if (doc == 0) { return; }
  _metaCopy(doc + PDF_DOC_META_PRODUCER, producer, 128);
}
