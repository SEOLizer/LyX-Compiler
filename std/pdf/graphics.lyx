pub fn PdfTranslate(doc: int64, page: int64, tx: f64, ty: f64): void {
  if (doc == 0) { return; }
  if (PdfContentEnsure(doc, page, 64) == 0) { return; }
  var buf: int64 := pdfXBuf(doc, page);
  var pos: int64 := pdfXPos(doc, page);
  pos := pdfStr(buf, pos, "1 0 0 1 ");
  pos := pdfSignedReal100(buf, pos, f64ToInt100(tx)); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, f64ToInt100(ty));
  pos := pdfStr(buf, pos, " cm\n");
  pdfXSetPos(doc, page, pos);
}

pub fn PdfScale(doc: int64, page: int64, sx: f64, sy: f64): void {
  if (doc == 0) { return; }
  if (PdfContentEnsure(doc, page, 64) == 0) { return; }
  var buf: int64 := pdfXBuf(doc, page);
  var pos: int64 := pdfXPos(doc, page);
  pos := pdfSignedReal100(buf, pos, f64ToInt100(sx));
  pos := pdfStr(buf, pos, " 0 0 ");
  pos := pdfSignedReal100(buf, pos, f64ToInt100(sy));
  pos := pdfStr(buf, pos, " 0 0 cm\n");
  pdfXSetPos(doc, page, pos);
}

// ============================================================================
// PdfRotate — rotation via sin/cos lookup table (1-degree resolution, ×100)
// ============================================================================

fn _sinDeg100(d: int64): int64 {
  if (d <= 0)  { return 0; }
  if (d >= 90) { return 100; }
  if (d == 1)  { return 2; }   if (d == 2)  { return 3; }   if (d == 3)  { return 5; }
  if (d == 4)  { return 7; }   if (d == 5)  { return 9; }   if (d == 6)  { return 10; }
  if (d == 7)  { return 12; }  if (d == 8)  { return 14; }  if (d == 9)  { return 16; }
  if (d == 10) { return 17; }  if (d == 11) { return 19; }  if (d == 12) { return 21; }
  if (d == 13) { return 22; }  if (d == 14) { return 24; }  if (d == 15) { return 26; }
  if (d == 16) { return 28; }  if (d == 17) { return 29; }  if (d == 18) { return 31; }
  if (d == 19) { return 33; }  if (d == 20) { return 34; }  if (d == 21) { return 36; }
  if (d == 22) { return 37; }  if (d == 23) { return 39; }  if (d == 24) { return 41; }
  if (d == 25) { return 42; }  if (d == 26) { return 44; }  if (d == 27) { return 45; }
  if (d == 28) { return 47; }  if (d == 29) { return 48; }  if (d == 30) { return 50; }
  if (d == 31) { return 52; }  if (d == 32) { return 53; }  if (d == 33) { return 54; }
  if (d == 34) { return 56; }  if (d == 35) { return 57; }  if (d == 36) { return 59; }
  if (d == 37) { return 60; }  if (d == 38) { return 62; }  if (d == 39) { return 63; }
  if (d == 40) { return 64; }  if (d == 41) { return 66; }  if (d == 42) { return 67; }
  if (d == 43) { return 68; }  if (d == 44) { return 69; }  if (d == 45) { return 71; }
  if (d == 46) { return 72; }  if (d == 47) { return 73; }  if (d == 48) { return 74; }
  if (d == 49) { return 75; }  if (d == 50) { return 77; }  if (d == 51) { return 78; }
  if (d == 52) { return 79; }  if (d == 53) { return 80; }  if (d == 54) { return 81; }
  if (d == 55) { return 82; }  if (d == 56) { return 83; }  if (d == 57) { return 84; }
  if (d == 58) { return 85; }  if (d == 59) { return 86; }  if (d == 60) { return 87; }
  if (d == 61) { return 87; }  if (d == 62) { return 88; }  if (d == 63) { return 89; }
  if (d == 64) { return 90; }  if (d == 65) { return 91; }  if (d == 66) { return 91; }
  if (d == 67) { return 92; }  if (d == 68) { return 93; }  if (d == 69) { return 93; }
  if (d == 70) { return 94; }  if (d == 71) { return 95; }  if (d == 72) { return 95; }
  if (d == 73) { return 96; }  if (d == 74) { return 96; }  if (d == 75) { return 97; }
  if (d == 76) { return 97; }  if (d == 77) { return 97; }  if (d == 78) { return 98; }
  if (d == 79) { return 98; }  if (d == 80) { return 98; }  if (d == 81) { return 99; }
  if (d == 82) { return 99; }  if (d == 83) { return 99; }  if (d == 84) { return 99; }
  if (d == 85) { return 100; } if (d == 86) { return 100; } if (d == 87) { return 100; }
  if (d == 88) { return 100; } if (d == 89) { return 100; }
  return 100;
}

fn _sinRot100(deg: int64): int64 {
  var d: int64 := deg - (deg / 360) * 360;
  if (d < 0) { d := d + 360; }
  if (d <= 90)  { return _sinDeg100(d); }
  if (d <= 180) { return _sinDeg100(180 - d); }
  if (d <= 270) { return 0 - _sinDeg100(d - 180); }
  return 0 - _sinDeg100(360 - d);
}

fn _cosRot100(deg: int64): int64 {
  return _sinRot100(deg + 90);
}

pub fn PdfRotate(doc: int64, page: int64, angle: f64): void {
  if (doc == 0) { return; }
  if (PdfContentEnsure(doc, page, 64) == 0) { return; }
  var buf: int64 := pdfXBuf(doc, page);
  var pos: int64 := pdfXPos(doc, page);
  var deg:    int64 := f64Trunc(angle);
  var cos100: int64 := _cosRot100(deg);
  var sin100: int64 := _sinRot100(deg);
  pos := pdfSignedReal100(buf, pos, cos100);        poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, sin100);        poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, 0 - sin100);   poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cos100);
  pos := pdfStr(buf, pos, " 0 0 cm\n");
  pdfXSetPos(doc, page, pos);
}
