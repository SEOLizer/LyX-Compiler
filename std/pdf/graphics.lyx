pub fn PdfFill(doc: int64, page: int64): void {
  if (doc == 0) { return; }
  if (PdfContentEnsure(doc, page, 4) == 0) { return; }
  var buf: int64 := pdfXBuf(doc, page);
  var pos: int64 := pdfXPos(doc, page);
  pos := pdfStr(buf, pos, "f\n");
  pdfXSetPos(doc, page, pos);
}

