// PdfCircle — cubic Bézier approximation with κ ≈ 0.5523
pub fn PdfCircle(doc: int64, page: int64, cx: f64, cy: f64, r: f64): void {
  if (doc == 0) { return; }
  if (PdfContentEnsure(doc, page, 512) == 0) { return; }
  var buf: int64 := pdfXBuf(doc, page);
  var pos: int64 := pdfXPos(doc, page);
  var cx100: int64 := f64ToInt100(cx);
  var cy100: int64 := f64ToInt100(cy);
  var r100:  int64 := f64ToInt100(r);
  var k100:  int64 := r100 * 5523 / 10000;
  // MoveTo (cx+r, cy)
  pos := pdfSignedReal100(buf, pos, cx100+r100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100);
  pos := pdfStr(buf, pos, " m\n");
  // Arc Q1→Q2: right → top
  pos := pdfSignedReal100(buf, pos, cx100+r100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100+k100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100+k100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100+r100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100);      poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100+r100); pos := pdfStr(buf, pos, " c\n");
  // Arc Q2→Q3: top → left
  pos := pdfSignedReal100(buf, pos, cx100-k100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100+r100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100-r100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100+k100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100-r100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100);      pos := pdfStr(buf, pos, " c\n");
  // Arc Q3→Q4: left → bottom
  pos := pdfSignedReal100(buf, pos, cx100-r100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100-k100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100-k100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100-r100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100);      poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100-r100); pos := pdfStr(buf, pos, " c\n");
  // Arc Q4→Q1: bottom → right
  pos := pdfSignedReal100(buf, pos, cx100+k100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100-r100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100+r100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100-k100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100+r100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100);      pos := pdfStr(buf, pos, " c\nh\n");
  pdfXSetPos(doc, page, pos);
}

// PdfEllipse — like PdfCircle but with independent rx/ry
pub fn PdfEllipse(doc: int64, page: int64, cx: f64, cy: f64, rx: f64, ry: f64): void {
  if (doc == 0) { return; }
  if (PdfContentEnsure(doc, page, 512) == 0) { return; }
  var buf: int64 := pdfXBuf(doc, page);
  var pos: int64 := pdfXPos(doc, page);
  var cx100: int64 := f64ToInt100(cx);
  var cy100: int64 := f64ToInt100(cy);
  var rx100: int64 := f64ToInt100(rx);
  var ry100: int64 := f64ToInt100(ry);
  var kx100: int64 := rx100 * 5523 / 10000;
  var ky100: int64 := ry100 * 5523 / 10000;
  pos := pdfSignedReal100(buf, pos, cx100+rx100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100);       pos := pdfStr(buf, pos, " m\n");
  pos := pdfSignedReal100(buf, pos, cx100+rx100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100+ky100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100+kx100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100+ry100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100);       poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100+ry100); pos := pdfStr(buf, pos, " c\n");
  pos := pdfSignedReal100(buf, pos, cx100-kx100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100+ry100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100-rx100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100+ky100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100-rx100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100);       pos := pdfStr(buf, pos, " c\n");
  pos := pdfSignedReal100(buf, pos, cx100-rx100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100-ky100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100-kx100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100-ry100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100);       poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100-ry100); pos := pdfStr(buf, pos, " c\n");
  pos := pdfSignedReal100(buf, pos, cx100+kx100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100-ry100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100+rx100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100-ky100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cx100+rx100); poke8(buf+pos, 32); pos := pos+1;
  pos := pdfSignedReal100(buf, pos, cy100);       pos := pdfStr(buf, pos, " c\nh\n");
  pdfXSetPos(doc, page, pos);
}

