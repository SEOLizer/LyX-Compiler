pub fn PdfSetDash(doc: int64, page: int64, on: f64, off: f64): void {
  if (doc == 0) { return; }
  if (PdfContentEnsure(doc, page, 48) == 0) { return; }
  var buf: int64 := pdfXBuf(doc, page);
  var pos: int64 := pdfXPos(doc, page);
  var on100:  int64 := f64ToInt100(on);
  var off100: int64 := f64ToInt100(off);
  if (on100 == 0) {
    pos := pdfStr(buf, pos, "[] 0 d\n");
  } else {
    poke8(buf+pos, 91); pos := pos+1;   // '['
    pos := pdfReal100(buf, pos, on100);
    poke8(buf+pos, 32); pos := pos+1;
    pos := pdfReal100(buf, pos, off100);
    pos := pdfStr(buf, pos, "] 0 d\n");
  }
  pdfXSetPos(doc, page, pos);
}

