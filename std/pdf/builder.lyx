    pos := pdfObjFtr(out, pos);
    poke64(xrefs + attFsId * 8, pos);
    pos := pdfObjHdr(out, pos, attFsId);
    pos := pdfStr(out, pos, "<< /Type /Filespec /F ");
    pos := _pdfEscStr(out, pos, attName);
    pos := pdfStr(out, pos, " /EF << /F ");
    pos := pdfRef(out, pos, attSId);
    pos := pdfStr(out, pos, " >> >>");
    pos := pdfObjFtr(out, pos);
    attI := attI + 1;
  }

  // --- OCG layer objects ---
  var lyrI: int64 := 0;
  while (lyrI < layerCount) {
    var lyrRec:   int64 := layerBuf + lyrI * PDF_LAYER_RECSIZE;
    var lyrName:  int64 := peek64(lyrRec + PDF_LAYER_NAMEBUF);
    var lyrObjId: int64 := layerBaseId + lyrI;
    poke64(xrefs + lyrObjId * 8, pos);
    pos := pdfObjHdr(out, pos, lyrObjId);
    pos := pdfStr(out, pos, "<< /Type /OCG /Name ");
    pos := _pdfEscStr(out, pos, lyrName);
    pos := pdfStr(out, pos, " >>");
    pos := pdfObjFtr(out, pos);
    lyrI := lyrI + 1;
  }

  // --- XRef section ---
  // Emit /Encrypt dict object (WP-PDF-17)
  if (encType != PDF_ENC_NONE && encReady != 0) {
    var encDictId: int64 := peek64(doc + PDF_DOC_ENCCURID);
    var encOKey: int64 := peek64(doc + PDF_DOC_ENCOKEY);
    var encUKey: int64 := peek64(doc + PDF_DOC_ENCUKEY);
    var encPerms: int64 := peek64(doc + PDF_DOC_ENCPERMS);
    poke64(xrefs + encDictId * 8, pos);
    pos := pdfObjHdr(out, pos, encDictId);
    pos := pdfStr(out, pos, "<< /Filter /Standard /V 2 /R 3 /Length 128 /P ");
    pos := pdfInt(out, pos, encPerms);
    pos := pdfStr(out, pos, " /O <");
    var oi: int64 := 0;
    while (oi < 32) {
      var ob: int64 := peek8(encOKey + oi);
      var oh: int64 := (ob >> 4) & 0xF;  var ol: int64 := ob & 0xF;
      if (oh < 10) { poke8(out+pos, 48+oh); } else { poke8(out+pos, 55+oh); } pos:=pos+1;
      if (ol < 10) { poke8(out+pos, 48+ol); } else { poke8(out+pos, 55+ol); } pos:=pos+1;
      oi := oi + 1;
    }
    pos := pdfStr(out, pos, "> /U <");
    var ui: int64 := 0;
    while (ui < 32) {
      var ub: int64 := peek8(encUKey + ui);
      var uh: int64 := (ub >> 4) & 0xF;  var ul2: int64 := ub & 0xF;
      if (uh < 10) { poke8(out+pos, 48+uh); } else { poke8(out+pos, 55+uh); } pos:=pos+1;
      if (ul2 < 10) { poke8(out+pos, 48+ul2); } else { poke8(out+pos, 55+ul2); } pos:=pos+1;
      ui := ui + 1;
    }
    pos := pdfStr(out, pos, "> >>");
    pos := pdfObjFtr(out, pos);
  }

  var xrefStart: int64 := pos;
  var xrefCount: int64 := nextId + hasInfo + annotCount + outlineObjCount + attachObjCount + layerCount;

  pos := pdfStr(out, pos, "xref\n0 ");
  pos := pdfInt(out, pos, xrefCount);
  poke8(out + pos, 10); pos := pos + 1;

  // Free entry for object 0
  pos := pdfXrefEntry(out, pos, 0, 65535, true);

  // In-use entries for objects 1..xrefCount-1
  var id: int64 := 1;
  while (id < xrefCount) {
    var off: int64 := peek64(xrefs + id * 8);
    pos := pdfXrefEntry(out, pos, off, 0, false);
    id := id + 1;
  }

  // --- Trailer ---
  pos := pdfStr(out, pos, "trailer\n<< /Size ");
  pos := pdfInt(out, pos, xrefCount);
  pos := pdfStr(out, pos, " /Root 1 0 R");
  if (hasInfo != 0) {
    pos := pdfStr(out, pos, " /Info ");
    pos := pdfRef(out, pos, infoId);
  }
  // /Encrypt reference (WP-PDF-17)
  if (encType != PDF_ENC_NONE && encReady != 0) {
    var encObjId: int64 := peek64(doc + PDF_DOC_ENCCURID);
    pos := pdfStr(out, pos, " /Encrypt ");
    pos := pdfRef(out, pos, encObjId);
    // /ID [<fileId> <fileId>] — use first 16 bytes of /U value as file ID
    var uid: int64 := peek64(doc + PDF_DOC_ENCUKEY);
    if (uid != 0) {
      pos := pdfStr(out, pos, " /ID [<");
      var ii: int64 := 0;
      while (ii < 16) {
        var hb: int64 := peek8(uid + ii);
        var hn: int64 := (hb >> 4) & 0xF;
        var ln: int64 := hb & 0xF;
        if (hn < 10) { poke8(out+pos, 48+hn); } else { poke8(out+pos, 55+hn); } pos:=pos+1;
        if (ln < 10) { poke8(out+pos, 48+ln); } else { poke8(out+pos, 55+ln); } pos:=pos+1;
        ii := ii + 1;
      }
      pos := pdfStr(out, pos, "><");
      ii := 0;
      while (ii < 16) {
        var hb2: int64 := peek8(uid + ii);
        var hn2: int64 := (hb2 >> 4) & 0xF;
        var ln2: int64 := hb2 & 0xF;
        if (hn2 < 10) { poke8(out+pos, 48+hn2); } else { poke8(out+pos, 55+hn2); } pos:=pos+1;
        if (ln2 < 10) { poke8(out+pos, 48+ln2); } else { poke8(out+pos, 55+ln2); } pos:=pos+1;
        ii := ii + 1;
      }
      pos := pdfStr(out, pos, ">]");
    }
  }
  pos := pdfStr(out, pos, " >>\nstartxref\n");
  pos := pdfInt(out, pos, xrefStart);
  pos := pdfStr(out, pos, "\n%%EOF\n");

  // --- Write to file ---
  var fd: int64 := open(path, 577, 420);
  if (fd < 0) {
    munmap(xrefs, xrefSize);
    munmap(out, PDF_OUT_BUF_SIZE);
    return -4;
  }

  var written: int64 := write(fd, out, pos);
  close(fd);

  munmap(xrefs, xrefSize);
  munmap(out, PDF_OUT_BUF_SIZE);

  if (written != pos) { return -5; }
  return 0;
}
