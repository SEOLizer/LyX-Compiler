pub con PDF_DOC_META_KEYWORDS: int64 := 3088;   // char[256]
pub con PDF_DOC_META_CREATOR:  int64 := 3344;   // char[128]
pub con PDF_DOC_META_PRODUCER: int64 := 3472;   // char[128]

// Annotation list (offsets 3600..3623, within the 4096-byte doc block)
pub con PDF_DOC_ANNOTCOUNT:     int64 := 3600;   // int64 total annotation count
pub con PDF_DOC_ANNOTCAP:       int64 := 3608;   // int64 capacity of annotBuf
pub con PDF_DOC_ANNOTBUF:       int64 := 3616;   // int64* annotation record buffer

// Annotation record layout (96 bytes each, stored in annotBuf)
pub con PDF_ANNOT_TYPE:      int64 := 0;   // 1=link_uri 2=text_note 3=link_goto
pub con PDF_ANNOT_PAGE:      int64 := 8;   // page index (int64)
pub con PDF_ANNOT_X1_100:    int64 := 16;  // rect x1 × 100
pub con PDF_ANNOT_Y1_100:    int64 := 24;  // rect y1 × 100
pub con PDF_ANNOT_X2_100:    int64 := 32;  // rect x2 × 100
pub con PDF_ANNOT_Y2_100:    int64 := 40;  // rect y2 × 100
pub con PDF_ANNOT_DATA1:     int64 := 48;  // int64* URL (link) or content text (note)
pub con PDF_ANNOT_DATA1LEN:  int64 := 56;  // allocation length of data1
pub con PDF_ANNOT_DATA2:     int64 := 64;  // int64* title (note only)
pub con PDF_ANNOT_DATA2LEN:  int64 := 72;  // allocation length of data2
pub con PDF_ANNOT_EXTRA:     int64 := 80;  // dest page index (link_goto)
pub con PDF_ANNOT_RECSIZE:   int64 := 96;
pub con PDF_ANNOT_INITIAL_CAP: int64 := 16;

// Outline (bookmarks) list (offsets 3624..3647, within 4096-byte doc block)
pub con PDF_DOC_OUTLINECOUNT:    int64 := 3624;  // int64 item count
pub con PDF_DOC_OUTLINECAP:      int64 := 3632;  // int64 capacity
pub con PDF_DOC_OUTLINEBUF:      int64 := 3640;  // int64* record buffer

// Outline record layout (32 bytes each, stored in outlineBuf)
pub con PDF_OUTLINE_PARENT:      int64 := 0;   // int64 parent index (-1 = root)
pub con PDF_OUTLINE_DESTPAGE:    int64 := 8;   // int64 destination page index
pub con PDF_OUTLINE_TITLEBUF:    int64 := 16;  // int64* title string (mmap'd, NUL-term)
pub con PDF_OUTLINE_TITLELEN:    int64 := 24;  // int64 title allocation length
pub con PDF_OUTLINE_RECSIZE:     int64 := 32;
pub con PDF_OUTLINE_INITIAL_CAP: int64 := 8;

// Page label ranges (offsets 3648..3671, within 4096-byte doc block)
pub con PDF_DOC_LABELCOUNT:      int64 := 3648;  // int64 range count
pub con PDF_DOC_LABELCAP:        int64 := 3656;  // int64 capacity
pub con PDF_DOC_LABELBUF:        int64 := 3664;  // int64* record buffer

// Page label record layout (40 bytes each, stored in labelBuf)
pub con PDF_LABEL_FIRSTPAGE:     int64 := 0;   // int64 first page index (0-based)
pub con PDF_LABEL_STYLE:         int64 := 8;   // int64 style constant
pub con PDF_LABEL_STARTNUM:      int64 := 16;  // int64 starting page number (1 = default)
pub con PDF_LABEL_PREFIXBUF:     int64 := 24;  // int64* prefix string (mmap'd) or 0
pub con PDF_LABEL_PREFIXLEN:     int64 := 32;  // int64 prefix allocation length
pub con PDF_LABEL_RECSIZE:       int64 := 40;
pub con PDF_LABEL_INITIAL_CAP:   int64 := 4;

// Page label style constants
pub con PDF_LABEL_DECIMAL:       int64 := 1;   // 1, 2, 3 …
pub con PDF_LABEL_ROMAN_L:       int64 := 2;   // i, ii, iii …
pub con PDF_LABEL_ROMAN_U:       int64 := 3;   // I, II, III …
pub con PDF_LABEL_ALPHA_L:       int64 := 4;   // a, b, c …
pub con PDF_LABEL_ALPHA_U:       int64 := 5;   // A, B, C …
pub con PDF_LABEL_NONE:          int64 := 6;   // prefix only, no numeric part

// Page transition records (offsets 3672..3695, within 4096-byte doc block)
pub con PDF_DOC_TRANSCOUNT:      int64 := 3672;  // int64 record count
pub con PDF_DOC_TRANSCAP:        int64 := 3680;  // int64 capacity
pub con PDF_DOC_TRANSBUF:        int64 := 3688;  // int64* record buffer

// Page transition record layout (24 bytes each)
pub con PDF_TRANS_PAGEIDX:       int64 := 0;   // int64 page index (0-based)
pub con PDF_TRANS_TYPE:          int64 := 8;   // int64 transition type constant
pub con PDF_TRANS_DUR100:        int64 := 16;  // int64 duration × 100 (0 = viewer default)
pub con PDF_TRANS_RECSIZE:       int64 := 24;
pub con PDF_TRANS_INITIAL_CAP:   int64 := 8;

// Viewer preferences (offsets 3696..3711, within 4096-byte doc block)
// Zeroed by PdfNew — all prefs default to off.
pub con PDF_DOC_VIEWFLAGS:        int64 := 3696;  // int64 flag bitmask
pub con PDF_DOC_VIEWOPENPAGE:     int64 := 3704;  // int64 open-action page (used only when PDF_VIEW_OPEN_ACTION set)

// Viewer preference flag bits (combined and passed to PdfSetViewerFlags)
pub con PDF_VIEW_HIDE_TOOLBAR:    int64 := 1;     // /ViewerPreferences /HideToolbar true
pub con PDF_VIEW_HIDE_MENUBAR:    int64 := 2;     // /ViewerPreferences /HideMenubar true
pub con PDF_VIEW_HIDE_WINDOWUI:   int64 := 4;     // /ViewerPreferences /HideWindowUI true
pub con PDF_VIEW_FIT_WINDOW:      int64 := 8;     // /ViewerPreferences /FitWindow true
pub con PDF_VIEW_CENTER_WINDOW:   int64 := 16;    // /ViewerPreferences /CenterWindow true
pub con PDF_VIEW_DISPLAY_DOCTITLE: int64 := 32;   // /ViewerPreferences /DisplayDocTitle true
pub con PDF_VIEW_FULLSCREEN:      int64 := 64;    // /PageMode /FullScreen
pub con PDF_VIEW_USE_OUTLINES:    int64 := 128;   // /PageMode /UseOutlines
pub con PDF_VIEW_SINGLE_PAGE:     int64 := 256;   // /PageLayout /SinglePage
pub con PDF_VIEW_TWO_COLUMN_LEFT: int64 := 512;   // /PageLayout /TwoColumnLeft
pub con PDF_VIEW_OPEN_ACTION:     int64 := 1024;  // emit /OpenAction to PDF_DOC_VIEWOPENPAGE

// Named destinations (offsets 3712..3735, within 4096-byte doc block)
pub con PDF_DOC_NAMEDESTCOUNT:    int64 := 3712;  // int64 entry count
pub con PDF_DOC_NAMEDESTCAP:      int64 := 3720;  // int64 capacity
pub con PDF_DOC_NAMEDESTBUF:      int64 := 3728;  // int64* record buffer

// Named destination record layout (24 bytes each)
pub con PDF_NAMEDEST_NAMEBUF:     int64 := 0;    // int64* name string (mmap'd, NUL-term)
pub con PDF_NAMEDEST_NAMELEN:     int64 := 8;    // int64 name allocation length
pub con PDF_NAMEDEST_PAGEIDX:     int64 := 16;   // int64 destination page (0-based)
pub con PDF_NAMEDEST_RECSIZE:     int64 := 24;
pub con PDF_NAMEDEST_INITIAL_CAP: int64 := 8;

// Embedded file attachments (offsets 3736..3759, within 4096-byte doc block)
pub con PDF_DOC_ATTACHCOUNT:      int64 := 3736;  // int64 attachment count
pub con PDF_DOC_ATTACHCAP:        int64 := 3744;  // int64 capacity
pub con PDF_DOC_ATTACHBUF:        int64 := 3752;  // int64* record buffer

// Attachment record layout (32 bytes each)
pub con PDF_ATTACH_NAMEBUF:       int64 := 0;    // int64* filename string (mmap'd, NUL-term)
pub con PDF_ATTACH_NAMELEN:       int64 := 8;    // int64 filename allocation length
pub con PDF_ATTACH_DATABUF:       int64 := 16;   // int64* file content bytes (mmap'd copy)
pub con PDF_ATTACH_DATALEN:       int64 := 24;   // int64 file content length
pub con PDF_ATTACH_RECSIZE:       int64 := 32;
pub con PDF_ATTACH_INITIAL_CAP:   int64 := 4;

// Optional content groups / layers (offsets 3760..3783, within 4096-byte doc block)
pub con PDF_DOC_LAYERCOUNT:       int64 := 3760;  // int64 layer count
pub con PDF_DOC_LAYERCAP:         int64 := 3768;  // int64 capacity
pub con PDF_DOC_LAYERBUF:         int64 := 3776;  // int64* record buffer

// WP-PDF-20: per-page rotation (0 / 90 / 180 / 270 degrees)
pub con PDF_DOC_PAGEROTATIONS:    int64 := 3784;  // int64* int64[pageCap], default 0

// WP-PDF-23: Form XObjects
pub con PDF_DOC_XOBJCOUNT:        int64 := 3792;  // int64 count
pub con PDF_DOC_XOBJCAP:          int64 := 3800;  // int64 capacity
pub con PDF_DOC_XOBJBUF:          int64 := 3808;  // int64* record buffer
pub con PDF_DOC_PAGEXOBJMASKS:    int64 := 3816;  // int64* per-page xobj bitmask

// Form XObject record layout (80 bytes each)
pub con PDF_XOBJ_OBJID:           int64 := 0;
pub con PDF_XOBJ_W100:            int64 := 8;
pub con PDF_XOBJ_H100:            int64 := 16;
pub con PDF_XOBJ_CONTENTBUF:      int64 := 24;
pub con PDF_XOBJ_CONTENTLEN:      int64 := 32;
pub con PDF_XOBJ_CONTENTCAP:      int64 := 40;
pub con PDF_XOBJ_FONTMASK:        int64 := 48;
pub con PDF_XOBJ_CURFONTIDX:      int64 := 56;
pub con PDF_XOBJ_CURFONTSIZE100:  int64 := 64;
pub con PDF_XOBJ_CURTEXTCOLOR:    int64 := 72;
pub con PDF_XOBJ_RECSIZE:         int64 := 80;
pub con PDF_XOBJ_INITIAL_CAP:     int64 := 8;


// Layer record layout (24 bytes each)
pub con PDF_LAYER_NAMEBUF:        int64 := 0;    // int64* name string (mmap'd, NUL-term)
pub con PDF_LAYER_NAMELEN:        int64 := 8;    // int64 name allocation length
pub con PDF_LAYER_VISIBLE:        int64 := 16;   // int64 default visibility (1=on, 0=off)
pub con PDF_LAYER_RECSIZE:        int64 := 24;
pub con PDF_LAYER_INITIAL_CAP:    int64 := 8;

// Page transition style constants (written as /S /Name in /Trans dict)
pub con PDF_TRANS_DISSOLVE:      int64 := 1;
pub con PDF_TRANS_WIPE:          int64 := 2;
pub con PDF_TRANS_PUSH:          int64 := 3;
pub con PDF_TRANS_SPLIT:         int64 := 4;
pub con PDF_TRANS_COVER:         int64 := 5;
pub con PDF_TRANS_UNCOVER:       int64 := 6;
pub con PDF_TRANS_FADE:          int64 := 7;
pub con PDF_TRANS_GLITTER:       int64 := 8;
pub con PDF_TRANS_BOX:           int64 := 9;
pub con PDF_TRANS_FLY:           int64 := 10;

pub con PDF_INITIAL_PAGE_CAP: int64 := 64;
pub con PDF_OUT_BUF_SIZE:     int64 := 4194304;

// mmap flags: PROT_READ|PROT_WRITE=3, MAP_PRIVATE|MAP_ANONYMOUS=34
con MMAP_PROT: int64 := 3;
con MMAP_FLAGS: int64 := 34;

// ============================================================================
// Internal helpers
// ============================================================================

fn arrGet(arr: int64, idx: int64): int64 {
  return peek64(arr + idx * 8);
}

fn arrSet(arr: int64, idx: int64, val: int64): void {
  poke64(arr + idx * 8, val);
}

fn zeroMem(ptr: int64, size: int64): void {
  var i: int64 := 0;
  while (i < size) {
    poke8(ptr + i, 0);
    i := i + 1;
  }
}

fn mmapAlloc(size: int64): int64 {
  return mmap(0, size, MMAP_PROT, MMAP_FLAGS, -1, 0);
}

// ============================================================================
// PdfNew — create a new empty document
// Returns: doc handle (int64 pointer), or 0 on failure
// ============================================================================

pub fn PdfNew(): int64 {
  var doc: int64 := mmapAlloc(PDF_DOC_SIZE);
  if (doc == 0) { return 0; }
  zeroMem(doc, PDF_DOC_SIZE);

  var pageCap: int64 := PDF_INITIAL_PAGE_CAP;
  var arrSize: int64 := pageCap * 8;

  poke64(doc + PDF_DOC_PAGECOUNT,   0);
  poke64(doc + PDF_DOC_PAGECAP,     pageCap);
  poke64(doc + PDF_DOC_NEXTID,      3);
  poke64(doc + PDF_DOC_COMPRESSION, 0);

  var pageIds:        int64 := mmapAlloc(arrSize);
  var contentIds:     int64 := mmapAlloc(arrSize);
  var widths100:      int64 := mmapAlloc(arrSize);
  var heights100:     int64 := mmapAlloc(arrSize);
  var contentBufs:    int64 := mmapAlloc(arrSize);
  var contentLens:    int64 := mmapAlloc(arrSize);
  var contentCaps:    int64 := mmapAlloc(arrSize);
  var pageRotations:  int64 := mmapAlloc(arrSize);  // WP-PDF-20
  var pageXobjMasks:  int64 := mmapAlloc(arrSize);  // WP-PDF-23

  if (pageIds == 0 || contentIds == 0 || widths100 == 0 || heights100 == 0 ||
      contentBufs == 0 || contentLens == 0 || contentCaps == 0 ||
      pageRotations == 0 || pageXobjMasks == 0) {
    if (pageIds != 0)       { munmap(pageIds,       arrSize); }
    if (contentIds != 0)    { munmap(contentIds,    arrSize); }
    if (widths100 != 0)     { munmap(widths100,     arrSize); }
    if (heights100 != 0)    { munmap(heights100,    arrSize); }
    if (contentBufs != 0)   { munmap(contentBufs,   arrSize); }
    if (contentLens != 0)   { munmap(contentLens,   arrSize); }
    if (contentCaps != 0)   { munmap(contentCaps,   arrSize); }
    if (pageRotations != 0) { munmap(pageRotations, arrSize); }
    if (pageXobjMasks != 0) { munmap(pageXobjMasks, arrSize); }
    munmap(doc, PDF_DOC_SIZE);
    return 0;
  }

  zeroMem(pageIds,        arrSize);
  zeroMem(contentIds,     arrSize);
  zeroMem(widths100,      arrSize);
  zeroMem(heights100,     arrSize);
  zeroMem(contentBufs,    arrSize);
  zeroMem(contentLens,    arrSize);
  zeroMem(contentCaps,    arrSize);
  zeroMem(pageRotations,  arrSize);
  zeroMem(pageXobjMasks,  arrSize);

  poke64(doc + PDF_DOC_PAGEIDS,        pageIds);
  poke64(doc + PDF_DOC_CONTENTIDS,     contentIds);
  poke64(doc + PDF_DOC_WIDTHS100,      widths100);
  poke64(doc + PDF_DOC_HEIGHTS100,     heights100);
  poke64(doc + PDF_DOC_CONTENTBUFS,    contentBufs);
  poke64(doc + PDF_DOC_CONTENTLENS,    contentLens);
  poke64(doc + PDF_DOC_CONTENTCAPS,    contentCaps);
  poke64(doc + PDF_DOC_PAGEROTATIONS,  pageRotations);
  poke64(doc + PDF_DOC_PAGEXOBJMASKS,  pageXobjMasks);

  // Form XObject buffer (WP-PDF-23)
  var xobjBuf: int64 := mmapAlloc(PDF_XOBJ_INITIAL_CAP * PDF_XOBJ_RECSIZE);
  if (xobjBuf != 0) { zeroMem(xobjBuf, PDF_XOBJ_INITIAL_CAP * PDF_XOBJ_RECSIZE); }
  poke64(doc + PDF_DOC_XOBJCOUNT,  0);
  poke64(doc + PDF_DOC_XOBJCAP,    PDF_XOBJ_INITIAL_CAP);
  poke64(doc + PDF_DOC_XOBJBUF,    xobjBuf);

  // Image arrays
  var imgCap:   int64 := PDF_INITIAL_IMAGE_CAP;
  var imgArrSz: int64 := imgCap * 8;

  var imageIds:      int64 := mmapAlloc(imgArrSz);
  var imageWidths:   int64 := mmapAlloc(imgArrSz);
  var imageHeights:  int64 := mmapAlloc(imgArrSz);
  var imageChannels: int64 := mmapAlloc(imgArrSz);
  var imageDataBufs: int64 := mmapAlloc(imgArrSz);
  var imageDataLens: int64 := mmapAlloc(imgArrSz);
  var pageImgMasks:  int64 := mmapAlloc(pageCap * 8);

  if (imageIds == 0 || imageWidths == 0 || imageHeights == 0 || imageChannels == 0 ||
      imageDataBufs == 0 || imageDataLens == 0 || pageImgMasks == 0) {
    if (imageIds != 0)      { munmap(imageIds,      imgArrSz); }
    if (imageWidths != 0)   { munmap(imageWidths,   imgArrSz); }
    if (imageHeights != 0)  { munmap(imageHeights,  imgArrSz); }
    if (imageChannels != 0) { munmap(imageChannels, imgArrSz); }
    if (imageDataBufs != 0) { munmap(imageDataBufs, imgArrSz); }
    if (imageDataLens != 0) { munmap(imageDataLens, imgArrSz); }
    if (pageImgMasks != 0)  { munmap(pageImgMasks,  pageCap * 8); }
    munmap(pageIds,     arrSize);
    munmap(contentIds,  arrSize);
    munmap(widths100,   arrSize);
    munmap(heights100,  arrSize);
    munmap(contentBufs, arrSize);
    munmap(contentLens, arrSize);
    munmap(contentCaps, arrSize);
    munmap(doc, PDF_DOC_SIZE);
    return 0;
  }

  zeroMem(imageIds,      imgArrSz);
  zeroMem(imageWidths,   imgArrSz);
  zeroMem(imageHeights,  imgArrSz);
  zeroMem(imageChannels, imgArrSz);
  zeroMem(imageDataBufs, imgArrSz);
  zeroMem(imageDataLens, imgArrSz);
  zeroMem(pageImgMasks,  pageCap * 8);

  poke64(doc + PDF_DOC_IMAGECOUNT,     0);
  poke64(doc + PDF_DOC_IMAGECAP,       imgCap);
  poke64(doc + PDF_DOC_IMAGEIDS,       imageIds);
  poke64(doc + PDF_DOC_IMAGEWIDTHS,    imageWidths);
  poke64(doc + PDF_DOC_IMAGEHEIGHTS,   imageHeights);
  poke64(doc + PDF_DOC_IMAGECHANNELS,  imageChannels);
  poke64(doc + PDF_DOC_IMAGEDATABUFS,  imageDataBufs);
  poke64(doc + PDF_DOC_IMAGEDATALENS,  imageDataLens);
  poke64(doc + PDF_DOC_PAGEIMAGEMASKS, pageImgMasks);

  // Annotation buffer
  var annotBuf: int64 := mmapAlloc(PDF_ANNOT_INITIAL_CAP * PDF_ANNOT_RECSIZE);
  if (annotBuf == 0) {
    munmap(imageIds,      imgArrSz);
    munmap(imageWidths,   imgArrSz);
    munmap(imageHeights,  imgArrSz);
    munmap(imageChannels, imgArrSz);
    munmap(imageDataBufs, imgArrSz);
    munmap(imageDataLens, imgArrSz);
    munmap(pageImgMasks,  pageCap * 8);
    munmap(pageIds,     arrSize);
    munmap(contentIds,  arrSize);
    munmap(widths100,   arrSize);
    munmap(heights100,  arrSize);
    munmap(contentBufs, arrSize);
    munmap(contentLens, arrSize);
    munmap(contentCaps, arrSize);
    munmap(doc, PDF_DOC_SIZE);
    return 0;
  }
  zeroMem(annotBuf, PDF_ANNOT_INITIAL_CAP * PDF_ANNOT_RECSIZE);
  poke64(doc + PDF_DOC_ANNOTCOUNT, 0);
  poke64(doc + PDF_DOC_ANNOTCAP,   PDF_ANNOT_INITIAL_CAP);
  poke64(doc + PDF_DOC_ANNOTBUF,   annotBuf);

  // Outline buffer
  var outlineBuf: int64 := mmapAlloc(PDF_OUTLINE_INITIAL_CAP * PDF_OUTLINE_RECSIZE);
  if (outlineBuf == 0) {
    munmap(annotBuf,     PDF_ANNOT_INITIAL_CAP * PDF_ANNOT_RECSIZE);
    munmap(imageIds,      imgArrSz);
    munmap(imageWidths,   imgArrSz);
    munmap(imageHeights,  imgArrSz);
    munmap(imageChannels, imgArrSz);
    munmap(imageDataBufs, imgArrSz);
    munmap(imageDataLens, imgArrSz);
    munmap(pageImgMasks,  pageCap * 8);
    munmap(pageIds,     arrSize);
    munmap(contentIds,  arrSize);
    munmap(widths100,   arrSize);
    munmap(heights100,  arrSize);
    munmap(contentBufs, arrSize);
    munmap(contentLens, arrSize);
    munmap(contentCaps, arrSize);
    munmap(doc, PDF_DOC_SIZE);
    return 0;
  }
  zeroMem(outlineBuf, PDF_OUTLINE_INITIAL_CAP * PDF_OUTLINE_RECSIZE);
  poke64(doc + PDF_DOC_OUTLINECOUNT, 0);
  poke64(doc + PDF_DOC_OUTLINECAP,   PDF_OUTLINE_INITIAL_CAP);
  poke64(doc + PDF_DOC_OUTLINEBUF,   outlineBuf);

  // Page label buffer
  var labelBuf: int64 := mmapAlloc(PDF_LABEL_INITIAL_CAP * PDF_LABEL_RECSIZE);
  if (labelBuf == 0) {
    munmap(outlineBuf,   PDF_OUTLINE_INITIAL_CAP * PDF_OUTLINE_RECSIZE);
    munmap(annotBuf,     PDF_ANNOT_INITIAL_CAP * PDF_ANNOT_RECSIZE);
    munmap(imageIds,      imgArrSz);
    munmap(imageWidths,   imgArrSz);
    munmap(imageHeights,  imgArrSz);
    munmap(imageChannels, imgArrSz);
    munmap(imageDataBufs, imgArrSz);
    munmap(imageDataLens, imgArrSz);
    munmap(pageImgMasks,  pageCap * 8);
    munmap(pageIds,     arrSize);
    munmap(contentIds,  arrSize);
    munmap(widths100,   arrSize);
    munmap(heights100,  arrSize);
    munmap(contentBufs, arrSize);
    munmap(contentLens, arrSize);
    munmap(contentCaps, arrSize);
    munmap(doc, PDF_DOC_SIZE);
    return 0;
  }
  zeroMem(labelBuf, PDF_LABEL_INITIAL_CAP * PDF_LABEL_RECSIZE);
  poke64(doc + PDF_DOC_LABELCOUNT, 0);
  poke64(doc + PDF_DOC_LABELCAP,   PDF_LABEL_INITIAL_CAP);
  poke64(doc + PDF_DOC_LABELBUF,   labelBuf);

  // Transition buffer
  var transBuf: int64 := mmapAlloc(PDF_TRANS_INITIAL_CAP * PDF_TRANS_RECSIZE);
  if (transBuf == 0) {
    munmap(labelBuf,   PDF_LABEL_INITIAL_CAP * PDF_LABEL_RECSIZE);
    munmap(outlineBuf, PDF_OUTLINE_INITIAL_CAP * PDF_OUTLINE_RECSIZE);
    munmap(annotBuf,   PDF_ANNOT_INITIAL_CAP * PDF_ANNOT_RECSIZE);
    munmap(imageIds,      imgArrSz);
    munmap(imageWidths,   imgArrSz);
    munmap(imageHeights,  imgArrSz);
    munmap(imageChannels, imgArrSz);
    munmap(imageDataBufs, imgArrSz);
    munmap(imageDataLens, imgArrSz);
    munmap(pageImgMasks,  pageCap * 8);
    munmap(pageIds,     arrSize);
    munmap(contentIds,  arrSize);
    munmap(widths100,   arrSize);
    munmap(heights100,  arrSize);
    munmap(contentBufs, arrSize);
    munmap(contentLens, arrSize);
    munmap(contentCaps, arrSize);
    munmap(doc, PDF_DOC_SIZE);
    return 0;
  }
  zeroMem(transBuf, PDF_TRANS_INITIAL_CAP * PDF_TRANS_RECSIZE);
  poke64(doc + PDF_DOC_TRANSCOUNT, 0);
  poke64(doc + PDF_DOC_TRANSCAP,   PDF_TRANS_INITIAL_CAP);
  poke64(doc + PDF_DOC_TRANSBUF,   transBuf);

  // Named destination buffer
  var namedestBuf: int64 := mmapAlloc(PDF_NAMEDEST_INITIAL_CAP * PDF_NAMEDEST_RECSIZE);
  if (namedestBuf == 0) {
    munmap(transBuf,   PDF_TRANS_INITIAL_CAP * PDF_TRANS_RECSIZE);
    munmap(labelBuf,   PDF_LABEL_INITIAL_CAP * PDF_LABEL_RECSIZE);
    munmap(outlineBuf, PDF_OUTLINE_INITIAL_CAP * PDF_OUTLINE_RECSIZE);
    munmap(annotBuf,   PDF_ANNOT_INITIAL_CAP * PDF_ANNOT_RECSIZE);
    munmap(imageIds,      imgArrSz);
    munmap(imageWidths,   imgArrSz);
    munmap(imageHeights,  imgArrSz);
    munmap(imageChannels, imgArrSz);
    munmap(imageDataBufs, imgArrSz);
    munmap(imageDataLens, imgArrSz);
    munmap(pageImgMasks,  pageCap * 8);
    munmap(pageIds,     arrSize);
    munmap(contentIds,  arrSize);
    munmap(widths100,   arrSize);
    munmap(heights100,  arrSize);
    munmap(contentBufs, arrSize);
    munmap(contentLens, arrSize);
    munmap(contentCaps, arrSize);
    munmap(doc, PDF_DOC_SIZE);
    return 0;
  }
  zeroMem(namedestBuf, PDF_NAMEDEST_INITIAL_CAP * PDF_NAMEDEST_RECSIZE);
  poke64(doc + PDF_DOC_NAMEDESTCOUNT, 0);
  poke64(doc + PDF_DOC_NAMEDESTCAP,   PDF_NAMEDEST_INITIAL_CAP);
  poke64(doc + PDF_DOC_NAMEDESTBUF,   namedestBuf);

  // Attachment buffer
  var attachBuf: int64 := mmapAlloc(PDF_ATTACH_INITIAL_CAP * PDF_ATTACH_RECSIZE);
  if (attachBuf == 0) {
    munmap(namedestBuf, PDF_NAMEDEST_INITIAL_CAP * PDF_NAMEDEST_RECSIZE);
    munmap(transBuf,   PDF_TRANS_INITIAL_CAP * PDF_TRANS_RECSIZE);
    munmap(labelBuf,   PDF_LABEL_INITIAL_CAP * PDF_LABEL_RECSIZE);
    munmap(outlineBuf, PDF_OUTLINE_INITIAL_CAP * PDF_OUTLINE_RECSIZE);
    munmap(annotBuf,   PDF_ANNOT_INITIAL_CAP * PDF_ANNOT_RECSIZE);
    munmap(imageIds,      imgArrSz);
    munmap(imageWidths,   imgArrSz);
    munmap(imageHeights,  imgArrSz);
    munmap(imageChannels, imgArrSz);
    munmap(imageDataBufs, imgArrSz);
    munmap(imageDataLens, imgArrSz);
    munmap(pageImgMasks,  pageCap * 8);
    munmap(pageIds,     arrSize);
    munmap(contentIds,  arrSize);
    munmap(widths100,   arrSize);
    munmap(heights100,  arrSize);
    munmap(contentBufs, arrSize);
    munmap(contentLens, arrSize);
    munmap(contentCaps, arrSize);
    munmap(doc, PDF_DOC_SIZE);
    return 0;
  }
  zeroMem(attachBuf, PDF_ATTACH_INITIAL_CAP * PDF_ATTACH_RECSIZE);
  poke64(doc + PDF_DOC_ATTACHCOUNT, 0);
  poke64(doc + PDF_DOC_ATTACHCAP,   PDF_ATTACH_INITIAL_CAP);
  poke64(doc + PDF_DOC_ATTACHBUF,   attachBuf);

  // Layer buffer
  var layerBuf: int64 := mmapAlloc(PDF_LAYER_INITIAL_CAP * PDF_LAYER_RECSIZE);
  if (layerBuf == 0) {
    munmap(attachBuf,  PDF_ATTACH_INITIAL_CAP * PDF_ATTACH_RECSIZE);
    munmap(namedestBuf, PDF_NAMEDEST_INITIAL_CAP * PDF_NAMEDEST_RECSIZE);
    munmap(transBuf,   PDF_TRANS_INITIAL_CAP * PDF_TRANS_RECSIZE);
    munmap(labelBuf,   PDF_LABEL_INITIAL_CAP * PDF_LABEL_RECSIZE);
    munmap(outlineBuf, PDF_OUTLINE_INITIAL_CAP * PDF_OUTLINE_RECSIZE);
    munmap(annotBuf,   PDF_ANNOT_INITIAL_CAP * PDF_ANNOT_RECSIZE);
    munmap(imageIds,      imgArrSz);
    munmap(imageWidths,   imgArrSz);
    munmap(imageHeights,  imgArrSz);
    munmap(imageChannels, imgArrSz);
    munmap(imageDataBufs, imgArrSz);
    munmap(imageDataLens, imgArrSz);
    munmap(pageImgMasks,  pageCap * 8);
    munmap(pageIds,     arrSize);
    munmap(contentIds,  arrSize);
    munmap(widths100,   arrSize);
    munmap(heights100,  arrSize);
    munmap(contentBufs, arrSize);
    munmap(contentLens, arrSize);
    munmap(contentCaps, arrSize);
    munmap(doc, PDF_DOC_SIZE);
    return 0;
  }
  zeroMem(layerBuf, PDF_LAYER_INITIAL_CAP * PDF_LAYER_RECSIZE);
  poke64(doc + PDF_DOC_LAYERCOUNT, 0);
  poke64(doc + PDF_DOC_LAYERCAP,   PDF_LAYER_INITIAL_CAP);
  poke64(doc + PDF_DOC_LAYERBUF,   layerBuf);

  return doc;
}

// ============================================================================
// PdfFree — release all document memory
// ============================================================================

pub fn PdfFree(doc: int64): void {
  if (doc == 0) { return; }

  var pageCap:     int64 := peek64(doc + PDF_DOC_PAGECAP);
  var pageCount:   int64 := peek64(doc + PDF_DOC_PAGECOUNT);
  var contentBufs: int64 := peek64(doc + PDF_DOC_CONTENTBUFS);
  var contentCaps: int64 := peek64(doc + PDF_DOC_CONTENTCAPS);
  var arrSize:     int64 := pageCap * 8;

  var i: int64 := 0;
  while (i < pageCount) {
    var cbuf: int64 := arrGet(contentBufs, i);
    var ccap: int64 := arrGet(contentCaps, i);
    if (cbuf != 0 && ccap > 0) {
      munmap(cbuf, ccap);
    }
    i := i + 1;
  }

  munmap(peek64(doc + PDF_DOC_PAGEIDS),        arrSize);
  munmap(peek64(doc + PDF_DOC_CONTENTIDS),     arrSize);
  munmap(peek64(doc + PDF_DOC_WIDTHS100),      arrSize);
  munmap(peek64(doc + PDF_DOC_HEIGHTS100),     arrSize);
  munmap(peek64(doc + PDF_DOC_CONTENTBUFS),    arrSize);
  munmap(peek64(doc + PDF_DOC_CONTENTLENS),    arrSize);
  munmap(peek64(doc + PDF_DOC_CONTENTCAPS),    arrSize);
  munmap(peek64(doc + PDF_DOC_PAGEROTATIONS),  arrSize);
  munmap(peek64(doc + PDF_DOC_PAGEXOBJMASKS),  arrSize);

  // Free Form XObject records and their content buffers (WP-PDF-23)
  var xobjCount2: int64 := peek64(doc + PDF_DOC_XOBJCOUNT);
  var xobjBuf2:   int64 := peek64(doc + PDF_DOC_XOBJBUF);
  var xobjCap2:   int64 := peek64(doc + PDF_DOC_XOBJCAP);
  if (xobjBuf2 != 0) {
    var xi2: int64 := 0;
    while (xi2 < xobjCount2) {
      var xrec2: int64 := xobjBuf2 + xi2 * PDF_XOBJ_RECSIZE;
      var xcbuf: int64 := peek64(xrec2 + PDF_XOBJ_CONTENTBUF);
      var xccap: int64 := peek64(xrec2 + PDF_XOBJ_CONTENTCAP);
      if (xcbuf != 0 && xccap > 0) { munmap(xcbuf, xccap); }
      xi2 := xi2 + 1;
    }
    munmap(xobjBuf2, xobjCap2 * PDF_XOBJ_RECSIZE);
  }

  // Free compressed image data, then image metadata arrays
  var imgCap:   int64 := peek64(doc + PDF_DOC_IMAGECAP);
  var imgArrSz: int64 := imgCap * 8;
  var imgCount: int64 := peek64(doc + PDF_DOC_IMAGECOUNT);
  var imgDBufs: int64 := peek64(doc + PDF_DOC_IMAGEDATABUFS);
  var imgDLens: int64 := peek64(doc + PDF_DOC_IMAGEDATALENS);

  if (imgDBufs != 0) {
    var ii: int64 := 0;
    while (ii < imgCount) {
      var ibuf: int64 := arrGet(imgDBufs, ii);
      var ilen: int64 := arrGet(imgDLens, ii);
      if (ibuf != 0 && ilen > 0) { munmap(ibuf, ilen); }
      ii := ii + 1;
    }
  }

  var imgIdsPtr: int64 := peek64(doc + PDF_DOC_IMAGEIDS);
  var imgWPtr:   int64 := peek64(doc + PDF_DOC_IMAGEWIDTHS);
  var imgHPtr:   int64 := peek64(doc + PDF_DOC_IMAGEHEIGHTS);
  var imgCPtr:   int64 := peek64(doc + PDF_DOC_IMAGECHANNELS);
  var pgImgPtr:  int64 := peek64(doc + PDF_DOC_PAGEIMAGEMASKS);

  if (imgIdsPtr != 0) { munmap(imgIdsPtr, imgArrSz); }
  if (imgWPtr   != 0) { munmap(imgWPtr,   imgArrSz); }
  if (imgHPtr   != 0) { munmap(imgHPtr,   imgArrSz); }
  if (imgCPtr   != 0) { munmap(imgCPtr,   imgArrSz); }
  if (imgDBufs  != 0) { munmap(imgDBufs,  imgArrSz); }
  if (imgDLens  != 0) { munmap(imgDLens,  imgArrSz); }
  if (pgImgPtr  != 0) { munmap(pgImgPtr,  pageCap * 8); }

  // Free annotation string data and buffer
  var annotCount2: int64 := peek64(doc + PDF_DOC_ANNOTCOUNT);
  var annotCap2:   int64 := peek64(doc + PDF_DOC_ANNOTCAP);
  var annotBuf2:   int64 := peek64(doc + PDF_DOC_ANNOTBUF);
  if (annotBuf2 != 0) {
    var ai2: int64 := 0;
    while (ai2 < annotCount2) {
      var arec2: int64 := annotBuf2 + ai2 * PDF_ANNOT_RECSIZE;
      var d1:    int64 := peek64(arec2 + PDF_ANNOT_DATA1);
      var d1l:   int64 := peek64(arec2 + PDF_ANNOT_DATA1LEN);
      var d2:    int64 := peek64(arec2 + PDF_ANNOT_DATA2);
      var d2l:   int64 := peek64(arec2 + PDF_ANNOT_DATA2LEN);
      if (d1 != 0 && d1l > 0) { munmap(d1, d1l); }
      if (d2 != 0 && d2l > 0) { munmap(d2, d2l); }
      ai2 := ai2 + 1;
    }
    munmap(annotBuf2, annotCap2 * PDF_ANNOT_RECSIZE);
  }

  // Free outline title strings and buffer
  var outlineCount3: int64 := peek64(doc + PDF_DOC_OUTLINECOUNT);
  var outlineCap3:   int64 := peek64(doc + PDF_DOC_OUTLINECAP);
  var outlineBuf3:   int64 := peek64(doc + PDF_DOC_OUTLINEBUF);
  if (outlineBuf3 != 0) {
    var oi3: int64 := 0;
    while (oi3 < outlineCount3) {
      var orec3:   int64 := outlineBuf3 + oi3 * PDF_OUTLINE_RECSIZE;
      var titBuf3: int64 := peek64(orec3 + PDF_OUTLINE_TITLEBUF);
      var titLen3: int64 := peek64(orec3 + PDF_OUTLINE_TITLELEN);
      if (titBuf3 != 0 && titLen3 > 0) { munmap(titBuf3, titLen3); }
      oi3 := oi3 + 1;
    }
    munmap(outlineBuf3, outlineCap3 * PDF_OUTLINE_RECSIZE);
  }

  // Free page label prefix strings and buffer
  var labelCount3: int64 := peek64(doc + PDF_DOC_LABELCOUNT);
  var labelCap3:   int64 := peek64(doc + PDF_DOC_LABELCAP);
  var labelBuf3:   int64 := peek64(doc + PDF_DOC_LABELBUF);
  if (labelBuf3 != 0) {
    var li3: int64 := 0;
    while (li3 < labelCount3) {
      var lrec3:   int64 := labelBuf3 + li3 * PDF_LABEL_RECSIZE;
      var pfxBuf3: int64 := peek64(lrec3 + PDF_LABEL_PREFIXBUF);
      var pfxLen3: int64 := peek64(lrec3 + PDF_LABEL_PREFIXLEN);
      if (pfxBuf3 != 0 && pfxLen3 > 0) { munmap(pfxBuf3, pfxLen3); }
      li3 := li3 + 1;
    }
    munmap(labelBuf3, labelCap3 * PDF_LABEL_RECSIZE);
  }

  // Free transition buffer (no string data)
  var transCap3: int64 := peek64(doc + PDF_DOC_TRANSCAP);
  var transBuf3: int64 := peek64(doc + PDF_DOC_TRANSBUF);
  if (transBuf3 != 0) {
    munmap(transBuf3, transCap3 * PDF_TRANS_RECSIZE);
  }

  // Free named destination name strings and buffer
  var ndCount3: int64 := peek64(doc + PDF_DOC_NAMEDESTCOUNT);
  var ndCap3:   int64 := peek64(doc + PDF_DOC_NAMEDESTCAP);
  var ndBuf3:   int64 := peek64(doc + PDF_DOC_NAMEDESTBUF);
  if (ndBuf3 != 0) {
    var ndi3: int64 := 0;
    while (ndi3 < ndCount3) {
      var nrec3: int64 := ndBuf3 + ndi3 * PDF_NAMEDEST_RECSIZE;
      var nb3:   int64 := peek64(nrec3 + PDF_NAMEDEST_NAMEBUF);
      var nl3:   int64 := peek64(nrec3 + PDF_NAMEDEST_NAMELEN);
      if (nb3 != 0 && nl3 > 0) { munmap(nb3, nl3); }
      ndi3 := ndi3 + 1;
    }
    munmap(ndBuf3, ndCap3 * PDF_NAMEDEST_RECSIZE);
  }

  // Free attachment names, data, and record buffer
  var atCount4: int64 := peek64(doc + PDF_DOC_ATTACHCOUNT);
  var atCap4:   int64 := peek64(doc + PDF_DOC_ATTACHCAP);
  var atBuf4:   int64 := peek64(doc + PDF_DOC_ATTACHBUF);
  if (atBuf4 != 0) {
    var ai4: int64 := 0;
    while (ai4 < atCount4) {
      var arec4: int64 := atBuf4 + ai4 * PDF_ATTACH_RECSIZE;
      var nb4:   int64 := peek64(arec4 + PDF_ATTACH_NAMEBUF);
      var nl4:   int64 := peek64(arec4 + PDF_ATTACH_NAMELEN);
      var db4:   int64 := peek64(arec4 + PDF_ATTACH_DATABUF);
      var dl4:   int64 := peek64(arec4 + PDF_ATTACH_DATALEN);
      if (nb4 != 0 && nl4 > 0) { munmap(nb4, nl4); }
      if (db4 != 0 && dl4 > 0) { munmap(db4, dl4); }
      ai4 := ai4 + 1;
    }
    munmap(atBuf4, atCap4 * PDF_ATTACH_RECSIZE);
  }

  // Free layer name strings and buffer
  var lyrCount4: int64 := peek64(doc + PDF_DOC_LAYERCOUNT);
  var lyrCap4:   int64 := peek64(doc + PDF_DOC_LAYERCAP);
  var lyrBuf4:   int64 := peek64(doc + PDF_DOC_LAYERBUF);
  if (lyrBuf4 != 0) {
    var lyi4: int64 := 0;
    while (lyi4 < lyrCount4) {
      var lrec4: int64 := lyrBuf4 + lyi4 * PDF_LAYER_RECSIZE;
      var ln4:   int64 := peek64(lrec4 + PDF_LAYER_NAMEBUF);
      var ll4:   int64 := peek64(lrec4 + PDF_LAYER_NAMELEN);
      if (ln4 != 0 && ll4 > 0) { munmap(ln4, ll4); }
      lyi4 := lyi4 + 1;
    }
    munmap(lyrBuf4, lyrCap4 * PDF_LAYER_RECSIZE);
  }

  munmap(doc, PDF_DOC_SIZE);
}

// ============================================================================
// Outline tree helpers (WP-PDF-10)
// ============================================================================

fn _outlineCountChildren(buf: int64, count: int64, parent: int64): int64 {
  var n: int64 := 0;
  var j: int64 := 0;
  while (j < count) {
    if (peek64(buf + j * PDF_OUTLINE_RECSIZE + PDF_OUTLINE_PARENT) == parent) { n := n + 1; }
    j := j + 1;
  }
  return n;
}

fn _outlineFirstChild(buf: int64, count: int64, parent: int64): int64 {
  var j: int64 := 0;
  while (j < count) {
    if (peek64(buf + j * PDF_OUTLINE_RECSIZE + PDF_OUTLINE_PARENT) == parent) { return j; }
    j := j + 1;
  }
  return -1;
}

fn _outlineLastChild(buf: int64, count: int64, parent: int64): int64 {
  var last: int64 := -1;
  var j: int64 := 0;
  while (j < count) {
    if (peek64(buf + j * PDF_OUTLINE_RECSIZE + PDF_OUTLINE_PARENT) == parent) { last := j; }
    j := j + 1;
  }
  return last;
}

fn _outlineNextSibling(buf: int64, count: int64, i: int64): int64 {
  var pi: int64 := peek64(buf + i * PDF_OUTLINE_RECSIZE + PDF_OUTLINE_PARENT);
  var j: int64 := i + 1;
  while (j < count) {
    if (peek64(buf + j * PDF_OUTLINE_RECSIZE + PDF_OUTLINE_PARENT) == pi) { return j; }
    j := j + 1;
  }
  return -1;
}

fn _outlinePrevSibling(buf: int64, count: int64, i: int64): int64 {
  var pi: int64 := peek64(buf + i * PDF_OUTLINE_RECSIZE + PDF_OUTLINE_PARENT);
  var j: int64 := i - 1;
  while (j >= 0) {
    if (peek64(buf + j * PDF_OUTLINE_RECSIZE + PDF_OUTLINE_PARENT) == pi) { return j; }
    j := j - 1;
  }
  return -1;
}

// Write /Count, /First, /Last, /Next, /Prev for outline item oi. Returns new pos.
fn _pdfWriteOutlineLinks(out: int64, pos: int64, buf: int64, count: int64, oi: int64, rootId: int64): int64 {
  var nch: int64 := _outlineCountChildren(buf, count, oi);
  pos := pdfStr(out, pos, " /Count ");
  pos := pdfInt(out, pos, nch);
  if (nch > 0) {
    var fc: int64 := _outlineFirstChild(buf, count, oi);
    pos := pdfStr(out, pos, " /First ");
    pos := pdfRef(out, pos, rootId + 1 + fc);
    var lc: int64 := _outlineLastChild(buf, count, oi);
    pos := pdfStr(out, pos, " /Last ");
    pos := pdfRef(out, pos, rootId + 1 + lc);
  }
  var ns: int64 := _outlineNextSibling(buf, count, oi);
  if (ns >= 0) {
    pos := pdfStr(out, pos, " /Next ");
    pos := pdfRef(out, pos, rootId + 1 + ns);
  }
  var ps: int64 := _outlinePrevSibling(buf, count, oi);
  if (ps >= 0) {
    pos := pdfStr(out, pos, " /Prev ");
    pos := pdfRef(out, pos, rootId + 1 + ps);
  }
  return pos;
}

// Write the /Outlines root object. Returns new pos.
fn _pdfWriteOutlineRoot(out: int64, pos: int64, xrefs: int64, buf: int64, count: int64, rootId: int64): int64 {
  poke64(xrefs + rootId * 8, pos);
  pos := pdfObjHdr(out, pos, rootId);
  pos := pdfStr(out, pos, "<< /Type /Outlines /Count ");
  pos := pdfInt(out, pos, _outlineCountChildren(buf, count, -1));
  var fc: int64 := _outlineFirstChild(buf, count, -1);
  if (fc >= 0) {
    pos := pdfStr(out, pos, " /First ");
    pos := pdfRef(out, pos, rootId + 1 + fc);
    var lc: int64 := _outlineLastChild(buf, count, -1);
    pos := pdfStr(out, pos, " /Last ");
    pos := pdfRef(out, pos, rootId + 1 + lc);
  }
  pos := pdfStr(out, pos, " >>");
  pos := pdfObjFtr(out, pos);
  return pos;
}

// Write "/PageLabels << /Nums [...] >>" inline into the Catalog dict.
fn _pdfWritePageLabels(out: int64, pos: int64, buf: int64, count: int64): int64 {
  pos := pdfStr(out, pos, " /PageLabels << /Nums [");
  var li: int64 := 0;
  while (li < count) {
    var lrec: int64 := buf + li * PDF_LABEL_RECSIZE;
    if (li > 0) { poke8(out + pos, 32); pos := pos + 1; }
    pos := pdfInt(out, pos, peek64(lrec + PDF_LABEL_FIRSTPAGE));
    pos := pdfStr(out, pos, " <<");
    if (peek64(lrec + PDF_LABEL_STYLE) == PDF_LABEL_DECIMAL) { pos := pdfStr(out, pos, " /S /D"); }
    if (peek64(lrec + PDF_LABEL_STYLE) == PDF_LABEL_ROMAN_L) { pos := pdfStr(out, pos, " /S /r"); }
    if (peek64(lrec + PDF_LABEL_STYLE) == PDF_LABEL_ROMAN_U) { pos := pdfStr(out, pos, " /S /R"); }
    if (peek64(lrec + PDF_LABEL_STYLE) == PDF_LABEL_ALPHA_L) { pos := pdfStr(out, pos, " /S /a"); }
    if (peek64(lrec + PDF_LABEL_STYLE) == PDF_LABEL_ALPHA_U) { pos := pdfStr(out, pos, " /S /A"); }
    if (peek64(lrec + PDF_LABEL_STARTNUM) != 1) {
      pos := pdfStr(out, pos, " /St ");
      pos := pdfInt(out, pos, peek64(lrec + PDF_LABEL_STARTNUM));
    }
    if (peek64(lrec + PDF_LABEL_PREFIXBUF) != 0) {
      pos := pdfStr(out, pos, " /P ");
      pos := _pdfEscStr(out, pos, peek64(lrec + PDF_LABEL_PREFIXBUF));
    }
    pos := pdfStr(out, pos, " >>");
    li := li + 1;
  }
  pos := pdfStr(out, pos, "] >>");
  return pos;
}

// ============================================================================
// PdfSetCompression, PdfPageCount
// ============================================================================

pub fn PdfSetCompression(doc: int64, level: int64): void {
  if (doc == 0) { return; }
  poke64(doc + PDF_DOC_COMPRESSION, level);
}

pub fn PdfPageCount(doc: int64): int64 {
  if (doc == 0) { return 0; }
  return peek64(doc + PDF_DOC_PAGECOUNT);
}

// ============================================================================
// Content stream management (used by WP-PDF-03+)
// ============================================================================

// ============================================================================
// WP-PDF-23: Page/XObject routing helpers
// When pg >= 0: page arrays; when pg < 0: Form XObject record (handle=-(idx+1))
// These are pub so graphics.lyx can use them.
// ============================================================================

fn _xobjRec(doc: int64, handle: int64): int64 {
  var idx: int64 := 0 - handle - 1;
  return peek64(doc + PDF_DOC_XOBJBUF) + idx * PDF_XOBJ_RECSIZE;
}

pub fn pdfXBuf(doc: int64, pg: int64): int64 {
  if (pg < 0) { return peek64(_xobjRec(doc, pg) + PDF_XOBJ_CONTENTBUF); }
  return arrGet(peek64(doc + PDF_DOC_CONTENTBUFS), pg);
}

pub fn pdfXPos(doc: int64, pg: int64): int64 {
  if (pg < 0) { return peek64(_xobjRec(doc, pg) + PDF_XOBJ_CONTENTLEN); }
  return arrGet(peek64(doc + PDF_DOC_CONTENTLENS), pg);
}

pub fn pdfXSetPos(doc: int64, pg: int64, p: int64): void {
  if (pg < 0) { poke64(_xobjRec(doc, pg) + PDF_XOBJ_CONTENTLEN, p); return; }
  arrSet(peek64(doc + PDF_DOC_CONTENTLENS), pg, p);
}

pub fn pdfXFontIdx(doc: int64, pg: int64): int64 {
  if (pg < 0) { return peek64(_xobjRec(doc, pg) + PDF_XOBJ_CURFONTIDX); }
  return peek64(doc + PDF_DOC_CURFONTIDX + pg * 8);
}

pub fn pdfXSetFontIdx(doc: int64, pg: int64, idx: int64): void {
  if (pg < 0) { poke64(_xobjRec(doc, pg) + PDF_XOBJ_CURFONTIDX, idx); return; }
  poke64(doc + PDF_DOC_CURFONTIDX + pg * 8, idx);
}

pub fn pdfXFontSize100(doc: int64, pg: int64): int64 {
  if (pg < 0) { return peek64(_xobjRec(doc, pg) + PDF_XOBJ_CURFONTSIZE100); }
  return peek64(doc + PDF_DOC_CURFONTSIZE100 + pg * 8);
}

pub fn pdfXSetFontSize100(doc: int64, pg: int64, sz: int64): void {
  if (pg < 0) { poke64(_xobjRec(doc, pg) + PDF_XOBJ_CURFONTSIZE100, sz); return; }
  poke64(doc + PDF_DOC_CURFONTSIZE100 + pg * 8, sz);
}

pub fn pdfXTextColor(doc: int64, pg: int64): int64 {
  if (pg < 0) { return peek64(_xobjRec(doc, pg) + PDF_XOBJ_CURTEXTCOLOR); }
  return peek64(doc + PDF_DOC_CURTEXTCOLOR + pg * 8);
}

pub fn pdfXSetTextColor(doc: int64, pg: int64, color: int64): void {
  if (pg < 0) { poke64(_xobjRec(doc, pg) + PDF_XOBJ_CURTEXTCOLOR, color); return; }
  poke64(doc + PDF_DOC_CURTEXTCOLOR + pg * 8, color);
}

pub fn pdfXFontMask(doc: int64, pg: int64): int64 {
  if (pg < 0) { return peek64(_xobjRec(doc, pg) + PDF_XOBJ_FONTMASK); }
  return peek64(doc + PDF_DOC_PAGEFONTMASK + pg * 8);
}

pub fn pdfXSetFontMask(doc: int64, pg: int64, mask: int64): void {
  if (pg < 0) { poke64(_xobjRec(doc, pg) + PDF_XOBJ_FONTMASK, mask); return; }
  poke64(doc + PDF_DOC_PAGEFONTMASK + pg * 8, mask);
}

pub fn PdfContentEnsure(doc: int64, pageIdx: int64, needed: int64): int64 {
  // WP-PDF-23: route negative pageIdx to XObject content buffer
  if (pageIdx < 0) {
    var xrec: int64 := _xobjRec(doc, pageIdx);
    var buf: int64 := peek64(xrec + PDF_XOBJ_CONTENTBUF);
    var len: int64 := peek64(xrec + PDF_XOBJ_CONTENTLEN);
    var cap: int64 := peek64(xrec + PDF_XOBJ_CONTENTCAP);
    if (len + needed <= cap) { return 1; }
    var newCap: int64 := cap * 2;
    if (newCap < len + needed) { newCap := len + needed; }
    if (newCap < 4096) { newCap := 4096; }
    var newBuf: int64 := mmapAlloc(newCap);
    if (newBuf == 0) { return 0; }
    zeroMem(newBuf, newCap);
    var ci: int64 := 0;
    while (ci < len) { poke8(newBuf + ci, peek8(buf + ci)); ci := ci + 1; }
    if (buf != 0 && cap > 0) { munmap(buf, cap); }
    poke64(xrec + PDF_XOBJ_CONTENTBUF, newBuf);
    poke64(xrec + PDF_XOBJ_CONTENTCAP, newCap);
    return 1;
  }

  var contentBufs: int64 := peek64(doc + PDF_DOC_CONTENTBUFS);
  var contentLens: int64 := peek64(doc + PDF_DOC_CONTENTLENS);
  var contentCaps: int64 := peek64(doc + PDF_DOC_CONTENTCAPS);

  var buf: int64 := arrGet(contentBufs, pageIdx);
  var len: int64 := arrGet(contentLens, pageIdx);
  var cap: int64 := arrGet(contentCaps, pageIdx);

  if (len + needed <= cap) { return 1; }

  var newCap: int64 := cap * 2;
  if (newCap < len + needed) { newCap := len + needed; }
  if (newCap < 4096) { newCap := 4096; }

  var newBuf: int64 := mmapAlloc(newCap);
  if (newBuf == 0) { return 0; }
  zeroMem(newBuf, newCap);

  var i: int64 := 0;
  while (i < len) {
    poke8(newBuf + i, peek8(buf + i));
    i := i + 1;
  }

  if (buf != 0 && cap > 0) { munmap(buf, cap); }

  arrSet(contentBufs, pageIdx, newBuf);
  arrSet(contentCaps, pageIdx, newCap);
  return 1;
}

pub fn PdfContentAppendStr(doc: int64, pageIdx: int64, s: pchar): int64 {
  var slen: int64 := StrLen(s);
  if (slen == 0) { return 0; }
  if (PdfContentEnsure(doc, pageIdx, slen) == 0) { return 0; }
  var buf: int64 := pdfXBuf(doc, pageIdx);
  var pos: int64 := pdfXPos(doc, pageIdx);
  var i: int64 := 0;
  while (i < slen) { poke8(buf + pos + i, StrCharAt(s, i)); i := i + 1; }
  pdfXSetPos(doc, pageIdx, pos + slen);
  return slen;
}

pub fn PdfContentAppendBytes(doc: int64, pageIdx: int64, data: int64, len: int64): int64 {
  if (len == 0) { return 0; }
  if (PdfContentEnsure(doc, pageIdx, len) == 0) { return 0; }
  var buf: int64 := pdfXBuf(doc, pageIdx);
  var pos: int64 := pdfXPos(doc, pageIdx);
  var i: int64 := 0;
  while (i < len) { poke8(buf + pos + i, peek8(data + i)); i := i + 1; }
  pdfXSetPos(doc, pageIdx, pos + len);
  return len;
}

// Emit one /Info field: " /Key (escaped-value)" to the output buffer.
// src is the raw address of the NUL-terminated string in the doc block.
// Returns new pos; no-ops (returns pos unchanged) if the field is empty.
fn _pdfMetaField(out: int64, pos: int64, key: pchar, src: int64, maxLen: int64): int64 {
  if (peek8(src) == 0) { return pos; }
  pos := pdfStr(out, pos, key);
  poke8(out + pos, 40); pos := pos + 1;   // '('
  var i: int64 := 0;
  while (i < maxLen) {
    var c: int64 := peek8(src + i);
    if (c == 0) { break; }
    if (c == 40 || c == 41 || c == 92) { poke8(out + pos, 92); pos := pos + 1; }
    poke8(out + pos, c); pos := pos + 1;
    i := i + 1;
  }
  poke8(out + pos, 41); pos := pos + 1;   // ')'
  return pos;
}

// Write (escaped PDF literal string) from a NUL-terminated raw buffer.
fn _pdfEscStr(out: int64, pos: int64, src: int64): int64 {
  poke8(out + pos, 40); pos := pos + 1;
  var i: int64 := 0;
  while (1 == 1) {
    var c: int64 := peek8(src + i);
    if (c == 0) { break; }
    if (c == 40 || c == 41 || c == 92) { poke8(out + pos, 92); pos := pos + 1; }
    poke8(out + pos, c); pos := pos + 1;
    i := i + 1;
  }
  poke8(out + pos, 41); pos := pos + 1;
  return pos;
}

// Map transition type constant to PDF /S name string.
fn _pdfTransName(t: int64): pchar {
  if (t == PDF_TRANS_DISSOLVE) { return "Dissolve"; }
  if (t == PDF_TRANS_WIPE)     { return "Wipe"; }
  if (t == PDF_TRANS_PUSH)     { return "Push"; }
  if (t == PDF_TRANS_SPLIT)    { return "Split"; }
  if (t == PDF_TRANS_COVER)    { return "Cover"; }
  if (t == PDF_TRANS_UNCOVER)  { return "Uncover"; }
  if (t == PDF_TRANS_FADE)     { return "Fade"; }
  if (t == PDF_TRANS_GLITTER)  { return "Glitter"; }
  if (t == PDF_TRANS_BOX)      { return "Box"; }
  if (t == PDF_TRANS_FLY)      { return "Fly"; }
  return "Replace";
}

// Write " /Dests << /Names [...] >>" — the inner named-dest entry for the /Names dict.
fn _pdfWriteDestsTree(out: int64, pos: int64, buf: int64, count: int64, pageIds: int64): int64 {
  pos := pdfStr(out, pos, " /Dests << /Names [");
  var ndi: int64 := 0;
  while (ndi < count) {
    var nrec: int64 := buf + ndi * PDF_NAMEDEST_RECSIZE;
    if (ndi > 0) { poke8(out + pos, 32); pos := pos + 1; }
    pos := _pdfEscStr(out, pos, peek64(nrec + PDF_NAMEDEST_NAMEBUF));
    pos := pdfStr(out, pos, " [");
    pos := pdfRef(out, pos, arrGet(pageIds, peek64(nrec + PDF_NAMEDEST_PAGEIDX)));
    pos := pdfStr(out, pos, " /XYZ null null null]");
    ndi := ndi + 1;
  }
  pos := pdfStr(out, pos, "] >>");
  return pos;
}

// Write " /EmbeddedFiles << /Names [...] >>" — the inner attachment entry for the /Names dict.
fn _pdfWriteEmbedTree(out: int64, pos: int64, buf: int64, count: int64, baseId: int64): int64 {
  pos := pdfStr(out, pos, " /EmbeddedFiles << /Names [");
  var ai: int64 := 0;
  while (ai < count) {
    var arec: int64 := buf + ai * PDF_ATTACH_RECSIZE;
    if (ai > 0) { poke8(out + pos, 32); pos := pos + 1; }
    pos := _pdfEscStr(out, pos, peek64(arec + PDF_ATTACH_NAMEBUF));
    poke8(out + pos, 32); pos := pos + 1;
    pos := pdfRef(out, pos, baseId + ai * 2 + 1);
    ai := ai + 1;
  }
  pos := pdfStr(out, pos, "] >>");
  return pos;
}

// Write " /Properties << /Lyr0 id0 0 R ... >>" into the page /Resources dict.
fn _pdfWriteLayerProps(out: int64, pos: int64, count: int64, baseId: int64): int64 {
  pos := pdfStr(out, pos, " /Properties <<");
  var li: int64 := 0;
  while (li < count) {
    pos := pdfStr(out, pos, " /Lyr");
    pos := pdfInt(out, pos, li);
    poke8(out + pos, 32); pos := pos + 1;
    pos := pdfRef(out, pos, baseId + li);
    li := li + 1;
  }
  pos := pdfStr(out, pos, " >>");
  return pos;
}

// Write " /OCProperties << ... >>" into the Catalog dict.
fn _pdfWriteOCProperties(out: int64, pos: int64, buf: int64, count: int64, baseId: int64): int64 {
  pos := pdfStr(out, pos, " /OCProperties << /OCGs [");
  var li: int64 := 0;
  while (li < count) {
    if (li > 0) { poke8(out + pos, 32); pos := pos + 1; }
    pos := pdfRef(out, pos, baseId + li);
    li := li + 1;
  }
  pos := pdfStr(out, pos, "] /D << /BaseState /ON /OFF [");
  var li2: int64 := 0;
  while (li2 < count) {
    if (peek64(buf + li2 * PDF_LAYER_RECSIZE + PDF_LAYER_VISIBLE) == 0) {
      pos := pdfRef(out, pos, baseId + li2);
      poke8(out + pos, 32); pos := pos + 1;
    }
    li2 := li2 + 1;
  }
  pos := pdfStr(out, pos, "] >> >>");
  return pos;
}

// Return pointer to the transition record for pageIdx, or 0 if none.
fn _pdfTransForPage(buf: int64, count: int64, pageIdx: int64): int64 {
  var j: int64 := 0;
  while (j < count) {
    var rec: int64 := buf + j * PDF_TRANS_RECSIZE;
    if (peek64(rec + PDF_TRANS_PAGEIDX) == pageIdx) { return rec; }
    j := j + 1;
  }
  return 0;
}

// ============================================================================
// PdfSave — serialize document to a PDF file
// Returns: 0 on success, negative on error
// ============================================================================

pub fn PdfSave(doc: int64, path: pchar): int64 {
  if (doc == 0) { return -1; }

  var pageCount:   int64 := peek64(doc + PDF_DOC_PAGECOUNT);
  var nextId:      int64 := peek64(doc + PDF_DOC_NEXTID);
  var pageIds:     int64 := peek64(doc + PDF_DOC_PAGEIDS);
  var contentIds:  int64 := peek64(doc + PDF_DOC_CONTENTIDS);
  var widths100:   int64 := peek64(doc + PDF_DOC_WIDTHS100);
  var heights100:  int64 := peek64(doc + PDF_DOC_HEIGHTS100);
  var contentBufs: int64 := peek64(doc + PDF_DOC_CONTENTBUFS);
  var contentLens: int64 := peek64(doc + PDF_DOC_CONTENTLENS);

  // Allocate output buffer (4 MB)
  var out: int64 := mmapAlloc(PDF_OUT_BUF_SIZE);
  if (out == 0) { return -2; }

  // Determine whether to write a /Info dict (metadata present?)
  var hasInfo: int64 := 0;
  if (peek8(doc + PDF_DOC_META_TITLE)    != 0 || peek8(doc + PDF_DOC_META_AUTHOR)   != 0 ||
      peek8(doc + PDF_DOC_META_SUBJECT)  != 0 || peek8(doc + PDF_DOC_META_KEYWORDS) != 0 ||
      peek8(doc + PDF_DOC_META_CREATOR)  != 0 || peek8(doc + PDF_DOC_META_PRODUCER) != 0) {
    hasInfo := 1;
  }
  var infoId: int64 := nextId;  // object ID for /Info dict (only when hasInfo != 0)

  var annotCount: int64 := peek64(doc + PDF_DOC_ANNOTCOUNT);
  var annotBuf:   int64 := peek64(doc + PDF_DOC_ANNOTBUF);
  var firstAnnotId: int64 := nextId + hasInfo;  // first annotation object ID

  var outlineCount:    int64 := peek64(doc + PDF_DOC_OUTLINECOUNT);
  var outlineBuf:      int64 := peek64(doc + PDF_DOC_OUTLINEBUF);
  var outlineObjCount: int64 := 0;
  if (outlineCount > 0) { outlineObjCount := outlineCount + 1; }
  var outlineRootId:   int64 := nextId + hasInfo + annotCount;

  var labelCount: int64 := peek64(doc + PDF_DOC_LABELCOUNT);
  var labelBuf:   int64 := peek64(doc + PDF_DOC_LABELBUF);

  var transCount: int64 := peek64(doc + PDF_DOC_TRANSCOUNT);
  var transBuf:   int64 := peek64(doc + PDF_DOC_TRANSBUF);

  var viewFlags:     int64 := peek64(doc + PDF_DOC_VIEWFLAGS);
  var openPage:      int64 := peek64(doc + PDF_DOC_VIEWOPENPAGE);

  var namedestCount: int64 := peek64(doc + PDF_DOC_NAMEDESTCOUNT);
  var namedestBuf:   int64 := peek64(doc + PDF_DOC_NAMEDESTBUF);

  var attachCount:    int64 := peek64(doc + PDF_DOC_ATTACHCOUNT);
  var attachBuf:      int64 := peek64(doc + PDF_DOC_ATTACHBUF);
  var attachObjCount: int64 := attachCount * 2;
  var attachBaseId:   int64 := nextId + hasInfo + annotCount + outlineObjCount;

  var layerCount:   int64 := peek64(doc + PDF_DOC_LAYERCOUNT);
  var layerBuf:     int64 := peek64(doc + PDF_DOC_LAYERBUF);
  var layerBaseId:  int64 := attachBaseId + attachObjCount;

  // Allocate XRef offset table
  var xrefSize: int64 := (nextId + hasInfo + annotCount + outlineObjCount + attachObjCount + layerCount) * 8;
  var xrefs: int64 := mmapAlloc(xrefSize);
  if (xrefs == 0) {
    munmap(out, PDF_OUT_BUF_SIZE);
    return -3;
  }
  zeroMem(xrefs, xrefSize);

  var pos: int64 := 0;

  // --- PDF header ---
  pos := pdfStr(out, pos, "%PDF-1.4\n");
  poke8(out + pos, 37);   pos := pos + 1;
  poke8(out + pos, 0xE2); pos := pos + 1;
  poke8(out + pos, 0xE3); pos := pos + 1;
  poke8(out + pos, 0xCF); pos := pos + 1;
  poke8(out + pos, 0xD3); pos := pos + 1;
  poke8(out + pos, 10);   pos := pos + 1;

  // --- Object 1: Catalog ---
  poke64(xrefs + 1 * 8, pos);
  pos := pdfStr(out, pos, "1 0 obj\n<< /Type /Catalog /Pages 2 0 R");
  if (outlineCount > 0) {
    pos := pdfStr(out, pos, " /Outlines ");
    pos := pdfRef(out, pos, outlineRootId);
  }
  if (labelCount > 0) {
    pos := _pdfWritePageLabels(out, pos, labelBuf, labelCount);
  }
  if ((viewFlags & PDF_VIEW_FULLSCREEN) != 0) {
    pos := pdfStr(out, pos, " /PageMode /FullScreen");
  } else if ((viewFlags & PDF_VIEW_USE_OUTLINES) != 0) {
    pos := pdfStr(out, pos, " /PageMode /UseOutlines");
  }
  if ((viewFlags & PDF_VIEW_SINGLE_PAGE) != 0) {
    pos := pdfStr(out, pos, " /PageLayout /SinglePage");
  } else if ((viewFlags & PDF_VIEW_TWO_COLUMN_LEFT) != 0) {
    pos := pdfStr(out, pos, " /PageLayout /TwoColumnLeft");
  }
  if ((viewFlags & PDF_VIEW_OPEN_ACTION) != 0) {
    pos := pdfStr(out, pos, " /OpenAction [");
    pos := pdfRef(out, pos, arrGet(pageIds, openPage));
    pos := pdfStr(out, pos, " /XYZ null null null]");
  }
  var vpMask: int64 := viewFlags & 63;
  if (vpMask != 0) {
    pos := pdfStr(out, pos, " /ViewerPreferences <<");
    if ((vpMask & PDF_VIEW_HIDE_TOOLBAR) != 0)     { pos := pdfStr(out, pos, " /HideToolbar true"); }
    if ((vpMask & PDF_VIEW_HIDE_MENUBAR) != 0)     { pos := pdfStr(out, pos, " /HideMenubar true"); }
    if ((vpMask & PDF_VIEW_HIDE_WINDOWUI) != 0)    { pos := pdfStr(out, pos, " /HideWindowUI true"); }
    if ((vpMask & PDF_VIEW_FIT_WINDOW) != 0)       { pos := pdfStr(out, pos, " /FitWindow true"); }
    if ((vpMask & PDF_VIEW_CENTER_WINDOW) != 0)    { pos := pdfStr(out, pos, " /CenterWindow true"); }
    if ((vpMask & PDF_VIEW_DISPLAY_DOCTITLE) != 0) { pos := pdfStr(out, pos, " /DisplayDocTitle true"); }
    pos := pdfStr(out, pos, " >>");
  }
  if (namedestCount > 0 || attachCount > 0) {
    pos := pdfStr(out, pos, " /Names <<");
    if (namedestCount > 0) {
      pos := _pdfWriteDestsTree(out, pos, namedestBuf, namedestCount, pageIds);
    }
    if (attachCount > 0) {
      pos := _pdfWriteEmbedTree(out, pos, attachBuf, attachCount, attachBaseId);
    }
    pos := pdfStr(out, pos, " >>");
  }
  if (layerCount > 0) {
    pos := _pdfWriteOCProperties(out, pos, layerBuf, layerCount, layerBaseId);
  }
  pos := pdfStr(out, pos, " >>\nendobj\n");

  // --- Object 2: Pages ---
  poke64(xrefs + 2 * 8, pos);
  pos := pdfStr(out, pos, "2 0 obj\n<< /Type /Pages /Kids [");
  var i: int64 := 0;
  while (i < pageCount) {
    if (i > 0) { poke8(out + pos, 32); pos := pos + 1; }
    pos := pdfRef(out, pos, arrGet(pageIds, i));
    i := i + 1;
  }
  pos := pdfStr(out, pos, "] /Count ");
  pos := pdfInt(out, pos, pageCount);
  pos := pdfStr(out, pos, " >>\nendobj\n");

  // --- Font objects (Standard-14, one per registered font) ---
  var fontIdBase: int64 := doc + PDF_DOC_FONTIDS;
  var fi: int64 := 0;
  while (fi < 14) {
    var foid: int64 := peek64(fontIdBase + fi * 8);
    if (foid != 0) {
      poke64(xrefs + foid * 8, pos);
      pos := pdfObjHdr(out, pos, foid);
      pos := pdfStr(out, pos, "<< /Type /Font /Subtype /Type1 /BaseFont /");
      pos := pdfStr(out, pos, pdfFontName(fi));
      pos := pdfStr(out, pos, " >>");
      pos := pdfObjFtr(out, pos);
    }
    fi := fi + 1;
  }

  // --- Image XObject objects ---
  var imageCount:    int64 := peek64(doc + PDF_DOC_IMAGECOUNT);
  var imageIds:      int64 := peek64(doc + PDF_DOC_IMAGEIDS);
  var imageWidths:   int64 := peek64(doc + PDF_DOC_IMAGEWIDTHS);
  var imageHeights:  int64 := peek64(doc + PDF_DOC_IMAGEHEIGHTS);
  var imageChannels: int64 := peek64(doc + PDF_DOC_IMAGECHANNELS);
  var imageDataBufs: int64 := peek64(doc + PDF_DOC_IMAGEDATABUFS);
  var imageDataLens: int64 := peek64(doc + PDF_DOC_IMAGEDATALENS);

  var imgIdx: int64 := 0;
  while (imgIdx < imageCount) {
    var imgId:  int64 := arrGet(imageIds,      imgIdx);
    var imgW:   int64 := arrGet(imageWidths,   imgIdx);
    var imgH:   int64 := arrGet(imageHeights,  imgIdx);
    var imgC:   int64 := arrGet(imageChannels, imgIdx);
    var imgBuf: int64 := arrGet(imageDataBufs, imgIdx);
    var imgLen: int64 := arrGet(imageDataLens, imgIdx);

    poke64(xrefs + imgId * 8, pos);
    pos := pdfObjHdr(out, pos, imgId);
    pos := pdfStr(out, pos, "<< /Type /XObject /Subtype /Image /Width ");
    pos := pdfInt(out, pos, imgW);
    pos := pdfStr(out, pos, " /Height ");
    pos := pdfInt(out, pos, imgH);
    if (imgC == 1) {
      pos := pdfStr(out, pos, " /ColorSpace /DeviceGray");
    } else {
      pos := pdfStr(out, pos, " /ColorSpace /DeviceRGB");
    }
    pos := pdfStr(out, pos, " /BitsPerComponent 8 /Filter /FlateDecode /Length ");
    pos := pdfInt(out, pos, imgLen);
    pos := pdfStr(out, pos, " >>\nstream\n");
    pos := pdfBytes(out, pos, imgBuf, imgLen);
    pos := pdfStr(out, pos, "\nendstream");
    pos := pdfObjFtr(out, pos);

    imgIdx := imgIdx + 1;
  }

  // --- Form XObject objects (WP-PDF-23) ---
  var compression: int64 := peek64(doc + PDF_DOC_COMPRESSION);
  var xobjCount:  int64 := peek64(doc + PDF_DOC_XOBJCOUNT);
  var xobjBuf:    int64 := peek64(doc + PDF_DOC_XOBJBUF);
  var xi: int64 := 0;
  while (xi < xobjCount) {
    var xrec:   int64 := xobjBuf + xi * PDF_XOBJ_RECSIZE;
    var xobjId: int64 := peek64(xrec + PDF_XOBJ_OBJID);
    var xw100:  int64 := peek64(xrec + PDF_XOBJ_W100);
    var xh100:  int64 := peek64(xrec + PDF_XOBJ_H100);
    var xbuf:   int64 := peek64(xrec + PDF_XOBJ_CONTENTBUF);
    var xlen:   int64 := peek64(xrec + PDF_XOBJ_CONTENTLEN);
    var xfmask: int64 := peek64(xrec + PDF_XOBJ_FONTMASK);

    poke64(xrefs + xobjId * 8, pos);
    pos := pdfObjHdr(out, pos, xobjId);
    pos := pdfStr(out, pos, "<< /Type /XObject /Subtype /Form /BBox [0 0 ");
    pos := pdfReal100(out, pos, xw100); poke8(out + pos, 32); pos := pos + 1;
    pos := pdfReal100(out, pos, xh100);
    pos := pdfStr(out, pos, "]");
    // /Resources with fonts used inside this XObject
    if (xfmask != 0) {
      pos := pdfStr(out, pos, " /Resources << /Font <<");
      var xfi: int64 := 0;
      while (xfi < 14) {
        if ((xfmask >> xfi) & 1 != 0) {
          pos := pdfStr(out, pos, " /F");
          pos := pdfInt(out, pos, xfi);
          poke8(out + pos, 32); pos := pos + 1;
          pos := pdfRef(out, pos, peek64(fontIdBase + xfi * 8));
        }
        xfi := xfi + 1;
      }
      pos := pdfStr(out, pos, " >> >>");
    }
    // Optionally compress content
    var xzbuf: int64 := 0;
    var xzlen: int64 := 0;
    if (compression > 0 && xlen > 0) {
      var xmaxOut: int64 := zlibMaxOutputSize(xlen);
      xzbuf := mmapAlloc(xmaxOut);
      if (xzbuf != 0) { xzlen := zlibCompress(xbuf, xlen, xzbuf); }
    }
    if (xzbuf != 0 && xzlen > 0) {
      pos := pdfStr(out, pos, " /Filter /FlateDecode /Length ");
      pos := pdfInt(out, pos, xzlen);
      pos := pdfStr(out, pos, " >>\nstream\n");
      pos := pdfBytes(out, pos, xzbuf, xzlen);
      munmap(xzbuf, zlibMaxOutputSize(xlen));
    } else {
      pos := pdfStr(out, pos, " /Length ");
      pos := pdfInt(out, pos, xlen);
      pos := pdfStr(out, pos, " >>\nstream\n");
      if (xbuf != 0 && xlen > 0) { pos := pdfBytes(out, pos, xbuf, xlen); }
    }
    pos := pdfStr(out, pos, "\nendstream");
    pos := pdfObjFtr(out, pos);
    xi := xi + 1;
  }

  // --- Per-page objects ---
  i := 0;
  while (i < pageCount) {
    var pageId:    int64 := arrGet(pageIds,    i);
    var contentId: int64 := arrGet(contentIds, i);
    var w100:      int64 := arrGet(widths100,  i);
    var h100:      int64 := arrGet(heights100, i);
    var cbuf:      int64 := arrGet(contentBufs, i);
    var clen:      int64 := arrGet(contentLens, i);
    var fontMask:  int64 := peek64(doc + PDF_DOC_PAGEFONTMASK + i * 8);

    // Page dictionary
    poke64(xrefs + pageId * 8, pos);
    pos := pdfObjHdr(out, pos, pageId);
    pos := pdfStr(out, pos, "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ");
    pos := pdfReal100(out, pos, w100);
    poke8(out + pos, 32); pos := pos + 1;
    pos := pdfReal100(out, pos, h100);
    pos := pdfStr(out, pos, "] /Resources << /Font <<");
    // Emit font resource entries for fonts used on this page
    var fj: int64 := 0;
    while (fj < 14) {
      if ((fontMask >> fj) & 1 != 0) {
        var foid2: int64 := peek64(fontIdBase + fj * 8);
        pos := pdfStr(out, pos, " /F");
        pos := pdfInt(out, pos, fj);
        poke8(out + pos, 32); pos := pos + 1;
        pos := pdfRef(out, pos, foid2);
      }
      fj := fj + 1;
    }
    pos := pdfStr(out, pos, " >>");
    // /XObject resource: images + form xobjects used on this page
    var imgMask:  int64 := arrGet(peek64(doc + PDF_DOC_PAGEIMAGEMASKS), i);
    var xMask:    int64 := arrGet(peek64(doc + PDF_DOC_PAGEXOBJMASKS),  i);
    if (imgMask != 0 || xMask != 0) {
      pos := pdfStr(out, pos, " /XObject <<");
      if (imgMask != 0) {
        var ij: int64 := 0;
        while (ij < imageCount) {
          if ((imgMask >> ij) & 1 != 0) {
            pos := pdfStr(out, pos, " /Im");
            pos := pdfInt(out, pos, ij);
            poke8(out + pos, 32); pos := pos + 1;
            pos := pdfRef(out, pos, arrGet(imageIds, ij));
          }
          ij := ij + 1;
        }
      }
      if (xMask != 0) {
        var xj: int64 := 0;
        while (xj < xobjCount) {
          if ((xMask >> xj) & 1 != 0) {
            var xjId: int64 := peek64(xobjBuf + xj * PDF_XOBJ_RECSIZE + PDF_XOBJ_OBJID);
            pos := pdfStr(out, pos, " /FX");
            pos := pdfInt(out, pos, xj);
            poke8(out + pos, 32); pos := pos + 1;
            pos := pdfRef(out, pos, xjId);
          }
          xj := xj + 1;
        }
      }
      pos := pdfStr(out, pos, " >>");
    }
    if (layerCount > 0) {
      pos := _pdfWriteLayerProps(out, pos, layerCount, layerBaseId);
    }
    pos := pdfStr(out, pos, " >> /Contents ");
    pos := pdfRef(out, pos, contentId);
    // /Annots array for annotations on this page
    var hasAnnotsOnPage: int64 := 0;
    var ak0: int64 := 0;
    while (ak0 < annotCount) {
      if (peek64(annotBuf + ak0 * PDF_ANNOT_RECSIZE + PDF_ANNOT_PAGE) == i) {
        hasAnnotsOnPage := 1;
        break;
      }
      ak0 := ak0 + 1;
    }
    if (hasAnnotsOnPage != 0) {
      pos := pdfStr(out, pos, " /Annots [");
      var ak1: int64 := 0;
      while (ak1 < annotCount) {
        if (peek64(annotBuf + ak1 * PDF_ANNOT_RECSIZE + PDF_ANNOT_PAGE) == i) {
          pos := pdfRef(out, pos, firstAnnotId + ak1);
          poke8(out + pos, 32); pos := pos + 1;
        }
        ak1 := ak1 + 1;
      }
      pos := pdfStr(out, pos, "]");
    }
    // WP-PDF-20: /Rotate if non-zero
    var rotBuf: int64 := peek64(doc + PDF_DOC_PAGEROTATIONS);
    var rot:    int64 := arrGet(rotBuf, i);
    if (rot != 0) {
      pos := pdfStr(out, pos, " /Rotate ");
      pos := pdfInt(out, pos, rot);
    }

    var trec: int64 := _pdfTransForPage(transBuf, transCount, i);
    if (trec != 0) {
      pos := pdfStr(out, pos, " /Trans << /S /");
      pos := pdfStr(out, pos, _pdfTransName(peek64(trec + PDF_TRANS_TYPE)));
      var dur100v: int64 := peek64(trec + PDF_TRANS_DUR100);
      if (dur100v > 0) {
        pos := pdfStr(out, pos, " /D ");
        pos := pdfReal100(out, pos, dur100v);
      }
      pos := pdfStr(out, pos, " >>");
    }
    pos := pdfStr(out, pos, " >>");
    pos := pdfObjFtr(out, pos);

    // Content stream
    poke64(xrefs + contentId * 8, pos);
    pos := pdfObjHdr(out, pos, contentId);
    var emitted: int64 := 0;
    if (compression > 0 && clen > 0) {
      var maxOut: int64 := zlibMaxOutputSize(clen);
      var czbuf:  int64 := mmapAlloc(maxOut);
      if (czbuf != 0) {
        var czlen: int64 := zlibCompress(cbuf, clen, czbuf);
        if (czlen > 0) {
          pos := pdfStr(out, pos, "<< /Length ");
          pos := pdfInt(out, pos, czlen);
          pos := pdfStr(out, pos, " /Filter /FlateDecode >>\nstream\n");
          pos := pdfBytes(out, pos, czbuf, czlen);
          pos := pdfStr(out, pos, "\nendstream");
          pos := pdfObjFtr(out, pos);
          emitted := 1;
        }
        munmap(czbuf, maxOut);
      }
    }
    if (emitted == 0) {
      pos := pdfStr(out, pos, "<< /Length ");
      pos := pdfInt(out, pos, clen);
      pos := pdfStr(out, pos, " >>\nstream\n");
      if (clen > 0) {
        pos := pdfBytes(out, pos, cbuf, clen);
      }
      pos := pdfStr(out, pos, "endstream");
      pos := pdfObjFtr(out, pos);
    }

    i := i + 1;
  }

  // --- Info dictionary (optional) ---
  if (hasInfo != 0) {
    poke64(xrefs + infoId * 8, pos);
    pos := pdfObjHdr(out, pos, infoId);
    pos := pdfStr(out, pos, "<<");
    pos := _pdfMetaField(out, pos, " /Title ",    doc + PDF_DOC_META_TITLE,    256);
    pos := _pdfMetaField(out, pos, " /Author ",   doc + PDF_DOC_META_AUTHOR,   256);
    pos := _pdfMetaField(out, pos, " /Subject ",  doc + PDF_DOC_META_SUBJECT,  256);
    pos := _pdfMetaField(out, pos, " /Keywords ", doc + PDF_DOC_META_KEYWORDS, 256);
    pos := _pdfMetaField(out, pos, " /Creator ",  doc + PDF_DOC_META_CREATOR,  128);
    pos := _pdfMetaField(out, pos, " /Producer ", doc + PDF_DOC_META_PRODUCER, 128);
    pos := pdfStr(out, pos, " >>");
    pos := pdfObjFtr(out, pos);
  }

  // --- Annotation objects ---
  var ann: int64 := 0;
  while (ann < annotCount) {
    var arec:   int64 := annotBuf + ann * PDF_ANNOT_RECSIZE;
    var atype:  int64 := peek64(arec + PDF_ANNOT_TYPE);
    var ax1:    int64 := peek64(arec + PDF_ANNOT_X1_100);
    var ay1:    int64 := peek64(arec + PDF_ANNOT_Y1_100);
    var ax2:    int64 := peek64(arec + PDF_ANNOT_X2_100);
    var ay2:    int64 := peek64(arec + PDF_ANNOT_Y2_100);
    var adata1: int64 := peek64(arec + PDF_ANNOT_DATA1);
    var adata2: int64 := peek64(arec + PDF_ANNOT_DATA2);
    var aextra: int64 := peek64(arec + PDF_ANNOT_EXTRA);
    var annotId: int64 := firstAnnotId + ann;

    poke64(xrefs + annotId * 8, pos);
    pos := pdfObjHdr(out, pos, annotId);
    pos := pdfStr(out, pos, "<< /Type /Annot");

    if (atype == 1) {
      pos := pdfStr(out, pos, " /Subtype /Link /Rect [");
      pos := pdfReal100(out, pos, ax1);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ay1);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ax2);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ay2);
      pos := pdfStr(out, pos, "] /Border [0 0 0] /A << /S /URI /URI ");
      if (adata1 != 0) {
        pos := _pdfEscStr(out, pos, adata1);
      } else {
        pos := pdfStr(out, pos, "()");
      }
      pos := pdfStr(out, pos, " >>");
    } else if (atype == 2) {
      pos := pdfStr(out, pos, " /Subtype /Text /Rect [");
      pos := pdfReal100(out, pos, ax1);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ay1);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ax2);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ay2);
      pos := pdfStr(out, pos, "] /Open false");
      if (adata2 != 0) {
        pos := pdfStr(out, pos, " /T ");
        pos := _pdfEscStr(out, pos, adata2);
      }
      if (adata1 != 0) {
        pos := pdfStr(out, pos, " /Contents ");
        pos := _pdfEscStr(out, pos, adata1);
      }
    } else if (atype == 3) {
      pos := pdfStr(out, pos, " /Subtype /Link /Rect [");
      pos := pdfReal100(out, pos, ax1);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ay1);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ax2);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ay2);
      pos := pdfStr(out, pos, "] /Border [0 0 0] /Dest [");
      pos := pdfRef(out, pos, arrGet(pageIds, aextra));
      pos := pdfStr(out, pos, " /XYZ null null null]");
    }

    pos := pdfStr(out, pos, " >>");
    pos := pdfObjFtr(out, pos);
    ann := ann + 1;
  }

  // --- Outline objects ---
  if (outlineCount > 0) {
    pos := _pdfWriteOutlineRoot(out, pos, xrefs, outlineBuf, outlineCount, outlineRootId);
    var oi: int64 := 0;
    while (oi < outlineCount) {
      var orec: int64 := outlineBuf + oi * PDF_OUTLINE_RECSIZE;
      poke64(xrefs + (outlineRootId + 1 + oi) * 8, pos);
      pos := pdfObjHdr(out, pos, outlineRootId + 1 + oi);
      pos := pdfStr(out, pos, "<< /Title ");
      pos := _pdfEscStr(out, pos, peek64(orec + PDF_OUTLINE_TITLEBUF));
      pos := pdfStr(out, pos, " /Parent ");
      if (peek64(orec + PDF_OUTLINE_PARENT) < 0) {
        pos := pdfRef(out, pos, outlineRootId);
      } else {
        pos := pdfRef(out, pos, outlineRootId + 1 + peek64(orec + PDF_OUTLINE_PARENT));
      }
      pos := pdfStr(out, pos, " /Dest [");
      pos := pdfRef(out, pos, arrGet(pageIds, peek64(orec + PDF_OUTLINE_DESTPAGE)));
      pos := pdfStr(out, pos, " /XYZ null null null]");
      pos := _pdfWriteOutlineLinks(out, pos, outlineBuf, outlineCount, oi, outlineRootId);
      pos := pdfStr(out, pos, " >>");
      pos := pdfObjFtr(out, pos);
      oi := oi + 1;
    }
  }

  // --- Attachment objects (EmbeddedFile stream + Filespec dict per attachment) ---
  var attI: int64 := 0;
  while (attI < attachCount) {
    var attRec:  int64 := attachBuf + attI * PDF_ATTACH_RECSIZE;
    var attName: int64 := peek64(attRec + PDF_ATTACH_NAMEBUF);
    var attData: int64 := peek64(attRec + PDF_ATTACH_DATABUF);
    var attDLen: int64 := peek64(attRec + PDF_ATTACH_DATALEN);
    var attSId:  int64 := attachBaseId + attI * 2;
    var attFsId: int64 := attachBaseId + attI * 2 + 1;
    poke64(xrefs + attSId * 8, pos);
    pos := pdfObjHdr(out, pos, attSId);
    pos := pdfStr(out, pos, "<< /Type /EmbeddedFile /Length ");
    pos := pdfInt(out, pos, attDLen);
    pos := pdfStr(out, pos, " >>\nstream\n");
    pos := pdfBytes(out, pos, attData, attDLen);
    pos := pdfStr(out, pos, "\nendstream");
    pos := pdfObjFtr(out, pos);
    poke64(xrefs + attFsId * 8, pos);
    pos := pdfObjHdr(out, pos, attFsId);
    pos := pdfStr(out, pos, "<< /Type /Filespec /F ");
    pos := _pdfEscStr(out, pos, attName);
    pos := pdfStr(out, pos, " /EF << /F ");
    pos := pdfRef(out, pos, attSId);
    pos := pdfStr(out, pos, " >> >>");
    pos := pdfObjFtr(out, pos);
    attI := attI + 1;
  }

  // --- OCG layer objects ---
  var lyrI: int64 := 0;
  while (lyrI < layerCount) {
    var lyrRec:   int64 := layerBuf + lyrI * PDF_LAYER_RECSIZE;
    var lyrName:  int64 := peek64(lyrRec + PDF_LAYER_NAMEBUF);
    var lyrObjId: int64 := layerBaseId + lyrI;
    poke64(xrefs + lyrObjId * 8, pos);
    pos := pdfObjHdr(out, pos, lyrObjId);
    pos := pdfStr(out, pos, "<< /Type /OCG /Name ");
    pos := _pdfEscStr(out, pos, lyrName);
    pos := pdfStr(out, pos, " >>");
    pos := pdfObjFtr(out, pos);
    lyrI := lyrI + 1;
  }

  // --- XRef section ---
  var xrefStart: int64 := pos;
  var xrefCount: int64 := nextId + hasInfo + annotCount + outlineObjCount + attachObjCount + layerCount;

  pos := pdfStr(out, pos, "xref\n0 ");
  pos := pdfInt(out, pos, xrefCount);
  poke8(out + pos, 10); pos := pos + 1;

  // Free entry for object 0
  pos := pdfXrefEntry(out, pos, 0, 65535, true);

  // In-use entries for objects 1..xrefCount-1
  var id: int64 := 1;
  while (id < xrefCount) {
    var off: int64 := peek64(xrefs + id * 8);
    pos := pdfXrefEntry(out, pos, off, 0, false);
    id := id + 1;
  }

  // --- Trailer ---
  pos := pdfStr(out, pos, "trailer\n<< /Size ");
  pos := pdfInt(out, pos, xrefCount);
  pos := pdfStr(out, pos, " /Root 1 0 R");
  if (hasInfo != 0) {
    pos := pdfStr(out, pos, " /Info ");
    pos := pdfRef(out, pos, infoId);
  }
  pos := pdfStr(out, pos, " >>\nstartxref\n");
  pos := pdfInt(out, pos, xrefStart);
  pos := pdfStr(out, pos, "\n%%EOF\n");

  // --- Write to file ---
  var fd: int64 := open(path, 577, 420);
  if (fd < 0) {
    munmap(xrefs, xrefSize);
    munmap(out, PDF_OUT_BUF_SIZE);
    return -4;
  }

  var written: int64 := write(fd, out, pos);
  close(fd);

  munmap(xrefs, xrefSize);
  munmap(out, PDF_OUT_BUF_SIZE);

  if (written != pos) { return -5; }
  return 0;
}
