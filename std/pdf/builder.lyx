// std/pdf/builder.lyx
// PDF document builder: object pool, XRef table, serialization

@description("PDF document builder: PdfNew, PdfSave, PdfFree, content stream management")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit std.pdf.builder;

import std.pdf.objects;
import std.pdf.compress;

// ============================================================================
// Document struct field offsets (mmap'd block, PDF_DOC_SIZE bytes)
// ============================================================================

pub con PDF_DOC_PAGECOUNT:   int64 := 0;
pub con PDF_DOC_PAGECAP:     int64 := 8;
pub con PDF_DOC_NEXTID:      int64 := 16;
pub con PDF_DOC_COMPRESSION: int64 := 24;
pub con PDF_DOC_PAGEIDS:     int64 := 32;
pub con PDF_DOC_CONTENTIDS:  int64 := 40;
pub con PDF_DOC_WIDTHS100:   int64 := 48;
pub con PDF_DOC_HEIGHTS100:  int64 := 56;
pub con PDF_DOC_CONTENTBUFS: int64 := 64;
pub con PDF_DOC_CONTENTLENS: int64 := 72;
pub con PDF_DOC_CONTENTCAPS:      int64 := 80;
// Font-related fields packed into the 4096-byte doc block at offsets 88–1735
pub con PDF_DOC_FONTIDS:          int64 := 88;    // int64[14]: per-font obj IDs (0 = unused)
pub con PDF_DOC_PAGEFONTMASK:     int64 := 200;   // int64[64]: per-page used-font bitmask
pub con PDF_DOC_CURFONTIDX:       int64 := 712;   // int64[64]: current font index per page
pub con PDF_DOC_CURFONTSIZE100:   int64 := 1224;  // int64[64]: current font size ×100 per page
pub con PDF_DOC_CURTEXTCOLOR:     int64 := 1736;  // int64[64]: current text color per page
//   color encoding: bits 63..48 = r100, bits 47..32 = g100, bits 31..16 = b100
pub con PDF_DOC_SIZE:             int64 := 4096;

// Image fields (offsets 2248..2319, within the 4096-byte doc block)
pub con PDF_INITIAL_IMAGE_CAP:  int64 := 16;
pub con PDF_DOC_IMAGECOUNT:     int64 := 2248;
pub con PDF_DOC_IMAGECAP:       int64 := 2256;
pub con PDF_DOC_IMAGEIDS:       int64 := 2264;   // int64* object IDs
pub con PDF_DOC_IMAGEWIDTHS:    int64 := 2272;   // int64* pixel widths
pub con PDF_DOC_IMAGEHEIGHTS:   int64 := 2280;   // int64* pixel heights
pub con PDF_DOC_IMAGECHANNELS:  int64 := 2288;   // int64* 1=gray 3=RGB
pub con PDF_DOC_IMAGEDATABUFS:  int64 := 2296;   // int64* compressed data ptrs
pub con PDF_DOC_IMAGEDATALENS:  int64 := 2304;   // int64* compressed data sizes
pub con PDF_DOC_PAGEIMAGEMASKS: int64 := 2312;   // int64* per-page image bitmask

// Metadata strings stored inline in the 4096-byte doc block (offsets 2320..3599)
// Automatically NUL-terminated and zeroed by PdfNew → no extra allocation needed.
pub con PDF_DOC_META_TITLE:    int64 := 2320;   // char[256]
pub con PDF_DOC_META_AUTHOR:   int64 := 2576;   // char[256]
pub con PDF_DOC_META_SUBJECT:  int64 := 2832;   // char[256]
pub con PDF_DOC_META_KEYWORDS: int64 := 3088;   // char[256]
pub con PDF_DOC_META_CREATOR:  int64 := 3344;   // char[128]
pub con PDF_DOC_META_PRODUCER: int64 := 3472;   // char[128]

// Annotation list (offsets 3600..3623, within the 4096-byte doc block)
pub con PDF_DOC_ANNOTCOUNT:     int64 := 3600;   // int64 total annotation count
pub con PDF_DOC_ANNOTCAP:       int64 := 3608;   // int64 capacity of annotBuf
pub con PDF_DOC_ANNOTBUF:       int64 := 3616;   // int64* annotation record buffer

// Annotation record layout (96 bytes each, stored in annotBuf)
pub con PDF_ANNOT_TYPE:      int64 := 0;   // 1=link_uri 2=text_note 3=link_goto
pub con PDF_ANNOT_PAGE:      int64 := 8;   // page index (int64)
pub con PDF_ANNOT_X1_100:    int64 := 16;  // rect x1 × 100
pub con PDF_ANNOT_Y1_100:    int64 := 24;  // rect y1 × 100
pub con PDF_ANNOT_X2_100:    int64 := 32;  // rect x2 × 100
pub con PDF_ANNOT_Y2_100:    int64 := 40;  // rect y2 × 100
pub con PDF_ANNOT_DATA1:     int64 := 48;  // int64* URL (link) or content text (note)
pub con PDF_ANNOT_DATA1LEN:  int64 := 56;  // allocation length of data1
pub con PDF_ANNOT_DATA2:     int64 := 64;  // int64* title (note only)
pub con PDF_ANNOT_DATA2LEN:  int64 := 72;  // allocation length of data2
pub con PDF_ANNOT_EXTRA:     int64 := 80;  // dest page index (link_goto)
pub con PDF_ANNOT_RECSIZE:   int64 := 96;
pub con PDF_ANNOT_INITIAL_CAP: int64 := 16;

// Outline (bookmarks) list (offsets 3624..3647, within 4096-byte doc block)
pub con PDF_DOC_OUTLINECOUNT:    int64 := 3624;  // int64 item count
pub con PDF_DOC_OUTLINECAP:      int64 := 3632;  // int64 capacity
pub con PDF_DOC_OUTLINEBUF:      int64 := 3640;  // int64* record buffer

// Outline record layout (32 bytes each, stored in outlineBuf)
pub con PDF_OUTLINE_PARENT:      int64 := 0;   // int64 parent index (-1 = root)
pub con PDF_OUTLINE_DESTPAGE:    int64 := 8;   // int64 destination page index
pub con PDF_OUTLINE_TITLEBUF:    int64 := 16;  // int64* title string (mmap'd, NUL-term)
pub con PDF_OUTLINE_TITLELEN:    int64 := 24;  // int64 title allocation length
pub con PDF_OUTLINE_RECSIZE:     int64 := 32;
pub con PDF_OUTLINE_INITIAL_CAP: int64 := 8;

pub con PDF_INITIAL_PAGE_CAP: int64 := 64;
pub con PDF_OUT_BUF_SIZE:     int64 := 4194304;

// mmap flags: PROT_READ|PROT_WRITE=3, MAP_PRIVATE|MAP_ANONYMOUS=34
con MMAP_PROT: int64 := 3;
con MMAP_FLAGS: int64 := 34;

// ============================================================================
// Internal helpers
// ============================================================================

fn arrGet(arr: int64, idx: int64): int64 {
  return peek64(arr + idx * 8);
}

fn arrSet(arr: int64, idx: int64, val: int64): void {
  poke64(arr + idx * 8, val);
}

fn zeroMem(ptr: int64, size: int64): void {
  var i: int64 := 0;
  while (i < size) {
    poke8(ptr + i, 0);
    i := i + 1;
  }
}

fn mmapAlloc(size: int64): int64 {
  return mmap(0, size, MMAP_PROT, MMAP_FLAGS, -1, 0);
}

// ============================================================================
// PdfNew — create a new empty document
// Returns: doc handle (int64 pointer), or 0 on failure
// ============================================================================

pub fn PdfNew(): int64 {
  var doc: int64 := mmapAlloc(PDF_DOC_SIZE);
  if (doc == 0) { return 0; }
  zeroMem(doc, PDF_DOC_SIZE);

  var pageCap: int64 := PDF_INITIAL_PAGE_CAP;
  var arrSize: int64 := pageCap * 8;

  poke64(doc + PDF_DOC_PAGECOUNT,   0);
  poke64(doc + PDF_DOC_PAGECAP,     pageCap);
  poke64(doc + PDF_DOC_NEXTID,      3);
  poke64(doc + PDF_DOC_COMPRESSION, 0);

  var pageIds:     int64 := mmapAlloc(arrSize);
  var contentIds:  int64 := mmapAlloc(arrSize);
  var widths100:   int64 := mmapAlloc(arrSize);
  var heights100:  int64 := mmapAlloc(arrSize);
  var contentBufs: int64 := mmapAlloc(arrSize);
  var contentLens: int64 := mmapAlloc(arrSize);
  var contentCaps: int64 := mmapAlloc(arrSize);

  if (pageIds == 0 || contentIds == 0 || widths100 == 0 || heights100 == 0 ||
      contentBufs == 0 || contentLens == 0 || contentCaps == 0) {
    if (pageIds != 0)     { munmap(pageIds,     arrSize); }
    if (contentIds != 0)  { munmap(contentIds,  arrSize); }
    if (widths100 != 0)   { munmap(widths100,   arrSize); }
    if (heights100 != 0)  { munmap(heights100,  arrSize); }
    if (contentBufs != 0) { munmap(contentBufs, arrSize); }
    if (contentLens != 0) { munmap(contentLens, arrSize); }
    if (contentCaps != 0) { munmap(contentCaps, arrSize); }
    munmap(doc, PDF_DOC_SIZE);
    return 0;
  }

  zeroMem(pageIds,     arrSize);
  zeroMem(contentIds,  arrSize);
  zeroMem(widths100,   arrSize);
  zeroMem(heights100,  arrSize);
  zeroMem(contentBufs, arrSize);
  zeroMem(contentLens, arrSize);
  zeroMem(contentCaps, arrSize);

  poke64(doc + PDF_DOC_PAGEIDS,     pageIds);
  poke64(doc + PDF_DOC_CONTENTIDS,  contentIds);
  poke64(doc + PDF_DOC_WIDTHS100,   widths100);
  poke64(doc + PDF_DOC_HEIGHTS100,  heights100);
  poke64(doc + PDF_DOC_CONTENTBUFS, contentBufs);
  poke64(doc + PDF_DOC_CONTENTLENS, contentLens);
  poke64(doc + PDF_DOC_CONTENTCAPS, contentCaps);

  // Image arrays
  var imgCap:   int64 := PDF_INITIAL_IMAGE_CAP;
  var imgArrSz: int64 := imgCap * 8;

  var imageIds:      int64 := mmapAlloc(imgArrSz);
  var imageWidths:   int64 := mmapAlloc(imgArrSz);
  var imageHeights:  int64 := mmapAlloc(imgArrSz);
  var imageChannels: int64 := mmapAlloc(imgArrSz);
  var imageDataBufs: int64 := mmapAlloc(imgArrSz);
  var imageDataLens: int64 := mmapAlloc(imgArrSz);
  var pageImgMasks:  int64 := mmapAlloc(pageCap * 8);

  if (imageIds == 0 || imageWidths == 0 || imageHeights == 0 || imageChannels == 0 ||
      imageDataBufs == 0 || imageDataLens == 0 || pageImgMasks == 0) {
    if (imageIds != 0)      { munmap(imageIds,      imgArrSz); }
    if (imageWidths != 0)   { munmap(imageWidths,   imgArrSz); }
    if (imageHeights != 0)  { munmap(imageHeights,  imgArrSz); }
    if (imageChannels != 0) { munmap(imageChannels, imgArrSz); }
    if (imageDataBufs != 0) { munmap(imageDataBufs, imgArrSz); }
    if (imageDataLens != 0) { munmap(imageDataLens, imgArrSz); }
    if (pageImgMasks != 0)  { munmap(pageImgMasks,  pageCap * 8); }
    munmap(pageIds,     arrSize);
    munmap(contentIds,  arrSize);
    munmap(widths100,   arrSize);
    munmap(heights100,  arrSize);
    munmap(contentBufs, arrSize);
    munmap(contentLens, arrSize);
    munmap(contentCaps, arrSize);
    munmap(doc, PDF_DOC_SIZE);
    return 0;
  }

  zeroMem(imageIds,      imgArrSz);
  zeroMem(imageWidths,   imgArrSz);
  zeroMem(imageHeights,  imgArrSz);
  zeroMem(imageChannels, imgArrSz);
  zeroMem(imageDataBufs, imgArrSz);
  zeroMem(imageDataLens, imgArrSz);
  zeroMem(pageImgMasks,  pageCap * 8);

  poke64(doc + PDF_DOC_IMAGECOUNT,     0);
  poke64(doc + PDF_DOC_IMAGECAP,       imgCap);
  poke64(doc + PDF_DOC_IMAGEIDS,       imageIds);
  poke64(doc + PDF_DOC_IMAGEWIDTHS,    imageWidths);
  poke64(doc + PDF_DOC_IMAGEHEIGHTS,   imageHeights);
  poke64(doc + PDF_DOC_IMAGECHANNELS,  imageChannels);
  poke64(doc + PDF_DOC_IMAGEDATABUFS,  imageDataBufs);
  poke64(doc + PDF_DOC_IMAGEDATALENS,  imageDataLens);
  poke64(doc + PDF_DOC_PAGEIMAGEMASKS, pageImgMasks);

  // Annotation buffer
  var annotBuf: int64 := mmapAlloc(PDF_ANNOT_INITIAL_CAP * PDF_ANNOT_RECSIZE);
  if (annotBuf == 0) {
    munmap(imageIds,      imgArrSz);
    munmap(imageWidths,   imgArrSz);
    munmap(imageHeights,  imgArrSz);
    munmap(imageChannels, imgArrSz);
    munmap(imageDataBufs, imgArrSz);
    munmap(imageDataLens, imgArrSz);
    munmap(pageImgMasks,  pageCap * 8);
    munmap(pageIds,     arrSize);
    munmap(contentIds,  arrSize);
    munmap(widths100,   arrSize);
    munmap(heights100,  arrSize);
    munmap(contentBufs, arrSize);
    munmap(contentLens, arrSize);
    munmap(contentCaps, arrSize);
    munmap(doc, PDF_DOC_SIZE);
    return 0;
  }
  zeroMem(annotBuf, PDF_ANNOT_INITIAL_CAP * PDF_ANNOT_RECSIZE);
  poke64(doc + PDF_DOC_ANNOTCOUNT, 0);
  poke64(doc + PDF_DOC_ANNOTCAP,   PDF_ANNOT_INITIAL_CAP);
  poke64(doc + PDF_DOC_ANNOTBUF,   annotBuf);

  // Outline buffer
  var outlineBuf: int64 := mmapAlloc(PDF_OUTLINE_INITIAL_CAP * PDF_OUTLINE_RECSIZE);
  if (outlineBuf == 0) {
    munmap(annotBuf,     PDF_ANNOT_INITIAL_CAP * PDF_ANNOT_RECSIZE);
    munmap(imageIds,      imgArrSz);
    munmap(imageWidths,   imgArrSz);
    munmap(imageHeights,  imgArrSz);
    munmap(imageChannels, imgArrSz);
    munmap(imageDataBufs, imgArrSz);
    munmap(imageDataLens, imgArrSz);
    munmap(pageImgMasks,  pageCap * 8);
    munmap(pageIds,     arrSize);
    munmap(contentIds,  arrSize);
    munmap(widths100,   arrSize);
    munmap(heights100,  arrSize);
    munmap(contentBufs, arrSize);
    munmap(contentLens, arrSize);
    munmap(contentCaps, arrSize);
    munmap(doc, PDF_DOC_SIZE);
    return 0;
  }
  zeroMem(outlineBuf, PDF_OUTLINE_INITIAL_CAP * PDF_OUTLINE_RECSIZE);
  poke64(doc + PDF_DOC_OUTLINECOUNT, 0);
  poke64(doc + PDF_DOC_OUTLINECAP,   PDF_OUTLINE_INITIAL_CAP);
  poke64(doc + PDF_DOC_OUTLINEBUF,   outlineBuf);

  return doc;
}

// ============================================================================
// PdfFree — release all document memory
// ============================================================================

pub fn PdfFree(doc: int64): void {
  if (doc == 0) { return; }

  var pageCap:     int64 := peek64(doc + PDF_DOC_PAGECAP);
  var pageCount:   int64 := peek64(doc + PDF_DOC_PAGECOUNT);
  var contentBufs: int64 := peek64(doc + PDF_DOC_CONTENTBUFS);
  var contentCaps: int64 := peek64(doc + PDF_DOC_CONTENTCAPS);
  var arrSize:     int64 := pageCap * 8;

  var i: int64 := 0;
  while (i < pageCount) {
    var cbuf: int64 := arrGet(contentBufs, i);
    var ccap: int64 := arrGet(contentCaps, i);
    if (cbuf != 0 && ccap > 0) {
      munmap(cbuf, ccap);
    }
    i := i + 1;
  }

  munmap(peek64(doc + PDF_DOC_PAGEIDS),     arrSize);
  munmap(peek64(doc + PDF_DOC_CONTENTIDS),  arrSize);
  munmap(peek64(doc + PDF_DOC_WIDTHS100),   arrSize);
  munmap(peek64(doc + PDF_DOC_HEIGHTS100),  arrSize);
  munmap(peek64(doc + PDF_DOC_CONTENTBUFS), arrSize);
  munmap(peek64(doc + PDF_DOC_CONTENTLENS), arrSize);
  munmap(peek64(doc + PDF_DOC_CONTENTCAPS), arrSize);

  // Free compressed image data, then image metadata arrays
  var imgCap:   int64 := peek64(doc + PDF_DOC_IMAGECAP);
  var imgArrSz: int64 := imgCap * 8;
  var imgCount: int64 := peek64(doc + PDF_DOC_IMAGECOUNT);
  var imgDBufs: int64 := peek64(doc + PDF_DOC_IMAGEDATABUFS);
  var imgDLens: int64 := peek64(doc + PDF_DOC_IMAGEDATALENS);

  if (imgDBufs != 0) {
    var ii: int64 := 0;
    while (ii < imgCount) {
      var ibuf: int64 := arrGet(imgDBufs, ii);
      var ilen: int64 := arrGet(imgDLens, ii);
      if (ibuf != 0 && ilen > 0) { munmap(ibuf, ilen); }
      ii := ii + 1;
    }
  }

  var imgIdsPtr: int64 := peek64(doc + PDF_DOC_IMAGEIDS);
  var imgWPtr:   int64 := peek64(doc + PDF_DOC_IMAGEWIDTHS);
  var imgHPtr:   int64 := peek64(doc + PDF_DOC_IMAGEHEIGHTS);
  var imgCPtr:   int64 := peek64(doc + PDF_DOC_IMAGECHANNELS);
  var pgImgPtr:  int64 := peek64(doc + PDF_DOC_PAGEIMAGEMASKS);

  if (imgIdsPtr != 0) { munmap(imgIdsPtr, imgArrSz); }
  if (imgWPtr   != 0) { munmap(imgWPtr,   imgArrSz); }
  if (imgHPtr   != 0) { munmap(imgHPtr,   imgArrSz); }
  if (imgCPtr   != 0) { munmap(imgCPtr,   imgArrSz); }
  if (imgDBufs  != 0) { munmap(imgDBufs,  imgArrSz); }
  if (imgDLens  != 0) { munmap(imgDLens,  imgArrSz); }
  if (pgImgPtr  != 0) { munmap(pgImgPtr,  pageCap * 8); }

  // Free annotation string data and buffer
  var annotCount2: int64 := peek64(doc + PDF_DOC_ANNOTCOUNT);
  var annotCap2:   int64 := peek64(doc + PDF_DOC_ANNOTCAP);
  var annotBuf2:   int64 := peek64(doc + PDF_DOC_ANNOTBUF);
  if (annotBuf2 != 0) {
    var ai2: int64 := 0;
    while (ai2 < annotCount2) {
      var arec2: int64 := annotBuf2 + ai2 * PDF_ANNOT_RECSIZE;
      var d1:    int64 := peek64(arec2 + PDF_ANNOT_DATA1);
      var d1l:   int64 := peek64(arec2 + PDF_ANNOT_DATA1LEN);
      var d2:    int64 := peek64(arec2 + PDF_ANNOT_DATA2);
      var d2l:   int64 := peek64(arec2 + PDF_ANNOT_DATA2LEN);
      if (d1 != 0 && d1l > 0) { munmap(d1, d1l); }
      if (d2 != 0 && d2l > 0) { munmap(d2, d2l); }
      ai2 := ai2 + 1;
    }
    munmap(annotBuf2, annotCap2 * PDF_ANNOT_RECSIZE);
  }

  // Free outline title strings and buffer
  var outlineCount3: int64 := peek64(doc + PDF_DOC_OUTLINECOUNT);
  var outlineCap3:   int64 := peek64(doc + PDF_DOC_OUTLINECAP);
  var outlineBuf3:   int64 := peek64(doc + PDF_DOC_OUTLINEBUF);
  if (outlineBuf3 != 0) {
    var oi3: int64 := 0;
    while (oi3 < outlineCount3) {
      var orec3:   int64 := outlineBuf3 + oi3 * PDF_OUTLINE_RECSIZE;
      var titBuf3: int64 := peek64(orec3 + PDF_OUTLINE_TITLEBUF);
      var titLen3: int64 := peek64(orec3 + PDF_OUTLINE_TITLELEN);
      if (titBuf3 != 0 && titLen3 > 0) { munmap(titBuf3, titLen3); }
      oi3 := oi3 + 1;
    }
    munmap(outlineBuf3, outlineCap3 * PDF_OUTLINE_RECSIZE);
  }

  munmap(doc, PDF_DOC_SIZE);
}

// ============================================================================
// Outline tree helpers (WP-PDF-10)
// ============================================================================

fn _outlineCountChildren(buf: int64, count: int64, parent: int64): int64 {
  var n: int64 := 0;
  var j: int64 := 0;
  while (j < count) {
    if (peek64(buf + j * PDF_OUTLINE_RECSIZE + PDF_OUTLINE_PARENT) == parent) { n := n + 1; }
    j := j + 1;
  }
  return n;
}

fn _outlineFirstChild(buf: int64, count: int64, parent: int64): int64 {
  var j: int64 := 0;
  while (j < count) {
    if (peek64(buf + j * PDF_OUTLINE_RECSIZE + PDF_OUTLINE_PARENT) == parent) { return j; }
    j := j + 1;
  }
  return -1;
}

fn _outlineLastChild(buf: int64, count: int64, parent: int64): int64 {
  var last: int64 := -1;
  var j: int64 := 0;
  while (j < count) {
    if (peek64(buf + j * PDF_OUTLINE_RECSIZE + PDF_OUTLINE_PARENT) == parent) { last := j; }
    j := j + 1;
  }
  return last;
}

fn _outlineNextSibling(buf: int64, count: int64, i: int64): int64 {
  var pi: int64 := peek64(buf + i * PDF_OUTLINE_RECSIZE + PDF_OUTLINE_PARENT);
  var j: int64 := i + 1;
  while (j < count) {
    if (peek64(buf + j * PDF_OUTLINE_RECSIZE + PDF_OUTLINE_PARENT) == pi) { return j; }
    j := j + 1;
  }
  return -1;
}

fn _outlinePrevSibling(buf: int64, count: int64, i: int64): int64 {
  var pi: int64 := peek64(buf + i * PDF_OUTLINE_RECSIZE + PDF_OUTLINE_PARENT);
  var j: int64 := i - 1;
  while (j >= 0) {
    if (peek64(buf + j * PDF_OUTLINE_RECSIZE + PDF_OUTLINE_PARENT) == pi) { return j; }
    j := j - 1;
  }
  return -1;
}

// Write /Count, /First, /Last, /Next, /Prev for outline item oi. Returns new pos.
fn _pdfWriteOutlineLinks(out: int64, pos: int64, buf: int64, count: int64, oi: int64, rootId: int64): int64 {
  var nch: int64 := _outlineCountChildren(buf, count, oi);
  pos := pdfStr(out, pos, " /Count ");
  pos := pdfInt(out, pos, nch);
  if (nch > 0) {
    var fc: int64 := _outlineFirstChild(buf, count, oi);
    pos := pdfStr(out, pos, " /First ");
    pos := pdfRef(out, pos, rootId + 1 + fc);
    var lc: int64 := _outlineLastChild(buf, count, oi);
    pos := pdfStr(out, pos, " /Last ");
    pos := pdfRef(out, pos, rootId + 1 + lc);
  }
  var ns: int64 := _outlineNextSibling(buf, count, oi);
  if (ns >= 0) {
    pos := pdfStr(out, pos, " /Next ");
    pos := pdfRef(out, pos, rootId + 1 + ns);
  }
  var ps: int64 := _outlinePrevSibling(buf, count, oi);
  if (ps >= 0) {
    pos := pdfStr(out, pos, " /Prev ");
    pos := pdfRef(out, pos, rootId + 1 + ps);
  }
  return pos;
}

// Write the /Outlines root object. Returns new pos.
fn _pdfWriteOutlineRoot(out: int64, pos: int64, xrefs: int64, buf: int64, count: int64, rootId: int64): int64 {
  poke64(xrefs + rootId * 8, pos);
  pos := pdfObjHdr(out, pos, rootId);
  pos := pdfStr(out, pos, "<< /Type /Outlines /Count ");
  pos := pdfInt(out, pos, _outlineCountChildren(buf, count, -1));
  var fc: int64 := _outlineFirstChild(buf, count, -1);
  if (fc >= 0) {
    pos := pdfStr(out, pos, " /First ");
    pos := pdfRef(out, pos, rootId + 1 + fc);
    var lc: int64 := _outlineLastChild(buf, count, -1);
    pos := pdfStr(out, pos, " /Last ");
    pos := pdfRef(out, pos, rootId + 1 + lc);
  }
  pos := pdfStr(out, pos, " >>");
  pos := pdfObjFtr(out, pos);
  return pos;
}

// ============================================================================
// PdfSetCompression, PdfPageCount
// ============================================================================

pub fn PdfSetCompression(doc: int64, level: int64): void {
  if (doc == 0) { return; }
  poke64(doc + PDF_DOC_COMPRESSION, level);
}

pub fn PdfPageCount(doc: int64): int64 {
  if (doc == 0) { return 0; }
  return peek64(doc + PDF_DOC_PAGECOUNT);
}

// ============================================================================
// Content stream management (used by WP-PDF-03+)
// ============================================================================

pub fn PdfContentEnsure(doc: int64, pageIdx: int64, needed: int64): int64 {
  var contentBufs: int64 := peek64(doc + PDF_DOC_CONTENTBUFS);
  var contentLens: int64 := peek64(doc + PDF_DOC_CONTENTLENS);
  var contentCaps: int64 := peek64(doc + PDF_DOC_CONTENTCAPS);

  var buf: int64 := arrGet(contentBufs, pageIdx);
  var len: int64 := arrGet(contentLens, pageIdx);
  var cap: int64 := arrGet(contentCaps, pageIdx);

  if (len + needed <= cap) { return 1; }

  var newCap: int64 := cap * 2;
  if (newCap < len + needed) { newCap := len + needed; }
  if (newCap < 4096) { newCap := 4096; }

  var newBuf: int64 := mmapAlloc(newCap);
  if (newBuf == 0) { return 0; }
  zeroMem(newBuf, newCap);

  var i: int64 := 0;
  while (i < len) {
    poke8(newBuf + i, peek8(buf + i));
    i := i + 1;
  }

  if (buf != 0 && cap > 0) { munmap(buf, cap); }

  arrSet(contentBufs, pageIdx, newBuf);
  arrSet(contentCaps, pageIdx, newCap);
  return 1;
}

pub fn PdfContentAppendStr(doc: int64, pageIdx: int64, s: pchar): int64 {
  var slen: int64 := StrLen(s);
  if (slen == 0) { return 0; }
  if (PdfContentEnsure(doc, pageIdx, slen) == 0) { return 0; }

  var contentBufs: int64 := peek64(doc + PDF_DOC_CONTENTBUFS);
  var contentLens: int64 := peek64(doc + PDF_DOC_CONTENTLENS);
  var buf: int64 := arrGet(contentBufs, pageIdx);
  var pos: int64 := arrGet(contentLens, pageIdx);

  var i: int64 := 0;
  while (i < slen) {
    poke8(buf + pos + i, StrCharAt(s, i));
    i := i + 1;
  }

  arrSet(contentLens, pageIdx, pos + slen);
  return slen;
}

pub fn PdfContentAppendBytes(doc: int64, pageIdx: int64, data: int64, len: int64): int64 {
  if (len == 0) { return 0; }
  if (PdfContentEnsure(doc, pageIdx, len) == 0) { return 0; }

  var contentBufs: int64 := peek64(doc + PDF_DOC_CONTENTBUFS);
  var contentLens: int64 := peek64(doc + PDF_DOC_CONTENTLENS);
  var buf: int64 := arrGet(contentBufs, pageIdx);
  var pos: int64 := arrGet(contentLens, pageIdx);

  var i: int64 := 0;
  while (i < len) {
    poke8(buf + pos + i, peek8(data + i));
    i := i + 1;
  }

  arrSet(contentLens, pageIdx, pos + len);
  return len;
}

// Emit one /Info field: " /Key (escaped-value)" to the output buffer.
// src is the raw address of the NUL-terminated string in the doc block.
// Returns new pos; no-ops (returns pos unchanged) if the field is empty.
fn _pdfMetaField(out: int64, pos: int64, key: pchar, src: int64, maxLen: int64): int64 {
  if (peek8(src) == 0) { return pos; }
  pos := pdfStr(out, pos, key);
  poke8(out + pos, 40); pos := pos + 1;   // '('
  var i: int64 := 0;
  while (i < maxLen) {
    var c: int64 := peek8(src + i);
    if (c == 0) { break; }
    if (c == 40 || c == 41 || c == 92) { poke8(out + pos, 92); pos := pos + 1; }
    poke8(out + pos, c); pos := pos + 1;
    i := i + 1;
  }
  poke8(out + pos, 41); pos := pos + 1;   // ')'
  return pos;
}

// Write (escaped PDF literal string) from a NUL-terminated raw buffer.
fn _pdfEscStr(out: int64, pos: int64, src: int64): int64 {
  poke8(out + pos, 40); pos := pos + 1;
  var i: int64 := 0;
  while (1 == 1) {
    var c: int64 := peek8(src + i);
    if (c == 0) { break; }
    if (c == 40 || c == 41 || c == 92) { poke8(out + pos, 92); pos := pos + 1; }
    poke8(out + pos, c); pos := pos + 1;
    i := i + 1;
  }
  poke8(out + pos, 41); pos := pos + 1;
  return pos;
}

// ============================================================================
// PdfSave — serialize document to a PDF file
// Returns: 0 on success, negative on error
// ============================================================================

pub fn PdfSave(doc: int64, path: pchar): int64 {
  if (doc == 0) { return -1; }

  var pageCount:   int64 := peek64(doc + PDF_DOC_PAGECOUNT);
  var nextId:      int64 := peek64(doc + PDF_DOC_NEXTID);
  var pageIds:     int64 := peek64(doc + PDF_DOC_PAGEIDS);
  var contentIds:  int64 := peek64(doc + PDF_DOC_CONTENTIDS);
  var widths100:   int64 := peek64(doc + PDF_DOC_WIDTHS100);
  var heights100:  int64 := peek64(doc + PDF_DOC_HEIGHTS100);
  var contentBufs: int64 := peek64(doc + PDF_DOC_CONTENTBUFS);
  var contentLens: int64 := peek64(doc + PDF_DOC_CONTENTLENS);

  // Allocate output buffer (4 MB)
  var out: int64 := mmapAlloc(PDF_OUT_BUF_SIZE);
  if (out == 0) { return -2; }

  // Determine whether to write a /Info dict (metadata present?)
  var hasInfo: int64 := 0;
  if (peek8(doc + PDF_DOC_META_TITLE)    != 0 || peek8(doc + PDF_DOC_META_AUTHOR)   != 0 ||
      peek8(doc + PDF_DOC_META_SUBJECT)  != 0 || peek8(doc + PDF_DOC_META_KEYWORDS) != 0 ||
      peek8(doc + PDF_DOC_META_CREATOR)  != 0 || peek8(doc + PDF_DOC_META_PRODUCER) != 0) {
    hasInfo := 1;
  }
  var infoId: int64 := nextId;  // object ID for /Info dict (only when hasInfo != 0)

  var annotCount: int64 := peek64(doc + PDF_DOC_ANNOTCOUNT);
  var annotBuf:   int64 := peek64(doc + PDF_DOC_ANNOTBUF);
  var firstAnnotId: int64 := nextId + hasInfo;  // first annotation object ID

  var outlineCount:    int64 := peek64(doc + PDF_DOC_OUTLINECOUNT);
  var outlineBuf:      int64 := peek64(doc + PDF_DOC_OUTLINEBUF);
  var outlineObjCount: int64 := 0;
  if (outlineCount > 0) { outlineObjCount := outlineCount + 1; }
  var outlineRootId:   int64 := nextId + hasInfo + annotCount;

  // Allocate XRef offset table
  var xrefSize: int64 := (nextId + hasInfo + annotCount + outlineObjCount) * 8;
  var xrefs: int64 := mmapAlloc(xrefSize);
  if (xrefs == 0) {
    munmap(out, PDF_OUT_BUF_SIZE);
    return -3;
  }
  zeroMem(xrefs, xrefSize);

  var pos: int64 := 0;

  // --- PDF header ---
  pos := pdfStr(out, pos, "%PDF-1.4\n");
  poke8(out + pos, 37);   pos := pos + 1;
  poke8(out + pos, 0xE2); pos := pos + 1;
  poke8(out + pos, 0xE3); pos := pos + 1;
  poke8(out + pos, 0xCF); pos := pos + 1;
  poke8(out + pos, 0xD3); pos := pos + 1;
  poke8(out + pos, 10);   pos := pos + 1;

  // --- Object 1: Catalog ---
  poke64(xrefs + 1 * 8, pos);
  pos := pdfStr(out, pos, "1 0 obj\n<< /Type /Catalog /Pages 2 0 R");
  if (outlineCount > 0) {
    pos := pdfStr(out, pos, " /Outlines ");
    pos := pdfRef(out, pos, outlineRootId);
  }
  pos := pdfStr(out, pos, " >>\nendobj\n");

  // --- Object 2: Pages ---
  poke64(xrefs + 2 * 8, pos);
  pos := pdfStr(out, pos, "2 0 obj\n<< /Type /Pages /Kids [");
  var i: int64 := 0;
  while (i < pageCount) {
    if (i > 0) { poke8(out + pos, 32); pos := pos + 1; }
    pos := pdfRef(out, pos, arrGet(pageIds, i));
    i := i + 1;
  }
  pos := pdfStr(out, pos, "] /Count ");
  pos := pdfInt(out, pos, pageCount);
  pos := pdfStr(out, pos, " >>\nendobj\n");

  // --- Font objects (Standard-14, one per registered font) ---
  var fontIdBase: int64 := doc + PDF_DOC_FONTIDS;
  var fi: int64 := 0;
  while (fi < 14) {
    var foid: int64 := peek64(fontIdBase + fi * 8);
    if (foid != 0) {
      poke64(xrefs + foid * 8, pos);
      pos := pdfObjHdr(out, pos, foid);
      pos := pdfStr(out, pos, "<< /Type /Font /Subtype /Type1 /BaseFont /");
      pos := pdfStr(out, pos, pdfFontName(fi));
      pos := pdfStr(out, pos, " >>");
      pos := pdfObjFtr(out, pos);
    }
    fi := fi + 1;
  }

  // --- Image XObject objects ---
  var imageCount:    int64 := peek64(doc + PDF_DOC_IMAGECOUNT);
  var imageIds:      int64 := peek64(doc + PDF_DOC_IMAGEIDS);
  var imageWidths:   int64 := peek64(doc + PDF_DOC_IMAGEWIDTHS);
  var imageHeights:  int64 := peek64(doc + PDF_DOC_IMAGEHEIGHTS);
  var imageChannels: int64 := peek64(doc + PDF_DOC_IMAGECHANNELS);
  var imageDataBufs: int64 := peek64(doc + PDF_DOC_IMAGEDATABUFS);
  var imageDataLens: int64 := peek64(doc + PDF_DOC_IMAGEDATALENS);

  var imgIdx: int64 := 0;
  while (imgIdx < imageCount) {
    var imgId:  int64 := arrGet(imageIds,      imgIdx);
    var imgW:   int64 := arrGet(imageWidths,   imgIdx);
    var imgH:   int64 := arrGet(imageHeights,  imgIdx);
    var imgC:   int64 := arrGet(imageChannels, imgIdx);
    var imgBuf: int64 := arrGet(imageDataBufs, imgIdx);
    var imgLen: int64 := arrGet(imageDataLens, imgIdx);

    poke64(xrefs + imgId * 8, pos);
    pos := pdfObjHdr(out, pos, imgId);
    pos := pdfStr(out, pos, "<< /Type /XObject /Subtype /Image /Width ");
    pos := pdfInt(out, pos, imgW);
    pos := pdfStr(out, pos, " /Height ");
    pos := pdfInt(out, pos, imgH);
    if (imgC == 1) {
      pos := pdfStr(out, pos, " /ColorSpace /DeviceGray");
    } else {
      pos := pdfStr(out, pos, " /ColorSpace /DeviceRGB");
    }
    pos := pdfStr(out, pos, " /BitsPerComponent 8 /Filter /FlateDecode /Length ");
    pos := pdfInt(out, pos, imgLen);
    pos := pdfStr(out, pos, " >>\nstream\n");
    pos := pdfBytes(out, pos, imgBuf, imgLen);
    pos := pdfStr(out, pos, "\nendstream");
    pos := pdfObjFtr(out, pos);

    imgIdx := imgIdx + 1;
  }

  // --- Per-page objects ---
  var compression: int64 := peek64(doc + PDF_DOC_COMPRESSION);
  i := 0;
  while (i < pageCount) {
    var pageId:    int64 := arrGet(pageIds,    i);
    var contentId: int64 := arrGet(contentIds, i);
    var w100:      int64 := arrGet(widths100,  i);
    var h100:      int64 := arrGet(heights100, i);
    var cbuf:      int64 := arrGet(contentBufs, i);
    var clen:      int64 := arrGet(contentLens, i);
    var fontMask:  int64 := peek64(doc + PDF_DOC_PAGEFONTMASK + i * 8);

    // Page dictionary
    poke64(xrefs + pageId * 8, pos);
    pos := pdfObjHdr(out, pos, pageId);
    pos := pdfStr(out, pos, "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ");
    pos := pdfReal100(out, pos, w100);
    poke8(out + pos, 32); pos := pos + 1;
    pos := pdfReal100(out, pos, h100);
    pos := pdfStr(out, pos, "] /Resources << /Font <<");
    // Emit font resource entries for fonts used on this page
    var fj: int64 := 0;
    while (fj < 14) {
      if ((fontMask >> fj) & 1 != 0) {
        var foid2: int64 := peek64(fontIdBase + fj * 8);
        pos := pdfStr(out, pos, " /F");
        pos := pdfInt(out, pos, fj);
        poke8(out + pos, 32); pos := pos + 1;
        pos := pdfRef(out, pos, foid2);
      }
      fj := fj + 1;
    }
    pos := pdfStr(out, pos, " >>");
    // /XObject resource: one entry per image used on this page
    var imgMask: int64 := arrGet(peek64(doc + PDF_DOC_PAGEIMAGEMASKS), i);
    if (imgMask != 0) {
      pos := pdfStr(out, pos, " /XObject <<");
      var ij: int64 := 0;
      while (ij < imageCount) {
        if ((imgMask >> ij) & 1 != 0) {
          pos := pdfStr(out, pos, " /Im");
          pos := pdfInt(out, pos, ij);
          poke8(out + pos, 32); pos := pos + 1;
          pos := pdfRef(out, pos, arrGet(imageIds, ij));
        }
        ij := ij + 1;
      }
      pos := pdfStr(out, pos, " >>");
    }
    pos := pdfStr(out, pos, " >> /Contents ");
    pos := pdfRef(out, pos, contentId);
    // /Annots array for annotations on this page
    var hasAnnotsOnPage: int64 := 0;
    var ak0: int64 := 0;
    while (ak0 < annotCount) {
      if (peek64(annotBuf + ak0 * PDF_ANNOT_RECSIZE + PDF_ANNOT_PAGE) == i) {
        hasAnnotsOnPage := 1;
        break;
      }
      ak0 := ak0 + 1;
    }
    if (hasAnnotsOnPage != 0) {
      pos := pdfStr(out, pos, " /Annots [");
      var ak1: int64 := 0;
      while (ak1 < annotCount) {
        if (peek64(annotBuf + ak1 * PDF_ANNOT_RECSIZE + PDF_ANNOT_PAGE) == i) {
          pos := pdfRef(out, pos, firstAnnotId + ak1);
          poke8(out + pos, 32); pos := pos + 1;
        }
        ak1 := ak1 + 1;
      }
      pos := pdfStr(out, pos, "]");
    }
    pos := pdfStr(out, pos, " >>");
    pos := pdfObjFtr(out, pos);

    // Content stream
    poke64(xrefs + contentId * 8, pos);
    pos := pdfObjHdr(out, pos, contentId);
    var emitted: int64 := 0;
    if (compression > 0 && clen > 0) {
      var maxOut: int64 := zlibMaxOutputSize(clen);
      var czbuf:  int64 := mmapAlloc(maxOut);
      if (czbuf != 0) {
        var czlen: int64 := zlibCompress(cbuf, clen, czbuf);
        if (czlen > 0) {
          pos := pdfStr(out, pos, "<< /Length ");
          pos := pdfInt(out, pos, czlen);
          pos := pdfStr(out, pos, " /Filter /FlateDecode >>\nstream\n");
          pos := pdfBytes(out, pos, czbuf, czlen);
          pos := pdfStr(out, pos, "\nendstream");
          pos := pdfObjFtr(out, pos);
          emitted := 1;
        }
        munmap(czbuf, maxOut);
      }
    }
    if (emitted == 0) {
      pos := pdfStr(out, pos, "<< /Length ");
      pos := pdfInt(out, pos, clen);
      pos := pdfStr(out, pos, " >>\nstream\n");
      if (clen > 0) {
        pos := pdfBytes(out, pos, cbuf, clen);
      }
      pos := pdfStr(out, pos, "endstream");
      pos := pdfObjFtr(out, pos);
    }

    i := i + 1;
  }

  // --- Info dictionary (optional) ---
  if (hasInfo != 0) {
    poke64(xrefs + infoId * 8, pos);
    pos := pdfObjHdr(out, pos, infoId);
    pos := pdfStr(out, pos, "<<");
    pos := _pdfMetaField(out, pos, " /Title ",    doc + PDF_DOC_META_TITLE,    256);
    pos := _pdfMetaField(out, pos, " /Author ",   doc + PDF_DOC_META_AUTHOR,   256);
    pos := _pdfMetaField(out, pos, " /Subject ",  doc + PDF_DOC_META_SUBJECT,  256);
    pos := _pdfMetaField(out, pos, " /Keywords ", doc + PDF_DOC_META_KEYWORDS, 256);
    pos := _pdfMetaField(out, pos, " /Creator ",  doc + PDF_DOC_META_CREATOR,  128);
    pos := _pdfMetaField(out, pos, " /Producer ", doc + PDF_DOC_META_PRODUCER, 128);
    pos := pdfStr(out, pos, " >>");
    pos := pdfObjFtr(out, pos);
  }

  // --- Annotation objects ---
  var ann: int64 := 0;
  while (ann < annotCount) {
    var arec:   int64 := annotBuf + ann * PDF_ANNOT_RECSIZE;
    var atype:  int64 := peek64(arec + PDF_ANNOT_TYPE);
    var ax1:    int64 := peek64(arec + PDF_ANNOT_X1_100);
    var ay1:    int64 := peek64(arec + PDF_ANNOT_Y1_100);
    var ax2:    int64 := peek64(arec + PDF_ANNOT_X2_100);
    var ay2:    int64 := peek64(arec + PDF_ANNOT_Y2_100);
    var adata1: int64 := peek64(arec + PDF_ANNOT_DATA1);
    var adata2: int64 := peek64(arec + PDF_ANNOT_DATA2);
    var aextra: int64 := peek64(arec + PDF_ANNOT_EXTRA);
    var annotId: int64 := firstAnnotId + ann;

    poke64(xrefs + annotId * 8, pos);
    pos := pdfObjHdr(out, pos, annotId);
    pos := pdfStr(out, pos, "<< /Type /Annot");

    if (atype == 1) {
      pos := pdfStr(out, pos, " /Subtype /Link /Rect [");
      pos := pdfReal100(out, pos, ax1);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ay1);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ax2);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ay2);
      pos := pdfStr(out, pos, "] /Border [0 0 0] /A << /S /URI /URI ");
      if (adata1 != 0) {
        pos := _pdfEscStr(out, pos, adata1);
      } else {
        pos := pdfStr(out, pos, "()");
      }
      pos := pdfStr(out, pos, " >>");
    } else if (atype == 2) {
      pos := pdfStr(out, pos, " /Subtype /Text /Rect [");
      pos := pdfReal100(out, pos, ax1);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ay1);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ax2);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ay2);
      pos := pdfStr(out, pos, "] /Open false");
      if (adata2 != 0) {
        pos := pdfStr(out, pos, " /T ");
        pos := _pdfEscStr(out, pos, adata2);
      }
      if (adata1 != 0) {
        pos := pdfStr(out, pos, " /Contents ");
        pos := _pdfEscStr(out, pos, adata1);
      }
    } else if (atype == 3) {
      pos := pdfStr(out, pos, " /Subtype /Link /Rect [");
      pos := pdfReal100(out, pos, ax1);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ay1);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ax2);
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, ay2);
      pos := pdfStr(out, pos, "] /Border [0 0 0] /Dest [");
      pos := pdfRef(out, pos, arrGet(pageIds, aextra));
      pos := pdfStr(out, pos, " /XYZ null null null]");
    }

    pos := pdfStr(out, pos, " >>");
    pos := pdfObjFtr(out, pos);
    ann := ann + 1;
  }

  // --- Outline objects ---
  if (outlineCount > 0) {
    pos := _pdfWriteOutlineRoot(out, pos, xrefs, outlineBuf, outlineCount, outlineRootId);
    var oi: int64 := 0;
    while (oi < outlineCount) {
      var orec: int64 := outlineBuf + oi * PDF_OUTLINE_RECSIZE;
      poke64(xrefs + (outlineRootId + 1 + oi) * 8, pos);
      pos := pdfObjHdr(out, pos, outlineRootId + 1 + oi);
      pos := pdfStr(out, pos, "<< /Title ");
      pos := _pdfEscStr(out, pos, peek64(orec + PDF_OUTLINE_TITLEBUF));
      pos := pdfStr(out, pos, " /Parent ");
      if (peek64(orec + PDF_OUTLINE_PARENT) < 0) {
        pos := pdfRef(out, pos, outlineRootId);
      } else {
        pos := pdfRef(out, pos, outlineRootId + 1 + peek64(orec + PDF_OUTLINE_PARENT));
      }
      pos := pdfStr(out, pos, " /Dest [");
      pos := pdfRef(out, pos, arrGet(pageIds, peek64(orec + PDF_OUTLINE_DESTPAGE)));
      pos := pdfStr(out, pos, " /XYZ null null null]");
      pos := _pdfWriteOutlineLinks(out, pos, outlineBuf, outlineCount, oi, outlineRootId);
      pos := pdfStr(out, pos, " >>");
      pos := pdfObjFtr(out, pos);
      oi := oi + 1;
    }
  }

  // --- XRef section ---
  var xrefStart: int64 := pos;
  var xrefCount: int64 := nextId + hasInfo + annotCount + outlineObjCount;

  pos := pdfStr(out, pos, "xref\n0 ");
  pos := pdfInt(out, pos, xrefCount);
  poke8(out + pos, 10); pos := pos + 1;

  // Free entry for object 0
  pos := pdfXrefEntry(out, pos, 0, 65535, true);

  // In-use entries for objects 1..xrefCount-1
  var id: int64 := 1;
  while (id < xrefCount) {
    var off: int64 := peek64(xrefs + id * 8);
    pos := pdfXrefEntry(out, pos, off, 0, false);
    id := id + 1;
  }

  // --- Trailer ---
  pos := pdfStr(out, pos, "trailer\n<< /Size ");
  pos := pdfInt(out, pos, xrefCount);
  pos := pdfStr(out, pos, " /Root 1 0 R");
  if (hasInfo != 0) {
    pos := pdfStr(out, pos, " /Info ");
    pos := pdfRef(out, pos, infoId);
  }
  pos := pdfStr(out, pos, " >>\nstartxref\n");
  pos := pdfInt(out, pos, xrefStart);
  pos := pdfStr(out, pos, "\n%%EOF\n");

  // --- Write to file ---
  var fd: int64 := open(path, 577, 420);
  if (fd < 0) {
    munmap(xrefs, xrefSize);
    munmap(out, PDF_OUT_BUF_SIZE);
    return -4;
  }

  var written: int64 := write(fd, out, pos);
  close(fd);

  munmap(xrefs, xrefSize);
  munmap(out, PDF_OUT_BUF_SIZE);

  if (written != pos) { return -5; }
  return 0;
}
