// WP-PDF-17: RC4-128 encryption (Standard Security Handler, V=2, R=3)
// ============================================================================

// MD5 round-constant table: 64 × uint32 stored as int64 in a mmap'd buffer.
fn _md5FillK(k: int64): void {
  poke64(k,    0xD76AA478); poke64(k+8,   0xE8C7B756); poke64(k+16,  0x242070DB); poke64(k+24,  0xC1BDCEEE);
  poke64(k+32, 0xF57C0FAF); poke64(k+40,  0x4787C62A); poke64(k+48,  0xA8304613); poke64(k+56,  0xFD469501);
  poke64(k+64, 0x698098D8); poke64(k+72,  0x8B44F7AF); poke64(k+80,  0xFFFF5BB1); poke64(k+88,  0x895CD7BE);
  poke64(k+96, 0x6B901122); poke64(k+104, 0xFD987193); poke64(k+112, 0xA679438E); poke64(k+120, 0x49B40821);
  poke64(k+128,0xF61E2562); poke64(k+136, 0xC040B340); poke64(k+144, 0x265E5A51); poke64(k+152, 0xE9B6C7AA);
  poke64(k+160,0xD62F105D); poke64(k+168, 0x02441453); poke64(k+176, 0xD8A1E681); poke64(k+184, 0xE7D3FBC8);
  poke64(k+192,0x21E1CDE6); poke64(k+200, 0xC33707D6); poke64(k+208, 0xF4D50D87); poke64(k+216, 0x455A14ED);
  poke64(k+224,0xA9E3E905); poke64(k+232, 0xFCEFA3F8); poke64(k+240, 0x676F02D9); poke64(k+248, 0x8D2A4C8A);
  poke64(k+256,0xFFFA3942); poke64(k+264, 0x8771F681); poke64(k+272, 0x6D9D6122); poke64(k+280, 0xFDE5380C);
  poke64(k+288,0xA4BEEA44); poke64(k+296, 0x4BDECFA9); poke64(k+304, 0xF6BB4B60); poke64(k+312, 0xBEBFBC70);
  poke64(k+320,0x289B7EC6); poke64(k+328, 0xEAA127FA); poke64(k+336, 0xD4EF3085); poke64(k+344, 0x04881D05);
  poke64(k+352,0xD9D4D039); poke64(k+360, 0xE6DB99E5); poke64(k+368, 0x1FA27CF8); poke64(k+376, 0xC4AC5665);
  poke64(k+384,0xF4292244); poke64(k+392, 0x432AFF97); poke64(k+400, 0xAB9423A7); poke64(k+408, 0xFC93A039);
  poke64(k+416,0x655B59C3); poke64(k+424, 0x8F0CCC92); poke64(k+432, 0xFFEFF47D); poke64(k+440, 0x85845DD1);
  poke64(k+448,0x6FA87E4F); poke64(k+456, 0xFE2CE6E0); poke64(k+464, 0xA3014314); poke64(k+472, 0x4E0811A1);
  poke64(k+480,0xF7537E82); poke64(k+488, 0xBD3AF235); poke64(k+496, 0x2AD7D2BB); poke64(k+504, 0xEB86D391);
}

// Process one 64-byte MD5 block. state = 4×int64 (a,b,c,d). kbuf = 64 K constants.
fn _md5Block(state: int64, block: int64, kbuf: int64): void {
  var a: int64 := peek64(state);
  var b: int64 := peek64(state + 8);
  var c: int64 := peek64(state + 16);
  var d: int64 := peek64(state + 24);
  var i: int64 := 0;
  while (i < 64) {
    var f: int64 := 0;  var g: int64 := 0;  var s: int64 := 0;
    var si: int64 := i & 3;
    if (i < 16) {
      f := (b & c) | ((~b) & 0xFFFFFFFF & d);
      g := i;
      if (si==0){s:=7;}else if(si==1){s:=12;}else if(si==2){s:=17;}else{s:=22;}
    } else if (i < 32) {
      f := (d & b) | ((~d) & 0xFFFFFFFF & c);
      g := (5 * i + 1) & 15;
      if (si==0){s:=5;}else if(si==1){s:=9;}else if(si==2){s:=14;}else{s:=20;}
    } else if (i < 48) {
      f := b ^ c ^ d;
      g := (3 * i + 5) & 15;
      if (si==0){s:=4;}else if(si==1){s:=11;}else if(si==2){s:=16;}else{s:=23;}
    } else {
      f := c ^ (b | ((~d) & 0xFFFFFFFF));
      g := (7 * i) & 15;
      if (si==0){s:=6;}else if(si==1){s:=10;}else if(si==2){s:=15;}else{s:=21;}
    }
    var wg: int64 := ( peek8(block+g*4) | (peek8(block+g*4+1)<<8) |
                       (peek8(block+g*4+2)<<16) | (peek8(block+g*4+3)<<24) ) & 0xFFFFFFFF;
    var tmp: int64 := (f + a + peek64(kbuf + i*8) + wg) & 0xFFFFFFFF;
    tmp := ((tmp << s) | ((tmp & 0xFFFFFFFF) >> (32 - s))) & 0xFFFFFFFF;
    a := d;  d := c;  c := b;
    b := (b + tmp) & 0xFFFFFFFF;
    i := i + 1;
  }
  poke64(state,      (peek64(state)      + a) & 0xFFFFFFFF);
  poke64(state + 8,  (peek64(state + 8)  + b) & 0xFFFFFFFF);
  poke64(state + 16, (peek64(state + 16) + c) & 0xFFFFFFFF);
  poke64(state + 24, (peek64(state + 24) + d) & 0xFFFFFFFF);
}

// Compute MD5(data, len) → 16 bytes at output.
fn _md5(data: int64, len: int64, output: int64): void {
  var state: int64 := mmap(0, 32,  3, 34, -1, 0);
  var kbuf:  int64 := mmap(0, 512, 3, 34, -1, 0);
  var pbuf:  int64 := mmap(0, 128, 3, 34, -1, 0);
  if (state == 0 || kbuf == 0 || pbuf == 0) {
    if (state != 0) { munmap(state, 32); }
    if (kbuf  != 0) { munmap(kbuf,  512); }
    if (pbuf  != 0) { munmap(pbuf,  128); }
    return;
  }
  // Init state: a b c d
  poke64(state,      0x67452301);
  poke64(state + 8,  0xEFCDAB89);
  poke64(state + 16, 0x98BADCFE);
  poke64(state + 24, 0x10325476);
  _md5FillK(kbuf);
  // Process full 64-byte blocks
  var off: int64 := 0;
  while (off + 64 <= len) {
    _md5Block(state, data + off, kbuf);
    off := off + 64;
  }
  // Build padding block(s)
  var rem: int64 := len - off;
  var pi: int64 := 0;
  while (pi < rem) { poke8(pbuf + pi, peek8(data + off + pi)); pi := pi + 1; }
  poke8(pbuf + rem, 0x80);
  var fillTo: int64 := 56;
  if (rem >= 56) { fillTo := 120; }
  pi := rem + 1;
  while (pi < fillTo) { poke8(pbuf + pi, 0); pi := pi + 1; }
  // Length in bits, little-endian 64-bit
  var bits: int64 := len * 8;
  poke8(pbuf+fillTo,   bits        & 0xFF);
  poke8(pbuf+fillTo+1, (bits >>  8) & 0xFF);
  poke8(pbuf+fillTo+2, (bits >> 16) & 0xFF);
  poke8(pbuf+fillTo+3, (bits >> 24) & 0xFF);
  poke8(pbuf+fillTo+4, (bits >> 32) & 0xFF);
  poke8(pbuf+fillTo+5, (bits >> 40) & 0xFF);
  poke8(pbuf+fillTo+6, (bits >> 48) & 0xFF);
  poke8(pbuf+fillTo+7, (bits >> 56) & 0xFF);
  _md5Block(state, pbuf, kbuf);
  if (fillTo == 120) { _md5Block(state, pbuf + 64, kbuf); }
  // Output: 4 words in LE order
  var wi: int64 := 0;
  while (wi < 4) {
    var w: int64 := peek64(state + wi * 8);
    poke8(output + wi*4,   w        & 0xFF);
    poke8(output + wi*4+1, (w >> 8)  & 0xFF);
    poke8(output + wi*4+2, (w >> 16) & 0xFF);
    poke8(output + wi*4+3, (w >> 24) & 0xFF);
    wi := wi + 1;
  }
  munmap(state, 32);  munmap(kbuf, 512);  munmap(pbuf, 128);
}

// RC4 Key-Scheduling Algorithm. state: 256-byte buffer, key: keyLen bytes.
fn _rc4Init(state: int64, key: int64, keyLen: int64): void {
  var i: int64 := 0;
  while (i < 256) { poke8(state + i, i); i := i + 1; }
  var j: int64 := 0;
  i := 0;
  while (i < 256) {
    j := (j + peek8(state+i) + peek8(key + (i & (keyLen-1)))) & 0xFF;  // keyLen must be power-of-2 for & trick
    // safer: j := (j + peek8(state+i) + peek8(key + (i % keyLen))) & 0xFF; but % not available
    var tmp: int64 := peek8(state+i); poke8(state+i, peek8(state+j)); poke8(state+j, tmp);
    i := i + 1;
  }
}

// RC4 encrypt/decrypt: data in-place (or outbuf != data for separate buffers).
fn _rc4Crypt(state: int64, data: int64, len: int64): void {
  var i: int64 := 0;  var j: int64 := 0;  var k: int64 := 0;
  while (k < len) {
    i := (i + 1) & 0xFF;
    j := (j + peek8(state + i)) & 0xFF;
    var tmp: int64 := peek8(state+i); poke8(state+i, peek8(state+j)); poke8(state+j, tmp);
    var ks: int64 := peek8(state + ((peek8(state+i) + peek8(state+j)) & 0xFF));
    poke8(data + k, peek8(data + k) ^ ks);
    k := k + 1;
  }
}

// RC4 with modulo keyLen (for non-power-of-2 key lengths like 16).
fn _rc4InitMod(state: int64, key: int64, keyLen: int64): void {
  var i: int64 := 0;
  while (i < 256) { poke8(state + i, i); i := i + 1; }
  var j: int64 := 0;
  i := 0;
  while (i < 256) {
    var ki: int64 := i;
    while (ki >= keyLen) { ki := ki - keyLen; }  // ki = i % keyLen
    j := (j + peek8(state+i) + peek8(key + ki)) & 0xFF;
    var tmp: int64 := peek8(state+i); poke8(state+i, peek8(state+j)); poke8(state+j, tmp);
    i := i + 1;
  }
}

// Compute per-object RC4 key: MD5(fileKey[0..15] + objId[0..2] + {0,0}).
// Output: 16 bytes at keyOut.
fn _pdfObjKey(fileKey: int64, objId: int64, keyOut: int64): void {
  var tmp: int64 := mmap(0, 21, 3, 34, -1, 0);
  if (tmp == 0) { return; }
  var ti: int64 := 0;
  while (ti < 16) { poke8(tmp+ti, peek8(fileKey+ti)); ti:=ti+1; }
  poke8(tmp+16, objId         & 0xFF);
  poke8(tmp+17, (objId >>  8) & 0xFF);
  poke8(tmp+18, (objId >> 16) & 0xFF);
  poke8(tmp+19, 0);  poke8(tmp+20, 0);
  _md5(tmp, 21, keyOut);
  munmap(tmp, 21);
}

// Encrypt a mmap'd stream buffer in-place using RC4 with per-object key.
fn _pdfEncryptStream(doc: int64, objId: int64, buf: int64, len: int64): void {
  var fileKey: int64 := peek64(doc + PDF_DOC_ENCFKEY);
  if (fileKey == 0 || buf == 0 || len <= 0) { return; }
  var objKey:  int64 := mmap(0, 16, 3, 34, -1, 0);
  var state:   int64 := mmap(0, 256, 3, 34, -1, 0);
  if (objKey == 0 || state == 0) {
    if (objKey != 0) { munmap(objKey, 16); }
    if (state  != 0) { munmap(state,  256); }
    return;
  }
  _pdfObjKey(fileKey, objId, objKey);
  _rc4InitMod(state, objKey, 16);
  _rc4Crypt(state, buf, len);
  munmap(objKey, 16);  munmap(state, 256);
}

// Encrypt string bytes and write as hex <..> to output buffer. Returns new pos.
fn _pdfEncStr(out: int64, pos: int64, src: int64, len: int64, doc: int64, objId: int64): int64 {
  var fileKey: int64 := peek64(doc + PDF_DOC_ENCFKEY);
  if (fileKey == 0 || src == 0 || len <= 0) {
    // Fallback: write unencrypted as literal
    poke8(out+pos, 40); pos:=pos+1;
    var fi: int64 := 0;
    while (fi < len) { var fc: int64 := peek8(src+fi); if(fc==40||fc==41||fc==92){poke8(out+pos,92);pos:=pos+1;} poke8(out+pos,fc);pos:=pos+1;fi:=fi+1; }
    poke8(out+pos, 41); pos:=pos+1;
    return pos;
  }
  var objKey: int64 := mmap(0, 16, 3, 34, -1, 0);
  var enc:    int64 := mmap(0, len, 3, 34, -1, 0);
  var state:  int64 := mmap(0, 256, 3, 34, -1, 0);
  if (objKey == 0 || enc == 0 || state == 0) {
    if (objKey != 0) { munmap(objKey, 16); }
    if (enc    != 0) { munmap(enc, len); }
    if (state  != 0) { munmap(state, 256); }
    return pos;
  }
  var ci: int64 := 0;
  while (ci < len) { poke8(enc+ci, peek8(src+ci)); ci:=ci+1; }
  _pdfObjKey(fileKey, objId, objKey);
  _rc4InitMod(state, objKey, 16);
  _rc4Crypt(state, enc, len);
  poke8(out+pos, 60); pos:=pos+1;  // '<'
  var hi: int64 := 0;
  while (hi < len) {
    var hb: int64 := peek8(enc+hi);
    var hn: int64 := (hb >> 4) & 0xF;  var hl: int64 := hb & 0xF;
    if (hn < 10) { poke8(out+pos, 48+hn); } else { poke8(out+pos, 55+hn); } pos:=pos+1;
    if (hl < 10) { poke8(out+pos, 48+hl); } else { poke8(out+pos, 55+hl); } pos:=pos+1;
    hi := hi + 1;
  }
  poke8(out+pos, 62); pos:=pos+1;  // '>'
  munmap(objKey, 16);  munmap(enc, len);  munmap(state, 256);
  return pos;
}

// PDF standard password padding string (32 bytes, Algorithm 2 step 1).
fn _pdfPadPwd(src: pchar, out: int64): void {
  var pad: pchar := "\x28\xBF\x4E\x5E\x4E\x75\x8A\x41\x64\x00\x4E\x56\xFF\xFA\x01\x08\x2E\x2E\x00\xB6\xD0\x68\x3E\x80\x2F\x0C\xA9\xFE\x64\x53\x69\x7A"c;
  var srcLen: int64 := 0;
  if (src != 0) { srcLen := StrLen(src); if (srcLen > 32) { srcLen := 32; } }
  var i: int64 := 0;
  while (i < srcLen) { poke8(out+i, StrCharAt(src, i)); i:=i+1; }
  while (i < 32) { poke8(out+i, StrCharAt(pad, i-srcLen)); i:=i+1; }
}

// Compute all encryption keys and store in doc struct.
// Implements PDF Standard Security Handler R=3, V=2, 128-bit RC4.
fn _pdfPrepareEncryption(doc: int64): void {
  if (peek64(doc + PDF_DOC_ENCREADY) != 0) { return; }
  // Allocate /Encrypt dict object ID
  var encId: int64 := peek64(doc + PDF_DOC_NEXTID);
  poke64(doc + PDF_DOC_NEXTID, encId + 1);
  poke64(doc + PDF_DOC_ENCCURID, encId);
  // Allocate output buffers
  var fileKey: int64 := mmap(0, 16, 3, 34, -1, 0);
  var oKey:    int64 := mmap(0, 32, 3, 34, -1, 0);
  var uKey:    int64 := mmap(0, 32, 3, 34, -1, 0);
  var tmp:     int64 := mmap(0, 128, 3, 34, -1, 0);
  var state:   int64 := mmap(0, 256, 3, 34, -1, 0);
  if (fileKey==0||oKey==0||uKey==0||tmp==0||state==0) {
    if(fileKey!=0){munmap(fileKey,16);} if(oKey!=0){munmap(oKey,32);} if(uKey!=0){munmap(uKey,32);}
    if(tmp!=0){munmap(tmp,128);} if(state!=0){munmap(state,256);}
    return;
  }
  // --- Algorithm 3: Compute /O (owner key) ---
  var pwdBuf: int64 := mmap(0, 32, 3, 34, -1, 0);
  if (pwdBuf == 0) {
    munmap(fileKey,16);munmap(oKey,32);munmap(uKey,32);munmap(tmp,128);munmap(state,256);
    return;
  }
  // 3a: MD5(pad(ownerPassword)) × 51
  var opwd: pchar := 0;
  var opwdBuf: int64 := peek64(doc + PDF_DOC_ENCOPWD);
  // Treat ownerPassword; if none, use userPassword
  var upwdBuf: int64 := peek64(doc + PDF_DOC_ENCUPWD);
  _pdfPadPwd(0, pwdBuf);  // pad with empty owner password → use padding only
  if (opwdBuf != 0) {
    var oi: int64 := 0;
    while (oi < 32) { poke8(pwdBuf+oi, peek8(opwdBuf+oi)); oi:=oi+1; }
  } else if (upwdBuf != 0) {
    // fallback: use user password as owner password
    var oi2: int64 := 0;
    while (oi2 < 32) { poke8(pwdBuf+oi2, peek8(upwdBuf+oi2)); oi2:=oi2+1; }
  }
  _md5(pwdBuf, 32, tmp);
  // 50 additional MD5 rounds
  var ri: int64 := 0;
  while (ri < 50) { _md5(tmp, 16, tmp); ri:=ri+1; }
  // tmp[0..15] = owner RC4 key
  // 3b: RC4-encrypt padded user password with owner RC4 key
  _pdfPadPwd(0, pwdBuf);  // pad(userPassword)
  if (upwdBuf != 0) {
    var ui2: int64 := 0;
    while (ui2 < 32) { poke8(pwdBuf+ui2, peek8(upwdBuf+ui2)); ui2:=ui2+1; }
  }
  _rc4InitMod(state, tmp, 16);
  _rc4Crypt(state, pwdBuf, 32);  // oKey intermediate
  // 3c: 19 more RC4 rounds with key XOR i
  var xorKey: int64 := mmap(0, 16, 3, 34, -1, 0);
  if (xorKey != 0) {
    var step: int64 := 1;
    while (step <= 19) {
      var xi: int64 := 0;
      while (xi < 16) { poke8(xorKey+xi, peek8(tmp+xi) ^ step); xi:=xi+1; }
      _rc4InitMod(state, xorKey, 16);
      _rc4Crypt(state, pwdBuf, 32);
      step := step + 1;
    }
    munmap(xorKey, 16);
  }
  var oci: int64 := 0;
  while (oci < 32) { poke8(oKey+oci, peek8(pwdBuf+oci)); oci:=oci+1; }
  // --- Algorithm 2: Compute file encryption key ---
  // Input: pad(userPwd) + /O + P (4 bytes LE) + fileId (16 bytes zero)
  _pdfPadPwd(0, tmp);
  if (upwdBuf != 0) {
    var ui3: int64 := 0;
    while (ui3 < 32) { poke8(tmp+ui3, peek8(upwdBuf+ui3)); ui3:=ui3+1; }
  }
  var ti: int64 := 32;
  while (ti < 64) { poke8(tmp+ti, peek8(oKey+(ti-32))); ti:=ti+1; }
  var perms: int64 := peek64(doc + PDF_DOC_ENCPERMS);
  poke8(tmp+64, perms         & 0xFF);
  poke8(tmp+65, (perms >>  8) & 0xFF);
  poke8(tmp+66, (perms >> 16) & 0xFF);
  poke8(tmp+67, (perms >> 24) & 0xFF);
  // fileId: 16 zero bytes (positions 68..83)
  var zi: int64 := 68; while (zi < 84) { poke8(tmp+zi, 0); zi:=zi+1; }
  _md5(tmp, 84, fileKey);
  // 50 extra MD5 rounds
  var ri2: int64 := 0;
  while (ri2 < 50) { _md5(fileKey, 16, fileKey); ri2:=ri2+1; }
  // fileKey[0..15] = file encryption key
  // --- Algorithm 4a: Compute /U (R=3) ---
  // h = MD5(padding + fileId(16 zeros))
  var padBuf: int64 := mmap(0, 48, 3, 34, -1, 0);
  if (padBuf != 0) {
    _pdfPadPwd(0, padBuf);  // 32 bytes padding
    var pi2: int64 := 32; while (pi2 < 48) { poke8(padBuf+pi2, 0); pi2:=pi2+1; }
    _md5(padBuf, 48, tmp);   // tmp[0..15] = h
    munmap(padBuf, 48);
  }
  // RC4-encrypt h with fileKey
  _rc4InitMod(state, fileKey, 16);
  _rc4Crypt(state, tmp, 16);
  // 19 more rounds XOR
  var xk2: int64 := mmap(0, 16, 3, 34, -1, 0);
  if (xk2 != 0) {
    var step2: int64 := 1;
    while (step2 <= 19) {
      var xi2: int64 := 0;
      while (xi2 < 16) { poke8(xk2+xi2, peek8(fileKey+xi2) ^ step2); xi2:=xi2+1; }
      _rc4InitMod(state, xk2, 16);
      _rc4Crypt(state, tmp, 16);
      step2 := step2 + 1;
    }
    munmap(xk2, 16);
  }
  // /U = tmp[0..15] + 16 zero bytes
  var uki: int64 := 0;
  while (uki < 16) { poke8(uKey+uki, peek8(tmp+uki)); uki:=uki+1; }
  while (uki < 32) { poke8(uKey+uki, 0); uki:=uki+1; }
  // Store results
  poke64(doc + PDF_DOC_ENCFKEY, fileKey);
  poke64(doc + PDF_DOC_ENCOKEY, oKey);
  poke64(doc + PDF_DOC_ENCUKEY, uKey);
  poke64(doc + PDF_DOC_ENCREADY, 1);
  munmap(pwdBuf,32); munmap(tmp,128); munmap(state,256);
}

// ============================================================================
// WP-PDF-17: Public API — call before PdfSave
// ============================================================================

// Set user password (required for opening the document; max 32 bytes).
pub fn PdfSetUserPassword(doc: int64, pwd: pchar): void {
  if (doc == 0 || pwd == 0) { return; }
  var buf: int64 := peek64(doc + PDF_DOC_ENCUPWD);
  if (buf == 0) { buf := mmap(0, 32, 3, 34, -1, 0); if (buf==0){return;} poke64(doc + PDF_DOC_ENCUPWD, buf); }
  var len: int64 := StrLen(pwd); if (len > 32) { len := 32; }
  var i: int64 := 0;
  while (i < len) { poke8(buf+i, StrCharAt(pwd, i)); i:=i+1; }
  while (i < 32) { poke8(buf+i, 0); i:=i+1; }
  poke64(doc + PDF_DOC_ENCREADY, 0);  // invalidate cached keys
}

// Set owner password (required for editing rights; max 32 bytes).
pub fn PdfSetOwnerPassword(doc: int64, pwd: pchar): void {
  if (doc == 0 || pwd == 0) { return; }
  var buf: int64 := peek64(doc + PDF_DOC_ENCOPWD);
  if (buf == 0) { buf := mmap(0, 32, 3, 34, -1, 0); if (buf==0){return;} poke64(doc + PDF_DOC_ENCOPWD, buf); }
  var len: int64 := StrLen(pwd); if (len > 32) { len := 32; }
  var i: int64 := 0;
  while (i < len) { poke8(buf+i, StrCharAt(pwd, i)); i:=i+1; }
  while (i < 32) { poke8(buf+i, 0); i:=i+1; }
  poke64(doc + PDF_DOC_ENCREADY, 0);
}

// Set permission flags. OR together PDF_PERM_* constants for allowed operations.
// Default: PDF_PERM_ALL (-4 = all allowed). Restrictions take effect with user password.
pub fn PdfSetPermissions(doc: int64, flags: int64): void {
  if (doc == 0) { return; }
  // P = bits 13-32 all set (0xFFFFF000) | allowed bits 3-12 | bits 1-2 must be 0
  var p: int64 := (0xFFFFF000 | (flags & 0xFFC)) & 0xFFFFFFFC;
  poke64(doc + PDF_DOC_ENCPERMS, p);
  poke64(doc + PDF_DOC_ENCREADY, 0);
}

// Enable encryption. Only PDF_ENC_RC4_128 is implemented; others are accepted
// but degrade to RC4-128. Call PdfSetUserPassword before PdfSave.
pub fn PdfSetEncryption(doc: int64, encType: int64): void {
  if (doc == 0) { return; }
  if (encType == PDF_ENC_NONE) {
    poke64(doc + PDF_DOC_ENCTYPE,  PDF_ENC_NONE);
    poke64(doc + PDF_DOC_ENCREADY, 0);
    return;
  }
  poke64(doc + PDF_DOC_ENCTYPE, PDF_ENC_RC4_128);
  // Default permissions: all allowed
  if (peek64(doc + PDF_DOC_ENCPERMS) == 0) {
    poke64(doc + PDF_DOC_ENCPERMS, 0xFFFFFFFC & 0xFFFFFFFF);
  }
  poke64(doc + PDF_DOC_ENCREADY, 0);
}

// ============================================================================
// PdfSave — serialize document to a PDF file
// Returns: 0 on success, negative on error
// ============================================================================

pub fn PdfSave(doc: int64, path: pchar): int64 {
  if (doc == 0) { return -1; }
  // Prepare encryption keys before reading nextId (WP-PDF-17)
  if (peek64(doc + PDF_DOC_ENCTYPE) != PDF_ENC_NONE) {
    _pdfPrepareEncryption(doc);
  }

  var pageCount:   int64 := peek64(doc + PDF_DOC_PAGECOUNT);
  var nextId:      int64 := peek64(doc + PDF_DOC_NEXTID);
  var pageIds:     int64 := peek64(doc + PDF_DOC_PAGEIDS);
  var contentIds:  int64 := peek64(doc + PDF_DOC_CONTENTIDS);
  var widths100:   int64 := peek64(doc + PDF_DOC_WIDTHS100);
  var heights100:  int64 := peek64(doc + PDF_DOC_HEIGHTS100);
  var contentBufs: int64 := peek64(doc + PDF_DOC_CONTENTBUFS);
  var contentLens: int64 := peek64(doc + PDF_DOC_CONTENTLENS);

  // Allocate output buffer (4 MB)
  var out: int64 := mmapAlloc(PDF_OUT_BUF_SIZE);
  if (out == 0) { return -2; }

  // Determine whether to write a /Info dict (metadata present?)
  var hasInfo: int64 := 0;
  if (peek8(doc + PDF_DOC_META_TITLE)    != 0 || peek8(doc + PDF_DOC_META_AUTHOR)   != 0 ||
      peek8(doc + PDF_DOC_META_SUBJECT)  != 0 || peek8(doc + PDF_DOC_META_KEYWORDS) != 0 ||
      peek8(doc + PDF_DOC_META_CREATOR)  != 0 || peek8(doc + PDF_DOC_META_PRODUCER) != 0) {
    hasInfo := 1;
  }
  var infoId: int64 := nextId;  // object ID for /Info dict (only when hasInfo != 0)

  var annotCount: int64 := peek64(doc + PDF_DOC_ANNOTCOUNT);
  var annotBuf:   int64 := peek64(doc + PDF_DOC_ANNOTBUF);
  var firstAnnotId: int64 := nextId + hasInfo;  // first annotation object ID

  var outlineCount:    int64 := peek64(doc + PDF_DOC_OUTLINECOUNT);
  var outlineBuf:      int64 := peek64(doc + PDF_DOC_OUTLINEBUF);
  var outlineObjCount: int64 := 0;
  if (outlineCount > 0) { outlineObjCount := outlineCount + 1; }
  var outlineRootId:   int64 := nextId + hasInfo + annotCount;

  var labelCount: int64 := peek64(doc + PDF_DOC_LABELCOUNT);
  var labelBuf:   int64 := peek64(doc + PDF_DOC_LABELBUF);

  var transCount: int64 := peek64(doc + PDF_DOC_TRANSCOUNT);
  var transBuf:   int64 := peek64(doc + PDF_DOC_TRANSBUF);

  var viewFlags:     int64 := peek64(doc + PDF_DOC_VIEWFLAGS);
  var openPage:      int64 := peek64(doc + PDF_DOC_VIEWOPENPAGE);

  var namedestCount: int64 := peek64(doc + PDF_DOC_NAMEDESTCOUNT);
  var namedestBuf:   int64 := peek64(doc + PDF_DOC_NAMEDESTBUF);

  var attachCount:    int64 := peek64(doc + PDF_DOC_ATTACHCOUNT);
  var attachBuf:      int64 := peek64(doc + PDF_DOC_ATTACHBUF);
  var attachObjCount: int64 := attachCount * 2;
  var attachBaseId:   int64 := nextId + hasInfo + annotCount + outlineObjCount;

  var layerCount:   int64 := peek64(doc + PDF_DOC_LAYERCOUNT);
  var layerBuf:     int64 := peek64(doc + PDF_DOC_LAYERBUF);
  var layerBaseId:  int64 := attachBaseId + attachObjCount;

  var shadCount:    int64 := peek64(doc + PDF_DOC_SHADCOUNT);
  var shadBuf:      int64 := peek64(doc + PDF_DOC_SHADBUF);
  var spotCount:    int64 := peek64(doc + PDF_DOC_SPOTCOUNT);
  var spotBuf:      int64 := peek64(doc + PDF_DOC_SPOTBUF);
  var formCount:    int64 := peek64(doc + PDF_DOC_FORMCOUNT);
  var formBuf:      int64 := peek64(doc + PDF_DOC_FORMBUF);
  var rgCount:      int64 := peek64(doc + PDF_DOC_RGCOUNT);
  var rgBuf:        int64 := peek64(doc + PDF_DOC_RGBUF);
  var formFlat:     int64 := peek64(doc + PDF_DOC_FORMFLAT);
  var acroObjId:    int64 := peek64(doc + PDF_DOC_ACROOBJID);
  var encType:      int64 := peek64(doc + PDF_DOC_ENCTYPE);
  var encReady:     int64 := peek64(doc + PDF_DOC_ENCREADY);

  // Allocate XRef offset table
  var encObjAlloc: int64 := 0;
  if (encType != PDF_ENC_NONE && encReady != 0) { encObjAlloc := 1; }
  var xrefSize: int64 := (nextId + hasInfo + annotCount + outlineObjCount + attachObjCount + layerCount + shadCount + spotCount + formCount + rgCount + encObjAlloc + 4) * 8;
  var xrefs: int64 := mmapAlloc(xrefSize);
  if (xrefs == 0) {
    munmap(out, PDF_OUT_BUF_SIZE);
    return -3;
  }
  zeroMem(xrefs, xrefSize);

  var pos: int64 := 0;

  // --- PDF header ---
  pos := pdfStr(out, pos, "%PDF-1.4\n");
  poke8(out + pos, 37);   pos := pos + 1;
  poke8(out + pos, 0xE2); pos := pos + 1;
  poke8(out + pos, 0xE3); pos := pos + 1;
  poke8(out + pos, 0xCF); pos := pos + 1;
  poke8(out + pos, 0xD3); pos := pos + 1;
  poke8(out + pos, 10);   pos := pos + 1;

  // --- Object 1: Catalog ---
  poke64(xrefs + 1 * 8, pos);
  pos := pdfStr(out, pos, "1 0 obj\n<< /Type /Catalog /Pages 2 0 R");
  if (outlineCount > 0) {
    pos := pdfStr(out, pos, " /Outlines ");
    pos := pdfRef(out, pos, outlineRootId);
  }
  if (labelCount > 0) {
    pos := _pdfWritePageLabels(out, pos, labelBuf, labelCount);
  }
  if ((viewFlags & PDF_VIEW_FULLSCREEN) != 0) {
    pos := pdfStr(out, pos, " /PageMode /FullScreen");
  } else if ((viewFlags & PDF_VIEW_USE_OUTLINES) != 0) {
    pos := pdfStr(out, pos, " /PageMode /UseOutlines");
  }
  if ((viewFlags & PDF_VIEW_SINGLE_PAGE) != 0) {
    pos := pdfStr(out, pos, " /PageLayout /SinglePage");
  } else if ((viewFlags & PDF_VIEW_TWO_COLUMN_LEFT) != 0) {
    pos := pdfStr(out, pos, " /PageLayout /TwoColumnLeft");
  }
  if ((viewFlags & PDF_VIEW_OPEN_ACTION) != 0) {
    pos := pdfStr(out, pos, " /OpenAction [");
    pos := pdfRef(out, pos, arrGet(pageIds, openPage));
    pos := pdfStr(out, pos, " /XYZ null null null]");
  }
  var vpMask: int64 := viewFlags & 63;
  if (vpMask != 0) {
    pos := pdfStr(out, pos, " /ViewerPreferences <<");
    if ((vpMask & PDF_VIEW_HIDE_TOOLBAR) != 0)     { pos := pdfStr(out, pos, " /HideToolbar true"); }
    if ((vpMask & PDF_VIEW_HIDE_MENUBAR) != 0)     { pos := pdfStr(out, pos, " /HideMenubar true"); }
    if ((vpMask & PDF_VIEW_HIDE_WINDOWUI) != 0)    { pos := pdfStr(out, pos, " /HideWindowUI true"); }
    if ((vpMask & PDF_VIEW_FIT_WINDOW) != 0)       { pos := pdfStr(out, pos, " /FitWindow true"); }
    if ((vpMask & PDF_VIEW_CENTER_WINDOW) != 0)    { pos := pdfStr(out, pos, " /CenterWindow true"); }
    if ((vpMask & PDF_VIEW_DISPLAY_DOCTITLE) != 0) { pos := pdfStr(out, pos, " /DisplayDocTitle true"); }
    pos := pdfStr(out, pos, " >>");
  }
  if (namedestCount > 0 || attachCount > 0) {
    pos := pdfStr(out, pos, " /Names <<");
    if (namedestCount > 0) {
      pos := _pdfWriteDestsTree(out, pos, namedestBuf, namedestCount, pageIds);
    }
    if (attachCount > 0) {
      pos := _pdfWriteEmbedTree(out, pos, attachBuf, attachCount, attachBaseId);
    }
    pos := pdfStr(out, pos, " >>");
  }
  if (layerCount > 0) {
    pos := _pdfWriteOCProperties(out, pos, layerBuf, layerCount, layerBaseId);
  }
  // AcroForm reference (WP-PDF-18)
  if (formCount > 0 && formFlat == 0 && acroObjId > 0) {
    pos := pdfStr(out, pos, " /AcroForm ");
    pos := pdfRef(out, pos, acroObjId);
  }
  pos := pdfStr(out, pos, " >>\nendobj\n");

  // --- Object 2: Pages ---
  poke64(xrefs + 2 * 8, pos);
  pos := pdfStr(out, pos, "2 0 obj\n<< /Type /Pages /Kids [");
  var i: int64 := 0;
  while (i < pageCount) {
    if (i > 0) { poke8(out + pos, 32); pos := pos + 1; }
    pos := pdfRef(out, pos, arrGet(pageIds, i));
    i := i + 1;
  }
  pos := pdfStr(out, pos, "] /Count ");
  pos := pdfInt(out, pos, pageCount);
  pos := pdfStr(out, pos, " >>\nendobj\n");

  // --- Font objects (Standard-14, one per registered font) ---
  var fontIdBase: int64 := doc + PDF_DOC_FONTIDS;
  var fi: int64 := 0;
  while (fi < 14) {
    var foid: int64 := peek64(fontIdBase + fi * 8);
    if (foid != 0) {
      poke64(xrefs + foid * 8, pos);
      pos := pdfObjHdr(out, pos, foid);
      pos := pdfStr(out, pos, "<< /Type /Font /Subtype /Type1 /BaseFont /");
      pos := pdfStr(out, pos, pdfFontName(fi));
      pos := pdfStr(out, pos, " >>");
      pos := pdfObjFtr(out, pos);
    }
    fi := fi + 1;
  }

  // --- Image XObject objects ---
  var imageCount:    int64 := peek64(doc + PDF_DOC_IMAGECOUNT);
  var imageIds:      int64 := peek64(doc + PDF_DOC_IMAGEIDS);
  var imageWidths:   int64 := peek64(doc + PDF_DOC_IMAGEWIDTHS);
  var imageHeights:  int64 := peek64(doc + PDF_DOC_IMAGEHEIGHTS);
  var imageChannels: int64 := peek64(doc + PDF_DOC_IMAGECHANNELS);
  var imageDataBufs: int64 := peek64(doc + PDF_DOC_IMAGEDATABUFS);
  var imageDataLens: int64 := peek64(doc + PDF_DOC_IMAGEDATALENS);

  var imgIdx: int64 := 0;
  while (imgIdx < imageCount) {
    var imgId:  int64 := arrGet(imageIds,      imgIdx);
    var imgW:   int64 := arrGet(imageWidths,   imgIdx);
    var imgH:   int64 := arrGet(imageHeights,  imgIdx);
    var imgC:   int64 := arrGet(imageChannels, imgIdx);
    var imgBuf: int64 := arrGet(imageDataBufs, imgIdx);
    var imgLen: int64 := arrGet(imageDataLens, imgIdx);

    poke64(xrefs + imgId * 8, pos);
    pos := pdfObjHdr(out, pos, imgId);
    pos := pdfStr(out, pos, "<< /Type /XObject /Subtype /Image /Width ");
    pos := pdfInt(out, pos, imgW);
    pos := pdfStr(out, pos, " /Height ");
    pos := pdfInt(out, pos, imgH);
    if (imgC == 1) {
      pos := pdfStr(out, pos, " /ColorSpace /DeviceGray");
    } else {
      pos := pdfStr(out, pos, " /ColorSpace /DeviceRGB");
    }
    pos := pdfStr(out, pos, " /BitsPerComponent 8 /Filter /FlateDecode /Length ");
    pos := pdfInt(out, pos, imgLen);
    pos := pdfStr(out, pos, " >>\nstream\n");
    pos := pdfBytes(out, pos, imgBuf, imgLen);
    pos := pdfStr(out, pos, "\nendstream");
    pos := pdfObjFtr(out, pos);

    imgIdx := imgIdx + 1;
  }

  // --- Form XObject objects (WP-PDF-23) ---
  var compression: int64 := peek64(doc + PDF_DOC_COMPRESSION);
  var xobjCount:  int64 := peek64(doc + PDF_DOC_XOBJCOUNT);
  var xobjBuf:    int64 := peek64(doc + PDF_DOC_XOBJBUF);
  var xi: int64 := 0;
  while (xi < xobjCount) {
    var xrec:   int64 := xobjBuf + xi * PDF_XOBJ_RECSIZE;
    var xobjId: int64 := peek64(xrec + PDF_XOBJ_OBJID);
    var xw100:  int64 := peek64(xrec + PDF_XOBJ_W100);
    var xh100:  int64 := peek64(xrec + PDF_XOBJ_H100);
    var xbuf:   int64 := peek64(xrec + PDF_XOBJ_CONTENTBUF);
    var xlen:   int64 := peek64(xrec + PDF_XOBJ_CONTENTLEN);
    var xfmask: int64 := peek64(xrec + PDF_XOBJ_FONTMASK);

    poke64(xrefs + xobjId * 8, pos);
    pos := pdfObjHdr(out, pos, xobjId);
    pos := pdfStr(out, pos, "<< /Type /XObject /Subtype /Form /BBox [0 0 ");
    pos := pdfReal100(out, pos, xw100); poke8(out + pos, 32); pos := pos + 1;
    pos := pdfReal100(out, pos, xh100);
    pos := pdfStr(out, pos, "]");
    // /Resources with fonts used inside this XObject
    if (xfmask != 0) {
      pos := pdfStr(out, pos, " /Resources << /Font <<");
      var xfi: int64 := 0;
      while (xfi < 14) {
        if ((xfmask >> xfi) & 1 != 0) {
          pos := pdfStr(out, pos, " /F");
          pos := pdfInt(out, pos, xfi);
          poke8(out + pos, 32); pos := pos + 1;
          pos := pdfRef(out, pos, peek64(fontIdBase + xfi * 8));
        }
        xfi := xfi + 1;
      }
      pos := pdfStr(out, pos, " >> >>");
    }
    // Optionally compress content
    var xzbuf: int64 := 0;
    var xzlen: int64 := 0;
    if (compression > 0 && xlen > 0) {
      var xmaxOut: int64 := zlibMaxOutputSize(xlen);
      xzbuf := mmapAlloc(xmaxOut);
      if (xzbuf != 0) { xzlen := zlibCompress(xbuf, xlen, xzbuf); }
    }
    if (xzbuf != 0 && xzlen > 0) {
      pos := pdfStr(out, pos, " /Filter /FlateDecode /Length ");
      pos := pdfInt(out, pos, xzlen);
      pos := pdfStr(out, pos, " >>\nstream\n");
      pos := pdfBytes(out, pos, xzbuf, xzlen);
      munmap(xzbuf, zlibMaxOutputSize(xlen));
    } else {
      pos := pdfStr(out, pos, " /Length ");
      pos := pdfInt(out, pos, xlen);
      pos := pdfStr(out, pos, " >>\nstream\n");
      if (xbuf != 0 && xlen > 0) { pos := pdfBytes(out, pos, xbuf, xlen); }
    }
    pos := pdfStr(out, pos, "\nendstream");
    pos := pdfObjFtr(out, pos);
    xi := xi + 1;
  }

  // --- Shading objects (WP-PDF-22) ---
  var si: int64 := 0;
  while (si < shadCount) {
    var srec:  int64 := shadBuf + si * PDF_SHAD_RECSIZE;
    var sId:   int64 := peek64(srec + PDF_SHAD_OBJID);
    var sType: int64 := peek64(srec + PDF_SHAD_TYPE);
    var sx0:   int64 := peek64(srec + PDF_SHAD_X0);
    var sy0:   int64 := peek64(srec + PDF_SHAD_Y0);
    var sx1:   int64 := peek64(srec + PDF_SHAD_X1);
    var sy1:   int64 := peek64(srec + PDF_SHAD_Y1);
    var sr0:   int64 := peek64(srec + PDF_SHAD_R0);
    var sr1:   int64 := peek64(srec + PDF_SHAD_R1);
    var sc0:   int64 := peek64(srec + PDF_SHAD_C0);
    var sc1:   int64 := peek64(srec + PDF_SHAD_C1);

    poke64(xrefs + sId * 8, pos);
    pos := pdfObjHdr(out, pos, sId);
    pos := pdfStr(out, pos, "<< /ShadingType ");
    pos := pdfInt(out, pos, sType);
    pos := pdfStr(out, pos, " /ColorSpace /DeviceRGB /Coords [");
    pos := pdfReal100(out, pos, sx0); poke8(out + pos, 32); pos := pos + 1;
    pos := pdfReal100(out, pos, sy0); poke8(out + pos, 32); pos := pos + 1;
    if (sType == 3) {
      pos := pdfReal100(out, pos, sr0); poke8(out + pos, 32); pos := pos + 1;
    }
    pos := pdfReal100(out, pos, sx1); poke8(out + pos, 32); pos := pos + 1;
    pos := pdfReal100(out, pos, sy1);
    if (sType == 3) {
      poke8(out + pos, 32); pos := pos + 1;
      pos := pdfReal100(out, pos, sr1);
    }
    // Color function: FunctionType 2 linear interpolation
    var sr100: int64 := (sc0 >> 48) & 0xFFFF;
    var sg100: int64 := (sc0 >> 32) & 0xFFFF;
    var sb100: int64 := (sc0 >> 16) & 0xFFFF;
    var er100: int64 := (sc1 >> 48) & 0xFFFF;
    var eg100: int64 := (sc1 >> 32) & 0xFFFF;
    var eb100: int64 := (sc1 >> 16) & 0xFFFF;
    pos := pdfStr(out, pos, "] /Function << /FunctionType 2 /Domain [0 1] /C0 [");
    pos := pdfReal100(out, pos, sr100); poke8(out + pos, 32); pos := pos + 1;
    pos := pdfReal100(out, pos, sg100); poke8(out + pos, 32); pos := pos + 1;
    pos := pdfReal100(out, pos, sb100);
    pos := pdfStr(out, pos, "] /C1 [");
    pos := pdfReal100(out, pos, er100); poke8(out + pos, 32); pos := pos + 1;
    pos := pdfReal100(out, pos, eg100); poke8(out + pos, 32); pos := pos + 1;
    pos := pdfReal100(out, pos, eb100);
    pos := pdfStr(out, pos, "] /N 1 >> /Extend [true true] >>");
    pos := pdfObjFtr(out, pos);
    si := si + 1;
  }

  // --- Spot color tint-function objects (WP-PDF-25) ---
  var ski: int64 := 0;
  while (ski < spotCount) {
    var skrec: int64 := spotBuf + ski * PDF_SPOT_RECSIZE;
    var skfn:  int64 := peek64(skrec + PDF_SPOT_FNID);
    var skc:   int64 := peek64(skrec + PDF_SPOT_C100);
    var skm:   int64 := peek64(skrec + PDF_SPOT_M100);
    var sky:   int64 := peek64(skrec + PDF_SPOT_Y100);
    var skk:   int64 := peek64(skrec + PDF_SPOT_K100);
    poke64(xrefs + skfn * 8, pos);
    pos := pdfObjHdr(out, pos, skfn);
    pos := pdfStr(out, pos, "<< /FunctionType 2 /Domain [0 1] /C0 [0 0 0 0] /C1 [");
    pos := pdfReal100(out, pos, skc); poke8(out+pos, 32); pos := pos+1;
    pos := pdfReal100(out, pos, skm); poke8(out+pos, 32); pos := pos+1;
    pos := pdfReal100(out, pos, sky); poke8(out+pos, 32); pos := pos+1;
    pos := pdfReal100(out, pos, skk);
    pos := pdfStr(out, pos, "] /N 1 >>");
    pos := pdfObjFtr(out, pos);
    ski := ski + 1;
  }

  // --- AcroForms objects (WP-PDF-18) ---
  if (formCount > 0 && formFlat == 0 && acroObjId > 0) {
    // Appearance streams (AP /Yes and /Off) for checkboxes and radio buttons
    var apYesContent: pchar := "q 0.5 w 0 0 1 1 re S 0.1 0.1 m 0.9 0.9 l S 0.9 0.1 m 0.1 0.9 l S Q"c;
    var apOffContent: pchar := "q 0.5 w 0 0 1 1 re S Q"c;
    var apYesLen: int64 := StrLen(apYesContent);
    var apOffLen: int64 := StrLen(apOffContent);
    var fai: int64 := 0;
    while (fai < formCount) {
      var farec: int64 := formBuf + fai * PDF_FORM_RECSIZE;
      var fatype: int64 := peek64(farec + PDF_FORM_TYPE);
      if (fatype == PDF_FORM_CHECKBOX || fatype == PDF_FORM_RADIO) {
        var apYes: int64 := peek64(farec + PDF_FORM_AP_YES);
        var apOff: int64 := peek64(farec + PDF_FORM_AP_OFF);
        // Emit /Yes AP
        poke64(xrefs + apYes * 8, pos);
        pos := pdfObjHdr(out, pos, apYes);
        pos := pdfStr(out, pos, "<< /Type /XObject /Subtype /Form /BBox [0 0 1 1] /Length ");
        pos := pdfInt(out, pos, apYesLen);
        pos := pdfStr(out, pos, " >>\nstream\n");
        pos := pdfStr(out, pos, apYesContent);
        pos := pdfStr(out, pos, "\nendstream");
        pos := pdfObjFtr(out, pos);
        // Emit /Off AP
        poke64(xrefs + apOff * 8, pos);
        pos := pdfObjHdr(out, pos, apOff);
        pos := pdfStr(out, pos, "<< /Type /XObject /Subtype /Form /BBox [0 0 1 1] /Length ");
        pos := pdfInt(out, pos, apOffLen);
        pos := pdfStr(out, pos, " >>\nstream\n");
        pos := pdfStr(out, pos, apOffContent);
        pos := pdfStr(out, pos, "\nendstream");
        pos := pdfObjFtr(out, pos);
      }
      fai := fai + 1;
    }

    // Radio group parent field objects
    var rgi: int64 := 0;
    while (rgi < rgCount) {
      var rgrec: int64 := rgBuf + rgi * PDF_RG_RECSIZE;
      var rgObjId: int64 := peek64(rgrec + PDF_RG_OBJID);
      var rgName:  int64 := peek64(rgrec + PDF_RG_NAMEBUF);
      poke64(xrefs + rgObjId * 8, pos);
      pos := pdfObjHdr(out, pos, rgObjId);
      pos := pdfStr(out, pos, "<< /FT /Btn /Ff 32768 /T (");
      // Write group name
      var rgni: int64 := 0;
      while (1 == 1) { var rgnc: int64 := peek8(rgName+rgni); if (rgnc==0){break;} poke8(out+pos,rgnc); pos:=pos+1; rgni:=rgni+1; }
      pos := pdfStr(out, pos, ") /V /Off /Kids [");
      // List all radio button widget refs in this group
      var rbj: int64 := 0;
      while (rbj < formCount) {
        var rbrec: int64 := formBuf + rbj * PDF_FORM_RECSIZE;
        if (peek64(rbrec + PDF_FORM_TYPE) == PDF_FORM_RADIO && peek64(rbrec + PDF_FORM_FLAGS) == rgi) {
          pos := pdfRef(out, pos, peek64(rbrec + PDF_FORM_OBJID));
          poke8(out+pos, 32); pos:=pos+1;
        }
        rbj := rbj + 1;
      }
      pos := pdfStr(out, pos, "] >>");
      pos := pdfObjFtr(out, pos);
      rgi := rgi + 1;
    }

    // Widget annotation objects for each field
    var fwi: int64 := 0;
    while (fwi < formCount) {
      var fwrec:  int64 := formBuf + fwi * PDF_FORM_RECSIZE;
      var fwtype: int64 := peek64(fwrec + PDF_FORM_TYPE);
      var fwobj:  int64 := peek64(fwrec + PDF_FORM_OBJID);
      var fwpg:   int64 := peek64(fwrec + PDF_FORM_PAGE);
      var fwx1:   int64 := peek64(fwrec + PDF_FORM_X1);
      var fwy1:   int64 := peek64(fwrec + PDF_FORM_Y1);
      var fwx2:   int64 := peek64(fwrec + PDF_FORM_X2);
      var fwy2:   int64 := peek64(fwrec + PDF_FORM_Y2);
      var fwnam:  int64 := peek64(fwrec + PDF_FORM_NAMEBUF);
      var fwval:  int64 := peek64(fwrec + PDF_FORM_VALBUF);
      poke64(xrefs + fwobj * 8, pos);
      pos := pdfObjHdr(out, pos, fwobj);
      pos := pdfStr(out, pos, "<< /Type /Annot /Subtype /Widget");
      // Field type
      if (fwtype == PDF_FORM_TEXT) {
        pos := pdfStr(out, pos, " /FT /Tx /Ff 0");
      } else if (fwtype == PDF_FORM_CHECKBOX) {
        pos := pdfStr(out, pos, " /FT /Btn /Ff 0");
      } else if (fwtype == PDF_FORM_RADIO) {
