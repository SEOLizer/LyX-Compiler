// std/pdf/pdfa.lyx
// PDF/A conformance (WP-PDF-27)
// Sets PDF/A output mode: OutputIntent with sRGB ICC profile + XMP pdfaid namespace.

@description("PDF/A conformance: PdfSetConformance")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, fs.write])
unit std.pdf.pdfa;

import std.pdf.builder;

// Conformance level constants
pub con PDF_CONFORMANCE_NONE: int64 := 0;
pub con PDF_CONFORMANCE_A1B:  int64 := 1;
pub con PDF_CONFORMANCE_A2B:  int64 := 2;
pub con PDF_CONFORMANCE_A3B:  int64 := 3;

// PdfSetConformance — enable PDF/A output mode.
//
// Call before PdfGenerateXMP and PdfSave.
// When active:
//   - OutputIntent with embedded sRGB ICC profile is added to the Catalog
//   - XMP gets pdfaid:part and pdfaid:conformance (call PdfGenerateXMP after this)
//   - Encryption is suppressed (PDF/A and encryption are incompatible)
//
// Supported levels: PDF_CONFORMANCE_A1B / A2B / A3B
// Calling with PDF_CONFORMANCE_NONE disables PDF/A mode.
pub fn PdfSetConformance(doc: int64, level: int64): void {
  if (doc == 0) { return; }
  poke64(doc + PDF_DOC_CONFORMANCE, level);
  if (level != PDF_CONFORMANCE_NONE) {
    if (peek64(doc + PDF_DOC_ICCPROFID) == 0) {
      var iccId: int64 := peek64(doc + PDF_DOC_NEXTID);
      poke64(doc + PDF_DOC_NEXTID, iccId + 1);
      poke64(doc + PDF_DOC_ICCPROFID, iccId);
      var oiId: int64 := peek64(doc + PDF_DOC_NEXTID);
      poke64(doc + PDF_DOC_NEXTID, oiId + 1);
      poke64(doc + PDF_DOC_OUTINTENTID, oiId);
    }
  }
}
