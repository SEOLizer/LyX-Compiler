// std/pdf/transition.lyx
// PDF page transitions (slide-show effects on page turn) — WP-PDF-12

@description("PDF page transitions: PdfSetPageTransition for dissolve/wipe/push/etc.")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, fs.write])
unit std.pdf.transition;

import std.alloc;
import std.pdf.builder;

fn _transEnsure(doc: int64): int64 {
  var count: int64 := peek64(doc + PDF_DOC_TRANSCOUNT);
  var cap:   int64 := peek64(doc + PDF_DOC_TRANSCAP);
  var buf:   int64 := peek64(doc + PDF_DOC_TRANSBUF);
  if (count < cap) { return 1; }
  var newCap: int64 := cap * 2;
  var newBuf: int64 := alloc(newCap * PDF_TRANS_RECSIZE);
  if (newBuf == 0) { return 0; }
  var ci: int64 := 0;
  while (ci < count * PDF_TRANS_RECSIZE) {
    poke8(newBuf + ci, peek8(buf + ci));
    ci += 1;
  }
  while (ci < newCap * PDF_TRANS_RECSIZE) {
    poke8(newBuf + ci, 0);
    ci += 1;
  }
  free(buf, cap * PDF_TRANS_RECSIZE);
  poke64(doc + PDF_DOC_TRANSBUF, newBuf);
  poke64(doc + PDF_DOC_TRANSCAP, newCap);
  return 1;
}

// Set a page transition effect.
// pageIdx:   0-based page index
// transType: PDF_TRANS_DISSOLVE / WIPE / PUSH / SPLIT / COVER / UNCOVER / FADE / GLITTER / BOX / FLY
// dur100:    duration × 100 (e.g. 100 = 1.0 s), 0 = viewer default
// Returns 0 on success, -1 on error.
pub fn PdfSetPageTransition(doc: int64, pageIdx: int64, transType: int64, dur100: int64): int64 {
  if (doc == 0) { return -1; }
  if (_transEnsure(doc) == 0) { return -1; }
  var count: int64 := peek64(doc + PDF_DOC_TRANSCOUNT);
  var buf:   int64 := peek64(doc + PDF_DOC_TRANSBUF);
  var rec:   int64 := buf + count * PDF_TRANS_RECSIZE;
  poke64(rec + PDF_TRANS_PAGEIDX, pageIdx);
  poke64(rec + PDF_TRANS_TYPE,    transType);
  poke64(rec + PDF_TRANS_DUR100,  dur100);
  poke64(doc + PDF_DOC_TRANSCOUNT, count + 1);
  return 0;
}
