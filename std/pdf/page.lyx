// ============================================================================
// PdfAddPage — add a new page to the document
// w, h: page dimensions in PDF points (use PDF_A4_W / PDF_A4_H etc.)
// Returns: page handle (0-based index), or -1 on error (doc full)
// ============================================================================

// #1246: Der dokumentierte Name fuer eine Seite mit eigener Groesse. Die
// Doku fuehrte ihn in der Funktionstabelle, es gab ihn aber nicht — und
// PdfAddPage nimmt Breite und Hoehe laengst entgegen. Die Huelle macht die
// Zusage wahr, ohne eine zweite Umsetzung danebenzustellen.
pub fn PdfAddPageSized(doc: int64, width: f64, height: f64): int64 {
  return PdfAddPage(doc, width, height);
}

pub fn PdfAddPage(doc: int64, w: f64, h: f64): int64 {
  if (doc == 0) { return -1; }

  var pageCount: int64 := peek64(doc + PDF_DOC_PAGECOUNT);
  var pageCap:   int64 := peek64(doc + PDF_DOC_PAGECAP);

  if (pageCount >= pageCap) { return -1; }

  var nextId:     int64 := peek64(doc + PDF_DOC_NEXTID);
  var pageId:     int64 := nextId;
  var contentId:  int64 := nextId + 1;

  var pageIds:    int64 := peek64(doc + PDF_DOC_PAGEIDS);
  var contentIds: int64 := peek64(doc + PDF_DOC_CONTENTIDS);
  var widths100:  int64 := peek64(doc + PDF_DOC_WIDTHS100);
  var heights100: int64 := peek64(doc + PDF_DOC_HEIGHTS100);

  poke64(pageIds    + pageCount * 8, pageId);
  poke64(contentIds + pageCount * 8, contentId);

  poke64(widths100  + pageCount * 8, f64ToInt100(w));
  poke64(heights100 + pageCount * 8, f64ToInt100(h));

  poke64(doc + PDF_DOC_NEXTID,    nextId + 2);
  poke64(doc + PDF_DOC_PAGECOUNT, pageCount + 1);

  return pageCount;
}

// ============================================================================
// PdfSetLandscape — swap width/height so width > height
// ============================================================================

// ============================================================================
// PdfSetPageRotation — set the /Rotate entry for a page (WP-PDF-20)
// degrees must be 0, 90, 180 or 270; other values are silently ignored.
// ============================================================================

pub fn PdfSetPageRotation(doc: int64, pageIdx: int64, degrees: int64): void {
  if (doc == 0) { return; }
  if (degrees != 0 && degrees != 90 && degrees != 180 && degrees != 270) { return; }
  var pageCount: int64 := peek64(doc + PDF_DOC_PAGECOUNT);
  if (pageIdx < 0 || pageIdx >= pageCount) { return; }
  var rotBuf: int64 := peek64(doc + PDF_DOC_PAGEROTATIONS);
  poke64(rotBuf + pageIdx * 8, degrees);
}

// ============================================================================
// PdfSetLandscape — swap width/height so width > height
// ============================================================================

pub fn PdfSetLandscape(doc: int64, pageIdx: int64): void {
  if (doc == 0) { return; }

  var widths100:  int64 := peek64(doc + PDF_DOC_WIDTHS100);
  var heights100: int64 := peek64(doc + PDF_DOC_HEIGHTS100);

  var w100: int64 := peek64(widths100  + pageIdx * 8);
  var h100: int64 := peek64(heights100 + pageIdx * 8);

  if (w100 < h100) {
    poke64(widths100  + pageIdx * 8, h100);
    poke64(heights100 + pageIdx * 8, w100);
  }
}
