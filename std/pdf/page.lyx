// Standard page size constants (in PDF points: 1pt = 1/72 inch)
// ============================================================================

pub con PDF_A4_W:     f64 := 595.28;
pub con PDF_A4_H:     f64 := 841.89;
pub con PDF_A3_W:     f64 := 841.89;
pub con PDF_A3_H:     f64 := 1190.55;
pub con PDF_A5_W:     f64 := 419.53;
pub con PDF_A5_H:     f64 := 595.28;
pub con PDF_LETTER_W: f64 := 612.0;
pub con PDF_LETTER_H: f64 := 792.0;
pub con PDF_LEGAL_W:  f64 := 612.0;
