// std/pdf/attach.lyx
// PDF embedded file attachments — WP-PDF-15

@description("PDF embedded file attachments: PdfAttachFile")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, fs.write])
unit std.pdf.attach;

import std.alloc;
import std.pdf.builder;

fn _attachStrDup(s: pchar): int64 {
  var len: int64 := StrLen(s) + 1;
  var buf: int64 := alloc(len);
  if (buf == 0) { return 0; }
  var i: int64 := 0;
  while (i < len) {
    poke8(buf + i, StrCharAt(s, i));
    i += 1;
  }
  return buf;
}

fn _attachDataCopy(data: int64, dataLen: int64): int64 {
  if (dataLen <= 0) { return 0; }
  var buf: int64 := alloc(dataLen);
  if (buf == 0) { return 0; }
  var i: int64 := 0;
  while (i < dataLen) {
    poke8(buf + i, peek8(data + i));
    i += 1;
  }
  return buf;
}

fn _attachEnsure(doc: int64): int64 {
  var count: int64 := peek64(doc + PDF_DOC_ATTACHCOUNT);
  var cap:   int64 := peek64(doc + PDF_DOC_ATTACHCAP);
  var buf:   int64 := peek64(doc + PDF_DOC_ATTACHBUF);
  if (count < cap) { return 1; }
  var newCap: int64 := cap * 2;
  var newBuf: int64 := alloc(newCap * PDF_ATTACH_RECSIZE);
  if (newBuf == 0) { return 0; }
  var ci: int64 := 0;
  while (ci < count * PDF_ATTACH_RECSIZE) {
    poke8(newBuf + ci, peek8(buf + ci));
    ci += 1;
  }
  while (ci < newCap * PDF_ATTACH_RECSIZE) {
    poke8(newBuf + ci, 0);
    ci += 1;
  }
  free(buf, cap * PDF_ATTACH_RECSIZE);
  poke64(doc + PDF_DOC_ATTACHBUF, newBuf);
  poke64(doc + PDF_DOC_ATTACHCAP, newCap);
  return 1;
}

// Attach a file to the PDF document.
// filename: display name shown in PDF viewers (e.g. "report.csv")
// data:     pointer to file content bytes (copied internally)
// dataLen:  number of bytes
// Returns 0 on success, -1 on error.
pub fn PdfAttachFile(doc: int64, filename: pchar, data: int64, dataLen: int64): int64 {
  if (doc == 0) { return -1; }
  if (_attachEnsure(doc) == 0) { return -1; }
  var nameBuf: int64 := _attachStrDup(filename);
  if (nameBuf == 0) { return -1; }
  var dataBuf: int64 := _attachDataCopy(data, dataLen);
  if (dataBuf == 0) {
    free(nameBuf, StrLen(filename) + 1);
    return -1;
  }
  var count: int64 := peek64(doc + PDF_DOC_ATTACHCOUNT);
  var buf:   int64 := peek64(doc + PDF_DOC_ATTACHBUF);
  var rec:   int64 := buf + count * PDF_ATTACH_RECSIZE;
  poke64(rec + PDF_ATTACH_NAMEBUF, nameBuf);
  poke64(rec + PDF_ATTACH_NAMELEN, StrLen(filename) + 1);
  poke64(rec + PDF_ATTACH_DATABUF, dataBuf);
  poke64(rec + PDF_ATTACH_DATALEN, dataLen);
  poke64(doc + PDF_DOC_ATTACHCOUNT, count + 1);
  return 0;
}
