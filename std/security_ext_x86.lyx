// std/security_ext_x86.lyx -- #2512: der x86-eigene Teil von std.security_ext.
//
// WARUM GETRENNT. `arch_prctl` setzt und liest die Segmentbasis (FS/GS) und
// ist x86-eigen. arm64 und riscv haben dafuer keine Entsprechung mit
// derselben Bedeutung -- sie halten den Thread-Zeiger in einem eigenen
// Register (`TPIDR_EL0` bzw. `tp`), nicht hinter einem Syscall. ir_lower
// weist `sys_arch_prctl` auf diesen Zielen deshalb benannt ab, und das ist
// richtig: eine Nummer zu erfinden waere eine stille Fehlfunktion.
//
// Solange diese zwei Funktionen in `std.security_ext` standen, war die GANZE
// Unit nicht fuer arm64 und riscv vorkompilierbar -- und damit jeder
// Auslieferbaum dieser Ziele auf eine Ausnahmeliste angewiesen (#2472). Der
// Rest der Unit (capget/capset/prctl) ist portabel; nur dieser Teil nicht.
//
// WARUM NICHT EINE FASSADE MIT UEBERSETZUNGSZEIT-ZWEIG. Gemessen am
// 2026-11-14 mit lyxc 1.2.39D: ein toter Zweig hinter `TARGET_IS_X86_64`
// wird NICHT vor dem Lowering entfernt -- ir_lower weist den Aufruf auch im
// unerreichbaren Zweig ab:
//
//   if (TARGET_IS_X86_64 != 0) { sys_arch_prctl(...) } else { ... }
//   --target=arm64 -> "sys_arch_prctl gibt es auf diesem Ziel nicht."
//
// Eine Fassade im Quelltext ist damit heute nicht baubar; der Schnitt in
// zwei Units braucht dagegen keine Compiler-Aenderung. Der allgemeine
// Mangel ist eigens vermerkt.
//
// WER DEN THREAD-ZEIGER PORTABEL BRAUCHT, hat hier nichts gewonnen: diese
// Unit gibt die x86-Sicht. Eine portable Auskunft waere eine eigene
// Aufgabe und braucht je Ziel einen Registerzugriff.

@description("x86-64 arch_prctl: FS/GS base")
@author("Andreas Röne")
@copyright("2024-2026 Andreas Röne")
unit std.security_ext_x86;

import std.alloc;

// arch_prctl Codes (x86-64)
pub con ARCH_SET_GS: int64 := 4097;  // 0x1001
pub con ARCH_SET_FS: int64 := 4098;  // 0x1002
pub con ARCH_GET_FS: int64 := 4099;  // 0x1003
pub con ARCH_GET_GS: int64 := 4100;  // 0x1004

// ArchGetFs: liest die aktuelle FS-Basis (TLS-Zeiger des aktuellen Threads).
pub fn ArchGetFs(): int64 {
  var val: int64 := alloc(8);
  if (val == 0) { return -1; }
  var r: int64 := sys_arch_prctl(ARCH_GET_FS, val);
  var fs: int64 := 0;
  if (r == 0) { fs := peek64(val); }
  free(val, 8);
  if (r < 0) { return r; }
  return fs;
}

// ArchGetGs: liest die aktuelle GS-Basis.
pub fn ArchGetGs(): int64 {
  var val: int64 := alloc(8);
  if (val == 0) { return -1; }
  var r: int64 := sys_arch_prctl(ARCH_GET_GS, val);
  var gs: int64 := 0;
  if (r == 0) { gs := peek64(val); }
  free(val, 8);
  if (r < 0) { return r; }
  return gs;
}
