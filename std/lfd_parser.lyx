// std/lfd_parser.lyx — LFD (LyX Form Description) parser
// Recursive-descent parser for the LFD UI DSL.
//
// Node layout (64 bytes, 8 × int64):
//   +0:  kind       — LFD_TK_* value (form / widget / layout / property type)
//   +8:  txtPtr     — byte offset into lfd_source where the text starts
//   +16: txtLen     — byte length of text
//   +24: firstChild — pointer to first child node  (0 = none)
//   +32: nextSib    — pointer to next sibling node (0 = none)
//   +40: numVal     — integer value for number/bool properties
//   +48: valPtr     — #1393: Offset des ZEICHENKETTEN-Werts einer Eigenschaft
//   +56: valLen     — #1393: dessen Laenge (0 = kein Zeichenkettenwert)
//
// Token layout (24 bytes, 3 × int64):
//   +0:  kind       — LFD_TK_* value
//   +8:  start      — byte offset in source
//   +16: length     — byte count

// #1399: Hier stand "LFD binary file format parser". LFD ist kein
// Binaerformat — es gibt weder Datei-Lese- noch Schreibroutinen, der Parser
// arbeitet auf einem pchar. Die Fehlbeschreibung war in die Wiki-Doku
// gewandert und hat dort jahrelang gestanden.
@description("Recursive-Descent-Parser fuer die LFD-Textsprache (LyX Form Description)")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
unit std.lfd_parser;

import std.alloc;
import std.string;

// ============================================================================
// Token Kind Constants
// ============================================================================

pub con LFD_TK_FORM: int64 := 0;
pub con LFD_TK_LAYOUT: int64 := 1;
pub con LFD_TK_VERTICAL: int64 := 2;
pub con LFD_TK_HORIZONTAL: int64 := 3;
pub con LFD_TK_GRID: int64 := 4;
pub con LFD_TK_STACK: int64 := 5;
pub con LFD_TK_BUTTON: int64 := 6;
pub con LFD_TK_LABEL: int64 := 7;
pub con LFD_TK_INPUT: int64 := 8;
pub con LFD_TK_CHECKBOX: int64 := 9;
pub con LFD_TK_RADIOBUTTON: int64 := 10;
pub con LFD_TK_COMBOBOX: int64 := 11;
pub con LFD_TK_SPINBOX: int64 := 12;
pub con LFD_TK_SLIDER: int64 := 13;
pub con LFD_TK_LISTBOX: int64 := 14;
pub con LFD_TK_TEXTEDIT: int64 := 15;
pub con LFD_TK_PROGRESSBAR: int64 := 16;
pub con LFD_TK_GROUPBOX: int64 := 17;
pub con LFD_TK_TABWIDGET: int64 := 18;
pub con LFD_TK_SPLITTER: int64 := 19;
pub con LFD_TK_IMAGE: int64 := 20;
pub con LFD_TK_CUSTOM: int64 := 21;
pub con LFD_TK_TEXT: int64 := 22;
pub con LFD_TK_TOOLTIP: int64 := 23;
pub con LFD_TK_ENABLED: int64 := 24;
pub con LFD_TK_VISIBLE: int64 := 25;
pub con LFD_TK_WIDTH: int64 := 26;
pub con LFD_TK_HEIGHT: int64 := 27;
pub con LFD_TK_ONCLICK: int64 := 28;
pub con LFD_TK_ONCHANGE: int64 := 29;
pub con LFD_TK_TRUE: int64 := 30;
pub con LFD_TK_FALSE: int64 := 31;
pub con LFD_TK_IDENTIFIER: int64 := 32;
pub con LFD_TK_STRING: int64 := 33;
pub con LFD_TK_NUMBER: int64 := 34;
pub con LFD_TK_LBRACE: int64 := 35;
pub con LFD_TK_RBRACE: int64 := 36;
pub con LFD_TK_COLON: int64 := 37;
pub con LFD_TK_NEWLINE: int64 := 38;
pub con LFD_TK_EOF: int64 := 39;
pub con LFD_TK_INVALID: int64 := 40;

// Node kind constants (aliases kept for user code)
// #1396: Diese Liste war teils unbrauchbar, teils tot. LFD_NODE_WIDGET stand
// auf 3 — demselben Wert wie LFD_TK_HORIZONTAL. Ein Vergleich darauf traf jede
// waagerechte Anordnung und kein einziges Bedienelement, denn die tragen ihren
// konkreten Typ (LFD_TK_BUTTON = 6 … LFD_TK_CUSTOM = 21). LFD_NODE_ROOT und
// LFD_NODE_EVENT wurden nie vergeben.
//
// Jetzt: Die Wurzel ist und bleibt ein LFD_TK_FORM-Knoten — dafuer ist
// LFD_NODE_FORM der Name. LFD_NODE_WIDGET liegt ausserhalb der Token-Werte und
// bezeichnet keinen Knoten, sondern wird ueber LFDIsWidget(node) beantwortet;
// eine einzelne Zahl kann sechzehn Typen nicht vertreten. LFD_NODE_EVENT wird
// jetzt tatsaechlich vergeben: onclick und onchange erzeugen Ereignisknoten.
pub con LFD_NODE_ROOT: int64 := 0;     // == LFD_TK_FORM, die Wurzel
pub con LFD_NODE_FORM: int64 := 0;
pub con LFD_NODE_LAYOUT: int64 := 1;
pub con LFD_NODE_WIDGET: int64 := 103;  // kein Knotenwert — siehe LFDIsWidget
pub con LFD_NODE_PROPERTY: int64 := 101;
pub con LFD_NODE_EVENT: int64 := 102;

pub type LFDParser = int64;

// ============================================================================
// Internal constants
// ============================================================================

con LFD_NODE_SZ: int64 := 64;   // #1393: +valPtr, +valLen
con LFD_TOK_SZ: int64 := 24;

// ============================================================================
// Global parser state
// ============================================================================

var lfd_error_msg: pchar := "";
var lfd_error_count: int64 := 0;
var lfd_source: pchar := "";
var lfd_source_len: int64 := 0;
var lfd_pos: int64 := 0;

var lfd_tok_buf: int64 := 0;
var lfd_tok_cap: int64 := 0;
var lfd_tok_count: int64 := 0;
var lfd_tok_pos: int64 := 0;
var lfd_pool: int64 := 0;
var lfd_pool_cap: int64 := 0;
var lfd_pool_sz: int64 := 0;

// ============================================================================
// Internal: character helpers
// ============================================================================

fn _lfdCh(i: int64): int64 {
    if (i >= lfd_source_len) { return 0; }
    return peek8(lfd_source as int64 + i);
}

fn _lfdIsAlpha(c: int64): int64 {
    if (c >= 65 && c <= 90)  { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c == 95)             { return 1; }
    return 0;
}

fn _lfdIsAlNum(c: int64): int64 {
    if (_lfdIsAlpha(c) != 0)   { return 1; }
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

// ============================================================================
// Internal: token buffer helpers
// ============================================================================

fn _lfdPushTok(kind: int64, start: int64, tlen: int64): void {
    if (lfd_tok_count >= lfd_tok_cap) { return; }
    var base: int64 := lfd_tok_buf + lfd_tok_count * LFD_TOK_SZ;
    poke64(base,      kind);
    poke64(base + 8,  start);
    poke64(base + 16, tlen);
    lfd_tok_count += 1;
}

// Compare lfd_source[start..start+len] against keyword literal kw of length kwLen
fn _lfdEq(start: int64, len: int64, kw: pchar, kwLen: int64): int64 {
    if (len != kwLen) { return 0; }
    var i: int64 := 0;
    var ok: int64 := 1;
    while (i < len && ok == 1) {
        if (peek8(lfd_source as int64 + start + i) != peek8(kw as int64 + i)) {
            ok := 0;
        } else {
            i += 1;
        }
    }
    return ok;
}

// Match an identifier against LFD keywords; return token kind
fn _lfdMatchKw(start: int64, len: int64): int64 {
    if (_lfdEq(start, len, "form",         4) != 0) { return LFD_TK_FORM; }
    if (_lfdEq(start, len, "layout",       6) != 0) { return LFD_TK_LAYOUT; }
    if (_lfdEq(start, len, "vertical",     8) != 0) { return LFD_TK_VERTICAL; }
    if (_lfdEq(start, len, "horizontal",  10) != 0) { return LFD_TK_HORIZONTAL; }
    if (_lfdEq(start, len, "grid",         4) != 0) { return LFD_TK_GRID; }
    if (_lfdEq(start, len, "stack",        5) != 0) { return LFD_TK_STACK; }
    if (_lfdEq(start, len, "button",       6) != 0) { return LFD_TK_BUTTON; }
    if (_lfdEq(start, len, "label",        5) != 0) { return LFD_TK_LABEL; }
    if (_lfdEq(start, len, "input",        5) != 0) { return LFD_TK_INPUT; }
    if (_lfdEq(start, len, "checkbox",     8) != 0) { return LFD_TK_CHECKBOX; }
    if (_lfdEq(start, len, "radiobutton", 11) != 0) { return LFD_TK_RADIOBUTTON; }
    if (_lfdEq(start, len, "combobox",     8) != 0) { return LFD_TK_COMBOBOX; }
    if (_lfdEq(start, len, "spinbox",      7) != 0) { return LFD_TK_SPINBOX; }
    if (_lfdEq(start, len, "slider",       6) != 0) { return LFD_TK_SLIDER; }
    if (_lfdEq(start, len, "listbox",      7) != 0) { return LFD_TK_LISTBOX; }
    if (_lfdEq(start, len, "textedit",     8) != 0) { return LFD_TK_TEXTEDIT; }
    if (_lfdEq(start, len, "progressbar", 11) != 0) { return LFD_TK_PROGRESSBAR; }
    if (_lfdEq(start, len, "groupbox",     8) != 0) { return LFD_TK_GROUPBOX; }
    if (_lfdEq(start, len, "tabwidget",    9) != 0) { return LFD_TK_TABWIDGET; }
    if (_lfdEq(start, len, "splitter",     8) != 0) { return LFD_TK_SPLITTER; }
    if (_lfdEq(start, len, "image",        5) != 0) { return LFD_TK_IMAGE; }
    if (_lfdEq(start, len, "custom",       6) != 0) { return LFD_TK_CUSTOM; }
    if (_lfdEq(start, len, "text",         4) != 0) { return LFD_TK_TEXT; }
    if (_lfdEq(start, len, "tooltip",      7) != 0) { return LFD_TK_TOOLTIP; }
    if (_lfdEq(start, len, "enabled",      7) != 0) { return LFD_TK_ENABLED; }
    if (_lfdEq(start, len, "visible",      7) != 0) { return LFD_TK_VISIBLE; }
    if (_lfdEq(start, len, "width",        5) != 0) { return LFD_TK_WIDTH; }
    if (_lfdEq(start, len, "height",       6) != 0) { return LFD_TK_HEIGHT; }
    if (_lfdEq(start, len, "onclick",      7) != 0) { return LFD_TK_ONCLICK; }
    if (_lfdEq(start, len, "onchange",     8) != 0) { return LFD_TK_ONCHANGE; }
    if (_lfdEq(start, len, "true",         4) != 0) { return LFD_TK_TRUE; }
    if (_lfdEq(start, len, "false",        5) != 0) { return LFD_TK_FALSE; }
    return LFD_TK_IDENTIFIER;
}

// ============================================================================
// Lexer
// ============================================================================

fn _lfdLex(): void {
    var p: int64 := 0;
    var sc: int64 := 1;
    while (sc == 1) {
        // Skip whitespace
        var ws: int64 := 1;
        while (ws == 1 && p < lfd_source_len) {
            var wc: int64 := _lfdCh(p);
            if (wc == 32 || wc == 9 || wc == 10 || wc == 13) {
                p += 1;
            } else {
                ws := 0;
            }
        }

        if (p >= lfd_source_len) {
            _lfdPushTok(LFD_TK_EOF, p, 0);
            sc := 0;
        }

        if (sc == 1) {
            var ch: int64 := _lfdCh(p);
            if (ch == 123) {
                _lfdPushTok(LFD_TK_LBRACE, p, 1);
                p += 1;
            } else if (ch == 125) {
                _lfdPushTok(LFD_TK_RBRACE, p, 1);
                p += 1;
            } else if (ch == 58) {
                _lfdPushTok(LFD_TK_COLON, p, 1);
                p += 1;
            } else if (ch == 34) {
                // String: scan from after opening quote to closing quote
                p += 1;
                var strStart: int64 := p;
                var sq: int64 := 1;
                while (sq == 1 && p < lfd_source_len) {
                    var sc2: int64 := _lfdCh(p);
                    if (sc2 == 92) {
                        p += 2;          // skip backslash + next char
                    } else if (sc2 == 34 || sc2 == 0) {
                        sq := 0;
                    } else {
                        p += 1;
                    }
                }
                _lfdPushTok(LFD_TK_STRING, strStart, p - strStart);
                if (p < lfd_source_len) { p := p + 1; }   // skip closing '"'
            } else if (ch >= 48 && ch <= 57 || (ch == 45 && p + 1 < lfd_source_len && _lfdCh(p + 1) >= 48 && _lfdCh(p + 1) <= 57)) {
                // #1394: Das Minuszeichen fiel vorher in "skip unknown char"
                // ganz unten durch — `width: -5` kam als 5 im Baum an, ohne
                // Fehler und ohne Warnung. Es gehoert zur Zahl, wenn unmittelbar
                // eine Ziffer folgt.
                var numStart: int64 := p;
                if (ch == 45) { p := p + 1; }
                var nd: int64 := 1;
                while (nd == 1 && p < lfd_source_len) {
                    var dc: int64 := _lfdCh(p);
                    if (dc >= 48 && dc <= 57) { p := p + 1; }
                    else { nd := 0; }
                }
                _lfdPushTok(LFD_TK_NUMBER, numStart, p - numStart);
            } else if (_lfdIsAlpha(ch) != 0) {
                var idStart: int64 := p;
                var ia: int64 := 1;
                while (ia == 1 && p < lfd_source_len) {
                    if (_lfdIsAlNum(_lfdCh(p)) != 0) { p := p + 1; }
                    else { ia := 0; }
                }
                var kw: int64 := _lfdMatchKw(idStart, p - idStart);
                _lfdPushTok(kw, idStart, p - idStart);
            } else {
                p += 1;   // skip unknown char
            }
        }
    }
}

// ============================================================================
// Token accessors
// ============================================================================

fn _lfdTokKind(): int64 {
    if (lfd_tok_pos >= lfd_tok_count) { return LFD_TK_EOF; }
    return peek64(lfd_tok_buf + lfd_tok_pos * LFD_TOK_SZ);
}

fn _lfdTokStart(): int64 {
    if (lfd_tok_pos >= lfd_tok_count) { return lfd_source_len; }
    return peek64(lfd_tok_buf + lfd_tok_pos * LFD_TOK_SZ + 8);
}

fn _lfdTokLen(): int64 {
    if (lfd_tok_pos >= lfd_tok_count) { return 0; }
    return peek64(lfd_tok_buf + lfd_tok_pos * LFD_TOK_SZ + 16);
}

fn _lfdAdvTok(): void {
    if (lfd_tok_pos < lfd_tok_count) {
        lfd_tok_pos += 1;
    }
}

fn _lfdExpect(kind: int64): int64 {
    if (_lfdTokKind() == kind) { _lfdAdvTok(); return 1; }
    lfd_error_count += 1;
    lfd_error_msg := "unexpected token";
    return 0;
}

// ============================================================================
// Node pool
// ============================================================================

fn _lfdNewNode(kind: int64, txtPtr: int64, txtLen: int64): int64 {
    if (lfd_pool_sz >= lfd_pool_cap) { return 0; }
    var base: int64 := lfd_pool + lfd_pool_sz * LFD_NODE_SZ;
    poke64(base,      kind);
    poke64(base + 8,  txtPtr);
    poke64(base + 16, txtLen);
    poke64(base + 24, 0);
    poke64(base + 32, 0);
    poke64(base + 40, 0);
    poke64(base + 48, 0);   // #1393: valPtr
    poke64(base + 56, 0);   // #1393: valLen
    lfd_pool_sz += 1;
    return base;
}

fn _lfdAddChild(parent: int64, child: int64): void {
    if (parent == 0 || child == 0) { return; }
    var first: int64 := peek64(parent + 24);
    if (first == 0) {
        poke64(parent + 24, child);
        return;
    }
    var cur: int64 := first;
    var sc: int64 := 1;
    while (sc == 1) {
        var nxt: int64 := peek64(cur + 32);
        if (nxt == 0) { sc := 0; }
        else { cur := nxt; }
    }
    poke64(cur + 32, child);
}

// ============================================================================
// Parser helpers
// ============================================================================

fn _lfdIsWidget(k: int64): int64 {
    if (k == LFD_TK_BUTTON)      { return 1; }
    if (k == LFD_TK_LABEL)       { return 1; }
    if (k == LFD_TK_INPUT)       { return 1; }
    if (k == LFD_TK_CHECKBOX)    { return 1; }
    if (k == LFD_TK_RADIOBUTTON) { return 1; }
    if (k == LFD_TK_COMBOBOX)    { return 1; }
    if (k == LFD_TK_SPINBOX)     { return 1; }
    if (k == LFD_TK_SLIDER)      { return 1; }
    if (k == LFD_TK_LISTBOX)     { return 1; }
    if (k == LFD_TK_TEXTEDIT)    { return 1; }
    if (k == LFD_TK_PROGRESSBAR) { return 1; }
    if (k == LFD_TK_IMAGE)       { return 1; }
    if (k == LFD_TK_CUSTOM)      { return 1; }
    return 0;
}

fn _lfdIsLayout(k: int64): int64 {
    if (k == LFD_TK_LAYOUT)     { return 1; }
    if (k == LFD_TK_VERTICAL)   { return 1; }
    if (k == LFD_TK_HORIZONTAL) { return 1; }
    if (k == LFD_TK_GRID)       { return 1; }
    if (k == LFD_TK_STACK)      { return 1; }
    if (k == LFD_TK_GROUPBOX)   { return 1; }
    if (k == LFD_TK_TABWIDGET)  { return 1; }
    if (k == LFD_TK_SPLITTER)   { return 1; }
    return 0;
}

// Parse property value; returns new property node
fn _lfdParsePropVal(key: int64, keyLen: int64, istEreignis: int64): int64 {
    var art: int64 := LFD_NODE_PROPERTY;
    if (istEreignis != 0) { art := LFD_NODE_EVENT; }   // #1396
    var node: int64 := _lfdNewNode(art, key, keyLen);
    if (node == 0) { return 0; }
    var vk: int64 := _lfdTokKind();
    if (vk == LFD_TK_STRING || vk == LFD_TK_IDENTIFIER) {
        // #1393: Der Wert wurde bisher gelesen und VERWORFEN — text, tooltip
        // und onclick waren ueber die Schnittstelle nicht mehr erreichbar.
        poke64(node + 48, _lfdTokStart());
        poke64(node + 56, _lfdTokLen());
        _lfdAdvTok();
    } else if (vk == LFD_TK_NUMBER) {
        var ns: int64 := _lfdTokStart();
        var nl: int64 := _lfdTokLen();
        var neg: int64 := 0;
        var i: int64 := 0;
        if (nl > 0 && _lfdCh(ns) == 45) { neg := 1; i := 1; }   // #1394
        var num: int64 := 0;
        while (i < nl) {
            num := num * 10 + _lfdCh(ns + i) - 48;
            i += 1;
        }
        if (neg != 0) { num := 0 - num; }
        poke64(node + 40, num);
        _lfdAdvTok();
    } else if (vk == LFD_TK_TRUE) {
        poke64(node + 40, 1);
        _lfdAdvTok();
    } else if (vk == LFD_TK_FALSE) {
        poke64(node + 40, 0);
        _lfdAdvTok();
    }
    return node;
}

// Parse { body* } — fills parent's child list.
// _lfdParseElement is called forward (defined below); both are in the same
// compilation unit so cg_patchAll resolves the mutual recursion. ✓
fn _lfdParseBlock(parent: int64): void {
    _lfdExpect(LFD_TK_LBRACE);
    var sc: int64 := 1;
    while (sc == 1) {
        var k: int64 := _lfdTokKind();
        if (k == LFD_TK_RBRACE || k == LFD_TK_EOF) {
            sc := 0;
        }
        if (sc == 1) {
            var child: int64 := _lfdParseElement();
            if (child != 0) { _lfdAddChild(parent, child); }
            if (lfd_error_count > 16) { sc := 0; }
        }
    }
    _lfdExpect(LFD_TK_RBRACE);
}

// Parse one element: widget, layout, or property.  Returns node or 0.
fn _lfdParseElement(): int64 {
    var k: int64 := _lfdTokKind();

    // Widget or layout block: keyword ["label"] { ... }
    if (_lfdIsWidget(k) != 0 || _lfdIsLayout(k) != 0) {
        _lfdAdvTok();
        var txtPtr: int64 := 0;
        var txtLen: int64 := 0;
        if (_lfdTokKind() == LFD_TK_STRING) {
            txtPtr := _lfdTokStart();
            txtLen := _lfdTokLen();
            _lfdAdvTok();
        }
        var node: int64 := _lfdNewNode(k, txtPtr, txtLen);
        if (node != 0 && _lfdTokKind() == LFD_TK_LBRACE) {
            _lfdParseBlock(node);
        }
        return node;
    }

    // Property: (keyword | identifier) ':' value
    if (k == LFD_TK_IDENTIFIER || (k >= LFD_TK_TEXT && k <= LFD_TK_ONCHANGE)) {
        var ps: int64 := _lfdTokStart();
        var pl: int64 := _lfdTokLen();
        _lfdAdvTok();
        if (_lfdTokKind() == LFD_TK_COLON) {
            _lfdAdvTok();
            var ev: int64 := 0;
            if (k == LFD_TK_ONCLICK || k == LFD_TK_ONCHANGE) { ev := 1; }   // #1396
            return _lfdParsePropVal(ps, pl, ev);
        }
        lfd_error_count += 1;
        lfd_error_msg := "expected ':'";
        return 0;
    }

    _lfdAdvTok();  // skip unknown token
    return 0;
}

// Parse top-level form declaration
fn _lfdParseForm(): int64 {
    if (_lfdTokKind() != LFD_TK_FORM) {
        lfd_error_count += 1;
        lfd_error_msg := "expected 'form'";
        return 0;
    }
    _lfdAdvTok();
    var txtPtr: int64 := 0;
    var txtLen: int64 := 0;
    if (_lfdTokKind() == LFD_TK_STRING) {
        txtPtr := _lfdTokStart();
        txtLen := _lfdTokLen();
        _lfdAdvTok();
    }
    var node: int64 := _lfdNewNode(LFD_TK_FORM, txtPtr, txtLen);
    if (node != 0) { _lfdParseBlock(node); }
    return node;
}

// ============================================================================
// Internal cleanup
// ============================================================================

fn _lfdFreeBuffers(): void {
    if (lfd_tok_buf != 0) {
        free(lfd_tok_buf, lfd_tok_cap * LFD_TOK_SZ);
        lfd_tok_buf := 0;
    }
    if (lfd_pool != 0) {
        free(lfd_pool, lfd_pool_cap * LFD_NODE_SZ);
        lfd_pool := 0;
    }
    lfd_tok_cap   := 0;
    lfd_tok_count := 0;
    lfd_tok_pos   := 0;
    lfd_pool_cap  := 0;
    lfd_pool_sz   := 0;
}

// ============================================================================
// Public API
// ============================================================================

// Parse an LFD source string; returns root form node pointer, or -1 on error.
// The returned pointer is valid until the next LFDParseString call.
pub fn LFDParseString(input: pchar): int64 {
    _lfdFreeBuffers();
    lfd_error_count := 0;
    lfd_error_msg   := "";
    lfd_source      := input;
    lfd_source_len  := StrLen(input);

    if (lfd_source_len == 0) {
        lfd_error_count := 1;
        lfd_error_msg   := "empty input";
        return -1;
    }

    lfd_tok_cap := lfd_source_len + 4;
    lfd_tok_buf := alloc(lfd_tok_cap * LFD_TOK_SZ);
    if (lfd_tok_buf == 0) { return -1; }

    lfd_pool_cap := lfd_source_len / 4 + 16;
    lfd_pool     := alloc(lfd_pool_cap * LFD_NODE_SZ);
    if (lfd_pool == 0) { return -1; }

    _lfdLex();
    var root: int64 := _lfdParseForm();
    if (root == 0) { return -1; }
    return root;
}

// Return the type of a node (one of the LFD_TK_* constants), or -1 if null.
pub fn LFDGetNodeType(node: int64): int64 {
    if (node == 0) { return -1; }
    return peek64(node);
}

// Return the index-th child of node, or 0 if out of range.
pub fn LFDGetNodeChild(node: int64, index: int64): int64 {
    if (node == 0) { return 0; }
    var cur: int64 := peek64(node + 24);
    var i: int64 := 0;
    while (cur != 0) {
        if (i == index) { return cur; }
        cur := peek64(cur + 32);
        i += 1;
    }
    return 0;
}

// Return pointer into the source text for a node's label (not null-terminated).
pub fn LFDGetNodeText(node: int64): pchar {
    if (node == 0) { return ""; }
    var off: int64 := peek64(node + 8);
    if (off == 0) { return ""; }
    return (lfd_source as int64 + off) as pchar;
}

// #1395: LFDGetNodeText liefert einen Zeiger in den Quelltext, der NICHT
// nullterminiert ist — wer ihn direkt ausgibt, druckt den Rest des Formulars
// mit. Die Laenge stand nur bei Offset +16 im Knoten, ohne Getter: das
// Knotenlayout war damit faktisch Teil der Schnittstelle, weil kein Aufrufer
// ohne `peek64(node + 16)` auskam.
pub fn LFDGetNodeTextLen(node: int64): int64 {
    if (node == 0) { return 0; }
    return peek64(node + 16);
}

// Schreibt den Text nullterminiert nach dest und liefert die Zahl der
// geschriebenen Zeichen (ohne Abschluss). Passt er nicht, wird abgeschnitten —
// destMax zaehlt den Abschluss mit.
pub fn LFDCopyNodeText(node: int64, dest: int64, destMax: int64): int64 {
    if (dest == 0 || destMax <= 0) { return 0; }
    var len: int64 := LFDGetNodeTextLen(node);
    if (len > destMax - 1) { len := destMax - 1; }
    var src: int64 := 0;
    if (node != 0) { src := lfd_source as int64 + peek64(node + 8); }
    var i: int64 := 0;
    while (i < len) {
        poke8(dest + i, peek8(src + i));
        i += 1;
    }
    poke8(dest + i, 0);
    return len;
}

// #1393: Der Zeichenketten-WERT einer Eigenschaft. Dieselbe Form wie beim
// Text: Zeiger in den Quelltext plus Laenge, dazu eine kopierende Variante.
// 0 bzw. Laenge 0 heisst "kein Zeichenkettenwert" (Zahl, Wahrheitswert oder
// gar kein Wert).
pub fn LFDGetNodeValue(node: int64): pchar {
    if (node == 0) { return ""; }
    var off: int64 := peek64(node + 48);
    if (off == 0) { return ""; }
    return (lfd_source as int64 + off) as pchar;
}

pub fn LFDGetNodeValueLen(node: int64): int64 {
    if (node == 0) { return 0; }
    return peek64(node + 56);
}

pub fn LFDCopyNodeValue(node: int64, dest: int64, destMax: int64): int64 {
    if (dest == 0 || destMax <= 0) { return 0; }
    var len: int64 := LFDGetNodeValueLen(node);
    if (len > destMax - 1) { len := destMax - 1; }
    var src: int64 := 0;
    if (node != 0) { src := lfd_source as int64 + peek64(node + 48); }
    var i: int64 := 0;
    while (i < len) {
        poke8(dest + i, peek8(src + i));
        i += 1;
    }
    poke8(dest + i, 0);
    return len;
}

// #1396: Ist der Knoten ein Bedienelement? Eine einzelne Konstante kann das
// nicht beantworten — Bedienelemente tragen ihren konkreten Typ. Container
// (layout, vertical, groupbox …) zaehlen nicht dazu, dafuer gibt es
// LFDIsContainer.
pub fn LFDIsWidget(node: int64): int64 {
    if (node == 0) { return 0; }
    var k: int64 := peek64(node);
    if (k == LFD_TK_BUTTON)      { return 1; }
    if (k == LFD_TK_LABEL)       { return 1; }
    if (k == LFD_TK_INPUT)       { return 1; }
    if (k == LFD_TK_CHECKBOX)    { return 1; }
    if (k == LFD_TK_RADIOBUTTON) { return 1; }
    if (k == LFD_TK_COMBOBOX)    { return 1; }
    if (k == LFD_TK_SPINBOX)     { return 1; }
    if (k == LFD_TK_SLIDER)      { return 1; }
    if (k == LFD_TK_LISTBOX)     { return 1; }
    if (k == LFD_TK_TEXTEDIT)    { return 1; }
    if (k == LFD_TK_PROGRESSBAR) { return 1; }
    if (k == LFD_TK_IMAGE)       { return 1; }
    if (k == LFD_TK_CUSTOM)      { return 1; }
    return 0;
}

pub fn LFDIsContainer(node: int64): int64 {
    if (node == 0) { return 0; }
    var k: int64 := peek64(node);
    if (k == LFD_TK_LAYOUT)     { return 1; }
    if (k == LFD_TK_VERTICAL)   { return 1; }
    if (k == LFD_TK_HORIZONTAL) { return 1; }
    if (k == LFD_TK_GRID)       { return 1; }
    if (k == LFD_TK_STACK)      { return 1; }
    if (k == LFD_TK_GROUPBOX)   { return 1; }
    if (k == LFD_TK_TABWIDGET)  { return 1; }
    if (k == LFD_TK_SPLITTER)   { return 1; }
    return 0;
}

// Return number of direct children of node.
pub fn LFDGetNodeChildCount(node: int64): int64 {
    if (node == 0) { return 0; }
    var cur: int64 := peek64(node + 24);
    var count: int64 := 0;
    while (cur != 0) {
        count += 1;
        cur := peek64(cur + 32);
    }
    return count;
}

// Return the integer/bool value stored in a property node.
pub fn LFDGetNodeIntVal(node: int64): int64 {
    if (node == 0) { return 0; }
    return peek64(node + 40);
}

// ============================================================================
// Legacy API (backward compat)
// ============================================================================

pub fn LFDParserNew(sourceText: pchar): int64 {
    lfd_source     := sourceText;
    lfd_source_len := StrLen(sourceText);
    lfd_pos        := 0;
    lfd_error_count := 0;
    lfd_error_msg  := "";
    return 1;
}

pub fn LFDValidate(parser: int64): int64 {
    if (lfd_source_len == 0) {
        lfd_error_msg   := "Empty source";
        lfd_error_count := 1;
        return 0;
    }
    return 1;
}

pub fn LFDGetLastError(parser: int64): pchar {
    return lfd_error_msg;
}

pub fn LFDGetErrorCount(parser: int64): int64 {
    return lfd_error_count;
}

pub fn LFDParserFree(parser: int64): void {
    _lfdFreeBuffers();
    lfd_source     := "";
    lfd_source_len := 0;
    lfd_pos        := 0;
}
