// std/mqtt/props.lyx — MQTT 5.0 Properties: typisierter Vertrag.
//
// Jede Property hat genau einen Datentyp, eine Menge zulaessiger Pakete
// (einschliesslich Will-Properties) und eine Wiederholbarkeit. Ein unbekannter
// Identifier wird NICHT uebersprungen, sondern laut abgewiesen — die Laenge
// unbekannter Properties ist nicht bestimmbar, und ein Catch-all machte aus
// jeder Luecke stille Fehlfunktion (aurum/CLAUDE.md, "Stiller Default").
//
// Normbezug: MQTT 5.0 §2.2.2, §3.1.2.11, §3.3.2.3, Tabelle 2.4.
unit std.mqtt.props;

import std.mqtt.topic;    // MQ_OK
import std.mqtt.wire;     // Lese-Primitiven, Fehlercodes, Pakettypen

// --- Fehlercodes (Bereich -250..-279) --------------------------------------
pub con MQ_E_PROP_UNBEKANNT: int64  := -250;  // Identifier nicht in Tabelle 2.4
pub con MQ_E_PROP_PAKET: int64      := -251;  // in diesem Paket unzulaessig
pub con MQ_E_PROP_DOPPELT: int64    := -252;  // nicht wiederholbar
pub con MQ_E_PROP_WERT: int64       := -253;  // Wert ausserhalb des Bereichs
pub con MQ_E_PROP_LAENGE: int64     := -254;  // Property-Block passt nicht
pub con MQ_E_PROP_TABELLE: int64    := -255;  // Ergebnistabelle zu klein

// --- Datentypen ------------------------------------------------------------
pub con MQ_PT_BYTE: int64   := 1;
pub con MQ_PT_U16: int64    := 2;
pub con MQ_PT_U32: int64    := 3;
pub con MQ_PT_VARINT: int64 := 4;
pub con MQ_PT_UTF8: int64   := 5;
pub con MQ_PT_BIN: int64    := 6;
pub con MQ_PT_PAIR: int64   := 7;   // User Property: Name + Wert

// --- Identifier ------------------------------------------------------------
pub con MQ_P_PAYLOAD_FORMAT: int64     := 1;
pub con MQ_P_MESSAGE_EXPIRY: int64     := 2;
pub con MQ_P_CONTENT_TYPE: int64       := 3;
pub con MQ_P_RESPONSE_TOPIC: int64     := 8;
pub con MQ_P_CORRELATION_DATA: int64   := 9;
pub con MQ_P_SUBSCRIPTION_ID: int64    := 11;
pub con MQ_P_SESSION_EXPIRY: int64     := 17;
pub con MQ_P_ASSIGNED_CLIENTID: int64  := 18;
pub con MQ_P_SERVER_KEEPALIVE: int64   := 19;
pub con MQ_P_AUTH_METHOD: int64        := 21;
pub con MQ_P_AUTH_DATA: int64          := 22;
pub con MQ_P_REQ_PROBLEM_INFO: int64   := 23;
pub con MQ_P_WILL_DELAY: int64         := 24;
pub con MQ_P_REQ_RESPONSE_INFO: int64  := 25;
pub con MQ_P_RESPONSE_INFO: int64      := 26;
pub con MQ_P_SERVER_REFERENCE: int64   := 28;
pub con MQ_P_REASON_STRING: int64      := 31;
pub con MQ_P_RECEIVE_MAX: int64        := 33;
pub con MQ_P_TOPIC_ALIAS_MAX: int64    := 34;
pub con MQ_P_TOPIC_ALIAS: int64        := 35;
pub con MQ_P_MAX_QOS: int64            := 36;
pub con MQ_P_RETAIN_AVAILABLE: int64   := 37;
pub con MQ_P_USER_PROPERTY: int64      := 38;
pub con MQ_P_MAX_PACKET_SIZE: int64    := 39;
pub con MQ_P_WILDCARD_AVAIL: int64     := 40;
pub con MQ_P_SUBID_AVAIL: int64        := 41;
pub con MQ_P_SHARED_AVAIL: int64       := 42;

// --- Kontexte als Bitmaske -------------------------------------------------
// Bit n == Pakettyp n (1..15); Bit 0 steht fuer die Will-Properties, die im
// CONNECT-Payload stehen und einen eigenen Satz zulaessiger Properties haben.
pub con MQ_CTX_WILL: int64 := 0;

fn _bit(n: int64): int64 {
  var v: int64 := 1;
  var i: int64 := 0;
  while (i < n) { v := v * 2; i := i + 1; }
  return v;
}

// Kontextmaske fuer einen Pakettyp bzw. MQ_CTX_WILL.
pub fn MqPropKontext(typOderWill: int64): int64 { return _bit(typOderWill); }

// Datentyp einer Property. 0 == unbekannter Identifier (laut abweisen).
pub fn MqPropTyp(id: int64): int64 {
  if (id == MQ_P_PAYLOAD_FORMAT)    { return MQ_PT_BYTE; }
  if (id == MQ_P_MESSAGE_EXPIRY)    { return MQ_PT_U32; }
  if (id == MQ_P_CONTENT_TYPE)      { return MQ_PT_UTF8; }
  if (id == MQ_P_RESPONSE_TOPIC)    { return MQ_PT_UTF8; }
  if (id == MQ_P_CORRELATION_DATA)  { return MQ_PT_BIN; }
  if (id == MQ_P_SUBSCRIPTION_ID)   { return MQ_PT_VARINT; }
  if (id == MQ_P_SESSION_EXPIRY)    { return MQ_PT_U32; }
  if (id == MQ_P_ASSIGNED_CLIENTID) { return MQ_PT_UTF8; }
  if (id == MQ_P_SERVER_KEEPALIVE)  { return MQ_PT_U16; }
  if (id == MQ_P_AUTH_METHOD)       { return MQ_PT_UTF8; }
  if (id == MQ_P_AUTH_DATA)         { return MQ_PT_BIN; }
  if (id == MQ_P_REQ_PROBLEM_INFO)  { return MQ_PT_BYTE; }
  if (id == MQ_P_WILL_DELAY)        { return MQ_PT_U32; }
  if (id == MQ_P_REQ_RESPONSE_INFO) { return MQ_PT_BYTE; }
  if (id == MQ_P_RESPONSE_INFO)     { return MQ_PT_UTF8; }
  if (id == MQ_P_SERVER_REFERENCE)  { return MQ_PT_UTF8; }
  if (id == MQ_P_REASON_STRING)     { return MQ_PT_UTF8; }
  if (id == MQ_P_RECEIVE_MAX)       { return MQ_PT_U16; }
  if (id == MQ_P_TOPIC_ALIAS_MAX)   { return MQ_PT_U16; }
  if (id == MQ_P_TOPIC_ALIAS)       { return MQ_PT_U16; }
  if (id == MQ_P_MAX_QOS)           { return MQ_PT_BYTE; }
  if (id == MQ_P_RETAIN_AVAILABLE)  { return MQ_PT_BYTE; }
  if (id == MQ_P_USER_PROPERTY)     { return MQ_PT_PAIR; }
  if (id == MQ_P_MAX_PACKET_SIZE)   { return MQ_PT_U32; }
  if (id == MQ_P_WILDCARD_AVAIL)    { return MQ_PT_BYTE; }
  if (id == MQ_P_SUBID_AVAIL)       { return MQ_PT_BYTE; }
  if (id == MQ_P_SHARED_AVAIL)      { return MQ_PT_BYTE; }
  return 0;
}

// Maske der Pakete, in denen die Property stehen darf (MQTT 5.0 Tabelle 2.4).
pub fn MqPropErlaubt(id: int64): int64 {
  var will: int64 := _bit(MQ_CTX_WILL);
  var conn: int64 := _bit(MQ_CONNECT);
  var cack: int64 := _bit(MQ_CONNACK);
  var publ: int64 := _bit(MQ_PUBLISH);
  var pack: int64 := _bit(MQ_PUBACK);
  var prec: int64 := _bit(MQ_PUBREC);
  var prel: int64 := _bit(MQ_PUBREL);
  var pcom: int64 := _bit(MQ_PUBCOMP);
  var sub: int64  := _bit(MQ_SUBSCRIBE);
  var sack: int64 := _bit(MQ_SUBACK);
  var unsu: int64 := _bit(MQ_UNSUBSCRIBE);
  var uack: int64 := _bit(MQ_UNSUBACK);
  var disc: int64 := _bit(MQ_DISCONNECT);
  var auth: int64 := _bit(MQ_AUTH);

  if (id == MQ_P_PAYLOAD_FORMAT)    { return publ | will; }
  if (id == MQ_P_MESSAGE_EXPIRY)    { return publ | will; }
  if (id == MQ_P_CONTENT_TYPE)      { return publ | will; }
  if (id == MQ_P_RESPONSE_TOPIC)    { return publ | will; }
  if (id == MQ_P_CORRELATION_DATA)  { return publ | will; }
  if (id == MQ_P_SUBSCRIPTION_ID)   { return publ | sub; }
  if (id == MQ_P_SESSION_EXPIRY)    { return conn | cack | disc; }
  if (id == MQ_P_ASSIGNED_CLIENTID) { return cack; }
  if (id == MQ_P_SERVER_KEEPALIVE)  { return cack; }
  if (id == MQ_P_AUTH_METHOD)       { return conn | cack | auth; }
  if (id == MQ_P_AUTH_DATA)         { return conn | cack | auth; }
  if (id == MQ_P_REQ_PROBLEM_INFO)  { return conn; }
  if (id == MQ_P_WILL_DELAY)        { return will; }
  if (id == MQ_P_REQ_RESPONSE_INFO) { return conn; }
  if (id == MQ_P_RESPONSE_INFO)     { return cack; }
  if (id == MQ_P_SERVER_REFERENCE)  { return cack | disc; }
  if (id == MQ_P_REASON_STRING) {
    return cack | pack | prec | prel | pcom | sack | uack | disc | auth;
  }
  if (id == MQ_P_RECEIVE_MAX)       { return conn | cack; }
  if (id == MQ_P_TOPIC_ALIAS_MAX)   { return conn | cack; }
  if (id == MQ_P_TOPIC_ALIAS)       { return publ; }
  if (id == MQ_P_MAX_QOS)           { return cack; }
  if (id == MQ_P_RETAIN_AVAILABLE)  { return cack; }
  if (id == MQ_P_USER_PROPERTY) {
    return conn | cack | publ | pack | prec | prel | pcom | sub | sack |
           unsu | uack | disc | auth | will;
  }
  if (id == MQ_P_MAX_PACKET_SIZE)   { return conn | cack; }
  if (id == MQ_P_WILDCARD_AVAIL)    { return cack; }
  if (id == MQ_P_SUBID_AVAIL)       { return cack; }
  if (id == MQ_P_SHARED_AVAIL)      { return cack; }
  return 0;     // unbekannt: nirgends erlaubt
}

// Wiederholbarkeit. User Property immer; Subscription Identifier NUR im
// PUBLISH (eine Nachricht kann mehrere Abonnements treffen), im SUBSCRIBE
// genau einmal (MQTT 5.0 §3.3.2.3.8, §3.8.2.1.2).
pub fn MqPropWiederholbar(id: int64, kontext: int64): bool {
  if (id == MQ_P_USER_PROPERTY) { return true; }
  if (id == MQ_P_SUBSCRIPTION_ID) { return kontext == MQ_PUBLISH; }
  return false;
}

// Wertebereich der Properties mit Zahlwert. MQ_OK oder MQ_E_PROP_WERT.
pub fn MqPropWertPruefe(id: int64, wert: int64): int64 {
  if (id == MQ_P_PAYLOAD_FORMAT || id == MQ_P_REQ_PROBLEM_INFO ||
      id == MQ_P_REQ_RESPONSE_INFO || id == MQ_P_MAX_QOS ||
      id == MQ_P_RETAIN_AVAILABLE || id == MQ_P_WILDCARD_AVAIL ||
      id == MQ_P_SUBID_AVAIL || id == MQ_P_SHARED_AVAIL) {
    // Maximum QoS ist 0 oder 1; 2 wird durch Weglassen ausgedrueckt.
    if (wert != 0 && wert != 1) { return MQ_E_PROP_WERT; }
    return MQ_OK;
  }
  if (id == MQ_P_RECEIVE_MAX || id == MQ_P_TOPIC_ALIAS) {
    if (wert < 1) { return MQ_E_PROP_WERT; }     // 0 ist Protokollfehler
    return MQ_OK;
  }
  if (id == MQ_P_MAX_PACKET_SIZE) {
    if (wert < 1) { return MQ_E_PROP_WERT; }
    return MQ_OK;
  }
  if (id == MQ_P_SUBSCRIPTION_ID) {
    if (wert < 1 || wert > MQ_VARINT_MAX) { return MQ_E_PROP_WERT; }
    return MQ_OK;
  }
  return MQ_OK;    // Properties ohne eigene Bereichsregel
}

// --- Ergebnistabelle -------------------------------------------------------
// Ein Eintrag, 40 Byte. Reihenfolge der Eintraege ist die Reihenfolge auf der
// Leitung — wiederholte User Properties bleiben geordnet (M5-01).
pub con MQ_PE_ID: int64      := 0;
pub con MQ_PE_TYP: int64     := 8;
pub con MQ_PE_WERT: int64    := 16;   // Zahlwert, oder Offset bei UTF8/BIN/PAIR
pub con MQ_PE_LEN: int64     := 24;   // Laenge bei UTF8/BIN/PAIR (Name)
pub con MQ_PE_WOFF: int64    := 32;   // PAIR: Offset des Wertes (Laenge in WLEN)
pub con MQ_PE_GROESSE: int64 := 40;
// PAIR-Wertlaenge liegt in einem zweiten Platz; damit der Eintrag 40 Byte
// bleibt, traegt MQ_PE_LEN die Namenslaenge und MQ_PE_WOFF das Paar
// (Offset * 65536 + Laenge) — beide passen, da MQTT-Strings <= 65535 sind und
// der Offset durch die Paketgrenze beschraenkt ist.
pub fn MqPePairWertOff(e: int64): int64 { return peek64(e + MQ_PE_WOFF) / 65536; }
pub fn MqPePairWertLen(e: int64): int64 { return peek64(e + MQ_PE_WOFF) & 0xFFFF; }

pub fn MqPropEintragGroesse(): int64 { return MQ_PE_GROESSE; }

// Dekodiert den Property-Block ab `pos` in `buf` (Laenge `len`) fuer den
// Kontext `kontext` (Pakettyp oder MQ_CTX_WILL).
// `tab` ist 0 oder eine Tabelle mit `tabMax` Eintraegen; `anzahlAus` ist 0 oder
// die Adresse eines int64-Platzes fuer die Anzahl der Eintraege.
// Rueckgabe: Position hinter dem Block oder Fehlercode.
pub fn MqPropsLies(buf: int64, len: int64, pos: int64, kontext: int64,
                   tab: int64, tabMax: int64, anzahlAus: int64): int64 {
  var blockBytes: int64 := MqVarintBytes(buf, len, pos);
  if (blockBytes < 0) { return blockBytes; }
  var blockLen: int64 := MqVarintWert(buf, len, pos);
  if (blockLen < 0) { return blockLen; }
  var np: int64 := pos + blockBytes;
  if (np + blockLen > len) { return MQ_E_PROP_LAENGE; }
  var ende: int64 := np + blockLen;
  var kmaske: int64 := _bit(kontext);
  var n: int64 := 0;
  var p: int64 := np;
  // Gesehene Identifier als Bitmaske; Tabelle 2.4 endet bei 42.
  var gesehen: int64 := 0;
  while (p < ende) {
    var idBytes: int64 := MqVarintBytes(buf, ende, p);
    if (idBytes < 0) { return idBytes; }
    var id: int64 := MqVarintWert(buf, ende, p);
    if (id < 0) { return id; }
    var typ: int64 := MqPropTyp(id);
    if (typ == 0) { return MQ_E_PROP_UNBEKANNT; }
    if ((MqPropErlaubt(id) & kmaske) == 0) { return MQ_E_PROP_PAKET; }
    if (id < 64) {
      var bitId: int64 := _bit(id);
      if ((gesehen & bitId) != 0 && !MqPropWiederholbar(id, kontext)) {
        return MQ_E_PROP_DOPPELT;
      }
      gesehen := gesehen | bitId;
    }
    var q: int64 := p + idBytes;
    var wert: int64 := 0;
    var woff: int64 := 0;
    var wlen: int64 := 0;
    if (typ == MQ_PT_BYTE) {
      wert := MqU8Wert(buf, ende, q);
      if (wert < 0) { return wert; }
      q := q + 1;
    } else if (typ == MQ_PT_U16) {
      wert := MqU16Wert(buf, ende, q);
      if (wert < 0) { return wert; }
      q := q + 2;
    } else if (typ == MQ_PT_U32) {
      wert := MqU32Wert(buf, ende, q);
      if (wert < 0) { return wert; }
      q := q + 4;
    } else if (typ == MQ_PT_VARINT) {
      var vb: int64 := MqVarintBytes(buf, ende, q);
      if (vb < 0) { return vb; }
      wert := MqVarintWert(buf, ende, q);
      if (wert < 0) { return wert; }
      q := q + vb;
    } else if (typ == MQ_PT_UTF8) {
      wlen := MqStrFeldLen(buf, ende, q);
      if (wlen < 0) { return wlen; }
      woff := q + 2;
      q := woff + wlen;
    } else if (typ == MQ_PT_BIN) {
      wlen := MqFeldLen(buf, ende, q);
      if (wlen < 0) { return wlen; }
      woff := q + 2;
      q := woff + wlen;
    } else if (typ == MQ_PT_PAIR) {
      wlen := MqStrFeldLen(buf, ende, q);
      if (wlen < 0) { return wlen; }
      woff := q + 2;
      q := woff + wlen;
      var vlen: int64 := MqStrFeldLen(buf, ende, q);
      if (vlen < 0) { return vlen; }
      // Wertsicht als Offset * 65536 + Laenge; MQTT-Strings sind <= 65535.
      wert := (q + 2) * 65536 + vlen;
      q := q + 2 + vlen;
    } else {
      return MQ_E_PROP_UNBEKANNT;      // kein Catch-all mit Vermutung
    }
    if (typ == MQ_PT_BYTE || typ == MQ_PT_U16 || typ == MQ_PT_U32 ||
        typ == MQ_PT_VARINT) {
      var rcw: int64 := MqPropWertPruefe(id, wert);
      if (rcw != MQ_OK) { return rcw; }
    }
    if (tab != 0) {
      if (n >= tabMax) { return MQ_E_PROP_TABELLE; }
      var e: int64 := tab + n * MQ_PE_GROESSE;
      poke64(e + MQ_PE_ID, id);
      poke64(e + MQ_PE_TYP, typ);
      if (typ == MQ_PT_UTF8 || typ == MQ_PT_BIN) {
        poke64(e + MQ_PE_WERT, woff);
        poke64(e + MQ_PE_LEN, wlen);
        poke64(e + MQ_PE_WOFF, 0);
      } else if (typ == MQ_PT_PAIR) {
        poke64(e + MQ_PE_WERT, woff);     // Name
        poke64(e + MQ_PE_LEN, wlen);
        poke64(e + MQ_PE_WOFF, wert);     // Wert: off * 65536 + len
      } else {
        poke64(e + MQ_PE_WERT, wert);
        poke64(e + MQ_PE_LEN, 0);
        poke64(e + MQ_PE_WOFF, 0);
      }
    }
    n := n + 1;
    p := q;
  }
  if (p != ende) { return MQ_E_PROP_LAENGE; }   // letzte Property ragt hinaus
  if (anzahlAus != 0) { poke64(anzahlAus, n); }
  return ende;
}

// Sucht die erste Property mit `id` in der Tabelle. Rueckgabe: Eintragsadresse
// oder 0. Fuer wiederholbare Properties ueber den Index laufen.
pub fn MqPropFinde(tab: int64, anzahl: int64, id: int64): int64 {
  var i: int64 := 0;
  while (i < anzahl) {
    var e: int64 := tab + i * MQ_PE_GROESSE;
    if (peek64(e + MQ_PE_ID) == id) { return e; }
    i := i + 1;
  }
  return 0;
}

// --- Schreiben -------------------------------------------------------------
// Die Property-Blocklaenge steht als Variable Byte Integer VOR dem Block. Da
// sie erst nach dem Schreiben bekannt ist, wird der Block an `pos + reserve`
// aufgebaut und die Laenge danach davor geschrieben; `reserve` muss
// MqVarintLen(Blocklaenge) betragen. MqPropsBlockStart liefert die Reserve
// fuer eine bekannte Blocklaenge.
pub fn MqPropsReserve(blockLen: int64): int64 { return MqVarintLen(blockLen); }

pub fn MqPropByteSchreib(buf: int64, cap: int64, pos: int64,
                         id: int64, wert: int64): int64 {
  if (MqPropTyp(id) != MQ_PT_BYTE) { return MQ_E_PROP_WERT; }
  var rc: int64 := MqPropWertPruefe(id, wert);
  if (rc != MQ_OK) { return rc; }
  var p: int64 := MqVarintSchreib(buf, cap, pos, id);
  if (p < 0) { return p; }
  return MqU8Schreib(buf, cap, p, wert);
}

pub fn MqPropU16Schreib(buf: int64, cap: int64, pos: int64,
                        id: int64, wert: int64): int64 {
  if (MqPropTyp(id) != MQ_PT_U16) { return MQ_E_PROP_WERT; }
  var rc: int64 := MqPropWertPruefe(id, wert);
  if (rc != MQ_OK) { return rc; }
  var p: int64 := MqVarintSchreib(buf, cap, pos, id);
  if (p < 0) { return p; }
  return MqU16Schreib(buf, cap, p, wert);
}

pub fn MqPropU32Schreib(buf: int64, cap: int64, pos: int64,
                        id: int64, wert: int64): int64 {
  if (MqPropTyp(id) != MQ_PT_U32) { return MQ_E_PROP_WERT; }
  var rc: int64 := MqPropWertPruefe(id, wert);
  if (rc != MQ_OK) { return rc; }
  var p: int64 := MqVarintSchreib(buf, cap, pos, id);
  if (p < 0) { return p; }
  return MqU32Schreib(buf, cap, p, wert);
}

pub fn MqPropVarintSchreib(buf: int64, cap: int64, pos: int64,
                           id: int64, wert: int64): int64 {
  if (MqPropTyp(id) != MQ_PT_VARINT) { return MQ_E_PROP_WERT; }
  var rc: int64 := MqPropWertPruefe(id, wert);
  if (rc != MQ_OK) { return rc; }
  var p: int64 := MqVarintSchreib(buf, cap, pos, id);
  if (p < 0) { return p; }
  return MqVarintSchreib(buf, cap, p, wert);
}

pub fn MqPropStrSchreib(buf: int64, cap: int64, pos: int64,
                        id: int64, str: int64, n: int64): int64 {
  var typ: int64 := MqPropTyp(id);
  if (typ != MQ_PT_UTF8 && typ != MQ_PT_BIN) { return MQ_E_PROP_WERT; }
  var p: int64 := MqVarintSchreib(buf, cap, pos, id);
  if (p < 0) { return p; }
  if (typ == MQ_PT_UTF8) { return MqStrSchreib(buf, cap, p, str, n); }
  return MqBinSchreib(buf, cap, p, str, n);
}

pub fn MqPropPaarSchreib(buf: int64, cap: int64, pos: int64,
                         name: int64, nameN: int64,
                         wert: int64, wertN: int64): int64 {
  var p: int64 := MqVarintSchreib(buf, cap, pos, MQ_P_USER_PROPERTY);
  if (p < 0) { return p; }
  p := MqStrSchreib(buf, cap, p, name, nameN);
  if (p < 0) { return p; }
  return MqStrSchreib(buf, cap, p, wert, wertN);
}
