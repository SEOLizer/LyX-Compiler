// std/meta_safe.lyx — WP-3.2 / #1877 / #1879: Integritaetspruefung
//
// ZWEI verschiedene Fragen, und sie duerfen nicht verwechselt werden:
//
//   MetaSafeVerify()        liest /proc/self/exe und rechnet ueber den
//                           DATEIINHALT. Das erkennt eine Manipulation der
//                           Datei nach dem Uebersetzen — Post-Patching. Es
//                           erkennt KEINEN Kipper in einer bereits geladenen,
//                           privaten Codeseite: die Datei ist dann noch heil.
//
//   MetaSafeVerifyMemory()  rechnet ueber die GELADENEN Seiten zwischen
//                           code_start_va und code_end_va. Das ist die Frage,
//                           die der Strahlenschutz stellt (#1879).
//
// Beide holen die Referenzhashes aus der `.meta_safe`-Sektion. Im Format v2
// (#1877) liegt die Hashtabelle DREIFACH vor, je `stride` Byte auseinander;
// gelesen wird per Mehrheitsentscheid. Stimmen alle drei Kopien nicht
// ueberein, wird das als EIGENER Fall gemeldet (-3) und nicht still auf die
// erste Kopie zurueckgefallen — sonst waere ein Defekt in der Tabelle von
// einem Defekt im Code nicht zu unterscheiden.
//
// Keine der beiden Funktionen laeuft von selbst. Der periodische Sweep
// entsteht im Compiler aus `@integrity(mode: scrubbed)` (#1878); er traegt
// seine eigene Tabelle im Datenbereich und braucht diese Unit nicht.
@capabilities([fs.meta, fs.read])

unit std.meta_safe;

import std.alloc;
// ============================================================================
// CRC32 (mirrors the compiler's ms_crc32 implementation)
// ============================================================================

fn _ms_crc32(data: int64, len: int64): int64 {
  var crc: int64 := 0xFFFFFFFF;
  var i: int64 := 0;
  while (i < len) {
    crc := crc ^ (peek8(data + i) & 0xFF);
    var b: int64 := 0;
    while (b < 8) {
      if ((crc & 1) != 0) {
        crc := ((crc >> 1) & 0x7FFFFFFF) ^ (0 - 306674912);
      } else {
        crc := (crc >> 1) & 0x7FFFFFFF;
      }
      b += 1;
    }
    i += 1;
  }
  return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF;
}

// ============================================================================
// ELF section finder: locate .meta_safe in /proc/self/exe
// Returns: pointer to the .meta_safe payload, or 0 if not found.
// Sets *outPayloadSize to the section size.
// ============================================================================

fn _ms_findSection(binBuf: int64, binSize: int64, outOff: int64, outSize: int64): int64 {
  // Validate ELF magic
  if (peek8(binBuf + 0) != 0x7F) { return 0; }
  if (peek8(binBuf + 1) != 69)   { return 0; }  // 'E'
  if (peek8(binBuf + 2) != 76)   { return 0; }  // 'L'
  if (peek8(binBuf + 3) != 70)   { return 0; }  // 'F'

  var shoff:    int64 := peek64(binBuf + 40);  // e_shoff
  var shnum:    int64 := peek16(binBuf + 60) as int64;  // e_shnum
  var shstrndx: int64 := peek16(binBuf + 62) as int64;  // e_shstrndx

  if (shoff == 0 || shnum == 0 || shstrndx == 0) { return 0; }

  // Get .shstrtab section
  var shstrHdr: int64 := binBuf + shoff + shstrndx * 64;
  var shstrOff: int64 := peek64(shstrHdr + 24);  // sh_offset
  var shstrBuf: int64 := binBuf + shstrOff;

  // Scan sections for ".meta_safe"
  var si: int64 := 0;
  while (si < shnum) {
    var shdr:    int64 := binBuf + shoff + si * 64;
    var nameOff: int64 := peek32(shdr) & 0xFFFFFFFF;  // sh_name
    var secOff:  int64 := peek64(shdr + 24);           // sh_offset
    var secSize: int64 := peek64(shdr + 32);           // sh_size

    // Compare name against ".meta_safe"
    var nptr: int64 := shstrBuf + nameOff;
    if (peek8(nptr + 0) == 46  &&   // '.'
        peek8(nptr + 1) == 109 &&   // 'm'
        peek8(nptr + 2) == 101 &&   // 'e'
        peek8(nptr + 3) == 116 &&   // 't'
        peek8(nptr + 4) == 97  &&   // 'a'
        peek8(nptr + 5) == 95  &&   // '_'
        peek8(nptr + 6) == 115 &&   // 's'
        peek8(nptr + 7) == 97  &&   // 'a'
        peek8(nptr + 8) == 102 &&   // 'f'
        peek8(nptr + 9) == 101) {   // 'e'
      poke64(outOff, secOff);
      poke64(outSize, secSize);
      return 1;
    }
    si += 1;
  }
  return 0;
}

// ============================================================================
// Kopf lesen — v1 ("META") und v2 ("METASAF2")
// ============================================================================

// Version des Formats: 2, 1, oder 0 wenn die Kennung nicht stimmt.
fn _ms_version(payload: int64): int64 {
  if (peek8(payload + 0) != 77 || peek8(payload + 1) != 69 ||
      peek8(payload + 2) != 84 || peek8(payload + 3) != 65) { return 0; }
  if (peek8(payload + 4) == 83 && peek8(payload + 5) == 65 &&
      peek8(payload + 6) == 70 && peek8(payload + 7) == 50) { return 2; }
  return 1;
}

fn _ms_pageCount(payload: int64, ver: int64): int64 {
  if (ver == 2) { return peek32(payload + 8) & 0xFFFFFFFF; }
  return peek32(payload + 4) & 0xFFFFFFFF;
}

fn _ms_codeLen(payload: int64, ver: int64): int64 {
  if (ver == 2) { return peek64(payload + 16); }
  return peek64(payload + 8);
}

// Startadresse des geladenen Codes. v1 kannte sie nicht — dort ist die Frage
// nach dem SPEICHER nicht beantwortbar, und genau das meldet der Aufrufer.
fn _ms_codeStartVa(payload: int64, ver: int64): int64 {
  if (ver == 2) { return peek64(payload + 24); }
  return 0;
}

fn _ms_stride(payload: int64, ver: int64): int64 {
  if (ver == 2) { return peek32(payload + 44) & 0xFFFFFFFF; }
  return 0;
}

fn _ms_tableOff(ver: int64): int64 {
  if (ver == 2) { return 64; }
  return 16;
}

// Mehrheitsentscheid ueber die drei Kopien. Rueckgabe: der Hash, oder
// MS_KEINE_MEHRHEIT, wenn alle drei verschieden sind.
pub con MS_KEINE_MEHRHEIT: int64 := 0 - 3;

fn _ms_hashMehrheit(payload: int64, ver: int64, idx: int64): int64 {
  var basis: int64 := payload + _ms_tableOff(ver) + idx * 8;
  if (ver != 2) { return peek32(basis + 4) & 0xFFFFFFFF; }
  var stride: int64 := _ms_stride(payload, ver);
  var a: int64 := peek32(basis + 4) & 0xFFFFFFFF;
  var b: int64 := peek32(basis + stride + 4) & 0xFFFFFFFF;
  var c: int64 := peek32(basis + stride + stride + 4) & 0xFFFFFFFF;
  if (a == b) { return a; }
  if (a == c) { return a; }
  if (b == c) { return b; }
  return MS_KEINE_MEHRHEIT;
}

// ============================================================================
// Sektion samt Abbild holen. Rueckgabe: Zeiger auf die Nutzlast, oder 0.
// Der Aufrufer bekommt ueber outBin/outSize den Puffer zum Freigeben.
// ============================================================================
fn _ms_lade(outBin: int64, outSize: int64): int64 {
  var selfExe: pchar := "/proc/self/exe"c;
  var fd: int64 := open(selfExe, 0, 0);
  if (fd < 0) { return 0; }
  var binSize: int64 := lseek(fd, 0, 2);
  lseek(fd, 0, 0);
  var binBuf: int64 := alloc(binSize + 1);
  if (read(fd, binBuf as pchar, binSize) != binSize) {
    close(fd); free(binBuf, binSize + 1); return 0;
  }
  close(fd);

  var secOffBuf:  int64 := alloc(16);
  var secSizeBuf: int64 := secOffBuf + 8;
  var found: int64 := _ms_findSection(binBuf, binSize, secOffBuf, secSizeBuf);
  var secOff: int64 := peek64(secOffBuf);
  free(secOffBuf, 16);
  if (found == 0) { free(binBuf, binSize + 1); return 0; }

  poke64(outBin, binBuf);
  poke64(outSize, binSize + 1);
  return binBuf + secOff;
}

// ============================================================================
// Public API
// ============================================================================

// Fassung der Sektion: 2, 1, oder -1 wenn keine da ist.
pub fn MetaSafeFormatVersion(): int64 {
  var hb: int64 := alloc(16);
  var payload: int64 := _ms_lade(hb, hb + 8);
  if (payload == 0) { free(hb, 16); return 0 - 1; }
  var ver: int64 := _ms_version(payload);
  free(peek64(hb), peek64(hb + 8));
  free(hb, 16);
  if (ver == 0) { return 0 - 1; }
  return ver;
}

// MetaSafeVerify: prueft die DATEI (/proc/self/exe) gegen die Referenzhashes.
// 0 = heil, -1 = veraendert oder keine Sektion, -3 = Tabelle ohne Mehrheit.
//
// Das ist eine Aussage ueber die Datei, NICHT ueber den laufenden Code. Fuer
// die zweite Frage gibt es MetaSafeVerifyMemory.
pub fn MetaSafeVerify(): int64 {
  var hb: int64 := alloc(16);
  var payload: int64 := _ms_lade(hb, hb + 8);
  if (payload == 0) { free(hb, 16); return 0 - 1; }
  var binBuf:  int64 := peek64(hb);
  var binLen:  int64 := peek64(hb + 8);

  var ver: int64 := _ms_version(payload);
  if (ver == 0) { free(binBuf, binLen); free(hb, 16); return 0 - 1; }

  var pageCount: int64 := _ms_pageCount(payload, ver);
  var codeLen:   int64 := _ms_codeLen(payload, ver);
  var codeOff:   int64 := 176;   // statisches x86-64-ELF: .text bei 176
  var result: int64 := 0;
  var pi: int64 := 0;
  while (pi < pageCount) {
    var storedCrc: int64 := _ms_hashMehrheit(payload, ver, pi);
    if (storedCrc == MS_KEINE_MEHRHEIT) { result := MS_KEINE_MEHRHEIT; break; }
    var pageOff:   int64 := pi * 4096;
    var remaining: int64 := codeLen - pageOff;
    var len:       int64 := 4096;
    if (remaining < 4096) { len := remaining; }
    if (len <= 0) { result := 0 - 1; break; }
    if (_ms_crc32(binBuf + codeOff + pageOff, len) != storedCrc) { result := 0 - 1; break; }
    pi := pi + 1;
  }
  free(binBuf, binLen);
  free(hb, 16);
  return result;
}

// MetaSafeVerifyMemory: prueft den GELADENEN Code zwischen code_start_va und
// code_end_va gegen dieselben Referenzhashes.
//   0  = heil
//  -1  = eine Seite weicht ab
//  -2  = keine Sektion, oder v1 (dort fehlt code_start_va — die Frage ist mit
//        dieser Sektion nicht beantwortbar, und "0" waere gelogen)
//  -3  = die drei Hashkopien haben keine Mehrheit
pub fn MetaSafeVerifyMemory(): int64 {
  var hb: int64 := alloc(16);
  var payload: int64 := _ms_lade(hb, hb + 8);
  if (payload == 0) { free(hb, 16); return 0 - 2; }
  var binBuf: int64 := peek64(hb);
  var binLen: int64 := peek64(hb + 8);

  var ver: int64 := _ms_version(payload);
  if (ver != 2) { free(binBuf, binLen); free(hb, 16); return 0 - 2; }
  var startVa: int64 := _ms_codeStartVa(payload, ver);
  if (startVa == 0) { free(binBuf, binLen); free(hb, 16); return 0 - 2; }

  var pageCount: int64 := _ms_pageCount(payload, ver);
  var codeLen:   int64 := _ms_codeLen(payload, ver);
  var result: int64 := 0;
  var pi: int64 := 0;
  while (pi < pageCount) {
    var storedCrc: int64 := _ms_hashMehrheit(payload, ver, pi);
    if (storedCrc == MS_KEINE_MEHRHEIT) { result := MS_KEINE_MEHRHEIT; break; }
    var pageOff:   int64 := pi * 4096;
    var remaining: int64 := codeLen - pageOff;
    var len:       int64 := 4096;
    if (remaining < 4096) { len := remaining; }
    if (len <= 0) { result := 0 - 1; break; }
    if (_ms_crc32(startVa + pageOff, len) != storedCrc) { result := 0 - 1; break; }
    pi := pi + 1;
  }
  free(binBuf, binLen);
  free(hb, 16);
  return result;
}

// MetaSafeGetPageHash: der abgelegte CRC32 der Seite `pageIdx` — im Format v2
// per Mehrheit aus den drei Kopien. -1 wenn es die Seite nicht gibt.
pub fn MetaSafeGetPageHash(pageIdx: int64): int64 {
  var hb: int64 := alloc(16);
  var payload: int64 := _ms_lade(hb, hb + 8);
  if (payload == 0) { free(hb, 16); return 0 - 1; }
  var binBuf: int64 := peek64(hb);
  var binLen: int64 := peek64(hb + 8);
  var ver: int64 := _ms_version(payload);
  var result: int64 := 0 - 1;
  if (ver != 0) {
    var pageCount: int64 := _ms_pageCount(payload, ver);
    if (pageIdx >= 0 && pageIdx < pageCount) {
      result := _ms_hashMehrheit(payload, ver, pageIdx);
    }
  }
  free(binBuf, binLen);
  free(hb, 16);
  return result;
}

// Anzahl der abgedeckten Codeseiten, oder -1.
pub fn MetaSafePageCount(): int64 {
  var hb: int64 := alloc(16);
  var payload: int64 := _ms_lade(hb, hb + 8);
  if (payload == 0) { free(hb, 16); return 0 - 1; }
  var binBuf: int64 := peek64(hb);
  var binLen: int64 := peek64(hb + 8);
  var ver: int64 := _ms_version(payload);
  var result: int64 := 0 - 1;
  if (ver != 0) { result := _ms_pageCount(payload, ver); }
  free(binBuf, binLen);
  free(hb, 16);
  return result;
}
