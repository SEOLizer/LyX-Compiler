unit std.rect;

import std.vector;
import std.math;   // #1480: Hypot64 fuer den euklidischen Abstand

// ============================================================================
// Rect - Axis-Aligned Bounding Box
// ============================================================================

pub type Rect = struct {
  min: Vec2;  // Minimum point (top-left in screen coords)
  max: Vec2;   // Maximum point (bottom-right in screen coords)
}

// ============================================================================
// Constructors
// ============================================================================

pub fn RectNew(min: Vec2, max: Vec2): Rect {
  var _sl26: Rect;
  _sl26.min := min;
  _sl26.max := max;
  return _sl26;
}

pub fn RectFromPoints(p1: Vec2, p2: Vec2): Rect {
  var _sl30: Rect;
  _sl30.min := Vec2Min(p1, p2);
  _sl30.max := Vec2Max(p1, p2);
  return _sl30;
}

pub fn RectFromCenterSize(center: Vec2, size: Vec2): Rect {
  var half: Vec2;
  half.x := size.x / 2;
  half.y := size.y / 2;
  var _sl35: Rect;
  _sl35.min := Vec2Sub(center, half);
  _sl35.max := Vec2Add(center, half);
  return _sl35;
}

pub fn RectEmpty(): Rect {
  var _sl39: Rect;
  var _sl391: Vec2;
  _sl391.x := 0;
  _sl391.y := 0;
  _sl39.min := _sl391;
  var _sl392: Vec2;
  _sl392.x := 0;
  _sl392.y := 0;
  _sl39.max := _sl392;
  return _sl39;
}

pub fn RectFromXYWH(x: int64, y: int64, w: int64, h: int64): Rect {
  var _sl43: Rect;
  var _sl431: Vec2;
  _sl431.x := x;
  _sl431.y := y;
  _sl43.min := _sl431;
  var _sl432: Vec2;
  _sl432.x := x + w;
  _sl432.y := y + h;
  _sl43.max := _sl432;
  return _sl43;
}

// ============================================================================
// Properties
// ============================================================================

pub fn RectWidth(r: Rect): int64 {
  return r.max.x - r.min.x;
}

pub fn RectHeight(r: Rect): int64 {
  return r.max.y - r.min.y;
}

pub fn RectSize(r: Rect): Vec2 {
  var _sl59: Vec2;
  _sl59.x := RectWidth(r);
  _sl59.y := RectHeight(r);
  return _sl59;
}

pub fn RectCenter(r: Rect): Vec2 {
  var cx: int64 := r.min.x + r.max.x;
  var cy: int64 := r.min.y + r.max.y;
  var _sl65: Vec2;
  _sl65.x := cx / 2;
  _sl65.y := cy / 2;
  return _sl65;
}

pub fn RectArea(r: Rect): int64 {
  return RectWidth(r) * RectHeight(r);
}

pub fn RectIsEmpty(r: Rect): bool {
  return (r.max.x <= r.min.x) || (r.max.y <= r.min.y);
}

pub fn RectIsValid(r: Rect): bool {
  return (r.max.x > r.min.x) && (r.max.y > r.min.y);
}

// ============================================================================
// Point containment
// ============================================================================

// #1479: Die beiden waren vertauscht. `RectContains` prueft jetzt HALBOFFEN
// (min gehoert dazu, max nicht) — das ist die uebliche Bedeutung fuer
// Rasterflaechen: zwei aneinandergrenzende Rechtecke teilen sich keinen Punkt,
// und die Breite ist genau `max - min`. `RectContainsInclusive` nimmt beide
// Raender, wie sein Name sagt.
pub fn RectContains(r: Rect, p: Vec2): bool {
  return (p.x >= r.min.x) && (p.x < r.max.x) &&
         (p.y >= r.min.y) && (p.y < r.max.y);
}

pub fn RectContainsInclusive(r: Rect, p: Vec2): bool {
  return (p.x >= r.min.x) && (p.x <= r.max.x) &&
         (p.y >= r.min.y) && (p.y <= r.max.y);
}

// ============================================================================
// Rectangle operations
// ============================================================================

pub fn RectInflate(r: Rect, amount: int64): Rect {
  var _sl99: Rect;
  var _sl991: Vec2;
  _sl991.x := r.min.x - amount;
  _sl991.y := r.min.y - amount;
  _sl99.min := _sl991;
  var _sl992: Vec2;
  _sl992.x := r.max.x + amount;
  _sl992.y := r.max.y + amount;
  _sl99.max := _sl992;
  return _sl99;
}

pub fn RectDeflate(r: Rect, amount: int64): Rect {
  var _sl103: Rect;
  var _sl1031: Vec2;
  _sl1031.x := r.min.x + amount;
  _sl1031.y := r.min.y + amount;
  _sl103.min := _sl1031;
  var _sl1032: Vec2;
  _sl1032.x := r.max.x - amount;
  _sl1032.y := r.max.y - amount;
  _sl103.max := _sl1032;
  return _sl103;
}

pub fn RectExpand(r: Rect, p: Vec2): Rect {
  var _sl107: Rect;
  _sl107.min := Vec2Min(r.min, p);
  _sl107.max := Vec2Max(r.max, p);
  return _sl107;
}

pub fn RectUnion(a: Rect, b: Rect): Rect {
  var _sl111: Rect;
  _sl111.min := Vec2Min(a.min, b.min);
  _sl111.max := Vec2Max(a.max, b.max);
  return _sl111;
}

pub fn RectIntersect(a: Rect, b: Rect): Rect {
  var _sl115: Rect;
  _sl115.min := Vec2Max(a.min, b.min);
  _sl115.max := Vec2Min(a.max, b.max);
  return _sl115;
}

pub fn RectIntersects(a: Rect, b: Rect): bool {
  var intersect: Rect := RectIntersect(a, b);
  return RectIsValid(intersect);
}

// ============================================================================
// Clamping
// ============================================================================

pub fn RectClampPoint(r: Rect, p: Vec2): Vec2 {
  return Vec2Clamp(p, r.min, r.max);
}

pub fn RectClamp(r: Rect, bounds: Rect): Rect {
  return RectIntersect(r, bounds);
}

// ============================================================================
// Distance
// ============================================================================

pub fn RectDistanceToPoint(r: Rect, p: Vec2): int64 {
  if (RectContains(r, p)) {
    return 0;
  }
  
  var dx: int64 := 0;
  var dy: int64 := 0;
  
  if (p.x < r.min.x) {
    dx := r.min.x - p.x;
  } else {
    if (p.x > r.max.x) {
      dx := p.x - r.max.x;
    }
  }
  
  if (p.y < r.min.y) {
    dy := r.min.y - p.y;
  } else {
    if (p.y > r.max.y) {
      dy := p.y - r.max.y;
    }
  }
  
  // #1480: Hier stand `dx + dy` — der Manhattan-Abstand. Fuer eine Funktion,
  // die "Abstand zum Punkt" heisst, ist das bei schraeger Lage bis zu 41 %
  // zu viel. Hypot64 aus std.math rechnet exakt (seit #1447).
  return Hypot64(dx, dy);
}

// ============================================================================
// Corners
// ============================================================================

pub fn RectTopLeft(r: Rect): Vec2 {
  return r.min;
}

pub fn RectTopRight(r: Rect): Vec2 {
  var _sl175: Vec2;
  _sl175.x := r.max.x;
  _sl175.y := r.min.y;
  return _sl175;
}

pub fn RectBottomLeft(r: Rect): Vec2 {
  var _sl179: Vec2;
  _sl179.x := r.min.x;
  _sl179.y := r.max.y;
  return _sl179;
}

pub fn RectBottomRight(r: Rect): Vec2 {
  return r.max;
}

// #1480: Das Array wurde angelegt und ununberuehrt zurueckgegeben — `r` kam im
// Rumpf nicht vor. Dass dabei Nullen erschienen, war Zufall des Stackinhalts.
//
// Reihenfolge im Uhrzeigersinn ab links oben, wie es die Doku der Unit nennt:
// (min.x,min.y), (max.x,min.y), (max.x,max.y), (min.x,max.y).
pub fn RectCorners(r: Rect): [4]Vec2 {
  var corners: [4]Vec2;
  corners[0] := Vec2New(r.min.x, r.min.y);
  corners[1] := Vec2New(r.max.x, r.min.y);
  corners[2] := Vec2New(r.max.x, r.max.y);
  corners[3] := Vec2New(r.min.x, r.max.y);
  return corners;
}

// ============================================================================
// Sides
// ============================================================================

pub fn RectLeft(r: Rect): int64 {
  return r.min.x;
}

pub fn RectRight(r: Rect): int64 {
  return r.max.x;
}

pub fn RectTop(r: Rect): int64 {
  return r.min.y;
}

pub fn RectBottom(r: Rect): int64 {
  return r.max.y;
}

// ============================================================================
// Comparison
// ============================================================================

pub fn RectEqual(a: Rect, b: Rect): bool {
  return Vec2Equal(a.min, b.min) && Vec2Equal(a.max, b.max);
}

