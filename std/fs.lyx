// ============================================================================
// Path-Funktionen (Pfad-Manipulation)
// ============================================================================

// Interner Puffer für Path-Operationen (max 4096 Zeichen)
con PATH_BUF_SIZE: int64 := 4096;

// Normalisiert einen Pfad: ./ und ../ und // auflösen
// "/home/user/./foo/../bar//baz" -> "/home/user/bar/baz"
// Nutzt Stack-basierten Algorithmus
pub fn PathNormalize(dest: pchar, src: pchar): pchar {
  // Da Lyx keine dynamischen Arrays hat, implementieren wir eine 
  // vereinfachte Version ohne vollständigen Stack
  var result: pchar := "                                                                                ";
  var src_len: int64 := StrLen(src);
  
  // Prüfe ob absolut oder relativ
  var is_absolute: bool := false;
  if (src_len > 0 && StrCharAt(src, 0) == 47) {  // '/'
    is_absolute := true;
  }
  
  // Einfacherer Algorithmus: ein Durchgang
  var i: int64 := 0;
  var j: int64 := 0;
  var last_slash: int64 := 0;
  var comp_start: int64 := 0;
  
  if (is_absolute) {
    StrSetChar(result, 0, 47);  // '/'
    j := 1;
    last_slash := 0;
  }
  
  while (i < src_len) {
    var c: int64 := StrCharAt(src, i);
    
    if (c == 47) {  // '/'
      // Segment beenden
      var seg_len: int64 := i - comp_start;
      
      if (seg_len == 1 && StrCharAt(src, comp_start) == 46) {  // "."
        // Überspringen
        comp_start := i + 1;
        last_slash := j;
      }
      else if (seg_len == 2 && StrCharAt(src, comp_start) == 46 && StrCharAt(src, comp_start + 1) == 46) {  // ".."
        // Zurückgehen: entferne letztes Segment
        if (last_slash < j) {
          j := last_slash;
          if (j > 0 && is_absolute) {
            // Finde vorigen Slash
            var k: int64 := j - 1;
            while (k > 0) {
              if (StrCharAt(result, k) == 47) { last_slash := k; break; }
              k := k - 1;
            }
            if (k == 0) { last_slash := 0; }
          }
        }
        comp_start := i + 1;
        last_slash := j;
      }
      else if (seg_len > 0) {
        // Normales Segment: kopieren
        var k: int64 := 0;
        while (k < seg_len) {
          StrSetChar(result, j + k, StrCharAt(src, comp_start + k));
          k := k + 1;
        }
        j := j + seg_len;
        last_slash := j;
        StrSetChar(result, j, 47);  // '/'
        j := j + 1;
        comp_start := i + 1;
      }
      else {
        // Mehrere / : überspringen
        comp_start := i + 1;
      }
    }
    i := i + 1;
  }
  
  // Letztes Segment prüfen
  var seg_len: int64 := i - comp_start;
  if (seg_len == 1 && StrCharAt(src, comp_start) == 46) {
    // "." am Ende - entfernen
  }
  else if (seg_len == 2 && StrCharAt(src, comp_start) == 46 && StrCharAt(src, comp_start + 1) == 46) {
    // ".." am Ende - entferne letztes Segment
    if (last_slash < j) {
      j := last_slash;
    }
  }
  else if (seg_len > 0) {
    // Normales Segment kopieren
    var k: int64 := 0;
    while (k < seg_len) {
      StrSetChar(result, j + k, StrCharAt(src, comp_start + k));
      k := k + 1;
    }
    j := j + seg_len;
  }
  
  // Entferne trailing slash (außer bei "/")
  if (j > 1 && StrCharAt(result, j - 1) == 47) {
    j := j - 1;
  }
  
  // Null-terminator
  StrSetChar(result, j, 0);
  
  // Kopiere nach dest (bis zur Puffergröße)
  var copy_len: int64 := j;
  if (copy_len >= PATH_BUF_SIZE) { copy_len := PATH_BUF_SIZE - 1; }
  var k: int64 := 0;
  while (k < copy_len) {
    StrSetChar(dest, k, StrCharAt(result, k));
    k := k + 1;
  }
  StrSetChar(dest, copy_len, 0);
  
  return dest;
}

// Gibt den Verzeichnis-Teil eines Pfades zurück
// "/home/user/doc.lyx" -> "/home/user"
// Gibt "." zurück wenn kein Verzeichnis
pub fn PathDir(dest: pchar, path: pchar): pchar {
  var path_len: int64 := StrLen(path);
  if (path_len == 0) {
    StrSetChar(dest, 0, 46); StrSetChar(dest, 1, 0);  // "."
    return dest;
  }
  
  // Finde letzten Slash
  var last_slash: int64 := -1;
  var i: int64 := path_len - 1;
  while (i >= 0) {
    if (StrCharAt(path, i) == 47) {  // '/'
      last_slash := i;
      break;
    }
    i := i - 1;
  }
  
  if (last_slash <= 0) {
    // Kein Slash oder nur root
    StrSetChar(dest, 0, 46); StrSetChar(dest, 1, 0);  // "."
    return dest;
  }
  
  // Kopiere Verzeichnis-Teil
  var j: int64 := 0;
  while (j < last_slash) {
    StrSetChar(dest, j, StrCharAt(path, j));
    j := j + 1;
  }
  StrSetChar(dest, last_slash, 0);
  return dest;
}

// Gibt die Datei-Extension zurück (mit Punkt)
// "archive.tar.gz" -> ".gz"
// "" wenn keine Extension
pub fn PathExt(dest: pchar, path: pchar): pchar {
  var path_len: int64 := StrLen(path);
  if (path_len == 0) {
    StrSetChar(dest, 0, 0);
    return dest;
  }
  
  // Finde letzten Slash (um nur im Dateinamen zu suchen)
  var last_slash: int64 := -1;
  var i: int64 := path_len - 1;
  while (i >= 0) {
    if (StrCharAt(path, i) == 47) {  // '/'
      last_slash := i;
      break;
    }
    i := i - 1;
  }
  
  // Finde letzten Punkt nach dem letzten Slash
  var last_dot: int64 := -1;
  i := last_slash + 1;
  while (i < path_len) {
    if (StrCharAt(path, i) == 46) {  // '.'
      last_dot := i;
    }
    i := i + 1;
  }
  
  if (last_dot < 0 || last_dot == path_len - 1) {
    // Kein Punkt oder punkt am Ende
    StrSetChar(dest, 0, 0);
    return dest;
  }
  
  // Kopiere Extension (mit Punkt)
  i := last_dot;
  var j: int64 := 0;
  while (i < path_len) {
    StrSetChar(dest, j, StrCharAt(path, i));
    i := i + 1;
    j := j + 1;
  }
  StrSetChar(dest, j, 0);
  return dest;
}

// Gibt den Basis-Dateinamen ohne Extension zurück
// "/tmp/data.csv" -> "data"
// "/tmp/archive.tar.gz" -> "archive.tar"
pub fn PathBase(dest: pchar, path: pchar): pchar {
  var path_len: int64 := StrLen(path);
  if (path_len == 0) {
    StrSetChar(dest, 0, 0);
    return dest;
  }
  
  // Finde letzten Slash
  var last_slash: int64 := -1;
  var i: int64 := path_len - 1;
  while (i >= 0) {
    if (StrCharAt(path, i) == 47) {  // '/'
      last_slash := i;
      break;
    }
    i := i - 1;
  }
  
  var file_start: int64 := last_slash + 1;
  
  // Finde letzten Punkt nach dem Slash
  var last_dot: int64 := -1;
  i := file_start;
  while (i < path_len) {
    if (StrCharAt(path, i) == 46) {  // '.'
      last_dot := i;
    }
    i := i + 1;
  }
  
  var file_end: int64 := path_len;
  if (last_dot > file_start) {
    file_end := last_dot;
  }
  
  // Kopiere Basis-Name
  var j: int64 := 0;
  i := file_start;
  while (i < file_end) {
    StrSetChar(dest, j, StrCharAt(path, i));
    i := i + 1;
    j := j + 1;
  }
  StrSetChar(dest, j, 0);
  return dest;
}

// ============================================================================
// Directory Listing — v0.3.2
// ============================================================================
//
// DirList returns an opaque handle (mmap'd buffer) with this layout:
//   [0..7]  count      int64 — number of entries (excludes . and ..)
//   [8..15] totalSize  int64 — full buffer size (needed for DirFree)
//   [16..]  entries    — each entry:
//             [+0..+7]  nameLen  int64
//             [+8]      type     byte  (DT_* constant)
//             [+9..]    name     bytes (nameLen bytes, null-terminated)
//
// Usage:
//   var d: int64 := DirList("/tmp");
//   var n: int64 := DirEntryCount(d);
//   var t: int64 := DirEntryType(d, "foo.txt", 7);
//   DirFree(d);

con DIR_BUF_CAPACITY: int64 := 524288;   // 512 KB — max total result buffer
con DIR_RAW_BUF_SIZE: int64 := 32768;    // 32 KB — getdents64 read chunk

pub fn DirList(path: pchar): int64 {
  var dirfd: int64 := open(path, O_RDONLY | O_DIRECTORY, 0);
  if (dirfd < 0) {
    return 0;
  }

  var rawBuf: int64 := mmap(0, DIR_RAW_BUF_SIZE, 3, 34, -1, 0);
  var resBuf: int64 := mmap(0, DIR_BUF_CAPACITY, 3, 34, -1, 0);
  var resPos: int64 := 16;  // skip count(8) + totalSize(8)
  var count:  int64 := 0;

  while (true) {
    var nRead: int64 := getdents64(dirfd, rawBuf, DIR_RAW_BUF_SIZE);
    if (nRead <= 0) {
      break;
    }

    var pos: int64 := 0;
    while (pos < nRead) {
      var entryLen: int64 := peek16(rawBuf + pos + 16);
      if (entryLen <= 0) {
        break;
      }

      var namePtr:   int64 := rawBuf + pos + 19;
      var firstChar: int64 := peek8(namePtr);

      // Skip . and ..
      if (firstChar != 46) {
        var dType:   int64 := peek8(rawBuf + pos + 18);
        var nameLen: int64 := 0;
        while (peek8(namePtr + nameLen) != 0) {
          nameLen := nameLen + 1;
        }

        // Guard against buffer overflow
        if (resPos + 8 + 1 + nameLen + 1 < DIR_BUF_CAPACITY) {
          poke64(resBuf + resPos, nameLen);
          resPos := resPos + 8;
          poke8(resBuf + resPos, dType);
          resPos := resPos + 1;
          var i: int64 := 0;
          while (i < nameLen) {
            poke8(resBuf + resPos + i, peek8(namePtr + i));
            i := i + 1;
          }
          poke8(resBuf + resPos + nameLen, 0);
          resPos := resPos + nameLen + 1;
          count := count + 1;
        }
      }

      pos := pos + entryLen;
    }
  }

  close(dirfd);
  munmap(rawBuf, DIR_RAW_BUF_SIZE);

  poke64(resBuf,     count);
  poke64(resBuf + 8, DIR_BUF_CAPACITY);
  return resBuf;
}

// Returns the number of entries in a DirList result (excludes . and ..)
pub fn DirEntryCount(dirlist: int64): int64 {
  if (dirlist == 0) {
    return 0;
  }
  return peek64(dirlist);
}

// Returns the DT_* type of the named entry, or DT_UNKNOWN if not found.
// nameLen must match the exact byte length of name (without null terminator).
pub fn DirEntryType(dirlist: int64, name: pchar, nameLen: int64): int64 {
  if (dirlist == 0) {
    return DT_UNKNOWN;
  }
  var count:  int64 := peek64(dirlist);
  var pos:    int64 := 16;
  var found:  int64 := 0;
  var eLen:   int64 := 0;
  var eType:  int64 := 0;
  var mismatch: int64 := 0;
  var i:      int64 := 0;
  while (found < count) {
    eLen  := peek64(dirlist + pos);
    pos   := pos + 8;
    eType := peek8(dirlist + pos);
    pos   := pos + 1;
    if (eLen == nameLen) {
      mismatch := 0;
      i := 0;
      while (i < nameLen) {
        if (peek8(dirlist + pos + i) != peek8(name + i)) {
          mismatch := 1;
          break;
        }
        i := i + 1;
      }
      if (mismatch == 0) {
        return eType;
      }
    }
    pos   := pos + eLen + 1;
    found := found + 1;
  }
  return DT_UNKNOWN;
}

// Releases the memory allocated by DirList.
pub fn DirFree(dirlist: int64): void {
  if (dirlist != 0) {
    var totalSize: int64 := peek64(dirlist + 8);
    munmap(dirlist, totalSize);
  }
}

// JoinHoch / Resolve: kombiniert Basis-Pfad mit relativem Pfad
// resolve("/home/user/", "../other/file.txt") -> "/home/other/file.txt"
// resolve(".", "../foo.txt") -> basierend auf current dir (nicht implementiert - gibt nur normalize zurück)
pub fn PathResolve(dest: pchar, base: pchar, relative: pchar): pchar {
  // Prüfe ob relative Pfad absolut ist
  var rel_len: int64 := StrLen(relative);
  if (rel_len > 0 && StrCharAt(relative, 0) == 47) {
    // Absolute Pfad: nur normalisieren
    return PathNormalize(dest, relative);
  }
  
  // Kombiniere base + "/" + relative
  var combined: pchar := "                                                                                ";
  var base_len: int64 := StrLen(base);
  
  var i: int64 := 0;
  var j: int64 := 0;
  
  // Base kopieren
  while (i < base_len) {
    StrSetChar(combined, j, StrCharAt(base, i));
    i := i + 1;
    j := j + 1;
  }
  
  // Slash hinzufügen wenn nötig
  if (j > 0 && StrCharAt(combined, j - 1) != 47) {
    StrSetChar(combined, j, 47);  // '/'
    j := j + 1;
  }
  
  // Relative Pfad kopieren
  i := 0;
  while (i < rel_len) {
    StrSetChar(combined, j, StrCharAt(relative, i));
    i := i + 1;
    j := j + 1;
  }
  StrSetChar(combined, j, 0);
  
  // Normalisieren
  return PathNormalize(dest, combined);
}

// ============================================================================
// WP-FS-04: Pfad-Utilities — PathJoin, IsAbsolutePath
// ============================================================================

// Verbindet zwei Pfad-Segmente mit "/" (wenn nötig).
// Ergebnis wird in dest geschrieben (muss groß genug sein:
// StrLen(a) + StrLen(b) + 2 Bytes).
// Trailing "/" in a und leading "/" in b werden korrekt behandelt.
// Beispiele:
//   PathJoin(d, "/home/user",  "docs")   → "/home/user/docs"
//   PathJoin(d, "/home/user/", "docs")   → "/home/user/docs"
//   PathJoin(d, "",            "docs")   → "docs"
//   PathJoin(d, "/a",          "/b")     → "/a/b"  (b-Slash wird als Segment behandelt)
pub fn PathJoin(dest: pchar, a: pchar, b: pchar): pchar {
  var lenA: int64 := StrLen(a);
  var lenB: int64 := StrLen(b);
  var j:    int64 := 0;
  var i:    int64 := 0;

  // Kopiere a
  i := 0;
  while (i < lenA) {
    StrSetChar(dest, j, StrCharAt(a, i));
    i := i + 1;
    j := j + 1;
  }

  // Füge Trennzeichen ein wenn nötig
  if (lenA > 0 && lenB > 0) {
    var lastA: int64 := StrCharAt(a, lenA - 1);
    var firstB: int64 := StrCharAt(b, 0);
    if (lastA != 47 && firstB != 47) {  // keiner endet/beginnt mit '/'
      StrSetChar(dest, j, 47);
      j := j + 1;
    }
  }

  // Kopiere b
  i := 0;
  while (i < lenB) {
    StrSetChar(dest, j, StrCharAt(b, i));
    i := i + 1;
    j := j + 1;
  }

  StrSetChar(dest, j, 0);
  return dest;
}

// Gibt true zurück wenn path ein absoluter Pfad ist (beginnt mit '/').
pub fn IsAbsolutePath(path: pchar): bool {
  if (StrLen(path) == 0) {
    return false;
  }
  return StrCharAt(path, 0) == 47;  // '/'
}
