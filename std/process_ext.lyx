  return r;
}

// GetUnameMachine: kopiert das machine-Feld ("x86_64") nach outBuf.
pub fn GetUnameMachine(outBuf: int64): int64 {
  var buf: int64 := alloc(UTSNAME_SIZE);
  if (buf == 0) { return -1; }
  var r: int64 := sys_uname(buf);
  if (r == 0) { _peCopyBytes(outBuf, buf +UTSNAME_MACHINE, UTSNAME_FIELD_LEN);}
  free(buf, UTSNAME_SIZE);
  return r;
}
