// GetUnameNodename: kopiert das nodename-Feld (Hostname) nach outBuf.
pub fn GetUnameNodename(outBuf: int64): int64 {
  var buf: int64 := alloc(UTSNAME_SIZE);
  if (buf == 0) { return -1; }
  var r: int64 := sys_uname(buf);
