}

fn zsMLExtra(code: int64): int64 {
    if (code < 32) { return 0; }
    if ((code >= 32) & (code <= 35)) { return 1; }
    if ((code >= 36) & (code <= 37)) { return 2; }
    if ((code >= 38) & (code <= 39)) { return 3; }
    if ((code >= 40) & (code <= 41)) { return 4; }
    if (code == 42) { return 5; }
    if (code == 43) { return 7; }
    if (code == 44) { return 8; }
    if (code == 45) { return 9; }
    if (code == 46) { return 10; }
    if (code == 47) { return 11; }
    if (code == 48) { return 12; }
    if (code == 49) { return 13; }
    if (code == 50) { return 14; }
    if (code == 51) { return 15; }
    return 16;
}

// ========================================================================
// Huffman Tree  ZsHuff (408 B): same layout as BrHTree
// [0]=maxLen  [8..135]=firstCode[16]  [136..263]=firstIdx[16]
// [264..391]=countArr[16]  [392]=symsPtr  [400]=trivialSym
// ========================================================================

fn zsHuffNew(): int64 {
    // 416 statt 408: Slot [408] haelt die Symbolzahl fuer zsHuffFree.
    var t: int64 := alloc(416);
    var k: int64 := 0;
    while (k < 416) { poke8(t + k, 0); k := k + 1; }
    poke64(t + 400, 0 - 1);  // trivialSym = -1 (no trivial)
    return t;
}

fn zsHuffFree(t: int64): void {
    if (t == 0) { return; }
    var syms: int64 := peek64(t + 392);
    if (syms != 0) { free(syms, peek64(t + 408) * 8); }
    free(t, 416);
}

// Build canonical Huffman from code-length array.
// lens[sym] = code length in bits (0 = absent)
fn zsHuffBuildLens(t: int64, lens: int64, numSyms: int64): void {
    var maxLen: int64 := 0;
    var s: int64 := 0;
    while (s < numSyms) { var l: int64 := peek64(lens + s * 8); if (l > maxLen) { maxLen := l; } s := s + 1; }
    poke64(t, maxLen);
    if (maxLen == 0) { return; }

    // Count symbols per length
    var k: int64 := 0;
    while (k <= maxLen) { poke64(t + 264 + k * 8, 0); k := k + 1; }
    s := 0;
    while (s < numSyms) { var l: int64 := peek64(lens + s * 8); if (l > 0) { poke64(t + 264 + l * 8, peek64(t + 264 + l * 8) + 1); } s := s + 1; }

    // #1027: zstd weist die Codes NICHT wie ueblich kanonisch zu.
    //
    // In der Referenz (HUF_readDTableX1) fuellen die Symbole mit dem KLEINSTEN
    // Gewicht — also dem LAENGSTEN Code — die Tabelle ab Index 0; die kuerzesten
    // Codes liegen oben. Der uebliche Aufbau (kuerzeste Codes ab 0) ist genau
    // die Spiegelung davon und lieferte deshalb echte, aber falsch zugeordnete
    // Symbole: der dekodierte Text bestand aus den richtigen Buchstaben in
    // falscher Reihenfolge.
    //
    // Richtig ist die Rekursion von der laengsten Laenge nach unten:
    //     firstCode[maxLen] = 0
    //     firstCode[l]      = (firstCode[l+1] + count[l+1]) >> 1
    //
    // Gegenprobe am Beispiel aus RFC 8878 (Gewichte 4,3,2,0,1,1):
    //     Laenge 4: firstCode 0 -> Symbole 4,5 = 0000, 0001
    //     Laenge 3: (0+2)>>1 = 1 -> Symbol 2   = 001
    //     Laenge 2: (1+1)>>1 = 1 -> Symbol 1   = 01
    //     Laenge 1: (1+1)>>1 = 1 -> Symbol 0   = 1
    poke64(t + 8, 0);                       // firstCode[0] unbenutzt
    poke64(t + 8 + maxLen * 8, 0);          // laengster Code beginnt bei 0
    k := maxLen - 1;
    while (k >= 1) {
        var above: int64 := peek64(t + 8 + (k + 1) * 8) + peek64(t + 264 + (k + 1) * 8);
        poke64(t + 8 + k * 8, above >> 1);
        k := k - 1;
    }

    // Count total symbols and allocate symsPtr
    var total: int64 := 0;
    s := 0;
    while (s < numSyms) { if (peek64(lens + s * 8) > 0) { total := total + 1; } s := s + 1; }

    if (total == 1) {
        // Trivial: only one symbol — find it
        s := 0;
        while (s < numSyms) { if (peek64(lens + s * 8) > 0) { poke64(t + 400, s); return; } s := s + 1; }
    }

    var syms: int64 := alloc(total * 8);
    poke64(t + 392, syms);
    poke64(t + 408, total);   // fuer zsHuffFree

    // Build firstIdx and symbols sorted by length
    var idx: int64 := 0;
    k := 1;
    while (k <= maxLen) {
        poke64(t + 136 + k * 8, idx);
        s := 0;
        while (s < numSyms) {
            if (peek64(lens + s * 8) == k) {
                poke64(syms + idx * 8, s);
                idx += 1;
            }
            s += 1;
        }
        k += 1;
    }
}

// Decode one Huffman symbol from a backward bitstream (ZsRevBR).
fn zsHuffDecSym(t: int64, rbr: int64): int64 {
    var trivial: int64 := peek64(t + 400);
    if (trivial >= 0) { return trivial; }
    var maxLen: int64 := peek64(t);
    var code: int64 := 0;
    var l: int64 := 1;
    while (l <= maxLen) {
        code := (code << 1) | zsRevReadBit(rbr);
        var fc: int64 := peek64(t + 8 + l * 8);
        var cnt: int64 := peek64(t + 264 + l * 8);
        if ((code >= fc) & (code < fc + cnt)) {
            var fi: int64 := peek64(t + 136 + l * 8);
            return peek64(peek64(t + 392) + (fi + code - fc) * 8);
        }
        l += 1;
    }
    return 0;
}

// Read Huffman weights from ZsBit forward reader.
// weights[i] = code length for symbol i (0 = absent)
// Returns number of symbols or 0 on error.
// Format: header byte -> if >= 128: direct (header-127 symbols, 4 bits each, packed 2/byte)
//                        if < 128: FSE-compressed weights (header = compressed size)
fn zsReadHuffWeights(br: int64, ptr: int64, weights: int64): int64 {
    var hdr: int64 := zsbrReadU8(br);

    if (hdr >= 128) {
        // Direct encoding: hdr - 127 symbols
        var numSyms: int64 := hdr - 127;
        var byteCount: int64 := (numSyms + 1) / 2;
        var s: int64 := 0;
        var b: int64 := 0;
        while (b < byteCount) {
            var bv: int64 := zsbrReadU8(br);
            if (s < numSyms) { poke64(weights + s * 8, bv & 0xF); s := s + 1; }
            if (s < numSyms) { poke64(weights + s * 8, (bv >> 4) & 0xF); s := s + 1; }
            b += 1;
        }
        return numSyms;
    }

    // FSE-compressed weights
    var compSize: int64 := hdr;
    if (compSize == 0) { return 0; }

    var wBase: int64 := zsbrPos(br);  // start of FSE data
    var zb: int64 := zsBitNew(ptr + wBase, 0);

    // Read FSE prob table for weights (max symbol = 255, weights are 0..11)
    var wprobs: int64 := alloc(256 * 8);
    var AL: int64 := zsReadFSEProbs(zb, 255, wprobs);
    // #1027: Der Tabellenkopf endet an einer BYTEGRENZE. Ohne das Aufrunden
    // zaehlte das angebrochene letzte Byte zum Bitstrom, der Rueckwaertsleser
    // bekam ein Byte zu viel am Anfang — und die Schleife lief nach den echten
    // Gewichten noch elf Schritte weiter, alle mit Gewicht null. Genau diese
    // ueberzaehligen Nullen verschoben das implizite letzte Symbol.
    zsBitSkipToByte(zb);
    var tableHdrSize: int64 := zsBitBytePos(zb);
    free(zb, 24);

    if (AL < 0) { free(wprobs, 256 * 8); return 0; }

    var wtab: int64 := zsFSEBuild(wprobs, 256, AL);
    free(wprobs, 256 * 8);

    // The remaining bytes in compSize are the backward FSE bitstream
    var bsStart: int64 := wBase + tableHdrSize;
    var bsLen:   int64 := compSize - tableHdrSize;
    var rbr:     int64 := zsRevNew(ptr + bsStart, bsLen);

    // Decode weights (FSE state machine)
    // #1027: zstd dekodiert die Huffman-Gewichte mit ZWEI verschraenkten
    // FSE-Zustaenden (RFC 8878, Huffman_Tree_Description) — hier lief nur einer.
    // Damit stimmte ab dem zweiten Gewicht nichts mehr, und der gebaute Baum
    // lieferte statt der Literale Muell.
    // #1027: Terminierung nach RFC 8878 §4.2.1.2. Zwei Zustaende teilen sich
    // eine Verteilungstabelle; State1 traegt die geradzahligen, State2 die
    // ungeradzahligen Indizes. Sie geben abwechselnd ein Symbol aus und
    // wechseln danach ihren Zustand.
    //
    // Abgebrochen wird, wenn der Zustandswechsel mehr Bits braeuchte, als noch
    // im Strom stehen — die fehlenden gelten als null. Danach gibt der jeweils
    // andere Zustand noch sein Symbol aus, dann ist Schluss.
    //
    // Die Zahl der Gewichte ist nicht belanglos: sie bestimmt die Nummer des
    // IMPLIZITEN letzten Symbols. Ein Gewicht zu viel verschiebt es und laesst
    // es den Codeplatz eines echten Symbols einnehmen.
    //
    // Hoechstens 255 Gewichte — das letzte Symbol traegt keines im Strom.
    var state1: int64 := zsRevReadBits(rbr, AL);
    var state2: int64 := zsRevReadBits(rbr, AL);
    var numSyms: int64 := 0;
    var done: int64 := 0;
    while (done == 0) {
        poke64(weights + numSyms * 8, zsFSESym(wtab, state1));
        numSyms += 1;
        if (numSyms >= 255) { done := 1; }
        if (done == 0) {
            var nb1: int64 := zsFSENbBits(wtab, state1);
            if (zsRevBitsLeft(rbr) < nb1) {
                poke64(weights + numSyms * 8, zsFSESym(wtab, state2));
                numSyms += 1;
                done := 1;
            } else {
                state1 := zsFSENewState(wtab, state1) + zsRevReadBits(rbr, nb1);
            }
        }
        if (done == 0) {
            poke64(weights + numSyms * 8, zsFSESym(wtab, state2));
            numSyms += 1;
            if (numSyms >= 255) { done := 1; }
            if (done == 0) {
                var nb2: int64 := zsFSENbBits(wtab, state2);
                if (zsRevBitsLeft(rbr) < nb2) {
                    poke64(weights + numSyms * 8, zsFSESym(wtab, state1));
                    numSyms += 1;
                    done := 1;
                } else {
                    state2 := zsFSENewState(wtab, state2) + zsRevReadBits(rbr, nb2);
                }
            }
        }
    }

    free(rbr, 32);
    zsFSEFree(wtab);
    zsbrSkip(br, compSize);
    return numSyms;
}

// Build Huffman tree from zstd weight array.
// weight[s] = 0 → absent; weight[s] > 0 → code length = weight[s]
// The last symbol's weight is derived to complete the tree.
fn zsHuffFromWeights(weights: int64, numSyms: int64): int64 {
    var t: int64 := zsHuffNew();
    if (numSyms <= 0) { return t; }

    // #1027: Ein Gewicht ist NICHT die Codelaenge. RFC 8878 §4.2.1:
    //
    //     Number_of_Bits = Max_Number_of_Bits + 1 - Weight    (fuer Weight > 0)
    //
    // Ein HOHES Gewicht ergibt also einen KURZEN Code. Bisher wurde das Gewicht
    // unmittelbar als Laenge eingetragen — genau umgekehrt. Der Baum bevorzugte
    // dadurch die seltensten Zeichen: in einem Testframe kamen als Literale
    // ausschliesslich '.', 'C', 'L' und 'S' heraus, also die Symbole mit
    // Gewicht 1. Der Kommentar an dieser Stelle nannte die richtige Formel und
    // verwarf sie im Satz darauf.
    //
    // Max_Number_of_Bits ergibt sich aus der Summe der Gewichtswertigkeiten:
    // total = Summe 2^(W-1) ueber alle gelesenen Gewichte > 0. Das letzte
    // Symbol traegt kein eigenes Gewicht im Strom — seines wird so bestimmt,
    // dass die Summe eine Zweierpotenz wird.
    var total: int64 := 0;
    var s: int64 := 0;
    while (s < numSyms) {
        var w: int64 := peek64(weights + s * 8);
        if (w > 0) { total := total + (1 << (w - 1)); }
        s += 1;
    }
    if (total <= 0) { return t; }

    var maxBits: int64 := zsHighbit(total) + 1;
    if (maxBits > 11) { return t; }          // zstd erlaubt hoechstens 11 Bit
    var rest: int64 := (1 << maxBits) - total;
    if (rest <= 0) { return t; }             // Gewichtssumme unstimmig
    var lastW: int64 := zsHighbit(rest) + 1;
    // #1027: Der Rest MUSS eine Zweierpotenz sein — nur dann ergibt das
    // abgeleitete letzte Gewicht einen vollstaendigen Baum. Ist er es nicht,
    // waren die gelesenen Gewichte unstimmig; zsHighbit rundet dann ab und der
    // Baum ist still falsch. Lieber einen leeren Baum liefern, den der Aufrufer
    // als Fehler sieht, als geraten.
    if ((1 << (lastW - 1)) != rest) { return t; }

    // Codelaengen: len[s] = maxBits + 1 - W[s], 0 bedeutet "Symbol kommt nicht vor".
    var nAll: int64 := numSyms + 1;
    var lensSize: int64 := nAll * 8;
    var lens: int64 := alloc(lensSize);
    s := 0;
    while (s < numSyms) {
        var w2: int64 := peek64(weights + s * 8);
        if (w2 > 0) { poke64(lens + s * 8, maxBits + 1 - w2); }
        else        { poke64(lens + s * 8, 0); }
        s += 1;
    }
    poke64(lens + numSyms * 8, maxBits + 1 - lastW);

    zsHuffBuildLens(t, lens, nAll);
    free(lens, lensSize);
    return t;
}

// ========================================================================
// Context  ZsCtx (168 B)
// [0]=src [8]=srcPos [16]=srcLen [24]=dst [32]=dstPos [40]=dstMax
// [48]=error [56]=off1 [64]=off2 [72]=off3
// [80]=litTree [88]=llTable [96]=mlTable [104]=offTable
// [112]=llMode [120]=mlMode [128]=offMode
// [136]=llRLE [144]=mlRLE [152]=offRLE
// [160]=contentSize (0=unknown)
// ========================================================================

fn zsCtxNew(src: int64, srcLen: int64, dst: int64, dstMax: int64): int64 {
    var ctx: int64 := alloc(168);
    var k: int64 := 0;
    while (k < 168) { poke8(ctx + k, 0); k := k + 1; }
    poke64(ctx,       src);
    poke64(ctx + 16,  srcLen);
    poke64(ctx + 24,  dst);
    poke64(ctx + 40,  dstMax);
    poke64(ctx + 56,  1);  // off1
    poke64(ctx + 64,  4);  // off2
    poke64(ctx + 72,  8);  // off3
    poke64(ctx + 112, 0 - 1);  // llMode = -1 (none yet)
    poke64(ctx + 120, 0 - 1);  // mlMode = -1
    poke64(ctx + 128, 0 - 1);  // offMode = -1
    return ctx;
}

fn zsCtxFree(ctx: int64): void {
    if (ctx == 0) { return; }
    var lt: int64 := peek64(ctx + 80);
    if (lt != 0) { zsHuffFree(lt); }
    zsFSEFree(peek64(ctx + 88));
    zsFSEFree(peek64(ctx + 96));
    zsFSEFree(peek64(ctx + 104));
    free(ctx, 168);
}

fn zsOutput(ctx: int64, b: int64): void {
    var pos: int64 := peek64(ctx + 32);
    var mx:  int64 := peek64(ctx + 40);
    if (pos >= mx) { poke64(ctx + 48, 1); return; }
    poke8(peek64(ctx + 24) + pos, b & 0xFF);
    poke64(ctx + 32, pos + 1);
}

fn zsCopyBack(ctx: int64, offset: int64, matchLen: int64): void {
    var dst:    int64 := peek64(ctx + 24);
    var dstPos: int64 := peek64(ctx + 32);
    var dstMax: int64 := peek64(ctx + 40);
    var i: int64 := 0;
    while (i < matchLen) {
        if (dstPos >= dstMax) { poke64(ctx + 48, 1); return; }
        var backPos: int64 := dstPos - offset;
        if (backPos < 0) { poke64(ctx + 48, 1); return; }
        poke8(dst + dstPos, peek8(dst + backPos));
        dstPos += 1;
        i += 1;
    }
    poke64(ctx + 32, dstPos);
}

// Resolve offset_value (raw from bitstream) with repeat-offset logic.
// Returns actual offset. Updates ctx's off1/off2/off3.
fn zsResolveOffset(ctx: int64, offVal: int64, llLen: int64): int64 {
    var off1: int64 := peek64(ctx + 56);
    var off2: int64 := peek64(ctx + 64);
    var off3: int64 := peek64(ctx + 72);
    var actual: int64 := 0;

    if (offVal > 3) {
        actual := offVal - 3;
        poke64(ctx + 72, off2); poke64(ctx + 64, off1); poke64(ctx + 56, actual);
    } else {
        if (offVal == 1) {
            actual := off1;
        } else {
            if (offVal == 2) {
                actual := off2;
                poke64(ctx + 64, off1); poke64(ctx + 56, actual);
            } else {
                // offVal == 3
                if (llLen == 0) {
                    actual := off3;
                    poke64(ctx + 72, off2); poke64(ctx + 64, off1); poke64(ctx + 56, actual);
                } else {
                    actual := off1 - 1;
                }
            }
        }
    }
    return actual;
}

// ========================================================================
// Literals Section Decoding
// ========================================================================

// Returns litBuf (heap pointer, caller must free) and litLen via outLen pointer.
// litBuf is 0 on error.
fn zsReadLiterals(br: int64, blockPtr: int64, outLen: int64): int64 {
    var hdr0: int64 := zsbrReadU8(br);
    var ltype: int64 := hdr0 & 3;           // bits[1:0]
    var szFmt: int64 := (hdr0 >> 2) & 3;   // bits[3:2]

    if (ltype == 0) {
        // Raw_Literals_Block: literals are uncompressed
        var rlen: int64 := 0;
        if (szFmt == 0) { rlen := (hdr0 >> 3) & 0x1F; }
        else { if (szFmt == 1) { rlen := ((hdr0 >> 4) & 0x0F) | (zsbrReadU8(br) << 4); }
        else { rlen := ((hdr0 >> 4) & 0x0F) | (zsbrReadU8(br) << 4) | (zsbrReadU8(br) << 12); } }
        poke64(outLen, rlen);
        var litBuf: int64 := alloc(rlen + 1);
        var k: int64 := 0;
        while (k < rlen) { poke8(litBuf + k, zsbrReadU8(br)); k := k + 1; }
        return litBuf;
    }

    if (ltype == 1) {
        // RLE_Literals_Block: single byte repeated
        var rlen: int64 := 0;
        if (szFmt == 0) { rlen := (hdr0 >> 3) & 0x1F; }
        else { if (szFmt == 1) { rlen := ((hdr0 >> 4) & 0x0F) | (zsbrReadU8(br) << 4); }
        else { rlen := ((hdr0 >> 4) & 0x0F) | (zsbrReadU8(br) << 4) | (zsbrReadU8(br) << 12); } }
        var rleByte: int64 := zsbrReadU8(br);
        poke64(outLen, rlen);
        var litBuf: int64 := alloc(rlen + 1);
        var k: int64 := 0;
        while (k < rlen) { poke8(litBuf + k, rleByte); k := k + 1; }
        return litBuf;
    }

    // Compressed (2) or Treeless (3) Huffman literals
    // Parse header: regeneratedSize and compressedSize
    var regenSize: int64 := 0;
    var compSize:  int64 := 0;

    if (szFmt == 0) {
        var hdr1: int64 := zsbrReadU8(br);
        var hdr2: int64 := zsbrReadU8(br);
        regenSize := ((hdr0 >> 4) & 0x0F) | ((hdr1 & 0x3F) << 4);
        compSize  := ((hdr1 >> 6) & 0x03) | (hdr2 << 2);
    } else {
        if (szFmt == 1) {
            var hdr1: int64 := zsbrReadU8(br);
            var hdr2: int64 := zsbrReadU8(br);
            regenSize := ((hdr0 >> 4) & 0x0F) | ((hdr1 & 0x3F) << 4);
            compSize  := ((hdr1 >> 6) & 0x03) | (hdr2 << 2);
        } else {
            var hdr1: int64 := zsbrReadU8(br);
            var hdr2: int64 := zsbrReadU8(br);
            var hdr3: int64 := zsbrReadU8(br);
            var hdr4: int64 := zsbrReadU8(br);
            regenSize := ((hdr0 >> 4) & 0x0F) | (hdr1 << 4) | ((hdr2 & 0x03) << 12);
            compSize  := ((hdr2 >> 2) & 0x3F) | (hdr3 << 6) | ((hdr4 & 0x03) << 14);
        }
    }

    if (regenSize == 0) { poke64(outLen, 0); return alloc(1); }

    // #1027: Die Groessen stammen aus dem Header und wurden bisher ungeprueft
    // als Zeigerdistanzen verwendet -- ein zu grosser Wert liess den Leser
    // ueber das Blockende hinauslaufen (Absturz statt Fehlermeldung).
    if (compSize <= 0)             { poke64(outLen, 0); return 0; }
    if (compSize > zsbrLeft(br))   { poke64(outLen, 0); return 0; }
    if (regenSize > 131072)        { poke64(outLen, 0); return 0; }

    var litDataStart: int64 := zsbrPos(br);
    var litPtr: int64 := blockPtr + litDataStart;
    var huffSize: int64 := compSize;   // #1027: Groesse des Huffman-Bitstroms
    // #1027: Die Zahl der Stroeme steht im Size_Format, nicht in regenSize:
    // Format 0 = EIN Strom, die Formate 1..3 = VIER Stroeme mit Sprungtabelle
    // (RFC 8878, Literals_Section_Header). Vorher wurde an `regenSize < 1024`
    // entschieden — bei kleinen Vierstrom-Bloecken also falsch.
    var nStreams: int64 := 4;
    if (szFmt == 0) { nStreams := 1; }

    // Read Huffman tree (if type=2) or reuse (type=3)
    // We build a local tree here; for Treeless we'd need the ctx, but to keep ≤6 params
    // we always build a new tree (type 3 = Treeless means reuse, which we handle by error)
    var htree: int64 := 0;
    if (ltype == 2) {
        var wbr: int64 := zsbrNew(litPtr, compSize);
        var weights: int64 := alloc(256 * 8);
        var nw: int64 := zsReadHuffWeights(wbr, litPtr, weights);
        var hdrConsumed: int64 := zsbrPos(wbr);
        free(wbr, 24);
        htree := zsHuffFromWeights(weights, nw);
        free(weights, 256 * 8);
        // #1027: nw kommt aus dem Bitstrom; oberhalb von 255 laeuft schon das
        // Gewichts-Array (256 Eintraege) ueber. Und zsHuffDecSym laeuft ueber
        // maxLen Tabellenplaetze -- zstd erlaubt hoechstens 11.
        // #1027: Die Grenze war um EINS zu streng. Das Gewichts-Array fasst 256
        // Eintraege (Indizes 0..255), und 256 Symbole sind der zulaessige
        // Hoechstfall — die Pruefung wies damit gueltige Frames ab.
        if ((nw <= 0) | (nw > 256)) {
            zsHuffFree(htree); poke64(outLen, 0); zsbrSkip(br, compSize); return 0;
        }
        if (peek64(htree + 400) < 0) {
            var hMaxLen: int64 := peek64(htree);
            if ((hMaxLen < 1) | (hMaxLen > 11)) {
                zsHuffFree(htree); poke64(outLen, 0); zsbrSkip(br, compSize); return 0;
            }
        }
        if (hdrConsumed > compSize) {
            zsHuffFree(htree); poke64(outLen, 0); zsbrSkip(br, compSize); return 0;
        }
        litDataStart += hdrConsumed;
        litPtr := blockPtr + litDataStart;
        // #1027: compSize wurde hier verkleinert und am Ende nur noch der
        // VERKLEINERTE Wert uebersprungen — der Leser blieb damit um die Groesse
        // der Baumbeschreibung hinter dem Ende der Literals-Sektion zurueck, und
        // die Sequenzen wurden ab der falschen Stelle gelesen. Die Sektionsgroesse
        // bleibt jetzt unangetastet; huffSize ist nur die Groesse des Bitstroms.
        huffSize := compSize - hdrConsumed;
    } else {
        // Treeless: would need previous tree; return error (not supported in this block)
        poke64(outLen, 0);
        zsbrSkip(br, compSize);
        return 0;
    }

    // Decompress Huffman literals
    // Use a backward bitstream. Zstd uses 4 interleaved streams for regenSize >= 1024.
    // We only handle the single-stream case (regenSize < 1024).
    var litBuf: int64 := alloc(regenSize + 1);
    poke64(outLen, regenSize);

    if (nStreams == 1) {
        // Single stream
        var rbr: int64 := zsRevNew(litPtr, huffSize);
        var k: int64 := 0;
        while (k < regenSize) {
            var sym: int64 := zsHuffDecSym(htree, rbr);
            poke8(litBuf + k, sym & 0xFF);
            k += 1;
        }
        free(rbr, 32);
    } else {
        // 4-stream interleaved Huffman (jump table = 6 bytes)
        // jump table: stream 1 size (LE16), stream 2 size (LE16), stream 3 size (LE16)
        if (huffSize < 6) {
            zsHuffFree(htree); free(litBuf, regenSize + 1);
            poke64(outLen, 0); zsbrSkip(br, compSize); return 0;
        }
        var s1len: int64 := (peek8(litPtr) & 0xFF) | ((peek8(litPtr + 1) & 0xFF) << 8);
        var s2len: int64 := (peek8(litPtr + 2) & 0xFF) | ((peek8(litPtr + 3) & 0xFF) << 8);
        var s3len: int64 := (peek8(litPtr + 4) & 0xFF) | ((peek8(litPtr + 5) & 0xFF) << 8);
        var s4len: int64 := huffSize - 6 - s1len - s2len - s3len;
        // #1027: Die drei Laengen stehen unkontrolliert im Bitstrom. Ergeben sie
        // zusammen mehr als der Block hergibt, zeigen p2..p4 hinter den Puffer.
        if (s4len <= 0) {
            zsHuffFree(htree); free(litBuf, regenSize + 1);
            poke64(outLen, 0); zsbrSkip(br, compSize); return 0;
        }

        var p1: int64 := litPtr + 6;
        var p2: int64 := p1 + s1len;
        var p3: int64 := p2 + s2len;
        var p4: int64 := p3 + s3len;

        // #1027: Die ersten DREI Stroeme liefern je ceil(regenSize/4) Symbole,
        // der vierte den Rest (RFC 8878). Vorher wurde durch vier geteilt und
        // der Rest hinten angehaengt — bei jedem regenSize, das nicht durch vier
        // teilbar ist, lagen die Segmente damit falsch.
        var perStream: int64 := (regenSize + 3) / 4;
        var lastLen:   int64 := regenSize - perStream * 3;
        if (lastLen < 0) { lastLen := 0; }

        var rbr1: int64 := zsRevNew(p1, s1len);
        var rbr2: int64 := zsRevNew(p2, s2len);
        var rbr3: int64 := zsRevNew(p3, s3len);
        var rbr4: int64 := zsRevNew(p4, s4len);

        var k: int64 := 0;
        while (k < perStream) {
            poke8(litBuf + k,                  zsHuffDecSym(htree, rbr1) & 0xFF);
            poke8(litBuf + perStream + k,      zsHuffDecSym(htree, rbr2) & 0xFF);
            poke8(litBuf + perStream * 2 + k,  zsHuffDecSym(htree, rbr3) & 0xFF);
            k += 1;
        }
        k := 0;
        while (k < lastLen) {
            poke8(litBuf + perStream * 3 + k, zsHuffDecSym(htree, rbr4) & 0xFF);
            k += 1;
        }


        free(rbr1, 32); free(rbr2, 32); free(rbr3, 32); free(rbr4, 32);
    }

    zsHuffFree(htree);
    zsbrSkip(br, compSize);
    return litBuf;
}

// ========================================================================
// Sequence Decoding
// ========================================================================

// Read or reuse FSE table for one sequence component.
// mode: 0=predefined, 1=RLE, 2=FSE_Compressed, 3=Repeat
// which: 0=LL, 1=ML, 2=OFF
// Returns new table pointer (or existing for repeat).
fn zsGetSeqTable(ctx: int64, zb: int64, mode: int64, which: int64): int64 {
    var modeField: int64 := 112 + which * 8;
    var tabField:  int64 := 88  + which * 8;
    var rleField:  int64 := 136 + which * 8;

    if (mode == 0) {
        // Predefined
        zsFSEFree(peek64(ctx + tabField));
        var tab: int64 := 0;
        if (which == 0) { tab := zsLLPredefined(); }
        else { if (which == 1) { tab := zsMLPredefined(); }
        else { tab := zsOFFPredefined(); } }
        poke64(ctx + tabField, tab);
        poke64(ctx + modeField, 0);
        return tab;
    }

    if (mode == 1) {
        // RLE: single symbol
        var rleSym: int64 := zsBitReadBits(zb, 8);
        poke64(ctx + rleField,  rleSym);
        poke64(ctx + modeField, 1);
        return 0;  // no table; caller checks mode
    }

    if (mode == 2) {
        // FSE compressed
        var maxSym: int64 := 35;
        if (which == 1) { maxSym := 52; }
        if (which == 2) { maxSym := 28; }
        var probs: int64 := alloc((maxSym + 1) * 8);
        var AL: int64 := zsReadFSEProbs(zb, maxSym, probs);
        var tab: int64 := zsFSEBuild(probs, maxSym + 1, AL);
        free(probs, (maxSym + 1) * 8);
        zsFSEFree(peek64(ctx + tabField));
        poke64(ctx + tabField, tab);
        poke64(ctx + modeField, 2);
        return tab;
    }

    // mode == 3: Repeat — reuse existing table
    return peek64(ctx + tabField);
}

// Decode all sequences and apply to output.
// Reads from rbr (reverse bitstream over sequence data).
// #1027: Ein FSE-Zustand ausserhalb der Tabelle las bisher an einer beliebigen
// Adresse (zsFSESym rechnet ungeprueft tab[state]) -- daher die Abstuerze bei
// jedem etwas groesseren Compressed Block. Gueltig ist 0 <= state < 2^AL.
fn zsStateOk(state: int64, AL: int64): int64 {
    if (state < 0) { return 0; }
    if (state >= (1 << AL)) { return 0; }
    return 1;
}

// Symbolcodes nach RFC 8878: literal-length <= 35, match-length <= 52,
// offset-code <= 31. Groessere Werte kommen nur aus einem entgleisten Decoder;
// sie wuerden als Schiebeweite bzw. Bitanzahl weiterverwendet.
fn zsCodesOk(llCode: int64, mlCode: int64, offCode: int64): int64 {
    if ((llCode  < 0) | (llCode  > 35)) { return 0; }
    if ((mlCode  < 0) | (mlCode  > 52)) { return 0; }
    if ((offCode < 0) | (offCode > 31)) { return 0; }
    return 1;
}

fn zsDecodeSeqs(ctx: int64, rbr: int64, litBuf: int64, litLen: int64, numSeq: int64): void {
    if (numSeq == 0) {
        // No sequences — copy all literals
        var k: int64 := 0;
        while (k < litLen) { zsOutput(ctx, peek8(litBuf + k)); k := k + 1; }
        return;
    }

    var llMode: int64 := peek64(ctx + 112);
    var mlMode: int64 := peek64(ctx + 120);
    var offMode: int64 := peek64(ctx + 128);
    var llTab:   int64 := peek64(ctx + 88);
    var mlTab:   int64 := peek64(ctx + 96);
    var offTab:  int64 := peek64(ctx + 104);
    var llAL:    int64 := 0;
    var mlAL:    int64 := 0;
    var offAL:   int64 := 0;
    if (llTab  != 0) { llAL  := peek64(llTab); }
    if (mlTab  != 0) { mlAL  := peek64(mlTab); }
    if (offTab != 0) { offAL := peek64(offTab); }

    // Initialize states from reverse bitstream
    var llState:  int64 := 0;
    var mlState:  int64 := 0;
    var offState: int64 := 0;
    // #1027: fehlende Tabelle heisst, dass zsGetSeqTable nicht durchkam. Vorher
    // lief der Decoder mit AL=0 und einer Nullzeiger-Tabelle weiter.
    if ((llMode  != 1) & (llTab  == 0)) { poke64(ctx + 48, 1); return; }
    if ((mlMode  != 1) & (mlTab  == 0)) { poke64(ctx + 48, 1); return; }
    if ((offMode != 1) & (offTab == 0)) { poke64(ctx + 48, 1); return; }

    if (llMode  != 1) { llState  := zsRevReadBits(rbr, llAL); }
    if (offMode != 1) { offState := zsRevReadBits(rbr, offAL); }
    if (mlMode  != 1) { mlState  := zsRevReadBits(rbr, mlAL); }

    if (llMode  != 1) { if (zsStateOk(llState,  llAL)  == 0) { poke64(ctx + 48, 1); return; } }
    if (mlMode  != 1) { if (zsStateOk(mlState,  mlAL)  == 0) { poke64(ctx + 48, 1); return; } }
    if (offMode != 1) { if (zsStateOk(offState, offAL) == 0) { poke64(ctx + 48, 1); return; } }

    var litPos: int64 := 0;
    var seqIdx: int64 := 0;

    while (seqIdx < numSeq) {
        var isLast: int64 := 0;
        if (seqIdx == numSeq - 1) { isLast := 1; }

        // Peek symbols
        var llCode: int64 := peek64(ctx + 136);  // RLE sym default
        var mlCode: int64 := peek64(ctx + 144);
        var offCode: int64 := peek64(ctx + 152);
        if (llMode  != 1) { llCode  := zsFSESym(llTab,  llState); }
        if (mlMode  != 1) { mlCode  := zsFSESym(mlTab,  mlState); }
        if (offMode != 1) { offCode := zsFSESym(offTab, offState); }

        // #1027: entgleiste Symbolcodes vor der Weiterverwendung abfangen
        if (zsCodesOk(llCode, mlCode, offCode) == 0) { poke64(ctx + 48, 1); return; }

        // Decode extra bits
        var offExtra: int64 := zsRevReadBits(rbr, offCode);
        var offVal:   int64 := (1 << offCode) + offExtra;
        var mlExtra:  int64 := zsMLExtra(mlCode);
        var mlLen:    int64 := zsMLBase(mlCode) + zsRevReadBits(rbr, mlExtra);
        var llExtra:  int64 := zsLLExtra(llCode);
        var llLen:    int64 := zsLLBase(llCode) + zsRevReadBits(rbr, llExtra);

        // #1027 RFC 8878 3.1.1.3.2.1: die Zustaende werden ERST NACH den
        // Zusatzbits fortgeschrieben, und zwar in der Reihenfolge LL, ML, OFF.
        // Vorher lief das Update vor den Zusatzbits und mit LL, OFF, ML --
        // beides verschiebt den Rueckwaertsstrom und laesst jede Sequenz nach
        // der ersten auf falschen Bits landen.
        if (isLast == 0) {
            if (llMode  != 1) { llState  := zsFSENewState(llTab,  llState)  + zsRevReadBits(rbr, zsFSENbBits(llTab,  llState)); }
            if (mlMode  != 1) { mlState  := zsFSENewState(mlTab,  mlState)  + zsRevReadBits(rbr, zsFSENbBits(mlTab,  mlState)); }
            if (offMode != 1) { offState := zsFSENewState(offTab, offState) + zsRevReadBits(rbr, zsFSENbBits(offTab, offState)); }

            // #1027: Zustand muss in der Tabelle bleiben, sonst liest der
            // naechste Durchlauf ausserhalb.
            if (llMode  != 1) { if (zsStateOk(llState,  llAL)  == 0) { poke64(ctx + 48, 1); return; } }
            if (mlMode  != 1) { if (zsStateOk(mlState,  mlAL)  == 0) { poke64(ctx + 48, 1); return; } }
            if (offMode != 1) { if (zsStateOk(offState, offAL) == 0) { poke64(ctx + 48, 1); return; } }
        }

        // Resolve offset
        var actual: int64 := zsResolveOffset(ctx, offVal, llLen);

        // Copy literal run
        var k: int64 := 0;
        while ((k < llLen) & (litPos < litLen)) {
            zsOutput(ctx, peek8(litBuf + litPos));
            litPos += 1;
            k += 1;
        }
        // #1027: Reichen die Literale nicht fuer den angeforderten Lauf, ist der
        // Decoder aus dem Tritt. Vorher wurde der Lauf still gekuerzt und die
        // Ausgabe lief zu kurz weiter -- ohne gesetztes Fehlerflag.
        if (k < llLen) { poke64(ctx + 48, 1); return; }

        // Copy match
        zsCopyBack(ctx, actual, mlLen);
        if (peek64(ctx + 48) != 0) { return; }

        seqIdx += 1;
    }

    // Copy remaining literals
    while (litPos < litLen) {
        zsOutput(ctx, peek8(litBuf + litPos));
        litPos += 1;
    }
}

// ========================================================================
// Compressed Block Decompression
// ========================================================================

fn zsDecompressCompressed(ctx: int64, blkPtr: int64, blkLen: int64): void {
    var br: int64 := zsbrNew(blkPtr, blkLen);

    // --- Literals section ---
    var litLenOut: int64 := alloc(8);
    poke64(litLenOut, 0);
    var litBuf: int64 := zsReadLiterals(br, blkPtr, litLenOut);
    var litLen: int64 := peek64(litLenOut);
    free(litLenOut, 8);

    if (litBuf == 0) { poke64(ctx + 48, 1); free(br, 24); return; }

    // --- Sequences section ---
    if (zsbrLeft(br) == 0) {
        // No sequences — just output literals
        var k: int64 := 0;
        while (k < litLen) { zsOutput(ctx, peek8(litBuf + k)); k := k + 1; }
        free(litBuf, litLen + 1); free(br, 24);
        return;
    }

    // Read number of sequences
    var nsRaw: int64 := zsbrReadU8(br);
    var numSeq: int64 := 0;
    if (nsRaw == 0) { numSeq := 0; }
    else {
        if (nsRaw < 128) { numSeq := nsRaw; }
        else {
            if (nsRaw < 255) {
                numSeq := ((nsRaw - 128) << 8) + zsbrReadU8(br);
            } else {
                numSeq := zsbrReadU8(br) + (zsbrReadU8(br) << 8) + 0x7F00;
            }
        }
    }

    if (numSeq == 0) {
        // Output all literals
        var k: int64 := 0;
        while (k < litLen) { zsOutput(ctx, peek8(litBuf + k)); k := k + 1; }
        free(litBuf, litLen + 1); free(br, 24);
        return;
    }

    // Read compression mode byte
    var modeByte: int64 := zsbrReadU8(br);
    var llMode:   int64 := (modeByte >> 6) & 3;
    var offMode:  int64 := (modeByte >> 4) & 3;
    var mlMode:   int64 := (modeByte >> 2) & 3;

    // Read FSE tables into ctx
    var zb: int64 := zsBitNew(blkPtr, zsbrPos(br));
    // #1027: Die Tabellen stehen im Block in der Reihenfolge LL, OFFSET, ML
    // (RFC 8878, Sequences_Section) — hier wurde ML vor OFFSET gelesen. Damit
    // war ab der zweiten Tabelle jede Bitposition falsch.
    zsGetSeqTable(ctx, zb, llMode,  0);
    zsGetSeqTable(ctx, zb, offMode, 2);
    zsGetSeqTable(ctx, zb, mlMode,  1);
    // #1027: ebenso hier — die drei Sequenztabellen enden an einer Bytegrenze.
    zsBitSkipToByte(zb);
    var tabBytesUsed: int64 := zsBitBytePos(zb);
    free(zb, 24);

    zsbrSeekTo(br, tabBytesUsed);

    // The rest of the block is the reverse bitstream for sequences
    var seqBitStart: int64 := zsbrPos(br);
    var seqBitLen:   int64 := blkLen - seqBitStart;
    // #1027: Stimmt die verbrauchte Tabellengroesse nicht, wird seqBitLen <= 0.
    // zsRevNew las dann bei ptr + len - 1 UNTERHALB des Puffers -- der Bus-Fehler
    // an einer Mapping-Grenze. Jetzt: melden statt lesen.
    if (seqBitLen <= 0) {
        poke64(ctx + 48, 1);
        free(litBuf, litLen + 1); free(br, 24);
        return;
    }
    var rbr: int64 := zsRevNew(blkPtr + seqBitStart, seqBitLen);

    zsDecodeSeqs(ctx, rbr, litBuf, litLen, numSeq);

    free(rbr, 32);
    free(litBuf, litLen + 1);
    free(br, 24);
}

fn zsDecompressBlock(ctx: int64, blkPtr: int64, blkLen: int64, blkType: int64): void {
    if (blkType == 0) {
        // Raw block
        var k: int64 := 0;
        while (k < blkLen) { zsOutput(ctx, peek8(blkPtr + k)); k := k + 1; }
    } else {
        if (blkType == 1) {
            // RLE block: repeated byte, blkLen times (single byte in blkPtr)
            var rleByte: int64 := peek8(blkPtr);
            var k: int64 := 0;
            // blkLen is NOT the block payload size for RLE; it's the RLE count
            // The actual byte payload is 1 byte; blkLen from header is the count
            while (k < blkLen) { zsOutput(ctx, rleByte); k := k + 1; }
        } else {
            // #1027: Compressed Blocks (Huffman/FSE) laufen wieder.
            //
            // Der Pfad war fail-closed, solange er stillschweigend falschen
            // Inhalt lieferte. Gemessen ueber 97 Frames derselben Textquelle in
            // aufsteigender Groesse (zstd -1) steht er jetzt bei
            // 97 korrekt / 0 still falsch / 0 gemeldet / 0 abgestuerzt --
            // Ausgangslage waren 5 korrekt, 6 still falsch, 19 gemeldet,
            // 67 Abstuerze. tests/zstd_measure.sh haelt die Messung fest und
            // wird rot, sobald wieder ein Frame still falsch endet.
            zsDecompressCompressed(ctx, blkPtr, blkLen);
        }
    }
}

// ========================================================================
// Frame Decompression
// ========================================================================

pub fn ZstdDecompress(src: int64, srcLen: int64, dst: int64, dstMax: int64): int64 {
    if (((src == 0) | (dst == 0)) | (srcLen < 4)) { return ZSTD_ERR; }

    var ctx: int64 := zsCtxNew(src, srcLen, dst, dstMax);
    var br:  int64 := zsbrNew(src, srcLen);

    // Check magic: 0xFD2FB528 little-endian = bytes 28 B5 2F FD
    var m0: int64 := zsbrReadU8(br);
    var m1: int64 := zsbrReadU8(br);
    var m2: int64 := zsbrReadU8(br);
    var m3: int64 := zsbrReadU8(br);
    var badMagic: int64 := 0;
    if (m0 != 0x28) { badMagic := 1; }
    if (m1 != 0xB5) { badMagic := 1; }
    if (m2 != 0x2F) { badMagic := 1; }
    if (m3 != 0xFD) { badMagic := 1; }

    // Skip skippable frames (magic 0x184D2A5?) — check upper nibble of LE32
    // For simplicity skip if first 4 bytes don't match either frame magic
    if (badMagic != 0) {
        free(br, 24); zsCtxFree(ctx);
        return ZSTD_ERR;
    }

    // Frame Header
    var fhd: int64 := zsbrReadU8(br);
    var fcsFld:  int64 := (fhd >> 6) & 3;
    var ssf:     int64 := (fhd >> 5) & 1;
    var ccf:     int64 := (fhd >> 2) & 1;  // bit2 per zstd source
    var didFlag: int64 := fhd & 3;          // bits[1:0] per zstd source

    if (ssf == 0) {
        // Window_Descriptor: 1 byte (we just skip it)
        zsbrReadU8(br);
    }

    // Dictionary_ID field
    if (didFlag == 1) { zsbrReadU8(br); }
    else { if (didFlag == 2) { zsbrReadLE16(br); }
    else { if (didFlag == 3) { zsbrReadLE32(br); } } }

    // Content_Size field
    var contentSize: int64 := 0;
    if ((ssf == 1) & (fcsFld == 0)) {
        contentSize := zsbrReadU8(br);
    } else {
        if (fcsFld == 1) { contentSize := zsbrReadLE16(br) + 256; }
        else { if (fcsFld == 2) { contentSize := zsbrReadLE32(br); }
        else { if (fcsFld == 3) { contentSize := zsbrReadLE64(br); } } }
    }
    poke64(ctx + 160, contentSize);

    // Check output buffer size
    if ((contentSize > 0) & (contentSize > dstMax)) {
        free(br, 24); zsCtxFree(ctx);
        return ZSTD_OVERFLOW;
    }

    // Block loop
    var done: int64 := 0;
    while (done == 0) {
        if (zsbrLeft(br) < 3) { done := 1; }
        else {
            var hdrLE: int64 := zsbrReadLE24(br);
            var lastBlock: int64 := hdrLE & 1;
            var blockType: int64 := (hdrLE >> 1) & 3;
            var blockSize: int64 := hdrLE >> 3;

            if (blockType == 3) {
                poke64(ctx + 48, 1);  // reserved = error
                done := 1;
            } else {
                var blkPtr: int64 := src + zsbrPos(br);

                // #1027: Blockgroesse gegen die verbleibende Eingabe pruefen.
                // Ein zu grosser Wert (verstuemmelter oder falsch gelesener
                // Header) liess den Decoder ueber das Ende des Puffers laufen.
                if (blockType != 1) {
                    if (blockSize > zsbrLeft(br)) { poke64(ctx + 48, 1); done := 1; }
                }

                if (blockType == 1) {
                    // RLE: 1 byte in stream, blockSize = repetition count
                    zsDecompressBlock(ctx, blkPtr, blockSize, 1);
                    zsbrSkip(br, 1);
                } else {
                    zsDecompressBlock(ctx, blkPtr, blockSize, blockType);
                    if (blockType == 0) { zsbrSkip(br, blockSize); }
                    else { zsbrSkip(br, blockSize); }
                }
            }

            if (lastBlock == 1) { done := 1; }
            if (peek64(ctx + 48) != 0) { done := 1; }
        }
    }

    var result: int64 := ZSTD_ERR;
    if (peek64(ctx + 48) == 0) {
        result := peek64(ctx + 32);
        // #1027: Der Frame-Header nennt die Groesse des Inhalts. Weicht die
        // geschriebene Menge davon ab, war die Dekodierung falsch -- egal ob
        // unterwegs ein Fehler auffiel. Genau dieser Fall lieferte bisher
        // stillschweigend eine falsche Laenge samt Muell im Puffer.
        if (contentSize > 0) {
            if (result != contentSize) { result := ZSTD_ERR; }
        }
    }

    free(br, 24);
    zsCtxFree(ctx);
    return result;
}

// ========================================================================
// Store-Modus Compressor
// Format: magic(4) + FHD(1) + ContentSize(8) + blocks + last empty block
// Each raw block: blockHdr(3) + rawData
// Max block payload: 131072 bytes (128 KB)
// Block header (24-bit LE): bit0=LastBlock, bits[2:1]=BlockType(0=Raw), bits[23:3]=BlockSize
// ========================================================================

pub fn ZstdCompress(src: int64, srcLen: int64, dst: int64, dstMax: int64): int64 {
    if (((src == 0) | (dst == 0))) { return ZSTD_ERR; }

    var blockMax: int64 := 131072;
    var numBlocks: int64 := 1;
    if (srcLen > 0) { numBlocks := (srcLen + blockMax - 1) / blockMax; }
    // Overhead: 13 bytes frame header + 3 bytes per block
    var needed: int64 := 13 + numBlocks * 3 + srcLen;
    if (dstMax < needed) { return ZSTD_OVERFLOW; }

    var pos: int64 := 0;

    // Magic: 28 B5 2F FD
    poke8(dst + pos, 0x28); pos := pos + 1;
    poke8(dst + pos, 0xB5); pos := pos + 1;
    poke8(dst + pos, 0x2F); pos := pos + 1;
    poke8(dst + pos, 0xFD); pos := pos + 1;

    // FHD: FCS=11 (8-byte size), SSF=1, CCF=0, DID=00
    // = bits[7:6]=11, bit5=1, bit4=0, bit3=0, bits[2:1]=00, bit0=0
    // = 1110_0000 = 0xE0
    poke8(dst + pos, 0xE0); pos := pos + 1;

    // Content size (8 bytes LE)
    var cs: int64 := srcLen;
    var k: int64 := 0;
    while (k < 8) { poke8(dst + pos, cs & 0xFF); cs := cs >> 8; pos := pos + 1; k := k + 1; }

    // Raw blocks
    var srcOff: int64 := 0;
    while (srcOff < srcLen) {
        var remain: int64 := srcLen - srcOff;
        var blkSize: int64 := remain;
        if (blkSize > blockMax) { blkSize := blockMax; }
        var isLast: int64 := 0;
        if (srcOff + blkSize >= srcLen) { isLast := 1; }
        // Block header: blockSize << 3 | BlockType=0 << 1 | isLast
        var hdr: int64 := (blkSize << 3) | isLast;
        poke8(dst + pos, hdr & 0xFF);         pos := pos + 1;
        poke8(dst + pos, (hdr >> 8) & 0xFF);  pos := pos + 1;
        poke8(dst + pos, (hdr >> 16) & 0xFF); pos := pos + 1;
        var j: int64 := 0;
        while (j < blkSize) { poke8(dst + pos, peek8(src + srcOff + j)); pos := pos + 1; j := j + 1; }
        srcOff += blkSize;
    }

    // If srcLen == 0: write a single empty last block
    if (srcLen == 0) {
        // LastBlock=1, BlockType=0, BlockSize=0 → hdr = (0 << 3) | (0 << 1) | 1 = 1
        poke8(dst + pos, 1); pos := pos + 1;
        poke8(dst + pos, 0); pos := pos + 1;
        poke8(dst + pos, 0); pos := pos + 1;
    }

    return pos;
}
