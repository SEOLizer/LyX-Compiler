// std/zstd.lyx — Zstandard (RFC 8878)
//
// STAND Compressed Blocks (#1027): der Pfad LAEUFT. Gemessen wird mit
// tests/zstd_measure.sh ueber 97 Frames derselben Textquelle in aufsteigender
// Groesse (`zstd -1`, 20..116 Byte); die vier Ausgaenge werden getrennt
// gezaehlt, weil sie unterschiedlich schlimm sind.
//
//                             korrekt  still falsch  gemeldet  abgestuerzt
//   vor #1041                    5          6           19         67
//   nach #1041 (fail-closed)    44          0           53          0
//   Literale richtig             63         0           34          0
//   Sequenzen richtig            97         0            0          0
//
// Was auf dem Weg dorthin falsch war, in der Reihenfolge des Findens:
//
//  1. Der FSE-Gewichtsleser lief zu lange. RFC 8878 §4.2.1.2 macht die
//     Terminierung daran fest, ob das ZUSTANDS-UPDATE noch in den Strom passt
//     — geprueft VOR dem Verbrauch, nicht danach (zsRevBitsLeft).
//  2. Die Codezuweisung lief in der falschen Richtung: in zstd beginnt der
//     LAENGSTE Code bei 0, nicht der kuerzeste (zsHuffBuildLens).
//  3. Der FSE-Tabellenkopf endet an einer BYTEGRENZE. Ohne zsBitSkipToByte
//     wurde das angebrochene Byte mitgezaehlt und der Rueckwaertsstrom begann
//     ein Byte zu frueh — das war die Ursache hinter 1. und 2.
//  4. Die drei Sequenztabellen stehen in der Reihenfolge LL, OFFSET, ML.
//  5. Im Sequenzpfad wurden die FSE-Zustaende VOR den Zusatzbits
//     fortgeschrieben und in der Reihenfolge LL, OFF, ML. Richtig ist:
//     erst die Zusatzbits (Offset, ML, LL), dann das Update LL, ML, OFF.
//  6. Vier der eingebauten Tabellen wichen vom RFC ab — die vordefinierte
//     LL-Verteilung (2er-Lauf bis Symbol 12, nicht 8), die vordefinierte
//     OFFSET-Verteilung (2er bei 6..8, nicht 5..7), die LL-Zusatzbits ab
//     Code 25 und die ML-Basen und -Zusatzbits ab Code 43.
//
// Punkt 6 ist die Lehre dieses Issues: eine von Hand abgetippte Konstanten-
// tabelle sieht plausibel aus und ist trotzdem falsch. Gefunden wurden alle
// vier erst, als eine unabhaengige Referenzdekodierung derselben vier Bytes
// danebengelegt wurde — nicht durch Lesen des eigenen Codes.
unit std.zstd;

import std.alloc;
import std.io;
import std.string;

pub con ZSTD_OK:       int64 := 0;
pub con ZSTD_ERR:      int64 := 0 - 1;
pub con ZSTD_OVERFLOW: int64 := 0 - 2;

// ========================================================================
// Forward Byte Reader  ZsBR (24 B): [0]=ptr [8]=pos [16]=len
// ========================================================================

fn zsbrNew(ptr: int64, len: int64): int64 {
    var br: int64 := alloc(24);
    poke64(br, ptr); poke64(br + 8, 0); poke64(br + 16, len);
    return br;
}

fn zsbrLeft(br: int64): int64 { return peek64(br + 16) - peek64(br + 8); }
fn zsbrPos(br: int64): int64  { return peek64(br + 8); }

fn zsbrReadU8(br: int64): int64 {
    var pos: int64 := peek64(br + 8);
    var val: int64 := peek8(peek64(br) + pos);
    poke64(br + 8, pos + 1);
    return val;
}

fn zsbrReadLE16(br: int64): int64 {
    var lo: int64 := zsbrReadU8(br);
    return lo | (zsbrReadU8(br) << 8);
}

fn zsbrReadLE24(br: int64): int64 {
    var b0: int64 := zsbrReadU8(br);
    var b1: int64 := zsbrReadU8(br);
    return b0 | (b1 << 8) | (zsbrReadU8(br) << 16);
}

fn zsbrReadLE32(br: int64): int64 {
    var lo: int64 := zsbrReadLE16(br);
    return lo | (zsbrReadLE16(br) << 16);
}

fn zsbrReadLE64(br: int64): int64 {
    var lo: int64 := zsbrReadLE32(br);
    return lo | (zsbrReadLE32(br) << 32);
}

fn zsbrSkip(br: int64, n: int64): void { poke64(br + 8, peek64(br + 8) + n); }
fn zsbrSeekTo(br: int64, pos: int64): void { poke64(br + 8, pos); }

// ========================================================================
// Forward Bit Reader  ZsBit (24 B): [0]=ptr [8]=bytePos [16]=bitInByte
// Bits within a byte are consumed LSB-first (low bit = bit 0)
// ========================================================================

fn zsBitNew(ptr: int64, bytePos: int64): int64 {
    var zb: int64 := alloc(24);
    poke64(zb, ptr); poke64(zb + 8, bytePos); poke64(zb + 16, 0);
    return zb;
}

fn zsBitReadOne(zb: int64): int64 {
    var bpos: int64 := peek64(zb + 8);
    var bit:  int64 := peek64(zb + 16);
    var val:  int64 := (peek8(peek64(zb) + bpos) >> bit) & 1;
    bit += 1;
    if (bit == 8) { bit := 0; bpos := bpos + 1; }
    poke64(zb + 8, bpos); poke64(zb + 16, bit);
    return val;
}

fn zsBitReadBits(zb: int64, n: int64): int64 {
    var val: int64 := 0;
    var i:   int64 := 0;
    while (i < n) { val := val | (zsBitReadOne(zb) << i); i := i + 1; }
    return val;
}

fn zsBitSkipToByte(zb: int64): void {
    var bit: int64 := peek64(zb + 16);
    if (bit != 0) { poke64(zb + 8, peek64(zb + 8) + 1); poke64(zb + 16, 0); }
}

fn zsBitBytePos(zb: int64): int64 { return peek64(zb + 8); }

// ========================================================================
// Reverse Bit Reader  ZsRevBR (32 B): [0]=ptr [8]=bytePos [16]=curByte [24]=bitInByte
// Reads from the END of a buffer going backwards, MSB-first within each byte.
// Last byte has a sentinel 1-bit at its highest set bit.
// ========================================================================

fn zsRevNew(ptr: int64, len: int64): int64 {
    var rbr: int64 := alloc(32);
    var k: int64 := 0;
    while (k < 32) { poke8(rbr + k, 0); k := k + 1; }
    poke64(rbr, ptr);
    if (len == 0) { poke64(rbr + 24, 0 - 1); return rbr; }
    var lastByte: int64 := peek8(ptr + len - 1);
    if (lastByte == 0) { poke64(rbr + 24, 0 - 1); return rbr; }
    // Find highest set bit (= sentinel)
    var hb: int64 := 7;
    while (((lastByte >> hb) & 1) == 0) { hb := hb - 1; }
    poke64(rbr + 8,  len - 1);   // bytePos = last byte index
    poke64(rbr + 16, lastByte);  // curByte
    poke64(rbr + 24, hb - 1);   // bitInByte = bit below sentinel (-1 if hb=0)
    return rbr;
}

fn zsRevReadBit(rbr: int64): int64 {
    var bitPos: int64 := peek64(rbr + 24);
    if (bitPos < 0) {
        var bpos: int64 := peek64(rbr + 8) - 1;
        if (bpos < 0) { return 0; }
        poke64(rbr + 8,  bpos);
        poke64(rbr + 16, peek8(peek64(rbr) + bpos));
        poke64(rbr + 24, 7);
        bitPos := 7;
    }
    var val: int64 := (peek64(rbr + 16) >> bitPos) & 1;
    poke64(rbr + 24, bitPos - 1);
    return val;
}

// #1027: Wie viele Bits stehen im Rueckwaertsstrom noch bereit?
// RFC 8878 §4.2.1.2 macht die Terminierung des Gewichtslesers daran fest:
// "if updating state after decoding a symbol would require more bits than
//  remain in the stream, it is assumed that extra bits are zero."
// Geprueft wird also VOR dem Verbrauch, nicht danach.
fn zsRevBitsLeft(rbr: int64): int64 {
    var bitPos: int64 := peek64(rbr + 24);
    var bytePos: int64 := peek64(rbr + 8);
    if (bitPos < 0 && bytePos <= 0) { return 0; }
    return bytePos * 8 + bitPos + 1;
}

// #1027: Ist der Rueckwaertsstrom aufgebraucht? Erschoepft heisst: das erste
// Byte ist erreicht UND darin sind alle Bits verbraucht. Vorher wurde an zwei
// Rohfeldern geprueft, was den Zustand nur zufaellig traf.
fn zsRevExhausted(rbr: int64): int64 {
    if (peek64(rbr + 24) < 0 && peek64(rbr + 8) <= 0) { return 1; }
    return 0;
}

fn zsRevReadBits(rbr: int64, n: int64): int64 {
    if (n == 0) { return 0; }
    var val: int64 := 0;
    var i:   int64 := n - 1;
    while (i >= 0) { val := val | (zsRevReadBit(rbr) << i); i := i - 1; }
    return val;
}

// ========================================================================
// Helpers
// ========================================================================

fn zsHighbit(x: int64): int64 {
    var h: int64 := 0;
    var v: int64 := x;
    while (v > 1) { v := v >> 1; h := h + 1; }
    return h;
}

fn zsAbs(x: int64): int64 {
    if (x < 0) { return 0 - x; }
    return x;
}

// ========================================================================
// FSE Table  ZsFSE (16+tableSize*8 B): [0]=AL [8]=entriesBase
// Entry packed as int64: bits[7:0]=sym  bits[15:8]=nbBits  bits[31:16]=newState
// ========================================================================

fn zsFSEAlloc(AL: int64): int64 {
    var sz: int64 := 16 + ((1 << AL) * 8);
    var tab: int64 := alloc(sz);
    var k: int64 := 0;
    while (k < sz) { poke8(tab + k, 0); k := k + 1; }
    poke64(tab,     AL);
    poke64(tab + 8, tab + 16);
    return tab;
}

// Groesse gemaess zsFSEAlloc: 16 + (1 << AL) * 8, und AL liegt in tab[0].
fn zsFSEFree(tab: int64): void { if (tab != 0) { free(tab, 16 + ((1 << peek64(tab)) * 8)); } }

fn zsFSESym(tab: int64, state: int64): int64 {
    return peek64(peek64(tab + 8) + state * 8) & 0xFF;
}

fn zsFSENbBits(tab: int64, state: int64): int64 {
    return (peek64(peek64(tab + 8) + state * 8) >> 8) & 0xFF;
}

fn zsFSENewState(tab: int64, state: int64): int64 {
    return (peek64(peek64(tab + 8) + state * 8) >> 16) & 0xFFFF;
}

fn zsFSESetEntry(tab: int64, pos: int64, sym: int64, nbBits: int64, newState: int64): void {
    var entry: int64 := (sym & 0xFF) | ((nbBits & 0xFF) << 8) | ((newState & 0xFFFF) << 16);
    poke64(peek64(tab + 8) + pos * 8, entry);
}

// Build FSE decoding table from probability array.
// probs[i] = probability (-1 means "less probable" = 1 slot)
fn zsFSEBuild(probs: int64, numProbs: int64, AL: int64): int64 {
    var tab:       int64 := zsFSEAlloc(AL);
    var tableSize: int64 := 1 << AL;
    var tableMask: int64 := tableSize - 1;
    var step:      int64 := (tableSize >> 1) + (tableSize >> 3) + 3;
    var highThr:   int64 := tableSize - 1;

    // Temp symbol array
    var symArr: int64 := alloc(tableSize * 8);
    var k: int64 := 0;
    while (k < tableSize) { poke64(symArr + k * 8, 0 - 1); k := k + 1; }

    // Place -1 prob symbols at top
    var s: int64 := 0;
    while (s < numProbs) {
        if (peek64(probs + s * 8) == (0 - 1)) {
            poke64(symArr + highThr * 8, s);
            highThr -= 1;
        }
        s += 1;
    }

    // Spread normal symbols
    var pos: int64 := 0;
    s := 0;
    while (s < numProbs) {
        var p: int64 := peek64(probs + s * 8);
        if (p > 0) {
            var j: int64 := 0;
            while (j < p) {
                poke64(symArr + pos * 8, s);
                pos := (pos + step) & tableMask;
                while (pos > highThr) { pos := (pos + step) & tableMask; }
                j += 1;
            }
        }
        s += 1;
    }

    // symbolNext array (starts at prob[s] for each symbol)
    var symNext: int64 := alloc(numProbs * 8);
    s := 0;
    while (s < numProbs) {
        var p: int64 := peek64(probs + s * 8);
        if (p > 0) { poke64(symNext + s * 8, p); }
        else { if (p == (0 - 1)) { poke64(symNext + s * 8, 1); } }
        s += 1;
    }

    // Fill nbBits + newState
    var i: int64 := 0;
    while (i < tableSize) {
        var sym: int64 := peek64(symArr + i * 8);
        if ((sym >= 0) & (sym < numProbs)) {
            var ns: int64 := peek64(symNext + sym * 8);
            poke64(symNext + sym * 8, ns + 1);
            var nbBits:   int64 := AL - zsHighbit(ns);
            var newState: int64 := (ns << nbBits) - tableSize;
            zsFSESetEntry(tab, i, sym, nbBits, newState);
        }
        i += 1;
    }

    free(symArr, tableSize * 8); free(symNext, numProbs * 8);
    return tab;
}

// Read FSE probability table from forward bit reader.
// probs: pre-allocated int64 array [0..maxSym], filled on return.
// Returns AL (accuracy log) on success, or -1 on error.
fn zsReadFSEProbs(zb: int64, maxSym: int64, probs: int64): int64 {
    var AL: int64 := zsBitReadBits(zb, 4) + 5;
    var tableSize: int64 := 1 << AL;
    var remaining: int64 := tableSize + 1;
    var threshold: int64 := tableSize;
    var nbBits:    int64 := AL + 1;

    var s: int64 := 0;
    while (s <= maxSym) { poke64(probs + s * 8, 0); s := s + 1; }

    var charnum: int64 := 0;
    var prev0:   int64 := 0;

    while ((remaining > 1) & (charnum <= maxSym)) {
        if (prev0 != 0) {
            // Zero-run: read pairs of bits
            var n0: int64 := charnum;
            var done: int64 := 0;
            while (done == 0) {
                var rr: int64 := zsBitReadBits(zb, 2);
                if (rr == 3) { n0 := n0 + 3; }
                else { n0 := n0 + rr; done := 1; }
            }
            while (charnum < n0) {
                if (charnum <= maxSym) { poke64(probs + charnum * 8, 0); }
                charnum += 1;
            }
            prev0 := 0;
        }

        if ((remaining > 1) & (charnum <= maxSym)) {
            var maxval: int64 := (2 * threshold) - 1 - remaining;
            var lowPart: int64 := zsBitReadBits(zb, nbBits - 1);
            var cnt: int64 := 0;
            if (lowPart < maxval) {
                cnt := lowPart;
            } else {
                var extraBit: int64 := zsBitReadBits(zb, 1);
                var fullVal:  int64 := lowPart | (extraBit << (nbBits - 1));
                if (fullVal >= threshold) { cnt := fullVal - maxval; }
                else { cnt := fullVal; }
            }
            cnt -= 1;
            if (cnt == (0 - 1)) { remaining := remaining - 1; }
            else { if (cnt > 0) { remaining := remaining - cnt; } }
            if (charnum <= maxSym) { poke64(probs + charnum * 8, cnt); }
            charnum += 1;
            while (remaining < threshold) { threshold := threshold >> 1; nbBits := nbBits - 1; }
            if (cnt == 0) { prev0 := 1; }
            else { prev0 := 0; }
        }
    }
    return AL;
}

// ========================================================================
// Predefined probability arrays and FSE tables for LL / ML / OFF
// Default tableLog: LL=6 (sum=64), ML=6 (sum=64), OFF=5 (sum=32)
// ========================================================================

fn zsLLProb(sym: int64): int64 {
    if (sym == 0)  { return 4; }
    if (sym == 1)  { return 3; }
    if ((sym >= 2)  & (sym <= 12)) { return 2; }
    if ((sym >= 13) & (sym <= 15)) { return 1; }
    if ((sym >= 16) & (sym <= 24)) { return 2; }
    if (sym == 25) { return 3; }
    if (sym == 26) { return 2; }
    if ((sym >= 27) & (sym <= 31)) { return 1; }
    if ((sym >= 32) & (sym <= 35)) { return 0 - 1; }
    return 0;
}

fn zsMLProb(sym: int64): int64 {
    if (sym == 1) { return 4; }
    if (sym == 2) { return 3; }
    if ((sym >= 3) & (sym <= 8)) { return 2; }
    if ((sym >= 46) & (sym <= 52)) { return 0 - 1; }
    if ((sym >= 0) & (sym <= 52)) { return 1; }
    return 0;
}

fn zsOFFProb(sym: int64): int64 {
    if ((sym >= 6) & (sym <= 8)) { return 2; }
    if ((sym >= 24) & (sym <= 28)) { return 0 - 1; }
    if ((sym >= 0) & (sym <= 28)) { return 1; }
    return 0;
}

fn zsLLPredefined(): int64 {
    var probs: int64 := alloc(36 * 8);
    var s: int64 := 0;
    while (s < 36) { poke64(probs + s * 8, zsLLProb(s)); s := s + 1; }
    var tab: int64 := zsFSEBuild(probs, 36, 6);
    free(probs, 36 * 8);
    return tab;
}

fn zsMLPredefined(): int64 {
    var probs: int64 := alloc(53 * 8);
    var s: int64 := 0;
    while (s < 53) { poke64(probs + s * 8, zsMLProb(s)); s := s + 1; }
    var tab: int64 := zsFSEBuild(probs, 53, 6);
    free(probs, 53 * 8);
    return tab;
}

fn zsOFFPredefined(): int64 {
    var probs: int64 := alloc(29 * 8);
    var s: int64 := 0;
    while (s < 29) { poke64(probs + s * 8, zsOFFProb(s)); s := s + 1; }
    var tab: int64 := zsFSEBuild(probs, 29, 5);
    free(probs, 29 * 8);
    return tab;
}

