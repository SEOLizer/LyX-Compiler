// ─────────────────────────────────────────────────────────────────────────────
// PAYMUL / CREMUL / DEBMUL — multi-payment messages
// ─────────────────────────────────────────────────────────────────────────────

pub fn EdiPaymulWrite(hdr: int64, items: int64, itemCount: int64, out: int64, outMax: int64): int64 {
    if (peek64(hdr + EDI_PAY_HDR_BGMQUAL) == 0) { poke64(hdr + EDI_PAY_HDR_BGMQUAL, EDI_PAY_BGM_PAYMUL); }
    var pos: int64 := payWriteHead(hdr, out, outMax);

    var i: int64 := 0;
    while (i < itemCount) {
        var item:    int64 := items + i * EDI_PAYMUL_ITEM_SIZE;
        var iamt:    int64 := peek64(item + EDI_PAYMUL_ITEM_AMOUNT);
        var iref:    int64 := peek64(item + EDI_PAYMUL_ITEM_REF);
        var irefLen: int64 := peek64(item + EDI_PAYMUL_ITEM_REFLEN);
        var idb:     int64 := peek64(item + EDI_PAYMUL_ITEM_DEBTIBAN);
        var idbLen:  int64 := peek64(item + EDI_PAYMUL_ITEM_DEBTILEN);
        var icr:     int64 := peek64(item + EDI_PAYMUL_ITEM_CREDIBAN);
        var icrLen:  int64 := peek64(item + EDI_PAYMUL_ITEM_CREDILEN);

        pos := payPutStr(out, pos, outMax, "LIN"c as int64, 3);
        pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := payPutInt(out, pos, outMax, i + 1);
        pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);

        pos := payWriteRff(out, pos, outMax, "CN"c as int64, iref, irefLen);

        if (idb != 0 && idbLen > 0) {
            pos := payPutStr(out, pos, outMax, "FII"c as int64, 3);
            pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
            pos := payPutStr(out, pos, outMax, "DB"c as int64, 2);
            pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
            pos := payPutStr(out, pos, outMax, idb, idbLen);
            pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
            pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
            pos := payPutStr(out, pos, outMax, "25"c as int64, 2);
            pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);
        }

        if (icr != 0 && icrLen > 0) {
            pos := payPutStr(out, pos, outMax, "FII"c as int64, 3);
            pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
            pos := payPutStr(out, pos, outMax, "OR"c as int64, 2);
            pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
            pos := payPutStr(out, pos, outMax, icr, icrLen);
            pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
            pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
            pos := payPutStr(out, pos, outMax, "25"c as int64, 2);
            pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);
        }

        pos := payWriteMoa(out, pos, outMax, 203, iamt);
        i += 1;
    }

    pos := payWriteCnt(out, pos, outMax, itemCount);
    return pos;
}

pub fn EdiPaymulRead(buf: int64, bufLen: int64, hdr: int64, items: int64, maxItems: int64): int64 {
    var una: int64 := alloc(EDI_UNA_SIZE);
    EdiUnaRead(buf, bufLen, una);
    var startPos: int64 := 0;
    if (peek8(buf) == 85 && peek8(buf+1) == 78 && peek8(buf+2) == 65) { startPos := 9; }
    var sctx: int64 := alloc(EDI_SEGCTX_SIZE);
    EdiSegCtxInit(sctx, una, startPos);
    var seg:     int64 := alloc(EDI_SEG_SIZE);
    var elems:   int64 := alloc(8 * EDI_ELEM_SIZE);
    var count:   int64 := 0;
    var curItem: int64 := 0;
    var done:    int64 := 0;

    while (done == 0) {
        var r: int64 := EdiSegmentNext(buf, bufLen, sctx, seg);
        if (r == 0) { done := 1; }
        else {
            var n: int64 := EdiElementSplit(seg, elems, 8);

            if (payTagIs(seg, 66, 71, 77) == 1) {
                if (n > 0) { poke64(hdr + EDI_PAY_HDR_BGMQUAL, payParseInt(payElemPtr(elems,0), payElemLen(elems,0))); }
                if (n > 1) {
                    poke64(hdr + EDI_PAY_HDR_REF,    payElemPtr(elems,1));
                    poke64(hdr + EDI_PAY_HDR_REFLEN, payElemLen(elems,1));
                }
            }

            if (payTagIs(seg, 67, 85, 88) == 1) {
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(payElemPtr(elems,0), payElemLen(elems,0), comps, 4);
                    if (nc > 1) {
                        poke64(hdr + EDI_PAY_HDR_CURRENCY, peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                        poke64(hdr + EDI_PAY_HDR_CURLEN,   peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // LIN → new item
            if (payTagIs(seg, 76, 73, 78) == 1) {
                if (count < maxItems) {
                    curItem := items + count * EDI_PAYMUL_ITEM_SIZE;
                    var zi: int64 := 0;
                    while (zi < EDI_PAYMUL_ITEM_SIZE) { poke8(curItem + zi, 0); zi := zi + 1; }
                    count += 1;
                }
            }

            // MOA+9 (header) or MOA+203 (item)
            if (payTagIs(seg, 77, 79, 65) == 1) {
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(payElemPtr(elems,0), payElemLen(elems,0), comps, 4);
                    if (nc > 1) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        var vp: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var vl: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        var amt: int64 := payParseRevenue(vp, vl);
                        if (ql == 1 && peek8(qp) == 57) {
                            poke64(hdr + EDI_PAY_HDR_AMOUNT, amt);
                        }
                        // "203" = 50,48,51
                        if (curItem != 0 && ql == 3 && peek8(qp) == 50 && peek8(qp+1) == 48 && peek8(qp+2) == 51) {
                            poke64(curItem + EDI_PAYMUL_ITEM_AMOUNT, amt);
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // RFF+CN → item ref
            if (payTagIs(seg, 82, 70, 70) == 1 && curItem != 0) {
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(payElemPtr(elems,0), payElemLen(elems,0), comps, 4);
                    if (nc > 1) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        // "CN" = 67,78
                        if (ql == 2 && peek8(qp) == 67 && peek8(qp+1) == 78) {
                            poke64(curItem + EDI_PAYMUL_ITEM_REF,    peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                            poke64(curItem + EDI_PAYMUL_ITEM_REFLEN, peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // FII in item context (DB/OR)
            if (payTagIs(seg, 70, 73, 73) == 1 && curItem != 0) {
                if (n > 1) {
                    var qp: int64 := payElemPtr(elems, 0);
                    var ql: int64 := payElemLen(elems, 0);
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(payElemPtr(elems,1), payElemLen(elems,1), comps, 4);
                    if (nc > 0) {
                        // DB (68,66) → debtor
                        if (ql >= 2 && peek8(qp) == 68 && peek8(qp+1) == 66) {
                            poke64(curItem + EDI_PAYMUL_ITEM_DEBTIBAN, peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                            poke64(curItem + EDI_PAYMUL_ITEM_DEBTILEN, peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                        }
                        // OR (79,82) → creditor
                        if (ql >= 2 && peek8(qp) == 79 && peek8(qp+1) == 82) {
                            poke64(curItem + EDI_PAYMUL_ITEM_CREDIBAN, peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                            poke64(curItem + EDI_PAYMUL_ITEM_CREDILEN, peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }
        }
    }

    free(elems, 8 * EDI_ELEM_SIZE);
    free(seg, EDI_SEG_SIZE);
    free(sctx, EDI_SEGCTX_SIZE);
    free(una, EDI_UNA_SIZE);
    return count;
}

