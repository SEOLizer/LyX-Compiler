// ─────────────────────────────────────────────────────────────────────────────
// DOCAPP / DOCINF — documentary credit
//   Wire: BGM+qual+creditNum+9' / DTM+36:validUntil:102' / NAD+BF+beneficiary::9' /
//         FII+IS+bankBic::25' / CUX+2:currency:4' / MOA+9:amount' /
//         DOC+code:copies' (per doc) / CNT+2:docCount'
// ─────────────────────────────────────────────────────────────────────────────

fn docWriteMsg(bgmQual: int64, hdr: int64, docs: int64, docCount: int64, out: int64): int64 {
    var outMax:  int64 := 8192;
    var numPtr:  int64 := peek64(hdr + EDI_DOCAPP_HDR_CREDITNUM);
    var numLen:  int64 := peek64(hdr + EDI_DOCAPP_HDR_CREDITNUMLEN);
    var benPtr:  int64 := peek64(hdr + EDI_DOCAPP_HDR_BENEFICIARY);
    var benLen:  int64 := peek64(hdr + EDI_DOCAPP_HDR_BENEFLEN);
    var bicPtr:  int64 := peek64(hdr + EDI_DOCAPP_HDR_BANKBIC);
    var bicLen:  int64 := peek64(hdr + EDI_DOCAPP_HDR_BANKBICLEN);
    var amount:  int64 := peek64(hdr + EDI_DOCAPP_HDR_AMOUNT);
    var curPtr:  int64 := peek64(hdr + EDI_DOCAPP_HDR_CURRENCY);
    var curLen:  int64 := peek64(hdr + EDI_DOCAPP_HDR_CURLEN);
    var valPtr:  int64 := peek64(hdr + EDI_DOCAPP_HDR_VALIDUNTIL);
    var pos:     int64 := 0;

    pos := payPutStr(out, pos, outMax, "BGM"c as int64, 3);
    pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := payPutInt(out, pos, outMax, bgmQual);
    pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
    if (numPtr != 0 && numLen > 0) { pos := payPutStr(out, pos, outMax, numPtr, numLen); }
    pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := payPutChar(out, pos, outMax, 57);
    pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);

    if (valPtr != 0) {
        pos := payPutStr(out, pos, outMax, "DTM"c as int64, 3);
        pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := payPutStr(out, pos, outMax, "36"c as int64, 2);
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutStr(out, pos, outMax, valPtr, 8);
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutStr(out, pos, outMax, "102"c as int64, 3);
        pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);
    }

    if (benPtr != 0 && benLen > 0) {
        pos := payPutStr(out, pos, outMax, "NAD"c as int64, 3);
        pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := payPutStr(out, pos, outMax, "BF"c as int64, 2);
        pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := payPutStr(out, pos, outMax, benPtr, benLen);
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutChar(out, pos, outMax, 57);
        pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);
    }

    if (bicPtr != 0 && bicLen > 0) {
        pos := payPutStr(out, pos, outMax, "FII"c as int64, 3);
        pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := payPutStr(out, pos, outMax, "IS"c as int64, 2);
        pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := payPutStr(out, pos, outMax, bicPtr, bicLen);
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutStr(out, pos, outMax, "25"c as int64, 2);
        pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);
    }

    if (curPtr != 0 && curLen > 0) {
        pos := payPutStr(out, pos, outMax, "CUX"c as int64, 3);
        pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := payPutChar(out, pos, outMax, 50);
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutStr(out, pos, outMax, curPtr, curLen);
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutChar(out, pos, outMax, 52);
        pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);
    }

    pos := payWriteMoa(out, pos, outMax, 9, amount);

    var di: int64 := 0;
    while (di < docCount) {
        var doc:     int64 := docs + di * EDI_DOCAPP_DOC_SIZE;
        var codePtr: int64 := peek64(doc + EDI_DOCAPP_DOC_CODE);
        var codeLen: int64 := peek64(doc + EDI_DOCAPP_DOC_CODELEN);
        var copies:  int64 := peek64(doc + EDI_DOCAPP_DOC_COPIES);
        pos := payPutStr(out, pos, outMax, "DOC"c as int64, 3);
        pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
        if (codePtr != 0 && codeLen > 0) { pos := payPutStr(out, pos, outMax, codePtr, codeLen); }
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutInt(out, pos, outMax, copies);
        pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);
        di += 1;
    }

    pos := payWriteCnt(out, pos, outMax, docCount);
    return pos;
}

pub fn EdiDocappWrite(hdr: int64, docs: int64, docCount: int64, out: int64, outMax: int64): int64 {
    return docWriteMsg(EDI_PAY_BGM_DOCAPP, hdr, docs, docCount, out);
}

fn docReadMsg(buf: int64, bufLen: int64, hdr: int64, docs: int64, maxDocs: int64): int64 {
    var una: int64 := alloc(EDI_UNA_SIZE);
    EdiUnaRead(buf, bufLen, una);
    var startPos: int64 := 0;
    if (peek8(buf) == 85 && peek8(buf+1) == 78 && peek8(buf+2) == 65) { startPos := 9; }
    var sctx: int64 := alloc(EDI_SEGCTX_SIZE);
    EdiSegCtxInit(sctx, una, startPos);
    var seg:   int64 := alloc(EDI_SEG_SIZE);
    var elems: int64 := alloc(8 * EDI_ELEM_SIZE);
    var count: int64 := 0;
    var done:  int64 := 0;

    while (done == 0) {
        var r: int64 := EdiSegmentNext(buf, bufLen, sctx, seg);
        if (r == 0) { done := 1; }
        else {
            var n: int64 := EdiElementSplit(seg, elems, 8);

            if (payTagIs(seg, 66, 71, 77) == 1) {
                if (n > 1) {
                    poke64(hdr + EDI_DOCAPP_HDR_CREDITNUM,    payElemPtr(elems,1));
                    poke64(hdr + EDI_DOCAPP_HDR_CREDITNUMLEN, payElemLen(elems,1));
                }
            }

            // DTM+36 → validUntil
            if (payTagIs(seg, 68, 84, 77) == 1) {
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(payElemPtr(elems,0), payElemLen(elems,0), comps, 4);
                    if (nc > 1) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        // "36" = 51,54
                        if (ql == 2 && peek8(qp) == 51 && peek8(qp+1) == 54) {
                            poke64(hdr + EDI_DOCAPP_HDR_VALIDUNTIL,    peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                            poke64(hdr + EDI_DOCAPP_HDR_VALIDUNTILLEN, peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // NAD+BF → beneficiary
            if (payTagIs(seg, 78, 65, 68) == 1) {
                if (n > 1) {
                    var qp: int64 := payElemPtr(elems, 0);
                    var ql: int64 := payElemLen(elems, 0);
                    // "BF" = 66,70
                    if (ql >= 2 && peek8(qp) == 66 && peek8(qp+1) == 70) {
                        var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                        EdiComponentSplit(payElemPtr(elems,1), payElemLen(elems,1), comps, 4);
                        poke64(hdr + EDI_DOCAPP_HDR_BENEFICIARY, peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                        poke64(hdr + EDI_DOCAPP_HDR_BENEFLEN,    peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                        free(comps, 4 * EDI_ELEM_SIZE);
                    }
                }
            }

            // FII+IS → bank BIC
            if (payTagIs(seg, 70, 73, 73) == 1) {
                if (n > 1) {
                    var qp: int64 := payElemPtr(elems, 0);
                    var ql: int64 := payElemLen(elems, 0);
                    // "IS" = 73,83
                    if (ql >= 2 && peek8(qp) == 73 && peek8(qp+1) == 83) {
                        var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                        EdiComponentSplit(payElemPtr(elems,1), payElemLen(elems,1), comps, 4);
                        poke64(hdr + EDI_DOCAPP_HDR_BANKBIC,    peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                        poke64(hdr + EDI_DOCAPP_HDR_BANKBICLEN, peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                        free(comps, 4 * EDI_ELEM_SIZE);
                    }
                }
            }

            // CUX → currency
            if (payTagIs(seg, 67, 85, 88) == 1) {
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(payElemPtr(elems,0), payElemLen(elems,0), comps, 4);
                    if (nc > 1) {
                        poke64(hdr + EDI_DOCAPP_HDR_CURRENCY, peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                        poke64(hdr + EDI_DOCAPP_HDR_CURLEN,   peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // MOA+9 → amount
            if (payTagIs(seg, 77, 79, 65) == 1) {
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(payElemPtr(elems,0), payElemLen(elems,0), comps, 4);
                    if (nc > 1) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        if (ql == 1 && peek8(qp) == 57) {
                            poke64(hdr + EDI_DOCAPP_HDR_AMOUNT, payParseRevenue(peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR), peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN)));
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // DOC+code:copies'
            if (payTagIs(seg, 68, 79, 67) == 1) {
                if (count < maxDocs && n > 0) {
                    var doc: int64 := docs + count * EDI_DOCAPP_DOC_SIZE;
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(payElemPtr(elems,0), payElemLen(elems,0), comps, 4);
                    if (nc > 0) {
                        poke64(doc + EDI_DOCAPP_DOC_CODE,    peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                        poke64(doc + EDI_DOCAPP_DOC_CODELEN, peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                    }
                    if (nc > 1) {
                        poke64(doc + EDI_DOCAPP_DOC_COPIES, payParseInt(peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR), peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN)));
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                    count += 1;
                }
            }
        }
    }

    free(elems, 8 * EDI_ELEM_SIZE);
    free(seg, EDI_SEG_SIZE);
    free(sctx, EDI_SEGCTX_SIZE);
    free(una, EDI_UNA_SIZE);
    return count;
}

pub fn EdiDocappRead(buf: int64, bufLen: int64, hdr: int64, docs: int64, maxDocs: int64): int64 {
    return docReadMsg(buf, bufLen, hdr, docs, maxDocs);
}

pub fn EdiDocinfrWrite(hdr: int64, docs: int64, docCount: int64, out: int64, outMax: int64): int64 {
    return docWriteMsg(EDI_PAY_BGM_DOCINF, hdr, docs, docCount, out);
}

pub fn EdiDocinfrRead(buf: int64, bufLen: int64, hdr: int64, docs: int64, maxDocs: int64): int64 {
    return docReadMsg(buf, bufLen, hdr, docs, maxDocs);
}
