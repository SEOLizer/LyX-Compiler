// ─────────────────────────────────────────────────────────────────────────────
// Private helpers
// ─────────────────────────────────────────────────────────────────────────────

fn payPutChar(out: int64, pos: int64, outMax: int64, ch: int64): int64 {
    if (pos < 0) { return 0 - 1; }
    if (pos >= outMax) { return 0 - 1; }
    poke8(out + pos, ch);
    return pos + 1;
}

fn payPutStr(out: int64, pos: int64, outMax: int64, src: int64, n: int64): int64 {
    if (pos < 0) { return 0 - 1; }
    var i: int64 := 0;
    while (i < n) {
        if (pos + i >= outMax) { return 0 - 1; }
        poke8(out + pos + i, peek8(src + i));
        i += 1;
    }
    return pos + n;
}

fn payPutInt(out: int64, pos: int64, outMax: int64, val: int64): int64 {
    if (pos < 0) { return 0 - 1; }
    if (val == 0) { return payPutChar(out, pos, outMax, 48); }
    var tmp: int64 := val;
    var digits: int64 := 0;
    while (tmp > 0) { tmp := tmp / 10; digits := digits + 1; }
    var tbuf: int64 := alloc(24);
    tmp := val;
    var idx: int64 := 1;
    while (idx <= digits) {
        var d: int64 := tmp - (tmp / 10) * 10;
        poke8(tbuf + digits - idx, 48 + d);
        tmp := tmp / 10;
        idx += 1;
    }
    var r: int64 := payPutStr(out, pos, outMax, tbuf, digits);
    free(tbuf, 24);
    return r;
}

fn payPutRevenue(out: int64, pos: int64, outMax: int64, val: int64): int64 {
    var euros: int64 := val / 100;
    var cents: int64 := val - euros * 100;
    pos := payPutInt(out, pos, outMax, euros);
    pos := payPutChar(out, pos, outMax, 46);
    if (cents < 10) { pos := payPutChar(out, pos, outMax, 48); }
    pos := payPutInt(out, pos, outMax, cents);
    return pos;
}

fn payParseInt(ptr: int64, len: int64): int64 {
    var v: int64 := 0;
    var i: int64 := 0;
    while (i < len) {
        var c: int64 := peek8(ptr + i);
        if (c >= 48 && c <= 57) { v := v * 10 + (c - 48); }
        i += 1;
    }
    return v;
}

fn payParseRevenue(ptr: int64, len: int64): int64 {
    var v: int64 := 0;
    var afterDot: int64 := 0;
    var decimals: int64 := 0;
    var i: int64 := 0;
    while (i < len) {
        var c: int64 := peek8(ptr + i);
        if (c == 46 || c == 44) { afterDot := 1; }
        else {
            if (c >= 48 && c <= 57) {
                v := v * 10 + (c - 48);
                if (afterDot == 1) { decimals := decimals + 1; }
            }
        }
        i += 1;
    }
    if (afterDot == 0) { v := v * 100; }
    if (decimals == 1) { v := v * 10; }
    return v;
}

fn payTagIs(seg: int64, t0: int64, t1: int64, t2: int64): int64 {
    var p: int64 := peek64(seg + EDI_SEG_PTR);
    if (p == 0) { return 0; }
    if (peek8(p) != t0) { return 0; }
    if (peek8(p+1) != t1) { return 0; }
    if (peek8(p+2) != t2) { return 0; }
    return 1;
}

fn payElemPtr(elems: int64, idx: int64): int64 {
    return peek64(elems + idx * EDI_ELEM_SIZE + EDI_ELEM_PTR);
}
fn payElemLen(elems: int64, idx: int64): int64 {
    return peek64(elems + idx * EDI_ELEM_SIZE + EDI_ELEM_LEN);
}

fn payWriteMoa(out: int64, pos: int64, outMax: int64, qualifier: int64, amount: int64): int64 {
    pos := payPutStr(out, pos, outMax, "MOA"c as int64, 3);
    pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := payPutInt(out, pos, outMax, qualifier);
    pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
    pos := payPutRevenue(out, pos, outMax, amount);
    pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);
    return pos;
}

fn payWriteRff(out: int64, pos: int64, outMax: int64, qual2: int64, refPtr: int64, refLen: int64): int64 {
    if (refPtr == 0 || refLen == 0) { return pos; }
    pos := payPutStr(out, pos, outMax, "RFF"c as int64, 3);
    pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := payPutStr(out, pos, outMax, qual2, 2);
    pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
    pos := payPutStr(out, pos, outMax, refPtr, refLen);
    pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);
    return pos;
}

fn payWriteCnt(out: int64, pos: int64, outMax: int64, n: int64): int64 {
    pos := payPutStr(out, pos, outMax, "CNT"c as int64, 3);
    pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := payPutChar(out, pos, outMax, 50);
    pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
    pos := payPutInt(out, pos, outMax, n);
    pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);
    return pos;
}

// Write BGM+DTM+FII(CR)+FII(DB)+CUX+MOA; returns pos after MOA
fn payWriteHead(hdr: int64, out: int64, outMax: int64): int64 {
    var bgmQual: int64 := peek64(hdr + EDI_PAY_HDR_BGMQUAL);
    var refPtr:  int64 := peek64(hdr + EDI_PAY_HDR_REF);
    var refLen:  int64 := peek64(hdr + EDI_PAY_HDR_REFLEN);
    var datePtr: int64 := peek64(hdr + EDI_PAY_HDR_DATE);
    var crPtr:   int64 := peek64(hdr + EDI_PAY_HDR_CREDIBAN);
    var crLen:   int64 := peek64(hdr + EDI_PAY_HDR_CREDILEN);
    var dbPtr:   int64 := peek64(hdr + EDI_PAY_HDR_DEBTIBAN);
    var dbLen:   int64 := peek64(hdr + EDI_PAY_HDR_DEBTILEN);
    var bicPtr:  int64 := peek64(hdr + EDI_PAY_HDR_BIC);
    var bicLen:  int64 := peek64(hdr + EDI_PAY_HDR_BICLEN);
    var curPtr:  int64 := peek64(hdr + EDI_PAY_HDR_CURRENCY);
    var curLen:  int64 := peek64(hdr + EDI_PAY_HDR_CURLEN);
    var amount:  int64 := peek64(hdr + EDI_PAY_HDR_AMOUNT);
    var pos:     int64 := 0;

    pos := payPutStr(out, pos, outMax, "BGM"c as int64, 3);
    pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := payPutInt(out, pos, outMax, bgmQual);
    pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
    if (refPtr != 0 && refLen > 0) { pos := payPutStr(out, pos, outMax, refPtr, refLen); }
    pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := payPutChar(out, pos, outMax, 57);
    pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);

    if (datePtr != 0) {
        pos := payPutStr(out, pos, outMax, "DTM"c as int64, 3);
        pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := payPutStr(out, pos, outMax, "137"c as int64, 3);
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutStr(out, pos, outMax, datePtr, 8);
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutStr(out, pos, outMax, "102"c as int64, 3);
        pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);
    }

    // FII+CR+iban:bic:25'
    if (crPtr != 0 && crLen > 0) {
        pos := payPutStr(out, pos, outMax, "FII"c as int64, 3);
        pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := payPutStr(out, pos, outMax, "CR"c as int64, 2);
        pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := payPutStr(out, pos, outMax, crPtr, crLen);
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        if (bicPtr != 0 && bicLen > 0) { pos := payPutStr(out, pos, outMax, bicPtr, bicLen); }
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutStr(out, pos, outMax, "25"c as int64, 2);
        pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);
    }

    // FII+DB+iban::25'
    if (dbPtr != 0 && dbLen > 0) {
        pos := payPutStr(out, pos, outMax, "FII"c as int64, 3);
        pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := payPutStr(out, pos, outMax, "DB"c as int64, 2);
        pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := payPutStr(out, pos, outMax, dbPtr, dbLen);
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutStr(out, pos, outMax, "25"c as int64, 2);
        pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);
    }

    if (curPtr != 0 && curLen > 0) {
        pos := payPutStr(out, pos, outMax, "CUX"c as int64, 3);
        pos := payPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := payPutChar(out, pos, outMax, 50);
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutStr(out, pos, outMax, curPtr, curLen);
        pos := payPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := payPutChar(out, pos, outMax, 52);
        pos := payPutChar(out, pos, outMax, EDI_DEF_SEG);
    }

    pos := payWriteMoa(out, pos, outMax, 9, amount);
    return pos;
}

// Parse all standard payment fields into EDI_PAY_HDR
fn payReadMsg(buf: int64, bufLen: int64, hdr: int64): int64 {
    var una: int64 := alloc(EDI_UNA_SIZE);
    EdiUnaRead(buf, bufLen, una);
    var startPos: int64 := 0;
    if (peek8(buf) == 85 && peek8(buf+1) == 78 && peek8(buf+2) == 65) { startPos := 9; }
    var sctx: int64 := alloc(EDI_SEGCTX_SIZE);
    EdiSegCtxInit(sctx, una, startPos);
    var seg:   int64 := alloc(EDI_SEG_SIZE);
    var elems: int64 := alloc(8 * EDI_ELEM_SIZE);
    var done:  int64 := 0;

    while (done == 0) {
        var r: int64 := EdiSegmentNext(buf, bufLen, sctx, seg);
        if (r == 0) { done := 1; }
        else {
            var n: int64 := EdiElementSplit(seg, elems, 8);

            // BGM → bgmQual, ref
            if (payTagIs(seg, 66, 71, 77) == 1) {
                if (n > 0) { poke64(hdr + EDI_PAY_HDR_BGMQUAL, payParseInt(payElemPtr(elems,0), payElemLen(elems,0))); }
                if (n > 1) {
                    poke64(hdr + EDI_PAY_HDR_REF,    payElemPtr(elems,1));
                    poke64(hdr + EDI_PAY_HDR_REFLEN, payElemLen(elems,1));
                }
            }

            // DTM+137 → date
            if (payTagIs(seg, 68, 84, 77) == 1) {
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(payElemPtr(elems,0), payElemLen(elems,0), comps, 4);
                    if (nc > 1) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        if (ql == 3 && peek8(qp) == 49 && peek8(qp+1) == 51 && peek8(qp+2) == 55) {
                            poke64(hdr + EDI_PAY_HDR_DATE,    peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                            poke64(hdr + EDI_PAY_HDR_DATELEN, peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // FII → IBAN and BIC
            if (payTagIs(seg, 70, 73, 73) == 1) {
                if (n > 1) {
                    var qp: int64 := payElemPtr(elems, 0);
                    var ql: int64 := payElemLen(elems, 0);
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(payElemPtr(elems,1), payElemLen(elems,1), comps, 4);
                    // CR (67,82) → creditor
                    if (ql >= 2 && peek8(qp) == 67 && peek8(qp+1) == 82) {
                        if (nc > 0) {
                            poke64(hdr + EDI_PAY_HDR_CREDIBAN, peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                            poke64(hdr + EDI_PAY_HDR_CREDILEN, peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                        }
                        if (nc > 1) {
                            var bl: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                            if (bl > 0) {
                                poke64(hdr + EDI_PAY_HDR_BIC,    peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                                poke64(hdr + EDI_PAY_HDR_BICLEN, bl);
                            }
                        }
                    }
                    // DB (68,66) → debtor
                    if (ql >= 2 && peek8(qp) == 68 && peek8(qp+1) == 66) {
                        if (nc > 0) {
                            poke64(hdr + EDI_PAY_HDR_DEBTIBAN, peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                            poke64(hdr + EDI_PAY_HDR_DEBTILEN, peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // CUX → currency
            if (payTagIs(seg, 67, 85, 88) == 1) {
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(payElemPtr(elems,0), payElemLen(elems,0), comps, 4);
                    if (nc > 1) {
                        poke64(hdr + EDI_PAY_HDR_CURRENCY, peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                        poke64(hdr + EDI_PAY_HDR_CURLEN,   peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // MOA+9 → total amount
            if (payTagIs(seg, 77, 79, 65) == 1) {
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(payElemPtr(elems,0), payElemLen(elems,0), comps, 4);
                    if (nc > 1) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        var vp: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var vl: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        if (ql == 1 && peek8(qp) == 57) {
                            poke64(hdr + EDI_PAY_HDR_AMOUNT, payParseRevenue(vp, vl));
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // RFF → invoice/mandate/txn ref
            if (payTagIs(seg, 82, 70, 70) == 1) {
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(payElemPtr(elems,0), payElemLen(elems,0), comps, 4);
                    if (nc > 1) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        var vp: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var vl: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        // "IV" = 73,86
                        if (ql == 2 && peek8(qp) == 73 && peek8(qp+1) == 86) {
                            poke64(hdr + EDI_PAY_HDR_INVOICEREF,  vp);
                            poke64(hdr + EDI_PAY_HDR_INVOICELEN, vl);
                        }
                        // "MR" = 77,82
                        if (ql == 2 && peek8(qp) == 77 && peek8(qp+1) == 82) {
                            poke64(hdr + EDI_PAY_HDR_MANDATEREF, vp);
                            poke64(hdr + EDI_PAY_HDR_MANDATELEN, vl);
                        }
                        // "TN" = 84,78
                        if (ql == 2 && peek8(qp) == 84 && peek8(qp+1) == 78) {
                            poke64(hdr + EDI_PAY_HDR_TXNREF,    vp);
                            poke64(hdr + EDI_PAY_HDR_TXNREFLEN, vl);
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }
        }
    }

    free(elems, 8 * EDI_ELEM_SIZE);
    free(seg, EDI_SEG_SIZE);
    free(sctx, EDI_SEGCTX_SIZE);
    free(una, EDI_UNA_SIZE);
    return 1;
}

// ─────────────────────────────────────────────────────────────────────────────
// Public API — Validation
// ─────────────────────────────────────────────────────────────────────────────

// IBAN checksum (MOD 97): move first 4 chars to end, replace letters with
// two-digit numbers (A=10..Z=35), compute mod 97 of the result → must be 1.
pub fn EdiIbanCheck(ptr: pchar, len: int64): int64 {
  var ptrAdr: int64 := ptr as int64;   // #1613
    if (len < 4) { return 0; }
    var mod: int64 := 0;
    var i: int64 := 0;
    while (i < len) {
        var idx: int64 := i + 4;
        if (idx >= len) { idx := idx - len; }
        var c: int64 := peek8(ptrAdr + idx);
        if (c >= 48 && c <= 57) {
            mod := (mod * 10 + c - 48) % 97;
        } else {
            var val: int64 := c - 65 + 10;
            mod := (mod * 10 + val / 10) % 97;
            mod := (mod * 10 + val - (val / 10) * 10) % 97;
        }
        i += 1;
    }
    if (mod == 1) { return 1; }
    return 0;
}

// BIC format: 8 or 11 chars; first 4 = bank code (A-Z); chars 5-6 = country (A-Z).
pub fn EdiBicCheck(ptr: pchar, len: int64): int64 {
  var ptrAdr: int64 := ptr as int64;   // #1613
    if (len != 8 && len != 11) { return 0; }
    var i: int64 := 0;
    while (i < 4) {
        var c: int64 := peek8(ptrAdr + i);
        if (c < 65 || c > 90) { return 0; }
        i += 1;
    }
    if (peek8(ptrAdr+4) < 65 || peek8(ptrAdr+4) > 90) { return 0; }
    if (peek8(ptrAdr+5) < 65 || peek8(ptrAdr+5) > 90) { return 0; }
    return 1;
}

// REMADV without invoice ref → 1 (warn). With ref → 0 (ok).
pub fn EdiRemadvCheck(hdr: int64): int64 {
    if (peek64(hdr + EDI_PAY_HDR_INVOICELEN) == 0) { return 1; }
    return 0;
}

// DIRDEB without mandate ref → 2 (err).
pub fn EdiDirdebCheck(hdr: int64): int64 {
    if (peek64(hdr + EDI_PAY_HDR_MANDATELEN) == 0) { return 2; }
    return 0;
}

// FINCAN without TN transaction ref → 2 (err).
pub fn EdiFincanCheck(hdr: int64): int64 {
    if (peek64(hdr + EDI_PAY_HDR_TXNREFLEN) == 0) { return 2; }
    return 0;
}

// PAYMUL sum validation: Σ item amounts vs header total. Deviation >1 → 2.
pub fn EdiPaymulValidate(hdr: int64, items: int64, itemCount: int64): int64 {
    var total: int64 := peek64(hdr + EDI_PAY_HDR_AMOUNT);
    var sum:   int64 := 0;
    var i:     int64 := 0;
    while (i < itemCount) {
        var item: int64 := items + i * EDI_PAYMUL_ITEM_SIZE;
        sum := sum + peek64(item + EDI_PAYMUL_ITEM_AMOUNT);
        i += 1;
    }
    var diff: int64 := sum - total;
    if (diff < 0) { diff := 0 - diff; }
    if (diff > 1) { return 2; }
    return 0;
}

