// std/edi/payment.lyx — Payment & Banking: REMADV + PAYMUL + PAYORD + PAYEXT +
//   DEBADV + CREEXT + CREMUL + DEBMUL + BANSTA + DIRDEB + FINCAN + DOCAPP + DOCINF
//   (WP-EDI-09)
//
// IBAN validation (MOD 97), BIC format check (8/11 chars).
// REMADV: must carry RFF+IV (invoice ref); missing → EdiRemadvCheck returns 1 (warn).
// DIRDEB: mandatory mandate ref (RFF+MR); missing → EdiDirdebCheck returns 2 (err).
// FINCAN: mandatory transaction ref (RFF+TN); missing → EdiFincanCheck returns 2 (err).
// PAYMUL: Σ item amounts must equal header total; deviation >1 → EdiPaymulValidate returns 2.
// DOCAPP/DOCINF: documentary credit with DOC-segment list.

unit std.edi.payment;

import std.edi.core;
import std.alloc;

