// ─────────────────────────────────────────────────────────────────────────────
// IFTDGN — dangerous goods notification
//   Wire: BGM+350+ref+9' / DTM / DGS+ADR+unNum+imdgClass+packingGroup+emsCode' / CNT
// ─────────────────────────────────────────────────────────────────────────────

pub fn EdiIftdgnWrite(hdr: int64, goods: int64, goodCount: int64, out: int64, outMax: int64): int64 {
    poke64(hdr + EDI_TRN_HDR_BGMQUAL, EDI_TRN_BGM_IFTDGN);
    var pos: int64 := trnWriteHead(hdr, out, outMax);

    var i: int64 := 0;
    while (i < goodCount) {
        var dg:      int64 := goods + i * EDI_DGD_SIZE;
        var unPtr:   int64 := peek64(dg + EDI_DGD_UNNUMBER);
        var unLen:   int64 := peek64(dg + EDI_DGD_UNLEN);
        var imdgPtr: int64 := peek64(dg + EDI_DGD_IMDGCLASS);
        var imdgLen: int64 := peek64(dg + EDI_DGD_IMDGLEN);
        var pg:      int64 := peek64(dg + EDI_DGD_PACKINGGROUP);
        var emsPtr:  int64 := peek64(dg + EDI_DGD_EMSCODE);
        var emsLen:  int64 := peek64(dg + EDI_DGD_EMSLEN);

        pos := trnPutStr(out, pos, outMax, "DGS"c as int64, 3);
        pos := trnPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := trnPutStr(out, pos, outMax, "ADR"c as int64, 3);
        pos := trnPutChar(out, pos, outMax, EDI_DEF_DATA);
        if (unPtr != 0 && unLen > 0) { pos := trnPutStr(out, pos, outMax, unPtr, unLen); }
        pos := trnPutChar(out, pos, outMax, EDI_DEF_DATA);
        if (imdgPtr != 0 && imdgLen > 0) { pos := trnPutStr(out, pos, outMax, imdgPtr, imdgLen); }
        pos := trnPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := trnPutInt(out, pos, outMax, pg);
        pos := trnPutChar(out, pos, outMax, EDI_DEF_DATA);
        if (emsPtr != 0 && emsLen > 0) { pos := trnPutStr(out, pos, outMax, emsPtr, emsLen); }
        pos := trnPutChar(out, pos, outMax, EDI_DEF_SEG);
        i += 1;
    }

    pos := trnWriteCnt(out, pos, outMax, goodCount);
    return pos;
}

pub fn EdiIftdgnRead(buf: int64, bufLen: int64, hdr: int64, goods: int64, maxGoods: int64): int64 {
    trnReadMsg(buf, bufLen, hdr);

    var una: int64 := alloc(EDI_UNA_SIZE);
    EdiUnaRead(buf, bufLen, una);
    var startPos: int64 := 0;
    if (peek8(buf) == 85 && peek8(buf+1) == 78 && peek8(buf+2) == 65) { startPos := 9; }
    var sctx: int64 := alloc(EDI_SEGCTX_SIZE);
    EdiSegCtxInit(sctx, una, startPos);
    var seg:   int64 := alloc(EDI_SEG_SIZE);
    var elems: int64 := alloc(8 * EDI_ELEM_SIZE);
    var count: int64 := 0;
    var done:  int64 := 0;

    while (done == 0) {
        var r: int64 := EdiSegmentNext(buf, bufLen, sctx, seg);
        if (r == 0) { done := 1; }
        else {
            var n: int64 := EdiElementSplit(seg, elems, 8);
            // DGS = 68,71,83
            if (trnTagIs(seg, 68, 71, 83) == 1 && count < maxGoods) {
                var dg: int64 := goods + count * EDI_DGD_SIZE;
                var zi: int64 := 0;
                while (zi < EDI_DGD_SIZE) { poke8(dg + zi, 0); zi := zi + 1; }
                if (n > 1) { poke64(dg + EDI_DGD_UNNUMBER, trnEP(elems,1)); poke64(dg + EDI_DGD_UNLEN, trnEL(elems,1)); }
                if (n > 2) { poke64(dg + EDI_DGD_IMDGCLASS, trnEP(elems,2)); poke64(dg + EDI_DGD_IMDGLEN, trnEL(elems,2)); }
                if (n > 3) { poke64(dg + EDI_DGD_PACKINGGROUP, trnParseInt(trnEP(elems,3), trnEL(elems,3))); }
                if (n > 4) { poke64(dg + EDI_DGD_EMSCODE, trnEP(elems,4)); poke64(dg + EDI_DGD_EMSLEN, trnEL(elems,4)); }
                count += 1;
            }
        }
    }

    free(elems, 8 * EDI_ELEM_SIZE);
    free(seg, EDI_SEG_SIZE);
    free(sctx, EDI_SEGCTX_SIZE);
    free(una, EDI_UNA_SIZE);
    return count;
}
