pub fn EdiIftmbcWrite(hdr: int64, out: int64, outMax: int64): int64 {
    poke64(hdr + EDI_TRN_HDR_BGMQUAL, EDI_TRN_BGM_IFTMBC);
    var pos: int64 := trnWriteHead(hdr, out, outMax);
    pos := trnWriteRff(out, pos, outMax, "BN"c as int64, peek64(hdr+EDI_TRN_HDR_BOOKINGREF), peek64(hdr+EDI_TRN_HDR_BOOKINGLEN));
    pos := trnWriteCnt(out, pos, outMax, 1);
    return pos;
}
pub fn EdiIftmbcRead(buf: int64, bufLen: int64, hdr: int64): int64 { return trnReadMsg(buf, bufLen, hdr); }

