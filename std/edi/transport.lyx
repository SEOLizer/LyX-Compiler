pub fn EdiIftstaWrite(hdr: int64, out: int64, outMax: int64): int64 {
    poke64(hdr + EDI_TRN_HDR_BGMQUAL, EDI_TRN_BGM_IFTSTA);
    var pos: int64 := trnWriteHead(hdr, out, outMax);
