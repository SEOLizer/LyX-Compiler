pub fn EdiComdisWrite(hdr: int64, out: int64, outMax: int64): int64 {
    var refPtr: int64 := peek64(hdr + EDI_COMDIS_HDR_DISPUTEREF);
    var refLen: int64 := peek64(hdr + EDI_COMDIS_HDR_REFLEN);
    var datePtr:int64 := peek64(hdr + EDI_COMDIS_HDR_DATE);
    var irefPtr:int64 := peek64(hdr + EDI_COMDIS_HDR_INVOICEREF);
    var irefLen:int64 := peek64(hdr + EDI_COMDIS_HDR_IREFLEN);
    var amount: int64 := peek64(hdr + EDI_COMDIS_HDR_AMOUNT);
    var rsPtr:  int64 := peek64(hdr + EDI_COMDIS_HDR_REASON);
    var rsLen:  int64 := peek64(hdr + EDI_COMDIS_HDR_REASONLEN);

    var pos: int64 := 0;
    pos := invPutStr(out, pos, outMax, "BGM"c as int64, 3);
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := invPutStr(out, pos, outMax, "34"c as int64, 2);
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    if (refPtr != 0 && refLen > 0) { pos := invPutStr(out, pos, outMax, refPtr, refLen); }
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := invPutChar(out, pos, outMax, 57);
    pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);

    if (datePtr != 0) { pos := invWriteDtm(out, pos, outMax, datePtr); }
    if (irefPtr != 0 && irefLen > 0) { pos := invWriteRff(out, pos, outMax, "IV"c as int64, irefPtr, irefLen); }
    pos := invWriteMoa(out, pos, outMax, 125, amount);

    if (rsPtr != 0 && rsLen > 0) {
        pos := invPutStr(out, pos, outMax, "FTX"c as int64, 3);
        pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := invPutStr(out, pos, outMax, "AAI"c as int64, 3);
        pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := invPutStr(out, pos, outMax, rsPtr, rsLen);
        pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);
    }

    pos := invPutStr(out, pos, outMax, "CNT"c as int64, 3);
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := invPutChar(out, pos, outMax, 50);
    pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
    pos := invPutChar(out, pos, outMax, 49);
    pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);
    return pos;
}

pub fn EdiComdisRead(buf: int64, bufLen: int64, hdr: int64): int64 {
