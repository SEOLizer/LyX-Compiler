                        poke64(hdr + EDI_COMDIS_HDR_IREFLEN,    peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }
            if (invTagIs(seg, 77, 79, 65) == 1) {   // "MOA"
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(invElemPtr(elems, 0), invElemLen(elems, 0), comps, 4);
                    if (nc > 1) {
                        poke64(hdr + EDI_COMDIS_HDR_AMOUNT, invParseRevenue(peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR), peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN)));
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }
            if (invTagIs(seg, 70, 84, 88) == 1) {   // "FTX"
                if (n > 3) {
                    poke64(hdr + EDI_COMDIS_HDR_REASON,    invElemPtr(elems, 3));
                    poke64(hdr + EDI_COMDIS_HDR_REASONLEN, invElemLen(elems, 3));
                }
            }
        }
    }

    free(elems, 8 * EDI_ELEM_SIZE);
    free(seg, EDI_SEG_SIZE);
    free(sctx, EDI_SEGCTX_SIZE);
    free(una, EDI_UNA_SIZE);
    return 1;
}

// ─────────────────────────────────────────────────────────────────────────────
// Public API — COACSU
// ─────────────────────────────────────────────────────────────────────────────

pub fn EdiCoacsuWrite(hdr: int64, out: int64, outMax: int64): int64 {
    var refPtr: int64 := peek64(hdr + EDI_COACSU_HDR_ACCOUNTREF);
    var refLen: int64 := peek64(hdr + EDI_COACSU_HDR_REFLEN);
    var datePtr:int64 := peek64(hdr + EDI_COACSU_HDR_DATE);
    var netBal: int64 := peek64(hdr + EDI_COACSU_HDR_NETBALANCE);
    var grsBal: int64 := peek64(hdr + EDI_COACSU_HDR_GROSSBALANCE);
    var curPtr: int64 := peek64(hdr + EDI_COACSU_HDR_CURRENCY);
    var curLen: int64 := peek64(hdr + EDI_COACSU_HDR_CURLEN);

    var pos: int64 := 0;
    pos := invPutStr(out, pos, outMax, "BGM"c as int64, 3);
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := invPutStr(out, pos, outMax, "36"c as int64, 2);
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    if (refPtr != 0 && refLen > 0) { pos := invPutStr(out, pos, outMax, refPtr, refLen); }
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := invPutChar(out, pos, outMax, 57);
    pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);

    if (datePtr != 0) { pos := invWriteDtm(out, pos, outMax, datePtr); }

    // CUX+2:currency:4'
    if (curPtr != 0 && curLen > 0) {
        pos := invPutStr(out, pos, outMax, "CUX"c as int64, 3);
        pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := invPutChar(out, pos, outMax, 50);
        pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := invPutStr(out, pos, outMax, curPtr, curLen);
        pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := invPutChar(out, pos, outMax, 52);
        pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);
    }

    pos := invWriteMoa(out, pos, outMax, 77, netBal);
    pos := invWriteMoa(out, pos, outMax, 9, grsBal);

    pos := invPutStr(out, pos, outMax, "CNT"c as int64, 3);
    pos := invPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := invPutChar(out, pos, outMax, 50);
    pos := invPutChar(out, pos, outMax, EDI_DEF_COMP);
    pos := invPutChar(out, pos, outMax, 49);
    pos := invPutChar(out, pos, outMax, EDI_DEF_SEG);
    return pos;
}

pub fn EdiCoacsuRead(buf: int64, bufLen: int64, hdr: int64): int64 {
    var una: int64 := alloc(EDI_UNA_SIZE);
    EdiUnaRead(buf, bufLen, una);
    var startPos: int64 := 0;
    if (peek8(buf) == 85 && peek8(buf+1) == 78 && peek8(buf+2) == 65) { startPos := 9; }
    var sctx: int64 := alloc(EDI_SEGCTX_SIZE);
    EdiSegCtxInit(sctx, una, startPos);
    var seg: int64 := alloc(EDI_SEG_SIZE);
    var elems: int64 := alloc(8 * EDI_ELEM_SIZE);
    var done: int64 := 0;

    while (done == 0) {
        var r: int64 := EdiSegmentNext(buf, bufLen, sctx, seg);
        if (r == 0) { done := 1; }
        else {
            var n: int64 := EdiElementSplit(seg, elems, 8);

            if (invTagIs(seg, 66, 71, 77) == 1) {   // "BGM"
                if (n > 1) {
                    poke64(hdr + EDI_COACSU_HDR_ACCOUNTREF, invElemPtr(elems, 1));
                    poke64(hdr + EDI_COACSU_HDR_REFLEN,     invElemLen(elems, 1));
                }
            }
            if (invTagIs(seg, 77, 79, 65) == 1) {   // "MOA"
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(invElemPtr(elems, 0), invElemLen(elems, 0), comps, 4);
                    if (nc > 1) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        var vp: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var vl: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        var amt: int64 := invParseRevenue(vp, vl);
                        // "77" = 55,55 → net balance
                        if (ql == 2 && peek8(qp) == 55 && peek8(qp+1) == 55) {
                            poke64(hdr + EDI_COACSU_HDR_NETBALANCE, amt);
                        }
                        // "9" = 57 → gross balance
                        if (ql == 1 && peek8(qp) == 57) {
                            poke64(hdr + EDI_COACSU_HDR_GROSSBALANCE, amt);
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }
        }
    }

    free(elems, 8 * EDI_ELEM_SIZE);
    free(seg, EDI_SEG_SIZE);
    free(sctx, EDI_SEGCTX_SIZE);
    free(una, EDI_UNA_SIZE);
    return 1;
}
