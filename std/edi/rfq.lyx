// std/edi/rfq.lyx — RFQ process: REQOTE + QUOTES (WP-EDI-03)
//
// REQOTE: buyer sends request for quotation with items, quantities, need-by dates
// QUOTES: supplier responds with prices, availability, delivery dates
// Linked via RFF+RFQ in QUOTES (mandatory back-reference to REQOTE number)
//
// Public API:
//   EdiReqoteWrite(rfqNum, date, lines, lineCount, out, outMax) → int64 (bytes/-1)
//   EdiReqoteRead(buf, bufLen, hdr, lines, maxLines)             → int64 (line count)
//   EdiQuotesWrite(rfqRef, quoteNum, lines, lineCount, out, outMax) → int64 (bytes/-1)
//   EdiQuotesRead(buf, bufLen, hdr, lines, maxLines)              → int64 (line count)
//
// EdiRfqLine (EDI_RFQ_LINE_SIZE bytes):
//   GTIN ptr(8)+len(8) + Qty(8) + Unit ptr(8)+len(8) + Date ptr(8)
//
// EdiQuoteLine (EDI_QUOTE_LINE_SIZE bytes):
//   GTIN ptr(8)+len(8) + Price(8) + Currency ptr(8)+len(8) + Date ptr(8) + Avail(8)
//
// Hdr structs for read output:
//   EdiRfqHdr (EDI_RFQHDR_SIZE):   Num ptr+len, Date ptr+len
//   EdiQuoteHdr (EDI_QUOTEHDR_SIZE): Num ptr+len, RfqRef ptr+len

unit std.edi.rfq;

import std.edi.core;
import std.alloc;

// ── EdiRfqLine offsets ────────────────────────────────────────────────────────
pub con EDI_RFQ_LINE_GTIN:    int64 := 0;
pub con EDI_RFQ_LINE_GTINLEN: int64 := 8;
pub con EDI_RFQ_LINE_QTY:     int64 := 16;
pub con EDI_RFQ_LINE_UNIT:    int64 := 24;
pub con EDI_RFQ_LINE_UNITLEN: int64 := 32;
pub con EDI_RFQ_LINE_DATE:    int64 := 40;   // ptr to 8-char "YYYYMMDD" string or 0
pub con EDI_RFQ_LINE_SIZE:    int64 := 48;

// ── EdiQuoteLine offsets ──────────────────────────────────────────────────────
pub con EDI_QUOTE_LINE_GTIN:        int64 := 0;
pub con EDI_QUOTE_LINE_GTINLEN:     int64 := 8;
pub con EDI_QUOTE_LINE_PRICE:       int64 := 16;   // price × 100 (fixed-point)
pub con EDI_QUOTE_LINE_CURRENCY:    int64 := 24;
pub con EDI_QUOTE_LINE_CURRENCYLEN: int64 := 32;
pub con EDI_QUOTE_LINE_DATE:        int64 := 40;   // delivery date ptr or 0
pub con EDI_QUOTE_LINE_AVAIL:       int64 := 48;   // 1=available, 0=not
pub con EDI_QUOTE_LINE_SIZE:        int64 := 56;

// ── Header result offsets ─────────────────────────────────────────────────────
pub con EDI_RFQHDR_NUM:        int64 := 0;
pub con EDI_RFQHDR_NUMLEN:     int64 := 8;
pub con EDI_RFQHDR_DATE:       int64 := 16;
pub con EDI_RFQHDR_DATELEN:    int64 := 24;
pub con EDI_RFQHDR_SIZE:       int64 := 32;

pub con EDI_QUOTEHDR_NUM:      int64 := 0;
pub con EDI_QUOTEHDR_NUMLEN:   int64 := 8;
pub con EDI_QUOTEHDR_RFQREF:   int64 := 16;
pub con EDI_QUOTEHDR_RFQREFLEN:int64 := 24;
pub con EDI_QUOTEHDR_SIZE:     int64 := 32;

// ─────────────────────────────────────────────────────────────────────────────
// Private helpers
// ─────────────────────────────────────────────────────────────────────────────

fn rfStrLen(ptr: int64): int64 {
    var n: int64 := 0;
    while (peek8(ptr + n) != 0) { n := n + 1; }
    return n;
}

fn rfPutChar(out: int64, pos: int64, outMax: int64, ch: int64): int64 {
    if (pos < 0) { return 0 - 1; }
    if (pos >= outMax) { return 0 - 1; }
    poke8(out + pos, ch);
    return pos + 1;
}

fn rfPutStr(out: int64, pos: int64, outMax: int64, src: int64, n: int64): int64 {
    if (pos < 0) { return 0 - 1; }
    var i: int64 := 0;
    while (i < n) {
        if (pos + i >= outMax) { return 0 - 1; }
        poke8(out + pos + i, peek8(src + i));
        i += 1;
    }
    return pos + n;
}

fn rfPutInt(out: int64, pos: int64, outMax: int64, val: int64): int64 {
    if (pos < 0) { return 0 - 1; }
    if (val < 0)  { return 0 - 1; }
    if (val == 0) { return rfPutChar(out, pos, outMax, 48); }
    var tmp: int64 := val;
    var digits: int64 := 0;
    while (tmp > 0) { tmp := tmp / 10; digits := digits + 1; }
    var buf: int64 := alloc(24);
    tmp := val;
    var idx: int64 := 1;
    while (idx <= digits) {
        var d: int64 := tmp - (tmp / 10) * 10;
        poke8(buf + digits - idx, 48 + d);
        tmp := tmp / 10;
        idx += 1;
    }
    var r: int64 := rfPutStr(out, pos, outMax, buf, digits);
    free(buf, 24);
    return r;
}

// Write fixed-point price as "NNN.NN"
fn rfPutPrice(out: int64, pos: int64, outMax: int64, val: int64): int64 {
    var whole: int64 := val / 100;
    var frac:  int64 := val - whole * 100;
    pos := rfPutInt(out, pos, outMax, whole);
    pos := rfPutChar(out, pos, outMax, EDI_DEF_DEC);
    if (frac < 10) { pos := rfPutChar(out, pos, outMax, 48); }
    pos := rfPutInt(out, pos, outMax, frac);
    return pos;
}

// Parse integer string (decimal digits only)
fn rfParseInt(ptr: int64, len: int64): int64 {
    var v: int64 := 0;
    var i: int64 := 0;
    while (i < len) {
        var c: int64 := peek8(ptr + i);
        if (c >= 48 && c <= 57) { v := v * 10 + (c - 48); }
        i += 1;
    }
    return v;
}

// Parse fixed-point price "NNN.NN" → int64 × 100
fn rfParsePrice(ptr: int64, len: int64): int64 {
    var v: int64 := 0;
    var frac: int64 := 0;
    var inFrac: int64 := 0;
    var fracDig: int64 := 0;
    var i: int64 := 0;
    while (i < len) {
        var c: int64 := peek8(ptr + i);
        if (c == 46 || c == 44) {
            inFrac := 1;
        } else {
            if (c >= 48 && c <= 57) {
                if (inFrac == 0) {
                    v := v * 10 + (c - 48);
                } else {
                    if (fracDig < 2) {
                        frac := frac * 10 + (c - 48);
                        fracDig += 1;
                    }
                }
            }
        }
        i += 1;
    }
    if (fracDig == 1) { frac := frac * 10; }
    return v * 100 + frac;
}

fn rfTagIs(seg: int64, t0: int64, t1: int64, t2: int64): int64 {
    var p: int64 := peek64(seg + EDI_SEG_PTR);
    if (p == 0) { return 0; }
    if (peek8(p) != t0) { return 0; }
    if (peek8(p+1) != t1) { return 0; }
    if (peek8(p+2) != t2) { return 0; }
    return 1;
}

fn rfElemPtr(elems: int64, idx: int64): int64 {
    return peek64(elems + idx * EDI_ELEM_SIZE + EDI_ELEM_PTR);
}
fn rfElemLen(elems: int64, idx: int64): int64 {
    return peek64(elems + idx * EDI_ELEM_SIZE + EDI_ELEM_LEN);
}

// ─────────────────────────────────────────────────────────────────────────────
// Public API — REQOTE
// ─────────────────────────────────────────────────────────────────────────────

// Write REQOTE (request for quotation). rfqNum must be non-null (mandatory).
// date: ptr to "YYYYMMDD" string or 0 (no date). lines: array of EDI_RFQ_LINE_SIZE structs.
// Returns bytes written, or -1 if rfqNum is missing.
pub fn EdiReqoteWrite(rfqNum: pchar, date: pchar, lines: int64, lineCount: int64, out: int64, outMax: int64): int64 {
  var rfqNumAdr: int64 := rfqNum as int64;   // #1613
  var dateAdr: int64 := date as int64;   // #1613
    if (rfqNumAdr == 0) { return 0 - 1; }
    var rfqLen: int64 := rfStrLen(rfqNumAdr);
    if (rfqLen == 0) { return 0 - 1; }

    var pos: int64 := 0;

    // BGM+311+rfqNum+9'  (311 = request for quotation, 9 = original)
    pos := rfPutStr(out, pos, outMax, "BGM"c as int64, 3);
    pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := rfPutStr(out, pos, outMax, "311"c as int64, 3);
    pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := rfPutStr(out, pos, outMax, rfqNumAdr, rfqLen);
    pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := rfPutChar(out, pos, outMax, 57);   // '9'
    pos := rfPutChar(out, pos, outMax, EDI_DEF_SEG);

    // DTM+137:date:102'  (137 = document date)
    if (dateAdr != 0) {
        pos := rfPutStr(out, pos, outMax, "DTM"c as int64, 3);
        pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := rfPutStr(out, pos, outMax, "137"c as int64, 3);
        pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := rfPutStr(out, pos, outMax, dateAdr, 8);
        pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := rfPutStr(out, pos, outMax, "102"c as int64, 3);
        pos := rfPutChar(out, pos, outMax, EDI_DEF_SEG);
    }

    var i: int64 := 0;
    while (i < lineCount) {
        var line: int64 := lines + i * EDI_RFQ_LINE_SIZE;
        var gtinPtr:  int64 := peek64(line + EDI_RFQ_LINE_GTIN);
        var gtinLen:  int64 := peek64(line + EDI_RFQ_LINE_GTINLEN);
        var qty:      int64 := peek64(line + EDI_RFQ_LINE_QTY);
        var unitPtr:  int64 := peek64(line + EDI_RFQ_LINE_UNIT);
        var unitLen:  int64 := peek64(line + EDI_RFQ_LINE_UNITLEN);
        var datePtr:  int64 := peek64(line + EDI_RFQ_LINE_DATE);

        // LIN+lineNo++GTIN:SRV'
        pos := rfPutStr(out, pos, outMax, "LIN"c as int64, 3);
        pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := rfPutInt(out, pos, outMax, i + 1);
        pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
        if (gtinPtr != 0 && gtinLen > 0) {
            pos := rfPutStr(out, pos, outMax, gtinPtr, gtinLen);
            pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
            pos := rfPutStr(out, pos, outMax, "SRV"c as int64, 3);
        }
        pos := rfPutChar(out, pos, outMax, EDI_DEF_SEG);

        // QTY+21:qty:UNIT'  (21 = ordered quantity)
        pos := rfPutStr(out, pos, outMax, "QTY"c as int64, 3);
        pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := rfPutStr(out, pos, outMax, "21"c as int64, 2);
        pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := rfPutInt(out, pos, outMax, qty);
        if (unitPtr != 0 && unitLen > 0) {
            pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
            pos := rfPutStr(out, pos, outMax, unitPtr, unitLen);
        }
        pos := rfPutChar(out, pos, outMax, EDI_DEF_SEG);

        // DTM+10:needByDate:102'  (10 = requested delivery date)
        if (datePtr != 0) {
            pos := rfPutStr(out, pos, outMax, "DTM"c as int64, 3);
            pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
            pos := rfPutStr(out, pos, outMax, "10"c as int64, 2);
            pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
            pos := rfPutStr(out, pos, outMax, datePtr, 8);
            pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
            pos := rfPutStr(out, pos, outMax, "102"c as int64, 3);
            pos := rfPutChar(out, pos, outMax, EDI_DEF_SEG);
        }

        i += 1;
    }

    // CNT+2:lineCount'
    pos := rfPutStr(out, pos, outMax, "CNT"c as int64, 3);
    pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := rfPutChar(out, pos, outMax, 50);   // '2'
    pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
    pos := rfPutInt(out, pos, outMax, lineCount);
    pos := rfPutChar(out, pos, outMax, EDI_DEF_SEG);

    return pos;
}

// Parse REQOTE. Fills hdr (EDI_RFQHDR_SIZE) and lines[] (EDI_RFQ_LINE_SIZE each).
// Returns number of lines parsed. Pointers in hdr and lines point into buf (zero-copy).
pub fn EdiReqoteRead(buf: int64, bufLen: int64, hdr: int64, lines: int64, maxLines: int64): int64 {
    var i: int64 := 0;
    while (i < EDI_RFQHDR_SIZE) { poke8(hdr + i, 0); i := i + 1; }

    var una: int64 := alloc(EDI_UNA_SIZE);
    EdiUnaRead(buf, bufLen, una);
    var startPos: int64 := 0;
    if (peek8(buf) == 85 && peek8(buf+1) == 78 && peek8(buf+2) == 65) { startPos := 9; }
    var sctx: int64 := alloc(EDI_SEGCTX_SIZE);
    EdiSegCtxInit(sctx, una, startPos);
    var seg: int64 := alloc(EDI_SEG_SIZE);
    var elems: int64 := alloc(8 * EDI_ELEM_SIZE);
    var count: int64 := 0;
    var curLine: int64 := 0;
    var done: int64 := 0;

    while (done == 0) {
        var r: int64 := EdiSegmentNext(buf, bufLen, sctx, seg);
        if (r == 0) { done := 1; }
        else {
            var n: int64 := EdiElementSplit(seg, elems, 8);

            // BGM → rfqNum from elem[1], skip if not 311
            if (rfTagIs(seg, 66, 71, 77) == 1) {   // "BGM"
                if (n > 1) {
                    poke64(hdr + EDI_RFQHDR_NUM,    rfElemPtr(elems, 1));
                    poke64(hdr + EDI_RFQHDR_NUMLEN, rfElemLen(elems, 1));
                }
            }

            // DTM → date from comp[1], qualifier comp[0] = "137"
            if (rfTagIs(seg, 68, 84, 77) == 1) {   // "DTM"
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(rfElemPtr(elems, 0), rfElemLen(elems, 0), comps, 4);
                    if (nc > 1) {
                        // qualifier "137" = 49,51,55
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        if (ql >= 3) {
                            if (peek8(qp) == 49 && peek8(qp+1) == 51 && peek8(qp+2) == 55) {
                                poke64(hdr + EDI_RFQHDR_DATE,    peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                                poke64(hdr + EDI_RFQHDR_DATELEN, peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                            }
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // LIN → new line item
            if (rfTagIs(seg, 76, 73, 78) == 1) {   // "LIN"
                if (count < maxLines) {
                    curLine := lines + count * EDI_RFQ_LINE_SIZE;
                    var zi: int64 := 0;
                    while (zi < EDI_RFQ_LINE_SIZE) { poke8(curLine + zi, 0); zi := zi + 1; }
                    // elem[2] = GTIN:SRV composite
                    if (n > 2) {
                        var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                        EdiComponentSplit(rfElemPtr(elems, 2), rfElemLen(elems, 2), comps, 4);
                        poke64(curLine + EDI_RFQ_LINE_GTIN,    peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                        poke64(curLine + EDI_RFQ_LINE_GTINLEN, peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                        free(comps, 4 * EDI_ELEM_SIZE);
                    }
                    count += 1;
                }
            }

            // QTY+21:qty:UNIT' → ordered quantity (qualifier 21 = 50,49)
            if (rfTagIs(seg, 81, 84, 89) == 1 && curLine != 0) {   // "QTY"
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(rfElemPtr(elems, 0), rfElemLen(elems, 0), comps, 4);
                    if (nc > 1) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        // qualifier "21" = 50,49
                        if (ql >= 2 && peek8(qp) == 50 && peek8(qp+1) == 49) {
                            var vp: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                            var vl: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                            poke64(curLine + EDI_RFQ_LINE_QTY, rfParseInt(vp, vl));
                            if (nc > 2) {
                                poke64(curLine + EDI_RFQ_LINE_UNIT,    peek64(comps + 2 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                                poke64(curLine + EDI_RFQ_LINE_UNITLEN, peek64(comps + 2 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                            }
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // DTM+10:date:102' on line → need-by date (qualifier 10 = 49,48)
            if (rfTagIs(seg, 68, 84, 77) == 1 && curLine != 0) {   // "DTM"
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(rfElemPtr(elems, 0), rfElemLen(elems, 0), comps, 4);
                    if (nc > 1) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        if (ql >= 2 && peek8(qp) == 49 && peek8(qp+1) == 48) {
                            poke64(curLine + EDI_RFQ_LINE_DATE, peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }
        }
    }

    free(elems, 8 * EDI_ELEM_SIZE);
    free(seg, EDI_SEG_SIZE);
    free(sctx, EDI_SEGCTX_SIZE);
    free(una, EDI_UNA_SIZE);
    return count;
}

// ─────────────────────────────────────────────────────────────────────────────
// Public API — QUOTES
// ─────────────────────────────────────────────────────────────────────────────

// Write QUOTES (quotation). rfqRef (back-reference to REQOTE) is mandatory.
// quoteNum: quotation number (null-terminated); 0 → write empty.
// lines: array of EDI_QUOTE_LINE_SIZE structs.
// Returns bytes written, or -1 if rfqRef is missing.
pub fn EdiQuotesWrite(rfqRef: pchar, quoteNum: pchar, lines: int64, lineCount: int64, out: int64, outMax: int64): int64 {
  var rfqRefAdr: int64 := rfqRef as int64;   // #1613
  var quoteNumAdr: int64 := quoteNum as int64;   // #1613
    if (rfqRefAdr == 0) { return 0 - 1; }
    var rfqRefLen: int64 := rfStrLen(rfqRefAdr);
    if (rfqRefLen == 0) { return 0 - 1; }

    var pos: int64 := 0;

    // BGM+315+quoteNum+9'  (315 = quotation)
    pos := rfPutStr(out, pos, outMax, "BGM"c as int64, 3);
    pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := rfPutStr(out, pos, outMax, "315"c as int64, 3);
    pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
    if (quoteNumAdr != 0) {
        var qnLen: int64 := rfStrLen(quoteNumAdr);
        pos := rfPutStr(out, pos, outMax, quoteNumAdr, qnLen);
    }
    pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := rfPutChar(out, pos, outMax, 57);   // '9'
    pos := rfPutChar(out, pos, outMax, EDI_DEF_SEG);

    // RFF+RFQ:rfqRef'  (mandatory back-reference to REQOTE)
    pos := rfPutStr(out, pos, outMax, "RFF"c as int64, 3);
    pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := rfPutStr(out, pos, outMax, "RFQ"c as int64, 3);
    pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
    pos := rfPutStr(out, pos, outMax, rfqRefAdr, rfqRefLen);
    pos := rfPutChar(out, pos, outMax, EDI_DEF_SEG);

    var i: int64 := 0;
    while (i < lineCount) {
        var line: int64 := lines + i * EDI_QUOTE_LINE_SIZE;
        var gtinPtr:  int64 := peek64(line + EDI_QUOTE_LINE_GTIN);
        var gtinLen:  int64 := peek64(line + EDI_QUOTE_LINE_GTINLEN);
        var price:    int64 := peek64(line + EDI_QUOTE_LINE_PRICE);
        var currPtr:  int64 := peek64(line + EDI_QUOTE_LINE_CURRENCY);
        var currLen:  int64 := peek64(line + EDI_QUOTE_LINE_CURRENCYLEN);
        var datePtr:  int64 := peek64(line + EDI_QUOTE_LINE_DATE);
        var avail:    int64 := peek64(line + EDI_QUOTE_LINE_AVAIL);

        // LIN+lineNo++GTIN:SRV'
        pos := rfPutStr(out, pos, outMax, "LIN"c as int64, 3);
        pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := rfPutInt(out, pos, outMax, i + 1);
        pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
        if (gtinPtr != 0 && gtinLen > 0) {
            pos := rfPutStr(out, pos, outMax, gtinPtr, gtinLen);
            pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
            pos := rfPutStr(out, pos, outMax, "SRV"c as int64, 3);
        }
        pos := rfPutChar(out, pos, outMax, EDI_DEF_SEG);

        // PRI+AAA:price:CP'
        if (price > 0) {
            pos := rfPutStr(out, pos, outMax, "PRI"c as int64, 3);
            pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
            pos := rfPutStr(out, pos, outMax, "AAA"c as int64, 3);
            pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
            pos := rfPutPrice(out, pos, outMax, price);
            pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
            pos := rfPutStr(out, pos, outMax, "CP"c as int64, 2);
            pos := rfPutChar(out, pos, outMax, EDI_DEF_SEG);
        }

        // LOC+11:avail'  (11 = place of delivery; value 1=yes 0=no as ASCII)
        pos := rfPutStr(out, pos, outMax, "LOC"c as int64, 3);
        pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
        pos := rfPutStr(out, pos, outMax, "11"c as int64, 2);
        pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
        pos := rfPutInt(out, pos, outMax, avail);
        pos := rfPutChar(out, pos, outMax, EDI_DEF_SEG);

        // DTM+2:delivDate:102'  (2 = delivery date)
        if (datePtr != 0) {
            pos := rfPutStr(out, pos, outMax, "DTM"c as int64, 3);
            pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
            pos := rfPutStr(out, pos, outMax, "2"c as int64, 1);
            pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
            pos := rfPutStr(out, pos, outMax, datePtr, 8);
            pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
            pos := rfPutStr(out, pos, outMax, "102"c as int64, 3);
            pos := rfPutChar(out, pos, outMax, EDI_DEF_SEG);
        }

        i += 1;
    }

    // CNT+2:lineCount'
    pos := rfPutStr(out, pos, outMax, "CNT"c as int64, 3);
    pos := rfPutChar(out, pos, outMax, EDI_DEF_DATA);
    pos := rfPutChar(out, pos, outMax, 50);   // '2'
    pos := rfPutChar(out, pos, outMax, EDI_DEF_COMP);
    pos := rfPutInt(out, pos, outMax, lineCount);
    pos := rfPutChar(out, pos, outMax, EDI_DEF_SEG);

    return pos;
}

// Parse QUOTES. Fills hdr (EDI_QUOTEHDR_SIZE) and lines[] (EDI_QUOTE_LINE_SIZE each).
// Returns number of lines parsed.
pub fn EdiQuotesRead(buf: int64, bufLen: int64, hdr: int64, lines: int64, maxLines: int64): int64 {
    var i: int64 := 0;
    while (i < EDI_QUOTEHDR_SIZE) { poke8(hdr + i, 0); i := i + 1; }

    var una: int64 := alloc(EDI_UNA_SIZE);
    EdiUnaRead(buf, bufLen, una);
    var startPos: int64 := 0;
    if (peek8(buf) == 85 && peek8(buf+1) == 78 && peek8(buf+2) == 65) { startPos := 9; }
    var sctx: int64 := alloc(EDI_SEGCTX_SIZE);
    EdiSegCtxInit(sctx, una, startPos);
    var seg: int64 := alloc(EDI_SEG_SIZE);
    var elems: int64 := alloc(8 * EDI_ELEM_SIZE);
    var count: int64 := 0;
    var curLine: int64 := 0;
    var done: int64 := 0;

    while (done == 0) {
        var r: int64 := EdiSegmentNext(buf, bufLen, sctx, seg);
        if (r == 0) { done := 1; }
        else {
            var n: int64 := EdiElementSplit(seg, elems, 8);

            // BGM → quoteNum from elem[1]
            if (rfTagIs(seg, 66, 71, 77) == 1) {   // "BGM"
                if (n > 1) {
                    poke64(hdr + EDI_QUOTEHDR_NUM,    rfElemPtr(elems, 1));
                    poke64(hdr + EDI_QUOTEHDR_NUMLEN, rfElemLen(elems, 1));
                }
            }

            // RFF+RFQ:rfqRef' → back-reference
            if (rfTagIs(seg, 82, 70, 70) == 1) {   // "RFF"
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(rfElemPtr(elems, 0), rfElemLen(elems, 0), comps, 4);
                    if (nc > 1) {
                        // qualifier "RFQ" = 82,70,81
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        if (ql >= 3) {
                            if (peek8(qp) == 82 && peek8(qp+1) == 70 && peek8(qp+2) == 81) {
                                poke64(hdr + EDI_QUOTEHDR_RFQREF,    peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                                poke64(hdr + EDI_QUOTEHDR_RFQREFLEN, peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                            }
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // LIN → new quote line
            if (rfTagIs(seg, 76, 73, 78) == 1) {   // "LIN"
                if (count < maxLines) {
                    curLine := lines + count * EDI_QUOTE_LINE_SIZE;
                    var zi: int64 := 0;
                    while (zi < EDI_QUOTE_LINE_SIZE) { poke8(curLine + zi, 0); zi := zi + 1; }
                    if (n > 2) {
                        var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                        EdiComponentSplit(rfElemPtr(elems, 2), rfElemLen(elems, 2), comps, 4);
                        poke64(curLine + EDI_QUOTE_LINE_GTIN,    peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                        poke64(curLine + EDI_QUOTE_LINE_GTINLEN, peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN));
                        free(comps, 4 * EDI_ELEM_SIZE);
                    }
                    count += 1;
                }
            }

            // PRI+AAA:price:CP' → net price
            if (rfTagIs(seg, 80, 82, 73) == 1 && curLine != 0) {   // "PRI"
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(rfElemPtr(elems, 0), rfElemLen(elems, 0), comps, 4);
                    if (nc > 1) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        // "AAA" = 65,65,65
                        if (ql >= 3 && peek8(qp) == 65 && peek8(qp+1) == 65 && peek8(qp+2) == 65) {
                            var vp: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                            var vl: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                            poke64(curLine + EDI_QUOTE_LINE_PRICE, rfParsePrice(vp, vl));
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // LOC+11:avail' → availability (avail = "1" or "0")
            if (rfTagIs(seg, 76, 79, 67) == 1 && curLine != 0) {   // "LOC"
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(rfElemPtr(elems, 0), rfElemLen(elems, 0), comps, 4);
                    if (nc > 1) {
                        var vp: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var vl: int64 := peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        poke64(curLine + EDI_QUOTE_LINE_AVAIL, rfParseInt(vp, vl));
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }

            // DTM+2:date:102' → delivery date (qualifier "2" = 50)
            if (rfTagIs(seg, 68, 84, 77) == 1 && curLine != 0) {   // "DTM"
                if (n > 0) {
                    var comps: int64 := alloc(4 * EDI_ELEM_SIZE);
                    var nc: int64 := EdiComponentSplit(rfElemPtr(elems, 0), rfElemLen(elems, 0), comps, 4);
                    if (nc > 1) {
                        var qp: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_PTR);
                        var ql: int64 := peek64(comps + 0 * EDI_ELEM_SIZE + EDI_ELEM_LEN);
                        if (ql >= 1 && peek8(qp) == 50) {
                            poke64(curLine + EDI_QUOTE_LINE_DATE, peek64(comps + 1 * EDI_ELEM_SIZE + EDI_ELEM_PTR));
                        }
                    }
                    free(comps, 4 * EDI_ELEM_SIZE);
                }
            }
        }
    }

    free(elems, 8 * EDI_ELEM_SIZE);
    free(seg, EDI_SEG_SIZE);
    free(sctx, EDI_SEGCTX_SIZE);
    free(una, EDI_UNA_SIZE);
    return count;
}
