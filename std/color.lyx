// std/color.lyx
// Color utilities for visualization (RGBA)
// All values stored as int64 (0-255 for each channel)

@description("Color representation and conversion")
@author("Andreas Röne")
@copyright("2024-2025 Andreas Röne")
unit std.color;

import std.math;

// ============================================================================
// Color - RGBA Color
// ============================================================================

pub type Color = struct {
  r: int64;
  g: int64;
  b: int64;
  a: int64;
}

// ============================================================================
// Constructors
// ============================================================================

pub fn ColorNew(r: int64, g: int64, b: int64, a: int64): Color {
  var _sl28: Color;
  _sl28.r := Clamp64(r, 0, 255);
  _sl28.g := Clamp64(g, 0, 255);
  _sl28.b := Clamp64(b, 0, 255);
  _sl28.a := Clamp64(a, 0, 255);
  return _sl28;
}

pub fn ColorRGB(r: int64, g: int64, b: int64): Color {
  return ColorNew(r, g, b, 255);
}

pub fn ColorRGBA(r: int64, g: int64, b: int64, a: int64): Color {
  return ColorNew(r, g, b, a);
}

pub fn ColorGray(gray: int64): Color {
  var g: int64 := Clamp64(gray, 0, 255);
  var _sl41: Color;
  _sl41.r := g;
  _sl41.g := g;
  _sl41.b := g;
  _sl41.a := 255;
  return _sl41;
}

pub fn ColorEmpty(): Color {
  var _sl45: Color;
  _sl45.r := 0;
  _sl45.g := 0;
  _sl45.b := 0;
  _sl45.a := 0;
  return _sl45;
}

pub fn ColorOpaque(): Color {
  var _sl49: Color;
  _sl49.r := 0;
  _sl49.g := 0;
  _sl49.b := 0;
  _sl49.a := 255;
  return _sl49;
}

// ============================================================================
// Preset Colors
// ============================================================================

pub fn ColorBlack(): Color { return ColorRGB(0, 0, 0); }
pub fn ColorWhite(): Color { return ColorRGB(255, 255, 255); }
pub fn ColorRed(): Color { return ColorRGB(255, 0, 0); }
pub fn ColorGreen(): Color { return ColorRGB(0, 255, 0); }
pub fn ColorBlue(): Color { return ColorRGB(0, 0, 255); }
pub fn ColorYellow(): Color { return ColorRGB(255, 255, 0); }
pub fn ColorCyan(): Color { return ColorRGB(0, 255, 255); }
pub fn ColorMagenta(): Color { return ColorRGB(255, 0, 255); }
pub fn ColorOrange(): Color { return ColorRGB(255, 165, 0); }
pub fn ColorPurple(): Color { return ColorRGB(128, 0, 128); }
pub fn ColorPink(): Color { return ColorRGB(255, 192, 203); }
pub fn ColorBrown(): Color { return ColorRGB(165, 42, 42); }
pub fn ColorGrayLight(): Color { return ColorRGB(200, 200, 200); }
pub fn ColorGrayDark(): Color { return ColorRGB(64, 64, 64); }

// ============================================================================
// Color Properties
// ============================================================================

pub fn ColorIsOpaque(c: Color): bool {
  return c.a == 255;
}

pub fn ColorIsTransparent(c: Color): bool {
  return c.a == 0;
}

pub fn ColorIsValid(c: Color): bool {
  return (c.r >= 0) && (c.r <= 255) &&
         (c.g >= 0) && (c.g <= 255) &&
         (c.b >= 0) && (c.b <= 255) &&
         (c.a >= 0) && (c.a <= 255);
}

// ============================================================================
// Color Manipulation
// ============================================================================

pub fn ColorWithAlpha(c: Color, alpha: int64): Color {
  var _sl95: Color;
  _sl95.r := c.r;
  _sl95.g := c.g;
  _sl95.b := c.b;
  _sl95.a := Clamp64(alpha, 0, 255);
  return _sl95;
}

pub fn ColorWithRed(c: Color, red: int64): Color {
  var _sl99: Color;
  _sl99.r := Clamp64(red, 0, 255);
  _sl99.g := c.g;
  _sl99.b := c.b;
  _sl99.a := c.a;
  return _sl99;
}

pub fn ColorWithGreen(c: Color, green: int64): Color {
  var _sl103: Color;
  _sl103.r := c.r;
  _sl103.g := Clamp64(green, 0, 255);
  _sl103.b := c.b;
  _sl103.a := c.a;
  return _sl103;
}

pub fn ColorWithBlue(c: Color, blue: int64): Color {
  var _sl107: Color;
  _sl107.r := c.r;
  _sl107.g := c.g;
  _sl107.b := Clamp64(blue, 0, 255);
  _sl107.a := c.a;
  return _sl107;
}

// ============================================================================
// Color Blending
// ============================================================================

pub fn ColorBlend(src: Color, dst: Color): Color {
  var src_a: int64 := src.a;
  var dst_a: int64 := dst.a;
  if (src_a == 0) { return dst; }
  if (src_a == 255) { return src; }
  var inv_a: int64 := 255 - src_a;
  var dst_contrib: int64 := dst_a * inv_a;
  var out_a: int64 := src_a + dst_contrib / 255;
  if (out_a == 0) { return ColorEmpty(); }
  var r_raw: int64 := src.r * src_a + dst.r * dst_a * inv_a / 255;
  var g_raw: int64 := src.g * src_a + dst.g * dst_a * inv_a / 255;
  var b_raw: int64 := src.b * src_a + dst.b * dst_a * inv_a / 255;
  var r: int64 := r_raw / 255;
  var g: int64 := g_raw / 255;
  var b: int64 := b_raw / 255;
  return ColorNew(r, g, b, out_a);
}

pub fn ColorMultiply(c1: Color, c2: Color): Color {
  var r: int64 := c1.r * c2.r;
  var g: int64 := c1.g * c2.g;
  var b: int64 := c1.b * c2.b;
  var _sl136: Color;
  _sl136.r := r / 255;
  _sl136.g := g / 255;
  _sl136.b := b / 255;
  _sl136.a := c1.a;
  return _sl136;
}

// ============================================================================
// Color Operations
// ============================================================================

pub fn ColorInvert(c: Color): Color {
  var _sl144: Color;
  _sl144.r := 255 - c.r;
  _sl144.g := 255 - c.g;
  _sl144.b := 255 - c.b;
  _sl144.a := c.a;
  return _sl144;
}

pub fn ColorGrayscale(c: Color): Color {
  var gray_num: int64 := 299 * c.r + 587 * c.g + 114 * c.b;
  var gray: int64 := gray_num / 1000;
  return ColorGray(gray);
}

pub fn ColorBrighten(c: Color, amount: int64): Color {
  var _sl154: Color;
  _sl154.r := Min64(255, c.r + amount);
  _sl154.g := Min64(255, c.g + amount);
  _sl154.b := Min64(255, c.b + amount);
  _sl154.a := c.a;
  return _sl154;
}

pub fn ColorDarken(c: Color, amount: int64): Color {
  var _sl158: Color;
  _sl158.r := Max64(0, c.r - amount);
  _sl158.g := Max64(0, c.g - amount);
  _sl158.b := Max64(0, c.b - amount);
  _sl158.a := c.a;
  return _sl158;
}

pub fn ColorSaturate(c: Color, amount: int64): Color {
  var gray_num: int64 := 299 * c.r + 587 * c.g + 114 * c.b;
  var gray: int64 := gray_num / 1000;
  var dr: int64 := c.r - gray;
  var dg: int64 := c.g - gray;
  var db: int64 := c.b - gray;
  var nr: int64 := c.r + dr * amount / 255;
  var ng: int64 := c.g + dg * amount / 255;
  var nb: int64 := c.b + db * amount / 255;
  var _sl170: Color;
  _sl170.r := Clamp64(nr, 0, 255);
  _sl170.g := Clamp64(ng, 0, 255);
  _sl170.b := Clamp64(nb, 0, 255);
  _sl170.a := c.a;
  return _sl170;
}

// ============================================================================
// Color Interpolation
// ============================================================================

pub fn ColorLerp(c1: Color, c2: Color, t: int64): Color {
  var _sl178: Color;
  _sl178.r := Lerp64(c1.r, c2.r, t);
  _sl178.g := Lerp64(c1.g, c2.g, t);
  _sl178.b := Lerp64(c1.b, c2.b, t);
  _sl178.a := Lerp64(c1.a, c2.a, t);
  return _sl178;
}

pub fn ColorMix(c1: Color, c2: Color): Color {
  var r: int64 := c1.r + c2.r;
  var g: int64 := c1.g + c2.g;
  var b: int64 := c1.b + c2.b;
  var a: int64 := c1.a + c2.a;
  var _sl186: Color;
  _sl186.r := r / 2;
  _sl186.g := g / 2;
  _sl186.b := b / 2;
  _sl186.a := a / 2;
  return _sl186;
}

// ============================================================================
// Color Comparison
// ============================================================================

pub fn ColorEqual(c1: Color, c2: Color): bool {
  return (c1.r == c2.r) && (c1.g == c2.g) &&
         (c1.b == c2.b) && (c1.a == c2.a);
}

pub fn ColorNotEqual(c1: Color, c2: Color): bool {
  return not ColorEqual(c1, c2);
}

// ============================================================================
// Color Distance (in RGB space)
// ============================================================================

pub fn ColorDistance(c1: Color, c2: Color): int64 {
  var dr: int64 := c1.r - c2.r;
  var dg: int64 := c1.g - c2.g;
  var db: int64 := c1.b - c2.b;
  if (dr < 0) { dr := -dr; }
  if (dg < 0) { dg := -dg; }
  if (db < 0) { db := -db; }
  return dr + dg + db;
}

// ============================================================================
// Hex Conversion
// ============================================================================

pub fn ColorFromHex(hex: int64): Color {
  var r: int64 := (hex >> 16) & 255;
  var g: int64 := (hex >> 8) & 255;
  var b: int64 := hex & 255;
  var a: int64 := 255;
  if (hex > 16777215) {
    a := (hex >> 24) & 255;
  }
  return ColorNew(r, g, b, a);
}

pub fn ColorToHex(c: Color): int64 {
  return (c.r << 16) + (c.g << 8) + c.b;
}

pub fn ColorToHexARGB(c: Color): int64 {
  return (c.a << 24) + (c.r << 16) + (c.g << 8) + c.b;
}

// ============================================================================
// HSL Conversion
// ============================================================================

pub fn ColorFromHSL(h: int64, s: int64, l: int64): Color {
  var h_norm: int64 := h * 255 / 360;
  var s_norm: int64 := s;
  var l_norm: int64 := l;
  if (s_norm == 0) {
    return ColorGray(l_norm);
  }
  var s_sum: int64 := 255 + s_norm;
  var q: int64 := l_norm * s_sum;
  q := q / 255;
  var two_l: int64 := 2 * l_norm;
  var p: int64 := two_l - q;
  var r: int64 := HueToRGB(p, q, h_norm + 85);
  var g: int64 := HueToRGB(p, q, h_norm);
  var b: int64 := HueToRGB(p, q, h_norm - 85);
  return ColorRGB(r, g, b);
}

fn HueToRGB(p: int64, q: int64, hue: int64): int64 {
  if (hue < 0) { hue := hue + 255; }
  if (hue > 255) { hue := hue - 255; }
  if (hue < 42) {
    var diff: int64 := q - p;
    var num: int64 := diff * hue;
    return p + num / 42;
  }
  if (hue < 127) { return q; }
  if (hue < 170) {
    var diff: int64 := q - p;
    var rem: int64 := 170 - hue;
    var num: int64 := diff * rem;
    return p + num / 85;
  }
  return p;
}

