// std/crypto/aescore.lyx — AES-Schluesselplan und Blockverschluesselung auf
// Rohspeicher, fuer beide Schluessellaengen (16 und 32 Byte).
//
// Herkunft: der Block stand bis 1.2.47B unit-privat in std/crypto/aesgcm.lyx.
// #2638 braucht denselben Kern fuer AES-CMAC (RFC 4493) und AES-CCM
// (RFC 3610); eine zweite Kopie derselben Rundenrechnung waere kein
// Redundanzproblem, sondern ein Korrektheitsproblem — zwei Stellen, die
// auseinanderlaufen koennen. Darum steht sie hier einmal, und aesgcm,
// aescmac und aesccm rufen sie auf.
//
// Oeffentliche API:
//   AesCoreKeyExpand(key, keyLen, rk): int64
//       Erweitert key (keyLen 16 oder 32) nach rk und liefert die Rundenzahl
//       (10 bzw. 14) oder 0 bei ungueltiger Laenge. rk braucht
//       (rounds + 1) * 16 Byte, also 176 bzw. 240.
//   AesCoreEncBlock(st, rk, rounds): void
//       Verschluesselt den 16-Byte-Block st an seinem Platz.
//   AesCoreNurSoftware(an): void
//       AES-NI abschalten (1) oder wieder zulassen (0) — fuer Messungen, die
//       beide Wege gegeneinander rechnen.
//   AesCoreAesniAktiv(): int64
//       1, wenn der Hardwareweg genommen wird.
//
// std/crypto/aes.lyx rechnet dieselbe Runde zusaetzlich auf `pchar`
// (AES128KeyExpand, AESEncryptBlockWithKey) und einmal auf Rohspeicher fuer
// AES-256-CTR (aes256_keyexp/aes256_enc, unit-privat). Wer eine der Stellen
// aendert, muss die anderen nachziehen.

unit std.crypto.aescore;

import std.alloc;
import std.crypto.aes;      // SubByte, AESNIAvailable, AESNIEncryptBlock

// ---------------------------------------------------------------------------
// Hardwareweg (#2383): Ergebnis von AESNIAvailable(), einmal gemessen. Das
// Flag `geprueft` ist noetig, weil 0 ein gueltiges Ergebnis ist.
// ---------------------------------------------------------------------------
var _acAesni: int64 := 0;
var _acAesniGeprueft: int64 := 0;

fn acAesniDa(): int64 {
    if (_acAesniGeprueft == 0) {
        _acAesniGeprueft := 1;
        if (AESNIAvailable() != 0) { _acAesni := 1; }
    }
    return _acAesni;
}

pub fn AesCoreAesniAktiv(): int64 {
    return acAesniDa();
}

// Schnellweg abschalten (1) oder wieder zulassen (0).
//
// Das ist KEIN Abstimmknopf fuer Anwender, sondern die Voraussetzung dafuer,
// beide Seiten zu messen: ohne ihn ist der Softwareweg auf einer CPU mit
// AES-NI nicht erreichbar, und ein Test, der nur den schnellen Weg prueft,
// waere auch von einer Fassung erfuellt, die immer ihn nimmt (#1823).
pub fn AesCoreNurSoftware(an: int64): void {
    _acAesniGeprueft := 1;
    _acAesni := 0;
    if (an == 0) {
        if (AESNIAvailable() != 0) { _acAesni := 1; }
    }
}

// ---------------------------------------------------------------------------
// AES-Kern: Schluesselplan und Blockverschluesselung auf Rohspeicher
//
// std/crypto/aes.lyx rechnet dieselbe Runde auf `pchar` (AES128KeyExpand,
// AESEncryptBlockWithKey) und einmal auf Rohspeicher fuer AES-256-CTR
// (aes256_keyexp/aes256_enc, unit-privat). Hier steht sie fuer beide
// Schluessellaengen auf Rohspeicher; S-Box und GF-Multiplikation kommen aus
// std.crypto.aes (SubByte, GF_mul), damit die Tabellen nicht ein drittes Mal
// im Baum liegen. Wer eine der Stellen aendert, muss die anderen nachziehen.
// ---------------------------------------------------------------------------

// S-Box und Rundenkonstanten entstehen EINMAL je Programmlauf.
//
// Gemessen (1.2.31B, i5-8250U): ohne Tabelle lief AES-128-GCM mit 17 KB/s —
// SubByte aus std/crypto/aes.lyx sucht das Inverse in GF(2^8) durch Probieren
// (bis zu 256 GF_mul je Aufruf, jedes selbst eine Achterschleife), also rund
// zweitausend Operationen je Zustandsbyte. Mit Tabelle sind es zwei Zugriffe.
//
// Preis: ein Tabellenzugriff haengt am Datum, die Zugriffsfolge ist also
// ueber den Cache beobachtbar (T-Table-Angriffe). Die Tabelle ist 256 Byte
// gross und damit klein genug, dass ein Angreifer nur wenige Cachezeilen
// unterscheiden kann — ein echter Gegenentwurf ist eine bitgeschnittene
// Umsetzung oder AES-NI. Beides ist als eigener Schritt gefuehrt, nicht hier
// halb angefangen; GHASH bleibt sprungfrei und tabellenlos.
var _acSbox: int64 := 0;

fn acTables(): int64 {
    if (_acSbox != 0) { return _acSbox; }
    var sb: int64 := alloc(256);
    if (sb == 0) { return 0; }
    var i: int64 := 0;
    while (i < 256) { poke8(sb + i, SubByte(i)); i := i + 1; }
    _acSbox := sb;
    return sb;
}

fn acSub(x: int64): int64 {
    return peek8(_acSbox + (x & 255));
}

// Rundenkonstante: x^(i-1) in GF(2^8), i ab 1.
fn acRcon(i: int64): int64 {
    var v: int64 := 1;
    var n: int64 := 1;
    while (n < i) {
        v := (v * 2) & 255;
        if (v == 0) { v := 0x1b; }
        if ((v & 0x100) != 0) { v := (v ^ 0x11b) & 255; }
        n += 1;
    }
    return v;
}

// Erweitert key (keyLen 16 oder 32) nach rk; liefert die Rundenzahl
// (10 bzw. 14) oder 0 bei ungueltiger Laenge.
// rk braucht (rounds + 1) * 16 Byte, also 176 bzw. 240.
pub fn AesCoreKeyExpand(key: int64, keyLen: int64, rk: int64): int64 {
    if (keyLen != 16 && keyLen != 32) { return 0; }
    if (acTables() == 0) { panic("AES: kein Speicher fuer die S-Box"); }
    var nk: int64 := keyLen / 4;             // 4 oder 8 Woerter
    var rounds: int64 := nk + 6;             // 10 oder 14
    var total: int64 := (rounds + 1) * 4;    // Woerter im Schluesselplan

    var i: int64 := 0;
    while (i < keyLen) { poke8(rk + i, peek8(key + i)); i := i + 1; }

    var rcon: int64 := 1;
    var j: int64 := nk;
    while (j < total) {
        var t0: int64 := peek8(rk + (j - 1) * 4);
        var t1: int64 := peek8(rk + (j - 1) * 4 + 1);
        var t2: int64 := peek8(rk + (j - 1) * 4 + 2);
        var t3: int64 := peek8(rk + (j - 1) * 4 + 3);
        if (j % nk == 0) {
            var t: int64 := t0;
            t0 := acSub(t1) ^ acRcon(rcon);
            rcon := rcon + 1;
            var s2: int64 := acSub(t2);
            var s3: int64 := acSub(t3);
            t1 := s2;
            t2 := s3;
            t3 := acSub(t);
        } else {
            if (nk == 8 && j % nk == 4) {
                t0 := acSub(t0); t1 := acSub(t1);
                t2 := acSub(t2); t3 := acSub(t3);
            }
        }
        poke8(rk + j * 4,     peek8(rk + (j - nk) * 4)     ^ t0);
        poke8(rk + j * 4 + 1, peek8(rk + (j - nk) * 4 + 1) ^ t1);
        poke8(rk + j * 4 + 2, peek8(rk + (j - nk) * 4 + 2) ^ t2);
        poke8(rk + j * 4 + 3, peek8(rk + (j - nk) * 4 + 3) ^ t3);
        j += 1;
    }
    return rounds;
}

fn acAddRoundKey(st: int64, rk: int64, rnd: int64): void {
    var i: int64 := 0;
    while (i < 16) {
        poke8(st + i, peek8(st + i) ^ peek8(rk + rnd * 16 + i));
        i += 1;
    }
}

fn acSubBytes(st: int64): void {
    var i: int64 := 0;
    while (i < 16) { poke8(st + i, peek8(_acSbox + peek8(st + i))); i := i + 1; }
}

// Verdoppelung in GF(2^8) — zwei Befehle statt eines GF_mul-Aufrufs mit
// Achterschleife.
fn acXtime(x: int64): int64 {
    var v: int64 := (x * 2) & 255;
    if ((x & 0x80) != 0) { v := v ^ 0x1b; }
    return v;
}

// Zeilen 1..3 nach links rotieren; der Zustand liegt spaltenweise
// (st[r + 4*c] ist Zeile r, Spalte c).
fn acShiftRows(st: int64): void {
    var t: int64 := peek8(st + 1);
    poke8(st + 1, peek8(st + 5)); poke8(st + 5, peek8(st + 9));
    poke8(st + 9, peek8(st + 13)); poke8(st + 13, t);

    t := peek8(st + 2);
    poke8(st + 2, peek8(st + 10)); poke8(st + 10, t);
    t := peek8(st + 6);
    poke8(st + 6, peek8(st + 14)); poke8(st + 14, t);

    t := peek8(st + 15);
    poke8(st + 15, peek8(st + 11)); poke8(st + 11, peek8(st + 7));
    poke8(st + 7, peek8(st + 3)); poke8(st + 3, t);
}

fn acMixColumns(st: int64): void {
    var c: int64 := 0;
    while (c < 4) {
        var a0: int64 := peek8(st + c * 4);
        var a1: int64 := peek8(st + c * 4 + 1);
        var a2: int64 := peek8(st + c * 4 + 2);
        var a3: int64 := peek8(st + c * 4 + 3);
        var x0: int64 := acXtime(a0);
        var x1: int64 := acXtime(a1);
        var x2: int64 := acXtime(a2);
        var x3: int64 := acXtime(a3);
        poke8(st + c * 4,     x0 ^ (x1 ^ a1) ^ a2 ^ a3);
        poke8(st + c * 4 + 1, a0 ^ x1 ^ (x2 ^ a2) ^ a3);
        poke8(st + c * 4 + 2, a0 ^ a1 ^ x2 ^ (x3 ^ a3));
        poke8(st + c * 4 + 3, (x0 ^ a0) ^ a1 ^ a2 ^ x3);
        c += 1;
    }
}

// Verschluesselt den 16-Byte-Block st an seinem Platz.
pub fn AesCoreEncBlock(st: int64, rk: int64, rounds: int64): void {
    // #2390: AES-NI, wenn die CPU es kann. Der Rundenschluesselplan ist
    // derselbe (Standard-AES-Schluesselplan, (rounds+1) * 16 Byte
    // hintereinander), den AESNIEncryptBlock erwartet — gegengeprueft in
    // tests/ghash_pclmul_2390_test.sh, das beide Wege Byte fuer Byte
    // vergleicht. Damit entfaellt der T-Table-Zugriff des Softwarewegs und
    // mit ihm sein Cache-Seitenkanal.
    if (acAesniDa() != 0) {
        AESNIEncryptBlock(st as pchar, rk as pchar, rounds);
        return;
    }
    acAddRoundKey(st, rk, 0);
    var r: int64 := 1;
    while (r < rounds) {
        acSubBytes(st);
        acShiftRows(st);
        acMixColumns(st);
        acAddRoundKey(st, rk, r);
        r += 1;
    }
    acSubBytes(st);
    acShiftRows(st);
    acAddRoundKey(st, rk, rounds);
}
