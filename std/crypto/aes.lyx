// std/crypto/aes.lyx - AES Encryption/Decryption
// Implements AES-128-CBC and AES-256-CBC with proper S-Box and Key Schedule

unit std.crypto.aes;

import std.alloc;

// ============================================================================
// Constants
// ============================================================================

pub con AES_BLOCK_SIZE: int64 := 16;
pub con AES_128_KEY_SIZE: int64 := 16;
pub con AES_256_KEY_SIZE: int64 := 32;
pub con AES_128_ROUNDS: int64 := 10;
pub con AES_256_ROUNDS: int64 := 14;
pub con AES_128_ROUND_KEYS: int64 := 11;
pub con AES_256_ROUND_KEYS: int64 := 15;

// ============================================================================
// GF(2^8) Multiplication
// ============================================================================

pub fn GF_mul(a: int64, b: int64): int64 {
    var result: int64 := 0;
    var i: int64 := 0;
    while (i < 8) {
        if ((b & 1) != 0) { result := result ^ a; }
        var hi_bit: int64 := a & 0x80;
        a := (a * 2) & 255;
        if (hi_bit != 0) { a := a ^ 0x1b; }
        b := b / 2;
        i += 1;
    }
    return result;
}

// ============================================================================
// AES S-Box (computed at runtime using GF inverse + affine transform)
// ============================================================================

fn GF_inv(x: int64): int64 {
    // Extended Euclidean algorithm for GF(2^8) inverse
    if (x == 0) { return 0; }
    
    // Use multiplication in GF(2^8) with irreducible polynomial x^8 + x^4 + x^3 + x + 1 (0x11b)
    // Using exponent/log tables for faster computation
    
    // Compute inverse using repeated squaring
    var result: int64 := 1;
    var exp: int64 := 253; // Since x^254 * x = x^255 = 1 in GF(2^8), x^-1 = x^253
    
    var base: int64 := x;
    while (exp > 0) {
        if ((exp & 1) != 0) {
            result := GF_mul(result, base);
        }
        base := GF_mul(base, base);
        exp := exp / 2;
    }
    
    return result;
}

// Simplified GF inverse using brute force (256 values only)
pub fn GF_inv_simple(x: int64): int64 {
    if (x == 0) { return 0; }
    var i: int64 := 1;
    while (i < 256) {
        if (GF_mul(i, x) == 1) { return i; }
        i += 1;
    }
    return 0;
}

// Compute the AES S-Box at initialization
// Returns the inverse S-Box value for a given forward S-Box value
pub fn InvSubByteFromForward(sbox_val: int64): int64 {
    // We need to find x such that SubByte(x) = sbox_val
    // This means: affine(GF_inv(x)) = sbox_val
    // So: inverse_affine(sbox_val) = GF_inv(x)
    // And: GF_inv(inverse_affine(sbox_val)) = x
    
    // First apply inverse affine transform
    var y: int64 := sbox_val;
    var result: int64 := 0;
    var i: int64 := 0;
    while (i < 8) {
        var bit: int64 := 0;
        // The inverse affine transform matrix
        bit := bit ^ ((y >> 0) & 1);
        bit := bit ^ ((y >> 2) & 1);
        bit := bit ^ ((y >> 3) & 1);
        bit := bit ^ ((y >> 5) & 1);
        bit := bit ^ ((y >> 6) & 1);
        bit := bit ^ ((y >> 7) & 1);
        
        if (bit != 0) { result := result | (1 << i); }
        i += 1;
    }
    
    // Then apply GF inverse to get the original value
    return GF_inv_simple(result);
}

pub fn SubByte(x: int64): int64 {
    var inv: int64 := GF_inv_simple(x);
    // AES affine transform: y = x ^ ROT8L(x,1) ^ ROT8L(x,2) ^ ROT8L(x,3) ^ ROT8L(x,4) ^ 0x63
    var r1: int64 := ((inv << 1) | (inv >> 7)) & 255;
    var r2: int64 := ((inv << 2) | (inv >> 6)) & 255;
    var r3: int64 := ((inv << 3) | (inv >> 5)) & 255;
    var r4: int64 := ((inv << 4) | (inv >> 4)) & 255;
    return inv ^ r1 ^ r2 ^ r3 ^ r4 ^ 0x63;
}

pub fn InvSubByte(x: int64): int64 {
    // Use brute force: find y such that SubByte(y) = x
    // This is only 256 values, so it's fast
    var i: int64 := 0;
    while (i < 256) {
        if (SubByte(i) == x) { return i; }
        i += 1;
    }
    return 0;
}

fn xtime(x: int64): int64 {
    var result: int64 := (x * 2) & 255;
    if ((x & 0x80) != 0) { result := result ^ 0x1b; }
    return result;
}

fn times3(x: int64): int64 { return xtime(x) ^ x; }

// ============================================================================
// AES Core Operations
// ============================================================================

fn SubBytes(state: pchar): pchar {
    var i: int64 := 0;
    while (i < 16) {
        var b: int64 := StrCharAt(state, i);
        StrSetChar(state, i, SubByte(b));
        i += 1;
    }
    return state;
}

fn InvSubBytes(state: pchar): pchar {
    var i: int64 := 0;
    while (i < 16) {
        var b: int64 := StrCharAt(state, i);
        StrSetChar(state, i, InvSubByte(b));
        i += 1;
    }
    return state;
}

fn ShiftRows(state: pchar): pchar {
    var t1: int64 := StrCharAt(state, 1);
    StrSetChar(state, 1, StrCharAt(state, 5));
    StrSetChar(state, 5, StrCharAt(state, 9));
    StrSetChar(state, 9, StrCharAt(state, 13));
    StrSetChar(state, 13, t1);
    
    var t2a: int64 := StrCharAt(state, 2);
    var t2b: int64 := StrCharAt(state, 6);
    StrSetChar(state, 2, StrCharAt(state, 10));
    StrSetChar(state, 6, StrCharAt(state, 14));
    StrSetChar(state, 10, t2a);
    StrSetChar(state, 14, t2b);
    
    var t3: int64 := StrCharAt(state, 15);
    StrSetChar(state, 15, StrCharAt(state, 11));
    StrSetChar(state, 11, StrCharAt(state, 7));
    StrSetChar(state, 7, StrCharAt(state, 3));
    StrSetChar(state, 3, t3);
    
    return state;
}

fn InvShiftRows(state: pchar): pchar {
    var t1: int64 := StrCharAt(state, 1);
    StrSetChar(state, 1, StrCharAt(state, 13));
    StrSetChar(state, 13, StrCharAt(state, 9));
    StrSetChar(state, 9, StrCharAt(state, 5));
    StrSetChar(state, 5, t1);
    
    // #1260: Zeile 2 wird um ZWEI gedreht und ist damit ihre eigene Umkehrung —
    // die Rueckrichtung muss dieselben Paare tauschen wie die Hinrichtung,
    // (2,10) und (6,14). Hier standen (2,14) und (6,10): ueber Kreuz. Das war
    // der zweite, von der Key Expansion unabhaengige Defekt — die
    // Verschluesselung stimmte danach gegen FIPS-197, der Roundtrip nicht.
    var t2a: int64 := StrCharAt(state, 2);
    var t2b: int64 := StrCharAt(state, 6);
    StrSetChar(state, 2, StrCharAt(state, 10));
    StrSetChar(state, 6, StrCharAt(state, 14));
    StrSetChar(state, 10, t2a);
    StrSetChar(state, 14, t2b);
    
    var t3: int64 := StrCharAt(state, 3);
    StrSetChar(state, 3, StrCharAt(state, 7));
    StrSetChar(state, 7, StrCharAt(state, 11));
    StrSetChar(state, 11, StrCharAt(state, 15));
    StrSetChar(state, 15, t3);
    
    return state;
}

fn MixColumns(state: pchar): pchar {
    var i: int64 := 0;
    while (i < 4) {
        var idx: int64 := i * 4;
        var s0: int64 := StrCharAt(state, idx);
        var s1: int64 := StrCharAt(state, idx + 1);
        var s2: int64 := StrCharAt(state, idx + 2);
        var s3: int64 := StrCharAt(state, idx + 3);
        
        StrSetChar(state, idx, xtime(s0) ^ times3(s1) ^ s2 ^ s3);
        StrSetChar(state, idx + 1, s0 ^ xtime(s1) ^ times3(s2) ^ s3);
        StrSetChar(state, idx + 2, s0 ^ s1 ^ xtime(s2) ^ times3(s3));
        StrSetChar(state, idx + 3, times3(s0) ^ s1 ^ s2 ^ xtime(s3));
        
        i += 1;
    }
    return state;
}

fn InvMixColumns(state: pchar): pchar {
    var i: int64 := 0;
    while (i < 4) {
        var idx: int64 := i * 4;
        var s0: int64 := StrCharAt(state, idx);
        var s1: int64 := StrCharAt(state, idx + 1);
        var s2: int64 := StrCharAt(state, idx + 2);
        var s3: int64 := StrCharAt(state, idx + 3);
        
        StrSetChar(state, idx, GF_mul(0x0e, s0) ^ GF_mul(0x0b, s1) ^ GF_mul(0x0d, s2) ^ GF_mul(0x09, s3));
        StrSetChar(state, idx + 1, GF_mul(0x09, s0) ^ GF_mul(0x0e, s1) ^ GF_mul(0x0b, s2) ^ GF_mul(0x0d, s3));
        StrSetChar(state, idx + 2, GF_mul(0x0d, s0) ^ GF_mul(0x09, s1) ^ GF_mul(0x0e, s2) ^ GF_mul(0x0b, s3));
        StrSetChar(state, idx + 3, GF_mul(0x0b, s0) ^ GF_mul(0x0d, s1) ^ GF_mul(0x09, s2) ^ GF_mul(0x0e, s3));
        
        i += 1;
    }
    return state;
}

// ============================================================================
// AES Key Schedule
// ============================================================================

// Rcon table for key schedule (first 15 values)
fn Rcon(i: int64): int64 {
    if (i == 1) { return 0x01; }
    if (i == 2) { return 0x02; }
    if (i == 3) { return 0x04; }
    if (i == 4) { return 0x08; }
    if (i == 5) { return 0x10; }
    if (i == 6) { return 0x20; }
    if (i == 7) { return 0x40; }
    if (i == 8) { return 0x80; }
    if (i == 9) { return 0x1b; }
    if (i == 10) { return 0x36; }
    return 0;
}

// Rotate word: [a0,a1,a2,a3] -> [a1,a2,a3,a0]
fn RotWord(w: int64): int64 {
    var a0: int64 := (w >> 24) & 255;
    var a1: int64 := (w >> 16) & 255;
    var a2: int64 := (w >> 8) & 255;
    var a3: int64 := w & 255;
    return ((a1 << 24) | (a2 << 16) | (a3 << 8) | a0) & 0xFFFFFFFF;
}

// Convert 4-byte key to word
fn BytesToWord(b0: int64, b1: int64, b2: int64, b3: int64): int64 {
    return ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & 0xFFFFFFFF;
}

// Extract byte from word
fn WordByte(w: int64, idx: int64): int64 {
    if (idx == 0) { return (w >> 24) & 255; }
    if (idx == 1) { return (w >> 16) & 255; }
    if (idx == 2) { return (w >> 8) & 255; }
    return w & 255;
}

// Set byte in word
fn SetWordByte(w: int64, idx: int64, b: int64): int64 {
    if (idx == 0) { return (w & 0x00FFFFFF) | (b << 24); }
    if (idx == 1) { return (w & 0xFF00FFFF) | (b << 16); }
    if (idx == 2) { return (w & 0xFFFF00FF) | (b << 8); }
    return (w & 0xFFFFFF00) | b;
}

// AES-128 Key Expansion: 16 bytes -> 176 bytes (11 round keys)
// Output: 11 * 16 = 176 bytes
pub fn AES128KeyExpand(key: pchar, expanded_key: pchar): int64 {
    var i: int64 := 0;
    var j: int64 := 4;
    var round: int64 := 1;
    var b0: int64 := 0;
    var b1: int64 := 0;
    var b2: int64 := 0;
    var b3: int64 := 0;
    var prev0: int64 := 0;
    var prev1: int64 := 0;
    var prev2: int64 := 0;
    var prev3: int64 := 0;
    var w3_0: int64 := 0;
    var w3_1: int64 := 0;
    var w3_2: int64 := 0;
    var w3_3: int64 := 0;
    var t: int64 := 0;

    while (i < 4) {
        b0 := StrCharAt(key, i * 4);
        b1 := StrCharAt(key, i * 4 + 1);
        b2 := StrCharAt(key, i * 4 + 2);
        b3 := StrCharAt(key, i * 4 + 3);
        StrSetChar(expanded_key, i * 4, b0);
        StrSetChar(expanded_key, i * 4 + 1, b1);
        StrSetChar(expanded_key, i * 4 + 2, b2);
        StrSetChar(expanded_key, i * 4 + 3, b3);
        i += 1;
    }

    while (j < 44) {
        prev0 := StrCharAt(expanded_key, (j - 1) * 4);
        prev1 := StrCharAt(expanded_key, (j - 1) * 4 + 1);
        prev2 := StrCharAt(expanded_key, (j - 1) * 4 + 2);
        prev3 := StrCharAt(expanded_key, (j - 1) * 4 + 3);
        w3_0 := StrCharAt(expanded_key, (j - 4) * 4);
        w3_1 := StrCharAt(expanded_key, (j - 4) * 4 + 1);
        w3_2 := StrCharAt(expanded_key, (j - 4) * 4 + 2);
        w3_3 := StrCharAt(expanded_key, (j - 4) * 4 + 3);
        if ((j & 3) == 0) {
            // #1260: RotWord dreht nach LINKS — [a0,a1,a2,a3] -> [a1,a2,a3,a0].
            // Hier stand die Gegenrichtung; ab RK1 wich damit jeder
            // Rundenschluessel ab (FIPS-197 A.1: d6aa74fd..., erzeugt wurde
            // 77ffd5a8...). Die gleichnamige Funktion RotWord() daneben war
            // richtig, wurde hier aber nicht benutzt.
            t := prev0; prev0 := prev1; prev1 := prev2; prev2 := prev3; prev3 := t;
            prev0 := SubByte(prev0); prev1 := SubByte(prev1);
            prev2 := SubByte(prev2); prev3 := SubByte(prev3);
            prev0 := prev0 ^ Rcon(round);
            round += 1;
        }
        w3_0 := w3_0 ^ prev0; w3_1 := w3_1 ^ prev1;
        w3_2 := w3_2 ^ prev2; w3_3 := w3_3 ^ prev3;
        StrSetChar(expanded_key, j * 4, w3_0);
        StrSetChar(expanded_key, j * 4 + 1, w3_1);
        StrSetChar(expanded_key, j * 4 + 2, w3_2);
        StrSetChar(expanded_key, j * 4 + 3, w3_3);
        j += 1;
    }

    return 176;
}

// AES-256 Key Expansion: 32 bytes -> 240 bytes (15 round keys)
pub fn AES256KeyExpand(key: pchar, expanded_key: pchar): int64 {
    var i: int64 := 0;
    var j: int64 := 8;
    var round: int64 := 1;
    var b0: int64 := 0;
    var b1: int64 := 0;
    var b2: int64 := 0;
    var b3: int64 := 0;
    var prev0: int64 := 0;
    var prev1: int64 := 0;
    var prev2: int64 := 0;
    var prev3: int64 := 0;
    var w4_0: int64 := 0;
    var w4_1: int64 := 0;
    var w4_2: int64 := 0;
    var w4_3: int64 := 0;
    var t: int64 := 0;

    while (i < 8) {
        b0 := StrCharAt(key, i * 4);
        b1 := StrCharAt(key, i * 4 + 1);
        b2 := StrCharAt(key, i * 4 + 2);
        b3 := StrCharAt(key, i * 4 + 3);
        StrSetChar(expanded_key, i * 4, b0);
        StrSetChar(expanded_key, i * 4 + 1, b1);
        StrSetChar(expanded_key, i * 4 + 2, b2);
        StrSetChar(expanded_key, i * 4 + 3, b3);
        i += 1;
    }

    while (j < 60) {
        prev0 := StrCharAt(expanded_key, (j - 1) * 4);
        prev1 := StrCharAt(expanded_key, (j - 1) * 4 + 1);
        prev2 := StrCharAt(expanded_key, (j - 1) * 4 + 2);
        prev3 := StrCharAt(expanded_key, (j - 1) * 4 + 3);
        // #1260: w[i] = w[i-Nk] ^ temp. Nk ist bei AES-256 ACHT, nicht vier —
        // hier stand (j - 4), der Wert aus der AES-128-Schleife nebenan.
        w4_0 := StrCharAt(expanded_key, (j - 8) * 4);
        w4_1 := StrCharAt(expanded_key, (j - 8) * 4 + 1);
        w4_2 := StrCharAt(expanded_key, (j - 8) * 4 + 2);
        w4_3 := StrCharAt(expanded_key, (j - 8) * 4 + 3);
        if ((j & 7) == 0) {
            // #1260: RotWord dreht nach LINKS — [a0,a1,a2,a3] -> [a1,a2,a3,a0].
            // Hier stand die Gegenrichtung; ab RK1 wich damit jeder
            // Rundenschluessel ab (FIPS-197 A.1: d6aa74fd..., erzeugt wurde
            // 77ffd5a8...). Die gleichnamige Funktion RotWord() daneben war
            // richtig, wurde hier aber nicht benutzt.
            t := prev0; prev0 := prev1; prev1 := prev2; prev2 := prev3; prev3 := t;
            prev0 := SubByte(prev0); prev1 := SubByte(prev1);
            prev2 := SubByte(prev2); prev3 := SubByte(prev3);
            prev0 := prev0 ^ Rcon(round); round := round + 1;
        } else {
            if ((j & 7) == 4) {
                prev0 := SubByte(prev0); prev1 := SubByte(prev1);
                prev2 := SubByte(prev2); prev3 := SubByte(prev3);
            }
        }
        w4_0 := w4_0 ^ prev0; w4_1 := w4_1 ^ prev1;
        w4_2 := w4_2 ^ prev2; w4_3 := w4_3 ^ prev3;
        StrSetChar(expanded_key, j * 4, w4_0);
        StrSetChar(expanded_key, j * 4 + 1, w4_1);
        StrSetChar(expanded_key, j * 4 + 2, w4_2);
        StrSetChar(expanded_key, j * 4 + 3, w4_3);
        j += 1;
    }

    return 240;
}

// ============================================================================
// AddRoundKey using expanded key
// ============================================================================

fn AddRoundKey(state: pchar, expanded_key: pchar, round: int64): pchar {
    var i: int64 := 0;
    while (i < 16) {
        var b: int64 := StrCharAt(state, i);
        var k: int64 := StrCharAt(expanded_key, round * 16 + i);
        StrSetChar(state, i, b ^ k);
        i += 1;
    }
    return state;
}

// ============================================================================
// AES Block Encrypt/Decrypt (Full rounds)
// ============================================================================

pub fn AESEncryptBlockWithKey(block: pchar, expanded_key: pchar, rounds: int64): pchar {
    var state: pchar := block;
    
    // Initial round
    state := AddRoundKey(state, expanded_key, 0);
    
    // Main rounds
    var r: int64 := 1;
    while (r < rounds) {
        state := SubBytes(state);
        state := ShiftRows(state);
        state := MixColumns(state);
        state := AddRoundKey(state, expanded_key, r);
        r += 1;
    }
    
    // Final round (no MixColumns)
    state := SubBytes(state);
    state := ShiftRows(state);
    state := AddRoundKey(state, expanded_key, rounds);
    
    return block;
}

pub fn AESDecryptBlockWithKey(block: pchar, expanded_key: pchar, rounds: int64): pchar {
    var state: pchar := block;
    
    // Initial round (reverse)
    state := AddRoundKey(state, expanded_key, rounds);
    state := InvShiftRows(state);
    state := InvSubBytes(state);
    
    // Main rounds
    var r: int64 := rounds - 1;
    while (r >= 1) {
        state := AddRoundKey(state, expanded_key, r);
        state := InvMixColumns(state);
        state := InvShiftRows(state);
        state := InvSubBytes(state);
        r -= 1;
    }
    
    // Final round
    state := AddRoundKey(state, expanded_key, 0);
    
    return block;
}

// ============================================================================
// XOR Blocks
// ============================================================================

fn XORBlocks(block1: pchar, block2: pchar, dest: pchar): pchar {
    var i: int64 := 0;
    while (i < 16) {
        var b: int64 := StrCharAt(block1, i) ^ StrCharAt(block2, i);
        StrSetChar(dest, i, b);
        i += 1;
    }
    return dest;
}

// ============================================================================
// Public API: AES-CBC
// ============================================================================

pub fn AES128CBCEncrypt(key: pchar, iv: pchar, input: pchar, input_len: int64, output: pchar): int64 {
    if (input_len <= 0) { return 0; }
    
    // Expand key
    // #1260: Hier stand ein 64-Zeichen-String-LITERAL als Schreibziel. Die
    // Expansion legt 176 (AES-128) bzw. 240 Byte (AES-256) ab — 112 bzw. 176
    // Byte davon landeten in fremdem Speicher, sichtbar als Binaermuell in
    // der Ausgabe des aufrufenden Programms.
    var expanded_key: pchar := alloc(256) as pchar;
    AES128KeyExpand(key, expanded_key);
    
    // Pad input
    var padded_len: int64 := input_len;
    if ((input_len & 15) != 0) {
        var blocks128: int64 := input_len / 16;
        var blocks128p1: int64 := blocks128 + 1;
        padded_len := blocks128p1 * 16;
    } else {
        padded_len := input_len + 16;
    }

    var prev_block: pchar := alloc(32) as pchar;
    var work: pchar := alloc(32) as pchar;
    var cipher_block: pchar := alloc(32) as pchar;

    // Copy IV
    var i: int64 := 0;
    while (i < 16) {
        StrSetChar(prev_block, i, StrCharAt(iv, i));
        i += 1;
    }

    var out_pos: int64 := 0;
    var block_num: int64 := 0;
    
    while (block_num * 16 < padded_len) {
        // Create plaintext block with padding
        i := 0;
        while (i < 16) {
            var src_pos: int64 := block_num * 16 + i;
            if (src_pos < input_len) {
                StrSetChar(work, i, StrCharAt(input, src_pos));
            } else {
                StrSetChar(work, i, padded_len - input_len);
            }
            i += 1;
        }
        
        // XOR with previous ciphertext/IV
        XORBlocks(work, prev_block, work);
        
        // Encrypt
        i := 0;
        while (i < 16) {
            StrSetChar(cipher_block, i, StrCharAt(work, i));
            i += 1;
        }
        AESEncryptBlockWithKey(cipher_block, expanded_key, 10);
        
        // Copy to output
        i := 0;
        while (i < 16) {
            StrSetChar(output, out_pos + i, StrCharAt(cipher_block, i));
            i += 1;
        }
        
        // Save as previous block
        i := 0;
        while (i < 16) {
            StrSetChar(prev_block, i, StrCharAt(output, out_pos + i));
            i += 1;
        }
        
        out_pos += 16;
        block_num += 1;
    }
    
    return padded_len;
}

pub fn AES128CBCDecrypt(key: pchar, iv: pchar, input: pchar, input_len: int64, output: pchar): int64 {
    if (input_len <= 0 || (input_len & 15) != 0) { return -1; }
    
    // Expand key
    // #1260: Hier stand ein 64-Zeichen-String-LITERAL als Schreibziel. Die
    // Expansion legt 176 (AES-128) bzw. 240 Byte (AES-256) ab — 112 bzw. 176
    // Byte davon landeten in fremdem Speicher, sichtbar als Binaermuell in
    // der Ausgabe des aufrufenden Programms.
    var expanded_key: pchar := alloc(256) as pchar;
    AES128KeyExpand(key, expanded_key);
    
    var prev_block: pchar := alloc(32) as pchar;
    var work: pchar := alloc(32) as pchar;
    var plain_block: pchar := alloc(32) as pchar;
    
    // Copy IV
    var i: int64 := 0;
    while (i < 16) {
        StrSetChar(prev_block, i, StrCharAt(iv, i));
        i += 1;
    }
    
    var out_pos: int64 := 0;
    var num_blocks: int64 := input_len / 16;
    var block_num: int64 := 0;
    
    while (block_num < num_blocks) {
        // Copy cipher block
        i := 0;
        while (i < 16) {
            StrSetChar(work, i, StrCharAt(input, block_num * 16 + i));
            i += 1;
        }
        
        // Decrypt
        i := 0;
        while (i < 16) {
            StrSetChar(plain_block, i, StrCharAt(work, i));
            i += 1;
        }
        AESDecryptBlockWithKey(plain_block, expanded_key, 10);
        
        // XOR with previous cipher block
        XORBlocks(plain_block, prev_block, plain_block);
        
        // Copy to output
        i := 0;
        while (i < 16) {
            StrSetChar(output, out_pos + i, StrCharAt(plain_block, i));
            i += 1;
        }
        
        // Save current cipher block as previous
        i := 0;
        while (i < 16) {
            StrSetChar(prev_block, i, StrCharAt(input, block_num * 16 + i));
            i += 1;
        }
        
        out_pos += 16;
        block_num += 1;
    }
    
    // Remove padding
    var padding_len: int64 := StrCharAt(output, input_len - 1);
    if (padding_len > 0 && padding_len <= 16) {
        var valid: bool := true;
        i := input_len - padding_len;
        while (i < input_len) {
            if (StrCharAt(output, i) != padding_len) {
                valid := false;
            }
            i += 1;
        }
        if (valid) {
            out_pos -= padding_len;
        }
    }
    
    return out_pos;
}

// AES-256
pub fn AES256CBCEncrypt(key: pchar, iv: pchar, input: pchar, input_len: int64, output: pchar): int64 {
    if (input_len <= 0) { return 0; }
    
    // Expand key
    // #1260: Hier stand ein 64-Zeichen-String-LITERAL als Schreibziel. Die
    // Expansion legt 176 (AES-128) bzw. 240 Byte (AES-256) ab — 112 bzw. 176
    // Byte davon landeten in fremdem Speicher, sichtbar als Binaermuell in
    // der Ausgabe des aufrufenden Programms.
    var expanded_key: pchar := alloc(256) as pchar;
    AES256KeyExpand(key, expanded_key);
    
    var padded_len: int64 := input_len;
    if ((input_len & 15) != 0) {
        var blocks256: int64 := input_len / 16;
        var blocks256p1: int64 := blocks256 + 1;
        padded_len := blocks256p1 * 16;
    } else {
        padded_len := input_len + 16;
    }

    var prev_block: pchar := alloc(32) as pchar;
    var work: pchar := alloc(32) as pchar;
    var cipher_block: pchar := alloc(32) as pchar;

    var i: int64 := 0;
    while (i < 16) {
        StrSetChar(prev_block, i, StrCharAt(iv, i));
        i += 1;
    }
    
    var out_pos: int64 := 0;
    var block_num: int64 := 0;
    
    while (block_num * 16 < padded_len) {
        i := 0;
        while (i < 16) {
            var src_pos: int64 := block_num * 16 + i;
            if (src_pos < input_len) {
                StrSetChar(work, i, StrCharAt(input, src_pos));
            } else {
                StrSetChar(work, i, padded_len - input_len);
            }
            i += 1;
        }
        
        XORBlocks(work, prev_block, work);
        
        i := 0;
        while (i < 16) {
            StrSetChar(cipher_block, i, StrCharAt(work, i));
            i += 1;
        }
        AESEncryptBlockWithKey(cipher_block, expanded_key, 14);
        
        i := 0;
        while (i < 16) {
            StrSetChar(output, out_pos + i, StrCharAt(cipher_block, i));
            i += 1;
        }
        
        i := 0;
        while (i < 16) {
            StrSetChar(prev_block, i, StrCharAt(output, out_pos + i));
            i += 1;
        }
        
        out_pos += 16;
        block_num += 1;
    }
    
    return padded_len;
}

pub fn AES256CBCDecrypt(key: pchar, iv: pchar, input: pchar, input_len: int64, output: pchar): int64 {
    if (input_len <= 0 || (input_len & 15) != 0) { return -1; }
    
    // Expand key
    // #1260: Hier stand ein 64-Zeichen-String-LITERAL als Schreibziel. Die
    // Expansion legt 176 (AES-128) bzw. 240 Byte (AES-256) ab — 112 bzw. 176
    // Byte davon landeten in fremdem Speicher, sichtbar als Binaermuell in
    // der Ausgabe des aufrufenden Programms.
    var expanded_key: pchar := alloc(256) as pchar;
    AES256KeyExpand(key, expanded_key);
    
    var prev_block: pchar := alloc(32) as pchar;
    var work: pchar := alloc(32) as pchar;
    var plain_block: pchar := alloc(32) as pchar;
    
    var i: int64 := 0;
    while (i < 16) {
        StrSetChar(prev_block, i, StrCharAt(iv, i));
        i += 1;
    }
    
    var out_pos: int64 := 0;
    var num_blocks: int64 := input_len / 16;
    var block_num: int64 := 0;
    
    while (block_num < num_blocks) {
        i := 0;
        while (i < 16) {
            StrSetChar(work, i, StrCharAt(input, block_num * 16 + i));
            i += 1;
        }
        
        i := 0;
        while (i < 16) {
            StrSetChar(plain_block, i, StrCharAt(work, i));
            i += 1;
        }
        AESDecryptBlockWithKey(plain_block, expanded_key, 14);
        
        XORBlocks(plain_block, prev_block, plain_block);
        
        i := 0;
        while (i < 16) {
            StrSetChar(output, out_pos + i, StrCharAt(plain_block, i));
            i += 1;
        }
        
        i := 0;
        while (i < 16) {
            StrSetChar(prev_block, i, StrCharAt(input, block_num * 16 + i));
            i += 1;
        }
        
        out_pos += 16;
        block_num += 1;
    }
    
    var padding_len: int64 := StrCharAt(output, input_len - 1);
    if (padding_len > 0 && padding_len <= 16) {
        var valid: bool := true;
        i := input_len - padding_len;
        while (i < input_len) {
            if (StrCharAt(output, i) != padding_len) {
                valid := false;
            }
            i += 1;
        }
        if (valid) {
            out_pos -= padding_len;
        }
    }
    
    return out_pos;
}

// ============================================================================
// Utility Functions
// ============================================================================

pub fn AESEncryptOutputSize(input_len: int64): int64 {
    if ((input_len & 15) == 0) { return input_len + 16; }
    var blocks_out: int64 := input_len / 16;
    var blocks_out1: int64 := blocks_out + 1;
    return blocks_out1 * 16;
}

pub fn AESDecryptOutputSize(input_len: int64): int64 {
    return input_len;
}

// ============================================================================
// int64-based AES-256 primitives for CTR mode (peek8/poke8, PQC-stack style)
// ============================================================================

fn aes256_subrow(st: int64) {
  var i: int64 := 0;
  while (i < 16) { poke8(st+i, SubByte(peek8(st+i))); i := i+1; }
}

fn aes256_shiftrow(st: int64) {
  var t1: int64 := peek8(st+1);
  var t2a: int64 := peek8(st+2);
  var t2b: int64 := peek8(st+6);
  var t3: int64 := peek8(st+15);
  poke8(st+1, peek8(st+5)); poke8(st+5, peek8(st+9));
  poke8(st+9, peek8(st+13)); poke8(st+13, t1);
  poke8(st+2, peek8(st+10)); poke8(st+6, peek8(st+14));
  poke8(st+10, t2a); poke8(st+14, t2b);
  poke8(st+15, peek8(st+11)); poke8(st+11, peek8(st+7));
  poke8(st+7, peek8(st+3)); poke8(st+3, t3);
}

fn aes256_mixcol(st: int64) {
  var i: int64 := 0;
  var s0: int64 := 0;
  var s1: int64 := 0;
  var s2: int64 := 0;
  var s3: int64 := 0;
  var idx: int64 := 0;
  while (i < 4) {
    idx := i*4;
    s0 := peek8(st+idx); s1 := peek8(st+idx+1);
    s2 := peek8(st+idx+2); s3 := peek8(st+idx+3);
    poke8(st+idx,   xtime(s0)^times3(s1)^s2^s3);
    poke8(st+idx+1, s0^xtime(s1)^times3(s2)^s3);
    poke8(st+idx+2, s0^s1^xtime(s2)^times3(s3));
    poke8(st+idx+3, times3(s0)^s1^s2^xtime(s3));
    i := i+1;
  }
}

fn aes256_addrk(st: int64, rk: int64, rnd: int64) {
  var i: int64 := 0;
  while (i < 16) { poke8(st+i, peek8(st+i)^peek8(rk+rnd*16+i)); i := i+1; }
}

fn aes256_keyexp(key: int64, rk: int64) {
  var i: int64 := 0;
  var j: int64 := 8;
  var round: int64 := 1;
  var p0: int64 := 0;
  var p1: int64 := 0;
  var p2: int64 := 0;
  var p3: int64 := 0;
  var w0: int64 := 0;
  var w1: int64 := 0;
  var w2: int64 := 0;
  var w3: int64 := 0;
  var t: int64 := 0;
  while (i < 32) { poke8(rk+i, peek8(key+i)); i := i+1; }
  while (j < 60) {
    p0 := peek8(rk+(j-1)*4);   p1 := peek8(rk+(j-1)*4+1);
    p2 := peek8(rk+(j-1)*4+2); p3 := peek8(rk+(j-1)*4+3);
    w0 := peek8(rk+(j-8)*4);   w1 := peek8(rk+(j-8)*4+1);
    w2 := peek8(rk+(j-8)*4+2); w3 := peek8(rk+(j-8)*4+3);
    if ((j & 7) == 0) {
      t := p0; p0 := p1; p1 := p2; p2 := p3; p3 := t;
      p0 := SubByte(p0); p1 := SubByte(p1);
      p2 := SubByte(p2); p3 := SubByte(p3);
      p0 := p0 ^ Rcon(round); round := round+1;
    } else {
      if ((j & 7) == 4) {
        p0 := SubByte(p0); p1 := SubByte(p1);
        p2 := SubByte(p2); p3 := SubByte(p3);
      }
    }
    poke8(rk+j*4,   w0^p0); poke8(rk+j*4+1, w1^p1);
    poke8(rk+j*4+2, w2^p2); poke8(rk+j*4+3, w3^p3);
    j := j+1;
  }
}

fn aes256_enc(st: int64, rk: int64) {
  var r: int64 := 1;
  aes256_addrk(st, rk, 0);
  while (r < 14) {
    aes256_subrow(st); aes256_shiftrow(st); aes256_mixcol(st);
    aes256_addrk(st, rk, r);
    r := r+1;
  }
  aes256_subrow(st); aes256_shiftrow(st); aes256_addrk(st, rk, 14);
}

// 128-bit big-endian counter increment (NIST CTR_DRBG SP 800-90A)
fn ctr_inc(ctr: int64) {
  var i: int64 := 15;
  var carry: int64 := 1;
  var b: int64 := 0;
  while (carry == 1 && i >= 0) {
    b := (peek8(ctr+i) & 0xFF) + 1;
    poke8(ctr+i, b & 0xFF);
    if (b > 255) { carry := 1; } else { carry := 0; }
    i := i-1;
  }
}

// NIST CTR_DRBG internal update: generate 3 blocks, XOR with provided (48 B), update Key+V
fn aes256_ctr_drbg_update(state: int64, provided: int64) {
  var rk: int64 := state+32;
  var v: int64 := state+272;
  var tmp: int64 := alloc(48);
  var blk: int64 := alloc(16);
  var bi: int64 := 0;
  var i: int64 := 0;
  var j: int64 := 0;
  while (bi < 3) {
    ctr_inc(v);
    i := 0; while (i < 16) { poke8(blk+i, peek8(v+i)); i := i+1; }
    aes256_enc(blk, rk);
    i := 0; while (i < 16) { poke8(tmp+bi*16+i, peek8(blk+i)); i := i+1; }
    bi := bi+1;
  }
  while (j < 48) { poke8(tmp+j, peek8(tmp+j)^peek8(provided+j)); j := j+1; }
  j := 0; while (j < 32) { poke8(state+j, peek8(tmp+j)); j := j+1; }
  j := 0; while (j < 16) { poke8(v+j, peek8(tmp+32+j)); j := j+1; }
  aes256_keyexp(state, rk);
  free(blk, 16);
  free(tmp, 48);
}

// ============================================================================
// Public API: AES-256-CTR stream cipher
// ============================================================================

// Encrypt/decrypt ibuf[0..inLen-1] → out via AES-256-CTR.
// key: 32 B, iv: 16-byte big-endian counter (used as-is for block 0).
pub fn AES256CTR(key: int64, iv: int64, ibuf: int64, inLen: int64, out: int64) {
  var rk: int64 := alloc(240);
  var ctr: int64 := alloc(16);
  var blk: int64 := alloc(16);
  var i: int64 := 0;
  var pos: int64 := 0;
  var rem: int64 := 0;
  aes256_keyexp(key, rk);
  while (i < 16) { poke8(ctr+i, peek8(iv+i)); i := i+1; }
  while (pos < inLen) {
    i := 0; while (i < 16) { poke8(blk+i, peek8(ctr+i)); i := i+1; }
    aes256_enc(blk, rk);
    rem := inLen - pos;
    if (rem > 16) { rem := 16; }
    i := 0;
    while (i < rem) { poke8(out+pos+i, peek8(ibuf+pos+i)^peek8(blk+i)); i := i+1; }
    pos := pos+rem;
    ctr_inc(ctr);
  }
  free(blk, 16); free(ctr, 16); free(rk, 240);
}

// ============================================================================
// Public API: AES-256-CTR DRBG (NIST SP 800-90A, no derivation function)
// State layout: [0..31] raw key | [32..271] expanded key | [272..287] V
// ============================================================================

pub con AES256CTR_STATE_SIZE: int64 := 288;

// Init from 48-byte seed.  Key = seed[0..31], V (before update) = seed[32..47].
pub fn AES256CTRDRBGInit(state: int64, seed: int64) {
  var i: int64 := 0;
  while (i < 288) { poke8(state+i, 0); i := i+1; }
  aes256_keyexp(state, state+32);
  aes256_ctr_drbg_update(state, seed);
}

// Generate len pseudo-random bytes; re-seeds state with zeros afterward (NIST CTR_DRBG).
pub fn AES256CTRDRBGGenerate(state: int64, out: int64, len: int64) {
  var rk: int64 := state+32;
  var v: int64 := state+272;
  var blk: int64 := alloc(16);
  var zeros: int64 := alloc(48);
  var pos: int64 := 0;
  var rem: int64 := 0;
  var i: int64 := 0;
  while (i < 48) { poke8(zeros+i, 0); i := i+1; }
  while (pos < len) {
    ctr_inc(v);
    i := 0; while (i < 16) { poke8(blk+i, peek8(v+i)); i := i+1; }
    aes256_enc(blk, rk);
    rem := len - pos;
    if (rem > 16) { rem := 16; }
    i := 0;
    while (i < rem) { poke8(out+pos+i, peek8(blk+i)); i := i+1; }
    pos := pos+rem;
  }
  aes256_ctr_drbg_update(state, zeros);
  free(zeros, 48); free(blk, 16);
}

