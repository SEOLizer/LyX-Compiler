// std/crypto/hmac.lyx — HMAC-SHA256 (RFC 2104 / FIPS 198-1)
//
// Public API:
//   HMAC_SHA256(key, keyLen, data, dataLen, out)
//       Writes 32-byte MAC into out.
//
//   HMAC_SHA256_Hex(key, keyLen, data, dataLen, out)
//       Writes 64-char lowercase hex + NUL (65 bytes) into out.

unit std.crypto.hmac;

import std.alloc;
import std.crypto.sha256;

pub fn HMAC_SHA256(key: int64, keyLen: int64, data: int64, dataLen: int64, out: int64): void {
    // K' = key padded / hashed to 64 bytes (SHA256 block size)
    var kprime: int64 := alloc(64);
    var i: int64 := 0;
    while (i < 64) { poke8(kprime + i, 0); i := i + 1; }

    if (keyLen > 64) {
        // Key longer than block size: K' = SHA256(key)
        SHA256(key, keyLen, kprime);
    } else {
        i := 0;
        while (i < keyLen) { poke8(kprime + i, peek8(key + i)); i := i + 1; }
    }

    // inner = SHA256((K' XOR ipad) || data)
    // Allocate 64 + dataLen bytes for the inner message
    var innerBuf: int64 := alloc(64 + dataLen + 1);  // +1 to avoid zero-size alloc
    i := 0;
    while (i < 64) { poke8(innerBuf + i, peek8(kprime + i) ^ 0x36); i := i + 1; }
    i := 0;
    while (i < dataLen) { poke8(innerBuf + 64 + i, peek8(data + i)); i := i + 1; }
    var inner: int64 := alloc(32);
    SHA256(innerBuf, 64 + dataLen, inner);
    free(innerBuf, 64 + dataLen + 1);

    // outer = SHA256((K' XOR opad) || inner)
    var outerBuf: int64 := alloc(96);  // 64 + 32
    i := 0;
    while (i < 64) { poke8(outerBuf + i, peek8(kprime + i) ^ 0x5C); i := i + 1; }
    i := 0;
    while (i < 32) { poke8(outerBuf + 64 + i, peek8(inner + i)); i := i + 1; }
    SHA256(outerBuf, 96, out);

    free(kprime, 64);
    free(inner, 32);
    free(outerBuf, 96);
}

pub fn HMAC_SHA256_Hex(key: int64, keyLen: int64, data: int64, dataLen: int64, out: int64): void {
    var digest: int64 := alloc(32);
    HMAC_SHA256(key, keyLen, data, dataLen, digest);
    var hex: pchar := "0123456789abcdef";
    var i: int64 := 0;
    while (i < 32) {
        var b: int64 := peek8(digest + i) & 0xFF;
        poke8(out + i * 2,     peek8(hex as int64 + (b >> 4)));
        poke8(out + i * 2 + 1, peek8(hex as int64 + (b & 15)));
        i := i + 1;
    }
    poke8(out + 64, 0);
    free(digest, 32);
}
