// std/crypto/aesgcm.lyx — AES-GCM (NIST SP 800-38D) fuer AES-128 und AES-256
//
// Teil von #2096 (natives TLS ohne OpenSSL): TLS_AES_128_GCM_SHA256 ist in
// RFC 8446 Pflicht, TLS_AES_256_GCM_SHA384 ist gefordert. std/crypto/aes.lyx
// hatte nur CBC und CTR — ein AEAD fehlte ganz.
//
// Oeffentliche API:
//   AesGcmSeal(key, keyLen, nonce, nonceLen, aad, aadLen,
//              pt, ptLen, ct, tag, tagLen): bool
//   AesGcmOpen(key, keyLen, nonce, nonceLen, aad, aadLen,
//              ct, ctLen, tag, tagLen, pt): bool
//   AesGcmGhash(h, data, len, out)         — GHASH einzeln (fuer Pruefvektoren)
//
// keyLen ist 16 oder 32; ein anderer Wert wird abgewiesen (false), nicht
// still auf 16 gerundet. tagLen ist 1..16, TLS nutzt 16.
// AesGcmOpen vergleicht das Tag ohne Datenabhaengigkeit der Laufzeit
// (CTMemEqual) und schreibt bei falschem Tag KEINEN Klartext nach aussen.
//
// Die GF(2^128)-Multiplikation laeuft bitweise ueber 128 Runden mit Masken
// statt Verzweigungen — H ist geheim, ein Sprung auf einem H-Bit waere ein
// Seitenkanal. Tabellenverfahren (4-Bit-Fenster) waeren schneller, aber die
// Tabelle haengt an H und wird ueber den Cache beobachtbar.

unit std.crypto.aesgcm;

import std.alloc;
import std.crypto.aes;
import std.crypto.ct;

// ---------------------------------------------------------------------------
// AES-Kern: Schluesselplan und Blockverschluesselung auf Rohspeicher
//
// std/crypto/aes.lyx rechnet dieselbe Runde auf `pchar` (AES128KeyExpand,
// AESEncryptBlockWithKey) und einmal auf Rohspeicher fuer AES-256-CTR
// (aes256_keyexp/aes256_enc, unit-privat). Hier steht sie fuer beide
// Schluessellaengen auf Rohspeicher; S-Box und GF-Multiplikation kommen aus
// std.crypto.aes (SubByte, GF_mul), damit die Tabellen nicht ein drittes Mal
// im Baum liegen. Wer eine der Stellen aendert, muss die anderen nachziehen.
// ---------------------------------------------------------------------------

// S-Box und Rundenkonstanten entstehen EINMAL je Programmlauf.
//
// Gemessen (1.2.31B, i5-8250U): ohne Tabelle lief AES-128-GCM mit 17 KB/s —
// SubByte aus std/crypto/aes.lyx sucht das Inverse in GF(2^8) durch Probieren
// (bis zu 256 GF_mul je Aufruf, jedes selbst eine Achterschleife), also rund
// zweitausend Operationen je Zustandsbyte. Mit Tabelle sind es zwei Zugriffe.
//
// Preis: ein Tabellenzugriff haengt am Datum, die Zugriffsfolge ist also
// ueber den Cache beobachtbar (T-Table-Angriffe). Die Tabelle ist 256 Byte
// gross und damit klein genug, dass ein Angreifer nur wenige Cachezeilen
// unterscheiden kann — ein echter Gegenentwurf ist eine bitgeschnittene
// Umsetzung oder AES-NI. Beides ist als eigener Schritt gefuehrt, nicht hier
// halb angefangen; GHASH bleibt sprungfrei und tabellenlos.
var _gcmSbox: int64 := 0;

fn gcmTables(): int64 {
    if (_gcmSbox != 0) { return _gcmSbox; }
    var sb: int64 := alloc(256);
    if (sb == 0) { return 0; }
    var i: int64 := 0;
    while (i < 256) { poke8(sb + i, SubByte(i)); i := i + 1; }
    _gcmSbox := sb;
    return sb;
}

fn gcmSub(x: int64): int64 {
    return peek8(_gcmSbox + (x & 255));
}

// Rundenkonstante: x^(i-1) in GF(2^8), i ab 1.
fn gcmRcon(i: int64): int64 {
    var v: int64 := 1;
    var n: int64 := 1;
    while (n < i) {
        v := (v * 2) & 255;
        if (v == 0) { v := 0x1b; }
        if ((v & 0x100) != 0) { v := (v ^ 0x11b) & 255; }
        n += 1;
    }
    return v;
}

// Erweitert key (keyLen 16 oder 32) nach rk; liefert die Rundenzahl
// (10 bzw. 14) oder 0 bei ungueltiger Laenge.
// rk braucht (rounds + 1) * 16 Byte, also 176 bzw. 240.
fn gcmKeyExpand(key: int64, keyLen: int64, rk: int64): int64 {
    if (keyLen != 16 && keyLen != 32) { return 0; }
    if (gcmTables() == 0) { panic("AES-GCM: kein Speicher fuer die S-Box"); }
    var nk: int64 := keyLen / 4;             // 4 oder 8 Woerter
    var rounds: int64 := nk + 6;             // 10 oder 14
    var total: int64 := (rounds + 1) * 4;    // Woerter im Schluesselplan

    var i: int64 := 0;
    while (i < keyLen) { poke8(rk + i, peek8(key + i)); i := i + 1; }

    var rcon: int64 := 1;
    var j: int64 := nk;
    while (j < total) {
        var t0: int64 := peek8(rk + (j - 1) * 4);
        var t1: int64 := peek8(rk + (j - 1) * 4 + 1);
        var t2: int64 := peek8(rk + (j - 1) * 4 + 2);
        var t3: int64 := peek8(rk + (j - 1) * 4 + 3);
        if (j % nk == 0) {
            var t: int64 := t0;
            t0 := gcmSub(t1) ^ gcmRcon(rcon);
            rcon := rcon + 1;
            var s2: int64 := gcmSub(t2);
            var s3: int64 := gcmSub(t3);
            t1 := s2;
            t2 := s3;
            t3 := gcmSub(t);
        } else {
            if (nk == 8 && j % nk == 4) {
                t0 := gcmSub(t0); t1 := gcmSub(t1);
                t2 := gcmSub(t2); t3 := gcmSub(t3);
            }
        }
        poke8(rk + j * 4,     peek8(rk + (j - nk) * 4)     ^ t0);
        poke8(rk + j * 4 + 1, peek8(rk + (j - nk) * 4 + 1) ^ t1);
        poke8(rk + j * 4 + 2, peek8(rk + (j - nk) * 4 + 2) ^ t2);
        poke8(rk + j * 4 + 3, peek8(rk + (j - nk) * 4 + 3) ^ t3);
        j += 1;
    }
    return rounds;
}

fn gcmAddRoundKey(st: int64, rk: int64, rnd: int64): void {
    var i: int64 := 0;
    while (i < 16) {
        poke8(st + i, peek8(st + i) ^ peek8(rk + rnd * 16 + i));
        i += 1;
    }
}

fn gcmSubBytes(st: int64): void {
    var i: int64 := 0;
    while (i < 16) { poke8(st + i, peek8(_gcmSbox + peek8(st + i))); i := i + 1; }
}

// Verdoppelung in GF(2^8) — zwei Befehle statt eines GF_mul-Aufrufs mit
// Achterschleife.
fn gcmXtime(x: int64): int64 {
    var v: int64 := (x * 2) & 255;
    if ((x & 0x80) != 0) { v := v ^ 0x1b; }
    return v;
}

// Zeilen 1..3 nach links rotieren; der Zustand liegt spaltenweise
// (st[r + 4*c] ist Zeile r, Spalte c).
fn gcmShiftRows(st: int64): void {
    var t: int64 := peek8(st + 1);
    poke8(st + 1, peek8(st + 5)); poke8(st + 5, peek8(st + 9));
    poke8(st + 9, peek8(st + 13)); poke8(st + 13, t);

    t := peek8(st + 2);
    poke8(st + 2, peek8(st + 10)); poke8(st + 10, t);
    t := peek8(st + 6);
    poke8(st + 6, peek8(st + 14)); poke8(st + 14, t);

    t := peek8(st + 15);
    poke8(st + 15, peek8(st + 11)); poke8(st + 11, peek8(st + 7));
    poke8(st + 7, peek8(st + 3)); poke8(st + 3, t);
}

fn gcmMixColumns(st: int64): void {
    var c: int64 := 0;
    while (c < 4) {
        var a0: int64 := peek8(st + c * 4);
        var a1: int64 := peek8(st + c * 4 + 1);
        var a2: int64 := peek8(st + c * 4 + 2);
        var a3: int64 := peek8(st + c * 4 + 3);
        var x0: int64 := gcmXtime(a0);
        var x1: int64 := gcmXtime(a1);
        var x2: int64 := gcmXtime(a2);
        var x3: int64 := gcmXtime(a3);
        poke8(st + c * 4,     x0 ^ (x1 ^ a1) ^ a2 ^ a3);
        poke8(st + c * 4 + 1, a0 ^ x1 ^ (x2 ^ a2) ^ a3);
        poke8(st + c * 4 + 2, a0 ^ a1 ^ x2 ^ (x3 ^ a3));
        poke8(st + c * 4 + 3, (x0 ^ a0) ^ a1 ^ a2 ^ x3);
        c += 1;
    }
}

// Verschluesselt den 16-Byte-Block st an seinem Platz.
fn gcmEncBlock(st: int64, rk: int64, rounds: int64): void {
    gcmAddRoundKey(st, rk, 0);
    var r: int64 := 1;
    while (r < rounds) {
        gcmSubBytes(st);
        gcmShiftRows(st);
        gcmMixColumns(st);
        gcmAddRoundKey(st, rk, r);
        r += 1;
    }
    gcmSubBytes(st);
    gcmShiftRows(st);
    gcmAddRoundKey(st, rk, rounds);
}

// ---------------------------------------------------------------------------
// GHASH (SP 800-38D §6.4)
//
// Ein Block ist ein Polynom in GF(2^128); Bit 0 des ersten Byte ist der
// hoechste Koeffizient. Als Zahlenpaar: hi = Byte 0..7, lo = Byte 8..15,
// jeweils big-endian. Das Reduktionspolynom ist x^128 + x^7 + x^2 + x + 1,
// nach der Bitordnung also 0xe1 im obersten Byte.
// ---------------------------------------------------------------------------

fn gcmLoadBE(p: int64): int64 {
    return (peek8(p)     << 56) | (peek8(p + 1) << 48)
         | (peek8(p + 2) << 40) | (peek8(p + 3) << 32)
         | (peek8(p + 4) << 24) | (peek8(p + 5) << 16)
         | (peek8(p + 6) <<  8) |  peek8(p + 7);
}

fn gcmStoreBE(p: int64, v: int64): void {
    var i: int64 := 0;
    while (i < 8) {
        poke8(p + i, ((v as uint64) >> (56 - i * 8)) & 0xFF);
        i += 1;
    }
}

// Z := Z * H in GF(2^128). zbuf haelt Z (16 Byte), hbuf H (16 Byte).
// Bitweise mit Masken statt Spruengen: H ist geheim.
fn gcmMul(zbuf: int64, hbuf: int64): void {
    var xhi: int64 := gcmLoadBE(zbuf);
    var xlo: int64 := gcmLoadBE(zbuf + 8);
    var vhi: int64 := gcmLoadBE(hbuf);
    var vlo: int64 := gcmLoadBE(hbuf + 8);
    var zhi: int64 := 0;
    var zlo: int64 := 0;

    var i: int64 := 0;
    while (i < 128) {
        // Bit i von X, von oben nach unten gezaehlt.
        var bit: int64 := 0;
        if (i < 64) {
            bit := ((xhi as uint64) >> (63 - i)) & 1;
        } else {
            bit := ((xlo as uint64) >> (127 - i)) & 1;
        }
        var m: int64 := 0 - bit;            // 0 oder alle Bits gesetzt
        zhi := zhi ^ (vhi & m);
        zlo := zlo ^ (vlo & m);

        // V := V >> 1, bei gesetztem untersten Bit zusaetzlich ^ R.
        var lsb: int64 := vlo & 1;
        vlo := (((vlo as uint64) >> 1) | (vhi << 63));
        vhi := ((vhi as uint64) >> 1);
        var rm: int64 := 0 - lsb;
        vhi := vhi ^ (0xe100000000000000 & rm);

        i += 1;
    }

    gcmStoreBE(zbuf, zhi);
    gcmStoreBE(zbuf + 8, zlo);
}

// Z := (Z ^ block) * H, block hat blockLen <= 16 Byte und wird rechts mit
// Nullen aufgefuellt (SP 800-38D §6.4, Schritt 2).
fn gcmGhashBlock(zbuf: int64, hbuf: int64, block: int64, blockLen: int64): void {
    var i: int64 := 0;
    while (i < blockLen) {
        poke8(zbuf + i, peek8(zbuf + i) ^ peek8(block + i));
        i += 1;
    }
    gcmMul(zbuf, hbuf);
}

fn gcmGhashData(zbuf: int64, hbuf: int64, data: int64, len: int64): void {
    var pos: int64 := 0;
    while (pos + 16 <= len) {
        gcmGhashBlock(zbuf, hbuf, data + pos, 16);
        pos += 16;
    }
    if (pos < len) {
        gcmGhashBlock(zbuf, hbuf, data + pos, len - pos);
    }
}

// GHASH_H(data) nach out (16 Byte) — fuer Pruefvektoren aus dem Standard.
pub fn AesGcmGhash(h: int64, data: int64, len: int64, out: int64): void {
    var i: int64 := 0;
    while (i < 16) { poke8(out + i, 0); i := i + 1; }
    gcmGhashData(out, h, data, len);
}

// ---------------------------------------------------------------------------
// GCTR und der gemeinsame Kern von Seal/Open
// ---------------------------------------------------------------------------

// 32-Bit-Zaehler in den letzten vier Byte von ctrBlk erhoehen (mod 2^32).
fn gcmInc32(ctrBlk: int64): void {
    var c: int64 := ((peek8(ctrBlk + 12) << 24) | (peek8(ctrBlk + 13) << 16)
                   | (peek8(ctrBlk + 14) <<  8) |  peek8(ctrBlk + 15)) & 0xFFFFFFFF;
    c := (c + 1) & 0xFFFFFFFF;
    poke8(ctrBlk + 12, (c >> 24) & 0xFF);
    poke8(ctrBlk + 13, (c >> 16) & 0xFF);
    poke8(ctrBlk + 14, (c >>  8) & 0xFF);
    poke8(ctrBlk + 15,  c        & 0xFF);
}

// out := in ^ AES_K(CB), CB ab icb hochgezaehlt. in und out duerfen derselbe
// Puffer sein.
fn gcmCtr(rk: int64, rounds: int64, icb: int64,
          ibuf: int64, len: int64, out: int64): void {
    var cb: int64 := alloc(16);
    var ks: int64 := alloc(16);
    if (cb == 0 || ks == 0) { panic("AES-GCM: kein Speicher fuer den Zaehlerblock"); }
    var i: int64 := 0;
    while (i < 16) { poke8(cb + i, peek8(icb + i)); i := i + 1; }

    var pos: int64 := 0;
    while (pos < len) {
        i := 0;
        while (i < 16) { poke8(ks + i, peek8(cb + i)); i := i + 1; }
        gcmEncBlock(ks, rk, rounds);
        var take: int64 := 16;
        if (len - pos < take) { take := len - pos; }
        i := 0;
        while (i < take) {
            poke8(out + pos + i, peek8(ibuf + pos + i) ^ peek8(ks + i));
            i += 1;
        }
        pos += take;
        gcmInc32(cb);
    }

    SecureZero(ks, 16);
    free(ks, 16);
    free(cb, 16);
}

// Laengenblock: 64 Bit AAD-Bitlaenge | 64 Bit Ciphertext-Bitlaenge.
fn gcmLenBlock(buf: int64, aadLen: int64, ctLen: int64): void {
    gcmStoreBE(buf, aadLen * 8);
    gcmStoreBE(buf + 8, ctLen * 8);
}

// J0 nach SP 800-38D §7.1: bei 12-Byte-Nonce IV|0^31|1, sonst
// GHASH_H(IV || 0^s || len64(IV)).
fn gcmComputeJ0(h: int64, nonce: int64, nonceLen: int64, j0: int64): void {
    var i: int64 := 0;
    if (nonceLen == 12) {
        while (i < 12) { poke8(j0 + i, peek8(nonce + i)); i := i + 1; }
        poke8(j0 + 12, 0); poke8(j0 + 13, 0); poke8(j0 + 14, 0); poke8(j0 + 15, 1);
        return;
    }
    while (i < 16) { poke8(j0 + i, 0); i := i + 1; }
    gcmGhashData(j0, h, nonce, nonceLen);
    var lb: int64 := alloc(16);
    if (lb == 0) { panic("AES-GCM: kein Speicher fuer den Laengenblock"); }
    gcmStoreBE(lb, 0);
    gcmStoreBE(lb + 8, nonceLen * 8);
    gcmGhashBlock(j0, h, lb, 16);
    free(lb, 16);
}

// Rechnet H, J0 und das Tag ueber (aad, ct). tagOut nimmt 16 Byte auf.
fn gcmPrepare(key: int64, keyLen: int64, nonce: int64, nonceLen: int64,
              rkOut: int64, j0Out: int64, hOut: int64): int64 {
    var rounds: int64 := gcmKeyExpand(key, keyLen, rkOut);
    if (rounds == 0) { return 0; }
    var i: int64 := 0;
    while (i < 16) { poke8(hOut + i, 0); i := i + 1; }
    gcmEncBlock(hOut, rkOut, rounds);           // H = AES_K(0^128)
    gcmComputeJ0(hOut, nonce, nonceLen, j0Out);
    return rounds;
}

fn gcmTag(rk: int64, rounds: int64, h: int64, j0: int64,
          aad: int64, aadLen: int64, ct: int64, ctLen: int64,
          tagOut: int64): void {
    var s: int64 := alloc(16);
    var lb: int64 := alloc(16);
    if (s == 0 || lb == 0) { panic("AES-GCM: kein Speicher fuer das Tag"); }
    var i: int64 := 0;
    while (i < 16) { poke8(s + i, 0); i := i + 1; }
    if (aadLen > 0) { gcmGhashData(s, h, aad, aadLen); }
    if (ctLen > 0)  { gcmGhashData(s, h, ct, ctLen); }
    gcmLenBlock(lb, aadLen, ctLen);
    gcmGhashBlock(s, h, lb, 16);
    gcmCtr(rk, rounds, j0, s, 16, tagOut);      // GCTR_K(J0, S)
    SecureZero(s, 16);
    free(s, 16);
    free(lb, 16);
}

// ---------------------------------------------------------------------------
// Oeffentliche API
// ---------------------------------------------------------------------------

// Verschluesselt pt nach ct (ptLen Byte) und schreibt tagLen Tagbyte nach tag.
// ct darf derselbe Puffer wie pt sein. Liefert false bei ungueltigen Laengen.
pub fn AesGcmSeal(key: int64, keyLen: int64, nonce: int64, nonceLen: int64,
                  aad: int64, aadLen: int64,
                  pt: int64, ptLen: int64, ct: int64,
                  tag: int64, tagLen: int64): bool {
    if (keyLen != 16 && keyLen != 32) { return false; }
    if (nonceLen <= 0) { return false; }
    if (ptLen < 0 || aadLen < 0) { return false; }
    if (tagLen <= 0 || tagLen > 16) { return false; }

    var rkSize: int64 := 240;
    var rk: int64 := alloc(rkSize);
    var j0: int64 := alloc(16);
    var h: int64 := alloc(16);
    var t: int64 := alloc(16);
    if (rk == 0 || j0 == 0 || h == 0 || t == 0) { panic("AES-GCM: kein Speicher"); }

    var rounds: int64 := gcmPrepare(key, keyLen, nonce, nonceLen, rk, j0, h);
    if (rounds == 0) {
        free(rk, rkSize); free(j0, 16); free(h, 16); free(t, 16);
        return false;
    }

    // Der Klartext wird ab Zaehlerblock J0+1 verschluesselt (§7.2 Schritt 3).
    var cb: int64 := alloc(16);
    if (cb == 0) { panic("AES-GCM: kein Speicher fuer den Zaehlerblock"); }
    var i: int64 := 0;
    while (i < 16) { poke8(cb + i, peek8(j0 + i)); i := i + 1; }
    gcmInc32(cb);
    if (ptLen > 0) { gcmCtr(rk, rounds, cb, pt, ptLen, ct); }

    gcmTag(rk, rounds, h, j0, aad, aadLen, ct, ptLen, t);
    i := 0;
    while (i < tagLen) { poke8(tag + i, peek8(t + i)); i := i + 1; }

    SecureZero(rk, rkSize);
    SecureZero(h, 16);
    free(cb, 16); free(rk, rkSize); free(j0, 16); free(h, 16); free(t, 16);
    return true;
}

// Prueft das Tag und entschluesselt ct nach pt (ctLen Byte). pt darf derselbe
// Puffer wie ct sein. Liefert false bei falschem Tag oder ungueltigen Laengen
// — und schreibt dann nichts nach pt.
pub fn AesGcmOpen(key: int64, keyLen: int64, nonce: int64, nonceLen: int64,
                  aad: int64, aadLen: int64,
                  ct: int64, ctLen: int64, tag: int64, tagLen: int64,
                  pt: int64): bool {
    if (keyLen != 16 && keyLen != 32) { return false; }
    if (nonceLen <= 0) { return false; }
    if (ctLen < 0 || aadLen < 0) { return false; }
    if (tagLen <= 0 || tagLen > 16) { return false; }

    var rkSize: int64 := 240;
    var rk: int64 := alloc(rkSize);
    var j0: int64 := alloc(16);
    var h: int64 := alloc(16);
    var t: int64 := alloc(16);
    if (rk == 0 || j0 == 0 || h == 0 || t == 0) { panic("AES-GCM: kein Speicher"); }

    var rounds: int64 := gcmPrepare(key, keyLen, nonce, nonceLen, rk, j0, h);
    if (rounds == 0) {
        free(rk, rkSize); free(j0, 16); free(h, 16); free(t, 16);
        return false;
    }

    gcmTag(rk, rounds, h, j0, aad, aadLen, ct, ctLen, t);

    // Vergleich ohne Datenabhaengigkeit der Laufzeit (#2096: ein frueher
    // Abbruch beim ersten abweichenden Byte waere ein Orakel).
    // CTMemEqual liefert -1 bei Gleichheit, 0 sonst — nicht 1.
    var gleich: int64 := CTMemEqual(t, tag, tagLen);
    if (gleich != -1) {
        SecureZero(rk, rkSize); SecureZero(h, 16); SecureZero(t, 16);
        free(rk, rkSize); free(j0, 16); free(h, 16); free(t, 16);
        return false;
    }

    var cb: int64 := alloc(16);
    if (cb == 0) { panic("AES-GCM: kein Speicher fuer den Zaehlerblock"); }
    var i: int64 := 0;
    while (i < 16) { poke8(cb + i, peek8(j0 + i)); i := i + 1; }
    gcmInc32(cb);
    if (ctLen > 0) { gcmCtr(rk, rounds, cb, ct, ctLen, pt); }

    SecureZero(rk, rkSize);
    SecureZero(h, 16);
    free(cb, 16); free(rk, rkSize); free(j0, 16); free(h, 16); free(t, 16);
    return true;
}
