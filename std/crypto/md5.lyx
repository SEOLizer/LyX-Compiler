  // Round 2 — G(B,C,D) = (B&D)|(C&~D),  s=[5,9,14,20,...]
  F := ((B & D) | (C & (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W1  + 0xF61E2562) & 0xFFFFFFFF, 5)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & D) | (C & (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W6  + 0xC040B340) & 0xFFFFFFFF, 9)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & D) | (C & (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W11 + 0x265E5A51) & 0xFFFFFFFF,14)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & D) | (C & (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W0  + 0xE9B6C7AA) & 0xFFFFFFFF,20)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & D) | (C & (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W5  + 0xD62F105D) & 0xFFFFFFFF, 5)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & D) | (C & (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W10 + 0x02441453) & 0xFFFFFFFF, 9)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & D) | (C & (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W15 + 0xD8A1E681) & 0xFFFFFFFF,14)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & D) | (C & (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W4  + 0xE7D3FBC8) & 0xFFFFFFFF,20)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & D) | (C & (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W9  + 0x21E1CDE6) & 0xFFFFFFFF, 5)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
