// ============================================================================
// Public API
// ============================================================================

// MD5(data, len, out): writes 16-byte raw digest into out[0..15]
pub fn MD5(data: int64, len: int64, out: int64) {
  // State: A, B, C, D (each 32 bits, stored little-endian)
  var state: int64 := alloc(16);
  md5PutW(state, 0,  0x67452301);
  md5PutW(state, 4,  0xEFCDAB89);
  md5PutW(state, 8,  0x98BADCFE);
  md5PutW(state, 12, 0x10325476);

  // Scratch block (64 bytes)
  var block: int64 := alloc(64);

  // Process full blocks
  var pos: int64 := 0;
  while (pos + 64 <= len) {
    var i: int64 := 0;
    while (i < 64) { poke8(block + i, peek8(data + pos + i)); i := i + 1; }
    md5Block(state, block);
    pos := pos + 64;
  }

  // Final partial block: copy remaining bytes, then padding
  var remaining: int64 := len - pos;
  var i: int64 := 0;
  while (i < 64) { poke8(block + i, 0); i := i + 1; }
  i := 0;
  while (i < remaining) { poke8(block + i, peek8(data + pos + i)); i := i + 1; }
  poke8(block + remaining, 0x80);  // padding bit

  if (remaining >= 56) {
    // Need extra block
    md5Block(state, block);
    i := 0; while (i < 64) { poke8(block + i, 0); i := i + 1; }
  }

  // Length in bits, little-endian 64-bit, at bytes 56-63
  var bitLen: int64 := len * 8;
  poke8(block + 56,  bitLen        & 0xFF);
  poke8(block + 57, (bitLen >>  8) & 0xFF);
  poke8(block + 58, (bitLen >> 16) & 0xFF);
  poke8(block + 59, (bitLen >> 24) & 0xFF);
  poke8(block + 60, (bitLen >> 32) & 0xFF);
  poke8(block + 61, (bitLen >> 40) & 0xFF);
  poke8(block + 62, (bitLen >> 48) & 0xFF);
  poke8(block + 63, (bitLen >> 56) & 0xFF);
  md5Block(state, block);

  // Write 16-byte digest (little-endian state words)
  i := 0;
  while (i < 16) { poke8(out + i, peek8(state + i)); i := i + 1; }

  free(state, 16);
  free(block, 64);
}

// Hex nibble: 0-15 → '0'-'9' or 'a'-'f'
fn md5Hex4(v: int64): int64 {
  if (v < 10) { return 48 + v; }
  return 87 + v;  // 'a'=97, 97-10=87
}

// MD5Hex(data, len, out): writes 32-char lowercase hex + NUL into out[0..32]
pub fn MD5Hex(data: int64, len: int64, out: int64) {
  var digest: int64 := alloc(16);
  MD5(data, len, digest);
  var i: int64 := 0;
  while (i < 16) {
    var b: int64 := peek8(digest + i) & 0xFF;
    poke8(out + i * 2,     md5Hex4((b >> 4) & 0xF));
    poke8(out + i * 2 + 1, md5Hex4(b & 0xF));
    i := i + 1;
  }
  poke8(out + 32, 0);
  free(digest, 16);
}

// MD5HexStr: same but takes pchar (convenience wrapper)
pub fn MD5HexStr(data: pchar, len: int64, out: int64) {
  MD5Hex(data as int64, len, out);
}
