  F := (C ^ (B | (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W0  + 0xF4292244) & 0xFFFFFFFF, 6)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (C ^ (B | (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W7  + 0x432AFF97) & 0xFFFFFFFF,10)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (C ^ (B | (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W14 + 0xAB9423A7) & 0xFFFFFFFF,15)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (C ^ (B | (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W5  + 0xFC93A039) & 0xFFFFFFFF,21)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (C ^ (B | (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W12 + 0x655B59C3) & 0xFFFFFFFF, 6)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
