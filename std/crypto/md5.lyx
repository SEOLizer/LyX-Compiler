  T := (B + md5RotL((A + F + W3  + 0xC1BDCEEE) & 0xFFFFFFFF,22)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & C) | ((B ^ 0xFFFFFFFF) & D)) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W4  + 0xF57C0FAF) & 0xFFFFFFFF, 7)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & C) | ((B ^ 0xFFFFFFFF) & D)) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W5  + 0x4787C62A) & 0xFFFFFFFF,12)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & C) | ((B ^ 0xFFFFFFFF) & D)) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W6  + 0xA8304613) & 0xFFFFFFFF,17)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & C) | ((B ^ 0xFFFFFFFF) & D)) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W7  + 0xFD469501) & 0xFFFFFFFF,22)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & C) | ((B ^ 0xFFFFFFFF) & D)) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W8  + 0x698098D8) & 0xFFFFFFFF, 7)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & C) | ((B ^ 0xFFFFFFFF) & D)) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W9  + 0x8B44F7AF) & 0xFFFFFFFF,12)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & C) | ((B ^ 0xFFFFFFFF) & D)) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W10 + 0xFFFF5BB1) & 0xFFFFFFFF,17)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & C) | ((B ^ 0xFFFFFFFF) & D)) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W11 + 0x895CD7BE) & 0xFFFFFFFF,22)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & C) | ((B ^ 0xFFFFFFFF) & D)) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W12 + 0x6B901122) & 0xFFFFFFFF, 7)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & C) | ((B ^ 0xFFFFFFFF) & D)) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W13 + 0xFD987193) & 0xFFFFFFFF,12)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
