  T := (B + md5RotL((A + F + W15 + 0x1FA27CF8) & 0xFFFFFFFF,16)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (B ^ C ^ D) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W2  + 0xC4AC5665) & 0xFFFFFFFF,23)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;

