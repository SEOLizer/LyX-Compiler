// std/crypto/md5.lyx — RFC 1321 MD5 Message-Digest Algorithm
//
// Public API:
//   MD5(data: int64, len: int64, out: int64)          — 16-byte digest into out
//   MD5Hex(data: int64, len: int64, out: int64)        — 32-char lowercase hex into out (NUL-terminated)
//   MD5HexStr(data: pchar, len: int64, out: int64)     — same but pchar input

unit std.crypto.md5;

import std.alloc;
// ============================================================================
// MD5 internal helpers (all arithmetic is 32-bit unsigned, masked with 0xFFFFFFFF)
// ============================================================================

fn md5RotL(x: int64, n: int64): int64 {
  return (((x << n) | ((x & 0xFFFFFFFF) >> (32 - n))) & 0xFFFFFFFF);
}

// Read 32-bit little-endian word from buf at byte offset off
fn md5W(buf: int64, off: int64): int64 {
  var b0: int64 := peek8(buf + off)     & 0xFF;
  var b1: int64 := peek8(buf + off + 1) & 0xFF;
  var b2: int64 := peek8(buf + off + 2) & 0xFF;
  var b3: int64 := peek8(buf + off + 3) & 0xFF;
  return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

// Write 32-bit little-endian word to buf at byte offset off
fn md5PutW(buf: int64, off: int64, v: int64) {
  poke8(buf + off,     v         & 0xFF);
  poke8(buf + off + 1, (v >> 8)  & 0xFF);
  poke8(buf + off + 2, (v >> 16) & 0xFF);
  poke8(buf + off + 3, (v >> 24) & 0xFF);
}

// Process one 64-byte block. state = {A, B, C, D} each 32-bit stored as int64 LE.
fn md5Block(state: int64, block: int64) {
  var A: int64 := md5W(state, 0);
  var B: int64 := md5W(state, 4);
  var C: int64 := md5W(state, 8);
  var D: int64 := md5W(state, 12);

  var W0:  int64 := md5W(block, 0);
  var W1:  int64 := md5W(block, 4);
  var W2:  int64 := md5W(block, 8);
  var W3:  int64 := md5W(block, 12);
  var W4:  int64 := md5W(block, 16);
  var W5:  int64 := md5W(block, 20);
  var W6:  int64 := md5W(block, 24);
  var W7:  int64 := md5W(block, 28);
  var W8:  int64 := md5W(block, 32);
  var W9:  int64 := md5W(block, 36);
  var W10: int64 := md5W(block, 40);
  var W11: int64 := md5W(block, 44);
  var W12: int64 := md5W(block, 48);
  var W13: int64 := md5W(block, 52);
  var W14: int64 := md5W(block, 56);
  var W15: int64 := md5W(block, 60);

  var F: int64 := 0; var T: int64 := 0;

  // Round 1 — F(B,C,D) = (B&C)|(~B&D),  s=[7,12,17,22,...]
  F := ((B & C) | ((B ^ 0xFFFFFFFF) & D)) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W0  + 0xD76AA478) & 0xFFFFFFFF, 7)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & C) | ((B ^ 0xFFFFFFFF) & D)) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W1  + 0xE8C7B756) & 0xFFFFFFFF,12)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & C) | ((B ^ 0xFFFFFFFF) & D)) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W2  + 0x242070DB) & 0xFFFFFFFF,17)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
