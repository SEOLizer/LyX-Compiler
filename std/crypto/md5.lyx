  T := (B + md5RotL((A + F + W14 + 0xC33707D6) & 0xFFFFFFFF, 9)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & D) | (C & (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W3  + 0xF4D50D87) & 0xFFFFFFFF,14)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & D) | (C & (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W8  + 0x455A14ED) & 0xFFFFFFFF,20)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & D) | (C & (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W13 + 0xA9E3E905) & 0xFFFFFFFF, 5)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & D) | (C & (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W2  + 0xFCEFA3F8) & 0xFFFFFFFF, 9)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & D) | (C & (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W7  + 0x676F02D9) & 0xFFFFFFFF,14)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := ((B & D) | (C & (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W12 + 0x8D2A4C8A) & 0xFFFFFFFF,20)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;

  // Round 3 — H(B,C,D) = B^C^D,  s=[4,11,16,23,...]
  F := (B ^ C ^ D) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W5  + 0xFFFA3942) & 0xFFFFFFFF, 4)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (B ^ C ^ D) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W8  + 0x8771F681) & 0xFFFFFFFF,11)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (B ^ C ^ D) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W11 + 0x6D9D6122) & 0xFFFFFFFF,16)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (B ^ C ^ D) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W14 + 0xFDE5380C) & 0xFFFFFFFF,23)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (B ^ C ^ D) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W1  + 0xA4BEEA44) & 0xFFFFFFFF, 4)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (B ^ C ^ D) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W4  + 0x4BDECFA9) & 0xFFFFFFFF,11)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (B ^ C ^ D) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W7  + 0xF6BB4B60) & 0xFFFFFFFF,16)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (B ^ C ^ D) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W10 + 0xBEBFBC70) & 0xFFFFFFFF,23)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (B ^ C ^ D) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W13 + 0x289B7EC6) & 0xFFFFFFFF, 4)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (B ^ C ^ D) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W0  + 0xEAA127FA) & 0xFFFFFFFF,11)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (B ^ C ^ D) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W3  + 0xD4EF3085) & 0xFFFFFFFF,16)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (B ^ C ^ D) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W6  + 0x04881D05) & 0xFFFFFFFF,23)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (B ^ C ^ D) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W9  + 0xD9D4D039) & 0xFFFFFFFF, 4)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (B ^ C ^ D) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W12 + 0xE6DB99E5) & 0xFFFFFFFF,11)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
