  F := (C ^ (B | (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W1  + 0x85845DD1) & 0xFFFFFFFF,21)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
  F := (C ^ (B | (D ^ 0xFFFFFFFF))) & 0xFFFFFFFF;
  T := (B + md5RotL((A + F + W8  + 0x6FA87E4F) & 0xFFFFFFFF, 6)) & 0xFFFFFFFF; A:=D; D:=C; C:=B; B:=T;
