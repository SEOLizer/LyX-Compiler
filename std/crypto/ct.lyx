// std/crypto/ct.lyx
// WP-PQC-04: Constant-Time Utilities
//
// Timing-Side-Channel-freie Basisfunktionen für Post-Quantum-Kryptographie.
// Alle Funktionen laufen in streng konstanter Zeit (keine Branches auf
// geheimen Daten, kein datenabhängiges Memory-Access-Pattern).
//
// WICHTIG — Lyx-Shift-Verhalten (verifiziert):
//   >> auf int64 emittiert SHR (logisches Shift, kein SAR).
//   Damit gilt: x >> 63 = 1 wenn x < 0 (Bit 63 gesetzt), sonst 0.
//
// Daraus folgende CT-Basisformeln:
//   Sign-Bit negativ:     0 - (x >> 63)         → -1 wenn x<0,  0 wenn x≥0
//   Sign-Bit nicht-neg.:  (x >> 63) - 1          → -1 wenn x≥0,  0 wenn x<0
//   Null-Check:           ((x|(0-x)) >> 63) - 1  → -1 wenn x=0,  0 wenn x≠0

unit std.crypto.ct;

// ============================================================
// CTSelect — branchfreie Auswahl
//
// mask = -1 (0xFFFFFFFFFFFFFFFF) → gibt a zurück
// mask =  0                      → gibt b zurück
//
// Formel: (a & mask) | (b & ~mask)
// ============================================================
pub fn CTSelect(a: int64, b: int64, mask: int64): int64 {
  return (a & mask) | (b & ~mask);
}

// ============================================================
// CTEqual — branchfreier Gleichheitstest
//
// Gibt -1 (0xFFFFFFFFFFFFFFFF) zurück wenn a == b, sonst 0.
//
// Herleitung (logisches SHR):
//   diff = a - b
//   diff == 0: (diff|(0-diff)) = 0, >>63 = 0, 0-1 = -1  ✓
//   diff != 0: entweder diff oder (0-diff) hat Bit 63 gesetzt,
//              >>63 = 1, 1-1 = 0                          ✓
// ============================================================
pub fn CTEqual(a: int64, b: int64): int64 {
  var diff: int64 := a - b;
  return (((diff | (0 - diff)) as uint64) >> 63) - 1;
}

// ============================================================
// CTIsZero — prüft ob ein einzelner Wert 0 ist
//
// Gibt -1 wenn x == 0, sonst 0.
// ============================================================
pub fn CTIsZero(x: int64): int64 {
  return (((x | (0 - x)) as uint64) >> 63) - 1;
}

// ============================================================
// CTMemEqual — Speicherbereich-Vergleich in konstanter Zeit
//
// Gibt -1 zurück wenn alle len Bytes in a[] und b[] gleich sind, sonst 0.
// Ausführungszeit ist für gegebenes len konstant, unabhängig vom Inhalt.
// ============================================================
pub fn CTMemEqual(a: int64, b: int64, len: int64): int64 {
  var acc: int64 := 0;
  var i:   int64 := 0;
  while (i < len) {
    acc := acc | (peek8(a + i) ^ peek8(b + i));
    i += 1;
  }
  return CTIsZero(acc);
}

// ============================================================
// SecureZero — Speicher sicher nullen
//
// Überschreibt len Bytes ab ptr mit 0.
// Da ptr für den Compiler opaque ist (externer Zeiger), kann er die
// Schreibvorgänge nicht als "dead stores" eliminieren.
// ============================================================
pub fn SecureZero(ptr: int64, len: int64) {
  var i: int64 := 0;
  while (i < len) {
    poke8(ptr + i, 0);
    i += 1;
  }
}

// ============================================================
// CTBarrettReduce — modulare Reduktion ohne Branch
//
// Berechnet a mod q ohne Division zur Laufzeit auf geheimen Daten.
// Nutzt Barrett-Multiplikation mit k=32.
//
// Voraussetzungen:
//   - 0 <= a < q^2  (nach Polynom-Multiplikation typisch erfüllt)
//   - 2 <= q < 2^16 (ML-KEM: q=3329 ✓, für größere q k erhöhen)
//
// Formel:
//   m = floor(2^32 / q)              ← Barrett-Reziproke
//   t = (a * m) >> 32                ← Quotienten-Schätzung
//   r = a - t * q                    ← Reduktion, r in [0, 2q)
//   mask = (sub >> 63) - 1           ← -1 wenn sub≥0 (r≥q), 0 wenn sub<0
//   return CTSelect(r-q, r, mask)
// ============================================================
pub fn CTBarrettReduce(a: int64, q: int64): int64 {
  var m:   int64 := 4294967296 / q;    // 2^32 / q
  var t:   int64 := (a * m) >> 32;
  var r:   int64 := a - t * q;
  var sub: int64 := r - q;
  // (sub >> 63) = 1 wenn sub < 0 (r < q), 0 wenn sub >= 0 (r >= q)
  // (sub >> 63) - 1 = 0 wenn sub < 0, -1 wenn sub >= 0
  var mask: int64 := ((sub as uint64) >> 63) - 1;  // -1 wenn r>=q → return sub=r-q
  return CTSelect(sub, r, mask);
}

// ============================================================
// CTMontgomeryReduce — Montgomery-Reduktion ohne Branch
//
// Berechnet a * R^(-1) mod q, wobei R = 2^32.
// Geeignet für NTT-Butterfly-Operationen (ML-KEM, ML-DSA).
//
// Parameter:
//   a:    Eingang, 0 <= a < q * R
//   q:    Modulus (z.B. KYBER_Q = 3329)
//   qinv: -q^(-1) mod 2^32 (vorberechnet)
//         Für q=3329: 4294967296 - ModInverse(3329, 2^32)
//         Für q=7:    1227133513  (= 2^32 - 3067833783)
//
// Formel:
//   m = (a * qinv) & (R-1)   ← low 32 Bits
//   t = (a + m * q) >> 32    ← geteilt durch R
//   mask = (t-q>>63) - 1     ← CT-Korrektur
// ============================================================
pub fn CTMontgomeryReduce(a: int64, q: int64, qinv: int64): int64 {
  var m:   int64 := (a * qinv) & 0xFFFFFFFF;
  var t:   int64 := (a + m * q) >> 32;
  var sub: int64 := t - q;
  var mask: int64 := ((sub as uint64) >> 63) - 1;  // -1 wenn t>=q → return sub=t-q
  return CTSelect(sub, t, mask);
}
