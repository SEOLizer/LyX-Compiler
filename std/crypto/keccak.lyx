// std/crypto/keccak.lyx
// WP-PQC-01: Keccak-1600 / SHA-3 / SHAKE-128 / SHAKE-256
//
// Echte Keccak-f[1600]-Permutation (NIST FIPS 202), 24 Runden.
// Fundament für ML-KEM, ML-DSA, SLH-DSA (WP-PQC-05..08).
//
// Zustand: 5×5-Matrix aus 64-Bit-Lanes = 200 Bytes.
// Lane A[x,y] liegt bei Offset x*8 + y*40 (Little-Endian, x86-native).
//
// #1125: `>>` auf int64 zieht seit 1.0.13S das Vorzeichen nach (arithmetisch).
// Die Rotation braucht den LOGISCHEN Shift — `as uint64` fordert ihn an.
// für alle n∈[0,63] auf x86-64, da SHR-Count & 63.

unit std.crypto.keccak;

import std.alloc;

pub con KECCAK_STATE_SIZE: int64 := 200;

fn keccak_rotl64(x: int64, n: int64): int64 {
  return (x << n) | ((x as uint64) >> (64 - n));
}

// Keccak-f[1600]-Permutation: 24 Runden θ → ρ → π → χ → ι
fn keccak_f1600(st: int64) {
  var rc:    int64 := alloc(192);
  var b:     int64 := alloc(200);
  var round: int64 := 0;
  var c0:    int64 := 0;
  var c1:    int64 := 0;
  var c2:    int64 := 0;
  var c3:    int64 := 0;
  var c4:    int64 := 0;
  var d0:    int64 := 0;
  var d1:    int64 := 0;
  var d2:    int64 := 0;
  var d3:    int64 := 0;
  var d4:    int64 := 0;

  // Rundenkonstanten (FIPS 202, Anhang B.2)
  poke64(rc+0,   0x0000000000000001); poke64(rc+8,   0x0000000000008082);
  poke64(rc+16,  0x800000000000808A); poke64(rc+24,  0x8000000080008000);
  poke64(rc+32,  0x000000000000808B); poke64(rc+40,  0x0000000080000001);
  poke64(rc+48,  0x8000000080008081); poke64(rc+56,  0x8000000000008009);
  poke64(rc+64,  0x000000000000008A); poke64(rc+72,  0x0000000000000088);
  poke64(rc+80,  0x0000000080008009); poke64(rc+88,  0x000000008000000A);
  poke64(rc+96,  0x000000008000808B); poke64(rc+104, 0x800000000000008B);
  poke64(rc+112, 0x8000000000008089); poke64(rc+120, 0x8000000000008003);
  poke64(rc+128, 0x8000000000008002); poke64(rc+136, 0x8000000000000080);
  poke64(rc+144, 0x000000000000800A); poke64(rc+152, 0x800000008000000A);
  poke64(rc+160, 0x8000000080008081); poke64(rc+168, 0x8000000000008080);
  poke64(rc+176, 0x0000000080000001); poke64(rc+184, 0x8000000080008008);

  while (round < 24) {
    // θ: C[x] = Spalten-XOR, D[x] = C[x-1] ^ ROT(C[x+1], 1)
    c0 := peek64(st+0)^peek64(st+40)^peek64(st+80)^peek64(st+120)^peek64(st+160);
    c1 := peek64(st+8)^peek64(st+48)^peek64(st+88)^peek64(st+128)^peek64(st+168);
    c2 := peek64(st+16)^peek64(st+56)^peek64(st+96)^peek64(st+136)^peek64(st+176);
    c3 := peek64(st+24)^peek64(st+64)^peek64(st+104)^peek64(st+144)^peek64(st+184);
    c4 := peek64(st+32)^peek64(st+72)^peek64(st+112)^peek64(st+152)^peek64(st+192);
    d0 := c4 ^ keccak_rotl64(c1, 1);
    d1 := c0 ^ keccak_rotl64(c2, 1);
    d2 := c1 ^ keccak_rotl64(c3, 1);
    d3 := c2 ^ keccak_rotl64(c4, 1);
    d4 := c3 ^ keccak_rotl64(c0, 1);
    poke64(st+0,   peek64(st+0)   ^ d0); poke64(st+40,  peek64(st+40)  ^ d0);
    poke64(st+80,  peek64(st+80)  ^ d0); poke64(st+120, peek64(st+120) ^ d0);
    poke64(st+160, peek64(st+160) ^ d0);
    poke64(st+8,   peek64(st+8)   ^ d1); poke64(st+48,  peek64(st+48)  ^ d1);
    poke64(st+88,  peek64(st+88)  ^ d1); poke64(st+128, peek64(st+128) ^ d1);
    poke64(st+168, peek64(st+168) ^ d1);
    poke64(st+16,  peek64(st+16)  ^ d2); poke64(st+56,  peek64(st+56)  ^ d2);
    poke64(st+96,  peek64(st+96)  ^ d2); poke64(st+136, peek64(st+136) ^ d2);
    poke64(st+176, peek64(st+176) ^ d2);
    poke64(st+24,  peek64(st+24)  ^ d3); poke64(st+64,  peek64(st+64)  ^ d3);
    poke64(st+104, peek64(st+104) ^ d3); poke64(st+144, peek64(st+144) ^ d3);
    poke64(st+184, peek64(st+184) ^ d3);
    poke64(st+32,  peek64(st+32)  ^ d4); poke64(st+72,  peek64(st+72)  ^ d4);
    poke64(st+112, peek64(st+112) ^ d4); poke64(st+152, peek64(st+152) ^ d4);
    poke64(st+192, peek64(st+192) ^ d4);

    // ρ+π: B[dest] = ROT(A[src], r[x,y])
    // Mapping: src_off → dest_off, Rotation (vollständige 5×5-Tabelle)
    // dest_off = y*8 + ((2x+3y)%5)*40   |   Rotation = r[x,y] aus FIPS 202
    poke64(b+0,   keccak_rotl64(peek64(st+0),   0));
    poke64(b+80,  keccak_rotl64(peek64(st+8),   1));
    poke64(b+160, keccak_rotl64(peek64(st+16),  62));
    poke64(b+40,  keccak_rotl64(peek64(st+24),  28));
    poke64(b+120, keccak_rotl64(peek64(st+32),  27));
    poke64(b+128, keccak_rotl64(peek64(st+40),  36));
    poke64(b+8,   keccak_rotl64(peek64(st+48),  44));
    poke64(b+88,  keccak_rotl64(peek64(st+56),  6));
    poke64(b+168, keccak_rotl64(peek64(st+64),  55));
    poke64(b+48,  keccak_rotl64(peek64(st+72),  20));
    poke64(b+56,  keccak_rotl64(peek64(st+80),  3));
    poke64(b+136, keccak_rotl64(peek64(st+88),  10));
    poke64(b+16,  keccak_rotl64(peek64(st+96),  43));
    poke64(b+96,  keccak_rotl64(peek64(st+104), 25));
    poke64(b+176, keccak_rotl64(peek64(st+112), 39));
    poke64(b+184, keccak_rotl64(peek64(st+120), 41));
    poke64(b+64,  keccak_rotl64(peek64(st+128), 45));
    poke64(b+144, keccak_rotl64(peek64(st+136), 15));
    poke64(b+24,  keccak_rotl64(peek64(st+144), 21));
    poke64(b+104, keccak_rotl64(peek64(st+152), 8));
    poke64(b+112, keccak_rotl64(peek64(st+160), 18));
    poke64(b+192, keccak_rotl64(peek64(st+168), 2));
    poke64(b+72,  keccak_rotl64(peek64(st+176), 61));
    poke64(b+152, keccak_rotl64(peek64(st+184), 56));
    poke64(b+32,  keccak_rotl64(peek64(st+192), 14));

    // χ: A[x,y] = B[x,y] ^ (~B[(x+1)%5,y] & B[(x+2)%5,y])
    poke64(st+0,   peek64(b+0)   ^ (~peek64(b+8)   & peek64(b+16)));
    poke64(st+8,   peek64(b+8)   ^ (~peek64(b+16)  & peek64(b+24)));
    poke64(st+16,  peek64(b+16)  ^ (~peek64(b+24)  & peek64(b+32)));
    poke64(st+24,  peek64(b+24)  ^ (~peek64(b+32)  & peek64(b+0)));
    poke64(st+32,  peek64(b+32)  ^ (~peek64(b+0)   & peek64(b+8)));
    poke64(st+40,  peek64(b+40)  ^ (~peek64(b+48)  & peek64(b+56)));
    poke64(st+48,  peek64(b+48)  ^ (~peek64(b+56)  & peek64(b+64)));
    poke64(st+56,  peek64(b+56)  ^ (~peek64(b+64)  & peek64(b+72)));
    poke64(st+64,  peek64(b+64)  ^ (~peek64(b+72)  & peek64(b+40)));
    poke64(st+72,  peek64(b+72)  ^ (~peek64(b+40)  & peek64(b+48)));
    poke64(st+80,  peek64(b+80)  ^ (~peek64(b+88)  & peek64(b+96)));
    poke64(st+88,  peek64(b+88)  ^ (~peek64(b+96)  & peek64(b+104)));
    poke64(st+96,  peek64(b+96)  ^ (~peek64(b+104) & peek64(b+112)));
    poke64(st+104, peek64(b+104) ^ (~peek64(b+112) & peek64(b+80)));
    poke64(st+112, peek64(b+112) ^ (~peek64(b+80)  & peek64(b+88)));
    poke64(st+120, peek64(b+120) ^ (~peek64(b+128) & peek64(b+136)));
    poke64(st+128, peek64(b+128) ^ (~peek64(b+136) & peek64(b+144)));
    poke64(st+136, peek64(b+136) ^ (~peek64(b+144) & peek64(b+152)));
    poke64(st+144, peek64(b+144) ^ (~peek64(b+152) & peek64(b+120)));
    poke64(st+152, peek64(b+152) ^ (~peek64(b+120) & peek64(b+128)));
    poke64(st+160, peek64(b+160) ^ (~peek64(b+168) & peek64(b+176)));
    poke64(st+168, peek64(b+168) ^ (~peek64(b+176) & peek64(b+184)));
    poke64(st+176, peek64(b+176) ^ (~peek64(b+184) & peek64(b+192)));
    poke64(st+184, peek64(b+184) ^ (~peek64(b+192) & peek64(b+160)));
    poke64(st+192, peek64(b+192) ^ (~peek64(b+160) & peek64(b+168)));

    // ι: A[0,0] ^= RC[round]
    poke64(st, peek64(st) ^ peek64(rc + round * 8));
    round += 1;
  }
  free(b, 200);
  free(rc, 192);
}

// Setzt alle 25 Lanes des 200-Byte-Zustands auf 0
pub fn KeccakInit(state: int64) {
  var i: int64 := 0;
  while (i < 200) { poke8(state + i, 0); i := i + 1; }
}

// Absorbiert len Bytes aus data in den Zustand.
// rate:  136 (SHA3-256/SHAKE-256), 72 (SHA3-512), 168 (SHAKE-128)
// pad:   0x06 (SHA-3), 0x1F (SHAKE)
pub fn KeccakAbsorb(state: int64, data: int64, len: int64, rate: int64, pad: int64) {
  var pos: int64 := 0;
  var rem: int64 := len;
  var i:   int64 := 0;
  while (rem >= rate) {
    i := 0;
    while (i < rate) { poke8(state+i, peek8(state+i) ^ peek8(data+pos+i)); i := i+1; }
    keccak_f1600(state);
    pos += rate;
    rem -= rate;
  }
  i := 0;
  while (i < rem) { poke8(state+i, peek8(state+i) ^ peek8(data+pos+i)); i := i+1; }
  // Multi-Rate-Padding: pad an Position rem, 0x80 am Ende des Rate-Blocks
  poke8(state + rem,      peek8(state + rem)      ^ pad);
  poke8(state + rate - 1, peek8(state + rate - 1) ^ 0x80);
  keccak_f1600(state);
}

// Liest outLen Ausgabe-Bytes aus dem Zustand (Squeeze-Phase)
pub fn KeccakSqueeze(state: int64, out: int64, outLen: int64, rate: int64) {
  var pos: int64 := 0;
  var rem: int64 := outLen;
  var i:   int64 := 0;
  while (rem >= rate) {
    i := 0;
    while (i < rate) { poke8(out+pos+i, peek8(state+i)); i := i+1; }
    keccak_f1600(state);
    pos += rate;
    rem -= rate;
  }
  i := 0;
  while (i < rem) { poke8(out+pos+i, peek8(state+i)); i := i+1; }
}

// SHA3-256: 32-Byte-Ausgabe, rate=136, pad=0x06
pub fn SHA3_256(data: int64, len: int64, out: int64) {
  var state: int64 := alloc(200);
  KeccakInit(state);
  KeccakAbsorb(state, data, len, 136, 0x06);
  KeccakSqueeze(state, out, 32, 136);
  free(state, 200);
}

// SHA3-512: 64-Byte-Ausgabe, rate=72, pad=0x06
pub fn SHA3_512(data: int64, len: int64, out: int64) {
  var state: int64 := alloc(200);
  KeccakInit(state);
  KeccakAbsorb(state, data, len, 72, 0x06);
  KeccakSqueeze(state, out, 64, 72);
  free(state, 200);
}

// SHAKE-128: variable Ausgabelänge, rate=168, pad=0x1F
pub fn SHAKE128(data: int64, len: int64, out: int64, outLen: int64) {
  var state: int64 := alloc(200);
  KeccakInit(state);
  KeccakAbsorb(state, data, len, 168, 0x1F);
  KeccakSqueeze(state, out, outLen, 168);
  free(state, 200);
}

// SHAKE-256: variable Ausgabelänge, rate=136, pad=0x1F
pub fn SHAKE256(data: int64, len: int64, out: int64, outLen: int64) {
  var state: int64 := alloc(200);
  KeccakInit(state);
  KeccakAbsorb(state, data, len, 136, 0x1F);
  KeccakSqueeze(state, out, outLen, 136);
  free(state, 200);
}
