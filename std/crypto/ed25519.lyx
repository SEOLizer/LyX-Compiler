// std/crypto/ed25519.lyx — Ed25519 nach RFC 8032, Signieren und Pruefen
//
// Teil von #2096. Grundlage sind zwei bereits gepruefte Bausteine, damit hier
// keine dritte Langzahlrechnung im Baum liegt:
//   * std.crypto.bignum  — Montgomery-Arithmetik in Radix 2^64. Das Feld
//     GF(2^255-19) rechnet darauf mit 4 Gliedern, die Skalare mod L mit
//     Barrett-Reduktion ueber BnMul.
//   * std.crypto.sha512  — SHA-512 fuer Schluesselableitung und Hash.
//
// Kurvenparameter (RFC 8032 §5.1): Twisted Edwards, a = -1,
// d = -121665/121666 mod p, Basispunkt B, Gruppenordnung
// L = 2^252 + 27742317777372353535851937790883648493.
// Punkte liegen in erweiterten Koordinaten (X, Y, Z, T) mit x = X/Z,
// y = Y/Z, T = XY/Z.
//
// Konstante Laufzeit: die Skalarmultiplikation beim SIGNIEREN laeuft
// verdoppelnd-und-immer-addierend mit maskierter Auswahl (edCSelect), also
// ohne Sprung und ohne Speicherzugriff am Geheimnis. Beim PRUEFEN sind beide
// Skalare oeffentlich; dort wird direkt verzweigt, und das ist ausdruecklich
// kein Mangel.
//
// Abweisungen (RFC 8032 §5.1.7 und die Faelle, an denen Umsetzungen reihum
// scheitern): S >= L wird abgewiesen, ein nicht dekodierbarer Punkt wird
// abgewiesen, und die Pruefung rechnet die Gleichung
// [8][S]B = [8]R + [8][k]A NICHT kofaktorfrei um — sie prueft [S]B = R + [k]A
// und ist damit die strengere Form.
//
// Oeffentliche API:
//   Ed25519PubAusSeed(seed32, pk32)            — oeffentlicher Schluessel
//   Ed25519Sign(seed32, msg, msgLen, sig64)
//   Ed25519Verify(sig64, msg, msgLen, pk32): bool
//   Ed25519PubAusSpki(der, derLen, pk32): bool  — X.509-Schluessel
//   Ed25519PrivAusPkcs8(der, derLen, seed32): bool

unit std.crypto.ed25519;

import std.alloc;
import std.crypto.bignum;
import std.crypto.ct;
import std.crypto.sha512;
import std.crypto.der;

con ED_GLIEDER: int64 := 4;           // 256 Bit
con ED_FE: int64 := 32;               // Feldelement in Byte

// ---------------------------------------------------------------------------
// Kratzbereich — ein alloc je Programmlauf, feste Unterbereiche.
// Begruendung wie in std/crypto/x509.lyx: kein alloc/free je Aufruf und kein
// defer (Issue #2380).
// ---------------------------------------------------------------------------

con EW: int64 := 32;                  // ein Feldelement in Montgomery-Form

con ES_P:      int64 := 0;            // Modulus p
con ES_D:      int64 := 32;           // Kurvenparameter d (Montgomery-Form)
con ES_D2:     int64 := 64;           // 2d
con ES_SQRTM1: int64 := 96;           // sqrt(-1)
con ES_R2:     int64 := 128;          // R^2 mod p
con ES_EINS:   int64 := 160;          // 1 in Montgomery-Form
con ES_L:      int64 := 192;          // Gruppenordnung L
con ES_MU:     int64 := 224;          // floor(2^512 / L), 5 Glieder = 40 Byte
con ES_BASE:   int64 := 264;          // Basispunkt, 4 Feldelemente
con ES_T1:     int64 := 392;          // Rechenplaetze fuer die Punktformeln
con ES_T2:     int64 := 424;
con ES_T3:     int64 := 456;
con ES_T4:     int64 := 488;
con ES_T5:     int64 := 520;
con ES_T6:     int64 := 552;
con ES_T7:     int64 := 584;
con ES_T8:     int64 := 616;
con ES_P1:     int64 := 648;          // Punkt A (4 Feldelemente)
con ES_P2:     int64 := 776;          // Punkt B
con ES_P3:     int64 := 904;          // Punkt C (Ergebnis)
con ES_P4:     int64 := 1032;         // Punkt D (Auswahl)
con ES_ACC:    int64 := 1160;         // Akkumulator der Skalarmultiplikation
con ES_ADD:    int64 := 1288;         // Summand
con ES_SCR1:   int64 := 1416;         // 64 Byte: 8 Glieder
con ES_SCR2:   int64 := 1480;         // 64 Byte: 8 Glieder
con ES_SCR3:   int64 := 1544;         // 64 Byte: 8 Glieder
con ES_H:      int64 := 1608;         // 64 Byte SHA-512-Ergebnis
con ES_H2:     int64 := 1672;         // 64 Byte SHA-512-Ergebnis
// Die drei folgenden Bereiche nehmen PRODUKTE auf: BnMul ueber 8 Glieder
// liefert 16 Glieder, also 128 Byte. In der ersten Fassung waren hier 64 und
// 80 Byte vorgesehen — das Produkt lief in den naechsten Bereich, und jeder
// reduzierte Skalar kam falsch heraus.
con ES_BNX:    int64 := 1736;         // 128 Byte
con ES_BNY:    int64 := 1864;         // 128 Byte
con ES_BNZ:    int64 := 1992;         // 128 Byte
con ES_MSGP:   int64 := 2120;         // 128 Byte Umwandlungspuffer
// Eigene Plaetze fuer die Groessen des Signaturwegs. Sie duerfen NICHT in
// ES_T1..T8 liegen: ptDbl und ptAdd benutzen genau diese Plaetze, und ein
// Skalar, der dort liegt, wird mitten in der Skalarmultiplikation
// ueberschrieben — gemessen kam dann der richtige oeffentliche Schluessel
// ([a]B) heraus, aber ein falsches R ([r]B), weil r in ES_T3 lag.
con ES_SPK:    int64 := 2248;         // 32 oeffentlicher Schluessel
con ES_SA:     int64 := 2280;         // 32 geheimer Skalar a (little-endian)
con ES_SPRE:   int64 := 2312;         // 32 Praefix h[32..64]
con ES_SR:     int64 := 2344;         // 32 r als Glieder (4) bzw. little-endian
con ES_SRLE:   int64 := 2376;         // 32 r little-endian
con ES_SK:     int64 := 2408;         // 32 k
con ES_SKLE:   int64 := 2440;         // 32 k little-endian
con ES_SS:     int64 := 2472;         // 32 S
con ES_SSLE:   int64 := 2504;         // 32 S little-endian
con ES_SAB:    int64 := 2536;         // 32 a als Glieder
// Eigene Plaetze fuer ptDecode: die erste Fassung nahm ES_P2 als
// Zwischenspeicher und wurde damit beim Dekodieren NACH ES_P2 (dem Punkt R
// in der Pruefung) ueber den eigenen Zielpunkt geschrieben.
con ES_DEC:    int64 := 2568;         // 4 x 32 Byte
// Eigene Plaetze fuer feInv und fePow2523. Beide brauchen drei
// Zwischenwerte; in der ersten Fassung nahmen sie ES_T4..T7 — also die
// Plaetze, auf denen der AUFRUFER gerade seine Werte hielt. In ptDecode ging
// damit `u` verloren, und jede Dekodierung schlug fehl.
con ES_INV:    int64 := 2696;         // 3 x 32 Byte
// Zwei eigene Plaetze fuer ptAdd. Die erste Fassung nahm ES_P4 — und ES_P4
// haelt in der Pruefung den Punkt [k]A, also genau einen der beiden
// Summanden. Die Formel hat sich damit ihre eigene Eingabe ueberschrieben.
con ES_ADDT:   int64 := 2792;         // 2 x 32 Byte
con ES_GROESSE: int64 := 2880;

var _edScr: int64 := 0;
var _edFertig: int64 := 0;

fn edScr(): int64 {
    if (_edScr != 0) { return _edScr; }
    var p: int64 := alloc(ES_GROESSE);
    if (p == 0) { panic("ed25519: kein Speicher fuer den Kratzbereich"); }
    _edScr := p;
    return p;
}

// Hilfsfunktion: Hexziffernfolge (big-endian) in ein Glied-Feld schreiben.
fn edSetzeHex(ziel: int64, hex: pchar): void {
    var l: int64 := StrLen(hex);
    var bytes: int64 := l / 2;
    var puf: int64 := edScr() + ES_MSGP;      // bis 96 Byte, genuegt fuer 64
    var i: int64 := 0;
    while (i < bytes) {
        var hi: int64 := StrCharAt(hex, i * 2);
        var lo: int64 := StrCharAt(hex, i * 2 + 1);
        if (hi >= 97) { hi := hi - 87; } else { hi := hi - 48; }
        if (lo >= 97) { lo := lo - 87; } else { lo := lo - 48; }
        poke8(puf + i, (hi << 4) | lo);
        i += 1;
    }
    BnFromBytes(ziel, (bytes + 7) / 8, puf, bytes);
}

// ---------------------------------------------------------------------------
// Feldarithmetik auf Montgomery-Form (alle Werte 4 Glieder)
// ---------------------------------------------------------------------------

fn feP(): int64 { return edScr() + ES_P; }

fn feMul(r: int64, a: int64, b: int64): void {
    BnMontMul(r, a, b, feP(), ED_GLIEDER, BnMontN0(peek64(feP())));
}

fn feSq(r: int64, a: int64): void {
    feMul(r, a, a);
}

fn feAdd(r: int64, a: int64, b: int64): void {
    var c: int64 := BnAdd(r, a, b, ED_GLIEDER);
    var hat: int64 := CTIsZero(c) ^ 0xFFFFFFFFFFFFFFFF;
    BnSubCond(r, feP(), ED_GLIEDER, hat | feGeMaske(r, feP()));
}

fn feSub(r: int64, a: int64, b: int64): void {
    var borrow: int64 := BnSub(r, a, b, ED_GLIEDER);
    // bei Unterlauf p addieren
    var maske: int64 := CTIsZero(borrow) ^ 0xFFFFFFFFFFFFFFFF;
    var i: int64 := 0;
    var c: int64 := 0;
    while (i < ED_GLIEDER) {
        var x: int64 := peek64(r + i * 8);
        var y: int64 := peek64(feP() + i * 8) & maske;
        var s: int64 := x + y;
        var c1: int64 := (((x & y) | ((x | y) & (s ^ 0xFFFFFFFFFFFFFFFF))) as uint64) >> 63;
        var s2: int64 := s + c;
        var c2: int64 := (((s & c) | ((s | c) & (s2 ^ 0xFFFFFFFFFFFFFFFF))) as uint64) >> 63;
        poke64(r + i * 8, s2);
        c := c1 + c2;
        i += 1;
    }
}

fn feGeMaske(a: int64, b: int64): int64 {
    var c: int64 := 0;
    var i: int64 := 0;
    while (i < ED_GLIEDER) {
        var x: int64 := peek64(a + i * 8);
        var y: int64 := peek64(b + i * 8);
        var d: int64 := x - y;
        var b1: int64 := ((((y & d) | ((y | d) & (x ^ 0xFFFFFFFFFFFFFFFF)))) as uint64) >> 63;
        var d2: int64 := d - c;
        var b2: int64 := ((((c & d2) | ((c | d2) & (d ^ 0xFFFFFFFFFFFFFFFF)))) as uint64) >> 63;
        c := b1 + b2;
        i += 1;
    }
    return CTIsZero(c);
}

fn feNeg(r: int64, a: int64): void {
    var null0: int64 := edScr() + ES_INV + 2 * EW;
    BnZero(null0, ED_GLIEDER);
    feSub(r, null0, a);
}

fn feCopy(r: int64, a: int64): void { BnCopy(r, a, ED_GLIEDER); }

fn feIsZero(a: int64): int64 { return BnIsZero(a, ED_GLIEDER); }

// r := a wenn maske == -1, sonst b. Ohne Sprung.
fn feSelect(r: int64, a: int64, b: int64, maske: int64): void {
    var i: int64 := 0;
    while (i < ED_GLIEDER) {
        poke64(r + i * 8,
               (peek64(a + i * 8) & maske) | (peek64(b + i * 8) & (maske ^ 0xFFFFFFFFFFFFFFFF)));
        i += 1;
    }
}

// Inverse ueber a^(p-2); der Exponent ist oeffentlich, die Basis geheim —
// BnModExp verzweigt nur auf Exponentenbits.
fn feInv(r: int64, a: int64): void {
    var scr: int64 := edScr();
    var e: int64 := scr + ES_INV;
    var normal: int64 := scr + ES_INV + EW;
    BnCopy(e, feP(), ED_GLIEDER);
    // e := p - 2
    var zwei: int64 := scr + ES_INV + 2 * EW;
    BnZero(zwei, ED_GLIEDER);
    poke64(zwei, 2);
    BnSub(e, e, zwei, ED_GLIEDER);
    // aus Montgomery heraus, potenzieren, zurueck: BnModExp rechnet normal.
    BnFromMont(normal, a, feP(), ED_GLIEDER, BnMontN0(peek64(feP())));
    var erg: int64 := scr + ES_INV + 2 * EW;
    BnModExp(erg, normal, e, 255, feP(), ED_GLIEDER);
    BnToMont(r, erg, feP(), ED_GLIEDER, BnMontN0(peek64(feP())), scr + ES_R2);
}

// a^((p-3)/4) fuer die Quadratwurzel; p = 5 mod 8, darum ueber (p+3)/8.
fn fePow2523(r: int64, a: int64): void {
    var scr: int64 := edScr();
    var e: int64 := scr + ES_INV;
    var normal: int64 := scr + ES_INV + EW;
    // e := (p - 5) / 8
    BnCopy(e, feP(), ED_GLIEDER);
    var fuenf: int64 := scr + ES_INV + 2 * EW;
    BnZero(fuenf, ED_GLIEDER);
    poke64(fuenf, 5);
    BnSub(e, e, fuenf, ED_GLIEDER);
    // durch 8 teilen (drei Rechtsschiebungen ueber die Glieder)
    var s: int64 := 0;
    while (s < 3) {
        var i: int64 := 0;
        var rest: int64 := 0;
        i := ED_GLIEDER - 1;
        while (i >= 0) {
            var w: int64 := peek64(e + i * 8);
            poke64(e + i * 8, ((w as uint64) >> 1) | (rest << 63));
            rest := w & 1;
            i -= 1;
        }
        s += 1;
    }
    BnFromMont(normal, a, feP(), ED_GLIEDER, BnMontN0(peek64(feP())));
    var erg: int64 := scr + ES_INV + 2 * EW;
    BnModExp(erg, normal, e, 253, feP(), ED_GLIEDER);
    BnToMont(r, erg, feP(), ED_GLIEDER, BnMontN0(peek64(feP())), scr + ES_R2);
}

// ---------------------------------------------------------------------------
// Konstanten einmal aufbauen
// ---------------------------------------------------------------------------

fn edInit(): void {
    if (_edFertig != 0) { return; }
    var scr: int64 := edScr();
    // p = 2^255 - 19
    edSetzeHex(scr + ES_P, "7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffed"c);
    BnMontR2(scr + ES_R2, scr + ES_P, ED_GLIEDER);
    var n0: int64 := BnMontN0(peek64(scr + ES_P));

    // 1 in Montgomery-Form
    var eins: int64 := scr + ES_EINS;
    BnZero(eins, ED_GLIEDER);
    poke64(eins, 1);
    BnToMont(eins, eins, scr + ES_P, ED_GLIEDER, n0, scr + ES_R2);

    // d = 37095705934669439343138083508754565189542113879843219016388785533085940283555
    var dTmp: int64 := scr + ES_T1;
    edSetzeHex(dTmp, "52036cee2b6ffe738cc740797779e89800700a4d4141d8ab75eb4dca135978a3"c);
    BnToMont(scr + ES_D, dTmp, scr + ES_P, ED_GLIEDER, n0, scr + ES_R2);
    feAdd(scr + ES_D2, scr + ES_D, scr + ES_D);

    // sqrt(-1) = 19681161376707505956807079304988542015446066515923890162744021073123829784752
    var sTmp: int64 := scr + ES_T1;
    edSetzeHex(sTmp, "2b8324804fc1df0b2b4d00993dfbd7a72f431806ad2fe478c4ee1b274a0ea0b0"c);
    BnToMont(scr + ES_SQRTM1, sTmp, scr + ES_P, ED_GLIEDER, n0, scr + ES_R2);

    // L = 2^252 + 27742317777372353535851937790883648493
    edSetzeHex(scr + ES_L, "1000000000000000000000000000000014def9dea2f79cd65812631a5cf5d3ed"c);
    // mu = floor(2^512 / L) fuer die Barrett-Reduktion: 260 Bit, also fuenf
    // Glieder. Glied fuer Glied gesetzt und nicht als Hexkette — in der
    // ersten Fassung war die Kette um eine Stelle verschoben, und JEDER
    // Skalar kam falsch reduziert heraus (richtiger oeffentlicher
    // Schluessel, falsche Signatur).
    poke64(scr + ES_MU + 0,  0xed9ce5a30a2c131b);
    poke64(scr + ES_MU + 8,  0x2106215d086329a7);
    poke64(scr + ES_MU + 16, 0xffffffffffffffeb);
    poke64(scr + ES_MU + 24, 0xffffffffffffffff);
    poke64(scr + ES_MU + 32, 0xf);

    // Basispunkt: x, y aus RFC 8032 §5.1; T = x*y, Z = 1
    var bx: int64 := scr + ES_T1;
    var by: int64 := scr + ES_T2;
    edSetzeHex(bx, "216936d3cd6e53fec0a4e231fdd6dc5c692cc7609525a7b2c9562d608f25d51a"c);
    edSetzeHex(by, "6666666666666666666666666666666666666666666666666666666666666658"c);
    var base: int64 := scr + ES_BASE;
    BnToMont(base + 0 * EW, bx, scr + ES_P, ED_GLIEDER, n0, scr + ES_R2);
    BnToMont(base + 1 * EW, by, scr + ES_P, ED_GLIEDER, n0, scr + ES_R2);
    BnCopy(base + 2 * EW, eins, ED_GLIEDER);
    feMul(base + 3 * EW, base + 0 * EW, base + 1 * EW);

    _edFertig := 1;
}

// ---------------------------------------------------------------------------
// Punktarithmetik (erweiterte Koordinaten, a = -1)
// ---------------------------------------------------------------------------

fn ptNull(p: int64): void {
    var scr: int64 := edScr();
    BnZero(p + 0 * EW, ED_GLIEDER);                 // X = 0
    BnCopy(p + 1 * EW, scr + ES_EINS, ED_GLIEDER);  // Y = 1
    BnCopy(p + 2 * EW, scr + ES_EINS, ED_GLIEDER);  // Z = 1
    BnZero(p + 3 * EW, ED_GLIEDER);                 // T = 0
}

fn ptCopy(r: int64, a: int64): void {
    var i: int64 := 0;
    while (i < 4 * EW) { poke8(r + i, peek8(a + i)); i := i + 1; }
}

fn ptSelect(r: int64, a: int64, b: int64, maske: int64): void {
    var i: int64 := 0;
    while (i < 4) {
        feSelect(r + i * EW, a + i * EW, b + i * EW, maske);
        i += 1;
    }
}

// r := 2*a — Verdopplung in erweiterten Koordinaten fuer a = -1
// (dbl-2008-hwcd, Hisil/Wong/Carter/Dawson):
//   A = X^2, B = Y^2, C = 2 Z^2, D = a*A = -A
//   E = (X+Y)^2 - A - B,  G = D + B,  F = G - C,  H = D - B
//   X3 = E*F,  Y3 = G*H,  T3 = E*H,  Z3 = F*G
// Die erste Fassung hier hatte die Vorzeichen von D, G und H vertauscht und
// anschliessend X und T "zurueckgenegiert" — das Ergebnis war ein anderer
// Punkt, und JEDE abgeleitete Groesse (Schluessel, R, S) wurde falsch.
fn ptDbl(r: int64, a: int64): void {
    var scr: int64 := edScr();
    var A: int64 := scr + ES_T1;
    var B: int64 := scr + ES_T2;
    var C: int64 := scr + ES_T3;
    var D: int64 := scr + ES_T4;
    var E: int64 := scr + ES_T5;
    var F: int64 := scr + ES_T6;
    var G: int64 := scr + ES_T7;
    var H: int64 := scr + ES_T8;
    feSq(A, a + 0 * EW);
    feSq(B, a + 1 * EW);
    feSq(C, a + 2 * EW);
    feAdd(C, C, C);
    feNeg(D, A);
    feAdd(E, a + 0 * EW, a + 1 * EW);
    feSq(E, E);
    feSub(E, E, A);
    feSub(E, E, B);
    feAdd(G, D, B);
    feSub(F, G, C);
    feSub(H, D, B);
    feMul(r + 0 * EW, E, F);
    feMul(r + 1 * EW, G, H);
    feMul(r + 3 * EW, E, H);
    feMul(r + 2 * EW, F, G);
}

// r := a + b
fn ptAdd(r: int64, a: int64, b: int64): void {
    var scr: int64 := edScr();
    var A: int64 := scr + ES_T1;
    var B: int64 := scr + ES_T2;
    var C: int64 := scr + ES_T3;
    var D: int64 := scr + ES_T4;
    var E: int64 := scr + ES_T5;
    var F: int64 := scr + ES_T6;
    var G: int64 := scr + ES_T7;
    var H: int64 := scr + ES_T8;
    var t1: int64 := scr + ES_ADDT;
    var t2: int64 := scr + ES_ADDT + EW;

    feSub(t1, a + 1 * EW, a + 0 * EW);             // Y1 - X1
    feSub(t2, b + 1 * EW, b + 0 * EW);             // Y2 - X2
    feMul(A, t1, t2);
    feAdd(t1, a + 1 * EW, a + 0 * EW);
    feAdd(t2, b + 1 * EW, b + 0 * EW);
    feMul(B, t1, t2);
    feMul(C, a + 3 * EW, b + 3 * EW);
    feMul(C, C, scr + ES_D2);                      // C = T1*T2*2d
    feMul(D, a + 2 * EW, b + 2 * EW);
    feAdd(D, D, D);                                // D = 2*Z1*Z2
    feSub(E, B, A);
    feSub(F, D, C);
    feAdd(G, D, C);
    feAdd(H, B, A);
    feMul(r + 0 * EW, E, F);
    feMul(r + 1 * EW, G, H);
    feMul(r + 2 * EW, F, G);
    feMul(r + 3 * EW, E, H);
}

// r := [k] p, Skalar k als 32 Byte little-endian. `ct` schaltet die
// maskierte Auswahl ein (geheimer Skalar).
fn ptScalarMul(r: int64, k: int64, p: int64, ct: bool): void {
    var scr: int64 := edScr();
    var akku: int64 := scr + ES_ACC;
    var summe: int64 := scr + ES_ADD;
    var wahl: int64 := scr + ES_P3;
    ptNull(akku);
    var i: int64 := 255;
    while (i >= 0) {
        ptDbl(akku, akku);
        var bit: int64 := (peek8(k + (i / 8)) >> (i % 8)) & 1;
        if (ct) {
            ptAdd(summe, akku, p);
            ptSelect(wahl, summe, akku, 0 - bit);
            ptCopy(akku, wahl);
        } else {
            if (bit == 1) {
                ptAdd(summe, akku, p);
                ptCopy(akku, summe);
            }
        }
        i -= 1;
    }
    ptCopy(r, akku);
}

// Punkt nach 32 Byte little-endian kodieren (y mit Vorzeichenbit von x).
fn ptEncode(out: int64, p: int64): void {
    var scr: int64 := edScr();
    var zi: int64 := scr + ES_T1;
    var x: int64 := scr + ES_T2;
    var y: int64 := scr + ES_T3;
    var normal: int64 := scr + ES_T4;
    feInv(zi, p + 2 * EW);
    feMul(x, p + 0 * EW, zi);
    feMul(y, p + 1 * EW, zi);
    var n0: int64 := BnMontN0(peek64(feP()));
    BnFromMont(normal, y, feP(), ED_GLIEDER, n0);
    // little-endian ausgeben
    var puf: int64 := scr + ES_MSGP;
    BnToBytes(puf, normal, ED_GLIEDER);
    var i: int64 := 0;
    while (i < 32) { poke8(out + i, peek8(puf + 31 - i)); i := i + 1; }
    // Vorzeichenbit: unterstes Bit von x
    var xn: int64 := scr + ES_T5;
    BnFromMont(xn, x, feP(), ED_GLIEDER, n0);
    var vz: int64 := peek64(xn) & 1;
    poke8(out + 31, (peek8(out + 31) & 0x7F) | ((vz & 1) << 7));
}

// 32 Byte little-endian in einen Punkt zurueckrechnen. Liefert false, wenn
// der Wert kein Punkt der Kurve ist (RFC 8032 §5.1.3).
fn ptDecode(p: int64, enc: int64): bool {
    edInit();
    var scr: int64 := edScr();
    var n0: int64 := BnMontN0(peek64(feP()));
    var puf: int64 := scr + ES_MSGP;
    var i: int64 := 0;
    while (i < 32) { poke8(puf + i, peek8(enc + 31 - i)); i := i + 1; }
    var vzBit: int64 := (peek8(enc + 31) >> 7) & 1;
    poke8(puf, peek8(puf) & 0x7F);
    var y: int64 := scr + ES_T1;
    if (!BnFromBytes(y, ED_GLIEDER, puf, 32)) { return false; }
    // y muss kleiner als p sein — nicht kanonische Kodierungen abweisen.
    if (BnCmp(y, feP(), ED_GLIEDER) >= 0) { return false; }
    var yM: int64 := scr + ES_T2;
    BnToMont(yM, y, feP(), ED_GLIEDER, n0, scr + ES_R2);

    // x^2 = (y^2 - 1) / (d*y^2 + 1)
    var y2: int64 := scr + ES_T3;
    feSq(y2, yM);
    var u: int64 := scr + ES_T4;
    feSub(u, y2, scr + ES_EINS);
    var v: int64 := scr + ES_T5;
    feMul(v, y2, scr + ES_D);
    feAdd(v, v, scr + ES_EINS);
    var vi: int64 := scr + ES_T6;
    feInv(vi, v);
    var x2: int64 := scr + ES_T7;
    feMul(x2, u, vi);

    // x = x2^((p+3)/8); wenn x^2 != x2, mit sqrt(-1) nachziehen
    var x: int64 := scr + ES_DEC;
    fePow2523(x, x2);
    feMul(x, x, x2);                              // x2^((p+3)/8)
    var pruef: int64 := scr + ES_DEC + EW;
    feSq(pruef, x);
    var diff: int64 := scr + ES_DEC + 2 * EW;
    feSub(diff, pruef, x2);
    if (feIsZero(diff) != -1) {
        feMul(x, x, scr + ES_SQRTM1);
        feSq(pruef, x);
        feSub(diff, pruef, x2);
        if (feIsZero(diff) != -1) { return false; }   // kein Quadrat -> kein Punkt
    }
    // Vorzeichen anpassen
    var xn: int64 := scr + ES_DEC + 3 * EW;
    BnFromMont(xn, x, feP(), ED_GLIEDER, n0);
    if ((peek64(xn) & 1) != vzBit) { feNeg(x, x); }
    // x == 0 und Vorzeichenbit 1 ist unzulaessig
    if (feIsZero(x) == -1 && vzBit == 1) { return false; }

    feCopy(p + 0 * EW, x);
    feCopy(p + 1 * EW, yM);
    BnCopy(p + 2 * EW, scr + ES_EINS, ED_GLIEDER);
    feMul(p + 3 * EW, x, yM);
    return true;
}

// ---------------------------------------------------------------------------
// Skalare mod L — Barrett-Reduktion ueber BnMul
// ---------------------------------------------------------------------------

// r (4 Glieder) := x (8 Glieder) mod L
fn scReduce(r: int64, x: int64): void {
    var scr: int64 := edScr();
    var L: int64 := scr + ES_L;
    var mu: int64 := scr + ES_MU;
    var q: int64 := scr + ES_BNY;       // bis 10 Glieder
    var t: int64 := scr + ES_BNZ;

    // q1 = floor(x / 2^252) — hier grob ueber ganze Glieder: wir rechnen
    // q = floor(x * mu / 2^512) mit mu = floor(2^512 / L). Die Multiplikation
    // laeuft ueber BnMul mit 8 Gliedern (mu hat 5, wird aufgefuellt).
    var mu8: int64 := scr + ES_SCR1;
    BnZero(mu8, 8);
    BnCopy(mu8, mu, 5);
    var x8: int64 := scr + ES_SCR2;
    BnCopy(x8, x, 8);
    BnMul(q, x8, mu8, 8);               // 16 Glieder
    // q >> 512 heisst: die oberen 8 Glieder
    var qh: int64 := q + 8 * 8;
    // t = qh * L (4 Glieder * 4 -> 8), danach x - t
    var L8: int64 := scr + ES_SCR3;
    BnZero(L8, 8);
    BnCopy(L8, L, 4);
    BnMul(t, qh, L8, 8);
    var diff: int64 := scr + ES_BNX;
    BnSub(diff, x8, t, 8);
    // Rest ist < 2L bis 3L; bis zu drei bedingte Subtraktionen
    var L8b: int64 := scr + ES_SCR3;
    var k: int64 := 0;
    while (k < 4) {
        var maske: int64 := feGeMaske8(diff, L8b);
        BnSubCond(diff, L8b, 8, maske);
        k += 1;
    }
    BnCopy(r, diff, 4);
}

fn feGeMaske8(a: int64, b: int64): int64 {
    var c: int64 := 0;
    var i: int64 := 0;
    while (i < 8) {
        var x: int64 := peek64(a + i * 8);
        var y: int64 := peek64(b + i * 8);
        var d: int64 := x - y;
        var b1: int64 := ((((y & d) | ((y | d) & (x ^ 0xFFFFFFFFFFFFFFFF)))) as uint64) >> 63;
        var d2: int64 := d - c;
        var b2: int64 := ((((c & d2) | ((c | d2) & (d ^ 0xFFFFFFFFFFFFFFFF)))) as uint64) >> 63;
        c := b1 + b2;
        i += 1;
    }
    return CTIsZero(c);
}

// r := (a * b + c) mod L, alle 4 Glieder
fn scMulAdd(r: int64, a: int64, b: int64, c: int64): void {
    var scr: int64 := edScr();
    var prod: int64 := scr + ES_BNY;
    var a8: int64 := scr + ES_SCR1;
    var b8: int64 := scr + ES_SCR2;
    BnZero(a8, 8); BnCopy(a8, a, 4);
    BnZero(b8, 8); BnCopy(b8, b, 4);
    BnMul(prod, a8, b8, 8);                 // 16 Glieder, obere sind 0
    var summe: int64 := scr + ES_BNZ;
    BnZero(summe, 8);
    BnCopy(summe, prod, 8);
    var c8: int64 := scr + ES_SCR3;
    BnZero(c8, 8); BnCopy(c8, c, 4);
    BnAdd(summe, summe, c8, 8);
    scReduce(r, summe);
}

// 32 Byte little-endian in ein Gliedfeld (4 Glieder)
fn leNachBn(r: int64, le: int64, len: int64): void {
    var scr: int64 := edScr();
    var puf: int64 := scr + ES_MSGP;
    var i: int64 := 0;
    while (i < len) { poke8(puf + i, peek8(le + len - 1 - i)); i := i + 1; }
    BnFromBytes(r, (len + 7) / 8, puf, len);
}

fn bnNachLe(le: int64, a: int64, glieder: int64): void {
    var scr: int64 := edScr();
    var puf: int64 := scr + ES_MSGP;
    BnToBytes(puf, a, glieder);
    var i: int64 := 0;
    while (i < glieder * 8) { poke8(le + i, peek8(puf + glieder * 8 - 1 - i)); i := i + 1; }
}

// ---------------------------------------------------------------------------
// Oeffentliche API
// ---------------------------------------------------------------------------

// a = clamp(SHA-512(seed)[0..31]) nach RFC 8032 §5.1.5
fn geheimerSkalar(seed: int64, h: int64, aOut: int64): void {
    Sha512(seed, 32, h);
    var i: int64 := 0;
    while (i < 32) { poke8(aOut + i, peek8(h + i)); i := i + 1; }
    poke8(aOut, peek8(aOut) & 248);
    poke8(aOut + 31, (peek8(aOut + 31) & 127) | 64);
}

pub fn Ed25519PubAusSeed(seed: int64, pk: int64): void {
    edInit();
    var scr: int64 := edScr();
    var h: int64 := scr + ES_H;
    var a: int64 := scr + ES_SA;
    geheimerSkalar(seed, h, a);
    var A: int64 := scr + ES_P1;
    ptScalarMul(A, a, scr + ES_BASE, true);
    ptEncode(pk, A);
    SecureZero(a, 32);
    SecureZero(h, 64);
}

// Signatur: 64 Byte (R || S)
pub fn Ed25519Sign(seed: int64, msg: int64, msgLen: int64, sig: int64): void {
    edInit();
    var scr: int64 := edScr();
    var h: int64 := scr + ES_H;
    var a: int64 := scr + ES_SA;
    geheimerSkalar(seed, h, a);
    var praefix: int64 := scr + ES_SPRE;
    var i: int64 := 0;
    while (i < 32) { poke8(praefix + i, peek8(h + 32 + i)); i := i + 1; }

    var pk: int64 := scr + ES_SPK;
    var A: int64 := scr + ES_P1;
    ptScalarMul(A, a, scr + ES_BASE, true);
    ptEncode(pk, A);

    // r = SHA-512(praefix || M) mod L
    var ctx: int64 := alloc(Sha512CtxSize());
    if (ctx == 0) { panic("ed25519: kein Speicher"); }
    var h2: int64 := scr + ES_H2;
    Sha512Init(ctx);
    Sha512Update(ctx, praefix, 32);
    Sha512Update(ctx, msg, msgLen);
    Sha512Final(ctx, h2);
    var rBn: int64 := scr + ES_BNX;
    leNachBn(rBn, h2, 64);
    var rRed: int64 := scr + ES_SR;
    scReduce(rRed, rBn);
    var rLe: int64 := scr + ES_SRLE;
    bnNachLe(rLe, rRed, 4);

    // R = [r] B
    var R: int64 := scr + ES_P2;
    ptScalarMul(R, rLe, scr + ES_BASE, true);
    ptEncode(sig, R);

    // k = SHA-512(R || A || M) mod L
    Sha512Init(ctx);
    Sha512Update(ctx, sig, 32);
    Sha512Update(ctx, pk, 32);
    Sha512Update(ctx, msg, msgLen);
    Sha512Final(ctx, h2);
    var kBn: int64 := scr + ES_BNX;
    leNachBn(kBn, h2, 64);
    var kRed: int64 := scr + ES_SK;
    scReduce(kRed, kBn);

    // S = (r + k*a) mod L
    var aBn: int64 := scr + ES_SAB;
    leNachBn(aBn, a, 32);
    var S: int64 := scr + ES_SS;
    scMulAdd(S, kRed, aBn, rRed);
    bnNachLe(sig + 32, S, 4);

    free(ctx, Sha512CtxSize());
    SecureZero(a, 32);
    SecureZero(aBn, 32);
    SecureZero(praefix, 32);
    SecureZero(h, 64);
}

pub fn Ed25519Verify(sig: int64, msg: int64, msgLen: int64, pk: int64): bool {
    edInit();
    var scr: int64 := edScr();

    // S < L pruefen (RFC 8032 §5.1.7: abweisen, nicht reduzieren)
    var S: int64 := scr + ES_SS;
    leNachBn(S, sig + 32, 32);
    if (BnCmp(S, scr + ES_L, 4) >= 0) { return false; }

    var A: int64 := scr + ES_P1;
    if (!ptDecode(A, pk)) { return false; }
    var R: int64 := scr + ES_P2;
    if (!ptDecode(R, sig)) { return false; }

    // k = SHA-512(R || A || M) mod L
    var ctx: int64 := alloc(Sha512CtxSize());
    if (ctx == 0) { panic("ed25519: kein Speicher"); }
    var h2: int64 := scr + ES_H2;
    Sha512Init(ctx);
    Sha512Update(ctx, sig, 32);
    Sha512Update(ctx, pk, 32);
    Sha512Update(ctx, msg, msgLen);
    Sha512Final(ctx, h2);
    free(ctx, Sha512CtxSize());
    var kBn: int64 := scr + ES_BNX;
    leNachBn(kBn, h2, 64);
    var kRed: int64 := scr + ES_SK;
    scReduce(kRed, kBn);
    var kLe: int64 := scr + ES_SKLE;
    bnNachLe(kLe, kRed, 4);
    var sLe: int64 := scr + ES_SSLE;
    bnNachLe(sLe, S, 4);

    // [S]B == R + [k]A — beide Skalare sind oeffentlich.
    var links: int64 := scr + ES_P3;
    ptScalarMul(links, sLe, scr + ES_BASE, false);
    var kA: int64 := scr + ES_P4;
    ptScalarMul(kA, kLe, A, false);
    var rechts: int64 := scr + ES_ACC;
    ptAdd(rechts, R, kA);

    var e1: int64 := scr + ES_SPK;
    var e2: int64 := scr + ES_SA;
    ptEncode(e1, links);
    ptEncode(e2, rechts);
    return CTMemEqual(e1, e2, 32) == -1;
}

// 1.3.101.112 Ed25519
fn edOid(p: int64): int64 {
    poke8(p + 0, 0x2b); poke8(p + 1, 0x65); poke8(p + 2, 0x70);
    return 3;
}

// Oeffentlicher Schluessel aus SubjectPublicKeyInfo
pub fn Ed25519PubAusSpki(der: int64, derLen: int64, pk: int64): bool {
    var fg: int64 := DerFeldGroesse();
    var scr: int64 := edScr();
    var f: int64 := scr + ES_MSGP;             // Felder im Kratzbereich
    var g: int64 := f + fg;
    var h: int64 := g + fg;
    var ob: int64 := scr + ES_SCR3;
    var pp: int64 := scr + ES_SCR3 + 16;
    var ll: int64 := pp + 8;
    if (!DerLies(der, derLen, 0, f)) { return false; }
    if (DerTag(f) != 0x30) { return false; }
    var ende: int64 := DerInhalt(f) + DerInhaltLen(f);
    if (!DerLies(der, ende, DerInhalt(f), g)) { return false; }
    if (DerTag(g) != 0x30) { return false; }
    var algEnde: int64 := DerInhalt(g) + DerInhaltLen(g);
    if (!DerLies(der, algEnde, DerInhalt(g), h)) { return false; }
    if (DerTag(h) != 0x06) { return false; }
    if (!DerOidGleich(der, h, ob, edOid(ob))) { return false; }
    if (!DerLies(der, ende, DerNaechste(g), h)) { return false; }
    if (DerTag(h) != 0x03) { return false; }
    if (!DerBitKette(der, h, pp, ll)) { return false; }
    if (peek64(ll) != 32) { return false; }
    var i: int64 := 0;
    while (i < 32) { poke8(pk + i, peek8(der + peek64(pp) + i)); i := i + 1; }
    return true;
}

// Seed aus PKCS#8 (PrivateKeyInfo, privateKey ist ein OCTET STRING, der
// seinerseits einen OCTET STRING mit 32 Byte enthaelt — RFC 8410 §7).
pub fn Ed25519PrivAusPkcs8(der: int64, derLen: int64, seed: int64): bool {
    var fg: int64 := DerFeldGroesse();
    var scr: int64 := edScr();
    var f: int64 := scr + ES_MSGP;
    var g: int64 := f + fg;
    var h: int64 := g + fg;
    var ob: int64 := scr + ES_SCR3;
    if (!DerLies(der, derLen, 0, f)) { return false; }
    if (DerTag(f) != 0x30) { return false; }
    var ende: int64 := DerInhalt(f) + DerInhaltLen(f);
    if (!DerLies(der, ende, DerInhalt(f), g)) { return false; }
    if (DerTag(g) != 0x02) { return false; }
    if (!DerLies(der, ende, DerNaechste(g), g)) { return false; }
    if (DerTag(g) != 0x30) { return false; }
    var algEnde: int64 := DerInhalt(g) + DerInhaltLen(g);
    if (!DerLies(der, algEnde, DerInhalt(g), h)) { return false; }
    if (DerTag(h) != 0x06) { return false; }
    if (!DerOidGleich(der, h, ob, edOid(ob))) { return false; }
    if (!DerLies(der, ende, DerNaechste(g), g)) { return false; }
    if (DerTag(g) != 0x04) { return false; }
    var innen: int64 := DerInhalt(g) + DerInhaltLen(g);
    if (!DerLies(der, innen, DerInhalt(g), h)) { return false; }
    if (DerTag(h) != 0x04) { return false; }
    if (DerInhaltLen(h) != 32) { return false; }
    var i: int64 := 0;
    while (i < 32) { poke8(seed + i, peek8(der + DerInhalt(h) + i)); i := i + 1; }
    return true;
}
