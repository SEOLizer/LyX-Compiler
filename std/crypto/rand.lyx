// std/crypto/rand.lyx — Kryptographisch sichere Zufallszahlen (WP-BL-01)
//
// Nutzt den getrandom(2)-Syscall (Linux ≥ 3.17, x86-64 Nr. 318).
// getrandom blockiert bis der Kernel-Entropie-Pool initialisiert ist,
// danach wird der CSPRNG des Kernels verwendet — kein /dev/urandom-FD nötig.
//
// Public API:
//   RandBytes(buf: int64, len: int64): int64
//       Füllt buf mit len kryptographisch sicheren Zufallsbytes.
//       Gibt die tatsächlich geschriebene Byte-Anzahl zurück (>0) oder
//       einen negativen errno-Wert bei Fehler.
//
//   RandBytesExact(buf: int64, len: int64): int64
//       Wie RandBytes, aber ruft solange nach bis exakt len Bytes gelesen
//       wurden. Gibt len zurück oder einen negativen Wert bei Fehler.
//
//   RandInt64(): int64
//       Gibt einen kryptographisch sicheren zufälligen int64 zurück.
//       Gibt 0 zurück wenn getrandom fehlschlägt (Fehlerbehandlung obliegt
//       dem Aufrufer; 0 kommt mit Wahrscheinlichkeit 1/2^64 vor).
//
//   RandU32(): int64
//       Gibt einen kryptographisch sicheren zufälligen uint32 (0..2^32-1).
//
// #2392: Hardware-Entropie (RDRAND/RDSEED) kommt HINZU, sie ersetzt nichts.
//
//   RandHwRdrand(out: int64): int64   1 = Wert geschrieben, 0 = Fehlschlag
//   RandHwRdseed(out: int64): int64   dasselbe fuer RDSEED
//   RandHwVorhanden(): int64          Faehigkeitsabfrage (CPUID)
//   RandHwMischen(an: int64)          Einmischen ein-/ausschalten
//
// Die Rolle ist bewusst festgelegt: **getrandom(2) bleibt die Quelle.** Der
// Kernel-Pool sammelt aus vielen Ereignissen, laeuft auch in einer VM und ist
// ueberpruefbar; RDRAND ist eine einzelne, nicht beobachtbare Hardwarequelle
// (und war mit der AMD-Fn-14h-Erratum-Fassung schon einmal kaputt). Die
// Hardwarewoerter werden deshalb per XOR EINGEMISCHT: XOR mit einem
// unabhaengigen Wert kann die Qualitaet des Ergebnisses nicht senken, nur
// ergaenzen — selbst wenn die Hardwarequelle vorhersagbar oder konstant ist,
// bleibt die Zufaelligkeit von getrandom erhalten.
//
// Ein Fehlschlag der Hardwarequelle laesst die getrandom-Bytes unveraendert;
// er darf die Hauptquelle nicht entwerten. Ein Fehlschlag von getrandom
// bleibt laut (RandInt64 bricht ab) — daran aendert das Einmischen nichts.
@capabilities([system.rand])

unit std.crypto.rand;

import std.cpu.features;   // #2392: CpuHasRDRAND / CpuHasRDSEED

// ============================================================================
// Flags für sys_getrandom (aus linux/random.h)
// ============================================================================

pub con GRND_NONBLOCK: int64 := 1;  // EAGAIN statt blockieren wenn Pool leer
pub con GRND_RANDOM:   int64 := 2;  // aus /dev/random statt /dev/urandom

// ============================================================================
// Public API
// ============================================================================

// Füllt buf mit bis zu len Zufallsbytes via getrandom(2), flags=0 (blockierend).
// Rückgabe: Anzahl geschriebener Bytes (kann < len sein), oder negatives errno.
pub fn RandBytes(buf: int64, len: int64): int64 {
    if (len <= 0) { return 0; }
    return sys_getrandom(buf, len, 0);
}

// ============================================================================
// #2392: Hardware-Entropie
// ============================================================================

// Ergebnis der CPUID-Abfrage, einmal gemessen. Das Flag ist noetig, weil 0
// ein gueltiges Ergebnis ist (auf jeder Nicht-x86-Architektur ist es das
// richtige).
var _rndHw: int64 := 0;
var _rndHwGeprueft: int64 := 0;
// Einmischen eingeschaltet? Vorgabe: ja, sobald die CPU es kann.
var _rndMischen: int64 := 1;

// Hat die CPU RDRAND? (RDSEED wird getrennt gefragt, siehe RandHwRdseed.)
pub fn RandHwVorhanden(): int64 {
    if (_rndHwGeprueft == 0) {
        _rndHwGeprueft := 1;
        if (CpuHasRDRAND() != 0) { _rndHw := 1; }
    }
    return _rndHw;
}

// Einmischen ein- (1) oder ausschalten (0). Gebraucht wird der Schalter, um
// BEIDE Seiten messen zu koennen: ohne ihn ist der Weg ohne Hardwarequelle
// auf einer CPU mit RDRAND nicht erreichbar (#1823).
pub fn RandHwMischen(an: int64): void {
    if (an != 0) { _rndMischen := 1; } else { _rndMischen := 0; }
}

// Ein 64-Bit-Wort aus RDRAND nach `out`. Rueckgabe 1 bei Erfolg, 0 sonst.
//
// Intel verlangt eine begrenzte Wiederholung: der Befehl kann die Anforderung
// abweisen, wenn der Puffer des Generators gerade leer ist (CF == 0), und die
// Vorgabe lautet **bis zu zehn Versuche**. Danach wird LAUT aufgegeben (0)
// statt einen halben oder alten Wert zu liefern. Wer die 0 ignoriert und den
// Zielpuffer trotzdem liest, bekommt die vom Befehl geschriebene Null — und
// genau darum gibt diese Funktion den Erfolg zurueck und nicht den Wert.
pub fn RandHwRdrand(out: int64): int64 {
    if (RandHwVorhanden() == 0) { return 0; }
    var versuch: int64 := 0;
    while (versuch < 10) {
        if (rdrand64(out) != 0) { return 1; }
        versuch += 1;
    }
    return 0;
}

// Ein 64-Bit-Wort aus RDSEED nach `out`. Rueckgabe 1 bei Erfolg, 0 sonst.
//
// RDSEED zieht aus der ROHEN Entropiequelle und weist haeufiger ab als
// RDRAND — Intel empfiehlt dazwischen eine Pause und keine engmaschige
// Wiederholung. Hier stehen zehn Versuche mit je einer kurzen Pause
// (`cpu_pause`); danach laut 0. RDSEED hat ein eigenes CPUID-Bit, das hier
// getrennt gefragt wird: eine CPU mit RDRAND muss kein RDSEED haben
// (Ivy Bridge hat RDRAND, erst Broadwell RDSEED).
pub fn RandHwRdseed(out: int64): int64 {
    if (CpuHasRDSEED() == 0) { return 0; }
    var versuch: int64 := 0;
    while (versuch < 10) {
        if (rdseed64(out) != 0) { return 1; }
        cpu_pause();
        versuch += 1;
    }
    return 0;
}

// Füllt buf mit exakt len Zufallsbytes; wiederholt den Syscall falls nötig.
// Rückgabe: len bei Erfolg, negativer errno-Wert bei Fehler.
//
// #2392: Nach dem Fuellen wird — wenn die CPU es kann und das Einmischen
// eingeschaltet ist — wortweise ein RDRAND-Wert per XOR eingemischt. Scheitert
// RDRAND, bleibt das Wort unveraendert; die Hauptquelle wird dadurch nicht
// schlechter.
pub fn RandBytesExact(buf: int64, len: int64): int64 {
    if (len <= 0) { return 0; }
    var done: int64 := 0;
    while (done < len) {
        var n: int64 := sys_getrandom(buf + done, len - done, 0);
        if (n < 0) { return n; }
        done += n;
    }
    if (_rndMischen != 0 && RandHwVorhanden() != 0) {
        var hw: int64 := mmap(0, 8, 3, 34, -1, 0);
        if (hw > 0) {
            var pos: int64 := 0;
            while (pos + 8 <= len) {
                if (RandHwRdrand(hw) != 0) {
                    poke64(buf + pos, peek64(buf + pos) ^ peek64(hw));
                }
                pos += 8;
            }
            // Der Schwanz unter acht Byte wird byteweise gemischt, damit auch
            // kurze Anforderungen (12-Byte-Nonce) den Beitrag bekommen.
            if (pos < len && RandHwRdrand(hw) != 0) {
                var w: int64 := peek64(hw);
                var i: int64 := 0;
                while (pos + i < len) {
                    poke8(buf + pos + i, peek8(buf + pos + i) ^ ((w >> (i * 8)) & 255));
                    i += 1;
                }
            }
            munmap(hw, 8);
        }
    }
    return len;
}

// Gibt einen kryptographisch sicheren zufälligen int64 zurück.
// Bei Fehler wird 0 zurückgegeben.
pub fn RandInt64(): int64 {
    var buf: int64 := mmap(0, 8, 3, 34, -1, 0);
    var rc:  int64 := RandBytesExact(buf, 8);
    // WP-37: kein Silent-0 bei getrandom-Fehler. Vorhersagbare "Zufalls"-Werte
    // (0) sind gefährlicher als ein Abbruch — bei rc != 8 hart abbrechen.
    if (rc != 8) { exit(1); }
    var v: int64 := peek64(buf);
    munmap(buf, 8);
    return v;
}

// Gibt einen kryptographisch sicheren zufälligen uint32 (0..2^32-1) zurück.
pub fn RandU32(): int64 {
    return RandInt64() & 0xFFFFFFFF;
}
