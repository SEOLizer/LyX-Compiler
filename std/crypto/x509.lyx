// std/crypto/x509.lyx — X.509v3-Zertifikate lesen und pruefen (RFC 5280)
//
// Teil von #2096 (natives TLS ohne OpenSSL). Gelesen wird streng ueber
// std.crypto.der; alles Unklare wird abgewiesen statt plausibel geraten.
//
// Der Parser schreibt einen festen Satz von Feldern in einen vom Aufrufer
// gestellten Block (X509Groesse() Byte). Es wird NICHTS kopiert: alle
// Zeichenketten bleiben Ausschnitte (Position, Laenge) im uebergebenen
// DER-Puffer, der also so lange leben muss wie der Satz.
//
// Zahlenwerte (bewusst kein Enum: `as` in einen Enum prueft nichts, #1884):
//   Signaturverfahren X509SigAlg / X509SpkiAlg
//     0 unbekannt
//     1 ecdsa-with-SHA256        2 ecdsa-with-SHA384
//     3 sha256WithRSAEncryption  4 sha384WithRSA  5 sha512WithRSA
//     6 RSASSA-PSS               7 Ed25519
//   Schluesselart X509KeyAlg
//     0 unbekannt  1 EC secp256r1  2 EC secp384r1  3 RSA  4 Ed25519
//   KeyUsage (X509KeyUsage): Bit 0 digitalSignature .. Bit 8 decipherOnly
//   ExtKeyUsage (X509Eku): 1 serverAuth, 2 clientAuth, 4 codeSigning,
//     8 emailProtection, 16 timeStamping, 32 OCSPSigning, 64 anyExtendedKeyUsage
//   SAN-Art: 1 rfc822Name, 2 dNSName, 6 URI, 7 iPAddress
//
// Oeffentliche API (Auszug):
//   X509Groesse() / X509Lies(der, derLen, satz): bool
//   X509TbsPos/X509TbsLen/X509SigPos/X509SigLen/X509SigAlg
//   X509IssuerPos/Len, X509SubjectPos/Len (ganzes Name-TLV, fuer den
//     bytegenauen Vergleich Aussteller == Subjekt des naechsten Gliedes)
//   X509NotBefore/X509NotAfter (Unix-Zeit)
//   X509KeyAlg, X509PubKeyPos/Len
//   X509IstCA, X509PfadLen, X509KeyUsage, X509Eku, X509HatBasicConstraints
//   X509SanAnzahl, X509SanAt(satz, i, artPtr, posPtr, lenPtr): bool
//   X509PasstName(satz, host, hostLen): bool   — RFC 6125
//   X509IstSelbstAusgestellt(satz): bool
//   X509NameGleich(derA, posA, lenA, derB, posB, lenB): bool

unit std.crypto.x509;

import std.alloc;
import std.crypto.der;

con X_DER:      int64 := 0;
con X_DERLEN:   int64 := 8;
con X_VERSION:  int64 := 16;
con X_SERPOS:   int64 := 24;
con X_SERLEN:   int64 := 32;
con X_TBSPOS:   int64 := 40;
con X_TBSLEN:   int64 := 48;
con X_SIGALG:   int64 := 56;
con X_SIGPOS:   int64 := 64;
con X_SIGLEN:   int64 := 72;
con X_ISSPOS:   int64 := 80;
con X_ISSLEN:   int64 := 88;
con X_SUBPOS:   int64 := 96;
con X_SUBLEN:   int64 := 104;
con X_NBEFORE:  int64 := 112;
con X_NAFTER:   int64 := 120;
con X_KEYALG:   int64 := 128;
con X_KEYPOS:   int64 := 136;
con X_KEYLEN:   int64 := 144;
con X_ISCA:     int64 := 152;
con X_PATHLEN:  int64 := 160;
con X_KU:       int64 := 168;
con X_EKU:      int64 := 176;
con X_HASBC:    int64 := 184;
con X_SANPOS:   int64 := 192;
con X_SANLEN:   int64 := 200;
con X_SIZE:     int64 := 208;

pub fn X509Groesse(): int64 { return X_SIZE; }

pub fn X509TbsPos(s: int64): int64 { return peek64(s + X_TBSPOS); }
pub fn X509TbsLen(s: int64): int64 { return peek64(s + X_TBSLEN); }
pub fn X509SigPos(s: int64): int64 { return peek64(s + X_SIGPOS); }
pub fn X509SigLen(s: int64): int64 { return peek64(s + X_SIGLEN); }
pub fn X509SigAlg(s: int64): int64 { return peek64(s + X_SIGALG); }
pub fn X509IssuerPos(s: int64): int64 { return peek64(s + X_ISSPOS); }
pub fn X509IssuerLen(s: int64): int64 { return peek64(s + X_ISSLEN); }
pub fn X509SubjectPos(s: int64): int64 { return peek64(s + X_SUBPOS); }
pub fn X509SubjectLen(s: int64): int64 { return peek64(s + X_SUBLEN); }
pub fn X509NotBefore(s: int64): int64 { return peek64(s + X_NBEFORE); }
pub fn X509NotAfter(s: int64): int64 { return peek64(s + X_NAFTER); }
pub fn X509KeyAlg(s: int64): int64 { return peek64(s + X_KEYALG); }
pub fn X509PubKeyPos(s: int64): int64 { return peek64(s + X_KEYPOS); }
pub fn X509PubKeyLen(s: int64): int64 { return peek64(s + X_KEYLEN); }
pub fn X509IstCA(s: int64): bool { return peek64(s + X_ISCA) != 0; }
pub fn X509PfadLen(s: int64): int64 { return peek64(s + X_PATHLEN); }
pub fn X509KeyUsage(s: int64): int64 { return peek64(s + X_KU); }
pub fn X509Eku(s: int64): int64 { return peek64(s + X_EKU); }
pub fn X509HatBasicConstraints(s: int64): bool { return peek64(s + X_HASBC) != 0; }
pub fn X509Version(s: int64): int64 { return peek64(s + X_VERSION); }
pub fn X509SerienNrPos(s: int64): int64 { return peek64(s + X_SERPOS); }
pub fn X509SerienNrLen(s: int64): int64 { return peek64(s + X_SERLEN); }
pub fn X509DerPuffer(s: int64): int64 { return peek64(s + X_DER); }
pub fn X509DerLen(s: int64): int64 { return peek64(s + X_DERLEN); }

// ---------------------------------------------------------------------------
// OIDs als Bytefolgen (Inhalt ohne Tag/Laenge)
// ---------------------------------------------------------------------------

fn oidSchreib(p: int64, b: pchar, n: int64): void {
    var i: int64 := 0;
    while (i < n) { poke8(p + i, StrCharAt(b, i)); i := i + 1; }
}

// 1.2.840.10045.4.3.2 ecdsa-with-SHA256
fn oidEcdsaSha256(p: int64): int64 {
    poke8(p + 0, 0x2a); poke8(p + 1, 0x86); poke8(p + 2, 0x48); poke8(p + 3, 0xce);
    poke8(p + 4, 0x3d); poke8(p + 5, 0x04); poke8(p + 6, 0x03); poke8(p + 7, 0x02);
    return 8;
}
// 1.2.840.10045.4.3.3 ecdsa-with-SHA384
fn oidEcdsaSha384(p: int64): int64 {
    poke8(p + 0, 0x2a); poke8(p + 1, 0x86); poke8(p + 2, 0x48); poke8(p + 3, 0xce);
    poke8(p + 4, 0x3d); poke8(p + 5, 0x04); poke8(p + 6, 0x03); poke8(p + 7, 0x03);
    return 8;
}
// 1.2.840.113549.1.1.11 sha256WithRSAEncryption
fn oidRsaSha256(p: int64): int64 {
    poke8(p + 0, 0x2a); poke8(p + 1, 0x86); poke8(p + 2, 0x48); poke8(p + 3, 0x86);
    poke8(p + 4, 0xf7); poke8(p + 5, 0x0d); poke8(p + 6, 0x01); poke8(p + 7, 0x01);
    poke8(p + 8, 0x0b);
    return 9;
}
// 1.2.840.113549.1.1.12 sha384WithRSAEncryption
fn oidRsaSha384(p: int64): int64 {
    oidRsaSha256(p); poke8(p + 8, 0x0c); return 9;
}
// 1.2.840.113549.1.1.13 sha512WithRSAEncryption
fn oidRsaSha512(p: int64): int64 {
    oidRsaSha256(p); poke8(p + 8, 0x0d); return 9;
}
// 1.2.840.113549.1.1.10 RSASSA-PSS
fn oidRsaPss(p: int64): int64 {
    oidRsaSha256(p); poke8(p + 8, 0x0a); return 9;
}
// 1.3.101.112 Ed25519
fn oidEd25519(p: int64): int64 {
    poke8(p + 0, 0x2b); poke8(p + 1, 0x65); poke8(p + 2, 0x70);
    return 3;
}
// 1.2.840.10045.2.1 id-ecPublicKey
fn oidEcPublicKey(p: int64): int64 {
    poke8(p + 0, 0x2a); poke8(p + 1, 0x86); poke8(p + 2, 0x48); poke8(p + 3, 0xce);
    poke8(p + 4, 0x3d); poke8(p + 5, 0x02); poke8(p + 6, 0x01);
    return 7;
}
// 1.2.840.113549.1.1.1 rsaEncryption
fn oidRsaEnc(p: int64): int64 {
    oidRsaSha256(p); poke8(p + 8, 0x01); return 9;
}
// 1.2.840.10045.3.1.7 prime256v1
fn oidP256(p: int64): int64 {
    poke8(p + 0, 0x2a); poke8(p + 1, 0x86); poke8(p + 2, 0x48); poke8(p + 3, 0xce);
    poke8(p + 4, 0x3d); poke8(p + 5, 0x03); poke8(p + 6, 0x01); poke8(p + 7, 0x07);
    return 8;
}
// 1.3.132.0.34 secp384r1
fn oidP384(p: int64): int64 {
    poke8(p + 0, 0x2b); poke8(p + 1, 0x81); poke8(p + 2, 0x04);
    poke8(p + 3, 0x00); poke8(p + 4, 0x22);
    return 5;
}
// 2.5.29.<n> — Erweiterungen (basicConstraints 19, keyUsage 15, SAN 17,
// extKeyUsage 37, nameConstraints 30, certificatePolicies 32)
fn oidExt(p: int64, n: int64): int64 {
    poke8(p + 0, 0x55); poke8(p + 1, 0x1d); poke8(p + 2, n);
    return 3;
}
// 1.3.6.1.5.5.7.3.<n> — EKU-Zwecke
fn oidEku(p: int64, n: int64): int64 {
    poke8(p + 0, 0x2b); poke8(p + 1, 0x06); poke8(p + 2, 0x01); poke8(p + 3, 0x05);
    poke8(p + 4, 0x05); poke8(p + 5, 0x07); poke8(p + 6, 0x03); poke8(p + 7, n);
    return 8;
}
// 2.5.29.37.0 anyExtendedKeyUsage
fn oidEkuAny(p: int64): int64 {
    poke8(p + 0, 0x55); poke8(p + 1, 0x1d); poke8(p + 2, 0x25); poke8(p + 3, 0x00);
    return 4;
}
// 2.5.4.3 commonName
fn oidCN(p: int64): int64 {
    poke8(p + 0, 0x55); poke8(p + 1, 0x04); poke8(p + 2, 0x03);
    return 3;
}

// ---------------------------------------------------------------------------
// Erweiterungen
// ---------------------------------------------------------------------------

// basicConstraints ::= SEQUENCE { cA BOOLEAN DEFAULT FALSE,
//                                pathLenConstraint INTEGER OPTIONAL }
fn extBasicConstraints(der: int64, derLen: int64, wertPos: int64, wertLen: int64,
                       satz: int64): bool {
    var f: int64 := alloc(DerFeldGroesse());
    var k: int64 := alloc(DerFeldGroesse());
    if (f == 0 || k == 0) { panic("X.509: kein Speicher"); }
    poke64(satz + X_HASBC, 1);
    poke64(satz + X_ISCA, 0);
    poke64(satz + X_PATHLEN, -1);

    if (!DerLies(der, wertPos + wertLen, wertPos, f)) { return false; }
    if (DerTag(f) != 0x30) { return false; }
    var ende: int64 := DerInhalt(f) + DerInhaltLen(f);
    var p: int64 := DerInhalt(f);
    if (p < ende) {
        if (!DerLies(der, ende, p, k)) { return false; }
        if (DerTag(k) == 0x01) {                       // BOOLEAN cA
            if (DerInhaltLen(k) != 1) { return false; }
            var b: int64 := peek8(der + DerInhalt(k)) & 0xFF;
            // DER kennt nur 0x00 und 0xFF (X.690 §11.1).
            if (b != 0 && b != 0xFF) { return false; }
            if (b == 0xFF) { poke64(satz + X_ISCA, 1); }
            p := DerNaechste(k);
        }
    }
    if (p < ende) {
        if (!DerLies(der, ende, p, k)) { return false; }
        if (DerTag(k) == 0x02) {
            var v: int64 := DerGanzzahl(der, ende, k);
            if (v < 0) { return false; }
            poke64(satz + X_PATHLEN, v);
        }
    }
    free(f, DerFeldGroesse());
    free(k, DerFeldGroesse());
    return true;
}

// keyUsage ::= BIT STRING; Bit 0 ist das hoechste Bit des ersten Byte.
fn extKeyUsage(der: int64, derLen: int64, wertPos: int64, wertLen: int64,
               satz: int64): bool {
    var f: int64 := alloc(DerFeldGroesse());
    if (f == 0) { panic("X.509: kein Speicher"); }
    if (!DerLies(der, wertPos + wertLen, wertPos, f)) { return false; }
    if (DerTag(f) != 0x03) { return false; }
    var len: int64 := DerInhaltLen(f);
    if (len < 1) { return false; }
    var unused: int64 := peek8(der + DerInhalt(f)) & 0xFF;
    if (unused > 7) { return false; }
    var bits: int64 := 0;
    var byteN: int64 := 1;
    while (byteN < len) {
        var b: int64 := peek8(der + DerInhalt(f) + byteN) & 0xFF;
        var i: int64 := 0;
        while (i < 8) {
            if (((b >> (7 - i)) & 1) != 0) { bits := bits | (1 << ((byteN - 1) * 8 + i)); }
            i += 1;
        }
        byteN += 1;
    }
    poke64(satz + X_KU, bits);
    free(f, DerFeldGroesse());
    return true;
}

// extKeyUsage ::= SEQUENCE OF OBJECT IDENTIFIER
fn extEku(der: int64, derLen: int64, wertPos: int64, wertLen: int64,
          satz: int64): bool {
    var f: int64 := alloc(DerFeldGroesse());
    var k: int64 := alloc(DerFeldGroesse());
    var ob: int64 := alloc(16);
    if (f == 0 || k == 0 || ob == 0) { panic("X.509: kein Speicher"); }
    if (!DerLies(der, wertPos + wertLen, wertPos, f)) { return false; }
    if (DerTag(f) != 0x30) { return false; }
    var ende: int64 := DerInhalt(f) + DerInhaltLen(f);
    var p: int64 := DerInhalt(f);
    var bits: int64 := 0;
    while (p < ende) {
        if (!DerLies(der, ende, p, k)) { return false; }
        if (DerTag(k) != 0x06) { return false; }
        var n: int64 := oidEku(ob, 1);
        if (DerOidGleich(der, k, ob, n)) { bits := bits | 1; }
        n := oidEku(ob, 2);
        if (DerOidGleich(der, k, ob, n)) { bits := bits | 2; }
        n := oidEku(ob, 3);
        if (DerOidGleich(der, k, ob, n)) { bits := bits | 4; }
        n := oidEku(ob, 4);
        if (DerOidGleich(der, k, ob, n)) { bits := bits | 8; }
        n := oidEku(ob, 8);
        if (DerOidGleich(der, k, ob, n)) { bits := bits | 16; }
        n := oidEku(ob, 9);
        if (DerOidGleich(der, k, ob, n)) { bits := bits | 32; }
        n := oidEkuAny(ob);
        if (DerOidGleich(der, k, ob, n)) { bits := bits | 64; }
        p := DerNaechste(k);
    }
    poke64(satz + X_EKU, bits);
    free(f, DerFeldGroesse());
    free(k, DerFeldGroesse());
    free(ob, 16);
    return true;
}

// ---------------------------------------------------------------------------
// Hauptparser
// ---------------------------------------------------------------------------

fn algKennung(der: int64, ende: int64, algFeld: int64): int64 {
    var k: int64 := alloc(DerFeldGroesse());
    var ob: int64 := alloc(16);
    if (k == 0 || ob == 0) { panic("X.509: kein Speicher"); }
    var erg: int64 := 0;
    if (DerErstesKind(der, ende, algFeld, k) && DerTag(k) == 0x06) {
        if (DerOidGleich(der, k, ob, oidEcdsaSha256(ob))) { erg := 1; }
        if (erg == 0 && DerOidGleich(der, k, ob, oidEcdsaSha384(ob))) { erg := 2; }
        if (erg == 0 && DerOidGleich(der, k, ob, oidRsaSha256(ob))) { erg := 3; }
        if (erg == 0 && DerOidGleich(der, k, ob, oidRsaSha384(ob))) { erg := 4; }
        if (erg == 0 && DerOidGleich(der, k, ob, oidRsaSha512(ob))) { erg := 5; }
        if (erg == 0 && DerOidGleich(der, k, ob, oidRsaPss(ob)))    { erg := 6; }
        if (erg == 0 && DerOidGleich(der, k, ob, oidEd25519(ob)))   { erg := 7; }
    }
    free(k, DerFeldGroesse());
    free(ob, 16);
    return erg;
}

// Liest das Zertifikat. Liefert false, sobald etwas nicht nach RFC 5280
// kodiert ist; der Satz ist dann nicht benutzbar.
pub fn X509Lies(der: int64, derLen: int64, satz: int64): bool {
    if (der == 0 || derLen <= 0 || satz == 0) { return false; }
    var i: int64 := 0;
    while (i < X_SIZE) { poke8(satz + i, 0); i := i + 1; }
    poke64(satz + X_DER, der);
    poke64(satz + X_DERLEN, derLen);
    poke64(satz + X_PATHLEN, -1);
    poke64(satz + X_VERSION, 1);

    var fg: int64 := DerFeldGroesse();
    var cert: int64 := alloc(fg);
    var tbs: int64 := alloc(fg);
    var f: int64 := alloc(fg);
    var g: int64 := alloc(fg);
    var h: int64 := alloc(fg);
    if (cert == 0 || tbs == 0 || f == 0 || g == 0 || h == 0) { panic("X.509: kein Speicher"); }

    if (!DerLies(der, derLen, 0, cert)) { return false; }
    if (DerTag(cert) != 0x30) { return false; }
    var certEnde: int64 := DerInhalt(cert) + DerInhaltLen(cert);

    // --- tbsCertificate (ganzes TLV wird fuer die Signatur gebraucht) ---
    if (!DerLies(der, certEnde, DerInhalt(cert), tbs)) { return false; }
    if (DerTag(tbs) != 0x30) { return false; }
    var tbsStart: int64 := DerInhalt(cert);
    poke64(satz + X_TBSPOS, tbsStart);
    poke64(satz + X_TBSLEN, DerNaechste(tbs) - tbsStart);
    var tbsEnde: int64 := DerInhalt(tbs) + DerInhaltLen(tbs);
    var p: int64 := DerInhalt(tbs);

    // --- version [0] EXPLICIT INTEGER DEFAULT v1 ---
    if (!DerLies(der, tbsEnde, p, f)) { return false; }
    if (DerTag(f) == 0xA0) {
        if (!DerErstesKind(der, tbsEnde, f, g)) { return false; }
        var v: int64 := DerGanzzahl(der, tbsEnde, g);
        if (v < 0 || v > 2) { return false; }
        poke64(satz + X_VERSION, v + 1);
        p := DerNaechste(f);
        if (!DerLies(der, tbsEnde, p, f)) { return false; }
    }

    // --- serialNumber ---
    if (DerTag(f) != 0x02) { return false; }
    poke64(satz + X_SERPOS, DerInhalt(f));
    poke64(satz + X_SERLEN, DerInhaltLen(f));
    p := DerNaechste(f);

    // --- signature (AlgorithmIdentifier im TBS) ---
    if (!DerLies(der, tbsEnde, p, f)) { return false; }
    if (DerTag(f) != 0x30) { return false; }
    var tbsSigAlg: int64 := algKennung(der, tbsEnde, f);
    p := DerNaechste(f);

    // --- issuer ---
    if (!DerLies(der, tbsEnde, p, f)) { return false; }
    if (DerTag(f) != 0x30) { return false; }
    poke64(satz + X_ISSPOS, p);
    poke64(satz + X_ISSLEN, DerNaechste(f) - p);
    p := DerNaechste(f);

    // --- validity ---
    if (!DerLies(der, tbsEnde, p, f)) { return false; }
    if (DerTag(f) != 0x30) { return false; }
    var vEnde: int64 := DerInhalt(f) + DerInhaltLen(f);
    if (!DerLies(der, vEnde, DerInhalt(f), g)) { return false; }
    var nb: int64 := DerZeitUnix(der, g);
    if (nb == -1) { return false; }
    if (!DerLies(der, vEnde, DerNaechste(g), h)) { return false; }
    var na: int64 := DerZeitUnix(der, h);
    if (na == -1) { return false; }
    if (na < nb) { return false; }
    poke64(satz + X_NBEFORE, nb);
    poke64(satz + X_NAFTER, na);
    p := DerNaechste(f);

    // --- subject ---
    if (!DerLies(der, tbsEnde, p, f)) { return false; }
    if (DerTag(f) != 0x30) { return false; }
    poke64(satz + X_SUBPOS, p);
    poke64(satz + X_SUBLEN, DerNaechste(f) - p);
    p := DerNaechste(f);

    // --- subjectPublicKeyInfo ---
    if (!DerLies(der, tbsEnde, p, f)) { return false; }
    if (DerTag(f) != 0x30) { return false; }
    var spkiEnde: int64 := DerInhalt(f) + DerInhaltLen(f);
    if (!DerLies(der, spkiEnde, DerInhalt(f), g)) { return false; }   // algorithm
    if (DerTag(g) != 0x30) { return false; }
    var ob: int64 := alloc(16);
    var kurve: int64 := alloc(DerFeldGroesse());
    if (ob == 0 || kurve == 0) { panic("X.509: kein Speicher"); }
    var algEnde: int64 := DerInhalt(g) + DerInhaltLen(g);
    if (!DerLies(der, algEnde, DerInhalt(g), h)) { return false; }
    if (DerTag(h) != 0x06) { return false; }
    var keyAlg: int64 := 0;
    if (DerOidGleich(der, h, ob, oidEcPublicKey(ob))) {
        // Bei EC steht die Kurve im Parameterfeld; eine unbekannte Kurve wird
        // abgewiesen, statt den Schluessel ohne Kurvenangabe zu uebernehmen.
        if (!DerLies(der, algEnde, DerNaechste(h), kurve)) { return false; }
        if (DerTag(kurve) != 0x06) { return false; }
        if (DerOidGleich(der, kurve, ob, oidP256(ob))) { keyAlg := 1; }
        if (keyAlg == 0 && DerOidGleich(der, kurve, ob, oidP384(ob))) { keyAlg := 2; }
        if (keyAlg == 0) { return false; }
    } else {
        if (DerOidGleich(der, h, ob, oidRsaEnc(ob)))  { keyAlg := 3; }
        if (keyAlg == 0 && DerOidGleich(der, h, ob, oidEd25519(ob))) { keyAlg := 4; }
        if (keyAlg == 0) { return false; }
    }
    poke64(satz + X_KEYALG, keyAlg);
    free(kurve, DerFeldGroesse());

    // subjectPublicKey BIT STRING steht hinter dem algorithm-SEQUENCE.
    if (!DerLies(der, spkiEnde, DerNaechste(g), h)) { return false; }
    if (DerTag(h) != 0x03) { return false; }
    var kp: int64 := alloc(8);
    var kl: int64 := alloc(8);
    if (kp == 0 || kl == 0) { panic("X.509: kein Speicher"); }
    if (!DerBitKette(der, h, kp, kl)) { return false; }
    poke64(satz + X_KEYPOS, peek64(kp));
    poke64(satz + X_KEYLEN, peek64(kl));
    free(kp, 8); free(kl, 8);
    p := DerNaechste(f);

    // --- extensions [3] (nur v3) ---
    while (p < tbsEnde) {
        if (!DerLies(der, tbsEnde, p, f)) { return false; }
        if (DerTag(f) == 0xA3) {
            if (!DerErstesKind(der, tbsEnde, f, g)) { return false; }
            if (DerTag(g) != 0x30) { return false; }
            var exEnde: int64 := DerInhalt(g) + DerInhaltLen(g);
            var q: int64 := DerInhalt(g);
            while (q < exEnde) {
                if (!DerLies(der, exEnde, q, h)) { return false; }
                if (DerTag(h) != 0x30) { return false; }
                var innen: int64 := DerInhalt(h) + DerInhaltLen(h);
                var oidF: int64 := alloc(DerFeldGroesse());
                var wF: int64 := alloc(DerFeldGroesse());
                if (oidF == 0 || wF == 0) { panic("X.509: kein Speicher"); }
                if (!DerLies(der, innen, DerInhalt(h), oidF)) { return false; }
                if (DerTag(oidF) != 0x06) { return false; }
                var r: int64 := DerNaechste(oidF);
                var kritisch: int64 := 0;
                if (!DerLies(der, innen, r, wF)) { return false; }
                if (DerTag(wF) == 0x01) {
                    if (DerInhaltLen(wF) != 1) { return false; }
                    var cb: int64 := peek8(der + DerInhalt(wF)) & 0xFF;
                    if (cb != 0 && cb != 0xFF) { return false; }
                    if (cb == 0xFF) { kritisch := 1; }
                    r := DerNaechste(wF);
                    if (!DerLies(der, innen, r, wF)) { return false; }
                }
                if (DerTag(wF) != 0x04) { return false; }   // extnValue OCTET STRING
                var wPos: int64 := DerInhalt(wF);
                var wLen: int64 := DerInhaltLen(wF);

                if (DerOidGleich(der, oidF, ob, oidExt(ob, 19))) {
                    if (!extBasicConstraints(der, derLen, wPos, wLen, satz)) { return false; }
                } else {
                    if (DerOidGleich(der, oidF, ob, oidExt(ob, 15))) {
                        if (!extKeyUsage(der, derLen, wPos, wLen, satz)) { return false; }
                    } else {
                        if (DerOidGleich(der, oidF, ob, oidExt(ob, 37))) {
                            if (!extEku(der, derLen, wPos, wLen, satz)) { return false; }
                        } else {
                            if (DerOidGleich(der, oidF, ob, oidExt(ob, 17))) {
                                var sanF: int64 := alloc(DerFeldGroesse());
                                if (sanF == 0) { panic("X.509: kein Speicher"); }
                                if (!DerLies(der, wPos + wLen, wPos, sanF)) { return false; }
                                if (DerTag(sanF) != 0x30) { return false; }
                                poke64(satz + X_SANPOS, DerInhalt(sanF));
                                poke64(satz + X_SANLEN, DerInhaltLen(sanF));
                                free(sanF, DerFeldGroesse());
                            }
                        }
                    }
                }
                free(oidF, DerFeldGroesse());
                free(wF, DerFeldGroesse());
                q := DerNaechste(h);
            }
        }
        p := DerNaechste(f);
    }

    // --- signatureAlgorithm und signatureValue ---
    if (!DerLies(der, certEnde, DerNaechste(tbs), f)) { return false; }
    if (DerTag(f) != 0x30) { return false; }
    var sigAlg: int64 := algKennung(der, certEnde, f);
    // RFC 5280 §4.1.1.2: beide AlgorithmIdentifier muessen uebereinstimmen.
    if (sigAlg != tbsSigAlg) { return false; }
    if (sigAlg == 0) { return false; }
    poke64(satz + X_SIGALG, sigAlg);

    if (!DerLies(der, certEnde, DerNaechste(f), g)) { return false; }
    var sp: int64 := alloc(8);
    var sl: int64 := alloc(8);
    if (sp == 0 || sl == 0) { panic("X.509: kein Speicher"); }
    if (!DerBitKette(der, g, sp, sl)) { return false; }
    poke64(satz + X_SIGPOS, peek64(sp));
    poke64(satz + X_SIGLEN, peek64(sl));
    free(sp, 8); free(sl, 8);

    free(cert, fg); free(tbs, fg); free(f, fg); free(g, fg); free(h, fg);
    free(ob, 16);
    return true;
}

// ---------------------------------------------------------------------------
// SAN und Namensvergleich
// ---------------------------------------------------------------------------

pub fn X509SanAnzahl(satz: int64): int64 {
    var der: int64 := peek64(satz + X_DER);
    var pos: int64 := peek64(satz + X_SANPOS);
    var len: int64 := peek64(satz + X_SANLEN);
    if (pos == 0 || len <= 0) { return 0; }
    var f: int64 := alloc(DerFeldGroesse());
    if (f == 0) { panic("X.509: kein Speicher"); }
    var ende: int64 := pos + len;
    var p: int64 := pos;
    var n: int64 := 0;
    while (p < ende) {
        if (!DerLies(der, ende, p, f)) { free(f, DerFeldGroesse()); return n; }
        n += 1;
        p := DerNaechste(f);
    }
    free(f, DerFeldGroesse());
    return n;
}

// Eintrag i: Art nach artPtr (1 rfc822Name, 2 dNSName, 6 URI, 7 iPAddress),
// Ausschnitt nach posPtr/lenPtr.
pub fn X509SanAt(satz: int64, idx: int64, artPtr: int64,
                 posPtr: int64, lenPtr: int64): bool {
    var der: int64 := peek64(satz + X_DER);
    var pos: int64 := peek64(satz + X_SANPOS);
    var len: int64 := peek64(satz + X_SANLEN);
    if (pos == 0 || len <= 0 || idx < 0) { return false; }
    var f: int64 := alloc(DerFeldGroesse());
    if (f == 0) { panic("X.509: kein Speicher"); }
    var ende: int64 := pos + len;
    var p: int64 := pos;
    var n: int64 := 0;
    while (p < ende) {
        if (!DerLies(der, ende, p, f)) { free(f, DerFeldGroesse()); return false; }
        if (n == idx) {
            // GeneralName ist CONTEXT-spezifisch: 0x80 | Nummer.
            poke64(artPtr, DerTag(f) & 0x1F);
            poke64(posPtr, DerInhalt(f));
            poke64(lenPtr, DerInhaltLen(f));
            free(f, DerFeldGroesse());
            return true;
        }
        n += 1;
        p := DerNaechste(f);
    }
    free(f, DerFeldGroesse());
    return false;
}

fn kleinBuchstabe(c: int64): int64 {
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

// Vergleich ohne Beachtung der Gross-/Kleinschreibung (DNS-Namen).
fn nameGleichCi(a: int64, aLen: int64, b: int64, bLen: int64): bool {
    if (aLen != bLen) { return false; }
    var i: int64 := 0;
    while (i < aLen) {
        if (kleinBuchstabe(peek8(a + i) & 0xFF) != kleinBuchstabe(peek8(b + i) & 0xFF)) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Wildcard nach RFC 6125 §6.4.3: nur "*." als GANZE linkeste Marke, nur eine
// Marke wird ersetzt, und der Rest muss mindestens zwei Marken haben. Ein
// Treffer auf "*.com" wird damit ausgeschlossen.
fn passtWildcard(musterPos: int64, musterLen: int64,
                 hostPos: int64, hostLen: int64): bool {
    if (musterLen < 3) { return false; }
    if ((peek8(musterPos) & 0xFF) != 42) { return false; }       // '*'
    if ((peek8(musterPos + 1) & 0xFF) != 46) { return false; }   // '.'

    var restPos: int64 := musterPos + 2;
    var restLen: int64 := musterLen - 2;
    // Mindestens zwei Marken im Rest.
    var punkte: int64 := 0;
    var i: int64 := 0;
    while (i < restLen) {
        if ((peek8(restPos + i) & 0xFF) == 46) { punkte += 1; }
        i += 1;
    }
    if (punkte < 1) { return false; }

    // Erste Marke des Hosts abschneiden.
    var ersterPunkt: int64 := -1;
    i := 0;
    while (i < hostLen) {
        if ((peek8(hostPos + i) & 0xFF) == 46) { ersterPunkt := i; i := hostLen; }
        else { i += 1; }
    }
    if (ersterPunkt <= 0) { return false; }
    return nameGleichCi(hostPos + ersterPunkt + 1, hostLen - ersterPunkt - 1,
                        restPos, restLen);
}

// Prueft den Hostnamen gegen die dNSName-Eintraege im SAN (RFC 6125).
// Ist ein SAN vorhanden, wird der commonName NICHT mehr betrachtet — so
// verlangt es RFC 6125 §6.4.4, und andernfalls liesse sich die Pruefung mit
// einem harmlosen SAN und einem beliebigen CN umgehen.
pub fn X509PasstName(satz: int64, host: int64, hostLen: int64): bool {
    if (host == 0 || hostLen <= 0) { return false; }
    var der: int64 := peek64(satz + X_DER);
    var art: int64 := alloc(8);
    var pos: int64 := alloc(8);
    var len: int64 := alloc(8);
    if (art == 0 || pos == 0 || len == 0) { panic("X.509: kein Speicher"); }

    var n: int64 := X509SanAnzahl(satz);
    var hatDns: bool := false;
    var treffer: bool := false;
    var i: int64 := 0;
    while (i < n) {
        if (X509SanAt(satz, i, art, pos, len)) {
            if (peek64(art) == 2) {
                hatDns := true;
                var p: int64 := der + peek64(pos);
                var l: int64 := peek64(len);
                if (nameGleichCi(p, l, host, hostLen)) { treffer := true; }
                if (!treffer && passtWildcard(p, l, host, hostLen)) { treffer := true; }
            }
        }
        i += 1;
    }
    free(art, 8); free(pos, 8); free(len, 8);
    if (hatDns) { return treffer; }

    // Kein dNSName: Rueckfall auf den commonName im Subjekt.
    return X509CnPasst(satz, host, hostLen);
}

// commonName aus dem Subjekt gegen den Hostnamen. Nur als Rueckfall, wenn
// gar kein dNSName im SAN steht.
pub fn X509CnPasst(satz: int64, host: int64, hostLen: int64): bool {
    var der: int64 := peek64(satz + X_DER);
    var pos: int64 := peek64(satz + X_SUBPOS);
    var len: int64 := peek64(satz + X_SUBLEN);
    if (pos == 0 || len <= 0) { return false; }
    var fg: int64 := DerFeldGroesse();
    var name: int64 := alloc(fg);
    var rdn: int64 := alloc(fg);
    var atv: int64 := alloc(fg);
    var oid: int64 := alloc(fg);
    var wert: int64 := alloc(fg);
    var ob: int64 := alloc(16);
    if (name == 0 || rdn == 0 || atv == 0 || oid == 0 || wert == 0 || ob == 0) {
        panic("X.509: kein Speicher");
    }
    var treffer: bool := false;
    if (DerLies(der, pos + len, pos, name) && DerTag(name) == 0x30) {
        var ende: int64 := DerInhalt(name) + DerInhaltLen(name);
        var p: int64 := DerInhalt(name);
        while (p < ende) {
            if (!DerLies(der, ende, p, rdn)) { p := ende; }
            else {
                var rEnde: int64 := DerInhalt(rdn) + DerInhaltLen(rdn);
                var q: int64 := DerInhalt(rdn);
                while (q < rEnde) {
                    if (!DerLies(der, rEnde, q, atv)) { q := rEnde; }
                    else {
                        var aEnde: int64 := DerInhalt(atv) + DerInhaltLen(atv);
                        if (DerLies(der, aEnde, DerInhalt(atv), oid)
                            && DerOidGleich(der, oid, ob, oidCN(ob))
                            && DerLies(der, aEnde, DerNaechste(oid), wert)) {
                            var wp: int64 := der + DerInhalt(wert);
                            var wl: int64 := DerInhaltLen(wert);
                            if (nameGleichCi(wp, wl, host, hostLen)) { treffer := true; }
                            if (!treffer && passtWildcard(wp, wl, host, hostLen)) { treffer := true; }
                        }
                        q := DerNaechste(atv);
                    }
                }
                p := DerNaechste(rdn);
            }
        }
    }
    free(name, fg); free(rdn, fg); free(atv, fg); free(oid, fg); free(wert, fg);
    free(ob, 16);
    return treffer;
}

// Bytegenauer Vergleich zweier Name-TLVs. RFC 5280 erlaubt mehr (Normalform
// je Zeichenkettentyp); bytegenau ist strenger und niemals zu weit — eine zu
// weite Namensgleichheit waere eine Ketten-Verwechslung.
pub fn X509NameGleich(derA: int64, posA: int64, lenA: int64,
                      derB: int64, posB: int64, lenB: int64): bool {
    if (lenA != lenB || lenA <= 0) { return false; }
    var i: int64 := 0;
    while (i < lenA) {
        if ((peek8(derA + posA + i) & 0xFF) != (peek8(derB + posB + i) & 0xFF)) {
            return false;
        }
        i += 1;
    }
    return true;
}

pub fn X509IstSelbstAusgestellt(satz: int64): bool {
    var der: int64 := peek64(satz + X_DER);
    return X509NameGleich(der, peek64(satz + X_ISSPOS), peek64(satz + X_ISSLEN),
                          der, peek64(satz + X_SUBPOS), peek64(satz + X_SUBLEN));
}

// Gueltigkeitszeitraum gegen eine Unix-Zeit.
pub fn X509ZeitGueltig(satz: int64, jetzt: int64): bool {
    if (jetzt < peek64(satz + X_NBEFORE)) { return false; }
    if (jetzt > peek64(satz + X_NAFTER)) { return false; }
    return true;
}
