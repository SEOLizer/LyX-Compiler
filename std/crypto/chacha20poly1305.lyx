// std/crypto/chacha20poly1305.lyx — ChaCha20, Poly1305 und das AEAD
// ChaCha20-Poly1305 nach RFC 8439
//
// Teil von #2096 (natives TLS ohne OpenSSL): TLS_CHACHA20_POLY1305_SHA256 aus
// RFC 8446. Der Satz fehlte in std/crypto ganz.
//
// Oeffentliche API:
//   ChaCha20Block(key, counter, nonce, out)          — 64-Byte-Schluesselstrom
//   ChaCha20(key, counter, nonce, in, len, out)      — Strom XOR Eingabe
//   Poly1305Mac(key, data, len, out)                 — 16-Byte-Tag
//   ChaChaPolySeal(key, nonce, aad, aadLen, pt, ptLen, ct, tag): bool
//   ChaChaPolyOpen(key, nonce, aad, aadLen, ct, ctLen, tag, pt): bool
//
// key ist immer 32 Byte, nonce 12 Byte, tag 16 Byte.
// Poly1305 rechnet mod 2^130-5 in fuenf 26-Bit-Gliedern — so bleibt jedes
// Teilprodukt unter 2^63 und passt ohne 128-Bit-Arithmetik in int64.
// ChaChaPolyOpen vergleicht das Tag ueber CTMemEqual und schreibt bei
// falschem Tag keinen Klartext nach aussen.

unit std.crypto.chacha20poly1305;

import std.alloc;
import std.crypto.ct;

// ---------------------------------------------------------------------------
// ChaCha20 (RFC 8439 §2.3)
// ---------------------------------------------------------------------------

fn ccLoadLE32(p: int64): int64 {
    return (peek8(p) | (peek8(p + 1) << 8) | (peek8(p + 2) << 16) | (peek8(p + 3) << 24))
           & 0xFFFFFFFF;
}

fn ccStoreLE32(p: int64, v: int64): void {
    poke8(p,     v        & 0xFF);
    poke8(p + 1, (v >> 8) & 0xFF);
    poke8(p + 2, (v >> 16) & 0xFF);
    poke8(p + 3, (v >> 24) & 0xFF);
}

// Vierfachrunde auf dem 16-Wort-Zustand (je 32 Bit in einem int64-Slot).
// rotl32 ist Builtin (#2177) und liefert null-erweitert.
fn ccQuarter(st: int64, ai: int64, bi: int64, ci: int64, di: int64): void {
    var a: int64 := peek64(st + ai * 8);
    var b: int64 := peek64(st + bi * 8);
    var c: int64 := peek64(st + ci * 8);
    var d: int64 := peek64(st + di * 8);

    a := (a + b) & 0xFFFFFFFF; d := rotl32(d ^ a, 16);
    c := (c + d) & 0xFFFFFFFF; b := rotl32(b ^ c, 12);
    a := (a + b) & 0xFFFFFFFF; d := rotl32(d ^ a, 8);
    c := (c + d) & 0xFFFFFFFF; b := rotl32(b ^ c, 7);

    poke64(st + ai * 8, a);
    poke64(st + bi * 8, b);
    poke64(st + ci * 8, c);
    poke64(st + di * 8, d);
}

// 64 Byte Schluesselstrom fuer (key, counter, nonce) nach out.
pub fn ChaCha20Block(key: int64, counter: int64, nonce: int64, out: int64): void {
    var st: int64 := alloc(16 * 8);
    var init: int64 := alloc(16 * 8);
    if (st == 0 || init == 0) { panic("ChaCha20: kein Speicher fuer den Zustand"); }

    poke64(init +  0, 0x61707865);   // "expa"
    poke64(init +  8, 0x3320646e);   // "nd 3"
    poke64(init + 16, 0x79622d32);   // "2-by"
    poke64(init + 24, 0x6b206574);   // "te k"
    var i: int64 := 0;
    while (i < 8) {
        poke64(init + (4 + i) * 8, ccLoadLE32(key + i * 4));
        i += 1;
    }
    poke64(init + 12 * 8, counter & 0xFFFFFFFF);
    i := 0;
    while (i < 3) {
        poke64(init + (13 + i) * 8, ccLoadLE32(nonce + i * 4));
        i += 1;
    }
    i := 0;
    while (i < 16) { poke64(st + i * 8, peek64(init + i * 8)); i := i + 1; }

    var r: int64 := 0;
    while (r < 10) {
        // Spalten
        ccQuarter(st, 0, 4,  8, 12);
        ccQuarter(st, 1, 5,  9, 13);
        ccQuarter(st, 2, 6, 10, 14);
        ccQuarter(st, 3, 7, 11, 15);
        // Diagonalen
        ccQuarter(st, 0, 5, 10, 15);
        ccQuarter(st, 1, 6, 11, 12);
        ccQuarter(st, 2, 7,  8, 13);
        ccQuarter(st, 3, 4,  9, 14);
        r += 1;
    }

    i := 0;
    while (i < 16) {
        var v: int64 := (peek64(st + i * 8) + peek64(init + i * 8)) & 0xFFFFFFFF;
        ccStoreLE32(out + i * 4, v);
        i += 1;
    }

    SecureZero(st, 16 * 8);
    SecureZero(init, 16 * 8);
    free(st, 16 * 8);
    free(init, 16 * 8);
}

// out := in ^ ChaCha20-Strom. in und out duerfen derselbe Puffer sein.
pub fn ChaCha20(key: int64, counter: int64, nonce: int64,
                ibuf: int64, len: int64, out: int64): void {
    if (len <= 0) { return; }
    var ks: int64 := alloc(64);
    if (ks == 0) { panic("ChaCha20: kein Speicher fuer den Strom"); }
    var pos: int64 := 0;
    var blk: int64 := counter;
    while (pos < len) {
        ChaCha20Block(key, blk, nonce, ks);
        var take: int64 := 64;
        if (len - pos < take) { take := len - pos; }
        var i: int64 := 0;
        while (i < take) {
            poke8(out + pos + i, peek8(ibuf + pos + i) ^ peek8(ks + i));
            i += 1;
        }
        pos += take;
        blk := (blk + 1) & 0xFFFFFFFF;
    }
    SecureZero(ks, 64);
    free(ks, 64);
}

// ---------------------------------------------------------------------------
// Poly1305 (RFC 8439 §2.5)
//
// r und der Akkumulator h liegen in fuenf Gliedern zu 26 Bit. Ein Produkt
// zweier Glieder ist hoechstens 2^52, die Summe von fuenf davon mit dem
// Faktor 5 bleibt unter 2^57 — also kein Ueberlauf in int64 und keine
// 128-Bit-Arithmetik noetig.
// ---------------------------------------------------------------------------

con POLY_ACC: int64 := 0;         // 5 x int64 Akkumulator
con POLY_R:   int64 := 40;        // 5 x int64 r
con POLY_R5:  int64 := 80;        // 5 x int64 r[i]*5 (i>0), vorgerechnet
con POLY_PAD: int64 := 120;       // 4 x int64 s (letzte 16 Schluesselbyte)
con POLY_BUF: int64 := 152;       // 16-Byte-Teilblock
con POLY_FILL: int64 := 168;
con POLY_CTX_SIZE: int64 := 176;

fn polyInit(ctx: int64, key: int64): void {
    // r &= 0x0ffffffc0ffffffc0ffffffc0fffffff (RFC 8439 §2.5.1)
    var t0: int64 := ccLoadLE32(key);
    var t1: int64 := ccLoadLE32(key + 4);
    var t2: int64 := ccLoadLE32(key + 8);
    var t3: int64 := ccLoadLE32(key + 12);

    var r0: int64 :=   t0                         & 0x3ffffff;
    var r1: int64 := (((t0 >> 26) | (t1 << 6))  & 0x3ffff03);
    var r2: int64 := (((t1 >> 20) | (t2 << 12)) & 0x3ffc0ff);
    var r3: int64 := (((t2 >> 14) | (t3 << 18)) & 0x3f03fff);
    var r4: int64 :=   ((t3 >> 8)               & 0x00fffff);

    poke64(ctx + POLY_R,      r0);
    poke64(ctx + POLY_R +  8, r1);
    poke64(ctx + POLY_R + 16, r2);
    poke64(ctx + POLY_R + 24, r3);
    poke64(ctx + POLY_R + 32, r4);
    poke64(ctx + POLY_R5,      0);
    poke64(ctx + POLY_R5 +  8, r1 * 5);
    poke64(ctx + POLY_R5 + 16, r2 * 5);
    poke64(ctx + POLY_R5 + 24, r3 * 5);
    poke64(ctx + POLY_R5 + 32, r4 * 5);

    var i: int64 := 0;
    while (i < 5) { poke64(ctx + POLY_ACC + i * 8, 0); i := i + 1; }
    i := 0;
    while (i < 4) { poke64(ctx + POLY_PAD + i * 8, ccLoadLE32(key + 16 + i * 4)); i := i + 1; }
    poke64(ctx + POLY_FILL, 0);
}

// Ein Block: h := (h + m) * r mod 2^130-5. `hibit` ist 1 fuer volle Bloecke
// (das 2^128-Bit aus §2.5.1) und 0 fuer den abschliessenden Teilblock, dessen
// Padding-Byte schon im Puffer steht.
fn polyBlock(ctx: int64, m: int64, hibit: int64): void {
    var t0: int64 := ccLoadLE32(m);
    var t1: int64 := ccLoadLE32(m + 4);
    var t2: int64 := ccLoadLE32(m + 8);
    var t3: int64 := ccLoadLE32(m + 12);

    var h0: int64 := peek64(ctx + POLY_ACC)      + ( t0                        & 0x3ffffff);
    var h1: int64 := peek64(ctx + POLY_ACC +  8) + (((t0 >> 26) | (t1 << 6))   & 0x3ffffff);
    var h2: int64 := peek64(ctx + POLY_ACC + 16) + (((t1 >> 20) | (t2 << 12))  & 0x3ffffff);
    var h3: int64 := peek64(ctx + POLY_ACC + 24) + (((t2 >> 14) | (t3 << 18))  & 0x3ffffff);
    var h4: int64 := peek64(ctx + POLY_ACC + 32) + ((t3 >> 8) | (hibit << 24));

    var r0: int64 := peek64(ctx + POLY_R);
    var r1: int64 := peek64(ctx + POLY_R +  8);
    var r2: int64 := peek64(ctx + POLY_R + 16);
    var r3: int64 := peek64(ctx + POLY_R + 24);
    var r4: int64 := peek64(ctx + POLY_R + 32);
    var s1: int64 := peek64(ctx + POLY_R5 +  8);
    var s2: int64 := peek64(ctx + POLY_R5 + 16);
    var s3: int64 := peek64(ctx + POLY_R5 + 24);
    var s4: int64 := peek64(ctx + POLY_R5 + 32);

    var d0: int64 := h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1;
    var d1: int64 := h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2;
    var d2: int64 := h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3;
    var d3: int64 := h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4;
    var d4: int64 := h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0;

    var c: int64 := (d0 as uint64) >> 26; h0 := d0 & 0x3ffffff;
    d1 += c; c := (d1 as uint64) >> 26;   h1 := d1 & 0x3ffffff;
    d2 += c; c := (d2 as uint64) >> 26;   h2 := d2 & 0x3ffffff;
    d3 += c; c := (d3 as uint64) >> 26;   h3 := d3 & 0x3ffffff;
    d4 += c; c := (d4 as uint64) >> 26;   h4 := d4 & 0x3ffffff;
    h0 += c * 5; c := (h0 as uint64) >> 26; h0 := h0 & 0x3ffffff;
    h1 += c;

    poke64(ctx + POLY_ACC,      h0);
    poke64(ctx + POLY_ACC +  8, h1);
    poke64(ctx + POLY_ACC + 16, h2);
    poke64(ctx + POLY_ACC + 24, h3);
    poke64(ctx + POLY_ACC + 32, h4);
}

fn polyUpdate(ctx: int64, data: int64, len: int64): void {
    if (len <= 0) { return; }
    var fill: int64 := peek64(ctx + POLY_FILL);
    var pos: int64 := 0;

    if (fill > 0) {
        while (fill < 16 && pos < len) {
            poke8(ctx + POLY_BUF + fill, peek8(data + pos));
            fill += 1;
            pos += 1;
        }
        if (fill == 16) {
            polyBlock(ctx, ctx + POLY_BUF, 1);
            fill := 0;
        }
    }
    while (pos + 16 <= len) {
        polyBlock(ctx, data + pos, 1);
        pos += 16;
    }
    while (pos < len) {
        poke8(ctx + POLY_BUF + fill, peek8(data + pos));
        fill += 1;
        pos += 1;
    }
    poke64(ctx + POLY_FILL, fill);
}

fn polyFinal(ctx: int64, out: int64): void {
    var fill: int64 := peek64(ctx + POLY_FILL);
    if (fill > 0) {
        // Teilblock: 0x01 anhaengen, Rest mit Nullen; das 2^128-Bit entfaellt.
        poke8(ctx + POLY_BUF + fill, 1);
        var i: int64 := fill + 1;
        while (i < 16) { poke8(ctx + POLY_BUF + i, 0); i := i + 1; }
        polyBlock(ctx, ctx + POLY_BUF, 0);
        poke64(ctx + POLY_FILL, 0);
    }

    var h0: int64 := peek64(ctx + POLY_ACC);
    var h1: int64 := peek64(ctx + POLY_ACC +  8);
    var h2: int64 := peek64(ctx + POLY_ACC + 16);
    var h3: int64 := peek64(ctx + POLY_ACC + 24);
    var h4: int64 := peek64(ctx + POLY_ACC + 32);

    // Uebertraege vollstaendig ausrechnen.
    var c: int64 := (h1 as uint64) >> 26; h1 := h1 & 0x3ffffff;
    h2 += c; c := (h2 as uint64) >> 26;   h2 := h2 & 0x3ffffff;
    h3 += c; c := (h3 as uint64) >> 26;   h3 := h3 & 0x3ffffff;
    h4 += c; c := (h4 as uint64) >> 26;   h4 := h4 & 0x3ffffff;
    h0 += c * 5; c := (h0 as uint64) >> 26; h0 := h0 & 0x3ffffff;
    h1 += c;

    // h - p rechnen und ohne Sprung waehlen (p = 2^130-5).
    var g0: int64 := h0 + 5; c := (g0 as uint64) >> 26; g0 := g0 & 0x3ffffff;
    var g1: int64 := h1 + c; c := (g1 as uint64) >> 26; g1 := g1 & 0x3ffffff;
    var g2: int64 := h2 + c; c := (g2 as uint64) >> 26; g2 := g2 & 0x3ffffff;
    var g3: int64 := h3 + c; c := (g3 as uint64) >> 26; g3 := g3 & 0x3ffffff;
    var g4: int64 := h4 + c - (1 << 26);

    // mask = 0, wenn g4 negativ ist (h < p), sonst alle Bits gesetzt.
    var mask: int64 := 0 - (1 - (((g4 as uint64) >> 63) & 1));
    h0 := (h0 & (mask ^ 0xFFFFFFFFFFFFFFFF)) | (g0 & mask);
    h1 := (h1 & (mask ^ 0xFFFFFFFFFFFFFFFF)) | (g1 & mask);
    h2 := (h2 & (mask ^ 0xFFFFFFFFFFFFFFFF)) | (g2 & mask);
    h3 := (h3 & (mask ^ 0xFFFFFFFFFFFFFFFF)) | (g3 & mask);
    h4 := (h4 & (mask ^ 0xFFFFFFFFFFFFFFFF)) | (g4 & mask);

    // Auf vier 32-Bit-Woerter zusammenlegen und s addieren.
    var f0: int64 := ((h0       | (h1 << 26)) & 0xFFFFFFFF) + peek64(ctx + POLY_PAD);
    var f1: int64 := (((h1 >> 6)  | (h2 << 20)) & 0xFFFFFFFF) + peek64(ctx + POLY_PAD +  8);
    var f2: int64 := (((h2 >> 12) | (h3 << 14)) & 0xFFFFFFFF) + peek64(ctx + POLY_PAD + 16);
    var f3: int64 := (((h3 >> 18) | (h4 <<  8)) & 0xFFFFFFFF) + peek64(ctx + POLY_PAD + 24);

    f1 += (f0 as uint64) >> 32;
    f2 += (f1 as uint64) >> 32;
    f3 += (f2 as uint64) >> 32;

    ccStoreLE32(out,      f0 & 0xFFFFFFFF);
    ccStoreLE32(out + 4,  f1 & 0xFFFFFFFF);
    ccStoreLE32(out + 8,  f2 & 0xFFFFFFFF);
    ccStoreLE32(out + 12, f3 & 0xFFFFFFFF);
}

// Poly1305 ueber (key 32 Byte, data) nach out (16 Byte).
pub fn Poly1305Mac(key: int64, data: int64, len: int64, out: int64): void {
    var ctx: int64 := alloc(POLY_CTX_SIZE);
    if (ctx == 0) { panic("Poly1305: kein Speicher fuer den Zustand"); }
    polyInit(ctx, key);
    polyUpdate(ctx, data, len);
    polyFinal(ctx, out);
    SecureZero(ctx, POLY_CTX_SIZE);
    free(ctx, POLY_CTX_SIZE);
}

// ---------------------------------------------------------------------------
// AEAD_CHACHA20_POLY1305 (RFC 8439 §2.8)
// ---------------------------------------------------------------------------

// Einmalschluessel: ChaCha20-Block 0 unter (key, nonce), erste 32 Byte.
fn chachaPolyKey(key: int64, nonce: int64, otk: int64): void {
    var blk: int64 := alloc(64);
    if (blk == 0) { panic("ChaCha20-Poly1305: kein Speicher"); }
    ChaCha20Block(key, 0, nonce, blk);
    var i: int64 := 0;
    while (i < 32) { poke8(otk + i, peek8(blk + i)); i := i + 1; }
    SecureZero(blk, 64);
    free(blk, 64);
}

// Der MAC laeuft ueber AAD | pad16 | Ciphertext | pad16 | len64(AAD) |
// len64(Ciphertext).
fn chachaPolyTag(otk: int64, aad: int64, aadLen: int64,
                 ct: int64, ctLen: int64, tag: int64): void {
    var ctx: int64 := alloc(POLY_CTX_SIZE);
    var pad: int64 := alloc(16);
    var lens: int64 := alloc(16);
    if (ctx == 0 || pad == 0 || lens == 0) { panic("ChaCha20-Poly1305: kein Speicher"); }
    var i: int64 := 0;
    while (i < 16) { poke8(pad + i, 0); i := i + 1; }

    polyInit(ctx, otk);
    if (aadLen > 0) {
        polyUpdate(ctx, aad, aadLen);
        var r: int64 := aadLen % 16;
        if (r != 0) { polyUpdate(ctx, pad, 16 - r); }
    }
    if (ctLen > 0) {
        polyUpdate(ctx, ct, ctLen);
        var r2: int64 := ctLen % 16;
        if (r2 != 0) { polyUpdate(ctx, pad, 16 - r2); }
    }
    i := 0;
    while (i < 8) {
        poke8(lens + i,     ((aadLen as uint64) >> (i * 8)) & 0xFF);
        poke8(lens + 8 + i, ((ctLen  as uint64) >> (i * 8)) & 0xFF);
        i += 1;
    }
    polyUpdate(ctx, lens, 16);
    polyFinal(ctx, tag);

    SecureZero(ctx, POLY_CTX_SIZE);
    free(ctx, POLY_CTX_SIZE);
    free(pad, 16);
    free(lens, 16);
}

// Verschluesselt pt nach ct und schreibt 16 Tagbyte. ct darf derselbe Puffer
// wie pt sein. key 32 Byte, nonce 12 Byte.
pub fn ChaChaPolySeal(key: int64, nonce: int64, aad: int64, aadLen: int64,
                      pt: int64, ptLen: int64, ct: int64, tag: int64): bool {
    if (ptLen < 0 || aadLen < 0) { return false; }
    var otk: int64 := alloc(32);
    if (otk == 0) { panic("ChaCha20-Poly1305: kein Speicher"); }
    chachaPolyKey(key, nonce, otk);
    if (ptLen > 0) { ChaCha20(key, 1, nonce, pt, ptLen, ct); }
    chachaPolyTag(otk, aad, aadLen, ct, ptLen, tag);
    SecureZero(otk, 32);
    free(otk, 32);
    return true;
}

// Prueft das Tag und entschluesselt. Bei falschem Tag false und kein Klartext.
pub fn ChaChaPolyOpen(key: int64, nonce: int64, aad: int64, aadLen: int64,
                      ct: int64, ctLen: int64, tag: int64, pt: int64): bool {
    if (ctLen < 0 || aadLen < 0) { return false; }
    var otk: int64 := alloc(32);
    var t: int64 := alloc(16);
    if (otk == 0 || t == 0) { panic("ChaCha20-Poly1305: kein Speicher"); }
    chachaPolyKey(key, nonce, otk);
    chachaPolyTag(otk, aad, aadLen, ct, ctLen, t);
    // CTMemEqual liefert -1 bei Gleichheit, 0 sonst — nicht 1.
    var gleich: int64 := CTMemEqual(t, tag, 16);
    if (gleich != -1) {
        SecureZero(otk, 32);
        free(otk, 32); free(t, 16);
        return false;
    }
    if (ctLen > 0) { ChaCha20(key, 1, nonce, ct, ctLen, pt); }
    SecureZero(otk, 32);
    free(otk, 32); free(t, 16);
    return true;
}
