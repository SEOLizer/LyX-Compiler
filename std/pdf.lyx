// std/pdf.lyx
// PDF library public API — WP-PDF-01 (objects/builder) + WP-PDF-02 (pages) + WP-PDF-03 (text)

@description("PDF library: create, build and save PDF documents")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
@capabilities([fs.read, fs.write])
unit std.pdf;

import std.pdf.objects;
import std.pdf.builder;
import std.pdf.page;
import std.pdf.fonts;
import std.pdf.graphics;
import std.pdf.compress;
import std.pdf.image;
import std.pdf.meta;
import std.pdf.annot;
import std.pdf.reader;
import std.pdf.outline;
import std.pdf.pagelabels;
import std.pdf.transition;
import std.pdf.viewprefs;
import std.pdf.namedest;
import std.pdf.attach;
import std.pdf.layer;
import std.pdf.xobject;
import std.pdf.shading;
import std.pdf.spot;
import std.pdf.forms;
import std.pdf.ttfont;
import std.pdf.xmp;
import std.pdf.pdfa;

// All public symbols are re-exported from the sub-units:
//
// From std.pdf.builder:
//   PdfNew()                              → int64  (doc handle)
//   PdfFree(doc)
//   PdfSave(doc, path: pchar)             → int64  (0 = OK)
//   PdfPageCount(doc)                     → int64
//   PdfSetCompression(doc, level)
//   PdfContentAppendStr(doc, page, s)     → int64
//   PdfContentAppendBytes(doc, page, d, n)→ int64
//
// From std.pdf.page:
//   PdfAddPage(doc, w, h: f64)            → int64  (page handle)
//   PdfSetLandscape(doc, page)
//   PDF_A4_W, PDF_A4_H, PDF_A3_W, ...    (f64 constants)
//
// From std.pdf.fonts:
//   PDF_FONT_HELVETICA, PDF_FONT_COURIER, ... (int64 constants)
//   PdfCharWidth(fontId, c)               → int64
//   PdfTextWidth(doc, fontId, size, text) → f64
//
// From std.pdf.graphics:
//   PdfSetFont(doc, page, fontId, size)
//   PdfSetTextColor(doc, page, r, g, b)
//   PdfSetLineSpacing(doc, page, leading)
//   PdfTextAt(doc, page, x, y, text)
//   PdfTextBlock(doc, page, x, y, width, text)
//
// From std.pdf.graphics (WP-PDF-04):
//   PdfSetStrokeColor, PdfSetFillColor, PdfSetStrokeColorCMYK, PdfSetFillColorCMYK
//   PdfSetLineWidth, PdfSetLineCap, PdfSetLineJoin, PdfSetDash
//   PdfMoveTo, PdfLineTo, PdfCurveTo, PdfRect, PdfClosePath
//   PdfCircle, PdfEllipse
//   PdfStroke, PdfFill, PdfFillStroke, PdfClip
//   PdfSaveState, PdfRestoreState, PdfTranslate, PdfScale, PdfRotate
//
// From std.pdf.compress (WP-PDF-05):
//   zlibCompress(input, inLen, output)    → int64  (compressed length, 0=error)
//   zlibMaxOutputSize(inLen)              → int64  (worst-case output bytes)
//
// From std.pdf.image (WP-PDF-06):
//   PdfAddImage(doc, data, pw, ph, channels) → int64  (image index, -1=error)
//   PdfDrawImage(doc, page, imgIdx, x, y, wPts, hPts)
//
// From std.pdf.meta (WP-PDF-07):
//   PdfSetTitle(doc, title)       PdfSetAuthor(doc, author)
//   PdfSetSubject(doc, subject)   PdfSetKeywords(doc, keywords)
//   PdfSetCreator(doc, creator)   PdfSetProducer(doc, producer)
//
// From std.pdf.annot (WP-PDF-08):
//   PdfAddLink(doc, page, x1, y1, x2, y2)           → int64 (annotIdx)
//   PdfLinkSetURI(doc, annotIdx, url)                — set URI on link
//   PdfAddLinkGoto(doc, page, x1, y1, x2, y2)       → int64 (annotIdx)
//   PdfLinkSetGoto(doc, annotIdx, destPage)          — set dest on goto link
//   PdfAddNote(doc, page, x, y, title, content)      → int64 (annotIdx)
//
// From std.pdf.reader (WP-PDF-09 + WP-PDF-19):
//   PdfOpen(path)                                    → int64 (reader handle, 0=error)
//   PdfClose(rdr)
//   PdfRdrPageCount(rdr)                             → int64
//   PdfRdrGetTitle(rdr, buf, maxLen)
//   PdfRdrGetAuthor(rdr, buf, maxLen)
//   PdfRdrGetSubject(rdr, buf, maxLen)
//   PdfRdrGetKeywords(rdr, buf, maxLen)
//   PdfRdrGetCreator(rdr, buf, maxLen)
//   PdfRdrGetProducer(rdr, buf, maxLen)
//   PdfRdrExtractText(rdr, pageIdx, buf, maxLen)      — extract text from page into NUL-terminated buf
//     Lines separated by \n (from downward Td/TD moves). Only works on uncompressed streams.
//   PdfImportPage(dst, src, srcPageIdx)              → int64 (new page handle in dst, -1=error)
//   PdfMergeAll(dst, src)                            — append all pages of src into dst
//     dst: builder doc handle (from PdfNew)
//     src: reader handle (from PdfOpen)
//     Copies content stream + Standard-14 font resources. Images not re-imported.
//     Only works with Lyx-generated PDFs (flat /Pages tree, Standard-14 fonts).
//
// From std.pdf.outline (WP-PDF-10):
//   PdfOutlineAdd(doc, parentIdx, title, destPage)   → int64 (outline index, -1=error)
//     parentIdx = -1 for root-level, else prior PdfOutlineAdd return value
//
// From std.pdf.pagelabels (WP-PDF-11):
//   PdfSetPageLabel(doc, firstPage, style, prefix, startNum) → int64 (0=OK, -1=err)
//     style: PDF_LABEL_DECIMAL / ROMAN_L / ROMAN_U / ALPHA_L / ALPHA_U / NONE
//     Ranges must be added in ascending firstPage order.
//
// From std.pdf.transition (WP-PDF-12):
//   PdfSetPageTransition(doc, pageIdx, transType, dur100) → int64 (0=OK, -1=err)
//     transType: PDF_TRANS_DISSOLVE / WIPE / PUSH / SPLIT / COVER / UNCOVER / FADE / GLITTER / BOX / FLY
//     dur100: duration × 100 (e.g. 100 = 1.0 s), 0 = viewer default
//
// From std.pdf.viewprefs (WP-PDF-13):
//   PdfSetViewerFlags(doc, flags)          — OR together PDF_VIEW_* constants
//   PdfSetOpenAction(doc, pageIdx)         — open to this page; sets PDF_VIEW_OPEN_ACTION automatically
//     Flags: PDF_VIEW_HIDE_TOOLBAR / HIDE_MENUBAR / HIDE_WINDOWUI / FIT_WINDOW / CENTER_WINDOW /
//            DISPLAY_DOCTITLE / FULLSCREEN / USE_OUTLINES / SINGLE_PAGE / TWO_COLUMN_LEFT / OPEN_ACTION
//
// From std.pdf.namedest (WP-PDF-14):
//   PdfAddNamedDest(doc, name, pageIdx) → int64 (0=OK, -1=err)
//     Registers a string-keyed destination in /Names /Dests; pageIdx is 0-based.
//
// From std.pdf.attach (WP-PDF-15):
//   PdfAttachFile(doc, filename, data, dataLen) → int64 (0=OK, -1=err)
//     Embeds a file in the PDF (/EmbeddedFiles in /Names); data is copied internally.
//
// From std.pdf.layer (WP-PDF-16):
//   PdfAddLayer(doc, name)                           → int64 (layer index, -1=err)
//   PdfLayerBegin(doc, page, layerIdx)               — open a marked-content region (/OC BDC)
//   PdfLayerEnd(doc, page)                           — close the region (EMC)
//   PdfLayerSetVisible(doc, layerIdx, visible)        — 1=on (default), 0=off
//
// From std.pdf.shading (WP-PDF-22):
//   PdfPackColor(r100, g100, b100)                   → int64 (packed colour)
//   PdfPackCoords(x100, y100)                        → int64 (packed point/size)
//   PdfLinearGradient(doc, page, p0, p1, c0, c1)    — axial gradient (Type 2)
//   PdfRadialGradient(doc, page, center, radii, c0, c1) — radial gradient (Type 3)
//     p0/p1    = PdfPackCoords(x100, y100)
//     center   = PdfPackCoords(cx100, cy100)
//     radii    = PdfPackCoords(r0_100, r1_100)  inner / outer radius
//     c0/c1    = PdfPackColor(r100, g100, b100)  0–10000 per channel
//
// From std.pdf.spot (WP-PDF-25):
//   PdfDefineSpotColor(doc, name, c100, m100, y100, k100) → int64 (spotId, -1=err)
//     name: spot color name (e.g. "PANTONE 485 C")
//     c/m/y/k: CMYK alternate ×100 (0–10000 per channel)
//   PdfSetStrokeSpot(doc, page, spotId, tint)  — stroke color; tint 0.0–1.0
//   PdfSetFillSpot(doc, page, spotId, tint)    — fill color;   tint 0.0–1.0
//     Emits /Separation color space + tint transform into page /Resources.
//     CMYK fallback visible on systems without spot-color support.
//
// From std.pdf.builder (WP-PDF-17 — Encryption):
//   PdfSetUserPassword(doc, pwd)         — user password (required to open)
//   PdfSetOwnerPassword(doc, pwd)        — owner password (full edit rights)
//   PdfSetPermissions(doc, flags)        — OR: PDF_PERM_PRINT/MODIFY/COPY/ANNOT/FILL/EXTRACT/ASSEMBLE/PRINT_HQ
//   PdfSetEncryption(doc, PDF_ENC_RC4_128)  — enable RC4-128 encryption
//     Call before PdfSave. Only RC4-128 implemented; AES variants accepted but degrade to RC4-128.
//     Inkompatibel mit PDF/A (WP-PDF-27).
//
// From std.pdf.forms (WP-PDF-18):
//   PdfAddTextField(doc, page, pos, size, name, defaultValue) → int64  (fieldId)
//   PdfAddCheckbox(doc, page, pos, size100, name, checked)    → int64
//   PdfAddRadioButton(doc, page, pos, size100, groupName, value) → int64
//   PdfAddComboBox(doc, page, pos, size, name)                → int64
//   PdfComboAddItem(doc, fieldId, item)
//   PdfFlattenForms(doc)   — render all fields as static content; removes /AcroForm
//     pos  = PdfPackCoords(x100, y100)   bottom-left corner
//     size = PdfPackCoords(w100, h100)   width × height
//     size100 = side length ×100 for square fields (checkbox/radio)
//     groupName: radio buttons with the same name form one group (auto-created)
//
// From std.pdf.ttfont (WP-PDF-24):
//   PdfLoadFont(doc, path)                        → int64 (fontId, -1=error)
//   PdfSetFontTT(doc, page, fontId, size)         — select TT font + emit Tf
//   PdfTextAtUTF8(doc, page, x, y, text)          — place UTF-8 text (uses current TT font)
//   PdfFinalizeFont(doc, fontId)                  — pre-build subset; call before PdfSave
//     Embeds TrueType as Type0/CIDFontType2 (Identity-H, Unicode text selection).
//     Without PdfFinalizeFont: full TTF embedded. With it: subset (used glyphs only).
//
// From std.pdf.xmp (WP-PDF-26):
//   PdfGenerateXMP(doc)              — auto-generate XMP from /Info fields; call before PdfSave
//   PdfSetXMP(doc, xmpXml, len)      — embed a raw XMP blob (int64 pointer, byte length)
//     Embeds /Metadata stream (Type/Metadata, Subtype/XML) referenced from Catalog.
//     exiftool reads: dc:title (Title), dc:creator (Author), dc:description (Subject),
//     dc:subject (Keywords), xmp:CreatorTool, pdf:Producer.
//     When PdfSetConformance was called first, PdfGenerateXMP also writes pdfaid namespace.
//
// From std.pdf.pdfa (WP-PDF-27):
//   PdfSetConformance(doc, PDF_CONFORMANCE_A1B)   — enable PDF/A output mode
//     PDF_CONFORMANCE_NONE / A1B / A2B / A3B
//     Call before PdfGenerateXMP and PdfSave.
//     Effects: OutputIntent + sRGB ICC profile in Catalog, pdfaid XMP fields, no encryption.
