// std/lyxvision/button.lyx
// LyxVision - TButton: Klickbare Schaltfläche
// Inspiriert von Borland Turbo Vision

unit std.lyxvision.button;

import std.lyxvision.types;
import std.lyxvision.consts;
import std.lyxvision.view;
import std.lyxvision.drivers;

// ============================================================================
// Button-Flags
// ============================================================================

pub con bfNormal: int64 := 0;
pub con bfDefault: int64 := 1;
pub con bfBold: int64 := 2;
pub con bfShadow: int64 := 4;
pub con bfGrabFocus: int64 := 8;

// ============================================================================
// TButton - Klickbare Schaltfläche
// ============================================================================

pub type TButton = class extends TView {
  title:     pchar;
  command:   int64;
  flags:     int64;
  isDefault: int64;
  isPressed: int64;

  fn Init(x: int64, y: int64, w: int64, h: int64, t: pchar, cmd: int64) {
    self.originX     := x;
    self.originY     := y;
    self.sizeX       := w;
    self.sizeY       := h;
    self.cursorX     := 0;
    self.cursorY     := 0;
    self.growMode    := gfFixed;
    self.dragMode    := dmLimitAll;
    self.helpCtx     := hcNoContext;
    self.state       := sfVisible;
    self.options     := ofSelectable | ofFirstClick;
    self.ownerPtr    := 0;
    self.nextPtr     := 0;
    self.viewType    := vtButton;
    self.dirtyLevel  := dfClean;
    self.parentDirty := dfClean;
    self.title       := t;
    self.command     := cmd;
    self.flags       := bfNormal;
    self.isDefault   := 0;
    self.isPressed   := 0;
  }

  override fn Draw() {
    if (!FlagSet(self.state, sfVisible)) {
      return;
    }
    var ox: int64 := self.originX;
    var oy: int64 := self.originY;
    MoveCursor(ox, oy);
    if (FlagSet(self.state, sfFocused)) {
      SetColors(colorYellow, colorBlue);
    } else {
      SetColors(colorLightGray, colorBlue);
    }
    if (self.isPressed == 1) {
      SetColors(colorWhite, colorBlack);
    }
    PrintCh(91);
    PrintStr(self.title);
    PrintCh(93);
    ResetColors();
    self.dirtyLevel := dfClean;
  }
};

// ============================================================================
// TButton Funktionen
// ============================================================================

pub fn ButtonCreate(x: int64, y: int64, w: int64, h: int64, title: pchar, cmd: int64): TButton {
  var btn: TButton := new TButton();
  btn.Init(x, y, w, h, title, cmd);
  return btn;
}

pub fn ButtonCreateStd(x: int64, y: int64, title: pchar, cmd: int64): TButton {
  return ButtonCreate(x, y, 10, 1, title, cmd);
}

pub fn ButtonCreateDefault(x: int64, y: int64, title: pchar, cmd: int64): TButton {
  var btn: TButton := ButtonCreateStd(x, y, title, cmd);
  btn.isDefault := 1;
  btn.flags := btn.flags | bfDefault;
  return btn;
}

pub fn ButtonSetPressed(btn: TButton, pressed: int64): TButton {
  btn.isPressed := pressed;
  btn.dirtyLevel := dfVisual;
  return btn;
}

pub fn ButtonDraw(btn: TButton): TButton {
  btn.Draw();
  return btn;
}

pub fn ButtonIsKey(btn: TButton, key: int64): bool {
  if (btn.isDefault == 1) {
    if (key == kbEnter) {
      return true;
    }
  }
  if (key == 32) {
    return true;
  }
  return false;
}

pub fn ButtonPress(btn: TButton): int64 {
  btn.isPressed := 1;
  btn.Draw();
  btn.isPressed := 0;
  btn.Draw();
  return btn.command;
}

// End of std/lyxvision/button.lyx
