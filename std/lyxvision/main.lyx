// Initialisiert LyxVision
pub fn Init() {
  InitDriver();
}

// Beendet LyxVision
pub fn Done() {
  DoneDriver();
}

// Einfache Event-Schleife - wartet auf ESC oder 'q' zum Beenden
pub fn RunSimple() {
  var running: int64 := 1;
  while (running != 0) {
    // Lese direkt ein Zeichen (ohne TEvent struct für Einfachheit)
    var ch: int64 := ReadKeyRaw();
    
    // Prüfe auf Beenden-Tasten
    if (ch == 27) {
      running := 0;
    }
    if (ch == 113) {
      running := 0;
    }
  }
}

