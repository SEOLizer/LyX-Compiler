// std/lyxvision/inputline.lyx
// LyxVision - TInputLine: Eingabefeld
// Inspiriert von Borland Turbo Vision

unit std.lyxvision.inputline;

import std.lyxvision.types;
import std.lyxvision.consts;
import std.lyxvision.view;
import std.lyxvision.drivers;

// ============================================================================
// InputLine-Optionen
// ============================================================================

pub con ilValidate:  int64 := 1;
pub con ilCursorIns: int64 := 2;
pub con ilCursorOver: int64 := 4;
pub con ilPassword:  int64 := 8;
pub con ilHistory:   int64 := 16;

pub con MAX_INPUT_LENGTH: int64 := 256;

// ============================================================================
// TInputLine - Eingabefeld
// ============================================================================

pub type TInputLine = class extends TView {
  dataPtr:     int64;
  bufferSize:  int64;
  curPos:      int64;
  firstPos:    int64;
  selectStart: int64;
  selectEnd:   int64;
  isValid:     int64;
  options2:    int64;

  fn Init(x: int64, y: int64, maxLen: int64) {
    self.originX     := x;
    self.originY     := y;
    self.sizeX       := maxLen + 2;
    self.sizeY       := 1;
    self.cursorX     := 0;
    self.cursorY     := 0;
    self.growMode    := gfFixed;
    self.dragMode    := dmLimitAll;
    self.helpCtx     := hcNoContext;
    self.state       := sfVisible;
    self.options     := ofSelectable | ofFirstClick;
    self.ownerPtr    := 0;
    self.nextPtr     := 0;
    self.viewType    := vtInputLine;
    self.dirtyLevel  := dfClean;
    self.parentDirty := dfClean;
    self.dataPtr     := 0;
    self.bufferSize  := maxLen;
    if (maxLen > MAX_INPUT_LENGTH) {
      self.bufferSize := MAX_INPUT_LENGTH;
    }
    self.curPos      := 0;
    self.firstPos    := 0;
    self.selectStart := -1;
    self.selectEnd   := -1;
    self.isValid     := 1;
    self.options2    := ilCursorIns;
  }

  override fn Draw() {
    if (!FlagSet(self.state, sfVisible)) {
      return;
    }
    var ox: int64 := self.originX;
    var oy: int64 := self.originY;
    MoveCursor(ox, oy);
    if (FlagSet(self.state, sfFocused)) {
      SetColors(colorBlack, colorCyan);
    } else {
      SetColors(colorLightGray, colorBlack);
    }
    PrintCh(91);
    var sx: int64 := self.sizeX;
    var visWidth: int64 := sx - 2;
    var i: int64 := 0;
    while (i < visWidth) {
      PrintCh(32);
      i := i + 1;
    }
    PrintCh(93);
    ResetColors();
    self.dirtyLevel := dfClean;
  }
};

// ============================================================================
// TInputLine Funktionen
// ============================================================================

pub fn InputLineCreate(x: int64, y: int64, maxLen: int64): TInputLine {
  var il: TInputLine := new TInputLine();
  il.Init(x, y, maxLen);
  return il;
}

pub fn InputLineSetInsertMode(il: TInputLine, insert: int64): TInputLine {
  var opts: int64 := il.options2;
  if (insert == 1) {
    var newOpts: int64 := opts | ilCursorIns;
    il.options2 := newOpts;
  } else {
    var mask: int64 := ~ilCursorIns;
    var newOpts: int64 := opts & mask;
    il.options2 := newOpts;
  }
  return il;
}

pub fn InputLineSetSelection(il: TInputLine, start: int64, endPos: int64): TInputLine {
  il.selectStart := start;
  il.selectEnd   := endPos;
  il.dirtyLevel  := dfVisual;
  return il;
}

pub fn InputLineClearSelection(il: TInputLine): TInputLine {
  il.selectStart := -1;
  il.selectEnd   := -1;
  il.dirtyLevel  := dfVisual;
  return il;
}

pub fn InputLineSetCurPos(il: TInputLine, pos: int64): TInputLine {
  var p: int64 := pos;
  if (p < 0) {
    p := 0;
  }
  var bs: int64 := il.bufferSize;
  var bsm1: int64 := bs - 1;
  if (p >= bs) {
    p := bsm1;
  }
  il.curPos := p;
  if (il.curPos < il.firstPos) {
    il.firstPos := il.curPos;
  }
  var sx: int64 := il.sizeX;
  var sx2: int64 := sx - 2;
  var fp: int64 := il.firstPos;
  var scrollEnd: int64 := fp + sx2;
  if (il.curPos >= scrollEnd) {
    var sx3: int64 := sx - 3;
    var cp: int64 := il.curPos;
    var newFp: int64 := cp - sx3;
    if (newFp < 0) {
      newFp := 0;
    }
    il.firstPos := newFp;
  }
  il.dirtyLevel := dfVisual;
  return il;
}

pub fn InputLineDraw(il: TInputLine): TInputLine {
  il.Draw();
  return il;
}

pub fn InputLineProcessKey(il: TInputLine, key: int64): int64 {
  var cmd: int64 := 0;
  if (key == kbLeft) {
    if (il.curPos > 0) {
      var cp: int64 := il.curPos;
      var np: int64 := cp - 1;
      InputLineSetCurPos(il, np);
    }
  } else if (key == kbRight) {
    var bs: int64 := il.bufferSize;
    var bsm1: int64 := bs - 1;
    if (il.curPos < bsm1) {
      var cp: int64 := il.curPos;
      var np: int64 := cp + 1;
      InputLineSetCurPos(il, np);
    }
  } else if (key == kbHome) {
    InputLineSetCurPos(il, 0);
  } else if (key == kbEnd) {
    var bs: int64 := il.bufferSize;
    var bsm1: int64 := bs - 1;
    InputLineSetCurPos(il, bsm1);
  } else if (key == kbBackSp) {
    if (il.curPos > 0) {
      var cp: int64 := il.curPos;
      var np: int64 := cp - 1;
      InputLineSetCurPos(il, np);
      cmd := 1;
    }
  } else if (key == kbDel) {
    cmd := 1;
  } else if (key == kbEnter) {
    cmd := cmOK;
  } else if (key == kbEsc) {
    cmd := cmCancel;
  } else if (key >= 32) {
    if (key < 127) {
      cmd := 2;
    }
  }
  return cmd;
}

// End of std/lyxvision/inputline.lyx
