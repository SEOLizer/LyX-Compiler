// ===========================================================================
// src/paket_pfade.lyx — Paketwurzeln fuer die Modulaufloesung
// ===========================================================================
//
// Ein LPM-Paket liegt im Cache FLACH: `~/.lpm/cache/vega/0.3.1/types.lyx`,
// waehrend die Unit `vega.types` heisst. Ein blosser Include-Pfad hilft
// deshalb nicht — der Aufloeser sucht `vega/types.lyx`, und dieses
// Verzeichnis gibt es dort nicht. Gebraucht wird eine ZUORDNUNG:
//
//   Paketname `vega`  ->  Verzeichnis `~/.lpm/cache/vega/0.3.1`
//   Unit `vega.types` ->  `~/.lpm/cache/vega/0.3.1/types.lyx`
//
// Die Zuordnung reist als eine Zeichenkette `name=pfad:name=pfad` — dieselbe
// Form, die `includePath` seit #1736 fuer mehrere -I-Pfade benutzt.
//
// EINE Umsetzung, zwei Nutzer: `sema._sema_readFile` und `ir_lower._irLeseImport`
// loesen Module getrennt auf (die Kommentare dort sagen ausdruecklich, dass
// beide dieselbe Antwort geben muessen — #1724). Deshalb steht die Rechnung
// hier und nicht zweimal dort.

unit src.paket_pfade;

import src.std.alloc;
import src.std.string;

// Liefert den Kandidatenpfad fuer `rel` (z.B. "vega/types.lyx") aus der
// Zuordnung, oder 0, wenn kein Paket passt.
//
// Getroffen wird nur, wenn das ERSTE Pfadsegment exakt dem Paketnamen
// entspricht. Eine Praefixpruefung waere hier derselbe Fehler wie in #1823:
// `vega` duerfte sonst auch `vegaplat/...` beanspruchen.
pub fn PaketPfadFuer(zuordnung: pchar, rel: pchar): pchar {
  if (zuordnung as int64) == 0 { return 0 as pchar; }
  if (rel as int64) == 0 { return 0 as pchar; }
  var z: int64 := zuordnung as int64;
  var zLen: int64 := StrLen(zuordnung);
  var r: int64 := rel as int64;
  var rLen: int64 := StrLen(rel);

  // Erstes Segment von rel bestimmen: bis zum ersten '/'.
  var seg: int64 := 0;
  while seg < rLen { if peek8(r + seg) == 47 { seg := rLen + 1; } else { seg := seg + 1; } }
  var segLen: int64 := 0 - 1;
  var k: int64 := 0;
  while k < rLen { if peek8(r + k) == 47 { segLen := k; k := rLen; } else { k := k + 1; } }
  if segLen <= 0 { return 0 as pchar; }   // kein '/' -> kein Paketmodul

  var i: int64 := 0;
  while i < zLen {
    // Ein Eintrag reicht bis ':' oder Ende.
    var e: int64 := i;
    while e < zLen { if peek8(z + e) == 58 { e := zLen + 1; } else { e := e + 1; } }
    var eEnde: int64 := zLen;
    var q: int64 := i;
    while q < zLen { if peek8(z + q) == 58 { eEnde := q; q := zLen; } else { q := q + 1; } }

    // '=' innerhalb des Eintrags
    var gl: int64 := 0 - 1;
    var g: int64 := i;
    while g < eEnde { if peek8(z + g) == 61 { gl := g; g := eEnde; } else { g := g + 1; } }

    if gl > i {
      var nLen: int64 := gl - i;
      if nLen == segLen {
        var gleich: int64 := 1;
        var c: int64 := 0;
        while c < nLen {
          if peek8(z + i + c) != peek8(r + c) { gleich := 0; c := nLen; }
          c := c + 1;
        }
        if gleich == 1 {
          // Treffer: <pfad> + "/" + rel OHNE das erste Segment.
          var dLen: int64 := eEnde - (gl + 1);
          var restLen: int64 := rLen - (segLen + 1);
          var buf: int64 := alloc(dLen + 1 + restLen + 1);
          var a: int64 := 0;
          while a < dLen { poke8(buf + a, peek8(z + gl + 1 + a)); a := a + 1; }
          poke8(buf + dLen, 47);
          var b: int64 := 0;
          while b < restLen { poke8(buf + dLen + 1 + b, peek8(r + segLen + 1 + b)); b := b + 1; }
          poke8(buf + dLen + 1 + restLen, 0);
          return buf as pchar;
        }
      }
    }
    i := eEnde + 1;
  }
  return 0 as pchar;
}
