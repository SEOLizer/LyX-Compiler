// ============================================================================
// src/emit_write.lyx — Ausgabedatei schreiben, oder laut scheitern (#1682)
//
// Bis 1.1.3I hat JEDER Backend-Writer den Fehlschlag fuer sich behandelt, und
// alle zwoelf endeten gleich: Meldung ausgeben, zurueckkehren — und lyxc
// beendete sich mit Status 0. Ein Makefile oder eine CI, die den Status
// auswertet, hielt den Lauf fuer erfolgreich und arbeitete mit dem ALTEN
// Binary weiter.
//
// Der Anlass ist kein Sonderfall: liegt die Zieldatei gerade in Ausfuehrung,
// liefert open() ETXTBSY. Wer nebenher einen Testlauf hat, uebersetzt neu,
// bekommt "OK" — und sucht danach einen Fehler in Code, der laengst behoben
// ist, weil auf der Platte das alte Binary liegt.
//
// Deshalb hier EINE Stelle, die schreibt, und die nicht zurueckkehren kann,
// ohne dass die Datei vollstaendig geschrieben ist.
// ============================================================================

@description("Ausgabedatei schreiben oder mit Status 74 scheitern")
@version("1.0.0")

unit src.emit_write;

import src.std.io;

// sysexits(3): EX_IOERR. Ungleich 0 ist das, worauf sich Makefiles verlassen;
// ein eigener Wert trennt den Schreibfehler von den uebrigen Abbruechen (70).
pub con EMIT_EX_IOERR: int64 := 74;

fn _melde(path: pchar, was: pchar) {
  EPrintStr("error: codegen: "c);
  EPrintStr(was);
  EPrintStr(": "c);
  EPrintStrLn(path);
}

// Schreibt `size` Bytes aus `buf` nach `path` (0755) und kehrt nur zurueck,
// wenn ALLES angekommen ist. Sonst: Meldung auf stderr und Ende mit 74.
//
// write() kann kurz schreiben, ohne dass etwas kaputt ist — deshalb die
// Schleife. Ein ungeprueftes write() haette ein abgeschnittenes Binary
// hinterlassen, und zwar wieder still.
pub fn EmitWriteFile(path: pchar, buf: int64, size: int64) {
  var fd: int64 := open(path, 577, 493);
  if (fd < 0) {
    // ETXTBSY ist der haeufigste Anlass und von aussen nicht offensichtlich.
    if (fd == 0 - 26) {
      _melde(path, "Ausgabedatei laeuft gerade (ETXTBSY), nicht ueberschreibbar"c);
    } else {
      _melde(path, "Ausgabedatei laesst sich nicht oeffnen"c);
    }
    exit(EMIT_EX_IOERR);
  }
  var ab: int64 := 0;
  while (ab < size) {
    var n: int64 := write(fd, (buf + ab) as pchar, size - ab);
    if (n <= 0) {
      close(fd);
      _melde(path, "Ausgabedatei nicht vollstaendig geschrieben"c);
      exit(EMIT_EX_IOERR);
    }
    ab := ab + n;
  }
  close(fd);
}

// ============================================================================
// #1968: Laenge einer IR-Zeichenkette aus ihrem VORSPANN
//
// Die IR-Zeichenkettentabelle war bis 1.2.2D allein nullterminiert, und jedes
// Backend mass beim Ausgeben mit StrLen. Ein Nullbyte im INHALT schnitt damit
// alles Weitere ab: unter qemu-aarch64 wurden aus den fuenf Bytes `AB\0CD` die
// drei Bytes `AB\0` plus zwei FREMDE aus dem anschliessenden Speicher. Das traf
// jedes Literal mit `\0`, nicht nur eingebettete Dateien (#1961).
//
// irAddString legt jetzt acht Byte mit der Laenge VOR die Zeichen; der Offset
// zeigt weiter auf das erste Zeichen, die abschliessende Null bleibt ebenfalls
// (die Laufzeit erwartet sie bei pchar) — sie ist nur nicht mehr das Mass.
//
// Diese Funktion steht hier und nicht viermal in den Backends: vier Abschriften
// derselben Rechnung waeren genau die Doppelung, aus der spaeter eine
// Divergenz wird.
pub fn _irStrLenVorspann(strBuf: int64, off: int64): int64 {
  if (off < 8) { return 0; }
  var v: int64 := 0;
  var i: int64 := 0;
  while (i < 8) {
    v := v | ((peek8(strBuf + off - 8 + i) & 255) << (i * 8));
    i := i + 1;
  }
  return v;
}
