// src/crypto/lic_secret.dev.lyx — Entwicklungsvorgabe fuer das Lizenz-Secret.
//
// #1170: `src/crypto/lic_secret.lyx` steht in `.gitignore`, wird zum Uebersetzen
// der Compilerquelle aber gebraucht. Ein frischer Checkout scheiterte deshalb
// mit vier sema-Fehlern (`undefined function 'lic_getMasterSecret'` und
// Geschwister), und die CI konnte ihre eigene Bootstrap-Pruefung nicht
// ausfuehren. Diese Datei ist die Vorgabe, die das Makefile an die Stelle
// kopiert, wenn dort nichts liegt.
//
// ACHTUNG — WAS HIER STEHT, IST KEIN GEHEIMNIS UND DARF KEINES WERDEN:
//
//   * Das Master-Secret ist eine lesbare Zeichenkette. Absichtlich: eine
//     Verschleierung haette hier nichts zu verbergen und wuerde nur so
//     aussehen, als steckte ein echter Schluessel darin. Wer diese Datei
//     sieht, soll sofort erkennen, dass sie eine Vorgabe ist.
//   * Der Ed25519-Public-Key ist der Testvektor 1 aus RFC 8032
//     (d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a) —
//     ein oeffentlicher Wert aus einem Standarddokument, kein Produktionskey.
//
// Fuer ein Release werden BEIDE Werte ersetzt: `python3 tools/gen_lic_secret.py`
// erzeugt eine echte `lic_secret.lyx` mit maskiertem Secert und dem eigenen
// Public-Key. Diese Datei bleibt dabei unangetastet und wird nicht benutzt,
// solange `lic_secret.lyx` vorhanden ist.
//
// Damit ist der Unterschied zwischen Entwicklungs- und Release-Bau benannt,
// statt sich hinter einer fehlenden Datei zu verstecken.

// -----------------------------------------------------------------------
// lic_getMasterSecret — fuellt out32 mit dem 32-Byte-Secret.
//
// out32: Aufrufer-allokierter Puffer, mind. 32 Bytes.
// Der Aufrufer MUSS lic_zeroSecret(out32) nach Verwendung aufrufen — die
// Zusage gilt hier genauso, auch wenn der Wert keine Geheimhaltung braucht:
// der Aufrufpfad soll sich zwischen Dev- und Release-Bau nicht unterscheiden.
//
// Der Wert ist die ASCII-Zeichenkette "LYX-DEV-SECRET-NOT-FOR-PRODUCTIO"
// (32 Zeichen, ohne abschliessende Null).
// -----------------------------------------------------------------------
pub fn lic_getMasterSecret(out32: int64) {
  poke8(out32+0,  76);  poke8(out32+1,  89);  poke8(out32+2,  88);  poke8(out32+3,  45);   // L Y X -
  poke8(out32+4,  68);  poke8(out32+5,  69);  poke8(out32+6,  86);  poke8(out32+7,  45);   // D E V -
  poke8(out32+8,  83);  poke8(out32+9,  69);  poke8(out32+10, 67);  poke8(out32+11, 82);   // S E C R
  poke8(out32+12, 69);  poke8(out32+13, 84);  poke8(out32+14, 45);  poke8(out32+15, 78);   // E T - N
  poke8(out32+16, 79);  poke8(out32+17, 84);  poke8(out32+18, 45);  poke8(out32+19, 70);   // O T - F
  poke8(out32+20, 79);  poke8(out32+21, 82);  poke8(out32+22, 45);  poke8(out32+23, 80);   // O R - P
  poke8(out32+24, 82);  poke8(out32+25, 79);  poke8(out32+26, 68);  poke8(out32+27, 85);   // R O D U
  poke8(out32+28, 67);  poke8(out32+29, 84);  poke8(out32+30, 73);  poke8(out32+31, 79);   // C T I O
}

// -----------------------------------------------------------------------
// lic_zeroSecret — ueberschreibt einen Secret-Puffer mit Nullen.
// V-3: poke8 ist fuer den Compiler opaque — Schreibvorgaenge werden nicht
//      als dead stores eliminiert (entspricht WP-36 SecureZero).
// -----------------------------------------------------------------------
pub fn lic_zeroSecret(buf: int64) {
  var i: int64 := 0;
  while (i < 32) {
    poke8(buf + i, 0);
    i := i + 1;
  }
}

// -----------------------------------------------------------------------
// lic_getPublicKey — fuellt out32 mit dem 32-Byte Ed25519-Public-Key.
// RFC-8032-Testvektor-1-Public-Key; nur fuer Tests geeignet.
// -----------------------------------------------------------------------
pub fn lic_getPublicKey(out32: int64) {
  poke8(out32+0,  215); poke8(out32+1,  90);  poke8(out32+2,  152); poke8(out32+3,  1);
  poke8(out32+4,  130); poke8(out32+5,  177); poke8(out32+6,  10);  poke8(out32+7,  183);
  poke8(out32+8,  213); poke8(out32+9,  75);  poke8(out32+10, 254); poke8(out32+11, 211);
  poke8(out32+12, 201); poke8(out32+13, 100); poke8(out32+14, 7);   poke8(out32+15, 58);
  poke8(out32+16, 14);  poke8(out32+17, 225); poke8(out32+18, 114); poke8(out32+19, 243);
  poke8(out32+20, 218); poke8(out32+21, 166); poke8(out32+22, 35);  poke8(out32+23, 37);
  poke8(out32+24, 175); poke8(out32+25, 2);   poke8(out32+26, 26);  poke8(out32+27, 104);
  poke8(out32+28, 247); poke8(out32+29, 7);   poke8(out32+30, 81);  poke8(out32+31, 26);
}
