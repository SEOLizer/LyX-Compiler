// WP-LIC-05: Lizenz-Datei-Parser
//
// Liest ~/.lyx/license.key (oder einen beliebigen Pfad) im Format:
//   name=Vorname Nachname
//   email=user@example.com
//   key=XXXXX-XXXXX-XXXXX-XXXXX-XXXXX
//
// Leerzeilen und Zeilen ohne '=' werden ignoriert.
// Zeilen die mit '#' beginnen, werden ignoriert.
// Zeilenenden: LF und CRLF werden beide unterstützt.
//
// Die zurückgegebenen pchar-Zeiger in LicenseInfo zeigen in den mmap-Puffer
// (out.fileBuf). Dieser muss mit lic_infoFree() freigegeben werden.

import src.crypto.lic_types;
import src.std.alloc;

// ---------------------------------------------------------------------------
// lic_parseFile — Lizenz-Datei einlesen und parsen
//
// Rückgabe: true wenn name, email und key gefunden wurden.
//           out.errCode enthält den Detailcode.
// ---------------------------------------------------------------------------
pub fn lic_parseFile(path: pchar, out: LicenseInfo): bool {
  var fd: int64 := open(path, 0, 0);  // O_RDONLY = 0
  if fd < 0 {
    out.errCode := LIC_ERR_NO_LICENSE;
    return false;
  }

  var size: int64 := lseek(fd, 0, 2);  // SEEK_END
  if size <= 0 {
    close(fd);
    out.errCode := LIC_ERR_NO_LICENSE;
    return false;
  }
  lseek(fd, 0, 0);  // SEEK_SET

  var buf: int64 := alloc(size + 1);
  if buf == 0 {
    close(fd);
    out.errCode := LIC_ERR_NO_LICENSE;
    return false;
  }

  read(fd, buf, size);
  close(fd);
  poke8(buf + size, 0);

  out.fileBuf    := buf;
  out.fileBufLen := size + 1;

  // ---- Zeile für Zeile scannen ----
  var i: int64 := 0;
  while i < size {
    // Zeilenende suchen (LF = 10)
    var lineEnd: int64 := i;
    while lineEnd < size && peek8(buf + lineEnd) != 10 {
      lineEnd := lineEnd + 1;
    }

    // '=' in dieser Zeile suchen
    var eq: int64 := i;
    while eq < lineEnd && peek8(buf + eq) != 61 {
      eq := eq + 1;
    }

    if eq < lineEnd {
      var kStart: int64 := i;
      var kLen:   int64 := eq - i;
      var vStart: int64 := eq + 1;
      var vEnd:   int64 := lineEnd;

      // Führendes '#' → Kommentar, ignorieren
      var firstByte: int64 := peek8(buf + kStart);
      if firstByte != 35 {
        // Trailing '\r' abschneiden
        if vEnd > vStart && peek8(buf + vEnd - 1) == 13 { vEnd := vEnd - 1; }
        // Value in-place null-terminieren
        poke8(buf + vEnd, 0);
        var vLen: int64 := vEnd - vStart;

        // Schlüsselwort "name" (n=110, a=97, m=109, e=101)
        if kLen == 4 && peek8(buf+kStart)==110 && peek8(buf+kStart+1)==97 && peek8(buf+kStart+2)==109 && peek8(buf+kStart+3)==101 {
          out.name    := (buf + vStart) as pchar;
          out.nameLen := vLen;
        }
        // Schlüsselwort "email" (e=101, m=109, a=97, i=105, l=108)
        if kLen == 5 && peek8(buf+kStart)==101 && peek8(buf+kStart+1)==109 && peek8(buf+kStart+2)==97 && peek8(buf+kStart+3)==105 && peek8(buf+kStart+4)==108 {
          out.email    := (buf + vStart) as pchar;
          out.emailLen := vLen;
        }
        // Schlüsselwort "key" (k=107, e=101, y=121)
        if kLen == 3 && peek8(buf+kStart)==107 && peek8(buf+kStart+1)==101 && peek8(buf+kStart+2)==121 {
          out.key    := (buf + vStart) as pchar;
          out.keyLen := vLen;
        }
      }
    }

    i := lineEnd + 1;
  }

  // Vollständigkeitsprüfung
  if out.nameLen == 0 || out.emailLen == 0 {
    out.errCode := LIC_ERR_MISSING_FIELD;
    return false;
  }
  if out.keyLen == 0 {
    out.errCode := LIC_ERR_BAD_FORMAT;
    return false;
  }

  out.errCode := LIC_OK;
  return true;
}

// ---------------------------------------------------------------------------
// lic_infoFree — gibt den mmap-Puffer des Lizenzfiles frei
// ---------------------------------------------------------------------------
pub fn lic_infoFree(out: LicenseInfo) {
  if out.fileBuf != 0 {
    free(out.fileBuf, out.fileBufLen);
    out.fileBuf    := 0;
    out.fileBufLen := 0;
  }
}
