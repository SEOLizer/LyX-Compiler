// ─── Unsigned 64-bit right shift (>> ist in Lyx arithmetisch/vorzeichenbehaftet) ──

fn _sha512_shr(x: int64, n: int64): int64 {
  if x >= 0 { return x >> n; }
  // Arithmetisches >> füllt mit 1en; wir brauchen 0-Füllung
  // Maske: 0x7FFFFFFFFFFFFFFF >> (n-1) löscht die top-n Bits
  return (x >> n) & (0x7FFFFFFFFFFFFFFF >> (n - 1));
}

fn _sha512_rotr(x: int64, n: int64): int64 {
  return _sha512_shr(x, n) | (x << (64 - n));
}

