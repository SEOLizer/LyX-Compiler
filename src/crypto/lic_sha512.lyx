// ─── Ein 128-Byte-Block komprimieren ─────────────────────────────────────────

fn _sha512_block(state: int64, block: int64, K: int64) {
  var W: int64 := alloc(640);  // 80 × 8 Bytes
  if W == 0 { return; }

  // W[0..15] aus Block laden (big-endian 64-Bit-Wörter)
  var i: int64 := 0;
  while i < 16 {
    var j: int64 := i * 8;
    var w: int64 :=
      (peek8(block+j+0) << 56) | (peek8(block+j+1) << 48) |
      (peek8(block+j+2) << 40) | (peek8(block+j+3) << 32) |
      (peek8(block+j+4) << 24) | (peek8(block+j+5) << 16) |
      (peek8(block+j+6) <<  8) |  peek8(block+j+7);
    poke64(W + i*8, w);
    i := i + 1;
  }

  // W[16..79] expandieren
  i := 16;
  while i < 80 {
    var w15: int64 := peek64(W + (i-15)*8);
    var w2:  int64 := peek64(W + (i-2)*8);
    var s0: int64 := _sha512_rotr(w15, 1) ^ _sha512_rotr(w15, 8) ^ _sha512_shr(w15, 7);
    var s1: int64 := _sha512_rotr(w2, 19) ^ _sha512_rotr(w2, 61) ^ _sha512_shr(w2, 6);
    poke64(W + i*8, peek64(W+(i-16)*8) + s0 + peek64(W+(i-7)*8) + s1);
    i := i + 1;
  }

  // Zustand laden
  var a: int64 := peek64(state+0);
  var b: int64 := peek64(state+8);
  var c: int64 := peek64(state+16);
  var d: int64 := peek64(state+24);
  var e: int64 := peek64(state+32);
  var f: int64 := peek64(state+40);
  var g: int64 := peek64(state+48);
  var h: int64 := peek64(state+56);

  // 80 Runden
  i := 0;
  while i < 80 {
    var S1: int64 := _sha512_rotr(e,14) ^ _sha512_rotr(e,18) ^ _sha512_rotr(e,41);
    var ch: int64 := (e & f) ^ ((e ^ (0-1)) & g);
    var t1: int64 := h + S1 + ch + peek64(K+i*8) + peek64(W+i*8);
    var S0: int64 := _sha512_rotr(a,28) ^ _sha512_rotr(a,34) ^ _sha512_rotr(a,39);
    var mj: int64 := (a & b) ^ (a & c) ^ (b & c);
    var t2: int64 := S0 + mj;
    h := g; g := f; f := e; e := d + t1;
    d := c; c := b; b := a; a := t1 + t2;
    i := i + 1;
  }

  // Akkumulieren
  poke64(state+0,  peek64(state+0)  + a);
  poke64(state+8,  peek64(state+8)  + b);
  poke64(state+16, peek64(state+16) + c);
  poke64(state+24, peek64(state+24) + d);
  poke64(state+32, peek64(state+32) + e);
  poke64(state+40, peek64(state+40) + f);
  poke64(state+48, peek64(state+48) + g);
  poke64(state+56, peek64(state+56) + h);

  free(W, 640);
}

// ─── SHA-512 Hauptfunktion ────────────────────────────────────────────────────

pub fn lic_sha512(input: int64, inLen: int64, out64: int64) {
  if inLen < 0 { return; }

  var K:  int64 := alloc(640);
  var st: int64 := alloc(64);
  if K == 0 || st == 0 {
    if K  != 0 { free(K, 640); }
    if st != 0 { free(st, 64); }
    return;
  }

  _sha512_initK(K);
  _sha512_initH(st);

  // Padding: message || 0x80 || zeros || bit_length (128-bit BE)
  // padLen ≡ 112 (mod 128)
  var padLen: int64 := inLen + 1;
  var rem: int64 := padLen - (padLen / 128) * 128;
  if rem <= 112 {
    padLen := padLen + (112 - rem);
  } else {
    padLen := padLen + (240 - rem);
  }
  padLen := padLen + 16;  // 128-bit length field

  var padded: int64 := alloc(padLen);
  if padded == 0 { free(K, 640); free(st, 64); return; }

  var i: int64 := 0;
  while i < inLen { poke8(padded+i, peek8(input+i)); i := i+1; }
  poke8(padded + inLen, 0x80);
  i := inLen + 1;
  while i < padLen { poke8(padded+i, 0); i := i+1; }

  // Bit-Länge als 128-Bit big-endian (obere 8 Bytes = 0 für Nachrichten < 2^61 Bytes)
  var bitLen: int64 := inLen * 8;
  var lp: int64 := padLen - 8;
  poke8(padded+lp+0, _sha512_shr(bitLen, 56) & 255);
  poke8(padded+lp+1, _sha512_shr(bitLen, 48) & 255);
  poke8(padded+lp+2, _sha512_shr(bitLen, 40) & 255);
  poke8(padded+lp+3, _sha512_shr(bitLen, 32) & 255);
  poke8(padded+lp+4, (bitLen >> 24) & 255);
  poke8(padded+lp+5, (bitLen >> 16) & 255);
  poke8(padded+lp+6, (bitLen >>  8) & 255);
  poke8(padded+lp+7,  bitLen        & 255);

  // Blöcke verarbeiten
  var nb: int64 := padLen / 128;
  i := 0;
  while i < nb { _sha512_block(st, padded + i*128, K); i := i+1; }

  free(padded, padLen);
  free(K, 640);

  // Ausgabe: 8 Wörter als big-endian Bytes
  i := 0;
  while i < 8 {
    var word: int64 := peek64(st + i*8);
    poke8(out64 + i*8 + 0, _sha512_shr(word, 56) & 255);
    poke8(out64 + i*8 + 1, _sha512_shr(word, 48) & 255);
    poke8(out64 + i*8 + 2, _sha512_shr(word, 40) & 255);
    poke8(out64 + i*8 + 3, _sha512_shr(word, 32) & 255);
    poke8(out64 + i*8 + 4, (word >> 24) & 255);
    poke8(out64 + i*8 + 5, (word >> 16) & 255);
    poke8(out64 + i*8 + 6, (word >>  8) & 255);
    poke8(out64 + i*8 + 7,  word        & 255);
    i := i + 1;
  }

  free(st, 64);
}
