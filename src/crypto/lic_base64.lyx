// src/crypto/lic_base64.lyx — Base64-Dekodierung für Ed25519-Lizenzschlüssel (WP-29)
// Dekodiert Standard-Base64 (RFC 4648) mit oder ohne Padding.

import src.std.alloc;

// Konvertiert ein Base64-Zeichen → 6-Bit-Wert; -1 bei ungültigem Zeichen.
fn _b64_val(c: int64): int64 {
  if c >= 65 && c <= 90  { return c - 65; }       // A-Z = 0-25
  if c >= 97 && c <= 122 { return c - 71; }        // a-z = 26-51
  if c >= 48 && c <= 57  { return c + 4; }         // 0-9 = 52-61
  if c == 43 { return 62; }                        // '+'
  if c == 47 { return 63; }                        // '/'
  return 0 - 1;                                    // ungültig
}

// lic_base64Decode — dekodiert Base64-String → Bytes
//
// input:  Zeiger auf Base64-Zeichenkette
// inLen:  Länge (ohne Null-Terminator; Padding-'=' wird ignoriert)
// out:    Aufrufer-Puffer (mind. (inLen/4)*3 Bytes)
// Rückgabe: Anzahl dekodierter Bytes; 0 bei Fehler.
pub fn lic_base64Decode(input: int64, inLen: int64, out: int64): int64 {
  var outPos: int64 := 0;
  var i: int64 := 0;

  while i + 3 < inLen {
    var c0: int64 := _b64_val(peek8(input + i));
    var c1: int64 := _b64_val(peek8(input + i + 1));
    var c2: int64 := _b64_val(peek8(input + i + 2));
    var c3: int64 := _b64_val(peek8(input + i + 3));

    // Überspringe Padding und ungültige Zeichen am Ende
    if c0 < 0 || c1 < 0 { i := i + 4; }
    else {
      poke8(out + outPos, (c0 << 2) | (c1 >> 4));
      outPos := outPos + 1;
      if c2 >= 0 {
        poke8(out + outPos, ((c1 & 15) << 4) | (c2 >> 2));
        outPos := outPos + 1;
        if c3 >= 0 {
          poke8(out + outPos, ((c2 & 3) << 6) | c3);
          outPos := outPos + 1;
        }
      }
      i := i + 4;
    }
  }

  // Rest (1-3 übrige Zeichen ohne vollständige Gruppe)
  if i + 1 < inLen {
    var c0: int64 := _b64_val(peek8(input + i));
    var c1: int64 := _b64_val(peek8(input + i + 1));
    if c0 >= 0 && c1 >= 0 {
      poke8(out + outPos, (c0 << 2) | (c1 >> 4));
      outPos := outPos + 1;
    }
    if i + 2 < inLen {
      var c2: int64 := _b64_val(peek8(input + i + 2));
      if c2 >= 0 {
        poke8(out + outPos, ((_b64_val(peek8(input+i+1)) & 15) << 4) | (c2 >> 2));
        outPos := outPos + 1;
      }
    }
  }

  return outPos;
}

// lic_base64Encode — kodiert Bytes → Base64-String (ohne Padding)
// Rückgabe: Anzahl geschriebener Zeichen.
pub fn lic_base64Encode(input: int64, inLen: int64, out: int64): int64 {
  var tbl: pchar := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"c;
  var outPos: int64 := 0;
  var i: int64 := 0;

  while i + 2 < inLen {
    var b0: int64 := peek8(input + i);
    var b1: int64 := peek8(input + i + 1);
    var b2: int64 := peek8(input + i + 2);
    poke8(out + outPos,     peek8(tbl as int64 + (b0 >> 2)));
    poke8(out + outPos + 1, peek8(tbl as int64 + (((b0 & 3) << 4) | (b1 >> 4))));
    poke8(out + outPos + 2, peek8(tbl as int64 + (((b1 & 15) << 2) | (b2 >> 6))));
    poke8(out + outPos + 3, peek8(tbl as int64 + (b2 & 63)));
    outPos := outPos + 4;
    i := i + 3;
  }

  if i < inLen {
    var b0: int64 := peek8(input + i);
    poke8(out + outPos, peek8(tbl as int64 + (b0 >> 2)));
    if i + 1 < inLen {
      var b1: int64 := peek8(input + i + 1);
      poke8(out + outPos + 1, peek8(tbl as int64 + (((b0 & 3) << 4) | (b1 >> 4))));
      poke8(out + outPos + 2, peek8(tbl as int64 + ((b1 & 15) << 2)));
    } else {
      poke8(out + outPos + 1, peek8(tbl as int64 + ((b0 & 3) << 4)));
    }
    outPos := outPos + 3;
  }

  poke8(out + outPos, 0);
  return outPos;
}
