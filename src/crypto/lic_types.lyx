// WP-LIC-01: Lizenz-Datentypen und Fehlercodes
//
// Dieses Modul wird von lic_parse, lic_derive und lyxc.lyx gemeinsam genutzt.

// ---------------------------------------------------------------------------
// Fehlercodes
// ---------------------------------------------------------------------------
pub con LIC_OK:               int64 := 0;   // Lizenz gültig
pub con LIC_ERR_NO_LICENSE:   int64 := 1;   // keine Lizenzdaten vorhanden
pub con LIC_ERR_MISSING_FIELD: int64 := 2;  // Name oder E-Mail fehlt
pub con LIC_ERR_BAD_FORMAT:   int64 := 3;   // Schlüsselformat ungültig
pub con LIC_ERR_KEY_MISMATCH: int64 := 4;   // Schlüssel passt nicht zu Name+E-Mail

// ---------------------------------------------------------------------------
// LicenseInfo — geparste Lizenzdaten
// ---------------------------------------------------------------------------
pub type LicenseInfo = class {
  name:        pchar;   // zeigt in fileBuf oder CLI-Argument
  nameLen:     int64;
  email:       pchar;
  emailLen:    int64;
  key:         pchar;   // 29 Zeichen "XXXXX-XXXXX-XXXXX-XXXXX-XXXXX\0"
  keyLen:      int64;
  valid:       bool;    // true wenn key == lic_deriveKey(name, email)
  errCode:     int64;   // LIC_OK oder LIC_ERR_*
  fileBuf:     int64;   // mmap-Puffer des Lizenzfiles (0 wenn nicht aus Datei)
  fileBufLen:  int64;   // Größe für munmap

  pub fn Init(): void {
    self.name       := 0 as pchar;
    self.nameLen    := 0;
    self.email      := 0 as pchar;
    self.emailLen   := 0;
    self.key        := 0 as pchar;
    self.keyLen     := 0;
    self.valid      := false;
    self.errCode    := LIC_OK;
    self.fileBuf    := 0;
    self.fileBufLen := 0;
  }
};
