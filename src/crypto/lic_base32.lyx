// WP-LIC-04: Crockford-Base32-Encoder
//
// Alphabet: 0123456789ABCDEFGHJKMNPQRSTVWXYZ  (kein I, L, O, U)
// 5 Bits pro Zeichen, MSB zuerst.
// 32 Eingabe-Bytes → 51 Ausgabe-Zeichen (floor(256/5)).

// ---------------------------------------------------------------------------
// lic_base32Encode
//
// Kodiert `inLen` Bytes ab `input` in Crockford-Base32.
// `out` muss mind. floor(inLen*8/5)+1 Bytes fassen.
// Gibt die Anzahl geschriebener Zeichen zurück (ohne Null-Terminator).
// ---------------------------------------------------------------------------
pub fn lic_base32Encode(input: int64, inLen: int64, out: pchar): int64 {
  var alpha: pchar := "0123456789ABCDEFGHJKMNPQRSTVWXYZ"c;
  var outLen:    int64 := 0;
  var bitPos:    int64 := 0;
  var totalBits: int64 := inLen * 8;

  while bitPos + 5 <= totalBits {
    var byteIdx: int64 := bitPos / 8;
    var bitOff:  int64 := bitPos - byteIdx * 8;
    var val:     int64 := 0;

    if bitOff <= 3 {
      // Alle 5 Bits liegen in einem Byte
      val := (peek8(input + byteIdx) >> (3 - bitOff)) & 31;
    } else {
      // 5 Bits überspannen zwei benachbarte Bytes
      var bitsFirst:  int64 := 8 - bitOff;
      var bitsSecond: int64 := 5 - bitsFirst;
      var lo: int64 := peek8(input + byteIdx) & ((1 << bitsFirst) - 1);
      var hi: int64 := peek8(input + byteIdx + 1) >> (8 - bitsSecond);
      val := (lo << bitsSecond) | hi;
    }

    poke8(out as int64 + outLen, StrCharAt(alpha, val));
    outLen := outLen + 1;
    bitPos := bitPos + 5;
  }

  poke8(out as int64 + outLen, 0);
  return outLen;
}

// ---------------------------------------------------------------------------
// lic_base32FormatKey
//
// Formatiert die ersten 25 Zeichen von `raw` als Lizenzschlüssel:
//   XXXXX-XXXXX-XXXXX-XXXXX-XXXXX
// `out29` muss mind. 30 Bytes fassen (25 + 4 Bindestriche + Null).
// Voraussetzung: rawLen >= 25.
// ---------------------------------------------------------------------------
pub fn lic_base32FormatKey(raw: pchar, rawLen: int64, out29: pchar) {
  if rawLen < 25 { return; }
  var i: int64 := 0;
  var o: int64 := 0;
  while i < 25 {
    if i > 0 && (i % 5) == 0 {
      poke8(out29 as int64 + o, 45);
      o := o + 1;
    }
    poke8(out29 as int64 + o, peek8(raw as int64 + i));
    o := o + 1;
    i := i + 1;
  }
  poke8(out29 as int64 + o, 0);
}
