// WP-LIC-13: Master-Secret-Obfuskation
//
// Das 32-Byte-Master-Secret wird als 4 × int64 gespeichert.
// Jeder Teil ist mit einer Noise-Konstante XOR-maskiert.
// Masken und maskierte Werte sind nicht paarweise benachbart.
// Das Secret existiert niemals als zusammenhängendes Literal in der Binary.
//
// ACHTUNG: Diese Werte vor dem ersten produktiven Release rotieren!
// Neue Werte erzeugen: python3 tools/gen_lic_secret.py

// ---- Compiler-Build-Metadaten (Teil A) --------------------------------
// Erscheint als Build-Prüfsummen-Vektor (P0 = S0 ^ N0)
con _LYC_CHK_VECTOR: int64 := 0xf0b8ec8dad54d4b2;

// ---- Parser-Zustandskonstanten ----------------------------------------
// Erscheint als Parser-Initialisierungswert (N1 = Maske für S1)
con _LYC_PARSE_SALT: int64 := 0xc4f23a890b6e51d7;

// ---- Codegen-Fingerprint (Teil B) ------------------------------------
// Erscheint als Codegen-Ausgabe-Prüfwert (P2 = S2 ^ N2)
con _LYC_CG_FPRINT: int64 := 0xffd138439d379485;

// ---- Versionsstempel --------------------------------------------------
// Erscheint als Version-Hashwert (N3 = Maske für S3)
con _LYC_VER_STAMP: int64 := 0xf07d3e92a15b8463;

// ---- Compiler-Build-Metadaten (Teil B) --------------------------------
// Erscheint als Build-ID-Anteil (N0 = Maske für S0)
con _LYC_BUILD_ID_A: int64 := 0x59cbae71234f89d2;

// ---- Emit-Schicht-Konstante -------------------------------------------
// Erscheint als Emit-Phase-Seed (P1 = S1 ^ N1)
con _LYC_EMIT_SEED: int64 := 0xfb7926c779b4577e;

// ---- Codegen-Identität ------------------------------------------------
// Erscheint als Codegen-Identitätswert (N2 = Maske für S2)
con _LYC_CG_ID_LOW: int64 := 0x2b8716f3e40d5c9a;

// ---- Versions-Quersumme -----------------------------------------------
// Erscheint als Versions-Prüfwert (P3 = S3 ^ N3)
con _LYC_VER_XSUM: int64 := 0xeef235e78282c8c5;

// -----------------------------------------------------------------------
// lic_getMasterSecret — assembliert das 32-Byte-Secret zur Laufzeit.
//
// out32: Aufrufer-allokierter Puffer, mind. 32 Bytes.
// Der Aufrufer MUSS lic_zeroSecret(out32) nach Verwendung aufrufen.
//
// Ablauf:
//   S0 = _LYC_CHK_VECTOR  ^ _LYC_BUILD_ID_A   (bytes  0- 7)
//   S1 = _LYC_EMIT_SEED   ^ _LYC_PARSE_SALT   (bytes  8-15)
//   S2 = _LYC_CG_FPRINT   ^ _LYC_CG_ID_LOW    (bytes 16-23)
//   S3 = _LYC_VER_XSUM    ^ _LYC_VER_STAMP    (bytes 24-31)
// -----------------------------------------------------------------------
pub fn lic_getMasterSecret(out32: int64) {
  var s0: int64 := _LYC_CHK_VECTOR  ^ _LYC_BUILD_ID_A;
  var s1: int64 := _LYC_EMIT_SEED   ^ _LYC_PARSE_SALT;
  var s2: int64 := _LYC_CG_FPRINT   ^ _LYC_CG_ID_LOW;
  var s3: int64 := _LYC_VER_XSUM    ^ _LYC_VER_STAMP;
  poke64(out32,       s0);
  poke64(out32 +  8,  s1);
  poke64(out32 + 16,  s2);
  poke64(out32 + 24,  s3);
  s0 := 0;
  s1 := 0;
  s2 := 0;
  s3 := 0;
}

// -----------------------------------------------------------------------
// lic_zeroSecret — überschreibt einen Secret-Puffer mit Nullen.
// Immer nach lic_getMasterSecret aufrufen.
// -----------------------------------------------------------------------
pub fn lic_zeroSecret(buf: int64) {
  poke64(buf,       0);
  poke64(buf +  8,  0);
  poke64(buf + 16,  0);
  poke64(buf + 24,  0);
}
