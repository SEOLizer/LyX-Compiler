// ==================================================================
// WP-21: IR-Optimierungen in Lyx
// ==================================================================
// Vollständige IR-Optimierungs-Implementierung:
// - Constant Folding
// - Copy Propagation
// - Dead Code Elimination
// - Common Subexpression Elimination (CSE)
// - Strength Reduction
// - 2-Pass iterativer Durchlauf
//
// Referenz: compiler/ir/ir_optimize.pas

import src.ir;
import src.std.alloc;

// ============================================================================
// IROptimize Class
// ============================================================================

pub type IROptimize = class {
  ir: IRModule;
  passCount: int64;
  changed: int64;
  defCount: int64;
  useCount: int64;
  domCount: int64;
  optLevel:  int64;  // WP-AS-06: 0=none, 1=min, 2=default, 3=aggressive (mirrors CompilerConfig.optLevel)
  fnStart: int64;    // instruction index where current function starts (inclusive)
  fnEnd: int64;      // instruction index where current function ends (exclusive)

  fn init(irMod: IRModule) {
    self.ir := irMod;
    self.passCount := 0;
    self.changed := 0;
    self.defCount := 0;
    self.useCount := 0;
    self.domCount := 0;
    self.optLevel  := 2;  // WP-AS-06: default = O2
    self.fnStart := 0;
    self.fnEnd := 0;
  }

  // ------------------------------------------------------------------
  // Main Optimization Entry Point
  // ------------------------------------------------------------------

  // WP-AS-06: Run optimization passes gated by optLevel.
  // optLevel=0 → nothing; optLevel=1 → dead-code only;
  // optLevel=2 → full passes (default); optLevel=3 → aggressive (more iterations).
  fn optimize(): int64 {
    if (self.optLevel == 0) { return 0; }  // -O0: skip all optimizations

    var maxPass: int64 := 10;
    if (self.optLevel >= 3) { maxPass := 20; }  // -O3: allow more convergence rounds

    // Iterate per function to avoid cross-function register aliasing.
    var funcBuf: int64 := self.ir.funcBuffer;
    var funcLen: int64 := self.ir.funcLen;
    var fi: int64 := 0;
    while (fi < funcLen) {
      var fBase: int64 := funcBuf + fi * IR_FUNC_SIZE;
      self.fnStart := peek64(fBase + IR_FUNC_OFF_INSTRSOFF);
      self.fnEnd   := self.fnStart + peek64(fBase + IR_FUNC_OFF_INSTRCOUNT);

      var pass: int64 := 0;
      while (pass < maxPass) {
        self.passCount := pass;
        self.changed := 0;

        if (self.optLevel >= 2) {
          // O2+: full propagation and simplification
          self.constantFolding();
          self.copyPropagation();
          self.strengthReduction();
        }

        // O1+: remove dead code (always)
        self.deadCodeElimination();
        self.eliminateUnreachableBlocks();

        if (self.optLevel >= 2) {
          self.commonSubexprElimination();
        }

        // Check for convergence
        if (self.changed == 0) { break; }

        pass += 1;
      }

      fi += 1;
    }

    return self.passCount;
  }
  
  // ------------------------------------------------------------------
  // Constant Folding
  // ------------------------------------------------------------------
  // Fold constant expressions: irConstInt(3) irAdd irConstInt(4) → irConstInt(7)
  
  fn constantFolding(): int64 {
    var i: int64 := self.fnStart;

    while (i < self.fnEnd) {
      var op: int64 := self.getInstrOp(i);
      var dest: int64 := self.getInstrDest(i);
      var src1: int64 := self.getInstrSrc1(i);
      var src2: int64 := self.getInstrSrc2(i);
      
      // Binary operations with two constant sources
      if (op == IRO_ADD || op == IRO_SUB || op == IRO_MUL) {
        var c1: int64 := self.getConstValue(src1);
        var c2: int64 := self.getConstValue(src2);
        if (self.isConstInt(src1) && self.isConstInt(src2)) {
          var result: int64 := 0;
          if (op == IRO_ADD) { result := c1 + c2; }
          if (op == IRO_SUB) { result := c1 - c2; }
          if (op == IRO_MUL) { result := c1 * c2; }
          // Replace with constant
          self.setInstrOp(i, IRO_CONST_INT);
          self.setInstrImmInt(i, result);
          self.setInstrSrc1(i, -1);
          self.setInstrSrc2(i, -1);
          self.changed += 1;
        }
      }
      
      // Division with constants
      if (op == IRO_DIV || op == IRO_MOD) {
        var c1: int64 := self.getConstValue(src1);
        var c2: int64 := self.getConstValue(src2);
        if (self.isConstInt(src1) && self.isConstInt(src2) && c2 != 0) {
          var result: int64 := 0;
          if (op == IRO_DIV) { result := c1 / c2; }
          if (op == IRO_MOD) { result := c1 % c2; }
          self.setInstrOp(i, IRO_CONST_INT);
          self.setInstrImmInt(i, result);
          self.setInstrSrc1(i, -1);
          self.setInstrSrc2(i, -1);
          self.changed += 1;
        }
      }
      
      // Comparisons with constants
      if (op == IRO_CMP_EQ || op == IRO_CMP_NEQ || op == IRO_CMP_LT ||
          op == IRO_CMP_LE || op == IRO_CMP_GT || op == IRO_CMP_GE) {
        var c1: int64 := self.getConstValue(src1);
        var c2: int64 := self.getConstValue(src2);
        if (self.isConstInt(src1) && self.isConstInt(src2)) {
          var result: int64 := 0;
          if (op == IRO_CMP_EQ) { if (c1 == c2) { result := 1; } else { result := 0; } }
          if (op == IRO_CMP_NEQ) { if (c1 != c2) { result := 1; } else { result := 0; } }
          if (op == IRO_CMP_LT) { if (c1 < c2) { result := 1; } else { result := 0; } }
          if (op == IRO_CMP_LE) { if (c1 <= c2) { result := 1; } else { result := 0; } }
          if (op == IRO_CMP_GT) { if (c1 > c2) { result := 1; } else { result := 0; } }
          if (op == IRO_CMP_GE) { if (c1 >= c2) { result := 1; } else { result := 0; } }
          self.setInstrOp(i, IRO_CONST_INT);
          self.setInstrImmInt(i, result);
          self.setInstrSrc1(i, -1);
          self.setInstrSrc2(i, -1);
          self.changed += 1;
        }
      }
      
      // Float operations with constants
      if (op == IRO_FADD || op == IRO_FSUB || op == IRO_FMUL || op == IRO_FDIV) {
        var f1: int64 := self.getConstFloatValue(src1);
        var f2: int64 := self.getConstFloatValue(src2);
        if (f1 != 0 && f2 != 0) {
          // Float folding would require actual float arithmetic
          // For now, mark as potentially foldable
        }
      }
      
      // Unary operations with constants
      if (op == IRO_NEG) {
        if (self.isConstInt(src1)) {
          var c1: int64 := self.getConstValue(src1);
          self.setInstrOp(i, IRO_CONST_INT);
          self.setInstrImmInt(i, 0 - c1);
          self.setInstrSrc1(i, -1);
          self.changed += 1;
        }
      }

      if (op == IRO_NOT) {
        var c1: int64 := self.getConstValue(src1);
        if (self.isConstInt(src1)) {
          self.setInstrOp(i, IRO_CONST_INT);
          if (c1 == 0) { self.setInstrImmInt(i, 1); } else { self.setInstrImmInt(i, 0); }
          self.setInstrSrc1(i, -1);
          self.changed += 1;
        }
      }
      
      // Bitwise operations with constants
      if (op == IRO_AND || op == IRO_OR || op == IRO_XOR) {
        var c1: int64 := self.getConstValue(src1);
        var c2: int64 := self.getConstValue(src2);
        if (self.isConstInt(src1) && self.isConstInt(src2)) {
          var result: int64 := 0;
          if (op == IRO_AND)  { result := c1 & c2; }
          if (op == IRO_OR)   { result := c1 | c2; }
          if (op == IRO_XOR)  { result := c1 ^ c2; }
          self.setInstrOp(i, IRO_CONST_INT);
          self.setInstrImmInt(i, result);
          self.setInstrSrc1(i, -1);
          self.setInstrSrc2(i, -1);
          self.changed += 1;
        }
      }
      
      // Shift operations with constants
      if (op == IRO_SHL || op == IRO_SHR) {
        var c1: int64 := self.getConstValue(src1);
        var c2: int64 := self.getConstValue(src2);
        if (self.isConstInt(src1) && self.isConstInt(src2) && c2 >= 0 && c2 < 64) {
          var result: int64 := 0;
          if (op == IRO_SHL) { result := c1 << c2; }
          if (op == IRO_SHR) { result := c1 >> c2; }
          self.setInstrOp(i, IRO_CONST_INT);
          self.setInstrImmInt(i, result);
          self.setInstrSrc1(i, -1);
          self.setInstrSrc2(i, -1);
          self.changed += 1;
        }
      }
      
      i += 1;
    }
    
    return self.changed;
  }
  
  // Get constant value from a source operand
  fn isConstInt(src: int64): bool {
    if (src < 0) { return false; }
    var i: int64 := self.fnStart;
    while (i < self.fnEnd) {
      if (self.getInstrDest(i) == src) {
        if (self.getInstrOp(i) == IRO_CONST_INT) { return true; }
      }
      i += 1;
    }
    return false;
  }

  fn getConstValue(src: int64): int64 {
    if (src < 0) { return -1; }
    var i: int64 := self.fnStart;
    while (i < self.fnEnd) {
      if (self.getInstrDest(i) == src) {
        var op: int64 := self.getInstrOp(i);
        if (op == IRO_CONST_INT) {
          return self.getInstrImmInt(i);
        }
      }
      i += 1;
    }
    return -1;
  }

  // fix/lyxos-strength-reduction-shift: Wert des CONST_INT-Temps, das `src` definiert,
  // auf `val` ändern. Genutzt von strengthReduction: MUL/DIV-by-pow2 → SHL/SHR, wobei
  // der Shift-Count (=power) NICHT als roher Integer in src2 gehört (Backends lesen src2
  // als Temp-/Slot-Referenz → cl aus falschem Slot), sondern als Wert im bereits von src2
  // referenzierten CONST_INT-Temp (so wie ein expliziter `x << 2` aussieht).
  fn setConstDefValue(src: int64, val: int64): void {
    if (src < 0) { return; }
    var i: int64 := self.fnStart;
    while (i < self.fnEnd) {
      if (self.getInstrDest(i) == src) {
        if (self.getInstrOp(i) == IRO_CONST_INT) {
          self.setInstrImmInt(i, val);
          return;
        }
      }
      i += 1;
    }
  }

  // Get constant float value
  fn getConstFloatValue(src: int64): int64 {
    if (src < 0) { return 0; }
    var i: int64 := self.fnStart;
    while (i < self.fnEnd) {
      if (self.getInstrDest(i) == src) {
        var op: int64 := self.getInstrOp(i);
        if (op == IRO_CONST_FLOAT) {
          return self.getInstrImmFloat(i);
        }
      }
      i += 1;
    }
    return 0;
  }
  
  // ------------------------------------------------------------------
  // Copy Propagation
  // ------------------------------------------------------------------
  // t1 = a; t2 = t1 + b → t2 = a + b
  
  fn copyPropagation(): int64 {
    var i: int64 := self.fnStart;

    while (i < self.fnEnd) {
      var op: int64 := self.getInstrOp(i);
      var dest: int64 := self.getInstrDest(i);
      var src1: int64 := self.getInstrSrc1(i);
      var src2: int64 := self.getInstrSrc2(i);

      // Replace src1 if it's a copy from another instruction
      if (src1 >= 0) {
        var src1Orig: int64 := self.traceCopy(src1);
        if (src1Orig != src1) {
          self.setInstrSrc1(i, src1Orig);
          self.changed += 1;
        }
      }

      // Replace src2 if it's a copy
      if (src2 >= 0) {
        var src2Orig: int64 := self.traceCopy(src2);
        if (src2Orig != src2) {
          self.setInstrSrc2(i, src2Orig);
          self.changed += 1;
        }
      }

      i += 1;
    }

    return self.changed;
  }

  // Trace copy chain to find original value
  fn traceCopy(temp: int64): int64 {
    var i: int64 := self.fnStart;
    var current: int64 := temp;

    while (i < self.fnEnd) {
      if (self.getInstrDest(i) == current) {
        var op: int64 := self.getInstrOp(i);
        var src1: int64 := self.getInstrSrc1(i);
        // IRO_MOVE is a direct copy: dest = src1
        if (op == IRO_MOVE) {
          current := src1;
          i := self.fnStart;  // restart from beginning with new current
          continue;
        }
      }
      i += 1;
    }

    return current;
  }
  
  // ------------------------------------------------------------------
  // Dead Code Elimination
  // ------------------------------------------------------------------
  // Remove unreachable code after irJmp/irFuncExit
  // Remove instructions whose dest is never used
  
  fn deadCodeElimination(): int64 {
    var instrCount: int64 := self.getInstrCount();

    // First pass: find all used destinations (within this function only)
    var usedDests: int64 := alloc(instrCount * 8);
    var usedCount: int64 := 0;

    var i: int64 := self.fnStart;
    while (i < self.fnEnd) {
      var src1: int64 := self.getInstrSrc1(i);
      var src2: int64 := self.getInstrSrc2(i);
      var src3: int64 := self.getInstrSrc3(i);

      if (src1 >= 0) {
        poke64(usedDests + (usedCount * 8), src1);
        usedCount += 1;
      }
      if (src2 >= 0) {
        poke64(usedDests + (usedCount * 8), src2);
        usedCount += 1;
      }
      if (src3 >= 0) {
        poke64(usedDests + (usedCount * 8), src3);
        usedCount += 1;
      }

      i += 1;
    }

    // Second pass: remove dead instructions
    var liveStart: int64 := -1;
    i := self.fnStart;
    while (i < self.fnEnd) {
      var op: int64 := self.getInstrOp(i);
      var dest: int64 := self.getInstrDest(i);

      // Check if destination is used
      var isUsed: int64 := 0;
      var j: int64 := 0;
      while (j < usedCount) {
        if (peek64(usedDests + j * 8) == dest) {
          isUsed := 1;
          j := usedCount;  // break
        }
        j += 1;
      }

      // Control flow instructions terminate basic blocks
      if (op == IRO_JMP || op == IRO_BR_TRUE || op == IRO_BR_FALSE ||
          op == IRO_FUNC_EXIT || op == IRO_RETURN_STRUCT) {
        liveStart := i + 1;
      }

      // If dest is not used and instruction is not a side-effect, remove it.
      // dest==0 is the lyxos return register (loaded by the final LOAD_LOCAL before epilogue)
      // and must never be eliminated even if it appears unused within the function.
      if (isUsed == 0 && dest > 0) {
        // Check for side effects (memory, function call, etc.)
        var hasSideEffect: int64 := self.hasSideEffect(op);
        // WP-VOLATILE: @volatile-LOAD_LOCAL (callmode-Sentinel 0x564F4C44) NICHT entfernen —
        // MMIO/Hardware-Register-Reads müssen erhalten bleiben, auch wenn Resultat ungenutzt.
        var isVol: int64 := 0;
        if (op == IRO_LOAD_LOCAL) { if (self.getInstrCallMode(i) == 1448232516) { isVol := 1; } }
        if (hasSideEffect == 0 && isVol == 0) {
          // Mark instruction as dead (set op to NOP or remove)
          self.setInstrOp(i, 0);  // NOP
          self.changed += 1;
        }
      }

      i += 1;
    }

    return self.changed;
  }
  
  // Check if instruction has side effects
  fn hasSideEffect(op: int64): int64 {
    // Memory operations have side effects
    if (op == IRO_STORE_LOCAL || op == IRO_STORE_GLOBAL ||
        op == IRO_STORE_FIELD || op == IRO_STORE_FIELD_HEAP ||
        op == IRO_STORE_ELEM || op == IRO_STORE_ELEM_DYN ||
        op == IRO_STORE_IDX ||
        op == IRO_SIMD_STORE_ELEM) {
      return 1;
    }
    
    // Function calls have side effects
    if (op == IRO_CALL || op == IRO_CALL_BUILTIN || op == IRO_CALL_STRUCT ||
        op == IRO_VAR_CALL) {
      return 1;
    }

    // WSP-05: inline-asm immer Seiteneffekt (Kernel-Instruktion) → nie DCE-entfernen.
    if (op == IRO_ASM) { return 1; }

    // Exception handling and assertions (all abort execution on failure)
    if (op == IRO_THROW || op == IRO_PANIC) {
      return 1;
    }
    if (op == IRO_ASSERT_BOUNDS || op == IRO_ASSERT_NOT_NULL ||
        op == IRO_ASSERT_NOT_ZERO || op == IRO_ASSERT_TRUE) {
      return 1;
    }

    // Memory allocation/free
    if (op == IRO_ALLOC || op == IRO_FREE || op == IRO_POOL_ALLOC || op == IRO_POOL_FREE) {
      return 1;
    }

    return 0;
  }
  
  // ------------------------------------------------------------------
  // Common Subexpression Elimination (CSE)
  // ------------------------------------------------------------------
  // Gleiche Berechnung in selber Expression → gemeinsames Temp-Register
  
  fn commonSubexprElimination(): int64 {
    var i: int64 := self.fnStart;

    while (i < self.fnEnd) {
      var op: int64 := self.getInstrOp(i);
      var dest: int64 := self.getInstrDest(i);
      var src1: int64 := self.getInstrSrc1(i);
      var src2: int64 := self.getInstrSrc2(i);

      // Only check binary operations
      if (op == IRO_ADD || op == IRO_SUB || op == IRO_MUL || op == IRO_DIV ||
          op == IRO_CMP_EQ || op == IRO_CMP_NEQ || op == IRO_CMP_LT ||
          op == IRO_AND || op == IRO_OR || op == IRO_XOR) {

        // Look for same operation with same operands within the same basic block.
        // Stop at any instruction with side effects to avoid incorrect substitution
        // across intervening stores (no alias analysis available).
        var j: int64 := i + 1;
        while (j < self.fnEnd) {
          var jop: int64 := self.getInstrOp(j);
          if (self.hasSideEffect(jop) != 0 ||
              jop == IRO_JMP || jop == IRO_BR_TRUE || jop == IRO_BR_FALSE ||
              jop == IRO_FUNC_EXIT || jop == IRO_LABEL) {
            j := self.fnEnd;  // break — don't look across side effects or block boundaries
          } else {
            if (jop == op &&
                self.getInstrSrc1(j) == src1 &&
                self.getInstrSrc2(j) == src2) {
              var replaceDest: int64 := self.getInstrDest(j);
              self.replaceUses(dest, replaceDest);
              self.changed += 1;
            }
            j += 1;
          }
        }
      }

      i += 1;
    }

    return self.changed;
  }
  
  // Replace all uses of oldTemp with newTemp
  fn replaceUses(oldTemp: int64, newTemp: int64): int64 {
    var i: int64 := self.fnStart;

    while (i < self.fnEnd) {
      if (self.getInstrSrc1(i) == oldTemp) {
        self.setInstrSrc1(i, newTemp);
      }
      if (self.getInstrSrc2(i) == oldTemp) {
        self.setInstrSrc2(i, newTemp);
      }
      if (self.getInstrSrc3(i) == oldTemp) {
        self.setInstrSrc3(i, newTemp);
      }
      i += 1;
    }

    return 0;
  }
  
  // ------------------------------------------------------------------
  // Strength Reduction
  // ------------------------------------------------------------------
  // x * 2 → x << 1, x * 0 → 0, x + 0 → x, etc.
  
  fn strengthReduction(): int64 {
    var i: int64 := self.fnStart;

    while (i < self.fnEnd) {
      var op: int64 := self.getInstrOp(i);
      var dest: int64 := self.getInstrDest(i);
      var src1: int64 := self.getInstrSrc1(i);
      var src2: int64 := self.getInstrSrc2(i);
      
      // Multiplication by power of 2 → shift
      if (op == IRO_MUL) {
        if (self.isConstInt(src2)) {
          var c2: int64 := self.getConstValue(src2);
          // Check if power of 2
          var power: int64 := self.isPowerOfTwo(c2);
          if (power >= 0) {
            self.setInstrOp(i, IRO_SHL);
            self.setConstDefValue(src2, power);
            self.changed += 1;
          }
          // Multiplication by 0 → 0
          if (c2 == 0) {
            self.setInstrOp(i, IRO_CONST_INT);
            self.setInstrImmInt(i, 0);
            self.setInstrSrc1(i, -1);
            self.setInstrSrc2(i, -1);
            self.changed += 1;
          }
        }
      }

      // #1784: `x + 0` ist eine Kopie — und die heisst in dieser IR
      // IRO_LOAD_LOCAL(dest, src1), nicht „IRO_ADD mit src2 = -1".
      //
      // Genau das stand hier: die Umformung liess den ADD stehen und setzte
      // src2 auf -1, in der Annahme, ein Backend werde das als „nichts
      // addieren" lesen. Keines tut das. Sie rechnen slotOff(-1) aus, also
      // [fp + 0], und addieren, was dort zufaellig liegt. Auf lyxos war das
      // eine Null — `peek64(p + 0)` lieferte still 0 statt des Werts; auf
      // riscv und arm64 ist es ein Segfault.
      //
      // Aufgefallen ist es an einer Struktur, deren ERSTES Feld gelesen
      // wurde: Versatz 0 ist der haeufigste Fall ueberhaupt.
      if (op == IRO_ADD) {
        if (self.isConstInt(src2)) {
          var c2: int64 := self.getConstValue(src2);
          if (c2 == 0) {
            self.setInstrOp(i, IRO_LOAD_LOCAL);
            self.setInstrSrc2(i, -1);
            self.changed += 1;
          }
        }
      }

      // #1784: `x - 0` ebenso — Kopie statt ADD mit src2 = -1.
      if (op == IRO_SUB) {
        if (self.isConstInt(src2)) {
          var c2: int64 := self.getConstValue(src2);
          if (c2 == 0) {
            self.setInstrOp(i, IRO_LOAD_LOCAL);
            self.setInstrSrc2(i, -1);
            self.changed += 1;
          }
        }
      }

      // Division by power of 2 → shift right: ENTFERNT, weil für vorzeichen-
      // behaftete Division schlicht falsch. Rechtsschieben rundet ab, Division
      // trunkiert Richtung Null — bei negativem Dividenden mit Rest divergiert
      // das: -21 / 4 ist -5, -21 >> 2 aber -6. Nur exakt teilbare Werte kamen
      // zufällig richtig heraus (-20 / 4 == -20 >> 2 == -5), weshalb es lange
      // unauffällig blieb. Die IR unterscheidet hier kein signed/unsigned, es
      // gibt also keine Bedingung, unter der die Umformung sicher wäre; eine
      // Nichtnegativitäts-Analyse existiert nicht.
      //
      // Der 2^0-Fall (`x / 1`) war zusätzlich kaputt: er lieferte auf dem
      // IR-Pfad konstant 1 statt x.
      //
      // MUL → SHL oben bleibt: im Zweierkomplement ist die Umformung für
      // beide Vorzeichen exakt.
      
      // #1784: `x & -1` ist eine Kopie (alle Bits gesetzt) — dieselbe
      // Verwechslung wie bei ADD und SUB oben.
      if (op == IRO_AND) {
        if (self.isConstInt(src2)) {
          var c2: int64 := self.getConstValue(src2);
          if (c2 == -1) {  // alle Bits gesetzt
            self.setInstrOp(i, IRO_LOAD_LOCAL);
            self.setInstrSrc2(i, -1);
            self.changed += 1;
          }
        }
      }

      // #1784: `x | 0` ist eine Kopie.
      if (op == IRO_OR) {
        if (self.isConstInt(src2)) {
          var c2: int64 := self.getConstValue(src2);
          if (c2 == 0) {
            self.setInstrOp(i, IRO_LOAD_LOCAL);
            self.setInstrSrc2(i, -1);
            self.changed += 1;
          }
        }
      }
      
      i += 1;
    }
    
    return self.changed;
  }
  
  // Check if n is power of 2, return log2(n) or -1
  fn isPowerOfTwo(n: int64): int64 {
    if (n <= 0) { return -1; }
    if ((n & (n - 1)) != 0) { return -1; }
    
    // Count trailing zeros = log2(n)
    var log: int64 := 0;
    var temp: int64 := n;
    while (temp > 1) {
      temp := temp >> 1;
      log += 1;
    }
    return log;
  }
  
  // ------------------------------------------------------------------
  // IR Module Helper Functions (delegates to ir.lyx)
  // ------------------------------------------------------------------

  fn getInstrCount(): int64 {
    return self.fnEnd - self.fnStart;
  }

  fn getInstrOp(idx: int64): int64 {
    return self.ir.getInstrOp(idx);
  }

  fn setInstrOp(idx: int64, op: int64) {
    var off: int64 := idx * IR_INSTR_SIZE;
    poke64(self.ir.instrBuffer + off, op);
  }

  fn getInstrDest(idx: int64): int64 {
    return self.ir.getInstrDest(idx);
  }

  fn setInstrDest(idx: int64, dest: int64) {
    var off: int64 := idx * IR_INSTR_SIZE + 8;
    poke64(self.ir.instrBuffer + off, dest);
  }

  fn getInstrSrc1(idx: int64): int64 {
    return self.ir.getInstrSrc1(idx);
  }

  fn setInstrSrc1(idx: int64, src: int64) {
    var off: int64 := idx * IR_INSTR_SIZE + 16;
    poke64(self.ir.instrBuffer + off, src);
  }

  fn getInstrSrc2(idx: int64): int64 {
    return self.ir.getInstrSrc2(idx);
  }

  fn setInstrSrc2(idx: int64, src: int64) {
    var off: int64 := idx * IR_INSTR_SIZE + 24;
    poke64(self.ir.instrBuffer + off, src);
  }

  fn getInstrSrc3(idx: int64): int64 {
    return self.ir.getInstrSrc3(idx);
  }

  fn setInstrSrc3(idx: int64, src: int64) {
    var off: int64 := idx * IR_INSTR_SIZE + 32;
    poke64(self.ir.instrBuffer + off, src);
  }

  fn getInstrImmInt(idx: int64): int64 {
    return self.ir.getInstrImmInt(idx);
  }

  // WP-VOLATILE: callmode-Feld (Offset 72) roh lesen — Sentinel markiert volatile LOAD_LOCAL.
  fn getInstrCallMode(idx: int64): int64 {
    return peek64(self.ir.instrBuffer + idx * IR_INSTR_SIZE + 72);
  }

  fn setInstrImmInt(idx: int64, val: int64) {
    self.ir.setInstrImmInt(idx, val);
  }

  fn getInstrImmFloat(idx: int64): int64 {
