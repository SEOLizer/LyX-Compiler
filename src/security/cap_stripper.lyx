// ===========================================================================
// WP-L6: Compile-Time Stripping (Dead-Module-Eliminierung)
// ===========================================================================
// Entscheidet welche importierten Module vom Compiler ausgeschlossen werden.
//
// Pruning-Kriterium:
//   Modul M wird entfernt wenn:
//     benötigte_caps(M) ≠ ∅  UND  benötigte_caps(M) ∩ C(root) = ∅
//
// "@uses_caller_cap"-Annotationen werden wie eigene Capabilities behandelt:
//   Modul mit nur @uses_caller_cap([X]) wird gepruned wenn X ∉ C(root).
//
// Module ohne Capability-Deklarationen (reine Utility-Module) werden
// NIE gepruned (benötigte_caps = ∅).

import src.std.alloc;

// ============================================================================
// Konstanten
// ============================================================================

pub con STRIP_MAX:       int64 := 128;  // max. geprunte Module
con STRIP_ENTRY:         int64 := 16;   // namePtr:8 + nameLen:8
con STRIP_CAP_ENTRY:     int64 := 16;   // capId:8 + paramFp:8 (CapSet-Layout)

// ============================================================================
// Top-Level: Pruning-Entscheidung (keine Klassen, kein VMT)
// ============================================================================

// Gibt true zurück wenn Modul M gepruned werden soll.
// importedEntries / importedCount: M's Capability-Buffer (flat CapSet-Format)
// rootEntries / rootCount:         C(root) Buffer
pub fn cap_shouldStrip(importedEntries: int64, importedCount: int64,
                        rootEntries:    int64, rootCount:     int64): bool {
  if importedCount == 0 { return false; }  // kein Cap-Bedarf → immer behalten
  var i: int64 := 0;
  while i < importedCount {
    var capId: int64 := peek64(importedEntries + i * STRIP_CAP_ENTRY);
    var j: int64 := 0;
    while j < rootCount {
      if peek64(rootEntries + j * STRIP_CAP_ENTRY) == capId { return false; }
      j := j + 1;
    }
    i := i + 1;
  }
  return true;
}

// ============================================================================
// CapStripper — Liste geprunter Module + Pruning-Report
// ============================================================================

pub type CapStripper = class {
  // Flat Buffer: (namePtr:8, nameLen:8) Paare — namePtrs sind alloc'd Kopien
  buf:   int64;
  count: int64;

  pub fn Init(): void {
    self.buf   := alloc(STRIP_MAX * STRIP_ENTRY);
    self.count := 0;
  }

  // Fügt Modul zur Pruning-Liste hinzu.
  // name muss null-terminiert sein (caller muss eine Kopie erzeugen).
  pub fn AddStripped(name: pchar, nameLen: int64): void {
    if self.count >= STRIP_MAX { return; }
    poke64(self.buf + self.count * STRIP_ENTRY,     name as int64);
    poke64(self.buf + self.count * STRIP_ENTRY + 8, nameLen);
    self.count := self.count + 1;
  }

  // True wenn das Modul gepruned wurde.
  pub fn IsStripped(name: pchar, nameLen: int64): bool {
    var i: int64 := 0;
    while i < self.count {
      var sPtr: pchar := peek64(self.buf + i * STRIP_ENTRY) as pchar;
      var sLen: int64 := peek64(self.buf + i * STRIP_ENTRY + 8);
      if sLen == nameLen {
        var k: int64 := 0;
        var eq: bool := true;
        while k < nameLen {
          if StrCharAt(sPtr, k) != StrCharAt(name, k) { eq := false; break; }
          k := k + 1;
        }
        if eq { return true; }
      }
      i := i + 1;
    }
    return false;
  }

  pub fn StrippedCount(): int64 { return self.count; }

  // Druckt Pruning-Report (kein Output wenn nichts gepruned)
  pub fn PrintReport(): void {
    if self.count == 0 { return; }
    PrintStr("=== LCBS Strip Report ==========================================\n"c);
    PrintStr("Entfernte Module (benoetigte_caps (intersection) C(root) = leer):\n"c);
    var i: int64 := 0;
    while i < self.count {
      // namePtr ist null-terminiert (vom Caller per alloc+memcpy erzeugt)
      var namePtr: pchar := peek64(self.buf + i * STRIP_ENTRY) as pchar;
      PrintStr("  - "c);
      PrintStr(namePtr);
      PrintStr("\n"c);
      i := i + 1;
    }
    PrintStr("Gesamt: "c); PrintInt(self.count); PrintStr(" Module entfernt.\n"c);
    PrintStr("================================================================\n"c);
  }
};
