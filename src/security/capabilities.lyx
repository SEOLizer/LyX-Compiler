// ===========================================================================
// WP-L2: LCBS Capability-Registry
// ===========================================================================
// Definiert alle bekannten Capabilities (implizit und explizit),
// ihre zugehörigen Syscall-Listen sowie Parameter-Validierungsregeln.
//
// Implizite Capabilities (always active, nicht widerrufbar):
//   system.exit, system.memory.heap, system.memory.stack
//
// Explizite Capabilities (25 Stück, aus Abschnitt 4.2 der Spezifikation):
//   system.time, system.env, system.rand, system.unsafe.format_string,
//   fs.read, fs.write, fs.create, fs.delete, fs.meta, fs.perm, fs.exec,
//   memory.mmap, memory.lock,
//   network.tcp.bind, network.tcp.connect, network.udp.bind, network.udp.connect,
//   network.unix, network.raw,
//   hardware.gpio, hardware.i2c, hardware.spi, hardware.usb, hardware.block,
//   process.fork, process.exec, process.signal, process.sched, process.exit,
//   ki.embed, ki.graph, audio.mic   (#1826: nur fuer das lyxos-Manifest,
//     auf Linux ohne Syscall-Wirkung)

// ============================================================================
// Capability-ID-Konstanten
// ============================================================================

// Implizite Capabilities (immer aktiv)
pub con CAP_SYSTEM_EXIT:          int64 := 0;
pub con CAP_SYSTEM_MEMORY_HEAP:   int64 := 1;
pub con CAP_SYSTEM_MEMORY_STACK:  int64 := 2;

// System
pub con CAP_SYSTEM_TIME:          int64 := 3;
pub con CAP_SYSTEM_ENV:           int64 := 4;
pub con CAP_SYSTEM_RAND:          int64 := 5;
pub con CAP_SYSTEM_UNSAFE_FORMAT: int64 := 6;

// Dateisystem
pub con CAP_FS_READ:              int64 := 7;
pub con CAP_FS_WRITE:             int64 := 8;
pub con CAP_FS_CREATE:            int64 := 9;
pub con CAP_FS_DELETE:            int64 := 10;
pub con CAP_FS_META:              int64 := 11;
pub con CAP_FS_EXEC:              int64 := 12;

// Memory
pub con CAP_MEMORY_MMAP:          int64 := 13;
pub con CAP_MEMORY_LOCK:          int64 := 14;

// Netzwerk
pub con CAP_NETWORK_TCP_BIND:     int64 := 15;
pub con CAP_NETWORK_TCP_CONNECT:  int64 := 16;
pub con CAP_NETWORK_UDP_BIND:     int64 := 17;
pub con CAP_NETWORK_UDP_CONNECT:  int64 := 18;
pub con CAP_NETWORK_UNIX:         int64 := 19;
pub con CAP_NETWORK_RAW:          int64 := 20;

// Hardware
pub con CAP_HARDWARE_GPIO:        int64 := 21;
pub con CAP_HARDWARE_I2C:         int64 := 22;
pub con CAP_HARDWARE_SPI:         int64 := 23;
pub con CAP_HARDWARE_USB:         int64 := 24;

// Prozess
pub con CAP_PROCESS_FORK:         int64 := 25;
pub con CAP_PROCESS_EXEC:         int64 := 26;
pub con CAP_PROCESS_SIGNAL:       int64 := 27;
pub con CAP_PROCESS_SCHED:        int64 := 28;
pub con CAP_PROCESS_EXIT:         int64 := 29;

// #1188: Metadaten SCHREIBEN. `fs.meta` deckt laut capabilities.md das LESEN
// ab (stat, Verzeichnislisting); chmod/chown aendern Rechte und Eigentuemer.
// Sie dort anzuhaengen waere eine stille Ausweitung fuer jeden, der fs.meta
// nur zum Auflisten anfordert — deshalb eine eigene Capability.
pub con CAP_FS_PERM:              int64 := 30;

// #1755: Rohzugriff auf Blockgeraete. Der Kernel von Lyx OS fuehrt dafuer eine
// eigene Klasse (PLEDGE_BLOCK, Syscalls 98-102), fuer die es bisher keine
// Schreibweise gab — dd, diskinfo, partinfo, partition und ramdisk konnten das
// Recht nicht anfordern.
pub con CAP_HARDWARE_BLOCK:       int64 := 31;

pub con CAP_UNKNOWN: int64 := -1;
// #1797: persistente Konfiguration SCHREIBEN. `fs.write` reicht dafuer nicht —
// das hat praktisch jedes Programm, das eine Datei anlegt, und wenn dasselbe
// Recht auch die Netz- oder Systemkonfiguration umschreiben darf, ist die
// Pruefung wirkungslos. Lesen bleibt frei.
pub con CAP_SYSTEM_CONFIG:        int64 := 32;

// #1826: Die Warnmeldung des lyxos-Ziels nennt ki.embed, ki.graph und audio
// als abgebildet — die CAPS-Bits gibt es auch (16, 32, 512, siehe
// _capBitsFromPath in lyxc.lyx). Nur die NAMEN fehlten hier, weshalb
// `@capabilities([ki.embed])` mit "unbekannte Capability" abwies. Dieselbe
// Klasse wie #1797: das Bit war da, das Wort nicht.
//
// Auf Linux erteilen diese drei kein Syscall-Recht — es gibt dort nichts,
// worauf sie sich beziehen. Sie sind Deklarationen fuer das lyxos-Manifest;
// der Seccomp-Filter bleibt davon unberuehrt.
pub con CAP_KI_EMBED:             int64 := 33;
pub con CAP_KI_GRAPH:             int64 := 34;
// Nur MIC, nicht "audio" allgemein: das einzige vorhandene Bit ist
// LBF_CAP_AUDIO_MIC. Ein Name `audio.play`, der auf dasselbe Bit abbildet,
// wuerde beim Anmelden der Wiedergabe stillschweigend das Mikrofon miterlauben
// — genau die Verwechslung, die #1797 bei `audio` gegen system.config schon
// einmal beinahe erzeugt haette.
pub con CAP_AUDIO_MIC:            int64 := 35;

pub con CAP_COUNT:   int64 := 36;  // Gesamtanzahl

// WP-L7: Lesbare Capability-Namen für Fehlermeldungen
pub fn cap_nameOf(capId: int64): pchar {
  if capId == CAP_SYSTEM_EXIT          { return "system.exit"c; }
  if capId == CAP_SYSTEM_MEMORY_HEAP   { return "system.memory.heap"c; }
  if capId == CAP_SYSTEM_MEMORY_STACK  { return "system.memory.stack"c; }
  if capId == CAP_SYSTEM_TIME          { return "system.time"c; }
  if capId == CAP_SYSTEM_ENV           { return "system.env"c; }
  if capId == CAP_SYSTEM_RAND          { return "system.rand"c; }
  if capId == CAP_SYSTEM_UNSAFE_FORMAT { return "system.unsafe.format_string"c; }
  if capId == CAP_SYSTEM_CONFIG        { return "system.config"c; }
  if capId == CAP_FS_READ              { return "fs.read"c; }
  if capId == CAP_FS_WRITE             { return "fs.write"c; }
  if capId == CAP_FS_CREATE            { return "fs.create"c; }
  if capId == CAP_FS_DELETE            { return "fs.delete"c; }
  if capId == CAP_FS_META              { return "fs.meta"c; }
  if capId == CAP_FS_PERM              { return "fs.perm"c; }
  if capId == CAP_FS_EXEC              { return "fs.exec"c; }
  if capId == CAP_MEMORY_MMAP          { return "memory.mmap"c; }
  if capId == CAP_MEMORY_LOCK          { return "memory.lock"c; }
  if capId == CAP_NETWORK_TCP_BIND     { return "network.tcp.bind"c; }
  if capId == CAP_NETWORK_TCP_CONNECT  { return "network.tcp.connect"c; }
  if capId == CAP_NETWORK_UDP_BIND     { return "network.udp.bind"c; }
  if capId == CAP_NETWORK_UDP_CONNECT  { return "network.udp.connect"c; }
  if capId == CAP_NETWORK_UNIX         { return "network.unix"c; }
  if capId == CAP_NETWORK_RAW          { return "network.raw"c; }
  if capId == CAP_HARDWARE_GPIO        { return "hardware.gpio"c; }
  if capId == CAP_HARDWARE_I2C         { return "hardware.i2c"c; }
  if capId == CAP_HARDWARE_SPI         { return "hardware.spi"c; }
  if capId == CAP_HARDWARE_USB         { return "hardware.usb"c; }
  if capId == CAP_HARDWARE_BLOCK       { return "hardware.block"c; }
  if capId == CAP_KI_EMBED             { return "ki.embed"c; }        // #1826
  if capId == CAP_KI_GRAPH             { return "ki.graph"c; }        // #1826
  if capId == CAP_AUDIO_MIC            { return "audio.mic"c; }       // #1826
  if capId == CAP_PROCESS_FORK         { return "process.fork"c; }
  if capId == CAP_PROCESS_EXEC         { return "process.exec"c; }
  if capId == CAP_PROCESS_SIGNAL       { return "process.signal"c; }
  if capId == CAP_PROCESS_SCHED        { return "process.sched"c; }
  if capId == CAP_PROCESS_EXIT         { return "process.exit"c; }
  return "unknown"c;
}

// ============================================================================
// SyscallList — Rückgabetyp für Resolve(); bis zu 5 Syscall-Namen
// ============================================================================

pub type SyscallList = class {
  count: int64;
  s0:    pchar;
  s1:    pchar;
  s2:    pchar;
  s3:    pchar;
  s4:    pchar;

  pub fn Init(): void {
    self.count := 0;
    self.s0 := 0 as pchar;
    self.s1 := 0 as pchar;
    self.s2 := 0 as pchar;
    self.s3 := 0 as pchar;
    self.s4 := 0 as pchar;
  }

  pub fn Get(i: int64): pchar {
    if i == 0 { return self.s0; }
    if i == 1 { return self.s1; }
    if i == 2 { return self.s2; }
    if i == 3 { return self.s3; }
    if i == 4 { return self.s4; }
    return 0 as pchar;
  }
};

// ============================================================================
// CapabilityRegistry
// ============================================================================

pub type CapabilityRegistry = class {

  pub fn Init(): void {}

  // Vergleicht null-terminiertes Literal mit längengebundenem Quell-String
  fn _pathEqN(lit: pchar, src: pchar, srcLen: int64): bool {
    var i: int64 := 0;
    while i < srcLen {
      if StrCharAt(lit, i) != StrCharAt(src, i) { return false; }
      i := i + 1;
    }
    return StrCharAt(lit, srcLen) == 0;
  }

  // Capability-ID aus längengebundenem Pfad (aus dem AST-Quellpuffer)
  pub fn LookupId(path: pchar, pathLen: int64): int64 {
    if self._pathEqN("system.exit"c,                  path, pathLen) { return CAP_SYSTEM_EXIT; }
    if self._pathEqN("system.memory.heap"c,           path, pathLen) { return CAP_SYSTEM_MEMORY_HEAP; }
    if self._pathEqN("system.memory.stack"c,          path, pathLen) { return CAP_SYSTEM_MEMORY_STACK; }
    if self._pathEqN("system.time"c,                  path, pathLen) { return CAP_SYSTEM_TIME; }
    if self._pathEqN("system.env"c,                   path, pathLen) { return CAP_SYSTEM_ENV; }
    if self._pathEqN("system.rand"c,                  path, pathLen) { return CAP_SYSTEM_RAND; }
    if self._pathEqN("system.unsafe.format_string"c,  path, pathLen) { return CAP_SYSTEM_UNSAFE_FORMAT; }
    if self._pathEqN("system.config"c,                path, pathLen) { return CAP_SYSTEM_CONFIG; }
    if self._pathEqN("fs.read"c,                      path, pathLen) { return CAP_FS_READ; }
    if self._pathEqN("fs.write"c,                     path, pathLen) { return CAP_FS_WRITE; }
    if self._pathEqN("fs.create"c,                    path, pathLen) { return CAP_FS_CREATE; }
    if self._pathEqN("fs.delete"c,                    path, pathLen) { return CAP_FS_DELETE; }
    if self._pathEqN("fs.meta"c,                      path, pathLen) { return CAP_FS_META; }
    if self._pathEqN("fs.perm"c,                      path, pathLen) { return CAP_FS_PERM; }
    if self._pathEqN("fs.exec"c,                      path, pathLen) { return CAP_FS_EXEC; }
    if self._pathEqN("memory.mmap"c,                  path, pathLen) { return CAP_MEMORY_MMAP; }
    if self._pathEqN("memory.lock"c,                  path, pathLen) { return CAP_MEMORY_LOCK; }
    if self._pathEqN("network.tcp.bind"c,             path, pathLen) { return CAP_NETWORK_TCP_BIND; }
    if self._pathEqN("network.tcp.connect"c,          path, pathLen) { return CAP_NETWORK_TCP_CONNECT; }
    if self._pathEqN("network.udp.bind"c,             path, pathLen) { return CAP_NETWORK_UDP_BIND; }
    if self._pathEqN("network.udp.connect"c,          path, pathLen) { return CAP_NETWORK_UDP_CONNECT; }
    if self._pathEqN("network.unix"c,                 path, pathLen) { return CAP_NETWORK_UNIX; }
    if self._pathEqN("network.raw"c,                  path, pathLen) { return CAP_NETWORK_RAW; }
    if self._pathEqN("hardware.gpio"c,                path, pathLen) { return CAP_HARDWARE_GPIO; }
    if self._pathEqN("hardware.i2c"c,                 path, pathLen) { return CAP_HARDWARE_I2C; }
    if self._pathEqN("hardware.spi"c,                 path, pathLen) { return CAP_HARDWARE_SPI; }
    if self._pathEqN("hardware.usb"c,                 path, pathLen) { return CAP_HARDWARE_USB; }
    if self._pathEqN("hardware.block"c,               path, pathLen) { return CAP_HARDWARE_BLOCK; }
    if self._pathEqN("ki.embed"c,                     path, pathLen) { return CAP_KI_EMBED; }   // #1826
    if self._pathEqN("ki.graph"c,                     path, pathLen) { return CAP_KI_GRAPH; }   // #1826
    if self._pathEqN("audio.mic"c,                    path, pathLen) { return CAP_AUDIO_MIC; }  // #1826
    if self._pathEqN("process.fork"c,                 path, pathLen) { return CAP_PROCESS_FORK; }
    if self._pathEqN("process.exec"c,                 path, pathLen) { return CAP_PROCESS_EXEC; }
    if self._pathEqN("process.signal"c,               path, pathLen) { return CAP_PROCESS_SIGNAL; }
    if self._pathEqN("process.sched"c,                path, pathLen) { return CAP_PROCESS_SCHED; }
    if self._pathEqN("process.exit"c,                 path, pathLen) { return CAP_PROCESS_EXIT; }
    return CAP_UNKNOWN;
  }

  // Resolve via null-terminiertem Pfad-String (z. B. für Tests und Audit-Ausgabe).
  // Ergebnis wird in out geschrieben (Output-Parameter, Lyx-Konvention).
  pub fn Resolve(path: pchar, out: SyscallList): void {
    var pathLen: int64 := 0;
    while StrCharAt(path, pathLen) != 0 { pathLen := pathLen + 1; }
    var capId: int64 := self.LookupId(path, pathLen);
    self.ResolveById(capId, out);
  }

  // Resolve nach Capability-ID; Ergebnis wird in out geschrieben.
  pub fn ResolveById(capId: int64, out: SyscallList): void {
    out.Init();
    if capId == CAP_SYSTEM_EXIT {
      out.count := 1;
      out.s0 := "exit_group"c;
    } else if capId == CAP_SYSTEM_MEMORY_HEAP {
      out.count := 3;
      out.s0 := "brk"c;
      out.s1 := "mmap(MAP_ANON)"c;
      out.s2 := "munmap"c;
    } else if capId == CAP_SYSTEM_MEMORY_STACK {
      out.count := 1;
      out.s0 := "mmap(MAP_STACK)"c;
    } else if capId == CAP_SYSTEM_TIME {
      out.count := 1;
      out.s0 := "clock_gettime"c;
    } else if capId == CAP_SYSTEM_ENV {
      out.count := 0;
    } else if capId == CAP_SYSTEM_RAND {
      out.count := 1;
      out.s0 := "getrandom"c;
    } else if capId == CAP_SYSTEM_UNSAFE_FORMAT {
      out.count := 0;
    } else if capId == CAP_FS_READ {
      out.count := 2;
      out.s0 := "openat(O_RDONLY)"c;
      out.s1 := "read"c;
    } else if capId == CAP_FS_WRITE {
      out.count := 2;
      out.s0 := "openat(O_WRONLY|O_RDWR)"c;
      out.s1 := "write"c;
    } else if capId == CAP_FS_CREATE {
      out.count := 1;
      out.s0 := "openat(O_CREAT)"c;
    } else if capId == CAP_FS_DELETE {
      out.count := 2;
      out.s0 := "unlinkat"c;
      out.s1 := "rmdir"c;
    } else if capId == CAP_FS_META {
      out.count := 2;
      out.s0 := "statx"c;
      out.s1 := "getdents64"c;
    } else if capId == CAP_FS_PERM {
      out.count := 2;
      out.s0 := "chmod"c;
      out.s1 := "chown"c;
    } else if capId == CAP_FS_EXEC {
      out.count := 1;
      out.s0 := "execveat"c;
    } else if capId == CAP_MEMORY_MMAP {
      out.count := 2;
      out.s0 := "mmap(FILE|SHARED)"c;
      out.s1 := "mprotect"c;
    } else if capId == CAP_MEMORY_LOCK {
      out.count := 2;
      out.s0 := "mlock"c;
      out.s1 := "mlockall"c;
    } else if capId == CAP_NETWORK_TCP_BIND {
      out.count := 3;
      out.s0 := "bind"c;
      out.s1 := "listen"c;
      out.s2 := "accept"c;
    } else if capId == CAP_NETWORK_TCP_CONNECT {
      out.count := 3;
      out.s0 := "socket(AF_INET,SOCK_STREAM)"c;
      out.s1 := "connect"c;
      out.s2 := "send"c;
    } else if capId == CAP_NETWORK_UDP_BIND {
      out.count := 2;
      out.s0 := "bind"c;
      out.s1 := "recvfrom"c;
    } else if capId == CAP_NETWORK_UDP_CONNECT {
      out.count := 3;
      out.s0 := "socket(AF_INET,SOCK_DGRAM)"c;
      out.s1 := "sendto"c;
      out.s2 := "connect"c;
    } else if capId == CAP_NETWORK_UNIX {
      out.count := 1;
      out.s0 := "socket(AF_UNIX)"c;
    } else if capId == CAP_NETWORK_RAW {
      out.count := 1;
      out.s0 := "socket(AF_PACKET)"c;
    } else if capId == CAP_HARDWARE_GPIO {
      out.count := 1;
      out.s0 := "ioctl"c;
    } else if capId == CAP_HARDWARE_I2C {
      out.count := 1;
      out.s0 := "ioctl"c;
    } else if capId == CAP_HARDWARE_SPI {
      out.count := 1;
      out.s0 := "ioctl"c;
    } else if capId == CAP_HARDWARE_USB {
      out.count := 1;
      out.s0 := "ioctl"c;
    } else if capId == CAP_PROCESS_FORK {
      out.count := 2;
      out.s0 := "clone"c;
      out.s1 := "fork"c;
    } else if capId == CAP_PROCESS_EXEC {
      out.count := 2;
      out.s0 := "execve"c;
      out.s1 := "execveat"c;
    } else if capId == CAP_PROCESS_SIGNAL {
      out.count := 2;
      out.s0 := "kill"c;
      out.s1 := "tgkill"c;
    } else if capId == CAP_PROCESS_SCHED {
      out.count := 2;
      out.s0 := "sched_setattr"c;
      out.s1 := "nice"c;
    } else if capId == CAP_PROCESS_EXIT {
      out.count := 2;
      out.s0 := "exit"c;
      out.s1 := "exit_group"c;
    }
  }

  // true für die drei Capabilities, die immer aktiv sind
  pub fn IsImplicit(capId: int64): bool {
    return capId == CAP_SYSTEM_EXIT ||
           capId == CAP_SYSTEM_MEMORY_HEAP ||
           capId == CAP_SYSTEM_MEMORY_STACK;
  }

  // true wenn capId eine gültige bekannte Capability ist
  pub fn IsKnown(capId: int64): bool {
    return capId >= 0 && capId < CAP_COUNT;
  }

  // Validierung: GPIO-Pin muss 0–53 sein. Gibt Fehlermeldung oder 0 zurück.
  pub fn ValidateGpioPin(val: int64): pchar {
    if val < 0 || val > 53 {
      return "Pin außerhalb des gültigen Bereichs 0-53"c;
    }
    return 0 as pchar;
  }

  // Validierung: Port muss 1–65535 sein.
  pub fn ValidatePort(val: int64): pchar {
    if val < 1 || val > 65535 {
      return "Port außerhalb des gültigen Bereichs 1-65535"c;
    }
    return 0 as pchar;
  }

  // Validierung: Port 0–65535 (0 = Wildcard für UDP-Connect).
  pub fn ValidatePortOrWildcard(val: int64): pchar {
    if val < 0 || val > 65535 {
      return "Port außerhalb des gültigen Bereichs 0-65535"c;
    }
    return 0 as pchar;
  }

  // Validierung: Bus/CS muss 0–255 sein.
  pub fn ValidateBus(val: int64): pchar {
    if val < 0 || val > 255 {
      return "Bus-Nummer außerhalb des gültigen Bereichs 0-255"c;
    }
    return 0 as pchar;
  }

  // Validierung: USB-Vendor/Product-ID muss 0–65535 sein.
  pub fn ValidateUsbId(val: int64): pchar {
    if val < 0 || val > 65535 {
      return "USB-ID außerhalb des gültigen Bereichs 0-65535"c;
    }
    return 0 as pchar;
  }

  // #1108: Kennt diese Capability den Argumentnamen ueberhaupt?
  //
  // Der Capability-NAME wurde seit jeher geprueft (`zzz.erfunden` → Fehler),
  // der Argumentname nicht: `fs.read(zzz_arg: "x")` und `fs.read(pfad: "/tmp")`
  // uebersetzten kommentarlos. ValidateArg prueft nur WERTEBEREICHE bekannter
  // Schluessel und faellt fuer alles andere auf "in Ordnung" — der stille
  // Default. Ein Tippfehler fiel damit doppelt nicht auf: nicht beim
  // Uebersetzen, und zur Laufzeit ohnehin nicht, weil die Angabe folgenlos
  // bleibt (siehe ebnf.md §20.1).
  //
  // Rueckgabe: 1 = Name gehoert zu dieser Capability, 0 = unbekannt.
  pub fn IsKnownArg(capId: int64, argKey: pchar, argKeyLen: int64): int64 {
    // Dateisystem und process.exec: `path`
    if capId == CAP_FS_READ   || capId == CAP_FS_WRITE  || capId == CAP_FS_CREATE ||
       capId == CAP_FS_DELETE || capId == CAP_FS_META   || capId == CAP_FS_EXEC   ||
       capId == CAP_FS_PERM   || capId == CAP_PROCESS_EXEC {
      if self._pathEqN("path"c, argKey, argKeyLen) { return 1; }
      return 0;
    }
    // Netzwerk: `host` und `port`. Die zusammengesetzte Schreibweise
    // "addr":port (NetworkTarget) steht als WERT hinter `host`.
    if capId == CAP_NETWORK_TCP_BIND    || capId == CAP_NETWORK_TCP_CONNECT ||
       capId == CAP_NETWORK_UDP_BIND    || capId == CAP_NETWORK_UDP_CONNECT ||
       capId == CAP_NETWORK_UNIX        || capId == CAP_NETWORK_RAW {
      if self._pathEqN("host"c, argKey, argKeyLen) { return 1; }
      if self._pathEqN("port"c, argKey, argKeyLen) { return 1; }
      return 0;
    }
    if capId == CAP_HARDWARE_GPIO {
      if self._pathEqN("pin"c, argKey, argKeyLen) { return 1; }
      return 0;
    }
    if capId == CAP_HARDWARE_I2C {
      if self._pathEqN("bus"c, argKey, argKeyLen) { return 1; }
      return 0;
    }
    if capId == CAP_HARDWARE_SPI {
      if self._pathEqN("bus"c, argKey, argKeyLen) { return 1; }
      if self._pathEqN("cs"c,  argKey, argKeyLen) { return 1; }
      return 0;
    }
    if capId == CAP_HARDWARE_USB {
      if self._pathEqN("vendor"c,  argKey, argKeyLen) { return 1; }
      if self._pathEqN("product"c, argKey, argKeyLen) { return 1; }
      return 0;
    }
    // Alle uebrigen Capabilities nehmen keine Argumente.
    return 0;
  }

  // #1108: Nimmt diese Capability ueberhaupt Argumente? Trennt die Meldung
  // "dieser Name gehoert nicht hierher" von "hier gibt es gar keine Argumente".
  pub fn TakesArgs(capId: int64): int64 {
    if capId == CAP_FS_READ   || capId == CAP_FS_WRITE  || capId == CAP_FS_CREATE ||
       capId == CAP_FS_DELETE || capId == CAP_FS_META   || capId == CAP_FS_EXEC   ||
       capId == CAP_FS_PERM   || capId == CAP_PROCESS_EXEC { return 1; }
    if capId == CAP_NETWORK_TCP_BIND || capId == CAP_NETWORK_TCP_CONNECT ||
       capId == CAP_NETWORK_UDP_BIND || capId == CAP_NETWORK_UDP_CONNECT ||
       capId == CAP_NETWORK_UNIX     || capId == CAP_NETWORK_RAW { return 1; }
    if capId == CAP_HARDWARE_GPIO || capId == CAP_HARDWARE_I2C ||
       capId == CAP_HARDWARE_SPI  || capId == CAP_HARDWARE_USB { return 1; }
    return 0;
  }

  // Validiert einen einzelnen Capability-Parameter.
  // argKey/argKeyLen: Schlüsselname (längengebunden aus AST-Quellpuffer)
  // argVal: Integer-Wert des Arguments (-1 wenn kein Integer)
  // Gibt Fehlermeldung-pchar zurück oder 0 wenn OK.
  pub fn ValidateArg(capId: int64, argKey: pchar, argKeyLen: int64, argVal: int64): pchar {
    // hardware.gpio: pin muss 0–53
    if capId == CAP_HARDWARE_GPIO {
      if self._pathEqN("pin"c, argKey, argKeyLen) {
        return self.ValidateGpioPin(argVal);
      }
    }
    // network.tcp.*: port muss 1–65535 (Port 0 ungültig)
    if capId == CAP_NETWORK_TCP_BIND || capId == CAP_NETWORK_TCP_CONNECT {
      if self._pathEqN("port"c, argKey, argKeyLen) {
        if argVal == 0 { return "Port 0 ist kein gültiger Port"c; }
        return self.ValidatePort(argVal);
      }
    }
    // network.udp.bind: port muss 1–65535
    if capId == CAP_NETWORK_UDP_BIND {
      if self._pathEqN("port"c, argKey, argKeyLen) {
        if argVal == 0 { return "Port 0 ist kein gültiger Port"c; }
        return self.ValidatePort(argVal);
      }
    }
    // network.udp.connect: port 0–65535 (0 = Wildcard)
    if capId == CAP_NETWORK_UDP_CONNECT {
      if self._pathEqN("port"c, argKey, argKeyLen) {
        return self.ValidatePortOrWildcard(argVal);
      }
    }
    // hardware.i2c / hardware.spi: bus muss 0–255
    if capId == CAP_HARDWARE_I2C || capId == CAP_HARDWARE_SPI {
      if self._pathEqN("bus"c, argKey, argKeyLen) {
        return self.ValidateBus(argVal);
      }
    }
    // hardware.spi: cs muss 0–255
    if capId == CAP_HARDWARE_SPI {
      if self._pathEqN("cs"c, argKey, argKeyLen) {
        return self.ValidateBus(argVal);
      }
    }
    // hardware.usb: vendor und product müssen 0–65535
    if capId == CAP_HARDWARE_USB {
      if self._pathEqN("vendor"c, argKey, argKeyLen) {
        return self.ValidateUsbId(argVal);
      }
      if self._pathEqN("product"c, argKey, argKeyLen) {
        return self.ValidateUsbId(argVal);
      }
    }
    return 0 as pchar;
  }
};
