// ===========================================================================
// WP-R9: seccomp-BPF-Codegenerierung
// ===========================================================================
// Generiert classic BPF Bytecode (struct sock_filter) für prctl(PR_SET_SECCOMP).
// Jeder BPF-Befehl = 8 Bytes: { op:u16LE, jt:u8, jf:u8, k:u32LE }.
//
// Programmstruktur:
//   [0-2]  Architektur-Check (x86-64)
//   [3]    Lade syscall-Nummer
//   [4..N] Syscall-Whitelists (2-Befehlsblöcke; Argument-Filter: 5-7 Befehle)
//   [N+1]  Default: SECCOMP_RET_KILL_PROCESS
//
// Implizit erlaubt (immer, auch ohne @capabilities):
//   exit_group, exit, brk, mmap(anon), munmap, write, prctl, prlimit64, getrandom

import src.std.alloc;

// BPF-Opcode-Konstanten (classic BPF)
con SC_LD_ABS_W:    int64 := 0x20;  // BPF_LD|BPF_W|BPF_ABS
con SC_ALU_AND_K:   int64 := 0x54;  // BPF_ALU|BPF_AND|BPF_K
con SC_JMP_JEQ_K:   int64 := 0x15;  // BPF_JMP|BPF_JEQ|BPF_K
con SC_RET_K:       int64 := 0x06;  // BPF_RET|BPF_K

// seccomp Rückgabewerte
con SC_ALLOW:    int64 := 0x7fff0000;  // SECCOMP_RET_ALLOW
con SC_KILL:     int64 := 0x80000000;  // SECCOMP_RET_KILL_PROCESS
con SC_TRAP:     int64 := 0x00030000;  // SECCOMP_RET_TRAP — #1348

// #1348: KILL_PROCESS beendet den Prozess, BEVOR irgendein Beobachter etwas
// sieht: strace protokolliert den killenden Syscall nicht (der Filter laeuft
// vor dem ptrace-Stop), gdb bekommt keinen Stop, und ohne coredumpctl gibt es
// keine Quelle fuer si_syscall. Wer eine Capability vergessen hat, sieht nur
// "Ungueltiger Betriebssystemaufruf" — und bisektiert.
//
// TRAP stellt stattdessen SIGSYS zu. Der Prozess stirbt weiterhin (fail-closed
// bleibt fail-closed), aber die Nummer des Syscalls steht in si_syscall und
// ist fuer strace, gdb und den Coredump sichtbar. Nur ueber --seccomp-trap
// erreichbar, nie Vorgabe.
var sc_retAction: int64 := 0;   // 0 = KILL (Vorgabe), sonst TRAP

pub fn seccomp_set_trap_mode(on: int64): void {
  if (on != 0) { sc_retAction := SC_TRAP; } else { sc_retAction := 0; }
}

fn sc_deny(): int64 {
  if (sc_retAction != 0) { return sc_retAction; }
  return SC_KILL;
}

