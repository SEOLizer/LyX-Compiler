// Längengebundener String-Vergleich mit null-terminiertem Literal
fn sc_path_eq(lit: pchar, src: pchar, n: int64): bool {
  var i: int64 := 0;
  while i < n {
    if StrCharAt(lit, i) != StrCharAt(src, i) { return false; }
    i := i + 1;
  }
  return StrCharAt(lit, n) == 0;
}

// Mappt Capability-Pfad-String → Capability-ID (lokale Kopie ohne Import-Abhängigkeit)
pub fn seccomp_cap_id_from_path(path: pchar, len: int64): int64 {
  if sc_path_eq("system.exit"c,                 path, len) { return SC_CAP_SYSTEM_EXIT; }
  if sc_path_eq("system.memory.heap"c,          path, len) { return SC_CAP_SYSTEM_MEMORY_HEAP; }
  if sc_path_eq("system.memory.stack"c,         path, len) { return SC_CAP_SYSTEM_MEMORY_STACK; }
  if sc_path_eq("system.time"c,                 path, len) { return SC_CAP_SYSTEM_TIME; }
  if sc_path_eq("system.env"c,                  path, len) { return SC_CAP_SYSTEM_ENV; }
  if sc_path_eq("system.rand"c,                 path, len) { return SC_CAP_SYSTEM_RAND; }
  if sc_path_eq("fs.read"c,                     path, len) { return SC_CAP_FS_READ; }
  if sc_path_eq("fs.write"c,                    path, len) { return SC_CAP_FS_WRITE; }
  if sc_path_eq("fs.create"c,                   path, len) { return SC_CAP_FS_CREATE; }
  if sc_path_eq("fs.delete"c,                   path, len) { return SC_CAP_FS_DELETE; }
  if sc_path_eq("fs.meta"c,                     path, len) { return SC_CAP_FS_META; }
  if sc_path_eq("fs.perm"c,                     path, len) { return SC_CAP_FS_PERM; }   // #1188
  if sc_path_eq("audio.play"c,                  path, len) { return SC_CAP_AUDIO_PLAY; }  // #1873
  if sc_path_eq("io.wait"c,                     path, len) { return SC_CAP_IO_WAIT; }     // #1868
  if sc_path_eq("io.fd"c,                       path, len) { return SC_CAP_IO_FD; }       // #1869
  if sc_path_eq("system.tty"c,                  path, len) { return SC_CAP_SYSTEM_TTY; }  // #1867
  if sc_path_eq("process.privileges"c,          path, len) { return SC_CAP_PROCESS_PRIVILEGES; } // #1870
  if sc_path_eq("system.namespace"c,            path, len) { return SC_CAP_SYSTEM_NAMESPACE; }   // #1870
  if sc_path_eq("system.admin"c,                path, len) { return SC_CAP_SYSTEM_ADMIN; }       // #1870
  if sc_path_eq("ipc.shm"c,                     path, len) { return SC_CAP_IPC_SHM; }            // #1871
  if sc_path_eq("ipc.queue"c,                   path, len) { return SC_CAP_IPC_QUEUE; }          // #1871
  if sc_path_eq("ipc.sem"c,                     path, len) { return SC_CAP_IPC_SEM; }            // #1871
  if sc_path_eq("fs.xattr"c,                    path, len) { return SC_CAP_FS_XATTR; }           // #1872
  if sc_path_eq("fs.watch"c,                    path, len) { return SC_CAP_FS_WATCH; }           // #1872
  if sc_path_eq("fs.cwd"c,                      path, len) { return SC_CAP_FS_CWD; }             // #1872
  if sc_path_eq("debug.trace"c,                 path, len) { return SC_CAP_DEBUG_TRACE; }        // #1872
  if sc_path_eq("kernel.bpf"c,                  path, len) { return SC_CAP_KERNEL_BPF; }         // #1872
  if sc_path_eq("system.config"c,               path, len) { return SC_CAP_SYSTEM_CONFIG; }      // #1875
  if sc_path_eq("hardware.block"c,              path, len) { return SC_CAP_HARDWARE_BLOCK; }     // #1875
  if sc_path_eq("system.unsafe.format_string"c, path, len) { return SC_CAP_SYSTEM_UNSAFE_FMT; }  // #1875
  if sc_path_eq("fs.exec"c,                     path, len) { return SC_CAP_FS_EXEC; }
  if sc_path_eq("memory.mmap"c,                 path, len) { return SC_CAP_MEMORY_MMAP; }
  if sc_path_eq("memory.lock"c,                 path, len) { return SC_CAP_MEMORY_LOCK; }
  if sc_path_eq("network.tcp.bind"c,            path, len) { return SC_CAP_NETWORK_TCP_BIND; }
