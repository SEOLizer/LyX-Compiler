  if sc_path_eq("network.udp.bind"c,            path, len) { return SC_CAP_NETWORK_UDP_BIND; }
  if sc_path_eq("network.udp.connect"c,         path, len) { return SC_CAP_NETWORK_UDP_CONNECT; }
  if sc_path_eq("network.unix"c,                path, len) { return SC_CAP_NETWORK_UNIX; }
  if sc_path_eq("network.raw"c,                 path, len) { return SC_CAP_NETWORK_RAW; }
  if sc_path_eq("hardware.gpio"c,               path, len) { return SC_CAP_HARDWARE_GPIO; }
  if sc_path_eq("hardware.i2c"c,                path, len) { return SC_CAP_HARDWARE_I2C; }
  if sc_path_eq("hardware.spi"c,                path, len) { return SC_CAP_HARDWARE_SPI; }
  if sc_path_eq("hardware.usb"c,                path, len) { return SC_CAP_HARDWARE_USB; }
  if sc_path_eq("process.fork"c,                path, len) { return SC_CAP_PROCESS_FORK; }
  if sc_path_eq("process.exec"c,                path, len) { return SC_CAP_PROCESS_EXEC; }
  if sc_path_eq("process.signal"c,              path, len) { return SC_CAP_PROCESS_SIGNAL; }
  if sc_path_eq("process.sched"c,               path, len) { return SC_CAP_PROCESS_SCHED; }
  if sc_path_eq("process.exit"c,                path, len) { return SC_CAP_PROCESS_EXIT; }
  return 0 - 1;
}

// #1276: Der Puffer war eine Zusage im Kommentar ("mind. 256 * 8 Bytes") und
// sonst nichts — kein Aufruf pruefte, ob er reicht. Waechst die Filterliste
// ueber die Kapazitaet, schreibt sc_emit hinter das Ende: Heap-Korruption,
// erzeugt ausgerechnet beim Bau eines SICHERHEITSfilters, und niemand merkt es.
// Deshalb eine Obergrenze, die der Erzeuger setzt und die hier haelt.
var sc_bufCap: int64 := 0;   // Kapazitaet in Befehlen; 0 = ungeprueft

// Schreibt einen BPF-Befehl als 8 Bytes LE in buf[idx]
fn sc_emit(buf: int64, idx: int64, op: int64, jt: int64, jf: int64, k: int64): void {
  if (sc_bufCap > 0 && idx >= sc_bufCap) {
    EPrintStr("lyxc: seccomp-Filter passt nicht in den Puffer ("c);
    EPrintInt(sc_bufCap);
    EPrintStrLn(" Befehle) — Abbruch statt Speicherkorruption."c);
    exit(1);
  }
  var off: int64 := buf + idx * 8;
  poke8(off + 0, op & 0xFF);
  poke8(off + 1, (op >> 8) & 0xFF);
  poke8(off + 2, jt & 0xFF);
  poke8(off + 3, jf & 0xFF);
  poke8(off + 4, k & 0xFF);
  poke8(off + 5, (k >> 8) & 0xFF);
  poke8(off + 6, (k >> 16) & 0xFF);
  poke8(off + 7, (k >> 24) & 0xFF);
}

// Einfacher Allow-Block: prüft exakt eine syscall-Nummer (2 Befehle)
fn sc_allow_nr(buf: int64, n: int64, nr: int64): int64 {
  sc_emit(buf, n,     SC_JMP_JEQ_K, 0, 1, nr);  // match → RET ALLOW; no match → skip
  sc_emit(buf, n + 1, SC_RET_K, 0, 0, SC_ALLOW);
  return n + 2;
}

// #1276: Allow-Block mit Argumentfilter — erlaubt `nr` nur, wenn args[1]
// genau `cmd` ist (5 Befehle + NR-Reload, wie der O_RDONLY-Filter unten).
// Ohne Filter waere `fcntl` ein Sammelbecken: derselbe Syscall setzt Sperren,
// vererbt Deskriptoren und stellt Signale zu. Eine Datei-Capability soll das
// Erste erlauben und das Letzte nicht.
fn sc_allow_nr_arg1(buf: int64, n: int64, nr: int64, cmd: int64): int64 {
  sc_emit(buf, n,     SC_JMP_JEQ_K, 0, 4, nr);        n := n + 1;
  sc_emit(buf, n,     SC_LD_ABS_W,  0, 0, SC_OFF_ARG1); n := n + 1;
  sc_emit(buf, n,     SC_JMP_JEQ_K, 0, 1, cmd);       n := n + 1;
  sc_emit(buf, n,     SC_RET_K,     0, 0, SC_ALLOW);  n := n + 1;
  sc_emit(buf, n,     SC_LD_ABS_W,  0, 0, SC_OFF_NR); n := n + 1;
  return n;
}

// Prüft ob capId in capBuf[0..capCount-1] enthalten ist
fn sc_has_cap(capBuf: int64, capCount: int64, capId: int64): bool {
  var i: int64 := 0;
  while i < capCount {
    if peek64(capBuf + i * 8) == capId { return true; }
    i := i + 1;
  }
  return false;
}

// ===========================================================================
// Hauptfunktion: generiert das BPF-Programm für die gegebene Capability-Menge
// capBuf:   int64[capCount] — Array von Capability-IDs
// capCount: Anzahl der Capabilities
// bpfBuf:   Ausgabepuffer (mind. 256 * 8 Bytes)
// Rückgabe: Anzahl der generierten BPF-Befehle
// ===========================================================================
pub fn seccomp_build_filter(capBuf: int64, capCount: int64, bpfBuf: int64): int64 {
  var n: int64 := 0;
  sc_bufCap := SC_BPF_CAP;

  // ---- Architektur-Check ------------------------------------------------
  sc_emit(bpfBuf, n, SC_LD_ABS_W, 0, 0, SC_OFF_ARCH); n := n + 1;
  sc_emit(bpfBuf, n, SC_JMP_JEQ_K, 1, 0, SC_ARCH_X86_64); n := n + 1; // x86-64 → skip kill
  sc_emit(bpfBuf, n, SC_RET_K, 0, 0, sc_deny()); n := n + 1;

  // ---- Lade syscall-Nummer ----------------------------------------------
  sc_emit(bpfBuf, n, SC_LD_ABS_W, 0, 0, SC_OFF_NR); n := n + 1;

  // ---- Implizite Syscalls (immer erlaubt) --------------------------------
  n := sc_allow_nr(bpfBuf, n, SC_SYS_EXIT_GROUP);  // exit_group
  n := sc_allow_nr(bpfBuf, n, SC_SYS_EXIT);        // exit
  n := sc_allow_nr(bpfBuf, n, SC_SYS_BRK);         // brk (heap)
  // mmap mit MAP_ANON erlauben (args[3] bit 0x20 gesetzt): Argument-Filter
  // Vereinfachung: mmap ohne Argument-Check erlaubt (häufig genug sicher für statische Binaries)
  n := sc_allow_nr(bpfBuf, n, SC_SYS_MMAP);        // mmap (anon & file)
  n := sc_allow_nr(bpfBuf, n, SC_SYS_MUNMAP);      // munmap
  n := sc_allow_nr(bpfBuf, n, SC_SYS_WRITE);       // write (für PrintStr/stdout)
  n := sc_allow_nr(bpfBuf, n, SC_SYS_PRCTL);       // prctl (für seccomp self-install)
  n := sc_allow_nr(bpfBuf, n, SC_SYS_PRLIMIT64);   // prlimit64 (_start stack remove)
  n := sc_allow_nr(bpfBuf, n, SC_SYS_FUTEX);       // futex (threading primitives)
  n := sc_allow_nr(bpfBuf, n, SC_SYS_RT_SIGACTION);  // signal handlers
  n := sc_allow_nr(bpfBuf, n, SC_SYS_RT_SIGRETURN);  // signal return
  // WP-24.1: getrandom immer erlauben — Stack-Canary-Init (__lyx_canary_init) braucht es
  n := sc_allow_nr(bpfBuf, n, SC_SYS_GETRANDOM);   // getrandom (canary init)

  // #1185: Basissatz harmloser Introspektion. Diese Aufrufe geben Auskunft
  // ueber den EIGENEN Prozess und beruehren nichts ausserhalb davon — sie
  // koennen weder lesen, schreiben, verbinden noch etwas veraendern. Ohne sie
  // ist eine extern gelinkte Bibliothek nicht benutzbar: OpenSSL ruft `getpid`
  // beim Init (RNG-Reseed-Check), und der Prozess stirbt, bevor ueberhaupt
  // eine Verbindung zustande kommt.
  //
  // Bewusst NICHT hier: `clock_gettime` — dafuer gibt es `system.time`, und
  // ein immer erlaubter Zeitzugriff entwertete die Capability.
  n := sc_allow_nr(bpfBuf, n, SC_SYS_GETPID);
  n := sc_allow_nr(bpfBuf, n, SC_SYS_GETTID);
  n := sc_allow_nr(bpfBuf, n, SC_SYS_GETPPID);
  n := sc_allow_nr(bpfBuf, n, SC_SYS_GETUID);
  n := sc_allow_nr(bpfBuf, n, SC_SYS_GETEUID);
  n := sc_allow_nr(bpfBuf, n, SC_SYS_GETGID);
  n := sc_allow_nr(bpfBuf, n, SC_SYS_GETEGID);
  // #1872: dieselbe Klasse, beim Erheben uebersehen. `uname` nennt Kernel und
  // Rechnername, `getcpu` den Kern, auf dem gerade gelaufen wird, `arch_prctl`
  // setzt das Thread-Register (fs.base) — ohne das startet kein Programm mit
  // thread-lokalen Daten. Keiner der drei erreicht etwas ausserhalb des
  // eigenen Prozesses.
  n := sc_allow_nr(bpfBuf, n, SC_SYS_UNAME);
  n := sc_allow_nr(bpfBuf, n, SC_SYS_GETCPU);
  n := sc_allow_nr(bpfBuf, n, SC_SYS_ARCH_PRCTL);
  // Die neuen futex-Aufrufe (futex2, Kernel 6.7+). `futex` selbst steht schon
  // im Basissatz; die Nachfolger gehoeren an dieselbe Stelle, sonst haengt es
  // von der Kernelversion ab, ob eine Sperre funktioniert.
  n := sc_allow_nr(bpfBuf, n, SC_SYS_FUTEX_WAITV);
  n := sc_allow_nr(bpfBuf, n, SC_SYS_FUTEX_WAKE);
  n := sc_allow_nr(bpfBuf, n, SC_SYS_FUTEX_WAIT);
  n := sc_allow_nr(bpfBuf, n, SC_SYS_FUTEX_REQUEUE);

  // ---- Capability-spezifische Syscalls -----------------------------------

  // fs.read + fs.write + fs.create → openat
  // Argument-Filter: wenn nur fs.read → O_RDONLY; wenn fs.write → alle Flags
  var hasRead:   bool := sc_has_cap(capBuf, capCount, SC_CAP_FS_READ);
  var hasWrite:  bool := sc_has_cap(capBuf, capCount, SC_CAP_FS_WRITE);
  var hasCreate: bool := sc_has_cap(capBuf, capCount, SC_CAP_FS_CREATE);

  if hasWrite || hasCreate {
    // Beliebige open/openat-Flags erlaubt
    n := sc_allow_nr(bpfBuf, n, SC_SYS_OPEN);    // SYS_open = 2
    n := sc_allow_nr(bpfBuf, n, SC_SYS_OPENAT);  // SYS_openat = 257
  } else if hasRead {
    // Nur O_RDONLY (flags & 3 == 0) erlaubt für open() und openat()
    // open(): flags ist args[1] (offset 24); openat(): flags ist args[2] (offset 32)
    // --- open() O_RDONLY Filter (5 Befehle + NR-Reload) ---
    sc_emit(bpfBuf, n, SC_JMP_JEQ_K, 0, 4, SC_SYS_OPEN); n := n + 1;
    sc_emit(bpfBuf, n, SC_LD_ABS_W, 0, 0, SC_OFF_ARG1); n := n + 1;  // flags = args[1]
    sc_emit(bpfBuf, n, SC_ALU_AND_K, 0, 0, SC_O_WRITE_MASK); n := n + 1;
    sc_emit(bpfBuf, n, SC_JMP_JEQ_K, 0, 1, 0); n := n + 1;
    sc_emit(bpfBuf, n, SC_RET_K, 0, 0, SC_ALLOW); n := n + 1;
    sc_emit(bpfBuf, n, SC_LD_ABS_W, 0, 0, SC_OFF_NR); n := n + 1;
    // --- openat() O_RDONLY Filter (5 Befehle + NR-Reload) ---
    sc_emit(bpfBuf, n, SC_JMP_JEQ_K, 0, 4, SC_SYS_OPENAT); n := n + 1;
    sc_emit(bpfBuf, n, SC_LD_ABS_W, 0, 0, SC_OFF_ARG2); n := n + 1;  // flags = args[2]
    sc_emit(bpfBuf, n, SC_ALU_AND_K, 0, 0, SC_O_WRITE_MASK); n := n + 1;
    sc_emit(bpfBuf, n, SC_JMP_JEQ_K, 0, 1, 0); n := n + 1;
    sc_emit(bpfBuf, n, SC_RET_K, 0, 0, SC_ALLOW); n := n + 1;
    sc_emit(bpfBuf, n, SC_LD_ABS_W, 0, 0, SC_OFF_NR); n := n + 1;
  }

  // #1276: fcntl fehlte vollstaendig. Eine gehaertete std.db.sqlite starb
  // deshalb beim ersten Zugriff an SIGSYS — SQLite setzt vor jedem Lesen eine
  // Sperre (F_SETLK). Ohne Haertung lief dieselbe Unit, was den Verdacht
  // zunaechst auf die Unit lenkte statt auf den Filter.
  if hasRead || hasWrite {
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_FCNTL, SC_F_GETFD);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_FCNTL, SC_F_SETFD);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_FCNTL, SC_F_GETFL);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_FCNTL, SC_F_SETFL);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_FCNTL, SC_F_GETLK);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_FCNTL, SC_F_SETLK);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_FCNTL, SC_F_SETLKW);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_FCNTL, SC_F_OFD_GETLK);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_FCNTL, SC_F_OFD_SETLK);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_FCNTL, SC_F_OFD_SETLKW);
  }

  if hasRead {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_READ);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_PREAD64);      // WP-24.3: positional read
    n := sc_allow_nr(bpfBuf, n, SC_SYS_CLOSE);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_LSEEK);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_FSTAT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_NEWFSTATAT);   // WP-24.3: path-based stat
  }
  if hasWrite {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_READ);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_PREAD64);      // WP-24.3: positional read
    n := sc_allow_nr(bpfBuf, n, SC_SYS_CLOSE);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_LSEEK);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_FSTAT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_NEWFSTATAT);   // WP-24.3: path-based stat
  }

  // #1185: fs.create — "Neue Dateien und Verzeichnisse anlegen" (capabilities.md).
  // Verzeichnisse anlegen heisst mkdir; der Filter kannte davon nichts.
  if hasCreate {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MKDIR);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MKDIRAT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_CREAT);
  }

  if sc_has_cap(capBuf, capCount, SC_CAP_FS_DELETE) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_UNLINKAT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_RMDIR);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_UNLINK);      // #1185: die Direktvariante
  }

  // #1185: Umbenennen legt am Ziel an UND entfernt an der Quelle. Deshalb
  // verlangt es BEIDE Capabilities — eine allein reicht nicht, sonst waere
  // `rename` ein Weg, ohne fs.delete zu loeschen.
  if hasCreate && sc_has_cap(capBuf, capCount, SC_CAP_FS_DELETE) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_RENAME);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_RENAMEAT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_RENAMEAT2);
  }

  // #1185: fs.write — in Dateien schreiben. Kuerzen und Synchronisieren
  // aendern den Inhalt einer bereits geoeffneten Datei und gehoeren dazu.
  //
  // #1830: pwrite64 (18) fehlte hier — waehrend pread64 (17) unter WP-24.3
  // laengst erlaubt war. Die Leseseite wurde nachgezogen, die Schreibseite
  // daneben nicht. std.db.sqlite starb deshalb unter @capabilities weiterhin
  // mit SIGSYS, direkt nach dem ersten Schreiben ins Journal: SQLite schreibt
  // ausschliesslich positioniert. Im strace sah es aus wie ein geglueckter
  // Aufruf mit dem seltsamen Ergebnis 18 — das war nicht der Rueckgabewert,
  // sondern die Nummer des verworfenen Syscalls.
  //
  // #1276 hatte fcntl ergaenzt und den Abbruch damit nur verschoben: die
  // Sperre ging danach durch, das Schreiben nicht.
  if hasWrite {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_PWRITE64);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_TRUNCATE);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_FTRUNCATE);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_FSYNC);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_FDATASYNC);
  }

  // #1185: fs.read — "Dateien und Verzeichnisse lesen". Ein Symlink-Ziel und
  // das Arbeitsverzeichnis sind Lesevorgaenge.
  if hasRead {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_READLINK);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_GETCWD);
  }

  if sc_has_cap(capBuf, capCount, SC_CAP_FS_META) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_STATX);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_GETDENTS64);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_NEWFSTATAT);   // WP-24.3: path-based stat
    // #1185: "Metadaten lesen (stat, Verzeichnislisting)" — die aelteren
    // Direktvarianten gehoeren dazu. NICHT dabei: chmod und chown; sie
    // SCHREIBEN Metadaten und haengen seit #1188 an fs.perm.
    n := sc_allow_nr(bpfBuf, n, SC_SYS_STAT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_LSTAT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_ACCESS);
  }

  // #1188: fs.perm — Zugriffsrechte und Eigentuemer aendern. Eigene
  // Capability, damit wer `fs.meta` zum Auflisten anfordert, nicht
  // stillschweigend auch Rechte umschreiben darf.
  if sc_has_cap(capBuf, capCount, SC_CAP_FS_PERM) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_CHMOD);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_FCHMOD);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_FCHMODAT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_CHOWN);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_FCHOWN);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_LCHOWN);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_FCHOWNAT);
  }

  if sc_has_cap(capBuf, capCount, SC_CAP_FS_EXEC) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_EXECVEAT);
  }

  // #1866: `system.time` erlaubte nur clock_gettime — sleep() starb damit an
  // SIGSYS, und es gab keine andere Capability, die es freigegeben haette.
  // Warten ist keine eigene Vertrauensfrage: wer die Uhr lesen darf, darf auch
  // warten, und ohne system.time laesst sich ueber nanosleep auch keine Zeit
  // messen.
  if sc_has_cap(capBuf, capCount, SC_CAP_SYSTEM_TIME) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_CLOCK_GETTIME);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_NANOSLEEP);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_CLOCK_NANOSLEEP);
  }

  // #1868: auf Deskriptoren warten. Die Capability macht kein neues Objekt
  // erreichbar — gewartet wird auf das, was das Programm ohnehin schon hat.
  // eventfd, signalfd und timerfd ERZEUGEN allerdings Deskriptoren; sie
  // gehoeren deshalb an dieselbe ausdrueckliche Zusage und nicht in den
  // impliziten Basissatz.
  if sc_has_cap(capBuf, capCount, SC_CAP_IO_WAIT) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_POLL);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_PPOLL);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SELECT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_EPOLL_CREATE1);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_EPOLL_CTL);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_EPOLL_WAIT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_EPOLL_PWAIT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_EVENTFD2);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SIGNALFD4);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_TIMERFD_CREATE);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_TIMERFD_SETTIME);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_TIMERFD_GETTIME);
  }

  // #1869: Deskriptoren erzeugen und verdoppeln. Ohne pipe+dup2 kann ein
  // Kindprozess nichts zurueckgeben — process.fork/exec waren deklarierbar,
  // die Weiterleitung der Ausgabe nicht.
  //
  // fcntl steht bewusst NICHT hier: es ist seit #1276 unter fs.read/fs.write
  // mit Argumentfilter freigegeben. Es ein zweites Mal zu erlauben waere eine
  // stille Ausweitung fuer jeden, der nur eine Roehre braucht.
  if sc_has_cap(capBuf, capCount, SC_CAP_IO_FD) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_PIPE);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_PIPE2);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_DUP);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_DUP2);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_DUP3);
  }

  // #1867: Terminalarbeit. Bisher hing sie an hardware.gpio — einem Recht auf
  // Universal-I/O-Pins, das mit dem Terminal nichts zu tun hat. Hier NUR die
  // sechs termios- und Fenstergroessen-Kommandos, ueber den Argumentfilter:
  // `system.tty` erlaubt kein Netz-, Block- oder Geraete-ioctl.
  if sc_has_cap(capBuf, capCount, SC_CAP_SYSTEM_TTY) {
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_IOCTL, SC_TCGETS);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_IOCTL, SC_TCSETS);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_IOCTL, SC_TCSETSW);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_IOCTL, SC_TCSETSF);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_IOCTL, SC_TIOCGWINSZ);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_IOCTL, SC_TIOCSWINSZ);
  }

  if sc_has_cap(capBuf, capCount, SC_CAP_SYSTEM_RAND) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_GETRANDOM);
  }

  // Netzwerk: socket-Typ Argument-Filter
  var hasTcpConn: bool := sc_has_cap(capBuf, capCount, SC_CAP_NETWORK_TCP_CONNECT);
  var hasUdpConn: bool := sc_has_cap(capBuf, capCount, SC_CAP_NETWORK_UDP_CONNECT);
  var hasTcpBind: bool := sc_has_cap(capBuf, capCount, SC_CAP_NETWORK_TCP_BIND);
  var hasUdpBind: bool := sc_has_cap(capBuf, capCount, SC_CAP_NETWORK_UDP_BIND);
  var hasUnix:    bool := sc_has_cap(capBuf, capCount, SC_CAP_NETWORK_UNIX);

  if hasTcpConn || hasUdpConn || hasTcpBind || hasUdpBind || hasUnix {
    // socket-Aufruf: je nach vorhandenen Caps Argument-Filter generieren
    if (hasTcpConn && hasUdpConn) || (hasTcpBind && hasUdpBind) {
      // Alle socket-Typen erlaubt → einfacher Allow
      n := sc_allow_nr(bpfBuf, n, SC_SYS_SOCKET);
    } else if hasTcpConn || hasTcpBind {
      // Nur SOCK_STREAM (TCP): 7 Befehle
      sc_emit(bpfBuf, n, SC_JMP_JEQ_K, 0, 6, SC_SYS_SOCKET); n := n + 1;
      sc_emit(bpfBuf, n, SC_LD_ABS_W, 0, 0, SC_OFF_ARG0); n := n + 1;  // domain
      sc_emit(bpfBuf, n, SC_JMP_JEQ_K, 0, 4, SC_AF_INET); n := n + 1;  // not AF_INET → skip
      sc_emit(bpfBuf, n, SC_LD_ABS_W, 0, 0, SC_OFF_ARG1); n := n + 1;  // type
      sc_emit(bpfBuf, n, SC_ALU_AND_K, 0, 0, SC_SOCK_TYPE_MASK); n := n + 1;
      sc_emit(bpfBuf, n, SC_JMP_JEQ_K, 0, 1, SC_SOCK_STREAM); n := n + 1; // SOCK_STREAM → ALLOW
      sc_emit(bpfBuf, n, SC_RET_K, 0, 0, SC_ALLOW); n := n + 1;
      sc_emit(bpfBuf, n, SC_LD_ABS_W, 0, 0, SC_OFF_NR); n := n + 1;  // Reload NR
    } else if hasUdpConn || hasUdpBind {
      // Nur SOCK_DGRAM (UDP): 7 Befehle
      sc_emit(bpfBuf, n, SC_JMP_JEQ_K, 0, 6, SC_SYS_SOCKET); n := n + 1;
      sc_emit(bpfBuf, n, SC_LD_ABS_W, 0, 0, SC_OFF_ARG0); n := n + 1;
      sc_emit(bpfBuf, n, SC_JMP_JEQ_K, 0, 4, SC_AF_INET); n := n + 1;
      sc_emit(bpfBuf, n, SC_LD_ABS_W, 0, 0, SC_OFF_ARG1); n := n + 1;
      sc_emit(bpfBuf, n, SC_ALU_AND_K, 0, 0, SC_SOCK_TYPE_MASK); n := n + 1;
      sc_emit(bpfBuf, n, SC_JMP_JEQ_K, 0, 1, SC_SOCK_DGRAM); n := n + 1;
      sc_emit(bpfBuf, n, SC_RET_K, 0, 0, SC_ALLOW); n := n + 1;
      sc_emit(bpfBuf, n, SC_LD_ABS_W, 0, 0, SC_OFF_NR); n := n + 1;  // Reload NR
    } else if hasUnix {
      // AF_UNIX socket: 5 instructions total (gate + load-arg + check + allow + reload)
      // jf=3: if NR!=socket skip load-arg/check/allow, land on reload-NR (shared endpoint)
      // jf=1: if domain!=AF_UNIX skip allow, land on reload-NR
      sc_emit(bpfBuf, n, SC_JMP_JEQ_K, 0, 3, SC_SYS_SOCKET); n := n + 1;
      sc_emit(bpfBuf, n, SC_LD_ABS_W, 0, 0, SC_OFF_ARG0); n := n + 1;
      sc_emit(bpfBuf, n, SC_JMP_JEQ_K, 0, 1, SC_AF_UNIX); n := n + 1;
      sc_emit(bpfBuf, n, SC_RET_K, 0, 0, SC_ALLOW); n := n + 1;  // AF_UNIX match → allow
      sc_emit(bpfBuf, n, SC_LD_ABS_W, 0, 0, SC_OFF_NR); n := n + 1;  // Reload NR
    }
    if hasTcpConn {
      n := sc_allow_nr(bpfBuf, n, SC_SYS_CONNECT);
      n := sc_allow_nr(bpfBuf, n, SC_SYS_SENDTO);
      n := sc_allow_nr(bpfBuf, n, SC_SYS_RECVFROM);
    }
    if hasUdpConn {
      n := sc_allow_nr(bpfBuf, n, SC_SYS_SENDTO);
      n := sc_allow_nr(bpfBuf, n, SC_SYS_CONNECT);
    }
    if hasTcpBind {
      n := sc_allow_nr(bpfBuf, n, SC_SYS_BIND);
      n := sc_allow_nr(bpfBuf, n, SC_SYS_LISTEN);
      n := sc_allow_nr(bpfBuf, n, SC_SYS_ACCEPT);
      n := sc_allow_nr(bpfBuf, n, SC_SYS_ACCEPT4);
      n := sc_allow_nr(bpfBuf, n, SC_SYS_READ);      // read from accepted connections
      n := sc_allow_nr(bpfBuf, n, SC_SYS_RECVFROM);  // recvfrom for TCP servers
    }
    if hasUdpBind {
      n := sc_allow_nr(bpfBuf, n, SC_SYS_BIND);
      n := sc_allow_nr(bpfBuf, n, SC_SYS_RECVFROM);
    }
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SENDMSG);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_RECVMSG);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_CLOSE);
    // #1193: Optionen und Adressen der eigenen Verbindung. Sie oeffnen keinen
    // neuen Weg nach draussen — wer eine Verbindung aufbauen darf, darf ihre
    // Puffergroessen und Zeitgrenzen einstellen und wissen, mit wem er spricht.
    // Ohne setsockopt stirbt jeder TLS-Handshake (OpenSSL setzt TCP_ULP).
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SETSOCKOPT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_GETSOCKOPT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_GETSOCKNAME);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_GETPEERNAME);
  }

  if sc_has_cap(capBuf, capCount, SC_CAP_MEMORY_MMAP) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MPROTECT);
  }

  if sc_has_cap(capBuf, capCount, SC_CAP_MEMORY_LOCK) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MLOCK);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MLOCKALL);
  }

  if sc_has_cap(capBuf, capCount, SC_CAP_PROCESS_FORK) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_CLONE);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_FORK);
  }

  if sc_has_cap(capBuf, capCount, SC_CAP_PROCESS_EXEC) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_EXECVE);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_EXECVEAT);
  }

  if sc_has_cap(capBuf, capCount, SC_CAP_PROCESS_SIGNAL) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_KILL);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_TGKILL);
  }

  if sc_has_cap(capBuf, capCount, SC_CAP_PROCESS_SCHED) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SCHED_SETATTR);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SCHED_SETSCHEDULER);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SETPRIORITY);
  }

  // ── #1870: Rechtewechsel ───────────────────────────────────────────────
  //
  // Die Klasse, bei der die fehlende Schreibweise am meisten wog: ein Dienst,
  // der Rechte ABGIBT (setuid auf einen unprivilegierten Nutzer, unshare in
  // einen eigenen Namensraum), ist gerade das gewuenschte Muster — und genau
  // das liess sich nicht deklarieren. Wer es brauchte, baute ohne
  // @capabilities und verlor damit den ganzen Filter.
  if sc_has_cap(capBuf, capCount, SC_CAP_PROCESS_PRIVILEGES) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SETUID);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SETGID);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SETPGID);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_GETPGRP);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SETSID);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_CAPGET);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_CAPSET);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_PIDFD_OPEN);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_PIDFD_SIGNAL);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_PIDFD_GETFD);
  }

  if sc_has_cap(capBuf, capCount, SC_CAP_SYSTEM_NAMESPACE) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_UNSHARE);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SETNS);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_CHROOT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MOUNT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_UMOUNT2);
  }

  // reboot und sethostname gehoeren in KEINE der beiden anderen: sie geben
  // keine Rechte ab und stellen keinen Namensraum her, sie veraendern die
  // Maschine. Ein eigener Name, der im Manifest sofort auffaellt.
  if sc_has_cap(capBuf, capCount, SC_CAP_SYSTEM_ADMIN) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_REBOOT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SETHOSTNAME);
  }

  // ── #1871: IPC ─────────────────────────────────────────────────────────
  //
  // Getrennt von memory.mmap: gemeinsamer Speicher ZWISCHEN PROZESSEN ist
  // eine andere Zusage als eine anonyme Abbildung im eigenen Adressraum.
  if sc_has_cap(capBuf, capCount, SC_CAP_IPC_SHM) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SHMGET);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SHMAT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SHMDT);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SHMCTL);
  }

  if sc_has_cap(capBuf, capCount, SC_CAP_IPC_QUEUE) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MSGGET);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MSGSND);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MSGRCV);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MSGCTL);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MQ_OPEN);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MQ_UNLINK);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MQ_TSEND);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MQ_TRECV);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MQ_GETSETATTR);
  }

  if sc_has_cap(capBuf, capCount, SC_CAP_IPC_SEM) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SEMGET);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SEMOP);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SEMCTL);
  }

  // ── #1872: Dateisystem-Einzelstuecke ───────────────────────────────────
  if sc_has_cap(capBuf, capCount, SC_CAP_FS_XATTR) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_GETXATTR);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_FGETXATTR);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SETXATTR);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_FSETXATTR);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_LISTXATTR);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_FLISTXATTR);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_REMOVEXATTR);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_FREMOVEXATTR);
  }

  if sc_has_cap(capBuf, capCount, SC_CAP_FS_WATCH) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_INOTIFY_INIT1);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_INOTIFY_ADD);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_INOTIFY_RM);
  }

  // `getcwd` ist erlaubt, `chdir` war es nicht: man durfte fragen, wo man
  // ist, aber nicht woanders hingehen.
  if sc_has_cap(capBuf, capCount, SC_CAP_FS_CWD) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_CHDIR);
  }

  // ── #1872: Beobachtung ─────────────────────────────────────────────────
  //
  // Diese vier gehoeren ausdruecklich an EIGENE Namen: ptrace liest fremde
  // Prozesse, bpf laedt Code in den Kernel. An eine bestehende Capability
  // gehaengt waeren sie unsichtbar.
  if sc_has_cap(capBuf, capCount, SC_CAP_DEBUG_TRACE) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_PTRACE);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_PERF_EVENT);
  }

  if sc_has_cap(capBuf, capCount, SC_CAP_KERNEL_BPF) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_BPF);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_IOURING_SETUP);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_IOURING_ENTER);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_IOURING_REG);
  }

  // ── #1872: Erweiterungen an bestehenden Rechten ────────────────────────
  //
  // Diese Aufrufe tun nichts, was das jeweilige Recht nicht ohnehin erlaubt —
  // sie sind andere Schreibweisen desselben Zugriffs. `readv` ist ein `read`
  // mit mehreren Puffern, `sendfile` ein Kopieren ohne Umweg durch den
  // Nutzerraum.
  if hasRead {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_READV);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SENDFILE);
  }
  if hasWrite {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_WRITEV);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_FALLOCATE);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SYNC);
  }
  if sc_has_cap(capBuf, capCount, SC_CAP_FS_META) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_STATFS);
  }
  if sc_has_cap(capBuf, capCount, SC_CAP_FS_CREATE) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MEMFD_CREATE);
  }
  // `madvise` ist der Hinweis an den Kernel, den grosse Puffer verlangen;
  // `mremap` die einzige Moeglichkeit, eine Abbildung zu vergroessern, ohne
  // neu abzubilden und zu kopieren.
  if sc_has_cap(capBuf, capCount, SC_CAP_MEMORY_MMAP) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MREMAP);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MADVISE);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MSYNC);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MINCORE);
  }
  if sc_has_cap(capBuf, capCount, SC_CAP_MEMORY_LOCK) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_MUNLOCK);
  }

  // ── #1875: hardware.block gab auf Linux GAR NICHTS frei ────────────────
  //
  // Rohzugriff auf ein Blockgeraet heisst `ioctl` — und das wurde nur unter
  // den vier hardware.*-Rechten freigegeben, zu denen `hardware.block` nicht
  // zaehlte. Die Capability war deklarierbar und wirkungslos.
  //
  // Hier mit Argumentfilter auf die drei Kommandos, die ein Blockgeraet
  // abfragen — nicht der ganze ioctl-Vorrat.
  if sc_has_cap(capBuf, capCount, SC_CAP_HARDWARE_BLOCK) {
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_IOCTL, SC_BLKGETSIZE64);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_IOCTL, SC_BLKSSZGET);
    n := sc_allow_nr_arg1(bpfBuf, n, SC_SYS_IOCTL, SC_HDIO_GETGEO);
  }

  // ── #1872: der Rest der Aufzaehlung ────────────────────────────────────
  //
  // Diese Aufrufe brauchen keinen NEUEN Namen — sie gehoeren erkennbar zu
  // einem Recht, das es schon gibt, und wurden dort nur nie eingetragen.
  if sc_has_cap(capBuf, capCount, SC_CAP_PROCESS_SIGNAL) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_RT_SIGPROCMASK);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SIGALTSTACK);
  }
  if sc_has_cap(capBuf, capCount, SC_CAP_PROCESS_SCHED) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SCHED_YIELD);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_GETPRIORITY);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SCHED_SETAFF);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SCHED_GETAFF);
  }
  if sc_has_cap(capBuf, capCount, SC_CAP_PROCESS_FORK) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_WAIT4);
  }
  if sc_has_cap(capBuf, capCount, SC_CAP_IO_WAIT) {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_EPOLL_PWAIT2);
  }
  // socketpair und shutdown gehoeren zu jedem Sockel; recvmmsg/sendmmsg sind
  // recvmsg/sendmsg mit mehreren Nachrichten auf einmal.
  if hasTcpConn || hasUdpConn || hasTcpBind || hasUdpBind || hasUnix {
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SHUTDOWN);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SOCKETPAIR);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_RECVMMSG);
    n := sc_allow_nr(bpfBuf, n, SC_SYS_SENDMMSG);
  }

  var hasHw: bool := sc_has_cap(capBuf, capCount, SC_CAP_HARDWARE_GPIO) ||
                     sc_has_cap(capBuf, capCount, SC_CAP_HARDWARE_I2C)  ||
                     sc_has_cap(capBuf, capCount, SC_CAP_HARDWARE_SPI)  ||
                     sc_has_cap(capBuf, capCount, SC_CAP_HARDWARE_USB);
  if hasHw {
    // #1867: Hier steht ioctl weiterhin OHNE Argumentfilter — ein
    // GPIO-Programm bekommt damit auch Terminal-, Netz- und
    // Blockgeraet-ioctls. Das ist zu weit und in #1867 benannt; eingegrenzt
    // wird es erst, wenn die Kommandolisten je Hardware-Klasse erhoben sind.
    // Was dieses Issue loest, ist die andere Richtung: Terminalarbeit braucht
    // hardware.gpio nicht mehr, dafuer gibt es system.tty.
    n := sc_allow_nr(bpfBuf, n, SC_SYS_IOCTL);
  }

  // ---- Standard-Aktion: Kill ----------------------------------------
  sc_emit(bpfBuf, n, SC_RET_K, 0, 0, sc_deny()); n := n + 1;

  return n;
}
