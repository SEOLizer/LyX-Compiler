// ===========================================================================
// WP-7: Path-Traversal-Schutz
// ===========================================================================
// Wird von sema.lyx (via ffi_validator) und codegen_x86.lyx importiert.
// Verhindert ".." als Pfadkomponente in import-Pfaden.

// Gibt true zurück wenn path eine ".." Komponente enthält.
// Prüft jede durch "/" getrennte Komponente.
pub fn path_has_traversal(path: pchar): bool {
  var i:        int64 := 0;
  var segStart: int64 := 0;
  while (StrCharAt(path, i) & 255) != 0 {
    if (StrCharAt(path, i) & 255) == 47 {  // '/'
      var segLen: int64 := i - segStart;
      if segLen == 2 {
        if (StrCharAt(path, segStart) & 255) == 46 && (StrCharAt(path, segStart + 1) & 255) == 46 {
          return true;
        }
      }
      segStart := i + 1;
    }
    i := i + 1;
  }
  // Letzte Komponente (kein abschliessender '/')
  var segLen: int64 := i - segStart;
  if segLen == 2 {
    if (StrCharAt(path, segStart) & 255) == 46 && (StrCharAt(path, segStart + 1) & 255) == 46 {
      return true;
    }
  }
  return false;
}
