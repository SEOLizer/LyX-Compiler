// ============================================================================
// Memory layout notes:
//
// Token entry (40 bytes each):
//   +0:  kind  (int64)
//   +8:  start (int64) -- byte offset in source
//   +16: len   (int64)
//   +24: iVal  (int64)
//   +32: line  (int64)
//
// Node entry (80 bytes each):
//   +0:  kind   (int64)
//   +8:  child0 (int64, node idx or -1)
//   +16: child1 (int64)
//   +24: child2 (int64)
//   +32: child3 (int64)
//   +40: next   (int64, sibling list)
//   +48: tokIdx (int64)
//   +56: iVal   (int64, op / literal value / flags)
//   +64: sOff   (int64, byte offset into src for name/sval)
//   +72: sLen   (int64)
//   -- also: isPub packed into high bit of iVal (bit 62) to save space --
//   Actually: keep isPub separate at +80? Makes 88 bytes.
//   Use +80: isPub (int64) -- 88 bytes total
// ============================================================================

pub con PARSER_TOK_SIZE:  int64 := 40;
pub con PARSER_NODE_SIZE: int64 := 88;

// ============================================================================
// Annotation flags (WP-AND-02 Phase B)
// Stored as a bitfield in the iVal slot of NK_FUNC_DECL nodes.
// iVal is otherwise unused for FUNC_DECL, so this is non-invasive.
// ============================================================================
pub con ANNO_EXPORT:    int64 := 1;   // @export — export from shared library
pub con ANNO_JNI:       int64 := 2;   // @jni    — JNI mangling (reserved, Phase B2)
// Bits 2..63 reserved for future annotations (@dal, @critical, @wcet, ...).

// ============================================================================
// Parser Class
// (No Lexer field -- Lexer is created locally in Init() and disposed after
//  tokenization, avoiding class-typed field layout issues.)
// ============================================================================

pub type Parser = class {
  src:    pchar;   // source text pointer
  srcLen: int64;

  // Token array (raw int64 buffer allocated via mmap)
  toks:     int64;
  tokCount: int64;
  tokCap:   int64;

  // Node pool (raw int64 buffer allocated via mmap)
  nodes:     int64;
  nodeCount: int64;
  nodeCap:   int64;

  // Token cursor
  cur: int64;

  // Error state
  hadError: int64;

  // WP-AND-02 Phase B2: side table for @jni(class="...", method="...") args.
  // Records are 40 bytes: [funcNodeId:i64, classOff:i64, classLen:i64, methodOff:i64, methodLen:i64].
  // Offsets are into self.src. Populated by ParseJniArgs, queried by lyxc.lyx.
  jniBuf:   int64;
  jniCap:   int64;
  jniCount: int64;
  // Scratch values held between @jni parsing and attach to the next FUNC_DECL.
  _pendingJniClassOff:  int64;
  _pendingJniClassLen:  int64;
  _pendingJniMethodOff: int64;
  _pendingJniMethodLen: int64;

  // ------------------------------------------------------------------
  // Token array helpers
  // ------------------------------------------------------------------

  fn _toff(i: int64): int64 { return self.toks + i * PARSER_TOK_SIZE; }

  fn TokKind(i: int64): int64  { return peek64(self._toff(i)); }
  fn TokStart(i: int64): int64 { return peek64(self._toff(i) + 8); }
  fn TokLen(i: int64): int64   { return peek64(self._toff(i) + 16); }
  fn TokIVal(i: int64): int64  { return peek64(self._toff(i) + 24); }
  fn TokLine(i: int64): int64  { return peek64(self._toff(i) + 32); }

  fn _pushTok(kind: int64, start: int64, len: int64, iVal: int64, line: int64) {
    if (self.tokCount >= self.tokCap) {
      var newCap: int64 := self.tokCap * 2;
      var nb: int64 := mmap(0, newCap * PARSER_TOK_SIZE, 3, 34, -1, 0);
      var i: int64 := 0;
      while (i < self.tokCount * PARSER_TOK_SIZE) {
        poke8(nb + i, peek8(self.toks + i));
        i := i + 1;
      }
      self.toks   := nb;
      self.tokCap := newCap;
    }
    var off: int64 := self._toff(self.tokCount);
    poke64(off,      kind);
    poke64(off + 8,  start);
    poke64(off + 16, len);
    poke64(off + 24, iVal);
    poke64(off + 32, line);
    self.tokCount := self.tokCount + 1;
  }

  // ------------------------------------------------------------------
  // Node pool helpers
  // ------------------------------------------------------------------

  fn _noff(i: int64): int64 { return self.nodes + i * PARSER_NODE_SIZE; }

  fn NKind(i: int64): int64   { return peek64(self._noff(i)); }
  fn NChild0(i: int64): int64 { return peek64(self._noff(i) + 8); }
  fn NChild1(i: int64): int64 { return peek64(self._noff(i) + 16); }
  fn NChild2(i: int64): int64 { return peek64(self._noff(i) + 24); }
  fn NChild3(i: int64): int64 { return peek64(self._noff(i) + 32); }
  fn NNext(i: int64): int64   { return peek64(self._noff(i) + 40); }
  fn NTokIdx(i: int64): int64 { return peek64(self._noff(i) + 48); }
  fn NIVal(i: int64): int64   { return peek64(self._noff(i) + 56); }
  // NSVal returns pointer into src buffer (src + stored offset)
  fn NSVal(i: int64): pchar   { return self.src + peek64(self._noff(i) + 64); }
  fn NSLen(i: int64): int64   { return peek64(self._noff(i) + 72); }
  fn NIsPub(i: int64): int64  { return peek64(self._noff(i) + 80); }

  // WP-AND-02 Phase B: query annotation flags on a node (iVal slot).
  pub fn NAnnoFlags(i: int64): int64 { return peek64(self._noff(i) + 56); }
  pub fn NHasAnno(i: int64, flag: int64): int64 {
    if (peek64(self._noff(i) + 56) & flag) != 0 { return 1; }
    return 0;
  }

  fn _sc0(i: int64, v: int64) { poke64(self._noff(i) + 8,  v); }
  fn _sc1(i: int64, v: int64) { poke64(self._noff(i) + 16, v); }
  fn _sc2(i: int64, v: int64) { poke64(self._noff(i) + 24, v); }
  fn _sc3(i: int64, v: int64) { poke64(self._noff(i) + 32, v); }
  fn _sn(i: int64, v: int64)  { poke64(self._noff(i) + 40, v); }
  fn _siv(i: int64, v: int64) { poke64(self._noff(i) + 56, v); }
  // _ssv stores offset into src (not a pointer) + length
  fn _ssv(i: int64, off: int64, len: int64) {
    poke64(self._noff(i) + 64, off);
    poke64(self._noff(i) + 72, len);
  }
  fn _spub(i: int64, v: int64) { poke64(self._noff(i) + 80, v); }

  fn _alloc(kind: int64, tokIdx: int64): int64 {
    if (self.nodeCount >= self.nodeCap) {
      var newCap: int64 := self.nodeCap * 2;
      var nb: int64 := mmap(0, newCap * PARSER_NODE_SIZE, 3, 34, -1, 0);
      var i: int64 := 0;
      while (i < self.nodeCount * PARSER_NODE_SIZE) {
        poke8(nb + i, peek8(self.nodes + i));
        i := i + 1;
      }
      self.nodes   := nb;
      self.nodeCap := newCap;
    }
    var idx: int64 := self.nodeCount;
    var off: int64 := self._noff(idx);
    poke64(off,      kind);
    poke64(off + 8,  -1);
    poke64(off + 16, -1);
    poke64(off + 24, -1);
    poke64(off + 32, -1);
    poke64(off + 40, -1);
    poke64(off + 48, tokIdx);
    poke64(off + 56, 0);
    poke64(off + 64, 0);
    poke64(off + 72, 0);
    poke64(off + 80, 0);
    self.nodeCount := self.nodeCount + 1;
    return idx;
  }

  // ------------------------------------------------------------------
  // Tokenize (using a locally-created Lexer)
  // ------------------------------------------------------------------

  fn _tokenize() {
    var lx: Lexer := new Lexer();
    // Save to locals first to avoid rdi-clobber when passing self.field as args
    var _psrc: pchar := self.src;
    var _psrcLen: int64 := self.srcLen;
    lx.Init(_psrc, _psrcLen);
    var line: int64 := lx.line;
    var k: int64 := lx.Next();
    while (k != TK_EOF) {
      // Save lx field reads to locals before passing as multiple args
      var _ts: int64 := lx.tokStart;
      var _tl: int64 := lx.tokLen;
      var _tv: int64 := lx.tokIVal;
      self._pushTok(k, _ts, _tl, _tv, line);
      line := lx.line;
      k := lx.Next();
    }
    self._pushTok(TK_EOF, 0, 0, 0, line);
    dispose lx;
  }

  // ------------------------------------------------------------------
  // Cursor helpers
  // ------------------------------------------------------------------

  fn Peek(): int64 { return self.TokKind(self.cur); }
  fn Peek2(): int64 { return self.TokKind(self.cur + 1); }
  fn Peek3(): int64 { return self.TokKind(self.cur + 2); }

  fn Advance(): int64 {
    var k: int64 := self.TokKind(self.cur);
    if (k != TK_EOF) { self.cur := self.cur + 1; }
    return k;
  }

  fn Check(k: int64): int64 {
    if (self.Peek() == k) { return 1; }
    return 0;
  }

  fn Match(k: int64): int64 {
    if (self.Peek() == k) { self.Advance(); return 1; }
    return 0;
  }

  fn Expect(k: int64): int64 {
    if (self.Peek() == k) {
      var idx: int64 := self.cur;
      self.Advance();
      return idx;
    }
    if (self.hadError == 0) {
      self.hadError := 1;
      PrintStr("Parse error at line ");
      PrintInt(self.TokLine(self.cur));
      PrintStr(": expected token ");
      PrintInt(k);
      PrintStr(", got ");
      PrintInt(self.Peek());
      PrintStr("\n");
    }
    // Always advance past the unexpected token — prevents infinite loops in
    // while-loops that call Expect but only exit on TK_RBRACE/TK_EOF.
    if (self.Peek() != 0) { self.Advance(); }
    return self.cur;
  }

  fn _err(msg: pchar) {
    if (self.hadError != 0) { return; }
    self.hadError := 1;
    PrintStr("Parse error at line ");
    PrintInt(self.TokLine(self.cur));
    PrintStr(": ");
    PrintStr(msg);
    PrintStr("\n");
  }

  // Token text: offset and length within src
  fn _tokOff(i: int64): int64 { return self.TokStart(i); }
  fn _tokLen(i: int64): int64 { return self.TokLen(i); }

  // WP-AND-02 Phase B: compare token text against a c-string. Returns 1 on match.
  fn _tokTextEq(i: int64, s: pchar): int64 {
    var off: int64 := self._tokOff(i);
    var len: int64 := self._tokLen(i);
    var j: int64 := 0;
    while j < len {
      if peek8(self.src + off + j) != peek8(s + j) { return 0; }
      j := j + 1;
    }
    if peek8(s + len) != 0 { return 0; }
    return 1;
  }

  // WP-AND-02 Phase B: map an annotation identifier (after '@') to its flag bit.
  // Unknown annotations return 0 (effectively ignored, preserves WP-BC-54 leniency).
  fn _annoNameToFlag(tokIdx: int64): int64 {
    if self._tokTextEq(tokIdx, "export"c) != 0 { return ANNO_EXPORT; }
    if self._tokTextEq(tokIdx, "jni"c)    != 0 { return ANNO_JNI; }
    return 0;
  }

  // WP-AND-02 Phase B2: parse @jni(class="...", method="...") arguments.
  // Records found values into the parser's _pendingJni* scratch fields.
  // Tolerant to unrecognized keys (skipped) and to missing args (no-op).
  fn _parseJniArgs() {
    if (self.Match(TK_LPAREN) == 0) { return; }
    // Note: we match key tokens by TEXT, not by kind, because "class" and
    // "method" are reserved keywords in Lyx (TK_CLASS / not-an-ident), but
    // inside an annotation arg list we want them to act as plain names.
    while (self.Check(TK_RPAREN) == 0 && self.Peek() != TK_EOF) {
      var keyTok:   int64 := self.cur;
      var isClass:  int64 := self._tokTextEq(keyTok, "class"c);
      var isMethod: int64 := self._tokTextEq(keyTok, "method"c);
      if isClass != 0 || isMethod != 0 {
        self.Advance();
        if self.Match(TK_EQ1) != 0 {
          if self.Check(TK_STRING) != 0 {
            var strTok: int64 := self.cur;
            self.Advance();
            // Strip surrounding quotes (and an optional trailing 'c' pchar suffix).
            var rawOff: int64 := self._tokOff(strTok);
            var rawLen: int64 := self._tokLen(strTok);
            var trim:   int64 := 2;
            if peek8(self.src + rawOff + rawLen - 1) == 99 { trim := 3; }
            var sOff: int64 := rawOff + 1;
            var sLen: int64 := rawLen - trim;
            if isClass != 0 {
              self._pendingJniClassOff := sOff;
              self._pendingJniClassLen := sLen;
            } else {
              self._pendingJniMethodOff := sOff;
              self._pendingJniMethodLen := sLen;
            }
          }
        }
      } else {
        // Unknown key; skip a single token to make progress.
        self.Advance();
      }
      self.Match(TK_COMMA);
    }
    self.Match(TK_RPAREN);
  }

  // ------------------------------------------------------------------
  // Init / Free
  // ------------------------------------------------------------------

  fn Init(s: pchar, n: int64) {
    self.src    := s;
    self.srcLen := n;

    self.tokCap   := 2048;
    self.toks     := mmap(0, self.tokCap * PARSER_TOK_SIZE, 3, 34, -1, 0);
    self.tokCount := 0;

    self.nodeCap   := 8192;
    self.nodes     := mmap(0, self.nodeCap * PARSER_NODE_SIZE, 3, 34, -1, 0);
    self.nodeCount := 0;

    self.cur      := 0;
    self.hadError := 0;

    // WP-AND-02 Phase B2: JNI side-table init (initially small).
    self.jniCap   := 16;
    self.jniBuf   := mmap(0, self.jniCap * 40, 3, 34, -1, 0);
    self.jniCount := 0;
    self._pendingJniClassOff  := 0;
    self._pendingJniClassLen  := 0;
    self._pendingJniMethodOff := 0;
    self._pendingJniMethodLen := 0;

    self._tokenize();
  }

  // WP-AND-02 Phase B2: append a record to the JNI side-table.
  fn _pushJniEntry(funcNodeId: int64, classOff: int64, classLen: int64, methodOff: int64, methodLen: int64) {
    if (self.jniCount >= self.jniCap) {
      var newCap: int64 := self.jniCap * 2;
      var nb: int64 := mmap(0, newCap * 40, 3, 34, -1, 0);
      var i: int64 := 0;
      while (i < self.jniCount * 40) {
        poke8(nb + i, peek8(self.jniBuf + i));
        i := i + 1;
      }
      self.jniBuf := nb;
      self.jniCap := newCap;
    }
    var off: int64 := self.jniBuf + self.jniCount * 40;
    poke64(off +  0, funcNodeId);
    poke64(off +  8, classOff);
    poke64(off + 16, classLen);
    poke64(off + 24, methodOff);
    poke64(off + 32, methodLen);
    self.jniCount := self.jniCount + 1;
  }

  // WP-AND-02 Phase B2: linear lookup. Returns record pointer, or 0 if absent.
  pub fn FindJniEntry(funcNodeId: int64): int64 {
    var i: int64 := 0;
    while i < self.jniCount {
      var off: int64 := self.jniBuf + i * 40;
      if peek64(off) == funcNodeId { return off; }
      i := i + 1;
    }
    return 0;
  }

  // ==================================================================
  // Type parsing
  // ==================================================================

  // WP-BC-51: apply T[] or T[N] array suffix to a base type node
  fn _parseArrayTypeSuffix(n: int64, ti: int64): int64 {
    if (self.Check(TK_LBRACK) != 0) {
      self.Advance();
      if (self.Check(TK_RBRACK) != 0) {
        self.Advance();
        var an: int64 := self._alloc(NK_TYPE_ARRAY, ti);
        self._sc0(an, n);
        return an;
      } else {
        var sizeExpr: int64 := self.ParseExpr();
        self.Expect(TK_RBRACK);
        var an: int64 := self._alloc(NK_TYPE_ARRAY_FIXED, ti);
        self._sc0(an, n);
        self._sc1(an, sizeExpr);
        return an;
      }
    }
    return n;
  }

  fn ParseType(): int64 {
    var ti: int64 := self.cur;
    // WP-11: Handle extended type keywords (i8, i16, i32, u8, f32, char, etc.)
    if (self.Check(TK_INT8) != 0 || self.Check(TK_INT16) != 0 ||
        self.Check(TK_INT32) != 0 || self.Check(TK_INT64) != 0 ||
        self.Check(TK_UINT8) != 0 || self.Check(TK_UINT16) != 0 ||
        self.Check(TK_UINT32) != 0 || self.Check(TK_UINT64) != 0 ||
        self.Check(TK_F32) != 0 || self.Check(TK_F64) != 0 ||
        self.Check(TK_CHAR_TYPE) != 0) {
      var n: int64 := self._alloc(NK_TYPE_NAME, ti);
      self._ssv(n, self._tokOff(ti), self._tokLen(ti));
      self.Advance();
      return self._parseArrayTypeSuffix(n, ti);
    }
    // NOTE: TK_FN handling removed - it's handled at statement level for function declarations
    if (self.Check(TK_ARRAY) != 0) {
      self.Advance();
      var n: int64 := self._alloc(NK_TYPE_ARRAY, ti);
      // WP-14: Parse generic type arguments: Array<int64>, Map<String, i32>
      if (self.Match(TK_LT) != 0) {
        self._sc0(n, self.ParseType());
        self.Expect(TK_GT);
      }
      return n;
    }
    // WP-BC-56: Map<K,V> and Set<T> type syntax
    if (self.Check(TK_MAP) != 0) {
      self.Advance();
      var n: int64 := self._alloc(NK_TYPE_NAME, ti);
      self._ssv(n, self._tokOff(ti), self._tokLen(ti));  // store "Map"
      if (self.Match(TK_LT) != 0) {
        var kt: int64 := self.ParseType();
        self.Match(TK_COMMA);
        var vt: int64 := self.ParseType();
        self.Expect(TK_GT);
        self._sc0(n, kt);
        self._sc1(n, vt);
      }
      return n;
    }
    if (self.Check(TK_SET) != 0) {
      self.Advance();
      var n: int64 := self._alloc(NK_TYPE_NAME, ti);
      self._ssv(n, self._tokOff(ti), self._tokLen(ti));  // store "Set"
      if (self.Match(TK_LT) != 0) {
        self._sc0(n, self.ParseType());
        self.Expect(TK_GT);
      }
      return n;
    }
    // WP-BC-17: RingBuffer<T> type syntax
    if (self.Check(TK_RINGBUF) != 0) {
      self.Advance();
      var n: int64 := self._alloc(NK_TYPE_RINGBUF, ti);
      if (self.Match(TK_LT) != 0) {
        self._sc0(n, self.ParseType());
        self.Expect(TK_GT);
      }
      return n;
    }
    // WP-BC-18: parallel Array<T> type syntax (accepts both "array" keyword and "Array" ident)
    if (self.Check(TK_PARALLEL) != 0) {
      self.Advance();
      var n: int64 := self._alloc(NK_TYPE_PARALLEL, ti);
      // consume lowercase "array" keyword or uppercase "Array" identifier
      var gotArray: int64 := self.Match(TK_ARRAY);
      if (gotArray == 0 && self.Check(TK_IDENT) != 0) {
        var p: pchar := self.src + self._tokOff(self.cur);
        var l: int64 := self._tokLen(self.cur);
        if (l == 5 && StrCharAt(p,0)==65 && StrCharAt(p,1)==114 && StrCharAt(p,2)==114 && StrCharAt(p,3)==97 && StrCharAt(p,4)==121) {
          self.Advance();  // "Array"
          gotArray := 1;
        }
      }
      if (gotArray != 0) {
        if (self.Match(TK_LT) != 0) {
          self._sc0(n, self.ParseType());
          self.Expect(TK_GT);
        }
        // optionally consume "(size)" in type position: parallel Array<T>(N)
        if (self.Match(TK_LPAREN) != 0) {
          self._sc1(n, self.ParseExpr());
          self.Expect(TK_RPAREN);
        }
      }
      return n;
    }
    // WP-14: Generic type instantiation: Name<T, U>
    // Check if we have an identifier followed by '<' - this is a generic instantiation
    if (self.Check(TK_IDENT) != 0) {
      var nameStart: int64 := self._tokOff(ti);
      var nameLen: int64 := self._tokLen(ti);
      // Look ahead to see if next token is '<'
      // For simplicity, we'll consume the identifier and check on next call
      // Just create a type name node for now
      var n: int64 := self._alloc(NK_TYPE_NAME, ti);
      self._ssv(n, nameStart, nameLen);
      self.Advance();
      // Handle generic arguments: Name<T>
      if (self.Check(TK_LT) != 0) {
        self.Advance();
        var targs: int64 := -1;
        var ttail: int64 := -1;
        if (self.Check(TK_GT) == 0) {
          targs := self.ParseType();
          ttail := targs;
          while (self.Match(TK_COMMA) != 0) {
            var ta: int64 := self.ParseType();
            self._sn(ttail, ta);
            ttail := ta;
          }
        }
        self.Expect(TK_GT);
        // Store type arguments in child1
        self._sc1(n, targs);
      }
      return self._parseArrayTypeSuffix(n, ti);
    }
    var n: int64 := self._alloc(NK_TYPE_NAME, ti);
    self._ssv(n, self._tokOff(ti), self._tokLen(ti));
    self.Advance();
    // WP-BC-14: nullable type suffix — pchar? int64? etc.
    if (self.Check(TK_QUEST) != 0) {
      self.Advance();
      self._siv(n, 1);  // ival=1 marks this type as nullable
    }
    // WP-17: Where clause for type constraints: type X = i32 where x >= 0
    if (self.Check(TK_WHERE) != 0) {
      self.Advance();
      // Parse constraint expression (ident must be 'value' placeholder)
      var wc: int64 := self.ParseExpr();
      var wcn: int64 := self._alloc(NK_WHERE, ti);
      self._sc0(wcn, n);   // base type
      self._sc1(wcn, wc);  // constraint expression
      return wcn;
    }
    return n;
  }

  // WP-13: Parse function type: fn(T1, T2): R
  fn ParseFnType(): int64 {
    var ti: int64 := self.cur;
    self.Advance();  // consume 'fn'
    var n: int64 := self._alloc(NK_FN_PTR, ti);
    // Parse parameter types
    if (self.Match(TK_LPAREN) != 0) {
      var phead: int64 := -1;
      var ptail: int64 := -1;
      if (self.Check(TK_RPAREN) == 0) {
        phead := self.ParseType();
        ptail := phead;
        while (self.Match(TK_COMMA) != 0) {
          var p: int64 := self.ParseType();
          self._sn(ptail, p);
          ptail := p;
        }
      }
      self._sc0(n, phead);  // first param type
      self.Expect(TK_RPAREN);
    }
    // Parse return type
    if (self.Match(TK_COLON) != 0) {
      self._sc1(n, self.ParseType());
    }
    return n;
  }

  // ==================================================================
  // Expression parsing (precedence climbing)
  // ==================================================================

  fn ParseExpr(): int64 { return self.ParsePipe(); }

  // WP-BC-51: pipe operator  expr |> fn  →  fn(expr)
  //           expr |> fn(?, arg)  →  fn(expr, arg)
  fn ParsePipe(): int64 {
    var lhs: int64 := self.ParseNullCoal();
    while (self.Check(TK_PIPE) != 0) {
      var ti: int64 := self.cur;
      self.Advance();
      var nameTok: int64 := self.cur;
      self.Expect(TK_IDENT);
      var call: int64 := self._alloc(NK_CALL, nameTok);
      self._ssv(call, self._tokOff(nameTok), self._tokLen(nameTok));
      self._siv(call, 0);
      if (self.Check(TK_LPAREN) != 0) {
        self.Advance();
        self._sc0(call, self._parsePipeArgList(lhs));
        self.Expect(TK_RPAREN);
      } else {
        self._sc0(call, lhs);
      }
      lhs := call;
    }
    return lhs;
  }

  // Parse arg list where ? is replaced by pipeVal (the piped expression)
  fn _parsePipeArgList(pipeVal: int64): int64 {
    if (self.Check(TK_RPAREN) != 0) { return pipeVal; }
    var head: int64;
    if (self.Check(TK_QUEST) != 0) {
      self.Advance();
      head := pipeVal;
    } else {
      head := self.ParseExpr();
    }
    var tail: int64 := head;
    while (self.Match(TK_COMMA) != 0) {
      var arg: int64;
      if (self.Check(TK_QUEST) != 0) {
        self.Advance();
        arg := pipeVal;
      } else {
        arg := self.ParseExpr();
      }
      self._sn(tail, arg);
      tail := arg;
    }
    return head;
  }

  // WP-BC-14: null coalescing operator x ?? fallback
  fn ParseNullCoal(): int64 {
    var lhs: int64 := self.ParseOr();
    while (self.Check(TK_NULLCL) != 0) {
      var ti: int64 := self.cur; self.Advance();
      var rhs: int64 := self.ParseOr();
      var n: int64 := self._alloc(NK_NULL_COAL, ti);
      self._sc0(n, lhs); self._sc1(n, rhs); lhs := n;
    }
    return lhs;
  }

  fn ParseOr(): int64 {
    var lhs: int64 := self.ParseAnd();
    while (self.Check(TK_OR) != 0) {
      var ti: int64 := self.cur; var op: int64 := self.Advance();
      var rhs: int64 := self.ParseAnd();
      var n: int64 := self._alloc(NK_BINOP, ti);
      self._siv(n, op); self._sc0(n, lhs); self._sc1(n, rhs); lhs := n;
    }
    return lhs;
  }

  fn ParseAnd(): int64 {
    var lhs: int64 := self.ParseEq();
    while (self.Check(TK_AND) != 0) {
      var ti: int64 := self.cur; var op: int64 := self.Advance();
      var rhs: int64 := self.ParseEq();
      var n: int64 := self._alloc(NK_BINOP, ti);
      self._siv(n, op); self._sc0(n, lhs); self._sc1(n, rhs); lhs := n;
    }
    return lhs;
  }

  fn ParseBitOr(): int64 {
    var lhs: int64 := self.ParseBitXor();
    while (self.Check(TK_BITOR) != 0) {
      var ti: int64 := self.cur; var op: int64 := self.Advance();
      var rhs: int64 := self.ParseBitXor();
      var n: int64 := self._alloc(NK_BINOP, ti);
      self._siv(n, op); self._sc0(n, lhs); self._sc1(n, rhs); lhs := n;
    }
    return lhs;
  }

  fn ParseBitXor(): int64 {
    var lhs: int64 := self.ParseBitAnd();
    while (self.Check(TK_BITXOR) != 0) {
      var ti: int64 := self.cur; var op: int64 := self.Advance();
      var rhs: int64 := self.ParseBitAnd();
      var n: int64 := self._alloc(NK_BINOP, ti);
      self._siv(n, op); self._sc0(n, lhs); self._sc1(n, rhs); lhs := n;
    }
    return lhs;
  }

  fn ParseBitAnd(): int64 {
    var lhs: int64 := self.ParseShift();
    while (self.Check(TK_BITAND) != 0) {
      var ti: int64 := self.cur; var op: int64 := self.Advance();
      var rhs: int64 := self.ParseShift();
      var n: int64 := self._alloc(NK_BINOP, ti);
      self._siv(n, op); self._sc0(n, lhs); self._sc1(n, rhs); lhs := n;
    }
    return lhs;
  }

  fn ParseEq(): int64 {
    var lhs: int64 := self.ParseRel();
    while (self.Check(TK_EQ2) != 0 || self.Check(TK_NEQ) != 0) {
      var ti: int64 := self.cur; var op: int64 := self.Advance();
      var rhs: int64 := self.ParseRel();
      var n: int64 := self._alloc(NK_BINOP, ti);
      self._siv(n, op); self._sc0(n, lhs); self._sc1(n, rhs); lhs := n;
    }
    return lhs;
  }

  fn ParseRel(): int64 {
    var lhs: int64 := self.ParseBitOr();
    while (self.Check(TK_LT) != 0 || self.Check(TK_LE) != 0 ||
           self.Check(TK_GT) != 0 || self.Check(TK_GE) != 0 ||
           self.Check(TK_IN) != 0) {
      var ti: int64 := self.cur;
      if (self.Check(TK_IN) != 0) {
        self.Advance();
        var rhs: int64 := self.ParseBitOr();
        var n: int64 := self._alloc(NK_IN_EXPR, ti);
        self._sc0(n, lhs); self._sc1(n, rhs); lhs := n;
      } else {
        var op: int64 := self.Advance();
        var rhs: int64 := self.ParseBitOr();
        var n: int64 := self._alloc(NK_BINOP, ti);
        self._siv(n, op); self._sc0(n, lhs); self._sc1(n, rhs); lhs := n;
      }
    }
    return lhs;
  }

  fn ParseShift(): int64 {
    var lhs: int64 := self.ParseAdd();
    while (self.Check(TK_SHL) != 0 || self.Check(TK_SHR) != 0) {
      var ti: int64 := self.cur; var op: int64 := self.Advance();
      var rhs: int64 := self.ParseAdd();
      var n: int64 := self._alloc(NK_BINOP, ti);
      self._siv(n, op); self._sc0(n, lhs); self._sc1(n, rhs); lhs := n;
    }
    return lhs;
  }

  fn ParseAdd(): int64 {
    var lhs: int64 := self.ParseMul();
    while (self.Check(TK_PLUS) != 0 || self.Check(TK_MINUS) != 0) {
      var ti: int64 := self.cur; var op: int64 := self.Advance();
      var rhs: int64 := self.ParseMul();
      var n: int64 := self._alloc(NK_BINOP, ti);
      self._siv(n, op); self._sc0(n, lhs); self._sc1(n, rhs); lhs := n;
    }
    return lhs;
  }

  fn ParseMul(): int64 {
    var lhs: int64 := self.ParseUnary();
    while (self.Check(TK_STAR) != 0 || self.Check(TK_SLASH) != 0 || self.Check(TK_PERCENT) != 0) {
      var ti: int64 := self.cur; var op: int64 := self.Advance();
      var rhs: int64 := self.ParseUnary();
      var n: int64 := self._alloc(NK_BINOP, ti);
      self._siv(n, op); self._sc0(n, lhs); self._sc1(n, rhs); lhs := n;
    }
    return lhs;
  }

  fn ParseUnary(): int64 {
    if (self.Check(TK_NOT) != 0 || self.Check(TK_BITNOT) != 0 || self.Check(TK_MINUS) != 0) {
      var ti: int64 := self.cur; var op: int64 := self.Advance();
      var n: int64 := self._alloc(NK_UNOP, ti);
      self._siv(n, op);
      self._sc0(n, self.ParseUnary());
      return n;
    }
    if (self.Check(TK_AT) != 0) {
      var ti: int64 := self.cur;
      self.Advance();
      var n: int64 := self._alloc(NK_UNOP, ti);
      self._siv(n, TK_AT);
      self._sc0(n, self.ParsePrimary());
      return n;
    }
    return self.ParsePostfix();
  }

  fn ParsePostfix(): int64 {
    var base: int64 := self.ParsePrimary();
    var stop: int64 := 0;
    while (stop == 0) {
      if (self.Check(TK_DOT) != 0) {
        var ti: int64 := self.cur;
        self.Advance();
        var nameTok: int64 := self.cur;
        self.Expect(TK_IDENT);
        if (self.Check(TK_LPAREN) != 0) {
          self.Advance();
          var n: int64 := self._alloc(NK_CALL, ti);
          self._sc0(n, base);
          self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
          self._siv(n, 1);  // method call flag
          self._sc1(n, self._parseArgList());
          self.Expect(TK_RPAREN);
          base := n;
        } else {
          var n: int64 := self._alloc(NK_FIELD, ti);
          self._sc0(n, base);
          self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
          base := n;
        }
      } else if (self.Check(TK_LBRACK) != 0) {
        var ti: int64 := self.cur;
        self.Advance();
        var idx: int64 := self.ParseExpr();
        self.Expect(TK_RBRACK);
        var n: int64 := self._alloc(NK_INDEX, ti);
        self._sc0(n, base); self._sc1(n, idx);
        base := n;
      } else if (self.Check(TK_AS) != 0) {
        var ti: int64 := self.cur;
        self.Advance();
        // WP-BC-14: as? optional cast vs normal as cast
        if (self.Check(TK_QUEST) != 0) {
          self.Advance();
          var targetType: int64 := self.ParseType();
          var n: int64 := self._alloc(NK_SAFE_CAST, ti);
          self._sc0(n, base); self._sc1(n, targetType);
          base := n;
        } else {
          var targetType: int64 := self.ParseType();
          var n: int64 := self._alloc(NK_CAST, ti);
          self._sc0(n, base);      // source expression
          self._sc1(n, targetType); // target type
          base := n;
        }
      // WP-16: isType operator (x is Type)
      } else if (self.Check(TK_IS) != 0) {
        var ti: int64 := self.cur;
        self.Advance();
        var checkType: int64 := self.ParseType();
        var n: int64 := self._alloc(NK_IS_EXPR, ti);
        self._sc0(n, base);      // source expression
        self._sc1(n, checkType); // type to check
        base := n;
      // WP-17: Range expression (e.g., 1..100)
      } else if (self.Check(TK_RANGE) != 0 && stop == 0) {
        var ti: int64 := self.cur;
        self.Advance();
        var end: int64 := self.ParsePrimary();  // Parse end of range
        var n: int64 := self._alloc(NK_RANGE, ti);
        self._sc0(n, base);   // start of range
        self._sc1(n, end);    // end of range
        base := n;
      // WP-BC-13: format expression expr:width[:decimals] — only when : is followed by INT
      } else if (self.Check(TK_COLON) != 0 && self.TokKind(self.cur + 1) == TK_INT) {
        var ti: int64 := self.cur;
        self.Advance();  // consume ':'
        var n: int64 := self._alloc(NK_FORMAT_EXPR, ti);
        self._sc0(n, base);
        var wn: int64 := self._alloc(NK_LIT_INT, self.cur);
        self._siv(wn, self.TokIVal(self.cur));
        self.Advance();
        self._sc1(n, wn);
        if (self.Check(TK_COLON) != 0 && self.TokKind(self.cur + 1) == TK_INT) {
          self.Advance();  // consume second ':'
          var dn: int64 := self._alloc(NK_LIT_INT, self.cur);
          self._siv(dn, self.TokIVal(self.cur));
          self.Advance();
          self._sc2(n, dn);
        }
        base := n;
      } else {
        stop := 1;
      }
    }
    return base;
  }

  fn ParsePrimary(): int64 {
    var ti: int64 := self.cur;
    var k: int64 := self.Peek();
    if (k == 3) {  // TK_INT=3
      self.Advance();
      var n: int64 := self._alloc(NK_LIT_INT, ti);
      self._siv(n, self.TokIVal(ti));
      return n;
    }
    if (k == 4) {  // TK_FLOAT=4
      self.Advance();
      var n: int64 := self._alloc(NK_LIT_FLOAT, ti);
      self._ssv(n, self._tokOff(ti), self._tokLen(ti));
      return n;
    }
    if (k == 5) {  // TK_STRING=5
      self.Advance();
      var n: int64 := self._alloc(NK_LIT_STR, ti);
      self._ssv(n, self._tokOff(ti), self._tokLen(ti));
      return n;
    }
    if (k == 117) {  // TK_REGEX_LIT=117
      self.Advance();
      var n: int64 := self._alloc(NK_REGEX_LIT, ti);
      self._ssv(n, self._tokOff(ti), self._tokLen(ti));
      return n;
    }
    if (k == 57) {  // TK_PARALLEL=57: parallel Array<T>(size)
      self.Advance();
      var n: int64 := self._alloc(NK_SIMD_NEW, ti);
      // accept both "array" keyword and "Array" identifier
      var gotArr: int64 := self.Match(TK_ARRAY);
      if (gotArr == 0 && self.Check(TK_IDENT) != 0) {
        var ap: pchar := self.src + self._tokOff(self.cur);
        var al: int64 := self._tokLen(self.cur);
        if (al == 5 && StrCharAt(ap,0)==65 && StrCharAt(ap,1)==114 && StrCharAt(ap,2)==114 && StrCharAt(ap,3)==97 && StrCharAt(ap,4)==121) {
          self.Advance();
          gotArr := 1;
        }
      }
      if (gotArr != 0 && self.Match(TK_LT) != 0) {
        self._sc0(n, self.ParseType());
        self.Expect(TK_GT);
      }
      self.Expect(TK_LPAREN);
      self._sc1(n, self.ParseExpr());
      self.Expect(TK_RPAREN);
      return n;
    }
    if (k == 6) {  // TK_CHAR=6
      self.Advance();
      var n: int64 := self._alloc(NK_LIT_CHAR, ti);
      self._siv(n, self.TokIVal(ti));
      return n;
    }
    if (k == 19) {  // TK_TRUE=19
      self.Advance();
      var n: int64 := self._alloc(NK_LIT_BOOL, ti);
      self._siv(n, 1);
      return n;
    }
    if (k == 20) {  // TK_FALSE=20
      self.Advance();
      var n: int64 := self._alloc(NK_LIT_BOOL, ti);
      self._siv(n, 0);
      return n;
    }
    if (k == 21) {  // TK_NULL=21
      self.Advance();
      return self._alloc(NK_LIT_NULL, ti);
    }
    if (k == 51) {  // TK_NEW=51
      self.Advance();
      var nameTok: int64 := self.cur;
      self.Expect(TK_IDENT);
      var n: int64 := self._alloc(NK_NEW, ti);
      self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
      self.Expect(TK_LPAREN);
      self._sc0(n, self._parseArgList());
      self.Expect(TK_RPAREN);
      return n;
    }
    if (k == 100) {  // TK_LPAREN=100
      self.Advance();
      var inner: int64 := self.ParseExpr();
      self.Expect(TK_RPAREN);
      return inner;
    }
    if (k == 2) {  // TK_IDENT=2
      self.Advance();
      // WP-BC-24: generic call Foo<Type>(args)
      // Disambiguate from comparison: require < IDENT > or < IDENT , pattern
      if (self.Check(TK_LT) != 0 && self.Peek2() == TK_IDENT &&
          (self.Peek3() == TK_GT || self.Peek3() == TK_COMMA)) {
        var typeArgsN: int64 := self._parseTypeArgs();
        if (self.Check(100) != 0) {  // TK_LPAREN — it's a generic call
          self.Advance();
          var n: int64 := self._alloc(NK_CALL, ti);
          self._ssv(n, self._tokOff(ti), self._tokLen(ti));
          self._siv(n, 2);  // iVal=2 marks generic call
          self._sc0(n, self._parseArgList());
          self._sc2(n, typeArgsN);  // type args in c2
          self.Expect(101);  // TK_RPAREN
          return n;
        }
        // Not a call — treat type args as a comparison (unusual; fall through)
      }
      if (self.Check(100) != 0) {  // TK_LPAREN=100
        self.Advance();
        var n: int64 := self._alloc(NK_CALL, ti);
        self._ssv(n, self._tokOff(ti), self._tokLen(ti));
        self._siv(n, 0);
        self._sc0(n, self._parseArgList());
        self.Expect(101);  // TK_RPAREN=101
        return n;
      }
      var n: int64 := self._alloc(NK_IDENT, ti);
      self._ssv(n, self._tokOff(ti), self._tokLen(ti));
      return n;
    }

    // WP-BC-06: { ... } map or set literal
    if (k == 102) {  // TK_LBRACE=102
      self.Advance();
      var n: int64 := self._alloc(NK_MAP_LIT, ti);  // assume map until we know otherwise
      if (self.Check(103) != 0) {  // TK_RBRACE=103 — empty map
        self.Advance();
        return n;
      }
      var firstExpr: int64 := self.ParseExpr();
      if (self.Match(106) != 0) {  // TK_COLON=106 → map literal
        var entry: int64 := self._alloc(NK_MAP_ENTRY, ti);
        self._sc0(entry, firstExpr);
        self._sc1(entry, self.ParseExpr());
        self._sc0(n, entry);
        var tail: int64 := entry;
        while (self.Match(TK_COMMA) != 0) {
          if (self.Check(103) != 0) { break; }  // trailing comma
          var ek: int64 := self.ParseExpr();
          self.Expect(106);  // TK_COLON
          var ev: int64 := self.ParseExpr();
          var e: int64 := self._alloc(NK_MAP_ENTRY, self.cur);
          self._sc0(e, ek); self._sc1(e, ev);
          self._sn(tail, e); tail := e;
        }
        self.Expect(103);  // TK_RBRACE
        return n;
      } else {  // set literal
        var sn: int64 := self._alloc(NK_SET_LIT, ti);
        self._sc0(sn, firstExpr);
        var tail: int64 := firstExpr;
        while (self.Match(TK_COMMA) != 0) {
          if (self.Check(103) != 0) { break; }  // trailing comma
          var elem: int64 := self.ParseExpr();
          self._sn(tail, elem); tail := elem;
        }
        self.Expect(103);  // TK_RBRACE
        return sn;
      }
    }

    // WP-BC-51: [e1, e2, ...] array literal
    if (k == TK_LBRACK) {
      self.Advance();
      var n: int64 := self._alloc(NK_ARRAY_LIT, ti);
      if (self.Check(TK_RBRACK) != 0) {
        self.Advance();  // empty array []
        return n;
      }
      var head: int64 := self.ParseExpr();
      var tail: int64 := head;
      while (self.Match(TK_COMMA) != 0) {
        if (self.Check(TK_RBRACK) != 0) { break; }
        var elem: int64 := self.ParseExpr();
        self._sn(tail, elem); tail := elem;
      }
      self.Expect(TK_RBRACK);
      self._sc0(n, head);
      return n;
    }

    self._err("expected expression");
    var dummy: int64 := self._alloc(NK_INVALID, ti);
    if (self.Peek() != 0) { self.Advance(); }  // TK_EOF=0
    return dummy;
  }

  fn _parseArgList(): int64 {
    if (self.Check(TK_RPAREN) != 0) { return -1; }
    var head: int64 := self.ParseExpr();
    var tail: int64 := head;
    while (self.Match(TK_COMMA) != 0) {
      var arg: int64 := self.ParseExpr();
      self._sn(tail, arg);
      tail := arg;
    }
    return head;
  }

  // WP-14: Parse generic type arguments in function call: fn<T, U>(args)
  fn _parseTypeArgs(): int64 {
    self.Advance();  // consume '<'
    var targs: int64 := -1;
    var ttail: int64 := -1;
    if (self.Check(TK_GT) == 0) {
      targs := self.ParseType();
      ttail := targs;
      while (self.Match(TK_COMMA) != 0) {
        var ta: int64 := self.ParseType();
        self._sn(ttail, ta);
        ttail := ta;
      }
    }
    self.Expect(TK_GT);
    return targs;
  }

  // ==================================================================
  // Statement parsing
  // ==================================================================

  fn ParseStmt(): int64 {
    var ti: int64 := self.cur;
    var k: int64 := self.Peek();

    if (k == TK_VAR)    { return self.ParseVarDecl(0); }
    if (k == TK_LET)    { return self.ParseLetDecl(0); }
    if (k == TK_CON)    { return self.ParseConDecl(0); }
    if (k == TK_STATIC) { return self.ParseStaticDecl(0); }  // WP-BC-60
    if (k == TK_RETURN) {
      self.Advance();
      var n: int64 := self._alloc(NK_RETURN, ti);
      if (self.Check(TK_SEMI) == 0 && self.Check(TK_RBRACE) == 0) {
        self._sc0(n, self.ParseExpr());
      }
      self.Match(TK_SEMI);
      return n;
    }
    // WP-CS-03: @if at statement level
    if (k == TK_AT && self.Peek2() == TK_IF) {
      self.Advance();  // consume @
      return self._parseAtIf(0);
    }
    // WP-CS-04: @io_check / @overflow_check at statement level
    if (k == TK_AT && self.Peek2() == TK_IDENT) {
      if (self._tokTextEq(self.cur + 1, "io_check"c) != 0) {
        self.Advance();  // consume @
        return self._parseAtDirective(0);
      }
      if (self._tokTextEq(self.cur + 1, "overflow_check"c) != 0) {
        self.Advance();  // consume @
        return self._parseAtDirective(1);
      }
      // WP-AS-02: @bounds_check / @debug_info / @optimization_level at statement level
      if (self._tokTextEq(self.cur + 1, "bounds_check"c) != 0) {
        self.Advance();  // consume @
        return self._parseAtDirective(AT_DIR_BOUNDS_CHECK);
      }
      if (self._tokTextEq(self.cur + 1, "debug_info"c) != 0) {
        self.Advance();  // consume @
        return self._parseAtDirective(AT_DIR_DEBUG_INFO);
      }
      if (self._tokTextEq(self.cur + 1, "optimization_level"c) != 0) {
        self.Advance();  // consume @
        return self._parseAtDirectiveInt(AT_DIR_OPT_LEVEL);
      }
      // WP-EN-02: @energy(N); at statement level
      if (self._tokTextEq(self.cur + 1, "energy"c) != 0) {
        self.Advance();  // consume @
        return self._parseAtEnergy();
      }
    }
    if (k == TK_IF)     { return self._parseIf(); }
    if (k == TK_WHILE)  { return self._parseWhile(); }
    if (k == TK_FOR)    { return self._parseFor(); }
    if (k == TK_REPEAT) { return self._parseRepeatUntil(); }
    if (k == TK_SWITCH) { return self._parseSwitch(); }
    if (k == TK_BREAK)  {
      self.Advance(); self.Match(TK_SEMI);
      return self._alloc(NK_BREAK, ti);
    }
    if (k == TK_CONTINUE)  {
      self.Advance(); self.Match(TK_SEMI);
      return self._alloc(NK_CONTINUE, ti);
    }
    if (k == TK_DISPOSE) {
      self.Advance();
      var n: int64 := self._alloc(NK_DISPOSE, ti);
      self._sc0(n, self.ParseExpr());
      self.Match(TK_SEMI);
      return n;
    }
    // WP-BC-10: panic(msg)
    if (k == TK_PANIC) {
      self.Advance();
      self.Match(TK_LPAREN);
      var n: int64 := self._alloc(NK_PANIC, ti);
      self._sc0(n, self.ParseExpr());
      self.Match(TK_RPAREN);
      self.Match(TK_SEMI);
      return n;
    }
    // WP-BC-09: pool { stmt* }
    if (k == TK_POOL) {
      self.Advance();
      var n: int64 := self._alloc(NK_POOL, ti);
      self._sc0(n, self.ParseBlock());
      return n;
    }
    // WP-BC-07: assert(cond)
    if (k == TK_ASSERT) {
      self.Advance();
      self.Match(TK_LPAREN);
      var n: int64 := self._alloc(NK_ASSERT, ti);
      self._sc0(n, self.ParseExpr());
      self.Match(TK_RPAREN);
      self.Match(TK_SEMI);
      return n;
    }
    // WP-12: try/catch/finally
    if (k == TK_TRY)   { return self._parseTry(); }
    if (k == TK_THROW) {
      self.Advance();
      var n: int64 := self._alloc(NK_THROW, ti);
      self._sc0(n, self.ParseExpr());
      self.Match(TK_SEMI);
      return n;
    }
    // WP-15: match expression
    if (k == TK_MATCH) { return self._parseMatch(); }
    if (k == TK_LBRACE) { return self.ParseBlock(); }

    var expr: int64 := self.ParseExpr();
    // WP-BC-52: := and = are both valid assignment operators in statement position
    var isAssign: int64 := self.Match(TK_ASSIGN);
    if (isAssign == 0) { isAssign := self.Match(TK_EQ1); }
    if (isAssign != 0) {
      var rhs: int64 := self.ParseExpr();
      self.Match(TK_SEMI);
      var n: int64 := self._alloc(NK_ASSIGN, ti);
      self._sc0(n, expr); self._sc1(n, rhs);
      return n;
    }
    // WP-BC-53: i++ and i-- desugar to i := i + 1 / i := i - 1
    if (self.Match(TK_PLUSPLUS) != 0) {
      self.Match(TK_SEMI);
      var one: int64 := self._alloc(NK_LIT_INT, ti);
      self._siv(one, 1);
      var add: int64 := self._alloc(NK_BINOP, ti);
      self._siv(add, TK_PLUS);
      self._sc0(add, expr); self._sc1(add, one);
      var n: int64 := self._alloc(NK_ASSIGN, ti);
      self._sc0(n, expr); self._sc1(n, add);
      return n;
    }
    if (self.Match(TK_MINMIN) != 0) {
      self.Match(TK_SEMI);
      var one: int64 := self._alloc(NK_LIT_INT, ti);
      self._siv(one, 1);
      var sub: int64 := self._alloc(NK_BINOP, ti);
      self._siv(sub, TK_MINUS);
      self._sc0(sub, expr); self._sc1(sub, one);
      var n: int64 := self._alloc(NK_ASSIGN, ti);
      self._sc0(n, expr); self._sc1(n, sub);
      return n;
    }
    self.Match(TK_SEMI);
    var n: int64 := self._alloc(NK_EXPR_STMT, ti);
    self._sc0(n, expr);
    return n;
  }

  fn _parseIf(): int64 {
    var ti: int64 := self.cur;
    self.Advance();
    var n: int64 := self._alloc(NK_IF, ti);
    // ParseExpr handles both "if cond {" and "if (cond) {" via ParsePrimary
    self._sc0(n, self.ParseExpr());
    self._sc1(n, self.ParseBlock());
    if (self.Match(TK_ELSE) != 0) {
      if (self.Check(TK_IF) != 0) { self._sc2(n, self._parseIf()); }
      else { self._sc2(n, self.ParseBlock()); }
    }
    return n;
  }

  fn _parseWhile(): int64 {
    var ti: int64 := self.cur;
    self.Advance();
    var n: int64 := self._alloc(NK_WHILE, ti);
    // ParseExpr handles both "while cond {" and "while (cond) {" via ParsePrimary
    self._sc0(n, self.ParseExpr());
    self._sc1(n, self.ParseBlock());
    return n;
  }

  fn _parseRepeatUntil(): int64 {
    var ti: int64 := self.cur;
    self.Advance();  // consume 'repeat'
    var n: int64 := self._alloc(NK_REPEAT_UNTIL, ti);
    self._sc0(n, self.ParseBlock());  // body
    self.Expect(TK_UNTIL);
    self._sc1(n, self.ParseExpr());
    self.Match(TK_SEMI);
    return n;
  }

  fn _parseFor(): int64 {
    var ti: int64 := self.cur;
    self.Advance();
    var varTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    self.Expect(TK_ASSIGN);
    var initExpr: int64 := self.ParseExpr();

    // C-style: for i := 0; cond; step [do] { }
    if (self.Check(TK_SEMI) != 0) {
      self.Advance();
      var n: int64 := self._alloc(NK_FOR_C, ti);
      var initNode: int64 := self._alloc(NK_VAR_DECL, ti);
      self._ssv(initNode, self._tokOff(varTok), self._tokLen(varTok));
      self._spub(initNode, 0);
      self._sc1(initNode, initExpr);
      self._sc0(n, initNode);
      if (self.Check(TK_SEMI) == 0) { self._sc1(n, self.ParseExpr()); }
      self.Expect(TK_SEMI);
      if (self.Check(TK_LBRACE) == 0 && self.Check(TK_DO) == 0) {
        self._sc2(n, self.ParseStmt());
      }
      self.Match(TK_DO);
      self._sc3(n, self.ParseBlock());
      return n;
    }

    // Range-based: for i := start to/downto end [do] { }
    var n: int64 := self._alloc(NK_FOR, ti);
    self._ssv(n, self._tokOff(varTok), self._tokLen(varTok));
    self._sc0(n, initExpr);
    var dir: int64 := 0;
    if (self.Match(TK_DOWNTO) != 0) { dir := 1; } else { self.Expect(TK_TO); }
    self._siv(n, dir);
    self._sc1(n, self.ParseExpr());
    self.Match(TK_DO);
    self._sc2(n, self.ParseBlock());
    return n;
  }

  fn _parseSwitch(): int64 {
    var ti: int64 := self.cur;
    self.Advance();
    var n: int64 := self._alloc(NK_SWITCH, ti);
    self.Expect(TK_LPAREN);
    self._sc0(n, self.ParseExpr());
    self.Expect(TK_RPAREN);
    self.Expect(TK_LBRACE);
    var head: int64 := -1;
    var tail: int64 := -1;
    while (self.Check(TK_RBRACE) == 0 && self.Check(TK_EOF) == 0) {
      var cti: int64 := self.cur;
      var isDefault: int64 := 0;
      if (self.Match(TK_CASE) != 0) {
        isDefault := 0;
      } else if (self.Match(TK_DEFAULT) != 0) {
        isDefault := 1;
      } else {
        self._err("expected case or default");
        self.Advance();
      }
      var cn: int64 := self._alloc(NK_CASE, cti);
      self._siv(cn, isDefault);
      if (isDefault == 0) { self._sc0(cn, self.ParseExpr()); }
      self.Expect(TK_COLON);
      self._sc1(cn, self.ParseBlock());
      if (head == -1) { head := cn; tail := cn; }
      else { self._sn(tail, cn); tail := cn; }
    }
    self.Expect(TK_RBRACE);
    self._sc1(n, head);
    return n;
  }

  fn ParseBlock(): int64 {
    var ti: int64 := self.cur;
    self.Expect(TK_LBRACE);
    var n: int64 := self._alloc(NK_BLOCK, ti);
    var head: int64 := -1;
    var tail: int64 := -1;
    while (self.Check(TK_RBRACE) == 0 && self.Check(TK_EOF) == 0) {
      // WP-13: Allow nested function declarations inside blocks
      if (self.Check(TK_FN) != 0) {
        var fnode: int64 := self.ParseNestedFunc();
        if (fnode >= 0) {
          if (head == -1) { head := fnode; tail := fnode; }
          else { self._sn(tail, fnode); tail := fnode; }
        }
      } else {
        var stmt: int64 := self.ParseStmt();
        if (head == -1) { head := stmt; tail := stmt; }
        else { self._sn(tail, stmt); tail := stmt; }
      }
    }
    self.Expect(TK_RBRACE);
    self._sc0(n, head);
    return n;
  }

  // WP-13: Parse nested function inside a block
  fn ParseNestedFunc(): int64 {
    var ti: int64 := self.cur;
    self.Advance();
    var nameTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    var n: int64 := self._alloc(NK_FUNC_DECL, ti);
    self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
    self._spub(n, 0);  // not public by default
    self.Expect(TK_LPAREN);
    self._sc0(n, self._parseParamList());
    self.Expect(TK_RPAREN);
    if (self.Match(TK_COLON) != 0) { self._sc1(n, self.ParseType()); }
    self._sc2(n, self.ParseBlock());
    return n;
  }

  // WP-12: try/catch/finally parsing
  fn _parseTry(): int64 {
    var ti: int64 := self.cur;
    self.Advance();
    var n: int64 := self._alloc(NK_TRY, ti);
    // Parse try block
    self._sc0(n, self.ParseBlock());
    // Parse catch clauses
    var catchHead: int64 := -1;
    var catchTail: int64 := -1;
    while (self.Check(TK_CATCH) != 0) {
      var cti: int64 := self.cur;
      self.Advance();
      // WP-12: Optional parentheses for catch clause
      if (self.Check(TK_LPAREN) != 0) {
        self.Advance();
        // Optional: catch (ExceptionType) - currently just consumes type name
        if (self.Check(TK_IDENT) != 0) { self.Advance(); }
        self.Expect(TK_RPAREN);
      }
      var cn: int64 := self._alloc(NK_CATCH, cti);
      self._sc0(cn, self.ParseBlock());
      if (catchHead == -1) { catchHead := cn; catchTail := cn; }
      else { self._sn(catchTail, cn); catchTail := cn; }
    }
    self._sc1(n, catchHead);
    // Parse finally block (optional)
    if (self.Check(TK_FINALLY) != 0) {
      self.Advance();
      self._sc2(n, self.ParseBlock());
    }
    return n;
  }

  // WP-15: match expression parsing
  fn _parseMatch(): int64 {
    var ti: int64 := self.cur;
    self.Advance();  // consume 'match'
    var n: int64 := self._alloc(NK_MATCH, ti);
    // Optional parentheses
    if (self.Check(TK_LPAREN) != 0) {
      self.Advance();
      self._sc0(n, self.ParseExpr());
      self.Expect(TK_RPAREN);
    } else {
      self._sc0(n, self.ParseExpr());
    }
    self.Expect(TK_LBRACE);
    // Parse match cases
    var caseHead: int64 := -1;
    var caseTail: int64 := -1;
    while (self.Check(TK_RBRACE) == 0 && self.Check(TK_EOF) == 0) {
      var cti: int64 := self.cur;
      self.Expect(TK_CASE);
      // Parse pattern
      var pat: int64 := -1;
      // Check for wildcard (simplified - just use identifier)
      if (self.Check(TK_UNDER) != 0) {
        self.Advance();
        pat := self._alloc(NK_PATTERN_WILD, cti);
      } else if (self.Check(TK_INT) != 0) {
        // Integer literal pattern
        pat := self._alloc(NK_PATTERN_LIT, cti);
        self._siv(pat, self.TokIVal(self.cur));
        self.Advance();
      } else if (self.Check(TK_IDENT) != 0) {
        // Check for enum payload pattern: IDENT(IDENT)
        var identStart: int64 := self._tokOff(self.cur);
        var identLen: int64 := self._tokLen(self.cur);
        self.Advance();
        
        // Check if followed by '(' for enum payload or struct destructure
        if (self.Check(TK_LPAREN) != 0) {
          // WP-15: Enum payload pattern like Ok(v) or Result::Err(e)
          self.Advance();
          pat := self._alloc(NK_PATTERN_ENUM, cti);
          self._ssv(pat, identStart, identLen);  // enum variant name
          // Parse inner pattern (variable name)
          if (self.Check(TK_IDENT) != 0) {
            var innerPat: int64 := self._alloc(NK_PATTERN_BIND, cti);
            self._ssv(innerPat, self._tokOff(self.cur), self._tokLen(self.cur));
            self._sc0(pat, innerPat);  // store binding pattern
            self.Advance();
          }
          self.Expect(TK_RPAREN);
        } else if (self.Check(TK_LBRACE) != 0) {
          // WP-15: Struct destructure pattern { field: pattern, ... }
          self.Advance();
          pat := self._alloc(NK_PATTERN_STRUCT, cti);
          self._ssv(pat, identStart, identLen);  // struct type name
          // Parse field patterns: { field1: pat1, field2: pat2 }
          var fhead: int64 := -1;
          var ftail: int64 := -1;
          while (self.Check(TK_RBRACE) == 0 && self.Check(TK_EOF) == 0) {
            if (self.Check(TK_IDENT) != 0) {
              var fname: int64 := self._tokOff(self.cur);
              var flen: int64 := self._tokLen(self.cur);
              self.Advance();
              self.Expect(TK_COLON);
              var fpat: int64 := self.ParseExpr();  // simple pattern for now
              // Create field pattern node
              var fpatNode: int64 := self._alloc(NK_PATTERN_BIND, cti);
              self._ssv(fpatNode, fname, flen);  // field name
              self._sc0(fpatNode, fpat);  // inner pattern
              if (fhead == -1) { fhead := fpatNode; ftail := fpatNode; }
              else { self._sn(ftail, fpatNode); ftail := fpatNode; }
            }
            if (self.Match(TK_COMMA) != 0) { continue; }
            if (self.Check(TK_RBRACE) != 0) { break; }
          }
          self._sc0(pat, fhead);  // first field pattern
          self.Expect(TK_RBRACE);
        } else {
          // Regular identifier pattern
          pat := self._alloc(NK_PATTERN_LIT, cti);
          self._ssv(pat, identStart, identLen);
        }
      } else {
        // Default pattern
        pat := self._alloc(NK_PATTERN_WILD, cti);
      }
      // WP-BC-11: or-patterns — case p1 | p2 | p3 => body
      while (self.Check(TK_BITOR) != 0) {
        self.Advance();
        var rhs: int64 := -1;
        if (self.Check(TK_UNDER) != 0) {
          self.Advance(); rhs := self._alloc(NK_PATTERN_WILD, cti);
        } else if (self.Check(TK_INT) != 0) {
          rhs := self._alloc(NK_PATTERN_LIT, cti);
          self._siv(rhs, self.TokIVal(self.cur));
          self.Advance();
        } else if (self.Check(TK_IDENT) != 0) {
          rhs := self._alloc(NK_PATTERN_LIT, cti);
          self._ssv(rhs, self._tokOff(self.cur), self._tokLen(self.cur));
          self.Advance();
        } else {
          rhs := self._alloc(NK_PATTERN_WILD, cti);
        }
        var orNode: int64 := self._alloc(NK_PATTERN_OR, cti);
        self._sc0(orNode, pat);  // left
        self._sc1(orNode, rhs);  // right
        pat := orNode;
      }
      // WP-BC-11: pattern guard — case pat if guard => body
      var guard: int64 := -1;
      if (self.Check(TK_IF) != 0) {
        self.Advance();
        guard := self.ParseExpr();
      }
      self.Expect(TK_ARROW);
      var body: int64 := self.ParseExpr();
      self.Match(TK_SEMI);
      // Create match case node
      var cn: int64 := self._alloc(NK_MATCH_CASE, cti);
      self._sc0(cn, pat);    // pattern
      self._sc1(cn, body);   // body expression
      self._sc2(cn, guard);  // guard expression (or -1)
      if (caseHead == -1) { caseHead := cn; caseTail := cn; }
      else { self._sn(caseTail, cn); caseTail := cn; }
    }
    self.Expect(TK_RBRACE);
    self._sc1(n, caseHead);  // cases
    return n;
  }

  // ==================================================================
  // Declarations
  // ==================================================================

  fn ParseVarDecl(isPub: int64): int64 {
    var ti: int64 := self.cur;
    self.Advance();
    var nameTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    // WP-BC-05: detect tuple var decl: var a, b := fn()
    if (self.Check(TK_COMMA) != 0) {
      return self._parseTupleVarDecl(nameTok, ti);
    }
    var n: int64 := self._alloc(NK_VAR_DECL, ti);
    self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
    self._spub(n, isPub);
    if (self.Match(TK_COLON) != 0) { self._sc0(n, self.ParseType()); }
    if (self.Match(TK_ASSIGN) != 0) { self._sc1(n, self.ParseExpr()); }
    else if (self.Match(TK_EQ1) != 0) { self._sc1(n, self.ParseExpr()); }
    self.Match(TK_SEMI);
    return n;
  }

  // WP-BC-60: static x: T = expr — treated as a global/local variable (same AST as var)
  fn ParseStaticDecl(isPub: int64): int64 {
    var ti: int64 := self.cur;
    self.Advance();  // consume 'static'
    var nameTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    var n: int64 := self._alloc(NK_VAR_DECL, ti);
    self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
    self._spub(n, isPub);
    if (self.Match(TK_COLON) != 0) { self._sc0(n, self.ParseType()); }
    if (self.Match(TK_ASSIGN) != 0) { self._sc1(n, self.ParseExpr()); }
    else if (self.Match(TK_EQ1) != 0) { self._sc1(n, self.ParseExpr()); }
    self.Match(TK_SEMI);
    return n;
  }

  // let x: T = expr  or  let x: T := expr  (immutable binding, same AST as var)
  fn ParseLetDecl(isPub: int64): int64 {
    var ti: int64 := self.cur;
    self.Advance();
    var nameTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    if (self.Check(TK_COMMA) != 0) {
      return self._parseTupleVarDecl(nameTok, ti);
    }
    var n: int64 := self._alloc(NK_VAR_DECL, ti);
    self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
    self._spub(n, isPub);
    if (self.Match(TK_COLON) != 0) { self._sc0(n, self.ParseType()); }
    if (self.Match(TK_ASSIGN) != 0) { self._sc1(n, self.ParseExpr()); }
    else if (self.Match(TK_EQ1) != 0) { self._sc1(n, self.ParseExpr()); }
    self.Match(TK_SEMI);
    return n;
  }

  // WP-BC-05: var a, b := fn()  — 2-variable tuple destructure
  // c0 = NK_IDENT node for second name, c1 = init expr (function call)
  fn _parseTupleVarDecl(firstName: int64, ti: int64): int64 {
    var n: int64 := self._alloc(NK_TUPLE_VAR_DECL, ti);
    self._ssv(n, self._tokOff(firstName), self._tokLen(firstName));
    self.Expect(TK_COMMA);
    var secondTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    var second: int64 := self._alloc(NK_IDENT, secondTok);
    self._ssv(second, self._tokOff(secondTok), self._tokLen(secondTok));
    self._sc0(n, second);
    self.Expect(TK_ASSIGN);
    self._sc1(n, self.ParseExpr());
    self.Match(TK_SEMI);
    return n;
  }

  fn ParseConDecl(isPub: int64): int64 {
    var ti: int64 := self.cur;
    self.Advance();
    var nameTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    var n: int64 := self._alloc(NK_CON_DECL, ti);
    self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
    self._spub(n, isPub);
    if (self.Match(TK_COLON) != 0) { self._sc0(n, self.ParseType()); }
    if (self.Match(TK_ASSIGN) != 0) { self._sc1(n, self.ParseExpr()); }
    self.Match(TK_SEMI);
    return n;
  }

  fn _parseParam(): int64 {
    var ti: int64 := self.cur;
    var nameTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    var n: int64 := self._alloc(NK_PARAM, ti);
    self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
    self.Expect(TK_COLON);
    self._sc0(n, self.ParseType());
    return n;
  }

  fn _parseParamList(): int64 {
    if (self.Check(TK_RPAREN) != 0) { return -1; }
    var head: int64 := self._parseParam();
    var tail: int64 := head;
    while (self.Match(TK_COMMA) != 0) {
      var p: int64 := self._parseParam();
      self._sn(tail, p); tail := p;
    }
    return head;
  }

  fn ParseFuncDecl(isPub: int64): int64 {
    var ti: int64 := self.cur;
    self.Advance();
    var nameTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    var n: int64 := self._alloc(NK_FUNC_DECL, ti);
    self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
    self._spub(n, isPub);
    
    // WP-14: Parse optional type parameters: <T, U, ...>
    // WP-BC-23: each type param may carry a constraint: [T: Interface]
    if (self.Check(TK_LT) != 0) {
      self.Advance();
      var tparams: int64 := -1;
      var ttail: int64 := -1;
      if (self.Check(TK_GT) == 0) {
        // First type parameter
        var tp: int64 := self._alloc(NK_TYPE_PARAM, self.cur);
        self._ssv(tp, self._tokOff(self.cur), self._tokLen(self.cur));
        self.Expect(TK_IDENT);
        // WP-BC-23: optional constraint `: InterfaceName`
        if (self.Match(TK_COLON) != 0) {
          self._sc0(tp, self.ParseType());
        }
        tparams := tp; ttail := tp;
        while (self.Match(TK_COMMA) != 0) {
          var tp2: int64 := self._alloc(NK_TYPE_PARAM, self.cur);
          self._ssv(tp2, self._tokOff(self.cur), self._tokLen(self.cur));
          self.Expect(TK_IDENT);
          if (self.Match(TK_COLON) != 0) {
            self._sc0(tp2, self.ParseType());
          }
          self._sn(ttail, tp2);
          ttail := tp2;
        }
      }
      self.Expect(TK_GT);
      // Store type params in child3 (c3)
      self._sc3(n, tparams);
    }
    
    self.Expect(TK_LPAREN);
    self._sc0(n, self._parseParamList());
    self.Expect(TK_RPAREN);
    if (self.Match(TK_COLON) != 0) { self._sc1(n, self.ParseType()); }
    if (self.Check(TK_LBRACE) != 0) { self._sc2(n, self.ParseBlock()); }
    return n;
  }

  fn ParseStructDecl(isPub: int64): int64 {
    var ti: int64 := self.cur;
    self.Advance();
    var nameTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    var n: int64 := self._alloc(NK_STRUCT_DECL, ti);
    self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
    self._spub(n, isPub);
    self.Expect(TK_LBRACE);
    var head: int64 := -1;
    var tail: int64 := -1;
    while (self.Check(TK_RBRACE) == 0 && self.Check(TK_EOF) == 0) {
      var fTok: int64 := self.cur;
      self.Expect(TK_IDENT);
      var fn2: int64 := self._alloc(NK_FIELD_DECL, fTok);
      self._ssv(fn2, self._tokOff(fTok), self._tokLen(fTok));
      self.Expect(TK_COLON);
      self._sc0(fn2, self.ParseType());
      self.Match(TK_SEMI);
      if (head == -1) { head := fn2; tail := fn2; }
      else { self._sn(tail, fn2); tail := fn2; }
    }
    self.Expect(TK_RBRACE);
    self.Match(TK_SEMI);
    self._sc0(n, head);
    return n;
  }

  fn ParseEnumDecl(isPub: int64): int64 {
    var ti: int64 := self.cur;
    self.Advance();
    var nameTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    var n: int64 := self._alloc(NK_ENUM_DECL, ti);
    self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
    self._spub(n, isPub);
    self.Expect(TK_LBRACE);
    var head: int64 := -1;
    var tail: int64 := -1;
    while (self.Check(TK_RBRACE) == 0 && self.Check(TK_EOF) == 0) {
      var mTok: int64 := self.cur;
      self.Expect(TK_IDENT);
      var mn: int64 := self._alloc(NK_ENUM_MEM, mTok);
      self._ssv(mn, self._tokOff(mTok), self._tokLen(mTok));
      if (self.Match(TK_EQ1) != 0) { self._sc0(mn, self.ParseExpr()); }
      self.Match(TK_COMMA);
      if (head == -1) { head := mn; tail := mn; }
      else { self._sn(tail, mn); tail := mn; }
    }
    self.Expect(TK_RBRACE);
    self.Match(TK_SEMI);
    self._sc0(n, head);
    return n;
  }

  fn _parseImport(): int64 {
    var ti: int64 := self.cur;
    self.Advance();
    var firstNode: int64 := -1;
    var lastNode:  int64 := -1;

    while (1 == 1) {
      var nodeTi: int64 := self.cur;
      var n: int64 := self._alloc(NK_IMPORT, nodeTi);
      var nameTok: int64 := self.cur;
      self.Expect(TK_IDENT);
      var endTok: int64 := nameTok;
      while (self.Check(TK_DOT) != 0) {
        self.Advance();
        endTok := self.cur;
        self.Expect(TK_IDENT);
      }
      var startOff: int64 := self.TokStart(nameTok);
      var endOff: int64 := self.TokStart(endTok) + self.TokLen(endTok);
      self._ssv(n, startOff, endOff - startOff);

      if (firstNode == -1) { firstNode := n; }
      if (lastNode  != -1) { self._sn(lastNode, n); }
      lastNode := n;

      if (self.Match(TK_COMMA) == 0) { break; }
    }

    self.Match(TK_SEMI);
    return firstNode;
  }

  fn _parseTypeDecl(isPub: int64): int64 {
    var ti: int64 := self.cur;
    self.Advance();
    var nameTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    var n: int64 := self._alloc(NK_TYPE_DECL, ti);
    self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
    self._spub(n, isPub);
    if (self.Match(TK_EQ1) != 0) {
      // WP-BC-20: optional abstract modifier before class
      var isAbstractClass: int64 := 0;
      if (self.Match(TK_ABSTRACT) != 0) { isAbstractClass := 1; }
      if (self.Check(TK_CLASS) != 0) {
        self._siv(n, isAbstractClass);
        // WP-16: class with extends and implements
        self.Advance();
        // c2 = parent class name (extends)
        if (self.Check(TK_EXTENDS) != 0) {
          self.Advance();
          self._sc2(n, self._alloc(NK_TYPE_NAME, self.cur));
          self._ssv(self._sc2(n), self._tokOff(self.cur), self._tokLen(self.cur));
          self.Advance();
        }
        // c3 = interface names (implements)
        if (self.Check(TK_IMPLS) != 0) {
          self.Advance();
          var ihead: int64 := -1;
          var itail: int64 := -1;
          while (self.Check(TK_EOF) == 0) {
            if (self.Check(TK_IDENT) != 0) {
              var iface: int64 := self._alloc(NK_TYPE_NAME, self.cur);
              self._ssv(iface, self._tokOff(self.cur), self._tokLen(self.cur));
              self.Advance();
              if (ihead == -1) { ihead := iface; itail := iface; }
              else { self._sn(itail, iface); itail := iface; }
            }
            if (self.Check(TK_COMMA) != 0) { self.Advance(); }
            else { break; }
          }
          self._sc3(n, ihead);
        }
        // Parse class body { fields and methods }
        if (self.Check(TK_LBRACE) != 0) {
          self.Advance();
          var cFldHead: int64 := -1;
          var cFldTail: int64 := -1;
          var cMthHead: int64 := -1;
          var cMthTail: int64 := -1;
          while (self.Check(TK_RBRACE) == 0 && self.Check(TK_EOF) == 0) {
            // WP-BC-22: visibility modifier: pub=1, private=2, protected=3 (packed in bits 4-5)
            var cPub: int64 := 0;
            var cVis: int64 := 0;
            if (self.Match(TK_PUB) != 0)     { cPub := 1; cVis := 1; }
            if (self.Match(TK_PRIVATE) != 0)  { cVis := 2; }
            if (self.Match(TK_PROTD) != 0)    { cVis := 3; }
            // WP-BC-19: virtual/override modifier before fn
            // WP-BC-20: abstract modifier before fn
            var cVirtual: int64 := 0;
            var cOverride: int64 := 0;
            var cAbstract: int64 := 0;
            if (self.Match(TK_VIRTUAL) != 0)  { cVirtual := 1; }
            if (self.Match(TK_OVERRIDE) != 0) { cOverride := 1; }
            if (self.Match(TK_ABSTRACT) != 0) { cAbstract := 1; }
            if (self.Check(TK_FN) != 0) {
              var cm: int64 := self.ParseFuncDecl(cPub);
              // bit0=isPub, bit1=isVirtual, bit2=isOverride, bit3=isAbstract, bits4-5=visibility
              self._siv(cm, cPub | (cVirtual << 1) | (cOverride << 2) | (cAbstract << 3) | (cVis << 4));
              if (cMthHead == -1) { cMthHead := cm; cMthTail := cm; }
              else { self._sn(cMthTail, cm); cMthTail := cm; }
            } else {
              var cfTok: int64 := self.cur;
              self.Expect(TK_IDENT);
              var cfn: int64 := self._alloc(NK_FIELD_DECL, cfTok);
              self._ssv(cfn, self._tokOff(cfTok), self._tokLen(cfTok));
              // WP-BC-22: store visibility in field iVal bits 4-5
              self._siv(cfn, cVis << 4);
              self.Expect(TK_COLON);
              self._sc0(cfn, self.ParseType());
              self.Match(TK_SEMI);
              if (cFldHead == -1) { cFldHead := cfn; cFldTail := cfn; }
              else { self._sn(cFldTail, cfn); cFldTail := cfn; }
            }
          }
          self.Expect(TK_RBRACE);
          self._sc0(n, cFldHead);
          self._sc1(n, cMthHead);
        }
      } else if (self.Check(TK_IFACE) != 0) {
        // WP-16: interface declaration
        self.Advance();
        if (self.Check(TK_LBRACE) != 0) {
          self.Advance();
          var iMthHead: int64 := -1;
          var iMthTail: int64 := -1;
          while (self.Check(TK_RBRACE) == 0 && self.Check(TK_EOF) == 0) {
            if (self.Check(TK_FN) != 0) {
              var m: int64 := self.ParseFuncDecl(1);  // interface methods are implicitly public
              if (iMthHead == -1) { iMthHead := m; iMthTail := m; }
              else { self._sn(iMthTail, m); iMthTail := m; }
            }
            self.Match(TK_SEMI);
          }
          self.Expect(TK_RBRACE);
          self._sc1(n, iMthHead);
        }
      } else if (self.Check(TK_STRUCT) != 0) {
        self.Advance();
        if (self.Check(TK_LBRACE) != 0) {
          self.Advance();
          var fldHead: int64 := -1;
          var fldTail: int64 := -1;
          var mthHead: int64 := -1;
          var mthTail: int64 := -1;
          while (self.Check(TK_RBRACE) == 0 && self.Check(TK_EOF) == 0) {
            var mPub: int64 := 0;
            if (self.Match(TK_PUB) != 0) { mPub := 1; }
            if (self.Check(TK_FN) != 0) {
              var m: int64 := self.ParseFuncDecl(mPub);
              if (mthHead == -1) { mthHead := m; mthTail := m; }
              else { self._sn(mthTail, m); mthTail := m; }
            } else {
              var fTok: int64 := self.cur;
              self.Expect(TK_IDENT);
              var fn2: int64 := self._alloc(NK_FIELD_DECL, fTok);
              self._ssv(fn2, self._tokOff(fTok), self._tokLen(fTok));
              self.Expect(TK_COLON);
              self._sc0(fn2, self.ParseType());
              self.Match(TK_SEMI);
              if (fldHead == -1) { fldHead := fn2; fldTail := fn2; }
              else { self._sn(fldTail, fn2); fldTail := fn2; }
            }
          }
          self.Expect(TK_RBRACE);
          self._sc0(n, fldHead);
          self._sc1(n, mthHead);
        }
      } else {
        self.ParseType();
      }
    }
    self.Match(TK_SEMI);
    return n;
  }

  fn _parseExternDecl(): int64 {
    var ti: int64 := self.cur;
    self.Advance();
    var n: int64 := self._alloc(NK_FUNC_DECL, ti);
    self._siv(n, 1);
    if (self.Match(TK_FN) != 0) {
      var nameTok: int64 := self.cur;
      self.Expect(TK_IDENT);
      self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
    }
    // Capture the `link "lib.so"` target. `link` lexes as a plain identifier;
    // the library name is the string literal that follows it. We pack its
    // source span (quotes stripped) into child3 as ((len << 32) | offset).
    // child3 is the generics/type-param slot, which sema's _checkFuncDecl
    // never reads — so storing here keeps c0 (params) and c1 (return type) at
    // their -1 defaults and avoids spurious "unknown param/return type" errors.
    // The x86_64 codegen unpacks child3 to emit a DT_NEEDED entry + dynamic
    // symbol. The rest of the decl is skipped: call-site arity is enough.
    while (self.Check(TK_SEMI) == 0 && self.Check(TK_EOF) == 0) {
      if (self.Check(TK_STRING) != 0) {
        var sOff: int64 := self._tokOff(self.cur);
        var sLen: int64 := self._tokLen(self.cur);
        if (sLen >= 2) {
          self._sc3(n, ((sLen - 2) << 32) | (sOff + 1));
        }
      }
      self.Advance();
    }
    self.Match(TK_SEMI);
    return n;
  }

  fn _skipBraces() {
    self.Expect(TK_LBRACE);
    var depth: int64 := 1;
    while (depth > 0 && self.Check(TK_EOF) == 0) {
      var k: int64 := self.Peek();
      if (k == TK_LBRACE) { depth := depth + 1; }
      else if (k == TK_RBRACE) { depth := depth - 1; }
      self.Advance();
    }
  }

  // WP-BC-16: dim Name;  or  dim Name = DimExpr;
  fn _parseDimDecl(isPub: int64): int64 {
    var ti: int64 := self.cur;
    self.Advance();  // consume TK_DIM
    var nameTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    var n: int64 := self._alloc(NK_DIM_DECL, ti);
    self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
    self._siv(n, isPub);
    // Optional: = DimExpr (derived dimension: ident * ident / ident etc.)
    if (self.Match(TK_EQ1) != 0) {
      var dimExpr: int64 := self.ParseExpr();
      self._sc0(n, dimExpr);
    }
    self.Expect(TK_SEMI);
    return n;
  }

  // WP-BC-16: utype Name: DimName = ScaleFactor;
  fn _parseUtypeDecl(isPub: int64): int64 {
    var ti: int64 := self.cur;
    self.Advance();  // consume TK_UTYPE
    var nameTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    var n: int64 := self._alloc(NK_UTYPE_DECL, ti);
    self._ssv(n, self._tokOff(nameTok), self._tokLen(nameTok));
    self._siv(n, isPub);
    self.Expect(TK_COLON);
    // dimension name
    var dimTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    var dimNode: int64 := self._alloc(NK_IDENT, dimTok);
    self._ssv(dimNode, self._tokOff(dimTok), self._tokLen(dimTok));
    self._sc0(n, dimNode);
    // optional = ScaleFactor
    if (self.Match(TK_EQ1) != 0) {
      var factor: int64 := self.ParseExpr();
      self._sc1(n, factor);
    }
    self.Expect(TK_SEMI);
    return n;
  }

  // ==================================================================
  // WP-BC-41: LFD Qt-UI-Builder form parsing
  // Syntax: form FormName "Title" { widget/layout... }
  // ==================================================================

  fn _parseLfdPropBody(widgetNode: int64) {
    // Parse property/signal list inside widget body: { PropName: value; ... }
    // Linked list via _sn; attached to widgetNode via _sc0
    var head: int64 := -1;
    var tail: int64 := -1;
    while (self.Check(TK_RBRACE) == 0 && self.Check(TK_EOF) == 0) {
      var isSignal: int64 := 0;
      if (self.Match(TK_SIGNAL) != 0) { isSignal := 1; }
      var nameTok: int64 := self.cur;
      if (self.Check(TK_IDENT) == 0) {
        // Property names can also be token keywords (e.g. OnClick). Accept any token.
        self._err("expected property name");
        self.Advance();
      } else {
        self.Advance();
      }
      self.Expect(TK_COLON);
      // Parse value: string literal, identifier, or integer
      var valOff: int64 := self._tokOff(self.cur);
      var valLen: int64 := self._tokLen(self.cur);
      self.Advance();  // consume the value token
      var kind: int64 := NK_LFD_PROPERTY;
      if (isSignal != 0) { kind := NK_LFD_SIGNAL; }
      var pn: int64 := self._alloc(kind, nameTok);
      self._ssv(pn, self._tokOff(nameTok), self._tokLen(nameTok));
      self._sc1(pn, valOff);
      self._sc2(pn, valLen);
      self.Match(TK_SEMI);
      if (head == -1) { head := pn; tail := pn; }
      else { self._sn(tail, pn); tail := pn; }
    }
    self._sc0(widgetNode, head);
  }

  fn _parseLfdWidget(): int64 {
    // widget TypeName varName { properties }
    var ti: int64 := self.cur;
    self.Advance();  // consume 'widget'
    var typeTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    var nameTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    var wn: int64 := self._alloc(NK_LFD_WIDGET, ti);
    self._ssv(wn, self._tokOff(typeTok), self._tokLen(typeTok));
    self._sc1(wn, self._tokOff(nameTok));
    self._sc2(wn, self._tokLen(nameTok));
    self.Expect(TK_LBRACE);
    self._parseLfdPropBody(wn);
    self.Expect(TK_RBRACE);
    return wn;
  }

  fn _parseLfdLayout(): int64 {
    // layout KindName { widget/layout... }
    var ti: int64 := self.cur;
    self.Advance();  // consume 'layout'
    var kindTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    // Determine layout kind integer: 1=Vertical, 2=Horizontal, 3=Grid, 4=Form
    var kindName: pchar := self.src + self._tokOff(kindTok);
    var kindLen: int64 := self._tokLen(kindTok);
    var lkind: int64 := 1;  // default Vertical
    if (kindLen == 10) {
      // "Horizontal" → 2
      if (StrCharAt(kindName, 0) == 72) { lkind := 2; }
    } else if (kindLen == 4) {
      // "Grid" → 3, "Form" → 4
      if (StrCharAt(kindName, 0) == 71) { lkind := 3; }
      if (StrCharAt(kindName, 0) == 70) { lkind := 4; }
    }
    var ln: int64 := self._alloc(NK_LFD_LAYOUT, ti);
    self._siv(ln, lkind);
    self.Expect(TK_LBRACE);
    var head: int64 := -1;
    var tail: int64 := -1;
    while (self.Check(TK_RBRACE) == 0 && self.Check(TK_EOF) == 0) {
      var child: int64 := -1;
      if (self.Check(TK_WIDGET) != 0)      { child := self._parseLfdWidget(); }
      else if (self.Check(TK_LAYOUT) != 0) { child := self._parseLfdLayout(); }
      else {
        self._err("expected 'widget' or 'layout' in layout body");
        self.Advance();
      }
      if (child >= 0) {
        if (head == -1) { head := child; tail := child; }
        else { self._sn(tail, child); tail := child; }
      }
    }
    self.Expect(TK_RBRACE);
    self._sc0(ln, head);
    return ln;
  }

  fn _parseLfdForm(): int64 {
    // form FormName "Title" { widget/layout... }
    var ti: int64 := self.cur;
    self.Advance();  // consume 'form'
    var nameTok: int64 := self.cur;
    self.Expect(TK_IDENT);
    // title is a string literal (or identifier used as title)
    var titleOff: int64 := self._tokOff(self.cur);
    var titleLen: int64 := self._tokLen(self.cur);
    self.Advance();  // consume title token (string or ident)
    var fn2: int64 := self._alloc(NK_LFD_FORM, ti);
    self._ssv(fn2, self._tokOff(nameTok), self._tokLen(nameTok));
    self._sc1(fn2, titleOff);
    self._sc2(fn2, titleLen);
    self.Expect(TK_LBRACE);
    var head: int64 := -1;
    var tail: int64 := -1;
    while (self.Check(TK_RBRACE) == 0 && self.Check(TK_EOF) == 0) {
      var child: int64 := -1;
      if (self.Check(TK_WIDGET) != 0)      { child := self._parseLfdWidget(); }
      else if (self.Check(TK_LAYOUT) != 0) { child := self._parseLfdLayout(); }
      else {
        self._err("expected 'widget' or 'layout' in form body");
        self.Advance();
      }
      if (child >= 0) {
        if (head == -1) { head := child; tail := child; }
        else { self._sn(tail, child); tail := child; }
      }
    }
    self.Expect(TK_RBRACE);
    self._sc0(fn2, head);
    return fn2;
  }

  // ==================================================================
  // WP-CS-02: @if conditional compilation helpers
  // ==================================================================

  // Parse top-level declarations until } or EOF; returns NK_BLOCK.
  // Caller must have already consumed '{'.
  fn _parseTopDeclBody(): int64 {
    var ti: int64 := self.cur;
    var n: int64 := self._alloc(NK_BLOCK, ti);
    var head: int64 := -1;
    var tail: int64 := -1;
    var decl: int64 := -1;
    var annoFlags: int64 := 0;
    var isPub: int64 := 0;
    var flag: int64 := 0;
    var depth: int64 := 0;
    var k: int64 := 0;
    while (self.Peek() != TK_RBRACE && self.Peek() != TK_EOF) {
      if (self.hadError != 0) {
        self._sc0(n, head);
        return n;
      }
      decl := -1;
      annoFlags := 0;
      // Nested @if / @directive
      if (self.Peek() == TK_AT && self.Peek2() == TK_IF) {
        self.Advance();
        decl := self._parseAtIf(1);
      } else if (self.Peek() == TK_AT && self.Peek2() == TK_IDENT &&
                 self._tokTextEq(self.cur + 1, "io_check"c) != 0) {
        self.Advance();
        decl := self._parseAtDirective(0);
      } else if (self.Peek() == TK_AT && self.Peek2() == TK_IDENT &&
                 self._tokTextEq(self.cur + 1, "overflow_check"c) != 0) {
        self.Advance();
        decl := self._parseAtDirective(1);
      } else if (self.Peek() == TK_AT && self.Peek2() == TK_IDENT &&
                 self._tokTextEq(self.cur + 1, "bounds_check"c) != 0) {
        self.Advance();  // WP-AS-02
        decl := self._parseAtDirective(AT_DIR_BOUNDS_CHECK);
      } else if (self.Peek() == TK_AT && self.Peek2() == TK_IDENT &&
                 self._tokTextEq(self.cur + 1, "debug_info"c) != 0) {
        self.Advance();  // WP-AS-02
        decl := self._parseAtDirective(AT_DIR_DEBUG_INFO);
      } else if (self.Peek() == TK_AT && self.Peek2() == TK_IDENT &&
                 self._tokTextEq(self.cur + 1, "optimization_level"c) != 0) {
        self.Advance();  // WP-AS-02
        decl := self._parseAtDirectiveInt(AT_DIR_OPT_LEVEL);
      } else if (self.Peek() == TK_AT && self.Peek2() == TK_IDENT &&
                 self._tokTextEq(self.cur + 1, "energy"c) != 0) {
        self.Advance();  // WP-EN-02: @energy as top-level directive in block
        decl := self._parseAtEnergy();
      } else {
        var isEnergy: int64 := 0;
        while (self.Check(TK_AT) != 0) {
          self.Advance();
          flag := 0;
          isEnergy := 0;
          if (self.Check(TK_IDENT) != 0) {
            isEnergy := self._tokTextEq(self.cur, "energy"c);
            flag := self._annoNameToFlag(self.cur);
            annoFlags := annoFlags | flag;
            self.Advance();
          }
          if (self.Check(TK_LPAREN) != 0) {
            if (isEnergy != 0) {
              self.Advance();  // consume (
              if (self.Check(TK_INT) != 0) {
                var elv: int64 := self.TokIVal(self.cur);
                if (elv >= 1 && elv <= 5) {
                  annoFlags := annoFlags | (elv << ANNO_ENERGY_SHIFT);
                } else { self._err("@energy: level must be 1-5"); }
                self.Advance();
              } else { self._err("@energy: expected integer level"); }
              self.Expect(TK_RPAREN);
            } else {
              self.Advance();
              depth := 1;
              while (depth > 0 && self.Peek() != TK_EOF) {
                if (self.Check(TK_LPAREN) != 0) { depth := depth + 1; }
                else if (self.Check(TK_RPAREN) != 0) { depth := depth - 1; }
                self.Advance();
              }
            }
          }
        }
        isPub := 0;
        if (self.Match(TK_PUB) != 0) { isPub := 1; }
        while (self.Check(TK_AT) != 0) {
          self.Advance();
          flag := 0;
          isEnergy := 0;
          if (self.Check(TK_IDENT) != 0) {
            isEnergy := self._tokTextEq(self.cur, "energy"c);
            flag := self._annoNameToFlag(self.cur);
            annoFlags := annoFlags | flag;
            self.Advance();
          }
          if (self.Check(TK_LPAREN) != 0) {
            if (isEnergy != 0) {
              self.Advance();  // consume (
              if (self.Check(TK_INT) != 0) {
                var elv: int64 := self.TokIVal(self.cur);
                if (elv >= 1 && elv <= 5) {
                  annoFlags := annoFlags | (elv << ANNO_ENERGY_SHIFT);
                } else { self._err("@energy: level must be 1-5"); }
                self.Advance();
              } else { self._err("@energy: expected integer level"); }
              self.Expect(TK_RPAREN);
            } else {
              self.Advance();
              depth := 1;
              while (depth > 0 && self.Peek() != TK_EOF) {
                if (self.Check(TK_LPAREN) != 0) { depth := depth + 1; }
                else if (self.Check(TK_RPAREN) != 0) { depth := depth - 1; }
                self.Advance();
              }
            }
          }
        }
        k := self.Peek();
        if (k == TK_FN) {
          decl := self.ParseFuncDecl(isPub);
          if decl != -1 { self._siv(decl, annoFlags); }
        }
        else if (k == TK_VAR)    { decl := self.ParseVarDecl(isPub); }
        else if (k == TK_LET)    { decl := self.ParseLetDecl(isPub); }
        else if (k == TK_CON)    { decl := self.ParseConDecl(isPub); }
        else if (k == TK_STRUCT) { decl := self.ParseStructDecl(isPub); }
        else if (k == TK_ENUM)   { decl := self.ParseEnumDecl(isPub); }
        else if (k == TK_IMPORT) { decl := self._parseImport(); }
        else if (k == TK_TYPE)   { decl := self._parseTypeDecl(isPub); }
        else if (k == TK_EXTERN) { decl := self._parseExternDecl(); }
        else if (k == TK_DIM)    { decl := self._parseDimDecl(isPub); }
        else if (k == TK_UTYPE)  { decl := self._parseUtypeDecl(isPub); }
        else if (k == TK_STATIC) { decl := self.ParseStaticDecl(isPub); }
        else if (k == TK_UNIT) {
          self.Advance();
          while (self.Peek() != TK_SEMI && self.Peek() != TK_EOF) { self.Advance(); }
          self.Match(TK_SEMI);
        }
        else {
          self._err("unexpected token in @if body");
          self.Advance();
        }
      }
      if (decl >= 0) {
        if (head == -1) { head := decl; tail := decl; }
        else { self._sn(tail, decl); tail := decl; }
        while (self.NNext(tail) != -1) { tail := self.NNext(tail); }
      }
    }
    self._sc0(n, head);
    return n;
  }

  // Parse @if(expr) { ... } [@else { ... }]; caller has consumed '@'.
  // toplevel=1: bodies are TopDecl lists; toplevel=0: bodies are statement blocks.
  fn _parseAtIf(toplevel: int64): int64 {
    var ti: int64 := self.cur;
    self.Expect(TK_IF);
    self.Expect(TK_LPAREN);
    var cond: int64 := self.ParseExpr();
    self.Expect(TK_RPAREN);
    var thenBody: int64 := -1;
    var elseBody: int64 := -1;
    if (toplevel != 0) {
      self.Expect(TK_LBRACE);
      thenBody := self._parseTopDeclBody();
      self.Expect(TK_RBRACE);
    } else {
      thenBody := self.ParseBlock();  // ParseBlock consumes { ... } itself
    }
    if (self.Peek() == TK_AT && self.Peek2() == TK_ELSE) {
      self.Advance();  // consume @
      self.Advance();  // consume else
      if (toplevel != 0) {
        self.Expect(TK_LBRACE);
        elseBody := self._parseTopDeclBody();
        self.Expect(TK_RBRACE);
      } else {
        elseBody := self.ParseBlock();
      }
    }
    var n: int64 := self._alloc(NK_AT_IF, ti);
    self._sc0(n, cond);
    self._sc1(n, thenBody);
    self._sc2(n, elseBody);
    return n;
  }

  // WP-CS-04: Parse @io_check(bool) or @overflow_check(bool);
  // kind=0 → @io_check, kind=1 → @overflow_check.
  // Caller has consumed '@'; current token is the directive-name ident.
  fn _parseAtDirective(kind: int64): int64 {
    var ti: int64 := self.cur;
    self.Advance();  // consume "io_check" / "overflow_check" ident
    self.Expect(TK_LPAREN);
    var val: int64 := 0;
    if (self.Check(TK_TRUE) != 0) {
      val := 1;
      self.Advance();
    } else if (self.Check(TK_FALSE) != 0) {
      val := 0;
      self.Advance();
    } else {
      self._err("@io_check/@overflow_check: expected true or false");
    }
    self.Expect(TK_RPAREN);
    self.Match(TK_SEMI);
    var n: int64 := self._alloc(NK_AT_DIRECTIVE, ti);
    self._siv(n, kind);   // 0=io_check, 1=overflow_check
    self._sc0(n, val);    // 0=false, 1=true  (no iv2 slot in node layout)
    return n;
  }

  // WP-AS-02: Parse @optimization_level(0..3); — caller consumed '@'; cur = ident.
  fn _parseAtDirectiveInt(kind: int64): int64 {
    var ti: int64 := self.cur;
    self.Advance();  // consume directive-name ident
    self.Expect(TK_LPAREN);
    if (self.Check(TK_INT) == 0) {
      self._err("@optimization_level: integer 0..3 expected");
      return -1;
    }
    var val: int64 := self.TokIVal(self.cur);
    if (val < 0 || val > 3) {
      self._err("@optimization_level: value must be 0..3");
      return -1;
    }
    self.Advance();
    self.Expect(TK_RPAREN);
    self.Match(TK_SEMI);
    var n: int64 := self._alloc(NK_AT_DIRECTIVE, ti);
    self._siv(n, kind);
    self._sc0(n, val);
    return n;
  }

  // WP-EN-02: Parse @energy(N); — caller has consumed '@'; cur = "energy".
  fn _parseAtEnergy(): int64 {
    var ti: int64 := self.cur;
    self.Advance();  // consume "energy"
    self.Expect(TK_LPAREN);
    if (self.Check(TK_INT) == 0) {
      self._err("@energy: expected integer level 1-5");
      return -1;
    }
    var level: int64 := self.TokIVal(self.cur);
    if (level < 1 || level > 5) {
      self._err("@energy: level must be 1-5");
      return -1;
    }
    self.Advance();
    self.Expect(TK_RPAREN);
    self.Match(TK_SEMI);
    var n: int64 := self._alloc(NK_AT_ENERGY, ti);
    self._siv(n, level);
    return n;
  }

  // ==================================================================
  // Top-level parse -- returns head of declaration list (via NNext)
  // ==================================================================

  fn Parse(): int64 {
    var head: int64 := -1;
    var tail: int64 := -1;

    while (self.Peek() != TK_EOF) {
      if (self.hadError != 0) { return head; }

      // WP-CS-02/04: @if and @directive — must check before annotation loop
      if (self.Peek() == TK_AT && self.Peek2() == TK_IF) {
        self.Advance();  // consume @
        var atDecl: int64 := self._parseAtIf(1);
        if (atDecl >= 0) {
          if (head == -1) { head := atDecl; }
          else { self._sn(tail, atDecl); }
          tail := atDecl;
          while (self.NNext(tail) != -1) { tail := self.NNext(tail); }
        }
      } else if (self.Peek() == TK_AT && self.Peek2() == TK_IDENT &&
                 self._tokTextEq(self.cur + 1, "io_check"c) != 0) {
        self.Advance();  // consume @
        var dirDecl: int64 := self._parseAtDirective(0);
        if (dirDecl >= 0) {
          if (head == -1) { head := dirDecl; }
          else { self._sn(tail, dirDecl); }
          tail := dirDecl;
        }
      } else if (self.Peek() == TK_AT && self.Peek2() == TK_IDENT &&
                 self._tokTextEq(self.cur + 1, "overflow_check"c) != 0) {
        self.Advance();  // consume @
        var dirDecl: int64 := self._parseAtDirective(1);
        if (dirDecl >= 0) {
          if (head == -1) { head := dirDecl; }
          else { self._sn(tail, dirDecl); }
          tail := dirDecl;
        }
      } else if (self.Peek() == TK_AT && self.Peek2() == TK_IDENT &&
                 self._tokTextEq(self.cur + 1, "bounds_check"c) != 0) {
        self.Advance();  // consume @  WP-AS-02
        var dirDecl: int64 := self._parseAtDirective(AT_DIR_BOUNDS_CHECK);
        if (dirDecl >= 0) {
          if (head == -1) { head := dirDecl; }
          else { self._sn(tail, dirDecl); }
          tail := dirDecl;
        }
      } else if (self.Peek() == TK_AT && self.Peek2() == TK_IDENT &&
                 self._tokTextEq(self.cur + 1, "debug_info"c) != 0) {
        self.Advance();  // consume @  WP-AS-02
        var dirDecl: int64 := self._parseAtDirective(AT_DIR_DEBUG_INFO);
        if (dirDecl >= 0) {
          if (head == -1) { head := dirDecl; }
          else { self._sn(tail, dirDecl); }
          tail := dirDecl;
        }
      } else if (self.Peek() == TK_AT && self.Peek2() == TK_IDENT &&
                 self._tokTextEq(self.cur + 1, "optimization_level"c) != 0) {
        self.Advance();  // consume @  WP-AS-02
        var dirDecl: int64 := self._parseAtDirectiveInt(AT_DIR_OPT_LEVEL);
        if (dirDecl >= 0) {
          if (head == -1) { head := dirDecl; }
          else { self._sn(tail, dirDecl); }
          tail := dirDecl;
        }
      } else if (self.Peek() == TK_AT && self.Peek2() == TK_IDENT &&
                 self._tokTextEq(self.cur + 1, "energy"c) != 0) {
        // WP-EN-02: @energy(N); as top-level directive
        self.Advance();  // consume @
        var enDecl: int64 := self._parseAtEnergy();
        if (enDecl >= 0) {
          if (head == -1) { head := enDecl; }
          else { self._sn(tail, enDecl); }
          tail := enDecl;
        }
      } else {

      // WP-AND-02 Phase B/B2: capture annotations (was: WP-BC-54 skip).
      // Annotations may appear before OR after the `pub` keyword.
      // For @jni, the class/method args are parsed into _pendingJni* fields.
      // Other annotations fall back to generic depth-skip of their args.
      var annoFlags: int64 := 0;
      self._pendingJniClassOff  := 0;
      self._pendingJniClassLen  := 0;
      self._pendingJniMethodOff := 0;
      self._pendingJniMethodLen := 0;
      while (self.Check(TK_AT) != 0) {
        self.Advance();  // consume @
        var flag: int64 := 0;
        var isEnergy: int64 := 0;
        if (self.Check(TK_IDENT) != 0) {
          isEnergy := self._tokTextEq(self.cur, "energy"c);
          flag := self._annoNameToFlag(self.cur);
          annoFlags := annoFlags | flag;
          self.Advance();
        }
        if (self.Check(TK_LPAREN) != 0) {
          if (flag == ANNO_JNI) {
            self._parseJniArgs();
          } else if (isEnergy != 0) {
            // WP-EN-02: @energy(N) as function annotation
            self.Advance();  // consume (
            if (self.Check(TK_INT) != 0) {
              var elv: int64 := self.TokIVal(self.cur);
              if (elv >= 1 && elv <= 5) {
                annoFlags := annoFlags | (elv << ANNO_ENERGY_SHIFT);
              } else { self._err("@energy: level must be 1-5"); }
              self.Advance();
            } else { self._err("@energy: expected integer level"); }
            self.Expect(TK_RPAREN);
          } else {
            self.Advance();  // consume (
            var depth: int64 := 1;
            while (depth > 0 && self.Peek() != TK_EOF) {
              if (self.Check(TK_LPAREN) != 0) { depth := depth + 1; }
              else if (self.Check(TK_RPAREN) != 0) { depth := depth - 1; }
              self.Advance();
            }
          }
        }
      }

      var isPub: int64 := 0;
      if (self.Match(TK_PUB) != 0) { isPub := 1; }

      // Allow annotations after `pub` as well (e.g. `pub @export fn ...`).
      while (self.Check(TK_AT) != 0) {
        self.Advance();
        var flag2: int64 := 0;
        var isEnergy2: int64 := 0;
        if (self.Check(TK_IDENT) != 0) {
          isEnergy2 := self._tokTextEq(self.cur, "energy"c);
          flag2 := self._annoNameToFlag(self.cur);
          annoFlags := annoFlags | flag2;
          self.Advance();
        }
        if (self.Check(TK_LPAREN) != 0) {
          if (flag2 == ANNO_JNI) {
            self._parseJniArgs();
          } else if (isEnergy2 != 0) {
            // WP-EN-02: @energy(N) as function annotation (after pub)
            self.Advance();  // consume (
            if (self.Check(TK_INT) != 0) {
              var elv2: int64 := self.TokIVal(self.cur);
              if (elv2 >= 1 && elv2 <= 5) {
                annoFlags := annoFlags | (elv2 << ANNO_ENERGY_SHIFT);
              } else { self._err("@energy: level must be 1-5"); }
              self.Advance();
            } else { self._err("@energy: expected integer level"); }
            self.Expect(TK_RPAREN);
          } else {
            self.Advance();
            var depth: int64 := 1;
            while (depth > 0 && self.Peek() != TK_EOF) {
              if (self.Check(TK_LPAREN) != 0) { depth := depth + 1; }
              else if (self.Check(TK_RPAREN) != 0) { depth := depth - 1; }
              self.Advance();
            }
          }
        }
      }

      var k: int64 := self.Peek();
      var decl: int64 := -1;

      if (k == TK_FN) {
        decl := self.ParseFuncDecl(isPub);
        if decl != -1 {
          self._siv(decl, annoFlags);
          // Attach pending @jni args (if any) to this FUNC_DECL.
          if (annoFlags & ANNO_JNI) != 0 {
            if self._pendingJniClassLen > 0 && self._pendingJniMethodLen > 0 {
              self._pushJniEntry(decl,
                                 self._pendingJniClassOff,  self._pendingJniClassLen,
                                 self._pendingJniMethodOff, self._pendingJniMethodLen);
            }
          }
        }
      }
      else if (k == TK_VAR)    { decl := self.ParseVarDecl(isPub); }
      else if (k == TK_LET)    { decl := self.ParseLetDecl(isPub); }
      else if (k == TK_CON)    { decl := self.ParseConDecl(isPub); }
      else if (k == TK_STRUCT) { decl := self.ParseStructDecl(isPub); }
      else if (k == TK_ENUM)   { decl := self.ParseEnumDecl(isPub); }
      else if (k == TK_IMPORT) { decl := self._parseImport(); }
      else if (k == TK_TYPE)   { decl := self._parseTypeDecl(isPub); }
      else if (k == TK_EXTERN) { decl := self._parseExternDecl(); }
      else if (k == TK_DIM)    { decl := self._parseDimDecl(isPub); }
      else if (k == TK_UTYPE)  { decl := self._parseUtypeDecl(isPub); }
      else if (k == TK_FORM)   { decl := self._parseLfdForm(); }
      // WP-BC-60: static global variable declaration
      else if (k == TK_STATIC) { decl := self.ParseStaticDecl(isPub); }
      // WP-BC-56: skip "unit Name;" module declaration
      else if (k == TK_UNIT) {
        self.Advance();  // consume 'unit'
        while (self.Peek() != TK_SEMI && self.Peek() != TK_EOF) { self.Advance(); }
        self.Match(TK_SEMI);
      }
      else {
        self._err("unexpected top-level token");
        self.Advance();
      }

      if (decl >= 0) {
        if (head == -1) { head := decl; }
        else { self._sn(tail, decl); }
        tail := decl;
        while (self.NNext(tail) != -1) { tail := self.NNext(tail); }
      }
      }  // end else (non-@if branch)

    }

    return head;
  }

  // ============================================================================
  // Utility: count nodes in a linked list
  // ============================================================================

  fn ListLen(head: int64): int64 {
    var cnt: int64 := 0;
    var cur: int64 := head;
    while (cur != -1) {
      cnt := cnt + 1;
      cur := self.NNext(cur);
    }
    return cnt;
  }

  // ============================================================================
  // Utility: node kind → name string
  // ============================================================================

  fn NodeKindStr(k: int64): pchar {
    if (k == NK_INVALID)     { return "INVALID"; }
    if (k == NK_IMPORT)      { return "IMPORT"; }
    if (k == NK_FUNC_DECL)   { return "FUNC_DECL"; }
    if (k == NK_PARAM)       { return "PARAM"; }
    if (k == NK_VAR_DECL)    { return "VAR_DECL"; }
    if (k == NK_CON_DECL)    { return "CON_DECL"; }
    if (k == NK_STRUCT_DECL) { return "STRUCT_DECL"; }
    if (k == NK_FIELD_DECL)  { return "FIELD_DECL"; }
    if (k == NK_ENUM_DECL)   { return "ENUM_DECL"; }
    if (k == NK_ENUM_MEM)    { return "ENUM_MEM"; }
    if (k == NK_TYPE_DECL)   { return "TYPE_DECL"; }
    if (k == NK_BLOCK)       { return "BLOCK"; }
    if (k == NK_IF)          { return "IF"; }
    if (k == NK_WHILE)        { return "WHILE"; }
    if (k == NK_REPEAT_UNTIL)   { return "REPEAT_UNTIL"; }
    if (k == NK_TUPLE_VAR_DECL) { return "TUPLE_VAR_DECL"; }
    if (k == NK_MAP_LIT)        { return "MAP_LIT"; }
    if (k == NK_SET_LIT)        { return "SET_LIT"; }
    if (k == NK_IN_EXPR)        { return "IN_EXPR"; }
    if (k == NK_MAP_ENTRY)      { return "MAP_ENTRY"; }
    if (k == NK_FOR)         { return "FOR"; }
    if (k == NK_FOR_C)       { return "FOR_C"; }
    if (k == NK_AT_IF)       { return "AT_IF"; }
    if (k == NK_AT_DIRECTIVE){ return "AT_DIRECTIVE"; }
    if (k == NK_AT_ENERGY)   { return "AT_ENERGY"; }
    if (k == NK_DEFER)       { return "DEFER"; }
    if (k == NK_SWITCH)      { return "SWITCH"; }
    if (k == NK_CASE)        { return "CASE"; }
    if (k == NK_BREAK)       { return "BREAK"; }
    if (k == NK_RETURN)      { return "RETURN"; }
    if (k == NK_EXPR_STMT)   { return "EXPR_STMT"; }
    if (k == NK_ASSIGN)      { return "ASSIGN"; }
    if (k == NK_DISPOSE)     { return "DISPOSE"; }
    if (k == NK_LIT_INT)     { return "LIT_INT"; }
    if (k == NK_LIT_FLOAT)   { return "LIT_FLOAT"; }
    if (k == NK_LIT_STR)     { return "LIT_STR"; }
    if (k == NK_LIT_CHAR)    { return "LIT_CHAR"; }
    if (k == NK_LIT_BOOL)    { return "LIT_BOOL"; }
    if (k == NK_LIT_NULL)    { return "LIT_NULL"; }
    if (k == NK_IDENT)       { return "IDENT"; }
    if (k == NK_BINOP)       { return "BINOP"; }
    if (k == NK_UNOP)        { return "UNOP"; }
    if (k == NK_CALL)        { return "CALL"; }
    if (k == NK_INDEX)       { return "INDEX"; }
    if (k == NK_FIELD)       { return "FIELD"; }
    if (k == NK_NEW)         { return "NEW"; }
    if (k == NK_TYPE_NAME)   { return "TYPE_NAME"; }
    if (k == NK_TYPE_ARRAY)  { return "TYPE_ARRAY"; }
    if (k == NK_REGEX_LIT)   { return "REGEX_LIT"; }
    if (k == NK_DIM_DECL)      { return "DIM_DECL"; }
    if (k == NK_UTYPE_DECL)    { return "UTYPE_DECL"; }
    if (k == NK_TYPE_RINGBUF)  { return "TYPE_RINGBUF"; }
    if (k == NK_TYPE_PARALLEL) { return "TYPE_PARALLEL"; }
    if (k == NK_SIMD_NEW)      { return "SIMD_NEW"; }
    return "?";
  }
};
