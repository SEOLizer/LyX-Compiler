// ==================================================================
// #1509: @stack_limit an einer rekursiven Funktion mit Tiefenzaehler
// ==================================================================
//
// `@stack_limit(N)` wurde an JEDER rekursiven Funktion abgewiesen — auch
// dann, wenn die Funktion ihre Tiefe selbst fuehrt und begrenzt:
//
//   @stack_limit(4096)
//   fn ParseExpr(depth: int64): int64 {
//     if (depth > 64) { panic("zu tief"); }
//     return ParseExpr(depth + 1);
//   }
//
// Hier IST die Aufruftiefe beschraenkt, und zwar strukturell nachweisbar. Die
// Doku beschreibt genau dieses Muster als empfohlenen Weg fuer
// sicherheitsgerichteten Code (sprache/rekursion.txt, Tabelle zur
// Zulaessigkeit) — keines ihrer Beispiele uebersetzte.
//
// WAS ALS NACHWEIS GILT — beides muss zutreffen:
//
//   1. Ein WAECHTER auf einen Parameter: eine Bedingung, die den Parameter
//      gegen ein ganzzahliges Literal prueft und im Erfolgsfall die Funktion
//      verlaesst (`panic`, `exit` oder `return`). Er muss VOR dem ersten
//      rekursiven Aufruf stehen — sonst schuetzt er die Rekursion nicht.
//   2. Jeder rekursive Aufruf reicht an dieser Stelle `p + K` mit einem
//      literalen K > 0 weiter. Nur dann waechst der Zaehler zwangslaeufig auf
//      die Schranke zu.
//
// Alles andere bleibt abgewiesen. Insbesondere reicht ein Waechter allein
// nicht (der Zaehler koennte gleich bleiben), und ein Fortschritt allein auch
// nicht (ohne Schranke laeuft er ins Leere). Was nicht bewiesen werden kann,
// darf nicht stillschweigend als bewiesen gelten — dieselbe Linie wie bei
// @wcet (#1139).
//
// Die Analyse ist dieselbe Art Abzaehlung, die `limit(N)` an `while` leistet:
// eine Schranke, ein Fortschritt, eine Richtung.
//
// Alle Methoden tragen das Praefix dg_ (VMT-Kollisionen, wie im Linter).

import src.parser;
import src.lexer;
import src.std.alloc;

con DG_NODE_SIZE: int64 := 88;
con DG_OFF_C0:    int64 := 8;
con DG_OFF_C1:    int64 := 16;
con DG_OFF_C2:    int64 := 24;
con DG_OFF_NEXT:  int64 := 40;
con DG_OFF_IVAL:  int64 := 56;
con DG_OFF_SVAL:  int64 := 64;
con DG_OFF_SLEN:  int64 := 72;

pub type DepthGuard = class {
  dgNodes: int64;
  dgSrc:   int64;
  dgCount: int64;

  pub fn dg_Init(nodes: int64, src: int64, count: int64) {
    self.dgNodes := nodes;
    self.dgSrc   := src;
    self.dgCount := count;
  }

  fn dg_base(ni: int64): int64 { return self.dgNodes + ni * DG_NODE_SIZE; }
  fn dg_kind(ni: int64): int64 { if (ni < 0) { return -1; } return peek64(self.dg_base(ni)); }
  fn dg_c0(ni: int64): int64   { if (ni < 0) { return -1; } return peek64(self.dg_base(ni) + DG_OFF_C0); }
  fn dg_c1(ni: int64): int64   { if (ni < 0) { return -1; } return peek64(self.dg_base(ni) + DG_OFF_C1); }
  fn dg_c2(ni: int64): int64   { if (ni < 0) { return -1; } return peek64(self.dg_base(ni) + DG_OFF_C2); }
  fn dg_next(ni: int64): int64 { if (ni < 0) { return -1; } return peek64(self.dg_base(ni) + DG_OFF_NEXT); }
  fn dg_ival(ni: int64): int64 { if (ni < 0) { return 0; }  return peek64(self.dg_base(ni) + DG_OFF_IVAL); }
  fn dg_sval(ni: int64): pchar { return (self.dgSrc + peek64(self.dg_base(ni) + DG_OFF_SVAL)) as pchar; }
  fn dg_slen(ni: int64): int64 { if (ni < 0) { return 0; }  return peek64(self.dg_base(ni) + DG_OFF_SLEN); }

  fn dg_nameGleich(ni: int64, name: pchar, nlen: int64): int64 {
    if (ni < 0) { return 0; }
    if (self.dg_slen(ni) != nlen) { return 0; }
    var s: pchar := self.dg_sval(ni);
    var i: int64 := 0;
    while (i < nlen) {
      if ((StrCharAt(s, i) & 255) != (StrCharAt(name, i) & 255)) { return 0; }
      i := i + 1;
    }
    return 1;
  }

  // Verlaesst diese Anweisung die Funktion? panic/exit oder return.
  fn dg_istAbbruch(ni: int64): int64 {
    if (ni < 0) { return 0; }
    var k: int64 := self.dg_kind(ni);
    if (k == NK_RETURN) { return 1; }
    if (k == NK_CALL) {
      if (self.dg_nameGleich(ni, "panic"c, 5) != 0) { return 1; }
      if (self.dg_nameGleich(ni, "exit"c, 4) != 0) { return 1; }
      return 0;
    }
    if (k == NK_BLOCK) {
      var s: int64 := self.dg_c0(ni);
      while (s >= 0) {
        if (self.dg_istAbbruch(s) != 0) { return 1; }
        s := self.dg_next(s);
      }
      return 0;
    }
    return 0;
  }

  // Prueft die Bedingung eines `if` auf die Form `param <vgl> LITERAL`.
  // Rueckgabe: Name des Parameters (ueber outLen), oder 0.
  fn dg_waechterParam(condNi: int64, outLen: int64): pchar {
    poke64(outLen, 0);
    if (condNi < 0) { return 0 as pchar; }
    if (self.dg_kind(condNi) != NK_BINOP) { return 0 as pchar; }
    var op: int64 := self.dg_ival(condNi);
    if (op != TK_GT && op != TK_GE && op != TK_LT && op != TK_LE) { return 0 as pchar; }
    var l: int64 := self.dg_c0(condNi);
    var r: int64 := self.dg_c1(condNi);
    // Eine Seite Bezeichner, die andere Literal — in beiden Anordnungen.
    if (self.dg_kind(l) == NK_IDENT && self.dg_kind(r) == NK_LIT_INT) {
      poke64(outLen, self.dg_slen(l));
      return self.dg_sval(l);
    }
    if (self.dg_kind(r) == NK_IDENT && self.dg_kind(l) == NK_LIT_INT) {
      poke64(outLen, self.dg_slen(r));
      return self.dg_sval(r);
    }
    return 0 as pchar;
  }

  // Position eines Parameters in der Liste, oder -1.
  fn dg_paramIndex(funcNi: int64, name: pchar, nlen: int64): int64 {
    var p: int64 := self.dg_c0(funcNi);
    var idx: int64 := 0;
    while (p >= 0) {
      if (self.dg_nameGleich(p, name, nlen) != 0) { return idx; }
      idx := idx + 1;
      p := self.dg_next(p);
    }
    return -1;
  }

  // Ist `arg` die Form `name + K` mit literalem K > 0?
  fn dg_istFortschritt(arg: int64, name: pchar, nlen: int64): int64 {
    if (arg < 0) { return 0; }
    if (self.dg_kind(arg) != NK_BINOP) { return 0; }
    if (self.dg_ival(arg) != TK_PLUS) { return 0; }
    var l: int64 := self.dg_c0(arg);
    var r: int64 := self.dg_c1(arg);
    if (self.dg_kind(l) == NK_IDENT && self.dg_nameGleich(l, name, nlen) != 0
        && self.dg_kind(r) == NK_LIT_INT && self.dg_ival(r) > 0) { return 1; }
    if (self.dg_kind(r) == NK_IDENT && self.dg_nameGleich(r, name, nlen) != 0
        && self.dg_kind(l) == NK_LIT_INT && self.dg_ival(l) > 0) { return 1; }
    return 0;
  }

  // Durchsucht einen Teilbaum nach Aufrufen von `fname`. Rueckgabe:
  //   0 = kein Selbstaufruf gefunden
  //   1 = alle gefundenen reichen den Zaehler erhoeht weiter
  //  -1 = mindestens einer tut es nicht
  fn dg_pruefeAufrufe(ni: int64, fname: pchar, flen: int64,
                      pname: pchar, plen: int64, pidx: int64): int64 {
    if (ni < 0) { return 0; }
    var ergebnis: int64 := 0;
    var k: int64 := self.dg_kind(ni);
    if (k == NK_CALL) {
      if (self.dg_nameGleich(ni, fname, flen) != 0) {
        // Argumentkette: bei einem gewoehnlichen Aufruf haengt sie an c0.
        var arg: int64 := self.dg_c0(ni);
        var ai: int64 := 0;
        var gefunden: int64 := 0;
        while (arg >= 0) {
          if (ai == pidx) {
            if (self.dg_istFortschritt(arg, pname, plen) != 0) { gefunden := 1; }
            else { return -1; }
          }
          ai := ai + 1;
          arg := self.dg_next(arg);
        }
        if (gefunden == 0) { return -1; }   // Stelle gar nicht besetzt
        ergebnis := 1;
      }
    }
    // Kinder und Geschwister absuchen; ein einziges Gegenbeispiel entscheidet.
    var kinder: int64 := 0;
    while (kinder < 3) {
      var c: int64 := -1;
      if (kinder == 0) { c := self.dg_c0(ni); }
      if (kinder == 1) { c := self.dg_c1(ni); }
      if (kinder == 2) { c := self.dg_c2(ni); }
      while (c >= 0) {
        var r: int64 := self.dg_pruefeAufrufe(c, fname, flen, pname, plen, pidx);
        if (r < 0) { return -1; }
        if (r > 0) { ergebnis := 1; }
        c := self.dg_next(c);
      }
      kinder := kinder + 1;
    }
    return ergebnis;
  }

  // Enthaelt der Teilbaum einen Aufruf von `fname`?
  fn dg_hatSelbstaufruf(ni: int64, fname: pchar, flen: int64): int64 {
    if (ni < 0) { return 0; }
    if (self.dg_kind(ni) == NK_CALL && self.dg_nameGleich(ni, fname, flen) != 0) { return 1; }
    var kinder: int64 := 0;
    while (kinder < 3) {
      var c: int64 := -1;
      if (kinder == 0) { c := self.dg_c0(ni); }
      if (kinder == 1) { c := self.dg_c1(ni); }
      if (kinder == 2) { c := self.dg_c2(ni); }
      while (c >= 0) {
        if (self.dg_hatSelbstaufruf(c, fname, flen) != 0) { return 1; }
        c := self.dg_next(c);
      }
      kinder := kinder + 1;
    }
    return 0;
  }

  // 1 = die Aufruftiefe dieser Funktion ist nachweisbar beschraenkt.
  pub fn dg_Nachweisbar(funcNi: int64): int64 {
    if (funcNi < 0) { return 0; }
    if (self.dg_kind(funcNi) != NK_FUNC_DECL) { return 0; }
    var fname: pchar := self.dg_sval(funcNi);
    var flen:  int64 := self.dg_slen(funcNi);
    var body:  int64 := self.dg_c2(funcNi);
    if (body < 0) { return 0; }

    // Die obersten Anweisungen der Reihe nach: der Waechter muss VOR dem
    // ersten Selbstaufruf stehen.
    var stmt: int64 := self.dg_c0(body);
    var lenZelle: int64 := alloc(8);
    var pname: pchar := 0 as pchar;
    var plen:  int64 := 0;
    while (stmt >= 0) {
      if (self.dg_kind(stmt) == NK_IF) {
        var kand: pchar := self.dg_waechterParam(self.dg_c0(stmt), lenZelle);
        var kandLen: int64 := peek64(lenZelle);
        if (kand != 0 as pchar && kandLen > 0) {
          if (self.dg_istAbbruch(self.dg_c1(stmt)) != 0) {
            if (self.dg_paramIndex(funcNi, kand, kandLen) >= 0) {
              pname := kand; plen := kandLen;
            }
          }
        }
      }
      if (pname == 0 as pchar) {
        // Noch kein Waechter — sobald hier ein Selbstaufruf steht, ist die
        // Rekursion ungeschuetzt.
        if (self.dg_hatSelbstaufruf(stmt, fname, flen) != 0) {
          free(lenZelle, 8);
          return 0;
        }
      }
      stmt := self.dg_next(stmt);
    }
    free(lenZelle, 8);
    if (pname == 0 as pchar) { return 0; }

    var pidx: int64 := self.dg_paramIndex(funcNi, pname, plen);
    if (pidx < 0) { return 0; }

    // Jeder Selbstaufruf muss den Zaehler erhoehen.
    var r: int64 := self.dg_pruefeAufrufe(body, fname, flen, pname, plen, pidx);
    if (r != 1) { return 0; }
    return 1;
  }
};
