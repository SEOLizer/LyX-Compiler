// bootstrap/lyu_writer.lyx — WP-BC-50a
// Serialises sema symbol table to .lyu pre-compiled unit format (version 2).
// Format matches S0 unit_format.pas / TLyuxSerializer::Serialize.

import src.sema;
import src.ir;          // #1974: IR_MOD_OFF_* fuer den IR-Abschnitt
import src.parser;      // #1971: NODE_OFF_* / PARSER_NODE_SIZE fuer den AST-Lauf
import src.std.alloc;

// Magic 'LYU\0'
con LYU_W_M0: int64 := 76;
con LYU_W_M1: int64 := 89;
con LYU_W_M2: int64 := 85;
con LYU_W_M3: int64 := 0;
con LYU_W_VER: int64 := 2;

// #1974: Fassung des IR-Abschnitts. Eigenstaendig gezaehlt, damit sich das IR
// weiterentwickeln kann, ohne die Fassung der .lyu selbst anzufassen — ein
// Leser, der die Zahl nicht kennt, ueberspringt den Abschnitt.
pub con LYU_IR_VER: int64 := 1;

// TLyuxArch codes (must match S0 unit_format.pas)
pub con LYU_ARCH_X86_64:     int64 := 0;
pub con LYU_ARCH_ARM64:      int64 := 1;
pub con LYU_ARCH_X86_64_WIN: int64 := 2;
pub con LYU_ARCH_MACOSX64:   int64 := 3;
pub con LYU_ARCH_RISCV64:    int64 := 4;
pub con LYU_ARCH_XTENSA:     int64 := 5;
pub con LYU_ARCH_WIN_ARM64:  int64 := 6;
pub con LYU_ARCH_ARM_CM:     int64 := 7;

// TLyuxSymbolKind codes
con LSK_FN:        int64 := 0;
con LSK_VAR:       int64 := 1;
con LSK_CON:       int64 := 3;
con LSK_STRUCT:    int64 := 4;
con LSK_ENUM:      int64 := 6;
con LSK_UTYPE:     int64 := 9;

pub type LyuWriter = class {
  buf: int64;
  len: int64;
  cap: int64;
  // #1555: Debug-Abschnitt mitschreiben (--debug-symbols). Bis 1.1.0A hatte
  // das Format kein Feld dafuer, also erzeugte `--compile-unit
  // --debug-symbols` eine byte-identische Datei.
  includeDebug: int64;
  dbgOffPos:    int64;   // Position des DebugOffset-Feldes im Puffer
  // #1974: IR-Abschnitt. Das Feld `IRCodeOffset` steht seit jeher im Kopf und
  // wurde immer als 0 geschrieben — die .lyu trug damit Namen und Typen, aber
  // keinen Code. `irModulPtr` ist das zu schreibende IRModule (0 = keines).
  irOffPos:   int64;
  irModulPtr: int64;
  // #1971: RESSOURCEN. Bisher trug nur das Erzeugnis Dateien; eine Bibliothek
  // konnte keine mitbringen — wer `std.icons` importierte, bekam deren
  // Symbole, aber keine Icons. Der Abschnitt liegt wie der Debug- und der
  // IR-Abschnitt am ENDE, sein Offset im bisher reservierten U32 des Kopfes.
  // Ein Leser, der ihn nicht kennt, hoert nach der Symboltabelle auf und
  // liest die Datei unveraendert; die Version bleibt 2.
  //
  // Eintraege: {namePtr, nameLen, pfadPtr, pfadLen} zu je 32 Byte. Die BYTES
  // liest der Schreiber selbst — im Erzeugnis des Nutzers gibt es den Pfad
  // nicht mehr, also muss der Inhalt in die Datei.
  resOffPos:  int64;
  resList:    int64;
  resCount:   int64;
  resCap:     int64;

  // #2014 Stufe 1: Werte der Modulkonstanten.
  //
  // Bis 1.2.5G trug eine `.lyu` Namen und Typen, aber KEINE Werte — der
  // Codegen brach beim Import ohne Quelle ausdruecklich ab ("Ohne diesen
  // Abbruch kaeme jede Konstante daraus still als 0 an"). Genau diese Luecke
  // schliesst der Abschnitt.
  //
  // Records: 32 Byte {namePtr, nameLen, art, wert}. art 0 = Ganzzahl (wert ist
  // der Zahlenwert), 1 = Zeichenkette (wert ist Zeiger auf den Text,
  // Laenge im folgenden Feld).
  konOffPos:  int64;
  konList:    int64;
  konCount:   int64;
  konCap:     int64;

  pub fn LywInit() {
    self.cap := 4096;
    self.buf := alloc(self.cap);
    self.len := 0;
    self.includeDebug := 0;
    self.dbgOffPos    := 0;
    self.irOffPos     := 0;   // #1974
    self.irModulPtr   := 0;
    self.resOffPos    := 0;   // #1971
    self.konOffPos    := 0;   // #2014
    self.konList      := 0;
    self.konCount     := 0;
    self.konCap       := 0;
    self.resList      := 0;
    self.resCount     := 0;
    self.resCap       := 0;
  }

  // #1971: vor Serialize aufrufen, je `@resource` der Unit einmal. Ohne
  // Ressourcen bleibt der Abschnitt weg und die Datei ist byte-identisch zu
  // einer ohne diese Erweiterung.
  // #1971: Die `@resource`-Angaben der Unit aus dem AST einsammeln.
  //
  // Der Schreiber laeuft die Knoten selbst, statt den Aufrufer eine Liste
  // bauen zu lassen: die Versaetze sind in src/parser.lyx oeffentlich, und so
  // bleibt die Kenntnis des Knotenformats an EINER Stelle statt an zweien.
  //
  // Nur die OBERSTE Ebene — `@resource` steht dort, wie `@embed` in einem
  // Ausdruck steht. Ein Knoten tiefer waere keine Unit-Ressource mehr.
  // #1971: relativen Pfad auf die Quelldatei beziehen und nullterminieren.
  // Dieselbe Rechnung wie cg_embedPfad im Codegen — die beiden muessen
  // uebereinstimmen, sonst findet der eine eine Datei, die der andere nicht
  // findet, und dieselbe Bibliothek traegt je nach Weg andere Bytes.
  fn _pfadAufloesen(rel: pchar, relLen: int64, quelle: pchar): pchar {
    // Ein absoluter Pfad bleibt, wie er ist.
    if (relLen > 0 && StrCharAt(rel, 0) == 47) {
      var abuf: int64 := alloc(relLen + 1);
      var ai: int64 := 0;
      while (ai < relLen) { poke8(abuf + ai, StrCharAt(rel, ai)); ai := ai + 1; }
      poke8(abuf + relLen, 0);
      return abuf as pchar;
    }
    var qLen: int64 := 0;
    if (quelle != 0 as pchar) { qLen := StrLen(quelle); }
    var dirLen: int64 := 0;
    var si: int64 := 0;
    while (si < qLen) {
      if (StrCharAt(quelle, si) == 47) { dirLen := si + 1; }
      si := si + 1;
    }
    var tot: int64 := dirLen + relLen;
    var buf: int64 := alloc(tot + 1);
    var i: int64 := 0;
    while (i < dirLen) { poke8(buf + i, StrCharAt(quelle, i)); i := i + 1; }
    var j: int64 := 0;
    while (j < relLen) { poke8(buf + dirLen + j, StrCharAt(rel, j)); j := j + 1; }
    poke8(buf + tot, 0);
    return buf as pchar;
  }

  pub fn LywSammleRessourcen(nodes: int64, astRoot: int64, src: pchar) {
    var cur: int64 := astRoot;
    while (cur >= 0) {
      var off: int64 := nodes + cur * PARSER_NODE_SIZE;
      if (peek64(off) == NK_RESOURCE) {
        var pfN: int64 := peek64(off + NODE_OFF_C0);
        if (pfN >= 0) {
          var pOff: int64 := nodes + pfN * PARSER_NODE_SIZE;
          self.LywAddResource(src + peek64(off + NODE_OFF_SVAL),
                              peek64(off + NODE_OFF_SLEN),
                              src + peek64(pOff + NODE_OFF_SVAL),
                              peek64(pOff + NODE_OFF_SLEN));
        }
      }
      cur := peek64(off + NODE_OFF_NEXT);
    }
  }

  pub fn LywAddResource(nm: pchar, nmLen: int64, pf: pchar, pfLen: int64) {
    if (self.resCount >= self.resCap) {
      var nc: int64 := self.resCap * 2;
      if (nc < 8) { nc := 8; }
      var nb: int64 := alloc(nc * 32);
      if (self.resCount > 0) { memcpy(nb, self.resList, self.resCount * 32); }
      self.resList := nb;
      self.resCap  := nc;
    }
    var b: int64 := self.resList + self.resCount * 32;
    poke64(b,      nm as int64);
    poke64(b + 8,  nmLen);
    poke64(b + 16, pf as int64);
    poke64(b + 24, pfLen);
    self.resCount := self.resCount + 1;
  }

  // #2014 Stufe 1: Werte der Modulkonstanten aus dem AST einsammeln.
  //
  // Wie LywSammleRessourcen selbst ueber den Baum, statt eine neue sema-API
  // zu verlangen: sema fuehrt die Konstanten als Symbole, aber ohne Wert.
  //
  // Gefaltet wird NUR, was sich sicher ausrechnen laesst — Ganzzahlliterale
  // mit optionalem unaerem Minus und Zeichenkettenliterale. Alles andere
  // bleibt DRAUSSEN, statt geraten zu werden: eine Konstante, die mit einem
  // falschen Wert in der Bibliothek steht, ist schlimmer als eine, die fehlt
  // (der Leser merkt das Fehlen, den falschen Wert nicht).
  // #2014: Ganzzahlausdruck zur Uebersetzungszeit ausrechnen.
  //
  // `0 - 7` ist in Lyx die uebliche Schreibweise fuer eine negative Zahl (ein
  // Minusliteral gibt es nicht) — ohne diese Faltung fiele jede negative
  // Konstante aus der Bibliothek heraus. Dieselbe Aufzaehlung wie
  // _constFaltbar/_constWert in ir_lower; die beiden muessen uebereinstimmen.
  //
  // Rueckgabe ueber `okBox`: 0 = nicht ausrechenbar. Ein Rueckgabewert allein
  // taugt nicht, weil 0 ein GUELTIGES Ergebnis ist (#1798 lief genau darauf
  // hinaus).
  fn _konWert(nodes: int64, n: int64, okBox: int64): int64 {
    poke64(okBox, 0);
    if (n < 0) { return 0; }
    var off: int64 := nodes + n * PARSER_NODE_SIZE;
    var k:   int64 := peek64(off);
    if (k == NK_LIT_INT) { poke64(okBox, 1); return peek64(off + NODE_OFF_IVAL); }
    if (k == NK_UNOP) {
      var uo: int64 := peek64(off + NODE_OFF_IVAL);
      var uOk: int64 := alloc(8);
      var uv: int64 := self._konWert(nodes, peek64(off + NODE_OFF_C0), uOk);
      if (peek64(uOk) == 0) { return 0; }
      if (uo == 71) { poke64(okBox, 1); return 0 - uv; }
      if (uo == 92) { poke64(okBox, 1); return 0 - uv - 1; }   // ~v
      return 0;
    }
    if (k == NK_BINOP) {
      var bo: int64 := peek64(off + NODE_OFF_IVAL);
      var aOk: int64 := alloc(8);
      var bOk: int64 := alloc(8);
      var av: int64 := self._konWert(nodes, peek64(off + NODE_OFF_C0), aOk);
      var bv: int64 := self._konWert(nodes, peek64(off + NODE_OFF_C1), bOk);
      if (peek64(aOk) == 0 || peek64(bOk) == 0) { return 0; }
      if (bo == 70) { poke64(okBox, 1); return av + bv; }
      if (bo == 71) { poke64(okBox, 1); return av - bv; }
      if (bo == 72) { poke64(okBox, 1); return av * bv; }
      // Division durch null wird NICHT gefaltet: der Wert bleibt draussen,
      // statt hier still 0 zu werden.
      if (bo == 73) { if (bv == 0) { return 0; } poke64(okBox, 1); return av / bv; }
      if (bo == 74) { if (bv == 0) { return 0; } poke64(okBox, 1); return av % bv; }
      if (bo == 89) { poke64(okBox, 1); return av ^ bv; }
      if (bo == 90) { poke64(okBox, 1); return av & bv; }
      if (bo == 91) { poke64(okBox, 1); return av | bv; }
      if (bo == 93) { poke64(okBox, 1); return av << bv; }
      if (bo == 94) { poke64(okBox, 1); return av >> bv; }
      return 0;
    }
    return 0;
  }

  pub fn LywSammleKonstanten(nodes: int64, astRoot: int64, src: pchar) {
    var cur: int64 := astRoot;
    while (cur >= 0) {
      var off: int64 := nodes + cur * PARSER_NODE_SIZE;
      if (peek64(off) == NK_CON_DECL) {
        var initN: int64 := peek64(off + NODE_OFF_C1);
        if (initN >= 0) {
          var iOff: int64 := nodes + initN * PARSER_NODE_SIZE;
          var iK:   int64 := peek64(iOff);
          var kOk:  int64 := alloc(8);
          var kv:   int64 := self._konWert(nodes, initN, kOk);
          if (peek64(kOk) != 0) {
            self.LywAddKonstante(src + peek64(off + NODE_OFF_SVAL),
                                 peek64(off + NODE_OFF_SLEN),
                                 0, kv, 0);
          } else if (iK == NK_LIT_STR) {
            // In die Bibliothek gehoert der WERT, nicht die Schreibweise:
            // Anfuehrungszeichen weg, `c`-Suffix weg, Escapes aufgeloest.
            // Sonst muesste jeder Leser die Quelltextregeln noch einmal
            // kennen — und die beiden liefen auseinander.
            var roh: int64 := (src as int64) + peek64(iOff + NODE_OFF_SVAL);
            var rlen: int64 := peek64(iOff + NODE_OFF_SLEN);
            var tEnd: int64 := rlen - 1;                 // schliessendes "
            if (rlen >= 2) {
              if (peek8(roh + rlen - 1) == 99) { tEnd := rlen - 2; }   // c-Suffix
            }
            var tBuf: int64 := alloc(rlen + 2);
            var tOut: int64 := 0;
            var ti:   int64 := 1;                        // oeffnendes " ueberspringen
            while (ti < tEnd) {
              var tc: int64 := peek8(roh + ti);
              if (tc == 92 && ti + 1 < tEnd) {
                var tn: int64 := peek8(roh + ti + 1);
                if (tn == 110)      { tc := 10; ti := ti + 1; }
                else if (tn == 116) { tc := 9;  ti := ti + 1; }
                else if (tn == 114) { tc := 13; ti := ti + 1; }
                else if (tn == 92)  { tc := 92; ti := ti + 1; }
                else if (tn == 34)  { tc := 34; ti := ti + 1; }
                else if (tn == 48)  { tc := 0;  ti := ti + 1; }
              }
              poke8(tBuf + tOut, tc);
              tOut := tOut + 1;
              ti := ti + 1;
            }
            self.LywAddKonstante(src + peek64(off + NODE_OFF_SVAL),
                                 peek64(off + NODE_OFF_SLEN),
                                 1, tBuf, tOut);
          }
        }
      }
      cur := peek64(off + NODE_OFF_NEXT);
    }
  }

  // Records: 32 Byte {namePtr, nameLen, art, wert} + Textlaenge im vierten
  // Feld, wenn art == 1.
  pub fn LywAddKonstante(nm: pchar, nmLen: int64, art: int64, wert: int64, txtLen: int64) {
    if (self.konCount >= self.konCap) {
      var nc: int64 := self.konCap * 2;
      if (nc < 8) { nc := 8; }
      var nb: int64 := alloc(nc * 40);
      if (self.konCount > 0) { memcpy(nb, self.konList, self.konCount * 40); }
      self.konList := nb;
      self.konCap  := nc;
    }
    var b: int64 := self.konList + self.konCount * 40;
    poke64(b,      nm as int64);
    poke64(b + 8,  nmLen);
    poke64(b + 16, art);
    poke64(b + 24, wert);
    poke64(b + 32, txtLen);
    self.konCount := self.konCount + 1;
  }

  // #1555: vor Serialize aufrufen.
  pub fn LywSetDebug(on: int64) { self.includeDebug := on; }

  // #1974: vor Serialize aufrufen. Ohne IR-Modul bleibt der Abschnitt weg und
  // die Datei ist byte-identisch zu einer ohne diese Erweiterung.
  pub fn LywSetIR(irMod: int64) { self.irModulPtr := irMod; }

  fn _grow() {
    var nc: int64 := self.cap * 2;
    var nb: int64 := alloc(nc);
    var i: int64 := 0;
    while (i < self.len) { poke8(nb + i, peek8(self.buf + i)); i := i + 1; }
    self.buf := nb;
    self.cap := nc;
  }

  fn _e8(v: int64) {
    if (self.len >= self.cap) { self._grow(); }
    poke8(self.buf + self.len, v & 255);
    self.len += 1;
  }

  fn _e16le(v: int64) {
    self._e8(v); self._e8(v >> 8);
  }

  fn _e32le(v: int64) {
    self._e8(v); self._e8(v >> 8); self._e8(v >> 16); self._e8(v >> 24);
  }

  // #2014: ein Konstantenwert ist ein voller int64 — ein u32 wuerde jede Zahl
  // ab 2^31 still abschneiden.
  fn _e64le(v: int64) {
    self._e8(v);       self._e8(v >> 8);  self._e8(v >> 16); self._e8(v >> 24);
    self._e8(v >> 32); self._e8(v >> 40); self._e8(v >> 48); self._e8(v >> 56);
  }

  // #1555: ein bereits geschriebenes u32 nachtragen (Offset-Feld im Kopf, das
  // erst feststeht, wenn der Abschnitt geschrieben ist).
  fn _p32le(at: int64, v: int64) {
    if (at < 0 || at + 4 > self.len) { return; }
    poke8(self.buf + at,     v & 255);
    poke8(self.buf + at + 1, (v >> 8) & 255);
    poke8(self.buf + at + 2, (v >> 16) & 255);
    poke8(self.buf + at + 3, (v >> 24) & 255);
  }

  // u16-length-prefixed UTF-8 string (matches WriteString in S0)
  fn _eStr(s: pchar, slen: int64) {
    self._e16le(slen);
    var i: int64 := 0;
    while (i < slen) { self._e8(StrCharAt(s, i)); i := i + 1; }
  }

  // djb2 hash → u32 (typeHash field)
  fn _typeHash(s: pchar, slen: int64): int64 {
    var h: int64 := 5381;
    var i: int64 := 0;
    while (i < slen) {
      h := ((h << 5) + h) + (StrCharAt(s, i) & 255);
      i += 1;
    }
    return h & 0xFFFFFFFF;
  }

  // Map sema TY_xxx → type info string stored in the symbol
  fn _tyInfoStr(typeId: int64): pchar {
    if typeId == 1  { return "void"c; }
    if typeId == 2  { return "bool"c; }
    if typeId == 3  { return "int64"c; }
    if typeId == 4  { return "pchar"c; }
    if typeId == 5  { return "float64"c; }
    if typeId == 6  { return "int32"c; }
    if typeId == 7  { return "array"c; }
    if typeId == 9  { return "int8"c; }
    if typeId == 10 { return "int16"c; }
    if typeId == 11 { return "uint8"c; }
    if typeId == 12 { return "uint16"c; }
    if typeId == 13 { return "uint32"c; }
    if typeId == 14 { return "uint64"c; }
    if typeId == 15 { return "float32"c; }
    if typeId == 16 { return "char"c; }
    if typeId == 19 { return "fn_ptr"c; }
    if typeId == 20 { return "closure"c; }
    return "user"c;
  }

  // Map sema SYM_xxx → LYU LSK_xxx
  fn _symToLsk(semaKind: int64): int64 {
    if semaKind == SYM_FUNC   { return LSK_FN; }
    if semaKind == SYM_VAR    { return LSK_VAR; }
    if semaKind == SYM_CON    { return LSK_CON; }
    if semaKind == SYM_STRUCT { return LSK_STRUCT; }
    if semaKind == SYM_ENUM   { return LSK_ENUM; }
    if semaKind == SYM_TYPE   { return LSK_UTYPE; }
    return LSK_VAR;
  }

  // Derive unit name: strip directory and .lyx extension from path.
  // Uses StrSub builtin — no manual mmap needed.
  fn _unitNameFromPath(srcPath: pchar): pchar {
    var slen: int64 := StrLen(srcPath);
    var lastSlash: int64 := -1;
    var i: int64 := 0;
    while (i < slen) {
      if (StrCharAt(srcPath, i) == 47) { lastSlash := i; }
      i += 1;
    }
    var lastDot: int64 := slen;
    i := slen - 1;
    while (i > lastSlash) {
      if (StrCharAt(srcPath, i) == 46) { lastDot := i; break; }
      i -= 1;
    }
    var nameStart: int64 := lastSlash + 1;
    var nameLen:   int64 := lastDot - nameStart;
    if (nameLen <= 0) { return srcPath; }
    return StrSub(srcPath, nameStart, nameLen);
  }

  // #1974: einen Puffer des IR-Moduls anhaengen — erst die Anzahl BYTES, dann
  // die Bytes selbst.
  //
  // ACHTUNG, die Laengenfelder des IR-Moduls zaehlen NICHT einheitlich:
  //
  //   instrLen, funcLen, globalLen, captureLen  → Anzahl der SAETZE
  //   strLen, labelLen                          → Anzahl der BYTES
  //
  // Beide Formen stehen unkommentiert nebeneinander in ir.lyx (nur die
  // Kopfkommentare bei +112/+136 sagen "count"), und lbf_writer.lyx rechnet
  // es entsprechend um (`instrBuf + ii * IR_INSTR_SIZE` bei `ii < instrLen`).
  // Wer alles fuer Bytes haelt, schreibt einen Abschnitt, der uebersetzt und
  // beim Lesen Unsinn ergibt — genau das war der erste Wurf hier: `instr 7
  // Byte`, `func 1 Byte`.
  //
  // `satzGroesse` ist deshalb 1 fuer die byteweise gefuehrten Puffer und die
  // Satzgroesse fuer die anderen.
  fn _eIrPuffer(bufOff: int64, lenOff: int64, satzGroesse: int64) {
    var b: int64 := peek64(self.irModulPtr + bufOff);
    var n: int64 := peek64(self.irModulPtr + lenOff) * satzGroesse;
    if (b == 0 || n <= 0) { self._e32le(0); return; }
    self._e32le(n);
    var i: int64 := 0;
    while (i < n) { self._e8(peek8(b + i)); i := i + 1; }
  }

  // Serialize sema symbol table into the internal buffer.
  // arch: one of LYU_ARCH_* constants.
  pub fn Serialize(inputPath: pchar, sema: Sema, arch: int64) {
    // Count exportable symbols (skip BUILTIN=0, PARAM=4, FIELD=7)
    var symCount:  int64 := 0;
    var funcCount: int64 := 0;
    var total:     int64 := sema.SymCount();
    var si: int64 := 0;
    while (si < total) {
      var kind: int64 := sema.SymKind(si);
      if (kind != SYM_BUILTIN && kind != SYM_PARAM && kind != SYM_FIELD) {
        symCount += 1;
        if (kind == SYM_FUNC) { funcCount := funcCount + 1; }
      }
      si += 1;
    }

    // Unit name from source path
    var unPtr:  pchar := self._unitNameFromPath(inputPath);
    var unLenV: int64 := StrLen(unPtr);

    // ── Header ──
    self._e8(LYU_W_M0); self._e8(LYU_W_M1);
    self._e8(LYU_W_M2); self._e8(LYU_W_M3);
    self._e16le(LYU_W_VER);
    self._e8(arch);
    // flags: bit0 = Debug-Abschnitt (#1555), bit1 = Ressourcen (#1971)
    var flags: int64 := self.includeDebug & 1;
    if (self.resCount > 0) { flags := flags | 2; }
    self._e8(flags);

    // Unit name
    self._eStr(unPtr, unLenV);

    // v2 metadata (empty)
    self._eStr(""c, 0);
    self._eStr(""c, 0);
    self._eStr(""c, 0);

    // Symbol count + offset placeholders
    self._e32le(symCount);
    // #2014 Stufe 1: das Feld hiess TypeInfoOffset und stand seit jeher auf 0.
    // Es traegt jetzt den Konstantenabschnitt — Konstantenwerte sind der erste
    // Teil der Strukturinformationen, fuer die es vorgesehen war.
    self.konOffPos := self.len;
    self._e32le(0);  // KonstantenOffset (0 = keine)
    self.irOffPos := self.len;   // #1974: hierhin kommt der Offset am Ende
    self._e32le(0);  // IRCodeOffset
    self.dbgOffPos := self.len;   // #1555: hierhin kommt der Offset am Ende
    self._e32le(0);  // DebugOffset
    self.resOffPos := self.len;   // #1971: das bisher reservierte U32
    self._e32le(0);  // ResourceOffset (0 = keine Ressourcen)

    // ── Symbol table ──
    si := 0;
    while (si < total) {
      var kind: int64 := sema.SymKind(si);
      if (kind != SYM_BUILTIN && kind != SYM_PARAM && kind != SYM_FIELD) {
        var symName:    pchar := sema.SymName(si);
        var symNameLen: int64 := sema.SymNameLen(si);
        // #1966: Fuer eine FUNKTION ist der Rueckgabetyp gemeint. SymTypeId
        // liefert dort immer TY_VOID (so werden Funktionen eingetragen);
        // deshalb stand in jeder .lyu und in jeder `--unit-info`-Ausgabe
        // `void`, auch bei `std/math.lyu`.
        var typeId:     int64 := sema.SymReturnType(si);
        var tiPtr:      pchar := self._tyInfoStr(typeId);
        var tiLen:      int64 := StrLen(tiPtr);
        var lsk:        int64 := self._symToLsk(kind);
        var thash:      int64 := self._typeHash(tiPtr, tiLen);
        self._eStr(symName, symNameLen);
        self._e8(lsk);
        self._e32le(thash);
        self._eStr(tiPtr, tiLen);
      }
      si += 1;
    }

    // ── Placeholder sections (matches S0 Serialize) ──
    self._e32le(0);          // strings count = 0
    self._e32le(funcCount);  // function count
    self._e32le(0);          // globals count = 0

    // ── IR-Abschnitt (#1974) ───────────────────────────────────────────
    //
    // Bis 1.2.3B trug eine `.lyu` NAMEN und TYPEN, aber keinen Code: das Feld
    // `IRCodeOffset` stand im Kopf und wurde immer als 0 geschrieben. Eine
    // allein ausgelieferte Unit lieferte deshalb keine einzige Funktion.
    //
    // Geschrieben werden die fuenf Puffer des IR-Moduls roh. Das geht, WEIL
    // die Saetze untereinander mit OFFSETS verweisen und nicht mit Zeigern
    // (IR_INSTR_OFF_STROFF, IR_FUNC_OFF_INSTRSOFF …) — nachgesehen in
    // src/ir.lyx. Ein einziger absoluter Zeiger darin, und diese Uebertragung
    // waere still falsch: sie uebersetzte fehlerfrei und liefe beim ersten
    // Zugriff in eine fremde Adresse.
    //
    // Aufbau: Magic "LYIR", Fassung, dann je Puffer die LAENGE und die Bytes.
    // Die Laenge steht VOR den Bytes, damit ein Leser den Abschnitt auch dann
    // ueberspringen kann, wenn er eine spaetere Fassung nicht kennt.
    if (self.irModulPtr != 0) {
      var irStart: int64 := self.len;
      self._p32le(self.irOffPos, irStart);
      self._e8(76); self._e8(89); self._e8(73); self._e8(82);   // "LYIR"
      self._e32le(LYU_IR_VER);
      // Zaehlweise je Puffer — siehe _eIrPuffer.
      self._e32le(peek64(self.irModulPtr + IR_MOD_OFF_INSTRLEN));    // Saetze
      self._e32le(peek64(self.irModulPtr + IR_MOD_OFF_FUNCLEN));     // Saetze
      self._e32le(peek64(self.irModulPtr + IR_MOD_OFF_GLOBALLEN));   // Saetze
      self._eIrPuffer(IR_MOD_OFF_INSTRBUF,   IR_MOD_OFF_INSTRLEN,   IR_INSTR_SIZE);
      self._eIrPuffer(IR_MOD_OFF_STRBUF,     IR_MOD_OFF_STRLEN,     1);
      self._eIrPuffer(IR_MOD_OFF_LABELBUF,   IR_MOD_OFF_LABELLEN,   1);
      self._eIrPuffer(IR_MOD_OFF_FUNCBUF,    IR_MOD_OFF_FUNCLEN,    IR_FUNC_SIZE);
      self._eIrPuffer(IR_MOD_OFF_GLOBALBUF,  IR_MOD_OFF_GLOBALLEN,  8);
      self._eIrPuffer(IR_MOD_OFF_CAPTUREBUF, IR_MOD_OFF_CAPTURELEN, 8);
    }

    // ── Debug-Abschnitt (#1555) ────────────────────────────────────────
    // Optional und am ENDE, mit Offset und Laenge im Kopf: ein Leser, der ihn
    // nicht kennt, hoert nach der Symboltabelle auf und liest die Datei
    // unveraendert. Inhalt: Quelldatei und je Funktion die Startzeile —
    // dieselben Angaben, die cg.debugMode im ELF ablegt.
    if (self.includeDebug != 0) {
      var dbgStart: int64 := self.len;
      self._p32le(self.dbgOffPos, dbgStart);
      self._eStr(inputPath, StrLen(inputPath));
      var lenPos: int64 := self.len;
      self._e32le(0);                 // Anzahl Eintraege, gleich nachgetragen
      var written: int64 := 0;
      si := 0;
      while (si < total) {
        if (sema.SymKind(si) == SYM_FUNC) {
          self._eStr(sema.SymName(si), sema.SymNameLen(si));
          var ln: int64 := sema.SymLine(si);
          if (ln < 0) { ln := 0; }    // importiert/eingebaut: keine Zeile
          self._e32le(ln);
          written += 1;
        }
        si += 1;
      }
      self._p32le(lenPos, written);
    }

    // ── Konstanten-Abschnitt (#2014 Stufe 1) ───────────────────────────
    //
    // Aufbau: Anzahl (u32), dann je Eintrag Name (_eStr), Art (u8) und
    // entweder der Zahlenwert (i64, little endian) oder der Text (_eStr).
    //
    // Ohne diesen Abschnitt bleibt der Offset 0 und die Datei ist
    // byte-identisch zu einer ohne die Erweiterung — dasselbe Versprechen wie
    // beim Debug- (#1555), IR- (#1974) und Ressourcenabschnitt (#1971).
    if (self.konCount > 0) {
      var konStart: int64 := self.len;
      self._p32le(self.konOffPos, konStart);
      self._e32le(self.konCount);
      var ki: int64 := 0;
      while (ki < self.konCount) {
        var kb:  int64 := self.konList + ki * 40;
        var knm: pchar := peek64(kb) as pchar;
        var knl: int64 := peek64(kb + 8);
        var kart: int64 := peek64(kb + 16);
        self._eStr(knm, knl);
        self._e8(kart);
        if (kart == 0) {
          self._e64le(peek64(kb + 24));
        } else {
          // Der Text ist beim Einsammeln bereits aufgeloest worden.
          self._eStr(peek64(kb + 24) as pchar, peek64(kb + 32));
        }
        ki += 1;
      }
    }

    // ── Ressourcen-Abschnitt (#1971) ───────────────────────────────────
    // Wie der Debug-Abschnitt: optional, am ENDE, Offset im Kopf. Neu ist,
    // dass hier NUTZDATEN liegen und nicht nur Metadaten — die Bytes muessen
    // mit, weil es den Pfad auf dem Rechner des Nutzers nicht mehr gibt.
    //
    // Aufbau: Anzahl (u32), dann je Eintrag Name (_eStr), Laenge (u32),
    // Bytes. Die Laenge steht ausdruecklich da und nicht als
    // Nullterminierung: eine Ressource ist eine BINAERdatei und darf
    // Nullbytes tragen — genau daran ist die IR-Zeichenkettentabelle vor
    // #1968 gescheitert.
    if (self.resCount > 0) {
      var resStart: int64 := self.len;
      self._p32le(self.resOffPos, resStart);
      self._e32le(self.resCount);
      var ri: int64 := 0;
      while (ri < self.resCount) {
        var rb: int64 := self.resList + ri * 32;
        var rnm: pchar := peek64(rb) as pchar;
        var rnl: int64 := peek64(rb + 8);
        var rpfRel: pchar := peek64(rb + 16) as pchar;
        var rpfLen: int64 := peek64(rb + 24);
        self._eStr(rnm, rnl);
        // Der Pfad steht als AUSSCHNITT im Quelltextpuffer: nicht
        // nullterminiert und relativ zur Quelldatei. `open` braucht beides
        // anders — also auflösen wie cg_embedPfad, mit demselben Ergebnis.
        var rpf: pchar := self._pfadAufloesen(rpfRel, rpfLen, inputPath);
        // Datei lesen. FEHLT sie, ist das ein harter Fehler mit Pfad in der
        // Meldung — ein stiller Ersatz (Laenge 0) waere die schlimmste
        // Antwort: die Bibliothek liesse sich bauen, und erst beim Nutzer
        // faende sich eine leere Ressource ohne jeden Hinweis.
        var fd: int64 := open(rpf, 0, 0);
        if (fd < 0) {
          EPrintStr("error: @resource: Datei nicht lesbar: "c);
          EPrintStrLn(rpf);
          exit(1);
        }
        var gr: int64 := lseek(fd, 0, 2);
        lseek(fd, 0, 0);
        if (gr < 0) { close(fd); EPrintStrLn("error: @resource: Groesse nicht bestimmbar"c); exit(1); }
        self._e32le(gr);
        if (gr > 0) {
          var bufp: int64 := alloc(gr);
          var gelesen: int64 := read(fd, bufp as pchar, gr);
          close(fd);
          if (gelesen != gr) {
            EPrintStr("error: @resource: unvollstaendig gelesen: "c);
            EPrintStrLn(rpf);
            exit(1);
          }
          var bi: int64 := 0;
          while (bi < gr) { self._e8(peek8(bufp + bi)); bi := bi + 1; }
          free(bufp, gr);
        } else {
          close(fd);
        }
        ri := ri + 1;
      }
    }
  }

  // Write buffer to file. Returns true on success.
  pub fn WriteFile(path: pchar): bool {
    // O_WRONLY(1)|O_CREAT(64)|O_TRUNC(512) = 577, mode 0644 = 420
    var fd: int64 := open(path, 577, 420);
    if (fd < 0) { return false; }
    var written: int64 := write(fd, self.buf as pchar, self.len);
    close(fd);
    return written == self.len;
  }

};
