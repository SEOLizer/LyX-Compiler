// bootstrap/lyu_writer.lyx — WP-BC-50a
// Serialises sema symbol table to .lyu pre-compiled unit format (version 2).
// Format matches S0 unit_format.pas / TLyuxSerializer::Serialize.
//
// ── Belegung des Kopfes (Stand #2014 Stufe 4) ──────────────────────────────
//
//   4    Magic "LYU\0"
//   u16  Version (= 2)
//   u8   Architektur (LYU_ARCH_*)
//   u8   Flags
//          bit0 (1)  Debug-Abschnitt                     #1555
//          bit1 (2)  Ressourcen-Abschnitt                #1971
//          bit2 (4)  -- frei, NICHT von #2014 belegt (fuer #1971/#2142 freigehalten)
//          bit3 (8)  -- frei
//          bit4 (16) Deklarationen im TypeInfo-Abschnitt  #2014 Stufen 2–4
//          bit5–7    -- frei
//   str  Unit-Name, dann drei leere v2-Metadatenfelder
//   u32  symCount
//   u32  TypeInfoOffset  -> Konstanten (#2014 Stufe 1) und, bei Flag bit4,
//                           direkt dahinter die Deklarationen (Stufen 2–4)
//   u32  IRCodeOffset    (#1974)
//   u32  DebugOffset     (#1555)
//   u32  ResourceOffset  (#1971, war "Reserved") — von #2014 NICHT benutzt
//
// Die Deklarationen brauchen KEIN eigenes Kopffeld: sie haengen im selben
// Abschnitt wie die Konstanten hinter deren letztem Eintrag. Ein Leser, der
// bit4 nicht kennt, liest die Konstanten wie bisher und hoert dort auf.
//
// ── Deklarationsabschnitt (#2014 Stufen 2–4) ──────────────────────────────
//
//   u32  Anzahl Eintraege
//   je Eintrag:
//     u8   Art   (2 = Funktion, 3 = Struct, 4 = Klasse, 7 = Import)
//     u32  Laenge des Rests in Byte — ein Leser UEBERSPRINGT unbekannte Arten
//     str  Name  (Bindung ueber den NAMEN, nicht ueber den Symbolindex)
//     ...  artabhaengiger Rumpf:
//
//   Signatur (Art 2 und je Methode in Art 4):
//     str  Rueckgabetyp als NAME ("" = keiner), z. B. "TPunkt" statt "user"
//     u16  Anzahl Parameter
//     je Parameter: str Name, str Typ, u8 Flags (bit0 Vorgabewert, bit1 con,
//                   bit2 ref), bei bit0: str Vorgabe (Quelltext eines
//                   gefalteten Werts, z. B. "5", "(0 - 6 - 1)", "true", "2.5")
//     u8   Flags (heute 0 — extern, generisch und variadisch werden nicht
//               beschrieben, sondern fehlen; siehe LywSammleDeklarationen)
//
//   Art 3 (Struct):
//     u32  Gesamtgroesse in Byte, u8 Flags (0)
//     u16  Anzahl Felder, je Feld: str Name, str Typ, u32 Offset, u32 Groesse,
//          u8 Flags (Feld-iVal & 0x36: bit1 @big_endian, bit2 @little_endian,
//                    bits4-5 Sichtbarkeit)
//
//   Art 4 (Klasse):
//     str  Basisklasse ("" = keine)
//     u16  Anzahl Interfaces, je: str
//     u32  Gesamtgroesse
//     u8   Flags   bit0 = Felder beginnen hinter einem Typ-/VMT-Wort bei +8
//                  (TRAGEND: entscheidet ueber 0 oder 8), bit1 = abstract
//     u16  Anzahl EIGENER Felder — wie Art 3, Offsets absolut im Objekt
//     u16  Anzahl Methoden, je: str Name, u8 Flags (Methoden-iVal & 0x7F:
//          bit0 pub, bit1 virtual, bit2 override, bit3 abstract, bits4-5
//          Sichtbarkeit, bit6 static), u16 VMT-Platz, Signatur
//          VMT-Platz: 0xFFFF nicht virtuell, 0xFFFE ueberschreibt einen
//          geerbten Platz, sonst Nummer unter den NEUEN Plaetzen dieser Klasse
//          (in Deklarationsreihenfolge). Zusammen mit der Basisklasse ergibt
//          das die VMT-Ordnung.
//
//   Art 7 (Import der Unit): Name = Modulname, u8 Flags (bit0 `.*`),
//          str Alias ("" = keiner) — die Typen der Schnittstelle koennen aus
//          anderen Units stammen.
//
// Offsets und Groessen stammen aus dem BACKEND, das die Unit gerade
// uebersetzt hat (x86: Codegen, IR-Ziele: IRLower) — nicht aus einer zweiten
// Rechnung hier. Sie sind backendabhaengig (x86 legt jede Klasse ab +8 an, der
// IR-Weg nur Klassen mit VMT); der Verbraucher vergleicht sie mit seinem
// eigenen Ergebnis und MELDET eine Abweichung, statt sie zu uebernehmen.

import src.sema;
import src.ir;          // #1974: IR_MOD_OFF_* fuer den IR-Abschnitt
import src.parser;      // #1971: NODE_OFF_* / PARSER_NODE_SIZE fuer den AST-Lauf
import src.std.alloc;
import src.codegen_x86; // #2014: Layouts aus dem x86-Codegen (CgLyuTyp/CgLyuFeld)
import src.ir_lower;    // #2014: Layouts vom IR-Weg (IrLyuTyp/IrLyuFeld)

// #2014 Stufen 2–4: Flagbit des Deklarationsabschnitts (siehe Kopf oben).
pub con LYU_FLAG_DEKL: int64 := 16;
con LYU_DK_FN:     int64 := 2;
con LYU_DK_STRUCT: int64 := 3;
con LYU_DK_KLASSE: int64 := 4;
con LYU_DK_IMPORT: int64 := 7;

// Magic 'LYU\0'
con LYU_W_M0: int64 := 76;
con LYU_W_M1: int64 := 89;
con LYU_W_M2: int64 := 85;
con LYU_W_M3: int64 := 0;
con LYU_W_VER: int64 := 2;

// #1974: Fassung des IR-Abschnitts. Eigenstaendig gezaehlt, damit sich das IR
// weiterentwickeln kann, ohne die Fassung der .lyu selbst anzufassen — ein
// Leser, der die Zahl nicht kennt, ueberspringt den Abschnitt.
pub con LYU_IR_VER: int64 := 1;

// TLyuxArch codes (must match S0 unit_format.pas)
pub con LYU_ARCH_X86_64:     int64 := 0;
pub con LYU_ARCH_ARM64:      int64 := 1;
pub con LYU_ARCH_X86_64_WIN: int64 := 2;
pub con LYU_ARCH_MACOSX64:   int64 := 3;
pub con LYU_ARCH_RISCV64:    int64 := 4;
pub con LYU_ARCH_XTENSA:     int64 := 5;
pub con LYU_ARCH_WIN_ARM64:  int64 := 6;
pub con LYU_ARCH_ARM_CM:     int64 := 7;

// TLyuxSymbolKind codes
con LSK_FN:        int64 := 0;
con LSK_VAR:       int64 := 1;
con LSK_CON:       int64 := 3;
con LSK_STRUCT:    int64 := 4;
con LSK_ENUM:      int64 := 6;
con LSK_UTYPE:     int64 := 9;

pub type LyuWriter = class {
  buf: int64;
  len: int64;
  cap: int64;
  // #1555: Debug-Abschnitt mitschreiben (--debug-symbols). Bis 1.1.0A hatte
  // das Format kein Feld dafuer, also erzeugte `--compile-unit
  // --debug-symbols` eine byte-identische Datei.
  includeDebug: int64;
  dbgOffPos:    int64;   // Position des DebugOffset-Feldes im Puffer
  // #1974: IR-Abschnitt. Das Feld `IRCodeOffset` steht seit jeher im Kopf und
  // wurde immer als 0 geschrieben — die .lyu trug damit Namen und Typen, aber
  // keinen Code. `irModulPtr` ist das zu schreibende IRModule (0 = keines).
  irOffPos:   int64;
  irModulPtr: int64;
  // #1971: RESSOURCEN. Bisher trug nur das Erzeugnis Dateien; eine Bibliothek
  // konnte keine mitbringen — wer `std.icons` importierte, bekam deren
  // Symbole, aber keine Icons. Der Abschnitt liegt wie der Debug- und der
  // IR-Abschnitt am ENDE, sein Offset im bisher reservierten U32 des Kopfes.
  // Ein Leser, der ihn nicht kennt, hoert nach der Symboltabelle auf und
  // liest die Datei unveraendert; die Version bleibt 2.
  //
  // Eintraege: {namePtr, nameLen, pfadPtr, pfadLen} zu je 32 Byte. Die BYTES
  // liest der Schreiber selbst — im Erzeugnis des Nutzers gibt es den Pfad
  // nicht mehr, also muss der Inhalt in die Datei.
  resOffPos:  int64;
  resList:    int64;
  resCount:   int64;
  resCap:     int64;

  // #2014 Stufe 1: Werte der Modulkonstanten.
  //
  // Bis 1.2.5G trug eine `.lyu` Namen und Typen, aber KEINE Werte — der
  // Codegen brach beim Import ohne Quelle ausdruecklich ab ("Ohne diesen
  // Abbruch kaeme jede Konstante daraus still als 0 an"). Genau diese Luecke
  // schliesst der Abschnitt.
  //
  // Records: 32 Byte {namePtr, nameLen, art, wert}. art 0 = Ganzzahl (wert ist
  // der Zahlenwert), 1 = Zeichenkette (wert ist Zeiger auf den Text,
  // Laenge im folgenden Feld).
  konOffPos:  int64;
  konList:    int64;
  konCount:   int64;
  konCap:     int64;

  // #2035: Namen, die DIESE Unit selbst und OEFFENTLICH deklariert.
  //
  // Records: 16 Byte {namePtr, nameLen}. Ist die Liste leer (kein AST
  // uebergeben), wird NICHT gefiltert — eine `.lyu` ohne Exportliste sieht
  // dann aus wie vor dieser Aenderung.
  expList:    int64;
  expCount:   int64;
  expCap:     int64;
  expAktiv:   int64;

  // #2014 Stufen 2–4: Deklarationen (Signaturen, Struct- und Klassenlayout,
  // Importe). Records 16 Byte {art, knoten}; geschrieben wird erst in
  // Serialize, wenn die Layouts des Backends feststehen.
  dkList:   int64;
  dkCount:  int64;
  dkCap:    int64;
  dkNodes:  int64;
  dkSrc:    pchar;
  dkGtBuf:  int64;   // generische Typdeklarationen des Parsers (#2134)
  dkGtN:    int64;
  dkCg:     Codegen;   // Layoutquelle x86 (dkHatCg != 0)
  dkIr:     IRLower;   // Layoutquelle IR-Weg (dkHatIr != 0)
  dkHatCg:  int64;
  dkHatIr:  int64;
  dkBox:    int64;     // 4 x 8 Byte Rueckgabefelder der Layoutabfragen
  tb:       int64;     // Puffer fuer Typtexte
  tbLen:    int64;
  tbCap:    int64;

  pub fn LywInit() {
    self.cap := 4096;
    self.buf := alloc(self.cap);
    self.len := 0;
    self.includeDebug := 0;
    self.dbgOffPos    := 0;
    self.irOffPos     := 0;   // #1974
    self.irModulPtr   := 0;
    self.resOffPos    := 0;   // #1971
    self.expList      := 0;   // #2035
    self.expCount     := 0;
    self.expCap       := 0;
    self.expAktiv     := 0;
    self.konOffPos    := 0;   // #2014
    self.dkList       := 0;   // #2014 Stufen 2–4
    self.dkCount      := 0;
    self.dkCap        := 0;
    self.dkNodes      := 0;
    self.dkGtBuf      := 0;
    self.dkGtN        := 0;
    self.dkHatCg      := 0;
    self.dkHatIr      := 0;
    self.dkBox        := alloc(32);
    self.tbCap        := 256;
    self.tb           := alloc(self.tbCap);
    self.tbLen        := 0;
    self.konList      := 0;
    self.konCount     := 0;
    self.konCap       := 0;
    self.resList      := 0;
    self.resCount     := 0;
    self.resCap       := 0;
  }

  // #1971: vor Serialize aufrufen, je `@resource` der Unit einmal. Ohne
  // Ressourcen bleibt der Abschnitt weg und die Datei ist byte-identisch zu
  // einer ohne diese Erweiterung.
  // #1971: Die `@resource`-Angaben der Unit aus dem AST einsammeln.
  //
  // Der Schreiber laeuft die Knoten selbst, statt den Aufrufer eine Liste
  // bauen zu lassen: die Versaetze sind in src/parser.lyx oeffentlich, und so
  // bleibt die Kenntnis des Knotenformats an EINER Stelle statt an zweien.
  //
  // Nur die OBERSTE Ebene — `@resource` steht dort, wie `@embed` in einem
  // Ausdruck steht. Ein Knoten tiefer waere keine Unit-Ressource mehr.
  // #1971: relativen Pfad auf die Quelldatei beziehen und nullterminieren.
  // Dieselbe Rechnung wie cg_embedPfad im Codegen — die beiden muessen
  // uebereinstimmen, sonst findet der eine eine Datei, die der andere nicht
  // findet, und dieselbe Bibliothek traegt je nach Weg andere Bytes.
  fn _pfadAufloesen(rel: pchar, relLen: int64, quelle: pchar): pchar {
    // Ein absoluter Pfad bleibt, wie er ist.
    if (relLen > 0 && StrCharAt(rel, 0) == 47) {
      var abuf: int64 := alloc(relLen + 1);
      var ai: int64 := 0;
      while (ai < relLen) { poke8(abuf + ai, StrCharAt(rel, ai)); ai := ai + 1; }
      poke8(abuf + relLen, 0);
      return abuf as pchar;
    }
    var qLen: int64 := 0;
    if (quelle != 0 as pchar) { qLen := StrLen(quelle); }
    var dirLen: int64 := 0;
    var si: int64 := 0;
    while (si < qLen) {
      if (StrCharAt(quelle, si) == 47) { dirLen := si + 1; }
      si := si + 1;
    }
    var tot: int64 := dirLen + relLen;
    var buf: int64 := alloc(tot + 1);
    var i: int64 := 0;
    while (i < dirLen) { poke8(buf + i, StrCharAt(quelle, i)); i := i + 1; }
    var j: int64 := 0;
    while (j < relLen) { poke8(buf + dirLen + j, StrCharAt(rel, j)); j := j + 1; }
    poke8(buf + tot, 0);
    return buf as pchar;
  }

  pub fn LywSammleRessourcen(nodes: int64, astRoot: int64, src: pchar) {
    var cur: int64 := astRoot;
    while (cur >= 0) {
      var off: int64 := nodes + cur * PARSER_NODE_SIZE;
      if (peek64(off) == NK_RESOURCE) {
        var pfN: int64 := peek64(off + NODE_OFF_C0);
        if (pfN >= 0) {
          var pOff: int64 := nodes + pfN * PARSER_NODE_SIZE;
          self.LywAddResource(src + peek64(off + NODE_OFF_SVAL),
                              peek64(off + NODE_OFF_SLEN),
                              src + peek64(pOff + NODE_OFF_SVAL),
                              peek64(pOff + NODE_OFF_SLEN));
        }
      }
      cur := peek64(off + NODE_OFF_NEXT);
    }
  }

  pub fn LywAddResource(nm: pchar, nmLen: int64, pf: pchar, pfLen: int64) {
    if (self.resCount >= self.resCap) {
      var nc: int64 := self.resCap * 2;
      if (nc < 8) { nc := 8; }
      var nb: int64 := alloc(nc * 32);
      if (self.resCount > 0) { memcpy(nb, self.resList, self.resCount * 32); }
      self.resList := nb;
      self.resCap  := nc;
    }
    var b: int64 := self.resList + self.resCount * 32;
    poke64(b,      nm as int64);
    poke64(b + 8,  nmLen);
    poke64(b + 16, pf as int64);
    poke64(b + 24, pfLen);
    self.resCount := self.resCount + 1;
  }

  // #2014 Stufe 1: Werte der Modulkonstanten aus dem AST einsammeln.
  //
  // Wie LywSammleRessourcen selbst ueber den Baum, statt eine neue sema-API
  // zu verlangen: sema fuehrt die Konstanten als Symbole, aber ohne Wert.
  //
  // Gefaltet wird NUR, was sich sicher ausrechnen laesst — Ganzzahlliterale
  // mit optionalem unaerem Minus und Zeichenkettenliterale. Alles andere
  // bleibt DRAUSSEN, statt geraten zu werden: eine Konstante, die mit einem
  // falschen Wert in der Bibliothek steht, ist schlimmer als eine, die fehlt
  // (der Leser merkt das Fehlen, den falschen Wert nicht).
  // #2035: Die Namen einsammeln, die diese Unit selbst und OEFFENTLICH
  // deklariert — die Schnittstelle also.
  //
  // Bis 1.2.5H trug eine `.lyu` ALLE Symbole, die sema beim Uebersetzen sah:
  // eine Unit mit fuenf eigenen Konstanten hatte 31 Eintraege, std/math.lyu
  // hatte 112. Darunter waren
  //
  //   * FREMDE Namen (PROT_RW, MAP_ANON, ARCH_* — die Prelude-Konstanten
  //     stehen in JEDER Datei, gehoeren aber keiner Unit), und
  //   * UNIT-INTERNE Namen (in std/math.lyx etwa f64_pi, f64_pi2_hi,
  //     _sinTabelle — Zwischenwerte einer Implementierung).
  //
  // Beides ist kein Angebot an den Aufrufer. Mit den Konstantenwerten aus
  // #2014 waere das interne sogar BENUTZBAR geworden, sobald die Quelle fehlt.
  //
  // `extern fn` ist ausgenommen: eine FFI-Bindung ist eine Link-Zeit-Zusage
  // und der eigentliche Zweck solcher Units — std/audio/alsa.lyx traegt an
  // keiner ihrer snd_pcm_*-Deklarationen ein pub, bietet sie aber genau dafuer
  // an. Dieselbe Ausnahme wie in sema._checkAndRecordExports.
  pub fn LywSammleExporte(nodes: int64, astRoot: int64, src: pchar) {
    self.expAktiv := 1;
    var cur: int64 := astRoot;
    while (cur >= 0) {
      var off: int64 := nodes + cur * PARSER_NODE_SIZE;
      var k:   int64 := peek64(off);
      var nimm: int64 := 0;
      if (peek64(off + NODE_OFF_ISPUB) != 0) { nimm := 1; }
      if (k == NK_FUNC_DECL) {
        if ((peek64(off + NODE_OFF_IVAL) & 1) != 0) { nimm := 1; }   // extern fn
      }
      if (nimm != 0) {
        var nl: int64 := peek64(off + NODE_OFF_SLEN);
        if (nl > 0) { self._expAdd(src + peek64(off + NODE_OFF_SVAL), nl); }
        // #2035: Die Mitglieder eines oeffentlichen Enums gehoeren zur
        // Schnittstelle — `pub enum TAlign { AL_NONE, … }` bietet AL_NONE an.
        // Sie sind KINDknoten und stehen nicht in der Kette darueber; ohne
        // diese Schleife fehlten sie in der .lyu, obwohl der Enum pub ist.
        if (k == NK_ENUM_DECL) {
          var mem: int64 := peek64(off + NODE_OFF_C0);
          while (mem >= 0) {
            var mOff: int64 := nodes + mem * PARSER_NODE_SIZE;
            var mLen: int64 := peek64(mOff + NODE_OFF_SLEN);
            if (mLen > 0) { self._expAdd(src + peek64(mOff + NODE_OFF_SVAL), mLen); }
            mem := peek64(mOff + NODE_OFF_NEXT);
          }
        }
      }
      cur := peek64(off + NODE_OFF_NEXT);
    }
  }

  fn _expAdd(nm: pchar, nmLen: int64) {
    if (self.expCount >= self.expCap) {
      var nc: int64 := self.expCap * 2;
      if (nc < 16) { nc := 16; }
      var nb: int64 := alloc(nc * 16);
      if (self.expCount > 0) { memcpy(nb, self.expList, self.expCount * 16); }
      self.expList := nb;
      self.expCap  := nc;
    }
    var b: int64 := self.expList + self.expCount * 16;
    poke64(b,     nm as int64);
    poke64(b + 8, nmLen);
    self.expCount := self.expCount + 1;
  }

  // Gehoert der Name zur Schnittstelle? Ohne Exportliste: ja (nicht filtern).
  fn _istExport(nm: pchar, nmLen: int64): int64 {
    if (self.expAktiv == 0) { return 1; }
    var i: int64 := 0;
    while (i < self.expCount) {
      var b: int64 := self.expList + i * 16;
      if (peek64(b + 8) == nmLen) {
        var q: int64 := peek64(b);
        var gleich: int64 := 1;
        var j: int64 := 0;
        while (j < nmLen) {
          if (gleich != 0) {
            if (peek8(q + j) != peek8((nm as int64) + j)) { gleich := 0; }
          }
          j := j + 1;
        }
        if (gleich != 0) { return 1; }
      }
      i := i + 1;
    }
    return 0;
  }

  // #2014: Ganzzahlausdruck zur Uebersetzungszeit ausrechnen.
  //
  // `0 - 7` ist in Lyx die uebliche Schreibweise fuer eine negative Zahl (ein
  // Minusliteral gibt es nicht) — ohne diese Faltung fiele jede negative
  // Konstante aus der Bibliothek heraus. Dieselbe Aufzaehlung wie
  // _constFaltbar/_constWert in ir_lower; die beiden muessen uebereinstimmen.
  //
  // Rueckgabe ueber `okBox`: 0 = nicht ausrechenbar. Ein Rueckgabewert allein
  // taugt nicht, weil 0 ein GUELTIGES Ergebnis ist (#1798 lief genau darauf
  // hinaus).
  fn _konWert(nodes: int64, n: int64, okBox: int64): int64 {
    poke64(okBox, 0);
    if (n < 0) { return 0; }
    var off: int64 := nodes + n * PARSER_NODE_SIZE;
    var k:   int64 := peek64(off);
    if (k == NK_LIT_INT) { poke64(okBox, 1); return peek64(off + NODE_OFF_IVAL); }
    if (k == NK_UNOP) {
      var uo: int64 := peek64(off + NODE_OFF_IVAL);
      var uOk: int64 := alloc(8);
      var uv: int64 := self._konWert(nodes, peek64(off + NODE_OFF_C0), uOk);
      if (peek64(uOk) == 0) { return 0; }
      if (uo == 71) { poke64(okBox, 1); return 0 - uv; }
      if (uo == 92) { poke64(okBox, 1); return 0 - uv - 1; }   // ~v
      return 0;
    }
    if (k == NK_BINOP) {
      var bo: int64 := peek64(off + NODE_OFF_IVAL);
      var aOk: int64 := alloc(8);
      var bOk: int64 := alloc(8);
      var av: int64 := self._konWert(nodes, peek64(off + NODE_OFF_C0), aOk);
      var bv: int64 := self._konWert(nodes, peek64(off + NODE_OFF_C1), bOk);
      if (peek64(aOk) == 0 || peek64(bOk) == 0) { return 0; }
      if (bo == 70) { poke64(okBox, 1); return av + bv; }
      if (bo == 71) { poke64(okBox, 1); return av - bv; }
      if (bo == 72) { poke64(okBox, 1); return av * bv; }
      // Division durch null wird NICHT gefaltet: der Wert bleibt draussen,
      // statt hier still 0 zu werden.
      if (bo == 73) { if (bv == 0) { return 0; } poke64(okBox, 1); return av / bv; }
      if (bo == 74) { if (bv == 0) { return 0; } poke64(okBox, 1); return av % bv; }
      if (bo == 89) { poke64(okBox, 1); return av ^ bv; }
      if (bo == 90) { poke64(okBox, 1); return av & bv; }
      if (bo == 91) { poke64(okBox, 1); return av | bv; }
      if (bo == 93) { poke64(okBox, 1); return av << bv; }
      if (bo == 94) { poke64(okBox, 1); return av >> bv; }
      return 0;
    }
    return 0;
  }

  pub fn LywSammleKonstanten(nodes: int64, astRoot: int64, src: pchar) {
    var cur: int64 := astRoot;
    while (cur >= 0) {
      var off: int64 := nodes + cur * PARSER_NODE_SIZE;
      // #2035: nur OEFFENTLICHE Konstanten. Eine unit-interne war mit den
      // Werten aus #2014 sonst von aussen lesbar, sobald die Quelle fehlt.
      if (peek64(off) == NK_CON_DECL && peek64(off + NODE_OFF_ISPUB) != 0) {
        var initN: int64 := peek64(off + NODE_OFF_C1);
        if (initN >= 0) {
          var iOff: int64 := nodes + initN * PARSER_NODE_SIZE;
          var iK:   int64 := peek64(iOff);
          var kOk:  int64 := alloc(8);
          var kv:   int64 := self._konWert(nodes, initN, kOk);
          if (peek64(kOk) != 0) {
            self.LywAddKonstante(src + peek64(off + NODE_OFF_SVAL),
                                 peek64(off + NODE_OFF_SLEN),
                                 0, kv, 0);
          } else if (iK == NK_LIT_STR) {
            // In die Bibliothek gehoert der WERT, nicht die Schreibweise:
            // Anfuehrungszeichen weg, `c`-Suffix weg, Escapes aufgeloest.
            // Sonst muesste jeder Leser die Quelltextregeln noch einmal
            // kennen — und die beiden liefen auseinander.
            var roh: int64 := (src as int64) + peek64(iOff + NODE_OFF_SVAL);
            var rlen: int64 := peek64(iOff + NODE_OFF_SLEN);
            var tEnd: int64 := rlen - 1;                 // schliessendes "
            if (rlen >= 2) {
              if (peek8(roh + rlen - 1) == 99) { tEnd := rlen - 2; }   // c-Suffix
            }
            var tBuf: int64 := alloc(rlen + 2);
            var tOut: int64 := 0;
            var ti:   int64 := 1;                        // oeffnendes " ueberspringen
            while (ti < tEnd) {
              var tc: int64 := peek8(roh + ti);
              if (tc == 92 && ti + 1 < tEnd) {
                var tn: int64 := peek8(roh + ti + 1);
                if (tn == 110)      { tc := 10; ti := ti + 1; }
                else if (tn == 116) { tc := 9;  ti := ti + 1; }
                else if (tn == 114) { tc := 13; ti := ti + 1; }
                else if (tn == 92)  { tc := 92; ti := ti + 1; }
                else if (tn == 34)  { tc := 34; ti := ti + 1; }
                else if (tn == 48)  { tc := 0;  ti := ti + 1; }
              }
              poke8(tBuf + tOut, tc);
              tOut := tOut + 1;
              ti := ti + 1;
            }
            self.LywAddKonstante(src + peek64(off + NODE_OFF_SVAL),
                                 peek64(off + NODE_OFF_SLEN),
                                 1, tBuf, tOut);
          }
        }
      }
      cur := peek64(off + NODE_OFF_NEXT);
    }
  }

  // Records: 32 Byte {namePtr, nameLen, art, wert} + Textlaenge im vierten
  // Feld, wenn art == 1.
  pub fn LywAddKonstante(nm: pchar, nmLen: int64, art: int64, wert: int64, txtLen: int64) {
    if (self.konCount >= self.konCap) {
      var nc: int64 := self.konCap * 2;
      if (nc < 8) { nc := 8; }
      var nb: int64 := alloc(nc * 40);
      if (self.konCount > 0) { memcpy(nb, self.konList, self.konCount * 40); }
      self.konList := nb;
      self.konCap  := nc;
    }
    var b: int64 := self.konList + self.konCount * 40;
    poke64(b,      nm as int64);
    poke64(b + 8,  nmLen);
    poke64(b + 16, art);
    poke64(b + 24, wert);
    poke64(b + 32, txtLen);
    self.konCount := self.konCount + 1;
  }

  // ══ #2014 Stufen 2–4: Deklarationen ═══════════════════════════════════
  //
  // Die Schnittstelle der Unit BESCHREIBEND: Funktionssignaturen, Struct- und
  // Klassenlayout, Importe. Gesammelt werden die KNOTEN; geschrieben wird in
  // Serialize, wenn auch die Layouts des Backends feststehen.
  //
  // Was sich nicht vollstaendig beschreiben laesst, kommt NICHT hinein —
  // statt mit einer geratenen Angabe: eine generische Funktion, eine extern-
  // Bindung, ein @packed-Struct, ein Typ ausserhalb der hier bekannten
  // Formen. Der Verbraucher merkt das Fehlen (das Symbol steht in der
  // Symboltabelle, aber kein Eintrag beschreibt es) und bricht wie bisher ab;
  // eine falsche Angabe merkte er nicht.

  fn _nk(n: int64): int64  { return peek64(self.dkNodes + n * PARSER_NODE_SIZE); }
  fn _nc(n: int64, c: int64): int64 { return peek64(self.dkNodes + n * PARSER_NODE_SIZE + NODE_OFF_C0 + c * 8); }
  fn _nnx(n: int64): int64 { return peek64(self.dkNodes + n * PARSER_NODE_SIZE + NODE_OFF_NEXT); }
  fn _niv(n: int64): int64 { return peek64(self.dkNodes + n * PARSER_NODE_SIZE + NODE_OFF_IVAL); }
  fn _nsp(n: int64): pchar { return (self.dkSrc + peek64(self.dkNodes + n * PARSER_NODE_SIZE + NODE_OFF_SVAL)) as pchar; }
  fn _nsl(n: int64): int64 { return peek64(self.dkNodes + n * PARSER_NODE_SIZE + NODE_OFF_SLEN); }
  fn _npub(n: int64): int64 { return peek64(self.dkNodes + n * PARSER_NODE_SIZE + NODE_OFF_ISPUB); }

  fn _nGleich(n: int64, t: pchar, tl: int64): int64 {
    if (self._nsl(n) != tl) { return 0; }
    var p: int64 := self._nsp(n) as int64;
    var i: int64 := 0;
    while (i < tl) {
      if (peek8(p + i) != StrCharAt(t, i)) { return 0; }
      i := i + 1;
    }
    return 1;
  }

  // Ist der Knoten eine generische Typdeklaration (#2134)? Die steht nicht am
  // Knoten, sondern in der Tabelle des Parsers (GT_REC_SZ = 48, Knoten bei +0).
  fn _istGenerisch(n: int64): int64 {
    var i: int64 := 0;
    while (i < self.dkGtN) {
      if (peek64(self.dkGtBuf + i * 48) == n) { return 1; }
      i := i + 1;
    }
    return 0;
  }

  // Name mit '<' — eine Instanz eines generischen Typs ("Box<int64>").
  fn _nameHatSpitze(n: int64): int64 {
    var p: int64 := self._nsp(n) as int64;
    var l: int64 := self._nsl(n);
    var i: int64 := 0;
    while (i < l) { if (peek8(p + i) == 60) { return 1; } i := i + 1; }
    return 0;
  }

  fn _dkAdd(art: int64, n: int64) {
    if (self.dkCount >= self.dkCap) {
      var nc: int64 := self.dkCap * 2;
      if (nc < 16) { nc := 16; }
      var nb: int64 := alloc(nc * 16);
      if (self.dkCount > 0) { memcpy(nb, self.dkList, self.dkCount * 16); }
      self.dkList := nb;
      self.dkCap  := nc;
    }
    poke64(self.dkList + self.dkCount * 16, art);
    poke64(self.dkList + self.dkCount * 16 + 8, n);
    self.dkCount := self.dkCount + 1;
  }

  // gtBuf/gtN aus dem Parser (#2134), damit generische Typen erkannt werden.
  pub fn LywSammleDeklarationen(nodes: int64, astRoot: int64, src: pchar, gtBuf: int64, gtN: int64) {
    self.dkNodes := nodes;
    self.dkSrc   := src;
    self.dkGtBuf := gtBuf;
    self.dkGtN   := gtN;
    var cur: int64 := astRoot;
    while (cur >= 0) {
      var k: int64 := self._nk(cur);
      if (k == NK_IMPORT) {
        self._dkAdd(LYU_DK_IMPORT, cur);
      } else if (k == NK_FUNC_DECL && self._npub(cur) != 0) {
        // extern: eine FFI-Bindung braucht Bibliothek und Aufrufkonvention —
        // nicht beschrieben. Generisch (c3 = Typparameter): nicht beschrieben.
        var ext: int64 := self._niv(cur) & 1;
        var gen: int64 := 0;
        var tp: int64 := self._nc(cur, 3);
        if (tp >= 0) { if (self._nk(tp) == NK_TYPE_PARAM) { gen := 1; } }
        if (ext == 0 && gen == 0) { self._dkAdd(LYU_DK_FN, cur); }
      } else if (k == NK_TYPE_DECL && self._npub(cur) != 0) {
        var iv: int64 := self._niv(cur);
        var tauglich: int64 := 1;
        if ((iv & 2) != 0)  { tauglich := 0; }   // Alias
        if ((iv & 32) != 0) { tauglich := 0; }   // Interface
        if (self._istGenerisch(cur) != 0)   { tauglich := 0; }
        if (self._nameHatSpitze(cur) != 0)  { tauglich := 0; }
        if (tauglich != 0) {
          if ((iv & 16) != 0) {
            // Struct: ohne Methoden, ohne flat/packed (Bit0) und ohne at(...).
            if (self._nc(cur, 1) < 0 && (iv & 1) == 0 && self._feldMitAt(cur) == 0) {
              self._dkAdd(LYU_DK_STRUCT, cur);
            }
          } else {
            self._dkAdd(LYU_DK_KLASSE, cur);
          }
        }
      } else if (k == NK_STRUCT_DECL && self._npub(cur) != 0) {
        if ((self._niv(cur) & 1) == 0 && self._feldMitAt(cur) == 0) {
          self._dkAdd(LYU_DK_STRUCT, cur);
        }
      }
      cur := self._nnx(cur);
    }
  }

  fn _feldMitAt(td: int64): int64 {
    var f: int64 := self._nc(td, 0);
    while (f >= 0) {
      if ((self._niv(f) & 1) != 0) { return 1; }   // FIELD_FLAG_PACKED_OFFSET
      f := self._nnx(f);
    }
    return 0;
  }

  // #2014: Layoutquelle angeben — das Backend, das die Unit gerade uebersetzt
  // hat. Ohne Quelle werden Structs und Klassen NICHT beschrieben.
  pub fn LywLayoutX86(cg: Codegen) { self.dkCg := cg; self.dkHatCg := 1; }
  pub fn LywLayoutIR(lw: IRLower)  { self.dkIr := lw; self.dkHatIr := 1; }

  // ── Typtext ───────────────────────────────────────────────────────────
  fn _tbPut(c: int64) {
    if (self.tbLen >= self.tbCap) {
      var nc: int64 := self.tbCap * 2;
      var nb: int64 := alloc(nc);
      memcpy(nb, self.tb, self.tbLen);
      self.tb := nb;
      self.tbCap := nc;
    }
    poke8(self.tb + self.tbLen, c);
    self.tbLen := self.tbLen + 1;
  }
  fn _tbStr(p: pchar, l: int64) {
    var i: int64 := 0;
    while (i < l) { self._tbPut(peek8((p as int64) + i)); i := i + 1; }
  }
  fn _tbDez(v: int64) {
    // Nur fuer v >= 0 gerufen (siehe _tbWert).
    if (v >= 10) { self._tbDez(v / 10); }
    self._tbPut(48 + (v % 10));
  }
  // Ganzzahl als QUELLTEXT. Ein Minusliteral gibt es in Lyx nicht; eine
  // negative Zahl wird als `(0 - m - 1)` geschrieben, mit m = -(v+1) >= 0 —
  // so passt auch der kleinste int64, dessen Betrag kein int64 mehr ist
  // (`0 - n` ist keine Betragsfunktion, siehe CLAUDE.md).
  fn _tbWert(v: int64) {
    if (v >= 0) { self._tbDez(v); return; }
    self._tbStr("(0 - "c, 5);
    self._tbDez(0 - (v + 1));
    self._tbStr(" - 1)"c, 5);
  }

  // Typknoten als Quelltext in tb anhaengen. 0 = Form nicht beschreibbar.
  fn _typText(tn: int64): int64 {
    if (tn < 0) { return 0; }
    var k: int64 := self._nk(tn);
    if (k == NK_TYPE_NAME) {
      if (self._nc(tn, 0) >= 0) { return 0; }         // Map<K,V> u. a.
      var ta: int64 := self._nc(tn, 1);
      self._tbStr(self._nsp(tn), self._nsl(tn));
      if (ta >= 0) {
        // Nur `Array<T>` — andere Typargumente benennen eine Instanz eines
        // generischen Typs, und die wird hier nicht beschrieben.
        if (self._nGleich(tn, "Array"c, 5) == 0) { return 0; }
        if (self._nnx(ta) >= 0) { return 0; }
        self._tbPut(60);
        if (self._typText(ta) == 0) { return 0; }
        self._tbPut(62);
      }
      if ((self._niv(tn) & 1) != 0) { self._tbPut(63); }   // nullable `?`
      return 1;
    }
    if (k == NK_TYPE_ARRAY) {
      var el: int64 := self._nc(tn, 0);
      if (el < 0) { self._tbStr("array"c, 5); return 1; }
      if (self._typText(el) == 0) { return 0; }
      self._tbStr("[]"c, 2);
      if ((self._niv(tn) & 1) != 0) { self._tbPut(63); }
      return 1;
    }
    if (k == NK_TYPE_ARRAY_FIXED) {
      var okb: int64 := alloc(8);
      var n: int64 := self._konWert(self.dkNodes, self._nc(tn, 1), okb);
      var ok: int64 := peek64(okb);
      free(okb, 8);
      if (ok == 0) { return 0; }   // Groesse nicht ausrechenbar (etwa eine benannte Konstante)
      if (self._typText(self._nc(tn, 0)) == 0) { return 0; }
      self._tbPut(91); self._tbWert(n); self._tbPut(93);
      if ((self._niv(tn) & 1) != 0) { self._tbPut(63); }
      return 1;
    }
    return 0;
  }

  // Typ als str in die Datei. 0 = nicht beschreibbar (nichts geschrieben).
  fn _eTyp(tn: int64): int64 {
    self.tbLen := 0;
    if (self._typText(tn) == 0) { return 0; }
    self._eStr(self.tb as pchar, self.tbLen);
    return 1;
  }

  // Vorgabewert eines Parameters als Quelltext. 0 = nicht beschreibbar.
  fn _eVorgabe(dv: int64): int64 {
    self.tbLen := 0;
    var k: int64 := self._nk(dv);
    if (k == NK_LIT_BOOL) {
      if (self._niv(dv) != 0) { self._tbStr("true"c, 4); } else { self._tbStr("false"c, 5); }
    } else if (k == NK_LIT_FLOAT) {
      self._tbStr(self._nsp(dv), self._nsl(dv));
    } else {
      var okb: int64 := alloc(8);
      var v: int64 := self._konWert(self.dkNodes, dv, okb);
      var ok: int64 := peek64(okb);
      free(okb, 8);
      if (ok == 0) { return 0; }
      self._tbWert(v);
    }
    self._eStr(self.tb as pchar, self.tbLen);
    return 1;
  }

  // Signatur (Rueckgabetyp, Parameter, Flags). 0 = nicht beschreibbar.
  fn _eSignatur(fnN: int64): int64 {
    var rt: int64 := self._nc(fnN, 1);
    if (rt < 0) { self._eStr(""c, 0); }
    else if (self._eTyp(rt) == 0) { return 0; }
    var np: int64 := 0;
    var pn: int64 := self._nc(fnN, 0);
    while (pn >= 0) { if (self._nk(pn) == NK_PARAM) { np := np + 1; } pn := self._nnx(pn); }
    self._e16le(np);
    pn := self._nc(fnN, 0);
    while (pn >= 0) {
      if (self._nk(pn) == NK_PARAM) {
        self._eStr(self._nsp(pn), self._nsl(pn));
        if (self._eTyp(self._nc(pn, 0)) == 0) { return 0; }
        var pf: int64 := 0;
        var dv: int64 := self._nc(pn, 1);
        if (dv >= 0) { pf := pf | 1; }
        if ((self._niv(pn) & PARAM_FLAG_CON) != 0) { pf := pf | 2; }
        if ((self._niv(pn) & PARAM_FLAG_REF) != 0) { pf := pf | 4; }
        self._e8(pf);
        if (dv >= 0) { if (self._eVorgabe(dv) == 0) { return 0; } }
      }
      pn := self._nnx(pn);
    }
    self._e8(0);
    return 1;
  }

  // Layout eines Typs vom Backend: Groesse in dkBox[0], VMT-Flag in dkBox[1].
  // Rueckgabe 0, wenn das Backend den Typ nicht kennt.
  fn _layoutTyp(np: pchar, nl: int64): int64 {
    if (self.dkHatIr != 0) { return self.dkIr.IrLyuTyp(np, nl, self.dkBox); }
    if (self.dkHatCg != 0) { return self.dkCg.CgLyuTyp(np, nl, self.dkBox); }
    return 0;
  }
  // Offset eines Feldes in dkBox[0], Breite in dkBox[1]. 0 = unbekannt.
  fn _layoutFeld(tp: pchar, tl: int64, fp: pchar, fl: int64): int64 {
    if (self.dkHatIr != 0) { return self.dkIr.IrLyuFeld(tp, tl, fp, fl, self.dkBox); }
    if (self.dkHatCg != 0) { return self.dkCg.CgLyuFeld(tp, tl, fp, fl, self.dkBox); }
    return 0;
  }

  // Felder (eigene) schreiben. 0 = nicht beschreibbar.
  fn _eFelder(td: int64): int64 {
    var nf: int64 := 0;
    var f: int64 := self._nc(td, 0);
    while (f >= 0) { if (self._nk(f) == NK_FIELD_DECL) { nf := nf + 1; } f := self._nnx(f); }
    self._e16le(nf);
    f := self._nc(td, 0);
    while (f >= 0) {
      if (self._nk(f) == NK_FIELD_DECL) {
        self._eStr(self._nsp(f), self._nsl(f));
        if (self._eTyp(self._nc(f, 0)) == 0) { return 0; }
        if (self._layoutFeld(self._nsp(td), self._nsl(td), self._nsp(f), self._nsl(f)) == 0) { return 0; }
        self._e32le(peek64(self.dkBox));
        self._e32le(peek64(self.dkBox + 8));
        self._e8(self._niv(f) & 0x36);
      }
      f := self._nnx(f);
    }
    return 1;
  }

  // Einen Eintrag schreiben; 0 = nicht beschreibbar (der Aufrufer setzt len
  // zurueck, es bleibt also nichts Halbes stehen).
  fn _eDekl(art: int64, n: int64): int64 {
    self._e8(art);
    var lenPos: int64 := self.len;
    self._e32le(0);
    var rumpfStart: int64 := self.len;
    self._eStr(self._nsp(n), self._nsl(n));
    if (art == LYU_DK_IMPORT) {
      self._e8(self._niv(n) & 1);
      var al: int64 := self._nc(n, 0);
      if (al >= 0) { self._eStr(self._nsp(al), self._nsl(al)); } else { self._eStr(""c, 0); }
    } else if (art == LYU_DK_FN) {
      if (self._eSignatur(n) == 0) { return 0; }
    } else if (art == LYU_DK_STRUCT) {
      if (self._layoutTyp(self._nsp(n), self._nsl(n)) == 0) { return 0; }
      if (peek64(self.dkBox + 8) != 0) { return 0; }   // Struct mit Typwort: nicht diese Art
      self._e32le(peek64(self.dkBox));
      self._e8(0);
      if (self._eFelder(n) == 0) { return 0; }
    } else if (art == LYU_DK_KLASSE) {
      var basis: int64 := self._nc(n, 2);
      if (basis >= 0) { self._eStr(self._nsp(basis), self._nsl(basis)); } else { self._eStr(""c, 0); }
      var ni: int64 := 0;
      var ifc: int64 := self._nc(n, 3);
      while (ifc >= 0) { ni := ni + 1; ifc := self._nnx(ifc); }
      self._e16le(ni);
      ifc := self._nc(n, 3);
      while (ifc >= 0) { self._eStr(self._nsp(ifc), self._nsl(ifc)); ifc := self._nnx(ifc); }
      if (self._layoutTyp(self._nsp(n), self._nsl(n)) == 0) { return 0; }
      self._e32le(peek64(self.dkBox));
      var kf: int64 := 0;
      if (peek64(self.dkBox + 8) != 0) { kf := kf | 1; }
      if ((self._niv(n) & 1) != 0)     { kf := kf | 2; }   // abstract class
      self._e8(kf);
      if (self._eFelder(n) == 0) { return 0; }
      var nm: int64 := 0;
      var m: int64 := self._nc(n, 1);
      while (m >= 0) { if (self._nk(m) == NK_FUNC_DECL) { nm := nm + 1; } m := self._nnx(m); }
      self._e16le(nm);
      var neuPlatz: int64 := 0;
      m := self._nc(n, 1);
      while (m >= 0) {
        if (self._nk(m) == NK_FUNC_DECL) {
          var tp: int64 := self._nc(m, 3);
          if (tp >= 0) { if (self._nk(tp) == NK_TYPE_PARAM) { return 0; } }   // generische Methode
          self._eStr(self._nsp(m), self._nsl(m));
          var mf: int64 := self._niv(m) & 0x7F;
          self._e8(mf);
          if ((mf & 4) != 0)      { self._e16le(0xFFFE); }
          else if ((mf & 2) != 0) { self._e16le(neuPlatz); neuPlatz := neuPlatz + 1; }
          else                    { self._e16le(0xFFFF); }
          if (self._eSignatur(m) == 0) { return 0; }
        }
        m := self._nnx(m);
      }
    }
    self._p32le(lenPos, self.len - rumpfStart);
    return 1;
  }

  // Alle Deklarationen in einen eigenen Puffer schreiben (vor dem Kopf, damit
  // das Flagbit feststeht). Rueckgabe: Anzahl geschriebener Eintraege; Puffer
  // und Laenge in dkBox[2]/dkBox[3].
  fn _dkSerialisieren(): int64 {
    var sBuf: int64 := self.buf; var sLen: int64 := self.len; var sCap: int64 := self.cap;
    self.cap := 4096;
    self.buf := alloc(self.cap);
    self.len := 0;
    self._e32le(0);
    var n: int64 := 0;
    var i: int64 := 0;
    while (i < self.dkCount) {
      var art: int64 := peek64(self.dkList + i * 16);
      var nd:  int64 := peek64(self.dkList + i * 16 + 8);
      var start: int64 := self.len;
      if (self._eDekl(art, nd) != 0) { n := n + 1; }
      else { self.len := start; }
      i := i + 1;
    }
    self._p32le(0, n);
    var dBuf: int64 := self.buf; var dLen: int64 := self.len;
    self.buf := sBuf; self.len := sLen; self.cap := sCap;
    poke64(self.dkBox + 16, dBuf);
    poke64(self.dkBox + 24, dLen);
    return n;
  }

  // #1555: vor Serialize aufrufen.
  pub fn LywSetDebug(on: int64) { self.includeDebug := on; }

  // #1974: vor Serialize aufrufen. Ohne IR-Modul bleibt der Abschnitt weg und
  // die Datei ist byte-identisch zu einer ohne diese Erweiterung.
  pub fn LywSetIR(irMod: int64) { self.irModulPtr := irMod; }

  fn _grow() {
    var nc: int64 := self.cap * 2;
    var nb: int64 := alloc(nc);
    var i: int64 := 0;
    while (i < self.len) { poke8(nb + i, peek8(self.buf + i)); i := i + 1; }
    self.buf := nb;
    self.cap := nc;
  }

  fn _e8(v: int64) {
    if (self.len >= self.cap) { self._grow(); }
    poke8(self.buf + self.len, v & 255);
    self.len += 1;
  }

  fn _e16le(v: int64) {
    self._e8(v); self._e8(v >> 8);
  }

  fn _e32le(v: int64) {
    self._e8(v); self._e8(v >> 8); self._e8(v >> 16); self._e8(v >> 24);
  }

  // #2014: ein Konstantenwert ist ein voller int64 — ein u32 wuerde jede Zahl
  // ab 2^31 still abschneiden.
  fn _e64le(v: int64) {
    self._e8(v);       self._e8(v >> 8);  self._e8(v >> 16); self._e8(v >> 24);
    self._e8(v >> 32); self._e8(v >> 40); self._e8(v >> 48); self._e8(v >> 56);
  }

  // #1555: ein bereits geschriebenes u32 nachtragen (Offset-Feld im Kopf, das
  // erst feststeht, wenn der Abschnitt geschrieben ist).
  fn _p32le(at: int64, v: int64) {
    if (at < 0 || at + 4 > self.len) { return; }
    poke8(self.buf + at,     v & 255);
    poke8(self.buf + at + 1, (v >> 8) & 255);
    poke8(self.buf + at + 2, (v >> 16) & 255);
    poke8(self.buf + at + 3, (v >> 24) & 255);
  }

  // u16-length-prefixed UTF-8 string (matches WriteString in S0)
  fn _eStr(s: pchar, slen: int64) {
    self._e16le(slen);
    var i: int64 := 0;
    while (i < slen) { self._e8(StrCharAt(s, i)); i := i + 1; }
  }

  // djb2 hash → u32 (typeHash field)
  fn _typeHash(s: pchar, slen: int64): int64 {
    var h: int64 := 5381;
    var i: int64 := 0;
    while (i < slen) {
      h := ((h << 5) + h) + (StrCharAt(s, i) & 255);
      i += 1;
    }
    return h & 0xFFFFFFFF;
  }

  // Map sema TY_xxx → type info string stored in the symbol
  fn _tyInfoStr(typeId: int64): pchar {
    if typeId == 1  { return "void"c; }
    if typeId == 2  { return "bool"c; }
    if typeId == 3  { return "int64"c; }
    if typeId == 4  { return "pchar"c; }
    if typeId == 5  { return "float64"c; }
    if typeId == 6  { return "int32"c; }
    if typeId == 7  { return "array"c; }
    if typeId == 9  { return "int8"c; }
    if typeId == 10 { return "int16"c; }
    if typeId == 11 { return "uint8"c; }
    if typeId == 12 { return "uint16"c; }
    if typeId == 13 { return "uint32"c; }
    if typeId == 14 { return "uint64"c; }
    if typeId == 15 { return "float32"c; }
    if typeId == 16 { return "char"c; }
    if typeId == 19 { return "fn_ptr"c; }
    if typeId == 20 { return "closure"c; }
    return "user"c;
  }

  // Map sema SYM_xxx → LYU LSK_xxx
  fn _symToLsk(semaKind: int64): int64 {
    if semaKind == SYM_FUNC   { return LSK_FN; }
    if semaKind == SYM_VAR    { return LSK_VAR; }
    if semaKind == SYM_CON    { return LSK_CON; }
    if semaKind == SYM_STRUCT { return LSK_STRUCT; }
    if semaKind == SYM_ENUM   { return LSK_ENUM; }
    if semaKind == SYM_TYPE   { return LSK_UTYPE; }
    return LSK_VAR;
  }

  // Derive unit name: strip directory and .lyx extension from path.
  // Uses StrSub builtin — no manual mmap needed.
  fn _unitNameFromPath(srcPath: pchar): pchar {
    var slen: int64 := StrLen(srcPath);
    var lastSlash: int64 := -1;
    var i: int64 := 0;
    while (i < slen) {
      if (StrCharAt(srcPath, i) == 47) { lastSlash := i; }
      i += 1;
    }
    var lastDot: int64 := slen;
    i := slen - 1;
    while (i > lastSlash) {
      if (StrCharAt(srcPath, i) == 46) { lastDot := i; break; }
      i -= 1;
    }
    var nameStart: int64 := lastSlash + 1;
    var nameLen:   int64 := lastDot - nameStart;
    if (nameLen <= 0) { return srcPath; }
    return StrSub(srcPath, nameStart, nameLen);
  }

  // #1974: einen Puffer des IR-Moduls anhaengen — erst die Anzahl BYTES, dann
  // die Bytes selbst.
  //
  // ACHTUNG, die Laengenfelder des IR-Moduls zaehlen NICHT einheitlich:
  //
  //   instrLen, funcLen, globalLen, captureLen  → Anzahl der SAETZE
  //   strLen, labelLen                          → Anzahl der BYTES
  //
  // Beide Formen stehen unkommentiert nebeneinander in ir.lyx (nur die
  // Kopfkommentare bei +112/+136 sagen "count"), und lbf_writer.lyx rechnet
  // es entsprechend um (`instrBuf + ii * IR_INSTR_SIZE` bei `ii < instrLen`).
  // Wer alles fuer Bytes haelt, schreibt einen Abschnitt, der uebersetzt und
  // beim Lesen Unsinn ergibt — genau das war der erste Wurf hier: `instr 7
  // Byte`, `func 1 Byte`.
  //
  // `satzGroesse` ist deshalb 1 fuer die byteweise gefuehrten Puffer und die
  // Satzgroesse fuer die anderen.
  fn _eIrPuffer(bufOff: int64, lenOff: int64, satzGroesse: int64) {
    var b: int64 := peek64(self.irModulPtr + bufOff);
    var n: int64 := peek64(self.irModulPtr + lenOff) * satzGroesse;
    if (b == 0 || n <= 0) { self._e32le(0); return; }
    self._e32le(n);
    var i: int64 := 0;
    while (i < n) { self._e8(peek8(b + i)); i := i + 1; }
  }

  // Serialize sema symbol table into the internal buffer.
  // arch: one of LYU_ARCH_* constants.
  pub fn Serialize(inputPath: pchar, sema: Sema, arch: int64) {
    // Count exportable symbols (skip BUILTIN=0, PARAM=4, FIELD=7)
    var symCount:  int64 := 0;
    var funcCount: int64 := 0;
    var total:     int64 := sema.SymCount();
    var si: int64 := 0;
    while (si < total) {
      var kind: int64 := sema.SymKind(si);
      if (kind != SYM_BUILTIN && kind != SYM_PARAM && kind != SYM_FIELD) {
        // #2035: nur die eigene, oeffentliche Schnittstelle
        if (self._istExport(sema.SymName(si), sema.SymNameLen(si)) != 0) {
          symCount += 1;
          if (kind == SYM_FUNC) { funcCount := funcCount + 1; }
        }
      }
      si += 1;
    }

    // Unit name from source path
    var unPtr:  pchar := self._unitNameFromPath(inputPath);
    var unLenV: int64 := StrLen(unPtr);

    // ── Header ──
    self._e8(LYU_W_M0); self._e8(LYU_W_M1);
    self._e8(LYU_W_M2); self._e8(LYU_W_M3);
    self._e16le(LYU_W_VER);
    self._e8(arch);
    // flags: bit0 = Debug-Abschnitt (#1555), bit1 = Ressourcen (#1971),
    // bit4 = Deklarationen (#2014 Stufen 2–4) — Belegung siehe Dateikopf.
    //
    // #2014: Die Deklarationen werden VOR dem Kopf in einen eigenen Puffer
    // geschrieben. Erst danach steht fest, ob ueberhaupt ein Eintrag
    // beschreibbar war — und davon haengt das Flagbit ab, das hier steht.
    var dkN: int64 := 0;
    var dkAbschnitt: int64 := 0;
    if (self.dkCount > 0 || self.konCount > 0) { dkN := self._dkSerialisieren(); dkAbschnitt := 1; }
    var flags: int64 := self.includeDebug & 1;
    if (self.resCount > 0) { flags := flags | 2; }
    // Auch mit NULL Eintraegen, wenn es Konstanten gibt: der Leser bildet
    // dann den Text mit den Konstanten fuer sema und den IR-Weg.
    if (dkAbschnitt != 0) { flags := flags | LYU_FLAG_DEKL; }
    self._e8(flags);

    // Unit name
    self._eStr(unPtr, unLenV);

    // v2 metadata (empty)
    self._eStr(""c, 0);
    self._eStr(""c, 0);
    self._eStr(""c, 0);

    // Symbol count + offset placeholders
    self._e32le(symCount);
    // #2014 Stufe 1: das Feld hiess TypeInfoOffset und stand seit jeher auf 0.
    // Es traegt jetzt den Konstantenabschnitt — Konstantenwerte sind der erste
    // Teil der Strukturinformationen, fuer die es vorgesehen war.
    self.konOffPos := self.len;
    self._e32le(0);  // KonstantenOffset (0 = keine)
    self.irOffPos := self.len;   // #1974: hierhin kommt der Offset am Ende
    self._e32le(0);  // IRCodeOffset
    self.dbgOffPos := self.len;   // #1555: hierhin kommt der Offset am Ende
    self._e32le(0);  // DebugOffset
    self.resOffPos := self.len;   // #1971: das bisher reservierte U32
    self._e32le(0);  // ResourceOffset (0 = keine Ressourcen)

    // ── Symbol table ──
    si := 0;
    while (si < total) {
      var kind: int64 := sema.SymKind(si);
      if (kind != SYM_BUILTIN && kind != SYM_PARAM && kind != SYM_FIELD
          && self._istExport(sema.SymName(si), sema.SymNameLen(si)) != 0) {
        var symName:    pchar := sema.SymName(si);
        var symNameLen: int64 := sema.SymNameLen(si);
        // #1966: Fuer eine FUNKTION ist der Rueckgabetyp gemeint. SymTypeId
        // liefert dort immer TY_VOID (so werden Funktionen eingetragen);
        // deshalb stand in jeder .lyu und in jeder `--unit-info`-Ausgabe
        // `void`, auch bei `std/math.lyu`.
        var typeId:     int64 := sema.SymReturnType(si);
        var tiPtr:      pchar := self._tyInfoStr(typeId);
        var tiLen:      int64 := StrLen(tiPtr);
        var lsk:        int64 := self._symToLsk(kind);
        var thash:      int64 := self._typeHash(tiPtr, tiLen);
        self._eStr(symName, symNameLen);
        self._e8(lsk);
        self._e32le(thash);
        self._eStr(tiPtr, tiLen);
      }
      si += 1;
    }

    // ── Placeholder sections (matches S0 Serialize) ──
    self._e32le(0);          // strings count = 0
    self._e32le(funcCount);  // function count
    self._e32le(0);          // globals count = 0

    // ── IR-Abschnitt (#1974) ───────────────────────────────────────────
    //
    // Bis 1.2.3B trug eine `.lyu` NAMEN und TYPEN, aber keinen Code: das Feld
    // `IRCodeOffset` stand im Kopf und wurde immer als 0 geschrieben. Eine
    // allein ausgelieferte Unit lieferte deshalb keine einzige Funktion.
    //
    // Geschrieben werden die fuenf Puffer des IR-Moduls roh. Das geht, WEIL
    // die Saetze untereinander mit OFFSETS verweisen und nicht mit Zeigern
    // (IR_INSTR_OFF_STROFF, IR_FUNC_OFF_INSTRSOFF …) — nachgesehen in
    // src/ir.lyx. Ein einziger absoluter Zeiger darin, und diese Uebertragung
    // waere still falsch: sie uebersetzte fehlerfrei und liefe beim ersten
    // Zugriff in eine fremde Adresse.
    //
    // Aufbau: Magic "LYIR", Fassung, dann je Puffer die LAENGE und die Bytes.
    // Die Laenge steht VOR den Bytes, damit ein Leser den Abschnitt auch dann
    // ueberspringen kann, wenn er eine spaetere Fassung nicht kennt.
    if (self.irModulPtr != 0) {
      var irStart: int64 := self.len;
      self._p32le(self.irOffPos, irStart);
      self._e8(76); self._e8(89); self._e8(73); self._e8(82);   // "LYIR"
      self._e32le(LYU_IR_VER);
      // Zaehlweise je Puffer — siehe _eIrPuffer.
      self._e32le(peek64(self.irModulPtr + IR_MOD_OFF_INSTRLEN));    // Saetze
      self._e32le(peek64(self.irModulPtr + IR_MOD_OFF_FUNCLEN));     // Saetze
      self._e32le(peek64(self.irModulPtr + IR_MOD_OFF_GLOBALLEN));   // Saetze
      self._eIrPuffer(IR_MOD_OFF_INSTRBUF,   IR_MOD_OFF_INSTRLEN,   IR_INSTR_SIZE);
      self._eIrPuffer(IR_MOD_OFF_STRBUF,     IR_MOD_OFF_STRLEN,     1);
      self._eIrPuffer(IR_MOD_OFF_LABELBUF,   IR_MOD_OFF_LABELLEN,   1);
      self._eIrPuffer(IR_MOD_OFF_FUNCBUF,    IR_MOD_OFF_FUNCLEN,    IR_FUNC_SIZE);
      self._eIrPuffer(IR_MOD_OFF_GLOBALBUF,  IR_MOD_OFF_GLOBALLEN,  8);
      self._eIrPuffer(IR_MOD_OFF_CAPTUREBUF, IR_MOD_OFF_CAPTURELEN, 8);
    }

    // ── Debug-Abschnitt (#1555) ────────────────────────────────────────
    // Optional und am ENDE, mit Offset und Laenge im Kopf: ein Leser, der ihn
    // nicht kennt, hoert nach der Symboltabelle auf und liest die Datei
    // unveraendert. Inhalt: Quelldatei und je Funktion die Startzeile —
    // dieselben Angaben, die cg.debugMode im ELF ablegt.
    if (self.includeDebug != 0) {
      var dbgStart: int64 := self.len;
      self._p32le(self.dbgOffPos, dbgStart);
      self._eStr(inputPath, StrLen(inputPath));
      var lenPos: int64 := self.len;
      self._e32le(0);                 // Anzahl Eintraege, gleich nachgetragen
      var written: int64 := 0;
      si := 0;
      while (si < total) {
        if (sema.SymKind(si) == SYM_FUNC) {
          self._eStr(sema.SymName(si), sema.SymNameLen(si));
          var ln: int64 := sema.SymLine(si);
          if (ln < 0) { ln := 0; }    // importiert/eingebaut: keine Zeile
          self._e32le(ln);
          written += 1;
        }
        si += 1;
      }
      self._p32le(lenPos, written);
    }

    // ── Konstanten-Abschnitt (#2014 Stufe 1) ───────────────────────────
    //
    // Aufbau: Anzahl (u32), dann je Eintrag Name (_eStr), Art (u8) und
    // entweder der Zahlenwert (i64, little endian) oder der Text (_eStr).
    //
    // Ohne diesen Abschnitt bleibt der Offset 0 und die Datei ist
    // byte-identisch zu einer ohne die Erweiterung — dasselbe Versprechen wie
    // beim Debug- (#1555), IR- (#1974) und Ressourcenabschnitt (#1971).
    if (self.konCount > 0 || dkAbschnitt != 0) {
      var konStart: int64 := self.len;
      self._p32le(self.konOffPos, konStart);
      self._e32le(self.konCount);
      var ki: int64 := 0;
      while (ki < self.konCount) {
        var kb:  int64 := self.konList + ki * 40;
        var knm: pchar := peek64(kb) as pchar;
        var knl: int64 := peek64(kb + 8);
        var kart: int64 := peek64(kb + 16);
        self._eStr(knm, knl);
        self._e8(kart);
        if (kart == 0) {
          self._e64le(peek64(kb + 24));
        } else {
          // Der Text ist beim Einsammeln bereits aufgeloest worden.
          self._eStr(peek64(kb + 24) as pchar, peek64(kb + 32));
        }
        ki += 1;
      }
      // #2014 Stufen 2–4: die Deklarationen direkt hinter dem letzten
      // Konstanteneintrag (Flagbit LYU_FLAG_DEKL). Ein Leser ohne Kenntnis
      // des Bits hoert nach den Konstanten auf — ohne Konstanten steht dort
      // eine 0, und er liest gar nichts.
      if (dkAbschnitt != 0) {
        var dBuf: int64 := peek64(self.dkBox + 16);
        var dLen: int64 := peek64(self.dkBox + 24);
        var di: int64 := 0;
        while (di < dLen) { self._e8(peek8(dBuf + di)); di := di + 1; }
      }
    }

    // ── Ressourcen-Abschnitt (#1971) ───────────────────────────────────
    // Wie der Debug-Abschnitt: optional, am ENDE, Offset im Kopf. Neu ist,
    // dass hier NUTZDATEN liegen und nicht nur Metadaten — die Bytes muessen
    // mit, weil es den Pfad auf dem Rechner des Nutzers nicht mehr gibt.
    //
    // Aufbau: Anzahl (u32), dann je Eintrag Name (_eStr), Laenge (u32),
    // Bytes. Die Laenge steht ausdruecklich da und nicht als
    // Nullterminierung: eine Ressource ist eine BINAERdatei und darf
    // Nullbytes tragen — genau daran ist die IR-Zeichenkettentabelle vor
    // #1968 gescheitert.
    if (self.resCount > 0) {
      var resStart: int64 := self.len;
      self._p32le(self.resOffPos, resStart);
      self._e32le(self.resCount);
      var ri: int64 := 0;
      while (ri < self.resCount) {
        var rb: int64 := self.resList + ri * 32;
        var rnm: pchar := peek64(rb) as pchar;
        var rnl: int64 := peek64(rb + 8);
        var rpfRel: pchar := peek64(rb + 16) as pchar;
        var rpfLen: int64 := peek64(rb + 24);
        self._eStr(rnm, rnl);
        // Der Pfad steht als AUSSCHNITT im Quelltextpuffer: nicht
        // nullterminiert und relativ zur Quelldatei. `open` braucht beides
        // anders — also auflösen wie cg_embedPfad, mit demselben Ergebnis.
        var rpf: pchar := self._pfadAufloesen(rpfRel, rpfLen, inputPath);
        // Datei lesen. FEHLT sie, ist das ein harter Fehler mit Pfad in der
        // Meldung — ein stiller Ersatz (Laenge 0) waere die schlimmste
        // Antwort: die Bibliothek liesse sich bauen, und erst beim Nutzer
        // faende sich eine leere Ressource ohne jeden Hinweis.
        var fd: int64 := open(rpf, 0, 0);
        if (fd < 0) {
          EPrintStr("error: @resource: Datei nicht lesbar: "c);
          EPrintStrLn(rpf);
          exit(1);
        }
        var gr: int64 := lseek(fd, 0, 2);
        lseek(fd, 0, 0);
        if (gr < 0) { close(fd); EPrintStrLn("error: @resource: Groesse nicht bestimmbar"c); exit(1); }
        self._e32le(gr);
        if (gr > 0) {
          var bufp: int64 := alloc(gr);
          var gelesen: int64 := read(fd, bufp as pchar, gr);
          close(fd);
          if (gelesen != gr) {
            EPrintStr("error: @resource: unvollstaendig gelesen: "c);
            EPrintStrLn(rpf);
            exit(1);
          }
          var bi: int64 := 0;
          while (bi < gr) { self._e8(peek8(bufp + bi)); bi := bi + 1; }
          free(bufp, gr);
        } else {
          close(fd);
        }
        ri := ri + 1;
      }
    }
  }

  // Write buffer to file. Returns true on success.
  pub fn WriteFile(path: pchar): bool {
    // O_WRONLY(1)|O_CREAT(64)|O_TRUNC(512) = 577, mode 0644 = 420
    var fd: int64 := open(path, 577, 420);
    if (fd < 0) { return false; }
    var written: int64 := write(fd, self.buf as pchar, self.len);
    close(fd);
    return written == self.len;
  }

};
