// src/backend/builtin_typen.lyx — #2274: Welche Builtins eine ZEICHENKETTE
// liefern, an EINER Stelle.
//
// WARUM DIESE DATEI. Dieselbe Auskunft stand dreimal im Compiler:
//   * `cg_isPcharExpr` in src/codegen_x86.lyx (ClassName, ArgvGetStr, …),
//   * `cg_builtinReturnsPchar` ebenda (StrCopy, StrNew, … — aber ohne
//     ClassName und ohne ArgvGetStr),
//   * `_printArt` in src/ir_lower.lyx (NK_CALL-Zweig).
// Die drei waren sich nie einig. `ArgvGet` stand in keiner: der x86-Weg gab
// deshalb still die ADRESSE des Arguments als Zahl aus, der IR-Weg wies
// `PrintLn(ArgvGet(argv, 1))` laut ab. Das ist die Klasse "eine Aufzaehlung
// ist unvollstaendig" — und bei drei Aufzaehlungen derselben Sache wird sie
// es immer wieder. Deshalb hier eine Liste, die alle drei Stellen fragen.
//
// WAS HIER NICHT HINEINGEHOERT: Namen, deren Rueckgabetyp im Quelltext steht
// (Nutzerfunktionen, Methoden, Felder, Casts). Die werden an den Aufrufstellen
// aus der Registry bzw. dem AST gelesen — eine Liste ist nur fuer Builtins
// noetig, die keine Deklaration haben.

unit src.backend.builtin_typen;

fn _btEq(a: pchar, al: int64, b: pchar, bl: int64): int64 {
  if (al != bl) { return 0; }
  var i: int64 := 0;
  while (i < al) {
    if (peek8(a as int64 + i) != peek8(b as int64 + i)) { return 0; }
    i := i + 1;
  }
  return 1;
}

// 1 = dieser Builtin liefert ein pchar, 0 = nicht (oder unbekannt).
pub fn BuiltinLiefertPchar(nm: pchar, nl: int64): int64 {
  if (_btEq(nm, nl, "IntToStr"c,     8))  { return 1; }
  if (_btEq(nm, nl, "StrFromInt"c,  10))  { return 1; }
  if (_btEq(nm, nl, "FloatToStr"c,  10))  { return 1; }
  if (_btEq(nm, nl, "StrConcat"c,    9))  { return 1; }
  if (_btEq(nm, nl, "StrAppendStr"c,12))  { return 1; }
  if (_btEq(nm, nl, "StrCopy"c,      7))  { return 1; }
  if (_btEq(nm, nl, "StrSub"c,       6))  { return 1; }
  if (_btEq(nm, nl, "StrNew"c,       6))  { return 1; }
  if (_btEq(nm, nl, "StrTrim"c,      7))  { return 1; }
  if (_btEq(nm, nl, "ClassName"c,    9))  { return 1; }   // #1670
  if (_btEq(nm, nl, "ArgvGetStr"c,  10))  { return 1; }
  if (_btEq(nm, nl, "ArgvGet"c,      7))  { return 1; }   // #2274
  if (_btEq(nm, nl, "GetArg"c,       6))  { return 1; }   // #2274, argv[i]
  return 0;
}
