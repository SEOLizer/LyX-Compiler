// bootstrap/backend/arm_cm_backend.lyx
// ARM Cortex-M4 Thumb-2 bare-metal ELF32 backend (WP-BC-37)
//
// ELF32 layout (page-aligned):
//   file[0..4095]    ELF32 header + PT_LOAD program header
//   file[4096..]     .text: vector table + reset handler + IR code
//   Flash base: 0x08000000 (STM32 FLASH), RAM: 0x20000000
//
// .text layout:
//   +0:  initial SP (4 bytes = 0x20002000, top of 8KB SRAM)
//   +4:  reset handler VA | 1 = 0x08000009 (Thumb bit for CM4)
//   +8:  BL main (4 bytes, hardcoded delta=+2 → main at offset 14)
//   +12: B . (2 bytes = 0xE7FE, infinite loop after main returns)
//   +14: main() function code (first IR function)
//
// ARM EABI (CM4):
//   r0-r3 = args/return; r4-r7 = callee-saved
//   r7 = frame pointer; sp = r13; lr = r14; pc = r15
//
// Stack frame:
//   PUSH {r7, lr}  →  [sp] = old r7, [sp+4] = lr
//   MOV r7, sp     →  r7 = frame base
//   SUB sp, #sz    →  allocate local slots below r7
//   slot(i)        →  [r7 - (i+1)*4]
//
// Epilogue:
//   LDR.W r0, [r7, #-4]   → return value from slot 0
//   MOV sp, r7
//   POP {r7, pc}           → restore r7, jump to lr

// ============================================================================
// Register constants
// ============================================================================


import src.std.alloc;
con CM_R0: int64 := 0;
con CM_R1: int64 := 1;
con CM_R2: int64 := 2;
con CM_R3: int64 := 3;
con CM_R4: int64 := 4;    // temp1
con CM_R5: int64 := 5;    // temp2
con CM_R6: int64 := 6;    // temp3
con CM_R7: int64 := 7;    // frame pointer
con CM_SP: int64 := 13;
con CM_LR: int64 := 14;
con CM_PC: int64 := 15;

// Patch types
con CM_PATCH_B:   int64 := 0;   // B.W unconditional (T4)
con CM_PATCH_BL:  int64 := 1;   // BL call (T1)
con CM_PATCH_BEQ: int64 := 2;   // BEQ.W conditional (T3, cond=0)
con CM_PATCH_BNE: int64 := 3;   // BNE.W conditional (T3, cond=1)

// Memory map (STM32F4xx)
con CM_FLASH_BASE: int64 := 0x08000000;
con CM_RAM_TOP:    int64 := 0x20002000;   // top of 8KB SRAM

// ============================================================================
// EmitARMCM  —  IR → Thumb-2 machine code
// ============================================================================

pub type EmitARMCM = class {
  codeBuf:    int64;
  codeLen:    int64;
  codeCap:    int64;
  ir:         int64;
  stackSize:  int64;
  labelAddrs: int64;
  patchBuf:   int64;
  patchCount: int64;
  funcAddrs:  int64;
  funcCount:  int64;

  // --------------------------------------------------------------------------
  // Code emission primitives
  // --------------------------------------------------------------------------

  fn cm_e16(v: int64) {
    poke8(self.codeBuf + self.codeLen,     v & 0xFF);
    poke8(self.codeBuf + self.codeLen + 1, (v >> 8) & 0xFF);
    self.codeLen := self.codeLen + 2;
  }

  // #1339: einzelnes Byte — fuer Zeichenketten, die inline im Codestrom liegen.
  fn cm_e8(v: int64) {
    poke8(self.codeBuf + self.codeLen, v & 0xFF);
    self.codeLen := self.codeLen + 1;
  }

  // Emit 32-bit Thumb-2 instruction as two consecutive halfwords
  fn cm_t32(hw1: int64, hw2: int64) {
    self.cm_e16(hw1);
    self.cm_e16(hw2);
  }

  fn cm_poke16at(off: int64, v: int64) {
    poke8(self.codeBuf + off,     v & 0xFF);
    poke8(self.codeBuf + off + 1, (v >> 8) & 0xFF);
  }

  // --------------------------------------------------------------------------
  // 16-bit Thumb instruction encoders
  // --------------------------------------------------------------------------

  // PUSH {r7, lr}: T1 = 0xB580
  fn cm_PUSH_r7_lr() { self.cm_e16(0xB580); }

  // POP {r7, pc}: T1 = 0xBD80
  fn cm_POP_r7_pc() { self.cm_e16(0xBD80); }

  // MOV r7, sp: T1 = 0x466F
  fn cm_MOV_r7_sp() { self.cm_e16(0x466F); }

  // MOV sp, r7: T1 = 0x46BD
  fn cm_MOV_sp_r7() { self.cm_e16(0x46BD); }

  // SUB sp, sp, #bytes: T2 = 0xB080 | (bytes/4) — bytes must be multiple of 4, <= 508
  fn cm_SUB_sp(bytes: int64) { self.cm_e16(0xB080 | ((bytes >> 2) & 0x7F)); }

  // MOVS Rd, #imm8: T1 (Rd in 0-7)
  fn cm_MOVS_imm(rd: int64, imm: int64) {
    self.cm_e16(0x2000 | (rd << 8) | (imm & 0xFF));
  }

  // MOV Rd, Rm: T1 high-register form (any register)
  fn cm_MOV(rd: int64, rm: int64) {
    self.cm_e16(0x4600 | (((rd >> 3) & 1) << 7) | ((rm & 0xF) << 3) | (rd & 7));
  }

  // CMP Rn, Rm: T1 (both in 0-7)
  fn cm_CMP(rn: int64, rm: int64) {
    self.cm_e16(0x4280 | (rm << 3) | rn);
  }

  // CMP Rn, #0: T1
  fn cm_CMP0(rn: int64) { self.cm_e16(0x2800 | (rn << 8)); }

  // NEGS Rd, Rn: T1 = RSBS Rd, Rn, #0 (Rd, Rn in 0-7)
  fn cm_NEG(rd: int64, rn: int64) {
    self.cm_e16(0x4240 | (rn << 3) | rd);
  }

  // --------------------------------------------------------------------------
  // 32-bit Thumb-2 instruction encoders
  // --------------------------------------------------------------------------

  // MOVW Rd, #imm16: T3
  fn cm_MOVW(rd: int64, imm: int64) {
    var imm4: int64 := (imm >> 12) & 0xF;
    var i:    int64 := (imm >> 11) & 1;
    var imm3: int64 := (imm >> 8)  & 0x7;
    var imm8: int64 := imm & 0xFF;
    self.cm_t32(0xF240 | (i << 10) | imm4, (imm3 << 12) | (rd << 8) | imm8);
  }

  // MOVT Rd, #imm16: T1
  fn cm_MOVT(rd: int64, imm: int64) {
    var imm4: int64 := (imm >> 12) & 0xF;
    var i:    int64 := (imm >> 11) & 1;
    var imm3: int64 := (imm >> 8)  & 0x7;
    var imm8: int64 := imm & 0xFF;
    self.cm_t32(0xF2C0 | (i << 10) | imm4, (imm3 << 12) | (rd << 8) | imm8);
  }

  // Load 32-bit immediate (truncated from int64) into Rd
  fn cm_LI(rd: int64, imm: int64) {
    var imm32: int64 := imm & 0xFFFFFFFF;
    if imm32 >= 0 && imm32 <= 255 && rd < 8 {
      self.cm_MOVS_imm(rd, imm32);
    } else {
      var lo: int64 := imm32 & 0xFFFF;
      var hi: int64 := (imm32 >> 16) & 0xFFFF;
      self.cm_MOVW(rd, lo);
      if hi != 0 { self.cm_MOVT(rd, hi); }
    }
  }

  // LDR.W Rt, [Rn, #-off8]: T4 negative-offset form (P=1, U=0, W=0)
  fn cm_LDR_neg(rt: int64, rn: int64, off: int64) {
    self.cm_t32(0xF850 | rn, (rt << 12) | 0x0C00 | (off & 0xFF));
  }

  // STR.W Rt, [Rn, #-off8]: T4 negative-offset form
  fn cm_STR_neg(rt: int64, rn: int64, off: int64) {
    self.cm_t32(0xF840 | rn, (rt << 12) | 0x0C00 | (off & 0xFF));
  }

  // LDR.W Rt, [Rn, #imm12]: T3 positive-offset form
  fn cm_LDR_pos(rt: int64, rn: int64, imm: int64) {
    self.cm_t32(0xF8D0 | rn, (rt << 12) | (imm & 0xFFF));
  }

  // STR.W Rt, [Rn, #imm12]: T3 positive-offset form
  fn cm_STR_pos(rt: int64, rn: int64, imm: int64) {
    self.cm_t32(0xF8C0 | rn, (rt << 12) | (imm & 0xFFF));
  }

  // ADD.W Rd, Rn, Rm: T2
  fn cm_ADD(rd: int64, rn: int64, rm: int64) {
    self.cm_t32(0xEB00 | rn, (rd << 8) | rm);
  }

  // SUB.W Rd, Rn, Rm: T1
  fn cm_SUB(rd: int64, rn: int64, rm: int64) {
    self.cm_t32(0xEBA0 | rn, (rd << 8) | rm);
  }

  // MUL Rd, Rn, Rm: T1
  fn cm_MUL(rd: int64, rn: int64, rm: int64) {
    self.cm_t32(0xFB00 | rn, 0xF000 | (rd << 8) | rm);
  }

  // SDIV Rd, Rn, Rm: T1 (CM4 only)
  fn cm_SDIV(rd: int64, rn: int64, rm: int64) {
    self.cm_t32(0xFB90 | rn, 0xF0F0 | (rd << 8) | rm);
  }

  // MLS Rd, Rn, Rm, Ra: Rd = Ra - Rn*Rm  (for mod: a - b*(a/b))
  fn cm_MLS(rd: int64, rn: int64, rm: int64, ra: int64) {
    self.cm_t32(0xFB00 | rn, (ra << 12) | (rd << 8) | 0x0010 | rm);
  }

  // AND.W Rd, Rn, Rm: T2
  fn cm_AND(rd: int64, rn: int64, rm: int64) {
    self.cm_t32(0xEA00 | rn, (rd << 8) | rm);
  }

  // ORR.W Rd, Rn, Rm: T2
  fn cm_ORR(rd: int64, rn: int64, rm: int64) {
    self.cm_t32(0xEA40 | rn, (rd << 8) | rm);
  }

  // EOR.W Rd, Rn, Rm: T2
  fn cm_EOR(rd: int64, rn: int64, rm: int64) {
    self.cm_t32(0xEA80 | rn, (rd << 8) | rm);
  }

  // MVN.W Rd, Rm: T2
  fn cm_MVN(rd: int64, rm: int64) {
    self.cm_t32(0xEA6F, (rd << 8) | rm);
  }

  // LSL.W Rd, Rn, Rs: T2
  fn cm_LSL(rd: int64, rn: int64, rs: int64) {
    self.cm_t32(0xFA00 | rn, 0xF000 | (rd << 8) | rs);
  }

  // LSR.W Rd, Rn, Rs: T2
  fn cm_LSR(rd: int64, rn: int64, rs: int64) {
    self.cm_t32(0xFA20 | rn, 0xF000 | (rd << 8) | rs);
  }

  // CMP.W Rn, Rm: T3
  fn cm_CMP_W(rn: int64, rm: int64) {
    self.cm_t32(0xEBB0 | rn, 0x0F00 | rm);
  }

  // --------------------------------------------------------------------------
  // Branch encoding helpers
  // --------------------------------------------------------------------------

  // Build B.W T4 (unconditional, ±16MB): returns packed (hw1<<16)|hw2
  fn cm_buildBW(delta: int64): int64 {
    var dh:    int64 := delta >> 1;
    var S:     int64 := (dh >> 23) & 1;
    var I1:    int64 := (dh >> 22) & 1;
    var I2:    int64 := (dh >> 21) & 1;
    var J1:    int64 := (~(I1 ^ S)) & 1;
    var J2:    int64 := (~(I2 ^ S)) & 1;
    var imm10: int64 := (dh >> 11) & 0x3FF;
    var imm11: int64 := dh & 0x7FF;
    return ((0xF000 | (S << 10) | imm10) << 16) | (0x9000 | (J1 << 13) | (J2 << 11) | imm11);
  }

  // Build BL T1 (call, ±16MB): same as B.W but hw2 starts with 0xD000
  fn cm_buildBL(delta: int64): int64 {
    var dh:    int64 := delta >> 1;
    var S:     int64 := (dh >> 23) & 1;
    var I1:    int64 := (dh >> 22) & 1;
    var I2:    int64 := (dh >> 21) & 1;
    var J1:    int64 := (~(I1 ^ S)) & 1;
    var J2:    int64 := (~(I2 ^ S)) & 1;
    var imm10: int64 := (dh >> 11) & 0x3FF;
    var imm11: int64 := dh & 0x7FF;
    return ((0xF000 | (S << 10) | imm10) << 16) | (0xD000 | (J1 << 13) | (J2 << 11) | imm11);
  }

  // Build B<cond>.W T3 (conditional, ±1MB)
  fn cm_buildBcond(cond: int64, delta: int64): int64 {
    var dh:    int64 := delta >> 1;
    var S:     int64 := (dh >> 20) & 1;
    var J1:    int64 := (dh >> 19) & 1;
    var J2:    int64 := (dh >> 18) & 1;
    var imm6:  int64 := (dh >> 11) & 0x3F;
    var imm11: int64 := dh & 0x7FF;
    return ((0xF000 | (S << 10) | (cond << 6) | imm6) << 16) | (0x8000 | (J1 << 13) | (J2 << 11) | imm11);
  }

  // --------------------------------------------------------------------------
  // Stack slot helpers: slot i → [r7, #-(i+1)*4]
  // --------------------------------------------------------------------------

  fn slotOff(i: int64): int64 { return (i + 1) * 4; }

  fn cm_loadSlot(s: int64) {
    self.cm_LDR_neg(CM_R4, CM_R7, self.slotOff(s));
  }

  fn cm_loadSlot2(s: int64) {
    self.cm_LDR_neg(CM_R5, CM_R7, self.slotOff(s));
  }

  fn cm_storeSlot(s: int64) {
    self.cm_STR_neg(CM_R4, CM_R7, self.slotOff(s));
  }

  // --------------------------------------------------------------------------
  // Stack frame
  // --------------------------------------------------------------------------

  fn calcStackFrame(funcId: int64) {
    var locals: int64 := self.getFuncLocalCount(funcId);
    var sz: int64 := locals * 4;
    if (sz & 7) != 0 { sz := (sz + 8) & -8; }
    if sz < 8 { sz := 8; }
    self.stackSize := sz;
  }

  fn emitPrologue() {
    self.cm_PUSH_r7_lr();
    self.cm_MOV_r7_sp();
    self.cm_SUB_sp(self.stackSize);
  }

  fn emitEpilogue() {
    self.cm_LDR_neg(CM_R0, CM_R7, 4);   // r0 = slot 0 (return value)
    self.cm_MOV_sp_r7();                  // sp = r7
    self.cm_POP_r7_pc();                  // restore r7, return via pc←lr
  }

  // --------------------------------------------------------------------------
  // Patch management
  // --------------------------------------------------------------------------

  fn addPatch(codeOff: int64, labelId: int64, ptype: int64) {
    if self.patchCount < 1024 {
      var base: int64 := self.patchBuf + self.patchCount * 32;
      poke64(base,      codeOff);
      poke64(base + 8,  labelId);
      poke64(base + 16, ptype);
      self.patchCount := self.patchCount + 1;
    }
  }

  fn applyPatches() {
    var i: int64 := 0;
    while i < self.patchCount {
      var base:    int64 := self.patchBuf + i * 32;
      var codeOff: int64 := peek64(base);
      var labelId: int64 := peek64(base + 8);
      var ptype:   int64 := peek64(base + 16);
      var target:  int64 := -1;
      if ptype == CM_PATCH_BL {
        if labelId < 256 { target := peek64(self.funcAddrs + labelId * 8); }
      } else {
        if labelId < 1024 { target := peek64(self.labelAddrs + labelId * 8); }
      }
      if target >= 0 {
        // PC = instruction address + 4 for 32-bit Thumb-2
        var delta: int64 := target - (codeOff + 4);
        var enc:   int64 := 0;
        if ptype == CM_PATCH_BL {
          enc := self.cm_buildBL(delta);
        } else if ptype == CM_PATCH_B {
          enc := self.cm_buildBW(delta);
        } else if ptype == CM_PATCH_BEQ {
          enc := self.cm_buildBcond(0, delta);
        } else if ptype == CM_PATCH_BNE {
          enc := self.cm_buildBcond(1, delta);
        }
        self.cm_poke16at(codeOff,     (enc >> 16) & 0xFFFF);
        self.cm_poke16at(codeOff + 2, enc & 0xFFFF);
      }
      i := i + 1;
    }
  }

  // --------------------------------------------------------------------------
  // Instruction dispatch
  // --------------------------------------------------------------------------

    // #1339: Der Dispatcher unten ist eine flache Liste aus `if op == X`
  // ohne else und ohne Default. Ein Opcode, den keine Zeile trifft, erzeugte
  // damit GAR NICHTS und verschwand lautlos aus dem Programm — bei
  // IRO_PANIC hiess das: nach einer erkannten Verletzung laeuft es weiter.
  //
  // Diese Liste nennt die Opcodes, die arm-cm4 tatsaechlich behandelt. Sie ist
  // aus dem Dispatcher erhoben und wird gegen ihn geprueft. Weicht sie ab,
  // scheitert der Lauf LAUT — die Abweichung faellt damit beim Uebersetzen
  // auf und nicht erst im erzeugten Programm.
  fn cm_opBehandelt(op: int64): int64 {
    // #1339: die vier Zusicherungen — ir_lower erzeugt sie (ASSERT_NOT_ZERO
    // steht vor jeder Division), und bis 1.0.18B behandelte sie ausser lyxos
    // kein Backend.
    if (op == IRO_ASSERT_NOT_NULL || op == IRO_ASSERT_NOT_ZERO) { return 1; }
    if (op == IRO_ASSERT_TRUE || op == IRO_ASSERT_BOUNDS) { return 1; }
    if (op == IRO_CONST_STR) { return 1; }   // #1339
    if (op == 167 || op == IRO_ADD || op == IRO_ALLOC || op == IRO_AND) { return 1; }
    if (op == IRO_BITAND || op == IRO_BITNOT || op == IRO_BITOR || op == IRO_BITXOR) { return 1; }
    if (op == IRO_BR_FALSE || op == IRO_BR_TRUE || op == IRO_CALL || op == IRO_CALL_BUILTIN) { return 1; }
    if (op == IRO_CAST || op == IRO_CMP_EQ || op == IRO_CMP_GE || op == IRO_CMP_GT) { return 1; }
    if (op == IRO_CMP_LE || op == IRO_CMP_LT || op == IRO_CMP_NEQ || op == IRO_CONST_FLOAT) { return 1; }
    if (op == IRO_CONST_INT || op == IRO_DIV || op == IRO_FREE || op == IRO_FTOI) { return 1; }
    if (op == IRO_FUNC_EXIT || op == IRO_ITOF || op == IRO_JMP || op == IRO_LABEL) { return 1; }
    if (op == IRO_LOAD_FIELD || op == IRO_LOAD_FIELD_HEAP || op == IRO_LOAD_GLOBAL || op == IRO_LOAD_LOCAL) { return 1; }
    if (op == IRO_MOD || op == IRO_MUL || op == IRO_NEG || op == IRO_NOT) { return 1; }
    if (op == IRO_OR || op == IRO_PANIC || op == IRO_SEXT || op == IRO_SHL) { return 1; }
    if (op == IRO_SHR || op == IRO_STORE_FIELD || op == IRO_STORE_FIELD_HEAP || op == IRO_STORE_GLOBAL) { return 1; }
    if (op == IRO_STORE_LOCAL || op == IRO_SUB || op == IRO_THROW || op == IRO_TRUNC) { return 1; }
    if (op == IRO_XOR || op == IRO_ZEXT) { return 1; }
    return 0;
  }

  fn emitInstr(funcId: int64, idx: int64) {
    var opRoh: int64 := self.getInstrOp(idx);
    if (self.cm_opBehandelt(opRoh) == 0) {
      EPrintStr("error: arm-cm4-Backend kennt Opcode "c);
      EPrintInt(opRoh);
      EPrintStrLn(" nicht — er wuerde stillschweigend verschwinden (#1339)."c);
      EPrintStrLn("  Entweder den Opcode hier umsetzen oder ihn in ir_lower fuer dieses Ziel abweisen."c);
      exit(1);
    }

    var op:   int64 := self.getInstrOp(idx);
    var dest: int64 := self.getInstrDest(idx);
    var src1: int64 := self.getInstrSrc1(idx);
    var src2: int64 := self.getInstrSrc2(idx);
    var imm:  int64 := self.getInstrImmInt(idx);

    // --- Constants ---
    if op == IRO_CONST_INT || op == IRO_CONST_FLOAT {
      self.cm_LI(CM_R4, imm);
      self.cm_storeSlot(dest);
    }

    // --- Integer arithmetic ---
    if op == IRO_ADD {
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_ADD(CM_R4, CM_R4, CM_R5); self.cm_storeSlot(dest);
    }
    if op == IRO_SUB {
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_SUB(CM_R4, CM_R4, CM_R5); self.cm_storeSlot(dest);
    }
    if op == IRO_MUL {
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_MUL(CM_R4, CM_R4, CM_R5); self.cm_storeSlot(dest);
    }
    if op == IRO_DIV {
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_SDIV(CM_R4, CM_R4, CM_R5); self.cm_storeSlot(dest);
    }
    if op == IRO_MOD {
      // a%b = a - b*(a/b): SDIV r6,r4,r5; MLS r4,r5,r6,r4
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_SDIV(CM_R6, CM_R4, CM_R5);
      self.cm_MLS(CM_R4, CM_R5, CM_R6, CM_R4);
      self.cm_storeSlot(dest);
    }
    if op == IRO_NEG {
      self.cm_loadSlot(src1);
      self.cm_NEG(CM_R4, CM_R4); self.cm_storeSlot(dest);
    }

    // --- Bitwise ---
    if op == IRO_AND || op == IRO_BITAND {
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_AND(CM_R4, CM_R4, CM_R5); self.cm_storeSlot(dest);
    }
    if op == IRO_OR || op == IRO_BITOR {
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_ORR(CM_R4, CM_R4, CM_R5); self.cm_storeSlot(dest);
    }
    if op == IRO_XOR || op == IRO_BITXOR {
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_EOR(CM_R4, CM_R4, CM_R5); self.cm_storeSlot(dest);
    }
    if op == IRO_NOT || op == IRO_BITNOT {
      self.cm_loadSlot(src1);
      self.cm_MVN(CM_R4, CM_R4); self.cm_storeSlot(dest);
    }
    if op == IRO_SHL {
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_LSL(CM_R4, CM_R4, CM_R5); self.cm_storeSlot(dest);
    }
    if op == IRO_SHR {
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_LSR(CM_R4, CM_R4, CM_R5); self.cm_storeSlot(dest);
    }

    // --- Comparisons: CMP r4,r5 + MOVS r4,#0 + B<inv_cond>.N +2 + MOVS r4,#1 ---
    if op == IRO_CMP_EQ {
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_CMP(CM_R4, CM_R5);
      self.cm_MOVS_imm(CM_R4, 0); self.cm_e16(0xD101);   // BNE.N +2
      self.cm_MOVS_imm(CM_R4, 1); self.cm_storeSlot(dest);
    }
    if op == IRO_CMP_NEQ {
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_CMP(CM_R4, CM_R5);
      self.cm_MOVS_imm(CM_R4, 0); self.cm_e16(0xD001);   // BEQ.N +2
      self.cm_MOVS_imm(CM_R4, 1); self.cm_storeSlot(dest);
    }
    if op == IRO_CMP_LT {
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_CMP(CM_R4, CM_R5);
      self.cm_MOVS_imm(CM_R4, 0); self.cm_e16(0xDA01);   // BGE.N +2
      self.cm_MOVS_imm(CM_R4, 1); self.cm_storeSlot(dest);
    }
    if op == IRO_CMP_GE {
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_CMP(CM_R4, CM_R5);
      self.cm_MOVS_imm(CM_R4, 0); self.cm_e16(0xDB01);   // BLT.N +2
      self.cm_MOVS_imm(CM_R4, 1); self.cm_storeSlot(dest);
    }
    if op == IRO_CMP_GT {
      // r4 > r5  ↔  r5 < r4: swap operands in CMP
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_CMP(CM_R5, CM_R4);
      self.cm_MOVS_imm(CM_R4, 0); self.cm_e16(0xDA01);   // BGE.N +2
      self.cm_MOVS_imm(CM_R4, 1); self.cm_storeSlot(dest);
    }
    if op == IRO_CMP_LE {
      self.cm_loadSlot(src1); self.cm_loadSlot2(src2);
      self.cm_CMP(CM_R4, CM_R5);
      self.cm_MOVS_imm(CM_R4, 0); self.cm_e16(0xDC01);   // BGT.N +2
      self.cm_MOVS_imm(CM_R4, 1); self.cm_storeSlot(dest);
    }

    // --- Memory: locals / globals ---
    if op == IRO_LOAD_LOCAL || op == IRO_STORE_LOCAL {
      self.cm_loadSlot(src1); self.cm_storeSlot(dest);
    }
    if op == IRO_LOAD_GLOBAL {
      self.cm_LI(CM_R6, src1);
      self.cm_LDR_pos(CM_R4, CM_R6, 0); self.cm_storeSlot(dest);
    }
    if op == IRO_STORE_GLOBAL {
      self.cm_LI(CM_R6, src2);
      self.cm_loadSlot(src1);
      self.cm_STR_pos(CM_R4, CM_R6, 0);
    }

    // --- Struct field access ---
    if op == IRO_LOAD_FIELD || op == IRO_LOAD_FIELD_HEAP {
      self.cm_loadSlot(src1);
      self.cm_LDR_pos(CM_R4, CM_R4, src2); self.cm_storeSlot(dest);
    }
    if op == IRO_STORE_FIELD || op == IRO_STORE_FIELD_HEAP {
      self.cm_loadSlot(src2);                // r4 = base ptr
      self.cm_MOV(CM_R6, CM_R4);             // r6 = base
      self.cm_loadSlot(src1);                // r4 = value
      self.cm_STR_pos(CM_R4, CM_R6, imm);
    }

    // --- Function calls (AAPCS: r0-r3 args) ---
    if op == IRO_CALL {
      var argCount: int64 := imm;
      var ai: int64 := 0;
      while ai < argCount && ai < 4 {
        self.cm_loadSlot(ai);
        self.cm_MOV(CM_R0 + ai, CM_R4);
        ai := ai + 1;
      }
      var patchOff: int64 := self.codeLen;
      self.cm_t32(0xF000, 0xD000);   // BL placeholder
      self.addPatch(patchOff, src1, CM_PATCH_BL);
      self.cm_MOV(CM_R4, CM_R0);
      self.cm_storeSlot(dest);
    }
    if op == IRO_CALL_BUILTIN {
      self.emitBuiltinCall(imm, dest);
    }

    // --- Control flow ---
    if op == IRO_JMP {
      var patchOff: int64 := self.codeLen;
      self.cm_t32(0xF000, 0x9000);   // B.W placeholder (T4)
      self.addPatch(patchOff, imm, CM_PATCH_B);
    }
    if op == IRO_BR_TRUE {
      self.cm_loadSlot(src1);
      self.cm_CMP0(CM_R4);            // CMP r4, #0
      var patchOff: int64 := self.codeLen;
      self.cm_t32(0xF000, 0x8000);   // BNE.W T3 placeholder (cond=1)
      self.addPatch(patchOff, imm, CM_PATCH_BNE);
    }
    if op == IRO_BR_FALSE {
      self.cm_loadSlot(src1);
      self.cm_CMP0(CM_R4);            // CMP r4, #0
      var patchOff: int64 := self.codeLen;
      self.cm_t32(0xF000, 0x8000);   // BEQ.W T3 placeholder (cond=0)
      self.addPatch(patchOff, imm, CM_PATCH_BEQ);
    }
    if op == IRO_LABEL {
      if imm < 1024 {
        poke64(self.labelAddrs + imm * 8, self.codeLen);
      }
    }
    if op == IRO_FUNC_EXIT {
      self.emitEpilogue();
    }

    // --- Memory allocation (bare-metal stub) ---
    if op == IRO_ALLOC {
      self.cm_MOVS_imm(CM_R4, 0); self.cm_storeSlot(dest);
    }
    if op == IRO_FREE { }   // no-op for bare-metal

    // --- Type conversions: copy only (no FP hardware used) ---
    if op == IRO_ITOF || op == IRO_FTOI || op == IRO_CAST || op == IRO_SEXT || op == IRO_ZEXT || op == IRO_TRUNC {
      self.cm_loadSlot(src1); self.cm_storeSlot(dest);
    }

    // --- WSP-05: Inline-Assembly (imm = arch-Mnemonic-Id aus ir_lower Thumb-2-Tabelle).
    // 32-bit-Thumb-Instruktionen: höheres Halbwort zuerst, jedes cm_e16 little-endian. ---
    // #1281: IRO_THROW auf blankem Metall. Es gibt kein Betriebssystem, das
    // einen Exit-Code entgegennimmt — der Abbruch ist deshalb `bkpt #0`: der
    // Debugger haelt an, ohne Debugger loest es HardFault aus. Beides ist ein
    // sichtbarer Abbruch. Bis 1.0.16G erzeugte `throw` hier nichts und lief
    // einfach weiter. Fangen kann ihn niemand: ir_lower weist try/catch ab.
    if op == IRO_THROW {
      self.cm_e16(0xBE00);   // bkpt #0
    }

    // #1339: IRO_CONST_STR — Zeichenkettenliteral. Es fehlte; auf diesem Ziel
    // scheiterte damit schon `PrintLn("hallo")`.
    //
    // Die Bytes stehen INLINE im Codestrom, die Adresse entsteht PC-relativ,
    // ein Sprung fuehrt darum herum — wie im arm64-Backend. Bewusst NICHT ueber
    // ADR/LDR-literal: beide rechnen mit Align(PC,4), und ob der Befehl gerade
    // auf einer 4-Byte-Grenze liegt, haengt vom vorherigen Code ab. `MOV r4, PC`
    // liest den Wert ohne Ausrichtungsregel und ist damit an jeder Stelle
    // richtig.
    if op == IRO_CONST_STR {
      var strBufC: int64 := peek64(self.ir + 32);
      var spC: int64 := strBufC + imm;
      var lenC: int64 := StrLen(spC as pchar);
      var totalC: int64 := lenC + 1;                 // mit der abschliessenden 0
      var padC: int64 := totalC & 1;                 // auf gerade Laenge bringen
      var paddedC: int64 := totalC + padC;
      // MOV r4, PC  → r4 = Adresse dieses Befehls + 4
      self.cm_e16(0x467C);
      // ADDS r4, #2 → zeigt hinter den folgenden Sprung, also auf die Bytes
      self.cm_e16(0x3402);
      // B ueber die Zeichenkette: T2-Sprungweite in Halbworten, PC = B + 4
      self.cm_e16(0xE000 | (((paddedC - 2) / 2) & 0x7FF));
      var iC: int64 := 0;
      while (iC < lenC) { self.cm_e8(peek8(spC + iC)); iC := iC + 1; }
      self.cm_e8(0);
      var pC: int64 := 0;
      while (pC < padC) { self.cm_e8(0); pC := pC + 1; }
      self.cm_storeSlot(dest);
    }

    // #1339: Die Zusicherungen. ir_lower setzt ASSERT_NOT_ZERO vor jede
    // Division; bis 1.0.18B behandelte sie ausser lyxos kein Backend, der
    // Opcode verschwand, und die Division lief ungeprueft.
    //
    // Auf einem Mikrocontroller ist der Abbruch der Debug-Halt (BKPT #0),
    // dasselbe wie bei IRO_PANIC. BNE ueberspringt ihn (T1-Sprungweite in
    // Zweibyte-Schritten: 1 Befehl = imm8 0).
    if op == IRO_ASSERT_NOT_NULL || op == IRO_ASSERT_NOT_ZERO || op == IRO_ASSERT_TRUE {
      self.cm_loadSlot(src1);
      self.cm_CMP0(CM_R4);
      self.cm_e16(0xD100);       // BNE +0 → ueberspringt das folgende BKPT
      self.cm_e16(0xBE00);       // bkpt #0
    }

    // ASSERT_BOUNDS: src1 = Index, src2 = Laenge; vorzeichenlos verglichen
    // (BLO), damit ein negativer Index als sehr grosse Zahl auffaellt.
    if op == IRO_ASSERT_BOUNDS {
      self.cm_loadSlot(src1);
      self.cm_loadSlot2(src2);
      self.cm_CMP(CM_R4, CM_R5);
      self.cm_e16(0xD300);       // BLO +0 → Index < Laenge: ueberspringen
      self.cm_e16(0xBE00);       // bkpt #0
    }

    // #1339: IRO_PANIC (121) fehlte — auf einem Mikrocontroller gibt es kein
    // exit(); der Abbruch ist der Debug-Halt. BKPT #0 haelt im Debugger an und
    // loest ohne Debugger die HardFault-Behandlung aus. Beides ist ein Abbruch;
    // vorher lief das Programm nach dem panic einfach weiter.
    if op == IRO_PANIC {
      self.cm_e16(0xBE00);   // bkpt #0
    }

    if op == 167 {
      if      imm == 0  { self.cm_e16(0xBF00); }                     // nop
      else if imm == 1  { self.cm_e16(0xBF30); }                     // wfi
      else if imm == 2  { self.cm_e16(0xBF20); }                     // wfe
      else if imm == 3  { self.cm_e16(0xBF40); }                     // sev
      else if imm == 4  { self.cm_e16(0xBF10); }                     // yield
      else if imm == 5  { self.cm_e16(0xF3BF); self.cm_e16(0x8F6F); } // isb
      else if imm == 6  { self.cm_e16(0xF3BF); self.cm_e16(0x8F4F); } // dsb
      else if imm == 7  { self.cm_e16(0xF3BF); self.cm_e16(0x8F5F); } // dmb
      else if imm == 8  { self.cm_e16(0xDF00); }                     // svc #0
      else if imm == 9  { self.cm_e16(0xBE00); }                     // bkpt #0
      else if imm == 10 { self.cm_e16(0xB672); }                     // cpsid i
      else if imm == 11 { self.cm_e16(0xB662); }                     // cpsie i
      else {
        EPrintStrLn("error: asm: unbekannte Mnemonic (arm_cm)"c);
        exit(1);
      }
    }
  }

  fn emitBuiltinCall(id: int64, dest: int64) {
    // Bare-metal stubs: no OS syscalls
    self.cm_MOVS_imm(CM_R4, 0);
    self.cm_storeSlot(dest);
  }

  // --------------------------------------------------------------------------
  // Function emitter
  // --------------------------------------------------------------------------

  fn emitFunc(funcId: int64) {
    if funcId < 256 {
      poke64(self.funcAddrs + funcId * 8, self.codeLen);
      self.funcCount := self.funcCount + 1;
    }
    self.stackSize  := 0;
    self.patchCount := 0;
    var li: int64 := 0;
    while li < 1024 { poke64(self.labelAddrs + li * 8, -1); li := li + 1; }
    self.calcStackFrame(funcId);
    self.emitPrologue();
    var instrStart: int64 := self.getFuncInstrStart(funcId);
    var instrCount: int64 := self.getFuncInstrCount(funcId);
    var i: int64 := 0;
    while i < instrCount { self.emitInstr(funcId, instrStart + i); i := i + 1; }
    self.emitEpilogue();
    self.applyPatches();
  }

  // --------------------------------------------------------------------------
  // Public interface
  // --------------------------------------------------------------------------

  pub fn init(irMod: int64) {
    self.ir         := irMod;
    self.codeBuf    := alloc(131072);
    self.codeCap    := 131072;
    self.codeLen    := 0;
    self.stackSize  := 0;
    self.labelAddrs := alloc(1024 * 8);
    self.patchBuf   := alloc(1024 * 32);
    self.patchCount := 0;
    self.funcAddrs  := alloc(256 * 8);
    self.funcCount  := 0;
  }

  pub fn emit(): int64 {
    var n: int64 := self.getFuncCount();
    var i: int64 := 0;
    while i < n { self.emitFunc(i); i := i + 1; }
    return self.codeLen;
  }

  pub fn getCodeBuf(): int64 { return self.codeBuf; }
  pub fn getCodeLen(): int64 { return self.codeLen; }

  // --------------------------------------------------------------------------
  // IR accessors (same layout as EmitARM64 / EmitRISCV64)
  // --------------------------------------------------------------------------

  fn getFuncCount(): int64 {
    return peek64(self.ir + 96);
  }

  fn getFuncLocalCount(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    return peek64(funcBuf + funcId * 80 + 32);
  }

  fn getFuncInstrStart(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    return peek64(funcBuf + funcId * 80 + 16);
  }

  fn getFuncInstrCount(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    return peek64(funcBuf + funcId * 80 + 24);
  }

  fn getInstrField(absIdx: int64, fieldOff: int64): int64 {
    var instrBuf: int64 := peek64(self.ir + 8);
    return peek64(instrBuf + absIdx * 80 + fieldOff);
  }

  fn getInstrOp(absIdx: int64): int64     { return self.getInstrField(absIdx, 0); }
  fn getInstrDest(absIdx: int64): int64   { return self.getInstrField(absIdx, 8); }
  fn getInstrSrc1(absIdx: int64): int64   { return self.getInstrField(absIdx, 16); }
  fn getInstrSrc2(absIdx: int64): int64   { return self.getInstrField(absIdx, 24); }
  fn getInstrImmInt(absIdx: int64): int64 { return self.getInstrField(absIdx, 40); }
};

// ============================================================================
// ARMCMBackend  —  vector table + reset handler + ELF32 writer
// ============================================================================

pub type ARMCMBackend = class {
  code:    int64;
  codeLen: int64;
  codeCap: int64;

  fn acb_e8(v: int64) {
    poke8(self.code + self.codeLen, v & 0xFF);
    self.codeLen := self.codeLen + 1;
  }

  fn acb_e16(v: int64) {
    poke8(self.code + self.codeLen,     v & 0xFF);
    poke8(self.code + self.codeLen + 1, (v >> 8) & 0xFF);
    self.codeLen := self.codeLen + 2;
  }

  fn acb_e32(v: int64) {
    poke8(self.code + self.codeLen,     v & 0xFF);
    poke8(self.code + self.codeLen + 1, (v >> 8) & 0xFF);
    poke8(self.code + self.codeLen + 2, (v >> 16) & 0xFF);
    poke8(self.code + self.codeLen + 3, (v >> 24) & 0xFF);
    self.codeLen := self.codeLen + 4;
  }

  // Vector table (8 bytes):
  //   [0] initial SP = 0x20002000 (top of 8KB SRAM)
  //   [4] reset handler VA | 1 = 0x08000009 (Thumb bit)
  fn acb_emitVectorTable() {
    self.acb_e32(0x20002000);   // initial SP
    self.acb_e32(0x08000009);   // reset handler addr (Thumb bit set)
  }

  // Reset handler (6 bytes at offset 8):
  //   BL main: delta = +2 → {0xF000, 0xF801}  (main at offset 14, PC=12)
  //   B .    : infinite loop = 0xE7FE
  fn acb_emitResetHandler() {
    self.acb_e16(0xF000);   // BL hw1
    self.acb_e16(0xF801);   // BL hw2 (S=0, J1=1, J2=1, imm11=1)
    self.acb_e16(0xE7FE);   // B . (B #-2)
  }

  pub fn Init() {
    self.codeCap := 65536;
    self.code    := alloc(self.codeCap);
    self.codeLen := 0;
  }

  pub fn Build(irBuf: int64, irLen: int64) {
    self.acb_emitVectorTable();    // 8 bytes  → text[0..7]
    self.acb_emitResetHandler();   // 6 bytes  → text[8..13]
    // IR code: main always starts at text offset 14
    var i: int64 := 0;
    while i < irLen {
      self.acb_e8(peek8(irBuf + i));
      i := i + 1;
    }
  }

  pub fn GetCodeSize(): int64 { return self.codeLen; }

  pub fn WriteELF32(path: pchar) {
    var codeFileOffset: int64 := 4096;
    var codeSize:       int64 := self.codeLen;
    var elfSize:        int64 := codeFileOffset + codeSize;

    var elfBuf: int64 := alloc(elfSize);
    if elfBuf == -1 { return; }

    // zero entire buffer
    var z: int64 := 0;
    while z < elfSize { poke8(elfBuf + z, 0); z := z + 1; }

    // copy code section
    var ci: int64 := 0;
    while ci < codeSize {
      poke8(elfBuf + codeFileOffset + ci, peek8(self.code + ci));
      ci := ci + 1;
    }

    // ELF32 header (52 bytes)
    // e_ident[16]
    poke8(elfBuf + 0, 127); poke8(elfBuf + 1, 69);    // 0x7F 'E'
    poke8(elfBuf + 2, 76);  poke8(elfBuf + 3, 70);    // 'L' 'F'
    poke8(elfBuf + 4, 1);   poke8(elfBuf + 5, 1);     // 32-bit, little-endian
    poke8(elfBuf + 6, 1);   poke8(elfBuf + 7, 0);     // ELF v1, SysV ABI

    poke16(elfBuf + 16, 2);           // e_type: ET_EXEC
    poke16(elfBuf + 18, 0x28);        // e_machine: EM_ARM = 40
    poke32(elfBuf + 20, 1);           // e_version: EV_CURRENT
    poke32(elfBuf + 24, 0x08000008);  // e_entry: reset handler VA
    poke32(elfBuf + 28, 52);          // e_phoff: program header after ELF header
    poke32(elfBuf + 32, 0);           // e_shoff: no section headers
    poke32(elfBuf + 36, 0x05000200);  // e_flags: EABI5 | Thumb-interwork
    poke16(elfBuf + 40, 52);          // e_ehsize
    poke16(elfBuf + 42, 32);          // e_phentsize (Elf32_Phdr = 32 bytes)
    poke16(elfBuf + 44, 1);           // e_phnum
    poke16(elfBuf + 46, 40);          // e_shentsize
    poke16(elfBuf + 48, 0);           // e_shnum
    poke16(elfBuf + 50, 0);           // e_shstrndx

    // PT_LOAD segment header (32 bytes at offset 52)
    poke32(elfBuf + 52, 1);               // p_type: PT_LOAD
    poke32(elfBuf + 56, 0);              // p_offset: load from file start
    poke32(elfBuf + 60, 0x08000000);     // p_vaddr: FLASH_BASE
    poke32(elfBuf + 64, 0x08000000);     // p_paddr
    poke32(elfBuf + 68, elfSize);        // p_filesz (32-bit truncation)
    poke32(elfBuf + 72, elfSize);        // p_memsz
    poke32(elfBuf + 76, 5);              // p_flags: PF_R | PF_X
    poke32(elfBuf + 80, 0x1000);         // p_align: 4096

    var fd: int64 := open(path, 577, 493);
    if fd < 0 {
      EPrintStr("error: cannot write output: "c);
      EPrintStrLn(path);
      free(elfBuf, elfSize);
      return;
    }
    write(fd, elfBuf as pchar, elfSize);
    close(fd);
    free(elfBuf, elfSize);
  }
};
