      // Minuszeichen, falls es eins gab.
      self.emit32(0xB4000083);                                  // CBZ x3, +4
      self.emit32(0xD1000442);                                  // SUB x2, x2, #1
      self.emit32(0x528005A6);                                  // MOVZ w6, #45  ('-')
      self.emit32(0x39000046);                                  // STRB w6, [x2]
      self.emit32(0xAA0203E0);                                  // MOV x0, x2
    } else if id == 14 {
      // #1388: Zeilenumbruch auf stderr (EPrintStrLn/EPrintLn).
      self.emit32(0xD10043FF);  // SUB sp,sp,#16
      self.emit32(0x52800143);  // MOVZ w3,#10
      self.emit32(0x390003E3);  // STRB w3,[sp]
      self.emit32(0x910003E1);  // MOV x1,sp
      self.emit32(0xD2800022);  // MOVZ x2,#1
      self.emit32(0xD2800040);  // MOVZ x0,#2
      self.emit32(0xD2800808);  // MOVZ x8,#64
      self.emit32(0xD4000001);  // SVC #0
      self.emit32(0x910043FF);  // ADD sp,sp,#16
    } else {
      // #1037: bis hierher fiel jede nicht behandelte ID STILL durch — es wurde
      // kein Code erzeugt, keine Meldung ausgegeben. Genau so verschwand Printf
      // (id 12) auf Linux-ARM64 spurlos, nachdem es vorher den Barrieren-Handler
      // getroffen hatte.
      self._builtinUnsupported(id, 0);
    }
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // #1037: unbehandelte Builtin-ID laut melden statt still nichts zu erzeugen.
  // winMode: 1 = Windows-Zweig, 0 = Linux-Zweig.
  // #1388: peek8/16/32/64 und poke8/16/32/64. Bis 1.1.0A meldete arm64 sie als
  // unbehandelt — richtig gemeldet, aber eben nicht umgesetzt, und damit war
  // jede Unit unbrauchbar, die Speicher direkt anfasst (also fast die ganze
  // Standardbibliothek). Adresse steht in Slot 0, der Wert (beim Schreiben) in
  // Slot 1; das Ergebnis geht wie ueberall ueber x0 zurueck.
  fn _emitPeekPoke(id: int64, argBase: int64) {
    // #1388: Die Adresse steht NICHT in Slot 0, sondern in einem hohen Block,
    // dessen erster Slot als src1 mitkommt (argBase). ir_lower spillt seit dem
    // Misdispatch-Fix (#839) absichtlich dorthin, weil die festen Slots 0..2
    // die Locals des Aufrufers ueberschreiben. Bis 1.1.5C lasen die drei
    // IR-Backends trotzdem Slot 0 und 1 — sie bekamen also irgendeinen Wert
    // des Aufrufers als Adresse. Auf arm64 war das ein Segfault bei jedem
    // peek8; gemessen wurde damals nur, ob die BYTES entstehen, nicht, ob das
    // Programm laeuft.
    var sBase: int64 := argBase;
    if (sBase < 0) { sBase := 0; }
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(sBase));    // x1 = Adresse
    if (id == 200) { self.emitLdrb0(ARM64_X0, ARM64_X1); return; }
    if (id == 208) { self.emitLdrh0(ARM64_X0, ARM64_X1); return; }
    if (id == 201) { self.emitLdrw0(ARM64_X0, ARM64_X1); return; }
    if (id == 202) { self.emitLdrx0(ARM64_X0, ARM64_X1); return; }
    self.emitLdur(ARM64_X2, ARM64_X29, self.slotOff(sBase + 1));    // x2 = Wert
    if (id == 203) { self.emitStrb0(ARM64_X2, ARM64_X1); }
    if (id == 209) { self.emitStrh0(ARM64_X2, ARM64_X1); }
    if (id == 204) { self.emitStrw0(ARM64_X2, ARM64_X1); }
    if (id == 205) { self.emitStrx0(ARM64_X2, ARM64_X1); }
    self.emitMovImmReg(ARM64_X0, 0);
  }

  fn _builtinUnsupported(id: int64, isWin: int64) {
    EPrintStr("error: arm64: Builtin-ID "c);
    EPrintInt(id);
    if isWin != 0 { EPrintStr(" wird im Windows-Zweig nicht behandelt"c); }
    else          { EPrintStr(" wird im Linux-Zweig nicht behandelt"c); }
    EPrintStrLn(""c);
    EPrintStrLn("  Die IDs sind ein globaler Namensraum ueber alle Backends."c);
    EPrintStrLn("  Vergabe und Belegung stehen in src/backend/_builtin_ids.md."c);
    exit(1);
  }

  // -------------------------------------------------------------------------
  // Branches and labels
  // -------------------------------------------------------------------------

  fn emitLabelDef(labelId: int64) {
    // #2112: Die Tabelle war fest bei 1024; eine Marke jenseits davon wurde
    // still verworfen und ihr Sprung nie nachgetragen.
    if labelId < 0 {
      EPrintStr("error: arm64: negative Marke "c); EPrintInt(labelId); EPrintStrLn(" (#2112)."c);
      exit(1);
    }
    if labelId >= self.labelCap {
      var nc: int64 := self.labelCap * 2;
      while labelId >= nc { nc := nc * 2; }
      var nb: int64 := alloc(nc * 8);
      var ci: int64 := 0;
      while ci < nc {
        if ci < self.labelCap { poke64(nb + ci * 8, peek64(self.labelAddrs + ci * 8)); }
        else                  { poke64(nb + ci * 8, -1); }
        ci := ci + 1;
      }
      self.labelAddrs := nb;
      self.labelCap   := nc;
    }
    poke64(self.labelAddrs + labelId * 8, self.codeLen);
  }

  fn emitBranch(labelId: int64) {
    var off: int64 := self.codeLen;
    self.emit32(0x14000000);  // B placeholder
    self.addPatch(off, labelId, PATCH_B, 0);
  }

  // kind=1 → branch if slot!=0 (CBNZ), kind=0 → branch if slot==0 (CBZ)
  fn emitBranchCond(condSlot: int64, labelId: int64, kind: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(condSlot));
    var off: int64 := self.codeLen;
    if kind == 1 {
      self.emit32(0xB5000000);  // CBNZ x0, placeholder
      self.addPatch(off, labelId, PATCH_CBNZ, ARM64_X0);
    } else {
      self.emit32(0xB4000000);  // CBZ x0, placeholder
      self.addPatch(off, labelId, PATCH_CBZ, ARM64_X0);
    }
  }

  // #2112: Die Liste wuchs nicht — jenseits von 1024 Eintraegen fiel jeder
  // weitere Patch still weg. Weil die Aufruf-Patches ueber alle Funktionen
  // hinweg stehenbleiben (siehe emitFunc), reichten dafuer gut tausend Aufrufe
  // im ganzen Programm. Dieselbe Rechnung wie addPatch in riscv_linux.lyx
  // (#1740) — die beiden muessen uebereinstimmen.
  fn addPatch(codeOff: int64, labelId: int64, ptype: int64, reg: int64) {
    if self.patchCount >= self.patchCap {
      var nc: int64 := self.patchCap * 2;
      var nb: int64 := alloc(nc * 32);
      var ci: int64 := 0;
      while ci < self.patchCount * 4 {
        poke64(nb + ci * 8, peek64(self.patchBuf + ci * 8));
        ci := ci + 1;
      }
      self.patchBuf := nb;
      self.patchCap := nc;
    }
    var base: int64 := self.patchBuf + self.patchCount * 32;
    poke64(base,      codeOff);
    poke64(base + 8,  labelId);
    poke64(base + 16, ptype);
    poke64(base + 24, reg);
    self.patchCount := self.patchCount + 1;
  }

  // #2112: Abstand passt nicht ins Befehlsfeld — vorher wurde er still auf
  // die Feldbreite maskiert und der Sprung landete irgendwo.
  fn _patchRangeError(what: pchar, dist: int64, limit: int64) {
    EPrintStr("error: arm64: "c); EPrintStr(what);
    EPrintStr(": Abstand "c); EPrintInt(dist);
    EPrintStr(" Byte ueberschreitet die Reichweite von +/-"c); EPrintInt(limit);
    EPrintStrLn(" Byte (#2112)."c);
    exit(1);
  }

  // #2112: mode 1 = Ende einer Funktion (offene Marken-Patches sind ein
  // Fehler), mode 0 = Ende von emit() (auch offene Aufrufe/Adressen).
  fn _checkNoOpenPatches(mode: int64) {
    var i: int64 := 0;
    while i < self.patchCount {
      var base:  int64 := self.patchBuf + i * 32;
      var lid:   int64 := peek64(base + 8);
      var ptype: int64 := peek64(base + 16);
      if lid != -2 {
        var isFn: int64 := 0;
        if ptype == PATCH_BL || ptype == PATCH_ADR { isFn := 1; }
        if mode == 0 || isFn == 0 {
          EPrintStr("error: arm64: Sprungziel nie aufgeloest — "c);
          if isFn != 0 { EPrintStr("Funktion "c); } else { EPrintStr("Marke "c); }
          EPrintInt(lid);
          EPrintStr(" (Patchtyp "c); EPrintInt(ptype);
          EPrintStr(", Code-Offset "c); EPrintInt(peek64(base));
          EPrintStrLn(") (#2112)."c);
          exit(1);
        }
      }
      i := i + 1;
    }
  }

  fn applyPatches() {
    var i: int64 := 0;
    while i < self.patchCount {
      var base:    int64 := self.patchBuf + i * 32;
      var labelId: int64 := peek64(base + 8);
      // WP-AND-upstream-fix v9: -2 = already patched, skip.
      if labelId != -2 {
        var codeOff: int64 := peek64(base);
        var ptype:   int64 := peek64(base + 16);
        var reg:     int64 := peek64(base + 24);

        // Use -1 sentinel for "unset" because funcAddrs / labelAddrs are
        // mmap-zero so entry 0 is a legitimate address. Resolution depends
        // on the pre-init pass in calcStackFrame for labelAddrs and on the
        // funcAddrs writes in emitFunc.
        var target: int64 := -1;
        if ptype == PATCH_BL || ptype == PATCH_ADR {
          if labelId >= 0 && labelId < self.funcCap {
            target := peek64(self.funcAddrs + labelId * 8);
            // A funcAddrs[i] of 0 is valid only for the FIRST emitted
            // function (labelId 0). Any other 0 means "not yet emitted".
            if target == 0 {
              if labelId != 0 { target := -1; }
            }
          }
        } else {
          if labelId >= 0 && labelId < self.labelCap {
            target := peek64(self.labelAddrs + labelId * 8);
          }
        }

        if target >= 0 {
          var delta: int64 := (target - codeOff) >> 2;
          // #2112: Reichweiten — B/BL imm26 (+/-128 MiB), CBZ/CBNZ imm19
          // (+/-1 MiB), ADR imm21 in Byte (+/-1 MiB). Vorher wurde der Abstand
          // still auf die Feldbreite maskiert.
          var dist: int64 := target - codeOff;
          if ptype == PATCH_B || ptype == PATCH_BL {
            if dist < 0 - 0x8000000 || dist >= 0x8000000 {
              self._patchRangeError("B/BL"c, dist, 0x8000000);
            }
          } else if ptype == PATCH_ADR {
            if dist < 0 - 0x100000 || dist >= 0x100000 {
              self._patchRangeError("ADR (Funktionsadresse)"c, dist, 0x100000);
            }
          } else if ptype == PATCH_CBZ || ptype == PATCH_CBNZ {
            if dist < 0 - 0x100000 || dist >= 0x100000 {
              self._patchRangeError("CBZ/CBNZ (bedingter Sprung, Funktion zu gross)"c, dist, 0x100000);
            }
          } else {
            EPrintStr("error: arm64: unbekannter Patchtyp "c); EPrintInt(ptype); EPrintStrLn(" (#2112)."c);
            exit(1);
          }
          if ptype == PATCH_B || ptype == PATCH_BL {
            var opc: int64 := 0x14000000;
            if ptype == PATCH_BL { opc := 0x94000000; }
            var enc: int64 := opc | (delta & 0x3FFFFFF);
            self.poke32at(codeOff, enc);
          } else if ptype == PATCH_ADR {
            // #1806: ADR traegt den Abstand in BYTE (nicht in Befehlen), 21 Bit,
            // aufgeteilt in immlo (Bits 30:29) und immhi (Bits 23:5).
            var dByte: int64 := target - codeOff;
            var immlo: int64 := dByte & 3;
            var immhi: int64 := (dByte >> 2) & 0x7FFFF;
            self.poke32at(codeOff, 0x10000000 | (immlo << 29) | (immhi << 5) | reg);
          } else if ptype == PATCH_CBZ {
            var enc: int64 := 0xB4000000 | ((delta & 0x7FFFF) << 5) | reg;
            self.poke32at(codeOff, enc);
          } else if ptype == PATCH_CBNZ {
            var enc: int64 := 0xB5000000 | ((delta & 0x7FFFF) << 5) | reg;
            self.poke32at(codeOff, enc);
          }
          // Mark as resolved so a later applyPatches call skips it.
          poke64(base + 8, -2);
        }
      }
      i := i + 1;
    }
  }

  // -------------------------------------------------------------------------
  // Allocation
  // -------------------------------------------------------------------------

  // #2144: Rueckgabewert von mmap pruefen, statt ihn als Zeiger zu benutzen.
  // Dieselbe Pruefung wie cg_emitMmapGeprueft im x86-Weg (#1947) und
  // rv_mmapGeprueft (riscv_linux.lyx) — die drei muessen uebereinstimmen:
  // Fehlerbereich [-4095, -1], Meldung "Speicheranforderung fehlgeschlagen
  // (mmap)" auf stderr, exit_group(1). Bis 1.2.16A lief -ENOMEM als Adresse
  // weiter und der naechste Zugriff faultete ohne Aussage.
  // Erwartet x0 direkt nach dem SVC. Die Meldung steht im Code (wie
  // emitConstStr), ADR adressiert sie. Ueberschreibt im Fehlerfall x0-x2, x8.
  fn emitMmapGeprueft() {
    if self.winMode != 0 { return; }   // VirtualAlloc-Weg, kein mmap
    self.emit32(0xB13FFC1F);   // CMN x0, #4095   (C=1 genau fuer x0 in [-4095,-1])
    self.emit32(0x54000283);   // B.LO +20 Befehle (hinter die Meldung)
    self.emit32(0x10000101);   // ADR x1, +32 (Meldung)
    self.emit32(0xD2800040);   // MOVZ x0, #2 (stderr)
    self.emit32(0xD2800542);   // MOVZ x2, #42
    self.emit32(0xD2800808);   // MOVZ x8, #64 (write)
    self.emit32(0xD4000001);   // SVC #0
    self.emit32(0xD2800020);   // MOVZ x0, #1
    self.emit32(0xD2800BC8);   // MOVZ x8, #94 (exit_group)
    self.emit32(0xD4000001);   // SVC #0
    // "Speicheranforderung fehlgeschlagen (mmap)\n" + 2 Byte Fuellung = 11 Worte
    var m: pchar := "Speicheranforderung fehlgeschlagen (mmap)\n";
    var i: int64 := 0;
    while i < 42 { self.emit8(StrCharAt(m, i)); i := i + 1; }
    self.emit8(0); self.emit8(0);
  }

  fn emitAlloc(sizeSlot: int64, dest: int64) {
    // WP-D2: Windows mode — call wab_alloc helper (VirtualAlloc)
    if self.winMode != 0 {
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(sizeSlot));
      self.addWinPatch(self.codeLen, 4);
      self.emit32(0x94000000);  // BL placeholder → wab_alloc
      self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
      return;
    }
    // Linux: mmap(0, size, PROT_RW=3, MAP_PRIVATE|MAP_ANON=34, -1, 0)
    self.emitMovImmReg(ARM64_X0, 0);   // addr=0
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(sizeSlot));
    self.emitMovImmReg(ARM64_X2, 3);   // PROT_READ|PROT_WRITE
    self.emitMovImmReg(ARM64_X3, 34);  // MAP_PRIVATE|MAP_ANON
    self.emitMovImmReg(ARM64_X4, -1);  // fd=-1
    self.emitMovImmReg(ARM64_X5, 0);   // offset=0
    self.emitMovImmReg(ARM64_X8, SYS_MMAP);
    self.emit32(0xD4000001);           // SVC #0
    self.emitMmapGeprueft();   // #2144
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // #2052: lenSlot ist die Laenge aus `munmap(p, n)`, destSlot nimmt den
  // Rueckgabewert auf. lenSlot == -1 heisst "Laenge unbekannt" (dispose).
  fn emitFree(ptrSlot: int64, lenSlot: int64, destSlot: int64) {
    // WP-D2: Windows mode — call wab_free helper (VirtualFree)
    if self.winMode != 0 {
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(ptrSlot));
      self.addWinPatch(self.codeLen, 5);
      self.emit32(0x94000000);  // BL placeholder → wab_free
      return;
    }
    // Linux: munmap(ptr, len)
    //
    // #2052: Hier stand `x1 = 0`. munmap mit Laenge 0 ist unter Linux immer
    // EINVAL — der Aufruf gab nie etwas frei.
    //
    // Ohne bekannte Laenge wird deshalb gar nichts erzeugt, statt einen
    // Systemaufruf abzusetzen, der nur scheitern kann. Dieselbe Entscheidung
    // steht in riscv_linux.lyx — die beiden muessen uebereinstimmen.
    if lenSlot < 0 { return; }
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(ptrSlot));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(lenSlot));
    self.emitMovImmReg(ARM64_X8, SYS_MUNMAP);
    self.emit32(0xD4000001);
    if destSlot >= 0 { self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(destSlot)); }
  }

  // -------------------------------------------------------------------------
  // Type conversions
  // -------------------------------------------------------------------------

  fn emitItof(src: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));
    // SCVTF d0, x0  (int64 → double)
    self.emit32(0x9E620000 | (ARM64_X0 << 5) | ARM64_D0);
    self.emitFStur(ARM64_D0, ARM64_X29, self.slotOff(dest));
  }

  fn emitFtoi(src: int64, dest: int64) {
    self.emitFLdur(ARM64_D0, ARM64_X29, self.slotOff(src));
    // FCVTZS x0, d0  (double → int64, round to zero)
    self.emit32(0x9E780000 | (ARM64_D0 << 5) | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // -------------------------------------------------------------------------
  // NEON SIMD
  // -------------------------------------------------------------------------

  fn emitNeon(base: int64, src1: int64, src2: int64, dest: int64) {
    // Use v0.2d and v1.2d as scratch SIMD regs, result in v0.2d
    self.emitFLdur(ARM64_D0, ARM64_X29, self.slotOff(src1));
    self.emitFLdur(ARM64_D1, ARM64_X29, self.slotOff(src2));
    self.emit32(base | (1 << 16) | (0 << 5) | 0);
    self.emitFStur(ARM64_D0, ARM64_X29, self.slotOff(dest));
  }

  // -------------------------------------------------------------------------
  // Low-level LDUR/STUR (simm9: -256..255)
  // -------------------------------------------------------------------------

  // #1388: schmale und unskalierte Zugriffe fuer die Speicher-Builtins
  // (peek8/16/32/64, poke8/16/32/64). Offset ist hier immer 0 — die Adresse
  // steht bereits im Register.
  fn emitLdrb0(rt: int64, rn: int64) {   // LDRB Wt, [Xn]
    self.emit32(0x39400000 | (rn << 5) | rt);
  }
  fn emitLdrh0(rt: int64, rn: int64) {   // LDRH Wt, [Xn]
    self.emit32(0x79400000 | (rn << 5) | rt);
  }
  fn emitLdrw0(rt: int64, rn: int64) {   // LDR Wt, [Xn]  (nullt die oberen 32 Bit)
    self.emit32(0xB9400000 | (rn << 5) | rt);
  }
  fn emitLdrx0(rt: int64, rn: int64) {   // LDR Xt, [Xn]
    self.emit32(0xF9400000 | (rn << 5) | rt);
  }
  fn emitStrb0(rt: int64, rn: int64) {   // STRB Wt, [Xn]
    self.emit32(0x39000000 | (rn << 5) | rt);
  }
  fn emitStrh0(rt: int64, rn: int64) {   // STRH Wt, [Xn]
    self.emit32(0x79000000 | (rn << 5) | rt);
  }
  fn emitStrw0(rt: int64, rn: int64) {   // STR Wt, [Xn]
    self.emit32(0xB9000000 | (rn << 5) | rt);
  }
  fn emitStrx0(rt: int64, rn: int64) {   // STR Xt, [Xn]
    self.emit32(0xF9000000 | (rn << 5) | rt);
  }

  fn emitLdur(rt: int64, rn: int64, off: int64) {
    // LDUR Xt, [Xn, #simm9] — Bereichsgrenze wie bei emitStur (#1388).
    if (off >= (0 - 256) && off <= 255) {
      self.emit32(0xF8400000 | ((off & 0x1FF) << 12) | (rn << 5) | rt);
      return;
    }
    self._emitFarAddr(rn, off);
    self.emit32(0xF9400000 | (16 << 5) | rt);          // LDR Xt, [x16]
  }

  fn emitStur(rt: int64, rn: int64, off: int64) {
    // STUR Xt, [Xn, #simm9]
    //
    // #1388: simm9 reicht von -256 bis 255. Ein groesserer Offset wurde bis
    // 1.1.5C stillschweigend auf neun Bit gekuerzt: Slot 32 liegt bei -264 und
    // landete damit bei +248 — ein Schreibzugriff mitten in fremde Daten. Das
    // fiel nicht auf, solange Funktionen klein blieben; der Kratzstreifen aus
    // diesem Ticket schiebt jede Funktion um acht Slots weiter, und damit
    // wurde aus der Enge ein Absturz.
    //
    // Passt es nicht, wird die Adresse erst gerechnet: x16 ist nach AAPCS64
    // Kratzregister (IP0) und wird von diesem Backend sonst nicht benutzt.
    if (off >= (0 - 256) && off <= 255) {
      self.emit32(0xF8000000 | ((off & 0x1FF) << 12) | (rn << 5) | rt);
      return;
    }
    self._emitFarAddr(rn, off);
    self.emit32(0xF9000000 | (16 << 5) | rt);          // STR Xt, [x16]
  }

  // #1388: x16 := Xn + off, fuer Offsets ausserhalb von simm9. off ist hier
  // immer negativ (Slots liegen unter dem Rahmenzeiger).
  //
  // #2062: Bis 1.2.11G endete die Reichweite bei 4095 — der Direktwert von SUB
  // fasst zwoelf Bit —, und darueber wurde gemeldet: eine Funktion mit mehr als
  // 512 Slots war fuer arm64 nicht uebersetzbar (examples/test_zlib.lyx). SUB
  // kennt dieselben zwoelf Bit auch um zwoelf geschoben; in zwei Schritten
  // reicht es damit bis 16 MB. Der haeufige Fall bleibt ein Befehl.
  //
  // Das Gegenstueck auf riscv ist _rvWeit (#2061).
  fn _emitFarAddr(rn: int64, off: int64) {
    var betrag: int64 := 0 - off;
    if (off > 0) {
      EPrintStrLn("error: arm64: positiver Rahmen-Offset ausserhalb simm9 (#1388)"c);
      exit(1);
    }
    if (betrag > 0xFFFFFF) {
      EPrintStr("error: arm64: Rahmen zu gross — Slot-Offset "c);
      EPrintInt(betrag);
      EPrintStrLn(" ueberschreitet 16 MB (#2062)."c);
      exit(1);
    }
    if (betrag <= 4095) {
      self.emit32(0xD1000000 | (betrag << 10) | (rn << 5) | 16);   // SUB x16, Xn, #betrag
      return;
    }
    var hoch: int64 := (betrag >> 12) & 0xFFF;
    var tief: int64 := betrag & 0xFFF;
    self.emit32(0xD1400000 | (hoch << 10) | (rn << 5) | 16);       // SUB x16, Xn, #hoch, LSL #12
    if (tief != 0) {
      self.emit32(0xD1000000 | (tief << 10) | (16 << 5) | 16);     // SUB x16, x16, #tief
    }
  }

  fn emitFLdur(rt: int64, rn: int64, off: int64) {
    // LDUR Dt, [Xn, #simm9]  (64-bit FP/SIMD) — Bereichsgrenze wie oben (#1388).
    if (off >= (0 - 256) && off <= 255) {
      self.emit32(0xFC400000 | ((off & 0x1FF) << 12) | (rn << 5) | rt);
      return;
    }
    self._emitFarAddr(rn, off);
    self.emit32(0xFD400000 | (16 << 5) | rt);          // LDR Dt, [x16]
  }

  fn emitFStur(rt: int64, rn: int64, off: int64) {
    // STUR Dt, [Xn, #simm9] — Bereichsgrenze wie oben (#1388).
    if (off < (0 - 256) || off > 255) {
      self._emitFarAddr(rn, off);
      self.emit32(0xFD000000 | (16 << 5) | rt);        // STR Dt, [x16]
      return;
    }
    self.emit32(0xFC000000 | ((off & 0x1FF) << 12) | (rn << 5) | rt);
  }

  // -------------------------------------------------------------------------
  // MOV immediate: MOVZ + MOVK sequence
  // -------------------------------------------------------------------------

  fn emitMovImmReg(reg: int64, imm: int64) {
    var lo: int64 := imm & 0xFFFF;
    var hi: int64 := (imm >> 16) & 0xFFFF;
    var hi2: int64 := (imm >> 32) & 0xFFFF;
    var hi3: int64 := (imm >> 48) & 0xFFFF;

    // MOVZ Xd, #lo  (hw=00)
    self.emit32(0xD2800000 | (lo << 5) | reg);

    if hi != 0 || hi2 != 0 || hi3 != 0 {
      // MOVK Xd, #hi, LSL #16  (hw=01)
      self.emit32(0xF2A00000 | (hi << 5) | reg);
    }
    if hi2 != 0 || hi3 != 0 {
      // MOVK Xd, #hi2, LSL #32  (hw=10)
      self.emit32(0xF2C00000 | (hi2 << 5) | reg);
    }
    if hi3 != 0 {
      // MOVK Xd, #hi3, LSL #48  (hw=11)
      self.emit32(0xF2E00000 | (hi3 << 5) | reg);
    }
  }

  // -------------------------------------------------------------------------
  // Buffer helpers
  // -------------------------------------------------------------------------

  fn emit32(val: int64) {
    if self.codeLen + 4 > self.codeCap {
      var newCap: int64 := self.codeCap * 2;
      var nb: int64 := alloc(newCap);
      var i: int64 := 0;
      while i < self.codeLen {
        poke8(nb + i, peek8(self.codeBuf + i));
        i := i + 1;
      }
      self.codeBuf := nb;
      self.codeCap := newCap;
    }
    poke8(self.codeBuf + self.codeLen,     val & 0xFF);
    poke8(self.codeBuf + self.codeLen + 1, (val >> 8) & 0xFF);
    poke8(self.codeBuf + self.codeLen + 2, (val >> 16) & 0xFF);
    poke8(self.codeBuf + self.codeLen + 3, (val >> 24) & 0xFF);
    self.codeLen := self.codeLen + 4;
  }

  // WP-AND-02 Phase C: 8-byte little-endian emit; used for inline literal pool slots.
  fn emit64(val: int64) {
    self.emit32(val & 0xFFFFFFFF);
    self.emit32((val >> 32) & 0xFFFFFFFF);
  }

  // Single byte (used to embed inline string-literal data in the code stream).
  fn emit8(val: int64) {
    if self.codeLen + 1 > self.codeCap {
      var newCap: int64 := self.codeCap * 2;
      var nb: int64 := alloc(newCap);
      var i: int64 := 0;
      while i < self.codeLen { poke8(nb + i, peek8(self.codeBuf + i)); i := i + 1; }
      self.codeBuf := nb;
      self.codeCap := newCap;
    }
    poke8(self.codeBuf + self.codeLen, val & 0xFF);
    self.codeLen := self.codeLen + 1;
  }


  fn poke32at(off: int64, val: int64) {
    poke8(self.codeBuf + off,     val & 0xFF);
    poke8(self.codeBuf + off + 1, (val >> 8) & 0xFF);
    poke8(self.codeBuf + off + 2, (val >> 16) & 0xFF);
    poke8(self.codeBuf + off + 3, (val >> 24) & 0xFF);
  }

  fn getCodeBuf(): int64 { return self.codeBuf; }
  fn getCodeLen(): int64 { return self.codeLen; }
  // ==================================================================
  // #1776: Gleitkomma als Text (Builtin 403 FloatToStr, Builtin 9 PrintFloat).
  //
  // Bis 1.1.9G war ID 9 auf dem Linux-Zweig ein No-op („load float bits, no-op
  // print") und ID 403 fehlte ganz. Ausgegeben hat stattdessen eine
  // gleichnamige Lyx-Funktion aus std/io — die auf x86 vom Builtin verdeckt
  // wurde. Derselbe Quelltext gab damit je nach Ziel etwas anderes aus.
  //
  // Umgesetzt wie im riscv-Backend (#1770) und zeichengleich mit dem x86-Weg:
  // Vorzeichen, ganzer Teil, Punkt, GENAU sechs Nachkommastellen,
  // abgeschnitten statt gerundet. nan und inf werden an den Bits erkannt, ein
  // zu grosser Wert meldet sich als "overflow" statt eine Zahl zu erfinden.
  //
  // Alle Spruenge werden NACHGETRAGEN. Gezaehlte Weiten waren in #1770 zweimal
  // falsch, weil emitMovImmReg je nach Wert unterschiedlich viele Befehle
  // erzeugt — auf arm64 gilt dasselbe.
  // ==================================================================

  // Ziffern einer nichtnegativen Zahl schreiben. x19 = Wert, x20 = Schreibmarke.
  // stellen > 0: feste Stellenzahl mit fuehrenden Nullen; 0: so viele wie noetig.
  fn a64Ziffern(stellen: int64) {
    if stellen > 0 {
      var teiler: int64 := 1;
      var si: int64 := 1;
      while si < stellen { teiler := teiler * 10; si := si + 1; }
      self.emitMovImmReg(ARM64_X21, teiler);
    } else {
      self.emitMovImmReg(ARM64_X21, 1);
      self.emitMovImmReg(ARM64_X22, 10);
      var gLoop: int64 := self.codeLen;
      self.emit32(0x9AD50E77);                 // SDIV x23, x19, x21
      self.emit32(0xEB1602FF);                 // CMP  x23, x22
      var gRaus: int64 := self.codeLen; self.emit32(0);   // B.LT -> fertig
      self.emit32(0x9B167EB5);                 // MUL  x21, x21, x22
      self.emit32(0x14000000 | (((gLoop - self.codeLen) / 4) & 0x3FFFFFF));
      self.poke32at(gRaus, 0x5400000B | ((((self.codeLen - gRaus) / 4) & 0x7FFFF) << 5));
    }
    self.emitMovImmReg(ARM64_X22, 10);
    var zLoop: int64 := self.codeLen;
    self.emit32(0x9AD50E77);                   // SDIV x23, x19, x21
    self.emit32(0x9AD60EF8);                   // SDIV x24, x23, x22
    self.emit32(0x9B16DF17);                   // MSUB x23, x24, x22, x23   (x23 %= 10)
    self.emit32(0x9100C2F7);                   // ADD  x23, x23, #48  ('0')
    self.emit32(0x39000297);                   // STRB w23, [x20]
    self.emit32(0x91000694);                   // ADD  x20, x20, #1
    self.emit32(0x9AD60EB5);                   // SDIV x21, x21, x22
    self.emit32(0xF10002BF);                   // CMP  x21, #0
    var zRaus: int64 := self.codeLen; self.emit32(0);   // B.EQ -> fertig
    self.emit32(0x14000000 | (((zLoop - self.codeLen) / 4) & 0x3FFFFFF));
    self.poke32at(zRaus, 0x54000000 | ((((self.codeLen - zRaus) / 4) & 0x7FFFF) << 5));
  }

  // f64 als Text in einen frischen Puffer; Zeiger nach x0.
  fn a64FloatToStr(bitsSlot: int64) {
    // #2149: x19..x24 sind callee-saved. Der Formatierer benutzt sie, bis
    // 1.2.16E ohne sie zu retten — unter Lyx-Aufrufern faellt das nicht auf
    // (keiner haelt darin etwas), ein C-Aufrufer einer Lyx-.so verliert aber
    // seine Werte. Gesichert unterhalb von sp, zurueck am Ende (lEnde).
    self.emit32(0xA9BD53F3);                   // STP x19, x20, [sp, #-48]!
    self.emit32(0xA9015BF5);                   // STP x21, x22, [sp, #16]
    self.emit32(0xA90263F7);                   // STP x23, x24, [sp, #32]
    // Puffer aus mmap(0, 48, PROT_RW, MAP_PRIVATE|ANON)
    self.emitMovImmReg(ARM64_X0, 0);
    self.emitMovImmReg(ARM64_X1, 48);
    self.emitMovImmReg(ARM64_X2, 3);
    self.emitMovImmReg(ARM64_X3, 0x22);
    self.emit32(0x92800004);                   // MOVN x4, #0   (fd = -1)
    self.emitMovImmReg(ARM64_X5, 0);
    self.emitMovImmReg(ARM64_X8, SYS_MMAP);
    self.emit32(0xD4000001);                   // SVC #0 → x0 = Puffer
    self.emitMmapGeprueft();   // #2144
    self.emit32(0xAA0003F4);                   // MOV x20, x0   (Schreibmarke)
    self.emitLdur(ARM64_X9, ARM64_X29, self.slotOff(bitsSlot));   // x9 = Bitmuster

    // Sonderfaelle: nach dem Verdoppeln faellt das Vorzeichen heraus.
    self.emit32(0x8B090129);                   // ADD  x9, x9, x9
    self.emitMovImmReg(ARM64_X10, 0 - 9007199254740992);          // 0xFFE0000000000000
    self.emit32(0xEB0A013F);                   // CMP  x9, x10
    var bKeinNan: int64 := self.codeLen; self.emit32(0);          // B.LS -> kein NaN
    self.emitMovImmReg(ARM64_X11, 7233902);    // 'n','a','n',0
    self.emit32(0xB900028B);                   // STR  w11, [x20]
    self.emit32(0x91000E94);                   // ADD  x20, x20, #3
    var jNan: int64 := self.codeLen; self.emit32(0);
    var lKeinNan: int64 := self.codeLen;
    self.emit32(0xEB0A013F);                   // CMP  x9, x10
    var bKeinInf: int64 := self.codeLen; self.emit32(0);          // B.NE -> Zahl
    self.emitMovImmReg(ARM64_X11, 6712937);    // 'i','n','f',0
    self.emit32(0xB900028B);                   // STR  w11, [x20]
    self.emit32(0x91000E94);                   // ADD  x20, x20, #3
    var jInf: int64 := self.codeLen; self.emit32(0);

    // Endlicher Wert: d0 = Zahl, d1 = 0.0
    var lZahl: int64 := self.codeLen;
    self.emitLdur(ARM64_X9, ARM64_X29, self.slotOff(bitsSlot));
    self.emit32(0x9E670120);                   // FMOV d0, x9
    self.emit32(0x9E6703E1);                   // FMOV d1, xzr
    self.emit32(0x1E612000);                   // FCMP d0, d1
    var bNichtNeg: int64 := self.codeLen; self.emit32(0);         // B.GE
    self.emitMovImmReg(ARM64_X11, 45);         // '-'
    self.emit32(0x3900028B);                   // STRB w11, [x20]
    self.emit32(0x91000694);                   // ADD  x20, x20, #1
    self.emit32(0x1E614000);                   // FNEG d0, d0

    // Passt der ganze Teil in eine 64-Bit-Zahl?
    var lPositiv: int64 := self.codeLen;
    self.emit32(0x9E780013);                   // FCVTZS x19, d0
    self.emitMovImmReg(ARM64_X10, 0 - 9223372036854775807 - 1);
    self.emit32(0xEB0A027F);                   // CMP  x19, x10
    var bPasst: int64 := self.codeLen; self.emit32(0);            // B.NE -> Ziffern
    self.emitMovImmReg(ARM64_X11, 1919252079); // 'o','v','e','r'
    self.emit32(0xB900028B);                   // STR  w11, [x20]
    self.emitMovImmReg(ARM64_X11, 2003790950); // 'f','l','o','w'
    self.emit32(0xB900068B);                   // STR  w11, [x20, #4]
    self.emit32(0x91002294);                   // ADD  x20, x20, #8
    var jBig: int64 := self.codeLen; self.emit32(0);

    var lZiffern: int64 := self.codeLen;
    self.a64Ziffern(0);
    self.emitMovImmReg(ARM64_X11, 46);         // '.'
    self.emit32(0x3900028B);                   // STRB w11, [x20]
    self.emit32(0x91000694);                   // ADD  x20, x20, #1
    self.emit32(0x9E620261);                   // SCVTF d1, x19
    self.emit32(0x1E613800);                   // FSUB d0, d0, d1
    self.emitMovImmReg(ARM64_X11, 4696837146684686336);   // 1e6
    self.emit32(0x9E670161);                   // FMOV d1, x11
    self.emit32(0x1E610800);                   // FMUL d0, d0, d1
    self.emit32(0x9E780013);                   // FCVTZS x19, d0
    self.a64Ziffern(6);

    var lEnde: int64 := self.codeLen;
    self.emit32(0x3900029F);                   // STRB wzr, [x20]
    self.emit32(0xA94263F7);                   // #2149: LDP x23, x24, [sp, #32]
    self.emit32(0xA9415BF5);                   //        LDP x21, x22, [sp, #16]
    self.emit32(0xA8C353F3);                   //        LDP x19, x20, [sp], #48

    self.poke32at(bKeinNan,  0x54000009 | ((((lKeinNan - bKeinNan) / 4) & 0x7FFFF) << 5));   // B.LS
    self.poke32at(bKeinInf,  0x54000001 | ((((lZahl - bKeinInf) / 4) & 0x7FFFF) << 5));      // B.NE
    self.poke32at(bNichtNeg, 0x5400000A | ((((lPositiv - bNichtNeg) / 4) & 0x7FFFF) << 5));  // B.GE
    self.poke32at(bPasst,    0x54000001 | ((((lZiffern - bPasst) / 4) & 0x7FFFF) << 5));     // B.NE
    self.poke32at(jNan, 0x14000000 | ((((lEnde - jNan) / 4) & 0x3FFFFFF)));
    self.poke32at(jInf, 0x14000000 | ((((lEnde - jInf) / 4) & 0x3FFFFFF)));
    self.poke32at(jBig, 0x14000000 | ((((lEnde - jBig) / 4) & 0x3FFFFFF)));
  }

  fn getFuncAddrs(): int64 { return self.funcAddrs; }   // WP-AND-02 Phase B: expose for export-table

  // #2149: Huelle fuer eine exportierte Funktion mit Gleitkomma an der
  // C-Schnittstelle (Gegenstueck zu cg_soEmitHuellen auf x86, #2124).
  //
  // Lyx uebergibt JEDES Argument der Reihe nach in x0..x7 (ein f64 als
  // Bitmuster), C nach AAPCS64 Ganzzahlen in x0..x7 und Gleitkomma GETRENNT
  // gezaehlt in d0..d7 (f32 in s0..s7). Bis 1.2.16E sprang das Symbol direkt
  // in den Rumpf: C legte den Wert in d0, Lyx las x0 — still falsch.
  //
  // arten: zwei Bit je Parameter (0 Ganzzahl, 1 f64, 2 f32), rueck ebenso.
  // Die Ganzzahlen ruecken von hinten nach vorn auf ihre Lyx-Position (das
  // Ziel liegt nie vor der Quelle, also ueberschreibt keine Verschiebung eine
  // noch ungelesene), danach kommen die Gleitkommawerte aus d/s in die Luecken.
  // Liefert den Codeversatz der Huelle (das Symbol zeigt dorthin).
  fn emitSoHuelle(funcId: int64, n: int64, arten: int64, rueck: int64): int64 {
    if n > 8 {
      EPrintStrLn("error: arm64 --shared: exportierte Funktion mit Gleitkomma und mehr als acht Parametern ist nicht umgesetzt (#2149)."c);
      exit(1);
    }
    var start: int64 := self.codeLen;
    self.emit32(0xA9BF7BFD);                   // STP x29, x30, [sp, #-16]!
    self.emit32(0x910003FD);                   // MOV x29, sp
    // Quellregister je Parameter bestimmen
    var gi: int64 := 0;
    var fi: int64 := 0;
    var quelle: int64 := alloc(8 * 8);
    var i: int64 := 0;
    while i < n {
      var a: int64 := (arten >> (i * 2)) & 3;
      if a == 0 { poke64(quelle + i * 8, gi); gi := gi + 1; }
      else { poke64(quelle + i * 8, fi); fi := fi + 1; }
      i := i + 1;
    }
    // Ganzzahlen: von hinten nach vorn auf x_i
    i := n - 1;
    while i >= 0 {
      if ((arten >> (i * 2)) & 3) == 0 {
        var q: int64 := peek64(quelle + i * 8);
        if q != i { self.emit32(0xAA0003E0 | (q << 16) | i); }   // MOV x_i, x_q
      }
      i := i - 1;
    }
    // Gleitkomma: d_q (bzw. s_q, erst nach double) nach x_i
    i := 0;
    while i < n {
      var a2: int64 := (arten >> (i * 2)) & 3;
      if a2 != 0 {
        var q2: int64 := peek64(quelle + i * 8);
        if a2 == 2 { self.emit32(0x1E22C000 | (q2 << 5) | q2); }   // FCVT d_q, s_q
        self.emit32(0x9E660000 | (q2 << 5) | i);                    // FMOV x_i, d_q
      }
      i := i + 1;
    }
    free(quelle, 8 * 8);
    // BL Rumpf
    var ziel: int64 := peek64(self.funcAddrs + funcId * 8);
    self.emit32(0x94000000 | (((ziel - self.codeLen) >> 2) & 0x3FFFFFF));
    if rueck == 1 { self.emit32(0x9E670000); }                     // FMOV d0, x0
    if rueck == 2 {
      self.emit32(0x9E670000);                                     // FMOV d0, x0
      self.emit32(0x1E624000);                                     // FCVT s0, d0
    }
    self.emit32(0xA8C17BFD);                   // LDP x29, x30, [sp], #16
    self.emit32(0xD65F03C0);                   // RET
    return start;
  }

  // -------------------------------------------------------------------------
  // IR Module Helpers
  //
  // IRModule memory layout (VMT at +0, then fields):
  //   +8:  instrBuffer  — pointer to instruction array
  //   +16: instrCap
  //   +24: instrLen     — instruction COUNT (not bytes; each instr = 80 bytes)
  //   +80: funcBuffer   — pointer to function record array
  //   +88: funcCap
  //   +96: funcLen      — function COUNT
  //
  // Function record (80 bytes each):
  //   +0:  nameOff
  //   +8:  nameLen
  //   +16: instrsOff    — first instruction index for this function
  //   +24: instrCount   — number of instructions for this function
  //   +32: localCount
  //   +40: paramCount
  //
  // Instruction record (80 bytes each):
  //   +0:  op    +8: dest  +16: src1  +24: src2  +32: src3  +40: imm
  // -------------------------------------------------------------------------

  fn getFuncCount(): int64 {
    return peek64(self.ir + 96);
  }

  fn getFuncLocalCount(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    return peek64(funcBuf + funcId * 80 + 32);
  }

  fn getFuncInstrStart(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    return peek64(funcBuf + funcId * 80 + 16);
  }

  fn getFuncInstrCount(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    return peek64(funcBuf + funcId * 80 + 24);
  }

  fn getInstrField(absIdx: int64, fieldOff: int64): int64 {
    var instrBuf: int64 := peek64(self.ir + 8);
    return peek64(instrBuf + absIdx * 80 + fieldOff);
  }

  fn getInstrOp(absIdx: int64): int64   { return self.getInstrField(absIdx, 0); }
  fn getInstrDest(absIdx: int64): int64  { return self.getInstrField(absIdx, 8); }
  fn getInstrSrc1(absIdx: int64): int64  { return self.getInstrField(absIdx, 16); }
  fn getInstrSrc2(absIdx: int64): int64  { return self.getInstrField(absIdx, 24); }
  fn getInstrImmInt(absIdx: int64): int64 { return self.getInstrField(absIdx, 40); }

  // -------------------------------------------------------------------------
  // WP-13: Inspect(expr) — emit debug output "[Inspect:name] value\n" to stderr
  // Linux: inline SYS_WRITE(2) syscalls + itoa loop
  // Windows: ADR+B inline strings + BL wab_inspect_str(11)/wab_inspect_int(12)
  // -------------------------------------------------------------------------

  fn emitInspectSysWrite(len: int64) {
    self.emitMovImmReg(ARM64_X2, len);
    self.emitMovImmReg(ARM64_X0, 2);
    self.emitMovImmReg(ARM64_X8, SYS_WRITE);
    self.emit32(0xD4000001);
  }

  fn emitInspect(valSlot: int64, instrIdx: int64) {
    var nameOff: int64 := self.getInstrField(instrIdx, 56);
    var strBuf:  int64 := peek64(self.ir + 32);
    var namePtr: int64 := strBuf + nameOff;
    var nameLen: int64 := StrLen(namePtr as pchar);

    if self.winMode != 0 {
      // ---- Windows ARM64 ----
      // Build "[Inspect:name] " prefix (9 + nameLen + 2 = 11+nameLen bytes)
      var prefixLen: int64 := 11 + nameLen;
      var pb: int64 := alloc(prefixLen + 1);
      poke8(pb + 0, 91);   // '['
      poke8(pb + 1, 73);   // 'I'
      poke8(pb + 2, 110);  // 'n'
      poke8(pb + 3, 115);  // 's'
      poke8(pb + 4, 112);  // 'p'
      poke8(pb + 5, 101);  // 'e'
      poke8(pb + 6, 99);   // 'c'
      poke8(pb + 7, 116);  // 't'
      poke8(pb + 8, 58);   // ':'
      var pi: int64 := 0;
      while pi < nameLen { poke8(pb + 9 + pi, peek8(namePtr + pi)); pi := pi + 1; }
      poke8(pb + 9 + nameLen,     93);  // ']'
      poke8(pb + 9 + nameLen + 1, 32);  // ' '
      // Emit: ADR x0, #8; B over prefix; prefix bytes+NUL+pad; MOVZ x1,#prefixLen; BL id=11
      var ptot: int64 := prefixLen + 1;
      var ppad: int64 := (4 - (ptot & 3)) & 3;
      var ppadded: int64 := ptot + ppad;
      self.emit32(0x10000040);  // ADR x0, #8
      self.emit32(0x14000000 | ((4 + ppadded) >> 2));
      var pj: int64 := 0;
      while pj < prefixLen { self.emit8(peek8(pb + pj)); pj := pj + 1; }
      self.emit8(0);
      var pk: int64 := 0;
      while pk < ppad { self.emit8(0); pk := pk + 1; }
      self.emitMovImmReg(ARM64_X1, prefixLen);
      self.addWinPatch(self.codeLen, 11);
      self.emit32(0x94000000);
      // Emit: load value → x0; BL id=12 (wab_inspect_int, prints decimal)
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(valSlot));
      self.addWinPatch(self.codeLen, 12);
      self.emit32(0x94000000);
      // Emit: "\n" → BL id=11 (wab_inspect_str)
      self.emit32(0x10000040);  // ADR x0, #8
      self.emit32(0x14000002);  // B +2 (over 8 bytes: '\n'+NUL+2 pads)
      self.emit8(10); self.emit8(0); self.emit8(0); self.emit8(0);
      self.emitMovImmReg(ARM64_X1, 1);
      self.addWinPatch(self.codeLen, 11);
      self.emit32(0x94000000);
      return;
    }

    // ---- Linux ARM64: inline SYS_WRITE(fd=2) calls ----

    // Write "[Inspect:" (9 bytes) to stderr
    // ADR x1, #8 (string starts 8 bytes after this instruction)
    self.emit32(0x10000041);   // ADR x1, #8
    // B +4 (over 12 bytes: 9 chars + NUL + 2 pads = 12, padded=12, (4+12)/4=4)
    self.emit32(0x14000004);
    self.emit8(91);  self.emit8(73);  self.emit8(110);  // [In
    self.emit8(115); self.emit8(112); self.emit8(101);  // spe
    self.emit8(99);  self.emit8(116); self.emit8(58);   // ct:
    self.emit8(0);   self.emit8(0);   self.emit8(0);    // NUL + 2 pads (align 4)
    self.emitInspectSysWrite(9);

    // Write variable name to stderr
    var ntot:    int64 := nameLen + 1;
    var npad:    int64 := (4 - (ntot & 3)) & 3;
    var npadded: int64 := ntot + npad;
    self.emit32(0x10000041);  // ADR x1, #8
    self.emit32(0x14000000 | ((4 + npadded) >> 2));
    var ni: int64 := 0;
    while ni < nameLen { self.emit8(peek8(namePtr + ni)); ni := ni + 1; }
    self.emit8(0);
    var np: int64 := 0;
    while np < npad { self.emit8(0); np := np + 1; }
    self.emitInspectSysWrite(nameLen);

    // Write "] " (2 bytes) to stderr
    // 2+1=3 bytes → pad=1 → padded=4 → B +2
    self.emit32(0x10000041);  // ADR x1, #8
    self.emit32(0x14000002);  // B +2 (over 8 bytes: '] '+NUL+pad)
    self.emit8(93); self.emit8(32); self.emit8(0); self.emit8(0);  // ] ' ' NUL pad
    self.emitInspectSysWrite(2);

    // Load value from slot → x0
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(valSlot));

    // Inline itoa + write(stderr, digits+'\n', len)
    // Uses 32-byte stack buffer: sp[0..30]=digits(backwards), sp[31]='\n'
    // x9=write_ptr, x10=value, x11=neg_flag, x12=10, x13=quotient, x14=digit
    //
    // Branch layout (instruction indices within this block):
    //   instr  6: CBZ x10, →24 (ZERO_CASE)
    //   instr  8: B.GE →11 (POS_LOOP)
    //   instr 11: [POS_LOOP]
    //   instr 18: CBNZ x10, →11 (-7)
    //   instr 19: CBZ x11, →23 (+4, EMIT_OUT_SKIP)
    //   instr 23: B →27 (+4, EMIT_OUT)
    //   instr 24: [ZERO_CASE]
    //   instr 27: [EMIT_OUT]
    self.emit32(0xD10083FF);  // instr 0: SUB sp,sp,#32
    self.emit32(0x91007BE9);  // instr 1: ADD x9,sp,#30  (x9 → buf[30])
    self.emit32(0x5280014A);  // instr 2: MOVZ w10,#10  ('\n')
    self.emit32(0x39007FEA);  // instr 3: STRB w10,[sp,#31]  (buf[31]='\n')
    self.emit32(0xAA0003EA);  // instr 4: MOV x10,x0  (save value)
    self.emit32(0xD280000B);  // instr 5: MOVZ x11,#0  (neg_flag=0)
    self.emit32(0xB400024A);  // instr 6: CBZ x10,+18 (→ instr 24 ZERO_CASE)
    self.emit32(0xF100015F);  // instr 7: CMP x10,#0  (SUBS xzr,x10,#0)
    self.emit32(0x5400006A);  // instr 8: B.GE +3 (→ instr 11 POS_LOOP)
    self.emit32(0xCB0A03EA);  // instr 9: NEG x10,x10
    self.emit32(0xD280002B);  // instr10: MOVZ x11,#1  (neg_flag=1)
    self.emit32(0xD280014C);  // instr11: MOVZ x12,#10  [POS_LOOP]
    self.emit32(0x9ACC094D);  // instr12: UDIV x13,x10,x12
    self.emit32(0x9B0CA9AE);  // instr13: MSUB x14,x13,x12,x10  (rem=value-q*10)
    self.emit32(0x1100C1CE);  // instr14: ADD w14,w14,#48  ('0'+rem)
    self.emit32(0x3900012E);  // instr15: STRB w14,[x9]
    self.emit32(0xD1000529);  // instr16: SUB x9,x9,#1
    self.emit32(0xAA0D03EA);  // instr17: MOV x10,x13  (value=quotient)
    self.emit32(0xB5FFFF2A);  // instr18: CBNZ x10,-7 (→ instr 11 POS_LOOP)
    self.emit32(0xB400008B);  // instr19: CBZ x11,+4 (→ instr 23)
    self.emit32(0x528005AE);  // instr20: MOVZ w14,#45  ('-')
    self.emit32(0x3900012E);  // instr21: STRB w14,[x9]
    self.emit32(0xD1000529);  // instr22: SUB x9,x9,#1
    self.emit32(0x14000004);  // instr23: B +4 (→ instr 27 EMIT_OUT)
    self.emit32(0x5280060E);  // instr24: MOVZ w14,#48  ('0')  [ZERO_CASE]
    self.emit32(0x3900012E);  // instr25: STRB w14,[x9]
    self.emit32(0xD1000529);  // instr26: SUB x9,x9,#1
    self.emit32(0x91000529);  // instr27: ADD x9,x9,#1  [EMIT_OUT] (first char)
    self.emit32(0x910083EA);  // instr28: ADD x10,sp,#32  (past '\n')
    self.emit32(0xCB090142);  // instr29: SUB x2,x10,x9  (length incl. '\n')
    self.emit32(0xAA0903E1);  // instr30: MOV x1,x9  (start ptr)
    self.emit32(0xD2800040);  // instr31: MOVZ x0,#2  (fd=stderr)
    self.emit32(0xD2800808);  // instr32: MOVZ x8,#64  (SYS_WRITE)
    self.emit32(0xD4000001);  // instr33: SVC #0
    self.emit32(0x910083FF);  // instr34: ADD sp,sp,#32  (restore stack)
  }
};
