// ==================================================================
// WP-BC-33: ARM64/AArch64 Linux Backend
// ==================================================================
// Vollständige ARM64 Code-Generierung aus IR für Linux ELF64:
// - AAPCS64-ABI (SysV AMD64-ähnlich, aber x0-x7 für Args)
// - Stack-basierte Temp-Allokation ([x29, #-8N])
// - Korrekte 32-bit Fixed-Width Instruction-Encodings
// - Label-Backpatching für Branches
// - Linux Syscall-Nummern (write=64, exit=93, mmap=222, munmap=215)
//
// Instruction-Encoding-Referenz:
//   LDUR/STUR  (simm9):  0xF8400000 / 0xF8000000
//   ADD Rd,Rn,Rm:        0x8B000000 | Rm<<16 | Rn<<5 | Rd
//   MOVZ Xd,#imm16:      0xD2800000 | imm16<<5 | Rd
//   STP x29,x30,[sp,-16]!: 0xA9BF7BFD
//   LDP x29,x30,[sp],16:   0xA8C17BFD
//   RET:                 0xD65F03C0

// ============================================================================
// Register Constants (AAPCS64)
// ============================================================================


import src.std.alloc;
import src.emit_write;   // #1968: _irStrLenVorspann
import src.backend.linux_syscalls;   // #2021
pub con ARM64_X0:  int64 := 0;
pub con ARM64_X1:  int64 := 1;
pub con ARM64_X2:  int64 := 2;
pub con ARM64_X3:  int64 := 3;
pub con ARM64_X4:  int64 := 4;
pub con ARM64_X5:  int64 := 5;
pub con ARM64_X6:  int64 := 6;
pub con ARM64_X7:  int64 := 7;
pub con ARM64_X8:  int64 := 8;   // indirect result / syscall number
pub con ARM64_X9:  int64 := 9;   // scratch
pub con ARM64_X10: int64 := 10;  // scratch
pub con ARM64_X11: int64 := 11;  // #1776: scratch
// #1776: x19..x24 sind nach AAPCS64 callee-saved. Der erzeugte Code benutzt
// sonst nur x0..x11. Der Formatierer (a64FloatToStr) benutzt sie und rettet
// sie seit #2149 selbst — vorher verlor ein C-Aufrufer einer Lyx-.so dort
// seine Werte.
pub con ARM64_X19: int64 := 19;
pub con ARM64_X20: int64 := 20;
pub con ARM64_X21: int64 := 21;
pub con ARM64_X22: int64 := 22;
pub con ARM64_X23: int64 := 23;
pub con ARM64_X24: int64 := 24;
pub con ARM64_X28: int64 := 28;   // #2110: argv ab main; #2149: dort gerettet
pub con ARM64_X29: int64 := 29;  // frame pointer (FP)
pub con ARM64_X30: int64 := 30;  // link register (LR)
pub con ARM64_XZR: int64 := 31;  // zero register / SP
pub con ARM64_D0:  int64 := 0;   // FP/SIMD arg/result
pub con ARM64_D1:  int64 := 1;
pub con ARM64_D7:  int64 := 7;

// Linux ARM64 syscall numbers
pub con SYS_WRITE:  int64 := 64;
pub con SYS_READ:   int64 := 63;   // #1769: arm64 zaehlt wie riscv64, nicht wie x86-64 (dort 0/1)
pub con SYS_EXIT:   int64 := 93;
pub con SYS_MMAP:   int64 := 222;
pub con SYS_MUNMAP: int64 := 215;
pub con SYS_OPEN:   int64 := 56;
pub con SYS_CLOSE:  int64 := 57;

// ============================================================================
// Patch record: pending branch to be backpatched
// ============================================================================
// Layout: [codeOff:int64][labelId:int64][instrType:int64]
// instrType 0 = B (26-bit), 1 = CBZ/CBNZ (19-bit + reg)
pub con PATCH_B:    int64 := 0;
pub con PATCH_CBZ:  int64 := 1;
pub con PATCH_CBNZ: int64 := 2;
pub con PATCH_BL:   int64 := 3;
// #1806: Adresse einer Funktion als WERT (fn-Zeiger). ADR laedt PC-relativ,
// Reichweite +/-1 MB — reicht fuer ein Modul; darueber meldet applyPatches
// (#2112: bis dahin behauptete das nur dieser Kommentar).
pub con PATCH_ADR:  int64 := 4;

// ============================================================================
// EmitARM64 Class
// ============================================================================

pub type EmitARM64 = class {
  codeBuf:         int64;
  codeLen:         int64;
  codeCap:         int64;

  ir:              int64;

  stackSize:       int64;
  // #2149: Versatz (zu x29) der Sicherung von x28 in main, 0 = keine.
  x28Sicherung:    int64;

  // label address table: labelId -> byte offset in codeBuf
  labelAddrs:      int64;
  labelCount:      int64;
  labelCap:        int64;   // #2112: Eintraege in labelAddrs, waechst

  // pending branch patches: {codeOff, labelId, type, reg}
  patchBuf:        int64;
  patchCount:      int64;
  patchCap:        int64;   // #2112: Kapazitaet in Eintraegen, waechst

  // function table: funcId -> start offset (for BL patching)
  funcAddrs:       int64;
  funcCount:       int64;
  funcCap:         int64;   // #2112: Eintraege in funcAddrs/funcPrologueLen

  // WP-AND-03: per-function prologue length in bytes. The DWARF CFI generator
  // uses this to advance_loc over the prologue before declaring CFA = fp+16.
  funcPrologueLen: int64;

  // WP-AND-02 Phase C: shared-library mode toggle and dynamic-relocation buffer.
  // When isSharedLib != 0, emitLoadGlobal / emitStoreGlobal use PC-relative
  // literal-pool loads instead of MOVZ/MOVK chains, and each pool slot is
  // recorded as an R_AARCH64_RELATIVE entry for runtime fix-up by the loader.
  // relocBuf holds Elf64_Rela records (24 bytes each).
  isSharedLib:     int64;
  relocBuf:        int64;
  relocCount:      int64;
  relocCap:        int64;

  // WP-AND-upstream-fix v5: separate tracking for IRO_LOAD_GLOBAL slots.
  // Records are 16 bytes: {slotCodeOff:i64, globalIdx:i64}. writeELFSharedLib
  // patches each slot to the global's .data address and emits the matching
  // R_AARCH64_RELATIVE entry. Kept apart from relocBuf so global slots
  // don't collide with non-global PIC relocations.
  globalRelocBuf:    int64;
  globalRelocCount:  int64;
  globalRelocCap:    int64;

  // FFI (extern fn ... link). Per distinct extern symbol referenced by a call
  // we emit an inline GOT slot resolved by the loader via R_AARCH64_GLOB_DAT.
  // externBuf dedups the symbols — 32-byte entries {nameStrOff, nameLen,
  // libStrOff, libLen}, all offsets into the IR string table — so writeELF can
  // build .dynsym/.dynstr/DT_NEEDED. The dynsym index of entry i is i+1
  // (index 0 is the reserved null symbol).
  externBuf:   int64;
  externCount: int64;
  externCap:   int64;

  // #2117: Aufrufstellen externer Funktionen in einer .so — 16-Byte-Saetze
  // {instrOff, externIdx}. Statt des GOT-Platzes MITTEN IM CODE (eine
  // Text-Relocation: bionic lehnt sie ab API 23 ab, und ohne DT_TEXTREL
  // schreibt der Lader in ein R-X-Segment) steht hier ADRP+LDR auf einen
  // GOT-Platz im RW-Segment; writeELFSharedLib traegt die Distanz nach.
  gotCallBuf:   int64;
  gotCallCount: int64;
  gotCallCap:   int64;

  // WP-D2: Windows target mode — replaces Linux syscalls with BL placeholders
  // that WinARM64Backend resolves to Windows API helper stubs after emit().
  // winPatchBuf holds 16-byte records: {codeOffset:i64, helperId:i64}.
  // Helper IDs: 1=PrintStr, 2=PrintInt, 3=Exit, 4=Alloc, 5=Free.
  winMode:       int64;
  winPatchBuf:   int64;
  winPatchCount: int64;
  winPatchCap:   int64;


  // -------------------------------------------------------------------------
  // Init
  // -------------------------------------------------------------------------

  fn init(irMod: int64) {
    self.ir          := irMod;
    self.codeBuf     := alloc(131072);
    self.codeCap     := 131072;
    self.codeLen     := 0;
    self.stackSize   := 0;
    // #2112: Alle drei Tabellen waren fest (1024 Marken, 1024 Patches, 256
    // Funktionen) und schnitten still ab: ein Patch jenseits der Grenze fiel
    // weg und sein Sprung blieb auf dem Platzhalter stehen (BL +0 — das
    // Programm rief sich endlos selbst), eine Funktion jenseits von 256 bekam
    // keine Adresse. riscv hatte die Patchliste schon in #1740 wachsen lassen.
    self.labelCap    := 1024;
    self.labelAddrs  := alloc(self.labelCap * 8);
    self.labelCount  := 0;
    self.patchCap    := 1024;
    self.patchBuf    := alloc(self.patchCap * 32);
    self.patchCount  := 0;
    self.funcCap     := self.getFuncCount() + 1;
    if self.funcCap < 256 { self.funcCap := 256; }
    self.funcAddrs   := alloc(self.funcCap * 8);
    self.funcCount   := 0;
    // WP-AND-03: parallel to funcAddrs.
    self.funcPrologueLen := alloc(self.funcCap * 8);

    // WP-AND-02 Phase C: dynamic-reloc state. Buffer grows on demand.
    self.isSharedLib := 0;
    self.relocCap    := 32;
    self.relocBuf    := alloc(self.relocCap * 24);
    self.relocCount  := 0;

    // WP-AND-upstream-fix v5: global-load slot tracking (16 bytes/entry).
    self.globalRelocCap   := 32;
    self.globalRelocBuf   := alloc(self.globalRelocCap * 16);
    self.globalRelocCount := 0;
    self.gotCallCap   := 16;                    // #2117
    self.gotCallBuf   := alloc(self.gotCallCap * 16);
    self.gotCallCount := 0;

    self.externCap   := 64;
    self.externBuf   := alloc(self.externCap * 32);
    self.externCount := 0;

    // WP-D2: Windows mode — off by default
    self.winMode       := 0;
    self.winPatchCap   := 64;
    self.winPatchBuf   := alloc(self.winPatchCap * 16);
    self.winPatchCount := 0;
  }

  fn getGlobalRelocBuf(): int64   { return self.globalRelocBuf; }
  fn getGlobalRelocCount(): int64 { return self.globalRelocCount; }
  fn getExternBuf(): int64        { return self.externBuf; }
  fn getExternCount(): int64      { return self.externCount; }

  fn getFuncPrologueLen(): int64 { return self.funcPrologueLen; }

  // WP-D2: Windows mode helpers
  pub fn setWinMode(m: int64) { self.winMode := m; }
  pub fn getWinPatchBuf(): int64 { return self.winPatchBuf; }
  pub fn getWinPatchCount(): int64 { return self.winPatchCount; }

  fn addWinPatch(codeOff: int64, helperId: int64) {
    if self.winPatchCount >= self.winPatchCap {
      var nc: int64 := self.winPatchCap * 2;
      var nb: int64 := alloc(nc * 16);
      var i: int64 := 0;
      while i < self.winPatchCount * 16 {
        poke8(nb + i, peek8(self.winPatchBuf + i));
        i := i + 1;
      }
      self.winPatchBuf := nb;
      self.winPatchCap := nc;
    }
    poke64(self.winPatchBuf + self.winPatchCount * 16,     codeOff);
    poke64(self.winPatchBuf + self.winPatchCount * 16 + 8, helperId);
    self.winPatchCount := self.winPatchCount + 1;
  }

  // WP-AND-02 Phase C: opt into PIC code emission. Caller flips this BEFORE
  // calling emit(); takes effect for emitLoadGlobal / emitStoreGlobal.
  pub fn setSharedLib(flag: int64) {
    self.isSharedLib := flag;
  }

  fn getRelocBuf(): int64   { return self.relocBuf; }
  fn getGotCallBuf(): int64   { return self.gotCallBuf; }     // #2117
  fn getGotCallCount(): int64 { return self.gotCallCount; }   // #2117
  fn getRelocCount(): int64 { return self.relocCount; }

  // WP-AND-02 Phase C: append an Elf64_Rela record. r_info packs (sym_idx<<32)|type.
  // For R_AARCH64_RELATIVE (1027) the symbol index is 0 and addend = base-relative
  // address that the loader writes back into *(load_base + r_offset).
  fn _recordRelocation(offset: int64, info: int64, addend: int64) {
    if (self.relocCount >= self.relocCap) {
      var newCap: int64 := self.relocCap * 2;
      var nb: int64 := alloc(newCap * 24);
      var i: int64 := 0;
      while i < self.relocCount * 24 {
        poke8(nb + i, peek8(self.relocBuf + i));
        i := i + 1;
      }
      self.relocBuf := nb;
      self.relocCap := newCap;
    }
    var off: int64 := self.relocBuf + self.relocCount * 24;
    poke64(off +  0, offset);
    poke64(off +  8, info);
    poke64(off + 16, addend);
    self.relocCount := self.relocCount + 1;
  }

  // -------------------------------------------------------------------------
  // Top-level emit
  // -------------------------------------------------------------------------

  fn emit(): int64 {
    var n: int64 := self.getFuncCount();
    var i: int64 := 0;
    while i < n {
      self.emitFunc(i);
      i := i + 1;
    }
    // WP-AND-upstream-fix v9: final patch pass for forward references.
    // funcAddrs is now fully populated, so any BL patch that was skipped
    // earlier (callee not yet emitted) resolves here.
    self.applyPatches();
    // #2112: Was jetzt noch offen ist, bleibt fuer immer auf dem Platzhalter
    // stehen — laut scheitern statt einen Sprung auf sich selbst auszuliefern.
    self._checkNoOpenPatches(0);
    return self.codeLen;
  }

  fn emitFunc(funcId: int64) {
    // Record start address
    if funcId >= self.funcCap {
      EPrintStr("error: arm64: Funktion "c); EPrintInt(funcId);
      EPrintStrLn(" liegt jenseits der Funktionstabelle (#2112)."c);
      exit(1);
    }
    poke64(self.funcAddrs + funcId * 8, self.codeLen);
    self.funcCount := self.funcCount + 1;

    self.stackSize   := 0;
    self.labelCount  := 0;
    // WP-AND-upstream-fix v9: do NOT reset patchCount here. Inter-function
    // BL patches must survive across emitFunc calls so forward references
    // (caller emitted before callee) can be resolved by the final
    // applyPatches pass in emit() once every funcAddrs entry is known.
    // applyPatches marks already-resolved entries by setting labelId = -2.

    // Zero out label table
    var li: int64 := 0;
    while li < self.labelCap {
      poke64(self.labelAddrs + li * 8, -1);
      li := li + 1;
    }

    self.calcStackFrame(funcId);
    var prologueStart: int64 := self.codeLen;
    self.emitPrologue();
    // #2110: argv fuer GetArgC/GetArgV sichern. Beide Startruempfe (statisch
    // und ueber __libc_start_main) uebergeben argv in x1 an main; x28 ist
    // callee-saved, der erzeugte Code benutzt es nie (s. emitPrologue), und
    // C-Code erhaelt es nach AAPCS64. Am Startrumpf selbst ginge es nicht:
    // glibc ruft main mit eigenen Werten in x19..x28.
    if self.isMainFunc(funcId) != 0 {
      self.emitStur(ARM64_X28, ARM64_X29, self.x28Sicherung);      // #2149: x28 retten
      self.emit32(0xAA0103FC);                                     // MOV x28, x1
    }
    // WP-AND-upstream-fix v7: spill incoming register args (x0..x7 per
    // AAPCS64) into stack slots 0..paramCount-1 so subsequent
    // IRO_LOAD_LOCAL of a parameter actually reads its value. Without
    // this every NK_IDENT lookup that hit the params chain returned
    // whatever was at fp - (i+1)*8, i.e. uninitialised stack.
    var pSpillCount: int64 := peek64(peek64(self.ir + 80) + funcId * 80 + 40);
    var pSpillI: int64 := 0;
    while pSpillI < pSpillCount {
      if pSpillI < 8 {
        // #1388: Die Parameter liegen hinter dem Kratzstreifen, nicht ab Slot 0.
        self.emitStur(pSpillI, ARM64_X29, self.slotOff(IR_BARG_SLOTS + pSpillI));
      } else {
        // #2132: Parameter ab dem neunten liegen nach AAPCS64 beim Aufrufer
        // auf dem Stapel, in 8-Byte-Plaetzen ab dessen sp — hier [x29+16],
        // ueber dem geretteten x29/x30. Bis 1.2.15A blieben diese Slots
        // unbeschrieben, der Parameter las fremden Stapel.
        var pStOff: int64 := 16 + (pSpillI - 8) * 8;
        if pStOff > 32760 {
          EPrintStr("error: arm64: Parameter "c); EPrintInt(pSpillI + 1);
          EPrintStrLn(" liegt jenseits der Reichweite von LDR [x29, #imm] (#2132)."c);
          exit(1);
        }
        self.emit32(0xF9400000 | ((pStOff / 8) << 10) | (ARM64_X29 << 5) | ARM64_X9);   // LDR x9, [x29, #off]
        self.emitStur(ARM64_X9, ARM64_X29, self.slotOff(IR_BARG_SLOTS + pSpillI));
      }
      pSpillI := pSpillI + 1;
    }
    // WP-AND-03: stash prologue length for DWARF CFI advance_loc.
    poke64(self.funcPrologueLen + funcId * 8, self.codeLen - prologueStart);

    var instrStart: int64 := self.getFuncInstrStart(funcId);
    var instrCount: int64 := self.getFuncInstrCount(funcId);
    var i: int64 := 0;
    while i < instrCount {
      self.emitInstr(funcId, instrStart + i);
      i := i + 1;
    }

    self.emitEpilogue();
    self.applyPatches();
    // #2112: Marken gelten nur innerhalb der Funktion — ein hier offener
    // Sprung wuerde sonst von der gleichnamigen Marke der NAECHSTEN Funktion
    // aufgeloest.
    self._checkNoOpenPatches(1);
  }

  // -------------------------------------------------------------------------
  // Stack frame
  // -------------------------------------------------------------------------

  fn calcStackFrame(funcId: int64) {
    var locals: int64 := self.getFuncLocalCount(funcId);
    // Each local: 8 bytes; round up to 16-byte alignment
    var sz: int64 := locals * 8;
    if (sz & 15) != 0 {
      sz := (sz + 16) & -16;
    }
    // #2149: main haelt argv in x28 (#2110) — x28 ist nach AAPCS64
    // callee-saved, der Aufrufer von main darf es zurueck erwarten. Bis
    // 1.2.16E wurde es ueberschrieben, ohne es zu retten (dieselbe Klasse wie
    // s11 auf riscv, #2140). Die Sicherung liegt am UNTEREN Ende des Rahmens,
    // unterhalb aller Slots; Aufrufe mit Stapelargumenten verschieben sp
    // vorher und lassen sie unberuehrt.
    self.x28Sicherung := 0;
    if self.isMainFunc(funcId) != 0 {
      sz := sz + 16;
      self.x28Sicherung := 0 - sz;
    }
    self.stackSize := sz;
  }

  // local slot offset from x29: slot 0 → -8, slot 1 → -16, ...
  fn slotOff(slot: int64): int64 {
    return -(slot + 1) * 8;
  }

  // -------------------------------------------------------------------------
  // Prologue / Epilogue
  //
  // WP-AND-03 Bionic-ABI audit:
  //  - 16-byte SP alignment is preserved across the prologue: STP pre-decrements
  //    SP by 16, calcStackFrame rounds stackSize up to 16; SP stays 16-aligned
  //    through the function body. ARM64 ABI requirement: met.
  //  - This emitter only uses x0..x10, x29, x30. Android-reserved x18 (Bionic
  //    TLS / shadow call stack) is never touched.
  //  - No MRS/MSR system-register access; TPIDR_EL0 and other system regs are
  //    untouched.
  //  - Callee-saved regs (x19..x28): x19..x24 benutzt nur der Formatierer und
  //    rettet sie selbst (#2149). x28 traegt ab dem Eingang von main argv
  //    (#2110); main rettet es im Rahmen und setzt es im Epilog zurueck (#2149).
  //  - DWARF CFI for stack unwinding is emitted by writeELFSharedLib via the
  //    .eh_frame section using funcAddrs + funcPrologueLen records.
  // -------------------------------------------------------------------------

  // #2110: heisst die Funktion "main"? Dieselbe Pruefung wie isMainFunc in
  // riscv_linux.lyx (#1740).
  fn isMainFunc(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    var rec:     int64 := funcBuf + funcId * IR_FUNC_SIZE;
    if peek64(rec + IR_FUNC_OFF_NAMELEN) != 4 { return 0; }
    var p: int64 := peek64(self.ir + 32) + peek64(rec + 0);
    if peek8(p) != 109 || peek8(p + 1) != 97 || peek8(p + 2) != 105 || peek8(p + 3) != 110 { return 0; }
    return 1;
  }

  fn emitPrologue() {
    // STP x29, x30, [sp, #-16]!
    self.emit32(0xA9BF7BFD);
    // MOV x29, sp  (= ADD x29, sp, #0)
    self.emit32(0x910003FD);
    // SUB sp, sp, #stackSize
    if self.stackSize > 0 {
      if self.stackSize <= 4095 {
        self.emit32(0xD10003FF | (self.stackSize << 10));
      } else {
        // #2062: grosser Rahmen in zwei Schritten — erst die oberen zwoelf Bit
        // (SUB mit LSL #12), dann der Rest. Reicht bis 16 MB.
        //
        // Hier stand `MOVZ x9, #sz; SUB sp, sp, x9` mit dem Befehlswort
        // 0xCB09C3FF. Das ist die Form mit GESCHOBENEM Register, und in der
        // heisst Register 31 nicht SP, sondern XZR: der Befehl schrieb ins
        // Nullregister und legte keinen Rahmen an. Aufgefallen ist es nie,
        // weil _emitFarAddr jede Funktion mit so grossem Rahmen vorher
        // abwies — mit dem Wegfall jener Grenze waere es der naechste stille
        // Fehler gewesen. In der Direktwert-Form unten ist 31 der
        // Stapelzeiger.
        if self.stackSize > 0xFFFFFF {
          EPrintStr("error: arm64: Rahmen von "c);
          EPrintInt(self.stackSize);
          EPrintStrLn(" Byte ueberschreitet 16 MB (#2062)."c);
          exit(1);
        }
        var rhHoch: int64 := (self.stackSize >> 12) & 0xFFF;
        var rhTief: int64 := self.stackSize & 0xFFF;
        self.emit32(0xD14003FF | (rhHoch << 10));                  // SUB sp, sp, #hoch, LSL #12
        if rhTief != 0 { self.emit32(0xD10003FF | (rhTief << 10)); }  // SUB sp, sp, #tief
      }
    }
  }

  fn emitEpilogue() {
    // #2149: x28 in main zuruecksetzen (gerettet im Prolog).
    if self.x28Sicherung != 0 { self.emitLdur(ARM64_X28, ARM64_X29, self.x28Sicherung); }
    // MOV sp, x29  (= ADD sp, x29, #0)  — 0x91000000|(29<<5)|31 = 0x910003BF
    self.emit32(0x910003BF);
    // LDP x29, x30, [sp], #16
    self.emit32(0xA8C17BFD);
    // RET
    self.emit32(0xD65F03C0);
  }

  // -------------------------------------------------------------------------
  // Instruction dispatch
  // -------------------------------------------------------------------------

    // #1339: Der Dispatcher unten ist eine flache Liste aus `if op == X`
  // ohne else und ohne Default. Ein Opcode, den keine Zeile trifft, erzeugte
  // damit GAR NICHTS und verschwand lautlos aus dem Programm — bei
  // IRO_PANIC hiess das: nach einer erkannten Verletzung laeuft es weiter.
  //
  // Diese Liste nennt die Opcodes, die arm64 tatsaechlich behandelt. Sie ist
  // aus dem Dispatcher erhoben und wird gegen ihn geprueft. Weicht sie ab,
  // scheitert der Lauf LAUT — die Abweichung faellt damit beim Uebersetzen
  // auf und nicht erst im erzeugten Programm.
  fn a64_opBehandelt(op: int64): int64 {
    // #1339: die vier Zusicherungen — ir_lower erzeugt sie (ASSERT_NOT_ZERO
    // steht vor jeder Division), und bis 1.0.18B behandelte sie ausser lyxos
    // kein Backend.
    if (op == IRO_ASSERT_NOT_NULL || op == IRO_ASSERT_NOT_ZERO) { return 1; }
    if (op == IRO_ASSERT_TRUE || op == IRO_ASSERT_BOUNDS) { return 1; }
    if (op == 167 || op == IRO_ADD || op == IRO_ALLOC || op == IRO_AND) { return 1; }
    if (op == IRO_BR_FALSE || op == IRO_BR_TRUE || op == IRO_CALL || op == IRO_CALL_BUILTIN) { return 1; }
    if (op == IRO_CALL_EXTERN || op == IRO_CALL_INDIRECT || op == IRO_CMP_EQ || op == IRO_CMP_GE) { return 1; }
    if (op == IRO_FUNC_ADDR) { return 1; }   // #1806
    if (op == IRO_LOAD_LOCAL_ADDR || op == IRO_LOAD_GLOBAL_ADDR) { return 1; }   // #2116
    if (op == IRO_CMP_GT || op == IRO_CMP_LE || op == IRO_CMP_LT || op == IRO_CMP_NEQ) { return 1; }
    if (op == IRO_CONST_FLOAT || op == IRO_CONST_INT || op == IRO_CONST_STR || op == IRO_DIV) { return 1; }
    if (op == IRO_FADD || op == IRO_FDIV || op == IRO_FMUL || op == IRO_FNEG) { return 1; }
    // #1339: die FCMP-Familie — ohne sie gibt es keine Gleitkomma-Verzweigung.
    if (op == IRO_FCMP_EQ || op == IRO_FCMP_NEQ || op == IRO_FCMP_LT) { return 1; }
    if (op == IRO_FCMP_LE || op == IRO_FCMP_GT || op == IRO_FCMP_GE) { return 1; }
    if (op == IRO_FREE || op == IRO_FSQRT || op == IRO_FSUB || op == IRO_FTOI) { return 1; }
    if (op == IRO_FUNC_EXIT || op == IRO_INSPECT || op == IRO_ITOF || op == IRO_ITOP) { return 1; }
    if (op == IRO_JMP || op == IRO_LABEL || op == IRO_LOAD_FIELD || op == IRO_LOAD_GLOBAL) { return 1; }
    if (op == IRO_LOAD_IDX || op == IRO_LOAD_LOCAL || op == IRO_MOD || op == IRO_MUL) { return 1; }
    if (op == IRO_NEG || op == IRO_OR || op == IRO_PANIC || op == IRO_SHL) { return 1; }
    // #1769: NOT und die BIT-Familie fehlten. std/io rechnet damit, also
    // scheiterte `PrintLn` auf arm64 an IRO_NOT (Opcode 50), bevor es
    // ueberhaupt zur Ausgabe kam. IRO_AND/OR/XOR waren da, ihre BIT-Zwillinge
    // nicht — ir_lower erzeugt beide Formen.
    if (op == IRO_NOT || op == IRO_BITNOT || op == IRO_BITAND) { return 1; }
    if (op == IRO_BITOR || op == IRO_BITXOR) { return 1; }
    // #1769: Breitenwechsel. riscv behandelt sie als reine Kopie — die Slots
    // sind ohnehin 64 Bit breit —, arm64 kannte sie gar nicht.
    if (op == IRO_CAST || op == IRO_SEXT || op == IRO_ZEXT || op == IRO_TRUNC) { return 1; }
    if (op == IRO_SHR || op == IRO_SIMD_ADD || op == IRO_SIMD_DIV || op == IRO_SIMD_MUL) { return 1; }
    if (op == IRO_SIMD_SUB || op == IRO_STORE_FIELD || op == IRO_STORE_GLOBAL || op == IRO_STORE_IDX) { return 1; }
    if (op == IRO_STORE_LOCAL || op == IRO_SUB || op == IRO_THROW || op == IRO_XOR) { return 1; }
    return 0;
  }

  fn emitInstr(funcId: int64, idx: int64) {
    var opRoh: int64 := self.getInstrOp(idx);
    if (self.a64_opBehandelt(opRoh) == 0) {
      EPrintStr("error: arm64-Backend kennt Opcode "c);
      EPrintInt(opRoh);
      EPrintStrLn(" nicht — er wuerde stillschweigend verschwinden (#1339)."c);
      EPrintStrLn("  Entweder den Opcode hier umsetzen oder ihn in ir_lower fuer dieses Ziel abweisen."c);
      exit(1);
    }

    var op:   int64 := self.getInstrOp(idx);
    var dest: int64 := self.getInstrDest(idx);
    var src1: int64 := self.getInstrSrc1(idx);
    var src2: int64 := self.getInstrSrc2(idx);
    var imm:  int64 := self.getInstrImmInt(idx);

    // --- Constants ---
    if op == IRO_CONST_INT {
      self.emitMovImmReg(ARM64_X0, imm);
      self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
    }

    if op == IRO_CONST_FLOAT {
      // Store f64 bit pattern via FMOV d0, x0
      self.emitMovImmReg(ARM64_X0, imm);
      self.emit32(0x9E670000);  // FMOV d0, x0
      self.emitFStur(ARM64_D0, ARM64_X29, self.slotOff(dest));
    }

    // --- Integer arithmetic ---
    if op == IRO_ADD { self.emitBinopRR(0x8B000000, src1, src2, dest); }
    if op == IRO_SUB { self.emitBinopRR(0xCB000000, src1, src2, dest); }
    if op == IRO_MUL { self.emitMul(src1, src2, dest); }
    if op == IRO_DIV { self.emitSdiv(src1, src2, dest); }
    if op == IRO_MOD { self.emitMod(src1, src2, dest); }
    if op == IRO_NEG { self.emitNeg(src1, dest); }

    // --- Bitwise ---
    if op == IRO_AND || op == IRO_BITAND { self.emitBinopRR(0x8A000000, src1, src2, dest); }
    if op == IRO_OR  || op == IRO_BITOR  { self.emitBinopRR(0xAA000000, src1, src2, dest); }
    if op == IRO_XOR || op == IRO_BITXOR { self.emitBinopRR(0xCA000000, src1, src2, dest); }
    // #1769: MVN x0, x0 (= ORN x0, xzr, x0). Dieselbe Lesart wie im
    // riscv-Backend, das NOT und BITNOT beide als bitweises Komplement
    // ausfuehrt.
    if op == IRO_NOT || op == IRO_BITNOT {
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
      self.emit32(0xAA2003E0);
      self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
    }
    // #1769: Breitenwechsel — die Slots sind 64 Bit, also genuegt die Kopie.
    if op == IRO_CAST || op == IRO_SEXT || op == IRO_ZEXT || op == IRO_TRUNC {
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
      self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
    }
    if op == IRO_SHL { self.emitShift(0, src1, src2, dest); }
    if op == IRO_SHR { self.emitShift(1, src1, src2, dest); }

    // --- Float arithmetic ---
    if op == IRO_FADD { self.emitFBinop(0x1E602800, src1, src2, dest); }
    if op == IRO_FSUB { self.emitFBinop(0x1E603800, src1, src2, dest); }
    if op == IRO_FMUL { self.emitFBinop(0x1E600800, src1, src2, dest); }
    if op == IRO_FDIV { self.emitFBinop(0x1E601800, src1, src2, dest); }
    if op == IRO_FNEG { self.emitFNeg(src1, dest); }
    if op == IRO_FSQRT { self.emitFSqrt(src1, dest); }

    // --- Comparisons ---
    if op == IRO_FCMP_EQ  { self.emitFCmp(0, src1, src2, dest); }   // #1339
    if op == IRO_FCMP_NEQ { self.emitFCmp(1, src1, src2, dest); }
    if op == IRO_FCMP_LT  { self.emitFCmp(2, src1, src2, dest); }
    if op == IRO_FCMP_LE  { self.emitFCmp(3, src1, src2, dest); }
    if op == IRO_FCMP_GT  { self.emitFCmp(4, src1, src2, dest); }
    if op == IRO_FCMP_GE  { self.emitFCmp(5, src1, src2, dest); }
    if op == IRO_CMP_EQ  { self.emitCmp(0, src1, src2, dest); }
    if op == IRO_CMP_NEQ { self.emitCmp(1, src1, src2, dest); }
    if op == IRO_CMP_LT  { self.emitCmp(2, src1, src2, dest); }
    if op == IRO_CMP_LE  { self.emitCmp(3, src1, src2, dest); }
    if op == IRO_CMP_GT  { self.emitCmp(4, src1, src2, dest); }
    if op == IRO_CMP_GE  { self.emitCmp(5, src1, src2, dest); }

    // --- Memory ---
    if op == IRO_LOAD_LOCAL  { self.emitLoadLocal(src1, dest); }
    if op == IRO_STORE_LOCAL { self.emitStoreLocal(src1, dest); }
    if op == IRO_LOAD_GLOBAL  { self.emitLoadGlobal(src1, dest); }
    if op == IRO_LOAD_LOCAL_ADDR  { self.emitLoadLocalAddr(src1, dest); }    // #2116: @x
    if op == IRO_LOAD_GLOBAL_ADDR { self.emitLoadGlobalAddr(src1, dest); }   // #2116: @g
    if op == IRO_STORE_GLOBAL { self.emitStoreGlobal(src1, dest); }

    // --- Pointer / struct ---
    if op == IRO_LOAD_FIELD  { self.emitLoadFieldArt(src1, src2, dest, imm); }
    if op == IRO_STORE_FIELD { self.emitStoreFieldArt(src1, src2, dest, imm); }
    if op == IRO_LOAD_IDX    { self.emitLoadIdx(src1, src2, dest); }
    if op == IRO_STORE_IDX   { self.emitStoreIdx(src1, src2, dest); }

    // --- Calls ---
    if op == IRO_CALL         { self.emitCall(src1, src2, imm, dest); }
    if op == IRO_CALL_BUILTIN { self.emitBuiltinCall(imm, src1, dest); }
    if op == IRO_CALL_INDIRECT { self.emitCallIndirect(src1, src2, imm, dest); }   // #2132: src2 = argBase
    if op == IRO_FUNC_ADDR { self.emitFuncAddr(src1, dest); }
    if op == IRO_CALL_EXTERN  { self.emitCallExtern(src1, src2, imm, dest, self.getInstrField(idx, IR_INSTR_OFF_SRC3), self.getInstrField(idx, IR_INSTR_OFF_IMMFLOAT)); }   // #2132: src3 = argBase; #2140: immFloat = Signatur
    if op == IRO_CONST_STR    { self.emitConstStr(imm, dest); }

    // --- Control flow ---
    if op == IRO_JMP      { self.emitBranch(imm); }
    if op == IRO_BR_TRUE  { self.emitBranchCond(src1, imm, 1); }
    if op == IRO_BR_FALSE { self.emitBranchCond(src1, imm, 0); }
    if op == IRO_LABEL    { self.emitLabelDef(imm); }
    if op == IRO_FUNC_EXIT { self.emitEpilogue(); }

    // --- Alloc ---
    if op == IRO_ALLOC { self.emitAlloc(src1, dest); }
    if op == IRO_FREE  { self.emitFree(src1, src2, dest); }

    // --- Type conversions ---
    if op == IRO_ITOF { self.emitItof(src1, dest); }
    if op == IRO_FTOI { self.emitFtoi(src1, dest); }
    if op == IRO_ITOP { self.emitLoadSlot(src1, dest); }

    // --- SIMD (NEON) ---
    if op == IRO_SIMD_ADD { self.emitNeon(0x4E608400, src1, src2, dest); }
    if op == IRO_SIMD_SUB { self.emitNeon(0x4EE08400, src1, src2, dest); }
    if op == IRO_SIMD_MUL { self.emitNeon(0x6E609C00, src1, src2, dest); }
    if op == IRO_SIMD_DIV { self.emitNeon(0x6E60FC00, src1, src2, dest); }

    // --- Debug ---
    if op == IRO_INSPECT { self.emitInspect(src1, idx); }

    // #1281: IRO_THROW → exit(1). Fangen kann ihn hier niemand, denn ir_lower
    // weist try/catch fuer dieses Ziel ab; ein unbehandelter throw beendet das
    // Programm mit 1, wie im x86-Pfad ohne installierten Handler. Bis 1.0.16G
    // erzeugte `throw` fuer dieses Backend gar nichts und war ein No-op.
    if op == IRO_THROW {
      self.emitMovImmReg(ARM64_X0, 1);
      self.emitMovImmReg(ARM64_X8, SYS_EXIT);
      self.emit32(0xD4000001);  // SVC #0
    }

    // --- WSP-05: Inline-Assembly (imm = arch-Mnemonic-Id aus ir_lower ARM64-Tabelle) ---
    // #1339: Die Zusicherungen. ir_lower setzt ASSERT_NOT_ZERO vor jede
    // Division, damit eine Null zu einem kontrollierten Abbruch fuehrt statt
    // zu SIGFPE — bis 1.0.18B behandelte sie ausser lyxos kein Backend, der
    // Opcode verschwand, und die Division lief ungeprueft.
    //
    // CBNZ springt ueber die drei Abbruchbefehle (3 * 4 Byte = 12 → imm19 = 4).
    if op == IRO_ASSERT_NOT_NULL || op == IRO_ASSERT_NOT_ZERO || op == IRO_ASSERT_TRUE {
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
      self.emit32(0xB5000080);                 // CBNZ x0, +16
      self.emitMovImmReg(ARM64_X0, 1);
      self.emitMovImmReg(ARM64_X8, SYS_EXIT);
      self.emit32(0xD4000001);                 // SVC #0
    }

    // ASSERT_BOUNDS: src1 = Index, src2 = Laenge. Vorzeichenlos verglichen
    // (B.LO), damit ein negativer Index als sehr grosse Zahl auffaellt.
    if op == IRO_ASSERT_BOUNDS {
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
      self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(src2));
      self.emit32(0xEB01001F);                 // CMP x0, x1
      self.emit32(0x54000083);                 // B.LO +16 (Index < Laenge)
      self.emitMovImmReg(ARM64_X0, 1);
      self.emitMovImmReg(ARM64_X8, SYS_EXIT);
      self.emit32(0xD4000001);                 // SVC #0
    }

    // #1339: IRO_PANIC (121) fehlte — `panic("...")` war ein No-op, das Programm
    // lief nach der erkannten Verletzung weiter. Verhalten wie IRO_THROW.
    //
    // #2141: Die MELDUNG fehlte — `panic("kaputt")` endete mit rc 1 und
    // stumm. Jetzt wie cg_emitPanicBody auf x86 (die beiden muessen
    // uebereinstimmen): src1 ist der Zeiger auf den Text, er geht bis zum
    // Nullbyte und OHNE angehaengtes Zeilenende nach stderr. Ein Nullzeiger
    // (ir_lower erzeugt ihn fuer Abbrueche ohne Text) schreibt nichts — wie
    // die Nullpruefung in _lyx_strlen.
    if op == IRO_PANIC && src1 >= 0 && self.winMode == 0 {
      self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(src1));   // x1 = Text
      self.emit32(0xB4000121);  // CBZ x1, +9 Befehle (→ Abbruch, ohne Ausgabe)
      self.emit32(0xD2800002);  // MOVZ x2, #0            (Laenge)
      self.emit32(0x38626823);  // [LOOP] LDRB w3,[x1,x2]
      self.emit32(0x34000063);  // CBZ w3, +3  (→ WRITE)
      self.emit32(0x91000442);  // ADD x2,x2,#1
      self.emit32(0x17FFFFFD);  // B -3        (→ LOOP)
      self.emit32(0xD2800040);  // [WRITE] MOVZ x0,#2      (fd=stderr)
      self.emit32(0xD2800808);  // MOVZ x8,#64             (SYS_write)
      self.emit32(0xD4000001);  // SVC #0
    }
    if op == IRO_PANIC {
      self.emitMovImmReg(ARM64_X0, 1);
      self.emitMovImmReg(ARM64_X8, SYS_EXIT);
      self.emit32(0xD4000001);  // SVC #0
    }

    if op == 167 {
      if      imm == 0  { self.emit32(0xD503201F); }  // nop
      else if imm == 1  { self.emit32(0xD503207F); }  // wfi
      else if imm == 2  { self.emit32(0xD503205F); }  // wfe
      else if imm == 3  { self.emit32(0xD503209F); }  // sev
      else if imm == 4  { self.emit32(0xD50320BF); }  // sevl
      else if imm == 5  { self.emit32(0xD503203F); }  // yield
      else if imm == 6  { self.emit32(0xD5033FDF); }  // isb (sy)
      else if imm == 7  { self.emit32(0xD5033F9F); }  // dsb sy
      else if imm == 8  { self.emit32(0xD5033FBF); }  // dmb sy
      else if imm == 9  { self.emit32(0xD4000001); }  // svc #0
      else if imm == 10 { self.emit32(0xD4200000); }  // brk #0
      else if imm == 11 { self.emit32(0xD4400000); }  // hlt #0
      else if imm == 12 { self.emit32(0xD65F03C0); }  // ret
      else if imm == 13 { self.emit32(0xD69F03E0); }  // eret
      else              { self.emit32(0xD4200000); }  // fail-closed: brk #0 (unerreichbar, ir_lower validiert)
    }
  }

  // -------------------------------------------------------------------------
  // Integer arithmetic helpers
  // -------------------------------------------------------------------------

  // Generic 3-reg: opc | (Rm<<16) | (Rn<<5) | Rd  using x0=src1, x1=src2 → x0
  fn emitBinopRR(opc: int64, src1: int64, src2: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(src2));
    // opc encodes ADD/SUB/AND/ORR/EOR with Rm=x1(1), Rn=x0(0), Rd=x0(0)
    self.emit32(opc | (ARM64_X1 << 16) | (ARM64_X0 << 5) | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitMul(src1: int64, src2: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(src2));
    // MUL x0, x0, x1  (= MADD x0, x0, x1, xzr)
    self.emit32(0x9B007C00 | (ARM64_X1 << 16) | (ARM64_X0 << 5) | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitSdiv(src1: int64, src2: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(src2));
    // SDIV x0, x0, x1
    self.emit32(0x9AC00C00 | (ARM64_X1 << 16) | (ARM64_X0 << 5) | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitMod(src1: int64, src2: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(src2));
    // SDIV x2, x0, x1   ; x2 = x0 / x1
    self.emit32(0x9AC00C00 | (ARM64_X1 << 16) | (ARM64_X0 << 5) | ARM64_X2);
    // MSUB x0, x2, x1, x0  ; x0 = x0 - x2*x1
    self.emit32(0x9B018000 | (ARM64_X1 << 16) | (ARM64_X0 << 10) | (ARM64_X2 << 5) | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitNeg(src1: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
    // NEG x0, x0  (= SUB x0, xzr, x0)
    self.emit32(0xCB0003E0 | (ARM64_X0 << 16) | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitShift(isRight: int64, src1: int64, src2: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(src2));
    if isRight == 0 {
      // LSLV x0, x0, x1
      self.emit32(0x9AC02000 | (ARM64_X1 << 16) | (ARM64_X0 << 5) | ARM64_X0);
    } else {
      // ASRV x0, x0, x1
      self.emit32(0x9AC02800 | (ARM64_X1 << 16) | (ARM64_X0 << 5) | ARM64_X0);
    }
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // -------------------------------------------------------------------------
  // Float arithmetic helpers
  // -------------------------------------------------------------------------

  // base encodes FADD/FSUB/FMUL/FDIV with Rm=d1, Rn=d0, Rd=d0
  fn emitFBinop(base: int64, src1: int64, src2: int64, dest: int64) {
    self.emitFLdur(ARM64_D0, ARM64_X29, self.slotOff(src1));
    self.emitFLdur(ARM64_D1, ARM64_X29, self.slotOff(src2));
    self.emit32(base | (ARM64_D1 << 16) | (ARM64_D0 << 5) | ARM64_D0);
    self.emitFStur(ARM64_D0, ARM64_X29, self.slotOff(dest));
  }

  fn emitFNeg(src1: int64, dest: int64) {
    self.emitFLdur(ARM64_D0, ARM64_X29, self.slotOff(src1));
    // FNEG d0, d0  (scalar double)
    self.emit32(0x1E614000 | (ARM64_D0 << 5) | ARM64_D0);
    self.emitFStur(ARM64_D0, ARM64_X29, self.slotOff(dest));
  }

  fn emitFSqrt(src1: int64, dest: int64) {
    self.emitFLdur(ARM64_D0, ARM64_X29, self.slotOff(src1));
    // FSQRT d0, d0
    self.emit32(0x1E61C000 | (ARM64_D0 << 5) | ARM64_D0);
    self.emitFStur(ARM64_D0, ARM64_X29, self.slotOff(dest));
  }

  // -------------------------------------------------------------------------
  // Comparison
  // -------------------------------------------------------------------------
  // kind: 0=EQ, 1=NE, 2=LT, 3=LE, 4=GT, 5=GE

  fn emitCmp(kind: int64, src1: int64, src2: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(src2));
    // SUBS xzr, x0, x1  (sets flags)
    self.emit32(0xEB01001F | (ARM64_X1 << 16) | (ARM64_X0 << 5));
    // CSET x0, cond  (= CSINC x0, xzr, xzr, ~cond)
    var cset: int64 := self.csetEnc(kind);
    self.emit32(cset);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // #1339: Gleitkommavergleich. Bis hierher behandelte KEIN IR-Backend die
  // FCMP-Familie (40..45) — `if (a < b)` mit f64 erzeugte auf arm64 gar keinen
  // Code, das Ergebnisregister blieb stehen, was zufaellig drinstand. Ohne sie
  // gibt es auf diesen Zielen keine Gleitkomma-Verzweigung.
  //
  // FCMP d0, d1 setzt die Flags; danach dasselbe CSET wie beim
  // Ganzzahlvergleich. Bei ungeordneten Operanden (NaN) setzt FCMP C und V —
  // die vorzeichenlosen Bedingungen HI/HS treffen dann nicht zu, ein Vergleich
  // mit NaN ist also falsch. Genau das verlangt IEEE 754.
  fn emitFCmp(kind: int64, src1: int64, src2: int64, dest: int64) {
    self.emitFLdur(ARM64_D0, ARM64_X29, self.slotOff(src1));
    self.emitFLdur(ARM64_D1, ARM64_X29, self.slotOff(src2));
    // FCMP d0, d1  — 0x1E602000 | (Dm << 16) | (Dn << 5)
    self.emit32(0x1E602000 | (ARM64_D1 << 16) | (ARM64_D0 << 5));
    self.emit32(self.fcsetEnc(kind));
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // Wie csetEnc, aber mit den Bedingungen fuer Gleitkomma: LT/LE/GT/GE
  // brauchen MI/LS/GT/GE, damit NaN nicht als "kleiner" durchgeht.
  //   EQ=0  NE=1  MI=4(LT)  LS=9(LE)  GT=12  GE=10
  // CSET Xd, cond = CSINC Xd, XZR, XZR, ~cond — eingetragen wird die INVERSE.
  fn fcsetEnc(kind: int64): int64 {
    var invCond: int64 := 0;
    if kind == 0 { invCond := 1; }    // EQ  -> inv NE
    if kind == 1 { invCond := 0; }    // NE  -> inv EQ
    if kind == 2 { invCond := 5; }    // LT (MI=4)  -> inv PL=5
    if kind == 3 { invCond := 8; }    // LE (LS=9)  -> inv HI=8
    if kind == 4 { invCond := 13; }   // GT (12)    -> inv LE=13
    if kind == 5 { invCond := 11; }   // GE (10)    -> inv LT=11
    return 0x9A9F07E0 | ((invCond & 15) << 12) | ARM64_X0;
  }

  fn csetEnc(kind: int64): int64 {
    // CSET Xd, cond = CSINC Xd, XZR, XZR, ~cond
    // Encoding: 0x9A9F07E0 | ((~cond & 0xF) << 12) | Rd
    // Conditions: EQ=0, NE=1, LT=0xB, LE=0xD, GT=0xC, GE=0xA
    var invCond: int64 := 0;
    if kind == 0 { invCond := 1; }   // EQ → ~NE → invert=NE(1)
    if kind == 1 { invCond := 0; }   // NE → ~EQ → invert=EQ(0)
    if kind == 2 { invCond := 10; }  // LT → ~GE(10) = invCond=0xA
    if kind == 3 { invCond := 12; }  // LE → ~GT(12) = invCond=0xC
    if kind == 4 { invCond := 13; }  // GT → ~LE(13) = invCond=0xD
    if kind == 5 { invCond := 11; }  // GE → ~LT(11) = invCond=0xB
    return 0x9A9F07E0 | ((invCond & 15) << 12) | ARM64_X0;
  }

  // -------------------------------------------------------------------------
  // Memory: local slot load/store (LDUR/STUR with simm9)
  // -------------------------------------------------------------------------

  fn emitLoadLocal(src: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitStoreLocal(src: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitLoadSlot(src: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitLoadGlobal(addr: int64, dest: int64) {
    // IRO_LOAD_GLOBAL trägt einen globalIdx (NICHT eine VA).
    // ARM64-FIX: vorher MOVte der static-Pfad globalIdx als VA → LDR [0] → SIGSEGV.
    self._emitGlobalAddrX9(addr);
    self.emit32(0xF9400120 | ARM64_X0);  // LDR x0, [x9]
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // x9 := Adresse der Modulvariable gIdx. Die eine Stelle fuer Lesen, Schreiben
  // und `@g` (#2116) — die drei muessen dieselbe Adresse treffen.
  //
  // Statisch: Literal-Pool-Platz (LDR x9,[pc+8]; B +12; .quad), writeELF baeckt
  // die absolute VA hinein; globalRelocBuf merkt {Platz-Offset, gIdx}.
  //
  // #2117, .so: ADRP x9 + ADD x9,x9,#lo12 — PC-relativ, writeELFSharedLib
  // traegt die Distanz ein, und es bleibt KEINE Relocation. Vorher stand auch
  // hier ein Pool-Platz im Code, den eine R_AARCH64_RELATIVE beim Laden
  // umschreiben sollte: eine Text-Relocation im R-X-Segment, die bionic ab
  // API 23 abweist. Der Schreibzugriff (_emitStoreGlobalPIC) gab dazu als
  // Addend den INDEX statt der Adresse an — `g := 1` schrieb nach
  // Ladeadresse+8*0, in den ELF-Kopf. globalRelocBuf merkt hier
  // {ADRP-Offset, gIdx}; die Bedeutung des ersten Felds haengt am Modus.
  fn _emitGlobalAddrX9(gIdx: int64) {
    if self.isSharedLib != 0 {
      var instrOff: int64 := self.codeLen;
      self.emit32(0x90000009);         // ADRP x9, 0          (nachgetragen)
      self.emit32(0x91000129);         // ADD  x9, x9, #0     (nachgetragen)
      self._recordGlobalReloc(instrOff, gIdx);
      return;
    }
    var slotOff: int64 := self.codeLen + 8;
    self.emit32(0x58000040 | 9);     // LDR x9, [pc+8]
    self.emit32(0x14000003);         // B +12
    self.emit64(0);                   // placeholder slot (gebacken in writeELF)
    self._recordGlobalReloc(slotOff, gIdx);
  }

  // #2116: `@x` auf ein Local/Param — die Adresse des Slots, x29 + slotOff.
  // _emitFarAddr rechnet sie in x16 (auch jenseits von simm9/#1388); vor dem
  // Ablegen nach x0, weil emitStur bei fernem Ziel-Slot selbst x16 braucht.
  fn emitLoadLocalAddr(slot: int64, dest: int64) {
    self._emitFarAddr(ARM64_X29, self.slotOff(slot));
    self.emit32(0xAA1003E0 | ARM64_X0);   // MOV x0, x16  (ORR x0, xzr, x16)
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // #2116: `@g` auf eine Modulvariable — dieselbe Adressfolge wie
  // emitLoadGlobal (_emitGlobalAddrX9), nur ohne den Ladebefehl.
  fn emitLoadGlobalAddr(addr: int64, dest: int64) {
    self._emitGlobalAddrX9(addr);
    self.emitStur(9, ARM64_X29, self.slotOff(dest));
  }

  // Merkt (slotCodeOff, globalIdx) für späteres Backen durch writeELF*/writeELFSharedLib.
  fn _recordGlobalReloc(slotOff: int64, gIdx: int64) {
    if (self.globalRelocCount >= self.globalRelocCap) {
      var newCap: int64 := self.globalRelocCap * 2;
      var nb: int64 := alloc(newCap * 16);
      var i: int64 := 0;
      while i < self.globalRelocCount * 16 {
        poke8(nb + i, peek8(self.globalRelocBuf + i));
        i := i + 1;
      }
      self.globalRelocBuf := nb;
      self.globalRelocCap := newCap;
    }
    var rec: int64 := self.globalRelocBuf + self.globalRelocCount * 16;
    poke64(rec + 0, slotOff);
    poke64(rec + 8, gIdx);
    self.globalRelocCount := self.globalRelocCount + 1;
  }

  fn emitStoreGlobal(src: int64, addr: int64) {
    // ARM64-FIX (static): Vorher MOVte addr(=gIdx) als VA → STR [0] → SIGSEGV.
    self._emitGlobalAddrX9(addr);
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));  // x0 = value (fern: x16, nie x9)
    self.emit32(0xF9000120);          // STR x0, [x9]
  }

  fn emitLoadField(base: int64, fieldOff: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(base));
    // LDR x0, [x0, #fieldOff]  (scaled, fieldOff must be 0..32760, 8-byte aligned)
    var enc: int64 := 0xF9400000 | (((fieldOff >> 3) & 4095) << 10) | (ARM64_X0 << 5) | ARM64_X0;
    self.emit32(enc);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitStoreField(src: int64, base: int64, fieldOff: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(base));
    // STR x0, [x1, #fieldOff]
    var enc: int64 := 0xF9000000 | (((fieldOff >> 3) & 4095) << 10) | (ARM64_X1 << 5) | ARM64_X0;
    self.emit32(enc);
  }

  // #2147: Feldzugriff mit Breite. art = Breite | (vorzeichenbehaftet << 8)
  // aus ir_lower (_feldArtVon), 0 = acht Byte. Bis 1.2.16C las und schrieb
  // jeder Feldzugriff acht Byte mit `fieldOff >> 3` als Direktwert — ein
  // int8-Feld ueberschrieb seine Nachbarn, und ein Versatz, der kein
  // Vielfaches von 8 ist, wurde abgerundet. Acht Byte auf ausgerichtetem
  // Versatz bleiben beim bisherigen Befehl; alles andere geht ueber die
  // Registerform [x, x2] mit dem Versatz in x2.
  fn emitLoadFieldArt(base: int64, fieldOff: int64, dest: int64, art: int64) {
    var w: int64 := art & 255;
    if (w == 0 || w == 8) && (fieldOff & 7) == 0 && fieldOff >= 0 && fieldOff < 32768 {
      self.emitLoadField(base, fieldOff, dest);
      return;
    }
    var vz: int64 := (art >> 8) & 1;
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(base));
    self.emitMovImmReg(ARM64_X2, fieldOff);
    var enc: int64 := 0xF8606800;                      // LDR  x0,[x0,x2]
    if w == 1 { if vz != 0 { enc := 0x38A06800; } else { enc := 0x38606800; } }   // LDRSB x0 / LDRB w0
    if w == 2 { if vz != 0 { enc := 0x78A06800; } else { enc := 0x78606800; } }   // LDRSH x0 / LDRH w0
    if w == 4 { if vz != 0 { enc := 0xB8A06800; } else { enc := 0xB8606800; } }   // LDRSW x0 / LDR  w0
    self.emit32(enc | (ARM64_X2 << 16) | (ARM64_X0 << 5) | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitStoreFieldArt(src: int64, base: int64, fieldOff: int64, art: int64) {
    var w: int64 := art & 255;
    if (w == 0 || w == 8) && (fieldOff & 7) == 0 && fieldOff >= 0 && fieldOff < 32768 {
      self.emitStoreField(src, base, fieldOff);
      return;
    }
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(base));
    self.emitMovImmReg(ARM64_X2, fieldOff);
    var enc: int64 := 0xF8206800;                      // STR  x0,[x1,x2]
    if w == 1 { enc := 0x38206800; }                   // STRB w0
    if w == 2 { enc := 0x78206800; }                   // STRH w0
    if w == 4 { enc := 0xB8206800; }                   // STR  w0
    self.emit32(enc | (ARM64_X2 << 16) | (ARM64_X1 << 5) | ARM64_X0);
  }

  fn emitLoadIdx(base: int64, idx: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(base));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(idx));
    // LDR x0, [x0, x1, LSL #3]
    self.emit32(0xF8617800 | (ARM64_X1 << 16) | (ARM64_X0 << 5) | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitStoreIdx(src: int64, base: int64, idx: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(base));
    self.emitLdur(ARM64_X2, ARM64_X29, self.slotOff(idx));
    // STR x0, [x1, x2, LSL #3]
    self.emit32(0xF8227800 | (ARM64_X2 << 16) | (ARM64_X1 << 5) | ARM64_X0);
  }

  // -------------------------------------------------------------------------
  // Function calls
  // -------------------------------------------------------------------------

  fn emitCall(funcId: int64, argBase: int64, argCount: int64, dest: int64) {
    // ARM64-FIX: Args liegen im reservierten Block argBase..argBase+N-1 (NICHT 0..N-1,
    // die die Caller-Params aliasen würden). Lade argBase+ai → x[ai].
    // #2132: ab dem neunten ueber den Stapel (_a64StapelArgs).
    var stBytes: int64 := self._a64StapelArgs(argBase, argCount);
    self._a64RegArgs(argBase, argCount);
    // BL funcId  — record patch
    var patchOff: int64 := self.codeLen;
    self.emit32(0x94000000);  // placeholder BL
    self.addPatch(patchOff, funcId, PATCH_BL, 0);
    if stBytes > 0 { self.emit32(0x910003FF | (stBytes << 10)); }   // ADD sp, sp, #stBytes
    // Move result from x0 to dest slot
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // #2132: Argumente ab dem neunten nach AAPCS64 auf den Stapel — 8-Byte-
  // Plaetze ab sp, sp bleibt 16-ausgerichtet. Der Platz wird am Stueck
  // unter dem Rahmen angelegt (SUB sp) und nach dem Aufruf wieder
  // freigegeben; die Slots liest dieser Weg x29-relativ, sie sehen die
  // Verschiebung also nicht. Liefert die Byte-Zahl fuer das ADD danach.
  //
  // Bis 1.2.15A wurde alles ab dem neunten Argument still verworfen
  // (`while ai < 8`) — der Aufgerufene las in seinem Slot fremden Stapel.
  // Dieselbe Rechnung steht in riscv_linux.lyx (IRO_CALL) — die beiden
  // muessen uebereinstimmen.
  fn _a64StapelArgs(argBase: int64, argCount: int64): int64 {
    if argCount <= 8 { return 0; }
    if argBase < 0 {
      // Alte Konvention (Argumente im Kratzstreifen 0..7): dort ist fuer ein
      // neuntes kein Platz. Erzeugt ir_lower seit #2132 nicht mehr.
      EPrintStr("error: arm64: Aufruf mit "c); EPrintInt(argCount);
      EPrintStrLn(" Argumenten ohne Argumentblock — mehr als acht gehen so nicht (#2132)."c);
      exit(1);
    }
    var stBytes: int64 := (argCount - 8) * 8;
    if (stBytes & 15) != 0 { stBytes := stBytes + 8; }
    if stBytes > 4095 {
      EPrintStr("error: arm64: Aufruf mit "c); EPrintInt(argCount);
      EPrintStrLn(" Argumenten — mehr als 4 KB Stapelargumente werden nicht erzeugt (#2132)."c);
      exit(1);
    }
    self.emit32(0xD10003FF | (stBytes << 10));                     // SUB sp, sp, #stBytes
    var si: int64 := 8;
    while si < argCount {
      self.emitLdur(ARM64_X9, ARM64_X29, self.slotOff(argBase + si));
      self.emit32(0xF9000000 | ((si - 8) << 10) | (31 << 5) | ARM64_X9);   // STR x9, [sp, #(si-8)*8]
      si := si + 1;
    }
    return stBytes;
  }

  // #2132: die ersten acht Argumente in x0..x7. argBase < 0 ist die alte
  // Konvention mit den Argumenten im Kratzstreifen ab Slot 0.
  fn _a64RegArgs(argBase: int64, argCount: int64) {
    var rb: int64 := argBase;
    if rb < 0 { rb := 0; }
    var ai: int64 := 0;
    while ai < argCount && ai < 8 {
      self.emitLdur(ai, ARM64_X29, self.slotOff(rb + ai));
      ai := ai + 1;
    }
  }

  // Indirect call. Args follow the same convention as emitCall: caller stores
  // args 0..argCount-1 in stack slots 0..argCount-1, this routine loads them
  // into x0..x7 per AAPCS64 before branching through x9.
  // #1806: IRO_FUNC_ADDR — die Adresse einer Funktion als Wert in einen Slot.
  // Braucht jeder Aufruf ueber einen Funktionszeiger: erst muss `add` als ZAHL
  // entstehen, bevor `f(a, b)` sie indirekt rufen kann. Bis 1.1.10G fehlte der
  // Opcode hier; der Aufruf kam nur deshalb nie so weit, weil die
  // Namensaufloesung vorher scheiterte (#1806).
  fn emitFuncAddr(funcId: int64, dest: int64) {
    var patchOff: int64 := self.codeLen;
    self.emit32(0x10000009);        // ADR x9, #0 — Platzhalter, wird nachgetragen
    self.addPatch(patchOff, funcId, PATCH_ADR, 9);
    self.emitStur(9, ARM64_X29, self.slotOff(dest));
  }

  // #2132: die Argumente liegen im Block ab argBase (src2), wie beim
  // direkten Aufruf; ab dem neunten ueber den Stapel.
  fn emitCallIndirect(ptrSlot: int64, argBase: int64, argCount: int64, dest: int64) {
    var stBytes: int64 := self._a64StapelArgs(argBase, argCount);
    self._a64RegArgs(argBase, argCount);
    self.emitLdur(ARM64_X9, ARM64_X29, self.slotOff(ptrSlot));
    // BLR x9
    self.emit32(0xD63F0120);
    if stBytes > 0 { self.emit32(0x910003FF | (stBytes << 10)); }   // ADD sp, sp, #stBytes
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // FFI call (IRO_CALL_EXTERN). Args 0..argCount-1 → x0..x7, then load the
  // resolved function address from an inline GOT slot the loader fills via
  // R_AARCH64_GLOB_DAT, and BLR. nameStrOff/libStrOff index the IR string
  // table; the symbol is deduped into externBuf (dynsym index = idx+1).
  //
  // #2132: argBase (src3) ist der Argumentblock; ab dem neunten Argument
  // nach AAPCS64 ueber den Stapel, wie beim direkten Aufruf.
  //
  // #2140: sig ist das iVal der extern-Deklaration (ir_lower legt es in
  // immFloat). Bis 1.2.16A trug IRO_CALL_EXTERN keinen Typ, und alle
  // Argumente gingen nach x0..x7 — fuer Lyx-eigene Aufrufe richtig (sie
  // fuehren f64 als Bitmuster in den Ganzzahlregistern), fuer AAPCS64 nicht:
  // dort zaehlen Ganzzahlen und Gleitkommawerte getrennt, x0..x7 und d0..d7.
  // `pow(2.0, 10.0)` bekam in d0/d1, was zufaellig darin lag, und das
  // Ergebnis wurde aus x0 statt d0 gelesen.
  fn emitCallExtern(argCount: int64, libStrOff: int64, nameStrOff: int64, dest: int64, argBase: int64, sig: int64) {
    var strBuf: int64 := peek64(self.ir + 32);
    var namePtr: int64 := strBuf + nameStrOff;
    var nameLen: int64 := StrLen(namePtr as pchar);
    var stBytes: int64 := 0;
    if ((sig >> 53) & 1) != 0 {
      EPrintStr("error: arm64: extern fn '"c); sys_write(2, namePtr, nameLen);
      EPrintStrLn("': Gleitkommaparameter ab dem neunten sind nicht umgesetzt (#2140)."c);
      EPrintStrLn("  Die Signaturmaske der Deklaration reicht ueber acht Parameter; dahinter ist die Klasse unbekannt."c);
      exit(1);
    }
    if ((sig >> 32) & 0xFFFF) == 0 {
      // Nur Ganzzahlen und Zeiger: die Lyx-Reihe IST die AAPCS64-Reihe.
      stBytes := self._a64StapelArgs(argBase, argCount);
      self._a64RegArgs(argBase, argCount);
    } else {
      stBytes := self._a64FfiArgs(argBase, argCount, (sig >> 32) & 0xFFFF);
    }
    // Dedup by name.
    var externIdx: int64 := -1;
    var ei: int64 := 0;
    while ei < self.externCount {
      var eb: int64 := self.externBuf + ei * 32;
      if peek64(eb + 8) == nameLen {
        var em: int64 := 1;
        var ej: int64 := 0;
        while ej < nameLen {
          if em != 0 {
            if peek8(strBuf + peek64(eb) + ej) != peek8(namePtr + ej) { em := 0; }
          }
          ej := ej + 1;
        }
        if em != 0 { externIdx := ei; ei := self.externCount; }
      }
      ei := ei + 1;
    }
    if externIdx < 0 {
      var libPtr: int64 := strBuf + libStrOff;
      var libLen: int64 := StrLen(libPtr as pchar);
      if self.externCount >= self.externCap {
        var nc: int64 := self.externCap * 2;
        var nb: int64 := alloc(nc * 32);
        var ci: int64 := 0;
        while ci < self.externCount * 32 { poke8(nb + ci, peek8(self.externBuf + ci)); ci := ci + 1; }
        self.externBuf := nb; self.externCap := nc;
      }
      var nbase: int64 := self.externBuf + self.externCount * 32;
      poke64(nbase,      nameStrOff);
      poke64(nbase + 8,  nameLen);
      poke64(nbase + 16, libStrOff);
      poke64(nbase + 24, libLen);
      externIdx := self.externCount;
      self.externCount := self.externCount + 1;
    }
    // #2117, .so: ADRP x9 + LDR x9,[x9,#lo12] auf den GOT-Platz im
    // RW-Segment; writeELFSharedLib legt ihn an, setzt R_AARCH64_GLOB_DAT
    // darauf und traegt die Distanz hier nach. Kein Platz im Code.
    if self.isSharedLib != 0 {
      if self.gotCallCount >= self.gotCallCap {
        var gnc: int64 := self.gotCallCap * 2;
        var gnb: int64 := alloc(gnc * 16);
        memcpy(gnb, self.gotCallBuf, self.gotCallCount * 16);
        self.gotCallBuf := gnb; self.gotCallCap := gnc;
      }
      var grec: int64 := self.gotCallBuf + self.gotCallCount * 16;
      poke64(grec + 0, self.codeLen);
      poke64(grec + 8, externIdx);
      self.gotCallCount := self.gotCallCount + 1;
      self.emit32(0x90000009);        // ADRP x9, 0             (nachgetragen)
      self.emit32(0xF9400129);        // LDR  x9, [x9, #0]      (nachgetragen)
      self.emit32(0xD63F0120);        // BLR x9
      if stBytes > 0 { self.emit32(0x910003FF | (stBytes << 10)); }   // #2132: ADD sp, sp, #stBytes
      self._a64FfiRueckgabe(sig);     // #2140
      self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
      return;
    }
    // Inline GOT slot: LDR x9,[pc+8]; B +12; .quad 0; BLR x9
    // ld.so writes the resolved symbol address into the .quad (GLOB_DAT).
    var slotOff: int64 := self.codeLen + 8;
    self.emit32(0x58000040 | 9);    // LDR x9, [pc+8]
    self.emit32(0x14000003);        // B +12
    self.emit64(0);                  // GOT slot (filled by loader)
    self._recordRelocation(slotOff, ((externIdx + 1) << 32) | 1025, 0);  // R_AARCH64_GLOB_DAT
    self.emit32(0xD63F0120);        // BLR x9
    if stBytes > 0 { self.emit32(0x910003FF | (stBytes << 10)); }   // #2132: ADD sp, sp, #stBytes
    self._a64FfiRueckgabe(sig);     // #2140
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // #2140: Argumente eines FFI-Aufrufs mit Gleitkommaparametern nach AAPCS64.
  // Zwei getrennt gezaehlte Reihen: Ganzzahlen/Zeiger in x0..x7, f64 in
  // d0..d7, f32 in s0..s7 (Lyx fuehrt f32 intern als f64-Bits, #1127 — also
  // FCVT auf single). Was in seiner Reihe keinen Platz mehr hat, geht in
  // Parameterreihenfolge auf den Stapel, 8-Byte-Plaetze ab sp.
  //
  // Die Klasse steht in fmask (2 Bit je Parameter, die ersten acht); dass
  // dahinter kein Gleitkommawert steht, hat emitCallExtern ueber Bit 53
  // geprueft. Ein Gleitkommawert auf dem Stapel braeuchte also neun
  // Gleitkommaparameter unter den ersten acht — den Fall gibt es nicht.
  //
  // Dieselbe Einteilung wie der SysV-Weg in codegen_x86.lyx (#1486/#1640,
  // dort 6 GP + 8 xmm) — die beiden muessen uebereinstimmen.
  fn _a64FfiArgs(argBase: int64, argCount: int64, fmask: int64): int64 {
    var rb: int64 := argBase;
    if rb < 0 { rb := 0; }
    var nI: int64 := 0;
    var nSt: int64 := 0;
    var i: int64 := 0;
    while i < argCount {
      var c0: int64 := 0;
      if i < 8 { c0 := (fmask >> (i * 2)) & 3; }
      if c0 == 0 {
        if nI < 8 { nI := nI + 1; } else { nSt := nSt + 1; }
      }
      i := i + 1;
    }
    var stBytes: int64 := nSt * 8;
    if (stBytes & 15) != 0 { stBytes := stBytes + 8; }
    if stBytes > 0 {
      if argBase < 0 {
        EPrintStrLn("error: arm64: FFI-Aufruf mit Stapelargumenten ohne Argumentblock (#2132, #2140)."c);
        exit(1);
      }
      if stBytes > 4095 {
        EPrintStrLn("error: arm64: FFI-Aufruf mit mehr als 4 KB Stapelargumenten (#2140)."c);
        exit(1);
      }
      self.emit32(0xD10003FF | (stBytes << 10));                     // SUB sp, sp, #stBytes
    }
    nI := 0;
    var nF: int64 := 0;
    var si: int64 := 0;
    i := 0;
    while i < argCount {
      var c: int64 := 0;
      if i < 8 { c := (fmask >> (i * 2)) & 3; }
      if c == 0 {
        if nI < 8 {
          self.emitLdur(nI, ARM64_X29, self.slotOff(rb + i));        // x_nI
          nI := nI + 1;
        } else {
          self.emitLdur(ARM64_X9, ARM64_X29, self.slotOff(rb + i));
          self.emit32(0xF9000000 | (si << 10) | (31 << 5) | ARM64_X9);   // STR x9, [sp, #si*8]
          si := si + 1;
        }
      } else {
        self.emitLdur(ARM64_X9, ARM64_X29, self.slotOff(rb + i));
        self.emit32(0x9E670000 | (ARM64_X9 << 5) | nF);              // FMOV d_nF, x9
        if c == 2 {
          self.emit32(0x1E624000 | (nF << 5) | nF);                  // FCVT s_nF, d_nF
        }
        nF := nF + 1;
      }
      i := i + 1;
    }
    return stBytes;
  }

  // #2140: Rueckgabe eines FFI-Aufrufs in die Lyx-Form (Wert in x0).
  //   f64  kommt in d0       -> FMOV x0, d0
  //   f32  kommt in s0       -> FCVT d0, s0; FMOV x0, d0
  //   int8..uint32: AAPCS64 laesst die oberen Bits von x0 offen — clang
  //   schreibt w0, aus -1 wird also 4294967295. Dieselbe Erweiterung wie
  //   #1607 in codegen_x86.lyx (Breite in Bits 50-52; die beiden muessen
  //   uebereinstimmen).
  fn _a64FfiRueckgabe(sig: int64) {
    var fret: int64 := (sig >> 48) & 3;
    if fret == 2 { self.emit32(0x1E22C000); }                  // FCVT d0, s0
    if fret != 0 { self.emit32(0x9E660000); return; }          // FMOV x0, d0
    var iw: int64 := (sig >> 50) & 7;
    if iw == 1 { self.emit32(0x93401C00); }                    // SXTB x0, w0
    if iw == 2 { self.emit32(0x93403C00); }                    // SXTH x0, w0
    if iw == 3 { self.emit32(0x93407C00); }                    // SXTW x0, w0
    if iw == 4 { self.emit32(0x53001C00); }                    // UXTB w0, w0
    if iw == 5 { self.emit32(0x53003C00); }                    // UXTH w0, w0
    if iw == 6 { self.emit32(0x2A0003E0); }                    // MOV  w0, w0
  }

  // IRO_CONST_STR: load the runtime address of a string literal into `dest`.
  // The string bytes are embedded inline in the code stream (jumped over by a
  // B) and addressed PC-relatively with ADR — no data section, relocation or
  // patching needed, which keeps this self-contained and works in the static
  // ELF. `strOff` indexes the IR string table (null-terminated).
  fn emitConstStr(strOff: int64, dest: int64) {
    var strBuf: int64 := peek64(self.ir + 32);
    var sp: int64 := strBuf + strOff;
    // #1968: Die Laenge steht im VORSPANN vor der Zeichenkette (acht Byte bei
    // off-8, von irAddString gelegt), nicht in der Nullterminierung. `StrLen`
    // schnitt hier alles ab dem ersten Nullbyte im INHALT ab — bei einer
    // eingebetteten Datei (#1961) blieb davon ein Bruchstueck plus Fremdbytes
    // aus dem anschliessenden Speicher. Die Null wird weiterhin MITgeschrieben,
    // die Laufzeit erwartet sie bei pchar; sie ist nur nicht mehr das Mass.
    var len: int64 := _irStrLenVorspann(strBuf, strOff);
    var total: int64 := len + 1;                 // include NUL
    var pad: int64 := (4 - (total & 3)) & 3;     // pad to 4-byte boundary
    var padded: int64 := total + pad;
    // ADR x0, #8  — the string begins 8 bytes (ADR + B) after this ADR.
    self.emit32(0x10000040);
    // B over the inline string: (4 + padded) bytes ahead of this B.
    self.emit32(0x14000000 | ((4 + padded) >> 2));
    // inline string bytes + NUL + padding
    var i: int64 := 0;
    while i < len { self.emit8(peek8(sp + i)); i := i + 1; }
    self.emit8(0);
    var p: int64 := 0;
    while p < pad { self.emit8(0); p := p + 1; }
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitBuiltinCall(id: int64, argBase: int64, dest: int64) {
    // WP-D2: Windows mode — emit BL placeholder to helper stubs instead of syscalls
    if self.winMode != 0 {
      if id == 1 {
        // PrintStr: x0=str, x1=len → wab_printstr helper
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(1));
        self.addWinPatch(self.codeLen, 1);
        self.emit32(0x94000000);  // BL placeholder
      } else if id == 2 {
        // PrintInt: x0=int64 → wab_printint helper
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.addWinPatch(self.codeLen, 2);
        self.emit32(0x94000000);
      } else if id == 3 {
        // Exit: x0=exitcode → wab_exit helper (calls ExitProcess)
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.addWinPatch(self.codeLen, 3);
        self.emit32(0x94000000);
      } else if id == 6 {
        // WP-01: StrSub(s, start, len) → wab_strsub helper
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(1));
        self.emitLdur(ARM64_X2, ARM64_X29, self.slotOff(2));
        self.addWinPatch(self.codeLen, 6);
        self.emit32(0x94000000);
      } else if id == 7 {
        // WP-01: StrConcat(a, b) → wab_strconcat helper
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(1));
        self.addWinPatch(self.codeLen, 7);
        self.emit32(0x94000000);
      } else if id == 8 {
        // WP-01: StrCopy(s) → wab_strcopy helper
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.addWinPatch(self.codeLen, 8);
        self.emit32(0x94000000);
      } else if id == 9 {
        // WP-08: PrintFloat(f64) → wab_printf helper (int decomp via wab_printint/wab_printstr)
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.addWinPatch(self.codeLen, 9);
        self.emit32(0x94000000);
      } else if id == 12 {
        // WP-08: Printf(fmt, a1, a2, a3) → wab_printf_full helper.
        // #1037: vorher id=10 — dieselbe Nummer wie mem_barrier(), das damit
        // hier im Printf-Helfer landete. Der Helfer-Index bleibt 10, nur die
        // Builtin-ID wandert auf 12.
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(1));
        self.emitLdur(ARM64_X2, ARM64_X29, self.slotOff(2));
        self.emitLdur(ARM64_X3, ARM64_X29, self.slotOff(3));
        self.addWinPatch(self.codeLen, 10);
        self.emit32(0x94000000);
      } else if id == 10 || id == 11 {
        // WP-GPIO-1: mem_barrier()/inst_barrier(). Auf Windows-ARM64 gibt es
        // keine Barrieren-Emission; ausdruecklich als No-op fuehren, statt in
        // den Fehlerzweig zu fallen.
      } else if id == 200 || id == 208 || id == 201 || id == 202
             || id == 203 || id == 209 || id == 204 || id == 205 {
        // #1388: Speicherzugriffe brauchen kein Betriebssystem und gelten
        // deshalb auch im Windows-Zweig.
        self._emitPeekPoke(id);
      } else {
        self._builtinUnsupported(id, 1);
      }
      self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
      return;
    }
    // Linux path — emit inline syscalls
    if id == 1 {
      // PrintStr: write(1, buf, len) — buf und len stehen in den Slots 0 und 1.
      //
      // #1769: Eine NEGATIVE Laenge ist ein Sentinel und heisst „bis zum
      // Nullbyte zaehlen". ir_lower setzt ihn fuer `Print`/`PrintLn` mit einer
      // pchar-VARIABLEN, weil die Laenge erst zur Laufzeit feststeht (dort
      // steht -1 im Laengen-Slot). arm64 reichte den Wert roh an write weiter:
      // der Aufruf scheiterte, und `PrintLn(s)` schwieg, waehrend
      // `PrintLn("literal")` schrieb. Das lyxos-Backend kennt den Sentinel
      // laengst, riscv seit #1764 — hier ist er nachgezogen.
      //
      // Der Zaehlblock ist derselbe wie bei ID 13 (EPrintStr) darunter.
      self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(0));   // x1 = buf
      self.emitLdur(ARM64_X2, ARM64_X29, self.slotOff(1));   // x2 = len
      self.emit32(0xB6F800C2);  // TBZ x2, #63, +6  → Laenge >= 0: Zaehlblock ueberspringen
      self.emit32(0xD2800002);  // MOVZ x2, #0            (Laenge)
      self.emit32(0x38626823);  // [LOOP] LDRB w3,[x1,x2]
      self.emit32(0x34000063);  // CBZ w3, +3  (→ WRITE)
      self.emit32(0x91000442);  // ADD x2,x2,#1
      self.emit32(0x17FFFFFD);  // B -3        (→ LOOP)
      self.emitMovImmReg(ARM64_X0, 1);   // [WRITE] fd = stdout
      self.emitMovImmReg(ARM64_X8, SYS_WRITE);
      self.emit32(0xD4000001);  // SVC #0
    } else if id == 2 {
      // PrintInt(n): int64 → Dezimal-ASCII nach stdout, OHNE Newline (PrintIntLn macht \n).
      // ARM64-FIX: vorher write(x0=intwert, müll, müll) → EBADF, leer. Jetzt inline itoa+write
      // (gespiegelt von der inspect-Routine; fd=1=stdout statt 2, Länge ohne '\n' = sp+31).
      // Wert kommt in slot0 (PrintInt-Lowering: STORE_LOCAL 0). 32-Byte-Stack-Buffer:
      // x9=write_ptr, x10=value, x11=neg, x12=10, x13=quot, x14=digit.
      // Identische Instr-Anzahl/-Layout wie inspect-itoa (Branch-Offsets bleiben gültig);
      // NUR instr28 (Ende sp+31 statt +32 → '\n' ausgeschlossen) + instr31 (fd=1) geändert.
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));  // x0 = value
      self.emit32(0xD10083FF);  // instr0: SUB sp,sp,#32
      self.emit32(0x91007BE9);  // instr1: ADD x9,sp,#30
      self.emit32(0x5280014A);  // instr2: MOVZ w10,#10  ('\n' in Buffer, NICHT ausgegeben)
      self.emit32(0x39007FEA);  // instr3: STRB w10,[sp,#31]
      self.emit32(0xAA0003EA);  // instr4: MOV x10,x0
      self.emit32(0xD280000B);  // instr5: MOVZ x11,#0
      self.emit32(0xB400024A);  // instr6: CBZ x10,+18 (→ instr24 ZERO_CASE)
      self.emit32(0xF100015F);  // instr7: CMP x10,#0
      self.emit32(0x5400006A);  // instr8: B.GE +3 (→ instr11 POS_LOOP)
      self.emit32(0xCB0A03EA);  // instr9: NEG x10,x10
      self.emit32(0xD280002B);  // instr10: MOVZ x11,#1
      self.emit32(0xD280014C);  // instr11: [POS_LOOP] MOVZ x12,#10
      self.emit32(0x9ACC094D);  // instr12: UDIV x13,x10,x12
      self.emit32(0x9B0CA9AE);  // instr13: MSUB x14,x13,x12,x10
      self.emit32(0x1100C1CE);  // instr14: ADD w14,w14,#48
      self.emit32(0x3900012E);  // instr15: STRB w14,[x9]
      self.emit32(0xD1000529);  // instr16: SUB x9,x9,#1
      self.emit32(0xAA0D03EA);  // instr17: MOV x10,x13
      self.emit32(0xB5FFFF2A);  // instr18: CBNZ x10,-7 (→ instr11)
      self.emit32(0xB400008B);  // instr19: CBZ x11,+4 (→ instr23)
      self.emit32(0x528005AE);  // instr20: MOVZ w14,#45 ('-')
      self.emit32(0x3900012E);  // instr21: STRB w14,[x9]
      self.emit32(0xD1000529);  // instr22: SUB x9,x9,#1
      self.emit32(0x14000004);  // instr23: B +4 (→ instr27 EMIT_OUT)
      self.emit32(0x5280060E);  // instr24: [ZERO_CASE] MOVZ w14,#48 ('0')
      self.emit32(0x3900012E);  // instr25: STRB w14,[x9]
      self.emit32(0xD1000529);  // instr26: SUB x9,x9,#1
      self.emit32(0x91000529);  // instr27: [EMIT_OUT] ADD x9,x9,#1
      self.emit32(0x91007FEA);  // instr28: ADD x10,sp,#31  (Ende OHNE '\n')
      self.emit32(0xCB090142);  // instr29: SUB x2,x10,x9  (len)
      self.emit32(0xAA0903E1);  // instr30: MOV x1,x9
      self.emit32(0xD2800020);  // instr31: MOVZ x0,#1  (fd=stdout)
      self.emit32(0xD2800808);  // instr32: MOVZ x8,#64 (SYS_WRITE)
      self.emit32(0xD4000001);  // instr33: SVC #0
      self.emit32(0x910083FF);  // instr34: ADD sp,sp,#32
    } else if id == 210 {
      // #1769: memcpy(dst, src, len) — byteweise, Rueckgabe ist dst (bleibt in
      // x0 stehen). std/io setzt damit seine Ausgabepuffer zusammen; ohne die
      // ID kommt `PrintLn` nicht durch. Wortweise zu kopieren braeuchte eine
      // Ausrichtungspruefung und brachte hier nichts — die Puffer sind kurz.
      var mcB: int64 := argBase;
      if (mcB < 0) { mcB := 0; }
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(mcB));      // x0 = dst
      self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(mcB + 1));  // x1 = src
      self.emitLdur(ARM64_X2, ARM64_X29, self.slotOff(mcB + 2));  // x2 = len
      self.emit32(0xD2800003);  // MOVZ x3, #0        (Zaehler)
      self.emit32(0xEB02007F);  // [LOOP] CMP x3, x2
      self.emit32(0x540000A0);  // B.EQ +5            (fertig)
      self.emit32(0x38636824);  // LDRB w4,[x1,x3]
      self.emit32(0x38236804);  // STRB w4,[x0,x3]
      self.emit32(0x91000463);  // ADD x3,x3,#1
      self.emit32(0x17FFFFFB);  // B -5               (→ LOOP)
    } else if id == 216 {
      // #1842: memset(ptr, byte, len) — byteweise, Rueckgabe ist ptr (bleibt in
      // x0 stehen). Dieselbe Rechnung wie 210 darueber, die beiden muessen
      // uebereinstimmen; gemeldet war die Luecke als lyxos-Problem, sie traf
      // aber jedes Ziel am gemeinsamen IR-Weg.
      var msB: int64 := argBase;
      if (msB < 0) { msB := 0; }
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(msB));      // x0 = ptr
      self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(msB + 1));  // x1 = Bytewert
      self.emitLdur(ARM64_X2, ARM64_X29, self.slotOff(msB + 2));  // x2 = len
      self.emit32(0xD2800003);  // MOVZ x3, #0        (Zaehler)
      self.emit32(0xEB02007F);  // [LOOP] CMP x3, x2
      self.emit32(0x54000080);  // B.EQ +4            (fertig)
      self.emit32(0x38236801);  // STRB w1,[x0,x3]
      self.emit32(0x91000463);  // ADD x3,x3,#1
      self.emit32(0x17FFFFFC);  // B -4               (→ LOOP)
    } else if id == 222 || id == 223 {
      // #1769: read(fd, buf, len) / write(fd, buf, len). Beide fehlten im
      // Linux-Zweig, und weil std/io seine Ausgabe darueber schickt, scheiterte
      // `PrintLn` auf arm64 schon beim Uebersetzen — laut immerhin. Die drei
      // Argumente stehen ab argBase, das Ergebnis kommt ueber x0 zurueck.
      // `open` bleibt bewusst offen: arm64 kennt wie riscv64 nur openat(56)
      // mit vier Argumenten, eine geratene Nummer waere der naechste stille
      // Fehler (dieselbe Ueberlegung wie in #1740/#1764).
      var rwB: int64 := argBase;
      if (rwB < 0) { rwB := 0; }
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(rwB));      // fd
      self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(rwB + 1));  // buf
      self.emitLdur(ARM64_X2, ARM64_X29, self.slotOff(rwB + 2));  // len
      if (id == 222) { self.emitMovImmReg(ARM64_X8, SYS_READ); }
      if (id == 223) { self.emitMovImmReg(ARM64_X8, SYS_WRITE); }
      self.emit32(0xD4000001);  // SVC #0
    } else if id == 3 {
      // Exit
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
      self.emitMovImmReg(ARM64_X8, SYS_EXIT);
      self.emit32(0xD4000001);
    } else if id == 10 {
      // WP-GPIO-1: mem_barrier() → DMB SY
      // Encoding: D5 03 3F BF (little-endian uint32 = 0xBF3F03D5)
      self.emit32(0xBF3F03D5);
    } else if id == 11 {
      // WP-GPIO-1: inst_barrier() → ISB SY
      // Encoding: D5 03 3F DF (little-endian uint32 = 0xDF3F03D5)
      self.emit32(0xDF3F03D5);
    } else if id == 8 {
      // #2037: StrCopy(s) — Kette in frischen Speicher kopieren.
      //
      // Stand nur im WINDOWS-Zweig (wab_strcopy). Genau daran ist die
      // Abdeckungsmessung zuerst gescheitert: `id == 8` kommt in der Datei
      // vor, aber im falschen Zweig — die Zahl allein sagt nichts darueber,
      // WO sie steht. Der Waechter in tests/backend_abdeckung_test.sh
      // vergleicht deshalb je Zweig.
      //
      // Puffer aus mmap wie bei StrSub (6) und StrConcat (7).
      var scB: int64 := argBase;
      if (scB < 0) { scB := 0; }
      self.emitLdur(ARM64_X9, ARM64_X29, self.slotOff(scB));   // x9 = s
      // Laenge zaehlen
      self.emit32(0xD280000B);  // MOVZ x11, #0
      self.emit32(0x386B6923);  // [L1] LDRB w3,[x9,x11]
      self.emit32(0x34000063);  // CBZ w3, +3
      self.emit32(0x9100056B);  // ADD x11,x11,#1
      self.emit32(0x17FFFFFD);  // B -3
      // Puffer: Laenge + 16
      self.emit32(0x91004161);  // ADD x1, x11, #16
      self.emitMovImmReg(ARM64_X0, 0);
      self.emitMovImmReg(ARM64_X2, 3);
      self.emitMovImmReg(ARM64_X3, 0x22);
      self.emit32(0x92800004);  // MOVN x4, #0
      self.emitMovImmReg(ARM64_X5, 0);
      self.emitMovImmReg(ARM64_X8, SYS_MMAP);
      self.emit32(0xD4000001);  // SVC #0 → x0 = Puffer
      self.emitMmapGeprueft();   // #2144
      // Kopieren, Nullbyte eingeschlossen
      self.emit32(0xD280000D);  // MOVZ x13, #0
      self.emit32(0x386D6923);  // [L2] LDRB w3,[x9,x13]
      self.emit32(0x8B0D0002);  // ADD x2, x0, x13
      self.emit32(0x39000043);  // STRB w3,[x2]
      self.emit32(0x34000063);  // CBZ w3, +3 (fertig)
      self.emit32(0x910005AD);  // ADD x13,x13,#1
      self.emit32(0x17FFFFFB);  // B -5
    } else if id == 220 {
      // #2037: open(path, flags, mode). Die generische Linux-ABI kennt kein
      // `open` — Nummer 56 ist dort openat(dirfd, path, flags, mode). dirfd =
      // AT_FDCWD (-100), damit relative Pfade wie bei open wirken.
      //
      // Das riscv-Backend hat die Umsetzung seit #1764; hier fehlte sie ganz,
      // und damit war JEDES Programm, das eine Datei oeffnet, fuer arm64
      // unbaubar. Beide Ziele gehen nach derselben ABI — es ist dieselbe
      // Rechnung, und die beiden muessen uebereinstimmen.
      var opB: int64 := argBase;
      if (opB < 0) { opB := 0; }
      self.emitMovImmReg(ARM64_X0, 0 - 100);                        // AT_FDCWD
      self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(opB));        // path
      self.emitLdur(ARM64_X2, ARM64_X29, self.slotOff(opB + 1));    // flags
      self.emitLdur(ARM64_X3, ARM64_X29, self.slotOff(opB + 2));    // mode
      self.emitMovImmReg(ARM64_X8, SYS_OPEN);                       // 56 = openat
      self.emit32(0xD4000001);                                      // SVC #0
    } else if id == 17 {
      // #2110: GetArgC — die argv-Zeiger ab x28 bis zum abschliessenden NULL
      // zaehlen (argv[argc] ist NULL). Dieselbe Rechnung wie in
      // riscv_linux.lyx, die beiden muessen uebereinstimmen.
      self.emit32(0xAA1C03E9);   // MOV x9, x28
      self.emit32(0xD2800000);   // MOVZ x0, #0
      self.emit32(0xF940012A);   // [L] LDR x10, [x9]
      self.emit32(0xB400008A);   // CBZ x10, +16 → hinter die Schleife
      self.emit32(0x91000400);   // ADD x0, x0, #1
      self.emit32(0x91002129);   // ADD x9, x9, #8
      self.emit32(0x17FFFFFC);   // B L
    } else if id == 18 {
      self.emit32(0xAA1C03E0);   // #2110: GetArgV — MOV x0, x28
    } else if id == 235 {
      // #2110: ArgvGet(argv, i) — argv[i], aber nur, solange vorher kein NULL
      // kommt: ein Index ausserhalb liefert 0 statt eines Umgebungseintrags
      // (dieselbe Absicht wie #1460 auf x86; ein negativer Index laeuft bis
      // zum NULL und liefert ebenfalls 0). Dieselbe Rechnung wie in
      // riscv_linux.lyx.
      var avB: int64 := argBase;
      if (avB < 0) { avB := 0; }
      self.emitLdur(ARM64_X9, ARM64_X29, self.slotOff(avB));        // argv
      self.emitLdur(ARM64_X10, ARM64_X29, self.slotOff(avB + 1));   // i
      self.emit32(0xB40000CA);   // [L] CBZ x10, +24 → nehmen
