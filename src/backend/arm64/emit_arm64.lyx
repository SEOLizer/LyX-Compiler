// ==================================================================
// WP-BC-33: ARM64/AArch64 Linux Backend
// ==================================================================
// Vollständige ARM64 Code-Generierung aus IR für Linux ELF64:
// - AAPCS64-ABI (SysV AMD64-ähnlich, aber x0-x7 für Args)
// - Stack-basierte Temp-Allokation ([x29, #-8N])
// - Korrekte 32-bit Fixed-Width Instruction-Encodings
// - Label-Backpatching für Branches
// - Linux Syscall-Nummern (write=64, exit=93, mmap=222, munmap=215)
//
// Instruction-Encoding-Referenz:
//   LDUR/STUR  (simm9):  0xF8400000 / 0xF8000000
//   ADD Rd,Rn,Rm:        0x8B000000 | Rm<<16 | Rn<<5 | Rd
//   MOVZ Xd,#imm16:      0xD2800000 | imm16<<5 | Rd
//   STP x29,x30,[sp,-16]!: 0xA9BF7BFD
//   LDP x29,x30,[sp],16:   0xA8C17BFD
//   RET:                 0xD65F03C0

// ============================================================================
// Register Constants (AAPCS64)
// ============================================================================


import src.std.alloc;
pub con ARM64_X0:  int64 := 0;
pub con ARM64_X1:  int64 := 1;
pub con ARM64_X2:  int64 := 2;
pub con ARM64_X3:  int64 := 3;
pub con ARM64_X4:  int64 := 4;
pub con ARM64_X5:  int64 := 5;
pub con ARM64_X6:  int64 := 6;
pub con ARM64_X7:  int64 := 7;
pub con ARM64_X8:  int64 := 8;   // indirect result / syscall number
pub con ARM64_X9:  int64 := 9;   // scratch
pub con ARM64_X10: int64 := 10;  // scratch
pub con ARM64_X29: int64 := 29;  // frame pointer (FP)
pub con ARM64_X30: int64 := 30;  // link register (LR)
pub con ARM64_XZR: int64 := 31;  // zero register / SP
pub con ARM64_D0:  int64 := 0;   // FP/SIMD arg/result
pub con ARM64_D1:  int64 := 1;
pub con ARM64_D7:  int64 := 7;

// Linux ARM64 syscall numbers
pub con SYS_WRITE:  int64 := 64;
pub con SYS_EXIT:   int64 := 93;
pub con SYS_MMAP:   int64 := 222;
pub con SYS_MUNMAP: int64 := 215;
pub con SYS_OPEN:   int64 := 56;
pub con SYS_CLOSE:  int64 := 57;

// ============================================================================
// Patch record: pending branch to be backpatched
// ============================================================================
// Layout: [codeOff:int64][labelId:int64][instrType:int64]
// instrType 0 = B (26-bit), 1 = CBZ/CBNZ (19-bit + reg)
pub con PATCH_B:    int64 := 0;
pub con PATCH_CBZ:  int64 := 1;
pub con PATCH_CBNZ: int64 := 2;
pub con PATCH_BL:   int64 := 3;

// ============================================================================
// EmitARM64 Class
// ============================================================================

pub type EmitARM64 = class {
  codeBuf:         int64;
  codeLen:         int64;
  codeCap:         int64;

  ir:              int64;

  stackSize:       int64;

  // label address table: labelId -> byte offset in codeBuf
  labelAddrs:      int64;
  labelCount:      int64;

  // pending branch patches: {codeOff, labelId, type, reg}
  patchBuf:        int64;
  patchCount:      int64;

  // function table: funcId -> start offset (for BL patching)
  funcAddrs:       int64;
  funcCount:       int64;

  // WP-AND-03: per-function prologue length in bytes. The DWARF CFI generator
  // uses this to advance_loc over the prologue before declaring CFA = fp+16.
  funcPrologueLen: int64;

  // WP-AND-02 Phase C: shared-library mode toggle and dynamic-relocation buffer.
  // When isSharedLib != 0, emitLoadGlobal / emitStoreGlobal use PC-relative
  // literal-pool loads instead of MOVZ/MOVK chains, and each pool slot is
  // recorded as an R_AARCH64_RELATIVE entry for runtime fix-up by the loader.
  // relocBuf holds Elf64_Rela records (24 bytes each).
  isSharedLib:     int64;
  relocBuf:        int64;
  relocCount:      int64;
  relocCap:        int64;

  // WP-AND-upstream-fix v5: separate tracking for IRO_LOAD_GLOBAL slots.
  // Records are 16 bytes: {slotCodeOff:i64, globalIdx:i64}. writeELFSharedLib
  // patches each slot to the global's .data address and emits the matching
  // R_AARCH64_RELATIVE entry. Kept apart from relocBuf so global slots
  // don't collide with non-global PIC relocations.
  globalRelocBuf:    int64;
  globalRelocCount:  int64;
  globalRelocCap:    int64;

  // FFI (extern fn ... link). Per distinct extern symbol referenced by a call
  // we emit an inline GOT slot resolved by the loader via R_AARCH64_GLOB_DAT.
  // externBuf dedups the symbols — 32-byte entries {nameStrOff, nameLen,
  // libStrOff, libLen}, all offsets into the IR string table — so writeELF can
  // build .dynsym/.dynstr/DT_NEEDED. The dynsym index of entry i is i+1
  // (index 0 is the reserved null symbol).
  externBuf:   int64;
  externCount: int64;
  externCap:   int64;

  // WP-D2: Windows target mode — replaces Linux syscalls with BL placeholders
  // that WinARM64Backend resolves to Windows API helper stubs after emit().
  // winPatchBuf holds 16-byte records: {codeOffset:i64, helperId:i64}.
  // Helper IDs: 1=PrintStr, 2=PrintInt, 3=Exit, 4=Alloc, 5=Free.
  winMode:       int64;
  winPatchBuf:   int64;
  winPatchCount: int64;
  winPatchCap:   int64;


  // -------------------------------------------------------------------------
  // Init
  // -------------------------------------------------------------------------

  fn init(irMod: int64) {
    self.ir          := irMod;
    self.codeBuf     := alloc(131072);
    self.codeCap     := 131072;
    self.codeLen     := 0;
    self.stackSize   := 0;
    self.labelAddrs  := alloc(1024 * 8);
    self.labelCount  := 0;
    self.patchBuf    := alloc(1024 * 32);
    self.patchCount  := 0;
    self.funcAddrs   := alloc(256 * 8);
    self.funcCount   := 0;
    // WP-AND-03: 256 slots, parallel to funcAddrs.
    self.funcPrologueLen := alloc(256 * 8);

    // WP-AND-02 Phase C: dynamic-reloc state. Buffer grows on demand.
    self.isSharedLib := 0;
    self.relocCap    := 32;
    self.relocBuf    := alloc(self.relocCap * 24);
    self.relocCount  := 0;

    // WP-AND-upstream-fix v5: global-load slot tracking (16 bytes/entry).
    self.globalRelocCap   := 32;
    self.globalRelocBuf   := alloc(self.globalRelocCap * 16);
    self.globalRelocCount := 0;

    self.externCap   := 64;
    self.externBuf   := alloc(self.externCap * 32);
    self.externCount := 0;

    // WP-D2: Windows mode — off by default
    self.winMode       := 0;
    self.winPatchCap   := 64;
    self.winPatchBuf   := alloc(self.winPatchCap * 16);
    self.winPatchCount := 0;
  }

  fn getGlobalRelocBuf(): int64   { return self.globalRelocBuf; }
  fn getGlobalRelocCount(): int64 { return self.globalRelocCount; }
  fn getExternBuf(): int64        { return self.externBuf; }
  fn getExternCount(): int64      { return self.externCount; }

  fn getFuncPrologueLen(): int64 { return self.funcPrologueLen; }

  // WP-D2: Windows mode helpers
  pub fn setWinMode(m: int64) { self.winMode := m; }
  pub fn getWinPatchBuf(): int64 { return self.winPatchBuf; }
  pub fn getWinPatchCount(): int64 { return self.winPatchCount; }

  fn addWinPatch(codeOff: int64, helperId: int64) {
    if self.winPatchCount >= self.winPatchCap {
      var nc: int64 := self.winPatchCap * 2;
      var nb: int64 := alloc(nc * 16);
      var i: int64 := 0;
      while i < self.winPatchCount * 16 {
        poke8(nb + i, peek8(self.winPatchBuf + i));
        i := i + 1;
      }
      self.winPatchBuf := nb;
      self.winPatchCap := nc;
    }
    poke64(self.winPatchBuf + self.winPatchCount * 16,     codeOff);
    poke64(self.winPatchBuf + self.winPatchCount * 16 + 8, helperId);
    self.winPatchCount := self.winPatchCount + 1;
  }

  // WP-AND-02 Phase C: opt into PIC code emission. Caller flips this BEFORE
  // calling emit(); takes effect for emitLoadGlobal / emitStoreGlobal.
  pub fn setSharedLib(flag: int64) {
    self.isSharedLib := flag;
  }

  fn getRelocBuf(): int64   { return self.relocBuf; }
  fn getRelocCount(): int64 { return self.relocCount; }

  // WP-AND-02 Phase C: append an Elf64_Rela record. r_info packs (sym_idx<<32)|type.
  // For R_AARCH64_RELATIVE (1027) the symbol index is 0 and addend = base-relative
  // address that the loader writes back into *(load_base + r_offset).
  fn _recordRelocation(offset: int64, info: int64, addend: int64) {
    if (self.relocCount >= self.relocCap) {
      var newCap: int64 := self.relocCap * 2;
      var nb: int64 := alloc(newCap * 24);
      var i: int64 := 0;
      while i < self.relocCount * 24 {
        poke8(nb + i, peek8(self.relocBuf + i));
        i := i + 1;
      }
      self.relocBuf := nb;
      self.relocCap := newCap;
    }
    var off: int64 := self.relocBuf + self.relocCount * 24;
    poke64(off +  0, offset);
    poke64(off +  8, info);
    poke64(off + 16, addend);
    self.relocCount := self.relocCount + 1;
  }

  // -------------------------------------------------------------------------
  // Top-level emit
  // -------------------------------------------------------------------------

  fn emit(): int64 {
    var n: int64 := self.getFuncCount();
    var i: int64 := 0;
    while i < n {
      self.emitFunc(i);
      i := i + 1;
    }
    // WP-AND-upstream-fix v9: final patch pass for forward references.
    // funcAddrs is now fully populated, so any BL patch that was skipped
    // earlier (callee not yet emitted) resolves here.
    self.applyPatches();
    return self.codeLen;
  }

  fn emitFunc(funcId: int64) {
    // Record start address
    if funcId < 256 {
      poke64(self.funcAddrs + funcId * 8, self.codeLen);
      self.funcCount := self.funcCount + 1;
    }

    self.stackSize   := 0;
    self.labelCount  := 0;
    // WP-AND-upstream-fix v9: do NOT reset patchCount here. Inter-function
    // BL patches must survive across emitFunc calls so forward references
    // (caller emitted before callee) can be resolved by the final
    // applyPatches pass in emit() once every funcAddrs entry is known.
    // applyPatches marks already-resolved entries by setting labelId = -2.

    // Zero out label table
    var li: int64 := 0;
    while li < 1024 {
      poke64(self.labelAddrs + li * 8, -1);
      li := li + 1;
    }

    self.calcStackFrame(funcId);
    var prologueStart: int64 := self.codeLen;
    self.emitPrologue();
    // WP-AND-upstream-fix v7: spill incoming register args (x0..x7 per
    // AAPCS64) into stack slots 0..paramCount-1 so subsequent
    // IRO_LOAD_LOCAL of a parameter actually reads its value. Without
    // this every NK_IDENT lookup that hit the params chain returned
    // whatever was at fp - (i+1)*8, i.e. uninitialised stack.
    var pSpillCount: int64 := peek64(peek64(self.ir + 80) + funcId * 80 + 40);
    var pSpillI: int64 := 0;
    while pSpillI < pSpillCount {
      if pSpillI < 8 {
        self.emitStur(pSpillI, ARM64_X29, self.slotOff(pSpillI));
      }
      pSpillI := pSpillI + 1;
    }
    // WP-AND-03: stash prologue length for DWARF CFI advance_loc.
    if funcId < 256 {
      poke64(self.funcPrologueLen + funcId * 8, self.codeLen - prologueStart);
    }

    var instrStart: int64 := self.getFuncInstrStart(funcId);
    var instrCount: int64 := self.getFuncInstrCount(funcId);
    var i: int64 := 0;
    while i < instrCount {
      self.emitInstr(funcId, instrStart + i);
      i := i + 1;
    }

    self.emitEpilogue();
    self.applyPatches();
  }

  // -------------------------------------------------------------------------
  // Stack frame
  // -------------------------------------------------------------------------

  fn calcStackFrame(funcId: int64) {
    var locals: int64 := self.getFuncLocalCount(funcId);
    // Each local: 8 bytes; round up to 16-byte alignment
    var sz: int64 := locals * 8;
    if (sz & 15) != 0 {
      sz := (sz + 16) & -16;
    }
    self.stackSize := sz;
  }

  // local slot offset from x29: slot 0 → -8, slot 1 → -16, ...
  fn slotOff(slot: int64): int64 {
    return -(slot + 1) * 8;
  }

  // -------------------------------------------------------------------------
  // Prologue / Epilogue
  //
  // WP-AND-03 Bionic-ABI audit:
  //  - 16-byte SP alignment is preserved across the prologue: STP pre-decrements
  //    SP by 16, calcStackFrame rounds stackSize up to 16; SP stays 16-aligned
  //    through the function body. ARM64 ABI requirement: met.
  //  - This emitter only uses x0..x10, x29, x30. Android-reserved x18 (Bionic
  //    TLS / shadow call stack) is never touched.
  //  - No MRS/MSR system-register access; TPIDR_EL0 and other system regs are
  //    untouched.
  //  - Callee-saved regs (x19..x28) are not used, so we do not need to save them.
  //  - DWARF CFI for stack unwinding is emitted by writeELFSharedLib via the
  //    .eh_frame section using funcAddrs + funcPrologueLen records.
  // -------------------------------------------------------------------------

  fn emitPrologue() {
    // STP x29, x30, [sp, #-16]!
    self.emit32(0xA9BF7BFD);
    // MOV x29, sp  (= ADD x29, sp, #0)
    self.emit32(0x910003FD);
    // SUB sp, sp, #stackSize
    if self.stackSize > 0 {
      if self.stackSize <= 4095 {
        self.emit32(0xD10003FF | (self.stackSize << 10));
      } else {
        // Large frame: MOVZ x9, #sz; SUB sp, sp, x9
        self.emitMovImmReg(ARM64_X9, self.stackSize);
        // SUB sp, sp, x9
        self.emit32(0xCB09C3FF);  // SUB sp, sp, x9
      }
    }
  }

  fn emitEpilogue() {
    // MOV sp, x29  (= ADD sp, x29, #0)  — 0x91000000|(29<<5)|31 = 0x910003BF
    self.emit32(0x910003BF);
    // LDP x29, x30, [sp], #16
    self.emit32(0xA8C17BFD);
    // RET
    self.emit32(0xD65F03C0);
  }

  // -------------------------------------------------------------------------
  // Instruction dispatch
  // -------------------------------------------------------------------------

    // #1339: Der Dispatcher unten ist eine flache Liste aus `if op == X`
  // ohne else und ohne Default. Ein Opcode, den keine Zeile trifft, erzeugte
  // damit GAR NICHTS und verschwand lautlos aus dem Programm — bei
  // IRO_PANIC hiess das: nach einer erkannten Verletzung laeuft es weiter.
  //
  // Diese Liste nennt die Opcodes, die arm64 tatsaechlich behandelt. Sie ist
  // aus dem Dispatcher erhoben und wird gegen ihn geprueft. Weicht sie ab,
  // scheitert der Lauf LAUT — die Abweichung faellt damit beim Uebersetzen
  // auf und nicht erst im erzeugten Programm.
  fn a64_opBehandelt(op: int64): int64 {
    if (op == 167 || op == IRO_ADD || op == IRO_ALLOC || op == IRO_AND) { return 1; }
    if (op == IRO_BR_FALSE || op == IRO_BR_TRUE || op == IRO_CALL || op == IRO_CALL_BUILTIN) { return 1; }
    if (op == IRO_CALL_EXTERN || op == IRO_CALL_INDIRECT || op == IRO_CMP_EQ || op == IRO_CMP_GE) { return 1; }
    if (op == IRO_CMP_GT || op == IRO_CMP_LE || op == IRO_CMP_LT || op == IRO_CMP_NEQ) { return 1; }
    if (op == IRO_CONST_FLOAT || op == IRO_CONST_INT || op == IRO_CONST_STR || op == IRO_DIV) { return 1; }
    if (op == IRO_FADD || op == IRO_FDIV || op == IRO_FMUL || op == IRO_FNEG) { return 1; }
    if (op == IRO_FREE || op == IRO_FSQRT || op == IRO_FSUB || op == IRO_FTOI) { return 1; }
    if (op == IRO_FUNC_EXIT || op == IRO_INSPECT || op == IRO_ITOF || op == IRO_ITOP) { return 1; }
    if (op == IRO_JMP || op == IRO_LABEL || op == IRO_LOAD_FIELD || op == IRO_LOAD_GLOBAL) { return 1; }
    if (op == IRO_LOAD_IDX || op == IRO_LOAD_LOCAL || op == IRO_MOD || op == IRO_MUL) { return 1; }
    if (op == IRO_NEG || op == IRO_OR || op == IRO_PANIC || op == IRO_SHL) { return 1; }
    if (op == IRO_SHR || op == IRO_SIMD_ADD || op == IRO_SIMD_DIV || op == IRO_SIMD_MUL) { return 1; }
    if (op == IRO_SIMD_SUB || op == IRO_STORE_FIELD || op == IRO_STORE_GLOBAL || op == IRO_STORE_IDX) { return 1; }
    if (op == IRO_STORE_LOCAL || op == IRO_SUB || op == IRO_THROW || op == IRO_XOR) { return 1; }
    return 0;
  }

  fn emitInstr(funcId: int64, idx: int64) {
    var opRoh: int64 := self.getInstrOp(idx);
    if (self.a64_opBehandelt(opRoh) == 0) {
      EPrintStr("error: arm64-Backend kennt Opcode "c);
      EPrintInt(opRoh);
      EPrintStrLn(" nicht — er wuerde stillschweigend verschwinden (#1339)."c);
      EPrintStrLn("  Entweder den Opcode hier umsetzen oder ihn in ir_lower fuer dieses Ziel abweisen."c);
      exit(1);
    }

    var op:   int64 := self.getInstrOp(idx);
    var dest: int64 := self.getInstrDest(idx);
    var src1: int64 := self.getInstrSrc1(idx);
    var src2: int64 := self.getInstrSrc2(idx);
    var imm:  int64 := self.getInstrImmInt(idx);

    // --- Constants ---
    if op == IRO_CONST_INT {
      self.emitMovImmReg(ARM64_X0, imm);
      self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
    }

    if op == IRO_CONST_FLOAT {
      // Store f64 bit pattern via FMOV d0, x0
      self.emitMovImmReg(ARM64_X0, imm);
      self.emit32(0x9E670000);  // FMOV d0, x0
      self.emitFStur(ARM64_D0, ARM64_X29, self.slotOff(dest));
    }

    // --- Integer arithmetic ---
    if op == IRO_ADD { self.emitBinopRR(0x8B000000, src1, src2, dest); }
    if op == IRO_SUB { self.emitBinopRR(0xCB000000, src1, src2, dest); }
    if op == IRO_MUL { self.emitMul(src1, src2, dest); }
    if op == IRO_DIV { self.emitSdiv(src1, src2, dest); }
    if op == IRO_MOD { self.emitMod(src1, src2, dest); }
    if op == IRO_NEG { self.emitNeg(src1, dest); }

    // --- Bitwise ---
    if op == IRO_AND { self.emitBinopRR(0x8A000000, src1, src2, dest); }
    if op == IRO_OR  { self.emitBinopRR(0xAA000000, src1, src2, dest); }
    if op == IRO_XOR { self.emitBinopRR(0xCA000000, src1, src2, dest); }
    if op == IRO_SHL { self.emitShift(0, src1, src2, dest); }
    if op == IRO_SHR { self.emitShift(1, src1, src2, dest); }

    // --- Float arithmetic ---
    if op == IRO_FADD { self.emitFBinop(0x1E602800, src1, src2, dest); }
    if op == IRO_FSUB { self.emitFBinop(0x1E603800, src1, src2, dest); }
    if op == IRO_FMUL { self.emitFBinop(0x1E600800, src1, src2, dest); }
    if op == IRO_FDIV { self.emitFBinop(0x1E601800, src1, src2, dest); }
    if op == IRO_FNEG { self.emitFNeg(src1, dest); }
    if op == IRO_FSQRT { self.emitFSqrt(src1, dest); }

    // --- Comparisons ---
    if op == IRO_CMP_EQ  { self.emitCmp(0, src1, src2, dest); }
    if op == IRO_CMP_NEQ { self.emitCmp(1, src1, src2, dest); }
    if op == IRO_CMP_LT  { self.emitCmp(2, src1, src2, dest); }
    if op == IRO_CMP_LE  { self.emitCmp(3, src1, src2, dest); }
    if op == IRO_CMP_GT  { self.emitCmp(4, src1, src2, dest); }
    if op == IRO_CMP_GE  { self.emitCmp(5, src1, src2, dest); }

    // --- Memory ---
    if op == IRO_LOAD_LOCAL  { self.emitLoadLocal(src1, dest); }
    if op == IRO_STORE_LOCAL { self.emitStoreLocal(src1, dest); }
    if op == IRO_LOAD_GLOBAL  { self.emitLoadGlobal(src1, dest); }
    if op == IRO_STORE_GLOBAL { self.emitStoreGlobal(src1, dest); }

    // --- Pointer / struct ---
    if op == IRO_LOAD_FIELD  { self.emitLoadField(src1, src2, dest); }
    if op == IRO_STORE_FIELD { self.emitStoreField(src1, src2, dest); }
    if op == IRO_LOAD_IDX    { self.emitLoadIdx(src1, src2, dest); }
    if op == IRO_STORE_IDX   { self.emitStoreIdx(src1, src2, dest); }

    // --- Calls ---
    if op == IRO_CALL         { self.emitCall(src1, src2, imm, dest); }
    if op == IRO_CALL_BUILTIN { self.emitBuiltinCall(imm, dest); }
    if op == IRO_CALL_INDIRECT { self.emitCallIndirect(src1, imm, dest); }
    if op == IRO_CALL_EXTERN  { self.emitCallExtern(src1, src2, imm, dest); }
    if op == IRO_CONST_STR    { self.emitConstStr(imm, dest); }

    // --- Control flow ---
    if op == IRO_JMP      { self.emitBranch(imm); }
    if op == IRO_BR_TRUE  { self.emitBranchCond(src1, imm, 1); }
    if op == IRO_BR_FALSE { self.emitBranchCond(src1, imm, 0); }
    if op == IRO_LABEL    { self.emitLabelDef(imm); }
    if op == IRO_FUNC_EXIT { self.emitEpilogue(); }

    // --- Alloc ---
    if op == IRO_ALLOC { self.emitAlloc(src1, dest); }
    if op == IRO_FREE  { self.emitFree(src1); }

    // --- Type conversions ---
    if op == IRO_ITOF { self.emitItof(src1, dest); }
    if op == IRO_FTOI { self.emitFtoi(src1, dest); }
    if op == IRO_ITOP { self.emitLoadSlot(src1, dest); }

    // --- SIMD (NEON) ---
    if op == IRO_SIMD_ADD { self.emitNeon(0x4E608400, src1, src2, dest); }
    if op == IRO_SIMD_SUB { self.emitNeon(0x4EE08400, src1, src2, dest); }
    if op == IRO_SIMD_MUL { self.emitNeon(0x6E609C00, src1, src2, dest); }
    if op == IRO_SIMD_DIV { self.emitNeon(0x6E60FC00, src1, src2, dest); }

    // --- Debug ---
    if op == IRO_INSPECT { self.emitInspect(src1, idx); }

    // #1281: IRO_THROW → exit(1). Fangen kann ihn hier niemand, denn ir_lower
    // weist try/catch fuer dieses Ziel ab; ein unbehandelter throw beendet das
    // Programm mit 1, wie im x86-Pfad ohne installierten Handler. Bis 1.0.16G
    // erzeugte `throw` fuer dieses Backend gar nichts und war ein No-op.
    if op == IRO_THROW {
      self.emitMovImmReg(ARM64_X0, 1);
      self.emitMovImmReg(ARM64_X8, SYS_EXIT);
      self.emit32(0xD4000001);  // SVC #0
    }

    // --- WSP-05: Inline-Assembly (imm = arch-Mnemonic-Id aus ir_lower ARM64-Tabelle) ---
    // #1339: IRO_PANIC (121) fehlte — `panic("...")` war ein No-op, das Programm
    // lief nach der erkannten Verletzung weiter. Verhalten wie IRO_THROW.
    if op == IRO_PANIC {
      self.emitMovImmReg(ARM64_X0, 1);
      self.emitMovImmReg(ARM64_X8, SYS_EXIT);
      self.emit32(0xD4000001);  // SVC #0
    }

    if op == 167 {
      if      imm == 0  { self.emit32(0xD503201F); }  // nop
      else if imm == 1  { self.emit32(0xD503207F); }  // wfi
      else if imm == 2  { self.emit32(0xD503205F); }  // wfe
      else if imm == 3  { self.emit32(0xD503209F); }  // sev
      else if imm == 4  { self.emit32(0xD50320BF); }  // sevl
      else if imm == 5  { self.emit32(0xD503203F); }  // yield
      else if imm == 6  { self.emit32(0xD5033FDF); }  // isb (sy)
      else if imm == 7  { self.emit32(0xD5033F9F); }  // dsb sy
      else if imm == 8  { self.emit32(0xD5033FBF); }  // dmb sy
      else if imm == 9  { self.emit32(0xD4000001); }  // svc #0
      else if imm == 10 { self.emit32(0xD4200000); }  // brk #0
      else if imm == 11 { self.emit32(0xD4400000); }  // hlt #0
      else if imm == 12 { self.emit32(0xD65F03C0); }  // ret
      else if imm == 13 { self.emit32(0xD69F03E0); }  // eret
      else              { self.emit32(0xD4200000); }  // fail-closed: brk #0 (unerreichbar, ir_lower validiert)
    }
  }

  // -------------------------------------------------------------------------
  // Integer arithmetic helpers
  // -------------------------------------------------------------------------

  // Generic 3-reg: opc | (Rm<<16) | (Rn<<5) | Rd  using x0=src1, x1=src2 → x0
  fn emitBinopRR(opc: int64, src1: int64, src2: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(src2));
    // opc encodes ADD/SUB/AND/ORR/EOR with Rm=x1(1), Rn=x0(0), Rd=x0(0)
    self.emit32(opc | (ARM64_X1 << 16) | (ARM64_X0 << 5) | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitMul(src1: int64, src2: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(src2));
    // MUL x0, x0, x1  (= MADD x0, x0, x1, xzr)
    self.emit32(0x9B007C00 | (ARM64_X1 << 16) | (ARM64_X0 << 5) | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitSdiv(src1: int64, src2: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(src2));
    // SDIV x0, x0, x1
    self.emit32(0x9AC00C00 | (ARM64_X1 << 16) | (ARM64_X0 << 5) | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitMod(src1: int64, src2: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(src2));
    // SDIV x2, x0, x1   ; x2 = x0 / x1
    self.emit32(0x9AC00C00 | (ARM64_X1 << 16) | (ARM64_X0 << 5) | ARM64_X2);
    // MSUB x0, x2, x1, x0  ; x0 = x0 - x2*x1
    self.emit32(0x9B018000 | (ARM64_X1 << 16) | (ARM64_X0 << 10) | (ARM64_X2 << 5) | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitNeg(src1: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
    // NEG x0, x0  (= SUB x0, xzr, x0)
    self.emit32(0xCB0003E0 | (ARM64_X0 << 16) | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitShift(isRight: int64, src1: int64, src2: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(src2));
    if isRight == 0 {
      // LSLV x0, x0, x1
      self.emit32(0x9AC02000 | (ARM64_X1 << 16) | (ARM64_X0 << 5) | ARM64_X0);
    } else {
      // ASRV x0, x0, x1
      self.emit32(0x9AC02800 | (ARM64_X1 << 16) | (ARM64_X0 << 5) | ARM64_X0);
    }
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // -------------------------------------------------------------------------
  // Float arithmetic helpers
  // -------------------------------------------------------------------------

  // base encodes FADD/FSUB/FMUL/FDIV with Rm=d1, Rn=d0, Rd=d0
  fn emitFBinop(base: int64, src1: int64, src2: int64, dest: int64) {
    self.emitFLdur(ARM64_D0, ARM64_X29, self.slotOff(src1));
    self.emitFLdur(ARM64_D1, ARM64_X29, self.slotOff(src2));
    self.emit32(base | (ARM64_D1 << 16) | (ARM64_D0 << 5) | ARM64_D0);
    self.emitFStur(ARM64_D0, ARM64_X29, self.slotOff(dest));
  }

  fn emitFNeg(src1: int64, dest: int64) {
    self.emitFLdur(ARM64_D0, ARM64_X29, self.slotOff(src1));
    // FNEG d0, d0  (scalar double)
    self.emit32(0x1E614000 | (ARM64_D0 << 5) | ARM64_D0);
    self.emitFStur(ARM64_D0, ARM64_X29, self.slotOff(dest));
  }

  fn emitFSqrt(src1: int64, dest: int64) {
    self.emitFLdur(ARM64_D0, ARM64_X29, self.slotOff(src1));
    // FSQRT d0, d0
    self.emit32(0x1E61C000 | (ARM64_D0 << 5) | ARM64_D0);
    self.emitFStur(ARM64_D0, ARM64_X29, self.slotOff(dest));
  }

  // -------------------------------------------------------------------------
  // Comparison
  // -------------------------------------------------------------------------
  // kind: 0=EQ, 1=NE, 2=LT, 3=LE, 4=GT, 5=GE

  fn emitCmp(kind: int64, src1: int64, src2: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src1));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(src2));
    // SUBS xzr, x0, x1  (sets flags)
    self.emit32(0xEB01001F | (ARM64_X1 << 16) | (ARM64_X0 << 5));
    // CSET x0, cond  (= CSINC x0, xzr, xzr, ~cond)
    var cset: int64 := self.csetEnc(kind);
    self.emit32(cset);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn csetEnc(kind: int64): int64 {
    // CSET Xd, cond = CSINC Xd, XZR, XZR, ~cond
    // Encoding: 0x9A9F07E0 | ((~cond & 0xF) << 12) | Rd
    // Conditions: EQ=0, NE=1, LT=0xB, LE=0xD, GT=0xC, GE=0xA
    var invCond: int64 := 0;
    if kind == 0 { invCond := 1; }   // EQ → ~NE → invert=NE(1)
    if kind == 1 { invCond := 0; }   // NE → ~EQ → invert=EQ(0)
    if kind == 2 { invCond := 10; }  // LT → ~GE(10) = invCond=0xA
    if kind == 3 { invCond := 12; }  // LE → ~GT(12) = invCond=0xC
    if kind == 4 { invCond := 13; }  // GT → ~LE(13) = invCond=0xD
    if kind == 5 { invCond := 11; }  // GE → ~LT(11) = invCond=0xB
    return 0x9A9F07E0 | ((invCond & 15) << 12) | ARM64_X0;
  }

  // -------------------------------------------------------------------------
  // Memory: local slot load/store (LDUR/STUR with simm9)
  // -------------------------------------------------------------------------

  fn emitLoadLocal(src: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitStoreLocal(src: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitLoadSlot(src: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitLoadGlobal(addr: int64, dest: int64) {
    // IRO_LOAD_GLOBAL trägt einen globalIdx (NICHT eine VA). Beide Modi (shared-lib UND
    // static) emittieren eine literal-pool-Sequenz mit Platzhalter-Slot und merken sich
    // (slotOff, globalIdx) in globalRelocBuf. writeELFSharedLib bäckt + R_AARCH64_RELATIVE;
    // writeELF (static) bäckt die absolute VA direkt (file-offset==vaddr, fixer Lade-Offset).
    // ARM64-FIX: vorher MOVte der static-Pfad globalIdx als VA → LDR [0] → SIGSEGV.
    var slotOff: int64 := self.codeLen + 8;
    self.emit32(0x58000040 | 9);     // LDR x9, [pc+8]
    self.emit32(0x14000003);         // B +12
    self.emit64(0);                   // placeholder slot (gebacken in writeELF*)
    self.emit32(0xF9400120 | ARM64_X0);  // LDR x0, [x9]
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
    self._recordGlobalReloc(slotOff, addr);
  }

  // Merkt (slotCodeOff, globalIdx) für späteres Backen durch writeELF*/writeELFSharedLib.
  fn _recordGlobalReloc(slotOff: int64, gIdx: int64) {
    if (self.globalRelocCount >= self.globalRelocCap) {
      var newCap: int64 := self.globalRelocCap * 2;
      var nb: int64 := alloc(newCap * 16);
      var i: int64 := 0;
      while i < self.globalRelocCount * 16 {
        poke8(nb + i, peek8(self.globalRelocBuf + i));
        i := i + 1;
      }
      self.globalRelocBuf := nb;
      self.globalRelocCap := newCap;
    }
    var rec: int64 := self.globalRelocBuf + self.globalRelocCount * 16;
    poke64(rec + 0, slotOff);
    poke64(rec + 8, gIdx);
    self.globalRelocCount := self.globalRelocCount + 1;
  }

  fn emitStoreGlobal(src: int64, addr: int64) {
    if self.isSharedLib != 0 {
      self._emitStoreGlobalPIC(src, addr);
      return;
    }
    // ARM64-FIX (static): literal-pool-Slot (gIdx-Platzhalter) → writeELF bäckt VA.
    // Vorher MOVte addr(=gIdx) als VA → STR [0] → SIGSEGV.
    var slotOff: int64 := self.codeLen + 8;
    self.emit32(0x58000040 | 9);     // LDR x9, [pc+8]  (Adresse aus Slot)
    self.emit32(0x14000003);         // B +12  (über .quad)
    self.emit64(0);                   // placeholder slot (gebacken in writeELF)
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));  // x0 = value
    self.emit32(0xF9000120);          // STR x0, [x9]
    self._recordGlobalReloc(slotOff, addr);
  }

  // WP-AND-02 Phase C: PIC-friendly global load using an inline literal pool.
  // Layout (24 bytes total, identical size to the MOVZ/MOVK variant):
  //   +0  LDR x9, [pc + 8]   ; loads the 8-byte slot at +8
  //   +4  B  +12             ; jump past the slot
  //   +8  .quad <addr>       ; slot, patched by R_AARCH64_RELATIVE at load time
  //  +16  LDR x0, [x9]       ; dereference
  //  +20  STUR x0, [fp, -slot]
  fn _emitLoadGlobalPIC(addr: int64, dest: int64) {
    var slotOff: int64 := self.codeLen + 8;   // slot's offset within codeBuf
    // LDR x9 (=9), literal at +8: imm19 = 2 → 2<<5 = 0x40
    self.emit32(0x58000040 | 9);
    // B +12 (3 instructions ahead): imm26 = 3
    self.emit32(0x14000003);
    // 8-byte slot for the resolved address. The dynamic loader rewrites this
    // to (load_base + addend) via R_AARCH64_RELATIVE; we store `addr` as the
    // addend AND as the initial slot value (the loader overwrites anyway).
    self.emit64(addr);
    self._recordRelocation(slotOff, 1027, addr);  // 1027 = R_AARCH64_RELATIVE
    // LDR x0, [x9]
    self.emit32(0xF9400120 | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn _emitStoreGlobalPIC(src: int64, addr: int64) {
    var slotOff: int64 := self.codeLen + 8;
    self.emit32(0x58000040 | 9);    // LDR x9, [pc+8]
    self.emit32(0x14000003);        // B +12
    self.emit64(addr);
    self._recordRelocation(slotOff, 1027, addr);
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));
    // STR x0, [x9]
    self.emit32(0xF9000120);
  }

  fn emitLoadField(base: int64, fieldOff: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(base));
    // LDR x0, [x0, #fieldOff]  (scaled, fieldOff must be 0..32760, 8-byte aligned)
    var enc: int64 := 0xF9400000 | (((fieldOff >> 3) & 4095) << 10) | (ARM64_X0 << 5) | ARM64_X0;
    self.emit32(enc);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitStoreField(src: int64, base: int64, fieldOff: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(base));
    // STR x0, [x1, #fieldOff]
    var enc: int64 := 0xF9000000 | (((fieldOff >> 3) & 4095) << 10) | (ARM64_X1 << 5) | ARM64_X0;
    self.emit32(enc);
  }

  fn emitLoadIdx(base: int64, idx: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(base));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(idx));
    // LDR x0, [x0, x1, LSL #3]
    self.emit32(0xF8617800 | (ARM64_X1 << 16) | (ARM64_X0 << 5) | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitStoreIdx(src: int64, base: int64, idx: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(base));
    self.emitLdur(ARM64_X2, ARM64_X29, self.slotOff(idx));
    // STR x0, [x1, x2, LSL #3]
    self.emit32(0xF8227800 | (ARM64_X2 << 16) | (ARM64_X1 << 5) | ARM64_X0);
  }

  // -------------------------------------------------------------------------
  // Function calls
  // -------------------------------------------------------------------------

  fn emitCall(funcId: int64, argBase: int64, argCount: int64, dest: int64) {
    // ARM64-FIX: Args liegen im reservierten Block argBase..argBase+N-1 (NICHT 0..N-1,
    // die die Caller-Params aliasen würden). Lade argBase+ai → x[ai].
    var ai: int64 := 0;
    while ai < argCount && ai < 8 {
      self.emitLdur(ai, ARM64_X29, self.slotOff(argBase + ai));
      ai := ai + 1;
    }
    // BL funcId  — record patch
    var patchOff: int64 := self.codeLen;
    self.emit32(0x94000000);  // placeholder BL
    self.addPatch(patchOff, funcId, PATCH_BL, 0);
    // Move result from x0 to dest slot
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // Indirect call. Args follow the same convention as emitCall: caller stores
  // args 0..argCount-1 in stack slots 0..argCount-1, this routine loads them
  // into x0..x7 per AAPCS64 before branching through x9.
  fn emitCallIndirect(ptrSlot: int64, argCount: int64, dest: int64) {
    var ai: int64 := 0;
    while ai < argCount && ai < 8 {
      self.emitLdur(ai, ARM64_X29, self.slotOff(ai));
      ai := ai + 1;
    }
    self.emitLdur(ARM64_X9, ARM64_X29, self.slotOff(ptrSlot));
    // BLR x9
    self.emit32(0xD63F0120);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // FFI call (IRO_CALL_EXTERN). Args 0..argCount-1 → x0..x7, then load the
  // resolved function address from an inline GOT slot the loader fills via
  // R_AARCH64_GLOB_DAT, and BLR. nameStrOff/libStrOff index the IR string
  // table; the symbol is deduped into externBuf (dynsym index = idx+1).
  fn emitCallExtern(argCount: int64, libStrOff: int64, nameStrOff: int64, dest: int64) {
    var ai: int64 := 0;
    while ai < argCount && ai < 8 {
      self.emitLdur(ai, ARM64_X29, self.slotOff(ai));
      ai := ai + 1;
    }
    var strBuf: int64 := peek64(self.ir + 32);
    var namePtr: int64 := strBuf + nameStrOff;
    var nameLen: int64 := StrLen(namePtr as pchar);
    // Dedup by name.
    var externIdx: int64 := -1;
    var ei: int64 := 0;
    while ei < self.externCount {
      var eb: int64 := self.externBuf + ei * 32;
      if peek64(eb + 8) == nameLen {
        var em: int64 := 1;
        var ej: int64 := 0;
        while ej < nameLen {
          if em != 0 {
            if peek8(strBuf + peek64(eb) + ej) != peek8(namePtr + ej) { em := 0; }
          }
          ej := ej + 1;
        }
        if em != 0 { externIdx := ei; ei := self.externCount; }
      }
      ei := ei + 1;
    }
    if externIdx < 0 {
      var libPtr: int64 := strBuf + libStrOff;
      var libLen: int64 := StrLen(libPtr as pchar);
      if self.externCount >= self.externCap {
        var nc: int64 := self.externCap * 2;
        var nb: int64 := alloc(nc * 32);
        var ci: int64 := 0;
        while ci < self.externCount * 32 { poke8(nb + ci, peek8(self.externBuf + ci)); ci := ci + 1; }
        self.externBuf := nb; self.externCap := nc;
      }
      var nbase: int64 := self.externBuf + self.externCount * 32;
      poke64(nbase,      nameStrOff);
      poke64(nbase + 8,  nameLen);
      poke64(nbase + 16, libStrOff);
      poke64(nbase + 24, libLen);
      externIdx := self.externCount;
      self.externCount := self.externCount + 1;
    }
    // Inline GOT slot: LDR x9,[pc+8]; B +12; .quad 0; BLR x9
    // ld.so writes the resolved symbol address into the .quad (GLOB_DAT).
    var slotOff: int64 := self.codeLen + 8;
    self.emit32(0x58000040 | 9);    // LDR x9, [pc+8]
    self.emit32(0x14000003);        // B +12
    self.emit64(0);                  // GOT slot (filled by loader)
    self._recordRelocation(slotOff, ((externIdx + 1) << 32) | 1025, 0);  // R_AARCH64_GLOB_DAT
    self.emit32(0xD63F0120);        // BLR x9
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // IRO_CONST_STR: load the runtime address of a string literal into `dest`.
  // The string bytes are embedded inline in the code stream (jumped over by a
  // B) and addressed PC-relatively with ADR — no data section, relocation or
  // patching needed, which keeps this self-contained and works in the static
  // ELF. `strOff` indexes the IR string table (null-terminated).
  fn emitConstStr(strOff: int64, dest: int64) {
    var strBuf: int64 := peek64(self.ir + 32);
    var sp: int64 := strBuf + strOff;
    var len: int64 := StrLen(sp as pchar);
    var total: int64 := len + 1;                 // include NUL
    var pad: int64 := (4 - (total & 3)) & 3;     // pad to 4-byte boundary
    var padded: int64 := total + pad;
    // ADR x0, #8  — the string begins 8 bytes (ADR + B) after this ADR.
    self.emit32(0x10000040);
    // B over the inline string: (4 + padded) bytes ahead of this B.
    self.emit32(0x14000000 | ((4 + padded) >> 2));
    // inline string bytes + NUL + padding
    var i: int64 := 0;
    while i < len { self.emit8(peek8(sp + i)); i := i + 1; }
    self.emit8(0);
    var p: int64 := 0;
    while p < pad { self.emit8(0); p := p + 1; }
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitBuiltinCall(id: int64, dest: int64) {
    // WP-D2: Windows mode — emit BL placeholder to helper stubs instead of syscalls
    if self.winMode != 0 {
      if id == 1 {
        // PrintStr: x0=str, x1=len → wab_printstr helper
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(1));
        self.addWinPatch(self.codeLen, 1);
        self.emit32(0x94000000);  // BL placeholder
      } else if id == 2 {
        // PrintInt: x0=int64 → wab_printint helper
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.addWinPatch(self.codeLen, 2);
        self.emit32(0x94000000);
      } else if id == 3 {
        // Exit: x0=exitcode → wab_exit helper (calls ExitProcess)
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.addWinPatch(self.codeLen, 3);
        self.emit32(0x94000000);
      } else if id == 6 {
        // WP-01: StrSub(s, start, len) → wab_strsub helper
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(1));
        self.emitLdur(ARM64_X2, ARM64_X29, self.slotOff(2));
        self.addWinPatch(self.codeLen, 6);
        self.emit32(0x94000000);
      } else if id == 7 {
        // WP-01: StrConcat(a, b) → wab_strconcat helper
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(1));
        self.addWinPatch(self.codeLen, 7);
        self.emit32(0x94000000);
      } else if id == 8 {
        // WP-01: StrCopy(s) → wab_strcopy helper
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.addWinPatch(self.codeLen, 8);
        self.emit32(0x94000000);
      } else if id == 9 {
        // WP-08: PrintFloat(f64) → wab_printf helper (int decomp via wab_printint/wab_printstr)
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.addWinPatch(self.codeLen, 9);
        self.emit32(0x94000000);
      } else if id == 12 {
        // WP-08: Printf(fmt, a1, a2, a3) → wab_printf_full helper.
        // #1037: vorher id=10 — dieselbe Nummer wie mem_barrier(), das damit
        // hier im Printf-Helfer landete. Der Helfer-Index bleibt 10, nur die
        // Builtin-ID wandert auf 12.
        self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
        self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(1));
        self.emitLdur(ARM64_X2, ARM64_X29, self.slotOff(2));
        self.emitLdur(ARM64_X3, ARM64_X29, self.slotOff(3));
        self.addWinPatch(self.codeLen, 10);
        self.emit32(0x94000000);
      } else if id == 10 || id == 11 {
        // WP-GPIO-1: mem_barrier()/inst_barrier(). Auf Windows-ARM64 gibt es
        // keine Barrieren-Emission; ausdruecklich als No-op fuehren, statt in
        // den Fehlerzweig zu fallen.
      } else {
        self._builtinUnsupported(id, 1);
      }
      self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
      return;
    }
    // Linux path — emit inline syscalls
    if id == 1 {
      // PrintStr: write(1, x0, x1)  — args already in x0,x1 by convention
      self.emitMovImmReg(ARM64_X0, 1);   // fd=stdout
      // x1=buf, x2=len come from caller convention — load from slots 0,1
      self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(0));
      self.emitLdur(ARM64_X2, ARM64_X29, self.slotOff(1));
      self.emitMovImmReg(ARM64_X8, SYS_WRITE);
      self.emit32(0xD4000001);  // SVC #0
    } else if id == 2 {
      // PrintInt(n): int64 → Dezimal-ASCII nach stdout, OHNE Newline (PrintIntLn macht \n).
      // ARM64-FIX: vorher write(x0=intwert, müll, müll) → EBADF, leer. Jetzt inline itoa+write
      // (gespiegelt von der inspect-Routine; fd=1=stdout statt 2, Länge ohne '\n' = sp+31).
      // Wert kommt in slot0 (PrintInt-Lowering: STORE_LOCAL 0). 32-Byte-Stack-Buffer:
      // x9=write_ptr, x10=value, x11=neg, x12=10, x13=quot, x14=digit.
      // Identische Instr-Anzahl/-Layout wie inspect-itoa (Branch-Offsets bleiben gültig);
      // NUR instr28 (Ende sp+31 statt +32 → '\n' ausgeschlossen) + instr31 (fd=1) geändert.
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));  // x0 = value
      self.emit32(0xD10083FF);  // instr0: SUB sp,sp,#32
      self.emit32(0x91007BE9);  // instr1: ADD x9,sp,#30
      self.emit32(0x5280014A);  // instr2: MOVZ w10,#10  ('\n' in Buffer, NICHT ausgegeben)
      self.emit32(0x39007FEA);  // instr3: STRB w10,[sp,#31]
      self.emit32(0xAA0003EA);  // instr4: MOV x10,x0
      self.emit32(0xD280000B);  // instr5: MOVZ x11,#0
      self.emit32(0xB400024A);  // instr6: CBZ x10,+18 (→ instr24 ZERO_CASE)
      self.emit32(0xF100015F);  // instr7: CMP x10,#0
      self.emit32(0x5400006A);  // instr8: B.GE +3 (→ instr11 POS_LOOP)
      self.emit32(0xCB0A03EA);  // instr9: NEG x10,x10
      self.emit32(0xD280002B);  // instr10: MOVZ x11,#1
      self.emit32(0xD280014C);  // instr11: [POS_LOOP] MOVZ x12,#10
      self.emit32(0x9ACC094D);  // instr12: UDIV x13,x10,x12
      self.emit32(0x9B0CA9AE);  // instr13: MSUB x14,x13,x12,x10
      self.emit32(0x1100C1CE);  // instr14: ADD w14,w14,#48
      self.emit32(0x3900012E);  // instr15: STRB w14,[x9]
      self.emit32(0xD1000529);  // instr16: SUB x9,x9,#1
      self.emit32(0xAA0D03EA);  // instr17: MOV x10,x13
      self.emit32(0xB5FFFF2A);  // instr18: CBNZ x10,-7 (→ instr11)
      self.emit32(0xB400008B);  // instr19: CBZ x11,+4 (→ instr23)
      self.emit32(0x528005AE);  // instr20: MOVZ w14,#45 ('-')
      self.emit32(0x3900012E);  // instr21: STRB w14,[x9]
      self.emit32(0xD1000529);  // instr22: SUB x9,x9,#1
      self.emit32(0x14000004);  // instr23: B +4 (→ instr27 EMIT_OUT)
      self.emit32(0x5280060E);  // instr24: [ZERO_CASE] MOVZ w14,#48 ('0')
      self.emit32(0x3900012E);  // instr25: STRB w14,[x9]
      self.emit32(0xD1000529);  // instr26: SUB x9,x9,#1
      self.emit32(0x91000529);  // instr27: [EMIT_OUT] ADD x9,x9,#1
      self.emit32(0x91007FEA);  // instr28: ADD x10,sp,#31  (Ende OHNE '\n')
      self.emit32(0xCB090142);  // instr29: SUB x2,x10,x9  (len)
      self.emit32(0xAA0903E1);  // instr30: MOV x1,x9
      self.emit32(0xD2800020);  // instr31: MOVZ x0,#1  (fd=stdout)
      self.emit32(0xD2800808);  // instr32: MOVZ x8,#64 (SYS_WRITE)
      self.emit32(0xD4000001);  // instr33: SVC #0
      self.emit32(0x910083FF);  // instr34: ADD sp,sp,#32
    } else if id == 3 {
      // Exit
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
      self.emitMovImmReg(ARM64_X8, SYS_EXIT);
      self.emit32(0xD4000001);
    } else if id == 10 {
      // WP-GPIO-1: mem_barrier() → DMB SY
      // Encoding: D5 03 3F BF (little-endian uint32 = 0xBF3F03D5)
      self.emit32(0xBF3F03D5);
    } else if id == 11 {
      // WP-GPIO-1: inst_barrier() → ISB SY
      // Encoding: D5 03 3F DF (little-endian uint32 = 0xDF3F03D5)
      self.emit32(0xDF3F03D5);
    } else if id == 9 {
      // WP-08: PrintFloat — Linux ARM64 fallback (load float bits, no-op print)
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(0));
    } else {
      // #1037: bis hierher fiel jede nicht behandelte ID STILL durch — es wurde
      // kein Code erzeugt, keine Meldung ausgegeben. Genau so verschwand Printf
      // (id 12) auf Linux-ARM64 spurlos, nachdem es vorher den Barrieren-Handler
      // getroffen hatte.
      self._builtinUnsupported(id, 0);
    }
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // #1037: unbehandelte Builtin-ID laut melden statt still nichts zu erzeugen.
  // winMode: 1 = Windows-Zweig, 0 = Linux-Zweig.
  fn _builtinUnsupported(id: int64, isWin: int64) {
    EPrintStr("error: arm64: Builtin-ID "c);
    EPrintInt(id);
    if isWin != 0 { EPrintStr(" wird im Windows-Zweig nicht behandelt"c); }
    else          { EPrintStr(" wird im Linux-Zweig nicht behandelt"c); }
    EPrintStrLn(""c);
    EPrintStrLn("  Die IDs sind ein globaler Namensraum ueber alle Backends."c);
    EPrintStrLn("  Vergabe und Belegung stehen in src/backend/_builtin_ids.md."c);
    exit(1);
  }

  // -------------------------------------------------------------------------
  // Branches and labels
  // -------------------------------------------------------------------------

  fn emitLabelDef(labelId: int64) {
    if labelId < 1024 {
      poke64(self.labelAddrs + labelId * 8, self.codeLen);
    }
  }

  fn emitBranch(labelId: int64) {
    var off: int64 := self.codeLen;
    self.emit32(0x14000000);  // B placeholder
    self.addPatch(off, labelId, PATCH_B, 0);
  }

  // kind=1 → branch if slot!=0 (CBNZ), kind=0 → branch if slot==0 (CBZ)
  fn emitBranchCond(condSlot: int64, labelId: int64, kind: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(condSlot));
    var off: int64 := self.codeLen;
    if kind == 1 {
      self.emit32(0xB5000000);  // CBNZ x0, placeholder
      self.addPatch(off, labelId, PATCH_CBNZ, ARM64_X0);
    } else {
      self.emit32(0xB4000000);  // CBZ x0, placeholder
      self.addPatch(off, labelId, PATCH_CBZ, ARM64_X0);
    }
  }

  fn addPatch(codeOff: int64, labelId: int64, ptype: int64, reg: int64) {
    if self.patchCount < 1024 {
      var base: int64 := self.patchBuf + self.patchCount * 32;
      poke64(base,      codeOff);
      poke64(base + 8,  labelId);
      poke64(base + 16, ptype);
      poke64(base + 24, reg);
      self.patchCount := self.patchCount + 1;
    }
  }

  fn applyPatches() {
    var i: int64 := 0;
    while i < self.patchCount {
      var base:    int64 := self.patchBuf + i * 32;
      var labelId: int64 := peek64(base + 8);
      // WP-AND-upstream-fix v9: -2 = already patched, skip.
      if labelId != -2 {
        var codeOff: int64 := peek64(base);
        var ptype:   int64 := peek64(base + 16);
        var reg:     int64 := peek64(base + 24);

        // Use -1 sentinel for "unset" because funcAddrs / labelAddrs are
        // mmap-zero so entry 0 is a legitimate address. Resolution depends
        // on the pre-init pass in calcStackFrame for labelAddrs and on the
        // funcAddrs writes in emitFunc.
        var target: int64 := -1;
        if ptype == PATCH_BL {
          if labelId < 256 {
            target := peek64(self.funcAddrs + labelId * 8);
            // A funcAddrs[i] of 0 is valid only for the FIRST emitted
            // function (labelId 0). Any other 0 means "not yet emitted".
            if target == 0 {
              if labelId != 0 { target := -1; }
            }
          }
        } else {
          if labelId < 1024 {
            target := peek64(self.labelAddrs + labelId * 8);
          }
        }

        if target >= 0 {
          var delta: int64 := (target - codeOff) >> 2;
          if ptype == PATCH_B || ptype == PATCH_BL {
            var opc: int64 := 0x14000000;
            if ptype == PATCH_BL { opc := 0x94000000; }
            var enc: int64 := opc | (delta & 0x3FFFFFF);
            self.poke32at(codeOff, enc);
          } else if ptype == PATCH_CBZ {
            var enc: int64 := 0xB4000000 | ((delta & 0x7FFFF) << 5) | reg;
            self.poke32at(codeOff, enc);
          } else if ptype == PATCH_CBNZ {
            var enc: int64 := 0xB5000000 | ((delta & 0x7FFFF) << 5) | reg;
            self.poke32at(codeOff, enc);
          }
          // Mark as resolved so a later applyPatches call skips it.
          poke64(base + 8, -2);
        }
      }
      i := i + 1;
    }
  }

  // -------------------------------------------------------------------------
  // Allocation
  // -------------------------------------------------------------------------

  fn emitAlloc(sizeSlot: int64, dest: int64) {
    // WP-D2: Windows mode — call wab_alloc helper (VirtualAlloc)
    if self.winMode != 0 {
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(sizeSlot));
      self.addWinPatch(self.codeLen, 4);
      self.emit32(0x94000000);  // BL placeholder → wab_alloc
      self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
      return;
    }
    // Linux: mmap(0, size, PROT_RW=3, MAP_PRIVATE|MAP_ANON=34, -1, 0)
    self.emitMovImmReg(ARM64_X0, 0);   // addr=0
    self.emitLdur(ARM64_X1, ARM64_X29, self.slotOff(sizeSlot));
    self.emitMovImmReg(ARM64_X2, 3);   // PROT_READ|PROT_WRITE
    self.emitMovImmReg(ARM64_X3, 34);  // MAP_PRIVATE|MAP_ANON
    self.emitMovImmReg(ARM64_X4, -1);  // fd=-1
    self.emitMovImmReg(ARM64_X5, 0);   // offset=0
    self.emitMovImmReg(ARM64_X8, SYS_MMAP);
    self.emit32(0xD4000001);           // SVC #0
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  fn emitFree(ptrSlot: int64) {
    // WP-D2: Windows mode — call wab_free helper (VirtualFree)
    if self.winMode != 0 {
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(ptrSlot));
      self.addWinPatch(self.codeLen, 5);
      self.emit32(0x94000000);  // BL placeholder → wab_free
      return;
    }
    // Linux: munmap
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(ptrSlot));
    self.emitMovImmReg(ARM64_X1, 0);
    self.emitMovImmReg(ARM64_X8, SYS_MUNMAP);
    self.emit32(0xD4000001);
  }

  // -------------------------------------------------------------------------
  // Type conversions
  // -------------------------------------------------------------------------

  fn emitItof(src: int64, dest: int64) {
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(src));
    // SCVTF d0, x0  (int64 → double)
    self.emit32(0x9E620000 | (ARM64_X0 << 5) | ARM64_D0);
    self.emitFStur(ARM64_D0, ARM64_X29, self.slotOff(dest));
  }

  fn emitFtoi(src: int64, dest: int64) {
    self.emitFLdur(ARM64_D0, ARM64_X29, self.slotOff(src));
    // FCVTZS x0, d0  (double → int64, round to zero)
    self.emit32(0x9E780000 | (ARM64_D0 << 5) | ARM64_X0);
    self.emitStur(ARM64_X0, ARM64_X29, self.slotOff(dest));
  }

  // -------------------------------------------------------------------------
  // NEON SIMD
  // -------------------------------------------------------------------------

  fn emitNeon(base: int64, src1: int64, src2: int64, dest: int64) {
    // Use v0.2d and v1.2d as scratch SIMD regs, result in v0.2d
    self.emitFLdur(ARM64_D0, ARM64_X29, self.slotOff(src1));
    self.emitFLdur(ARM64_D1, ARM64_X29, self.slotOff(src2));
    self.emit32(base | (1 << 16) | (0 << 5) | 0);
    self.emitFStur(ARM64_D0, ARM64_X29, self.slotOff(dest));
  }

  // -------------------------------------------------------------------------
  // Low-level LDUR/STUR (simm9: -256..255)
  // -------------------------------------------------------------------------

  fn emitLdur(rt: int64, rn: int64, off: int64) {
    // LDUR Xt, [Xn, #simm9]
    // 1111 1000 010 imm9 00 Rn Rt
    self.emit32(0xF8400000 | ((off & 0x1FF) << 12) | (rn << 5) | rt);
  }

  fn emitStur(rt: int64, rn: int64, off: int64) {
    // STUR Xt, [Xn, #simm9]
    self.emit32(0xF8000000 | ((off & 0x1FF) << 12) | (rn << 5) | rt);
  }

  fn emitFLdur(rt: int64, rn: int64, off: int64) {
    // LDUR Dt, [Xn, #simm9]  (64-bit FP/SIMD)
    self.emit32(0xFC400000 | ((off & 0x1FF) << 12) | (rn << 5) | rt);
  }

  fn emitFStur(rt: int64, rn: int64, off: int64) {
    // STUR Dt, [Xn, #simm9]
    self.emit32(0xFC000000 | ((off & 0x1FF) << 12) | (rn << 5) | rt);
  }

  // -------------------------------------------------------------------------
  // MOV immediate: MOVZ + MOVK sequence
  // -------------------------------------------------------------------------

  fn emitMovImmReg(reg: int64, imm: int64) {
    var lo: int64 := imm & 0xFFFF;
    var hi: int64 := (imm >> 16) & 0xFFFF;
    var hi2: int64 := (imm >> 32) & 0xFFFF;
    var hi3: int64 := (imm >> 48) & 0xFFFF;

    // MOVZ Xd, #lo  (hw=00)
    self.emit32(0xD2800000 | (lo << 5) | reg);

    if hi != 0 || hi2 != 0 || hi3 != 0 {
      // MOVK Xd, #hi, LSL #16  (hw=01)
      self.emit32(0xF2A00000 | (hi << 5) | reg);
    }
    if hi2 != 0 || hi3 != 0 {
      // MOVK Xd, #hi2, LSL #32  (hw=10)
      self.emit32(0xF2C00000 | (hi2 << 5) | reg);
    }
    if hi3 != 0 {
      // MOVK Xd, #hi3, LSL #48  (hw=11)
      self.emit32(0xF2E00000 | (hi3 << 5) | reg);
    }
  }

  // -------------------------------------------------------------------------
  // Buffer helpers
  // -------------------------------------------------------------------------

  fn emit32(val: int64) {
    if self.codeLen + 4 > self.codeCap {
      var newCap: int64 := self.codeCap * 2;
      var nb: int64 := alloc(newCap);
      var i: int64 := 0;
      while i < self.codeLen {
        poke8(nb + i, peek8(self.codeBuf + i));
        i := i + 1;
      }
      self.codeBuf := nb;
      self.codeCap := newCap;
    }
    poke8(self.codeBuf + self.codeLen,     val & 0xFF);
    poke8(self.codeBuf + self.codeLen + 1, (val >> 8) & 0xFF);
    poke8(self.codeBuf + self.codeLen + 2, (val >> 16) & 0xFF);
    poke8(self.codeBuf + self.codeLen + 3, (val >> 24) & 0xFF);
    self.codeLen := self.codeLen + 4;
  }

  // WP-AND-02 Phase C: 8-byte little-endian emit; used for inline literal pool slots.
  fn emit64(val: int64) {
    self.emit32(val & 0xFFFFFFFF);
    self.emit32((val >> 32) & 0xFFFFFFFF);
  }

  // Single byte (used to embed inline string-literal data in the code stream).
  fn emit8(val: int64) {
    if self.codeLen + 1 > self.codeCap {
      var newCap: int64 := self.codeCap * 2;
      var nb: int64 := alloc(newCap);
      var i: int64 := 0;
      while i < self.codeLen { poke8(nb + i, peek8(self.codeBuf + i)); i := i + 1; }
      self.codeBuf := nb;
      self.codeCap := newCap;
    }
    poke8(self.codeBuf + self.codeLen, val & 0xFF);
    self.codeLen := self.codeLen + 1;
  }


  fn poke32at(off: int64, val: int64) {
    poke8(self.codeBuf + off,     val & 0xFF);
    poke8(self.codeBuf + off + 1, (val >> 8) & 0xFF);
    poke8(self.codeBuf + off + 2, (val >> 16) & 0xFF);
    poke8(self.codeBuf + off + 3, (val >> 24) & 0xFF);
  }

  fn getCodeBuf(): int64 { return self.codeBuf; }
  fn getCodeLen(): int64 { return self.codeLen; }
  fn getFuncAddrs(): int64 { return self.funcAddrs; }   // WP-AND-02 Phase B: expose for export-table

  // -------------------------------------------------------------------------
  // IR Module Helpers
  //
  // IRModule memory layout (VMT at +0, then fields):
  //   +8:  instrBuffer  — pointer to instruction array
  //   +16: instrCap
  //   +24: instrLen     — instruction COUNT (not bytes; each instr = 80 bytes)
  //   +80: funcBuffer   — pointer to function record array
  //   +88: funcCap
  //   +96: funcLen      — function COUNT
  //
  // Function record (80 bytes each):
  //   +0:  nameOff
  //   +8:  nameLen
  //   +16: instrsOff    — first instruction index for this function
  //   +24: instrCount   — number of instructions for this function
  //   +32: localCount
  //   +40: paramCount
  //
  // Instruction record (80 bytes each):
  //   +0:  op    +8: dest  +16: src1  +24: src2  +32: src3  +40: imm
  // -------------------------------------------------------------------------

  fn getFuncCount(): int64 {
    return peek64(self.ir + 96);
  }

  fn getFuncLocalCount(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    return peek64(funcBuf + funcId * 80 + 32);
  }

  fn getFuncInstrStart(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    return peek64(funcBuf + funcId * 80 + 16);
  }

  fn getFuncInstrCount(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    return peek64(funcBuf + funcId * 80 + 24);
  }

  fn getInstrField(absIdx: int64, fieldOff: int64): int64 {
    var instrBuf: int64 := peek64(self.ir + 8);
    return peek64(instrBuf + absIdx * 80 + fieldOff);
  }

  fn getInstrOp(absIdx: int64): int64   { return self.getInstrField(absIdx, 0); }
  fn getInstrDest(absIdx: int64): int64  { return self.getInstrField(absIdx, 8); }
  fn getInstrSrc1(absIdx: int64): int64  { return self.getInstrField(absIdx, 16); }
  fn getInstrSrc2(absIdx: int64): int64  { return self.getInstrField(absIdx, 24); }
  fn getInstrImmInt(absIdx: int64): int64 { return self.getInstrField(absIdx, 40); }

  // -------------------------------------------------------------------------
  // WP-13: Inspect(expr) — emit debug output "[Inspect:name] value\n" to stderr
  // Linux: inline SYS_WRITE(2) syscalls + itoa loop
  // Windows: ADR+B inline strings + BL wab_inspect_str(11)/wab_inspect_int(12)
  // -------------------------------------------------------------------------

  fn emitInspectSysWrite(len: int64) {
    self.emitMovImmReg(ARM64_X2, len);
    self.emitMovImmReg(ARM64_X0, 2);
    self.emitMovImmReg(ARM64_X8, SYS_WRITE);
    self.emit32(0xD4000001);
  }

  fn emitInspect(valSlot: int64, instrIdx: int64) {
    var nameOff: int64 := self.getInstrField(instrIdx, 56);
    var strBuf:  int64 := peek64(self.ir + 32);
    var namePtr: int64 := strBuf + nameOff;
    var nameLen: int64 := StrLen(namePtr as pchar);

    if self.winMode != 0 {
      // ---- Windows ARM64 ----
      // Build "[Inspect:name] " prefix (9 + nameLen + 2 = 11+nameLen bytes)
      var prefixLen: int64 := 11 + nameLen;
      var pb: int64 := alloc(prefixLen + 1);
      poke8(pb + 0, 91);   // '['
      poke8(pb + 1, 73);   // 'I'
      poke8(pb + 2, 110);  // 'n'
      poke8(pb + 3, 115);  // 's'
      poke8(pb + 4, 112);  // 'p'
      poke8(pb + 5, 101);  // 'e'
      poke8(pb + 6, 99);   // 'c'
      poke8(pb + 7, 116);  // 't'
      poke8(pb + 8, 58);   // ':'
      var pi: int64 := 0;
      while pi < nameLen { poke8(pb + 9 + pi, peek8(namePtr + pi)); pi := pi + 1; }
      poke8(pb + 9 + nameLen,     93);  // ']'
      poke8(pb + 9 + nameLen + 1, 32);  // ' '
      // Emit: ADR x0, #8; B over prefix; prefix bytes+NUL+pad; MOVZ x1,#prefixLen; BL id=11
      var ptot: int64 := prefixLen + 1;
      var ppad: int64 := (4 - (ptot & 3)) & 3;
      var ppadded: int64 := ptot + ppad;
      self.emit32(0x10000040);  // ADR x0, #8
      self.emit32(0x14000000 | ((4 + ppadded) >> 2));
      var pj: int64 := 0;
      while pj < prefixLen { self.emit8(peek8(pb + pj)); pj := pj + 1; }
      self.emit8(0);
      var pk: int64 := 0;
      while pk < ppad { self.emit8(0); pk := pk + 1; }
      self.emitMovImmReg(ARM64_X1, prefixLen);
      self.addWinPatch(self.codeLen, 11);
      self.emit32(0x94000000);
      // Emit: load value → x0; BL id=12 (wab_inspect_int, prints decimal)
      self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(valSlot));
      self.addWinPatch(self.codeLen, 12);
      self.emit32(0x94000000);
      // Emit: "\n" → BL id=11 (wab_inspect_str)
      self.emit32(0x10000040);  // ADR x0, #8
      self.emit32(0x14000002);  // B +2 (over 8 bytes: '\n'+NUL+2 pads)
      self.emit8(10); self.emit8(0); self.emit8(0); self.emit8(0);
      self.emitMovImmReg(ARM64_X1, 1);
      self.addWinPatch(self.codeLen, 11);
      self.emit32(0x94000000);
      return;
    }

    // ---- Linux ARM64: inline SYS_WRITE(fd=2) calls ----

    // Write "[Inspect:" (9 bytes) to stderr
    // ADR x1, #8 (string starts 8 bytes after this instruction)
    self.emit32(0x10000041);   // ADR x1, #8
    // B +4 (over 12 bytes: 9 chars + NUL + 2 pads = 12, padded=12, (4+12)/4=4)
    self.emit32(0x14000004);
    self.emit8(91);  self.emit8(73);  self.emit8(110);  // [In
    self.emit8(115); self.emit8(112); self.emit8(101);  // spe
    self.emit8(99);  self.emit8(116); self.emit8(58);   // ct:
    self.emit8(0);   self.emit8(0);   self.emit8(0);    // NUL + 2 pads (align 4)
    self.emitInspectSysWrite(9);

    // Write variable name to stderr
    var ntot:    int64 := nameLen + 1;
    var npad:    int64 := (4 - (ntot & 3)) & 3;
    var npadded: int64 := ntot + npad;
    self.emit32(0x10000041);  // ADR x1, #8
    self.emit32(0x14000000 | ((4 + npadded) >> 2));
    var ni: int64 := 0;
    while ni < nameLen { self.emit8(peek8(namePtr + ni)); ni := ni + 1; }
    self.emit8(0);
    var np: int64 := 0;
    while np < npad { self.emit8(0); np := np + 1; }
    self.emitInspectSysWrite(nameLen);

    // Write "] " (2 bytes) to stderr
    // 2+1=3 bytes → pad=1 → padded=4 → B +2
    self.emit32(0x10000041);  // ADR x1, #8
    self.emit32(0x14000002);  // B +2 (over 8 bytes: '] '+NUL+pad)
    self.emit8(93); self.emit8(32); self.emit8(0); self.emit8(0);  // ] ' ' NUL pad
    self.emitInspectSysWrite(2);

    // Load value from slot → x0
    self.emitLdur(ARM64_X0, ARM64_X29, self.slotOff(valSlot));

    // Inline itoa + write(stderr, digits+'\n', len)
    // Uses 32-byte stack buffer: sp[0..30]=digits(backwards), sp[31]='\n'
    // x9=write_ptr, x10=value, x11=neg_flag, x12=10, x13=quotient, x14=digit
    //
    // Branch layout (instruction indices within this block):
    //   instr  6: CBZ x10, →24 (ZERO_CASE)
    //   instr  8: B.GE →11 (POS_LOOP)
    //   instr 11: [POS_LOOP]
    //   instr 18: CBNZ x10, →11 (-7)
    //   instr 19: CBZ x11, →23 (+4, EMIT_OUT_SKIP)
    //   instr 23: B →27 (+4, EMIT_OUT)
    //   instr 24: [ZERO_CASE]
    //   instr 27: [EMIT_OUT]
    self.emit32(0xD10083FF);  // instr 0: SUB sp,sp,#32
    self.emit32(0x91007BE9);  // instr 1: ADD x9,sp,#30  (x9 → buf[30])
    self.emit32(0x5280014A);  // instr 2: MOVZ w10,#10  ('\n')
    self.emit32(0x39007FEA);  // instr 3: STRB w10,[sp,#31]  (buf[31]='\n')
    self.emit32(0xAA0003EA);  // instr 4: MOV x10,x0  (save value)
    self.emit32(0xD280000B);  // instr 5: MOVZ x11,#0  (neg_flag=0)
    self.emit32(0xB400024A);  // instr 6: CBZ x10,+18 (→ instr 24 ZERO_CASE)
    self.emit32(0xF100015F);  // instr 7: CMP x10,#0  (SUBS xzr,x10,#0)
    self.emit32(0x5400006A);  // instr 8: B.GE +3 (→ instr 11 POS_LOOP)
    self.emit32(0xCB0A03EA);  // instr 9: NEG x10,x10
    self.emit32(0xD280002B);  // instr10: MOVZ x11,#1  (neg_flag=1)
    self.emit32(0xD280014C);  // instr11: MOVZ x12,#10  [POS_LOOP]
    self.emit32(0x9ACC094D);  // instr12: UDIV x13,x10,x12
    self.emit32(0x9B0CA9AE);  // instr13: MSUB x14,x13,x12,x10  (rem=value-q*10)
    self.emit32(0x1100C1CE);  // instr14: ADD w14,w14,#48  ('0'+rem)
    self.emit32(0x3900012E);  // instr15: STRB w14,[x9]
    self.emit32(0xD1000529);  // instr16: SUB x9,x9,#1
    self.emit32(0xAA0D03EA);  // instr17: MOV x10,x13  (value=quotient)
    self.emit32(0xB5FFFF2A);  // instr18: CBNZ x10,-7 (→ instr 11 POS_LOOP)
    self.emit32(0xB400008B);  // instr19: CBZ x11,+4 (→ instr 23)
    self.emit32(0x528005AE);  // instr20: MOVZ w14,#45  ('-')
    self.emit32(0x3900012E);  // instr21: STRB w14,[x9]
    self.emit32(0xD1000529);  // instr22: SUB x9,x9,#1
    self.emit32(0x14000004);  // instr23: B +4 (→ instr 27 EMIT_OUT)
    self.emit32(0x5280060E);  // instr24: MOVZ w14,#48  ('0')  [ZERO_CASE]
    self.emit32(0x3900012E);  // instr25: STRB w14,[x9]
    self.emit32(0xD1000529);  // instr26: SUB x9,x9,#1
    self.emit32(0x91000529);  // instr27: ADD x9,x9,#1  [EMIT_OUT] (first char)
    self.emit32(0x910083EA);  // instr28: ADD x10,sp,#32  (past '\n')
    self.emit32(0xCB090142);  // instr29: SUB x2,x10,x9  (length incl. '\n')
    self.emit32(0xAA0903E1);  // instr30: MOV x1,x9  (start ptr)
    self.emit32(0xD2800040);  // instr31: MOVZ x0,#2  (fd=stderr)
    self.emit32(0xD2800808);  // instr32: MOVZ x8,#64  (SYS_WRITE)
    self.emit32(0xD4000001);  // instr33: SVC #0
    self.emit32(0x910083FF);  // instr34: ADD sp,sp,#32  (restore stack)
  }
};
