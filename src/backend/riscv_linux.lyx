// bootstrap/backend/riscv_linux.lyx
// RISC-V RV64GC Linux ELF64 backend (WP-BC-36)
//
// Strategy: EmitRISCV64 (IR → RV64 machine code) + 12-byte _start stub.
// The stub calls main and passes a0 to exit(a7=93, ecall).
//
// ELF64 layout:
//   file[0..4095]    ELF64 header + program header (1 page)
//   file[4096..]     .text (_start at file:4096 = VA:0x401000)
//   Load base 0x400000, .text VA 0x401000
//
// _start stub (12 bytes at .text offset 0):
//   +0: JAL ra, 12      call main (12 bytes forward)
//   +4: ADDI a7,x0,93   li a7, 93 (exit syscall number)
//   +8: ECALL            exit(a0)
//
// RISC-V LP64 ABI:
//   a0-a7 (x10-x17) args/return; a7 syscall number
//   s0/fp (x8) frame pointer; ra (x1) return address
//   sp (x2) stack pointer; t0 (x5), t1 (x6) scratch temps

// ============================================================================
// Register numbers
// ============================================================================


import src.emit_write;
import src.std.alloc;
con RV_ZERO: int64 := 0;
con RV_RA:   int64 := 1;
con RV_SP:   int64 := 2;
con RV_FP:   int64 := 8;    // s0/fp
con RV_A0:   int64 := 10;
con RV_A1:   int64 := 11;
con RV_A2:   int64 := 12;
con RV_A3:   int64 := 13;
con RV_A4:   int64 := 14;
con RV_A5:   int64 := 15;
con RV_A6:   int64 := 16;
con RV_A7:   int64 := 17;
con RV_T0:   int64 := 5;
con RV_T1:   int64 := 6;
con RV_T2:   int64 := 7;

// Linux RISC-V syscall numbers
con RV_SYS_EXIT:   int64 := 93;
con RV_SYS_WRITE:  int64 := 64;
con RV_SYS_READ:   int64 := 63;   // #1740: riscv64 zaehlt anders als x86-64 (dort 0)
con RV_SYS_MMAP:   int64 := 222;
con RV_SYS_MUNMAP: int64 := 215;
con RV_SYS_OPEN:   int64 := 56;
con RV_SYS_CLOSE:  int64 := 57;

// #1740: Laenge des _start-Rumpfs (RiscvLinuxBackend.rlb_emitStart). Der Rumpf
// wird VOR den Code kopiert; der Datenbereich muss deshalb um genau diese
// Laenge versetzt auf eine Seitengrenze fallen.
con RV_START_STUB_LEN: int64 := 12;

// Branch patch types
con RV_PATCH_J:   int64 := 0;   // JAL x0, label  (unconditional)
con RV_PATCH_BL:  int64 := 1;   // JAL ra, funcId  (call)
con RV_PATCH_BEQ: int64 := 2;   // BEQ t0, x0, label  (branch if == 0)
con RV_PATCH_BNE: int64 := 3;   // BNE t0, x0, label  (branch if != 0)

// ============================================================================
// EmitRISCV64  —  IR → RV64GC machine code
// ============================================================================

pub type EmitRISCV64 = class {
  codeBuf:    int64;
  codeLen:    int64;
  codeCap:    int64;
  ir:         int64;
  stackSize:  int64;
  labelAddrs: int64;   // labelId → code offset  (1024 × 8 bytes)
  labelCount: int64;
  patchBuf:   int64;   // {codeOff,labelId,type,reg} je 32 Bytes, waechst (#1740)
  patchCount: int64;
  patchCap:   int64;   // #1740: Kapazitaet in Eintraegen
  funcAddrs:  int64;   // funcId → start offset  (256 × 8 bytes)
  funcCount:  int64;
  // #1740: globale Variablen. Der Zugriff entsteht PC-relativ (AUIPC+ADDI) und
  // wird aufgeloest, sobald der Datenbereich hinter dem Code steht.
  globRelocBuf:   int64;   // {codeOff, globalIdx} je 16 Bytes
  globRelocCount: int64;
  globRelocCap:   int64;
  globalsOff:     int64;   // Code-Offset des Datenbereichs (-1 = noch nicht gesetzt)
  mainOff:        int64;   // #1740: Code-Offset von main (-1 = nicht gefunden)

  // --------------------------------------------------------------------------
  // Code emission primitives
  // --------------------------------------------------------------------------

  fn rv_e32(v: int64) {
    poke8(self.codeBuf + self.codeLen,     v & 0xFF);
    poke8(self.codeBuf + self.codeLen + 1, (v >> 8) & 0xFF);
    poke8(self.codeBuf + self.codeLen + 2, (v >> 16) & 0xFF);
    poke8(self.codeBuf + self.codeLen + 3, (v >> 24) & 0xFF);
    self.codeLen := self.codeLen + 4;
  }

  // #1339: einzelnes Byte — fuer Zeichenketten, die inline im Codestrom liegen.
  fn rv_e8(v: int64) {
    poke8(self.codeBuf + self.codeLen, v & 0xFF);
    self.codeLen := self.codeLen + 1;
  }

  // #1339: JAL x0, off — unbedingter Sprung ohne Ruecksprungadresse. Das
  // Sprungziel steckt in RISC-V verstreut im Befehlswort (imm[20|10:1|11|19:12]);
  // von Hand zusammengesetzt ist das die haeufigste Fehlerquelle, deshalb hier
  // an einer Stelle.
  // #1388: BEQ rs, x0, +off  (B-Type, funct3=0). Nur vorwaerts, Offset gerade.
  fn rv_BEQZ_fwd(rs: int64, off: int64) {
    var b11: int64 := (off >> 11) & 1;
    var b4_1: int64 := (off >> 1) & 0xF;
    var b10_5: int64 := (off >> 5) & 0x3F;
    var b12: int64 := (off >> 12) & 1;
    self.rv_e32(0x63 | (b11 << 7) | (b4_1 << 8) | (0 << 12) | (rs << 15) | (0 << 20)
                     | (b10_5 << 25) | (b12 << 31));
  }

  fn rv_JAL_x0(off: int64) {
    var b20:    int64 := (off >> 20) & 0x1;
    var b10_1:  int64 := (off >> 1)  & 0x3FF;
    var b11:    int64 := (off >> 11) & 0x1;
    var b19_12: int64 := (off >> 12) & 0xFF;
    self.rv_e32(0x6F | (b19_12 << 12) | (b11 << 20) | (b10_1 << 21) | (b20 << 31));
  }

  fn rv_poke32at(off: int64, val: int64) {
    poke8(self.codeBuf + off,     val & 0xFF);
    poke8(self.codeBuf + off + 1, (val >> 8) & 0xFF);
    poke8(self.codeBuf + off + 2, (val >> 16) & 0xFF);
    poke8(self.codeBuf + off + 3, (val >> 24) & 0xFF);
  }

  // --------------------------------------------------------------------------
  // RISC-V instruction encoders
  // --------------------------------------------------------------------------

  // LD rd, off(rs1)  — 64-bit load, I-type, funct3=3, opcode=3
  fn rv_LD(rd: int64, rs1: int64, off: int64) {
    self.rv_e32(0x3 | (rd<<7) | (3<<12) | (rs1<<15) | ((off & 0xFFF)<<20));
  }

  // SD rs2, off(rs1)  — 64-bit store, S-type, funct3=3, opcode=0x23
  fn rv_SD(rs2: int64, rs1: int64, off: int64) {
    var imm5: int64 := off & 0x1F;
    var imm7: int64 := ((off & 0xFFF) >> 5) & 0x7F;
    self.rv_e32(0x23 | (imm5<<7) | (3<<12) | (rs1<<15) | (rs2<<20) | (imm7<<25));
  }

  // #1388: schmale Zugriffe. Die Speicher-Builtins (peek8/16/32, poke8/16/32)
  // brauchen sie; bis 1.1.0A fehlten sie, und weil emitBuiltinCall keinen
  // Default-Zweig hatte, erzeugte `peek8(p)` GAR NICHTS und lieferte, was
  // zufaellig in a0 stand.
  // LBU rd, off(rs1) — funct3=4, opcode=3
  fn rv_LBU(rd: int64, rs1: int64, off: int64) {
    self.rv_e32(0x3 | (rd<<7) | (4<<12) | (rs1<<15) | ((off & 0xFFF)<<20));
  }
  // LHU rd, off(rs1) — funct3=5
  fn rv_LHU(rd: int64, rs1: int64, off: int64) {
    self.rv_e32(0x3 | (rd<<7) | (5<<12) | (rs1<<15) | ((off & 0xFFF)<<20));
  }
  // LWU rd, off(rs1) — funct3=6
  fn rv_LWU(rd: int64, rs1: int64, off: int64) {
    self.rv_e32(0x3 | (rd<<7) | (6<<12) | (rs1<<15) | ((off & 0xFFF)<<20));
  }
  // SB rs2, off(rs1) — funct3=0, opcode=0x23
  fn rv_SB(rs2: int64, rs1: int64, off: int64) {
    var sbI5: int64 := off & 0x1F;
    var sbI7: int64 := ((off & 0xFFF) >> 5) & 0x7F;
    self.rv_e32(0x23 | (sbI5<<7) | (0<<12) | (rs1<<15) | (rs2<<20) | (sbI7<<25));
  }
  // SH rs2, off(rs1) — funct3=1
  fn rv_SH(rs2: int64, rs1: int64, off: int64) {
    var shI5: int64 := off & 0x1F;
    var shI7: int64 := ((off & 0xFFF) >> 5) & 0x7F;
    self.rv_e32(0x23 | (shI5<<7) | (1<<12) | (rs1<<15) | (rs2<<20) | (shI7<<25));
  }
  // SW rs2, off(rs1) — funct3=2
  fn rv_SW(rs2: int64, rs1: int64, off: int64) {
    var swI5: int64 := off & 0x1F;
    var swI7: int64 := ((off & 0xFFF) >> 5) & 0x7F;
    self.rv_e32(0x23 | (swI5<<7) | (2<<12) | (rs1<<15) | (rs2<<20) | (swI7<<25));
  }

  // ADDI rd, rs1, imm  — I-type, funct3=0, opcode=0x13
  fn rv_ADDI(rd: int64, rs1: int64, imm: int64) {
    self.rv_e32(0x13 | (rd<<7) | (0<<12) | (rs1<<15) | ((imm & 0xFFF)<<20));
  }

  // ADD rd, rs1, rs2  — R-type, funct3=0, funct7=0
  fn rv_ADD(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (0<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // SUB rd, rs1, rs2  — R-type, funct3=0, funct7=0x20
  fn rv_SUB(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (0<<12) | (rs1<<15) | (rs2<<20) | (0x20<<25));
  }

  // MUL rd, rs1, rs2  — M-ext, funct3=0, funct7=1
  fn rv_MUL(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (0<<12) | (rs1<<15) | (rs2<<20) | (1<<25));
  }

  // DIV rd, rs1, rs2  — M-ext, funct3=4 (signed), funct7=1
  fn rv_DIV(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (4<<12) | (rs1<<15) | (rs2<<20) | (1<<25));
  }

  // REM rd, rs1, rs2  — M-ext, funct3=6 (signed), funct7=1
  fn rv_REM(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (6<<12) | (rs1<<15) | (rs2<<20) | (1<<25));
  }

  // AND rd, rs1, rs2  — funct3=7
  fn rv_AND(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (7<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // OR rd, rs1, rs2  — funct3=6
  fn rv_OR(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (6<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // XOR rd, rs1, rs2  — funct3=4
  fn rv_XOR(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (4<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // SLL rd, rs1, rs2  — funct3=1
  fn rv_SLL(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (1<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // SRL rd, rs1, rs2  — logical right shift, funct3=5, funct7=0
  fn rv_SRL(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (5<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // SLT rd, rs1, rs2  — signed less-than, funct3=2
  fn rv_SLT(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (2<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // SLTU rd, rs1, rs2  — unsigned less-than, funct3=3
  fn rv_SLTU(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (3<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // MV rd, rs  (pseudo: ADDI rd, rs, 0)
  fn rv_MV(rd: int64, rs: int64) {
    self.rv_ADDI(rd, rs, 0);
  }

  // LI rd, small_imm  (pseudo: ADDI rd, x0, imm)  — imm in [-2048..2047]
  fn rv_LI(rd: int64, imm: int64) {
    self.rv_ADDI(rd, RV_ZERO, imm);
  }

  // Load full immediate: LUI+ADDI for values outside [-2048..2047]
  fn rv_LI64(rd: int64, imm: int64) {
    if imm >= -2048 && imm <= 2047 {
      self.rv_ADDI(rd, RV_ZERO, imm);
    } else {
      var lo12: int64 := imm & 0xFFF;
      if (lo12 & 0x800) != 0 { lo12 := lo12 - 0x1000; }
      var hi20: int64 := (imm - lo12) >> 12;
      // LUI rd, hi20
      self.rv_e32(0x37 | (rd<<7) | ((hi20 & 0xFFFFF)<<12));
      if lo12 != 0 { self.rv_ADDI(rd, rd, lo12); }
    }
  }

  // ECALL
  fn rv_ECALL() { self.rv_e32(0x00000073); }

  // RET = JALR x0, ra, 0
  fn rv_RET() { self.rv_e32(0x00008067); }

  // Build J-type JAL word: rd=0→jump, rd=1→call
  fn rv_buildJAL(rd: int64, offset: int64): int64 {
    var imm20:    int64 := (offset >> 20) & 1;
    var imm10_1:  int64 := (offset >> 1) & 0x3FF;
    var imm11:    int64 := (offset >> 11) & 1;
    var imm19_12: int64 := (offset >> 12) & 0xFF;
    return 0x6F | (rd<<7) | (imm19_12<<12) | (imm11<<20) | (imm10_1<<21) | (imm20<<31);
  }

  // Build B-type branch word (BEQ/BNE/BLT/BGE)
  fn rv_buildBtype(funct3: int64, rs1: int64, rs2: int64, off: int64): int64 {
    var imm12:   int64 := (off >> 12) & 1;
    var imm11:   int64 := (off >> 11) & 1;
    var imm10_5: int64 := (off >> 5) & 0x3F;
    var imm4_1:  int64 := (off >> 1) & 0xF;
    return 0x63 | (imm11<<7) | (imm4_1<<8) | (funct3<<12) | (rs1<<15) | (rs2<<20) | (imm10_5<<25) | (imm12<<31);
  }

  // --------------------------------------------------------------------------
  // Stack slot helper: slot i → [s0, -(i+1)*8]
  // --------------------------------------------------------------------------

  fn slotOff(slot: int64): int64 { return -(slot + 1) * 8; }

  fn rv_loadSlot(slot: int64) {
    self.rv_LD(RV_T0, RV_FP, self.slotOff(slot));
  }

  fn rv_loadSlot2(slot: int64) {
    self.rv_LD(RV_T1, RV_FP, self.slotOff(slot));
  }

  fn rv_storeSlot(slot: int64) {
    self.rv_SD(RV_T0, RV_FP, self.slotOff(slot));
  }

  // --------------------------------------------------------------------------
  // Stack frame
  // --------------------------------------------------------------------------

  fn calcStackFrame(funcId: int64) {
    var locals: int64 := self.getFuncLocalCount(funcId);
    var sz: int64 := locals * 8;
    if (sz & 15) != 0 { sz := (sz + 16) & -16; }
    if sz < 16 { sz := 16; }
    self.stackSize := sz;
  }

  // Prologue layout (after execution):
  //   [s0+0]  = saved old s0
  //   [s0+8]  = saved ra
  //   s0      = sp (frame pointer; saved regs above it)
  //   sp      = s0 - stackSize  (locals area below s0)
  // slotOff(i) = -(i+1)*8  → within [sp .. s0-1] ✓
  fn emitPrologue() {
    self.rv_ADDI(RV_SP, RV_SP, -16);  // alloc saved-regs area
    self.rv_SD(RV_FP, RV_SP, 0);      // save old s0
    self.rv_SD(RV_RA, RV_SP, 8);      // save ra
    self.rv_MV(RV_FP, RV_SP);         // s0 = sp (frame pointer)
    if self.stackSize > 0 {
      self.rv_ADDI(RV_SP, RV_SP, -self.stackSize);  // alloc locals
    }
  }

  // Epilogue: load retValTemp (slot 0) into a0, restore frame, return
  fn emitEpilogue() {
    self.rv_LD(RV_A0, RV_FP, self.slotOff(0));  // a0 = retValTemp
    self.rv_MV(RV_SP, RV_FP);                    // restore sp = s0
    self.rv_LD(RV_FP, RV_SP, 0);                 // restore old s0
    self.rv_LD(RV_RA, RV_SP, 8);                 // restore ra
    self.rv_ADDI(RV_SP, RV_SP, 16);              // pop saved area
    self.rv_RET();                                // JALR x0, ra, 0
  }

  // --------------------------------------------------------------------------
  // Patch management
  // --------------------------------------------------------------------------

  // #1740: Die Liste wuchs frueher nicht — jenseits von 1024 Eintraegen fiel
  // jeder weitere Patch still weg und der zugehoerige Sprung blieb auf seinem
  // Platzhalter stehen. Seit die Aufruf-Patches ueber alle Funktionen hinweg
  // stehenbleiben (siehe emitFunc), ist die Grenze schnell erreicht.
  fn addPatch(codeOff: int64, labelId: int64, ptype: int64, reg: int64) {
    if self.patchCount >= self.patchCap {
      var nc: int64 := self.patchCap * 2;
      var nb: int64 := alloc(nc * 32);
      var ci: int64 := 0;
      while ci < self.patchCount * 4 {
        poke64(nb + ci * 8, peek64(self.patchBuf + ci * 8));
        ci := ci + 1;
      }
      self.patchBuf := nb;
      self.patchCap := nc;
    }
    var base: int64 := self.patchBuf + self.patchCount * 32;
    poke64(base,      codeOff);
    poke64(base + 8,  labelId);
    poke64(base + 16, ptype);
    poke64(base + 24, reg);
    self.patchCount := self.patchCount + 1;
  }

  fn applyPatches() {
    var i: int64 := 0;
    while i < self.patchCount {
      var base:    int64 := self.patchBuf + i * 32;
      var codeOff: int64 := peek64(base);
      var labelId: int64 := peek64(base + 8);
      var ptype:   int64 := peek64(base + 16);
      // #1740: -2 heisst „schon gepatcht" — der Durchlauf am Ende von emit()
      // sieht dieselbe Liste noch einmal.
      if labelId != -2 {
      var target:  int64 := -1;
      if ptype == RV_PATCH_BL {
        // #1740: funcAddrs kommt aus alloc und ist null. Ein Ziel 0 ist nur
        // fuer die ZUERST erzeugte Funktion echt; fuer jede andere heisst es
        // „noch nicht erzeugt". Vorher wurde jeder Vorwaertsaufruf auf
        // Code-Offset 0 gepatcht und sprang damit in die erste Funktion —
        // aus `alloc(64)` wurde ein Selbstaufruf von main bis zum
        // Stapelueberlauf (#1740).
        if labelId < 256 {
          target := peek64(self.funcAddrs + labelId * 8);
          if target == 0 { if labelId != 0 { target := -1; } }
        }
      } else {
        if labelId < 1024 { target := peek64(self.labelAddrs + labelId * 8); }
      }
      if target >= 0 {
        var delta: int64 := target - codeOff;
        if ptype == RV_PATCH_J || ptype == RV_PATCH_BL {
          // rd = ptype (0 = x0 for jump, 1 = ra for call)
          self.rv_poke32at(codeOff, self.rv_buildJAL(ptype, delta));
        } else if ptype == RV_PATCH_BEQ {
          self.rv_poke32at(codeOff, self.rv_buildBtype(0, RV_T0, RV_ZERO, delta));
        } else if ptype == RV_PATCH_BNE {
          self.rv_poke32at(codeOff, self.rv_buildBtype(1, RV_T0, RV_ZERO, delta));
        }
        poke64(base + 8, -2);
      }
      }
      i := i + 1;
    }
  }

  // --------------------------------------------------------------------------
  // Instruction dispatch
  // --------------------------------------------------------------------------

    // #1339: Der Dispatcher unten ist eine flache Liste aus `if op == X`
  // ohne else und ohne Default. Ein Opcode, den keine Zeile trifft, erzeugte
  // damit GAR NICHTS und verschwand lautlos aus dem Programm — bei
  // IRO_PANIC hiess das: nach einer erkannten Verletzung laeuft es weiter.
  //
  // Diese Liste nennt die Opcodes, die riscv tatsaechlich behandelt. Sie ist
  // aus dem Dispatcher erhoben und wird gegen ihn geprueft. Weicht sie ab,
  // scheitert der Lauf LAUT — die Abweichung faellt damit beim Uebersetzen
  // auf und nicht erst im erzeugten Programm.
  fn rv_opBehandelt(op: int64): int64 {
    // #1339: die vier Zusicherungen — ir_lower erzeugt sie (ASSERT_NOT_ZERO
    // steht vor jeder Division), und bis 1.0.18B behandelte sie ausser lyxos
    // kein Backend.
    if (op == IRO_ASSERT_NOT_NULL || op == IRO_ASSERT_NOT_ZERO) { return 1; }
    if (op == IRO_ASSERT_TRUE || op == IRO_ASSERT_BOUNDS) { return 1; }
    if (op == IRO_CONST_STR) { return 1; }   // #1339
    if (op == 167 || op == IRO_ADD || op == IRO_ALLOC || op == IRO_AND) { return 1; }
    if (op == IRO_BITAND || op == IRO_BITNOT || op == IRO_BITOR || op == IRO_BITXOR) { return 1; }
    if (op == IRO_BR_FALSE || op == IRO_BR_TRUE || op == IRO_CALL || op == IRO_CALL_BUILTIN) { return 1; }
    if (op == IRO_CAST || op == IRO_CMP_EQ || op == IRO_CMP_GE || op == IRO_CMP_GT) { return 1; }
    if (op == IRO_CMP_LE || op == IRO_CMP_LT || op == IRO_CMP_NEQ || op == IRO_CONST_FLOAT) { return 1; }
    if (op == IRO_CONST_INT || op == IRO_DIV || op == IRO_FREE || op == IRO_FTOI) { return 1; }
    if (op == IRO_FUNC_EXIT || op == IRO_ITOF || op == IRO_JMP || op == IRO_LABEL) { return 1; }
    if (op == IRO_LOAD_FIELD || op == IRO_LOAD_FIELD_HEAP || op == IRO_LOAD_GLOBAL || op == IRO_LOAD_LOCAL) { return 1; }
    if (op == IRO_MOD || op == IRO_MUL || op == IRO_NEG || op == IRO_NOT) { return 1; }
    if (op == IRO_OR || op == IRO_PANIC || op == IRO_SEXT || op == IRO_SHL) { return 1; }
    if (op == IRO_SHR || op == IRO_STORE_FIELD || op == IRO_STORE_FIELD_HEAP || op == IRO_STORE_GLOBAL) { return 1; }
    if (op == IRO_STORE_LOCAL || op == IRO_SUB || op == IRO_THROW || op == IRO_TRUNC) { return 1; }
    if (op == IRO_XOR || op == IRO_ZEXT) { return 1; }
    return 0;
  }

  fn emitInstr(funcId: int64, idx: int64) {
    var opRoh: int64 := self.getInstrOp(idx);
    if (self.rv_opBehandelt(opRoh) == 0) {
      EPrintStr("error: riscv-Backend kennt Opcode "c);
      EPrintInt(opRoh);
      EPrintStrLn(" nicht — er wuerde stillschweigend verschwinden (#1339)."c);
      EPrintStrLn("  Entweder den Opcode hier umsetzen oder ihn in ir_lower fuer dieses Ziel abweisen."c);
      exit(1);
    }

    var op:   int64 := self.getInstrOp(idx);
    var dest: int64 := self.getInstrDest(idx);
    var src1: int64 := self.getInstrSrc1(idx);
    var src2: int64 := self.getInstrSrc2(idx);
    var imm:  int64 := self.getInstrImmInt(idx);

    // --- Constants ---
    if op == IRO_CONST_INT || op == IRO_CONST_FLOAT {
      self.rv_LI64(RV_T0, imm);
      self.rv_storeSlot(dest);
    }

    // --- Integer arithmetic ---
    if op == IRO_ADD {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_ADD(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_SUB {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_SUB(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_MUL {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_MUL(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_DIV {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_DIV(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_MOD {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_REM(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_NEG {
      self.rv_loadSlot(src1);
      self.rv_SUB(RV_T0, RV_ZERO, RV_T0); self.rv_storeSlot(dest);
    }

    // --- Bitwise ---
    if op == IRO_AND || op == IRO_BITAND {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_AND(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_OR || op == IRO_BITOR {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_OR(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_XOR || op == IRO_BITXOR {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_XOR(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_NOT || op == IRO_BITNOT {
      self.rv_loadSlot(src1);
      self.rv_LI(RV_T1, -1);
      self.rv_XOR(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_SHL {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_SLL(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_SHR {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_SRL(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }

    // --- Comparisons ---
    if op == IRO_CMP_EQ {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_XOR(RV_T0, RV_T0, RV_T1);
      self.rv_LI(RV_T1, 1);
      self.rv_SLTU(RV_T0, RV_T0, RV_T1);   // t0 = (t0 < 1) = (t0 == 0)
      self.rv_storeSlot(dest);
    }
    if op == IRO_CMP_NEQ {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_XOR(RV_T0, RV_T0, RV_T1);
      self.rv_SLTU(RV_T0, RV_ZERO, RV_T0); // t0 = (0 < t0) = (t0 != 0)
      self.rv_storeSlot(dest);
    }
    if op == IRO_CMP_LT {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_SLT(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_CMP_GE {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_SLT(RV_T0, RV_T0, RV_T1);
      self.rv_LI(RV_T1, 1);
      self.rv_XOR(RV_T0, RV_T0, RV_T1);   // invert: !(src1 < src2) = src1 >= src2
      self.rv_storeSlot(dest);
    }
    if op == IRO_CMP_GT {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_SLT(RV_T0, RV_T1, RV_T0);   // src2 < src1
      self.rv_storeSlot(dest);
    }
    if op == IRO_CMP_LE {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_SLT(RV_T0, RV_T1, RV_T0);   // src2 < src1
      self.rv_LI(RV_T1, 1);
      self.rv_XOR(RV_T0, RV_T0, RV_T1);   // !(src2 < src1) = src1 <= src2
      self.rv_storeSlot(dest);
    }

    // --- Memory: locals and globals ---
    if op == IRO_LOAD_LOCAL || op == IRO_STORE_LOCAL {
      self.rv_loadSlot(src1); self.rv_storeSlot(dest);
    }
    // #1740: src1 bzw. src2 tragen einen globalIdx, KEINE Adresse. riscv lud
    // ihn bis hierher als Zahl in ein Register und griff darauf zu — der
    // Zugriff auf die erste globale Variable landete also auf Adresse 0, der
    // auf die zweite auf 8. Genau daran starb `alloc`, dessen Zustand in
    // globalen Variablen steht. Jetzt zeigt AUIPC+ADDI PC-relativ in den
    // Datenbereich hinter dem Code; die Distanz traegt applyGlobalRelocs nach.
    if op == IRO_LOAD_GLOBAL {
      self.emitGlobalAddr(src1);
      self.rv_LD(RV_T0, RV_T2, 0); self.rv_storeSlot(dest);
    }
    // ir_lower legt bei STORE_GLOBAL den globalIdx ins DEST-Feld und den Slot
    // mit dem Wert nach src1 (irAddInstrDirect(op, gIdx, valTemp, -1, 0)).
    // riscv las den Index aus src2 — dort steht -1, geschrieben wurde also
    // acht Byte VOR den Datenbereich, mitten in den Code (#1740).
    if op == IRO_STORE_GLOBAL {
      self.emitGlobalAddr(dest);
      self.rv_loadSlot(src1);
      self.rv_SD(RV_T0, RV_T2, 0);
    }

    // --- Struct field access ---
    if op == IRO_LOAD_FIELD || op == IRO_LOAD_FIELD_HEAP {
      self.rv_loadSlot(src1);
      self.rv_LD(RV_T0, RV_T0, src2); self.rv_storeSlot(dest);
    }
    if op == IRO_STORE_FIELD || op == IRO_STORE_FIELD_HEAP {
      self.rv_loadSlot(src2);            // t0 = base pointer
      self.rv_MV(RV_T2, RV_T0);         // t2 = base
      self.rv_loadSlot(src1);            // t0 = value
      self.rv_SD(RV_T0, RV_T2, imm);
    }

    // --- Function calls ---
    if op == IRO_CALL {
      // #1740: Die Argumente liegen im reservierten Block ab src2 (argBase),
      // nicht in den Slots 0..N-1 — die gehoeren den Locals des Aufrufers.
      // riscv las sie bis hierher aus Slot 0 und uebergab damit irgendeinen
      // fremden Wert; arm64 und lyxos rechnen laengst ab argBase.
      var argCount: int64 := imm;
      var argBase:  int64 := src2;
      if argBase < 0 { argBase := 0; }
      var ai: int64 := 0;
      while ai < argCount && ai < 8 {
        self.rv_loadSlot(argBase + ai);
        self.rv_MV(RV_A0 + ai, RV_T0);
        ai := ai + 1;
      }
      var patchOff: int64 := self.codeLen;
      self.rv_e32(0x000000EF);   // JAL ra, 0 placeholder (0x6F | 1<<7 = 0xEF)
      self.addPatch(patchOff, src1, RV_PATCH_BL, 0);
      self.rv_MV(RV_T0, RV_A0);
      self.rv_storeSlot(dest);
    }
    if op == IRO_CALL_BUILTIN {
      self.emitBuiltinCall(imm, src1, dest);
    }

    // --- Control flow ---
    if op == IRO_JMP {
      var patchOff: int64 := self.codeLen;
      self.rv_e32(0x0000006F);   // JAL x0, 0 placeholder
      self.addPatch(patchOff, imm, RV_PATCH_J, 0);
    }
    if op == IRO_BR_TRUE {
      self.rv_loadSlot(src1);
      var patchOff: int64 := self.codeLen;
      // BNE t0, x0, 0 placeholder: 0x63 | (1<<12) | (RV_T0<<15) = 0x00029063
      self.rv_e32(0x00029063);
      self.addPatch(patchOff, imm, RV_PATCH_BNE, 0);
    }
    if op == IRO_BR_FALSE {
      self.rv_loadSlot(src1);
      var patchOff: int64 := self.codeLen;
      // BEQ t0, x0, 0 placeholder: 0x63 | (0<<12) | (RV_T0<<15) = 0x00028063
      self.rv_e32(0x00028063);
      self.addPatch(patchOff, imm, RV_PATCH_BEQ, 0);
    }
    if op == IRO_LABEL {
      if imm < 1024 {
        poke64(self.labelAddrs + imm * 8, self.codeLen);
      }
    }
    if op == IRO_FUNC_EXIT {
      self.emitEpilogue();
    }

    // --- Memory allocation ---
    if op == IRO_ALLOC {
      self.rv_LI(RV_A0, 0);
      self.rv_loadSlot(src1); self.rv_MV(RV_A1, RV_T0);
      self.rv_LI(RV_A2, 3);
      self.rv_LI(RV_A3, 34);
      self.rv_LI(RV_A4, -1);
      self.rv_LI(RV_A5, 0);
      self.rv_LI(RV_A7, RV_SYS_MMAP);
      self.rv_ECALL();
      self.rv_MV(RV_T0, RV_A0); self.rv_storeSlot(dest);
    }
    if op == IRO_FREE {
      self.rv_loadSlot(src1); self.rv_MV(RV_A0, RV_T0);
      self.rv_LI(RV_A1, 0);
      self.rv_LI(RV_A7, RV_SYS_MUNMAP);
      self.rv_ECALL();
    }

    // --- Type conversions: copy only (no FP support in this backend) ---
    if op == IRO_ITOF || op == IRO_FTOI || op == IRO_CAST || op == IRO_SEXT || op == IRO_ZEXT || op == IRO_TRUNC {
      self.rv_loadSlot(src1); self.rv_storeSlot(dest);
    }

    // --- WSP-05: Inline-Assembly (imm = arch-Mnemonic-Id aus ir_lower RISC-V-Tabelle) ---
    // #1281: IRO_THROW → exit(1). try/catch weist ir_lower fuer dieses Ziel ab,
    // ein throw ist hier also immer unbehandelt; bis 1.0.16G erzeugte er nichts.
    if op == IRO_THROW {
      self.rv_LI(RV_A0, 1);
      self.rv_LI(RV_A7, RV_SYS_EXIT);
      self.rv_e32(0x00000073);   // ecall
    }

    // #1339: IRO_CONST_STR — Zeichenkettenliteral. Es fehlte, und deshalb
    // scheiterte auf diesem Ziel schon `PrintLn("hallo")`; vor der
    // Opcode-Pruefung verschwand der Opcode sogar spurlos, und das Programm
    // bekam einen Zeiger auf nichts.
    //
    // Verfahren wie im arm64-Backend: die Bytes stehen INLINE im Codestrom,
    // die Adresse entsteht PC-relativ, und ein Sprung fuehrt darum herum. Das
    // spart eine eigene Datensektion und funktioniert auf jedem Ladeort.
    if op == IRO_CONST_STR {
      var strBufR: int64 := peek64(self.ir + 32);
      var spR: int64 := strBufR + imm;
      var lenR: int64 := StrLen(spR as pchar);
      var totalR: int64 := lenR + 1;                     // mit der abschliessenden 0
      var padR: int64 := (4 - (totalR & 3)) & 3;         // auf 4 Byte auffuellen
      var paddedR: int64 := totalR + padR;
      // AUIPC t0, 0 → t0 = Adresse DIESES Befehls
      self.rv_e32(0x00000297);
      // ADDI t0, t0, 12 → hinter AUIPC + ADDI + JAL, also an den Anfang der Bytes
      self.rv_ADDI(RV_T0, RV_T0, 12);
      // JAL x0, 4 + paddedR → ueber die Zeichenkette hinweg
      self.rv_JAL_x0(4 + paddedR);
      var iR: int64 := 0;
      while (iR < lenR) { self.rv_e8(peek8(spR + iR)); iR := iR + 1; }
      self.rv_e8(0);
      var pR: int64 := 0;
      while (pR < padR) { self.rv_e8(0); pR := pR + 1; }
      self.rv_storeSlot(dest);
    }

    // #1339: Die Zusicherungen. Sie entstehen in ir_lower — ASSERT_NOT_ZERO
    // steht seit WP-OPCODE-REST vor JEDER Division, damit eine Null zu einem
    // kontrollierten Abbruch fuehrt statt zu SIGFPE. Kein Backend ausser
    // lyxos hat sie behandelt: der Opcode verschwand, und die Division lief
    // ungeprueft. Seit der Opcode-Pruefung aus #1339 faellt das beim
    // Uebersetzen auf — hier ist die Umsetzung.
    //
    // Aufbau wie im lyxos-Backend: Wert laden, gegen 0 pruefen, im guten Fall
    // ueber den Abbruch springen.
    if op == IRO_ASSERT_NOT_NULL || op == IRO_ASSERT_NOT_ZERO || op == IRO_ASSERT_TRUE {
      self.rv_loadSlot(src1);
      // BNE t0, x0, +12  → ueberspringt die drei Abbruchbefehle
      self.rv_e32(0x00029663);
      self.rv_LI(RV_A0, 1);
      self.rv_LI(RV_A7, RV_SYS_EXIT);
      self.rv_e32(0x00000073);   // ecall
    }

    // ASSERT_BOUNDS: src1 = Index, src2 = Laenge. Verglichen wird VORZEICHENLOS
    // (bltu), damit ein negativer Index als sehr grosse Zahl erkannt wird und
    // nicht durchrutscht.
    if op == IRO_ASSERT_BOUNDS {
      self.rv_loadSlot(src1);
      self.rv_loadSlot2(src2);
      // BLTU t0, t1, +12 → Index kleiner als Laenge: ueberspringen
      self.rv_e32(0x0062E663);
      self.rv_LI(RV_A0, 1);
      self.rv_LI(RV_A7, RV_SYS_EXIT);
      self.rv_e32(0x00000073);   // ecall
    }

    // #1339: IRO_PANIC (121) war hier gar nicht behandelt — ein `panic("...")`
    // erzeugte NICHTS und das Programm lief an genau der Stelle weiter, an der
    // es abbrechen sollte. Bei einer erkannten Verletzung ist das die
    // gefaehrlichste Form des stillen Defaults. Verhalten wie IRO_THROW: exit(1).
    if op == IRO_PANIC {
      self.rv_LI(RV_A0, 1);
      self.rv_LI(RV_A7, RV_SYS_EXIT);
      self.rv_e32(0x00000073);   // ecall
    }

    if op == 167 {
      if      imm == 0 { self.rv_e32(0x00000013); }  // nop     (addi x0,x0,0)
      else if imm == 1 { self.rv_e32(0x10500073); }  // wfi
      else if imm == 2 { self.rv_e32(0x0FF0000F); }  // fence   (iorw,iorw)
      else if imm == 3 { self.rv_e32(0x0000100F); }  // fence.i
      else if imm == 4 { self.rv_e32(0x00000073); }  // ecall
      else if imm == 5 { self.rv_e32(0x00100073); }  // ebreak
      else if imm == 6 { self.rv_e32(0x30200073); }  // mret
      else if imm == 7 { self.rv_e32(0x10200073); }  // sret
      else {
        EPrintStrLn("error: asm: unbekannte Mnemonic (riscv)"c);
        exit(1);
      }
    }
  }

  fn emitBuiltinCall(id: int64, argBase: int64, dest: int64) {
    // #1388: Die Adresse steht NICHT in Slot 0, sondern in einem hohen Block,
    // dessen erster Slot als src1 mitkommt (argBase). ir_lower spillt seit dem
    // Misdispatch-Fix (#839) absichtlich dorthin, weil die festen Slots 0..2
    // die Locals des Aufrufers ueberschreiben. Bis 1.1.5C lasen die drei
    // IR-Backends trotzdem Slot 0 und 1 — sie bekamen also irgendeinen Wert
    // des Aufrufers als Adresse. Auf arm64 war das ein Segfault bei jedem
    // peek8; gemessen wurde damals nur, ob die BYTES entstehen, nicht, ob das
    // Programm laeuft.
    var sBase: int64 := argBase;
    if (sBase < 0) { sBase := 0; }
    if id == 1 {
      // write(stdout, buf, len)
      self.rv_LI(RV_A0, 1);
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));
      self.rv_LD(RV_A2, RV_FP, self.slotOff(sBase + 1));
      self.rv_LI(RV_A7, RV_SYS_WRITE);
      self.rv_ECALL();
    } else if id == 2 || id == 3 {
      // exit(code)  — #1740: Code steht im Argumentblock, nicht in Slot 0.
      self.rv_LD(RV_A0, RV_FP, self.slotOff(sBase));
      self.rv_LI(RV_A7, RV_SYS_EXIT);
      self.rv_ECALL();
    } else if id == 13 {
      // #1388: EPrintStr — write(2, buf, strlen(buf)); die Laenge rechnet der
      // Code selbst aus (die Konvention reicht nur einen Sentinel durch).
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));   // a1 = buf (#1740)
      self.rv_LI(RV_A2, 0);                        // a2 = Laenge
      var epLoop: int64 := self.codeLen;
      self.rv_ADD(RV_T1, RV_A1, RV_A2);
      self.rv_LBU(RV_T2, RV_T1, 0);
      self.rv_BEQZ_fwd(RV_T2, 12);   // Nullbyte -> hinter den Ruecksprung
      self.rv_ADDI(RV_A2, RV_A2, 1);
      var epBack: int64 := epLoop - self.codeLen;
      self.rv_JAL_x0(epBack);
      self.rv_LI(RV_A0, 2);                        // fd = stderr
      self.rv_LI(RV_A7, RV_SYS_WRITE);
      self.rv_ECALL();
    } else if id == 15 {
      // #1388: StrLen — Zeichen bis zur Null zaehlen, Ergebnis nach a0.
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));   // a1 = buf (#1740)
      self.rv_LI(RV_A0, 0);
      var slLoop: int64 := self.codeLen;
      self.rv_ADD(RV_T1, RV_A1, RV_A0);
      self.rv_LBU(RV_T2, RV_T1, 0);
      self.rv_BEQZ_fwd(RV_T2, 12);
      self.rv_ADDI(RV_A0, RV_A0, 1);
      self.rv_JAL_x0(slLoop - self.codeLen);
    } else if id == 200 || id == 208 || id == 201 || id == 202 {
      // #1388: peek8/16/32/64 — Adresse aus Slot 0, Wert nach a0.
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));
      if (id == 200) { self.rv_LBU(RV_A0, RV_A1, 0); }
      if (id == 208) { self.rv_LHU(RV_A0, RV_A1, 0); }
      if (id == 201) { self.rv_LWU(RV_A0, RV_A1, 0); }
      if (id == 202) { self.rv_LD(RV_A0, RV_A1, 0); }
    } else if id == 6 {
      // #1388: StrSub(s, start, len) — Teilkette in frischen Speicher kopieren.
      // Puffer aus mmap, wie bei IntToStr. Kopiert wird hoechstens bis zum
      // Ende der Kette: ein zu grosses `len` liest sonst darueber hinaus.
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));
      self.rv_MV(28, RV_A1);                       // t3 = s
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase + 1));
      self.rv_ADD(28, 28, RV_A1);                  // t3 = s + start
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase + 2));
      self.rv_MV(31, RV_A1);                       // t6 = len
      self.rv_LI(RV_A0, 0);
      self.rv_ADD(RV_A1, 31, 31);
      self.rv_ADDI(RV_A1, RV_A1, 16);              // Groesse = 2*len + 16
      self.rv_LI(RV_A2, 3);
      self.rv_LI(RV_A3, 34);
      self.rv_LI(RV_A4, 0 - 1);
      self.rv_LI(RV_A5, 0);
      self.rv_LI(RV_A7, RV_SYS_MMAP);
      self.rv_ECALL();
      self.rv_MV(29, RV_A0);                       // t4 = Puffer
      self.rv_LI(30, 0);                           // t5 = Zaehler
      var subL: int64 := self.codeLen;
      self.rv_SLT(RV_T2, 30, 31);                  // t2 = (i < len)
      self.rv_BEQZ_fwd(RV_T2, 32);                 // fertig (acht Befehle weiter)
      self.rv_ADD(RV_A2, 28, 30);
      self.rv_LBU(RV_A3, RV_A2, 0);
      self.rv_BEQZ_fwd(RV_A3, 20);                 // Kette zu Ende
      self.rv_ADD(RV_A2, 29, 30);
      self.rv_SB(RV_A3, RV_A2, 0);
      self.rv_ADDI(30, 30, 1);
      self.rv_JAL_x0(subL - self.codeLen);
      self.rv_ADD(RV_A2, 29, 30);
      self.rv_SB(0, RV_A2, 0);                     // Nullbyte
      self.rv_MV(RV_A0, 29);
    } else if id == 16 {
      // #1388: IntToStr(n) — Dezimaltext, Zeiger nach a0.
      //
      // Puffer aus mmap (222): der Zeiger muss den Aufruf ueberleben, einen
      // Allokator hat das Backend nicht. Gerechnet wird von hinten nach vorn,
      // weil die niedrigste Stelle zuerst herausfaellt.
      //
      // Register: t3 = Restwert, t4 = Pufferanfang, t5 = Schreibmarke,
      // t6 = Vorzeichenmerker. a0..a7 sind nach dem Systemaufruf wieder frei.
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));
      self.rv_MV(28, RV_A1);                       // t3 = n
      self.rv_LI(RV_A0, 0);
      self.rv_LI(RV_A1, 64);
      self.rv_LI(RV_A2, 3);
      self.rv_LI(RV_A3, 34);
      self.rv_LI(RV_A4, 0 - 1);
      self.rv_LI(RV_A5, 0);
      self.rv_LI(RV_A7, RV_SYS_MMAP);
      self.rv_ECALL();
      self.rv_MV(29, RV_A0);                       // t4 = Puffer
      self.rv_ADDI(30, 29, 63);                    // t5 = t4 + 63
      self.rv_SB(0, 30, 0);                        // Nullbyte ans Ende
      self.rv_LI(31, 0);                           // t6 = Vorzeichen
      self.rv_SLT(RV_T2, 28, 0);                   // t2 = (n < 0)
      self.rv_BEQZ_fwd(RV_T2, 12);                 // ueberspringt die zwei naechsten
      self.rv_SUB(28, 0, 28);                      // t3 = -t3
      self.rv_LI(31, 1);
      self.rv_LI(RV_A6, 10);                       // Teiler
      // Ziffernschleife, laeuft mindestens einmal (damit aus 0 eine "0" wird).
      var itsL: int64 := self.codeLen;
      self.rv_DIV(RV_A1, 28, RV_A6);
      self.rv_REM(RV_A2, 28, RV_A6);
      self.rv_ADDI(RV_A2, RV_A2, 48);
      self.rv_ADDI(30, 30, 0 - 1);
      self.rv_SB(RV_A2, 30, 0);
      self.rv_MV(28, RV_A1);
      self.rv_BEQZ_fwd(28, 8);                     // fertig? dann ueber den Ruecksprung
      self.rv_JAL_x0(itsL - self.codeLen);
      // Minuszeichen, falls noetig.
      self.rv_BEQZ_fwd(31, 16);
      self.rv_ADDI(30, 30, 0 - 1);
      self.rv_LI(RV_A2, 45);
      self.rv_SB(RV_A2, 30, 0);
      self.rv_MV(RV_A0, 30);                       // Ergebnis: Zeiger auf die erste Ziffer
    } else if id == 206 {
      // #1388: StrCharAt(s, i) — Byte an Position i, ohne Vorzeichen.
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));
      self.rv_LD(RV_A2, RV_FP, self.slotOff(sBase + 1));
      self.rv_ADD(RV_A1, RV_A1, RV_A2);
      self.rv_LBU(RV_A0, RV_A1, 0);
    } else if id == 207 {
      // #1388: StrSetChar(s, i, c) — Byte an Position i setzen.
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));
      self.rv_LD(RV_A2, RV_FP, self.slotOff(sBase + 1));
      self.rv_LD(RV_T1, RV_FP, self.slotOff(sBase + 2));
      self.rv_ADD(RV_A1, RV_A1, RV_A2);
      self.rv_SB(RV_T1, RV_A1, 0);
      self.rv_LI(RV_A0, 0);
    } else if id == 222 || id == 223 {
      // #1740: read(fd, buf, len) / write(fd, buf, len). Ohne sie scheiterte
      // schon `PrintLn` — laut immerhin, aber eben ohne Ausgabe. Die drei
      // Argumente stehen ab argBase (ir_lower legt sie dort ab), das Ergebnis
      // kommt wie ueberall ueber a0 zurueck. `open` bleibt bewusst offen: auf
      // riscv64 gibt es nur openat(56) mit vier Argumenten, das braucht eine
      // eigene Umsetzung statt einer geratenen Nummer.
      self.rv_LD(RV_A0, RV_FP, self.slotOff(sBase));
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase + 1));
      self.rv_LD(RV_A2, RV_FP, self.slotOff(sBase + 2));
      if (id == 222) { self.rv_LI(RV_A7, RV_SYS_READ); }
      if (id == 223) { self.rv_LI(RV_A7, RV_SYS_WRITE); }
      self.rv_ECALL();
    } else if id == 203 || id == 209 || id == 204 || id == 205 {
      // #1388: poke8/16/32/64 — Adresse und Wert stehen im Argumentblock.
      // #1740: Hier standen weiterhin die festen Slots 0 und 1, obwohl der
      // Kommentar am Kopf dieser Methode genau davor warnt und der peek-Zweig
      // daneben laengst ab argBase liest. poke64 schrieb damit auf die Adresse
      // aus einem fremden Slot — bei `poke64(alloc(64), x)` auf die 0.
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));
      self.rv_LD(RV_A2, RV_FP, self.slotOff(sBase + 1));
      if (id == 203) { self.rv_SB(RV_A2, RV_A1, 0); }
      if (id == 209) { self.rv_SH(RV_A2, RV_A1, 0); }
      if (id == 204) { self.rv_SW(RV_A2, RV_A1, 0); }
      if (id == 205) { self.rv_SD(RV_A2, RV_A1, 0); }
      self.rv_LI(RV_A0, 0);
    } else {
      // #1388: Bis 1.1.0A gab es hier KEINEN Default. Eine unbekannte
      // Builtin-ID erzeugte gar nichts, und der Aufruf lieferte, was zufaellig
      // in a0 stand — derselbe stille Default wie bei den Opcodes in #1339,
      // nur eine Ebene tiefer und ohne Meldung.
      self._builtinUnsupportedRV(id);
    }
    self.rv_MV(RV_T0, RV_A0);
    self.rv_storeSlot(dest);
  }

  fn _builtinUnsupportedRV(id: int64) {
    EPrintStr("error: riscv: Builtin-ID "c);
    EPrintInt(id);
    EPrintStrLn(" wird nicht behandelt"c);
    EPrintStrLn("  Die IDs sind ein globaler Namensraum ueber alle Backends."c);
    EPrintStrLn("  Vergabe und Belegung stehen in src/backend/_builtin_ids.md."c);
    exit(1);
  }

  // --------------------------------------------------------------------------
  // Function emitter
  // --------------------------------------------------------------------------

  fn emitFunc(funcId: int64) {
    if funcId < 256 {
      poke64(self.funcAddrs + funcId * 8, self.codeLen);
      self.funcCount := self.funcCount + 1;
    }
    // #1740: Anfang von main merken. Der _start-Rumpf sprang fest auf die
    // ZUERST erzeugte Funktion; stand main nicht an erster Stelle, lief das
    // Programm in eine fremde Funktion und lieferte deren Wert.
    if self.isMainFunc(funcId) != 0 { self.mainOff := self.codeLen; }
    self.stackSize  := 0;
    self.labelCount := 0;
    // #1740: patchCount wird NICHT zurueckgesetzt. Aufruf-Patches muessen die
    // Funktion ueberleben, sonst kann der Durchlauf am Ende von emit() die
    // Vorwaertsaufrufe nicht mehr aufloesen. Aufgeloeste Eintraege sind mit
    // labelId = -2 markiert und werden uebersprungen.
    var li: int64 := 0;
    while li < 1024 { poke64(self.labelAddrs + li * 8, -1); li := li + 1; }
    self.calcStackFrame(funcId);
    self.emitPrologue();
    // #1740: eingehende Argumentregister a0..a7 in die Param-Slots spillen.
    // Ohne das las ein LOAD_LOCAL eines Parameters uninitialisierten Stapel —
    // `alloc(size)` bekam seine Groesse also nie zu sehen. Die Parameter
    // liegen hinter dem Kratzstreifen (IR_BARG_SLOTS), wie bei arm64 (#1388).
    var pSpillCount: int64 := peek64(peek64(self.ir + 80) + funcId * 80 + 40);
    var pSpillI: int64 := 0;
    while pSpillI < pSpillCount {
      if pSpillI < 8 {
        self.rv_SD(RV_A0 + pSpillI, RV_FP, self.slotOff(IR_BARG_SLOTS + pSpillI));
      }
      pSpillI := pSpillI + 1;
    }
    var instrStart: int64 := self.getFuncInstrStart(funcId);
    var instrCount: int64 := self.getFuncInstrCount(funcId);
    var i: int64 := 0;
    while i < instrCount { self.emitInstr(funcId, instrStart + i); i := i + 1; }
    self.emitEpilogue();
    self.applyPatches();
  }

  // --------------------------------------------------------------------------
  // Public interface
  // --------------------------------------------------------------------------

  pub fn init(irMod: int64) {
    self.ir         := irMod;
    self.codeBuf    := alloc(131072);
    self.codeCap    := 131072;
    self.codeLen    := 0;
    self.stackSize  := 0;
    self.labelAddrs := alloc(1024 * 8);
    self.labelCount := 0;
    self.patchBuf   := alloc(1024 * 32);
    self.patchCap   := 1024;
    self.patchCount := 0;
    self.funcAddrs  := alloc(256 * 8);
    self.funcCount  := 0;
    self.globRelocBuf   := alloc(256 * 16);
    self.globRelocCap   := 256;
    self.globRelocCount := 0;
    self.globalsOff     := -1;
    self.mainOff        := -1;
  }

  pub fn emit(): int64 {
    var n: int64 := self.getFuncCount();
    var i: int64 := 0;
    while i < n { self.emitFunc(i); i := i + 1; }
    // #1740: jetzt steht jede Funktionsadresse fest — offene Vorwaertsaufrufe
    // aufloesen.
    self.applyPatches();
    self.emitGlobalsPool();
    self.applyGlobalRelocs();
    return self.codeLen;
  }

  pub fn getCodeBuf(): int64 { return self.codeBuf; }
  pub fn getCodeLen(): int64 { return self.codeLen; }

  // --------------------------------------------------------------------------
  // IR accessors (same layout as EmitARM64)
  // IR module at self.ir:
  //   +8:  instrBuf ptr
  //   +80: funcBuf ptr
  //   +96: funcCount
  // Func record (80 bytes): +16 instrStart, +24 instrCount, +32 localCount
  // Instr record (80 bytes): +0 op, +8 dest, +16 src1, +24 src2, +40 imm
  // --------------------------------------------------------------------------

  fn getFuncCount(): int64 {
    return peek64(self.ir + 96);
  }

  fn getFuncLocalCount(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    return peek64(funcBuf + funcId * 80 + 32);
  }

  fn getFuncInstrStart(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    return peek64(funcBuf + funcId * 80 + 16);
  }

  fn getFuncInstrCount(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    return peek64(funcBuf + funcId * 80 + 24);
  }

  fn getInstrField(absIdx: int64, fieldOff: int64): int64 {
    var instrBuf: int64 := peek64(self.ir + 8);
    return peek64(instrBuf + absIdx * 80 + fieldOff);
  }

  fn getInstrOp(absIdx: int64): int64    { return self.getInstrField(absIdx, 0); }
  fn getInstrDest(absIdx: int64): int64  { return self.getInstrField(absIdx, 8); }
  fn getInstrSrc1(absIdx: int64): int64  { return self.getInstrField(absIdx, 16); }
  fn getInstrSrc2(absIdx: int64): int64  { return self.getInstrField(absIdx, 24); }
  fn getInstrImmInt(absIdx: int64): int64 { return self.getInstrField(absIdx, 40); }

  // --------------------------------------------------------------------------
  // #1740: globale Variablen
  //
  // Die Methoden stehen am ENDE der Klasse: neue Eintraege weiter oben wuerden
  // die VMT verschieben und den Seed brechen (dieselbe Falle wie im
  // lyxos-Backend).
  // --------------------------------------------------------------------------

  // t2 := Adresse von global[gIdx]  —  AUIPC t2, 0 / ADDI t2, t2, 0, beide
  // Haelften spaeter von applyGlobalRelocs nachgetragen.
  fn emitGlobalAddr(gIdx: int64) {
    self.recordGlobalReloc(self.codeLen, gIdx);
    self.rv_e32(0x17 | (RV_T2 << 7));                 // AUIPC t2, 0
    self.rv_ADDI(RV_T2, RV_T2, 0);                     // ADDI  t2, t2, 0
  }

  fn recordGlobalReloc(codeOff: int64, gIdx: int64) {
    if self.globRelocCount >= self.globRelocCap {
      var nc: int64 := self.globRelocCap * 2;
      var nb: int64 := alloc(nc * 16);
      var ci: int64 := 0;
      while ci < self.globRelocCount * 2 {
        poke64(nb + ci * 8, peek64(self.globRelocBuf + ci * 8));
        ci := ci + 1;
      }
      self.globRelocBuf := nb;
      self.globRelocCap := nc;
    }
    var rec: int64 := self.globRelocBuf + self.globRelocCount * 16;
    poke64(rec + 0, codeOff);
    poke64(rec + 8, gIdx);
    self.globRelocCount := self.globRelocCount + 1;
  }

  // Haengt den Datenbereich hinter den Code: acht Byte je globaler Variable,
  // vorbelegt mit ihrem Initialwert. Davor wird so weit aufgefuellt, dass der
  // Bereich im fertigen Abbild auf einer Seitengrenze beginnt — nur dann
  // koennen Code (r-x) und Daten (rw-) getrennte Segmente werden.
  fn emitGlobalsPool() {
    while ((self.codeLen + RV_START_STUB_LEN) % 4096) != 0 { self.rv_e8(0); }
    self.globalsOff := self.codeLen;
    var gCount: int64 := peek64(self.ir + IR_MOD_OFF_GLOBALLEN);
    var gBuf:   int64 := peek64(self.ir + IR_MOD_OFF_GLOBALBUF);
    var gi: int64 := 0;
    while gi < gCount {
      var v: int64 := 0;
      if gBuf != 0 { v := peek64(gBuf + gi * 8); }
      self.rv_e32(v & 0xFFFFFFFF);
      self.rv_e32((v >> 32) & 0xFFFFFFFF);
      gi := gi + 1;
    }
  }

  // AUIPC traegt die oberen 20 Bit, ADDI die unteren 12 — und weil ADDI sein
  // Immediate vorzeichenbehaftet addiert, muss der obere Teil aufgerundet
  // werden, sobald Bit 11 gesetzt ist.
  fn applyGlobalRelocs() {
    var i: int64 := 0;
    while i < self.globRelocCount {
      var rec:     int64 := self.globRelocBuf + i * 16;
      var codeOff: int64 := peek64(rec + 0);
      var gIdx:    int64 := peek64(rec + 8);
      var target:  int64 := self.globalsOff + gIdx * 8;
      var delta:   int64 := target - codeOff;
      var hi:      int64 := (delta + 0x800) >> 12;
      var lo:      int64 := delta - (hi << 12);
      self.rv_poke32at(codeOff, 0x17 | (RV_T2 << 7) | ((hi & 0xFFFFF) << 12));
      self.rv_poke32at(codeOff + 4, 0x13 | (RV_T2 << 7) | (RV_T2 << 15) | ((lo & 0xFFF) << 20));
      i := i + 1;
    }
  }

  // Code-Offset des Datenbereichs — der ELF-Schreiber trennt daran die
  // Segmente. -1, solange emit() nicht gelaufen ist.
  pub fn getGlobalsOff(): int64 { return self.globalsOff; }

  // #1740: heisst die Funktion "main"? Der Name steht als Offset in den
  // String-Pool des IR-Moduls (Feldpaar nameOff/nameLen im Funktionssatz).
  fn isMainFunc(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    var rec:     int64 := funcBuf + funcId * IR_FUNC_SIZE;
    var nameLen: int64 := peek64(rec + IR_FUNC_OFF_NAMELEN);
    if nameLen != 4 { return 0; }
    var strBufR: int64 := peek64(self.ir + 32);
    var p:       int64 := strBufR + peek64(rec + 0);
    if peek8(p + 0) != 109 { return 0; }   // 'm'
    if peek8(p + 1) != 97  { return 0; }   // 'a'
    if peek8(p + 2) != 105 { return 0; }   // 'i'
    if peek8(p + 3) != 110 { return 0; }   // 'n'
    return 1;
  }

  // Code-Offset von main; -1, wenn das Modul keines hat.
  pub fn getMainOff(): int64 { return self.mainOff; }
};

// ============================================================================
// RiscvLinuxBackend  —  _start stub + ELF64-RISCV writer
// ============================================================================

pub type RiscvLinuxBackend = class {
  code:    int64;
  codeLen: int64;
  codeCap: int64;
  dataOff: int64;   // #1740: Offset des Datenbereichs in self.code (0 = keiner)
  mainOff: int64;   // #1740: Code-Offset von main (0 = erste Funktion)

  fn rlb_ce8(v: int64) {
    poke8(self.code + self.codeLen, v & 0xFF);
    self.codeLen := self.codeLen + 1;
  }

  fn rlb_ce32(v: int64) {
    self.rlb_ce8(v);
    self.rlb_ce8(v >> 8);
    self.rlb_ce8(v >> 16);
    self.rlb_ce8(v >> 24);
  }

  // _start stub (12 bytes):
  //   JAL ra, RV_START_STUB_LEN + mainOff   (call main)
  //   ADDI a7, x0, 93     = 0x05D00893  (exit syscall)
  //   ECALL               = 0x00000073
  //
  // #1740: Der Sprung ging fest auf Offset 12, also auf die zuerst erzeugte
  // Funktion. Das ist nur dann main, wenn main auch als erste dasteht.
  fn rlb_emitStart(mainOff: int64) {
    var off: int64 := RV_START_STUB_LEN + mainOff;
    var b20:    int64 := (off >> 20) & 0x1;
    var b10_1:  int64 := (off >> 1)  & 0x3FF;
    var b11:    int64 := (off >> 11) & 0x1;
    var b19_12: int64 := (off >> 12) & 0xFF;
    self.rlb_ce32(0xEF | (b19_12 << 12) | (b11 << 20) | (b10_1 << 21) | (b20 << 31));
    self.rlb_ce32(0x05D00893);  // ADDI a7, x0, 93
    self.rlb_ce32(0x00000073);  // ECALL
  }

  pub fn Init() {
    self.codeCap := 65536;
    self.code    := alloc(self.codeCap);
    self.codeLen := 0;
    self.dataOff := 0;
    self.mainOff := 0;
  }

  pub fn Build(irBuf: int64, irLen: int64) {
    self.rlb_emitStart(self.mainOff);
    var i: int64 := 0;
    while i < irLen { self.rlb_ce8(peek8(irBuf + i)); i := i + 1; }
  }

  pub fn GetCodeSize(): int64 { return self.codeLen; }

  pub fn WriteELF64(path: pchar) {
    var codeFileOffset: int64 := 4096;
    var codeSize:       int64 := self.codeLen;
    var elfSize:        int64 := codeFileOffset + codeSize;
    // #1740: Grenze zwischen Code (r-x) und Daten (rw-). dataOff zaehlt ab
    // self.code, also einschliesslich _start-Rumpf; der Emitter hat davor so
    // weit aufgefuellt, dass die Grenze auf einer Seite liegt.
    var dataStart: int64 := self.dataOff;
    var dataSize:  int64 := 0;
    if dataStart > 0 { dataSize := codeSize - dataStart; }
    var phnum: int64 := 1;
    if dataSize > 0 { phnum := 2; }

    var elfBuf: int64 := alloc(elfSize);
    if elfBuf == -1 { return; }

    var z: int64 := 0;
    while z < elfSize { poke8(elfBuf + z, 0); z := z + 1; }

    var ci: int64 := 0;
    while ci < codeSize {
      poke8(elfBuf + codeFileOffset + ci, peek8(self.code + ci));
      ci := ci + 1;
    }

    // ELF64 header (64 bytes)
    // e_ident (16 bytes)
    poke8(elfBuf + 0, 127);  poke8(elfBuf + 1, 69);   // 0x7F 'E'
    poke8(elfBuf + 2, 76);   poke8(elfBuf + 3, 70);   // 'L' 'F'
    poke8(elfBuf + 4, 2);    poke8(elfBuf + 5, 1);    // 64-bit, little-endian
    poke8(elfBuf + 6, 1);    poke8(elfBuf + 7, 0);    // ELF v1, SysV ABI
    // remaining 8 bytes of e_ident = 0 (already zeroed)

    poke16(elfBuf + 16, 2);          // e_type: ET_EXEC
    poke16(elfBuf + 18, 0xF3);       // e_machine: EM_RISCV = 243
    poke32(elfBuf + 20, 1);          // e_version: EV_CURRENT
    poke64(elfBuf + 24, 0x401000);   // e_entry: _start VA
    poke64(elfBuf + 32, 64);         // e_phoff: program header at byte 64
    poke64(elfBuf + 40, 0);          // e_shoff: no section headers
    poke32(elfBuf + 48, 0x05);       // e_flags: EF_RISCV_RVC | EF_RISCV_FLOAT_ABI_DOUBLE
    poke16(elfBuf + 52, 64);         // e_ehsize
    poke16(elfBuf + 54, 56);         // e_phentsize
    poke16(elfBuf + 56, phnum);      // e_phnum (#1740: 2 mit Datensegment)
    poke16(elfBuf + 58, 64);         // e_shentsize
    poke16(elfBuf + 60, 0);          // e_shnum
    poke16(elfBuf + 62, 0);          // e_shstrndx

    // PT_LOAD segment header (56 bytes at offset 64)
    // #1740: Ohne Datenbereich laedt wie bisher ein einziges r-x-Segment die
    // ganze Datei. Mit Datenbereich wird bei dataStart getrennt, damit die
    // globalen Variablen beschreibbar sind, ohne dass der Code es wird.
    var codeSegSize: int64 := elfSize;
    if dataSize > 0 { codeSegSize := codeFileOffset + dataStart; }
    poke32(elfBuf + 64, 1);              // p_type: PT_LOAD
    poke32(elfBuf + 68, 5);             // p_flags: PF_R | PF_X
    poke64(elfBuf + 72, 0);             // p_offset: 0 (load whole file)
    poke64(elfBuf + 80, 0x400000);      // p_vaddr
    poke64(elfBuf + 88, 0x400000);      // p_paddr
    poke64(elfBuf + 96, codeSegSize);   // p_filesz
    poke64(elfBuf + 104, codeSegSize);  // p_memsz
    poke64(elfBuf + 112, 0x1000);       // p_align: 4096

    if dataSize > 0 {
      var dOff: int64 := codeFileOffset + dataStart;
      poke32(elfBuf + 120, 1);                    // p_type: PT_LOAD
      poke32(elfBuf + 124, 6);                    // p_flags: PF_R | PF_W
      poke64(elfBuf + 128, dOff);                 // p_offset
      poke64(elfBuf + 136, 0x400000 + dOff);      // p_vaddr
      poke64(elfBuf + 144, 0x400000 + dOff);      // p_paddr
      poke64(elfBuf + 152, dataSize);             // p_filesz
      poke64(elfBuf + 160, dataSize);             // p_memsz
      poke64(elfBuf + 168, 0x1000);               // p_align
    }

    EmitWriteFile(path, elfBuf, elfSize);   // #1682
    free(elfBuf, elfSize);
  }

  // #1740: Offset des Datenbereichs (ab self.code, also mit _start-Rumpf).
  // Steht am Klassenende, damit die VMT sich nicht verschiebt.
  pub fn SetDataOff(off: int64) { self.dataOff := off; }

  // #1740: Code-Offset von main. Muss VOR Build gesetzt werden — der
  // _start-Rumpf entsteht dort.
  pub fn SetMainOff(off: int64) { self.mainOff := off; }
};
