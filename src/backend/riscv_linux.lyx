      // wie im Linux-Zweig von emit_arm64.lyx, die beiden muessen
      // uebereinstimmen.
      self.rv_MV(RV_T0, 26);                                 // t0 = argv (s10)
      self.rv_LI(RV_A0, 0);
      var gaLoop: int64 := self.codeLen;
      self.rv_LD(RV_T1, RV_T0, 0);
      self.rv_BEQZ_fwd(RV_T1, 16);                           // NULL → hinter die Schleife
      self.rv_ADDI(RV_A0, RV_A0, 1);
      self.rv_ADDI(RV_T0, RV_T0, 8);
      self.rv_JAL_x0(gaLoop - self.codeLen);
    } else if id == 18 {
      self.rv_MV(RV_A0, 26);                                 // #2110: GetArgV = s10
    } else if id == 235 {
      // #2110: ArgvGet(argv, i) — dieselbe Rechnung wie im Linux-Zweig von
      // emit_arm64.lyx: argv[i], ein NULL vor dem Index liefert 0.
      self.rv_LD(RV_T0, RV_FP, self.slotOff(sBase));         // argv
      self.rv_LD(RV_T1, RV_FP, self.slotOff(sBase + 1));     // i
      var avLoop: int64 := self.codeLen;
      self.rv_BEQZ_fwd(RV_T1, 24);                           // i == 0 → nehmen
      self.rv_LD(RV_T2, RV_T0, 0);
      self.rv_BEQZ_fwd(RV_T2, 24);                           // NULL → 0
      self.rv_ADDI(RV_T0, RV_T0, 8);
      self.rv_ADDI(RV_T1, RV_T1, 0 - 1);
      self.rv_JAL_x0(avLoop - self.codeLen);
      self.rv_LD(RV_A0, RV_T0, 0);                           // nehmen
      self.rv_JAL_x0(8);
      self.rv_LI(RV_A0, 0);
    } else if id == 221 || id == 224 || id == 225 || id == 226 || id == 227 {
      // #2104: close / rename / unlink / mkdir / exit — dieselbe Rechnung wie
      // im Linux-Zweig von emit_arm64.lyx, die beiden muessen uebereinstimmen
      // (generische Linux-ABI: close 57, unlinkat 35, mkdirat 34, renameat2
      // 276 — riscv64 hat kein renameat —, exit_group 94).
      if (id == 221 || id == 227) {
        self.rv_LD(RV_A0, RV_FP, self.slotOff(sBase));       // fd / Code
        if (id == 221) { self.rv_LI(RV_A7, RV_SYS_CLOSE); }
        else           { self.rv_LI(RV_A7, 94); }            // exit_group
      } else if (id == 224) {
        self.rv_LI(RV_A0, 0 - 100);                          // AT_FDCWD
        self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));       // alt
        self.rv_LI(RV_A2, 0 - 100);                          // AT_FDCWD
        self.rv_LD(RV_A3, RV_FP, self.slotOff(sBase + 1));   // neu
        self.rv_LI(RV_A4, 0);                                // flags
        self.rv_LI(RV_A7, 276);                              // renameat2
      } else {
        self.rv_LI(RV_A0, 0 - 100);                          // AT_FDCWD
        self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));       // path
        if (id == 225) {
          self.rv_LI(RV_A2, 0);                              // flags
          self.rv_LI(RV_A7, 35);                             // unlinkat
        } else {
          self.rv_LD(RV_A2, RV_FP, self.slotOff(sBase + 1)); // mode
          self.rv_LI(RV_A7, 34);                             // mkdirat
        }
      }
      self.rv_ECALL();
    } else if id == 222 || id == 223 {
      // #1740: read(fd, buf, len) / write(fd, buf, len). Ohne sie scheiterte
      // schon `PrintLn` — laut immerhin, aber eben ohne Ausgabe. Die drei
      // Argumente stehen ab argBase (ir_lower legt sie dort ab), das Ergebnis
      // kommt wie ueberall ueber a0 zurueck. `open` bleibt bewusst offen: auf
      // riscv64 gibt es nur openat(56) mit vier Argumenten, das braucht eine
      // eigene Umsetzung statt einer geratenen Nummer.
      self.rv_LD(RV_A0, RV_FP, self.slotOff(sBase));
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase + 1));
      self.rv_LD(RV_A2, RV_FP, self.slotOff(sBase + 2));
      if (id == 222) { self.rv_LI(RV_A7, RV_SYS_READ); }
      if (id == 223) { self.rv_LI(RV_A7, RV_SYS_WRITE); }
      self.rv_ECALL();
    } else if id == 228 || id == 231 || id == 232 {
      // #2260: lseek / pipe / truncate — dieselbe Umsetzung wie im
      // arm64-Backend (generische Linux-Nummern: lseek 62, truncate 45,
      // pipe2 59 mit Flags 0); die beiden muessen uebereinstimmen.
      self.rv_LD(RV_A0, RV_FP, self.slotOff(sBase));
      if (id == 228) {
        self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase + 1));
        self.rv_LD(RV_A2, RV_FP, self.slotOff(sBase + 2));
        self.rv_LI(RV_A7, 62);
      } else if (id == 232) {
        self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase + 1));
        self.rv_LI(RV_A7, 45);
      } else {
        self.rv_LI(RV_A1, 0);
        self.rv_LI(RV_A7, 59);
      }
      self.rv_ECALL();
    } else if id == 203 || id == 209 || id == 204 || id == 205 {
      // #1388: poke8/16/32/64 — Adresse und Wert stehen im Argumentblock.
      // #1740: Hier standen weiterhin die festen Slots 0 und 1, obwohl der
      // Kommentar am Kopf dieser Methode genau davor warnt und der peek-Zweig
      // daneben laengst ab argBase liest. poke64 schrieb damit auf die Adresse
      // aus einem fremden Slot — bei `poke64(alloc(64), x)` auf die 0.
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));
      self.rv_LD(RV_A2, RV_FP, self.slotOff(sBase + 1));
      if (id == 203) { self.rv_SB(RV_A2, RV_A1, 0); }
      if (id == 209) { self.rv_SH(RV_A2, RV_A1, 0); }
      if (id == 204) { self.rv_SW(RV_A2, RV_A1, 0); }
      if (id == 205) { self.rv_SD(RV_A2, RV_A1, 0); }
      self.rv_LI(RV_A0, 0);
    } else {
      // #1388: Bis 1.1.0A gab es hier KEINEN Default. Eine unbekannte
      // Builtin-ID erzeugte gar nichts, und der Aufruf lieferte, was zufaellig
      // in a0 stand — derselbe stille Default wie bei den Opcodes in #1339,
      // nur eine Ebene tiefer und ohne Meldung.
      self._builtinUnsupportedRV(id);
    }
    self.rv_MV(RV_T0, RV_A0);
    self.rv_storeSlot(dest);
  }

  fn _builtinUnsupportedRV(id: int64) {
    EPrintStr("error: riscv: Builtin-ID "c);
    EPrintInt(id);
    EPrintStrLn(" wird nicht behandelt"c);
    EPrintStrLn("  Die IDs sind ein globaler Namensraum ueber alle Backends."c);
    EPrintStrLn("  Vergabe und Belegung stehen in src/backend/_builtin_ids.md."c);
    exit(1);
  }

  // --------------------------------------------------------------------------
  // Function emitter
  // --------------------------------------------------------------------------

  fn emitFunc(funcId: int64) {
    if funcId >= self.funcCap {
      EPrintStr("error: riscv: Funktion "c); EPrintInt(funcId);
      EPrintStrLn(" liegt jenseits der Funktionstabelle (#2112)."c);
      exit(1);
    }
    poke64(self.funcAddrs + funcId * 8, self.codeLen);
    self.funcCount := self.funcCount + 1;
    // #1740: Anfang von main merken. Der _start-Rumpf sprang fest auf die
    // ZUERST erzeugte Funktion; stand main nicht an erster Stelle, lief das
    // Programm in eine fremde Funktion und lieferte deren Wert.
    if self.isMainFunc(funcId) != 0 { self.mainOff := self.codeLen; }
    self.stackSize  := 0;
    self.labelCount := 0;
    // #1740: patchCount wird NICHT zurueckgesetzt. Aufruf-Patches muessen die
    // Funktion ueberleben, sonst kann der Durchlauf am Ende von emit() die
    // Vorwaertsaufrufe nicht mehr aufloesen. Aufgeloeste Eintraege sind mit
    // labelId = -2 markiert und werden uebersprungen.
    var li: int64 := 0;
    while li < self.labelCap { poke64(self.labelAddrs + li * 8, -1); li := li + 1; }
    self.slotRecCur := self._slotRecVon(funcId);   // #2270
    self.calcStackFrame(funcId);
    self.emitPrologue();
    // #1740: eingehende Argumentregister a0..a7 in die Param-Slots spillen.
    // Ohne das las ein LOAD_LOCAL eines Parameters uninitialisierten Stapel —
    // `alloc(size)` bekam seine Groesse also nie zu sehen. Die Parameter
    // liegen hinter dem Kratzstreifen (IR_BARG_SLOTS), wie bei arm64 (#1388).
    var pSpillCount: int64 := peek64(peek64(self.ir + 80) + funcId * 80 + 40);
    var pSpillI: int64 := 0;
    while pSpillI < pSpillCount {
      if pSpillI < 8 {
        self.rv_SD(RV_A0 + pSpillI, RV_FP, self.slotOff(IR_BARG_SLOTS + pSpillI));
      } else {
        // #2132: Parameter ab dem neunten liegen nach dem RISC-V-psABI beim
        // Aufrufer auf dem Stapel, 8-Byte-Plaetze ab dessen sp — hier
        // [s0+32], ueber dem geretteten s0/ra/s11 (#2140). Bis 1.2.15A
        // blieben diese Slots unbeschrieben.
        self.rv_LD(RV_T0, RV_FP, 32 + (pSpillI - 8) * 8);
        self.rv_SD(RV_T0, RV_FP, self.slotOff(IR_BARG_SLOTS + pSpillI));
      }
      pSpillI := pSpillI + 1;
    }
    var instrStart: int64 := self.getFuncInstrStart(funcId);
    var instrCount: int64 := self.getFuncInstrCount(funcId);
    var i: int64 := 0;
    while i < instrCount { self.emitInstr(funcId, instrStart + i); i := i + 1; }
    self.emitEpilogue();
    self.applyPatches();
    self.rv_checkNoOpenPatches(1);   // #2112
    self.slotRecCur := 0;   // #2270: ausserhalb einer Funktion keine Abbildung
  }

  // --------------------------------------------------------------------------
  // Public interface
  // --------------------------------------------------------------------------

  pub fn init(irMod: int64) {
    self.ir         := irMod;
    self.bumpGIdx   := -1;
    self.codeBuf    := alloc(131072);
    self.codeCap    := 131072;
    self.codeLen    := 0;
    self.stackSize  := 0;
    self.labelCap   := 1024;
    self.labelAddrs := alloc(self.labelCap * 8);
    self.labelCount := 0;
    self.patchBuf   := alloc(1024 * 32);
    self.patchCap   := 1024;
    self.patchCount := 0;
    // #2112: war fest 256 — die 257. Funktion bekam keine Adresse, jeder
    // Aufruf dorthin blieb auf dem Platzhalter (Selbstaufruf).
    self.funcCap    := self.getFuncCount() + 1;
    if self.funcCap < 256 { self.funcCap := 256; }
    self.funcAddrs  := alloc(self.funcCap * 8);
    self.funcCount  := 0;
    self.globRelocBuf   := alloc(256 * 16);
    self.globRelocCap   := 256;
    self.globRelocCount := 0;
    self.globalsOff     := -1;
    self.mainOff        := -1;
    self.extCap        := 16;
    self.extBuf        := alloc(self.extCap * 32);
    self.extCount      := 0;
    self.gotRelocCap   := 64;
    self.gotRelocBuf   := alloc(self.gotRelocCap * 16);
    self.gotRelocCount := 0;
    self.gotOff        := -1;
    self.dynStartOff   := -1;
    self.noLibcInit    := 0;
    self.isShared      := 0;
    self.soHuCap       := 8;
    self.soHuTab       := alloc(self.soHuCap * 24);
    self.soHuCount     := 0;
  }

  pub fn emit(): int64 {
    var n: int64 := self.getFuncCount();
    var i: int64 := 0;
    while i < n { self.emitFunc(i); i := i + 1; }
    // #1740: jetzt steht jede Funktionsadresse fest — offene Vorwaertsaufrufe
    // aufloesen.
    // #2162: mit FFI startet main ueber __libc_start_main (wie arm64, WP-A5),
    // damit libc initialisiert ist und exit() die stdio-Puffer leert. Der
    // Startweg steht hinter den Funktionen; sein Aufruf von main wird mit
    // den anderen aufgeloest.
    if self.extCount > 0 && self.noLibcInit == 0 && self.isShared == 0 { self.rv_emitLibcStart(); }
    // #2162: Huellen der .so-Exporte mit Gleitkomma — hinter dem Code, vor
    // den Daten; ihr Aufruf der Lyx-Funktion wird mit den anderen aufgeloest.
    var hu: int64 := 0;
    while hu < self.soHuCount {
      var hr: int64 := self.soHuTab + hu * 24;
      var hs: int64 := peek64(hr + 8);
      poke64(hr + 16, self.rv_emitSoHuelle(peek64(hr), hs & 255, (hs >> 8) & 65535, (hs >> 32) & 3));
      hu := hu + 1;
    }
    self.applyPatches();
    self.rv_checkNoOpenPatches(0);   // #2112
    self.emitGlobalsPool();
    self.applyGlobalRelocs();
    return self.codeLen;
  }

  pub fn getCodeBuf(): int64 { return self.codeBuf; }
  pub fn getCodeLen(): int64 { return self.codeLen; }

  // --------------------------------------------------------------------------
  // IR accessors (same layout as EmitARM64)
  // IR module at self.ir:
  //   +8:  instrBuf ptr
  //   +80: funcBuf ptr
  //   +96: funcCount
  // Func record (80 bytes): +16 instrStart, +24 instrCount, +32 localCount
  // Instr record (80 bytes): +0 op, +8 dest, +16 src1, +24 src2, +40 imm
  // --------------------------------------------------------------------------

  fn getFuncCount(): int64 {
    return peek64(self.ir + 96);
  }

  fn getFuncLocalCount(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    return peek64(funcBuf + funcId * 80 + 32);
  }

  fn getFuncInstrStart(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    return peek64(funcBuf + funcId * 80 + 16);
  }

  fn getFuncInstrCount(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    return peek64(funcBuf + funcId * 80 + 24);
  }

  fn getInstrField(absIdx: int64, fieldOff: int64): int64 {
    var instrBuf: int64 := peek64(self.ir + 8);
    return peek64(instrBuf + absIdx * 80 + fieldOff);
  }

  fn getInstrOp(absIdx: int64): int64    { return self.getInstrField(absIdx, 0); }
  fn getInstrDest(absIdx: int64): int64  { return self.getInstrField(absIdx, 8); }
  fn getInstrSrc1(absIdx: int64): int64  { return self.getInstrField(absIdx, 16); }
  fn getInstrSrc2(absIdx: int64): int64  { return self.getInstrField(absIdx, 24); }
  fn getInstrImmInt(absIdx: int64): int64 { return self.getInstrField(absIdx, 40); }

  // --------------------------------------------------------------------------
  // #1740: globale Variablen
  //
  // Die Methoden stehen am ENDE der Klasse: neue Eintraege weiter oben wuerden
  // die VMT verschieben und den Seed brechen (dieselbe Falle wie im
  // lyxos-Backend).
  // --------------------------------------------------------------------------

  // t2 := Adresse von global[gIdx]  —  AUIPC t2, 0 / ADDI t2, t2, 0, beide
  // Haelften spaeter von applyGlobalRelocs nachgetragen.
  fn emitGlobalAddr(gIdx: int64) {
    self.recordGlobalReloc(self.codeLen, gIdx);
    self.rv_e32(0x17 | (RV_T2 << 7));                 // AUIPC t2, 0
    self.rv_ADDI(RV_T2, RV_T2, 0);                     // ADDI  t2, t2, 0
  }

  fn recordGlobalReloc(codeOff: int64, gIdx: int64) {
    if self.globRelocCount >= self.globRelocCap {
      var nc: int64 := self.globRelocCap * 2;
      var nb: int64 := alloc(nc * 16);
      var ci: int64 := 0;
      while ci < self.globRelocCount * 2 {
        poke64(nb + ci * 8, peek64(self.globRelocBuf + ci * 8));
        ci := ci + 1;
      }
      self.globRelocBuf := nb;
      self.globRelocCap := nc;
    }
    var rec: int64 := self.globRelocBuf + self.globRelocCount * 16;
    poke64(rec + 0, codeOff);
    poke64(rec + 8, gIdx);
    self.globRelocCount := self.globRelocCount + 1;
  }

  // Haengt den Datenbereich hinter den Code: acht Byte je globaler Variable,
  // vorbelegt mit ihrem Initialwert. Davor wird so weit aufgefuellt, dass der
  // Bereich im fertigen Abbild auf einer Seitengrenze beginnt — nur dann
  // koennen Code (r-x) und Daten (rw-) getrennte Segmente werden.
  fn emitGlobalsPool() {
    while ((self.codeLen + RV_START_STUB_LEN) % 4096) != 0 { self.rv_e8(0); }
    self.globalsOff := self.codeLen;
    var gCount: int64 := peek64(self.ir + IR_MOD_OFF_GLOBALLEN);
    var gBuf:   int64 := peek64(self.ir + IR_MOD_OFF_GLOBALBUF);
    var gi: int64 := 0;
    while gi < gCount {
      var v: int64 := 0;
      if gBuf != 0 { v := peek64(gBuf + gi * 8); }
      self.rv_e32(v & 0xFFFFFFFF);
      self.rv_e32((v >> 32) & 0xFFFFFFFF);
      gi := gi + 1;
    }
    // #2162: GOT — je FFI-Symbol acht Byte, die der Lader ueber R_RISCV_64
    // fuellt. Im beschreibbaren Segment, nicht im Code.
    if self.extCount > 0 {
      self.gotOff := self.codeLen;
      var ge: int64 := 0;
      while ge < self.extCount { self.rv_e32(0); self.rv_e32(0); ge := ge + 1; }
    }
  }

  // AUIPC traegt die oberen 20 Bit, ADDI die unteren 12 — und weil ADDI sein
  // Immediate vorzeichenbehaftet addiert, muss der obere Teil aufgerundet
  // werden, sobald Bit 11 gesetzt ist.
  fn applyGlobalRelocs() {
    var i: int64 := 0;
    while i < self.globRelocCount {
      var rec:     int64 := self.globRelocBuf + i * 16;
      var codeOff: int64 := peek64(rec + 0);
      var gIdx:    int64 := peek64(rec + 8);
      var target:  int64 := self.globalsOff + gIdx * 8;
      var delta:   int64 := target - codeOff;
      var hi:      int64 := (delta + 0x800) >> 12;
      var lo:      int64 := delta - (hi << 12);
      self.rv_poke32at(codeOff, 0x17 | (RV_T2 << 7) | ((hi & 0xFFFFF) << 12));
      self.rv_poke32at(codeOff + 4, 0x13 | (RV_T2 << 7) | (RV_T2 << 15) | ((lo & 0xFFF) << 20));
      i := i + 1;
    }
    // #2162: GOT-Ladebefehle — AUIPC t1 / LD t1, dieselbe Teilung.
    var gk: int64 := 0;
    while gk < self.gotRelocCount {
      var grec:  int64 := self.gotRelocBuf + gk * 16;
      var gcOff: int64 := peek64(grec + 0);
      var gDelta: int64 := self.gotOff + peek64(grec + 8) * 8 - gcOff;
      var gHi: int64 := (gDelta + 0x800) >> 12;
      var gLo: int64 := gDelta - (gHi << 12);
      self.rv_poke32at(gcOff, 0x17 | (RV_T1 << 7) | ((gHi & 0xFFFFF) << 12));
      self.rv_poke32at(gcOff + 4, 0x03 | (RV_T1 << 7) | (3 << 12) | (RV_T1 << 15) | ((gLo & 0xFFF) << 20));
      gk := gk + 1;
    }
  }

  // #2227: a0 := Puffer mit a1 Byte aus dem Bump-Block. Dieselbe Rechnung wie
  // cg_emitBumpAtomarIn (src/codegen_x86.lyx) und emitBumpAlloc im
  // arm64-Backend — die drei muessen uebereinstimmen: Zeiger/Ende als zwei
  // Modulvariablen, Bloecke von 64 KiB oder der Anforderung auf Seiten
  // aufgerundet, mmap geprueft (#2144). Vorher ein mmap je StrConcat/StrSub/
  // IntToStr — eine Seite, ein Mapping, nie freigegeben.
  //
  // NICHT atomar: das Backend kennt keine Threads. Kommen sie dazu, braucht
  // der schnelle Weg LR/SC und der langsame eine Sperre.
  //
  // Register: nur a0-a7, t0, t1, t2. StrConcat und StrSub halten t3-t6 ueber
  // die Anforderung hinweg. a1 ist danach die auf 16 aufgerundete Groesse.
  fn rv_bumpAlloc() {
    if self.bumpGIdx < 0 { self.bumpGIdx := _irGlobalsAnhaengen(self.ir, 2); }
    self.rv_ADDI(RV_A1, RV_A1, 15);
    self.rv_e32(0x13 | (RV_A1 << 7) | (7 << 12) | (RV_A1 << 15) | ((0 - 16) & 0xFFF) << 20);   // ANDI a1, a1, -16
    self.emitGlobalAddr(self.bumpGIdx);           // t2 = &Zeiger, t2+8 = &Ende
    self.rv_LD(RV_A0, RV_T2, 0);
    self.rv_LD(RV_A2, RV_T2, 8);
    self.rv_ADD(RV_A3, RV_A0, RV_A1);
    self.rv_Bcond(6, RV_A2, RV_A3, 12);           // BLTU Ende, neu -> langsam
    self.rv_SD(RV_A3, RV_T2, 0);
    var pFertig: int64 := self.codeLen;
    self.rv_JAL_x0(0);                            // -> fertig (nachgetragen)
    // langsam: t1 = max(64 KiB, Groesse auf Seiten aufgerundet)
    self.rv_LI64(RV_T0, 4095);
    self.rv_ADD(RV_T1, RV_A1, RV_T0);
    self.rv_e32(0x13 | (RV_T1 << 7) | (5 << 12) | (RV_T1 << 15) | (12 << 20));   // SRLI t1, t1, 12
    self.rv_SLLI(RV_T1, RV_T1, 12);
    self.rv_LI64(RV_T0, 65536);
    self.rv_Bcond(7, RV_T1, RV_T0, 8);            // BGEU t1, t0 -> behalten
    self.rv_MV(RV_T1, RV_T0);
    self.rv_MV(RV_A6, RV_A1);                     // Groesse; ECALL laesst a1..a7, t* stehen
    self.rv_LI(RV_A0, 0);
    self.rv_MV(RV_A1, RV_T1);
    self.rv_LI(RV_A2, 3);
    self.rv_LI(RV_A3, 34);
    self.rv_LI(RV_A4, 0 - 1);
    self.rv_LI(RV_A5, 0);
    self.rv_LI(RV_A7, RV_SYS_MMAP);
    self.rv_ECALL();
    self.rv_mmapGeprueft();
    self.rv_ADD(RV_A2, RV_A0, RV_T1);
    self.rv_SD(RV_A2, RV_T2, 8);                  // Ende
    self.rv_ADD(RV_A3, RV_A0, RV_A6);
    self.rv_SD(RV_A3, RV_T2, 0);                  // Zeiger
    var rel: int64 := self.codeLen - pFertig;
    var b20:    int64 := (rel >> 20) & 0x1;
    var b10_1:  int64 := (rel >> 1)  & 0x3FF;
    var b11:    int64 := (rel >> 11) & 0x1;
    var b19_12: int64 := (rel >> 12) & 0xFF;
    self.rv_poke32at(pFertig, 0x6F | (b19_12 << 12) | (b11 << 20) | (b10_1 << 21) | (b20 << 31));
  }

  // Code-Offset des Datenbereichs — der ELF-Schreiber trennt daran die
  // Segmente. -1, solange emit() nicht gelaufen ist.
  pub fn getGlobalsOff(): int64 { return self.globalsOff; }

  // #1740: heisst die Funktion "main"? Der Name steht als Offset in den
  // String-Pool des IR-Moduls (Feldpaar nameOff/nameLen im Funktionssatz).
  fn isMainFunc(funcId: int64): int64 {
    var funcBuf: int64 := peek64(self.ir + 80);
    var rec:     int64 := funcBuf + funcId * IR_FUNC_SIZE;
    var nameLen: int64 := peek64(rec + IR_FUNC_OFF_NAMELEN);
    if nameLen != 4 { return 0; }
    var strBufR: int64 := peek64(self.ir + 32);
    var p:       int64 := strBufR + peek64(rec + 0);
    if peek8(p + 0) != 109 { return 0; }   // 'm'
    if peek8(p + 1) != 97  { return 0; }   // 'a'
    if peek8(p + 2) != 105 { return 0; }   // 'i'
    if peek8(p + 3) != 110 { return 0; }   // 'n'
    return 1;
  }

  // Code-Offset von main; -1, wenn das Modul keines hat.
  pub fn getMainOff(): int64 {
    if self.dynStartOff >= 0 { return self.dynStartOff; }   // #2162: _start springt in den libc-Startweg
    return self.mainOff;
  }

  // --------------------------------------------------------------------------
  // #1764: Gleitkomma (D-Erweiterung). Auch diese Methoden stehen am ENDE der
  // Klasse, damit die VMT sich nicht verschiebt.
  // --------------------------------------------------------------------------

  // FLD frd, off(rs1)  — 64-Bit-Ladebefehl, I-Type, funct3=3, opcode=0x07
  fn rv_FLD(frd: int64, rs1: int64, off: int64) {
    if self._rvPasst12(off) == 0 { self._rvWeit(rs1, off); self.rv_FLD(frd, RV_WEIT, 0); return; }   // #2061
    self.rv_e32(0x07 | (frd<<7) | (3<<12) | (rs1<<15) | ((off & 0xFFF)<<20));
  }

  // FSD frs2, off(rs1) — 64-Bit-Speicherbefehl, S-Type, funct3=3, opcode=0x27
  fn rv_FSD(frs2: int64, rs1: int64, off: int64) {
    if self._rvPasst12(off) == 0 { self._rvWeit(rs1, off); self.rv_FSD(frs2, RV_WEIT, 0); return; }   // #2061
    var imm5: int64 := off & 0x1F;
    var imm7: int64 := ((off & 0xFFF) >> 5) & 0x7F;
    self.rv_e32(0x27 | (imm5<<7) | (3<<12) | (rs1<<15) | (frs2<<20) | (imm7<<25));
  }

  // Zweistellige Gleitkomma-Rechnung: FADD.D/FSUB.D/FMUL.D/FDIV.D.
  // Rundungsart 0 (RNE) steht fest im Befehl — die dynamische Art (7) haengt am
  // fcsr, und den setzt hier niemand.
  fn rv_FOP_D(funct7: int64, frd: int64, frs1: int64, frs2: int64) {
    self.rv_e32(0x53 | (frd<<7) | (0<<12) | (frs1<<15) | (frs2<<20) | (funct7<<25));
  }

  // Vergleich: funct3 wählt FLE(0) / FLT(1) / FEQ(2); das Ergebnis (0 oder 1)
  // geht in ein Ganzzahl-Register.
  fn rv_FCMP_D(funct3: int64, rd: int64, frs1: int64, frs2: int64) {
    self.rv_e32(0x53 | (rd<<7) | (funct3<<12) | (frs1<<15) | (frs2<<20) | (0x51<<25));
  }

  // FCVT.D.L frd, rs1 — vorzeichenbehaftete 64-Bit-Zahl nach double (rs2=2).
  fn rv_FCVT_D_L(frd: int64, rs1: int64) {
    self.rv_e32(0x53 | (frd<<7) | (0<<12) | (rs1<<15) | (2<<20) | (0x69<<25));
  }

  // FCVT.L.D rd, frs1 — double nach 64-Bit-Zahl, Rundungsart 1 (RTZ), also
  // abschneiden wie in C und wie auf x86-64 (cvttsd2si).
  fn rv_FCVT_L_D(rd: int64, frs1: int64) {
    self.rv_e32(0x53 | (rd<<7) | (1<<12) | (frs1<<15) | (2<<20) | (0x61<<25));
  }

  // #1764: Der Codepuffer war fest 128 KB gross und wurde nie geprueft. Ein
  // groesseres Programm schrieb einfach darueber hinaus — Heap-Korruption, und
  // der Uebersetzer starb an einer Stelle, die mit der Ursache nichts zu tun
  // hatte. Aufgefallen ist es, als `PrintLn` samt std/io endlich uebersetzte
  // und das Erzeugnis die Grenze riss.
  // #1770: FMV.D.X frd, rs1 — Bitmuster aus einem Ganzzahlregister in ein
  // Gleitkommaregister, ohne Umrechnung (funct7 = 0x79, rs2 = 0).
  fn rv_FMV_D_X(frd: int64, rs1: int64) {
    self.rv_e32(0x53 | (frd<<7) | (0<<12) | (rs1<<15) | (0<<20) | (0x79<<25));
  }

  // #1770: FMV.X.D rd, frs1 — Bitmuster aus einem Gleitkommaregister zurueck
  // in ein Ganzzahlregister (funct7 = 0x71, rs2 = 0).
  fn rv_FMV_X_D(rd: int64, frs1: int64) {
    self.rv_e32(0x53 | (rd<<7) | (0<<12) | (frs1<<15) | (0<<20) | (0x71<<25));
  }

  // #1770: FCVT.L.D mit waehlbarer Rundungsart (0 = zur naechsten geraden,
  // 1 = abschneiden, 2 = abwaerts, 3 = aufwaerts).
  fn rv_FCVT_L_D_rm(rd: int64, frs1: int64, rm: int64) {
    self.rv_e32(0x53 | (rd<<7) | (rm<<12) | (frs1<<15) | (2<<20) | (0x61<<25));
  }

  // #1770: fFloor / fCeil / fRound. x86 hat dafuer `roundsd`; RV64GC hat
  // keinen Befehl, der einen double auf einen ganzen double rundet, also geht
  // der Weg ueber die Ganzzahl: FCVT.L.D mit der passenden Rundungsart und
  // zurueck mit FCVT.D.L.
  //
  // Werte jenseits von 2^63 passen in keine Ganzzahl — FCVT.L.D liefert dann
  // 0x8000000000000000. Solche Werte sind ohnehin ganzzahlig, also kommt das
  // Bitmuster unveraendert zurueck. Ohne diese Abfrage waere aus einer sehr
  // grossen Zahl still die kleinste negative geworden.
  //
  // rm: 2 = abwaerts (fFloor), 3 = aufwaerts (fCeil), 0 = zur naechsten
  // geraden Zahl (fRound — dasselbe wie roundsd-Modus 0 auf dem x86-Weg,
  // 2.5 wird dort zu 2.0 und -2.5 zu -2.0).
  fn emitRundeRV(bitsSlot: int64, rm: int64) {
    self.rv_LD(28, RV_FP, self.slotOff(bitsSlot));   // t3 = Bitmuster
    self.rv_FMV_D_X(0, 28);
    self.rv_FCVT_L_D_rm(30, 0, rm);                  // t5 = gerundete Ganzzahl
    self.rv_LI64(31, 0 - 9223372036854775807 - 1);   // 0x8000000000000000
    self.rv_XOR(RV_T2, 30, 31);
    var bPasst: int64 := self.codeLen; self.rv_e32(0);
    self.rv_MV(RV_A0, 28);                           // passt nicht → unveraendert
    var jEnde: int64 := self.codeLen; self.rv_e32(0);
    var lPasst: int64 := self.codeLen;
    self.rv_FCVT_D_L(1, 30);
    self.rv_FMV_X_D(RV_A0, 1);
    var lEnde: int64 := self.codeLen;
    self.rv_poke32at(bPasst, self.rv_buildBtype(1, RV_T2, RV_ZERO, lPasst - bPasst));
    self.rv_poke32at(jEnde,  self.rv_buildJAL(0, lEnde - jEnde));
  }

  // #1770: Ziffern einer nichtnegativen Zahl in den Puffer schreiben.
  // reg = Wert, ptrReg = Schreibmarke (wird weitergezaehlt), stellen = feste
  // Stellenzahl mit fuehrenden Nullen, oder 0 fuer „so viele wie noetig".
  // Gerechnet wird ueber einen absteigenden Teiler; das kommt ohne zweiten
  // Puffer aus, in den man rueckwaerts schreiben muesste.
  fn emitZiffern(reg: int64, ptrReg: int64, stellen: int64) {
    // t1 = Teiler
    if stellen > 0 {
      var teiler: int64 := 1;
      var si: int64 := 1;
      while si < stellen { teiler := teiler * 10; si := si + 1; }
      self.rv_LI64(RV_T1, teiler);
    } else {
      self.rv_ADDI(RV_T1, RV_ZERO, 1);
      // solange Wert / Teiler >= 10: Teiler mal zehn
      var gLoop: int64 := self.codeLen;
      self.rv_DIV(RV_T2, reg, RV_T1);
      self.rv_ADDI(RV_T0, RV_ZERO, 10);
      self.rv_SLT(RV_T2, RV_T2, RV_T0);      // t2 = (Wert/Teiler < 10)
      self.rv_BEQZ_fwd(RV_T2, 8);            // noch zu gross → weiter vergroessern
      // Ausstieg: das Ziel wird NACHGETRAGEN. Von Hand gezaehlt stand hier 12,
      // also der Ruecksprung selbst statt der Befehl dahinter — die Schleife
      // lief endlos. Gezaehlte Sprungweiten sind in diesem Backend generell
      // die falsche Technik (rv_LI64 allein erzeugt zwei oder elf Befehle).
      var gRaus: int64 := self.codeLen; self.rv_e32(0);
      self.rv_ADDI(RV_T0, RV_ZERO, 10);
      self.rv_MUL(RV_T1, RV_T1, RV_T0);
      self.rv_JAL_x0(gLoop - self.codeLen);
      self.rv_poke32at(gRaus, self.rv_buildJAL(0, self.codeLen - gRaus));
    }
    // Ausgabeschleife: Ziffer = (Wert / Teiler) % 10
    var zLoop: int64 := self.codeLen;
    self.rv_DIV(RV_T2, reg, RV_T1);
    self.rv_ADDI(RV_T0, RV_ZERO, 10);
    self.rv_REM(RV_T2, RV_T2, RV_T0);
    self.rv_ADDI(RV_T2, RV_T2, 48);          // '0'
    self.rv_SB(RV_T2, ptrReg, 0);
    self.rv_ADDI(ptrReg, ptrReg, 1);
    self.rv_ADDI(RV_T0, RV_ZERO, 10);
    self.rv_DIV(RV_T1, RV_T1, RV_T0);        // Teiler /= 10
    self.rv_BEQZ_fwd(RV_T1, 8);              // Teiler 0 → fertig
    self.rv_JAL_x0(zLoop - self.codeLen);
  }

  // #1770: f64 als Text in einen frischen Puffer; Zeiger nach a0.
  //
  // Format wie auf dem x86-Weg: Vorzeichen, ganzer Teil, Punkt, GENAU sechs
  // Nachkommastellen, abgeschnitten statt gerundet (2.675 wird dort zu
  // 2.674999, weil die Zahl selbst schon darunter liegt). nan und inf werden
  // an den Bits erkannt, ein zu grosser Wert meldet sich als "overflow" statt
  // eine Zahl zu erfinden — dieselbe Entscheidung wie im lyxos-Backend.
  //
  // Alle Spruenge werden NACHGETRAGEN statt mit gezaehlten Weiten emittiert:
  // rv_LI64 erzeugt je nach Wert zwei oder elf Befehle, eine von Hand
  // gezaehlte Weite ist also von vornherein falsch.
  //
  // Register: a0 = Puffer, t3 = Bits, t4 = Schreibmarke, t5/t6 = Rechenwerte.
  fn emitF64ToStrRV(bitsSlot: int64) {
    // Puffer: 48 Byte aus dem Bump-Block (#2227, vorher ein mmap je Aufruf)
    self.rv_LI(RV_A1, 48);
    self.rv_bumpAlloc();
    self.rv_MV(29, RV_A0);                       // t4 = Schreibmarke
    self.rv_LD(28, RV_FP, self.slotOff(bitsSlot));   // t3 = Bitmuster

    // Sonderfaelle: nach dem Verdoppeln faellt das Vorzeichen heraus.
    // 0xFFE0000000000000 ist unendlich, alles darueber ist NaN.
    self.rv_ADD(30, 28, 28);                     // t5 = Bits * 2
    self.rv_LI64(31, 0 - 9007199254740992);      // t6 = 0xFFE0000000000000
    self.rv_SLTU(RV_T2, 31, 30);                 // t2 = (t6 < t5) → NaN
    var bKeinNan: int64 := self.codeLen; self.rv_e32(0);
    self.rv_LI64(RV_T0, 7233902);                // 'n','a','n',0
    self.rv_SW(RV_T0, 29, 0);
    self.rv_ADDI(29, 29, 3);
    var jNanEnde: int64 := self.codeLen; self.rv_e32(0);

    var lKeinNan: int64 := self.codeLen;
    self.rv_XOR(RV_T2, 30, 31);                  // gleich → unendlich
    var bKeinInf: int64 := self.codeLen; self.rv_e32(0);   // BNE waere umgekehrt: hier BEQ auf t2
    self.rv_LI64(RV_T0, 6712937);                // 'i','n','f',0
    self.rv_SW(RV_T0, 29, 0);
    self.rv_ADDI(29, 29, 3);
    var jInfEnde: int64 := self.codeLen; self.rv_e32(0);

    // Endlicher Wert. f0 = Zahl, f1 = 0.0
    var lZahl: int64 := self.codeLen;
    self.rv_FMV_D_X(0, 28);
    self.rv_FMV_D_X(1, RV_ZERO);
    self.rv_FCMP_D(1, RV_T2, 0, 1);              // t2 = (f0 < 0.0)
    var bNichtNeg: int64 := self.codeLen; self.rv_e32(0);
    self.rv_ADDI(RV_T0, RV_ZERO, 45);            // '-'
    self.rv_SB(RV_T0, 29, 0);
    self.rv_ADDI(29, 29, 1);
    self.rv_e32(0x53 | (0 << 7) | (1 << 12) | (0 << 15) | (0 << 20) | (0x11 << 25));  // FSGNJN.D f0,f0,f0

    // Traegt eine 64-Bit-Zahl den ganzen Teil? 0x8000000000000000 heisst nein.
    var lPositiv: int64 := self.codeLen;
    self.rv_FCVT_L_D(30, 0);                     // t5 = (int64) f0, abgeschnitten
    self.rv_LI64(31, 0 - 9223372036854775807 - 1);
    self.rv_XOR(RV_T2, 30, 31);
    var bPasst: int64 := self.codeLen; self.rv_e32(0);   // t2 == 0 → passt NICHT
    self.rv_LI64(RV_T0, 1919252079);             // 'o','v','e','r'
    self.rv_SW(RV_T0, 29, 0);
    self.rv_LI64(RV_T0, 2003790950);             // 'f','l','o','w'
    self.rv_SW(RV_T0, 29, 4);
    self.rv_ADDI(29, 29, 8);
    var jBigEnde: int64 := self.codeLen; self.rv_e32(0);

    // Ganzer Teil, Punkt, sechs Nachkommastellen.
    var lZiffern: int64 := self.codeLen;
    self.emitZiffern(30, 29, 0);
    self.rv_ADDI(RV_T0, RV_ZERO, 46);            // '.'
    self.rv_SB(RV_T0, 29, 0);
    self.rv_ADDI(29, 29, 1);
    self.rv_FCVT_D_L(1, 30);                     // f1 = (double) ganzer Teil
    self.rv_FOP_D(0x05, 0, 0, 1);                // f0 = f0 - f1
    self.rv_LI64(RV_T0, 4696837146684686336);    // 1e6 als IEEE-754
    self.rv_FMV_D_X(1, RV_T0);
    self.rv_FOP_D(0x09, 0, 0, 1);                // f0 = f0 * 1e6
    self.rv_FCVT_L_D(30, 0);                     // t5 = Nachkommastellen
    self.emitZiffern(30, 29, 6);

    // ende: Nullbyte. a0 zeigt noch auf den Pufferanfang.
    var lEnde: int64 := self.codeLen;
    self.rv_SB(RV_ZERO, 29, 0);

    // Spruenge nachtragen. BEQ t2, x0 springt, wenn die Bedingung NICHT gilt.
    self.rv_poke32at(bKeinNan,  self.rv_buildBtype(0, RV_T2, RV_ZERO, lKeinNan - bKeinNan));
    self.rv_poke32at(bKeinInf,  self.rv_buildBtype(1, RV_T2, RV_ZERO, lZahl - bKeinInf));
    self.rv_poke32at(bNichtNeg, self.rv_buildBtype(0, RV_T2, RV_ZERO, lPositiv - bNichtNeg));
    self.rv_poke32at(bPasst,    self.rv_buildBtype(1, RV_T2, RV_ZERO, lZiffern - bPasst));
    self.rv_poke32at(jNanEnde,  self.rv_buildJAL(0, lEnde - jNanEnde));
    self.rv_poke32at(jInfEnde,  self.rv_buildJAL(0, lEnde - jInfEnde));
    self.rv_poke32at(jBigEnde,  self.rv_buildJAL(0, lEnde - jBigEnde));
  }

  // #2151: rv_SLTU stand hier ein zweites Mal (gleicher Befehl wie oben).

  fn growCode(need: int64) {
    if (self.codeLen + need) <= self.codeCap { return; }
    var nc: int64 := self.codeCap * 2;
    while (self.codeLen + need) > nc { nc := nc * 2; }
    var nb: int64 := alloc(nc);
    var i: int64 := 0;
    while i < self.codeLen { poke8(nb + i, peek8(self.codeBuf + i)); i := i + 1; }
    self.codeBuf := nb;
    self.codeCap := nc;
  }

  // #2061: 1, wenn v in einen vorzeichenbehafteten Zwoelf-Bit-Direktwert passt.
  fn _rvPasst12(v: int64): int64 {
    if v >= 0 - 2048 && v <= 2047 { return 1; }
    return 0;
  }

  // #2061: RV_WEIT := rs1 + off, fuer Versaetze ausserhalb von zwoelf Bit.
  // Danach wird mit `…, 0(RV_WEIT)` zugegriffen. Das Gegenstueck auf arm64 ist
  // _emitFarAddr (#1388) — dort endet die Reichweite bei 4095, hier nicht:
  // rv_LI64 baut jeden 64-Bit-Wert.
  fn _rvWeit(rs1: int64, off: int64) {
    self.rv_LI64(RV_WEIT, off);
    self.rv_ADD(RV_WEIT, rs1, RV_WEIT);
  }

  // --------------------------------------------------------------------------
  // #2162: FFI nach LP64D. Am Klassenende (VMT, siehe oben).
  //
  // Lyx fuehrt jeden Wert in einem Ganzzahlslot, f64 als Bitmuster, f32 als
  // double (#1127). C erwartet nach LP64D Ganzzahlen/Zeiger in a0..a7 und
  // Gleitkomma in fa0..fa7, GETRENNT gezaehlt; ist die Gleitkommareihe voll,
  // geht der Wert nach der Ganzzahlregel weiter (Register, dann Stapel), ein
  // f32 dann als single in den unteren 32 Bit. Variadische Argumente hinter
  // der Deklaration haben keine Klasse (Maske 0) und gehen in die
  // Ganzzahlreihe — das ist auf riscv auch fuer Gleitkomma richtig.
  // Dieselbe Klasseneinteilung wie _a64FfiArgs (arm64) und der SysV-Weg in
  // codegen_x86.lyx; die drei muessen uebereinstimmen.
  // --------------------------------------------------------------------------

  pub fn setNoLibcInit(v: int64) { self.noLibcInit := v; }
  pub fn setShared(v: int64) { self.isShared := v; }
  pub fn getFuncAddrs(): int64 { return self.funcAddrs; }

  // Huelle vormerken (vor emit); liefert ihren Index fuer getSoHuelleOff.
  pub fn addSoHuelle(funcId: int64, sig: int64): int64 {
    if self.soHuCount >= self.soHuCap {
      var nc: int64 := self.soHuCap * 2;
      var nb: int64 := alloc(nc * 24);
      memcpy(nb, self.soHuTab, self.soHuCount * 24);
      self.soHuTab := nb; self.soHuCap := nc;
    }
    var r: int64 := self.soHuTab + self.soHuCount * 24;
    poke64(r, funcId); poke64(r + 8, sig); poke64(r + 16, 0 - 1);
    self.soHuCount := self.soHuCount + 1;
    return self.soHuCount - 1;
  }
  pub fn getSoHuelleOff(i: int64): int64 { return peek64(self.soHuTab + i * 24 + 16); }

  // C ruft einen Lyx-Export: Ganzzahlen in a0..a7, Gleitkomma in fa0..fa7
  // (getrennt gezaehlt, f32 als single). Lyx erwartet alles der Reihe nach
  // in a0..a7, f64 als Bitmuster, f32 als double (#1127). Die Huelle legt um
  // — von hinten nach vorn, denn Parameter i kommt aus a_q mit q <= i und
  // ein spaeteres Ziel ueberschreibt so keine noch gebrauchte Quelle —, ruft
  // die Funktion und legt ein Gleitkommaergebnis nach fa0. Dieselbe Aufgabe
  // wie emitSoHuelle (arm64) und cg_soEmitHuellen (x86); die drei muessen
  // uebereinstimmen.
  fn rv_emitSoHuelle(funcId: int64, n: int64, arten: int64, rueck: int64): int64 {
    if n > 8 {
      EPrintStrLn("error: riscv --shared: Export mit Gleitkomma und mehr als acht Parametern ist nicht umgesetzt (#2162)."c);
      exit(1);
    }
    var start: int64 := self.codeLen;
    self.rv_ADDI(RV_SP, RV_SP, 0 - 16);
    self.rv_SD(RV_RA, RV_SP, 0);
    var i: int64 := n - 1;
    while i >= 0 {
      var c: int64 := (arten >> (i * 2)) & 3;
      var q: int64 := 0;
      var j: int64 := 0;
      while j < i {
        var cj: int64 := (arten >> (j * 2)) & 3;
        if (cj == 0) == (c == 0) { q := q + 1; }
        j := j + 1;
      }
      if c == 0 {
        if q != i { self.rv_MV(RV_A0 + i, RV_A0 + q); }
      } else if c == 1 {
        self.rv_FMV_X_D(RV_A0 + i, 10 + q);                              // a_i := fa_q
      } else {
        self.rv_e32(0x53 | ((10 + q) << 15) | (0x21 << 25));             // FCVT.D.S ft0, fa_q
        self.rv_FMV_X_D(RV_A0 + i, 0);
      }
      i := i - 1;
    }
    var callOff: int64 := self.codeLen;
    self.rv_e32(0x17 | (RV_RA << 7));                                     // AUIPC ra, 0
    self.rv_e32(0x67 | (RV_RA << 7) | (RV_RA << 15));                     // JALR ra, 0(ra)
    self.addPatch(callOff, funcId, RV_PATCH_BL, 0);
    if rueck == 1 { self.rv_FMV_D_X(10, RV_A0); }                         // fa0 := a0
    if rueck == 2 {
      self.rv_FMV_D_X(0, RV_A0);
      self.rv_e32(0x53 | (10 << 7) | (1 << 20) | (0x20 << 25));           // FCVT.S.D fa0, ft0
    }
    self.rv_LD(RV_RA, RV_SP, 0);
    self.rv_ADDI(RV_SP, RV_SP, 16);
    self.rv_RET();
    return start;
  }
  pub fn getExternBuf(): int64 { return self.extBuf; }
  pub fn getExternCount(): int64 { return self.extCount; }
  pub fn getGotOff(): int64 { return self.gotOff; }

  // Symbol eintragen (gleicher Name = gleicher GOT-Platz); liefert den Index.
  fn rv_externIdx(np: int64, nl: int64, lp: int64, ll: int64): int64 {
    var i: int64 := 0;
    while i < self.extCount {
      var b: int64 := self.extBuf + i * 32;
      if peek64(b + 8) == nl {
        var g: int64 := 1;
        var j: int64 := 0;
        while j < nl && g != 0 { if peek8(peek64(b) + j) != peek8(np + j) { g := 0; } j := j + 1; }
        if g != 0 { return i; }
      }
      i := i + 1;
    }
    if self.extCount >= self.extCap {
      var nc: int64 := self.extCap * 2;
      var nb: int64 := alloc(nc * 32);
      memcpy(nb, self.extBuf, self.extCount * 32);
      self.extBuf := nb; self.extCap := nc;
    }
    var e: int64 := self.extBuf + self.extCount * 32;
    poke64(e, np); poke64(e + 8, nl); poke64(e + 16, lp); poke64(e + 24, ll);
    self.extCount := self.extCount + 1;
    return self.extCount - 1;
  }

  // t1 := GOT[extIdx]  (AUIPC/LD, von applyGlobalRelocs nachgetragen)
  fn rv_ladeGot(extIdx: int64) {
    if self.gotRelocCount >= self.gotRelocCap {
      var nc: int64 := self.gotRelocCap * 2;
      var nb: int64 := alloc(nc * 16);
      memcpy(nb, self.gotRelocBuf, self.gotRelocCount * 16);
      self.gotRelocBuf := nb; self.gotRelocCap := nc;
    }
    var r: int64 := self.gotRelocBuf + self.gotRelocCount * 16;
    poke64(r, self.codeLen); poke64(r + 8, extIdx);
    self.gotRelocCount := self.gotRelocCount + 1;
    self.rv_e32(0x17 | (RV_T1 << 7));                          // AUIPC t1, 0
    self.rv_e32(0x03 | (RV_T1 << 7) | (3 << 12) | (RV_T1 << 15));   // LD t1, 0(t1)
  }

  // t0 (double-Bitmuster) -> t0 (single-Bitmuster in den unteren 32 Bit)
  fn rv_t0ZuSingle() {
    self.rv_FMV_D_X(0, RV_T0);
    self.rv_e32(0x53 | (1 << 20) | (0x20 << 25));            // FCVT.S.D ft0, ft0
    self.rv_e32(0x53 | (RV_T0 << 7) | (0x70 << 25));         // FMV.X.W t0, ft0
  }

  fn rv_callExtern(argCount: int64, libStrOff: int64, nameStrOff: int64, dest: int64, argBase: int64, sig: int64) {
    var strBuf: int64 := peek64(self.ir + 32);
    var np: int64 := strBuf + nameStrOff;
    var nl: int64 := StrLen(np as pchar);
    if ((sig >> 53) & 1) != 0 {
      EPrintStr("error: riscv: extern fn '"c); sys_write(2, np, nl);
      EPrintStrLn("': Gleitkommaparameter ab dem neunten sind nicht umgesetzt (#2162)."c);
      EPrintStrLn("  Die Signaturmaske der Deklaration reicht ueber acht Parameter; dahinter ist die Klasse unbekannt."c);
      exit(1);
    }
    var fmask: int64 := (sig >> 32) & 0xFFFF;
    var rb: int64 := argBase;
    if rb < 0 { rb := 0; }
    // Erster Durchgang: wie viele Werte landen auf dem Stapel?
    var nI: int64 := 0;
    var nF: int64 := 0;
    var nSt: int64 := 0;
    var i: int64 := 0;
    while i < argCount {
      var c0: int64 := 0;
      if i < 8 { c0 := (fmask >> (i * 2)) & 3; }
      if c0 != 0 && nF < 8 { nF := nF + 1; }
      else if nI < 8 { nI := nI + 1; }
      else { nSt := nSt + 1; }
      i := i + 1;
    }
    var stBytes: int64 := nSt * 8;
    if (stBytes & 15) != 0 { stBytes := stBytes + 8; }
    if stBytes > 2032 {
      EPrintStr("error: riscv: extern fn '"c); sys_write(2, np, nl);
      EPrintStrLn("': mehr als 2 KB Stapelargumente werden nicht erzeugt (#2162)."c);
      exit(1);
    }
    if stBytes > 0 {
      if argBase < 0 {
        EPrintStrLn("error: riscv: FFI-Aufruf mit Stapelargumenten ohne Argumentblock (#2132, #2162)."c);
        exit(1);
      }
      self.rv_ADDI(RV_SP, RV_SP, 0 - stBytes);
    }
    // Zweiter Durchgang: dieselbe Einteilung, jetzt mit Befehlen.
    nI := 0; nF := 0;
    var si: int64 := 0;
    i := 0;
    while i < argCount {
      var c: int64 := 0;
      if i < 8 { c := (fmask >> (i * 2)) & 3; }
      if c != 0 && nF < 8 {
        self.rv_FLD(10 + nF, RV_FP, self.slotOff(rb + i));        // fa_nF
        if c == 2 { self.rv_e32(0x53 | ((10 + nF) << 7) | ((10 + nF) << 15) | (1 << 20) | (0x20 << 25)); }   // FCVT.S.D
        nF := nF + 1;
      } else {
        self.rv_loadSlot(rb + i);
        if c == 2 { self.rv_t0ZuSingle(); }
        if nI < 8 {
          self.rv_MV(RV_A0 + nI, RV_T0);
          nI := nI + 1;
        } else {
          self.rv_SD(RV_T0, RV_SP, si * 8);
          si := si + 1;
        }
      }
      i := i + 1;
    }
    var lp: int64 := strBuf + libStrOff;
    self.rv_ladeGot(self.rv_externIdx(np, nl, lp, StrLen(lp as pchar)));
    self.rv_e32(0x67 | (RV_RA << 7) | (RV_T1 << 15));          // JALR ra, 0(t1)
    if stBytes > 0 { self.rv_ADDI(RV_SP, RV_SP, stBytes); }
    // Rueckgabe: fa0 (f64/f32) oder a0, schmale Ganzzahlen auf 64 Bit.
    var fret: int64 := (sig >> 48) & 3;
    if fret == 1 {
      self.rv_FMV_X_D(RV_T0, 10);
    } else if fret == 2 {
      self.rv_e32(0x53 | (10 << 15) | (0x21 << 25));          // FCVT.D.S ft0, fa0
      self.rv_FMV_X_D(RV_T0, 0);
    } else {
      self.rv_MV(RV_T0, RV_A0);
      var iw: int64 := (sig >> 50) & 7;
      if iw == 1 { self.rv_SLLI(RV_T0, RV_T0, 56); self.rv_e32(0x13 | (RV_T0 << 7) | (5 << 12) | (RV_T0 << 15) | ((0x400 | 56) << 20)); }   // SRAI 56
      if iw == 2 { self.rv_SLLI(RV_T0, RV_T0, 48); self.rv_e32(0x13 | (RV_T0 << 7) | (5 << 12) | (RV_T0 << 15) | ((0x400 | 48) << 20)); }   // SRAI 48
      if iw == 3 { self.rv_e32(0x1B | (RV_T0 << 7) | (RV_T0 << 15)); }                                                                   // ADDIW t0, t0, 0
      if iw == 4 { self.rv_e32(0x13 | (RV_T0 << 7) | (7 << 12) | (RV_T0 << 15) | (255 << 20)); }                                         // ANDI 255
      if iw == 5 { self.rv_SLLI(RV_T0, RV_T0, 48); self.rv_e32(0x13 | (RV_T0 << 7) | (5 << 12) | (RV_T0 << 15) | (48 << 20)); }          // SRLI 48
      if iw == 6 { self.rv_SLLI(RV_T0, RV_T0, 32); self.rv_e32(0x13 | (RV_T0 << 7) | (5 << 12) | (RV_T0 << 15) | (32 << 20)); }          // SRLI 32
    }
    self.rv_storeSlot(dest);
  }

  // Startweg mit libc (wie der 56-Byte-Rumpf auf arm64, WP-A5):
  //   _start (RiscvLinuxBackend) setzt s10 und springt hierher statt nach main.
  //   lstart: a5 := a0 (rtld_fini vom Lader), a1 := argc, a2 := argv,
  //           a0 := &mtramp, a3 = a4 = 0, a6 := sp, __libc_start_main(...)
  //   mtramp: von libc mit (argc, argv, envp) gerufen — s10 ist callee-saved
  //           und deshalb hier NEU zu setzen (libc hat es zwischendurch
  //           benutzt); gesichert und zurueckgeschrieben, dann main.
  fn rv_emitLibcStart() {
    var mainId: int64 := -1;
    var fi: int64 := 0;
    while fi < self.getFuncCount() {
      if self.isMainFunc(fi) != 0 { mainId := fi; }
      fi := fi + 1;
    }
    if mainId < 0 { return; }   // kein Programm (Bibliothek ohne main)
    var lsm: int64 := self.rv_externIdx("__libc_start_main"c as int64, 17, "libc.so.6"c as int64, 9);
    var mtramp: int64 := self.codeLen;
    self.rv_ADDI(RV_SP, RV_SP, 0 - 16);
    self.rv_SD(RV_RA, RV_SP, 0);
    self.rv_SD(26, RV_SP, 8);                                   // s10
    self.rv_MV(26, RV_A1);                                      // s10 := argv
    var callOff: int64 := self.codeLen;
    self.rv_e32(0x17 | (RV_RA << 7));                           // AUIPC ra, 0
    self.rv_e32(0x67 | (RV_RA << 7) | (RV_RA << 15));           // JALR ra, 0(ra)
    self.addPatch(callOff, mainId, RV_PATCH_BL, 0);
    self.rv_LD(RV_RA, RV_SP, 0);
    self.rv_LD(26, RV_SP, 8);
    self.rv_ADDI(RV_SP, RV_SP, 16);
    self.rv_RET();
    self.dynStartOff := self.codeLen;
    self.rv_MV(RV_A5, RV_A0);                                   // rtld_fini
    self.rv_LD(RV_A1, RV_SP, 0);                                // argc
    self.rv_ADDI(RV_A2, RV_SP, 8);                              // argv
    var d: int64 := mtramp - self.codeLen;
    var dHi: int64 := (d + 0x800) >> 12;
    var dLo: int64 := d - (dHi << 12);
    self.rv_e32(0x17 | (RV_A0 << 7) | ((dHi & 0xFFFFF) << 12));                       // AUIPC a0
    self.rv_e32(0x13 | (RV_A0 << 7) | (RV_A0 << 15) | ((dLo & 0xFFF) << 20));         // ADDI a0
    self.rv_MV(RV_A3, RV_ZERO);
    self.rv_MV(RV_A4, RV_ZERO);
    self.rv_MV(RV_A6, RV_SP);
    self.rv_ladeGot(lsm);
    self.rv_e32(0x67 | (RV_RA << 7) | (RV_T1 << 15));           // JALR ra, 0(t1) — kehrt nicht zurueck
    self.rv_RET();                                              // sonst zurueck in _start (exit)
  }

};

// ============================================================================
// RiscvLinuxBackend  —  _start stub + ELF64-RISCV writer
// ============================================================================

pub type RiscvLinuxBackend = class {
  code:    int64;
  codeLen: int64;
  codeCap: int64;
  dataOff: int64;   // #1740: Offset des Datenbereichs in self.code (0 = keiner)
  mainOff: int64;   // #1740: Code-Offset von main (0 = erste Funktion)
  // #2162: FFI-Symbole des Emitters ({namePtr,nameLen,libPtr,libLen}) und
  // der Offset (ab self.code) ihres ersten GOT-Platzes.
  extBuf:   int64;
  extCount: int64;
  gotOff:   int64;

  fn rlb_ce8(v: int64) {
    // #1764: auch dieser Puffer war fest (64 KB) und ungeprueft.
    if (self.codeLen + 1) > self.codeCap {
      var nc: int64 := self.codeCap * 2;
      while (self.codeLen + 1) > nc { nc := nc * 2; }
      var nb: int64 := alloc(nc);
      var i: int64 := 0;
      while i < self.codeLen { poke8(nb + i, peek8(self.code + i)); i := i + 1; }
      self.code    := nb;
      self.codeCap := nc;
    }
    poke8(self.code + self.codeLen, v & 0xFF);
    self.codeLen := self.codeLen + 1;
  }

  fn rlb_ce32(v: int64) {
    self.rlb_ce8(v);
    self.rlb_ce8(v >> 8);
    self.rlb_ce8(v >> 16);
    self.rlb_ce8(v >> 24);
  }

  // _start stub (28 bytes):
  //   ADDI s10, sp, 8                       (#2110: argv sichern)
  //   LD   a0, 0(sp)                        (#2271: argc an main)
  //   ADDI a1, sp, 8                        (#2271: argv an main)
  //   AUIPC ra, hi / JALR ra, lo(ra)        (#2271: call main, +/-2 GiB)
  //   ADDI a7, x0, 93     = 0x05D00893  (exit syscall)
  //   ECALL               = 0x00000073
  //
  // #1740: Der Sprung ging fest auf Offset 12, also auf die zuerst erzeugte
  // Funktion. Das ist nur dann main, wenn main auch als erste dasteht.
  fn rlb_emitStart(mainOff: int64) {
    // #2110: argv = sp + 8 nach s10 (x26). Beim Eintritt zeigt sp auf argc,
    // dahinter die argv-Zeiger und ein NULL (Linux-ABI). s10 ist callee-saved
    // und wird vom erzeugten Code nie benutzt (s11 ist seit #2061 das
    // Hilfsregister); C-Code erhaelt es nach der ABI. GetArgC zaehlt bis zum
    // NULL, GetArgV liefert s10 — dieselbe Auskunft wie emitArgcArgv auf lyxos.
    self.rlb_ce32(0x00810D13);  // ADDI s10, sp, 8
    // #2271: `main(argc, argv)` bekam auf riscv nichts in a0/a1 — der
    // riscv-Selbstbau las argc 0 und zeigte nur die Hilfe. Der Weg ueber
    // __libc_start_main (lstart) setzt a0/a1 selbst; dort schadet es nicht.
    self.rlb_ce32(0x00013503);  // LD a0, 0(sp)
    self.rlb_ce32(0x00810593);  // ADDI a1, sp, 8
    // #2271: main per AUIPC+JALR statt JAL — der riscv-Selbstbau hat mehr als
    // 1 MiB Code, main liegt dahinter. Hoch/tief geteilt wie RV_PATCH_BL in
    // applyPatches; die beiden muessen uebereinstimmen.
    var off: int64 := RV_START_STUB_LEN + mainOff - 12;   // AUIPC steht bei Offset 12
    var hi: int64 := (off + 0x800) >> 12;
    var lo: int64 := off - (hi << 12);
    self.rlb_ce32(0x17 | (RV_RA << 7) | ((hi & 0xFFFFF) << 12));                          // AUIPC ra, hi
    self.rlb_ce32(0x67 | (RV_RA << 7) | (0 << 12) | (RV_RA << 15) | ((lo & 0xFFF) << 20)); // JALR ra, lo(ra)
    self.rlb_ce32(0x05D00893);  // ADDI a7, x0, 93
    self.rlb_ce32(0x00000073);  // ECALL
  }

  pub fn Init() {
    self.codeCap := 65536;
    self.code    := alloc(self.codeCap);
    self.codeLen := 0;
    self.dataOff := 0;
    self.mainOff := 0;
    self.extBuf   := 0;
    self.extCount := 0;
    self.gotOff   := 0;
  }

  pub fn Build(irBuf: int64, irLen: int64) {
    self.rlb_emitStart(self.mainOff);
    var i: int64 := 0;
    while i < irLen { self.rlb_ce8(peek8(irBuf + i)); i := i + 1; }
  }

  pub fn GetCodeSize(): int64 { return self.codeLen; }

  pub fn WriteELF64(path: pchar) {
    if self.extCount > 0 { self.WriteELF64Dyn(path); return; }   // #2162
    var codeFileOffset: int64 := 4096;
    var codeSize:       int64 := self.codeLen;
    var elfSize:        int64 := codeFileOffset + codeSize;
    // #1740: Grenze zwischen Code (r-x) und Daten (rw-). dataOff zaehlt ab
    // self.code, also einschliesslich _start-Rumpf; der Emitter hat davor so
    // weit aufgefuellt, dass die Grenze auf einer Seite liegt.
    var dataStart: int64 := self.dataOff;
    var dataSize:  int64 := 0;
    if dataStart > 0 { dataSize := codeSize - dataStart; }
    var phnum: int64 := 1;
    if dataSize > 0 { phnum := 2; }

    var elfBuf: int64 := alloc(elfSize);
    if elfBuf == -1 { return; }

    var z: int64 := 0;
    while z < elfSize { poke8(elfBuf + z, 0); z := z + 1; }

    var ci: int64 := 0;
    while ci < codeSize {
      poke8(elfBuf + codeFileOffset + ci, peek8(self.code + ci));
      ci := ci + 1;
    }

    // ELF64 header (64 bytes)
    // e_ident (16 bytes)
    poke8(elfBuf + 0, 127);  poke8(elfBuf + 1, 69);   // 0x7F 'E'
    poke8(elfBuf + 2, 76);   poke8(elfBuf + 3, 70);   // 'L' 'F'
    poke8(elfBuf + 4, 2);    poke8(elfBuf + 5, 1);    // 64-bit, little-endian
    poke8(elfBuf + 6, 1);    poke8(elfBuf + 7, 0);    // ELF v1, SysV ABI
    // remaining 8 bytes of e_ident = 0 (already zeroed)

    poke16(elfBuf + 16, 2);          // e_type: ET_EXEC
    poke16(elfBuf + 18, 0xF3);       // e_machine: EM_RISCV = 243
    poke32(elfBuf + 20, 1);          // e_version: EV_CURRENT
    poke64(elfBuf + 24, 0x401000);   // e_entry: _start VA
    poke64(elfBuf + 32, 64);         // e_phoff: program header at byte 64
    poke64(elfBuf + 40, 0);          // e_shoff: no section headers
    poke32(elfBuf + 48, 0x05);       // e_flags: EF_RISCV_RVC | EF_RISCV_FLOAT_ABI_DOUBLE
    poke16(elfBuf + 52, 64);         // e_ehsize
    poke16(elfBuf + 54, 56);         // e_phentsize
    poke16(elfBuf + 56, phnum);      // e_phnum (#1740: 2 mit Datensegment)
    poke16(elfBuf + 58, 64);         // e_shentsize
    poke16(elfBuf + 60, 0);          // e_shnum
    poke16(elfBuf + 62, 0);          // e_shstrndx

    // PT_LOAD segment header (56 bytes at offset 64)
    // #1740: Ohne Datenbereich laedt wie bisher ein einziges r-x-Segment die
    // ganze Datei. Mit Datenbereich wird bei dataStart getrennt, damit die
    // globalen Variablen beschreibbar sind, ohne dass der Code es wird.
    var codeSegSize: int64 := elfSize;
    if dataSize > 0 { codeSegSize := codeFileOffset + dataStart; }
    poke32(elfBuf + 64, 1);              // p_type: PT_LOAD
    poke32(elfBuf + 68, 5);             // p_flags: PF_R | PF_X
    poke64(elfBuf + 72, 0);             // p_offset: 0 (load whole file)
    poke64(elfBuf + 80, 0x400000);      // p_vaddr
    poke64(elfBuf + 88, 0x400000);      // p_paddr
    poke64(elfBuf + 96, codeSegSize);   // p_filesz
    poke64(elfBuf + 104, codeSegSize);  // p_memsz
    poke64(elfBuf + 112, 0x1000);       // p_align: 4096

    if dataSize > 0 {
      var dOff: int64 := codeFileOffset + dataStart;
      poke32(elfBuf + 120, 1);                    // p_type: PT_LOAD
      poke32(elfBuf + 124, 6);                    // p_flags: PF_R | PF_W
      poke64(elfBuf + 128, dOff);                 // p_offset
      poke64(elfBuf + 136, 0x400000 + dOff);      // p_vaddr
      poke64(elfBuf + 144, 0x400000 + dOff);      // p_paddr
      poke64(elfBuf + 152, dataSize);             // p_filesz
      poke64(elfBuf + 160, dataSize);             // p_memsz
      poke64(elfBuf + 168, 0x1000);               // p_align
    }

    EmitWriteFile(path, elfBuf, elfSize);   // #1682
    free(elfBuf, elfSize);
  }

  // #1740: Offset des Datenbereichs (ab self.code, also mit _start-Rumpf).
  // Steht am Klassenende, damit die VMT sich nicht verschiebt.
  pub fn SetDataOff(off: int64) { self.dataOff := off; }

  // #1740: Code-Offset von main. Muss VOR Build gesetzt werden — der
  // _start-Rumpf entsteht dort.
  pub fn SetMainOff(off: int64) { self.mainOff := off; }

  // #2162: --shared. ET_DYN mit Ladebasis 0, sonst dasselbe Speicherbild
  // (Code r-x ab Dateioffset 4096, Daten rw- ab der Seitengrenze dataOff) —
  // der Code ist durchgehend PC-relativ (AUIPC), Modulvariablen und GOT
  // liegen im Datensegment. dynsym: [0] null, [1..] die FFI-Symbole (UNDEF,
  // R_RISCV_64 auf ihren GOT-Platz), danach die Exporte (GLOBAL FUNC,
  // st_value = Adresse relativ zur Basis). Ein echter SysV-Hash, denn dlsym
  // sucht darueber. Der _start-Rumpf (RV_START_STUB_LEN) bleibt als toter Code stehen:
  // an seiner Laenge haengt die Seitenausrichtung des Emitters.
  // exportBuf: je Export {namePtr, nameLen, codeOff (ab self.code)} — dieselbe
  // Liste wie lyxc.buildExportList.
  pub fn WriteSharedLib(path: pchar, expBuf: int64, expCount: int64) {
    var codeFileOffset: int64 := 4096;
    var codeSize: int64 := self.codeLen;
    var dataStart: int64 := self.dataOff;
    if dataStart <= 0 {
      EPrintStrLn("error: riscv --shared: kein Datensegment (#2162)."c);
      exit(1);
    }
    var nE: int64 := self.extCount;
    var nX: int64 := expCount;
    var nSym: int64 := 1 + nE + nX;
    var dsCap: int64 := 64;
    var k: int64 := 0;
    while k < nE { dsCap := dsCap + peek64(self.extBuf + k * 32 + 8) + peek64(self.extBuf + k * 32 + 24) + 2; k := k + 1; }
    k := 0;
    while k < nX { dsCap := dsCap + peek64(expBuf + k * 24 + 8) + 1; k := k + 1; }
    var dynstr: int64 := alloc(dsCap);
    var dsLen: int64 := 1;
    poke8(dynstr, 0);
    var nameOff: int64 := alloc(nSym * 8);       // dynstr-Offset je Symbol
    var namePtr: int64 := alloc(nSym * 8);
    var nameLen: int64 := alloc(nSym * 8);
    var needOff: int64 := alloc(nE * 8 + 8);
    var nNeed: int64 := 0;
    k := 0;
    while k < nE {
      var lp: int64 := peek64(self.extBuf + k * 32 + 16);
      var ll: int64 := peek64(self.extBuf + k * 32 + 24);
      var neu: int64 := 1;
      var j: int64 := 0;
      while j < k && neu != 0 {
        if peek64(self.extBuf + j * 32 + 24) == ll {
          var gl: int64 := 1;
          var q: int64 := 0;
          while q < ll && gl != 0 { if peek8(peek64(self.extBuf + j * 32 + 16) + q) != peek8(lp + q) { gl := 0; } q := q + 1; }
          if gl != 0 { neu := 0; }
        }
        j := j + 1;
      }
      if neu != 0 {
        poke64(needOff + nNeed * 8, dsLen); nNeed := nNeed + 1;
        memcpy(dynstr + dsLen, lp, ll); dsLen := dsLen + ll; poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
      }
      k := k + 1;
    }
    k := 1;
    while k < nSym {
      var p: int64 := 0; var l: int64 := 0;
      if k <= nE { p := peek64(self.extBuf + (k - 1) * 32); l := peek64(self.extBuf + (k - 1) * 32 + 8); }
      else { p := peek64(expBuf + (k - 1 - nE) * 24); l := peek64(expBuf + (k - 1 - nE) * 24 + 8); }
      poke64(namePtr + k * 8, p); poke64(nameLen + k * 8, l); poke64(nameOff + k * 8, dsLen);
      memcpy(dynstr + dsLen, p, l); dsLen := dsLen + l; poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
      k := k + 1;
    }
    var nBucket: int64 := nSym;
    var dynstrOff: int64 := ((codeFileOffset + codeSize + 7) >> 3) << 3;
    var dynsymOff: int64 := ((dynstrOff + dsLen + 7) >> 3) << 3;
    var hashOff: int64 := dynsymOff + nSym * 24;
    var hashSize: int64 := (2 + nBucket + nSym) * 4;
    var relaOff: int64 := ((hashOff + hashSize + 7) >> 3) << 3;
    var relaSize: int64 := nE * 24;
    var dynOff: int64 := relaOff + relaSize;
    var dynCnt: int64 := nNeed + 9;
    if nE > 0 { dynCnt := dynCnt + 3; }
    var dynSize: int64 := dynCnt * 16;
    var fileSize: int64 := dynOff + dynSize;

    var buf: int64 := alloc(fileSize);
    var z: int64 := 0;
    while z < fileSize { poke8(buf + z, 0); z := z + 1; }
    memcpy(buf + codeFileOffset, self.code, codeSize);
    poke8(buf + 0, 127); poke8(buf + 1, 69); poke8(buf + 2, 76); poke8(buf + 3, 70);
    poke8(buf + 4, 2);   poke8(buf + 5, 1);  poke8(buf + 6, 1);  poke8(buf + 7, 0);
    poke16(buf + 16, 3);          // ET_DYN
    poke16(buf + 18, 0xF3);       // EM_RISCV
    poke32(buf + 20, 1);
    poke64(buf + 24, 0);          // kein Einsprung
    poke64(buf + 32, 64);
    poke32(buf + 48, 0x05);       // RVC | lp64d
    poke16(buf + 52, 64); poke16(buf + 54, 56); poke16(buf + 56, 3);
    poke16(buf + 58, 64);
    var dOff: int64 := codeFileOffset + dataStart;
    var ph: int64 := buf + 64;
    poke32(ph, 1); poke32(ph + 4, 5);
    poke64(ph + 8, 0); poke64(ph + 16, 0); poke64(ph + 24, 0);
    poke64(ph + 32, dOff); poke64(ph + 40, dOff); poke64(ph + 48, 0x1000);
    ph := ph + 56;
    poke32(ph, 1); poke32(ph + 4, 6);
    poke64(ph + 8, dOff); poke64(ph + 16, dOff); poke64(ph + 24, dOff);
    poke64(ph + 32, fileSize - dOff); poke64(ph + 40, fileSize - dOff); poke64(ph + 48, 0x1000);
    ph := ph + 56;
    poke32(ph, 2); poke32(ph + 4, 6);
    poke64(ph + 8, dynOff); poke64(ph + 16, dynOff); poke64(ph + 24, dynOff);
    poke64(ph + 32, dynSize); poke64(ph + 40, dynSize); poke64(ph + 48, 8);

    memcpy(buf + dynstrOff, dynstr, dsLen);
    k := 1;
    while k < nSym {
      var sy: int64 := buf + dynsymOff + k * 24;
      poke32(sy, peek64(nameOff + k * 8));
      poke8(sy + 4, 0x12);                                   // STB_GLOBAL | STT_FUNC
      if k > nE {
        poke16(sy + 6, 1);                                   // definiert (kein SHN_UNDEF/SHN_ABS)
        poke64(sy + 8, codeFileOffset + peek64(expBuf + (k - 1 - nE) * 24 + 16));
      }
      k := k + 1;
    }
    // SysV-Hash: h = (h << 4) + c; g = h & 0xF0000000; h ^= g >> 24; h &= ~g
    poke32(buf + hashOff, nBucket);
    poke32(buf + hashOff + 4, nSym);
    var bucket: int64 := buf + hashOff + 8;
    var chain: int64 := bucket + nBucket * 4;
    k := 1;
    while k < nSym {
      var h: int64 := 0;
      var p2: int64 := peek64(namePtr + k * 8);
      var q2: int64 := 0;
      while q2 < peek64(nameLen + k * 8) {
        h := ((h << 4) + peek8(p2 + q2)) & 0xFFFFFFFF;
        var g: int64 := h & 0xF0000000;
        if g != 0 { h := h ^ (g >> 24); }
        h := h & (0xFFFFFFFF ^ g);
        q2 := q2 + 1;
      }
      var bi: int64 := h % nBucket;
      poke32(chain + k * 4, peek32(bucket + bi * 4));
      poke32(bucket + bi * 4, k);
      k := k + 1;
    }
    k := 0;
    while k < nE {
      var ra: int64 := buf + relaOff + k * 24;
      poke64(ra, codeFileOffset + self.gotOff + k * 8);
      poke64(ra + 8, ((k + 1) << 32) | 2);                   // R_RISCV_64
      k := k + 1;
    }
    var dp: int64 := buf + dynOff;
    k := 0;
    while k < nNeed { poke64(dp, 1); poke64(dp + 8, peek64(needOff + k * 8)); dp := dp + 16; k := k + 1; }
    poke64(dp, 4);  poke64(dp + 8, hashOff);   dp := dp + 16;   // DT_HASH
    poke64(dp, 5);  poke64(dp + 8, dynstrOff); dp := dp + 16;   // DT_STRTAB
    poke64(dp, 6);  poke64(dp + 8, dynsymOff); dp := dp + 16;   // DT_SYMTAB
    poke64(dp, 10); poke64(dp + 8, dsLen);     dp := dp + 16;   // DT_STRSZ
    poke64(dp, 11); poke64(dp + 8, 24);        dp := dp + 16;   // DT_SYMENT
    if nE > 0 {
      poke64(dp, 7); poke64(dp + 8, relaOff);  dp := dp + 16;   // DT_RELA
      poke64(dp, 8); poke64(dp + 8, relaSize); dp := dp + 16;   // DT_RELASZ
      poke64(dp, 9); poke64(dp + 8, 24);       dp := dp + 16;   // DT_RELAENT
    }
    poke64(dp, 30); poke64(dp + 8, 8);         dp := dp + 16;   // DT_FLAGS = DF_BIND_NOW
    poke64(dp, 0);  poke64(dp + 8, 0);                          // DT_NULL
    EmitWriteFile(path, buf, fileSize);
    free(buf, fileSize);
  }

  // #2162: FFI-Symbole und GOT-Offset (ab self.code, mit _start-Rumpf).
  pub fn SetFfi(extBuf: int64, extCount: int64, gotOff: int64) {
    self.extBuf := extBuf; self.extCount := extCount; self.gotOff := gotOff;
  }

  // #2162: dynamisch gelinktes Erzeugnis. Dasselbe Speicherbild wie
  // WriteELF64 (Code r-x ab 0x401000, Daten rw- ab der Seitengrenze dataOff),
  // dazu:
  //   - PT_INTERP /lib/ld-linux-riscv64-lp64d.so.1 (im Kopfbereich),
  //   - hinter den Daten (im rw-Segment) .dynstr, .dynsym, .hash, .rela.dyn
  //     und .dynamic, PT_DYNAMIC zeigt darauf,
  //   - je Symbol eine R_RISCV_64-Relocation auf seinen GOT-Platz (der
  //     Emitter legt die Plaetze hinter die Modulvariablen und laedt sie
  //     PC-relativ). DF_BIND_NOW: alles beim Start, keine PLT.
  // Dieselbe Tabellenfolge wie writeELFExecDynamic (arm64) in lyxc.lyx.
  pub fn WriteELF64Dyn(path: pchar) {
    var baseVA: int64 := 0x400000;
    var codeFileOffset: int64 := 4096;
    var codeSize: int64 := self.codeLen;
    var dataStart: int64 := self.dataOff;
    if dataStart <= 0 {
      EPrintStrLn("error: riscv: FFI ohne Datensegment — der GOT haette keinen Platz (#2162)."c);
      exit(1);
    }
    var interpStr: pchar := "/lib/ld-linux-riscv64-lp64d.so.1"c;
    var interpLen: int64 := StrLen(interpStr) + 1;
    var phnum: int64 := 4;
    var interpOff: int64 := 64 + phnum * 56;
    // .dynstr: \0, Bibliotheken (je einmal), Symbolnamen
    var n: int64 := self.extCount;
    var dsCap: int64 := 64;
    var k: int64 := 0;
    while k < n { dsCap := dsCap + peek64(self.extBuf + k * 32 + 8) + peek64(self.extBuf + k * 32 + 24) + 2; k := k + 1; }
    var dynstr: int64 := alloc(dsCap);
    var dsLen: int64 := 1;
    poke8(dynstr, 0);
    var libStr: int64 := alloc(n * 8 + 8);    // dynstr-Offset der Bibliothek von Symbol k (DT_NEEDED nur fuer den ersten)
    var libNeu: int64 := alloc(n * 8 + 8);    // 1 = erste Nennung dieser Bibliothek
    var symStr: int64 := alloc(n * 8 + 8);
    k := 0;
    while k < n {
      var lp: int64 := peek64(self.extBuf + k * 32 + 16);
      var ll: int64 := peek64(self.extBuf + k * 32 + 24);
      var gef: int64 := -1;
      var j: int64 := 0;
      while j < k && gef < 0 {
        if peek64(self.extBuf + j * 32 + 24) == ll {
          var gl: int64 := 1;
          var q: int64 := 0;
          while q < ll && gl != 0 { if peek8(peek64(self.extBuf + j * 32 + 16) + q) != peek8(lp + q) { gl := 0; } q := q + 1; }
          if gl != 0 { gef := j; }
        }
        j := j + 1;
      }
      if gef >= 0 {
        poke64(libStr + k * 8, peek64(libStr + gef * 8)); poke64(libNeu + k * 8, 0);
      } else {
        poke64(libStr + k * 8, dsLen); poke64(libNeu + k * 8, 1);
        memcpy(dynstr + dsLen, lp, ll); dsLen := dsLen + ll; poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
      }
      var np: int64 := peek64(self.extBuf + k * 32);
      var nl: int64 := peek64(self.extBuf + k * 32 + 8);
      poke64(symStr + k * 8, dsLen);
      memcpy(dynstr + dsLen, np, nl); dsLen := dsLen + nl; poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
      k := k + 1;
    }
    var nNeeded: int64 := 0;
    k := 0;
    while k < n { nNeeded := nNeeded + peek64(libNeu + k * 8); k := k + 1; }
    // Lage der Tabellen hinter dem Code-/Datenpuffer (alles 8-ausgerichtet)
    var tabOff: int64 := ((codeFileOffset + codeSize + 7) >> 3) << 3;
    var dynstrOff: int64 := tabOff;
    var dynsymOff: int64 := ((dynstrOff + dsLen + 7) >> 3) << 3;
    var dynsymSize: int64 := (n + 1) * 24;
    var hashOff: int64 := dynsymOff + dynsymSize;
    var hashSize: int64 := (3 + n + 1) * 4;
    var relaOff: int64 := ((hashOff + hashSize + 7) >> 3) << 3;
    var relaSize: int64 := n * 24;
    var dynOff: int64 := relaOff + relaSize;
    var dynSize: int64 := (nNeeded + 11) * 16;
    var fileSize: int64 := dynOff + dynSize;

    var buf: int64 := alloc(fileSize);
    var z: int64 := 0;
    while z < fileSize { poke8(buf + z, 0); z := z + 1; }
    memcpy(buf + codeFileOffset, self.code, codeSize);

    poke8(buf + 0, 127); poke8(buf + 1, 69); poke8(buf + 2, 76); poke8(buf + 3, 70);
    poke8(buf + 4, 2);   poke8(buf + 5, 1);  poke8(buf + 6, 1);  poke8(buf + 7, 0);
    poke16(buf + 16, 2);          // ET_EXEC
    poke16(buf + 18, 0xF3);       // EM_RISCV
    poke32(buf + 20, 1);
    poke64(buf + 24, 0x401000);   // e_entry: _start
    poke64(buf + 32, 64);
    poke64(buf + 40, 0);
    poke32(buf + 48, 0x05);       // EF_RISCV_RVC | EF_RISCV_FLOAT_ABI_DOUBLE (lp64d)
    poke16(buf + 52, 64); poke16(buf + 54, 56); poke16(buf + 56, phnum);
    poke16(buf + 58, 64); poke16(buf + 60, 0); poke16(buf + 62, 0);

    var dOff: int64 := codeFileOffset + dataStart;
    var ph: int64 := buf + 64;
    poke32(ph, 1); poke32(ph + 4, 5);                                       // PT_LOAD r-x
    poke64(ph + 8, 0); poke64(ph + 16, baseVA); poke64(ph + 24, baseVA);
    poke64(ph + 32, dOff); poke64(ph + 40, dOff); poke64(ph + 48, 0x1000);
    ph := ph + 56;
    poke32(ph, 1); poke32(ph + 4, 6);                                       // PT_LOAD rw- (Daten, GOT, Tabellen)
    poke64(ph + 8, dOff); poke64(ph + 16, baseVA + dOff); poke64(ph + 24, baseVA + dOff);
    poke64(ph + 32, fileSize - dOff); poke64(ph + 40, fileSize - dOff); poke64(ph + 48, 0x1000);
    ph := ph + 56;
    poke32(ph, 3); poke32(ph + 4, 4);                                       // PT_INTERP
    poke64(ph + 8, interpOff); poke64(ph + 16, baseVA + interpOff); poke64(ph + 24, baseVA + interpOff);
    poke64(ph + 32, interpLen); poke64(ph + 40, interpLen); poke64(ph + 48, 1);
    ph := ph + 56;
    poke32(ph, 2); poke32(ph + 4, 6);                                       // PT_DYNAMIC
    poke64(ph + 8, dynOff); poke64(ph + 16, baseVA + dynOff); poke64(ph + 24, baseVA + dynOff);
    poke64(ph + 32, dynSize); poke64(ph + 40, dynSize); poke64(ph + 48, 8);

    memcpy(buf + interpOff, interpStr as int64, interpLen);
    memcpy(buf + dynstrOff, dynstr, dsLen);
    k := 0;
    while k < n {
      var sy: int64 := buf + dynsymOff + (k + 1) * 24;
      poke32(sy, peek64(symStr + k * 8));
      poke8(sy + 4, 0x12);                     // STB_GLOBAL | STT_FUNC, SHN_UNDEF
      var ra: int64 := buf + relaOff + k * 24;
      poke64(ra, baseVA + codeFileOffset + self.gotOff + k * 8);   // r_offset: GOT-Platz
      poke64(ra + 8, ((k + 1) << 32) | 2);     // R_RISCV_64
      poke64(ra + 16, 0);
      k := k + 1;
    }
    poke32(buf + hashOff, 1);                  // nbucket = 1 (alle Symbole UNDEF)
    poke32(buf + hashOff + 4, n + 1);          // nchain
    var dp: int64 := buf + dynOff;
    k := 0;
    while k < n {
      if peek64(libNeu + k * 8) != 0 { poke64(dp, 1); poke64(dp + 8, peek64(libStr + k * 8)); dp := dp + 16; }   // DT_NEEDED
      k := k + 1;
    }
    poke64(dp, 4);  poke64(dp + 8, baseVA + hashOff);   dp := dp + 16;   // DT_HASH
    poke64(dp, 5);  poke64(dp + 8, baseVA + dynstrOff); dp := dp + 16;   // DT_STRTAB
    poke64(dp, 6);  poke64(dp + 8, baseVA + dynsymOff); dp := dp + 16;   // DT_SYMTAB
    poke64(dp, 10); poke64(dp + 8, dsLen);              dp := dp + 16;   // DT_STRSZ
    poke64(dp, 11); poke64(dp + 8, 24);                 dp := dp + 16;   // DT_SYMENT
    poke64(dp, 7);  poke64(dp + 8, baseVA + relaOff);   dp := dp + 16;   // DT_RELA
    poke64(dp, 8);  poke64(dp + 8, relaSize);           dp := dp + 16;   // DT_RELASZ
    poke64(dp, 9);  poke64(dp + 8, 24);                 dp := dp + 16;   // DT_RELAENT
    poke64(dp, 30); poke64(dp + 8, 8);                  dp := dp + 16;   // DT_FLAGS = DF_BIND_NOW
    poke64(dp, 0);  poke64(dp + 8, 0);                                    // DT_NULL

    EmitWriteFile(path, buf, fileSize);
    free(buf, fileSize);
  }
};
