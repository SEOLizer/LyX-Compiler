// bootstrap/backend/riscv_linux.lyx
// RISC-V RV64GC Linux ELF64 backend (WP-BC-36)
//
// Strategy: EmitRISCV64 (IR → RV64 machine code) + 12-byte _start stub.
// The stub calls main and passes a0 to exit(a7=93, ecall).
//
// ELF64 layout:
//   file[0..4095]    ELF64 header + program header (1 page)
//   file[4096..]     .text (_start at file:4096 = VA:0x401000)
//   Load base 0x400000, .text VA 0x401000
//
// _start stub (12 bytes at .text offset 0):
//   +0: JAL ra, 12      call main (12 bytes forward)
//   +4: ADDI a7,x0,93   li a7, 93 (exit syscall number)
//   +8: ECALL            exit(a0)
//
// RISC-V LP64 ABI:
//   a0-a7 (x10-x17) args/return; a7 syscall number
//   s0/fp (x8) frame pointer; ra (x1) return address
//   sp (x2) stack pointer; t0 (x5), t1 (x6) scratch temps

// ============================================================================
// Register numbers
// ============================================================================


import src.emit_write;
import src.backend.linux_syscalls;   // #2021
import src.std.alloc;
con RV_ZERO: int64 := 0;
con RV_RA:   int64 := 1;
con RV_SP:   int64 := 2;
con RV_FP:   int64 := 8;    // s0/fp
con RV_A0:   int64 := 10;
con RV_A1:   int64 := 11;
con RV_A2:   int64 := 12;
con RV_A3:   int64 := 13;
con RV_A4:   int64 := 14;
con RV_A5:   int64 := 15;
con RV_A6:   int64 := 16;
con RV_A7:   int64 := 17;
con RV_T0:   int64 := 5;
con RV_T1:   int64 := 6;
con RV_T2:   int64 := 7;
// #2061: Hilfsregister fuer Adressen, deren Versatz nicht in zwoelf Bit passt
// (s11). Sonst benutzt dieses Backend es nirgends, und es lebt nie ueber einen
// einzelnen Zugriff hinaus — es kann also mit nichts kollidieren, auch nicht
// mit t3 … t6, die die Builtin-Folgen als Laufvariablen nehmen.
//
// #2140: s11 ist nach dem psABI callee-saved. Bis 1.2.16A wurde es benutzt,
// ohne es zu retten — unter Lyx-Aufrufern faellt das nicht auf (keiner haelt
// darin etwas), ein C-Aufrufer (Rueckruf, .so) verliert aber seinen Wert.
// Ein caller-saved Register gibt es dafuer nicht: t0..t2 tragen die Operanden
// eines Zugriffs, t3..t6 und a0..a7 die Laufvariablen der Builtin-Folgen
// (deren Slotzugriffe selbst ueber RV_WEIT gehen koennen). Deshalb rettet
// emitPrologue s11 in JEDER Funktion; welche es braucht, steht beim Prolog
// noch nicht fest (Feldversaetze grosser Strukturen kommen erst im Rumpf).
con RV_WEIT: int64 := 27;

// Linux RISC-V syscall numbers
con RV_SYS_EXIT:   int64 := 93;
con RV_SYS_WRITE:  int64 := 64;
con RV_SYS_READ:   int64 := 63;   // #1740: riscv64 zaehlt anders als x86-64 (dort 0)
con RV_SYS_MMAP:   int64 := 222;
con RV_SYS_MUNMAP: int64 := 215;
con RV_SYS_OPEN:   int64 := 56;   // #1764: das ist openat(dirfd,path,flags,mode)
con RV_SYS_CLOSE:  int64 := 57;

// #1740: Laenge des _start-Rumpfs (RiscvLinuxBackend.rlb_emitStart). Der Rumpf
// wird VOR den Code kopiert; der Datenbereich muss deshalb um genau diese
// Laenge versetzt auf eine Seitengrenze fallen.
// #2035: wird ausserhalb dieser Unit gebraucht.
// #2110: 16 seit dem ersten Befehl, der argv fuer GetArgC/GetArgV sichert.
// #2271: 28 — argc/argv in a0/a1 und der Aufruf von main als AUIPC+JALR.
pub con RV_START_STUB_LEN: int64 := 28;

// Branch patch types
con RV_PATCH_J:   int64 := 0;   // JAL x0, label  (unconditional)
con RV_PATCH_BL:  int64 := 1;   // AUIPC ra + JALR ra, funcId  (call, #2112)
con RV_PATCH_BEQ: int64 := 2;   // BEQ t0, x0, label  (branch if == 0)
con RV_PATCH_BNE: int64 := 3;   // BNE t0, x0, label  (branch if != 0)
// #2112: Reichweiten der Befehlsfelder. B-Typ (BEQ/BNE) traegt 13 Bit, also
// +/-4 KiB; JAL 21 Bit, +/-1 MiB; AUIPC+ADDI/JALR 32 Bit, +/-2 GiB. Vorher
// wurde jeder Abstand still auf die Feldbreite maskiert: ein while-Rumpf ueber
// 4 KiB (rund 16 poke8) sprang beim Verlassen irgendwohin, ein Aufruf ueber
// 1 MiB Code hinweg ebenso.
con RV_REACH_B:   int64 := 0x1000;
con RV_REACH_JAL: int64 := 0x100000;
con RV_REACH_PC:  int64 := 0x80000000;
// #1806: Adresse einer Funktion als WERT (fn-Zeiger). AUIPC+ADDI, beide
// Haelften werden nachgetragen — dasselbe Paar wie bei den globalen Variablen.
con RV_PATCH_FADDR: int64 := 4;

// ============================================================================
// EmitRISCV64  —  IR → RV64GC machine code
// ============================================================================

pub type EmitRISCV64 = class {
  codeBuf:    int64;
  codeLen:    int64;
  codeCap:    int64;
  ir:         int64;
  stackSize:  int64;
  labelAddrs: int64;   // labelId → code offset  (labelCap × 8 bytes)
  labelCount: int64;
  labelCap:   int64;   // #2112: waechst, war fest 1024
  patchBuf:   int64;   // {codeOff,labelId,type,reg} je 32 Bytes, waechst (#1740)
  patchCount: int64;
  patchCap:   int64;   // #1740: Kapazitaet in Eintraegen
  funcAddrs:  int64;   // funcId → start offset  (funcCap × 8 bytes)
  funcCount:  int64;
  funcCap:    int64;   // #2112: Funktionszahl des Moduls, war fest 256
  // #1740: globale Variablen. Der Zugriff entsteht PC-relativ (AUIPC+ADDI) und
  // wird aufgeloest, sobald der Datenbereich hinter dem Code steht.
  globRelocBuf:   int64;   // {codeOff, globalIdx} je 16 Bytes
  globRelocCount: int64;
  globRelocCap:   int64;
  globalsOff:     int64;   // Code-Offset des Datenbereichs (-1 = noch nicht gesetzt)
  mainOff:        int64;   // #1740: Code-Offset von main (-1 = nicht gefunden)
  // #2162: FFI. Je Symbol {namePtr, nameLen, libPtr, libLen} (32 Byte,
  // absolute Zeiger); je Aufruf {codeOff, extIdx} (16 Byte) fuer den
  // GOT-Platz hinter den Modulvariablen.
  extBuf:        int64;
  extCount:      int64;
  extCap:        int64;
  gotRelocBuf:   int64;
  gotRelocCount: int64;
  gotRelocCap:   int64;
  gotOff:        int64;   // Code-Offset des ersten GOT-Platzes (-1 = keiner)
  dynStartOff:   int64;   // Code-Offset des libc-Startwegs (-1 = keiner)
  noLibcInit:    int64;   // --no-libc-init: main direkt, ohne __libc_start_main
  // #2162: --shared. Je Export mit Gleitkomma {funcId, sig, huellenOff}
  // (24 Byte); sig wie lyxc._armSoSignaturen: n | arten << 8 | rueck << 32.
  isShared:      int64;
  soHuTab:       int64;
  soHuCount:     int64;
  soHuCap:       int64;
  bumpGIdx:      int64;   // #2227: erstes der zwei Bump-Globals (Zeiger, Ende), -1 = noch keins
  slotRecCur:    int64;   // #2270: Slot-Satz der Funktion, die gerade entsteht (0 = keiner)

  // --------------------------------------------------------------------------
  // Code emission primitives
  // --------------------------------------------------------------------------

  fn rv_e32(v: int64) {
    self.growCode(4);
    poke8(self.codeBuf + self.codeLen,     v & 0xFF);
    poke8(self.codeBuf + self.codeLen + 1, (v >> 8) & 0xFF);
    poke8(self.codeBuf + self.codeLen + 2, (v >> 16) & 0xFF);
    poke8(self.codeBuf + self.codeLen + 3, (v >> 24) & 0xFF);
    self.codeLen := self.codeLen + 4;
  }

  // #1339: einzelnes Byte — fuer Zeichenketten, die inline im Codestrom liegen.
  fn rv_e8(v: int64) {
    self.growCode(1);
    poke8(self.codeBuf + self.codeLen, v & 0xFF);
    self.codeLen := self.codeLen + 1;
  }

  // #1339: JAL x0, off — unbedingter Sprung ohne Ruecksprungadresse. Das
  // Sprungziel steckt in RISC-V verstreut im Befehlswort (imm[20|10:1|11|19:12]);
  // von Hand zusammengesetzt ist das die haeufigste Fehlerquelle, deshalb hier
  // an einer Stelle.
  // #1388: BEQ rs, x0, +off  (B-Type, funct3=0). Nur vorwaerts, Offset gerade.
  fn rv_BEQZ_fwd(rs: int64, off: int64) {
    var b11: int64 := (off >> 11) & 1;
    var b4_1: int64 := (off >> 1) & 0xF;
    var b10_5: int64 := (off >> 5) & 0x3F;
    var b12: int64 := (off >> 12) & 1;
    self.rv_e32(0x63 | (b11 << 7) | (b4_1 << 8) | (0 << 12) | (rs << 15) | (0 << 20)
                     | (b10_5 << 25) | (b12 << 31));
  }

  // #2103: B-Type mit beliebiger Bedingung (funct3: 0 BEQ, 1 BNE, 6 BLTU,
  // 7 BGEU), vor- und rueckwaerts; Offset gerade, +-4 KiB.
  fn rv_Bcond(f3: int64, rs1: int64, rs2: int64, off: int64) {
    if off < (0 - 4096) || off > 4094 {
      EPrintStrLn("error: riscv: rv_Bcond-Offset ausserhalb +-4 KiB (#2103)."c);
      exit(1);
    }
    var b11: int64 := (off >> 11) & 1;
    var b4_1: int64 := (off >> 1) & 0xF;
    var b10_5: int64 := (off >> 5) & 0x3F;
    var b12: int64 := (off >> 12) & 1;
    self.rv_e32(0x63 | (b11 << 7) | (b4_1 << 8) | (f3 << 12) | (rs1 << 15) | (rs2 << 20)
                     | (b10_5 << 25) | (b12 << 31));
  }

  fn rv_JAL_x0(off: int64) {
    var b20:    int64 := (off >> 20) & 0x1;
    var b10_1:  int64 := (off >> 1)  & 0x3FF;
    var b11:    int64 := (off >> 11) & 0x1;
    var b19_12: int64 := (off >> 12) & 0xFF;
    self.rv_e32(0x6F | (b19_12 << 12) | (b11 << 20) | (b10_1 << 21) | (b20 << 31));
  }

  fn rv_poke32at(off: int64, val: int64) {
    poke8(self.codeBuf + off,     val & 0xFF);
    poke8(self.codeBuf + off + 1, (val >> 8) & 0xFF);
    poke8(self.codeBuf + off + 2, (val >> 16) & 0xFF);
    poke8(self.codeBuf + off + 3, (val >> 24) & 0xFF);
  }

  // --------------------------------------------------------------------------
  // RISC-V instruction encoders
  // --------------------------------------------------------------------------

  // #2061: Alle Speicherbefehle unten tragen ihren Versatz in ZWOELF Bit,
  // vorzeichenbehaftet (-2048 … 2047). Bis 1.2.11E wurde ein groesserer Wert
  // mit `& 0xFFF` passend gemacht — still. Ein Slot jenseits von -2048 landete
  // an einer anderen Adresse, und die Rahmenanlage im Prolog lief in die
  // falsche Richtung: 2672 Byte Rahmen wurden zu `addi sp, sp, +1424`.
  //
  // Passt der Versatz nicht, wird die Adresse jetzt im Hilfsregister
  // aufgebaut (_rvWeit) und mit Versatz 0 zugegriffen. Der Normalfall bleibt
  // ein einzelner Befehl; nur der weite Zugriff wird laenger. Das ist
  // unbedenklich fuer die handkodierten Vorwaertsspruenge dieses Backends
  // (rv_BEQZ_fwd mit fester Bytezahl): keiner von ihnen ueberspringt einen
  // Slot-Zugriff — nachgezaehlt fuer alle 26 Stellen. Wer einen neuen
  // schreibt, muss das mit bedenken.

  // LD rd, off(rs1)  — 64-bit load, I-type, funct3=3, opcode=3
  fn rv_LD(rd: int64, rs1: int64, off: int64) {
    if self._rvPasst12(off) == 0 { self._rvWeit(rs1, off); self.rv_LD(rd, RV_WEIT, 0); return; }   // #2061
    self.rv_e32(0x3 | (rd<<7) | (3<<12) | (rs1<<15) | ((off & 0xFFF)<<20));
  }

  // SD rs2, off(rs1)  — 64-bit store, S-type, funct3=3, opcode=0x23
  fn rv_SD(rs2: int64, rs1: int64, off: int64) {
    if self._rvPasst12(off) == 0 { self._rvWeit(rs1, off); self.rv_SD(rs2, RV_WEIT, 0); return; }   // #2061
    var imm5: int64 := off & 0x1F;
    var imm7: int64 := ((off & 0xFFF) >> 5) & 0x7F;
    self.rv_e32(0x23 | (imm5<<7) | (3<<12) | (rs1<<15) | (rs2<<20) | (imm7<<25));
  }

  // #1388: schmale Zugriffe. Die Speicher-Builtins (peek8/16/32, poke8/16/32)
  // brauchen sie; bis 1.1.0A fehlten sie, und weil emitBuiltinCall keinen
  // Default-Zweig hatte, erzeugte `peek8(p)` GAR NICHTS und lieferte, was
  // zufaellig in a0 stand.
  // LBU rd, off(rs1) — funct3=4, opcode=3
  fn rv_LBU(rd: int64, rs1: int64, off: int64) {
    if self._rvPasst12(off) == 0 { self._rvWeit(rs1, off); self.rv_LBU(rd, RV_WEIT, 0); return; }   // #2061
    self.rv_e32(0x3 | (rd<<7) | (4<<12) | (rs1<<15) | ((off & 0xFFF)<<20));
  }
  // LHU rd, off(rs1) — funct3=5
  fn rv_LHU(rd: int64, rs1: int64, off: int64) {
    if self._rvPasst12(off) == 0 { self._rvWeit(rs1, off); self.rv_LHU(rd, RV_WEIT, 0); return; }   // #2061
    self.rv_e32(0x3 | (rd<<7) | (5<<12) | (rs1<<15) | ((off & 0xFFF)<<20));
  }
  // LWU rd, off(rs1) — funct3=6
  fn rv_LWU(rd: int64, rs1: int64, off: int64) {
    if self._rvPasst12(off) == 0 { self._rvWeit(rs1, off); self.rv_LWU(rd, RV_WEIT, 0); return; }   // #2061
    self.rv_e32(0x3 | (rd<<7) | (6<<12) | (rs1<<15) | ((off & 0xFFF)<<20));
  }
  // SB rs2, off(rs1) — funct3=0, opcode=0x23
  fn rv_SB(rs2: int64, rs1: int64, off: int64) {
    if self._rvPasst12(off) == 0 { self._rvWeit(rs1, off); self.rv_SB(rs2, RV_WEIT, 0); return; }   // #2061
    var sbI5: int64 := off & 0x1F;
    var sbI7: int64 := ((off & 0xFFF) >> 5) & 0x7F;
    self.rv_e32(0x23 | (sbI5<<7) | (0<<12) | (rs1<<15) | (rs2<<20) | (sbI7<<25));
  }
  // SH rs2, off(rs1) — funct3=1
  fn rv_SH(rs2: int64, rs1: int64, off: int64) {
    if self._rvPasst12(off) == 0 { self._rvWeit(rs1, off); self.rv_SH(rs2, RV_WEIT, 0); return; }   // #2061
    var shI5: int64 := off & 0x1F;
    var shI7: int64 := ((off & 0xFFF) >> 5) & 0x7F;
    self.rv_e32(0x23 | (shI5<<7) | (1<<12) | (rs1<<15) | (rs2<<20) | (shI7<<25));
  }
  // SW rs2, off(rs1) — funct3=2
  fn rv_SW(rs2: int64, rs1: int64, off: int64) {
    if self._rvPasst12(off) == 0 { self._rvWeit(rs1, off); self.rv_SW(rs2, RV_WEIT, 0); return; }   // #2061
    var swI5: int64 := off & 0x1F;
    var swI7: int64 := ((off & 0xFFF) >> 5) & 0x7F;
    self.rv_e32(0x23 | (swI5<<7) | (2<<12) | (rs1<<15) | (rs2<<20) | (swI7<<25));
  }

  // ADDI rd, rs1, imm  — I-type, funct3=0, opcode=0x13
  //
  // #2061: Ein Direktwert ausserhalb von zwoelf Bit scheitert hier LAUT. Es
  // gibt keinen Aufrufer, der das braucht — die Rahmenanlage geht seit #2061
  // ueber rv_LI64 —, und ein stilles Abschneiden hat genau den Fehler
  // verursacht, den das Issue beschreibt.
  fn rv_ADDI(rd: int64, rs1: int64, imm: int64) {
    if self._rvPasst12(imm) == 0 {
      EPrintStr("error: riscv: ADDI-Direktwert "c);
      EPrintInt(imm);
      EPrintStrLn(" passt nicht in zwoelf Bit (#2061) — rv_LI64 benutzen."c);
      exit(1);
    }
    self.rv_e32(0x13 | (rd<<7) | (0<<12) | (rs1<<15) | ((imm & 0xFFF)<<20));
  }

  // ADD rd, rs1, rs2  — R-type, funct3=0, funct7=0
  fn rv_ADD(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (0<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // SUB rd, rs1, rs2  — R-type, funct3=0, funct7=0x20
  fn rv_SUB(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (0<<12) | (rs1<<15) | (rs2<<20) | (0x20<<25));
  }

  // MUL rd, rs1, rs2  — M-ext, funct3=0, funct7=1
  fn rv_MUL(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (0<<12) | (rs1<<15) | (rs2<<20) | (1<<25));
  }

  // DIV rd, rs1, rs2  — M-ext, funct3=4 (signed), funct7=1
  fn rv_DIV(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (4<<12) | (rs1<<15) | (rs2<<20) | (1<<25));
  }

  // REM rd, rs1, rs2  — M-ext, funct3=6 (signed), funct7=1
  fn rv_REM(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (6<<12) | (rs1<<15) | (rs2<<20) | (1<<25));
  }

  // AND rd, rs1, rs2  — funct3=7
  fn rv_AND(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (7<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // OR rd, rs1, rs2  — funct3=6
  fn rv_OR(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (6<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // XOR rd, rs1, rs2  — funct3=4
  fn rv_XOR(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (4<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // SLL rd, rs1, rs2  — funct3=1
  fn rv_SLL(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (1<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // SRL rd, rs1, rs2  — logical right shift, funct3=5, funct7=0
  fn rv_SRL(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (5<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // SRA rd, rs1, rs2 — arithmetisch rechts, funct3=5, funct7=0x20 (#2236)
  fn rv_SRA(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (5<<12) | (rs1<<15) | (rs2<<20) | (0x20<<25));
  }

  // SLT rd, rs1, rs2  — signed less-than, funct3=2
  fn rv_SLT(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (2<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // SLTU rd, rs1, rs2  — unsigned less-than, funct3=3
  fn rv_SLTU(rd: int64, rs1: int64, rs2: int64) {
    self.rv_e32(0x33 | (rd<<7) | (3<<12) | (rs1<<15) | (rs2<<20) | (0<<25));
  }

  // MV rd, rs  (pseudo: ADDI rd, rs, 0)
  fn rv_MV(rd: int64, rs: int64) {
    self.rv_ADDI(rd, rs, 0);
  }

  // LI rd, small_imm  (pseudo: ADDI rd, x0, imm)  — imm in [-2048..2047]
  fn rv_LI(rd: int64, imm: int64) {
    self.rv_ADDI(rd, RV_ZERO, imm);
  }

  // Load full immediate: LUI+ADDI for values outside [-2048..2047]
  // #1764: Trotz des Namens deckte diese Routine nur den 32-Bit-Bereich ab:
  // LUI traegt 20 Bit, ADDI zwoelf. Alles darueber fiel still weg — und weil
  // ein f64-Literal als IEEE-Bitmuster durch dieselbe Routine geht, wurde aus
  // 1.5 (0x3FF8000000000000) ein `lui t0, 0`, also die Null. Gerechnet wurde
  // danach richtig, nur eben mit falschen Zahlen.
  //
  // Der weite Weg setzt den Wert aus Stuecken zu je elf Bit zusammen: erst das
  // oberste Stueck laden, dann fuenfmal um elf schieben und das naechste
  // hineinodern. Elf Bit deshalb, weil ADDI und ORI ihr Immediate
  // vorzeichenbehaftet lesen — bis 2047 bleibt es positiv, ein Vorzeichenfall
  // kann also gar nicht erst entstehen. Sechs Stuecke decken 66 Bit ab, das
  // oberste traegt die restlichen neun.
  fn rv_LI64(rd: int64, imm: int64) {
    if imm >= -2048 && imm <= 2047 {
      self.rv_ADDI(rd, RV_ZERO, imm);
      return;
    }
    if imm >= 0 - 2147483648 && imm <= 2147483647 {
      var lo12: int64 := imm & 0xFFF;
      if (lo12 & 0x800) != 0 { lo12 := lo12 - 0x1000; }
      var hi20: int64 := (imm - lo12) >> 12;
      // LUI rd, hi20
      self.rv_e32(0x37 | (rd<<7) | ((hi20 & 0xFFFFF)<<12));
      if lo12 != 0 { self.rv_ADDI(rd, rd, lo12); }
      return;
    }
    self.rv_ADDI(rd, RV_ZERO, (imm >> 55) & 0x1FF);
    var sh: int64 := 44;
    while sh >= 0 {
      self.rv_SLLI(rd, rd, 11);
      self.rv_ORI(rd, rd, (imm >> sh) & 0x7FF);
      sh := sh - 11;
    }
  }

  // SLLI rd, rs1, shamt — I-Type, funct3=1, opcode=0x13 (RV64: shamt bis 63)
  fn rv_SLLI(rd: int64, rs1: int64, shamt: int64) {
    self.rv_e32(0x13 | (rd<<7) | (1<<12) | (rs1<<15) | ((shamt & 0x3F)<<20));
  }

  // ORI rd, rs1, imm — I-Type, funct3=6, opcode=0x13
  fn rv_ORI(rd: int64, rs1: int64, imm: int64) {
    self.rv_e32(0x13 | (rd<<7) | (6<<12) | (rs1<<15) | ((imm & 0xFFF)<<20));
  }

  // ECALL
  fn rv_ECALL() { self.rv_e32(0x00000073); }

  // RET = JALR x0, ra, 0
  fn rv_RET() { self.rv_e32(0x00008067); }

  // #2144: Rueckgabewert von mmap pruefen — dieselbe Pruefung wie
  // cg_emitMmapGeprueft (x86, #1947) und emitMmapGeprueft (emit_arm64.lyx);
  // die drei muessen uebereinstimmen. Erwartet a0 direkt nach dem ECALL.
  // Im Gutfall wird nur a7 ueberschrieben (die Syscallnummer, die jede Stelle
  // vor dem naechsten ECALL neu setzt) — kein Register, das ein Builtin ueber
  // den Aufruf hinweg haelt. Die Meldung liegt im Code (wie bei #1339).
  fn rv_mmapGeprueft() {
    self.rv_ADDI(RV_A7, RV_ZERO, -2048);
    self.rv_ADDI(RV_A7, RV_A7, -2047);         // a7 = -4095
    self.rv_Bcond(6, RV_A0, RV_A7, 84);        // BLTU a0, a7 → hinter die Meldung
    self.rv_e32(0x17 | (RV_A1 << 7));          // AUIPC a1, 0
    self.rv_ADDI(RV_A1, RV_A1, 36);            // a1 = Meldung (9 Befehle weiter)
    self.rv_ADDI(RV_A0, RV_ZERO, 2);           // stderr
    self.rv_ADDI(RV_A2, RV_ZERO, 42);
    self.rv_ADDI(RV_A7, RV_ZERO, 64);          // write
    self.rv_ECALL();
    self.rv_ADDI(RV_A0, RV_ZERO, 1);
    self.rv_ADDI(RV_A7, RV_ZERO, 94);          // exit_group
    self.rv_ECALL();
    var m: pchar := "Speicheranforderung fehlgeschlagen (mmap)\n";
    var i: int64 := 0;
    while i < 42 { self.rv_e8(StrCharAt(m, i)); i := i + 1; }
    self.rv_e8(0); self.rv_e8(0);
  }

  // Build J-type JAL word: rd=0→jump, rd=1→call
  fn rv_buildJAL(rd: int64, offset: int64): int64 {
    var imm20:    int64 := (offset >> 20) & 1;
    var imm10_1:  int64 := (offset >> 1) & 0x3FF;
    var imm11:    int64 := (offset >> 11) & 1;
    var imm19_12: int64 := (offset >> 12) & 0xFF;
    return 0x6F | (rd<<7) | (imm19_12<<12) | (imm11<<20) | (imm10_1<<21) | (imm20<<31);
  }

  // Build B-type branch word (BEQ/BNE/BLT/BGE)
  fn rv_buildBtype(funct3: int64, rs1: int64, rs2: int64, off: int64): int64 {
    var imm12:   int64 := (off >> 12) & 1;
    var imm11:   int64 := (off >> 11) & 1;
    var imm10_5: int64 := (off >> 5) & 0x3F;
    var imm4_1:  int64 := (off >> 1) & 0xF;
    return 0x63 | (imm11<<7) | (imm4_1<<8) | (funct3<<12) | (rs1<<15) | (rs2<<20) | (imm10_5<<25) | (imm12<<31);
  }

  // --------------------------------------------------------------------------
  // Stack slot helper: slot i → [s0, -(i+1)*8]
  // --------------------------------------------------------------------------

  fn slotOff(slot: int64): int64 { return -(self._physSlot(slot) + 1) * 8; }   // #2270

  // #2270: virtueller Slot -> physischer Slot ueber den Satz aus ir_lower
  // (_slotRecNeu). Temps, deren Anweisung vorbei ist, teilen sich Slots; der
  // Rahmen schrumpft damit auf die groesste gleichzeitig lebende Menge. Ohne
  // Satz (Funktion aus einer .lyu, Code ausserhalb einer Funktion) bleibt
  // jeder Slot er selbst. Ein Slot jenseits der Tabelle kommt HINTER den
  // physischen Bereich, nicht auf seine eigene Nummer — dort laege ein
  // wiederverwendeter. Dieselbe Abbildung in riscv_linux.lyx und
  // emit_arm64.lyx — die beiden muessen uebereinstimmen.
  fn _physSlot(slot: int64): int64 {
    var r: int64 := self.slotRecCur;
    if r == 0 || slot < 0 { return slot; }
    var n: int64 := peek64(r + IR_SLOT_OFF_VIRT);
    if slot < n { return peek64(peek64(r + IR_SLOT_OFF_MAP) + slot * 8); }
    return peek64(r + IR_SLOT_OFF_ANZ) + (slot - n);
  }

  // Satz der Funktion funcId (0 = keiner).
  fn _slotRecVon(funcId: int64): int64 {
    var pc: int64 := peek64(self.ir + IR_MOD_OFF_PHYSCAP);
    if funcId < 0 || funcId >= pc { return 0; }
    return peek64(peek64(self.ir + IR_MOD_OFF_PHYSBUF) + funcId * 8);
  }

  // Slots des Rahmens: physisch belegte plus die jenseits der Tabelle.
  fn _rahmenSlots(funcId: int64): int64 {
    var locals: int64 := self.getFuncLocalCount(funcId);
    var r: int64 := self.slotRecCur;
    if r == 0 { return locals; }
    var n: int64 := peek64(r + IR_SLOT_OFF_VIRT);
    var mehr: int64 := 0;
    if locals > n { mehr := locals - n; }
    return peek64(r + IR_SLOT_OFF_ANZ) + mehr;
  }

  fn rv_loadSlot(slot: int64) {
    self.rv_LD(RV_T0, RV_FP, self.slotOff(slot));
  }

  fn rv_loadSlot2(slot: int64) {
    self.rv_LD(RV_T1, RV_FP, self.slotOff(slot));
  }

  fn rv_storeSlot(slot: int64) {
    self.rv_SD(RV_T0, RV_FP, self.slotOff(slot));
  }

  // --------------------------------------------------------------------------
  // Stack frame
  // --------------------------------------------------------------------------

  fn calcStackFrame(funcId: int64) {
    var locals: int64 := self._rahmenSlots(funcId);   // #2270
    var sz: int64 := locals * 8;
    if (sz & 15) != 0 { sz := (sz + 16) & -16; }
    if sz < 16 { sz := 16; }
    self.stackSize := sz;
  }

  // Prologue layout (after execution):
  //   [s0+0]  = saved old s0
  //   [s0+8]  = saved ra
  //   [s0+16] = saved s11 (RV_WEIT, #2140); [s0+24] frei (16-Ausrichtung)
  //   [s0+32] = erstes Stapelargument des Aufrufers (#2132)
  //   s0      = sp (frame pointer; saved regs above it)
  //   sp      = s0 - stackSize  (locals area below s0)
  // slotOff(i) = -(i+1)*8  → within [sp .. s0-1] ✓
  fn emitPrologue() {
    self.rv_ADDI(RV_SP, RV_SP, -32);  // alloc saved-regs area
    self.rv_SD(RV_FP, RV_SP, 0);      // save old s0
    self.rv_SD(RV_RA, RV_SP, 8);      // save ra
    self.rv_SD(RV_WEIT, RV_SP, 16);   // #2140: s11 ist callee-saved
    self.rv_MV(RV_FP, RV_SP);         // s0 = sp (frame pointer)
    if self.stackSize > 0 {
      // #2061: ein Rahmen ueber 2048 Byte passt nicht in den Direktwert von
      // ADDI. Vorher wurde er abgeschnitten und der Stapelzeiger wanderte
      // nach OBEN.
      if self._rvPasst12(0 - self.stackSize) != 0 {
        self.rv_ADDI(RV_SP, RV_SP, -self.stackSize);  // alloc locals
      } else {
        self.rv_LI64(RV_WEIT, self.stackSize);
        self.rv_SUB(RV_SP, RV_SP, RV_WEIT);
      }
    }
  }

  // Epilogue: load retValTemp (slot 0) into a0, restore frame, return
  fn emitEpilogue() {
    self.rv_LD(RV_A0, RV_FP, self.slotOff(0));  // a0 = retValTemp
    self.rv_MV(RV_SP, RV_FP);                    // restore sp = s0
    self.rv_LD(RV_FP, RV_SP, 0);                 // restore old s0
    self.rv_LD(RV_RA, RV_SP, 8);                 // restore ra
    self.rv_LD(RV_WEIT, RV_SP, 16);              // #2140: s11 zurueck
    self.rv_ADDI(RV_SP, RV_SP, 32);              // pop saved area
    self.rv_RET();                                // JALR x0, ra, 0
  }

  // --------------------------------------------------------------------------
  // Patch management
  // --------------------------------------------------------------------------

  // #1740: Die Liste wuchs frueher nicht — jenseits von 1024 Eintraegen fiel
  // jeder weitere Patch still weg und der zugehoerige Sprung blieb auf seinem
  // Platzhalter stehen. Seit die Aufruf-Patches ueber alle Funktionen hinweg
  // stehenbleiben (siehe emitFunc), ist die Grenze schnell erreicht.
  fn addPatch(codeOff: int64, labelId: int64, ptype: int64, reg: int64) {
    if self.patchCount >= self.patchCap {
      var nc: int64 := self.patchCap * 2;
      var nb: int64 := alloc(nc * 32);
      var ci: int64 := 0;
      while ci < self.patchCount * 4 {
        poke64(nb + ci * 8, peek64(self.patchBuf + ci * 8));
        ci := ci + 1;
      }
      self.patchBuf := nb;
      self.patchCap := nc;
    }
    var base: int64 := self.patchBuf + self.patchCount * 32;
    poke64(base,      codeOff);
    poke64(base + 8,  labelId);
    poke64(base + 16, ptype);
    poke64(base + 24, reg);
    self.patchCount := self.patchCount + 1;
  }

  // #2112: Abstand passt nicht ins Befehlsfeld → laut, statt zu maskieren.
  fn rv_checkReach(what: pchar, dist: int64, reach: int64) {
    if dist >= (0 - reach) && dist < reach { return; }
    EPrintStr("error: riscv: "c); EPrintStr(what);
    EPrintStr(": Abstand "c); EPrintInt(dist);
    EPrintStr(" Byte ueberschreitet die Reichweite von +/-"c); EPrintInt(reach);
    EPrintStrLn(" Byte (#2112)."c);
    exit(1);
  }

  // #2112: mode 1 = Ende einer Funktion (offene Marken-Patches sind ein
  // Fehler — sonst loeste sie die gleichnamige Marke der naechsten Funktion
  // auf), mode 0 = Ende von emit() (auch offene Aufrufe/Adressen). Dasselbe
  // wie _checkNoOpenPatches in emit_arm64.lyx — die beiden muessen
  // uebereinstimmen.
  fn rv_checkNoOpenPatches(mode: int64) {
    var i: int64 := 0;
    while i < self.patchCount {
      var base:  int64 := self.patchBuf + i * 32;
      var lid:   int64 := peek64(base + 8);
      var ptype: int64 := peek64(base + 16);
      if lid != -2 {
        var isFn: int64 := 0;
        if ptype == RV_PATCH_BL || ptype == RV_PATCH_FADDR { isFn := 1; }
        if mode == 0 || isFn == 0 {
          EPrintStr("error: riscv: Sprungziel nie aufgeloest — "c);
          if isFn != 0 { EPrintStr("Funktion "c); } else { EPrintStr("Marke "c); }
          EPrintInt(lid);
          EPrintStr(" (Patchtyp "c); EPrintInt(ptype);
          EPrintStr(", Code-Offset "c); EPrintInt(peek64(base));
          EPrintStrLn(") (#2112)."c);
          exit(1);
        }
      }
      i := i + 1;
    }
  }

  fn applyPatches() {
    var i: int64 := 0;
    while i < self.patchCount {
      var base:    int64 := self.patchBuf + i * 32;
      var codeOff: int64 := peek64(base);
      var labelId: int64 := peek64(base + 8);
      var ptype:   int64 := peek64(base + 16);
      // #1740: -2 heisst „schon gepatcht" — der Durchlauf am Ende von emit()
      // sieht dieselbe Liste noch einmal.
      if labelId != -2 {
      var target:  int64 := -1;
      if ptype == RV_PATCH_BL || ptype == RV_PATCH_FADDR {
        // #1740: funcAddrs kommt aus alloc und ist null. Ein Ziel 0 ist nur
        // fuer die ZUERST erzeugte Funktion echt; fuer jede andere heisst es
        // „noch nicht erzeugt". Vorher wurde jeder Vorwaertsaufruf auf
        // Code-Offset 0 gepatcht und sprang damit in die erste Funktion —
        // aus `alloc(64)` wurde ein Selbstaufruf von main bis zum
        // Stapelueberlauf (#1740).
        if labelId >= 0 && labelId < self.funcCap {
          target := peek64(self.funcAddrs + labelId * 8);
          if target == 0 { if labelId != 0 { target := -1; } }
        }
      } else {
        if labelId >= 0 && labelId < self.labelCap { target := peek64(self.labelAddrs + labelId * 8); }
      }
      if target >= 0 {
        var delta: int64 := target - codeOff;
        if ptype == RV_PATCH_J {
          // #2271: Die Stelle hat Platz fuer zwei Befehle. In JAL-Reichweite
          // bleibt es beim JAL, dahinter ein NOP, das nie laeuft (JAL x0 kehrt
          // nicht zurueck). Darueber AUIPC t1 + JALR x0 — der Selbstbau fuer
          // riscv hat eine Funktion ueber 1 MiB und scheiterte daran. Hoch/tief
          // geteilt wie bei RV_PATCH_BL darunter; die beiden muessen
          // uebereinstimmen.
          if delta >= (0 - RV_REACH_JAL) && delta < RV_REACH_JAL {
            self.rv_poke32at(codeOff, self.rv_buildJAL(0, delta));
            self.rv_poke32at(codeOff + 4, 0x13);   // ADDI x0, x0, 0
          } else {
            self.rv_checkReach("AUIPC+JALR (Sprung innerhalb der Funktion)"c, delta, RV_REACH_PC);
            var jHi: int64 := (delta + 0x800) >> 12;
            var jLo: int64 := delta - (jHi << 12);
            self.rv_poke32at(codeOff, 0x17 | (RV_T1 << 7) | ((jHi & 0xFFFFF) << 12));
            self.rv_poke32at(codeOff + 4, 0x67 | (RV_ZERO << 7) | (0 << 12) | (RV_T1 << 15) | ((jLo & 0xFFF) << 20));
          }
        } else if ptype == RV_PATCH_BL {
          // #2112: Aufruf als AUIPC ra + JALR ra — JAL reichte nur +/-1 MiB,
          // und ein Programm mit mehr Code ist kein Sonderfall. Hoch/tief
          // geteilt wie bei RV_PATCH_FADDR darunter.
          self.rv_checkReach("AUIPC+JALR (Aufruf)"c, delta, RV_REACH_PC);
          var blHi: int64 := (delta + 0x800) >> 12;
          var blLo: int64 := delta - (blHi << 12);
          self.rv_poke32at(codeOff, 0x17 | (RV_RA << 7) | ((blHi & 0xFFFFF) << 12));
          self.rv_poke32at(codeOff + 4, 0x67 | (RV_RA << 7) | (0 << 12) | (RV_RA << 15) | ((blLo & 0xFFF) << 20));
        } else if ptype == RV_PATCH_FADDR {
          self.rv_checkReach("AUIPC+ADDI (Funktionsadresse)"c, delta, RV_REACH_PC);
          // #1806: AUIPC traegt die oberen 20 Bit, ADDI die unteren 12. Weil
          // ADDI sein Immediate VORZEICHENBEHAFTET addiert, muss der obere Teil
          // aufgerundet werden, sobald Bit 11 gesetzt ist — dieselbe Rechnung
          // wie bei applyGlobalRelocs.
          var faHi: int64 := (delta + 0x800) >> 12;
          var faLo: int64 := delta - (faHi << 12);
          self.rv_poke32at(codeOff, 0x17 | (RV_T0 << 7) | ((faHi & 0xFFFFF) << 12));
          self.rv_poke32at(codeOff + 4, 0x13 | (RV_T0 << 7) | (0 << 12) | (RV_T0 << 15) | ((faLo & 0xFFF) << 20));
        } else if ptype == RV_PATCH_BEQ {
          self.rv_checkReach("BEQ"c, delta, RV_REACH_B);
          self.rv_poke32at(codeOff, self.rv_buildBtype(0, RV_T0, RV_ZERO, delta));
        } else if ptype == RV_PATCH_BNE {
          self.rv_checkReach("BNE"c, delta, RV_REACH_B);
          self.rv_poke32at(codeOff, self.rv_buildBtype(1, RV_T0, RV_ZERO, delta));
        } else {
          EPrintStr("error: riscv: unbekannter Patchtyp "c); EPrintInt(ptype); EPrintStrLn(" (#2112)."c);
          exit(1);
        }
        poke64(base + 8, -2);
      }
      }
      i := i + 1;
    }
  }

  // --------------------------------------------------------------------------
  // Instruction dispatch
  // --------------------------------------------------------------------------

    // #1339: Der Dispatcher unten ist eine flache Liste aus `if op == X`
  // ohne else und ohne Default. Ein Opcode, den keine Zeile trifft, erzeugte
  // damit GAR NICHTS und verschwand lautlos aus dem Programm — bei
  // IRO_PANIC hiess das: nach einer erkannten Verletzung laeuft es weiter.
  //
  // Diese Liste nennt die Opcodes, die riscv tatsaechlich behandelt. Sie ist
  // aus dem Dispatcher erhoben und wird gegen ihn geprueft. Weicht sie ab,
  // scheitert der Lauf LAUT — die Abweichung faellt damit beim Uebersetzen
  // auf und nicht erst im erzeugten Programm.
  fn rv_opBehandelt(op: int64): int64 {
    // #1339: die vier Zusicherungen — ir_lower erzeugt sie (ASSERT_NOT_ZERO
    // steht vor jeder Division), und bis 1.0.18B behandelte sie ausser lyxos
    // kein Backend.
    if (op == IRO_ASSERT_NOT_NULL || op == IRO_ASSERT_NOT_ZERO) { return 1; }
    if (op == IRO_ASSERT_TRUE || op == IRO_ASSERT_BOUNDS) { return 1; }
    if (op == IRO_CONST_STR) { return 1; }   // #1339
    if (op == IRO_LOAD_LOCAL_ADDR || op == IRO_LOAD_GLOBAL_ADDR) { return 1; }   // #2116
    if (op == 167 || op == IRO_ADD || op == IRO_ALLOC || op == IRO_AND) { return 1; }
    if (op == IRO_BITAND || op == IRO_BITNOT || op == IRO_BITOR || op == IRO_BITXOR) { return 1; }
    if (op == IRO_BR_FALSE || op == IRO_BR_TRUE || op == IRO_CALL || op == IRO_CALL_BUILTIN) { return 1; }
    if (op == IRO_CAST || op == IRO_CMP_EQ || op == IRO_CMP_GE || op == IRO_CMP_GT) { return 1; }
    if (op == IRO_CMP_LE || op == IRO_CMP_LT || op == IRO_CMP_NEQ || op == IRO_CONST_FLOAT) { return 1; }
    if (op == IRO_CONST_INT || op == IRO_DIV || op == IRO_FREE || op == IRO_FTOI) { return 1; }
    if (op == IRO_CALL_INDIRECT || op == IRO_FUNC_ADDR) { return 1; }   // #1806
    if (op == IRO_CALL_EXTERN) { return 1; }   // #2162
    if (op == IRO_FUNC_EXIT || op == IRO_ITOF || op == IRO_JMP || op == IRO_LABEL) { return 1; }
    // #1764: die Gleitkomma-Rechnung. Sie fehlte komplett — behandelt waren nur
    // ITOF/FTOI, und die kopierten den Slot bloss. `PrintLn` scheiterte damit
    // an IRO_FSUB (Opcode 21), weil die Zahlformatierung in std/io darueber
    // laeuft. RV64GC hat die D-Erweiterung, die Befehle gibt es also.
    if (op == IRO_FADD || op == IRO_FSUB || op == IRO_FMUL || op == IRO_FDIV) { return 1; }
    if (op == IRO_FNEG || op == IRO_FSQRT) { return 1; }
    if (op == IRO_F64_ZU_F32 || op == IRO_F32_ZU_F64) { return 1; }   // #2160
    // #1764: Feldzugriff ueber einen Index. Ohne ihn scheitert `PrintLn`
    // ebenfalls — die Zahlformatierung in std/io greift auf Ziffernfelder zu.
    if (op == IRO_LOAD_IDX || op == IRO_STORE_IDX) { return 1; }
    if (op == IRO_FCMP_EQ || op == IRO_FCMP_NEQ || op == IRO_FCMP_LT) { return 1; }
    if (op == IRO_FCMP_LE || op == IRO_FCMP_GT || op == IRO_FCMP_GE) { return 1; }
    if (op == IRO_LOAD_FIELD || op == IRO_LOAD_FIELD_HEAP || op == IRO_LOAD_GLOBAL || op == IRO_LOAD_LOCAL) { return 1; }
    if (op == IRO_MOD || op == IRO_MUL || op == IRO_NEG || op == IRO_NOT) { return 1; }
    if (op == IRO_OR || op == IRO_PANIC || op == IRO_SEXT || op == IRO_SHL) { return 1; }
    if (op == IRO_SHR || op == IRO_SAR || op == IRO_STORE_FIELD || op == IRO_STORE_FIELD_HEAP || op == IRO_STORE_GLOBAL) { return 1; }
    if (op == IRO_STORE_LOCAL || op == IRO_SUB || op == IRO_THROW || op == IRO_TRUNC) { return 1; }
    if (op == IRO_XOR || op == IRO_ZEXT) { return 1; }
    return 0;
  }

  fn emitInstr(funcId: int64, idx: int64) {
    var opRoh: int64 := self.getInstrOp(idx);
    if (self.rv_opBehandelt(opRoh) == 0) {
      EPrintStr("error: riscv-Backend kennt Opcode "c);
      EPrintInt(opRoh);
      EPrintStrLn(" nicht — er wuerde stillschweigend verschwinden (#1339)."c);
      EPrintStrLn("  Entweder den Opcode hier umsetzen oder ihn in ir_lower fuer dieses Ziel abweisen."c);
      exit(1);
    }

    var op:   int64 := self.getInstrOp(idx);
    var dest: int64 := self.getInstrDest(idx);
    var src1: int64 := self.getInstrSrc1(idx);
    var src2: int64 := self.getInstrSrc2(idx);
    var imm:  int64 := self.getInstrImmInt(idx);

    // --- Constants ---
    if op == IRO_CONST_INT || op == IRO_CONST_FLOAT {
      self.rv_LI64(RV_T0, imm);
      self.rv_storeSlot(dest);
    }

    // --- Integer arithmetic ---
    if op == IRO_ADD {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_ADD(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_SUB {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_SUB(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_MUL {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_MUL(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_DIV {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_DIV(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_MOD {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_REM(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_NEG {
      self.rv_loadSlot(src1);
      self.rv_SUB(RV_T0, RV_ZERO, RV_T0); self.rv_storeSlot(dest);
    }

    // --- Bitwise ---
    if op == IRO_AND || op == IRO_BITAND {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_AND(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_OR || op == IRO_BITOR {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_OR(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_XOR || op == IRO_BITXOR {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_XOR(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_NOT || op == IRO_BITNOT {
      self.rv_loadSlot(src1);
      self.rv_LI(RV_T1, -1);
      self.rv_XOR(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_SHL {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_SLL(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_SHR {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_SRL(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_SAR {                       // #2236: arithmetisch
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_SRA(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }

    // --- Comparisons ---
    if op == IRO_CMP_EQ {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_XOR(RV_T0, RV_T0, RV_T1);
      self.rv_LI(RV_T1, 1);
      self.rv_SLTU(RV_T0, RV_T0, RV_T1);   // t0 = (t0 < 1) = (t0 == 0)
      self.rv_storeSlot(dest);
    }
    if op == IRO_CMP_NEQ {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_XOR(RV_T0, RV_T0, RV_T1);
      self.rv_SLTU(RV_T0, RV_ZERO, RV_T0); // t0 = (0 < t0) = (t0 != 0)
      self.rv_storeSlot(dest);
    }
    if op == IRO_CMP_LT {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_SLT(RV_T0, RV_T0, RV_T1); self.rv_storeSlot(dest);
    }
    if op == IRO_CMP_GE {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_SLT(RV_T0, RV_T0, RV_T1);
      self.rv_LI(RV_T1, 1);
      self.rv_XOR(RV_T0, RV_T0, RV_T1);   // invert: !(src1 < src2) = src1 >= src2
      self.rv_storeSlot(dest);
    }
    if op == IRO_CMP_GT {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_SLT(RV_T0, RV_T1, RV_T0);   // src2 < src1
      self.rv_storeSlot(dest);
    }
    if op == IRO_CMP_LE {
      self.rv_loadSlot(src1); self.rv_loadSlot2(src2);
      self.rv_SLT(RV_T0, RV_T1, RV_T0);   // src2 < src1
      self.rv_LI(RV_T1, 1);
      self.rv_XOR(RV_T0, RV_T0, RV_T1);   // !(src2 < src1) = src1 <= src2
      self.rv_storeSlot(dest);
    }

    // --- Memory: locals and globals ---
    if op == IRO_LOAD_LOCAL || op == IRO_STORE_LOCAL {
      self.rv_loadSlot(src1); self.rv_storeSlot(dest);
    }
    // #1740: src1 bzw. src2 tragen einen globalIdx, KEINE Adresse. riscv lud
    // ihn bis hierher als Zahl in ein Register und griff darauf zu — der
    // Zugriff auf die erste globale Variable landete also auf Adresse 0, der
    // auf die zweite auf 8. Genau daran starb `alloc`, dessen Zustand in
    // globalen Variablen steht. Jetzt zeigt AUIPC+ADDI PC-relativ in den
    // Datenbereich hinter dem Code; die Distanz traegt applyGlobalRelocs nach.
    if op == IRO_LOAD_GLOBAL {
      self.emitGlobalAddr(src1);
      self.rv_LD(RV_T0, RV_T2, 0); self.rv_storeSlot(dest);
    }
    // #2116: `@x` — Adresse des Slots (fp + slotOff), weit wie _rvWeit (#2061).
    if op == IRO_LOAD_LOCAL_ADDR {
      var laOff: int64 := self.slotOff(src1);
      if self._rvPasst12(laOff) != 0 { self.rv_ADDI(RV_T0, RV_FP, laOff); }
      else { self.rv_LI64(RV_T0, laOff); self.rv_ADD(RV_T0, RV_FP, RV_T0); }
      self.rv_storeSlot(dest);
    }
    // #2116: `@g` — dieselbe AUIPC/ADDI-Folge wie IRO_LOAD_GLOBAL, ohne LD.
    if op == IRO_LOAD_GLOBAL_ADDR {
      self.emitGlobalAddr(src1);
      self.rv_MV(RV_T0, RV_T2); self.rv_storeSlot(dest);
    }
    // ir_lower legt bei STORE_GLOBAL den globalIdx ins DEST-Feld und den Slot
    // mit dem Wert nach src1 (irAddInstrDirect(op, gIdx, valTemp, -1, 0)).
    // riscv las den Index aus src2 — dort steht -1, geschrieben wurde also
    // acht Byte VOR den Datenbereich, mitten in den Code (#1740).
    if op == IRO_STORE_GLOBAL {
      self.emitGlobalAddr(dest);
      self.rv_loadSlot(src1);
      self.rv_SD(RV_T0, RV_T2, 0);
    }

    // #1764: dest = base[idx] bzw. base[idx] = src, Elementbreite acht Byte —
    // dieselbe Rechnung wie im arm64-Backend (LDR x0,[x0,x1,LSL #3]).
    if op == IRO_LOAD_IDX {
      self.rv_loadSlot(src1);                 // t0 = Basis
      self.rv_loadSlot2(src2);                // t1 = Index
      self.rv_SLLI(RV_T1, RV_T1, 3);          // t1 = Index * 8
      self.rv_ADD(RV_T0, RV_T0, RV_T1);
      self.rv_LD(RV_T0, RV_T0, 0);
      self.rv_storeSlot(dest);
    }
    if op == IRO_STORE_IDX {
      self.rv_loadSlot(src2);                 // t0 = Basis
      self.rv_loadSlot2(dest);                // t1 = Index
      self.rv_SLLI(RV_T1, RV_T1, 3);
      self.rv_ADD(RV_T2, RV_T0, RV_T1);       // t2 = Ziel-Adresse
      self.rv_loadSlot(src1);                 // t0 = Wert
      self.rv_SD(RV_T0, RV_T2, 0);
    }

    // --- Struct field access ---
    // #1767: Beim Schreiben steht der Feld-Offset im DEST-Feld, nicht in imm —
    // ir_lower erzeugt STORE_FIELD als (dest = Offset, src1 = Wert,
    // src2 = Basis), so wie lyxos und arm64 es lesen. riscv nahm imm, und das
    // ist dort immer 0: JEDES Feld landete auf Offset 0, das zweite
    // ueberschrieb also das erste. `self.a + self.b` ergab damit 7 statt 49.
    // #2147: imm = Breite | (vorzeichenbehaftet << 8), 0 = acht Byte — wie
    // emitLoadFieldArt in emit_arm64.lyx (die beiden muessen uebereinstimmen).
    // Bis 1.2.16C las/schrieb jeder Feldzugriff acht Byte.
    if op == IRO_LOAD_FIELD || op == IRO_LOAD_FIELD_HEAP {
      self.rv_loadSlot(src1);
      var lfW: int64 := imm & 255;
      var lfVz: int64 := (imm >> 8) & 1;
      if lfW == 1 && lfVz == 0 { self.rv_LBU(RV_T0, RV_T0, src2); }
      else if lfW == 2 && lfVz == 0 { self.rv_LHU(RV_T0, RV_T0, src2); }
      else if lfW == 4 && lfVz == 0 { self.rv_LWU(RV_T0, RV_T0, src2); }
      else if lfW == 1 || lfW == 2 || lfW == 4 {
        // LB/LH/LW (funct3 0/1/2) — vorzeichenrichtig erweitert.
        var lfAdr: int64 := RV_T0;
        var lfOff: int64 := src2;
        if self._rvPasst12(src2) == 0 { self._rvWeit(RV_T0, src2); lfAdr := RV_WEIT; lfOff := 0; }
        var lfF3: int64 := 0;
        if lfW == 2 { lfF3 := 1; }
        if lfW == 4 { lfF3 := 2; }
        self.rv_e32(0x3 | (RV_T0<<7) | (lfF3<<12) | (lfAdr<<15) | ((lfOff & 0xFFF)<<20));
      }
      else { self.rv_LD(RV_T0, RV_T0, src2); }
      self.rv_storeSlot(dest);
    }
    if op == IRO_STORE_FIELD || op == IRO_STORE_FIELD_HEAP {
      self.rv_loadSlot(src2);            // t0 = base pointer
      self.rv_MV(RV_T2, RV_T0);         // t2 = base
      self.rv_loadSlot(src1);            // t0 = value
      var sfW: int64 := imm & 255;
      if sfW == 1 { self.rv_SB(RV_T0, RV_T2, dest); }
      else if sfW == 2 { self.rv_SH(RV_T0, RV_T2, dest); }
      else if sfW == 4 { self.rv_SW(RV_T0, RV_T2, dest); }
      else { self.rv_SD(RV_T0, RV_T2, dest); }
    }

    // --- Function calls ---
    if op == IRO_CALL {
      // #1740: Die Argumente liegen im reservierten Block ab src2 (argBase),
      // nicht in den Slots 0..N-1 — die gehoeren den Locals des Aufrufers.
      // riscv las sie bis hierher aus Slot 0 und uebergab damit irgendeinen
      // fremden Wert; arm64 und lyxos rechnen laengst ab argBase.
      var argCount: int64 := imm;
      // #2132: ab dem neunten Argument ueber den Stapel (rv_StapelArgs).
      var stBytes: int64 := self.rv_StapelArgs(src2, argCount);
      self.rv_RegArgs(src2, argCount);
      var patchOff: int64 := self.codeLen;
      // #2112: AUIPC ra + JALR ra statt JAL ra (+/-1 MiB) — beide Platzhalter,
      // applyPatches traegt hoch/tief ein.
      self.rv_e32(0x17 | (RV_RA << 7));                       // AUIPC ra, 0
      self.rv_e32(0x67 | (RV_RA << 7) | (RV_RA << 15));       // JALR ra, 0(ra)
      self.addPatch(patchOff, src1, RV_PATCH_BL, 0);
      if stBytes > 0 { self.rv_ADDI(RV_SP, RV_SP, stBytes); }   // #2132: Stapelargumente abraeumen
      self.rv_MV(RV_T0, RV_A0);
      self.rv_storeSlot(dest);
    }
    if op == IRO_CALL_BUILTIN {
      self.emitBuiltinCall(imm, src1, dest);
    }
    // #2162: FFI-Aufruf nach LP64D. src1 = Argumentzahl, src2/imm = Bibliothek
    // und Symbol (Offsets in den IR-Strings), src3 = Argumentblock, immFloat =
    // Signatur der Deklaration (parser._parseExternFn).
    if op == IRO_CALL_EXTERN {
      self.rv_callExtern(src1, src2, imm, dest, self.getInstrField(idx, IR_INSTR_OFF_SRC3),
                         self.getInstrField(idx, IR_INSTR_OFF_IMMFLOAT));
    }
    // #1806: Aufruf ueber einen Funktionszeiger. Die Argumente liegen wie beim
    // gewoehnlichen Aufruf, die Zieladresse steht in einem Slot.
    //
    // Bis 1.1.10G fehlte der Opcode hier ganz; der Aufruf kam nur deshalb nie
    // so weit, weil die Namensaufloesung in ir_lower vorher scheiterte. Der
    // laute Opcode-Waechter hat ihn beim Beheben von #1806 sofort gemeldet —
    // so soll es sein.
    // #2132: src2 = argBase des Argumentblocks, wie beim direkten Aufruf.
    if op == IRO_CALL_INDIRECT {
      var ciCount: int64 := imm;
      var ciSt: int64 := self.rv_StapelArgs(src2, ciCount);
      self.rv_RegArgs(src2, ciCount);
      self.rv_loadSlot(src1);                    // t0 = Zieladresse
      // JALR ra, t0, 0
      self.rv_e32(0x67 | (RV_RA << 7) | (0 << 12) | (RV_T0 << 15));
      if ciSt > 0 { self.rv_ADDI(RV_SP, RV_SP, ciSt); }   // #2132
      self.rv_MV(RV_T0, RV_A0);
      self.rv_storeSlot(dest);
    }
    // #1806: Adresse einer Funktion als Wert. Erst muss `add` als ZAHL
    // entstehen, bevor `f(a, b)` sie indirekt rufen kann.
    if op == IRO_FUNC_ADDR {
      var faOff: int64 := self.codeLen;
      self.rv_e32(0x17 | (RV_T0 << 7));          // AUIPC t0, 0 — nachgetragen
      self.rv_ADDI(RV_T0, RV_T0, 0);             // ADDI  t0, t0, 0 — nachgetragen
      self.addPatch(faOff, src1, RV_PATCH_FADDR, 0);
      self.rv_storeSlot(dest);
    }

    // --- Control flow ---
    // #2271: Jeder Sprung innerhalb der Funktion belegt zwei Befehle —
    // applyPatches setzt JAL+NOP oder, ueber +/-1 MiB, AUIPC+JALR ein.
    if op == IRO_JMP {
      var patchOff: int64 := self.codeLen;
      self.rv_e32(0x0000006F);   // JAL x0, 0 placeholder
      self.rv_e32(0x00000013);   // NOP / JALR — nachgetragen
      self.addPatch(patchOff, imm, RV_PATCH_J, 0);
    }
    // #2112: Bedingte Spruenge als umgekehrter Kurzsprung ueber den Sprung.
    // BEQ/BNE reichen nur +/-4 KiB — ein while-Rumpf mit rund 16 poke8 lag
    // schon darueber, und der Abstand wurde still maskiert. Der Kurzsprung
    // ueberspringt beide Befehle der Sprungstelle (#2271: +12 statt +8).
    if op == IRO_BR_TRUE {
      self.rv_loadSlot(src1);
      self.rv_e32(self.rv_buildBtype(0, RV_T0, RV_ZERO, 12)); // BEQ t0, x0, +12
      var patchOff: int64 := self.codeLen;
      self.rv_e32(0x0000006F);                                 // JAL x0, label
      self.rv_e32(0x00000013);                                 // NOP / JALR
      self.addPatch(patchOff, imm, RV_PATCH_J, 0);
    }
    if op == IRO_BR_FALSE {
      self.rv_loadSlot(src1);
      self.rv_e32(self.rv_buildBtype(1, RV_T0, RV_ZERO, 12)); // BNE t0, x0, +12
      var patchOff: int64 := self.codeLen;
      self.rv_e32(0x0000006F);                                 // JAL x0, label
      self.rv_e32(0x00000013);                                 // NOP / JALR
      self.addPatch(patchOff, imm, RV_PATCH_J, 0);
    }
    if op == IRO_LABEL {
      // #2112: Die Tabelle war fest bei 1024; eine Marke dahinter wurde
      // still verworfen und ihr Sprung nie nachgetragen.
      if imm < 0 {
        EPrintStr("error: riscv: negative Marke "c); EPrintInt(imm); EPrintStrLn(" (#2112)."c);
        exit(1);
      }
      if imm >= self.labelCap {
        var lnc: int64 := self.labelCap * 2;
        while imm >= lnc { lnc := lnc * 2; }
        var lnb: int64 := alloc(lnc * 8);
        var lci: int64 := 0;
        while lci < lnc {
          if lci < self.labelCap { poke64(lnb + lci * 8, peek64(self.labelAddrs + lci * 8)); }
          else                   { poke64(lnb + lci * 8, -1); }
          lci := lci + 1;
        }
        self.labelAddrs := lnb;
        self.labelCap   := lnc;
      }
      poke64(self.labelAddrs + imm * 8, self.codeLen);
    }
    if op == IRO_FUNC_EXIT {
      self.emitEpilogue();
    }

    // --- Memory allocation ---
    if op == IRO_ALLOC {
      self.rv_LI(RV_A0, 0);
      self.rv_loadSlot(src1); self.rv_MV(RV_A1, RV_T0);
      self.rv_LI(RV_A2, 3);
      self.rv_LI(RV_A3, 34);
      self.rv_LI(RV_A4, -1);
      self.rv_LI(RV_A5, 0);
      self.rv_LI(RV_A7, RV_SYS_MMAP);
      self.rv_ECALL();
      self.rv_mmapGeprueft();   // #2144
      self.rv_MV(RV_T0, RV_A0); self.rv_storeSlot(dest);
    }
    if op == IRO_FREE {
      // #2052: munmap(ptr, len) — src2 ist die Laenge, dest der Rueckgabewert.
      // Hier stand `a1 = 0`, und das ist unter Linux immer EINVAL. Ohne
      // bekannte Laenge (src2 == -1, aus `dispose`) wird nichts erzeugt.
      // Dieselbe Entscheidung wie emitFree in emit_arm64.lyx — die beiden
      // muessen uebereinstimmen.
      if src2 >= 0 {
        self.rv_loadSlot(src2); self.rv_MV(RV_A1, RV_T0);
        self.rv_loadSlot(src1); self.rv_MV(RV_A0, RV_T0);
        self.rv_LI(RV_A7, RV_SYS_MUNMAP);
        self.rv_ECALL();
        if dest >= 0 { self.rv_MV(RV_T0, RV_A0); self.rv_storeSlot(dest); }
      }
    }

    // --- Type conversions: copy only (no FP support in this backend) ---
    if op == IRO_CAST || op == IRO_SEXT || op == IRO_ZEXT || op == IRO_TRUNC {
      self.rv_loadSlot(src1); self.rv_storeSlot(dest);
    }
    // #1764: ITOF und FTOI standen bis hierher in derselben Zeile wie CAST und
    // kopierten den Slot nur. Aus `1 as f64` wurde damit das Bitmuster der
    // ganzen Zahl 1 — eine Zahl nahe null statt 1.0, still und falsch.
    if op == IRO_ITOF {
      self.rv_loadSlot(src1);                 // t0 = ganze Zahl
      self.rv_FCVT_D_L(0, RV_T0);             // f0 = (double) t0
      self.rv_FSD(0, RV_FP, self.slotOff(dest));
    }
    if op == IRO_FTOI {
      self.rv_FLD(0, RV_FP, self.slotOff(src1));
      self.rv_FCVT_L_D(RV_T0, 0);             // t0 = (int64) f0, abgeschnitten
      self.rv_storeSlot(dest);
    }
    // #1764: Gleitkomma-Rechnung ueber f0/f1. Zwischen Laden und Speichern
    // steht kein Aufruf, die beiden Register brauchen also nicht gerettet zu
    // werden.
    if op == IRO_FADD || op == IRO_FSUB || op == IRO_FMUL || op == IRO_FDIV {
      self.rv_FLD(0, RV_FP, self.slotOff(src1));
      self.rv_FLD(1, RV_FP, self.slotOff(src2));
      if op == IRO_FADD { self.rv_FOP_D(0x01, 0, 0, 1); }
      if op == IRO_FSUB { self.rv_FOP_D(0x05, 0, 0, 1); }
      if op == IRO_FMUL { self.rv_FOP_D(0x09, 0, 0, 1); }
      if op == IRO_FDIV { self.rv_FOP_D(0x0D, 0, 0, 1); }
      self.rv_FSD(0, RV_FP, self.slotOff(dest));
    }
    if op == IRO_FNEG {
      self.rv_FLD(0, RV_FP, self.slotOff(src1));
      // FSGNJN.D f0, f0, f0 — Vorzeichen des zweiten Operanden negiert
      // uebernehmen, also genau das Vorzeichen umdrehen.
      self.rv_e32(0x53 | (0 << 7) | (1 << 12) | (0 << 15) | (0 << 20) | (0x11 << 25));
      self.rv_FSD(0, RV_FP, self.slotOff(dest));
    }
    // #2160: f32-Feld <-> double im Slot.
    if op == IRO_F64_ZU_F32 {
      self.rv_FLD(0, RV_FP, self.slotOff(src1));
      self.rv_e32(0x53 | (1 << 20) | (0x20 << 25));            // FCVT.S.D f0, f0 (RNE)
      self.rv_e32(0x53 | (RV_T0 << 7) | (0x70 << 25));        // FMV.X.W t0, f0 (vorzeichenerweitert)
      self.rv_e32(0x13 | (RV_T0 << 7) | (1 << 12) | (RV_T0 << 15) | (32 << 20));   // SLLI t0, t0, 32
      self.rv_e32(0x13 | (RV_T0 << 7) | (5 << 12) | (RV_T0 << 15) | (32 << 20));   // SRLI t0, t0, 32
      self.rv_storeSlot(dest);
    }
    if op == IRO_F32_ZU_F64 {
      self.rv_loadSlot(src1);
      self.rv_e32(0x53 | (RV_T0 << 15) | (0x78 << 25));       // FMV.W.X f0, t0
      self.rv_e32(0x53 | (0x21 << 25));                        // FCVT.D.S f0, f0
      self.rv_FSD(0, RV_FP, self.slotOff(dest));
    }
    if op == IRO_FSQRT {
      self.rv_FLD(0, RV_FP, self.slotOff(src1));
      // FSQRT.D f0, f0 (rs2 = 0, rm = 0 = RNE)
      self.rv_e32(0x53 | (0 << 7) | (0 << 12) | (0 << 15) | (0 << 20) | (0x2D << 25));
      self.rv_FSD(0, RV_FP, self.slotOff(dest));
    }
    // #1764: Vergleiche. FEQ/FLT/FLE schreiben 0 oder 1 in ein GANZZAHL-Register.
    // Fuer NEQ wird das Ergebnis von FEQ gekippt, fuer GT und GE werden die
    // Operanden getauscht — mehr Befehle hat die D-Erweiterung nicht.
    if op == IRO_FCMP_EQ || op == IRO_FCMP_NEQ || op == IRO_FCMP_LT ||
       op == IRO_FCMP_LE || op == IRO_FCMP_GT || op == IRO_FCMP_GE {
      self.rv_FLD(0, RV_FP, self.slotOff(src1));
      self.rv_FLD(1, RV_FP, self.slotOff(src2));
      if op == IRO_FCMP_EQ  { self.rv_FCMP_D(2, RV_T0, 0, 1); }
      if op == IRO_FCMP_NEQ { self.rv_FCMP_D(2, RV_T0, 0, 1); self.rv_e32(0x13 | (RV_T0<<7) | (4<<12) | (RV_T0<<15) | (1<<20)); }
      if op == IRO_FCMP_LT  { self.rv_FCMP_D(1, RV_T0, 0, 1); }
      if op == IRO_FCMP_LE  { self.rv_FCMP_D(0, RV_T0, 0, 1); }
      if op == IRO_FCMP_GT  { self.rv_FCMP_D(1, RV_T0, 1, 0); }
      if op == IRO_FCMP_GE  { self.rv_FCMP_D(0, RV_T0, 1, 0); }
      self.rv_storeSlot(dest);
    }

    // --- WSP-05: Inline-Assembly (imm = arch-Mnemonic-Id aus ir_lower RISC-V-Tabelle) ---
    // #1281: IRO_THROW → exit(1). try/catch weist ir_lower fuer dieses Ziel ab,
    // ein throw ist hier also immer unbehandelt; bis 1.0.16G erzeugte er nichts.
    if op == IRO_THROW {
      self.rv_LI(RV_A0, 1);
      self.rv_LI(RV_A7, RV_SYS_EXIT);
      self.rv_e32(0x00000073);   // ecall
    }

    // #1339: IRO_CONST_STR — Zeichenkettenliteral. Es fehlte, und deshalb
    // scheiterte auf diesem Ziel schon `PrintLn("hallo")`; vor der
    // Opcode-Pruefung verschwand der Opcode sogar spurlos, und das Programm
    // bekam einen Zeiger auf nichts.
    //
    // Verfahren wie im arm64-Backend: die Bytes stehen INLINE im Codestrom,
    // die Adresse entsteht PC-relativ, und ein Sprung fuehrt darum herum. Das
    // spart eine eigene Datensektion und funktioniert auf jedem Ladeort.
    if op == IRO_CONST_STR {
      var strBufR: int64 := peek64(self.ir + 32);
      var spR: int64 := strBufR + imm;
    // #1968: Die Laenge steht im VORSPANN vor der Zeichenkette (acht Byte bei
    // off-8, von irAddString gelegt), nicht in der Nullterminierung. `StrLen`
    // schnitt hier alles ab dem ersten Nullbyte im INHALT ab — bei einer
    // eingebetteten Datei (#1961) blieb davon ein Bruchstueck plus Fremdbytes
    // aus dem anschliessenden Speicher. Die Null wird weiterhin MITgeschrieben,
    // die Laufzeit erwartet sie bei pchar; sie ist nur nicht mehr das Mass.
      var lenR: int64 := _irStrLenVorspann(strBufR, imm);
      var totalR: int64 := lenR + 1;                     // mit der abschliessenden 0
      var padR: int64 := (4 - (totalR & 3)) & 3;         // auf 4 Byte auffuellen
      var paddedR: int64 := totalR + padR;
      // AUIPC t0, 0 → t0 = Adresse DIESES Befehls
      self.rv_e32(0x00000297);
      // ADDI t0, t0, 12 → hinter AUIPC + ADDI + JAL, also an den Anfang der Bytes
      self.rv_ADDI(RV_T0, RV_T0, 12);
      // JAL x0, 4 + paddedR → ueber die Zeichenkette hinweg
      self.rv_JAL_x0(4 + paddedR);
      var iR: int64 := 0;
      while (iR < lenR) { self.rv_e8(peek8(spR + iR)); iR := iR + 1; }
      self.rv_e8(0);
      var pR: int64 := 0;
      while (pR < padR) { self.rv_e8(0); pR := pR + 1; }
      self.rv_storeSlot(dest);
    }

    // #1339: Die Zusicherungen. Sie entstehen in ir_lower — ASSERT_NOT_ZERO
    // steht seit WP-OPCODE-REST vor JEDER Division, damit eine Null zu einem
    // kontrollierten Abbruch fuehrt statt zu SIGFPE. Kein Backend ausser
    // lyxos hat sie behandelt: der Opcode verschwand, und die Division lief
    // ungeprueft. Seit der Opcode-Pruefung aus #1339 faellt das beim
    // Uebersetzen auf — hier ist die Umsetzung.
    //
    // Aufbau wie im lyxos-Backend: Wert laden, gegen 0 pruefen, im guten Fall
    // ueber den Abbruch springen.
    // #2105: Die Sprungweite stand hier FEST auf +12 — der Kommentar sagte
    // "ueberspringt die drei Abbruchbefehle", dafuer braucht es aber +16
    // (Sprung, li, li, ecall). Das Ziel war also das ecall SELBST: im guten
    // Fall lief ein Systemaufruf mit dem a7 und a0, die gerade in den
    // Registern standen — nach einer Ausgabe ein write(<Wert>, ...). JEDE
    // Division auf riscv tat das. Fiel nur auf, wenn der Wert zufaellig ein
    // offener Deskriptor war: im vollen `make test` eine geerbte Pipe, und
    // das Programm starb mit SIGPIPE (rc 141) mitten in examples/test_zlib.
    // Jetzt wird die Weite wie bei xtensa NACHGETRAGEN, nicht gezaehlt.
    // arm64 (CBNZ +16) und arm_cm (BNE +0 ueber ein BKPT) waren richtig.
    if op == IRO_ASSERT_NOT_NULL || op == IRO_ASSERT_NOT_ZERO || op == IRO_ASSERT_TRUE {
      self.rv_loadSlot(src1);
      var anPos: int64 := self.codeLen;
      self.rv_e32(0x00000013);   // Platzhalter, unten durch BNE t0, x0 ersetzt
      self.rv_LI(RV_A0, 1);
      self.rv_LI(RV_A7, RV_SYS_EXIT);
      self.rv_e32(0x00000073);   // ecall
      self.rv_poke32at(anPos, self.rv_buildBtype(1, RV_T0, RV_ZERO, self.codeLen - anPos));
    }

    // ASSERT_BOUNDS: src1 = Index, src2 = Laenge. Verglichen wird VORZEICHENLOS
    // (bltu), damit ein negativer Index als sehr grosse Zahl erkannt wird und
    // nicht durchrutscht.
    // #2105: dieselbe feste Weite +12 wie oben — Ziel war das ecall.
    if op == IRO_ASSERT_BOUNDS {
      self.rv_loadSlot(src1);
      self.rv_loadSlot2(src2);
      var abPos: int64 := self.codeLen;
      self.rv_e32(0x00000013);   // Platzhalter, unten durch BLTU t0, t1 ersetzt
      self.rv_LI(RV_A0, 1);
      self.rv_LI(RV_A7, RV_SYS_EXIT);
      self.rv_e32(0x00000073);   // ecall
      self.rv_poke32at(abPos, self.rv_buildBtype(6, RV_T0, RV_T1, self.codeLen - abPos));   // funct3 6 = BLTU
    }

    // #1339: IRO_PANIC (121) war hier gar nicht behandelt — ein `panic("...")`
    // erzeugte NICHTS und das Programm lief an genau der Stelle weiter, an der
    // es abbrechen sollte. Bei einer erkannten Verletzung ist das die
    // gefaehrlichste Form des stillen Defaults. Verhalten wie IRO_THROW: exit(1).
    //
    // #2141: und zwar MIT Meldung — bis 1.2.16A endete panic stumm mit rc 1.
    // Wie cg_emitPanicBody auf x86 und der arm64-Zweig (die drei muessen
    // uebereinstimmen): Text bis zum Nullbyte nach stderr, ohne Zeilenende;
    // ein Nullzeiger schreibt nichts.
    if op == IRO_PANIC && src1 >= 0 {
      self.rv_LD(RV_A1, RV_FP, self.slotOff(src1));   // a1 = Text
      var pnNull: int64 := self.codeLen;
      self.rv_e32(0x00000013);                     // Platzhalter, unten BEQ a1, x0
      self.rv_LI(RV_A2, 0);                        // a2 = Laenge
      var pnLoop: int64 := self.codeLen;
      self.rv_ADD(RV_T1, RV_A1, RV_A2);
      self.rv_LBU(RV_T2, RV_T1, 0);
      self.rv_BEQZ_fwd(RV_T2, 12);   // Nullbyte -> hinter den Ruecksprung
      self.rv_ADDI(RV_A2, RV_A2, 1);
      var pnBack: int64 := pnLoop - self.codeLen;
      self.rv_JAL_x0(pnBack);
      self.rv_LI(RV_A0, 2);                        // fd = stderr
      self.rv_LI(RV_A7, RV_SYS_WRITE);
      self.rv_ECALL();
      self.rv_poke32at(pnNull, self.rv_buildBtype(0, RV_A1, RV_ZERO, self.codeLen - pnNull));   // BEQ
    }
    if op == IRO_PANIC {
      self.rv_LI(RV_A0, 1);
      self.rv_LI(RV_A7, RV_SYS_EXIT);
      self.rv_e32(0x00000073);   // ecall
    }

    if op == 167 {
      if      imm == 0 { self.rv_e32(0x00000013); }  // nop     (addi x0,x0,0)
      else if imm == 1 { self.rv_e32(0x10500073); }  // wfi
      else if imm == 2 { self.rv_e32(0x0FF0000F); }  // fence   (iorw,iorw)
      else if imm == 3 { self.rv_e32(0x0000100F); }  // fence.i
      else if imm == 4 { self.rv_e32(0x00000073); }  // ecall
      else if imm == 5 { self.rv_e32(0x00100073); }  // ebreak
      else if imm == 6 { self.rv_e32(0x30200073); }  // mret
      else if imm == 7 { self.rv_e32(0x10200073); }  // sret
      else {
        EPrintStrLn("error: asm: unbekannte Mnemonic (riscv)"c);
        exit(1);
      }
    }
  }

  // #2132: Argumente ab dem neunten nach dem RISC-V-psABI (LP64) auf den
  // Stapel — 8-Byte-Plaetze ab sp, sp bleibt 16-ausgerichtet. Der Platz wird
  // am Stueck angelegt und nach dem Aufruf wieder freigegeben; die Slots
  // liest dieser Weg s0-relativ. Liefert die Byte-Zahl fuer das ADDI danach.
  // Bis 1.2.15A wurde alles ab dem neunten Argument still verworfen.
  // Dieselbe Rechnung wie _a64StapelArgs in emit_arm64.lyx — die beiden
  // muessen uebereinstimmen.
  fn rv_StapelArgs(argBase: int64, argCount: int64): int64 {
    if argCount <= 8 { return 0; }
    if argBase < 0 {
      // Alte Konvention (Argumente im Kratzstreifen 0..7): dort ist fuer ein
      // neuntes kein Platz. Erzeugt ir_lower seit #2132 nicht mehr.
      EPrintStr("error: riscv: Aufruf mit "c); EPrintInt(argCount);
      EPrintStrLn(" Argumenten ohne Argumentblock — mehr als acht gehen so nicht (#2132)."c);
      exit(1);
    }
    var stBytes: int64 := (argCount - 8) * 8;
    if (stBytes & 15) != 0 { stBytes := stBytes + 8; }
    if stBytes > 2032 {
      EPrintStr("error: riscv: Aufruf mit "c); EPrintInt(argCount);
      EPrintStrLn(" Argumenten — mehr als 2 KB Stapelargumente werden nicht erzeugt (#2132)."c);
      exit(1);
    }
    self.rv_ADDI(RV_SP, RV_SP, 0 - stBytes);
    var si: int64 := 8;
    while si < argCount {
      self.rv_loadSlot(argBase + si);
      self.rv_SD(RV_T0, RV_SP, (si - 8) * 8);
      si := si + 1;
    }
    return stBytes;
  }

  // #2132: die ersten acht Argumente in a0..a7. argBase < 0 ist die alte
  // Konvention mit den Argumenten im Kratzstreifen ab Slot 0.
  fn rv_RegArgs(argBase: int64, argCount: int64) {
    var rb: int64 := argBase;
    if rb < 0 { rb := 0; }
    var ai: int64 := 0;
    while ai < argCount && ai < 8 {
      self.rv_loadSlot(rb + ai);
      self.rv_MV(RV_A0 + ai, RV_T0);
      ai := ai + 1;
    }
  }

  fn emitBuiltinCall(id: int64, argBase: int64, dest: int64) {
    // #1388: Die Adresse steht NICHT in Slot 0, sondern in einem hohen Block,
    // dessen erster Slot als src1 mitkommt (argBase). ir_lower spillt seit dem
    // Misdispatch-Fix (#839) absichtlich dorthin, weil die festen Slots 0..2
    // die Locals des Aufrufers ueberschreiben. Bis 1.1.5C lasen die drei
    // IR-Backends trotzdem Slot 0 und 1 — sie bekamen also irgendeinen Wert
    // des Aufrufers als Adresse. Auf arm64 war das ein Segfault bei jedem
    // peek8; gemessen wurde damals nur, ob die BYTES entstehen, nicht, ob das
    // Programm laeuft.
    var sBase: int64 := argBase;
    if (sBase < 0) { sBase := 0; }
    if id == 1 {
      // write(stdout, buf, len)
      //
      // #1764: Eine NEGATIVE Laenge ist ein Sentinel und heisst „bis zum
      // Nullbyte zaehlen". ir_lower setzt ihn fuer `PrintLn(pchar-Variable)`
      // (dort steht -1 im Laengen-Slot), weil die Laenge erst zur Laufzeit
      // feststeht. riscv reichte den Wert roh an write weiter — der Aufruf
      // scheiterte, und die Ausgabe blieb leer: `PrintLn("literal")` schrieb,
      // `PrintLn(s)` schwieg. Das lyxos-Backend kennt denselben Sentinel.
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));
      self.rv_LD(RV_A2, RV_FP, self.slotOff(sBase + 1));
      self.rv_SLT(RV_T0, RV_A2, RV_ZERO);   // t0 = (Laenge < 0)
      self.rv_BEQZ_fwd(RV_T0, 28);          // Laenge steht fest → ueber den Zaehlblock
      self.rv_LI(RV_A2, 0);
      var w1Loop: int64 := self.codeLen;
      self.rv_ADD(RV_T1, RV_A1, RV_A2);
      self.rv_LBU(RV_T2, RV_T1, 0);
      self.rv_BEQZ_fwd(RV_T2, 12);          // Nullbyte → hinter den Ruecksprung
      self.rv_ADDI(RV_A2, RV_A2, 1);
      self.rv_JAL_x0(w1Loop - self.codeLen);
      self.rv_LI(RV_A0, 1);
      self.rv_LI(RV_A7, RV_SYS_WRITE);
      self.rv_ECALL();
    } else if id == 2 {
      // #2031: Ganzzahl nach stdout.
      //
      // Bis 1.2.5F stand hier `id == 2 || id == 3` — BEIDE endeten im
      // exit-Zweig. `PrintLn(7)` gab damit nichts aus und beendete das
      // Programm mit dem Exit-Code 7; `return 0` wurde nie erreicht. Das sah
      // aus wie ein Programm, das vorzeitig fertig ist, und fiel deshalb nie
      // auf — Zeichenketten (ID 1) waren nicht betroffen, riscv wirkte
      // oberflaechlich funktionsfaehig.
      //
      // Laut src/backend/_builtin_ids.md ist ID 2 "Ganzzahl nach stdout" und
      // ID 3 das Prozessende. arm64 hat den Fall im Linux-Zweig laengst
      // richtig (inline itoa + write); riscv hat ihn nie bekommen.
      //
      // Dieselbe Ziffernrechnung wie IntToStr (ID 16) weiter unten — von
      // hinten nach vorn, weil die niedrigste Stelle zuerst herausfaellt, und
      // die Schleife laeuft MINDESTENS EINMAL, damit aus 0 eine "0" wird.
      // Register: t3 = Restwert, t4 = Pufferanfang, t5 = Schreibmarke,
      // t6 = Vorzeichenmerker.
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));
      self.rv_MV(28, RV_A1);                       // t3 = n
      self.rv_LI(RV_A1, 64);
      self.rv_bumpAlloc();                         // #2227: a0 = Puffer
      self.rv_MV(29, RV_A0);                       // t4 = Puffer
      self.rv_ADDI(30, 29, 63);                    // t5 = t4 + 63 (Ende)
      // #2148: NICHT negieren. `t3 = -t3` liess den kleinsten int64 negativ
      // (0 - n ist keine Betragsfunktion), DIV/REM lieferten dann negative
      // Ziffern, und PrintInt(INT64_MIN) gab Satzzeichen aus. Stattdessen
      // bleibt n negativ — DIV rundet gegen null, REM traegt das Vorzeichen
      // von n —, und jede Ziffer wird ueber die Maske a7 = -t6 einzeln zum
      // Betrag: (r ^ a7) - a7. Dieselbe Rechnung wie IntToStr (ID 16) unten —
      // die beiden muessen uebereinstimmen.
      self.rv_SLT(31, 28, 0);                      // t6 = (n < 0)
      self.rv_SUB(RV_A7, 0, 31);                   // a7 = 0 oder -1
      self.rv_LI(RV_A6, 10);
      var piL: int64 := self.codeLen;
      self.rv_DIV(RV_A1, 28, RV_A6);
      self.rv_REM(RV_A2, 28, RV_A6);
      self.rv_XOR(RV_A2, RV_A2, RV_A7);
      self.rv_SUB(RV_A2, RV_A2, RV_A7);            // Betrag der Ziffer
      self.rv_ADDI(RV_A2, RV_A2, 48);
      self.rv_ADDI(30, 30, 0 - 1);
      self.rv_SB(RV_A2, 30, 0);
      self.rv_MV(28, RV_A1);
      self.rv_BEQZ_fwd(28, 8);
      self.rv_JAL_x0(piL - self.codeLen);
      self.rv_BEQZ_fwd(31, 16);                    // Minuszeichen, falls noetig
      self.rv_ADDI(30, 30, 0 - 1);
      self.rv_LI(RV_A2, 45);
      self.rv_SB(RV_A2, 30, 0);
      // write(1, t5, (t4 + 63) - t5) — OHNE Zeilenumbruch; den haengt PrintLn
      // als eigenen ID-1-Aufruf an.
      self.rv_ADDI(RV_A3, 29, 63);
      self.rv_SUB(RV_A2, RV_A3, 30);               // Laenge
      self.rv_MV(RV_A1, 30);                       // Zeiger auf die erste Ziffer
      self.rv_LI(RV_A0, 1);                        // fd = stdout
      self.rv_LI(RV_A7, RV_SYS_WRITE);
      self.rv_ECALL();
    } else if id == 3 {
      // exit(code)  — #1740: Code steht im Argumentblock, nicht in Slot 0.
      self.rv_LD(RV_A0, RV_FP, self.slotOff(sBase));
      self.rv_LI(RV_A7, RV_SYS_EXIT);
      self.rv_ECALL();
    } else if id == 13 {
      // #1388: EPrintStr — write(2, buf, strlen(buf)); die Laenge rechnet der
      // Code selbst aus (die Konvention reicht nur einen Sentinel durch).
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));   // a1 = buf (#1740)
      self.rv_LI(RV_A2, 0);                        // a2 = Laenge
      var epLoop: int64 := self.codeLen;
      self.rv_ADD(RV_T1, RV_A1, RV_A2);
      self.rv_LBU(RV_T2, RV_T1, 0);
      self.rv_BEQZ_fwd(RV_T2, 12);   // Nullbyte -> hinter den Ruecksprung
      self.rv_ADDI(RV_A2, RV_A2, 1);
      var epBack: int64 := epLoop - self.codeLen;
      self.rv_JAL_x0(epBack);
      self.rv_LI(RV_A0, 2);                        // fd = stderr
      self.rv_LI(RV_A7, RV_SYS_WRITE);
      self.rv_ECALL();
    } else if id == 407 {
      // #2103: StrTrim — an Ort und Stelle, wie emitStrTrim (lyxos) und der
      // arm64-Zweig (die drei muessen uebereinstimmen). Geschrieben wird nur,
      // wenn hinten Leerraum stand (Literale sind nicht beschreibbar).
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));   // a1 = s
      var trA: int64 := self.codeLen;                  // r0
      self.rv_LBU(RV_T2, RV_A1, 0);
      self.rv_ADDI(RV_T0, RV_ZERO, 32); self.rv_Bcond(0, RV_T2, RV_T0, 7 * 4);    // -> r9
      self.rv_ADDI(RV_T0, RV_ZERO, 9);  self.rv_Bcond(0, RV_T2, RV_T0, 5 * 4);
      self.rv_ADDI(RV_T0, RV_ZERO, 13); self.rv_Bcond(0, RV_T2, RV_T0, 3 * 4);
      self.rv_ADDI(RV_T0, RV_ZERO, 10); self.rv_Bcond(1, RV_T2, RV_T0, 3 * 4);    // BNE -> r11
      self.rv_ADDI(RV_A1, RV_A1, 1);                   // r9
      self.rv_JAL_x0(trA - self.codeLen);              // r10
      self.rv_ADDI(RV_A2, RV_A1, 0);                   // r11
      var trE: int64 := self.codeLen;                  // r12
      self.rv_LBU(RV_T2, RV_A2, 0);
      self.rv_BEQZ_fwd(RV_T2, 12);                     // -> r16
      self.rv_ADDI(RV_A2, RV_A2, 1);
      self.rv_JAL_x0(trE - self.codeLen);
      self.rv_ADDI(RV_A3, RV_A2, 0);                   // r16
      var trH: int64 := self.codeLen;                  // r17
      self.rv_Bcond(7, RV_A1, RV_A2, 12 * 4);          // BGEU a1,a2 -> r29
      self.rv_LBU(RV_T2, RV_A2, 0 - 1);
      self.rv_ADDI(RV_T0, RV_ZERO, 32); self.rv_Bcond(0, RV_T2, RV_T0, 7 * 4);    // -> r27
      self.rv_ADDI(RV_T0, RV_ZERO, 9);  self.rv_Bcond(0, RV_T2, RV_T0, 5 * 4);
      self.rv_ADDI(RV_T0, RV_ZERO, 13); self.rv_Bcond(0, RV_T2, RV_T0, 3 * 4);
      self.rv_ADDI(RV_T0, RV_ZERO, 10); self.rv_Bcond(1, RV_T2, RV_T0, 3 * 4);    // BNE -> r29
      self.rv_ADDI(RV_A2, RV_A2, 0 - 1);               // r27
      self.rv_JAL_x0(trH - self.codeLen);              // r28
      self.rv_Bcond(0, RV_A2, RV_A3, 2 * 4);           // r29 BEQ a2,a3 -> r31
      self.rv_SB(RV_ZERO, RV_A2, 0);                   // r30
      self.rv_ADDI(RV_A0, RV_A1, 0);                   // r31
    } else if id == 15 {
      // #1388: StrLen — Zeichen bis zur Null zaehlen, Ergebnis nach a0.
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));   // a1 = buf (#1740)
      self.rv_LI(RV_A0, 0);
      var slLoop: int64 := self.codeLen;
      self.rv_ADD(RV_T1, RV_A1, RV_A0);
      self.rv_LBU(RV_T2, RV_T1, 0);
      self.rv_BEQZ_fwd(RV_T2, 12);
      self.rv_ADDI(RV_A0, RV_A0, 1);
      self.rv_JAL_x0(slLoop - self.codeLen);
    } else if id == 200 || id == 208 || id == 201 || id == 202 {
      // #1388: peek8/16/32/64 — Adresse aus Slot 0, Wert nach a0.
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));
      if (id == 200) { self.rv_LBU(RV_A0, RV_A1, 0); }
      if (id == 208) { self.rv_LHU(RV_A0, RV_A1, 0); }
      if (id == 201) { self.rv_LWU(RV_A0, RV_A1, 0); }
      if (id == 202) { self.rv_LD(RV_A0, RV_A1, 0); }
    } else if id == 6 {
      // #1388: StrSub(s, start, len) — Teilkette in frischen Speicher kopieren.
      // Puffer aus dem Bump-Block (#2227). Kopiert wird hoechstens bis zum
      // Ende der Kette: ein zu grosses `len` liest sonst darueber hinaus.
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));
      self.rv_MV(28, RV_A1);                       // t3 = s
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase + 1));
      self.rv_ADD(28, 28, RV_A1);                  // t3 = s + start
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase + 2));
      self.rv_MV(31, RV_A1);                       // t6 = len
      self.rv_ADD(RV_A1, 31, 31);
      self.rv_ADDI(RV_A1, RV_A1, 16);              // Groesse = 2*len + 16
      self.rv_bumpAlloc();                         // #2227: a0 = Puffer
      self.rv_MV(29, RV_A0);                       // t4 = Puffer
      self.rv_LI(30, 0);                           // t5 = Zaehler
      var subL: int64 := self.codeLen;
      self.rv_SLT(RV_T2, 30, 31);                  // t2 = (i < len)
      self.rv_BEQZ_fwd(RV_T2, 32);                 // fertig (acht Befehle weiter)
      self.rv_ADD(RV_A2, 28, 30);
      self.rv_LBU(RV_A3, RV_A2, 0);
      self.rv_BEQZ_fwd(RV_A3, 20);                 // Kette zu Ende
      self.rv_ADD(RV_A2, 29, 30);
      self.rv_SB(RV_A3, RV_A2, 0);
      self.rv_ADDI(30, 30, 1);
      self.rv_JAL_x0(subL - self.codeLen);
      self.rv_ADD(RV_A2, 29, 30);
      self.rv_SB(0, RV_A2, 0);                     // Nullbyte
      self.rv_MV(RV_A0, 29);
    } else if id == 7 {
      // #2028: StrConcat(a, b) — beide Ketten in frischen Speicher kopieren.
      //
      // Fehlte ganz; jedes Programm mit Zeichenkettenverkettung war fuer riscv
      // unbaubar — nach PrintLn das meistbenutzte Builtin. Puffer aus dem
      // Bump-Block (rv_bumpAlloc, #2227): der Zeiger muss den Aufruf
      // ueberleben.
      //
      // Register: t3 = a, t4 = b, t5 = Laenge a, t6 = Laenge b, a6 = Puffer,
      // t0 = Zaehler. a0..a5 und a7 sind nach dem Systemaufruf wieder frei.
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase));
      self.rv_MV(28, RV_A1);                       // t3 = a
      self.rv_LD(RV_A1, RV_FP, self.slotOff(sBase + 1));
      self.rv_MV(29, RV_A1);                       // t4 = b
      // Laenge von a → t5
      self.rv_LI(30, 0);
      var cnAL: int64 := self.codeLen;
      self.rv_ADD(RV_A2, 28, 30);
      self.rv_LBU(RV_A3, RV_A2, 0);
      self.rv_BEQZ_fwd(RV_A3, 12);                 // fertig (drei Befehle weiter)
      self.rv_ADDI(30, 30, 1);
      self.rv_JAL_x0(cnAL - self.codeLen);
      // Laenge von b → t6
      self.rv_LI(31, 0);
      var cnBL: int64 := self.codeLen;
      self.rv_ADD(RV_A2, 29, 31);
      self.rv_LBU(RV_A3, RV_A2, 0);
      self.rv_BEQZ_fwd(RV_A3, 12);
      self.rv_ADDI(31, 31, 1);
      self.rv_JAL_x0(cnBL - self.codeLen);
      // Groesse = la + lb + 16 (Reserve wie bei StrSub)
      self.rv_ADD(RV_A1, 30, 31);
      self.rv_ADDI(RV_A1, RV_A1, 16);
      self.rv_bumpAlloc();                         // #2227: a0 = Puffer
