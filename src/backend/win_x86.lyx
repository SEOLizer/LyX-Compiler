    // fremden Speicher, bis es fiel. Die Laufzeit holt den Block deshalb hier
    // von GetEnvironmentStringsA und legt ihn in CG_ENVBLOCK ab; std.env
    // fragt ihn ueber GetEnvBlock() ab und geht auf Linux weiter den alten Weg.
    // call [GetEnvironmentStringsA_IAT]  6 Bytes
    self.wxb_ce8(0xFF); self.wxb_ce8(0x15);
    self.envCallOff := self.codeLen - 2;
    self.wxb_ce32(0);
    // mov [rip+disp32], rax  (Block → CG_ENVBLOCK)  7 Bytes
    self.wxb_ce8(0x48); self.wxb_ce8(0x89); self.wxb_ce8(0x05);
    self.envStoreOff := self.codeLen; self.wxb_ce32(0);
    // 6 NOPs — _start bleibt 79 Bytes (19 - 13 = 6)
    var i: int64 := 0;
    while (i < 6) { self.wxb_ce8(0x90); i := i + 1; }
    // call main  E8 rel32  [48..52]
    self.wxb_ce8(0xE8); self.wxb_ce32(relMain);
    // mov ecx, eax  (exit code = main() return value)  2 bytes [53..54]
    self.wxb_ce8(0x89); self.wxb_ce8(0xC1);
    // call [ExitProcess_IAT]  FF 15 rel32              6 bytes [55..60]
    self.wxb_ce8(0xFF); self.wxb_ce8(0x15);
    self.wxb_ce32(0);   // placeholder, patched in wxb_patchIAT
    // 18 NOPs [61..78]: 4 original + 14 to pad _start to 79 bytes (= CG_H_STRLEN)
    var j: int64 := 0;
    while (j < 18) { self.wxb_ce8(0x90); j := j + 1; }
    // Total: 79 bytes = CG_H_STRLEN ✓ (WP-4.3: matches Linux _start size)
  }

  // ------------------------------------------------------------------
  // Trampoline zone: strlen (15 bytes, at code WIN_PREAMBLE_SZ+65)
  // Identical to Linux/macOS version, no syscalls needed.
  // ------------------------------------------------------------------

  fn wxb_emitStrlen() {
    self.wxb_ce8(0x48); self.wxb_ce8(0x31); self.wxb_ce8(0xC0);        // xor rax, rax
    self.wxb_ce8(0x80); self.wxb_ce8(0x3C); self.wxb_ce8(0x07); self.wxb_ce8(0x00); // cmp byte[rdi+rax], 0
    self.wxb_ce8(0x74); self.wxb_ce8(0x05);                             // jz +5
    self.wxb_ce8(0x48); self.wxb_ce8(0xFF); self.wxb_ce8(0xC0);        // inc rax
    self.wxb_ce8(0xEB); self.wxb_ce8(0xF5);                             // jmp -11
    self.wxb_ce8(0xC3);                                                  // ret
    // 15 bytes ✓
  }

  // ------------------------------------------------------------------
  // Trampoline zone: print_str JMP trampoline (26 bytes, at code WIN_PREAMBLE_SZ+94=602)
  // Jumps backward to win_print_str_impl at code[0].
  // rel32 = 0 - (WIN_PREAMBLE_SZ + 94 + 5) = 0 - 607 = -607  (WP-4.3: updated for 79-byte _start)
  // ------------------------------------------------------------------

  fn wxb_emitPrintStrJmp() {
    self.wxb_ce8(0xE9); self.wxb_ce32(0 - 607);  // JMP to WIN_PS_OFF = 0
    var i: int64 := 0;
    while (i < 21) { self.wxb_ce8(0x90); i := i + 1; }
    // 26 bytes ✓
  }

  // ------------------------------------------------------------------
  // Trampoline zone: print_int JMP trampoline (104 bytes, at code WIN_PREAMBLE_SZ+120=628)
  // Jumps backward to win_print_int_impl at code[68].
  // rel32 = 68 - (WIN_PREAMBLE_SZ + 120 + 5) = 68 - 633 = -565  (WP-4.3: updated)
  // ------------------------------------------------------------------

  fn wxb_emitPrintIntJmp() {
    self.wxb_ce8(0xE9); self.wxb_ce32(68 - 633);  // JMP to WIN_PI_OFF = 68
    var i: int64 := 0;
    while (i < 99) { self.wxb_ce8(0x90); i := i + 1; }
    // 104 bytes ✓
  }

  // ------------------------------------------------------------------
  // Trampoline zone: strsub JMP trampoline (71 bytes, at code WIN_PREAMBLE_SZ+210)
  // Jumps backward to win_strsub_impl at code[213].
  // rel32 = WIN_SS_OFF - (WIN_PREAMBLE_SZ + 224 + 5) = 213 - 737 = -524  (WP-4.3: updated for zone offset 224)
  // ------------------------------------------------------------------

  fn wxb_emitStrSubJmp() {
    self.wxb_ce8(0xE9); self.wxb_ce32(213 - 737);  // JMP to WIN_SS_OFF = 213
    var i: int64 := 0;
    while (i < 66) { self.wxb_ce8(0x90); i := i + 1; }
    // 71 bytes ✓
  }

  // ------------------------------------------------------------------
  // Trampoline zone: strcharat (6 bytes, at code WIN_PREAMBLE_SZ+281)
  // Identical to Linux version.
  // ------------------------------------------------------------------

  fn wxb_emitStrCharAt() {
    self.wxb_ce8(0x48); self.wxb_ce8(0x0F); self.wxb_ce8(0xB6); self.wxb_ce8(0x04); self.wxb_ce8(0x37); // movzx rax, byte[rdi+rsi]
    self.wxb_ce8(0xC3);  // ret
    // 6 bytes ✓
  }

  // ------------------------------------------------------------------
  // WP-4.3: Additional trampolines at Linux helper positions 301..1265
  // so that WIN_HELPERS_SZ = CG_H_USER = 1266 and user-code rel32 values
  // remain identical between Linux and Windows code buffers.
  // ------------------------------------------------------------------

  // 301..326 (26 bytes): EPrintStr — redirect to win_print_str_impl at offset 0
  // Trampoline at WIN_PREAMBLE_SZ+301 = 809; jmp end at 814; target=0
  fn wxb_emitEPrintStrJmp() {
    self.wxb_ce8(0xE9); self.wxb_ce32(0 - 814);  // JMP to WIN_PS_OFF = 0
    var i: int64 := 0;
    while (i < 21) { self.wxb_ce8(0x90); i := i + 1; }
    // 26 bytes ✓
  }

  // 327..430 (104 bytes): EPrintInt — redirect to win_print_int_impl at offset 68
  // Trampoline at WIN_PREAMBLE_SZ+327 = 835; jmp end at 840; target=WIN_PI_OFF=68
  fn wxb_emitEPrintIntJmp() {
    self.wxb_ce8(0xE9); self.wxb_ce32(68 - 840);  // JMP to WIN_PI_OFF = 68
    var i: int64 := 0;
    while (i < 99) { self.wxb_ce8(0x90); i := i + 1; }
    // 104 bytes ✓
  }

  // Emit n NOP bytes as a stub for unimplemented Windows helpers.
  // If called, returns immediately via RET then NOPs.
  fn wxb_emitStub(n: int64) {
    self.wxb_ce8(0xC3);  // RET
    var i: int64 := 1;
    while (i < n) { self.wxb_ce8(0x90); i := i + 1; }
  }

  // WP-A2: pad the code buffer with NOPs until the helper-zone offset (relative
  // to zoneStart) reaches `target`. Guarantees each trampoline lands exactly on
  // its WIN_H_* offset regardless of preceding helper sizes.
  fn wxb_padTo(zoneStart: int64, target: int64) {
    while ((self.codeLen - zoneStart) < target) { self.wxb_ce8(0x90); }
  }

  // WP-A2: emit a 5-byte `JMP rel32` to absolute code offset `targetOff`,
  // computing rel32 from the current position (position-independent).
  fn wxb_emitJmpTo(targetOff: int64) {
    self.wxb_ce8(0xE9);
    var endOff: int64 := self.codeLen + 4;  // codeLen now at rel32 start; +4 = after it
    self.wxb_ce32(targetOff - endOff);
  }

  // ------------------------------------------------------------------
  // Patch IAT rel32 fields after codeLen is known (so rdataRVA can be computed).
  // Called from wxb_buildCode after all code is assembled.
  // ------------------------------------------------------------------

  fn wxb_patchIAT() {
    var codeLen: int64 := self.codeLen;
    // .rdata starts at next page boundary after .text
    var rdataRVA: int64 := (WIN_TEXT_RVA + codeLen + WIN_SEC_ALIGN - 1) & ~(WIN_SEC_ALIGN - 1);

    // #1671: Die Lage der IAT haengt jetzt an der Zahl der Import-Deskriptoren
    // und steht im Plan. Frueher war sie die Konstante WIN_RDATA_IAT_OFF.
    self.wxb_planImports();
    var iat0: int64 := self.rdIatOff;

    // IAT slot RVAs — die fuenf der Laufzeit stehen am Anfang der ersten Gruppe
    var wfRVA:  int64 := rdataRVA + iat0 + 0;   // WriteFile
    var epRVA:  int64 := rdataRVA + iat0 + 8;   // ExitProcess
    var vaRVA:  int64 := rdataRVA + iat0 + 16;  // VirtualAlloc
    var gclRVA: int64 := rdataRVA + iat0 + 24;  // GetCommandLineA
    var ghRVA:  int64 := rdataRVA + iat0 + 32;  // GetStdHandle
    var gesRVA: int64 := rdataRVA + iat0 + 40;  // GetEnvironmentStringsA (#1677)
    var vfRVA:  int64 := rdataRVA + iat0 + 48;  // VirtualFree (#1678)
    if (self.envCallOff >= 0) {
      self.wxb_patch32(self.envCallOff + 2, gesRVA - (WIN_TEXT_RVA + self.envCallOff + 6));
    }

    // #1671: die Aufrufstellen der eigenen Externs. Der Codegen hat dort
    // `call *disp32(%rip)` erzeugt und den disp32 offen gelassen (Patchart 3,
    // Feld 8 traegt den Extern-Index). Ohne diese Schleife blieb er stehen —
    // daher der Sprung nach 0xffffffffffffffff.
    var pi: int64 := 0;
    while (pi < self.patchCount) {
      var pb: int64 := self.patchBuf + pi * WIN_PATCH_SZ;
      if (peek64(pb + WIN_PATCH_OFF_KIND) == WIN_PATCH_KIND_EXTERN) {
        // Der Nutzercode liegt im Backend um WIN_PREAMBLE_SZ weiter hinten als
        // im Codegen (die Windows-Startroutinen stehen davor). Ohne diese
        // Verschiebung landet der Patch an einer beliebigen Stelle, und der
        // Aufruf springt weiterhin ins Leere — beim ersten Anlauf genau so
        // beobachtet, obwohl die Import-Tabelle schon stimmte.
        var pos: int64 := peek64(pb) + WIN_PREAMBLE_SZ;
        var idx: int64 := peek64(pb + WIN_PATCH_OFF_IDX);  // Index in der Extern-Tabelle
        if (idx >= 0 && idx < self.externCount && self.rdExternSlot != 0) {
          var slotRVA: int64 := rdataRVA + peek64(self.rdExternSlot + idx * 8);
          self.wxb_patch32(pos, slotRVA - (WIN_TEXT_RVA + pos + 4));
        }
      }
      pi := pi + 1;
    }

    // Each call [X_IAT] at code offset K: rel32 = X_RVA - (TEXT_RVA + K + 6)
    // rel32 field is at code[K+2]
    var textBase: int64 := WIN_TEXT_RVA;

    // win_print_str_impl GetStdHandle call at code[30], instruction end at 36
    var r7: int64 := ghRVA - (textBase + WIN_CALL_GH1 + 6);
    self.wxb_patch32(WIN_CALL_GH1 + 2, r7);

    // win_print_str_impl WriteFile call at code[53], instruction end at 59
    var r1: int64 := wfRVA - (textBase + WIN_CALL_WF1 + 6);
    self.wxb_patch32(WIN_CALL_WF1 + 2, r1);

    // win_print_int_impl GetStdHandle call at code[170], instruction end at 176
    var r8: int64 := ghRVA - (textBase + WIN_CALL_GH2 + 6);
    self.wxb_patch32(WIN_CALL_GH2 + 2, r8);

    // win_print_int_impl WriteFile call at code[193], instruction end at 199
    var r2: int64 := wfRVA - (textBase + WIN_CALL_WF2 + 6);
    self.wxb_patch32(WIN_CALL_WF2 + 2, r2);

    // win_strsub_impl VirtualAlloc call at code[237], instruction end at 243
    var r3: int64 := vaRVA - (textBase + WIN_CALL_VA + 6);
    self.wxb_patch32(WIN_CALL_VA + 2, r3);

    // win_argv_setup GetCommandLineA call at code[284], instruction end at 290
    var r5: int64 := gclRVA - (textBase + WIN_CALL_GCL + 6);
    self.wxb_patch32(WIN_CALL_GCL + 2, r5);

    // win_argv_setup VirtualAlloc call at code[370], instruction end at 376
    var r6: int64 := vaRVA - (textBase + WIN_CALL_VA2 + 6);
    self.wxb_patch32(WIN_CALL_VA2 + 2, r6);

    // _start ExitProcess call at code[561], instruction end at 567
    var r4: int64 := epRVA - (textBase + WIN_CALL_EP + 6);
    self.wxb_patch32(WIN_CALL_EP + 2, r4);

    // WP-A2.3: VirtualAlloc call inside the appended heap helper (dynamic offset).
    if (self.vallocCallOff >= 0) {
      var rva: int64 := vaRVA - (textBase + self.vallocCallOff + 6);
      self.wxb_patch32(self.vallocCallOff + 2, rva);
    }

    // #1678: VirtualFree-Aufruf im Freigabe-Helfer.
    if (self.vfreeCallOff >= 0) {
      var rvaF: int64 := vfRVA - (textBase + self.vfreeCallOff + 6);
      self.wxb_patch32(self.vfreeCallOff + 2, rvaF);
    }
  }

  // ------------------------------------------------------------------
  // Build the Windows code buffer from a Linux cgBuf.
  // Layout: preamble (506) + trampoline zone (287) + user code (cgLen-287) + data.
  // The data buffer is appended directly after the code so that RIP-relative
  // disp32 values computed by cg_patchAll() remain valid in the PE .text section.
  // ------------------------------------------------------------------

  fn wxb_buildCode(cgBuf: int64, cgLen: int64, cgData: int64, cgDataLen: int64) {
    // WP-4.3: Extract call-main rel32 from Linux _start at cgBuf[63..66].
    // Linux _start layout (79 bytes): 63 bytes of setup + E8 rel32 call main.
    // Correction: win_relMain = linux_relMain + 14
    //   because Win user_off(1774) - Linux CG_H_USER(1266) = 508 = WIN_PREAMBLE_SZ,
    //   and Win _start call-next(561) - Linux _start call-next(67) = 494... wait:
    //   win_relMain = linux_relMain + (67 - 53) = linux_relMain + 14
    //   derivation: win_main = WIN_USER_OFF + (linux_main - CG_H_USER) = 1774 + linux_main - 1266
    //               linux_main = 67 + linux_relMain
    //               win_relMain = win_main - 561 = 1774 + 67 + linux_relMain - 1266 - 561 = linux_relMain + 14
    var b0: int64 := peek8(cgBuf + 63);
    var b1: int64 := peek8(cgBuf + 64);
    var b2: int64 := peek8(cgBuf + 65);
    var b3: int64 := peek8(cgBuf + 66);
    var linuxRelMain: int64 := b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    // Sign-extend from 32 to 64 bits
    if ((linuxRelMain & 0x80000000) != 0) {
      linuxRelMain := linuxRelMain | ((-1) & ~0xFFFFFFFF);
    }
    // WP-A2.4: relMain = linuxRelMain + 14. The Linux _start call-main rel32 lives at
    // cgBuf[63..66] (call E8 at off 62, end 67) → main_linux = 67 + linuxRelMain. The
    // win _start call-main E8 is at internal off 48 (end at WIN_PREAMBLE_SZ+53), and
    // win_main = WIN_PREAMBLE_SZ + main_linux (WIN_HELPERS_SZ cancels with the user-code
    // copy start). So relMain = win_main - (WIN_PREAMBLE_SZ+53) = main_linux - 53
    // = linuxRelMain + 14. (A2.1 wrongly dropped this +14 assuming the Linux call was at
    // off 53; single-fn programs survived by luck — 14-bytes-early hit benign padding;
    // multi-fn programs landed in the previous function's epilogue and crashed.)
    var relMain: int64 := linuxRelMain + 14;

    // Emit preamble (WIN_PREAMBLE_SZ = 508 bytes)
    self.wxb_emitPrintStr();     // 68 bytes, offsets 0..67
    self.wxb_emitPrintInt();     // 145 bytes, offsets 68..212 (was 143, comment was stale)
    self.wxb_emitStrSub();       // 58 bytes, offsets 213..270
    self.wxb_emitArgvSetup();    // 237 bytes, offsets 271..507

    // WP-A2: Emit trampoline zone. Each trampoline is padded to its EXACT WIN_H_*
    // offset (mirroring CG_H_* in codegen_x86.lyx) so user-code rel32 calls — which
    // use the Linux CG_H_* offsets — land on the right trampoline. Previously the
    // helpers were packed contiguously; because win64 strlen (15B) is shorter than
    // the Linux slot (24B), every later trampoline was shifted, so PrintStr calls
    // hit a NOP sled and fell through into PrintInt (string ptr printed as a number).
    var zoneStart: int64 := self.codeLen;
    self.wxb_padTo(zoneStart, WIN_H_START);     self.wxb_emitStart(relMain);
    self.wxb_padTo(zoneStart, WIN_H_STRLEN);    self.wxb_emitStrlen();
    self.wxb_padTo(zoneStart, WIN_H_PRINTSTR);  self.wxb_emitJmpTo(WIN_PS_OFF);
    self.wxb_padTo(zoneStart, WIN_H_PRINTINT);  self.wxb_emitJmpTo(WIN_PI_OFF);
    self.wxb_padTo(zoneStart, WIN_H_STRSUB);    self.wxb_emitJmpTo(WIN_SS_OFF);
    self.wxb_padTo(zoneStart, WIN_H_STRCHARAT); self.wxb_emitStrCharAt();
    self.wxb_padTo(zoneStart, WIN_H_EPRINTSTR); self.wxb_emitJmpTo(WIN_PS_OFF);
    self.wxb_padTo(zoneStart, WIN_H_EPRINTINT); self.wxb_emitJmpTo(WIN_PI_OFF);
    // Unimplemented helpers: a bare RET at each offset so any call returns cleanly
    // (canary init/fail become no-ops → effectively disabled, not a crash).
    self.wxb_padTo(zoneStart, WIN_H_F64STR);      self.wxb_ce8(0xC3);
    self.wxb_padTo(zoneStart, WIN_H_STRSPLIT);    self.wxb_ce8(0xC3);
    self.wxb_padTo(zoneStart, WIN_H_MAP_NEW);     self.wxb_ce8(0xC3);
    self.wxb_padTo(zoneStart, WIN_H_MAP_SET);     self.wxb_ce8(0xC3);
    self.wxb_padTo(zoneStart, WIN_H_MAP_GET);     self.wxb_ce8(0xC3);
    self.wxb_padTo(zoneStart, WIN_H_MAP_HAS);     self.wxb_ce8(0xC3);
    self.wxb_padTo(zoneStart, WIN_H_STACK_FAIL);  self.wxb_ce8(0xC3);
    self.wxb_padTo(zoneStart, WIN_H_CANARY_INIT); self.wxb_ce8(0xC3);
    // Pad remainder so user code starts exactly at WIN_H_USER (= CG_H_USER).
    self.wxb_padTo(zoneStart, WIN_H_USER);

    // Copy user code verbatim (all rel32 values remain correct because:
    //   user code is shifted by WIN_USER_OFF=1774 in Windows vs CG_H_USER=1266 in Linux,
    //   helpers are shifted by WIN_PREAMBLE_SZ=508 in Windows vs 0 in Linux,
    //   difference = 1774-1266 = 508 = WIN_PREAMBLE_SZ in both cases → offsets cancel ✓)
    var i: int64 := WIN_HELPERS_SZ;
    while (i < cgLen) {
      self.wxb_ce8(peek8(cgBuf + i));
      i := i + 1;
    }

    // Append data buffer so that RIP-relative LEA disp32 values are correct.
    // cg_patchAll computed disp32 = codeLen - codeOff - 4 + dataOff, which
    // assumes data follows code at exactly offset WIN_PREAMBLE_SZ + cgLen.
    var dataTextOff: int64 := self.codeLen;   // WP-WINARGV: .text-Offset des Daten-/Globals-Blocks
    var j: int64 := 0;
    while (j < cgDataLen) {
      self.wxb_ce8(peek8(cgData + j));
      j := j + 1;
    }
    // WP-WINARGV: rip-relative disp der argc/argv-Stores im _start patchen (CG_ARGC=32, CG_ARGV=40).
    // disp = Ziel-Offset − (disp32-Feld-Offset + 4); rein code-buffer-lokal (rip-rel positionsunabh.).
    if self.argcStoreOff >= 0 {
      self.wxb_patch32(self.argcStoreOff, (dataTextOff + 32) - (self.argcStoreOff + 4));
      self.wxb_patch32(self.argvStoreOff, (dataTextOff + 40) - (self.argvStoreOff + 4));
    }
    if self.envStoreOff >= 0 {   // #1677: CG_ENVBLOCK liegt bei 96
      self.wxb_patch32(self.envStoreOff, (dataTextOff + 96) - (self.envStoreOff + 4));
    }

    // WP-A2.2: rebase absolute VMT pointers in the appended user/data zone and
    // collect their .text RVAs for the .reloc section.
    self.wxb_applyBaseRelocs(cgLen);

    // WP-A2.3: replace inline Linux mmap syscalls (alloc/new/dynarray) with calls
    // to a VirtualAlloc-based helper appended here at code end.
    var userEnd: int64 := self.codeLen;
    var vallocOff: int64 := self.codeLen;
    self.wxb_emitVAlloc();
    // #1678: derselbe Handgriff fuer die Freigabe. Ohne ihn blieb in jeder
    // erzeugten Datei ein rohes `mov rax, 11; syscall` stehen — auf Windows
    // ein beliebiger NT-Dienst mit den Argumenten in den falschen Registern.
    var vfreeOff: int64 := self.codeLen;
    self.wxb_emitVFree();
    self.wxb_replaceMmap(vallocOff, userEnd);
    self.wxb_replaceMunmap(vfreeOff, userEnd);
    self.wxb_pruefeSyscalls(userEnd);

    // Patch IAT indirect call rel32 fields now that codeLen is final
    self.wxb_patchIAT();
  }

  // WP-A2.3: VirtualAlloc-based heap helper. Entry: rsi = size (Linux mmap arg2).
  // Returns rax = base. 41 bytes; the `call [VirtualAlloc]` rel32 is patched in
  // wxb_patchIAT via vallocCallOff.
  fn wxb_emitVAlloc() {
    var start: int64 := self.codeLen;
    self.wxb_ce8(0x55);                                          // push rbp
    self.wxb_ce8(0x48); self.wxb_ce8(0x89); self.wxb_ce8(0xE5); // mov rbp, rsp
    self.wxb_ce8(0x48); self.wxb_ce8(0x83); self.wxb_ce8(0xE4); self.wxb_ce8(0xF0); // and rsp, -16
    self.wxb_ce8(0x48); self.wxb_ce8(0x83); self.wxb_ce8(0xEC); self.wxb_ce8(0x20); // sub rsp, 0x20
    self.wxb_ce8(0x48); self.wxb_ce8(0x89); self.wxb_ce8(0xF2); // mov rdx, rsi  (dwSize)
    self.wxb_ce8(0x48); self.wxb_ce8(0x31); self.wxb_ce8(0xC9); // xor rcx, rcx  (lpAddress=NULL)
    self.wxb_ce8(0x41); self.wxb_ce8(0xB8); self.wxb_ce8(0x00); self.wxb_ce8(0x30); self.wxb_ce8(0x00); self.wxb_ce8(0x00); // mov r8d, 0x3000
    self.wxb_ce8(0x41); self.wxb_ce8(0xB9); self.wxb_ce8(0x04); self.wxb_ce8(0x00); self.wxb_ce8(0x00); self.wxb_ce8(0x00); // mov r9d, 0x04
    self.vallocCallOff := self.codeLen;                          // offset of FF 15
    self.wxb_ce8(0xFF); self.wxb_ce8(0x15); self.wxb_ce32(0);    // call [VirtualAlloc_IAT] (patched)
    self.wxb_ce8(0x48); self.wxb_ce8(0x89); self.wxb_ce8(0xEC); // mov rsp, rbp
    self.wxb_ce8(0x5D);                                          // pop rbp
    self.wxb_ce8(0xC3);                                          // ret
    var _unused: int64 := start;
  }

  // WP-A2.3: scan [from, to) for the 12-byte inline mmap pattern
  // (48 B8 09 00*7  0F 05 = movabs rax,9; syscall) and rewrite each to
  // `call vallocOff` (E8 rel32) + NOP padding. Size is already in rsi.
  fn wxb_replaceMmap(vallocOff: int64, endOff: int64) {
    var i: int64 := WIN_USER_OFF;
    while (i + 7 <= endOff) {
      if ((i + 12) <= endOff &&
          peek8(self.code + i) == 0x48 && peek8(self.code + i + 1) == 0xB8 &&
          peek8(self.code + i + 2) == 0x09 && peek8(self.code + i + 3) == 0x00 &&
          peek8(self.code + i + 4) == 0x00 && peek8(self.code + i + 5) == 0x00 &&
          peek8(self.code + i + 6) == 0x00 && peek8(self.code + i + 7) == 0x00 &&
          peek8(self.code + i + 8) == 0x00 && peek8(self.code + i + 9) == 0x00 &&
          peek8(self.code + i + 10) == 0x0F && peek8(self.code + i + 11) == 0x05) {
        var rel: int64 := vallocOff - (i + 5);
        poke8(self.code + i, 0xE8);
        poke8(self.code + i + 1, rel & 0xFF);
        poke8(self.code + i + 2, (rel >> 8) & 0xFF);
        poke8(self.code + i + 3, (rel >> 16) & 0xFF);
        poke8(self.code + i + 4, (rel >> 24) & 0xFF);
        var p: int64 := 5;
        while (p < 12) { poke8(self.code + i + p, 0x90); p := p + 1; }
        i := i + 12;
      } else if (peek8(self.code + i) == 0xB8 && peek8(self.code + i + 1) == 0x09 &&
                 peek8(self.code + i + 2) == 0x00 && peek8(self.code + i + 3) == 0x00 &&
                 peek8(self.code + i + 4) == 0x00 &&
                 peek8(self.code + i + 5) == 0x0F && peek8(self.code + i + 6) == 0x05) {
        // #1678: Die KURZFORM `mov eax, nr` (7 Byte statt 12). Der Ersetzer
        // kannte bis hierher nur die movabs-Form und ging an jeder Stelle
        // vorbei, die den Wert schmal laedt — das waren die Aufrufe aus dem
        // Array-Wachstum, in einer erzeugten Datei zwei Dutzend.
        var relK: int64 := vallocOff - (i + 5);
        poke8(self.code + i, 0xE8);
        poke8(self.code + i + 1, relK & 0xFF);
        poke8(self.code + i + 2, (relK >> 8) & 0xFF);
        poke8(self.code + i + 3, (relK >> 16) & 0xFF);
        poke8(self.code + i + 4, (relK >> 24) & 0xFF);
        poke8(self.code + i + 5, 0x90);
        poke8(self.code + i + 6, 0x90);
        i := i + 7;
      } else {
        i := i + 1;
      }
    }
  }

  // #1678: VirtualFree-basierter Freigabe-Helfer. Eintritt wie beim Linux-
  // munmap: rdi = Adresse, rsi = Laenge. Windows braucht die Laenge NICHT —
  // MEM_RELEASE (0x8000) verlangt dwSize = 0 und die Basisadresse der
  // Belegung. Beides passt: `alloc` gibt Bloecke ueber APOOL_MAX ein eigenes
  // Mapping, und `free` bekommt genau diesen Zeiger zurueck.
  fn wxb_emitVFree() {
    self.wxb_ce8(0x55);                                          // push rbp
    self.wxb_ce8(0x48); self.wxb_ce8(0x89); self.wxb_ce8(0xE5); // mov rbp, rsp
    self.wxb_ce8(0x48); self.wxb_ce8(0x83); self.wxb_ce8(0xE4); self.wxb_ce8(0xF0); // and rsp, -16
    self.wxb_ce8(0x48); self.wxb_ce8(0x83); self.wxb_ce8(0xEC); self.wxb_ce8(0x20); // sub rsp, 0x20
    self.wxb_ce8(0x48); self.wxb_ce8(0x89); self.wxb_ce8(0xF9); // mov rcx, rdi  (lpAddress)
    self.wxb_ce8(0x48); self.wxb_ce8(0x31); self.wxb_ce8(0xD2); // xor rdx, rdx  (dwSize = 0)
    self.wxb_ce8(0x41); self.wxb_ce8(0xB8); self.wxb_ce8(0x00); self.wxb_ce8(0x80); self.wxb_ce8(0x00); self.wxb_ce8(0x00); // mov r8d, MEM_RELEASE
    self.vfreeCallOff := self.codeLen;
    self.wxb_ce8(0xFF); self.wxb_ce8(0x15); self.wxb_ce32(0);    // call [VirtualFree_IAT]
    // VirtualFree liefert BOOL; munmap liefert 0 bei Erfolg. Umdrehen, damit
    // der Aufrufer dieselbe Antwort bekommt wie unter Linux.
    self.wxb_ce8(0x48); self.wxb_ce8(0x85); self.wxb_ce8(0xC0); // test rax, rax
    self.wxb_ce8(0x0F); self.wxb_ce8(0x94); self.wxb_ce8(0xC0); // sete al
    self.wxb_ce8(0x48); self.wxb_ce8(0x0F); self.wxb_ce8(0xB6); self.wxb_ce8(0xC0); // movzx rax, al
    self.wxb_ce8(0x48); self.wxb_ce8(0xF7); self.wxb_ce8(0xD8); // neg rax  (0 = ok, -1 = Fehler)
    self.wxb_ce8(0x48); self.wxb_ce8(0x89); self.wxb_ce8(0xEC); // mov rsp, rbp
    self.wxb_ce8(0x5D);                                          // pop rbp
    self.wxb_ce8(0xC3);                                          // ret
  }

  // #1678: dieselbe Ersetzung wie wxb_replaceMmap, fuer munmap (Nummer 11).
  fn wxb_replaceMunmap(vfreeOff: int64, endOff: int64) {
    var i: int64 := WIN_USER_OFF;
    while (i + 7 <= endOff) {
      if ((i + 12) <= endOff &&
          peek8(self.code + i) == 0x48 && peek8(self.code + i + 1) == 0xB8 &&
          peek8(self.code + i + 2) == 0x0B && peek8(self.code + i + 3) == 0x00 &&
          peek8(self.code + i + 4) == 0x00 && peek8(self.code + i + 5) == 0x00 &&
          peek8(self.code + i + 6) == 0x00 && peek8(self.code + i + 7) == 0x00 &&
          peek8(self.code + i + 8) == 0x00 && peek8(self.code + i + 9) == 0x00 &&
          peek8(self.code + i + 10) == 0x0F && peek8(self.code + i + 11) == 0x05) {
        var rel: int64 := vfreeOff - (i + 5);
        poke8(self.code + i, 0xE8);
        poke8(self.code + i + 1, rel & 0xFF);
        poke8(self.code + i + 2, (rel >> 8) & 0xFF);
        poke8(self.code + i + 3, (rel >> 16) & 0xFF);
        poke8(self.code + i + 4, (rel >> 24) & 0xFF);
        var p: int64 := 5;
        while (p < 12) { poke8(self.code + i + p, 0x90); p := p + 1; }
        i := i + 12;
      } else if (peek8(self.code + i) == 0xB8 && peek8(self.code + i + 1) == 0x0B &&
                 peek8(self.code + i + 2) == 0x00 && peek8(self.code + i + 3) == 0x00 &&
                 peek8(self.code + i + 4) == 0x00 &&
                 peek8(self.code + i + 5) == 0x0F && peek8(self.code + i + 6) == 0x05) {
        // #1678: Die KURZFORM `mov eax, nr` (7 Byte statt 12). Der Ersetzer
        // kannte bis hierher nur die movabs-Form und ging an jeder Stelle
        // vorbei, die den Wert schmal laedt — das waren die Aufrufe aus dem
        // Array-Wachstum, in einer erzeugten Datei zwei Dutzend.
        var relK: int64 := vfreeOff - (i + 5);
        poke8(self.code + i, 0xE8);
        poke8(self.code + i + 1, relK & 0xFF);
        poke8(self.code + i + 2, (relK >> 8) & 0xFF);
        poke8(self.code + i + 3, (relK >> 16) & 0xFF);
        poke8(self.code + i + 4, (relK >> 24) & 0xFF);
        poke8(self.code + i + 5, 0x90);
        poke8(self.code + i + 6, 0x90);
        i := i + 7;
      } else {
        i := i + 1;
      }
    }
  }

  // #1678: Nach dem Ersetzen nachsehen, ob noch ein rohes `syscall` im
  // Benutzercode steht.
  //
  // Ein Linux-Syscall in einer PE-Datei ruft auf Windows einen NT-Dienst mit
  // ganz anderer Bedeutung — und die Argumente stehen in den falschen
  // Registern, weil Windows r10 statt rdi nimmt. Beim Freigeben hat genau das
  // Wines Buchfuehrung ueber die Speicherbereiche zerstoert (#1678).
  //
  // Gemeldet wird, nicht abgebrochen: der Bestand traegt weitere Nummern
  // (Datei- und Prozessaufrufe), fuer die es hier noch keinen Ersatz gibt.
  // Ein Abbruch machte jede win64-Uebersetzung unmoeglich; das Schweigen
  // darueber war aber der Grund, warum #1678 so lange unentdeckt blieb.
  // tests/win64_syscalls_test.sh haelt die Zahl fest, damit keine neue
  // dazukommt.
  fn wxb_pruefeSyscalls(endOff: int64) {
    var n: int64 := 0;
    var i: int64 := WIN_USER_OFF;
    while (i + 2 <= endOff) {
      if (peek8(self.code + i) == 0x0F && peek8(self.code + i + 1) == 0x05) { n := n + 1; }
      i := i + 1;
    }
    if (n > 0) {
      EPrintStr("warning: win64: "c);
      EPrintInt(n);
      EPrintStrLn(" rohe Linux-Syscalls im erzeugten Code (#1678)."c);
      EPrintStrLn("  Auf Windows trifft jeder davon einen fremden NT-Dienst."c);
      EPrintStrLn("  mmap und munmap sind ersetzt; der Rest hat noch keinen Ersatz."c);
    }
  }

  // WP-A2.2: For each base reloc (ELF image RVA of an 8-byte absolute pointer),
  // map it to the win code-buffer position, add the constant ELF→win delta to the
  // stored value (so it is correct at the preferred ImageBase), and record the
  // .text RVA (sorted) so wxb_buildRelocBlocks can emit IMAGE_REL_BASED_DIR64.
  fn wxb_applyBaseRelocs(cgLen: int64) {
    self.relocContentLen := 0;
    if (self.baseRelocCount <= 0) { return; }
    // delta = (win vaddr of a user/data byte) − (its ELF vaddr); constant across
    // the verbatim-copied user code + data zone.
    var delta: int64 := (WIN_IMAGE_BASE + WIN_TEXT_RVA + WIN_USER_OFF - WIN_H_USER)
                        - (WIN_SRC_ELF_BASE + WIN_SRC_CODE_OFF);
    var i: int64 := 0;
    while (i < self.baseRelocCount) {
      var rva: int64 := peek64(self.baseRelocBuf + i * 8);
      var o:   int64 := rva - WIN_SRC_CODE_OFF;             // offset into cg code+data image
      var winOff: int64 := WIN_USER_OFF + o - WIN_H_USER;  // offset into win .text buffer
      var v: int64 := peek64(self.code + winOff);
      poke64(self.code + winOff, v + delta);
      poke64(self.peRVAs + i * 8, WIN_TEXT_RVA + winOff);   // .text RVA of the pointer
      i := i + 1;
    }
    // Insertion-sort the RVAs ascending (page grouping needs sorted input).
    var a: int64 := 1;
    while (a < self.baseRelocCount) {
      var key: int64 := peek64(self.peRVAs + a * 8);
      var b: int64 := a - 1;
      while (b >= 0 && peek64(self.peRVAs + b * 8) > key) {
        poke64(self.peRVAs + (b + 1) * 8, peek64(self.peRVAs + b * 8));
        b := b - 1;
      }
      poke64(self.peRVAs + (b + 1) * 8, key);
      a := a + 1;
    }
    self.wxb_buildRelocBlocks();
  }

  // WP-A2.2: build IMAGE_BASE_RELOCATION blocks (grouped per 4 KB page) from the
  // sorted peRVAs into self.relocContent. Each entry = (10<<12)|(offset&0xFFF),
  // type 10 = IMAGE_REL_BASED_DIR64. Bounded to one FILE_ALIGN (512 B) page of
  // content — ample for typical vtable counts.
  fn wxb_buildRelocBlocks() {
    var pos: int64 := 0;          // write cursor in relocContent
    var i: int64 := 0;
    while (i < self.baseRelocCount) {
      var page: int64 := peek64(self.peRVAs + i * 8) & ~(0xFFF);
      // count entries on this page
      var k: int64 := i;
      while (k < self.baseRelocCount && (peek64(self.peRVAs + k * 8) & ~(0xFFF)) == page) {
        k := k + 1;
      }
      var nEnt: int64 := k - i;
      var blockSize: int64 := 8 + nEnt * 2;
      if ((blockSize & 2) != 0) { blockSize := blockSize + 2; }  // 4-byte align
      // block header
      poke32(self.relocContent + pos, page);          pos := pos + 4;
      poke32(self.relocContent + pos, blockSize);     pos := pos + 4;
      var e: int64 := i;
      while (e < k) {
        var off: int64 := peek64(self.peRVAs + e * 8) - page;
        poke16(self.relocContent + pos, (10 << 12) | (off & 0xFFF));
        pos := pos + 2;
        e := e + 1;
      }
      if ((nEnt & 1) != 0) { poke16(self.relocContent + pos, 0); pos := pos + 2; }  // pad entry
      i := k;
    }
    self.relocContentLen := pos;
  }

  // ------------------------------------------------------------------
  // Write .rdata section content to out buffer.
  // Must be called after wxb_buildCode so rdataRVA is deterministic.
  // ------------------------------------------------------------------

  fn wxb_writeRdata(rdataRVA: int64) {
    // #1671: Aufgebaut nach dem Plan aus wxb_planImports — eine Gruppe je
    // DLL, die Laufzeit als erste fuenf Eintraege der ersten Gruppe.
    var nDll: int64 := self.impDllCount;
    var startLen: int64 := self.outLen;

    // ---- Import Directory Table: eine Zeile je DLL, dann Nullzeile ----
    var nameCur: int64 := self.impNamesOff;
    var d: int64 := 0;
    while (d < nDll) {
      self.wxb_oe32(rdataRVA + peek64(self.impIntOff + d * 8));   // OriginalFirstThunk
      self.wxb_oe32(0);                                            // TimeDateStamp
      self.wxb_oe32(0xFFFFFFFF);                                   // ForwarderChain
      self.wxb_oe32(rdataRVA + nameCur);                           // Name RVA
      self.wxb_oe32(rdataRVA + peek64(self.impIatOff + d * 8));    // FirstThunk
      nameCur := nameCur + peek64(self.impDllLen + d * 8) + 1;
      d := d + 1;
    }
    self.wxb_oe32(0); self.wxb_oe32(0); self.wxb_oe32(0); self.wxb_oe32(0); self.wxb_oe32(0);

    // ---- INT und IAT je DLL (gleicher Inhalt: Zeiger auf hint+Name) ----
    // Die Namensoffsets muessen zweimal in derselben Reihenfolge entstehen,
    // deshalb hier eine kleine Tabelle statt zweier Rechnungen.
    var runtimeNames: int64 := self.impNamesOff;
    var dn: int64 := 0;
    while (dn < nDll) { runtimeNames := runtimeNames + peek64(self.impDllLen + dn * 8) + 1; dn := dn + 1; }
    // Reihenfolge der Laufzeitnamen: WriteFile, ExitProcess, VirtualAlloc,
    // GetCommandLineA, GetStdHandle, GetEnvironmentStringsA, VirtualFree.
    var rtOff: int64 := alloc(7 * 8);
    poke64(rtOff,      runtimeNames);
    poke64(rtOff + 8,  runtimeNames + 12);
    poke64(rtOff + 16, runtimeNames + 12 + 14);
    poke64(rtOff + 24, runtimeNames + 12 + 14 + 15);
    poke64(rtOff + 32, runtimeNames + 12 + 14 + 15 + 18);
    poke64(rtOff + 40, runtimeNames + 12 + 14 + 15 + 18 + 15);   // #1677
    poke64(rtOff + 48, runtimeNames + 12 + 14 + 15 + 18 + 15 + 25);   // #1678 VirtualFree

    // #1676: Die Reihenfolge muss der aus wxb_planImports entsprechen: je DLL
    // erst INT, dann IAT. Geschrieben wurden zuvor ERST alle INTs und DANACH
    // alle IATs — bei einer einzigen DLL faellt das zusammen, ab der zweiten
    // liegt jede Gruppe an der Stelle der vorigen. Der Deskriptor der zweiten
    // DLL zeigte damit auf den Inhalt der ersten. Mein Nachweis zu #1671 hatte
    // nur eine DLL geprueft und konnte das nicht sehen.
    var d2: int64 := 0;
    while (d2 < nDll) {
      var durchgang: int64 := 0;
      while (durchgang < 2) {          // 0 = INT, 1 = IAT — bitgleich
        if (d2 == 0) {
          var r: int64 := 0;
          while (r < 7) { self.wxb_oe64(rdataRVA + peek64(rtOff + r * 8)); r := r + 1; }
        }
        // #1676: eigene Externs dieser DLL — der Namensoffset kommt aus der
        // Tabelle aus wxb_planImports, nicht aus einer zweiten Rechnung.
        var e: int64 := 0;
        while (e < self.externCount) {
          var eb: int64 := self.externBuf + e * WIN_EXTERN_SZ;
          var lp: int64 := peek64(eb + WIN_EXTERN_OFF_LIBPTR);
          var ll: int64 := peek64(eb + WIN_EXTERN_OFF_LIBLEN);
          if (lp == 0 || ll <= 0) { lp := "kernel32.dll"c as int64; ll := 12; }
          if (self.wxb_dllGleich(peek64(self.impDllPtr + d2 * 8), peek64(self.impDllLen + d2 * 8), lp, ll) != 0) {
            self.wxb_oe64(rdataRVA + peek64(self.rdExternName + e * 8));
          }
          e := e + 1;
        }
        self.wxb_oe64(0);            // Nullabschluss je Gruppe
        durchgang := durchgang + 1;
      }
      d2 := d2 + 1;
    }

    // ---- DLL-Namen ----
    var d3: int64 := 0;
    while (d3 < nDll) {
      var np: int64 := peek64(self.impDllPtr + d3 * 8);
      var nl: int64 := peek64(self.impDllLen + d3 * 8);
      var i3: int64 := 0;
      while (i3 < nl) { self.wxb_oe8(peek8(np + i3)); i3 := i3 + 1; }
      self.wxb_oe8(0);
      d3 := d3 + 1;
    }

    // ---- hint + Name der fuenf Laufzeitfunktionen ----
    self.wxb_oName("WriteFile"c, 9);
    self.wxb_oName("ExitProcess"c, 11);
    self.wxb_oName("VirtualAlloc"c, 12);
    self.wxb_oName("GetCommandLineA"c, 15);
    self.wxb_oName("GetStdHandle"c, 12);
    self.wxb_oName("GetEnvironmentStringsA"c, 22);   // #1677: hint+22+NUL = 25
    self.wxb_oName("VirtualFree"c, 11);              // #1678: hint+11+NUL = 14

    // ---- hint + Name je eigenem Extern ----
    var e2: int64 := 0;
    while (e2 < self.externCount) {
      var eb2: int64 := self.externBuf + e2 * WIN_EXTERN_SZ;
      self.wxb_oName(peek64(eb2) as pchar, peek64(eb2 + WIN_EXTERN_OFF_NAMELEN));
      e2 := e2 + 1;
    }

    // ---- auf Dateigrenze auffuellen ----
    var geschrieben: int64 := self.outLen - startLen;
    var rawSize: int64 := (self.rdSize + WIN_FILE_ALIGN - 1) & ~(WIN_FILE_ALIGN - 1);
    self.wxb_oZeros(rawSize - geschrieben);
  }

  // #1671: hint(2) + Name + NUL, wie es die Import-Tabelle verlangt.
  fn wxb_oName(nm: pchar, nlen: int64) {
    self.wxb_oe16(0);
    var i: int64 := 0;
    while (i < nlen) { self.wxb_oe8(StrCharAt(nm, i) & 255); i := i + 1; }
    self.wxb_oe8(0);
  }


  // ------------------------------------------------------------------
  // Write DOS header (64 bytes)
  // ------------------------------------------------------------------

  fn wxb_writeDosHeader(peOffset: int64) {
    self.wxb_oe16(0x5A4D);  // e_magic "MZ"
    self.wxb_oe16(0x0090);  // e_cblp
    self.wxb_oe16(0x0003);  // e_cp
    self.wxb_oe16(0x0000);  // e_crlc
    self.wxb_oe16(0x0004);  // e_cparhdr
    self.wxb_oe16(0x0000);  // e_minalloc
    self.wxb_oe16(0xFFFF);  // e_maxalloc
    self.wxb_oe16(0x0000);  // e_ss
    self.wxb_oe16(0x00B8);  // e_sp
    self.wxb_oe16(0x0000);  // e_csum
    self.wxb_oe16(0x0000);  // e_ip
    self.wxb_oe16(0x0000);  // e_cs
    self.wxb_oe16(0x0040);  // e_lfarlc
    self.wxb_oe16(0x0000);  // e_ovno
    // e_res (4 words)
    self.wxb_oe16(0); self.wxb_oe16(0); self.wxb_oe16(0); self.wxb_oe16(0);
    self.wxb_oe16(0x0000);  // e_oemid
    self.wxb_oe16(0x0000);  // e_oeminfo
    // e_res2 (10 words)
    var i: int64 := 0;
    while (i < 10) { self.wxb_oe16(0); i := i + 1; }
    self.wxb_oe32(peOffset);  // e_lfanew
  }

  // ------------------------------------------------------------------
  // Write DOS stub (64 bytes): "This program cannot be run in DOS mode."
  // ------------------------------------------------------------------

  fn wxb_writeDosStub() {
    // push cs; pop ds; mov dx,0x000e; mov ah,9; int 0x21; mov ax,0x4c01; int 0x21
    self.wxb_oe8(0x0E); self.wxb_oe8(0x1F); self.wxb_oe8(0xBA); self.wxb_oe8(0x0E);
    self.wxb_oe8(0x00); self.wxb_oe8(0xB4); self.wxb_oe8(0x09); self.wxb_oe8(0xCD);
    self.wxb_oe8(0x21); self.wxb_oe8(0xB8); self.wxb_oe8(0x01); self.wxb_oe8(0x4C);
    self.wxb_oe8(0xCD); self.wxb_oe8(0x21);
    // "This program cannot be run in DOS mode.\r\n$"
    self.wxb_oe8(84);  self.wxb_oe8(104); self.wxb_oe8(105); self.wxb_oe8(115);
    self.wxb_oe8(32);  self.wxb_oe8(112); self.wxb_oe8(114); self.wxb_oe8(111);
    self.wxb_oe8(103); self.wxb_oe8(114); self.wxb_oe8(97);  self.wxb_oe8(109);
    self.wxb_oe8(32);  self.wxb_oe8(99);  self.wxb_oe8(97);  self.wxb_oe8(110);
    self.wxb_oe8(110); self.wxb_oe8(111); self.wxb_oe8(116); self.wxb_oe8(32);
    self.wxb_oe8(98);  self.wxb_oe8(101); self.wxb_oe8(32);  self.wxb_oe8(114);
    self.wxb_oe8(117); self.wxb_oe8(110); self.wxb_oe8(32);  self.wxb_oe8(105);
    self.wxb_oe8(110); self.wxb_oe8(32);  self.wxb_oe8(68);  self.wxb_oe8(79);
    self.wxb_oe8(83);  self.wxb_oe8(32);  self.wxb_oe8(109); self.wxb_oe8(111);
    self.wxb_oe8(100); self.wxb_oe8(101); self.wxb_oe8(46);  self.wxb_oe8(13);
    self.wxb_oe8(10);  self.wxb_oe8(36);
    // pad to 64 bytes: used 14+42=56, need 8 more
    self.wxb_oe8(0); self.wxb_oe8(0); self.wxb_oe8(0); self.wxb_oe8(0);
    self.wxb_oe8(0); self.wxb_oe8(0); self.wxb_oe8(0); self.wxb_oe8(0);
  }

  // ------------------------------------------------------------------
  // #1671: Import-Tabelle aus den `extern fn ... link "x.dll"` bauen.
  //
  // Die fuenf Funktionen der Laufzeit (WriteFile, ExitProcess, VirtualAlloc,
  // GetCommandLineA, GetStdHandle) bleiben die ersten fuenf Eintraege der
  // ersten DLL — der Startcode greift ueber feste Slot-Nummern darauf zu.
  // Danach folgen die eigenen Deklarationen: die aus kernel32 in derselben
  // Gruppe, alle anderen als weitere Import-Deskriptoren.
  //
  // Aufbau von .rdata:
  //   IDT      (nDll+1) * 20
  //   je DLL:  INT (k+1)*8, dann IAT (k+1)*8
  //   Namen:   DLL-Namen, dann hint+Funktionsname je Eintrag
  // ------------------------------------------------------------------

  // Zwei Namen ohne Ruecksicht auf Gross-/Kleinschreibung vergleichen —
  // "KERNEL32.dll" und "kernel32.DLL" sind dieselbe Bibliothek.
  fn wxb_dllGleich(a: int64, aLen: int64, b: int64, bLen: int64): int64 {
    if (aLen != bLen) { return 0; }
    var i: int64 := 0;
    while (i < aLen) {
      var ca: int64 := peek8(a + i);
      var cb: int64 := peek8(b + i);
      if (ca >= 65 && ca <= 90) { ca := ca + 32; }
      if (cb >= 65 && cb <= 90) { cb := cb + 32; }
      if (ca != cb) { return 0; }
      i := i + 1;
    }
    return 1;
  }

  fn wxb_istKernel32(p: int64, len: int64): int64 {
    return self.wxb_dllGleich(p, len, "kernel32.dll"c as int64, 12);
  }

  // Laenge eines Extern-Eintrags in der Namensablage: hint(2) + Name + NUL.
  fn wxb_nameBlobLen(nlen: int64): int64 { return 2 + nlen + 1; }


  // Layout rechnen. Ergebnis in rdIatOff (IAT der ersten DLL), rdSize und
  // rdExternSlot (je Extern der Offset seiner IAT-Zelle in .rdata).
  //
  // Gerechnet wird VOR dem Schreiben, weil sowohl der Startcode (patchIAT) als
  // auch die Aufrufstellen der eigenen Externs die endgueltigen Offsets
  // brauchen. Eine zweite, aehnliche Rechnung an der Schreibstelle waere
  // genau die Sorte Doppelung, die in dieser Codebasis schon mehrfach
  // auseinandergelaufen ist.
  fn wxb_planImports() {
    if (self.rdExternSlot == 0 && self.externCount > 0) {
      self.rdExternSlot := alloc(self.externCount * 8);
    }
    // DLL-Liste aufbauen: Index 0 ist immer kernel32 (die Laufzeit braucht es).
    var dllPtr: int64 := alloc(64 * 8);
    var dllLen: int64 := alloc(64 * 8);
    var dllCnt: int64 := alloc(64 * 8);      // Zahl der Funktionen je DLL
    poke64(dllPtr, "kernel32.dll"c as int64);
    poke64(dllLen, 12);
    poke64(dllCnt, 7);                        // die sieben der Laufzeit (#1677, #1678)
    var nDll: int64 := 1;

    var e: int64 := 0;
    while (e < self.externCount) {
      var eb: int64 := self.externBuf + e * WIN_EXTERN_SZ;
      var lp: int64 := peek64(eb + WIN_EXTERN_OFF_LIBPTR);
      var ll: int64 := peek64(eb + WIN_EXTERN_OFF_LIBLEN);
      if (lp == 0 || ll <= 0) { lp := "kernel32.dll"c as int64; ll := 12; }
      var d: int64 := 0;
      var gefunden: int64 := 0 - 1;
      while (d < nDll) {
        if (self.wxb_dllGleich(peek64(dllPtr + d * 8), peek64(dllLen + d * 8), lp, ll) != 0) {
          gefunden := d; d := nDll;
        } else { d := d + 1; }
      }
      if (gefunden < 0 && nDll < 64) {
        poke64(dllPtr + nDll * 8, lp);
        poke64(dllLen + nDll * 8, ll);
        poke64(dllCnt + nDll * 8, 0);
        gefunden := nDll;
        nDll := nDll + 1;
      }
      if (gefunden >= 0) {
        poke64(dllCnt + gefunden * 8, peek64(dllCnt + gefunden * 8) + 1);
      }
      e := e + 1;
    }

    // Offsets: IDT, dann je DLL INT und IAT.
    var off: int64 := (nDll + 1) * 20;
    var intOff: int64 := alloc(64 * 8);
    var iatOff: int64 := alloc(64 * 8);
    var d2: int64 := 0;
    while (d2 < nDll) {
      var k: int64 := peek64(dllCnt + d2 * 8);
      poke64(intOff + d2 * 8, off);   off := off + (k + 1) * 8;
      poke64(iatOff + d2 * 8, off);   off := off + (k + 1) * 8;
      d2 := d2 + 1;
    }
    self.rdIatOff := peek64(iatOff);        // die Laufzeit sitzt in DLL 0

    // Die IAT-Zelle je Extern merken. Gezaehlt wird in derselben Reihenfolge
    // wie oben, damit Zelle und Namenseintrag zusammenpassen.
    var used: int64 := alloc(64 * 8);
    var u: int64 := 0;
    while (u < nDll) { poke64(used + u * 8, 0); u := u + 1; }
    poke64(used, 7);                         // DLL 0: sieben sind vergeben (#1677, #1678)
    e := 0;
    while (e < self.externCount) {
      var eb2: int64 := self.externBuf + e * WIN_EXTERN_SZ;
      var lp2: int64 := peek64(eb2 + WIN_EXTERN_OFF_LIBPTR);
      var ll2: int64 := peek64(eb2 + WIN_EXTERN_OFF_LIBLEN);
      if (lp2 == 0 || ll2 <= 0) { lp2 := "kernel32.dll"c as int64; ll2 := 12; }
      var d3: int64 := 0;
      while (d3 < nDll) {
        if (self.wxb_dllGleich(peek64(dllPtr + d3 * 8), peek64(dllLen + d3 * 8), lp2, ll2) != 0) {
          var slot: int64 := peek64(used + d3 * 8);
          poke64(self.rdExternSlot + e * 8, peek64(iatOff + d3 * 8) + slot * 8);
          poke64(used + d3 * 8, slot + 1);
          d3 := nDll;
        } else { d3 := d3 + 1; }
      }
      e := e + 1;
    }

    // Namensablage: DLL-Namen, dann hint+Name je Funktion.
    var namesOff: int64 := off;
    var d4: int64 := 0;
    while (d4 < nDll) { off := off + peek64(dllLen + d4 * 8) + 1; d4 := d4 + 1; }
    off := off + 12 + 14 + 15 + 18 + 15 + 25 + 14;  // die sieben Namen der Laufzeit (#1677, #1678)
    // #1676: Den Offset seines Namensblocks bekommt JEDER Extern hier fest
    // zugewiesen. Zuvor rechnete ihn jede Schreibstelle fuer sich nach — INT,
    // IAT und die Namensablage also dreimal —, und die Rechnungen liefen
    // auseinander: die zweite DLL-Gruppe trug den Namen der ersten, ihre IAT
    // einen dritten Wert, und sie lief ueber ihren Platz hinaus. Dieselbe
    // Sorte Fehler wie #1655 und #1663, nur eine Ebene tiefer.
    if (self.rdExternName == 0 && self.externCount > 0) {
      self.rdExternName := alloc(self.externCount * 8);
    }
    e := 0;
    while (e < self.externCount) {
      poke64(self.rdExternName + e * 8, off);
      off := off + self.wxb_nameBlobLen(peek64(self.externBuf + e * WIN_EXTERN_SZ + WIN_EXTERN_OFF_NAMELEN));
      e := e + 1;
    }
    self.rdSize := off;

    // Fuer die Schreibstelle aufheben.
    self.impDllPtr := dllPtr; self.impDllLen := dllLen; self.impDllCnt := dllCnt;
    self.impIntOff := intOff; self.impIatOff := iatOff; self.impNamesOff := namesOff;
    self.impDllCount := nDll;
  }

  // ------------------------------------------------------------------
  // Write PE64 binary to disk.
  // ------------------------------------------------------------------

  fn wxb_writePE64(path: pchar) {
    var codeLen: int64 := self.codeLen;
    var textRawSize: int64 := (codeLen + WIN_FILE_ALIGN - 1) & ~(WIN_FILE_ALIGN - 1);
    var rdataRVA: int64 := (WIN_TEXT_RVA + codeLen + WIN_SEC_ALIGN - 1) & ~(WIN_SEC_ALIGN - 1);
    var rdataFileOff: int64 := WIN_FILE_ALIGN + textRawSize;  // 512 header + text
    // #1671: .rdata war ebenfalls auf eine Seite festgelegt. Mit eigenen
    // Importen passt das nicht mehr — gerechnet wird aus dem Plan.
    var rdataVSize: int64 := self.rdSize;
    var rdataRawSize: int64 := (rdataVSize + WIN_FILE_ALIGN - 1) & ~(WIN_FILE_ALIGN - 1);
    var rdataVSpan: int64 := (rdataVSize + WIN_SEC_ALIGN - 1) & ~(WIN_SEC_ALIGN - 1);
    var relocRVA: int64 := rdataRVA + rdataVSpan;
    var relocFileOff: int64 := rdataFileOff + rdataRawSize;
    var entryRVA: int64 := WIN_TEXT_RVA + WIN_ENTRY_OFF;
    // WP-A2.2: .reloc virtual size = real block content if any, else the empty block.
    var relocVSize: int64 := 8;
    if (self.relocContentLen > 0) { relocVSize := self.relocContentLen; }

    // #1672: Fuer .reloc war fest EINE Seite eingeplant — im Image wie in der
    // Datei. Ab etwa 340 Relokationen (0x1000 Byte) ragte die Tabelle aus dem
    // Bereich heraus, den SizeOfImage beschreibt, und Windows wies die Datei
    // als "Fehlerhaftes EXE-Format" ab: das Programm startete gar nicht.
    // Dieselbe feste Annahme steckte in SizeOfRawData (512) und in der
    // Auffuellung am Dateiende — dort ergab `WIN_FILE_ALIGN - relocContentLen`
    // bei mehr als 512 Byte sogar eine negative Zahl.
    //
    // Gerechnet wird jetzt aus dem tatsaechlichen Inhalt: im Image auf
    // Sektionsgrenze, in der Datei auf Dateigrenze.
    var relocVSpan: int64 := (relocVSize + WIN_SEC_ALIGN - 1) & ~(WIN_SEC_ALIGN - 1);
    var relocRawSize: int64 := (relocVSize + WIN_FILE_ALIGN - 1) & ~(WIN_FILE_ALIGN - 1);
    var imageSize: int64 := relocRVA + relocVSpan;

    // ---- DOS Header (64 bytes) + DOS Stub (64 bytes) ----
    self.wxb_writeDosHeader(128);  // PE signature at file offset 128
    self.wxb_writeDosStub();

    // ---- PE Signature "PE\0\0" ----
    self.wxb_oe8(80); self.wxb_oe8(69); self.wxb_oe8(0); self.wxb_oe8(0);

    // ---- COFF Header (20 bytes) ----
    self.wxb_oe16(0x8664);    // Machine = AMD64
    self.wxb_oe16(3);         // NumberOfSections
    self.wxb_oe32(0);         // TimeDateStamp
    self.wxb_oe32(0);         // PointerToSymbolTable
    self.wxb_oe32(0);         // NumberOfSymbols
    self.wxb_oe16(240);       // SizeOfOptionalHeader
    self.wxb_oe16(0x0022);    // IMAGE_FILE_EXECUTABLE_IMAGE | IMAGE_FILE_LARGE_ADDRESS_AWARE

    // ---- Optional Header PE32+ (240 bytes) ----
    self.wxb_oe16(0x020B);    // Magic = PE32+
    self.wxb_oe8(1);          // MajorLinkerVersion
    self.wxb_oe8(0);          // MinorLinkerVersion
    self.wxb_oe32(textRawSize);  // SizeOfCode
    self.wxb_oe32(WIN_FILE_ALIGN);  // SizeOfInitializedData (rdata raw)
    self.wxb_oe32(0);         // SizeOfUninitializedData
    self.wxb_oe32(entryRVA);  // AddressOfEntryPoint
    self.wxb_oe32(WIN_TEXT_RVA);  // BaseOfCode
    self.wxb_oe64(WIN_IMAGE_BASE); // ImageBase
    self.wxb_oe32(WIN_SEC_ALIGN);  // SectionAlignment = 4096
    self.wxb_oe32(WIN_FILE_ALIGN); // FileAlignment = 512
    self.wxb_oe16(6);  self.wxb_oe16(2);   // OS Version 6.2
    self.wxb_oe16(0);  self.wxb_oe16(0);   // Image Version
    self.wxb_oe16(6);  self.wxb_oe16(2);   // Subsystem Version 6.2
    self.wxb_oe32(0);         // Win32VersionValue
    self.wxb_oe32(imageSize); // SizeOfImage
    self.wxb_oe32(WIN_FILE_ALIGN);  // SizeOfHeaders = 512
    self.wxb_oe32(0);         // CheckSum
    self.wxb_oe16(3);         // Subsystem = IMAGE_SUBSYSTEM_WINDOWS_CUI
    self.wxb_oe16(0x8160);    // DllCharacteristics = HIGH_ENTROPY_VA|DYNAMIC_BASE|NX_COMPAT|TERMINAL_SERVER_AWARE
    self.wxb_oe64(0x100000);  // SizeOfStackReserve = 1 MB
    self.wxb_oe64(0x1000);    // SizeOfStackCommit = 4 KB
    self.wxb_oe64(0x100000);  // SizeOfHeapReserve = 1 MB
    self.wxb_oe64(0x1000);    // SizeOfHeapCommit = 4 KB
    self.wxb_oe32(0);         // LoaderFlags
    self.wxb_oe32(16);        // NumberOfRvaAndSizes

    // Data Directories (16 entries × 8 bytes = 128 bytes)
    self.wxb_oe32(0); self.wxb_oe32(0);  // [0] Export
    self.wxb_oe32(rdataRVA); self.wxb_oe32((self.impDllCount + 1) * 20);  // [1] Import (IDT), #1671
    self.wxb_oe32(0); self.wxb_oe32(0);  // [2] Resource
    self.wxb_oe32(0); self.wxb_oe32(0);  // [3] Exception
    self.wxb_oe32(0); self.wxb_oe32(0);  // [4] Security
    self.wxb_oe32(relocRVA); self.wxb_oe32(relocVSize);  // [5] BaseReloc
    self.wxb_oe32(0); self.wxb_oe32(0);  // [6] Debug
    self.wxb_oe32(0); self.wxb_oe32(0);  // [7] Architecture
    self.wxb_oe32(0); self.wxb_oe32(0);  // [8] GlobalPtr
    self.wxb_oe32(0); self.wxb_oe32(0);  // [9] TLS
    self.wxb_oe32(0); self.wxb_oe32(0);  // [10] LoadConfig
    self.wxb_oe32(0); self.wxb_oe32(0);  // [11] BoundImport
    self.wxb_oe32(rdataRVA + self.rdIatOff); self.wxb_oe32((6 + self.externCount + 1) * 8);  // [12] IAT, #1671/#1677
    self.wxb_oe32(0); self.wxb_oe32(0);  // [13] DelayImport
    self.wxb_oe32(0); self.wxb_oe32(0);  // [14] CLR
    self.wxb_oe32(0); self.wxb_oe32(0);  // [15] Reserved

    // ---- Section Header .text (40 bytes) ----
    self.wxb_oName8(".text"c, 5);
    self.wxb_oe32(codeLen);         // VirtualSize
    self.wxb_oe32(WIN_TEXT_RVA);    // VirtualAddress
    self.wxb_oe32(textRawSize);     // SizeOfRawData
    self.wxb_oe32(WIN_FILE_ALIGN);  // PointerToRawData = 512
    self.wxb_oe32(0);               // PointerToRelocations
    self.wxb_oe32(0);               // PointerToLinenumbers
    self.wxb_oe16(0);               // NumberOfRelocations
    self.wxb_oe16(0);               // NumberOfLinenumbers
    // WP-WINARGV: CODE|EXECUTE|READ|WRITE. Daten/Globals werden ans .text-Ende angehängt
    // (single-section-Design); ohne WRITE faulten ALLE globalen Schreibzugriffe (g:=x, argc/argv).
    // W^X-Tradeoff für das win64-Beta-Backend; saubere Lösung = separate .data-Section (größerer Umbau).
    self.wxb_oe32(0xE0000020);      // Characteristics: CODE|MEM_EXECUTE|MEM_READ|MEM_WRITE

    // ---- Section Header .rdata (40 bytes) ----
    self.wxb_oName8(".rdata"c, 6);
    self.wxb_oe32(rdataVSize);      // #1671: nach Inhalt
    self.wxb_oe32(rdataRVA);        // VirtualAddress
    self.wxb_oe32(rdataRawSize);    // #1671: nach Inhalt
    self.wxb_oe32(rdataFileOff);    // PointerToRawData
    self.wxb_oe32(0);               // PointerToRelocations
    self.wxb_oe32(0);               // PointerToLinenumbers
    self.wxb_oe16(0);               // NumberOfRelocations
    self.wxb_oe16(0);               // NumberOfLinenumbers
    self.wxb_oe32(0xC0000040);      // Characteristics: INITIALIZED_DATA|MEM_READ|MEM_WRITE

    // ---- Section Header .reloc (40 bytes) — 3×40=120; total headers=512, no pad needed ----
    self.wxb_oName8(".reloc"c, 6);
    self.wxb_oe32(relocVSize);      // VirtualSize (real blocks if any, else empty block)
    self.wxb_oe32(relocRVA);        // VirtualAddress
    self.wxb_oe32(relocRawSize);    // #1672: nach Inhalt, nicht fest 512
    self.wxb_oe32(relocFileOff);    // PointerToRawData
    self.wxb_oe32(0);               // PointerToRelocations
    self.wxb_oe32(0);               // PointerToLinenumbers
    self.wxb_oe16(0);               // NumberOfRelocations
    self.wxb_oe16(0);               // NumberOfLinenumbers
    self.wxb_oe32(0x42000040);      // INITIALIZED_DATA|MEM_READ|MEM_DISCARDABLE

    // ---- Pad header to FILE_ALIGNMENT (512); with 3 sections outLen=512 → oZeros(0) ----
    self.wxb_oZeros(WIN_FILE_ALIGN - self.outLen);

    // ---- .text section ----
    var i: int64 := 0;
    while (i < codeLen) {
      self.wxb_oe8(peek8(self.code + i));
      i := i + 1;
    }
    self.wxb_oZeros(textRawSize - codeLen);

    // ---- .rdata section ----
    self.wxb_writeRdata(rdataRVA);

    // ---- .reloc section ----
    if (self.relocContentLen > 0) {
      // WP-A2.2: emit the real IMAGE_BASE_RELOCATION blocks, then pad to FILE_ALIGN.
      var r: int64 := 0;
      while (r < self.relocContentLen) {
        self.wxb_oe8(peek8(self.relocContent + r));
        r := r + 1;
      }
      self.wxb_oZeros(relocRawSize - self.relocContentLen);   // #1672
    } else {
      // No absolute pointers: one empty block (page 0, header only) → ASLR-safe.
      self.wxb_oe32(0);
      self.wxb_oe32(8);
      self.wxb_oZeros(relocRawSize - 8);                      // #1672
    }

    // ---- Write to file (O_WRONLY|O_CREAT|O_TRUNC=577, mode 0755=493) ----
    EmitWriteFile(path, self.out, self.outLen);   // #1682
  }

  // ------------------------------------------------------------------
  // Public API
  // ------------------------------------------------------------------

  pub fn Build(cgBuf: int64, cgLen: int64, cgData: int64, cgDataLen: int64) {
    self.wxb_buildCode(cgBuf, cgLen, cgData, cgDataLen);
  }

  pub fn WritePE64(path: pchar) {
    self.wxb_writePE64(path);
  }

  pub fn GetCodeSize(): int64 { return self.codeLen; }

  pub fn Init() {
    self.codeCap := 65536;
    self.code    := alloc(self.codeCap);
    self.codeLen := 0;
    self.outCap  := 65536;
    self.out     := alloc(self.outCap);
    self.outLen  := 0;
    self.baseRelocBuf    := 0;
    self.baseRelocCount  := 0;
    self.peRVAs          := 0;
    self.relocContent    := 0;
    self.relocContentLen := 0;
    self.vallocCallOff   := 0 - 1;
    self.vfreeCallOff    := 0 - 1;
    self.argcStoreOff    := 0 - 1;
    self.argvStoreOff    := 0 - 1;
    self.envStoreOff     := 0 - 1;   // #1677
    self.envCallOff      := 0 - 1;
    self.envStoreOff     := 0 - 1;   // #1677
    self.envCallOff      := 0 - 1;
    self.externBuf       := 0;      // #1671
    self.externCount     := 0;
    self.patchBuf        := 0;
    self.patchCount      := 0;
    self.rdIatOff        := WIN_RDATA_IAT_OFF;
    self.rdSize          := WIN_RDATA_SIZE;
    self.rdExternSlot    := 0;
    self.rdExternName    := 0;   // #1676
  }

  // #1671: Externs und Patch-Tabelle des Codegens VOR Build() uebergeben.
  pub fn SetExterns(buf: int64, count: int64, pbuf: int64, pcount: int64) {
    self.externBuf   := buf;
    self.externCount := count;
    self.patchBuf    := pbuf;
    self.patchCount  := pcount;
  }

  // WP-A2.2: hand over the codegen base-reloc table BEFORE Build().
  pub fn SetBaseRelocs(buf: int64, count: int64) {
    self.baseRelocBuf   := buf;
    self.baseRelocCount := count;
    if (count > 0) {
      self.peRVAs       := alloc(count * 8);
      self.relocContent := alloc(WIN_FILE_ALIGN);
    }
  }

};
