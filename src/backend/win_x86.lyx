    while (i < n) { self.wxb_ce8(0x90); i := i + 1; }
  }

  // ------------------------------------------------------------------
  // Patch IAT rel32 fields after codeLen is known (so rdataRVA can be computed).
  // Called from wxb_buildCode after all code is assembled.
  // ------------------------------------------------------------------

  fn wxb_patchIAT() {
    var codeLen: int64 := self.codeLen;
    // .rdata starts at next page boundary after .text
    var rdataRVA: int64 := (WIN_TEXT_RVA + codeLen + WIN_SEC_ALIGN - 1) & ~(WIN_SEC_ALIGN - 1);

    // IAT slot RVAs (IAT_OFF=88; each slot is 8 bytes)
    var wfRVA:  int64 := rdataRVA + WIN_RDATA_IAT_OFF + 0;   // WriteFile
    var epRVA:  int64 := rdataRVA + WIN_RDATA_IAT_OFF + 8;   // ExitProcess
    var vaRVA:  int64 := rdataRVA + WIN_RDATA_IAT_OFF + 16;  // VirtualAlloc
    var gclRVA: int64 := rdataRVA + WIN_RDATA_IAT_OFF + 24;  // GetCommandLineA
    var ghRVA:  int64 := rdataRVA + WIN_RDATA_IAT_OFF + 32;  // GetStdHandle

    // Each call [X_IAT] at code offset K: rel32 = X_RVA - (TEXT_RVA + K + 6)
    // rel32 field is at code[K+2]
    var textBase: int64 := WIN_TEXT_RVA;

    // win_print_str_impl GetStdHandle call at code[30], instruction end at 36
    var r7: int64 := ghRVA - (textBase + WIN_CALL_GH1 + 6);
    self.wxb_patch32(WIN_CALL_GH1 + 2, r7);

    // win_print_str_impl WriteFile call at code[53], instruction end at 59
    var r1: int64 := wfRVA - (textBase + WIN_CALL_WF1 + 6);
    self.wxb_patch32(WIN_CALL_WF1 + 2, r1);

    // win_print_int_impl GetStdHandle call at code[170], instruction end at 176
    var r8: int64 := ghRVA - (textBase + WIN_CALL_GH2 + 6);
    self.wxb_patch32(WIN_CALL_GH2 + 2, r8);

    // win_print_int_impl WriteFile call at code[193], instruction end at 199
    var r2: int64 := wfRVA - (textBase + WIN_CALL_WF2 + 6);
    self.wxb_patch32(WIN_CALL_WF2 + 2, r2);

    // win_strsub_impl VirtualAlloc call at code[237], instruction end at 243
    var r3: int64 := vaRVA - (textBase + WIN_CALL_VA + 6);
    self.wxb_patch32(WIN_CALL_VA + 2, r3);

    // win_argv_setup GetCommandLineA call at code[284], instruction end at 290
    var r5: int64 := gclRVA - (textBase + WIN_CALL_GCL + 6);
    self.wxb_patch32(WIN_CALL_GCL + 2, r5);

    // win_argv_setup VirtualAlloc call at code[370], instruction end at 376
    var r6: int64 := vaRVA - (textBase + WIN_CALL_VA2 + 6);
    self.wxb_patch32(WIN_CALL_VA2 + 2, r6);

    // _start ExitProcess call at code[561], instruction end at 567
    var r4: int64 := epRVA - (textBase + WIN_CALL_EP + 6);
    self.wxb_patch32(WIN_CALL_EP + 2, r4);
  }

  // ------------------------------------------------------------------
  // Build the Windows code buffer from a Linux cgBuf.
  // Layout: preamble (506) + trampoline zone (287) + user code (cgLen-287) + data.
  // The data buffer is appended directly after the code so that RIP-relative
  // disp32 values computed by cg_patchAll() remain valid in the PE .text section.
  // ------------------------------------------------------------------

  fn wxb_buildCode(cgBuf: int64, cgLen: int64, cgData: int64, cgDataLen: int64) {
    // WP-4.3: Extract call-main rel32 from Linux _start at cgBuf[63..66].
    // Linux _start layout (79 bytes): 63 bytes of setup + E8 rel32 call main.
    // Correction: win_relMain = linux_relMain + 14
    //   because Win user_off(1774) - Linux CG_H_USER(1266) = 508 = WIN_PREAMBLE_SZ,
    //   and Win _start call-next(561) - Linux _start call-next(67) = 494... wait:
    //   win_relMain = linux_relMain + (67 - 53) = linux_relMain + 14
    //   derivation: win_main = WIN_USER_OFF + (linux_main - CG_H_USER) = 1774 + linux_main - 1266
    //               linux_main = 67 + linux_relMain
    //               win_relMain = win_main - 561 = 1774 + 67 + linux_relMain - 1266 - 561 = linux_relMain + 14
    var b0: int64 := peek8(cgBuf + 63);
    var b1: int64 := peek8(cgBuf + 64);
    var b2: int64 := peek8(cgBuf + 65);
    var b3: int64 := peek8(cgBuf + 66);
    var linuxRelMain: int64 := b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    // Sign-extend from 32 to 64 bits
    if ((linuxRelMain & 0x80000000) != 0) {
      linuxRelMain := linuxRelMain | ((-1) & ~0xFFFFFFFF);
    }
    var relMain: int64 := linuxRelMain + 14;

    // Emit preamble (WIN_PREAMBLE_SZ = 508 bytes)
    self.wxb_emitPrintStr();     // 68 bytes, offsets 0..67
    self.wxb_emitPrintInt();     // 145 bytes, offsets 68..212 (was 143, comment was stale)
    self.wxb_emitStrSub();       // 58 bytes, offsets 213..270
    self.wxb_emitArgvSetup();    // 237 bytes, offsets 271..507

    // Emit trampoline zone (WIN_HELPERS_SZ = 1266 bytes = CG_H_USER)
    // Each trampoline is at the SAME offset as its Linux counterpart (relative to zone start)
    // so that user-code rel32 call values remain identical in both binaries.
    self.wxb_emitStart(relMain); // 79 bytes (65+14 NOPs), zone offsets  0.. 78 (CG_H_START..CG_H_STRLEN-1)
    self.wxb_emitStrlen();       // 15 bytes,                zone offsets 79.. 93 (CG_H_STRLEN..CG_H_PRINTSTR-1)
    self.wxb_emitPrintStrJmp();  // 26 bytes,                zone offsets 94..119 (CG_H_PRINTSTR..CG_H_PRINTINT-1)
    self.wxb_emitPrintIntJmp();  // 104 bytes,               zone offsets 120..223 (CG_H_PRINTINT..CG_H_STRSUB-1)
    self.wxb_emitStrSubJmp();    // 71 bytes,                zone offsets 224..294 (CG_H_STRSUB..CG_H_STRCHARAT-1)
    self.wxb_emitStrCharAt();    // 6 bytes,                 zone offsets 295..300 (CG_H_STRCHARAT..CG_H_EPRINTSTR-1)
    self.wxb_emitEPrintStrJmp(); // 26 bytes,                zone offsets 301..326 (CG_H_EPRINTSTR..CG_H_EPRINTINT-1)
    self.wxb_emitEPrintIntJmp(); // 104 bytes,               zone offsets 327..430 (CG_H_EPRINTINT..CG_H_F64STR-1)
    self.wxb_emitStub(335);      // 335 NOP bytes,           zone offsets 431..765 (CG_H_F64STR..CG_H_STRSPLIT-1)
    self.wxb_emitStub(215);      // 215 NOP bytes,           zone offsets 766..980 (CG_H_STRSPLIT..CG_H_MAP_NEW-1)
    self.wxb_emitStub(47);       //  47 NOP bytes,           zone offsets 981..1027 (CG_H_MAP_NEW..CG_H_MAP_SET-1)
    self.wxb_emitStub(93);       //  93 NOP bytes,           zone offsets 1028..1120 (CG_H_MAP_SET..CG_H_MAP_GET-1)
    self.wxb_emitStub(72);       //  72 NOP bytes,           zone offsets 1121..1192 (CG_H_MAP_GET..CG_H_MAP_HAS-1)
    self.wxb_emitStub(73);       //  73 NOP bytes,           zone offsets 1193..1265 (CG_H_MAP_HAS..CG_H_USER-1)
    // Total trampoline zone: 79+15+26+104+71+6+26+104+335+215+47+93+72+73 = 1266 = CG_H_USER ✓

    // Copy user code verbatim (all rel32 values remain correct because:
    //   user code is shifted by WIN_USER_OFF=1774 in Windows vs CG_H_USER=1266 in Linux,
    //   helpers are shifted by WIN_PREAMBLE_SZ=508 in Windows vs 0 in Linux,
    //   difference = 1774-1266 = 508 = WIN_PREAMBLE_SZ in both cases → offsets cancel ✓)
    var i: int64 := WIN_HELPERS_SZ;
    while (i < cgLen) {
      self.wxb_ce8(peek8(cgBuf + i));
      i := i + 1;
    }

    // Append data buffer so that RIP-relative LEA disp32 values are correct.
    // cg_patchAll computed disp32 = codeLen - codeOff - 4 + dataOff, which
    // assumes data follows code at exactly offset WIN_PREAMBLE_SZ + cgLen.
    var j: int64 := 0;
    while (j < cgDataLen) {
      self.wxb_ce8(peek8(cgData + j));
      j := j + 1;
    }

    // Patch IAT indirect call rel32 fields now that codeLen is final
    self.wxb_patchIAT();
  }

  // ------------------------------------------------------------------
  // Write .rdata section content to out buffer.
  // Must be called after wxb_buildCode so rdataRVA is deterministic.
  // ------------------------------------------------------------------

  fn wxb_writeRdata(rdataRVA: int64) {
    // --- IDT Entry 0: kernel32.dll ---
    self.wxb_oe32(rdataRVA + WIN_RDATA_INT_OFF);   // OriginalFirstThunk = INT RVA
    self.wxb_oe32(0);                               // TimeDateStamp
    self.wxb_oe32(0xFFFFFFFF);                      // ForwarderChain
    self.wxb_oe32(rdataRVA + WIN_RDATA_DLL_OFF);   // Name RVA
    self.wxb_oe32(rdataRVA + WIN_RDATA_IAT_OFF);   // FirstThunk = IAT RVA
    // --- IDT Entry 1: null terminator ---
    self.wxb_oe32(0); self.wxb_oe32(0); self.wxb_oe32(0); self.wxb_oe32(0); self.wxb_oe32(0);
    // --- INT (Import Name Table): 5 entries + null ---
    self.wxb_oe64(rdataRVA + WIN_RDATA_WF_NAME);   // WriteFile
    self.wxb_oe64(rdataRVA + WIN_RDATA_EP_NAME);   // ExitProcess
    self.wxb_oe64(rdataRVA + WIN_RDATA_VA_NAME);   // VirtualAlloc
    self.wxb_oe64(rdataRVA + WIN_RDATA_GCL_NAME);  // GetCommandLineA
    self.wxb_oe64(rdataRVA + WIN_RDATA_GH_NAME);   // GetStdHandle
    self.wxb_oe64(0);                               // null terminator
    // --- IAT (Import Address Table): same as INT initially ---
    self.wxb_oe64(rdataRVA + WIN_RDATA_WF_NAME);
    self.wxb_oe64(rdataRVA + WIN_RDATA_EP_NAME);
    self.wxb_oe64(rdataRVA + WIN_RDATA_VA_NAME);
    self.wxb_oe64(rdataRVA + WIN_RDATA_GCL_NAME);
    self.wxb_oe64(rdataRVA + WIN_RDATA_GH_NAME);
    self.wxb_oe64(0);
    // --- DLL name: "KERNEL32.dll\0" (13 bytes) ---
    self.wxb_oe8(75);  // K
    self.wxb_oe8(69);  // E
    self.wxb_oe8(82);  // R
    self.wxb_oe8(78);  // N
    self.wxb_oe8(69);  // E
    self.wxb_oe8(76);  // L
    self.wxb_oe8(51);  // 3
    self.wxb_oe8(50);  // 2
    self.wxb_oe8(46);  // .
    self.wxb_oe8(100); // d
    self.wxb_oe8(108); // l
    self.wxb_oe8(108); // l
    self.wxb_oe8(0);   // NUL
    // --- hint + "WriteFile\0" (12 bytes) ---
    self.wxb_oe16(0);   // hint
    self.wxb_oe8(87); self.wxb_oe8(114); self.wxb_oe8(105); self.wxb_oe8(116); // Writ
    self.wxb_oe8(101); self.wxb_oe8(70); self.wxb_oe8(105); self.wxb_oe8(108); // eFil
    self.wxb_oe8(101); self.wxb_oe8(0);  // e NUL
    // --- hint + "ExitProcess\0" (14 bytes) ---
    self.wxb_oe16(0);   // hint
    self.wxb_oe8(69);  self.wxb_oe8(120); self.wxb_oe8(105); self.wxb_oe8(116); // Exit
    self.wxb_oe8(80);  self.wxb_oe8(114); self.wxb_oe8(111); self.wxb_oe8(99);  // Proc
    self.wxb_oe8(101); self.wxb_oe8(115); self.wxb_oe8(115); self.wxb_oe8(0);   // ess NUL
    // --- hint + "VirtualAlloc\0" (15 bytes) ---
    self.wxb_oe16(0);   // hint
    self.wxb_oe8(86);  self.wxb_oe8(105); self.wxb_oe8(114); self.wxb_oe8(116); // Virt
    self.wxb_oe8(117); self.wxb_oe8(97);  self.wxb_oe8(108); self.wxb_oe8(65);  // ualA
    self.wxb_oe8(108); self.wxb_oe8(108); self.wxb_oe8(111); self.wxb_oe8(99);  // lloc
    self.wxb_oe8(0);    // NUL
    // --- hint + "GetCommandLineA\0" (18 bytes) ---
    self.wxb_oe16(0);   // hint
    self.wxb_oe8(71);  self.wxb_oe8(101); self.wxb_oe8(116); self.wxb_oe8(67);  // GetC
    self.wxb_oe8(111); self.wxb_oe8(109); self.wxb_oe8(109); self.wxb_oe8(97);  // omma
    self.wxb_oe8(110); self.wxb_oe8(100); self.wxb_oe8(76);  self.wxb_oe8(105); // ndLi
    self.wxb_oe8(110); self.wxb_oe8(101); self.wxb_oe8(65);  self.wxb_oe8(0);   // neA NUL
    // --- hint + "GetStdHandle\0" (15 bytes) ---
    self.wxb_oe16(0);   // hint
    self.wxb_oe8(71);  self.wxb_oe8(101); self.wxb_oe8(116); self.wxb_oe8(83);  // GetS
    self.wxb_oe8(116); self.wxb_oe8(100); self.wxb_oe8(72);  self.wxb_oe8(97);  // tdHa
    self.wxb_oe8(110); self.wxb_oe8(100); self.wxb_oe8(108); self.wxb_oe8(101); // ndle
    self.wxb_oe8(0);   // NUL
    // Total .rdata used: 223 bytes. Pad to FILE_ALIGNMENT = 512.
    self.wxb_oZeros(WIN_FILE_ALIGN - WIN_RDATA_SIZE);
  }

  // ------------------------------------------------------------------
  // Write DOS header (64 bytes)
  // ------------------------------------------------------------------

  fn wxb_writeDosHeader(peOffset: int64) {
    self.wxb_oe16(0x5A4D);  // e_magic "MZ"
    self.wxb_oe16(0x0090);  // e_cblp
    self.wxb_oe16(0x0003);  // e_cp
    self.wxb_oe16(0x0000);  // e_crlc
    self.wxb_oe16(0x0004);  // e_cparhdr
    self.wxb_oe16(0x0000);  // e_minalloc
    self.wxb_oe16(0xFFFF);  // e_maxalloc
    self.wxb_oe16(0x0000);  // e_ss
    self.wxb_oe16(0x00B8);  // e_sp
    self.wxb_oe16(0x0000);  // e_csum
    self.wxb_oe16(0x0000);  // e_ip
    self.wxb_oe16(0x0000);  // e_cs
    self.wxb_oe16(0x0040);  // e_lfarlc
    self.wxb_oe16(0x0000);  // e_ovno
    // e_res (4 words)
    self.wxb_oe16(0); self.wxb_oe16(0); self.wxb_oe16(0); self.wxb_oe16(0);
    self.wxb_oe16(0x0000);  // e_oemid
    self.wxb_oe16(0x0000);  // e_oeminfo
    // e_res2 (10 words)
    var i: int64 := 0;
    while (i < 10) { self.wxb_oe16(0); i := i + 1; }
    self.wxb_oe32(peOffset);  // e_lfanew
  }

  // ------------------------------------------------------------------
  // Write DOS stub (64 bytes): "This program cannot be run in DOS mode."
  // ------------------------------------------------------------------

  fn wxb_writeDosStub() {
    // push cs; pop ds; mov dx,0x000e; mov ah,9; int 0x21; mov ax,0x4c01; int 0x21
    self.wxb_oe8(0x0E); self.wxb_oe8(0x1F); self.wxb_oe8(0xBA); self.wxb_oe8(0x0E);
    self.wxb_oe8(0x00); self.wxb_oe8(0xB4); self.wxb_oe8(0x09); self.wxb_oe8(0xCD);
    self.wxb_oe8(0x21); self.wxb_oe8(0xB8); self.wxb_oe8(0x01); self.wxb_oe8(0x4C);
    self.wxb_oe8(0xCD); self.wxb_oe8(0x21);
    // "This program cannot be run in DOS mode.\r\n$"
    self.wxb_oe8(84);  self.wxb_oe8(104); self.wxb_oe8(105); self.wxb_oe8(115);
    self.wxb_oe8(32);  self.wxb_oe8(112); self.wxb_oe8(114); self.wxb_oe8(111);
    self.wxb_oe8(103); self.wxb_oe8(114); self.wxb_oe8(97);  self.wxb_oe8(109);
    self.wxb_oe8(32);  self.wxb_oe8(99);  self.wxb_oe8(97);  self.wxb_oe8(110);
    self.wxb_oe8(110); self.wxb_oe8(111); self.wxb_oe8(116); self.wxb_oe8(32);
    self.wxb_oe8(98);  self.wxb_oe8(101); self.wxb_oe8(32);  self.wxb_oe8(114);
    self.wxb_oe8(117); self.wxb_oe8(110); self.wxb_oe8(32);  self.wxb_oe8(105);
    self.wxb_oe8(110); self.wxb_oe8(32);  self.wxb_oe8(68);  self.wxb_oe8(79);
    self.wxb_oe8(83);  self.wxb_oe8(32);  self.wxb_oe8(109); self.wxb_oe8(111);
    self.wxb_oe8(100); self.wxb_oe8(101); self.wxb_oe8(46);  self.wxb_oe8(13);
    self.wxb_oe8(10);  self.wxb_oe8(36);
    // pad to 64 bytes: used 14+42=56, need 8 more
    self.wxb_oe8(0); self.wxb_oe8(0); self.wxb_oe8(0); self.wxb_oe8(0);
    self.wxb_oe8(0); self.wxb_oe8(0); self.wxb_oe8(0); self.wxb_oe8(0);
  }

  // ------------------------------------------------------------------
  // Write PE64 binary to disk.
  // ------------------------------------------------------------------

  fn wxb_writePE64(path: pchar) {
    var codeLen: int64 := self.codeLen;
    var textRawSize: int64 := (codeLen + WIN_FILE_ALIGN - 1) & ~(WIN_FILE_ALIGN - 1);
    var rdataRVA: int64 := (WIN_TEXT_RVA + codeLen + WIN_SEC_ALIGN - 1) & ~(WIN_SEC_ALIGN - 1);
    var rdataFileOff: int64 := WIN_FILE_ALIGN + textRawSize;  // 512 header + text
    var imageSize: int64 := rdataRVA + WIN_SEC_ALIGN;
    var entryRVA: int64 := WIN_TEXT_RVA + WIN_ENTRY_OFF;

    // ---- DOS Header (64 bytes) + DOS Stub (64 bytes) ----
    self.wxb_writeDosHeader(128);  // PE signature at file offset 128
    self.wxb_writeDosStub();

    // ---- PE Signature "PE\0\0" ----
    self.wxb_oe8(80); self.wxb_oe8(69); self.wxb_oe8(0); self.wxb_oe8(0);

    // ---- COFF Header (20 bytes) ----
    self.wxb_oe16(0x8664);    // Machine = AMD64
    self.wxb_oe16(2);         // NumberOfSections
    self.wxb_oe32(0);         // TimeDateStamp
    self.wxb_oe32(0);         // PointerToSymbolTable
    self.wxb_oe32(0);         // NumberOfSymbols
    self.wxb_oe16(240);       // SizeOfOptionalHeader
    self.wxb_oe16(0x0022);    // IMAGE_FILE_EXECUTABLE_IMAGE | IMAGE_FILE_LARGE_ADDRESS_AWARE

    // ---- Optional Header PE32+ (240 bytes) ----
    self.wxb_oe16(0x020B);    // Magic = PE32+
    self.wxb_oe8(1);          // MajorLinkerVersion
    self.wxb_oe8(0);          // MinorLinkerVersion
    self.wxb_oe32(textRawSize);  // SizeOfCode
    self.wxb_oe32(WIN_FILE_ALIGN);  // SizeOfInitializedData (rdata raw)
    self.wxb_oe32(0);         // SizeOfUninitializedData
    self.wxb_oe32(entryRVA);  // AddressOfEntryPoint
    self.wxb_oe32(WIN_TEXT_RVA);  // BaseOfCode
    self.wxb_oe64(WIN_IMAGE_BASE); // ImageBase
    self.wxb_oe32(WIN_SEC_ALIGN);  // SectionAlignment = 4096
    self.wxb_oe32(WIN_FILE_ALIGN); // FileAlignment = 512
    self.wxb_oe16(6);  self.wxb_oe16(2);   // OS Version 6.2
    self.wxb_oe16(0);  self.wxb_oe16(0);   // Image Version
    self.wxb_oe16(6);  self.wxb_oe16(2);   // Subsystem Version 6.2
    self.wxb_oe32(0);         // Win32VersionValue
    self.wxb_oe32(imageSize); // SizeOfImage
    self.wxb_oe32(WIN_FILE_ALIGN);  // SizeOfHeaders = 512
    self.wxb_oe32(0);         // CheckSum
    self.wxb_oe16(3);         // Subsystem = IMAGE_SUBSYSTEM_WINDOWS_CUI
    self.wxb_oe16(0x8160);    // DllCharacteristics = HIGH_ENTROPY_VA|DYNAMIC_BASE|NX_COMPAT|TERMINAL_SERVER_AWARE
    self.wxb_oe64(0x100000);  // SizeOfStackReserve = 1 MB
    self.wxb_oe64(0x1000);    // SizeOfStackCommit = 4 KB
    self.wxb_oe64(0x100000);  // SizeOfHeapReserve = 1 MB
    self.wxb_oe64(0x1000);    // SizeOfHeapCommit = 4 KB
    self.wxb_oe32(0);         // LoaderFlags
    self.wxb_oe32(16);        // NumberOfRvaAndSizes

    // Data Directories (16 entries × 8 bytes = 128 bytes)
    self.wxb_oe32(0); self.wxb_oe32(0);  // [0] Export
    self.wxb_oe32(rdataRVA); self.wxb_oe32(40);  // [1] Import (IDT)
    self.wxb_oe32(0); self.wxb_oe32(0);  // [2] Resource
    self.wxb_oe32(0); self.wxb_oe32(0);  // [3] Exception
    self.wxb_oe32(0); self.wxb_oe32(0);  // [4] Security
    self.wxb_oe32(0); self.wxb_oe32(0);  // [5] BaseReloc
    self.wxb_oe32(0); self.wxb_oe32(0);  // [6] Debug
    self.wxb_oe32(0); self.wxb_oe32(0);  // [7] Architecture
    self.wxb_oe32(0); self.wxb_oe32(0);  // [8] GlobalPtr
    self.wxb_oe32(0); self.wxb_oe32(0);  // [9] TLS
    self.wxb_oe32(0); self.wxb_oe32(0);  // [10] LoadConfig
    self.wxb_oe32(0); self.wxb_oe32(0);  // [11] BoundImport
    self.wxb_oe32(rdataRVA + WIN_RDATA_IAT_OFF); self.wxb_oe32(48);  // [12] IAT
    self.wxb_oe32(0); self.wxb_oe32(0);  // [13] DelayImport
    self.wxb_oe32(0); self.wxb_oe32(0);  // [14] CLR
    self.wxb_oe32(0); self.wxb_oe32(0);  // [15] Reserved

    // ---- Section Header .text (40 bytes) ----
    self.wxb_oName8(".text"c, 5);
    self.wxb_oe32(codeLen);         // VirtualSize
    self.wxb_oe32(WIN_TEXT_RVA);    // VirtualAddress
    self.wxb_oe32(textRawSize);     // SizeOfRawData
    self.wxb_oe32(WIN_FILE_ALIGN);  // PointerToRawData = 512
    self.wxb_oe32(0);               // PointerToRelocations
    self.wxb_oe32(0);               // PointerToLinenumbers
    self.wxb_oe16(0);               // NumberOfRelocations
    self.wxb_oe16(0);               // NumberOfLinenumbers
    self.wxb_oe32(0x60000020);      // Characteristics: CODE|MEM_EXECUTE|MEM_READ

    // ---- Section Header .rdata (40 bytes) ----
    self.wxb_oName8(".rdata"c, 6);
    self.wxb_oe32(WIN_RDATA_SIZE);  // VirtualSize = 158
    self.wxb_oe32(rdataRVA);        // VirtualAddress
    self.wxb_oe32(WIN_FILE_ALIGN);  // SizeOfRawData = 512
    self.wxb_oe32(rdataFileOff);    // PointerToRawData
    self.wxb_oe32(0);               // PointerToRelocations
    self.wxb_oe32(0);               // PointerToLinenumbers
    self.wxb_oe16(0);               // NumberOfRelocations
    self.wxb_oe16(0);               // NumberOfLinenumbers
    self.wxb_oe32(0xC0000040);      // Characteristics: INITIALIZED_DATA|MEM_READ|MEM_WRITE (loader must write IAT)

    // ---- Pad header to FILE_ALIGNMENT (512) ----
    self.wxb_oZeros(WIN_FILE_ALIGN - self.outLen);

    // ---- .text section ----
    var i: int64 := 0;
    while (i < codeLen) {
      self.wxb_oe8(peek8(self.code + i));
      i := i + 1;
    }
    self.wxb_oZeros(textRawSize - codeLen);

    // ---- .rdata section ----
    self.wxb_writeRdata(rdataRVA);

    // ---- Write to file (O_WRONLY|O_CREAT|O_TRUNC=577, mode 0755=493) ----
    var fd: int64 := open(path, 577, 493);
    if (fd < 0) {
      EPrintStr("error: cannot write output: "c);
      EPrintStrLn(path);
      return;
    }
    write(fd, self.out as pchar, self.outLen);
    close(fd);
  }

  // ------------------------------------------------------------------
  // Public API
  // ------------------------------------------------------------------

  pub fn Build(cgBuf: int64, cgLen: int64, cgData: int64, cgDataLen: int64) {
    self.wxb_buildCode(cgBuf, cgLen, cgData, cgDataLen);
  }

  pub fn WritePE64(path: pchar) {
    self.wxb_writePE64(path);
  }

  pub fn GetCodeSize(): int64 { return self.codeLen; }

  pub fn Init() {
    self.codeCap := 65536;
    self.code    := mmap(0, self.codeCap, 3, 34, -1, 0);
    self.codeLen := 0;
    self.outCap  := 65536;
    self.out     := mmap(0, self.outCap, 3, 34, -1, 0);
    self.outLen  := 0;
  }

};
