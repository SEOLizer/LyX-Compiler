// bootstrap/backend/win_x86.lyx
// Windows x86_64 backend for the Lyx bootstrap compiler (WP-BC-32).
// Generates PE64 executables (.exe) for Windows x64 via Windows API (no syscalls).
//
// Strategy: "preamble + trampoline" pattern.
//   [0..WIN_PREAMBLE_SZ-1]              Windows API implementation code
//   [WIN_PREAMBLE_SZ..WIN_PREAMBLE_SZ+286]  Trampolines at same relative offsets as Linux helpers
//   [WIN_PREAMBLE_SZ+287..]             User code (copied verbatim from Linux cgBuf[287..])
//
// This preserves all user-code rel32 call offsets unchanged, because both helper
// trampolines and user code are shifted by the same WIN_PREAMBLE_SZ bytes.
//
// Windows helpers call GetStdHandle(STD_OUTPUT_HANDLE) to get stdout handle reliably
// on real Windows 11 and Wine. Imports: WriteFile, ExitProcess, VirtualAlloc,
// GetCommandLineA, GetStdHandle.
//
// PE64 layout:
//   file[0..511]         headers (DOS + PE + COFF + optional + sections), file-aligned
//   file[512..512+T-1]   .text (padded to FILE_ALIGNMENT)
//   file[512+T..]        .rdata (import tables, padded to FILE_ALIGNMENT)
//   virtual: ImageBase=0x140000000, .text RVA=0x1000, .rdata RVA=dynamic

// ============================================================================
// Layout constants (must all be consistent)
// ============================================================================

// Preamble size: win_print_str_impl(68) + win_print_int_impl(145) + win_strsub_impl(58)
//               + win_argv_setup(237)

import src.emit_write;
import src.std.alloc;
con WIN_PREAMBLE_SZ:   int64 := 508;
// WP-A2: WIN_HELPERS_SZ MUST equal CG_H_USER from codegen_x86.lyx so that
// user-code rel32 call offsets to helpers are identical in Linux and Windows.
// The trampoline zone is now emitted with explicit padding to each WIN_H_*
// offset (see wxb_padTo below), so individual helper SIZE drift can no longer
// shift later trampolines — only these offset constants must track CG_H_*.
con WIN_HELPERS_SZ:    int64 := 1372;  // = CG_H_USER from codegen_x86.lyx
con WIN_USER_OFF:      int64 := 1880;  // WIN_PREAMBLE_SZ + WIN_HELPERS_SZ

// Trampoline target offsets within the helper zone — MUST mirror CG_H_* in
// codegen_x86.lyx exactly (user-code call sites use those Linux offsets).
con WIN_H_START:      int64 := 0;
con WIN_H_STRLEN:     int64 := 79;
con WIN_H_PRINTSTR:   int64 := 103;
con WIN_H_PRINTINT:   int64 := 129;
con WIN_H_STRSUB:     int64 := 233;
con WIN_H_STRCHARAT:  int64 := 304;
con WIN_H_EPRINTSTR:  int64 := 310;
con WIN_H_EPRINTINT:  int64 := 336;
con WIN_H_F64STR:     int64 := 440;
con WIN_H_STRSPLIT:   int64 := 775;
con WIN_H_MAP_NEW:    int64 := 990;
con WIN_H_MAP_SET:    int64 := 1037;
con WIN_H_MAP_GET:    int64 := 1130;
con WIN_H_MAP_HAS:    int64 := 1202;
con WIN_H_STACK_FAIL: int64 := 1275;
con WIN_H_CANARY_INIT: int64 := 1345;
con WIN_H_USER:       int64 := 1372;

// Preamble sub-function offsets within code buffer
con WIN_PS_OFF:   int64 := 0;     // win_print_str_impl
con WIN_PI_OFF:   int64 := 68;    // win_print_int_impl
con WIN_SS_OFF:   int64 := 213;   // win_strsub_impl (68+145)
con WIN_AS_OFF:   int64 := 271;   // win_argv_setup  (68+145+58)

// Trampoline positions within trampoline zone (relative to WIN_PREAMBLE_SZ)
con WIN_TR_START:    int64 := 0;    // _start trampoline / impl (65 bytes)
con WIN_TR_STRLEN:   int64 := 65;   // strlen (15 bytes, no trampoline needed)
con WIN_TR_PRINTSTR: int64 := 80;   // JMP print_str (26 bytes)
con WIN_TR_PRINTINT: int64 := 106;  // JMP print_int (104 bytes)
con WIN_TR_STRSUB:   int64 := 210;  // JMP strsub (71 bytes)
con WIN_TR_STRCHA:   int64 := 281;  // strcharat (6 bytes, no trampoline needed)

// Absolute code offsets of IAT indirect call instructions (FF 15 rel32)
// rel32 field is at offset+2 from instruction start
con WIN_CALL_GH1:  int64 := 10;    // print_str's GetStdHandle call (WIN_PS_OFF+10)
con WIN_CALL_WF1:  int64 := 56;    // print_str's WriteFile call (WIN_PS_OFF+56)
con WIN_CALL_GH2:  int64 := 169;   // print_int's GetStdHandle call (WIN_PI_OFF+101)
con WIN_CALL_WF2:  int64 := 198;   // print_int's WriteFile call (WIN_PI_OFF+130)
con WIN_CALL_VA:   int64 := 239;   // strsub's VirtualAlloc call
con WIN_CALL_GCL:  int64 := 286;   // win_argv_setup's GetCommandLineA call (WIN_AS_OFF+15)
con WIN_CALL_VA2:  int64 := 372;   // win_argv_setup's VirtualAlloc call (WIN_AS_OFF+101)
con WIN_CALL_EP:   int64 := 563;   // _start's ExitProcess call  (WIN_PREAMBLE_SZ + 55)

// PE layout
con WIN_IMAGE_BASE:   int64 := 0x140000000;
con WIN_TEXT_RVA:     int64 := 0x1000;
con WIN_ENTRY_OFF:    int64 := 508;   // = WIN_PREAMBLE_SZ, _start offset in .text
con WIN_FILE_ALIGN:   int64 := 0x200;
con WIN_SEC_ALIGN:    int64 := 0x1000;

// WP-A2.2: source (ELF) link base used by codegen for absolute pointers — mirror
// CG_ELF_BASE / CG_CODE_OFF in codegen_x86.lyx. Base relocs carry image RVAs
// relative to CG_ELF_BASE; the PE consumer rebases each value + emits .reloc.
con WIN_SRC_ELF_BASE: int64 := 4194304;  // 0x400000 = CG_ELF_BASE
con WIN_SRC_CODE_OFF: int64 := 176;      // CG_CODE_OFF

// .rdata layout relative offsets (rdataRVA computed dynamically)
// #1671: Aufbau eines Extern-Eintrags, wie ihn codegen_x86 liefert (CG_EXTERN_SZ).
con WIN_EXTERN_SZ:        int64 := 40;
con WIN_EXTERN_OFF_NAMELEN: int64 := 8;
con WIN_EXTERN_OFF_LIBPTR:  int64 := 16;
con WIN_EXTERN_OFF_LIBLEN:  int64 := 24;
// #1671: Patch-Eintrag des Codegens (CG_PATCH_SZ), Art 3 = FFI-Aufruf.
con WIN_PATCH_SZ:         int64 := 32;
con WIN_PATCH_OFF_IDX:    int64 := 8;
con WIN_PATCH_OFF_KIND:   int64 := 24;
con WIN_PATCH_KIND_EXTERN: int64 := 3;

con WIN_RDATA_IDT_OFF:    int64 := 0;    // Import Directory Table (2 * 20 = 40 bytes)
con WIN_RDATA_INT_OFF:    int64 := 40;   // Import Name Table (5+1 * 8 = 48 bytes)
con WIN_RDATA_IAT_OFF:    int64 := 88;   // Import Address Table (5+1 * 8 = 48 bytes)
con WIN_RDATA_DLL_OFF:    int64 := 136;  // "KERNEL32.dll\0" (13 bytes)
con WIN_RDATA_WF_NAME:    int64 := 149;  // hint(2) + "WriteFile\0" (12 bytes)
con WIN_RDATA_EP_NAME:    int64 := 161;  // hint(2) + "ExitProcess\0" (14 bytes)
con WIN_RDATA_VA_NAME:    int64 := 175;  // hint(2) + "VirtualAlloc\0" (15 bytes)
con WIN_RDATA_GCL_NAME:   int64 := 190;  // hint(2) + "GetCommandLineA\0" (18 bytes)
con WIN_RDATA_GH_NAME:    int64 := 208;  // hint(2) + "GetStdHandle\0" (15 bytes)
con WIN_RDATA_SIZE:       int64 := 223;  // total used bytes in .rdata

// IAT slot offsets within .rdata:
// WriteFile       = IAT_OFF + 0  = 88
// ExitProcess     = IAT_OFF + 8  = 96
// VirtualAlloc    = IAT_OFF + 16 = 104
// GetCommandLineA = IAT_OFF + 24 = 112
// GetStdHandle    = IAT_OFF + 32 = 120

// ============================================================================
// WinX86Backend
// ============================================================================

pub type WinX86Backend = class {

  code:    int64;
  codeLen: int64;
  codeCap: int64;

  out:    int64;
  outLen: int64;
  outCap: int64;

  // WP-A2.2: base relocations from codegen (image RVAs of absolute pointers).
  baseRelocBuf:    int64;
  baseRelocCount:  int64;
  peRVAs:          int64;   // sorted .text RVAs of the relocated pointers
  relocContent:    int64;   // built IMAGE_BASE_RELOCATION blocks
  relocContentLen: int64;

  // WP-A2.3: win64 heap allocator helper. Linux mmap syscalls (alloc/new/dynarray)
  // are rewritten to call this VirtualAlloc-based helper appended at code end.
  // #1671: Importe aus `extern fn ... link "x.dll"`. Bis 1.1.3D stand in
  // .rdata eine fest verdrahtete Liste mit den fuenf kernel32-Funktionen der
  // Laufzeit; jede eigene Deklaration fehlte in der Import-Tabelle, der
  // Aufruf sprang ins Leere (page fault auf 0xffffffffffffffff, weil der
  // disp32 ungepatcht blieb).
  externBuf:       int64;   // Eintraege wie CG_EXTERN_SZ: namePtr,nameLen,libPtr,libLen
  externCount:     int64;
  patchBuf:        int64;   // Patch-Tabelle des Codegens (fuer CG_PATCH_EXTERN)
  patchCount:      int64;
  // Errechnetes .rdata-Layout (in wxb_buildCode gesetzt, von patchIAT,
  // writeRdata und der Groessenrechnung gemeinsam benutzt).
  rdIatOff:        int64;   // Offset der IAT der ERSTEN DLL (dort liegen die fuenf der Laufzeit)
  rdSize:          int64;   // belegte Bytes in .rdata
  rdExternSlot:    int64;   // Offset der IAT-Zelle je Extern (8 Byte je Eintrag), 0 = keine
  rdExternName:    int64;   // #1676: Offset des hint+Name-Blocks je Extern
  impDllPtr:       int64;   // #1671: Zwischenergebnisse von wxb_planImports
  impDllLen:       int64;
  impDllCnt:       int64;
  impIntOff:       int64;
  impIatOff:       int64;
  impNamesOff:     int64;
  impDllCount:     int64;

  vallocCallOff:   int64;   // code offset of the helper's `call [VirtualAlloc]` (-1 = none)
  argcStoreOff:    int64;   // WP-WINARGV: disp32-Offset von `mov [rip+d],rax` (argc→CG_ARGC), Patch
  argvStoreOff:    int64;   // WP-WINARGV: disp32-Offset von `mov [rip+d],rdx` (argv→CG_ARGV), Patch
  envStoreOff:     int64;   // #1677: disp32-Offset des Stores in CG_ENVBLOCK
  envCallOff:      int64;   // #1677: Offset des `call [GetEnvironmentStringsA]`

  // #1678: Offset des `call [VirtualFree]` im Freigabe-Helfer (-1 = keiner).
  vfreeCallOff:    int64;

  // ------------------------------------------------------------------
  // Code buffer primitives
  // ------------------------------------------------------------------

  fn wxb_cGrow(n: int64) {
    if (self.codeCap >= self.codeLen + n) { return; }
    var nc: int64 := self.codeCap * 2;
    while (nc < self.codeLen + n) { nc := nc * 2; }
    var nb: int64 := alloc(nc);
    var i: int64 := 0;
    while (i < self.codeLen) { poke8(nb + i, peek8(self.code + i)); i := i + 1; }
    self.code    := nb;
    self.codeCap := nc;
  }

  fn wxb_ce8(v: int64) {
    self.wxb_cGrow(1);
    poke8(self.code + self.codeLen, v & 0xFF);
    self.codeLen := self.codeLen + 1;
  }

  fn wxb_ce32(v: int64) {
    self.wxb_ce8(v & 0xFF);
    self.wxb_ce8((v >> 8)  & 0xFF);
    self.wxb_ce8((v >> 16) & 0xFF);
    self.wxb_ce8((v >> 24) & 0xFF);
  }

  fn wxb_patch32(off: int64, val: int64) {
    poke8(self.code + off,     val & 0xFF);
    poke8(self.code + off + 1, (val >> 8) & 0xFF);
    poke8(self.code + off + 2, (val >> 16) & 0xFF);
    poke8(self.code + off + 3, (val >> 24) & 0xFF);
  }

  // ------------------------------------------------------------------
  // Output buffer primitives
  // ------------------------------------------------------------------

  fn wxb_oGrow(n: int64) {
    if (self.outCap >= self.outLen + n) { return; }
    var nc: int64 := self.outCap * 2;
    while (nc < self.outLen + n) { nc := nc * 2; }
    var nb: int64 := alloc(nc);
    var i: int64 := 0;
    while (i < self.outLen) { poke8(nb + i, peek8(self.out + i)); i := i + 1; }
    self.out    := nb;
    self.outCap := nc;
  }

  fn wxb_oe8(v: int64) {
    self.wxb_oGrow(1);
    poke8(self.out + self.outLen, v & 0xFF);
    self.outLen := self.outLen + 1;
  }

  fn wxb_oe16(v: int64) {
    self.wxb_oe8(v & 0xFF);
    self.wxb_oe8((v >> 8) & 0xFF);
  }

  fn wxb_oe32(v: int64) {
    self.wxb_oe8(v & 0xFF);
    self.wxb_oe8((v >> 8)  & 0xFF);
    self.wxb_oe8((v >> 16) & 0xFF);
    self.wxb_oe8((v >> 24) & 0xFF);
  }

  fn wxb_oe64(v: int64) {
    self.wxb_oe32(v & 0xFFFFFFFF);
    self.wxb_oe32((v >> 32) & 0xFFFFFFFF);
  }

  fn wxb_oZeros(n: int64) {
    var i: int64 := 0;
    while (i < n) { self.wxb_oe8(0); i := i + 1; }
  }

  fn wxb_oName8(s: pchar, sLen: int64) {
    var i: int64 := 0;
    while (i < 8) {
      if (i < sLen) { self.wxb_oe8(StrCharAt(s, i)); } else { self.wxb_oe8(0); }
      i := i + 1;
    }
  }

  fn wxb_oStr(s: pchar, n: int64) {
    var i: int64 := 0;
    while (i < n) { self.wxb_oe8(StrCharAt(s, i)); i := i + 1; }
  }

  // ------------------------------------------------------------------
  // Preamble: win_print_str_impl (68 bytes, code offset 0)
  // RDI = string ptr (SysV ABI from Lyx).
  // Calls GetStdHandle(-11) FIRST (before strlen), saves handle to [rsp+48],
  // then inlines strlen, then calls WriteFile.
  // GetStdHandle must come first because it clobbers rdx/r8 (volatile in
  // Windows x64 ABI) which we need for the WriteFile call.
  // rel32 fields patched in wxb_patchIAT (WIN_CALL_GH1=10, WIN_CALL_WF1=56).
  //
  // Stack layout after sub rsp, 0x40:
  //   [rsp+0..31]  shadow space
  //   [rsp+32..39] lpOverlapped = NULL (zeroed via xor+mov)
  //   [rsp+40..47] bytesWritten (r9 = &[rsp+40])
  //   [rsp+48..55] saved stdout handle
  // ------------------------------------------------------------------

  fn wxb_emitPrintStr() {
    // push rdi                                      1 byte   [0]
    self.wxb_ce8(0x57);
    // sub rsp, 0x40  (64: shadow32+lpOvlp8+bytesWr8+savedHandle8)  4 bytes  [1..4]
    self.wxb_ce8(0x48); self.wxb_ce8(0x83); self.wxb_ce8(0xEC); self.wxb_ce8(0x40);
    // mov ecx, 0xFFFFFFF5  (STD_OUTPUT_HANDLE = -11)  5 bytes  [5..9]
    self.wxb_ce8(0xB9); self.wxb_ce8(0xF5); self.wxb_ce8(0xFF); self.wxb_ce8(0xFF); self.wxb_ce8(0xFF);
    // call [GetStdHandle_IAT]  FF 15 rel32           6 bytes  [10..15]  WIN_CALL_GH1=10
    self.wxb_ce8(0xFF); self.wxb_ce8(0x15);
    self.wxb_ce32(0);   // placeholder, patched in wxb_patchIAT
    // mov [rsp+48], rax  save stdout handle          5 bytes  [16..20]
    self.wxb_ce8(0x48); self.wxb_ce8(0x89); self.wxb_ce8(0x44); self.wxb_ce8(0x24); self.wxb_ce8(0x30);
    // Inline strlen: xor eax, eax  (zero-extends)   2 bytes  [21..22]
    self.wxb_ce8(0x31); self.wxb_ce8(0xC0);
    // cmp byte[rdi+rax], 0                          4 bytes  [23..26]
    self.wxb_ce8(0x80); self.wxb_ce8(0x3C); self.wxb_ce8(0x07); self.wxb_ce8(0x00);
    // jz +4 (to offset 33)                          2 bytes  [27..28]
    self.wxb_ce8(0x74); self.wxb_ce8(0x04);
    // inc eax  (zero-extends to rax)                2 bytes  [29..30]
    self.wxb_ce8(0xFF); self.wxb_ce8(0xC0);
    // jmp -10 (back to cmp at offset 23)            2 bytes  [31..32]
    self.wxb_ce8(0xEB); self.wxb_ce8(0xF6);
    // rax = len (offset 33)
    // mov r8, rax  (r8 = len, 3rd WriteFile arg)    3 bytes  [33..35]
    self.wxb_ce8(0x49); self.wxb_ce8(0x89); self.wxb_ce8(0xC0);
    // mov rdx, rdi  (rdx = buf, 2nd WriteFile arg)  3 bytes  [36..38]
    self.wxb_ce8(0x48); self.wxb_ce8(0x89); self.wxb_ce8(0xFA);
    // mov rcx, [rsp+48]  restore handle (1st arg)   5 bytes  [39..43]
    self.wxb_ce8(0x48); self.wxb_ce8(0x8B); self.wxb_ce8(0x4C); self.wxb_ce8(0x24); self.wxb_ce8(0x30);
    // xor eax, eax  (zero for lpOverlapped store)   2 bytes  [44..45]
    self.wxb_ce8(0x31); self.wxb_ce8(0xC0);
    // mov [rsp+32], rax  lpOverlapped=NULL (qword)  5 bytes  [46..50]
    self.wxb_ce8(0x48); self.wxb_ce8(0x89); self.wxb_ce8(0x44); self.wxb_ce8(0x24); self.wxb_ce8(0x20);
    // lea r9, [rsp+40]  &bytesWritten (4th arg)     5 bytes  [51..55]
    self.wxb_ce8(0x4C); self.wxb_ce8(0x8D); self.wxb_ce8(0x4C); self.wxb_ce8(0x24); self.wxb_ce8(0x28);
    // call [WriteFile_IAT]  FF 15 rel32             6 bytes  [56..61]  WIN_CALL_WF1=56
    self.wxb_ce8(0xFF); self.wxb_ce8(0x15);
    self.wxb_ce32(0);   // placeholder, patched in wxb_patchIAT
    // add rsp, 0x40                                 4 bytes  [62..65]
    self.wxb_ce8(0x48); self.wxb_ce8(0x83); self.wxb_ce8(0xC4); self.wxb_ce8(0x40);
    // pop rdi                                       1 byte   [66]
    self.wxb_ce8(0x5F);
    // ret                                           1 byte   [67]
    self.wxb_ce8(0xC3);
    // Total: 68 bytes (WIN_PS_OFF=0..67) ✓
  }

  // ------------------------------------------------------------------
  // Preamble: win_print_int_impl (143 bytes, code offset 68)
  // RDI = int64 value (SysV ABI). Converts to decimal, calls WriteFile.
  // Digit conversion identical to Linux print_int bytes 0..86.
  // ------------------------------------------------------------------

  fn wxb_emitPrintInt() {
    // sub rsp, 24  (digit buffer)                    4 bytes  [0..3]
    self.wxb_ce8(0x48); self.wxb_ce8(0x83); self.wxb_ce8(0xEC); self.wxb_ce8(0x18);
    // lea rsi, [rsp+23]  end of buffer               5 bytes  [4..8]
    self.wxb_ce8(0x48); self.wxb_ce8(0x8D); self.wxb_ce8(0x74);
    self.wxb_ce8(0x24); self.wxb_ce8(0x17);
    // mov rax, rdi                                   3 bytes  [9..11]
    self.wxb_ce8(0x48); self.wxb_ce8(0x89); self.wxb_ce8(0xF8);
    // test rax, rax                                  3 bytes  [12..14]
    self.wxb_ce8(0x48); self.wxb_ce8(0x85); self.wxb_ce8(0xC0);
    // jnz +8 (.nonzero at byte 25)                   2 bytes  [15..16]
    self.wxb_ce8(0x75); self.wxb_ce8(0x08);
    // mov byte[rsi], '0'                             3 bytes  [17..19]
    self.wxb_ce8(0xC6); self.wxb_ce8(0x06); self.wxb_ce8(0x30);
    // dec rsi                                        3 bytes  [20..22]
    self.wxb_ce8(0x48); self.wxb_ce8(0xFF); self.wxb_ce8(0xCE);
    // jmp .emit (+48, to byte 73)                    2 bytes  [23..24]
    self.wxb_ce8(0xEB); self.wxb_ce8(0x30);
    // .nonzero: test rax, rax                        3 bytes  [25..27]
    self.wxb_ce8(0x48); self.wxb_ce8(0x85); self.wxb_ce8(0xC0);
    // jge +3 (.digitloop at byte 33)                 2 bytes  [28..29]
    self.wxb_ce8(0x7D); self.wxb_ce8(0x03);
    // neg rax                                        3 bytes  [30..32]
    self.wxb_ce8(0x48); self.wxb_ce8(0xF7); self.wxb_ce8(0xD8);
    // .digitloop: test rax, rax                      3 bytes  [33..35]
    self.wxb_ce8(0x48); self.wxb_ce8(0x85); self.wxb_ce8(0xC0);
    // jz +24 (.sign at byte 62)                      2 bytes  [36..37]
    self.wxb_ce8(0x74); self.wxb_ce8(0x18);
    // xor rdx, rdx                                   3 bytes  [38..40]
    self.wxb_ce8(0x48); self.wxb_ce8(0x31); self.wxb_ce8(0xD2);
    // mov rcx, 10                                    7 bytes  [41..47]
    self.wxb_ce8(0x48); self.wxb_ce8(0xC7); self.wxb_ce8(0xC1);
    self.wxb_ce8(0x0A); self.wxb_ce8(0x00); self.wxb_ce8(0x00); self.wxb_ce8(0x00);
    // idiv rcx                                       3 bytes  [48..50]
    self.wxb_ce8(0x48); self.wxb_ce8(0xF7); self.wxb_ce8(0xF9);
    // add rdx, 48                                    4 bytes  [51..54]
    self.wxb_ce8(0x48); self.wxb_ce8(0x83); self.wxb_ce8(0xC2); self.wxb_ce8(0x30);
    // mov [rsi], dl                                  2 bytes  [55..56]
    self.wxb_ce8(0x88); self.wxb_ce8(0x16);
    // dec rsi                                        3 bytes  [57..59]
    self.wxb_ce8(0x48); self.wxb_ce8(0xFF); self.wxb_ce8(0xCE);
    // jmp .digitloop (-29)                           2 bytes  [60..61]
    self.wxb_ce8(0xEB); self.wxb_ce8(0xE3);
    // .sign: test rdi, rdi                           3 bytes  [62..64]
    self.wxb_ce8(0x48); self.wxb_ce8(0x85); self.wxb_ce8(0xFF);
    // jns +6 (.emit at byte 73)                      2 bytes  [65..66]
    self.wxb_ce8(0x79); self.wxb_ce8(0x06);
    // mov byte[rsi], '-'                             3 bytes  [67..69]
    self.wxb_ce8(0xC6); self.wxb_ce8(0x06); self.wxb_ce8(0x2D);
    // dec rsi                                        3 bytes  [70..72]
    self.wxb_ce8(0x48); self.wxb_ce8(0xFF); self.wxb_ce8(0xCE);
    // .emit: inc rsi  (rsi = string start)           3 bytes  [73..75]
    self.wxb_ce8(0x48); self.wxb_ce8(0xFF); self.wxb_ce8(0xC6);
    // lea rdx, [rsp+23]                              5 bytes  [76..80]
    self.wxb_ce8(0x48); self.wxb_ce8(0x8D); self.wxb_ce8(0x54);
    self.wxb_ce8(0x24); self.wxb_ce8(0x17);
    // sub rdx, rsi  (rdx = len-1)                    3 bytes  [81..83]
    self.wxb_ce8(0x48); self.wxb_ce8(0x29); self.wxb_ce8(0xF2);
