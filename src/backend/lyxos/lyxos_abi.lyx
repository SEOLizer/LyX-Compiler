  if (nr == 87) { return "sys_gpt"c; }
  if (nr == 88) { return "sys_partinfo"c; }
  if (nr == 89) { return "sys_mkfat32_part"c; }
  if (nr == 90) { return "sys_mount_part"c; }
  if (nr == 91) { return "sys_spawn_child"c; }
  if (nr == 92) { return "sys_setenv"c; }
  if (nr == 93) { return "sys_getenv"c; }
