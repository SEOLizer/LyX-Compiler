// Index zum Namen, oder -1. Linearer Vergleich: die Liste ist dreistellig,
// und eine Streuung waere hier mehr Mechanik als Gewinn.
fn _lgEq(a: pchar, al: int64, b: pchar, bl: int64): int64 {
  if (al != bl) { return 0; }
  var i: int64 := 0;
  while (i < al) {
    if (peek8(a as int64 + i) != peek8(b as int64 + i)) { return 0; }
    i := i + 1;
  }
  return 1;
}

pub fn LyxosGenIdxFuerName(nm: pchar, nl: int64): int64 {
  var i: int64 := 0;
  while (i < LyxosGenAnzahl()) {
    if (_lgEq(nm, nl, LyxosGenNameFuerIdx(i), LyxosGenNameLenFuerIdx(i)) != 0) { return i; }
    i := i + 1;
  }
  return 0 - 1;
}
