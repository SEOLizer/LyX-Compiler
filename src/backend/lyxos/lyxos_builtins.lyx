// src/backend/lyxos/lyxos_builtins.lyx — die Syscalls, die der Kernel
// hat und die Handarbeit nicht erreicht hatte (#2549).
//
// ERZEUGT von tools/lyxos_builtins_erzeugen.py aus
// work/lyxos/syscall-argc.txt. NICHT VON HAND PFLEGEN — neu erzeugen,
// sonst laufen zwei Staende auseinander.
//
// Stand der Quelle: LyxOS 2d5bddc 2026-11-20.
// Von 221 Nummern mit lesbarer Gestalt erreichte das Backend
// 105; dieser Block traegt 115 weitere.
//
// WOZU. Eine Nummer aus Lyx erreichbar zu machen, kostete VIER
// Handgriffe: sema._regBuiltin, die Namensauflistung in ir_lower, der
// Verteiler in emit_lyxos und die Liste in builtin_ziele. Vier
// Aufzaehlungen derselben Sache sind genau das Muster, das hier schon
// mehrfach auseinandergelaufen ist (#2432, #2450, #2463). Darum stehen
// die Daten EINMAL hier, und die vier Stellen fragen sie zur Laufzeit
// ueber eine Schleife ab. Eine neue Kernelnummer kostet damit einen
// Lauf dieses Skripts, keinen Eingriff an vier Stellen.
//
// WAS HIER NICHT STEHT:
//   - Nummern, die das Backend schon emittiert. Die haben ihren Weg;
//     ein zweiter waere eine zweite Stelle fuer dieselbe Sache.
//   - Nummern ohne lesbare Gestalt in der Kerneltabelle. Fuer die gibt
//     LyxosArgcFuerNr -1, und die Gestaltpruefung laesst sie durch
//     (#2482) — eine Argumentzahl zu raten waere der stille Default.
//   - Namen, die schon ein anderer Builtin traegt. Welche der beiden
//     Nummern gemeint ist, kann das Skript nicht wissen; es benennt
//     sie statt sie stillschweigend zu verwerfen:
//       156 sys_iofs_mount (argc 1)
//
// Builtin-IDs: 600 .. 714, zusammenhaengend,
// damit der Verteiler in emit_lyxos EINE Bereichsabfrage ist.

unit src.backend.lyxos.lyxos_builtins;

// Erste Builtin-ID dieses Blocks.
pub con LYXOS_GEN_ID_BASIS: int64 := 600;

// Wie viele Nummern dieser Block traegt.
pub fn LyxosGenAnzahl(): int64 {
  return 115;
}

