            else if id == 100 { lx13ac := 4; } // sys_task_await(fd,result_out,result_size,timeout_ns)
            else if id == 101 { lx13ac := 1; } // sys_task_cancel(task_fd)
            else if id == 102 { lx13ac := 1; } // sys_task_group_create(flags)
