            else if id == 113 { lx14ac := 1; } // sys_ai_ctx_destroy(ctx_fd)
            else if id == 114 { lx14ac := 4; } // sys_ai_infer(ctx_fd,prompt_fd,result_fd,opts)
            else if id == 115 { lx14ac := 6; } // sys_ai_infer_sync(ctx_fd,prompt,prompt_len,result,result_max,opts)
