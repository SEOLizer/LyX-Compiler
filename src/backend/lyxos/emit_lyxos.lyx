            self.emitMovSlotFromRax(dest);
        }
        // #1720: sys_gettimeofday(tv, tz) — timeval {tv_sec, tv_usec} fuellen.
        // Quelle ist dieselbe wie bei clock_gettime (211): sys_time_ns (117)
        // liefert Nanosekunden in rdx. tz wird nicht ausgewertet; Zeitzonen
        // kennt der Kernel nicht, und Linux liefert dort seit langem 0.
        // Ohne Spruenge — deshalb keine Weiten nachzurechnen.
        else if id == 238 {
            self.emitMovRaxImm(117);                                       // sys_time_ns
            self.emitSyscall();
            self.emit8(0x48); self.emit8(0x89); self.emit8(0xD0);          // MOV rax, rdx   (ns)
            self.emitMovRdiFromSlot(argBase);                              // rdi = tv       (nach dem Syscall)
            self.emit8(0x48); self.emit8(0xC7); self.emit8(0xC1); self.emit32(1000000000);  // MOV rcx, 1e9
            self.emit8(0x48); self.emit8(0x31); self.emit8(0xD2);          // XOR rdx, rdx
            self.emit8(0x48); self.emit8(0xF7); self.emit8(0xF1);          // DIV rcx        (rax=sec, rdx=Rest-ns)
            self.emit8(0x48); self.emit8(0x89); self.emit8(0x07);          // MOV [rdi], rax
            self.emit8(0x48); self.emit8(0x89); self.emit8(0xD0);          // MOV rax, rdx
            self.emit8(0x48); self.emit8(0x31); self.emit8(0xD2);          // XOR rdx, rdx
            self.emit8(0x48); self.emit8(0xC7); self.emit8(0xC1); self.emit32(1000);        // MOV rcx, 1000
            self.emit8(0x48); self.emit8(0xF7); self.emit8(0xF1);          // DIV rcx        (rax=usec)
            self.emit8(0x48); self.emit8(0x89); self.emit8(0x47); self.emit8(0x08);         // MOV [rdi+8], rax
            self.emit8(0x31); self.emit8(0xC0);                            // XOR eax, eax
            self.emitMovSlotFromRax(dest);
        }
        // #1720: ID 239 — "diese Plattform kennt den Aufruf nicht", -ENOSYS.
        //
        // Benutzt von der timerfd-Familie. LyxOS hat ein ANDERES Timer-Modell
        // (sys_timer_create/sys_timer_set mit Handle und eigener Wartesemantik)
        // als Linux' timerfd. Eine Abbildung waere keine Uebersetzung, sondern
        // eine Behauptung: dass sich ein LyxOS-Timer-Handle beim Lesen wie ein
        // timerfd verhaelt. Fuer sys_timerfd_gettime gibt es ueberhaupt keine
        // Entsprechung.
        //
        // Eine plausibel aussehende Fehluebersetzung waere schlimmer als eine
        // ehrliche Fehlermeldung — genau der stille Default, den #839 und
        // #1339 gekostet haben. -ENOSYS sagt dem Aufrufer die Wahrheit, und
        // die Unit uebersetzt, statt an einer nie gerufenen Funktion zu
        // scheitern.
        //
        // Bekommt LyxOS timerfd oder wird die Abbildung vom Kernel-Team
        // bestaetigt, tritt hier eine echte Umsetzung an diese Stelle.
        else if id == 239 {
            self.emitMovRaxImm(0 - 38);                                    // -ENOSYS
            self.emitMovSlotFromRax(dest);
        }
        // lyxc→LyxOS: EPrintInt → stderr (fd 2; Arg in Slot 0 wie PrintInt id 2).
        else if id == 234 { self.emitPrintIntFd(2); }
        // ArgvGet(argv,i): lea rax,[argv+i*8]; mov rax,[rax]. argBase-Konvention.
        else if id == 235 {
            self.emitMovRaxFromSlot(argBase); self.emitMovRcxFromSlot(argBase + 1);
            self.emit8(0x48); self.emit8(0x8D); self.emit8(0x04); self.emit8(0xC8);  // lea rax, [rax+rcx*8]
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0x00);                    // mov rax, [rax]
            self.emitMovSlotFromRax(dest);
        }
        // rmdir → sys_unlink(AT_CWD, path, UNLINK_DIR=1) @ 0x0208 (deferred VFS-Block).
        else if id == 236 { self.emitVfsSyscallAB(0x0208, 3, argBase, dest); }
        // WP-WSP: Kernel-Systemprimitive (cpu-ctrl / Fences / Atomics).
        else if id == 240 { self.emit8(0xF3); self.emit8(0x90); }                  // cpu_pause (PAUSE)
        else if id == 241 { self.emit8(0xF4); }                                    // cpu_hlt (HLT)
        else if id == 242 { self.emit8(0xFA); }                                    // cpu_cli (CLI)
        else if id == 243 { self.emit8(0xFB); }                                    // cpu_sti (STI)
        else if id == 244 {                                                        // cpu_rdmsr(msr) → edx:eax
            self.emitMovRcxFromSlot(argBase);                                      // ecx = msr index
            self.emit8(0x0F); self.emit8(0x32);                                    // rdmsr
            self.emit8(0x48); self.emit8(0xC1); self.emit8(0xE2); self.emit8(0x20);// shl rdx, 32
            self.emit8(0x48); self.emit8(0x09); self.emit8(0xD0);                  // or rax, rdx
            self.emitMovSlotFromRax(dest);
        }
        else if id == 245 {                                                        // cpu_wrmsr(msr, value)
            self.emitMovRaxFromSlot(argBase + 1);                                  // rax = value (eax=low)
            self.emit8(0x48); self.emit8(0x89); self.emit8(0xC2);                  // mov rdx, rax
            self.emit8(0x48); self.emit8(0xC1); self.emit8(0xEA); self.emit8(0x20);// shr rdx, 32 (edx=high)
            self.emitMovRcxFromSlot(argBase);                                      // ecx = msr index
            self.emit8(0x0F); self.emit8(0x30);                                    // wrmsr
        }
        else if id == 246 { self.emit8(0x0F); self.emit8(0xAE); self.emit8(0xF8); } // sfence
        else if id == 247 { self.emit8(0x0F); self.emit8(0xAE); self.emit8(0xE8); } // lfence
        else if id == 248 { self.emit8(0x0F); self.emit8(0xAE); self.emit8(0xF0); } // mfence
        else if id == 249 {                                                        // atomic_load(ptr)
            self.emitMovRaxFromSlot(argBase);
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0x00);                  // mov rax, [rax]
            self.emitMovSlotFromRax(dest);
        }
        else if id == 250 {                                                        // atomic_store(ptr, val) → alter Wert
            self.emitMovRaxFromSlot(argBase + 1);                                  // rax = val
            self.emitMovRcxFromSlot(argBase);                                      // rcx = ptr
            self.emit8(0x48); self.emit8(0x87); self.emit8(0x01);                  // xchg [rcx], rax (implizit lock)
            self.emitMovSlotFromRax(dest);
        }
        else if id == 251 {                                                        // atomic_cas(ptr, expected, desired) → alter Wert
            self.emitMovRaxFromSlot(argBase + 1);                                  // rax = expected
            self.emitMovRcxFromSlot(argBase);                                      // rcx = ptr
            self.emitMovRdxFromSlot(argBase + 2);                                  // rdx = desired
            self.emit8(0xF0); self.emit8(0x48); self.emit8(0x0F); self.emit8(0xB1); self.emit8(0x11);  // lock cmpxchg [rcx], rdx
            self.emitMovSlotFromRax(dest);                                         // rax = alter Wert
        }
        else if id == 252 {                                                        // atomic_fetch_add(ptr, delta) → alter Wert
            self.emitMovRaxFromSlot(argBase + 1);                                  // rax = delta
            self.emitMovRcxFromSlot(argBase);                                      // rcx = ptr
            self.emit8(0xF0); self.emit8(0x48); self.emit8(0x0F); self.emit8(0xC1); self.emit8(0x01);  // lock xadd [rcx], rax
            self.emitMovSlotFromRax(dest);
        }
        else {
            // #1388: Hier endete die Kette OHNE Default — eine unbekannte
            // Builtin-ID erzeugte gar nichts und verschwand lautlos. Das ist
            // dieselbe Klasse wie der Opcode-Fall aus #1339 und wie die
            // Fehldispatch-Wurzel aus #839, nur eine Ebene tiefer.
            EPrintStr("error: lyxos: Builtin-ID "c);
            EPrintInt(id);
            EPrintStrLn(" wird nicht behandelt"c);
            EPrintStrLn("  Die IDs sind ein globaler Namensraum ueber alle Backends."c);
            EPrintStrLn("  Vergabe und Belegung stehen in src/backend/_builtin_ids.md."c);
            exit(1);
        }
    }

    // sys_mmap(hint=0, size, prot=PROT_RW=3, flags=MAP_PRIVATE|MAP_ANON=5) → rdx=addr
    // §10.4=9 (Bump-Allokator ab USER_HEAP_BASE 0x10000000).
    // WP-ALIGN: alignN>0 → über-allozieren (size+alignN) + Ergebnis auf alignN aufrunden
    // (Bump-Allokator liefert unaligned). alignN=0 → Standard.
    fn emitAlloc(sizeSlot: int64, dest: int64, alignN: int64): void {
        self.emitMovRaxImm(9);
        self.emit8(0x31); self.emit8(0xFF);
        self.emitMovRsiFromSlot(sizeSlot);
        if alignN > 0 {
            self.emit8(0x48); self.emit8(0x81); self.emit8(0xC6); self.emit32(alignN);  // add rsi, alignN
        }
        self.emit8(0xBA); self.emit32(3);
        self.emit8(0x41); self.emit8(0xBA); self.emit32(5);
        self.emitSyscall();
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xD0);                            // mov rax, rdx
        if alignN > 0 {
            self.emit8(0x48); self.emit8(0x05); self.emit32(alignN - 1);                 // add rax, alignN-1
            self.emit8(0x48); self.emit8(0x25); self.emit32(0 - alignN);                 // and rax, -alignN
        }
        self.emitMovSlotFromRax(dest);
    }

    // sys_munmap(addr, size=0) — KEIN §10.4-Äquivalent (Bump-Allokator kennt kein Free).
    // Nummer 0x0101 bleibt als Design-Platzhalter; Kernel liefert -1 (No-Op-Semantik).
    fn emitFree(ptrSlot: int64): void {
        self.emitMovRaxImm(0x0101);
        var off: int64 := self.slotOff(ptrSlot);
        if ptrSlot < 16 {
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0x7D);
            self.emit8(off & 0xFF);
        } else {
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0xBD);
            self.emit32(off);
        }
        self.emit8(0x31); self.emit8(0xF6);
        self.emitSyscall();
    }

    // --- IR instruction dispatch ---

    fn emitInstr(idx: int64): void {
        var instrBuf: int64 := peek64(self.irMod + IR_MOD_OFF_INSTRBUF);
        var iBase:    int64 := instrBuf + idx * IR_INSTR_SIZE;
        var op:       int64 := peek64(iBase + 0);
        var dest:     int64 := peek64(iBase + IR_INSTR_OFF_DEST);
        var src1:     int64 := peek64(iBase + IR_INSTR_OFF_SRC1);
        var src2:     int64 := peek64(iBase + IR_INSTR_OFF_SRC2);
        var imm:      int64 := peek64(iBase + IR_INSTR_OFF_IMMINT);
        // LYXOS-WP-1: Arithmetik/Bitwise/Shift/Vergleiche (2-Operand) + NEG (unary).
        var isBin: int64 := 0;
        if op == 10 || op == 11 || op == 12 || op == 13 || op == 14 { isBin := 1; }
        if op == 51 || op == 52 || op == 54 || op == 55 || op == 56 || op == 57 { isBin := 1; }
        if op == 59 || op == 60 { isBin := 1; }
        if op == 30 || op == 31 || op == 32 || op == 33 || op == 34 || op == 35 { isBin := 1; }
        if isBin != 0 {
            self.emitBinOp(op, dest, src1, src2);
            return;
        }
        if op == 15 {                           // IRO_NEG
            self.emitNeg(dest, src1);
            return;
        }
        if op == 0 {                            // IRO_CONST_INT
            self.emitMovRaxImm(imm);
            self.emitMovSlotFromRax(dest);
        } else if op == 1 {                     // IRO_CONST_STR
            self.emitConstStr(imm, dest);
        } else if op == 61 {                    // IRO_LOAD_LOCAL
            self.emitMovRaxFromSlot(src1);
            self.emitMovSlotFromRax(dest);
        } else if op == 62 {                    // IRO_STORE_LOCAL
            self.emitMovRaxFromSlot(src1);
            self.emitMovSlotFromRax(dest);
        } else if op == 80 {                    // IRO_CALL_BUILTIN (src1=argBase für ids 200-207)
            self.emitBuiltinCall(imm, src1, dest);
        } else if op == 164 {                   // IRO_LOAD_ERRVAL (LX-21: rax=r15-shadow)
            self.emit8(0x49); self.emit8(0x8B); self.emit8(0xC7);  // MOV rax, r15
            self.emitMovSlotFromRax(dest);
        } else if op == 81 {                    // IRO_CALL (src1=funcId, src2=argBase, imm=argCount)
            self.emitCall(src1, src2, imm, dest);
        } else if op == 94 {                    // IRO_FUNC_EXIT
            self.emitMovRaxFromSlot(src1);
            self.emitEpilogue();
        } else if op == 112 {                   // IRO_ALLOC (imm = @align-Boundary, 0=Standard)
            self.emitAlloc(src1, dest, imm);
        } else if op == 113 {                   // IRO_FREE
            self.emitFree(src1);
        } else if op == 90 {                    // IRO_JMP — LYXOS-WP-2
            self.emitJmpToLabel(imm);           // Label-Id steht in IMMINT (irAddInstrDirect)
        } else if op == 91 {                    // IRO_BR_TRUE
            self.emitBrCond(src1, imm, 1);
        } else if op == 92 {                    // IRO_BR_FALSE
            self.emitBrCond(src1, imm, 0);
        } else if op == 93 {                    // IRO_LABEL
            self.emitLabelDef(imm);
        } else if op == 64 {                    // IRO_LOAD_GLOBAL — LYXOS-WP-3 (dest=slot, src1=gIdx)
            self.emitLoadGlobal(dest, src1);
        } else if op == 65 {                    // IRO_STORE_GLOBAL (dest=gIdx, src1=value)
            self.emitStoreGlobal(dest, src1);
        } else if op == 66 {                    // IRO_LOAD_GLOBAL_ADDR (dest=slot, src1=gIdx)
            self.emitLoadGlobalAddr(dest, src1);
        } else if op == 108 || op == 110 {      // IRO_LOAD_FIELD(_HEAP) — LYXOS-WP-4 (dest,src1=base,src2=off)
            self.emitLoadField(dest, src1, src2);
        } else if op == 109 || op == 111 {      // IRO_STORE_FIELD(_HEAP) (dest=off,src1=value,src2=base)
            self.emitStoreField(dest, src1, src2);
        } else if op == 86 {                    // IRO_LOAD_IDX (dest,src1=base,src2=idx)
            self.emitLoadIdx(dest, src1, src2);
        } else if op == 87 {                    // IRO_STORE_IDX (dest=idx,src1=value,src2=base)
            self.emitStoreIdx(dest, src1, src2);
        // WP-STUB: bisher still verworfene reachable Ops jetzt korrekt emittiert.
        } else if op == 50 {                    // IRO_NOT (logisch): dest = (src1==0)?1:0
            self.emitMovRaxFromSlot(src1);
            self.emit8(0x48); self.emit8(0x85); self.emit8(0xC0);   // test rax, rax
            self.emit8(0x0F); self.emit8(0x94); self.emit8(0xC0);   // sete al
            self.emit8(0x0F); self.emit8(0xB6); self.emit8(0xC0);   // movzx eax, al
            self.emitMovSlotFromRax(dest);
        } else if op == 58 {                    // IRO_BITNOT: dest = ~src1
            self.emitMovRaxFromSlot(src1);
            self.emit8(0x48); self.emit8(0xF7); self.emit8(0xD0);   // not rax
            self.emitMovSlotFromRax(dest);
        } else if op == 121 {                   // IRO_PANIC → exit(1)
            self.emitPanicExit();
        } else if op == 120 {                   // #1281: IRO_THROW → exit(1)
            // Fangen kann ihn hier niemand: try/catch weist ir_lower fuer
            // dieses Ziel ab. Ein unbehandelter throw beendet das Programm mit
            // 1 — dasselbe, was der x86-Pfad ohne installierten Handler tut.
            // Vorher fiel der Opcode durch und der throw war ein No-op.
            self.emitPanicExit();
        } else if op == 158 || op == 159 || op == 160 {  // ASSERT_NOT_NULL/NOT_ZERO/TRUE: src1==0 → panic
            self.emitMovRaxFromSlot(src1);
            self.emit8(0x48); self.emit8(0x85); self.emit8(0xC0);   // test rax, rax
            self.emit8(0x75); self.emit8(12);                       // jnz +12 (über Panic-Exit)
            self.emitPanicExit();
        } else if op == 157 {                   // ASSERT_BOUNDS: src1=idx, src2=len; idx>=len(uns) → panic
            self.emitMovRaxFromSlot(src1);
            self.emitMovRcxFromSlot(src2);
            self.emit8(0x48); self.emit8(0x39); self.emit8(0xC8);   // cmp rax, rcx
            self.emit8(0x72); self.emit8(12);                       // jb +12 (idx<len ok)
            self.emitPanicExit();
        } else if op == 166 {                   // IRO_FUNC_ADDR (dest, src1=funcId) — A1 fn-ptr-Wert
            self.emitFuncAddr(src1, dest);
        } else if op == 167 {                    // IRO_ASM (imm=asmId) — WSP-05 inline-asm-Bytes
            if      imm == 0  { self.emit8(0xFA); }                                     // cli
            else if imm == 1  { self.emit8(0xFB); }                                     // sti
            else if imm == 2  { self.emit8(0xF4); }                                     // hlt
            else if imm == 3  { self.emit8(0x90); }                                     // nop
            else if imm == 4  { self.emit8(0xF3); self.emit8(0x90); }                   // pause
            else if imm == 5  { self.emit8(0x0F); self.emit8(0xA2); }                   // cpuid
            else if imm == 6  { self.emit8(0x48); self.emit8(0xCF); }                   // iretq
            else if imm == 7  { self.emit8(0x0F); self.emit8(0x09); }                   // wbinvd
            else if imm == 8  { self.emit8(0x0F); self.emit8(0x08); }                   // invd
            else if imm == 9  { self.emit8(0x0F); self.emit8(0xAE); self.emit8(0xF8); } // sfence
            else if imm == 10 { self.emit8(0x0F); self.emit8(0xAE); self.emit8(0xE8); } // lfence
            else if imm == 11 { self.emit8(0x0F); self.emit8(0xAE); self.emit8(0xF0); } // mfence
            else if imm == 12 { self.emit8(0x0F); self.emit8(0x31); }                   // rdtsc
            else if imm == 13 { self.emit8(0x0F); self.emit8(0x0B); }                   // ud2
            else if imm == 14 { self.emit8(0xCC); }                                     // int3
            else if imm == 15 { self.emit8(0xC9); }                                     // leave
            else if imm == 16 { self.emit8(0xC3); }                                     // ret
            else if imm == 17 { self.emit8(0x0F); self.emit8(0x01); self.emit8(0x17); } // lgdt [rdi]
            else if imm == 18 { self.emit8(0x0F); self.emit8(0x01); self.emit8(0x1F); } // lidt [rdi]
            else if imm == 19 { self.emit8(0x0F); self.emit8(0x01); self.emit8(0x3F); } // invlpg [rdi]
        } else if op == 85 {                    // IRO_CALL_INDIRECT (src1=fnPtr-slot, imm=argCount)
            self.emitCallIndirect(src1, imm, dest);
        } else if op == 84 {                    // IRO_CALL_EXTERN: auf lyxos kein Linkage → dest=0
            self.emit8(0x31); self.emit8(0xC0);                     // xor eax, eax
            self.emitMovSlotFromRax(dest);
        } else if op == 115 || op == 116 {      // IRO_POOL_ALLOC/FREE: Platzhalter (keine Operanden) → no-op
            self.emit8(0x90);                                       // nop (bewusst kein Pool-Allokator)
        // WP-OPCODE-REST: weitere bisher INT3-fallende Ops.
        } else if op == 63 {                    // IRO_LOAD_LOCAL_ADDR (dest, src1=slot) — &local
            self.emitLeaRaxFromSlot(src1);
            self.emitMovSlotFromRax(dest);
        } else if op == 155 {                   // IRO_FSQRT (dest, src1) — f64-Wurzel via xmm0
            self.emitFsqrt(dest, src1);
        } else if op == 20 {                     // IRO_FADD
            self.emitF64BinOp(0x58, dest, src1, src2);
        } else if op == 21 {                     // IRO_FSUB
            self.emitF64BinOp(0x5C, dest, src1, src2);
        } else if op == 22 {                     // IRO_FMUL
            self.emitF64BinOp(0x59, dest, src1, src2);
        } else if op == 23 {                     // IRO_FDIV
            self.emitF64BinOp(0x5E, dest, src1, src2);
        } else if op == 24 {                     // IRO_FNEG
            self.emitFneg(dest, src1);
        } else if op == 73 {                     // IRO_FTOI (f64→int)
            self.emitFtoi(dest, src1);
        } else if op == 74 {                     // IRO_ITOF (int→f64)
            self.emitItof(dest, src1);
        } else if op == 40 {                     // IRO_FCMP_EQ → sete
            self.emitF64Cmp(0x94, dest, src1, src2);
        } else if op == 41 {                     // IRO_FCMP_NEQ → setne
            self.emitF64Cmp(0x95, dest, src1, src2);
        } else if op == 42 {                     // IRO_FCMP_LT → setb (a<b: CF=1)
            self.emitF64Cmp(0x92, dest, src1, src2);
        } else if op == 43 {                     // IRO_FCMP_LE → setbe
            self.emitF64Cmp(0x96, dest, src1, src2);
        } else if op == 44 {                     // IRO_FCMP_GT → seta (a>b: CF=0,ZF=0)
            self.emitF64Cmp(0x97, dest, src1, src2);
        } else if op == 45 {                     // IRO_FCMP_GE → setae
            self.emitF64Cmp(0x93, dest, src1, src2);
        } else if op == 153 || op == 161 || op == 162 || op == 163 {
            // IRO_INSPECT / PROFILE_ENTER/LEAVE/REPORT — Diagnostik: bewusster NOP auf LyxOS
            // (kein Profiling/Introspektion im Kernel-Build). Explizit, nicht stiller Default.
            self.emit8(0x90);                                       // nop
        } else if op == 165 {                     // IRO_SIMD_NEW (dest, src1=count)
            self.emitSimdNew(dest, src1);
        } else if op == 122 {                     // IRO_SIMD_ADD → addps
            self.emitSimdBinOp(0x58, dest, src1, src2);
        } else if op == 123 {                     // IRO_SIMD_SUB → subps
            self.emitSimdBinOp(0x5C, dest, src1, src2);
        } else if op == 124 {                     // IRO_SIMD_MUL → mulps
            self.emitSimdBinOp(0x59, dest, src1, src2);
        } else if op == 125 {                     // IRO_SIMD_DIV → divps
            self.emitSimdBinOp(0x5E, dest, src1, src2);
        } else if op == 136 {                     // IRO_SIMD_LOAD_ELEM (dest, src1=ptr, src2=idx) f32→f64
            self.emitSimdLoadElem(dest, src1, src2);
        } else if op == 137 {                     // IRO_SIMD_STORE_ELEM (dest=idx, src1=val, src2=ptr) f64→f32
            self.emitSimdStoreElem(dest, src1, src2);
        } else if op == 126 {                     // IRO_SIMD_AND → andps
            self.emitSimdBinOp(0x54, dest, src1, src2);
        } else if op == 127 {                     // IRO_SIMD_OR → orps
            self.emitSimdBinOp(0x56, dest, src1, src2);
        } else if op == 128 {                     // IRO_SIMD_XOR → xorps
            self.emitSimdBinOp(0x57, dest, src1, src2);
        } else if op == 129 {                     // IRO_SIMD_NEG → packed Vorzeichenbit-Flip
            self.emitSimdNeg(dest, src1);
        } else if op == 130 {                     // IRO_SIMD_CMP_EQ → cmpps imm 0
            self.emitSimdCmp(0, dest, src1, src2);
        } else if op == 131 {                     // IRO_SIMD_CMP_NE → cmpps imm 4
            self.emitSimdCmp(4, dest, src1, src2);
        } else if op == 132 {                     // IRO_SIMD_CMP_LT → cmpps imm 1
            self.emitSimdCmp(1, dest, src1, src2);
        } else if op == 133 {                     // IRO_SIMD_CMP_LE → cmpps imm 2
            self.emitSimdCmp(2, dest, src1, src2);
        } else if op == 134 {                     // IRO_SIMD_CMP_GT → cmpps imm 6 (NLE)
            self.emitSimdCmp(6, dest, src1, src2);
        } else if op == 135 {                     // IRO_SIMD_CMP_GE → cmpps imm 5 (NLT)
            self.emitSimdCmp(5, dest, src1, src2);
        } else {
            // WP-STUB-00: unbehandelter IR-Opcode → INT3 (lauter Runtime-Trap) statt stilles
            // Falschverhalten. Deckt künftige Lücken sofort auf statt sie zu verschlucken.
            self.emit8(0xCC);                                       // int3
        }
    }

    // Emit all IR functions.
    // Returns byte offset of `main` in the output buffer (for _start CALL).
    fn emitFunctions(): int64 {
        var funcBuf:  int64 := peek64(self.irMod + IR_MOD_OFF_FUNCBUF);
        var funcLen:  int64 := peek64(self.irMod + IR_MOD_OFF_FUNCLEN);
        var strBuf:   int64 := peek64(self.irMod + IR_MOD_OFF_STRBUF);
        var mainOff:  int64 := self.codeLen;   // default: first func

        // LYXOS-call-fix: funcAddrs[funcId] = Code-Offset des Funktions-Starts.
        self.funcCap   := funcLen;
        self.funcAddrs := alloc(funcLen * 8);
        var fz: int64 := 0;
        while fz < funcLen { poke64(self.funcAddrs + fz * 8, 0 - 1); fz := fz + 1; }

        var fi: int64 := 0;
        while fi < funcLen {
            var fBase:       int64 := funcBuf + fi * IR_FUNC_SIZE;
            var fnNameOff:   int64 := peek64(fBase + 0);
            var fnNameLen:   int64 := peek64(fBase + IR_FUNC_OFF_NAMELEN);
            var fnInstrsOff: int64 := peek64(fBase + IR_FUNC_OFF_INSTRSOFF);
            var fnInstrCnt:  int64 := peek64(fBase + IR_FUNC_OFF_INSTRCOUNT);
            var fnLocals:    int64 := peek64(fBase + IR_FUNC_OFF_LOCALCOUNT);
            var fnParams:    int64 := peek64(fBase + IR_FUNC_OFF_PARAMCOUNT);

            // LYXOS-call-fix: Start-Offset dieser Funktion merken (für CALL-rel32-Patch).
            poke64(self.funcAddrs + fi * 8, self.codeLen);

            // Record offset of main()
            if fnNameLen == 4 {
                var p: int64 := strBuf + fnNameOff;
                if peek8(p+0)==109 && peek8(p+1)==97 && peek8(p+2)==105 && peek8(p+3)==110 {
                    mainOff := self.codeLen;
                }
            }

            // INSTRSOFF ist ein Instruktions-INDEX (ir_lower._addFunc speichert
            // funcInstrStart = INSTRLEN-Zähler), kein Byte-Offset — nicht teilen!
            var firstIdx: int64 := fnInstrsOff;
            self.emitPrologue(fnLocals);
            // LYXOS-call-fix: eingehende Arg-Register (System-V) in Param-Slots 0..N-1 spillen,
            // damit LOAD_LOCAL der Parameter den Wert liest.
            var psp: int64 := 0;
            while psp < fnParams {
                if psp < 6 { self.emitMovSlotFromReg(psp, psp); }
                psp := psp + 1;
            }
            var ii: int64 := 0;
            while ii < fnInstrCnt {
                self.emitInstr(firstIdx + ii);
                ii := ii + 1;
            }
            // Return value already in rax from last instruction (LOAD_LOCAL/FUNC_EXIT)
            self.emitEpilogue();

            fi := fi + 1;
        }
        // LYXOS-WP-2: alle JMP/BR rel32 auf Label-Offsets patchen.
        self.applyJmpPatches();
        // LYXOS-call-fix: alle CALL rel32 auf Funktions-Offsets patchen.
        self.applyCallPatches();
        return mainOff;
    }

    pub fn getCodeBuf(): int64 { return self.codeBuf; }
    pub fn getCodeLen(): int64 { return self.codeLen; }

    // LYXOS-WP-5: Sektions-Byte-Größen (.text/.rodata/.data) für SECTION_MAP + Genesis-Counts.
    pub fn getTextLen(): int64   { return self.rodataBase; }
    pub fn getRodataLen(): int64 { return self.globalsBase - self.rodataBase; }
    pub fn getDataLen(): int64   { return self.codeLen - self.globalsBase; }

    // ------------------------------------------------------------------
    // #1715: allgemeine Builtin-IDs 3, 13, 14, 15.
    //
    // Die IDs sind ein globaler Namensraum ueber alle Backends
    // (src/backend/_builtin_ids.md). Bis hierher kannte dieses Backend nur
    // 1, 2 und den Syscall-Bereich 20 … 256; alles dazwischen lief in die
    // Bremse am Ende von emitBuiltinCall. Damit brach jeder stdlib-Import,
    // denn schon std/alloc.lyx meldet seine Fehler mit EPrintStr (ID 13).
    //
    // Die Methoden stehen am ENDE der Klasse, weil neue Eintraege sonst die
    // VMT verschieben und der Seed bricht — dieselbe Falle wie bei IRLower.
    // ------------------------------------------------------------------

    // ID 3: Exit(code) — Code steht in Slot 0. emitSysExitGroup nimmt ein
    // Immediate und passt hier deshalb nicht.
    fn emitExitFromSlot(): void {
        self.emitMovRaxImm(60);              // rax = 60 (sys_exit, Linux-kompatibel)
        self.emitMovRdiFromSlot(0);          // rdi = Exit-Code aus Slot 0
        self.emitSyscall();
    }

    // ID 13: write(2, slot0, strlen(slot0)) fuer EPrintStr/EPrintStrLn/EPrint.
    // Laut _builtin_ids.md rechnet das Backend die Laenge selbst — es gibt
    // hier also keinen Laengen-Slot, anders als bei ID 1.
    fn emitEPrintStr(): void {
        self.emitMovRsiFromSlot(0);                              // rsi = ptr
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xD2);    // XOR rdx, rdx
        // strlen: bis zum Nullbyte zaehlen (wie im Sentinel-Zweig von emitPrintStr)
        self.emit8(0x80); self.emit8(0x3C); self.emit8(0x16); self.emit8(0x00);  // loop: CMP byte[rsi+rdx],0
        self.emit8(0x74); self.emit8(0x05);                      // JE fertig (+5)
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC2);    // INC rdx
        self.emit8(0xEB); self.emit8(0xF5);                      // JMP loop (-11)
        // fertig:
        self.emit8(0xBF); self.emit32(2);                        // mov edi, 2 (stderr)
        self.emitMovRaxImm(0x0203);
        self.emitSyscall();
    }

    // ID 14: einzelner Zeilenumbruch nach stderr. Das Byte liegt auf dem
    // Stapel — der Codepuffer hat keine Stelle, auf die zur Laufzeit gezeigt
    // werden koennte, ohne eine Relokation zu erfinden.
    fn emitEPrintNewline(): void {
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xEC); self.emit8(0x08);  // SUB rsp, 8
        self.emit8(0xC6); self.emit8(0x04); self.emit8(0x24); self.emit8(10);    // MOV byte [rsp], 10
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xE6);                    // MOV rsi, rsp
        self.emit8(0xBA); self.emit32(1);                                        // mov edx, 1
        self.emit8(0xBF); self.emit32(2);                                        // mov edi, 2 (stderr)
        self.emitMovRaxImm(0x0203);
        self.emitSyscall();
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC4); self.emit8(0x08);  // ADD rsp, 8
    }

    // ID 9 (#1720): PrintFloat — f64 nach stdout.
    //
    // Der Ziffernpfad ist aus dem x86-Formatierer portiert (_lyx_f64_to_str,
    // WP-BI-04). Format: [-]<ganzzahliger Teil>.<sechs Nachkommastellen>.
    //
    // Zwei Abweichungen vom Original, beide notwendig:
    //   * Der Puffer kommt aus mmap statt aus CG_FLOAT_BUF. Dieses Backend
    //     hat keinen RIP-relativen Datenbereich fuer Kratzpuffer, und ein
    //     Stapelpuffer wuerde den Aufruf nicht ueberleben.
    //   * Der `ret` entfaellt — hier wird eingebettet, nicht gerufen.
    // Ausgetauscht sind NUR die erste und die letzte Anweisung des Rumpfes.
    // Alles dazwischen bleibt unveraendert, damit die fest kodierten
    // Sprungweiten des Originals gueltig bleiben; eine andere Befehlslaenge
    // im Rumpf haette jeden Sprung darin verschoben.
    //
    // #1284: Vorschalter gegen NaN, unendlich und Werte, die `cvttsd2si`
    // nicht traegt. Ohne ihn druckt der Ziffernpfad dafuer
    // 9223372036854775808.<Muell> — eine Zahl, die nie gerechnet wurde.
    //
    // Alle Spruenge des Vorschalters sind rel32 und werden NACHGETRAGEN.
    // Von Hand gerechnete Weiten waeren hier die dritte Auflage derselben
    // Fehlerquelle: die Ziele liegen hinter einem Rumpf, dessen Laenge man
    // nicht im Kopf hat.
    fn emitF64ToStrPtr(): void {
        self.emit8(0x41); self.emit8(0x54);                    // PUSH r12
        // Puffer aus mmap(0, 48, PROT_RW=3, MAP_PRIVATE|ANON=5)
        self.emitMovRaxImm(9);
        self.emit8(0x31); self.emit8(0xFF);                    // XOR edi, edi
        self.emit8(0xBE); self.emit32(48);                     // MOV esi, 48
        self.emit8(0xBA); self.emit32(3);                      // MOV edx, 3
        self.emit8(0x41); self.emit8(0xBA); self.emit32(5);    // MOV r10d, 5
        self.emitSyscall();
        self.emit8(0x49); self.emit8(0x89); self.emit8(0xD4);  // MOV r12, rdx

        self.emitMovRdiFromSlot(0);                            // rdi = IEEE-754-Bits

        // Sonderfaelle an den Bits erkennen: nach dem Verdoppeln faellt das
        // Vorzeichen heraus; unendlich liegt bei 0xFFE0000000000000, alles
        // darueber ist NaN.
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xF8);  // MOV rax, rdi
        self.emit8(0x48); self.emit8(0x01); self.emit8(0xC0);  // ADD rax, rax
        self.emit8(0x48); self.emit8(0xB9);                    // MOVABS rcx, 0xFFE0000000000000
        self.emit8(0x00); self.emit8(0x00); self.emit8(0x00); self.emit8(0x00);
        self.emit8(0x00); self.emit8(0x00); self.emit8(0xE0); self.emit8(0xFF);
        self.emit8(0x48); self.emit8(0x39); self.emit8(0xC8);  // CMP rax, rcx
        self.emit8(0x0F); self.emit8(0x87);                    // JA rel32 -> nan
        var jNan: int64 := self.codeLen; self.emit32(0);
        self.emit8(0x0F); self.emit8(0x84);                    // JE rel32 -> inf
        var jInf: int64 := self.codeLen; self.emit32(0);

        // Endlich, aber traegt cvttsd2si den Wert? 0x8000000000000000 ist die
        // Kennzeichnung "passt nicht".
        self.emit8(0x66); self.emit8(0x48); self.emit8(0x0F); self.emit8(0x6E); self.emit8(0xC7);  // MOVQ xmm0, rdi
        self.emit8(0xF2); self.emit8(0x48); self.emit8(0x0F); self.emit8(0x2C); self.emit8(0xF0);  // CVTTSD2SI rsi, xmm0
        self.emit8(0x48); self.emit8(0xB9);                    // MOVABS rcx, 0x8000000000000000
        self.emit8(0x00); self.emit8(0x00); self.emit8(0x00); self.emit8(0x00);
        self.emit8(0x00); self.emit8(0x00); self.emit8(0x00); self.emit8(0x80);
        self.emit8(0x48); self.emit8(0x39); self.emit8(0xCE);  // CMP rsi, rcx
        self.emit8(0x0F); self.emit8(0x84);                    // JE rel32 -> gross
        var jBig: int64 := self.codeLen; self.emit32(0);
        self.emit8(0xE9);                                      // JMP rel32 -> ziffern
        var jZif: int64 := self.codeLen; self.emit32(0);

        // nan:
        var lNan: int64 := self.codeLen;
        self.emit8(0x41); self.emit8(0xC7); self.emit8(0x04); self.emit8(0x24);
        self.emit8(0x6E); self.emit8(0x61); self.emit8(0x6E); self.emit8(0x00);   // MOV dword [r12], 'nan',0
        self.emit8(0xE9); var eNan: int64 := self.codeLen; self.emit32(0);        // JMP -> ende

        // inf:
        var lInf: int64 := self.codeLen;
        self.emit8(0x41); self.emit8(0xC7); self.emit8(0x04); self.emit8(0x24);
        self.emit8(0x69); self.emit8(0x6E); self.emit8(0x66); self.emit8(0x00);   // MOV dword [r12], 'inf',0
        self.emit8(0xE9); var eInf: int64 := self.codeLen; self.emit32(0);        // JMP -> ende

        // gross: "overflow". Eine erfundene Zahl waere das Schlechtere; wer
        // grosse Werte braucht, nimmt FloatToStr(v, prec) mit Exponent.
        var lBig: int64 := self.codeLen;
        self.emit8(0x41); self.emit8(0xC7); self.emit8(0x04); self.emit8(0x24);
        self.emit8(0x6F); self.emit8(0x76); self.emit8(0x65); self.emit8(0x72);   // "over"
        self.emit8(0x41); self.emit8(0xC7); self.emit8(0x44); self.emit8(0x24); self.emit8(0x04);
        self.emit8(0x66); self.emit8(0x6C); self.emit8(0x6F); self.emit8(0x77);   // "flow"
        self.emit8(0x41); self.emit8(0xC6); self.emit8(0x44); self.emit8(0x24); self.emit8(0x08); self.emit8(0x00);  // 0
        self.emit8(0xE9); var eBig: int64 := self.codeLen; self.emit32(0);        // JMP -> ende

        // ziffern:
        var lZif: int64 := self.codeLen;
        self.emit8(0x66); self.emit8(0x48); self.emit8(0x0F); self.emit8(0x6E); self.emit8(0xC7);
        // push rbx                53
        self.emit8(0x53);
        // sub rsp, 24             48 83 EC 18
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xEC); self.emit8(0x18);
        // lea rdi, [rip+CG_FLOAT_BUF]   48 8D 3D disp32
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xE7);  // MOV rdi, r12 — Puffer statt RIP-relativem CG_FLOAT_BUF
        // pxor xmm1, xmm1         66 0F EF C9
        self.emit8(0x66); self.emit8(0x0F); self.emit8(0xEF); self.emit8(0xC9);
        // ucomisd xmm0, xmm1      66 0F 2E C1
        self.emit8(0x66); self.emit8(0x0F); self.emit8(0x2E); self.emit8(0xC1);
        // jae .pos (+18)          73 12
        self.emit8(0x73); self.emit8(0x12);
        // [negative branch: 18 bytes]
        // mov byte [rdi], '-'     C6 07 2D
        self.emit8(0xC6); self.emit8(0x07); self.emit8(0x2D);
        // inc rdi                 48 FF C7
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC7);
        // pxor xmm1, xmm1         66 0F EF C9
        self.emit8(0x66); self.emit8(0x0F); self.emit8(0xEF); self.emit8(0xC9);
        // subsd xmm1, xmm0        F2 0F 5C C8   (xmm1 = 0.0 - xmm0)
        self.emit8(0xF2); self.emit8(0x0F); self.emit8(0x5C); self.emit8(0xC8);
        // movsd xmm0, xmm1        F2 0F 10 C1
        self.emit8(0xF2); self.emit8(0x0F); self.emit8(0x10); self.emit8(0xC1);
        // [.pos: jae target — 40 bytes from start]
        // cvttsd2si rsi, xmm0     F2 48 0F 2C F0
        self.emit8(0xF2); self.emit8(0x48); self.emit8(0x0F); self.emit8(0x2C); self.emit8(0xF0);
        // cvtsi2sd xmm1, rsi      F2 48 0F 2A CE
        self.emit8(0xF2); self.emit8(0x48); self.emit8(0x0F); self.emit8(0x2A); self.emit8(0xCE);
        // subsd xmm0, xmm1        F2 0F 5C C1   (frac = f - intpart)
        self.emit8(0xF2); self.emit8(0x0F); self.emit8(0x5C); self.emit8(0xC1);
        // lea rbx, [rsp+23]       48 8D 5C 24 17
        self.emit8(0x48); self.emit8(0x8D); self.emit8(0x5C); self.emit8(0x24); self.emit8(0x17);
        // test rsi, rsi           48 85 F6
        self.emit8(0x48); self.emit8(0x85); self.emit8(0xF6);
        // jnz .intloop (+8)       75 08
        self.emit8(0x75); self.emit8(0x08);
        // [zero case: write '0']
        // mov byte [rbx], '0'     C6 03 30
        self.emit8(0xC6); self.emit8(0x03); self.emit8(0x30);
        // dec rbx                 48 FF CB
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xCB);
        // jmp .intdone (+35)      EB 23
        self.emit8(0xEB); self.emit8(0x23);
        // [.intloop: — 72 bytes from start]
        // test rsi, rsi           48 85 F6
        self.emit8(0x48); self.emit8(0x85); self.emit8(0xF6);
        // jz .intdone (+30)       74 1E
        self.emit8(0x74); self.emit8(0x1E);
        // mov rax, rsi            48 89 F0
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xF0);
        // xor rdx, rdx            48 31 D2
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xD2);
        // mov rcx, 10             48 C7 C1 0A 00 00 00
        self.emit8(0x48); self.emit8(0xC7); self.emit8(0xC1);
        self.emit8(0x0A); self.emit8(0x00); self.emit8(0x00); self.emit8(0x00);
        // idiv rcx                48 F7 F9
        self.emit8(0x48); self.emit8(0xF7); self.emit8(0xF9);
        // mov rsi, rax            48 89 C6
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xC6);
        // add rdx, 48             48 83 C2 30
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC2); self.emit8(0x30);
        // mov [rbx], dl           88 13
        self.emit8(0x88); self.emit8(0x13);
        // dec rbx                 48 FF CB
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xCB);
        // jmp .intloop (-37)      EB DD
        self.emit8(0xEB); self.emit8(0xDD);
        // [.intdone: — 107 bytes from start]
        // inc rbx                 48 FF C3
        // lea rcx, [rsp+24]       48 8D 4C 24 18  (one past end of stack buf)
        self.emit8(0x48); self.emit8(0x8D); self.emit8(0x4C); self.emit8(0x24); self.emit8(0x18);
        // [.copyint: — 115 bytes from start]
        // cmp rbx, rcx            48 39 CB
        self.emit8(0x48); self.emit8(0x39); self.emit8(0xCB);
        // jge .copyidone (+12)    7D 0C
        self.emit8(0x7D); self.emit8(0x0C);
        // mov al, [rbx]           8A 03
        self.emit8(0x8A); self.emit8(0x03);
        // mov [rdi], al           88 07
        self.emit8(0x88); self.emit8(0x07);
        // inc rbx                 48 FF C3
        // inc rdi                 48 FF C7
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC7);
        // jmp .copyint (-17)      EB EF
        self.emit8(0xEB); self.emit8(0xEF);
        // [.copyidone: — 132 bytes from start]
        // mov byte [rdi], '.'     C6 07 2E
        self.emit8(0xC6); self.emit8(0x07); self.emit8(0x2E);
        // inc rdi                 48 FF C7
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC7);
        // movabs rax, 1000000.0   48 B8 00 00 00 00 80 84 2E 41  (0x412E848000000000)
        self.emit8(0x48); self.emit8(0xB8);
        self.emit8(0x00); self.emit8(0x00); self.emit8(0x00); self.emit8(0x00);
        self.emit8(0x80); self.emit8(0x84); self.emit8(0x2E); self.emit8(0x41);
        // movq xmm1, rax          66 48 0F 6E C8
        self.emit8(0x66); self.emit8(0x48); self.emit8(0x0F); self.emit8(0x6E); self.emit8(0xC8);
        // mulsd xmm0, xmm1        F2 0F 59 C1
        self.emit8(0xF2); self.emit8(0x0F); self.emit8(0x59); self.emit8(0xC1);
        // cvttsd2si rsi, xmm0     F2 48 0F 2C F0  (6-digit integer)
        self.emit8(0xF2); self.emit8(0x48); self.emit8(0x0F); self.emit8(0x2C); self.emit8(0xF0);
        // --- fraction digit 1: power=100000 ---
        // mov rcx, 100000         48 C7 C1 A0 86 01 00
        self.emit8(0x48); self.emit8(0xC7); self.emit8(0xC1);
        self.emit8(0xA0); self.emit8(0x86); self.emit8(0x01); self.emit8(0x00);
        // mov rax, rsi            48 89 F0
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xF0);
        // xor rdx, rdx            48 31 D2
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xD2);
        // idiv rcx                48 F7 F9
        self.emit8(0x48); self.emit8(0xF7); self.emit8(0xF9);
        // mov rsi, rdx            48 89 D6
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xD6);
        // add rax, 48             48 83 C0 30
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC0); self.emit8(0x30);
        // mov [rdi], al           88 07
        self.emit8(0x88); self.emit8(0x07);
        // inc rdi                 48 FF C7
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC7);
        // --- fraction digit 2: power=10000 ---
        // mov rcx, 10000          48 C7 C1 10 27 00 00
        self.emit8(0x48); self.emit8(0xC7); self.emit8(0xC1);
        self.emit8(0x10); self.emit8(0x27); self.emit8(0x00); self.emit8(0x00);
        // mov rax, rsi            48 89 F0
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xF0);
        // xor rdx, rdx            48 31 D2
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xD2);
        // idiv rcx                48 F7 F9
        self.emit8(0x48); self.emit8(0xF7); self.emit8(0xF9);
        // mov rsi, rdx            48 89 D6
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xD6);
        // add rax, 48             48 83 C0 30
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC0); self.emit8(0x30);
        // mov [rdi], al           88 07
        self.emit8(0x88); self.emit8(0x07);
        // inc rdi                 48 FF C7
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC7);
        // --- fraction digit 3: power=1000 ---
        // mov rcx, 1000           48 C7 C1 E8 03 00 00
        self.emit8(0x48); self.emit8(0xC7); self.emit8(0xC1);
        self.emit8(0xE8); self.emit8(0x03); self.emit8(0x00); self.emit8(0x00);
        // mov rax, rsi            48 89 F0
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xF0);
        // xor rdx, rdx            48 31 D2
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xD2);
        // idiv rcx                48 F7 F9
        self.emit8(0x48); self.emit8(0xF7); self.emit8(0xF9);
        // mov rsi, rdx            48 89 D6
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xD6);
        // add rax, 48             48 83 C0 30
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC0); self.emit8(0x30);
        // mov [rdi], al           88 07
        self.emit8(0x88); self.emit8(0x07);
        // inc rdi                 48 FF C7
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC7);
        // --- fraction digit 4: power=100 ---
        // mov rcx, 100            48 C7 C1 64 00 00 00
        self.emit8(0x48); self.emit8(0xC7); self.emit8(0xC1);
        self.emit8(0x64); self.emit8(0x00); self.emit8(0x00); self.emit8(0x00);
        // mov rax, rsi            48 89 F0
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xF0);
        // xor rdx, rdx            48 31 D2
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xD2);
        // idiv rcx                48 F7 F9
        self.emit8(0x48); self.emit8(0xF7); self.emit8(0xF9);
        // mov rsi, rdx            48 89 D6
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xD6);
        // add rax, 48             48 83 C0 30
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC0); self.emit8(0x30);
        // mov [rdi], al           88 07
        self.emit8(0x88); self.emit8(0x07);
        // inc rdi                 48 FF C7
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC7);
        // --- fraction digit 5: power=10 ---
        // mov rcx, 10             48 C7 C1 0A 00 00 00
        self.emit8(0x48); self.emit8(0xC7); self.emit8(0xC1);
        self.emit8(0x0A); self.emit8(0x00); self.emit8(0x00); self.emit8(0x00);
        // mov rax, rsi            48 89 F0
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xF0);
        // xor rdx, rdx            48 31 D2
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xD2);
        // idiv rcx                48 F7 F9
        self.emit8(0x48); self.emit8(0xF7); self.emit8(0xF9);
        // mov rsi, rdx            48 89 D6
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xD6);
        // add rax, 48             48 83 C0 30
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC0); self.emit8(0x30);
        // mov [rdi], al           88 07
        self.emit8(0x88); self.emit8(0x07);
        // inc rdi                 48 FF C7
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC7);
        // --- fraction digit 6: rsi has last digit (no division needed) ---
        // mov rax, rsi            48 89 F0
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xF0);
        // add rax, 48             48 83 C0 30
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC0); self.emit8(0x30);
        // mov [rdi], al           88 07
        self.emit8(0x88); self.emit8(0x07);
        // inc rdi                 48 FF C7
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC7);
        // null terminate
        // mov byte [rdi], 0       C6 07 00
        self.emit8(0xC6); self.emit8(0x07); self.emit8(0x00);
        // lea rax, [rip+CG_FLOAT_BUF]   48 8D 05 disp32
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xE0);  // MOV rax, r12 — Ergebniszeiger
        // add rsp, 24             48 83 C4 18
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC4); self.emit8(0x18);
        // pop rbx                 5B
        self.emit8(0x5B);
        // ret                     C3
        // ende:
        var lEnde: int64 := self.codeLen;
        self.emit8(0x41); self.emit8(0x5C);                    // POP r12

        // Spruenge nachtragen — Ziel minus Ende des jeweiligen Sprungfeldes.
        self.patch32(jNan, lNan - (jNan + 4));
        self.patch32(jInf, lInf - (jInf + 4));
        self.patch32(jBig, lBig - (jBig + 4));
        self.patch32(jZif, lZif - (jZif + 4));
        self.patch32(eNan, lEnde - (eNan + 4));
        self.patch32(eInf, lEnde - (eInf + 4));
        self.patch32(eBig, lEnde - (eBig + 4));
    }

    // ID 9: PrintFloat — Text erzeugen, dann nach stdout schreiben.
    fn emitPrintFloat(): void {
        self.emitF64ToStrPtr();                                // rax = Zeiger
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xC6);  // MOV rsi, rax
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xD2);  // XOR rdx, rdx
        self.emit8(0x80); self.emit8(0x3C); self.emit8(0x16); self.emit8(0x00);  // schleife: CMP byte[rsi+rdx],0
        self.emit8(0x74); self.emit8(0x05);                    // JE fertig (+5)
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC2);  // INC rdx
        self.emit8(0xEB); self.emit8(0xF5);                    // JMP schleife (-11)
        // fertig:
        self.emit8(0xBF); self.emit32(1);                      // MOV edi, 1 (stdout)
        self.emitMovRaxImm(0x0203);
        self.emitSyscall();
    }

    // ID 17/18 (#1720): GetArgC / GetArgV.
    //
    // Auf diesem Ziel gibt es keine Programmargumente: `_start` ruft main und
    // beendet, es liest keinen Stapel-argv. Beide liefern deshalb 0 — dieselbe
    // Aussage, die die Handbuchseite fuer das freistehende Ziel trifft
    // ("GetArgC und GetArgV liefern 0 — argc und argv gibt es auf blankem
    // Blech nicht").
    //
    // Das steht hier im BACKEND und nicht im Lowerer, weil es eine Aussage
    // ueber dieses Ziel ist. Auf arm64-Linux gibt es sehr wohl Argumente; ein
    // festes 0 im Lowerer waere dort schlicht falsch. Reicht der LBF-Loader
    // spaeter Argumente durch, aendert sich genau diese Stelle.
    fn emitNullArg(dest: int64): void {
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xC0);  // XOR rax, rax
        self.emitMovSlotFromRax(dest);
    }

    // ID 300/301/302 (#1720): fFloor / fCeil / fRound.
    //
    // Sie brauchen `roundsd` (SSE4.1) und liessen sich deshalb nicht wie die
    // uebrigen zwoelf Gleitkomma-Namen auf vorhandene IR-Opcodes abbilden.
    // Der x86-Weg benutzt denselben Befehl, die Voraussetzung ist also nicht
    // neu.
    //
    // Die Nummern liegen OBERHALB des Syscall-Bereichs: der allgemeine
    // Bereich 1…19 ist seit #1728 voll, und eine bestehende ID doppelt zu
    // belegen war 2026 der Printf/mem_barrier-Fall (#1037) — dort emittierte
    // Printf auf ARM64 stumm eine Speicherbarriere.
    //
    // modus: 1 = abrunden, 2 = aufrunden, 0 = kaufmaennisch zur geraden Zahl.
    fn emitRoundSd(dest: int64, modus: int64): void {
        self.emitMovRaxFromSlot(0);
        self.emit8(0x66); self.emit8(0x48); self.emit8(0x0F); self.emit8(0x6E); self.emit8(0xC0);  // MOVQ xmm0, rax
        self.emit8(0x66); self.emit8(0x0F); self.emit8(0x3A); self.emit8(0x0B); self.emit8(0xC0);
        self.emit8(modus);                                                                          // ROUNDSD xmm0, xmm0, modus
        self.emit8(0x66); self.emit8(0x48); self.emit8(0x0F); self.emit8(0x7E); self.emit8(0xC0);  // MOVQ rax, xmm0
        self.emitMovSlotFromRax(dest);
    }

    // ID 309 (#1720 Block B): FileReadAll(path) — ganze Datei in einen
    // frischen Puffer, nullterminiert; 0 bei Fehler.
    //
    // Ablauf wie auf dem x86-Weg: open, seek(ENDE) fuer die Groesse,
    // seek(ANFANG), mmap(groesse+1), read, close. Das Nullbyte am Ende
    // macht das Ergebnis als pchar brauchbar; der mmap-Bereich ist ohnehin
    // genullt, aber verlassen sollte man sich darauf nicht.
    //
    // Auch hier: Syscall-Ergebnis in rdx (nicht rax), Nummern aus §10.4.
    // r12 = fd, r13 = Groesse, r14 = Puffer.
    fn emitFileReadAll(dest: int64): void {
        self.emit8(0x41); self.emit8(0x54);                     // PUSH r12
        self.emit8(0x41); self.emit8(0x55);                     // PUSH r13
        self.emit8(0x41); self.emit8(0x56);                     // PUSH r14
        // open(path, 0, 0)
        self.emitMovRaxImm(2);
        self.emitMovRdiFromSlot(0);
        self.emit8(0x31); self.emit8(0xF6);                     // XOR esi, esi
        self.emit8(0x31); self.emit8(0xD2);                     // XOR edx, edx
        self.emitSyscall();
        self.emit8(0x49); self.emit8(0x89); self.emit8(0xD4);   // MOV r12, rdx
        self.emit8(0x4D); self.emit8(0x85); self.emit8(0xE4);   // TEST r12, r12
        self.emit8(0x0F); self.emit8(0x88); var jFehler: int64 := self.codeLen; self.emit32(0);  // JS
        // seek(fd, 0, SEEK_END) -> Groesse
        self.emitMovRaxImm(0x0204);
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xE7);   // MOV rdi, r12
        self.emit8(0x31); self.emit8(0xF6);                     // XOR esi, esi
        self.emit8(0xBA); self.emit32(2);                       // MOV edx, 2
        self.emitSyscall();
        self.emit8(0x49); self.emit8(0x89); self.emit8(0xD5);   // MOV r13, rdx
        // seek(fd, 0, SEEK_SET)
        self.emitMovRaxImm(0x0204);
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xE7);   // MOV rdi, r12
        self.emit8(0x31); self.emit8(0xF6);                     // XOR esi, esi
        self.emit8(0x31); self.emit8(0xD2);                     // XOR edx, edx
        self.emitSyscall();
        // mmap(0, groesse+1, PROT_RW, MAP_PRIVATE|ANON)
        self.emitMovRaxImm(9);
        self.emit8(0x31); self.emit8(0xFF);                     // XOR edi, edi
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xEE);   // MOV rsi, r13
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC6);   // INC rsi
        self.emit8(0xBA); self.emit32(3);                       // MOV edx, 3
        self.emit8(0x41); self.emit8(0xBA); self.emit32(5);     // MOV r10d, 5
        self.emitSyscall();
        self.emit8(0x49); self.emit8(0x89); self.emit8(0xD6);   // MOV r14, rdx  (Puffer)
        // read(fd, puffer, groesse)
        self.emitMovRaxImm(0);
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xE7);   // MOV rdi, r12
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xF6);   // MOV rsi, r14
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xEA);   // MOV rdx, r13
        self.emitSyscall();
        // Nullbyte hinter die gelesenen Daten
        self.emit8(0x4B); self.emit8(0xC6); self.emit8(0x04); self.emit8(0x2E); self.emit8(0x00);  // MOV byte [r14+r13], 0
        // close(fd)
        self.emitMovRaxImm(3);
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xE7);   // MOV rdi, r12
        self.emitSyscall();
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xF0);   // MOV rax, r14
        self.emit8(0xE9); var jEnde: int64 := self.codeLen; self.emit32(0);
        var lFehler: int64 := self.codeLen;
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xC0);   // XOR rax, rax
        var lEnde: int64 := self.codeLen;
        self.emit8(0x41); self.emit8(0x5E);                     // POP r14
        self.emit8(0x41); self.emit8(0x5D);                     // POP r13
        self.emit8(0x41); self.emit8(0x5C);                     // POP r12
        self.patch32(jFehler, lFehler - (jFehler + 4));
        self.patch32(jEnde,   lEnde   - (jEnde + 4));
        self.emitMovSlotFromRax(dest);
    }

    // ID 308 (#1720 Block B): StrFind(heuhaufen, nadel) — Index oder -1.
    //
    // Naive Suche, wie auf dem x86-Weg. Leere Nadel liefert 0 (jede Kette
    // enthaelt die leere Kette am Anfang) — dieser Fall zuerst, sonst
    // liefe die innere Schleife sofort auf das Nullbyte und meldete
    // faelschlich einen Treffer an jeder Stelle.
    //
    // rdi = heuhaufen, rsi = nadel, r12 = i (aeusserer Index),
    // r13 = j (innerer Index). Alle Spruenge rel32 mit Nachtrag.
    fn emitStrFind(dest: int64): void {
        self.emit8(0x41); self.emit8(0x54);                     // PUSH r12
        self.emit8(0x41); self.emit8(0x55);                     // PUSH r13
        self.emitMovRdiFromSlot(0);
        self.emitMovRsiFromSlot(1);

        // leere Nadel -> 0
        self.emit8(0x80); self.emit8(0x3E); self.emit8(0x00);   // CMP byte [rsi], 0
        self.emit8(0x0F); self.emit8(0x84); var jLeer: int64 := self.codeLen; self.emit32(0);

        self.emit8(0x4D); self.emit8(0x31); self.emit8(0xE4);   // XOR r12, r12   (i = 0)
        var lAussen: int64 := self.codeLen;
        // Ende des Heuhaufens? [rdi+i] == 0 -> nicht gefunden
        self.emit8(0x42); self.emit8(0x80); self.emit8(0x3C); self.emit8(0x27); self.emit8(0x00);  // CMP byte [rdi+r12], 0
        self.emit8(0x0F); self.emit8(0x84); var jNichts: int64 := self.codeLen; self.emit32(0);
        self.emit8(0x4D); self.emit8(0x31); self.emit8(0xED);   // XOR r13, r13   (j = 0)
        var lInnen: int64 := self.codeLen;
        // Nadel zu Ende? -> Treffer bei i
        self.emit8(0x43); self.emit8(0x80); self.emit8(0x3C); self.emit8(0x2E); self.emit8(0x00);  // CMP byte [rsi+r13], 0
        self.emit8(0x0F); self.emit8(0x84); var jTreffer: int64 := self.codeLen; self.emit32(0);
        // Zeichen vergleichen: [rdi+i+j] gegen [rsi+j]
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xE0);   // MOV rax, r12
        self.emit8(0x4C); self.emit8(0x01); self.emit8(0xE8);   // ADD rax, r13
        self.emit8(0x8A); self.emit8(0x04); self.emit8(0x07);   // MOV al, [rdi+rax]
        self.emit8(0x43); self.emit8(0x3A); self.emit8(0x04); self.emit8(0x2E);  // CMP al, [rsi+r13]
        self.emit8(0x0F); self.emit8(0x85); var jWeiter: int64 := self.codeLen; self.emit32(0);
        self.emit8(0x49); self.emit8(0xFF); self.emit8(0xC5);   // INC r13
        self.emit8(0xE9); var jIZur: int64 := self.codeLen; self.emit32(0);
        // weiter: naechste Startposition
        var lWeiter: int64 := self.codeLen;
        self.emit8(0x49); self.emit8(0xFF); self.emit8(0xC4);   // INC r12
        self.emit8(0xE9); var jAZur: int64 := self.codeLen; self.emit32(0);
        // Treffer
        var lTreffer: int64 := self.codeLen;
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xE0);   // MOV rax, r12
        self.emit8(0xE9); var jEnd1: int64 := self.codeLen; self.emit32(0);
        // leere Nadel
        var lLeer: int64 := self.codeLen;
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xC0);   // XOR rax, rax
        self.emit8(0xE9); var jEnd2: int64 := self.codeLen; self.emit32(0);
        // nicht gefunden
        var lNichts: int64 := self.codeLen;
        self.emitMovRaxImm(0 - 1);
        var lEnde: int64 := self.codeLen;
        self.emit8(0x41); self.emit8(0x5D);                     // POP r13
        self.emit8(0x41); self.emit8(0x5C);                     // POP r12

        self.patch32(jLeer,    lLeer    - (jLeer + 4));
        self.patch32(jNichts,  lNichts  - (jNichts + 4));
        self.patch32(jTreffer, lTreffer - (jTreffer + 4));
        self.patch32(jWeiter,  lWeiter  - (jWeiter + 4));
        self.patch32(jIZur,    lInnen   - (jIZur + 4));
        self.patch32(jAZur,    lAussen  - (jAZur + 4));
        self.patch32(jEnd1,    lEnde    - (jEnd1 + 4));
        self.patch32(jEnd2,    lEnde    - (jEnd2 + 4));
        self.emitMovSlotFromRax(dest);
    }

    // ID 307 (#1720 Block B): StrTrim(s) — Leerraum vorn und hinten weg.
    //
    // Semantik wie auf dem x86-Weg: die Kette wird AN ORT UND STELLE
    // gekuerzt (Nullbyte hinter dem letzten sichtbaren Zeichen) und ein
    // Zeiger hinter den fuehrenden Leerraum zurueckgegeben. Auf ein
    // String-Literal angewandt schreibt das in den Codebereich — genau der
    // Grund fuer die Projektregel, dass Literale keine Schreibpuffer sind.
    //
    // Als Leerraum gelten Leerzeichen, Tabulator, CR und LF (0x20/09/0D/0A).
    // Alle Spruenge sind rel32 und werden nachgetragen.
    fn emitStrTrim(dest: int64): void {
        self.emitMovRdiFromSlot(0);

        // vorn: solange Leerraum, rdi weiterschieben
        var lVorn: int64 := self.codeLen;
        self.emit8(0x0F); self.emit8(0xB6); self.emit8(0x07);   // MOVZX eax, byte [rdi]
        var jV1: int64 := 0; var jV2: int64 := 0; var jV3: int64 := 0; var jV4: int64 := 0;
        self.emit8(0x3C); self.emit8(0x20); self.emit8(0x0F); self.emit8(0x84);
        jV1 := self.codeLen; self.emit32(0);
        self.emit8(0x3C); self.emit8(0x09); self.emit8(0x0F); self.emit8(0x84);
        jV2 := self.codeLen; self.emit32(0);
        self.emit8(0x3C); self.emit8(0x0D); self.emit8(0x0F); self.emit8(0x84);
        jV3 := self.codeLen; self.emit32(0);
        self.emit8(0x3C); self.emit8(0x0A); self.emit8(0x0F); self.emit8(0x84);
        jV4 := self.codeLen; self.emit32(0);
        self.emit8(0xE9); var jVFertig: int64 := self.codeLen; self.emit32(0);
        var lVorSchritt: int64 := self.codeLen;
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC7);   // INC rdi
        self.emit8(0xE9); var jVZur: int64 := self.codeLen; self.emit32(0);
        var lVorFertig: int64 := self.codeLen;

        // Ende suchen: rsi laeuft bis zum Nullbyte
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xFE);   // MOV rsi, rdi
        var lSuch: int64 := self.codeLen;
        self.emit8(0x80); self.emit8(0x3E); self.emit8(0x00);   // CMP byte [rsi], 0
        self.emit8(0x0F); self.emit8(0x84); var jSFertig: int64 := self.codeLen; self.emit32(0);
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC6);   // INC rsi
        self.emit8(0xE9); var jSZur: int64 := self.codeLen; self.emit32(0);
        var lSuchFertig: int64 := self.codeLen;

        // hinten: solange rsi > rdi und davor Leerraum steht, rsi zurueck
        var lHint: int64 := self.codeLen;
        self.emit8(0x48); self.emit8(0x39); self.emit8(0xFE);   // CMP rsi, rdi
        self.emit8(0x0F); self.emit8(0x86); var jHFertig: int64 := self.codeLen; self.emit32(0);  // JBE
        self.emit8(0x0F); self.emit8(0xB6); self.emit8(0x46); self.emit8(0xFF);  // MOVZX eax, byte [rsi-1]
        var jH1: int64 := 0; var jH2: int64 := 0; var jH3: int64 := 0; var jH4: int64 := 0;
        self.emit8(0x3C); self.emit8(0x20); self.emit8(0x0F); self.emit8(0x84);
        jH1 := self.codeLen; self.emit32(0);
        self.emit8(0x3C); self.emit8(0x09); self.emit8(0x0F); self.emit8(0x84);
        jH2 := self.codeLen; self.emit32(0);
        self.emit8(0x3C); self.emit8(0x0D); self.emit8(0x0F); self.emit8(0x84);
        jH3 := self.codeLen; self.emit32(0);
        self.emit8(0x3C); self.emit8(0x0A); self.emit8(0x0F); self.emit8(0x84);
        jH4 := self.codeLen; self.emit32(0);
        self.emit8(0xE9); var jHRaus: int64 := self.codeLen; self.emit32(0);
        var lHintSchritt: int64 := self.codeLen;
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xCE);   // DEC rsi
        self.emit8(0xE9); var jHZur: int64 := self.codeLen; self.emit32(0);
        var lHintFertig: int64 := self.codeLen;
        self.emit8(0xC6); self.emit8(0x06); self.emit8(0x00);   // MOV byte [rsi], 0
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xF8);   // MOV rax, rdi

        self.patch32(jV1, lVorSchritt - (jV1 + 4));
        self.patch32(jV2, lVorSchritt - (jV2 + 4));
        self.patch32(jV3, lVorSchritt - (jV3 + 4));
        self.patch32(jV4, lVorSchritt - (jV4 + 4));
        self.patch32(jVFertig, lVorFertig - (jVFertig + 4));
        self.patch32(jVZur, lVorn - (jVZur + 4));
        self.patch32(jSFertig, lSuchFertig - (jSFertig + 4));
        self.patch32(jSZur, lSuch - (jSZur + 4));
        self.patch32(jHFertig, lHintFertig - (jHFertig + 4));
        self.patch32(jH1, lHintSchritt - (jH1 + 4));
        self.patch32(jH2, lHintSchritt - (jH2 + 4));
        self.patch32(jH3, lHintSchritt - (jH3 + 4));
        self.patch32(jH4, lHintSchritt - (jH4 + 4));
        self.patch32(jHRaus, lHintFertig - (jHRaus + 4));
        self.patch32(jHZur, lHint - (jHZur + 4));
        self.emitMovSlotFromRax(dest);
    }

    // ID 306 (#1720 Block B): FileSize(path) — Groesse oder -1.
    //
    // Zusammengesetzt aus open + seek(ENDE) + close, wie auf dem x86-Weg.
    // Zwei Eigenheiten dieses Ziels, die man nicht raten darf:
    //   * Der Rueckgabewert eines Syscalls steht in rdx, nicht in rax
    //     (siehe emitVfsSyscall).
    //   * Die Nummern stammen aus syscalls.md §10.4: open=2, seek=0x0204,
    //     close=3 — dieselben, die die Einzel-IDs 20/24/21 benutzen.
    //
    // Der fd wird ueber r12 gerettet: der zweite Syscall clobbert rcx und
    // r11, und rdx traegt jeweils das neue Ergebnis.
    fn emitFileSize(dest: int64): void {
        self.emit8(0x41); self.emit8(0x54);                    // PUSH r12
        self.emit8(0x41); self.emit8(0x55);                    // PUSH r13
        // open(path, O_RDONLY=0, 0)
        self.emitMovRaxImm(2);
        self.emitMovRdiFromSlot(0);                            // rdi = path
        self.emit8(0x31); self.emit8(0xF6);                    // XOR esi, esi
        self.emit8(0x31); self.emit8(0xD2);                    // XOR edx, edx
        self.emitSyscall();
        self.emit8(0x49); self.emit8(0x89); self.emit8(0xD4);  // MOV r12, rdx  (fd)
        self.emit8(0x4D); self.emit8(0x85); self.emit8(0xE4);  // TEST r12, r12
        self.emit8(0x0F); self.emit8(0x88);                    // JS rel32 -> fehler
        var jFehler: int64 := self.codeLen; self.emit32(0);
        // seek(fd, 0, SEEK_END=2)
        self.emitMovRaxImm(0x0204);
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xE7);  // MOV rdi, r12
        self.emit8(0x31); self.emit8(0xF6);                    // XOR esi, esi
        self.emit8(0xBA); self.emit32(2);                      // MOV edx, 2 (SEEK_END)
        self.emitSyscall();
        self.emit8(0x49); self.emit8(0x89); self.emit8(0xD5);  // MOV r13, rdx  (Groesse)
        // close(fd)
        self.emitMovRaxImm(3);
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xE7);  // MOV rdi, r12
        self.emitSyscall();
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xE8);  // MOV rax, r13
        self.emit8(0xE9);                                      // JMP rel32 -> ende
        var jEnde: int64 := self.codeLen; self.emit32(0);
        // fehler: -1
        var lFehler: int64 := self.codeLen;
        self.emitMovRaxImm(0 - 1);
        var lEnde: int64 := self.codeLen;
        self.emit8(0x41); self.emit8(0x5D);                    // POP r13
        self.emit8(0x41); self.emit8(0x5C);                    // POP r12
        self.patch32(jFehler, lFehler - (jFehler + 4));
        self.patch32(jEnde,   lEnde   - (jEnde + 4));
        self.emitMovSlotFromRax(dest);
    }

    // ID 304/305 (#1720 Block B): StrEq/StrEquals und StrStartsWith.
    //
    // Neu geschrieben statt aus dem x86-Weg uebernommen: dort stehen die
    // Sprungweiten als feste rel8-Werte, und die gelten nur fuer genau jene
    // Befehlsfolge. Hier sind alle Spruenge rel32 und werden nachgetragen —
    // eine von Hand gerechnete Weite war in dieser Runde dreimal falsch.
    //
    // Slots: 0 = a, 1 = b. Ergebnis 1 oder 0 nach dest.
    fn emitStrVergleich(dest: int64, nurAnfang: int64): void {
        self.emitMovRdiFromSlot(0);
        self.emitMovRsiFromSlot(1);
        var schleife: int64 := self.codeLen;
        if nurAnfang != 0 {
            // StrStartsWith: ist das Praefix zu Ende, passt es.
            self.emit8(0x8A); self.emit8(0x06);                    // MOV al, [rsi]
            self.emit8(0x84); self.emit8(0xC0);                    // TEST al, al
            self.emit8(0x0F); self.emit8(0x84);                    // JZ rel32 -> ja
            var jJa1: int64 := self.codeLen; self.emit32(0);
            self.emit8(0x3A); self.emit8(0x07);                    // CMP al, [rdi]
            self.emit8(0x0F); self.emit8(0x85);                    // JNE rel32 -> nein
            var jNein1: int64 := self.codeLen; self.emit32(0);
            self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC7);  // INC rdi
            self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC6);  // INC rsi
            self.emit8(0xE9);                                      // JMP rel32 -> schleife
            var jZur1: int64 := self.codeLen; self.emit32(0);
            var lJa1: int64 := self.codeLen;
            self.emit8(0x48); self.emit8(0xC7); self.emit8(0xC0); self.emit32(1);   // MOV rax, 1
            self.emit8(0xE9);                                      // JMP rel32 -> ende
            var jEnd1: int64 := self.codeLen; self.emit32(0);
            var lNein1: int64 := self.codeLen;
            self.emit8(0x48); self.emit8(0x31); self.emit8(0xC0);  // XOR rax, rax
            var lEnde1: int64 := self.codeLen;
            self.patch32(jJa1,   lJa1   - (jJa1 + 4));
            self.patch32(jNein1, lNein1 - (jNein1 + 4));
            self.patch32(jZur1,  schleife - (jZur1 + 4));
            self.patch32(jEnd1,  lEnde1 - (jEnd1 + 4));
        } else {
            // StrEq: beide muessen zugleich enden.
            self.emit8(0x8A); self.emit8(0x07);                    // MOV al, [rdi]
            self.emit8(0x3A); self.emit8(0x06);                    // CMP al, [rsi]
            self.emit8(0x0F); self.emit8(0x85);                    // JNE rel32 -> nein
            var jNein2: int64 := self.codeLen; self.emit32(0);
            self.emit8(0x84); self.emit8(0xC0);                    // TEST al, al
            self.emit8(0x0F); self.emit8(0x84);                    // JZ rel32 -> ja (beide 0)
            var jJa2: int64 := self.codeLen; self.emit32(0);
            self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC7);  // INC rdi
            self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC6);  // INC rsi
            self.emit8(0xE9);                                      // JMP rel32 -> schleife
            var jZur2: int64 := self.codeLen; self.emit32(0);
            var lJa2: int64 := self.codeLen;
            self.emit8(0x48); self.emit8(0xC7); self.emit8(0xC0); self.emit32(1);   // MOV rax, 1
            self.emit8(0xE9);                                      // JMP rel32 -> ende
            var jEnd2: int64 := self.codeLen; self.emit32(0);
            var lNein2: int64 := self.codeLen;
            self.emit8(0x48); self.emit8(0x31); self.emit8(0xC0);  // XOR rax, rax
            var lEnde2: int64 := self.codeLen;
            self.patch32(jNein2, lNein2 - (jNein2 + 4));
            self.patch32(jJa2,   lJa2   - (jJa2 + 4));
            self.patch32(jZur2,  schleife - (jZur2 + 4));
            self.patch32(jEnd2,  lEnde2 - (jEnd2 + 4));
        }
        self.emitMovSlotFromRax(dest);
    }

    // ID 4/5 (#1728): Random() und RandomSeed(seed).
    //
    // xorshift64, wie auf dem x86-Weg. Der Zustand liegt im Wort hinter den
    // Programm-Globalen (siehe emitGlobalsPool); erreicht wird er
    // RIP-relativ ueber dieselbe Patch-Maschinerie wie jede Globale, mit
    // gIdx < 0 als Kennzeichnung.
    //
    // Der Nullzustand wird abgefangen: xorshift64 bleibt bei 0 stehen, ein
    // Generator der immer 0 liefert waere ein stiller Fehler.
    fn emitRandom(dest: int64): void {
        // MOV rax, [rip+zustand]
        self.emit8(0x48); self.emit8(0x8B); self.emit8(0x05);
        self.recordGlobalPatch(self.codeLen, 0 - 1); self.emit32(0);
        self.emit8(0x48); self.emit8(0x85); self.emit8(0xC0);          // TEST rax, rax
        self.emit8(0x75); self.emit8(0x07);                            // JNZ +7 (Zustand gesetzt)
        self.emit8(0x48); self.emit8(0xC7); self.emit8(0xC0); self.emit32(1);  // MOV rax, 1
        // x ^= x << 13
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xC1);          // MOV rcx, rax
        self.emit8(0x48); self.emit8(0xC1); self.emit8(0xE1); self.emit8(0x0D);  // SHL rcx, 13
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xC8);          // XOR rax, rcx
        // x ^= x >> 7
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xC1);          // MOV rcx, rax
        self.emit8(0x48); self.emit8(0xC1); self.emit8(0xE9); self.emit8(0x07);  // SHR rcx, 7
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xC8);          // XOR rax, rcx
        // x ^= x << 17
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xC1);          // MOV rcx, rax
        self.emit8(0x48); self.emit8(0xC1); self.emit8(0xE1); self.emit8(0x11);  // SHL rcx, 17
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xC8);          // XOR rax, rcx
        // MOV [rip+zustand], rax
        self.emit8(0x48); self.emit8(0x89); self.emit8(0x05);
        self.recordGlobalPatch(self.codeLen, 0 - 1); self.emit32(0);
        self.emitMovSlotFromRax(dest);
    }

    fn emitRandomSeed(dest: int64): void {
        self.emitMovRaxFromSlot(0);                                    // rax = seed
        self.emit8(0x48); self.emit8(0x89); self.emit8(0x05);          // MOV [rip+zustand], rax
        self.recordGlobalPatch(self.codeLen, 0 - 1); self.emit32(0);
        self.emit8(0x31); self.emit8(0xC0);                            // XOR eax, eax
        self.emitMovSlotFromRax(dest);
    }

    // ID 6 (#1720): StrSub(s, start, len) — Teilzeichenkette in einen frischen
    // Puffer, Zeiger nach dest. Slots 0=s, 1=start, 2=len.
    //
    // Kopiert wird zeichenweise mit Abbruch am Nullbyte, nicht blind ueber
    // `len` Bytes: steht `start+len` hinter dem Ende, laese ein `rep movsb`
    // ueber die Zeichenkette hinaus und schriebe fremden Speicher in das
    // Ergebnis.
    fn emitStrSub(dest: int64): void {
        self.emit8(0x41); self.emit8(0x54);                    // PUSH r12
        self.emit8(0x41); self.emit8(0x55);                    // PUSH r13
        // Puffer: len + 1 Byte. mmap(0, r13+1, PROT_RW=3, MAP_PRIVATE|ANON=5)
        self.emitMovRaxFromSlot(2);                            // rax = len
        self.emit8(0x49); self.emit8(0x89); self.emit8(0xC5);  // MOV r13, rax   (len merken)
        self.emitMovRaxImm(9);
        self.emit8(0x31); self.emit8(0xFF);                    // XOR edi, edi
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xEE);  // MOV rsi, r13
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC6);  // INC rsi        (len+1)
        self.emit8(0xBA); self.emit32(3);                      // MOV edx, 3
        self.emit8(0x41); self.emit8(0xBA); self.emit32(5);    // MOV r10d, 5
        self.emitSyscall();
        self.emit8(0x49); self.emit8(0x89); self.emit8(0xD4);  // MOV r12, rdx   (Puffer)

        // rsi = s + start, rdi = Puffer, rcx = 0 (Zaehler)
        self.emitMovRsiFromSlot(0);                            // rsi = s
        self.emitMovRaxFromSlot(1);                            // rax = start
        self.emit8(0x48); self.emit8(0x01); self.emit8(0xC6);  // ADD rsi, rax
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xE7);  // MOV rdi, r12
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xC9);  // XOR rcx, rcx

        // schleife: while (rcx < len && *rsi != 0) *rdi++ = *rsi++
        self.emit8(0x4C); self.emit8(0x39); self.emit8(0xE9);  // CMP rcx, r13
        self.emit8(0x7D); self.emit8(0x0F);                    // JGE fertig (+15)
        self.emit8(0x8A); self.emit8(0x04); self.emit8(0x0E);  // MOV al, [rsi+rcx]
        self.emit8(0x84); self.emit8(0xC0);                    // TEST al, al
        self.emit8(0x74); self.emit8(0x08);                    // JZ fertig (+8)
        self.emit8(0x88); self.emit8(0x04); self.emit8(0x0F);  // MOV [rdi+rcx], al
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC1);  // INC rcx
        self.emit8(0xEB); self.emit8(0xEC);                    // JMP schleife (-20)
        // fertig:
        self.emit8(0xC6); self.emit8(0x04); self.emit8(0x0F); self.emit8(0x00);  // MOV byte [rdi+rcx], 0
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0xE0);  // MOV rax, r12
        self.emit8(0x41); self.emit8(0x5D);                    // POP r13
        self.emit8(0x41); self.emit8(0x5C);                    // POP r12
        self.emitMovSlotFromRax(dest);
    }

    // ID 16 (#1720): IntToStr/StrFromInt — Zahl aus Slot 0 als Dezimaltext,
    // Zeiger nach dest.
    //
    // Der Puffer muss den Aufruf ueberleben, kommt also aus mmap und nicht
    // vom Stapel — sonst zeigte das Ergebnis auf einen Rahmen, den der
    // naechste Aufruf ueberschreibt. Die Ziffernschleife ist dieselbe wie in
    // emitPrintIntFd, nur schreibt sie in den Puffer statt ihn auszugeben.
    //
    // LyxOS liefert das Ergebnis eines Syscalls in rdx, nicht in rax
    // (siehe emitVfsSyscall und emitAlloc).
    fn emitIntToStr(dest: int64): void {
        self.emit8(0x41); self.emit8(0x54);                    // PUSH r12 (Puffer, muss erhalten bleiben)
        // mmap(0, 24, PROT_RW=3, MAP_PRIVATE|MAP_ANON=5) — wie emitAlloc
        self.emitMovRaxImm(9);
        self.emit8(0x31); self.emit8(0xFF);                    // XOR edi, edi
        self.emit8(0xBE); self.emit32(24);                     // MOV esi, 24
        self.emit8(0xBA); self.emit32(3);                      // MOV edx, 3
        self.emit8(0x41); self.emit8(0xBA); self.emit32(5);    // MOV r10d, 5
        self.emitSyscall();
        self.emit8(0x49); self.emit8(0x89); self.emit8(0xD4);  // MOV r12, rdx  (Puffer)

        self.emit8(0x41); self.emit8(0xBB); self.emit32(22);   // MOV r11d, 22  (Schreibindex)
        self.emit8(0x43); self.emit8(0xC6); self.emit8(0x04); self.emit8(0x1C); self.emit8(0x00);  // MOV byte [r12+r11], 0
        self.emit8(0x49); self.emit8(0xFF); self.emit8(0xCB);  // DEC r11

        self.emitMovRaxFromSlot(0);                            // rax = n
        self.emit8(0x4D); self.emit8(0x31); self.emit8(0xC0);  // XOR r8, r8   (Vorzeichenmerker)
        self.emit8(0x48); self.emit8(0x85); self.emit8(0xC0);  // TEST rax, rax
        self.emit8(0x79); self.emit8(0x09);                    // JNS +9 (nicht negativ)
        self.emit8(0x41); self.emit8(0xB8); self.emit32(1);    // MOV r8d, 1
        self.emit8(0x48); self.emit8(0xF7); self.emit8(0xD8);  // NEG rax
        self.emit8(0x41); self.emit8(0xB9); self.emit32(10);   // MOV r9d, 10

        // schleife: Ziffer von hinten schreiben
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xD2);  // XOR rdx, rdx
        self.emit8(0x49); self.emit8(0xF7); self.emit8(0xF1);  // DIV r9
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC2); self.emit8(0x30);  // ADD rdx, 48
        self.emit8(0x43); self.emit8(0x88); self.emit8(0x14); self.emit8(0x1C);  // MOV [r12+r11], dl
        self.emit8(0x49); self.emit8(0xFF); self.emit8(0xCB);  // DEC r11
        self.emit8(0x48); self.emit8(0x85); self.emit8(0xC0);  // TEST rax, rax
        self.emit8(0x75); self.emit8(0xEC);                    // JNZ schleife (-20)

        self.emit8(0x4D); self.emit8(0x85); self.emit8(0xC0);  // TEST r8, r8
        self.emit8(0x74); self.emit8(0x08);                    // JZ +8 (kein Minuszeichen)
        self.emit8(0x43); self.emit8(0xC6); self.emit8(0x04); self.emit8(0x1C); self.emit8(0x2D);  // MOV byte [r12+r11], '-'
        self.emit8(0x49); self.emit8(0xFF); self.emit8(0xCB);  // DEC r11

        self.emit8(0x4B); self.emit8(0x8D); self.emit8(0x44); self.emit8(0x1C); self.emit8(0x01);  // LEA rax, [r12+r11+1]
        self.emit8(0x41); self.emit8(0x5C);                    // POP r12
        self.emitMovSlotFromRax(dest);
    }

    // ID 15: StrLen/StrLength — Laenge von Slot 0 nach dest.
    fn emitStrLen(dest: int64): void {
        self.emitMovRsiFromSlot(0);                              // rsi = ptr
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xC0);    // XOR rax, rax
        self.emit8(0x80); self.emit8(0x3C); self.emit8(0x06); self.emit8(0x00);  // loop: CMP byte[rsi+rax],0
        self.emit8(0x74); self.emit8(0x05);                      // JE fertig (+5)
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC0);    // INC rax
        self.emit8(0xEB); self.emit8(0xF5);                      // JMP loop (-11)
        // fertig:
        self.emitMovSlotFromRax(dest);
    }
};

// ---------------------------------------------------------------------------
// LyxOsELFWriter — writes the ELF binary with .note.lyx-abi
// ---------------------------------------------------------------------------

pub type LyxOsELFWriter = class {
    buf: int64;
    len: int64;
    cap: int64;

    // Prefixed elf_ to avoid VMT collision with EmitLyxOS.init/grow/patch32/patch64
    fn elf_init(): void {
        self.cap := 65536;
        self.buf := alloc(self.cap);
        self.len := 0;
    }

    fn elf_grow(need: int64): void {
        if (self.len + need) <= self.cap { return; }
        var nc: int64 := self.cap * 2;
        while nc < (self.len + need) { nc := nc * 2; }
        var nb: int64 := alloc(nc);
        memcpy(nb, self.buf, self.len);
        self.buf := nb;
        self.cap := nc;
    }

    fn elf_w8(v: int64): void {
        self.elf_grow(1);
        poke8(self.buf + self.len, v & 0xFF);
        self.len := self.len + 1;
    }

    fn elf_w16(v: int64): void {
        self.elf_grow(2);
        poke8(self.buf + self.len + 0, v & 0xFF);
        poke8(self.buf + self.len + 1, (v >> 8) & 0xFF);
        self.len := self.len + 2;
    }

    fn elf_w32(v: int64): void {
        self.elf_grow(4);
        poke8(self.buf + self.len + 0,  v        & 0xFF);
        poke8(self.buf + self.len + 1, (v >>  8) & 0xFF);
        poke8(self.buf + self.len + 2, (v >> 16) & 0xFF);
        poke8(self.buf + self.len + 3, (v >> 24) & 0xFF);
        self.len := self.len + 4;
    }

    fn elf_w64(v: int64): void {
        self.elf_grow(8);
        poke8(self.buf + self.len + 0,  v        & 0xFF);
        poke8(self.buf + self.len + 1, (v >>  8) & 0xFF);
        poke8(self.buf + self.len + 2, (v >> 16) & 0xFF);
        poke8(self.buf + self.len + 3, (v >> 24) & 0xFF);
        poke8(self.buf + self.len + 4, (v >> 32) & 0xFF);
        poke8(self.buf + self.len + 5, (v >> 40) & 0xFF);
        poke8(self.buf + self.len + 6, (v >> 48) & 0xFF);
        poke8(self.buf + self.len + 7, (v >> 56) & 0xFF);
        self.len := self.len + 8;
    }

    fn elf_patch32(off: int64, v: int64): void {
        poke8(self.buf + off + 0,  v        & 0xFF);
        poke8(self.buf + off + 1, (v >>  8) & 0xFF);
        poke8(self.buf + off + 2, (v >> 16) & 0xFF);
        poke8(self.buf + off + 3, (v >> 24) & 0xFF);
    }

    fn elf_patch64(off: int64, v: int64): void {
        poke8(self.buf + off + 0,  v        & 0xFF);
        poke8(self.buf + off + 1, (v >>  8) & 0xFF);
        poke8(self.buf + off + 2, (v >> 16) & 0xFF);
        poke8(self.buf + off + 3, (v >> 24) & 0xFF);
        poke8(self.buf + off + 4, (v >> 32) & 0xFF);
        poke8(self.buf + off + 5, (v >> 40) & 0xFF);
        poke8(self.buf + off + 6, (v >> 48) & 0xFF);
        poke8(self.buf + off + 7, (v >> 56) & 0xFF);
    }

    fn elf_padTo(target: int64): void {
        while self.len < target { self.elf_w8(0); }
    }

    // Write the .note.lyx-abi section payload (24 bytes):
    //   namesz=4, descsz=8, type=1, "LYX\0", major=1, minor=0
    fn elf_writeNote(): void {
        self.elf_w32(4);              // namesz: "LYX\0" = 4 bytes
        self.elf_w32(8);              // descsz: major(4) + minor(4) = 8 bytes
        self.elf_w32(1);              // type = 1 (NT_VERSION)
        self.elf_w8(76);              // 'L'
        self.elf_w8(89);              // 'Y'
        self.elf_w8(88);              // 'X'
        self.elf_w8(0);               // '\0'
        self.elf_w32(1);              // major = 1
        self.elf_w32(0);              // minor = 0
    }

    // Build and write the ELF file.
    // codeBuf/codeLen: compiled machine code (_start + functions).
    pub fn writeELF(path: pchar, codeBuf: int64, codeLen: int64): bool {
        self.elf_init();
        if self.buf == 0 { return false; }  // alloc failed

        var pageSize:   int64 := 4096;           // 0x1000
        var baseVaddr:  int64 := 0x400000;
        var codeOff:    int64 := pageSize;        // .text at file offset 0x1000
        var noteOff:    int64 := codeOff + codeLen;
        var noteSize:   int64 := 24;
        var fileSize:   int64 := noteOff + noteSize;

        var entryVaddr: int64 := baseVaddr + codeOff;   // 0x401000 = _start
        var noteVaddr:  int64 := baseVaddr + noteOff;

        // --- ELF header (64 bytes) ---
        // e_ident magic
        self.elf_w8(127); self.elf_w8(69); self.elf_w8(76); self.elf_w8(70);  // \x7fELF
        self.elf_w8(2);   // EI_CLASS = ELFCLASS64
        self.elf_w8(1);   // EI_DATA  = ELFDATA2LSB (little-endian)
        self.elf_w8(1);   // EI_VERSION = EV_CURRENT
        self.elf_w8(0);   // EI_OSABI = ELFOSABI_NONE  (0 = System V / LyxOS)
        self.elf_w64(0);  // EI_ABIVERSION + padding (8 bytes)
        self.elf_w16(2);  // e_type = ET_EXEC
        self.elf_w16(62); // e_machine = EM_X86_64
        self.elf_w32(1);  // e_version = EV_CURRENT
        self.elf_w64(entryVaddr);  // e_entry
        self.elf_w64(64);          // e_phoff = 64 (right after ELF header)
        self.elf_w64(0);           // e_shoff = 0 (no section headers)
        self.elf_w32(0);           // e_flags
        self.elf_w16(64);          // e_ehsize
        self.elf_w16(56);          // e_phentsize
        self.elf_w16(2);           // e_phnum = 2 (PT_LOAD, PT_NOTE)
        self.elf_w16(64);          // e_shentsize
        self.elf_w16(0);           // e_shnum
        self.elf_w16(0);           // e_shstrndx

        // --- Program headers (2 × 56 bytes) ---
        // Bootstrap Bug 4: max 5 explicit args. elf_writePH had 7 → inline instead.
        // PH[0]: PT_LOAD (R-X) — covers entire file
        self.elf_grow(56);
        self.elf_w32(1);           // p_type  = PT_LOAD
        self.elf_w32(5);           // p_flags = R|X
        self.elf_w64(0);           // p_offset
        self.elf_w64(baseVaddr);   // p_vaddr
        self.elf_w64(baseVaddr);   // p_paddr
        self.elf_w64(fileSize);    // p_filesz
        self.elf_w64(fileSize);    // p_memsz
        self.elf_w64(pageSize);    // p_align

        // PH[1]: PT_NOTE (R) — .note.lyx-abi only
        self.elf_grow(56);
        self.elf_w32(4);           // p_type  = PT_NOTE
        self.elf_w32(4);           // p_flags = R
        self.elf_w64(noteOff);     // p_offset
        self.elf_w64(noteVaddr);   // p_vaddr
        self.elf_w64(noteVaddr);   // p_paddr
        self.elf_w64(noteSize);    // p_filesz
        self.elf_w64(noteSize);    // p_memsz
        self.elf_w64(4);           // p_align

        // --- Padding to page boundary ---
        self.elf_padTo(codeOff);

        // --- .text: compiled code ---
        var ci: int64 := 0;
        while ci < codeLen {
            self.elf_w8(peek8(codeBuf + ci));
            ci := ci + 1;
        }

        // --- .note.lyx-abi ---
        self.elf_writeNote();

        // --- Write to file ---
        var fd: int64 := open(path, 577, 493);   // O_WRONLY|O_CREAT|O_TRUNC, 0755
        if fd == -1 { return false; }
        write(fd, self.buf as pchar, self.len);
        close(fd);
        chmod(path, 493);
        return true;
    }

    pub fn elf_getLen(): int64 { return self.len; }
};
