        else if id == 68 { self.emitVfsSyscall(0x000A, 1, dest); }    // sys_sleep_ns
        else if id == 69 { self.emitVfsSyscall(0x000B, 2, dest); }    // sys_priority
        else if id == 70 { self.emitVfsSyscall(0x000C, 3, dest); }    // sys_getrandom
        else if id == 71 { self.emitVfsSyscall(0x000D, 2, dest); }    // sys_signal_mask
