        else if id == 38 { self.emitVfsSyscall(80, 1, dest); }    // sys_chdir §10.4=80 (path_uva)
        else if id == 39 { self.emitVfsSyscall(0x0213, 3, dest); }    // sys_symlink
        else if id == 40 { self.emitVfsSyscall(0x0214, 4, dest); }    // sys_readlink
        else if id == 41 { self.emitVfsSyscall(0x0215, 4, dest); }    // sys_content_id
        else if id == 42 { self.emitVfsSyscall(0x0300, 3, dest); }    // sys_poll
        else if id == 43 { self.emitVfsSyscall(0x0301, 3, dest); }    // sys_ioctl
