            var lx12ac: int64 := 2;
            if id == 92 { lx12ac := 1; }    // sys_cap_rights(cap_fd)
            else if id == 95 { lx12ac := 0; } // sys_uid_get()
            else if id == 96 { lx12ac := 0; } // sys_gid_get()
