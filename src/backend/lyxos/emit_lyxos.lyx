// LX-01: Lyx OS Backend — ELF-Grundgerüst + .note.lyx-abi
// LX-02: Codegen-Skelett (IR-Dispatch, SYSCALL-Makro, Slot-Modell)
//
// ELF-Layout (x86-64 EXEC, statisch):
//   0x0000  ELF header        64 B
//   0x0040  PH[0] PT_LOAD RX  56 B  (covers whole file)
//   0x0078  PH[1] PT_NOTE R   56 B  (.note.lyx-abi)
//   0x00B0  padding            …
//   0x1000  .text (_start)     N B   (IR-compiled code)
//   0x1000+N .note.lyx-abi    24 B
//
// Syscall ABI (syscalls.md §2.2):
//   in:  rax=nr, rdi=a1, rsi=a2, rdx=a3, r10=a4, r8=a5, r9=a6
//   out: rax=errcode, rdx=value
//   clobbered: rcx, r11
//   callee-saved: rbx, rbp, r12–r15
//
// sys_exit_group = 0x0002 (lyxos)

import src.ir;

// ---------------------------------------------------------------------------
// EmitLyxOS — x86-64 code generator for --target=lyxos
// ---------------------------------------------------------------------------

pub type EmitLyxOS = class {
    irMod:         int64;   // pointer to IRModule
    codeBuf:       int64;   // mmap'd output buffer
    codeLen:       int64;   // bytes written so far
    codeCap:       int64;
    strPatchBuf:   int64;   // array of (leaOff: int64, strOff: int64) pairs for CONST_STR
    strPatchCount: int64;
    strPatchCap:   int64;   // Kapazität in Bytes (16 Byte/Eintrag); wächst dynamisch
    // LYXOS-WP-2: Control-Flow. labelAddrs[id]=Code-Offset (dynamisch); jmpPatch=(relOff,labelId).
    labelAddrs:    int64;
    labelCap:      int64;   // Anzahl Label-Slots (8 Byte je)
    jmpPatchBuf:   int64;
    jmpPatchCount: int64;
    jmpPatchCap:   int64;   // Bytes (16 je Eintrag)
    // LYXOS-WP-3: Globals-Daten-Area (ans Code angehängt) + RIP-relative Patches.
    globalsBase:   int64;   // Code-Offset des Globals-Pools (nach emitGlobalsPool)
    rodataBase:    int64;   // Code-Offset des StrPools = Ende .text (LYXOS-WP-5 Sektions-Grenze)
    globalPatchBuf: int64;
    globalPatchCount: int64;
    globalPatchCap: int64;  // Bytes (16 je Eintrag: dispOff, gIdx)
    // LYXOS-call-fix: user-Funktions-Calls. funcAddrs[funcId]=Code-Offset; callPatch=(relOff,funcId).
    funcAddrs:     int64;
    funcCap:       int64;   // Anzahl Funktions-Slots (8 Byte je)
    callPatchBuf:  int64;
    callPatchCount: int64;
    callPatchCap:  int64;   // Bytes (16 je Eintrag)

    pub fn init(ir: int64): void {
        self.irMod         := ir;
        self.codeCap       := 65536;
        self.codeBuf       := alloc(self.codeCap);
        self.codeLen       := 0;
        self.strPatchCap   := 4096;
        self.strPatchBuf   := alloc(self.strPatchCap);
        self.strPatchCount := 0;
        // LYXOS-WP-2: Label/Jmp-Infra.
        self.labelCap      := 1024;
        self.labelAddrs    := alloc(self.labelCap * 8);
        var li0: int64 := 0;
        while li0 < self.labelCap { poke64(self.labelAddrs + li0 * 8, 0 - 1); li0 := li0 + 1; }
        self.jmpPatchCap   := 4096;
        self.jmpPatchBuf   := alloc(self.jmpPatchCap);
        self.jmpPatchCount := 0;
        // LYXOS-WP-3: Globals-Patches.
        self.globalsBase      := 0 - 1;
        self.globalPatchCap   := 4096;
        self.globalPatchBuf   := alloc(self.globalPatchCap);
        self.globalPatchCount := 0;
        // LYXOS-call-fix: funcAddrs in emitFunctions alloziert (funcLen bekannt); Call-Patches hier.
        self.funcAddrs        := 0;
        self.funcCap          := 0;
        self.callPatchCap     := 4096;
        self.callPatchBuf     := alloc(self.callPatchCap);
        self.callPatchCount   := 0;
    }

    // strPatchBuf wächst dynamisch (16 Byte/Eintrag). Vorher fix 4096 = nur 256 Einträge →
    // große Programme (z.B. lyxc.lyx, tausende String-Literale) überliefen den Buffer
    // ungeprüft → Heap-Korruption → Garbage-leaOff in emitStrPool → Wild-poke8-SIGSEGV.
    fn growStrPatch(): void {
        var need: int64 := (self.strPatchCount + 1) * 16;
        if need <= self.strPatchCap { return; }
        var nc: int64 := self.strPatchCap * 2;
        while nc < need { nc := nc * 2; }
        var nb: int64 := alloc(nc);
        memcpy(nb, self.strPatchBuf, self.strPatchCount * 16);
        self.strPatchBuf := nb;
        self.strPatchCap := nc;
    }

    fn grow(need: int64): void {
        if (self.codeLen + need) <= self.codeCap { return; }
        var nc: int64 := self.codeCap * 2;
        while nc < (self.codeLen + need) { nc := nc * 2; }
        var nb: int64 := alloc(nc);
        memcpy(nb, self.codeBuf, self.codeLen);
        self.codeBuf := nb;
        self.codeCap := nc;
    }

    pub fn emit8(v: int64): void {
        self.grow(1);
        poke8(self.codeBuf + self.codeLen, v & 0xFF);
        self.codeLen := self.codeLen + 1;
    }

    pub fn emit32(v: int64): void {
        self.grow(4);
        poke8(self.codeBuf + self.codeLen + 0,  v        & 0xFF);
        poke8(self.codeBuf + self.codeLen + 1, (v >>  8) & 0xFF);
        poke8(self.codeBuf + self.codeLen + 2, (v >> 16) & 0xFF);
        poke8(self.codeBuf + self.codeLen + 3, (v >> 24) & 0xFF);
        self.codeLen := self.codeLen + 4;
    }

    pub fn emit64(v: int64): void {
        self.grow(8);
        poke8(self.codeBuf + self.codeLen + 0,  v        & 0xFF);
        poke8(self.codeBuf + self.codeLen + 1, (v >>  8) & 0xFF);
        poke8(self.codeBuf + self.codeLen + 2, (v >> 16) & 0xFF);
        poke8(self.codeBuf + self.codeLen + 3, (v >> 24) & 0xFF);
        poke8(self.codeBuf + self.codeLen + 4, (v >> 32) & 0xFF);
        poke8(self.codeBuf + self.codeLen + 5, (v >> 40) & 0xFF);
        poke8(self.codeBuf + self.codeLen + 6, (v >> 48) & 0xFF);
        poke8(self.codeBuf + self.codeLen + 7, (v >> 56) & 0xFF);
        self.codeLen := self.codeLen + 8;
    }

    // Patch a u32 at an already-written offset.
    fn patch32(off: int64, v: int64): void {
        poke8(self.codeBuf + off + 0,  v        & 0xFF);
        poke8(self.codeBuf + off + 1, (v >>  8) & 0xFF);
        poke8(self.codeBuf + off + 2, (v >> 16) & 0xFF);
        poke8(self.codeBuf + off + 3, (v >> 24) & 0xFF);
    }

    // Patch a u64 at an already-written offset.
    fn patch64(off: int64, v: int64): void {
        poke8(self.codeBuf + off + 0,  v        & 0xFF);
        poke8(self.codeBuf + off + 1, (v >>  8) & 0xFF);
        poke8(self.codeBuf + off + 2, (v >> 16) & 0xFF);
        poke8(self.codeBuf + off + 3, (v >> 24) & 0xFF);
        poke8(self.codeBuf + off + 4, (v >> 32) & 0xFF);
        poke8(self.codeBuf + off + 5, (v >> 40) & 0xFF);
        poke8(self.codeBuf + off + 6, (v >> 48) & 0xFF);
        poke8(self.codeBuf + off + 7, (v >> 56) & 0xFF);
    }

    // --- Syscall helpers ---

    // SYSCALL instruction: 0F 05
    fn emitSyscall(): void {
        self.emit8(0x0F);
        self.emit8(0x05);
    }

    // MOV rax, imm64  (REX.W B8+rd)
    fn emitMovRaxImm(v: int64): void {
        self.emit8(0x48);   // REX.W
        self.emit8(0xB8);   // MOV rax, imm64
        self.emit64(v);
    }

    // MOV rdi, imm32  (sign-extended)  — xor edi,edi for 0
    fn emitMovRdiImm32(v: int64): void {
        if v == 0 {
            // XOR edi, edi  (31 FF)  — also zeroes rdi via zero-extension
            self.emit8(0x31);
            self.emit8(0xFF);
        } else {
            // MOV edi, imm32  (BF imm32)
            self.emit8(0xBF);
            self.emit32(v);
        }
    }

    // Emit: sys_exit(code) — Kernel .ring3_exit-Handler erwartet Linux-kompatible
    // Nummer rax=60 (sys_exit), Exit-Code in rdi (SysV AMD64 arg0). Kernel speichert
    // ring3_exit_code, stellt Kernel-CR3/Kontext wieder her, springt via Trampolin
    // zurück nach vmm_op29. (Früher rax=2 = lyxc-Bug-Kompat; auf §10.4 wäre 2=sys_open.)
    fn emitSysExitGroup(code: int64): void {
        self.emitMovRaxImm(60);       // rax = 60 (sys_exit)
        self.emitMovRdiImm32(code);   // rdi = exit code
        self.emitSyscall();
    }

    // Patch a u32 at an already-written position.
    pub fn patchCallRel32(off: int64, rel32: int64): void {
        self.patch32(off, rel32);
    }

    // --- Slot model (rbp-based locals, 8 bytes each) ---
    // slot 0 → [rbp - 8], slot 1 → [rbp - 16], etc.
    fn slotOff(slot: int64): int64 {
        return 0 - (slot + 1) * 8;
    }

    // --- Function prologue / epilogue ---

    fn emitPrologue(localCount: int64): void {
        // PUSH rbp
        self.emit8(0x55);
        // MOV rbp, rsp
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xE5);
        // SUB rsp, localCount*8  (align to 16: round up to even)
        var frameBytes: int64 := localCount * 8;
        var aligned: int64 := ((frameBytes + 15) / 16) * 16;
        if aligned > 0 {
            if aligned <= 127 {
                // SUB rsp, imm8  (48 83 EC imm8)
                self.emit8(0x48); self.emit8(0x83); self.emit8(0xEC);
                self.emit8(aligned);
            } else {
                // SUB rsp, imm32  (48 81 EC imm32)
                self.emit8(0x48); self.emit8(0x81); self.emit8(0xEC);
                self.emit32(aligned);
            }
        }
    }

    fn emitEpilogue(): void {
        // MOV rsp, rbp
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xEC);
        // POP rbp
        self.emit8(0x5D);
        // RET
        self.emit8(0xC3);
    }

    // --- _start entry point (LX-03) ---
    // Stack-Canary-Seed via RTC: Kernel hat KEINEN getrandom-Syscall (§10.4); 0x000C=12
    // wäre unbelegt → uninitialisierter Canary. Stattdessen RTC-Zeit (138/134) + rsp mischen.
    // Layout (from buffer offset 0):
    //   +0   XOR rbp, rbp           (3 bytes)
    //   +3   MOV rax, 138           (10 bytes)  sys_rtc_datetime → rdx=(date<<16)|time
    //   +13  SYSCALL                (2 bytes)
    //   +15  MOV r8, rdx            (3 bytes)
    //   +18  SHL r8, 32             (4 bytes)
    //   +22  MOV rax, 134           (10 bytes)  sys_rtc_read → rdx=(h<<8)|m
    //   +32  SYSCALL                (2 bytes)
    //   +34  OR  r8, rdx            (3 bytes)
    //   +37  XOR r8, rsp            (3 bytes)   ASLR-Entropie einmischen
    //   +40  MOV [rsp-8], r8        (5 bytes)   → canary at [rsp-8]
    //   +45  CALL rel32             (5 bytes)   ← rel32 at +46, callNextIP = 50
    //   +50  MOV edi, eax           (2 bytes)   exit code
    //   +52  MOV rax, 60            (10 bytes)  sys_exit (Linux-kompat, .ring3_exit)
    //   +62  SYSCALL                (2 bytes)
    pub fn emitStartStub(): void {
        // XOR rbp, rbp
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xED);
        self.emitCanarySeed();                                 // RTC-Seed → [rsp-8]
        // CALL main (placeholder, patched at +46)
        self.emit8(0xE8); self.emit32(0);
        // sys_exit(rax) — Kernel .ring3_exit erwartet rax=60, rdi=Exit-Code
        self.emit8(0x89); self.emit8(0xC7);                     // MOV edi, eax
        self.emitMovRaxImm(60);                                 // MOV rax, 60 (sys_exit)
        self.emitSyscall();                                     // SYSCALL
    }

    // Stack-Canary-Seed (42 Bytes) — RTC-Zeit + rsp gemischt nach [rsp-8].
    // Kein getrandom-Syscall in §10.4; RTC (138/134) ist die einzige Kernel-Entropiequelle.
    fn emitCanarySeed(): void {
        self.emitMovRaxImm(138);                               // MOV rax, 138 (sys_rtc_datetime)
        self.emitSyscall();                                    // → rdx = (date<<16)|time
        self.emit8(0x49); self.emit8(0x89); self.emit8(0xD0);  // MOV r8, rdx
        self.emit8(0x49); self.emit8(0xC1); self.emit8(0xE0); self.emit8(0x20); // SHL r8, 32
        self.emitMovRaxImm(134);                               // MOV rax, 134 (sys_rtc_read)
        self.emitSyscall();                                    // → rdx = (h<<8)|m
        self.emit8(0x49); self.emit8(0x09); self.emit8(0xD0);  // OR r8, rdx
        self.emit8(0x49); self.emit8(0x31); self.emit8(0xE0);  // XOR r8, rsp
        self.emit8(0x4C); self.emit8(0x89); self.emit8(0x44); self.emit8(0x24); self.emit8(0xF8); // MOV [rsp-8], r8
    }

    // LX-36: _start for EVENT_LOOP lifecycle (86 bytes).
    // RTC-Canary-Seed (wie ONE_SHOT), dann sys_event_loop_init (0x0020) vor CALL main.
    // CALL rel32 is at byte offset 68; callNextIP = 72.
    // Caller must use: patchCallRel32(68, mainOff - 72)
    pub fn emitStartStubEventLoop(): void {
        // XOR rbp, rbp
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xED);
        self.emitCanarySeed();                               // +3:  RTC-Seed → [rsp-8], endet +45
        // sys_event_loop_init (0x0020): kernel registers lifecycle sources
        // MOV rdi, imm64 (0 = kernel reads TLV 0x08 from loaded binary)
        self.emit8(0x48); self.emit8(0xBF); self.emit64(0);  // +45: MOV rdi, 0
        self.emitMovRaxImm(0x0020);                           // +55: MOV rax, 0x0020
        self.emitSyscall();                                   // +65: SYSCALL
        // CALL main placeholder: rel32 at byte 68, callNextIP = 72
        self.emit8(0xE8); self.emit32(0);                     // +67: CALL rel32
        // sys_exit(rax) — Kernel .ring3_exit erwartet rax=60, rdi=Exit-Code
        self.emit8(0x89); self.emit8(0xC7);                   // +72: MOV edi, eax
        self.emitMovRaxImm(60);                               // +74: MOV rax, 60 (sys_exit)
        self.emitSyscall();                                   // +84: SYSCALL
    }

    // --- Slot load/store helpers ---

    fn emitMovRaxFromSlot(slot: int64): void {
        var off: int64 := self.slotOff(slot);
        if slot < 16 {
            // MOV rax, [rbp + disp8]  (48 8B 45 <d8>)
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0x45);
            self.emit8(off & 0xFF);
        } else {
            // MOV rax, [rbp + disp32]  (48 8B 85 <d32>)
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0x85);
            self.emit32(off);
        }
    }

    fn emitMovSlotFromRax(slot: int64): void {
        var off: int64 := self.slotOff(slot);
        if slot < 16 {
            // MOV [rbp + disp8], rax  (48 89 45 <d8>)
            self.emit8(0x48); self.emit8(0x89); self.emit8(0x45);
            self.emit8(off & 0xFF);
        } else {
            // MOV [rbp + disp32], rax  (48 89 85 <d32>)
            self.emit8(0x48); self.emit8(0x89); self.emit8(0x85);
            self.emit32(off);
        }
    }

    // WP-OPCODE-REST: LEA rax, [rbp+disp] — Adresse eines Slots (&local).
    fn emitLeaRaxFromSlot(slot: int64): void {
        var off: int64 := self.slotOff(slot);
        if slot < 16 {
            self.emit8(0x48); self.emit8(0x8D); self.emit8(0x45);   // LEA rax,[rbp+disp8]
            self.emit8(off & 0xFF);
        } else {
            self.emit8(0x48); self.emit8(0x8D); self.emit8(0x85);   // LEA rax,[rbp+disp32]
            self.emit32(off);
        }
    }

    // WP-OPCODE-REST: f64-sqrt. f64-Werte liegen als 64-Bit-Muster im Slot → in xmm0 laden,
    // sqrtsd, zurück. Self-contained (kein Float-Pipeline nötig).
    fn emitMovsdXmm0FromSlot(slot: int64): void {
        var off: int64 := self.slotOff(slot);
        self.emit8(0xF2); self.emit8(0x0F); self.emit8(0x10);       // MOVSD xmm0, [rbp+disp]
        if slot < 16 { self.emit8(0x45); self.emit8(off & 0xFF); }
        else { self.emit8(0x85); self.emit32(off); }
    }
    fn emitMovsdSlotFromXmm0(slot: int64): void {
        var off: int64 := self.slotOff(slot);
        self.emit8(0xF2); self.emit8(0x0F); self.emit8(0x11);       // MOVSD [rbp+disp], xmm0
        if slot < 16 { self.emit8(0x45); self.emit8(off & 0xFF); }
        else { self.emit8(0x85); self.emit32(off); }
    }
    fn emitFsqrt(dest: int64, src1: int64): void {
        self.emitMovsdXmm0FromSlot(src1);
        self.emit8(0xF2); self.emit8(0x0F); self.emit8(0x51); self.emit8(0xC0);  // SQRTSD xmm0, xmm0
        self.emitMovsdSlotFromXmm0(dest);
    }

    // WP-F64: MOVSD xmm1, [rbp+disp]
    fn emitMovsdXmm1FromSlot(slot: int64): void {
        var off: int64 := self.slotOff(slot);
        self.emit8(0xF2); self.emit8(0x0F); self.emit8(0x10);
        if slot < 16 { self.emit8(0x4D); self.emit8(off & 0xFF); }
        else { self.emit8(0x8D); self.emit32(off); }
    }
    // WP-F64: f64-Binop. xmm0=src1, xmm1=src2, op xmm0,xmm1 → dest. opc: addsd 0x58/subsd 0x5C/mulsd 0x59/divsd 0x5E.
    fn emitF64BinOp(opc: int64, dest: int64, src1: int64, src2: int64): void {
        self.emitMovsdXmm0FromSlot(src1);
        self.emitMovsdXmm1FromSlot(src2);
        self.emit8(0xF2); self.emit8(0x0F); self.emit8(opc); self.emit8(0xC1);  // op xmm0, xmm1
        self.emitMovsdSlotFromXmm0(dest);
    }
    // WP-F64: f64-Negation = Vorzeichenbit kippen (kein Float-Op nötig).
    fn emitFneg(dest: int64, src1: int64): void {
        self.emitMovRaxFromSlot(src1);
        self.emit8(0x48); self.emit8(0xB9);   // movabs rcx, 0x8000000000000000
        self.emit8(0x00); self.emit8(0x00); self.emit8(0x00); self.emit8(0x00);
        self.emit8(0x00); self.emit8(0x00); self.emit8(0x00); self.emit8(0x80);
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xC8);   // xor rax, rcx
        self.emitMovSlotFromRax(dest);
    }
    // WP-F64: f64 → int64 (Trunkierung). cvttsd2si rax, xmm0.
    fn emitFtoi(dest: int64, src1: int64): void {
        self.emitMovsdXmm0FromSlot(src1);
        self.emit8(0xF2); self.emit8(0x48); self.emit8(0x0F); self.emit8(0x2C); self.emit8(0xC0);
        self.emitMovSlotFromRax(dest);
    }
    // WP-F64: int64 → f64. cvtsi2sd xmm0, rax.
    fn emitItof(dest: int64, src1: int64): void {
        self.emitMovRaxFromSlot(src1);
        self.emit8(0xF2); self.emit8(0x48); self.emit8(0x0F); self.emit8(0x2A); self.emit8(0xC0);
        self.emitMovsdSlotFromXmm0(dest);
    }
    // WP-F64-CMP: f64-Vergleich. ucomisd xmm0(src1),xmm1(src2); setcc al; movzx → dest (0/1).
    // (NaN-unordered nicht gesondert — wie ELF; akzeptabel.)
    fn emitF64Cmp(setccByte: int64, dest: int64, src1: int64, src2: int64): void {
        self.emitMovsdXmm0FromSlot(src1);
        self.emitMovsdXmm1FromSlot(src2);
        self.emit8(0x66); self.emit8(0x0F); self.emit8(0x2E); self.emit8(0xC1);  // ucomisd xmm0, xmm1
        self.emit8(0x0F); self.emit8(setccByte); self.emit8(0xC0);               // setcc al
        self.emit8(0x0F); self.emit8(0xB6); self.emit8(0xC0);                    // movzx eax, al
        self.emitMovSlotFromRax(dest);
    }

    // WP-SIMD: aligned f32-Buffer allozieren. IN: rcx=Element-Anzahl. OUT: rax=16-Byte-aligned ptr,
    // Anzahl @ [rax-8]. mmap(0, n*4+24, PROT_RW=3, MAP_PRIVATE|ANON=0x22, -1, 0); align (ptr+23)&~15.
    // (Mirror ELF codegen_x86 SIMD_NEW; flags 0x22 = auf Linux gültig → lbf_run-testbar.)
    fn emitSimdAllocFromRcx(): void {
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xC8);   // mov rax, rcx
        self.emit8(0x50);                                        // push rax (count)
        self.emit8(0x48); self.emit8(0xC1); self.emit8(0xE0); self.emit8(0x02);  // shl rax, 2
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC0); self.emit8(0x18);  // add rax, 24
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xFF);   // xor rdi, rdi
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xC6);   // mov rsi, rax
        self.emit8(0x48); self.emit8(0xC7); self.emit8(0xC2); self.emit8(0x03); self.emit8(0x00); self.emit8(0x00); self.emit8(0x00);  // mov rdx, 3
        self.emit8(0x41); self.emit8(0xBA); self.emit8(0x22); self.emit8(0x00); self.emit8(0x00); self.emit8(0x00);  // mov r10d, 0x22
        self.emit8(0x49); self.emit8(0xC7); self.emit8(0xC0); self.emit8(0xFF); self.emit8(0xFF); self.emit8(0xFF); self.emit8(0xFF);  // mov r8, -1
        self.emit8(0x45); self.emit8(0x31); self.emit8(0xC9);   // xor r9d, r9d
        self.emit8(0xB8); self.emit8(0x09); self.emit8(0x00); self.emit8(0x00); self.emit8(0x00);  // mov eax, 9 (mmap)
        self.emit8(0x0F); self.emit8(0x05);                     // syscall
        self.emit8(0x59);                                       // pop rcx (count)
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC0); self.emit8(0x17);  // add rax, 23
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xE0); self.emit8(0xF0);  // and rax, -16
        self.emit8(0x48); self.emit8(0x89); self.emit8(0x48); self.emit8(0xF8);  // mov [rax-8], rcx
    }
    fn emitSimdNew(dest: int64, cntSlot: int64): void {
        self.emitMovRcxFromSlot(cntSlot);
        self.emitSimdAllocFromRcx();
        self.emitMovSlotFromRax(dest);
    }
    // WP-SIMD: vektorisierte f32-Binop. src1/src2=SIMD-ptr-Slots; alloc Ergebnis (gleiche Anzahl);
    // SSE2-Loop (movaps/packed-op/movaps); dest=Ergebnis-ptr. packedOp: addps 0x58/subps 0x5C/mulps 0x59/divps 0x5E.
    fn emitSimdBinOp(packedOp: int64, dest: int64, src1: int64, src2: int64): void {
        self.emitMovRaxFromSlot(src1); self.emit8(0x48); self.emit8(0x89); self.emit8(0xC7);  // mov rdi, rax (lhs)
        self.emitMovRaxFromSlot(src2); self.emit8(0x48); self.emit8(0x89); self.emit8(0xC6);  // mov rsi, rax (rhs)
        self.emit8(0x48); self.emit8(0x8B); self.emit8(0x4F); self.emit8(0xF8);  // mov rcx, [rdi-8] (count)
        self.emit8(0x51); self.emit8(0x57); self.emit8(0x56);                    // push rcx; push rdi; push rsi
        self.emitSimdAllocFromRcx();                                             // rax = dst ptr
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xC2);                    // mov rdx, rax (dst)
        self.emit8(0x5E); self.emit8(0x5F); self.emit8(0x59);                    // pop rsi; pop rdi; pop rcx
        self.emit8(0x31); self.emit8(0xC0);                                      // xor eax, eax
        self.emit8(0x48); self.emit8(0xC1); self.emit8(0xE1); self.emit8(0x02);  // shl rcx, 2 (byte count)
        self.emit8(0x48); self.emit8(0x39); self.emit8(0xC8);                    // loop: cmp rax, rcx
        self.emit8(0x7D); self.emit8(0x15);                                      // jge +21 (done)
        self.emit8(0x0F); self.emit8(0x28); self.emit8(0x04); self.emit8(0x07);  // movaps xmm0, [rdi+rax]
        self.emit8(0x0F); self.emit8(0x28); self.emit8(0x0C); self.emit8(0x06);  // movaps xmm1, [rsi+rax]
        self.emit8(0x0F); self.emit8(packedOp); self.emit8(0xC1);               // packed op xmm0, xmm1
        self.emit8(0x0F); self.emit8(0x29); self.emit8(0x04); self.emit8(0x02);  // movaps [rdx+rax], xmm0
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC0); self.emit8(0x10);  // add rax, 16
        self.emit8(0xEB); self.emit8(0xE6);                                      // jmp loop
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xD0);                    // done: mov rax, rdx
        self.emitMovSlotFromRax(dest);
    }
    // WP-SIMD: f32-Element laden + nach f64. dest=f64-Slot, ptrSlot=SIMD-ptr, idxSlot=Index.
    fn emitSimdLoadElem(dest: int64, ptrSlot: int64, idxSlot: int64): void {
        self.emitMovRaxFromSlot(ptrSlot);
        self.emitMovRcxFromSlot(idxSlot);
        self.emit8(0xF3); self.emit8(0x0F); self.emit8(0x10); self.emit8(0x04); self.emit8(0x88);  // movss xmm0, [rax+rcx*4]
        self.emit8(0xF3); self.emit8(0x0F); self.emit8(0x5A); self.emit8(0xC0);                    // cvtss2sd xmm0, xmm0
        self.emitMovsdSlotFromXmm0(dest);
    }
    // WP-SIMD: f64-Wert nach f32 + Element speichern. idxSlot=Index, valSlot=f64-Wert, ptrSlot=SIMD-ptr.
    fn emitSimdStoreElem(idxSlot: int64, valSlot: int64, ptrSlot: int64): void {
        self.emitMovsdXmm0FromSlot(valSlot);
        self.emit8(0xF2); self.emit8(0x0F); self.emit8(0x5A); self.emit8(0xC0);  // cvtsd2ss xmm0, xmm0
        self.emitMovRaxFromSlot(ptrSlot);
        self.emitMovRcxFromSlot(idxSlot);
        self.emit8(0xF3); self.emit8(0x0F); self.emit8(0x11); self.emit8(0x04); self.emit8(0x88);  // movss [rax+rcx*4], xmm0
    }
    // WP-SIMD: packed f32-Negation (Vorzeichenbit-Flip pro Lane). Unär: dest=Ergebnis-Vektor.
    fn emitSimdNeg(dest: int64, src1: int64): void {
        self.emitMovRaxFromSlot(src1); self.emit8(0x48); self.emit8(0x89); self.emit8(0xC7);  // mov rdi, rax
        self.emit8(0x48); self.emit8(0x8B); self.emit8(0x4F); self.emit8(0xF8);  // mov rcx, [rdi-8] (count)
        self.emit8(0x51); self.emit8(0x57);                                      // push rcx; push rdi
        self.emitSimdAllocFromRcx();                                             // rax = dst
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xC2);                    // mov rdx, rax
        self.emit8(0x5F); self.emit8(0x59);                                      // pop rdi; pop rcx
        self.emit8(0x31); self.emit8(0xC0);                                      // xor eax, eax
        self.emit8(0x48); self.emit8(0xC1); self.emit8(0xE1); self.emit8(0x02);  // shl rcx, 2
        self.emit8(0x48); self.emit8(0x39); self.emit8(0xC8);                    // loop: cmp rax, rcx
        self.emit8(0x7D); self.emit8(0x1A);                                      // jge +26 (done)
        self.emit8(0x0F); self.emit8(0x28); self.emit8(0x04); self.emit8(0x07);  // movaps xmm0, [rdi+rax]
        self.emit8(0x66); self.emit8(0x0F); self.emit8(0x76); self.emit8(0xC9);  // pcmpeqd xmm1, xmm1
        self.emit8(0x66); self.emit8(0x0F); self.emit8(0x72); self.emit8(0xF1); self.emit8(0x1F);  // pslld xmm1, 31
        self.emit8(0x0F); self.emit8(0x57); self.emit8(0xC1);                    // xorps xmm0, xmm1
        self.emit8(0x0F); self.emit8(0x29); self.emit8(0x04); self.emit8(0x02);  // movaps [rdx+rax], xmm0
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC0); self.emit8(0x10);  // add rax, 16
        self.emit8(0xEB); self.emit8(0xE1);                                      // jmp loop (-31)
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xD0);                    // done: mov rax, rdx
        self.emitMovSlotFromRax(dest);
    }
    // WP-SIMD: packed f32-Vergleich (cmpps imm → Masken-Vektor 0xFFFFFFFF/0 pro Lane).
    fn emitSimdCmp(predImm: int64, dest: int64, src1: int64, src2: int64): void {
        self.emitMovRaxFromSlot(src1); self.emit8(0x48); self.emit8(0x89); self.emit8(0xC7);  // mov rdi, rax (lhs)
        self.emitMovRaxFromSlot(src2); self.emit8(0x48); self.emit8(0x89); self.emit8(0xC6);  // mov rsi, rax (rhs)
        self.emit8(0x48); self.emit8(0x8B); self.emit8(0x4F); self.emit8(0xF8);  // mov rcx, [rdi-8]
        self.emit8(0x51); self.emit8(0x57); self.emit8(0x56);                    // push rcx; push rdi; push rsi
        self.emitSimdAllocFromRcx();                                             // rax = dst
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xC2);                    // mov rdx, rax
        self.emit8(0x5E); self.emit8(0x5F); self.emit8(0x59);                    // pop rsi; pop rdi; pop rcx
        self.emit8(0x31); self.emit8(0xC0);                                      // xor eax, eax
        self.emit8(0x48); self.emit8(0xC1); self.emit8(0xE1); self.emit8(0x02);  // shl rcx, 2
        self.emit8(0x48); self.emit8(0x39); self.emit8(0xC8);                    // loop: cmp rax, rcx
        self.emit8(0x7D); self.emit8(0x16);                                      // jge +22 (done)
        self.emit8(0x0F); self.emit8(0x28); self.emit8(0x04); self.emit8(0x07);  // movaps xmm0, [rdi+rax]
        self.emit8(0x0F); self.emit8(0x28); self.emit8(0x0C); self.emit8(0x06);  // movaps xmm1, [rsi+rax]
        self.emit8(0x0F); self.emit8(0xC2); self.emit8(0xC1); self.emit8(predImm);  // cmpps xmm0, xmm1, imm
        self.emit8(0x0F); self.emit8(0x29); self.emit8(0x04); self.emit8(0x02);  // movaps [rdx+rax], xmm0
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC0); self.emit8(0x10);  // add rax, 16
        self.emit8(0xEB); self.emit8(0xE5);                                      // jmp loop (-27)
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xD0);                    // done: mov rax, rdx
        self.emitMovSlotFromRax(dest);
    }

    // LYXOS-WP-1: MOV rcx, [rbp+disp] — zweiter Binop-Operand.
    fn emitMovRcxFromSlot(slot: int64): void {
        var off: int64 := self.slotOff(slot);
        if slot < 16 {
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0x4D); self.emit8(off & 0xFF);
        } else {
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0x8D); self.emit32(off);
        }
    }

    // LYXOS-WP-1: dest = src1 OP src2 — rax=src1, rcx=src2, op, → dest.
    fn emitBinOp(op: int64, dest: int64, src1: int64, src2: int64): void {
        self.emitMovRaxFromSlot(src1);
        self.emitMovRcxFromSlot(src2);
        if op == 10 {                                                      // ADD
            self.emit8(0x48); self.emit8(0x01); self.emit8(0xC8);
        } else if op == 11 {                                              // SUB
            self.emit8(0x48); self.emit8(0x29); self.emit8(0xC8);
        } else if op == 12 {                                              // MUL (IMUL rax,rcx)
            self.emit8(0x48); self.emit8(0x0F); self.emit8(0xAF); self.emit8(0xC1);
        } else if op == 13 {                                              // DIV (CQO; IDIV rcx → rax)
            self.emit8(0x48); self.emit8(0x99);
            self.emit8(0x48); self.emit8(0xF7); self.emit8(0xF9);
        } else if op == 14 {                                              // MOD (… → rdx → rax)
            self.emit8(0x48); self.emit8(0x99);
            self.emit8(0x48); self.emit8(0xF7); self.emit8(0xF9);
            self.emit8(0x48); self.emit8(0x89); self.emit8(0xD0);         // MOV rax, rdx
        } else if op == 51 || op == 55 {                                  // AND / BITAND
            self.emit8(0x48); self.emit8(0x21); self.emit8(0xC8);
        } else if op == 52 || op == 56 {                                  // OR / BITOR
            self.emit8(0x48); self.emit8(0x09); self.emit8(0xC8);
        } else if op == 54 || op == 57 {                                  // XOR / BITXOR
            self.emit8(0x48); self.emit8(0x31); self.emit8(0xC8);
        } else if op == 59 {                                              // SHL rax, cl
            self.emit8(0x48); self.emit8(0xD3); self.emit8(0xE0);
        } else if op == 60 {                                              // SHR rax, cl
            self.emit8(0x48); self.emit8(0xD3); self.emit8(0xE8);
        } else {                                                          // Vergleiche 30..35
            self.emit8(0x48); self.emit8(0x39); self.emit8(0xC8);         // CMP rax, rcx
            var cc: int64 := 0x94;                                        // default sete
            if op == 31 { cc := 0x95; }                                   // NEQ setne
            if op == 32 { cc := 0x9C; }                                   // LT  setl
            if op == 33 { cc := 0x9E; }                                   // LE  setle
            if op == 34 { cc := 0x9F; }                                   // GT  setg
            if op == 35 { cc := 0x9D; }                                   // GE  setge
            self.emit8(0x0F); self.emit8(cc); self.emit8(0xC0);           // SETcc al
            self.emit8(0x48); self.emit8(0x0F); self.emit8(0xB6); self.emit8(0xC0); // MOVZX rax, al
        }
        self.emitMovSlotFromRax(dest);
    }

    // LYXOS-WP-1: dest = -src1 (NEG).
    fn emitNeg(dest: int64, src1: int64): void {
        self.emitMovRaxFromSlot(src1);
        self.emit8(0x48); self.emit8(0xF7); self.emit8(0xD8);             // NEG rax
        self.emitMovSlotFromRax(dest);
    }

    // ── LYXOS-WP-2: Control-Flow ────────────────────────────────────────────────
    fn ensureLabelCap(id: int64): void {
        if id < self.labelCap { return; }
        var nc: int64 := self.labelCap * 2;
        while nc <= id { nc := nc * 2; }
        var nb: int64 := alloc(nc * 8);
        var i: int64 := 0;
        while i < self.labelCap { poke64(nb + i * 8, peek64(self.labelAddrs + i * 8)); i := i + 1; }
        while i < nc { poke64(nb + i * 8, 0 - 1); i := i + 1; }
        self.labelAddrs := nb;
        self.labelCap := nc;
    }

    fn emitLabelDef(id: int64): void {
        self.ensureLabelCap(id);
        poke64(self.labelAddrs + id * 8, self.codeLen);
    }

    fn recordJmpPatch(relOff: int64, labelId: int64): void {
        var need: int64 := (self.jmpPatchCount + 1) * 16;
        if need > self.jmpPatchCap {
            var nc: int64 := self.jmpPatchCap * 2;
            var nb: int64 := alloc(nc);
            memcpy(nb, self.jmpPatchBuf, self.jmpPatchCount * 16);
            self.jmpPatchBuf := nb;
            self.jmpPatchCap := nc;
        }
        var rec: int64 := self.jmpPatchBuf + self.jmpPatchCount * 16;
        poke64(rec + 0, relOff);
        poke64(rec + 8, labelId);
        self.jmpPatchCount := self.jmpPatchCount + 1;
    }

    fn emitJmpToLabel(labelId: int64): void {
        self.emit8(0xE9);                 // JMP rel32
        var relOff: int64 := self.codeLen;
        self.emit32(0);
        self.recordJmpPatch(relOff, labelId);
    }

    // jumpIfTrue!=0 → JNZ (BR_TRUE), sonst JZ (BR_FALSE).
    fn emitBrCond(condSlot: int64, labelId: int64, jumpIfTrue: int64): void {
        self.emitMovRaxFromSlot(condSlot);
        self.emit8(0x48); self.emit8(0x85); self.emit8(0xC0);   // TEST rax, rax
        self.emit8(0x0F);
        if jumpIfTrue != 0 { self.emit8(0x85); } else { self.emit8(0x84); }  // JNZ / JZ rel32
        var relOff: int64 := self.codeLen;
        self.emit32(0);
        self.recordJmpPatch(relOff, labelId);
    }

    fn applyJmpPatches(): void {
        var i: int64 := 0;
        while i < self.jmpPatchCount {
            var rec:     int64 := self.jmpPatchBuf + i * 16;
            var relOff:  int64 := peek64(rec + 0);
            var labelId: int64 := peek64(rec + 8);
            var target:  int64 := 0 - 1;
            if labelId < self.labelCap { target := peek64(self.labelAddrs + labelId * 8); }
            if target >= 0 {
                self.patch32(relOff, target - (relOff + 4));
            }
            i := i + 1;
        }
    }

    // ── LYXOS-WP-3: Globals (RIP-relativer Zugriff auf angehängten Daten-Pool) ──
    fn recordGlobalPatch(dispOff: int64, gIdx: int64): void {
        var need: int64 := (self.globalPatchCount + 1) * 16;
        if need > self.globalPatchCap {
            var nc: int64 := self.globalPatchCap * 2;
            var nb: int64 := alloc(nc);
            memcpy(nb, self.globalPatchBuf, self.globalPatchCount * 16);
            self.globalPatchBuf := nb;
            self.globalPatchCap := nc;
        }
        var rec: int64 := self.globalPatchBuf + self.globalPatchCount * 16;
        poke64(rec + 0, dispOff);
        poke64(rec + 8, gIdx);
        self.globalPatchCount := self.globalPatchCount + 1;
    }

    // ── LYXOS-WP-4: Fields + Index (structs/arrays) ────────────────────────────
    // dest = *(base + fieldOff)
    fn emitLoadField(dest: int64, base: int64, fieldOff: int64): void {
        self.emitMovRaxFromSlot(base);
        self.emit8(0x48); self.emit8(0x8B); self.emit8(0x80); self.emit32(fieldOff);  // MOV rax,[rax+off]
        self.emitMovSlotFromRax(dest);
    }

    // *(base + fieldOff) = value
    fn emitStoreField(fieldOff: int64, value: int64, base: int64): void {
        self.emitMovRaxFromSlot(value);
        self.emitMovRcxFromSlot(base);
        self.emit8(0x48); self.emit8(0x89); self.emit8(0x81); self.emit32(fieldOff);  // MOV [rcx+off],rax
    }

    // dest = base[idx]   (8-Byte-Elemente)
    fn emitLoadIdx(dest: int64, base: int64, idx: int64): void {
        self.emitMovRaxFromSlot(base);
        self.emitMovRcxFromSlot(idx);
        self.emit8(0x48); self.emit8(0x8B); self.emit8(0x04); self.emit8(0xC8);        // MOV rax,[rax+rcx*8]
        self.emitMovSlotFromRax(dest);
    }

    // base[idx] = value   (8-Byte-Elemente)
    fn emitStoreIdx(idx: int64, value: int64, base: int64): void {
        self.emitMovRaxFromSlot(value);
        self.emitMovRcxFromSlot(idx);
        self.emitMovRdxFromSlot(base);
        self.emit8(0x48); self.emit8(0x89); self.emit8(0x04); self.emit8(0xCA);        // MOV [rdx+rcx*8],rax
    }

    // WP-STUB: kontrollierter Abbruch (sys_exit 60, code 1) — exakt 12 Bytes (jnz/jb-Offset!).
    fn emitPanicExit(): void {
        self.emit8(0xBF); self.emit32(1);    // mov edi, 1   (Exit-Code)
        self.emit8(0xB8); self.emit32(60);   // mov eax, 60  (sys_exit)
        self.emit8(0x0F); self.emit8(0x05);  // syscall
    }

    // WP-STUB: indirekter Call (Funktions-Pointer). fnPtrSlot=Slot mit Adresse, argCount Args
    // in Slots 0..argCount-1 (System-V), Result rax→dest. (CALL_INDIRECT aus _indirect_call_N.)
    fn emitCallIndirect(fnPtrSlot: int64, argCount: int64, dest: int64): void {
        if argCount >= 1 { self.emitMovRdiFromSlot(0); }
        if argCount >= 2 { self.emitMovRsiFromSlot(1); }
        if argCount >= 3 { self.emitMovRdxFromSlot(2); }
        if argCount >= 4 { self.emitMovRcxFromSlot(3); }
        if argCount >= 5 { self.emitMovR8FromSlot(4); }
        self.emitMovRaxFromSlot(fnPtrSlot);  // rax = Funktions-Pointer
        self.emit8(0xFF); self.emit8(0xD0);  // call rax
        self.emitMovSlotFromRax(dest);
    }

    // dest = global[gIdx]   (MOV rax, [rip+disp]; → slot)
    fn emitLoadGlobal(dest: int64, gIdx: int64): void {
        self.emit8(0x48); self.emit8(0x8B); self.emit8(0x05);   // MOV rax, [rip+disp32]
        var dispOff: int64 := self.codeLen;
        self.emit32(0);
        self.recordGlobalPatch(dispOff, gIdx);
        self.emitMovSlotFromRax(dest);
    }

    // global[gIdx] = src1   (rax=src1; MOV [rip+disp], rax)
    fn emitStoreGlobal(gIdx: int64, src1: int64): void {
        self.emitMovRaxFromSlot(src1);
        self.emit8(0x48); self.emit8(0x89); self.emit8(0x05);   // MOV [rip+disp32], rax
        var dispOff: int64 := self.codeLen;
        self.emit32(0);
        self.recordGlobalPatch(dispOff, gIdx);
    }

    // dest = &global[gIdx]  (LEA rax, [rip+disp]; → slot)
    fn emitLoadGlobalAddr(dest: int64, gIdx: int64): void {
        self.emit8(0x48); self.emit8(0x8D); self.emit8(0x05);   // LEA rax, [rip+disp32]
        var dispOff: int64 := self.codeLen;
        self.emit32(0);
        self.recordGlobalPatch(dispOff, gIdx);
        self.emitMovSlotFromRax(dest);
    }

    // Hängt den Globals-Daten-Pool ans Code an (8 B je Global, Init-Werte aus dem
    // IR-Modul globalBuffer) und patcht alle RIP-relativen Disp32. IR_MOD_OFF_GLOBALBUF=104,
    // IR_MOD_OFF_GLOBALLEN=120.
    fn emitGlobalsPool(): void {
        var gCount: int64 := peek64(self.irMod + 120);
        var gBuf:   int64 := peek64(self.irMod + 104);
        self.globalsBase := self.codeLen;
        var i: int64 := 0;
        while i < gCount {
            self.emit64(peek64(gBuf + i * 8));   // Init-Wert (oder 0)
            i := i + 1;
        }
        // #1728: ein Wort HINTER den Programm-Globalen fuer den Zustand des
        // Zufallsgenerators. xorshift64 traegt seinen Zustand zwischen den
        // Aufrufen; auf x86 liegt er in CG_RAND_STATE im Datenbereich, hier
        // bekommt er einen eigenen Platz am Ende des Pools.
        //
        // 0 ist der Startwert und bedeutet "noch nicht gesetzt" — xorshift64
        // darf nicht mit 0 laufen, sonst bleibt es fuer immer 0. Der Emitter
        // faengt das ab, genau wie der x86-Weg.
        self.emit64(0);
        // RIP-relative Disp32 patchen: disp = (globalsBase + gIdx*8) - (dispOff + 4).
        // gIdx < 0 kennzeichnet das Zustandswort; es liegt bei Index gCount.
        var p: int64 := 0;
        while p < self.globalPatchCount {
            var rec:     int64 := self.globalPatchBuf + p * 16;
            var dispOff: int64 := peek64(rec + 0);
            var gIdx:    int64 := peek64(rec + 8);
            var gEff:    int64 := gIdx;
            if gIdx < 0 { gEff := gCount; }
            self.patch32(dispOff, (self.globalsBase + gEff * 8) - (dispOff + 4));
            p := p + 1;
        }
    }

    // CALL rel32 stub — wired up with real relocation in LX-03+
    // ── LYXOS-call-fix: user-Funktions-Calls (System-V: rdi,rsi,rdx,rcx,r8,r9) ──
    // Arg-Register-Index → REX-Prefix / ModRM-reg-Bits (mod=10 disp32, rm=101=rbp).
    fn _argRegRex(ri: int64): int64 {
        if ri < 4 { return 0x48; }
        return 0x4C;   // r8/r9 brauchen REX.R
    }
    fn _argRegModrm(ri: int64): int64 {
        var rb: int64 := 1;
        if ri == 0 { rb := 7; }       // rdi
        if ri == 1 { rb := 6; }       // rsi
        if ri == 2 { rb := 2; }       // rdx
        if ri == 3 { rb := 1; }       // rcx
        if ri == 4 { rb := 0; }       // r8
        if ri == 5 { rb := 1; }       // r9
        return 0x85 | (rb << 3);      // mod=10, rm=101 (rbp+disp32)
    }
    // <argReg[ri]> := [rbp + slotOff(slot)]
    fn emitMovRegFromSlot(ri: int64, slot: int64): void {
        self.emit8(self._argRegRex(ri)); self.emit8(0x8B); self.emit8(self._argRegModrm(ri));
        self.emit32(self.slotOff(slot));
    }
    // [rbp + slotOff(slot)] := <argReg[ri]>
    fn emitMovSlotFromReg(ri: int64, slot: int64): void {
        self.emit8(self._argRegRex(ri)); self.emit8(0x89); self.emit8(self._argRegModrm(ri));
        self.emit32(self.slotOff(slot));
    }

    fn recordCallPatch(relOff: int64, funcId: int64): void {
        var need: int64 := (self.callPatchCount + 1) * 16;
        if need > self.callPatchCap {
            var nc: int64 := self.callPatchCap * 2;
            var nb: int64 := alloc(nc);
            memcpy(nb, self.callPatchBuf, self.callPatchCount * 16);
            self.callPatchBuf := nb;
            self.callPatchCap := nc;
        }
        var rec: int64 := self.callPatchBuf + self.callPatchCount * 16;
        poke64(rec + 0, relOff);
        poke64(rec + 8, funcId);
        self.callPatchCount := self.callPatchCount + 1;
    }

    fn applyCallPatches(): void {
        var i: int64 := 0;
        while i < self.callPatchCount {
            var rec:    int64 := self.callPatchBuf + i * 16;
            var relOff: int64 := peek64(rec + 0);
            var funcId: int64 := peek64(rec + 8);
            var target: int64 := 0 - 1;
            if funcId >= 0 { if funcId < self.funcCap { target := peek64(self.funcAddrs + funcId * 8); } }
            if target >= 0 {
                self.patch32(relOff, target - (relOff + 4));
            }
            i := i + 1;
        }
    }

    // dest = funcId(args at argBase..argBase+argCount-1)
    fn emitCall(funcId: int64, argBase: int64, argCount: int64, dest: int64): void {
        var ai: int64 := 0;
        while ai < argCount {
            if ai < 6 { self.emitMovRegFromSlot(ai, argBase + ai); }
            ai := ai + 1;
        }
        self.emit8(0xE8);                       // CALL rel32
        var relOff: int64 := self.codeLen;
        self.emit32(0);
        self.recordCallPatch(relOff, funcId);
        self.emitMovSlotFromRax(dest);          // Resultat rax → dest
    }

    // WP-A1: dest = Adresse von Funktion funcId. lea rax,[rip+rel32]; rel32 via callPatch
    // (= funcAddr-(relOff+4), identisch zur CALL-Auflösung). Für fn-ptr-Werte/-Felder.
    fn emitFuncAddr(funcId: int64, dest: int64): void {
        self.emit8(0x48); self.emit8(0x8D); self.emit8(0x05);   // lea rax, [rip+rel32]
        var relOff: int64 := self.codeLen;
        self.emit32(0);
        self.recordCallPatch(relOff, funcId);
        self.emitMovSlotFromRax(dest);
    }

    // LEA rax, [rip + rel32] with forward patch; rel32 resolved in emitStrPool().
    fn emitConstStr(strOff: int64, dest: int64): void {
        self.growStrPatch();
        var pBase:  int64 := self.strPatchBuf + self.strPatchCount * 16;
        var curLen: int64 := self.codeLen;
        poke64(pBase + 0, curLen);
        poke64(pBase + 8, strOff);
        self.strPatchCount := self.strPatchCount + 1;
        self.emit8(0x48); self.emit8(0x8D); self.emit8(0x05);
        self.emit32(0);
        self.emitMovSlotFromRax(dest);
    }

    fn emitStrPool(): void {
        self.rodataBase := self.codeLen;   // LYXOS-WP-5: Ende .text / Start .rodata
        var strBuf:     int64 := peek64(self.irMod + IR_MOD_OFF_STRBUF);
        var strLen:     int64 := peek64(self.irMod + IR_MOD_OFF_STRLEN);
        var poolStart:  int64 := self.codeLen;
        var patchCount: int64 := self.strPatchCount;
        var patchBuf:   int64 := self.strPatchBuf;
        var pi: int64 := 0;
        while pi < patchCount {
            var patchBase: int64 := patchBuf + pi * 16;
            var leaOff: int64 := peek64(patchBase + 0);
            var strOff: int64 := peek64(patchBase + 8);
            var rel32: int64 := (poolStart + strOff) - (leaOff + 7);
            self.patch32(leaOff + 3, rel32);
            pi := pi + 1;
        }
        var si: int64 := 0;
        while si < strLen {
            self.emit8(peek8(strBuf + si));
            si := si + 1;
        }
    }

    fn emitMovRdiFromSlot(slot: int64): void {
        var off: int64 := self.slotOff(slot);
        if slot < 16 {
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0x7D);
            self.emit8(off & 0xFF);
        } else {
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0xBD);
            self.emit32(off);
        }
    }

    fn emitMovR10FromSlot(slot: int64): void {
        var off: int64 := self.slotOff(slot);
        if slot < 16 {
            self.emit8(0x4C); self.emit8(0x8B); self.emit8(0x55);
            self.emit8(off & 0xFF);
        } else {
            self.emit8(0x4C); self.emit8(0x8B); self.emit8(0x95);
            self.emit32(off);
        }
    }

    fn emitMovR8FromSlot(slot: int64): void {
        var off: int64 := self.slotOff(slot);
        if slot < 16 {
            self.emit8(0x4C); self.emit8(0x8B); self.emit8(0x45);
            self.emit8(off & 0xFF);
        } else {
            self.emit8(0x4C); self.emit8(0x8B); self.emit8(0x85);
            self.emit32(off);
        }
    }

    fn emitMovRsiFromSlot(slot: int64): void {
        var off: int64 := self.slotOff(slot);
        if slot < 16 {
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0x75);
            self.emit8(off & 0xFF);
        } else {
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0xB5);
            self.emit32(off);
        }
    }

    fn emitMovRdxFromSlot(slot: int64): void {
        var off: int64 := self.slotOff(slot);
        if slot < 16 {
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0x55);
            self.emit8(off & 0xFF);
        } else {
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0x95);
            self.emit32(off);
        }
    }

    fn emitPrintStr(): void {
        self.emitMovRsiFromSlot(0);                              // rsi = ptr (slot 0)
        self.emitMovRdxFromSlot(1);                              // rdx = len (slot 1, evtl. -1)
        // LYXOS-pchar-fix: len<0 (Sentinel) → strlen(rsi) zur Laufzeit (null-terminierte pchar-Var).
        // len>=0 (Literal-Pfad mit expliziter Länge) → unverändert verwenden.
        self.emit8(0x48); self.emit8(0x85); self.emit8(0xD2);   // TEST rdx, rdx
        self.emit8(0x79); self.emit8(0x0E);                     // JNS havelen (+14)
        self.emit8(0x48); self.emit8(0x31); self.emit8(0xD2);   // XOR rdx, rdx
        self.emit8(0x80); self.emit8(0x3C); self.emit8(0x16); self.emit8(0x00);  // loop: CMP byte[rsi+rdx],0
        self.emit8(0x74); self.emit8(0x05);                     // JE havelen (+5)
        self.emit8(0x48); self.emit8(0xFF); self.emit8(0xC2);   // INC rdx
        self.emit8(0xEB); self.emit8(0xF5);                     // JMP loop (-11)
        // havelen:
        self.emit8(0xBF); self.emit32(1);                       // mov edi, 1 (stdout)
        self.emitMovRaxImm(0x0203);
        self.emitSyscall();
    }

    fn emitPrintInt(): void { self.emitPrintIntFd(1); }     // PrintInt → stdout (fd 1)
    fn emitPrintIntFd(fd: int64): void {
        self.emitMovRaxFromSlot(0);
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xEC); self.emit8(0x20);
        self.emit8(0x45); self.emit8(0x31); self.emit8(0xC0);
        self.emit8(0x48); self.emit8(0x85); self.emit8(0xC0);
        self.emit8(0x79); self.emit8(9);
        self.emit8(0x41); self.emit8(0xB8); self.emit32(1);
        self.emit8(0x48); self.emit8(0xF7); self.emit8(0xD8);
        self.emit8(0x41); self.emit8(0xB9); self.emit32(10);
        self.emit8(0x41); self.emit8(0xBB); self.emit32(23);
        self.emit8(0x31); self.emit8(0xD2);
        self.emit8(0x49); self.emit8(0xF7); self.emit8(0xF1);
        self.emit8(0x83); self.emit8(0xC2); self.emit8(0x30);
        self.emit8(0x42); self.emit8(0x88); self.emit8(0x14); self.emit8(0x1C);
        self.emit8(0x41); self.emit8(0xFF); self.emit8(0xCB);
        self.emit8(0x48); self.emit8(0x85); self.emit8(0xC0);
        self.emit8(0x75); self.emit8(0xEC);
        self.emit8(0x45); self.emit8(0x85); self.emit8(0xC0);
        self.emit8(0x74); self.emit8(8);
        self.emit8(0x42); self.emit8(0xC6); self.emit8(0x04); self.emit8(0x1C); self.emit8(0x2D);
        self.emit8(0x41); self.emit8(0xFF); self.emit8(0xCB);
        self.emit8(0x4A); self.emit8(0x8D); self.emit8(0x74); self.emit8(0x1C); self.emit8(0x01);
        self.emit8(0xBA); self.emit32(23);
        self.emit8(0x44); self.emit8(0x29); self.emit8(0xDA);
        self.emit8(0xBF); self.emit32(fd);                  // mov edi, fd (1=stdout, 2=stderr)
        self.emitMovRaxImm(0x0203);
        self.emitSyscall();
        self.emit8(0x48); self.emit8(0x83); self.emit8(0xC4); self.emit8(0x20);
    }

    // LX-06: generic N-arg LyxOS VFS syscall emitter
    // Args expected in slots 0..argc-1; return value (rdx) stored to dest.
    fn emitVfsSyscall(nr: int64, argc: int64, dest: int64): void {
        self.emitMovRaxImm(nr);
        if argc >= 1 { self.emitMovRdiFromSlot(0); }
        if argc >= 2 { self.emitMovRsiFromSlot(1); }
        if argc >= 3 { self.emitMovRdxFromSlot(2); }
        if argc >= 4 { self.emitMovR10FromSlot(3); }
        if argc >= 5 { self.emitMovR8FromSlot(4); }
        if argc >= 6 {
            // MOV r9, [rbp + slotOff(5)]  — r9=arg6 (REX.R reg=001)
            var off6: int64 := self.slotOff(5);
            if 5 < 16 {
                self.emit8(0x4C); self.emit8(0x8B); self.emit8(0x4D);
                self.emit8(off6 & 0xFF);
            } else {
                self.emit8(0x4C); self.emit8(0x8B); self.emit8(0x8D);
                self.emit32(off6);
            }
        }
        self.emitSyscall();
        self.emit8(0x49); self.emit8(0x89); self.emit8(0xC7);  // MOV r15, rax (LX-21: save error code)
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xD0);  // MOV rax, rdx (LyxOS: rdx=value)
        self.emitMovSlotFromRax(dest);
    }

    // lyxc→LyxOS Gruppe A: wie emitVfsSyscall, aber Args aus HOHEM argBase-Block
    // (Slots argBase..argBase+argc-1) statt fester Slots 0..N — vermeidet das
    // Caller-Local-Aliasing der festen Slots (vgl. #839 argBase-Konvention).
    fn emitVfsSyscallAB(nr: int64, argc: int64, argBase: int64, dest: int64): void {
        self.emitMovRaxImm(nr);
        if argc >= 1 { self.emitMovRdiFromSlot(argBase); }
        if argc >= 2 { self.emitMovRsiFromSlot(argBase + 1); }
        if argc >= 3 { self.emitMovRdxFromSlot(argBase + 2); }
        if argc >= 4 { self.emitMovR10FromSlot(argBase + 3); }
        if argc >= 5 { self.emitMovR8FromSlot(argBase + 4); }
        if argc >= 6 {
            var off6: int64 := self.slotOff(argBase + 5);
            if (argBase + 5) < 16 {
                self.emit8(0x4C); self.emit8(0x8B); self.emit8(0x4D);
                self.emit8(off6 & 0xFF);
            } else {
                self.emit8(0x4C); self.emit8(0x8B); self.emit8(0x8D);
                self.emit32(off6);
            }
        }
        self.emitSyscall();
        self.emit8(0x49); self.emit8(0x89); self.emit8(0xC7);  // MOV r15, rax (Fehlercode)
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xD0);  // MOV rax, rdx (LyxOS: rdx=value)
        self.emitMovSlotFromRax(dest);
    }

    fn emitBuiltinCall(id: int64, argBase: int64, dest: int64): void {
        if id == 1 {
            self.emitPrintStr();
        } else if id == 2 {
            self.emitPrintInt();
        // #1715: allgemeine IDs. 6-9 und 12 (StrSub/StrConcat/StrCopy/
        // PrintFloat/Printf) bleiben bewusst offen und melden weiterhin
        // Fehler — halb umgesetzt waeren sie schlimmer als gar nicht.
        } else if id == 3 {
            self.emitExitFromSlot();
        } else if id == 13 {
            self.emitEPrintStr();
        } else if id == 14 {
            self.emitEPrintNewline();
        } else if id == 15 {
            self.emitStrLen(dest);
        } else if id == 409 {
            self.emitFileReadAll(dest);
        } else if id == 408 {
            self.emitStrFind(dest);
        } else if id == 407 {
            self.emitStrTrim(dest);
        } else if id == 406 {
            self.emitFileSize(dest);
        } else if id == 404 {
            self.emitStrVergleich(dest, 0);
        } else if id == 405 {
            self.emitStrVergleich(dest, 1);
        } else if id == 403 {
            // #1720 Block B: FloatToStr — dieselbe Umwandlung wie PrintFloat
            // (ID 9), nur wird der Zeiger zurueckgegeben statt ausgegeben.
            // Der Formatierer liegt schon vor; hier faellt nur das Schreiben
            // weg.
            self.emitF64ToStrPtr();
            self.emitMovSlotFromRax(dest);
        } else if id == 400 {
            self.emitRoundSd(dest, 1);
        } else if id == 401 {
            self.emitRoundSd(dest, 2);
        } else if id == 402 {
            self.emitRoundSd(dest, 0);
        } else if id == 4 {
            self.emitRandom(dest);
        } else if id == 5 {
            self.emitRandomSeed(dest);
        } else if id == 6 {
            self.emitStrSub(dest);
        } else if id == 9 {
            self.emitPrintFloat();
        } else if id == 17 {
            self.emitNullArg(dest);
        } else if id == 18 {
            self.emitNullArg(dest);
        } else if id == 19 {
            self.emitNullArg(dest);
        } else if id == 16 {
            self.emitIntToStr(dest);
        // ABI: kanonische Nummern aus syscalls.md §10.4 "implementiert" (dezimal).
        // Builtins ohne §10.4-Äquivalent behalten ihre Hex-Design-Nummer (Kernel kennt sie nicht).
        } else if id == 20 { self.emitVfsSyscall(2, 4, dest); }  // sys_open §10.4=2
        else if id == 21 { self.emitVfsSyscall(3, 1, dest); }    // sys_close §10.4=3
        else if id == 22 { self.emitVfsSyscall(0, 3, dest); }    // sys_read §10.4=0
        else if id == 23 { self.emitVfsSyscall(95, 3, dest); }    // sys_write §10.4=95
        else if id == 24 { self.emitVfsSyscall(0x0204, 3, dest); }    // sys_seek
        else if id == 25 { self.emitVfsSyscall(0x0205, 4, dest); }    // sys_stat
        else if id == 26 { self.emitVfsSyscall(135, 2, dest); }    // sys_fstat §10.4=135
        else if id == 27 { self.emitVfsSyscall(139, 3, dest); }    // sys_mkdir §10.4=139
        else if id == 28 { self.emitVfsSyscall(97, 3, dest); }    // sys_unlink §10.4=97
        else if id == 29 { self.emitVfsSyscall(96, 4, dest); }    // sys_rename §10.4=96
        else if id == 30 { self.emitVfsSyscall(0x020A, 3, dest); }    // sys_readdir
        else if id == 31 { self.emitVfsSyscall(0x020B, 2, dest); }    // sys_dup
        else if id == 32 { self.emitVfsSyscall(0x020C, 3, dest); }    // sys_pipe
        else if id == 33 { self.emitVfsSyscall(0x020D, 2, dest); }    // sys_truncate
        else if id == 34 { self.emitVfsSyscall(0x020E, 1, dest); }    // sys_sync
        else if id == 35 { self.emitVfsSyscall(85, 3, dest); }    // sys_mount §10.4=85 (vol_id,disk_id,lba_start)
        else if id == 36 { self.emitVfsSyscall(0x0210, 3, dest); }    // sys_umount
