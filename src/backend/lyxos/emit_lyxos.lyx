            else if id == 167 { lxW17ac := 0; }   // sys_get_mouse_y()
            else if id == 168 { lxW17ac := 0; }   // sys_get_mouse_btn()
            else if id == 169 { lxW17ac := 2; }   // sys_set_mouse_bounds(max_x,max_y)
            else if id == 170 { lxW17ac := 0; }   // sys_win_get_table_phys()
            else if id == 171 { lxW17ac := 0; }   // sys_kbd_poll()
