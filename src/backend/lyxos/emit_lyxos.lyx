    }

    // sys_mmap(hint=0, size, prot=PROT_RW=3, flags=MAP_PRIVATE|MAP_ANON=5) → rdx=addr
    fn emitAlloc(sizeSlot: int64, dest: int64): void {
        self.emitMovRaxImm(0x0100);
        self.emit8(0x31); self.emit8(0xFF);
        self.emitMovRsiFromSlot(sizeSlot);
        self.emit8(0xBA); self.emit32(3);
        self.emit8(0x41); self.emit8(0xBA); self.emit32(5);
        self.emitSyscall();
        self.emit8(0x48); self.emit8(0x89); self.emit8(0xD0);
        self.emitMovSlotFromRax(dest);
    }

    // sys_munmap(addr, size=0)
    fn emitFree(ptrSlot: int64): void {
        self.emitMovRaxImm(0x0101);
        var off: int64 := self.slotOff(ptrSlot);
        if ptrSlot < 16 {
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0x7D);
            self.emit8(off & 0xFF);
        } else {
            self.emit8(0x48); self.emit8(0x8B); self.emit8(0xBD);
            self.emit32(off);
        }
        self.emit8(0x31); self.emit8(0xF6);
        self.emitSyscall();
    }

    // --- IR instruction dispatch ---

    fn emitInstr(idx: int64): void {
        var instrBuf: int64 := peek64(self.irMod + IR_MOD_OFF_INSTRBUF);
        var iBase:    int64 := instrBuf + idx * IR_INSTR_SIZE;
        var op:       int64 := peek64(iBase + 0);
        var dest:     int64 := peek64(iBase + IR_INSTR_OFF_DEST);
        var src1:     int64 := peek64(iBase + IR_INSTR_OFF_SRC1);
        var imm:      int64 := peek64(iBase + IR_INSTR_OFF_IMMINT);
        if op == 0 {                            // IRO_CONST_INT
            self.emitMovRaxImm(imm);
            self.emitMovSlotFromRax(dest);
        } else if op == 1 {                     // IRO_CONST_STR
            self.emitConstStr(imm, dest);
        } else if op == 61 {                    // IRO_LOAD_LOCAL
            self.emitMovRaxFromSlot(src1);
            self.emitMovSlotFromRax(dest);
        } else if op == 62 {                    // IRO_STORE_LOCAL
            self.emitMovRaxFromSlot(src1);
            self.emitMovSlotFromRax(dest);
        } else if op == 80 {                    // IRO_CALL_BUILTIN
            self.emitBuiltinCall(imm, dest);
        } else if op == 164 {                   // IRO_LOAD_ERRVAL (LX-21: rax=r15-shadow)
            self.emit8(0x49); self.emit8(0x8B); self.emit8(0xC7);  // MOV rax, r15
            self.emitMovSlotFromRax(dest);
        } else if op == 81 {                    // IRO_CALL
            self.emitCall(src1, dest);
        } else if op == 94 {                    // IRO_FUNC_EXIT
            self.emitMovRaxFromSlot(src1);
            self.emitEpilogue();
        } else if op == 112 {                   // IRO_ALLOC
            self.emitAlloc(src1, dest);
        } else if op == 113 {                   // IRO_FREE
            self.emitFree(src1);
        }
        // 90 (JMP), 93 (LABEL), all others: no code
    }

    // Emit all IR functions.
    // Returns byte offset of `main` in the output buffer (for _start CALL).
    fn emitFunctions(): int64 {
        var funcBuf:  int64 := peek64(self.irMod + IR_MOD_OFF_FUNCBUF);
        var funcLen:  int64 := peek64(self.irMod + IR_MOD_OFF_FUNCLEN);
        var strBuf:   int64 := peek64(self.irMod + IR_MOD_OFF_STRBUF);
        var mainOff:  int64 := self.codeLen;   // default: first func

        var fi: int64 := 0;
        while fi < funcLen {
            var fBase:       int64 := funcBuf + fi * IR_FUNC_SIZE;
            var fnNameOff:   int64 := peek64(fBase + 0);
            var fnNameLen:   int64 := peek64(fBase + IR_FUNC_OFF_NAMELEN);
            var fnInstrsOff: int64 := peek64(fBase + IR_FUNC_OFF_INSTRSOFF);
            var fnInstrCnt:  int64 := peek64(fBase + IR_FUNC_OFF_INSTRCOUNT);
            var fnLocals:    int64 := peek64(fBase + IR_FUNC_OFF_LOCALCOUNT);

            // Record offset of main()
            if fnNameLen == 4 {
                var p: int64 := strBuf + fnNameOff;
                if peek8(p+0)==109 && peek8(p+1)==97 && peek8(p+2)==105 && peek8(p+3)==110 {
                    mainOff := self.codeLen;
                }
            }

            // INSTRSOFF ist ein Instruktions-INDEX (ir_lower._addFunc speichert
            // funcInstrStart = INSTRLEN-Zähler), kein Byte-Offset — nicht teilen!
            var firstIdx: int64 := fnInstrsOff;
            self.emitPrologue(fnLocals);
            var ii: int64 := 0;
            while ii < fnInstrCnt {
                self.emitInstr(firstIdx + ii);
                ii := ii + 1;
            }
            // Return value already in rax from last instruction (LOAD_LOCAL/FUNC_EXIT)
            self.emitEpilogue();

            fi := fi + 1;
        }
        return mainOff;
    }

    pub fn getCodeBuf(): int64 { return self.codeBuf; }
    pub fn getCodeLen(): int64 { return self.codeLen; }
};

// ---------------------------------------------------------------------------
// LyxOsELFWriter — writes the ELF binary with .note.lyx-abi
// ---------------------------------------------------------------------------

pub type LyxOsELFWriter = class {
    buf: int64;
    len: int64;
    cap: int64;

    // Prefixed elf_ to avoid VMT collision with EmitLyxOS.init/grow/patch32/patch64
    fn elf_init(): void {
        self.cap := 65536;
        self.buf := alloc(self.cap);
        self.len := 0;
    }

    fn elf_grow(need: int64): void {
        if (self.len + need) <= self.cap { return; }
        var nc: int64 := self.cap * 2;
        while nc < (self.len + need) { nc := nc * 2; }
        var nb: int64 := alloc(nc);
        memcpy(nb, self.buf, self.len);
        self.buf := nb;
        self.cap := nc;
    }

    fn elf_w8(v: int64): void {
        self.elf_grow(1);
        poke8(self.buf + self.len, v & 0xFF);
        self.len := self.len + 1;
    }

    fn elf_w16(v: int64): void {
        self.elf_grow(2);
        poke8(self.buf + self.len + 0, v & 0xFF);
        poke8(self.buf + self.len + 1, (v >> 8) & 0xFF);
        self.len := self.len + 2;
    }

    fn elf_w32(v: int64): void {
        self.elf_grow(4);
        poke8(self.buf + self.len + 0,  v        & 0xFF);
        poke8(self.buf + self.len + 1, (v >>  8) & 0xFF);
        poke8(self.buf + self.len + 2, (v >> 16) & 0xFF);
        poke8(self.buf + self.len + 3, (v >> 24) & 0xFF);
        self.len := self.len + 4;
    }

    fn elf_w64(v: int64): void {
        self.elf_grow(8);
        poke8(self.buf + self.len + 0,  v        & 0xFF);
        poke8(self.buf + self.len + 1, (v >>  8) & 0xFF);
        poke8(self.buf + self.len + 2, (v >> 16) & 0xFF);
        poke8(self.buf + self.len + 3, (v >> 24) & 0xFF);
        poke8(self.buf + self.len + 4, (v >> 32) & 0xFF);
        poke8(self.buf + self.len + 5, (v >> 40) & 0xFF);
        poke8(self.buf + self.len + 6, (v >> 48) & 0xFF);
        poke8(self.buf + self.len + 7, (v >> 56) & 0xFF);
        self.len := self.len + 8;
    }

    fn elf_patch32(off: int64, v: int64): void {
        poke8(self.buf + off + 0,  v        & 0xFF);
        poke8(self.buf + off + 1, (v >>  8) & 0xFF);
        poke8(self.buf + off + 2, (v >> 16) & 0xFF);
        poke8(self.buf + off + 3, (v >> 24) & 0xFF);
    }

    fn elf_patch64(off: int64, v: int64): void {
        poke8(self.buf + off + 0,  v        & 0xFF);
        poke8(self.buf + off + 1, (v >>  8) & 0xFF);
        poke8(self.buf + off + 2, (v >> 16) & 0xFF);
        poke8(self.buf + off + 3, (v >> 24) & 0xFF);
        poke8(self.buf + off + 4, (v >> 32) & 0xFF);
        poke8(self.buf + off + 5, (v >> 40) & 0xFF);
        poke8(self.buf + off + 6, (v >> 48) & 0xFF);
        poke8(self.buf + off + 7, (v >> 56) & 0xFF);
    }

    fn elf_padTo(target: int64): void {
        while self.len < target { self.elf_w8(0); }
    }

    // Write the .note.lyx-abi section payload (24 bytes):
    //   namesz=4, descsz=8, type=1, "LYX\0", major=1, minor=0
    fn elf_writeNote(): void {
        self.elf_w32(4);              // namesz: "LYX\0" = 4 bytes
        self.elf_w32(8);              // descsz: major(4) + minor(4) = 8 bytes
        self.elf_w32(1);              // type = 1 (NT_VERSION)
        self.elf_w8(76);              // 'L'
        self.elf_w8(89);              // 'Y'
        self.elf_w8(88);              // 'X'
        self.elf_w8(0);               // '\0'
        self.elf_w32(1);              // major = 1
        self.elf_w32(0);              // minor = 0
    }

    // Build and write the ELF file.
    // codeBuf/codeLen: compiled machine code (_start + functions).
    pub fn writeELF(path: pchar, codeBuf: int64, codeLen: int64): bool {
        self.elf_init();
        if self.buf == 0 { return false; }  // alloc failed

        var pageSize:   int64 := 4096;           // 0x1000
        var baseVaddr:  int64 := 0x400000;
        var codeOff:    int64 := pageSize;        // .text at file offset 0x1000
        var noteOff:    int64 := codeOff + codeLen;
        var noteSize:   int64 := 24;
        var fileSize:   int64 := noteOff + noteSize;

        var entryVaddr: int64 := baseVaddr + codeOff;   // 0x401000 = _start
        var noteVaddr:  int64 := baseVaddr + noteOff;

        // --- ELF header (64 bytes) ---
        // e_ident magic
        self.elf_w8(127); self.elf_w8(69); self.elf_w8(76); self.elf_w8(70);  // \x7fELF
        self.elf_w8(2);   // EI_CLASS = ELFCLASS64
        self.elf_w8(1);   // EI_DATA  = ELFDATA2LSB (little-endian)
        self.elf_w8(1);   // EI_VERSION = EV_CURRENT
        self.elf_w8(0);   // EI_OSABI = ELFOSABI_NONE  (0 = System V / LyxOS)
        self.elf_w64(0);  // EI_ABIVERSION + padding (8 bytes)
        self.elf_w16(2);  // e_type = ET_EXEC
        self.elf_w16(62); // e_machine = EM_X86_64
        self.elf_w32(1);  // e_version = EV_CURRENT
        self.elf_w64(entryVaddr);  // e_entry
        self.elf_w64(64);          // e_phoff = 64 (right after ELF header)
        self.elf_w64(0);           // e_shoff = 0 (no section headers)
        self.elf_w32(0);           // e_flags
        self.elf_w16(64);          // e_ehsize
        self.elf_w16(56);          // e_phentsize
        self.elf_w16(2);           // e_phnum = 2 (PT_LOAD, PT_NOTE)
        self.elf_w16(64);          // e_shentsize
        self.elf_w16(0);           // e_shnum
        self.elf_w16(0);           // e_shstrndx

        // --- Program headers (2 × 56 bytes) ---
        // Bootstrap Bug 4: max 5 explicit args. elf_writePH had 7 → inline instead.
        // PH[0]: PT_LOAD (R-X) — covers entire file
        self.elf_grow(56);
        self.elf_w32(1);           // p_type  = PT_LOAD
        self.elf_w32(5);           // p_flags = R|X
        self.elf_w64(0);           // p_offset
        self.elf_w64(baseVaddr);   // p_vaddr
        self.elf_w64(baseVaddr);   // p_paddr
        self.elf_w64(fileSize);    // p_filesz
        self.elf_w64(fileSize);    // p_memsz
        self.elf_w64(pageSize);    // p_align

        // PH[1]: PT_NOTE (R) — .note.lyx-abi only
        self.elf_grow(56);
        self.elf_w32(4);           // p_type  = PT_NOTE
        self.elf_w32(4);           // p_flags = R
        self.elf_w64(noteOff);     // p_offset
        self.elf_w64(noteVaddr);   // p_vaddr
        self.elf_w64(noteVaddr);   // p_paddr
        self.elf_w64(noteSize);    // p_filesz
        self.elf_w64(noteSize);    // p_memsz
        self.elf_w64(4);           // p_align

        // --- Padding to page boundary ---
        self.elf_padTo(codeOff);

        // --- .text: compiled code ---
        var ci: int64 := 0;
        while ci < codeLen {
            self.elf_w8(peek8(codeBuf + ci));
            ci := ci + 1;
        }

        // --- .note.lyx-abi ---
        self.elf_writeNote();

        // --- Write to file ---
        var fd: int64 := open(path, 577, 493);   // O_WRONLY|O_CREAT|O_TRUNC, 0755
        if fd == -1 { return false; }
        write(fd, self.buf as pchar, self.len);
        close(fd);
        chmod(path, 493);
        return true;
    }

    pub fn elf_getLen(): int64 { return self.len; }
};
