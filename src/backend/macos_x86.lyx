// bootstrap/backend/macos_x86.lyx
// macOS x86_64 backend for the Lyx bootstrap compiler (WP-BC-31).
// Generates Mach-O 64-bit executables for macOS x86_64 using BSD syscall numbers.
// The ISA and ABI (System V AMD64) are identical to the Linux backend;
// only the syscall numbers and binary output format (Mach-O vs ELF) differ.
//
// Strategy: after Codegen.Generate() produces a Linux x86_64 code buffer,
// MacosX86Backend re-emits the helper stubs (offsets 0..286) with BSD syscall
// numbers, then copies the user-function section unchanged (offsets 287+),
// preserving all intra-buffer relative call addresses.

// ============================================================================
// BSD (macOS) Syscall Numbers  — all have the 0x2000000 kernel-call prefix
// ============================================================================


import src.emit_write;
import src.std.alloc;
pub con MACOS_SYS_EXIT:      int64 := 0x2000001;
pub con MACOS_SYS_FORK:      int64 := 0x2000002;
pub con MACOS_SYS_READ:      int64 := 0x2000003;
pub con MACOS_SYS_WRITE:     int64 := 0x2000004;
pub con MACOS_SYS_OPEN:      int64 := 0x2000005;
pub con MACOS_SYS_CLOSE:     int64 := 0x2000006;
pub con MACOS_SYS_GETPID:    int64 := 0x2000014;
pub con MACOS_SYS_UNLINK:    int64 := 0x200000A;
pub con MACOS_SYS_RENAME:    int64 := 0x2000080;
pub con MACOS_SYS_MKDIR:     int64 := 0x2000088;
pub con MACOS_SYS_RMDIR:     int64 := 0x2000089;
pub con MACOS_SYS_MUNMAP:    int64 := 0x2000049;
pub con MACOS_SYS_MMAP:      int64 := 0x20000C5;
pub con MACOS_SYS_LSEEK:     int64 := 0x20000C7;
pub con MACOS_SYS_FCNTL:     int64 := 0x200005C;
// WP-D1: macOS BSD socket syscalls
pub con MACOS_SYS_RECVMSG:   int64 := 0x200001B;
pub con MACOS_SYS_SENDMSG:   int64 := 0x200001C;
pub con MACOS_SYS_RECVFROM:  int64 := 0x200001D;
pub con MACOS_SYS_ACCEPT:    int64 := 0x200001E;
pub con MACOS_SYS_SOCKET:    int64 := 0x2000061;
pub con MACOS_SYS_CONNECT:   int64 := 0x2000062;
pub con MACOS_SYS_BIND:      int64 := 0x2000068;
pub con MACOS_SYS_SETSOCKOPT: int64 := 0x2000069;
pub con MACOS_SYS_LISTEN:    int64 := 0x200006A;
pub con MACOS_SYS_GETSOCKOPT: int64 := 0x2000076;
pub con MACOS_SYS_SENDTO:    int64 := 0x2000085;
pub con MACOS_SYS_SHUTDOWN:  int64 := 0x2000086;
pub con MACOS_SYS_SOCKETPAIR: int64 := 0x2000087;
// macOS mmap flags: MAP_PRIVATE|MAP_ANON
pub con MACOS_MAP_PRIVATE_ANON: int64 := 0x1002;

// ============================================================================
// Mach-O 64 Format Constants
// ============================================================================

con MACOS_MH_MAGIC_64:         int64 := 0xFEEDFACF;
con MACOS_CPU_TYPE_X86_64:     int64 := 0x01000007;
con MACOS_CPU_SUBTYPE_X86_ALL: int64 := 3;
con MACOS_MH_EXECUTE:          int64 := 2;
con MACOS_MH_NOUNDEFS:         int64 := 1;
con MACOS_MH_PIE:              int64 := 0x00200000;
con MACOS_LC_SEGMENT_64:       int64 := 0x19;
con MACOS_LC_MAIN:             int64 := 0x80000028;
con MACOS_VM_PROT_NONE:        int64 := 0;
con MACOS_VM_PROT_READ:        int64 := 1;
con MACOS_VM_PROT_EXEC:        int64 := 4;
con MACOS_S_ATTR_PURE_INSTR:   int64 := 0x80000000;
con MACOS_TEXT_BASE:           int64 := 0x100000000;  // traditional macOS x86_64 base
con MACOS_PAGE_SIZE:           int64 := 0x1000;       // 4 KB (x86_64)

// Size of first 6 helper stubs — MUST match Linux layout so CG_H_STRLEN/PRINTSTR/etc. are correct.
// WP-D1: fixed from 287 to 301 so helpers are at identical offsets as Linux:
//   _start: 0..78 (79 bytes), strlen: 79..93 (15), printstr: 94..119 (26),
//   printint: 120..223 (104), strsub: 224..294 (71), strcharat: 295..300 (6)
// Total: 301 = Linux offset 301 (start of eprint_str), where verbatim copy begins.
con MACOS_HELPERS_SZ:     int64 := 301;
// Linux ELF base and code offset (from codegen_x86.lyx) for VMT patching
con MACOS_LINUX_BASE:     int64 := 4194480;   // CG_ELF_BASE + CG_CODE_OFF = 0x4000B0
// macOS code VA base: MACOS_TEXT_BASE + page (4096)
con MACOS_CODE_BASE:      int64 := 4294971392; // 0x100001000

// ============================================================================
// MacosX86Backend
// ============================================================================

pub type MacosX86Backend = class {

  // Patched code buffer (macOS helpers + copied user functions)
  code:    int64;
  codeLen: int64;
  codeCap: int64;

  // Output buffer for the final Mach-O binary
  out:    int64;
  outLen: int64;
  outCap: int64;

  // WP-D1: VMT patch state (set via SetVMTInfo before WriteMachO)
  vmtPatch:     int64;  // cg.vmtPatches
  vmtCnt:       int64;  // cg.vmtPatchCount
  vmtMeth:      int64;  // cg.vmtMethodPatches
  vmtMethCnt:   int64;  // cg.vmtMethodPatchCount
  cgDataPtr:    int64;  // cg.data
  cgDataLen_:   int64;  // cg.dataLen

  // ------------------------------------------------------------------
  // Code buffer helpers
  // ------------------------------------------------------------------

  fn mxb_cGrow(n: int64) {
    if (self.codeCap >= self.codeLen + n) { return; }
    var nc: int64 := self.codeCap * 2;
    while (nc < self.codeLen + n) { nc := nc * 2; }
    var nb: int64 := alloc(nc);
    var i: int64 := 0;
    while (i < self.codeLen) { poke8(nb + i, peek8(self.code + i)); i := i + 1; }
    self.code    := nb;
    self.codeCap := nc;
  }

  fn mxb_ce8(v: int64) {
    self.mxb_cGrow(1);
    poke8(self.code + self.codeLen, v & 0xFF);
    self.codeLen := self.codeLen + 1;
  }

  fn mxb_ce32(v: int64) {
    self.mxb_ce8(v & 0xFF);
    self.mxb_ce8((v >> 8)  & 0xFF);
    self.mxb_ce8((v >> 16) & 0xFF);
    self.mxb_ce8((v >> 24) & 0xFF);
  }

  // ------------------------------------------------------------------
  // Output buffer helpers
  // ------------------------------------------------------------------

  fn mxb_oGrow(n: int64) {
    if (self.outCap >= self.outLen + n) { return; }
    var nc: int64 := self.outCap * 2;
    while (nc < self.outLen + n) { nc := nc * 2; }
    var nb: int64 := alloc(nc);
    var i: int64 := 0;
    while (i < self.outLen) { poke8(nb + i, peek8(self.out + i)); i := i + 1; }
    self.out    := nb;
    self.outCap := nc;
  }

  fn mxb_oe8(v: int64) {
    self.mxb_oGrow(1);
    poke8(self.out + self.outLen, v & 0xFF);
    self.outLen := self.outLen + 1;
  }

  fn mxb_oe32(v: int64) {
    self.mxb_oe8(v & 0xFF);
    self.mxb_oe8((v >> 8)  & 0xFF);
    self.mxb_oe8((v >> 16) & 0xFF);
    self.mxb_oe8((v >> 24) & 0xFF);
  }

  fn mxb_oe64(v: int64) {
    self.mxb_oe32(v & 0xFFFFFFFF);
    self.mxb_oe32((v >> 32) & 0xFFFFFFFF);
  }

  fn mxb_oZeros(n: int64) {
    var i: int64 := 0;
    while (i < n) { self.mxb_oe8(0); i := i + 1; }
  }

  // Write a NUL-padded 16-byte name field (segname / sectname in Mach-O)
  fn mxb_oName16(s: pchar, sLen: int64) {
    var i: int64 := 0;
    while (i < 16) {
      if (i < sLen) { self.mxb_oe8(StrCharAt(s, i)); } else { self.mxb_oe8(0); }
      i := i + 1;
    }
  }

  // ------------------------------------------------------------------
  // macOS helper stubs
  // All offsets and sizes must match CG_H_USER layout in codegen_x86.lyx.
  // ------------------------------------------------------------------

  // _start / entry (79 bytes, offsets 0..78) — WP-D1: matches Linux _start size.
  // This ensures strlen (79), printstr (94), printint (120), etc. are at correct offsets.
  // Layout:
  //  [0..47]:  48 NOPs
  //  [48..52]: E8 rel32 — call main (argc in rdi, argv in rsi from LC_MAIN)
  //  [53..55]: 48 89 C7 — mov rdi, rax (pass main's return value to exit)
  //  [56..71]: 16 NOPs (padding to 72)
  //  [72..76]: B8 01 00 00 02 — mov eax, 0x2000001 (MACOS_SYS_EXIT)
  //  [77..78]: 0F 05 — syscall
  //  Total: 48+5+3+16+5+2 = 79 bytes ✓
  fn mxb_emitStart(rel32: int64) {
    var i: int64 := 0;
    while (i < 48) { self.mxb_ce8(0x90); i := i + 1; }         // [0..47] 48 NOPs
    self.mxb_ce8(0xE8); self.mxb_ce32(rel32);                    // [48..52] call main
    self.mxb_ce8(0x48); self.mxb_ce8(0x89); self.mxb_ce8(0xC7); // [53..55] mov rdi, rax
    i := 0;
    while (i < 16) { self.mxb_ce8(0x90); i := i + 1; }         // [56..71] 16 NOPs
    self.mxb_ce8(0xB8);                                           // [72] mov eax, imm32
    self.mxb_ce8(0x01); self.mxb_ce8(0x00); self.mxb_ce8(0x00); self.mxb_ce8(0x02); // [73..76] MACOS_SYS_EXIT
    self.mxb_ce8(0x0F); self.mxb_ce8(0x05);                      // [77..78] syscall
  }

  // _lyx_strlen (15 bytes, offset 65..79) — no syscalls, identical to Linux
  fn mxb_emitStrlen() {
    self.mxb_ce8(0x48); self.mxb_ce8(0x31); self.mxb_ce8(0xC0);        // xor rax, rax
    self.mxb_ce8(0x80); self.mxb_ce8(0x3C); self.mxb_ce8(0x07); self.mxb_ce8(0x00); // cmp byte[rdi+rax], 0
    self.mxb_ce8(0x74); self.mxb_ce8(0x05);                             // jz +5
    self.mxb_ce8(0x48); self.mxb_ce8(0xFF); self.mxb_ce8(0xC0);        // inc rax
    self.mxb_ce8(0xEB); self.mxb_ce8(0xF5);                             // jmp -11
    self.mxb_ce8(0xC3);                                                  // ret
  }

  // _lyx_print_str (26 bytes, offset 80..105) — MACOS_SYS_WRITE
  fn mxb_emitPrintStr() {
    self.mxb_ce8(0x57);                                                  // push rdi
    self.mxb_ce8(0xE8); self.mxb_ce32(-21);                             // call strlen (next=86, target=65, rel=-21)
    self.mxb_ce8(0x48); self.mxb_ce8(0x89); self.mxb_ce8(0xC2);        // mov rdx, rax
    self.mxb_ce8(0x5F);                                                  // pop rdi
    self.mxb_ce8(0x48); self.mxb_ce8(0x89); self.mxb_ce8(0xFE);        // mov rsi, rdi
    self.mxb_ce8(0xBF); self.mxb_ce8(0x01); self.mxb_ce8(0x00); self.mxb_ce8(0x00); self.mxb_ce8(0x00); // mov edi, 1
    self.mxb_ce8(0xB8); self.mxb_ce8(0x04); self.mxb_ce8(0x00); self.mxb_ce8(0x00); self.mxb_ce8(0x02); // mov eax, MACOS_SYS_WRITE
    self.mxb_ce8(0x0F); self.mxb_ce8(0x05);                             // syscall
    self.mxb_ce8(0xC3);                                                  // ret
  }

  // _lyx_print_int (104 bytes, offset 106..209) — MACOS_SYS_WRITE
  fn mxb_emitPrintInt() {
    self.mxb_ce8(0x48); self.mxb_ce8(0x83); self.mxb_ce8(0xEC); self.mxb_ce8(0x18); // sub rsp, 24
    self.mxb_ce8(0x48); self.mxb_ce8(0x8D); self.mxb_ce8(0x74); self.mxb_ce8(0x24); self.mxb_ce8(0x17); // lea rsi, [rsp+23]
    self.mxb_ce8(0x48); self.mxb_ce8(0x89); self.mxb_ce8(0xF8);        // mov rax, rdi
    self.mxb_ce8(0x48); self.mxb_ce8(0x85); self.mxb_ce8(0xC0);        // test rax, rax
    self.mxb_ce8(0x75); self.mxb_ce8(0x08);                             // jnz +8
    self.mxb_ce8(0xC6); self.mxb_ce8(0x06); self.mxb_ce8(0x30);        // mov byte[rsi], '0'
    self.mxb_ce8(0x48); self.mxb_ce8(0xFF); self.mxb_ce8(0xCE);        // dec rsi
    self.mxb_ce8(0xEB); self.mxb_ce8(0x30);                             // jmp +48
    self.mxb_ce8(0x48); self.mxb_ce8(0x85); self.mxb_ce8(0xC0);        // test rax, rax
    self.mxb_ce8(0x7D); self.mxb_ce8(0x03);                             // jge +3
    self.mxb_ce8(0x48); self.mxb_ce8(0xF7); self.mxb_ce8(0xD8);        // neg rax
    self.mxb_ce8(0x48); self.mxb_ce8(0x85); self.mxb_ce8(0xC0);        // test rax, rax
    self.mxb_ce8(0x74); self.mxb_ce8(0x18);                             // jz +24
    self.mxb_ce8(0x48); self.mxb_ce8(0x31); self.mxb_ce8(0xD2);        // xor rdx, rdx
    self.mxb_ce8(0x48); self.mxb_ce8(0xC7); self.mxb_ce8(0xC1); self.mxb_ce8(0x0A); self.mxb_ce8(0x00); self.mxb_ce8(0x00); self.mxb_ce8(0x00); // mov rcx, 10
    self.mxb_ce8(0x48); self.mxb_ce8(0xF7); self.mxb_ce8(0xF9);        // idiv rcx
    self.mxb_ce8(0x48); self.mxb_ce8(0x83); self.mxb_ce8(0xC2); self.mxb_ce8(0x30); // add rdx, 48
    self.mxb_ce8(0x88); self.mxb_ce8(0x16);                             // mov [rsi], dl
    self.mxb_ce8(0x48); self.mxb_ce8(0xFF); self.mxb_ce8(0xCE);        // dec rsi
    self.mxb_ce8(0xEB); self.mxb_ce8(0xE3);                             // jmp -29
    self.mxb_ce8(0x48); self.mxb_ce8(0x85); self.mxb_ce8(0xFF);        // test rdi, rdi
    self.mxb_ce8(0x79); self.mxb_ce8(0x06);                             // jns +6
    self.mxb_ce8(0xC6); self.mxb_ce8(0x06); self.mxb_ce8(0x2D);        // mov byte[rsi], '-'
    self.mxb_ce8(0x48); self.mxb_ce8(0xFF); self.mxb_ce8(0xCE);        // dec rsi
    self.mxb_ce8(0x48); self.mxb_ce8(0xFF); self.mxb_ce8(0xC6);        // inc rsi
    self.mxb_ce8(0x48); self.mxb_ce8(0x8D); self.mxb_ce8(0x54); self.mxb_ce8(0x24); self.mxb_ce8(0x17); // lea rdx, [rsp+23]
    self.mxb_ce8(0x48); self.mxb_ce8(0x29); self.mxb_ce8(0xF2);        // sub rdx, rsi
    self.mxb_ce8(0x48); self.mxb_ce8(0xFF); self.mxb_ce8(0xC2);        // inc rdx
    self.mxb_ce8(0xBF); self.mxb_ce8(0x01); self.mxb_ce8(0x00); self.mxb_ce8(0x00); self.mxb_ce8(0x00); // mov edi, 1
    self.mxb_ce8(0xB8); self.mxb_ce8(0x04); self.mxb_ce8(0x00); self.mxb_ce8(0x00); self.mxb_ce8(0x02); // mov eax, MACOS_SYS_WRITE
    self.mxb_ce8(0x0F); self.mxb_ce8(0x05);                             // syscall
    self.mxb_ce8(0x48); self.mxb_ce8(0x83); self.mxb_ce8(0xC4); self.mxb_ce8(0x18); // add rsp, 24
    self.mxb_ce8(0xC3);                                                  // ret
  }

  // _lyx_strsub (71 bytes, offset 210..280) — MACOS_SYS_MMAP
  fn mxb_emitStrSub() {
    self.mxb_ce8(0x57);                                                  // push rdi
    self.mxb_ce8(0x56);                                                  // push rsi
    self.mxb_ce8(0x52);                                                  // push rdx
    self.mxb_ce8(0x48); self.mxb_ce8(0xC7); self.mxb_ce8(0xC7); self.mxb_ce8(0x00); self.mxb_ce8(0x00); self.mxb_ce8(0x00); self.mxb_ce8(0x00); // mov rdi, 0
    self.mxb_ce8(0x48); self.mxb_ce8(0x8D); self.mxb_ce8(0x54); self.mxb_ce8(0x24); self.mxb_ce8(0x10); // lea rsi, [rsp+16]
    self.mxb_ce8(0xBA); self.mxb_ce8(0x03); self.mxb_ce8(0x00); self.mxb_ce8(0x00); self.mxb_ce8(0x00); // mov edx, 3
    self.mxb_ce8(0x49); self.mxb_ce8(0xC7); self.mxb_ce8(0xC2); self.mxb_ce8(0x02); self.mxb_ce8(0x10); self.mxb_ce8(0x00); self.mxb_ce8(0x00); // mov r10, 0x1002 (MAP_PRIVATE|MAP_ANON macOS)
    self.mxb_ce8(0x49); self.mxb_ce8(0xC7); self.mxb_ce8(0xC0); self.mxb_ce8(0xFF); self.mxb_ce8(0xFF); self.mxb_ce8(0xFF); self.mxb_ce8(0xFF); // mov r8, -1
    self.mxb_ce8(0x49); self.mxb_ce8(0xC7); self.mxb_ce8(0xC1); self.mxb_ce8(0x00); self.mxb_ce8(0x00); self.mxb_ce8(0x00); self.mxb_ce8(0x00); // mov r9, 0
    self.mxb_ce8(0xB8); self.mxb_ce8(0xC5); self.mxb_ce8(0x00); self.mxb_ce8(0x00); self.mxb_ce8(0x02); // mov eax, MACOS_SYS_MMAP
    self.mxb_ce8(0x0F); self.mxb_ce8(0x05);                             // syscall
    self.mxb_ce8(0x48); self.mxb_ce8(0x89); self.mxb_ce8(0x44); self.mxb_ce8(0x24); self.mxb_ce8(0x18); // mov [rsp+24], rax
    self.mxb_ce8(0x5A);                                                  // pop rcx
    self.mxb_ce8(0x5E);                                                  // pop rsi
    self.mxb_ce8(0x5F);                                                  // pop rdi
    self.mxb_ce8(0x48); self.mxb_ce8(0x01); self.mxb_ce8(0xFE);        // add rsi, rdi
    self.mxb_ce8(0x48); self.mxb_ce8(0x89); self.mxb_ce8(0xC7);        // mov rdi, rax
    self.mxb_ce8(0xF3); self.mxb_ce8(0xA4);                             // rep movsb
    self.mxb_ce8(0x48); self.mxb_ce8(0x01); self.mxb_ce8(0xC8);        // add rax, rcx
    self.mxb_ce8(0xC6); self.mxb_ce8(0x00); self.mxb_ce8(0x00);        // mov byte[rax], 0
    self.mxb_ce8(0xC3);                                                  // ret
  }

  // _lyx_strcharat (6 bytes, offset 295..300) — no syscalls, identical to Linux
  fn mxb_emitStrCharAt() {
    self.mxb_ce8(0x48); self.mxb_ce8(0x0F); self.mxb_ce8(0xB6); self.mxb_ce8(0x04); self.mxb_ce8(0x37); // movzx rax, byte[rdi+rsi]
    self.mxb_ce8(0xC3);                                                  // ret
  }

  // ------------------------------------------------------------------
  // WP-D1: Linux→macOS syscall number translation
  // Returns 0 if the Linux syscall has no known macOS equivalent.
  // ------------------------------------------------------------------
  fn mxb_linuxToMacos(linuxNum: int64): int64 {
    if linuxNum == 1   { return MACOS_SYS_WRITE;      }  // write
    if linuxNum == 2   { return MACOS_SYS_CLOSE;      }  // close
    if linuxNum == 3   { return MACOS_SYS_READ;       }  // read
    if linuxNum == 5   { return MACOS_SYS_OPEN;       }  // open
    if linuxNum == 9   { return MACOS_SYS_MMAP;       }  // mmap
    if linuxNum == 11  { return MACOS_SYS_MUNMAP;     }  // munmap
    if linuxNum == 41  { return MACOS_SYS_SOCKET;     }  // socket
    if linuxNum == 42  { return MACOS_SYS_CONNECT;    }  // connect
    if linuxNum == 43  { return MACOS_SYS_ACCEPT;     }  // accept
    if linuxNum == 44  { return MACOS_SYS_SENDTO;     }  // sendto
    if linuxNum == 45  { return MACOS_SYS_RECVFROM;   }  // recvfrom
    if linuxNum == 46  { return MACOS_SYS_SENDMSG;    }  // sendmsg
    if linuxNum == 47  { return MACOS_SYS_RECVMSG;    }  // recvmsg
    if linuxNum == 48  { return MACOS_SYS_SHUTDOWN;   }  // shutdown
    if linuxNum == 49  { return MACOS_SYS_BIND;       }  // bind
    if linuxNum == 50  { return MACOS_SYS_LISTEN;     }  // listen
    if linuxNum == 53  { return MACOS_SYS_SOCKETPAIR; }  // socketpair
    if linuxNum == 54  { return MACOS_SYS_SETSOCKOPT; }  // setsockopt
    if linuxNum == 55  { return MACOS_SYS_GETSOCKOPT; }  // getsockopt
    if linuxNum == 57  { return MACOS_SYS_FORK;       }  // fork
    if linuxNum == 60  { return MACOS_SYS_EXIT;       }  // exit
    if linuxNum == 72  { return MACOS_SYS_FCNTL;      }  // fcntl
    if linuxNum == 231 { return MACOS_SYS_EXIT;       }  // exit_group
    return 0;
  }

  // WP-D1: Patch Linux syscall numbers in the code buffer (offsets startOff..codeLen).
  // Handles both 10-byte form (48 B8 <imm64> 0F 05) from user code
  // and 5-byte form (B8 <imm32> 0F 05) from verbatim-copied Linux helper stubs.
  fn mxb_patchCode(startOff: int64) {
    var i: int64 := startOff;
    var linuxNum: int64 := 0;
    var macosNum: int64 := 0;
    while (i < self.codeLen - 7) {
      // 10-byte REX.W form: 48 B8 <8-byte LE imm64> 0F 05
      if peek8(self.code + i) == 0x48 && peek8(self.code + i + 1) == 0xB8 &&
         peek8(self.code + i + 6) == 0 && peek8(self.code + i + 7) == 0 &&
         peek8(self.code + i + 8) == 0 && peek8(self.code + i + 9) == 0 &&
         peek8(self.code + i + 10) == 0x0F && peek8(self.code + i + 11) == 0x05 {
        linuxNum := peek8(self.code + i + 2) | (peek8(self.code + i + 3) << 8) |
                    (peek8(self.code + i + 4) << 16) | (peek8(self.code + i + 5) << 24);
        macosNum := self.mxb_linuxToMacos(linuxNum);
        if macosNum != 0 {
          poke8(self.code + i + 2,  macosNum & 0xFF);
          poke8(self.code + i + 3, (macosNum >> 8) & 0xFF);
          poke8(self.code + i + 4, (macosNum >> 16) & 0xFF);
          poke8(self.code + i + 5, (macosNum >> 24) & 0xFF);
          i := i + 11; // skip past the patched instruction
        }
      // 5-byte form: B8 <4-byte LE imm32> 0F 05
      } else if peek8(self.code + i) == 0xB8 &&
                peek8(self.code + i + 5) == 0x0F && peek8(self.code + i + 6) == 0x05 {
        linuxNum := peek8(self.code + i + 1) | (peek8(self.code + i + 2) << 8) |
                    (peek8(self.code + i + 3) << 16) | (peek8(self.code + i + 4) << 24);
        macosNum := self.mxb_linuxToMacos(linuxNum);
        if macosNum != 0 {
          poke8(self.code + i + 1,  macosNum & 0xFF);
          poke8(self.code + i + 2, (macosNum >> 8) & 0xFF);
          poke8(self.code + i + 3, (macosNum >> 16) & 0xFF);
          poke8(self.code + i + 4, (macosNum >> 24) & 0xFF);
          i := i + 6;
        }
      }
      i := i + 1;
    }
  }

  // WP-02: Patch Linux mmap flags (34 = MAP_PRIVATE|MAP_ANON) to macOS (0x1002).
  // Three instruction forms that embed flag value 34 before a syscall:
  //   5-byte:  B8 22 00 00 00  49 89 C2   (mov eax,34; mov r10,rax)
  //  10-byte: 48 B8 22 00..00  49 89 C2   (mov rax,34; mov r10,rax)
  //  10+push: 48 B8 22 00..00  50         (mov rax,34; push rax  — for 6-arg push form)
  fn mxb_patchMmapFlags(startOff: int64) {
    var i: int64 := startOff;
    while (i < self.codeLen - 12) {
      // 5-byte form: B8 22 00 00 00 49 89 C2
      if peek8(self.code + i) == 0xB8 &&
         peek8(self.code + i + 1) == 0x22 &&
         peek8(self.code + i + 2) == 0 &&
         peek8(self.code + i + 3) == 0 &&
         peek8(self.code + i + 4) == 0 &&
         peek8(self.code + i + 5) == 0x49 &&
         peek8(self.code + i + 6) == 0x89 &&
         peek8(self.code + i + 7) == 0xC2 {
        poke8(self.code + i + 1, 0x02);
        poke8(self.code + i + 2, 0x10);
        poke8(self.code + i + 3, 0);
        poke8(self.code + i + 4, 0);
        i := i + 7;
      // 10-byte REX form: 48 B8 22 00 00 00 00 00 00 00 49 89 C2
      } else if peek8(self.code + i) == 0x48 &&
                peek8(self.code + i + 1) == 0xB8 &&
                peek8(self.code + i + 2) == 0x22 &&
                peek8(self.code + i + 3) == 0 &&
                peek8(self.code + i + 4) == 0 &&
                peek8(self.code + i + 5) == 0 &&
                peek8(self.code + i + 6) == 0 &&
                peek8(self.code + i + 7) == 0 &&
                peek8(self.code + i + 8) == 0 &&
                peek8(self.code + i + 9) == 0 &&
                peek8(self.code + i + 10) == 0x49 &&
                peek8(self.code + i + 11) == 0x89 &&
                peek8(self.code + i + 12) == 0xC2 {
        poke8(self.code + i + 2, 0x02);
        poke8(self.code + i + 3, 0x10);
        i := i + 12;
      // 10-byte REX form + push: 48 B8 22 00 00 00 00 00 00 00 50
      } else if peek8(self.code + i) == 0x48 &&
                peek8(self.code + i + 1) == 0xB8 &&
                peek8(self.code + i + 2) == 0x22 &&
                peek8(self.code + i + 3) == 0 &&
                peek8(self.code + i + 4) == 0 &&
                peek8(self.code + i + 5) == 0 &&
                peek8(self.code + i + 6) == 0 &&
                peek8(self.code + i + 7) == 0 &&
                peek8(self.code + i + 8) == 0 &&
                peek8(self.code + i + 9) == 0 &&
                peek8(self.code + i + 10) == 0x50 {
        poke8(self.code + i + 2, 0x02);
        poke8(self.code + i + 3, 0x10);
        i := i + 10;
      }
      i := i + 1;
    }
  }

  // WP-D1: Patch VMT addresses from Linux ELF base to macOS Mach-O base.
  // Uses fields set by SetVMTInfo: vmtPatch, vmtCnt, vmtMeth, vmtMethCnt, cgDataPtr.
  fn mxb_patchVMTAddrs() {
    var delta: int64 := MACOS_CODE_BASE - MACOS_LINUX_BASE;
    if self.vmtCnt <= 0 { return; }
    var j: int64 := 0;
    while (j < self.vmtCnt) {
      var rec: int64 := self.vmtPatch + j * 24;
      var codeOff: int64 := peek64(rec);
      if codeOff >= 0 && codeOff < self.codeLen - 7 {
        var oldAddr: int64 := peek64(self.code + codeOff);
        poke64(self.code + codeOff, oldAddr + delta);
      }
      j := j + 1;
    }
    if self.vmtMethCnt <= 0 { return; }
    j := 0;
    while (j < self.vmtMethCnt) {
      var rec2: int64 := self.vmtMeth + j * 16;
      var slotOff: int64 := peek64(rec2);
      var oldMeth: int64 := peek64(self.cgDataPtr + slotOff);
      poke64(self.cgDataPtr + slotOff, oldMeth + delta);
      j := j + 1;
    }
  }

  // ------------------------------------------------------------------
  // Build the macOS code buffer from a Codegen-produced Linux buffer
  // WP-D1: stubs now at correct Linux-matching offsets (MACOS_HELPERS_SZ=301)
  // ------------------------------------------------------------------

  fn mxb_buildCode(cgBuf: int64, cgLen: int64) {
    // WP-D1 fix: Linux _start (79 bytes) has call-main E8 at byte 62, rel32 at 63..66.
    // (Bytes 49..52 are the CG_ARGC data-patch, NOT the call-main rel32.)
    // macOS _start puts E8 at byte 48 (next IP = 53); Linux next IP = 67.
    // Adjust: rel32_macos = rel32_linux + (67 - 53) = rel32_linux + 14.
    var b0: int64 := peek8(cgBuf + 63);
    var b1: int64 := peek8(cgBuf + 64);
    var b2: int64 := peek8(cgBuf + 65);
    var b3: int64 := peek8(cgBuf + 66);
    var rel32: int64 := b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    // Sign-extend 32 bits to int64
    if rel32 > 0x7FFFFFFF { rel32 := rel32 - 0x100000000; }
    rel32 := rel32 + 14;  // macOS E8@48 nextIP=53 vs Linux E8@62 nextIP=67

    // Emit macOS stubs at same offsets as Linux (WP-D1):
    // _start:    0..78   (79 bytes)  = CG_H_STRLEN base
    // strlen:    79..93  (15 bytes)  = CG_H_STRLEN = 79 ✓
    // printstr:  94..119 (26 bytes)  = CG_H_PRINTSTR = 94 ✓
    // printint:  120..223(104 bytes) = CG_H_PRINTINT = 120 ✓
    // strsub:    224..294(71 bytes)  = CG_H_STRSUB = 224 ✓
    // strcharat: 295..300(6 bytes)   = CG_H_STRCHARAT = 295 ✓
    // Total: 79+15+26+104+71+6 = 301 = MACOS_HELPERS_SZ ✓
    self.mxb_emitStart(rel32);
    self.mxb_emitStrlen();
    self.mxb_emitPrintStr();
    self.mxb_emitPrintInt();
    self.mxb_emitStrSub();
    self.mxb_emitStrCharAt();

    // Copy Linux helpers 301+ and user code verbatim, then patch Linux syscall numbers
    var i: int64 := MACOS_HELPERS_SZ;
    while (i < cgLen) {
      self.mxb_ce8(peek8(cgBuf + i));
      i := i + 1;
    }
    // Scan and patch Linux syscall numbers in all verbatim-copied code
    self.mxb_patchCode(MACOS_HELPERS_SZ);
    // WP-02: patch Linux mmap flags (34) to macOS (0x1002) in all verbatim-copied code
    self.mxb_patchMmapFlags(MACOS_HELPERS_SZ);
  }

  // ------------------------------------------------------------------
  // Write Mach-O 64 binary to disk
  // ------------------------------------------------------------------
  // File layout:
  //   [0 .. H-1]         Mach-O header + load commands    (H = 280 bytes)
  //   [H .. P-1]         zero padding to page boundary    (P = 4096)
  //   [P .. P+code-1]    code section                     (= self.codeLen)
  //
  // Virtual memory:
  //   __PAGEZERO  [0x0 .. 0x100000000)          (4 GB, no file backing)
  //   __TEXT      [0x100000000 .. +P+code)       (backed by file from offset 0)
  //     __text    [0x100001000 .. +code)          (the actual instructions)
  //
  // LC_MAIN entryoff = P  (byte offset within file to _start at code[0])

  fn mxb_writeMachO(path: pchar, cgData: int64, cgDataLen: int64) {
    var codeSize: int64 := self.codeLen;

    // Load-command sizes
    var segPZSize:   int64 := 72;          // LC_SEGMENT_64 __PAGEZERO (no sections)
    var segTextSize: int64 := 152;         // LC_SEGMENT_64 __TEXT + 1 section (72+80)
    var lcMainSize:  int64 := 24;          // LC_MAIN
    var numCmds:     int64 := 3;
    var totalCmdSz:  int64 := segPZSize + segTextSize + lcMainSize;  // 248
    var H:           int64 := 32 + totalCmdSz;                       // 280

    // Page-align to get code offset P
    var P: int64 := (H + MACOS_PAGE_SIZE - 1) & ~(MACOS_PAGE_SIZE - 1);  // 4096

    var textVMSz: int64 := P + codeSize + cgDataLen;  // WP-D1: include data section

    // ---- Mach-O header (32 bytes) ----
    self.mxb_oe32(MACOS_MH_MAGIC_64);
    self.mxb_oe32(MACOS_CPU_TYPE_X86_64);
    self.mxb_oe32(MACOS_CPU_SUBTYPE_X86_ALL);
    self.mxb_oe32(MACOS_MH_EXECUTE);
    self.mxb_oe32(numCmds);
    self.mxb_oe32(totalCmdSz);
    self.mxb_oe32(MACOS_MH_NOUNDEFS | MACOS_MH_PIE);
    self.mxb_oe32(0);  // reserved

    // ---- LC_SEGMENT_64 __PAGEZERO (72 bytes) ----
    self.mxb_oe32(MACOS_LC_SEGMENT_64);
    self.mxb_oe32(72);
    self.mxb_oName16("__PAGEZERO"c, 10);
    self.mxb_oe64(0);                  // vmaddr = 0
    self.mxb_oe64(MACOS_TEXT_BASE);    // vmsize = 4 GB
    self.mxb_oe64(0);                  // fileoff = 0
    self.mxb_oe64(0);                  // filesize = 0 (not backed)
    self.mxb_oe32(MACOS_VM_PROT_NONE);
    self.mxb_oe32(MACOS_VM_PROT_NONE);
    self.mxb_oe32(0);                  // nsects = 0
    self.mxb_oe32(0);                  // flags

    // ---- LC_SEGMENT_64 __TEXT (72 + 80 = 152 bytes) ----
    self.mxb_oe32(MACOS_LC_SEGMENT_64);
    self.mxb_oe32(152);
    self.mxb_oName16("__TEXT"c, 6);
    self.mxb_oe64(MACOS_TEXT_BASE);    // vmaddr = 0x100000000
    self.mxb_oe64(textVMSz);           // vmsize = P + code
    self.mxb_oe64(0);                  // fileoff = 0 (segment covers whole file)
    self.mxb_oe64(textVMSz);           // filesize
    self.mxb_oe32(MACOS_VM_PROT_READ | MACOS_VM_PROT_EXEC);
    self.mxb_oe32(MACOS_VM_PROT_READ | MACOS_VM_PROT_EXEC);
    self.mxb_oe32(1);                  // nsects = 1
    self.mxb_oe32(0);                  // flags

    // Section64 __text (80 bytes)
    self.mxb_oName16("__text"c, 6);             // sectname
    self.mxb_oName16("__TEXT"c, 6);             // segname
    self.mxb_oe64(MACOS_TEXT_BASE + P);          // addr = base + P
    self.mxb_oe64(codeSize);                     // size
    self.mxb_oe32(P);                            // offset in file
    self.mxb_oe32(4);                            // align = 2^4 = 16
    self.mxb_oe32(0);                            // reloff
    self.mxb_oe32(0);                            // nreloc
    self.mxb_oe32(MACOS_S_ATTR_PURE_INSTR);      // flags
    self.mxb_oe32(0); self.mxb_oe32(0); self.mxb_oe32(0);  // reserved1/2/3

    // ---- LC_MAIN (24 bytes) ----
    self.mxb_oe32(MACOS_LC_MAIN);
    self.mxb_oe32(24);
    self.mxb_oe64(P);    // entryoff = file offset of _start = P
    self.mxb_oe64(0);    // stacksize = 0 (use default)

    // ---- Pad header region to page boundary ----
    var pad: int64 := P - self.outLen;
    self.mxb_oZeros(pad);

    // ---- Code section ----
    var i: int64 := 0;
    while (i < self.codeLen) {
      self.mxb_oe8(peek8(self.code + i));
      i := i + 1;
    }
    // ---- Data section (strings, VMT tables) — immediately follows code ----
    // WP-D1: RIP-relative string/VMT accesses assume data is at code_end + dataOff
    i := 0;
    while (i < cgDataLen) {
      self.mxb_oe8(peek8(cgData + i));
      i := i + 1;
    }

    // ---- Write to file (O_WRONLY|O_CREAT|O_TRUNC=577, mode 0755=493) ----
    EmitWriteFile(path, self.out, self.outLen);   // #1682
  }

  // ------------------------------------------------------------------
  // Public API
  // ------------------------------------------------------------------

  pub fn Build(cgBuf: int64, cgLen: int64) {
    self.mxb_buildCode(cgBuf, cgLen);
  }

  // WP-D1: Set VMT patch state. Call after Build(), before WriteMachO().
  pub fn SetVMTInfo(vPatch: int64, vCnt: int64, vMeth: int64, vMethCnt: int64) {
    self.vmtPatch   := vPatch;
    self.vmtCnt     := vCnt;
    self.vmtMeth    := vMeth;
    self.vmtMethCnt := vMethCnt;
  }

  // WP-D1: Write Mach-O with data section appended after code + VMT patching.
  pub fn WriteMachO(path: pchar, cgData: int64, cgDataLen: int64) {
    self.cgDataPtr  := cgData;
    self.cgDataLen_ := cgDataLen;
    self.mxb_patchVMTAddrs();
    self.mxb_writeMachO(path, cgData, cgDataLen);
  }

  pub fn GetCodeSize(): int64 { return self.codeLen; }

  pub fn Init() {
    self.codeCap := 65536;
    self.code    := alloc(self.codeCap);
    self.codeLen := 0;
    self.outCap  := 65536;
    self.out     := alloc(self.outCap);
    self.outLen  := 0;
  }

};
