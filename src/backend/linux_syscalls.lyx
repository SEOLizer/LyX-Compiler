// Syscall-Nummer der generischen Linux-ABI, oder -1 wenn die ID keine ist.
//
// -1 statt 0: die Null ist eine GUELTIGE Syscall-Nummer (io_setup), ein
// Fehlwert muss also ausserhalb des Wertebereichs liegen.
pub fn LinuxSysNr(id: int64): int64 {
  if (id == LSC_GETUID)         { return 174; }
  if (id == LSC_CHROOT)         { return 51; }
  if (id == LSC_CLONE)          { return 220; }
  if (id == LSC_EPOLL_CREATE1)  { return 20; }
  if (id == LSC_INOTIFY_INIT1)  { return 26; }
  if (id == LSC_IO_URING_SETUP) { return 425; }
  if (id == LSC_MQ_OPEN)        { return 180; }
  if (id == LSC_MREMAP)         { return 216; }
  if (id == LSC_PIDFD_OPEN)     { return 434; }
  if (id == LSC_PRCTL)          { return 167; }
  if (id == LSC_PREAD64)        { return 67; }
  if (id == LSC_PTRACE)         { return 117; }
  if (id == LSC_RT_SIGACTION)   { return 134; }
  if (id == LSC_SCHED_YIELD)    { return 124; }
  if (id == LSC_SHMGET)         { return 194; }
  if (id == LSC_SETXATTR)       { return 5; }
  if (id == LSC_BPF)            { return 280; }
  if (id == LSC_EPOLL_CTL) { return 21; }
  if (id == LSC_EVENTFD2) { return 19; }
  if (id == LSC_GETGID) { return 176; }
  if (id == LSC_GETPPID) { return 173; }
  if (id == LSC_GETXATTR) { return 8; }
  if (id == LSC_INOTIFY_ADD_WATCH) { return 27; }
  if (id == LSC_IO_URING_ENTER) { return 426; }
  if (id == LSC_MADVISE) { return 233; }
  if (id == LSC_MQ_UNLINK) { return 181; }
  if (id == LSC_PERF_EVENT_OPEN) { return 241; }
  if (id == LSC_PIDFD_SEND_SIGNAL) { return 424; }
  if (id == LSC_PWRITE64) { return 68; }
  if (id == LSC_RT_SIGPROCMASK) { return 135; }
  if (id == LSC_SETHOSTNAME) { return 161; }
  if (id == LSC_SHMAT) { return 196; }
  if (id == LSC_FCNTL) { return 25; }
  if (id == LSC_DUP3) { return 24; }
  if (id == LSC_FTRUNCATE) { return 46; }
  if (id == LSC_FSYNC) { return 82; }
  if (id == LSC_FDATASYNC) { return 83; }
  if (id == LSC_UNAME) { return 160; }
  if (id == LSC_GETCPU) { return 168; }
  if (id == LSC_READV) { return 65; }
  if (id == LSC_WRITEV) { return 66; }
  if (id == LSC_STATFS) { return 43; }
  if (id == LSC_SCHED_GETAFFINITY) { return 123; }
  if (id == LSC_SCHED_SETAFFINITY) { return 122; }
  if (id == LSC_GETPRIORITY) { return 141; }
  if (id == LSC_SETPRIORITY) { return 140; }
  if (id == LSC_KILL) { return 129; }
  if (id == LSC_PIPE2) { return 59; }
  if (id == LSC_SENDTO) { return 206; }
  if (id == LSC_RECVFROM) { return 207; }
  if (id == LSC_GETSOCKNAME) { return 204; }
  if (id == LSC_GETPEERNAME) { return 205; }
  if (id == LSC_FACCESSAT) { return 48; }
  if (id == LSC_FUTEX) { return 98; }
  return 0 - 1;
}

// Wie viele Argumente der Aufruf in die Register legt.
//
// Die Zahl steht hier und nicht im Aufrufer, weil sie zur ABI gehoert: sie
// bestimmt, welche Register der Kernel liest. Zu wenige zu laden hiesse, dem
// Kernel zu ueberlassen, was zufaellig im Register steht.
pub fn LinuxSysArgc(id: int64): int64 {
  if (id == LSC_GETUID)         { return 0; }
  if (id == LSC_SCHED_YIELD)    { return 0; }
  if (id == LSC_CHROOT)         { return 1; }
  if (id == LSC_INOTIFY_INIT1)  { return 1; }
  if (id == LSC_EPOLL_CREATE1)  { return 1; }
  if (id == LSC_PIDFD_OPEN)     { return 2; }
  if (id == LSC_IO_URING_SETUP) { return 2; }
  if (id == LSC_SHMGET)         { return 3; }
  if (id == LSC_MQ_OPEN)        { return 4; }
  if (id == LSC_RT_SIGACTION)   { return 4; }
  if (id == LSC_PREAD64)        { return 4; }
  if (id == LSC_PTRACE)         { return 4; }
  if (id == LSC_MREMAP)         { return 5; }
  if (id == LSC_PRCTL)          { return 5; }
  if (id == LSC_SETXATTR)       { return 5; }
  if (id == LSC_CLONE)          { return 5; }
  if (id == LSC_BPF)            { return 3; }
  if (id == LSC_EPOLL_CTL) { return 4; }
  if (id == LSC_EVENTFD2) { return 2; }
  if (id == LSC_GETGID) { return 0; }
  if (id == LSC_GETPPID) { return 0; }
  if (id == LSC_GETXATTR) { return 4; }
  if (id == LSC_INOTIFY_ADD_WATCH) { return 3; }
  if (id == LSC_IO_URING_ENTER) { return 6; }
  if (id == LSC_MADVISE) { return 3; }
  if (id == LSC_MQ_UNLINK) { return 1; }
  if (id == LSC_PERF_EVENT_OPEN) { return 5; }
  if (id == LSC_PIDFD_SEND_SIGNAL) { return 4; }
  if (id == LSC_PWRITE64) { return 4; }
  if (id == LSC_RT_SIGPROCMASK) { return 4; }
  if (id == LSC_SETHOSTNAME) { return 2; }
  if (id == LSC_SHMAT) { return 3; }
  if (id == LSC_FCNTL) { return 3; }
  if (id == LSC_DUP3) { return 3; }
  if (id == LSC_FTRUNCATE) { return 2; }
  if (id == LSC_FSYNC) { return 1; }
  if (id == LSC_FDATASYNC) { return 1; }
  if (id == LSC_UNAME) { return 1; }
  if (id == LSC_GETCPU) { return 3; }
  if (id == LSC_READV) { return 3; }
  if (id == LSC_WRITEV) { return 3; }
  if (id == LSC_STATFS) { return 2; }
  if (id == LSC_SCHED_GETAFFINITY) { return 3; }
  if (id == LSC_SCHED_SETAFFINITY) { return 3; }
  if (id == LSC_GETPRIORITY) { return 2; }
  if (id == LSC_SETPRIORITY) { return 3; }
  if (id == LSC_KILL) { return 2; }
  if (id == LSC_PIPE2) { return 2; }
  if (id == LSC_SENDTO) { return 6; }
  if (id == LSC_RECVFROM) { return 6; }
  if (id == LSC_GETSOCKNAME) { return 3; }
  if (id == LSC_GETPEERNAME) { return 3; }
  if (id == LSC_FACCESSAT) { return 3; }
  if (id == LSC_FUTEX) { return 6; }
  return 0;
}
