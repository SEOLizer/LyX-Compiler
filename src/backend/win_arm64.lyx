  // -------------------------------------------------------------------------
  // .rdata section — 5 imports from KERNEL32.DLL (219 bytes + padding)
  // -------------------------------------------------------------------------

  fn wab_writeRdata(rdataRVA: int64) {
    // IDT entry 0: KERNEL32.DLL
    self.wab_oe32(rdataRVA + WAB_RDATA_INT_OFF);  // OriginalFirstThunk
    self.wab_oe32(0);                              // TimeDateStamp
    self.wab_oe32(0);                              // ForwarderChain
    self.wab_oe32(rdataRVA + WAB_RDATA_DLL_OFF);  // Name RVA
    self.wab_oe32(rdataRVA + WAB_RDATA_IAT_OFF);  // FirstThunk (IAT)
    // IDT entry 1: null terminator
    self.wab_oe32(0); self.wab_oe32(0); self.wab_oe32(0); self.wab_oe32(0); self.wab_oe32(0);

    // INT (5 functions + null)
    self.wab_oe64(rdataRVA + WAB_RDATA_WF_NAME);   // WriteFile
    self.wab_oe64(rdataRVA + WAB_RDATA_EP_NAME);   // ExitProcess
    self.wab_oe64(rdataRVA + WAB_RDATA_VA_NAME);   // VirtualAlloc
    self.wab_oe64(rdataRVA + WAB_RDATA_GH_NAME);   // GetStdHandle
    self.wab_oe64(rdataRVA + WAB_RDATA_VF_NAME);   // VirtualFree
    self.wab_oe64(0);                               // null terminator

    // IAT (same as INT initially — loader fills in VAs)
    self.wab_oe64(rdataRVA + WAB_RDATA_WF_NAME);
    self.wab_oe64(rdataRVA + WAB_RDATA_EP_NAME);
    self.wab_oe64(rdataRVA + WAB_RDATA_VA_NAME);
    self.wab_oe64(rdataRVA + WAB_RDATA_GH_NAME);
    self.wab_oe64(rdataRVA + WAB_RDATA_VF_NAME);
    self.wab_oe64(0);

    // DLL name: "KERNEL32.DLL\0" (13 bytes)
    self.wab_oe8(75);  // K
    self.wab_oe8(69);  // E
    self.wab_oe8(82);  // R
    self.wab_oe8(78);  // N
    self.wab_oe8(69);  // E
    self.wab_oe8(76);  // L
    self.wab_oe8(51);  // 3
    self.wab_oe8(50);  // 2
    self.wab_oe8(46);  // .
    self.wab_oe8(68);  // D
    self.wab_oe8(76);  // L
    self.wab_oe8(76);  // L
    self.wab_oe8(0);   // NUL

    // hint(2) + "WriteFile\0" (12 bytes)
    self.wab_oe16(0);
    self.wab_oe8(87); self.wab_oe8(114); self.wab_oe8(105); self.wab_oe8(116);  // Writ
    self.wab_oe8(101); self.wab_oe8(70); self.wab_oe8(105); self.wab_oe8(108);  // eFil
    self.wab_oe8(101); self.wab_oe8(0);                                           // e NUL

    // hint(2) + "ExitProcess\0" (14 bytes)
    self.wab_oe16(0);
    self.wab_oe8(69);  self.wab_oe8(120); self.wab_oe8(105); self.wab_oe8(116);  // Exit
    self.wab_oe8(80);  self.wab_oe8(114); self.wab_oe8(111); self.wab_oe8(99);   // Proc
    self.wab_oe8(101); self.wab_oe8(115); self.wab_oe8(115); self.wab_oe8(0);    // ess NUL

    // hint(2) + "VirtualAlloc\0" (15 bytes)
    self.wab_oe16(0);
    self.wab_oe8(86);  self.wab_oe8(105); self.wab_oe8(114); self.wab_oe8(116);  // Virt
    self.wab_oe8(117); self.wab_oe8(97);  self.wab_oe8(108); self.wab_oe8(65);   // ualA
    self.wab_oe8(108); self.wab_oe8(108); self.wab_oe8(111); self.wab_oe8(99);   // lloc
    self.wab_oe8(0);   // NUL

    // hint(2) + "GetStdHandle\0" (15 bytes)
    self.wab_oe16(0);
    self.wab_oe8(71);  self.wab_oe8(101); self.wab_oe8(116); self.wab_oe8(83);   // GetS
    self.wab_oe8(116); self.wab_oe8(100); self.wab_oe8(72);  self.wab_oe8(97);   // tdHa
    self.wab_oe8(110); self.wab_oe8(100); self.wab_oe8(108); self.wab_oe8(101);  // ndle
    self.wab_oe8(0);   // NUL

    // hint(2) + "VirtualFree\0" (14 bytes)
    self.wab_oe16(0);
    self.wab_oe8(86);  self.wab_oe8(105); self.wab_oe8(114); self.wab_oe8(116);  // Virt
    self.wab_oe8(117); self.wab_oe8(97);  self.wab_oe8(108); self.wab_oe8(70);   // ualF
    self.wab_oe8(114); self.wab_oe8(101); self.wab_oe8(101); self.wab_oe8(0);    // ree NUL

    // Pad to FILE_ALIGNMENT = 512
    self.wab_oZeros(WAB_FILE_ALIGN - WAB_RDATA_SIZE);
  }

  // -------------------------------------------------------------------------
  // Full PE64-ARM64 writer
  // -------------------------------------------------------------------------

  fn wab_writePE64(path: pchar) {
    var codeLen:      int64 := self.codeLen;
    var textRawSize:  int64 := self.wab_alignUp(codeLen, WAB_FILE_ALIGN);
    var rdataRVA:     int64 := self.wab_alignUp(WAB_TEXT_RVA + codeLen, WAB_SEC_ALIGN);
    var rdataFileOff: int64 := WAB_FILE_ALIGN + textRawSize;
    var imageSize:    int64 := rdataRVA + WAB_SEC_ALIGN;
    var entryRVA:     int64 := WAB_TEXT_RVA + WAB_ENTRY_OFF;  // 0x1000

    // ---- DOS Header (64 bytes) ----
    self.wab_writeDosHeader(128);

    // ---- DOS Stub (64 bytes) ----
    self.wab_writeDosStub();

    // ---- PE Signature "PE\0\0" ----
    self.wab_oe8(80); self.wab_oe8(69); self.wab_oe8(0); self.wab_oe8(0);

    // ---- COFF Header (20 bytes) ----
    self.wab_oe16(0xAA64);   // Machine = ARM64
    self.wab_oe16(2);        // NumberOfSections
    self.wab_oe32(0);        // TimeDateStamp
    self.wab_oe32(0);        // PointerToSymbolTable
    self.wab_oe32(0);        // NumberOfSymbols
    self.wab_oe16(240);      // SizeOfOptionalHeader
    self.wab_oe16(0x0022);   // Characteristics

    // ---- Optional Header PE32+ (240 bytes) ----
    self.wab_oe16(0x020B);   // Magic = PE32+
    self.wab_oe8(14);        // MajorLinkerVersion
    self.wab_oe8(0);
    self.wab_oe32(textRawSize);
    self.wab_oe32(WAB_FILE_ALIGN);    // SizeOfInitializedData
    self.wab_oe32(0);
    self.wab_oe32(entryRVA);
    self.wab_oe32(WAB_TEXT_RVA);
    self.wab_oe64(WAB_IMAGE_BASE);
    self.wab_oe32(WAB_SEC_ALIGN);
    self.wab_oe32(WAB_FILE_ALIGN);
    self.wab_oe16(10); self.wab_oe16(0);   // OS Version
    self.wab_oe16(0);  self.wab_oe16(0);   // Image Version
    self.wab_oe16(10); self.wab_oe16(0);   // Subsystem Version
    self.wab_oe32(0);                       // Win32VersionValue
    self.wab_oe32(imageSize);
    self.wab_oe32(WAB_FILE_ALIGN);          // SizeOfHeaders
    self.wab_oe32(0);                       // CheckSum
    self.wab_oe16(3);                       // Subsystem = CUI
    self.wab_oe16(0x0160);                  // DllCharacteristics
    self.wab_oe64(0x100000);                // SizeOfStackReserve
    self.wab_oe64(0x1000);                  // SizeOfStackCommit
    self.wab_oe64(0x100000);                // SizeOfHeapReserve
    self.wab_oe64(0x1000);                  // SizeOfHeapCommit
    self.wab_oe32(0);                       // LoaderFlags
    self.wab_oe32(16);                      // NumberOfRvaAndSizes

    // Data Directories (16 × 8 = 128 bytes)
    self.wab_oe32(0); self.wab_oe32(0);                                   // [0] Export
    self.wab_oe32(rdataRVA); self.wab_oe32(40);                           // [1] Import (IDT, 40 bytes)
    self.wab_oe32(0); self.wab_oe32(0);                                   // [2] Resource
    self.wab_oe32(0); self.wab_oe32(0);                                   // [3] Exception
    self.wab_oe32(0); self.wab_oe32(0);                                   // [4] Security
    self.wab_oe32(0); self.wab_oe32(0);                                   // [5] BaseReloc
    self.wab_oe32(0); self.wab_oe32(0);                                   // [6] Debug
    self.wab_oe32(0); self.wab_oe32(0);                                   // [7] Architecture
    self.wab_oe32(0); self.wab_oe32(0);                                   // [8] GlobalPtr
    self.wab_oe32(0); self.wab_oe32(0);                                   // [9] TLS
    self.wab_oe32(0); self.wab_oe32(0);                                   // [10] LoadConfig
    self.wab_oe32(0); self.wab_oe32(0);                                   // [11] BoundImport
    self.wab_oe32(rdataRVA + WAB_RDATA_IAT_OFF); self.wab_oe32(48);      // [12] IAT (6×8)
    self.wab_oe32(0); self.wab_oe32(0);                                   // [13] DelayImport
    self.wab_oe32(0); self.wab_oe32(0);                                   // [14] CLR
    self.wab_oe32(0); self.wab_oe32(0);                                   // [15] Reserved

    // ---- Section Header .text ----
    self.wab_oName8(".text"c, 5);
    self.wab_oe32(codeLen);
    self.wab_oe32(WAB_TEXT_RVA);
    self.wab_oe32(textRawSize);
    self.wab_oe32(WAB_FILE_ALIGN);
    self.wab_oe32(0);
    self.wab_oe32(0);
    self.wab_oe16(0);
    self.wab_oe16(0);
    self.wab_oe32(0x60000020);   // CODE | MEM_EXECUTE | MEM_READ

    // ---- Section Header .rdata ----
    self.wab_oName8(".rdata"c, 6);
    self.wab_oe32(WAB_RDATA_SIZE);
    self.wab_oe32(rdataRVA);
    self.wab_oe32(WAB_FILE_ALIGN);
    self.wab_oe32(rdataFileOff);
    self.wab_oe32(0);
    self.wab_oe32(0);
    self.wab_oe16(0);
    self.wab_oe16(0);
    self.wab_oe32(0x40000040);   // INITIALIZED_DATA | MEM_READ

    // ---- Pad headers to FILE_ALIGNMENT ----
    self.wab_oZeros(WAB_FILE_ALIGN - self.outLen);

    // ---- .text section ----
    var i: int64 := 0;
    while i < codeLen {
      self.wab_oe8(peek8(self.code + i));
      i := i + 1;
    }
    self.wab_oZeros(textRawSize - codeLen);

    // ---- .rdata section ----
    self.wab_writeRdata(rdataRVA);

    // ---- Write to file ----
    var fd: int64 := open(path, 577, 493);
    if fd < 0 {
      EPrintStr("error: cannot write output: "c);
      EPrintStrLn(path);
      return;
    }
    write(fd, self.out as pchar, self.outLen);
    close(fd);
  }

  // -------------------------------------------------------------------------
  // Public API
  // -------------------------------------------------------------------------

  // Build: emit _start stub, copy IR-emitted user code, append helper stubs,
  // patch BL placeholders and ADRP+LDR IAT references.
  // winPatches / winPatchCount: from EmitARM64.getWinPatch*() when winMode=1.
  pub fn Build(irBuf: int64, irLen: int64, winPatches: int64, winPatchCount: int64) {
    // 1. _start stub (28 bytes at offset 0)
    self.wab_emitStart();

    // 2. Copy user code at offset 28
    var i: int64 := 0;
    while i < irLen {
      self.wab_ce8(peek8(irBuf + i));
      i := i + 1;
    }

    // 3. Record helper section start and emit helper stubs
    self.helperStart := self.codeLen;  // = WAB_START_SIZE + irLen
    self.wab_emitPrintStrHelper();     // WAB_HO_PRINTSTR  = 0
    self.wab_emitPrintIntHelper();     // WAB_HO_PRINTINT  = 88
    self.wab_emitExitHelper();         // WAB_HO_EXIT      = 236
    self.wab_emitAllocHelper();        // WAB_HO_ALLOC     = 252
    self.wab_emitFreeHelper();         // WAB_HO_FREE      = 296
    self.wab_emitStrSubHelper();       // WAB_HO_STRSUB    = 328
    self.wab_emitStrConcatHelper();    // WAB_HO_STRCONCAT = 436
    self.wab_emitStrCopyHelper();      // WAB_HO_STRCOPY   = 608

    // 4. Patch ADRP+LDR for Windows API IAT calls
    self.wab_patchIAT();

    // 5. Patch BL placeholders in user code (only when winMode was used)
    if winPatchCount > 0 {
      self.wab_patchWinBLs(winPatches, winPatchCount, irLen);
    }
  }

  pub fn WritePE64(path: pchar) {
    self.wab_writePE64(path);
  }

  pub fn GetCodeSize(): int64 { return self.codeLen; }

  pub fn Init() {
    self.codeCap := 524288;  // 512 KB — enough for code + helpers
    self.code    := alloc(self.codeCap);
    self.codeLen := 0;
    self.outCap  := 131072;
    self.out     := alloc(self.outCap);
    self.outLen  := 0;
    self.helperStart := 0;
  }

};
