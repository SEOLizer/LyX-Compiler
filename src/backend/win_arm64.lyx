    self.wab_ce32(0xAA1003F4);  // 12: MOV x20, x1  (len)
    // GetStdHandle(STD_ERROR_HANDLE = -12)
    self.wab_ce32(0x92800160);  // 16: MOVN x0, #11  (x0 = ~11 = -12 = stderr)
    self.wab_ce32(0x90000009);  // 20: ADRP x9, placeholder  [+20]
