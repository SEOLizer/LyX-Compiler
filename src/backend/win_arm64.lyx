  // -------------------------------------------------------------------------
  // Patch all ADRP+LDR pairs and BL placeholders after code is complete.
  // Called after helper stubs are appended and codeLen is final.
  // -------------------------------------------------------------------------

  fn wab_patchIAT() {
    var hs: int64 := self.helperStart;  // code buffer offset where helpers begin

    // 1. _start stub ExitProcess call (at code offsets 12, 16)
    self.wab_patchADRPLDR_x16(12, WAB_IAT_EXITPROCESS);

    // 2. wab_printstr: GetStdHandle at hs+20, WriteFile at hs+60
    self.wab_patchADRPLDR(hs + WAB_HO_PRINTSTR + 20, WAB_IAT_GETSTDHANDLE);
    self.wab_patchADRPLDR(hs + WAB_HO_PRINTSTR + 60, WAB_IAT_WRITEFILE);

    // 3. wab_exit: ExitProcess at hs+236+0
    self.wab_patchADRPLDR(hs + WAB_HO_EXIT + 0, WAB_IAT_EXITPROCESS);

    // 4. wab_alloc: VirtualAlloc at hs+252+24
    self.wab_patchADRPLDR(hs + WAB_HO_ALLOC + 24, WAB_IAT_VIRTUALALLOC);

    // 5. wab_free: VirtualFree at hs+296+12
    self.wab_patchADRPLDR(hs + WAB_HO_FREE + 12, WAB_IAT_VIRTUALFREE);

    // WP-01: wab_strsub VirtualAlloc at hs+WAB_HO_STRSUB+40
    self.wab_patchADRPLDR(hs + WAB_HO_STRSUB + 40, WAB_IAT_VIRTUALALLOC);

    // WP-01: wab_strconcat VirtualAlloc at hs+WAB_HO_STRCONCAT+80
    self.wab_patchADRPLDR(hs + WAB_HO_STRCONCAT + 80, WAB_IAT_VIRTUALALLOC);

    // WP-01: wab_strcopy VirtualAlloc at hs+WAB_HO_STRCOPY+48
    self.wab_patchADRPLDR(hs + WAB_HO_STRCOPY + 48, WAB_IAT_VIRTUALALLOC);

    // WP-13: wab_inspect_str GetStdHandle at hs+WAB_HO_INSPECT_STR+20, WriteFile at +60
    self.wab_patchADRPLDR(hs + WAB_HO_INSPECT_STR + 20, WAB_IAT_GETSTDHANDLE);
    self.wab_patchADRPLDR(hs + WAB_HO_INSPECT_STR + 60, WAB_IAT_WRITEFILE);
  }

  // -------------------------------------------------------------------------
  // Patch user-code BL placeholders (recorded by EmitARM64 in winMode).
  // userLen = length of user code (= irLen, code between _start and helpers).
  // patches = winPatchBuf from EmitARM64 (16 bytes each: {codeOff, helperId}).
  // patchCount = number of entries.
  //
  // For a BL at user-code buffer offset X targeting helper H:
  //   BL is at code buffer position: WAB_START_SIZE + X
  //   Helper H is at: WAB_START_SIZE + userLen + WAB_HO_xxx
  //   delta_bytes = (userLen + WAB_HO_xxx) - X
  //   delta_instrs = delta_bytes / 4
  //   BL encoding: 0x94000000 | (delta_instrs & 0x3FFFFFF)
  // -------------------------------------------------------------------------

  fn wab_patchWinBLs(patches: int64, patchCount: int64, userLen: int64) {
    var helperOffsets: int64 := alloc(16 * 8);
    poke64(helperOffsets + WAB_H_PRINTSTR  * 8, WAB_HO_PRINTSTR);
    poke64(helperOffsets + WAB_H_PRINTINT  * 8, WAB_HO_PRINTINT);
    poke64(helperOffsets + WAB_H_EXIT      * 8, WAB_HO_EXIT);
    poke64(helperOffsets + WAB_H_ALLOC     * 8, WAB_HO_ALLOC);
    poke64(helperOffsets + WAB_H_FREE      * 8, WAB_HO_FREE);
    poke64(helperOffsets + WAB_H_STRSUB    * 8, WAB_HO_STRSUB);
    poke64(helperOffsets + WAB_H_STRCONCAT * 8, WAB_HO_STRCONCAT);
    poke64(helperOffsets + WAB_H_STRCOPY   * 8, WAB_HO_STRCOPY);
    poke64(helperOffsets + WAB_H_PRINTF        * 8, WAB_HO_PRINTF);
    poke64(helperOffsets + WAB_H_PRINTF_FULL   * 8, WAB_HO_PRINTF_FULL);
    poke64(helperOffsets + WAB_H_INSPECT_STR   * 8, WAB_HO_INSPECT_STR);
    poke64(helperOffsets + WAB_H_INSPECT_INT   * 8, WAB_HO_INSPECT_INT);

    var i: int64 := 0;
    while i < patchCount {
      var rec:      int64 := patches + i * 16;
      var codeOff:  int64 := peek64(rec);          // offset within EmitARM64 buffer
      var helperId: int64 := peek64(rec + 8);

      if helperId >= 1 && helperId <= 12 {
        var hOff: int64 := peek64(helperOffsets + helperId * 8);
        var delta_bytes:  int64 := (userLen + hOff) - codeOff;
        var delta_instrs: int64 := delta_bytes / 4;
        var blEnc: int64 := 0x94000000 | (delta_instrs & 0x3FFFFFF);
        // BL is in code buffer at: WAB_START_SIZE + codeOff
        self.wab_patch32(WAB_START_SIZE + codeOff, blEnc);
      }
      i := i + 1;
    }
  }

