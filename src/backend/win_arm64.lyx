// bootstrap/backend/win_arm64.lyx
// Windows ARM64 backend for the Lyx bootstrap compiler (WP-BC-35 / WP-D2).
// Generates PE64-ARM64 executables (.exe) for Windows on ARM (ARM64/AArch64).
//
// Strategy (WP-D2): preamble-helper pattern.
//   _start (28 bytes) → user code (EmitARM64 in winMode) → helper stubs
//   Helper stubs implement Windows API equivalents of Linux syscalls:
//     wab_printstr : GetStdHandle + WriteFile
//     wab_printint : itoa loop + wab_printstr
//     wab_exit     : ExitProcess
//     wab_alloc    : VirtualAlloc(NULL, size, 0x3000, 4)
//     wab_free     : VirtualFree(ptr, 0, 0x8000)
//   IAT trampolines for each API are ADRP+LDR+BLR triplets patched by wab_patchIAT.
//
// PE64 layout:
//   file[0..511]         headers (DOS + PE + COFF + Optional + 2 section headers)
//   file[512..512+T-1]   .text  (padded to FILE_ALIGNMENT)
//   file[512+T..]        .rdata (import tables, padded to FILE_ALIGNMENT)
//   virtual: ImageBase=0x140000000, .text RVA=0x1000, .rdata RVA=dynamic
//
// _start stub (28 bytes at .text offset 0):
//   +00: STP x29,x30,[sp,#-48]!   frame alloc
//   +04: MOV x29, sp
//   +08: BL main                  → user code starts at offset 28
//   +12: ADRP x16, <ExitProcess>  patched
//   +16: LDR x16, [x16, #...]     patched
//   +20: BLR x16                  ExitProcess(main_retval)
//   +24: BRK #0
//
// .rdata import layout (5 functions from KERNEL32.DLL, 219 bytes total):
//   +0:   IDT entry KERNEL32.DLL (20 bytes)
//   +20:  IDT null terminator (20 bytes)
//   +40:  INT[0..5] = 6×8 = 48 bytes
//   +88:  IAT[0..5] = 6×8 = 48 bytes
//   +136: "KERNEL32.DLL\0" (13 bytes)
//   +149: WriteFile hint+name (12 bytes)
//   +161: ExitProcess hint+name (14 bytes)
//   +175: VirtualAlloc hint+name (15 bytes)
//   +190: GetStdHandle hint+name (15 bytes)
//   +205: VirtualFree hint+name (14 bytes)
//   = 219 bytes total

// ============================================================================
// Layout constants
// ============================================================================

import src.std.alloc;
con WAB_IMAGE_BASE:   int64 := 0x140000000;
con WAB_TEXT_RVA:     int64 := 0x1000;
con WAB_ENTRY_OFF:    int64 := 0;       // _start is at .text offset 0
con WAB_START_SIZE:   int64 := 28;      // _start stub size
con WAB_FILE_ALIGN:   int64 := 0x200;   // 512 bytes
con WAB_SEC_ALIGN:    int64 := 0x1000;  // 4096 bytes

// .rdata relative offsets (new 5-function layout)
con WAB_RDATA_IDT_OFF:  int64 := 0;     // IDT (2 entries × 20 = 40 bytes)
con WAB_RDATA_INT_OFF:  int64 := 40;    // INT (6 entries × 8 = 48 bytes)
con WAB_RDATA_IAT_OFF:  int64 := 88;    // IAT (6 entries × 8 = 48 bytes)
con WAB_RDATA_DLL_OFF:  int64 := 136;   // "KERNEL32.DLL\0" (13 bytes)
con WAB_RDATA_WF_NAME:  int64 := 149;   // WriteFile (12 bytes)
con WAB_RDATA_EP_NAME:  int64 := 161;   // ExitProcess (14 bytes)
con WAB_RDATA_VA_NAME:  int64 := 175;   // VirtualAlloc (15 bytes)
con WAB_RDATA_GH_NAME:  int64 := 190;   // GetStdHandle (15 bytes)
con WAB_RDATA_VF_NAME:  int64 := 205;   // VirtualFree (14 bytes)
con WAB_RDATA_SIZE:     int64 := 219;   // total .rdata bytes used

// IAT slot byte offsets within IAT (relative to WAB_RDATA_IAT_OFF)
con WAB_IAT_WRITEFILE:    int64 := 0;
con WAB_IAT_EXITPROCESS:  int64 := 8;
con WAB_IAT_VIRTUALALLOC: int64 := 16;
con WAB_IAT_GETSTDHANDLE: int64 := 24;
con WAB_IAT_VIRTUALFREE:  int64 := 32;

// Helper function IDs (WP-D2)
con WAB_H_PRINTSTR: int64 := 1;
con WAB_H_PRINTINT: int64 := 2;
con WAB_H_EXIT:     int64 := 3;
con WAB_H_ALLOC:    int64 := 4;
con WAB_H_FREE:     int64 := 5;
// WP-01: string operation helpers
con WAB_H_STRSUB:    int64 := 6;
con WAB_H_STRCONCAT: int64 := 7;
con WAB_H_STRCOPY:   int64 := 8;

// Helper function sizes in bytes (verified instruction-by-instruction)
con WAB_HS_PRINTSTR: int64 := 88;   // 22 instructions
con WAB_HS_PRINTINT: int64 := 148;  // 37 instructions
con WAB_HS_EXIT:     int64 := 16;   // 4 instructions
con WAB_HS_ALLOC:    int64 := 44;   // 11 instructions
con WAB_HS_FREE:     int64 := 32;   // 8 instructions
// WP-01
con WAB_HS_STRSUB:    int64 := 108;  // 27 instructions
con WAB_HS_STRCONCAT: int64 := 172;  // 43 instructions
con WAB_HS_STRCOPY:   int64 := 112;  // 28 instructions

// Helper section offsets (relative to helper section start)
con WAB_HO_PRINTSTR:  int64 := 0;
con WAB_HO_PRINTINT:  int64 := 88;   // 0 + 88
con WAB_HO_EXIT:      int64 := 236;  // 88 + 148
con WAB_HO_ALLOC:     int64 := 252;  // 236 + 16
con WAB_HO_FREE:      int64 := 296;  // 252 + 44
// WP-01
con WAB_HO_STRSUB:    int64 := 328;  // 296 + 32
con WAB_HO_STRCONCAT: int64 := 436;  // 328 + 108
con WAB_HO_STRCOPY:   int64 := 608;  // 436 + 172
con WAB_HELPERS_SIZE: int64 := 720;  // 608 + 112

// ============================================================================
// WinARM64Backend
// ============================================================================

pub type WinARM64Backend = class {
  code:        int64;   // code buffer
  codeLen:     int64;
  codeCap:     int64;
  out:         int64;   // PE output buffer
  outLen:      int64;
  outCap:      int64;
  helperStart: int64;   // code buffer offset where helper section begins

  // -------------------------------------------------------------------------
  // Output buffer helpers
  // -------------------------------------------------------------------------

  fn wab_oe8(v: int64) {
    poke8(self.out + self.outLen, v & 0xFF);
    self.outLen := self.outLen + 1;
  }

  fn wab_oe16(v: int64) {
    self.wab_oe8(v);
    self.wab_oe8(v >> 8);
  }

  fn wab_oe32(v: int64) {
    self.wab_oe8(v);
    self.wab_oe8(v >> 8);
    self.wab_oe8(v >> 16);
    self.wab_oe8(v >> 24);
  }

  fn wab_oe64(v: int64) {
    self.wab_oe32(v);
    self.wab_oe32(v >> 32);
  }

  fn wab_oZeros(count: int64) {
    var i: int64 := 0;
    while i < count {
      self.wab_oe8(0);
      i := i + 1;
    }
  }

  fn wab_oName8(name: pchar, len: int64) {
    var i: int64 := 0;
    while i < 8 {
      if i < len { self.wab_oe8(name[i] as int64); }
      else        { self.wab_oe8(0); }
      i := i + 1;
    }
  }

  // -------------------------------------------------------------------------
  // Code buffer helpers
  // -------------------------------------------------------------------------

  fn wab_ce8(v: int64) {
    poke8(self.code + self.codeLen, v & 0xFF);
    self.codeLen := self.codeLen + 1;
  }

  fn wab_ce32(v: int64) {
    self.wab_ce8(v);
    self.wab_ce8(v >> 8);
    self.wab_ce8(v >> 16);
    self.wab_ce8(v >> 24);
  }

  // Patch 4 bytes at a code buffer offset (little-endian)
  fn wab_patch32(off: int64, val: int64) {
    poke8(self.code + off,     val & 0xFF);
    poke8(self.code + off + 1, (val >> 8)  & 0xFF);
    poke8(self.code + off + 2, (val >> 16) & 0xFF);
    poke8(self.code + off + 3, (val >> 24) & 0xFF);
  }

  // -------------------------------------------------------------------------
  // Alignment helper
  // -------------------------------------------------------------------------

  fn wab_alignUp(v: int64, a: int64): int64 {
    return (v + a - 1) & -a;
  }

  // -------------------------------------------------------------------------
  // ADRP+LDR patcher: patch the 8 bytes at code[coff..coff+7] with
  // an ADRP x9 + LDR x9,[x9,#off] pair targeting IAT slot at iatSlotByteOff
  // relative to WAB_RDATA_IAT_OFF in the .rdata section.
  // -------------------------------------------------------------------------

  fn wab_patchADRPLDR(coff: int64, iatSlotByteOff: int64) {
    var rdataRVA: int64 := self.wab_alignUp(WAB_TEXT_RVA + self.codeLen, WAB_SEC_ALIGN);
    var iatVA:    int64 := WAB_IMAGE_BASE + rdataRVA + WAB_RDATA_IAT_OFF + iatSlotByteOff;
    var adrpVA:   int64 := WAB_IMAGE_BASE + WAB_TEXT_RVA + coff;

    var iatPage:    int64 := iatVA  >> 12;
    var adrpPage:   int64 := adrpVA >> 12;
    var pageDelta:  int64 := iatPage - adrpPage;
    var immlo:      int64 := pageDelta & 3;
    var immhi:      int64 := (pageDelta >> 2) & 0x7FFFF;
    // ADRP x9 encoding: 0x90000009 | (immlo<<29) | (immhi<<5)
    var adrpEnc: int64 := 0x90000009 | (immlo << 29) | (immhi << 5);

    var iatByteOff: int64 := iatVA & 0xFFF;
    var imm12:      int64 := iatByteOff / 8;
    // LDR x9, [x9, #imm12*8]: 0xF9400000 | (imm12<<10) | (9<<5) | 9 = 0xF9400129 | (imm12<<10)
    var ldrEnc: int64 := 0xF9400129 | (imm12 << 10);

    self.wab_patch32(coff,     adrpEnc);
    self.wab_patch32(coff + 4, ldrEnc);
  }

  // Variant for x16 (used in _start stub)
  fn wab_patchADRPLDR_x16(coff: int64, iatSlotByteOff: int64) {
    var rdataRVA: int64 := self.wab_alignUp(WAB_TEXT_RVA + self.codeLen, WAB_SEC_ALIGN);
    var iatVA:    int64 := WAB_IMAGE_BASE + rdataRVA + WAB_RDATA_IAT_OFF + iatSlotByteOff;
    var adrpVA:   int64 := WAB_IMAGE_BASE + WAB_TEXT_RVA + coff;

    var iatPage:   int64 := iatVA  >> 12;
    var adrpPage:  int64 := adrpVA >> 12;
    var pageDelta: int64 := iatPage - adrpPage;
    var immlo:     int64 := pageDelta & 3;
    var immhi:     int64 := (pageDelta >> 2) & 0x7FFFF;
    // ADRP x16: 0x90000010 | ...
    var adrpEnc: int64 := 0x90000010 | (immlo << 29) | (immhi << 5);

    var iatByteOff: int64 := iatVA & 0xFFF;
    var imm12:      int64 := iatByteOff / 8;
    // LDR x16, [x16, #imm12*8]: 0xF9400210 | (imm12<<10)
    var ldrEnc: int64 := 0xF9400210 | (imm12 << 10);

    self.wab_patch32(coff,     adrpEnc);
    self.wab_patch32(coff + 4, ldrEnc);
  }

  // -------------------------------------------------------------------------
  // _start stub emitter (28 bytes at code[0..27])
  // Entry point: alloc frame, BL main, ExitProcess(retval), BRK.
  // ADRP+LDR for ExitProcess are at code[12..19] — patched by wab_patchIAT.
  // -------------------------------------------------------------------------

  fn wab_emitStart() {
    // STP x29, x30, [sp, #-48]! (0xA9BD7BFD)
    self.wab_ce32(0xA9BD7BFD);
    // MOV x29, sp (0x910003FD)
    self.wab_ce32(0x910003FD);
    // BL main: main is at code offset 28, BL is at offset 8
    // delta = (28-8)/4 = 5  →  0x94000005
    self.wab_ce32(0x94000005);
    // ADRP x16, placeholder (patched)
    self.wab_ce32(0x90000010);
    // LDR x16, [x16, #0] placeholder (patched)
    self.wab_ce32(0xF9400210);
    // BLR x16 (0xD63F0200)
    self.wab_ce32(0xD63F0200);
    // BRK #0 (0xD4200000)
    self.wab_ce32(0xD4200000);
    // Total: 7 × 4 = 28 bytes ✓
  }

  // -------------------------------------------------------------------------
  // wab_emitPrintStrHelper (88 bytes = 22 instructions)
  // Input: x0=pchar, x1=len
  // Uses: x9=trampoline, x19=str, x20=len, x21=handle
  // Calls GetStdHandle(-11) then WriteFile(handle, str, len, &bw, NULL).
  //
  // Instruction offsets for ADRP/LDR patches (relative to helper start):
  //   +20: ADRP x9, <GetStdHandle IAT>
  //   +24: LDR  x9, [x9, #...]
  //   +60: ADRP x9, <WriteFile IAT>
  //   +64: LDR  x9, [x9, #...]
  // -------------------------------------------------------------------------

  fn wab_emitPrintStrHelper() {
    self.wab_ce32(0xA9BD53F3);  // STP x19,x20,[sp,#-48]!
    self.wab_ce32(0xA9017BF5);  // STP x21,x30,[sp,#16]
    self.wab_ce32(0xAA0003F3);  // MOV x19, x0  (str ptr)
    self.wab_ce32(0xAA1003F4);  // MOV x20, x1  (len)
    // GetStdHandle(STD_OUTPUT_HANDLE = -11)
    self.wab_ce32(0x92800140);  // MOVN x0, #10  (x0 = ~10 = -11)
    self.wab_ce32(0x90000009);  // ADRP x9, placeholder  [+20]
    self.wab_ce32(0xF9400129);  // LDR x9,[x9,#0] placeholder  [+24]
    self.wab_ce32(0xD63F0120);  // BLR x9  (GetStdHandle → x0=handle)
    self.wab_ce32(0xAA0003F5);  // MOV x21, x0  (save handle)
    // WriteFile(handle, buf, len, &bytesWritten, NULL)
    self.wab_ce32(0xD10043FF);  // SUB sp, sp, #16  (alloc bytesWritten slot)
    self.wab_ce32(0xAA1503E0);  // MOV x0, x21  (arg0=handle)
    self.wab_ce32(0xAA1303E1);  // MOV x1, x19  (arg1=buffer)
    self.wab_ce32(0xAA1403E2);  // MOV x2, x20  (arg2=nToWrite)
    self.wab_ce32(0x910003E3);  // ADD x3, sp, #0  (arg3=&bytesWritten)
    self.wab_ce32(0xD2800004);  // MOVZ x4, #0  (arg4=NULL)
    self.wab_ce32(0x90000009);  // ADRP x9, placeholder  [+60]
    self.wab_ce32(0xF9400129);  // LDR x9,[x9,#0] placeholder  [+64]
    self.wab_ce32(0xD63F0120);  // BLR x9  (WriteFile)
    self.wab_ce32(0x910043FF);  // ADD sp, sp, #16  (restore)
    self.wab_ce32(0xA9417BF5);  // LDP x21,x30,[sp,#16]
    self.wab_ce32(0xA8C353F3);  // LDP x19,x20,[sp],#48
    self.wab_ce32(0xD65F03C0);  // RET
    // 22 instructions = 88 bytes ✓
  }

  // -------------------------------------------------------------------------
  // wab_emitPrintIntHelper (148 bytes = 37 instructions)
  // Input: x0=int64 value
  // Converts integer to decimal string in stack buffer, then calls wab_printstr.
  // Uses 80-byte stack frame: saved regs (40) + digit buffer (40).
  // Digit buffer base: sp+40, end: sp+79.
  //
  // Branch targets (byte offsets within helper):
  //   CBZ  x19, .pi_zero   at  28 → target  40 (+delta 3)
  //   B    .pi_write        at  36 → target 108 (+delta 18)
  //   B.GE .pi_loop         at  44 → target  56 (+delta 3)
  //   CBZ  x19, .pi_done   at  56 → target  92 (+delta 9)
  //   B    .pi_loop         at  88 → target  56 (delta -8)
  //   CBZ  x21, .pi_write  at  92 → target 108 (+delta 4)
  //
  // BL wab_printstr at +128 (instruction 33):
  //   wab_printstr is 88 bytes BEFORE this helper → delta_instrs = -54
  //   BL = 0x97FFFFCA
  // -------------------------------------------------------------------------

  fn wab_emitPrintIntHelper() {
    self.wab_ce32(0xA9BB53F3);  //  0: STP x19,x20,[sp,#-80]!
    self.wab_ce32(0xA9015BF5);  //  4: STP x21,x22,[sp,#16]
    self.wab_ce32(0xA9027BF7);  //  8: STP x23,x30,[sp,#32]
    self.wab_ce32(0xAA0003F3);  // 12: MOV x19, x0  (value)
    self.wab_ce32(0x9100EFF4);  // 16: ADD x20, sp, #59  (end of digit buf)
    self.wab_ce32(0xD2800015);  // 20: MOVZ x21, #0  (neg_flag)
    self.wab_ce32(0xD2800616);  // 24: MOVZ x22, #48  ('0')
    // if value==0 → jump to zero-case
    self.wab_ce32(0xB5000073);  // 28: CBNZ x19, +3 (→ offset 40)
    self.wab_ce32(0x39000296);  // 32: STRB w22, [x20]  (buf[end]='0')
    self.wab_ce32(0x14000012);  // 36: B +18 (→ offset 108 = .pi_write)
    // .pi_nonzero (offset 40):
    self.wab_ce32(0xF100027F);  // 40: CMP x19, #0  (SUBS xzr, x19, #0)
    self.wab_ce32(0x5400006A);  // 44: B.GE +3 (→ offset 56 = .pi_loop)
    // .pi_negate (offset 48):
    self.wab_ce32(0xCB1303F3);  // 48: NEG x19, x19
    self.wab_ce32(0xD2800035);  // 52: MOVZ x21, #1  (neg_flag=1)
    // .pi_loop (offset 56):
    self.wab_ce32(0xB4000133);  // 56: CBZ x19, +9 (→ offset 92 = .pi_done)
    self.wab_ce32(0xD2800157);  // 60: MOVZ x23, #10
    self.wab_ce32(0x9AD70E61);  // 64: SDIV x1, x19, x23
    self.wab_ce32(0x9B17CC22);  // 68: MSUB x2, x1, x23, x19  (remainder = value-quotient*10)
    self.wab_ce32(0x8B160042);  // 72: ADD x2, x2, x22  (digit='0'+rem)
    self.wab_ce32(0x39000282);  // 76: STRB w2, [x20]
    self.wab_ce32(0xD1000694);  // 80: SUB x20, x20, #1
    self.wab_ce32(0xAA1003F3);  // 84: MOV x19, x1  (value = quotient)

    // Wait: MOV x19, x1 = ORR x19, xzr, x1
    // = 0xAA000000 | (1<<16) | (31<<5) | 19 = 0xAA000000 | 0x10000 | 0x3E0 | 19 = 0xAA1003F3 ✓

    self.wab_ce32(0x17FFFFF8);  // 88: B -8 (→ offset 56 = .pi_loop)
    // .pi_done (offset 92):
    self.wab_ce32(0xB4000095);  // 92: CBZ x21, +4 (→ offset 108 = .pi_write)
    self.wab_ce32(0xD28005B7);  // 96: MOVZ x23, #45  ('-')
    self.wab_ce32(0x39000297);  // 100: STRB w23, [x20]
    self.wab_ce32(0xD1000694);  // 104: SUB x20, x20, #1
    // .pi_write (offset 108):
    self.wab_ce32(0x91000694);  // 108: ADD x20, x20, #1  (advance to start)

    // Wait: ADD x20, x20, #1 = 0x91000000 | (1<<10) | (20<<5) | 20
    // = 0x91000000 | 0x400 | 0x280 | 20 = 0x91000000 | 0x694 = 0x91000694

    // Hmm wait: ADD Xd, Xn, #imm: 0x91000000 | (imm12<<10) | (Rn<<5) | Rd
    // ADD x20, x20, #1: Rd=20, Rn=20, imm12=1
    // 0x91000000 | (1<<10) | (20<<5) | 20 = 0x91000000 | 0x400 | 0x280 | 0x14
    // = 0x91000694
    // But that would be ADD x20, x20, #1 which I wrote as 0x91000694 already ✓

    self.wab_ce32(0x9100EFF5);  // 112: ADD x21, sp, #59  (end ptr)
    self.wab_ce32(0xCB1402A1);  // 116: SUB x1, x21, x20  (len-1)
    self.wab_ce32(0x91000421);  // 120: ADD x1, x1, #1  (len)
    self.wab_ce32(0xAA1403E0);  // 124: MOV x0, x20  (str ptr)
    // BL wab_printstr: helper is 88 bytes before this helper's start
    // This BL is at helper-section-relative offset 88+128 = 216
    // Target = helper-section-relative offset 0
    // delta_bytes = 0 - 216 = -216, delta_instrs = -54
    // BL = 0x94000000 | ((-54) & 0x3FFFFFF) = 0x94000000 | 0x03FFFFCA = 0x97FFFFCA
    self.wab_ce32(0x97FFFFCA);  // 128: BL wab_printstr (-54 instrs)
    self.wab_ce32(0xA9427BF7);  // 132: LDP x23,x30,[sp,#32]
    self.wab_ce32(0xA9415BF5);  // 136: LDP x21,x22,[sp,#16]
    self.wab_ce32(0xA8C553F3);  // 140: LDP x19,x20,[sp],#80
    self.wab_ce32(0xD65F03C0);  // 144: RET
    // 37 instructions = 148 bytes ✓
  }

  // -------------------------------------------------------------------------
  // wab_emitExitHelper (16 bytes = 4 instructions)
  // Input: x0=exitcode
  // ADRP+LDR for ExitProcess at +0, +4 — patched by wab_patchIAT.
  // -------------------------------------------------------------------------

  fn wab_emitExitHelper() {
    self.wab_ce32(0x90000009);  // ADRP x9, placeholder  [+0]
    self.wab_ce32(0xF9400129);  // LDR x9,[x9,#0] placeholder  [+4]
    self.wab_ce32(0xD63F0120);  // BLR x9  (ExitProcess, never returns)
    self.wab_ce32(0xD4200000);  // BRK #0  (unreachable)
    // 4 instructions = 16 bytes ✓
  }

  // -------------------------------------------------------------------------
  // wab_emitAllocHelper (44 bytes = 11 instructions)
  // Input: x0=size
  // Returns: x0=VirtualAlloc(NULL, size, MEM_COMMIT|MEM_RESERVE=0x3000, PAGE_READWRITE=4)
  // ADRP+LDR for VirtualAlloc at +24, +28 — patched by wab_patchIAT.
  // -------------------------------------------------------------------------

  fn wab_emitAllocHelper() {
    self.wab_ce32(0xA9BF7BF3);  //  0: STP x19,x30,[sp,#-16]!
    self.wab_ce32(0xAA0003F3);  //  4: MOV x19, x0  (save size)
    self.wab_ce32(0xD2800000);  //  8: MOVZ x0, #0  (lpAddress=NULL)
    self.wab_ce32(0xAA1303E1);  // 12: MOV x1, x19  (dwSize)
    self.wab_ce32(0xD2860002);  // 16: MOVZ x2, #0x3000  (MEM_COMMIT|MEM_RESERVE)
    self.wab_ce32(0xD2800083);  // 20: MOVZ x3, #4  (PAGE_READWRITE)
    self.wab_ce32(0x90000009);  // 24: ADRP x9, placeholder  [+24]
    self.wab_ce32(0xF9400129);  // 28: LDR x9,[x9,#0] placeholder  [+28]
    self.wab_ce32(0xD63F0120);  // 32: BLR x9  (VirtualAlloc → x0=ptr)
    self.wab_ce32(0xA8C17BF3);  // 36: LDP x19,x30,[sp],#16
    self.wab_ce32(0xD65F03C0);  // 40: RET
    // 11 instructions = 44 bytes ✓
  }

  // -------------------------------------------------------------------------
  // wab_emitFreeHelper (32 bytes = 8 instructions)
  // Input: x0=ptr
  // Calls VirtualFree(ptr, 0, MEM_RELEASE=0x8000).
  // ADRP+LDR for VirtualFree at +12, +16 — patched by wab_patchIAT.
  // -------------------------------------------------------------------------

  fn wab_emitFreeHelper() {
    self.wab_ce32(0xA9BF7BFD);  //  0: STP x29,x30,[sp,#-16]!
    self.wab_ce32(0xD2800001);  //  4: MOVZ x1, #0  (dwSize=0)
