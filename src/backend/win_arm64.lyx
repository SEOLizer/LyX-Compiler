    self.wab_ce32(0xAA1303E1);  // 44: MOV x1, x19
    self.wab_ce32(0xAA1403E2);  // 48: MOV x2, x20
    self.wab_ce32(0x910003E3);  // 52: ADD x3, sp, #0
    self.wab_ce32(0xD2800004);  // 56: MOVZ x4, #0
    self.wab_ce32(0x90000009);  // 60: ADRP x9, placeholder  [+60]
    self.wab_ce32(0xF9400129);  // 64: LDR x9,[x9,#0] placeholder  [+64]
    self.wab_ce32(0xD63F0120);  // 68: BLR x9  (WriteFile)
    self.wab_ce32(0x910043FF);  // 72: ADD sp, sp, #16
    self.wab_ce32(0xA9417BF5);  // 76: LDP x21,x30,[sp,#16]
    self.wab_ce32(0xA8C353F3);  // 80: LDP x19,x20,[sp],#48
