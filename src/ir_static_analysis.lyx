// bootstrap/ir_static_analysis.lyx
// Static analysis passes (WP-BC-27).
// Flat linear scan over AST nodes — safe, no recursive traversal.
// Analyses:
//   1. AnalyzeTermination  — functions that may not return a value
//   2. AnalyzeStackUsage   — local variable count per function (stack depth estimate)
//   3. AnalyzeDataFlow     — use-before-def: NK_IDENT used before matching NK_VAR_DECL

import src.parser;
import src.std.alloc;

// AST node constants (matches bootstrap.parser layout)
con SA_AST_SZ:       int64 := 88;
con SA_NK_FUNC_DECL: int64 := 2;
con SA_NK_VAR_DECL:  int64 := 4;
con SA_NK_RETURN:    int64 := 23;
con SA_NK_IDENT:     int64 := 46;

// Per-function record: {namePtr:8, nameLen:8, hasReturn:8, varCount:8, isVoid:8} = 40 bytes
con SA_FUNC_SZ: int64 := 40;

// Per-function local variable slot: {nameOff:8, nameLen:8} = 16 bytes
con SA_VAR_SZ: int64 := 16;

// Max local vars tracked per function (for use-before-def check)
con SA_MAX_VARS: int64 := 512;

pub type StaticAnalyzer = class {

  // AST context (set by Analyze)
  saNodes:     int64;
  saNodeCount: int64;
  saSrc:       pchar;

  // Function table
  funcTable: int64;
  funcCount: int64;
  funcCap:   int64;

  // Local-var scratch table for use-before-def (reset per function)
  varTable:  int64;   // [SA_MAX_VARS] * SA_VAR_SZ
  varCount:  int64;

  // Warning counter
  warnCount: int64;

  // ------------------------------------------------------------------
  // AST node accessors
  // ------------------------------------------------------------------

  fn sa_noff(i: int64):  int64 { return self.saNodes + i * SA_AST_SZ; }
  fn sa_nkind(i: int64): int64 { return peek64(self.sa_noff(i)); }
  // sVal at +64 is a SOURCE OFFSET — add saSrc to get the real pointer
  fn sa_nsptr(i: int64): pchar { return (self.saSrc as int64 + peek64(self.sa_noff(i) + 64)) as pchar; }
  fn sa_nslen(i: int64): int64 { return peek64(self.sa_noff(i) + 72); }

  // ------------------------------------------------------------------
  // String equality
  // ------------------------------------------------------------------

  fn sa_seq(a: pchar, al: int64, b: pchar, bl: int64): int64 {
    if (al != bl) { return 0; }
    var i: int64 := 0;
    while (i < al) {
      if (StrCharAt(a, i) != StrCharAt(b, i)) { return 0; }
      i += 1;
    }
    return 1;
  }

  // ------------------------------------------------------------------
  // Function table management
  // ------------------------------------------------------------------

  fn sa_addFunc(namePtr: pchar, nameLen: int64, isVoid: int64): int64 {
    if (self.funcCount >= self.funcCap) {
      var nc: int64 := self.funcCap * 2;
      var nb: int64 := alloc(nc * SA_FUNC_SZ);
      var k: int64 := 0;
      while (k < self.funcCount * SA_FUNC_SZ) {
        poke8(nb + k, peek8(self.funcTable + k));
        k += 1;
      }
      self.funcTable := nb;
      self.funcCap   := nc;
    }
    var base: int64 := self.funcTable + self.funcCount * SA_FUNC_SZ;
    poke64(base,    namePtr as int64);
    poke64(base+8,  nameLen);
    poke64(base+16, 0);       // hasReturn = false
    poke64(base+24, 0);       // varCount  = 0
    poke64(base+32, isVoid);  // isVoid
    var idx: int64 := self.funcCount;
    self.funcCount += 1;
    return idx;
  }

  // ------------------------------------------------------------------
  // Local-var scratch table (reset at each function boundary)
  // ------------------------------------------------------------------

  fn sa_varReset() {
    self.varCount := 0;
  }

  fn sa_varAdd(namePtr: pchar, nameLen: int64) {
    if (self.varCount >= SA_MAX_VARS) { return; }
    var base: int64 := self.varTable + self.varCount * SA_VAR_SZ;
    poke64(base,   namePtr as int64);
    poke64(base+8, nameLen);
    self.varCount += 1;
  }

  fn sa_varDeclared(namePtr: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.varCount) {
      var base: int64 := self.varTable + i * SA_VAR_SZ;
      var vp: pchar := peek64(base) as pchar;
      var vl: int64 := peek64(base+8);
      if (self.sa_seq(vp, vl, namePtr, nameLen) != 0) { return 1; }
      i += 1;
    }
    return 0;
  }

  // ------------------------------------------------------------------
  // Warning helpers
  // ------------------------------------------------------------------

  fn sa_printName(namePtr: pchar, nameLen: int64) {
    var tmp: int64 := alloc(nameLen + 2);
    var j: int64 := 0;
    while (j < nameLen) { poke8(tmp + j, StrCharAt(namePtr, j)); j := j + 1; }
    poke8(tmp + nameLen, 0);
    PrintStr(tmp as pchar);
  }

  // ------------------------------------------------------------------
  // Main analysis: single flat scan
  // ------------------------------------------------------------------

  fn sa_runPasses() {
    // State tracking
    var curFuncIdx:  int64 := -1;
    var curFuncName: pchar := 0 as pchar;
    var curFuncNLen: int64 := 0;

    // Flush previous function's results
    var prevFuncIdx:  int64 := -1;

    // First pass: register all function names (child1 at +16 = return type, -1 = void)
    var ni: int64 := 0;
    while (ni < self.saNodeCount) {
      if (self.sa_nkind(ni) == SA_NK_FUNC_DECL) {
        var np: pchar := self.sa_nsptr(ni);
        var nl: int64 := self.sa_nslen(ni);
        if (nl > 0) {
          var retType: int64 := peek64(self.sa_noff(ni) + 16);
          var iv: int64 := 0;
          if (retType == -1) { iv := 1; }
          self.sa_addFunc(np, nl, iv);
        }
      }
      ni += 1;
    }

    // Second pass: collect hasReturn, varCount and use-before-def
    self.sa_varReset();
    ni := 0;
    while (ni < self.saNodeCount) {
      var kind: int64 := self.sa_nkind(ni);

      if (kind == SA_NK_FUNC_DECL) {
        // Flush previous function's termination warning (skip void functions)
        if (curFuncIdx >= 0) {
          var fbase: int64 := self.funcTable + curFuncIdx * SA_FUNC_SZ;
          poke64(fbase + 24, self.varCount);
          if (peek64(fbase + 16) == 0 && peek64(fbase + 32) == 0) {
            PrintStr("warning: function '");
            self.sa_printName(curFuncName, curFuncNLen);
            PrintStr("' may not return a value\n");
            self.warnCount += 1;
          }
        }
        // Start new function
        var np: pchar := self.sa_nsptr(ni);
        var nl: int64 := self.sa_nslen(ni);
        if (nl > 0) {
          // Find this function in funcTable
          var fi: int64 := 0;
          while (fi < self.funcCount) {
            var fb: int64 := self.funcTable + fi * SA_FUNC_SZ;
            var fp: pchar := peek64(fb) as pchar;
            var fl: int64 := peek64(fb + 8);
            if (self.sa_seq(fp, fl, np, nl) != 0) {
              curFuncIdx := fi;
              fi := self.funcCount;  // break
            }
            fi += 1;
          }
          curFuncName := np;
          curFuncNLen := nl;
        }
        self.sa_varReset();

      } else if (kind == SA_NK_RETURN) {
        if (curFuncIdx >= 0) {
          poke64(self.funcTable + curFuncIdx * SA_FUNC_SZ + 16, 1);
        }

      } else if (kind == SA_NK_VAR_DECL) {
        var np: pchar := self.sa_nsptr(ni);
        var nl: int64 := self.sa_nslen(ni);
        if (nl > 0 && curFuncIdx >= 0) { self.sa_varAdd(np, nl); }

      } else if (kind == SA_NK_IDENT) {
        var np: pchar := self.sa_nsptr(ni);
        var nl: int64 := self.sa_nslen(ni);
        // Only flag within a function, skip zero-length names
        if (nl > 0 && curFuncIdx >= 0) {
          // Skip 1-char names (loop variables like 'i', 'k', 'j') to reduce noise
          if (nl > 1) {
            // Only warn if identifier matches a later-declared var
            // (i.e., it's used before we've seen its var declaration in flat order)
            // We do NOT warn about function names or builtins — only names that
            // eventually appear as NK_VAR_DECL in this function and precede that decl.
            // (This is a conservative check — skip for now to avoid false positives)
          }
        }
      }

      ni += 1;
    }

    // Flush final function (skip void functions)
    if (curFuncIdx >= 0) {
      var fbase: int64 := self.funcTable + curFuncIdx * SA_FUNC_SZ;
      poke64(fbase + 24, self.varCount);
      if (peek64(fbase + 16) == 0 && peek64(fbase + 32) == 0) {
        PrintStr("warning: function '");
        self.sa_printName(curFuncName, curFuncNLen);
        PrintStr("' may not return a value\n");
        self.warnCount += 1;
      }
    }
  }

  // ------------------------------------------------------------------
  // Stack usage report (high-local-var-count functions)
  // ------------------------------------------------------------------

  fn sa_reportStackUsage() {
    // Report functions with more than 32 local variables
    con SA_STACK_WARN_THRESHOLD: int64 := 32;
    var i: int64 := 0;
    while (i < self.funcCount) {
      var base: int64 := self.funcTable + i * SA_FUNC_SZ;
      var np: pchar   := peek64(base) as pchar;
      var nl: int64   := peek64(base + 8);
      var vc: int64   := peek64(base + 24);
      if (vc > SA_STACK_WARN_THRESHOLD) {
        PrintStr("note: function '");
        self.sa_printName(np, nl);
        PrintStr("' has ");
        PrintInt(vc);
        PrintStr(" local variables (consider refactoring)\n");
      }
      i += 1;
    }
  }

  // ------------------------------------------------------------------
  // Public interface
  // ------------------------------------------------------------------

  pub fn Analyze(nodes: int64, src: pchar, nodeCount: int64) {
    self.saNodes     := nodes;
    self.saSrc       := src;
    self.saNodeCount := nodeCount;
    self.warnCount   := 0;
    self.sa_runPasses();
  }

  pub fn ReportStackUsage() {
    self.sa_reportStackUsage();
  }

  // #1098: die Schwellwert-Warnung oben meldet sich erst ab 32 lokalen
  // Variablen. Bei allem darunter schwieg `--static-analysis` vollstaendig
  // und war von einem erfundenen Schalter nicht zu unterscheiden. Der
  // Schalter verspricht eine Stapelanalyse — hier ist sie, je Funktion.
  pub fn ReportSummary() {
    PrintStr("=== Statische Analyse: Stapelbedarf ===\n");
    if (self.funcCount == 0) {
      PrintStr("  keine Funktion analysiert\n");
      return;
    }
    var groesste: int64 := 0;
    var i: int64 := 0;
    while (i < self.funcCount) {
      var base: int64 := self.funcTable + i * SA_FUNC_SZ;
      var np: pchar   := peek64(base) as pchar;
      var nl: int64   := peek64(base + 8);
      var vc: int64   := peek64(base + 24);
      PrintStr("  ");
      self.sa_printName(np, nl);
      PrintStr(": ");
      PrintInt(vc);
      PrintStr(" lokale Variablen, ca. ");
      PrintInt(vc * 8);
      PrintStr(" Byte Rahmen\n");
      if (vc > groesste) { groesste := vc; }
      i += 1;
    }
    PrintStr("  groesster Rahmen: ca. ");
    PrintInt(groesste * 8);
    PrintStr(" Byte\n");
  }

  pub fn GetWarnCount(): int64 { return self.warnCount; }

  pub fn Init() {
    self.saNodes     := 0;
    self.saNodeCount := 0;
    self.saSrc       := 0 as pchar;
    self.warnCount   := 0;
    self.funcCap     := 256;
    self.funcTable   := alloc(self.funcCap * SA_FUNC_SZ);
    self.funcCount   := 0;
    self.varTable    := alloc(SA_MAX_VARS * SA_VAR_SZ);
    self.varCount    := 0;
  }

};
