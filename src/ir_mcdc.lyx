// bootstrap/ir_mcdc.lyx
// MC/DC (Modified Condition/Decision Coverage) analysis (WP-BC-28).
// DO-178C TQL-1/2 qualification support.
// Flat linear scan over AST nodes — safe, no recursive traversal.
//
// For each function, counts decision points (if/while/for/switch/match).
// Reports the MC/DC structure: how many test cases are needed per function.
// MC/DC requirement: each decision must be exercised True AND False,
// and each condition must independently affect the decision outcome.

import src.parser;
import src.std.alloc;

// AST node constants (matches bootstrap.parser layout)
con MCDC_AST_SZ:       int64 := 88;
con MCDC_NK_FUNC_DECL: int64 := 2;
con MCDC_NK_IF:        int64 := 21;
con MCDC_NK_WHILE:     int64 := 22;
con MCDC_NK_RETURN:    int64 := 23;
con MCDC_NK_FOR:       int64 := 26;
con MCDC_NK_FOR_C:     int64 := 102;
con MCDC_NK_SWITCH:    int64 := 27;
con MCDC_NK_CASE:      int64 := 28;
con MCDC_NK_BINOP:     int64 := 47;
con MCDC_NK_MATCH:     int64 := 64;
con MCDC_NK_MATCH_CASE:int64 := 65;

// iVal at +56 traegt bei NK_BINOP die TOKEN-Nummer des Operators, so wie der
// Parser sie in _siv(n, op) ablegt — nicht eine eigene Operator-Nummerierung.
//
// #1524: Hier standen 11 und 12. Die traf kein einziger Knoten, also fand der
// Scan nie ein `&&` oder `||`, und JEDE Entscheidung galt als einbedingt:
// gemeldet wurde immer "min 2 test cases", der Kern von MC/DC damit verfehlt.
// Richtig sind TK_AND = 85 und TK_OR = 86 aus src/lexer.lyx.
con MCDC_OP_AND: int64 := 85;
con MCDC_OP_OR:  int64 := 86;

// Per-function MC/DC record:
//   {namePtr:8, nameLen:8, decisions:8, conditions:8, caseCount:8} = 40 bytes
con MCDC_FUNC_SZ: int64 := 40;

// Per-decision point record:
//   {funcIdx:8, kind:8, nodeIdx:8} = 24 bytes
con MCDC_POINT_SZ: int64 := 24;

pub type MCDCAnalyzer = class {

  // AST context
  mcdcNodes:     int64;
  mcdcNodeCount: int64;
  mcdcSrc:       pchar;

  // Function table
  funcTable: int64;
  funcCount: int64;
  funcCap:   int64;

  // Decision point table
  pointTable: int64;
  pointCount: int64;
  pointCap:   int64;

  // ------------------------------------------------------------------
  // AST node accessors
  // ------------------------------------------------------------------

  fn mc_noff(i: int64):  int64 { return self.mcdcNodes + i * MCDC_AST_SZ; }
  fn mc_nkind(i: int64): int64 { return peek64(self.mc_noff(i)); }
  // sVal at +64 is a SOURCE OFFSET — add mcdcSrc for real pointer
  fn mc_nsptr(i: int64): pchar { return (self.mcdcSrc as int64 + peek64(self.mc_noff(i) + 64)) as pchar; }
  fn mc_nslen(i: int64): int64 { return peek64(self.mc_noff(i) + 72); }
  fn mc_nival(i: int64): int64 { return peek64(self.mc_noff(i) + 56); }

  // ------------------------------------------------------------------
  // String equality
  // ------------------------------------------------------------------

  fn mc_seq(a: pchar, al: int64, b: pchar, bl: int64): int64 {
    if (al != bl) { return 0; }
    var i: int64 := 0;
    while (i < al) {
      if (StrCharAt(a, i) != StrCharAt(b, i)) { return 0; }
      i += 1;
    }
    return 1;
  }

  // ------------------------------------------------------------------
  // Function table management
  // ------------------------------------------------------------------

  fn mc_addFunc(namePtr: pchar, nameLen: int64): int64 {
    if (self.funcCount >= self.funcCap) {
      var nc: int64 := self.funcCap * 2;
      var nb: int64 := alloc(nc * MCDC_FUNC_SZ);
      var k: int64 := 0;
      while (k < self.funcCount * MCDC_FUNC_SZ) {
        poke8(nb + k, peek8(self.funcTable + k));
        k += 1;
      }
      self.funcTable := nb;
      self.funcCap   := nc;
    }
    var base: int64 := self.funcTable + self.funcCount * MCDC_FUNC_SZ;
    poke64(base,    namePtr as int64);
    poke64(base+8,  nameLen);
    poke64(base+16, 0);  // decisions = 0
    poke64(base+24, 0);  // conditions = 0
    poke64(base+32, 0);  // caseCount = 0
    var idx: int64 := self.funcCount;
    self.funcCount += 1;
    return idx;
  }

  fn mc_incDecision(funcIdx: int64) {
    var base: int64 := self.funcTable + funcIdx * MCDC_FUNC_SZ;
    poke64(base+16, peek64(base+16) + 1);
  }

  fn mc_incCondition(funcIdx: int64, count: int64) {
    var base: int64 := self.funcTable + funcIdx * MCDC_FUNC_SZ;
    poke64(base+24, peek64(base+24) + count);
  }

  fn mc_incCase(funcIdx: int64) {
    var base: int64 := self.funcTable + funcIdx * MCDC_FUNC_SZ;
    poke64(base+32, peek64(base+32) + 1);
  }

  // ------------------------------------------------------------------
  // Decision point table
  // ------------------------------------------------------------------

  fn mc_addPoint(funcIdx: int64, kind: int64, nodeIdx: int64) {
    if (self.pointCount >= self.pointCap) {
      var nc: int64 := self.pointCap * 2;
      var nb: int64 := alloc(nc * MCDC_POINT_SZ);
      var k: int64 := 0;
      while (k < self.pointCount * MCDC_POINT_SZ) {
        poke8(nb + k, peek8(self.pointTable + k));
        k += 1;
      }
      self.pointTable := nb;
      self.pointCap   := nc;
    }
    var base: int64 := self.pointTable + self.pointCount * MCDC_POINT_SZ;
    poke64(base,    funcIdx);
    poke64(base+8,  kind);
    poke64(base+16, nodeIdx);
    self.pointCount += 1;
  }

  // ------------------------------------------------------------------
  // Name printer
  // ------------------------------------------------------------------

  fn mc_printName(namePtr: pchar, nameLen: int64) {
    var tmp: int64 := alloc(nameLen + 2);
    var j: int64 := 0;
    while (j < nameLen) { poke8(tmp + j, StrCharAt(namePtr, j)); j := j + 1; }
    poke8(tmp + nameLen, 0);
    PrintStr(tmp as pchar);
  }

  fn mc_kindName(kind: int64): pchar {
    if (kind == MCDC_NK_IF)     { return "if"c; }
    if (kind == MCDC_NK_WHILE)  { return "while"c; }
    if (kind == MCDC_NK_FOR)    { return "for"c; }
    if (kind == MCDC_NK_SWITCH) { return "switch"c; }
    if (kind == MCDC_NK_MATCH)  { return "match"c; }
    if (kind == MCDC_NK_BINOP)  { return "&&/||"c; }
    return "?"c;
  }

  // ------------------------------------------------------------------
  // Main analysis pass
  // ------------------------------------------------------------------

  fn mc_runScan() {
    var curFuncIdx: int64 := -1;

    // Pass 1: register all function names
    var ni: int64 := 0;
    while (ni < self.mcdcNodeCount) {
      if (self.mc_nkind(ni) == MCDC_NK_FUNC_DECL) {
        var np: pchar := self.mc_nsptr(ni);
        var nl: int64 := self.mc_nslen(ni);
        if (nl > 0) { self.mc_addFunc(np, nl); }
      }
      ni += 1;
    }

    // Pass 2: scan for decision points within each function
    ni := 0;
    while (ni < self.mcdcNodeCount) {
      var kind: int64 := self.mc_nkind(ni);

      if (kind == MCDC_NK_FUNC_DECL) {
        var np: pchar := self.mc_nsptr(ni);
        var nl: int64 := self.mc_nslen(ni);
        if (nl > 0) {
          var fi: int64 := 0;
          while (fi < self.funcCount) {
            var fb: int64 := self.funcTable + fi * MCDC_FUNC_SZ;
            var fp: pchar := peek64(fb) as pchar;
            var fl: int64 := peek64(fb+8);
            if (self.mc_seq(fp, fl, np, nl) != 0) {
              curFuncIdx := fi;
              fi := self.funcCount;
            }
            fi += 1;
          }
        }

      } else if (kind == MCDC_NK_IF && curFuncIdx >= 0) {
        self.mc_incDecision(curFuncIdx);
        self.mc_incCondition(curFuncIdx, 1);
        self.mc_addPoint(curFuncIdx, kind, ni);

      } else if (kind == MCDC_NK_WHILE && curFuncIdx >= 0) {
        self.mc_incDecision(curFuncIdx);
        self.mc_incCondition(curFuncIdx, 1);
        self.mc_addPoint(curFuncIdx, kind, ni);

      } else if ((kind == MCDC_NK_FOR || kind == MCDC_NK_FOR_C) && curFuncIdx >= 0) {
        self.mc_incDecision(curFuncIdx);
        self.mc_incCondition(curFuncIdx, 1);
        self.mc_addPoint(curFuncIdx, kind, ni);

      } else if (kind == MCDC_NK_SWITCH && curFuncIdx >= 0) {
        self.mc_incDecision(curFuncIdx);
        self.mc_addPoint(curFuncIdx, kind, ni);

      } else if (kind == MCDC_NK_MATCH && curFuncIdx >= 0) {
        self.mc_incDecision(curFuncIdx);
        self.mc_addPoint(curFuncIdx, kind, ni);

      } else if (kind == MCDC_NK_CASE && curFuncIdx >= 0) {
        self.mc_incCase(curFuncIdx);
        self.mc_incCondition(curFuncIdx, 1);

      } else if (kind == MCDC_NK_MATCH_CASE && curFuncIdx >= 0) {
        self.mc_incCase(curFuncIdx);
        self.mc_incCondition(curFuncIdx, 1);

      } else if (kind == MCDC_NK_BINOP && curFuncIdx >= 0) {
        var op: int64 := self.mc_nival(ni);
        if (op == MCDC_OP_AND || op == MCDC_OP_OR) {
          // Each operand of && / || is an independent condition
          self.mc_incCondition(curFuncIdx, 1);
          self.mc_addPoint(curFuncIdx, kind, ni);
        }
      }

      ni += 1;
    }
  }

  // ------------------------------------------------------------------
  // Summary report (--mcdc)
  // ------------------------------------------------------------------

  pub fn ReportSummary() {
    PrintStr("[MC/DC] Coverage structure analysis\n");
    PrintStr("[MC/DC] Functions analyzed: ");
    PrintInt(self.funcCount);
    PrintStr("\n[MC/DC] Total decision points: ");
    PrintInt(self.pointCount);
    PrintStr("\n\n");

    var totalTests: int64 := 0;
    var i: int64 := 0;
    while (i < self.funcCount) {
      var base: int64 := self.funcTable + i * MCDC_FUNC_SZ;
      var np: pchar   := peek64(base) as pchar;
      var nl: int64   := peek64(base+8);
      var dec: int64  := peek64(base+16);
      var cond: int64 := peek64(base+24);
      if (dec > 0) {
        // MC/DC minimum test cases = conditions + 1
        var minTests: int64 := cond + 1;
        totalTests += minTests;
        PrintStr("[MC/DC]   ");
        self.mc_printName(np, nl);
        PrintStr(": ");
        PrintInt(dec);
        PrintStr(" decisions, ");
        PrintInt(cond);
        PrintStr(" conditions → min ");
        PrintInt(minTests);
        PrintStr(" test cases\n");
      }
      i += 1;
    }
    PrintStr("[MC/DC] Total minimum test cases required: ");
    PrintInt(totalTests);
    PrintStr("\n");
  }

  // ------------------------------------------------------------------
  // Detailed report (--mcdc-report): per decision-point breakdown
  // ------------------------------------------------------------------

  pub fn ReportDetailed() {
    self.ReportSummary();
    PrintStr("\n[MC/DC] Decision point details:\n");
    var pi: int64 := 0;
    while (pi < self.pointCount) {
      var pbase: int64 := self.pointTable + pi * MCDC_POINT_SZ;
      var fi: int64    := peek64(pbase);
      var pk: int64    := peek64(pbase+8);
      var ni: int64    := peek64(pbase+16);
      var fbase: int64 := self.funcTable + fi * MCDC_FUNC_SZ;
      var fn_p: pchar  := peek64(fbase) as pchar;
      var fn_l: int64  := peek64(fbase+8);
      PrintStr("[MC/DC]   point #");
      PrintInt(pi);
      PrintStr(" in '");
      self.mc_printName(fn_p, fn_l);
      PrintStr("': ");
      PrintStr(self.mc_kindName(pk));
      PrintStr(" (node ");
      PrintInt(ni);
      PrintStr(")\n");
      pi += 1;
    }
  }

  pub fn GetDecisionCount(): int64 { return self.pointCount; }
  pub fn GetFuncCount():     int64 { return self.funcCount; }

  // ------------------------------------------------------------------
  // Public entry point
  // ------------------------------------------------------------------

  pub fn Analyze(nodes: int64, src: pchar, nodeCount: int64) {
    self.mcdcNodes     := nodes;
    self.mcdcSrc       := src;
    self.mcdcNodeCount := nodeCount;
    self.mc_runScan();
  }

  pub fn Init() {
    self.mcdcNodes     := 0;
    self.mcdcNodeCount := 0;
    self.mcdcSrc       := 0 as pchar;
    self.funcCap       := 256;
    self.funcTable     := alloc(self.funcCap * MCDC_FUNC_SZ);
    self.funcCount     := 0;
    self.pointCap      := 2048;
    self.pointTable    := alloc(self.pointCap * MCDC_POINT_SZ);
    self.pointCount    := 0;
  }

};
