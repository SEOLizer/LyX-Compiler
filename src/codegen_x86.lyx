      self.cg_e8(0xC6); self.cg_e8(0x00); self.cg_e8(0x00);  // mov byte [rax], 0
      // close(fd)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x10);  // mov rdi, [rsp+16] = fd
      self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);
      // return buf
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0x24);  // mov rax, [rsp] = buf
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x18);  // add rsp, 24
      self.cg_e8(0xEB); var fraDone: int64 := self.codeLen; self.cg_e8(0);  // jmp .fradone
      poke8(self.code + fraErr, self.codeLen - fraErr - 1);
      self.cg_zeroRax();
      poke8(self.code + fraDone, self.codeLen - fraDone - 1);

    } else if (self.cg_seq(fname, fnlen, "FileWriteAll", 12)) {
      // FileWriteAll(path, data, len): rdi=path, rsi=data, rdx=len → rax=bytes written
      // open(path, O_WRONLY|O_CREAT|O_TRUNC=577, 0644)
      self.cg_e8(0x52);  // push rdx (len)
      self.cg_e8(0x56);  // push rsi (data)
      self.cg_e8(0xBE); self.cg_e8(0x41); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00);  // mov esi, 577
      self.cg_e8(0xBA); self.cg_e8(0xA4); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00);  // mov edx, 0644 (420)
      self.cg_e8(0xB8); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // open → rax=fd
      self.cg_e8(0x50);  // push rax (fd)
      // [rsp]=fd [rsp+8]=data [rsp+16]=len
      // write(fd, data, len)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24);  // mov rdi, [rsp] = fd
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rsi, [rsp+8] = data
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x10);  // mov rdx, [rsp+16] = len
      self.cg_movRaxImm(1);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // write → rax=bytes_written
      self.cg_e8(0x50);  // push rax (bytes_written)
      // close(fd)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rdi, [rsp+8] = fd
      self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);
      // return bytes_written
      self.cg_e8(0x58);  // pop rax (bytes_written)
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x18);  // add rsp, 24 (fd, data, len)

    } else if (self.cg_findExternDecl(fname, fnlen) >= 0) {
      // FFI call: register this declared extern's GOT slot now (lazy — only
      // called externs get slots/relocations) and call indirectly through it.
      // The SysV ABI requires %rsp 16-byte aligned at the call, or libc/OpenSSL
      // crash on aligned SSE moves (movaps). Lyx's own calls don't need this,
      // so we align locally only for FFI: save rsp, align down, restore after.
      // Args are already in rdi/rsi/rdx/rcx/r8/r9; aligning rsp doesn't touch
      // them. disp32 is patched in cg_writeELFDynamic once the GOT VA is known.
      var exd: int64 := self.cg_findExternDecl(fname, fnlen);
      var edb: int64 := self.externDecls + exd * CG_EXTERN_SZ;
      var exIdx: int64 := self.cg_addExtern(peek64(edb) as pchar, peek64(edb + 8),
                                            peek64(edb + 16), peek64(edb + 24));
      self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xE3);            // mov r11, rsp
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xE4); self.cg_e8(0xF0);  // and rsp, -16
      self.cg_e8(0x41); self.cg_e8(0x53);                              // push r11
      self.cg_e8(0x41); self.cg_e8(0x53);                              // push r11 (keep 16-align)
      self.cg_e8(0x31); self.cg_e8(0xC0);                              // xor eax, eax
      self.cg_e8(0xFF); self.cg_e8(0x15);                              // call *disp32(%rip)
      var ppx: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_addPatch(ppx, exIdx, 0, CG_PATCH_EXTERN);
      self.cg_e8(0x41); self.cg_e8(0x5B);                              // pop r11
      self.cg_e8(0x5C);                                                 // pop rsp (restore)

    } else {
      // User-defined function call: emit call + patch
      var pp: int64 := self.cg_emitCall();
      self.cg_addPatch(pp, fname as int64, fnlen, CG_PATCH_CALL);
    }
  }

  // ------------------------------------------------------------------
  // Statement code generation
  // ------------------------------------------------------------------

  fn cg_genStmt(ni: int64) {
    if (ni < 0) { return; }
    var k: int64 := self.cg_nkind(ni);

    if (k == CGN_BLOCK) {
      self.cg_genBlock(ni);

    } else if (k == CGN_VAR_DECL || k == CGN_CON_DECL) {
      var name: pchar := self.cg_nsval(ni);
      var nlen: int64 := self.cg_nslen(ni);
      var off: int64 := self.cg_addLocal(name, nlen);
      var localIdx: int64 := self.localCount - 1;
      // Track type for OOP local lookup (child0 = type node, NK_TYPE_NAME = 60)
      var typeNode: int64 := self.cg_nc0(ni);
      if (typeNode >= 0 && self.cg_nkind(typeNode) == 60) {
        self.cg_setLocalType(localIdx, self.cg_nsval(typeNode), self.cg_nslen(typeNode));
      }
      // Track array locals (NK_TYPE_ARRAY = 61)
      if (typeNode >= 0 && self.cg_nkind(typeNode) == 61) {
        poke8(self.localIsArray + localIdx, 1);
      }
      // WP-BC-51: NK_TYPE_ARRAY_FIXED (=101) — store compile-time size
      if (typeNode >= 0 && self.cg_nkind(typeNode) == 101) {
        poke8(self.localIsArray + localIdx, 1);
        var sizeNode: int64 := self.cg_nc1(typeNode);
        if (sizeNode >= 0 && self.cg_nkind(sizeNode) == CGN_LIT_INT) {
          poke64(self.localArraySize + localIdx * 8, self.cg_nival(sizeNode));
        }
      }
      var init: int64 := self.cg_nc1(ni);
      // WP-BC-51: count array literal elements for len() support
      if (init >= 0 && self.cg_nkind(init) == 100) {
        var acnt: int64 := 0;
        var ael: int64 := self.cg_nc0(init);
        while (ael != -1) { acnt := acnt + 1; ael := self.cg_nnext(ael); }
        poke8(self.localIsArray + localIdx, 1);
        poke64(self.localArraySize + localIdx * 8, acnt);
      }
      if (init >= 0) {
        self.cg_genExpr(init);
      } else {
        // Fixed-size array (int64[N]): heap-allocate N*8 bytes
        var fixedSz: int64 := peek64(self.localArraySize + localIdx * 8);
        if (typeNode >= 0 && self.cg_nkind(typeNode) == 101 && fixedSz > 0) {
          // mmap(0, fixedSz*8, PROT_RW, MAP_ANON, -1, 0)
          self.cg_zeroRax();    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7); // mov rdi,0
          self.cg_movRaxImm(fixedSz * 8); self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6); // mov rsi,sz
          self.cg_movRaxImm(3);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2); // mov rdx,3
          self.cg_movRaxImm(34);
          self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);  // mov r10, rax
          self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0);  // xor r8, r8
          self.cg_e8(0x49); self.cg_e8(0xFF); self.cg_e8(0xC8);  // dec r8 → r8=-1
          self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9, r9
          self.cg_movRaxImm(9);
          self.cg_e8(0x0F); self.cg_e8(0x05);
        } else {
        // WP-10d: auto-allocate struct locals (NK_TYPE_NAME=60, vmtDataOff==-1)
        var sdoStruct: int64 := 0;
        if (typeNode >= 0 && self.cg_nkind(typeNode) == 60) {
          var sdoIdx: int64 := self.cg_findClass(self.cg_nsval(typeNode), self.cg_nslen(typeNode));
          if (sdoIdx >= 0) {
            var sdoVmt: int64 := peek64(self.classLayouts + sdoIdx * CG_CLASS_SZ + 32);
            if (sdoVmt == -1) { sdoStruct := 1; }
          }
        }
        if (sdoStruct != 0) {
          // mmap(0, 4096, 3, 34, -1, 0) → rax = struct ptr
          self.cg_movRaxImm(0);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7); // mov rdi,rax
          self.cg_movRaxImm(4096); self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6); // mov rsi,rax
          self.cg_movRaxImm(3);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2); // mov rdx,rax
          self.cg_movRaxImm(34);
          self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);  // mov r10, rax
          self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0);  // xor r8, r8
          self.cg_e8(0x49); self.cg_e8(0xFF); self.cg_e8(0xC8);  // dec r8 → r8=-1
          self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9, r9
          self.cg_movRaxImm(9);
          self.cg_e8(0x0F); self.cg_e8(0x05);
        } else {
          self.cg_zeroRax();
        }
        }
      }
      self.cg_storeRax(off);

    } else if (k == CGN_ASSIGN) {
      var lhs: int64 := self.cg_nc0(ni);
      var rhs: int64 := self.cg_nc1(ni);
      if (self.cg_nkind(lhs) == CGN_IDENT) {
        self.cg_genExpr(rhs);
        var name: pchar := self.cg_nsval(lhs);
        var nlen: int64 := self.cg_nslen(lhs);
        var off: int64 := self.cg_findLocal(name, nlen);
        if (off != 0) {
          self.cg_storeRax(off);
        } else {
          var goff: int64 := self.cg_findGlobal(name, nlen);
          if (goff >= 0) { self.cg_storeRaxGlobal(goff); }
        }
      } else if (self.cg_nkind(lhs) == CGN_FIELD) {
        // obj.field := rhs
        self.cg_genExpr(rhs);
        self.cg_pushRax();
        var obj: int64 := self.cg_nc0(lhs);
        var fieldName: pchar := self.cg_nsval(lhs);
        var fieldLen:  int64 := self.cg_nslen(lhs);
        self.cg_genExpr(obj);
        var classIdx: int64 := self.cg_objClassIdx(obj);
        var foff: int64 := -1;
        if (classIdx >= 0) { foff := self.cg_getFieldOffset(classIdx, fieldName, fieldLen); }
        self.cg_popRsi();
        if (foff == 0) {
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x30);
        } else if (foff > 0 && foff <= 127) {
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x70); self.cg_e8(foff);
        } else if (foff > 127) {
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xB0); self.cg_e32(foff);
        }
      } else if (self.cg_nkind(lhs) == CGN_INDEX) {
        // arr[i] := rhs — three-way dispatch (same as CGN_INDEX read)
        self.cg_genExpr(rhs);              // rax = value
        self.cg_pushRax();
        self.cg_genExpr(self.cg_nc1(lhs)); // rax = index
        self.cg_pushRax();
        self.cg_genExpr(self.cg_nc0(lhs)); // rax = array ptr
        self.cg_popRbx();                  // rbx = index
        var lhsBase: int64 := self.cg_nc0(lhs);
        var lhsIsArray: int64 := 0;
        if (self.cg_nkind(lhsBase) == CGN_IDENT) {
          var llidx: int64 := self.cg_findLocalIdx(self.cg_nsval(lhsBase), self.cg_nslen(lhsBase));
          if (llidx >= 0 && peek8(self.localIsArray + llidx) != 0) { lhsIsArray := 1; }
        }
        if (lhsIsArray == 1) {
          // array<T> local: skip 16-byte header
          // lea rcx, [rax+16]
          self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x48); self.cg_e8(0x10);
          // pop rsi (value)
          self.cg_e8(0x5E);
          // mov [rcx+rbx*8], rsi
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x34); self.cg_e8(0xD9);
        } else {
          // plain ptr: direct 8-byte stride
          // pop rsi (value)
          self.cg_e8(0x5E);
          // mov [rax+rbx*8], rsi
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x34); self.cg_e8(0xD8);
        }
      }

    } else if (k == CGN_RETURN) {
      var expr: int64 := self.cg_nc0(ni);
      if (expr >= 0) {
        self.cg_genExpr(expr);
      } else {
        self.cg_zeroRax();
      }
      self.cg_emitEpilogue();

    } else if (k == CGN_EXPR_STMT) {
      self.cg_genExpr(self.cg_nc0(ni));

    } else if (k == CGN_IF) {
      self.cg_genIf(ni);

    } else if (k == CGN_WHILE) {
      self.cg_genWhile(ni);

    } else if (k == CGN_REPEAT_UNTIL) {
      self.cg_genRepeatUntil(ni);

    } else if (k == CGN_TUPLE_VAR_DECL) {
      self.cg_genTupleVarDecl(ni);

    } else if (k == CGN_FOR) {
      self.cg_genFor(ni);

    } else if (k == CGN_FOR_C) {
      self.cg_genForC(ni);

    } else if (k == CGN_SWITCH) {
      self.cg_genSwitch(ni);

    // WP-15: Pattern matching - generate like switch
    } else if (k == CGN_MATCH) {
      self.cg_genMatch(ni);

    } else if (k == CGN_DISPOSE) {
      // dispose obj: call munmap? Skip for bootstrap.
      // Just evaluate the expression (no-op effect on expr result)
      self.cg_genExpr(self.cg_nc0(ni));

    // WP-12: Exception handling — setjmp/longjmp based
    } else if (k == CGN_TRY) {
      // jmp_buf layout on stack (80 bytes):
      //   [rsp+0..39]: callee-saved regs (rbx,rbp,r12,r13,r14,r15)
      //   [rsp+48]: saved rsp (= jmp_buf base, since mov rax,rsp before sub)
      //   [rsp+56]: catch_label ip
      //   [rsp+64]: old _lyx_exn_ptr

      // sub rsp, 80
      self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC);
      self.cg_e8(0x50); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      // Save callee-saved registers
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x1C); self.cg_e8(0x24); // mov [rsp], rbx
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x6C); self.cg_e8(0x24); self.cg_e8(0x08); // mov [rsp+8], rbp
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x64); self.cg_e8(0x24); self.cg_e8(0x10); // mov [rsp+16], r12
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x6C); self.cg_e8(0x24); self.cg_e8(0x18); // mov [rsp+24], r13
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x20); // mov [rsp+32], r14
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x28); // mov [rsp+40], r15
      // Save rsp value to [rsp+48] (= current rsp = jmp_buf base; longjmp restores rsp←rax)
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE0);                     // mov rax, rsp
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x30); // mov [rsp+48], rax
      // Save catch_label address to [rsp+56] via forward-patched LEA
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);  // lea rax, [rip+disp32]
      var catchLblPatch: int64 := self.codeLen;
      self.cg_e32(0);                                           // patched after catch label is known
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x38); // mov [rsp+56], rax
      // Save old handler from _lyx_exn_ptr to [rsp+64]
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);   // mov rax, [rcx]
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x40); // mov [rsp+64], rax
      // Install new handler: _lyx_exn_ptr ← rsp
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE0);   // mov rax, rsp
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x01);   // mov [rcx], rax
      // Generate try body
      self.cg_genBlock(self.cg_nc0(ni));
      // Try success: restore old handler
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x40); // mov rax, [rsp+64]
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x01);   // mov [rcx], rax
      // Generate finally block on success path (if present)
      var finallyNi: int64 := self.cg_nc2(ni);
      if (finallyNi >= 0) { self.cg_genBlock(finallyNi); }
      // Jump past catch to try_done
      self.cg_e8(0xE9);
      var tryDonePatch: int64 := self.codeLen;
      self.cg_e32(0);
      // === catch_label ===
      var catchOff: int64 := self.codeLen;
      poke32(self.code + catchLblPatch, catchOff - catchLblPatch - 4);
      // longjmp has restored registers and rsp = jmp_buf base
      // Restore old handler
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x40); // mov rax, [rsp+64]
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x01);   // mov [rcx], rax
      // Load exception value for catch binding
      self.cg_emitLeaRcxData(CG_EXN_VAL);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);   // mov rax, [rcx]
      // Generate catch clauses (c1 = first catch, nnext-linked)
      var catchNi: int64 := self.cg_nc1(ni);
      while (catchNi >= 0) {
        self.cg_genBlock(self.cg_nc0(catchNi));  // catch body
        catchNi := self.cg_nnext(catchNi);
      }
      // Generate finally block on catch path
      if (finallyNi >= 0) { self.cg_genBlock(finallyNi); }
      // === try_done ===
      poke32(self.code + tryDonePatch, self.codeLen - tryDonePatch - 4);
      // add rsp, 80  — restore stack frame
      self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xC4);
      self.cg_e8(0x50); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);

    } else if (k == CGN_CATCH || k == CGN_FINALLY) {
      // Standalone catch/finally outside try — just generate body
      self.cg_genBlock(self.cg_nc0(ni));

    } else if (k == CGN_THROW) {
      // WP-12: throw expr — store exception value, longjmp or exit(1)
      self.cg_genExpr(self.cg_nc0(ni));               // rax = exception value
      self.cg_emitLeaRcxData(CG_EXN_VAL);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x01);   // mov [rcx], rax
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);   // mov rax, [rcx]
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
      self.cg_e8(0x0F); self.cg_e8(0x84);
      var throwNH: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_genLongjmp();
      poke32(self.code + throwNH, self.codeLen - throwNH - 4);
      // no handler: sys_exit(1)
      self.cg_movRaxImm(1);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);   // mov rdi, rax
      self.cg_movRaxImm(60);
      self.cg_e8(0x0F); self.cg_e8(0x05);                      // syscall (sys_exit)

    } else if (k == CGN_ASSERT) {
      // WP-BC-07: assert(cond) — write "assertion failed\n" to stderr + exit(1) if cond == 0
      var condNode: int64 := self.cg_nc0(ni);
      if (condNode >= 0) {
        self.cg_genExpr(condNode);  // result in rax
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x75);                                         // jnz short (skip panic)
        var pSkip: int64 := self.codeLen;
        self.cg_e8(0);                                            // placeholder
        // Inline panic: lea rsi, [rip+msgOff]; mov edx, 17; mov edi, 2; mov eax, 1; syscall; exit(1)
        var msgOff: int64 := self.dataLen;
        self.cg_edata(97);  self.cg_edata(115); self.cg_edata(115); // ass
        self.cg_edata(101); self.cg_edata(114); self.cg_edata(116); // ert
        self.cg_edata(105); self.cg_edata(111); self.cg_edata(110); // ion
        self.cg_edata(32);  self.cg_edata(102); self.cg_edata(97);  //  fa
        self.cg_edata(105); self.cg_edata(108); self.cg_edata(101); // ile
        self.cg_edata(100); self.cg_edata(10);  self.cg_edata(0);   // d\n\0 (17 chars + NUL)
        // lea rsi, [rip+disp32]  (48 8D 35 disp32)
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
        var pData: int64 := self.codeLen;
        self.cg_e32(0);
        self.cg_addPatch(pData, msgOff, 0, CG_PATCH_STR);       // resolve RIP-relative offset
        self.cg_e8(0xBA); self.cg_e8(17);  self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);  // mov edx, 17
        self.cg_e8(0xBF); self.cg_e8(2);   self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);  // mov edi, 2 (stderr)
        self.cg_e8(0xB8); self.cg_e8(1);   self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);  // mov eax, 1 (sys_write)
        self.cg_e8(0x0F); self.cg_e8(0x05);                                                // syscall
        self.cg_e8(0xBF); self.cg_e8(1);   self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);  // mov edi, 1 (exit code)
        self.cg_movRaxImm(60);                                                              // mov rax, 60 (sys_exit)
        self.cg_e8(0x0F); self.cg_e8(0x05);                                                // syscall
        poke8(self.code + pSkip, self.codeLen - pSkip - 1);  // patch jnz offset
      }

    // WP-BC-10: panic(msg) — evaluate msg → rdi, emit inline panic body
    } else if (k == CGN_PANIC) {
      var msgNode: int64 := self.cg_nc0(ni);
      if (msgNode >= 0) {
        self.cg_genExpr(msgNode);                                   // msg → rax
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);     // mov rdi, rax
        self.cg_emitPanicBody();
      }

    // WP-BC-09: pool { stmt* } — in bootstrap, pool is a no-op; just emit the body
    } else if (k == CGN_POOL) {
      var bodyNode: int64 := self.cg_nc0(ni);
      if (bodyNode >= 0) { self.cg_genStmt(bodyNode); }

    } else if (k == CGN_BREAK) {
      // jmp rel32 to loop exit; placeholder stores previous break-list head
      self.cg_e8(0xE9);
      var bp: int64 := self.codeLen;
      self.cg_e32(self.curBreakHead);  // link to previous
      self.curBreakHead := bp;

    } else if (k == CGN_CONTINUE) {
      // jmp rel32 to loop continue; placeholder stores previous continue-list head
      self.cg_e8(0xE9);
      var cp: int64 := self.codeLen;
      self.cg_e32(self.curContHead);  // link to previous
      self.curContHead := cp;

    } else if (k == CGN_CASE) {
      // Switch case body — generate body expression/block
      // c0 = case value (or null for default), c1 = body
      var bodyNode: int64 := self.cg_nc1(ni);
      if (bodyNode >= 0) {
        self.cg_genBlock(bodyNode);
      }

    } else if (k == CGN_MATCH_CASE) {
      // Match case body — generate body expression
      // c0 = pattern, c1 = body expression
      var bodyNode: int64 := self.cg_nc1(ni);
      if (bodyNode >= 0) {
        self.cg_genExpr(bodyNode);
      }

    } else if (k == CGN_FIELD_DECL) {
      // Field declaration in struct/class — no code generation needed
      // Layout is handled by cg_buildStructLayout/cg_buildClassLayout
      // Just skip (fields are processed during layout building)

    } else if (k == CGN_PARAM) {
      // Parameter declaration — already handled during function prologue generation
      // In IR-lowering context: register parameter as local variable
      var pname: pchar := self.cg_nsval(ni);
      var plen: int64 := self.cg_nslen(ni);
      var poff: int64 := self.cg_addLocal(pname, plen);
      // Track type if present (c0 = type node)
      var ptypeNode: int64 := self.cg_nc0(ni);
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == 60) {
        self.cg_setLocalType(self.localCount - 1, self.cg_nsval(ptypeNode), self.cg_nslen(ptypeNode));
      }

    } else {
      // Other statement kinds: skip
    }
  }

  fn cg_genBlock(ni: int64) {
    if (ni < 0) { return; }
    var savedLocals: int64 := self.localCount;
    var stmt: int64 := self.cg_nc0(ni);
    while (stmt != -1) {
      var sk: int64 := self.cg_nkind(stmt);
      // WP-13: Nested function declaration inside a block - generate as closure
      if (sk == CGN_FUNC_DECL) {
        // Check if this is a nested function (has outer function context)
        // For now, generate nested functions with static link support
        self.cg_genNestedFunc(stmt);
      } else {
        self.cg_genStmt(stmt);
      }
      stmt := self.cg_nnext(stmt);
    }
    // Restore local scope (pop locals declared in this block)
    self.localCount := savedLocals;
  }

  // WP-13: Generate nested function with static link support
  fn cg_genNestedFunc(ni: int64) {
    // Register label for nested function (mangled with parent context)
    var fname: pchar := self.cg_nsval(ni);
    var fnlen: int64 := self.cg_nslen(ni);

    // Generate unique nested function name with parent suffix
    var nestedLabel: int64 := self._allocNestedLabel(fname, fnlen);
    self.cg_addLabel(nestedLabel, 16, self.cg_lineOf(ni));

    // Reset locals but preserve outer function's captured variables
    self.localCount := 0;
    self.frameSize := 0;

    // Check if we have a static link from parent (passed via [rbp+16])
    var hasStaticLink: int64 := 0;
    if (self.staticLinkOffset >= 0) {
      hasStaticLink := 1;
      // Save static link to local slot for captured variable access
      var slOff: int64 := self.cg_addLocal("__static_link__", 15);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x45); self.cg_e8(0x10); // mov rax, [rbp+16]
      self.cg_storeRax(slOff);  // store to local slot
    }

    // Emit prologue with extra space for static link parameter
    var prologuePatch: int64 := self.cg_emitPrologueNested();

    // Spill parameters (child0 = first param, linked via next)
    var param: int64 := self.cg_nc0(ni);
    var paramIdx: int64 := 0;
    while (param != -1 && paramIdx < 6) {
      var pname: pchar := self.cg_nsval(param);
      var pnlen: int64 := self.cg_nslen(param);
      var off: int64 := self.cg_addLocal(pname, pnlen);
      if (paramIdx == 0) { self.cg_spillRdi(off); }
      else if (paramIdx == 1) { self.cg_spillRsi(off); }
      else if (paramIdx == 2) { self.cg_spillRdx(off); }
      else if (paramIdx == 3) { self.cg_spillRcx(off); }
      else if (paramIdx == 4) { self.cg_spillR8(off); }
      else if (paramIdx == 5) { self.cg_spillR9(off); }
      paramIdx := paramIdx + 1;
      param := self.cg_nnext(param);
    }

    // BUG-04: Capture analysis — scan body for identifiers not in local scope
    // These must be captured from the outer function's frame
    var body: int64 := self.cg_nc2(ni);
    self._analyzeCaptured(body);

    // Generate function body (child2 = block)
    var savedStaticLink: int64 := self.staticLinkOffset;
    var savedOuterName: pchar := self.outerFuncName;
    var savedOuterLen: int64 := self.outerFuncNameLen;

    // Set up static link context for this nested function
    self.staticLinkOffset := 16;  // rbp+16 = static link param position
    // Capture current function name as outer function

    body := self.cg_nc2(ni);
    self.cg_genBlock(body);

    // Restore outer function context
    self.staticLinkOffset := savedStaticLink;
    self.outerFuncName := savedOuterName;
    self.outerFuncNameLen := savedOuterLen;

    // Implicit return
    self.cg_zeroRax();
    self.cg_emitEpilogue();

    // Patch sub rsp with aligned frame size
    var fs: int64 := self.frameSize + 15;
    var aligned: int64 := fs - (fs & 15);
    if (aligned == 0) { aligned := 16; }
    poke32(self.code + prologuePatch, aligned);
  }

  // BUG-04: Recursively scan AST for identifiers not in local scope
  // and register them as captured variables from the outer function.
  // Must be called AFTER parameter locals are registered but BEFORE codegen.
  fn _analyzeCaptured(ni: int64) {
    if (ni < 0) { return; }
    var k: int64 := self.cg_nkind(ni);

    if (k == CGN_IDENT) {
      var name: pchar := self.cg_nsval(ni);
      var nlen: int64 := self.cg_nslen(ni);
      // Skip built-in identifiers and constants
      if (self.cg_findLocal(name, nlen) == 0 &&
          self.cg_findCon(name, nlen) == 0) {
        // Not local and not constant — check if already captured
        if (self.cg_findCapturedVar(name, nlen) == 0) {
          // Register as captured; offset resolved at runtime via static link
          self.cg_addCapturedVar(name, nlen, 0);
        }
      }
    }

    // Recurse into children (expressions and sub-statements)
    // Do NOT follow nnext here — statement lists are handled separately
    var c0: int64 := self.cg_nc0(ni);
    if (c0 >= 0) { self._analyzeCaptured(c0); }
    var c1: int64 := self.cg_nc1(ni);
    if (c1 >= 0) { self._analyzeCaptured(c1); }
    var c2: int64 := self.cg_nc2(ni);
    if (c2 >= 0) { self._analyzeCaptured(c2); }
  }

  // Walk a statement list (linked via nnext) and analyze each statement
  fn _analyzeCapturedStmtList(ni: int64) {
    var cur: int64 := ni;
    while (cur >= 0) {
      self._analyzeCaptured(cur);
      cur := self.cg_nnext(cur);
    }
  }

  // WP-13: Generate nested function prologue (accepts static link in rbp+16)
  fn cg_emitPrologueNested(): int64 {
    self.cg_e8(0x55);                          // push rbp
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE5);  // mov rbp, rsp
    // sub rsp, imm32 (48 81 EC xx xx xx xx)
    self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC);
    var patchPos: int64 := self.codeLen;
    self.cg_e32(0);
    // Static link is already in [rbp+16] from caller
    return patchPos;
  }

  // WP-13: Allocate nested function label (simple numbered suffix)
  fn _allocNestedLabel(baseName: pchar, baseLen: int64): pchar {
    // For simplicity, return a fixed label format "_NESTED_0", etc.
    // In full implementation, would dynamically allocate string
    // Just return placeholder - actual label registration handles it
    return "__nested__";
  }

  fn cg_genIf(ni: int64) {
    // WP-10g: dead-branch elimination — if condition is a compile-time constant
    var condNi: int64 := self.cg_nc0(ni);
    if (self.cg_tryFold(condNi) != 0) {
      if (self.foldBuf != 0) {
        self.cg_genBlock(self.cg_nc1(ni));   // condition always true → emit then only
      } else {
        var elseDead: int64 := self.cg_nc2(ni);
        if (elseDead >= 0) {
          if (self.cg_nkind(elseDead) == CGN_BLOCK) {
            self.cg_genBlock(elseDead);
          } else {
            self.cg_genStmt(elseDead);
          }
        }
      }
      return;
    }
    // Evaluate condition
    self.cg_genExpr(condNi);
    // test rax, rax; jz else_label
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
    // jz rel32 (forward)
    self.cg_e8(0x0F); self.cg_e8(0x84);
    var jzPos: int64 := self.codeLen;
    self.cg_e32(0);  // placeholder

    // Then branch
    self.cg_genBlock(self.cg_nc1(ni));

    var elseNode: int64 := self.cg_nc2(ni);
    if (elseNode >= 0) {
      // jmp over else
      self.cg_e8(0xE9);
      var jmpPos: int64 := self.codeLen;
      self.cg_e32(0);
      // Patch jz to here (else start)
      poke32(self.code + jzPos, self.codeLen - jzPos - 4);
      // Else branch
      if (self.cg_nkind(elseNode) == CGN_BLOCK) {
        self.cg_genBlock(elseNode);
      } else {
        self.cg_genStmt(elseNode);
      }
      // Patch jmp to here (end)
      poke32(self.code + jmpPos, self.codeLen - jmpPos - 4);
    } else {
      // Patch jz to here (end, no else)
      poke32(self.code + jzPos, self.codeLen - jzPos - 4);
    }
  }

  fn cg_genWhile(ni: int64) {
    var loopTop: int64 := self.codeLen;
    // Condition
    self.cg_genExpr(self.cg_nc0(ni));
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
    self.cg_e8(0x0F); self.cg_e8(0x84);  // jz exit (forward)
    var jzPos: int64 := self.codeLen;
    self.cg_e32(0);
    // Save and reset break/continue lists for this loop
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead: int64 := self.curContHead;
    self.curBreakHead := -1;
    self.curContHead := -1;
    // Body
    self.cg_genBlock(self.cg_nc1(ni));
    // loop_cont: patch all continue jumps to here
    var ch: int64 := self.curContHead;
    while (ch != -1) {
      var b0: int64 := peek8(self.code + ch) as int64;
      var b1: int64 := peek8(self.code + ch + 1) as int64;
      var b2: int64 := peek8(self.code + ch + 2) as int64;
      var b3: int64 := peek8(self.code + ch + 3) as int64;
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + ch, loopTop - ch - 4);
      ch := nextLink;
    }
    // jmp back to loopTop
    self.cg_e8(0xE9);
    self.cg_e32(loopTop - self.codeLen - 4);
    // Patch jz to here (loop exit)
    poke32(self.code + jzPos, self.codeLen - jzPos - 4);
    // Patch all break jumps to here (walk linked list stored in placeholders)
    var bh: int64 := self.curBreakHead;
    while (bh != -1) {
      // Read 4-byte link stored in placeholder (little-endian)
      var b0: int64 := peek8(self.code + bh) as int64;
      var b1: int64 := peek8(self.code + bh + 1) as int64;
      var b2: int64 := peek8(self.code + bh + 2) as int64;
      var b3: int64 := peek8(self.code + bh + 3) as int64;
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      // Sign-extend if high bit set (handles -1 sentinel)
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      // Patch this break's jmp to jump to current loop exit
      poke32(self.code + bh, self.codeLen - bh - 4);
      bh := nextLink;
    }
    // Restore outer loop's break/continue lists
    self.curBreakHead := savedBreakHead;
    self.curContHead := savedContHead;
  }

  // WP-BC-04: repeat { body } until (cond)
  // body executes first; loop back while cond == 0 (false)
  fn cg_genRepeatUntil(ni: int64) {
    var loopTop: int64 := self.codeLen;
    // Save outer break/continue lists
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead:  int64 := self.curContHead;
    self.curBreakHead := -1;
    self.curContHead  := -1;
    // Body
    self.cg_genBlock(self.cg_nc0(ni));
    // contPos: patch all continue jumps to here (before condition eval)
    var contPos: int64 := self.codeLen;
    var ch: int64 := self.curContHead;
    while (ch != -1) {
      var b0: int64 := peek8(self.code + ch) as int64;
      var b1: int64 := peek8(self.code + ch + 1) as int64;
      var b2: int64 := peek8(self.code + ch + 2) as int64;
      var b3: int64 := peek8(self.code + ch + 3) as int64;
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + ch, contPos - ch - 4);
      ch := nextLink;
    }
    // Condition → rax
    self.cg_genExpr(self.cg_nc1(ni));
    // test rax, rax; jz loopTop  (if cond false → loop back)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
    self.cg_e8(0x0F); self.cg_e8(0x84);                     // jz rel32
    self.cg_e32(loopTop - self.codeLen - 4);
    // exitPos: patch all break jumps here
    var bh: int64 := self.curBreakHead;
    while (bh != -1) {
      var b0: int64 := peek8(self.code + bh) as int64;
      var b1: int64 := peek8(self.code + bh + 1) as int64;
      var b2: int64 := peek8(self.code + bh + 2) as int64;
      var b3: int64 := peek8(self.code + bh + 3) as int64;
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + bh, self.codeLen - bh - 4);
      bh := nextLink;
    }
    // Restore outer loop lists
    self.curBreakHead := savedBreakHead;
    self.curContHead  := savedContHead;
  }

  // WP-BC-05: var a, b := fn()  — 2-value tuple destructure
  // SysV ABI: first return in rax, second in rdx.
  fn cg_genTupleVarDecl(ni: int64) {
    var name1: pchar := self.cg_nsval(ni);
    var len1:  int64 := self.cg_nslen(ni);
    var off1:  int64 := self.cg_addLocal(name1, len1);

    var secondNode: int64 := self.cg_nc0(ni);
    var name2: pchar := self.cg_nsval(secondNode);
    var len2:  int64 := self.cg_nslen(secondNode);
    var off2:  int64 := self.cg_addLocal(name2, len2);

    // Evaluate init (function call) → rax = first, rdx = second
    self.cg_genExpr(self.cg_nc1(ni));

    self.cg_storeRax(off1);
    self.cg_storeRdx(off2);
  }

  fn cg_genFor(ni: int64) {
    // for v = start to/downto limit { body }
    var name: pchar := self.cg_nsval(ni);
    var nlen: int64 := self.cg_nslen(ni);
    var dir: int64  := self.cg_nival(ni);  // 0=to, 1=downto
    var off: int64 := self.cg_addLocal(name, nlen);
    // Init: v = start
    self.cg_genExpr(self.cg_nc0(ni));
    self.cg_storeRax(off);
    var loopTop: int64 := self.codeLen;
    // Save and reset break/continue lists for this loop
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead: int64 := self.curContHead;
    self.curBreakHead := -1;
    self.curContHead := -1;
    // Cond: v <= limit (to) or v >= limit (downto)
    self.cg_loadRax(off);
    self.cg_pushRax();
    self.cg_genExpr(self.cg_nc1(ni));
    self.cg_popRbx();  // rbx=v, rax=limit
    // cmp rbx, rax
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
    self.cg_e8(0x0F);
    if (dir == 0) { self.cg_e8(0x8F); }  // jg exit (v > limit)
    else { self.cg_e8(0x8C); }            // jl exit (v < limit downto)
    var jmpExit: int64 := self.codeLen;
    self.cg_e32(0);
    // Body
    self.cg_genBlock(self.cg_nc2(ni));
    // contPos: patch all continue jumps here (before step, so increment still runs)
    var contPos: int64 := self.codeLen;
    var ch: int64 := self.curContHead;
    while (ch != -1) {
      var b0: int64 := peek8(self.code + ch) as int64;
      var b1: int64 := peek8(self.code + ch + 1) as int64;
      var b2: int64 := peek8(self.code + ch + 2) as int64;
      var b3: int64 := peek8(self.code + ch + 3) as int64;
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + ch, contPos - ch - 4);
      ch := nextLink;
    }
    // Step: v := v + 1 (or -1 for downto)
    self.cg_loadRax(off);
    if (dir == 0) { self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC0); }  // inc rax
    else { self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC8); }            // dec rax
    self.cg_storeRax(off);
    // jmp back to condition
    self.cg_e8(0xE9);
    self.cg_e32(loopTop - self.codeLen - 4);
    // Patch condition exit jump
    poke32(self.code + jmpExit, self.codeLen - jmpExit - 4);
    // Patch all break jumps to here (exit position)
    var bh: int64 := self.curBreakHead;
    while (bh != -1) {
      var bb0: int64 := peek8(self.code + bh) as int64;
      var bb1: int64 := peek8(self.code + bh + 1) as int64;
      var bb2: int64 := peek8(self.code + bh + 2) as int64;
      var bb3: int64 := peek8(self.code + bh + 3) as int64;
      var nextLink: int64 := bb0 + bb1 * 256 + bb2 * 65536 + bb3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + bh, self.codeLen - bh - 4);
      bh := nextLink;
    }
    // Restore break/continue lists
    self.curBreakHead := savedBreakHead;
    self.curContHead := savedContHead;
  }

  // ------------------------------------------------------------------
  // C-style for loop code generation
  // NK_FOR_C: c0=NK_VAR_DECL(init), c1=cond, c2=step, c3=body
  // ------------------------------------------------------------------
  fn cg_genForC(ni: int64) {
    // Init: declare and initialize the loop variable
    var initNi: int64 := self.cg_nc0(ni);
    if (initNi >= 0) {
      var name: pchar := self.cg_nsval(initNi);
      var nlen: int64 := self.cg_nslen(initNi);
      var off: int64 := self.cg_addLocal(name, nlen);
      var initExpr: int64 := self.cg_nc1(initNi);
      if (initExpr >= 0) {
        self.cg_genExpr(initExpr);
        self.cg_storeRax(off);
      }
    }
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead: int64 := self.curContHead;
    self.curBreakHead := -1;
    self.curContHead := -1;
    // loopTop: condition check
    var loopTop: int64 := self.codeLen;
    // Condition (c1): if absent loop is infinite
    var condNi: int64 := self.cg_nc1(ni);
    var jmpExit: int64 := -1;
    if (condNi >= 0) {
      self.cg_genExpr(condNi);
      // test rax, rax; jz exit
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
      self.cg_e8(0x0F); self.cg_e8(0x84);                     // jz rel32
      jmpExit := self.codeLen;
      self.cg_e32(0);
    }
    // Body (c3)
    var bodyNi: int64 := self.cg_nc3(ni);
    if (bodyNi >= 0) { self.cg_genBlock(bodyNi); }
    // contPos: continue lands here (step runs before next condition check)
    var contPos: int64 := self.codeLen;
    var ch: int64 := self.curContHead;
    while (ch != -1) {
      var b0: int64 := peek8(self.code + ch) as int64;
      var b1: int64 := peek8(self.code + ch + 1) as int64;
      var b2: int64 := peek8(self.code + ch + 2) as int64;
      var b3: int64 := peek8(self.code + ch + 3) as int64;
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + ch, contPos - ch - 4);
      ch := nextLink;
    }
    // Step (c2)
    var stepNi: int64 := self.cg_nc2(ni);
    if (stepNi >= 0) { self.cg_genStmt(stepNi); }
    // jmp back to loopTop
    self.cg_e8(0xE9);
    self.cg_e32(loopTop - self.codeLen - 4);
    // Patch condition exit jump
    if (jmpExit >= 0) {
      poke32(self.code + jmpExit, self.codeLen - jmpExit - 4);
    }
    // Patch all break jumps to here
    var bh: int64 := self.curBreakHead;
    while (bh != -1) {
      var bb0: int64 := peek8(self.code + bh) as int64;
      var bb1: int64 := peek8(self.code + bh + 1) as int64;
      var bb2: int64 := peek8(self.code + bh + 2) as int64;
      var bb3: int64 := peek8(self.code + bh + 3) as int64;
      var nextLink: int64 := bb0 + bb1 * 256 + bb2 * 65536 + bb3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + bh, self.codeLen - bh - 4);
      bh := nextLink;
    }
    self.curBreakHead := savedBreakHead;
    self.curContHead := savedContHead;
  }

  // ------------------------------------------------------------------
  // Switch/case code generation (WP-10c)
  // ------------------------------------------------------------------
  // AST: NK_SWITCH { nc0=subject, nc1=first_case }
  //      NK_CASE  { ival=0/1, nc0=value(if !default), nc1=body_block }
  // Strategy: linear if-else chain; default case runs last.
  // Implicit jmp after each case body uses the curBreakHead linked list,
  // so explicit break statements and implicit end-of-case jumps are both
  // patched to the switch_end at once.
  // ------------------------------------------------------------------

  fn cg_genSwitch(ni: int64) {
    // Allocate a temp local to hold the subject value
    var swVar: pchar := "__sw__";
    var swOff: int64 := self.cg_addLocal(swVar, 6);
    self.cg_genExpr(self.cg_nc0(ni));
    self.cg_storeRax(swOff);

    // Save and reset break list (shared between explicit break and implicit case exit)
    var savedBreakHead: int64 := self.curBreakHead;
    self.curBreakHead := -1;

    var defaultCaseNode: int64 := -1;
    var caseCur: int64 := self.cg_nc1(ni);
    while (caseCur != -1) {
      var isDefault: int64 := self.cg_nival(caseCur);
      if (isDefault != 0) {
        defaultCaseNode := caseCur;
      } else {
        // subject → rbx, case value → rax
        self.cg_loadRax(swOff);
        self.cg_pushRax();
        self.cg_genExpr(self.cg_nc0(caseCur));
        self.cg_popRbx();
        // cmp rbx, rax; jne skip_case (rel32)
        self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
        self.cg_e8(0x0F); self.cg_e8(0x85);
        var jnePos: int64 := self.codeLen;
        self.cg_e32(0);
        // Execute case body
        self.cg_genBlock(self.cg_nc1(caseCur));
        // Implicit jmp to switch_end (linked into break list)
        self.cg_e8(0xE9);
        var bp: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bp;
        // Patch jne to next case
        poke32(self.code + jnePos, self.codeLen - jnePos - 4);
      }
      caseCur := self.cg_nnext(caseCur);
    }

    // Default case executes last if no other case matched
    if (defaultCaseNode != -1) {
      self.cg_genBlock(self.cg_nc1(defaultCaseNode));
      // Implicit jmp to switch_end
      self.cg_e8(0xE9);
      var bpd: int64 := self.codeLen;
      self.cg_e32(self.curBreakHead);
      self.curBreakHead := bpd;
    }

    // switch_end: patch all break/implicit-break jmps here
    var bh: int64 := self.curBreakHead;
    while (bh != -1) {
      var b0: int64 := peek8(self.code + bh);
      var b1: int64 := peek8(self.code + bh + 1);
      var b2: int64 := peek8(self.code + bh + 2);
      var b3: int64 := peek8(self.code + bh + 3);
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + bh, self.codeLen - bh - 4);
      bh := nextLink;
    }
    self.curBreakHead := savedBreakHead;
  }

  // WP-15: Generate match statement (like switch but for pattern matching)
  // WP-BC-11: emit comparison for one or-pattern alternative; link je-body into self.orBodyHead
  fn cg_emitOrAlt(matchOff: int64, altPat: int64) {
    if (self.cg_nkind(altPat) == CGN_PATTERN_OR) {
      self.cg_emitOrAlt(matchOff, self.cg_nc0(altPat));
      self.cg_emitOrAlt(matchOff, self.cg_nc1(altPat));
    } else {
      self.cg_loadRax(matchOff);
      self.cg_pushRax();
      var patVal: int64 := self.cg_nival(altPat);
      if (patVal != 0) {
        self.cg_movRaxImm(patVal);
      } else {
        var pn: pchar := self.cg_nsval(altPat);
        var pl: int64  := self.cg_nslen(altPat);
        var po: int64  := self.cg_findLocal(pn, pl);
        if (po != 0) { self.cg_loadRax(po); } else { self.cg_zeroRax(); }
      }
      self.cg_popRbx();
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);   // cmp rbx, rax
      self.cg_e8(0x0F); self.cg_e8(0x84);                       // je rel32
      var jePos: int64 := self.codeLen;
      self.cg_e32(self.orBodyHead);
      self.orBodyHead := jePos;
    }
  }

  fn cg_genMatch(ni: int64) {
    // c0 = discriminant expression, c1 = cases (next-linked)
    // Allocate a temp local to hold the subject value
    var matchVar: pchar := "__match__";
    var matchOff: int64 := self.cg_addLocal(matchVar, 8);
    self.cg_genExpr(self.cg_nc0(ni));
    self.cg_storeRax(matchOff);

    // Save and reset break list
    var savedBreakHead: int64 := self.curBreakHead;
    self.curBreakHead := -1;

    var defaultCaseNode: int64 := -1;
    var caseCur: int64 := self.cg_nc1(ni);  // first match case
    while (caseCur != -1) {
      // c0 = pattern, c1 = body expression, c2 = guard (or -1)
      var patNode: int64 := self.cg_nc0(caseCur);
      var bodyNode: int64 := self.cg_nc1(caseCur);
      var guardNode: int64 := self.cg_nc2(caseCur);
      var patKind: int64 := self.cg_nkind(patNode);

      // WP-BC-11: or-pattern — try each alternative; if any matches, jmp to body
      if (patKind == CGN_PATTERN_OR) {
        var savedOrBodyHead: int64 := self.orBodyHead;
        self.orBodyHead := -1;
        self.cg_emitOrAlt(matchOff, patNode);   // emit je-body for each alt
        // No alternative matched → jmp next_case
        self.cg_e8(0xE9);
        var jmpNextCase: int64 := self.codeLen;
        self.cg_e32(0);
        // Patch all je-body jumps → current position (body entry)
        var oh: int64 := self.orBodyHead;
        while (oh != -1) {
          var lnk: int64 := peek8(self.code + oh) + peek8(self.code + oh + 1) * 256 + peek8(self.code + oh + 2) * 65536 + peek8(self.code + oh + 3) * 16777216;
          if (lnk >= 2147483648) { lnk := lnk - 4294967296; }
          poke32(self.code + oh, self.codeLen - oh - 4);
          oh := lnk;
        }
        self.orBodyHead := savedOrBodyHead;
        // Guard check (if present)
        var guardFailPos: int64 := -1;
        if (guardNode >= 0) {
          self.cg_genExpr(guardNode);
          self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
          self.cg_e8(0x0F); self.cg_e8(0x84);                      // jz guard_fail
          guardFailPos := self.codeLen;
          self.cg_e32(0);
        }
        self.cg_genExpr(bodyNode);
        self.cg_e8(0xE9);
        var bpOR: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bpOR;
        // Patch next_case and guard_fail → here
        poke32(self.code + jmpNextCase, self.codeLen - jmpNextCase - 4);
        if (guardFailPos >= 0) { poke32(self.code + guardFailPos, self.codeLen - guardFailPos - 4); }

      // Wildcard pattern - treat as default
      } else if (patKind == CGN_PATTERN_WILD) {
        defaultCaseNode := caseCur;
      } else if (patKind == CGN_PATTERN_STRUCT) {
        // WP-15: Struct destructure pattern: Point { x: patX, y: patY }
        // sval = struct type name, c0 = first field pattern (NK_PATTERN_BIND)
        var structName: pchar := self.cg_nsval(patNode);
        var structLen: int64 := self.cg_nslen(patNode);
        
        // Load the struct value
        self.cg_loadRax(matchOff);
        self.cg_pushRax();  // save struct value
        
        // Find the struct/class layout
        var structOff: int64 := self.cg_findClass(structName, structLen);
        if (structOff != -1) {
          // Iterate over field patterns
          var fieldPat: int64 := self.cg_nc0(patNode);
          var matchFailed: int64 := 0;
          while (fieldPat != -1) {
            // fieldPat is NK_PATTERN_BIND with sval = field name
            var fieldName: pchar := self.cg_nsval(fieldPat);
            var fieldLen: int64 := self.cg_nslen(fieldPat);
            var innerPat: int64 := self.cg_nc0(fieldPat);  // inner pattern
            
            // Find field offset in struct
            var fldOff: int64 := self.cg_findField(structOff, fieldName, fieldLen);
            if (fldOff != -1) {
              // Load field value from struct
              self.cg_popRax();
              self.cg_pushRax();
              // mov rax, [rax + fieldOffset]
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40);
              self.cg_e8(fldOff as int64);
              
              // Generate code for inner pattern (recursive match on field value)
              var innerPatKind: int64 := self.cg_nkind(innerPat);
              if (innerPatKind == CGN_PATTERN_BIND) {
                // Binding pattern: bind field value to new variable
                var bindName: pchar := self.cg_nsval(innerPat);
                var bindLen: int64 := self.cg_nslen(innerPat);
                var bindOff: int64 := self.cg_addLocal(bindName, bindLen);
                self.cg_storeRax(bindOff);
              } else if (innerPatKind == CGN_PATTERN_LIT) {
                // Literal pattern: compare
                var patVal: int64 := self.cg_nival(innerPat);
                self.cg_pushRax();
                if (patVal != 0) {
                  self.cg_movRaxImm(patVal);
                } else {
                  var patName: pchar := self.cg_nsval(innerPat);
                  var patNameLen: int64 := self.cg_nslen(innerPat);
                  var patNameOff: int64 := self.cg_findLocal(patName, patNameLen);
                  if (patNameOff != 0) {
                    self.cg_loadRax(patNameOff);
                  } else {
                    self.cg_zeroRax();
                  }
                }
                self.cg_popRbx();
                // cmp rbx, rax; jne fail
                self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
                self.cg_e8(0x0F); self.cg_e8(0x85);
                var jnePos2: int64 := self.codeLen;
                self.cg_e32(0);
                // Field matched - continue
                poke32(self.code + jnePos2, self.codeLen - jnePos2 - 4);
              }
              // Wildcard pattern: do nothing (field value ignored)
            }
            fieldPat := self.cg_nnext(fieldPat);
          }
          // All fields matched - execute case body
          self.cg_popRax();
          self.cg_genExpr(bodyNode);
          // Implicit jmp to match_end
          self.cg_e8(0xE9);
          var bp2: int64 := self.codeLen;
          self.cg_e32(self.curBreakHead);
          self.curBreakHead := bp2;
        } else {
          // Unknown struct type - treat as wildcard
          self.cg_popRax();
          defaultCaseNode := caseCur;
        }
      } else if (patKind == CGN_PATTERN_ENUM) {
        // BUG-08: Enum payload pattern: Ok(value) or Err(msg)
        // sval = enum variant name, c0 = binding pattern for payload
        var varName: pchar := self.cg_nsval(patNode);
        var varLen: int64 := self.cg_nslen(patNode);

        // Find the variant tag across all enums
        var foundTag: int64 := -1;
        var payloadSize: int64 := 0;
        var ei: int64 := 0;
        while (ei < self.enumCount) {
          var tagInfo: int64 := self.cg_findEnumVariant(ei, varName, varLen);
          if (tagInfo >= 0) {
            foundTag := tagInfo & 0xFFFFFFFF;
            payloadSize := tagInfo >> 32;
            break;
          }
          ei := ei + 1;
        }

        if (foundTag >= 0) {
          // Load subject value (tag is in lower 32 bits)
          self.cg_loadRax(matchOff);
          self.cg_pushRax();  // save subject for payload extraction

          // Compare subject tag with variant tag
          // mov rax, subject_tag (already in rax)
          // cmp rax, foundTag
          self.cg_e8(0x48); self.cg_e8(0x3D);
          self.cg_e32(foundTag);
          // jne skip_case
          self.cg_e8(0x0F); self.cg_e8(0x85);
          var jnePos: int64 := self.codeLen;
          self.cg_e32(0);

          // Tags match — extract payload bindings if present
          var bindPat: int64 := self.cg_nc0(patNode);
          var bindIdx: int64 := 0;
          while (bindPat != -1) {
            var bindName: pchar := self.cg_nsval(bindPat);
            var bindLen: int64 := self.cg_nslen(bindPat);
            // Payload is at subject + 8 (after tag) + bindIdx * 8
            self.cg_popRax();
            self.cg_pushRax();
            // mov rax, [rax + 8 + bindIdx*8]
            var payOff: int64 := 8 + bindIdx * 8;
            if (payOff <= 127) {
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40);
              self.cg_e8(payOff);
            } else {
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80);
              self.cg_e32(payOff);
            }
            // Store payload value in local variable
            var bindLocalOff: int64 := self.cg_addLocal(bindName, bindLen);
            self.cg_storeRax(bindLocalOff);
            self.cg_pushRax();  // restore subject for next binding
            bindIdx := bindIdx + 1;
            bindPat := self.cg_nnext(bindPat);
          }
          self.cg_popRax();  // discard saved subject

          // Execute case body
          self.cg_genExpr(bodyNode);
          // Implicit jmp to match_end
          self.cg_e8(0xE9);
          var bp: int64 := self.codeLen;
          self.cg_e32(self.curBreakHead);
          self.curBreakHead := bp;

          // Patch jne to next case
          poke32(self.code + jnePos, self.codeLen - jnePos - 4);
        } else {
          // Unknown variant — treat as wildcard/default
          defaultCaseNode := caseCur;
        }
      } else {
        // Load subject value, compare with pattern
        self.cg_loadRax(matchOff);
        self.cg_pushRax();
        // Pattern literal: c1 = ival for int literals, sval for identifiers
        var patVal: int64 := self.cg_nival(patNode);
        if (patVal != 0) {
          // Integer literal pattern
          self.cg_movRaxImm(patVal);
        } else {
          // Identifier pattern - load from local/symbol
          // For now, assume string-based pattern comparison
          var patName: pchar := self.cg_nsval(patNode);
          var patLen: int64 := self.cg_nslen(patNode);
          var patOff: int64 := self.cg_findLocal(patName, patLen);
          if (patOff != 0) {
            self.cg_loadRax(patOff);
          } else {
            self.cg_zeroRax();
          }
        }
        self.cg_popRbx();
        // cmp rbx, rax; jne skip_case
        self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
        self.cg_e8(0x0F); self.cg_e8(0x85);
        var jnePos: int64 := self.codeLen;
        self.cg_e32(0);
        // WP-BC-11: guard check (c2 of case node)
        var guardFail2: int64 := -1;
        if (guardNode >= 0) {
          self.cg_genExpr(guardNode);
          self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
          self.cg_e8(0x0F); self.cg_e8(0x84);                      // jz guard_fail
          guardFail2 := self.codeLen;
          self.cg_e32(0);
        }
        // Execute case body
        self.cg_genExpr(bodyNode);
        // Implicit jmp to match_end
        self.cg_e8(0xE9);
        var bp: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bp;
        // Patch jne (and guard fail) to next case
        poke32(self.code + jnePos, self.codeLen - jnePos - 4);
        if (guardFail2 >= 0) { poke32(self.code + guardFail2, self.codeLen - guardFail2 - 4); }
      }
      caseCur := self.cg_nnext(caseCur);
    }

    // Default/wildcard case executes last if no other case matched
    if (defaultCaseNode != -1) {
      var bodyNode: int64 := self.cg_nc1(defaultCaseNode);
      var defGuard: int64 := self.cg_nc2(defaultCaseNode);
      if (defGuard >= 0) {
        self.cg_genExpr(defGuard);
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x74);                                         // jz short (skip default)
        var defSkip: int64 := self.codeLen;
        self.cg_e8(0);
        self.cg_genExpr(bodyNode);
        self.cg_e8(0xE9);
        var bpDefG: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bpDefG;
        poke8(self.code + defSkip, self.codeLen - defSkip - 1);
      } else {
        self.cg_genExpr(bodyNode);
        self.cg_e8(0xE9);
        var bpd: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bpd;
      }
    }

    // match_end: patch all break/implicit jmps
    var bh: int64 := self.curBreakHead;
    while (bh != -1) {
      var b0: int64 := peek8(self.code + bh);
      var b1: int64 := peek8(self.code + bh + 1);
      var b2: int64 := peek8(self.code + bh + 2);
      var b3: int64 := peek8(self.code + bh + 3);
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + bh, self.codeLen - bh - 4);
      bh := nextLink;
    }
    self.curBreakHead := savedBreakHead;
  }

  // ------------------------------------------------------------------
  // Function declaration
  // ------------------------------------------------------------------

  fn cg_genFuncDecl(ni: int64) {
    // Register label for this function
    var fname: pchar := self.cg_nsval(ni);
    var fnlen: int64 := self.cg_nslen(ni);
    self.cg_addLabel(fname, fnlen, self.cg_lineOf(ni));

    // Save and set outer function context for nested function capture analysis
    var savedOuterName: pchar := self.outerFuncName;
    var savedOuterLen: int64 := self.outerFuncNameLen;
    self.outerFuncName := fname;
    self.outerFuncNameLen := fnlen;

    // Reset locals
    self.localCount := 0;
    self.frameSize  := 0;

    // Emit prologue, capture patch position for sub rsp imm32
    var prologuePatch: int64 := self.cg_emitPrologue();

    // Spill parameters (child0 = first param, linked via next)
    var param: int64 := self.cg_nc0(ni);
    var paramIdx: int64 := 0;
    while (param != -1 && paramIdx < 6) {
      var pname: pchar := self.cg_nsval(param);
      var pnlen: int64 := self.cg_nslen(param);
      var off: int64 := self.cg_addLocal(pname, pnlen);
      // Track param type if it's a user type (NK_TYPE_NAME = 60)
      var ptypeNode: int64 := self.cg_nc0(param);
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == 60) {
        self.cg_setLocalType(self.localCount - 1, self.cg_nsval(ptypeNode), self.cg_nslen(ptypeNode));
      }
      if (paramIdx == 0) { self.cg_spillRdi(off); }
      else if (paramIdx == 1) { self.cg_spillRsi(off); }
      else if (paramIdx == 2) { self.cg_spillRdx(off); }
      else if (paramIdx == 3) { self.cg_spillRcx(off); }
      else if (paramIdx == 4) { self.cg_spillR8(off); }
      else if (paramIdx == 5) { self.cg_spillR9(off); }
      paramIdx := paramIdx + 1;
      param := self.cg_nnext(param);
    }

    // Generate function body (child2 = block)
    var body: int64 := self.cg_nc2(ni);
    self.cg_genBlock(body);

    // Implicit return (xor rax, rax; epilogue)
    self.cg_zeroRax();
    self.cg_emitEpilogue();

    // Patch sub rsp with aligned frame size
    var fs: int64 := self.frameSize + 15;
    var aligned: int64 := fs - (fs & 15);
    if (aligned == 0) { aligned := 16; }
    poke32(self.code + prologuePatch, aligned);

    // Restore outer function context
    self.outerFuncName := savedOuterName;
    self.outerFuncNameLen := savedOuterLen;
  }

  // ------------------------------------------------------------------
  // Helper functions emitted at start of code buffer
  // Fixed byte sequences encoding _start, _lyx_strlen, _lyx_print_str,
  // and _lyx_print_int.
  // ------------------------------------------------------------------

  fn cg_emitHelpers() {
    // ---- _start (65 bytes) ----
    // At Linux ABI entry: [rsp]=argc, [rsp+8]=argv[0], ...
    // First: call prlimit64 to remove RLIMIT_STACK (allows deep recursion in parser)
    // sub rsp, 16       (48 83 EC 10)
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x10);
    // mov rax, -1       (48 C7 C0 FF FF FF FF)  RLIM_INFINITY
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0);
    self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);
    // mov [rsp], rax    (48 89 04 24)  rlim_cur
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);
    // mov [rsp+8], rax  (48 89 44 24 08)  rlim_max
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);
    // xor edi, edi      (31 FF)  pid = 0
    self.cg_e8(0x31); self.cg_e8(0xFF);
    // mov esi, 3        (BE 03 00 00 00)  RLIMIT_STACK
    self.cg_e8(0xBE); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov rdx, rsp      (48 89 E2)  new_limit = &rlimit_struct
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE2);
    // xor r10d, r10d    (45 31 D2)  old_limit = NULL
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);
    // mov eax, 302      (B8 2E 01 00 00)  SYS_prlimit64
    self.cg_e8(0xB8); self.cg_e8(0x2E); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall           (0F 05)
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // add rsp, 16       (48 83 C4 10)  restore stack
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);
    // 5F               pop rdi          -- rdi = argc
    self.cg_e8(0x5F);
    // 48 89 E6         mov rsi, rsp     -- rsi = &argv[0] (argv pointer)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE6);
    // E8 xx xx xx xx   call main        (patched after all functions)
    self.cg_e8(0xE8);
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, "main" as int64, 4, CG_PATCH_CALL);
    // 48 89 C7         mov rdi, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);
    // 48 C7 C0 3C 00 00 00   mov rax, 60 (sys_exit)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0);
    self.cg_e8(0x3C); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // 0F 05            syscall
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // _start is now 65 bytes  ✓

    // ---- _lyx_strlen (15 bytes, starts at offset 65) ----
    // xor rax, rax
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    // cmp byte [rdi+rax], 0
    self.cg_e8(0x80); self.cg_e8(0x3C); self.cg_e8(0x07); self.cg_e8(0x00);
    // jz +5 (to ret at offset 14 from strlen start)
    self.cg_e8(0x74); self.cg_e8(0x05);
    // inc rax
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC0);
    // jmp -11 (back to cmp)
    self.cg_e8(0xEB); self.cg_e8(0xF5);
    // ret
    self.cg_e8(0xC3);
    // strlen is now 15 bytes  ✓

    // ---- _lyx_print_str (26 bytes, starts at offset 80) ----
    // push rdi
    self.cg_e8(0x57);
    // call _lyx_strlen  (rel32 = 21 - 42 = -21; relative offset unchanged after +4 shift)
    self.cg_e8(0xE8); self.cg_e32(-21);
    // mov rdx, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2);
    // pop rdi
    self.cg_e8(0x5F);
    // mov rsi, rdi
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xFE);
    // mov edi, 1  (stdout)
    self.cg_e8(0xBF); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov eax, 1  (sys_write)
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // ret
    self.cg_e8(0xC3);
    // print_str is now 26 bytes  ✓

    // ---- _lyx_print_int (104 bytes, starts at offset 106) ----
    // sub rsp, 24          48 83 EC 18
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x18);
    // lea rsi, [rsp+23]    48 8D 74 24 17
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x17);
    // mov rax, rdi         48 89 F8
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF8);
    // test rax, rax        48 85 C0
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    // jnz +8 (to .nonzero at offset+25)  75 08
    self.cg_e8(0x75); self.cg_e8(0x08);
    // mov byte [rsi], '0'  C6 06 30
    self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x30);
    // dec rsi              48 FF CE
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);
    // jmp .emit (+48)      EB 30  (was +43=EB2B; .emit now 5 bytes further due to sign check)
    self.cg_e8(0xEB); self.cg_e8(0x30);
    // .nonzero: test rax, rax  48 85 C0
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    // jge +3 (.digitloop)  7D 03  (was +9; skip only neg rax, sign written after loop)
    self.cg_e8(0x7D); self.cg_e8(0x03);
    // neg rax              48 F7 D8
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xD8);
    // .digitloop: test rax, rax  48 85 C0
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    // jz +24 (.sign)       74 18  (displacement unchanged: loop shrunk 6, target shrunk 6)
    self.cg_e8(0x74); self.cg_e8(0x18);
    // xor rdx, rdx         48 31 D2
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);
    // mov rcx, 10          48 C7 C1 0A 00 00 00
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1);
    self.cg_e8(0x0A); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // idiv rcx             48 F7 F9
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);
    // add rdx, 48          48 83 C2 30
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC2); self.cg_e8(0x30);
    // mov [rsi], dl        88 16
    self.cg_e8(0x88); self.cg_e8(0x16);
    // dec rsi              48 FF CE
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);
    // jmp .digitloop (-29) EB E3  (displacement unchanged)
    self.cg_e8(0xEB); self.cg_e8(0xE3);
    // .sign: test rdi, rdi (check original sign; rdi preserved through loop)  48 85 FF
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);
    // jns +6 (skip '-' if non-negative)  79 06
    self.cg_e8(0x79); self.cg_e8(0x06);
    // mov byte [rsi], '-'  C6 06 2D
    self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x2D);
    // dec rsi              48 FF CE
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);
    // .emit: inc rsi       48 FF C6
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC6);
    // lea rdx, [rsp+23]    48 8D 54 24 17
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x17);
    // sub rdx, rsi         48 29 F2
    self.cg_e8(0x48); self.cg_e8(0x29); self.cg_e8(0xF2);
    // inc rdx              48 FF C2
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC2);
    // mov edi, 1           BF 01 00 00 00
    self.cg_e8(0xBF); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov eax, 1           B8 01 00 00 00
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall              0F 05
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // add rsp, 24          48 83 C4 18
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x18);
    // ret                  C3
    self.cg_e8(0xC3);
    // print_int is 104 bytes  ✓

    // ---- _lyx_strsub (71 bytes, starts at offset 210) ----
    // StrSub(s: pchar, start: int64, len: int64): pchar
    // rdi=s, rsi=start, rdx=len
    // mmap(0, len+17, 3, 34, -1, 0) → rax = new buffer
    // Save rdi (s) at [rsp+0], rsi (start) at [rsp+8], rdx (len) at [rsp+16]
    // push rdi             57
    self.cg_e8(0x57);
    // push rsi             56
    self.cg_e8(0x56);
    // push rdx             52
    self.cg_e8(0x52);
    // mov rdi, 0           48 C7 C7 00 00 00 00
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7);
    self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // rsi = len+17: mov rsi,[rsp]; nop; add rsi,17  (5 bytes for mov+nop to match old size)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x34); self.cg_e8(0x24); // mov rsi,[rsp]
    self.cg_e8(0x90);                                                          // nop (pad)
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC6); self.cg_e8(0x11); // add rsi,17
    // mov edx, 3           BA 03 00 00 00
    self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov r10, 34          49 C7 C2 22 00 00 00
    self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC2);
    self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov r8, -1           49 C7 C0 FF FF FF FF
    self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC0);
    self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);
    // xor r9, r9 (3 bytes saves 4 vs mov r9,0; offset absorbed by add rsi,17 = +4 bytes net 0)
    self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);
    // mov eax, 9           B8 09 00 00 00
    self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall              0F 05
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // rax = mmap buffer. Do NOT save to [rsp+24] — that is the return address!
    // rax remains valid (not touched) until after the pops.
    // nop × 5              90 90 90 90 90  (keep helper at exactly 71 bytes)
    self.cg_e8(0x90); self.cg_e8(0x90); self.cg_e8(0x90); self.cg_e8(0x90); self.cg_e8(0x90);
    // Copy loop: rdi=dest, rsi=src, rcx=count
    // pop rcx = len        59  (0x5A=pop rdx, 0x59=pop rcx — rcx is the rep movsb count!)
    self.cg_e8(0x59);
    // pop rsi = start      5E
    self.cg_e8(0x5E);
    // pop rdi = orig src   5F  (return address at [rsp] is now correct again)
    self.cg_e8(0x5F);
    // add rsi, rdi         48 01 FE  (rsi = start + src = src + start)
    self.cg_e8(0x48); self.cg_e8(0x01); self.cg_e8(0xFE);
    // mov rdi, rax         48 89 C7  (dest = mmap result; rax preserved)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);
    // rep movsb            F3 A4  (copies rcx=len bytes; after: rdi = mmap_buf+len)
    self.cg_e8(0xF3); self.cg_e8(0xA4);
    // Null-terminate at rdi (= mmap_buf+len); rax still = mmap_buf
    // mov byte [rdi], 0    C6 07 00
    self.cg_e8(0xC6); self.cg_e8(0x07); self.cg_e8(0x00);
    // nop × 3              90 90 90  (pad to keep 71-byte total)
    self.cg_e8(0x90); self.cg_e8(0x90); self.cg_e8(0x90);
    // ret                  C3  (returns rax = mmap_buf)
    self.cg_e8(0xC3);
    // strsub is 71 bytes  ✓

    // ---- _lyx_strcharat (6 bytes, starts at offset 281) ----
    // StrCharAt(s: pchar, i: int64): int64
    // rdi=s, rsi=i, return rax = byte at s[i] zero-extended
    // movzx rax, byte [rdi+rsi]
    self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0x04); self.cg_e8(0x37);
    // ret                  C3
    self.cg_e8(0xC3);
    // strcharat is 6 bytes  ✓

    // ---- _lyx_eprint_str (26 bytes, starts at offset 287) ---- stderr variant
    // push rdi
    self.cg_e8(0x57);
    // call _lyx_strlen  (rel32 = 65 - (287+1+4+1) = 65 - 293 = -228)
    self.cg_e8(0xE8); self.cg_e32(-228);
    // mov rdx, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2);
    // pop rdi
    self.cg_e8(0x5F);
    // mov rsi, rdi
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xFE);
    // mov edi, 2  (stderr)
    self.cg_e8(0xBF); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov eax, 1  (sys_write)
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // ret
    self.cg_e8(0xC3);
    // eprint_str is 26 bytes  ✓

    // ---- _lyx_eprint_int (104 bytes, starts at offset 313) ---- stderr variant
    // Identical to _lyx_print_int but writes to fd=2 instead of fd=1.
    // sub rsp, 24          48 83 EC 18
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x18);
    // lea rsi, [rsp+23]    48 8D 74 24 17
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x17);
    // mov rax, rdi         48 89 F8
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF8);
    // test rax, rax        48 85 C0
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    // jnz +8 (to .nonzero) 75 08
    self.cg_e8(0x75); self.cg_e8(0x08);
    // mov byte [rsi], '0'  C6 06 30
    self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x30);
    // dec rsi              48 FF CE
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);
    // jmp .emit (+48)      EB 30
    self.cg_e8(0xEB); self.cg_e8(0x30);
    // .nonzero: test rax, rax  48 85 C0
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    // jge +3 (.digitloop, skip neg)  7D 03
    self.cg_e8(0x7D); self.cg_e8(0x03);
    // neg rax              48 F7 D8
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xD8);
    // .digitloop: test rax, rax  48 85 C0
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    // jz +24 (.sign)       74 18
    self.cg_e8(0x74); self.cg_e8(0x18);
    // xor rdx, rdx         48 31 D2
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);
    // mov rcx, 10          48 C7 C1 0A 00 00 00
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1);
    self.cg_e8(0x0A); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // idiv rcx             48 F7 F9
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);
    // add rdx, 48          48 83 C2 30
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC2); self.cg_e8(0x30);
    // mov [rsi], dl        88 16
    self.cg_e8(0x88); self.cg_e8(0x16);
    // dec rsi              48 FF CE
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);
    // jmp .digitloop (-29) EB E3
    self.cg_e8(0xEB); self.cg_e8(0xE3);
    // .sign: test rdi, rdi 48 85 FF
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);
    // jns +6               79 06
    self.cg_e8(0x79); self.cg_e8(0x06);
    // mov byte [rsi], '-'  C6 06 2D
    self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x2D);
    // dec rsi              48 FF CE
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);
    // .emit: inc rsi       48 FF C6
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC6);
    // lea rdx, [rsp+23]    48 8D 54 24 17
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x17);
    // sub rdx, rsi         48 29 F2
    self.cg_e8(0x48); self.cg_e8(0x29); self.cg_e8(0xF2);
    // inc rdx              48 FF C2
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC2);
    // mov edi, 2           (stderr — only difference from print_int)  BF 02 00 00 00
    self.cg_e8(0xBF); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov eax, 1  (sys_write)  B8 01 00 00 00
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall              0F 05
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // add rsp, 24          48 83 C4 18
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x18);
    // ret                  C3
    self.cg_e8(0xC3);
    // eprint_int is 104 bytes  ✓
    // Total helpers: 65+15+26+104+71+6+26+104 = 417 = CG_H_USER  ✓
  }

  // ------------------------------------------------------------------
  // Import resolution (WP-09)
  // ------------------------------------------------------------------

  // Read a file into an mmap buffer (null-terminated). Returns null on error.
  fn cg_readFile(path: pchar): pchar {
    var fd: int64 := open(path, 0, 0);
    if (fd < 0) { return 0 as pchar; }
    var size: int64 := lseek(fd, 0, 2);
    if (size <= 0) { close(fd); return 0 as pchar; }
    lseek(fd, 0, 0);
    var buf: int64 := mmap(0, size + 1, 3, 34, -1, 0);
    read(fd, buf as pchar, size);
    poke8(buf + size, 0);
    close(fd);
    return buf as pchar;
  }

  // Returns 1 if module name was already imported, 0 otherwise.
  fn cg_hasImported(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.importCount) {
      var base: int64 := self.importNames + i * 16;
      var p: pchar    := peek64(base) as pchar;
      var n: int64    := peek64(base + 8);
      if (n == nameLen && self.cg_seq(p, n, name, nameLen)) { return 1; }
      i := i + 1;
    }
    return 0;
  }

  // Mark a module as imported (add to dedup set).
  fn cg_markImported(name: pchar, nameLen: int64) {
    if (self.importCount >= self.importCap) {
      var nc: int64 := self.importCap * 2;
      var nb: int64 := mmap(0, nc * 16, 3, 34, -1, 0);
      var i: int64 := 0;
      while (i < self.importCount * 16) {
        poke8(nb + i, peek8(self.importNames + i));
        i := i + 1;
      }
      self.importNames := nb;
      self.importCap   := nc;
    }
    var base: int64 := self.importNames + self.importCount * 16;
    poke64(base,      name as int64);
    poke64(base + 8,  nameLen);
    self.importCount := self.importCount + 1;
  }

  // Process an import: find the .lyx file, parse it, codegen it.
  // Temporarily swaps pSrc/pNodes to the imported file's data.
  fn cg_processImport(modName: pchar, nameLen: int64) {
    if (self.cg_hasImported(modName, nameLen) != 0) { return; }
    self.cg_markImported(modName, nameLen);

    // Convert "bootstrap.parser" → "bootstrap/parser.lyx"
    var pathBuf: int64 := mmap(0, nameLen + 8, 3, 34, -1, 0);
    var i: int64 := 0;
    while (i < nameLen) {
      var c: int64 := StrCharAt(modName, i);
      if (c == 46) { c := 47; }  // '.' → '/'
      poke8(pathBuf + i, c);
      i := i + 1;
    }
    poke8(pathBuf + nameLen,     46);   // '.'
    poke8(pathBuf + nameLen + 1, 108);  // 'l'
    poke8(pathBuf + nameLen + 2, 121);  // 'y'
    poke8(pathBuf + nameLen + 3, 120);  // 'x'
    poke8(pathBuf + nameLen + 4, 0);

    var path: pchar := pathBuf as pchar;
    var src: pchar := self.cg_readFile(path);
    var srcSize: int64 := 0;
    if (src != 0 as pchar) { srcSize := StrLen(src); }
    // BUG-02: pathBuf no longer needed after readFile — free immediately
    munmap(pathBuf, nameLen + 8);

    if (src == 0 as pchar) {
      PrintStr("codegen: cannot read import: ");
      PrintStr(path);
      PrintStr("\n");
      return;
    }

    // Parse the imported file
    var p: Parser := new Parser();
    p.Init(src, srcSize);
    var head: int64 := p.Parse();

    if (p.hadError != 0) {
      PrintStr("codegen: parse error in import: ");
      PrintStr(path);
      PrintStr("\n");
      // BUG-03: Free src buffer before disposing parser on error
      munmap(src, srcSize);
      dispose p;
      return;
    }

    // Switch to imported file's source and nodes for codegen
    var savedSrc:   pchar := self.pSrc;
    var savedNodes: int64 := self.pNodes;
    self.pSrc   := p.src;
    self.pNodes := p.nodes;

    // Recursively generate code for the imported file
    self.cg_genFile(head);
    
    // AP-1: Collect function labels from imported module
    // This makes imported functions visible for patch resolution in main file
    // IMPORTANT: Do this WHILE still switched to import pNodes!
    self.cg_collectImportLabels(head);

    // Restore main file's source and nodes
    self.pSrc   := savedSrc;
    self.pNodes := savedNodes;

    dispose p;
    // NOTE: src (imported source buffer) is intentionally NOT freed here.
    // cg_addLabel/cg_buildStructLayout etc. store raw pointers into src.
    // Freeing src would invalidate those pointers and cause SIGSEGV on lookup.
  }

  // ------------------------------------------------------------------
  // AP-1: Collect labels from imported module
  // Walks the AST and registers all function names as labels for patch resolution
  // ------------------------------------------------------------------
  
  fn cg_collectImportLabels(head: int64): void {
    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_FUNC_DECL) {
        var fname: pchar := self.cg_nsval(cur);
        var fnlen: int64 := self.cg_nslen(cur);
        self.cg_addLabel(fname, fnlen, 0);  // imported: no source line
      }
      cur := self.cg_nnext(cur);
    }
  }

  // WP-BC-24: register a pending generic specialization
  // Entry: {mangledNamePtr:8, mangledNameLen:8, origNamePtr:8, origNameLen:8} = 32 bytes
  fn cg_addMono(mangName: pchar, mangLen: int64, origName: pchar, origLen: int64) {
    if (self.monoCount >= self.monoCap) {
      var nc: int64 := self.monoCap * 2;
      var nb: int64 := mmap(0, nc * 32, 3, 34, -1, 0);
      var ii: int64 := 0;
      while (ii < self.monoCount * 32) { poke8(nb + ii, peek8(self.monoList + ii)); ii := ii + 1; }
      self.monoList := nb; self.monoCap := nc;
    }
    var base: int64 := self.monoList + self.monoCount * 32;
    poke64(base,      mangName as int64);
    poke64(base + 8,  mangLen);
    poke64(base + 16, origName as int64);
    poke64(base + 24, origLen);
    self.monoCount := self.monoCount + 1;
  }

  // WP-BC-24: check if a mangled name is already in the mono list
  fn cg_monoExists(mangName: pchar, mangLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.monoCount) {
      var base: int64 := self.monoList + i * 32;
      var n: pchar := peek64(base) as pchar;
      var l: int64 := peek64(base + 8);
      if (self.cg_seq(n, l, mangName, mangLen) != 0) { return 1; }
      i := i + 1;
    }
    return 0;
  }

  // WP-BC-24: build mangled name for generic call, e.g. "Foo_int64"
  fn cg_buildMangledName(baseName: pchar, baseLen: int64, typeArgsNi: int64, outBuf: int64): int64 {
    var pos: int64 := 0;
    var i: int64 := 0;
    while (i < baseLen) { poke8(outBuf + pos, StrCharAt(baseName, i)); pos := pos + 1; i := i + 1; }
    var ta: int64 := typeArgsNi;
    while (ta >= 0) {
      poke8(outBuf + pos, 95); pos := pos + 1;  // '_'
      var tname: pchar := self.cg_nsval(ta);
      var tlen:  int64 := self.cg_nslen(ta);
      var j: int64 := 0;
      while (j < tlen) { poke8(outBuf + pos, StrCharAt(tname, j)); pos := pos + 1; j := j + 1; }
      ta := self.cg_nnext(ta);
    }
    poke8(outBuf + pos, 0);
    return pos;
  }

  // ------------------------------------------------------------------
  // Top-level file generation
  // ------------------------------------------------------------------

  fn cg_genFile(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_FUNC_DECL) {
        // extern fn NAME(...) link "lib.so": no body (c2 == -1) and a packed
        // library span in c3 ((len<<32)|off). Register it as an FFI import
        // instead of emitting a function body. The (body==-1 && c3!=-1) test
        // distinguishes externs from @export functions, which share iVal==1
        // but always carry a body.
        var libPacked: int64 := self.cg_nc3(cur);
        if (self.cg_nc2(cur) == -1 && libPacked != -1) {
          var libOff: int64 := libPacked & 0xFFFFFFFF;
          var libLen: int64 := (libPacked >> 32) & 0xFFFFFFFF;
          if (libLen > 0) {
            self.cg_addExternDecl(self.cg_nsval(cur), self.cg_nslen(cur),
                                  (self.pSrc as int64) + libOff, libLen);
          }
        } else {
          self.cg_genFuncDecl(cur);
        }
      } else if (k == CGN_IMPORT) {
        // Process the imported module (WP-09: import resolution)
        var modName: pchar := self.cg_nsval(cur);
        var modLen:  int64 := self.cg_nslen(cur);
        self.cg_processImport(modName, modLen);
      } else if (k == CGN_TYPE_DECL) {
        // NK_TYPE_DECL: class if it has methods (nc1 != -1), struct otherwise
        var hasMethods: int64 := self.cg_nc1(cur);
        if (hasMethods == -1) {
          // No methods → treat as struct (fields start at offset 0, no VMT)
          self.cg_buildStructLayout(cur);
        } else {
          // Has methods → class layout (fields at offset 8, VMT at 0)
          self.cg_buildClassLayout(cur);
          var clsName: pchar := self.cg_nsval(cur);
          var clsLen:  int64 := self.cg_nslen(cur);
          var method: int64 := hasMethods;
          while (method != -1) {
            var nextM: int64 := self.cg_nnext(method);
            // WP-BC-20: skip abstract methods (bit3 of iVal) — no code body
            var isAbstM: int64 := (self.cg_nival(method) >> 3) & 1;
            if (isAbstM == 0) {
              self.cg_genMethodDecl(method, clsName, clsLen);
            }
            method := nextM;
          }
        }
      } else if (k == CGN_STRUCT_DECL) {
        // Standalone struct declaration: register field layout (fields at offset 0)
        self.cg_buildStructLayout(cur);
      } else if (k == CGN_ENUM_DECL) {
        // BUG-08: Enum declaration: register variant layout for match analysis
        self.cg_buildEnumLayout(cur);
        // Register enum members as int64 constants (auto-increment from 0)
        var emem: int64 := self.cg_nc0(cur);
        var eVal: int64 := 0;
        while (emem != -1) {
          var evNode: int64 := self.cg_nc0(emem);
          if (evNode >= 0 && self.cg_nkind(evNode) == CGN_LIT_INT) {
            eVal := self.cg_nival(evNode);
          }
          self.cg_addCon(self.cg_nsval(emem), self.cg_nslen(emem), eVal);
          eVal := eVal + 1;
          emem := self.cg_nnext(emem);
        }
      } else if (k == CGN_VAR_DECL) {
        // Global variable: allocate 8 bytes in data section, register in global table
        var gIdx: int64 := self.globalVarCount;
        var doff: int64 := self.cg_addGlobal(self.cg_nsval(cur), self.cg_nslen(cur));
        var gtNode: int64 := self.cg_nc0(cur);
        if (gtNode >= 0 && self.cg_nkind(gtNode) == 60) {
          var gtp: pchar := self.cg_nsval(gtNode);
          var gtn: int64 := self.cg_nslen(gtNode);
          if (gtn == 5 && self.cg_seq(gtp, gtn, "pchar", 5)) {
            poke8(self.globalIsPchar + gIdx, 1);
          }
        }
        // Write literal initializer directly into data section
        var initNode: int64 := self.cg_nc1(cur);
        if (initNode >= 0 && self.cg_nkind(initNode) == CGN_LIT_INT) {
          poke64(self.data + doff, self.cg_nival(initNode));
        }
      } else if (k == CGN_CON_DECL) {
        // Populate constant table for use inside method bodies
        var initNode: int64 := self.cg_nc1(cur);
        if (initNode >= 0 && self.cg_nkind(initNode) == CGN_LIT_INT) {
          self.cg_addCon(self.cg_nsval(cur), self.cg_nslen(cur), self.cg_nival(initNode));
        } else if (initNode >= 0 && self.cg_nkind(initNode) == CGN_LIT_FLOAT) {
          var floatBits: int64 := self.cg_parseFloat(self.pSrc, self.cg_nsoff(initNode), self.cg_nslen(initNode));
          self.cg_addCon(self.cg_nsval(cur), self.cg_nslen(cur), floatBits);
        }
      } else if (k == CGN_ENUM_DECL) {
        // WP-10f: register each enum member as an int64 constant
        // auto-increment from 0; explicit value overrides via child0
        var mem: int64 := self.cg_nc0(cur);
        var nextVal: int64 := 0;
        while (mem != -1) {
          var mname: pchar := self.cg_nsval(mem);
          var mlen:  int64 := self.cg_nslen(mem);
          var valNode: int64 := self.cg_nc0(mem);
          if (valNode >= 0 && self.cg_nkind(valNode) == CGN_LIT_INT) {
            nextVal := self.cg_nival(valNode);
          }
          self.cg_addCon(mname, mlen, nextVal);
          nextVal := nextVal + 1;
          mem := self.cg_nnext(mem);
        }
      } else if (k == CGN_DIM_DECL || k == CGN_UTYPE_DECL) {
        // WP-BC-16: dim/utype are compile-time-only; no code generated
      }
      cur := self.cg_nnext(cur);
    }
    // WP-BC-24: emit JMP stubs for all registered generic specializations
    var mi: int64 := 0;
    while (mi < self.monoCount) {
      var mBase: int64 := self.monoList + mi * 32;
      var mangName: pchar := peek64(mBase) as pchar;
      var mangLen:  int64 := peek64(mBase + 8);
      var origName: pchar := peek64(mBase + 16) as pchar;
      var origLen:  int64 := peek64(mBase + 24);
      // Emit label for mangled name, then JMP rel32 to the generic function
      self.cg_addLabel(mangName, mangLen, 0);  // generic specialization: no direct line
      self.cg_e8(0xE9);
      self.cg_addPatch(self.codeLen, origName as int64, origLen, CG_PATCH_CALL);
      self.cg_e32(0);
      mi := mi + 1;
    }
  }

  // ------------------------------------------------------------------
  // Init and public API
  // ------------------------------------------------------------------

  fn Init(src: pchar, nodes: int64, toks: int64) {
    self.pSrc   := src;
    self.pNodes := nodes;
    self.pToks  := toks;

    self.codeCap := 65536;
    self.code    := mmap(0, self.codeCap, 3, 34, -1, 0);
    self.codeLen := 0;

    self.dataCap := 16384;
    self.data    := mmap(0, self.dataCap, 3, 34, -1, 0);
    self.dataLen := 16;  // WP-12: pre-reserve 16 bytes for exception globals (EXN_VAL@0, EXN_PTR@8)

    self.localCap  := 64;
    self.locals    := mmap(0, self.localCap * CG_LOCAL_SZ, 3, 34, -1, 0);
    self.localCount := 0;
    self.frameSize  := 0;

    self.labelCap  := 128;
    self.labels    := mmap(0, self.labelCap * CG_LABEL_SZ, 3, 34, -1, 0);
    self.labelCount := 0;

    self.patchCap  := 512;
    self.patches   := mmap(0, self.patchCap * CG_PATCH_SZ, 3, 34, -1, 0);
    self.patchCount := 0;

    self.externDeclCap   := 128;
    self.externDecls     := mmap(0, self.externDeclCap * CG_EXTERN_SZ, 3, 34, -1, 0);
    self.externDeclCount := 0;
    self.externCap   := 64;
    self.externSyms  := mmap(0, self.externCap * CG_EXTERN_SZ, 3, 34, -1, 0);
    self.externCount := 0;

    self.nextLblId := 0;

    // Import dedup (WP-09)
    self.importCap   := 32;
    self.importNames := mmap(0, self.importCap * 16, 3, 34, -1, 0);
    self.importCount := 0;

    // Class layout table (WP-09 OOP)
    self.classCap    := 16;
    self.classLayouts := mmap(0, self.classCap * CG_CLASS_SZ, 3, 34, -1, 0);
    self.classCount  := 0;

    // BUG-08: Enum layout table for match tag analysis
    self.enumCap     := 16;
    self.enumLayouts := mmap(0, self.enumCap * 32, 3, 34, -1, 0);
    self.enumCount   := 0;

    // Local type tracking (parallel to locals)
    self.localTypes      := mmap(0, self.localCap * 16, 3, 34, -1, 0);
    self.localArraySize  := mmap(0, self.localCap * 8,  3, 34, -1, 0);

    // Method class context
    self.curClassName    := 0 as pchar;
    self.curClassNameLen := 0;

    // WP-13: Closure support - static link defaults (not in a nested function)
    self.staticLinkOffset := -1;
    self.outerFuncName    := 0 as pchar;
    self.outerFuncNameLen := 0;

    // Module-level constant table (use literal 24 for slot size, avoids bootstrap issue)
    self.conCap   := 256;
    self.conTable := mmap(0, self.conCap * 24, 3, 34, -1, 0);
    self.conCount := 0;

    // Break linked list: no pending breaks initially
    self.curBreakHead := -1;
    self.curContHead := -1;

    // VMT address patch table (WP-10a)
    self.vmtPatchCap   := 32;
    self.vmtPatches    := mmap(0, self.vmtPatchCap * 24, 3, 34, -1, 0);
    self.vmtPatchCount := 0;

    // WP-BC-19: VMT method patch table
    self.vmtMethodPatchCap   := 64;
    self.vmtMethodPatches    := mmap(0, self.vmtMethodPatchCap * CG_VMT_METH_PATCH_SZ, 3, 34, -1, 0);
    self.vmtMethodPatchCount := 0;

    // WP-BC-24: deferred monomorphization list
    self.monoCap   := 32;
    self.monoList  := mmap(0, self.monoCap * 32, 3, 34, -1, 0);
    self.monoCount := 0;

    // WP-BC-25: DWARF debug info (off by default)
    self.debugMode   := 0;
    self.srcFilePath := 0 as pchar;
    self.srcFileLen  := 0;

    // WP-BC-48: runtime checks (off by default)
    self.runtimeChecks := 0;

    // Per-local array flag (WP-10b)
    self.localIsArray := mmap(0, self.localCap, 3, 34, -1, 0);

    // BUG-02: Temporary buffer tracking (prevent mmap leaks)
    self.tempBufCap   := 64;
    self.tempBufs     := mmap(0, self.tempBufCap * 16, 3, 34, -1, 0);
    self.tempBufCount := 0;

    // WP-13: Captured variable table for nested functions
    self.capturedCap   := 64;
    self.capturedVars  := mmap(0, self.capturedCap * 40, 3, 34, -1, 0);
    self.capturedCount := 0;

    // Global variable table
    self.globalVarCap   := 64;
    self.globalVars     := mmap(0, self.globalVarCap * 24, 3, 34, -1, 0);
    self.globalIsPchar  := mmap(0, self.globalVarCap, 3, 34, -1, 0);
    self.globalVarCount := 0;

    // WP-BC-40: Profiling entry table (initially empty)
    self.profEntryCap   := 16;
    self.profEntries    := mmap(0, self.profEntryCap * 32, 3, 34, -1, 0);
    self.profEntryCount := 0;

    // Emit fixed helper stubs first
    self.cg_emitHelpers();
    // Pre-populate builtin constants (mmap flags, O_* modes, etc.)
    self.cg_addBuiltinCons();
  }

  fn Generate(head: int64) {
    self.cg_genFile(head);
    self.cg_patchAll();
    // BUG-02: Free all temporary mmap buffers after patching is complete
    self.cg_freeAllTempBufs();
  }

  fn WriteELF(path: pchar) {
    // FFI programs need a dynamically-linked ELF (PT_INTERP + .dynamic + GOT
    // relocations against the named shared libraries). Programs with no extern
    // imports keep the byte-identical static path below — preserving the
    // self-host singularity, since lyxc itself uses no FFI.
    if (self.externCount > 0) {
      self.cg_writeELFDynamic(path);
      return;
    }
    var totalCode: int64 := self.codeLen;
    var totalData: int64 := self.dataLen;
    var baseSize:  int64 := CG_CODE_OFF + totalCode + totalData;

    // WP-BC-25: allocate DwarfGen at function scope so it spans both debug blocks
    var dg: DwarfGen := new DwarfGen();
    dg.Init();

    var abbrevSize: int64 := 0;
    var infoSize:   int64 := 0;
    var lineSize:   int64 := 0;
    var strSize:    int64 := 0;
    if (self.debugMode != 0) {
      var li: int64 := 0;
      while (li < self.labelCount) {
        var lbase:    int64 := self.labels + li * CG_LABEL_SZ;
        var lname:    pchar := peek64(lbase) as pchar;
        var lnlen:    int64 := peek64(lbase + 8);
        var lstart:   int64 := peek64(lbase + 16);
        var llineNum: int64 := peek64(lbase + 24);
        var lend:     int64 := 0;
        if (li + 1 < self.labelCount) {
          lend := peek64(self.labels + (li + 1) * CG_LABEL_SZ + 16);
        } else {
          lend := totalCode;
        }
        dg.dw_addFunc(lname, lnlen, lstart, lend, llineNum);
        li := li + 1;
      }
      dg.dw_buildAbbrev();
      dg.dw_buildInfo(self.srcFilePath, self.srcFileLen, totalCode);
      dg.dw_buildLine(self.srcFilePath, self.srcFileLen);
      abbrevSize := dg.abbrevLen;
      infoSize   := dg.infoLen;
      lineSize   := dg.lineLen;
      strSize    := dg.strLen;
    }

    var shstrtabSize: int64 := 60;
    var fileSize: int64 := baseSize;
    if (self.debugMode != 0) {
      fileSize := baseSize + abbrevSize + infoSize + lineSize + strSize + shstrtabSize + 384;
    }

    // Allocate ELF buffer
    var buf: int64 := mmap(0, fileSize, 3, 34, -1, 0);

    // ELF header (64 bytes)
    poke8(buf, 0x7F);
    poke8(buf + 1,  69);   // 'E'
    poke8(buf + 2,  76);   // 'L'
    poke8(buf + 3,  70);   // 'F'
    poke8(buf + 4,  2);    // ELFCLASS64
    poke8(buf + 5,  1);    // ELFDATA2LSB
    poke8(buf + 6,  1);    // EV_CURRENT
    poke8(buf + 7,  0);    // ELFOSABI_NONE
    // bytes 8-15: padding (mmap zeroed)
    poke16(buf + 16, 2);    // e_type = ET_EXEC
    poke16(buf + 18, 62);   // e_machine = EM_X86_64 (0x3E)
    poke32(buf + 20, 1);    // e_version
    // e_entry = load vaddr + ELF/phdr headers + _start offset (0)
    poke64(buf + 24, CG_ELF_BASE + CG_CODE_OFF);
    poke64(buf + 32, CG_PHDR_OFF);  // e_phoff
    poke64(buf + 40, 0);             // e_shoff (no sections)
    poke32(buf + 48, 0);             // e_flags
    poke16(buf + 52, 64);   // e_ehsize
    poke16(buf + 54, 56);   // e_phentsize
    poke16(buf + 56, 1);    // e_phnum
    poke16(buf + 58, 64);   // e_shentsize
    poke16(buf + 60, 0);    // e_shnum
    poke16(buf + 62, 0);    // e_shstrndx
    if (self.debugMode != 0) {
      var shoff: int64 := baseSize + abbrevSize + infoSize + lineSize + strSize + shstrtabSize;
      poke64(buf + 40, shoff);  // e_shoff
      poke16(buf + 60, 6);      // e_shnum = 6
      poke16(buf + 62, 5);      // e_shstrndx = 5
    }

    // Program header (56 bytes at offset 64)
    var ph: int64 := buf + CG_PHDR_OFF;
    poke32(ph,      1);              // p_type = PT_LOAD
    poke32(ph + 4,  7);              // p_flags = PF_R|PF_W|PF_X
    poke64(ph + 8,  0);              // p_offset = 0 (map whole file)
    poke64(ph + 16, CG_ELF_BASE);   // p_vaddr
    poke64(ph + 24, CG_ELF_BASE);   // p_paddr
    if (self.debugMode != 0) {
      poke64(ph + 32, baseSize);     // p_filesz: load only code+data
      poke64(ph + 40, baseSize);     // p_memsz
    } else {
      poke64(ph + 32, fileSize);     // p_filesz
      poke64(ph + 40, fileSize);     // p_memsz
    }
    poke64(ph + 48, 2097152);        // p_align = 0x200000

    // Copy code
    var i: int64 := 0;
    while (i < totalCode) {
      poke8(buf + CG_CODE_OFF + i, peek8(self.code + i));
      i := i + 1;
    }

    // Copy string data
    i := 0;
    while (i < totalData) {
      poke8(buf + CG_CODE_OFF + totalCode + i, peek8(self.data + i));
      i := i + 1;
    }

    // WP-BC-25: emit DWARF debug sections and section header table
    if (self.debugMode != 0) {
      var abbrevOff:   int64 := baseSize;
      var infoOff:     int64 := abbrevOff + abbrevSize;
      var lineOff:     int64 := infoOff   + infoSize;
      var strOff:      int64 := lineOff   + lineSize;
      var shstrtabOff: int64 := strOff    + strSize;

      // Copy .debug_abbrev
      i := 0;
      while (i < abbrevSize) { poke8(buf+abbrevOff+i, peek8(dg.abbrevBuf+i)); i:=i+1; }
      // Copy .debug_info
      i := 0;
      while (i < infoSize)   { poke8(buf+infoOff+i,   peek8(dg.infoBuf+i));   i:=i+1; }
      // Copy .debug_line
      i := 0;
      while (i < lineSize)   { poke8(buf+lineOff+i,   peek8(dg.lineBuf+i));   i:=i+1; }
      // Copy .debug_str
      i := 0;
      while (i < strSize)    { poke8(buf+strOff+i,    peek8(dg.strBuf+i));    i:=i+1; }

      // Build .shstrtab (60 bytes)
      // "\0.debug_abbrev\0.debug_info\0.debug_line\0.debug_str\0.shstrtab\0"
      var ss: int64 := buf + shstrtabOff;
      poke8(ss,0);
      poke8(ss+1,46);poke8(ss+2,100);poke8(ss+3,101);poke8(ss+4,98);poke8(ss+5,117);
      poke8(ss+6,103);poke8(ss+7,95);poke8(ss+8,97);poke8(ss+9,98);poke8(ss+10,98);
      poke8(ss+11,114);poke8(ss+12,101);poke8(ss+13,118);poke8(ss+14,0);
      poke8(ss+15,46);poke8(ss+16,100);poke8(ss+17,101);poke8(ss+18,98);poke8(ss+19,117);
      poke8(ss+20,103);poke8(ss+21,95);poke8(ss+22,105);poke8(ss+23,110);poke8(ss+24,102);
      poke8(ss+25,111);poke8(ss+26,0);
      poke8(ss+27,46);poke8(ss+28,100);poke8(ss+29,101);poke8(ss+30,98);poke8(ss+31,117);
      poke8(ss+32,103);poke8(ss+33,95);poke8(ss+34,108);poke8(ss+35,105);poke8(ss+36,110);
      poke8(ss+37,101);poke8(ss+38,0);
      poke8(ss+39,46);poke8(ss+40,100);poke8(ss+41,101);poke8(ss+42,98);poke8(ss+43,117);
      poke8(ss+44,103);poke8(ss+45,95);poke8(ss+46,115);poke8(ss+47,116);poke8(ss+48,114);
      poke8(ss+49,0);
      poke8(ss+50,46);poke8(ss+51,115);poke8(ss+52,104);poke8(ss+53,115);poke8(ss+54,116);
      poke8(ss+55,114);poke8(ss+56,116);poke8(ss+57,97);poke8(ss+58,98);poke8(ss+59,0);

      // Section header table (6 × 64 bytes; [0]=NULL, already zero from mmap)
      var sh0: int64 := buf + shstrtabOff + shstrtabSize;
      var sh: int64 := 0;

      // [1] .debug_abbrev: sh_name=1, SHT_PROGBITS
      sh := sh0 + 64;
      poke32(sh,1);  poke32(sh+4,1);
      poke64(sh+24,abbrevOff); poke64(sh+32,abbrevSize); poke64(sh+48,1);

      // [2] .debug_info: sh_name=15, SHT_PROGBITS
      sh := sh0 + 128;
      poke32(sh,15); poke32(sh+4,1);
      poke64(sh+24,infoOff); poke64(sh+32,infoSize); poke64(sh+48,1);

      // [3] .debug_line: sh_name=27, SHT_PROGBITS
      sh := sh0 + 192;
      poke32(sh,27); poke32(sh+4,1);
      poke64(sh+24,lineOff); poke64(sh+32,lineSize); poke64(sh+48,1);

      // [4] .debug_str: sh_name=39, SHT_PROGBITS, SHF_MERGE|SHF_STRINGS=0x30, entsize=1
      sh := sh0 + 256;
      poke32(sh,39); poke32(sh+4,1);
      poke64(sh+8,48); poke64(sh+24,strOff); poke64(sh+32,strSize);
      poke64(sh+48,1); poke64(sh+56,1);

      // [5] .shstrtab: sh_name=50, SHT_STRTAB=3
      sh := sh0 + 320;
      poke32(sh,50); poke32(sh+4,3);
      poke64(sh+24,shstrtabOff); poke64(sh+32,shstrtabSize); poke64(sh+48,1);
    }

    // Write ELF binary to file (O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0755 = 493)
    var fd: int64 := open(path, 577, 493);
    if (fd >= 0) {
      write(fd, buf as pchar, fileSize);
      close(fd);
    } else {
      PrintStr("codegen: failed to open output file: ");
      PrintStr(path);
      PrintStr("\n");
    }
  }

  // ------------------------------------------------------------------
  // Dynamically-linked ET_EXEC writer (FFI / extern fn ... link "...")
  //
  // Layout — code and data keep their static file offsets/VAs so that every
  // absolute address baked in during codegen (VMT pointers, globals) stays
  // valid; we only relocate the program-header table to the end of the file
  // and append the dynamic-linking sections after .data:
  //
  //   [0,64)    ELF header (e_phoff -> phdrs at end, e_phnum = 3)
  //   [64,..)   .interp = "/lib64/ld-linux-x86-64.so.2"  (fits the 56B gap)
  //   [120,..)  code           (unchanged VA = base + 120)
  //   [..]      data           (unchanged)
  //   [..]      .dynstr .dynsym .hash .rela.dyn .got .dynamic
  //   [..]      program headers: PT_LOAD, PT_INTERP, PT_DYNAMIC
  //
  // Each imported symbol gets a GOT slot resolved eagerly by ld.so via an
  // R_X86_64_GLOB_DAT relocation (DT_FLAGS = DF_BIND_NOW), so no PLT/lazy
  // resolver is needed: call sites are `call *slot(%rip)` (FF 15).
  // ------------------------------------------------------------------
  fn cg_writeELFDynamic(path: pchar) {
    var totalCode: int64 := self.codeLen;
    var totalData: int64 := self.dataLen;
    var nExt: int64 := self.externCount;

    var interpStr: pchar := "/lib64/ld-linux-x86-64.so.2";
    var interpOff: int64 := 64;
    var interpLen: int64 := StrLen(interpStr) + 1;   // include NUL terminator

    var codeOff: int64 := CG_CODE_OFF;               // 120 — unchanged
    var dataOff: int64 := codeOff + totalCode;

    // --- build .dynstr (\0, then distinct lib names, then symbol names) ---
    var dynstr: int64 := mmap(0, 65536, 3, 34, -1, 0);
    var dsLen:  int64 := 0;
    poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;    // index 0 = ""

    var uniqPtr:    int64 := mmap(0, (nExt + 1) * 8, 3, 34, -1, 0);
    var uniqLen:    int64 := mmap(0, (nExt + 1) * 8, 3, 34, -1, 0);
    var uniqStrOff: int64 := mmap(0, (nExt + 1) * 8, 3, 34, -1, 0);
    var uniqCount:  int64 := 0;
    var symStrOff:  int64 := mmap(0, (nExt + 1) * 8, 3, 34, -1, 0);

    var ei: int64 := 0;
    while (ei < nExt) {
      var eb: int64 := self.externSyms + ei * CG_EXTERN_SZ;
      var lp: int64 := peek64(eb + 16);
      var ll: int64 := peek64(eb + 24);
      var u: int64 := 0;
      var found: int64 := -1;
      while (u < uniqCount) {
        if (peek64(uniqLen + u * 8) == ll &&
            self.cg_seq(peek64(uniqPtr + u * 8) as pchar, ll, lp as pchar, ll)) {
          found := u; u := uniqCount;
        } else {
          u := u + 1;
        }
      }
      if (found < 0) {
        var off: int64 := dsLen;
        var j: int64 := 0;
        while (j < ll) { poke8(dynstr + dsLen, peek8(lp + j)); dsLen := dsLen + 1; j := j + 1; }
        poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
        poke64(uniqPtr + uniqCount * 8, lp);
        poke64(uniqLen + uniqCount * 8, ll);
        poke64(uniqStrOff + uniqCount * 8, off);
        uniqCount := uniqCount + 1;
      }
      ei := ei + 1;
    }
    ei := 0;
    while (ei < nExt) {
      var eb2: int64 := self.externSyms + ei * CG_EXTERN_SZ;
      var np: int64 := peek64(eb2);
      var nl: int64 := peek64(eb2 + 8);
      var off2: int64 := dsLen;
      var j2: int64 := 0;
      while (j2 < nl) { poke8(dynstr + dsLen, peek8(np + j2)); dsLen := dsLen + 1; j2 := j2 + 1; }
      poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
      poke64(symStrOff + ei * 8, off2);
      ei := ei + 1;
    }
    var dynstrSize: int64 := dsLen;

    // --- section offsets (8-byte aligned via ((x+7)>>3)<<3) ---
    var dynstrOff: int64 := ((dataOff + totalData + 7) >> 3) << 3;
    var dynsymOff: int64 := ((dynstrOff + dynstrSize + 7) >> 3) << 3;
    var dynsymSize: int64 := (nExt + 1) * 24;
    var hashOff: int64 := dynsymOff + dynsymSize;            // 24*k is 8-aligned
    var nchain: int64 := nExt + 1;
    var hashSize: int64 := (3 + nchain) * 4;                  // nbucket,nchain,bucket[1],chain[]
    var relaOff: int64 := ((hashOff + hashSize + 7) >> 3) << 3;
    var relaSize: int64 := nExt * 24;
    var gotOff: int64 := relaOff + relaSize;                  // 8-aligned
    var gotSize: int64 := nExt * 8;
    var dynOff: int64 := gotOff + gotSize;                    // 8-aligned
    var dynCount: int64 := uniqCount + 11;                    // NEEDED*u + 11 fixed tags
    var dynSize: int64 := dynCount * 16;
    var phdrOff: int64 := ((dynOff + dynSize + 7) >> 3) << 3;
    var phnum: int64 := 3;
    var fileSize: int64 := phdrOff + phnum * 56;

    // --- patch extern call sites: disp32 = gotSlotVA - ripVA ---
    var pi: int64 := 0;
    while (pi < self.patchCount) {
      var pb: int64 := self.patches + pi * CG_PATCH_SZ;
      if (peek64(pb + 24) == CG_PATCH_EXTERN) {
        var cOff:   int64 := peek64(pb);
        var exIdx:  int64 := peek64(pb + 8);
        var gotVA:  int64 := CG_ELF_BASE + gotOff + exIdx * 8;
        var ripVA:  int64 := CG_ELF_BASE + codeOff + cOff + 4;
        poke32(self.code + cOff, gotVA - ripVA);
      }
      pi := pi + 1;
    }

    // --- assemble the file image ---
    var buf: int64 := mmap(0, fileSize, 3, 34, -1, 0);

    // ELF header
    poke8(buf, 0x7F); poke8(buf + 1, 69); poke8(buf + 2, 76); poke8(buf + 3, 70);
    poke8(buf + 4, 2); poke8(buf + 5, 1); poke8(buf + 6, 1); poke8(buf + 7, 0);
    poke16(buf + 16, 2);              // e_type = ET_EXEC
    poke16(buf + 18, 62);             // e_machine = EM_X86_64
    poke32(buf + 20, 1);              // e_version
    poke64(buf + 24, CG_ELF_BASE + codeOff);  // e_entry
    poke64(buf + 32, phdrOff);        // e_phoff -> phdrs at end of file
    poke64(buf + 40, 0);              // e_shoff
    poke32(buf + 48, 0);              // e_flags
    poke16(buf + 52, 64);             // e_ehsize
    poke16(buf + 54, 56);             // e_phentsize
    poke16(buf + 56, phnum);          // e_phnum
    poke16(buf + 58, 64);             // e_shentsize
    poke16(buf + 60, 0);              // e_shnum
    poke16(buf + 62, 0);              // e_shstrndx

    // .interp (in the 56-byte gap between phdr-area and code)
    var ii: int64 := 0;
    while (ii < interpLen) { poke8(buf + interpOff + ii, peek8((interpStr as int64) + ii)); ii := ii + 1; }

    // code (extern disps now patched)
    var ci: int64 := 0;
    while (ci < totalCode) { poke8(buf + codeOff + ci, peek8(self.code + ci)); ci := ci + 1; }
    // data
    var di: int64 := 0;
    while (di < totalData) { poke8(buf + dataOff + di, peek8(self.data + di)); di := di + 1; }

    // .dynstr
    var si: int64 := 0;
    while (si < dynstrSize) { poke8(buf + dynstrOff + si, peek8(dynstr + si)); si := si + 1; }

    // .dynsym — [0] = null symbol (zeroed); [i+1] = UNDEF GLOBAL FUNC import
    ei := 0;
    while (ei < nExt) {
      var sy: int64 := buf + dynsymOff + (ei + 1) * 24;
      poke32(sy, peek64(symStrOff + ei * 8));  // st_name
      poke8(sy + 4, 0x12);                      // st_info = STB_GLOBAL|STT_FUNC
      poke8(sy + 5, 0);                          // st_other
      poke16(sy + 6, 0);                         // st_shndx = SHN_UNDEF
      ei := ei + 1;
    }

    // .hash — minimal SysV: nbucket=1, nchain, empty bucket/chains
    poke32(buf + hashOff, 1);          // nbucket
    poke32(buf + hashOff + 4, nchain); // nchain (must equal dynsym count)

    // .rela.dyn — one R_X86_64_GLOB_DAT per import into its GOT slot
    ei := 0;
    while (ei < nExt) {
      var ra: int64 := buf + relaOff + ei * 24;
      poke64(ra, CG_ELF_BASE + gotOff + ei * 8);          // r_offset = GOT slot VA
      poke64(ra + 8, ((ei + 1) << 32) | 6);               // r_info = (sym<<32)|R_X86_64_GLOB_DAT
      poke64(ra + 16, 0);                                  // r_addend
      ei := ei + 1;
    }

    // .got — zero slots (filled by ld.so); already zeroed by mmap

    // .dynamic
    var dp: int64 := buf + dynOff;
    var u2: int64 := 0;
    while (u2 < uniqCount) {
      poke64(dp, 1); poke64(dp + 8, peek64(uniqStrOff + u2 * 8)); dp := dp + 16;  // DT_NEEDED
      u2 := u2 + 1;
    }
    poke64(dp, 4);  poke64(dp + 8, CG_ELF_BASE + hashOff);   dp := dp + 16;  // DT_HASH
    poke64(dp, 5);  poke64(dp + 8, CG_ELF_BASE + dynstrOff); dp := dp + 16;  // DT_STRTAB
    poke64(dp, 6);  poke64(dp + 8, CG_ELF_BASE + dynsymOff); dp := dp + 16;  // DT_SYMTAB
    poke64(dp, 10); poke64(dp + 8, dynstrSize);              dp := dp + 16;  // DT_STRSZ
    poke64(dp, 11); poke64(dp + 8, 24);                      dp := dp + 16;  // DT_SYMENT
    poke64(dp, 7);  poke64(dp + 8, CG_ELF_BASE + relaOff);   dp := dp + 16;  // DT_RELA
    poke64(dp, 8);  poke64(dp + 8, relaSize);                dp := dp + 16;  // DT_RELASZ
    poke64(dp, 9);  poke64(dp + 8, 24);                      dp := dp + 16;  // DT_RELAENT
    poke64(dp, 30); poke64(dp + 8, 8);                       dp := dp + 16;  // DT_FLAGS = DF_BIND_NOW
    poke64(dp, 0);  poke64(dp + 8, 0);                       dp := dp + 16;  // DT_NULL

    // program headers at end of file
    var ph: int64 := buf + phdrOff;
    // PT_LOAD — whole file at base, RWX
    poke32(ph, 1); poke32(ph + 4, 7);
    poke64(ph + 8, 0); poke64(ph + 16, CG_ELF_BASE); poke64(ph + 24, CG_ELF_BASE);
    poke64(ph + 32, fileSize); poke64(ph + 40, fileSize); poke64(ph + 48, 4096);
    // PT_INTERP
    var ph2: int64 := ph + 56;
    poke32(ph2, 3); poke32(ph2 + 4, 4);
    poke64(ph2 + 8, interpOff); poke64(ph2 + 16, CG_ELF_BASE + interpOff); poke64(ph2 + 24, CG_ELF_BASE + interpOff);
    poke64(ph2 + 32, interpLen); poke64(ph2 + 40, interpLen); poke64(ph2 + 48, 1);
    // PT_DYNAMIC
    var ph3: int64 := ph + 112;
    poke32(ph3, 2); poke32(ph3 + 4, 6);
    poke64(ph3 + 8, dynOff); poke64(ph3 + 16, CG_ELF_BASE + dynOff); poke64(ph3 + 24, CG_ELF_BASE + dynOff);
    poke64(ph3 + 32, dynSize); poke64(ph3 + 40, dynSize); poke64(ph3 + 48, 8);

    var fd: int64 := open(path, 577, 493);
    if (fd >= 0) {
      write(fd, buf as pchar, fileSize);
      close(fd);
    } else {
      PrintStr("codegen: failed to open output file: ");
      PrintStr(path);
      PrintStr("\n");
    }
  }

};

// ============================================================================
// Public helper: emit count of nodes in a singly-linked list (via NNext)
// (Mirrors ParserListLen from parser.lyx for convenience)
// ============================================================================

pub fn CodegenListLen(head: int64, nodes: int64): int64 {
  var n: int64 := 0;
  var cur: int64 := head;
  while (cur != -1) {
    n := n + 1;
    cur := peek64(nodes + cur * CG_NODE_SIZE + 40);
  }
  return n;
}
