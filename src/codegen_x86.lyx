      self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);  // mov r10, rax
      self.cg_movRaxImm(-1);
      self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0);  // xor r8, r8
      self.cg_e8(0x49); self.cg_e8(0xFF); self.cg_e8(0xC8);  // dec r8 → r8=-1
      self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9, r9
      self.cg_movRaxImm(9);
      self.cg_e8(0x0F); self.cg_e8(0x05);
      // WP-10d: check if type is a struct (vmtDataOff == -1) → skip VMT setup
      var tname: pchar := self.cg_nsval(ni);
      var tlen:  int64 := self.cg_nslen(ni);
      var ciNew: int64 := self.cg_findClass(tname, tlen);
      var isStructNew: int64 := 0;
      if (ciNew >= 0) {
        var vmtChk: int64 := peek64(self.classLayouts + ciNew * CG_CLASS_SZ + CG_CLASS_OFF_VMTOFF);
        if (vmtChk == -1) { isStructNew := 1; }
      }
      if (isStructNew == 0) {
        // WP-10a: rax = object ptr; write VMT pointer at [rax+0]
        // mov rcx, imm64 (placeholder = 0, patched later with VMT vaddr)
        self.cg_e8(0x48); self.cg_e8(0xB9);
        var vmtPatchPos: int64 := self.codeLen;
        self.cg_e64(0);                                         // 8-byte placeholder
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x08); // mov [rax], rcx
        // Record patch: fill in VMT address for this class at vmtPatchPos
        self.cg_addVmtPatch(vmtPatchPos, tname, tlen);
      }
      // #683: Call ClassName_Create(self, args...) if defined
      var ctorCreate: pchar := "Create";
      var ctorCreateLen: int64 := 6;
      var ctorMangLen: int64 := tlen + 1 + ctorCreateLen;
      var ctorMangBuf: int64 := alloc(ctorMangLen + 1);
      var ctorCI: int64 := 0;
      while (ctorCI < tlen) { poke8(ctorMangBuf + ctorCI, StrCharAt(tname, ctorCI)); ctorCI := ctorCI + 1; }
      StrSetChar(ctorMangBuf as pchar, tlen, 95);
      var ctorCJ: int64 := 0;
      while (ctorCJ < ctorCreateLen) { poke8(ctorMangBuf + tlen + 1 + ctorCJ, StrCharAt(ctorCreate, ctorCJ)); ctorCJ := ctorCJ + 1; }
      poke8(ctorMangBuf + ctorMangLen, 0);
      if (self.cg_findLabel(ctorMangBuf as pchar, ctorMangLen) >= 0) {
        self.cg_pushRax();                 // save obj ptr
        self.cg_pushRax();                 // push self (first arg)
        var ctorArg: int64 := self.cg_nc0(ni);
        var ctorArgc: int64 := 1;
        while (ctorArg != -1) {
          self.cg_genExpr(ctorArg);
          self.cg_pushRax();
          ctorArgc += 1;
          ctorArg := self.cg_nnext(ctorArg);
        }
        if (ctorArgc >= 6) { self.cg_e8(0x41); self.cg_e8(0x59); }  // pop r9
        if (ctorArgc >= 5) { self.cg_e8(0x41); self.cg_e8(0x58); }  // pop r8
        if (ctorArgc >= 4) { self.cg_popRcx(); }
        if (ctorArgc >= 3) { self.cg_popRdx(); }
        if (ctorArgc >= 2) { self.cg_popRsi(); }
        if (ctorArgc >= 1) { self.cg_popRdi(); }
        var ctorPP: int64 := self.cg_emitCall();
        self.cg_addPatch(ctorPP, ctorMangBuf, ctorMangLen, CG_PATCH_CALL);
        self.cg_trackTempBuf(ctorMangBuf, ctorMangLen + 1);
        self.cg_popRax();                  // restore obj ptr
      } else {
        free(ctorMangBuf, ctorMangLen + 1);
      }

    } else if (k == CGN_FIELD) {
      self.cg_genFieldLoad(ni);

    } else if (k == CGN_INDEX && self.cg_tryClassIndex(ni) != 0) {
      // operator overloading: base[idx] → base.Get(idx) for a class-typed base
      // (emitted by cg_tryClassIndex; result in rax).
    } else if (k == CGN_INDEX) {
      // arr[i]: nc0=arr, nc1=index
      // Eval index first, push; then eval arr; pop index into rbx
      self.cg_genExpr(self.cg_nc1(ni));   // rax = index
      self.cg_pushRax();
      // #1052: inline `[N]T`-Feld — Adresse statt Inhalt laden.
      var rdInlW: int64 := self.cg_emitInlineArrayAddr(self.cg_nc0(ni));
      if (rdInlW == 0) { self.cg_genExpr(self.cg_nc0(ni)); }   // rax = array ptr
      self.cg_popRbx();                    // rbx = index
      if (rdInlW > 0) {
        self.cg_emitScaledLoadRax(rdInlW);
        return;
      }
      var baseNode: int64 := self.cg_nc0(ni);
      var isPchar:  int64 := 0;
      var isArray:  int64 := 0;
      var isSimd:   int64 := 0;
      var arrElemClassIdx: int64 := -1;
      var arrElemSize: int64 := 8;
      if (self.cg_nkind(baseNode) == CGN_IDENT) {
        var bname: pchar := self.cg_nsval(baseNode);
        var blen:  int64 := self.cg_nslen(baseNode);
        var lidx: int64 := self.cg_findLocalIdx(bname, blen);
        if (lidx >= 0) {
          // WP-GPU-01: check SIMD flag first
          if (peek8(self.localIsSimd + lidx) != 0) { isSimd := 1; }
          var tb: int64 := self.localTypes + lidx * CG_LOCTYPE_SZ;
          var tp: pchar := peek64(tb) as pchar;
          var tn: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
          if (tn == 5 && self.cg_seq(tp, tn, "pchar", 5)) { isPchar := 1; }
          if (peek8(self.localIsArray + lidx) != 0) {
            isArray := 1;
            // Check for struct element type in localTypes (stored for Array<T> locals)
            if (tp != 0 as pchar && tn > 0) {
              var eClassIdx: int64 := self.cg_findClass(tp, tn);
              if (eClassIdx >= 0) {
                arrElemClassIdx := eClassIdx;
                arrElemSize := self.cg_classStructSize(eClassIdx);
              }
            }
          }
        } else {
          var gidx: int64 := self.cg_findGlobalIdx(bname, blen);
          if (gidx >= 0 && peek8(self.globalIsPchar + gidx) != 0) { isPchar := 1; }
        }
      } else if (self.cg_nkind(baseNode) == CGN_FIELD) {
        // Class field: check if it's Array<StructType>
        var innerObj: int64 := self.cg_nc0(baseNode);
        var fldNm: pchar := self.cg_nsval(baseNode);
        var fldNl: int64 := self.cg_nslen(baseNode);
        var parentCi: int64 := self.cg_objClassIdx(innerObj);
        var eClassIdx: int64 := self.cg_getFieldElemClassIdx(parentCi, fldNm, fldNl);
        if (eClassIdx >= 0) {
          isArray := 1;
          arrElemClassIdx := eClassIdx;
          arrElemSize := self.cg_classStructSize(eClassIdx);
        } else if (self.cg_isFieldArray(parentCi, fldNm, fldNl) != 0) {
          isArray := 1;
          // arrElemSize bleibt 8 (scalar Array<int64> etc.)
        }
      }
      if (isSimd == 1) {
        // WP-GPU-01: parallel Array<f32>[i] — 4-byte stride, no header, SSE2 movss
        // rax=base ptr, rbx=index
        // movss xmm0, [rax+rbx*4]  (F3 0F 10 04 98)
        self.cg_e8(0xF3); self.cg_e8(0x0F); self.cg_e8(0x10); self.cg_e8(0x04); self.cg_e8(0x98);
        // movd rax, xmm0  (66 0F 7E C0) — return f32 bits as int32 in rax
        self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC0);
      } else if (isPchar == 1) {
        // movzx rax, byte [rax+rbx]
        self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0x04); self.cg_e8(0x18);
      } else if (isArray == 1 && arrElemSize > 8) {
        // Struct array: return element ADDRESS (not value)
        // lea rcx, [rax+16]  (skip {cap,len} header)
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x48); self.cg_e8(0x10);
        // imul rbx, rbx, arrElemSize  (index * element size)
        if (arrElemSize <= 127) {
          self.cg_e8(0x48); self.cg_e8(0x6B); self.cg_e8(0xDB); self.cg_e8(arrElemSize);
        } else {
          self.cg_e8(0x48); self.cg_e8(0x69); self.cg_e8(0xDB); self.cg_e32(arrElemSize);
        }
        // lea rax, [rcx+rbx]  (element address)
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x04); self.cg_e8(0x19);
      } else if (isArray == 1) {
        // Scalar array<T>: skip 16-byte {cap,len} header, then 8-byte stride
        // lea rcx, [rax+16]
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x48); self.cg_e8(0x10);
        // mov rax, [rcx+rbx*8]
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0xD9);
      } else {
        // plain int64 pointer: direct 8-byte stride, no header
        // Guard null: test rax,rax; jnz .ok; xor rax,rax; jmp .done; .ok: mov rax,[rax+rbx*8]; .done:
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x75); self.cg_e8(7);                        // jnz +7 (to ok)
        self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);  // xor rax, rax
        self.cg_e8(0xEB); self.cg_e8(4);                        // jmp +4 (to done)
        // ok: mov rax, [rax+rbx*8]
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0xD8);
        // done:
      }

    } else if (k == CGN_LIT_FLOAT) {
      // WP-11: float literal — parse IEEE 754 bits and load as immediate
      var floatBits: int64 := self.cg_parseFloat(self.pSrc, self.cg_nsoff(ni), self.cg_nslen(ni));
      self.cg_movRaxImm(floatBits);

    } else if (k == CGN_CAST) {
      // WP-11: x as Type — evaluate source, then apply integer truncation/extension
      self.cg_genExpr(self.cg_nc0(ni));
      var typeNode: int64 := self.cg_nc1(ni);
      if (typeNode >= 0) {
        var tname: pchar := self.cg_nsval(typeNode);
        var tlen: int64 := self.cg_nslen(typeNode);
        if (self.cg_seq(tname, tlen, "i8", 2)) {
          // movsx rax, al  — sign-extend byte to qword
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBE); self.cg_e8(0xC0);
        } else if (self.cg_seq(tname, tlen, "u8", 2) ||
                   self.cg_seq(tname, tlen, "uint8", 5)) {
          // movzx rax, al  — zero-extend byte to qword  (#1010: uint8 = u8)
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
        } else if (self.cg_seq(tname, tlen, "i16", 3)) {
          // movsx rax, ax  — sign-extend word to qword
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBF); self.cg_e8(0xC0);
        } else if (self.cg_seq(tname, tlen, "u16", 3) ||
                   self.cg_seq(tname, tlen, "uint16", 6)) {
          // movzx rax, ax  — zero-extend word to qword  (#1010: uint16 = u16)
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB7); self.cg_e8(0xC0);
        } else if (self.cg_seq(tname, tlen, "i32", 3)) {
          // movsxd rax, eax  — sign-extend dword to qword
          self.cg_e8(0x48); self.cg_e8(0x63); self.cg_e8(0xC0);
        } else if (self.cg_seq(tname, tlen, "u32", 3) ||
                   self.cg_seq(tname, tlen, "uint32", 6)) {
          // mov eax, eax  — zero-extends to rax automatically on x86-64
          self.cg_e8(0x89); self.cg_e8(0xC0);
        }
        // f64: convert int64 bits in rax to IEEE 754 double via cvtsi2sd
        if (self.cg_seq(tname, tlen, "f64", 3)) {
          // cvtsi2sd xmm0, rax  (F2 48 0F 2A C0)
          self.cg_e8(0xF2); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x2A); self.cg_e8(0xC0);
          // movq rax, xmm0      (66 48 0F 7E C0)
          self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC0);
        }
        // R5: f64 → int64: cvttsd2si (truncate-towards-zero)
        if (self.cg_seq(tname, tlen, "int64", 5) || self.cg_seq(tname, tlen, "i64", 3)) {
          if (self.cg_isF64Expr(self.cg_nc0(ni)) != 0) {
            // movq xmm0, rax      (66 48 0F 6E C0)
            self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x6E); self.cg_e8(0xC0);
            // cvttsd2si rax, xmm0 (F2 48 0F 2C C0)
            self.cg_e8(0xF2); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x2C); self.cg_e8(0xC0);
          }
        }
        // i64, u64, pchar, bool, char, f32: no-op (already 64-bit in rax)
      }

    } else if (k == CGN_IS_EXPR) {
      // #1094: `x is T`.
      //
      // Der Operator hatte drei Wege, und alle drei endeten bei `false`: die
      // erwartete VMT-Adresse wurde aus der eigenen Codeposition gerechnet
      // statt aus der Patch-Tabelle und traf nie zu; jeder Nicht-Klassentyp
      // fiel auf cg_zeroRax; ein frei erfundener Typname ebenso. Ein Typtest,
      // der konstant `false` liefert, nimmt den Zweig nie und weist auf
      // nichts hin — der stille Default in Reinform.
      //
      // Jetzt: bei einer Klasse mit VMT eine echte Laufzeitpruefung, sonst die
      // statisch feststehende Antwort, und wo weder das eine noch das andere
      // entscheidbar ist, eine Meldung.
      var typeNode: int64 := self.cg_nc1(ni);
      if (typeNode < 0) {
        EPrintStrLn("error: `is` ohne Typ"c);
        exit(1);
      }
      var tname: pchar := self.cg_nsval(typeNode);
      var tlen:  int64 := self.cg_nslen(typeNode);
      var classIdx: int64 := self.cg_findClass(tname, tlen);
      var tBuiltin: int64 := self.cg_builtinTypeId(tname, tlen);
      if (classIdx < 0 && tBuiltin == 0) {
        EPrintStr("error: unbekannter Typ in `is`-Ausdruck: '"c);
        sys_write(2, tname, tlen);
        EPrintStr("'\n"c);
        EPrintStrLn("  `is` prueft gegen einen Klassen-, Struktur- oder eingebauten Typ."c);
        exit(1);
      }
      // Statischer Typ des Empfaengers. Er entscheidet, ob ueberhaupt zur
      // Laufzeit geprueft werden darf: nur eine Klasse mit VMT traegt an
      // [obj+0] den Typzeiger.
      var srcName: pchar := self.cg_staticTypeName(self.cg_nc0(ni));
      var srcLen:  int64 := self.stnLen;
      if (srcName == 0 as pchar) {
        EPrintStrLn("error: statischer Typ des Ausdrucks vor `is` ist nicht bestimmbar"c);
        EPrintStrLn("  Der Ausdruck zuerst einer Variablen mit deklariertem Typ zuweisen."c);
        exit(1);
      }
      var srcIdx: int64 := self.cg_findClass(srcName, srcLen);
      // Ein Typname, den weder die Klassentabelle noch die Liste der
      // eingebauten Typen kennt (Alias, Generik, importierter Typ), macht die
      // Antwort unentscheidbar. Sie hier auf `false` zu setzen waere derselbe
      // stille Default noch einmal.
      if (srcIdx < 0 && self.cg_builtinTypeId(srcName, srcLen) == 0) {
        EPrintStr("error: `is` kann den Typ '"c);
        sys_write(2, srcName, srcLen);
        EPrintStr("' nicht pruefen\n"c);
        EPrintStrLn("  Geprueft werden Klassen (zur Laufzeit) und eingebaute Typen (statisch)."c);
        exit(1);
      }

      if (self.cg_classHasVmt(classIdx) != 0 && self.cg_classHasVmt(srcIdx) != 0) {
        // Laufzeitpruefung. Getroffen wird die Zielklasse SAMT ihrer
        // Nachfahren — sonst waere `b is A` bei `B extends A` falsch, und
        // genau dafuer gibt es den Operator.
        self.cg_genExpr(self.cg_nc0(ni));
        self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0);   // xor r8, r8
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
        self.cg_e8(0x0F); self.cg_e8(0x84);                     // jz .done  (null ist nie ein T)
        var doneJ: int64 := self.codeLen;
        self.cg_e32(0);
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x08);   // mov rcx, [rax]
        var ci: int64 := 0;
        while (ci < self.classCount) {
          if (self.cg_classHasVmt(ci) != 0 && self.cg_isDescendantClass(ci, classIdx) != 0) {
            var cb: int64 := self.classLayouts + ci * CG_CLASS_SZ;
            var cnp: pchar := peek64(cb) as pchar;
            var cnl: int64 := peek64(cb + CG_PATCH_OFF_NAMEPTR);
            self.cg_e8(0x48); self.cg_e8(0xBA);                 // mov rdx, imm64
            var vp: int64 := self.codeLen;
            self.cg_e64(0);
            self.cg_addVmtPatch(vp, cnp, cnl);
            self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xD1); // cmp rcx, rdx
            self.cg_e8(0x75); self.cg_e8(0x07);                   // jne +7
            self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC0); // mov r8, 1
            self.cg_e32(1);
          }
          ci += 1;
        }
        poke32(self.code + doneJ, self.codeLen - doneJ - 4);
        self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0xC0);   // mov rax, r8
      } else {
        // Kein polymorpher Fall: die Antwort steht zur Uebersetzungszeit fest.
        // Der Empfaenger wird trotzdem ausgewertet — er kann Seiteneffekte
        // haben, und `f() is A` darf f nicht verschlucken.
        self.cg_genExpr(self.cg_nc0(ni));
        var res: int64 := 0;
        if (classIdx >= 0) {
          // Klassen OHNE Methode bekommen struct-Layout und damit keine VMT
          // (cg_buildStructLayout) — es gibt zur Laufzeit nichts zu lesen.
          // Die Antwort ist dann der statisch bekannte Vererbungsweg, und
          // `null` bleibt trotzdem kein T.
          if (srcIdx >= 0 && self.cg_isDescendantClass(srcIdx, classIdx) != 0) { res := 1; }
          if (res != 0) {
            self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
            self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC0);   // setne al
            self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);   // movzx rax, al
          } else {
            self.cg_movRaxImm(0);
          }
        } else {
          var sBuiltin: int64 := self.cg_builtinTypeId(srcName, srcLen);
          if (sBuiltin != 0 && sBuiltin == tBuiltin) { res := 1; }
          self.cg_movRaxImm(res);
        }
      }

    } else if (k == CGN_CLOSURE) {
      // WP-02: anonymous closure: fn(params): rettype { body }
      // c0=params, c1=rettype, c2=body
      // Emits inner function inline (with jmp-around), then builds heap {fnPtr,envPtr}.
      var closureParams: int64 := self.cg_nc0(ni);
      var closureBody:   int64 := self.cg_nc2(ni);

      // 1. Scan for captured vars (uses outer locals, so do before resetting localBase)
      self.cg_scanClosureCaptures(closureBody, closureParams);
      var numCap: int64 := self.closureCapturedCount;

      // 2. Generate unique label for inner function
      var anonIdx: int64 := self.anonFnCounter;
      self.anonFnCounter += 1;
      var anonLabel: pchar := self.cg_buildAnonName(anonIdx);
      var anonLabelLen: int64 := StrLen(anonLabel);

      // 3. Emit jmp rel32 over inner function
      self.cg_e8(0xE9);
      var jmpOverPatch: int64 := self.codeLen;
      self.cg_e32(0);

      // 4. Register label at inner function start, emit prologue
      self.cg_addLabel(anonLabel, anonLabelLen, 0);

      // 5. Save outer function state
      var savedLocalCount: int64 := self.localCount;
      var savedFrameSize:  int64 := self.frameSize;
      var savedLocalBase:  int64 := self.localBase;
      var savedEnvOff:     int64 := self.closureEnvPtrOff;
      var savedStaticLink: int64 := self.staticLinkOffset;
      var savedCapCount:   int64 := self.closureCapturedCount;

      // 6. Reset for inner function (locals start after outer)
      self.localBase  := savedLocalCount;
      self.frameSize  := 0;
      self.staticLinkOffset := -1;  // inner fn has no static link (uses env ptr instead)

      // 7. Emit prologue
      var innerProloguePatch: int64 := self.cg_emitPrologueNested();

      // 8. Spill env ptr (rdi = hidden first arg)
      var envPtrOff: int64 := self.cg_addLocal("__env_ptr__", 11);
      self.closureEnvPtrOff := envPtrOff;
      self.cg_spillRdi(envPtrOff);

      // 9. Spill explicit params (rsi=arg0, rdx=arg1, ...)
      var cparam: int64 := closureParams;
      var cparamIdx: int64 := 0;
      while (cparam >= 0 && cparamIdx < 5) {
        var pname2: pchar := self.cg_nsval(cparam);
        var pnlen2: int64 := self.cg_nslen(cparam);
        var cpoff: int64 := self.cg_addLocal(pname2, pnlen2);
        if (cparamIdx == 0) { self.cg_spillRsi(cpoff); }
        else if (cparamIdx == 1) { self.cg_spillRdx(cpoff); }
        else if (cparamIdx == 2) { self.cg_spillRcx(cpoff); }
        else if (cparamIdx == 3) { self.cg_spillR8(cpoff); }
        else if (cparamIdx == 4) { self.cg_spillR9(cpoff); }
        cparamIdx += 1;
        cparam := self.cg_nnext(cparam);
      }

      // 10. Generate inner function body
      self.cg_genBlock(closureBody);
      self.cg_zeroRax();
      self.cg_emitEpilogue();

      // 11. Patch inner function frame size (align to 16)
      var ifs: int64 := self.frameSize + 15;
      var iAligned: int64 := ifs - (ifs & 15);
      if (iAligned == 0) { iAligned := 16; }
      poke32(self.code + innerProloguePatch, iAligned);

      // 12. Patch jmp-over to here
      poke32(self.code + jmpOverPatch, self.codeLen - jmpOverPatch - 4);

      // 13. Restore outer state
      self.localBase         := savedLocalBase;
      self.localCount        := savedLocalCount;
      self.frameSize         := savedFrameSize;
      self.closureEnvPtrOff  := savedEnvOff;
      self.staticLinkOffset  := savedStaticLink;
      self.closureCapturedCount := savedCapCount;

      // 14. Heap-allocate env (numCap * 8 bytes) via mmap
      if (numCap > 0) {
        self.cg_e8(0x31); self.cg_e8(0xFF);  // xor edi, edi (addr=0)
        self.cg_e8(0xBE); self.cg_e32(numCap * 8);  // mov esi, numCap*8
        self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov edx,3
        self.cg_e8(0x41); self.cg_e8(0xBA); self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov r10d,34
        self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);  // mov r8d,-1
        self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9d,r9d
        self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov eax,9
        self.cg_e8(0x0F); self.cg_e8(0x05);  // syscall → rax = env ptr

        // Save env ptr on stack temporarily
        self.cg_pushRax();  // [rsp] = env ptr

        // Copy each captured var from outer stack into env buffer
        var ci: int64 := 0;
        while (ci < numCap) {
          var outerOff2: int64 := peek64(self.closureCapturedOutBuf + ci * 8);
          self.cg_loadRax(outerOff2);    // rax = captured var value
          // mov rbx, [rsp]  (env ptr)
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x1C); self.cg_e8(0x24);
          // mov [rbx + ci*8], rax
          var eOff2: int64 := ci * 8;
          if (eOff2 == 0) {
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x03);
          } else if (eOff2 < 128) {
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x43); self.cg_e8(eOff2);
          } else {
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x83); self.cg_e32(eOff2);
          }
          ci += 1;
        }
      }

      // 15. Heap-allocate closure struct (16 bytes) via mmap
      self.cg_e8(0x31); self.cg_e8(0xFF);  // xor edi, edi
      self.cg_e8(0xBE); self.cg_e8(0x10); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov esi, 16
      self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov edx,3
      self.cg_e8(0x41); self.cg_e8(0xBA); self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov r10d,34
      self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);  // mov r8d,-1
      self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9d,r9d
      self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov eax,9
      self.cg_e8(0x0F); self.cg_e8(0x05);  // syscall → rax = closure ptr

      // 16. Store env ptr into closure[8] if we have captures
      if (numCap > 0) {
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC3);  // mov rbx, rax (closure ptr)
        self.cg_popRax();   // rax = env ptr
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x43); self.cg_e8(0x08);  // mov [rbx+8], rax
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx (restore closure ptr)
      }

      // 17. Store fn ptr (code addr) into closure[0] via RIP-relative lea
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);  // mov rdi, rax (save closure ptr)
      // lea rax, [rip + anonLabel]
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
      var fnPtrPatch2: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_addPatch(fnPtrPatch2, anonLabel as int64, anonLabelLen, CG_PATCH_CALL);
      // mov [rdi], rax  (closure[0] = fnPtr)
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x07);
      // Return closure ptr
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF8);  // mov rax, rdi

    } else if (k == CGN_MAP_LIT) {
      // WP-BI-06: { key: val, ... } — allocate hash map, insert all entries
      // Count entries to compute initial capacity (next power of 2 >= n*2, min 8)
      var cnt: int64 := 0;
      var tmpE: int64 := self.cg_nc0(ni);
      while (tmpE != -1) { cnt := cnt + 1; tmpE := self.cg_nnext(tmpE); }
      var cap: int64 := 8;
      while (cap < cnt * 2) { cap := cap * 2; }
      // Call _lyx_map_new(cap) → rax = map ptr
      self.cg_e8(0xBF); self.cg_e32(cap);                           // mov edi, cap
      var ppMN: int64 := self.cg_emitCall();
      poke32(self.code + ppMN, CG_H_MAP_NEW - ppMN - 4);
      self.cg_e8(0x50);                                              // push rax (map ptr)
      // Insert each entry: key→rsi, val→rdx, map→rdi, call _lyx_map_set
      var entry: int64 := self.cg_nc0(ni);
      while (entry != -1) {
        self.cg_genExpr(self.cg_nc0(entry));                         // key → rax
        self.cg_e8(0x50);                                            // push rax (save key)
        self.cg_genExpr(self.cg_nc1(entry));                         // val → rax
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2);      // mov rdx, rax
        self.cg_e8(0x5E);                                            // pop rsi (key)
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24); // mov rdi,[rsp]
        var ppMS: int64 := self.cg_emitCall();
        poke32(self.code + ppMS, CG_H_MAP_SET - ppMS - 4);
        entry := self.cg_nnext(entry);
      }
      self.cg_e8(0x58);                                              // pop rax (return map ptr)

    } else if (k == CGN_SET_LIT) {
      // WP-BI-06: { val, ... } — allocate hash map used as set (value always 1)
      var cnt: int64 := 0;
      var tmpEl: int64 := self.cg_nc0(ni);
      while (tmpEl != -1) { cnt := cnt + 1; tmpEl := self.cg_nnext(tmpEl); }
      var cap: int64 := 8;
      while (cap < cnt * 2) { cap := cap * 2; }
      // Call _lyx_map_new(cap) → rax = map ptr
      self.cg_e8(0xBF); self.cg_e32(cap);                           // mov edi, cap
      var ppSN: int64 := self.cg_emitCall();
      poke32(self.code + ppSN, CG_H_MAP_NEW - ppSN - 4);
      self.cg_e8(0x50);                                              // push rax (map ptr)
      // Insert each element: elem→rsi, value=1→rdx, map→rdi, call _lyx_map_set
      var el: int64 := self.cg_nc0(ni);
      while (el != -1) {
        self.cg_genExpr(el);                                         // elem → rax
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);      // mov rsi, rax
        self.cg_e8(0xBA); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov edx, 1
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24); // mov rdi,[rsp]
        var ppSS: int64 := self.cg_emitCall();
        poke32(self.code + ppSS, CG_H_MAP_SET - ppSS - 4);
        el := self.cg_nnext(el);
      }
      self.cg_e8(0x58);                                              // pop rax (return map ptr)

    } else if (k == CGN_IN_EXPR) {
      // WP-BI-06: lhs in rhs — call _lyx_map_has(map=rhs, key=lhs) → 1 or 0
      self.cg_genExpr(self.cg_nc1(ni));                              // rhs (collection) → rax
      self.cg_e8(0x50);                                              // push rax (map ptr)
      self.cg_genExpr(self.cg_nc0(ni));                              // lhs (element) → rax
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);        // mov rsi, rax (key)
      self.cg_e8(0x5F);                                              // pop rdi (map ptr)
      var ppMH: int64 := self.cg_emitCall();
      poke32(self.code + ppMH, CG_H_MAP_HAS - ppMH - 4);

    } else if (k == 100) {
      // WP-BC-51: NK_ARRAY_LIT — [e1, e2, ...] stack-allocated array with {cap,len} header
      // Layout: [rsp+0]=cap, [rsp+8]=len, [rsp+16]=elem0, [rsp+24]=elem1, ...
      // rax = rsp (pointer to header; indexer skips 16 bytes to reach elements)
      var cnt: int64 := 0;
      var el: int64 := self.cg_nc0(ni);
      while (el != -1) { cnt := cnt + 1; el := self.cg_nnext(el); }
      if (cnt > 0) {
        // WP-10.2: cnt*8+16 must fit in int32 (x86 imm32) and must not overflow int64
        if (cnt > 0x1FFFFFFF) { return; }
        var stackBytes: int64 := cnt * 8 + 16;
        // sub rsp, stackBytes
        self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC); self.cg_e32(stackBytes);
        // write cap = cnt at [rsp+0]
        self.cg_movRaxImm(cnt);
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);
        // write len = cnt at [rsp+8]
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);
        // write elements at [rsp+16+i*8]
        var i: int64 := 0;
        el := self.cg_nc0(ni);
        while (el != -1) {
          self.cg_genExpr(el);
          var disp: int64 := 16 + i * 8;
          if (disp <= 127) {
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(disp);
          } else {
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x84); self.cg_e8(0x24); self.cg_e32(disp);
          }
          i += 1;
          el := self.cg_nnext(el);
        }
        // rax = rsp (pointer to header)
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE0);
      } else {
        self.cg_zeroRax();
      }

    } else {
      // Unknown expression: emit 0
      self.cg_zeroRax();
    }
  }

  // Infer the print dispatch type for a single argument node.
  // Returns: 0=int64/PrintInt  1=pchar/PrintStr  2=f64/PrintFloat  3=bool/PrintBool
  fn cg_inferPrintType(argNi: int64): int64 {
    var k: int64 := self.cg_nkind(argNi);
    if (k == CGN_LIT_STR)  { return 1; }
    if (k == CGN_LIT_FLOAT) { return 2; }
    if (k == CGN_LIT_BOOL)  { return 3; }
    // #1058: Ergebnis eines AUFRUFS. Bisher kannte die Funktion nur Literale und
    // Bezeichner; ein CGN_CALL fiel auf 0 und wurde als Ganzzahl ausgegeben —
    // `PrintLn(StrFromInt(42))` gab den Zeiger aus. Zuerst der deklarierte
    // Rueckgabetyp (die Registry kennt die Benutzerfunktionen), sonst die Liste
    // der Zeichenketten-Builtins.
    if (k == CGN_CALL && self.cg_nival(argNi) == 0) {
      var cnm: pchar := self.cg_nsval(argNi);
      var cnl: int64 := self.cg_nslen(argNi);
      var decl: int64 := self.cg_funcRetTypeIs(cnm, cnl, "pchar"c, 5);
      if (decl == 1) { return 1; }
      if (decl == 0) {
        if (self.cg_funcRetTypeIs(cnm, cnl, "f64"c, 3) == 1) { return 2; }
        if (self.cg_funcRetTypeIs(cnm, cnl, "bool"c, 4) == 1) { return 3; }
        return 0;
      }
      // Funktion nicht in der Registry → Builtin
      if (self.cg_builtinReturnsPchar(cnm, cnl) != 0) { return 1; }
      return 0;
    }
    if (k == CGN_IDENT) {
      var nm: pchar := self.cg_nsval(argNi);
      var nl: int64  := self.cg_nslen(argNi);
      var lidx: int64 := self.cg_findLocalIdx(nm, nl);
      if (lidx >= 0) {
        var tb: int64  := self.localTypes + lidx * CG_LOCTYPE_SZ;
        var tp: pchar  := peek64(tb) as pchar;
        var tn: int64  := peek64(tb + CG_LOCTYPE_OFF_LEN);
        if (self.cg_seq(tp, tn, "f64",   3)) { return 2; }
        if (self.cg_seq(tp, tn, "pchar", 5)) { return 1; }
        if (self.cg_seq(tp, tn, "bool",  4)) { return 3; }
      } else {
        var gidx: int64 := self.cg_findGlobalIdx(nm, nl);
        if (gidx >= 0 && peek8(self.globalIsPchar + gidx) != 0) { return 1; }
        // pchar string constants
        var cidx: int64 := self.cg_findConIdx(nm, nl);
        if (cidx >= 0) {
          if (peek8(self.conIsPchar + cidx) != 0) { return 1; }
        }
      }
    }
    return 0;
  }

  // Emit individual print calls for each argument in argNode list.
  // Type is inferred per argument; addNewline=1 appends "\n"; isStderr=1 uses fd=2.
  fn cg_genPrintMulti(argNode: int64, addNewline: int64, isStderr: int64) {
    var hStr: int64 := CG_H_PRINTSTR;
    var hInt: int64 := CG_H_PRINTINT;
    if (isStderr == 1) { hStr := CG_H_EPRINTSTR; hInt := CG_H_EPRINTINT; }
    var cur: int64 := argNode;
    while (cur >= 0) {
      var pt: int64 := self.cg_inferPrintType(cur);
      self.cg_genExpr(cur);
      // mov rdi, rax
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);
      if (pt == 1) {
        var pp: int64 := self.cg_emitCall();
        poke32(self.code + pp, hStr - pp - 4);
      } else if (pt == 2) {
        // #1049: f64 ueber _lyx_f64_to_str ausgeben. Hier stand ein Platzhalter,
        // der die Konstante "0.0" emittierte und den ausgewerteten Wert verwarf —
        // Print(1.5) gab damit 0.0 aus, ohne Meldung. Der Umwandler war die ganze
        // Zeit vorhanden und wird von PrintFloat und vom %f-Fall in cg_genPrintf
        // genauso benutzt; die Bits liegen an dieser Stelle bereits in rdi.
        var pp: int64 := self.cg_emitCall();
        poke32(self.code + pp, CG_H_F64STR - pp - 4);
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);  // mov rdi, rax
        var ppFs: int64 := self.cg_emitCall();
        poke32(self.code + ppFs, hStr - ppFs - 4);
      } else if (pt == 3) {
        var pbTOff: int64 := self.dataLen;
        self.cg_edata(116); self.cg_edata(114); self.cg_edata(117); self.cg_edata(101); self.cg_edata(0);
        var pbFOff: int64 := self.dataLen;
        self.cg_edata(102); self.cg_edata(97); self.cg_edata(108); self.cg_edata(115); self.cg_edata(101); self.cg_edata(0);
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);  // test rdi, rdi
        self.cg_e8(0x74);                                        // jz .pbFalse
        var pbFJ: int64 := self.codeLen; self.cg_e8(0);
        self.cg_emitLeaRdiData(pbTOff);
        var ppbT: int64 := self.cg_emitCall();
        poke32(self.code + ppbT, hStr - ppbT - 4);
        self.cg_e8(0xEB);                                        // jmp .pbEnd
        var pbEJ: int64 := self.codeLen; self.cg_e8(0);
        poke8(self.code + pbFJ, self.codeLen - pbFJ - 1);
        self.cg_emitLeaRdiData(pbFOff);
        var ppbF: int64 := self.cg_emitCall();
        poke32(self.code + ppbF, hStr - ppbF - 4);
        poke8(self.code + pbEJ, self.codeLen - pbEJ - 1);
      } else {
        var pp: int64 := self.cg_emitCall();
        poke32(self.code + pp, hInt - pp - 4);
      }
      cur := self.cg_nnext(cur);
    }
    if (addNewline == 1) {
      var nlOff: int64 := self.dataLen;
      self.cg_edata(10); self.cg_edata(0);
      self.cg_emitLeaRdiData(nlOff);
      var ppNL: int64 := self.cg_emitCall();
      poke32(self.code + ppNL, hStr - ppNL - 4);
    }
    self.cg_zeroRax();
  }

  // #1012: Printf(fmt, a1, a2, …) — Formatausgabe im x86-Codegen.
  //
  // Der Formatstring wird zur ÜBERSETZUNGSZEIT zerlegt: jeder Literalabschnitt
  // wird zu einem Datenkonstanten-Aufruf von _lyx_print_str, jeder Platzhalter
  // zu genau der Ausgaberoutine, die sein Typ verlangt. Damit braucht es weder
  // varargs (die Lyx nicht hat) noch einen Format-Interpreter zur Laufzeit.
  //
  // Zulaessig sind %s, %d, %f, %c und %%. Alles andere ist ein Fehler --
  // ein unbekannter Platzhalter, der einfach durchgereicht wird, waere wieder
  // ein stiller Default. Ebenso zaehlt die Argumentzahl gegen die Platzhalter.
  fn cg_genPrintf(fmtNode: int64, argNode: int64) {
    if (fmtNode < 0 || self.cg_nkind(fmtNode) != CGN_LIT_STR) {
      EPrintStrLn("error: Printf verlangt ein Zeichenkettenliteral als Format"c);
      EPrintStrLn("  Der Format-String wird zur Uebersetzungszeit zerlegt; ein zur Laufzeit"c);
      EPrintStrLn("  berechneter Wert kann dort nicht stehen."c);
      exit(1);
    }

    // Quelltextbereich des Literals ohne Anfuehrungszeichen und ohne 'c'-Suffix
    var sOff: int64 := self.cg_nsoff(fmtNode);
    var sLen: int64 := self.cg_nslen(fmtNode);
    var pEnd: int64 := sOff + sLen - 1;
    if (StrCharAt(self.pSrc, sOff + sLen - 1) == 99) { pEnd := pEnd - 1; }
    var i: int64 := sOff + 1;

    var cur: int64 := argNode;
    while (i < pEnd) {
      var c: int64 := StrCharAt(self.pSrc, i) & 255;

      if (c != 37) {
        // Literalabschnitt bis zum naechsten '%' als Datenkonstante ausgeben
        var dOff: int64 := self.dataLen;
        var wrote: int64 := 0;
        var stop: int64 := 0;
        while (i < pEnd && stop == 0) {
          var lc: int64 := StrCharAt(self.pSrc, i) & 255;
          if (lc == 37) { stop := 1; }   // '%' erreicht — i bleibt darauf stehen
          else {
            if (lc == 92 && i + 1 < pEnd) {   // '\' — Escape aufloesen
              i := i + 1;
              var ec: int64 := StrCharAt(self.pSrc, i) & 255;
              if (ec == 110)      { lc := 10; }   // \n
              else if (ec == 116) { lc := 9;  }   // \t
              else if (ec == 114) { lc := 13; }   // \r
              else if (ec == 48)  { lc := 0;  }   // \0
              else                { lc := ec; }   // \\ , \" , sonst wortwoertlich
            }
            self.cg_edata(lc);
            wrote := wrote + 1;
            i := i + 1;
          }
        }
        self.cg_edata(0);
        if (wrote > 0) {
          self.cg_emitLeaRdiData(dOff);
          var ppL: int64 := self.cg_emitCall();
          poke32(self.code + ppL, CG_H_PRINTSTR - ppL - 4);
        }

      } else {
        // Platzhalter
        i := i + 1;
        if (i >= pEnd) {
          EPrintStrLn("error: Printf-Format endet mit einem einzelnen '%'"c);
          exit(1);
        }
        var spec: int64 := StrCharAt(self.pSrc, i) & 255;
        i := i + 1;

        if (spec == 37) {
          // %% → ein Prozentzeichen
          var pcOff: int64 := self.dataLen;
          self.cg_edata(37); self.cg_edata(0);
          self.cg_emitLeaRdiData(pcOff);
          var ppP: int64 := self.cg_emitCall();
          poke32(self.code + ppP, CG_H_PRINTSTR - ppP - 4);
        } else {
          if (cur < 0) {
            EPrintStrLn("error: Printf hat mehr Platzhalter als Argumente"c);
            exit(1);
          }
          self.cg_genExpr(cur);
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);   // mov rdi, rax
          cur := self.cg_nnext(cur);

          if (spec == 115) {          // %s
            var ppS: int64 := self.cg_emitCall();
            poke32(self.code + ppS, CG_H_PRINTSTR - ppS - 4);
          } else if (spec == 100) {   // %d
            var ppD: int64 := self.cg_emitCall();
            poke32(self.code + ppD, CG_H_PRINTINT - ppD - 4);
          } else if (spec == 102) {   // %f — Bits nach _lyx_f64_to_str, dann ausgeben
            var ppF: int64 := self.cg_emitCall();
            poke32(self.code + ppF, CG_H_F64STR - ppF - 4);
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);  // mov rdi, rax
            var ppFs: int64 := self.cg_emitCall();
            poke32(self.code + ppFs, CG_H_PRINTSTR - ppFs - 4);
          } else if (spec == 99) {    // %c — ein Byte direkt schreiben
            self.cg_e8(0x57);                                        // push rdi
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE6);   // mov rsi, rsp
            self.cg_e8(0xBA); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov edx,1
            self.cg_e8(0xBF); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov edi,1
            self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax,1
            self.cg_e8(0x0F); self.cg_e8(0x05);                      // syscall
            self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x08);  // add rsp,8
          } else {
            EPrintStr("error: Printf kennt den Platzhalter '%"c);
            sys_write(2, self.pSrc as int64 + i - 1, 1);
            EPrintStrLn("' nicht — zulaessig sind %s, %d, %f, %c und %%"c);
            exit(1);
          }
        }
      }
    }

    if (cur >= 0) {
      EPrintStrLn("error: Printf hat mehr Argumente als Platzhalter"c);
      exit(1);
    }
    self.cg_zeroRax();
  }

  // Generate a function call (NK_CALL node)
  fn cg_genCall(ni: int64) {
    var fname: pchar := self.cg_nsval(ni);
    var fnlen: int64 := self.cg_nslen(ni);
    var isMethod: int64 := self.cg_nival(ni);
    // #1091: iVal 3 markiert `super.M()`. Die Umsetzung auf 1 muss HIER
    // geschehen, vor jeder Verzweigung: die Argumentliste eines Methoden-
    // aufrufs steht in c1, die eines gewoehnlichen in c0. Wurde der Marker
    // erst spaeter aufgeloest, nahm der Aufruf den Nicht-Methoden-Pfad, fand
    // dort keine Argumente und der Aufgerufene las, was zufaellig in den
    // Registern stand -- `super.One(7)` lieferte 4096.
    var isSuperCall: int64 := 0;
    if (isMethod == 3) { isSuperCall := 1; isMethod := 1; }

    // WP-BC-24: generic call (iVal==2) — build mangled name and register JMP stub
    if (isMethod == 2) {
      var typeArgsNi: int64 := self.cg_nc2(ni);
      var mangBuf: int64 := alloc(fnlen + 256);
      var mangLen: int64 := self.cg_buildMangledName(fname, fnlen, typeArgsNi, mangBuf);
      if (self.cg_monoExists(mangBuf as pchar, mangLen) == 0) {
        self.cg_addMono(mangBuf as pchar, mangLen, fname, fnlen);
      }
      // Emit call to mangled name (JMP stub will redirect to generic function)
      isMethod := 0;
      fname := mangBuf as pchar;
      fnlen := mangLen;
    }

    // Count args
    var argNode: int64 := self.cg_nc0(ni);
    if (isMethod == 1) { argNode := self.cg_nc1(ni); }

    // LBF-Loader: _indirect_call_0(fnPtr) / _indirect_call_1(fnPtr, arg) — Aufruf eines
    // ROHEN Code-Pointers (kein Closure-Struct). fnPtr → rax, arg → rdi, dann `call rax`.
    if (isMethod == 0) {
      if (self.cg_seq(fname, fnlen, "_indirect_call_0", 16)) {
        self.cg_genExpr(argNode);               // rax = fnPtr
        self.cg_e8(0xFF); self.cg_e8(0xD0);     // call rax
        return;
      }
      if (self.cg_seq(fname, fnlen, "_indirect_call_1", 16)) {
        var icA1: int64 := self.cg_nnext(argNode);  // erstes echtes Argument
        self.cg_genExpr(icA1);   self.cg_pushRax(); // push arg
        self.cg_genExpr(argNode);                    // rax = fnPtr
        self.cg_e8(0x5F);                            // pop rdi  (= arg)
        self.cg_e8(0xFF); self.cg_e8(0xD0);          // call rax
        return;
      }
      // _2/_3/_4 waren in sema registriert, aber nie emittiert — std/android/jni.lyx
      // benutzt sie, was erst beim Bauen eines Programms auffiel (--compile-unit
      // erreicht den Codegen nicht). Gleiches Schema wie _1, nur mehr Register:
      // Argumente in UMGEKEHRTER Reihenfolge pushen, fnPtr nach rax, dann in
      // rdi/rsi/rdx/rcx zurückholen — so landet a1 in rdi.
      if (self.cg_seq(fname, fnlen, "_indirect_call_2", 16)) {
        self.cg_genIndirectCallN(argNode, 2);
        return;
      }
      if (self.cg_seq(fname, fnlen, "_indirect_call_3", 16)) {
        self.cg_genIndirectCallN(argNode, 3);
        return;
      }
      if (self.cg_seq(fname, fnlen, "_indirect_call_4", 16)) {
        self.cg_genIndirectCallN(argNode, 4);
        return;
      }
    }

    // WP-02: Check if fname is a local closure variable — emit indirect call
    if (isMethod == 0) {
      var clOff: int64 := self.cg_findLocal(fname, fnlen);
      if (clOff != 0) {
        // #1: lokaler plain fn-ptr (fn-Typ-Alias)? → thin-call: Adresse laden, Args in normalen
        // Registern (arg0→rdi), KEIN env-Shift. Vorher: Closure-Pfad las {fnPtr,env} → Garbage/Crash.
        var clIdx: int64 := self.cg_findLocalIdx(fname, fnlen);
        var isThinFn: int64 := 0;
        if (clIdx >= 0) {
          var ltb: int64 := self.localTypes + clIdx * CG_LOCTYPE_SZ;
          var ltp: pchar := peek64(ltb) as pchar;
          var ltl: int64 := peek64(ltb + CG_LOCTYPE_OFF_LEN);
          if (ltp != 0 as pchar && ltl > 0 && self.cg_isFnPtrAlias(ltp, ltl) != 0) { isThinFn := 1; }
          // #1003: inline geschriebener fn-Zeigertyp — gleicher thin-call
          if (peek8(self.localIsFnPtr + clIdx) != 0) { isThinFn := 1; }
        }
        if (isThinFn != 0) {
          var tfCur: int64 := argNode;
          var tfArgc: int64 := 0;
          while (tfCur >= 0) { self.cg_genExpr(tfCur); self.cg_pushRax(); tfArgc := tfArgc + 1; tfCur := self.cg_nnext(tfCur); }
          self.cg_loadRax(clOff);                                 // rax = fn-Adresse (plain)
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC3);   // mov rbx, rax
          if (tfArgc >= 6) { self.cg_e8(0x41); self.cg_e8(0x59); }  // pop r9
          if (tfArgc >= 5) { self.cg_e8(0x41); self.cg_e8(0x58); }  // pop r8
          if (tfArgc >= 4) { self.cg_popRcx(); }
          if (tfArgc >= 3) { self.cg_popRdx(); }
          if (tfArgc >= 2) { self.cg_popRsi(); }
          if (tfArgc >= 1) { self.cg_popRdi(); }
          self.cg_e8(0xFF); self.cg_e8(0xD3);                     // call rbx
          return;
        }
        // Evaluate explicit args and push them
        var clCur: int64 := argNode;
        var clArgc: int64 := 0;
        while (clCur >= 0) {
          self.cg_genExpr(clCur);
          self.cg_pushRax();
          clArgc += 1;
          clCur := self.cg_nnext(clCur);
        }
        // Load closure ptr from local
        self.cg_loadRax(clOff);           // rax = closure ptr {fnPtr, envPtr}
        // Load env ptr → rdi (hidden first arg)
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x78); self.cg_e8(0x08);  // mov rdi, [rax+8]
        // Load fn ptr → rbx
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x18);                    // mov rbx, [rax]
        // Pop explicit args into rsi, rdx, rcx, r8, r9 (shifted: rdi is env ptr)
        if (clArgc >= 5) { self.cg_e8(0x41); self.cg_e8(0x59); }  // pop r9
        if (clArgc >= 4) { self.cg_e8(0x41); self.cg_e8(0x58); }  // pop r8
        if (clArgc >= 3) { self.cg_popRcx(); }
        if (clArgc >= 2) { self.cg_popRdx(); }
        if (clArgc >= 1) { self.cg_popRsi(); }
        // call rbx (indirect)
        self.cg_e8(0xFF); self.cg_e8(0xD3);  // call rbx
        return;
      }
    }

    // Intercept array built-in methods before arg evaluation (WP-10b)
    if (isMethod == 1) {
      var arrObj: int64 := self.cg_nc0(ni);
      if (self.cg_identIsArray(arrObj) != 0) {
        var pushStr: pchar := "push";
        var popStr:  pchar := "pop";
        if (self.cg_seq(fname, fnlen, pushStr, 4)) {
          self.cg_genArrayPush(arrObj, argNode);
          return;
        } else if (self.cg_seq(fname, fnlen, popStr, 3)) {
          self.cg_genArrayPop(arrObj);
          return;
        }
      }
    }
    // A1: Fn-Pointer-FELD-Call — obj.field(args), wobei `field` ein Klassen-FELD (kein Methode) ist.
    // Plain indirekter Call: Feld laden (= Fn-Adresse), Args in normalen Registern, KEIN self-Inject.
    if (isMethod == 1) {
      var fpObj: int64 := self.cg_nc0(ni);
      var fpClassIdx: int64 := self.cg_objClassIdx(fpObj);
      if (fpClassIdx >= 0) {
        var fpOff: int64 := self.cg_findField(fpClassIdx, fname, fnlen);
        if (fpOff >= 0 && self.cg_fieldIsMethodType(fpClassIdx, fname, fnlen) != 0) {
          // B2: fat-call. Feld = Pointer auf heap-{code,data}. self=data→rdi (wie Methode),
          // explizite Args→rsi,rdx,... call code. argNode = cg_nc1 (isMethod==1).
          var mcCur: int64 := argNode;
          var mcArgc: int64 := 0;
          while (mcCur >= 0) { self.cg_genExpr(mcCur); self.cg_pushRax(); mcArgc := mcArgc + 1; mcCur := self.cg_nnext(mcCur); }
          self.cg_genExpr(fpObj);                                     // rax = obj
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80);       // mov rax, [rax+disp32] = p
          self.cg_e8(fpOff & 0xFF); self.cg_e8((fpOff >> 8) & 0xFF);
          self.cg_e8((fpOff >> 16) & 0xFF); self.cg_e8((fpOff >> 24) & 0xFF);
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x18);       // mov rbx, [rax]   = code
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x78); self.cg_e8(0x08); // mov rdi,[rax+8] = data (self)
          if (mcArgc >= 5) { self.cg_e8(0x41); self.cg_e8(0x59); }    // pop r9
          if (mcArgc >= 4) { self.cg_e8(0x41); self.cg_e8(0x58); }    // pop r8
          if (mcArgc >= 3) { self.cg_popRcx(); }
          if (mcArgc >= 2) { self.cg_popRdx(); }
          if (mcArgc >= 1) { self.cg_popRsi(); }
          self.cg_e8(0xFF); self.cg_e8(0xD3);                         // call rbx
          return;
        }
        if (fpOff >= 0) {
          // explizite Args auswerten + pushen (argNode = cg_nc1 für isMethod==1)
          var fpCur: int64 := argNode;
          var fpArgc: int64 := 0;
          while (fpCur >= 0) { self.cg_genExpr(fpCur); self.cg_pushRax(); fpArgc := fpArgc + 1; fpCur := self.cg_nnext(fpCur); }
          // Objekt → rax; Fn-Adresse aus Feld → rbx
          self.cg_genExpr(fpObj);
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x98);   // mov rbx, [rax+disp32]
          self.cg_e8(fpOff & 0xFF); self.cg_e8((fpOff >> 8) & 0xFF);
          self.cg_e8((fpOff >> 16) & 0xFF); self.cg_e8((fpOff >> 24) & 0xFF);
          // Args zurück in rdi,rsi,rdx,rcx,r8,r9 (normal, arg0→rdi; KEIN env-Shift)
          if (fpArgc >= 6) { self.cg_e8(0x41); self.cg_e8(0x59); }  // pop r9
          if (fpArgc >= 5) { self.cg_e8(0x41); self.cg_e8(0x58); }  // pop r8
          if (fpArgc >= 4) { self.cg_popRcx(); }
          if (fpArgc >= 3) { self.cg_popRdx(); }
          if (fpArgc >= 2) { self.cg_popRsi(); }
          if (fpArgc >= 1) { self.cg_popRdi(); }
          self.cg_e8(0xFF); self.cg_e8(0xD3);   // call rbx
          return;
        }
      }
    }
    // Intercept push(arr, val) / pop(arr) free-function forms before arg evaluation
    if (isMethod == 0) {
      if (self.cg_seq(fname, fnlen, "push", 4)) {
        var pushArr: int64 := argNode;
        var pushVal: int64 := self.cg_nnext(argNode);
        if (pushArr >= 0 && pushVal >= 0) {
          self.cg_genArrayPush(pushArr, pushVal);
          return;
        }
      }
      if (self.cg_seq(fname, fnlen, "pop", 3)) {
        if (argNode >= 0) {
          self.cg_genArrayPop(argNode);
          return;
        }
      }
      // Print / PrintLn multi-arg compile-time type dispatch (WP-OUT-01)
      if (self.cg_seq(fname, fnlen, "Print", 5) ||
          self.cg_seq(fname, fnlen, "PrintLn", 7) ||
          self.cg_seq(fname, fnlen, "Println", 7)) {
        var addNl: int64 := 0;
        if (self.cg_seq(fname, fnlen, "PrintLn", 7) ||
            self.cg_seq(fname, fnlen, "Println", 7)) { addNl := 1; }
        self.cg_genPrintMulti(argNode, addNl, 0);
        return;
      }
      // #1012: Printf(fmt, …) — Format zur Uebersetzungszeit zerlegen. Muss vor
      // der allgemeinen Argumentauswertung stehen, weil jedes Argument seine
      // eigene Ausgaberoutine bekommt.
      if (self.cg_seq(fname, fnlen, "Printf", 6)) {
        self.cg_genPrintf(argNode, self.cg_nnext(argNode));
        return;
      }
      // EPrint / EPrintLn multi-arg to stderr (WP-OUT-02)
      if (self.cg_seq(fname, fnlen, "EPrint", 6) ||
          self.cg_seq(fname, fnlen, "EPrintLn", 8)) {
        var addNl: int64 := 0;
        if (self.cg_seq(fname, fnlen, "EPrintLn", 8)) { addNl := 1; }
        self.cg_genPrintMulti(argNode, addNl, 1);
        return;
      }
    }

    var argc: int64 := 0;
    var isStaticCall: int64 := 0;
    var cur: int64 := argNode;
    while (cur != -1) { argc := argc + 1; cur := self.cg_nnext(cur); }

    // WP-MEM-05: mmap(size: N) or mmap(len: N) — expand single named arg to 6-arg syscall
    if (isMethod == 0 && argc == 1 && argNode >= 0 && self.cg_nkind(argNode) == CGN_NAMED_ARG) {
      var mmArg: pchar := self.cg_nsval(argNode);
      var mmLen: int64 := self.cg_nslen(argNode);
      var isMmapName: int64 := 0;
      if (fnlen == 4) {
        if (StrCharAt(fname,0)==109 && StrCharAt(fname,1)==109 &&
            StrCharAt(fname,2)==97  && StrCharAt(fname,3)==112) { isMmapName := 1; }
      }
      var isLenArg: int64 := 0;
      if (mmLen == 4) {
        if (StrCharAt(mmArg,0)==115 && StrCharAt(mmArg,1)==105 &&
            StrCharAt(mmArg,2)==122 && StrCharAt(mmArg,3)==101) { isLenArg := 1; } // "size"
      }
      if (mmLen == 3) {
        if (StrCharAt(mmArg,0)==108 && StrCharAt(mmArg,1)==101 &&
            StrCharAt(mmArg,2)==110) { isLenArg := 1; } // "len"
      }
      if (isMmapName != 0 && isLenArg != 0) {
        self.cg_movRaxImm(0);    self.cg_pushRax();  // addr=0
        self.cg_genExpr(self.cg_nc0(argNode)); self.cg_pushRax();  // len=value
        self.cg_movRaxImm(3);    self.cg_pushRax();  // prot=PROT_RW
        self.cg_movRaxImm(34);   self.cg_pushRax();  // flags=MAP_ANON
        self.cg_movRaxImm(-1);   self.cg_pushRax();  // fd=-1
        self.cg_movRaxImm(0);    self.cg_pushRax();  // offset=0
        self.cg_e8(0x41); self.cg_e8(0x59);  // pop r9
        self.cg_e8(0x41); self.cg_e8(0x58);  // pop r8
        self.cg_popRcx(); self.cg_popRdx(); self.cg_popRsi(); self.cg_popRdi();
        self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xCA);  // mov r10,rcx
        self.cg_movRaxImm(9); self.cg_e8(0x0F); self.cg_e8(0x05);
        self.cg_emitIoResultSave();
        if (self.ioCheckEnabled != 0) { self.cg_emitIoCheckPanic(); }
        return;
      }
    }

    // WP-MEM-05: default params — find callee in same-module top-level declarations
    // and emit default expressions for trailing params not covered by explicit args.
    // Only applies to user-defined functions (isMethod == 0, not a builtin).
    var cgDefFuncNi: int64 := -1;
    if (isMethod == 0 && self.topLevelHead >= 0) {
      var cgScan: int64 := self.topLevelHead;
      while (cgScan >= 0) {
        if (self.cg_nkind(cgScan) == CGN_FUNC_DECL) {
          if (self.cg_nslen(cgScan) == fnlen) {
            var cgFN: pchar := self.cg_nsval(cgScan);
            var cgMatch: int64 := 1;
            var cgJ: int64 := 0;
            while (cgJ < fnlen) {
              if (cgMatch != 0) {
                if (StrCharAt(cgFN, cgJ) != StrCharAt(fname, cgJ)) { cgMatch := 0; }
              }
              cgJ += 1;
            }
            if (cgMatch != 0) { cgDefFuncNi := cgScan; cgScan := -2; }
          }
        }
        if (cgScan >= 0) { cgScan := self.cg_nnext(cgScan); }
      }
    }

    // L-4: resolve smObj and static-call BEFORE ordering push
    var smObj: int64 := -1;
    if (isMethod == 1) {
      smObj := self.cg_nc0(ni);
      if (self.cg_nkind(smObj) == CGN_IDENT) {
        var smName: pchar := self.cg_nsval(smObj);
        var smLen:  int64 := self.cg_nslen(smObj);
        if (self.cg_findLocalIdx(smName, smLen) < 0 &&
            self.cg_findClass(smName, smLen) >= 0) {
          isStaticCall := 1;
        }
      }
    }

    // L-4: total arg slots including implicit self.
    // Auch der statische Aufruf `TypeName.Method(a)` braucht den self-Slot: der
    // Callee `TypeName_Method` hat IMMER ein implizites self als ersten Parameter.
    // Ohne den Slot rutschten alle Argumente um ein Register nach vorn — self
    // bekam den ersten echten Wert, der erste Parameter Müll (`SB.Create(41)`
    // lieferte 169 statt 42). Statt einer Instanz wird 0 übergeben; dass die
    // Methode self nicht anfassen darf, prüft sema bereits (BUG-6).
    var nExpl: int64 := argc;
    var nTotal: int64 := argc;
    if (isMethod == 1) { nTotal := argc + 1; }

    if (nTotal <= 6) {
      // Simple path: all fit in registers — push self first (method), then args, then defaults
      if (isMethod == 1) {
        if (isSuperCall != 0) { self.cg_loadLocalByName("self"c, 4); }
        else { if (isStaticCall == 0) { self.cg_genExpr(smObj); }
        else { self.cg_zeroRax(); } }        // statisch: self = 0
        self.cg_pushRax();
        argc += 1;
      }
      cur := argNode;
      while (cur != -1) {
        self.cg_genExpr(cur);
        self.cg_pushRax();
        cur := self.cg_nnext(cur);
      }
      // WP-MEM-05: emit default expressions for remaining params
      if (cgDefFuncNi >= 0) {
        var cgPn: int64 := self.cg_nc0(cgDefFuncNi);
        var cgSkip: int64 := 0;
        while (cgSkip < argc && cgPn >= 0) {
          cgPn := self.cg_nnext(cgPn);
          cgSkip += 1;
        }
        while (cgPn >= 0) {
          var cgDef: int64 := self.cg_nc1(cgPn);
          if (cgDef >= 0) {
            self.cg_genExpr(cgDef);
            self.cg_pushRax();
            argc += 1;
          }
          cgPn := self.cg_nnext(cgPn);
        }
      }
    } else {
      // L-4: 7+ param path — push stack args first (reverse), then register args
      var argBuf: int64 := alloc(nExpl * 8);
      var acnt: int64 := 0;
      var acur: int64 := argNode;
      while (acur != -1) {
        poke64(argBuf + acnt * 8, acur);
        acnt += 1;
        acur := self.cg_nnext(acur);
      }
      if (isMethod == 1) {
        argc += 1;
        // Push stack explicit args in reverse: arg[nExpl-1] deepest, arg[5] shallowest
        var si: int64 := nExpl - 1;
        while (si >= 5) {
          self.cg_genExpr(peek64(argBuf + si * 8));
          self.cg_pushRax();
          si -= 1;
        }
        // Push self into rdi slot (statisch: 0 — siehe Kommentar oben)
        // #1091: Bei `super.M()` gibt es keinen Empfaengerknoten -- der Aufruf
        // laeuft auf derselben Instanz, also das lokale `self` laden.
        if (isSuperCall != 0) { self.cg_loadLocalByName("self"c, 4); }
        else { if (isStaticCall == 0) { self.cg_genExpr(smObj); }
        else { self.cg_zeroRax(); } }
        self.cg_pushRax();
        // Push register explicit args: arg[0..4]
        var ri: int64 := 0;
        while (ri < 5 && ri < nExpl) {
          self.cg_genExpr(peek64(argBuf + ri * 8));
          self.cg_pushRax();
          ri += 1;
        }
      } else {
        // Non-method: push stack args in reverse (arg[argc-1]..arg[6]), then reg args (arg[0..5])
        var si2: int64 := argc - 1;
        while (si2 >= 6) {
          self.cg_genExpr(peek64(argBuf + si2 * 8));
          self.cg_pushRax();
          si2 -= 1;
        }
        var ri2: int64 := 0;
        while (ri2 < 6) {
          self.cg_genExpr(peek64(argBuf + ri2 * 8));
          self.cg_pushRax();
          ri2 += 1;
        }
      }
      free(argBuf, nExpl * 8);
    }

    // Pop args into registers
    if (argc >= 6) { self.cg_e8(0x41); self.cg_e8(0x59); }  // pop r9  (arg5)
    if (argc >= 5) { self.cg_e8(0x41); self.cg_e8(0x58); }  // pop r8  (arg4)
    if (argc >= 4) { self.cg_popRcx(); }                      // pop rcx (arg3)
    if (argc >= 3) { self.cg_popRdx(); }                      // pop rdx (arg2)
    if (argc >= 2) { self.cg_popRsi(); }                      // pop rsi (arg1)
    if (argc >= 1) { self.cg_popRdi(); }                      // pop rdi (arg0)
    
    // WP-13: For nested function calls, pass static link (rbp+16 from outer frame)
    // Check if this is a nested function by checking staticLinkOffset >= 0
    if (self.staticLinkOffset >= 0) {
      // Push static link as hidden first argument
      // mov rax, [rbp+16]  (load static link from outer frame)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x45); self.cg_e8(0x10);
      self.cg_pushRax();
      // Adjust: pop into r10 (8th arg) or push before other args
      // For simplicity, we pass static link in r10 (sysv abi: r10 for special args)
      self.cg_popRax();
      self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);  // mov r10, rax
    }

    // For method calls: mangle name and emit call
    if (isMethod == 1) {
      var objNode: int64 := self.cg_nc0(ni);
      var classIdx: int64 := self.cg_objClassIdx(objNode);
      // #1091: Bei `super.M()` zaehlt die ELTERNKLASSE der gerade erzeugten
      // Klasse, und der Aufruf geht DIREKT dorthin -- nicht ueber die VMT.
      // Ueber die VMT riefe `super.F()` in einem `override fn F()` sich
      // selbst, endlos.
      if (isSuperCall != 0) {
        classIdx := 0 - 1;
        var curIdx: int64 := self.cg_curClassIdx();
        if (curIdx >= 0) {
          var parIdx: int64 := peek64(self.classLayouts + curIdx * CG_CLASS_SZ + CG_CLASS_OFF_PARENTIDX);
          if (parIdx >= 0) {
            var pcName: pchar := peek64(self.classLayouts + parIdx * CG_CLASS_SZ) as pchar;
            var pcLen:  int64 := peek64(self.classLayouts + parIdx * CG_CLASS_SZ + CG_CLASS_OFF_NAMELEN);
            var spLen: int64 := pcLen + 1 + fnlen;
            var spBuf: int64 := alloc(spLen + 1);
            var spI: int64 := 0;
            while (spI < pcLen) { poke8(spBuf + spI, StrCharAt(pcName, spI)); spI := spI + 1; }
            StrSetChar(spBuf as pchar, pcLen, 95);
            var spJ: int64 := 0;
            while (spJ < fnlen) { poke8(spBuf + pcLen + 1 + spJ, StrCharAt(fname, spJ)); spJ := spJ + 1; }
            poke8(spBuf + spLen, 0);
            var spPp: int64 := self.cg_emitCall();
            self.cg_addPatch(spPp, spBuf, spLen, CG_PATCH_CALL);
            self.cg_trackTempBuf(spBuf, spLen + 1);
          } else {
            EPrintStrLn("error: super ohne Elternklasse"c);
            self.cg_zeroRax();
          }
        } else {
          EPrintStrLn("error: super ausserhalb einer Klassenmethode"c);
          self.cg_zeroRax();
        }
      } else if (classIdx >= 0) {
        var clsBase: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
        // WP-BC-L2: virtual dispatch. If the method occupies a VMT slot in the
        // object's static class, call through the runtime vtable instead of a
        // static mangled name — this is what makes override/late-binding work.
        // Slot indices are consistent base↔derived (parent slots copied first),
        // so the static class's slot index correctly indexes the dynamic vtable.
        var vmtListCS: int64   := peek64(clsBase + CG_CLASS_OFF_VMTLIST);
        var vmtSlotsCS: int64  := peek64(clsBase + CG_CLASS_OFF_VMTSLOTS);
        var vSlot: int64 := 0 - 1;
        var vs: int64 := 0;
        while (vs < vmtSlotsCS) {
          var vName: pchar := peek64(vmtListCS + vs * 16) as pchar;
          var vLen:  int64 := peek64(vmtListCS + vs * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN);
          if (self.cg_seq(vName, vLen, fname, fnlen) != 0) { vSlot := vs; break; }
          vs += 1;
        }
        if (vSlot >= 0 && isStaticCall == 0) {
          // self is in rdi (arg0). mov rax,[rdi]; mov rax,[rax+slot*8]; call rax
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x07);
          var vdisp: int64 := vSlot * 8;
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80);
          self.cg_e8(vdisp & 0xFF);
          self.cg_e8((vdisp >> 8) & 0xFF);
          self.cg_e8((vdisp >> 16) & 0xFF);
          self.cg_e8((vdisp >> 24) & 0xFF);
          self.cg_e8(0xFF); self.cg_e8(0xD0);
          return;
        }
        var clsName: pchar := peek64(clsBase) as pchar;
        var clsLen:  int64 := peek64(clsBase + CG_CLASS_OFF_NAMELEN);
        var mangLen: int64 := clsLen + 1 + fnlen;
        var mangBuf: int64 := alloc(mangLen + 1);
        var mi: int64 := 0;
        while (mi < clsLen) { poke8(mangBuf + mi, StrCharAt(clsName, mi)); mi := mi + 1; }
        StrSetChar(mangBuf as pchar, clsLen, 95);
        var mj: int64 := 0;
        while (mj < fnlen) { poke8(mangBuf + clsLen + 1 + mj, StrCharAt(fname, mj)); mj := mj + 1; }
        poke8(mangBuf + mangLen, 0);
        var pp: int64 := self.cg_emitCall();
        self.cg_addPatch(pp, mangBuf, mangLen, CG_PATCH_CALL);
        // Track mangled method name buffer for cleanup after patching (BUG-02)
        self.cg_trackTempBuf(mangBuf, mangLen + 1);
      } else if (isStaticCall != 0) {
        // TypeName.Method() — mangle as TypeName_Method
        var stName: pchar := self.cg_nsval(objNode);
        var stLen:  int64 := self.cg_nslen(objNode);
        var stMangLen: int64 := stLen + 1 + fnlen;
        var stMangBuf: int64 := alloc(stMangLen + 1);
        var stMi: int64 := 0;
        while (stMi < stLen) { poke8(stMangBuf + stMi, StrCharAt(stName, stMi)); stMi := stMi + 1; }
        StrSetChar(stMangBuf as pchar, stLen, 95);
        var stMj: int64 := 0;
        while (stMj < fnlen) { poke8(stMangBuf + stLen + 1 + stMj, StrCharAt(fname, stMj)); stMj := stMj + 1; }
        poke8(stMangBuf + stMangLen, 0);
        var stPp: int64 := self.cg_emitCall();
        self.cg_addPatch(stPp, stMangBuf, stMangLen, CG_PATCH_CALL);
        self.cg_trackTempBuf(stMangBuf, stMangLen + 1);
      } else {
        var pp: int64 := self.cg_emitCall();
        self.cg_addPatch(pp, fname as int64, fnlen, CG_PATCH_CALL);
      }
      self.cg_popStackArgs(nTotal);
      return;
    }

    // Check for builtin functions
    var pstr: pchar := "PrintStr";
    var pint: pchar := "PrintInt";
    var slen: pchar := "StrLen";
    var mmapn: pchar := "mmap";
    var pk8: pchar := "poke8";
    var pk64: pchar := "poke64";
    var gk8: pchar := "peek8";
    var gk64: pchar := "peek64";
    var pk32: pchar := "poke32";
    var gk32: pchar := "peek32";

    if (self.cg_seq(fname, fnlen, pstr, 8)) {
      // call _lyx_print_str  (rdi already has the arg)
      var pp: int64 := self.cg_emitCall();
      poke32(self.code + pp, CG_H_PRINTSTR - pp - 4);

    } else if (self.cg_seq(fname, fnlen, pint, 8)) {
      var pp: int64 := self.cg_emitCall();
      poke32(self.code + pp, CG_H_PRINTINT - pp - 4);

    } else if (self.cg_seq(fname, fnlen, "EPrintStr", 9)) {
      var pp: int64 := self.cg_emitCall();
      poke32(self.code + pp, CG_H_EPRINTSTR - pp - 4);

    } else if (self.cg_seq(fname, fnlen, "EPrintInt", 9)) {
      var pp: int64 := self.cg_emitCall();
      poke32(self.code + pp, CG_H_EPRINTINT - pp - 4);

    } else if (self.cg_seq(fname, fnlen, "EPrintStrLn", 11)) {
      // EPrintStrLn(s): EPrintStr(s) then "\n" to stderr
      var pp: int64 := self.cg_emitCall();
      poke32(self.code + pp, CG_H_EPRINTSTR - pp - 4);
      var enlOff: int64 := self.dataLen;
      self.cg_edata(10); self.cg_edata(0);
      self.cg_emitLeaRdiData(enlOff);
      var ppNL: int64 := self.cg_emitCall();
      poke32(self.code + ppNL, CG_H_EPRINTSTR - ppNL - 4);
      self.cg_zeroRax();

    } else if (self.cg_seq(fname, fnlen, "EPrintFloat", 11)) {
      // EPrintFloat(f: f64): call _lyx_f64_to_str(xmm0) → rax=buf → call _lyx_eprint_str
      var ppEpf: int64 := self.cg_emitCall();
      poke32(self.code + ppEpf, CG_H_F64STR - ppEpf - 4);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);  // mov rdi, rax
      var ppEps: int64 := self.cg_emitCall();
      poke32(self.code + ppEps, CG_H_EPRINTSTR - ppEps - 4);
      self.cg_zeroRax();

    } else if (self.cg_seq(fname, fnlen, "EPrintBool", 10)) {
      // EPrintBool(b): print "true" or "false" to stderr
      var epbTOff: int64 := self.dataLen;
      self.cg_edata(116); self.cg_edata(114); self.cg_edata(117); self.cg_edata(101); self.cg_edata(0);
      var epbFOff: int64 := self.dataLen;
      self.cg_edata(102); self.cg_edata(97); self.cg_edata(108); self.cg_edata(115); self.cg_edata(101); self.cg_edata(0);
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);  // test rdi, rdi
      self.cg_e8(0x74); var epbFJ: int64 := self.codeLen; self.cg_e8(0);
      self.cg_emitLeaRdiData(epbTOff);
      var ppepbT: int64 := self.cg_emitCall();
      poke32(self.code + ppepbT, CG_H_EPRINTSTR - ppepbT - 4);
      self.cg_e8(0xEB); var epbEJ: int64 := self.codeLen; self.cg_e8(0);
      poke8(self.code + epbFJ, self.codeLen - epbFJ - 1);
      self.cg_emitLeaRdiData(epbFOff);
      var ppepbF: int64 := self.cg_emitCall();
      poke32(self.code + ppepbF, CG_H_EPRINTSTR - ppepbF - 4);
      poke8(self.code + epbEJ, self.codeLen - epbEJ - 1);
      self.cg_zeroRax();

    } else if (self.cg_seq(fname, fnlen, slen, 6)) {
      var pp: int64 := self.cg_emitCall();
      var rel32: int64 := CG_H_STRLEN - pp - 4;
      poke32(self.code + pp, rel32);

    } else if (self.cg_seq(fname, fnlen, "StrSub", 6)) {
      // StrSub(s: pchar, start: int64, len: int64): pchar
      // rdi=s, rsi=start, rdx=len
      // Call _lyx_strsub helper
      var pp: int64 := self.cg_emitCall();
      var rel32: int64 := CG_H_STRSUB - pp - 4;
      poke32(self.code + pp, rel32);

    } else if (self.cg_seq(fname, fnlen, "StrCharAt", 9)) {
      // StrCharAt(s: pchar, i: int64): int64  -- s in rdi, i in rsi
      // Call _lyx_strcharat helper
      var pp: int64 := self.cg_emitCall();
      var rel32: int64 := CG_H_STRCHARAT - pp - 4;
      poke32(self.code + pp, rel32);

    } else if (self.cg_seq(fname, fnlen, mmapn, 4)) {
      // mmap(addr,len,prot,flags,fd,offset): Linux syscall 9
      // After generic pop: rdi=addr, rsi=len, rdx=prot, rcx=flags, r8=fd, r9=offset
      // Linux mmap syscall needs r10=flags (not rcx)
      self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xCA);  // mov r10, rcx
      self.cg_movRaxImm(9);
      self.cg_e8(0x0F); self.cg_e8(0x05);
      self.cg_emitIoResultSave();
      if (self.ioCheckEnabled != 0) { self.cg_emitIoCheckPanic(); }

    } else if (self.cg_seq(fname, fnlen, "munmap", 6)) {
      // free(addr, len): Linux syscall 11
      self.cg_movRaxImm(11);
      self.cg_e8(0x0F); self.cg_e8(0x05);
      self.cg_emitIoResultSave();
      if (self.ioCheckEnabled != 0) { self.cg_emitIoCheckPanic(); }

    } else if (self.cg_seq(fname, fnlen, "push", 4) ||
               self.cg_seq(fname, fnlen, "append", 6) ||
               self.cg_seq(fname, fnlen, "pop", 3)) {
      // push/pop/append are intercepted before arg evaluation; should not reach here
      self.cg_zeroRax();

    } else if (self.cg_seq(fname, fnlen, "cap", 3)) {
      // cap(arr): load cap field [arr+0] from dynamic array fat-pointer
      // rdi = array ptr (already evaluated)
      var capArgNi: int64 := self.cg_nc0(ni);
      if (capArgNi >= 0 && self.cg_nkind(capArgNi) == CGN_IDENT) {
        var capName: pchar := self.cg_nsval(capArgNi);
        var capNlen: int64 := self.cg_nslen(capArgNi);
        var capIdx: int64 := self.cg_findLocalIdx(capName, capNlen);
        if (capIdx >= 0 && peek8(self.localIsArray + capIdx) != 0) {
          // mov rax, [rdi]  (cap at offset 0)
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x07);
        } else {
          self.cg_zeroRax();
        }
      } else {
        self.cg_zeroRax();
      }

    } else if (self.cg_seq(fname, fnlen, "len", 3)) {
      // len(arr): compile-time size for fixed/literal arrays; runtime [arr+8] for dynamic
      var lenArgNi: int64 := self.cg_nc0(ni);
      if (lenArgNi >= 0 && self.cg_nkind(lenArgNi) == CGN_IDENT) {
        var aname: pchar := self.cg_nsval(lenArgNi);
        var anlen: int64 := self.cg_nslen(lenArgNi);
        var lidx: int64 := self.cg_findLocalIdx(aname, anlen);
        if (lidx >= 0) {
          var sz: int64 := peek64(self.localArraySize + lidx * 8);
          if (sz > 0) {
            self.cg_movRaxImm(sz);
          } else if (peek8(self.localIsArray + lidx) != 0) {
            // mov rax, [rdi+8]  (len field of dynamic array fat-pointer)
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x47); self.cg_e8(0x08);
          } else {
            self.cg_zeroRax();
          }
        } else {
          self.cg_zeroRax();
        }
      } else {
        self.cg_zeroRax();
      }

    } else if (self.cg_seq(fname, fnlen, pk8, 5)) {
      // poke8(addr, val): mov [rdi], sil
      // WP-BC-48: null-pointer check
      if self.runtimeChecks != 0 {
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);  // test rdi, rdi
        self.cg_e8(0x75);                                         // jnz short .ok
        var pSkipP8: int64 := self.codeLen; self.cg_e8(0);
        var msgP8: int64 := self.dataLen;
        self.cg_edata(110); self.cg_edata(117); self.cg_edata(108);  // nul
        self.cg_edata(108); self.cg_edata(32);  self.cg_edata(112);  // l p
        self.cg_edata(111); self.cg_edata(105); self.cg_edata(110);  // oin
        self.cg_edata(116); self.cg_edata(101); self.cg_edata(114);  // ter
        self.cg_edata(10);  self.cg_edata(0);                         // \n\0
        self.cg_emitLeaRdiData(msgP8);
        self.cg_emitPanicBody();
        poke8(self.code + pSkipP8, self.codeLen - pSkipP8 - 1);
      }
      self.cg_e8(0x40); self.cg_e8(0x88); self.cg_e8(0x37);  // mov [rdi], sil
      self.cg_zeroRax();

    } else if (self.cg_seq(fname, fnlen, gk8, 5)) {
      // peek8(addr): movzx rax, byte [rdi]
      // WP-BC-48: null-pointer check
      if self.runtimeChecks != 0 {
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);  // test rdi, rdi
        self.cg_e8(0x75);                                         // jnz short .ok
        var pSkipG8: int64 := self.codeLen; self.cg_e8(0);
        var msgG8: int64 := self.dataLen;
        self.cg_edata(110); self.cg_edata(117); self.cg_edata(108);  // nul
        self.cg_edata(108); self.cg_edata(32);  self.cg_edata(112);  // l p
        self.cg_edata(111); self.cg_edata(105); self.cg_edata(110);  // oin
        self.cg_edata(116); self.cg_edata(101); self.cg_edata(114);  // ter
        self.cg_edata(10);  self.cg_edata(0);                         // \n\0
        self.cg_emitLeaRdiData(msgG8);
        self.cg_emitPanicBody();
        poke8(self.code + pSkipG8, self.codeLen - pSkipG8 - 1);
      }
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0x07);

    } else if (self.cg_seq(fname, fnlen, pk64, 6)) {
      // poke64(addr, val): mov [rdi], rsi
      // WP-BC-48: null-pointer check
      if self.runtimeChecks != 0 {
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);  // test rdi, rdi
        self.cg_e8(0x75);                                         // jnz short .ok
        var pSkipP64: int64 := self.codeLen; self.cg_e8(0);
        var msgP64: int64 := self.dataLen;
        self.cg_edata(110); self.cg_edata(117); self.cg_edata(108);  // nul
        self.cg_edata(108); self.cg_edata(32);  self.cg_edata(112);  // l p
        self.cg_edata(111); self.cg_edata(105); self.cg_edata(110);  // oin
        self.cg_edata(116); self.cg_edata(101); self.cg_edata(114);  // ter
        self.cg_edata(10);  self.cg_edata(0);                         // \n\0
        self.cg_emitLeaRdiData(msgP64);
        self.cg_emitPanicBody();
        poke8(self.code + pSkipP64, self.codeLen - pSkipP64 - 1);
      }
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x37);
      self.cg_zeroRax();

    } else if (self.cg_seq(fname, fnlen, gk64, 6)) {
      // peek64(addr): mov rax, [rdi]
      // WP-BC-48: null-pointer check
      if self.runtimeChecks != 0 {
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);  // test rdi, rdi
        self.cg_e8(0x75);                                         // jnz short .ok
        var pSkipG64: int64 := self.codeLen; self.cg_e8(0);
        var msgG64: int64 := self.dataLen;
        self.cg_edata(110); self.cg_edata(117); self.cg_edata(108);  // nul
        self.cg_edata(108); self.cg_edata(32);  self.cg_edata(112);  // l p
        self.cg_edata(111); self.cg_edata(105); self.cg_edata(110);  // oin
        self.cg_edata(116); self.cg_edata(101); self.cg_edata(114);  // ter
        self.cg_edata(10);  self.cg_edata(0);                         // \n\0
        self.cg_emitLeaRdiData(msgG64);
        self.cg_emitPanicBody();
        poke8(self.code + pSkipG64, self.codeLen - pSkipG64 - 1);
      }
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x07);

    } else if (self.cg_seq(fname, fnlen, "atomic_load", 11)) {
      // atomic_load(ptr) -> Wert. Auf x86-64 ist ein ausgerichteter 64-Bit-Load
      // bereits atomar; noetig ist nur, dass der Compiler ihn nicht aufteilt.
      // rdi = ptr  ->  mov rax, [rdi]
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x07);

    } else if (self.cg_seq(fname, fnlen, "atomic_store", 12)) {
      // atomic_store(ptr, val) -> alter Wert. xchg mit Speicheroperand ist
      // implizit lock-praefigiert und damit eine volle Barriere.
      // rdi = ptr, rsi = val
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF0);  // mov rax, rsi
      self.cg_e8(0x48); self.cg_e8(0x87); self.cg_e8(0x07);  // xchg [rdi], rax

    } else if (self.cg_seq(fname, fnlen, "atomic_cas", 10)) {
      // atomic_cas(ptr, expected, desired) -> alter Wert.
      // Erfolg ist am Rueckgabewert == expected erkennbar.
      // rdi = ptr, rsi = expected, rdx = desired
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF0);  // mov rax, rsi
      self.cg_e8(0xF0); self.cg_e8(0x48); self.cg_e8(0x0F);
      self.cg_e8(0xB1); self.cg_e8(0x17);                    // lock cmpxchg [rdi], rdx

    } else if (self.cg_seq(fname, fnlen, "atomic_fetch_add", 16)) {
      // atomic_fetch_add(ptr, delta) -> alter Wert.
      // rdi = ptr, rsi = delta
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF0);  // mov rax, rsi
      self.cg_e8(0xF0); self.cg_e8(0x48); self.cg_e8(0x0F);
      self.cg_e8(0xC1); self.cg_e8(0x07);                    // lock xadd [rdi], rax

    } else if (self.cg_seq(fname, fnlen, "fence_sfence", 12)) {
      self.cg_e8(0x0F); self.cg_e8(0xAE); self.cg_e8(0xF8);  // sfence
      self.cg_zeroRax();

    } else if (self.cg_seq(fname, fnlen, "fence_lfence", 12)) {
      self.cg_e8(0x0F); self.cg_e8(0xAE); self.cg_e8(0xE8);  // lfence
      self.cg_zeroRax();

    } else if (self.cg_seq(fname, fnlen, "fence_mfence", 12)) {
      self.cg_e8(0x0F); self.cg_e8(0xAE); self.cg_e8(0xF0);  // mfence
      self.cg_zeroRax();

    } else if (self.cg_seq(fname, fnlen, "pokef64", 7)) {
      // pokef64(addr, val): addr=rdi, val (IEEE754 bits) =rsi → mov qword [rdi], rsi
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x37);
      self.cg_zeroRax();

    } else if (self.cg_seq(fname, fnlen, "peekf64", 7)) {
      // peekf64(addr): addr=rdi → mov rax, qword [rdi]
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x07);

    } else if (self.cg_seq(fname, fnlen, "poke32f", 7)) {
