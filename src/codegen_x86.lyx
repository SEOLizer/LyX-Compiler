  // WP-R9: Capability-IDs aus AST sammeln (scannt alle @capabilities-Annotationen)
  // Setzt lcbsEnabled=1 sobald irgendeine @capabilities-Annotation gefunden wird.
  fn cg_collectCaps(astHead: int64): void {
    var ni: int64 := astHead;
    while ni >= 0 {
      if self.cg_nkind(ni) == 110 {  // SNK_CAPABILITY_ATTR = 110
        self.lcbsEnabled := 1;
        var capDecl: int64 := self.cg_nc0(ni);
        while capDecl >= 0 {
          if self.cg_nkind(capDecl) == 111 {  // SNK_CAPABILITY_DECL = 111
            var path: pchar := self.cg_nsval(capDecl);
            var plen: int64 := self.cg_nslen(capDecl);
            var cid: int64 := seccomp_cap_id_from_path(path, plen);
            if cid >= 0 && self.lcbsCapCount < 64 {
              // Deduplizieren
              var already: int64 := 0;
              var ci: int64 := 0;
              while ci < self.lcbsCapCount {
                if peek64(self.lcbsCapBuf + ci * 8) == cid { already := 1; ci := self.lcbsCapCount; }
                ci += 1;
              }
              if already == 0 {
                poke64(self.lcbsCapBuf + self.lcbsCapCount * 8, cid);
                self.lcbsCapCount += 1;
              }
            }
            // #1173: `path:`-Argument einer fs-Capability einsammeln (7..12).
            // Der Wert ist ein Zeichenkettenliteral; gemerkt wird der Knoten,
            // die Datensektion bekommt ihn spaeter ueber cg_addStr (das
            // entfernt die Anfuehrungszeichen und haengt die 0 an).
            if cid >= 7 && cid <= 12 {
              var fsPathNode: int64 := 0 - 1;
              var fsArgNode: int64 := self.cg_nc0(capDecl);
              while fsArgNode >= 0 {
                var fsKey: pchar := self.cg_nsval(fsArgNode);
                var fsKeyLen: int64 := self.cg_nslen(fsArgNode);
                var fsVal: int64 := self.cg_nc0(fsArgNode);
                if fsKeyLen == 4 && self.cg_seq(fsKey, fsKeyLen, "path"c, 4) != 0 {
                  if fsVal >= 0 && self.cg_nkind(fsVal) == CGN_LIT_STR { fsPathNode := fsVal; }
                }
                fsArgNode := self.cg_nnext(fsArgNode);
              }
              if fsPathNode < 0 {
                // Ohne Pfad bleibt diese Capability unbeschraenkt — die
                // "/"-Regel darf dann nicht entfallen.
                self.lcbsFsCapNoPath := 1;
              } else {
                if self.lcbsFsArgCount < 32 {
                  var fsBase: int64 := self.lcbsFsArgBuf + self.lcbsFsArgCount * 24;
                  poke64(fsBase, cid);
                  poke64(fsBase + 8, fsPathNode);
                  poke64(fsBase + 16, 0);
                  self.lcbsFsArgCount += 1;
                } else {
                  // Mehr Pfade als Plaetze: lieber die breite Regel behalten,
                  // als einen genannten Pfad stillschweigend fallen zu lassen.
                  self.lcbsFsCapNoPath := 1;
                }
              }
            }
            // WP-H12: Hardware-Cap-Argumente separat sammeln (21=GPIO, 22=I2C, 23=SPI, 24=USB)
            if (cid == 21 || cid == 22 || cid == 23 || cid == 24) && self.lcbsHwArgCount < 32 {
              var hwArg0: int64 := 0;
              var hwArg1: int64 := 0;
              var argNode: int64 := self.cg_nc0(capDecl);
              while argNode >= 0 {
                var keyPtr: pchar := self.cg_nsval(argNode);
                var keyLen: int64 := self.cg_nslen(argNode);
                var valNode: int64 := self.cg_nc0(argNode);
                if valNode >= 0 && self.cg_nkind(valNode) == 40 {  // NK_LIT_INT = 40
                  var argVal: int64 := self.cg_nival(valNode);
                  // "pin" [p=112,i=105,n=110] oder "bus" [b=98,u=117,s=115] → arg0
                  if keyLen == 3 && (StrCharAt(keyPtr, 0) & 255) == 112 &&
                     (StrCharAt(keyPtr, 1) & 255) == 105 && (StrCharAt(keyPtr, 2) & 255) == 110 {
                    hwArg0 := argVal;  // pin
                  }
                  if keyLen == 3 && (StrCharAt(keyPtr, 0) & 255) == 98 &&
                     (StrCharAt(keyPtr, 1) & 255) == 117 && (StrCharAt(keyPtr, 2) & 255) == 115 {
                    hwArg0 := argVal;  // bus
                  }
                  // "cs" [c=99,s=115] → arg1
                  if keyLen == 2 && (StrCharAt(keyPtr, 0) & 255) == 99 &&
                     (StrCharAt(keyPtr, 1) & 255) == 115 {
                    hwArg1 := argVal;
                  }
                }
                argNode := self.cg_nnext(argNode);
              }
              // Deduplizieren nach (capId, arg0, arg1) — gerätepfadspezifisch
              var hwAlready: int64 := 0;
              var hwi2: int64 := 0;
              while hwi2 < self.lcbsHwArgCount {
                var hbase: int64 := self.lcbsHwArgBuf + hwi2 * 24;
                if peek64(hbase) == cid && peek64(hbase + 8) == hwArg0 && peek64(hbase + 16) == hwArg1 {
                  hwAlready := 1; hwi2 := self.lcbsHwArgCount;
                }
                hwi2 += 1;
              }
              if hwAlready == 0 {
                var hbase: int64 := self.lcbsHwArgBuf + self.lcbsHwArgCount * 24;
                poke64(hbase,      cid);
                poke64(hbase + 8,  hwArg0);
                poke64(hbase + 16, hwArg1);
                self.lcbsHwArgCount += 1;
              }
            }
          }
          // WP-T13: @fastpath zählen (NK_CAPABILITY_DECL.iVal bit0 = CAP_FLAG_FASTPATH)
          if self.cg_nkind(capDecl) == 111 {
            if (self.cg_nival(capDecl) & 1) != 0 { self.lcbsFastpathCount := self.lcbsFastpathCount + 1; }
          }
          capDecl := self.cg_nnext(capDecl);
        }
      }
      // WP-T13: SNK_IMPORT (=1) ohne grant-Klausel (c1 != NK_GRANT_CLAUSE=114) zählen
      if self.cg_nkind(ni) == 1 {
        var grantNi: int64 := self.cg_nc1(ni);
        var hasGrant: int64 := 0;
        if grantNi >= 0 && self.cg_nkind(grantNi) == 114 { hasGrant := 1; }
        if hasGrant == 0 { self.lcbsMissingGrants := self.lcbsMissingGrants + 1; }
        // #1348: TLS braucht mehr als die naheliegenden Capabilities. Zur
        // Zertifikatspruefung stattet OpenSSL den CA-Store ab (getdents64,
        // stat, lstat, statx) — das haengt an fs.meta, nicht an fs.read.
        // Fehlt es, stirbt der Prozess mitten im Handshake an SIGSYS: kein
        // Rueckgabewert, keine Meldung. Diagnose per Bisektion der
        // Capability-Liste ist zumutbar fuer niemanden, also sagen wir es
        // hier, wo beides bekannt ist: die Importe und die Deklaration.
        var impName: pchar := self.cg_nsval(ni);
        var impLen:  int64 := self.cg_nslen(ni);
        if self.cg_pathHas(impName, impLen, "net.tls"c, 7) != 0
           || self.cg_pathHas(impName, impLen, "net.https"c, 9) != 0 {
          self.lcbsUsesTls := 1;
        }
      }
      ni := self.cg_nnext(ni);
    }

    if self.lcbsEnabled != 0 && self.lcbsUsesTls != 0 {
      var hasMeta: int64 := 0;
      var hasRead: int64 := 0;
      var mi: int64 := 0;
      while mi < self.lcbsCapCount {
        var cv: int64 := peek64(self.lcbsCapBuf + mi * 8);
        if cv == 11 { hasMeta := 1; }   // fs.meta
        if cv == 7  { hasRead := 1; }   // fs.read
        mi += 1;
      }
      if hasMeta == 0 || hasRead == 0 {
        EPrintStrLn("warning: TLS prueft Zertifikate gegen den CA-Store des Systems und braucht dafuer"c);
        EPrintStrLn("         fs.read UND fs.meta (Verzeichnis abstatten: getdents64, stat, lstat, statx)."c);
        EPrintStr("         In der Capability-Liste fehlt: "c);
        if hasRead == 0 { EPrintStr("fs.read "c); }
        if hasMeta == 0 { EPrintStr("fs.meta"c); }
        EPrintStrLn(""c);
        EPrintStrLn("         Ohne sie stirbt der Handshake an SIGSYS, ohne Meldung und ohne Rueckgabewert (#1348)."c);
      }
    }
  }

  // Enthaelt der Modulpfad das Teilstueck `nadel`?
  fn cg_pathHas(hay: pchar, hayLen: int64, nadel: pchar, nadelLen: int64): int64 {
    if hayLen < nadelLen { return 0; }
    var i: int64 := 0;
    while i + nadelLen <= hayLen {
      var j: int64 := 0;
      var gleich: int64 := 1;
      while j < nadelLen {
        if (StrCharAt(hay, i + j) & 255) != (StrCharAt(nadel, j) & 255) { gleich := 0; j := nadelLen; }
        j += 1;
      }
      if gleich != 0 { return 1; }
      i += 1;
    }
    return 0;
  }

  // WP-25.2: Warnung-String in Datensektion schreiben (nur wenn Compat-Modus aktiv)
  fn cg_genCompatWarnSection(): void {
    if self.lcbsCompatMode == 0 { return; }
    var msg: pchar := "WARNUNG: Compat-Modus aktiv -- kein seccomp, kein landlock, kein Proxy!\n"c;
    var msglen: int64 := StrLen(msg);
    self.lcbsCompatWarnOff := self.dataLen;
    self.lcbsCompatWarnLen := msglen;
    var i: int64 := 0;
    while i < msglen {
      self.cg_edata(StrCharAt(msg, i) & 255);
      i += 1;
    }
  }

  // WP-25.2: write(2, warn_str, warn_len) am Anfang von main emittieren
  fn cg_emitCompatWarn(): void {
    if self.lcbsCompatMode == 0 { return; }
    if self.lcbsCompatWarnOff < 0 { return; }
    // mov edi, 2  (stderr)
    self.cg_e8(0xBF); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // lea rsi, [rip + disp32]  → Warnung-String
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, self.lcbsCompatWarnOff, 0, CG_PATCH_STR);
    // mov edx, warn_len
    var wl: int64 := self.lcbsCompatWarnLen;
    self.cg_e8(0xBA);
    self.cg_e8(wl & 255); self.cg_e8((wl >> 8) & 255); self.cg_e8((wl >> 16) & 255); self.cg_e8((wl >> 24) & 255);
    // mov eax, 1  (SYS_write)
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall
    self.cg_e8(0x0F); self.cg_e8(0x05);
  }

  // WP-R9: BPF-Programm in Datensektion schreiben; setzt lcbsBpfDataOff + lcbsBpfCount
  // Nur aufgerufen wenn lcbsEnabled == 1.
  fn cg_genBpfSection(): void {
    if self.lcbsEnabled == 0 { return; }
    if self.lcbsCompatMode != 0 { return; }  // WP-T14: Compat-Modus überspringt seccomp
    seccomp_set_trap_mode(self.lcbsSeccompTrap);   // #1348
    var bpfBuf: int64 := alloc(1024 * 8);   // #1276: siehe SC_BPF_CAP
    var bpfCount: int64 := seccomp_build_filter(self.lcbsCapBuf, self.lcbsCapCount, bpfBuf);
    self.lcbsBpfDataOff := self.dataLen;
    self.lcbsBpfCount   := bpfCount;
    var i: int64 := 0;
    while i < bpfCount * 8 {
      self.cg_edata(peek8(bpfBuf + i));
      i += 1;
    }
    free(bpfBuf, 1024 * 8);
  }

  // WP-R11: Setzt lcbsProxyEnabled wenn Netzwerk-Proxy-Caps vorhanden.
  fn cg_computeProxy(): void {
    if self.lcbsEnabled == 0 { return; }
    if proxy_is_needed(self.lcbsCapBuf, self.lcbsCapCount) {
      self.lcbsProxyEnabled := 1;
    }
  }

  // WP-R11: Generiert Proxy-BPF in Datensektion + reserviert proxy_fd-Slot.
  fn cg_genProxyBpfSection(): void {
    if self.lcbsProxyEnabled == 0 { return; }
    if self.lcbsCompatMode != 0 { return; }  // WP-T14
    var bpfBuf: int64 := alloc(128 * 8);
    var bpfCount: int64 := proxy_build_filter(bpfBuf);
    self.lcbsProxyBpfDataOff := self.dataLen;
    self.lcbsProxyBpfCount   := bpfCount;
    var i: int64 := 0;
    while i < bpfCount * 8 {
      self.cg_edata(peek8(bpfBuf + i));
      i += 1;
    }
    free(bpfBuf, 128 * 8);
    // 4 Bytes für proxy_fd-Speicher (int32, initial 0)
    self.lcbsProxyFdDataOff := self.dataLen;
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);
  }

  // WP-R11: Emittiert den Proxy-Kindprozess-Loop BEVOR main() kompiliert wird.
  // Eintritt: rdi = child_fd (AF_UNIX socketpair-Deskriptor des Kindes).
  // Der Loop:
  //   1. Installiert eigenen restriktiven seccomp-Filter (nur Netzwerk).
  //   2. Liest 8-Byte-Anfragen vom child_fd.
  //   3. Antwortet mit -ENOSYS (noch nicht implementiert bis WP-L1 Pfad-Args parsed).
  //   4. Bei EOF (Elter beendet): exit_group(0).
  fn cg_emitProxyLoop(): void {
    if self.lcbsProxyEnabled == 0 { return; }
    if self.lcbsCompatMode != 0 { return; }  // WP-T14
    self.lcbsProxyCodeOff := self.codeLen;

    // Callee-saved Register retten: r13 (child_fd), r14 (alignment), rbx
    self.cg_e8(0x41); self.cg_e8(0x55);  // push r13
    self.cg_e8(0x41); self.cg_e8(0x56);  // push r14
    self.cg_e8(0x53);                    // push rbx
    // mov r13, rdi  (child_fd sichern, Encoding: 4C 8B EF)
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0xEF);

    // ---- Proxy-seccomp installieren ----
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x10);  // sub rsp, 16
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);                     // xor rax, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);  // mov [rsp+0], rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);
    // mov ax, proxy_bpf_count (uint16)
    var pcnt: int64 := self.lcbsProxyBpfCount & 0xFFFF;
    self.cg_e8(0x66); self.cg_e8(0xB8); self.cg_e8(pcnt & 0xFF); self.cg_e8((pcnt >> 8) & 0xFF);
    self.cg_e8(0x66); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);  // mov [rsp+0], ax
    // lea rax, [rip + proxy_bpf_data]
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
    var ppPBpf: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(ppPBpf, self.lcbsProxyBpfDataOff, 0, CG_PATCH_STR);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);
    // prctl(PR_SET_NO_NEW_PRIVS=38, 1, 0, 0, 0)
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC0);  // xor r8d, r8d
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);  // xor r10d, r10d
    self.cg_e8(0x31); self.cg_e8(0xD2);                     // xor edx, edx
    self.cg_e8(0xBE); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xBF); self.cg_e8(0x26); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xB8); self.cg_e8(0x9D); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // prctl(PR_SET_SECCOMP=22, SECCOMP_MODE_FILTER=2, rsp)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE2);  // mov rdx, rsp
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9d, r9d
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);  // xor r10d, r10d
    self.cg_e8(0xBE); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xBF); self.cg_e8(0x16); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xB8); self.cg_e8(0x9D); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);  // add rsp, 16

    // Anfrage-Puffer (8 Bytes) auf Stack
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x08);  // sub rsp, 8
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);                     // xor rax, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);  // mov [rsp+0], rax

    // ---- Read-Loop ----
    var loopPos: int64 := self.codeLen;
    // read(r13d, rsp, 8)
    self.cg_e8(0xB8); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x44); self.cg_e8(0x89); self.cg_e8(0xEF);  // mov edi, r13d
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE6);  // mov rsi, rsp
    self.cg_e8(0xBA); self.cg_e8(0x08); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
    // jle .exit (rel8, wird unten gepatcht)
    self.cg_e8(0x7E); var jlePos: int64 := self.codeLen; self.cg_e8(0x00);

    // Antwort: -38 (ENOSYS — Proxy-Protokoll noch nicht implementiert bis WP-L1)
    self.cg_e8(0xC7); self.cg_e8(0x04); self.cg_e8(0x24);
    self.cg_e8(0xDA); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);  // [rsp] = -38
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x44); self.cg_e8(0x89); self.cg_e8(0xEF);  // mov edi, r13d
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE6);  // mov rsi, rsp
    self.cg_e8(0xBA); self.cg_e8(0x04); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // jmp .read_loop (backward, rel8)
    self.cg_e8(0xEB);
    self.cg_e8((loopPos - (self.codeLen + 1)) & 0xFF);

    // .exit — patch jle
    cg_patchRel8(self.code, jlePos, self.codeLen);
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x08);  // add rsp, 8
    self.cg_e8(0x5B);                    // pop rbx
    self.cg_e8(0x41); self.cg_e8(0x5E);  // pop r14
    self.cg_e8(0x41); self.cg_e8(0x5D);  // pop r13
    self.cg_e8(0x31); self.cg_e8(0xFF);  // xor edi, edi
    self.cg_e8(0xB8); self.cg_e8(0xE7); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);  // exit_group(0)
  }

  // WP-R11: Emittiert fork+socketpair am Anfang von main().
  // Reihenfolge: ProxyStart → LandlockInit → SeccompInit.
  // Nach dem fork():
  //   Kind: rdi=child_fd → jmp proxy_loop → exit_group(0)
  //   Elter: speichert proxy_fd (sv[1]) in Datensektion
  fn cg_emitProxyStart(): void {
    if self.lcbsProxyEnabled == 0 { return; }
    if self.lcbsCompatMode != 0 { return; }  // WP-T14

    // Stack: sv[2] (2×int = 8 Bytes, aufgefüllt auf 16)
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x10);  // sub rsp, 16
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);                     // xor rax, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);  // mov [rsp+0], rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);

    // socketpair(AF_UNIX=1, SOCK_STREAM=1, 0, &sv)
    self.cg_e8(0xB8); self.cg_e8(0x35); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xBF); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xBE); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x31); self.cg_e8(0xD2);  // xor edx, edx
    self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xE2);  // mov r10, rsp (&sv)
    self.cg_e8(0x0F); self.cg_e8(0x05);
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    self.cg_e8(0x0F); self.cg_e8(0x88);
    var jSkip1: int64 := self.codeLen; self.cg_e32(0);  // js → SKIP_ALL

    // fork() → rax = 0 (Kind) oder pid (Elter)
    self.cg_e8(0xB8); self.cg_e8(0x39); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    self.cg_e8(0x0F); self.cg_e8(0x88);
    var jSkip2: int64 := self.codeLen; self.cg_e32(0);  // js → SKIP_ALL
    // jnz → PARENT (rax != 0: Elter-Prozess)
    self.cg_e8(0x0F); self.cg_e8(0x85);
    var jParent: int64 := self.codeLen; self.cg_e32(0);

    // === KIND: Proxy-Loop starten ===
    // close(sv[1]) = [rsp+4]
    self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x04);
    self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // rdi = sv[0] (child_fd)
    self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24);  // mov edi, [rsp+0]
    // Stack wiederherstellen
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);  // add rsp, 16
    // jmp proxy_loop (Rückwärts-Sprung zu lcbsProxyCodeOff)
    self.cg_e8(0xE9);
    self.cg_e32(self.lcbsProxyCodeOff - (self.codeLen + 4));

    // === ELTER: proxy_fd speichern ===
    poke32(self.code + jParent, self.codeLen - jParent - 4);
    // close(sv[0]) = [rsp+0]
    self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24);
    self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // proxy_fd = sv[1] in Datensektion speichern
    self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x04);  // mov eax, [rsp+4]
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x0D);
    var ppFd: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(ppFd, self.lcbsProxyFdDataOff, 0, CG_PATCH_STR);
    self.cg_e8(0x89); self.cg_e8(0x01);  // mov [rcx], eax

    // SKIP_ALL → add rsp, 16
    poke32(self.code + jSkip1, self.codeLen - jSkip1 - 4);
    poke32(self.code + jSkip2, self.codeLen - jSkip2 - 4);
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);  // add rsp, 16
  }

  // WP-R10: Berechnet Landlock-Bitmasks nach cg_collectCaps().
  fn cg_computeLandlock(): void {
    if self.lcbsEnabled == 0 { return; }
    self.lcbsLandlockHandled    := landlock_compute_handled(self.lcbsCapBuf, self.lcbsCapCount);
    self.lcbsLandlockAllowed    := landlock_compute_allowed(self.lcbsCapBuf, self.lcbsCapCount);
    self.lcbsLandlockHasDev     := 0;
    self.lcbsLandlockDevAllowed := 0;
    if landlock_has_hw(self.lcbsCapBuf, self.lcbsCapCount) {
      self.lcbsLandlockHasDev     := 1;
      self.lcbsLandlockDevAllowed := landlock_compute_dev_allowed(self.lcbsCapBuf, self.lcbsCapCount);
    }
  }

  // WP-H12: Berechnet Gerätepfade für Hardware-Caps und schreibt sie in die Datensektion.
  // Muss VOR cg_genFile() aufgerufen werden; cg_emitLandlockInit() verwendet die Offsets.
  fn cg_genHwDevPathSection(): void {
    if self.lcbsHwArgCount == 0 { return; }
    if self.lcbsCompatMode != 0 { return; }  // WP-T14
    var pathBuf: int64 := alloc(32);
    var hwi: int64 := 0;
    while hwi < self.lcbsHwArgCount {
      var hbase: int64 := self.lcbsHwArgBuf + hwi * 24;
      var capId: int64 := peek64(hbase);
      var arg0:  int64 := peek64(hbase + 8);
      var arg1:  int64 := peek64(hbase + 16);
      var plen:  int64 := hw_path_for(capId, arg0, arg1, pathBuf);
      poke64(self.lcbsHwDevPathOff + hwi * 8, self.dataLen);
      // Pfad + NUL-Terminator in Datensektion schreiben
      var j: int64 := 0;
      while j <= plen {
        self.cg_edata(peek8(pathBuf + j));
        j += 1;
      }
      hwi += 1;
    }
    free(pathBuf, 32);
  }

  // #1173: Die `path:`-Zeichenketten in die Datensektion legen. Muss wie
  // cg_genHwDevPathSection VOR cg_genFile() laufen, weil cg_emitLandlockInit
  // die Offsets braucht.
  fn cg_genFsPathSection(): void {
    if self.lcbsFsArgCount == 0 { return; }
    if self.lcbsCompatMode != 0 { return; }
    var fi: int64 := 0;
    while fi < self.lcbsFsArgCount {
      var fbase: int64 := self.lcbsFsArgBuf + fi * 24;
      var strNode: int64 := peek64(fbase + 8);
      // Nicht cg_addStr: das erwartet die Anfuehrungszeichen und schneidet
      // beidseitig ein Zeichen ab. Ein Capability-Argument speichert die
      // Zeichenkette aber schon OHNE sie (parser.lyx: TokStart+1, TokLen-2) —
      // aus "/tmp" wurde so "tm", openat schlug fehl und es entstand keine
      // Regel. Hier stehen die Bytes also roh, mit angehaengter 0.
      poke64(self.lcbsFsPathOff + fi * 8, self.dataLen);
      var fsOff: int64 := self.cg_nsoff(strNode);
      var fsLen: int64 := self.cg_nslen(strNode);
      var fj: int64 := 0;
      while fj < fsLen {
        self.cg_edata(StrCharAt(self.pSrc, fsOff + fj) & 255);
        fj += 1;
      }
      self.cg_edata(0);
      fi += 1;
    }
  }

  // WP-R10: Emittiert Landlock-Setup-Code am Anfang von main().
  // Reihenfolge: Landlock ZUERST, dann seccomp (Landlock-Syscalls müssen vor seccomp laufen).
  // Stack-Layout (48 Bytes):
  //   [rsp+0]  = landlock_ruleset_attr.handled_access_fs (u64)
  //   [rsp+8]  = path_beneath_attr.allowed_access (u64)
  //   [rsp+16] = path_beneath_attr.parent_fd (s32) + 4 Bytes Padding
  //   [rsp+24] = String-Puffer: '/', '\0', ... (8 Bytes)
  //   [rsp+32] = ruleset_fd (s64)
  //   [rsp+40] = dir_fd (s64)
  // WP-H12: Hardware-Caps erzeugen per-Gerät-Regeln (statt breiter /dev-Regel).
  fn cg_emitLandlockInit(): void {
    if self.lcbsEnabled == 0 { return; }
    if self.lcbsCompatMode != 0 { return; }  // WP-T14

    // sub rsp, 48  (Stack-Frame)
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x30);
    // Zero stack frame: xor rax,rax; dann 6× mov [rsp+N], rax
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);                                      // xor rax, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);                     // [rsp+0]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);  // [rsp+8]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x10);  // [rsp+16]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x18);  // [rsp+24]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x20);  // [rsp+32]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x28);  // [rsp+40]

    // Version-Probe: landlock_create_ruleset(NULL, 0, LANDLOCK_CREATE_RULESET_VERSION=1)
    self.cg_e8(0x31); self.cg_e8(0xFF);                                              // xor edi, edi
    self.cg_e8(0x31); self.cg_e8(0xF6);                                              // xor esi, esi
    self.cg_e8(0xBA); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov edx, 1
    self.cg_e8(0xB8); self.cg_e8(0xBC); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 444
    self.cg_e8(0x0F); self.cg_e8(0x05);                                              // syscall
    // test rax,rax; js rel32 → SKIP_ALL (Kernel < 5.13, kein Landlock)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    self.cg_e8(0x0F); self.cg_e8(0x88);
    var jSkip1: int64 := self.codeLen; self.cg_e32(0);  // Placeholder jump 1

    // handled_access_fs → [rsp+0]
    var hfs: int64 := self.lcbsLandlockHandled;
    self.cg_e8(0xB8);
    self.cg_e8(hfs & 0xFF); self.cg_e8((hfs >> 8) & 0xFF);
    self.cg_e8((hfs >> 16) & 0xFF); self.cg_e8((hfs >> 24) & 0xFF);            // mov eax, hfs
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);    // mov [rsp+0], rax

    // landlock_create_ruleset([rsp], 8, 0) → ruleset_fd
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE7);                       // mov rdi, rsp
    self.cg_e8(0xBE); self.cg_e8(0x08); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov esi, 8
    self.cg_e8(0x31); self.cg_e8(0xD2);                                          // xor edx, edx
    self.cg_e8(0xB8); self.cg_e8(0xBC); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 444
    self.cg_e8(0x0F); self.cg_e8(0x05);                                          // syscall
    // test rax,rax; js rel32 → SKIP_ALL (create_ruleset fehlgeschlagen)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    self.cg_e8(0x0F); self.cg_e8(0x88);
    var jSkip2: int64 := self.codeLen; self.cg_e32(0);  // Placeholder jump 2
    // mov [rsp+32], rax (ruleset_fd speichern)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x20);

    // '/' in [rsp+24] setzen (Rest durch Zeroing bereits 0 → terminiert)
    self.cg_e8(0xC6); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x18); self.cg_e8(0x2F);

    // openat(AT_FDCWD=-100, &[rsp+24], O_PATH=0x200000, 0)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7);
    self.cg_e8(0x9C); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);     // mov rdi, -100
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x18); // lea rsi, [rsp+24]
    self.cg_e8(0xBA); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x20); self.cg_e8(0x00); // mov edx, O_PATH
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);                       // xor r10d, r10d
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 257
    self.cg_e8(0x0F); self.cg_e8(0x05);                                          // syscall
    // test rax,rax; js rel32 → RESTRICT_LABEL (openat "/" fehlgeschlagen)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    self.cg_e8(0x0F); self.cg_e8(0x88);
    var jRestrict3: int64 := self.codeLen; self.cg_e32(0);  // Placeholder jump 3
    // mov [rsp+40], rax (dir_fd = root_fd)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x28);

    // Regel für "/" nur hinzufügen wenn allowed_access != 0
    //
    // #1173: Sie entfaellt genau dann, wenn JEDE fs-Capability einen Pfad
    // nennt — dann treten die Regeln je Pfad an ihre Stelle. Traegt auch nur
    // eine keinen, bleibt sie stehen; andernfalls waere die Sandbox schaerfer
    // als deklariert.
    var rootRuleNeeded: int64 := 1;
    if self.lcbsFsArgCount > 0 && self.lcbsFsCapNoPath == 0 { rootRuleNeeded := 0; }
    if self.lcbsLandlockAllowed != 0 && rootRuleNeeded != 0 {
      var afs: int64 := self.lcbsLandlockAllowed;
      self.cg_e8(0xB8);
      self.cg_e8(afs & 0xFF); self.cg_e8((afs >> 8) & 0xFF);
      self.cg_e8((afs >> 16) & 0xFF); self.cg_e8((afs >> 24) & 0xFF);          // mov eax, allowed_access
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08); // mov [rsp+8], rax
      self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x28);  // mov eax, [rsp+40]
      self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x10);  // mov [rsp+16], eax (parent_fd)
      // landlock_add_rule(ruleset_fd, RULE_PATH_BENEATH=1, &path_beneath, 0)
      self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x20);  // mov edi, [rsp+32]
      self.cg_e8(0xBE); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov esi, 1
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x08); // lea rdx, [rsp+8]
      self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);                    // xor r10d, r10d
      self.cg_e8(0xB8); self.cg_e8(0xBD); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 445
      self.cg_e8(0x0F); self.cg_e8(0x05);                                        // syscall (Fehler ignorieren)
    }

    // close dir_fd (root)
    self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x28);   // mov edi, [rsp+40]
    self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 3
    self.cg_e8(0x0F); self.cg_e8(0x05);                                          // syscall

    // WP-H12: Per-device Landlock-Regeln — eine Regel pro Gerätepfad
    // (spezifischer als WP-R10's breite /dev-Regel)
    var ppDev:    int64 := 0;
    var jDevSkip: int64 := 0;
    var da:       int64 := 0;
    var hwi:      int64 := 0;
    while hwi < self.lcbsHwArgCount {
      // hw_dev_allowed: Gerätedateien (GPIO/I2C/SPI) ohne READ_DIR; USB-Verzeichnis mit READ_DIR
      da := hw_dev_allowed(peek64(self.lcbsHwArgBuf + hwi * 24));
      // openat(AT_FDCWD=-100, devPath, O_PATH=0x200000, 0)
      self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7);
      self.cg_e8(0x9C); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);     // mov rdi, -100
      // lea rsi, [rip+devPath]
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
      ppDev := self.codeLen; self.cg_e32(0);
      self.cg_addPatch(ppDev, peek64(self.lcbsHwDevPathOff + hwi * 8), 0, CG_PATCH_STR);
      self.cg_e8(0xBA); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x20); self.cg_e8(0x00); // mov edx, O_PATH
      self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);                       // xor r10d, r10d
      self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 257
      self.cg_e8(0x0F); self.cg_e8(0x05);                                           // syscall
      // test rax,rax; js rel32 → dev_skip (Gerät nicht vorhanden → graceful überspringen)
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
      self.cg_e8(0x0F); self.cg_e8(0x88);
      jDevSkip := self.codeLen; self.cg_e32(0);
      // mov [rsp+40], rax (dev_fd)
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x28);
      // mov eax, da (allowed_access); mov [rsp+8], rax
      self.cg_e8(0xB8);
      self.cg_e8(da & 0xFF); self.cg_e8((da >> 8) & 0xFF);
      self.cg_e8((da >> 16) & 0xFF); self.cg_e8((da >> 24) & 0xFF);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);
      // mov eax, [rsp+40]; mov [rsp+16], eax (parent_fd = dev_fd)
      self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x28);
      self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x10);
      // landlock_add_rule(ruleset_fd, RULE_PATH_BENEATH=1, &path_beneath, 0)
      self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x20);     // mov edi, [rsp+32]
      self.cg_e8(0xBE); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov esi, 1
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x08); // lea rdx, [rsp+8]
      self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);                       // xor r10d, r10d
      self.cg_e8(0xB8); self.cg_e8(0xBD); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 445
      self.cg_e8(0x0F); self.cg_e8(0x05);                                           // syscall
      // close dev_fd
      self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x28);     // mov edi, [rsp+40]
      self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 3
      self.cg_e8(0x0F); self.cg_e8(0x05);                                           // syscall
      // patch jDevSkip → hier
      poke32(self.code + jDevSkip, self.codeLen - jDevSkip - 4);
      hwi += 1;
    }

    // #1173: Eine Regel je genanntem Pfad. Gleiche Mechanik wie die
    // Geraeteschleife oben, nur mit den Rechten GENAU der Capability, zu der
    // das Argument gehoert. Schlaegt openat fehl (Pfad existiert nicht), wird
    // die Regel nicht angelegt — der Zugriff bleibt damit verboten, das ist
    // das fail-closed, das zum uebrigen LCBS passt.
    var ppFsP:    int64 := 0;
    var jFsSkip:  int64 := 0;
    var fsAllow:  int64 := 0;
    var fsi:      int64 := 0;
    while fsi < self.lcbsFsArgCount {
      fsAllow := landlock_allowed_for_cap(peek64(self.lcbsFsArgBuf + fsi * 24));
      if fsAllow != 0 {
        // openat(AT_FDCWD=-100, path, O_PATH=0x200000, 0)
        self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7);
        self.cg_e8(0x9C); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);     // mov rdi, -100
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);                        // lea rsi, [rip+path]
        ppFsP := self.codeLen; self.cg_e32(0);
        self.cg_addPatch(ppFsP, peek64(self.lcbsFsPathOff + fsi * 8), 0, CG_PATCH_STR);
        self.cg_e8(0xBA); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x20); self.cg_e8(0x00); // mov edx, O_PATH
        self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);                       // xor r10d, r10d
        self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 257
        self.cg_e8(0x0F); self.cg_e8(0x05);                                          // syscall
        // test rax,rax; js rel32 → fs_skip (Pfad nicht vorhanden → keine Regel)
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
        self.cg_e8(0x0F); self.cg_e8(0x88);
        jFsSkip := self.codeLen; self.cg_e32(0);
        // mov [rsp+40], rax (path_fd)
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x28);
        // mov eax, fsAllow; mov [rsp+8], rax
        self.cg_e8(0xB8);
        self.cg_e8(fsAllow & 0xFF); self.cg_e8((fsAllow >> 8) & 0xFF);
        self.cg_e8((fsAllow >> 16) & 0xFF); self.cg_e8((fsAllow >> 24) & 0xFF);
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);
        // mov eax, [rsp+40]; mov [rsp+16], eax (parent_fd = path_fd)
        self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x28);
        self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x10);
        // landlock_add_rule(ruleset_fd, RULE_PATH_BENEATH=1, &path_beneath, 0)
        self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x20);     // mov edi, [rsp+32]
        self.cg_e8(0xBE); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov esi, 1
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x08); // lea rdx, [rsp+8]
        self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);                       // xor r10d, r10d
        self.cg_e8(0xB8); self.cg_e8(0xBD); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 445
        self.cg_e8(0x0F); self.cg_e8(0x05);                                          // syscall
        // close path_fd
        self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x28);     // mov edi, [rsp+40]
        self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 3
        self.cg_e8(0x0F); self.cg_e8(0x05);                                          // syscall
        // patch jFsSkip → hier
        poke32(self.code + jFsSkip, self.codeLen - jFsSkip - 4);
      }
      fsi += 1;
    }

    // RESTRICT_LABEL: patch jRestrict3 → hier
    poke32(self.code + jRestrict3, self.codeLen - jRestrict3 - 4);
    // prctl(PR_SET_NO_NEW_PRIVS=38, 1, 0, 0, 0)
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC0);   // xor r8d, r8d
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);   // xor r10d, r10d
    self.cg_e8(0x31); self.cg_e8(0xD2);                      // xor edx, edx
    self.cg_e8(0xBE); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov esi, 1
    self.cg_e8(0xBF); self.cg_e8(0x26); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov edi, 38
    self.cg_e8(0xB8); self.cg_e8(0x9D); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 157
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // landlock_restrict_self(ruleset_fd, 0)
    self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x20); // mov edi, [rsp+32]
    self.cg_e8(0x31); self.cg_e8(0xF6);                                       // xor esi, esi
    self.cg_e8(0xB8); self.cg_e8(0xBE); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 446
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // close ruleset_fd
    self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x20); // mov edi, [rsp+32]
    self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 3
    self.cg_e8(0x0F); self.cg_e8(0x05);

    // SKIP_ALL: patch jSkip1 und jSkip2 → add rsp, 48
    poke32(self.code + jSkip1, self.codeLen - jSkip1 - 4);
    poke32(self.code + jSkip2, self.codeLen - jSkip2 - 4);
    // add rsp, 48
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x30);
  }

  // WP-R9: Emittiert seccomp-Installation in den Anfang einer Funktion.
  // Wird von cg_genFuncDecl aufgerufen wenn lcbsEnabled && name=="main".
  // Läuft NACH dem Funktions-Prolog (push rbp etc.) aber VOR dem Body.
  fn cg_emitSeccompInit(): void {
    if self.lcbsBpfDataOff < 0 { return; }
    if self.lcbsCompatMode != 0 { return; }  // WP-T14
    // Construct sock_fprog on stack (sub rsp already done by cg_genFuncDecl prolog).
    // We use 16 extra bytes below current rsp; sub rsp,16 first.
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x10);  // sub rsp, 16
    // xor rax, rax; mov [rsp+2..15], 0 (clear padding)
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x02);
    // mov ax, bpfCount (uint16 at [rsp+0])
    var cnt16: int64 := self.lcbsBpfCount & 0xFFFF;
    self.cg_e8(0x66); self.cg_e8(0xB8);
    self.cg_e8(cnt16 & 0xFF); self.cg_e8((cnt16 >> 8) & 0xFF);
    self.cg_e8(0x66); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);  // mov [rsp+0], ax
    // lea rax, [rip+bpfData]
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
    var ppBpf: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(ppBpf, self.lcbsBpfDataOff, 0, CG_PATCH_STR);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);  // mov [rsp+8], rax
    // prctl(PR_SET_NO_NEW_PRIVS=38, 1, 0, 0, 0)
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC0);  // xor r8d, r8d
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);  // xor r10d, r10d
    self.cg_e8(0x31); self.cg_e8(0xD2);                     // xor edx, edx
    self.cg_e8(0xBE); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xBF); self.cg_e8(0x26); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xB8); self.cg_e8(0x9D); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // prctl(PR_SET_SECCOMP=22, SECCOMP_MODE_FILTER=2, rsp)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE2);  // mov rdx, rsp
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9d, r9d
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);  // xor r10d, r10d
    self.cg_e8(0xBE); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xBF); self.cg_e8(0x16); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xB8); self.cg_e8(0x9D); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);  // add rsp, 16
  }

  // WP-T13: Gibt den Security-Audit-Report auf stderr aus.
  // Wird am Ende von Generate() aufgerufen (alle LCBS-Daten bekannt).
  fn cg_runAudit(): void {
    var seccompOk:    int64 := 0;
    var landlockOk:   int64 := 0;
    var landlockRules: int64 := 0;
    var bpfRules:     int64 := 0;
    if self.lcbsCompatMode == 0 {  // WP-T14: Compat-Modus → alles inaktiv
      if self.lcbsBpfDataOff >= 0 { seccompOk := 1; bpfRules := self.lcbsBpfCount; }
      if self.lcbsEnabled != 0 && self.lcbsLandlockHandled != 0 { landlockOk := 1; }
      if self.lcbsLandlockAllowed != 0 { landlockRules := landlockRules + 1; }
      landlockRules += self.lcbsHwArgCount;
    }
    var relroOk: int64 := 0;
    if self.externCount == 0 { relroOk := 1; }
    var score: int64 := audit_compute_score(seccompOk, landlockOk, self.lcbsMissingGrants, self.lcbsFastpathCount, self.lcbsWxActive, relroOk);

    // --- Ausgabe ---
    EPrintStrLn("=== LCBS Security Audit =========================================="c);
    if self.lcbsCompatMode != 0 {
      EPrintStrLn("!!! WARNUNG: Compat-Modus (--capabilities=compat) aktiv         !!!"c);
      EPrintStrLn("!!! seccomp, landlock, Proxy deaktiviert -- kein Laufzeitschutz !!!"c);
      EPrintStrLn(""c);
    }
    EPrintStr("Programm:          "c);
    if self.lcbsAuditSrcPath != 0 as pchar {
      EPrintStrLn(self.lcbsAuditSrcPath);
    } else {
      EPrintStrLn("(unbekannt)"c);
    }
    if self.lcbsEnabled != 0 {
      EPrintStrLn("Capability-Modell: Zero-Privilege (default deny), Grant-basiert"c);
    } else {
      EPrintStrLn("Capability-Modell: NONE (kein @capabilities -- keine LCBS-Haertung)"c);
    }
    EPrintStrLn(""c);

    // Implizite Capabilities
    EPrintStrLn("Implizite Capabilities (immer aktiv):"c);
    EPrintStrLn("  o system.exit         -> exit_group"c);
    EPrintStrLn("  o system.memory.heap  -> brk, mmap(MAP_ANON)"c);
    EPrintStrLn("  o system.rand         -> getrandom (Stack-Canary-Init, WP-24.1)"c);
    EPrintStrLn(""c);

    // Explizite Capabilities
    if self.lcbsEnabled != 0 && self.lcbsCapCount > 0 {
      EPrintStrLn("Explizite Capabilities:"c);
      var ci: int64 := 0;
      while ci < self.lcbsCapCount {
        var cid: int64 := peek64(self.lcbsCapBuf + ci * 8);
        EPrintStr("  + "c);
        EPrintStrLn(audit_cap_name(cid));
        ci += 1;
      }
      EPrintStrLn(""c);
    } else {
      EPrintStrLn("Explizite Capabilities: keine"c);
      EPrintStrLn(""c);
    }

    // Runtime-Schutz
    EPrintStrLn("Runtime-Schutz:"c);
    if self.lcbsWxActive != 0 {
      EPrintStrLn("  + W^X (RX-Code / RW-Daten getrennt — zwei PT_LOAD)"c);
    } else {
      EPrintStrLn("  o W^X (nicht aktiv — Single PT_LOAD RWX)"c);
    }
    if self.externCount == 0 {
      EPrintStrLn("  + RELRO (kein GOT/PLT-Angriffsziel — statisches ELF)"c);
    } else {
      EPrintStrLn("  o RELRO (kein PT_GNU_RELRO — dynamisches ELF, WP-6b offen)"c);
    }
    EPrintStrLn("  o PIE  (nicht aktiv -- statisches ELF, kein ASLR)"c);
    if seccompOk != 0 {
      // #1526: Hier stand die Rueckgabeart als fester Text. Mit --seccomp-trap
      // baut der Filter SECCOMP_RET_TRAP, das Audit behauptete aber weiter
      // KILL_PROCESS — die eine Stelle, an der man den Schalter haette
      // nachpruefen koennen, sagte das Gegenteil.
      if self.lcbsSeccompTrap != 0 {
        EPrintStr("  + seccomp (SECCOMP_RET_TRAP, "c);
      } else {
        EPrintStr("  + seccomp (SECCOMP_RET_KILL_PROCESS, "c);
      }
      EPrintInt(bpfRules);
      EPrintStrLn(" Regeln)"c);
    } else {
      EPrintStrLn("  o seccomp (nicht aktiv)"c);
    }
    if landlockOk != 0 {
      EPrintStr("  + landlock ("c);
      EPrintInt(landlockRules);
      EPrintStrLn(" Pfad-Regeln)"c);
    } else {
      EPrintStrLn("  o landlock (nicht aktiv)"c);
    }
    if self.lcbsProxyEnabled != 0 {
      EPrintStrLn("  + Userspace Proxy (Netzwerk)"c);
    } else {
      EPrintStrLn("  o Userspace Proxy (nicht aktiv)"c);
    }
    EPrintStrLn("  + Stack Canaries (WP-18, #2245: getrandom-Init, Slot rbp-8;\n    gepruefen in Funktionen mit Rahmenpuffer, genommener Adresse oder asm)"c);
    EPrintStrLn(""c);

    // Score — WP-18 adds +5 for stack canaries
    score += 5;
    EPrintStr("Sicherheits-Score: "c);
    EPrintInt(score);
    EPrintStrLn("/45  (PIE +0)"c);
    EPrintStrLn("  +10: Kein Klasse-3-Extern ohne system.unsafe.format_string"c);
    if self.lcbsWxActive != 0 {
      EPrintStrLn("  + 5: W^X aktiv (zwei PT_LOAD: RX + RW)"c);
    } else {
      EPrintStrLn("  + 0: W^X fehlt (Single PT_LOAD RWX — WP-6 offen)"c);
    }
    if self.externCount == 0 {
      EPrintStrLn("  + 5: RELRO (kein GOT/PLT-Angriffsziel — statisch)"c);
    } else {
      EPrintStrLn("  + 0: RELRO fehlt (kein PT_GNU_RELRO — dynamisch)"c);
    }
    EPrintStrLn("  + 0: PIE  (nicht implementiert)"c);
    // #1340: wieder bewertet, siehe audit_compute_score — die Units in `std/`
    // deklarieren ihre Capabilities, also weist die Pruefung ab. Der Punkt
    // steht fuer eine statische Zusicherung, nicht fuer Laufzeit-Eindaemmung.
    if self.lcbsMissingGrants == 0 {
      EPrintStrLn("  +10: Grant-Modell -- alle Imports mit grant, gegen die Modul-Deklaration geprueft"c);
    } else {
      EPrintStr("  + 0: Grant-Modell -- "c); EPrintInt(self.lcbsMissingGrants);
      EPrintStrLn(" Import(e) ohne grant (statische Pruefung entfaellt dort)"c);
    }
    if seccompOk != 0 {
      EPrintStrLn("  + 5: seccomp aktiv"c);
    } else {
      EPrintStrLn("  + 0: seccomp fehlt"c);
    }
    if landlockOk != 0 {
      EPrintStrLn("  + 5: landlock aktiv"c);
    } else {
      EPrintStrLn("  + 0: landlock fehlt"c);
    }
    EPrintStrLn("  + 5: Stack Canaries (WP-18/#2245: getrandom-Init, rbp-8-Slot; Pruefung\n         in Funktionen mit Rahmenpuffer, @-Adresse eines Locals oder asm-Block)"c);
    if self.lcbsFastpathCount > 0 {
      EPrintStr("  -"c); EPrintInt(self.lcbsFastpathCount * 3);
      EPrintStr(": @fastpath x"c); EPrintInt(self.lcbsFastpathCount); EPrintStrLn(""c);
    }
    if self.lcbsCompatMode != 0 {
      EPrintStrLn("  WARNUNG: Compat-Modus -- kein Laufzeitschutz"c);
    }
    EPrintStrLn("=================================================================="c);
  }

  fn Generate(head: int64) {
    self.topLevelHead := head;  // WP-MEM-05: save for default-param lookup
    // WP-R9/R10/R11: collect capabilities, compute masks, generate BPF + proxy data sections
    // cg_emitProxyStart/LandlockInit/SeccompInit() are called later from cg_genFuncDecl
    self.cg_collectCaps(head);
    self.cg_computeProxy();        // WP-R11: Proxy-Bedarf bestimmen
    self.cg_computeLandlock();     // WP-R10: Landlock-Bitmasks
    self.cg_genCompatWarnSection(); // WP-25.2: Compat-Warnung in Datensektion
    self.cg_genProxyBpfSection();  // WP-R11: Proxy-BPF + proxy_fd-Slot in Datensektion
    // #1878: VOR dem BPF — der Filter muss wissen, ob ein Sweep kommt, sonst
    // faellt dessen `setitimer` in den KILL-Zweig.
    self.cg_collectIntegrity(head);
    if (self.scrubSeen != 0) { seccomp_set_scrub(1); }
    self.cg_genBpfSection();       // WP-R9: Haupt-BPF in Datensektion
    self.lcbsBpfDone := 1;
    self.cg_genHwDevPathSection(); // WP-H12: Gerätepfad-Strings in Datensektion
    self.cg_genFsPathSection();    // #1173: fs-Pfad-Strings in Datensektion
    self.cg_emitProxyLoop();       // WP-R11: Proxy-Kind-Loop-Code in Codesektion (vor main)
    var miStartHaupt: int64 := self.miPendN;   // #2136
    self.cg_genFile(head);
    // #2136: die Anfangswerte des Hauptmoduls, danach die Sammelfunktion —
    // alle Units sind jetzt eingelesen.
    self.cg_miEinheit(miStartHaupt);
    self.cg_miSammel();
    // #2134: Spezialisierungen generischer Funktionen — erst jetzt, wenn
    // jede Unit ihre Aufrufe angefordert hat; nach den Anfangswerten (#2136),
    // denn auch ein Anfangswert darf eine generische Funktion rufen.
    self.cg_genEmitPending();
    // #1141: die Bilanz erst hier — cg_genFile laeuft je importierter Einheit
    // erneut, dort gedruckt gaebe es eine Zeile je Import.
    // #1370: --profile — die Berichtsfunktion ganz am Ende, hinter allen
    // uebersetzten Funktionen. Frueher emittiert kaeme sie nur an die bis
    // dahin bekannten Eintraege; der Bericht wird zur Uebersetzungszeit
    // ausgerollt. `main` ruft sie beim Verlassen ueber die Marke.
    if (self.profileAll != 0) {
      self.cg_addLabel("__lyx_profile_report"c, 20, 0);
      self.profCurLen := 0;          // die Berichtsfunktion misst sich nicht selbst
      self.cg_profReportBytes();
      self.cg_e8(0xC3);              // ret
    }

    self.cg_tmrReport();
    // #2124: Bibliothek — Huellen der Exporte und die Init-Funktion hinter
    // allen uebersetzten Funktionen, vor dem Auffuellen.
    if (self.sharedLib != 0) {
      self.cg_soPruefen();
      self.cg_soEmitHuellen(head);
      self.cg_soEmitInit();
    }
    // WP-6: Pad code to 4096-byte boundary so data starts on a page boundary.
    // This allows two PT_LOAD segments: RX (code) and RW (data), no overlap.
    // Padding must happen BEFORE cg_patchAll() so all disp32 patches use
    // the aligned codeLen as the code/data boundary offset.
    // Formula must account for CG_CODE_OFF (176 bytes of ELF headers before code).
    //
    // #2124: In einer Bibliothek auf 16 KiB — der Datenbereich muss auf einer
    // eigenen 16-KiB-Seite beginnen, sonst teilen sich Code und Daten auf
    // einem Geraet mit 16-KiB-Seiten eine Seite (cg_writeELFShared legt den
    // Code auf eine Adresse == CG_CODE_OFF mod 16 KiB).
    var padSeite: int64 := 4096;
    if (self.sharedLib != 0) { padSeite := 16384; }
    var codePad: int64 := (padSeite - ((CG_CODE_OFF + self.codeLen) & (padSeite - 1))) & (padSeite - 1);
    var pi: int64 := 0;
    while pi < codePad {
      self.cg_e8(0x00);  // zero-padding in dead code region
      pi += 1;
    }
    self.cg_bindConFns();   // #1589: con-Namen an ihre Funktionsmarke haengen
    // #1878: Die Tabelle braucht die endgueltige Codelaenge (samt Auffuellung)
    // und muss VOR cg_patchAll stehen — der Zeiger auf sie wird dort gesetzt.
    self.cg_scrubBuildTable();
    self.cg_patchAll();
    // Und die Hashes erst DANACH: vorher stehen die Sprungziele noch nicht im
    // Code, die Pruefsumme waere die einer Zwischenfassung.
    self.cg_scrubFillHashes();
    // BUG-02: Free all temporary mmap buffers after patching is complete
    self.cg_freeAllTempBufs();
    // WP-6/6b: both static and dynamic ELFs emit two PT_LOADs (RX+RW)
    self.lcbsWxActive := 1;
    self.cg_runAudit();            // WP-T13: Security Audit auf stderr
  }

  // LyxOS-Reloc Step 1: statischer ET_EXEC wie WriteELF, ABER phdr-Tabelle am Datei-Ende
  // (e_phoff→Ende, e_phnum=3) + 3. phdr PT_LYXRELOC + Reloc-Table. Code bleibt @CG_CODE_OFF
  // (176) → Producer-RVAs + win64-Vertrag unberührt. WriteELF ist contiguous → rva == file-
  // /vaddr-Offset, keine Übersetzung. Reloc-Table-Format: [count:u64][rva:u64 …] (rva relativ
  // zu CG_ELF_BASE). Kernel: *(load_base + rva) += (load_va − CG_ELF_BASE). Linux ignoriert
  // PT_LYXRELOC (PT_LOOS-Bereich) → läuft unverändert (delta=0 bei Basis CG_ELF_BASE).
  fn cg_writeELFReloc(path: pchar) {
    var totalCode: int64 := self.codeLen;
    var totalData: int64 := self.dataLen;
    var relCount:  int64 := self.baseRelocCount;
    var relBuf:    int64 := self.baseRelocBuf;

    var rwOff:    int64 := CG_CODE_OFF + totalCode;          // data-Start (== vaddr-Offset)
    var relocOff: int64 := rwOff + totalData;               // Reloc-Table nach Data
    var relocSize: int64 := 8 + relCount * 8;               // [count][rva…]
    var phdrOff:  int64 := ((relocOff + relocSize + 7) / 8) * 8;  // 8-aligned phdr-Tabelle
    var fileSize: int64 := phdrOff + 3 * 56;

    var buf: int64 := alloc(fileSize);
    var z: int64 := 0;
    while (z < fileSize) { poke8(buf + z, 0); z := z + 1; }

    // ELF-Header
    poke8(buf, 0x7F); poke8(buf + 1, 69); poke8(buf + 2, 76); poke8(buf + 3, 70);
    poke8(buf + 4, 2); poke8(buf + 5, 1); poke8(buf + 6, 1); poke8(buf + 7, 0);
    poke16(buf + 16, 2);     // ET_EXEC
    poke16(buf + 18, 62);    // EM_X86_64
    poke32(buf + 20, 1);     // e_version
    poke64(buf + 24, CG_ELF_BASE + CG_CODE_OFF);  // e_entry (0x4000b0)
    poke64(buf + 32, phdrOff);                     // e_phoff → Datei-Ende
    poke64(buf + ELF64_EHDR_OFF_SHOFF, 0);
    poke32(buf + 48, 0);
    poke16(buf + 52, 64);    // e_ehsize
    poke16(buf + 54, 56);    // e_phentsize
    poke16(buf + 56, 3);     // e_phnum = 3 (LOAD-RX, LOAD-RW, PT_LYXRELOC)
    poke16(buf + 58, 0); poke16(buf + 60, 0); poke16(buf + 62, 0);

    // Code @ CG_CODE_OFF, Data direkt danach (contiguous)
    memcpy(buf + CG_CODE_OFF, self.code, totalCode);
    memcpy(buf + rwOff, self.data, totalData);

    // Reloc-Table @ relocOff
    poke64(buf + relocOff, relCount);
    var ri: int64 := 0;
    while (ri < relCount) {
      poke64(buf + relocOff + 8 + ri * 8, peek64(relBuf + ri * 8));
      ri += 1;
    }

    // phdr-Tabelle @ phdrOff
    var rxSize: int64 := CG_CODE_OFF + totalCode;
    var ph: int64 := buf + phdrOff;
    // PT_LOAD #1 RX: ELF-Header + Code
    poke32(ph, 1); poke32(ph + 4, 5);
    poke64(ph + ELF64_PHDR_OFF_OFFSET, 0);
    poke64(ph + 16, CG_ELF_BASE); poke64(ph + 24, CG_ELF_BASE);
    poke64(ph + ELF64_PHDR_OFF_FILESZ, rxSize);
    poke64(ph + ELF64_PHDR_OFF_MEMSZ,  rxSize);
    poke64(ph + ELF64_PHDR_OFF_ALIGN,  4096);
    // PT_LOAD #2 RW: Data + Reloc-Table (Kernel lädt Reloc-Table mit)
    var ph2: int64 := buf + phdrOff + 56;
    var rwSpan: int64 := totalData + relocSize;
    poke32(ph2, 1); poke32(ph2 + 4, 6);
    poke64(ph2 + ELF64_PHDR_OFF_OFFSET, rwOff);
    poke64(ph2 + 16, CG_ELF_BASE + rwOff); poke64(ph2 + 24, CG_ELF_BASE + rwOff);
    poke64(ph2 + ELF64_PHDR_OFF_FILESZ, rwSpan);
    poke64(ph2 + ELF64_PHDR_OFF_MEMSZ,  rwSpan);
    poke64(ph2 + ELF64_PHDR_OFF_ALIGN,  4096);
    // PT_LYXRELOC: Reloc-Table-Deskriptor (p_type 0x6FFFAA00)
    var ph3: int64 := buf + phdrOff + 112;
    poke32(ph3, 0x6FFFAA00); poke32(ph3 + 4, 4);   // p_flags = PF_R
    poke64(ph3 + ELF64_PHDR_OFF_OFFSET, relocOff);
    poke64(ph3 + 16, CG_ELF_BASE + relocOff); poke64(ph3 + 24, CG_ELF_BASE + relocOff);
    poke64(ph3 + ELF64_PHDR_OFF_FILESZ, relocSize);
    poke64(ph3 + ELF64_PHDR_OFF_MEMSZ,  relocSize);
    poke64(ph3 + ELF64_PHDR_OFF_ALIGN,  8);

    EmitWriteFile(path, buf, fileSize);   // #1682: schreibt oder scheitert laut
  }

  // WSP-07: nlen Bytes von ptr nach buf+off kopieren + Null-Terminator. Gibt off+nlen+1.
  fn cg_objPutName(buf: int64, off: int64, ptr: int64, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < nlen) { poke8(buf + off + i, peek8(ptr + i)); i := i + 1; }
    poke8(buf + off + nlen, 0);
    return off + nlen + 1;
  }

  // WSP-07: relocatable ELF-Objekt (ET_REL) für `extern "asm"`. Eine Section .ltext =
  // code||data (interne Refs sind RIP-relativ → reloc-invariant bei einem Block). baseRelocs
  // (VMT/Klassen-Zeiger) → R_X86_64_64 gegen .ltext-Section-Symbol; extern-"asm"-Nutzungen →
  // R_X86_64_PC32 gegen UNDEF-Symbol. Auflösung via `ld -T script.ld obj.o stub.o`.
  fn cg_writeELFObj(path: pchar) {
    var codeSz: int64 := self.codeLen;
    var dataSz: int64 := self.dataLen;
    var ltextSize: int64 := codeSz + dataSz;

    // EXTERN_DATA-Patches zählen (jede Nutzung = eine Reloc).
    var edPatch: int64 := 0;
    var pc: int64 := 0;
    while (pc < self.patchCount) {
      if (peek64(self.patches + pc * CG_PATCH_SZ + CG_PATCH_OFF_KIND) == CG_PATCH_EXTERN_DATA) {
        edPatch += 1;
      }
      pc += 1;
    }

    var symCount:  int64 := 3 + self.externDataCount;   // null, .ltext-Section, _start, externs
    var relaCount: int64 := self.baseRelocCount + edPatch;

    // .strtab-Größe: null + "_start\0" + je extern-Name+null
    var strtabSize: int64 := 1 + 7;
    var es: int64 := 0;
    while (es < self.externDataCount) {
      strtabSize := strtabSize + peek64(self.externData + es * 16 + 8) + 1;
      es += 1;
    }
    var shstrtabSize: int64 := 45;   // "\0.ltext\0.symtab\0.strtab\0.rela.text\0.shstrtab\0"

    // Datei-Layout
    var ltextOff:   int64 := 64;
    var symtabOff:  int64 := ((ltextOff + ltextSize + 7) / 8) * 8;
    var symtabSize: int64 := symCount * 24;
    var strtabOff:  int64 := symtabOff + symtabSize;
    var relaOff:    int64 := ((strtabOff + strtabSize + 7) / 8) * 8;
    var relaSize:   int64 := relaCount * 24;
    var shstrOff:   int64 := relaOff + relaSize;
    var shTableOff: int64 := ((shstrOff + shstrtabSize + 7) / 8) * 8;
    var fileSize:   int64 := shTableOff + 6 * 64;

    var buf: int64 := alloc(fileSize);
    var z: int64 := 0;
    while (z < fileSize) { poke8(buf + z, 0); z := z + 1; }

    // ELF64-Header (ET_REL)
    poke8(buf, 0x7F); poke8(buf + 1, 69); poke8(buf + 2, 76); poke8(buf + 3, 70);
    poke8(buf + 4, 2); poke8(buf + 5, 1); poke8(buf + 6, 1); poke8(buf + 7, 0);
    poke16(buf + 16, 1);     // ET_REL
    poke16(buf + 18, 62);    // EM_X86_64
    poke32(buf + 20, 1);     // e_version
    poke64(buf + 24, 0);     // e_entry
    poke64(buf + 32, 0);     // e_phoff
    poke64(buf + ELF64_EHDR_OFF_SHOFF, shTableOff);
    poke32(buf + 48, 0);
    poke16(buf + 52, 64);    // e_ehsize
    poke16(buf + 54, 56);    // e_phentsize
    poke16(buf + 56, 0);     // e_phnum
    poke16(buf + 58, 64);    // e_shentsize
    poke16(buf + 60, 6);     // e_shnum
    poke16(buf + 62, 5);     // e_shstrndx → .shstrtab

    // .ltext = code || data
    memcpy(buf + ltextOff, self.code, codeSz);
    memcpy(buf + ltextOff + codeSz, self.data, dataSz);

    // .strtab (Namen + Offsets sammeln)
    poke8(buf + strtabOff, 0);
    var startNameOff: int64 := 1;
    var wo: int64 := self.cg_objPutName(buf, strtabOff + 1, "_start"c as int64, 6);
    var edNameOff: int64 := alloc((self.externDataCount + 1) * 8);
    var em: int64 := 0;
    while (em < self.externDataCount) {
      poke64(edNameOff + em * 8, wo - strtabOff);
      wo := self.cg_objPutName(buf, wo, peek64(self.externData + em * 16),
                               peek64(self.externData + em * 16 + 8));
      em += 1;
    }

    // .symtab
    // sym 0 = null (schon 0). sym 1 = .ltext-Section-Symbol (LOCAL, STT_SECTION)
    var s1: int64 := buf + symtabOff + 24;
    poke16(s1 + 6, 1);                 // st_shndx = .ltext
    poke8(s1 + 4, 3);                  // st_info = STB_LOCAL<<4 | STT_SECTION
    // sym 2 = _start (GLOBAL, STT_FUNC) @ .ltext:0
    var s2: int64 := buf + symtabOff + 48;
    poke32(s2, startNameOff);
    poke8(s2 + 4, (1 << 4) | 2);       // STB_GLOBAL<<4 | STT_FUNC
    poke16(s2 + 6, 1);                 // .ltext
    // sym 3.. = extern-data UNDEF (GLOBAL, STT_NOTYPE)
    var ek: int64 := 0;
    while (ek < self.externDataCount) {
      var sk: int64 := buf + symtabOff + (3 + ek) * 24;
      poke32(sk, peek64(edNameOff + ek * 8));
      poke8(sk + 4, (1 << 4) | 0);     // STB_GLOBAL<<4 | STT_NOTYPE
      poke16(sk + 6, 0);               // SHN_UNDEF
      ek += 1;
    }

    // .rela.text
    var ro: int64 := relaOff;
    var bi: int64 := 0;
    while (bi < self.baseRelocCount) {
      var rva: int64 := peek64(self.baseRelocBuf + bi * 8);
      var loc: int64 := rva - CG_CODE_OFF;                          // Offset in .ltext
      var storedVal: int64 := peek64(buf + ltextOff + loc);
      poke64(ro + buf, loc);                                        // r_offset
      poke64(buf + ro + 8, (1 << 32) | 1);                          // r_info: sym=1(.ltext), R_X86_64_64
      poke64(buf + ro + 16, storedVal - CG_ELF_BASE - CG_CODE_OFF); // r_addend = Ziel-Offset in .ltext
      ro += 24;
      bi += 1;
    }
    var pj: int64 := 0;
    while (pj < self.patchCount) {
      var pb: int64 := self.patches + pj * CG_PATCH_SZ;
      if (peek64(pb + CG_PATCH_OFF_KIND) == CG_PATCH_EXTERN_DATA) {
        var coff: int64 := peek64(pb);
        var edi: int64 := self.cg_findExternDataIdx(peek64(pb + CG_PATCH_OFF_NAMEPTR) as pchar,
                                                    peek64(pb + CG_PATCH_OFF_NAMELEN));
        var symIdx: int64 := 3 + edi;
        poke64(buf + ro, coff);                                     // r_offset (code@0 in .ltext)
        poke64(buf + ro + 8, (symIdx << 32) | 2);                   // R_X86_64_PC32 gegen UNDEF-Sym
        poke64(buf + ro + 16, 0 - 4);                               // r_addend = -4
        ro += 24;
      }
      pj += 1;
    }

    // .shstrtab
    poke8(buf + shstrOff, 0);
    self.cg_objPutName(buf, shstrOff + 1,  ".ltext"c as int64, 6);
    self.cg_objPutName(buf, shstrOff + 8,  ".symtab"c as int64, 7);
    self.cg_objPutName(buf, shstrOff + 16, ".strtab"c as int64, 7);
    self.cg_objPutName(buf, shstrOff + 24, ".rela.text"c as int64, 10);
    self.cg_objPutName(buf, shstrOff + 35, ".shstrtab"c as int64, 9);

    // Section-Header-Tabelle (6 × 64)
    // sh 0 = NULL (schon 0)
    var sh1: int64 := buf + shTableOff + 64;    // .ltext
    poke32(sh1, 1); poke32(sh1 + 4, 1);                // SHT_PROGBITS
    poke64(sh1 + 8, 7);                                // ALLOC|WRITE|EXECINSTR
    poke64(sh1 + 24, ltextOff); poke64(sh1 + 32, ltextSize);
    poke64(sh1 + 48, 16);
    var sh2: int64 := buf + shTableOff + 128;   // .symtab
    poke32(sh2, 8); poke32(sh2 + 4, 2);                // SHT_SYMTAB
    poke64(sh2 + 24, symtabOff); poke64(sh2 + 32, symtabSize);
    poke32(sh2 + 40, 3); poke32(sh2 + 44, 2);          // link=.strtab, info=first-global(2)
    poke64(sh2 + 48, 8); poke64(sh2 + 56, 24);
    var sh3: int64 := buf + shTableOff + 192;   // .strtab
    poke32(sh3, 16); poke32(sh3 + 4, 3);               // SHT_STRTAB
    poke64(sh3 + 24, strtabOff); poke64(sh3 + 32, strtabSize);
    poke64(sh3 + 48, 1);
    var sh4: int64 := buf + shTableOff + 256;   // .rela.text
    poke32(sh4, 24); poke32(sh4 + 4, 4);               // SHT_RELA
    poke64(sh4 + 8, 0x40);                             // SHF_INFO_LINK
    poke64(sh4 + 24, relaOff); poke64(sh4 + 32, relaSize);
    poke32(sh4 + 40, 2); poke32(sh4 + 44, 1);          // link=.symtab, info=.ltext
    poke64(sh4 + 48, 8); poke64(sh4 + 56, 24);
    var sh5: int64 := buf + shTableOff + 320;   // .shstrtab
    poke32(sh5, 35); poke32(sh5 + 4, 3);               // SHT_STRTAB
    poke64(sh5 + 24, shstrOff); poke64(sh5 + 32, shstrtabSize);
    poke64(sh5 + 48, 1);

    EmitWriteFile(path, buf, fileSize);   // #1682: schreibt oder scheitert laut
  }

  // ==================================================================
  // #2124: gemeinsame Bibliothek (ET_DYN) fuer x86-64 / android-x86_64
  // ==================================================================

  // Was eine Bibliothek nicht leisten kann, wird hier gemeldet statt still
  // weggelassen. Alle vier haengen an `main`, das in einer .so nie laeuft.
  fn cg_soPruefen() {
    if (self.lcbsEnabled != 0) {
      // seccomp/Landlock/Proxy wirken auf den ganzen PROZESS. In einer
      // Bibliothek waere das der Host (die App, die JVM) — ein Filter fuer
      // die Faehigkeiten der Bibliothek wuerde ihn mitsperren. Installiert
      // wird er in main (cg_genFuncDecl), das hier nie gerufen wird; die
      // Angabe bliebe also still wirkungslos.
      EPrintStrLn("error: --shared: @capabilities kann eine Bibliothek nicht durchsetzen — seccomp/Landlock wirken auf den ganzen Host-Prozess (#2124)."c);
      exit(1);
    }
    if (self.fcSeen != 0) {
      EPrintStrLn("error: --shared: @flight_crit braucht den SIGFPE-Handler aus main — in einer Bibliothek gibt es kein main (#2124)."c);
      exit(1);
    }
    if (self.scrubSeen != 0) {
      EPrintStrLn("error: --shared: @integrity(mode: scrubbed) braucht Zeitgeber und Handler aus main — in einer Bibliothek gibt es kein main (#2124)."c);
      exit(1);
    }
    if (self.profileAll != 0) {
      EPrintStrLn("error: --shared: --profile schreibt seinen Bericht am Ende von main — in einer Bibliothek gibt es kein main (#2124)."c);
      exit(1);
    }
  }

  // Aufrufklasse eines Parameter- oder Rueckgabetyps nach SysV:
  // 0 = Ganzzahl/Zeiger, 1 = double, 2 = float. Lyx fuehrt f32 und
  // Einheitentypen intern als f64-Bits — dieselbe Einteilung wie
  // cg_ffiArgClass fuer den umgekehrten Weg (Lyx ruft C), dazu die
  // Einheitentypen, die dort nicht vorkommen.
  fn cg_soKlasse(typeNi: int64): int64 {
    if (typeNi < 0) { return 0; }
    var k: int64 := self.cg_ffiArgClass(typeNi);
    if (k != 0) { return k; }
    var tl: int64 := self.cg_nslen(typeNi);
    if (tl <= 0) { return 0; }
    if (self.cg_isFloatTypeName(self.cg_nsval(typeNi), tl) != 0) { return 1; }
    return 0;
  }

  // `extern fn ... link "x"` — dieselbe Pruefung wie cg_genFile (c3 traegt
  // die Bibliothek, einen Rumpf gibt es nicht) und wie _shlibIstExtern im
  // Treiber; die drei muessen uebereinstimmen.
  fn cg_soIstExtern(ni: int64): int64 {
    if (self.cg_nc3(ni) == -1) { return 0; }
    var rumpf: int64 := self.cg_nc2(ni);
    if (rumpf == -1) { return 1; }
    if (self.cg_nkind(rumpf) == CGN_CAPABILITY_ATTR) { return 1; }
    return 0;
  }

  // Je @export/@jni-Funktion der Hauptdatei eine Huelle. Dieselbe Auswahl wie
  // buildExportList im Treiber (oberste Ebene, kein extern); der Treiber
  // findet die Huelle ueber den KNOTEN und meldet laut, wenn eine fehlt.
  fn cg_soEmitHuellen(head: int64) {
    var n: int64 := 0;
    var cur: int64 := head;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_FUNC_DECL && self.cg_soIstExtern(cur) == 0) {
        if ((self.cg_nival(cur) & (ANNO_EXPORT_FN | ANNO_JNI)) != 0) { n := n + 1; }
      }
      cur := self.cg_nnext(cur);
    }
    self.soExpTab   := alloc((n + 1) * 16);
    self.soExpCount := 0;
    cur := head;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_FUNC_DECL && self.cg_soIstExtern(cur) == 0) {
        if ((self.cg_nival(cur) & (ANNO_EXPORT_FN | ANNO_JNI)) != 0) {
          poke64(self.soExpTab + self.soExpCount * 16, cur);
          poke64(self.soExpTab + self.soExpCount * 16 + 8, self.codeLen);
          self.soExpCount := self.soExpCount + 1;
          self.cg_soEmitHuelle(cur);
        }
      }
      cur := self.cg_nnext(cur);
    }
  }

  fn cg_soMeldeFn(ni: int64, was: pchar) {
    EPrintStr("error: --shared: exportierte Funktion `"c);
    sys_write(2, self.cg_nsval(ni) as int64, self.cg_nslen(ni));
    EPrintStr("`: "c);
    EPrintStrLn(was);
    exit(1);
  }

  // [rsp+disp32] als ModRM/SIB mit Registerfeld reg (0..7).
  fn cg_soRspDisp(reg: int64, disp: int64) {
    self.cg_e8(0x84 | ((reg & 7) << 3)); self.cg_e8(0x24); self.cg_e32(disp);
  }

  // Die Huelle uebersetzt zwischen dem Aufrufer (C/ART, SysV) und der Lyx-
  // Konvention:
  //   - rbx, rbp, r12-r15 sind fuer den Aufrufer callee-saved. Der Codegen
  //     benutzt rbx frei (cg_popRbx und die Stapelargumente in
  //     cg_genCall); die Huelle rettet alle sechs, statt sich auf eine Liste
  //     zu verlassen, die mit dem naechsten Befehl veraltet.
  //   - Lyx erwartet den i-ten Parameter in der i-ten Ganzzahlposition
  //     (rdi..r9, ab dem siebten auf dem Stapel), auch Gleitkommawerte als
  //     Bitmuster. SysV verteilt Ganzzahlen und Gleitkomma auf getrennte
  //     Reihen (6 GP, 8 xmm), der Rest geht in Parameterreihenfolge auf den
  //     Stapel. Die Huelle legt alle Eingangsregister ab und baut daraus die
  //     Lyx-Reihe; f32 kommt als single und wird zu double erweitert.
  //   - Rueckgabe: Gleitkomma in xmm0 (f32 wieder als single).
  // Rahmen: E = rsp beim Eintritt (E = 8 mod 16). Nach sechs push und
  // `sub rsp, A` gilt rsp = E-48-A; A = 8 mod 16 haelt den Aufruf ausgerichtet.
  //   [rsp + 0 .. 8k)        Stapelargumente fuer Lyx (k = n-6)
  //   [rsp + S .. S+48)      rdi rsi rdx rcx r8 r9   (S = 8k)
  //   [rsp + S+48 .. S+112)  xmm0..xmm7
  //   [rsp + 56+A + 8c]      c-tes Stapelargument des Aufrufers
  fn cg_soEmitHuelle(ni: int64) {
    var fname: pchar := self.cg_nsval(ni);
    var fnlen: int64 := self.cg_nslen(ni);
    if (self.cg_findLabel(fname, fnlen) < 0) { self.cg_soMeldeFn(ni, "keine Funktionsmarke (#2124)."c); }
    var retTy: int64 := self.cg_nc1(ni);
    if (self.cg_typeIstWertStruct(retTy) != 0) {
      self.cg_soMeldeFn(ni, "Struct-Rueckgabe nach Wert ist an der C-Schnittstelle nicht umgesetzt (#2124)."c);
    }
    var n: int64 := 0;
    var p: int64 := self.cg_nc0(ni);
    while (p != -1) { n := n + 1; p := self.cg_nnext(p); }
    var kl: int64 := alloc((n + 1) * 8);
    var qu: int64 := alloc((n + 1) * 8);   // Quelle als Abstand zu rsp (siehe oben)
    var k: int64 := 0;
    if (n > 6) { k := n - 6; }
    var S: int64 := 8 * k;
    var A: int64 := S + 112;
    if ((A & 15) == 0) { A := A + 8; }
    var gi: int64 := 0;
    var fi: int64 := 0;
    var ci: int64 := 0;
    var i: int64 := 0;
    p := self.cg_nc0(ni);
    while (p != -1) {
      var pt: int64 := self.cg_nc0(p);
      if (self.cg_typeIstWertStruct(pt) != 0) {
        self.cg_soMeldeFn(ni, "Struct-Parameter nach Wert sind an der C-Schnittstelle nicht umgesetzt (#2124)."c);
      }
      var c: int64 := self.cg_soKlasse(pt);
      poke64(kl + i * 8, c);
      if (c == 0) {
        if (gi < 6) { poke64(qu + i * 8, S + 8 * gi); gi := gi + 1; }
        else { poke64(qu + i * 8, 56 + A + 8 * ci); ci := ci + 1; }
      } else {
        if (fi < 8) { poke64(qu + i * 8, S + 48 + 8 * fi); fi := fi + 1; }
        else { poke64(qu + i * 8, 56 + A + 8 * ci); ci := ci + 1; }
      }
      i := i + 1;
      p := self.cg_nnext(p);
    }

    // push rbx; push rbp; push r12; push r13; push r14; push r15
    // #2135: Die Huelle hat keinen rbp-Rahmen — ihre Abwickelangaben folgen
    // rsp Befehl fuer Befehl (DWARF-Register: rbx 3, rbp 6, r12..r15 12..15).
    // Eigene Marke "__lyx_so_huelle_<Name>": sonst rechnete --debug die Huelle
    // der zuletzt erzeugten Funktion zu (DWARF-Bereich bis zur naechsten Marke).
    var hlLen: int64 := 16 + fnlen;
    var hl: int64 := alloc(hlLen + 1);
    memcpy(hl, "__lyx_so_huelle_"c as int64, 16);
    memcpy(hl + 16, fname as int64, fnlen);
    poke8(hl + hlLen, 0);
    self.cg_addLabel(hl as pchar, hlLen, 0);
    self.cg_cfi(CFI_FN, 0);
    self.cg_e8(0x53); self.cg_cfi(CFI_CFA_OFF, 16); self.cg_cfi(CFI_SICHER, 3 | (2 << 8));
    self.cg_e8(0x55); self.cg_cfi(CFI_CFA_OFF, 24); self.cg_cfi(CFI_SICHER, 6 | (3 << 8));
    self.cg_e8(0x41); self.cg_e8(0x54); self.cg_cfi(CFI_CFA_OFF, 32); self.cg_cfi(CFI_SICHER, 12 | (4 << 8));
    self.cg_e8(0x41); self.cg_e8(0x55); self.cg_cfi(CFI_CFA_OFF, 40); self.cg_cfi(CFI_SICHER, 13 | (5 << 8));
    self.cg_e8(0x41); self.cg_e8(0x56); self.cg_cfi(CFI_CFA_OFF, 48); self.cg_cfi(CFI_SICHER, 14 | (6 << 8));
    self.cg_e8(0x41); self.cg_e8(0x57); self.cg_cfi(CFI_CFA_OFF, 56); self.cg_cfi(CFI_SICHER, 15 | (7 << 8));
    self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC); self.cg_e32(A);   // sub rsp, A
    self.cg_cfi(CFI_CFA_OFF, 56 + A);
    var g: int64 := 0;
    while (g < 6) {                                 // mov [rsp+S+8g], <GP g>
      var r: int64 := self.cg_ffiIntReg(g);
      if (r >= 8) { self.cg_e8(0x4C); } else { self.cg_e8(0x48); }
      self.cg_e8(0x89);
      self.cg_soRspDisp(r, S + 8 * g);
      g := g + 1;
    }
    var x: int64 := 0;
    while (x < 8) {                                 // movq [rsp+S+48+8x], xmm_x
      self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0xD6);
      self.cg_soRspDisp(x, S + 48 + 8 * x);
      x := x + 1;
    }
    i := 0;
    while (i < n) {
      var d: int64 := peek64(qu + i * 8);
      if (peek64(kl + i * 8) == 2) {
        self.cg_e8(0xF3); self.cg_e8(0x0F); self.cg_e8(0x5A); self.cg_soRspDisp(0, d);       // cvtss2sd xmm0, [rsp+d]
        self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC0);  // movq rax, xmm0
      } else {
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_soRspDisp(0, d);                         // mov rax, [rsp+d]
      }
      if (i < 6) {
        var rz: int64 := self.cg_ffiIntReg(i);
        if (rz >= 8) { self.cg_e8(0x49); } else { self.cg_e8(0x48); }
        self.cg_e8(0x89); self.cg_e8(0xC0 | (rz & 7));                                       // mov <GP i>, rax
      } else {
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_soRspDisp(0, 8 * (i - 6));              // mov [rsp+8(i-6)], rax
      }
      i := i + 1;
    }
    self.cg_e8(0xE8);                               // call <Funktion>
    var pc: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pc, fname as int64, fnlen, CG_PATCH_CALL);
    var rk: int64 := self.cg_soKlasse(retTy);
    if (rk != 0) {
      self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x6E); self.cg_e8(0xC0);  // movq xmm0, rax
      if (rk == 2) { self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x5A); self.cg_e8(0xC0); }  // cvtsd2ss xmm0, xmm0
    }
    self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xC4); self.cg_e32(A);   // add rsp, A
    self.cg_cfi(CFI_CFA_OFF, 56);
    // pop r15; pop r14; pop r13; pop r12; pop rbp; pop rbx; ret
    self.cg_e8(0x41); self.cg_e8(0x5F); self.cg_cfi(CFI_CFA_OFF, 48);
    self.cg_e8(0x41); self.cg_e8(0x5E); self.cg_cfi(CFI_CFA_OFF, 40);
    self.cg_e8(0x41); self.cg_e8(0x5D); self.cg_cfi(CFI_CFA_OFF, 32);
    self.cg_e8(0x41); self.cg_e8(0x5C); self.cg_cfi(CFI_CFA_OFF, 24);
    self.cg_e8(0x5D); self.cg_cfi(CFI_CFA_OFF, 16);
    self.cg_e8(0x5B); self.cg_cfi(CFI_CFA_OFF, 8);
    self.cg_e8(0xC3);
    self.cg_cfi(CFI_ENDE, 0);
    free(kl, (n + 1) * 8);
    free(qu, (n + 1) * 8);
  }

  // ------------------------------------------------------------------
  // #2136: Anfangswerte von Modulvariablen zur Laufzeit
  //
  // Bis 1.2.15A wies der x86-Weg jeden Anfangswert ab, der sich nicht zur
  // Uebersetzungszeit in den Datenbereich legen liess ("Startwert ist zur
  // Uebersetzungszeit nicht bekannt") — ein Aufruf, eine andere
  // Modulvariable, ein Laufzeit-Element in einem Array-Literal. Der IR-Weg
  // kann es seit #2123. Hier dieselbe Form: je Unit eine Funktion
  // `__lyx_modinit_<n>` in Deklarationsreihenfolge, erzeugt am Ende ihres
  // cg_genFile (eine importierte Unit ist also vor dem Importeur fertig), und
  // die Sammelfunktion `__lyx_modinit`, die sie in dieser Reihenfolge ruft.
  // ------------------------------------------------------------------

  // Eine Deklaration aus CGN_VAR_DECL (cg_genFile) vormerken.
  fn cg_miVormerken(decl: int64) {
    if (self.miMainFertig != 0 && self.miMainRuft == 0 && self.sharedLib == 0) {
      // main ist schon erzeugt und ruft die Anfangswerte nicht: das geht nur,
      // wenn die Unit erst HINTER main eingelesen wird. Laut, statt den Wert
      // still auf 0 stehen zu lassen.
      EPrintStr("codegen error: Modulvariable '"c);
      sys_write(2, self.cg_nsval(decl) as int64, self.cg_nslen(decl));
      EPrintStrLn("' braucht einen Anfangswert zur Laufzeit (#2136),"c);
      EPrintStrLn("  aber main ist schon ohne den Aufruf der Anfangswerte erzeugt — ihre Unit"c);
      EPrintStrLn("  wird erst hinter main importiert. Den Import vor main stellen."c);
      exit(1);
    }
    if (self.miPendN >= self.miPendCap) {
      var nc: int64 := self.miPendCap * 2;
      var nb: int64 := alloc(nc * 8);
      memcpy(nb, self.miPendBuf, self.miPendN * 8);
      self.miPendBuf := nb;
      self.miPendCap := nc;
    }
    poke64(self.miPendBuf + self.miPendN * 8, decl);
    self.miPendN := self.miPendN + 1;
  }

  // Braucht die Modulvariable `d` einen Anfangswert zur Laufzeit? Die Frage
  // stellt cg_miMainBraucht fuer Deklarationen HINTER main, bevor der
  // Hauptdurchlauf dort ankommt. Sie folgt der Entscheidung in CGN_VAR_DECL
  // (cg_genFile) — die beiden muessen uebereinstimmen; im Zweifel sagt sie
  // ja (dann ruft main eine leere Sammelfunktion, falsch wird nichts).
  fn cg_miLaufzeit(d: int64): int64 {
    if (self.cg_nkind(d) != CGN_VAR_DECL) { return 0; }
    var ini: int64 := self.cg_nc1(d);
    if (ini < 0) {
      // #2150: Map ohne Startwert (siehe cg_genFile, CGN_VAR_DECL).
      var mtn: int64 := self.cg_nc0(d);
      if (mtn >= 0 && self.cg_nkind(mtn) == 60 && self.cg_nslen(mtn) == 3
          && self.cg_seq(self.cg_nsval(mtn), 3, "Map", 3)) { return 1; }
      return 0;
    }
    var ik: int64 := self.cg_nkind(ini);
    if (ik == CGN_LIT_STR || ik == CGN_CLOSURE) { return 0; }
    if (ik == CGN_IDENT && self.cg_isDeclaredFunc(self.cg_nsval(ini), self.cg_nslen(ini)) != 0) { return 0; }
    if (ik == 100) {
      var n: int64 := 0;
      var alle: int64 := 1;
      var el: int64 := self.cg_nc0(ini);
      while (el != -1) {
        n := n + 1;
        if (self.cg_isConstExpr(el) == 0) { alle := 0; }
        el := self.cg_nnext(el);
      }
      if (alle != 0 && n > 0 && (self.cg_nival(d) & 4) == 0) { return 0; }
      return 1;
    }
    if (self.cg_isConstExpr(ini) != 0) { return 0; }
    return 1;
  }

  // Deklarationen des Hauptmoduls, die HINTER main stehen (Knotennummer
  // groesser als die von main), auch in einem eingebetteten @if-Zweig.
  fn cg_miNachMain(head: int64, mainNi: int64): int64 {
    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_BLOCK) {
        if (self.cg_miNachMain(self.cg_nc0(cur), mainNi) != 0) { return 1; }
      } else if (k == CGN_VAR_DECL && cur > mainNi) {
        if (self.cg_miLaufzeit(cur) != 0) { return 1; }
      }
      cur := self.cg_nnext(cur);
    }
    return 0;
  }

  // Ruft main die Anfangswerte? Ja, wenn eine Unit (Import) schon eine
  // Funktion hat, das Hauptmodul vor main eine Deklaration vorgemerkt hat,
  // oder hinter main eine kommt. Ohne Bedarf entsteht weder Aufruf noch
  // Funktion — das Erzeugnis bleibt Byte fuer Byte, wie es war.
  fn cg_miMainBraucht(mainNi: int64): int64 {
    if (self.miFnN > 0 || self.miPendN > 0) { return 1; }
    return self.cg_miNachMain(self.topLevelHead, mainNi);
  }

  // Einen Anfangswert rechnen und ablegen — mit derselben Angleichung wie
  // eine Zuweisung an die Globale in einer Funktion (CGN_ASSIGN in
  // cg_genStmt) bzw. die Deklaration eines Locals (#1351/#1502).
  fn cg_miEinsInit(d: int64) {
    var name: pchar := self.cg_nsval(d);
    var nlen: int64 := self.cg_nslen(d);
    var ini: int64 := self.cg_nc1(d);
    var gtNode: int64 := self.cg_nc0(d);
    var gIdx: int64 := self.cg_findGlobalIdx(name, nlen);
    var doff: int64 := self.cg_findGlobal(name, nlen);
    if (ini < 0 && gIdx >= 0 && doff >= 0 && (gtNode >= 0 && self.cg_nkind(gtNode) == 60 && self.cg_nslen(gtNode) == 3 && self.cg_seq(self.cg_nsval(gtNode), 3, "Map", 3))) {
      // #2150: leere Map mit derselben Anfangskapazitaet wie das Local
      // (mapNoInit, #1152).
      self.cg_movRaxImm(16);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);   // mov rdi, rax
      var ppMg: int64 := self.cg_emitCall();
      poke32(self.code + ppMg, CG_H_MAP_NEW - ppMg - 4);
      self.cg_storeRaxGlobal(doff);
      return;
    }
    if (gIdx < 0 || doff < 0 || ini < 0) {
      EPrintStr("interner fehler (#2136): Modulvariable '"c);
      sys_write(2, name as int64, nlen);
      EPrintStrLn("' steht nicht im Verzeichnis."c);
      exit(1);
    }
    var art: int64 := peek8(self.globalIsArray + gIdx) as int64;
    var ik: int64 := self.cg_nkind(ini);
    if (ik == 100 && art == 2) {
      // Array-Literal: die konstanten Elemente stehen schon im Block, hier
      // nur die uebrigen — an ihren Platz hinter dem {cap,len}-Kopf.
      var el: int64 := self.cg_nc0(ini);
      var i: int64 := 0;
      while (el != -1) {
        if (self.cg_isConstExpr(el) == 0) {
          self.cg_genExpr(el);
          self.cg_pushRax();
          self.cg_loadRaxGlobal(doff);                                   // Blockadresse
          self.cg_e8(0x5E);                                              // pop rsi
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xB0);          // mov [rax+disp32], rsi
          self.cg_e32(16 + i * 8);
        }
        i := i + 1;
        el := self.cg_nnext(el);
      }
      return;
    }
    if (art == 3 && ik != CGN_CAST && ik != CGN_NEW) {
      // Ein STRUCT hat seinen Speicher im Datenbereich; der Wert wird
      // hineinkopiert (#1351). Den Zeiger umzubiegen hiesse, auf den Rahmen
      // dieser Funktion zu zeigen, der gleich faellt. Cast und `new` binden
      // dagegen um — dieselbe Ausnahme wie beim Local.
      var sci: int64 := self.cg_findClass(self.cg_nsval(gtNode), self.cg_nslen(gtNode));
      var sb: int64 := 0;
      if (sci >= 0) { sb := self.cg_classStructSize(sci); }
      if (sb <= 0) {
        EPrintStr("interner fehler (#2136): Struct-Groesse von '"c);
        sys_write(2, name as int64, nlen);
        EPrintStrLn("' unbekannt."c);
        exit(1);
      }
      self.cg_genExpr(ini);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);   // mov rsi, rax (Quelle)
      self.cg_loadRaxGlobal(doff);                            // Zielblock
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);   // mov rdi, rax
      self.cg_movRaxImm((sb + 7) / 8);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);   // mov rcx, rax
      self.cg_e8(0xF3); self.cg_e8(0x48); self.cg_e8(0xA5);   // rep movsq
      return;
    }
    self.cg_genExpr(ini);
    var ut: int64 := self.cg_utypeOfTypeNode(gtNode);
    // #1502: `var x: f64 := ganzzahl` — umrechnen, nicht das Bitmuster nehmen.
    if (ut < 0 && gtNode >= 0 && self.cg_nkind(gtNode) == 60
        && self.cg_isFloatTypeName(self.cg_nsval(gtNode), self.cg_nslen(gtNode)) != 0
        && self.cg_isF64Expr(ini) == 0) {
      self.cg_emitRaxIntToF64();
    }
    self.cg_emitRangeCheck(self.cg_rangeOfLocal(name, nlen), "Startwert"c);
    self.cg_emitNarrowRax(self.cg_narrowKindOfVar(name, nlen));
    if (ut >= 0) {
      if (self.cg_isF64Expr(ini) == 0) { self.cg_emitRaxIntToF64(); }
      self.cg_emitUtypeConvExpr(ut, ini);
      self.cg_emitUtypeRange(ut);
    }
    self.cg_emitGlobalWrite(name, nlen, doff);
  }

  // Die Funktion einer Unit: alle ab `start` vorgemerkten Anfangswerte, in
  // Deklarationsreihenfolge. Gerufen am Ende des cg_genFile DIESER Unit, mit
  // ihrer Knotentabelle, ihrem Kopf und ihrem Privatverzeichnis — die Namen
  // loesen also auf wie in einer ihrer Funktionen.
  fn cg_miEinheit(start: int64) {
    if (self.miPendN <= start) { return; }
    var nb: int64 := alloc(40);
    var pre: pchar := "__lyx_modinit_";
    memcpy(nb, pre as int64, 14);
    var nl: int64 := 14;
    var zahl: int64 := self.miFnN;
    var ziff: int64 := alloc(24);
    var zn: int64 := 0;
    if (zahl == 0) { poke8(ziff, 48); zn := 1; }
    while (zahl > 0) { poke8(ziff + zn, 48 + (zahl % 10)); zahl := zahl / 10; zn := zn + 1; }
    while (zn > 0) { zn := zn - 1; poke8(nb + nl, peek8(ziff + zn)); nl := nl + 1; }
    poke8(nb + nl, 0);
    free(ziff, 24);

    var sOuter: pchar := self.outerFuncName;
    var sOuterL: int64 := self.outerFuncNameLen;
    var sClass: pchar := self.curClassName;
    var sClassL: int64 := self.curClassNameLen;
    var sEnv: int64 := self.closureEnvPtrOff;
    self.cg_addLabel(nb as pchar, nl, 0);
    self.outerFuncName := nb as pchar;
    self.outerFuncNameLen := nl;
    self.curClassName := 0 as pchar;
    self.curClassNameLen := 0;
    self.closureEnvPtrOff := 0;
    self.localCount := 0;
    self.frameSize  := 0;
    self.funcHasTupleReturn := 0;
    self.profCurName := nb as pchar;
    self.profCurLen  := 0;          // nicht messen (--profile), wie der Bericht
    // #2245: erzeugte Helferfunktion ohne AST — hier ist nicht zu pruefen, was
    // im Rahmen liegt, also bleibt der Canary (sichere Seite).
    self.canaryAn := 1;
    var prologuePatch: int64 := self.cg_emitPrologue();
    self.fnRetStructBytes := 0;
    self.fnRetSlotOff     := 0;
    self.fnRetIsFloat     := 0;
    self.fcActive         := 0;
    self.lockstepActive   := 0;
    self.curFnRetRange    := self.cg_rangeOfTypeNode(0 - 1);
    self.curFnRetNarrow   := self.cg_narrowKindOfTypeNode(0 - 1);
    self.deferCount    := 0;
    self.dfCount       := 0;
    self.loopDeferMark := -1;
    self.tryDepth      := 0;
    self.loopTryMark   := 0;
    self.tryDeferMark  := -1;
    self.deferMaxCount := 0;
    self.localHigh     := self.localCount;
    self.deferDepthSlot := 0;

    var i: int64 := start;
    while (i < self.miPendN) {
      self.cg_miEinsInit(peek64(self.miPendBuf + i * 8));
      i := i + 1;
    }
    self.miPendN := start;

    self.cg_zeroRax();
    self.cg_emitEpilogue();
    var fs: int64 := self.frameSize + 15;
    var aligned: int64 := fs - (fs & 15);
    if (aligned == 0) { aligned := 16; }
    poke32(self.code + prologuePatch, aligned);

    self.outerFuncName := sOuter;
    self.outerFuncNameLen := sOuterL;
    self.curClassName := sClass;
    self.curClassNameLen := sClassL;
    self.closureEnvPtrOff := sEnv;
    self.cg_flushNested();

    if (self.miFnN >= self.miFnCap) {
      var nc: int64 := self.miFnCap * 2;
      var nf: int64 := alloc(nc * 16);
      memcpy(nf, self.miFnBuf, self.miFnN * 16);
      self.miFnBuf := nf;
      self.miFnCap := nc;
    }
    poke64(self.miFnBuf + self.miFnN * 16, nb);
    poke64(self.miFnBuf + self.miFnN * 16 + 8, nl);
    self.miFnN := self.miFnN + 1;
  }

  // Die Sammelfunktion `__lyx_modinit`: ruft die Unit-Funktionen in der
  // Reihenfolge, in der sie entstanden sind — Importe vor dem Importeur.
  // Entsteht auch leer, wenn main sie ruft (cg_miLaufzeit sagte im Zweifel ja).
  fn cg_miSammel() {
    if (self.miFnN == 0 && self.miMainRuft == 0) { return; }
    self.cg_addLabel("__lyx_modinit"c, 13, 0);
    // push rbp: die Unit-Funktionen treten mit derselben Stapellage ein wie
    // jede von main gerufene Funktion.
    self.cg_e8(0x55);                                       // push rbp
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE5);   // mov rbp, rsp
    var i: int64 := 0;
    while (i < self.miFnN) {
      self.cg_e8(0xE8);
      var pp: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_addPatch(pp, peek64(self.miFnBuf + i * 16), peek64(self.miFnBuf + i * 16 + 8), CG_PATCH_CALL);
      i := i + 1;
    }
    self.cg_e8(0x5D);                                       // pop rbp
    self.cg_e8(0xC3);                                       // ret
  }

  // __lyx_so_init — der Eintrag in DT_INIT_ARRAY. glibc und bionic rufen
  // ihn mit (argc, argv, envp); er uebernimmt die Aufgaben des `_start`, die
  // in eine Bibliothek gehoeren: argc/argv fuer GetArgC/GetArgV und den
  // Canary (__lyx_canary_init, schliesst mit ret). Konstante Startwerte
  // der Modulvariablen stehen im Datenbereich (cg_genFile); die uebrigen
  // rechnet seit #2136 __lyx_modinit, gerufen nach dem Canary. Der Heap
  // beginnt leer und holt sich seinen ersten Block selbst. prlimit und die
  // Haertung aus main gehoeren dem Host, nicht hierher.
  fn cg_soEmitInit() {
    self.soInitOff := self.codeLen;
    self.cg_addLabel("__lyx_so_init"c, 13, 0);
    self.cg_cfi(CFI_FN, 0);   // #2135: kein Rahmen, rsp bleibt unberuehrt bis zum jmp
    self.cg_e8(0x89); self.cg_e8(0xFF);                     // mov edi, edi  (argc ist ein int)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x3D);   // mov [rip+CG_ARGC], rdi
    var pa: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pa, CG_ARGC, 0, CG_PATCH_STR);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x35);   // mov [rip+CG_ARGV], rsi
    var pv: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pv, CG_ARGV, 0, CG_PATCH_STR);
    if (self.miFnN > 0) {
      // #2136: Anfangswerte der Modulvariablen — NACH dem Canary, denn ihre
      // Funktionen pruefen ihn im Epilog gegen denselben Wert.
      self.cg_e8(0xE8);                                     // call __lyx_canary_init
      var pc: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_addPatch(pc, "__lyx_canary_init" as int64, 17, CG_PATCH_CALL);
      self.cg_e8(0xE8);                                     // call __lyx_modinit
      var pm: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_addPatch(pm, "__lyx_modinit" as int64, 13, CG_PATCH_CALL);
      self.cg_e8(0xC3);                                     // ret
      return;
    }
    self.cg_e8(0xE9);                                       // jmp __lyx_canary_init
    var pj: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pj, "__lyx_canary_init" as int64, 17, CG_PATCH_CALL);
    self.cg_cfi(CFI_ENDE, 0);
  }

  // `mov r64, imm64` (48 B8+r, imm bei immOff) zu `lea r64, [rip+ziel]` und
  // drei Byte nop umschreiben; ziel ist ein Offset ab Codeanfang. Gleiche
  // Laenge, die Sprungweiten dahinter bleiben gueltig.
  fn cg_soMovabsZuLea(immOff: int64, ziel: int64) {
    var s: int64 := immOff - 2;
    var rex: int64 := peek8(self.code + s) & 255;
    var op: int64 := peek8(self.code + s + 1) & 255;
    if (rex != 0x48 || op < 0xB8 || op > 0xBF) {
      EPrintStrLn("interner fehler: --shared: VMT-Adresse steht nicht in `mov r64, imm64` (#2124)."c);
      exit(1);
    }
    var reg: int64 := op - 0xB8;
    // Kein Sprungpatch (tests/kurzsprung_test.sh zaehlt rohe Byte-Patches in
    // den Codepuffer): ein ganzer Befehl wird ersetzt, ueber eine Basis.
    var befehl: int64 := self.code + s;
    poke8(befehl,     0x48);
    poke8(befehl + 1, 0x8D);
    poke8(befehl + 2, 0x05 | (reg << 3));
    poke32(befehl + 3, ziel - (s + 7));
    poke8(befehl + 7, 0x0F);
    poke8(befehl + 8, 0x1F);
    poke8(befehl + 9, 0x00);
  }

  // Ein Programmkopf (p_vaddr == p_paddr == p_offset, Ladebasis 0).
  fn cg_soPhdr(ph: int64, typ: int64, flags: int64, off: int64, size: int64, align: int64) {
    poke32(ph, typ);
    poke32(ph + 4, flags);
    poke64(ph + ELF64_PHDR_OFF_OFFSET, off);
    poke64(ph + ELF64_PHDR_OFF_VADDR, off);
    poke64(ph + ELF64_PHDR_OFF_PADDR, off);
    poke64(ph + ELF64_PHDR_OFF_FILESZ, size);
    poke64(ph + ELF64_PHDR_OFF_MEMSZ, size);
    poke64(ph + ELF64_PHDR_OFF_ALIGN, align);
  }

  // Ein Section-Header; sh_addr == sh_offset.
  fn cg_soShdr(sh: int64, name: int64, typ: int64, flags: int64, off: int64, size: int64,
               link: int64, info: int64, align: int64, entsize: int64) {
    poke32(sh, name);
    poke32(sh + 4, typ);
    poke64(sh + 8, flags);
    poke64(sh + 16, off);
    poke64(sh + 24, off);
    poke64(sh + 32, size);
    poke32(sh + 40, link);
    poke32(sh + 44, info);
    poke64(sh + 48, align);
    poke64(sh + 56, entsize);
  }

  // #2135: ULEB128 nach buf+pos, liefert die neue Position.
  fn cg_ehUleb(buf: int64, pos: int64, v: int64): int64 {
    var w: int64 := v;
    var p: int64 := pos;
    var weiter: int64 := 1;
    while (weiter != 0) {
      var b: int64 := w & 127;
      w := w >> 7;
      if (w != 0) { b := b | 128; } else { weiter := 0; }
      poke8(buf + p, b);
      p := p + 1;
    }
    return p;
  }

  // #2135: DW_CFA_advance_loc in der kuerzesten Form (code_align 1).
  fn cg_ehAdvance(buf: int64, pos: int64, delta: int64): int64 {
    if (delta < 64) { poke8(buf + pos, 0x40 | delta); return pos + 1; }
    if (delta < 256) { poke8(buf + pos, 0x02); poke8(buf + pos + 1, delta); return pos + 2; }
    if (delta < 65536) { poke8(buf + pos, 0x03); poke16(buf + pos + 1, delta); return pos + 3; }
    poke8(buf + pos, 0x04); poke32(buf + pos + 1, delta); return pos + 5;
  }

  // #2135: Aus den Ereignissen (cfiBuf) die Bereiche und ihre CFA-Programme.
  // Ergebnis: alloc(32) = {Bereichstabelle, Anzahl, Befehlspuffer, Laenge};
  // je Bereich 32 Byte {Anfang, Ende, Befehlsoffset, Befehlslaenge}, Anfang
  // und Ende als Codeoffset. Die Reihenfolge der Ereignisse ist die des
  // Codestroms — eine Ruecklaeufigkeit waere ein Erzeugungsfehler und wird
  // gemeldet, nicht still sortiert.
  fn cg_ehBereiche(): int64 {
    var n: int64 := self.cfiCount;
    var tab: int64 := alloc((n + 1) * 32);
    var ins: int64 := alloc(n * 12 + 64);
    var insLen: int64 := 0;
    var anz: int64 := 0;
    var offen: int64 := 0;
    var anfang: int64 := 0;
    var insAnf: int64 := 0;
    var zuletzt: int64 := 0;
    var vorher: int64 := 0;
    var k: int64 := 0;
    while (k <= n) {
      var pos: int64 := self.codeLen;
      var art: int64 := CFI_ENDE;
      var arg: int64 := 0;
      if (k < n) {
        pos := peek64(self.cfiBuf + k * 16);
        var wort: int64 := peek64(self.cfiBuf + k * 16 + 8);
        art := wort & 255;
        arg := wort >> 8;
      }
      if (pos < vorher) {
        EPrintStr("interner fehler: --shared: Abwickelangaben nicht in Codereihenfolge bei Offset "c);
        self.cg_eprintInt(pos);
        EPrintStrLn(" (#2135)."c);
        exit(1);
      }
      vorher := pos;
      if (art == CFI_FN || art == CFI_FN_RAHMEN || art == CFI_ENDE) {
        if (offen != 0 && pos > anfang) {
          var tb: int64 := tab + anz * 32;
          poke64(tb, anfang);
          poke64(tb + 8, pos);
          poke64(tb + 16, insAnf);
          poke64(tb + 24, insLen - insAnf);
          anz := anz + 1;
        } else if (offen != 0) {
          insLen := insAnf;            // leerer Bereich: Befehle verwerfen
        }
        offen := 0;
        if (art != CFI_ENDE) {
          offen := 1;
          anfang := pos;
          zuletzt := pos;
          insAnf := insLen;
          if (art == CFI_FN_RAHMEN) {
            // Mitten im Rumpf: CFA = rbp+16, rbp bei CFA-16, rbx bei CFA-32.
            poke8(ins + insLen, 0x0C); poke8(ins + insLen + 1, 6); poke8(ins + insLen + 2, 16);
            poke8(ins + insLen + 3, 0x86); poke8(ins + insLen + 4, 2);
            poke8(ins + insLen + 5, 0x83); poke8(ins + insLen + 6, 4);
            insLen := insLen + 7;
          }
        }
      } else if (offen != 0) {
        if (pos > zuletzt) {
          insLen := self.cg_ehAdvance(ins, insLen, pos - zuletzt);
          zuletzt := pos;
        }
        if (art == CFI_CFA_OFF) {
          poke8(ins + insLen, 0x0E); insLen := self.cg_ehUleb(ins, insLen + 1, arg);
        } else if (art == CFI_CFA_RBP) {
          poke8(ins + insLen, 0x0D); poke8(ins + insLen + 1, 6); insLen := insLen + 2;
        } else if (art == CFI_SICHER) {
          poke8(ins + insLen, 0x80 | (arg & 63)); insLen := self.cg_ehUleb(ins, insLen + 1, arg >> 8);
        } else if (art == CFI_CFA_RSP8) {
          poke8(ins + insLen, 0x0C); poke8(ins + insLen + 1, 7); poke8(ins + insLen + 2, 8); insLen := insLen + 3;
        } else if (art == CFI_RAHMEN) {
          poke8(ins + insLen, 0x0C); poke8(ins + insLen + 1, 6); poke8(ins + insLen + 2, 16); insLen := insLen + 3;
        } else {
          EPrintStr("interner fehler: --shared: unbekannte Abwickelangabe "c);
          self.cg_eprintInt(art);
          EPrintStrLn(" (#2135)."c);
          exit(1);
        }
      }
      k := k + 1;
    }
    var erg: int64 := alloc(32);
    poke64(erg, tab);
    poke64(erg + 8, anz);
    poke64(erg + 16, ins);
    poke64(erg + 24, insLen);
    return erg;
  }

  // #2135: Funktionen fuer DWARF. Das Ende einer Marke ist die NAECHSTE
  // Marke im Code, nicht die naechste in der Tabelle — Aliasmarken
  // (cg_bindConFns) stehen dort hinten, zeigen aber nach vorn.
  fn cg_dwarfFunktionen(dg: DwarfGen, codeLen: int64) {
    var li: int64 := 0;
    while (li < self.labelCount) {
      var lb: int64 := self.labels + li * CG_LABEL_SZ;
      var anf: int64 := peek64(lb + CG_LABEL_OFF_CODEOFF);
      var ende: int64 := codeLen;
      var lj: int64 := 0;
      while (lj < self.labelCount) {
        var o: int64 := peek64(self.labels + lj * CG_LABEL_SZ + CG_LABEL_OFF_CODEOFF);
        if (o > anf && o < ende) { ende := o; }
        lj := lj + 1;
      }
      dg.dw_addFunc(peek64(lb) as pchar, peek64(lb + CG_LABEL_OFF_NAMELEN), anf, ende,
                    peek64(lb + CG_LABEL_OFF_LINENUM));
      li := li + 1;
    }
  }

  // #2135: Groesse eines FDE (auf 8 aufgerundet): Laenge, CIE-Zeiger,
  // pc_begin, pc_range, Augmentierungslaenge, Befehle.
  fn cg_ehFdeGroesse(insLen: int64): int64 {
    return ((4 + 4 + 4 + 4 + 1 + insLen + 7) / 8) * 8;
  }

  // ET_DYN fuer x86-64. Vorbild ist writeELFSharedLib (arm64, lyxc.lyx) —
  // dieselben Ladebedingungen von bionic (Section-Header, SHT_DYNAMIC auf
  // PT_DYNAMIC, 16-KiB-Segmente, PT_GNU_STACK, PT_GNU_RELRO), nur das Abbild
  // stammt aus diesem Codegen: Code und Daten liegen aneinander, alle
  // internen Bezuege sind RIP-relativ. Ladebasis 0, VA == Dateioffset.
  //
  //   [0, codeOff)          ELF-Kopf, Programmkoepfe, .note.android.ident,
  //                         .dynsym, .dynstr, .hash, .rela.dyn
  //   [codeOff, dataOff)    .text   — codeOff = CG_CODE_OFF mod 16 KiB, damit
  //                         dataOff (Generate fuellt auf) auf 16 KiB liegt
  //   ---- LOAD R-X endet hier ----
  //   [dataOff, ...)        .data   (Modulvariablen, Zeichenketten, VMTs)
  //   [relroOff, relroEnd)  .dynamic, .init_array, .got  — PT_GNU_RELRO; auf
  //                         eigener 16-KiB-Seite, weil bionic das RELRO-Ende
  //                         aufrundet und den Anfang abrundet
  //   Section-Header-Tabelle + .shstrtab, nicht geladen.
  //
  // Relocations: je Basis-Relocation (cg_addBaseReloc) ein R_X86_64_RELATIVE,
  // eines fuer den Init-Eintrag, je `extern fn` ein R_X86_64_GLOB_DAT auf
  // seinen GOT-Platz. Liegt eine Basis-Relocation im Code, waere sie eine
  // Text-Relocation — das wird gemeldet, nicht geschrieben.
  //
  // expBuf: je Export 24 Byte {Namenszeiger, Namenslaenge, Codeoffset}
  // (Satzform EXPBUF_* in lyxc.lyx). androidApi > 0: mit Android-Notiz.
  fn cg_writeELFShared(path: pchar, expBuf: int64, expCount: int64, androidApi: int64) {
    if (self.codeOverflow != 0 || self.dataOverflow != 0) {
      EPrintStrLn("error: codegen: cg_writeELFShared abgebrochen — Puffer-512-MB-Limit überschritten"c);
      exit(EMIT_EX_IOERR);
    }
    var codeLen: int64 := self.codeLen;
    var dataLen: int64 := self.dataLen;
    var seite: int64 := 16384;
    if (((CG_CODE_OFF + codeLen) & (seite - 1)) != 0) {
      EPrintStrLn("interner fehler: --shared: Code nicht auf 16 KiB aufgefuellt (#2124)."c);
      exit(1);
    }
    var nExt: int64 := self.externCount;
    var nBase: int64 := self.baseRelocCount;

    // SONAME = Dateiname ohne Verzeichnis
    var pathLen: int64 := StrLen(path);
    var bs: int64 := 0;
    var q: int64 := 0;
    while (q < pathLen) {
      if (peek8(path as int64 + q) == 47) { bs := q + 1; }
      q := q + 1;
    }
    var soLen: int64 := pathLen - bs;

    // ---- .dynstr: \0, SONAME, Exporte, Externs, Bibliotheken (entdoppelt) ----
    var dsCap: int64 := 64 + soLen;
    var e: int64 := 0;
    while (e < expCount) { dsCap := dsCap + peek64(expBuf + e * 24 + 8) + 1; e := e + 1; }
    e := 0;
    while (e < nExt) {
      var eb0: int64 := self.externSyms + e * CG_EXTERN_SZ;
      dsCap := dsCap + peek64(eb0 + CG_EXTERN_OFF_NAMELEN) + peek64(eb0 + CG_EXTERN_OFF_LIBLEN) + 2;
      e := e + 1;
    }
    var ds: int64 := alloc(dsCap);
    var dsLen: int64 := 1;
    poke8(ds, 0);
    memcpy(ds + dsLen, path as int64 + bs, soLen); poke8(ds + dsLen + soLen, 0);
    var soStr: int64 := dsLen;
    dsLen := dsLen + soLen + 1;
    var expStr: int64 := alloc((expCount + 1) * 8);
    e := 0;
    while (e < expCount) {
      var nl: int64 := peek64(expBuf + e * 24 + 8);
      memcpy(ds + dsLen, peek64(expBuf + e * 24), nl); poke8(ds + dsLen + nl, 0);
      poke64(expStr + e * 8, dsLen);
      dsLen := dsLen + nl + 1;
      e := e + 1;
    }
    var extStr: int64 := alloc((nExt + 1) * 8);
    e := 0;
    while (e < nExt) {
      var eb1: int64 := self.externSyms + e * CG_EXTERN_SZ;
      var xl: int64 := peek64(eb1 + CG_EXTERN_OFF_NAMELEN);
      memcpy(ds + dsLen, peek64(eb1), xl); poke8(ds + dsLen + xl, 0);
      poke64(extStr + e * 8, dsLen);
      dsLen := dsLen + xl + 1;
      e := e + 1;
    }
    var libStr: int64 := alloc((nExt + 1) * 8);   // dynstr-Offset beim ersten Vorkommen, sonst -1
    var nLibs: int64 := 0;
    e := 0;
    while (e < nExt) {
      var eb2: int64 := self.externSyms + e * CG_EXTERN_SZ;
      var lp: int64 := peek64(eb2 + CG_EXTERN_OFF_LIBPTR);
      var ll: int64 := peek64(eb2 + CG_EXTERN_OFF_LIBLEN);
      var neu: int64 := 1;
      var u: int64 := 0;
      while (u < e) {
        var ub: int64 := self.externSyms + u * CG_EXTERN_SZ;
        if (peek64(ub + CG_EXTERN_OFF_LIBLEN) == ll) {
          if (self.cg_seq(peek64(ub + CG_EXTERN_OFF_LIBPTR) as pchar, ll, lp as pchar, ll)) { neu := 0; }
        }
        u := u + 1;
      }
      if (neu != 0) {
        memcpy(ds + dsLen, lp, ll); poke8(ds + dsLen + ll, 0);
        poke64(libStr + e * 8, dsLen);
        dsLen := dsLen + ll + 1;
        nLibs := nLibs + 1;
      } else {
        poke64(libStr + e * 8, 0 - 1);
      }
      e := e + 1;
    }

    // ---- Layout ----
    var hatNote: int64 := 0;
    if (androidApi > 0) { hatNote := 1; }
    var phNum: int64 := 6 + hatNote;   // LOAD RX, LOAD RW, DYNAMIC, GNU_STACK, GNU_RELRO, GNU_EH_FRAME (+ NOTE)
    var noteOff: int64 := ((64 + phNum * 56 + 7) / 8) * 8;
    var noteSize: int64 := 24 * hatNote;
    var nSyms: int64 := 1 + expCount + nExt;
    var dynsymOff: int64 := noteOff + noteSize;
    var dynsymSize: int64 := nSyms * 24;
    var dynstrOff: int64 := dynsymOff + dynsymSize;
    var hashOff: int64 := ((dynstrOff + dsLen + 7) / 8) * 8;
    var hashSize: int64 := 4 * (3 + nSyms);   // nbucket, nchain, bucket[1], chain[nSyms]
    var relaOff: int64 := ((hashOff + hashSize + 7) / 8) * 8;
    var anzRela: int64 := nBase + 1 + nExt;
    var relaSize: int64 := anzRela * 24;
    // #2135: .eh_frame_hdr + .eh_frame — Abwickelangaben, ohne die ein
    // Abwickler (Absturzbericht, backtrace(), C++-Ausnahmen) an der ersten
    // Lyx-Funktion stehen bleibt. Geladen, nur lesbar, im R-X-Segment.
    var eh: int64 := self.cg_ehBereiche();
    var ehTab: int64 := peek64(eh);
    var ehAnz: int64 := peek64(eh + 8);
    var ehIns: int64 := peek64(eh + 16);
    var ehHdrOff: int64 := ((relaOff + relaSize + 7) / 8) * 8;
    var ehHdrSize: int64 := 12 + ehAnz * 8;
    var ehOff: int64 := ((ehHdrOff + ehHdrSize + 7) / 8) * 8;
    var ehSize: int64 := 24 + 4;   // CIE + Endmarke
    var ef: int64 := 0;
    while (ef < ehAnz) { ehSize := ehSize + self.cg_ehFdeGroesse(peek64(ehTab + ef * 32 + 24)); ef := ef + 1; }
    var tabEnde: int64 := ehOff + ehSize;
    var codeOff: int64 := CG_CODE_OFF + ((tabEnde - CG_CODE_OFF + seite - 1) / seite) * seite;
    self.codeFileOff := codeOff;   // #2144: Ladebasis 0
    self.codeStartVa := codeOff;
    var dataOff: int64 := codeOff + codeLen;
    var relroOff: int64 := ((dataOff + dataLen + seite - 1) / seite) * seite;
    var dynOff: int64 := relroOff;
    var dynNum: int64 := nLibs + 12;   // NEEDED.. HASH STRTAB SYMTAB STRSZ SYMENT SONAME RELA RELASZ RELAENT INIT_ARRAY INIT_ARRAYSZ NULL
    var dynSize: int64 := dynNum * 16;
    var initOff: int64 := dynOff + dynSize;
    var gotOff: int64 := initOff + 8;
    var gotSize: int64 := nExt * 8;
    var relroEnd: int64 := gotOff + gotSize;
    var shstrOff: int64 := relroEnd;
    var shstrSize: int64 := 256;
    // NULL text [note] dynsym dynstr hash rela eh_frame_hdr eh_frame data dynamic init_array got shstrtab
    var shNum: int64 := 13 + hatNote;
    // #2135: --debug — dieselben DWARF-Abschnitte wie im statischen ELF
    // (WriteELF), nicht geladen, hinter .shstrtab. Bis 1.2.15A fehlten sie
    // in der .so still. Adressen ab Ladebasis 0: der Code liegt bei codeOff.
    var dg: DwarfGen := new DwarfGen();
    dg.Init();
    dg.elfBase := 0;
    dg.codeOff := codeOff;
    var dbgOff: int64 := shstrOff + shstrSize;
    var dbgSize: int64 := 0;
    if (self.debugMode != 0) {
      self.cg_dwarfFunktionen(dg, codeLen);
      dg.dw_buildAbbrev();
      dg.dw_buildInfo(self.srcFilePath, self.srcFileLen, codeLen);
      dg.dw_buildLine(self.srcFilePath, self.srcFileLen);
      dbgSize := dg.abbrevLen + dg.infoLen + dg.lineLen + dg.strLen;
      shNum := shNum + 4;
    }
    var shOff: int64 := ((dbgOff + dbgSize + 7) / 8) * 8;
    var fileSize: int64 := shOff + shNum * 64;

    var buf: int64 := alloc(fileSize);
    var z: int64 := 0;
    while (z < fileSize) { poke8(buf + z, 0); z := z + 1; }
    memcpy(buf + codeOff, self.code, codeLen);
    memcpy(buf + dataOff, self.data, dataLen);

    // ---- ELF-Kopf ----
    poke8(buf, 0x7F); poke8(buf + 1, 69); poke8(buf + 2, 76); poke8(buf + 3, 70);
    poke8(buf + 4, 2); poke8(buf + 5, 1); poke8(buf + 6, 1);
    poke16(buf + 16, 3);                       // ET_DYN
    poke16(buf + 18, 62);                      // EM_X86_64
    poke32(buf + 20, 1);
    poke64(buf + ELF64_EHDR_OFF_ENTRY, 0);
    poke64(buf + ELF64_EHDR_OFF_PHOFF, 64);
    poke64(buf + ELF64_EHDR_OFF_SHOFF, shOff);
    poke16(buf + 52, 64); poke16(buf + 54, 56); poke16(buf + 56, phNum);
    poke16(buf + 58, 64); poke16(buf + 60, shNum); poke16(buf + 62, 12 + hatNote);   // .shstrtab (DWARF folgt dahinter)

    // ---- Programmkoepfe ----
    var ph: int64 := buf + 64;
    self.cg_soPhdr(ph, 1, 5, 0, dataOff, seite);                              ph := ph + 56;  // LOAD R-X
    self.cg_soPhdr(ph, 1, 6, dataOff, relroEnd - dataOff, seite);             ph := ph + 56;  // LOAD RW
    self.cg_soPhdr(ph, 2, 6, dynOff, dynSize, 8);                             ph := ph + 56;  // PT_DYNAMIC
    self.cg_soPhdr(ph, 0x6474E551, 6, 0, 0, 16);                              ph := ph + 56;  // PT_GNU_STACK
    self.cg_soPhdr(ph, 0x6474E552, 4, relroOff, relroEnd - relroOff, 1);      ph := ph + 56;  // PT_GNU_RELRO
    self.cg_soPhdr(ph, 0x6474E550, 4, ehHdrOff, ehHdrSize, 4);                ph := ph + 56;  // PT_GNU_EH_FRAME (#2135)
    if (hatNote != 0) {
      self.cg_soPhdr(ph, 4, 4, noteOff, noteSize, 4);                                         // PT_NOTE
      poke32(buf + noteOff, 8);                // namesz ("Android\0")
      poke32(buf + noteOff + 4, 4);            // descsz
      poke32(buf + noteOff + 8, 1);            // NT_VERSION
      memcpy(buf + noteOff + 12, "Android"c as int64, 7);
      poke32(buf + noteOff + 20, androidApi);
    }

    // ---- .dynstr, .dynsym ----
    memcpy(buf + dynstrOff, ds, dsLen);
    e := 0;
    while (e < expCount) {
      var so: int64 := buf + dynsymOff + (1 + e) * 24;
      poke32(so, peek64(expStr + e * 8));
      poke8(so + 4, 0x12);                     // GLOBAL FUNC
      poke16(so + 6, 1);                       // .text
      poke64(so + 8, codeOff + peek64(expBuf + e * 24 + 16));
      e := e + 1;
    }
    e := 0;
    while (e < nExt) {
      var sx: int64 := buf + dynsymOff + (1 + expCount + e) * 24;
      poke32(sx, peek64(extStr + e * 8));
      poke8(sx + 4, 0x12);                     // GLOBAL FUNC, SHN_UNDEF
      e := e + 1;
    }

    // ---- .hash: ein Eimer, alle Symbole in einer Kette ----
    poke32(buf + hashOff, 1);
    poke32(buf + hashOff + 4, nSyms);
    if (nSyms > 1) { poke32(buf + hashOff + 8, 1); }
    var hc: int64 := 1;
    while (hc < nSyms - 1) { poke32(buf + hashOff + 12 + hc * 4, hc + 1); hc := hc + 1; }

    // ---- .rela.dyn ----
    var ra: int64 := buf + relaOff;
    var bildEnde: int64 := CG_ELF_BASE + CG_CODE_OFF + codeLen + dataLen;
    var bi: int64 := 0;
    while (bi < nBase) {
      var bildOff: int64 := peek64(self.baseRelocBuf + bi * 8) - CG_CODE_OFF;   // ab Codeanfang
      if (bildOff < codeLen || bildOff + 8 > codeLen + dataLen) {
        EPrintStr("error: --shared: Basis-Relocation bei Codeoffset "c);
        self.cg_eprintInt(bildOff);
        EPrintStrLn(" liegt nicht im Datenbereich — das waere eine Text-Relocation (#2124)."c);
        exit(1);
      }
      var alt: int64 := peek64(self.data + bildOff - codeLen);
      if (alt < CG_ELF_BASE + CG_CODE_OFF || alt > bildEnde) {
        EPrintStr("error: --shared: Basis-Relocation bei Codeoffset "c);
        self.cg_eprintInt(bildOff);
        EPrintStrLn(" traegt keine Adresse im Abbild (#2124)."c);
        exit(1);
      }
      var addend: int64 := alt - CG_ELF_BASE - CG_CODE_OFF + codeOff;
      poke64(ra, codeOff + bildOff);
      poke64(ra + ELF64_RELA_OFF_INFO, 8);                 // R_X86_64_RELATIVE
      poke64(ra + ELF64_RELA_OFF_ADDEND, addend);
      poke64(buf + codeOff + bildOff, addend);             // Inhalt == Ziel bei Basis 0
      ra := ra + 24;
      bi := bi + 1;
    }
    poke64(ra, initOff);                                   // DT_INIT_ARRAY[0]
    poke64(ra + ELF64_RELA_OFF_INFO, 8);
    poke64(ra + ELF64_RELA_OFF_ADDEND, codeOff + self.soInitOff);
    poke64(buf + initOff, codeOff + self.soInitOff);
    ra := ra + 24;
    e := 0;
    while (e < nExt) {
      poke64(ra, gotOff + e * 8);
      poke64(ra + ELF64_RELA_OFF_INFO, ((1 + expCount + e) << 32) | 6);   // R_X86_64_GLOB_DAT
      ra := ra + 24;
      e := e + 1;
    }

    // ---- externe Aufrufe: `call [rip+disp32]` auf den GOT-Platz ----
    var pi: int64 := 0;
    while (pi < self.patchCount) {
      var pb: int64 := self.patches + pi * CG_PATCH_SZ;
      if (peek64(pb + CG_PATCH_OFF_KIND) == CG_PATCH_EXTERN) {
        var cOff: int64 := peek64(pb);
        var exIdx: int64 := peek64(pb + CG_PATCH_OFF_NAMEPTR);
        poke32(buf + codeOff + cOff, (gotOff + exIdx * 8) - (codeOff + cOff + 4));
      }
      pi := pi + 1;
    }

    // ---- .eh_frame (#2135) ----
    // CIE fuer x86-64: code_align 1, data_align -8, Ruecksprungadresse =
    // DWARF-Register 16; beim Eintritt CFA = rsp+8, Ruecksprung bei CFA-8.
    // FDE-Adressen pc-relativ (0x1B), wie im arm64-Schreiber.
    var ce: int64 := buf + ehOff;
    poke32(ce + 0, 20);                  // Laenge
    poke32(ce + 4, 0);                   // CIE-Kennung
    poke8(ce + 8, 1);                    // Version
    poke8(ce + 9, 0x7A); poke8(ce + 10, 0x52); poke8(ce + 11, 0);   // "zR"
    poke8(ce + 12, 1);                   // code_align
    poke8(ce + 13, 0x78);                // data_align = -8
    poke8(ce + 14, 16);                  // Ruecksprungregister
    poke8(ce + 15, 1);                   // Augmentierungsdaten: 1 Byte
    poke8(ce + 16, 0x1B);                // FDE-Kodierung pcrel|sdata4
    poke8(ce + 17, 0x0C); poke8(ce + 18, 7); poke8(ce + 19, 8);     // DW_CFA_def_cfa rsp, 8
    poke8(ce + 20, 0x90); poke8(ce + 21, 1);                       // DW_CFA_offset r16, CFA-8
    var fRel: int64 := 24;
    ef := 0;
    while (ef < ehAnz) {
      var eb: int64 := ehTab + ef * 32;
      var fAnf: int64 := peek64(eb);
      var fEnd: int64 := peek64(eb + 8);
      var fIns: int64 := peek64(eb + 24);
      var fGr:  int64 := self.cg_ehFdeGroesse(fIns);
      var fe: int64 := buf + ehOff + fRel;
      poke32(fe, fGr - 4);
      poke32(fe + 4, fRel + 4);                                            // zum CIE
      poke32(fe + 8, ((codeOff + fAnf) - (ehOff + fRel + 8)) & 0xFFFFFFFF); // pc_begin
      poke32(fe + 12, fEnd - fAnf);                                        // pc_range
      poke8(fe + 16, 0);                                                   // keine Augmentierung
      memcpy(fe + 17, ehIns + peek64(eb + 16), fIns);                     // Rest: DW_CFA_nop
      // Suchtabelle in .eh_frame_hdr, datarel ab Kopfanfang, aufsteigend.
      poke32(buf + ehHdrOff + 12 + ef * 8, (codeOff + fAnf - ehHdrOff) & 0xFFFFFFFF);
      poke32(buf + ehHdrOff + 16 + ef * 8, (ehOff + fRel - ehHdrOff) & 0xFFFFFFFF);
      fRel := fRel + fGr;
      ef := ef + 1;
    }
    // Endmarke (Laenge 0): Nullfuellung.
    poke8(buf + ehHdrOff, 1);                       // Version
    poke8(buf + ehHdrOff + 1, 0x1B);                // eh_frame_ptr: pcrel|sdata4
    poke8(buf + ehHdrOff + 2, 0x03);                // fde_count: udata4
    poke8(buf + ehHdrOff + 3, 0x3B);                // Tabelle: datarel|sdata4
    poke32(buf + ehHdrOff + 4, (ehOff - (ehHdrOff + 4)) & 0xFFFFFFFF);
    poke32(buf + ehHdrOff + 8, ehAnz);

    // ---- DWARF (#2135, nur --debug) ----
    var dAbb: int64 := dbgOff;
    var dInf: int64 := dAbb + dg.abbrevLen;
    var dLin: int64 := dInf + dg.infoLen;
    var dStr: int64 := dLin + dg.lineLen;
    if (self.debugMode != 0) {
      memcpy(buf + dAbb, dg.abbrevBuf, dg.abbrevLen);
      memcpy(buf + dInf, dg.infoBuf, dg.infoLen);
      memcpy(buf + dLin, dg.lineBuf, dg.lineLen);
      memcpy(buf + dStr, dg.strBuf, dg.strLen);
    }

    // ---- .dynamic ----
    var d: int64 := buf + dynOff;
    e := 0;
    while (e < nExt) {
      if (peek64(libStr + e * 8) >= 0) {
        poke64(d, 1); poke64(d + 8, peek64(libStr + e * 8)); d := d + 16;   // DT_NEEDED
      }
      e := e + 1;
    }
    poke64(d, 4);  poke64(d + 8, hashOff);   d := d + 16;   // DT_HASH
    poke64(d, 5);  poke64(d + 8, dynstrOff); d := d + 16;   // DT_STRTAB
    poke64(d, 6);  poke64(d + 8, dynsymOff); d := d + 16;   // DT_SYMTAB
    poke64(d, 10); poke64(d + 8, dsLen);     d := d + 16;   // DT_STRSZ
    poke64(d, 11); poke64(d + 8, 24);        d := d + 16;   // DT_SYMENT
    poke64(d, 14); poke64(d + 8, soStr);     d := d + 16;   // DT_SONAME
    poke64(d, 7);  poke64(d + 8, relaOff);   d := d + 16;   // DT_RELA
    poke64(d, 8);  poke64(d + 8, relaSize);  d := d + 16;   // DT_RELASZ
    poke64(d, 9);  poke64(d + 8, 24);        d := d + 16;   // DT_RELAENT
    poke64(d, 25); poke64(d + 8, initOff);   d := d + 16;   // DT_INIT_ARRAY
    poke64(d, 27); poke64(d + 8, 8);         d := d + 16;   // DT_INIT_ARRAYSZ
    // DT_NULL: Nullfuellung

    // ---- .shstrtab + Section-Header ----
    var sn: int64 := buf + shstrOff;
    var at: int64 := 1;
    var nText: int64 := at; at := self.cg_objPutName(sn, at, ".text"c as int64, 5);
    var nNote: int64 := at; at := self.cg_objPutName(sn, at, ".note.android.ident"c as int64, 19);
    var nDsym: int64 := at; at := self.cg_objPutName(sn, at, ".dynsym"c as int64, 7);
    var nDstr: int64 := at; at := self.cg_objPutName(sn, at, ".dynstr"c as int64, 7);
    var nHash: int64 := at; at := self.cg_objPutName(sn, at, ".hash"c as int64, 5);
    var nRela: int64 := at; at := self.cg_objPutName(sn, at, ".rela.dyn"c as int64, 9);
    var nEhh:  int64 := at; at := self.cg_objPutName(sn, at, ".eh_frame_hdr"c as int64, 13);
    var nEh:   int64 := at; at := self.cg_objPutName(sn, at, ".eh_frame"c as int64, 9);
    var nDAbb: int64 := at; at := self.cg_objPutName(sn, at, ".debug_abbrev"c as int64, 13);
    var nDInf: int64 := at; at := self.cg_objPutName(sn, at, ".debug_info"c as int64, 11);
    var nDLin: int64 := at; at := self.cg_objPutName(sn, at, ".debug_line"c as int64, 11);
    var nDStr: int64 := at; at := self.cg_objPutName(sn, at, ".debug_str"c as int64, 10);
    var nData: int64 := at; at := self.cg_objPutName(sn, at, ".data"c as int64, 5);
    var nDyn:  int64 := at; at := self.cg_objPutName(sn, at, ".dynamic"c as int64, 8);
    var nInit: int64 := at; at := self.cg_objPutName(sn, at, ".init_array"c as int64, 11);
    var nGot:  int64 := at; at := self.cg_objPutName(sn, at, ".got"c as int64, 4);
    var nShs:  int64 := at; at := self.cg_objPutName(sn, at, ".shstrtab"c as int64, 9);
    if (at > shstrSize) {
      EPrintStrLn("interner fehler: --shared: .shstrtab zu klein (#2124)."c);
      exit(1);
    }
    var iDsym: int64 := 2 + hatNote;
    var iDstr: int64 := iDsym + 1;
    var sh: int64 := buf + shOff + 64;
    self.cg_soShdr(sh, nText, 1, 6, codeOff, codeLen, 0, 0, 16, 0);            sh := sh + 64;
    if (hatNote != 0) {
      self.cg_soShdr(sh, nNote, 7, 2, noteOff, noteSize, 0, 0, 4, 0);         sh := sh + 64;
    }
    self.cg_soShdr(sh, nDsym, 11, 2, dynsymOff, dynsymSize, iDstr, 1, 8, 24);  sh := sh + 64;
    self.cg_soShdr(sh, nDstr, 3, 2, dynstrOff, dsLen, 0, 0, 1, 0);             sh := sh + 64;
    self.cg_soShdr(sh, nHash, 5, 2, hashOff, hashSize, iDsym, 0, 8, 4);        sh := sh + 64;
    self.cg_soShdr(sh, nRela, 4, 2, relaOff, relaSize, iDsym, 0, 8, 24);       sh := sh + 64;
    self.cg_soShdr(sh, nEhh, 1, 2, ehHdrOff, ehHdrSize, 0, 0, 4, 0);          sh := sh + 64;
    self.cg_soShdr(sh, nEh, 1, 2, ehOff, ehSize, 0, 0, 8, 0);                  sh := sh + 64;
    self.cg_soShdr(sh, nData, 1, 3, dataOff, dataLen, 0, 0, 16, 0);            sh := sh + 64;
    self.cg_soShdr(sh, nDyn, 6, 3, dynOff, dynSize, iDstr, 0, 8, 16);          sh := sh + 64;
    self.cg_soShdr(sh, nInit, 14, 3, initOff, 8, 0, 0, 8, 8);                  sh := sh + 64;
    self.cg_soShdr(sh, nGot, 1, 3, gotOff, gotSize, 0, 0, 8, 8);               sh := sh + 64;
    self.cg_soShdr(sh, nShs, 3, 0, 0, shstrSize, 0, 0, 1, 0);
    poke64(sh + 24, shstrOff);                 // nicht geladen: sh_addr 0, nur sh_offset
    if (self.debugMode != 0) {
      // Nicht geladen wie .shstrtab: sh_addr 0. .debug_str mit SHF_MERGE|SHF_STRINGS.
      sh := sh + 64; self.cg_soShdr(sh, nDAbb, 1, 0, 0, dg.abbrevLen, 0, 0, 1, 0); poke64(sh + 24, dAbb);
      sh := sh + 64; self.cg_soShdr(sh, nDInf, 1, 0, 0, dg.infoLen, 0, 0, 1, 0);   poke64(sh + 24, dInf);
      sh := sh + 64; self.cg_soShdr(sh, nDLin, 1, 0, 0, dg.lineLen, 0, 0, 1, 0);   poke64(sh + 24, dLin);
      sh := sh + 64; self.cg_soShdr(sh, nDStr, 1, 48, 0, dg.strLen, 0, 0, 1, 1);   poke64(sh + 24, dStr);
    }

    EmitWriteFile(path, buf, fileSize);   // #1682: schreibt oder scheitert laut
  }

  fn WriteELF(path: pchar) {
    // #2144: alle drei Schreiber hinter WriteELF (statisch, PT_LYXRELOC,
    // dynamisch/FFI) legen den Code bei CG_CODE_OFF ab.
    self.codeFileOff := CG_CODE_OFF;
    self.codeStartVa := CG_ELF_BASE + CG_CODE_OFF;
    // WP-34: refuse to write a binary produced by an overflowed buffer
    if (self.codeOverflow != 0 || self.dataOverflow != 0) {
      EPrintStrLn("error: codegen: WriteELF abgebrochen — Puffer-512-MB-Limit überschritten"c);
      // #1682: Auch hier wurde bisher nur gemeldet und zurueckgekehrt — lyxc
      // endete mit Status 0, obwohl keine Datei entstanden ist.
      exit(EMIT_EX_IOERR);
    }
    // FFI programs need a dynamically-linked ELF (PT_INTERP + .dynamic + GOT
    // relocations against the named shared libraries). Programs with no extern
    // imports keep the byte-identical static path below — preserving the
    // self-host singularity, since lyxc itself uses no FFI.
    if (self.externCount > 0) {
      self.cg_writeELFDynamic(path);
      return;
    }
    // LyxOS-Reloc Step 1: Release-Build mit Base-Relocs (Klassen/VMT) → ELF mit PT_LYXRELOC,
    // damit der LyxOS-Loader bei abweichender Ladebasis fixupen kann (statt vmm-Aliasing).
    // Debug/Watermark behalten den exakten Alt-Pfad (unberührt). Linux ignoriert PT_LYXRELOC.
    if (self.debugMode == 0 && self.licenseKey == 0 && self.baseRelocCount > 0) {
      self.cg_writeELFReloc(path);
      return;
    }
    var totalCode: int64 := self.codeLen;
    var totalData: int64 := self.dataLen;
    var baseSize:  int64 := CG_CODE_OFF + totalCode + totalData;

    // WP-BC-25: allocate DwarfGen at function scope so it spans both debug blocks
    var dg: DwarfGen := new DwarfGen();
    dg.Init();
    // #2135: DwarfGen.Init nimmt 120 an — den Codeanfang von vor WP-6 (ein
    // Programmkopf). Seit zwei Programmkoepfen liegt er bei CG_CODE_OFF; jede
    // Adresse in .debug_info/.debug_line lag 56 Byte zu frueh.
    dg.codeOff := CG_CODE_OFF;

    var abbrevSize: int64 := 0;
    var infoSize:   int64 := 0;
    var lineSize:   int64 := 0;
    var strSize:    int64 := 0;
    if (self.debugMode != 0) {
      // #2144: dieselbe Funktionstabelle wie die .so (cg_dwarfFunktionen) —
      // hier stand bis 1.2.16A noch "Ende = naechste Marke in der Tabelle",
      // was fuer Aliasmarken (cg_bindConFns) falsche Bereiche ergab.
      self.cg_dwarfFunktionen(dg, totalCode);
      dg.dw_buildAbbrev();
      dg.dw_buildInfo(self.srcFilePath, self.srcFileLen, totalCode);
      dg.dw_buildLine(self.srcFilePath, self.srcFileLen);
      abbrevSize := dg.abbrevLen;
      infoSize   := dg.infoLen;
      lineSize   := dg.lineLen;
      strSize    := dg.strLen;
    }

    // #2144: + ".text\0" (6 Byte) — addr2line sucht die Adresse zuerst in einem
    // Abschnitt mit SHF_ALLOC; ohne .text fand es nichts, egal wie gut das DWARF war.
    var shstrtabSize: int64 := 66;
    var fileSize: int64 := baseSize;
    if (self.debugMode != 0) {
      fileSize := baseSize + abbrevSize + infoSize + lineSize + strSize + shstrtabSize + 448;
    }

    // WP-LIC-10: watermark layout (only in non-debug static builds with a license key)
    // Layout appended after baseSize:
    //   [+0 ..+15] : 16-byte .lyx_lic payload
    //   [+16..+35] : .shstrtab (20 bytes: \0.lyx_lic\0.shstrtab\0)
    //   [+36..+227]: 3 × 64-byte section headers (NULL, .lyx_lic, .shstrtab)
    var hasWatermark: bool := self.licenseKey != 0 && self.debugMode == 0;
    var licPayload: int64 := alloc(16);  // zeroed by mmap
    if hasWatermark {
      // Read source file to compute SHA256(sourceCode)
      var srcHash: int64 := alloc(32);
      var sfd: int64 := open(self.srcFilePath, 0, 0);
      if sfd >= 0 {
        var srcSz: int64 := lseek(sfd, 0, 2);
        lseek(sfd, 0, 0);
        if srcSz > 0 {
          var srcBuf: int64 := alloc(srcSz + 1);
          // WP-27: nur hashen wenn vollständig gelesen (sonst Arena-Müll im Hash).
          if (read(sfd, srcBuf as pchar, srcSz) == srcSz) {
            lic_sha256(srcBuf, srcSz, srcHash);
          }
          free(srcBuf, srcSz + 1);
        }
        close(sfd);
      }
      // fingerprint = HMAC-SHA256(licenseKey, srcHash) → first 8 bytes
      var hmacOut: int64 := alloc(32);
      lic_hmacSha256(self.licenseKey, self.licenseKeyLen, srcHash, 32, hmacOut);
      var fi: int64 := 0;
      memcpy(licPayload, hmacOut, 8);
      free(hmacOut, 32);
      // keyChecksum = SHA256(licenseKey) → first 4 bytes
      var keyHash: int64 := alloc(32);
      lic_sha256(self.licenseKey, self.licenseKeyLen, keyHash);
      var ki: int64 := 0;
      memcpy(licPayload + 8, keyHash, 4);
      free(keyHash, 32);
      free(srcHash, 32);
      // version byte
      poke8(licPayload + 12, 1);
      // bytes 13-15: already zero (padding)
      fileSize := fileSize + 16 + 20 + 192;  // payload + shstrtab + 3×64 section headers
    }

    // Allocate ELF buffer
    var buf: int64 := alloc(fileSize);

    // ELF header (64 bytes)
    poke8(buf, 0x7F);
    poke8(buf + 1,  69);   // 'E'
    poke8(buf + 2,  76);   // 'L'
    poke8(buf + 3,  70);   // 'F'
    poke8(buf + 4,  2);    // ELFCLASS64
    poke8(buf + 5,  1);    // ELFDATA2LSB
    poke8(buf + 6,  1);    // EV_CURRENT
    poke8(buf + 7,  0);    // ELFOSABI_NONE
    // bytes 8-15: padding (mmap zeroed)
    poke16(buf + 16, 2);    // e_type = ET_EXEC
    poke16(buf + 18, 62);   // e_machine = EM_X86_64 (0x3E)
    poke32(buf + 20, 1);    // e_version
    // e_entry = load vaddr + ELF/phdr headers + _start offset (0)
    poke64(buf + 24, CG_ELF_BASE + CG_CODE_OFF);
    poke64(buf + 32, CG_PHDR_OFF);  // e_phoff
    poke64(buf + ELF64_EHDR_OFF_SHOFF, 0);
    poke32(buf + 48, 0);             // e_flags
    poke16(buf + 52, 64);   // e_ehsize
    poke16(buf + 54, 56);   // e_phentsize
    poke16(buf + 56, 2);    // e_phnum — WP-6: two PT_LOAD (RX code + RW data)
    poke16(buf + 58, 64);   // e_shentsize
    poke16(buf + 60, 0);    // e_shnum
    poke16(buf + 62, 0);    // e_shstrndx
    if (self.debugMode != 0) {
      var shoff: int64 := baseSize + abbrevSize + infoSize + lineSize + strSize + shstrtabSize;
      poke64(buf + ELF64_EHDR_OFF_SHOFF, shoff);
      poke16(buf + 60, 7);      // e_shnum = 7 (#2144: + .text)
      poke16(buf + 62, 5);      // e_shstrndx = 5
    }
    if hasWatermark {
      // e_shoff = after code+data+payload+shstrtab
      poke64(buf + ELF64_EHDR_OFF_SHOFF, baseSize + 16 + 20);
      poke16(buf + 60, 3);                    // e_shnum = 3
      poke16(buf + 62, 2);                    // e_shstrndx = 2 (.shstrtab)
    }

    // WP-6: Two PT_LOAD headers for W^X separation.
    // phdr1 (offset 64,  56 bytes): RX — ELF header + phdrs + code (page-aligned)
    // phdr2 (offset 120, 56 bytes): RW — data only
    var rxSize: int64 := CG_CODE_OFF + totalCode;  // headers + page-aligned code
    var rwOff:  int64 := rxSize;                   // data starts right after
    var rwVaddr: int64 := CG_ELF_BASE + rwOff;

    // PT_LOAD #1: RX (read + execute) — code segment
    var ph: int64 := buf + CG_PHDR_OFF;
    poke32(ph,      1);              // p_type = PT_LOAD
    poke32(ph + 4,  5);              // p_flags = PF_R|PF_X
    poke64(ph + ELF64_PHDR_OFF_OFFSET, 0);
    poke64(ph + 16, CG_ELF_BASE);   // p_vaddr
    poke64(ph + 24, CG_ELF_BASE);   // p_paddr
    poke64(ph + ELF64_PHDR_OFF_FILESZ, rxSize);
    poke64(ph + ELF64_PHDR_OFF_MEMSZ,  rxSize);
    poke64(ph + ELF64_PHDR_OFF_ALIGN,  4096);

    // PT_LOAD #2: RW (read + write) — data segment
    var ph2: int64 := buf + CG_PHDR_OFF + 56;
    poke32(ph2,      1);             // p_type = PT_LOAD
    poke32(ph2 + 4,  6);             // p_flags = PF_R|PF_W
    poke64(ph2 + ELF64_PHDR_OFF_OFFSET, rwOff);
    poke64(ph2 + 16, rwVaddr);       // p_vaddr
    poke64(ph2 + 24, rwVaddr);       // p_paddr
    poke64(ph2 + ELF64_PHDR_OFF_FILESZ, totalData);
    poke64(ph2 + ELF64_PHDR_OFF_MEMSZ,  totalData);
    poke64(ph2 + ELF64_PHDR_OFF_ALIGN,  4096);

    // Copy code
    var i: int64 := 0;
    memcpy(buf + CG_CODE_OFF, self.code, totalCode);

    // Copy string data
    i := 0;
    memcpy(buf + CG_CODE_OFF + totalCode, self.data, totalData);

    // WP-BC-25: emit DWARF debug sections and section header table
    if (self.debugMode != 0) {
      var abbrevOff:   int64 := baseSize;
      var infoOff:     int64 := abbrevOff + abbrevSize;
      var lineOff:     int64 := infoOff   + infoSize;
      var strOff:      int64 := lineOff   + lineSize;
      var shstrtabOff: int64 := strOff    + strSize;

      // Copy .debug_abbrev
      i := 0;
      memcpy(buf+abbrevOff, dg.abbrevBuf, abbrevSize);
      // Copy .debug_info
      i := 0;
      memcpy(buf+infoOff, dg.infoBuf, infoSize);
      // Copy .debug_line
      i := 0;
      memcpy(buf+lineOff, dg.lineBuf, lineSize);
      // Copy .debug_str
      i := 0;
      memcpy(buf+strOff, dg.strBuf, strSize);

      // Build .shstrtab (60 bytes)
      // "\0.debug_abbrev\0.debug_info\0.debug_line\0.debug_str\0.shstrtab\0"
      var ss: int64 := buf + shstrtabOff;
      poke8(ss,0);
      poke8(ss+1,46);poke8(ss+2,100);poke8(ss+3,101);poke8(ss+4,98);poke8(ss+5,117);
      poke8(ss+6,103);poke8(ss+7,95);poke8(ss+8,97);poke8(ss+9,98);poke8(ss+10,98);
      poke8(ss+11,114);poke8(ss+12,101);poke8(ss+13,118);poke8(ss+14,0);
      poke8(ss+15,46);poke8(ss+16,100);poke8(ss+17,101);poke8(ss+18,98);poke8(ss+19,117);
      poke8(ss+20,103);poke8(ss+21,95);poke8(ss+22,105);poke8(ss+23,110);poke8(ss+24,102);
      poke8(ss+25,111);poke8(ss+26,0);
      poke8(ss+27,46);poke8(ss+28,100);poke8(ss+29,101);poke8(ss+30,98);poke8(ss+31,117);
      poke8(ss+32,103);poke8(ss+33,95);poke8(ss+34,108);poke8(ss+35,105);poke8(ss+36,110);
      poke8(ss+37,101);poke8(ss+38,0);
      poke8(ss+39,46);poke8(ss+40,100);poke8(ss+41,101);poke8(ss+42,98);poke8(ss+43,117);
      poke8(ss+44,103);poke8(ss+45,95);poke8(ss+46,115);poke8(ss+47,116);poke8(ss+48,114);
      poke8(ss+49,0);
      poke8(ss+50,46);poke8(ss+51,115);poke8(ss+52,104);poke8(ss+53,115);poke8(ss+54,116);
      poke8(ss+55,114);poke8(ss+56,116);poke8(ss+57,97);poke8(ss+58,98);poke8(ss+59,0);
      self.cg_objPutName(ss, 60, ".text"c as int64, 5);   // #2144, NUL aus dem Nullpuffer

      // Section header table (6 × 64 bytes; [0]=NULL, already zero from mmap)
      var sh0: int64 := buf + shstrtabOff + shstrtabSize;
      var sh: int64 := 0;

      // [1] .debug_abbrev: sh_name=1, SHT_PROGBITS
      sh := sh0 + 64;
      poke32(sh,1);  poke32(sh+4,1);
      poke64(sh+24,abbrevOff); poke64(sh+32,abbrevSize); poke64(sh+48,1);

      // [2] .debug_info: sh_name=15, SHT_PROGBITS
      sh := sh0 + 128;
      poke32(sh,15); poke32(sh+4,1);
      poke64(sh+24,infoOff); poke64(sh+32,infoSize); poke64(sh+48,1);

      // [3] .debug_line: sh_name=27, SHT_PROGBITS
      sh := sh0 + 192;
      poke32(sh,27); poke32(sh+4,1);
      poke64(sh+24,lineOff); poke64(sh+32,lineSize); poke64(sh+48,1);

      // [4] .debug_str: sh_name=39, SHT_PROGBITS, SHF_MERGE|SHF_STRINGS=0x30, entsize=1
      sh := sh0 + 256;
      poke32(sh,39); poke32(sh+4,1);
      poke64(sh+8,48); poke64(sh+24,strOff); poke64(sh+32,strSize);
      poke64(sh+48,1); poke64(sh+56,1);

      // [5] .shstrtab: sh_name=50, SHT_STRTAB=3
      sh := sh0 + 320;
      poke32(sh,50); poke32(sh+4,3);
      poke64(sh+24,shstrtabOff); poke64(sh+32,shstrtabSize); poke64(sh+48,1);

      // [6] .text: sh_name=60, SHT_PROGBITS, SHF_ALLOC|SHF_EXECINSTR (#2144)
      sh := sh0 + 384;
      poke32(sh,60); poke32(sh+4,1);
      poke64(sh+8,6); poke64(sh+16,CG_ELF_BASE + CG_CODE_OFF);
      poke64(sh+24,CG_CODE_OFF); poke64(sh+32,totalCode); poke64(sh+48,16);
    }

    // WP-LIC-10: embed .lyx_lic section (non-debug static builds only)
    if hasWatermark {
      // Write 16-byte payload at baseSize
      var wi: int64 := 0;
      memcpy(buf + baseSize, licPayload, 16);

      // .shstrtab at baseSize+16 (20 bytes):
      // \0.lyx_lic\0.shstrtab\0
      var ss: int64 := buf + baseSize + 16;
      poke8(ss, 0);
      poke8(ss+1,46);poke8(ss+2,108);poke8(ss+3,121);poke8(ss+4,120);   // .lyx
      poke8(ss+5,95);poke8(ss+6,108);poke8(ss+7,105);poke8(ss+8,99);    // _lic
      poke8(ss+9,0);
      poke8(ss+10,46);poke8(ss+11,115);poke8(ss+12,104);poke8(ss+13,115); // .shs
      poke8(ss+14,116);poke8(ss+15,114);poke8(ss+16,116);poke8(ss+17,97); // trtab
      poke8(ss+18,98);poke8(ss+19,0);

      // Section header table at baseSize+16+20 = baseSize+36
      // [0] NULL — all zeros (already zeroed by mmap)
      var sh0: int64 := buf + baseSize + 36;

      // [1] .lyx_lic: SHT_PROGBITS=1, no flags, offset=baseSize, size=16, align=1
      var sh1: int64 := sh0 + 64;
      poke32(sh1,    1);          // sh_name = 1 (offset in shstrtab)
      poke32(sh1+4,  1);          // sh_type = SHT_PROGBITS
      poke64(sh1+8,  0);          // sh_flags = 0 (not loaded, not executable)
      poke64(sh1+16, 0);          // sh_addr = 0
      poke64(sh1+24, baseSize);   // sh_offset = start of payload in file
      poke64(sh1+32, 16);         // sh_size = 16
      poke64(sh1+48, 1);          // sh_addralign = 1

      // [2] .shstrtab: SHT_STRTAB=3, offset=baseSize+16, size=20, align=1
      var sh2: int64 := sh0 + 128;
      poke32(sh2,    10);          // sh_name = 10
      poke32(sh2+4,  3);           // sh_type = SHT_STRTAB
      poke64(sh2+24, baseSize+16); // sh_offset
      poke64(sh2+32, 20);          // sh_size
      poke64(sh2+48, 1);           // sh_addralign = 1
    }
    free(licPayload, 16);

    // Write ELF binary to file (O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0755 = 493)
    EmitWriteFile(path, buf, fileSize);   // #1682: schreibt oder scheitert laut
  }

  // ------------------------------------------------------------------
  // Dynamically-linked ET_EXEC writer (FFI / extern fn ... link "...")
  //
  // Layout — code and data keep their static file offsets/VAs so that every
  // absolute address baked in during codegen (VMT pointers, globals) stays
  // valid; we only relocate the program-header table to the end of the file
  // and append the dynamic-linking sections after .data:
  //
  //   [0,64)    ELF header (e_phoff -> phdrs at end, e_phnum = 3)
  //   [64,..)   .interp = "/lib64/ld-linux-x86-64.so.2"  (fits the 56B gap)
  //   [120,..)  code           (unchanged VA = base + 120)
  //   [..]      data           (unchanged)
  //   [..]      .dynstr .dynsym .hash .rela.dyn .got .dynamic
  //   [..]      program headers: PT_LOAD, PT_INTERP, PT_DYNAMIC
  //
  // Each imported symbol gets a GOT slot resolved eagerly by ld.so via an
  // R_X86_64_GLOB_DAT relocation (DT_FLAGS = DF_BIND_NOW), so no PLT/lazy
  // resolver is needed: call sites are `call *slot(%rip)` (FF 15).
  // ------------------------------------------------------------------
  fn cg_writeELFDynamic(path: pchar) {
    var totalCode: int64 := self.codeLen;
    var totalData: int64 := self.dataLen;
    var nExt: int64 := self.externCount;

    var interpStr: pchar := "/lib64/ld-linux-x86-64.so.2";
    var interpOff: int64 := 64;
    var interpLen: int64 := StrLen(interpStr) + 1;   // include NUL terminator

    var codeOff: int64 := CG_CODE_OFF;               // 176: ELF hdr (64) + 2×phdr (56+56)
    var dataOff: int64 := codeOff + totalCode;        // page-aligned by Generate() padding

    // --- build .dynstr (\0, then distinct lib names, then symbol names) ---
    var dynstr: int64 := alloc(65536);
    var dsLen:  int64 := 0;
    poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;    // index 0 = ""

    var uniqPtr:    int64 := alloc((nExt + 1) * 8);
    var uniqLen:    int64 := alloc((nExt + 1) * 8);
    var uniqStrOff: int64 := alloc((nExt + 1) * 8);
    var uniqCount:  int64 := 0;
    var symStrOff:  int64 := alloc((nExt + 1) * 8);

    var ei: int64 := 0;
    while (ei < nExt) {
      var eb: int64 := self.externSyms + ei * CG_EXTERN_SZ;
      var lp: int64 := peek64(eb + CG_EXTERN_OFF_LIBPTR);
      var ll: int64 := peek64(eb + CG_EXTERN_OFF_LIBLEN);
      var u: int64 := 0;
      var found: int64 := -1;
      while (u < uniqCount) {
        if (peek64(uniqLen + u * 8) == ll &&
            self.cg_seq(peek64(uniqPtr + u * 8) as pchar, ll, lp as pchar, ll)) {
          found := u; u := uniqCount;
        } else {
          u += 1;
        }
      }
      if (found < 0) {
        var off: int64 := dsLen;
        var j: int64 := 0;
        memcpy(dynstr + dsLen, lp, ll); dsLen := dsLen + ll;
        poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
        poke64(uniqPtr + uniqCount * 8, lp);
        poke64(uniqLen + uniqCount * 8, ll);
        poke64(uniqStrOff + uniqCount * 8, off);
        uniqCount += 1;
      }
      ei += 1;
    }
    ei := 0;
    while (ei < nExt) {
      var eb2: int64 := self.externSyms + ei * CG_EXTERN_SZ;
      var np: int64 := peek64(eb2);
      var nl: int64 := peek64(eb2 + CG_EXTERN_OFF_NAMELEN);
      var off2: int64 := dsLen;
      var j2: int64 := 0;
      memcpy(dynstr + dsLen, np, nl); dsLen := dsLen + nl;
      poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
      poke64(symStrOff + ei * 8, off2);
      ei += 1;
    }
    var dynstrSize: int64 := dsLen;

    // --- section offsets (8-byte aligned via ((x+7)>>3)<<3) ---
    var dynstrOff: int64 := ((dataOff + totalData + 7) >> 3) << 3;
    var dynsymOff: int64 := ((dynstrOff + dynstrSize + 7) >> 3) << 3;
    var dynsymSize: int64 := (nExt + 1) * 24;
    var hashOff: int64 := dynsymOff + dynsymSize;            // 24*k is 8-aligned
    var nchain: int64 := nExt + 1;
    var hashSize: int64 := (3 + nchain) * 4;                  // nbucket,nchain,bucket[1],chain[]
    var relaOff: int64 := ((hashOff + hashSize + 7) >> 3) << 3;
    var relaSize: int64 := nExt * 24;
    var gotOff: int64 := relaOff + relaSize;                  // 8-aligned
    var gotSize: int64 := nExt * 8;
    var dynOff: int64 := gotOff + gotSize;                    // 8-aligned
    var dynCount: int64 := uniqCount + 11;                    // NEEDED*u + 11 fixed tags
    var dynSize: int64 := dynCount * 16;
    var phdrOff: int64 := ((dynOff + dynSize + 7) >> 3) << 3;
    var phnum: int64 := 4;                           // WP-6b: +1 PT_LOAD for RX/RW split
    var fileSize: int64 := phdrOff + phnum * 56;

    // --- patch extern call sites: disp32 = gotSlotVA - ripVA ---
    var pi: int64 := 0;
    while (pi < self.patchCount) {
      var pb: int64 := self.patches + pi * CG_PATCH_SZ;
      if (peek64(pb + 24) == CG_PATCH_EXTERN) {
        var cOff:   int64 := peek64(pb);
        var exIdx:  int64 := peek64(pb + CG_PATCH_OFF_NAMEPTR);
        var gotVA:  int64 := CG_ELF_BASE + gotOff + exIdx * 8;
        var ripVA:  int64 := CG_ELF_BASE + codeOff + cOff + 4;
        poke32(self.code + cOff, gotVA - ripVA);
      }
      pi += 1;
    }

    // --- assemble the file image ---
    var buf: int64 := alloc(fileSize);

    // ELF header
    poke8(buf, 0x7F); poke8(buf + 1, 69); poke8(buf + 2, 76); poke8(buf + 3, 70);
    poke8(buf + 4, 2); poke8(buf + 5, 1); poke8(buf + 6, 1); poke8(buf + 7, 0);
    poke16(buf + 16, 2);              // e_type = ET_EXEC
    poke16(buf + 18, 62);             // e_machine = EM_X86_64
    poke32(buf + 20, 1);              // e_version
    poke64(buf + 24, CG_ELF_BASE + codeOff);  // e_entry
    poke64(buf + ELF64_EHDR_OFF_PHOFF, phdrOff);
    poke64(buf + ELF64_EHDR_OFF_SHOFF, 0);
    poke32(buf + 48, 0);              // e_flags
    poke16(buf + 52, 64);             // e_ehsize
    poke16(buf + 54, 56);             // e_phentsize
    poke16(buf + 56, phnum);          // e_phnum
    poke16(buf + 58, 64);             // e_shentsize
    poke16(buf + 60, 0);              // e_shnum
    poke16(buf + 62, 0);              // e_shstrndx

    // .interp (in the 56-byte gap between phdr-area and code)
    var ii: int64 := 0;
    memcpy(buf + interpOff, interpStr as int64, interpLen);

    // code (extern disps now patched)
    var ci: int64 := 0;
    memcpy(buf + codeOff, self.code, totalCode);
    // data
    var di: int64 := 0;
    memcpy(buf + dataOff, self.data, totalData);

    // .dynstr
    var si: int64 := 0;
    memcpy(buf + dynstrOff, dynstr, dynstrSize);

    // .dynsym — [0] = null symbol (zeroed); [i+1] = UNDEF GLOBAL FUNC import
    ei := 0;
    while (ei < nExt) {
      var sy: int64 := buf + dynsymOff + (ei + 1) * 24;
      poke32(sy, peek64(symStrOff + ei * 8));  // st_name
      poke8(sy + 4, 0x12);                      // st_info = STB_GLOBAL|STT_FUNC
      poke8(sy + 5, 0);                          // st_other
      poke16(sy + 6, 0);                         // st_shndx = SHN_UNDEF
      ei += 1;
    }

    // .hash — minimal SysV: nbucket=1, nchain, empty bucket/chains
    poke32(buf + hashOff, 1);          // nbucket
    poke32(buf + hashOff + 4, nchain); // nchain (must equal dynsym count)

    // .rela.dyn — one R_X86_64_GLOB_DAT per import into its GOT slot
    ei := 0;
    while (ei < nExt) {
      var ra: int64 := buf + relaOff + ei * 24;
      poke64(ra, CG_ELF_BASE + gotOff + ei * 8);          // r_offset = GOT slot VA
      poke64(ra + ELF64_RELA_OFF_INFO, ((ei + 1) << 32) | 6);               // r_info = (sym<<32)|R_X86_64_GLOB_DAT
      poke64(ra + ELF64_RELA_OFF_ADDEND, 0);                                  // r_addend
      ei += 1;
    }

    // .got — zero slots (filled by ld.so); already zeroed by mmap

    // .dynamic
    var dp: int64 := buf + dynOff;
    var u2: int64 := 0;
    while (u2 < uniqCount) {
      poke64(dp, 1); poke64(dp + ELF64_DYN_OFF_VAL, peek64(uniqStrOff + u2 * 8)); dp := dp + 16;  // DT_NEEDED
      u2 += 1;
    }
    poke64(dp, 4);  poke64(dp + ELF64_DYN_OFF_VAL, CG_ELF_BASE + hashOff);   dp := dp + 16;  // DT_HASH
    poke64(dp, 5);  poke64(dp + ELF64_DYN_OFF_VAL, CG_ELF_BASE + dynstrOff); dp := dp + 16;  // DT_STRTAB
    poke64(dp, 6);  poke64(dp + ELF64_DYN_OFF_VAL, CG_ELF_BASE + dynsymOff); dp := dp + 16;  // DT_SYMTAB
    poke64(dp, 10); poke64(dp + ELF64_DYN_OFF_VAL, dynstrSize);              dp := dp + 16;  // DT_STRSZ
    poke64(dp, 11); poke64(dp + ELF64_DYN_OFF_VAL, 24);                      dp := dp + 16;  // DT_SYMENT
    poke64(dp, 7);  poke64(dp + ELF64_DYN_OFF_VAL, CG_ELF_BASE + relaOff);   dp := dp + 16;  // DT_RELA
    poke64(dp, 8);  poke64(dp + ELF64_DYN_OFF_VAL, relaSize);                dp := dp + 16;  // DT_RELASZ
    poke64(dp, 9);  poke64(dp + ELF64_DYN_OFF_VAL, 24);                      dp := dp + 16;  // DT_RELAENT
    poke64(dp, 30); poke64(dp + ELF64_DYN_OFF_VAL, 8);                       dp := dp + 16;  // DT_FLAGS = DF_BIND_NOW
    poke64(dp, 0);  poke64(dp + ELF64_DYN_OFF_VAL, 0);                       dp := dp + 16;  // DT_NULL

    // program headers at end of file
    var ph: int64 := buf + phdrOff;

    // WP-6b: PT_LOAD #1 — RX (read + execute): ELF header + .interp + code
    // dataOff is page-aligned (Generate() pads code to 4096-byte boundary)
    var rxSize: int64 := dataOff;
    poke32(ph,      1); poke32(ph + 4, 5);                          // PT_LOAD, PF_R|PF_X
    poke64(ph + ELF64_PHDR_OFF_OFFSET, 0);
    poke64(ph + ELF64_PHDR_OFF_VADDR,  CG_ELF_BASE);
    poke64(ph + ELF64_PHDR_OFF_PADDR,  CG_ELF_BASE);
    poke64(ph + ELF64_PHDR_OFF_FILESZ, rxSize);
    poke64(ph + ELF64_PHDR_OFF_MEMSZ,  rxSize);
    poke64(ph + ELF64_PHDR_OFF_ALIGN,  4096);

    // WP-6b: PT_LOAD #2 — RW (read + write): data + sections + phdrs
    var ph2: int64 := ph + 56;
    var rwOff:  int64 := dataOff;
    var rwSize: int64 := fileSize - rwOff;
    poke32(ph2,      1); poke32(ph2 + 4, 6);                        // PT_LOAD, PF_R|PF_W
    poke64(ph2 + ELF64_PHDR_OFF_OFFSET, rwOff);
    poke64(ph2 + ELF64_PHDR_OFF_VADDR,  CG_ELF_BASE + rwOff);
    poke64(ph2 + ELF64_PHDR_OFF_PADDR,  CG_ELF_BASE + rwOff);
    poke64(ph2 + ELF64_PHDR_OFF_FILESZ, rwSize);
    poke64(ph2 + ELF64_PHDR_OFF_MEMSZ,  rwSize);
    poke64(ph2 + ELF64_PHDR_OFF_ALIGN,  4096);

    // PT_INTERP
    var ph3: int64 := ph + 112;
    poke32(ph3, 3); poke32(ph3 + 4, 4);
    poke64(ph3 + 8, interpOff); poke64(ph3 + 16, CG_ELF_BASE + interpOff); poke64(ph3 + 24, CG_ELF_BASE + interpOff);
    poke64(ph3 + ELF64_PHDR_OFF_FILESZ, interpLen); poke64(ph3 + ELF64_PHDR_OFF_MEMSZ,  interpLen); poke64(ph3 + ELF64_PHDR_OFF_ALIGN,  1);
    // PT_DYNAMIC
    var ph4: int64 := ph + 168;
    poke32(ph4, 2); poke32(ph4 + 4, 6);
    poke64(ph4 + 8, dynOff); poke64(ph4 + 16, CG_ELF_BASE + dynOff); poke64(ph4 + 24, CG_ELF_BASE + dynOff);
    poke64(ph4 + ELF64_PHDR_OFF_FILESZ, dynSize); poke64(ph4 + ELF64_PHDR_OFF_MEMSZ,  dynSize); poke64(ph4 + ELF64_PHDR_OFF_ALIGN,  8);

    EmitWriteFile(path, buf, fileSize);   // #1682: schreibt oder scheitert laut
  }


  // #1370: Die Bytefolgen fuer profile_enter/profile_leave. Sie standen bis
  // 1.1.6D nur im Builtin-Zweig; `--profile` braucht dieselbe Folge an
  // Funktionseintritt und -austritt. Zweimal nebeneinander waere genau die
  // Doppelung, die in dieser Codebasis schon oft auseinandergelaufen ist.
  //
  // dOff = Datenoffset des Eintrags {tsc_start(8), call_count(8), total(8)}.
  // #2249: Je Funktion gibt es EINEN Startwert. Bis 1.2.20G ueberschrieb ein
  // rekursiver Eintritt den Start des aeusseren Aufrufs; dessen Austritt
  // rechnete dann ab dem innersten Eintritt — `rek` meldete weniger Takte als
  // `main`, das es vollstaendig enthaelt. Jetzt zaehlt ein Tiefenzaehler
  // (dOff+24): nur der aeusserste Eintritt setzt den Start, nur der
  // aeusserste Austritt addiert die Dauer. Die Zeit ist damit INKLUSIVE und
  // ohne Doppelzaehlung; die Aufrufzahl zaehlt weiter jeden Aufruf.
  // Wer per throw an einem Austritt vorbei springt, laesst die Tiefe stehen —
  // die Funktion wird dann nicht weiter gemessen (bekannt, wie bei jedem
  // Instrumentierungsprofiler ohne Abwicklungshaken).
  fn cg_profEnterBytes(dOff: int64) {
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05);                   // mov rax, [rip+depth]
    var pt1: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(pt1, dOff + 24, 0, CG_PATCH_STR);
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC0);                   // inc rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05);                   // mov [rip+depth], rax
    var pt2: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(pt2, dOff + 24, 0, CG_PATCH_STR);
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xF8); self.cg_e8(0x01); // cmp rax, 1
    self.cg_e8(0x75); var pInnen: int64 := self.codeLen; self.cg_e8(0);     // jne innen (schon aktiv)
    var nachJ: int64 := self.codeLen;
    self.cg_e8(0x0F); self.cg_e8(0x31);                                      // rdtsc
    self.cg_e8(0x48); self.cg_e8(0xC1); self.cg_e8(0xE2); self.cg_e8(0x20); // shl rdx, 32
    self.cg_e8(0x48); self.cg_e8(0x09); self.cg_e8(0xD0);                   // or rax, rdx
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05);                   // mov [rip+start], rax
    var pp: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(pp, dOff, 0, CG_PATCH_STR);
    cg_patchRel8Wert(self.code, pInnen, self.codeLen - nachJ);
  }

  fn cg_profLeaveBytes(dOff: int64) {
        // call_count += 1 (jeder Aufruf, auch rekursive)
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05);
        var plP4: int64 := self.codeLen; self.cg_e32(0);
        self.cg_addPatch(plP4, dOff + 8, 0, CG_PATCH_STR);       // mov rax, [count]
        self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC0);  // inc rax
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05);
        var plP5: int64 := self.codeLen; self.cg_e32(0);
        self.cg_addPatch(plP5, dOff + 8, 0, CG_PATCH_STR);       // mov [count], rax
        // #2249: Tiefe -1; nur der aeusserste Austritt (Tiefe 0) misst.
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05);
        var plT1: int64 := self.codeLen; self.cg_e32(0);
        self.cg_addPatch(plT1, dOff + 24, 0, CG_PATCH_STR);      // mov rax, [depth]
        self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC8);  // dec rax
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05);
        var plT2: int64 := self.codeLen; self.cg_e32(0);
        self.cg_addPatch(plT2, dOff + 24, 0, CG_PATCH_STR);      // mov [depth], rax
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x75); var plInnen: int64 := self.codeLen; self.cg_e8(0);   // jnz innen
        var plNach: int64 := self.codeLen;
        // rdtsc → rax (current TSC)
        self.cg_e8(0x0F); self.cg_e8(0x31);
        self.cg_e8(0x48); self.cg_e8(0xC1); self.cg_e8(0xE2); self.cg_e8(0x20);
        self.cg_e8(0x48); self.cg_e8(0x09); self.cg_e8(0xD0);
        // mov rcx, [rip+rel32] → tsc_start at dOff+0
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x0D);
        var plP1: int64 := self.codeLen; self.cg_e32(0);
        self.cg_addPatch(plP1, dOff, 0, CG_PATCH_STR);
        // delta = rax - rcx (elapsed cycles)
        self.cg_e8(0x48); self.cg_e8(0x29); self.cg_e8(0xC8);  // sub rax, rcx
        // mov rdx, [rip+rel32] → total_cycles at dOff+16
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x15);
        var plP2: int64 := self.codeLen; self.cg_e32(0);
        self.cg_addPatch(plP2, dOff + 16, 0, CG_PATCH_STR);
        // add rdx, rax (total_cycles += delta)
        self.cg_e8(0x48); self.cg_e8(0x01); self.cg_e8(0xC2);  // add rdx, rax
        // mov [rip+rel32], rdx → total_cycles at dOff+16
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x15);
        var plP3: int64 := self.codeLen; self.cg_e32(0);
        self.cg_addPatch(plP3, dOff + 16, 0, CG_PATCH_STR);
        cg_patchRel8Wert(self.code, plInnen, self.codeLen - plNach);
  }


  // #1370: Der Bericht. Er wird zur UEBERSETZUNGSZEIT ausgerollt — je Eintrag
  // eine feste Folge Druckbefehle. Deshalb muss er nach allen Funktionen
  // stehen: wer ihn frueher emittiert, druckt nur die bis dahin bekannten
  // Eintraege. Bei `--profile` liegt er darum in einer eigenen Helferfunktion
  // am Ende des Codes, die `main` beim Verlassen ruft.
  fn cg_profReportBytes() {
      // WP-BC-40: profile_report() — print stats for all registered profiling entries.
      // Compile-time unroll: emit print code for each entry known at this point.
      if (self.profEntryCount > 0) {
        // Pre-allocate label strings in data section once
        var prHdrOff: int64 := self.dataLen;
        // "[PROFILE] " (10 bytes)
        self.cg_edata(91);  self.cg_edata(80);  self.cg_edata(82);  // "[PR"
        self.cg_edata(79);  self.cg_edata(70);  self.cg_edata(73);  // "OFI"
        self.cg_edata(76);  self.cg_edata(69);  self.cg_edata(93);  // "LE]"
        self.cg_edata(32);                                           // " "
        var prColOff: int64 := self.dataLen;
        // ": " (2 bytes)
        self.cg_edata(58); self.cg_edata(32);
        var prCallsOff: int64 := self.dataLen;
        // " calls, " (8 bytes)
        self.cg_edata(32);  self.cg_edata(99);  self.cg_edata(97);  // " ca"
        self.cg_edata(108); self.cg_edata(108); self.cg_edata(115); // "lls"
        self.cg_edata(44);  self.cg_edata(32);                      // ", "
        var prTotalOff: int64 := self.dataLen;
        // " cycles total, " (15 bytes)
        self.cg_edata(32);  self.cg_edata(99);  self.cg_edata(121); // " cy"
        self.cg_edata(99);  self.cg_edata(108); self.cg_edata(101); // "cle"
        self.cg_edata(115); self.cg_edata(32);  self.cg_edata(116); // "s t"
        self.cg_edata(111); self.cg_edata(116); self.cg_edata(97);  // "ota"
        self.cg_edata(108); self.cg_edata(44);  self.cg_edata(32);  // "l, "
        var prAvgOff: int64 := self.dataLen;
        // " cycles avg\n" (12 bytes)
        self.cg_edata(32);  self.cg_edata(99);  self.cg_edata(121); // " cy"
        self.cg_edata(99);  self.cg_edata(108); self.cg_edata(101); // "cle"
        self.cg_edata(115); self.cg_edata(32);  self.cg_edata(97);  // "s a"
        self.cg_edata(118); self.cg_edata(103); self.cg_edata(10);  // "vg\n"
        // #2259: Der Bericht wird nach GESAMTTAKTEN sortiert ausgegeben.
        //
        // Die Druckbloecke bleiben ausgerollt (einer je Eintrag, Datenadressen
        // zur Uebersetzungszeit bekannt) — sortieren laesst sich daran nichts,
        // denn die Takte stehen erst zur Laufzeit fest. Darum liegt jetzt eine
        // Schleife herum, die je Runde den groessten noch nicht gedruckten
        // Eintrag auswaehlt und nur dessen Block ausfuehrt. O(n^2) ist bei
        // Berichtsgroesse unerheblich.
        //
        // KEINE MERKSPALTE: als "schon gedruckt" dient die Aufrufzahl selbst,
        // die nach dem Druck auf 0 gesetzt wird. Eintraege mit 0 Aufrufen sind
        // seit #2249 ohnehin uebersprungen, der Filter steht also schon da.
        // Der Bericht ist das Letzte, was laeuft (main-Epilog) — danach liest
        // die Zahl niemand mehr.
        //
        // ALLE SCHLEIFENZUSTAENDE LIEGEN IN DATENZELLEN, nicht in Registern:
        // zwischen Auswahl und Druck laufen die vorhandenen Druckblöcke, die
        // rax/rcx/rdx/rdi/rsi frei benutzen. r11 traegt nur kurzzeitig die
        // Adresse einer Zelle.
        //
        // Adressen werden ueber `lea r11,[rip+d]` geladen und NICHT ueber eine
        // rip-relative Form mit angehaengtem Immediate: CG_PATCH_STR rechnet
        // den Abstand ab dem Ende des disp32-Feldes (cg_applyPatches:
        // `codeLen - codeOff - 4 + dataOff`), ein nachfolgendes imm32 wuerde
        // das Ziel um vier Byte verschieben.
        var prCurOff: int64 := self.dataLen;     // Index des Siegers, -1 = keiner
        var prC2: int64 := 0; while prC2 < 8 { self.cg_edata(0); prC2 += 1; }
        var prBestOff: int64 := self.dataLen;    // groesste Taktzahl der Runde
        var prB2: int64 := 0; while prB2 < 8 { self.cg_edata(0); prB2 += 1; }

        var prOben: int64 := self.codeLen;       // Marke: Anfang jeder Runde
        // mov qword [cur], -1
        self.cg_e8(0x4C); self.cg_e8(0x8D); self.cg_e8(0x1D);
        var prL1: int64 := self.codeLen; self.cg_e32(0);
        self.cg_addPatch(prL1, prCurOff, 0, CG_PATCH_STR);
        self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0x03); self.cg_e32(0 - 1);
        // mov qword [best], 0
        self.cg_e8(0x4C); self.cg_e8(0x8D); self.cg_e8(0x1D);
        var prL2: int64 := self.codeLen; self.cg_e32(0);
        self.cg_addPatch(prL2, prBestOff, 0, CG_PATCH_STR);
        self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0x03); self.cg_e32(0);

        // Auswahl: je Eintrag pruefen, ob er die bisher groesste Taktzahl hat.
        var prSel: int64 := 0;
        while (prSel < self.profEntryCount) {
          var prSB: int64 := self.profEntries + prSel * 32;
          var prSD: int64 := peek64(prSB + CG_PR_OFF_DOFF);
          // lea r11,[count]; mov rax,[r11]; test rax,rax; jz weiter
          self.cg_e8(0x4C); self.cg_e8(0x8D); self.cg_e8(0x1D);
          var prS1: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prS1, prSD + 8, 0, CG_PATCH_STR);
          self.cg_e8(0x49); self.cg_e8(0x8B); self.cg_e8(0x03);
          self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
          self.cg_e8(0x0F); self.cg_e8(0x84);
          var prSW: int64 := self.codeLen; self.cg_e32(0);
          // lea r11,[total]; mov rax,[r11]
          self.cg_e8(0x4C); self.cg_e8(0x8D); self.cg_e8(0x1D);
          var prS2: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prS2, prSD + 16, 0, CG_PATCH_STR);
          self.cg_e8(0x49); self.cg_e8(0x8B); self.cg_e8(0x03);
          // lea r11,[best]; cmp rax,[r11]; jbe weiter
          self.cg_e8(0x4C); self.cg_e8(0x8D); self.cg_e8(0x1D);
          var prS3: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prS3, prBestOff, 0, CG_PATCH_STR);
          self.cg_e8(0x49); self.cg_e8(0x3B); self.cg_e8(0x03);
          self.cg_e8(0x0F); self.cg_e8(0x86);
          var prSW2: int64 := self.codeLen; self.cg_e32(0);
          // mov [r11],rax  (best := total)
          self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0x03);
          // lea r11,[cur]; mov qword [r11], prSel
          self.cg_e8(0x4C); self.cg_e8(0x8D); self.cg_e8(0x1D);
          var prS4: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prS4, prCurOff, 0, CG_PATCH_STR);
          self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0x03); self.cg_e32(prSel);
          poke32(self.code + prSW,  self.codeLen - prSW - 4);
          poke32(self.code + prSW2, self.codeLen - prSW2 - 4);
          prSel += 1;
        }
        // lea r11,[cur]; cmp qword [r11], -1; je ende
        self.cg_e8(0x4C); self.cg_e8(0x8D); self.cg_e8(0x1D);
        var prL3: int64 := self.codeLen; self.cg_e32(0);
        self.cg_addPatch(prL3, prCurOff, 0, CG_PATCH_STR);
        self.cg_e8(0x49); self.cg_e8(0x83); self.cg_e8(0x3B); self.cg_e8(0xFF);
        self.cg_e8(0x0F); self.cg_e8(0x84);
        var prEnde: int64 := self.codeLen; self.cg_e32(0);

        var prIdx: int64 := 0;
        while (prIdx < self.profEntryCount) {
          var prEBase: int64 := self.profEntries + prIdx * 32;
          var prNLen:  int64 := peek64(prEBase + CG_PR_OFF_NAMELEN);
          var prDOff:  int64 := peek64(prEBase + CG_PR_OFF_DOFF);
          var prNDOff: int64 := peek64(prEBase + CG_PR_OFF_NDOFF);
          // #2259: nur der Sieger dieser Runde druckt.
          // lea r11,[cur]; cmp qword [r11], prIdx; jne weiter
          self.cg_e8(0x4C); self.cg_e8(0x8D); self.cg_e8(0x1D);
          var prG1: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prG1, prCurOff, 0, CG_PATCH_STR);
          self.cg_e8(0x49); self.cg_e8(0x81); self.cg_e8(0x3B); self.cg_e32(prIdx);
          self.cg_e8(0x0F); self.cg_e8(0x85);
          var prGW: int64 := self.codeLen; self.cg_e32(0);
          // #2249: Eintraege ohne Aufruf weglassen — sonst listete jedes
          // Programm alle Funktionen der importierten std mit „0 calls“.
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05);
          var prPZ: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prPZ, prDOff + 8, 0, CG_PATCH_STR);                              // mov rax, [count]
          self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);                              // test rax, rax
          self.cg_e8(0x0F); self.cg_e8(0x84); var prSkip: int64 := self.codeLen; self.cg_e32(0);  // jz weiter
          // Write "[PROFILE] " to stderr
          self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
          var prPH: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prPH, prHdrOff, 0, CG_PATCH_STR);
          self.cg_e8(0xBA); self.cg_e32(10);                                                  // mov edx, 10
          self.cg_e8(0xBF); self.cg_e8(2); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);    // mov edi, 2
          self.cg_e8(0xB8); self.cg_e8(1); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);    // mov eax, 1
          self.cg_e8(0x0F); self.cg_e8(0x05);                                                // syscall
          // Write name
          self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
          var prPN: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prPN, prNDOff, 0, CG_PATCH_STR);
          self.cg_e8(0xBA); self.cg_e32(prNLen);                                              // mov edx, nameLen
          self.cg_e8(0xBF); self.cg_e8(2); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);    // mov edi, 2
          self.cg_e8(0xB8); self.cg_e8(1); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);    // mov eax, 1
          self.cg_e8(0x0F); self.cg_e8(0x05);                                                // syscall
          // Write ": "
          self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
          var prPC: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prPC, prColOff, 0, CG_PATCH_STR);
          self.cg_e8(0xBA); self.cg_e8(2); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);    // mov edx, 2
          self.cg_e8(0xBF); self.cg_e8(2); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);    // mov edi, 2
          self.cg_e8(0xB8); self.cg_e8(1); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);    // mov eax, 1
          self.cg_e8(0x0F); self.cg_e8(0x05);                                                // syscall
          // Load call_count → rdi; print decimal
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3D);
          var prPCnt: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prPCnt, prDOff + 8, 0, CG_PATCH_STR);
          self.cg_emitStderrInt();
          // Write " calls, "
          self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
          var prPCa: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prPCa, prCallsOff, 0, CG_PATCH_STR);
          self.cg_e8(0xBA); self.cg_e8(8); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);    // mov edx, 8
          self.cg_e8(0xBF); self.cg_e8(2); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);    // mov edi, 2
          self.cg_e8(0xB8); self.cg_e8(1); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);    // mov eax, 1
          self.cg_e8(0x0F); self.cg_e8(0x05);                                                // syscall
          // Load total_cycles → rdi; print decimal
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3D);
          var prPTot: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prPTot, prDOff + 16, 0, CG_PATCH_STR);
          self.cg_emitStderrInt();
          // Write " cycles total, "
          self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
          var prPTo: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prPTo, prTotalOff, 0, CG_PATCH_STR);
          self.cg_e8(0xBA); self.cg_e8(15); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);   // mov edx, 15
          self.cg_e8(0xBF); self.cg_e8(2); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);    // mov edi, 2
          self.cg_e8(0xB8); self.cg_e8(1); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);    // mov eax, 1
          self.cg_e8(0x0F); self.cg_e8(0x05);                                                // syscall
          // Compute avg = total_cycles / call_count (0 if count==0)
          // Load total_cycles → rax
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05);
          var prPTA: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prPTA, prDOff + 16, 0, CG_PATCH_STR);
          // Load call_count → rcx
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x0D);
          var prPCA: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prPCA, prDOff + 8, 0, CG_PATCH_STR);
          // test rcx,rcx; jnz +5 .do_div; xor rdi,rdi; jmp +9 .after_div; .do_div: xor rdx,rdx; idiv rcx; mov rdi,rax; .after_div:
          // Layout: [0..2]=test [3..4]=jnz [5..7]=xor_rdi [8..9]=jmp [10..12]=xor_rdx [13..15]=idiv [16..18]=mov_rdi .after_div=[19]
          self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC9);  // test rcx, rcx
          self.cg_e8(0x75); self.cg_e8(0x05);                     // jnz +5 (.do_div at [10])
          self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xFF);  // xor rdi, rdi
          self.cg_e8(0xEB); self.cg_e8(0x09);                     // jmp +9 (.after_div at [19])
          // .do_div: [10]
          self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);  // xor rdx, rdx
          self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);  // idiv rcx
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);  // mov rdi, rax
          // .after_div: print avg
          self.cg_emitStderrInt();
          // Write " cycles avg\n"
          self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
          var prPAv: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prPAv, prAvgOff, 0, CG_PATCH_STR);
          self.cg_e8(0xBA); self.cg_e8(12); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);   // mov edx, 12
          self.cg_e8(0xBF); self.cg_e8(2); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);    // mov edi, 2
          self.cg_e8(0xB8); self.cg_e8(1); self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);    // mov eax, 1
          self.cg_e8(0x0F); self.cg_e8(0x05);                                                // syscall
          // #2259: gedruckt — Aufrufzahl auf 0, damit dieser Eintrag in der
          // naechsten Runde nicht wieder gewinnt.
          self.cg_e8(0x4C); self.cg_e8(0x8D); self.cg_e8(0x1D);
          var prZ1: int64 := self.codeLen; self.cg_e32(0);
          self.cg_addPatch(prZ1, prDOff + 8, 0, CG_PATCH_STR);
          self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0x03); self.cg_e32(0);
          poke32(self.code + prSkip, self.codeLen - prSkip - 4);   // #2249: weiter
          poke32(self.code + prGW,   self.codeLen - prGW - 4);     // #2259: nicht der Sieger
          prIdx += 1;
        }
        // Naechste Runde.
        self.cg_e8(0xE9); self.cg_e32(prOben - self.codeLen - 4);
        poke32(self.code + prEnde, self.codeLen - prEnde - 4);     // #2259: kein Kandidat mehr
      }
      self.cg_zeroRax();

  }

  // #1947: Rueckgabewert von mmap pruefen, statt ihn als Adresse zu benutzen.
  //
  // Erwartet rax unmittelbar nach dem `syscall`. Der Fehlerbereich von mmap
  // ist [-4095, -1]; unsigned verglichen liegen genau diese Werte oberhalb
  // von -4095. Im Erfolgsfall bleibt rax unveraendert, der Aufrufer rechnet
  // wie bisher weiter.
  //
  // Bis 1.1.19B stand hier nichts. Schlug die Anforderung fehl — etwa weil
  // RLIMIT_AS erschoepft war —, lief `-ENOMEM` (0xFFFFFFFFFFFFFFF4) als
  // Zeiger weiter, und der naechste Schreibzugriff traf ihn: SIGSEGV, rc 139.
  // Aus "kein Speicher" wurde ein Absturz ohne Aussage. Genau daran sind die
  // Fehlschlaege in tests/kurzsprung_test.sh gehangen, die lange als
  // flackernd und als zu knapper Deckel galten (#1915) — der Deckel loeste es
  // aus, die fehlende Pruefung war die Ursache.
  //
  // Der Sprung ist ein LANGER (rel32): der uebersprungene Block traegt die
  // Meldung und den Panic-Rumpf und liegt weit ueber 127 Byte (#1915).
  fn cg_emitMmapGeprueft() {
    // NUR auf dem SysV-Pfad. Der Meldeweg unten benutzt rohe Linux-Syscalls
    // (write, exit_group); in einer PE-Datei riefe derselbe Befehl einen
    // NT-Dienst mit ganz anderer Bedeutung auf, und die Argumente stuenden in
    // den falschen Registern (#1678). tests/win64_syscalls_test.sh zaehlt
    // genau das und hat diese Fassung beim ersten Lauf abgewiesen — zu Recht.
    //
    // Fuer win64 bleibt damit alles wie bisher: dort steht der mmap-Aufruf
    // ohnehin als nachweislich unerreichbarer Rest im Erzeugnis, den derselbe
    // Test als Schranke fuehrt. Eine Pruefung davor waere kein Gewinn,
    // sondern zwei weitere Syscalls in einer Datei, die keine haben darf.
    if (self.msAbi != 0) { return; }

    // #2296: Ist ein Melder bekannt, wird dorthin GESPRUNGEN statt einer
    // zweiten Kopie. Gebraucht fuer Code hinter 1372, der sonst rohe
    // Syscalls in die PE traegt (write, exit_group).
    if (self.mmapOomSprung != 0) {
      self.cg_paarAusrichten(self.codeLen, 12);
      self.cg_e8(0x48); self.cg_e8(0x3D);
      self.cg_e8(0x01); self.cg_e8(0xF0); self.cg_e8(0xFF); self.cg_e8(0xFF);   // cmp rax, -4095
      self.cg_e8(0x0F); self.cg_e8(0x83);                                        // jae rel32 → Melder
      var oomP: int64 := self.codeLen;
      self.cg_e32(self.mmapOomSprung - oomP - 4);
      return;
    }

    // #2244: cmp und jb verschmelzen zu einem Paar und duerfen zusammen
    // keine 32-Byte-Grenze kreuzen. Bis 1.2.23C fehlte das hier — der Sprung
    // allein wurde nicht ausgerichtet, und ob das PAAR guenstig lag,
    // entschied die Laenge des Codes davor (8 Treffer im Testprogramm).
    // 6 Byte cmp + 6 Byte jb rel32 = 12.
    self.cg_paarAusrichten(self.codeLen, 12);
    // cmp rax, -4095   (imm32 wird vorzeichenerweitert)
    self.cg_e8(0x48); self.cg_e8(0x3D);
    self.cg_e8(0x01); self.cg_e8(0xF0); self.cg_e8(0xFF); self.cg_e8(0xFF);
    // jb .ok — unterhalb des Fehlerbereichs, also eine gueltige Adresse
    self.cg_e8(0x0F); self.cg_e8(0x82);
    var pOk: int64 := self.codeLen; self.cg_e32(0);

    var msgOff: int64 := self.dataLen;
    // "Speicheranforderung fehlgeschlagen (mmap)\n\0"
    self.cg_edata(83);  self.cg_edata(112); self.cg_edata(101); self.cg_edata(105);
    self.cg_edata(99);  self.cg_edata(104); self.cg_edata(101); self.cg_edata(114);
    self.cg_edata(97);  self.cg_edata(110); self.cg_edata(102); self.cg_edata(111);
    self.cg_edata(114); self.cg_edata(100); self.cg_edata(101); self.cg_edata(114);
    self.cg_edata(117); self.cg_edata(110); self.cg_edata(103); self.cg_edata(32);
    self.cg_edata(102); self.cg_edata(101); self.cg_edata(104); self.cg_edata(108);
    self.cg_edata(103); self.cg_edata(101); self.cg_edata(115); self.cg_edata(99);
    self.cg_edata(104); self.cg_edata(108); self.cg_edata(97);  self.cg_edata(103);
    self.cg_edata(101); self.cg_edata(110); self.cg_edata(32);  self.cg_edata(40);
    self.cg_edata(109); self.cg_edata(109); self.cg_edata(97);  self.cg_edata(112);
    self.cg_edata(41);  self.cg_edata(10);  self.cg_edata(0);
    self.cg_emitLeaRdiData(msgOff);
    self.cg_emitPanicBody();

    poke32(self.code + pOk, self.codeLen - pOk - 4);
  }
};

// ============================================================================
// Public helper: emit count of nodes in a singly-linked list (via NNext)
// (Mirrors ParserListLen from parser.lyx for convenience)
// ============================================================================

pub fn CodegenListLen(head: int64, nodes: int64): int64 {
  var n: int64 := 0;
  var cur: int64 := head;
  while (cur != -1) {
    n += 1;
    cur := peek64(nodes + cur * 88 + 40);
  }
  return n;
}
