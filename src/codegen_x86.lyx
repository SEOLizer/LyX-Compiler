  // WP-BC-40: Look up or allocate a profiling entry for the given name.
  // Returns the data section offset of {tsc_start(8), call_count(8), total_cycles(8)}.
  // Also stores the name string in the data section (nameDataOff) for profile_report.
  fn cg_findOrAllocProfEntry(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.profEntryCount) {
      var eBase: int64 := self.profEntries + i * CG_PROF_SZ;
      var eName: pchar := peek64(eBase) as pchar;
      var eLen: int64 := peek64(eBase + CG_PR_OFF_NAMELEN);
      if (eLen == nlen) {
        var j: int64 := 0; var isMatch: int64 := 1;
        while (j < nlen) {
          if (StrCharAt(eName, j) != StrCharAt(name, j)) { isMatch := 0; }
          j := j + 1;
        }
        if (isMatch == 1) { return peek64(eBase + CG_PR_OFF_DOFF); }
      }
      i := i + 1;
    }
    if (self.profEntryCount >= self.profEntryCap) {
      var nc: int64 := self.profEntryCap * 2;
      var nb: int64 := mmap(0, nc * 32, 3, 34, -1, 0);
      var j: int64 := 0;
      memcpy(nb, self.profEntries, self.profEntryCount * CG_PROF_SZ);
      munmap(self.profEntries, self.profEntryCap * CG_PROF_SZ);
      self.profEntries := nb;
      self.profEntryCap := nc;
    }
    // Allocate runtime slots: tsc_start(8) + call_count(8) + total_cycles(8) = 24 bytes
    var dOff: int64 := self.dataLen;
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);  // tsc_start
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);  // call_count
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);  // total_cycles
    // Store name string in data section for profile_report output
    var nDOff: int64 := self.dataLen;
    var k: int64 := 0;
    while (k < nlen) { self.cg_edata(StrCharAt(name, k)); k := k + 1; }
    var eBase: int64 := self.profEntries + self.profEntryCount * CG_PROF_SZ;
    poke64(eBase,      name as int64);
    poke64(eBase + CG_PR_OFF_NAMELEN,  nlen);
    poke64(eBase + CG_PR_OFF_DOFF, dOff);
    poke64(eBase + CG_PR_OFF_NDOFF, nDOff);
    self.profEntryCount := self.profEntryCount + 1;
    return dOff;
  }

  // WP-11: Parse float literal string src[off..off+len) to IEEE 754 double bits.
  // Handles: N, N.M, N[eE][+-]P format.
  fn cg_parseFloat(src: pchar, off: int64, len: int64): int64 {
    var i: int64 := off;
    var end: int64 := off + len;
    var neg: int64 := 0;
    if (i < end && StrCharAt(src, i) == 45) { neg := 1; i := i + 1; }
    var num: int64 := 0;
    var den: int64 := 1;
    while (i < end && StrCharAt(src, i) >= 48 && StrCharAt(src, i) <= 57) {
      if (num < 900000000000000) { num := num * 10 + StrCharAt(src, i) - 48; }
      i := i + 1;
    }
    if (i < end && StrCharAt(src, i) == 46) {
      i := i + 1;
      while (i < end && StrCharAt(src, i) >= 48 && StrCharAt(src, i) <= 57 && den < 100000000) {
        num := num * 10 + StrCharAt(src, i) - 48;
        den := den * 10;
        i := i + 1;
      }
      while (i < end && StrCharAt(src, i) >= 48 && StrCharAt(src, i) <= 57) { i := i + 1; }
    }
    var expNeg: int64 := 0;
    var expVal: int64 := 0;
    if (i < end && (StrCharAt(src, i) == 101 || StrCharAt(src, i) == 69)) {
      i := i + 1;
      if (i < end && StrCharAt(src, i) == 45) { expNeg := 1; i := i + 1; }
      else if (i < end && StrCharAt(src, i) == 43) { i := i + 1; }
      while (i < end && StrCharAt(src, i) >= 48 && StrCharAt(src, i) <= 57) {
        expVal := expVal * 10 + StrCharAt(src, i) - 48;
        i := i + 1;
      }
    }
    if (num == 0) { return 0; }
    var ej: int64 := 0;
    if (expNeg == 0) {
      while (ej < expVal && num < 100000000000000) { num := num * 10; ej := ej + 1; }
    } else {
      while (ej < expVal && den < 100000000000000) { den := den * 10; ej := ej + 1; }
    }
    // Normalize: find binary exponent so n/d ∈ [1, 2)
    var n: int64 := num;
    var d: int64 := den;
    var binExp: int64 := 0;
    while (n < d && n > 0) {
      if (n > 4611686018427387903) { d := d / 2; if (d == 0) { d := 1; } }
      else { n := n * 2; }
      binExp := binExp - 1;
      if (binExp < -1074) { return 0; }
    }
    while (d < 4611686018427387903 && n >= d * 2) {
      d := d * 2; binExp := binExp + 1;
      if (binExp > 1023) {
        var pInf: int64 := 2047; pInf := pInf << 52;
        if (neg != 0) {
          var smI: int64 := 1; var sI: int64 := 0;
          while (sI < 63) { smI := smI * 2; sI := sI + 1; }
          return pInf | smI;
        }
        return pInf;
      }
    }
    n := n - d;
    var mant: int64 := 0;
    var bit: int64 := 51;
    while (bit >= 0) {
      if (n > 4000000000000000) { n := n / 2; d := d / 2; if (d == 0) { d := 1; } }
      n := n * 2;
      if (n >= d) { mant := mant | (1 << bit); n := n - d; }
      bit := bit - 1;
    }
    var biasedE: int64 := binExp + 1023;
    if (biasedE <= 0) { return 0; }
    if (biasedE >= 2047) {
      var pInf2: int64 := 2047; pInf2 := pInf2 << 52;
      if (neg != 0) {
        var smJ: int64 := 1; var sJ: int64 := 0;
        while (sJ < 63) { smJ := smJ * 2; sJ := sJ + 1; }
        return pInf2 | smJ;
      }
      return pInf2;
    }
    var bits: int64 := (biasedE << 52) | mant;
    if (neg != 0) {
      var sm: int64 := 1; var sk: int64 := 0;
      while (sk < 63) { sm := sm * 2; sk := sk + 1; }
      bits := bits | sm;
    }
    return bits;
  }

  // call rel32  — placeholder; returns position of rel32 for patching
  fn cg_emitCall(): int64 {
    self.cg_e8(0xE8);
    var pos: int64 := self.codeLen;
    self.cg_e32(0);
    return pos;
  }

  // Emit function prologue: push rbp; mov rbp, rsp; sub rsp, imm32 (placeholder)
  // Returns: code position of the imm32 (for later patching with final frame size)
  fn cg_emitPrologue(): int64 {
    self.cg_e8(0x55);                          // push rbp
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE5);  // mov rbp, rsp
    // sub rsp, imm32 (48 81 EC xx xx xx xx)
    self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC);
    var patchPos: int64 := self.codeLen;
    self.cg_e32(0);
    return patchPos;
  }

  // Emit function epilogue: mov rsp, rbp; pop rbp; ret
  fn cg_emitEpilogue() {
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xEC);  // mov rsp, rbp
    self.cg_e8(0x5D);  // pop rbp
    self.cg_e8(0xC3);  // ret
  }

  // push rax
  fn cg_pushRax() { self.cg_e8(0x50); }
  // pop rax
  fn cg_popRax() { self.cg_e8(0x58); }
  // pop rbx
  fn cg_popRbx() { self.cg_e8(0x5B); }
  // pop rdi
  fn cg_popRdi() { self.cg_e8(0x5F); }
  // pop rsi
  fn cg_popRsi() { self.cg_e8(0x5E); }
  // pop rdx
  fn cg_popRdx() { self.cg_e8(0x5A); }
  // pop rcx
  fn cg_popRcx() { self.cg_e8(0x59); }

  // xor rax, rax  (zero rax)
  fn cg_zeroRax() {
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
  }

  // neg rax
  fn cg_negRax() {
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xD8);
  }

  // not rax  (bitwise NOT)
  fn cg_notRax() {
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xD0);
  }

  // test rax, rax; setnz al; movzx rax, al  (convert any non-zero to 1)
  fn cg_boolRax() {
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
    self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC0);   // setnz al
    self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);  // movzx rax, al
  }

  // Emit binary operation: rax=right operand, rbx=left operand (from stack pop)
  // Result left in rax.
  fn cg_emitBinOp(op: int64) {
    if (op == CGT_PLUS) {
      // add rax, rbx  (48 01 D8)
      self.cg_e8(0x48); self.cg_e8(0x01); self.cg_e8(0xD8);
      if (self.overflowCheckEnabled != 0) { self.cg_emitOverflowPanic(); }
    } else if (op == CGT_MINUS) {
      // sub rbx, rax; mov rax, rbx  (left - right); mov preserves OF
      self.cg_e8(0x48); self.cg_e8(0x29); self.cg_e8(0xC3);  // sub rbx, rax
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx
      if (self.overflowCheckEnabled != 0) { self.cg_emitOverflowPanic(); }
    } else if (op == CGT_STAR) {
      // imul rax, rbx  (48 0F AF C3)
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xAF); self.cg_e8(0xC3);
      if (self.overflowCheckEnabled != 0) { self.cg_emitOverflowPanic(); }
    } else if (op == CGT_SLASH) {
      // idiv: rax=right(divisor), rbx=left(dividend); want left/right
      // WP-BC-48: --runtime-checks → zero-check divisor before div
      if self.runtimeChecks != 0 {
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x75);                                         // jnz short +rel8
        var pSkipD: int64 := self.codeLen; self.cg_e8(0);
        var msgOffD: int64 := self.dataLen;
        self.cg_edata(100); self.cg_edata(105); self.cg_edata(118); // div
        self.cg_edata(105); self.cg_edata(115); self.cg_edata(105); // isi
        self.cg_edata(111); self.cg_edata(110); self.cg_edata(32);  // on
        self.cg_edata(98);  self.cg_edata(121);  self.cg_edata(32); // by
        self.cg_edata(122); self.cg_edata(101); self.cg_edata(114); // zer
        self.cg_edata(111); self.cg_edata(10);  self.cg_edata(0);   // o\n\0
        self.cg_emitLeaRdiData(msgOffD);
        self.cg_emitPanicBody();
        poke8(self.code + pSkipD, self.codeLen - pSkipD - 1);
      }
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);  // mov rcx, rax (divisor)
      self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);  // xor rdx, rdx
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx (dividend)
      self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);  // idiv rcx
    } else if (op == CGT_PERCENT) {
      // same as div but result = rdx (remainder)
      // WP-BC-48: --runtime-checks → zero-check divisor before mod
      if self.runtimeChecks != 0 {
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x75);                                         // jnz short +rel8
        var pSkipM: int64 := self.codeLen; self.cg_e8(0);
        var msgOffM: int64 := self.dataLen;
        self.cg_edata(109); self.cg_edata(111); self.cg_edata(100); // mod
        self.cg_edata(117); self.cg_edata(108); self.cg_edata(111); // ulo
        self.cg_edata(32);  self.cg_edata(98);  self.cg_edata(121); //  by
        self.cg_edata(32);  self.cg_edata(122); self.cg_edata(101); //  ze
        self.cg_edata(114); self.cg_edata(111); self.cg_edata(10);  // ro\n
        self.cg_edata(0);                                            // \0
        self.cg_emitLeaRdiData(msgOffM);
        self.cg_emitPanicBody();
        poke8(self.code + pSkipM, self.codeLen - pSkipM - 1);
      }
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);  // mov rcx, rax
      self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);  // xor rdx, rdx
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx
      self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);  // idiv rcx
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD0);  // mov rax, rdx
    } else if (op == CGT_SHL) {
      // shl rbx, cl  (48 D3 E3)  — rax=count → move to cl
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);  // mov rcx, rax
      self.cg_e8(0x48); self.cg_e8(0xD3); self.cg_e8(0xE3);  // shl rbx, cl
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx
    } else if (op == CGT_SHR) {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);  // mov rcx, rax
      self.cg_e8(0x48); self.cg_e8(0xD3); self.cg_e8(0xEB);  // sar rbx, cl (signed)
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx
    } else if (op == CGT_EQ2) {
      // cmp rbx, rax; sete al; movzx rax, al
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);  // cmp rbx, rax
      self.cg_e8(0x0F); self.cg_e8(0x94); self.cg_e8(0xC0);  // sete al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_NEQ) {
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);  // cmp rbx, rax
      self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC0);  // setne al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_LT) {
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);  // cmp rbx, rax
      self.cg_e8(0x0F); self.cg_e8(0x9C); self.cg_e8(0xC0);  // setl al (rbx < rax)
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_LE) {
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
      self.cg_e8(0x0F); self.cg_e8(0x9E); self.cg_e8(0xC0);  // setle al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_GT) {
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
      self.cg_e8(0x0F); self.cg_e8(0x9F); self.cg_e8(0xC0);  // setg al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_GE) {
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
      self.cg_e8(0x0F); self.cg_e8(0x9D); self.cg_e8(0xC0);  // setge al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_AND) {
      // logical and: both non-zero → 1
      // rax=right, rbx=left; test both
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
      self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC0);  // setnz al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0); // movzx rax,al
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xDB);  // test rbx, rbx
      self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC3);  // setnz bl
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xDB); // movzx rbx,bl
      self.cg_e8(0x48); self.cg_e8(0x21); self.cg_e8(0xD8);  // and rax, rbx
    } else if (op == CGT_OR) {
      // logical or
      self.cg_e8(0x48); self.cg_e8(0x09); self.cg_e8(0xD8);  // or rax, rbx
      self.cg_boolRax();
    } else if (op == CGT_BITAND) {
      // bitwise and rax, rbx
      self.cg_e8(0x48); self.cg_e8(0x21); self.cg_e8(0xD8);
    } else if (op == CGT_BITOR) {
      // bitwise or rax, rbx
      self.cg_e8(0x48); self.cg_e8(0x09); self.cg_e8(0xD8);
    } else if (op == 89) {
      // bitwise xor rax, rbx  (TK_BITXOR = 89, no CGT_BITXOR alias)
      self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD8);
    } else {
      // Unknown op: emit 0 (nop effect, rax=0)
      self.cg_zeroRax();
    }
  }

  // ------------------------------------------------------------------
  // ------------------------------------------------------------------
  // OOP support: class layout table and local type tracking
  // ------------------------------------------------------------------

  fn cg_setLocalType(idx: int64, typePtr: pchar, typeLen: int64) {
    var base: int64 := self.localTypes + idx * CG_LOCTYPE_SZ;
    poke64(base,     typePtr as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR, typeLen);
  }

  fn cg_findClass(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.classCount) {
      var base: int64 := self.classLayouts + i * CG_CLASS_SZ;
      var p: pchar := peek64(base) as pchar;
      var n: int64 := peek64(base + CG_PATCH_OFF_NAMEPTR);
      if (n == nameLen && self.cg_seq(p, n, name, nameLen)) { return i; }
      i := i + 1;
    }
    return -1;
  }

  fn cg_getFieldOffset(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    return self.cg_findField(classIdx, fieldName, fieldLen);
  }

  fn cg_findField(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return -1; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar   := peek64(fb) as pchar;
      var n: int64   := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        return peek64(fb + CG_CFIELD_OFF_OFFSET);
      }
      i := i + 1;
    }
    return -1;
  }

  fn cg_getFieldClassIdx(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return -1; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar   := peek64(fb) as pchar;
      var n: int64   := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        var tp: pchar := peek64(fb + CG_CFIELD_OFF_TYPENAMEPTR) as pchar;
        var tn: int64 := peek64(fb + CG_CFIELD_OFF_TYPENAMELEN);
        if (tp == 0 as pchar || tn == 0) { return -1; }
        return self.cg_findClass(tp, tn);
      }
      i := i + 1;
    }
    return -1;
  }

  // WP-4.1-B: return fb+40 flags for a named field: bit0=bigEndian, bits8..15=typeWidth.
  // Returns 0 if field not found or not big_endian.
  fn cg_getFieldBigEndian(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return 0; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar   := peek64(fb) as pchar;
      var n: int64   := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        return peek64(fb + CG_CFIELD_OFF_FLAGS);
      }
      i := i + 1;
    }
    return 0;
  }

  // Returns the byte size of a struct given its class index (fieldCnt * 8 for non-packed)
  fn cg_classStructSize(classIdx: int64): int64 {
    if (classIdx < 0) { return 8; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var cnt: int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    if (cnt <= 0) { return 8; }
    // For struct fields the last field's offset + 8 = total size
    // Simpler: fieldCnt * 8 (all fields are 8 bytes in non-packed structs)
    return cnt * 8;
  }

  // Returns class index of the element type of an Array<T> field, or -1
  fn cg_getFieldElemClassIdx(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return -1; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar := peek64(fb) as pchar;
      var n: int64 := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        var ep: pchar := peek64(fb + CG_CFIELD_OFF_ELEMTYPEPTR) as pchar;
        var el: int64 := peek64(fb + CG_CFIELD_OFF_ELEMTYPELEN);
        if (ep == 0 as pchar || el == 0) { return -1; }
        return self.cg_findClass(ep, el);
      }
      i := i + 1;
    }
    return -1;
  }

  // Returns 1 if the named class field has type "Array<T>" (any T), 0 otherwise.
  fn cg_isFieldArray(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return 0; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar := peek64(fb) as pchar;
      var n: int64 := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        var tp: pchar := peek64(fb + CG_CFIELD_OFF_TYPENAMEPTR) as pchar;
        var tl: int64 := peek64(fb + CG_CFIELD_OFF_TYPENAMELEN);
        if (tp != 0 as pchar && tl == 5 && self.cg_seq(tp, tl, "Array", 5)) { return 1; }
        return 0;
      }
      i := i + 1;
    }
    return 0;
  }

  // WP-4.1-B: emit BSWAP/XCHG on rax after loading a big_endian field (load result in rax).
  fn cg_emitBswapRax(typeWidth: int64) {
    if (typeWidth == 2) {
      // XCHG al, ah: 86 C4
      self.cg_e8(0x86); self.cg_e8(0xC4);
      // movzx rax, ax: 48 0F B7 C0 (zero-extend to 64 bits)
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB7); self.cg_e8(0xC0);
    } else if (typeWidth == 4) {
      // BSWAP eax: 0F C8 (zeroes upper 32 bits of rax)
      self.cg_e8(0x0F); self.cg_e8(0xC8);
    } else {
      // BSWAP rax: 48 0F C8
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xC8);
    }
  }

  // WP-4.1-B: emit BSWAP/XCHG on rsi before storing a big_endian field (value in rsi).
  fn cg_emitBswapRsi(typeWidth: int64) {
    if (typeWidth == 2) {
      // ROL si, 8: 66 C1 C6 08
      self.cg_e8(0x66); self.cg_e8(0xC1); self.cg_e8(0xC6); self.cg_e8(8);
    } else if (typeWidth == 4) {
      // BSWAP esi: 0F CE
      self.cg_e8(0x0F); self.cg_e8(0xCE);
    } else {
      // BSWAP rsi: 48 0F CE
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xCE);
    }
  }

  fn cg_buildClassLayout(ni: int64) {
    var className: pchar := self.cg_nsval(ni);
    var classLen:  int64 := self.cg_nslen(ni);
    // Count fields (child0 chain)
    var fieldNode: int64 := self.cg_nc0(ni);
    var cnt: int64 := 0;
    var tmp: int64 := fieldNode;
    while (tmp != -1) { cnt := cnt + 1; tmp := self.cg_nnext(tmp); }
    // Allocate field array
    var flds: int64 := mmap(0, (cnt + 1) * CG_CFIELD_SZ, 3, 34, -1, 0);
    // WP-10a: fields start at offset 8 (offset 0 reserved for VMT pointer)
    var offset: int64 := 8;
    var i: int64 := 0;
    tmp := fieldNode;
    while (tmp != -1) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      poke64(fb,      self.cg_nsval(tmp) as int64);
      poke64(fb + CG_CFIELD_OFF_FIELDLEN,  self.cg_nslen(tmp));
      poke64(fb + CG_CFIELD_OFF_OFFSET, offset);
      poke64(fb + CG_CFIELD_OFF_ELEMTYPEPTR, 0);
      poke64(fb + CG_CFIELD_OFF_ELEMTYPELEN, 0);
      var ftypeNode: int64 := self.cg_nc0(tmp);
      if (ftypeNode >= 0 && self.cg_nkind(ftypeNode) == 60) {
        var ftn: pchar := self.cg_nsval(ftypeNode);
        var ftl: int64 := self.cg_nslen(ftypeNode);
        poke64(fb + CG_CFIELD_OFF_TYPENAMEPTR, ftn as int64);
        poke64(fb + CG_CFIELD_OFF_TYPENAMELEN, ftl);
        if (self.cg_seq(ftn, ftl, "Array", 5)) {
          var elemNode: int64 := self.cg_nc1(ftypeNode);
          if (elemNode >= 0 && self.cg_nkind(elemNode) == 60) {
            poke64(fb + CG_CFIELD_OFF_ELEMTYPEPTR, self.cg_nsval(elemNode) as int64);
            poke64(fb + CG_CFIELD_OFF_ELEMTYPELEN, self.cg_nslen(elemNode));
          }
        }
      } else {
        poke64(fb + CG_CFIELD_OFF_TYPENAMEPTR, 0);
        poke64(fb + CG_CFIELD_OFF_TYPENAMELEN, 0);
      }
      // WP-4.1-B: store big_endian flag + type width at fb+40
      var beFlag: int64 := (self.cg_nival(tmp) >> 1) & 1;  // bit 1 of field iVal
      var tWidth: int64 := self.cg_typeSize(ftypeNode);
      poke64(fb + CG_CFIELD_OFF_FLAGS, beFlag | (tWidth << 8));
      offset := offset + 8;
      i := i + 1;
      tmp := self.cg_nnext(tmp);
    }
    // WP-BC-19: resolve parent class VMT slots for inheritance
    var parentNi: int64 := self.cg_nc2(ni);
    var parentSlotCount: int64 := 0;
    var parentMethodList: int64 := 0;
    if (parentNi >= 0) {
      var pName: pchar := self.cg_nsval(parentNi);
      var pLen:  int64 := self.cg_nslen(parentNi);
      var pIdx:  int64 := self.cg_findClass(pName, pLen);
      if (pIdx >= 0) {
        parentSlotCount  := peek64(self.classLayouts + pIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTSLOTS);
        parentMethodList := peek64(self.classLayouts + pIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTLIST);
      }
    }
    // Count own virtual methods that are new (not overriding a parent slot)
    var ownMethodCount: int64 := 0;
    var mthTmp2: int64 := self.cg_nc1(ni);
    while (mthTmp2 != -1) {
      var isVirt2: int64 := (self.cg_nival(mthTmp2) >> 1) & 1;
      if (isVirt2 != 0) {
        var mname2: pchar := self.cg_nsval(mthTmp2);
        var mlen2:  int64 := self.cg_nslen(mthTmp2);
        var overrides: int64 := 0;
        var si2: int64 := 0;
        while (si2 < parentSlotCount) {
          var sName2: pchar := peek64(parentMethodList + si2 * 16) as pchar;
          var sLen2:  int64 := peek64(parentMethodList + si2 * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN);
          if (self.cg_seq(sName2, sLen2, mname2, mlen2) != 0) { overrides := 1; break; }
          si2 := si2 + 1;
        }
        if (overrides == 0) { ownMethodCount := ownMethodCount + 1; }
      }
      mthTmp2 := self.cg_nnext(mthTmp2);
    }
    var totalSlots: int64 := parentSlotCount + ownMethodCount;
    // Allocate method name list: {namePtr:8, nameLen:8} per slot
    var methodList: int64 := mmap(0, (totalSlots + 1) * 16, 3, 34, -1, 0);
    // Copy parent slots first
    var si3: int64 := 0;
    while (si3 < parentSlotCount) {
      poke64(methodList + si3 * 16,     peek64(parentMethodList + si3 * 16));
      poke64(methodList + si3 * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN, peek64(parentMethodList + si3 * 16 + 8));
      si3 := si3 + 1;
    }
    // Append own new virtual methods
    var slotAppend: int64 := parentSlotCount;
    var mthTmp3: int64 := self.cg_nc1(ni);
    while (mthTmp3 != -1) {
      var isVirt3: int64 := (self.cg_nival(mthTmp3) >> 1) & 1;
      if (isVirt3 != 0) {
        var mname3: pchar := self.cg_nsval(mthTmp3);
        var mlen3:  int64 := self.cg_nslen(mthTmp3);
        var overrides3: int64 := 0;
        var si4: int64 := 0;
        while (si4 < parentSlotCount) {
          var sName4: pchar := peek64(parentMethodList + si4 * 16) as pchar;
          var sLen4:  int64 := peek64(parentMethodList + si4 * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN);
          if (self.cg_seq(sName4, sLen4, mname3, mlen3) != 0) { overrides3 := 1; break; }
          si4 := si4 + 1;
        }
        if (overrides3 == 0) {
          poke64(methodList + slotAppend * 16,     mname3 as int64);
          poke64(methodList + slotAppend * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN, mlen3);
          slotAppend := slotAppend + 1;
        }
      }
      mthTmp3 := self.cg_nnext(mthTmp3);
    }
    // Emit VMT data: totalSlots * 8 bytes (each slot = one method pointer)
    var vmtDataOff: int64 := self.dataLen;
    var di: int64 := 0;
    while (di < totalSlots * 8) { self.cg_edata(0); di := di + 1; }
    // Ensure at least 8 bytes (classes with no methods still need a VMT identity slot)
    if (totalSlots == 0) {
      var de: int64 := 0; while (de < 8) { self.cg_edata(0); de := de + 1; }
    }
    // Grow class table if needed
    if (self.classCount >= self.classCap) {
      var nc: int64 := self.classCap * 2;
      var nb: int64 := mmap(0, nc * CG_CLASS_SZ, 3, 34, -1, 0);
      var ii: int64 := 0;
      memcpy(nb, self.classLayouts, self.classCount * CG_CLASS_SZ);
      self.classLayouts := nb;
      self.classCap := nc;
    }
    var base: int64 := self.classLayouts + self.classCount * CG_CLASS_SZ;
    poke64(base,      className as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  classLen);
    poke64(base + CG_CLASS_OFF_FIELDSPTR, flds);
    poke64(base + CG_CLASS_OFF_FIELDCNT, cnt);
    poke64(base + CG_CLASS_OFF_VMTOFF,   vmtDataOff);
    poke64(base + CG_CLASS_OFF_VMTSLOTS, totalSlots);
    poke64(base + CG_CLASS_OFF_VMTLIST,  methodList);
    self.classCount := self.classCount + 1;
    // Track temporary field array for later cleanup (BUG-02)
    // The flds pointer is stored in classLayouts and used by cg_findField/cg_getFieldOffset
    // until cg_patchAll() completes. cg_freeAllTempBufs() will release it.
    self.cg_trackTempBuf(flds, (cnt + 1) * CG_CFIELD_SZ);
    self.cg_trackTempBuf(methodList, (totalSlots + 1) * 16);
  }

  // Build struct field layout (WP-10d): like cg_buildClassLayout but fields at offset 0
  // and vmtDataOff stored as -1 (marks this entry as a struct, not a class).
  // WP-4.1-A: return the byte size of a named type for @packed structs
  fn cg_typeSize(typeNode: int64): int64 {
    if (typeNode < 0) { return 8; }
    var tn: pchar := self.cg_nsval(typeNode);
    var tl: int64 := self.cg_nslen(typeNode);
    if (tl == 5 && self.cg_seq(tn, tl, "uint8"c,  5)) { return 1; }
    if (tl == 4 && self.cg_seq(tn, tl, "int8"c,   4)) { return 1; }
    if (tl == 4 && self.cg_seq(tn, tl, "char"c,   4)) { return 1; }
    if (tl == 6 && self.cg_seq(tn, tl, "uint16"c, 6)) { return 2; }
    if (tl == 5 && self.cg_seq(tn, tl, "int16"c,  5)) { return 2; }
    if (tl == 6 && self.cg_seq(tn, tl, "uint32"c, 6)) { return 4; }
    if (tl == 5 && self.cg_seq(tn, tl, "int32"c,  5)) { return 4; }
    if (tl == 3 && self.cg_seq(tn, tl, "f32"c,    3)) { return 4; }
    return 8;  // int64, uint64, f64, pchar, pointers — all 8 bytes
  }

  fn cg_buildStructLayout(ni: int64) {
    var sName: pchar := self.cg_nsval(ni);
    var sLen:  int64 := self.cg_nslen(ni);
    var fieldNode: int64 := self.cg_nc0(ni);
    var cnt: int64 := 0;
    var tmp: int64 := fieldNode;
    while (tmp != -1) { cnt := cnt + 1; tmp := self.cg_nnext(tmp); }
    var flds: int64 := mmap(0, (cnt + 1) * CG_CFIELD_SZ, 3, 34, -1, 0);
    // WP-4.1-A: check for @packed flag (bit 0 of struct iVal) and at(offset) fields
    var isPacked: int64 := self.cg_nival(ni) & 1;
    // Structs: fields start at offset 0 (no VMT slot)
    var offset: int64 := 0;
    var i: int64 := 0;
    tmp := fieldNode;
    while (tmp != -1) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      poke64(fb,      self.cg_nsval(tmp) as int64);
      poke64(fb + CG_CFIELD_OFF_FIELDLEN,  self.cg_nslen(tmp));
      var ftypeNode: int64 := self.cg_nc0(tmp);
      // WP-4.1-A: determine field offset
      var fieldOff: int64 := offset;
      var fieldIVal: int64 := self.cg_nival(tmp);
      if ((fieldIVal & 1) != 0) {
        // Explicit at(expr) offset: read from c1 node's iVal (must be literal)
        var offsetNi: int64 := self.cg_nc1(tmp);
        if (offsetNi >= 0) { fieldOff := self.cg_nival(offsetNi); }
        offset := fieldOff;  // continue after explicit offset
      }
      poke64(fb + CG_CFIELD_OFF_OFFSET, fieldOff);
      poke64(fb + CG_CFIELD_OFF_ELEMTYPEPTR, 0);
      poke64(fb + CG_CFIELD_OFF_ELEMTYPELEN, 0);
      if (ftypeNode >= 0 && self.cg_nkind(ftypeNode) == 60) {
        var ftn: pchar := self.cg_nsval(ftypeNode);
        var ftl: int64 := self.cg_nslen(ftypeNode);
        poke64(fb + CG_CFIELD_OFF_TYPENAMEPTR, ftn as int64);
        poke64(fb + CG_CFIELD_OFF_TYPENAMELEN, ftl);
        // For Array<T> fields: store element type from generic arg nc1
        if (self.cg_seq(ftn, ftl, "Array", 5)) {
          var elemNode: int64 := self.cg_nc1(ftypeNode);
          if (elemNode >= 0 && self.cg_nkind(elemNode) == 60) {
            poke64(fb + CG_CFIELD_OFF_ELEMTYPEPTR, self.cg_nsval(elemNode) as int64);
            poke64(fb + CG_CFIELD_OFF_ELEMTYPELEN, self.cg_nslen(elemNode));
          }
        }
      } else {
        poke64(fb + CG_CFIELD_OFF_TYPENAMEPTR, 0);
        poke64(fb + CG_CFIELD_OFF_TYPENAMELEN, 0);
      }
      // WP-4.1-B: store big_endian flag + type width at fb+40
      var beFlag2: int64 := (self.cg_nival(tmp) >> 1) & 1;
      var tWidth2: int64 := self.cg_typeSize(ftypeNode);
      poke64(fb + CG_CFIELD_OFF_FLAGS, beFlag2 | (tWidth2 << 8));
      // WP-4.1-A: field stride
      if (isPacked != 0) {
        offset := offset + self.cg_typeSize(ftypeNode);
      } else {
        offset := offset + 8;  // default: 8-byte aligned
      }
      i := i + 1;
      tmp := self.cg_nnext(tmp);
    }
    if (self.classCount >= self.classCap) {
      var nc: int64 := self.classCap * 2;
      var nb: int64 := mmap(0, nc * CG_CLASS_SZ, 3, 34, -1, 0);
      var ii: int64 := 0;
      memcpy(nb, self.classLayouts, self.classCount * CG_CLASS_SZ);
      self.classLayouts := nb;
      self.classCap := nc;
    }
    var base: int64 := self.classLayouts + self.classCount * CG_CLASS_SZ;
    poke64(base,      sName as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  sLen);
    poke64(base + CG_CLASS_OFF_FIELDSPTR, flds);
    poke64(base + CG_CLASS_OFF_FIELDCNT, cnt);
    poke64(base + CG_CLASS_OFF_VMTOFF,   -1);
    poke64(base + CG_CLASS_OFF_VMTSLOTS, 0);
    poke64(base + CG_CLASS_OFF_VMTLIST, 0);
    self.classCount := self.classCount + 1;
    // Track temporary field array for later cleanup (BUG-02)
    self.cg_trackTempBuf(flds, (cnt + 1) * CG_CFIELD_SZ);
  }

  // BUG-08: Build enum variant layout for match tag analysis
  // Enum layout: {namePtr:8, nameLen:8, variantsPtr:8, variantCnt:8}
  // Each variant: {namePtr:8, nameLen:8, tagValue:8, payloadSize:8} = 32 bytes
  fn cg_buildEnumLayout(ni: int64) {
    var enumName: pchar := self.cg_nsval(ni);
    var enumLen:  int64 := self.cg_nslen(ni);
    // Count variants (child0 chain)
    var variantNode: int64 := self.cg_nc0(ni);
    var cnt: int64 := 0;
    var tmp: int64 := variantNode;
    while (tmp != -1) { cnt := cnt + 1; tmp := self.cg_nnext(tmp); }
    // Allocate variant array: 32 bytes per variant
    var vars: int64 := mmap(0, cnt * 32, 3, 34, -1, 0);
    var i: int64 := 0;
    tmp := variantNode;
    while (tmp != -1) {
      var vb: int64 := vars + i * 32;
      poke64(vb,      self.cg_nsval(tmp) as int64);   // variant name
      poke64(vb + CG_EVAR_OFF_NAMELEN,  self.cg_nslen(tmp));             // variant name len
      poke64(vb + CG_EVAR_OFF_TAGVAL, i);                              // tag value = index
      // Payload size: count children of variant (NK_PATTERN_BIND etc.)
      var payloadCnt: int64 := 0;
      var pc: int64 := self.cg_nc0(tmp);
      while (pc != -1) { payloadCnt := payloadCnt + 1; pc := self.cg_nnext(pc); }
      poke64(vb + CG_EVAR_OFF_PAYLOADSZ, payloadCnt);
      i := i + 1;
      tmp := self.cg_nnext(tmp);
    }
    // Grow enum table if needed
    if (self.enumCount >= self.enumCap) {
      var nc: int64 := self.enumCap * 2;
      var nb: int64 := mmap(0, nc * 32, 3, 34, -1, 0);
      var ii: int64 := 0;
      memcpy(nb, self.enumLayouts, self.enumCount * 32);
      munmap(self.enumLayouts, self.enumCap * 32);
      self.enumLayouts := nb;
      self.enumCap := nc;
    }
    var base: int64 := self.enumLayouts + self.enumCount * 32;
    poke64(base,      enumName as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  enumLen);
    poke64(base + CG_ENUM_OFF_VARSPTR, vars);
    poke64(base + CG_CLASS_OFF_FIELDCNT, cnt);
    self.enumCount := self.enumCount + 1;
  }

  // BUG-08: Find enum layout by name, return index or -1
  fn cg_findEnum(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.enumCount) {
      var base: int64 := self.enumLayouts + i * 32;
      var p: pchar := peek64(base) as pchar;
      var n: int64 := peek64(base + CG_PATCH_OFF_NAMEPTR);
      if (n == nlen && self.cg_seq(p, n, name, nlen)) { return i; }
      i := i + 1;
    }
    return -1;
  }

  // BUG-08: Find variant tag value within enum by variant name
  // Returns {tagValue: low 32 bits, payloadSize: high 32 bits} packed in int64
  fn cg_findEnumVariant(enumIdx: int64, varName: pchar, varLen: int64): int64 {
    if (enumIdx < 0) { return -1; }
    var ebase: int64 := self.enumLayouts + enumIdx * 32;
    var vars: int64 := peek64(ebase + CG_ENUM_OFF_VARSPTR);
    var vcnt: int64 := peek64(ebase + CG_ENUM_OFF_VARCOUNT);
    var i: int64 := 0;
    while (i < vcnt) {
      var vb: int64 := vars + i * 32;
      var p: pchar := peek64(vb) as pchar;
      var n: int64 := peek64(vb + CG_EVAR_OFF_NAMELEN);
      if (n == varLen && self.cg_seq(p, n, varName, varLen)) {
        var tagVal: int64 := peek64(vb + CG_EVAR_OFF_TAGVAL);
        var paySz:  int64 := peek64(vb + CG_EVAR_OFF_PAYLOADSZ);
        return tagVal + (paySz << 32);
      }
      i := i + 1;
    }
    return -1;
  }

  fn cg_getLocalClassIdx(varName: pchar, varLen: int64): int64 {
    var i: int64 := self.localCount - 1;
    while (i >= 0) {
      var base: int64 := self.locals + i * CG_LOCAL_SZ;
      var p: pchar  := peek64(base) as pchar;
      var n: int64  := peek64(base + CG_LOCAL_OFF_NAMELEN);
      if (n == varLen && self.cg_seq(p, n, varName, varLen)) {
        var tb: int64 := self.localTypes + i * 16;
        var tp: pchar := peek64(tb) as pchar;
        var tn: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
        if (tp == 0 as pchar || tn == 0) { return -1; }
        return self.cg_findClass(tp, tn);
      }
      i := i - 1;
    }
    return -1;
  }

  // WP-10a: record a VMT address patch (mov rcx,imm64 placeholder at codeOff for class)
  fn cg_addVmtPatch(codeOff: int64, className: pchar, classLen: int64) {
    if (self.vmtPatchCount >= self.vmtPatchCap) {
      var nc: int64 := self.vmtPatchCap * 2;
      var nb: int64 := mmap(0, nc * 24, 3, 34, -1, 0);
      var i: int64 := 0;
      memcpy(nb, self.vmtPatches, self.vmtPatchCount * 24);
      self.vmtPatches := nb; self.vmtPatchCap := nc;
    }
    var base: int64 := self.vmtPatches + self.vmtPatchCount * 24;
    poke64(base,      codeOff);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  className as int64);
    poke64(base + CG_VMT_PATCH_OFF_CLASSLEN, classLen);
    self.vmtPatchCount := self.vmtPatchCount + 1;
  }

  // WP-BC-19: Record VMT method slot patch: after all code is generated,
  // write method vaddr into data[vmtDataSlotOff].
  fn cg_addVmtMethodPatch(vmtDataSlotOff: int64, methodCodeStart: int64) {
    if (self.vmtMethodPatchCount >= self.vmtMethodPatchCap) {
      var nc: int64 := self.vmtMethodPatchCap * 2;
      var nb: int64 := mmap(0, nc * CG_VMT_METH_PATCH_SZ, 3, 34, -1, 0);
      var i: int64 := 0;
      memcpy(nb, self.vmtMethodPatches, self.vmtMethodPatchCount * CG_VMT_METH_PATCH_SZ);
      self.vmtMethodPatches := nb; self.vmtMethodPatchCap := nc;
    }
    var base: int64 := self.vmtMethodPatches + self.vmtMethodPatchCount * CG_VMT_METH_PATCH_SZ;
    poke64(base,     vmtDataSlotOff);
    poke64(base + CG_PATCH_OFF_NAMEPTR, methodCodeStart);
    self.vmtMethodPatchCount := self.vmtMethodPatchCount + 1;
  }

  // Helper: get class index for object node (IDENT, FIELD chain, or INDEX for struct arrays)
  fn cg_objClassIdx(objNode: int64): int64 {
    var k: int64 := self.cg_nkind(objNode);
    if (k == CGN_FIELD) {
      var innerObj: int64 := self.cg_nc0(objNode);
      var fldName: pchar  := self.cg_nsval(objNode);
      var fldLen:  int64  := self.cg_nslen(objNode);
      var parentIdx: int64 := self.cg_objClassIdx(innerObj);
      return self.cg_getFieldClassIdx(parentIdx, fldName, fldLen);
    }
    // For arr[i] where arr is Array<StructType>: return struct's class index
    if (k == CGN_INDEX) {
      var baseNode: int64 := self.cg_nc0(objNode);
      return self.cg_arrayElemClassIdx(baseNode);
    }
    if (k != CGN_IDENT) { return -1; }
    var oname: pchar := self.cg_nsval(objNode);
    var olen:  int64 := self.cg_nslen(objNode);
    if (self.cg_seq(oname, olen, "self", 4) != 0) {
      if (self.curClassName == 0 as pchar) { return -1; }
      return self.cg_findClass(self.curClassName, self.curClassNameLen);
    }
    return self.cg_getLocalClassIdx(oname, olen);
  }

  // Returns the class index of the element type for arr[i] expressions.
  // baseNode is the array expression (IDENT or FIELD).
  fn cg_arrayElemClassIdx(baseNode: int64): int64 {
    var bk: int64 := self.cg_nkind(baseNode);
    if (bk == CGN_IDENT) {
      // Local array variable: check localTypes for element type
      var bname: pchar := self.cg_nsval(baseNode);
      var blen:  int64 := self.cg_nslen(baseNode);
      var lidx: int64 := self.cg_findLocalIdx(bname, blen);
      if (lidx >= 0 && peek8(self.localIsArray + lidx) != 0) {
        var tb: int64 := self.localTypes + lidx * CG_LOCTYPE_SZ;
        var tp: pchar := peek64(tb) as pchar;
        var tn: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
        if (tp != 0 as pchar && tn > 0) { return self.cg_findClass(tp, tn); }
      }
      return -1;
    }
    if (bk == CGN_FIELD) {
      // Class field of Array<T> type: look up element type in CG_CFIELD
      var innerObj: int64 := self.cg_nc0(baseNode);
      var fldName:  pchar  := self.cg_nsval(baseNode);
      var fldLen:   int64  := self.cg_nslen(baseNode);
      var parentIdx: int64 := self.cg_objClassIdx(innerObj);
      return self.cg_getFieldElemClassIdx(parentIdx, fldName, fldLen);
    }
    return -1;
  }

  // Inline code for arr.push(val): alloc on first use, then append
  // Layout: [ptr+0]=cap, [ptr+8]=len, [ptr+16+i*8]=data[i]
  fn cg_genArrayPush(objNode: int64, valNode: int64) {
    var aname: pchar := self.cg_nsval(objNode);
    var anlen: int64 := self.cg_nslen(objNode);
    var off: int64 := self.cg_findLocal(aname, anlen);
    // Evaluate value → rax
    self.cg_genExpr(valNode);
    // push rax (save value)
    self.cg_e8(0x50);
    // mov rcx, [rbp+off]  (load array ptr)
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x4D); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x8D); self.cg_e32(off);
    }
    // test rcx, rcx
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC9);
    // jnz skip_alloc (rel32 placeholder)
    self.cg_e8(0x0F); self.cg_e8(0x85);
    var jnzPos: int64 := self.codeLen;
    self.cg_e32(0);
    // ---- mmap block: allocate (1026)*8 bytes ----
    // xor edi, edi          (rdi=0, addr=0)
    self.cg_e8(0x31); self.cg_e8(0xFF);
    // mov rsi, 8208         ((1024+2)*8)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC6);
    self.cg_e8(0x10); self.cg_e8(0x20); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov edx, 3            (PROT_RW)
    self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov eax, 34           (MAP_ANON|MAP_PRIVATE)
    self.cg_e8(0xB8); self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov r10, rax          (REX.B extends rm to r10: 49 89 C2)
    self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);
    // mov rax, -1           (fd=-1)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0);
    self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);
    // mov r8, rax
    self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC0);
    // xor r9d, r9d          (offset=0)
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);
    // mov eax, 9            (SYS_mmap)
    self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // mov rcx, 1024         (cap)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1);
    self.cg_e8(0x00); self.cg_e8(0x04); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov [rax], rcx        ([ptr+0] = cap)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x08);
    // xor rcx, rcx
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC9);
    // mov [rax+8], rcx      ([ptr+8] = len=0)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x48); self.cg_e8(0x08);
    // store rax back to local variable
    self.cg_storeRax(off);
    // mov rcx, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);
    // ---- end mmap block ----
    // Patch jnz to here (skip_alloc)
    poke32(self.code + jnzPos, self.codeLen - jnzPos - 4);
    // pop rax               (restore value)
    self.cg_e8(0x58);

    // ---- GROW CHECK ----
    // push rax (save value while we inspect cap/len)
    self.cg_e8(0x50);
    // mov rax, [rcx]        (rax = cap)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);
    // mov rdx, [rcx+8]      (rdx = len)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x51); self.cg_e8(0x08);
    // cmp rdx, rax          (len vs cap)
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC2);
    // jl .no_grow  (short — signed compare, both values non-negative)
    self.cg_e8(0x7C); var jlNoGrow: int64 := self.codeLen; self.cg_e8(0);

    // ---- GROW PATH ---- stack entering: [rsp+0]=value
    // push rcx  (save old_ptr)
    self.cg_e8(0x51);
    // shl rax, 1  (new_cap = cap * 2)
    self.cg_e8(0x48); self.cg_e8(0xD1); self.cg_e8(0xE0);
    // push rax  (save new_cap) — stack: [rsp+0]=new_cap [rsp+8]=old_ptr [rsp+16]=value
    self.cg_e8(0x50);
    // mmap(0, new_cap*8+16, 3, 34, -1, 0)
    // imul rsi, rax, 8
    self.cg_e8(0x48); self.cg_e8(0x6B); self.cg_e8(0xF0); self.cg_e8(0x08);
    // add rsi, 16
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC6); self.cg_e8(0x10);
    // xor edi, edi
    self.cg_e8(0x31); self.cg_e8(0xFF);
    // mov edx, 3
    self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov eax, 34  (MAP_ANON|MAP_PRIVATE)
    self.cg_e8(0xB8); self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov r10, rax
    self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);
    // mov rax, -1  (fd = -1, sign-extended imm32)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0);
    self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);
    // mov r8, rax
    self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC0);
    // xor r9d, r9d
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);
    // mov eax, 9
    self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall  → rax=new_ptr (rcx, r11 trashed by syscall)
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // push rax (save new_ptr) — stack: [rsp+0]=new_ptr [rsp+8]=new_cap [rsp+16]=old_ptr [rsp+24]=value
    self.cg_e8(0x50);

    // rep movsb: copy data from old+16 to new+16
    // mov r11, [rsp+16]  (r11 = old_ptr)
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x5C); self.cg_e8(0x24); self.cg_e8(0x10);
    // lea rdi, [rax+16]  (dst = new+16)
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x78); self.cg_e8(0x10);
    // lea rsi, [r11+16]  (src = old+16)
    self.cg_e8(0x49); self.cg_e8(0x8D); self.cg_e8(0x73); self.cg_e8(0x10);
    // mov rcx, [r11+8]   (rcx = len)
    self.cg_e8(0x49); self.cg_e8(0x8B); self.cg_e8(0x4B); self.cg_e8(0x08);
    // imul rcx, rcx, 8   (count in bytes = len * 8)
    self.cg_e8(0x48); self.cg_e8(0x6B); self.cg_e8(0xC9); self.cg_e8(0x08);
    // cld; rep movsb  (rcx, rdi, rsi trashed after)
    self.cg_e8(0xFC); self.cg_e8(0xF3); self.cg_e8(0xA4);

    // pop rax  (new_ptr)
    self.cg_e8(0x58);
    // pop rdx  (new_cap) — stack: [rsp+0]=old_ptr [rsp+8]=value
    self.cg_e8(0x5A);
    // mov [rax], rdx     ([new+0] = new_cap)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x10);
    // mov rcx, [rsp]     (rcx = old_ptr)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x0C); self.cg_e8(0x24);
    // mov rdx, [rcx+8]   (rdx = len)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x51); self.cg_e8(0x08);
    // mov [rax+8], rdx   ([new+8] = len)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x50); self.cg_e8(0x08);

    // munmap(old_ptr, old_cap*8+16)
    // push rax  (save new_ptr) — stack: [rsp+0]=new_ptr [rsp+8]=old_ptr [rsp+16]=value
    self.cg_e8(0x50);
    // mov rdi, rcx       (rdi = old_ptr)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xCF);
    // mov rdx, [rcx]     (rdx = old_cap)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x11);
    // imul rdx, rdx, 8
    self.cg_e8(0x48); self.cg_e8(0x6B); self.cg_e8(0xD2); self.cg_e8(0x08);
    // add rdx, 16
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC2); self.cg_e8(0x10);
    // mov eax, 11  (SYS_munmap)
    self.cg_e8(0xB8); self.cg_e8(0x0B); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall  (rax=0 on success; rcx, r11 trashed)
    self.cg_e8(0x0F); self.cg_e8(0x05);

    // pop rcx  (rcx = new_ptr) — stack: [rsp+0]=old_ptr [rsp+8]=value
    self.cg_e8(0x59);
    // store new_ptr to local variable: mov rax,rcx → storeRax → mov rcx,rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC8);
    self.cg_storeRax(off);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);
    // add rsp, 8  (discard old_ptr) — stack: [rsp+0]=value
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x08);

    // Patch jl .no_grow to here
    poke8(self.code + jlNoGrow, self.codeLen - jlNoGrow - 1);

    // ---- APPEND (both paths join here) ----
    // Stack: [rsp+0]=value, rcx=array_ptr
    // pop rax               (restore value)
    self.cg_e8(0x58);
    // mov rdx, [rcx+8]      (len — reload; may have changed after grow)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x51); self.cg_e8(0x08);
    // lea rsi, [rcx+16]     (rsi = data start)
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x71); self.cg_e8(0x10);
    // mov [rsi+rdx*8], rax  (data[len] = value)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0xD6);
    // inc rdx
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC2);
    // mov [rcx+8], rdx      ([ptr+8] = len+1)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x51); self.cg_e8(0x08);
    // xor rax, rax          (return 0)
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
  }

  // Inline code for arr.pop(): decrement len, return last element (0 if empty)
  fn cg_genArrayPop(objNode: int64) {
    var aname: pchar := self.cg_nsval(objNode);
    var anlen: int64 := self.cg_nslen(objNode);
    var off: int64 := self.cg_findLocal(aname, anlen);
    // Load array ptr into rcx
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x4D); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x8D); self.cg_e32(off);
    }
    // test rcx, rcx; jz empty
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC9);
    self.cg_e8(0x0F); self.cg_e8(0x84);
    var jz1Pos: int64 := self.codeLen;
    self.cg_e32(0);
    // rdx = [rcx+8]  (len)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x51); self.cg_e8(0x08);
    // test rdx, rdx; jz empty
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xD2);
    self.cg_e8(0x0F); self.cg_e8(0x84);
    var jz2Pos: int64 := self.codeLen;
    self.cg_e32(0);
    // dec rdx
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCA);
    // [rcx+8] = rdx  (new len)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x51); self.cg_e8(0x08);
    // lea rsi, [rcx+16]
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x71); self.cg_e8(0x10);
    // rax = [rsi+rdx*8]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0xD6);
    // jmp done
    self.cg_e8(0xE9);
    var jmpPos: int64 := self.codeLen;
    self.cg_e32(0);
    // empty: patch jz targets here
    poke32(self.code + jz1Pos, self.codeLen - jz1Pos - 4);
    poke32(self.code + jz2Pos, self.codeLen - jz2Pos - 4);
    // xor rax, rax
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    // done:
    poke32(self.code + jmpPos, self.codeLen - jmpPos - 4);
  }

  // Generate a field load: evaluates object into rax, then loads field
  fn cg_genFieldLoad(ni: int64) {
    var obj: int64 := self.cg_nc0(ni);
    var fieldName: pchar := self.cg_nsval(ni);
    var fieldLen:  int64 := self.cg_nslen(ni);
    self.cg_genExpr(obj);
    // Array .length / .data field accessors
    if (self.cg_identIsArray(obj) != 0) {
      var lenStr:  pchar := "length";
      var dataStr: pchar := "data";
      if (self.cg_seq(fieldName, fieldLen, lenStr, 6)) {
        // mov rax, [rax+8]   (load len field)
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40); self.cg_e8(0x08);
      } else if (self.cg_seq(fieldName, fieldLen, dataStr, 4)) {
        // lea rax, [rax+16]  (pointer to first element, past {cap,len} header)
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x40); self.cg_e8(0x10);
      } else {
        self.cg_zeroRax();
      }
      return;
    }
    // Enum member access: EnumType.Variant → emit tag value as immediate
    if (self.cg_nkind(obj) == CGN_IDENT) {
      var ename: pchar := self.cg_nsval(obj);
      var elen:  int64 := self.cg_nslen(obj);
      var enumIdx: int64 := self.cg_findEnum(ename, elen);
      if (enumIdx >= 0) {
        var tagInfo: int64 := self.cg_findEnumVariant(enumIdx, fieldName, fieldLen);
        if (tagInfo >= 0) {
          self.cg_movRaxImm(tagInfo);
        } else {
          self.cg_zeroRax();
        }
        return;
      }
    }
    var classIdx: int64 := self.cg_objClassIdx(obj);
    var foff: int64 := -1;
    if (classIdx >= 0) { foff := self.cg_getFieldOffset(classIdx, fieldName, fieldLen); }
    if (foff < 0) {
      self.cg_zeroRax();
    } else if (foff == 0) {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x00);
    } else if (foff <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40); self.cg_e8(foff);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80); self.cg_e32(foff);
    }
    // WP-4.1-B: emit BSWAP after load for @big_endian fields
    if (foff >= 0 && classIdx >= 0) {
      var beInfo: int64 := self.cg_getFieldBigEndian(classIdx, fieldName, fieldLen);
      if ((beInfo & 1) != 0) {
        var tWidth: int64 := (beInfo >> 8) & 0xFF;
        self.cg_emitBswapRax(tWidth);
      }
    }
  }

  // Generate a method declaration (with implicit self as first param)
  fn cg_genMethodDecl(ni: int64, className: pchar, classNameLen: int64) {
    var mname: pchar := self.cg_nsval(ni);
    var mlen:  int64 := self.cg_nslen(ni);
    // WP-BC-19: record code start for VMT method slot patching
    var methodCodeStart: int64 := self.codeLen;
    // Build mangled name: className_methodName
    var mangLen: int64 := classNameLen + 1 + mlen;
    var mangBuf: int64 := mmap(0, mangLen + 1, 3, 34, -1, 0);
    var ii: int64 := 0;
    while (ii < classNameLen) { poke8(mangBuf + ii, StrCharAt(className, ii)); ii := ii + 1; }
    StrSetChar(mangBuf as pchar, classNameLen, 95);
    var jj: int64 := 0;
    while (jj < mlen) { poke8(mangBuf + classNameLen + 1 + jj, StrCharAt(mname, jj)); jj := jj + 1; }
    poke8(mangBuf + mangLen, 0);
    // Register label with mangled name
    self.cg_addLabel(mangBuf as pchar, mangLen, self.cg_lineOf(ni));
    // Track mangled name buffer for cleanup after patching (BUG-02)
    self.cg_trackTempBuf(mangBuf, mangLen + 1);
    // Reset locals
    self.localCount := 0;
    self.frameSize  := 0;
    // Set class context for self.field access
    self.curClassName    := className;
    self.curClassNameLen := classNameLen;
    // Emit prologue
    var prologuePatch: int64 := self.cg_emitPrologue();
    // Implicit self parameter at register 0 (rdi)
    var selfOff: int64 := self.cg_addLocal("self", 4);
    self.cg_setLocalType(self.localCount - 1, className, classNameLen);
    self.cg_spillRdi(selfOff);
    // Regular params start at register index 1
    var param: int64 := self.cg_nc0(ni);
    var paramIdx: int64 := 1;
    while (param != -1 && paramIdx < 6) {
      var pname: pchar := self.cg_nsval(param);
      var pnlen: int64 := self.cg_nslen(param);
      var poff: int64 := self.cg_addLocal(pname, pnlen);
      // Track param type if it's a user type (NK_TYPE_NAME = 60)
      var ptypeNode: int64 := self.cg_nc0(param);
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == 60) {
        self.cg_setLocalType(self.localCount - 1, self.cg_nsval(ptypeNode), self.cg_nslen(ptypeNode));
      }
      if (paramIdx == 1) { self.cg_spillRsi(poff); }
      else if (paramIdx == 2) { self.cg_spillRdx(poff); }
      else if (paramIdx == 3) { self.cg_spillRcx(poff); }
      else if (paramIdx == 4) { self.cg_spillR8(poff); }
      else if (paramIdx == 5) { self.cg_spillR9(poff); }
      paramIdx := paramIdx + 1;
      param := self.cg_nnext(param);
    }
    // Generate body
    var body: int64 := self.cg_nc2(ni);
    self.cg_genBlock(body);
    // Implicit return
    self.cg_zeroRax();
    self.cg_emitEpilogue();
    // Patch frame size
    var fs: int64 := self.frameSize + 15;
    var aligned: int64 := fs - (fs & 15);
    if (aligned == 0) { aligned := 16; }
    poke32(self.code + prologuePatch, aligned);
    // Clear class context
    self.curClassName    := 0 as pchar;
    self.curClassNameLen := 0;
    // WP-BC-19: register VMT method slot patch for virtual methods only
    var isVirtM: int64 := (self.cg_nival(ni) >> 1) & 1;
    var classIdx: int64 := self.cg_findClass(className, classNameLen);
    if (isVirtM != 0 && classIdx >= 0) {
      var slotCount: int64   := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTSLOTS);
      var methodList2: int64 := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTLIST);
      var vmtDataOff2: int64 := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTOFF);
      var si5: int64 := 0;
      while (si5 < slotCount) {
        var sName5: pchar := peek64(methodList2 + si5 * 16) as pchar;
        var sLen5:  int64 := peek64(methodList2 + si5 * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN);
        if (self.cg_seq(sName5, sLen5, mname, mlen) != 0) {
          self.cg_addVmtMethodPatch(vmtDataOff2 + si5 * 8, methodCodeStart);
          break;
        }
        si5 := si5 + 1;
      }
    }
  }

  // ------------------------------------------------------------------
  // Expression code generation — result always in RAX
  // ------------------------------------------------------------------

  fn cg_genExpr(ni: int64) {
    if (ni < 0) { self.cg_zeroRax(); return; }
    var k: int64 := self.cg_nkind(ni);

    if (k == CGN_LIT_INT) {
      self.cg_movRaxImm(self.cg_nival(ni));

    } else if (k == CGN_LIT_BOOL) {
      self.cg_movRaxImm(self.cg_nival(ni));

    } else if (k == CGN_LIT_CHAR) {
      self.cg_movRaxImm(self.cg_nival(ni));

    } else if (k == CGN_LIT_NULL) {
      self.cg_zeroRax();

    // WP-BC-13: format expression — evaluate inner expr; width/decimals available via nc1/nc2
    } else if (k == CGN_FORMAT_EXPR) {
      self.cg_genExpr(self.cg_nc0(ni));

    // WP-BC-14: null coalescing x ?? fallback — if x != null use x, else fallback
    } else if (k == CGN_NULL_COAL) {
      self.cg_genExpr(self.cg_nc0(ni));          // rax = lhs
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
      self.cg_e8(0x75);                            // jnz short (lhs is not null, keep it)
      var pSkip: int64 := self.codeLen;
      self.cg_e8(0);
      self.cg_genExpr(self.cg_nc1(ni));          // rax = fallback (only if lhs was null)
      poke8(self.code + pSkip, self.codeLen - pSkip - 1);

    // WP-BC-14: safe cast x as? T — pass-through in bootstrap (nullable = same repr)
    } else if (k == CGN_SAFE_CAST) {
      self.cg_genExpr(self.cg_nc0(ni));

    } else if (k == CGN_SIMD_NEW) {
      // parallel Array<T>(size) — evaluate size into rax; full SIMD alloc deferred
      var sizeNode: int64 := self.cg_nc1(ni);
      if (sizeNode >= 0) { self.cg_genExpr(sizeNode); }

    // WP-17: Range expression (1..100) - returns start value in rax
    } else if (k == CGN_RANGE) {
      // c0 = start, c1 = end
      // Generate: push start onto stack, then evaluate end, then pop start back
      // Result: rax = start value (end is stored but needs to be handled by caller)
      self.cg_genExpr(self.cg_nc0(ni));
      self.cg_pushRax();
      self.cg_genExpr(self.cg_nc1(ni));
      // Now rax = end, stack has start
      // For range iteration, we store end in a local for the loop
      // The caller (for loop) will handle iteration
      
    // WP-17: Where clause - just evaluate base type, constraint is compile-time only
    } else if (k == CGN_WHERE) {
      self.cg_genExpr(self.cg_nc0(ni));

    } else if (k == CGN_LIT_STR) {
      var sOff: int64 := self.cg_nsoff(ni);
      var sLen: int64 := self.cg_nslen(ni);
      var dataOff: int64 := self.cg_addStr(sOff, sLen);
      var patchPos: int64 := self.cg_emitLeaStr();
      self.cg_addPatch(patchPos, dataOff, 0, CG_PATCH_STR);

    } else if (k == CGN_REGEX_LIT) {
      var sOff: int64 := self.cg_nsoff(ni);
      var sLen: int64 := self.cg_nslen(ni);
      var dataOff: int64 := self.cg_addStr(sOff, sLen);
      var patchPos: int64 := self.cg_emitLeaStr();
      self.cg_addPatch(patchPos, dataOff, 0, CG_PATCH_STR);

    } else if (k == CGN_IDENT) {
      var name: pchar := self.cg_nsval(ni);
      var nlen: int64 := self.cg_nslen(ni);
      var off: int64 := self.cg_findLocal(name, nlen);
      if (off != 0) {
        // WP-3.1: @redundant vars use TMR majority-vote read
        var ridx: int64 := self.cg_findLocalIdx(name, nlen);
        if (ridx >= 0 && self.cg_isLocalRedundant(ridx) != 0) {
          self.cg_emitTmrRead(off, off - 8, off - 16);
        } else {
          self.cg_loadRax(off);
        }
      } else {
        // WP-13: Check if this is a captured variable from outer scope
        // If we have a static link, check if variable is captured via outer frame
        if (self.staticLinkOffset >= 0) {
          var capturedOff: int64 := self.cg_findCapturedVar(name, nlen);
          if (capturedOff != 0) {
            // Load static link into rbx, then access captured var via [rbx+offset]
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x5D); self.cg_e8(0x10); // mov rbx, [rbp+16]
            // mov rax, [rbx+capturedOff]
            if (capturedOff >= -128 && capturedOff <= 127) {
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x1B); self.cg_e8(capturedOff);
            } else {
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x84); self.cg_e8(0x1B);
              self.cg_e32(capturedOff);
            }
          } else {
            // Not local and not captured - check global, then constant
            var goff1: int64 := self.cg_findGlobal(name, nlen);
            if (goff1 >= 0) {
              self.cg_loadRaxGlobal(goff1);
            } else if (self.cg_hasConVal(name, nlen) != 0) {
              self.cg_movRaxImm(self.cg_findConVal(name, nlen));
            } else {
              self.cg_zeroRax();
            }
          }
        } else {
          var goff2: int64 := self.cg_findGlobal(name, nlen);
          if (goff2 >= 0) {
            self.cg_loadRaxGlobal(goff2);
          } else if (self.cg_hasConVal(name, nlen) != 0) {
            self.cg_movRaxImm(self.cg_findConVal(name, nlen));
          } else {
            self.cg_zeroRax();
          }
        }
      }

    } else if (k == CGN_BINOP) {
      var op: int64 := self.cg_nival(ni);
      var lhsNi: int64 := self.cg_nc0(ni);
      var rhsNi: int64 := self.cg_nc1(ni);
      // WP-10g: Constant Folding — both sides constant → single immediate
      if (self.cg_tryFold(ni) != 0) {
        self.cg_movRaxImm(self.foldBuf);
      } else if (op != CGT_AND && op != CGT_OR && self.cg_tryFold(lhsNi) != 0) {
        // LHS is constant: push it so the RHS function call can't clobber rbx
        var lhsVal: int64 := self.foldBuf;
        self.cg_movRaxImm(lhsVal);
        self.cg_pushRax();
        self.cg_genExpr(rhsNi);
        self.cg_popRbx();
        self.cg_emitBinOp(op);
      } else if (op != CGT_AND && op != CGT_OR && self.cg_tryFold(rhsNi) != 0) {
        // CSE: RHS is constant → eval LHS into rax, mov rbx,rax, load const (no push/pop)
        var rhsVal: int64 := self.foldBuf;
        self.cg_genExpr(lhsNi);
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC3);  // mov rbx, rax
        self.cg_movRaxImm(rhsVal);
        self.cg_emitBinOp(op);
      } else if (op == CGT_PLUS && self.cg_isPcharExpr(lhsNi) != 0 && self.cg_isPcharExpr(rhsNi) != 0) {
        // pchar + pchar → StrConcat: eval lhs→rdi, rhs→rsi, emit concat body
        self.cg_genExpr(lhsNi);
        self.cg_pushRax();
        self.cg_genExpr(rhsNi);
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);  // mov rsi, rax (b)
        self.cg_popRdi();                                         // pop rdi     (a)
        self.cg_emitStrConcatBody();
      } else {
        // General: eval LHS, push; eval RHS; pop rbx
        self.cg_genExpr(lhsNi);
        self.cg_pushRax();
        self.cg_genExpr(rhsNi);
        self.cg_popRbx();
        self.cg_emitBinOp(op);
      }

    } else if (k == CGN_UNOP) {
      var op: int64 := self.cg_nival(ni);
      // WP-10g: fold constant unary expressions
      if (op == 111) {
        // @ident — address-of: lea rax, [rbp+off]
        var inner0: int64 := self.cg_nc0(ni);
        if (inner0 >= 0 && self.cg_nkind(inner0) == CGN_IDENT) {
          var iname0: pchar := self.cg_nsval(inner0);
          var ilen0:  int64 := self.cg_nslen(inner0);
          var ioff0:  int64 := self.cg_findLocal(iname0, ilen0);
          if (ioff0 != 0) {
            if (ioff0 >= -128 && ioff0 <= -1) {
              self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x45); self.cg_e8(ioff0);
            } else {
              self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x85); self.cg_e32(ioff0);
            }
          } else { self.cg_zeroRax(); }
        } else { self.cg_zeroRax(); }
      } else if (self.cg_tryFold(ni) != 0) {
        self.cg_movRaxImm(self.foldBuf);
      } else {
      self.cg_genExpr(self.cg_nc0(ni));
      if (op == CGT_MINUS) {
        self.cg_negRax();
      } else if (op == CGT_NOT) {
        // logical not: rax = (rax == 0) ? 1 : 0
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x0F); self.cg_e8(0x94); self.cg_e8(0xC0);  // sete al
        self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
      } else if (op == CGT_BITNOT) {
        self.cg_notRax();
      }
      }  // end else (not const-foldable)

    } else if (k == CGN_CALL) {
      self.cg_genCall(ni);

    } else if (k == CGN_NEW) {
      // new T() — allocate class instance via mmap(0, 4096, 3, 34, -1, 0)
      self.cg_movRaxImm(0);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7); // mov rdi,rax
      self.cg_movRaxImm(4096); self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6); // mov rsi,rax
      self.cg_movRaxImm(3);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2); // mov rdx,rax
      self.cg_movRaxImm(34);
      self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);  // mov r10, rax
      self.cg_movRaxImm(-1);
      self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0);  // xor r8, r8
      self.cg_e8(0x49); self.cg_e8(0xFF); self.cg_e8(0xC8);  // dec r8 → r8=-1
      self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9, r9
      self.cg_movRaxImm(9);
      self.cg_e8(0x0F); self.cg_e8(0x05);
      // WP-10d: check if type is a struct (vmtDataOff == -1) → skip VMT setup
      var tname: pchar := self.cg_nsval(ni);
      var tlen:  int64 := self.cg_nslen(ni);
      var ciNew: int64 := self.cg_findClass(tname, tlen);
      var isStructNew: int64 := 0;
      if (ciNew >= 0) {
        var vmtChk: int64 := peek64(self.classLayouts + ciNew * CG_CLASS_SZ + CG_CLASS_OFF_VMTOFF);
        if (vmtChk == -1) { isStructNew := 1; }
      }
      if (isStructNew == 0) {
        // WP-10a: rax = object ptr; write VMT pointer at [rax+0]
        // mov rcx, imm64 (placeholder = 0, patched later with VMT vaddr)
        self.cg_e8(0x48); self.cg_e8(0xB9);
        var vmtPatchPos: int64 := self.codeLen;
        self.cg_e64(0);                                         // 8-byte placeholder
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x08); // mov [rax], rcx
        // Record patch: fill in VMT address for this class at vmtPatchPos
        self.cg_addVmtPatch(vmtPatchPos, tname, tlen);
      }

    } else if (k == CGN_FIELD) {
      self.cg_genFieldLoad(ni);

    } else if (k == CGN_INDEX) {
      // arr[i]: nc0=arr, nc1=index
      // Eval index first, push; then eval arr; pop index into rbx
      self.cg_genExpr(self.cg_nc1(ni));   // rax = index
      self.cg_pushRax();
      self.cg_genExpr(self.cg_nc0(ni));   // rax = array ptr
      self.cg_popRbx();                    // rbx = index
      var baseNode: int64 := self.cg_nc0(ni);
      var isPchar:  int64 := 0;
      var isArray:  int64 := 0;
      var arrElemClassIdx: int64 := -1;
      var arrElemSize: int64 := 8;
      if (self.cg_nkind(baseNode) == CGN_IDENT) {
        var bname: pchar := self.cg_nsval(baseNode);
        var blen:  int64 := self.cg_nslen(baseNode);
        var lidx: int64 := self.cg_findLocalIdx(bname, blen);
        if (lidx >= 0) {
          var tb: int64 := self.localTypes + lidx * CG_LOCTYPE_SZ;
          var tp: pchar := peek64(tb) as pchar;
          var tn: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
          if (tn == 5 && self.cg_seq(tp, tn, "pchar", 5)) { isPchar := 1; }
          if (peek8(self.localIsArray + lidx) != 0) {
            isArray := 1;
            // Check for struct element type in localTypes (stored for Array<T> locals)
            if (tp != 0 as pchar && tn > 0) {
              var eClassIdx: int64 := self.cg_findClass(tp, tn);
              if (eClassIdx >= 0) {
                arrElemClassIdx := eClassIdx;
                arrElemSize := self.cg_classStructSize(eClassIdx);
              }
            }
          }
        } else {
          var gidx: int64 := self.cg_findGlobalIdx(bname, blen);
          if (gidx >= 0 && peek8(self.globalIsPchar + gidx) != 0) { isPchar := 1; }
        }
      } else if (self.cg_nkind(baseNode) == CGN_FIELD) {
        // Class field: check if it's Array<StructType>
        var innerObj: int64 := self.cg_nc0(baseNode);
        var fldNm: pchar := self.cg_nsval(baseNode);
        var fldNl: int64 := self.cg_nslen(baseNode);
        var parentCi: int64 := self.cg_objClassIdx(innerObj);
        var eClassIdx: int64 := self.cg_getFieldElemClassIdx(parentCi, fldNm, fldNl);
        if (eClassIdx >= 0) {
          isArray := 1;
          arrElemClassIdx := eClassIdx;
          arrElemSize := self.cg_classStructSize(eClassIdx);
        } else if (self.cg_isFieldArray(parentCi, fldNm, fldNl) != 0) {
          isArray := 1;
          // arrElemSize bleibt 8 (scalar Array<int64> etc.)
        }
      }
      if (isPchar == 1) {
        // movzx rax, byte [rax+rbx]
        self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0x04); self.cg_e8(0x18);
      } else if (isArray == 1 && arrElemSize > 8) {
        // Struct array: return element ADDRESS (not value)
        // lea rcx, [rax+16]  (skip {cap,len} header)
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x48); self.cg_e8(0x10);
        // imul rbx, rbx, arrElemSize  (index * element size)
        if (arrElemSize <= 127) {
          self.cg_e8(0x48); self.cg_e8(0x6B); self.cg_e8(0xDB); self.cg_e8(arrElemSize);
        } else {
          self.cg_e8(0x48); self.cg_e8(0x69); self.cg_e8(0xDB); self.cg_e32(arrElemSize);
        }
        // lea rax, [rcx+rbx]  (element address)
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x04); self.cg_e8(0x19);
      } else if (isArray == 1) {
        // Scalar array<T>: skip 16-byte {cap,len} header, then 8-byte stride
        // lea rcx, [rax+16]
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x48); self.cg_e8(0x10);
        // mov rax, [rcx+rbx*8]
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0xD9);
      } else {
        // plain int64 pointer: direct 8-byte stride, no header
        // Guard null: test rax,rax; jnz .ok; xor rax,rax; jmp .done; .ok: mov rax,[rax+rbx*8]; .done:
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x75); self.cg_e8(7);                        // jnz +7 (to ok)
        self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);  // xor rax, rax
        self.cg_e8(0xEB); self.cg_e8(4);                        // jmp +4 (to done)
        // ok: mov rax, [rax+rbx*8]
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0xD8);
        // done:
      }

    } else if (k == CGN_LIT_FLOAT) {
      // WP-11: float literal — parse IEEE 754 bits and load as immediate
      var floatBits: int64 := self.cg_parseFloat(self.pSrc, self.cg_nsoff(ni), self.cg_nslen(ni));
      self.cg_movRaxImm(floatBits);

    } else if (k == CGN_CAST) {
      // WP-11: x as Type — evaluate source, then apply integer truncation/extension
      self.cg_genExpr(self.cg_nc0(ni));
      var typeNode: int64 := self.cg_nc1(ni);
      if (typeNode >= 0) {
        var tname: pchar := self.cg_nsval(typeNode);
        var tlen: int64 := self.cg_nslen(typeNode);
        if (self.cg_seq(tname, tlen, "i8", 2)) {
          // movsx rax, al  — sign-extend byte to qword
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBE); self.cg_e8(0xC0);
        } else if (self.cg_seq(tname, tlen, "u8", 2)) {
          // movzx rax, al  — zero-extend byte to qword
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
        } else if (self.cg_seq(tname, tlen, "i16", 3)) {
          // movsx rax, ax  — sign-extend word to qword
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBF); self.cg_e8(0xC0);
        } else if (self.cg_seq(tname, tlen, "u16", 3)) {
          // movzx rax, ax  — zero-extend word to qword
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB7); self.cg_e8(0xC0);
        } else if (self.cg_seq(tname, tlen, "i32", 3)) {
          // movsxd rax, eax  — sign-extend dword to qword
          self.cg_e8(0x48); self.cg_e8(0x63); self.cg_e8(0xC0);
        } else if (self.cg_seq(tname, tlen, "u32", 3)) {
          // mov eax, eax  — zero-extends to rax automatically on x86-64
          self.cg_e8(0x89); self.cg_e8(0xC0);
        }
        // f64: convert int64 bits in rax to IEEE 754 double via cvtsi2sd
        if (self.cg_seq(tname, tlen, "f64", 3)) {
          // cvtsi2sd xmm0, rax  (F2 48 0F 2A C0)
          self.cg_e8(0xF2); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x2A); self.cg_e8(0xC0);
          // movq rax, xmm0      (66 48 0F 7E C0)
          self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC0);
        }
        // i64, u64, pchar, bool, char, f32: no-op (already 64-bit in rax)
      }

    } else if (k == CGN_IS_EXPR) {
      // BUG-08 supplement: x is Type — runtime type check via VMT
      // c0 = object expression, c1 = type node
      self.cg_genExpr(self.cg_nc0(ni));
      var typeNode: int64 := self.cg_nc1(ni);
      if (typeNode >= 0) {
        var tname: pchar := self.cg_nsval(typeNode);
        var tlen: int64 := self.cg_nslen(typeNode);
        var classIdx: int64 := self.cg_findClass(tname, tlen);
        if (classIdx >= 0) {
          // Load VMT pointer from object: mov rcx, [rax]
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x08);
          // Load expected VMT address
          var vmtOff: int64 := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTOFF);
          var expectedVmt: int64 := CG_ELF_BASE + CG_CODE_OFF + self.codeLen + 20 + vmtOff;
          // mov rdx, imm64 (expected VMT)
          self.cg_e8(0x48); self.cg_e8(0xBA);
          self.cg_e64(expectedVmt);
          // cmp rcx, rdx; sete al; movzx rax, al
          self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xD1);
          self.cg_e8(0x0F); self.cg_e8(0x94); self.cg_e8(0xC0);
          self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
        } else {
          self.cg_zeroRax();
        }
      } else {
        self.cg_zeroRax();
      }

    } else if (k == CGN_CLOSURE) {
      // WP-13: closure expression — allocate closure struct {fnPtr:8, envPtr:8}
      // c0 = function reference, c1 = captured vars list
      var fnNode: int64 := self.cg_nc0(ni);
      // Allocate closure on stack (16 bytes)
      var closureOff: int64 := self.cg_addLocal("__closure__", 10);
      // Store function pointer
      if (fnNode >= 0 && self.cg_nkind(fnNode) == CGN_IDENT) {
        var fnName: pchar := self.cg_nsval(fnNode);
        var fnLen: int64 := self.cg_nslen(fnNode);
        // lea rax, [rip + fnName] — use label reference
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
        var fnPatch: int64 := self.codeLen;
        self.cg_e32(0);
        self.cg_addPatch(fnPatch, fnName as int64, fnLen, CG_PATCH_CALL);
        self.cg_storeRax(closureOff);
      } else {
        self.cg_zeroRax();
        self.cg_storeRax(closureOff);
      }
      // Store environment pointer (static link or null)
      if (self.staticLinkOffset >= 0) {
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x45); self.cg_e8(0x10);
        self.cg_pushRax();
        self.cg_loadRax(closureOff);
        // mov [rax+8], rbx (env ptr)
        self.cg_popRbx();
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x58); self.cg_e8(0x08);
      }
      // Return closure pointer
      self.cg_loadRax(closureOff);

    } else if (k == CGN_MAP_LIT) {
      // WP-BI-06: { key: val, ... } — allocate hash map, insert all entries
      // Count entries to compute initial capacity (next power of 2 >= n*2, min 8)
      var cnt: int64 := 0;
      var tmpE: int64 := self.cg_nc0(ni);
      while (tmpE != -1) { cnt := cnt + 1; tmpE := self.cg_nnext(tmpE); }
      var cap: int64 := 8;
      while (cap < cnt * 2) { cap := cap * 2; }
      // Call _lyx_map_new(cap) → rax = map ptr
      self.cg_e8(0xBF); self.cg_e32(cap);                           // mov edi, cap
      var ppMN: int64 := self.cg_emitCall();
      poke32(self.code + ppMN, CG_H_MAP_NEW - ppMN - 4);
      self.cg_e8(0x50);                                              // push rax (map ptr)
      // Insert each entry: key→rsi, val→rdx, map→rdi, call _lyx_map_set
      var entry: int64 := self.cg_nc0(ni);
      while (entry != -1) {
        self.cg_genExpr(self.cg_nc0(entry));                         // key → rax
        self.cg_e8(0x50);                                            // push rax (save key)
        self.cg_genExpr(self.cg_nc1(entry));                         // val → rax
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2);      // mov rdx, rax
        self.cg_e8(0x5E);                                            // pop rsi (key)
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24); // mov rdi,[rsp]
        var ppMS: int64 := self.cg_emitCall();
        poke32(self.code + ppMS, CG_H_MAP_SET - ppMS - 4);
        entry := self.cg_nnext(entry);
      }
      self.cg_e8(0x58);                                              // pop rax (return map ptr)

    } else if (k == CGN_SET_LIT) {
      // WP-BI-06: { val, ... } — allocate hash map used as set (value always 1)
      var cnt: int64 := 0;
      var tmpEl: int64 := self.cg_nc0(ni);
      while (tmpEl != -1) { cnt := cnt + 1; tmpEl := self.cg_nnext(tmpEl); }
      var cap: int64 := 8;
      while (cap < cnt * 2) { cap := cap * 2; }
      // Call _lyx_map_new(cap) → rax = map ptr
      self.cg_e8(0xBF); self.cg_e32(cap);                           // mov edi, cap
      var ppSN: int64 := self.cg_emitCall();
      poke32(self.code + ppSN, CG_H_MAP_NEW - ppSN - 4);
      self.cg_e8(0x50);                                              // push rax (map ptr)
      // Insert each element: elem→rsi, value=1→rdx, map→rdi, call _lyx_map_set
      var el: int64 := self.cg_nc0(ni);
      while (el != -1) {
        self.cg_genExpr(el);                                         // elem → rax
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);      // mov rsi, rax
        self.cg_e8(0xBA); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov edx, 1
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24); // mov rdi,[rsp]
        var ppSS: int64 := self.cg_emitCall();
        poke32(self.code + ppSS, CG_H_MAP_SET - ppSS - 4);
        el := self.cg_nnext(el);
      }
      self.cg_e8(0x58);                                              // pop rax (return map ptr)

    } else if (k == CGN_IN_EXPR) {
      // WP-BI-06: lhs in rhs — call _lyx_map_has(map=rhs, key=lhs) → 1 or 0
      self.cg_genExpr(self.cg_nc1(ni));                              // rhs (collection) → rax
      self.cg_e8(0x50);                                              // push rax (map ptr)
      self.cg_genExpr(self.cg_nc0(ni));                              // lhs (element) → rax
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);        // mov rsi, rax (key)
      self.cg_e8(0x5F);                                              // pop rdi (map ptr)
      var ppMH: int64 := self.cg_emitCall();
      poke32(self.code + ppMH, CG_H_MAP_HAS - ppMH - 4);

    } else if (k == 100) {
      // WP-BC-51: NK_ARRAY_LIT — [e1, e2, ...] stack-allocated array with {cap,len} header
      // Layout: [rsp+0]=cap, [rsp+8]=len, [rsp+16]=elem0, [rsp+24]=elem1, ...
      // rax = rsp (pointer to header; indexer skips 16 bytes to reach elements)
      var cnt: int64 := 0;
      var el: int64 := self.cg_nc0(ni);
      while (el != -1) { cnt := cnt + 1; el := self.cg_nnext(el); }
      if (cnt > 0) {
        var stackBytes: int64 := cnt * 8 + 16;
        // sub rsp, stackBytes
        self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC); self.cg_e32(stackBytes);
        // write cap = cnt at [rsp+0]
        self.cg_movRaxImm(cnt);
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);
        // write len = cnt at [rsp+8]
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);
        // write elements at [rsp+16+i*8]
        var i: int64 := 0;
        el := self.cg_nc0(ni);
        while (el != -1) {
          self.cg_genExpr(el);
          var disp: int64 := 16 + i * 8;
          if (disp <= 127) {
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(disp);
          } else {
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x84); self.cg_e8(0x24); self.cg_e32(disp);
          }
          i := i + 1;
          el := self.cg_nnext(el);
        }
        // rax = rsp (pointer to header)
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE0);
      } else {
        self.cg_zeroRax();
      }

    } else {
      // Unknown expression: emit 0
      self.cg_zeroRax();
    }
  }

  // Infer the print dispatch type for a single argument node.
  // Returns: 0=int64/PrintInt  1=pchar/PrintStr  2=f64/PrintFloat  3=bool/PrintBool
  fn cg_inferPrintType(argNi: int64): int64 {
    var k: int64 := self.cg_nkind(argNi);
    if (k == CGN_LIT_STR)  { return 1; }
    if (k == CGN_LIT_FLOAT) { return 2; }
    if (k == CGN_LIT_BOOL)  { return 3; }
    if (k == CGN_IDENT) {
      var nm: pchar := self.cg_nsval(argNi);
      var nl: int64  := self.cg_nslen(argNi);
      var lidx: int64 := self.cg_findLocalIdx(nm, nl);
      if (lidx >= 0) {
        var tb: int64  := self.localTypes + lidx * CG_LOCTYPE_SZ;
        var tp: pchar  := peek64(tb) as pchar;
        var tn: int64  := peek64(tb + CG_LOCTYPE_OFF_LEN);
        if (self.cg_seq(tp, tn, "f64",   3)) { return 2; }
        if (self.cg_seq(tp, tn, "pchar", 5)) { return 1; }
        if (self.cg_seq(tp, tn, "bool",  4)) { return 3; }
      } else {
        var gidx: int64 := self.cg_findGlobalIdx(nm, nl);
        if (gidx >= 0 && peek8(self.globalIsPchar + gidx) != 0) { return 1; }
      }
    }
    return 0;
  }

  // Emit individual print calls for each argument in argNode list.
  // Type is inferred per argument; addNewline=1 appends "\n"; isStderr=1 uses fd=2.
  fn cg_genPrintMulti(argNode: int64, addNewline: int64, isStderr: int64) {
    var hStr: int64 := CG_H_PRINTSTR;
    var hInt: int64 := CG_H_PRINTINT;
    if (isStderr == 1) { hStr := CG_H_EPRINTSTR; hInt := CG_H_EPRINTINT; }
    var cur: int64 := argNode;
    while (cur >= 0) {
      var pt: int64 := self.cg_inferPrintType(cur);
      self.cg_genExpr(cur);
      // mov rdi, rax
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);
      if (pt == 1) {
        var pp: int64 := self.cg_emitCall();
        poke32(self.code + pp, hStr - pp - 4);
      } else if (pt == 2) {
        // f64 stub: emit "0.0\0" constant and print it
        var pfOff: int64 := self.dataLen;
        self.cg_edata(48); self.cg_edata(46); self.cg_edata(48); self.cg_edata(0);
        self.cg_emitLeaRdiData(pfOff);
        var pp: int64 := self.cg_emitCall();
        poke32(self.code + pp, hStr - pp - 4);
      } else if (pt == 3) {
        var pbTOff: int64 := self.dataLen;
        self.cg_edata(116); self.cg_edata(114); self.cg_edata(117); self.cg_edata(101); self.cg_edata(0);
        var pbFOff: int64 := self.dataLen;
        self.cg_edata(102); self.cg_edata(97); self.cg_edata(108); self.cg_edata(115); self.cg_edata(101); self.cg_edata(0);
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);  // test rdi, rdi
        self.cg_e8(0x74);                                        // jz .pbFalse
        var pbFJ: int64 := self.codeLen; self.cg_e8(0);
        self.cg_emitLeaRdiData(pbTOff);
        var ppbT: int64 := self.cg_emitCall();
        poke32(self.code + ppbT, hStr - ppbT - 4);
        self.cg_e8(0xEB);                                        // jmp .pbEnd
        var pbEJ: int64 := self.codeLen; self.cg_e8(0);
        poke8(self.code + pbFJ, self.codeLen - pbFJ - 1);
        self.cg_emitLeaRdiData(pbFOff);
        var ppbF: int64 := self.cg_emitCall();
        poke32(self.code + ppbF, hStr - ppbF - 4);
        poke8(self.code + pbEJ, self.codeLen - pbEJ - 1);
      } else {
        var pp: int64 := self.cg_emitCall();
        poke32(self.code + pp, hInt - pp - 4);
      }
      cur := self.cg_nnext(cur);
    }
    if (addNewline == 1) {
      var nlOff: int64 := self.dataLen;
      self.cg_edata(10); self.cg_edata(0);
      self.cg_emitLeaRdiData(nlOff);
      var ppNL: int64 := self.cg_emitCall();
      poke32(self.code + ppNL, hStr - ppNL - 4);
    }
    self.cg_zeroRax();
  }

  // Generate a function call (NK_CALL node)
  fn cg_genCall(ni: int64) {
    var fname: pchar := self.cg_nsval(ni);
    var fnlen: int64 := self.cg_nslen(ni);
    var isMethod: int64 := self.cg_nival(ni);

    // WP-BC-24: generic call (iVal==2) — build mangled name and register JMP stub
    if (isMethod == 2) {
      var typeArgsNi: int64 := self.cg_nc2(ni);
      var mangBuf: int64 := mmap(0, fnlen + 256, 3, 34, -1, 0);
      var mangLen: int64 := self.cg_buildMangledName(fname, fnlen, typeArgsNi, mangBuf);
      if (self.cg_monoExists(mangBuf as pchar, mangLen) == 0) {
        self.cg_addMono(mangBuf as pchar, mangLen, fname, fnlen);
      }
      // Emit call to mangled name (JMP stub will redirect to generic function)
      isMethod := 0;
      fname := mangBuf as pchar;
      fnlen := mangLen;
    }

    // Count args
    var argNode: int64 := self.cg_nc0(ni);
    if (isMethod == 1) { argNode := self.cg_nc1(ni); }

    // Intercept array built-in methods before arg evaluation (WP-10b)
    if (isMethod == 1) {
      var arrObj: int64 := self.cg_nc0(ni);
      if (self.cg_identIsArray(arrObj) != 0) {
        var pushStr: pchar := "push";
        var popStr:  pchar := "pop";
        if (self.cg_seq(fname, fnlen, pushStr, 4)) {
          self.cg_genArrayPush(arrObj, argNode);
          return;
        } else if (self.cg_seq(fname, fnlen, popStr, 3)) {
          self.cg_genArrayPop(arrObj);
          return;
        }
      }
    }
    // Intercept push(arr, val) / pop(arr) free-function forms before arg evaluation
    if (isMethod == 0) {
      if (self.cg_seq(fname, fnlen, "push", 4)) {
        var pushArr: int64 := argNode;
        var pushVal: int64 := self.cg_nnext(argNode);
        if (pushArr >= 0 && pushVal >= 0) {
          self.cg_genArrayPush(pushArr, pushVal);
          return;
        }
      }
      if (self.cg_seq(fname, fnlen, "pop", 3)) {
        if (argNode >= 0) {
          self.cg_genArrayPop(argNode);
          return;
        }
      }
      // Print / PrintLn multi-arg compile-time type dispatch (WP-OUT-01)
      if (self.cg_seq(fname, fnlen, "Print", 5) ||
          self.cg_seq(fname, fnlen, "PrintLn", 7) ||
          self.cg_seq(fname, fnlen, "Println", 7)) {
        var addNl: int64 := 0;
        if (self.cg_seq(fname, fnlen, "PrintLn", 7) ||
            self.cg_seq(fname, fnlen, "Println", 7)) { addNl := 1; }
        self.cg_genPrintMulti(argNode, addNl, 0);
        return;
      }
      // EPrint / EPrintLn multi-arg to stderr (WP-OUT-02)
      if (self.cg_seq(fname, fnlen, "EPrint", 6) ||
          self.cg_seq(fname, fnlen, "EPrintLn", 8)) {
        var addNl: int64 := 0;
        if (self.cg_seq(fname, fnlen, "EPrintLn", 8)) { addNl := 1; }
        self.cg_genPrintMulti(argNode, addNl, 1);
        return;
      }
    }

    var argc: int64 := 0;
    var cur: int64 := argNode;
    while (cur != -1) { argc := argc + 1; cur := self.cg_nnext(cur); }

    // For method calls: push self (object) as first arg
    if (isMethod == 1) {
      self.cg_genExpr(self.cg_nc0(ni));
      self.cg_pushRax();
      argc := argc + 1;
    }

    // Evaluate each arg and push
    cur := argNode;
    while (cur != -1) {
      self.cg_genExpr(cur);
      self.cg_pushRax();
      cur := self.cg_nnext(cur);
    }

    // Pop args into registers
    if (argc >= 6) { self.cg_e8(0x41); self.cg_e8(0x59); }  // pop r9  (arg5)
    if (argc >= 5) { self.cg_e8(0x41); self.cg_e8(0x58); }  // pop r8  (arg4)
    if (argc >= 4) { self.cg_popRcx(); }                      // pop rcx (arg3)
    if (argc >= 3) { self.cg_popRdx(); }                      // pop rdx (arg2)
    if (argc >= 2) { self.cg_popRsi(); }                      // pop rsi (arg1)
    if (argc >= 1) { self.cg_popRdi(); }                      // pop rdi (arg0)
    
    // WP-13: For nested function calls, pass static link (rbp+16 from outer frame)
    // Check if this is a nested function by checking staticLinkOffset >= 0
    if (self.staticLinkOffset >= 0) {
      // Push static link as hidden first argument
      // mov rax, [rbp+16]  (load static link from outer frame)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x45); self.cg_e8(0x10);
      self.cg_pushRax();
      // Adjust: pop into r10 (8th arg) or push before other args
      // For simplicity, we pass static link in r10 (sysv abi: r10 for special args)
      self.cg_popRax();
      self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);  // mov r10, rax
    }

    // For method calls: mangle name and emit call
    if (isMethod == 1) {
      var objNode: int64 := self.cg_nc0(ni);
      var classIdx: int64 := self.cg_objClassIdx(objNode);
      if (classIdx >= 0) {
        var clsBase: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
        var clsName: pchar := peek64(clsBase) as pchar;
        var clsLen:  int64 := peek64(clsBase + CG_CLASS_OFF_NAMELEN);
        var mangLen: int64 := clsLen + 1 + fnlen;
        var mangBuf: int64 := mmap(0, mangLen + 1, 3, 34, -1, 0);
        var mi: int64 := 0;
        while (mi < clsLen) { poke8(mangBuf + mi, StrCharAt(clsName, mi)); mi := mi + 1; }
        StrSetChar(mangBuf as pchar, clsLen, 95);
        var mj: int64 := 0;
        while (mj < fnlen) { poke8(mangBuf + clsLen + 1 + mj, StrCharAt(fname, mj)); mj := mj + 1; }
        poke8(mangBuf + mangLen, 0);
        var pp: int64 := self.cg_emitCall();
        self.cg_addPatch(pp, mangBuf, mangLen, CG_PATCH_CALL);
        // Track mangled method name buffer for cleanup after patching (BUG-02)
        self.cg_trackTempBuf(mangBuf, mangLen + 1);
      } else {
        var pp: int64 := self.cg_emitCall();
        self.cg_addPatch(pp, fname as int64, fnlen, CG_PATCH_CALL);
      }
      return;
    }

    // Check for builtin functions
    var pstr: pchar := "PrintStr";
    var pint: pchar := "PrintInt";
    var slen: pchar := "StrLen";
    var mmapn: pchar := "mmap";
    var pk8: pchar := "poke8";
    var pk64: pchar := "poke64";
    var gk8: pchar := "peek8";
    var gk64: pchar := "peek64";
    var pk32: pchar := "poke32";
    var gk32: pchar := "peek32";

    if (self.cg_seq(fname, fnlen, pstr, 8)) {
      // call _lyx_print_str  (rdi already has the arg)
      var pp: int64 := self.cg_emitCall();
      poke32(self.code + pp, CG_H_PRINTSTR - pp - 4);

    } else if (self.cg_seq(fname, fnlen, pint, 8)) {
      var pp: int64 := self.cg_emitCall();
      poke32(self.code + pp, CG_H_PRINTINT - pp - 4);

    } else if (self.cg_seq(fname, fnlen, "EPrintStr", 9)) {
      var pp: int64 := self.cg_emitCall();
      poke32(self.code + pp, CG_H_EPRINTSTR - pp - 4);

    } else if (self.cg_seq(fname, fnlen, "EPrintInt", 9)) {
      var pp: int64 := self.cg_emitCall();
      poke32(self.code + pp, CG_H_EPRINTINT - pp - 4);

    } else if (self.cg_seq(fname, fnlen, "EPrintStrLn", 11)) {
      // EPrintStrLn(s): EPrintStr(s) then "\n" to stderr
      var pp: int64 := self.cg_emitCall();
      poke32(self.code + pp, CG_H_EPRINTSTR - pp - 4);
      var enlOff: int64 := self.dataLen;
      self.cg_edata(10); self.cg_edata(0);
      self.cg_emitLeaRdiData(enlOff);
      var ppNL: int64 := self.cg_emitCall();
      poke32(self.code + ppNL, CG_H_EPRINTSTR - ppNL - 4);
      self.cg_zeroRax();

    } else if (self.cg_seq(fname, fnlen, "EPrintFloat", 11)) {
      // EPrintFloat(f: f64): call _lyx_f64_to_str(xmm0) → rax=buf → call _lyx_eprint_str
      var ppEpf: int64 := self.cg_emitCall();
      poke32(self.code + ppEpf, CG_H_F64STR - ppEpf - 4);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);  // mov rdi, rax
      var ppEps: int64 := self.cg_emitCall();
      poke32(self.code + ppEps, CG_H_EPRINTSTR - ppEps - 4);
      self.cg_zeroRax();

    } else if (self.cg_seq(fname, fnlen, "EPrintBool", 10)) {
      // EPrintBool(b): print "true" or "false" to stderr
      var epbTOff: int64 := self.dataLen;
      self.cg_edata(116); self.cg_edata(114); self.cg_edata(117); self.cg_edata(101); self.cg_edata(0);
      var epbFOff: int64 := self.dataLen;
      self.cg_edata(102); self.cg_edata(97); self.cg_edata(108); self.cg_edata(115); self.cg_edata(101); self.cg_edata(0);
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);  // test rdi, rdi
      self.cg_e8(0x74); var epbFJ: int64 := self.codeLen; self.cg_e8(0);
      self.cg_emitLeaRdiData(epbTOff);
      var ppepbT: int64 := self.cg_emitCall();
      poke32(self.code + ppepbT, CG_H_EPRINTSTR - ppepbT - 4);
      self.cg_e8(0xEB); var epbEJ: int64 := self.codeLen; self.cg_e8(0);
      poke8(self.code + epbFJ, self.codeLen - epbFJ - 1);
      self.cg_emitLeaRdiData(epbFOff);
      var ppepbF: int64 := self.cg_emitCall();
      poke32(self.code + ppepbF, CG_H_EPRINTSTR - ppepbF - 4);
      poke8(self.code + epbEJ, self.codeLen - epbEJ - 1);
