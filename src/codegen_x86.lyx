            // mov [rbx+rcx*8+16], rax — hinter dem {cap,len}-Kopf
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x5C); self.cg_e8(0x24); self.cg_e8(0x08);
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x0C); self.cg_e8(0x24);
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0xCB); self.cg_e8(0x10);
            // inc rcx; mov [rsp], rcx; cmp rcx, N
            self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC1);
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x0C); self.cg_e8(0x24);
            self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xF9); self.cg_e32(fixedSz);
