      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x10);  // mov rsi, [rsp+16] = s
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x4C); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rcx, [rsp+8] = len
      self.cg_e8(0xF3); self.cg_e8(0xA4);  // rep movsb
      self.cg_e8(0xC6); self.cg_e8(0x07); self.cg_e8(0x00);  // mov byte [rdi], 0
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0x24);  // mov rax, [rsp] = buf
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x18);  // add rsp, 24

    } else if (self.cg_seq(fname, fnlen, "IntToStr", 8) || self.cg_seq(fname, fnlen, "StrFromInt", 10)) {
      // IntToStr/StrFromInt(n): rdi=n → rax=pchar (decimal string)
      // Allocate 24-byte buffer; write digits backwards from pos 22; return start ptr.
      self.cg_e8(0x57);  // push rdi (n)
      // mmap(0, 24, 3, 34, -1, 0)
      self.cg_e8(0x31); self.cg_e8(0xFF);
      self.cg_e8(0xBE); self.cg_e8(0x18); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov esi, 24
      self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);
      self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);
      self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // → rax=buf
      self.cg_e8(0x50);  // push rax (buf); [rsp]=buf [rsp+8]=n
      // rsi = buf+22; null-term; dec rsi; rax = n
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x00);  // mov rsi, [rsp] = buf
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC6); self.cg_e8(0x16);  // add rsi, 22
      self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x00);  // mov byte [rsi], 0
      self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);  // dec rsi
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rax, [rsp+8] = n
      // n==0 special case
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
      self.cg_e8(0x75); var itsNZ: int64 := self.codeLen; self.cg_e8(0);  // jnz .itsnonzero
      self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x30);  // mov byte [rsi], '0'
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF0);  // mov rax, rsi
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);  // add rsp, 16
      self.cg_e8(0xEB); var itsDoneZ: int64 := self.codeLen; self.cg_e8(0);  // jmp .itsdone
      // .itsnonzero: push neg_flag=0
      poke8(self.code + itsNZ, self.codeLen - itsNZ - 1);
      self.cg_e8(0x6A); self.cg_e8(0x00);  // push 0 (neg flag)
      // [rsp]=neg [rsp+8]=buf [rsp+16]=n
      // if n<0: neg rax; set [rsp]=1
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
      self.cg_e8(0x7D); var itsPos: int64 := self.codeLen; self.cg_e8(0);  // jge .itspos
      self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xD8);  // neg rax
      self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0x04); self.cg_e8(0x24);
      self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov [rsp], 1
      // .itspos: push rbx; mov rbx, 10
      poke8(self.code + itsPos, self.codeLen - itsPos - 1);
      self.cg_e8(0x53);  // push rbx
      // [rsp]=rbx [rsp+8]=neg [rsp+16]=buf [rsp+24]=n
      self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC3); self.cg_e8(0x0A); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov rbx, 10
      // digit loop
      var itsDigLoop: int64 := self.codeLen;
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
      self.cg_e8(0x74); var itsSign: int64 := self.codeLen; self.cg_e8(0);  // jz .itssign
      self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);  // xor rdx, rdx
      self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF3);  // div rbx
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC2); self.cg_e8(0x30);  // add rdx, 48
      self.cg_e8(0x88); self.cg_e8(0x16);  // mov [rsi], dl
      self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);  // dec rsi
      self.cg_e8(0xEB); self.cg_e8(itsDigLoop - self.codeLen - 1);  // jmp .itsdigloop
      // .itssign:
      poke8(self.code + itsSign, self.codeLen - itsSign - 1);
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x08); self.cg_e8(0x00);  // cmp [rsp+8], 0
      self.cg_e8(0x74); var itsNoNeg: int64 := self.codeLen; self.cg_e8(0);  // jz .itsnoneg
      self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x2D);  // mov byte [rsi], '-'
      self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);  // dec rsi
      poke8(self.code + itsNoNeg, self.codeLen - itsNoNeg - 1);
      // rax = rsi+1 (first written digit)
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x46); self.cg_e8(0x01);  // lea rax, [rsi+1]
      // restore rbx; add rsp, 32
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x1C); self.cg_e8(0x24);  // mov rbx, [rsp]
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x20);  // add rsp, 32
      // .itsdone:
      poke8(self.code + itsDoneZ, self.codeLen - itsDoneZ - 1);

    } else if (self.cg_seq(fname, fnlen, "FileSize", 8)) {
      // FileSize(path): rdi=path → rax=size or -1
      // open(path, O_RDONLY=0, 0) → fd
      self.cg_e8(0x31); self.cg_e8(0xF6);  // xor esi, esi (O_RDONLY)
      self.cg_e8(0x31); self.cg_e8(0xD2);  // xor edx, edx
      self.cg_e8(0xB8); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov eax, 2
      self.cg_e8(0x0F); self.cg_e8(0x05);  // syscall → rax=fd
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
      self.cg_e8(0x78); var fsErr: int64 := self.codeLen; self.cg_e8(0);  // js .fserr
      self.cg_e8(0x57);  // push rdi (save path — not needed but keep rdi)
      self.cg_e8(0x50);  // push rax (fd)
      // lseek(fd, 0, SEEK_END=2)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24);  // mov rdi, [rsp] = fd
      self.cg_e8(0x31); self.cg_e8(0xF6);  // xor esi, esi (offset=0)
      self.cg_e8(0xBA); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov edx, 2 (SEEK_END)
      self.cg_e8(0xB8); self.cg_e8(0x08); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov eax, 8
      self.cg_e8(0x0F); self.cg_e8(0x05);  // syscall → rax=size
      self.cg_e8(0x50);  // push rax (size)
      // close(fd)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rdi, [rsp+8] = fd
      self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov eax, 3
      self.cg_e8(0x0F); self.cg_e8(0x05);
      // pop size → rax; add rsp, 16 (size, fd, saved path)
      self.cg_e8(0x58);  // pop rax (size)
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);  // add rsp, 16
      self.cg_e8(0xEB); var fsDone: int64 := self.codeLen; self.cg_e8(0);  // jmp .fsdone
      poke8(self.code + fsErr, self.codeLen - fsErr - 1);
      self.cg_movRaxImm(-1);
      poke8(self.code + fsDone, self.codeLen - fsDone - 1);

    } else if (self.cg_seq(fname, fnlen, "FileReadAll", 11)) {
      // FileReadAll(path): rdi=path → rax=null-terminated buffer or null
      // open(path, O_RDONLY, 0) → fd
      self.cg_e8(0x31); self.cg_e8(0xF6);  // xor esi, esi
      self.cg_e8(0x31); self.cg_e8(0xD2);
      self.cg_e8(0xB8); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // → rax=fd
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
      // jns .fraOk (fd >= 0 → success path)  — short forward jump over error block (~9 bytes)
      self.cg_e8(0x79); var fraOk: int64 := self.codeLen; self.cg_e8(0);
      self.cg_zeroRax();                    // error: return null
      // near jmp .fraDone (E9 + 4-byte disp) — success path is >127 bytes
      self.cg_e8(0xE9); var fraDone: int64 := self.codeLen; poke32(self.code + fraDone, 0); self.codeLen := self.codeLen + 4;
      poke8(self.code + fraOk, self.codeLen - fraOk - 1);
      self.cg_e8(0x50);  // .fraOk: push rax (fd)
      // lseek(fd, 0, SEEK_END=2) → size
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24);  // mov rdi, [rsp] = fd
      self.cg_e8(0x31); self.cg_e8(0xF6);
      self.cg_e8(0xBA); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0xB8); self.cg_e8(0x08); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // → rax=size
      self.cg_e8(0x50);  // push rax (size)
      // [rsp]=size [rsp+8]=fd
      // lseek(fd, 0, SEEK_SET=0) to rewind
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rdi, [rsp+8] = fd
      self.cg_e8(0x31); self.cg_e8(0xF6);  // xor esi, esi
      self.cg_e8(0x31); self.cg_e8(0xD2);  // xor edx, edx (SEEK_SET)
      self.cg_e8(0xB8); self.cg_e8(0x08); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);
      // mmap(0, size+1, 3, 34, -1, 0) for anonymous buffer
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x00);  // mov rsi, [rsp] = size
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC6); self.cg_e8(0x01);  // add rsi, 1
      self.cg_e8(0x31); self.cg_e8(0xFF);
      self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);
      self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);
      self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // → rax=buf
      self.cg_e8(0x50);  // push rax (buf)
      // [rsp]=buf [rsp+8]=size [rsp+16]=fd
      // read(fd, buf, size)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x10);  // mov rdi, [rsp+16] = fd
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x00);  // mov rsi, [rsp] = buf
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rdx, [rsp+8] = size
      self.cg_movRaxImm(0);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // read
      // null-terminate: buf[size] = 0
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0x24);  // mov rax, [rsp] = buf
      self.cg_e8(0x48); self.cg_e8(0x03); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);  // add rax, [rsp+8] = size
      self.cg_e8(0xC6); self.cg_e8(0x00); self.cg_e8(0x00);  // mov byte [rax], 0
      // close(fd)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x10);  // mov rdi, [rsp+16] = fd
      self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);
      // return buf
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0x24);  // mov rax, [rsp] = buf
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x18);  // add rsp, 24
      poke32(self.code + fraDone, self.codeLen - fraDone - 4);  // patch near jmp .fraDone (rel32)

    } else if (self.cg_seq(fname, fnlen, "FileWriteAll", 12)) {
      // FileWriteAll(path, data, len): rdi=path, rsi=data, rdx=len → rax=bytes written
      // open(path, O_WRONLY|O_CREAT|O_TRUNC=577, 0644)
      self.cg_e8(0x52);  // push rdx (len)
      self.cg_e8(0x56);  // push rsi (data)
      self.cg_e8(0xBE); self.cg_e8(0x41); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00);  // mov esi, 577
      self.cg_e8(0xBA); self.cg_e8(0xA4); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00);  // mov edx, 0644 (420)
      self.cg_e8(0xB8); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // open → rax=fd
      self.cg_e8(0x50);  // push rax (fd)
      // [rsp]=fd [rsp+8]=data [rsp+16]=len
      // write(fd, data, len)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24);  // mov rdi, [rsp] = fd
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rsi, [rsp+8] = data
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x10);  // mov rdx, [rsp+16] = len
      self.cg_movRaxImm(1);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // write → rax=bytes_written
      self.cg_e8(0x50);  // push rax (bytes_written)
      // close(fd)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rdi, [rsp+8] = fd
      self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);
      // return bytes_written
      self.cg_e8(0x58);  // pop rax (bytes_written)
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x18);  // add rsp, 24 (fd, data, len)

    } else if (self.cg_findExternDecl(fname, fnlen) >= 0) {
      // FFI call: register this declared extern's GOT slot now (lazy — only
      // called externs get slots/relocations) and call indirectly through it.
      // The SysV ABI requires %rsp 16-byte aligned at the call, or libc/OpenSSL
      // crash on aligned SSE moves (movaps). Lyx's own calls don't need this,
      // so we align locally only for FFI: save rsp, align down, restore after.
      // Args are already in rdi/rsi/rdx/rcx/r8/r9; aligning rsp doesn't touch
      // them. disp32 is patched in cg_writeELFDynamic once the GOT VA is known.
      var exd: int64 := self.cg_findExternDecl(fname, fnlen);
      var edb: int64 := self.externDecls + exd * CG_EXTERN_SZ;
      var exIdx: int64 := self.cg_addExtern(peek64(edb) as pchar, peek64(edb + CG_EXTERN_OFF_NAMELEN),
                                            peek64(edb + CG_EXTERN_OFF_LIBPTR), peek64(edb + CG_EXTERN_OFF_LIBLEN));
      self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xE3);            // mov r11, rsp
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xE4); self.cg_e8(0xF0);  // and rsp, -16
      self.cg_e8(0x41); self.cg_e8(0x53);                              // push r11
      self.cg_e8(0x41); self.cg_e8(0x53);                              // push r11 (keep 16-align)
      self.cg_e8(0x31); self.cg_e8(0xC0);                              // xor eax, eax
      self.cg_e8(0xFF); self.cg_e8(0x15);                              // call *disp32(%rip)
      var ppx: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_addPatch(ppx, exIdx, 0, CG_PATCH_EXTERN);
      self.cg_e8(0x41); self.cg_e8(0x5B);                              // pop r11
      self.cg_e8(0x5C);                                                 // pop rsp (restore)

    } else {
      // User-defined function call: emit call + patch
      var pp: int64 := self.cg_emitCall();
      self.cg_addPatch(pp, fname as int64, fnlen, CG_PATCH_CALL);
    }
  }

  // ------------------------------------------------------------------
  // Statement code generation
  // ------------------------------------------------------------------

  fn cg_genStmt(ni: int64) {
    if (ni < 0) { return; }
    var k: int64 := self.cg_nkind(ni);

    if (k == CGN_BLOCK) {
      self.cg_genBlock(ni);

    } else if (k == CGN_VAR_DECL || k == CGN_CON_DECL) {
      var name: pchar := self.cg_nsval(ni);
      var nlen: int64 := self.cg_nslen(ni);
      var off: int64 := self.cg_addLocal(name, nlen);
      var localIdx: int64 := self.localCount - 1;
      // Track type for OOP local lookup (child0 = type node, NK_TYPE_NAME = 60)
      var typeNode: int64 := self.cg_nc0(ni);
      if (typeNode >= 0 && self.cg_nkind(typeNode) == 60) {
        self.cg_setLocalType(localIdx, self.cg_nsval(typeNode), self.cg_nslen(typeNode));
      }
      // Track array locals: NK_TYPE_ARRAY (=61) or NK_TYPE_NAME "Array<T>" (uppercase, =60)
      if (typeNode >= 0 && self.cg_nkind(typeNode) == 61) {
        poke8(self.localIsArray + localIdx, 1);
        // For T[] where T is a struct: store element type name in localTypes
        var elemNode: int64 := self.cg_nc0(typeNode);
        if (elemNode >= 0 && self.cg_nkind(elemNode) == 60) {
          var etn: pchar := self.cg_nsval(elemNode);
          var etl: int64 := self.cg_nslen(elemNode);
          if (self.cg_findClass(etn, etl) >= 0) {
            self.cg_setLocalType(localIdx, etn, etl);
          }
        }
      }
      if (typeNode >= 0 && self.cg_nkind(typeNode) == 60) {
        var tnArr: pchar := self.cg_nsval(typeNode);
        var tnLen: int64 := self.cg_nslen(typeNode);
        if (self.cg_seq(tnArr, tnLen, "Array", 5)) {
          poke8(self.localIsArray + localIdx, 1);
          // For Array<T> where T is a struct: store element type name in localTypes
          var elemNode2: int64 := self.cg_nc1(typeNode);
          if (elemNode2 >= 0 && self.cg_nkind(elemNode2) == 60) {
            var etn2: pchar := self.cg_nsval(elemNode2);
            var etl2: int64 := self.cg_nslen(elemNode2);
            if (self.cg_findClass(etn2, etl2) >= 0) {
              self.cg_setLocalType(localIdx, etn2, etl2);
            }
          }
        }
      }
      // WP-BC-51: NK_TYPE_ARRAY_FIXED (=101) — store compile-time size
      if (typeNode >= 0 && self.cg_nkind(typeNode) == 101) {
        poke8(self.localIsArray + localIdx, 1);
        var sizeNode: int64 := self.cg_nc1(typeNode);
        if (sizeNode >= 0 && self.cg_nkind(sizeNode) == CGN_LIT_INT) {
          poke64(self.localArraySize + localIdx * 8, self.cg_nival(sizeNode));
        }
      }
      var init: int64 := self.cg_nc1(ni);
      // WP-BC-51: count array literal elements for len() support
      if (init >= 0 && self.cg_nkind(init) == 100) {
        var acnt: int64 := 0;
        var ael: int64 := self.cg_nc0(init);
        while (ael != -1) { acnt := acnt + 1; ael := self.cg_nnext(ael); }
        poke8(self.localIsArray + localIdx, 1);
        poke64(self.localArraySize + localIdx * 8, acnt);
      }
      if (init >= 0) {
        self.cg_genExpr(init);
      } else {
        // Fixed-size array (int64[N]): heap-allocate N*8 bytes
        var fixedSz: int64 := peek64(self.localArraySize + localIdx * 8);
        if (typeNode >= 0 && self.cg_nkind(typeNode) == 101 && fixedSz > 0) {
          // mmap(0, fixedSz*8, PROT_RW, MAP_ANON, -1, 0)
          self.cg_zeroRax();    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7); // mov rdi,0
          self.cg_movRaxImm(fixedSz * 8); self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6); // mov rsi,sz
          self.cg_movRaxImm(3);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2); // mov rdx,3
          self.cg_movRaxImm(34);
          self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);  // mov r10, rax
          self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0);  // xor r8, r8
          self.cg_e8(0x49); self.cg_e8(0xFF); self.cg_e8(0xC8);  // dec r8 → r8=-1
          self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9, r9
          self.cg_movRaxImm(9);
          self.cg_e8(0x0F); self.cg_e8(0x05);
        } else {
        // WP-10d: auto-allocate struct locals (NK_TYPE_NAME=60, vmtDataOff==-1)
        var sdoStruct: int64 := 0;
        if (typeNode >= 0 && self.cg_nkind(typeNode) == 60) {
          var sdoIdx: int64 := self.cg_findClass(self.cg_nsval(typeNode), self.cg_nslen(typeNode));
          if (sdoIdx >= 0) {
            var sdoVmt: int64 := peek64(self.classLayouts + sdoIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTOFF);
            if (sdoVmt == -1) { sdoStruct := 1; }
          }
        }
        if (sdoStruct != 0) {
          // mmap(0, 4096, 3, 34, -1, 0) → rax = struct ptr
          self.cg_movRaxImm(0);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7); // mov rdi,rax
          self.cg_movRaxImm(4096); self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6); // mov rsi,rax
          self.cg_movRaxImm(3);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2); // mov rdx,rax
          self.cg_movRaxImm(34);
          self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);  // mov r10, rax
          self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0);  // xor r8, r8
          self.cg_e8(0x49); self.cg_e8(0xFF); self.cg_e8(0xC8);  // dec r8 → r8=-1
          self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9, r9
          self.cg_movRaxImm(9);
          self.cg_e8(0x0F); self.cg_e8(0x05);
        } else {
          self.cg_zeroRax();
        }
        }
      }
      // WP-3.1: @redundant vars need 3 slots; mark + write all copies
      var isRedundant: int64 := (self.cg_nival(ni) & 4) != 0;
      if (isRedundant != 0) {
        poke8(self.localIsRedundant + localIdx, 1);
        // Reserve 2 extra stack slots (B and C) without named entries
        self.frameSize := self.frameSize + 16;
        // Write value to all 3 copies (rax still holds init value or 0)
        self.cg_storeRax(off);
        self.cg_storeRax(off - 8);
        self.cg_storeRax(off - 16);
      } else {
        self.cg_storeRax(off);
      }

    } else if (k == CGN_ASSIGN) {
      var lhs: int64 := self.cg_nc0(ni);
      var rhs: int64 := self.cg_nc1(ni);
      if (self.cg_nkind(lhs) == CGN_IDENT) {
        self.cg_genExpr(rhs);
        var name: pchar := self.cg_nsval(lhs);
        var nlen: int64 := self.cg_nslen(lhs);
        var off: int64 := self.cg_findLocal(name, nlen);
        if (off != 0) {
          // WP-3.1: @redundant vars write all 3 copies
          var lidx: int64 := self.cg_findLocalIdx(name, nlen);
          if (lidx >= 0 && self.cg_isLocalRedundant(lidx) != 0) {
            self.cg_storeRax(off);
            self.cg_storeRax(off - 8);
            self.cg_storeRax(off - 16);
          } else {
            self.cg_storeRax(off);
          }
        } else {
          var goff: int64 := self.cg_findGlobal(name, nlen);
          if (goff >= 0) { self.cg_storeRaxGlobal(goff); }
        }
      } else if (self.cg_nkind(lhs) == CGN_FIELD) {
        // obj.field := rhs
        self.cg_genExpr(rhs);
        self.cg_pushRax();
        var obj: int64 := self.cg_nc0(lhs);
        var fieldName: pchar := self.cg_nsval(lhs);
        var fieldLen:  int64 := self.cg_nslen(lhs);
        self.cg_genExpr(obj);
        var classIdx: int64 := self.cg_objClassIdx(obj);
        var foff: int64 := -1;
        if (classIdx >= 0) { foff := self.cg_getFieldOffset(classIdx, fieldName, fieldLen); }
        self.cg_popRsi();
        // WP-4.1-B: emit BSWAP on rsi before storing @big_endian fields
        var beInfo2: int64 := 0;
        if (classIdx >= 0 && foff >= 0) {
          beInfo2 := self.cg_getFieldBigEndian(classIdx, fieldName, fieldLen);
          if ((beInfo2 & 1) != 0) {
            var tWidth3: int64 := (beInfo2 >> 8) & 0xFF;
            self.cg_emitBswapRsi(tWidth3);
          }
        }
        if (foff == 0) {
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x30);
        } else if (foff > 0 && foff <= 127) {
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x70); self.cg_e8(foff);
        } else if (foff > 127) {
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xB0); self.cg_e32(foff);
        }
      } else if (self.cg_nkind(lhs) == CGN_INDEX) {
        // arr[i] := rhs — three-way dispatch (same as CGN_INDEX read)
        self.cg_genExpr(rhs);              // rax = value
        self.cg_pushRax();
        self.cg_genExpr(self.cg_nc1(lhs)); // rax = index
        self.cg_pushRax();
        self.cg_genExpr(self.cg_nc0(lhs)); // rax = array ptr
        self.cg_popRbx();                  // rbx = index
        var lhsBase: int64 := self.cg_nc0(lhs);
        var lhsIsArray: int64 := 0;
        if (self.cg_nkind(lhsBase) == CGN_IDENT) {
          var llidx: int64 := self.cg_findLocalIdx(self.cg_nsval(lhsBase), self.cg_nslen(lhsBase));
          if (llidx >= 0 && peek8(self.localIsArray + llidx) != 0) { lhsIsArray := 1; }
        } else if (self.cg_nkind(lhsBase) == CGN_FIELD) {
          var lhsInner: int64 := self.cg_nc0(lhsBase);
          var lhsFldNm: pchar := self.cg_nsval(lhsBase);
          var lhsFldNl: int64 := self.cg_nslen(lhsBase);
          var lhsParentCi: int64 := self.cg_objClassIdx(lhsInner);
          if (self.cg_isFieldArray(lhsParentCi, lhsFldNm, lhsFldNl) != 0) { lhsIsArray := 1; }
        }
        if (lhsIsArray == 1) {
          // array<T> local: skip 16-byte header
          // lea rcx, [rax+16]
          self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x48); self.cg_e8(0x10);
          // pop rsi (value)
          self.cg_e8(0x5E);
          // mov [rcx+rbx*8], rsi
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x34); self.cg_e8(0xD9);
        } else {
          // plain ptr: direct 8-byte stride
          // pop rsi (value)
          self.cg_e8(0x5E);
          // mov [rax+rbx*8], rsi
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x34); self.cg_e8(0xD8);
        }
      }

    } else if (k == CGN_RETURN) {
      var expr: int64 := self.cg_nc0(ni);
      if (self.deferCount > 0) {
        // WP-AS-10: save return value around defer emission
        if (expr >= 0) {
          self.cg_genExpr(expr);
          self.cg_pushRax();
          self.cg_emitDefers();
          self.cg_popRax();
        } else {
          self.cg_emitDefers();
          self.cg_zeroRax();
        }
      } else {
        if (expr >= 0) {
          self.cg_genExpr(expr);
        } else {
          self.cg_zeroRax();
        }
      }
      self.cg_emitEpilogue();

    } else if (k == CGN_EXPR_STMT) {
      self.cg_genExpr(self.cg_nc0(ni));

    } else if (k == CGN_IF) {
      self.cg_genIf(ni);

    } else if (k == CGN_WHILE) {
      self.cg_genWhile(ni);

    } else if (k == CGN_REPEAT_UNTIL) {
      self.cg_genRepeatUntil(ni);

    } else if (k == CGN_TUPLE_VAR_DECL) {
      self.cg_genTupleVarDecl(ni);

    } else if (k == CGN_FOR) {
      self.cg_genFor(ni);

    } else if (k == CGN_FOR_C) {
      self.cg_genForC(ni);

    } else if (k == CGN_SWITCH) {
      self.cg_genSwitch(ni);

    // WP-15: Pattern matching - generate like switch
    } else if (k == CGN_MATCH) {
      self.cg_genMatch(ni);

    } else if (k == CGN_DISPOSE) {
      // dispose obj: call munmap? Skip for bootstrap.
      // Just evaluate the expression (no-op effect on expr result)
      self.cg_genExpr(self.cg_nc0(ni));

    // WP-12: Exception handling — setjmp/longjmp based
    } else if (k == CGN_TRY) {
      // jmp_buf layout on stack (80 bytes):
      //   [rsp+0..39]: callee-saved regs (rbx,rbp,r12,r13,r14,r15)
      //   [rsp+48]: saved rsp (= jmp_buf base, since mov rax,rsp before sub)
      //   [rsp+56]: catch_label ip
      //   [rsp+64]: old _lyx_exn_ptr

      // sub rsp, 80
      self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC);
      self.cg_e8(0x50); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      // Save callee-saved registers
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x1C); self.cg_e8(0x24); // mov [rsp], rbx
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x6C); self.cg_e8(0x24); self.cg_e8(0x08); // mov [rsp+8], rbp
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x64); self.cg_e8(0x24); self.cg_e8(0x10); // mov [rsp+16], r12
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x6C); self.cg_e8(0x24); self.cg_e8(0x18); // mov [rsp+24], r13
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x20); // mov [rsp+32], r14
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x28); // mov [rsp+40], r15
      // Save rsp value to [rsp+48] (= current rsp = jmp_buf base; longjmp restores rsp←rax)
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE0);                     // mov rax, rsp
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x30); // mov [rsp+48], rax
      // Save catch_label address to [rsp+56] via forward-patched LEA
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);  // lea rax, [rip+disp32]
      var catchLblPatch: int64 := self.codeLen;
      self.cg_e32(0);                                           // patched after catch label is known
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x38); // mov [rsp+56], rax
      // Save old handler from _lyx_exn_ptr to [rsp+64]
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);   // mov rax, [rcx]
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x40); // mov [rsp+64], rax
      // Install new handler: _lyx_exn_ptr ← rsp
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE0);   // mov rax, rsp
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x01);   // mov [rcx], rax
      // Generate try body
      self.cg_genBlock(self.cg_nc0(ni));
      // Try success: restore old handler
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x40); // mov rax, [rsp+64]
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x01);   // mov [rcx], rax
      // Generate finally block on success path (if present)
      var finallyNi: int64 := self.cg_nc2(ni);
      if (finallyNi >= 0) { self.cg_genBlock(finallyNi); }
      // Jump past catch to try_done
      self.cg_e8(0xE9);
      var tryDonePatch: int64 := self.codeLen;
      self.cg_e32(0);
      // === catch_label ===
      var catchOff: int64 := self.codeLen;
      poke32(self.code + catchLblPatch, catchOff - catchLblPatch - 4);
      // longjmp has restored registers and rsp = jmp_buf base
      // Restore old handler
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x40); // mov rax, [rsp+64]
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x01);   // mov [rcx], rax
      // Load exception value for catch binding
      self.cg_emitLeaRcxData(CG_EXN_VAL);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);   // mov rax, [rcx]
      // Generate catch clauses (c1 = first catch, nnext-linked)
      var catchNi: int64 := self.cg_nc1(ni);
      while (catchNi >= 0) {
        self.cg_genBlock(self.cg_nc0(catchNi));  // catch body
        catchNi := self.cg_nnext(catchNi);
      }
      // Generate finally block on catch path
      if (finallyNi >= 0) { self.cg_genBlock(finallyNi); }
      // === try_done ===
      poke32(self.code + tryDonePatch, self.codeLen - tryDonePatch - 4);
      // add rsp, 80  — restore stack frame
      self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xC4);
      self.cg_e8(0x50); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);

    } else if (k == CGN_CATCH || k == CGN_FINALLY) {
      // Standalone catch/finally outside try — just generate body
      self.cg_genBlock(self.cg_nc0(ni));

    } else if (k == CGN_THROW) {
      // WP-12: throw expr — store exception value, longjmp or exit(1)
      self.cg_genExpr(self.cg_nc0(ni));               // rax = exception value
      self.cg_emitLeaRcxData(CG_EXN_VAL);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x01);   // mov [rcx], rax
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);   // mov rax, [rcx]
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
      self.cg_e8(0x0F); self.cg_e8(0x84);
      var throwNH: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_genLongjmp();
      poke32(self.code + throwNH, self.codeLen - throwNH - 4);
      // no handler: sys_exit(1)
      self.cg_movRaxImm(1);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);   // mov rdi, rax
      self.cg_movRaxImm(60);
      self.cg_e8(0x0F); self.cg_e8(0x05);                      // syscall (sys_exit)

    } else if (k == CGN_ASSERT) {
      // WP-BC-07: assert(cond) — write "assertion failed\n" to stderr + exit(1) if cond == 0
      var condNode: int64 := self.cg_nc0(ni);
      if (condNode >= 0) {
        self.cg_genExpr(condNode);  // result in rax
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x75);                                         // jnz short (skip panic)
        var pSkip: int64 := self.codeLen;
        self.cg_e8(0);                                            // placeholder
        // Inline panic: lea rsi, [rip+msgOff]; mov edx, 17; mov edi, 2; mov eax, 1; syscall; exit(1)
        var msgOff: int64 := self.dataLen;
        self.cg_edata(97);  self.cg_edata(115); self.cg_edata(115); // ass
        self.cg_edata(101); self.cg_edata(114); self.cg_edata(116); // ert
        self.cg_edata(105); self.cg_edata(111); self.cg_edata(110); // ion
        self.cg_edata(32);  self.cg_edata(102); self.cg_edata(97);  //  fa
        self.cg_edata(105); self.cg_edata(108); self.cg_edata(101); // ile
        self.cg_edata(100); self.cg_edata(10);  self.cg_edata(0);   // d\n\0 (17 chars + NUL)
        // lea rsi, [rip+disp32]  (48 8D 35 disp32)
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
        var pData: int64 := self.codeLen;
        self.cg_e32(0);
        self.cg_addPatch(pData, msgOff, 0, CG_PATCH_STR);       // resolve RIP-relative offset
        self.cg_e8(0xBA); self.cg_e8(17);  self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);  // mov edx, 17
        self.cg_e8(0xBF); self.cg_e8(2);   self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);  // mov edi, 2 (stderr)
        self.cg_e8(0xB8); self.cg_e8(1);   self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);  // mov eax, 1 (sys_write)
        self.cg_e8(0x0F); self.cg_e8(0x05);                                                // syscall
        self.cg_e8(0xBF); self.cg_e8(1);   self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);  // mov edi, 1 (exit code)
        self.cg_movRaxImm(60);                                                              // mov rax, 60 (sys_exit)
        self.cg_e8(0x0F); self.cg_e8(0x05);                                                // syscall
        poke8(self.code + pSkip, self.codeLen - pSkip - 1);  // patch jnz offset
      }

    // WP-BC-10: panic(msg) — evaluate msg → rdi, emit inline panic body
    } else if (k == CGN_PANIC) {
      var msgNode: int64 := self.cg_nc0(ni);
      if (msgNode >= 0) {
        self.cg_genExpr(msgNode);                                   // msg → rax
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);     // mov rdi, rax
        self.cg_emitPanicBody();
      }

    // WP-BC-09: pool { stmt* } — in bootstrap, pool is a no-op; just emit the body
    } else if (k == CGN_POOL) {
      var bodyNode: int64 := self.cg_nc0(ni);
      if (bodyNode >= 0) { self.cg_genStmt(bodyNode); }

    } else if (k == CGN_BREAK) {
      // jmp rel32 to loop exit; placeholder stores previous break-list head
      self.cg_e8(0xE9);
      var bp: int64 := self.codeLen;
      self.cg_e32(self.curBreakHead);  // link to previous
      self.curBreakHead := bp;

    } else if (k == CGN_CONTINUE) {
      // jmp rel32 to loop continue; placeholder stores previous continue-list head
      self.cg_e8(0xE9);
      var cp: int64 := self.codeLen;
      self.cg_e32(self.curContHead);  // link to previous
      self.curContHead := cp;

    } else if (k == CGN_CASE) {
      // Switch case body — generate body expression/block
      // c0 = case value (or null for default), c1 = body
      var bodyNode: int64 := self.cg_nc1(ni);
      if (bodyNode >= 0) {
        self.cg_genBlock(bodyNode);
      }

    } else if (k == CGN_MATCH_CASE) {
      // Match case body — generate body expression
      // c0 = pattern, c1 = body expression
      var bodyNode: int64 := self.cg_nc1(ni);
      if (bodyNode >= 0) {
        self.cg_genExpr(bodyNode);
      }

    } else if (k == CGN_FIELD_DECL) {
      // Field declaration in struct/class — no code generation needed
      // Layout is handled by cg_buildStructLayout/cg_buildClassLayout
      // Just skip (fields are processed during layout building)

    } else if (k == CGN_PARAM) {
      // Parameter declaration — already handled during function prologue generation
      // In IR-lowering context: register parameter as local variable
      var pname: pchar := self.cg_nsval(ni);
      var plen: int64 := self.cg_nslen(ni);
      var poff: int64 := self.cg_addLocal(pname, plen);
      // Track type if present (c0 = type node)
      var ptypeNode: int64 := self.cg_nc0(ni);
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == 60) {
        self.cg_setLocalType(self.localCount - 1, self.cg_nsval(ptypeNode), self.cg_nslen(ptypeNode));
      }

    } else if (k == CGN_AT_DIRECTIVE) {  // WP-CS-07 / WP-AS-04/05
      var kind: int64 := self.cg_nival(ni);
      var val:  int64 := self.cg_nc0(ni);
      if (kind == 0) { self.ioCheckEnabled       := val; }
      if (kind == 1) { self.overflowCheckEnabled := val; }
      if (kind == 2) { self.boundsCheckEnabled   := val; }  // WP-AS-04
      if (kind == 3) { self.debugMode            := val; }  // WP-AS-05: @debug_info aliases debugMode
      if (kind == 4) { self.optLevel             := val; }  // WP-AS-04

    } else if (k == CGN_AT_ENERGY) {  // WP-EN-04: @energy(N); statement override
      self.fnEnergyLevel := self.cg_nival(ni);

    } else if (k == CGN_DEFER) {
      // WP-AS-10/19: defer nodes are collected in cg_collectDefers pre-pass;
      // do not emit inline — they will be emitted at function exit points.

    } else {
      // Other statement kinds: skip
    }
  }

  // WP-AS-10: first pass — collect NK_DEFER c0 nodes into deferBuf (LIFO append).
  // Does NOT recurse into nested function declarations.
  fn cg_collectDefers(ni: int64) {
    if (ni < 0) { return; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_DEFER) {
      if (self.deferCount < self.deferCap) {
        poke64(self.deferBuf + self.deferCount * 8, self.cg_nc0(ni));
        self.deferCount := self.deferCount + 1;
      }
      return;
    }
    if (k == CGN_BLOCK) {
      var s: int64 := self.cg_nc0(ni);
      while (s >= 0) { self.cg_collectDefers(s); s := self.cg_nnext(s); }
      return;
    }
    if (k == CGN_IF) {
      self.cg_collectDefers(self.cg_nc1(ni));
      self.cg_collectDefers(self.cg_nc2(ni));
      return;
    }
    if (k == CGN_WHILE || k == CGN_REPEAT_UNTIL) {
      self.cg_collectDefers(self.cg_nc1(ni));
      return;
    }
    if (k == CGN_FOR) {
      self.cg_collectDefers(self.cg_nc2(ni));
      return;
    }
    if (k == CGN_FOR_C) {
      self.cg_collectDefers(self.cg_nc3(ni));
      return;
    }
    // CGN_FUNC_DECL and all expression-only nodes: stop traversal
  }

  // WP-AS-10: emit deferred statements in LIFO order (last defer first).
  fn cg_emitDefers() {
    var i: int64 := self.deferCount - 1;
    while (i >= 0) {
      self.cg_genStmt(peek64(self.deferBuf + i * 8));
      i := i - 1;
    }
  }

  fn cg_genBlock(ni: int64) {
    if (ni < 0) { return; }
    var savedLocals: int64 := self.localCount;
    var stmt: int64 := self.cg_nc0(ni);
    while (stmt != -1) {
      var sk: int64 := self.cg_nkind(stmt);
      // WP-13: Nested function declaration inside a block - generate as closure
      if (sk == CGN_FUNC_DECL) {
        // Check if this is a nested function (has outer function context)
        // For now, generate nested functions with static link support
        self.cg_genNestedFunc(stmt);
      } else {
        self.cg_genStmt(stmt);
      }
      stmt := self.cg_nnext(stmt);
    }
    // Restore local scope (pop locals declared in this block)
    self.localCount := savedLocals;
  }

  // WP-13: Generate nested function with static link support
  fn cg_genNestedFunc(ni: int64) {
    // Register label for nested function (mangled with parent context)
    var fname: pchar := self.cg_nsval(ni);
    var fnlen: int64 := self.cg_nslen(ni);

    // Generate unique nested function name with parent suffix
    var nestedLabel: int64 := self._allocNestedLabel(fname, fnlen);
    self.cg_addLabel(nestedLabel, 16, self.cg_lineOf(ni));

    // Reset locals but preserve outer function's captured variables
    self.localCount := 0;
    self.frameSize := 0;

    // Check if we have a static link from parent (passed via [rbp+16])
    var hasStaticLink: int64 := 0;
    if (self.staticLinkOffset >= 0) {
      hasStaticLink := 1;
      // Save static link to local slot for captured variable access
      var slOff: int64 := self.cg_addLocal("__static_link__", 15);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x45); self.cg_e8(0x10); // mov rax, [rbp+16]
      self.cg_storeRax(slOff);  // store to local slot
    }

    // Emit prologue with extra space for static link parameter
    var prologuePatch: int64 := self.cg_emitPrologueNested();

    // Spill parameters (child0 = first param, linked via next)
    var param: int64 := self.cg_nc0(ni);
    var paramIdx: int64 := 0;
    while (param != -1 && paramIdx < 6) {
      var pname: pchar := self.cg_nsval(param);
      var pnlen: int64 := self.cg_nslen(param);
      var off: int64 := self.cg_addLocal(pname, pnlen);
      if (paramIdx == 0) { self.cg_spillRdi(off); }
      else if (paramIdx == 1) { self.cg_spillRsi(off); }
      else if (paramIdx == 2) { self.cg_spillRdx(off); }
      else if (paramIdx == 3) { self.cg_spillRcx(off); }
      else if (paramIdx == 4) { self.cg_spillR8(off); }
      else if (paramIdx == 5) { self.cg_spillR9(off); }
      paramIdx := paramIdx + 1;
      param := self.cg_nnext(param);
    }

    // BUG-04: Capture analysis — scan body for identifiers not in local scope
    // These must be captured from the outer function's frame
    var body: int64 := self.cg_nc2(ni);
    self._analyzeCaptured(body);

    // Generate function body (child2 = block)
    var savedStaticLink: int64 := self.staticLinkOffset;
    var savedOuterName: pchar := self.outerFuncName;
    var savedOuterLen: int64 := self.outerFuncNameLen;

    // Set up static link context for this nested function
    self.staticLinkOffset := 16;  // rbp+16 = static link param position
    // Capture current function name as outer function

    body := self.cg_nc2(ni);
    self.cg_genBlock(body);

    // Restore outer function context
    self.staticLinkOffset := savedStaticLink;
    self.outerFuncName := savedOuterName;
    self.outerFuncNameLen := savedOuterLen;

    // Implicit return
    self.cg_zeroRax();
    self.cg_emitEpilogue();

    // Patch sub rsp with aligned frame size
    var fs: int64 := self.frameSize + 15;
    var aligned: int64 := fs - (fs & 15);
    if (aligned == 0) { aligned := 16; }
    poke32(self.code + prologuePatch, aligned);
  }

  // BUG-04: Recursively scan AST for identifiers not in local scope
  // and register them as captured variables from the outer function.
  // Must be called AFTER parameter locals are registered but BEFORE codegen.
  fn _analyzeCaptured(ni: int64) {
    if (ni < 0) { return; }
    var k: int64 := self.cg_nkind(ni);

    if (k == CGN_IDENT) {
      var name: pchar := self.cg_nsval(ni);
      var nlen: int64 := self.cg_nslen(ni);
      // Skip built-in identifiers and constants
      if (self.cg_findLocal(name, nlen) == 0 &&
          self.cg_findCon(name, nlen) == 0) {
        // Not local and not constant — check if already captured
        if (self.cg_findCapturedVar(name, nlen) == 0) {
          // Register as captured; offset resolved at runtime via static link
          self.cg_addCapturedVar(name, nlen, 0);
        }
      }
    }

    // Recurse into children (expressions and sub-statements)
    // Do NOT follow nnext here — statement lists are handled separately
    var c0: int64 := self.cg_nc0(ni);
    if (c0 >= 0) { self._analyzeCaptured(c0); }
    var c1: int64 := self.cg_nc1(ni);
    if (c1 >= 0) { self._analyzeCaptured(c1); }
    var c2: int64 := self.cg_nc2(ni);
    if (c2 >= 0) { self._analyzeCaptured(c2); }
  }

  // Walk a statement list (linked via nnext) and analyze each statement
  fn _analyzeCapturedStmtList(ni: int64) {
    var cur: int64 := ni;
    while (cur >= 0) {
      self._analyzeCaptured(cur);
      cur := self.cg_nnext(cur);
    }
  }

  // WP-13: Generate nested function prologue (accepts static link in rbp+16)
  fn cg_emitPrologueNested(): int64 {
    self.cg_e8(0x55);                          // push rbp
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE5);  // mov rbp, rsp
    // sub rsp, imm32 (48 81 EC xx xx xx xx)
    self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC);
    var patchPos: int64 := self.codeLen;
    self.cg_e32(0);
    // Static link is already in [rbp+16] from caller
    return patchPos;
  }

  // WP-13: Allocate nested function label (simple numbered suffix)
  fn _allocNestedLabel(baseName: pchar, baseLen: int64): pchar {
    // For simplicity, return a fixed label format "_NESTED_0", etc.
    // In full implementation, would dynamically allocate string
    // Just return placeholder - actual label registration handles it
    return "__nested__";
  }

  fn cg_genIf(ni: int64) {
    // WP-10g: dead-branch elimination — if condition is a compile-time constant
    var condNi: int64 := self.cg_nc0(ni);
    if (self.cg_tryFold(condNi) != 0) {
      if (self.foldBuf != 0) {
        self.cg_genBlock(self.cg_nc1(ni));   // condition always true → emit then only
      } else {
        var elseDead: int64 := self.cg_nc2(ni);
        if (elseDead >= 0) {
          if (self.cg_nkind(elseDead) == CGN_BLOCK) {
            self.cg_genBlock(elseDead);
          } else {
            self.cg_genStmt(elseDead);
          }
        }
      }
      return;
    }
    // Evaluate condition
    self.cg_genExpr(condNi);
    // test rax, rax; jz else_label
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
    // jz rel32 (forward)
    self.cg_e8(0x0F); self.cg_e8(0x84);
    var jzPos: int64 := self.codeLen;
    self.cg_e32(0);  // placeholder

    // Then branch
    self.cg_genBlock(self.cg_nc1(ni));

    var elseNode: int64 := self.cg_nc2(ni);
    if (elseNode >= 0) {
      // jmp over else
      self.cg_e8(0xE9);
      var jmpPos: int64 := self.codeLen;
      self.cg_e32(0);
      // Patch jz to here (else start)
      poke32(self.code + jzPos, self.codeLen - jzPos - 4);
      // Else branch
      if (self.cg_nkind(elseNode) == CGN_BLOCK) {
        self.cg_genBlock(elseNode);
      } else {
        self.cg_genStmt(elseNode);
      }
      // Patch jmp to here (end)
      poke32(self.code + jmpPos, self.codeLen - jmpPos - 4);
    } else {
      // Patch jz to here (end, no else)
      poke32(self.code + jzPos, self.codeLen - jzPos - 4);
    }
  }

  // WP-EN-05: copy-unrolling with U copies (U = cg_unrollFactor()).
  // Each copy: eval cond → jz exit, body.
  // Continue in copy K (K<U-1) → start of copy K+1's condition.
  // Continue in last copy → loopTop.
  // All breaks → exit.
  fn cg_genWhile(ni: int64) {
    var U:              int64 := self.cg_unrollFactor();
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead:  int64 := self.curContHead;
    var allBreakHead:   int64 := -1;
    var jzHead:         int64 := -1;
    var prevContHead:   int64 := -1;
    var loopTop:        int64 := self.codeLen;

    var copy: int64 := 0;
    while (copy < U) {
      // Patch previous copy's continue list to here (start of this copy's condition)
      if (prevContHead != -1) { self.cg_patchList(prevContHead, self.codeLen); }
      // Condition
      self.cg_genExpr(self.cg_nc0(ni));
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
      self.cg_e8(0x0F); self.cg_e8(0x84);                     // jz rel32
      self.cg_e32(jzHead);
      jzHead := self.codeLen - 4;
      // Body
      self.curBreakHead := -1;
      self.curContHead  := -1;
      self.cg_genBlock(self.cg_nc1(ni));
      // Accumulate break list; save this copy's continue list for later
      allBreakHead := self.cg_mergeBreakList(allBreakHead, self.curBreakHead);
      prevContHead := self.curContHead;
      copy := copy + 1;
    }
    // Last copy's continue list → loopTop
    if (prevContHead != -1) { self.cg_patchList(prevContHead, loopTop); }
    // jmp loopTop
    self.cg_e8(0xE9);
    self.cg_e32(loopTop - self.codeLen - 4);
    // .exit: patch all condition exits and break jumps
    var exitPos: int64 := self.codeLen;
    self.cg_patchList(jzHead, exitPos);
    self.cg_patchList(allBreakHead, exitPos);
    // Restore outer loop's break/continue lists
    self.curBreakHead := savedBreakHead;
    self.curContHead  := savedContHead;
  }

  // WP-BC-04: repeat { body } until (cond)
  // body executes first; loop back while cond == 0 (false)
  fn cg_genRepeatUntil(ni: int64) {
    var loopTop: int64 := self.codeLen;
    // Save outer break/continue lists
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead:  int64 := self.curContHead;
    self.curBreakHead := -1;
    self.curContHead  := -1;
    // Body
    self.cg_genBlock(self.cg_nc0(ni));
    // contPos: patch all continue jumps to here (before condition eval)
    var contPos: int64 := self.codeLen;
    var ch: int64 := self.curContHead;
    while (ch != -1) {
      var b0: int64 := peek8(self.code + ch) as int64;
      var b1: int64 := peek8(self.code + ch + 1) as int64;
      var b2: int64 := peek8(self.code + ch + 2) as int64;
      var b3: int64 := peek8(self.code + ch + 3) as int64;
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + ch, contPos - ch - 4);
      ch := nextLink;
    }
    // Condition → rax
    self.cg_genExpr(self.cg_nc1(ni));
    // test rax, rax; jz loopTop  (if cond false → loop back)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
    self.cg_e8(0x0F); self.cg_e8(0x84);                     // jz rel32
    self.cg_e32(loopTop - self.codeLen - 4);
    // exitPos: patch all break jumps here
    var bh: int64 := self.curBreakHead;
    while (bh != -1) {
      var b0: int64 := peek8(self.code + bh) as int64;
      var b1: int64 := peek8(self.code + bh + 1) as int64;
      var b2: int64 := peek8(self.code + bh + 2) as int64;
      var b3: int64 := peek8(self.code + bh + 3) as int64;
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + bh, self.codeLen - bh - 4);
      bh := nextLink;
    }
    // Restore outer loop lists
    self.curBreakHead := savedBreakHead;
    self.curContHead  := savedContHead;
  }

  // WP-BC-05: var a, b := fn()  — 2-value tuple destructure
  // SysV ABI: first return in rax, second in rdx.
  fn cg_genTupleVarDecl(ni: int64) {
    var name1: pchar := self.cg_nsval(ni);
    var len1:  int64 := self.cg_nslen(ni);
    var off1:  int64 := self.cg_addLocal(name1, len1);

    var secondNode: int64 := self.cg_nc0(ni);
    var name2: pchar := self.cg_nsval(secondNode);
    var len2:  int64 := self.cg_nslen(secondNode);
    var off2:  int64 := self.cg_addLocal(name2, len2);

    // Evaluate init (function call) → rax = first, rdx = second
    self.cg_genExpr(self.cg_nc1(ni));

    self.cg_storeRax(off1);
    self.cg_storeRdx(off2);
  }

  // WP-EN-05: copy-unrolling for range-based for.
  // Each copy: cond → jz exit, body, step (continue lands before step).
  fn cg_genFor(ni: int64) {
    var name: pchar := self.cg_nsval(ni);
    var nlen: int64 := self.cg_nslen(ni);
    var dir:  int64 := self.cg_nival(ni);  // 0=to, 1=downto
    var off:  int64 := self.cg_addLocal(name, nlen);
    // Init: v = start
    self.cg_genExpr(self.cg_nc0(ni));
    self.cg_storeRax(off);

    var U:              int64 := self.cg_unrollFactor();
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead:  int64 := self.curContHead;
    var allBreakHead:   int64 := -1;
    var jzHead:         int64 := -1;
    var loopTop:        int64 := self.codeLen;

    var copy: int64 := 0;
    while (copy < U) {
      // Condition: v <= limit (to) or v >= limit (downto)
      self.cg_loadRax(off);
      self.cg_pushRax();
      self.cg_genExpr(self.cg_nc1(ni));
      self.cg_popRbx();  // rbx=v, rax=limit
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);  // cmp rbx, rax
      self.cg_e8(0x0F);
      if (dir == 0) { self.cg_e8(0x8F); }  // jg exit (v > limit)
      else          { self.cg_e8(0x8C); }  // jl exit (v < limit, downto)
      self.cg_e32(jzHead);
      jzHead := self.codeLen - 4;
      // Body
      self.curBreakHead := -1;
      self.curContHead  := -1;
      self.cg_genBlock(self.cg_nc2(ni));
      // contPos: continue lands here, before step
      self.cg_patchList(self.curContHead, self.codeLen);
      allBreakHead := self.cg_mergeBreakList(allBreakHead, self.curBreakHead);
      // Step: v++ or v--
      self.cg_loadRax(off);
      if (dir == 0) { self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC0); }  // inc rax
      else          { self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC8); }  // dec rax
      self.cg_storeRax(off);
      copy := copy + 1;
    }
    // jmp loopTop
    self.cg_e8(0xE9);
    self.cg_e32(loopTop - self.codeLen - 4);
    // .exit
    var exitPos: int64 := self.codeLen;
    self.cg_patchList(jzHead, exitPos);
    self.cg_patchList(allBreakHead, exitPos);
    self.curBreakHead := savedBreakHead;
    self.curContHead  := savedContHead;
  }

  // ------------------------------------------------------------------
  // C-style for loop code generation
  // NK_FOR_C: c0=NK_VAR_DECL(init), c1=cond, c2=step, c3=body
  // ------------------------------------------------------------------
  // WP-EN-05: copy-unrolling for C-style for (init; cond; step) { body }.
  // Each copy: cond → jz exit, body, step (continue lands before step).
  fn cg_genForC(ni: int64) {
    // Init: declare and initialize the loop variable
    var initNi: int64 := self.cg_nc0(ni);
    if (initNi >= 0) {
      var name: pchar := self.cg_nsval(initNi);
      var nlen: int64 := self.cg_nslen(initNi);
      var off:  int64 := self.cg_addLocal(name, nlen);
      var initExpr: int64 := self.cg_nc1(initNi);
      if (initExpr >= 0) {
        self.cg_genExpr(initExpr);
        self.cg_storeRax(off);
      }
    }

    var U:              int64 := self.cg_unrollFactor();
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead:  int64 := self.curContHead;
    var allBreakHead:   int64 := -1;
    var jzHead:         int64 := -1;
    var condNi:         int64 := self.cg_nc1(ni);
    var stepNi:         int64 := self.cg_nc2(ni);
    var bodyNi:         int64 := self.cg_nc3(ni);
    var loopTop:        int64 := self.codeLen;

    var copy: int64 := 0;
    while (copy < U) {
      // Condition (optional — absent means infinite loop)
      if (condNi >= 0) {
        self.cg_genExpr(condNi);
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x0F); self.cg_e8(0x84);                     // jz rel32
        self.cg_e32(jzHead);
        jzHead := self.codeLen - 4;
      }
      // Body
      self.curBreakHead := -1;
      self.curContHead  := -1;
      if (bodyNi >= 0) { self.cg_genBlock(bodyNi); }
      // contPos: continue lands here, before step
      self.cg_patchList(self.curContHead, self.codeLen);
      allBreakHead := self.cg_mergeBreakList(allBreakHead, self.curBreakHead);
      // Step
      if (stepNi >= 0) { self.cg_genStmt(stepNi); }
      copy := copy + 1;
    }
    // jmp loopTop
    self.cg_e8(0xE9);
    self.cg_e32(loopTop - self.codeLen - 4);
    // .exit
    var exitPos: int64 := self.codeLen;
    self.cg_patchList(jzHead, exitPos);
    self.cg_patchList(allBreakHead, exitPos);
    self.curBreakHead := savedBreakHead;
    self.curContHead  := savedContHead;
  }

  // ------------------------------------------------------------------
  // Switch/case code generation (WP-10c)
  // ------------------------------------------------------------------
  // AST: NK_SWITCH { nc0=subject, nc1=first_case }
  //      NK_CASE  { ival=0/1, nc0=value(if !default), nc1=body_block }
  // Strategy: linear if-else chain; default case runs last.
  // Implicit jmp after each case body uses the curBreakHead linked list,
  // so explicit break statements and implicit end-of-case jumps are both
  // patched to the switch_end at once.
  // ------------------------------------------------------------------

  fn cg_genSwitch(ni: int64) {
    // Allocate a temp local to hold the subject value
    var swVar: pchar := "__sw__";
    var swOff: int64 := self.cg_addLocal(swVar, 6);
    self.cg_genExpr(self.cg_nc0(ni));
    self.cg_storeRax(swOff);

    // Save and reset break list (shared between explicit break and implicit case exit)
    var savedBreakHead: int64 := self.curBreakHead;
    self.curBreakHead := -1;

    var defaultCaseNode: int64 := -1;
    var caseCur: int64 := self.cg_nc1(ni);
    while (caseCur != -1) {
      var isDefault: int64 := self.cg_nival(caseCur);
      if (isDefault != 0) {
        defaultCaseNode := caseCur;
      } else {
        // subject → rbx, case value → rax
        self.cg_loadRax(swOff);
        self.cg_pushRax();
        self.cg_genExpr(self.cg_nc0(caseCur));
        self.cg_popRbx();
        // cmp rbx, rax; jne skip_case (rel32)
        self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
        self.cg_e8(0x0F); self.cg_e8(0x85);
        var jnePos: int64 := self.codeLen;
        self.cg_e32(0);
        // Execute case body
        self.cg_genBlock(self.cg_nc1(caseCur));
        // Implicit jmp to switch_end (linked into break list)
        self.cg_e8(0xE9);
        var bp: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bp;
        // Patch jne to next case
        poke32(self.code + jnePos, self.codeLen - jnePos - 4);
      }
      caseCur := self.cg_nnext(caseCur);
    }

    // Default case executes last if no other case matched
    if (defaultCaseNode != -1) {
      self.cg_genBlock(self.cg_nc1(defaultCaseNode));
      // Implicit jmp to switch_end
      self.cg_e8(0xE9);
      var bpd: int64 := self.codeLen;
      self.cg_e32(self.curBreakHead);
      self.curBreakHead := bpd;
    }

    // switch_end: patch all break/implicit-break jmps here
    var bh: int64 := self.curBreakHead;
    while (bh != -1) {
      var b0: int64 := peek8(self.code + bh);
      var b1: int64 := peek8(self.code + bh + 1);
      var b2: int64 := peek8(self.code + bh + 2);
      var b3: int64 := peek8(self.code + bh + 3);
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + bh, self.codeLen - bh - 4);
      bh := nextLink;
    }
    self.curBreakHead := savedBreakHead;
  }

  // WP-15: Generate match statement (like switch but for pattern matching)
  // WP-BC-11: emit comparison for one or-pattern alternative; link je-body into self.orBodyHead
  fn cg_emitOrAlt(matchOff: int64, altPat: int64) {
    if (self.cg_nkind(altPat) == CGN_PATTERN_OR) {
      self.cg_emitOrAlt(matchOff, self.cg_nc0(altPat));
      self.cg_emitOrAlt(matchOff, self.cg_nc1(altPat));
    } else {
      self.cg_loadRax(matchOff);
      self.cg_pushRax();
      var patVal: int64 := self.cg_nival(altPat);
      if (patVal != 0) {
        self.cg_movRaxImm(patVal);
      } else {
        var pn: pchar := self.cg_nsval(altPat);
        var pl: int64  := self.cg_nslen(altPat);
        var po: int64  := self.cg_findLocal(pn, pl);
        if (po != 0) { self.cg_loadRax(po); } else { self.cg_zeroRax(); }
      }
      self.cg_popRbx();
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);   // cmp rbx, rax
      self.cg_e8(0x0F); self.cg_e8(0x84);                       // je rel32
      var jePos: int64 := self.codeLen;
      self.cg_e32(self.orBodyHead);
      self.orBodyHead := jePos;
    }
  }

  fn cg_genMatch(ni: int64) {
    // c0 = discriminant expression, c1 = cases (next-linked)
    // Allocate a temp local to hold the subject value
    var matchVar: pchar := "__match__";
    var matchOff: int64 := self.cg_addLocal(matchVar, 8);
    self.cg_genExpr(self.cg_nc0(ni));
    self.cg_storeRax(matchOff);

    // Save and reset break list
    var savedBreakHead: int64 := self.curBreakHead;
    self.curBreakHead := -1;

    var defaultCaseNode: int64 := -1;
    var caseCur: int64 := self.cg_nc1(ni);  // first match case
    while (caseCur != -1) {
      // c0 = pattern, c1 = body expression, c2 = guard (or -1)
      var patNode: int64 := self.cg_nc0(caseCur);
      var bodyNode: int64 := self.cg_nc1(caseCur);
      var guardNode: int64 := self.cg_nc2(caseCur);
      var patKind: int64 := self.cg_nkind(patNode);

      // WP-BC-11: or-pattern — try each alternative; if any matches, jmp to body
      if (patKind == CGN_PATTERN_OR) {
        var savedOrBodyHead: int64 := self.orBodyHead;
        self.orBodyHead := -1;
        self.cg_emitOrAlt(matchOff, patNode);   // emit je-body for each alt
        // No alternative matched → jmp next_case
        self.cg_e8(0xE9);
        var jmpNextCase: int64 := self.codeLen;
        self.cg_e32(0);
        // Patch all je-body jumps → current position (body entry)
        var oh: int64 := self.orBodyHead;
        while (oh != -1) {
          var lnk: int64 := peek8(self.code + oh) + peek8(self.code + oh + 1) * 256 + peek8(self.code + oh + 2) * 65536 + peek8(self.code + oh + 3) * 16777216;
          if (lnk >= 2147483648) { lnk := lnk - 4294967296; }
          poke32(self.code + oh, self.codeLen - oh - 4);
          oh := lnk;
        }
        self.orBodyHead := savedOrBodyHead;
        // Guard check (if present)
        var guardFailPos: int64 := -1;
        if (guardNode >= 0) {
          self.cg_genExpr(guardNode);
          self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
          self.cg_e8(0x0F); self.cg_e8(0x84);                      // jz guard_fail
          guardFailPos := self.codeLen;
          self.cg_e32(0);
        }
        self.cg_genExpr(bodyNode);
        self.cg_e8(0xE9);
        var bpOR: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bpOR;
        // Patch next_case and guard_fail → here
        poke32(self.code + jmpNextCase, self.codeLen - jmpNextCase - 4);
        if (guardFailPos >= 0) { poke32(self.code + guardFailPos, self.codeLen - guardFailPos - 4); }

      // Wildcard pattern - treat as default
      } else if (patKind == CGN_PATTERN_WILD) {
        defaultCaseNode := caseCur;
      } else if (patKind == CGN_PATTERN_STRUCT) {
        // WP-15: Struct destructure pattern: Point { x: patX, y: patY }
        // sval = struct type name, c0 = first field pattern (NK_PATTERN_BIND)
        var structName: pchar := self.cg_nsval(patNode);
        var structLen: int64 := self.cg_nslen(patNode);
        
        // Load the struct value
        self.cg_loadRax(matchOff);
        self.cg_pushRax();  // save struct value
        
        // Find the struct/class layout
        var structOff: int64 := self.cg_findClass(structName, structLen);
        if (structOff != -1) {
          // Iterate over field patterns
          var fieldPat: int64 := self.cg_nc0(patNode);
          var matchFailed: int64 := 0;
          while (fieldPat != -1) {
            // fieldPat is NK_PATTERN_BIND with sval = field name
            var fieldName: pchar := self.cg_nsval(fieldPat);
            var fieldLen: int64 := self.cg_nslen(fieldPat);
            var innerPat: int64 := self.cg_nc0(fieldPat);  // inner pattern
            
            // Find field offset in struct
            var fldOff: int64 := self.cg_findField(structOff, fieldName, fieldLen);
            if (fldOff != -1) {
              // Load field value from struct
              self.cg_popRax();
              self.cg_pushRax();
              // mov rax, [rax + fieldOffset]
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40);
              self.cg_e8(fldOff as int64);
              
              // Generate code for inner pattern (recursive match on field value)
              var innerPatKind: int64 := self.cg_nkind(innerPat);
              if (innerPatKind == CGN_PATTERN_BIND) {
                // Binding pattern: bind field value to new variable
                var bindName: pchar := self.cg_nsval(innerPat);
                var bindLen: int64 := self.cg_nslen(innerPat);
                var bindOff: int64 := self.cg_addLocal(bindName, bindLen);
                self.cg_storeRax(bindOff);
              } else if (innerPatKind == CGN_PATTERN_LIT) {
                // Literal pattern: compare
                var patVal: int64 := self.cg_nival(innerPat);
                self.cg_pushRax();
                if (patVal != 0) {
                  self.cg_movRaxImm(patVal);
                } else {
                  var patName: pchar := self.cg_nsval(innerPat);
                  var patNameLen: int64 := self.cg_nslen(innerPat);
                  var patNameOff: int64 := self.cg_findLocal(patName, patNameLen);
                  if (patNameOff != 0) {
                    self.cg_loadRax(patNameOff);
                  } else {
                    self.cg_zeroRax();
                  }
                }
                self.cg_popRbx();
                // cmp rbx, rax; jne fail
                self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
                self.cg_e8(0x0F); self.cg_e8(0x85);
                var jnePos2: int64 := self.codeLen;
                self.cg_e32(0);
                // Field matched - continue
                poke32(self.code + jnePos2, self.codeLen - jnePos2 - 4);
              }
              // Wildcard pattern: do nothing (field value ignored)
            }
            fieldPat := self.cg_nnext(fieldPat);
          }
          // All fields matched - execute case body
          self.cg_popRax();
          self.cg_genExpr(bodyNode);
          // Implicit jmp to match_end
          self.cg_e8(0xE9);
          var bp2: int64 := self.codeLen;
          self.cg_e32(self.curBreakHead);
          self.curBreakHead := bp2;
        } else {
          // Unknown struct type - treat as wildcard
          self.cg_popRax();
          defaultCaseNode := caseCur;
        }
      } else if (patKind == CGN_PATTERN_ENUM) {
        // BUG-08: Enum payload pattern: Ok(value) or Err(msg)
        // sval = enum variant name, c0 = binding pattern for payload
        var varName: pchar := self.cg_nsval(patNode);
        var varLen: int64 := self.cg_nslen(patNode);

        // Find the variant tag across all enums
        var foundTag: int64 := -1;
        var payloadSize: int64 := 0;
        var ei: int64 := 0;
        while (ei < self.enumCount) {
          var tagInfo: int64 := self.cg_findEnumVariant(ei, varName, varLen);
          if (tagInfo >= 0) {
            foundTag := tagInfo & 0xFFFFFFFF;
            payloadSize := tagInfo >> 32;
            break;
          }
          ei := ei + 1;
        }

        if (foundTag >= 0) {
          // Load subject value (tag is in lower 32 bits)
          self.cg_loadRax(matchOff);
          self.cg_pushRax();  // save subject for payload extraction

          // Compare subject tag with variant tag
          // mov rax, subject_tag (already in rax)
          // cmp rax, foundTag
          self.cg_e8(0x48); self.cg_e8(0x3D);
          self.cg_e32(foundTag);
          // jne skip_case
          self.cg_e8(0x0F); self.cg_e8(0x85);
          var jnePos: int64 := self.codeLen;
          self.cg_e32(0);

          // Tags match — extract payload bindings if present
          var bindPat: int64 := self.cg_nc0(patNode);
          var bindIdx: int64 := 0;
          while (bindPat != -1) {
            var bindName: pchar := self.cg_nsval(bindPat);
            var bindLen: int64 := self.cg_nslen(bindPat);
            // Payload is at subject + 8 (after tag) + bindIdx * 8
            self.cg_popRax();
            self.cg_pushRax();
            // mov rax, [rax + 8 + bindIdx*8]
            var payOff: int64 := 8 + bindIdx * 8;
            if (payOff <= 127) {
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40);
              self.cg_e8(payOff);
            } else {
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80);
              self.cg_e32(payOff);
            }
            // Store payload value in local variable
            var bindLocalOff: int64 := self.cg_addLocal(bindName, bindLen);
            self.cg_storeRax(bindLocalOff);
            self.cg_pushRax();  // restore subject for next binding
            bindIdx := bindIdx + 1;
            bindPat := self.cg_nnext(bindPat);
          }
          self.cg_popRax();  // discard saved subject

          // Execute case body
          self.cg_genExpr(bodyNode);
          // Implicit jmp to match_end
          self.cg_e8(0xE9);
          var bp: int64 := self.codeLen;
          self.cg_e32(self.curBreakHead);
          self.curBreakHead := bp;

          // Patch jne to next case
          poke32(self.code + jnePos, self.codeLen - jnePos - 4);
        } else {
          // Unknown variant — treat as wildcard/default
          defaultCaseNode := caseCur;
        }
      } else {
        // Load subject value, compare with pattern
        self.cg_loadRax(matchOff);
        self.cg_pushRax();
        // Pattern literal: c1 = ival for int literals, sval for identifiers
        var patVal: int64 := self.cg_nival(patNode);
        if (patVal != 0) {
          // Integer literal pattern
          self.cg_movRaxImm(patVal);
        } else {
          // Identifier pattern - load from local/symbol
          // For now, assume string-based pattern comparison
          var patName: pchar := self.cg_nsval(patNode);
          var patLen: int64 := self.cg_nslen(patNode);
          var patOff: int64 := self.cg_findLocal(patName, patLen);
          if (patOff != 0) {
            self.cg_loadRax(patOff);
          } else {
            self.cg_zeroRax();
          }
        }
        self.cg_popRbx();
        // cmp rbx, rax; jne skip_case
        self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
        self.cg_e8(0x0F); self.cg_e8(0x85);
        var jnePos: int64 := self.codeLen;
        self.cg_e32(0);
        // WP-BC-11: guard check (c2 of case node)
        var guardFail2: int64 := -1;
        if (guardNode >= 0) {
          self.cg_genExpr(guardNode);
          self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
          self.cg_e8(0x0F); self.cg_e8(0x84);                      // jz guard_fail
          guardFail2 := self.codeLen;
          self.cg_e32(0);
        }
        // Execute case body
        self.cg_genExpr(bodyNode);
        // Implicit jmp to match_end
        self.cg_e8(0xE9);
        var bp: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bp;
        // Patch jne (and guard fail) to next case
        poke32(self.code + jnePos, self.codeLen - jnePos - 4);
        if (guardFail2 >= 0) { poke32(self.code + guardFail2, self.codeLen - guardFail2 - 4); }
      }
      caseCur := self.cg_nnext(caseCur);
    }

    // Default/wildcard case executes last if no other case matched
    if (defaultCaseNode != -1) {
      var bodyNode: int64 := self.cg_nc1(defaultCaseNode);
      var defGuard: int64 := self.cg_nc2(defaultCaseNode);
      if (defGuard >= 0) {
        self.cg_genExpr(defGuard);
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x74);                                         // jz short (skip default)
        var defSkip: int64 := self.codeLen;
        self.cg_e8(0);
        self.cg_genExpr(bodyNode);
        self.cg_e8(0xE9);
        var bpDefG: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bpDefG;
        poke8(self.code + defSkip, self.codeLen - defSkip - 1);
      } else {
        self.cg_genExpr(bodyNode);
        self.cg_e8(0xE9);
        var bpd: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bpd;
      }
    }

    // match_end: patch all break/implicit jmps
    var bh: int64 := self.curBreakHead;
    while (bh != -1) {
      var b0: int64 := peek8(self.code + bh);
      var b1: int64 := peek8(self.code + bh + 1);
      var b2: int64 := peek8(self.code + bh + 2);
      var b3: int64 := peek8(self.code + bh + 3);
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + bh, self.codeLen - bh - 4);
      bh := nextLink;
    }
    self.curBreakHead := savedBreakHead;
  }

  // ------------------------------------------------------------------
  // Function declaration
  // ------------------------------------------------------------------

  // WP-EN-05: read the stored 4-byte linked-list link at `pos` in code buffer,
  // sign-extended to int64 (-1 = end-of-list sentinel).
  fn cg_readLink(pos: int64): int64 {
    var b0: int64 := peek8(self.code + pos) as int64;
    var b1: int64 := peek8(self.code + pos + 1) as int64;
    var b2: int64 := peek8(self.code + pos + 2) as int64;
    var b3: int64 := peek8(self.code + pos + 3) as int64;
    var v: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
    if (v >= 2147483648) { v := v - 4294967296; }
    return v;
  }

  // WP-EN-05: walk a linked list of rel32 placeholders and patch each to
  // (target - pos - 4). `head` = first node offset, -1 = empty.
  fn cg_patchList(head: int64, target: int64) {
    var p: int64 := head;
    while (p != -1) {
      var nxt: int64 := self.cg_readLink(p);
      poke32(self.code + p, target - p - 4);
      p := nxt;
    }
  }

  // WP-EN-05: append `dst` to the tail of the `src` linked list and return
  // the new head.  The tail is the node whose stored link equals -1.
  // If `src` == -1 (empty), returns `dst` unchanged.
  fn cg_mergeBreakList(dst: int64, src: int64): int64 {
    if (src == -1) { return dst; }
    var p: int64 := src;
    while (true) {
      var nxt: int64 := self.cg_readLink(p);
      if (nxt == -1) {
        poke32(self.code + p, dst);
        return src;
      }
      p := nxt;
    }
    return src;
  }

  // WP-EN-04: unroll factor for current function's energy level
  // Level 1→1, 2→2, 3→4, 4→4, 5→8
  fn cg_unrollFactor(): int64 {
    if (self.fnEnergyLevel <= 1) { return 1; }
    if (self.fnEnergyLevel == 2) { return 2; }
    if (self.fnEnergyLevel == 5) { return 8; }
    return 4;  // levels 3 and 4
  }

  fn cg_genFuncDecl(ni: int64) {
    // Register label for this function
    var fname: pchar := self.cg_nsval(ni);
    var fnlen: int64 := self.cg_nslen(ni);
    self.cg_addLabel(fname, fnlen, self.cg_lineOf(ni));

    // Save and set outer function context for nested function capture analysis
    var savedOuterName: pchar := self.outerFuncName;
    var savedOuterLen: int64 := self.outerFuncNameLen;
    self.outerFuncName := fname;
    self.outerFuncNameLen := fnlen;

    // WP-EN-04: resolve effective energy level for this function
    // Priority: @energy(N) pragma on fn > CLI/global > hard-coded default 3
    var savedEnergy: int64 := self.fnEnergyLevel;
    var annoEnergy: int64 := (self.cg_nival(ni) >> ANNO_ENERGY_SHIFT) & 7;
    if (annoEnergy >= 1 && annoEnergy <= 5) {
      self.fnEnergyLevel := annoEnergy;
    } else if (self.globalEnergyLevel >= 1) {
      self.fnEnergyLevel := self.globalEnergyLevel;
    } else {
      self.fnEnergyLevel := 1;  // default: no unrolling (bootstrap-safe)
    }

    // Reset locals
    self.localCount := 0;
    self.frameSize  := 0;

    // Emit prologue, capture patch position for sub rsp imm32
    var prologuePatch: int64 := self.cg_emitPrologue();

    // Spill parameters (child0 = first param, linked via next)
    var param: int64 := self.cg_nc0(ni);
    var paramIdx: int64 := 0;
    while (param != -1 && paramIdx < 6) {
      var pname: pchar := self.cg_nsval(param);
      var pnlen: int64 := self.cg_nslen(param);
      var off: int64 := self.cg_addLocal(pname, pnlen);
      // Track param type if it's a user type (NK_TYPE_NAME = 60)
      var ptypeNode: int64 := self.cg_nc0(param);
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == 60) {
        self.cg_setLocalType(self.localCount - 1, self.cg_nsval(ptypeNode), self.cg_nslen(ptypeNode));
      }
      if (paramIdx == 0) { self.cg_spillRdi(off); }
      else if (paramIdx == 1) { self.cg_spillRsi(off); }
      else if (paramIdx == 2) { self.cg_spillRdx(off); }
      else if (paramIdx == 3) { self.cg_spillRcx(off); }
      else if (paramIdx == 4) { self.cg_spillR8(off); }
      else if (paramIdx == 5) { self.cg_spillR9(off); }
      paramIdx := paramIdx + 1;
      param := self.cg_nnext(param);
    }

    // Generate function body (child2 = block)
    var body: int64 := self.cg_nc2(ni);
    // WP-AS-10: collect defers before generating body so return points can emit them
    self.deferCount := 0;
    self.cg_collectDefers(body);
    self.cg_genBlock(body);

    // Implicit return — emit defers first, then xor rax,rax + epilogue
    self.cg_emitDefers();  // WP-AS-10
    self.cg_zeroRax();
    self.cg_emitEpilogue();

    // Patch sub rsp with aligned frame size
