      self.cg_e8(0x58);  // pop rax (size)
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);  // add rsp, 16
      self.cg_e8(0xEB); var fsDone: int64 := self.codeLen; self.cg_e8(0);  // jmp .fsdone
      cg_patchRel8(self.code, fsErr, self.codeLen);
      self.cg_movRaxImm(-1);
      cg_patchRel8(self.code, fsDone, self.codeLen);

    } else if (self.cg_seq(fname, fnlen, "FileReadAll", 11)) {
      // FileReadAll(path): rdi=path → rax=null-terminated buffer or null
      // open(path, O_RDONLY, 0) → fd
      self.cg_e8(0x31); self.cg_e8(0xF6);  // xor esi, esi
      self.cg_e8(0x31); self.cg_e8(0xD2);
      self.cg_e8(0xB8); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // → rax=fd
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
      // jns .fraOk (fd >= 0 → success path)  — short forward jump over error block (~9 bytes)
      self.cg_e8(0x79); var fraOk: int64 := self.codeLen; self.cg_e8(0);
      self.cg_zeroRax();                    // error: return null
      // near jmp .fraDone (E9 + 4-byte disp) — success path is >127 bytes
      self.cg_e8(0xE9); var fraDone: int64 := self.codeLen; poke32(self.code + fraDone, 0); self.codeLen := self.codeLen + 4;
      cg_patchRel8(self.code, fraOk, self.codeLen);
      self.cg_e8(0x50);  // .fraOk: push rax (fd)
      // lseek(fd, 0, SEEK_END=2) → size
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24);  // mov rdi, [rsp] = fd
      self.cg_e8(0x31); self.cg_e8(0xF6);
      self.cg_e8(0xBA); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0xB8); self.cg_e8(0x08); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // → rax=size
      self.cg_e8(0x50);  // push rax (size)
      // [rsp]=size [rsp+8]=fd, rax=size
      // WP-31: size <= 0 check — reject empty/invalid files
      // test rax, rax
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
      // jg +23 (skip close block, size > 0)
      self.cg_e8(0x7F); self.cg_e8(23);
      // close block 1: size <= 0 — close(fd), pop stack, return null
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rdi, [rsp+8] = fd
      self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov eax, 3 (sys_close)
      self.cg_e8(0x0F); self.cg_e8(0x05);                                                          // syscall
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);                    // add rsp, 16
      self.cg_e8(0x31); self.cg_e8(0xC0);                                                          // xor eax, eax (null)
      self.cg_e8(0xE9); var fraClose1: int64 := self.codeLen; poke32(self.code + fraClose1, 0); self.codeLen := self.codeLen + 4;
      // WP-31: size > 256 MB check — reject oversized files (DoS / OOM)
      // cmp rax, 268435456 (0x10000000 = 256 MB, sign-extended imm32)
      self.cg_e8(0x48); self.cg_e8(0x3D); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x10);
      // jle +23 (skip close block, size <= 256 MB → ok)
      self.cg_e8(0x7E); self.cg_e8(23);
      // close block 2: size > 256 MB — close(fd), pop stack, return null
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rdi, [rsp+8] = fd
      self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov eax, 3 (sys_close)
      self.cg_e8(0x0F); self.cg_e8(0x05);                                                          // syscall
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);                    // add rsp, 16
      self.cg_e8(0x31); self.cg_e8(0xC0);                                                          // xor eax, eax (null)
      self.cg_e8(0xE9); var fraClose2: int64 := self.codeLen; poke32(self.code + fraClose2, 0); self.codeLen := self.codeLen + 4;
      // lseek(fd, 0, SEEK_SET=0) to rewind
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rdi, [rsp+8] = fd
      self.cg_e8(0x31); self.cg_e8(0xF6);  // xor esi, esi
      self.cg_e8(0x31); self.cg_e8(0xD2);  // xor edx, edx (SEEK_SET)
      self.cg_e8(0xB8); self.cg_e8(0x08); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);
      // alloc(size+1) for anonymous buffer
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x00);  // mov rsi, [rsp] = size
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC6); self.cg_e8(0x01);  // add rsi, 1
      self.cg_e8(0x31); self.cg_e8(0xFF);
      self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);
      self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);
      self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // → rax=buf
      self.cg_e8(0x50);  // push rax (buf)
      // [rsp]=buf [rsp+8]=size [rsp+16]=fd
      // read(fd, buf, size)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x10);  // mov rdi, [rsp+16] = fd
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x00);  // mov rsi, [rsp] = buf
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rdx, [rsp+8] = size
      self.cg_movRaxImm(0);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // read
      // null-terminate: buf[size] = 0
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0x24);  // mov rax, [rsp] = buf
      self.cg_e8(0x48); self.cg_e8(0x03); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);  // add rax, [rsp+8] = size
      self.cg_e8(0xC6); self.cg_e8(0x00); self.cg_e8(0x00);  // mov byte [rax], 0
      // close(fd)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x10);  // mov rdi, [rsp+16] = fd
      self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);
      // return buf
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0x24);  // mov rax, [rsp] = buf
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x18);  // add rsp, 24
      poke32(self.code + fraDone,   self.codeLen - fraDone   - 4);  // patch near jmp .fraDone (rel32)
      poke32(self.code + fraClose1, self.codeLen - fraClose1 - 4);  // WP-31: patch size<=0 error jmp
      poke32(self.code + fraClose2, self.codeLen - fraClose2 - 4);  // WP-31: patch size>256MB error jmp

    } else if (self.cg_seq(fname, fnlen, "FileWriteAll", 12)) {
      // FileWriteAll(path, data, len): rdi=path, rsi=data, rdx=len → rax=bytes written
      // open(path, O_WRONLY|O_CREAT|O_TRUNC=577, 0644)
      self.cg_e8(0x52);  // push rdx (len)
      self.cg_e8(0x56);  // push rsi (data)
      self.cg_e8(0xBE); self.cg_e8(0x41); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00);  // mov esi, 577
      self.cg_e8(0xBA); self.cg_e8(0xA4); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00);  // mov edx, 0644 (420)
      self.cg_e8(0xB8); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // open → rax=fd
      self.cg_e8(0x50);  // push rax (fd)
      // [rsp]=fd [rsp+8]=data [rsp+16]=len
      // write(fd, data, len)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24);  // mov rdi, [rsp] = fd
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rsi, [rsp+8] = data
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x10);  // mov rdx, [rsp+16] = len
      self.cg_movRaxImm(1);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // write → rax=bytes_written
      self.cg_e8(0x50);  // push rax (bytes_written)
      // close(fd)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rdi, [rsp+8] = fd
      self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);
      // return bytes_written
      self.cg_e8(0x58);  // pop rax (bytes_written)
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x18);  // add rsp, 24 (fd, data, len)

    } else if (self.cg_findExternDecl(fname, fnlen) >= 0) {
      // FFI call: register this declared extern's GOT slot now (lazy — only
      // called externs get slots/relocations) and call indirectly through it.
      // The SysV ABI requires %rsp 16-byte aligned at the call, or libc/OpenSSL
      // crash on aligned SSE moves (movaps). Lyx's own calls don't need this,
      // so we align locally only for FFI: save rsp, align down, restore after.
      // Args are already in rdi/rsi/rdx/rcx/r8/r9; aligning rsp doesn't touch
      // them. disp32 is patched in cg_writeELFDynamic once the GOT VA is known.
      var exd: int64 := self.cg_findExternDecl(fname, fnlen);
      var edb: int64 := self.externDecls + exd * CG_EXTERN_SZ;
      var exIdx: int64 := self.cg_addExtern(peek64(edb) as pchar, peek64(edb + CG_EXTERN_OFF_NAMELEN),
                                            peek64(edb + CG_EXTERN_OFF_LIBPTR), peek64(edb + CG_EXTERN_OFF_LIBLEN));

      // #1486: Bis hierher liegen ALLE Argumente in rdi/rsi/rdx/rcx/r8/r9 —
      // fuer Lyx-eigene Aufrufe richtig, fuer die SysV-ABI nicht. Sie fuehrt
      // zwei getrennte Reihen: Ganzzahlen und Zeiger in den GP-Registern,
      // Gleitkommawerte in xmm0..xmm7, jede Reihe fuer sich durchgezaehlt. Ein
      // f64-Argument landete deshalb in rdi, waehrend der Callee xmm0 las —
      // `fabs(-2.5)` lieferte 0.00 statt 2.50, und jede C-Bibliothek mit
      // float-Signatur (praktisch das gesamte OpenGL) war unbenutzbar.
      var declNi: int64 := peek64(edb + CG_EXTERN_OFF_NODE);

      // #1674: Microsoft-x64. Die Argumente liegen an dieser Stelle in der
      // SysV-Reihe (rdi, rsi, rdx, rcx, r8, r9); gebraucht werden rcx, rdx,
      // r8, r9 — und Gleitkommawerte in xmm0..xmm3, dort nach der POSITION
      // des Arguments, nicht nach einer eigenen Zaehlung wie bei SysV.
      //
      // Umgeschichtet wird ueber den Stapel, weil sich die beiden Reihen
      // ueberschneiden: rcx ist Ziel von Argument 0 und zugleich Quelle von
      // Argument 3. Ein direktes Kopieren in der falschen Reihenfolge
      // zerstoert die Quelle, bevor sie gelesen ist.
      if (self.msAbi != 0) {
        var msN: int64 := argc;
        if (msN > 4) {
          EPrintStr("codegen error: extern fn '"c);
          sys_write(2, fname as int64, fnlen);
          EPrintStrLn("': mehr als vier Argumente sind auf win64 nicht umgesetzt (#1674)"c);
          EPrintStrLn("  Die Microsoft-Konvention legt ab dem fuenften Argument auf den Stapel."c);
          exit(1);
        }
        // Argumente sichern (Reihenfolge 0..n-1) …
        var msI: int64 := 0;
        while (msI < msN) {
          self.cg_e8(0x50 + self.cg_ffiPushOp(msI));
          msI := msI + 1;
        }
        // … und rueckwaerts in die Zielregister holen.
        msI := msN - 1;
        while (msI >= 0) {
          self.cg_ffiPopMs(msI);
          msI := msI - 1;
        }
        // Gleitkommawerte zusaetzlich nach xmm_position.
        if (declNi >= 0) {
          var msMask: int64 := (self.cg_nival(declNi) >> 32) & 65535;
          var msK: int64 := 0;
          while (msK < msN) {
            var msCls: int64 := (msMask >> (msK * 2)) & 3;
            if (msCls != 0) {
              self.cg_ffiMovqXmmFromGpr(msK, self.cg_msIntReg(msK));
              if (msCls == 2) {
                self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x5A);
                self.cg_e8(0xC0 + msK * 8 + msK);   // cvtsd2ss xmm_k, xmm_k
              }
            }
            msK := msK + 1;
          }
        }
      }

      var nFloat: int64 := 0;
      // #1640: 1 = alle Argumente passen in die Registerreihen, der Callee
      // bekommt also gar keine Stapelargumente — auch wenn der allgemeine
      // Aufrufpfad welche abgelegt hat. Ohne Deklarationswissen bleibt es 0
      // und alles laeuft wie bisher.
      var ffiRegOnly: int64 := 0;
      if (declNi >= 0 && self.msAbi == 0) {
        var fpos: int64 := alloc(8 * 8);      // Positionen der Gleitkommaargumente
        var fcls: int64 := alloc(8 * 8);      // 1 = f64, 2 = f32
        var ipos: int64 := alloc(8 * 8);      // Positionen der Ganzzahlargumente
        var nInt: int64 := 0;
        // #1486: Der Parser baut fuer `extern fn` keine Parameterknoten — er
        // ueberspringt die Deklaration und haelt nur eine Signaturzaehlung
        // fest (c0/c1 bleiben -1, damit sema nicht ueber unbekannte Typen
        // stolpert). Die Gleitkommamaske steht deshalb in iVal:
        // Bits 32-47 zwei je Parameter, Bits 48-49 die Rueckgabe.
        var fiv: int64 := self.cg_nival(declNi);
        var fmask: int64 := (fiv >> 32) & 65535;
        // #2140: Die Maske reicht nur ueber acht Parameter. Ein Gleitkommawert
        // dahinter lief bisher als Ganzzahl ueber den Stapel — die Klasse ist
        // unbekannt, also wird es gemeldet (Bit 53, parser._parseExternFn).
        if (((fiv >> 53) & 1) != 0) {
          EPrintStr("codegen error: extern fn '"c);
          sys_write(2, fname as int64, fnlen);
          EPrintStrLn("': Gleitkommaparameter ab dem neunten sind nicht umgesetzt (#2140)"c);
          exit(1);
        }
        // #1640: Bis hierher lag die Schranke bei Position 6 — ein siebtes
        // oder achtes Gleitkommaargument wurde abgewiesen, obwohl die SysV-ABI
        // die ersten ACHT in xmm0..xmm7 uebergibt und dafuer gar keinen Stapel
        // braucht. Damit war praktisch das gesamte OpenGL mit
        // Matrix-Signaturen nicht ansprechbar.
        //
        // Entscheidend sind nicht die Positionen, sondern die beiden getrennt
        // gezaehlten Reihen: bis zu 6 Ganzzahlen in GP-Registern, bis zu 8
        // Gleitkommawerte in xmm. Passen alle Argumente in diese Reihen,
        // braucht der Callee keinen Stapel — auch bei acht Argumenten.
        var pi: int64 := 0;
        var nStackDst: int64 := 0;
        var grenze: int64 := argc;
        if (grenze > 8) { grenze := 8; }
        while (pi < grenze) {
          var cls: int64 := (fmask >> (pi * 2)) & 3;
          if (cls != 0) {
            if (nFloat < 8) {
              poke64(fpos + nFloat * 8, pi);
              poke64(fcls + nFloat * 8, cls);
              nFloat := nFloat + 1;
            } else { nStackDst := nStackDst + 1; }
          } else {
            if (nInt < 6) {
              poke64(ipos + nInt * 8, pi); nInt := nInt + 1;
            } else { nStackDst := nStackDst + 1; }
          }
          pi := pi + 1;
        }
        // Jenseits der Maske (mehr als acht Parameter) ist die Klasse nicht
        // bekannt — solche Argumente zaehlen als Stapelziel.
        if (argc > 8) { nStackDst := nStackDst + (argc - 8); }
        if (nStackDst == 0) { ffiRegOnly := 1; }

        // Erst ab dem NEUNTEN Gleitkommawert geht es wirklich ueber den
        // Stapel, und das kann diese Stelle weiterhin nicht. Kein stiller
        // Default: lieber melden als falsch uebergeben.
        if (ffiRegOnly == 0 && nFloat > 0) {
          EPrintStr("codegen error: extern fn '"c);
          sys_write(2, fname as int64, fnlen);
          EPrintStrLn("': Gleitkommaargumente ueber den Stapel (mehr als acht) sind nicht umgesetzt (#1486, #1640)"c);
          exit(1);
        }

        // Erst die Gleitkommawerte: sie lesen aus den GP-Registern, bevor die
        // Ganzzahlen darin verschoben werden.
        var k: int64 := 0;
        while (k < nFloat) {
          var fp: int64 := peek64(fpos + k * 8);
          if (fp < 6) {
            self.cg_ffiMovqXmmFromGpr(k, self.cg_ffiIntReg(fp));
          } else {
            // #1640: Der allgemeine Aufrufpfad hat dieses Argument auf den
            // Stapel gelegt; von dort geht es direkt ins xmm-Register.
            self.cg_ffiMovsdXmmFromRsp(k, (fp - 6) * 8);
          }
          if (peek64(fcls + k * 8) == 2) {
            // cvtsd2ss xmm_k, xmm_k — aus dem intern gefuehrten double ein
            // echtes single machen.
            self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x5A);
            self.cg_e8(0xC0 + k * 8 + k);
          }
          k := k + 1;
        }

        // Dann die Ganzzahlen zusammenschieben. Das Ziel liegt nie rechts von
        // der Quelle, deshalb ist die Reihenfolge von links nach rechts sicher.
        var t: int64 := 0;
        while (t < nInt) {
          var from: int64 := peek64(ipos + t * 8);
          if (from >= 6) {
            // #1640: dieselbe Lage wie oben, nur fuer eine Ganzzahl.
            self.cg_ffiMovGprFromRsp(self.cg_ffiIntReg(t), (from - 6) * 8);
          } else if (from != t) {
            self.cg_ffiMovGpr(self.cg_ffiIntReg(t), self.cg_ffiIntReg(from));
          }
          t := t + 1;
        }

        free(fpos, 8 * 8); free(fcls, 8 * 8); free(ipos, 8 * 8);
      }

      // #1620: Ab dem SIEBTEN Argument laufen die Werte ueber den Stapel. Sie
      // liegen an dieser Stelle bereits dort (arg6 bei [rsp+0], arg7 bei
      // [rsp+8], …) — und genau das machte die Ausrichtung darunter kaputt:
      // `and rsp, -16` plus zwei `push r11` verschieben den Stapel um 0..24
      // Byte, und der Callee las an [rsp+8] nicht arg7, sondern einen Rest.
      // Sechs Argumente gingen gut, weil sie in Registern liegen; native
      // Lyx-Aufrufe ebenso, weil sie ohne Ausrichtung auskommen. Der Fehler
      // war teilweise still: XCreateSimpleWindow lieferte ein Fenster, nur
      // mit falschen Werten.
      //
      // Deshalb bei Stapelargumenten: alten Stapelzeiger in rbx sichern (das
      // Register muss der Callee erhalten), ausgerichteten Platz schaffen, die
      // Argumente dorthin KOPIEREN und danach alles zurueckdrehen.
      var stackN: int64 := 0;
      if (argc > 6 && ffiRegOnly == 0) { stackN := argc - 6; }
      if (stackN > 0) {
        var kopieSz: int64 := stackN * 8;
        while ((kopieSz & 15) != 0) { kopieSz := kopieSz + 8; }   // auf 16 aufrunden
        self.cg_e8(0x53);                                                // push rbx
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE3);            // mov rbx, rsp
        self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xE4); self.cg_e8(0xF0);  // and rsp, -16
        if (kopieSz <= 127) {
          self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(kopieSz);   // sub rsp, imm8
        } else {
          self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC); self.cg_e32(kopieSz);  // sub rsp, imm32
        }
        // Die Argumente an ihren neuen, ausgerichteten Platz kopieren.
        // Quelle: [rbx + 8 + i*8] (die 8 ueberspringt das gesicherte rbx).
        var ci: int64 := 0;
        while (ci < stackN) {
          var qOff: int64 := 8 + ci * 8;
          var zOff: int64 := ci * 8;
          if (qOff <= 127) {
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x43); self.cg_e8(qOff);          // mov rax, [rbx+qOff]
          } else {
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x83); self.cg_e32(qOff);         // mov rax, [rbx+qOff32]
          }
          if (zOff <= 127) {
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(zOff);   // mov [rsp+zOff], rax
          } else {
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x84); self.cg_e8(0x24); self.cg_e32(zOff);  // mov [rsp+zOff32], rax
          }
          ci := ci + 1;
        }
      } else {
        self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xE3);            // mov r11, rsp
        self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xE4); self.cg_e8(0xF0);  // and rsp, -16
        self.cg_e8(0x41); self.cg_e8(0x53);                              // push r11
        self.cg_e8(0x41); self.cg_e8(0x53);                              // push r11 (keep 16-align)
        // #1674: Die Microsoft-Konvention verlangt vom AUFRUFER 32 Byte
        // Schattenspeicher unterhalb der Rueckkehradresse; der Callee darf
        // dort seine vier Registerargumente ablegen. Fehlt er, schreibt die
        // Funktion in den Rahmen des Aufrufers.
        if (self.msAbi != 0) {
          self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(32);  // sub rsp, 32
        }
      }
      // #1486: al traegt die Zahl der benutzten xmm-Register. Variadische
      // C-Funktionen (printf und Verwandte) lesen sie; mit 0 speichern sie
      // keine Gleitkommaargumente.
      self.cg_e8(0xB8); self.cg_e32(nFloat);                           // mov eax, nFloat
      self.cg_e8(0xFF); self.cg_e8(0x15);                              // call *disp32(%rip)
      var ppx: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_addPatch(ppx, exIdx, 0, CG_PATCH_EXTERN);
      if (stackN > 0) {
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xDC);            // mov rsp, rbx
        self.cg_e8(0x5B);                                                // pop rbx
        // Die urspruenglich gepushten Stapelargumente wieder abraeumen —
        // dieselbe Aufgabe, die cg_popStackArgs fuer Lyx-Aufrufe erledigt.
        self.cg_popStackArgs(argc);
      } else {
        if (self.msAbi != 0) {
          self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(32);  // add rsp, 32 (#1674)
        }
        self.cg_e8(0x41); self.cg_e8(0x5B);                              // pop r11
        self.cg_e8(0x5C);                                                 // pop rsp (restore)
        // #1640: Der Callee brauchte keinen Stapel, der allgemeine Aufrufpfad
        // hat aber trotzdem Werte abgelegt (Position >= 6). Sie sind jetzt
        // gelesen und muessen weg — sonst waechst der Stapel bei jedem Aufruf.
        if (argc > 6) { self.cg_popStackArgs(argc); }
      }

      // #1486: Gleitkomma-Rueckgaben kommen in xmm0, gelesen wurde rax.
      if (declNi >= 0) {
        var rcls: int64 := (self.cg_nival(declNi) >> 48) & 3;   // #1486
        if (rcls == 2) {
          self.cg_e8(0xF3); self.cg_e8(0x0F); self.cg_e8(0x5A); self.cg_e8(0xC0);  // cvtss2sd xmm0, xmm0
        }
        if (rcls != 0) {
          self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC0);  // movq rax, xmm0
        }
        // #1607: Eine C-Funktion, die `int` liefert, schreibt nur eax. Die
        // oberen 32 Bit von rax tragen dann, was zufaellig darin lag — aus -1
        // wurde 4294967295, und `if (n < 0)` erkannte den Fehler NIE. Steht in
        // der Deklaration eine schmalere Breite, wird sie jetzt richtig
        // erweitert: vorzeichenbehaftet mit movsx, vorzeichenlos mit movzx.
        var iw: int64 := (self.cg_nival(declNi) >> 50) & 7;
        if (iw == 1) {
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBE); self.cg_e8(0xC0);  // movsx rax, al
        } else if (iw == 2) {
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBF); self.cg_e8(0xC0);  // movsx rax, ax
        } else if (iw == 3) {
          self.cg_e8(0x48); self.cg_e8(0x63); self.cg_e8(0xC0);                    // movsxd rax, eax
        } else if (iw == 4) {
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);  // movzx rax, al
        } else if (iw == 5) {
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB7); self.cg_e8(0xC0);  // movzx rax, ax
        } else if (iw == 6) {
          self.cg_e8(0x89); self.cg_e8(0xC0);                                      // mov eax, eax
        }
      }

    } else if (self.cg_seq(fname, fnlen, "sizeof", 6)) {
      // sizeof(Type) → compile-time byte size of class/struct
      var soArg: int64 := argNode;
      var soSize: int64 := 8;
      if (soArg >= 0) {
        var soName: pchar := self.cg_nsval(soArg);
        var soLen:  int64 := self.cg_nslen(soArg);
        var soClassIdx: int64 := self.cg_findClass(soName, soLen);
        if (soClassIdx >= 0) {
          var soCb: int64 := self.classLayouts + soClassIdx * CG_CLASS_SZ;
          var soFldCnt:   int64 := peek64(soCb + CG_CLASS_OFF_FIELDCNT);
          var soVmtSlots: int64 := peek64(soCb + CG_CLASS_OFF_VMTSLOTS);
          // #1084: Die Groesse aus dem tatsaechlichen Layout ableiten, nicht
          // aus der Feldzahl. Bei einem gepackten Struct lagen die Felder
          // laengst dicht beieinander, `sizeof` meldete aber weiter
          // Feldzahl * 8 -- drei uint8 ergaben 24 statt 3. Wer damit
          // allokiert oder serialisiert, rechnet still falsch.
          //
          // Fuer ungepackte Structs und Klassen aendert sich nichts: dort ist
          // der letzte Offset (n-1)*8 bzw. n*8 und die Breite 8, die Summe
          // also genau der bisherige Wert.
          var soFlds: int64 := peek64(soCb + CG_CLASS_OFF_FIELDSPTR);
          if (soFldCnt > 0 && soFlds != 0) {
            // #1516: Hier lief eine ZWEITE Groessenrechnung ueber dieselben
            // Felder — mit der Breite aus dem Flag statt aus BYTES und ohne
            // die Aufrundung auf die Ausrichtung. Zwei Meinungen ueber
            // dieselbe Tatsache: `sizeof` sagte 17, ein Array aus demselben
            // Struct rechnete mit 24. Es gilt jetzt cg_classStructSize.
            soSize := self.cg_classStructSize(soClassIdx);
            if (soVmtSlots > 0) { soSize := soSize + 8; }
          } else {
            // #1513: die Feldzahl mal acht stimmt nicht mehr, sobald ein Feld
            // inline liegt (Struct als Feld, `[N]T`) oder @packed schmaler ist.
            if (soVmtSlots > 0) {
              soSize := self.cg_classStructSize(soClassIdx) + 8;
            } else {
              soSize := self.cg_classStructSize(soClassIdx);
            }
            if (soFldCnt <= 0) { soSize := 0; }
          }
        }
      }
      self.cg_movRaxImm(soSize);

    } else {
      // User-defined function call: emit call + patch
      var pp: int64 := self.cg_emitCall();
      // #1655: Steht in DIESER Unit eine private Funktion des Namens, meint der
      // Aufruf sie — und keine gleichnamige aus einer anderen Unit.
      if (self.cg_unitPrivHat(fname, fnlen) != 0) {
        var upc: int64 := alloc(8);
        var upb: int64 := self.cg_unitPrivMangle(fname, fnlen, upc);
        self.cg_addPatch(pp, upb, peek64(upc), CG_PATCH_CALL);
        self.cg_trackTempBuf(upb, peek64(upc) + 1);
        free(upc, 8);
      } else {
        self.cg_addPatch(pp, fname as int64, fnlen, CG_PATCH_CALL);
      }
      self.cg_popStackArgs(nTotal);
    }
  }

  // ------------------------------------------------------------------
  // Statement code generation
  // ------------------------------------------------------------------

  // WSP-05: vergleicht Inhalt eines asm-String-Literals (zwischen den Quotes) mit Mnemonic m.
  fn cg_asmIs(child: int64, m: pchar, mlen: int64): int64 {
    var sp: int64 := self.cg_nsval(child) as int64;
    var sl: int64 := self.cg_nslen(child);
    var inner: int64 := 1;                       // sp[0] = '"'
    while (inner < sl && StrCharAt(sp as pchar, inner) != 34) { inner := inner + 1; }
    var innerLen: int64 := inner - 1;
    if (innerLen != mlen) { return 0; }
    return self.cg_seq((sp + 1) as pchar, innerLen, m, mlen);
  }

  // WSP-05: asm { "mnemonic" ... } → x86-Bytes via feste Mnemonic-Tabelle. Unbekannt = Fehler.
  // #1324: Registername -> Nummer in der x86-64-Kodierung. Nur die Register,
  // die ein asm-Block sinnvoll binden kann; alles andere wird gemeldet.
  //   rax/eax/ax/al = 0, rcx/ecx/cx/cl = 1, rdx/edx/dx/dl = 2, rbx.. = 3,
  //   rsi = 6, rdi = 7
  // Die Breite spielt fuer das Laden keine Rolle: geladen wird immer 64 Bit,
  // die Instruktion im Block bestimmt, welcher Teil benutzt wird.
  fn cg_asmRegNr(name: pchar, nlen: int64): int64 {
    if (self.cg_seq(name, nlen, "rax"c, 3) || self.cg_seq(name, nlen, "eax"c, 3)
        || self.cg_seq(name, nlen, "ax"c, 2) || self.cg_seq(name, nlen, "al"c, 2)) { return 0; }
    if (self.cg_seq(name, nlen, "rcx"c, 3) || self.cg_seq(name, nlen, "ecx"c, 3)
        || self.cg_seq(name, nlen, "cx"c, 2) || self.cg_seq(name, nlen, "cl"c, 2)) { return 1; }
    if (self.cg_seq(name, nlen, "rdx"c, 3) || self.cg_seq(name, nlen, "edx"c, 3)
        || self.cg_seq(name, nlen, "dx"c, 2) || self.cg_seq(name, nlen, "dl"c, 2)) { return 2; }
    if (self.cg_seq(name, nlen, "rbx"c, 3) || self.cg_seq(name, nlen, "ebx"c, 3)
        || self.cg_seq(name, nlen, "bx"c, 2) || self.cg_seq(name, nlen, "bl"c, 2)) { return 3; }
    if (self.cg_seq(name, nlen, "rsi"c, 3) || self.cg_seq(name, nlen, "esi"c, 3)) { return 6; }
    if (self.cg_seq(name, nlen, "rdi"c, 3) || self.cg_seq(name, nlen, "edi"c, 3)) { return 7; }
    return -1;
  }

  // #1324: die Eingabeoperanden in ihre Register legen. Ausgewertet wird von
  // rechts nach links in EINEM Durchgang ueber den Stapel — sonst zerstoerte
  // die Auswertung des zweiten Operanden das Register des ersten (dieselbe
  // Falle wie bei den Parameterkopien in #1351).
  fn cg_asmLadeEingaben(head: int64) {
    var n: int64 := 0;
    var c: int64 := head;
    while (c >= 0) { n := n + 1; c := self.cg_nnext(c); }
    if (n == 0) { return; }
    // Erst alle Werte berechnen und sichern ...
    c := head;
    while (c >= 0) {
      self.cg_genExpr(self.cg_nc0(c));
      self.cg_pushRax();
      c := self.cg_nnext(c);
    }
    // ... dann von hinten nach vorn in die Register holen (der letzte liegt oben).
    var i: int64 := n - 1;
    while (i >= 0) {
      var k: int64 := 0;
      var op: int64 := head;
      while (k < i) { op := self.cg_nnext(op); k := k + 1; }
      var reg: int64 := self.cg_asmRegNr(self.cg_nsval(op), self.cg_nslen(op));
      if (reg < 0) {
        EPrintStr("error: asm: unbekanntes Register in in(...): "c);
        EPrintStrLn(self.cg_nsval(op));
        exit(1);
      }
      self.cg_popRax();
      if (reg != 0) {
        // mov reg, rax
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC0 | reg);
      }
      i := i - 1;
    }
  }

  // #1324: die Ausgabeoperanden aus ihren Registern in die Variablen.
  fn cg_asmSchreibeAusgaben(head: int64) {
    var c: int64 := head;
    while (c >= 0) {
      var reg: int64 := self.cg_asmRegNr(self.cg_nsval(c), self.cg_nslen(c));
      if (reg < 0) {
        EPrintStr("error: asm: unbekanntes Register in out(...): "c);
        EPrintStrLn(self.cg_nsval(c));
        exit(1);
      }
      if (reg != 0) {
        // mov rax, reg
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC0 | (reg << 3));
      }
      var ziel: int64 := self.cg_nc0(c);
      if (ziel < 0 || self.cg_nkind(ziel) != CGN_IDENT) {
        EPrintStrLn("error: asm: out(...) braucht eine Variable als Ziel"c);
        exit(1);
      }
      var off: int64 := self.cg_findLocal(self.cg_nsval(ziel), self.cg_nslen(ziel));
      if (off != 0) {
        self.cg_storeRax(off);
      } else {
        var goff: int64 := self.cg_findGlobal(self.cg_nsval(ziel), self.cg_nslen(ziel));
        if (goff >= 0) { self.cg_emitGlobalWrite(self.cg_nsval(ziel), self.cg_nslen(ziel), goff); }
        else {
          EPrintStr("error: asm: out(...) kennt die Variable nicht: "c);
          EPrintStrLn(self.cg_nsval(ziel));
          exit(1);
        }
      }
      c := self.cg_nnext(c);
    }
  }

  fn cg_genAsm(ni: int64) {
    self.cg_asmLadeEingaben(self.cg_nc2(ni));   // #1324
    var c: int64 := self.cg_nc0(ni);
    while (c >= 0) {
      if      (self.cg_asmIs(c, "cli"c, 3))    { self.cg_e8(0xFA); }
      else if (self.cg_asmIs(c, "sti"c, 3))    { self.cg_e8(0xFB); }
      else if (self.cg_asmIs(c, "hlt"c, 3))    { self.cg_e8(0xF4); }
      else if (self.cg_asmIs(c, "nop"c, 3))    { self.cg_e8(0x90); }
      else if (self.cg_asmIs(c, "pause"c, 5))  { self.cg_e8(0xF3); self.cg_e8(0x90); }
      else if (self.cg_asmIs(c, "cpuid"c, 5))  { self.cg_e8(0x0F); self.cg_e8(0xA2); }
      else if (self.cg_asmIs(c, "iretq"c, 5))  { self.cg_e8(0x48); self.cg_e8(0xCF); }
      else if (self.cg_asmIs(c, "wbinvd"c, 6)) { self.cg_e8(0x0F); self.cg_e8(0x09); }
      else if (self.cg_asmIs(c, "invd"c, 4))   { self.cg_e8(0x0F); self.cg_e8(0x08); }
      else if (self.cg_asmIs(c, "sfence"c, 6)) { self.cg_e8(0x0F); self.cg_e8(0xAE); self.cg_e8(0xF8); }
      else if (self.cg_asmIs(c, "lfence"c, 6)) { self.cg_e8(0x0F); self.cg_e8(0xAE); self.cg_e8(0xE8); }
      else if (self.cg_asmIs(c, "mfence"c, 6)) { self.cg_e8(0x0F); self.cg_e8(0xAE); self.cg_e8(0xF0); }
      else if (self.cg_asmIs(c, "rdtsc"c, 5))  { self.cg_e8(0x0F); self.cg_e8(0x31); }
      else if (self.cg_asmIs(c, "ud2"c, 3))    { self.cg_e8(0x0F); self.cg_e8(0x0B); }
      else if (self.cg_asmIs(c, "int3"c, 4))   { self.cg_e8(0xCC); }
      else if (self.cg_asmIs(c, "leave"c, 5))  { self.cg_e8(0xC9); }
      else if (self.cg_asmIs(c, "ret"c, 3))    { self.cg_e8(0xC3); }
      // #1324: die Portbefehle. Sie waren bewusst nicht in der Tabelle, weil
      // sie ohne gefuellte Register nutzlos sind — mit der Operandenbindung
      // sind sie es nicht mehr. Port in dx, Wert in eax/al.
      else if (self.cg_asmIs(c, "in eax, dx"c, 10))  { self.cg_e8(0xED); }
      else if (self.cg_asmIs(c, "in al, dx"c, 9))    { self.cg_e8(0xEC); }
      else if (self.cg_asmIs(c, "out dx, eax"c, 11)) { self.cg_e8(0xEF); }
      else if (self.cg_asmIs(c, "out dx, al"c, 10))  { self.cg_e8(0xEE); }
      else if (self.cg_asmIs(c, "lgdt [rdi]"c, 10))   { self.cg_e8(0x0F); self.cg_e8(0x01); self.cg_e8(0x17); }
      else if (self.cg_asmIs(c, "lidt [rdi]"c, 10))   { self.cg_e8(0x0F); self.cg_e8(0x01); self.cg_e8(0x1F); }
      else if (self.cg_asmIs(c, "invlpg [rdi]"c, 12)) { self.cg_e8(0x0F); self.cg_e8(0x01); self.cg_e8(0x3F); }
      else {
        EPrintStrLn("error: asm: unbekannte/nicht-unterstuetzte Mnemonic"c);
        exit(1);
      }
      c := self.cg_nnext(c);
    }
    self.cg_asmSchreibeAusgaben(self.cg_nc1(ni));   // #1324
  }

  fn cg_genStmt(ni: int64) {
    if (ni < 0) { return; }
    var k: int64 := self.cg_nkind(ni);

    if (k == CGN_BLOCK) {
      self.cg_genBlock(ni);

    } else if (k == CGN_ASM) {
      self.cg_genAsm(ni);

    } else if (k == CGN_VAR_DECL || k == CGN_CON_DECL) {
      var name: pchar := self.cg_nsval(ni);
      var nlen: int64 := self.cg_nslen(ni);
      var off: int64 := self.cg_addLocal(name, nlen);
      if (k == CGN_VAR_DECL) { self.cg_rlBinde(ni, off); }   // #2114
      var localIdx: int64 := self.localCount - 1;
      // Track type for OOP local lookup (child0 = type node, NK_TYPE_NAME = 60)
      var typeNode: int64 := self.cg_nc0(ni);
      if (typeNode >= 0 && self.cg_nkind(typeNode) == 60) {
        self.cg_setLocalType(localIdx, self.cg_nsval(typeNode), self.cg_nslen(typeNode));
        // #1291: Bei `Map<pchar, V>` muss die Laufzeit den Schluessel ueber
        // seinen INHALT vergleichen. Der Typname allein sagt das nicht — er
        // lautet nur "Map"; der Schluesseltyp steht im ersten Typargument.
        self.cg_markMapStrKey(localIdx, typeNode);
      }
      // #1003: inline geschriebener fn-Zeigertyp — hat keinen Namen, den die
      // fnAlias-Liste tragen koennte, also am Local selbst vermerken.
      if (typeNode >= 0 && self.cg_nkind(typeNode) == CGN_FN_PTR_NODE) {
        poke8(self.localIsFnPtr + localIdx, 1);
        if (self.cg_fnPtrRetIstF64(typeNode) != 0) {   // #1565
          poke8(self.localFnPtrF64 + localIdx, 1);
        }
        poke8(self.localFnRetSatz + localIdx, self.cg_fnPtrRetTiefe(typeNode));   // #2143
        self.cg_rejectCapturingClosure(self.cg_nc1(ni),
          "als Wert einer Variablen mit `fn(...)`-Typ"c);
      }
      // #1249: `var f := fn(x: int64): int64 { … };` OHNE Typangabe. Faengt das
      // Lambda nichts ein, ist sein Wert seit 1.0.16I die blanke Codeadresse —
      // dann muss auch der Aufruf ueber diesen Namen duenn sein.
      // #2133: allgemein — ohne Typangabe haelt das Local einen Satz genau
      // dann, wenn der Startwert einer ist (siehe "Funktionswerte" bei
      // cg_localRufArt); sonst die Adresse. Bis dahin galt jeder andere
      // Startwert als Satz, auch `var h := plus;`.
      var vdInit: int64 := self.cg_nc1(ni);
      var vdSatz: int64 := 0;
      if (typeNode < 0 && vdInit >= 0) {
        if (self.cg_closureCaptures(vdInit) > 0) { vdSatz := 1; }
        else if (self.cg_istSatzWert(vdInit) != 0) { vdSatz := 2; }
        // #1172: Methodenreferenz — ein Satz {Code, self}, dieselbe Form.
        else if (self.cg_isMethodRefExpr(vdInit) != 0) { vdSatz := 1; }
        if (vdSatz != 0) {
          poke8(self.localIsFnPtr + localIdx, 2);
          self.satzLocalJe := 1;
        } else {
          poke8(self.localIsFnPtr + localIdx, 1);
        }
      }
      // #2133: der Rueckgabetyp eines Lambdas (oder der Kopie eines Locals,
      // das eines haelt) — wie #1565 beim `fn(...)`-Typ. Ohne ihn galt
