    poke32(self.code + pTreffer, self.codeLen - pTreffer - 4);
    self.cg_e8(0x49); self.cg_e8(0x83); self.cg_e8(0xFB); self.cg_e8(0x00);  // cmp r11,0
    self.cg_e8(0x0F); self.cg_e8(0x85);                            // jne .t_lesen
    var pTLesen: int64 := self.codeLen; self.cg_e32(0);
    self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x69); self.cg_e8(0x08);  // mov [rcx+8],r13
    self.cg_e8(0x31); self.cg_e8(0xC0);                            // xor eax,eax
    self.cg_e8(0xE9);                                              // jmp .ende
    var pEnde2: int64 := self.codeLen; self.cg_e32(0);
    poke32(self.code + pTLesen, self.codeLen - pTLesen - 4);       // .t_lesen:
    self.cg_e8(0x49); self.cg_e8(0x83); self.cg_e8(0xFB); self.cg_e8(0x01);  // cmp r11,1
    self.cg_e8(0x0F); self.cg_e8(0x85);                            // jne .t_hat
    var pTHat: int64 := self.codeLen; self.cg_e32(0);
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x41); self.cg_e8(0x08);  // mov rax,[rcx+8]
    self.cg_e8(0xE9);                                              // jmp .ende
    var pEnde3: int64 := self.codeLen; self.cg_e32(0);
    poke32(self.code + pTHat, self.codeLen - pTHat - 4);           // .t_hat:
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov eax,1
    self.cg_e8(0xE9);                                              // jmp .ende
    var pEnde4: int64 := self.codeLen; self.cg_e32(0);
    // .null: nicht gefunden bei lesen/enthalten
    poke32(self.code + pNull1, self.codeLen - pNull1 - 4);
    self.cg_e8(0x31); self.cg_e8(0xC0);                            // xor eax,eax
    // .ende
    poke32(self.code + pEnde1, self.codeLen - pEnde1 - 4);
    poke32(self.code + pEnde2, self.codeLen - pEnde2 - 4);
    poke32(self.code + pEnde3, self.codeLen - pEnde3 - 4);
    poke32(self.code + pEnde4, self.codeLen - pEnde4 - 4);
    self.cg_e8(0x41); self.cg_e8(0x5F);                            // pop r15
    self.cg_e8(0x41); self.cg_e8(0x5E);                            // pop r14
    self.cg_e8(0x41); self.cg_e8(0x5D);                            // pop r13
    self.cg_e8(0x41); self.cg_e8(0x5C);                            // pop r12
    self.cg_e8(0x5B);                                              // pop rbx
    self.cg_e8(0xC3);                                              // ret
    // Auch hier gemessen statt gezaehlt (#1284): ein Versatz legte den
    // Benutzercode an die falsche Stelle, und das traefe JEDES Programm.
    if (self.codeLen - mapStrStart != CG_H_MAP_STR_LEN) {
      EPrintStr("codegen error: _lyx_map_str hat "c);
      EPrintInt(self.codeLen - mapStrStart);
      EPrintStr(" Byte, erwartet "c);
      EPrintInt(CG_H_MAP_STR_LEN);
      EPrintStrLn(" — CG_H_USER anpassen (#1291)"c);
      exit(1);
    }
    // Total helpers: ... + CG_H_F64STR_CHK_LEN + CG_H_MAP_STR_LEN = CG_H_USER  ✓
  }

  // ------------------------------------------------------------------
  // Import resolution (WP-09)
  // ------------------------------------------------------------------

  // Read a file into an mmap buffer (null-terminated). Returns null on error.
  fn cg_readFile(path: pchar): pchar {
    var fd: int64 := open(path, 0, 0);
    if (fd < 0) { return 0 as pchar; }
    var size: int64 := lseek(fd, 0, 2);
    if (size <= 0) { close(fd); return 0 as pchar; }
    lseek(fd, 0, 0);
    var buf: int64 := alloc(size + 1);
    // WP-27: partieller/fehlgeschlagener Read → Fehler statt Arena-Müll als Quelle.
    var bytesRead: int64 := read(fd, buf as pchar, size);
    if (bytesRead != size) { close(fd); return 0 as pchar; }
    poke8(buf + size, 0);
    close(fd);
    return buf as pchar;
  }

  // Returns 1 if module name was already imported, 0 otherwise.
  fn cg_hasImported(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.importCount) {
      var base: int64 := self.importNames + i * CG_IMPORT_SZ;
      var p: pchar    := peek64(base) as pchar;
      var n: int64    := peek64(base + CG_PATCH_OFF_NAMEPTR);
      if (n == nameLen && self.cg_seq(p, n, name, nameLen)) { return 1; }
      i += 1;
    }
    return 0;
  }

  // Mark a module as imported (add to dedup set).
  fn cg_markImported(name: pchar, nameLen: int64) {
    if (self.importCount >= self.importCap) {
      var nc: int64 := self.importCap * 2;
      var nb: int64 := alloc(nc * 16);
      var i: int64 := 0;
      memcpy(nb, self.importNames, self.importCount * CG_IMPORT_SZ);
      self.importNames := nb;
      self.importCap   := nc;
    }
    var base: int64 := self.importNames + self.importCount * CG_IMPORT_SZ;
    poke64(base,      name as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  nameLen);
    self.importCount += 1;
  }

  // Try to read `relPath` relative to `base` (base + "/" + relPath).
  // Returns null pchar on failure; caller owns the returned buffer.
  fn cg_tryReadWithBase(base: pchar, relPath: pchar): pchar {
    var baseLen: int64 := StrLen(base);
    var relLen:  int64 := StrLen(relPath);
    var tryLen:  int64 := baseLen + 1 + relLen + 1;
    var tryBuf:  int64 := alloc(tryLen);
    memcpy(tryBuf, base as int64, baseLen);
    var i: int64 := baseLen;
    StrSetChar(tryBuf as pchar, i, 47); i := i + 1;
    memcpy(tryBuf + i, relPath as int64, relLen);
    poke8(tryBuf + i + relLen, 0);
    var src: pchar := self.cg_readFile(tryBuf as pchar);
    free(tryBuf, tryLen);
    return src;
  }

  // Process an import: find the .lyx file, parse it, codegen it.
  // Temporarily swaps pSrc/pNodes to the imported file's data.
  fn cg_processImport(modName: pchar, nameLen: int64) {
    self.cg_processImportAs(modName, nameLen, 0, 0);
  }

  // #1262: wie cg_processImport, aber mit Namensraum.
  fn cg_processImportAs(modName: pchar, nameLen: int64, alias: int64, aliasLen: int64) {
    if (self.cg_hasImported(modName, nameLen) != 0) { return; }
    self.cg_markImported(modName, nameLen);
    // Der Alias gilt nur fuer DIESE Unit. Was sie selbst importiert, wird beim
    // rekursiven Aufruf mit dessen eigenem Alias verarbeitet.
    var cgaSaved:    int64 := self.cgAlias;
    var cgaSavedLen: int64 := self.cgAliasLen;
    self.cgAlias    := alias;
    self.cgAliasLen := aliasLen;
    if (alias != 0 && self.cgAliasTabCount < 256) {
      poke64(self.cgAliasTab + self.cgAliasTabCount * 16, alias);
      poke64(self.cgAliasTab + self.cgAliasTabCount * 16 + 8, aliasLen);
      self.cgAliasTabCount := self.cgAliasTabCount + 1;
    }

    // WP-7a: ".." als Modulkomponente verbieten
    // WP-33: `wptd7 + 1 < nameLen` avoids underflow when nameLen == 0
    var wptd7: int64 := 0;
    while wptd7 + 1 < nameLen {
      if ((StrCharAt(modName, wptd7) & 255) == 46 && (StrCharAt(modName, wptd7 + 1) & 255) == 46) {
        EPrintStr("codegen error: import path traversal verboten: "c);
        EPrintStrLn(modName);
        self.cgAlias := cgaSaved; self.cgAliasLen := cgaSavedLen;   // #1262
        return;
      }
      wptd7 += 1;
    }

    // Convert "bootstrap.parser" → "bootstrap/parser.lyx"
    var pathBuf: int64 := alloc(nameLen + 8);
    var i: int64 := 0;
    while (i < nameLen) {
      var c: int64 := StrCharAt(modName, i);
      if (c == 46) { c := 47; }  // '.' → '/'
      poke8(pathBuf + i, c);
      i += 1;
    }
    var lyxExtCG: pchar := ".lyx";
    memcpy(pathBuf + nameLen, lyxExtCG as int64, 5);

    var path: pchar := pathBuf as pchar;
    var src: pchar := self.cg_readFile(path);

    // Fall back to includePath (LYX_PATH / -I) then stdPath (LYX_STD_PATH / --std-path)
    if (src == 0 as pchar && self.includePath != 0) {
      src := self.cg_tryReadWithBase(self.includePath as pchar, path);
    }
    if (src == 0 as pchar && self.stdPath != 0) {
      src := self.cg_tryReadWithBase(self.stdPath as pchar, path);
    }
    // #1368: zuletzt der Installationspfad des Pakets — dieselbe Stufe, die
    // sema kennt. Sie muss hier WIEDERHOLT werden, weil der Codegen die
    // Importe ein zweites Mal selbst liest; ohne sie fand sema die Unit und
    // der Codegen brach danach mit "cannot read import" ab. Bewusst zuletzt:
    // im Arbeitsverzeichnis gewinnen weiterhin dessen eigene Units.
    if (src == 0 as pchar) {
      src := self.cg_tryReadWithBase("/usr/include/lyx/units"c, path);
    }

    var srcSize: int64 := 0;
    if (src != 0 as pchar) { srcSize := StrLen(src); }

    if (src == 0 as pchar) {
      PrintStr("codegen: cannot read import: ");
      PrintStr(path);
      PrintStr("\n");
      free(pathBuf, nameLen + 8);
      self.cgAlias := cgaSaved; self.cgAliasLen := cgaSavedLen;   // #1262
      return;
    }

    // Parse the imported file
    var p: Parser := new Parser();
    p.Init(src, srcSize);
    var head: int64 := p.Parse();

    if (p.hadError != 0) {
      PrintStr("codegen: parse error in import: ");
      PrintStr(path);
      PrintStr("\n");
      free(pathBuf, nameLen + 8);
      free(src as int64, srcSize);   // #1622
      dispose p;
      self.cgAlias := cgaSaved; self.cgAliasLen := cgaSavedLen;   // #1262
      return;
    }

    free(pathBuf, nameLen + 8);

    // Switch to imported file's source and nodes for codegen
    var savedSrc:   pchar := self.pSrc;
    var savedNodes: int64 := self.pNodes;
    self.pSrc   := p.src;
    self.pNodes := p.nodes;

    // #1655: Waehrend dieser Unit tragen private Marken ihren Namen.
    var utSaved:    int64 := self.cgUnitTag;
    var utSavedLen: int64 := self.cgUnitTagLen;
    var utSavedTab: int64 := self.cgUnitPrivTab;
    var utSavedCnt: int64 := self.cgUnitPrivCnt;
    var utSavedCap: int64 := self.cgUnitPrivCap;
    self.cgUnitTag    := modName as int64;
    self.cgUnitTagLen := nameLen;
    self.cgUnitPrivCap := 128;
    self.cgUnitPrivTab := alloc(self.cgUnitPrivCap * 16);
    self.cgUnitPrivCnt := 0;
    self.cg_unitPrivCollect(head, 0);

    // Recursively generate code for the imported file
    self.cg_genFile(head);
    
    // AP-1: Collect function labels from imported module
    // This makes imported functions visible for patch resolution in main file
    // IMPORTANT: Do this WHILE still switched to import pNodes!
    self.cg_collectImportLabels(head);
    self.cg_collectImportDefaults(head);   // #1342: konstante Vorgabewerte abschreiben

    self.cgUnitTag     := utSaved;      // #1655
    self.cgUnitTagLen  := utSavedLen;
    self.cgUnitPrivTab := utSavedTab;
    self.cgUnitPrivCnt := utSavedCnt;
    self.cgUnitPrivCap := utSavedCap;

    // Restore main file's source and nodes
    self.pSrc   := savedSrc;
    self.pNodes := savedNodes;

    self.cgAlias := cgaSaved; self.cgAliasLen := cgaSavedLen;   // #1262
    dispose p;
    // NOTE: src (imported source buffer) is intentionally NOT freed here.
    // cg_addLabel/cg_buildStructLayout etc. store raw pointers into src.
    // Freeing src would invalidate those pointers and cause SIGSEGV on lookup.
  }

  // ------------------------------------------------------------------
  // AP-1: Collect labels from imported module
  // Walks the AST and registers all function names as labels for patch resolution
  // ------------------------------------------------------------------
  
  fn cg_collectImportLabels(head: int64): void {
    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_FUNC_DECL) {
        var fname: pchar := self.cg_nsval(cur);
        var fnlen: int64 := self.cg_nslen(cur);
        // #1655: dieselbe Marke wie bei der Erzeugung — sonst stuende der
        // schlichte Name doch wieder im Verzeichnis und faenge Aufrufe aus
        // fremden Units ein.
        if (self.cgUnitTag != 0 && peek64(self.cg_noff(cur) + CG_OFF_ISPUB) == 0 &&
            self.cg_unitPrivHat(fname, fnlen) != 0) {
          var clc: int64 := alloc(8);
          var cb:  int64 := self.cg_unitPrivMangle(fname, fnlen, clc);
          self.cg_addLabel(cb as pchar, peek64(clc), 0);
          free(clc, 8);
        } else {
          self.cg_addLabel(fname, fnlen, 0);  // imported: no source line
        }
      }
      cur := self.cg_nnext(cur);
    }
  }

  // WP-BC-24: register a pending generic specialization
  // Entry: {mangledNamePtr:8, mangledNameLen:8, origNamePtr:8, origNameLen:8} = 32 bytes
  fn cg_addMono(mangName: pchar, mangLen: int64, origName: pchar, origLen: int64) {
    if (self.monoCount >= self.monoCap) {
      var nc: int64 := self.monoCap * 2;
      var nb: int64 := alloc(nc * 32);
      var ii: int64 := 0;
      memcpy(nb, self.monoList, self.monoCount * CG_MONO_SZ);
      self.monoList := nb; self.monoCap := nc;
    }
    var base: int64 := self.monoList + self.monoCount * CG_MONO_SZ;
    poke64(base,      mangName as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  mangLen);
    poke64(base + CG_PATCH_OFF_NAMELEN, origName as int64);
    poke64(base + CG_PATCH_OFF_KIND, origLen);
    self.monoCount += 1;
  }

  // WP-BC-24: check if a mangled name is already in the mono list
  fn cg_monoExists(mangName: pchar, mangLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.monoCount) {
      var base: int64 := self.monoList + i * CG_MONO_SZ;
      var n: pchar := peek64(base) as pchar;
      var l: int64 := peek64(base + CG_PATCH_OFF_NAMEPTR);
      if (self.cg_seq(n, l, mangName, mangLen) != 0) { return 1; }
      i += 1;
    }
    return 0;
  }

  // WP-BC-24: build mangled name for generic call, e.g. "Foo_int64"
  fn cg_buildMangledName(baseName: pchar, baseLen: int64, typeArgsNi: int64, outBuf: int64): int64 {
    var pos: int64 := 0;
    var i: int64 := 0;
    while (i < baseLen) { poke8(outBuf + pos, StrCharAt(baseName, i)); pos := pos + 1; i := i + 1; }
    var ta: int64 := typeArgsNi;
    while (ta >= 0) {
      StrSetChar(outBuf as pchar, pos, 95); pos := pos + 1;
      var tname: pchar := self.cg_nsval(ta);
      var tlen:  int64 := self.cg_nslen(ta);
      var j: int64 := 0;
      while (j < tlen) { poke8(outBuf + pos, StrCharAt(tname, j)); pos := pos + 1; j := j + 1; }
      ta := self.cg_nnext(ta);
    }
    poke8(outBuf + pos, 0);
    return pos;
  }

  // ------------------------------------------------------------------
  // Top-level file generation
  // ------------------------------------------------------------------

  // #1338: Konstanten und Enum-Mitglieder wurden in DEMSELBEN Durchlauf
  // eingetragen, der auch die Funktionsruempfe erzeugt. Eine `con`-Zeile
  // UNTER einer Funktion war beim Uebersetzen ihres Rumpfes also noch nicht
  // bekannt — und der Bezeichner loeste still zu 0 auf. 0 ist ein
  // unauffaelliger Wert: der Vergleich wird nie wahr, die Rechnung ergibt 0.
  // Genau so verschwanden in std/os.lyx alle Zweige gegen SC_PAGESIZE.
  //
  // Fuer FUNKTIONEN galt die Vorwaertsreferenz laengst; dass ausgerechnet
  // Konstanten anders sind, kann niemand erwarten. Dieser Vorpass traegt sie
  // ein, bevor der erste Rumpf entsteht — zweimal, damit auch eine Konstante
  // gilt, die auf eine weiter unten stehende verweist.
  // #1507: Die Enum-TABELLE entstand erst im Hauptdurchlauf — beim Auswerten
  // der `con`-Zeilen gab es sie also noch nicht, und `P.Read` fiel auf 0
  // zurueck. Dieselbe Reihenfolgefrage wie bei den Konstanten selbst (#1338)
  // und den Struct-Layouts (#1451): nicht falsch gerechnet, sondern zu spaet
  // vorhanden.
  fn cg_prebuildEnums(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_ENUM_DECL) {
        if (self.cg_findEnum(self.cg_nsval(cur), self.cg_nslen(cur)) < 0) {
          self.cg_buildEnumLayout(cur);
        }
      } else if (k == CGN_BLOCK) {
        self.cg_prebuildEnums(self.cg_nc0(cur));   // @if-Zweig
      }
      cur := self.cg_nnext(cur);
    }
  }

  fn cg_collectCons(head: int64) {
    var runde: int64 := 0;
    while (runde < 2) {
      var cur: int64 := head;
      while (cur != -1) {
        var k: int64 := self.cg_nkind(cur);
        if (k == CGN_CON_DECL) {
          var initNode: int64 := self.cg_nc1(cur);
          if (initNode >= 0) {
            if (self.cg_nkind(initNode) == CGN_LIT_STR) {
              // Die Zeichenkette darf nur EINMAL in den Datenbereich.
              if (runde == 0) {
                var dataOff: int64 := self.cg_addStr(self.cg_nsoff(initNode), self.cg_nslen(initNode));
                self.cg_addConStr(self.cg_nsval(cur), self.cg_nslen(cur), dataOff);
              }
            } else if (self.cg_nkind(initNode) == CGN_IDENT
                       && self.cg_isDeclaredFunc(self.cg_nsval(initNode), self.cg_nslen(initNode)) != 0) {
              // #1589: `con f: fn(int64): int64 := Dbl;`. Der Wert ist eine
              // CODEADRESSE — cg_evalConExpr haette hier 0 eingetragen, und der
              // Aufruf `f(21)` endete in "undefined function 'f'". Gemerkt
              // wird das Paar; die Marke bekommt f, sobald Dbl emittiert ist.
              if (runde == 0) {
                self.cg_addConFn(self.cg_nsval(cur), self.cg_nslen(cur),
                                 self.cg_nsval(initNode), self.cg_nslen(initNode));
              }
            } else {
              self.cg_addCon(self.cg_nsval(cur), self.cg_nslen(cur), self.cg_evalConExpr(initNode));
              // #1499: Gleitkomma merken — entweder steht es am Typ
              // (`con PI: f64 := …`) oder der Wert ist ein Fliesskommaliteral.
              var conF64: int64 := 0;
              var conTy: int64 := self.cg_nc0(cur);
              if (conTy >= 0 && self.cg_nkind(conTy) == 60
                  && self.cg_isFloatTypeName(self.cg_nsval(conTy), self.cg_nslen(conTy)) != 0) { conF64 := 1; }
              if (self.cg_nkind(initNode) == CGN_LIT_FLOAT) { conF64 := 1; }
              if (conF64 != 0) {
                var ci: int64 := self.cg_findConIdx(self.cg_nsval(cur), self.cg_nslen(cur));
                if (ci >= 0) { poke8(self.conIsF64 + ci, 1); }
              }
            }
          }
        } else if (k == CGN_ENUM_DECL) {
          if (runde == 0) {
            var mem: int64 := self.cg_nc0(cur);
            var nextVal: int64 := 0;
            while (mem != -1) {
              var valNode: int64 := self.cg_nc0(mem);
              if (valNode >= 0 && self.cg_nkind(valNode) == CGN_LIT_INT) {
                nextVal := self.cg_nival(valNode);
              }
              self.cg_addCon(self.cg_nsval(mem), self.cg_nslen(mem), nextVal);
              nextVal += 1;
              mem := self.cg_nnext(mem);
            }
          }
        } else if (k == CGN_BLOCK) {
          self.cg_collectCons(self.cg_nc0(cur));   // @if-Zweig
        }
        cur := self.cg_nnext(cur);
      }
      runde += 1;
    }
  }

  fn cg_genFile(head: int64) {
    self.topLevelHead := head;   // A1: früh setzen (für cg_isDeclaredFunc beim Fn-Name-als-Wert)
    // Pre-pass: collect all user-defined functions returning f64 for cg_isF64Expr.
    self.cg_collectF64Funcs(head);
    self.cg_collectMethodAliases(head);   // B2: method-Typ-Aliase registrieren
    self.cg_collectRangeTypes(head);      // #1097: Bereichstypen samt Grenzen
    self.cg_collectUtypes(head);          // #1110: Einheitentypen samt Faktor
    self.cg_collectIfaceSelectors(head);  // #1133: Interface-Selektoren (vor den Layouts!)
    self.cg_prebuildStructLayouts(head);  // #1451: Layouts vor jedem Rumpf
    self.cg_prebuildClassLayouts(head);   // #1663: dasselbe fuer Klassen
    self.cg_prebuildGlobals(head);        // #1665: und fuer Modulvariablen
    self.cg_collectFlightCrit(head);      // #1140: gibt es @flight_crit im Programm?
    // #1338/#1507: Konstanten und Enums verweisen wechselseitig aufeinander —
    // `enum R { CTRL = BASE }` braucht die Konstante, `con MASK := P.Read as
    // int64` das Enum. Deshalb dreimal: erst die Konstanten aus Literalen,
    // dann die Enums (die nun BASE kennen), dann die Konstanten erneut (die
    // nun P.Read kennen). Eine Reihenfolge allein kann es nicht geben.
    self.cg_collectCons(head);
    self.cg_prebuildEnums(head);
    self.cg_collectCons(head);            // #1338: Konstanten VOR den Rumpfen

    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_FUNC_DECL) {
        // extern fn NAME(...) link "lib.so": no body (c2 == -1) and a packed
        // library span in c3 ((len<<32)|off). Register it as an FFI import
        // instead of emitting a function body. The (body==-1 && c3!=-1) test
        // distinguishes externs from @export functions, which share iVal==1
        // but always carry a body.
        var libPacked: int64 := self.cg_nc3(cur);
        // #1287: c2 traegt den RUMPF — bei `extern fn` gibt es keinen, also -1.
        // Steht aber ein `@cap(...)` an der Deklaration, legt der Parser dort
        // die Annotation ab. Der Test "c2 == -1" las das als "hat einen Rumpf",
        // die Deklaration lief in cg_genFuncDecl und wurde als LEERE Funktion
        // emittiert: der Aufruf traf sie, tat nichts und lieferte 0 — kein
        // DT_NEEDED, kein PLT-Eintrag, das Binary blieb statisch. Genau die
        // Annotation, mit der jemand sagt "ich weiss, was ich tue", schaltete
        // den FFI-Aufruf also ab.
        var exBody: int64 := self.cg_nc2(cur);
        var exHasBody: int64 := 1;
        if (exBody == -1) { exHasBody := 0; }
        else if (self.cg_nkind(exBody) == CGN_CAPABILITY_ATTR) { exHasBody := 0; }
        if (exHasBody == 0 && libPacked != -1) {
          var libOff: int64 := libPacked & 0xFFFFFFFF;
          var libLen: int64 := (libPacked >> 32) & 0xFFFFFFFF;
          if (libLen > 0) {
            self.cg_addExternDecl(self.cg_nsval(cur), self.cg_nslen(cur),
                                  (self.pSrc as int64) + libOff, libLen, cur);   // #1486
          }
        } else {
          self.cg_genFuncDecl(cur);
        }
      } else if (k == CGN_EXTERN_DATA) {
        // WSP-07: externes Daten-Symbol registrieren (Name → UNDEF-Symbol in cg_writeELFObj).
        self.cg_addExternData(self.cg_nsval(cur), self.cg_nslen(cur));
      } else if (k == CGN_IMPORT) {
        // Process the imported module (WP-09: import resolution)
        var modName: pchar := self.cg_nsval(cur);
        var modLen:  int64 := self.cg_nslen(cur);
        // #1384: `import pfad.*;`. Der Codegen laeuft seine Importe getrennt
        // von sema durch — er braucht dieselbe Liste, und die kommt aus
        // derselben Funktion (src/wildcard_import.lyx), damit die beiden Wege
        // nicht auseinanderlaufen koennen.
        if (self.cg_nival(cur) == 1) {
          var wcListe: int64 := alloc(CG_WC_MAX_UNITS * 16);
          var wcN: int64 := WildcardUnits(modName, modLen, self.includePath, self.stdPath,
                                          wcListe, CG_WC_MAX_UNITS);
          var wcI: int64 := 0;
          while (wcI < wcN) {
            self.cg_processImport(peek64(wcListe + wcI * 16) as pchar,
                                  peek64(wcListe + wcI * 16 + 8));
            wcI := wcI + 1;
          }
          cur := self.cg_nnext(cur);
          continue;
        }
        // #1262: Aliasknoten steht in c0.
        var aliNi: int64 := self.cg_nc0(cur);
        if (aliNi >= 0 && self.cg_nkind(aliNi) != CGN_IDENT) { aliNi := 0 - 1; }
        if (aliNi >= 0) {
          self.cg_processImportAs(modName, modLen,
                                  self.cg_nsval(aliNi) as int64, self.cg_nslen(aliNi));
        }
        if (aliNi < 0) {
          self.cg_processImport(modName, modLen);
        }
      } else if (k == CGN_TYPE_DECL) {
        // B2: Typ-Alias (iv-Bit1) — kein Klassen/Struct-Layout. c0 = Alias-Target (kein Feld).
        // method-Aliase sind bereits via cg_collectMethodAliases registriert.
        if ((self.cg_nival(cur) & 2) != 0) {
          // nichts zu bauen — Alias ist reine Typ-Umbenennung
        } else {
        // NK_TYPE_DECL: class if it has methods (nc1 != -1), struct otherwise
        var hasMethods: int64 := self.cg_nc1(cur);
        // WP-BC-L2: a method-less class that `extends` a class WITH a vtable must
        // also be class-layout, so it inherits the vtable pointer + slots.
        var forceClass: int64 := 0;
        var tdParent: int64 := self.cg_nc2(cur);
        if (tdParent >= 0) {
          var tdPi: int64 := self.cg_findClass(self.cg_nsval(tdParent), self.cg_nslen(tdParent));
          if (tdPi >= 0) {
            if (peek64(self.classLayouts + tdPi * CG_CLASS_SZ + CG_CLASS_OFF_VMTSLOTS) > 0) { forceClass := 1; }
          }
        }
        if ((self.cg_nival(cur) & 32) != 0) {
          // #1133: Interface. Es bekommt ein Klassen-Layout, damit der Aufruf
          // ueber den Interface-Typ die Slotnummer findet — aber KEINE
          // Methodenruempfe. Bis 1.0.14C entstand fuer jede Interface-Methode
          // ein leerer Rumpf (`I_Zeig`), der 0 zurueckgab; genau den rief der
          // Aufruf ueber die Schnittstelle auf.
          // #1663: schon im Vorlauf gebaut — hier nur noch nachziehen, falls
          // der Vorlauf sie nicht erfasst hat.
          if (self.cg_findClass(self.cg_nsval(cur), self.cg_nslen(cur)) < 0) {
            self.cg_buildClassLayout(cur);
          }
        } else if (hasMethods == -1 && forceClass == 0) {
          // No methods → treat as struct (fields start at offset 0, no VMT)
          self.cg_buildStructLayout(cur);
        } else {
          // Has methods → class layout (fields at offset 8, VMT at 0)
          // #1663: der Vorlauf hat es in aller Regel schon getan.
          if (self.cg_findClass(self.cg_nsval(cur), self.cg_nslen(cur)) < 0) {
            self.cg_buildClassLayout(cur);
          }
          var clsName: pchar := self.cg_nsval(cur);
          var clsLen:  int64 := self.cg_nslen(cur);
          var method: int64 := hasMethods;
          while (method != -1) {
            var nextM: int64 := self.cg_nnext(method);
            // WP-BC-20: skip abstract methods (bit3 of iVal) — no code body
            var isAbstM: int64 := (self.cg_nival(method) >> 3) & 1;
            if (isAbstM == 0) {
              self.cg_genMethodDecl(method, clsName, clsLen);
            } else {
              // #1643: statt zu ueberspringen einen Rumpf, der sich meldet.
              self.cg_genAbstractStub(method, clsName, clsLen);
            }
            method := nextM;
          }
        }
        }
      } else if (k == CGN_STRUCT_DECL) {
        // Standalone struct declaration: register field layout (fields at offset 0)
        self.cg_buildStructLayout(cur);
      } else if (k == CGN_ENUM_DECL) {
        // BUG-08: Enum declaration: register variant layout for match analysis
        self.cg_buildEnumLayout(cur);
        // Register enum members as int64 constants (auto-increment from 0)
        var emem: int64 := self.cg_nc0(cur);
        var eVal: int64 := 0;
        while (emem != -1) {
          var evNode: int64 := self.cg_nc0(emem);
          if (evNode >= 0 && self.cg_nkind(evNode) == CGN_LIT_INT) {
            eVal := self.cg_nival(evNode);
          }
          self.cg_addCon(self.cg_nsval(emem), self.cg_nslen(emem), eVal);
          eVal += 1;
          emem := self.cg_nnext(emem);
        }
      } else if (k == CGN_VAR_DECL) {
        // Global variable: allocate 8 bytes in data section, register in global table
        // #1665: Der Vorlauf hat den Slot bereits angelegt — gIdx ist deshalb
        // der GEFUNDENE Eintrag, nicht der naechste freie.
        var doff: int64 := self.cg_addGlobal(self.cg_nsval(cur), self.cg_nslen(cur));
        var gIdx: int64 := self.cg_findGlobalIdx(self.cg_nsval(cur), self.cg_nslen(cur));
        var gtNode: int64 := self.cg_nc0(cur);
        self.cg_recordGlobalType(gIdx, gtNode);   // #1665: eine Quelle
        // #1141: @redundant an einer GLOBALEN Variablen. Bis 1.0.14M bekam sie
        // 8 Byte und keinen Voter — das Attribut war hier ein stiller Default.
        // Jetzt liegen drei Zellen hintereinander (A = doff, B, C), genau wie
        // im Rahmen bei einem Local.
        var gRedundant: int64 := (self.cg_nival(cur) & 4) != 0;
        // #1665: Der Vorlauf hat die drei Zellen bereits angelegt; ein zweites
        // Mal wuerde nur Datenbereich verschwenden und den Zaehler verfaelschen.
        if (gRedundant != 0 && peek8(self.globalIsRedundant + gIdx) == 0) {
          poke8(self.globalIsRedundant + gIdx, 1);
          var gz: int64 := 0;
          while (gz < 16) { self.cg_edata(0); gz := gz + 1; }
          self.tmrVarCount += 1;
        }
        // #1256/#1299: Ein AGGREGAT passt nicht in den 8-Byte-Slot. Es bekommt
        // einen eigenen Block im Datenbereich, der Slot einen Zeiger darauf —
        // dieselbe Form, die ein Local zur Laufzeit per mmap anlegt, nur schon
        // zur Uebersetzungszeit. Bis 1.0.16G blieb der Slot 0: `q[0] := 3`
        // schrieb nach Adresse 16 (Kopf uebersprungen) und stuerzte ab, ein
        // `s.x := 3` verpuffte, und ein Startwert fiel ersatzlos weg.
        var aggKind: int64 := 0;      // 2 = [N]T, 3 = Struct
        var aggElems: int64 := 0;
        var aggBlock: int64 := 0 - 1;
        if (gtNode >= 0 && self.cg_nkind(gtNode) == 101) {
          var gszNode: int64 := self.cg_nc1(gtNode);
          var gN: int64 := 0;
          if (gszNode >= 0 && self.cg_nkind(gszNode) == CGN_LIT_INT) { gN := self.cg_nival(gszNode); }
          if (gN <= 0 || gN > 0x1FFFFFF) {
            EPrintStr("codegen error: globales Array '"c);
            sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
            EPrintStrLn("': Elementzahl muss eine Konstante zwischen 1 und 33554431 sein"c);
            exit(1);
          }
          // Struct-Elemente traegt ein Local als ZEIGER je Slot, den es zur
          // Uebersetzungszeit nicht gibt (jedes Element bekaeme sonst ein
          // eigenes Objekt). Das ist offen und wird gemeldet, statt still
          // Nullzeiger auszuliefern — #1256 nennt den Fall.
          var gElemTy: int64 := self.cg_nc0(gtNode);
          if (gElemTy >= 0 && self.cg_nkind(gElemTy) == 60
              && self.cg_ensureStructLayout(self.cg_nsval(gElemTy), self.cg_nslen(gElemTy)) >= 0) {
            EPrintStr("codegen error: globales Array '"c);
            sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
            EPrintStrLn("': Struct-Elemente sind auf Modulebene noch nicht umgesetzt (#1256)"c);
            EPrintStrLn("  In einer fn deklarieren, oder Felder in getrennten Arrays halten."c);
            exit(1);
          }
          if (gRedundant != 0) {
            EPrintStr("codegen error: globales Array '"c);
            sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
            EPrintStrLn("': @redundant ist fuer Aggregate nicht umgesetzt (#1256)"c);
            exit(1);
          }
          // #1230: `[N][M]T` global — flach, N*M Slots, Zeilenlaenge vermerkt.
          var gRow: int64 := 0;
          if (gElemTy >= 0 && self.cg_nkind(gElemTy) == 101) {
            var gRowSz: int64 := self.cg_nc1(gElemTy);
            if (gRowSz >= 0 && self.cg_nkind(gRowSz) == CGN_LIT_INT) { gRow := self.cg_nival(gRowSz); }
            if (gRow <= 0) {
              EPrintStr("codegen error: globales Array '"c);
              sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
              EPrintStrLn("': Zeilenlaenge muss eine Konstante > 0 sein"c);
              exit(1);
            }
            poke64(self.globalArrayRow + gIdx * 8, gRow);
          }
          var gSlots: int64 := gN;
          if (gRow > 0) { gSlots := gN * gRow; }
          aggBlock := self.cg_reserveData(16 + gSlots * 8);
          // {cap,len}-Kopf, wie ihn der Lesepfad hinter `lea rcx,[rax+16]`
          // erwartet und die Bereichspruefung aus #1156 liest.
          poke64(self.data + aggBlock,     gSlots);
          poke64(self.data + aggBlock + 8, gSlots);
          self.cg_addPatch(doff, aggBlock, 0, CG_PATCH_DATA_PTR);
          poke8(self.globalIsArray + gIdx, 2);
          poke64(self.globalArraySize + gIdx * 8, gN);
          aggKind := 2; aggElems := gN;
        } else if (gtNode >= 0 && self.cg_nkind(gtNode) == 60) {
          // #1619: `var g: T := null;` ist eine REFERENZ, die bei 0 beginnt —
          // kein Objekt. Bisher bekam jede Globale mit Klassen- oder
          // Struct-Layout hier eigenen Speicher, und der Slot wurde auf dessen
          // Adresse gepatcht; die 0 aus dem Startwert wurde davon ueberschrieben.
          // `g == 0` war deshalb immer falsch, und weil #1519 die blosse
          // Deklaration abweist und `:= 0` am Typ scheitert, gab es GAR KEINEN
          // Weg zu einer nullwertigen globalen Klassenvariablen: das
          // Lazy-Init-Muster war unschreibbar.
          //
          // Ohne Startwert bleibt es beim eigenen Speicher — dort ist die
          // Globale ein Wert, und daran haengt der Bestand.
          var gInitNi: int64 := self.cg_nc1(cur);
          var gIstNull: int64 := 0;
          if (gInitNi >= 0 && self.cg_nkind(gInitNi) == CGN_LIT_NULL) { gIstNull := 1; }
          var gsci: int64 := 0 - 1;
          if (gIstNull == 0) { gsci := self.cg_ensureStructLayout(self.cg_nsval(gtNode), self.cg_nslen(gtNode)); }
          // #1619: Ohne Startwert bekam auch eine KLASSE eigenen Speicher, und
          // der Slot zeigte darauf. `g == null` war damit immer falsch, das
          // Lazy-Init-Muster lief nie in seinen Zweig und lieferte eine
          // Referenz auf ein Objekt, das nie ein Konstruktor gesehen hat —
          // still, mit Feldern voller Nullen oder Schlimmerem.
          //
          // Eine Klasse ist eine REFERENZ: ohne Zuweisung ist sie null, so wie
          // `:= null` es schon konnte. Ein STRUCT dagegen ist ein Wert und
          // behaelt seinen Speicher; daran haengt der Bestand (dt_root in
          // std/ml.lyx ist genau so gemeint).
          // #1595: hier stand cg_istStructTyp — dieselbe Verwechslung von
          // Layout und Wertsemantik. Eine Klasse ohne Methoden ist eine
          // Referenz und bekommt keinen eigenen Speicher.
          if (gsci >= 0 && self.cg_istWertStruct(gsci) == 0) { gsci := 0 - 1; }
          if (gsci >= 0 && gRedundant == 0) {
            var gssz: int64 := self.cg_classStructSize(gsci);
            aggBlock := self.cg_reserveData(gssz);
            self.cg_addPatch(doff, aggBlock, 0, CG_PATCH_DATA_PTR);
            poke8(self.globalIsArray + gIdx, 3);
            aggKind := 3;
          }
        }

        // Write initializer directly into data section
        //
        // #1164: Bis 1.0.15C stand hier `== CGN_LIT_INT`, und alles andere fiel
        // durch — ohne Rechnung, ohne Code, ohne Meldung. Der Datenbereich ist
        // genullt, das Ergebnis sah deshalb aus wie eine gewollte Null. Betroffen
        // war ausgerechnet `0 - 1`, die uebliche Schreibweise fuer negative
        // Werte, und ebenso ein Float-Startwert oder ein benannter con.
        var initNode: int64 := self.cg_nc1(cur);
        if (initNode >= 0) {
          var ik: int64 := self.cg_nkind(initNode);
          if (ik == 100 && aggKind == 0 && gRedundant == 0) {
            // #1299: `var arr: array := [10,20,30]` — der Typ nennt keine
            // Groesse, das Literal schon. Der Block wird also nach dem
            // Startwert bemessen; danach laeuft es wie bei `[N]T`.
            var lcnt: int64 := 0;
            var lel: int64 := self.cg_nc0(initNode);
            while (lel != -1) { lcnt := lcnt + 1; lel := self.cg_nnext(lel); }
            if (lcnt > 0) {
              aggBlock := self.cg_reserveData(16 + lcnt * 8);
              poke64(self.data + aggBlock,     lcnt);
              poke64(self.data + aggBlock + 8, lcnt);
              self.cg_addPatch(doff, aggBlock, 0, CG_PATCH_DATA_PTR);
              poke8(self.globalIsArray + gIdx, 2);
              poke64(self.globalArraySize + gIdx * 8, lcnt);
              aggKind := 2; aggElems := lcnt;
            }
          }
          if (ik == 100 && aggKind == 2) {
            // #1299: Array-Literal als globaler Startwert. Die Elemente stehen
            // fest, wenn sie konstant sind — dann werden sie hier in den Block
            // geschrieben, statt (wie im Ausdruckspfad) zur Laufzeit auf dem
            // Stack aufgebaut. Einen Ort, an dem eine Initialisierungssequenz
            // vor `main` liefe, gibt es fuer Globale nicht.
            var aEl: int64 := self.cg_nc0(initNode);
            var aI: int64 := 0;
            while (aEl != -1) {
              if (aI >= aggElems) {
                EPrintStr("codegen error: globales Array '"c);
                sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
                EPrintStrLn("': Startwert hat mehr Elemente als das Array"c);
                exit(1);
              }
              if (self.cg_isConstExpr(aEl) == 0) {
                EPrintStr("codegen error: globales Array '"c);
                sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
                EPrintStrLn("': Element des Startwerts ist zur Uebersetzungszeit nicht bekannt"c);
                EPrintStrLn("  Globale Startwerte muessen konstant sein; sonst in einer fn zuweisen."c);
                exit(1);
              }
              poke64(self.data + aggBlock + 16 + aI * 8, self.cg_evalConExpr(aEl));
              aI := aI + 1;
              aEl := self.cg_nnext(aEl);
            }
          } else if (ik == CGN_LIT_STR) {
            // #1164: Der Startwert ist die ADRESSE der Zeichenkette. Sie steht
            // erst fest, wenn die Codelaenge feststeht (der Datenbereich folgt
            // unmittelbar darauf), also wird der Slot vorgemerkt und in
            // cg_patchAll gefuellt — samt Basis-Relokation, damit der Zeiger
            // auch auf PE und LyxOS stimmt. Bis 1.0.15C blieb hier eine 0
            // stehen: ein Nullzeiger, der wie eine leere Zeichenkette aussieht.
            var gsOff: int64 := self.cg_addStr(self.cg_nsoff(initNode), self.cg_nslen(initNode));
            self.cg_addPatch(doff, gsOff, 0, CG_PATCH_DATA_PTR);
            if (gRedundant != 0) {
              self.cg_addPatch(doff + 8,  gsOff, 0, CG_PATCH_DATA_PTR);
              self.cg_addPatch(doff + 16, gsOff, 0, CG_PATCH_DATA_PTR);
            }
          } else if (self.cg_isConstExpr(initNode) != 0) {
            // #1151: Der Wert geht hier ohne Codeerzeugung in den Datenbereich —
            // die Kuerzung muss deshalb der Compiler selbst rechnen.
            var gRaw: int64 := self.cg_evalConExpr(initNode);
            var gInit: int64 := gRaw;
            // Ein f64-Startwert traegt IEEE-Bits; die Kuerzung auf schmale
            // Ganzzahltypen darf daran nicht drehen.
            if (ik != CGN_LIT_FLOAT) {
              gInit := self.cg_narrowConst(gRaw, self.cg_narrowKindOfTypeNode(gtNode));
            }
            poke64(self.data + doff, gInit);
            // Alle drei Kopien tragen den Anfangswert — sonst waere die Mehrheit
            // beim ersten Lesen 0 und der Initialisierer verloren.
            if (gRedundant != 0) {
              poke64(self.data + doff + 8,  gInit);
              poke64(self.data + doff + 16, gInit);
            }
          } else if (ik == CGN_CLOSURE) {
            // #1589: anonyme Funktion als globaler Startwert. Faengt sie nichts
            // ein, ist ihr Wert seit #1249 die blanke Codeadresse — also
            // genauso konstant wie der Verweis auf eine benannte Funktion, der
            // laengst geht. Die Meldung "Startwert ist zur Uebersetzungszeit
            // nicht bekannt" traf hier sachlich nicht zu.
            //
            // Der Rumpf wird hier in den Codestrom gelegt (mit Sprung
            // darueber, wie ueberall bei Lambdas); die Adresse traegt danach
            // dieselbe Patch-Art wie ein benannter Funktionsverweis.
            var glClos: int64 := self.closureCapturedCount;
            self.cg_scanClosureCaptures(self.cg_nc2(initNode), self.cg_nc0(initNode));
            var glCap: int64 := self.closureCapturedCount;
            self.closureCapturedCount := glClos;
            if (glCap != 0) {
              EPrintStr("codegen error: globale Variable '"c);
              sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
              EPrintStrLn("': die anonyme Funktion faengt Werte ein"c);
              EPrintStrLn("  Ein einfangendes Lambda lebt auf dem Heap; global gibt es dafuer keinen Ort."c);
              exit(1);
            }
            self.lastAnonName := 0;
            self.cg_genExpr(initNode);        // legt den Rumpf ab, Adresse in rax (hier tot)
            if (self.lastAnonName == 0) {
              EPrintStr("codegen error: globale Variable '"c);
              sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
              EPrintStrLn("': anonyme Funktion konnte nicht abgelegt werden"c);
              exit(1);
            }
            self.cg_addPatch(doff, self.lastAnonName, self.lastAnonNameLen, CG_PATCH_DATA_FN);
            poke8(self.globalIsFnPtr + gIdx, 1);
          } else if (ik == CGN_IDENT && self.cg_isDeclaredFunc(self.cg_nsval(initNode), self.cg_nslen(initNode)) != 0) {
            // #1574: `var gFn: fn(f64): f64 = Triple;` — der Startwert IST
            // uebersetzungszeitkonstant, nur eben eine Codeadresse. Bis 1.1.0A
            // fiel er in den Zweig darunter und wurde als "nicht bekannt"
            // gemeldet, obwohl derselbe Typ als Local seit #885 funktioniert.
            self.cg_addPatch(doff, self.cg_nsval(initNode) as int64,
                             self.cg_nslen(initNode), CG_PATCH_DATA_FN);
            poke8(self.globalIsFnPtr + gIdx, 1);
            if (gRedundant != 0) {
              self.cg_addPatch(doff + 8,  self.cg_nsval(initNode) as int64,
                               self.cg_nslen(initNode), CG_PATCH_DATA_FN);
              self.cg_addPatch(doff + 16, self.cg_nsval(initNode) as int64,
                               self.cg_nslen(initNode), CG_PATCH_DATA_FN);
            }
          } else {
            // Nicht ausrechenbar: melden statt still auf 0 stehen lassen. Eine
            // Initialisierungssequenz vor main gibt es fuer Globale nicht.
            EPrintStr("codegen error: globale Variable '"c);
            sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
            EPrintStrLn("': Startwert ist zur Uebersetzungszeit nicht bekannt"c);
            EPrintStrLn("  Globale Startwerte muessen konstant sein; sonst in einer fn zuweisen."c);
            exit(1);
          }
        }
      } else if (k == CGN_CON_DECL) {
        // #1338: bereits im Vorpass cg_collectCons eingetragen.
      } else if (k == CGN_ENUM_DECL) {
        // WP-10f: Enum-Mitglieder sind Konstanten — seit #1338 traegt sie der
        // Vorpass cg_collectCons ein, damit sie auch in einer Funktion
        // DARUEBER gelten.
      } else if (k == CGN_DIM_DECL || k == CGN_UTYPE_DECL) {
        // WP-BC-16: rein uebersetzungszeitlich; kein Code. Die Faktoren und
        // Grenzen sammelt cg_collectUtypes vorab ein (#1110).
      } else if (k == CGN_BLOCK) {
        // WP-CS-06: inlined @if branch — recurse into children
        self.cg_genFile(self.cg_nc0(cur));
      } else if (k == CGN_AT_DIRECTIVE) {  // WP-CS-07 / WP-AS-04/05 top-level
        var kind: int64 := self.cg_nival(cur);
        var val:  int64 := self.cg_nc0(cur);
        if (kind == 0) { self.ioCheckEnabled       := val; }
        if (kind == 1) { self.overflowCheckEnabled := val; }
        if (kind == 2) { self.boundsCheckEnabled   := val; }  // WP-AS-04
        if (kind == 2) { self.boundsCheckForced    := val; }  // #1124
        if (kind == 3) { self.debugMode            := val; }  // WP-AS-05
        if (kind == 4) { self.optLevel             := val; }  // WP-AS-04
      } else if (k == CGN_AT_ENERGY) {  // WP-EN-04: top-level @energy(N)
        // #1162: als Quelltext-Stand vermerken, nicht nur als aktuelle Stufe —
        // genFunc bestimmt die Stufe je Funktion neu und verwarf den Wert
        // sonst zugunsten des CLI-Flags.
        self.scopeEnergyLevel := self.cg_nival(cur);
        self.fnEnergyLevel    := self.cg_nival(cur);
      }
      cur := self.cg_nnext(cur);
    }
    // WP-BC-24: emit JMP stubs for all registered generic specializations
    var mi: int64 := 0;
    while (mi < self.monoCount) {
      var mBase: int64 := self.monoList + mi * 32;
      var mangName: pchar := peek64(mBase) as pchar;
      var mangLen:  int64 := peek64(mBase + CG_MONO_OFF_MANGLEN);
      var origName: pchar := peek64(mBase + CG_MONO_OFF_ORIGPTR) as pchar;
      var origLen:  int64 := peek64(mBase + CG_MONO_OFF_ORIGLEN);
      // Emit label for mangled name, then JMP rel32 to the generic function
      self.cg_addLabel(mangName, mangLen, 0);  // generic specialization: no direct line
      self.cg_e8(0xE9);
      self.cg_addPatch(self.codeLen, origName as int64, origLen, CG_PATCH_CALL);
      self.cg_e32(0);
      mi += 1;
    }
    // #1140: Restorer und SIGFPE-Handler ans Ende des Codes — nur wenn das
    // Programm ueberhaupt eine @flight_crit-Funktion hat.
    if (self.fcSeen != 0) { self.cg_fcEmitHandler(); }
  }

