        } else { self.cg_zeroRax(); }
      } else if (self.cg_tryFold(ni) != 0) {
        self.cg_movRaxImm(self.foldBuf);
      } else {
      self.cg_genExpr(self.cg_nc0(ni));
      if (op == CGT_MINUS) {
        if (self.cg_isF64Expr(self.cg_nc0(ni)) != 0) {
          // f64 sign-bit flip: btc rax, 63  (48 0F BA F8 3F)
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBA); self.cg_e8(0xF8); self.cg_e8(63);
        } else {
          self.cg_negRax();
        }
      } else if (op == CGT_NOT) {
        // logical not: rax = (rax == 0) ? 1 : 0
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x0F); self.cg_e8(0x94); self.cg_e8(0xC0);  // sete al
        self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
      } else if (op == CGT_BITNOT) {
        self.cg_notRax();
      }
      }  // end else (not const-foldable)

    } else if (k == CGN_NAMED_ARG) {
      // WP-MEM-05: named arg in an expression context — evaluate the value (c0)
      self.cg_genExpr(self.cg_nc0(ni));

    } else if (k == CGN_CALL) {
      self.cg_genCall(ni);

    } else if (k == CGN_CALL_PTR) {
