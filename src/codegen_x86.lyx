con ELF64_PHDR_OFF_OFFSET:  int64 := 8;
con ELF64_PHDR_OFF_VADDR:   int64 := 16;
con ELF64_PHDR_OFF_PADDR:   int64 := 24;
con ELF64_PHDR_OFF_FILESZ:  int64 := 32;
con ELF64_PHDR_OFF_MEMSZ:   int64 := 40;
con ELF64_PHDR_OFF_ALIGN:   int64 := 48;

