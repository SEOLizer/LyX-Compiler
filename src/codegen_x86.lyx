          self.cg_e8(0x5E);  // pop rsi
          self.cg_e8(0x5F);  // pop rdi
          self.cg_e8(0x59);  // pop rcx
          // rdi=src1, rsi=src2, rdx=dst, rcx=count → inline SSE2 loop
          // #2205: ab Stufe avx2 der 256-Bit-Pfad. Ohne die Zusage bleibt
          // es bei 128 Bit — ein VEX-Praefix auf einer aelteren CPU endet
          // in SIGILL, und ein stiller Rueckfall waere hier genau falsch:
          // der Code liefe, waere aber langsamer als zugesagt (#2191).
          if (self.cg_cpuHat(2) != 0) { self.cg_emitAVX2BinOp(op, simdOpKennung); }
          else                        { self.cg_emitSSE2BinOp(op, simdOpKennung); }
          // rax = result SIMD ptr
        } else {
          // idents but not SIMD — general path
          if (self.cg_binOpLocalRechts(op, lhsNi, rhsNi) == 0) {   // #2114
          self.cg_lhsRhsNachRbxRax(lhsNi, rhsNi);   // #2114
          if self.cg_isF64Expr(lhsNi) != 0 || self.cg_isF64Expr(rhsNi) != 0 {
            self.cg_emitMixedToF64(lhsNi, rhsNi);   // #1212
            self.cg_emitF64BinOp(op);
          } else {
            self.cg_emitBinOp(op, self.cg_isUnsignedExpr(lhsNi),
                          self.cg_isUnsignedExpr(lhsNi) | self.cg_isUnsignedExpr(rhsNi));
          }
          }
        }
      } else {
        // General: eval LHS, push; eval RHS; pop rbx
        // #2114: rechts ein einfaches Local und beide Seiten ganzzahlig —
        // dann als Speicheroperand, ohne push/pop (cg_binOpLocalRechts).
        if (self.cg_binOpLocalRechts(op, lhsNi, rhsNi) == 0) {
        self.cg_lhsRhsNachRbxRax(lhsNi, rhsNi);   // #2114
        if self.cg_isF64Expr(lhsNi) != 0 || self.cg_isF64Expr(rhsNi) != 0 {
          self.cg_emitMixedToF64(lhsNi, rhsNi);   // #1212
          self.cg_emitF64BinOp(op);
        } else {
          self.cg_emitBinOp(op, self.cg_isUnsignedExpr(lhsNi),
                          self.cg_isUnsignedExpr(lhsNi) | self.cg_isUnsignedExpr(rhsNi));
        }
        }
      }

    } else if (k == CGN_UNOP) {
      var op: int64 := self.cg_nival(ni);
      // WP-10g: fold constant unary expressions
      if (op == 111) {
        // @ident — address-of: lea rax, [rbp+off]
        var inner0: int64 := self.cg_nc0(ni);
        if (inner0 >= 0 && self.cg_nkind(inner0) == CGN_IDENT) {
          var iname0: pchar := self.cg_nsval(inner0);
          var ilen0:  int64 := self.cg_nslen(inner0);
          var ioff0:  int64 := self.cg_findLocal(iname0, ilen0);
          self.cg_rlNichtImRegister(ioff0, "Adresse eines Locals (@x)"c);   // #2114
          if (ioff0 != 0) {
            // WP-B1: @redundant vars → return address of slot A (off-16, lowest addr)
            var addrOff0: int64 := ioff0;
            var iridx0: int64 := self.cg_findLocalIdx(iname0, ilen0);
            if (iridx0 >= 0 && self.cg_isLocalRedundant(iridx0) != 0) {
              addrOff0 := ioff0 - 16;
              self.cg_tmrBypassAt(iname0, ilen0);   // #1141
            }
            if (addrOff0 >= -128 && addrOff0 <= -1) {
              self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x45); self.cg_e8(addrOff0);
            } else {
              self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x85); self.cg_e32(addrOff0);
            }
          } else {
            // #2116: Modulvariable — lea rax, [rip+disp32], derselbe Patch wie
            // cg_loadRaxGlobal (die beiden muessen uebereinstimmen). Bis
            // 1.2.14B stand hier cg_zeroRax: `poke64(@g, 42)` schrieb nach 0.
            var goffA: int64 := self.cg_findGlobal(iname0, ilen0);
            if (goffA < 0) {
              EPrintStr("error: Adresse-von `@"c);
              sys_write(2, iname0 as int64, ilen0);
              EPrintStrLn("`: kein Local, Parameter oder Modulvariable (#2116)."c);
              exit(1);
            }
            if (self.cg_isGlobalRedundant(self.cg_findGlobalIdx(iname0, ilen0)) != 0) {
              self.cg_tmrBypassAt(iname0, ilen0);   // #1141, wie beim Local
            }
            self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
            var ppA: int64 := self.codeLen;
            self.cg_e32(0);
            self.cg_addPatch(ppA, goffA, 0, CG_PATCH_STR);
          }
        } else {
          // #2116: `@` auf etwas anderes als einen Namen lieferte still 0.
          EPrintStr("error: Adresse-von `@` nur auf einen Namen (Local, Parameter, Modulvariable) — Knotenart "c);
          var inK0: int64 := 0 - 1;
          if (inner0 >= 0) { inK0 := self.cg_nkind(inner0); }
          EPrintInt(inK0);
          EPrintStrLn(" (#2116)."c);
          exit(1);
        }
      } else if (self.cg_tryFold(ni) != 0) {
        self.cg_movRaxImm(self.foldBuf);
      } else if (self.cg_istSimdAusdruck(self.cg_nc0(ni)) != 0) {
        self.cg_genSimdUnop(op, self.cg_nc0(ni));   // #2222
      } else {
      self.cg_genExpr(self.cg_nc0(ni));
      if (op == CGT_MINUS) {
        if (self.cg_isF64Expr(self.cg_nc0(ni)) != 0) {
          // f64 sign-bit flip: btc rax, 63  (48 0F BA F8 3F)
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBA); self.cg_e8(0xF8); self.cg_e8(63);
        } else {
          self.cg_negRax();
        }
      } else if (op == CGT_NOT) {
        // logical not: rax = (rax == 0) ? 1 : 0
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x0F); self.cg_e8(0x94); self.cg_e8(0xC0);  // sete al
        self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
      } else if (op == CGT_BITNOT) {
        self.cg_notRax();
      }
      }  // end else (not const-foldable)

    } else if (k == CGN_NAMED_ARG) {
      // WP-MEM-05: named arg in an expression context — evaluate the value (c0)
      self.cg_genExpr(self.cg_nc0(ni));

    } else if (k == CGN_CALL) {
      self.cg_genCall(ni);

    } else if (k == CGN_CALL_PTR) {
      // #1505: Aufruf ueber einen berechneten Zeiger (`tabelle[i](args)`).
      // Derselbe duenne Aufruf wie beim Funktionszeiger in einer Variablen —
      // nur steht die Adresse hier in einem Ausdruck, nicht in einem Local.
      // Reihenfolge: erst die Argumente (sie duerfen selbst rufen und dabei
      // rbx zerstoeren), dann die Adresse, dann die Register fuellen.
      // Ein Funktionsname mit eckiger Klammer ist KEIN Zeigeraufruf, sondern
      // der generische Aufruf in falscher Schreibweise (`mx[int64](a, b)`).
      // Ohne diese Pruefung waere aus dem lauten Fehler von #1053 ein stiller
      // Default geworden: der Codegen haette den Funktionsnamen indiziert.
      var cpBasis: int64 := self.cg_nc0(ni);
      if (cpBasis >= 0 && self.cg_nkind(cpBasis) == CGN_INDEX) {
        var cpB0: int64 := self.cg_nc0(cpBasis);
        if (cpB0 >= 0 && self.cg_nkind(cpB0) == CGN_IDENT) {
          if ((self.cg_findLocal(self.cg_nsval(cpB0), self.cg_nslen(cpB0)) == 0
               && self.cg_isDeclaredFunc(self.cg_nsval(cpB0), self.cg_nslen(cpB0)) != 0)
              || self.cg_nestIdx(cpB0) >= 0) {   // #2044: auch eine innere Funktion
            EPrintStr("error: '"c);
            sys_write(2, self.cg_nsval(cpB0) as int64, self.cg_nslen(cpB0));
            EPrintStrLn("' ist eine Funktion — eckige Klammern indizieren, sie rufen nicht generisch auf"c);
            EPrintStrLn("  Generischer Aufruf wird spitz geschrieben: f<T>(a, b)"c);
            exit(1);
          }
        }
      }
      // #2084: sechs Register, Rest Stapel — wie beim direkten Aufruf.
      var cpN: int64 := self.cg_indirektStapelArgs(self.cg_nc1(ni), 6);
      var cpArgc: int64 := self.cg_indirektRegArgs(self.cg_nc1(ni), 6);
      self.cg_genExpr(self.cg_nc0(ni));                       // rax = Codeadresse
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC3);   // mov rbx, rax
      if (cpArgc >= 6) { self.cg_e8(0x41); self.cg_e8(0x59); }  // pop r9
      if (cpArgc >= 5) { self.cg_e8(0x41); self.cg_e8(0x58); }  // pop r8
      if (cpArgc >= 4) { self.cg_popRcx(); }
      if (cpArgc >= 3) { self.cg_popRdx(); }
      if (cpArgc >= 2) { self.cg_popRsi(); }
      if (cpArgc >= 1) { self.cg_popRdi(); }
      self.cg_e8(0xFF); self.cg_e8(0xD3);                     // call rbx
      self.cg_popStackArgs(cpN);                              // #2084
      return;
    } else if (k == CGN_NEW) {
      // #1255: `new T[n]` — Laenge erst zur LAUFZEIT bekannt (iVal-Bit 8, die
      // Anzahl steht in c1). Ohne diesen Zweig fiel die Form in den Pfad
      // darunter und belegte die feste Instanzgroesse von 4096 Byte: ab 512
      // Elementen schrieb der Zugriff hinter die Belegung (SIGSEGV), und der
      // {cap,len}-Kopf blieb leer, weshalb `len(a)` still 0 meldete.
      if ((self.cg_nival(ni) & 8) != 0) {
        var nurCap: int64 := 0;
        if ((self.cg_nival(ni) & 32) != 0) { nurCap := 1; }   // #1508
        self.cg_genArrayNewEx(self.cg_nc1(ni), nurCap);
        return;
      }
      // #1506: `new T` ohne Klammern. Bei einer Klasse ist das `new T()` — der
      // Pfad darunter, mit leerer Argumentliste. Bei allem anderen ein
      // Einzelwert, also `new T[1]`: der Codegen kennt hier die Klassenliste,
      // der Parser konnte das nicht entscheiden.
      if ((self.cg_nival(ni) & 16) != 0) {
        if (self.cg_findClass(self.cg_nsval(ni), self.cg_nslen(ni)) < 0) {
          self.cg_genArrayNewEins();
          return;
        }
      }
      // new T() — Objekt aus dem Bump-Allokator (#1836).
      var tname: pchar := self.cg_nsval(ni);
      var tlen:  int64 := self.cg_nslen(ni);
      var ciNew: int64 := self.cg_findClass(tname, tlen);
      self.cg_emitNewBump(ciNew);
      var isStructNew: int64 := 0;
      if (ciNew >= 0) {
        var vmtChk: int64 := peek64(self.classLayouts + ciNew * CG_CLASS_SZ + CG_CLASS_OFF_VMTOFF);
        if (vmtChk == -1) { isStructNew := 1; }
      }
      if (isStructNew == 0) {
        // WP-10a: rax = object ptr; write VMT pointer at [rax+0]
        // mov rcx, imm64 (placeholder = 0, patched later with VMT vaddr)
        self.cg_e8(0x48); self.cg_e8(0xB9);
        var vmtPatchPos: int64 := self.codeLen;
        self.cg_e64(0);                                         // 8-byte placeholder
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x08); // mov [rax], rcx
        // Record patch: fill in VMT address for this class at vmtPatchPos
        self.cg_addVmtPatch(vmtPatchPos, tname, tlen);
      }

      // #1636: Ein inline liegendes `[N]Struct`-FELD hat Zeiger-Slots — so
      // legt der Deklarationspfad ein `[N]Struct` seit #1109 an, und der
      // Lesepfad laedt entsprechend den Zeiger. Fuer ein FELD hat sie nie
      // jemand gefuellt: die Slots blieben 0, und `c.items[0].x := 10`
      // schrieb nach Adresse 0. Eine LOKALE Variable desselben Typs
      // funktionierte, weil sie ihre Objekte bekommt — dieselbe Sorte Luecke
      // wie #1109 selbst, nur eine Ebene weiter.
      //
      // Die Objekte entstehen hier, unmittelbar nach dem VMT-Zeiger und VOR
      // dem Konstruktor: der darf die Felder bereits benutzen.
      if (ciNew >= 0) {
        var fBase: int64 := self.classLayouts + ciNew * CG_CLASS_SZ;
        var fFlds: int64 := peek64(fBase + CG_CLASS_OFF_FIELDSPTR);
        var fCnt:  int64 := peek64(fBase + CG_CLASS_OFF_FIELDCNT);
        var fI: int64 := 0;
        while (fI < fCnt && fFlds != 0) {
          var ffb: int64 := fFlds + fI * CG_CFIELD_SZ;
          var ffl: int64 := peek64(ffb + CG_CFIELD_OFF_FLAGS);
          // Bit3 = inline `[N]T`; Elementtyp seit #1493 im Feldeintrag.
          if (((ffl >> 3) & 1) != 0) {
            var epP: pchar := peek64(ffb + CG_CFIELD_OFF_ELEMTYPEPTR) as pchar;
            var epL: int64 := peek64(ffb + CG_CFIELD_OFF_ELEMTYPELEN);
            if (epP != 0 as pchar && epL > 0) {
              var eci: int64 := self.cg_findClass(epP, epL);
              // #1646: Nur STRUCT-Elemente brauchen ein vorbelegtes Objekt je
              // Slot. Bei Klassenelementen legt der Aufrufer die Objekte an und
              // schreibt den Zeiger hinein — ein hier belegtes Objekt waere im
              // selben Augenblick verloren.
              if (eci >= 0 && self.cg_istStructTyp(eci) == 0) { eci := 0 - 1; }
              if (eci >= 0) {
                var fOff: int64 := peek64(ffb + CG_CFIELD_OFF_OFFSET);
                var fBytes: int64 := peek64(ffb + CG_CFIELD_OFF_BYTES);
                var nSlots: int64 := fBytes / 8;
                if (nSlots > 0) {
                  // Schleife zur LAUFZEIT, nicht entrollt — ein [1000]S haette
                  // sonst tausend Kopien derselben Befehlsfolge im Code.
                  // [rsp+8] = Objektzeiger, [rsp] = i
                  self.cg_pushRax();
                  self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);   // xor rax, rax
                  self.cg_pushRax();
                  var slotTop: int64 := self.codeLen;
                  self.cg_movRaxImm(0);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);
                  self.cg_movRaxImm(4096); self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);
                  self.cg_movRaxImm(3);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2);
                  self.cg_movRaxImm(34);
                  self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);   // mov r10, rax
                  self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0);   // xor r8, r8
                  self.cg_e8(0x49); self.cg_e8(0xFF); self.cg_e8(0xC8);   // dec r8 → -1
                  self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);   // xor r9, r9
                  self.cg_movRaxImm(9);
                  self.cg_e8(0x0F); self.cg_e8(0x05);                     // syscall
                  // rbx = Objekt, rcx = i, Ziel = [rbx + fOff + rcx*8]
                  self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x5C); self.cg_e8(0x24); self.cg_e8(0x08);
                  self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x0C); self.cg_e8(0x24);
                  self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x84); self.cg_e8(0xCB); self.cg_e32(fOff);
                  // i := i + 1; solange i < nSlots
                  self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC1);
                  self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x0C); self.cg_e8(0x24);
                  self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xF9); self.cg_e32(nSlots);
                  self.cg_e8(0x0F); self.cg_e8(0x8C);                     // jl slotTop
                  self.cg_e32(slotTop - (self.codeLen + 4));
                  self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x08);  // add rsp, 8 (i)
                  self.cg_popRax();                                        // Objektzeiger zurueck
                }
              }
            }
          }
          fI := fI + 1;
        }
      }

      // #683: Call ClassName_Create(self, args...) if defined
      // #1624: der Konstruktor darf aus einer Basisklasse stammen.
      var ctorLC: int64 := alloc(8);
      var ctorMangBuf: int64 := 0;
      if (ciNew >= 0) { ctorMangBuf := self.cg_findInheritedMangled(ciNew, "Create"c, 6, ctorLC); }
      var ctorMangLen: int64 := peek64(ctorLC);
      free(ctorLC, 8);
      if (ctorMangBuf != 0) {
        self.cg_pushRax();                 // save obj ptr
        self.cg_pushRax();                 // push self (first arg)
        var ctorArg: int64 := self.cg_nc0(ni);
        var ctorArgc: int64 := 1;
        while (ctorArg != -1) {
          self.cg_genExpr(ctorArg);
          self.cg_pushRax();
          ctorArgc += 1;
          ctorArg := self.cg_nnext(ctorArg);
        }
        if (ctorArgc >= 6) { self.cg_e8(0x41); self.cg_e8(0x59); }  // pop r9
        if (ctorArgc >= 5) { self.cg_e8(0x41); self.cg_e8(0x58); }  // pop r8
        if (ctorArgc >= 4) { self.cg_popRcx(); }
        if (ctorArgc >= 3) { self.cg_popRdx(); }
        if (ctorArgc >= 2) { self.cg_popRsi(); }
        if (ctorArgc >= 1) { self.cg_popRdi(); }
        var ctorPP: int64 := self.cg_emitCall();
        self.cg_addPatch(ctorPP, ctorMangBuf, ctorMangLen, CG_PATCH_CALL);
        self.cg_trackTempBuf(ctorMangBuf, ctorMangLen + 1);
        self.cg_popRax();                  // restore obj ptr
      }

    } else if (k == CGN_FIELD) {
      self.cg_genFieldLoad(ni);

    } else if (k == CGN_INDEX && self.cg_tryClassIndex(ni) != 0) {
      // operator overloading: base[idx] → base.Get(idx) for a class-typed base
      // (emitted by cg_tryClassIndex; result in rax).
    } else if (k == CGN_INDEX && self.cg_localIsMap(self.cg_nc0(ni)) != 0) {
      // #1152: m[k] auf einer Map liest ueber _lyx_map_get. Bis 1.0.15A lief
      // der Zugriff durch den Array-Zweig: er nahm den Map-Zeiger als
      // Array-Basis und lieferte still eine ADRESSE statt des Wertes.
      self.cg_genExpr(self.cg_nc1(ni));                        // rax = key
      self.cg_pushRax();
      self.cg_genExpr(self.cg_nc0(ni));                        // rax = map
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);   // mov rdi, rax
      self.cg_e8(0x5E);                                        // pop rsi (key)
      // #1291: Bei einer Map mit Zeichenketten-Schluesseln uebernimmt
      // _lyx_map_str (Modus 1 = lesen); sonst bleibt es beim Zahlenvergleich.
      if (self.cg_isStrKeyMap(self.cg_nc0(ni)) != 0) {
        self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1);
        self.cg_e32(1);                                        // mov rcx,1 (lesen)
        var ppMGs: int64 := self.cg_emitCall();
        poke32(self.code + ppMGs, CG_H_MAP_STR - ppMGs - 4);
      } else {
        var ppMG: int64 := self.cg_emitCall();
        poke32(self.code + ppMG, CG_H_MAP_GET - ppMG - 4);
      }

    } else if (k == CGN_INDEX) {
      // arr[i]: nc0=arr, nc1=index
      // Eval index first, push; then eval arr; pop index into rbx
      self.cg_genExpr(self.cg_nc1(ni));   // rax = index
      self.cg_pushRax();
      // #1052: inline `[N]T`-Feld — Adresse statt Inhalt laden.
      var rdInlW: int64 := self.cg_emitInlineArrayAddr(self.cg_nc0(ni));
      if (rdInlW == 0) { self.cg_genExpr(self.cg_nc0(ni)); }   // rax = array ptr
      self.cg_popRbx();                    // rbx = index
      if (rdInlW > 0) {
        self.cg_emitScaledLoadRax(rdInlW);
        return;
      }
      var baseNode: int64 := self.cg_nc0(ni);
      var isPchar:  int64 := 0;
      var isArray:  int64 := 0;
      var isSimd:   int64 := 0;
      var isSimdFloat: int64 := 0;   // #2183
      var simdBytes: int64 := 4;     // #2199: Elementbreite der SIMD-Ablage
      var arrElemClassIdx: int64 := -1;
      var arrElemSize: int64 := 8;
      var arrFixedSize: int64 := 0;   // #1156: 0 = zur Uebersetzungszeit unbekannt
      // #1230: Zeilenlaenge M eines `[N][M]T`. rowOuter > 0 heisst: dieser
      // Zugriff waehlt eine ZEILE und liefert deren Adresse. rowInner > 0
      // heisst: die Basis IST bereits eine Zeilenadresse — kein Kopf, feste
      // Schrittweite 8, Schranke ist die Zeilenlaenge.
      var rowOuter: int64 := 0;
      var rowInner: int64 := 0;
      if (self.cg_nkind(baseNode) == CGN_INDEX) {
        var rowBase: int64 := self.cg_nc0(baseNode);
        if (self.cg_nkind(rowBase) == CGN_IDENT) {
          var rbn: pchar := self.cg_nsval(rowBase);
          var rbl: int64 := self.cg_nslen(rowBase);
          var rbLi: int64 := self.cg_findLocalIdx(rbn, rbl);
          if (rbLi >= 0) {
            rowInner := peek64(self.localArrayRow + rbLi * 8);
          } else {
            var rbGi: int64 := self.cg_findGlobalIdx(rbn, rbl);
            if (rbGi >= 0) { rowInner := peek64(self.globalArrayRow + rbGi * 8); }
          }
        }
      }
      if (self.cg_nkind(baseNode) == CGN_IDENT) {
        var bname: pchar := self.cg_nsval(baseNode);
        var blen:  int64 := self.cg_nslen(baseNode);
        var lidx: int64 := self.cg_findLocalIdx(bname, blen);
        if (lidx >= 0) {
          // #1155: nur eine FESTE Groesse ist eine Schranke (Flag 2).
          if (peek8(self.localIsArray + lidx) == 2) {
            arrFixedSize := peek64(self.localArraySize + lidx * 8);
            rowOuter := peek64(self.localArrayRow + lidx * 8);   // #1230
          }
          // WP-GPU-01: check SIMD flag first
          if (peek8(self.localIsSimd + lidx) != 0) { isSimd := 1; }
          if (isSimd == 1) { simdBytes := self.cg_simdBytesOf(lidx); }   // #2199
          // #2183: Gleitkomma-Elemente brauchen die Umrechnung f32 <-> f64,
          // Ganzzahl-Elemente nicht.
          if (isSimd == 1 && peek8(self.localElemFloat + lidx) != 0) { isSimdFloat := 1; }
          var tb: int64 := self.localTypes + lidx * CG_LOCTYPE_SZ;
          var tp: pchar := peek64(tb) as pchar;
          var tn: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
          if (tn == 5 && self.cg_seq(tp, tn, "pchar", 5)) { isPchar := 1; }
          if (peek8(self.localIsArray + lidx) != 0) {
            isArray := 1;
            // Check for struct element type in localTypes (stored for Array<T> locals)
            if (tp != 0 as pchar && tn > 0) {
              var eClassIdx: int64 := self.cg_findClass(tp, tn);
              if (eClassIdx >= 0) {
                arrElemClassIdx := eClassIdx;
                arrElemSize := self.cg_classStructSize(eClassIdx);
              }
            }
          }
        } else {
          var gidx: int64 := self.cg_findGlobalIdx(bname, blen);
          if (gidx >= 0 && peek8(self.globalIsPchar + gidx) != 0) { isPchar := 1; }
          // #1256: ein globales `[N]T` traegt denselben {cap,len}-Kopf wie ein
          // lokales. Ohne diesen Zweig fiel es in den Zweig "roher Zeiger" und
          // las 16 Byte zu frueh — also den Kopf statt der Elemente.
          if (gidx >= 0 && peek8(self.globalIsArray + gidx) == 2) {
            isArray := 1;
            arrFixedSize := peek64(self.globalArraySize + gidx * 8);
            rowOuter := peek64(self.globalArrayRow + gidx * 8);   // #1230
          }
          // #2078: dynamisches globales Array — Kopf ueberspringen, Groesse
          // zur Laufzeit, wie beim Local.
          if (gidx >= 0 && peek8(self.globalIsArray + gidx) == 1) { isArray := 1; }
        }
      } else if (self.cg_nkind(baseNode) == CGN_FIELD) {
        // Class field: check if it's Array<StructType>
        var innerObj: int64 := self.cg_nc0(baseNode);
        var fldNm: pchar := self.cg_nsval(baseNode);
        var fldNl: int64 := self.cg_nslen(baseNode);
        var parentCi: int64 := self.cg_objClassIdx(innerObj);
        var eClassIdx: int64 := self.cg_getFieldElemClassIdx(parentCi, fldNm, fldNl);
        if (eClassIdx >= 0) {
          isArray := 1;
          arrElemClassIdx := eClassIdx;
          arrElemSize := self.cg_classStructSize(eClassIdx);
        } else if (self.cg_isFieldArray(parentCi, fldNm, fldNl) != 0) {
          isArray := 1;
          // arrElemSize bleibt 8 (scalar Array<int64> etc.)
        }
      }
      // #2131: pchar ist nicht nur ein Bezeichner. Ein pchar-FELD, ein
      // `x as pchar`, ein Aufruf mit pchar-Rueckgabe und ein Literal fielen
      // in den Zweig "roher Zeiger" und lasen 8 Byte statt eines Zeichens.
      // Massgeblich ist dieselbe Auskunft, nach der `+` verkettet
      // (cg_isPcharExpr) — die beiden muessen uebereinstimmen.
      if (isPchar == 0 && isArray == 0 && isSimd == 0 && rowInner == 0 && rowOuter == 0
          && self.cg_isPcharExpr(baseNode) != 0) {
        isPchar := 1;
      }
      // #1156: Bereichspruefung, bevor gelesen wird. Nur fuer Arrays — ein
      // pchar oder ein roher Zeiger traegt keine Laenge.
      if (rowInner > 0) {
        // #1230: `m[i][j]` — die Basis ist die Adresse der Zeile i. Geprueft
        // wird gegen die Zeilenlaenge; ohne die Schranke waere der zweite
        // Index der einzige unbewachte Zugriff im Array-Pfad.
        self.cg_emitIndexBoundsCheck(rowInner, 0);
        // mov rax, [rax+rbx*8]
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0xD8);
        return;
      }
      if (isArray == 1) { self.cg_emitIndexBoundsCheck(arrFixedSize, 1); }
      if (rowOuter > 0) {
        // #1230: `m[i]` waehlt eine Zeile. Das Layout ist flach, die Zeile
        // beginnt also bei Kopf + i*M*8; geliefert wird ihre ADRESSE, denn
        // eine Zeile ist kein Wert, der in ein Register passt.
        // lea rcx, [rax+16]
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x48); self.cg_e8(0x10);
        // imul rbx, rbx, rowOuter*8
        var rowBytes: int64 := rowOuter * 8;
        if (rowBytes <= 127) {
          self.cg_e8(0x48); self.cg_e8(0x6B); self.cg_e8(0xDB); self.cg_e8(rowBytes);
        } else {
          self.cg_e8(0x48); self.cg_e8(0x69); self.cg_e8(0xDB); self.cg_e32(rowBytes);
        }
        // lea rax, [rcx+rbx]
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x04); self.cg_e8(0x19);
        return;
      }
      // #2247: Ganzzahl-Elemente — die Breite entscheidet den Ladebefehl, und
      // gelesen wird VORZEICHENERWEITERT. Das ist dieselbe Bedeutung, die
      // peek8/peek16/peek32 tragen (#2300: int32 erweitert mit Vorzeichen),
      // und das Gegenstueck zum Schreibpfad, der nur die Breite selbst
      // ablegt. Bis 1.2.24D lief JEDE Ganzzahlart ueber den f32-Zweig
      // darunter: Schrittweite 4 und das rohe 32-Bit-Muster. Gemessen hiess
      // das `c[2] = 0` bei int8/int16 (gelesen an der falschen Stelle) und
      // `127 + 1 = 128` statt -128 (keine Abschneidung). int32 war richtig,
      // WEIL seine Schrittweite der f32-Annahme entspricht — ein einziger
      // gruener Fall belegt hier nichts.
      if (isSimd == 1 && isSimdFloat == 0) {
        if (simdBytes == 1) {
          // movsx rax, byte [rax+rbx]   (48 0F BE 04 18)
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBE); self.cg_e8(0x04); self.cg_e8(0x18);
        } else if (simdBytes == 2) {
          // movsx rax, word [rax+rbx*2] (48 0F BF 04 58)
          self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBF); self.cg_e8(0x04); self.cg_e8(0x58);
        } else if (simdBytes == 4) {
          // movsxd rax, dword [rax+rbx*4] (48 63 04 98)
          self.cg_e8(0x48); self.cg_e8(0x63); self.cg_e8(0x04); self.cg_e8(0x98);
        } else {
          // mov rax, qword [rax+rbx*8]  (48 8B 04 D8)
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0xD8);
        }
      } else if (isSimd == 1 && simdBytes == 8) {
        // #2199: `parallel Array<f64>[i]` — 8 Byte Schrittweite, movsd, KEINE
        // Umrechnung. Bis 1.2.19F lief dieser Fall ueber den f32-Pfad: die
        // Ablage hielt 32 Bit, und erst beim Lesen machte cvtss2sd daraus
        // wieder ein f64. Runde Werte ueberlebten das (1.5, 2.25), 0.1 nicht
        // (0.10000000149011612), 1e40 wurde inf und 1e-50 null.
        //
        // movsd xmm0, [rax+rbx*8]  (F2 0F 10 04 D8)
        self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x10); self.cg_e8(0x04); self.cg_e8(0xD8);
        // movq rax, xmm0  (66 48 0F 7E C0)
        self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC0);
      } else if (isSimd == 1) {
        // WP-GPU-01: parallel Array<f32>[i] — 4-byte stride, no header, SSE2 movss
        // rax=base ptr, rbx=index
        // movss xmm0, [rax+rbx*4]  (F3 0F 10 04 98)
        self.cg_e8(0xF3); self.cg_e8(0x0F); self.cg_e8(0x10); self.cg_e8(0x04); self.cg_e8(0x98);
        if (isSimdFloat == 1) {
          // #2183: aus den f32-Bits wird ein f64-WERT. Hier stand nur
          // `movd rax, xmm0`, also das rohe f32-Bitmuster — jeder Leser
          // (Arithmetik, `as int64`, Print) behandelt den Wert aber als f64.
          // Dieselbe Umrechnung wie im lyxos-Backend (emit_lyxos.lyx, CVTSS2SD);
          // die beiden muessen uebereinstimmen. Gegenstueck ist der
          // Schreibpfad in cg_genStmt (cvtsd2ss) — auch die beiden muessen
          // uebereinstimmen, sonst liest man anders, als man geschrieben hat.
          // cvtss2sd xmm0, xmm0  (F3 0F 5A C0)
          self.cg_e8(0xF3); self.cg_e8(0x0F); self.cg_e8(0x5A); self.cg_e8(0xC0);
          // movq rax, xmm0  (66 48 0F 7E C0)
          self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC0);
        } else {
          // Ganzzahl-Elemente (`parallel Array<int64>` u. a.): weiter das rohe
          // 32-Bit-Muster. Die Schrittweite dieser Ablage ist 4 Byte, ein
          // int64-Element passt also ohnehin nicht hinein — das ist eine
          // eigene Luecke und wird hier nicht still mitgeaendert.
          // movd eax, xmm0  (66 0F 7E C0)
          self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC0);
        }
      } else if (isPchar == 1) {
        // movzx rax, byte [rax+rbx]
        self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0x04); self.cg_e8(0x18);
      } else if (isArray == 1 && arrElemSize > 8 && arrFixedSize == 0) {
        // #1109: NUR fuer `Array<T>` mit Struct-Elementen, die INLINE liegen.
        // Ein `T[N]` belegt N*8 Byte — Zeiger-Slots, wie die Struct-Zuweisung
        // sonst auch: `arr[i] := s` teilt das Objekt mit `s`. Dort muss der
        // Zeiger GELADEN werden; die Elementadresse zu liefern wuerde die
        // Ablage und den Zugriff auseinanderlaufen lassen.
        // Struct array: return element ADDRESS (not value)
        // lea rcx, [rax+16]  (skip {cap,len} header)
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x48); self.cg_e8(0x10);
        // imul rbx, rbx, arrElemSize  (index * element size)
        if (arrElemSize <= 127) {
          self.cg_e8(0x48); self.cg_e8(0x6B); self.cg_e8(0xDB); self.cg_e8(arrElemSize);
        } else {
          self.cg_e8(0x48); self.cg_e8(0x69); self.cg_e8(0xDB); self.cg_e32(arrElemSize);
        }
        // lea rax, [rcx+rbx]  (element address)
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x04); self.cg_e8(0x19);
      } else if (isArray == 1) {
        // Scalar array<T>: skip 16-byte {cap,len} header, then 8-byte stride
        // lea rcx, [rax+16]
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x48); self.cg_e8(0x10);
        // mov rax, [rcx+rbx*8]
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0xD9);
      } else {
        // #2131: Basis ohne Elementtyp (weder Array noch pchar noch Klasse
        // mit Get) — LAUT. Hier stand ein Zweig "roher Zeiger" mit
        // Nullpruefung, dessen `jnz +7` zwei Byte zu weit sprang: er landete
        // mitten im `mov rax,[rax+rbx*8]` und fuehrte `add al, 0xD8` aus.
        // Geliefert wurde also der Zeiger selbst (unteres Byte verschoben),
        // unabhaengig vom Index. Gemessen: kein einziger Treffer im Bestand
        // (std, src/std, examples, tests, Compiler) — nichts Legitimes faellt
        // hier durch. Ein Byte ist `peek8(p + i)`, ein Wort `peek64(p + i * 8)`.
        EPrintStrLn("error: codegen: Indexzugriff auf einen Ausdruck ohne Elementtyp (weder Array noch pchar) — Byte: peek8(p + i), Wort: peek64(p + i * 8) (#2131)"c);
        exit(1);
      }

    } else if (k == CGN_LIT_FLOAT) {
      // WP-11: float literal — parse IEEE 754 bits and load as immediate
      var floatBits: int64 := self.cg_parseFloat(self.pSrc, self.cg_nsoff(ni), self.cg_nslen(ni));
      self.cg_movRaxImm(floatBits);

    } else if (k == CGN_CAST) {
      // WP-11: x as Type — evaluate source, then apply integer truncation/extension
      self.cg_genExpr(self.cg_nc0(ni));
      var typeNode: int64 := self.cg_nc1(ni);
      if (typeNode >= 0) {
        var tname: pchar := self.cg_nsval(typeNode);
        var tlen: int64 := self.cg_nslen(typeNode);
        // #1151: eine Stelle fuer alle Breiten. Vorher stand die Kette hier
        // ausgeschrieben und kannte nur die KURZEN Schreibweisen der
        // vorzeichenbehafteten Typen: `x as int8` und `x as int16` kuerzten
        // nichts, `x as i8` schon — obwohl §7 beide als denselben Typ fuehrt.
        self.cg_emitNarrowRax(self.cg_narrowKindOf(tname, tlen));
        // f64: convert int64 bits in rax to IEEE 754 double via cvtsi2sd
        //
        // #1511: NUR wenn die Quelle eine Ganzzahl ist. Steht links schon ein
        // Gleitkommawert, ist `a as f64` eine Umdeutung ohne Rechnung — die
        // Umwandlung nahm stattdessen die IEEE-Bits als Zahl: aus 4.0 wurde
        // 4616189618054758400. Intern fuehrt Lyx f32 als f64-Bits (#1127),
        // deshalb gilt das fuer beide Richtungen zwischen f32 und f64.
        if (self.cg_isFloatTypeName(tname, tlen)
            && self.cg_isF64Expr(self.cg_nc0(ni)) == 0) {
          // cvtsi2sd xmm0, rax  (F2 48 0F 2A C0)
          self.cg_e8(0xF2); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x2A); self.cg_e8(0xC0);
          // movq rax, xmm0      (66 48 0F 7E C0)
          self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC0);
        }
        // #1963: Ein Cast zwischen zwei EINHEITEN derselben Dimension ist eine
        // UMRECHNUNG, keine Umdeutung — `a as Km` meint dieselbe Strecke in
        // einer anderen Einheit. Ohne diese Stelle blieb der Zahlenwert
        // unveraendert stehen: aus 2500 m wurden 2500 km, und weil der Cast
        // ausdruecklich dasteht, sah es wie eine gewollte Umwandlung aus.
        //
        // Die Zuweisung konnte das nicht auffangen. Sie vergleicht Quell- und
        // Zieleinheit, und die Quelle IST hier schon Km (der Cast-Ausdruck
        // traegt die Einheit, in die er umwandelt) — beide gleich, also nichts
        // zu tun. Umgerechnet werden muss deshalb genau hier, zwischen dem
        // Ausdruck darunter und dem Zieltyp.
        var utCastDst: int64 := self.cg_utypeOfTypeNode(typeNode);
        if (utCastDst >= 0) {
          var utCastSrc: int64 := self.cg_utypeOfExpr(self.cg_nc0(ni));
          if (utCastSrc >= 0) {
            self.cg_emitUtypeConv(utCastDst, utCastSrc);
            self.cg_emitUtypeRange(utCastDst);
          }
        }
        // R5: f64 → int64: cvttsd2si (truncate-towards-zero)
        if (self.cg_seq(tname, tlen, "int64", 5) || self.cg_seq(tname, tlen, "i64", 3)) {
          if (self.cg_isF64Expr(self.cg_nc0(ni)) != 0) {
            // movq xmm0, rax      (66 48 0F 6E C0)
            self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x6E); self.cg_e8(0xC0);
            // cvttsd2si rax, xmm0 (F2 48 0F 2C C0)
            self.cg_e8(0xF2); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x2C); self.cg_e8(0xC0);
          }
        }
        // i64, u64, pchar, bool, char, f32: no-op (already 64-bit in rax)
      }

    } else if (k == CGN_IS_EXPR) {
      // #1094: `x is T`.
      //
      // Der Operator hatte drei Wege, und alle drei endeten bei `false`: die
      // erwartete VMT-Adresse wurde aus der eigenen Codeposition gerechnet
      // statt aus der Patch-Tabelle und traf nie zu; jeder Nicht-Klassentyp
      // fiel auf cg_zeroRax; ein frei erfundener Typname ebenso. Ein Typtest,
      // der konstant `false` liefert, nimmt den Zweig nie und weist auf
      // nichts hin — der stille Default in Reinform.
      //
      // Jetzt: bei einer Klasse mit VMT eine echte Laufzeitpruefung, sonst die
      // statisch feststehende Antwort, und wo weder das eine noch das andere
      // entscheidbar ist, eine Meldung.
      var typeNode: int64 := self.cg_nc1(ni);
      if (typeNode < 0) {
        EPrintStrLn("error: `is` ohne Typ"c);
        exit(1);
      }
      var tname: pchar := self.cg_nsval(typeNode);
      var tlen:  int64 := self.cg_nslen(typeNode);
      var classIdx: int64 := self.cg_findClass(tname, tlen);
      var tBuiltin: int64 := self.cg_builtinTypeId(tname, tlen);
      if (classIdx < 0 && tBuiltin == 0) {
        EPrintStr("error: unbekannter Typ in `is`-Ausdruck: '"c);
        sys_write(2, tname, tlen);
        EPrintStr("'\n"c);
        EPrintStrLn("  `is` prueft gegen einen Klassen-, Struktur- oder eingebauten Typ."c);
        exit(1);
      }
      // Statischer Typ des Empfaengers. Er entscheidet, ob ueberhaupt zur
      // Laufzeit geprueft werden darf: nur eine Klasse mit VMT traegt an
      // [obj+0] den Typzeiger.
      var srcName: pchar := self.cg_staticTypeName(self.cg_nc0(ni));
      var srcLen:  int64 := self.stnLen;
      if (srcName == 0 as pchar) {
        EPrintStrLn("error: statischer Typ des Ausdrucks vor `is` ist nicht bestimmbar"c);
        EPrintStrLn("  Der Ausdruck zuerst einer Variablen mit deklariertem Typ zuweisen."c);
        exit(1);
      }
      var srcIdx: int64 := self.cg_findClass(srcName, srcLen);
      // Ein Typname, den weder die Klassentabelle noch die Liste der
      // eingebauten Typen kennt (Alias, Generik, importierter Typ), macht die
      // Antwort unentscheidbar. Sie hier auf `false` zu setzen waere derselbe
      // stille Default noch einmal.
      if (srcIdx < 0 && self.cg_builtinTypeId(srcName, srcLen) == 0) {
        EPrintStr("error: `is` kann den Typ '"c);
        sys_write(2, srcName, srcLen);
        EPrintStr("' nicht pruefen\n"c);
        EPrintStrLn("  Geprueft werden Klassen (zur Laufzeit) und eingebaute Typen (statisch)."c);
        exit(1);
      }

      if (self.cg_classHasVmt(classIdx) != 0 && self.cg_classHasVmt(srcIdx) != 0) {
        // Laufzeitpruefung. Getroffen wird die Zielklasse SAMT ihrer
        // Nachfahren — sonst waere `b is A` bei `B extends A` falsch, und
        // genau dafuer gibt es den Operator.
        self.cg_genExpr(self.cg_nc0(ni));
        self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0);   // xor r8, r8
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
        self.cg_e8(0x0F); self.cg_e8(0x84);                     // jz .done  (null ist nie ein T)
        var doneJ: int64 := self.codeLen;
        self.cg_e32(0);
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x08);   // mov rcx, [rax]
        var ci: int64 := 0;
        while (ci < self.classCount) {
          if (self.cg_classHasVmt(ci) != 0 && self.cg_isDescendantClass(ci, classIdx) != 0) {
            var cb: int64 := self.classLayouts + ci * CG_CLASS_SZ;
            var cnp: pchar := peek64(cb) as pchar;
            var cnl: int64 := peek64(cb + CG_PATCH_OFF_NAMEPTR);
            self.cg_e8(0x48); self.cg_e8(0xBA);                 // mov rdx, imm64
            var vp: int64 := self.codeLen;
            self.cg_e64(0);
            self.cg_addVmtPatch(vp, cnp, cnl);
            self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xD1); // cmp rcx, rdx
            self.cg_e8(0x75); self.cg_e8(0x07);                   // jne +7
            self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC0); // mov r8, 1
            self.cg_e32(1);
          }
          ci += 1;
        }
        poke32(self.code + doneJ, self.codeLen - doneJ - 4);
        self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0xC0);   // mov rax, r8
      } else {
        // Kein polymorpher Fall: die Antwort steht zur Uebersetzungszeit fest.
        // Der Empfaenger wird trotzdem ausgewertet — er kann Seiteneffekte
        // haben, und `f() is A` darf f nicht verschlucken.
        self.cg_genExpr(self.cg_nc0(ni));
        var res: int64 := 0;
        if (classIdx >= 0) {
          // Klassen OHNE Methode bekommen struct-Layout und damit keine VMT
          // (cg_buildStructLayout) — es gibt zur Laufzeit nichts zu lesen.
          // Die Antwort ist dann der statisch bekannte Vererbungsweg, und
          // `null` bleibt trotzdem kein T.
          if (srcIdx >= 0 && self.cg_isDescendantClass(srcIdx, classIdx) != 0) { res := 1; }
          if (res != 0) {
            self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
            self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC0);   // setne al
            self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);   // movzx rax, al
          } else {
            self.cg_movRaxImm(0);
          }
        } else {
          var sBuiltin: int64 := self.cg_builtinTypeId(srcName, srcLen);
          if (sBuiltin != 0 && sBuiltin == tBuiltin) { res := 1; }
          self.cg_movRaxImm(res);
        }
      }

    } else if (k == CGN_CLOSURE) {
      // WP-02: anonymous closure: fn(params): rettype { body }
      // c0=params, c1=rettype, c2=body
      // Emits inner function inline (with jmp-around), then builds heap {fnPtr,envPtr}.
      var closureParams: int64 := self.cg_nc0(ni);
      var closureBody:   int64 := self.cg_nc2(ni);

      // 1. Scan for captured vars (uses outer locals, so do before resetting localBase)
      // #2133: in EIGENE Listen. Bis dahin teilten sich alle Lambdas eine
      // Liste, gerettet wurde nur die Anzahl: ein Lambda im Rumpf (oder eine
      // `var f := fn…`-Deklaration dort, die zum Zaehlen scannt) ueberschrieb
      // die Namen und Offsets des umgebenden — dessen spaetere Erfassungen
      // und die Kopie in die Umgebung (Schritt 14) lasen fremde Eintraege.
      var savedCapBuf: int64 := self.closureCapturedBuf;
      var savedCapLenBuf: int64 := self.closureCapturedLenBuf;
      var savedCapOutBuf: int64 := self.closureCapturedOutBuf;
      var savedCapIdxBuf: int64 := self.closureCapturedIdxBuf;
      var savedCapEnvBuf: int64 := self.closureCapturedEnvBuf;
      var outerCapCount: int64 := self.closureCapturedCount;
      self.cg_capSuche(closureBody, closureParams);
      var numCap: int64 := self.closureCapturedCount;

      // 2. Generate unique label for inner function
      var anonIdx: int64 := self.anonFnCounter;
      self.anonFnCounter += 1;
      var anonLabel: pchar := self.cg_buildAnonName(anonIdx);
      var anonLabelLen: int64 := StrLen(anonLabel);
      self.lastAnonName    := anonLabel as int64;   // #1589
      self.lastAnonNameLen := anonLabelLen;

      // 3. Emit jmp rel32 over inner function
      self.cg_e8(0xE9);
      var jmpOverPatch: int64 := self.codeLen;
      self.cg_e32(0);

      // 4. Register label at inner function start, emit prologue
      self.cg_addLabel(anonLabel, anonLabelLen, 0);
      // #2135: Das Lambda liegt MITTEN im Code der aeusseren Funktion — es
      // bekommt einen eigenen Abwickelbereich, und dahinter geht die aeussere
      // mit ihrem Rahmen weiter (CFI_FN_RAHMEN unten).
      var savedCfiInFn: int64 := self.cfiInFn;
      self.cg_cfi(CFI_FN, 0);
      self.cfiInFn := 1;

      // 5. Save outer function state
      var savedLocalCount: int64 := self.localCount;
      var savedFrameSize:  int64 := self.frameSize;
      var savedLocalBase:  int64 := self.localBase;
      var savedEnvOff:     int64 := self.closureEnvPtrOff;
      var savedStaticLink: int64 := self.staticLinkOffset;
      var savedCapCount:   int64 := self.closureCapturedCount;
      // #2245: Ein Lambda behaelt seinen Canary. Es wird MITTEN in der
      // aeusseren Funktion erzeugt, deshalb wird der Wert der aeusseren
      // gesichert und unten zurueckgesetzt — sonst entschiede die innere
      // Funktion ueber den Epilog der aeusseren.
      var savedCanary:     int64 := self.canaryAn;
      self.canaryAn := 1;

      // 6. Reset for inner function (locals start after outer)
      self.localBase  := savedLocalCount;
      self.frameSize  := 0;
      self.staticLinkOffset := -1;  // inner fn has no static link (uses env ptr instead)

      // 7. Emit prologue
      var innerProloguePatch: int64 := self.cg_emitPrologueNested();

      // 8./9. Parameter ablegen. #1249: FAENGT das Lambda nichts ein, ist es
      // eine gewoehnliche Funktion — dann gibt es keine Umgebung, rdi bleibt
      // das erste echte Argument, und nichts wird verschoben. Nur mit
      // Captures kommt die Umgebung verdeckt in rdi und alles rutscht eins
      // weiter.
      //
      // Das ist der Kern von #1249: die Aufrufstelle waehlt ihre Konvention
      // nach dem DEKLARIERTEN Typ. Ein `var f: fn(int64): int64` gilt dort als
      // duenner Zeiger, das Lambda lieferte aber einen {fnPtr,env}-Satz auf dem
      // Heap — `call rbx` sprang mitten in diesen Satz. Mit derselben
      // Konvention auf beiden Seiten faellt der Fall weg.
      if (numCap > 0) {
        var envPtrOff: int64 := self.cg_addLocal("__env_ptr__", 11);
        self.closureEnvPtrOff := envPtrOff;
        self.cg_spillRdi(envPtrOff);
      } else {
        self.closureEnvPtrOff := 0;
      }
      // #2084: Bis 1.2.13C endete diese Schleife nach FUENF Parametern —
      // auch ohne Umgebung, wo sechs Register frei sind. Ein sechster oder
      // siebter Parameter wurde nie als Local angelegt; sein Name fiel im
      // Rumpf still auf 0. Jetzt dieselbe Anordnung wie bei der freien
      // Funktion (cg_genFuncDecl, "L-4: stack params") — die beiden muessen
      // uebereinstimmen: die Register, so viele es gibt (5 mit Umgebung,
      // sonst 6), der Rest ab [rbp+16] vom Stapel des Aufrufers.
      var cRegMax: int64 := 6;
      if (numCap > 0) { cRegMax := 5; }
      var cparam: int64 := closureParams;
      var cparamIdx: int64 := 0;
      var cStapelOff: int64 := 16;
      while (cparam >= 0) {
        var pname2: pchar := self.cg_nsval(cparam);
        var pnlen2: int64 := self.cg_nslen(cparam);
        var cpoff: int64 := self.cg_addLocal(pname2, pnlen2);
        // #2133: der TYP des Parameters. Er wurde nie vermerkt — `y: f64`
        // galt im Rumpf als Ganzzahl, `x * y` rechnete auf den Bitmustern.
        // Dieselben Merkungen wie beim Parameter einer freien Funktion.
        var cptype: int64 := self.cg_nc0(cparam);
        if (cptype >= 0 && self.cg_nkind(cptype) == 60) {
          self.cg_setLocalType(self.localCount - 1, self.cg_nsval(cptype), self.cg_nslen(cptype));
        }
        if (cptype >= 0 && self.cg_nkind(cptype) == CGN_FN_PTR_NODE) {
          poke8(self.localIsFnPtr + self.localCount - 1, 1);
          if (self.cg_fnPtrRetIstF64(cptype) != 0) { poke8(self.localFnPtrF64 + self.localCount - 1, 1); }
          poke8(self.localFnRetSatz + self.localCount - 1, self.cg_fnPtrRetTiefe(cptype));   // #2143
        }
        if (cparamIdx >= cRegMax) {
          self.cg_loadRax(cStapelOff);
          self.cg_storeRax(cpoff);
          cStapelOff += 8;
        } else if (numCap > 0) {
          if (cparamIdx == 0) { self.cg_spillRsi(cpoff); }
          else if (cparamIdx == 1) { self.cg_spillRdx(cpoff); }
          else if (cparamIdx == 2) { self.cg_spillRcx(cpoff); }
          else if (cparamIdx == 3) { self.cg_spillR8(cpoff); }
          else if (cparamIdx == 4) { self.cg_spillR9(cpoff); }
        } else {
          if (cparamIdx == 0) { self.cg_spillRdi(cpoff); }
          else if (cparamIdx == 1) { self.cg_spillRsi(cpoff); }
          else if (cparamIdx == 2) { self.cg_spillRdx(cpoff); }
          else if (cparamIdx == 3) { self.cg_spillRcx(cpoff); }
          else if (cparamIdx == 4) { self.cg_spillR8(cpoff); }
          else if (cparamIdx == 5) { self.cg_spillR9(cpoff); }
        }
        cparamIdx += 1;
        cparam := self.cg_nnext(cparam);
      }

      // 10. Generate inner function body
      // #2133: ein Lambda packt seine Rueckgabe nicht ein — wer es ruft,
      // kennt seinen Rueckgabetyp nicht (Aufruf ueber ein Local). Ohne das
      // Ruecksetzen erbte es die Einstellung der umgebenden Funktion.
      // Ebenso die uebrigen Eigenschaften des Rueckgabetyps: bis #2133 galten
      // im Lambda die der umgebenden Funktion (eine f64-Funktion wandelte
      // `return 1` des Lambdas um, eine Struct-Rueckgabe kopierte dorthin).
      var savedLRetFnWert: int64 := self.curFnRetFnWert;
      var savedLRetFloat: int64 := self.fnRetIsFloat;
      var savedLRetStruct: int64 := self.fnRetStructBytes;
      var savedLRetRange: int64 := self.curFnRetRange;
      var savedLRetNarrow: int64 := self.curFnRetNarrow;
      var lRetTy: int64 := self.cg_nc1(ni);
      // #2143: mit Funktionstyp als Rueckgabe packt das Lambda ein wie jede
      // Funktion (#2133: ueber eine Rueckgabegrenze immer Satz). Wer es ueber
      // ein Local ruft, erfaehrt das ueber localFnRetSatz.
      self.curFnRetFnWert := self.cg_typIstFnWert(lRetTy);
      self.fnRetIsFloat := 0;
      if (lRetTy >= 0 && self.cg_isFloatTypeName(self.cg_nsval(lRetTy), self.cg_nslen(lRetTy)) != 0) {
        self.fnRetIsFloat := 1;
      }
      self.fnRetStructBytes := 0;
      self.curFnRetRange := self.cg_rangeOfTypeNode(lRetTy);
      self.curFnRetNarrow := self.cg_narrowKindOfTypeNode(lRetTy);
      self.cg_genBlock(closureBody);
      self.curFnRetFnWert := savedLRetFnWert;
      self.fnRetIsFloat := savedLRetFloat;
      self.fnRetStructBytes := savedLRetStruct;
      self.curFnRetRange := savedLRetRange;
      self.curFnRetNarrow := savedLRetNarrow;
      self.cg_zeroRax();
      self.cg_emitEpilogue();

      // 11. Patch inner function frame size (align to 16)
      var ifs: int64 := self.frameSize + 15;
      var iAligned: int64 := ifs - (ifs & 15);
      if (iAligned == 0) { iAligned := 16; }
      poke32(self.code + innerProloguePatch, iAligned);

      // 12. Patch jmp-over to here
      poke32(self.code + jmpOverPatch, self.codeLen - jmpOverPatch - 4);
      self.cfiInFn := savedCfiInFn;   // #2135
      if (savedCfiInFn != 0) { self.cg_cfi(CFI_FN_RAHMEN, 0); } else { self.cg_cfi(CFI_ENDE, 0); }

      // 13. Restore outer state
      self.localBase         := savedLocalBase;
      self.localCount        := savedLocalCount;
      self.frameSize         := savedFrameSize;
      self.closureEnvPtrOff  := savedEnvOff;
      self.staticLinkOffset  := savedStaticLink;
      self.closureCapturedCount := savedCapCount;
      self.canaryAn := savedCanary;   // #2245

      // 14. Heap-allocate env (numCap * 8 bytes) via mmap
      if (numCap > 0) {
        self.cg_e8(0x31); self.cg_e8(0xFF);  // xor edi, edi (addr=0)
        self.cg_e8(0xBE); self.cg_e32(numCap * 8);  // mov esi, numCap*8
        self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov edx,3
        self.cg_e8(0x41); self.cg_e8(0xBA); self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov r10d,34
        self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);  // mov r8d,-1
        self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9d,r9d
        self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov eax,9
        self.cg_e8(0x0F); self.cg_e8(0x05);  // syscall → rax = env ptr

        // Save env ptr on stack temporarily
        self.cg_pushRax();  // [rsp] = env ptr

        // Copy each captured var from outer stack into env buffer
        var ci: int64 := 0;
        while (ci < numCap) {
          var outerOff2: int64 := peek64(self.closureCapturedOutBuf + ci * 8);
          var envIdx2: int64 := peek64(self.closureCapturedEnvBuf + ci * 8);
          if (envIdx2 >= 0) {
            // #2133: Erfassung des Erzeugers — aus dessen Umgebung.
            self.cg_loadRax(self.closureEnvPtrOff);
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80); self.cg_e32(envIdx2 * 8);   // mov rax, [rax+disp32]
          } else {
            self.cg_loadRax(outerOff2);    // rax = captured var value
          }
          // mov rbx, [rsp]  (env ptr)
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x1C); self.cg_e8(0x24);
          // mov [rbx + ci*8], rax
          var eOff2: int64 := ci * 8;
          if (eOff2 == 0) {
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x03);
          } else if (eOff2 < 128) {
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x43); self.cg_e8(eOff2);
          } else {
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x83); self.cg_e32(eOff2);
          }
          ci += 1;
        }
      }

      // #2133: die Listen des umgebenden Lambdas zurueck — ab hier liest
      // dieser Zweig sie nicht mehr.
      self.closureCapturedBuf    := savedCapBuf;
      self.closureCapturedLenBuf := savedCapLenBuf;
      self.closureCapturedOutBuf := savedCapOutBuf;
      self.closureCapturedIdxBuf := savedCapIdxBuf;
      self.closureCapturedEnvBuf := savedCapEnvBuf;
      self.closureCapturedCount  := outerCapCount;

      // #1249: ohne Captures ist der WERT die Codeadresse — kein Satz auf dem
      // Heap, keine Belegung, kein zweiter Zugriff beim Aufruf.
      if (numCap == 0) {
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);   // lea rax, [rip+anonLabel]
        var thinPatch: int64 := self.codeLen;
        self.cg_e32(0);
        self.cg_addPatch(thinPatch, anonLabel as int64, anonLabelLen, CG_PATCH_CALL);
        return;
      }

      // 15. Heap-allocate closure struct (16 bytes) via mmap
      self.cg_e8(0x31); self.cg_e8(0xFF);  // xor edi, edi
      self.cg_e8(0xBE); self.cg_e8(0x10); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov esi, 16
      self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov edx,3
      self.cg_e8(0x41); self.cg_e8(0xBA); self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov r10d,34
      self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);  // mov r8d,-1
      self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9d,r9d
      self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov eax,9
      self.cg_e8(0x0F); self.cg_e8(0x05);  // syscall → rax = closure ptr

      // 16. Store env ptr into closure[8] if we have captures
      if (numCap > 0) {
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC3);  // mov rbx, rax (closure ptr)
        self.cg_popRax();   // rax = env ptr
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x43); self.cg_e8(0x08);  // mov [rbx+8], rax
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx (restore closure ptr)
      }

      // 17. Store fn ptr (code addr) into closure[0] via RIP-relative lea
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);  // mov rdi, rax (save closure ptr)
      // lea rax, [rip + anonLabel]
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
      var fnPtrPatch2: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_addPatch(fnPtrPatch2, anonLabel as int64, anonLabelLen, CG_PATCH_CALL);
      // mov [rdi], rax  (closure[0] = fnPtr)
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x07);
      // Return closure ptr
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF8);  // mov rax, rdi

    } else if (k == CGN_MAP_LIT) {
      // WP-BI-06: { key: val, ... } — allocate hash map, insert all entries
      // Count entries to compute initial capacity (next power of 2 >= n*2, min 8)
      var cnt: int64 := 0;
      var tmpE: int64 := self.cg_nc0(ni);
      while (tmpE != -1) { cnt := cnt + 1; tmpE := self.cg_nnext(tmpE); }
      var cap: int64 := 8;
      while (cap < cnt * 2) { cap := cap * 2; }
      // Call _lyx_map_new(cap) → rax = map ptr
      self.cg_e8(0xBF); self.cg_e32(cap);                           // mov edi, cap
      var ppMN: int64 := self.cg_emitCall();
      poke32(self.code + ppMN, CG_H_MAP_NEW - ppMN - 4);
      self.cg_e8(0x50);                                              // push rax (map ptr)
      // Insert each entry: key→rsi, val→rdx, map→rdi, call _lyx_map_set
      var entry: int64 := self.cg_nc0(ni);
      while (entry != -1) {
        self.cg_genExpr(self.cg_nc0(entry));                         // key → rax
        self.cg_e8(0x50);                                            // push rax (save key)
        self.cg_genExpr(self.cg_nc1(entry));                         // val → rax
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2);      // mov rdx, rax
        self.cg_e8(0x5E);                                            // pop rsi (key)
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24); // mov rdi,[rsp]
        // #1291: Ein Literal wie `{"a"c: 1}` fuellt die Map, bevor irgendeine
        // Variable im Spiel ist — der Schluesseltyp steht hier nur am Eintrag
        // selbst. Ist der Schluessel eine Zeichenkette, muss schon das
        // Einfuegen ueber den Inhaltsvergleich laufen; sonst legte das Literal
        // Eintraege ab, die das spaetere Lesen nie wiederfindet.
        if (self.cg_nkind(self.cg_nc0(entry)) == CGN_LIT_STR) {
          self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1);
          self.cg_e32(0);                                        // mov rcx,0 (setzen)
          var ppMSl: int64 := self.cg_emitCall();
          poke32(self.code + ppMSl, CG_H_MAP_STR - ppMSl - 4);
        } else {
          var ppMS: int64 := self.cg_emitCall();
          poke32(self.code + ppMS, CG_H_MAP_SET - ppMS - 4);
        }
        entry := self.cg_nnext(entry);
      }
      self.cg_e8(0x58);                                              // pop rax (return map ptr)

    } else if (k == CGN_SET_LIT) {
      // WP-BI-06: { val, ... } — allocate hash map used as set (value always 1)
      var cnt: int64 := 0;
      var tmpEl: int64 := self.cg_nc0(ni);
      while (tmpEl != -1) { cnt := cnt + 1; tmpEl := self.cg_nnext(tmpEl); }
      var cap: int64 := 8;
      while (cap < cnt * 2) { cap := cap * 2; }
      // Call _lyx_map_new(cap) → rax = map ptr
      self.cg_e8(0xBF); self.cg_e32(cap);                           // mov edi, cap
      var ppSN: int64 := self.cg_emitCall();
      poke32(self.code + ppSN, CG_H_MAP_NEW - ppSN - 4);
      self.cg_e8(0x50);                                              // push rax (map ptr)
      // Insert each element: elem→rsi, value=1→rdx, map→rdi, call _lyx_map_set
      var el: int64 := self.cg_nc0(ni);
      while (el != -1) {
        self.cg_genExpr(el);                                         // elem → rax
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);      // mov rsi, rax
        self.cg_e8(0xBA); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov edx, 1
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24); // mov rdi,[rsp]
        if (self.cg_nkind(el) == CGN_LIT_STR) {                  // #1291
          self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1);
          self.cg_e32(0);
          var ppSSl: int64 := self.cg_emitCall();
          poke32(self.code + ppSSl, CG_H_MAP_STR - ppSSl - 4);
        } else {
          var ppSS: int64 := self.cg_emitCall();
          poke32(self.code + ppSS, CG_H_MAP_SET - ppSS - 4);
        }
        el := self.cg_nnext(el);
      }
      self.cg_e8(0x58);                                              // pop rax (return map ptr)

    } else if (k == CGN_IN_EXPR) {
      // #1129: `x in a..b` — Bereichstest, GRENZEN EINSCHLIESSLICH wie beim
      // Bereichsmuster in `match` (#1113) und beim Bereichstyp (§7).
      //
      // Bisher lief jedes `in` in den Map-Zweig: `_lyx_map_has` bekam als
      // "Map" das, was CGN_RANGE hinterliess — und das ist kein Zeiger,
      // sondern die obere Grenze, waehrend die untere unbalanciert auf dem
      // Stack liegen blieb. Der Ausdruck uebersetzte und stuerzte ab.
      var inRhs: int64 := self.cg_nc1(ni);
      if (inRhs >= 0 && self.cg_nkind(inRhs) == CGN_RANGE) {
        var loNi: int64 := self.cg_nc0(inRhs);
        var hiNi: int64 := self.cg_nc1(inRhs);
        self.cg_genExpr(self.cg_nc0(ni));        // x
        self.cg_pushRax();
        self.cg_genExpr(loNi);                   // untere Grenze
        self.cg_pushRax();
        if (hiNi >= 0) {
          self.cg_genExpr(hiNi);                 // obere Grenze
        } else {
          // Offenes Ende (`a..`): nach oben unbeschraenkt.
          self.cg_movRaxImm(9223372036854775807);
        }
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);   // mov rcx, rax (hi)
        self.cg_e8(0x5A);                                       // pop rdx (lo)
        self.cg_popRbx();                                       // rbx = x
        self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xD3);   // cmp rbx, rdx
        self.cg_e8(0x0F); self.cg_e8(0x8C);                     // jl .aus
        var jLo: int64 := self.codeLen; self.cg_e32(0);
        self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xCB);   // cmp rbx, rcx
        self.cg_e8(0x0F); self.cg_e8(0x8F);                     // jg .aus
        var jHi: int64 := self.codeLen; self.cg_e32(0);
        self.cg_movRaxImm(1);
        self.cg_e8(0xEB); self.cg_e8(0x03);                     // jmp .fertig (ueber xor)
        poke32(self.code + jLo, self.codeLen - jLo - 4);
        poke32(self.code + jHi, self.codeLen - jHi - 4);
        self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);   // xor rax, rax
        return;
      }
      // WP-BI-06: lhs in rhs — call _lyx_map_has(map=rhs, key=lhs) → 1 or 0
      self.cg_genExpr(self.cg_nc1(ni));                              // rhs (collection) → rax
      self.cg_e8(0x50);                                              // push rax (map ptr)
      self.cg_genExpr(self.cg_nc0(ni));                              // lhs (element) → rax
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);        // mov rsi, rax (key)
      self.cg_e8(0x5F);                                              // pop rdi (map ptr)
      if (self.cg_isStrKeyMap(self.cg_nc1(ni)) != 0) {            // #1291
        self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1);
        self.cg_e32(2);                                          // mov rcx,2 (enthalten)
        var ppMHs: int64 := self.cg_emitCall();
        poke32(self.code + ppMHs, CG_H_MAP_STR - ppMHs - 4);
      } else {
        var ppMH: int64 := self.cg_emitCall();
        poke32(self.code + ppMH, CG_H_MAP_HAS - ppMH - 4);
      }

    } else if (k == CGN_EMBED) {
      // #1961: `@embed(...)` liefert die ADRESSE der gepackten Bytes,
      // `@embed_len(...)` ihre Anzahl. Beide stehen zur Uebersetzungszeit
      // fest; zur Laufzeit bleibt ein lea bzw. ein mov.
      var pbox: int64 := alloc(8);
      var epfad: pchar := self.cg_embedPfad(self.cg_nsval(ni), self.cg_nslen(ni), pbox);
      var epfadLen: int64 := peek64(pbox);
      free(pbox, 8);
      if (self.cg_nival(ni) != 0) {
        var gr: int64 := self.cg_embedGroesse(epfad);
        if (gr < 0) { self.cg_embedFehlt(epfad, "@embed_len"c); }
        self.cg_movRaxImm(gr);
      } else {
        self.cg_emitLeaRaxData(self.cg_embedBytes(epfad, epfadLen));
      }

    } else if (k == 100) {
      // WP-BC-51: NK_ARRAY_LIT — [e1, e2, ...] stack-allocated array with {cap,len} header
      // Layout: [rsp+0]=cap, [rsp+8]=len, [rsp+16]=elem0, [rsp+24]=elem1, ...
      // rax = rsp (pointer to header; indexer skips 16 bytes to reach elements)
      var cnt: int64 := 0;
      var el: int64 := self.cg_nc0(ni);
      while (el != -1) { cnt := cnt + 1; el := self.cg_nnext(el); }
      if (cnt > 0) {
        // WP-10.2: cnt*8+16 must fit in int32 (x86 imm32) and must not overflow int64
        if (cnt > 0x1FFFFFFF) { return; }
        var stackBytes: int64 := cnt * 8 + 16;
        // sub rsp, stackBytes
        self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC); self.cg_e32(stackBytes);
        // write cap = cnt at [rsp+0]
        self.cg_movRaxImm(cnt);
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);
        // write len = cnt at [rsp+8]
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);
        // write elements at [rsp+16+i*8]
        var i: int64 := 0;
        el := self.cg_nc0(ni);
        while (el != -1) {
          self.cg_genExpr(el);
          var disp: int64 := 16 + i * 8;
          if (disp <= 127) {
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(disp);
          } else {
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x84); self.cg_e8(0x24); self.cg_e32(disp);
          }
          i += 1;
          el := self.cg_nnext(el);
        }
        // rax = rsp (pointer to header)
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE0);
      } else {
        // #1642: Das LEERE Literal lieferte eine 0 — und eine 0 sieht aus wie
        // ein Array, bis jemand hineingreift. `var a: array := [];` legte
        // damit nichts an, `len(a)` las an Adresse 8 und stuerzte ab. Nach dem
        // ersten `push` lief es, weil push seinen Allokationszweig nachholt —
        // deshalb der irrefuehrende Eindruck, nur `len` sei kaputt.
        //
        // Die Form ohne Initialisierer (`var a: array;`) bekommt seit #1177
        // dieselbe Struktur; hier fehlte sie.
        self.cg_emitEmptyDynArray();
      }

    } else {
      // Unknown expression: emit 0
      self.cg_zeroRax();
    }
  }

  // Infer the print dispatch type for a single argument node.
  // Returns: 0=int64/PrintInt  1=pchar/PrintStr  2=f64/PrintFloat  3=bool/PrintBool
  fn cg_inferPrintType(argNi: int64): int64 {
    var k: int64 := self.cg_nkind(argNi);
    if (k == CGN_LIT_STR)  { return 1; }
    // #1961: `@embed(...)` ist eine Zeichenkette, `@embed_len(...)` eine Zahl.
    // Dritte Stelle, die dieselbe Frage beantwortet — neben cg_isPcharExpr
    // hier und _lowerPrint im IR-Weg. Fehlte sie, gab
    // `PrintLn(@embed("vorlage.txt"))` die ADRESSE als Zahl aus.
    if (k == CGN_EMBED) {
      if (self.cg_nival(argNi) != 0) { return 0; }
      return 1;
    }
    if (k == CGN_LIT_FLOAT) { return 2; }
    if (k == CGN_LIT_BOOL)  { return 3; }
    // #1497: ein RECHENAUSDRUCK. Diese Funktion kannte Literale, Bezeichner,
    // Felder und Aufrufe — aber nicht `a + b`. `PrintLn(a + b)` gab deshalb die
    // IEEE-Bits als Ganzzahl aus (4618441417868443648 statt 6.00), obwohl die
    // Rechnung selbst stimmte.
    //
    // Entschieden wird das ueber DIESELBE Typspur, die auch der Codegen
    // benutzt (cg_isF64Expr) — eine zweite, eigene Meinung darueber, was
    // Gleitkomma ist, waere genau die Sorte Abweichung, aus der solche Fehler
    // entstehen.
    if (k == CGN_BINOP || k == CGN_UNOP || k == CGN_INDEX || k == CGN_CAST) {
      if (self.cg_isF64Expr(argNi) != 0) { return 2; }
    }
    // #1058: Ergebnis eines AUFRUFS. Bisher kannte die Funktion nur Literale und
    // Bezeichner; ein CGN_CALL fiel auf 0 und wurde als Ganzzahl ausgegeben —
    // `PrintLn(StrFromInt(42))` gab den Zeiger aus. Zuerst der deklarierte
    // Rueckgabetyp (die Registry kennt die Benutzerfunktionen), sonst die Liste
    // der Zeichenketten-Builtins.
    if (k == CGN_CALL) {
      var cnm: pchar := self.cg_nsval(argNi);
      var cnl: int64 := self.cg_nslen(argNi);
      // #1381: greift jetzt auch fuer Methodenaufrufe — vorher stand hier
      // `&& self.cg_nival(argNi) == 0`, und `PrintLn(sb.ToString())` fiel
      // durch auf "Ganzzahl", obwohl der Rueckgabetyp deklariert ist.
      var decl: int64 := self.cg_callRetTypeIs(argNi, "pchar"c, 5);
      if (decl == 1) { return 1; }
      if (decl == 0) {
        if (self.cg_callRetTypeIs(argNi, "f64"c, 3) == 1) { return 2; }
        if (self.cg_callRetTypeIs(argNi, "bool"c, 4) == 1) { return 3; }
        return 0;
      }
      // #1683: Der Rueckgabetyp ist unbekannt (nicht in der Registry). Bis
      // 1.1.3N endete es hier fuer jeden METHODENAUFRUF sofort bei
      // "Ganzzahl", und die Builtin-Liste wurde nur bei freien Funktionen
      // gefragt. `Print(obj.ClassName())` gab deshalb den Zeiger als Zahl aus,
      // waehrend derselbe Wert ueber eine pchar-Variable richtig ankam.
      //
      // Dahinter standen ZWEI Listen "liefert pchar", die sich nicht einig
      // waren: cg_isPcharExpr kennt ClassName (seit #1670),
      // cg_builtinReturnsPchar nicht. Statt den Namen in die zweite Liste
      // nachzutragen — und beim naechsten Builtin dieselbe Luecke zu bauen —
      // fragt diese Stelle jetzt dieselbe Auskunft wie die Verkettung.
      if (self.cg_isPcharExpr(argNi) != 0) { return 1; }
      return 0;
    }
    // #1143: die VERKETTUNG. `PrintLn("a" + "b")` gab die Adresse als Zahl
    // aus, obwohl die Verkettung selbst laengst stimmt (CGT_PLUS mit zwei
    // pchar-Operanden emittiert StrConcat, siehe cg_genBinop). Die
    // Typbestimmung fuer Print kannte den Fall nur nicht — genau daran
    // scheiterte der Repro aus #1143.
    if (k == CGN_BINOP && self.cg_nival(argNi) == CGT_PLUS) {
      if (self.cg_isPcharExpr(self.cg_nc0(argNi)) != 0) {
        if (self.cg_isPcharExpr(self.cg_nc1(argNi)) != 0) { return 1; }
      }
    }
    // #1308/#1316: der CAST. `PrintLn(x as pchar)` fiel hier durch bis zum
    // `return 0` am Ende und wurde als Ganzzahl ausgegeben — gedruckt wurde
    // also die ADRESSE. Ueber eine Zwischenvariable ging es, weil der Zweig
    // fuer CGN_IDENT den deklarierten Typ liest; genau dieser Unterschied
    // machte den Fehler so verwirrend.
    //
    // Dieselbe Luecke wie bei cg_isF64Expr in #905: die Typbestimmung kannte
    // den Cast-Knoten nicht. Ein Cast ist die ausdrueckliche Angabe des
    // Aufrufers, welchen Typ der Wert hat — sie darf nicht die einzige Form
    // sein, die ignoriert wird.
    if (k == CGN_CAST) {
      var ctn: int64 := self.cg_nc1(argNi);
      if (ctn >= 0) {
        var ctp: pchar := self.cg_nsval(ctn);
        var ctl: int64 := self.cg_nslen(ctn);
        if (self.cg_seq(ctp, ctl, "pchar", 5)) { return 1; }
        if (self.cg_isFloatTypeName(ctp, ctl) != 0) { return 2; }
        if (self.cg_seq(ctp, ctl, "bool", 4)) { return 3; }
      }
      return 0;
    }
    // #1328: der FELDZUGRIFF. `PrintLn(t.name)` mit `name: pchar` gab die
    // Adresse aus — die Typbestimmung kannte den Knoten nicht und fiel auf
    // "Ganzzahl". Derselbe Wert ueber eine Zwischenvariable ging, weil der
    // Zweig darunter den deklarierten Typ liest.
    if (k == CGN_FIELD) {
      var fLenBox: int64 := alloc(8);
      var ftp: pchar := self.cg_fieldTypeNameOf(argNi, fLenBox);
      var ftl: int64 := peek64(fLenBox);
      free(fLenBox, 8);
      if (ftp != 0 as pchar && ftl > 0) {
        if (self.cg_seq(ftp, ftl, "pchar", 5)) { return 1; }
        if (self.cg_isFloatTypeName(ftp, ftl) != 0) { return 2; }
        if (self.cg_seq(ftp, ftl, "bool", 4)) { return 3; }
      }
      return 0;
    }
    if (k == CGN_IDENT) {
      var nm: pchar := self.cg_nsval(argNi);
      var nl: int64  := self.cg_nslen(argNi);
      var lidx: int64 := self.cg_findLocalIdx(nm, nl);
      if (lidx >= 0) {
        var tb: int64  := self.localTypes + lidx * CG_LOCTYPE_SZ;
        var tp: pchar  := peek64(tb) as pchar;
        var tn: int64  := peek64(tb + CG_LOCTYPE_OFF_LEN);
        if (self.cg_isFloatTypeName(tp, tn) != 0) { return 2; }   // #1127
        if (self.cg_seq(tp, tn, "pchar", 5)) { return 1; }
        if (self.cg_seq(tp, tn, "bool",  4)) { return 3; }
      } else {
        var gidx: int64 := self.cg_findGlobalIdx(nm, nl);
        if (gidx >= 0 && peek8(self.globalIsPchar + gidx) != 0) { return 1; }
        // pchar string constants
        var cidx: int64 := self.cg_findConIdx(nm, nl);
        if (cidx >= 0) {
          if (peek8(self.conIsPchar + cidx) != 0) { return 1; }
        }
      }
    }
    return 0;
  }

  // Emit individual print calls for each argument in argNode list.
  // Type is inferred per argument; addNewline=1 appends "\n"; isStderr=1 uses fd=2.
  fn cg_genPrintMulti(argNode: int64, addNewline: int64, isStderr: int64) {
    var hStr: int64 := CG_H_PRINTSTR;
    var hInt: int64 := CG_H_PRINTINT;
    if (isStderr == 1) { hStr := CG_H_EPRINTSTR; hInt := CG_H_EPRINTINT; }
    var cur: int64 := argNode;
    while (cur >= 0) {
      // #2141: Ein LITERAL hat eine bekannte Laenge — write(fd, text, laenge)
      // statt _lyx_print_str, das bis zum ersten Nullbyte zaehlt. Bis 1.2.16A
      // gab `Print("ab\0cd")` nur "ab" aus. Dieselbe Rechnung wie der
      // Literal-Zweig von Print im IR-Weg (Laenge aus dem Vorspann, #1968) —
      // die beiden muessen uebereinstimmen. EPrint bleibt beim Zaehlen, wie
      // EPrint im IR-Weg (Builtin 13).
      // NUR auf dem SysV-Pfad: in einer PE-Datei (win64, msAbi) waere der rohe
      // write-Syscall ein NT-Dienst mit anderer Bedeutung (#1678,
      // tests/win64_syscalls_test.sh). Dort bleibt es beim Helfer.
      if (isStderr == 0 && self.msAbi == 0 && self.cg_nkind(cur) == CGN_LIT_STR) {
        var plOff: int64 := self.cg_addStr(self.cg_nsoff(cur), self.cg_nslen(cur));
        var plLen: int64 := self.dataLen - plOff - 1;              // ohne die Abschlussnull
        self.cg_emitLeaRdiData(plOff);
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xFE);      // mov rsi, rdi (Text)
        self.cg_e8(0xBA); self.cg_e32(plLen);                      // mov edx, laenge
        self.cg_e8(0xBF); self.cg_e32(1);                          // mov edi, 1 (stdout)
        self.cg_e8(0xB8); self.cg_e32(1);                          // mov eax, 1 (sys_write)
        self.cg_e8(0x0F); self.cg_e8(0x05);                        // syscall
        cur := self.cg_nnext(cur);
        continue;
      }
      // #2154: dasselbe fuer win64 — ueber win_print_strn (WriteFile mit der
      // Literallaenge) statt _lyx_print_str, das am ersten Nullbyte endet.
      // Kein roher Syscall (tests/win64_syscalls_test.sh), sondern ein Aufruf
      // in den Helferbereich.
      if (isStderr == 0 && self.msAbi != 0 && self.cg_nkind(cur) == CGN_LIT_STR) {
        var wlOff: int64 := self.cg_addStr(self.cg_nsoff(cur), self.cg_nslen(cur));
        var wlLen: int64 := self.dataLen - wlOff - 1;
        self.cg_emitLeaRdiData(wlOff);
        self.cg_e8(0xBE); self.cg_e32(wlLen);                      // mov esi, laenge
        var wlPp: int64 := self.cg_emitCall();
        poke32(self.code + wlPp, CG_H_WIN_PRINTSTRN - wlPp - 4);
        cur := self.cg_nnext(cur);
        continue;
      }
      var pt: int64 := self.cg_inferPrintType(cur);
      self.cg_genExpr(cur);
      // mov rdi, rax
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);
      if (pt == 1) {
        var pp: int64 := self.cg_emitCall();
        poke32(self.code + pp, hStr - pp - 4);
      } else if (pt == 2) {
        // #1049: f64 ueber _lyx_f64_to_str ausgeben. Hier stand ein Platzhalter,
        // der die Konstante "0.0" emittierte und den ausgewerteten Wert verwarf —
        // Print(1.5) gab damit 0.0 aus, ohne Meldung. Der Umwandler war die ganze
        // Zeit vorhanden und wird von PrintFloat und vom %f-Fall in cg_genPrintf
        // genauso benutzt; die Bits liegen an dieser Stelle bereits in rdi.
        var pp: int64 := self.cg_emitCall();
        poke32(self.code + pp, CG_H_F64STR - pp - 4);
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);  // mov rdi, rax
        var ppFs: int64 := self.cg_emitCall();
        poke32(self.code + ppFs, hStr - ppFs - 4);
      } else if (pt == 3) {
        var pbTOff: int64 := self.dataLen;
        self.cg_edata(116); self.cg_edata(114); self.cg_edata(117); self.cg_edata(101); self.cg_edata(0);
        var pbFOff: int64 := self.dataLen;
        self.cg_edata(102); self.cg_edata(97); self.cg_edata(108); self.cg_edata(115); self.cg_edata(101); self.cg_edata(0);
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);  // test rdi, rdi
        self.cg_e8(0x74);                                        // jz .pbFalse
        var pbFJ: int64 := self.codeLen; self.cg_e8(0);
        self.cg_emitLeaRdiData(pbTOff);
        var ppbT: int64 := self.cg_emitCall();
        poke32(self.code + ppbT, hStr - ppbT - 4);
        self.cg_e8(0xEB);                                        // jmp .pbEnd
        var pbEJ: int64 := self.codeLen; self.cg_e8(0);
        cg_patchRel8(self.code, pbFJ, self.codeLen);
        self.cg_emitLeaRdiData(pbFOff);
        var ppbF: int64 := self.cg_emitCall();
        poke32(self.code + ppbF, hStr - ppbF - 4);
        cg_patchRel8(self.code, pbEJ, self.codeLen);
      } else {
        var pp: int64 := self.cg_emitCall();
        poke32(self.code + pp, hInt - pp - 4);
      }
      cur := self.cg_nnext(cur);
    }
    if (addNewline == 1) {
      var nlOff: int64 := self.dataLen;
      self.cg_edata(10); self.cg_edata(0);
      self.cg_emitLeaRdiData(nlOff);
      var ppNL: int64 := self.cg_emitCall();
      poke32(self.code + ppNL, hStr - ppNL - 4);
    }
    self.cg_zeroRax();
  }

  // #1012: Printf(fmt, a1, a2, …) — Formatausgabe im x86-Codegen.
  //
  // Der Formatstring wird zur ÜBERSETZUNGSZEIT zerlegt: jeder Literalabschnitt
  // wird zu einem Datenkonstanten-Aufruf von _lyx_print_str, jeder Platzhalter
  // zu genau der Ausgaberoutine, die sein Typ verlangt. Damit braucht es weder
  // varargs (die Lyx nicht hat) noch einen Format-Interpreter zur Laufzeit.
  //
  // Zulaessig sind %s, %d, %f, %c und %%. Alles andere ist ein Fehler --
  // ein unbekannter Platzhalter, der einfach durchgereicht wird, waere wieder
  // ein stiller Default. Ebenso zaehlt die Argumentzahl gegen die Platzhalter.
  fn cg_genPrintf(fmtNode: int64, argNode: int64) {
    if (fmtNode < 0 || self.cg_nkind(fmtNode) != CGN_LIT_STR) {
      EPrintStrLn("error: Printf verlangt ein Zeichenkettenliteral als Format"c);
      EPrintStrLn("  Der Format-String wird zur Uebersetzungszeit zerlegt; ein zur Laufzeit"c);
      EPrintStrLn("  berechneter Wert kann dort nicht stehen."c);
      exit(1);
    }

    // Quelltextbereich des Literals ohne Anfuehrungszeichen und ohne 'c'-Suffix
    var sOff: int64 := self.cg_nsoff(fmtNode);
    var sLen: int64 := self.cg_nslen(fmtNode);
    var pEnd: int64 := sOff + sLen - 1;
    if (StrCharAt(self.pSrc, sOff + sLen - 1) == 99) { pEnd := pEnd - 1; }
    var i: int64 := sOff + 1;

    var cur: int64 := argNode;
    while (i < pEnd) {
      var c: int64 := StrCharAt(self.pSrc, i) & 255;

      if (c != 37) {
        // Literalabschnitt bis zum naechsten '%' als Datenkonstante ausgeben
        var dOff: int64 := self.dataLen;
        var wrote: int64 := 0;
        var stop: int64 := 0;
        while (i < pEnd && stop == 0) {
          var lc: int64 := StrCharAt(self.pSrc, i) & 255;
          if (lc == 37) { stop := 1; }   // '%' erreicht — i bleibt darauf stehen
          else {
            if (lc == 92 && i + 1 < pEnd) {   // '\' — Escape aufloesen
              i := i + 1;
              var ec: int64 := StrCharAt(self.pSrc, i) & 255;
              if (ec == 110)      { lc := 10; }   // \n
              else if (ec == 116) { lc := 9;  }   // \t
              else if (ec == 114) { lc := 13; }   // \r
              else if (ec == 48)  { lc := 0;  }   // \0
              else                { lc := ec; }   // \\ , \" , sonst wortwoertlich
            }
            self.cg_edata(lc);
            wrote := wrote + 1;
            i := i + 1;
          }
        }
        self.cg_edata(0);
        if (wrote > 0) {
          self.cg_emitLeaRdiData(dOff);
          var ppL: int64 := self.cg_emitCall();
          poke32(self.code + ppL, CG_H_PRINTSTR - ppL - 4);
        }

      } else {
        // Platzhalter
        i := i + 1;
        if (i >= pEnd) {
          EPrintStrLn("error: Printf-Format endet mit einem einzelnen '%'"c);
          exit(1);
        }
        var spec: int64 := StrCharAt(self.pSrc, i) & 255;
        i := i + 1;

        if (spec == 37) {
          // %% → ein Prozentzeichen
          var pcOff: int64 := self.dataLen;
          self.cg_edata(37); self.cg_edata(0);
          self.cg_emitLeaRdiData(pcOff);
          var ppP: int64 := self.cg_emitCall();
          poke32(self.code + ppP, CG_H_PRINTSTR - ppP - 4);
        } else {
          if (cur < 0) {
            EPrintStrLn("error: Printf hat mehr Platzhalter als Argumente"c);
            exit(1);
          }
          self.cg_genExpr(cur);
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);   // mov rdi, rax
          cur := self.cg_nnext(cur);

          if (spec == 115) {          // %s
            var ppS: int64 := self.cg_emitCall();
            poke32(self.code + ppS, CG_H_PRINTSTR - ppS - 4);
          } else if (spec == 100) {   // %d
            var ppD: int64 := self.cg_emitCall();
            poke32(self.code + ppD, CG_H_PRINTINT - ppD - 4);
          } else if (spec == 102) {   // %f — Bits nach _lyx_f64_to_str, dann ausgeben
            var ppF: int64 := self.cg_emitCall();
            poke32(self.code + ppF, CG_H_F64STR - ppF - 4);
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);  // mov rdi, rax
            var ppFs: int64 := self.cg_emitCall();
            poke32(self.code + ppFs, CG_H_PRINTSTR - ppFs - 4);
          } else if (spec == 99) {    // %c — ein Byte direkt schreiben
            self.cg_e8(0x57);                                        // push rdi
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE6);   // mov rsi, rsp
            self.cg_e8(0xBA); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov edx,1
            self.cg_e8(0xBF); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov edi,1
            self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax,1
            self.cg_e8(0x0F); self.cg_e8(0x05);                      // syscall
            self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x08);  // add rsp,8
          } else {
            EPrintStr("error: Printf kennt den Platzhalter '%"c);
            sys_write(2, self.pSrc as int64 + i - 1, 1);
            EPrintStrLn("' nicht — zulaessig sind %s, %d, %f, %c und %%"c);
            exit(1);
          }
        }
      }
    }

    if (cur >= 0) {
      EPrintStrLn("error: Printf hat mehr Argumente als Platzhalter"c);
      exit(1);
    }
    self.cg_zeroRax();
  }

  // Generate a function call (NK_CALL node)
  // #1311: Sieben Namen existieren sowohl als Builtin als auch als `pub fn` in
  // std/ — ArgvGetStr, FileSize, FloatToStr, Print, StrFind, StrSplit, StrTrim.
  // Der Builtin gewann bisher IMMER, unabhaengig von der Argumentzahl: die
  // ueberzaehligen Argumente verpufften, die Unit-Funktion war vom Programm aus
  // unerreichbar, und heraus kam ein plausibel aussehender Muellwert.
  //
  // Belegt an zwei Stellen im eigenen Bestand, die genau deshalb still falsch
  // liefen: tests/feature_checks/strings/test_stringbuilder.lyx ruft
  // StrSplit(s, ",", parts, 10) — die Vier-Argument-Form aus std/string.lyx —
  // und tests/feature_checks/stdlib/test_filereadall.lyx ruft
  // ArgvGetStr(argc, argv, "check") aus std/env.lyx. Beide bedienten den
  // Builtin mit seiner Zwei-Argument-Form.
  //
  // Deshalb wird hier NICHT abgewiesen, sondern durchgereicht: passt die
  // Argumentzahl nicht zur Builtin-Form, ist die gleichnamige Unit-Funktion
  // gemeint. Ein harter Fehler waere das falsche Mittel — er wuerde
  // Aufrufstellen brechen, die die richtige Funktion meinen und deren einziger
  // Fehler es ist, dass es den Builtin ueberhaupt gibt.
  //
  // Print/PrintLn bleiben aussen vor: sie sind variadisch, eine Erwartung an
  // die Argumentzahl gibt es dort nicht.
  // #2082: Definiert die gerade uebersetzte Unit selbst eine Funktion MIT
  // RUMPF dieses Namens? Dann verdeckt sie den gleichnamigen Builtin (ebnf.md,
  // Builtins). Bis 1.2.13D pruefte cg_genCall die Builtin-Kette vor den
  // Nutzerfunktionen: `fn StrLen(p: pchar): int64 { return 99; }` lieferte auf
  // x86 3, auf arm64/riscv 99.
  //
  // Gefragt wird nur die eigene Unit (topLevelHead), keine importierte —
  // `import std.io` bringt `pub fn Print(s: pchar)` mit, und `Print(42)` muss
  // der Builtin bleiben. Eine extern-Deklaration hat keinen Rumpf (c2 = -1)
  // und ist keine Definition. ACHTUNG #1287: mit `@cap(...)` legt der Parser
  // die Annotation in c2 ab — "c2 >= 0" hiesse dann "hat Rumpf", und jeder
  // Aufruf einer solchen extern-Funktion liefe hier am PLT-Pfad vorbei.
  // Dieselbe Rumpfpruefung wie in cg_genFile (exHasBody), die beiden muessen
  // uebereinstimmen.
  //
  // Dieselbe Frage wie _eigeneUnitDefiniert in ir_lower.lyx — die beiden
  // muessen uebereinstimmen.
  fn cg_eigeneUnitDefiniert(fname: pchar, fnlen: int64): int64 {
    // #2175: aus dem Funktionsindex statt durch Ablaufen der obersten Ebene
    if (self.topLevelHead < 0) { return 0; }
    var e: int64 := self.cg_tlEintrag();
    var i: int64 := self.cg_hxSuch(peek64(e + 32), peek64(e + 24), 32, 8, fname, fnlen);
    if (i < 0) { return 0; }
    return peek64(peek64(e + 24) + i * 32 + 24);
  }

  // #2175: erste Funktionsdeklaration der obersten Ebene mit diesem Namen
  // (Knotenindex) oder -1 — was cg_genCall bis 1.2.18B je Aufruf durch
  // Ablaufen der ganzen Ebene ermittelte.
  fn cg_tlErsteFunc(fname: pchar, fnlen: int64): int64 {
    if (self.topLevelHead < 0) { return 0 - 1; }
    var e: int64 := self.cg_tlEintrag();
    var i: int64 := self.cg_hxSuch(peek64(e + 32), peek64(e + 24), 32, 8, fname, fnlen);
    if (i < 0) { return 0 - 1; }
    return peek64(peek64(e + 24) + i * 32 + 16);
  }

  // #2175: Funktionsindex der obersten Ebene, beim ersten Zugriff in einem
  // Durchlauf gebaut. Schluessel: Knotentabelle, Kopf und Quelltext — der
  // Codegen schreibt nie in die Knoten, die Ebene aendert sich also nicht.
  // Eintrag: [0] pNodes, [8] Kopf, [16] pSrc, [24] Namenstabelle, [32] Index.
  // Namenstabelle je Name (32 Byte): Zeiger, Laenge, ERSTE Deklaration,
  // 1 wenn irgendeine gleichnamige einen Rumpf hat (cg_eigeneUnitDefiniert).
  fn cg_tlEintrag(): int64 {
    var kn: int64 := self.pNodes;
    var kh: int64 := self.topLevelHead;
    var ks: int64 := self.pSrc as int64;
    if (self.tlAnz > 0) {
      var le: int64 := self.tlTab + self.tlLetzt * 48;
      if (peek64(le) == kn && peek64(le + 8) == kh && peek64(le + 16) == ks) { return le; }
    }
    var k: int64 := 0;
    while (k < self.tlAnz) {
      var ke: int64 := self.tlTab + k * 48;
      if (peek64(ke) == kn && peek64(ke + 8) == kh && peek64(ke + 16) == ks) { self.tlLetzt := k; return ke; }
      k += 1;
    }
    if (self.tlAnz >= self.tlCap) {
      var nc: int64 := self.tlCap * 2;
      var nb: int64 := alloc(nc * 48);
      memcpy(nb, self.tlTab, self.tlAnz * 48);
      self.tlTab := nb; self.tlCap := nc;
    }
    var cap: int64 := 64;
    var tab: int64 := alloc(cap * 32);
    var anz: int64 := 0;
    var hx: int64 := self.cg_hxNeu(128);
    var d: int64 := kh;
    while (d >= 0) {
      if (self.cg_nkind(d) == CGN_FUNC_DECL) {
        var dn: pchar := self.cg_nsval(d);
        var dl: int64 := self.cg_nslen(d);
        // Dieselbe Rumpfpruefung wie bisher (siehe Kommentar ueber
        // cg_eigeneUnitDefiniert, #1287).
        var rumpf: int64 := self.cg_nc2(d);
        var hatRumpf: int64 := 0;
        if (rumpf >= 0 && self.cg_nkind(rumpf) != CGN_CAPABILITY_ATTR) { hatRumpf := 1; }
        var vi: int64 := self.cg_hxSuch(hx, tab, 32, 8, dn, dl);
        if (vi >= 0) {
          if (hatRumpf != 0) { poke64(tab + vi * 32 + 24, 1); }
        } else {
          if (anz >= cap) {
            var nt: int64 := alloc(cap * 2 * 32);
            memcpy(nt, tab, anz * 32);
            tab := nt; cap := cap * 2;
          }
          var b: int64 := tab + anz * 32;
          poke64(b, dn as int64); poke64(b + 8, dl); poke64(b + 16, d); poke64(b + 24, hatRumpf);
          hx := self.cg_hxEin(hx, tab, 32, 8, anz);
          anz += 1;
        }
      }
      d := self.cg_nnext(d);
    }
    var e: int64 := self.tlTab + self.tlAnz * 48;
    poke64(e, kn); poke64(e + 8, kh); poke64(e + 16, ks); poke64(e + 24, tab); poke64(e + 32, hx);
    self.tlLetzt := self.tlAnz;
    self.tlAnz += 1;
    return e;
  }

  fn cg_builtinArity(name: pchar, nlen: int64): int64 {
    if (self.cg_seq(name, nlen, "StrSplit",   8))  { return 2; }
    if (self.cg_seq(name, nlen, "StrFind",    7))  { return 2; }
    if (self.cg_seq(name, nlen, "StrTrim",    7))  { return 1; }
    if (self.cg_seq(name, nlen, "FloatToStr", 10)) { return 1; }
    if (self.cg_seq(name, nlen, "FileSize",   8))  { return 1; }
    if (self.cg_seq(name, nlen, "ArgvGetStr", 10)) { return 2; }
    return 0 - 1;
  }

  // #1249: Faengt dieses Lambda etwas aus seiner Umgebung ein?
  fn cg_closureCaptures(ni: int64): int64 {
    if (ni < 0) { return 0; }
    if (self.cg_nkind(ni) != CGN_CLOSURE) { return 0; }
    // #2133: in eigene Listen suchen; die des umgebenden Lambdas bleiben
    // unberuehrt (bis dahin wurde nur die Anzahl gerettet — die Namen und
    // Offsets des Lambdas, in dessen Rumpf diese Frage gestellt wird, waren
    // danach ueberschrieben).
    var sB: int64 := self.closureCapturedBuf;
    var sL: int64 := self.closureCapturedLenBuf;
    var sO: int64 := self.closureCapturedOutBuf;
    var sI: int64 := self.closureCapturedIdxBuf;
    var sE: int64 := self.closureCapturedEnvBuf;
    var saved: int64 := self.closureCapturedCount;
    self.cg_capSuche(self.cg_nc2(ni), self.cg_nc0(ni));
    var cnt: int64 := self.closureCapturedCount;
    self.closureCapturedBuf    := sB;
    self.closureCapturedLenBuf := sL;
    self.closureCapturedOutBuf := sO;
    self.closureCapturedIdxBuf := sI;
    self.closureCapturedEnvBuf := sE;
    self.closureCapturedCount  := saved;
    return cnt;
  }

  // #1249: Ein EINFANGENDES Lambda in einem `fn(...)`-Ziel. Ein solcher Typ
  // traegt acht Byte — eine Adresse. Die eingefangene Umgebung liegt daneben
  // und hat dort keinen Platz; der Aufruf ueber diesen Typ springt an die
  // Adresse und laesst die Umgebung weg. Bisher entstand daraus ein SIGSEGV
  // ohne jede Meldung, weil der Wert ein {fnPtr,env}-Satz war und der Sprung
  // mitten hinein ging.
  //
  // Ohne Captures ist das Lambda seit 1.0.16I eine gewoehnliche Funktion und
  // passt in den Typ. Mit Captures braucht es einen Typ, der beides traegt —
  // den gibt es noch nicht, also wird gemeldet statt geraten.
  fn cg_rejectCapturingClosure(ni: int64, wo: pchar) {
    if (self.cg_closureCaptures(ni) <= 0) { return; }
    EPrintStr("codegen error: einfangendes Lambda "c);
    sys_write(2, wo as int64, StrLen(wo));
    EPrintStrLn(" (#1249)"c);
    EPrintStrLn("  Ein `fn(...)`-Typ traegt nur eine Adresse, nicht die eingefangene Umgebung."c);
    EPrintStrLn("  Ohne Einfangen passt das Lambda; sonst die Werte als Parameter uebergeben."c);
    exit(1);
  }

  // #1252: Argumente eines Aufrufs in die Reihenfolge der PARAMETER bringen und
  // Luecken mit dem Vorgabewert schliessen.
  //
  // sema sortiert benannte Argumente selbst um — aber nur, wenn jeder Parameter
  // belegt ist. Fehlt einer, der einen Vorgabewert hat (`G(1, c: 9)`), bleibt
  // eine Luecke mitten in der Kette, und sema kann sie nicht schliessen: dafuer
  // braeuchte es einen neuen Knoten, und die Knotenarena gehoert dem Parser.
  // Hier ist der Vorgabewert dagegen zur Hand — der Codegen wertet ihn fuer
  // HINTERE Parameter ohnehin aus (WP-MEM-05).
  //
  // Ergebnis in self.cgOrdBuf, Rueckgabe = Zahl der Argumente. -1 heisst
  // "nicht zustaendig": dann bleibt es beim bisherigen Weg ueber die Kette.
  // Das ist Absicht — angefasst wird nur der Fall, den #1252 nennt.
  fn cg_orderCallArgs(defFuncNi: int64, argNode: int64): int64 {
    var pc: int64 := 0;
    var pp: int64 := self.cg_nc0(defFuncNi);
    while (pp >= 0) { pc := pc + 1; pp := self.cg_nnext(pp); }
    if (pc <= 0 || pc > 32) { return 0 - 1; }

    // Beim Testen von #1252 aufgefallen und hier mit erledigt: der Pfad fuer
    // SIEBEN und mehr Argumente setzte Vorgabewerte ueberhaupt nicht ein — er
    // baut seine Liste aus der Knotenkette, und der Nachlauf, der die hinteren
    // Parameter ergaenzt, steht nur im Pfad fuer bis zu sechs. `H(1,2,3,4,5,6)`
    // mit zwei Vorgabewerten uebergab also sechs Argumente an eine Funktion mit
    // acht Parametern: die Werte lagen verschoben, das Ergebnis war Muell (mit
    // 1.0.16F nachgemessen). Deshalb ordnet diese Stelle JEDEN Aufruf mit einer
    // Luecke — mit benanntem Argument oder ohne.
    var a: int64 := argNode;
    var buf: int64 := alloc(pc * 8);
    var i: int64 := 0;
    while (i < pc) { poke64(buf + i * 8, 0 - 1); i := i + 1; }

    var posIdx: int64 := 0;
    var okOrder: int64 := 1;
    a := argNode;
    while (a != -1) {
      var slotIdx: int64 := 0 - 1;
      if (self.cg_nkind(a) == CGN_NAMED_ARG) {
        var an: pchar := self.cg_nsval(a);
        var al: int64 := self.cg_nslen(a);
        var q: int64 := self.cg_nc0(defFuncNi);
        var qi: int64 := 0;
        while (q >= 0) {
          if (self.cg_seq(self.cg_nsval(q), self.cg_nslen(q), an, al)) { slotIdx := qi; }
          qi := qi + 1;
          q := self.cg_nnext(q);
        }
      } else {
        slotIdx := posIdx;
        posIdx := posIdx + 1;
      }
      // Unbekannter Name, doppelte Belegung, zu viele Argumente: sema hat das
      // bereits gemeldet. Hier wird nur nicht geordnet — eine zweite Meldung
      // waere Laerm, ein Raten waere schlimmer.
      if (slotIdx < 0 || slotIdx >= pc) { okOrder := 0; }
      else {
        if (peek64(buf + slotIdx * 8) >= 0) { okOrder := 0; }
        else { poke64(buf + slotIdx * 8, a); }
      }
      a := self.cg_nnext(a);
    }

    // Luecken schliessen — und feststellen, ob es ueberhaupt welche gab.
    var hasGap: int64 := 0;
    if (okOrder != 0) {
      var pn: int64 := self.cg_nc0(defFuncNi);
      i := 0;
      while (i < pc) {
        if (peek64(buf + i * 8) < 0) {
          var dflt: int64 := 0 - 1;
          if (pn >= 0) { dflt := self.cg_nc1(pn); }
          if (dflt < 0) { okOrder := 0; }
          else { poke64(buf + i * 8, dflt); hasGap := 1; }
        }
        if (pn >= 0) { pn := self.cg_nnext(pn); }
        i := i + 1;
      }
    }

    // #2219: Ein ganzzahliges Literal an einem Gleitkomma-Parameter muss
    // GEWANDELT werden. Bis 1.2.19E ging es als Bitmuster ins Register: die
    // Ganzzahl 3 ist als double eine Denormalzahl nahe null, deshalb lieferte
    // `eins(5)` 0.00 und `mittel(3, 4.0)` 2.00 — ohne Meldung. Eine
    // ganzzahlige VARIABLE weist sema korrekt ab; nur das Literal kommt
    // durch, und die Uebergabe hat die Wandlung nicht nachgezogen.
    //
    // Dieselbe Rechnung steht schon zweimal im Haus: `cg_retToF64` bei der
    // Rueckgabe (#2004) und `cg_emitMixedToF64` bei gemischter Arithmetik
    // (#1212). Hier wird sie nicht ein drittes Mal geschrieben, sondern ueber
    // einen CGN_CAST auf den Parametertyp geholt — denselben Weg, den `x as
    // f64` geht, und denselben, den die Einbettung fuer schmale Parameter
    // benutzt (#2209).
    //
    // Gewandelt wird HIER und nicht an den Auswertungsstellen, weil es neun
    // davon gibt (bis sechs Argumente, mehr als sechs, Methode, statischer
    // Aufruf, Vorgabewerte, ...). Acht davon zu vergessen ist genau die
    // Falle, aus der dieser Defekt kommt. Diese Stelle ist die gemeinsame
    // Quelle: argBuf wird aus cgOrdBuf gefuellt, sobald geordnet wurde.
    var brauchtKonv: int64 := 0;
    if (okOrder != 0) {
      var kn: int64 := self.cg_nc0(defFuncNi);
      i := 0;
      while (i < pc && kn >= 0) {
        var av: int64 := peek64(buf + i * 8);
        var pt: int64 := self.cg_nc0(kn);
        if (av >= 0 && pt >= 0
            && self.cg_isFloatTypeName(self.cg_nsval(pt), self.cg_nslen(pt)) != 0) {
          // Bei einem benannten Argument steckt der Wert in c0 (nc0=value).
          var wert: int64 := av;
          if (self.cg_nkind(av) == CGN_NAMED_ARG) { wert := self.cg_nc0(av); }
          if (self.cg_istSicherGanz(wert) != 0) {
            var cst: int64 := self.cg_neuerKnoten();
            var coff: int64 := self.cg_noff(cst);
            poke64(coff + CG_OFF_KIND, CGN_CAST);
            poke64(coff + CG_OFF_C0,   av);
            poke64(coff + CG_OFF_C1,   pt);
            poke64(coff + CG_OFF_C2,   0 - 1);
            poke64(coff + CG_OFF_C3,   0 - 1);
            poke64(coff + CG_OFF_NEXT, 0 - 1);
            poke64(buf + i * 8, cst);
            brauchtKonv := 1;
          }
        }
        kn := self.cg_nnext(kn);
        i := i + 1;
      }
    }

    // Geordnet wird jetzt aus DREI Gruenden: eine Luecke, ein benanntes
    // Argument — oder eine noetige Wandlung. Ohne den dritten liefe der
    // gewoehnliche Aufruf weiter ueber die Knotenkette und saehe die
    // Cast-Knoten nie.
    if (okOrder == 0 || (hasGap == 0 && brauchtKonv == 0)) { free(buf, pc * 8); return 0 - 1; }
    self.cgOrdBuf := buf;
    return pc;
  }

  // #1262: Ist `name` einer der Import-Aliase?
  fn cg_isAlias(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.cgAliasTabCount) {
      if (peek64(self.cgAliasTab + i * 16 + 8) == nameLen) {
        if (self.cg_seq(peek64(self.cgAliasTab + i * 16) as pchar, nameLen, name, nameLen)) { return 1; }
      }
      i := i + 1;
    }
    return 0;
  }

  // #1637: Den Deklarationsknoten einer METHODE finden — fuer die
  // Vorgabewerte. Fuer freie Funktionen steht der Knoten direkt in der
  // Modulkette; eine Methode haengt dagegen unter ihrer Klasse (c1 des
  // TYPE_DECL). Weil es diese Suche nicht gab, blieb der Aufruf mit
  // weggelassenem Argument ohne Wert: `t.M(1)` uebergab nur ein Argument an
  // eine Methode mit zwei Parametern, der zweite trug, was im Register stand.
  // Gesucht wird bei der Klasse, die die Methode DEKLARIERT — bei einer
  // geerbten Methode steht der Rumpf und damit die Vorgabe in der Basisklasse.
  fn cg_findMethodDeclNi(classIdx: int64, mname: pchar, mlen: int64): int64 {
    if (classIdx < 0 || self.topLevelHead < 0) { return 0 - 1; }
    var ownIdx: int64 := self.cg_findMethodOwner(classIdx, mname, mlen);
    if (ownIdx < 0) { ownIdx := classIdx; }
    var decl: int64 := self.cg_klassenDeklNi(ownIdx);
    if (decl < 0) { return 0 - 1; }
    var m: int64 := self.cg_nc1(decl);
    while (m >= 0) {
      if (self.cg_nslen(m) == mlen
          && self.cg_seq(self.cg_nsval(m), self.cg_nslen(m), mname, mlen) != 0) {   // #2176
        return m;
      }
      m := self.cg_nnext(m);
    }
    return 0 - 1;
  }

  // #2173: Knoten der Typdeklaration von Klasse ci in der AKTUELLEN
  // Knotentabelle (-1 = dort nicht deklariert). Bis 1.2.20G lief
  // cg_findMethodDeclNi fuer jeden Methodenaufruf ueber alle Top-Level-
  // Deklarationen (7,9 % inklusive im Selbstbau). Gemerkt wird je Klasse mit
  // dem Schluessel {pNodes, topLevelHead}: der Codegen wechselt die Tabelle
  // je Unit (Importe), und die Tabellen stammen aus einer Arena, die nichts
  // freigibt — dieselbe Adresse heisst dieselbe Unit.
  fn cg_klassenDeklNi(ci: int64): int64 {
    if (ci >= self.mdCacheCap) {
      var nc: int64 := self.mdCacheCap * 2;
      if (nc < 64) { nc := 64; }
      while (nc <= ci) { nc := nc * 2; }
      var nb: int64 := alloc(nc * 24);
      var z: int64 := 0;
      while (z < nc * 24) { poke64(nb + z, 0); z += 8; }
      if (self.mdCacheCap > 0) { memcpy(nb, self.mdCache, self.mdCacheCap * 24); }
      self.mdCache := nb;
      self.mdCacheCap := nc;
    }
    var e: int64 := self.mdCache + ci * 24;
    if (peek64(e) == self.pNodes && peek64(e + 8) == self.topLevelHead + 1) {
      return peek64(e + 16);
    }
    var cBase: int64 := self.classLayouts + ci * CG_CLASS_SZ;
    var cName: pchar := peek64(cBase) as pchar;
    var cLen:  int64 := peek64(cBase + CG_CLASS_OFF_NAMELEN);
    var gefunden: int64 := 0 - 1;
    var scan: int64 := self.topLevelHead;
    while (scan >= 0) {
      if (self.cg_nkind(scan) == CGN_TYPE_DECL) {
        if (self.cg_seq(self.cg_nsval(scan), self.cg_nslen(scan), cName, cLen) != 0) {
          gefunden := scan;
          break;
        }
      }
      scan := self.cg_nnext(scan);
    }
    poke64(e, self.pNodes);
    poke64(e + 8, self.topLevelHead + 1);   // +1: Kopf 0 ist gueltig, 0 im Speicher heisst "leer"
    poke64(e + 16, gefunden);
    return gefunden;
  }

  // #1655: Einen privaten Funktionsnamen der laufenden Unit vormerken.
  fn cg_unitPrivAdd(nm: pchar, nl: int64) {
    if (self.cgUnitPrivCnt >= self.cgUnitPrivCap) {
      var nc: int64 := self.cgUnitPrivCap * 2;
      var nb: int64 := alloc(nc * 16);
      memcpy(nb, self.cgUnitPrivTab, self.cgUnitPrivCnt * 16);
      self.cgUnitPrivTab := nb;
      self.cgUnitPrivCap := nc;
    }
    var b: int64 := self.cgUnitPrivTab + self.cgUnitPrivCnt * 16;
    poke64(b, nm as int64);
    poke64(b + 8, nl);
    self.cgUnitPrivCnt := self.cgUnitPrivCnt + 1;
  }

  // #1655: Vorlauf ueber eine Anweisungs-/Deklarationskette. Sammelt jede
  // nicht-oeffentliche Funktion der Unit. KLASSEN bleiben aussen vor: ihre
  // Methoden tragen ohnehin die Marke "Klasse_Methode", und ein gleichnamiger
  // freier Aufruf duerfte davon nicht umgelenkt werden.
  //
  // #2044: INNERE Funktionen ebenso. Bis 1.2.12A stieg der Vorlauf in jeden
  // Rumpf hinab und trug `fn w4(...)` (std/cloud/aws/sigv4.lyx) als privat
  // ein — ein freier Aufruf `w4(...)` an anderer Stelle der Unit, der eine
  // oeffentliche w4 eines Imports meint, ging damit an die innere. Innere
  // Funktionen haben seit #2044 eine eigene Marke (cg_nestPlan), die ihren
  // Praefix schon unit-lokal traegt.
  fn cg_unitPrivCollect(head: int64, tiefe: int64) {
    if (tiefe > 32) { return; }
    var cur: int64 := head;
    while (cur >= 0) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_FUNC_DECL) {
        if (peek64(self.cg_noff(cur) + CG_OFF_ISPUB) == 0) {
          self.cg_unitPrivAdd(self.cg_nsval(cur), self.cg_nslen(cur));
        }
        // Der Rumpf bleibt aussen vor (#2044, s. o.).
      } else if (k != CGN_TYPE_DECL) {
        self.cg_unitPrivCollect(self.cg_nc0(cur), tiefe + 1);
        self.cg_unitPrivCollect(self.cg_nc1(cur), tiefe + 1);
        self.cg_unitPrivCollect(self.cg_nc2(cur), tiefe + 1);
      }
      cur := self.cg_nnext(cur);
    }
  }

  // #1655: Traegt die gerade uebersetzte Unit eine NICHT-oeffentliche Funktion
  // dieses Namens? Nur dann gehoert der Aufruf an die unit-eigene Marke.
  // Findet sich nichts, bleibt der schlichte Name — dann meint der Aufruf eine
  // oeffentliche Funktion aus einer anderen Unit, und der bisherige Weg stimmt.
  fn cg_unitPrivHat(fname: pchar, fnlen: int64): int64 {
    if (self.cgUnitTag == 0) { return 0; }
    var i: int64 := 0;
    while (i < self.cgUnitPrivCnt) {
      var b: int64 := self.cgUnitPrivTab + i * 16;
      if (self.cg_seq(peek64(b) as pchar, peek64(b + 8), fname, fnlen) != 0) { return 1; }
      i := i + 1;
    }
    return 0;
  }

  // #2097/#2099: Private Modulvariablen und Konstanten der laufenden Unit.
  // Bis 1.2.13F lagen sie wie die oeffentlichen in EINER flachen Tabelle nach
  // blankem Namen: zwei Units mit `var gX` teilten sich still den Speicher
  // (cg_addGlobal gibt fuer einen bekannten Namen den vorhandenen Platz
  // zurueck), und bei `con X` gewann, wer zuletzt eingetragen wurde — welcher
  // Wert galt, hing an der Importreihenfolge des PROGRAMMS. Fuer private
  // Funktionen gibt es die Unit-Marke seit #1655; hier die zweite Stelle,
  // dieselbe Marke ("unit.name#X", cg_unitPrivMangle).
  //
  // Nur die oberste Ebene: ein `var` in einem Rumpf ist ein Local. Die Marke
  // wird einmal gebildet und haengt am Eintrag — die Uebersetzung unten
  // laeuft bei jedem Tabellenzugriff.
  fn cg_unitPrivVCollect(head: int64) {
    self.cgUnitPrivVTab := 0;
    self.cgUnitPrivVCnt := 0;
    if (self.cgUnitTag == 0) { return; }
    var n: int64 := 0;
    var cur: int64 := head;
    while (cur >= 0) {
      var k: int64 := self.cg_nkind(cur);
      if ((k == CGN_VAR_DECL || k == CGN_CON_DECL) && peek64(self.cg_noff(cur) + CG_OFF_ISPUB) == 0) { n := n + 1; }
      cur := self.cg_nnext(cur);
    }
    if (n == 0) { return; }
    self.cgUnitPrivVTab := alloc(n * 32);
    cur := head;
    while (cur >= 0) {
      var k2: int64 := self.cg_nkind(cur);
      if ((k2 == CGN_VAR_DECL || k2 == CGN_CON_DECL) && peek64(self.cg_noff(cur) + CG_OFF_ISPUB) == 0) {
        var lc: int64 := alloc(8);
        var mk: int64 := self.cg_unitPrivMangle(self.cg_nsval(cur), self.cg_nslen(cur), lc);
        var b: int64 := self.cgUnitPrivVTab + self.cgUnitPrivVCnt * 32;
        poke64(b, self.cg_nsval(cur) as int64);
        poke64(b + 8, self.cg_nslen(cur));
        poke64(b + 16, mk);
        poke64(b + 24, peek64(lc));
        self.cgUnitPrivVCnt := self.cgUnitPrivVCnt + 1;
      }
      cur := self.cg_nnext(cur);
    }
  }

  // #2097/#2099: Ist `name` eine private Modulvariable/Konstante der
  // laufenden Unit? Dann der Eintrag (Marke bei +16, Laenge bei +24), sonst
  // -1. Gilt fuer Modulvariablen UND Konstanten — die beiden Tabellen
  // (globalVars, conTable) fragen hier an JEDEM Eingang (cg_addGlobal,
  // cg_findGlobal, cg_findGlobalIdx, cg_addCon, cg_findConVal, cg_hasConVal,
  // cg_findConIdx). Eine Marke enthaelt "#" und trifft sich selbst nicht.
  fn cg_privIdx(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.cgUnitPrivVCnt) {
      var b: int64 := self.cgUnitPrivVTab + i * 32;
      if (peek64(b + 8) == nlen
          && self.cg_seq(peek64(b) as pchar, peek64(b + 8), name, nlen) != 0) { return i; }   // #2176
      i := i + 1;
    }
    return 0 - 1;
  }

  // #1655: "unit.name#fn" als Marke. Der Trenner ist derselbe wie beim
  // Namensraum-Alias (cg_mangleInto), der Unit-Name enthaelt Punkte und kann
  // deshalb mit keinem Bezeichner der Sprache zusammenfallen.
  fn cg_unitPrivMangle(fname: pchar, fnlen: int64, lenCell: int64): int64 {
    return self.cg_mangleInto(self.cgUnitTag as pchar, self.cgUnitTagLen,
                              fname, fnlen, lenCell);
  }

  // ------------------------------------------------------------------
  // #2208: Einbettung kleiner Funktionen
  // ------------------------------------------------------------------
  //
  // Gearbeitet wird mit einer KOPIE des Rumpfes, in der die Parameter schon
  // durch die Argumentknoten ersetzt sind. Danach ist es gewoehnlicher Code:
  // keine Stelle im Emitter braucht einen Sonderfall.
  //
  // Der erste Anlauf ersetzte stattdessen IM EMITTER und scheiterte: ein
  // Bezeichner wird an mindestens acht Stellen aufgeloest, die Schnellwege
  // der Registerzuteilung (#2114) gehen gar nicht ueber cg_genExpr. Ein
  // zweiter Anlauf legte die Argumente in frische Rahmenplaetze und gewann
  // nichts (49 ms gegen 51 ms), weil diese Plaetze nach der Zuteilung
  // entstehen. Nur die Kopie kommt an die 29 ms von Hand heran.

  // Ein Knoten in der Kopierablage; liefert seine Nummer (>= CG_INL_BASIS).
  fn cg_neuerKnoten(): int64 {
    if (self.inlNodeCount >= self.inlNodeCap) {
      var nc: int64 := self.inlNodeCap * 2;
      var nb: int64 := alloc(nc * 88);
      memcpy(nb, self.inlNodes, self.inlNodeCount * 88);
      self.inlNodes   := nb;
      self.inlNodeCap := nc;
    }
    var idx: int64 := self.inlNodeCount;
    self.inlNodeCount += 1;
    return idx + CG_INL_BASIS;
  }

  // Name -> einzusetzender Knoten. Liefert den EINTRAG (32 Byte) oder 0.
  //
  // Zwei Arten von Eintraegen, unterschieden durch CG_INL_OFF_ART:
  //   0 — Argument des Aufrufers. Es steht in SEINEM Baum; beim Kopieren
  //       darf darin nicht weiter ersetzt werden (`g(x)` mit einem Parameter
  //       namens `x` rekursierte sonst endlos).
  //   1 — Zwischenwert aus dem Rumpf (`var l := (x << n) & M32`). Er steht im
  //       Baum der eingebetteten Funktion und MUSS weiter ersetzt werden, denn
  //       er nennt ihre Parameter.
  fn cg_inlEintrag(name: pchar, nlen: int64): int64 {
    var i: int64 := self.inlArgCount - 1;
    while (i >= 0) {
      var base: int64 := self.inlArgList + i * CG_INL_EINTRAG;
      if (peek64(base + CG_INL_OFF_LEN) == nlen
          && self.cg_seq(peek64(base) as pchar, nlen, name, nlen)) {
        return base;
      }
      i -= 1;
    }
    return 0;
  }

  // Einen Eintrag anlegen.
  fn cg_inlPush(name: pchar, nlen: int64, ni: int64, art: int64, ptyp: int64) {
    if (self.inlArgCount >= self.inlArgCap) {
      var nc: int64 := self.inlArgCap * 2;
      var nb: int64 := alloc(nc * CG_INL_EINTRAG);
      memcpy(nb, self.inlArgList, self.inlArgCount * CG_INL_EINTRAG);
      self.inlArgList := nb; self.inlArgCap := nc;
    }
    var base: int64 := self.inlArgList + self.inlArgCount * CG_INL_EINTRAG;
    poke64(base,                   name as int64);
    poke64(base + CG_INL_OFF_LEN,  nlen);
    poke64(base + CG_INL_OFF_NI,   ni);
    poke64(base + CG_INL_OFF_ART,  art);
    poke64(base + CG_INL_OFF_PTYP, ptyp);
    self.inlArgCount += 1;
  }

  // Wie oft nennt der Teilbaum (samt Geschwistern) diesen Namen?
  fn cg_inlZaehl(ni: int64, name: pchar, nlen: int64): int64 {
    if (ni < 0) { return 0; }
    var n: int64 := 0;
    if (self.cg_nkind(ni) == CGN_IDENT
        && self.cg_seq(self.cg_nsval(ni), self.cg_nslen(ni), name, nlen)) { n := 1; }
    n += self.cg_inlZaehl(self.cg_nc0(ni), name, nlen);
    n += self.cg_inlZaehl(self.cg_nc1(ni), name, nlen);
    n += self.cg_inlZaehl(self.cg_nc2(ni), name, nlen);
    n += self.cg_inlZaehl(self.cg_nc3(ni), name, nlen);
    n += self.cg_inlZaehl(self.cg_nnext(ni), name, nlen);
    return n;
  }

  // Teilbaum kopieren. `mitNext` 0 schneidet die Geschwisterkette ab — ein
  // Argumentknoten haengt in der Argumentliste des Aufrufers, und die darf
  // nicht in den Rumpf wandern. `inArg` 1 heisst: wir kopieren gerade einen
  // Argumentausdruck des Aufrufers, dort wird NICHT mehr ersetzt (sonst
  // rekursiert `g(x)` mit einem Parameter namens `x` endlos).
  fn cg_klonKnoten(ni: int64, tiefe: int64, mitNext: int64, inArg: int64): int64 {
    if (ni < 0) { return 0 - 1; }
    if (tiefe > 64) {
      EPrintStrLn("error: codegen: Einbettung zu tief verschachtelt (#2208)"c);
      exit(1);
    }
    if (inArg == 0 && self.cg_nkind(ni) == CGN_IDENT) {
      var e: int64 := self.cg_inlEintrag(self.cg_nsval(ni), self.cg_nslen(ni));
      // Der eingesetzte Knoten wird KOPIERT, nicht eingehaengt: ein
      // Argumentknoten traegt sein `next` aus der Liste des Aufrufers.
      if (e != 0) {
        var ers: int64 := self.cg_klonKnoten(peek64(e + CG_INL_OFF_NI), tiefe + 1, 0,
                                             1 - peek64(e + CG_INL_OFF_ART));
        // #2209: Ist der Parameter eine schmale Ganzzahl, KUERZT der Eintritt
        // in die Funktion den Wert — `fn f(x: int8)` mit `f(200)` sieht -56.
        // Diese Stelle fehlte zuerst, und der Test meldete es laut
        // (tests/int_width_test.sh: '200' erwartet '-56'). Meine Annahme, am
        // Rahmen haenge nur die Gleitkomma-Wandlung, war falsch: sie kam
        // daher, dass ich nur den return-Zweig gelesen hatte und nicht
        // Prolog und Epilog.
        //
        // Nachgeholt wird sie mit der vorhandenen Umsetzung: ein CGN_CAST auf
        // den Parametertyp. Dessen Emitter ruft cg_emitNarrowRax ueber
        // cg_narrowKindOf — dieselbe Stelle, die `x as int8` benutzt (#1151).
        // Eine eigene Kuerzung hier waere die zweite Rechnung, die irgendwann
        // von der ersten abweicht.
        var ptyp: int64 := peek64(e + CG_INL_OFF_PTYP);
        if (ptyp >= 0 && ers >= 0
            && self.cg_narrowKindOf(self.cg_nsval(ptyp), self.cg_nslen(ptyp)) != 0) {
          var cst: int64 := self.cg_neuerKnoten();
          var coff: int64 := self.cg_noff(cst);
          poke64(coff + CG_OFF_KIND, CGN_CAST);
          poke64(coff + CG_OFF_C0,   ers);
          poke64(coff + CG_OFF_C1,   ptyp);
          poke64(coff + CG_OFF_C2,   0 - 1);
          poke64(coff + CG_OFF_C3,   0 - 1);
          poke64(coff + CG_OFF_NEXT, 0 - 1);
          ers := cst;
        }
        // #2228: Steht der ersetzte Bezeichner in einer Liste (Argumente
        // eines Aufrufs im Rumpf), gehoert seine Geschwisterkette an die
        // Ersetzung. Die wurde oben ohne `next` kopiert, und bis hierher fiel
        // `pos` in `StrCharAt(s, pos)` still weg: rsi blieb, was es war, und
        // der Datumsparser las Muell (tests/datetime_runde5_test.sh, #1603).
        // Vor #2228 kam kein Aufruf im Rumpf vor, also keine solche Liste.
        if (mitNext != 0 && ers >= 0) {
          var kette: int64 := self.cg_klonKnoten(self.cg_nnext(ni), tiefe + 1, 1, inArg);
          poke64(self.cg_noff(ers) + CG_OFF_NEXT, kette);
        }
        return ers;
      }
    }
    var neu:  int64 := self.cg_neuerKnoten();
    var qoff: int64 := self.cg_noff(ni);
    var zoff: int64 := self.cg_noff(neu);
    var i: int64 := 0;
    while (i < 88) { poke8(zoff + i, peek8(qoff + i)); i += 1; }
    var k0: int64 := self.cg_klonKnoten(self.cg_nc0(ni), tiefe + 1, 1, inArg);
    var k1: int64 := self.cg_klonKnoten(self.cg_nc1(ni), tiefe + 1, 1, inArg);
    var k2: int64 := self.cg_klonKnoten(self.cg_nc2(ni), tiefe + 1, 1, inArg);
    var k3: int64 := self.cg_klonKnoten(self.cg_nc3(ni), tiefe + 1, 1, inArg);
    var kn: int64 := 0 - 1;
    if (mitNext != 0) {
      kn := self.cg_klonKnoten(self.cg_nnext(ni), tiefe + 1, 1, inArg);
    }
    // Versatz NEU bestimmen: ein Wachsen der Ablage in der Rekursion hat den
    // Puffer verschoben.
    zoff := self.cg_noff(neu);
    poke64(zoff + CG_OFF_C0,   k0);
    poke64(zoff + CG_OFF_C1,   k1);
    poke64(zoff + CG_OFF_C2,   k2);
    poke64(zoff + CG_OFF_C3,   k3);
    poke64(zoff + CG_OFF_NEXT, kn);
    return neu;
  }

  // Taugt dieser Ausdruck als Argument einer Einbettung? Er wird so oft
  // eingesetzt, wie der Parameter im Rumpf vorkommt — also nur Ausdruecke
  // ohne Wirkung und ohne nennenswerte Kosten.
  fn cg_inlArgTaugt(a: int64): int64 {
    if (a < 0) { return 0; }
    var k: int64 := self.cg_nkind(a);
    if (k == CGN_LIT_INT || k == CGN_LIT_FLOAT || k == CGN_IDENT) { return 1; }
    if (k == CGN_UNOP) {
      var ik: int64 := self.cg_nkind(self.cg_nc0(a));
      if (ik == CGN_LIT_INT || ik == CGN_LIT_FLOAT || ik == CGN_IDENT) { return 1; }
    }
    return 0;
  }

  // Enthaelt der Teilbaum einen Aufruf? Dann nicht einbetten: ein Aufruf im
  // Rumpf kann die Funktion selbst meinen (Rekursion), und ein mehrfach
  // eingesetzter Parameter wuerde ihn mehrfach ausfuehren.
  fn cg_inlRein(ni: int64, tiefe: int64): int64 {
    if (ni < 0) { return 1; }
    if (tiefe > 32) { return 0; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_CALL_PTR) { return 0; }
    if (k == CGN_CALL && self.cg_inlLeseBuiltin(ni) == 0) { return 0; }
    if (self.cg_inlRein(self.cg_nc0(ni), tiefe + 1) == 0) { return 0; }
    if (self.cg_inlRein(self.cg_nc1(ni), tiefe + 1) == 0) { return 0; }
    if (self.cg_inlRein(self.cg_nc2(ni), tiefe + 1) == 0) { return 0; }
    if (self.cg_inlRein(self.cg_nc3(ni), tiefe + 1) == 0) { return 0; }
    if (self.cg_inlRein(self.cg_nnext(ni), tiefe + 1) == 0) { return 0; }
    return 1;
  }

  // Ein Aufruf, der nur LIEST und keine Wirkung hat: peek8..peek64 und
  // StrCharAt. Er darf in einem einzubettenden Rumpf und in einem Argument
  // stehen — sonst schied jede Zugriffsfunktion aus (`fn SortGet(a, i) {
  // return peek64(a + i * 8); }`), und gerade die sind die haeufigsten
  // kleinen Funktionen der stdlib. Eine Rekursion ist damit nicht moeglich,
  // und mehrfach ausgefuehrt waere ein Lesen ohne Wirkung nur teurer, nicht
  // falsch. Ausgeschlossen: Methoden und innere Funktionen gleichen Namens.
  fn cg_inlLeseBuiltin(ni: int64): int64 {
    if (self.cg_nival(ni) != 0) { return 0; }        // Methode
    if (self.cg_nestIdx(ni) >= 0) { return 0; }      // innere Funktion
    var p: pchar := self.cg_nsval(ni);
    var l: int64 := self.cg_nslen(ni);
    // Eine eigene Funktion gleichen Namens verdeckt den Builtin (dieselbe
    // Frage wie in cg_genCall) und darf eine Wirkung haben — dann zaehlte
    // die Reihenfolge zweier Argumente wieder.
    if (self.cg_eigeneUnitDefiniert(p, l) != 0) { return 0; }
    if (self.cg_seq(p, l, "peek8"c, 5) || self.cg_seq(p, l, "peek16"c, 6)
        || self.cg_seq(p, l, "peek32"c, 6) || self.cg_seq(p, l, "peek64"c, 6)
        || self.cg_seq(p, l, "StrCharAt"c, 9)) { return 1; }
    return 0;
  }

  // Vorpass je Unit: einbettbare Funktionen der obersten Ebene eintragen.
  //
  // Die Bedingungen sind bewusst eng. Der Rumpf ist GENAU ein `return
  // <ausdruck>`, der Ausdruck enthaelt keinen Aufruf, alle Parameter- und
  // Rueckgabetypen sind eingebaute Grundtypen, und es gibt keine
  // Typparameter. Damit entfaellt alles, was eine Einbettung schwierig
  // macht: Rekursion, Verdeckung durch lokale Deklarationen, Kopien von
  // Strukturwerten, mehrfache Rueckgabe.
  fn cg_sammleEinbettbare(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_FUNC_DECL && self.cg_einbettbar(cur) != 0) {
        if (self.inlTabN >= self.inlTabCap) {
          var nc: int64 := self.inlTabCap * 2;
          var nb: int64 := alloc(nc * CG_INL_SZ);
          memcpy(nb, self.inlTab, self.inlTabN * CG_INL_SZ);
          self.inlTab := nb; self.inlTabCap := nc;
        }
        var r: int64 := self.inlTab + self.inlTabN * CG_INL_SZ;
        poke64(r,                     self.cg_nsval(cur) as int64);
        poke64(r + CG_INL_OFF_LEN,    self.cg_nslen(cur));
        poke64(r + CG_INL_OFF_NI,     cur);
        poke64(r + CG_INL_OFF_NODES,  self.pNodes);
        poke64(r + CG_INL_OFF_SRC,    self.pSrc as int64);
        self.inlTabN += 1;
      }
      cur := self.cg_nnext(cur);
    }
  }

  fn cg_einbettbar(fni: int64): int64 {
    if (self.cg_nestHatRumpf(fni) == 0) { return 0; }
    if (self.cg_nc3(fni) >= 0) { return 0; }          // generisch oder extern
    // Keine Funktion mit Annotation. iVal traegt sie alle (ANNO_FLIGHTCRIT,
    // ANNO_INTEGRITY, ANNO_WCET, ANNO_ENERGY, ANNO_EXPORT_FN, ANNO_JNI).
    //
    // Belegt an @flight_crit: dessen FPU-Pruefung haengt am Rahmen des
    // AUFGERUFENEN — Prolog schaltet die SSE-Ausnahmen frei, Epilog nimmt
    // sie zurueck. Eingebettet gibt es diesen Rahmen nicht mehr, und
    // `D(1.0, 0.0)` lieferte still `inf` statt abzubrechen
    // (tests/flight_crit_heap_test.sh). Dieselbe Ueberlegung trifft jede
    // weitere Annotation, die am Rahmen haengt — deshalb pauschal.
    if (self.cg_nival(fni) != 0) { return 0; }
    // Rueckgabe- und Parametertypen (#2209).
    //
    // Erlaubt sind alle eingebauten Grundtypen. Die Frage ist nicht, welcher
    // Typ "passt", sondern welche UMRECHNUNG am Rahmen des Aufgerufenen
    // haengt und ohne ihn entfaellt. Gefunden ist genau eine: `cg_retToF64`
    // wandelt eine Ganzzahl in einer Gleitkomma-Funktion (#2004 — `fn
    // hoehe(): f64 { return 2500; }` lieferte eingebettet 0.0000, weil
    // FloatToStr die 2500 als Bitmuster las). Sie wird unten an der Kopie
    // nachgeholt, mit demselben `cg_istSicherGanz`.
    //
    // Fuer schmalere Ganzzahlen gibt es am `return` keine Anpassung — der
    // Zweig fuehrt nur cg_retToF64 und die Lockstep-Pruefung —, also ist
    // dort nichts nachzuholen.
    //
    // Die ARGUMENTseite bleibt eng: ein Gleitkomma-Parameter wird nur
    // bedient, wenn das Argument schon Gleitkomma ist. Ein ganzzahliges
    // Literal an einem f64-Parameter rechnet der echte Aufruf heute still
    // falsch (#2219, vorbestehend); eingebettet wuerde es richtig
    // herauskommen, und zwei Wege mit zwei Ergebnissen sind schlimmer als
    // ein bekannter Fehler an einer Stelle.
    var ret: int64 := self.cg_nc1(fni);
    if (ret < 0) { return 0; }
    if (self.cg_builtinTypeId(self.cg_nsval(ret), self.cg_nslen(ret)) == 0) { return 0; }
    // Parameter: hoechstens acht, alle mit eingebautem Grundtyp.
    var pz: int64 := 0;
    var pp: int64 := self.cg_nc0(fni);
    while (pp >= 0) {
      if (self.cg_nkind(pp) != CGN_PARAM) { return 0; }
      var pt: int64 := self.cg_nc0(pp);
      if (pt < 0) { return 0; }
      if (self.cg_builtinTypeId(self.cg_nsval(pt), self.cg_nslen(pt)) == 0) { return 0; }
      pz += 1;
      pp := self.cg_nnext(pp);
    }
    if (pz > 8) { return 0; }
    // Rumpf: beliebig viele `var`-Zwischenwerte, dann genau ein `return`.
    //
    // Die Zwischenwerte werden EINGESETZT, nicht als Rahmenplatz angelegt —
    // sonst entstuenden Plaetze, die die Registerzuteilung (#2114) nie
    // gesehen hat, und genau daran ist der zweite Anlauf gescheitert.
    // Einsetzen darf man einen Wert nur, wenn er GENAU EINMAL gelesen wird;
    // sonst wuerde seine Rechnung mehrfach ausgefuehrt.
    var st: int64 := self.cg_nc0(self.cg_nc2(fni));
    if (st < 0) { return 0; }
    while (st >= 0 && self.cg_nkind(st) == CGN_VAR_DECL) {
      var ini: int64 := self.cg_nc1(st);
      if (ini < 0) { return 0; }
      if (self.cg_inlRein(ini, 0) == 0) { return 0; }
      var vn: pchar := self.cg_nsval(st);
      var vl: int64 := self.cg_nslen(st);
      // Ein Name, der schon Parameter ist, wuerde ihn verdecken.
      var pq: int64 := self.cg_nc0(fni);
      while (pq >= 0) {
        if (self.cg_seq(self.cg_nsval(pq), self.cg_nslen(pq), vn, vl)) { return 0; }
        pq := self.cg_nnext(pq);
      }
      var rest: int64 := self.cg_nnext(st);
      if (self.cg_inlZaehl(rest, vn, vl) != 1) { return 0; }
      st := rest;
    }
    if (st < 0) { return 0; }
    if (self.cg_nnext(st) >= 0) { return 0; }
    if (self.cg_nkind(st) != CGN_RETURN) { return 0; }
    var ex: int64 := self.cg_nc0(st);
    if (ex < 0) { return 0; }
    return self.cg_inlRein(ex, 0);
  }

  // Einbettbare Funktion dieses Namens aus DIESER Unit; sonst -1.
  fn cg_findEinbettbar(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.inlTabN) {
      var r: int64 := self.inlTab + i * CG_INL_SZ;
      if (peek64(r + CG_INL_OFF_NODES) == self.pNodes
          && peek64(r + CG_INL_OFF_SRC) == self.pSrc as int64
          && peek64(r + CG_INL_OFF_LEN) == nlen
          && self.cg_seq(peek64(r) as pchar, nlen, name, nlen)) {
        return peek64(r + CG_INL_OFF_NI);
      }
      i += 1;
    }
    return 0 - 1;
  }

  // Den Aufruf `callNi` durch den Rumpf von `fni` ersetzen. Liefert 1, wenn
  // eingebettet wurde; das Ergebnis steht dann wie nach einem Aufruf in rax.
  fn cg_betteEin(fni: int64, callNi: int64): int64 {
    // Parameter und Argumente paarweise. Die Argumentliste eines FREIEN
    // Aufrufs steht in c0 (bei einer Methode in c1) — mit c1 waere die Liste
    // hier immer leer und die Einbettung faende nie statt.
    return self.cg_betteEinMit(fni, callNi, self.cg_nc0(callNi), 0 - 1);
  }

  // #2228: wie cg_betteEin, mit der Argumentliste `argKopf` und — bei einer
  // Methode — dem Empfaenger `selbst`, der im Rumpf fuer `self` eingesetzt
  // wird wie ein Argument fuer seinen Parameter (die Aufrufstelle laesst nur
  // ein schlichtes Local zu, cg_argDirekt).
  fn cg_betteEinMit(fni: int64, callNi: int64, argKopf: int64, selbst: int64): int64 {
    var pz: int64 := 0;
    var pp: int64 := self.cg_nc0(fni);
    while (pp >= 0) { pz += 1; pp := self.cg_nnext(pp); }
    var az: int64 := 0;
    var aa: int64 := argKopf;
    pp := self.cg_nc0(fni);
    while (aa >= 0) {
      // Ein zusammengesetztes Argument (`a[i - 1]`, `x + 1`) wird so oft
      // eingesetzt, wie der Parameter im Rumpf vorkommt. Liest der Rumpf ihn
      // hoechstens EINMAL und hat das Argument keine Wirkung (cg_inlRein:
      // kein Aufruf ausser lesenden Builtins), rechnet die Kopie genau, was
      // der Aufruf gerechnet haette — ohne Schreibzugriff im Rumpf ist auch
      // die Reihenfolge der Auswertung gleichgueltig.
      if (self.cg_inlArgTaugt(aa) == 0) {
        if (pp < 0) { return 0; }
        if (self.cg_inlRein(aa, 0) == 0) { return 0; }
        if (self.cg_inlZaehl(self.cg_nc0(self.cg_nc2(fni)),
                             self.cg_nsval(pp), self.cg_nslen(pp)) > 1) { return 0; }
      }
      az += 1;
      aa := self.cg_nnext(aa);
      if (pp >= 0) { pp := self.cg_nnext(pp); }
    }
    if (pz != az) { return 0; }

    // #2219: Ein ganzzahliges Argument an einem Gleitkomma-Parameter muss
    // gewandelt werden. Hier stand dafuer eine Schranke (nicht einbetten),
    // solange der echte Aufruf es still falsch rechnete — zwei Wege mit zwei
    // Ergebnissen waeren schlimmer gewesen als ein Fehler an einer Stelle.
    // Seit #2219 wandelt die Uebergabe selbst (cg_orderCallArgs), und die
    // Kopie holt es unten mit demselben cg_istSicherGanz nach. Die Schranke
    // ist damit weg, und tests/einbettung_test.sh fuehrt den Fall jetzt als
    // EINGEBETTET statt als Ablehnung.
    var pf: int64 := self.cg_nc0(fni);
    var af: int64 := argKopf;
    while (pf >= 0 && af >= 0) {
      var pt: int64 := self.cg_nc0(pf);
      if (self.cg_isFloatTypeName(self.cg_nsval(pt), self.cg_nslen(pt)) != 0
          && self.cg_isF64Expr(af) == 0 && self.cg_istSicherGanz(af) == 0) { return 0; }
      pf := self.cg_nnext(pf);
      af := self.cg_nnext(af);
    }

    var gemerkt: int64 := self.inlArgCount;
    if (selbst >= 0) { self.cg_inlPush("self"c, 4, selbst, 0, 0 - 1); }
    pp := self.cg_nc0(fni);
    aa := argKopf;
    while (pp >= 0 && aa >= 0) {
      self.cg_inlPush(self.cg_nsval(pp), self.cg_nslen(pp), aa, 0, self.cg_nc0(pp));
      pp := self.cg_nnext(pp);
      aa := self.cg_nnext(aa);
    }

    // Zwischenwerte in Reihenfolge nachtragen — ein spaeterer darf einen
    // frueheren nennen, deshalb erst eintragen, dann den naechsten lesen.
    var st: int64 := self.cg_nc0(self.cg_nc2(fni));
    while (st >= 0 && self.cg_nkind(st) == CGN_VAR_DECL) {
      self.cg_inlPush(self.cg_nsval(st), self.cg_nslen(st), self.cg_nc1(st), 1, 0 - 1);
      st := self.cg_nnext(st);
    }

    var ex: int64 := self.cg_nc0(st);
    var kopie: int64 := self.cg_klonKnoten(ex, 0, 0, 0);
    self.inlArgCount := gemerkt;

    self.cg_genExpr(kopie);

    // #2209: die Umrechnung des return-Zweiges nachholen. Dieselbe Rechnung
    // wie in cg_retToF64 — die beiden muessen uebereinstimmen; dort haengt
    // sie an `self.fnRetIsFloat` (dem Rueckgabetyp der UMGEBENDEN Funktion),
    // hier am Rueckgabetyp der eingebetteten.
    var retNi: int64 := self.cg_nc1(fni);
    if (retNi >= 0
        && self.cg_isFloatTypeName(self.cg_nsval(retNi), self.cg_nslen(retNi)) != 0
        && self.cg_istSicherGanz(kopie) != 0) {
      self.cg_emitRaxIntToF64();
    }
    // #2209: und die Breite der Rueckgabe. `fn f(): uint8 { return 300; }`
    // liefert 44, nicht 300 — die Kuerzung sitzt im Epilog des Aufgerufenen
    // (tests/int_width_test.sh, 'Rueckgabe kuerzt'). Dieselbe Stelle wie
    // oben: cg_emitNarrowRax ueber cg_narrowKindOf.
    if (retNi >= 0) {
      self.cg_emitNarrowRax(self.cg_narrowKindOf(self.cg_nsval(retNi),
                                                 self.cg_nslen(retNi)));
    }
    return 1;
  }

  // #2228: Ein Argument, das ohne jede Wirkung und nur ueber rax geladen
  // wird: ganzzahliges Literal oder schlichtes Local (Rahmenplatz oder
  // r12..r15). Kein TMR-Local (Mehrheitslesen ueber rbx/rcx), keine
  // Erfassung ueber Umgebung oder statischen Link, keine globale (Patch).
  // Dieselben Faelle, die der CGN_IDENT-Zweig von cg_genExpr mit
  // cg_loadRax erledigt — die beiden muessen uebereinstimmen.
  // Hat die Methode `name` einen VMT-Platz in der Klasse classIdx? Dieselbe
  // Suche wie der virtuelle Aufruf in cg_genCall (WP-BC-L2) — die beiden
  // muessen uebereinstimmen.
  fn cg_hatVmtPlatz(classIdx: int64, name: pchar, nlen: int64): int64 {
    var cb: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var vl: int64 := peek64(cb + CG_CLASS_OFF_VMTLIST);
    var vn: int64 := peek64(cb + CG_CLASS_OFF_VMTSLOTS);
    var vs: int64 := 0;
    while (vs < vn) {
      var vName: pchar := peek64(vl + vs * 16) as pchar;
      var vLen:  int64 := peek64(vl + vs * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN);
      if (self.cg_seq(vName, vLen, name, nlen) != 0) { return 1; }
      vs += 1;
    }
    return 0;
  }

  fn cg_argDirekt(a: int64): int64 {
    if (a < 0) { return 0; }
    var k: int64 := self.cg_nkind(a);
    if (k == CGN_LIT_INT) { return 1; }
    if (k != CGN_IDENT) { return 0; }
    if (self.cg_nestIdx(a) >= 0) { return 0; }
    var name: pchar := self.cg_nsval(a);
    var nlen: int64 := self.cg_nslen(a);
    if (self.cg_findLocal(name, nlen) == 0) { return 0; }
    var ridx: int64 := self.cg_findLocalIdx(name, nlen);
    if (ridx < 0 || self.cg_isLocalRedundant(ridx) != 0) { return 0; }
    return 1;
  }

  // mov <Argumentregister i>, rax  (i = 0..5: rdi rsi rdx rcx r8 r9)
  fn cg_movArgRegRax(i: int64) {
    if (i == 0) { self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7); }
    else if (i == 1) { self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6); }
    else if (i == 2) { self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2); }
    else if (i == 3) { self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1); }
    else if (i == 4) { self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC0); }
    else if (i == 5) { self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC1); }
    else {
      EPrintStrLn("lyxc: interner Fehler (#2228): Argumentregister ausserhalb 0..5"c);
      exit(70);
    }
  }

  fn cg_genCall(ni: int64) {
    var fname: pchar := self.cg_nsval(ni);
    var fnlen: int64 := self.cg_nslen(ni);
    var isMethod: int64 := self.cg_nival(ni);

    // #2247: Wunsch nach dem vorzeichenlosen peek32 aufnehmen und SOFORT
    // loeschen — er gilt nur fuer diesen Aufruf und darf nicht in die
    // Auswertung der Argumente durchsickern (`peek32(peek32(x) & 0xFFFFFFFF)`).
    var p32: int64 := self.p32Wunsch;
    self.p32Wunsch := 0;

    // #2044: Meint der Aufruf eine innere Funktion, gilt ihre Marke — und ihre
    // Deklaration fuer die Vorgabewerte. Der Vorpass hat das mit der
    // Gueltigkeit von sema entschieden; ab hier ist der Name eindeutig, und
    // die Builtin-Kette unten trifft ihn nicht mehr (eine innere Funktion
    // darf auch einen Builtin-Namen verdecken).
    var nestDecl: int64 := 0 - 1;
    if (isMethod == 0) {
      var cnI: int64 := self.cg_nestIdx(ni);
      if (cnI >= 0) {
        fname := self.cg_nestLbl(cnI);
        fnlen := self.cg_nestLblLen(cnI);
        nestDecl := self.cg_nestDecl(cnI);
      }
    }

    // #2208: Ein freier Aufruf einer kleinen Funktion aus derselben Unit
    // wird durch ihren Rumpf ersetzt. Vor jeder Umdeutung des Namens, denn
    // nur hier ist sicher, dass `fname` die Funktion der Unit meint und die
    // Argumente in c0 stehen.
    //
    // Ein LOCAL dieses Namens verdeckt die Funktion: `var zehn: fn(int64):
    // int64 := fuenf;` macht `zehn(1)` zum Aufruf ueber den Zeiger. Ohne
    // diese Frage bettete die gleichnamige Modulfunktion ein und `zehn(1)`
    // lieferte 11 statt 6 (tests/verschachtelte_namen_test.sh).
    // Mit Debug-Info gar nicht erst: eine eingebettete Funktion hat keinen
    // eigenen Rahmen, und der Backtrace nennt sie nicht mehr
    // (tests/debug_tools_reste_test.sh erwartet `quadrat`, `summe`, `main`).
    // Dieselbe Abwaegung trifft schon die Registerzuteilung (#2114).
    if (isMethod == 0 && nestDecl < 0
        && self.debugMode == 0 && self.debugInfoEnabled == 0
        && self.cg_findLocalIdx(fname, fnlen) < 0) {
      var inlFn: int64 := self.cg_findEinbettbar(fname, fnlen);
      if (inlFn >= 0) {
        if (self.cg_betteEin(inlFn, ni) != 0) { return; }
      }
    }

    // #2228: rotl/rotr/rotl32/rotr32 mit KONSTANTER Weite — Rotation mit
    // Direktwert statt des allgemeinen Wegs (beide Argumente auf den Stapel,
    // Weite nach ecx). SHA-256 und BLAKE3 rotieren nur um feste Weiten; ueber
    // den allgemeinen Weg war die Umstellung der std-Units auf rotr32 auf x86
    // LANGSAMER als das ausgeschriebene Schieben (4 MiB SHA-256: 93,6 gegen
    // 97,9 ms). Dieselben Werte wie die Builtin-Kette unten (`rol eax, cl`
    // usw.) — die beiden muessen uebereinstimmen: die Weite zaehlt mod 32 bzw.
    // mod 64, die 32-Bit-Formen nehmen die unteren 32 Bit und liefern
    // null-erweitert. Dieselben Verdeckungsregeln wie dort (#1311, #2082).
    // #2247: peek*/poke* mit der Adresse `A + B`, beide in Registern.
    //
    // Der allgemeine Weg materialisiert jede Adresse: `mov base,rax; add
    // idx,rax; mov rax,rdi` und beim Schreiben zusaetzlich `push`/`pop`, um
    // die Zieladresse ueber die Auswertung des Wertes zu retten. Gemessen am
    // Kern aus bench/arr_int.lyx (i5-8250U, 1.2.23B) kostete `add32` so 29,1
    // Befehle je Element gegen 1,8 bei gcc -O2 — bei IPC 3,76, die Maschine
    // stockt also nicht, es sind einfach zu viele Befehle (#2247).
    //
    // x86 kann die Summe im Operanden: `movsxd rax,(%r14,%r13)`. Beide Werte
    // liegen bereits in Registern (die Auswahl aus #2114 legt Laufvariable,
    // Versatz und Basiszeiger dorthin), es ist also nichts zu laden.
    //
    // NICHT unter --runtime-checks: peek8/peek64/poke8/poke64 tragen dort
    // eine Nullzeigerpruefung, die der Schnellweg nicht hat. Dann bleibt der
    // allgemeine Weg, und die Pruefung bleibt wirksam.
    //
    // Dieselben Verdeckungsregeln wie die Builtin-Kette unten (#1311, #2082):
    // eine Funktion der eigenen Unit oder eine abweichende Argumentzahl
    // gewinnt. Bedeutung und Vorzeichen bleiben wie dort — peek32
    // VORZEICHENERWEITERT, peek8/peek16 null-erweitern, poke* liefert 0.
    if (isMethod == 0 && nestDecl < 0 && self.runtimeChecks == 0
        && self.cg_findLocalIdx(fname, fnlen) < 0
        && self.cg_eigeneUnitDefiniert(fname, fnlen) == 0) {
      var pkArt: int64 := 0;
      if (self.cg_seq(fname, fnlen, "peek8", 5))  { pkArt := 1; }
      if (self.cg_seq(fname, fnlen, "peek16", 6)) { pkArt := 2; }
      if (self.cg_seq(fname, fnlen, "peek32", 6)) { pkArt := 3; }
      if (self.cg_seq(fname, fnlen, "peek64", 6)) { pkArt := 4; }
      if (self.cg_seq(fname, fnlen, "poke8", 5))  { pkArt := 5; }
      if (self.cg_seq(fname, fnlen, "poke16", 6)) { pkArt := 6; }
      if (self.cg_seq(fname, fnlen, "poke32", 6)) { pkArt := 7; }
      if (self.cg_seq(fname, fnlen, "poke64", 6)) { pkArt := 8; }
      if (pkArt != 0) {
        var pkAdr: int64 := self.cg_nc0(ni);
        var pkWert: int64 := 0 - 1;
        if (pkAdr >= 0) { pkWert := self.cg_nnext(pkAdr); }
        var pkArgOk: int64 := 0;
        if (pkArt <= 4 && pkAdr >= 0 && pkWert < 0) { pkArgOk := 1; }
        if (pkArt >= 5 && pkAdr >= 0 && pkWert >= 0 && self.cg_nnext(pkWert) == -1) { pkArgOk := 1; }
        if (pkArgOk != 0) {
          var pkBB: int64 := alloc(24);
          var pkOk: int64 := self.cg_adrZerlegen(pkAdr, pkBB, pkBB + 8, pkBB + 16);
          var pkBasisNi: int64 := peek64(pkBB);
          var pkIndex: int64 := peek64(pkBB + 8);
          var pkK: int64 := peek64(pkBB + 16);
          free(pkBB, 24);
          if (pkOk != 0) {
            // Liegt die Basis selbst in einem Register, wird nichts geladen.
            // Sonst kommt sie EINMAL in ein Arbeitsregister: rax beim Lesen,
            // rbx beim Schreiben (dort traegt rax schon den Wert). Beides ist
            // kuerzer als Adresse rechnen, retten und zurueckholen.
            var pkBasisReg: int64 := self.cg_adrRegVon(pkBasisNi);
            // Basis 101 (rbp/r13) ginge mit mod=00 als "ohne Basis" durch; in
            // dem Fall bleibt es beim allgemeinen Weg (#2205). Index 101 ist
            // dagegen gueltig, Tauschen ist hier aber nicht moeglich, weil die
            // Skalierung am Index haengt.
            var pkGeht: int64 := 1;
            if (pkBasisReg == 13) { pkGeht := 0; }
            if (pkBasisReg >= 12 && pkBasisReg == pkIndex) { pkGeht := 0; }
            // Beim SCHREIBEN muss die Basis VORHER tragfaehig sein: sobald der
            // Wert in rax steht, ist der allgemeine Weg nicht mehr erreichbar.
            // Tragfaehig heisst: im Register, oder ein Local mit Rahmenplatz.
            var pkBasisOff: int64 := 0;
            if (pkArt >= 5 && pkBasisReg < 12) {
              if (self.cg_nkind(pkBasisNi) == CGN_IDENT) {
                pkBasisOff := self.cg_findLocal(self.cg_nsval(pkBasisNi), self.cg_nslen(pkBasisNi));
              }
              if (pkBasisOff == 0) { pkGeht := 0; }
            }
            if (pkGeht != 0 && pkArt <= 4) {
              var pkB: int64 := pkBasisReg;
              if (pkB < 12) {
                // Basis in rax laden; rax ist Basisregister 0, REX.B = 0.
                self.cg_genExpr(pkBasisNi);
                pkB := 0;
              }
              var pkRexR: int64 := 0x40;
              if (pkB >= 8) { pkRexR := pkRexR | 1; }
              if (pkIndex >= 8) { pkRexR := pkRexR | 2; }
              if (pkArt == 1) {        // movzx rax, byte [b + i*k]
                self.cg_e8(pkRexR | 8); self.cg_e8(0x0F); self.cg_e8(0xB6);
              } else if (pkArt == 2) { // movzx rax, word
                self.cg_e8(pkRexR | 8); self.cg_e8(0x0F); self.cg_e8(0xB7);
              } else if (pkArt == 3 && p32 != 0) {
                // #2247: `peek32(...) & 0xFFFFFFFF` — ein 32-Bit-Ladebefehl
                // null-erweitert von sich aus, die Maske danach entfaellt.
                // Ohne REX.W, sonst waere es wieder der 64-Bit-Zugriff.
                self.cg_e8(pkRexR); self.cg_e8(0x8B);   // mov eax, dword [b+i*k]
                self.p32Erfuellt := 1;
              } else if (pkArt == 3) { // movsxd rax, dword — Vorzeichen wie bisher
                self.cg_e8(pkRexR | 8); self.cg_e8(0x63);
              } else {                 // mov rax, qword
                self.cg_e8(pkRexR | 8); self.cg_e8(0x8B);
              }
              self.cg_memBasisIndex(0, pkB, pkIndex, pkK);
              return;
            }
            if (pkGeht != 0) {
              // Schreiben: erst der WERT nach rax — danach ist die Adresse
              // ohne Umweg erreichbar, das push/pop-Paar entfaellt.
              self.cg_genExpr(pkWert);
              var pkB2: int64 := pkBasisReg;
              if (pkB2 < 12) {
                // Basis nach rbx (rax traegt den Wert). rbx ist das
                // Arbeitsregister der Binaeroperationen und hier frei. Der
                // Rahmenplatz steht fest, oben geprueft.
                if (pkBasisOff >= -128 && pkBasisOff <= 127) {
                  self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x5D); self.cg_e8(pkBasisOff);
                } else {
                  self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x9D); self.cg_e32(pkBasisOff);
                }
                pkB2 := 3;   // rbx
              }
              var pkRexR2: int64 := 0x40;
              if (pkB2 >= 8) { pkRexR2 := pkRexR2 | 1; }
              if (pkIndex >= 8) { pkRexR2 := pkRexR2 | 2; }
              if (pkArt == 5) {          // mov [b+i*k], al
                self.cg_e8(pkRexR2); self.cg_e8(0x88);
              } else if (pkArt == 6) {   // mov [b+i*k], ax
                self.cg_e8(0x66); self.cg_e8(pkRexR2); self.cg_e8(0x89);
              } else if (pkArt == 7) {   // mov [b+i*k], eax
                self.cg_e8(pkRexR2); self.cg_e8(0x89);
              } else {                   // mov [b+i*k], rax
                self.cg_e8(pkRexR2 | 8); self.cg_e8(0x89);
              }
              self.cg_memBasisIndex(0, pkB2, pkIndex, pkK);
              self.cg_zeroRax();
              return;
            }
          }
        }
      }
    }

    if (isMethod == 0 && nestDecl < 0 && self.cg_findLocalIdx(fname, fnlen) < 0) {
      var rkArt: int64 := 0;
      if (self.cg_seq(fname, fnlen, "rotl", 4)) { rkArt := 1; }
      if (self.cg_seq(fname, fnlen, "rotr", 4)) { rkArt := 2; }
      if (self.cg_seq(fname, fnlen, "rotl32", 6)) { rkArt := 3; }
      if (self.cg_seq(fname, fnlen, "rotr32", 6)) { rkArt := 4; }
      if (rkArt != 0 && self.cg_eigeneUnitDefiniert(fname, fnlen) == 0) {
        var rkA0: int64 := self.cg_nc0(ni);
        var rkA1: int64 := 0 - 1;
        if (rkA0 >= 0) { rkA1 := self.cg_nnext(rkA0); }
        if (rkA1 >= 0 && self.cg_nnext(rkA1) == -1 && self.cg_tryFold(rkA1) != 0) {
          var rkN: int64 := self.foldBuf;
          self.cg_genExpr(rkA0);                                           // rax = x
          if (rkArt >= 3) {
            rkN := rkN & 31;
            self.cg_e8(0x89); self.cg_e8(0xC0);                            // mov eax, eax (null-erweitern)
            if (rkN != 0) {
              self.cg_e8(0xC1);
              if (rkArt == 3) { self.cg_e8(0xC0); } else { self.cg_e8(0xC8); }   // rol/ror eax, imm8
              self.cg_e8(rkN);
            }
          } else {
            rkN := rkN & 63;
            if (rkN != 0) {
              self.cg_e8(0x48); self.cg_e8(0xC1);
              if (rkArt == 1) { self.cg_e8(0xC0); } else { self.cg_e8(0xC8); }   // rol/ror rax, imm8
              self.cg_e8(rkN);
            }
          }
          return;
        }
      }
    }

    // #1262: `m.Wert()` — der Empfaenger ist ein Namensraum, kein Objekt. Das
    // ist ein gewoehnlicher Aufruf der Marke "m_Wert"; ohne diese Umsetzung
    // liefe er als Methodenaufruf mit einem self, das es nicht gibt.
    //
    // Die Argumente stehen bei einem Methodenaufruf in c1, bei einem
    // gewoehnlichen in c0. Nach der Umdeutung auf isMethod=0 muessen sie
    // weiterhin aus c1 kommen — dafuer dieser Merker.
    // #1670: `obj.ClassName()` liefert den Namen der Klasse als pchar.
    //
    // Bei einer Klasse MIT Methoden ist es der DYNAMISCHE Name: gelesen wird
    // ueber den Typzeiger im Objekt, eine Basisklassen-Variable meldet also
    // die tatsaechliche Klasse. Eine Klasse ohne Methoden bekommt
    // struct-Layout und traegt keinen Typzeiger; dort ist der statische Name
    // die einzige und richtige Antwort — dieselbe Grenze, die `is` schon zieht
    // (ebnf.md 20.1).
    if (isMethod == 1 && self.cg_seq(fname, fnlen, "ClassName", 9) != 0
        && self.cg_nc1(ni) == -1) {
      var cnObj: int64 := self.cg_nc0(ni);
      var cnIdx: int64 := self.cg_objClassIdx(cnObj);
      if (cnIdx >= 0) {
        if (self.cg_classHasVmt(cnIdx) != 0) {
          self.cg_genExpr(cnObj);                                  // rax = Objekt
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x00);    // mov rax,[rax]      (VMT)
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40); self.cg_e8(0xF8);  // mov rax,[rax-8]
        } else {
          // Der Empfaenger wird trotzdem ausgewertet — er kann Wirkung haben.
          self.cg_genExpr(cnObj);
          var cnBase: int64 := self.classLayouts + cnIdx * CG_CLASS_SZ;
          var cnOff:  int64 := self.cg_addNameData(peek64(cnBase) as pchar,
                                                   peek64(cnBase + CG_CLASS_OFF_NAMELEN));
          self.cg_emitLeaRaxData(cnOff);
        }
        return;
      }
      // Kein bestimmbarer Klassentyp: nicht still etwas erfinden.
      EPrintStrLn("error: ClassName() braucht einen Empfaenger mit bestimmbarem Klassentyp"c);
      EPrintStrLn("  Den Ausdruck zuerst einer Variablen mit deklariertem Typ zuweisen."c);
      exit(1);
    }

    var aliasArgs: int64 := 0 - 1;
    if (isMethod == 1) {
      var arecv: int64 := self.cg_nc0(ni);
      if (arecv >= 0 && self.cg_nkind(arecv) == CGN_IDENT) {
        var arn: pchar := self.cg_nsval(arecv);
        var arl: int64 := self.cg_nslen(arecv);
        if (self.cg_isAlias(arn, arl) != 0) {
          var alc: int64 := alloc(8);
          var amb: int64 := self.cg_mangleInto(arn, arl, fname, fnlen, alc);
          fname     := amb as pchar;
          fnlen     := peek64(alc);
          isMethod  := 0;
          aliasArgs := self.cg_nc1(ni);
        }
      }
    }
    // #1091: iVal 3 markiert `super.M()`. Die Umsetzung auf 1 muss HIER
    // geschehen, vor jeder Verzweigung: die Argumentliste eines Methoden-
    // aufrufs steht in c1, die eines gewoehnlichen in c0. Wurde der Marker
    // erst spaeter aufgeloest, nahm der Aufruf den Nicht-Methoden-Pfad, fand
    // dort keine Argumente und der Aufgerufene las, was zufaellig in den
    // Registern stand -- `super.One(7)` lieferte 4096.
    var isSuperCall: int64 := 0;
    if (isMethod == 3) { isSuperCall := 1; isMethod := 1; }

    // #2134: generischer Aufruf (iVal 2) — Marke der Spezialisierung, die
    // cg_genInstanz anlegt (im typgeloeschten Rumpf: die der generischen
    // Funktion selbst). Ab hier ist es ein gewoehnlicher Aufruf. Bis 1.2.15A
    // stand hier eine Sprungmarke auf den typgeloeschten Rumpf, und seit
    // #2125 eine Sperre fuer Gleitkomma-Typargumente — beides entfaellt.
    if (isMethod == 2) {
      var gLc: int64 := alloc(8);
      fname := self.cg_callName(ni, gLc);
      fnlen := peek64(gLc);
      free(gLc, 8);
      isMethod := 0;
    }

    // Count args
    var argNode: int64 := self.cg_nc0(ni);
    if (isMethod == 1) { argNode := self.cg_nc1(ni); }
    if (aliasArgs >= 0) { argNode := aliasArgs; }   // #1262

    // LBF-Loader: _indirect_call_0(fnPtr) / _indirect_call_1(fnPtr, arg) — Aufruf eines
    // ROHEN Code-Pointers (kein Closure-Struct). fnPtr → rax, arg → rdi, dann `call rax`.
    if (isMethod == 0) {
      if (self.cg_seq(fname, fnlen, "_indirect_call_0", 16)) {
        self.cg_genExpr(argNode);               // rax = fnPtr
        self.cg_e8(0xFF); self.cg_e8(0xD0);     // call rax
        return;
      }
      if (self.cg_seq(fname, fnlen, "_indirect_call_1", 16)) {
        var icA1: int64 := self.cg_nnext(argNode);  // erstes echtes Argument
        self.cg_genExpr(icA1);   self.cg_pushRax(); // push arg
        self.cg_genExpr(argNode);                    // rax = fnPtr
        self.cg_e8(0x5F);                            // pop rdi  (= arg)
        self.cg_e8(0xFF); self.cg_e8(0xD0);          // call rax
        return;
      }
      // _2/_3/_4 waren in sema registriert, aber nie emittiert — std/android/jni.lyx
      // benutzt sie, was erst beim Bauen eines Programms auffiel (--compile-unit
      // erreicht den Codegen nicht). Gleiches Schema wie _1, nur mehr Register:
      // Argumente in UMGEKEHRTER Reihenfolge pushen, fnPtr nach rax, dann in
      // rdi/rsi/rdx/rcx zurückholen — so landet a1 in rdi.
      if (self.cg_seq(fname, fnlen, "_indirect_call_2", 16)) {
        self.cg_genIndirectCallN(argNode, 2);
        return;
      }
      if (self.cg_seq(fname, fnlen, "_indirect_call_3", 16)) {
        self.cg_genIndirectCallN(argNode, 3);
        return;
      }
      if (self.cg_seq(fname, fnlen, "_indirect_call_4", 16)) {
        self.cg_genIndirectCallN(argNode, 4);
        return;
      }
    }

    // WP-02: Check if fname is a local closure variable — emit indirect call
    if (isMethod == 0) {
      // #2133: im Rumpf eines Lambdas ein ERFASSTES Lambda (`c()`). Bis dahin
      // fehlte der Fall: der Name war kein Local, und der Aufruf endete in
      // "undefined function 'c'". Wie beim Local entscheidet das aeussere
      // Local, ob Satz oder Adresse.
      // Vor der Modulvariablen: eine Erfassung verdeckt sie, wie beim Lesen.
      if (self.closureEnvPtrOff != 0 && self.cg_findLocal(fname, fnlen) == 0) {
        var ccIdx: int64 := self.cg_findClosureCap(fname, fnlen);
        if (ccIdx >= 0) {
          var ccArt: int64 := self.cg_localRufArt(peek64(self.closureCapturedIdxBuf + ccIdx * 8));
          self.cg_genFnWertRuf(argNode, 1, ccIdx, ccArt, 0);
          return;
        }
      }
      // #1574: Aufruf ueber eine GLOBALE Variable vom Funktionstyp. Sie ist
      // kein Local, also lief der Name weiter bis zur Marken-Aufloesung und
      // endete in "undefined function 'gFn'". Derselbe duenne Aufruf wie beim
      // Local, nur wird die Adresse aus dem Datenbereich geladen.
      // Bewusst NACH der Local-Frage: ein gleichnamiges Local verdeckt die
      // globale Variable, wie ueberall sonst auch.
      if (self.cg_findLocal(fname, fnlen) == 0) {
        var gfIdx: int64 := self.cg_findGlobalIdx(fname, fnlen);
        if (gfIdx >= 0 && peek8(self.globalIsFnPtr + gfIdx) != 0) {
          var gfSret: int64 := self.cg_fnAliasRetStructBytes(fname, fnlen);
          if (gfSret <= 0) { gfSret := self.cg_globalRetStructBytes(fname, fnlen); }
          // #2084: Stapel-, verdeckte und Registerargumente wie beim direkten Aufruf.
          var gfVerdeckt: int64 := 0;
          if (gfSret > 0) { gfVerdeckt := 1; }
          var gfN: int64 := self.cg_indirektStapelArgs(argNode, 6 - gfVerdeckt);
          var gfArgc: int64 := self.cg_indirektSretVorschub(gfSret);
          gfArgc := gfArgc + self.cg_indirektRegArgs(argNode, 6 - gfVerdeckt);
          self.cg_loadRaxGlobal(self.cg_findGlobal(fname, fnlen));   // rax = Codeadresse
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC3);      // mov rbx, rax
          if (gfArgc >= 6) { self.cg_e8(0x41); self.cg_e8(0x59); }   // pop r9
          if (gfArgc >= 5) { self.cg_e8(0x41); self.cg_e8(0x58); }   // pop r8
          if (gfArgc >= 4) { self.cg_popRcx(); }
          if (gfArgc >= 3) { self.cg_popRdx(); }
          if (gfArgc >= 2) { self.cg_popRsi(); }
          if (gfArgc >= 1) { self.cg_popRdi(); }
          self.cg_e8(0xFF); self.cg_e8(0xD3);                        // call rbx
          self.cg_popStackArgs(gfN + gfVerdeckt);                    // #2084
          return;
        }
      }
      var clOff: int64 := self.cg_findLocal(fname, fnlen);
      self.cg_rlNichtImRegister(clOff, "Aufruf ueber ein Funktionswert-Local"c);   // #2114
      if (clOff != 0) {
        // #1: lokaler plain fn-ptr (fn-Typ-Alias)? → thin-call: Adresse laden, Args in normalen
        // Registern (arg0→rdi), KEIN env-Shift. Vorher: Closure-Pfad las {fnPtr,env} → Garbage/Crash.
        // #2133: die Entscheidung steht in cg_localRufArt.
        var clIdx: int64 := self.cg_findLocalIdx(fname, fnlen);
        var clArt: int64 := self.cg_localRufArt(clIdx);
        self.cg_genFnWertRuf(argNode, 0, clOff, clArt, self.cg_indirektRetStructBytes(fname, fnlen));
        return;
      }
    }

    // Intercept array built-in methods before arg evaluation (WP-10b)
    if (isMethod == 1) {
      var arrObj: int64 := self.cg_nc0(ni);
      if (self.cg_identIsArray(arrObj) != 0) {
        var pushStr: pchar := "push";
        var popStr:  pchar := "pop";
        if (self.cg_seq(fname, fnlen, pushStr, 4)) {
          self.cg_genArrayPush(arrObj, argNode);
          return;
        } else if (self.cg_seq(fname, fnlen, popStr, 3)) {
          self.cg_genArrayPop(arrObj);
          return;
        }
      }
    }
    // A1: Fn-Pointer-FELD-Call — obj.field(args), wobei `field` ein Klassen-FELD (kein Methode) ist.
    // Plain indirekter Call: Feld laden (= Fn-Adresse), Args in normalen Registern, KEIN self-Inject.
    if (isMethod == 1) {
      var fpObj: int64 := self.cg_nc0(ni);
      var fpClassIdx: int64 := self.cg_objClassIdx(fpObj);
      if (fpClassIdx >= 0) {
        var fpOff: int64 := self.cg_findField(fpClassIdx, fname, fnlen);
        if (fpOff >= 0 && self.cg_fieldIsMethodType(fpClassIdx, fname, fnlen) != 0) {
          // B2: fat-call. Feld = Pointer auf heap-{code,data}. self=data→rdi (wie Methode),
          // explizite Args→rsi,rdx,... call code. argNode = cg_nc1 (isMethod==1).
          // #2084: self (data) in rdi, explizite Argumente in fuenf Registern, Rest Stapel.
          var mcN: int64 := self.cg_indirektStapelArgs(argNode, 5);
          var mcArgc: int64 := self.cg_indirektRegArgs(argNode, 5);
          self.cg_genExpr(fpObj);                                     // rax = obj
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80);       // mov rax, [rax+disp32] = p
          self.cg_e8(fpOff & 0xFF); self.cg_e8((fpOff >> 8) & 0xFF);
          self.cg_e8((fpOff >> 16) & 0xFF); self.cg_e8((fpOff >> 24) & 0xFF);
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x18);       // mov rbx, [rax]   = code
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x78); self.cg_e8(0x08); // mov rdi,[rax+8] = data (self)
          if (mcArgc >= 5) { self.cg_e8(0x41); self.cg_e8(0x59); }    // pop r9
          if (mcArgc >= 4) { self.cg_e8(0x41); self.cg_e8(0x58); }    // pop r8
          if (mcArgc >= 3) { self.cg_popRcx(); }
          if (mcArgc >= 2) { self.cg_popRdx(); }
          if (mcArgc >= 1) { self.cg_popRsi(); }
          self.cg_e8(0xFF); self.cg_e8(0xD3);                         // call rbx
          self.cg_popStackArgs(mcN + 1);                              // #2084: +1 = self
          return;
        }
        if (fpOff >= 0) {
          // explizite Args auswerten + pushen (argNode = cg_nc1 für isMethod==1)
          // #2084: sechs Register, Rest Stapel.
          var fpN: int64 := self.cg_indirektStapelArgs(argNode, 6);
          var fpArgc: int64 := self.cg_indirektRegArgs(argNode, 6);
          // Objekt → rax; Fn-Adresse aus Feld → rbx
          self.cg_genExpr(fpObj);
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x98);   // mov rbx, [rax+disp32]
          self.cg_e8(fpOff & 0xFF); self.cg_e8((fpOff >> 8) & 0xFF);
          self.cg_e8((fpOff >> 16) & 0xFF); self.cg_e8((fpOff >> 24) & 0xFF);
          // Args zurück in rdi,rsi,rdx,rcx,r8,r9 (normal, arg0→rdi; KEIN env-Shift)
          if (fpArgc >= 6) { self.cg_e8(0x41); self.cg_e8(0x59); }  // pop r9
          if (fpArgc >= 5) { self.cg_e8(0x41); self.cg_e8(0x58); }  // pop r8
          if (fpArgc >= 4) { self.cg_popRcx(); }
          if (fpArgc >= 3) { self.cg_popRdx(); }
          if (fpArgc >= 2) { self.cg_popRsi(); }
          if (fpArgc >= 1) { self.cg_popRdi(); }
          self.cg_e8(0xFF); self.cg_e8(0xD3);   // call rbx
          self.cg_popStackArgs(fpN);            // #2084
          return;
        }
      }
    }
    // Intercept push(arr, val) / pop(arr) free-function forms before arg evaluation
    if (isMethod == 0) {
      // #1289: `append` ist der zweite Name fuer dasselbe. Er fehlte hier und
      // fiel deshalb in den Catch-all weiter unten, der rax nullt — der Aufruf
      // tat nichts, `len(a)` las danach aus einem Nullzeiger und das Programm
      // starb mit SIGSEGV. Der Kommentar dort sagt "should not reach here";
      // genau das war die falsche Annahme.
      if (self.cg_seq(fname, fnlen, "push", 4)
          || self.cg_seq(fname, fnlen, "append", 6)) {
        var pushArr: int64 := argNode;
        var pushVal: int64 := self.cg_nnext(argNode);
        if (pushArr >= 0 && pushVal >= 0) {
          self.cg_genArrayPush(pushArr, pushVal);
          return;
        }
      }
      if (self.cg_seq(fname, fnlen, "pop", 3)) {
        if (argNode >= 0) {
          self.cg_genArrayPop(argNode);
          return;
        }
      }
      // Print / PrintLn multi-arg compile-time type dispatch (WP-OUT-01)
      if (self.cg_seq(fname, fnlen, "Print", 5) ||
          self.cg_seq(fname, fnlen, "PrintLn", 7) ||
          self.cg_seq(fname, fnlen, "Println", 7)) {
        var addNl: int64 := 0;
        if (self.cg_seq(fname, fnlen, "PrintLn", 7) ||
            self.cg_seq(fname, fnlen, "Println", 7)) { addNl := 1; }
        self.cg_genPrintMulti(argNode, addNl, 0);
        return;
      }
      // #1012: Printf(fmt, …) — Format zur Uebersetzungszeit zerlegen. Muss vor
      // der allgemeinen Argumentauswertung stehen, weil jedes Argument seine
      // eigene Ausgaberoutine bekommt.
      if (self.cg_seq(fname, fnlen, "Printf", 6)) {
        self.cg_genPrintf(argNode, self.cg_nnext(argNode));
        return;
      }
      // EPrint / EPrintLn multi-arg to stderr (WP-OUT-02)
      if (self.cg_seq(fname, fnlen, "EPrint", 6) ||
          self.cg_seq(fname, fnlen, "EPrintLn", 8)) {
        var addNl: int64 := 0;
        if (self.cg_seq(fname, fnlen, "EPrintLn", 8)) { addNl := 1; }
        self.cg_genPrintMulti(argNode, addNl, 1);
        return;
      }
    }

    var argc: int64 := 0;
    var isStaticCall: int64 := 0;
    var cur: int64 := argNode;
    while (cur != -1) { argc := argc + 1; cur := self.cg_nnext(cur); }

    // #1249: Ein Lambda als ARGUMENT landet immer in einem `fn(...)`-Parameter
    // — eine andere Form, es entgegenzunehmen, gibt es nicht. Faengt es etwas
    // ein, passt es dort nicht hinein.
    cur := argNode;
    while (cur != -1) {
      self.cg_rejectCapturingClosure(cur, "als Argument eines Aufrufs"c);
      cur := self.cg_nnext(cur);
    }

    // WP-MEM-05: mmap(size: N) or mmap(len: N) — expand single named arg to 6-arg syscall
    if (isMethod == 0 && argc == 1 && argNode >= 0 && self.cg_nkind(argNode) == CGN_NAMED_ARG) {
      var mmArg: pchar := self.cg_nsval(argNode);
      var mmLen: int64 := self.cg_nslen(argNode);
      var isMmapName: int64 := 0;
      if (fnlen == 4) {
        if (StrCharAt(fname,0)==109 && StrCharAt(fname,1)==109 &&
            StrCharAt(fname,2)==97  && StrCharAt(fname,3)==112) { isMmapName := 1; }
      }
      var isLenArg: int64 := 0;
      if (mmLen == 4) {
        if (StrCharAt(mmArg,0)==115 && StrCharAt(mmArg,1)==105 &&
            StrCharAt(mmArg,2)==122 && StrCharAt(mmArg,3)==101) { isLenArg := 1; } // "size"
      }
      if (mmLen == 3) {
        if (StrCharAt(mmArg,0)==108 && StrCharAt(mmArg,1)==101 &&
            StrCharAt(mmArg,2)==110) { isLenArg := 1; } // "len"
      }
      if (isMmapName != 0 && isLenArg != 0) {
        self.cg_movRaxImm(0);    self.cg_pushRax();  // addr=0
        self.cg_genExpr(self.cg_nc0(argNode)); self.cg_pushRax();  // len=value
        self.cg_movRaxImm(3);    self.cg_pushRax();  // prot=PROT_RW
        self.cg_movRaxImm(34);   self.cg_pushRax();  // flags=MAP_ANON
        self.cg_movRaxImm(-1);   self.cg_pushRax();  // fd=-1
        self.cg_movRaxImm(0);    self.cg_pushRax();  // offset=0
        self.cg_e8(0x41); self.cg_e8(0x59);  // pop r9
        self.cg_e8(0x41); self.cg_e8(0x58);  // pop r8
        self.cg_popRcx(); self.cg_popRdx(); self.cg_popRsi(); self.cg_popRdi();
        self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xCA);  // mov r10,rcx
        self.cg_movRaxImm(9); self.cg_e8(0x0F); self.cg_e8(0x05);
        self.cg_emitIoResultSave();
        if (self.ioCheckEnabled != 0) { self.cg_emitIoCheckPanic(); }
        return;
      }
    }

    // WP-MEM-05: default params — find callee in same-module top-level declarations
    // and emit default expressions for trailing params not covered by explicit args.
    // Only applies to user-defined functions (isMethod == 0, not a builtin).
    var cgDefFuncNi: int64 := -1;
    if (isMethod == 1) {
      // #1637: Auch eine Methode kann Vorgabewerte haben. Bis hierher galt die
      // Suche nur fuer freie Funktionen (`isMethod == 0`) — die Ebene fuer
      // Methoden fehlte im Entwurf, also blieb die Luecke im Aufruf offen.
      // Der Empfaenger steht in c0; bei `super.M()` ist es die Elternklasse
      // der gerade uebersetzten Klasse.
      var cgMcls: int64 := 0 - 1;
      if (isSuperCall != 0) {
        var cgCur: int64 := self.cg_curClassIdx();
        if (cgCur >= 0) {
          cgMcls := peek64(self.classLayouts + cgCur * CG_CLASS_SZ + CG_CLASS_OFF_PARENTIDX);
        }
      } else {
        cgMcls := self.cg_objClassIdx(self.cg_nc0(ni));
      }
      if (cgMcls >= 0) {
        cgDefFuncNi := self.cg_findMethodDeclNi(cgMcls, fname, fnlen);
      }
      // #2228: Methoden einbetten. Bis hierher galt #2208 nur fuer freie
      // Funktionen; die heissesten Funktionen des Compilers sind aber
      // Methoden (`self.cg_nkind(i)`). Zulaessig ist nur der DIREKTE Aufruf:
      // kein `super`, kein statischer Aufruf, und die Methode hat in der
      // Klasse des Empfaengers keinen VMT-Platz (sonst entscheidet erst die
      // Laufzeit, welcher Rumpf gilt). Die Methode selbst traegt keine Flags
      // (cg_einbettbar: ival == 0 — nicht virtuell, nicht abstrakt, keine
      // Annotation), und der Empfaenger ist ein schlichtes Local, das wie ein
      // Argument fuer `self` eingesetzt wird.
      if (isSuperCall == 0 && cgMcls >= 0 && cgDefFuncNi >= 0
          && self.debugMode == 0 && self.debugInfoEnabled == 0) {
        var emObj: int64 := self.cg_nc0(ni);
        if (self.cg_nkind(emObj) == CGN_IDENT && self.cg_argDirekt(emObj) != 0
            && self.cg_hatVmtPlatz(cgMcls, fname, fnlen) == 0
            && self.cg_einbettbar(cgDefFuncNi) != 0) {
          if (self.cg_betteEinMit(cgDefFuncNi, ni, self.cg_nc1(ni), emObj) != 0) { return; }
        }
      }
    }
    if (isMethod == 0 && nestDecl >= 0) {
      cgDefFuncNi := nestDecl;   // #2044: die innere, nicht die gleichnamige Modulfunktion
    } else if (isMethod == 0 && self.topLevelHead >= 0) {
      cgDefFuncNi := self.cg_tlErsteFunc(fname, fnlen);   // #2175
    }

    // #1252: Aufruf mit benanntem Argument UND einer Luecke, die ein
    // Vorgabewert schliesst — dann steht die fertige Reihenfolge in cgOrdBuf
    // und tritt an die Stelle der Knotenkette. In jedem anderen Fall ist
    // ordCnt -1 und unten aendert sich nichts.
    var ordCnt: int64 := 0 - 1;
    if (cgDefFuncNi >= 0) { ordCnt := self.cg_orderCallArgs(cgDefFuncNi, argNode); }
    if (ordCnt >= 0) { argc := ordCnt; }

    // L-4: resolve smObj and static-call BEFORE ordering push
    var smObj: int64 := -1;
    if (isMethod == 1) {
      smObj := self.cg_nc0(ni);
      if (self.cg_nkind(smObj) == CGN_IDENT) {
        var smName: pchar := self.cg_nsval(smObj);
        var smLen:  int64 := self.cg_nslen(smObj);
        if (self.cg_findLocalIdx(smName, smLen) < 0 &&
            self.cg_findClass(smName, smLen) >= 0) {
          isStaticCall := 1;
        }
      }
    }

    // L-4: total arg slots including implicit self.
    // Auch der statische Aufruf `TypeName.Method(a)` braucht den self-Slot: der
    // Callee `TypeName_Method` hat IMMER ein implizites self als ersten Parameter.
    // Ohne den Slot rutschten alle Argumente um ein Register nach vorn — self
    // bekam den ersten echten Wert, der erste Parameter Müll (`SB.Create(41)`
    // lieferte 169 statt 42). Statt einer Instanz wird 0 übergeben; dass die
    // Methode self nicht anfassen darf, prüft sema bereits (BUG-6).
    var nExpl: int64 := argc;
    var nTotal: int64 := argc;
    if (isMethod == 1) { nTotal := argc + 1; }

    // #1595: Gibt der Gerufene ein STRUCT by value zurueck, stellt DIESER
    // Rahmen den Platz und reicht die Adresse als verdecktes erstes Argument
    // durch. Bei einer Methode liegen dann ZWEI verdeckte Werte vorn:
    // rdi = Zieladresse, rsi = self, die echten Parameter ab rdx.
    var sretBytes: int64 := 0;
    var sretOff:   int64 := 0;
    if (isSuperCall == 0) { sretBytes := self.cg_callRetStructBytes(ni); }
    if (sretBytes > 0) {
      nTotal := nTotal + 1;
      sretOff := self.cg_reserveFrame(sretBytes);
    }

    if (nTotal <= 6) {
      // #1595: der verdeckte Zeiger zuerst — die Pops unten fuellen rueckwaerts,
      // das erste Gepushte landet also in rdi.
      if (sretBytes > 0) {
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x85); self.cg_e32(sretOff);  // lea rax,[rbp+off]
        self.cg_pushRax();
      }
      // #2228: Die HINTEREN Argumente, die nur ein Literal oder ein schlichtes
      // Local sind (cg_argDirekt), werden nicht gepusht, sondern nach den Pops
      // direkt in ihr Register geladen. Dazwischen laeuft nur Laden ohne
      // Wirkung — der Wert ist also derselbe wie beim Push. Nur ohne
      // Umordnung (ordCnt < 0) und ohne nachgeschobene Vorgabewerte: die
      // landeten sonst HINTER den zurueckgehaltenen.
      // Selbstbau: 134 000 Stellen `push rax; pop reg`, 19 % der Proben auf
      // push/pop (Store->Load-Weiterleitung auf dem kritischen Pfad).
      var direktAb: int64 := 0 - 1;   // erster zurueckgehaltener Argumentindex
      if (ordCnt < 0 && sretBytes == 0) {
        var dExpl: int64 := 0;
        var dLetzteNicht: int64 := 0 - 1;
        var dc: int64 := argNode;
        while (dc != -1) {
          if (self.cg_argDirekt(dc) == 0) { dLetzteNicht := dExpl; }
          dExpl += 1;
          dc := self.cg_nnext(dc);
        }
        var dVorgabe: int64 := 0;
        if (cgDefFuncNi >= 0) {
          var dpc: int64 := 0;
          var dpn: int64 := self.cg_nc0(cgDefFuncNi);
          while (dpn >= 0) { dpc += 1; dpn := self.cg_nnext(dpn); }
          if (dpc > dExpl) { dVorgabe := 1; }
        } else if (isMethod == 0 && self.cg_findDefault(fname, fnlen, dExpl) >= 0) {
          dVorgabe := 1;
        }
        if (dVorgabe == 0 && dLetzteNicht + 1 < dExpl) {
          direktAb := dLetzteNicht + 1;                     // Index unter den expliziten
          if (isMethod == 1) { direktAb += 1; }             // self liegt davor
          // Ist ALLES direkt, darf auch self mit — wenn es selbst direkt ist.
          if (isMethod == 1 && dLetzteNicht < 0 && isSuperCall == 0 && isStaticCall == 0
              && self.cg_argDirekt(smObj) != 0) {
            direktAb := 0;
          }
        }
      }
      // Simple path: all fit in registers — push self first (method), then args, then defaults
      if (isMethod == 1) {
        if (direktAb != 0) {
          if (isSuperCall != 0) { self.cg_loadLocalByName("self"c, 4); }
          else { if (isStaticCall == 0) { self.cg_genExpr(smObj); }
          else { self.cg_zeroRax(); } }        // statisch: self = 0
          self.cg_pushRax();
        }
        argc += 1;
      }
      if (ordCnt >= 0) {
        // #1252: fertige Reihenfolge, Vorgabewerte inbegriffen — der Nachlauf
        // fuer hintere Parameter unten entfaellt damit.
        var oi: int64 := 0;
        while (oi < ordCnt) {
          self.cg_genExpr(peek64(self.cgOrdBuf + oi * 8));
          self.cg_pushRax();
          oi := oi + 1;
        }
      } else {
      cur := argNode;
      var dIdx: int64 := 0;
      if (isMethod == 1) { dIdx := 1; }
      while (cur != -1) {
        if (direktAb < 0 || dIdx < direktAb) {
          self.cg_genExpr(cur);
          self.cg_pushRax();
        }
        dIdx += 1;
        cur := self.cg_nnext(cur);
      }
      if (direktAb >= 0) { self.direktAb := direktAb + 1; self.direktArgs := argNode; self.direktMitSelf := isMethod; self.direktSelf := smObj; }
      // WP-MEM-05: emit default expressions for remaining params
      if (cgDefFuncNi >= 0) {
        var cgPn: int64 := self.cg_nc0(cgDefFuncNi);
        var cgSkip: int64 := 0;
        while (cgSkip < argc && cgPn >= 0) {
          cgPn := self.cg_nnext(cgPn);
          cgSkip += 1;
        }
        while (cgPn >= 0) {
          var cgDef: int64 := self.cg_nc1(cgPn);
          if (cgDef >= 0) {
            self.cg_genExpr(cgDef);
            self.cg_pushRax();
            argc += 1;
          }
          cgPn := self.cg_nnext(cgPn);
        }
      }

      // #1342: Die Funktion steht nicht in der eigenen Modulkette — dann
      // stammt sie aus einem Import, und ihre Knoten gibt es hier nicht mehr.
      // Die konstanten Vorgaben wurden beim Einlesen abgeschrieben.
      if (cgDefFuncNi < 0 && isMethod == 0 && ordCnt < 0) {
        var dpi: int64 := argc;
        var weiter: int64 := 1;
        while (weiter == 1) {
          var di: int64 := self.cg_findDefault(fname, fnlen, dpi);
          if (di < 0) { weiter := 0; }
          if (di >= 0) {
            var db: int64 := self.defTab + di * 48;
            // Ganzzahl, Wahrheitswert oder f64-Bitmuster — alle drei liegen
            // in einem Maschinenwort.
            self.cg_movRaxImm(peek64(db + 32));
            self.cg_pushRax();
            argc += 1;
            dpi := dpi + 1;
          }
        }
      }
      }
    } else {
      // L-4: 7+ param path — push stack args first (reverse), then register args
      var argBuf: int64 := alloc(nExpl * 8);
      var acnt: int64 := 0;
      if (ordCnt >= 0) {
        // #1252: dieselbe geordnete Liste, nur in der Reihenfolge des 7+-Pfades
        // abgearbeitet.
        while (acnt < ordCnt) {
          poke64(argBuf + acnt * 8, peek64(self.cgOrdBuf + acnt * 8));
          acnt += 1;
        }
      } else {
      var acur: int64 := argNode;
      while (acur != -1) {
        poke64(argBuf + acnt * 8, acur);
        acnt += 1;
        acur := self.cg_nnext(acur);
      }
      }
      // #1595: Der verdeckte Rueckgabezeiger belegt ein Register wie `self`.
      // Damit verschiebt sich die Grenze zwischen Register- und Stapelargumenten
      // um eins — genau so, wie sie sich bei einer Methode schon verschiebt.
      // Drei Tests im Bestand (quat_test, rest00_test, do_test_transport)
      // rufen struct-rueckgebende Funktionen mit sechs und mehr Argumenten;
      // eine "benannte Luecke" waere hier also keine Grenze, sondern ein
      // Rueckschritt gewesen.
      var regPlaetze: int64 := 6;
      if (sretBytes > 0) { regPlaetze := regPlaetze - 1; }
      if (isMethod == 1) { regPlaetze := regPlaetze - 1; }

      if (sretBytes > 0) {
        // Zuerst die Stapelargumente (tiefste zuerst) — sie muessen unter den
        // Registerargumenten liegen, deshalb vor allen Pushes fuer Register.
        var sis: int64 := nExpl - 1;
        while (sis >= regPlaetze) {
          self.cg_genExpr(peek64(argBuf + sis * 8));
          self.cg_pushRax();
          sis -= 1;
        }
        // Dann der verdeckte Zeiger …
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x85); self.cg_e32(sretOff);
        self.cg_pushRax();
        // … bei einer Methode danach self …
        if (isMethod == 1) {
          if (isSuperCall != 0) { self.cg_loadLocalByName("self"c, 4); }
          else { if (isStaticCall == 0) { self.cg_genExpr(smObj); } else { self.cg_zeroRax(); } }
          self.cg_pushRax();
          argc += 1;
        }
        // … und zuletzt die Argumente, die in Register gehen.
        var ris: int64 := 0;
        while (ris < regPlaetze && ris < nExpl) {
          self.cg_genExpr(peek64(argBuf + ris * 8));
          self.cg_pushRax();
          ris += 1;
        }
      } else if (isMethod == 1) {
        argc += 1;
        // Push stack explicit args in reverse: arg[nExpl-1] deepest, arg[5] shallowest
        var si: int64 := nExpl - 1;
        while (si >= 5) {
          self.cg_genExpr(peek64(argBuf + si * 8));
          self.cg_pushRax();
          si -= 1;
        }
        // Push self into rdi slot (statisch: 0 — siehe Kommentar oben)
        // #1091: Bei `super.M()` gibt es keinen Empfaengerknoten -- der Aufruf
        // laeuft auf derselben Instanz, also das lokale `self` laden.
        if (isSuperCall != 0) { self.cg_loadLocalByName("self"c, 4); }
        else { if (isStaticCall == 0) { self.cg_genExpr(smObj); }
        else { self.cg_zeroRax(); } }
        self.cg_pushRax();
        // Push register explicit args: arg[0..4]
        var ri: int64 := 0;
        while (ri < 5 && ri < nExpl) {
          self.cg_genExpr(peek64(argBuf + ri * 8));
          self.cg_pushRax();
          ri += 1;
        }
      } else {
        // Non-method: push stack args in reverse (arg[argc-1]..arg[6]), then reg args (arg[0..5])
        var si2: int64 := argc - 1;
        while (si2 >= 6) {
          self.cg_genExpr(peek64(argBuf + si2 * 8));
          self.cg_pushRax();
          si2 -= 1;
        }
        var ri2: int64 := 0;
        while (ri2 < 6) {
          self.cg_genExpr(peek64(argBuf + ri2 * 8));
          self.cg_pushRax();
          ri2 += 1;
        }
      }
      free(argBuf, nExpl * 8);
    }

    // #1595: Jetzt erst mitzaehlen — vorher haette es die Nachlauflogik fuer
    // Vorgabewerte verschoben, die `argc` als Zahl der schon belegten
    // Parameter liest.
    if (sretBytes > 0) { argc += 1; }

    // Pop args into registers
    // #2228: zurueckgehaltene hintere Argumente (siehe direktAb oben) liegen
    // nicht auf dem Stapel — gepoppt wird nur bis davor, danach geladen.
    var gepusht: int64 := argc;
    var dAb: int64 := self.direktAb - 1;
    self.direktAb := 0;
    if (dAb >= 0) { gepusht := dAb; }
    // #2228: Wurde das letzte Argument EBEN gepusht (nichts dazwischen), wird
    // `push rax; pop reg` zu `mov reg, rax` — der Wert steht noch in rax. Das
    // war die haeufigste Form ueberhaupt (`peek32(K + i * 4)`: push, pop rdi).
    // Ein Sprungziel zwischen push und pop gibt es nicht: ein Weg, der den
    // push uebersprungen haette, haette den Stapel unausgeglichen hinterlassen.
    var oberstes: int64 := gepusht;
    if (gepusht >= 1 && gepusht <= 6 && self.pushRaxEnde == self.codeLen
        && peek8(self.code + self.codeLen - 1) == 0x50) {
      self.codeLen := self.codeLen - 1;                          // push rax zuruecknehmen
      self.cg_movArgRegRax(gepusht - 1);
      oberstes := gepusht - 1;
    }
    if (oberstes >= 6) { self.cg_e8(0x41); self.cg_e8(0x59); }  // pop r9  (arg5)
    if (oberstes >= 5) { self.cg_e8(0x41); self.cg_e8(0x58); }  // pop r8  (arg4)
    if (oberstes >= 4) { self.cg_popRcx(); }                      // pop rcx (arg3)
    if (oberstes >= 3) { self.cg_popRdx(); }                      // pop rdx (arg2)
    if (oberstes >= 2) { self.cg_popRsi(); }                      // pop rsi (arg1)
    if (oberstes >= 1) { self.cg_popRdi(); }                      // pop rdi (arg0)
    if (dAb >= 0) {
      var di: int64 := 0;
      var da: int64 := self.direktArgs;
      if (self.direktMitSelf == 1) {
        if (dAb == 0) { self.cg_genExpr(self.direktSelf); self.cg_movArgRegRax(0); }
        di := 1;
      }
      while (da != -1) {
        if (di >= dAb) { self.cg_genExpr(da); self.cg_movArgRegRax(di); }
        di += 1;
        da := self.cg_nnext(da);
      }
    }
    
    // WP-13: For nested function calls, pass static link (rbp+16 from outer frame)
    // Check if this is a nested function by checking staticLinkOffset >= 0
    if (self.staticLinkOffset >= 0) {
      // Push static link as hidden first argument
      // mov rax, [rbp+16]  (load static link from outer frame)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x45); self.cg_e8(0x10);
      self.cg_pushRax();
      // Adjust: pop into r10 (8th arg) or push before other args
      // For simplicity, we pass static link in r10 (sysv abi: r10 for special args)
      self.cg_popRax();
      self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);  // mov r10, rax
    }

    // For method calls: mangle name and emit call
    if (isMethod == 1) {
      var objNode: int64 := self.cg_nc0(ni);
      var classIdx: int64 := self.cg_objClassIdx(objNode);
      // #1091: Bei `super.M()` zaehlt die ELTERNKLASSE der gerade erzeugten
      // Klasse, und der Aufruf geht DIREKT dorthin -- nicht ueber die VMT.
      // Ueber die VMT riefe `super.F()` in einem `override fn F()` sich
      // selbst, endlos.
      if (isSuperCall != 0) {
        classIdx := 0 - 1;
        var curIdx: int64 := self.cg_curClassIdx();
        if (curIdx >= 0) {
          var parIdx: int64 := peek64(self.classLayouts + curIdx * CG_CLASS_SZ + CG_CLASS_OFF_PARENTIDX);
          if (parIdx >= 0) {
            // #1650: Nicht die direkte Basisklasse mangeln, sondern die, die
            // die Methode DEKLARIERT. Schiebt sich eine Klasse ohne eigene
            // Implementierung dazwischen (`TC extends TB extends TA`, Sag nur
            // in TA), gibt es kein `TB_Sag` — der Aufruf lief in
            // "undefined function 'TB_Sag'". `super` meint die naechste
            // Implementierung entlang der Kette, wie `inherited` in Object
            // Pascal und `super` in C++/Java. cg_findMethodOwner laeuft diese
            // Kette bereits ab; hier wurde er nur nicht gefragt. Dieselbe
            // Ueberlegung stand schon bei #1120 fuer den gewoehnlichen Aufruf.
            var supOwn: int64 := self.cg_findMethodOwner(parIdx, fname, fnlen);
            if (supOwn >= 0) { parIdx := supOwn; }
            var pcName: pchar := peek64(self.classLayouts + parIdx * CG_CLASS_SZ) as pchar;
            var pcLen:  int64 := peek64(self.classLayouts + parIdx * CG_CLASS_SZ + CG_CLASS_OFF_NAMELEN);
            var spLen: int64 := pcLen + 1 + fnlen;
            var spBuf: int64 := alloc(spLen + 1);
            var spI: int64 := 0;
            while (spI < pcLen) { poke8(spBuf + spI, StrCharAt(pcName, spI)); spI := spI + 1; }
            StrSetChar(spBuf as pchar, pcLen, 95);
            var spJ: int64 := 0;
            while (spJ < fnlen) { poke8(spBuf + pcLen + 1 + spJ, StrCharAt(fname, spJ)); spJ := spJ + 1; }
            poke8(spBuf + spLen, 0);
            var spPp: int64 := self.cg_emitCall();
            self.cg_addPatch(spPp, spBuf, spLen, CG_PATCH_CALL);
            self.cg_trackTempBuf(spBuf, spLen + 1);
          } else {
            EPrintStrLn("error: super ohne Elternklasse"c);
            self.cg_zeroRax();
          }
        } else {
          EPrintStrLn("error: super ausserhalb einer Klassenmethode"c);
          self.cg_zeroRax();
        }
      } else if (classIdx >= 0) {
        var clsBase: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
        // WP-BC-L2: virtual dispatch. If the method occupies a VMT slot in the
        // object's static class, call through the runtime vtable instead of a
        // static mangled name — this is what makes override/late-binding work.
        // Slot indices are consistent base↔derived (parent slots copied first),
        // so the static class's slot index correctly indexes the dynamic vtable.
        var vmtListCS: int64   := peek64(clsBase + CG_CLASS_OFF_VMTLIST);
        var vmtSlotsCS: int64  := peek64(clsBase + CG_CLASS_OFF_VMTSLOTS);
        var vSlot: int64 := 0 - 1;
        var vs: int64 := 0;
        while (vs < vmtSlotsCS) {
          var vName: pchar := peek64(vmtListCS + vs * 16) as pchar;
          var vLen:  int64 := peek64(vmtListCS + vs * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN);
          if (self.cg_seq(vName, vLen, fname, fnlen) != 0) { vSlot := vs; break; }
          vs += 1;
        }
        if (vSlot >= 0 && isStaticCall == 0) {
          // self is in rdi (arg0). mov rax,[rdi]; mov rax,[rax+slot*8]; call rax
          //
          // #1694: ...ausser bei Struct-Rueckgabe. Dann traegt rdi die
          // Zieladresse des Aufrufers und `self` ist nach rsi gerueckt (#1595).
          // Der Dispatch las weiter aus rdi, nahm also den sret-Puffer fuer das
          // Objekt, holte daraus Muell als Vtable-Zeiger und sprang dorthin —
          // der Absturz kam VOR der ersten Zeile der Methode.
          //
          // Ausgeloest hat es die blosse Anwesenheit eines Interfaces mit
          // gleichnamiger Methode: erst dadurch wird der Aufruf ueberhaupt
          // virtuell. Der Rueckgabetyp der Interface-Methode spielt keine
          // Rolle, ein anderer Name genuegt zum Ausweichen — beides passt dazu,
          // dass nicht die Aufloesung falsch war, sondern das Register.
          if (sretBytes > 0) {
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x06);   // mov rax,[rsi]
          } else {
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x07);
          }
          var vdisp: int64 := vSlot * 8;
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80);
          self.cg_e8(vdisp & 0xFF);
          self.cg_e8((vdisp >> 8) & 0xFF);
          self.cg_e8((vdisp >> 16) & 0xFF);
          self.cg_e8((vdisp >> 24) & 0xFF);
          self.cg_e8(0xFF); self.cg_e8(0xD0);
          return;
        }
        // #1120: nicht die statische Klasse des Empfaengers mangeln, sondern
        // die Klasse, die die Methode deklariert. Fuer eine geerbte
        // nicht-virtuelle Methode gibt es kein `B_G` — der Rumpf steht unter
        // `A_G`. Wird nichts gefunden, bleibt es beim statischen Namen und der
        // Abbruch in cg_patchAll meldet ihn wie bisher.
        var mangBase: int64 := clsBase;
        var ownerIdx: int64 := self.cg_findMethodOwner(classIdx, fname, fnlen);
        if (ownerIdx >= 0) { mangBase := self.classLayouts + ownerIdx * CG_CLASS_SZ; }
        var clsName: pchar := peek64(mangBase) as pchar;
        var clsLen:  int64 := peek64(mangBase + CG_CLASS_OFF_NAMELEN);
        var mangLen: int64 := clsLen + 1 + fnlen;
        var mangBuf: int64 := alloc(mangLen + 1);
        var mi: int64 := 0;
        while (mi < clsLen) { poke8(mangBuf + mi, StrCharAt(clsName, mi)); mi := mi + 1; }
        StrSetChar(mangBuf as pchar, clsLen, 95);
        var mj: int64 := 0;
        while (mj < fnlen) { poke8(mangBuf + clsLen + 1 + mj, StrCharAt(fname, mj)); mj := mj + 1; }
        poke8(mangBuf + mangLen, 0);
        var pp: int64 := self.cg_emitCall();
        self.cg_addPatch(pp, mangBuf, mangLen, CG_PATCH_CALL);
        // Track mangled method name buffer for cleanup after patching (BUG-02)
        self.cg_trackTempBuf(mangBuf, mangLen + 1);
      } else if (isStaticCall != 0) {
        // TypeName.Method() — mangle as TypeName_Method
        var stName: pchar := self.cg_nsval(objNode);
        var stLen:  int64 := self.cg_nslen(objNode);
        var stMangLen: int64 := stLen + 1 + fnlen;
        var stMangBuf: int64 := alloc(stMangLen + 1);
        var stMi: int64 := 0;
        while (stMi < stLen) { poke8(stMangBuf + stMi, StrCharAt(stName, stMi)); stMi := stMi + 1; }
        StrSetChar(stMangBuf as pchar, stLen, 95);
        var stMj: int64 := 0;
        while (stMj < fnlen) { poke8(stMangBuf + stLen + 1 + stMj, StrCharAt(fname, stMj)); stMj := stMj + 1; }
        poke8(stMangBuf + stMangLen, 0);
        var stPp: int64 := self.cg_emitCall();
        self.cg_addPatch(stPp, stMangBuf, stMangLen, CG_PATCH_CALL);
        self.cg_trackTempBuf(stMangBuf, stMangLen + 1);
      } else {
        var pp: int64 := self.cg_emitCall();
        self.cg_addPatch(pp, fname as int64, fnlen, CG_PATCH_CALL);
      }
      self.cg_popStackArgs(nTotal);
      return;
    }

    // Check for builtin functions
    var pstr: pchar := "PrintStr";
    var pint: pchar := "PrintInt";
    var slen: pchar := "StrLen";
    var mmapn: pchar := "mmap";
    var pk8: pchar := "poke8";
    var pk64: pchar := "poke64";
    var gk8: pchar := "peek8";
    var gk64: pchar := "peek64";
    var pk32: pchar := "poke32";
    var gk32: pchar := "peek32";

    // #1311: Weiche VOR der Builtin-Kette — siehe cg_builtinArity.
    // #2082: ... und eine Funktion der EIGENEN Unit verdeckt den Builtin
    // ganz, unabhaengig von der Argumentzahl (cg_eigeneUnitDefiniert).
    if (isMethod == 0) {
      var wantArgc: int64 := self.cg_builtinArity(fname, fnlen);
      var eigen: int64 := 0;
      if (nestDecl < 0) { eigen := self.cg_eigeneUnitDefiniert(fname, fnlen); }
      if ((wantArgc >= 0 && argc != wantArgc) || eigen != 0) {
        var uPp: int64 := self.cg_emitCall();
        // #1655: auch hier die unit-eigene Marke, wenn es sie gibt.
        if (self.cg_unitPrivHat(fname, fnlen) != 0) {
          var uac: int64 := alloc(8);
          var uab: int64 := self.cg_unitPrivMangle(fname, fnlen, uac);
          self.cg_addPatch(uPp, uab, peek64(uac), CG_PATCH_CALL);
          self.cg_trackTempBuf(uab, peek64(uac) + 1);
          free(uac, 8);
        } else {
        self.cg_addPatch(uPp, fname as int64, fnlen, CG_PATCH_CALL);
        }
        self.cg_popStackArgs(nTotal);
        return;
      }
    }

    if (self.cg_seq(fname, fnlen, pstr, 8)) {
      // call _lyx_print_str  (rdi already has the arg)
      var pp: int64 := self.cg_emitCall();
      poke32(self.code + pp, CG_H_PRINTSTR - pp - 4);

    } else if (self.cg_seq(fname, fnlen, pint, 8)) {
      var pp: int64 := self.cg_emitCall();
      poke32(self.code + pp, CG_H_PRINTINT - pp - 4);

    } else if (self.cg_seq(fname, fnlen, "EPrintStr", 9)) {
      var pp: int64 := self.cg_emitCall();
      poke32(self.code + pp, CG_H_EPRINTSTR - pp - 4);

    } else if (self.cg_seq(fname, fnlen, "EPrintInt", 9)) {
      var pp: int64 := self.cg_emitCall();
      poke32(self.code + pp, CG_H_EPRINTINT - pp - 4);

    } else if (self.cg_seq(fname, fnlen, "EPrintStrLn", 11)) {
      // EPrintStrLn(s): EPrintStr(s) then "\n" to stderr
      var pp: int64 := self.cg_emitCall();
      poke32(self.code + pp, CG_H_EPRINTSTR - pp - 4);
      var enlOff: int64 := self.dataLen;
      self.cg_edata(10); self.cg_edata(0);
      self.cg_emitLeaRdiData(enlOff);
      var ppNL: int64 := self.cg_emitCall();
      poke32(self.code + ppNL, CG_H_EPRINTSTR - ppNL - 4);
      self.cg_zeroRax();

    } else if (self.cg_seq(fname, fnlen, "EPrintFloat", 11)) {
      // EPrintFloat(f: f64): call _lyx_f64_to_str(xmm0) → rax=buf → call _lyx_eprint_str
      var ppEpf: int64 := self.cg_emitCall();
      poke32(self.code + ppEpf, CG_H_F64STR - ppEpf - 4);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);  // mov rdi, rax
      var ppEps: int64 := self.cg_emitCall();
      poke32(self.code + ppEps, CG_H_EPRINTSTR - ppEps - 4);
      self.cg_zeroRax();

    } else if (self.cg_seq(fname, fnlen, "EPrintBool", 10)) {
      // EPrintBool(b): print "true" or "false" to stderr
      var epbTOff: int64 := self.dataLen;
      self.cg_edata(116); self.cg_edata(114); self.cg_edata(117); self.cg_edata(101); self.cg_edata(0);
      var epbFOff: int64 := self.dataLen;
      self.cg_edata(102); self.cg_edata(97); self.cg_edata(108); self.cg_edata(115); self.cg_edata(101); self.cg_edata(0);
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);  // test rdi, rdi
      self.cg_e8(0x74); var epbFJ: int64 := self.codeLen; self.cg_e8(0);
      self.cg_emitLeaRdiData(epbTOff);
      var ppepbT: int64 := self.cg_emitCall();
      poke32(self.code + ppepbT, CG_H_EPRINTSTR - ppepbT - 4);
      self.cg_e8(0xEB); var epbEJ: int64 := self.codeLen; self.cg_e8(0);
      cg_patchRel8(self.code, epbFJ, self.codeLen);
      self.cg_emitLeaRdiData(epbFOff);
      var ppepbF: int64 := self.cg_emitCall();
      poke32(self.code + ppepbF, CG_H_EPRINTSTR - ppepbF - 4);
      cg_patchRel8(self.code, epbEJ, self.codeLen);
      self.cg_zeroRax();

    } else if (self.cg_seq(fname, fnlen, slen, 6)) {
      var pp: int64 := self.cg_emitCall();
      var rel32: int64 := CG_H_STRLEN - pp - 4;
      poke32(self.code + pp, rel32);

    } else if (self.cg_seq(fname, fnlen, "StrSub", 6)) {
      // StrSub(s: pchar, start: int64, len: int64): pchar
      // rdi=s, rsi=start, rdx=len
      // Call _lyx_strsub helper
      var pp: int64 := self.cg_emitCall();
      var rel32: int64 := CG_H_STRSUB - pp - 4;
      poke32(self.code + pp, rel32);

