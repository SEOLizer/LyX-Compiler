  // ------------------------------------------------------------------
  // Import resolution (WP-09)
  // ------------------------------------------------------------------

  // Read a file into an mmap buffer (null-terminated). Returns null on error.
  fn cg_readFile(path: pchar): pchar {
    var fd: int64 := open(path, 0, 0);
    if (fd < 0) { return 0 as pchar; }
    var size: int64 := lseek(fd, 0, 2);
    if (size <= 0) { close(fd); return 0 as pchar; }
    lseek(fd, 0, 0);
    var buf: int64 := mmap(0, size + 1, 3, 34, -1, 0);
    read(fd, buf as pchar, size);
    poke8(buf + size, 0);
    close(fd);
    return buf as pchar;
  }

  // Returns 1 if module name was already imported, 0 otherwise.
  fn cg_hasImported(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.importCount) {
      var base: int64 := self.importNames + i * CG_IMPORT_SZ;
      var p: pchar    := peek64(base) as pchar;
      var n: int64    := peek64(base + CG_PATCH_OFF_NAMEPTR);
      if (n == nameLen && self.cg_seq(p, n, name, nameLen)) { return 1; }
      i := i + 1;
    }
    return 0;
  }

  // Mark a module as imported (add to dedup set).
  fn cg_markImported(name: pchar, nameLen: int64) {
    if (self.importCount >= self.importCap) {
      var nc: int64 := self.importCap * 2;
      var nb: int64 := mmap(0, nc * 16, 3, 34, -1, 0);
      var i: int64 := 0;
      memcpy(nb, self.importNames, self.importCount * CG_IMPORT_SZ);
      self.importNames := nb;
      self.importCap   := nc;
    }
    var base: int64 := self.importNames + self.importCount * CG_IMPORT_SZ;
    poke64(base,      name as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  nameLen);
    self.importCount := self.importCount + 1;
  }

  // Try to read `relPath` relative to `base` (base + "/" + relPath).
  // Returns null pchar on failure; caller owns the returned buffer.
  fn cg_tryReadWithBase(base: pchar, relPath: pchar): pchar {
    var baseLen: int64 := StrLen(base);
    var relLen:  int64 := StrLen(relPath);
    var tryLen:  int64 := baseLen + 1 + relLen + 1;
    var tryBuf:  int64 := mmap(0, tryLen, 3, 34, -1, 0);
    var i: int64 := 0;
    memcpy(tryBuf, base as int64, baseLen);
    StrSetChar(tryBuf as pchar, i, 47); i := i + 1;
    var j: int64 := 0;
    memcpy(tryBuf + i, relPath as int64, relLen);
    poke8(tryBuf + i + j, 0);
    var src: pchar := self.cg_readFile(tryBuf as pchar);
    munmap(tryBuf, tryLen);
    return src;
  }

  // Process an import: find the .lyx file, parse it, codegen it.
  // Temporarily swaps pSrc/pNodes to the imported file's data.
  fn cg_processImport(modName: pchar, nameLen: int64) {
    if (self.cg_hasImported(modName, nameLen) != 0) { return; }
    self.cg_markImported(modName, nameLen);

    // Convert "bootstrap.parser" → "bootstrap/parser.lyx"
    var pathBuf: int64 := mmap(0, nameLen + 8, 3, 34, -1, 0);
    var i: int64 := 0;
    while (i < nameLen) {
      var c: int64 := StrCharAt(modName, i);
      if (c == 46) { c := 47; }  // '.' → '/'
      poke8(pathBuf + i, c);
      i := i + 1;
    }
    var lyxExtCG: pchar := ".lyx";
    memcpy(pathBuf + nameLen, lyxExtCG as int64, 5);

    var path: pchar := pathBuf as pchar;
    var src: pchar := self.cg_readFile(path);

    // Fall back to includePath (LYX_PATH / -I) then stdPath (LYX_STD_PATH / --std-path)
    if (src == 0 as pchar && self.includePath != 0) {
      src := self.cg_tryReadWithBase(self.includePath as pchar, path);
    }
    if (src == 0 as pchar && self.stdPath != 0) {
      src := self.cg_tryReadWithBase(self.stdPath as pchar, path);
    }

    var srcSize: int64 := 0;
    if (src != 0 as pchar) { srcSize := StrLen(src); }

    if (src == 0 as pchar) {
      PrintStr("codegen: cannot read import: ");
      PrintStr(path);
      PrintStr("\n");
      munmap(pathBuf, nameLen + 8);
      return;
    }

    // Parse the imported file
    var p: Parser := new Parser();
    p.Init(src, srcSize);
    var head: int64 := p.Parse();

    if (p.hadError != 0) {
      PrintStr("codegen: parse error in import: ");
      PrintStr(path);
      PrintStr("\n");
      munmap(pathBuf, nameLen + 8);
      munmap(src, srcSize);
      dispose p;
      return;
    }

    munmap(pathBuf, nameLen + 8);

    // Switch to imported file's source and nodes for codegen
    var savedSrc:   pchar := self.pSrc;
    var savedNodes: int64 := self.pNodes;
    self.pSrc   := p.src;
    self.pNodes := p.nodes;

    // Recursively generate code for the imported file
    self.cg_genFile(head);
    
    // AP-1: Collect function labels from imported module
    // This makes imported functions visible for patch resolution in main file
    // IMPORTANT: Do this WHILE still switched to import pNodes!
    self.cg_collectImportLabels(head);

    // Restore main file's source and nodes
    self.pSrc   := savedSrc;
    self.pNodes := savedNodes;

    dispose p;
    // NOTE: src (imported source buffer) is intentionally NOT freed here.
    // cg_addLabel/cg_buildStructLayout etc. store raw pointers into src.
    // Freeing src would invalidate those pointers and cause SIGSEGV on lookup.
  }

  // ------------------------------------------------------------------
  // AP-1: Collect labels from imported module
  // Walks the AST and registers all function names as labels for patch resolution
  // ------------------------------------------------------------------
  
  fn cg_collectImportLabels(head: int64): void {
    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_FUNC_DECL) {
        var fname: pchar := self.cg_nsval(cur);
        var fnlen: int64 := self.cg_nslen(cur);
        self.cg_addLabel(fname, fnlen, 0);  // imported: no source line
      }
      cur := self.cg_nnext(cur);
    }
  }

  // WP-BC-24: register a pending generic specialization
  // Entry: {mangledNamePtr:8, mangledNameLen:8, origNamePtr:8, origNameLen:8} = 32 bytes
  fn cg_addMono(mangName: pchar, mangLen: int64, origName: pchar, origLen: int64) {
    if (self.monoCount >= self.monoCap) {
      var nc: int64 := self.monoCap * 2;
      var nb: int64 := mmap(0, nc * 32, 3, 34, -1, 0);
      var ii: int64 := 0;
      memcpy(nb, self.monoList, self.monoCount * CG_MONO_SZ);
      self.monoList := nb; self.monoCap := nc;
    }
    var base: int64 := self.monoList + self.monoCount * CG_MONO_SZ;
    poke64(base,      mangName as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  mangLen);
    poke64(base + CG_PATCH_OFF_NAMELEN, origName as int64);
    poke64(base + CG_PATCH_OFF_KIND, origLen);
    self.monoCount := self.monoCount + 1;
  }

  // WP-BC-24: check if a mangled name is already in the mono list
  fn cg_monoExists(mangName: pchar, mangLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.monoCount) {
      var base: int64 := self.monoList + i * CG_MONO_SZ;
      var n: pchar := peek64(base) as pchar;
      var l: int64 := peek64(base + CG_PATCH_OFF_NAMEPTR);
      if (self.cg_seq(n, l, mangName, mangLen) != 0) { return 1; }
      i := i + 1;
    }
    return 0;
  }

  // WP-BC-24: build mangled name for generic call, e.g. "Foo_int64"
  fn cg_buildMangledName(baseName: pchar, baseLen: int64, typeArgsNi: int64, outBuf: int64): int64 {
    var pos: int64 := 0;
    var i: int64 := 0;
    while (i < baseLen) { poke8(outBuf + pos, StrCharAt(baseName, i)); pos := pos + 1; i := i + 1; }
    var ta: int64 := typeArgsNi;
    while (ta >= 0) {
      StrSetChar(outBuf as pchar, pos, 95); pos := pos + 1;
      var tname: pchar := self.cg_nsval(ta);
      var tlen:  int64 := self.cg_nslen(ta);
      var j: int64 := 0;
      while (j < tlen) { poke8(outBuf + pos, StrCharAt(tname, j)); pos := pos + 1; j := j + 1; }
      ta := self.cg_nnext(ta);
    }
    poke8(outBuf + pos, 0);
    return pos;
  }

  // ------------------------------------------------------------------
  // Top-level file generation
  // ------------------------------------------------------------------

  fn cg_genFile(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_FUNC_DECL) {
        // extern fn NAME(...) link "lib.so": no body (c2 == -1) and a packed
        // library span in c3 ((len<<32)|off). Register it as an FFI import
        // instead of emitting a function body. The (body==-1 && c3!=-1) test
        // distinguishes externs from @export functions, which share iVal==1
        // but always carry a body.
        var libPacked: int64 := self.cg_nc3(cur);
        if (self.cg_nc2(cur) == -1 && libPacked != -1) {
          var libOff: int64 := libPacked & 0xFFFFFFFF;
          var libLen: int64 := (libPacked >> 32) & 0xFFFFFFFF;
          if (libLen > 0) {
            self.cg_addExternDecl(self.cg_nsval(cur), self.cg_nslen(cur),
                                  (self.pSrc as int64) + libOff, libLen);
          }
        } else {
          self.cg_genFuncDecl(cur);
        }
      } else if (k == CGN_IMPORT) {
        // Process the imported module (WP-09: import resolution)
        var modName: pchar := self.cg_nsval(cur);
        var modLen:  int64 := self.cg_nslen(cur);
        self.cg_processImport(modName, modLen);
      } else if (k == CGN_TYPE_DECL) {
        // NK_TYPE_DECL: class if it has methods (nc1 != -1), struct otherwise
        var hasMethods: int64 := self.cg_nc1(cur);
        if (hasMethods == -1) {
          // No methods → treat as struct (fields start at offset 0, no VMT)
          self.cg_buildStructLayout(cur);
        } else {
          // Has methods → class layout (fields at offset 8, VMT at 0)
          self.cg_buildClassLayout(cur);
          var clsName: pchar := self.cg_nsval(cur);
          var clsLen:  int64 := self.cg_nslen(cur);
          var method: int64 := hasMethods;
          while (method != -1) {
            var nextM: int64 := self.cg_nnext(method);
            // WP-BC-20: skip abstract methods (bit3 of iVal) — no code body
            var isAbstM: int64 := (self.cg_nival(method) >> 3) & 1;
            if (isAbstM == 0) {
              self.cg_genMethodDecl(method, clsName, clsLen);
            }
            method := nextM;
          }
        }
      } else if (k == CGN_STRUCT_DECL) {
        // Standalone struct declaration: register field layout (fields at offset 0)
        self.cg_buildStructLayout(cur);
      } else if (k == CGN_ENUM_DECL) {
        // BUG-08: Enum declaration: register variant layout for match analysis
        self.cg_buildEnumLayout(cur);
        // Register enum members as int64 constants (auto-increment from 0)
        var emem: int64 := self.cg_nc0(cur);
        var eVal: int64 := 0;
        while (emem != -1) {
          var evNode: int64 := self.cg_nc0(emem);
          if (evNode >= 0 && self.cg_nkind(evNode) == CGN_LIT_INT) {
            eVal := self.cg_nival(evNode);
          }
          self.cg_addCon(self.cg_nsval(emem), self.cg_nslen(emem), eVal);
          eVal := eVal + 1;
          emem := self.cg_nnext(emem);
        }
      } else if (k == CGN_VAR_DECL) {
        // Global variable: allocate 8 bytes in data section, register in global table
        var gIdx: int64 := self.globalVarCount;
        var doff: int64 := self.cg_addGlobal(self.cg_nsval(cur), self.cg_nslen(cur));
        var gtNode: int64 := self.cg_nc0(cur);
        if (gtNode >= 0 && self.cg_nkind(gtNode) == 60) {
          var gtp: pchar := self.cg_nsval(gtNode);
          var gtn: int64 := self.cg_nslen(gtNode);
          if (gtn == 5 && self.cg_seq(gtp, gtn, "pchar", 5)) {
            poke8(self.globalIsPchar + gIdx, 1);
          }
        }
        // Write literal initializer directly into data section
        var initNode: int64 := self.cg_nc1(cur);
        if (initNode >= 0 && self.cg_nkind(initNode) == CGN_LIT_INT) {
          poke64(self.data + doff, self.cg_nival(initNode));
        }
      } else if (k == CGN_CON_DECL) {
        // Populate constant table; evaluate arbitrary constant expressions
        var initNode: int64 := self.cg_nc1(cur);
        if (initNode >= 0) {
          var conVal: int64 := self.cg_evalConExpr(initNode);
          self.cg_addCon(self.cg_nsval(cur), self.cg_nslen(cur), conVal);
        }
      } else if (k == CGN_ENUM_DECL) {
        // WP-10f: register each enum member as an int64 constant
        // auto-increment from 0; explicit value overrides via child0
        var mem: int64 := self.cg_nc0(cur);
        var nextVal: int64 := 0;
        while (mem != -1) {
          var mname: pchar := self.cg_nsval(mem);
          var mlen:  int64 := self.cg_nslen(mem);
          var valNode: int64 := self.cg_nc0(mem);
          if (valNode >= 0 && self.cg_nkind(valNode) == CGN_LIT_INT) {
            nextVal := self.cg_nival(valNode);
          }
          self.cg_addCon(mname, mlen, nextVal);
          nextVal := nextVal + 1;
          mem := self.cg_nnext(mem);
        }
      } else if (k == CGN_DIM_DECL || k == CGN_UTYPE_DECL) {
        // WP-BC-16: dim/utype are compile-time-only; no code generated
      } else if (k == CGN_BLOCK) {
        // WP-CS-06: inlined @if branch — recurse into children
        self.cg_genFile(self.cg_nc0(cur));
      } else if (k == CGN_AT_DIRECTIVE) {  // WP-CS-07 / WP-AS-04/05 top-level
        var kind: int64 := self.cg_nival(cur);
        var val:  int64 := self.cg_nc0(cur);
        if (kind == 0) { self.ioCheckEnabled       := val; }
        if (kind == 1) { self.overflowCheckEnabled := val; }
        if (kind == 2) { self.boundsCheckEnabled   := val; }  // WP-AS-04
        if (kind == 3) { self.debugMode            := val; }  // WP-AS-05
        if (kind == 4) { self.optLevel             := val; }  // WP-AS-04
      } else if (k == CGN_AT_ENERGY) {  // WP-EN-04: top-level @energy(N)
        self.fnEnergyLevel := self.cg_nival(cur);
      }
      cur := self.cg_nnext(cur);
    }
    // WP-BC-24: emit JMP stubs for all registered generic specializations
    var mi: int64 := 0;
    while (mi < self.monoCount) {
      var mBase: int64 := self.monoList + mi * 32;
      var mangName: pchar := peek64(mBase) as pchar;
      var mangLen:  int64 := peek64(mBase + CG_MONO_OFF_MANGLEN);
      var origName: pchar := peek64(mBase + CG_MONO_OFF_ORIGPTR) as pchar;
      var origLen:  int64 := peek64(mBase + CG_MONO_OFF_ORIGLEN);
      // Emit label for mangled name, then JMP rel32 to the generic function
      self.cg_addLabel(mangName, mangLen, 0);  // generic specialization: no direct line
      self.cg_e8(0xE9);
      self.cg_addPatch(self.codeLen, origName as int64, origLen, CG_PATCH_CALL);
      self.cg_e32(0);
      mi := mi + 1;
    }
  }

  // ------------------------------------------------------------------
  // Init and public API
  // ------------------------------------------------------------------

  fn Init(src: pchar, nodes: int64, toks: int64) {
    self.pSrc   := src;
    self.pNodes := nodes;
    self.pToks  := toks;

    self.codeCap := 65536;
    self.code    := mmap(0, self.codeCap, 3, 34, -1, 0);
    self.codeLen := 0;

    self.dataCap := 16384;
    self.data    := mmap(0, self.dataCap, 3, 34, -1, 0);
    self.dataLen := 80;  // WP-12/CS-09/RAND/BI-01/BI-04: pre-reserve 80 bytes (EXN_VAL@0, EXN_PTR@8, IO_RESULT@16, RAND_STATE@24, ARGC@32, ARGV@40, FLOAT_BUF@48)

    self.localCap  := 64;
    self.locals    := mmap(0, self.localCap * CG_LOCAL_SZ, 3, 34, -1, 0);
    self.localCount := 0;
    self.frameSize  := 0;

    self.labelCap  := 128;
    self.labels    := mmap(0, self.labelCap * CG_LABEL_SZ, 3, 34, -1, 0);
    self.labelCount := 0;

    self.patchCap  := 512;
    self.patches   := mmap(0, self.patchCap * CG_PATCH_SZ, 3, 34, -1, 0);
    self.patchCount := 0;

    self.externDeclCap   := 128;
    self.externDecls     := mmap(0, self.externDeclCap * CG_EXTERN_SZ, 3, 34, -1, 0);
    self.externDeclCount := 0;
    self.externCap   := 64;
    self.externSyms  := mmap(0, self.externCap * CG_EXTERN_SZ, 3, 34, -1, 0);
    self.externCount := 0;

    self.nextLblId := 0;

    // Import dedup (WP-09)
    self.importCap   := 32;
    self.importNames := mmap(0, self.importCap * CG_IMPORT_SZ, 3, 34, -1, 0);
    self.importCount := 0;

    // Class layout table (WP-09 OOP)
    self.classCap    := 16;
    self.classLayouts := mmap(0, self.classCap * CG_CLASS_SZ, 3, 34, -1, 0);
    self.classCount  := 0;

    // BUG-08: Enum layout table for match tag analysis
    self.enumCap     := 16;
    self.enumLayouts := mmap(0, self.enumCap * 32, 3, 34, -1, 0);
    self.enumCount   := 0;

    // Local type tracking (parallel to locals)
    self.localTypes      := mmap(0, self.localCap * 16, 3, 34, -1, 0);
    self.localArraySize  := mmap(0, self.localCap * 8,  3, 34, -1, 0);

    // Method class context
    self.curClassName    := 0 as pchar;
    self.curClassNameLen := 0;

    // WP-13: Closure support - static link defaults (not in a nested function)
    self.staticLinkOffset := -1;
    self.outerFuncName    := 0 as pchar;
    self.outerFuncNameLen := 0;

    // Module-level constant table (use literal 24 for slot size, avoids bootstrap issue)
    self.conCap   := 256;
    self.conTable := mmap(0, self.conCap * CG_CON_SZ, 3, 34, -1, 0);
    self.conCount := 0;

    // Break linked list: no pending breaks initially
    self.curBreakHead := -1;
    self.curContHead := -1;

    // VMT address patch table (WP-10a)
    self.vmtPatchCap   := 32;
    self.vmtPatches    := mmap(0, self.vmtPatchCap * 24, 3, 34, -1, 0);
    self.vmtPatchCount := 0;

    // WP-BC-19: VMT method patch table
    self.vmtMethodPatchCap   := 64;
    self.vmtMethodPatches    := mmap(0, self.vmtMethodPatchCap * CG_VMT_METH_PATCH_SZ, 3, 34, -1, 0);
    self.vmtMethodPatchCount := 0;

    // WP-BC-24: deferred monomorphization list
    self.monoCap   := 32;
    self.monoList  := mmap(0, self.monoCap * CG_MONO_SZ, 3, 34, -1, 0);
    self.monoCount := 0;

    // WP-BC-25: DWARF debug info (off by default)
    self.debugMode   := 0;
    self.srcFilePath := 0 as pchar;
    self.srcFileLen  := 0;

    // WP-BC-48: runtime checks (off by default)
    self.runtimeChecks := 0;

    // WP-CS-07: directive flags — io_check off by default (compiler probes files via open())
    self.ioCheckEnabled       := 0;
    self.overflowCheckEnabled := 0;

    // WP-CS-09/10: panic messages not yet emitted
    self.ioCheckMsgOff   := -1;
    self.overflowMsgOff  := -1;

    // WP-EN-01: energy levels
    self.globalEnergyLevel := 0;
    self.fnEnergyLevel     := 1;  // default: no unrolling (bootstrap-safe)

    // WP-AS-04/05: directive flags
    self.boundsCheckEnabled := 1;  // on by default
    self.debugInfoEnabled   := 0;
    self.optLevel           := 2;

    // WP-AS-10: defer buffer
    self.deferCap   := 64;
    self.deferBuf   := mmap(0, self.deferCap * 8, 3, 34, -1, 0);
    self.deferCount := 0;

    self.includePath := 0;
    self.stdPath     := 0;
    self.licenseKey    := 0;
    self.licenseKeyLen := 0;

    // Per-local array flag (WP-10b)
    self.localIsArray     := mmap(0, self.localCap, 3, 34, -1, 0);
    // WP-3.1: per-local redundant flag
    self.localIsRedundant := mmap(0, self.localCap, 3, 34, -1, 0);

    // BUG-02: Temporary buffer tracking (prevent mmap leaks)
    self.tempBufCap   := 64;
    self.tempBufs     := mmap(0, self.tempBufCap * 16, 3, 34, -1, 0);
    self.tempBufCount := 0;

    // WP-13: Captured variable table for nested functions
    self.capturedCap   := 64;
    self.capturedVars  := mmap(0, self.capturedCap * CG_CAPTVAR_SZ, 3, 34, -1, 0);
    self.capturedCount := 0;

    // Global variable table
    self.globalVarCap   := 64;
    self.globalVars     := mmap(0, self.globalVarCap * 24, 3, 34, -1, 0);
    self.globalIsPchar  := mmap(0, self.globalVarCap, 3, 34, -1, 0);
    self.globalVarCount := 0;

    // WP-BC-40: Profiling entry table (initially empty)
    self.profEntryCap   := 16;
    self.profEntries    := mmap(0, self.profEntryCap * CG_PROF_SZ, 3, 34, -1, 0);
    self.profEntryCount := 0;

    // Emit fixed helper stubs first
    self.cg_emitHelpers();
    // Pre-populate builtin constants (mmap flags, O_* modes, etc.)
    self.cg_addBuiltinCons();
  }

  fn Generate(head: int64) {
    self.cg_genFile(head);
    self.cg_patchAll();
    // BUG-02: Free all temporary mmap buffers after patching is complete
    self.cg_freeAllTempBufs();
  }

  fn WriteELF(path: pchar) {
    // FFI programs need a dynamically-linked ELF (PT_INTERP + .dynamic + GOT
    // relocations against the named shared libraries). Programs with no extern
    // imports keep the byte-identical static path below — preserving the
    // self-host singularity, since lyxc itself uses no FFI.
    if (self.externCount > 0) {
      self.cg_writeELFDynamic(path);
      return;
    }
    var totalCode: int64 := self.codeLen;
    var totalData: int64 := self.dataLen;
    var baseSize:  int64 := CG_CODE_OFF + totalCode + totalData;

    // WP-BC-25: allocate DwarfGen at function scope so it spans both debug blocks
    var dg: DwarfGen := new DwarfGen();
    dg.Init();

    var abbrevSize: int64 := 0;
    var infoSize:   int64 := 0;
    var lineSize:   int64 := 0;
    var strSize:    int64 := 0;
    if (self.debugMode != 0) {
      var li: int64 := 0;
      while (li < self.labelCount) {
        var lbase:    int64 := self.labels + li * CG_LABEL_SZ;
        var lname:    pchar := peek64(lbase) as pchar;
        var lnlen:    int64 := peek64(lbase + CG_LABEL_OFF_NAMELEN);
        var lstart:   int64 := peek64(lbase + CG_LABEL_OFF_CODEOFF);
        var llineNum: int64 := peek64(lbase + CG_LABEL_OFF_LINENUM);
        var lend:     int64 := 0;
        if (li + 1 < self.labelCount) {
          lend := peek64(self.labels + (li + 1) * CG_LABEL_SZ + CG_LABEL_OFF_CODEOFF);
        } else {
          lend := totalCode;
        }
        dg.dw_addFunc(lname, lnlen, lstart, lend, llineNum);
        li := li + 1;
      }
      dg.dw_buildAbbrev();
      dg.dw_buildInfo(self.srcFilePath, self.srcFileLen, totalCode);
      dg.dw_buildLine(self.srcFilePath, self.srcFileLen);
      abbrevSize := dg.abbrevLen;
      infoSize   := dg.infoLen;
      lineSize   := dg.lineLen;
      strSize    := dg.strLen;
    }

    var shstrtabSize: int64 := 60;
    var fileSize: int64 := baseSize;
    if (self.debugMode != 0) {
      fileSize := baseSize + abbrevSize + infoSize + lineSize + strSize + shstrtabSize + 384;
    }

    // WP-LIC-10: watermark layout (only in non-debug static builds with a license key)
    // Layout appended after baseSize:
    //   [+0 ..+15] : 16-byte .lyx_lic payload
    //   [+16..+35] : .shstrtab (20 bytes: \0.lyx_lic\0.shstrtab\0)
    //   [+36..+227]: 3 × 64-byte section headers (NULL, .lyx_lic, .shstrtab)
    var hasWatermark: bool := self.licenseKey != 0 && self.debugMode == 0;
    var licPayload: int64 := mmap(0, 16, 3, 34, -1, 0);  // zeroed by mmap
    if hasWatermark {
      // Read source file to compute SHA256(sourceCode)
      var srcHash: int64 := mmap(0, 32, 3, 34, -1, 0);
      var sfd: int64 := open(self.srcFilePath, 0, 0);
      if sfd >= 0 {
        var srcSz: int64 := lseek(sfd, 0, 2);
        lseek(sfd, 0, 0);
        if srcSz > 0 {
          var srcBuf: int64 := mmap(0, srcSz + 1, 3, 34, -1, 0);
          read(sfd, srcBuf as pchar, srcSz);
          lic_sha256(srcBuf, srcSz, srcHash);
          munmap(srcBuf, srcSz + 1);
        }
        close(sfd);
      }
      // fingerprint = HMAC-SHA256(licenseKey, srcHash) → first 8 bytes
      var hmacOut: int64 := mmap(0, 32, 3, 34, -1, 0);
      lic_hmacSha256(self.licenseKey, self.licenseKeyLen, srcHash, 32, hmacOut);
      var fi: int64 := 0;
      memcpy(licPayload, hmacOut, 8);
      munmap(hmacOut, 32);
      // keyChecksum = SHA256(licenseKey) → first 4 bytes
      var keyHash: int64 := mmap(0, 32, 3, 34, -1, 0);
      lic_sha256(self.licenseKey, self.licenseKeyLen, keyHash);
      var ki: int64 := 0;
      memcpy(licPayload + 8, keyHash, 4);
      munmap(keyHash, 32);
      munmap(srcHash, 32);
      // version byte
      poke8(licPayload + 12, 1);
      // bytes 13-15: already zero (padding)
      fileSize := fileSize + 16 + 20 + 192;  // payload + shstrtab + 3×64 section headers
    }

    // Allocate ELF buffer
    var buf: int64 := mmap(0, fileSize, 3, 34, -1, 0);

    // ELF header (64 bytes)
    poke8(buf, 0x7F);
    poke8(buf + 1,  69);   // 'E'
    poke8(buf + 2,  76);   // 'L'
    poke8(buf + 3,  70);   // 'F'
    poke8(buf + 4,  2);    // ELFCLASS64
    poke8(buf + 5,  1);    // ELFDATA2LSB
    poke8(buf + 6,  1);    // EV_CURRENT
    poke8(buf + 7,  0);    // ELFOSABI_NONE
    // bytes 8-15: padding (mmap zeroed)
    poke16(buf + 16, 2);    // e_type = ET_EXEC
    poke16(buf + 18, 62);   // e_machine = EM_X86_64 (0x3E)
    poke32(buf + 20, 1);    // e_version
    // e_entry = load vaddr + ELF/phdr headers + _start offset (0)
    poke64(buf + 24, CG_ELF_BASE + CG_CODE_OFF);
    poke64(buf + 32, CG_PHDR_OFF);  // e_phoff
    poke64(buf + ELF64_EHDR_OFF_SHOFF, 0);
    poke32(buf + 48, 0);             // e_flags
    poke16(buf + 52, 64);   // e_ehsize
    poke16(buf + 54, 56);   // e_phentsize
    poke16(buf + 56, 1);    // e_phnum
    poke16(buf + 58, 64);   // e_shentsize
    poke16(buf + 60, 0);    // e_shnum
    poke16(buf + 62, 0);    // e_shstrndx
    if (self.debugMode != 0) {
      var shoff: int64 := baseSize + abbrevSize + infoSize + lineSize + strSize + shstrtabSize;
      poke64(buf + ELF64_EHDR_OFF_SHOFF, shoff);
      poke16(buf + 60, 6);      // e_shnum = 6
      poke16(buf + 62, 5);      // e_shstrndx = 5
    }
    if hasWatermark {
      // e_shoff = after code+data+payload+shstrtab
      poke64(buf + ELF64_EHDR_OFF_SHOFF, baseSize + 16 + 20);
      poke16(buf + 60, 3);                    // e_shnum = 3
      poke16(buf + 62, 2);                    // e_shstrndx = 2 (.shstrtab)
    }

    // Program header (56 bytes at offset 64)
    var ph: int64 := buf + CG_PHDR_OFF;
    poke32(ph,      1);              // p_type = PT_LOAD
    poke32(ph + 4,  7);              // p_flags = PF_R|PF_W|PF_X
    poke64(ph + ELF64_PHDR_OFF_OFFSET, 0);
    poke64(ph + 16, CG_ELF_BASE);   // p_vaddr
    poke64(ph + 24, CG_ELF_BASE);   // p_paddr
    if (self.debugMode != 0) {
      poke64(ph + ELF64_PHDR_OFF_FILESZ, baseSize);
      poke64(ph + ELF64_PHDR_OFF_MEMSZ,  baseSize);
    } else if hasWatermark {
      poke64(ph + ELF64_PHDR_OFF_FILESZ, baseSize);
      poke64(ph + ELF64_PHDR_OFF_MEMSZ,  baseSize);
    } else {
      poke64(ph + ELF64_PHDR_OFF_FILESZ, fileSize);
      poke64(ph + ELF64_PHDR_OFF_MEMSZ,  fileSize);
    }
    poke64(ph + ELF64_PHDR_OFF_ALIGN,  2097152);

    // Copy code
    var i: int64 := 0;
    memcpy(buf + CG_CODE_OFF, self.code, totalCode);

    // Copy string data
    i := 0;
    memcpy(buf + CG_CODE_OFF + totalCode, self.data, totalData);

    // WP-BC-25: emit DWARF debug sections and section header table
    if (self.debugMode != 0) {
      var abbrevOff:   int64 := baseSize;
      var infoOff:     int64 := abbrevOff + abbrevSize;
      var lineOff:     int64 := infoOff   + infoSize;
      var strOff:      int64 := lineOff   + lineSize;
      var shstrtabOff: int64 := strOff    + strSize;

      // Copy .debug_abbrev
      i := 0;
      memcpy(buf+abbrevOff, dg.abbrevBuf, abbrevSize);
      // Copy .debug_info
      i := 0;
      memcpy(buf+infoOff, dg.infoBuf, infoSize);
      // Copy .debug_line
      i := 0;
      memcpy(buf+lineOff, dg.lineBuf, lineSize);
      // Copy .debug_str
      i := 0;
      memcpy(buf+strOff, dg.strBuf, strSize);

      // Build .shstrtab (60 bytes)
      // "\0.debug_abbrev\0.debug_info\0.debug_line\0.debug_str\0.shstrtab\0"
      var ss: int64 := buf + shstrtabOff;
      poke8(ss,0);
      poke8(ss+1,46);poke8(ss+2,100);poke8(ss+3,101);poke8(ss+4,98);poke8(ss+5,117);
      poke8(ss+6,103);poke8(ss+7,95);poke8(ss+8,97);poke8(ss+9,98);poke8(ss+10,98);
      poke8(ss+11,114);poke8(ss+12,101);poke8(ss+13,118);poke8(ss+14,0);
      poke8(ss+15,46);poke8(ss+16,100);poke8(ss+17,101);poke8(ss+18,98);poke8(ss+19,117);
      poke8(ss+20,103);poke8(ss+21,95);poke8(ss+22,105);poke8(ss+23,110);poke8(ss+24,102);
      poke8(ss+25,111);poke8(ss+26,0);
      poke8(ss+27,46);poke8(ss+28,100);poke8(ss+29,101);poke8(ss+30,98);poke8(ss+31,117);
      poke8(ss+32,103);poke8(ss+33,95);poke8(ss+34,108);poke8(ss+35,105);poke8(ss+36,110);
      poke8(ss+37,101);poke8(ss+38,0);
      poke8(ss+39,46);poke8(ss+40,100);poke8(ss+41,101);poke8(ss+42,98);poke8(ss+43,117);
      poke8(ss+44,103);poke8(ss+45,95);poke8(ss+46,115);poke8(ss+47,116);poke8(ss+48,114);
      poke8(ss+49,0);
      poke8(ss+50,46);poke8(ss+51,115);poke8(ss+52,104);poke8(ss+53,115);poke8(ss+54,116);
      poke8(ss+55,114);poke8(ss+56,116);poke8(ss+57,97);poke8(ss+58,98);poke8(ss+59,0);

      // Section header table (6 × 64 bytes; [0]=NULL, already zero from mmap)
      var sh0: int64 := buf + shstrtabOff + shstrtabSize;
      var sh: int64 := 0;

      // [1] .debug_abbrev: sh_name=1, SHT_PROGBITS
      sh := sh0 + 64;
      poke32(sh,1);  poke32(sh+4,1);
      poke64(sh+24,abbrevOff); poke64(sh+32,abbrevSize); poke64(sh+48,1);

      // [2] .debug_info: sh_name=15, SHT_PROGBITS
      sh := sh0 + 128;
      poke32(sh,15); poke32(sh+4,1);
      poke64(sh+24,infoOff); poke64(sh+32,infoSize); poke64(sh+48,1);

      // [3] .debug_line: sh_name=27, SHT_PROGBITS
      sh := sh0 + 192;
      poke32(sh,27); poke32(sh+4,1);
      poke64(sh+24,lineOff); poke64(sh+32,lineSize); poke64(sh+48,1);

      // [4] .debug_str: sh_name=39, SHT_PROGBITS, SHF_MERGE|SHF_STRINGS=0x30, entsize=1
      sh := sh0 + 256;
      poke32(sh,39); poke32(sh+4,1);
      poke64(sh+8,48); poke64(sh+24,strOff); poke64(sh+32,strSize);
      poke64(sh+48,1); poke64(sh+56,1);

      // [5] .shstrtab: sh_name=50, SHT_STRTAB=3
      sh := sh0 + 320;
      poke32(sh,50); poke32(sh+4,3);
      poke64(sh+24,shstrtabOff); poke64(sh+32,shstrtabSize); poke64(sh+48,1);
    }

    // WP-LIC-10: embed .lyx_lic section (non-debug static builds only)
    if hasWatermark {
      // Write 16-byte payload at baseSize
      var wi: int64 := 0;
      memcpy(buf + baseSize, licPayload, 16);

      // .shstrtab at baseSize+16 (20 bytes):
      // \0.lyx_lic\0.shstrtab\0
      var ss: int64 := buf + baseSize + 16;
      poke8(ss, 0);
      poke8(ss+1,46);poke8(ss+2,108);poke8(ss+3,121);poke8(ss+4,120);   // .lyx
      poke8(ss+5,95);poke8(ss+6,108);poke8(ss+7,105);poke8(ss+8,99);    // _lic
      poke8(ss+9,0);
      poke8(ss+10,46);poke8(ss+11,115);poke8(ss+12,104);poke8(ss+13,115); // .shs
      poke8(ss+14,116);poke8(ss+15,114);poke8(ss+16,116);poke8(ss+17,97); // trtab
      poke8(ss+18,98);poke8(ss+19,0);

      // Section header table at baseSize+16+20 = baseSize+36
      // [0] NULL — all zeros (already zeroed by mmap)
      var sh0: int64 := buf + baseSize + 36;

      // [1] .lyx_lic: SHT_PROGBITS=1, no flags, offset=baseSize, size=16, align=1
      var sh1: int64 := sh0 + 64;
      poke32(sh1,    1);          // sh_name = 1 (offset in shstrtab)
      poke32(sh1+4,  1);          // sh_type = SHT_PROGBITS
      poke64(sh1+8,  0);          // sh_flags = 0 (not loaded, not executable)
      poke64(sh1+16, 0);          // sh_addr = 0
      poke64(sh1+24, baseSize);   // sh_offset = start of payload in file
      poke64(sh1+32, 16);         // sh_size = 16
      poke64(sh1+48, 1);          // sh_addralign = 1

      // [2] .shstrtab: SHT_STRTAB=3, offset=baseSize+16, size=20, align=1
      var sh2: int64 := sh0 + 128;
      poke32(sh2,    10);          // sh_name = 10
      poke32(sh2+4,  3);           // sh_type = SHT_STRTAB
      poke64(sh2+24, baseSize+16); // sh_offset
      poke64(sh2+32, 20);          // sh_size
      poke64(sh2+48, 1);           // sh_addralign = 1
    }
    munmap(licPayload, 16);

    // Write ELF binary to file (O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0755 = 493)
    var fd: int64 := open(path, 577, 493);
    if (fd >= 0) {
      write(fd, buf as pchar, fileSize);
      close(fd);
    } else {
      PrintStr("codegen: failed to open output file: ");
      PrintStr(path);
      PrintStr("\n");
    }
  }

  // ------------------------------------------------------------------
  // Dynamically-linked ET_EXEC writer (FFI / extern fn ... link "...")
  //
  // Layout — code and data keep their static file offsets/VAs so that every
  // absolute address baked in during codegen (VMT pointers, globals) stays
  // valid; we only relocate the program-header table to the end of the file
  // and append the dynamic-linking sections after .data:
  //
  //   [0,64)    ELF header (e_phoff -> phdrs at end, e_phnum = 3)
  //   [64,..)   .interp = "/lib64/ld-linux-x86-64.so.2"  (fits the 56B gap)
  //   [120,..)  code           (unchanged VA = base + 120)
  //   [..]      data           (unchanged)
  //   [..]      .dynstr .dynsym .hash .rela.dyn .got .dynamic
  //   [..]      program headers: PT_LOAD, PT_INTERP, PT_DYNAMIC
  //
  // Each imported symbol gets a GOT slot resolved eagerly by ld.so via an
  // R_X86_64_GLOB_DAT relocation (DT_FLAGS = DF_BIND_NOW), so no PLT/lazy
  // resolver is needed: call sites are `call *slot(%rip)` (FF 15).
  // ------------------------------------------------------------------
  fn cg_writeELFDynamic(path: pchar) {
    var totalCode: int64 := self.codeLen;
    var totalData: int64 := self.dataLen;
    var nExt: int64 := self.externCount;

    var interpStr: pchar := "/lib64/ld-linux-x86-64.so.2";
    var interpOff: int64 := 64;
    var interpLen: int64 := StrLen(interpStr) + 1;   // include NUL terminator

    var codeOff: int64 := CG_CODE_OFF;               // 120 — unchanged
    var dataOff: int64 := codeOff + totalCode;

    // --- build .dynstr (\0, then distinct lib names, then symbol names) ---
    var dynstr: int64 := mmap(0, 65536, 3, 34, -1, 0);
    var dsLen:  int64 := 0;
    poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;    // index 0 = ""

    var uniqPtr:    int64 := mmap(0, (nExt + 1) * 8, 3, 34, -1, 0);
    var uniqLen:    int64 := mmap(0, (nExt + 1) * 8, 3, 34, -1, 0);
    var uniqStrOff: int64 := mmap(0, (nExt + 1) * 8, 3, 34, -1, 0);
    var uniqCount:  int64 := 0;
    var symStrOff:  int64 := mmap(0, (nExt + 1) * 8, 3, 34, -1, 0);

    var ei: int64 := 0;
    while (ei < nExt) {
      var eb: int64 := self.externSyms + ei * CG_EXTERN_SZ;
      var lp: int64 := peek64(eb + CG_EXTERN_OFF_LIBPTR);
      var ll: int64 := peek64(eb + CG_EXTERN_OFF_LIBLEN);
      var u: int64 := 0;
      var found: int64 := -1;
      while (u < uniqCount) {
        if (peek64(uniqLen + u * 8) == ll &&
            self.cg_seq(peek64(uniqPtr + u * 8) as pchar, ll, lp as pchar, ll)) {
          found := u; u := uniqCount;
        } else {
          u := u + 1;
        }
      }
      if (found < 0) {
        var off: int64 := dsLen;
        var j: int64 := 0;
        memcpy(dynstr + dsLen, lp, ll); dsLen := dsLen + ll;
        poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
        poke64(uniqPtr + uniqCount * 8, lp);
        poke64(uniqLen + uniqCount * 8, ll);
        poke64(uniqStrOff + uniqCount * 8, off);
        uniqCount := uniqCount + 1;
      }
      ei := ei + 1;
    }
    ei := 0;
    while (ei < nExt) {
      var eb2: int64 := self.externSyms + ei * CG_EXTERN_SZ;
      var np: int64 := peek64(eb2);
      var nl: int64 := peek64(eb2 + CG_EXTERN_OFF_NAMELEN);
      var off2: int64 := dsLen;
      var j2: int64 := 0;
      memcpy(dynstr + dsLen, np, nl); dsLen := dsLen + nl;
      poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
      poke64(symStrOff + ei * 8, off2);
      ei := ei + 1;
    }
    var dynstrSize: int64 := dsLen;

    // --- section offsets (8-byte aligned via ((x+7)>>3)<<3) ---
    var dynstrOff: int64 := ((dataOff + totalData + 7) >> 3) << 3;
    var dynsymOff: int64 := ((dynstrOff + dynstrSize + 7) >> 3) << 3;
    var dynsymSize: int64 := (nExt + 1) * 24;
    var hashOff: int64 := dynsymOff + dynsymSize;            // 24*k is 8-aligned
    var nchain: int64 := nExt + 1;
    var hashSize: int64 := (3 + nchain) * 4;                  // nbucket,nchain,bucket[1],chain[]
    var relaOff: int64 := ((hashOff + hashSize + 7) >> 3) << 3;
    var relaSize: int64 := nExt * 24;
    var gotOff: int64 := relaOff + relaSize;                  // 8-aligned
    var gotSize: int64 := nExt * 8;
    var dynOff: int64 := gotOff + gotSize;                    // 8-aligned
    var dynCount: int64 := uniqCount + 11;                    // NEEDED*u + 11 fixed tags
    var dynSize: int64 := dynCount * 16;
    var phdrOff: int64 := ((dynOff + dynSize + 7) >> 3) << 3;
    var phnum: int64 := 3;
    var fileSize: int64 := phdrOff + phnum * 56;

    // --- patch extern call sites: disp32 = gotSlotVA - ripVA ---
    var pi: int64 := 0;
    while (pi < self.patchCount) {
      var pb: int64 := self.patches + pi * CG_PATCH_SZ;
      if (peek64(pb + 24) == CG_PATCH_EXTERN) {
        var cOff:   int64 := peek64(pb);
        var exIdx:  int64 := peek64(pb + CG_PATCH_OFF_NAMEPTR);
        var gotVA:  int64 := CG_ELF_BASE + gotOff + exIdx * 8;
        var ripVA:  int64 := CG_ELF_BASE + codeOff + cOff + 4;
        poke32(self.code + cOff, gotVA - ripVA);
      }
      pi := pi + 1;
    }

    // --- assemble the file image ---
    var buf: int64 := mmap(0, fileSize, 3, 34, -1, 0);

    // ELF header
    poke8(buf, 0x7F); poke8(buf + 1, 69); poke8(buf + 2, 76); poke8(buf + 3, 70);
    poke8(buf + 4, 2); poke8(buf + 5, 1); poke8(buf + 6, 1); poke8(buf + 7, 0);
    poke16(buf + 16, 2);              // e_type = ET_EXEC
    poke16(buf + 18, 62);             // e_machine = EM_X86_64
    poke32(buf + 20, 1);              // e_version
    poke64(buf + 24, CG_ELF_BASE + codeOff);  // e_entry
    poke64(buf + ELF64_EHDR_OFF_PHOFF, phdrOff);
    poke64(buf + ELF64_EHDR_OFF_SHOFF, 0);
    poke32(buf + 48, 0);              // e_flags
    poke16(buf + 52, 64);             // e_ehsize
    poke16(buf + 54, 56);             // e_phentsize
    poke16(buf + 56, phnum);          // e_phnum
    poke16(buf + 58, 64);             // e_shentsize
    poke16(buf + 60, 0);              // e_shnum
    poke16(buf + 62, 0);              // e_shstrndx

    // .interp (in the 56-byte gap between phdr-area and code)
    var ii: int64 := 0;
    memcpy(buf + interpOff, interpStr as int64, interpLen);

    // code (extern disps now patched)
    var ci: int64 := 0;
    memcpy(buf + codeOff, self.code, totalCode);
    // data
    var di: int64 := 0;
    memcpy(buf + dataOff, self.data, totalData);

    // .dynstr
    var si: int64 := 0;
    memcpy(buf + dynstrOff, dynstr, dynstrSize);

    // .dynsym — [0] = null symbol (zeroed); [i+1] = UNDEF GLOBAL FUNC import
    ei := 0;
    while (ei < nExt) {
      var sy: int64 := buf + dynsymOff + (ei + 1) * 24;
      poke32(sy, peek64(symStrOff + ei * 8));  // st_name
      poke8(sy + 4, 0x12);                      // st_info = STB_GLOBAL|STT_FUNC
      poke8(sy + 5, 0);                          // st_other
      poke16(sy + 6, 0);                         // st_shndx = SHN_UNDEF
      ei := ei + 1;
    }

    // .hash — minimal SysV: nbucket=1, nchain, empty bucket/chains
    poke32(buf + hashOff, 1);          // nbucket
    poke32(buf + hashOff + 4, nchain); // nchain (must equal dynsym count)

    // .rela.dyn — one R_X86_64_GLOB_DAT per import into its GOT slot
    ei := 0;
    while (ei < nExt) {
      var ra: int64 := buf + relaOff + ei * 24;
      poke64(ra, CG_ELF_BASE + gotOff + ei * 8);          // r_offset = GOT slot VA
      poke64(ra + ELF64_RELA_OFF_INFO, ((ei + 1) << 32) | 6);               // r_info = (sym<<32)|R_X86_64_GLOB_DAT
      poke64(ra + ELF64_RELA_OFF_ADDEND, 0);                                  // r_addend
      ei := ei + 1;
    }

    // .got — zero slots (filled by ld.so); already zeroed by mmap

    // .dynamic
    var dp: int64 := buf + dynOff;
    var u2: int64 := 0;
    while (u2 < uniqCount) {
      poke64(dp, 1); poke64(dp + ELF64_DYN_OFF_VAL, peek64(uniqStrOff + u2 * 8)); dp := dp + 16;  // DT_NEEDED
      u2 := u2 + 1;
    }
    poke64(dp, 4);  poke64(dp + ELF64_DYN_OFF_VAL, CG_ELF_BASE + hashOff);   dp := dp + 16;  // DT_HASH
    poke64(dp, 5);  poke64(dp + ELF64_DYN_OFF_VAL, CG_ELF_BASE + dynstrOff); dp := dp + 16;  // DT_STRTAB
    poke64(dp, 6);  poke64(dp + ELF64_DYN_OFF_VAL, CG_ELF_BASE + dynsymOff); dp := dp + 16;  // DT_SYMTAB
    poke64(dp, 10); poke64(dp + ELF64_DYN_OFF_VAL, dynstrSize);              dp := dp + 16;  // DT_STRSZ
    poke64(dp, 11); poke64(dp + ELF64_DYN_OFF_VAL, 24);                      dp := dp + 16;  // DT_SYMENT
    poke64(dp, 7);  poke64(dp + ELF64_DYN_OFF_VAL, CG_ELF_BASE + relaOff);   dp := dp + 16;  // DT_RELA
    poke64(dp, 8);  poke64(dp + ELF64_DYN_OFF_VAL, relaSize);                dp := dp + 16;  // DT_RELASZ
    poke64(dp, 9);  poke64(dp + ELF64_DYN_OFF_VAL, 24);                      dp := dp + 16;  // DT_RELAENT
    poke64(dp, 30); poke64(dp + ELF64_DYN_OFF_VAL, 8);                       dp := dp + 16;  // DT_FLAGS = DF_BIND_NOW
    poke64(dp, 0);  poke64(dp + ELF64_DYN_OFF_VAL, 0);                       dp := dp + 16;  // DT_NULL

    // program headers at end of file
    var ph: int64 := buf + phdrOff;
    // PT_LOAD — whole file at base, RWX
    poke32(ph, 1); poke32(ph + 4, 7);
    poke64(ph + 8, 0); poke64(ph + 16, CG_ELF_BASE); poke64(ph + 24, CG_ELF_BASE);
    poke64(ph + ELF64_PHDR_OFF_FILESZ, fileSize); poke64(ph + ELF64_PHDR_OFF_MEMSZ,  fileSize); poke64(ph + ELF64_PHDR_OFF_ALIGN,  4096);
    // PT_INTERP
    var ph2: int64 := ph + 56;
    poke32(ph2, 3); poke32(ph2 + 4, 4);
    poke64(ph2 + 8, interpOff); poke64(ph2 + 16, CG_ELF_BASE + interpOff); poke64(ph2 + 24, CG_ELF_BASE + interpOff);
    poke64(ph2 + ELF64_PHDR_OFF_FILESZ, interpLen); poke64(ph2 + ELF64_PHDR_OFF_MEMSZ,  interpLen); poke64(ph2 + ELF64_PHDR_OFF_ALIGN,  1);
    // PT_DYNAMIC
    var ph3: int64 := ph + 112;
    poke32(ph3, 2); poke32(ph3 + 4, 6);
    poke64(ph3 + 8, dynOff); poke64(ph3 + 16, CG_ELF_BASE + dynOff); poke64(ph3 + 24, CG_ELF_BASE + dynOff);
    poke64(ph3 + ELF64_PHDR_OFF_FILESZ, dynSize); poke64(ph3 + ELF64_PHDR_OFF_MEMSZ,  dynSize); poke64(ph3 + ELF64_PHDR_OFF_ALIGN,  8);

    var fd: int64 := open(path, 577, 493);
    if (fd >= 0) {
      write(fd, buf as pchar, fileSize);
      close(fd);
    } else {
      PrintStr("codegen: failed to open output file: ");
      PrintStr(path);
      PrintStr("\n");
    }
  }

};

// ============================================================================
// Public helper: emit count of nodes in a singly-linked list (via NNext)
// (Mirrors ParserListLen from parser.lyx for convenience)
// ============================================================================

pub fn CodegenListLen(head: int64, nodes: int64): int64 {
  var n: int64 := 0;
  var cur: int64 := head;
  while (cur != -1) {
    n := n + 1;
    cur := peek64(nodes + cur * CG_NODE_SIZE + 40);
  }
  return n;
}
