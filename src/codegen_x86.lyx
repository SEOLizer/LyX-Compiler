  // ------------------------------------------------------------------
  // Import resolution (WP-09)
  // ------------------------------------------------------------------

  // Read a file into an mmap buffer (null-terminated). Returns null on error.
  fn cg_readFile(path: pchar): pchar {
    var fd: int64 := open(path, 0, 0);
    if (fd < 0) { return 0 as pchar; }
    var size: int64 := lseek(fd, 0, 2);
    if (size <= 0) { close(fd); return 0 as pchar; }
    lseek(fd, 0, 0);
    var buf: int64 := alloc(size + 1);
    // WP-27: partieller/fehlgeschlagener Read → Fehler statt Arena-Müll als Quelle.
    var bytesRead: int64 := read(fd, buf as pchar, size);
    if (bytesRead != size) { close(fd); return 0 as pchar; }
    poke8(buf + size, 0);
    close(fd);
    return buf as pchar;
  }

  // Returns 1 if module name was already imported, 0 otherwise.
  fn cg_hasImported(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.importCount) {
      var base: int64 := self.importNames + i * CG_IMPORT_SZ;
      var p: pchar    := peek64(base) as pchar;
      var n: int64    := peek64(base + CG_PATCH_OFF_NAMEPTR);
      if (n == nameLen && self.cg_seq(p, n, name, nameLen)) { return 1; }
      i += 1;
    }
    return 0;
  }

  // Mark a module as imported (add to dedup set).
  fn cg_markImported(name: pchar, nameLen: int64) {
    if (self.importCount >= self.importCap) {
      var nc: int64 := self.importCap * 2;
      var nb: int64 := alloc(nc * 16);
      var i: int64 := 0;
      memcpy(nb, self.importNames, self.importCount * CG_IMPORT_SZ);
      self.importNames := nb;
      self.importCap   := nc;
    }
    var base: int64 := self.importNames + self.importCount * CG_IMPORT_SZ;
    poke64(base,      name as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  nameLen);
    self.importCount += 1;
  }

  // Try to read `relPath` relative to `base` (base + "/" + relPath).
  // Returns null pchar on failure; caller owns the returned buffer.
  fn cg_tryReadWithBase(base: pchar, relPath: pchar): pchar {
    var baseLen: int64 := StrLen(base);
    var relLen:  int64 := StrLen(relPath);
    var tryLen:  int64 := baseLen + 1 + relLen + 1;
    var tryBuf:  int64 := alloc(tryLen);
    memcpy(tryBuf, base as int64, baseLen);
    var i: int64 := baseLen;
    StrSetChar(tryBuf as pchar, i, 47); i := i + 1;
    memcpy(tryBuf + i, relPath as int64, relLen);
    poke8(tryBuf + i + relLen, 0);
    var src: pchar := self.cg_readFile(tryBuf as pchar);
    free(tryBuf, tryLen);
    return src;
  }

  // Process an import: find the .lyx file, parse it, codegen it.
  // Temporarily swaps pSrc/pNodes to the imported file's data.
  fn cg_processImport(modName: pchar, nameLen: int64) {
    if (self.cg_hasImported(modName, nameLen) != 0) { return; }
    self.cg_markImported(modName, nameLen);

    // WP-7a: ".." als Modulkomponente verbieten
    // WP-33: `wptd7 + 1 < nameLen` avoids underflow when nameLen == 0
    var wptd7: int64 := 0;
    while wptd7 + 1 < nameLen {
      if ((StrCharAt(modName, wptd7) & 255) == 46 && (StrCharAt(modName, wptd7 + 1) & 255) == 46) {
        EPrintStr("codegen error: import path traversal verboten: "c);
        EPrintStrLn(modName);
        return;
      }
      wptd7 += 1;
    }

    // Convert "bootstrap.parser" → "bootstrap/parser.lyx"
    var pathBuf: int64 := alloc(nameLen + 8);
    var i: int64 := 0;
    while (i < nameLen) {
      var c: int64 := StrCharAt(modName, i);
      if (c == 46) { c := 47; }  // '.' → '/'
      poke8(pathBuf + i, c);
      i += 1;
    }
    var lyxExtCG: pchar := ".lyx";
    memcpy(pathBuf + nameLen, lyxExtCG as int64, 5);

    var path: pchar := pathBuf as pchar;
    var src: pchar := self.cg_readFile(path);

    // Fall back to includePath (LYX_PATH / -I) then stdPath (LYX_STD_PATH / --std-path)
    if (src == 0 as pchar && self.includePath != 0) {
      src := self.cg_tryReadWithBase(self.includePath as pchar, path);
    }
    if (src == 0 as pchar && self.stdPath != 0) {
      src := self.cg_tryReadWithBase(self.stdPath as pchar, path);
    }

    var srcSize: int64 := 0;
    if (src != 0 as pchar) { srcSize := StrLen(src); }

    if (src == 0 as pchar) {
      PrintStr("codegen: cannot read import: ");
      PrintStr(path);
      PrintStr("\n");
      free(pathBuf, nameLen + 8);
      return;
    }

    // Parse the imported file
    var p: Parser := new Parser();
    p.Init(src, srcSize);
    var head: int64 := p.Parse();

    if (p.hadError != 0) {
      PrintStr("codegen: parse error in import: ");
      PrintStr(path);
      PrintStr("\n");
      free(pathBuf, nameLen + 8);
      free(src, srcSize);
      dispose p;
      return;
    }

    free(pathBuf, nameLen + 8);

    // Switch to imported file's source and nodes for codegen
    var savedSrc:   pchar := self.pSrc;
    var savedNodes: int64 := self.pNodes;
    self.pSrc   := p.src;
    self.pNodes := p.nodes;

    // Recursively generate code for the imported file
    self.cg_genFile(head);
    
    // AP-1: Collect function labels from imported module
    // This makes imported functions visible for patch resolution in main file
    // IMPORTANT: Do this WHILE still switched to import pNodes!
    self.cg_collectImportLabels(head);

    // Restore main file's source and nodes
    self.pSrc   := savedSrc;
    self.pNodes := savedNodes;

    dispose p;
    // NOTE: src (imported source buffer) is intentionally NOT freed here.
    // cg_addLabel/cg_buildStructLayout etc. store raw pointers into src.
    // Freeing src would invalidate those pointers and cause SIGSEGV on lookup.
  }

  // ------------------------------------------------------------------
  // AP-1: Collect labels from imported module
  // Walks the AST and registers all function names as labels for patch resolution
  // ------------------------------------------------------------------
  
  fn cg_collectImportLabels(head: int64): void {
    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_FUNC_DECL) {
        var fname: pchar := self.cg_nsval(cur);
        var fnlen: int64 := self.cg_nslen(cur);
        self.cg_addLabel(fname, fnlen, 0);  // imported: no source line
      }
      cur := self.cg_nnext(cur);
    }
  }

  // WP-BC-24: register a pending generic specialization
  // Entry: {mangledNamePtr:8, mangledNameLen:8, origNamePtr:8, origNameLen:8} = 32 bytes
  fn cg_addMono(mangName: pchar, mangLen: int64, origName: pchar, origLen: int64) {
    if (self.monoCount >= self.monoCap) {
      var nc: int64 := self.monoCap * 2;
      var nb: int64 := alloc(nc * 32);
      var ii: int64 := 0;
      memcpy(nb, self.monoList, self.monoCount * CG_MONO_SZ);
      self.monoList := nb; self.monoCap := nc;
    }
    var base: int64 := self.monoList + self.monoCount * CG_MONO_SZ;
    poke64(base,      mangName as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  mangLen);
    poke64(base + CG_PATCH_OFF_NAMELEN, origName as int64);
    poke64(base + CG_PATCH_OFF_KIND, origLen);
    self.monoCount += 1;
  }

  // WP-BC-24: check if a mangled name is already in the mono list
  fn cg_monoExists(mangName: pchar, mangLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.monoCount) {
      var base: int64 := self.monoList + i * CG_MONO_SZ;
      var n: pchar := peek64(base) as pchar;
      var l: int64 := peek64(base + CG_PATCH_OFF_NAMEPTR);
      if (self.cg_seq(n, l, mangName, mangLen) != 0) { return 1; }
      i += 1;
    }
    return 0;
  }

  // WP-BC-24: build mangled name for generic call, e.g. "Foo_int64"
  fn cg_buildMangledName(baseName: pchar, baseLen: int64, typeArgsNi: int64, outBuf: int64): int64 {
    var pos: int64 := 0;
    var i: int64 := 0;
    while (i < baseLen) { poke8(outBuf + pos, StrCharAt(baseName, i)); pos := pos + 1; i := i + 1; }
    var ta: int64 := typeArgsNi;
    while (ta >= 0) {
      StrSetChar(outBuf as pchar, pos, 95); pos := pos + 1;
      var tname: pchar := self.cg_nsval(ta);
      var tlen:  int64 := self.cg_nslen(ta);
      var j: int64 := 0;
      while (j < tlen) { poke8(outBuf + pos, StrCharAt(tname, j)); pos := pos + 1; j := j + 1; }
      ta := self.cg_nnext(ta);
    }
    poke8(outBuf + pos, 0);
    return pos;
  }

  // ------------------------------------------------------------------
  // Top-level file generation
  // ------------------------------------------------------------------

  fn cg_genFile(head: int64) {
    self.topLevelHead := head;   // A1: früh setzen (für cg_isDeclaredFunc beim Fn-Name-als-Wert)
    // Pre-pass: collect all user-defined functions returning f64 for cg_isF64Expr.
    self.cg_collectF64Funcs(head);
    self.cg_collectMethodAliases(head);   // B2: method-Typ-Aliase registrieren

    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_FUNC_DECL) {
        // extern fn NAME(...) link "lib.so": no body (c2 == -1) and a packed
        // library span in c3 ((len<<32)|off). Register it as an FFI import
        // instead of emitting a function body. The (body==-1 && c3!=-1) test
        // distinguishes externs from @export functions, which share iVal==1
        // but always carry a body.
        var libPacked: int64 := self.cg_nc3(cur);
        if (self.cg_nc2(cur) == -1 && libPacked != -1) {
          var libOff: int64 := libPacked & 0xFFFFFFFF;
          var libLen: int64 := (libPacked >> 32) & 0xFFFFFFFF;
          if (libLen > 0) {
            self.cg_addExternDecl(self.cg_nsval(cur), self.cg_nslen(cur),
                                  (self.pSrc as int64) + libOff, libLen);
          }
        } else {
          self.cg_genFuncDecl(cur);
        }
      } else if (k == CGN_EXTERN_DATA) {
        // WSP-07: externes Daten-Symbol registrieren (Name → UNDEF-Symbol in cg_writeELFObj).
        self.cg_addExternData(self.cg_nsval(cur), self.cg_nslen(cur));
      } else if (k == CGN_IMPORT) {
        // Process the imported module (WP-09: import resolution)
        var modName: pchar := self.cg_nsval(cur);
        var modLen:  int64 := self.cg_nslen(cur);
        self.cg_processImport(modName, modLen);
      } else if (k == CGN_TYPE_DECL) {
        // B2: Typ-Alias (iv-Bit1) — kein Klassen/Struct-Layout. c0 = Alias-Target (kein Feld).
        // method-Aliase sind bereits via cg_collectMethodAliases registriert.
        if ((self.cg_nival(cur) & 2) != 0) {
          // nichts zu bauen — Alias ist reine Typ-Umbenennung
        } else {
        // NK_TYPE_DECL: class if it has methods (nc1 != -1), struct otherwise
        var hasMethods: int64 := self.cg_nc1(cur);
        // WP-BC-L2: a method-less class that `extends` a class WITH a vtable must
        // also be class-layout, so it inherits the vtable pointer + slots.
        var forceClass: int64 := 0;
        var tdParent: int64 := self.cg_nc2(cur);
        if (tdParent >= 0) {
          var tdPi: int64 := self.cg_findClass(self.cg_nsval(tdParent), self.cg_nslen(tdParent));
          if (tdPi >= 0) {
            if (peek64(self.classLayouts + tdPi * CG_CLASS_SZ + CG_CLASS_OFF_VMTSLOTS) > 0) { forceClass := 1; }
          }
        }
        if (hasMethods == -1 && forceClass == 0) {
          // No methods → treat as struct (fields start at offset 0, no VMT)
          self.cg_buildStructLayout(cur);
        } else {
          // Has methods → class layout (fields at offset 8, VMT at 0)
          self.cg_buildClassLayout(cur);
          var clsName: pchar := self.cg_nsval(cur);
          var clsLen:  int64 := self.cg_nslen(cur);
          var method: int64 := hasMethods;
          while (method != -1) {
            var nextM: int64 := self.cg_nnext(method);
            // WP-BC-20: skip abstract methods (bit3 of iVal) — no code body
            var isAbstM: int64 := (self.cg_nival(method) >> 3) & 1;
            if (isAbstM == 0) {
              self.cg_genMethodDecl(method, clsName, clsLen);
            }
            method := nextM;
          }
        }
        }
      } else if (k == CGN_STRUCT_DECL) {
        // Standalone struct declaration: register field layout (fields at offset 0)
        self.cg_buildStructLayout(cur);
      } else if (k == CGN_ENUM_DECL) {
        // BUG-08: Enum declaration: register variant layout for match analysis
        self.cg_buildEnumLayout(cur);
        // Register enum members as int64 constants (auto-increment from 0)
        var emem: int64 := self.cg_nc0(cur);
        var eVal: int64 := 0;
        while (emem != -1) {
          var evNode: int64 := self.cg_nc0(emem);
          if (evNode >= 0 && self.cg_nkind(evNode) == CGN_LIT_INT) {
            eVal := self.cg_nival(evNode);
          }
          self.cg_addCon(self.cg_nsval(emem), self.cg_nslen(emem), eVal);
          eVal += 1;
          emem := self.cg_nnext(emem);
        }
      } else if (k == CGN_VAR_DECL) {
        // Global variable: allocate 8 bytes in data section, register in global table
        var gIdx: int64 := self.globalVarCount;
        var doff: int64 := self.cg_addGlobal(self.cg_nsval(cur), self.cg_nslen(cur));
        var gtNode: int64 := self.cg_nc0(cur);
        if (gtNode >= 0 && self.cg_nkind(gtNode) == 60) {
          var gtp: pchar := self.cg_nsval(gtNode);
          var gtn: int64 := self.cg_nslen(gtNode);
          if (gtn == 5 && self.cg_seq(gtp, gtn, "pchar", 5)) {
            poke8(self.globalIsPchar + gIdx, 1);
          }
          // #1094: Typname merken (siehe cg_staticTypeName).
          poke64(self.globalTypeNames + gIdx * 16,     gtp as int64);
          poke64(self.globalTypeNames + gIdx * 16 + 8, gtn);
        }
        // Write literal initializer directly into data section
        var initNode: int64 := self.cg_nc1(cur);
        if (initNode >= 0 && self.cg_nkind(initNode) == CGN_LIT_INT) {
          poke64(self.data + doff, self.cg_nival(initNode));
        }
      } else if (k == CGN_CON_DECL) {
        // Populate constant table; evaluate arbitrary constant expressions
        var initNode: int64 := self.cg_nc1(cur);
        if (initNode >= 0) {
          if (self.cg_nkind(initNode) == CGN_LIT_STR) {
            // String literal init → pchar constant; store data offset + mark pchar
            var dataOff: int64 := self.cg_addStr(self.cg_nsoff(initNode), self.cg_nslen(initNode));
            self.cg_addConStr(self.cg_nsval(cur), self.cg_nslen(cur), dataOff);
          } else {
            var conVal: int64 := self.cg_evalConExpr(initNode);
            self.cg_addCon(self.cg_nsval(cur), self.cg_nslen(cur), conVal);
          }
        }
      } else if (k == CGN_ENUM_DECL) {
        // WP-10f: register each enum member as an int64 constant
        // auto-increment from 0; explicit value overrides via child0
        var mem: int64 := self.cg_nc0(cur);
        var nextVal: int64 := 0;
        while (mem != -1) {
          var mname: pchar := self.cg_nsval(mem);
          var mlen:  int64 := self.cg_nslen(mem);
          var valNode: int64 := self.cg_nc0(mem);
          if (valNode >= 0 && self.cg_nkind(valNode) == CGN_LIT_INT) {
            nextVal := self.cg_nival(valNode);
          }
          self.cg_addCon(mname, mlen, nextVal);
          nextVal += 1;
          mem := self.cg_nnext(mem);
        }
      } else if (k == CGN_DIM_DECL || k == CGN_UTYPE_DECL) {
        // WP-BC-16: dim/utype are compile-time-only; no code generated
      } else if (k == CGN_BLOCK) {
        // WP-CS-06: inlined @if branch — recurse into children
        self.cg_genFile(self.cg_nc0(cur));
      } else if (k == CGN_AT_DIRECTIVE) {  // WP-CS-07 / WP-AS-04/05 top-level
        var kind: int64 := self.cg_nival(cur);
        var val:  int64 := self.cg_nc0(cur);
        if (kind == 0) { self.ioCheckEnabled       := val; }
        if (kind == 1) { self.overflowCheckEnabled := val; }
        if (kind == 2) { self.boundsCheckEnabled   := val; }  // WP-AS-04
        if (kind == 3) { self.debugMode            := val; }  // WP-AS-05
        if (kind == 4) { self.optLevel             := val; }  // WP-AS-04
      } else if (k == CGN_AT_ENERGY) {  // WP-EN-04: top-level @energy(N)
        self.fnEnergyLevel := self.cg_nival(cur);
      }
      cur := self.cg_nnext(cur);
    }
    // WP-BC-24: emit JMP stubs for all registered generic specializations
    var mi: int64 := 0;
    while (mi < self.monoCount) {
      var mBase: int64 := self.monoList + mi * 32;
      var mangName: pchar := peek64(mBase) as pchar;
      var mangLen:  int64 := peek64(mBase + CG_MONO_OFF_MANGLEN);
      var origName: pchar := peek64(mBase + CG_MONO_OFF_ORIGPTR) as pchar;
      var origLen:  int64 := peek64(mBase + CG_MONO_OFF_ORIGLEN);
      // Emit label for mangled name, then JMP rel32 to the generic function
      self.cg_addLabel(mangName, mangLen, 0);  // generic specialization: no direct line
      self.cg_e8(0xE9);
      self.cg_addPatch(self.codeLen, origName as int64, origLen, CG_PATCH_CALL);
      self.cg_e32(0);
      mi += 1;
    }
  }

  // ------------------------------------------------------------------
  // Init and public API
  // ------------------------------------------------------------------

  fn Init(src: pchar, nodes: int64, toks: int64) {
    self.pSrc   := src;
    self.pNodes := nodes;
    self.pToks  := toks;

    self.codeCap     := 65536;
    self.code        := alloc(self.codeCap);
    self.codeLen     := 0;
    self.codeOverflow := 0;  // WP-34

    self.dataCap     := 16384;
    self.data        := alloc(self.dataCap);
    self.dataLen     := 88;  // WP-18: pre-reserve 88 bytes
    self.dataOverflow := 0;  // WP-34  // WP-18: pre-reserve 88 bytes (EXN_VAL@0, EXN_PTR@8, IO_RESULT@16, RAND_STATE@24, ARGC@32, ARGV@40, FLOAT_BUF@48, CANARY@80)

    self.localCap  := 64;
    self.locals    := alloc(self.localCap * CG_LOCAL_SZ);
    self.localCount := 0;
    self.frameSize  := 0;

    self.labelCap  := 128;
    self.labels    := alloc(self.labelCap * CG_LABEL_SZ);
    self.labelCount := 0;

    self.patchCap  := 512;
    self.patches   := alloc(self.patchCap * CG_PATCH_SZ);
    self.patchCount := 0;

    self.externDeclCap   := 128;
    self.externDecls     := alloc(self.externDeclCap * CG_EXTERN_SZ);
    self.externDeclCount := 0;
    self.externCap   := 64;
    self.externSyms  := alloc(self.externCap * CG_EXTERN_SZ);
    self.externCount := 0;

    // WSP-07: externe Daten-Symbol-Tabelle
    self.externDataCap   := 32;
    self.externData      := alloc(self.externDataCap * 16);
    self.externDataCount := 0;

    self.nextLblId := 0;

    // Import dedup (WP-09)
    self.importCap   := 32;
    self.importNames := alloc(self.importCap * CG_IMPORT_SZ);
    self.importCount := 0;

    // Class layout table (WP-09 OOP)
    self.classCap    := 16;
    self.classLayouts := alloc(self.classCap * CG_CLASS_SZ);
    self.classCount  := 0;

    // BUG-08: Enum layout table for match tag analysis
    self.enumCap     := 16;
    self.enumLayouts := alloc(self.enumCap * 32);
    self.enumCount   := 0;

    // Local type tracking (parallel to locals)
    self.localTypes      := alloc(self.localCap * 16);
    self.localArraySize  := alloc(self.localCap * 8);

    // Method class context
    self.curClassName    := 0 as pchar;
    self.curClassNameLen := 0;

    // WP-13: Closure support - static link defaults (not in a nested function)
    self.staticLinkOffset := -1;
    self.outerFuncName    := 0 as pchar;
    self.outerFuncNameLen := 0;

    // WP-02: Anonymous closure support
    self.anonFnCounter         := 0;
    self.closureEnvPtrOff      := 0;
    self.closureCapturedBuf    := alloc(32 * 8);
    self.closureCapturedLenBuf := alloc(32 * 8);
    self.closureCapturedOutBuf := alloc(32 * 8);
    self.closureCapturedCount  := 0;
    self.localBase             := 0;

    // Module-level constant table (use literal 24 for slot size, avoids bootstrap issue)
    self.conCap     := 256;
    self.conTable   := alloc(self.conCap * CG_CON_SZ);
    self.conCount   := 0;
    self.conIsPchar := alloc(self.conCap);

    // Break linked list: no pending breaks initially
    self.curBreakHead := -1;
    self.curContHead := -1;

    // VMT address patch table (WP-10a)
    self.vmtPatchCap   := 32;
    self.vmtPatches    := alloc(self.vmtPatchCap * 24);
    self.vmtPatchCount := 0;

    // WP-BC-19: VMT method patch table
    self.vmtMethodPatchCap   := 64;
    self.vmtMethodPatches    := alloc(self.vmtMethodPatchCap * CG_VMT_METH_PATCH_SZ);
    self.vmtMethodPatchCount := 0;

    // WP-A2.2: base relocation table
    self.baseRelocCap   := 64;
    self.baseRelocBuf   := alloc(self.baseRelocCap * 8);
    self.baseRelocCount := 0;

    // f64-returning function table (pre-populated with known builtins)
    self.f64FuncCap   := 64;
    self.f64FuncList  := alloc(self.f64FuncCap * 16);
    self.f64FuncCount := 0;
    self.fnRetCap   := 64;
    self.fnRetList  := alloc(self.fnRetCap * 32);
    self.fnRetCount := 0;
    self.methodAliasCap   := 64;
    self.methodAliasList  := alloc(self.methodAliasCap * 16);
    self.methodAliasCount := 0;
    self.fnAliasCap   := 64;
    self.fnAliasList  := alloc(self.fnAliasCap * 16);
    self.fnAliasCount := 0;
    self.cg_registerF64Func("fAdd"c,  4);
    self.cg_registerF64Func("fSub"c,  4);
    self.cg_registerF64Func("fMul"c,  4);
    self.cg_registerF64Func("fDiv"c,  4);
    self.cg_registerF64Func("fNeg"c,  4);
    self.cg_registerF64Func("fAbs"c,  4);
    self.cg_registerF64Func("sqrt"c,  4);

    // WP-BC-24: deferred monomorphization list
    self.monoCap   := 32;
    self.monoList  := alloc(self.monoCap * CG_MONO_SZ);
    self.monoCount := 0;

    // WP-BC-25: DWARF debug info (off by default)
    self.debugMode   := 0;
    self.srcFilePath := 0 as pchar;
    self.srcFileLen  := 0;

    // WP-BC-48: runtime checks (off by default)
    self.runtimeChecks := 0;

    // WP-CS-07: directive flags — io_check off by default (compiler probes files via open())
    self.ioCheckEnabled       := 0;
    self.overflowCheckEnabled := 0;

    // WP-CS-09/10: panic messages not yet emitted
    self.ioCheckMsgOff   := -1;
    self.overflowMsgOff  := -1;

    // WP-EN-01: energy levels
    self.globalEnergyLevel := 0;
    self.fnEnergyLevel     := 1;  // default: no unrolling (bootstrap-safe)

    // WP-AS-04/05: directive flags
    self.boundsCheckEnabled := 1;  // on by default
    self.debugInfoEnabled   := 0;
    self.optLevel           := 2;

    // WP-AS-10: defer buffer
    self.dfCap      := 256;
    self.dfNodes    := alloc(self.dfCap * 8);
    self.dfSlots    := alloc(self.dfCap * 8);
    self.dfCount    := 0;
    self.dfReplay   := 0;
    self.deferCap   := 64;
    self.deferBuf   := alloc(self.deferCap * 8);
    self.nestedCap   := 64;
    self.nestedBuf   := alloc(self.nestedCap * 8);
    self.nestedCount := 0;
    self.deferCount := 0;
    self.loopDeferMark := -1;   // #1006

    self.includePath := 0;
    self.stdPath     := 0;
    self.licenseKey    := 0;
    self.licenseKeyLen := 0;

    // Per-local array flag (WP-10b)
    self.localIsArray     := alloc(self.localCap);
    // WP-3.1: per-local redundant flag
    self.localIsRedundant := alloc(self.localCap);
    // WP-GPU-01: per-local SIMD flag
    self.localIsSimd      := alloc(self.localCap);
    self.localIsFnPtr     := alloc(self.localCap);

    // BUG-02: Temporary buffer tracking (prevent mmap leaks)
    self.tempBufCap   := 64;
    self.tempBufs     := alloc(self.tempBufCap * 16);
    self.tempBufCount := 0;

    // WP-13: Captured variable table for nested functions
    self.capturedCap   := 64;
    self.capturedVars  := alloc(self.capturedCap * CG_CAPTVAR_SZ);
    self.capturedCount := 0;

    // Global variable table
    self.globalVarCap   := 64;
    self.globalVars     := alloc(self.globalVarCap * 24);
    self.globalIsPchar  := alloc(self.globalVarCap);
    self.globalTypeNames := alloc(self.globalVarCap * 16);
    self.globalVarCount := 0;
    self.stnLen         := 0;

    // WP-BC-40: Profiling entry table (initially empty)
    self.profEntryCap   := 16;
    self.profEntries    := alloc(self.profEntryCap * CG_PROF_SZ);
    self.profEntryCount := 0;

    // WP-R9: seccomp init
    self.lcbsCapBuf     := alloc(64 * 8);
    self.lcbsCapCount   := 0;
    self.lcbsBpfDataOff := 0 - 1;  // -1 = no BPF generated yet
    self.lcbsBpfCount   := 0;
    self.lcbsEnabled    := 0;

    // WP-R10: Landlock init
    self.lcbsLandlockHandled    := 0;
    self.lcbsLandlockAllowed    := 0;
    self.lcbsLandlockHasDev     := 0;
    self.lcbsLandlockDevAllowed := 0;

    // WP-R11: Proxy init
    self.lcbsProxyEnabled    := 0;
    self.lcbsProxyBpfDataOff := 0 - 1;
    self.lcbsProxyBpfCount   := 0;
    self.lcbsProxyCodeOff    := 0 - 1;
    self.lcbsProxyFdDataOff  := 0 - 1;

    // WP-H12: Hardware-Argumente + Gerätepfad-Offsets
    self.lcbsHwArgBuf     := alloc(32 * 24);  // 32 Einträge × 3 × 8 Bytes
    self.lcbsHwArgCount   := 0;
    self.lcbsHwDevPathOff := alloc(32 * 8);

    // WP-T13: Audit-Felder
    self.lcbsMissingGrants := 0;
    self.lcbsFastpathCount := 0;
    self.lcbsAuditSrcPath  := 0 as pchar;

    // WP-T14: Compat-Modus (kein seccomp/landlock)
    self.lcbsCompatMode    := 0;
    self.lcbsCompatWarnOff := 0 - 1;
    self.lcbsCompatWarnLen := 0;
    self.lcbsWxActive      := 0;

    // Emit fixed helper stubs first
    self.cg_emitHelpers();
    // Pre-populate builtin constants (mmap flags, O_* modes, etc.)
    self.cg_addBuiltinCons();
  }

  // WP-R9: Capability-IDs aus AST sammeln (scannt alle @capabilities-Annotationen)
  // Setzt lcbsEnabled=1 sobald irgendeine @capabilities-Annotation gefunden wird.
  fn cg_collectCaps(astHead: int64): void {
    var ni: int64 := astHead;
    while ni >= 0 {
      if self.cg_nkind(ni) == 110 {  // SNK_CAPABILITY_ATTR = 110
        self.lcbsEnabled := 1;
        var capDecl: int64 := self.cg_nc0(ni);
        while capDecl >= 0 {
          if self.cg_nkind(capDecl) == 111 {  // SNK_CAPABILITY_DECL = 111
            var path: pchar := self.cg_nsval(capDecl);
            var plen: int64 := self.cg_nslen(capDecl);
            var cid: int64 := seccomp_cap_id_from_path(path, plen);
            if cid >= 0 && self.lcbsCapCount < 64 {
              // Deduplizieren
              var already: int64 := 0;
              var ci: int64 := 0;
              while ci < self.lcbsCapCount {
                if peek64(self.lcbsCapBuf + ci * 8) == cid { already := 1; ci := self.lcbsCapCount; }
                ci += 1;
              }
              if already == 0 {
                poke64(self.lcbsCapBuf + self.lcbsCapCount * 8, cid);
                self.lcbsCapCount += 1;
              }
            }
            // WP-H12: Hardware-Cap-Argumente separat sammeln (21=GPIO, 22=I2C, 23=SPI, 24=USB)
            if (cid == 21 || cid == 22 || cid == 23 || cid == 24) && self.lcbsHwArgCount < 32 {
              var hwArg0: int64 := 0;
              var hwArg1: int64 := 0;
              var argNode: int64 := self.cg_nc0(capDecl);
              while argNode >= 0 {
                var keyPtr: pchar := self.cg_nsval(argNode);
                var keyLen: int64 := self.cg_nslen(argNode);
                var valNode: int64 := self.cg_nc0(argNode);
                if valNode >= 0 && self.cg_nkind(valNode) == 40 {  // NK_LIT_INT = 40
                  var argVal: int64 := self.cg_nival(valNode);
                  // "pin" [p=112,i=105,n=110] oder "bus" [b=98,u=117,s=115] → arg0
                  if keyLen == 3 && (StrCharAt(keyPtr, 0) & 255) == 112 &&
                     (StrCharAt(keyPtr, 1) & 255) == 105 && (StrCharAt(keyPtr, 2) & 255) == 110 {
                    hwArg0 := argVal;  // pin
                  }
                  if keyLen == 3 && (StrCharAt(keyPtr, 0) & 255) == 98 &&
                     (StrCharAt(keyPtr, 1) & 255) == 117 && (StrCharAt(keyPtr, 2) & 255) == 115 {
                    hwArg0 := argVal;  // bus
                  }
                  // "cs" [c=99,s=115] → arg1
                  if keyLen == 2 && (StrCharAt(keyPtr, 0) & 255) == 99 &&
                     (StrCharAt(keyPtr, 1) & 255) == 115 {
                    hwArg1 := argVal;
                  }
                }
                argNode := self.cg_nnext(argNode);
              }
              // Deduplizieren nach (capId, arg0, arg1) — gerätepfadspezifisch
              var hwAlready: int64 := 0;
              var hwi2: int64 := 0;
              while hwi2 < self.lcbsHwArgCount {
                var hbase: int64 := self.lcbsHwArgBuf + hwi2 * 24;
                if peek64(hbase) == cid && peek64(hbase + 8) == hwArg0 && peek64(hbase + 16) == hwArg1 {
                  hwAlready := 1; hwi2 := self.lcbsHwArgCount;
                }
                hwi2 += 1;
              }
              if hwAlready == 0 {
                var hbase: int64 := self.lcbsHwArgBuf + self.lcbsHwArgCount * 24;
                poke64(hbase,      cid);
                poke64(hbase + 8,  hwArg0);
                poke64(hbase + 16, hwArg1);
                self.lcbsHwArgCount += 1;
              }
            }
          }
          // WP-T13: @fastpath zählen (NK_CAPABILITY_DECL.iVal bit0 = CAP_FLAG_FASTPATH)
          if self.cg_nkind(capDecl) == 111 {
            if (self.cg_nival(capDecl) & 1) != 0 { self.lcbsFastpathCount := self.lcbsFastpathCount + 1; }
          }
          capDecl := self.cg_nnext(capDecl);
        }
      }
      // WP-T13: SNK_IMPORT (=1) ohne grant-Klausel (c1 != NK_GRANT_CLAUSE=114) zählen
      if self.cg_nkind(ni) == 1 {
        var grantNi: int64 := self.cg_nc1(ni);
        var hasGrant: int64 := 0;
        if grantNi >= 0 && self.cg_nkind(grantNi) == 114 { hasGrant := 1; }
        if hasGrant == 0 { self.lcbsMissingGrants := self.lcbsMissingGrants + 1; }
      }
      ni := self.cg_nnext(ni);
    }
  }

  // WP-25.2: Warnung-String in Datensektion schreiben (nur wenn Compat-Modus aktiv)
  fn cg_genCompatWarnSection(): void {
    if self.lcbsCompatMode == 0 { return; }
    var msg: pchar := "WARNUNG: Compat-Modus aktiv -- kein seccomp, kein landlock, kein Proxy!\n"c;
    var msglen: int64 := StrLen(msg);
    self.lcbsCompatWarnOff := self.dataLen;
    self.lcbsCompatWarnLen := msglen;
    var i: int64 := 0;
    while i < msglen {
      self.cg_edata(StrCharAt(msg, i) & 255);
      i += 1;
    }
  }

  // WP-25.2: write(2, warn_str, warn_len) am Anfang von main emittieren
  fn cg_emitCompatWarn(): void {
    if self.lcbsCompatMode == 0 { return; }
    if self.lcbsCompatWarnOff < 0 { return; }
    // mov edi, 2  (stderr)
    self.cg_e8(0xBF); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // lea rsi, [rip + disp32]  → Warnung-String
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, self.lcbsCompatWarnOff, 0, CG_PATCH_STR);
    // mov edx, warn_len
    var wl: int64 := self.lcbsCompatWarnLen;
    self.cg_e8(0xBA);
    self.cg_e8(wl & 255); self.cg_e8((wl >> 8) & 255); self.cg_e8((wl >> 16) & 255); self.cg_e8((wl >> 24) & 255);
    // mov eax, 1  (SYS_write)
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall
    self.cg_e8(0x0F); self.cg_e8(0x05);
  }

  // WP-R9: BPF-Programm in Datensektion schreiben; setzt lcbsBpfDataOff + lcbsBpfCount
  // Nur aufgerufen wenn lcbsEnabled == 1.
  fn cg_genBpfSection(): void {
    if self.lcbsEnabled == 0 { return; }
    if self.lcbsCompatMode != 0 { return; }  // WP-T14: Compat-Modus überspringt seccomp
    var bpfBuf: int64 := alloc(256 * 8);
    var bpfCount: int64 := seccomp_build_filter(self.lcbsCapBuf, self.lcbsCapCount, bpfBuf);
    self.lcbsBpfDataOff := self.dataLen;
    self.lcbsBpfCount   := bpfCount;
    var i: int64 := 0;
    while i < bpfCount * 8 {
      self.cg_edata(peek8(bpfBuf + i));
      i += 1;
    }
    free(bpfBuf, 256 * 8);
  }

  // WP-R11: Setzt lcbsProxyEnabled wenn Netzwerk-Proxy-Caps vorhanden.
  fn cg_computeProxy(): void {
    if self.lcbsEnabled == 0 { return; }
    if proxy_is_needed(self.lcbsCapBuf, self.lcbsCapCount) {
      self.lcbsProxyEnabled := 1;
    }
  }

  // WP-R11: Generiert Proxy-BPF in Datensektion + reserviert proxy_fd-Slot.
  fn cg_genProxyBpfSection(): void {
    if self.lcbsProxyEnabled == 0 { return; }
    if self.lcbsCompatMode != 0 { return; }  // WP-T14
    var bpfBuf: int64 := alloc(128 * 8);
    var bpfCount: int64 := proxy_build_filter(bpfBuf);
    self.lcbsProxyBpfDataOff := self.dataLen;
    self.lcbsProxyBpfCount   := bpfCount;
    var i: int64 := 0;
    while i < bpfCount * 8 {
      self.cg_edata(peek8(bpfBuf + i));
      i += 1;
    }
    free(bpfBuf, 128 * 8);
    // 4 Bytes für proxy_fd-Speicher (int32, initial 0)
    self.lcbsProxyFdDataOff := self.dataLen;
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);
  }

  // WP-R11: Emittiert den Proxy-Kindprozess-Loop BEVOR main() kompiliert wird.
  // Eintritt: rdi = child_fd (AF_UNIX socketpair-Deskriptor des Kindes).
  // Der Loop:
  //   1. Installiert eigenen restriktiven seccomp-Filter (nur Netzwerk).
  //   2. Liest 8-Byte-Anfragen vom child_fd.
  //   3. Antwortet mit -ENOSYS (noch nicht implementiert bis WP-L1 Pfad-Args parsed).
  //   4. Bei EOF (Elter beendet): exit_group(0).
  fn cg_emitProxyLoop(): void {
    if self.lcbsProxyEnabled == 0 { return; }
    if self.lcbsCompatMode != 0 { return; }  // WP-T14
    self.lcbsProxyCodeOff := self.codeLen;

    // Callee-saved Register retten: r13 (child_fd), r14 (alignment), rbx
    self.cg_e8(0x41); self.cg_e8(0x55);  // push r13
    self.cg_e8(0x41); self.cg_e8(0x56);  // push r14
    self.cg_e8(0x53);                    // push rbx
    // mov r13, rdi  (child_fd sichern, Encoding: 4C 8B EF)
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0xEF);

    // ---- Proxy-seccomp installieren ----
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x10);  // sub rsp, 16
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);                     // xor rax, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);  // mov [rsp+0], rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);
    // mov ax, proxy_bpf_count (uint16)
    var pcnt: int64 := self.lcbsProxyBpfCount & 0xFFFF;
    self.cg_e8(0x66); self.cg_e8(0xB8); self.cg_e8(pcnt & 0xFF); self.cg_e8((pcnt >> 8) & 0xFF);
    self.cg_e8(0x66); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);  // mov [rsp+0], ax
    // lea rax, [rip + proxy_bpf_data]
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
    var ppPBpf: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(ppPBpf, self.lcbsProxyBpfDataOff, 0, CG_PATCH_STR);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);
    // prctl(PR_SET_NO_NEW_PRIVS=38, 1, 0, 0, 0)
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC0);  // xor r8d, r8d
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);  // xor r10d, r10d
    self.cg_e8(0x31); self.cg_e8(0xD2);                     // xor edx, edx
    self.cg_e8(0xBE); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xBF); self.cg_e8(0x26); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xB8); self.cg_e8(0x9D); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // prctl(PR_SET_SECCOMP=22, SECCOMP_MODE_FILTER=2, rsp)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE2);  // mov rdx, rsp
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9d, r9d
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);  // xor r10d, r10d
    self.cg_e8(0xBE); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xBF); self.cg_e8(0x16); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xB8); self.cg_e8(0x9D); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);  // add rsp, 16

    // Anfrage-Puffer (8 Bytes) auf Stack
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x08);  // sub rsp, 8
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);                     // xor rax, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);  // mov [rsp+0], rax

    // ---- Read-Loop ----
    var loopPos: int64 := self.codeLen;
    // read(r13d, rsp, 8)
    self.cg_e8(0xB8); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x44); self.cg_e8(0x89); self.cg_e8(0xEF);  // mov edi, r13d
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE6);  // mov rsi, rsp
    self.cg_e8(0xBA); self.cg_e8(0x08); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
    // jle .exit (rel8, wird unten gepatcht)
    self.cg_e8(0x7E); var jlePos: int64 := self.codeLen; self.cg_e8(0x00);

    // Antwort: -38 (ENOSYS — Proxy-Protokoll noch nicht implementiert bis WP-L1)
    self.cg_e8(0xC7); self.cg_e8(0x04); self.cg_e8(0x24);
    self.cg_e8(0xDA); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);  // [rsp] = -38
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x44); self.cg_e8(0x89); self.cg_e8(0xEF);  // mov edi, r13d
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE6);  // mov rsi, rsp
    self.cg_e8(0xBA); self.cg_e8(0x04); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // jmp .read_loop (backward, rel8)
    self.cg_e8(0xEB);
    self.cg_e8((loopPos - (self.codeLen + 1)) & 0xFF);

    // .exit — patch jle
    poke8(self.code + jlePos, (self.codeLen - jlePos - 1) & 255);
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x08);  // add rsp, 8
    self.cg_e8(0x5B);                    // pop rbx
    self.cg_e8(0x41); self.cg_e8(0x5E);  // pop r14
    self.cg_e8(0x41); self.cg_e8(0x5D);  // pop r13
    self.cg_e8(0x31); self.cg_e8(0xFF);  // xor edi, edi
    self.cg_e8(0xB8); self.cg_e8(0xE7); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);  // exit_group(0)
  }

  // WP-R11: Emittiert fork+socketpair am Anfang von main().
  // Reihenfolge: ProxyStart → LandlockInit → SeccompInit.
  // Nach dem fork():
  //   Kind: rdi=child_fd → jmp proxy_loop → exit_group(0)
  //   Elter: speichert proxy_fd (sv[1]) in Datensektion
  fn cg_emitProxyStart(): void {
    if self.lcbsProxyEnabled == 0 { return; }
    if self.lcbsCompatMode != 0 { return; }  // WP-T14

    // Stack: sv[2] (2×int = 8 Bytes, aufgefüllt auf 16)
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x10);  // sub rsp, 16
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);                     // xor rax, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);  // mov [rsp+0], rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);

    // socketpair(AF_UNIX=1, SOCK_STREAM=1, 0, &sv)
    self.cg_e8(0xB8); self.cg_e8(0x35); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xBF); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xBE); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x31); self.cg_e8(0xD2);  // xor edx, edx
    self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xE2);  // mov r10, rsp (&sv)
    self.cg_e8(0x0F); self.cg_e8(0x05);
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    self.cg_e8(0x0F); self.cg_e8(0x88);
    var jSkip1: int64 := self.codeLen; self.cg_e32(0);  // js → SKIP_ALL

    // fork() → rax = 0 (Kind) oder pid (Elter)
    self.cg_e8(0xB8); self.cg_e8(0x39); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    self.cg_e8(0x0F); self.cg_e8(0x88);
    var jSkip2: int64 := self.codeLen; self.cg_e32(0);  // js → SKIP_ALL
    // jnz → PARENT (rax != 0: Elter-Prozess)
    self.cg_e8(0x0F); self.cg_e8(0x85);
    var jParent: int64 := self.codeLen; self.cg_e32(0);

    // === KIND: Proxy-Loop starten ===
    // close(sv[1]) = [rsp+4]
    self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x04);
    self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // rdi = sv[0] (child_fd)
    self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24);  // mov edi, [rsp+0]
    // Stack wiederherstellen
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);  // add rsp, 16
    // jmp proxy_loop (Rückwärts-Sprung zu lcbsProxyCodeOff)
    self.cg_e8(0xE9);
    self.cg_e32(self.lcbsProxyCodeOff - (self.codeLen + 4));

    // === ELTER: proxy_fd speichern ===
    poke32(self.code + jParent, self.codeLen - jParent - 4);
    // close(sv[0]) = [rsp+0]
    self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24);
    self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // proxy_fd = sv[1] in Datensektion speichern
    self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x04);  // mov eax, [rsp+4]
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x0D);
    var ppFd: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(ppFd, self.lcbsProxyFdDataOff, 0, CG_PATCH_STR);
    self.cg_e8(0x89); self.cg_e8(0x01);  // mov [rcx], eax

    // SKIP_ALL → add rsp, 16
    poke32(self.code + jSkip1, self.codeLen - jSkip1 - 4);
    poke32(self.code + jSkip2, self.codeLen - jSkip2 - 4);
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);  // add rsp, 16
  }

  // WP-R10: Berechnet Landlock-Bitmasks nach cg_collectCaps().
  fn cg_computeLandlock(): void {
    if self.lcbsEnabled == 0 { return; }
    self.lcbsLandlockHandled    := landlock_compute_handled(self.lcbsCapBuf, self.lcbsCapCount);
    self.lcbsLandlockAllowed    := landlock_compute_allowed(self.lcbsCapBuf, self.lcbsCapCount);
    self.lcbsLandlockHasDev     := 0;
    self.lcbsLandlockDevAllowed := 0;
    if landlock_has_hw(self.lcbsCapBuf, self.lcbsCapCount) {
      self.lcbsLandlockHasDev     := 1;
      self.lcbsLandlockDevAllowed := landlock_compute_dev_allowed(self.lcbsCapBuf, self.lcbsCapCount);
    }
  }

  // WP-H12: Berechnet Gerätepfade für Hardware-Caps und schreibt sie in die Datensektion.
  // Muss VOR cg_genFile() aufgerufen werden; cg_emitLandlockInit() verwendet die Offsets.
  fn cg_genHwDevPathSection(): void {
    if self.lcbsHwArgCount == 0 { return; }
    if self.lcbsCompatMode != 0 { return; }  // WP-T14
    var pathBuf: int64 := alloc(32);
    var hwi: int64 := 0;
    while hwi < self.lcbsHwArgCount {
      var hbase: int64 := self.lcbsHwArgBuf + hwi * 24;
      var capId: int64 := peek64(hbase);
      var arg0:  int64 := peek64(hbase + 8);
      var arg1:  int64 := peek64(hbase + 16);
      var plen:  int64 := hw_path_for(capId, arg0, arg1, pathBuf);
      poke64(self.lcbsHwDevPathOff + hwi * 8, self.dataLen);
      // Pfad + NUL-Terminator in Datensektion schreiben
      var j: int64 := 0;
      while j <= plen {
        self.cg_edata(peek8(pathBuf + j));
        j += 1;
      }
      hwi += 1;
    }
    free(pathBuf, 32);
  }

  // WP-R10: Emittiert Landlock-Setup-Code am Anfang von main().
  // Reihenfolge: Landlock ZUERST, dann seccomp (Landlock-Syscalls müssen vor seccomp laufen).
  // Stack-Layout (48 Bytes):
  //   [rsp+0]  = landlock_ruleset_attr.handled_access_fs (u64)
  //   [rsp+8]  = path_beneath_attr.allowed_access (u64)
  //   [rsp+16] = path_beneath_attr.parent_fd (s32) + 4 Bytes Padding
  //   [rsp+24] = String-Puffer: '/', '\0', ... (8 Bytes)
  //   [rsp+32] = ruleset_fd (s64)
  //   [rsp+40] = dir_fd (s64)
  // WP-H12: Hardware-Caps erzeugen per-Gerät-Regeln (statt breiter /dev-Regel).
  fn cg_emitLandlockInit(): void {
    if self.lcbsEnabled == 0 { return; }
    if self.lcbsCompatMode != 0 { return; }  // WP-T14

    // sub rsp, 48  (Stack-Frame)
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x30);
    // Zero stack frame: xor rax,rax; dann 6× mov [rsp+N], rax
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);                                      // xor rax, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);                     // [rsp+0]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);  // [rsp+8]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x10);  // [rsp+16]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x18);  // [rsp+24]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x20);  // [rsp+32]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x28);  // [rsp+40]

    // Version-Probe: landlock_create_ruleset(NULL, 0, LANDLOCK_CREATE_RULESET_VERSION=1)
    self.cg_e8(0x31); self.cg_e8(0xFF);                                              // xor edi, edi
    self.cg_e8(0x31); self.cg_e8(0xF6);                                              // xor esi, esi
    self.cg_e8(0xBA); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov edx, 1
    self.cg_e8(0xB8); self.cg_e8(0xBC); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 444
    self.cg_e8(0x0F); self.cg_e8(0x05);                                              // syscall
    // test rax,rax; js rel32 → SKIP_ALL (Kernel < 5.13, kein Landlock)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    self.cg_e8(0x0F); self.cg_e8(0x88);
    var jSkip1: int64 := self.codeLen; self.cg_e32(0);  // Placeholder jump 1

    // handled_access_fs → [rsp+0]
    var hfs: int64 := self.lcbsLandlockHandled;
    self.cg_e8(0xB8);
    self.cg_e8(hfs & 0xFF); self.cg_e8((hfs >> 8) & 0xFF);
    self.cg_e8((hfs >> 16) & 0xFF); self.cg_e8((hfs >> 24) & 0xFF);            // mov eax, hfs
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);    // mov [rsp+0], rax

    // landlock_create_ruleset([rsp], 8, 0) → ruleset_fd
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE7);                       // mov rdi, rsp
    self.cg_e8(0xBE); self.cg_e8(0x08); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov esi, 8
    self.cg_e8(0x31); self.cg_e8(0xD2);                                          // xor edx, edx
    self.cg_e8(0xB8); self.cg_e8(0xBC); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 444
    self.cg_e8(0x0F); self.cg_e8(0x05);                                          // syscall
    // test rax,rax; js rel32 → SKIP_ALL (create_ruleset fehlgeschlagen)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    self.cg_e8(0x0F); self.cg_e8(0x88);
    var jSkip2: int64 := self.codeLen; self.cg_e32(0);  // Placeholder jump 2
    // mov [rsp+32], rax (ruleset_fd speichern)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x20);

    // '/' in [rsp+24] setzen (Rest durch Zeroing bereits 0 → terminiert)
    self.cg_e8(0xC6); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x18); self.cg_e8(0x2F);

    // openat(AT_FDCWD=-100, &[rsp+24], O_PATH=0x200000, 0)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7);
    self.cg_e8(0x9C); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);     // mov rdi, -100
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x18); // lea rsi, [rsp+24]
    self.cg_e8(0xBA); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x20); self.cg_e8(0x00); // mov edx, O_PATH
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);                       // xor r10d, r10d
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 257
    self.cg_e8(0x0F); self.cg_e8(0x05);                                          // syscall
    // test rax,rax; js rel32 → RESTRICT_LABEL (openat "/" fehlgeschlagen)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    self.cg_e8(0x0F); self.cg_e8(0x88);
    var jRestrict3: int64 := self.codeLen; self.cg_e32(0);  // Placeholder jump 3
    // mov [rsp+40], rax (dir_fd = root_fd)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x28);

    // Regel für "/" nur hinzufügen wenn allowed_access != 0
    if self.lcbsLandlockAllowed != 0 {
      var afs: int64 := self.lcbsLandlockAllowed;
      self.cg_e8(0xB8);
      self.cg_e8(afs & 0xFF); self.cg_e8((afs >> 8) & 0xFF);
      self.cg_e8((afs >> 16) & 0xFF); self.cg_e8((afs >> 24) & 0xFF);          // mov eax, allowed_access
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08); // mov [rsp+8], rax
      self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x28);  // mov eax, [rsp+40]
      self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x10);  // mov [rsp+16], eax (parent_fd)
      // landlock_add_rule(ruleset_fd, RULE_PATH_BENEATH=1, &path_beneath, 0)
      self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x20);  // mov edi, [rsp+32]
      self.cg_e8(0xBE); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov esi, 1
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x08); // lea rdx, [rsp+8]
      self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);                    // xor r10d, r10d
      self.cg_e8(0xB8); self.cg_e8(0xBD); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 445
      self.cg_e8(0x0F); self.cg_e8(0x05);                                        // syscall (Fehler ignorieren)
    }

    // close dir_fd (root)
    self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x28);   // mov edi, [rsp+40]
    self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 3
    self.cg_e8(0x0F); self.cg_e8(0x05);                                          // syscall

    // WP-H12: Per-device Landlock-Regeln — eine Regel pro Gerätepfad
    // (spezifischer als WP-R10's breite /dev-Regel)
    var ppDev:    int64 := 0;
    var jDevSkip: int64 := 0;
    var da:       int64 := 0;
    var hwi:      int64 := 0;
    while hwi < self.lcbsHwArgCount {
      // hw_dev_allowed: Gerätedateien (GPIO/I2C/SPI) ohne READ_DIR; USB-Verzeichnis mit READ_DIR
      da := hw_dev_allowed(peek64(self.lcbsHwArgBuf + hwi * 24));
      // openat(AT_FDCWD=-100, devPath, O_PATH=0x200000, 0)
      self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7);
      self.cg_e8(0x9C); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);     // mov rdi, -100
      // lea rsi, [rip+devPath]
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
      ppDev := self.codeLen; self.cg_e32(0);
      self.cg_addPatch(ppDev, peek64(self.lcbsHwDevPathOff + hwi * 8), 0, CG_PATCH_STR);
      self.cg_e8(0xBA); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x20); self.cg_e8(0x00); // mov edx, O_PATH
      self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);                       // xor r10d, r10d
      self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 257
      self.cg_e8(0x0F); self.cg_e8(0x05);                                           // syscall
      // test rax,rax; js rel32 → dev_skip (Gerät nicht vorhanden → graceful überspringen)
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
      self.cg_e8(0x0F); self.cg_e8(0x88);
      jDevSkip := self.codeLen; self.cg_e32(0);
      // mov [rsp+40], rax (dev_fd)
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x28);
      // mov eax, da (allowed_access); mov [rsp+8], rax
      self.cg_e8(0xB8);
      self.cg_e8(da & 0xFF); self.cg_e8((da >> 8) & 0xFF);
      self.cg_e8((da >> 16) & 0xFF); self.cg_e8((da >> 24) & 0xFF);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);
      // mov eax, [rsp+40]; mov [rsp+16], eax (parent_fd = dev_fd)
      self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x28);
      self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x10);
      // landlock_add_rule(ruleset_fd, RULE_PATH_BENEATH=1, &path_beneath, 0)
      self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x20);     // mov edi, [rsp+32]
      self.cg_e8(0xBE); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov esi, 1
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x08); // lea rdx, [rsp+8]
      self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);                       // xor r10d, r10d
      self.cg_e8(0xB8); self.cg_e8(0xBD); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 445
      self.cg_e8(0x0F); self.cg_e8(0x05);                                           // syscall
      // close dev_fd
      self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x28);     // mov edi, [rsp+40]
      self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 3
      self.cg_e8(0x0F); self.cg_e8(0x05);                                           // syscall
      // patch jDevSkip → hier
      poke32(self.code + jDevSkip, self.codeLen - jDevSkip - 4);
      hwi += 1;
    }

    // RESTRICT_LABEL: patch jRestrict3 → hier
    poke32(self.code + jRestrict3, self.codeLen - jRestrict3 - 4);
    // prctl(PR_SET_NO_NEW_PRIVS=38, 1, 0, 0, 0)
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC0);   // xor r8d, r8d
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);   // xor r10d, r10d
    self.cg_e8(0x31); self.cg_e8(0xD2);                      // xor edx, edx
    self.cg_e8(0xBE); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov esi, 1
    self.cg_e8(0xBF); self.cg_e8(0x26); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov edi, 38
    self.cg_e8(0xB8); self.cg_e8(0x9D); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 157
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // landlock_restrict_self(ruleset_fd, 0)
    self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x20); // mov edi, [rsp+32]
    self.cg_e8(0x31); self.cg_e8(0xF6);                                       // xor esi, esi
    self.cg_e8(0xB8); self.cg_e8(0xBE); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 446
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // close ruleset_fd
    self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x20); // mov edi, [rsp+32]
    self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 3
    self.cg_e8(0x0F); self.cg_e8(0x05);

    // SKIP_ALL: patch jSkip1 und jSkip2 → add rsp, 48
    poke32(self.code + jSkip1, self.codeLen - jSkip1 - 4);
    poke32(self.code + jSkip2, self.codeLen - jSkip2 - 4);
    // add rsp, 48
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x30);
  }

  // WP-R9: Emittiert seccomp-Installation in den Anfang einer Funktion.
  // Wird von cg_genFuncDecl aufgerufen wenn lcbsEnabled && name=="main".
  // Läuft NACH dem Funktions-Prolog (push rbp etc.) aber VOR dem Body.
  fn cg_emitSeccompInit(): void {
    if self.lcbsBpfDataOff < 0 { return; }
    if self.lcbsCompatMode != 0 { return; }  // WP-T14
    // Construct sock_fprog on stack (sub rsp already done by cg_genFuncDecl prolog).
    // We use 16 extra bytes below current rsp; sub rsp,16 first.
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x10);  // sub rsp, 16
    // xor rax, rax; mov [rsp+2..15], 0 (clear padding)
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x02);
    // mov ax, bpfCount (uint16 at [rsp+0])
    var cnt16: int64 := self.lcbsBpfCount & 0xFFFF;
    self.cg_e8(0x66); self.cg_e8(0xB8);
    self.cg_e8(cnt16 & 0xFF); self.cg_e8((cnt16 >> 8) & 0xFF);
    self.cg_e8(0x66); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);  // mov [rsp+0], ax
    // lea rax, [rip+bpfData]
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
    var ppBpf: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(ppBpf, self.lcbsBpfDataOff, 0, CG_PATCH_STR);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);  // mov [rsp+8], rax
    // prctl(PR_SET_NO_NEW_PRIVS=38, 1, 0, 0, 0)
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC0);  // xor r8d, r8d
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);  // xor r10d, r10d
    self.cg_e8(0x31); self.cg_e8(0xD2);                     // xor edx, edx
    self.cg_e8(0xBE); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xBF); self.cg_e8(0x26); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xB8); self.cg_e8(0x9D); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // prctl(PR_SET_SECCOMP=22, SECCOMP_MODE_FILTER=2, rsp)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE2);  // mov rdx, rsp
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9d, r9d
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);  // xor r10d, r10d
    self.cg_e8(0xBE); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xBF); self.cg_e8(0x16); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0xB8); self.cg_e8(0x9D); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);  // add rsp, 16
  }

  // WP-T13: Gibt den Security-Audit-Report auf stderr aus.
  // Wird am Ende von Generate() aufgerufen (alle LCBS-Daten bekannt).
  fn cg_runAudit(): void {
    var seccompOk:    int64 := 0;
    var landlockOk:   int64 := 0;
    var landlockRules: int64 := 0;
    var bpfRules:     int64 := 0;
    if self.lcbsCompatMode == 0 {  // WP-T14: Compat-Modus → alles inaktiv
      if self.lcbsBpfDataOff >= 0 { seccompOk := 1; bpfRules := self.lcbsBpfCount; }
      if self.lcbsEnabled != 0 && self.lcbsLandlockHandled != 0 { landlockOk := 1; }
      if self.lcbsLandlockAllowed != 0 { landlockRules := landlockRules + 1; }
      landlockRules += self.lcbsHwArgCount;
    }
    var relroOk: int64 := 0;
    if self.externCount == 0 { relroOk := 1; }
    var score: int64 := audit_compute_score(seccompOk, landlockOk, self.lcbsMissingGrants, self.lcbsFastpathCount, self.lcbsWxActive, relroOk);

    // --- Ausgabe ---
    EPrintStrLn("=== LCBS Security Audit =========================================="c);
    if self.lcbsCompatMode != 0 {
      EPrintStrLn("!!! WARNUNG: Compat-Modus (--capabilities=compat) aktiv         !!!"c);
      EPrintStrLn("!!! seccomp, landlock, Proxy deaktiviert -- kein Laufzeitschutz !!!"c);
      EPrintStrLn(""c);
    }
    EPrintStr("Programm:          "c);
    if self.lcbsAuditSrcPath != 0 as pchar {
      EPrintStrLn(self.lcbsAuditSrcPath);
    } else {
      EPrintStrLn("(unbekannt)"c);
    }
    if self.lcbsEnabled != 0 {
      EPrintStrLn("Capability-Modell: Zero-Privilege (default deny), Grant-basiert"c);
    } else {
      EPrintStrLn("Capability-Modell: NONE (kein @capabilities -- keine LCBS-Haertung)"c);
    }
    EPrintStrLn(""c);

    // Implizite Capabilities
    EPrintStrLn("Implizite Capabilities (immer aktiv):"c);
    EPrintStrLn("  o system.exit         -> exit_group"c);
    EPrintStrLn("  o system.memory.heap  -> brk, mmap(MAP_ANON)"c);
    EPrintStrLn("  o system.rand         -> getrandom (Stack-Canary-Init, WP-24.1)"c);
    EPrintStrLn(""c);

    // Explizite Capabilities
    if self.lcbsEnabled != 0 && self.lcbsCapCount > 0 {
      EPrintStrLn("Explizite Capabilities:"c);
      var ci: int64 := 0;
      while ci < self.lcbsCapCount {
        var cid: int64 := peek64(self.lcbsCapBuf + ci * 8);
        EPrintStr("  + "c);
        EPrintStrLn(audit_cap_name(cid));
        ci += 1;
      }
      EPrintStrLn(""c);
    } else {
      EPrintStrLn("Explizite Capabilities: keine"c);
      EPrintStrLn(""c);
    }

    // Runtime-Schutz
    EPrintStrLn("Runtime-Schutz:"c);
    if self.lcbsWxActive != 0 {
      EPrintStrLn("  + W^X (RX-Code / RW-Daten getrennt — zwei PT_LOAD)"c);
    } else {
      EPrintStrLn("  o W^X (nicht aktiv — Single PT_LOAD RWX)"c);
    }
    if self.externCount == 0 {
      EPrintStrLn("  + RELRO (kein GOT/PLT-Angriffsziel — statisches ELF)"c);
    } else {
      EPrintStrLn("  o RELRO (kein PT_GNU_RELRO — dynamisches ELF, WP-6b offen)"c);
    }
    EPrintStrLn("  o PIE  (nicht aktiv -- statisches ELF, kein ASLR)"c);
    if seccompOk != 0 {
      EPrintStr("  + seccomp (SECCOMP_RET_KILL_PROCESS, "c);
      EPrintInt(bpfRules);
      EPrintStrLn(" Regeln)"c);
    } else {
      EPrintStrLn("  o seccomp (nicht aktiv)"c);
    }
    if landlockOk != 0 {
      EPrintStr("  + landlock ("c);
      EPrintInt(landlockRules);
      EPrintStrLn(" Pfad-Regeln)"c);
    } else {
      EPrintStrLn("  o landlock (nicht aktiv)"c);
    }
    if self.lcbsProxyEnabled != 0 {
      EPrintStrLn("  + Userspace Proxy (Netzwerk)"c);
    } else {
      EPrintStrLn("  o Userspace Proxy (nicht aktiv)"c);
    }
    EPrintStrLn("  + Stack Canaries (WP-18: fs:getrandom, TMR-Slot rbp-8)"c);
    EPrintStrLn(""c);

    // Score — WP-18 adds +5 for stack canaries
    score += 5;
    EPrintStr("Sicherheits-Score: "c);
    EPrintInt(score);
    EPrintStrLn("/45  (PIE +0)"c);
    EPrintStrLn("  +10: Kein Klasse-3-Extern ohne system.unsafe.format_string"c);
    if self.lcbsWxActive != 0 {
      EPrintStrLn("  + 5: W^X aktiv (zwei PT_LOAD: RX + RW)"c);
    } else {
      EPrintStrLn("  + 0: W^X fehlt (Single PT_LOAD RWX — WP-6 offen)"c);
    }
    if self.externCount == 0 {
      EPrintStrLn("  + 5: RELRO (kein GOT/PLT-Angriffsziel — statisch)"c);
    } else {
      EPrintStrLn("  + 0: RELRO fehlt (kein PT_GNU_RELRO — dynamisch)"c);
    }
    EPrintStrLn("  + 0: PIE  (nicht implementiert)"c);
    if self.lcbsMissingGrants == 0 {
      EPrintStrLn("  +10: Grant-Modell -- alle Imports haben explizites grant"c);
    } else {
      var gs: int64 := 10 - self.lcbsMissingGrants * 2;
      if gs < 0 { gs := 0; }
      EPrintStr("  +"c); EPrintInt(gs);
      EPrintStr(": Grant-Modell -- "c); EPrintInt(self.lcbsMissingGrants);
      EPrintStrLn(" Import(e) ohne grant (-2 pro fehlendem grant)"c);
    }
    if seccompOk != 0 {
      EPrintStrLn("  + 5: seccomp aktiv"c);
    } else {
      EPrintStrLn("  + 0: seccomp fehlt"c);
    }
    if landlockOk != 0 {
      EPrintStrLn("  + 5: landlock aktiv"c);
    } else {
      EPrintStrLn("  + 0: landlock fehlt"c);
    }
    EPrintStrLn("  + 5: Stack Canaries (WP-18: getrandom-Init + fs-freier rbp-8-Slot)"c);
    if self.lcbsFastpathCount > 0 {
      EPrintStr("  -"c); EPrintInt(self.lcbsFastpathCount * 3);
      EPrintStr(": @fastpath x"c); EPrintInt(self.lcbsFastpathCount); EPrintStrLn(""c);
    }
    if self.lcbsCompatMode != 0 {
      EPrintStrLn("  WARNUNG: Compat-Modus -- kein Laufzeitschutz"c);
    }
    EPrintStrLn("=================================================================="c);
  }

  fn Generate(head: int64) {
    self.topLevelHead := head;  // WP-MEM-05: save for default-param lookup
    // WP-R9/R10/R11: collect capabilities, compute masks, generate BPF + proxy data sections
    // cg_emitProxyStart/LandlockInit/SeccompInit() are called later from cg_genFuncDecl
    self.cg_collectCaps(head);
    self.cg_computeProxy();        // WP-R11: Proxy-Bedarf bestimmen
    self.cg_computeLandlock();     // WP-R10: Landlock-Bitmasks
    self.cg_genCompatWarnSection(); // WP-25.2: Compat-Warnung in Datensektion
    self.cg_genProxyBpfSection();  // WP-R11: Proxy-BPF + proxy_fd-Slot in Datensektion
    self.cg_genBpfSection();       // WP-R9: Haupt-BPF in Datensektion
    self.cg_genHwDevPathSection(); // WP-H12: Gerätepfad-Strings in Datensektion
    self.cg_emitProxyLoop();       // WP-R11: Proxy-Kind-Loop-Code in Codesektion (vor main)
    self.cg_genFile(head);
    // WP-6: Pad code to 4096-byte boundary so data starts on a page boundary.
    // This allows two PT_LOAD segments: RX (code) and RW (data), no overlap.
    // Padding must happen BEFORE cg_patchAll() so all disp32 patches use
    // the aligned codeLen as the code/data boundary offset.
    // Formula must account for CG_CODE_OFF (176 bytes of ELF headers before code).
    var codePad: int64 := (4096 - ((CG_CODE_OFF + self.codeLen) & 4095)) & 4095;
    var pi: int64 := 0;
    while pi < codePad {
      self.cg_e8(0x00);  // zero-padding in dead code region
      pi += 1;
    }
    self.cg_patchAll();
    // BUG-02: Free all temporary mmap buffers after patching is complete
    self.cg_freeAllTempBufs();
    // WP-6/6b: both static and dynamic ELFs emit two PT_LOADs (RX+RW)
    self.lcbsWxActive := 1;
    self.cg_runAudit();            // WP-T13: Security Audit auf stderr
  }

  // LyxOS-Reloc Step 1: statischer ET_EXEC wie WriteELF, ABER phdr-Tabelle am Datei-Ende
  // (e_phoff→Ende, e_phnum=3) + 3. phdr PT_LYXRELOC + Reloc-Table. Code bleibt @CG_CODE_OFF
  // (176) → Producer-RVAs + win64-Vertrag unberührt. WriteELF ist contiguous → rva == file-
  // /vaddr-Offset, keine Übersetzung. Reloc-Table-Format: [count:u64][rva:u64 …] (rva relativ
  // zu CG_ELF_BASE). Kernel: *(load_base + rva) += (load_va − CG_ELF_BASE). Linux ignoriert
  // PT_LYXRELOC (PT_LOOS-Bereich) → läuft unverändert (delta=0 bei Basis CG_ELF_BASE).
  fn cg_writeELFReloc(path: pchar) {
    var totalCode: int64 := self.codeLen;
    var totalData: int64 := self.dataLen;
    var relCount:  int64 := self.baseRelocCount;
    var relBuf:    int64 := self.baseRelocBuf;

    var rwOff:    int64 := CG_CODE_OFF + totalCode;          // data-Start (== vaddr-Offset)
    var relocOff: int64 := rwOff + totalData;               // Reloc-Table nach Data
    var relocSize: int64 := 8 + relCount * 8;               // [count][rva…]
    var phdrOff:  int64 := ((relocOff + relocSize + 7) / 8) * 8;  // 8-aligned phdr-Tabelle
    var fileSize: int64 := phdrOff + 3 * 56;

    var buf: int64 := alloc(fileSize);
    var z: int64 := 0;
    while (z < fileSize) { poke8(buf + z, 0); z := z + 1; }

    // ELF-Header
    poke8(buf, 0x7F); poke8(buf + 1, 69); poke8(buf + 2, 76); poke8(buf + 3, 70);
    poke8(buf + 4, 2); poke8(buf + 5, 1); poke8(buf + 6, 1); poke8(buf + 7, 0);
    poke16(buf + 16, 2);     // ET_EXEC
    poke16(buf + 18, 62);    // EM_X86_64
    poke32(buf + 20, 1);     // e_version
    poke64(buf + 24, CG_ELF_BASE + CG_CODE_OFF);  // e_entry (0x4000b0)
    poke64(buf + 32, phdrOff);                     // e_phoff → Datei-Ende
    poke64(buf + ELF64_EHDR_OFF_SHOFF, 0);
    poke32(buf + 48, 0);
    poke16(buf + 52, 64);    // e_ehsize
    poke16(buf + 54, 56);    // e_phentsize
    poke16(buf + 56, 3);     // e_phnum = 3 (LOAD-RX, LOAD-RW, PT_LYXRELOC)
    poke16(buf + 58, 0); poke16(buf + 60, 0); poke16(buf + 62, 0);

    // Code @ CG_CODE_OFF, Data direkt danach (contiguous)
    memcpy(buf + CG_CODE_OFF, self.code, totalCode);
    memcpy(buf + rwOff, self.data, totalData);

    // Reloc-Table @ relocOff
    poke64(buf + relocOff, relCount);
    var ri: int64 := 0;
    while (ri < relCount) {
      poke64(buf + relocOff + 8 + ri * 8, peek64(relBuf + ri * 8));
      ri += 1;
    }

    // phdr-Tabelle @ phdrOff
    var rxSize: int64 := CG_CODE_OFF + totalCode;
    var ph: int64 := buf + phdrOff;
    // PT_LOAD #1 RX: ELF-Header + Code
    poke32(ph, 1); poke32(ph + 4, 5);
    poke64(ph + ELF64_PHDR_OFF_OFFSET, 0);
    poke64(ph + 16, CG_ELF_BASE); poke64(ph + 24, CG_ELF_BASE);
    poke64(ph + ELF64_PHDR_OFF_FILESZ, rxSize);
    poke64(ph + ELF64_PHDR_OFF_MEMSZ,  rxSize);
    poke64(ph + ELF64_PHDR_OFF_ALIGN,  4096);
    // PT_LOAD #2 RW: Data + Reloc-Table (Kernel lädt Reloc-Table mit)
    var ph2: int64 := buf + phdrOff + 56;
    var rwSpan: int64 := totalData + relocSize;
    poke32(ph2, 1); poke32(ph2 + 4, 6);
    poke64(ph2 + ELF64_PHDR_OFF_OFFSET, rwOff);
    poke64(ph2 + 16, CG_ELF_BASE + rwOff); poke64(ph2 + 24, CG_ELF_BASE + rwOff);
    poke64(ph2 + ELF64_PHDR_OFF_FILESZ, rwSpan);
    poke64(ph2 + ELF64_PHDR_OFF_MEMSZ,  rwSpan);
    poke64(ph2 + ELF64_PHDR_OFF_ALIGN,  4096);
    // PT_LYXRELOC: Reloc-Table-Deskriptor (p_type 0x6FFFAA00)
    var ph3: int64 := buf + phdrOff + 112;
    poke32(ph3, 0x6FFFAA00); poke32(ph3 + 4, 4);   // p_flags = PF_R
    poke64(ph3 + ELF64_PHDR_OFF_OFFSET, relocOff);
    poke64(ph3 + 16, CG_ELF_BASE + relocOff); poke64(ph3 + 24, CG_ELF_BASE + relocOff);
    poke64(ph3 + ELF64_PHDR_OFF_FILESZ, relocSize);
    poke64(ph3 + ELF64_PHDR_OFF_MEMSZ,  relocSize);
    poke64(ph3 + ELF64_PHDR_OFF_ALIGN,  8);

    var fd: int64 := open(path, 577, 493);
    if (fd >= 0) { write(fd, buf as pchar, fileSize); close(fd); }
    else { PrintStr("codegen: failed to open output file: "); PrintStr(path); PrintStr("\n"); }
  }

  // WSP-07: nlen Bytes von ptr nach buf+off kopieren + Null-Terminator. Gibt off+nlen+1.
  fn cg_objPutName(buf: int64, off: int64, ptr: int64, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < nlen) { poke8(buf + off + i, peek8(ptr + i)); i := i + 1; }
    poke8(buf + off + nlen, 0);
    return off + nlen + 1;
  }

  // WSP-07: relocatable ELF-Objekt (ET_REL) für `extern "asm"`. Eine Section .ltext =
  // code||data (interne Refs sind RIP-relativ → reloc-invariant bei einem Block). baseRelocs
  // (VMT/Klassen-Zeiger) → R_X86_64_64 gegen .ltext-Section-Symbol; extern-"asm"-Nutzungen →
  // R_X86_64_PC32 gegen UNDEF-Symbol. Auflösung via `ld -T script.ld obj.o stub.o`.
  fn cg_writeELFObj(path: pchar) {
    var codeSz: int64 := self.codeLen;
    var dataSz: int64 := self.dataLen;
    var ltextSize: int64 := codeSz + dataSz;

    // EXTERN_DATA-Patches zählen (jede Nutzung = eine Reloc).
    var edPatch: int64 := 0;
    var pc: int64 := 0;
    while (pc < self.patchCount) {
      if (peek64(self.patches + pc * CG_PATCH_SZ + CG_PATCH_OFF_KIND) == CG_PATCH_EXTERN_DATA) {
        edPatch += 1;
      }
      pc += 1;
    }

    var symCount:  int64 := 3 + self.externDataCount;   // null, .ltext-Section, _start, externs
    var relaCount: int64 := self.baseRelocCount + edPatch;

    // .strtab-Größe: null + "_start\0" + je extern-Name+null
    var strtabSize: int64 := 1 + 7;
    var es: int64 := 0;
    while (es < self.externDataCount) {
      strtabSize := strtabSize + peek64(self.externData + es * 16 + 8) + 1;
      es += 1;
    }
    var shstrtabSize: int64 := 45;   // "\0.ltext\0.symtab\0.strtab\0.rela.text\0.shstrtab\0"

    // Datei-Layout
    var ltextOff:   int64 := 64;
    var symtabOff:  int64 := ((ltextOff + ltextSize + 7) / 8) * 8;
    var symtabSize: int64 := symCount * 24;
    var strtabOff:  int64 := symtabOff + symtabSize;
    var relaOff:    int64 := ((strtabOff + strtabSize + 7) / 8) * 8;
    var relaSize:   int64 := relaCount * 24;
    var shstrOff:   int64 := relaOff + relaSize;
    var shTableOff: int64 := ((shstrOff + shstrtabSize + 7) / 8) * 8;
    var fileSize:   int64 := shTableOff + 6 * 64;

    var buf: int64 := alloc(fileSize);
    var z: int64 := 0;
    while (z < fileSize) { poke8(buf + z, 0); z := z + 1; }

    // ELF64-Header (ET_REL)
    poke8(buf, 0x7F); poke8(buf + 1, 69); poke8(buf + 2, 76); poke8(buf + 3, 70);
    poke8(buf + 4, 2); poke8(buf + 5, 1); poke8(buf + 6, 1); poke8(buf + 7, 0);
    poke16(buf + 16, 1);     // ET_REL
    poke16(buf + 18, 62);    // EM_X86_64
    poke32(buf + 20, 1);     // e_version
    poke64(buf + 24, 0);     // e_entry
    poke64(buf + 32, 0);     // e_phoff
    poke64(buf + ELF64_EHDR_OFF_SHOFF, shTableOff);
    poke32(buf + 48, 0);
    poke16(buf + 52, 64);    // e_ehsize
    poke16(buf + 54, 56);    // e_phentsize
    poke16(buf + 56, 0);     // e_phnum
    poke16(buf + 58, 64);    // e_shentsize
    poke16(buf + 60, 6);     // e_shnum
    poke16(buf + 62, 5);     // e_shstrndx → .shstrtab

    // .ltext = code || data
    memcpy(buf + ltextOff, self.code, codeSz);
    memcpy(buf + ltextOff + codeSz, self.data, dataSz);

    // .strtab (Namen + Offsets sammeln)
    poke8(buf + strtabOff, 0);
    var startNameOff: int64 := 1;
    var wo: int64 := self.cg_objPutName(buf, strtabOff + 1, "_start"c as int64, 6);
    var edNameOff: int64 := alloc((self.externDataCount + 1) * 8);
    var em: int64 := 0;
    while (em < self.externDataCount) {
      poke64(edNameOff + em * 8, wo - strtabOff);
      wo := self.cg_objPutName(buf, wo, peek64(self.externData + em * 16),
                               peek64(self.externData + em * 16 + 8));
      em += 1;
    }

    // .symtab
    // sym 0 = null (schon 0). sym 1 = .ltext-Section-Symbol (LOCAL, STT_SECTION)
    var s1: int64 := buf + symtabOff + 24;
    poke16(s1 + 6, 1);                 // st_shndx = .ltext
    poke8(s1 + 4, 3);                  // st_info = STB_LOCAL<<4 | STT_SECTION
    // sym 2 = _start (GLOBAL, STT_FUNC) @ .ltext:0
    var s2: int64 := buf + symtabOff + 48;
    poke32(s2, startNameOff);
    poke8(s2 + 4, (1 << 4) | 2);       // STB_GLOBAL<<4 | STT_FUNC
    poke16(s2 + 6, 1);                 // .ltext
    // sym 3.. = extern-data UNDEF (GLOBAL, STT_NOTYPE)
    var ek: int64 := 0;
    while (ek < self.externDataCount) {
      var sk: int64 := buf + symtabOff + (3 + ek) * 24;
      poke32(sk, peek64(edNameOff + ek * 8));
      poke8(sk + 4, (1 << 4) | 0);     // STB_GLOBAL<<4 | STT_NOTYPE
      poke16(sk + 6, 0);               // SHN_UNDEF
      ek += 1;
    }

    // .rela.text
    var ro: int64 := relaOff;
    var bi: int64 := 0;
    while (bi < self.baseRelocCount) {
      var rva: int64 := peek64(self.baseRelocBuf + bi * 8);
      var loc: int64 := rva - CG_CODE_OFF;                          // Offset in .ltext
      var storedVal: int64 := peek64(buf + ltextOff + loc);
      poke64(ro + buf, loc);                                        // r_offset
      poke64(buf + ro + 8, (1 << 32) | 1);                          // r_info: sym=1(.ltext), R_X86_64_64
      poke64(buf + ro + 16, storedVal - CG_ELF_BASE - CG_CODE_OFF); // r_addend = Ziel-Offset in .ltext
      ro += 24;
      bi += 1;
    }
    var pj: int64 := 0;
    while (pj < self.patchCount) {
      var pb: int64 := self.patches + pj * CG_PATCH_SZ;
      if (peek64(pb + CG_PATCH_OFF_KIND) == CG_PATCH_EXTERN_DATA) {
        var coff: int64 := peek64(pb);
        var edi: int64 := self.cg_findExternDataIdx(peek64(pb + CG_PATCH_OFF_NAMEPTR) as pchar,
                                                    peek64(pb + CG_PATCH_OFF_NAMELEN));
        var symIdx: int64 := 3 + edi;
        poke64(buf + ro, coff);                                     // r_offset (code@0 in .ltext)
        poke64(buf + ro + 8, (symIdx << 32) | 2);                   // R_X86_64_PC32 gegen UNDEF-Sym
        poke64(buf + ro + 16, 0 - 4);                               // r_addend = -4
        ro += 24;
      }
      pj += 1;
    }

    // .shstrtab
    poke8(buf + shstrOff, 0);
    self.cg_objPutName(buf, shstrOff + 1,  ".ltext"c as int64, 6);
    self.cg_objPutName(buf, shstrOff + 8,  ".symtab"c as int64, 7);
    self.cg_objPutName(buf, shstrOff + 16, ".strtab"c as int64, 7);
    self.cg_objPutName(buf, shstrOff + 24, ".rela.text"c as int64, 10);
    self.cg_objPutName(buf, shstrOff + 35, ".shstrtab"c as int64, 9);

    // Section-Header-Tabelle (6 × 64)
    // sh 0 = NULL (schon 0)
    var sh1: int64 := buf + shTableOff + 64;    // .ltext
    poke32(sh1, 1); poke32(sh1 + 4, 1);                // SHT_PROGBITS
    poke64(sh1 + 8, 7);                                // ALLOC|WRITE|EXECINSTR
    poke64(sh1 + 24, ltextOff); poke64(sh1 + 32, ltextSize);
    poke64(sh1 + 48, 16);
    var sh2: int64 := buf + shTableOff + 128;   // .symtab
    poke32(sh2, 8); poke32(sh2 + 4, 2);                // SHT_SYMTAB
    poke64(sh2 + 24, symtabOff); poke64(sh2 + 32, symtabSize);
    poke32(sh2 + 40, 3); poke32(sh2 + 44, 2);          // link=.strtab, info=first-global(2)
    poke64(sh2 + 48, 8); poke64(sh2 + 56, 24);
    var sh3: int64 := buf + shTableOff + 192;   // .strtab
    poke32(sh3, 16); poke32(sh3 + 4, 3);               // SHT_STRTAB
    poke64(sh3 + 24, strtabOff); poke64(sh3 + 32, strtabSize);
    poke64(sh3 + 48, 1);
    var sh4: int64 := buf + shTableOff + 256;   // .rela.text
    poke32(sh4, 24); poke32(sh4 + 4, 4);               // SHT_RELA
    poke64(sh4 + 8, 0x40);                             // SHF_INFO_LINK
    poke64(sh4 + 24, relaOff); poke64(sh4 + 32, relaSize);
    poke32(sh4 + 40, 2); poke32(sh4 + 44, 1);          // link=.symtab, info=.ltext
    poke64(sh4 + 48, 8); poke64(sh4 + 56, 24);
    var sh5: int64 := buf + shTableOff + 320;   // .shstrtab
    poke32(sh5, 35); poke32(sh5 + 4, 3);               // SHT_STRTAB
    poke64(sh5 + 24, shstrOff); poke64(sh5 + 32, shstrtabSize);
    poke64(sh5 + 48, 1);

    var fd: int64 := open(path, 577, 493);
    if (fd >= 0) { write(fd, buf as pchar, fileSize); close(fd); }
    else { PrintStr("codegen: failed to open output file: "); PrintStr(path); PrintStr("\n"); }
  }

  fn WriteELF(path: pchar) {
    // WP-34: refuse to write a binary produced by an overflowed buffer
    if (self.codeOverflow != 0 || self.dataOverflow != 0) {
      EPrintStrLn("error: codegen: WriteELF abgebrochen — Puffer-512-MB-Limit überschritten"c);
      return;
    }
    // FFI programs need a dynamically-linked ELF (PT_INTERP + .dynamic + GOT
    // relocations against the named shared libraries). Programs with no extern
    // imports keep the byte-identical static path below — preserving the
    // self-host singularity, since lyxc itself uses no FFI.
    if (self.externCount > 0) {
      self.cg_writeELFDynamic(path);
      return;
    }
    // LyxOS-Reloc Step 1: Release-Build mit Base-Relocs (Klassen/VMT) → ELF mit PT_LYXRELOC,
    // damit der LyxOS-Loader bei abweichender Ladebasis fixupen kann (statt vmm-Aliasing).
    // Debug/Watermark behalten den exakten Alt-Pfad (unberührt). Linux ignoriert PT_LYXRELOC.
    if (self.debugMode == 0 && self.licenseKey == 0 && self.baseRelocCount > 0) {
      self.cg_writeELFReloc(path);
      return;
    }
    var totalCode: int64 := self.codeLen;
    var totalData: int64 := self.dataLen;
    var baseSize:  int64 := CG_CODE_OFF + totalCode + totalData;

    // WP-BC-25: allocate DwarfGen at function scope so it spans both debug blocks
    var dg: DwarfGen := new DwarfGen();
    dg.Init();

    var abbrevSize: int64 := 0;
    var infoSize:   int64 := 0;
    var lineSize:   int64 := 0;
    var strSize:    int64 := 0;
    if (self.debugMode != 0) {
      var li: int64 := 0;
      while (li < self.labelCount) {
        var lbase:    int64 := self.labels + li * CG_LABEL_SZ;
        var lname:    pchar := peek64(lbase) as pchar;
        var lnlen:    int64 := peek64(lbase + CG_LABEL_OFF_NAMELEN);
        var lstart:   int64 := peek64(lbase + CG_LABEL_OFF_CODEOFF);
        var llineNum: int64 := peek64(lbase + CG_LABEL_OFF_LINENUM);
        var lend:     int64 := 0;
        if (li + 1 < self.labelCount) {
          lend := peek64(self.labels + (li + 1) * CG_LABEL_SZ + CG_LABEL_OFF_CODEOFF);
        } else {
          lend := totalCode;
        }
        dg.dw_addFunc(lname, lnlen, lstart, lend, llineNum);
        li += 1;
      }
      dg.dw_buildAbbrev();
      dg.dw_buildInfo(self.srcFilePath, self.srcFileLen, totalCode);
      dg.dw_buildLine(self.srcFilePath, self.srcFileLen);
      abbrevSize := dg.abbrevLen;
      infoSize   := dg.infoLen;
      lineSize   := dg.lineLen;
      strSize    := dg.strLen;
    }

    var shstrtabSize: int64 := 60;
    var fileSize: int64 := baseSize;
    if (self.debugMode != 0) {
      fileSize := baseSize + abbrevSize + infoSize + lineSize + strSize + shstrtabSize + 384;
    }

    // WP-LIC-10: watermark layout (only in non-debug static builds with a license key)
    // Layout appended after baseSize:
    //   [+0 ..+15] : 16-byte .lyx_lic payload
    //   [+16..+35] : .shstrtab (20 bytes: \0.lyx_lic\0.shstrtab\0)
    //   [+36..+227]: 3 × 64-byte section headers (NULL, .lyx_lic, .shstrtab)
    var hasWatermark: bool := self.licenseKey != 0 && self.debugMode == 0;
    var licPayload: int64 := alloc(16);  // zeroed by mmap
    if hasWatermark {
      // Read source file to compute SHA256(sourceCode)
      var srcHash: int64 := alloc(32);
      var sfd: int64 := open(self.srcFilePath, 0, 0);
      if sfd >= 0 {
        var srcSz: int64 := lseek(sfd, 0, 2);
        lseek(sfd, 0, 0);
        if srcSz > 0 {
          var srcBuf: int64 := alloc(srcSz + 1);
          // WP-27: nur hashen wenn vollständig gelesen (sonst Arena-Müll im Hash).
          if (read(sfd, srcBuf as pchar, srcSz) == srcSz) {
            lic_sha256(srcBuf, srcSz, srcHash);
          }
          free(srcBuf, srcSz + 1);
        }
        close(sfd);
      }
      // fingerprint = HMAC-SHA256(licenseKey, srcHash) → first 8 bytes
      var hmacOut: int64 := alloc(32);
      lic_hmacSha256(self.licenseKey, self.licenseKeyLen, srcHash, 32, hmacOut);
      var fi: int64 := 0;
      memcpy(licPayload, hmacOut, 8);
      free(hmacOut, 32);
      // keyChecksum = SHA256(licenseKey) → first 4 bytes
      var keyHash: int64 := alloc(32);
      lic_sha256(self.licenseKey, self.licenseKeyLen, keyHash);
      var ki: int64 := 0;
      memcpy(licPayload + 8, keyHash, 4);
      free(keyHash, 32);
      free(srcHash, 32);
      // version byte
      poke8(licPayload + 12, 1);
      // bytes 13-15: already zero (padding)
      fileSize := fileSize + 16 + 20 + 192;  // payload + shstrtab + 3×64 section headers
    }

    // Allocate ELF buffer
    var buf: int64 := alloc(fileSize);

    // ELF header (64 bytes)
    poke8(buf, 0x7F);
    poke8(buf + 1,  69);   // 'E'
    poke8(buf + 2,  76);   // 'L'
    poke8(buf + 3,  70);   // 'F'
    poke8(buf + 4,  2);    // ELFCLASS64
    poke8(buf + 5,  1);    // ELFDATA2LSB
    poke8(buf + 6,  1);    // EV_CURRENT
    poke8(buf + 7,  0);    // ELFOSABI_NONE
    // bytes 8-15: padding (mmap zeroed)
    poke16(buf + 16, 2);    // e_type = ET_EXEC
    poke16(buf + 18, 62);   // e_machine = EM_X86_64 (0x3E)
    poke32(buf + 20, 1);    // e_version
    // e_entry = load vaddr + ELF/phdr headers + _start offset (0)
    poke64(buf + 24, CG_ELF_BASE + CG_CODE_OFF);
    poke64(buf + 32, CG_PHDR_OFF);  // e_phoff
    poke64(buf + ELF64_EHDR_OFF_SHOFF, 0);
    poke32(buf + 48, 0);             // e_flags
    poke16(buf + 52, 64);   // e_ehsize
    poke16(buf + 54, 56);   // e_phentsize
    poke16(buf + 56, 2);    // e_phnum — WP-6: two PT_LOAD (RX code + RW data)
    poke16(buf + 58, 64);   // e_shentsize
    poke16(buf + 60, 0);    // e_shnum
    poke16(buf + 62, 0);    // e_shstrndx
    if (self.debugMode != 0) {
      var shoff: int64 := baseSize + abbrevSize + infoSize + lineSize + strSize + shstrtabSize;
      poke64(buf + ELF64_EHDR_OFF_SHOFF, shoff);
      poke16(buf + 60, 6);      // e_shnum = 6
      poke16(buf + 62, 5);      // e_shstrndx = 5
    }
    if hasWatermark {
      // e_shoff = after code+data+payload+shstrtab
      poke64(buf + ELF64_EHDR_OFF_SHOFF, baseSize + 16 + 20);
      poke16(buf + 60, 3);                    // e_shnum = 3
      poke16(buf + 62, 2);                    // e_shstrndx = 2 (.shstrtab)
    }

    // WP-6: Two PT_LOAD headers for W^X separation.
    // phdr1 (offset 64,  56 bytes): RX — ELF header + phdrs + code (page-aligned)
    // phdr2 (offset 120, 56 bytes): RW — data only
    var rxSize: int64 := CG_CODE_OFF + totalCode;  // headers + page-aligned code
    var rwOff:  int64 := rxSize;                   // data starts right after
    var rwVaddr: int64 := CG_ELF_BASE + rwOff;

    // PT_LOAD #1: RX (read + execute) — code segment
    var ph: int64 := buf + CG_PHDR_OFF;
    poke32(ph,      1);              // p_type = PT_LOAD
    poke32(ph + 4,  5);              // p_flags = PF_R|PF_X
    poke64(ph + ELF64_PHDR_OFF_OFFSET, 0);
    poke64(ph + 16, CG_ELF_BASE);   // p_vaddr
    poke64(ph + 24, CG_ELF_BASE);   // p_paddr
    poke64(ph + ELF64_PHDR_OFF_FILESZ, rxSize);
    poke64(ph + ELF64_PHDR_OFF_MEMSZ,  rxSize);
    poke64(ph + ELF64_PHDR_OFF_ALIGN,  4096);

    // PT_LOAD #2: RW (read + write) — data segment
    var ph2: int64 := buf + CG_PHDR_OFF + 56;
    poke32(ph2,      1);             // p_type = PT_LOAD
    poke32(ph2 + 4,  6);             // p_flags = PF_R|PF_W
    poke64(ph2 + ELF64_PHDR_OFF_OFFSET, rwOff);
    poke64(ph2 + 16, rwVaddr);       // p_vaddr
    poke64(ph2 + 24, rwVaddr);       // p_paddr
    poke64(ph2 + ELF64_PHDR_OFF_FILESZ, totalData);
    poke64(ph2 + ELF64_PHDR_OFF_MEMSZ,  totalData);
    poke64(ph2 + ELF64_PHDR_OFF_ALIGN,  4096);

    // Copy code
    var i: int64 := 0;
    memcpy(buf + CG_CODE_OFF, self.code, totalCode);

    // Copy string data
    i := 0;
    memcpy(buf + CG_CODE_OFF + totalCode, self.data, totalData);

    // WP-BC-25: emit DWARF debug sections and section header table
    if (self.debugMode != 0) {
      var abbrevOff:   int64 := baseSize;
      var infoOff:     int64 := abbrevOff + abbrevSize;
      var lineOff:     int64 := infoOff   + infoSize;
      var strOff:      int64 := lineOff   + lineSize;
      var shstrtabOff: int64 := strOff    + strSize;

      // Copy .debug_abbrev
      i := 0;
      memcpy(buf+abbrevOff, dg.abbrevBuf, abbrevSize);
      // Copy .debug_info
      i := 0;
      memcpy(buf+infoOff, dg.infoBuf, infoSize);
      // Copy .debug_line
      i := 0;
      memcpy(buf+lineOff, dg.lineBuf, lineSize);
      // Copy .debug_str
      i := 0;
      memcpy(buf+strOff, dg.strBuf, strSize);

      // Build .shstrtab (60 bytes)
      // "\0.debug_abbrev\0.debug_info\0.debug_line\0.debug_str\0.shstrtab\0"
      var ss: int64 := buf + shstrtabOff;
      poke8(ss,0);
      poke8(ss+1,46);poke8(ss+2,100);poke8(ss+3,101);poke8(ss+4,98);poke8(ss+5,117);
      poke8(ss+6,103);poke8(ss+7,95);poke8(ss+8,97);poke8(ss+9,98);poke8(ss+10,98);
      poke8(ss+11,114);poke8(ss+12,101);poke8(ss+13,118);poke8(ss+14,0);
      poke8(ss+15,46);poke8(ss+16,100);poke8(ss+17,101);poke8(ss+18,98);poke8(ss+19,117);
      poke8(ss+20,103);poke8(ss+21,95);poke8(ss+22,105);poke8(ss+23,110);poke8(ss+24,102);
      poke8(ss+25,111);poke8(ss+26,0);
      poke8(ss+27,46);poke8(ss+28,100);poke8(ss+29,101);poke8(ss+30,98);poke8(ss+31,117);
      poke8(ss+32,103);poke8(ss+33,95);poke8(ss+34,108);poke8(ss+35,105);poke8(ss+36,110);
      poke8(ss+37,101);poke8(ss+38,0);
      poke8(ss+39,46);poke8(ss+40,100);poke8(ss+41,101);poke8(ss+42,98);poke8(ss+43,117);
      poke8(ss+44,103);poke8(ss+45,95);poke8(ss+46,115);poke8(ss+47,116);poke8(ss+48,114);
      poke8(ss+49,0);
      poke8(ss+50,46);poke8(ss+51,115);poke8(ss+52,104);poke8(ss+53,115);poke8(ss+54,116);
      poke8(ss+55,114);poke8(ss+56,116);poke8(ss+57,97);poke8(ss+58,98);poke8(ss+59,0);

      // Section header table (6 × 64 bytes; [0]=NULL, already zero from mmap)
      var sh0: int64 := buf + shstrtabOff + shstrtabSize;
      var sh: int64 := 0;

      // [1] .debug_abbrev: sh_name=1, SHT_PROGBITS
      sh := sh0 + 64;
      poke32(sh,1);  poke32(sh+4,1);
      poke64(sh+24,abbrevOff); poke64(sh+32,abbrevSize); poke64(sh+48,1);

      // [2] .debug_info: sh_name=15, SHT_PROGBITS
      sh := sh0 + 128;
      poke32(sh,15); poke32(sh+4,1);
      poke64(sh+24,infoOff); poke64(sh+32,infoSize); poke64(sh+48,1);

      // [3] .debug_line: sh_name=27, SHT_PROGBITS
      sh := sh0 + 192;
      poke32(sh,27); poke32(sh+4,1);
      poke64(sh+24,lineOff); poke64(sh+32,lineSize); poke64(sh+48,1);

      // [4] .debug_str: sh_name=39, SHT_PROGBITS, SHF_MERGE|SHF_STRINGS=0x30, entsize=1
      sh := sh0 + 256;
      poke32(sh,39); poke32(sh+4,1);
      poke64(sh+8,48); poke64(sh+24,strOff); poke64(sh+32,strSize);
      poke64(sh+48,1); poke64(sh+56,1);

      // [5] .shstrtab: sh_name=50, SHT_STRTAB=3
      sh := sh0 + 320;
      poke32(sh,50); poke32(sh+4,3);
      poke64(sh+24,shstrtabOff); poke64(sh+32,shstrtabSize); poke64(sh+48,1);
    }

    // WP-LIC-10: embed .lyx_lic section (non-debug static builds only)
    if hasWatermark {
      // Write 16-byte payload at baseSize
      var wi: int64 := 0;
      memcpy(buf + baseSize, licPayload, 16);

      // .shstrtab at baseSize+16 (20 bytes):
      // \0.lyx_lic\0.shstrtab\0
      var ss: int64 := buf + baseSize + 16;
      poke8(ss, 0);
      poke8(ss+1,46);poke8(ss+2,108);poke8(ss+3,121);poke8(ss+4,120);   // .lyx
      poke8(ss+5,95);poke8(ss+6,108);poke8(ss+7,105);poke8(ss+8,99);    // _lic
      poke8(ss+9,0);
      poke8(ss+10,46);poke8(ss+11,115);poke8(ss+12,104);poke8(ss+13,115); // .shs
      poke8(ss+14,116);poke8(ss+15,114);poke8(ss+16,116);poke8(ss+17,97); // trtab
      poke8(ss+18,98);poke8(ss+19,0);

      // Section header table at baseSize+16+20 = baseSize+36
      // [0] NULL — all zeros (already zeroed by mmap)
      var sh0: int64 := buf + baseSize + 36;

      // [1] .lyx_lic: SHT_PROGBITS=1, no flags, offset=baseSize, size=16, align=1
      var sh1: int64 := sh0 + 64;
      poke32(sh1,    1);          // sh_name = 1 (offset in shstrtab)
      poke32(sh1+4,  1);          // sh_type = SHT_PROGBITS
      poke64(sh1+8,  0);          // sh_flags = 0 (not loaded, not executable)
      poke64(sh1+16, 0);          // sh_addr = 0
      poke64(sh1+24, baseSize);   // sh_offset = start of payload in file
      poke64(sh1+32, 16);         // sh_size = 16
      poke64(sh1+48, 1);          // sh_addralign = 1

      // [2] .shstrtab: SHT_STRTAB=3, offset=baseSize+16, size=20, align=1
      var sh2: int64 := sh0 + 128;
      poke32(sh2,    10);          // sh_name = 10
      poke32(sh2+4,  3);           // sh_type = SHT_STRTAB
      poke64(sh2+24, baseSize+16); // sh_offset
      poke64(sh2+32, 20);          // sh_size
      poke64(sh2+48, 1);           // sh_addralign = 1
    }
    free(licPayload, 16);

    // Write ELF binary to file (O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0755 = 493)
    var fd: int64 := open(path, 577, 493);
    if (fd >= 0) {
      write(fd, buf as pchar, fileSize);
      close(fd);
    } else {
      PrintStr("codegen: failed to open output file: ");
      PrintStr(path);
      PrintStr("\n");
    }
  }

  // ------------------------------------------------------------------
  // Dynamically-linked ET_EXEC writer (FFI / extern fn ... link "...")
  //
  // Layout — code and data keep their static file offsets/VAs so that every
  // absolute address baked in during codegen (VMT pointers, globals) stays
  // valid; we only relocate the program-header table to the end of the file
  // and append the dynamic-linking sections after .data:
  //
  //   [0,64)    ELF header (e_phoff -> phdrs at end, e_phnum = 3)
  //   [64,..)   .interp = "/lib64/ld-linux-x86-64.so.2"  (fits the 56B gap)
  //   [120,..)  code           (unchanged VA = base + 120)
  //   [..]      data           (unchanged)
  //   [..]      .dynstr .dynsym .hash .rela.dyn .got .dynamic
  //   [..]      program headers: PT_LOAD, PT_INTERP, PT_DYNAMIC
  //
  // Each imported symbol gets a GOT slot resolved eagerly by ld.so via an
  // R_X86_64_GLOB_DAT relocation (DT_FLAGS = DF_BIND_NOW), so no PLT/lazy
  // resolver is needed: call sites are `call *slot(%rip)` (FF 15).
  // ------------------------------------------------------------------
  fn cg_writeELFDynamic(path: pchar) {
    var totalCode: int64 := self.codeLen;
    var totalData: int64 := self.dataLen;
    var nExt: int64 := self.externCount;

    var interpStr: pchar := "/lib64/ld-linux-x86-64.so.2";
    var interpOff: int64 := 64;
    var interpLen: int64 := StrLen(interpStr) + 1;   // include NUL terminator

    var codeOff: int64 := CG_CODE_OFF;               // 176: ELF hdr (64) + 2×phdr (56+56)
    var dataOff: int64 := codeOff + totalCode;        // page-aligned by Generate() padding

    // --- build .dynstr (\0, then distinct lib names, then symbol names) ---
    var dynstr: int64 := alloc(65536);
    var dsLen:  int64 := 0;
    poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;    // index 0 = ""

    var uniqPtr:    int64 := alloc((nExt + 1) * 8);
    var uniqLen:    int64 := alloc((nExt + 1) * 8);
    var uniqStrOff: int64 := alloc((nExt + 1) * 8);
    var uniqCount:  int64 := 0;
    var symStrOff:  int64 := alloc((nExt + 1) * 8);

    var ei: int64 := 0;
    while (ei < nExt) {
      var eb: int64 := self.externSyms + ei * CG_EXTERN_SZ;
      var lp: int64 := peek64(eb + CG_EXTERN_OFF_LIBPTR);
      var ll: int64 := peek64(eb + CG_EXTERN_OFF_LIBLEN);
      var u: int64 := 0;
      var found: int64 := -1;
      while (u < uniqCount) {
        if (peek64(uniqLen + u * 8) == ll &&
            self.cg_seq(peek64(uniqPtr + u * 8) as pchar, ll, lp as pchar, ll)) {
          found := u; u := uniqCount;
        } else {
          u += 1;
        }
      }
      if (found < 0) {
        var off: int64 := dsLen;
        var j: int64 := 0;
        memcpy(dynstr + dsLen, lp, ll); dsLen := dsLen + ll;
        poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
        poke64(uniqPtr + uniqCount * 8, lp);
        poke64(uniqLen + uniqCount * 8, ll);
        poke64(uniqStrOff + uniqCount * 8, off);
        uniqCount += 1;
      }
      ei += 1;
    }
    ei := 0;
    while (ei < nExt) {
      var eb2: int64 := self.externSyms + ei * CG_EXTERN_SZ;
      var np: int64 := peek64(eb2);
      var nl: int64 := peek64(eb2 + CG_EXTERN_OFF_NAMELEN);
      var off2: int64 := dsLen;
      var j2: int64 := 0;
      memcpy(dynstr + dsLen, np, nl); dsLen := dsLen + nl;
      poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
      poke64(symStrOff + ei * 8, off2);
      ei += 1;
    }
    var dynstrSize: int64 := dsLen;

    // --- section offsets (8-byte aligned via ((x+7)>>3)<<3) ---
    var dynstrOff: int64 := ((dataOff + totalData + 7) >> 3) << 3;
    var dynsymOff: int64 := ((dynstrOff + dynstrSize + 7) >> 3) << 3;
    var dynsymSize: int64 := (nExt + 1) * 24;
    var hashOff: int64 := dynsymOff + dynsymSize;            // 24*k is 8-aligned
    var nchain: int64 := nExt + 1;
    var hashSize: int64 := (3 + nchain) * 4;                  // nbucket,nchain,bucket[1],chain[]
    var relaOff: int64 := ((hashOff + hashSize + 7) >> 3) << 3;
    var relaSize: int64 := nExt * 24;
    var gotOff: int64 := relaOff + relaSize;                  // 8-aligned
    var gotSize: int64 := nExt * 8;
    var dynOff: int64 := gotOff + gotSize;                    // 8-aligned
    var dynCount: int64 := uniqCount + 11;                    // NEEDED*u + 11 fixed tags
    var dynSize: int64 := dynCount * 16;
    var phdrOff: int64 := ((dynOff + dynSize + 7) >> 3) << 3;
    var phnum: int64 := 4;                           // WP-6b: +1 PT_LOAD for RX/RW split
    var fileSize: int64 := phdrOff + phnum * 56;

    // --- patch extern call sites: disp32 = gotSlotVA - ripVA ---
    var pi: int64 := 0;
    while (pi < self.patchCount) {
      var pb: int64 := self.patches + pi * CG_PATCH_SZ;
      if (peek64(pb + 24) == CG_PATCH_EXTERN) {
        var cOff:   int64 := peek64(pb);
        var exIdx:  int64 := peek64(pb + CG_PATCH_OFF_NAMEPTR);
        var gotVA:  int64 := CG_ELF_BASE + gotOff + exIdx * 8;
        var ripVA:  int64 := CG_ELF_BASE + codeOff + cOff + 4;
        poke32(self.code + cOff, gotVA - ripVA);
      }
      pi += 1;
    }

    // --- assemble the file image ---
    var buf: int64 := alloc(fileSize);

    // ELF header
    poke8(buf, 0x7F); poke8(buf + 1, 69); poke8(buf + 2, 76); poke8(buf + 3, 70);
    poke8(buf + 4, 2); poke8(buf + 5, 1); poke8(buf + 6, 1); poke8(buf + 7, 0);
    poke16(buf + 16, 2);              // e_type = ET_EXEC
    poke16(buf + 18, 62);             // e_machine = EM_X86_64
    poke32(buf + 20, 1);              // e_version
    poke64(buf + 24, CG_ELF_BASE + codeOff);  // e_entry
    poke64(buf + ELF64_EHDR_OFF_PHOFF, phdrOff);
    poke64(buf + ELF64_EHDR_OFF_SHOFF, 0);
    poke32(buf + 48, 0);              // e_flags
    poke16(buf + 52, 64);             // e_ehsize
    poke16(buf + 54, 56);             // e_phentsize
    poke16(buf + 56, phnum);          // e_phnum
    poke16(buf + 58, 64);             // e_shentsize
    poke16(buf + 60, 0);              // e_shnum
    poke16(buf + 62, 0);              // e_shstrndx

    // .interp (in the 56-byte gap between phdr-area and code)
    var ii: int64 := 0;
    memcpy(buf + interpOff, interpStr as int64, interpLen);

    // code (extern disps now patched)
    var ci: int64 := 0;
    memcpy(buf + codeOff, self.code, totalCode);
    // data
    var di: int64 := 0;
    memcpy(buf + dataOff, self.data, totalData);

    // .dynstr
    var si: int64 := 0;
    memcpy(buf + dynstrOff, dynstr, dynstrSize);

    // .dynsym — [0] = null symbol (zeroed); [i+1] = UNDEF GLOBAL FUNC import
    ei := 0;
    while (ei < nExt) {
      var sy: int64 := buf + dynsymOff + (ei + 1) * 24;
      poke32(sy, peek64(symStrOff + ei * 8));  // st_name
      poke8(sy + 4, 0x12);                      // st_info = STB_GLOBAL|STT_FUNC
      poke8(sy + 5, 0);                          // st_other
      poke16(sy + 6, 0);                         // st_shndx = SHN_UNDEF
      ei += 1;
    }

    // .hash — minimal SysV: nbucket=1, nchain, empty bucket/chains
    poke32(buf + hashOff, 1);          // nbucket
    poke32(buf + hashOff + 4, nchain); // nchain (must equal dynsym count)

    // .rela.dyn — one R_X86_64_GLOB_DAT per import into its GOT slot
    ei := 0;
    while (ei < nExt) {
      var ra: int64 := buf + relaOff + ei * 24;
      poke64(ra, CG_ELF_BASE + gotOff + ei * 8);          // r_offset = GOT slot VA
      poke64(ra + ELF64_RELA_OFF_INFO, ((ei + 1) << 32) | 6);               // r_info = (sym<<32)|R_X86_64_GLOB_DAT
      poke64(ra + ELF64_RELA_OFF_ADDEND, 0);                                  // r_addend
      ei += 1;
    }

    // .got — zero slots (filled by ld.so); already zeroed by mmap

    // .dynamic
    var dp: int64 := buf + dynOff;
    var u2: int64 := 0;
    while (u2 < uniqCount) {
      poke64(dp, 1); poke64(dp + ELF64_DYN_OFF_VAL, peek64(uniqStrOff + u2 * 8)); dp := dp + 16;  // DT_NEEDED
      u2 += 1;
    }
    poke64(dp, 4);  poke64(dp + ELF64_DYN_OFF_VAL, CG_ELF_BASE + hashOff);   dp := dp + 16;  // DT_HASH
    poke64(dp, 5);  poke64(dp + ELF64_DYN_OFF_VAL, CG_ELF_BASE + dynstrOff); dp := dp + 16;  // DT_STRTAB
    poke64(dp, 6);  poke64(dp + ELF64_DYN_OFF_VAL, CG_ELF_BASE + dynsymOff); dp := dp + 16;  // DT_SYMTAB
    poke64(dp, 10); poke64(dp + ELF64_DYN_OFF_VAL, dynstrSize);              dp := dp + 16;  // DT_STRSZ
    poke64(dp, 11); poke64(dp + ELF64_DYN_OFF_VAL, 24);                      dp := dp + 16;  // DT_SYMENT
    poke64(dp, 7);  poke64(dp + ELF64_DYN_OFF_VAL, CG_ELF_BASE + relaOff);   dp := dp + 16;  // DT_RELA
    poke64(dp, 8);  poke64(dp + ELF64_DYN_OFF_VAL, relaSize);                dp := dp + 16;  // DT_RELASZ
    poke64(dp, 9);  poke64(dp + ELF64_DYN_OFF_VAL, 24);                      dp := dp + 16;  // DT_RELAENT
    poke64(dp, 30); poke64(dp + ELF64_DYN_OFF_VAL, 8);                       dp := dp + 16;  // DT_FLAGS = DF_BIND_NOW
    poke64(dp, 0);  poke64(dp + ELF64_DYN_OFF_VAL, 0);                       dp := dp + 16;  // DT_NULL

    // program headers at end of file
    var ph: int64 := buf + phdrOff;

    // WP-6b: PT_LOAD #1 — RX (read + execute): ELF header + .interp + code
    // dataOff is page-aligned (Generate() pads code to 4096-byte boundary)
    var rxSize: int64 := dataOff;
    poke32(ph,      1); poke32(ph + 4, 5);                          // PT_LOAD, PF_R|PF_X
    poke64(ph + ELF64_PHDR_OFF_OFFSET, 0);
    poke64(ph + ELF64_PHDR_OFF_VADDR,  CG_ELF_BASE);
    poke64(ph + ELF64_PHDR_OFF_PADDR,  CG_ELF_BASE);
    poke64(ph + ELF64_PHDR_OFF_FILESZ, rxSize);
    poke64(ph + ELF64_PHDR_OFF_MEMSZ,  rxSize);
    poke64(ph + ELF64_PHDR_OFF_ALIGN,  4096);

    // WP-6b: PT_LOAD #2 — RW (read + write): data + sections + phdrs
    var ph2: int64 := ph + 56;
    var rwOff:  int64 := dataOff;
    var rwSize: int64 := fileSize - rwOff;
    poke32(ph2,      1); poke32(ph2 + 4, 6);                        // PT_LOAD, PF_R|PF_W
    poke64(ph2 + ELF64_PHDR_OFF_OFFSET, rwOff);
    poke64(ph2 + ELF64_PHDR_OFF_VADDR,  CG_ELF_BASE + rwOff);
    poke64(ph2 + ELF64_PHDR_OFF_PADDR,  CG_ELF_BASE + rwOff);
    poke64(ph2 + ELF64_PHDR_OFF_FILESZ, rwSize);
    poke64(ph2 + ELF64_PHDR_OFF_MEMSZ,  rwSize);
    poke64(ph2 + ELF64_PHDR_OFF_ALIGN,  4096);

    // PT_INTERP
    var ph3: int64 := ph + 112;
    poke32(ph3, 3); poke32(ph3 + 4, 4);
    poke64(ph3 + 8, interpOff); poke64(ph3 + 16, CG_ELF_BASE + interpOff); poke64(ph3 + 24, CG_ELF_BASE + interpOff);
    poke64(ph3 + ELF64_PHDR_OFF_FILESZ, interpLen); poke64(ph3 + ELF64_PHDR_OFF_MEMSZ,  interpLen); poke64(ph3 + ELF64_PHDR_OFF_ALIGN,  1);
    // PT_DYNAMIC
    var ph4: int64 := ph + 168;
    poke32(ph4, 2); poke32(ph4 + 4, 6);
    poke64(ph4 + 8, dynOff); poke64(ph4 + 16, CG_ELF_BASE + dynOff); poke64(ph4 + 24, CG_ELF_BASE + dynOff);
    poke64(ph4 + ELF64_PHDR_OFF_FILESZ, dynSize); poke64(ph4 + ELF64_PHDR_OFF_MEMSZ,  dynSize); poke64(ph4 + ELF64_PHDR_OFF_ALIGN,  8);

    var fd: int64 := open(path, 577, 493);
    if (fd >= 0) {
      write(fd, buf as pchar, fileSize);
      close(fd);
    } else {
      PrintStr("codegen: failed to open output file: ");
      PrintStr(path);
      PrintStr("\n");
    }
  }

};

// ============================================================================
// Public helper: emit count of nodes in a singly-linked list (via NNext)
// (Mirrors ParserListLen from parser.lyx for convenience)
// ============================================================================

pub fn CodegenListLen(head: int64, nodes: int64): int64 {
  var n: int64 := 0;
  var cur: int64 := head;
  while (cur != -1) {
    n += 1;
    cur := peek64(nodes + cur * 88 + 40);
  }
  return n;
}
