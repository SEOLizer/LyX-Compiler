    self.cg_e8(0x0A); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);                   // mov rcx, 10
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);                                      // idiv rcx
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC2); self.cg_e8(0x30);                   // add rdx, '0'
    self.cg_e8(0x88); self.cg_e8(0x16);                                                         // mov [rsi], dl
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);                                      // dec rsi
    self.cg_e8(0xEB); self.cg_e8(0xE3);                                                         // jmp .digitloop (-29)
