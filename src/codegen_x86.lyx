con CG_CANARY: int64 := 80; // data[80..87]: _lyx_canary (8 bytes)

// ============================================================================
// Codegen class
// ============================================================================

pub type Codegen = class {

  // Code emission buffer
  code:    int64;
  codeLen: int64;
  codeCap: int64;

  // String literal data buffer
  data:    int64;
  dataLen: int64;
  dataCap: int64;

  // Local variable table
  locals:     int64;
  localCount: int64;
  localCap:   int64;
  frameSize:  int64;   // bytes allocated below rbp (grows with each local)

  // Function label table
  labels:     int64;
  labelCount: int64;
  labelCap:   int64;

  // Backpatch table
  patches:    int64;
  patchCount: int64;
  patchCap:   int64;

  // FFI imports. externDecls holds every declared `extern fn ... link "lib"`
  // (name + library) for lookup. externSyms holds only the ones actually
  // CALLED — those get a GOT slot, .dynsym/.rela.dyn entry and DT_NEEDED. This
  // lazy registration matters under DT_BIND_NOW: a declared-but-unused extern
  // (or a stale/mis-named one) must not force the loader to resolve it.
  // Both use CG_EXTERN_SZ-byte entries: namePtr,nameLen,libPtr,libLen.
  externDecls:     int64;
  externDeclCount: int64;
  externDeclCap:   int64;
  externSyms:      int64;
  externCount:     int64;
  externCap:       int64;
  // WSP-07: externe Daten-Symbole (extern "asm"). Entry = {namePtr:i64, nameLen:i64} (16 B).
  externData:      int64;
  externDataCount: int64;
  externDataCap:   int64;
  objMode:         int64;   // WSP-07: 1 = ET_REL-Objekt (--emit=obj); extern "asm" nur hier erlaubt

  // Parser output (set by Init)
  pSrc:   pchar;
  pNodes: int64;
  pToks:  int64;

  // Unique id for anonymous labels (if/while)
  nextLblId: int64;

  // Import deduplication (WP-09: avoid processing same module twice)
  importNames: int64;  // mmap buffer of {ptr:int64, len:int64} pairs (16 bytes each)
  importCount: int64;
  importCap:   int64;

  // Class layout table (WP-09 OOP support)
  classLayouts: int64;   // {namePtr:8, nameLen:8, fieldsPtr:8, fieldCnt:8} each
  classCount:   int64;
  classCap:     int64;

  // Enum layout table (BUG-08: enum tag analysis for match)
  // Each entry: {namePtr:8, nameLen:8, variantsPtr:8, variantCnt:8} = 32 bytes
  // Each variant: {namePtr:8, nameLen:8, tagValue:8, payloadSize:8} = 32 bytes
  enumLayouts:  int64;
  enumCount:    int64;
  enumCap:      int64;

  // Per-local type tracking (parallel to locals, {typePtr:8, typeLen:8} each)
  localTypes:   int64;

  // Current method class context (set while generating a method body)
  curClassName:    pchar;
  curClassNameLen: int64;

  // Module-level constant table {namePtr:8, nameLen:8, value:8} = 24 bytes per entry
  conTable:   int64;
  conCount:   int64;
  conCap:     int64;
  conIsPchar: int64;  // byte buffer parallel to conTable: 1 = pchar string constant

  // Break support: linked list of pending jmp-rel32 placeholders in code buffer.
  // curBreakHead holds the code offset of the most recent break's 4-byte placeholder,
  // or -1 if no break is pending. Each placeholder stores the previous head as the link.
  curBreakHead: int64;

  // Continue support: linked list of pending jmp-rel32 placeholders for continue
  curContHead: int64;

  // #1030: Argumente eines aufgeschobenen Aufrufs werden bei der VORMERKUNG
  // ausgewertet und in verdeckte lokale Slots gelegt. dfNodes haelt die
  // Argumentknoten, dfSlots den zugehoerigen Rahmen-Offset. Beim Emittieren
  // des Aufrufs am Blockende liefert cg_genExpr fuer diese Knoten den
  // gespeicherten Wert statt neu auszuwerten.
  dfNodes:  int64;
  dfSlots:  int64;
  dfCount:  int64;
  dfCap:    int64;
  dfReplay: int64;   // 1 = wir emittieren gerade einen aufgeschobenen Aufruf

  // #1006: Stand des defer-Puffers beim Eintritt in den Rumpf der innersten
  // Schleife. break und continue verlassen den Rumpf, ohne dessen Blockende zu
  // erreichen — sie muessen die dort offenen defers vorher selbst abarbeiten.
  // -1 = ausserhalb jeder Schleife.
  loopDeferMark: int64;

  // WP-BC-11: or-pattern body forward jump list (je body, linked list of rel32 positions)
  orBodyHead: int64;

  // VMT address patch table (WP-10a): {codeOff:8, classNamePtr:8, classNameLen:8}
  // Each entry says: at code offset codeOff there is a mov-rcx-imm64 placeholder
  // that needs the absolute vaddr of the VMT table for the named class.
  vmtPatches:    int64;
  vmtPatchCount: int64;
  vmtPatchCap:   int64;

  // WP-BC-19: VMT method patch table: {vmtDataSlotOff:8, methodCodeStart:8}
  // After all code is generated, fill each VMT slot with the method's vaddr.
  vmtMethodPatches:     int64;
  vmtMethodPatchCount:  int64;
  vmtMethodPatchCap:    int64;

  // WP-A2.2: base relocations — image RVAs (relative to CG_ELF_BASE) of 8-byte
  // absolute pointers (VMT slots + VMT-address movabs) that consumers must adjust
  // by (load_base − CG_ELF_BASE). Used by the PE .reloc emitter and the LyxOS loader.
  baseRelocBuf:    int64;
  baseRelocCount:  int64;
  baseRelocCap:    int64;

  // f64-returning user-defined functions: {namePtr:8, nameLen:8} = 16 bytes per entry
  f64FuncList:  int64;
  f64FuncCount: int64;
  f64FuncCap:   int64;
  // Function return types (operator overloading Stage 2c): {funcNamePtr:8,
  // funcNameLen:8, retNamePtr:8, retNameLen:8} = 32 bytes per entry. Lets a call
  // expression's static class be resolved (retName -> cg_findClass at lookup).
  fnRetList:  int64;
  fnRetCount: int64;
  fnRetCap:   int64;
  // B2: method-Typ-Alias-Namen (Registry für fat-pointer-Detektion)
  methodAliasList:  int64;
  methodAliasCount: int64;
  methodAliasCap:   int64;
  // fn-Typ-Alias-Namen (thin-fn-pointer; lokaler plain-fn-ptr-Call)
  fnAliasList:  int64;
  fnAliasCount: int64;
  fnAliasCap:   int64;

  // WP-BC-24: deferred generic monomorphization list
  // Entry: {mangledNamePtr:8, mangledNameLen:8, genericFuncNode:8} = 24 bytes
  monoList:  int64;
  monoCount: int64;
  monoCap:   int64;

  // WP-13: Closure support - static link for nested functions
  staticLinkOffset: int64;  // rbp offset of static link param (or -1 if not nested)
  outerFuncName:    pchar;  // name of outer function (for static link)
  outerFuncNameLen: int64;

  // WP-02: anonymous closure support
  anonFnCounter:         int64;   // counter for unique __anon_N labels
  closureEnvPtrOff:      int64;   // rbp offset of __env_ptr__ in inner fn body (0 = not in closure)
  closureCapturedBuf:    int64;   // pchar array[32]: captured var name ptrs
  closureCapturedLenBuf: int64;   // int64 array[32]: captured var name lengths
  closureCapturedOutBuf: int64;   // int64 array[32]: outer rbp offsets of captured vars
  closureCapturedCount:  int64;   // number of captured variables
  localBase:             int64;   // cg_findLocal searches [localBase, localCount) only

  // Per-local array flag (WP-10b): byte buffer parallel to locals, 1 = array type
  localIsArray:      int64;
  localArraySize:    int64;  // WP-BC-51: int64 buffer, stores array length per local (0 = not array)
  // WP-3.1: byte buffer parallel to locals, 1 = @redundant var (TMR triple storage)
  localIsRedundant:  int64;
  // WP-GPU-01: byte buffer parallel to locals, 1 = parallel Array<f32> (SIMD)
  localIsSimd:       int64;
  // #1003: byte buffer parallel to locals, 1 = INLINE geschriebener fn-Zeigertyp
  // (`var f: fn(int64): int64`). Ueber einen Typalias merkt sich das die
  // fnAlias-Liste am Namen; ein inline geschriebener Typ HAT keinen Namen und
  // fiel deshalb in den Closure-Pfad, der {fnPtr,env} erwartet -> Absturz.
  localIsFnPtr:      int64;
  foldBuf:          int64;  // WP-10g: scratch for cg_tryFold constant-folding results

  // Temporary buffer tracking (BUG-02: prevent mmap leaks)
  // Each entry: {bufPtr:8, bufSize:8} = 16 bytes
  tempBufs:      int64;
  tempBufCount:  int64;
  tempBufCap:    int64;

  // WP-13: Captured variable table for nested functions
  // Each entry: {outerFuncPtr:8, outerFuncLen:8, varNamePtr:8, varNameLen:8, offset:8} = 40 bytes
  capturedVars:      int64;
  capturedCount:     int64;
  capturedCap:       int64;

  // Global variable table: {namePtr:8, nameLen:8, dataOff:8} = 24 bytes per entry
  globalVars:     int64;
  globalVarCount: int64;
  globalVarCap:   int64;
  globalIsPchar:  int64;  // byte buffer parallel to globalVars: 1 = pchar type
  // #1094: deklarierter Typname je globaler Variable {ptr:8, len:8}, parallel
  // zu globalVars. Ohne ihn waere der statische Typ einer globalen Variablen
  // im Codegen nicht bestimmbar — `g is int64` muesste dann melden statt zu
  // antworten.
  globalTypeNames: int64;
  // #1094: Laenge des zuletzt von cg_staticTypeName gelieferten Typnamens.
  stnLen:         int64;

  // WP-BC-40: Compile-time profiling entry table (x86_64 only)
  // Entry: {namePtr:8 (src ptr), nameLen:8, dataOff:8, nameDataOff:8} = 32 bytes
  // dataOff → data section: tsc_start(8) + call_count(8) + total_cycles(8) = 24 bytes
  // nameDataOff → data section: name string (for profile_report output)
  profEntries:    int64;
  profEntryCount: int64;
  profEntryCap:   int64;

  // WP-BC-25: DWARF debug info generation
  debugMode:   int64;
  srcFilePath: pchar;
  srcFileLen:  int64;

  // WP-BC-48: --runtime-checks — emit bounds/null/zero checks inline
  runtimeChecks: int64;

  // WP-CS-07: @io_check / @overflow_check runtime flags
  ioCheckEnabled:       int64;  // 0=off (default), 1=on
  overflowCheckEnabled: int64;  // 0=off (default), 1=on

  // WP-CS-09: cached data offset of the io_error message string; -1 = not yet emitted
  ioCheckMsgOff: int64;

  // WP-CS-10: cached data offset of the overflow error message string; -1 = not yet emitted
  overflowMsgOff: int64;

  // WP-EN-01: energy levels — 0 = not set (codegen will default to 3)
  globalEnergyLevel: int64;  // from CLI --target-energy
  fnEnergyLevel:     int64;  // effective for current function

  // WP-AS-04/05: @bounds_check / @debug_info / @optimization_level scope flags
  boundsCheckEnabled: int64;  // 1=on (default 1), 0=off
  debugInfoEnabled:   int64;  // set by @debug_info(true) — aliases debugMode
  optLevel:           int64;  // 0=none, 1=min, 2=default, 3=aggressive

  // WP-AS-10: defer emission buffer (LIFO)
  deferBuf:   int64;  // mmap'd int64 array of node indices
  deferCount: int64;
  deferCap:   int64;

  // Verschachtelte fn-Deklarationen, die nach der äußeren Funktion emittiert
  // werden. Inline emittiert liefe die äußere Funktion in den Rumpf hinein.
  nestedBuf:   int64;
  nestedCount: int64;
  nestedCap:   int64;

  // WP-04: set to 1 when current function has a [T, T] tuple return type
  funcHasTupleReturn: int64;

  // Import search paths (mirrors sema's includePath/stdPath)
  // Set by lyxc after CLI parsing / env-var reading
  includePath: int64;  // pchar to extra include dir, 0 = not set
  stdPath:     int64;  // pchar to stdlib root, 0 = not set

  // WP-LIC-10: license watermark — set by lyxc after successful verification
  licenseKey:    int64;   // pchar to 29-char key (e.g. "WXDHJ-NFZ18-…"), 0 = no watermark
  licenseKeyLen: int64;   // always 29 when set

  // WP-MEM-05: top-level AST head for default-param lookup in cg_genCall
  topLevelHead: int64;

  // WP-R9: seccomp-BPF
  lcbsCapBuf:     int64;  // alloc'd int64[64]: collected capIds
  lcbsCapCount:   int64;
  lcbsBpfDataOff: int64;  // data section offset of BPF instructions (-1 = disabled)
  lcbsBpfCount:   int64;  // number of BPF instructions
  lcbsEnabled:    int64;  // 1 if any @capabilities annotation found → install seccomp

  // WP-R10: Landlock
  lcbsLandlockHandled:    int64;  // handled_access_fs bitmask für landlock_create_ruleset
  lcbsLandlockAllowed:    int64;  // allowed_access für "/" Regel (0 = keine fs-Caps)
  lcbsLandlockHasDev:     int64;  // 1 wenn Hardware-Caps → /dev-Regel
  lcbsLandlockDevAllowed: int64;  // allowed_access für "/dev" Regel

  // WP-R11: Userspace-Netzwerk-Proxy
  lcbsProxyEnabled:    int64;  // 1 wenn Netzwerk-Proxy-Caps vorhanden
  lcbsProxyBpfDataOff: int64;  // Daten-Offset des Proxy-BPF-Filters
  lcbsProxyBpfCount:   int64;  // Anzahl Proxy-BPF-Befehle
  lcbsProxyCodeOff:    int64;  // Code-Offset der proxy_loop-Funktion
  lcbsProxyFdDataOff:  int64;  // Daten-Offset für proxy_fd-Speicher (4 Bytes)

  // WP-H12: Hardware-Capability-Argumente und Gerätepfad-Offsets
  lcbsHwArgBuf:     int64;  // alloc'd [capId(8), arg0(8), arg1(8)] × 32 Einträge = 768 Bytes
  lcbsHwArgCount:   int64;
  lcbsHwDevPathOff: int64;  // alloc'd int64[32]: Datensektion-Offsets der Gerätepfad-Strings

  // WP-T13: Audit-Daten (gesammelt in cg_collectCaps)
  lcbsMissingGrants:  int64;  // Anzahl Imports ohne explizites grant
  lcbsFastpathCount:  int64;  // Anzahl @fastpath-Nutzungen
  lcbsAuditSrcPath:   pchar;  // Quell-Dateipfad (gesetzt von lyxc.lyx vor Generate)

  // WP-T14: --capabilities=compat: kein seccomp/landlock/proxy trotz @capabilities
  lcbsCompatMode:     int64;  // 1 = Compat-Modus aktiv (gesetzt von lyxc.lyx)
  // WP-25: Runtime-Warnung im generierten Binary
  lcbsCompatWarnOff:  int64;  // Daten-Offset der Warnung (-1 = nicht gesetzt)
  lcbsCompatWarnLen:  int64;  // Länge der Warnung in Bytes
  // WP-6: W^X — 1 wenn zwei PT_LOAD-Segmente (RX + RW) emittiert werden
  lcbsWxActive:       int64;

  // WP-34: overflow flags — set when code/data buffer exceeds 512 MB limit
  codeOverflow: int64;
  dataOverflow: int64;

  // ------------------------------------------------------------------
  // Raw byte emitters (code buffer)
  // ------------------------------------------------------------------

  fn cg_trackTempBuf(buf: int64, size: int64) {
    if (self.tempBufCount >= self.tempBufCap) {
      var nc: int64 := self.tempBufCap * 2;
      var nb: int64 := alloc(nc * 16);
      var i: int64 := 0;
      memcpy(nb, self.tempBufs, self.tempBufCount * 16);
      if (self.tempBufs != 0) { free(self.tempBufs, self.tempBufCap * 16); }
      self.tempBufs := nb;
      self.tempBufCap := nc;
    }
    var base: int64 := self.tempBufs + self.tempBufCount * 16;
    poke64(base,     buf);
    poke64(base + CG_TEMPBUF_OFF_SIZE, size);
    self.tempBufCount += 1;
  }

  fn cg_freeAllTempBufs() {
    var i: int64 := 0;
    while (i < self.tempBufCount) {
      var base: int64 := self.tempBufs + i * 16;
      var buf:  int64 := peek64(base);
      var size: int64 := peek64(base + CG_TEMPBUF_OFF_SIZE);
      free(buf, size);
      i += 1;
    }
    self.tempBufCount := 0;
  }

  fn cg_grow() {
    var nc: int64 := self.codeCap * 2;
    // WP-34: 512 MB limit — prevents OOM via crafted large inputs
    if (nc > 536870912) {
      EPrintStrLn("error: codegen: Codepuffer überschreitet 512-MB-Limit"c);
      self.codeOverflow := 1;
      return;
    }
    var nb: int64 := alloc(nc);
    var i: int64 := 0;
    memcpy(nb, self.code, self.codeLen);
    self.code := nb; self.codeCap := nc;
  }

  fn cg_e8(b: int64) {
    // WP-34: stop writing if code buffer overflow was detected
    if (self.codeOverflow != 0) { return; }
    if (self.codeLen >= self.codeCap) { self.cg_grow(); }
    poke8(self.code + self.codeLen, b & 255);
    self.codeLen += 1;
  }

  fn cg_e32(n: int64) {
    self.cg_e8(n); self.cg_e8(n >> 8); self.cg_e8(n >> 16); self.cg_e8(n >> 24);
  }

  fn cg_e64(n: int64) {
    self.cg_e32(n); self.cg_e32(n >> 32);
  }

  // ------------------------------------------------------------------
  // Data buffer emitter
  // ------------------------------------------------------------------

  fn cg_growData() {
    var nc: int64 := self.dataCap * 2;
    // WP-34: 512 MB limit for data buffer as well
    if (nc > 536870912) {
      EPrintStrLn("error: codegen: Datenpuffer überschreitet 512-MB-Limit"c);
      self.dataOverflow := 1;
      return;
    }
    var nb: int64 := alloc(nc);
    var i: int64 := 0;
    memcpy(nb, self.data, self.dataLen);
    self.data := nb; self.dataCap := nc;
  }

  fn cg_edata(b: int64) {
    // WP-34: stop writing if data buffer overflow was detected
    if (self.dataOverflow != 0) { return; }
    if (self.dataLen >= self.dataCap) { self.cg_growData(); }
    poke8(self.data + self.dataLen, b & 255);
    self.dataLen += 1;
  }

  // ------------------------------------------------------------------
  // Node accessors (prefixed cg_ to avoid VMT collision with Parser)
  // ------------------------------------------------------------------

  fn cg_noff(i: int64): int64   { return self.pNodes + i * 88; }
  fn cg_nkind(i: int64): int64  { return peek64(self.cg_noff(i) + CG_OFF_KIND); }
  fn cg_nc0(i: int64): int64    { return peek64(self.cg_noff(i) + CG_OFF_C0); }
  fn cg_nc1(i: int64): int64    { return peek64(self.cg_noff(i) + CG_OFF_C1); }
  fn cg_nc2(i: int64): int64    { return peek64(self.cg_noff(i) + CG_OFF_C2); }
  fn cg_nc3(i: int64): int64    { return peek64(self.cg_noff(i) + CG_OFF_C3); }
  fn cg_nnext(i: int64): int64  { return peek64(self.cg_noff(i) + CG_OFF_NEXT); }
  fn cg_nival(i: int64): int64  { return peek64(self.cg_noff(i) + CG_OFF_IVAL); }
  fn cg_nsoff(i: int64): int64  { return peek64(self.cg_noff(i) + CG_OFF_SVAL); }
  fn cg_nslen(i: int64): int64  { return peek64(self.cg_noff(i) + CG_OFF_SLEN); }
  fn cg_nsval(i: int64): pchar  { return self.pSrc + self.cg_nsoff(i); }

  // ------------------------------------------------------------------
  // String comparison (length-delimited)
  // ------------------------------------------------------------------

  fn cg_seq(a: pchar, an: int64, b: pchar, bn: int64): bool {
    if (an != bn) { return false; }
    var i: int64 := 0;
    while (i < an) {
      if (StrCharAt(a, i) != StrCharAt(b, i)) { return false; }
      i += 1;
    }
    return true;
  }

  // ------------------------------------------------------------------
  // Local variable table  (name, nameLen, rbpOff) × CG_LOCAL_SZ bytes
  // ------------------------------------------------------------------

  fn cg_addLocal(name: pchar, nlen: int64): int64 {
    if (self.localCount >= self.localCap) {
      var nc: int64 := self.localCap * 2;
      var nb: int64 := alloc(nc * CG_LOCAL_SZ);
      var i: int64 := 0;
      memcpy(nb, self.locals, self.localCount * CG_LOCAL_SZ);
      self.locals := nb;
      var tb: int64 := alloc(nc * 16);
      i := 0;
      memcpy(tb, self.localTypes, self.localCount * 16);
      self.localTypes := tb;
      var ab: int64 := alloc(nc);
      i := 0;
      memcpy(ab, self.localIsArray, self.localCount);
      self.localIsArray := ab;
      var sb: int64 := alloc(nc * 8);
      i := 0;
      memcpy(sb, self.localArraySize, self.localCount * 8);
      self.localArraySize := sb;
      // WP-3.1: grow redundant flag buffer
      var rb: int64 := alloc(nc);
      i := 0;
      memcpy(rb, self.localIsRedundant, self.localCount);
      self.localIsRedundant := rb;
      var simdb: int64 := alloc(nc);
      i := 0;
      memcpy(simdb, self.localIsSimd, self.localCount);
      self.localIsSimd := simdb;
      var fpb: int64 := alloc(nc);
      i := 0;
      memcpy(fpb, self.localIsFnPtr, self.localCount);
      self.localIsFnPtr := fpb;
      self.localCap := nc;
    }
    self.frameSize += 8;
    var off: int64 := self.locals + self.localCount * CG_LOCAL_SZ;
    poke64(off,                       name as int64);
    poke64(off + CG_LOCAL_OFF_NAMELEN, nlen);
    poke64(off + CG_LOCAL_OFF_RBPOFF,  0 - self.frameSize);
    // Zero the type entry for this new local
    var toff: int64 := self.localTypes + self.localCount * CG_LOCTYPE_SZ;
    poke64(toff,                   0);
    poke64(toff + CG_LOCTYPE_OFF_LEN, 0);
    poke8(self.localIsArray      + self.localCount, 0);
    poke64(self.localArraySize   + self.localCount * 8, 0);
    poke8(self.localIsRedundant  + self.localCount, 0);  // WP-3.1
    poke8(self.localIsSimd       + self.localCount, 0);  // WP-GPU-01
    poke8(self.localIsFnPtr      + self.localCount, 0);  // #1003
    self.localCount += 1;
    return 0 - self.frameSize;
  }

  fn cg_findLocal(name: pchar, nlen: int64): int64 {
    var i: int64 := self.localCount - 1;
    while (i >= self.localBase) {  // WP-02: respect localBase for closure inner fn scope
      var base: int64 := self.locals + i * CG_LOCAL_SZ;
      var sname: pchar := peek64(base) as pchar;
      var slen:  int64 := peek64(base + CG_LOCAL_OFF_NAMELEN);
      if (self.cg_seq(sname, slen, name, nlen)) { return peek64(base + CG_LOCAL_OFF_RBPOFF); }
      i -= 1;
    }
    return 0;  // 0 = not found (valid offsets are always negative)
  }

  // Returns index (0-based) of local by name, or -1 if not found
  // #1091: Klassenindex der gerade erzeugten Klasse (fuer `super`).
  fn cg_curClassIdx(): int64 {
    if (self.curClassName == 0 as pchar) { return 0 - 1; }
    return self.cg_findClass(self.curClassName, self.curClassNameLen);
  }

  // #1091: Lokale Variable ueber ihren Namen nach rax laden.
  fn cg_loadLocalByName(name: pchar, nlen: int64): void {
    var li: int64 := self.cg_findLocalIdx(name, nlen);
    if (li < 0) { self.cg_zeroRax(); return; }
    self.cg_loadRax(peek64(self.locals + li * CG_LOCAL_SZ + CG_LOCAL_OFF_RBPOFF));
  }

  fn cg_findLocalIdx(name: pchar, nlen: int64): int64 {
    var i: int64 := self.localCount - 1;
    while (i >= self.localBase) {  // WP-02: respect localBase
      var base: int64 := self.locals + i * CG_LOCAL_SZ;
      var sname: pchar := peek64(base) as pchar;
      var slen:  int64 := peek64(base + CG_LOCAL_OFF_NAMELEN);
      if (self.cg_seq(sname, slen, name, nlen)) { return i; }
      i -= 1;
    }
    return -1;
  }

  // WP-3.1: TMR helpers

  fn cg_isLocalRedundant(idx: int64): int64 {
    if (idx < 0) { return 0; }
    return peek8(self.localIsRedundant + idx) as int64;
  }

  // Emit inline x86_64 majority vote for three copies at offA, offB, offC (rbp-relative).
  // Algorithm:
  //   load rax=A, rdx=B, rcx=C
  //   if B==C: if A==B: done (all equal, result=A)
  //            else:    result=B, self-heal A  (B is majority)
  //   else:    result=A  (A==B, A==C, or triple mismatch → keep A)
  // Always uses 32-bit rbp displacement forms for predictable encoding.
  fn cg_emitTmrRead(offA: int64, offB: int64, offC: int64) {
    // WP-B1: Full majority-vote with self-heal for all 3 single-fault cases.
    // Layout: A=offA (lowest addr, &var+0), B=offB (&var+8), C=offC (&var+16)
    // Result lands in rax. Heals the minority copy.
    //
    // Byte map (all off32 loads/stores, 7 bytes each):
    //  [0]  mov rax,[rbp+offA]   7   load A
    //  [7]  mov rdx,[rbp+offB]   7   load B
    // [14]  mov rcx,[rbp+offC]   7   load C
    // [21]  cmp rax,rdx          3   A==B?
    // [24]  je  a_eq_b          +17  → [43]
    // [26]  cmp rax,rcx          3   A==C?
    // [29]  je  a_eq_c          +26  → [57]
    // [31]  mov rax,rdx          3   A!=B,A!=C: use B (B==C or all differ), result=B
    // [34]  mov [rbp+offA],rax   7   heal A
    // [41]  jmp done            +21  → [64]
    // [43]  cmp rax,rcx          3   a_eq_b: A==B, check C
    // [46]  je  done            +16  → [64] (all same)
    // [48]  mov [rbp+offC],rax   7   A==B,C!=A: heal C
    // [55]  jmp done            + 7  → [64]
    // [57]  mov [rbp+offB],rax   7   a_eq_c: A==C, heal B
    // [64]  done
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x85); self.cg_e32(offA);  // mov rax,[rbp+offA]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x95); self.cg_e32(offB);  // mov rdx,[rbp+offB]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x8D); self.cg_e32(offC);  // mov rcx,[rbp+offC]
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xD0);                      // cmp rax,rdx
    self.cg_e8(0x74); self.cg_e8(0x11);                                         // je  a_eq_b (+17)
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);                      // cmp rax,rcx
    self.cg_e8(0x74); self.cg_e8(0x1A);                                         // je  a_eq_c (+26)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD0);                      // mov rax,rdx  (B→rax)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(offA);  // mov [rbp+offA],rax  heal A
    self.cg_e8(0xEB); self.cg_e8(0x15);                                         // jmp done (+21)
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);                      // a_eq_b: cmp rax,rcx
    self.cg_e8(0x74); self.cg_e8(0x10);                                         // je  done (+16, all same)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(offC);  // mov [rbp+offC],rax  heal C
    self.cg_e8(0xEB); self.cg_e8(0x07);                                         // jmp done (+7)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(offB);  // a_eq_c: mov [rbp+offB],rax  heal B
    // done: rax = majority value
  }

  // Global variable table helpers
  fn cg_addGlobal(name: pchar, nlen: int64): int64 {
    if (self.globalVarCount >= self.globalVarCap) {
      var nc: int64 := self.globalVarCap * 2;
      var nb: int64 := alloc(nc * 24);
      var np: int64 := alloc(nc);
      var nt: int64 := alloc(nc * 16);
      var i: int64 := 0;
      memcpy(nb, self.globalVars, self.globalVarCount * 24);
      i := 0;
      memcpy(np, self.globalIsPchar, self.globalVarCount);
      memcpy(nt, self.globalTypeNames, self.globalVarCount * 16);
      self.globalVars := nb; self.globalVarCap := nc; self.globalIsPchar := np;
      self.globalTypeNames := nt;
    }
    var doff: int64 := self.dataLen;
    // Reserve 8 zero bytes in data section (mmap is zero-initialized)
    var j: int64 := 0;
    while (j < 8) { self.cg_edata(0); j := j + 1; }
    var base: int64 := self.globalVars + self.globalVarCount * 24;
    poke64(base,      name as int64);
    poke64(base + CG_GLOBAL_OFF_NAMELEN,  nlen);
    poke64(base + CG_GLOBAL_OFF_DOFF, doff);
    poke8(self.globalIsPchar + self.globalVarCount, 0);
    poke64(self.globalTypeNames + self.globalVarCount * 16, 0);
    poke64(self.globalTypeNames + self.globalVarCount * 16 + 8, 0);
    self.globalVarCount += 1;
    return doff;
  }

  fn cg_findGlobal(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.globalVarCount) {
      var base: int64 := self.globalVars + i * 24;
      var gname: pchar := peek64(base) as pchar;
      var glen:  int64 := peek64(base + CG_GLOBAL_OFF_NAMELEN);
      if (self.cg_seq(gname, glen, name, nlen)) { return peek64(base + CG_GLOBAL_OFF_DOFF); }
      i += 1;
    }
    return -1;
  }

  fn cg_findGlobalIdx(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.globalVarCount) {
      var base: int64 := self.globalVars + i * 24;
      var gname: pchar := peek64(base) as pchar;
      var glen:  int64 := peek64(base + CG_GLOBAL_OFF_NAMELEN);
      if (self.cg_seq(gname, glen, name, nlen)) { return i; }
      i += 1;
    }
    return -1;
  }

  // mov rax, [rip+disp32]
  fn cg_loadRaxGlobal(dataOff: int64) {
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05);
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, dataOff, 0, CG_PATCH_STR);
  }

  // mov [rip+disp32], rax
  fn cg_storeRaxGlobal(dataOff: int64) {
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05);
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, dataOff, 0, CG_PATCH_STR);
  }

  // Returns 1 if the CGN_IDENT node ni refers to an array-typed local
  fn cg_identIsArray(ni: int64): int64 {
    if (self.cg_nkind(ni) != CGN_IDENT) { return 0; }
    var idx: int64 := self.cg_findLocalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
    if (idx < 0) { return 0; }
    return peek8(self.localIsArray + idx);
  }

  // Returns 1 if expression node ni produces a pchar value.
  // Covers: string literals, pchar-typed locals, known string-returning builtins,
  // and + binops where either operand is pchar (enabling chaining).
  fn cg_isPcharExpr(ni: int64): int64 {
    if (ni < 0) { return 0; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_LIT_STR) { return 1; }
    if (k == CGN_IDENT) {
      var idx: int64 := self.cg_findLocalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if (idx >= 0) {
        var tb: int64 := self.localTypes + idx * CG_LOCTYPE_SZ;
        var tp: pchar := peek64(tb) as pchar;
        var tl: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
        if (self.cg_seq(tp, tl, "pchar", 5)) { return 1; }
      }
      // pchar string constants (pub con NAME: pchar := "..."c)
      var cidx: int64 := self.cg_findConIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if (cidx >= 0) {
        if (peek8(self.conIsPchar + cidx) != 0) { return 1; }
      }
      return 0;
    }
    if (k == CGN_CALL) {
      var fp: pchar := self.cg_nsval(ni);
      var fl: int64 := self.cg_nslen(ni);
      if (self.cg_seq(fp, fl, "IntToStr",    8))  { return 1; }
      if (self.cg_seq(fp, fl, "StrFromInt",  10)) { return 1; }
      if (self.cg_seq(fp, fl, "StrConcat",   9))  { return 1; }
      if (self.cg_seq(fp, fl, "StrAppendStr",12)) { return 1; }
      if (self.cg_seq(fp, fl, "StrSub",      6))  { return 1; }
      if (self.cg_seq(fp, fl, "FloatToStr",  10)) { return 1; }
      if (self.cg_seq(fp, fl, "ArgvGetStr",  10)) { return 1; }
      return 0;
    }
    if (k == CGN_BINOP && self.cg_nival(ni) == CGT_PLUS) {
      if (self.cg_isPcharExpr(self.cg_nc0(ni)) != 0) { return 1; }
      if (self.cg_isPcharExpr(self.cg_nc1(ni)) != 0) { return 1; }
    }
    return 0;
  }

  // Emit StrConcat inline body. Assumes rdi=a, rsi=b on entry; result in rax.
  fn cg_emitStrConcatBody() {
    self.cg_e8(0x57);  // push rdi (a)
    self.cg_e8(0x56);  // push rsi (b)
    var sc1pp: int64 := self.cg_emitCall();
    poke32(self.code + sc1pp, CG_H_STRLEN - sc1pp - 4);
    self.cg_e8(0x50);  // push rax (len_a)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rdi, [rsp+8]=b
    var sc2pp: int64 := self.cg_emitCall();
    poke32(self.code + sc2pp, CG_H_STRLEN - sc2pp - 4);
    self.cg_e8(0x50);  // push rax (len_b)
    // [rsp]=len_b [rsp+8]=len_a [rsp+16]=b [rsp+24]=a
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x00);  // mov rsi,[rsp]=len_b
    self.cg_e8(0x48); self.cg_e8(0x03); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x08);  // add rsi,[rsp+8]=len_a
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC6); self.cg_e8(0x11);  // add rsi,17
    self.cg_e8(0x31); self.cg_e8(0xFF);  // xor edi,edi
    self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov edx,3
    self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9d,r9d
    self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov eax,9
    self.cg_e8(0x0F); self.cg_e8(0x05);  // syscall mmap → rax=buf
    self.cg_e8(0x50);  // push rax (buf)
    // [rsp]=buf [rsp+8]=len_b [rsp+16]=len_a [rsp+24]=b [rsp+32]=a
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x00);  // mov rdi,[rsp]=buf
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x20);  // mov rsi,[rsp+32]=a
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x4C); self.cg_e8(0x24); self.cg_e8(0x10);  // mov rcx,[rsp+16]=len_a
    self.cg_e8(0xF3); self.cg_e8(0xA4);  // rep movsb (copy a)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x18);  // mov rsi,[rsp+24]=b
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x4C); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rcx,[rsp+8]=len_b
    self.cg_e8(0xF3); self.cg_e8(0xA4);  // rep movsb (copy b)
    self.cg_e8(0xC6); self.cg_e8(0x07); self.cg_e8(0x00);  // mov byte[rdi],0 (null term)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0x24);  // mov rax,[rsp]=buf
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x28);  // add rsp,40
  }

  // WP-02: Find a closure-captured variable by name.
  // Returns env slot index (0-based), or -1 if not found.
  fn cg_findClosureCap(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.closureCapturedCount) {
      var capName: pchar := peek64(self.closureCapturedBuf + i * 8) as pchar;
      var capLen:  int64 := peek64(self.closureCapturedLenBuf + i * 8);
      if (self.cg_seq(capName, capLen, name, nlen)) { return i; }
      i += 1;
    }
    return -1;
  }

  // WP-02: Scan AST body for identifiers present in outer locals (captures).
  // Populates closureCaptured* arrays. Call BEFORE resetting localBase.
  fn cg_scanClosureCaptures(bodyNi: int64, paramNi: int64) {
    self.closureCapturedCount := 0;
    self._scanCap(bodyNi, paramNi);
  }

  fn _scanCap(ni: int64, paramNi: int64) {
    if (ni < 0) { return; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_IDENT) {
      var name: pchar := self.cg_nsval(ni);
      var nlen: int64 := self.cg_nslen(ni);
      // Check if it's one of the inner function's explicit params (skip those)
      var isParam: int64 := 0;
      var p: int64 := paramNi;
      while (p >= 0) {
        if (self.cg_seq(self.cg_nsval(p), self.cg_nslen(p), name, nlen)) { isParam := 1; }
        p := self.cg_nnext(p);
      }
      if (isParam == 0) {
        // Check if exists in OUTER locals (localBase = 0 for the lookup)
        var savedBase: int64 := self.localBase;
        self.localBase := 0;
        var outerOff: int64 := self.cg_findLocal(name, nlen);
        self.localBase := savedBase;
        if (outerOff != 0) {
          // Not already captured?
          if (self.cg_findClosureCap(name, nlen) < 0) {
            if (self.closureCapturedCount < 32) {
              var idx: int64 := self.closureCapturedCount;
              poke64(self.closureCapturedBuf + idx * 8, name as int64);
              poke64(self.closureCapturedLenBuf + idx * 8, nlen);
              poke64(self.closureCapturedOutBuf + idx * 8, outerOff);
              self.closureCapturedCount := idx + 1;
            }
          }
        }
      }
    }
    // Recurse into children and siblings (statement list)
    self._scanCap(self.cg_nc0(ni), paramNi);
    self._scanCap(self.cg_nc1(ni), paramNi);
    self._scanCap(self.cg_nc2(ni), paramNi);
    var nxt: int64 := self.cg_nnext(ni);
    if (nxt >= 0) { self._scanCap(nxt, paramNi); }
  }

  // WP-02: Build anonymous function label name: "__anon_N\0" in a heap buffer.
  // Returns pointer to null-terminated string, length stored in *outLen.
  fn cg_buildAnonName(idx: int64): pchar {
    var buf: int64 := alloc(32);
    // "__anon_" = 7 chars
    poke8(buf + 0, 95); poke8(buf + 1, 95);  // __
    poke8(buf + 2, 97); poke8(buf + 3, 110); // an
    poke8(buf + 4, 111); poke8(buf + 5, 110); // on
    poke8(buf + 6, 95);  // _
    // Decimal digits of idx
    var pos: int64 := 7;
    if (idx == 0) {
      poke8(buf + pos, 48); pos := pos + 1;
    } else {
      var tmp: int64 := alloc(24);
      var dcount: int64 := 0;
      var n: int64 := idx;
      while (n > 0) {
        poke8(tmp + dcount, (n & 0x7FFFFFFFFFFFFFFF) - ((n & 0x7FFFFFFFFFFFFFFF) / 10) * 10 + 48);
        n := n / 10;
        dcount += 1;
      }
      // digits are in reverse in tmp; copy forward
      var di: int64 := dcount - 1;
      while (di >= 0) {
        poke8(buf + pos, peek8(tmp + di) as int64);
        pos += 1;
        di -= 1;
      }
      free(tmp, 24);
    }
    poke8(buf + pos, 0);  // null terminator
    return buf as pchar;
  }

  // WP-13: Find captured variable from outer function's frame via static link
  // Returns the offset in the captured environment, or 0 if not found
  fn cg_findCapturedVar(name: pchar, nlen: int64): int64 {
    // Search the captured vars table for the current outer function
    var i: int64 := 0;
    while (i < self.capturedCount) {
      var base: int64 := self.capturedVars + i * CG_CAPTVAR_SZ;
      var funcPtr:  pchar := peek64(base) as pchar;
      var funcLen:  int64 := peek64(base + CG_CAPTVAR_OFF_FUNCLEN);
      var varPtr:   pchar := peek64(base + CG_CAPTVAR_OFF_VARPTR) as pchar;
      var varLen:   int64 := peek64(base + CG_CAPTVAR_OFF_VARLEN);
      var varOff:   int64 := peek64(base + CG_CAPTVAR_OFF_RBPOFF);
      // Match both outer function name and variable name
      if (funcLen == self.outerFuncNameLen &&
          self.cg_seq(funcPtr, funcLen, self.outerFuncName, self.outerFuncNameLen) &&
          varLen == nlen && self.cg_seq(varPtr, varLen, name, nlen)) {
        return varOff;
      }
      i += 1;
    }
    return 0;
  }

  // WP-13: Register a captured variable for the current outer function
  fn cg_addCapturedVar(varName: pchar, varLen: int64, off: int64) {
    // Check if already captured
    var i: int64 := 0;
    while (i < self.capturedCount) {
      var base: int64 := self.capturedVars + i * CG_CAPTVAR_SZ;
      var funcPtr:  pchar := peek64(base) as pchar;
      var funcLen:  int64 := peek64(base + CG_CAPTVAR_OFF_FUNCLEN);
      var varPtr:   pchar := peek64(base + CG_CAPTVAR_OFF_VARPTR) as pchar;
      var varLen2:  int64 := peek64(base + CG_CAPTVAR_OFF_VARLEN);
      if (funcLen == self.outerFuncNameLen &&
          self.cg_seq(funcPtr, funcLen, self.outerFuncName, self.outerFuncNameLen) &&
          varLen2 == varLen && self.cg_seq(varPtr, varLen2, varName, varLen)) {
        return;  // Already captured
      }
      i += 1;
    }
    // Grow table if needed
    if (self.capturedCount >= self.capturedCap) {
      var nc: int64 := self.capturedCap * 2;
      var nb: int64 := alloc(nc * 40);
      var j: int64 := 0;
      memcpy(nb, self.capturedVars, self.capturedCount * CG_CAPTVAR_SZ);
      free(self.capturedVars, self.capturedCap * CG_CAPTVAR_SZ);
      self.capturedVars := nb;
      self.capturedCap := nc;
    }
    var entry: int64 := self.capturedVars + self.capturedCount * CG_CAPTVAR_SZ;
    poke64(entry,      self.outerFuncName as int64);
    poke64(entry + CG_CAPTVAR_OFF_FUNCLEN,  self.outerFuncNameLen);
    poke64(entry + CG_CAPTVAR_OFF_VARPTR, varName as int64);
    poke64(entry + CG_CAPTVAR_OFF_VARLEN, varLen);
    poke64(entry + CG_CAPTVAR_OFF_RBPOFF, off);
    self.capturedCount += 1;
  }

  // ------------------------------------------------------------------
  // Label table  (name, nameLen, codeOff, lineNum) × CG_LABEL_SZ bytes
  // ------------------------------------------------------------------

  // WP-BC-49: compute source line of an AST node from its source offset
  fn cg_lineOf(ni: int64): int64 {
    var soff: int64 := self.cg_nsoff(ni);
    if (soff <= 0) { return 1; }
    var line: int64 := 1;
    var i: int64 := 0;
    while (i < soff) {
      if (StrCharAt(self.pSrc, i) == 10) { line := line + 1; }
      i += 1;
    }
    return line;
  }

  fn cg_addLabel(name: pchar, nlen: int64, lineNum: int64) {
    if (self.labelCount >= self.labelCap) {
      var nc: int64 := self.labelCap * 2;
      var nb: int64 := alloc(nc * CG_LABEL_SZ);
      var i: int64 := 0;
      memcpy(nb, self.labels, self.labelCount * CG_LABEL_SZ);
      self.labels := nb; self.labelCap := nc;
    }
    var base: int64 := self.labels + self.labelCount * CG_LABEL_SZ;
    poke64(base,      name as int64);
    poke64(base + CG_LABEL_OFF_NAMELEN,  nlen);
    poke64(base + CG_LABEL_OFF_CODEOFF, self.codeLen);
    poke64(base + CG_LABEL_OFF_LINENUM, lineNum);
    self.labelCount += 1;
  }

  fn cg_findLabel(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.labelCount) {
      var base: int64 := self.labels + i * CG_LABEL_SZ;
      var sname: pchar := peek64(base) as pchar;
      var slen:  int64 := peek64(base + CG_LABEL_OFF_NAMELEN);
      if (self.cg_seq(sname, slen, name, nlen)) { return peek64(base + CG_LABEL_OFF_CODEOFF); }
      i += 1;
    }
    return -1;
  }

  // ------------------------------------------------------------------
  // Module-level constant table  (namePtr, nameLen, value) × 24 bytes
  // Populated from CGN_CON_DECL nodes at module scope; used for identifier
  // resolution inside method bodies where only locals would otherwise work.
  // ------------------------------------------------------------------

  // WP-CS-05: public entry point to pre-seed conTable with compile-time constants
  pub fn AddBuiltinCon(name: pchar, val: int64): void {
    var _nlen: int64 := StrLen(name);
    self.cg_addCon(name, _nlen, val);
  }

  fn cg_addCon(name: pchar, nlen: int64, val: int64) {
    if (self.conCount >= self.conCap) {
      var nc: int64 := self.conCap * 2;
      var nb: int64 := alloc(nc * CG_CON_SZ);
      var np: int64 := alloc(nc);
      memcpy(nb, self.conTable, self.conCount * CG_CON_SZ);
      memcpy(np, self.conIsPchar, self.conCount);
      self.conTable := nb; self.conCap := nc; self.conIsPchar := np;
    }
    var base: int64 := self.conTable + self.conCount * CG_CON_SZ;
    poke64(base,                       name as int64);
    poke64(base + CG_CON_OFF_NAMELEN,  nlen);
    poke64(base + CG_CON_OFF_VAL,      val);
    poke8(self.conIsPchar + self.conCount, 0);
    self.conCount += 1;
  }

  fn cg_findConVal(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.conCount) {
      var base: int64 := self.conTable + i * CG_CON_SZ;
      var ename: pchar := peek64(base) as pchar;
      var elen:  int64 := peek64(base + CG_CON_OFF_NAMELEN);
      if (self.cg_seq(ename, elen, name, nlen) != 0) { return peek64(base + CG_CON_OFF_VAL); }
      i += 1;
    }
    return -1;
  }

  // Returns 1 if constant exists, 0 if not (avoids -1 sentinel confusion with FD_NONE=-1)
  fn cg_hasConVal(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.conCount) {
      var base: int64 := self.conTable + i * CG_CON_SZ;
      var ename: pchar := peek64(base) as pchar;
      var elen:  int64 := peek64(base + CG_CON_OFF_NAMELEN);
      if (self.cg_seq(ename, elen, name, nlen) != 0) { return 1; }
      i += 1;
    }
    return 0;
  }

  // Returns the index of a constant in conTable, or -1 if not found.
  fn cg_findConIdx(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.conCount) {
      var base: int64 := self.conTable + i * CG_CON_SZ;
      var ename: pchar := peek64(base) as pchar;
      var elen:  int64 := peek64(base + CG_CON_OFF_NAMELEN);
      if (self.cg_seq(ename, elen, name, nlen) != 0) { return i; }
      i += 1;
    }
    return -1;
  }

  // Add a pchar string constant: stores data offset in conTable and marks conIsPchar.
  fn cg_addConStr(name: pchar, nlen: int64, dataOff: int64) {
    self.cg_addCon(name, nlen, dataOff);
    poke8(self.conIsPchar + (self.conCount - 1), 1);
  }

  // Emit code to load a constant into rax.
  // For pchar string constants: emits lea rax,[rip+disp32] with a CG_PATCH_STR patch.
  // For int64 constants: emits mov rax, imm64.
  fn cg_emitConLoad(name: pchar, nlen: int64) {
    var idx: int64 := self.cg_findConIdx(name, nlen);
    if (idx < 0) { self.cg_zeroRax(); return; }
    var val: int64 := peek64(self.conTable + idx * CG_CON_SZ + CG_CON_OFF_VAL);
    if (peek8(self.conIsPchar + idx) != 0) {
      var pp: int64 := self.cg_emitLeaStr();
      self.cg_addPatch(pp, val, 0, CG_PATCH_STR);
    } else {
      self.cg_movRaxImm(val);
    }
  }

  // Evaluates a compile-time constant expression node and returns its int64 value.
  // Handles literals, unary minus/not, and binary arithmetic/bitwise/comparison ops.
  // Used by cg_genFile to populate conTable for con declarations.
  fn cg_evalConExpr(node: int64): int64 {
    if (node < 0) { return 0; }
    var k: int64 := self.cg_nkind(node);
    if (k == CGN_LIT_INT) { return self.cg_nival(node); }
    if (k == CGN_LIT_FLOAT) {
      return self.cg_parseFloat(self.pSrc, self.cg_nsoff(node), self.cg_nslen(node));
    }
    if (k == CGN_IDENT) {
      return self.cg_findConVal(self.cg_nsval(node), self.cg_nslen(node));
    }
    if (k == CGN_UNOP) {
      var uop: int64 := self.cg_nival(node);
      var cv:  int64 := self.cg_evalConExpr(self.cg_nc0(node));
      if (uop == 87) { if (cv == 0) { return 1; } else { return 0; } }  // TK_NOT
      if (uop == 71) { return 0 - cv; }                                  // TK_MINUS
      return 0;
    }
    if (k == CGN_BINOP) {
      var bop: int64 := self.cg_nival(node);
      var lv:  int64 := self.cg_evalConExpr(self.cg_nc0(node));
      if (bop == 85) { if (lv == 0) { return 0; } return self.cg_evalConExpr(self.cg_nc1(node)); }  // TK_AND
      if (bop == 86) { if (lv != 0) { return 1; } return self.cg_evalConExpr(self.cg_nc1(node)); }  // TK_OR
      var rv: int64 := self.cg_evalConExpr(self.cg_nc1(node));
      if (bop == 70) { return lv + rv; }                                  // TK_PLUS
      if (bop == 71) { return lv - rv; }                                  // TK_MINUS
      if (bop == 72) { return lv * rv; }                                  // TK_STAR
      if (bop == 73) { if (rv == 0) { return 0; } return lv / rv; }      // TK_SLASH
      if (bop == 74) { if (rv == 0) { return 0; } return lv % rv; }      // TK_PERCENT
      if (bop == 89) { return lv ^ rv; }                                  // TK_BITXOR
      if (bop == 90) { return lv & rv; }                                  // TK_BITAND
      if (bop == 91) { return lv | rv; }                                  // TK_BITOR
      if (bop == 93) { return lv << rv; }                                 // TK_SHL
      if (bop == 94) { return lv >> rv; }                                 // TK_SHR
      if (bop == 79) { if (lv == rv) { return 1; } else { return 0; } }  // TK_EQ2 ==
      if (bop == 80) { if (lv != rv) { return 1; } else { return 0; } }  // TK_NEQ !=
      if (bop == 81) { if (lv < rv)  { return 1; } else { return 0; } }  // TK_LT  <
      if (bop == 82) { if (lv <= rv) { return 1; } else { return 0; } }  // TK_LE  <=
      if (bop == 83) { if (lv > rv)  { return 1; } else { return 0; } }  // TK_GT  >
      if (bop == 84) { if (lv >= rv) { return 1; } else { return 0; } }  // TK_GE  >=
      return 0;
    }
    if (k == CGN_CALL) {
      // sizeof(Type) in const expression context (BUG-5)
      var cfname: pchar := self.cg_nsval(node);
      var cfnlen: int64 := self.cg_nslen(node);
      if (self.cg_seq(cfname, cfnlen, "sizeof", 6)) {
        var soArg: int64 := self.cg_nc0(node);
        var soSize: int64 := 8;
        if (soArg >= 0) {
          var soName: pchar := self.cg_nsval(soArg);
          var soLen:  int64 := self.cg_nslen(soArg);
          var soClassIdx: int64 := self.cg_findClass(soName, soLen);
          if (soClassIdx >= 0) {
            var soCb: int64 := self.classLayouts + soClassIdx * CG_CLASS_SZ;
            var soFldCnt:   int64 := peek64(soCb + CG_CLASS_OFF_FIELDCNT);
            var soVmtSlots: int64 := peek64(soCb + CG_CLASS_OFF_VMTSLOTS);
            if (soVmtSlots > 0) {
              soSize := (soFldCnt + 1) * 8;
            } else {
              soSize := soFldCnt * 8;
            }
          }
        }
        return soSize;
      }
      return 0;
    }
    return 0;
  }

  fn cg_addBuiltinCons() {
    // mmap/file descriptor constants (Linux x86-64)
    self.cg_addCon("PROT_READ"c,    9,  1);
    self.cg_addCon("PROT_WRITE"c,   10, 2);
    self.cg_addCon("PROT_RW"c,      7,  3);
    self.cg_addCon("PROT_NONE"c,    9,  0);
    self.cg_addCon("MAP_SHARED"c,   10, 1);
    self.cg_addCon("MAP_PRIVATE"c,  11, 2);
    self.cg_addCon("MAP_ANONYMOUS"c,12, 32);
    self.cg_addCon("MAP_ANON"c,     8,  34);  // MAP_PRIVATE|MAP_ANONYMOUS
    self.cg_addCon("FD_NONE"c,      7,  -1);
    // O_* flags (file open modes)
    self.cg_addCon("O_RDONLY"c,  7, 0);
    self.cg_addCon("O_WRONLY"c,  7, 1);
    self.cg_addCon("O_RDWR"c,    6, 2);
    self.cg_addCon("O_CREAT"c,   7, 64);
    self.cg_addCon("O_TRUNC"c,   7, 512);
    self.cg_addCon("O_APPEND"c,  8, 1024);
    // Boolean
    self.cg_addCon("true"c,  4, 1);
    self.cg_addCon("false"c, 5, 0);
  }

  // ------------------------------------------------------------------
  // WP-10g: Constant Folding + Peephole CSE helpers
  // ------------------------------------------------------------------

  // mov rbx, imm64  (48 BB xx ... xx) — for const-LHS binop optimisation
  fn cg_movRbxImm(val: int64) {
    self.cg_e8(0x48); self.cg_e8(0xBB); self.cg_e64(val);
  }

  // Try to evaluate node ni as a compile-time integer constant.
  // Returns 1 if successful and stores the value in self.foldBuf; 0 otherwise.
  fn cg_tryFold(ni: int64): int64 {
    if (ni < 0) { return 0; }
    var k: int64 := self.cg_nkind(ni);
    // Integer / bool literal
    if (k == CGN_LIT_INT || k == CGN_LIT_BOOL) {
      self.foldBuf := self.cg_nival(ni);
      return 1;
    }
    // Named constant (con FOO = val)
    if (k == CGN_IDENT) {
      var nm: pchar := self.cg_nsval(ni);
      var nl: int64 := self.cg_nslen(ni);
      if (self.cg_findLocal(nm, nl) != 0) { return 0; }  // local var, not foldable
      if (self.cg_hasConVal(nm, nl) == 0) { return 0; }  // not in con-table
      self.foldBuf := self.cg_findConVal(nm, nl);        // value may be -1, valid
      return 1;
    }
    // Unary: -const, !const, ~const
    if (k == CGN_UNOP) {
      if (self.cg_tryFold(self.cg_nc0(ni)) == 0) { return 0; }
      var uop: int64 := self.cg_nival(ni);
      if (uop == CGT_MINUS)  { self.foldBuf := 0 - self.foldBuf; return 1; }
      if (uop == CGT_NOT)    { if (self.foldBuf == 0) { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (uop == CGT_BITNOT) { self.foldBuf := -1 - self.foldBuf; return 1; }
      return 0;
    }
    // Binary: both sides must fold
    if (k == CGN_BINOP) {
      if (self.cg_tryFold(self.cg_nc0(ni)) == 0) { return 0; }
      var lv: int64 := self.foldBuf;
      if (self.cg_tryFold(self.cg_nc1(ni)) == 0) { return 0; }
      var rv: int64 := self.foldBuf;
      var bop: int64 := self.cg_nival(ni);
      if (bop == CGT_PLUS)    { self.foldBuf := lv + rv;  return 1; }
      if (bop == CGT_MINUS)   { self.foldBuf := lv - rv;  return 1; }
      if (bop == CGT_STAR)    { self.foldBuf := lv * rv;  return 1; }
      if (bop == CGT_SLASH)   { if (rv == 0) { return 0; } self.foldBuf := lv / rv; return 1; }
      if (bop == CGT_PERCENT) { if (rv == 0) { return 0; } self.foldBuf := lv % rv; return 1; }
      if (bop == CGT_EQ2)  { if (lv == rv) { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_NEQ)  { if (lv != rv) { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_LT)   { if (lv < rv)  { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_LE)   { if (lv <= rv) { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_GT)   { if (lv > rv)  { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_GE)   { if (lv >= rv) { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_AND)  { if (lv != 0 && rv != 0) { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_OR)   { if (lv != 0 || rv != 0) { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_BITAND) { self.foldBuf := lv & rv; return 1; }
      if (bop == CGT_BITOR)  { self.foldBuf := lv | rv; return 1; }
      if (bop == CGT_SHL)    { self.foldBuf := lv << rv; return 1; }
      if (bop == CGT_SHR)    { self.foldBuf := lv >> rv; return 1; }
      return 0;
    }
    return 0;
  }

  // ------------------------------------------------------------------
  // Patch table  (codeOff, namePtr, nameLen, kind) × CG_PATCH_SZ
  // For CG_PATCH_STR: namePtr = dataOff (int64 cast as ptr), nameLen = 0
  // ------------------------------------------------------------------

  fn cg_addPatch(codeOff: int64, namePtr: int64, nlen: int64, kind: int64) {
    if (self.patchCount >= self.patchCap) {
      var nc: int64 := self.patchCap * 2;
      var nb: int64 := alloc(nc * CG_PATCH_SZ);
      var i: int64 := 0;
      memcpy(nb, self.patches, self.patchCount * CG_PATCH_SZ);
      self.patches := nb; self.patchCap := nc;
    }
    var base: int64 := self.patches + self.patchCount * CG_PATCH_SZ;
    poke64(base,      codeOff);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  namePtr);
    poke64(base + CG_PATCH_OFF_NAMELEN, nlen);
    poke64(base + CG_PATCH_OFF_KIND, kind);
    self.patchCount += 1;
  }

  // Record a declared extern (lookup only — no GOT slot until it is called).
  fn cg_addExternDecl(namePtr: pchar, nlen: int64, libPtr: int64, liblen: int64) {
    if (self.externDeclCount >= self.externDeclCap) {
      var nc: int64 := self.externDeclCap * 2;
      var nb: int64 := alloc(nc * CG_EXTERN_SZ);
      var i: int64 := 0;
      memcpy(nb, self.externDecls, self.externDeclCount * CG_EXTERN_SZ);
      self.externDecls := nb; self.externDeclCap := nc;
    }
    var base: int64 := self.externDecls + self.externDeclCount * CG_EXTERN_SZ;
    poke64(base,      namePtr as int64);
    poke64(base + CG_EXTERN_OFF_NAMELEN,  nlen);
    poke64(base + CG_EXTERN_OFF_LIBPTR, libPtr);
    poke64(base + CG_EXTERN_OFF_LIBLEN, liblen);
    self.externDeclCount += 1;
  }

  // Find a declared extern by name; returns its index in externDecls or -1.
  fn cg_findExternDecl(namePtr: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.externDeclCount) {
      var b: int64 := self.externDecls + i * CG_EXTERN_SZ;
      if (self.cg_seq(peek64(b) as pchar, peek64(b + CG_EXTERN_OFF_NAMELEN), namePtr, nlen)) { return i; }
      i += 1;
    }
    return -1;
  }

  // FFI import table: find an extern symbol by name, or register it.
  fn cg_findExtern(namePtr: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.externCount) {
      var b: int64 := self.externSyms + i * CG_EXTERN_SZ;
      if (self.cg_seq(peek64(b) as pchar, peek64(b + CG_EXTERN_OFF_NAMELEN), namePtr, nlen)) { return i; }
      i += 1;
    }
    return -1;
  }

  fn cg_addExtern(namePtr: pchar, nlen: int64, libPtr: int64, liblen: int64): int64 {
    var ex: int64 := self.cg_findExtern(namePtr, nlen);
    if (ex >= 0) { return ex; }
    if (self.externCount >= self.externCap) {
      var nc: int64 := self.externCap * 2;
      var nb: int64 := alloc(nc * CG_EXTERN_SZ);
      var i: int64 := 0;
      memcpy(nb, self.externSyms, self.externCount * CG_EXTERN_SZ);
      self.externSyms := nb; self.externCap := nc;
    }
    var base: int64 := self.externSyms + self.externCount * CG_EXTERN_SZ;
    poke64(base,      namePtr as int64);
    poke64(base + CG_EXTERN_OFF_NAMELEN,  nlen);
    poke64(base + CG_EXTERN_OFF_LIBPTR, libPtr);
    poke64(base + CG_EXTERN_OFF_LIBLEN, liblen);
    var idx: int64 := self.externCount;
    self.externCount += 1;
    return idx;
  }

  // WSP-07: externes Daten-Symbol (extern "asm") suchen / registrieren.
  fn cg_findExternDataIdx(namePtr: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.externDataCount) {
      var b: int64 := self.externData + i * 16;
      if (self.cg_seq(peek64(b) as pchar, peek64(b + 8), namePtr, nlen)) { return i; }
      i += 1;
    }
    return -1;
  }

  fn cg_addExternData(namePtr: pchar, nlen: int64): int64 {
    var ex: int64 := self.cg_findExternDataIdx(namePtr, nlen);
    if (ex >= 0) { return ex; }
    if (self.externDataCount >= self.externDataCap) {
      var nc: int64 := self.externDataCap * 2;
      var nb: int64 := alloc(nc * 16);
      memcpy(nb, self.externData, self.externDataCount * 16);
      self.externData := nb; self.externDataCap := nc;
    }
    var base: int64 := self.externData + self.externDataCount * 16;
    poke64(base,     namePtr as int64);
    poke64(base + 8, nlen);
    var idx: int64 := self.externDataCount;
    self.externDataCount += 1;
    return idx;
  }

  // WSP-07: lea rax, [rip+disp32] auf ein externes Daten-Symbol. disp32 bleibt 0 und
  // wird NICHT in cg_patchAll aufgelöst — cg_writeELFObj erzeugt daraus R_X86_64_PC32.
  fn cg_emitExternDataAddr(name: pchar, nlen: int64) {
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);   // lea rax, [rip+disp32]
    var pos: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pos, name as int64, nlen, CG_PATCH_EXTERN_DATA);
  }

  fn cg_patchAll() {
    var i: int64 := 0;
    while (i < self.patchCount) {
      var base: int64 := self.patches + i * CG_PATCH_SZ;
      var codeOff: int64 := peek64(base);
      var namePtr: int64 := peek64(base + CG_PATCH_OFF_NAMEPTR);
      var nlen:    int64 := peek64(base + CG_PATCH_OFF_NAMELEN);
      var kind:    int64 := peek64(base + CG_PATCH_OFF_KIND);
      if (kind == CG_PATCH_CALL) {
        var targetOff: int64 := self.cg_findLabel(namePtr as pchar, nlen);
        if (targetOff >= 0) {
          var rel32: int64 := targetOff - codeOff - 4;
          poke32(self.code + codeOff, rel32);
        } else {
          EPrintStr("error: undefined function '"c);
          sys_write(2, namePtr, nlen);
          EPrintStr("' — no codegen implementation found\n"c);
          exit(1);
        }
      } else if (kind == CG_PATCH_EXTERN) {
        // FFI call disp32 — resolved in cg_writeELFDynamic once the GOT
        // virtual address is known. Nothing to do here.
      } else if (kind == CG_PATCH_EXTERN_DATA) {
        // WSP-07: externes Daten-Symbol — nur im ET_REL-Objektmodus auflösbar (via ld).
        // In einem normalen Executable gibt es keinen Linker → fail-closed.
        if (self.objMode == 0) {
          EPrintStr("error: extern \"asm\" '"c);
          sys_write(2, namePtr, nlen);
          EPrintStr("' benoetigt --emit=obj (Linker-aufgeloestes Symbol)\n"c);
          exit(1);
        }
        // disp32 bleibt 0 → wird in cg_writeELFObj zu R_X86_64_PC32.
      } else {
        // CG_PATCH_STR: namePtr encodes data offset
        var dataOff: int64 := namePtr;
        var disp32: int64 := self.codeLen - codeOff - 4 + dataOff;
        poke32(self.code + codeOff, disp32);
      }
      i += 1;
    }
    // WP-10a: patch VMT address placeholders
    // vmtVaddr = CG_ELF_BASE + CG_CODE_OFF + codeLen + vmtDataOff
    var vmtBase: int64 := CG_ELF_BASE + CG_CODE_OFF + self.codeLen;
    var j: int64 := 0;
    while (j < self.vmtPatchCount) {
      var vbase: int64 := self.vmtPatches + j * CG_VMT_PATCH_SZ;
      var codeOff2:  int64 := peek64(vbase);
      var namePtr2: pchar   := peek64(vbase + CG_PATCH_OFF_NAMEPTR) as pchar;
      var nameLen2:  int64 := peek64(vbase + CG_PATCH_OFF_NAMELEN);
      var classIdx: int64 := self.cg_findClass(namePtr2, nameLen2);
      if (classIdx >= 0) {
        var cb: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
        var vmtDataOff: int64 := peek64(cb + CG_CLASS_OFF_VMTOFF);
        poke64(self.code + codeOff2, vmtBase + vmtDataOff);
        // WP-A2.2: the movabs imm64 just written is an absolute pointer → base reloc.
        self.cg_addBaseReloc(CG_CODE_OFF + codeOff2);
      }
      j += 1;
    }
    // WP-BC-19: fill VMT method slots with method code virtual addresses
    // Method code vaddr = CG_ELF_BASE + CG_CODE_OFF + methodCodeStart
    var codeBase: int64 := CG_ELF_BASE + CG_CODE_OFF;
    var mp: int64 := 0;
    while (mp < self.vmtMethodPatchCount) {
      var mpBase: int64 := self.vmtMethodPatches + mp * CG_VMT_METH_PATCH_SZ;
      var slotDataOff:  int64 := peek64(mpBase);
      var methCodeStart: int64 := peek64(mpBase + CG_VMT_METH_OFF_CODESTART);
      poke64(self.data + slotDataOff, codeBase + methCodeStart);
      // WP-A2.2: VMT slot holds an absolute code pointer (data RVA = code + codeLen + off).
      self.cg_addBaseReloc(CG_CODE_OFF + self.codeLen + slotDataOff);
      mp += 1;
    }
    // WP-BC-L2: propagate inherited (non-overridden) vtable slots base→derived.
    // Own/overridden slots were filled above (non-zero code vaddr); slots still 0
    // are inherited and copied from the parent vtable. Declaration order guarantees
    // each parent is fully resolved before its children (incl. multi-level chains).
    var ciP: int64 := 0;
    while (ciP < self.classCount) {
      var cbpP: int64 := self.classLayouts + ciP * CG_CLASS_SZ;
      var parIdxP: int64 := peek64(cbpP + CG_CLASS_OFF_PARENTIDX);
      var myOffP: int64 := peek64(cbpP + CG_CLASS_OFF_VMTOFF);
      if (parIdxP >= 0 && myOffP >= 0) {
        var pbpP: int64 := self.classLayouts + parIdxP * CG_CLASS_SZ;
        var pOffP: int64 := peek64(pbpP + CG_CLASS_OFF_VMTOFF);
        var mySlotsP: int64 := peek64(cbpP + CG_CLASS_OFF_VMTSLOTS);
        var pSlotsP: int64 := peek64(pbpP + CG_CLASS_OFF_VMTSLOTS);
        if (pOffP >= 0) {
          var limP: int64 := pSlotsP;
          if (mySlotsP < limP) { limP := mySlotsP; }
          var sP: int64 := 0;
          while (sP < limP) {
            if (peek64(self.data + myOffP + sP * 8) == 0) {
              poke64(self.data + myOffP + sP * 8, peek64(self.data + pOffP + sP * 8));
              // WP-A2.2: inherited slot now holds an absolute code pointer → base reloc.
              self.cg_addBaseReloc(CG_CODE_OFF + self.codeLen + myOffP + sP * 8);
            }
            sP += 1;
          }
        }
      }
      ciP += 1;
    }
  }

  // ------------------------------------------------------------------
  // String data section
  // Copies source string (with escape processing) into data buffer.
  // sOff = offset in source of opening quote char '"'
  // sLen = raw token length including both quotes
  // Returns: offset within data buffer (for use in LEA disp32 patch)
  // ------------------------------------------------------------------

  fn cg_addStr(sOff: int64, sLen: int64): int64 {
    var doff: int64 := self.dataLen;
    var i: int64 := sOff + 1;          // skip opening '"'
    var eend: int64 := sOff + sLen - 1; // stop before closing '"'
    if (StrCharAt(self.pSrc, sOff + sLen - 1) == 99) { eend := eend - 1; } // pchar 'c' suffix
    while (i < eend) {
      var c: int64 := StrCharAt(self.pSrc, i);
      if (c == 92 && i + 1 < eend) {   // backslash
        var esc: int64 := StrCharAt(self.pSrc, i + 1);
        if (esc == 110) { self.cg_edata(10); }  // \n
        else if (esc == 114) { self.cg_edata(13); }  // \r
        else if (esc == 116) { self.cg_edata(9);  }  // \t
        else if (esc == 48)  { self.cg_edata(0);  }  // \0
        else { self.cg_edata(esc); }
        i += 2;
      } else {
        self.cg_edata(c);
        i += 1;
      }
    }
    self.cg_edata(0);  // null terminator
    return doff;
  }

  // ------------------------------------------------------------------
  // x86_64 instruction emitters
  // ------------------------------------------------------------------

  // mov rax, imm64   (10 bytes: 48 B8 + 8 byte LE)
  fn cg_movRaxImm(n: int64) {
    self.cg_e8(0x48); self.cg_e8(0xB8); self.cg_e64(n);
  }

  // mov [rbp+off], rax  (store rax at rbp-relative offset)
  fn cg_storeRax(off: int64) {
    if (off >= -128 && off <= 127) {
      // 48 89 45 off8
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x45); self.cg_e8(off);
    } else {
      // 48 89 85 off32
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(off);
    }
  }

  // mov [rbp+off], rdx  (store second tuple return value)
  fn cg_storeRdx(off: int64) {
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x55); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x95); self.cg_e32(off);
    }
  }

  // mov rax, [rbp+off]
  fn cg_loadRax(off: int64) {
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x45); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x85); self.cg_e32(off);
    }
  }

  // mov [rbp+off], rdi  (spill arg0 to stack)
  fn cg_spillRdi(off: int64) {
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x7D); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xBD); self.cg_e32(off);
    }
  }

  // mov [rbp+off], rsi  (spill arg1)
  fn cg_spillRsi(off: int64) {
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x75); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xB5); self.cg_e32(off);
    }
  }

  // mov [rbp+off], rdx  (spill arg2)
  fn cg_spillRdx(off: int64) {
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x55); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x95); self.cg_e32(off);
    }
  }

  // mov [rbp+off], rcx  (spill arg3)
  fn cg_spillRcx(off: int64) {
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x4D); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x8D); self.cg_e32(off);
    }
  }

  // mov [rbp+off], r8  (spill arg4)
  fn cg_spillR8(off: int64) {
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x45); self.cg_e8(off);
    } else {
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(off);
    }
  }

  // mov [rbp+off], r9  (spill arg5)
  fn cg_spillR9(off: int64) {
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x4D); self.cg_e8(off);
    } else {
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x8D); self.cg_e32(off);
    }
  }

  // lea rax, [rip + disp32]  — for string literals; disp32 is placeholder 0
  // Returns: position of disp32 in code buffer (for patching)
  fn cg_emitLeaStr(): int64 {
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
    var pos: int64 := self.codeLen;
    self.cg_e32(0);
    return pos;
  }

  // WP-12: Emit lea rcx, [rip+disp32] to access a data section global.
  // dataOff = CG_EXN_VAL (0) or CG_EXN_PTR (8). Adds a CG_PATCH_STR patch.
  fn cg_emitLeaRcxData(dataOff: int64) {
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x0D);  // lea rcx, [rip+disp32]
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, dataOff, 0, CG_PATCH_STR);
  }

  // WP-BC-01: lea rdi, [rip+disp32]  (48 8D 3D disp32)
  fn cg_emitLeaRdiData(dataOff: int64) {
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x3D);  // lea rdi, [rip+disp32]
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, dataOff, 0, CG_PATCH_STR);
  }

  // WP-BC-02: lea rax, [rip+disp32]  (48 8D 05 disp32)
  fn cg_emitLeaRaxData(dataOff: int64) {
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);  // lea rax, [rip+disp32]
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, dataOff, 0, CG_PATCH_STR);
  }

  // WP-CS-09: mov [rip+CG_IO_RESULT], rax  (48 89 05 disp32)
  fn cg_emitIoResultSave() {
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05);
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, CG_IO_RESULT, 0, CG_PATCH_STR);
  }

  // WP-CS-09: if rax < 0 (syscall error): panic with io error message
  fn cg_emitIoCheckPanic() {
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
    self.cg_e8(0x79);                                         // jns .ok
    var pSkip: int64 := self.codeLen;
    self.cg_e8(0);
    if (self.ioCheckMsgOff < 0) {
      self.ioCheckMsgOff := self.dataLen;
      // "lyxc: I/O error (use @io_check(false) to suppress)\n\0"
      self.cg_edata(108); self.cg_edata(121); self.cg_edata(120); self.cg_edata(99);   // lyxc
      self.cg_edata(58);  self.cg_edata(32);                                           // ": "
      self.cg_edata(73);  self.cg_edata(47);  self.cg_edata(79);  self.cg_edata(32);  // "I/O "
      self.cg_edata(101); self.cg_edata(114); self.cg_edata(114); self.cg_edata(111); self.cg_edata(114); // "error"
      self.cg_edata(32);                                                                // " "
      self.cg_edata(40);                                                                // "("
      self.cg_edata(117); self.cg_edata(115); self.cg_edata(101);                      // "use"
      self.cg_edata(32);                                                                // " "
      self.cg_edata(64);                                                                // "@"
      self.cg_edata(105); self.cg_edata(111); self.cg_edata(95);                       // "io_"
      self.cg_edata(99);  self.cg_edata(104); self.cg_edata(101); self.cg_edata(99); self.cg_edata(107); // "check"
      self.cg_edata(40);  self.cg_edata(102); self.cg_edata(97);  self.cg_edata(108); self.cg_edata(115); self.cg_edata(101); self.cg_edata(41); // "(false)"
      self.cg_edata(32);  self.cg_edata(116); self.cg_edata(111); self.cg_edata(32);  // " to "
      self.cg_edata(115); self.cg_edata(117); self.cg_edata(112); self.cg_edata(112); self.cg_edata(114); // "suppr"
      self.cg_edata(101); self.cg_edata(115); self.cg_edata(115);                      // "ess"
      self.cg_edata(41);                                                                // ")"
      self.cg_edata(10);                                                                // "\n"
      self.cg_edata(0);                                                                 // NUL
    }
    self.cg_emitLeaRdiData(self.ioCheckMsgOff);
    self.cg_emitPanicBody();
    // .ok:
    poke8(self.code + pSkip, (self.codeLen - pSkip - 1) & 255);
  }

  // WP-CS-10: if OF is set (signed overflow): panic with overflow message
  fn cg_emitOverflowPanic() {
    self.cg_e8(0x71);                                               // jno .ok
    var pSkip: int64 := self.codeLen;
    self.cg_e8(0);
    if (self.overflowMsgOff < 0) {
      self.overflowMsgOff := self.dataLen;
      // "lyxc: integer overflow detected\n\0"
      self.cg_edata(108); self.cg_edata(121); self.cg_edata(120); self.cg_edata(99);   // lyxc
      self.cg_edata(58);  self.cg_edata(32);                                           // ": "
      self.cg_edata(105); self.cg_edata(110); self.cg_edata(116); self.cg_edata(101); // "inte"
      self.cg_edata(103); self.cg_edata(101); self.cg_edata(114); self.cg_edata(32);  // "ger "
      self.cg_edata(111); self.cg_edata(118); self.cg_edata(101); self.cg_edata(114); // "over"
      self.cg_edata(102); self.cg_edata(108); self.cg_edata(111); self.cg_edata(119); // "flow"
      self.cg_edata(32);                                                                // " "
      self.cg_edata(100); self.cg_edata(101); self.cg_edata(116); self.cg_edata(101); // "dete"
      self.cg_edata(99);  self.cg_edata(116); self.cg_edata(101); self.cg_edata(100); // "cted"
      self.cg_edata(10);  self.cg_edata(0);                                            // "\n\0"
    }
    self.cg_emitLeaRdiData(self.overflowMsgOff);
    self.cg_emitPanicBody();
    // .ok:
    poke8(self.code + pSkip, (self.codeLen - pSkip - 1) & 255);
  }

  // WP-12: Emit longjmp code. rax must hold jmp_buf base pointer.
  // Restores rbx, rbp, r12..r15; sets rsp=rax; then jmp [rsp+56] (catch label).
  fn cg_genLongjmp() {
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x18);                     // mov rbx, [rax]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x68); self.cg_e8(0x08);  // mov rbp, [rax+8]
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x60); self.cg_e8(0x10);  // mov r12, [rax+16]
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x68); self.cg_e8(0x18);  // mov r13, [rax+24]
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x70); self.cg_e8(0x20);  // mov r14, [rax+32]
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x78); self.cg_e8(0x28);  // mov r15, [rax+40]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC4);                     // mov rsp, rax
    self.cg_e8(0xFF); self.cg_e8(0x64); self.cg_e8(0x24); self.cg_e8(0x38);  // jmp [rsp+56]
  }

  // WP-BC-01: Emit inline panic body — rdi must hold the message pointer.
  // Writes message to stderr then exits(1) (or longjmps if handler is installed).
  fn cg_emitPanicBody() {
    self.cg_emitLeaRcxData(CG_EXN_VAL);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x39);                                                             // mov [rcx], rdi
    self.cg_e8(0x57);                                                                                                   // push rdi
    var ppSL: int64 := self.cg_emitCall();
    poke32(self.code + ppSL, CG_H_STRLEN - ppSL - 4);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2);                                                             // mov rdx, rax
    self.cg_e8(0x5F);                                                                                                   // pop rdi
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xFE);                                                             // mov rsi, rdi
    self.cg_e8(0xBF); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);                       // mov edi, 2
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);                       // mov eax, 1
    self.cg_e8(0x0F); self.cg_e8(0x05);                                                                                // syscall (write)
    self.cg_emitLeaRcxData(CG_EXN_PTR);
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);                                                             // mov rax, [rcx]
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);                                                             // test rax, rax
    self.cg_e8(0x0F); self.cg_e8(0x84);
    var pNH: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_genLongjmp();
    poke32(self.code + pNH, self.codeLen - pNH - 4);
    self.cg_movRaxImm(1);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);                                                             // mov rdi, rax
    self.cg_movRaxImm(60);
    self.cg_e8(0x0F); self.cg_e8(0x05);                                                                                // syscall (exit)
    self.cg_zeroRax();
  }

  // WP-BC-39: Print int64 in rdi to stderr as decimal, followed by "\n".
  // Clobbers: rax, rcx, rdx, rsi.  Uses a 32-byte stack buffer.
  fn cg_emitInspectPrintInt() {
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x20);                    // sub rsp, 32
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x1F); // lea rsi, [rsp+31]
    self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x0A);                                      // mov byte [rsi], '\n'
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);                                      // dec rsi
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF8);                                      // mov rax, rdi
    // test rax,rax; jnz .nonzero (+8)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);                                      // test rax, rax
    self.cg_e8(0x75); self.cg_e8(0x08);                                                         // jnz +8
    self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x30);                                      // mov byte [rsi], '0'
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);                                      // dec rsi
    self.cg_e8(0xEB); self.cg_e8(0x30);                                                         // jmp .emit (+48)
    // .nonzero: test rax,rax; jge .positive (+3)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);                                      // test rax, rax
    self.cg_e8(0x7D); self.cg_e8(0x03);                                                         // jge +3
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xD8);                                      // neg rax
    // .digitloop: test rax,rax; jz .sign (+24)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);                                      // test rax, rax
    self.cg_e8(0x74); self.cg_e8(0x18);                                                         // jz +24
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);                                      // xor rdx, rdx
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1);
    self.cg_e8(0x0A); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);                   // mov rcx, 10
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);                                      // idiv rcx
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC2); self.cg_e8(0x30);                   // add rdx, '0'
    self.cg_e8(0x88); self.cg_e8(0x16);                                                         // mov [rsi], dl
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);                                      // dec rsi
    self.cg_e8(0xEB); self.cg_e8(0xE3);                                                         // jmp .digitloop (-29)
    // .sign: test rdi,rdi; jns .emit (+6)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);                                      // test rdi, rdi
    self.cg_e8(0x79); self.cg_e8(0x06);                                                         // jns +6
    self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x2D);                                      // mov byte [rsi], '-'
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);                                      // dec rsi
    // .emit: inc rsi; lea rdx,[rsp+31]; sub rdx,rsi; inc rdx
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC6);                                      // inc rsi
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x1F); // lea rdx, [rsp+31]
    self.cg_e8(0x48); self.cg_e8(0x29); self.cg_e8(0xF2);                                      // sub rdx, rsi
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC2);                                      // inc rdx  (+1 for '\n')
    self.cg_e8(0xBF); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov edi, 2 (stderr)
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 1 (sys_write)
    self.cg_e8(0x0F); self.cg_e8(0x05);                                                         // syscall
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x20);                   // add rsp, 32
  }

  // WP-BC-40: Print int64 in rdi as decimal to stderr, NO newline.
  // Same as cg_emitInspectPrintInt but omits the trailing '\n'.
  fn cg_emitStderrInt() {
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x20);                    // sub rsp, 32
