        // WP-GPU-01: check if both operands are parallel Array<f32> locals → SSE2 binop
        var sLN: pchar := self.cg_nsval(lhsNi);
        var sLL: int64 := self.cg_nslen(lhsNi);
        var sRN: pchar := self.cg_nsval(rhsNi);
        var sRL: int64 := self.cg_nslen(rhsNi);
        var sLI: int64 := self.cg_findLocalIdx(sLN, sLL);
        var sRI: int64 := self.cg_findLocalIdx(sRN, sRL);
        if (sLI >= 0 && sRI >= 0 &&
            peek8(self.localIsSimd + sLI) != 0 &&
            peek8(self.localIsSimd + sRI) != 0) {
          // #2199: Elementbreite beider Seiten. Weichen sie ab, ist das ein
          // Typfehler, den sema melden muss — hier wird nicht geraten,
          // sondern die linke Seite genommen und der Fall laut gemeldet.
          var simdOpBytes: int64 := self.cg_simdBytesOf(sLI);
          if (simdOpBytes != self.cg_simdBytesOf(sRI)) {
            EPrintStrLn("error: codegen: Vektoroperation mit verschiedenen Elementbreiten (#2199)."c);
            EPrintStrLn("  Beide Seiten muessen dieselbe Elementart haben (f32 mit f32, f64 mit f64)."c);
            exit(1);
          }
          // #2247: und dieselbe ART. Breite allein unterscheidet f32 nicht
          // von int32; eine Gleitkommaoperation auf Ganzzahl-Bitmustern war
          // genau der zweite stille Fehler aus #2199.
          if (self.cg_simdGanzOf(sLI) != self.cg_simdGanzOf(sRI)) {
            EPrintStrLn("error: codegen: Vektoroperation mit Gleitkomma auf der einen und Ganzzahl auf der anderen Seite (#2247)."c);
            exit(1);
          }
          var simdOpKennung: int64 := simdOpBytes;
          if (self.cg_simdGanzOf(sLI) != 0) { simdOpKennung := simdOpKennung | CG_SIMD_GANZ; }
          // Both are SIMD locals — emit vectorized SSE2 loop
          var sLO: int64 := self.cg_findLocal(sLN, sLL);
          var sRO: int64 := self.cg_findLocal(sRN, sRL);
          // load lhs SIMD ptr → rdi
          if (sLO >= -128 && sLO <= -1) {
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x45); self.cg_e8(sLO);
          } else {
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x85); self.cg_e32(sLO);
          }
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);  // mov rdi, rax
          // load rhs SIMD ptr → rsi
          if (sRO >= -128 && sRO <= -1) {
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x45); self.cg_e8(sRO);
          } else {
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x85); self.cg_e32(sRO);
          }
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);  // mov rsi, rax
          // rcx = element count from ptr-8: mov rcx, [rdi-8]  (48 8B 4F F8)
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x4F); self.cg_e8(0xF8);
          // save src ptrs and count across the dst allocation syscall
          self.cg_e8(0x51);  // push rcx
          self.cg_e8(0x57);  // push rdi
          self.cg_e8(0x56);  // push rsi
          // #2206: Ergebnisablage aus dem Bump-Allokator. Hier stand ein
          // eigener mmap-Syscall — in einer Schleife also einer JE
          // OPERATION, und nie zurueckgegeben. Dieselbe Folge wie in
          // cg_emitSimdBumpAlloc; die beiden muessen uebereinstimmen.
          // #2213: Zuerst die vorhandene Ablage des Zieles pruefen. Sie ist
          // brauchbar, wenn ihr Zeiger gesetzt ist UND ihre Elementzahl mit
          // der der linken Seite uebereinstimmt. Beides muss zur Laufzeit
          // geprueft werden:
          //   - der Zeiger ist 0, solange `var c: parallel Array<f32>;` noch
          //     nichts angelegt hat — dort hineinzuschreiben waere ein
          //     Zugriff auf Adresse 0;
          //   - die Laenge steht in der Ablage (bei ptr-8), nicht im Typ.
          //     Eine kuerzere Zielablage wuerde ueberschrieben, eine laengere
          //     behielte hinten alte Werte und meldete trotzdem ihre Laenge.
          // Trifft eine der beiden Bedingungen nicht, wird wie bisher
          // angelegt. Kein stiller Fall: beide Zweige rechnen dasselbe.
          //
          // Dass Ziel und Quelle dasselbe Feld sein koennen (`a := a + b`),
          // ist unkritisch — gerechnet wird elementweise aufsteigend, Lese-
          // und Schreibstelle sind in jedem Schritt dieselben Indizes.
          self.cg_emitSimdZielAblage(simdOpBytes);   // #2213, #2222
