  // Import resolution (WP-09)
  // ------------------------------------------------------------------

  // Read a file into an mmap buffer (null-terminated). Returns null on error.
  fn cg_readFile(path: pchar): pchar {
    var fd: int64 := open(path, 0, 0);
    if (fd < 0) { return 0 as pchar; }
    var size: int64 := lseek(fd, 0, 2);
    if (size <= 0) { close(fd); return 0 as pchar; }
    lseek(fd, 0, 0);
    var buf: int64 := alloc(size + 1);
    // WP-27: partieller/fehlgeschlagener Read → Fehler statt Arena-Müll als Quelle.
    var bytesRead: int64 := read(fd, buf as pchar, size);
    if (bytesRead != size) { close(fd); return 0 as pchar; }
    poke8(buf + size, 0);
    close(fd);
    // #1971: Pfad merken (Kopie — der Aufrufer gibt seinen Puffer frei).
    var lpl: int64 := StrLen(path);
    var lpb: int64 := alloc(lpl + 1);
    memcpy(lpb, path as int64, lpl + 1);
    self.cgLesePfad := lpb;
    return buf as pchar;
  }

  // Returns 1 if module name was already imported, 0 otherwise.
  fn cg_hasImported(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.importCount) {
      var base: int64 := self.importNames + i * CG_IMPORT_SZ;
      var p: pchar    := peek64(base) as pchar;
      var n: int64    := peek64(base + CG_PATCH_OFF_NAMEPTR);
      if (n == nameLen && self.cg_seq(p, n, name, nameLen)) { return 1; }
      i += 1;
    }
    return 0;
  }

  // Mark a module as imported (add to dedup set).
  fn cg_markImported(name: pchar, nameLen: int64) {
    self.zlImpN += 1;   // #2174
    if (self.importCount >= self.importCap) {
      var nc: int64 := self.importCap * 2;
      var nb: int64 := alloc(nc * 16);
      var i: int64 := 0;
      memcpy(nb, self.importNames, self.importCount * CG_IMPORT_SZ);
      self.importNames := nb;
      self.importCap   := nc;
    }
    var base: int64 := self.importNames + self.importCount * CG_IMPORT_SZ;
    poke64(base,      name as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  nameLen);
    self.importCount += 1;
  }

  // Try to read `relPath` relative to `base` (base + "/" + relPath).
  // Returns null pchar on failure; caller owns the returned buffer.
  fn cg_tryReadWithBase(base: pchar, relPath: pchar): pchar {
    var baseLen: int64 := StrLen(base);
    var relLen:  int64 := StrLen(relPath);
    var tryLen:  int64 := baseLen + 1 + relLen + 1;
    var tryBuf:  int64 := alloc(tryLen);
    memcpy(tryBuf, base as int64, baseLen);
    var i: int64 := baseLen;
    StrSetChar(tryBuf as pchar, i, 47); i := i + 1;
    memcpy(tryBuf + i, relPath as int64, relLen);
    poke8(tryBuf + i + relLen, 0);
    var src: pchar := self.cg_readFile(tryBuf as pchar);
    free(tryBuf, tryLen);
    return src;
  }

  // #1966: Zu einem `.lyx`-Pfad die danebenliegende `.lyu` finden — in
  // derselben Reihenfolge, in der auch die Quelle gesucht wurde: erst neben
  // der uebersetzten Datei, dann includePath, dann stdPath. Liefert 0, wenn
  // es keine gibt. Der Puffer bleibt stehen; er lebt nur bis zum Abbruch.
  fn cg_lyuPfadZu(relLyx: pchar): int64 {
    var rl: int64 := StrLen(relLyx);
    if (rl < 4) { return 0; }
    // ".lyx" gegen ".lyu" tauschen.
    var rel: int64 := alloc(rl + 1);
    memcpy(rel, relLyx as int64, rl);
    poke8(rel + rl - 1, 117);       // 'u'
    poke8(rel + rl, 0);
    // #2142: -I ist eine Liste (':' als Trenner, #1736) — jeder Teil einzeln.
    var basen: int64 := alloc(66 * 8);
    var n: int64 := 0;
    if (self.includePath != 0) {
      var incT: int64 := 0;
      var incW: int64 := 1;
      while (incW == 1 && n < 64) {
        var teil: int64 := alloc(1024);
        if (IncludePfadTeil(self.includePath as pchar, incT, teil, 1024) < 0) { incW := 0; }
        else { poke64(basen + n * 8, teil); n := n + 1; incT := incT + 1; }
      }
    }
    if (self.stdPath != 0)     { poke64(basen + n * 8, self.stdPath);     n := n + 1; }
    var i: int64 := 0;
    while (i < n) {
      var b: pchar := peek64(basen + i * 8) as pchar;
      var bl: int64 := StrLen(b);
      var voll: int64 := alloc(bl + 1 + rl + 1);
      memcpy(voll, b as int64, bl);
      poke8(voll + bl, 47);
      memcpy(voll + bl + 1, rel, rl);
      poke8(voll + bl + 1 + rl, 0);
      var fd: int64 := open(voll as pchar, 0, 0);
      if (fd >= 0) { close(fd); free(basen, 66 * 8); return voll; }
      free(voll, bl + 1 + rl + 1);
      i := i + 1;
    }
    free(basen, 66 * 8);
    // Zuletzt der Pfad, wie er dasteht (relativ zum Arbeitsverzeichnis).
    var fd2: int64 := open(rel as pchar, 0, 0);
    if (fd2 >= 0) { close(fd2); return rel; }
    free(rel, rl + 1);
    return 0;
  }

  // #1971/#2142: Was eine .lyu ohne Quelle mitbringt, hier eintragen:
  //   * Ressourcen (ResourceOffset) — Name `unit:name` mit dem Importnamen,
  //     die Bytes aus dem Dateipuffer (der lebt bis zum Ende, siehe oben).
  //   * Enum-Varianten (Anhang Art 1) — als Enum-Layout UND als Konstanten
  //     der Mitglieder, wie es der CGN_ENUM_DECL-Zweig fuer eine Quelle tut.
  fn cg_lyuAnhangUebernehmen(lr: LyuReader, d: int64, size: int64, modName: pchar, nameLen: int64) {
    var rn: int64 := lr.LyrResCount();
    if (rn > 0) {
      var nb: int64 := alloc(8); var nlb: int64 := alloc(8);
      var db: int64 := alloc(8); var dlb: int64 := alloc(8);
      var r: int64 := 0;
      while (r < rn) {
        if (lr.LyrResAt(r, nb, nlb, db, dlb)) {
          var rnp: pchar := peek64(nb) as pchar;
          var rnl: int64 := peek64(nlb);
          // Ein Name MIT ':' stammt aus einer Quell-Unit, die die .lyu selbst
          // importiert hat — er traegt seine Herkunft schon.
          var hatDp: int64 := 0;
          var q: int64 := 0;
          while (q < rnl) { if (StrCharAt(rnp, q) == 58) { hatDp := q + 1; } q := q + 1; }
          if (hatDp > 0) {
            self.cg_addResourceBytes(rnp as int64, hatDp - 1, (rnp as int64 + hatDp) as pchar,
                                     rnl - hatDp, peek64(db), peek64(dlb));
          } else {
            self.cg_addResourceBytes(modName as int64, nameLen, rnp, rnl, peek64(db), peek64(dlb));
          }
        }
        r := r + 1;
      }
      free(nb, 8); free(nlb, 8); free(db, 8); free(dlb, 8);
    }
    var lb: int64 := alloc(8);
    var off: int64 := LyuAnhang(d, size, LYU_ANH_ENUMS, lb);
    var ende: int64 := off + peek64(lb);
    free(lb, 8);
    if (off < 0) { return; }
    var n: int64 := LyuU32(d, off);
    var p: int64 := off + 4;
    var i: int64 := 0;
    while (i < n) {
      var enl: int64 := LyuStrLen(d, p, ende);
      if (enl < 0) { return; }
      var enp: int64 := d + p + 2;
      p := p + 2 + enl;
      if (p + 4 > ende) { return; }
      var mn: int64 := LyuU32(d, p);
      p := p + 4;
      if (mn < 0 || mn > 0x3FFFFFFF) { return; }
      var vars: int64 := alloc((mn + 1) * 32);
      var w: int64 := 0;
      while (w < mn) {
        var ml: int64 := LyuStrLen(d, p, ende);
        if (ml < 0 || p + 2 + ml + 8 > ende) { return; }
        var vb: int64 := vars + w * 32;
        var wert: int64 := LyuI64(d, p + 2 + ml);
        poke64(vb, d + p + 2);
        poke64(vb + CG_EVAR_OFF_NAMELEN, ml);
        poke64(vb + CG_EVAR_OFF_TAGVAL, wert);
        poke64(vb + CG_EVAR_OFF_PAYLOADSZ, 0);
        if (self.cg_findConIdx((d + p + 2) as pchar, ml) < 0) {
          self.cg_addCon((d + p + 2) as pchar, ml, wert);
        }
        p := p + 2 + ml + 8;
        w := w + 1;
      }
      if (self.cg_findEnum(enp as pchar, enl) < 0) {
        if (self.enumCount >= self.enumCap) {
          var nc: int64 := self.enumCap * 2;
          var neu: int64 := alloc(nc * 32);
          memcpy(neu, self.enumLayouts, self.enumCount * 32);
          self.enumLayouts := neu;
          self.enumCap := nc;
        }
        var base: int64 := self.enumLayouts + self.enumCount * 32;
        poke64(base, enp);
        poke64(base + CG_PATCH_OFF_NAMEPTR, enl);
        poke64(base + CG_ENUM_OFF_VARSPTR, vars);
        poke64(base + CG_CLASS_OFF_FIELDCNT, mn);
        self.enumCount += 1;
      }
      i := i + 1;
    }
  }

  // Process an import: find the .lyx file, parse it, codegen it.
  // Temporarily swaps pSrc/pNodes to the imported file's data.
  fn cg_processImport(modName: pchar, nameLen: int64) {
    self.cg_processImportAs(modName, nameLen, 0, 0);
  }

  // #2174: Zeitmessung der Importverarbeitung, nur die aeusserste Ebene
  // (cg_processImportAsKern ruft sich ueber Unter-Importe selbst auf).
  fn cg_processImportAs(modName: pchar, nameLen: int64, alias: int64, aliasLen: int64) {
    if (self.zlAktiv == 0) { self.cg_processImportAsKern(modName, nameLen, alias, aliasLen); return; }
    self.zlTiefe += 1;
    var t0: int64 := 0;
    if (self.zlTiefe == 1) { t0 := cg_zlJetztNs(); }
    self.cg_processImportAsKern(modName, nameLen, alias, aliasLen);
    if (self.zlTiefe == 1) { self.zlImpNs += cg_zlJetztNs() - t0; }
    self.zlTiefe -= 1;
  }

  // #1262: wie cg_processImport, aber mit Namensraum.
  fn cg_processImportAsKern(modName: pchar, nameLen: int64, alias: int64, aliasLen: int64) {
    if (self.cg_hasImported(modName, nameLen) != 0) { return; }
    self.cg_markImported(modName, nameLen);
    // Der Alias gilt nur fuer DIESE Unit. Was sie selbst importiert, wird beim
    // rekursiven Aufruf mit dessen eigenem Alias verarbeitet.
    var cgaSaved:    int64 := self.cgAlias;
    var cgaSavedLen: int64 := self.cgAliasLen;
    self.cgAlias    := alias;
    self.cgAliasLen := aliasLen;
    if (alias != 0 && self.cgAliasTabCount < 256) {
      poke64(self.cgAliasTab + self.cgAliasTabCount * 16, alias);
      poke64(self.cgAliasTab + self.cgAliasTabCount * 16 + 8, aliasLen);
      self.cgAliasTabCount := self.cgAliasTabCount + 1;
    }

    // WP-7a: ".." als Modulkomponente verbieten
    // WP-33: `wptd7 + 1 < nameLen` avoids underflow when nameLen == 0
    var wptd7: int64 := 0;
    while wptd7 + 1 < nameLen {
      if ((StrCharAt(modName, wptd7) & 255) == 46 && (StrCharAt(modName, wptd7 + 1) & 255) == 46) {
        EPrintStr("codegen error: import path traversal verboten: "c);
        EPrintStrLn(modName);
        self.cgAlias := cgaSaved; self.cgAliasLen := cgaSavedLen;   // #1262
        return;
      }
      wptd7 += 1;
    }

    // Convert "bootstrap.parser" → "bootstrap/parser.lyx"
    var pathBuf: int64 := alloc(nameLen + 8);
    var i: int64 := 0;
    while (i < nameLen) {
      var c: int64 := StrCharAt(modName, i);
      if (c == 46) { c := 47; }  // '.' → '/'
      poke8(pathBuf + i, c);
      i += 1;
    }
    var lyxExtCG: pchar := ".lyx";
    memcpy(pathBuf + nameLen, lyxExtCG as int64, 5);

    var path: pchar := pathBuf as pchar;
    self.cgLesePfad := 0;   // #1971: gleich steht hier die gefundene Datei
    var src: pchar := self.cg_readFile(path);

    // Fall back to includePath (LYX_PATH / -I) then stdPath (LYX_STD_PATH / --std-path)
    if (src == 0 as pchar && self.includePath != 0) {
      // #1736: mehrere -I-Pfade, ':' als Trenner. Der Codegen liest die
      // Importe ein zweites Mal selbst und braucht deshalb dieselbe Schleife
      // wie sema — sonst findet sema die Unit und der Codegen bricht danach
      // mit "undefined function" ab, also weit weg von der Ursache.
      var cgIncTeil: int64 := alloc(1024);
      var cgIncNr:   int64 := 0;
      var cgWeiter:  int64 := 1;
      while (cgWeiter == 1) {
        var cgLen: int64 := IncludePfadTeil(self.includePath as pchar, cgIncNr, cgIncTeil, 1024);
        if (cgLen < 0) { cgWeiter := 0; }
        else {
          src := self.cg_tryReadWithBase(cgIncTeil as pchar, path);
          if (src != 0 as pchar) { cgWeiter := 0; }
          cgIncNr := cgIncNr + 1;
        }
      }
    }
    if (src == 0 as pchar && self.stdPath != 0) {
      src := self.cg_tryReadWithBase(self.stdPath as pchar, path);
    }
    // #1368: zuletzt der Installationspfad des Pakets — dieselbe Stufe, die
    // sema kennt. Sie muss hier WIEDERHOLT werden, weil der Codegen die
    // Importe ein zweites Mal selbst liest; ohne sie fand sema die Unit und
    // der Codegen brach danach mit "cannot read import" ab. Bewusst zuletzt:
    // im Arbeitsverzeichnis gewinnen weiterhin dessen eigene Units.
    // #2201: entfaellt bei gesetztem --std-path, wie in sema und ir_lower.
    // Die vier Aufloesestellen muessen uebereinstimmen; sonst findet der eine
    // Weg die Unit und der andere nicht, und das Ergebnis haengt davon ab,
    // welcher zuerst fragt.
    if (src == 0 as pchar && self.stdPath == 0) {
      src := self.cg_tryReadWithBase("/usr/include/lyx/units"c, path);
    }

    var srcSize: int64 := 0;
    if (src != 0 as pchar) { srcSize := StrLen(src); }
    // #2014 Stufen 2–4: Deklarationstext einer .lyu (0 = keiner) und ihr Leser
    // fuer den Layoutabgleich nach dem Erzeugen.
    var lyuText: int64 := 0;
    var lyuTextLen: int64 := 0;
    var lyuRdr: LyuReader;
    var lyuFehltNm: int64 := 0;      // erstes Symbol, das nichts beschreibt
    var lyuFehltNl: int64 := 0;

    if (src == 0 as pchar) {
      // #1966: Hier wurde bis 1.2.3A nur GEMELDET und weitergemacht. Die
      // Auswirkung war still und gefaehrlich: sema hatte die Unit ueber die
      // `.lyu` aufgeloest, der Codegen ueberging sie — und jede Konstante
      // daraus kam als 0 an. Kein Fehler, kein Abbruch, das Programm lief und
      // rechnete falsch. Ein Schwellwert, eine Puffergroesse oder ein
      // Zeitlimit aus einer solchen Konstante faellt genau so aus, wie es
      // nicht auffaellt.
      //
      // Eine `.lyu` traegt NAMEN und TYPEN, aber weder Werte noch Code. Sie
      // kann eine Uebersetzung deshalb nicht allein tragen; fehlt die Quelle,
      // ist das ein Fehler und keine Randnotiz.
      // #1966: Erst nachsehen, ob die Unit ueberhaupt ETWAS beitraegt.
      //
      // Eine `.lyu` mit symCount = 0 deklariert nichts — dann fehlt auch
      // nichts, und der Import ist folgenlos. Genau diesen Fall fuehrt
      // tests/sec_wp35_lyu_symcount_test.sh (Pruefung 5) als GUELTIG. Ein
      // pauschaler Abbruch waere hier eine Verschaerfung ueber den Defekt
      // hinaus: gemeldet werden muss, wo etwas VERLOREN geht.
      var lyuPfad: int64 := self.cg_lyuPfadZu(path);
      var traegtSymbole: int64 := 1;
      if (lyuPfad != 0) {
        var lfd: int64 := open(lyuPfad as pchar, 0, 0);
        if (lfd >= 0) {
          var lsz: int64 := lseek(lfd, 0, 2);
          lseek(lfd, 0, 0);
          if (lsz > 0) {
            var lbuf: int64 := alloc(lsz);
            var gel: int64 := 0;
            var abbruch: int64 := 0;
            while (gel < lsz && abbruch == 0) {
              var rn: int64 := read(lfd, (lbuf + gel) as pchar, lsz - gel);
              if (rn <= 0) { abbruch := 1; } else { gel := gel + rn; }
            }
            if (abbruch == 0) {
              // #1971: dieselbe Schranke wie alle .lyu-Leser.
              if (lsz > LYU_MAX_BYTES) { LyuZuGross(lyuPfad as pchar, lsz); }
              var lr: LyuReader := new LyuReader();
              if (lr.LyrInit(lbuf, lsz)) {
                // #1971/#2142: Ressourcen und Enum-Varianten der .lyu. Vor der
                // Frage, ob etwas fehlt: eine Unit, die NUR Ressourcen (oder
                // nur Enums) traegt, verliert ohne Quelle nichts mehr.
                self.cg_lyuAnhangUebernehmen(lr, lbuf, lsz, modName, nameLen);
                if (lr.symCount == 0) { traegtSymbole := 0; }
                // #2014 Stufe 1: Traegt die `.lyu` NUR Konstanten und stehen
                // deren Werte darin, dann geht ohne die Quelle nichts
                // verloren — die Werte werden hier eingetragen, und der
                // Abbruch entfaellt.
                //
                // Die Bedingung ist bewusst eng: sobald EIN Symbol kein
                // `con` ist (eine Funktion braucht Code, ein Struct sein
                // Layout — Stufen 3 und 5), bleibt es beim Abbruch. Wer sie
                // aufweicht, bekommt genau das zurueck, wovor die Meldung
                // darunter warnt: still eine 0.
                else {
                  // Zuerst die Werte eintragen, DANN pruefen, ob noch etwas
                  // fehlt: ein Symbol, das der Abschnitt liefert, ist danach
                  // bekannt und geht nicht verloren.
                  var kn: int64 := lr.LyrKonCount();
                  var kNm:  int64 := alloc(8); var kNmL: int64 := alloc(8);
                  var kArt: int64 := alloc(8); var kWert: int64 := alloc(8);
                  var kTxtL: int64 := alloc(8);
                  var ki: int64 := 0;
                  while (ki < kn) {
                    if (lr.LyrKonAt(ki, kNm, kNmL, kArt, kWert, kTxtL)) {
                      var knp: pchar := peek64(kNm) as pchar;
                      var knl: int64 := peek64(kNmL);
                      if (peek64(kArt) == 0) {
                        self.cg_addCon(knp, knl, peek64(kWert));
                      } else {
                        // Der Text liegt im .lyu-Puffer; cg_addStr legt ihn
                        // in den Datenbereich des Erzeugnisses.
                        var kdo: int64 := self.cg_addStrRoh(peek64(kWert), peek64(kTxtL));
                        self.cg_addConStr(knp, knl, kdo);
                      }
                    }
                    ki += 1;
                  }
                  // Geht noch etwas VERLOREN? Gezaehlt wird ueber die
                  // Symboltabelle, nicht ueber den Abschnitt — der sagt nur,
                  // was DA ist.
                  //
                  // Ein Symbol, das der Konsument ohnehin kennt, geht nicht
                  // verloren: eine `.lyu` fuehrt auch die Prelude-Konstanten
                  // (PROT_RW, MAP_ANON, ARCH_* — 26 Stueck stehen in JEDER
                  // Datei), und die sind hier laengst definiert. Deshalb wird
                  // je Symbol gefragt, ob es JETZT bekannt ist, statt die
                  // Anzahlen zu vergleichen.
                  var sNm: int64 := alloc(8); var sNmL: int64 := alloc(8);
                  var sLsk: int64 := alloc(8);
                  var fehlt: int64 := 0;
                  var sIdx: int64 := 0;
                  while (sIdx < lr.symCount) {
                    if (lr.LyrSymAt(sIdx, sNm, sNmL, sLsk)) {
                      var snp: pchar := peek64(sNm) as pchar;
                      var snl: int64 := peek64(sNmL);
                      if (self.cg_findConIdx(snp, snl) < 0) {
                        // #2142: ein Enum aus dem Anhang ist bekannt.
                        if (self.cg_isDeclaredFunc(snp, snl) == 0 && self.cg_findEnum(snp, snl) < 0) {
                          // #2014: beschreibt ein Deklarationseintrag das
                          // Symbol (Funktion, Struct, Klasse), geht es nicht
                          // verloren — es kommt unten als Deklaration herein.
                          if (!lr.LyrDeklHat(snp, snl)) {
                            if (fehlt == 0) { lyuFehltNm := snp as int64; lyuFehltNl := snl; }
                            fehlt := fehlt + 1;
                          }
                        }
                      }
                    }
                    sIdx += 1;
                  }
                  if (fehlt == 0) {
                    var dkLB: int64 := alloc(8);
                    var dkT: int64 := lr.LyrDeklText(dkLB);
                    if (dkT != 0) {
                      lyuText := dkT; lyuTextLen := peek64(dkLB);
                      lyuRdr := lr;
                    } else {
                      traegtSymbole := 0;
                    }
                  }
                }
              }
            }
          }
          close(lfd);
        }
      }
      if (traegtSymbole == 0) {
        // Nichts deklariert, nichts verloren — weiter wie bisher.
        free(pathBuf, nameLen + 8);
        self.cgAlias := cgaSaved; self.cgAliasLen := cgaSavedLen;   // #1262
        return;
      }
      if (lyuText == 0) {
        EPrintStr("error: codegen: Quelle der importierten Unit nicht lesbar: "c);
        EPrintStrLn(path);
        EPrintStrLn("  sema hat die Unit aufgeloest (womoeglich ueber eine .lyu), der Codegen"c);
        EPrintStrLn("  braucht aber die .lyx: die .lyu beschreibt nicht alle ihre Symbole —"c);
        EPrintStrLn("  weder die Werte der Konstanten noch die Deklarationen decken sie ab."c);
        if (lyuFehltNl > 0) {
          EPrintStr("  Nicht beschrieben: "c);
          sys_write(2, lyuFehltNm, lyuFehltNl);
          EPrintStrLn(""c);
        }
        EPrintStrLn("  Ohne diesen Abbruch kaeme jede Konstante daraus still als 0 an."c);
        exit(1);
      }
      // #2014 Stufen 2–4: Die .lyu beschreibt alles — weiter wie mit einer
      // Quelle, nur aus ihrem Deklarationstext und ohne Rumpfe (cgNurDekl).
      src := lyuText as pchar;
      srcSize := lyuTextLen;
    }

    var impPfad: int64 := self.cgLesePfad;   // #1971

    // Parse the imported file
    var p: Parser := new Parser();
    p.Init(src, srcSize);
    var cgAusLyu: int64 := 0;
    if (lyuText != 0) { p.lyuDekl := 1; cgAusLyu := 1; }   // #2014
    var head: int64 := p.Parse();
    // #1878: Ein `@integrity(mode: scrubbed, interval: N)` in einer
    // IMPORTIERTEN Einheit bringt sein Intervall mit. Ohne diese Zeile bekaeme
    // der Sweep dort still den Standardwert — die gesetzte Zahl waere
    // wirkungslos, je nachdem, in welcher Datei sie steht.
    if (p.integrityIntervalMs != 0) {
      if (self.integrityIntervalMs == 0 || p.integrityIntervalMs < self.integrityIntervalMs) {
        self.integrityIntervalMs := p.integrityIntervalMs;
      }
    }

    if (p.hadError != 0) {
      PrintStr("codegen: parse error in import: ");
      PrintStr(path);
      PrintStr("\n");
      free(pathBuf, nameLen + 8);
      free(src as int64, srcSize);   // #1622
      dispose p;
      self.cgAlias := cgaSaved; self.cgAliasLen := cgaSavedLen;   // #1262
      return;
    }

    free(pathBuf, nameLen + 8);

    // Switch to imported file's source and nodes for codegen
    var savedSrc:   pchar := self.pSrc;
    var savedNodes: int64 := self.pNodes;
    // #2079: auch der Kopf der Deklarationskette. cg_genFile setzt ihn fuer
    // die importierte Unit neu; blieb er danach stehen, lief cg_isDeclaredFunc
    // im einbindenden Modul eine fremde Kette ab, fand die Funktion nicht,
    // und `f as int64` wurde still 0.
    var savedTopHead: int64 := self.topLevelHead;
    var savedNodeCnt: int64 := self.pNodeCount;   // #2134
    self.pSrc   := p.src;
    self.pNodes := p.nodes;
    self.pNodeCount := p.nodeCount;

    // #1655: Waehrend dieser Unit tragen private Marken ihren Namen.
    var utSaved:    int64 := self.cgUnitTag;
    var utSavedLen: int64 := self.cgUnitTagLen;
    var utSavedTab: int64 := self.cgUnitPrivTab;
    var utSavedCnt: int64 := self.cgUnitPrivCnt;
    var utSavedCap: int64 := self.cgUnitPrivCap;
    var utSavedVTab: int64 := self.cgUnitPrivVTab;   // #2097
    var utSavedVCnt: int64 := self.cgUnitPrivVCnt;
    self.cgUnitTag    := modName as int64;
    self.cgUnitTagLen := nameLen;
    self.cgUnitPrivCap := 128;
    self.cgUnitPrivTab := alloc(self.cgUnitPrivCap * 16);
    self.cgUnitPrivCnt := 0;
    self.cg_unitPrivCollect(head, 0);
    self.cg_unitPrivVCollect(head);   // #2097/#2099

    // #2044: Die Marken-Eintraege dieser Unit gelten nur, solange ihre
    // Knotentabelle aktiv ist (Schluessel: pNodes + Knoten). Danach werden sie
    // verworfen — eine spaeter angelegte Tabelle duerfte sonst an derselben
    // Adresse liegen und alte Eintraege treffen.
    var nestSaved: int64 := self.nestMapCnt;

    // #1971: Waehrend dieser Unit gelten Pfade in @embed/@resource relativ zu
    // IHRER Datei. Bis 1.2.16A blieb srcFilePath auf dem Hauptprogramm: eine
    // Bibliothek fand ihre eigene Ressource nur, wenn das Programm zufaellig
    // im selben Verzeichnis lag.
    var sfpSaved: pchar := self.srcFilePath;
    var sflSaved: int64 := self.srcFileLen;
    if (impPfad != 0) {
      self.srcFilePath := impPfad as pchar;
      self.srcFileLen := StrLen(impPfad as pchar);
    }

    // Recursively generate code for the imported file
    var miStartImp: int64 := self.miPendN;   // #2136
    var nurDeklSaved: int64 := self.cgNurDekl;   // #2014
    self.cgNurDekl := cgAusLyu;
    self.cg_genFile(head);
    // Was noch vorgemerkt ist, gehoert zu DIESEN Knoten — jetzt erzeugen,
    // nicht spaeter unter der Tabelle des einbindenden Moduls.
    self.cg_flushNested();
    // #2136: die Anfangswerte dieser Unit — ebenfalls noch unter ihrer
    // Tabelle und ihrem Privatverzeichnis.
    self.cg_miEinheit(miStartImp);
    self.srcFilePath := sfpSaved;   // #1971
    self.srcFileLen := sflSaved;
    
    // AP-1: Collect function labels from imported module
    // This makes imported functions visible for patch resolution in main file
    // IMPORTANT: Do this WHILE still switched to import pNodes!
    // #2014: NICHT fuer Deklarationen aus einer .lyu — eine Marke ohne Rumpf
    // laege auf dem naechsten fremden Code, und der Aufruf traefe ihn.
    if (cgAusLyu == 0) { self.cg_collectImportLabels(head); }
    self.cg_collectImportDefaults(head);   // #1342: konstante Vorgabewerte abschreiben
    if (cgAusLyu != 0) { self.cg_lyuPruefeLayout(lyuRdr); }   // #2014
    self.cgNurDekl := nurDeklSaved;
    self.nestMapCnt := nestSaved;          // #2044

    self.cgUnitTag     := utSaved;      // #1655
    self.cgUnitTagLen  := utSavedLen;
    self.cgUnitPrivTab := utSavedTab;
    self.cgUnitPrivCnt := utSavedCnt;
    self.cgUnitPrivCap := utSavedCap;
    self.cgUnitPrivVTab := utSavedVTab;   // #2097
    self.cgUnitPrivVCnt := utSavedVCnt;

    // Restore main file's source and nodes
    self.pSrc   := savedSrc;
    self.pNodes := savedNodes;
    self.pNodeCount := savedNodeCnt;     // #2134
    self.topLevelHead := savedTopHead;   // #2079

    self.cgAlias := cgaSaved; self.cgAliasLen := cgaSavedLen;   // #1262
    dispose p;
    // NOTE: src (imported source buffer) is intentionally NOT freed here.
    // cg_addLabel/cg_buildStructLayout etc. store raw pointers into src.
    // Freeing src would invalidate those pointers and cause SIGSEGV on lookup.
  }

  // ------------------------------------------------------------------
  // AP-1: Collect labels from imported module
  // Walks the AST and registers all function names as labels for patch resolution
  // ------------------------------------------------------------------
  
  fn cg_collectImportLabels(head: int64): void {
    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_FUNC_DECL) {
        var fname: pchar := self.cg_nsval(cur);
        var fnlen: int64 := self.cg_nslen(cur);
        // #1655: dieselbe Marke wie bei der Erzeugung — sonst stuende der
        // schlichte Name doch wieder im Verzeichnis und faenge Aufrufe aus
        // fremden Units ein.
        if (self.cgUnitTag != 0 && peek64(self.cg_noff(cur) + CG_OFF_ISPUB) == 0 &&
            self.cg_unitPrivHat(fname, fnlen) != 0) {
          var clc: int64 := alloc(8);
          var cb:  int64 := self.cg_unitPrivMangle(fname, fnlen, clc);
          self.cg_addLabel(cb as pchar, peek64(clc), 0);
          free(clc, 8);
        } else {
          self.cg_addLabel(fname, fnlen, 0);  // imported: no source line
        }
      }
      cur := self.cg_nnext(cur);
    }
  }

  // ==================================================================
  // #2134: Monomorphisierung generischer Funktionen auf x86.
  //
  // Bis 1.2.15A (WP-BC-24) gab es EINEN typgeloeschten Rumpf, und jede
  // Instanz `f<P>` war nur eine Marke mit einem Sprung dorthin. Was am Typ
  // hing, ging dabei verloren: `p.x` mit `p: T` fand kein Feld und lieferte
  // still 0, `add<f64>` haette auf den IEEE-Bits gerechnet (seit #2125
  // abgewiesen). Der IR-Weg spezialisiert seit #2125 je Kombination.
  //
  // Jetzt auch hier: je Typargument-Kombination ein eigener Rumpf, erzeugt
  // in der Unit der Deklaration, mit T durch das Argument ersetzt. Ersetzt
  // wird am KNOTEN — jeder Typname `T` im Bereich der Funktion traegt fuer die
  // Dauer der Erzeugung den Namen des Arguments (cg_genPatch). Damit sehen
  // alle Stellen, die einen Typ nachschlagen (Locals, Parameter, Felder,
  // Rueckgabe, Casts, weitere generische Aufrufe), den richtigen, ohne dass
  // jede einzeln von der Ersetzung wissen muesste.
  //
  // Der typgeloeschte Rumpf bleibt: ein Aufruf OHNE Typargumente
  // (`max(8, 2)`) und ein Verweis auf die Funktion als Wert meinen ihn.
  // ==================================================================

  // Vorpass einer Unit: jede generische Funktion samt Kontext eintragen.
  fn cg_genRegistriere(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_FUNC_DECL) {
        var tp: int64 := self.cg_nc3(cur);
        // c3 einer `extern fn` ist eine gepackte Bibliotheksangabe, kein
        // Knoten — daher die Grenze vor dem Lesen der Art.
        if (tp >= 0 && tp < self.pNodeCount && self.cg_nkind(tp) == 62
            && self.cg_nestHatRumpf(cur) != 0) {
          self.cg_genEintrag(cur, head);
        }
      }
      cur := self.cg_nnext(cur);
    }
  }

  fn cg_genEintrag(fd: int64, head: int64) {
    var i: int64 := 0;
    while (i < self.gfN) {
      var r0: int64 := self.gfRecs + i * CG_GF_SZ;
      if (peek64(r0 + CG_GF_OFF_NODES) == self.pNodes && peek64(r0 + CG_GF_OFF_NI) == fd) { return; }
      i += 1;
    }
    if (self.gfN >= self.gfCap) {
      var nc: int64 := self.gfCap * 2;
      if (nc < 8) { nc := 8; }
      var nb: int64 := alloc(nc * CG_GF_SZ);
      if (self.gfN > 0) { memcpy(nb, self.gfRecs, self.gfN * CG_GF_SZ); }
      self.gfRecs := nb; self.gfCap := nc;
    }
    // Ende des Knotenbereichs: der Parser legt den Funktionsknoten VOR allen
    // Kindern an, und die Deklarationen der Unit folgen einander. Der
    // naechste Deklarationsknoten mit groesserem Index begrenzt den Bereich.
    var ende: int64 := self.pNodeCount;
    var c: int64 := head;
    while (c != -1) {
      if (c > fd && c < ende) { ende := c; }
      c := self.cg_nnext(c);
    }
    var tpN: int64 := 0;
    var tp: int64 := self.cg_nc3(fd);
    while (tp >= 0) { tpN += 1; tp := self.cg_nnext(tp); }
    var innen: int64 := 0;
    var k: int64 := fd + 1;
    while (k < ende) {
      if (self.cg_nkind(k) == CGN_FUNC_DECL) { innen := 1; }
      k += 1;
    }
    var lc: int64 := alloc(8);
    var lbl: pchar := self.cg_topFnLabel(fd, lc);
    var r: int64 := self.gfRecs + self.gfN * CG_GF_SZ;
    poke64(r, self.cg_nsval(fd) as int64);
    poke64(r + CG_GF_OFF_NAMELEN, self.cg_nslen(fd));
    poke64(r + CG_GF_OFF_LBL, lbl as int64);
    poke64(r + CG_GF_OFF_LBLLEN, peek64(lc));
    free(lc, 8);
    poke64(r + CG_GF_OFF_SRC, self.pSrc as int64);
    poke64(r + CG_GF_OFF_NODES, self.pNodes);
    poke64(r + CG_GF_OFF_NCNT, self.pNodeCount);
    poke64(r + CG_GF_OFF_NI, fd);
    poke64(r + CG_GF_OFF_PUB, peek64(self.cg_noff(fd) + CG_OFF_ISPUB));
    poke64(r + CG_GF_OFF_TPN, tpN);
    poke64(r + CG_GF_OFF_END, ende);
    poke64(r + CG_GF_OFF_TAG, self.cgUnitTag);
    poke64(r + CG_GF_OFF_TAGLEN, self.cgUnitTagLen);
    poke64(r + CG_GF_OFF_PTAB, self.cgUnitPrivTab);
    poke64(r + CG_GF_OFF_PCNT, self.cgUnitPrivCnt);
    poke64(r + CG_GF_OFF_PVTAB, self.cgUnitPrivVTab);
    poke64(r + CG_GF_OFF_PVCNT, self.cgUnitPrivVCnt);
    poke64(r + CG_GF_OFF_ALIAS, self.cgAlias);
    poke64(r + CG_GF_OFF_ALIASL, self.cgAliasLen);
    poke64(r + CG_GF_OFF_HEAD, head);
    poke64(r + CG_GF_OFF_NESTED, innen);
    self.gfN += 1;
  }

  // Ein Feld, dessen Versatz sich nicht bestimmen laesst. Drei Lagen:
  //   - in einer Spezialisierung: T ist ersetzt, der Typ trotzdem ohne dieses
  //     Feld — laut, beim Uebersetzen (wie _genFehler im IR-Weg);
  //   - im typgeloeschten Rumpf: T ist unbekannt, der Rumpf ist nur ueber
  //     einen Aufruf OHNE Typargumente erreichbar (`gety(p)`). Bis 1.2.15A
  //     lieferte er still 0; jetzt bricht er an dieser Stelle laut ab;
  //   - sonst: das bisherige Verhalten (Wert 0), siehe Bericht zu #2134.
  //
  // #2141: AUSSERHALB eines typgeloeschten generischen Rumpfes kehrte die
  // Funktion bis 1.2.16A still zurueck — der Lesezugriff lieferte 0, die
  // Zuweisung entfiel, ohne Meldung. Jetzt bricht das Uebersetzen ab, mit
  // derselben Meldung wie _feldOffen im IR-Weg (die beiden muessen
  // uebereinstimmen). ni = der Feldknoten, fuer die Zeilenangabe.
  fn cg_genFeldOffen(fp: pchar, fl: int64, ni: int64) {
    if (self.genActN > 0) {
      self.cg_genFehler("Feld ueber einen Typparameter nicht aufloesbar: "c, fp, fl);
    }
    var fd: int64 := self.genCurFd;
    var tp: int64 := 0 - 1;
    if (fd >= 0) { tp := self.cg_nc3(fd); }
    if (tp < 0 || tp >= self.pNodeCount || self.cg_nkind(tp) != 62) {
      EPrintStr("error: #2134: Feld nicht aufloesbar (Typ der Basis unbekannt): "c);
      sys_write(2, fp as int64, fl);
      EPrintStr(" (Zeile "c);
      EPrintInt(self.cg_lineOf(ni));
      EPrintStrLn(")"c);
      exit(1);
    }
    var msgOff: int64 := self.dataLen;
    var t1: pchar := "lyxc: generische Funktion ohne Typargumente aufgerufen, Feld "c;
    var i: int64 := 0;
    while (StrCharAt(t1, i) != 0) { self.cg_edata(StrCharAt(t1, i)); i := i + 1; }
    i := 0;
    while (i < fl) { self.cg_edata(StrCharAt(fp, i)); i := i + 1; }
    var t2: pchar := " haengt am Typparameter (#2134)"c;
    i := 0;
    while (StrCharAt(t2, i) != 0) { self.cg_edata(StrCharAt(t2, i)); i := i + 1; }
    self.cg_edata(10); self.cg_edata(0);
    self.cg_emitLeaRdiData(msgOff);
    self.cg_emitPanicBody();
  }

  fn cg_genFehler(msg: pchar, np: pchar, nl: int64) {
    EPrintStr("error: x86_64: #2134: "c);
    EPrintStr(msg);
    sys_write(2, np as int64, nl);
    EPrintStrLn(""c);
    exit(1);
  }

  // Die Deklaration zu einem Namen: zuerst in der aktiven Unit, sonst eine
  // oeffentliche einer anderen (dieselbe Reihenfolge wie _genInstanz im
  // IR-Weg). Ein Knotenindex allein genuegt nicht — er gilt nur in seiner
  // Tabelle.
  fn cg_genFind(np: pchar, nl: int64): int64 {
    var gefunden: int64 := 0 - 1;
    var i: int64 := 0;
    while (i < self.gfN) {
      var r: int64 := self.gfRecs + i * CG_GF_SZ;
      if (self.cg_seq(peek64(r) as pchar, peek64(r + CG_GF_OFF_NAMELEN), np, nl) != 0) {
        if (peek64(r + CG_GF_OFF_NODES) == self.pNodes) { return i; }
        if (gefunden < 0 && peek64(r + CG_GF_OFF_PUB) != 0) { gefunden := i; }
      }
      i += 1;
    }
    return gefunden;
  }

  // Ist der Typname `ta` (im Bereich einer generischen Funktion der aktiven
  // Tabelle) einer ihrer Typparameter? Dann steht der Aufruf im
  // typgeloeschten Rumpf, und T ist dort nicht bekannt.
  fn cg_genIstTypParam(ta: int64): int64 {
    var i: int64 := 0;
    while (i < self.gfN) {
      var r: int64 := self.gfRecs + i * CG_GF_SZ;
      if (peek64(r + CG_GF_OFF_NODES) == self.pNodes) {
        var fd: int64 := peek64(r + CG_GF_OFF_NI);
        if (ta > fd && ta < peek64(r + CG_GF_OFF_END)) {
          var tp: int64 := self.cg_nc3(fd);
          while (tp >= 0) {
            if (self.cg_seq(self.cg_nsval(tp), self.cg_nslen(tp), self.cg_nsval(ta), self.cg_nslen(ta)) != 0) { return 1; }
            tp := self.cg_nnext(tp);
          }
        }
      }
      i += 1;
    }
    return 0;
  }

  // Name der Spezialisierung fuer den generischen Aufruf `ni` (iVal 2,
  // c2 = Typargumente). Legt sie beim ersten Mal an und traegt ihre
  // Signatur ein — Aufrufstellen fragen die Register (f64-Rueckgabe, Klasse
  // des Ergebnisses) unter diesem Namen, oft BEVOR der Aufruf erzeugt wird.
  //
  // Im typgeloeschten Rumpf (Typargument ist ein noch nicht ersetzter
  // Typparameter) bleibt es beim Namen der generischen Funktion.
  fn cg_genInstanz(ni: int64, lenCell: int64): pchar {
    var np: pchar := self.cg_nsval(ni);
    var nl: int64 := self.cg_nslen(ni);
    var g: int64 := self.cg_genFind(np, nl);
    if (g < 0) {
      self.cg_genFehler("keine generische Funktion dieses Namens (oder nur als .lyu ohne Quelltext): "c, np, nl);
    }
    var gr: int64 := self.gfRecs + g * CG_GF_SZ;
    var argN: int64 := 0;
    var mLen: int64 := peek64(gr + CG_GF_OFF_LBLLEN) + 2;
    var ta: int64 := self.cg_nc2(ni);
    while (ta >= 0) {
      if (self.cg_nkind(ta) != 60 || self.cg_nc0(ta) >= 0 || self.cg_nc1(ta) >= 0 || self.cg_nslen(ta) <= 0) {
        self.cg_genFehler("Typargument ist kein einfacher Typname bei "c, np, nl);
      }
      if (self.cg_genIstTypParam(ta) != 0) {
        poke64(lenCell, nl);
        return np;
      }
      argN += 1;
      mLen := mLen + self.cg_nslen(ta) + 1;
      ta := self.cg_nnext(ta);
    }
    if (argN != peek64(gr + CG_GF_OFF_TPN)) {
      self.cg_genFehler("Anzahl der Typargumente passt nicht zu den Typparametern von "c, np, nl);
    }
    // "<Marke><A,B>" — `<` kommt in keinem Bezeichner vor.
    var mb: int64 := alloc(mLen + 1);
    var lbl: int64 := peek64(gr + CG_GF_OFF_LBL);
    var pos: int64 := peek64(gr + CG_GF_OFF_LBLLEN);
    memcpy(mb, lbl, pos);
    poke8(mb + pos, 60); pos += 1;
    var argB: int64 := alloc(argN * 16 + 16);
    var ai: int64 := 0;
    ta := self.cg_nc2(ni);
    while (ta >= 0) {
      if (ai > 0) { poke8(mb + pos, 44); pos += 1; }
      memcpy(mb + pos, self.cg_nsval(ta) as int64, self.cg_nslen(ta));
      pos := pos + self.cg_nslen(ta);
      poke64(argB + ai * 16, self.cg_nsval(ta) as int64);
      poke64(argB + ai * 16 + 8, self.cg_nslen(ta));
      ai += 1;
      ta := self.cg_nnext(ta);
    }
    poke8(mb + pos, 62); pos += 1;
    poke8(mb + pos, 0);
    var i: int64 := 0;
    while (i < self.gmN) {
      var m: int64 := self.gmRecs + i * CG_GM_SZ;
      if (self.cg_seq(peek64(m) as pchar, peek64(m + CG_GM_OFF_LEN), mb as pchar, pos) != 0) {
        free(mb, mLen + 1);
        free(argB, argN * 16 + 16);
        poke64(lenCell, peek64(m + CG_GM_OFF_LEN));
        return peek64(m) as pchar;
      }
      i += 1;
    }
    if (self.gmN >= self.gmCap) {
      var nc: int64 := self.gmCap * 2;
      if (nc < 8) { nc := 8; }
      var nb: int64 := alloc(nc * CG_GM_SZ);
      if (self.gmN > 0) { memcpy(nb, self.gmRecs, self.gmN * CG_GM_SZ); }
      self.gmRecs := nb; self.gmCap := nc;
    }
    var nm: int64 := self.gmRecs + self.gmN * CG_GM_SZ;
    poke64(nm, mb);
    poke64(nm + CG_GM_OFF_LEN, pos);
    poke64(nm + CG_GM_OFF_GF, g);
    poke64(nm + CG_GM_OFF_ARGS, argB);
    poke64(nm + CG_GM_OFF_ARGN, argN);
    poke64(nm + CG_GM_OFF_DONE, 0);
    self.gmN += 1;
    self.cg_genSignatur(self.gmN - 1);
    poke64(lenCell, pos);
    return mb as pchar;
  }

  // T -> Argument an jedem schlichten Typnamen im Bereich der Funktion.
  // Die AKTIVE Tabelle muss die der Deklaration sein. Liefert die Liste der
  // Aenderungen (Eintraege zu 40 Byte), Anzahl in nCell.
  fn cg_genPatch(gmI: int64, nCell: int64): int64 {
    var m: int64 := self.gmRecs + gmI * CG_GM_SZ;
    var gr: int64 := self.gfRecs + peek64(m + CG_GM_OFF_GF) * CG_GF_SZ;
    var fd: int64 := peek64(gr + CG_GF_OFF_NI);
    var ende: int64 := peek64(gr + CG_GF_OFF_END);
    var argB: int64 := peek64(m + CG_GM_OFF_ARGS);
    var buf: int64 := alloc((ende - fd + 1) * 80);
    var n: int64 := 0;
    var k: int64 := fd + 1;
    while (k < ende) {
      // #2143: `Box<T>` / `new Box<T>()` — die Nennung traegt fuer die Dauer
      // den Namen der Instanz ("Box<int64>"), die Argumentkette ist so lange
      // ausgehaengt (c1 bzw. c2 = -1). Zwei Eintraege: Name, Kette.
      var abhK: int64 := self.cg_nkind(k);
      var abhA: int64 := 0 - 1;
      var abhF: int64 := 0;
      if (abhK == 60 && self.cg_nc1(k) >= 0
          && self.cg_seq(self.cg_nsval(k), self.cg_nslen(k), "Array"c, 5) == 0) { abhA := self.cg_nc1(k); abhF := CG_OFF_C1; }
      if (abhK == CGN_NEW && self.cg_nc2(k) >= 0) { abhA := self.cg_nc2(k); abhF := CG_OFF_C2; }
      if (abhA >= 0) {
        var alc: int64 := alloc(16);
        var amp: pchar := self.cg_genAbhName(k, fd, argB, alc);
        if (peek64(alc + 8) != 0) {
          if (self.cg_findClass(amp, peek64(alc)) < 0) {
            self.cg_genFehler("#2143: Instanz eines generischen Typs fehlt (Aufruf der generischen Funktion aus einer anderen Unit?): "c,
                              amp, peek64(alc));
          }
          var af: int64 := self.cg_noff(k) + CG_OFF_SVAL;
          var ae: int64 := buf + n * 40;
          poke64(ae, af);
          poke64(ae + 8, peek64(af));
          poke64(ae + 16, peek64(af + 8));
          poke64(ae + 24, (amp as int64) - (self.pSrc as int64));
          poke64(ae + 32, peek64(alc));
          poke64(af, peek64(ae + 24));
          poke64(af + 8, peek64(ae + 32));
          n += 1;
          var cf: int64 := self.cg_noff(k) + abhF;
          var ce: int64 := buf + n * 40;
          poke64(ce, cf);
          poke64(ce + 8, peek64(cf));
          poke64(ce + 16, peek64(cf + 8));
          poke64(ce + 24, 0 - 1);
          poke64(ce + 32, peek64(cf + 8));
          poke64(cf, 0 - 1);
          n += 1;
        }
        free(alc, 16);
      }
      if (self.cg_nkind(k) == 60 && self.cg_nc0(k) < 0 && self.cg_nc1(k) < 0) {
        var tp: int64 := self.cg_nc3(fd);
        var ai: int64 := 0;
        while (tp >= 0) {
          if (self.cg_seq(self.cg_nsval(tp), self.cg_nslen(tp), self.cg_nsval(k), self.cg_nslen(k)) != 0) {
            var feld: int64 := self.cg_noff(k) + CG_OFF_SVAL;
            var e: int64 := buf + n * 40;
            poke64(e, feld);
            poke64(e + 8, peek64(feld));
            poke64(e + 16, peek64(feld + 8));
            poke64(e + 24, peek64(argB + ai * 16) - (self.pSrc as int64));
            poke64(e + 32, peek64(argB + ai * 16 + 8));
            poke64(feld, peek64(e + 24));
            poke64(feld + 8, peek64(e + 32));
            n += 1;
            tp := 0 - 1;
          } else {
            tp := self.cg_nnext(tp);
            ai += 1;
          }
        }
      }
      k += 1;
    }
    poke64(nCell, n);
    return buf;
  }

  // #2143: Nennt die generische Funktion fd (aktive Tabelle) einen
  // generischen Typ ueber ihren Typparameter? Nach dem Parser traegt nur
  // eine solche Nennung noch Argumente (alle anderen sind zu "Box<int64>"
  // aufgeloest) — ausser `Array<T>`, das der Parser ausnimmt (_gtRefAdd).
  fn cg_genHatAbh(fd: int64): int64 {
    var tp: int64 := self.cg_nc3(fd);
    if (tp < 0 || tp >= self.pNodeCount || self.cg_nkind(tp) != 62) { return 0; }
    var ende: int64 := 0 - 1;
    var i: int64 := 0;
    while (i < self.gfN) {
      var r: int64 := self.gfRecs + i * CG_GF_SZ;
      if (peek64(r + CG_GF_OFF_NODES) == self.pNodes && peek64(r + CG_GF_OFF_NI) == fd) { ende := peek64(r + CG_GF_OFF_END); }
      i += 1;
    }
    if (ende < 0) { return 0; }
    var k: int64 := fd + 1;
    while (k < ende) {
      var kk: int64 := self.cg_nkind(k);
      if (kk == CGN_NEW && self.cg_nc2(k) >= 0) { return 1; }
      if (kk == 60 && self.cg_nc1(k) >= 0 && self.cg_seq(self.cg_nsval(k), self.cg_nslen(k), "Array"c, 5) == 0) { return 1; }
      k += 1;
    }
    return 0;
  }

  // #2143: Name der Instanz fuer die Nennung r (Typname mit Argumenten in
  // c1, `new` mit Argumenten in c2) unter der Ersetzung Typparameter von fd
  // -> argB. Derselbe Name wie im Parser (_gtAbhName, _gtResolve:
  // "Name<A,B>", geschachtelt rekursiv) — die beiden muessen
  // uebereinstimmen. lc: +0 Laenge, +8 = 1, wenn ein Typparameter darin
  // vorkam (sonst ist die Nennung keine abhaengige und bleibt stehen).
  fn cg_genAbhName(r: int64, fd: int64, argB: int64, lc: int64): pchar {
    var args: int64 := self.cg_nc1(r);
    if (self.cg_nkind(r) == CGN_NEW) { args := self.cg_nc2(r); }
    var cap: int64 := self.cg_nslen(r) + 2;
    var a: int64 := args;
    while (a >= 0) { cap := cap + 256; a := self.cg_nnext(a); }
    var mb: int64 := alloc(cap + 1);
    var pos: int64 := self.cg_nslen(r);
    memcpy(mb, self.cg_nsval(r) as int64, pos);
    poke8(mb + pos, 60); pos += 1;
    poke64(lc + 8, 0);
    var erst: int64 := 1;
    a := args;
    while (a >= 0) {
      if (erst == 0) { poke8(mb + pos, 44); pos += 1; }
      erst := 0;
      var np: int64 := self.cg_nsval(a) as int64;
      var nl: int64 := self.cg_nslen(a);
      if (self.cg_nkind(a) == 60 && self.cg_nc1(a) >= 0) {
        var ilc: int64 := alloc(16);
        np := self.cg_genAbhName(a, fd, argB, ilc) as int64;
        nl := peek64(ilc);
        if (peek64(ilc + 8) != 0) { poke64(lc + 8, 1); }
        free(ilc, 16);
      } else {
        var tp: int64 := self.cg_nc3(fd);
        var ai: int64 := 0;
        while (tp >= 0) {
          if (self.cg_seq(self.cg_nsval(tp), self.cg_nslen(tp), np as pchar, nl) != 0) {
            np := peek64(argB + ai * 16); nl := peek64(argB + ai * 16 + 8);
            poke64(lc + 8, 1);
            tp := 0 - 1;
          } else { tp := self.cg_nnext(tp); ai += 1; }
        }
      }
      if (pos + nl + 2 > cap) {
        var nc: int64 := (pos + nl + 2) * 2;
        var nb: int64 := alloc(nc + 1);
        memcpy(nb, mb, pos);
        mb := nb; cap := nc;
      }
      memcpy(mb + pos, np, nl);
      pos := pos + nl;
      a := self.cg_nnext(a);
    }
    poke8(mb + pos, 62); pos += 1;
    poke8(mb + pos, 0);
    poke64(lc, pos);
    return mb as pchar;
  }

  // Ersetzung zuruecknehmen (rueckwaerts) bzw. erneut anwenden.
  fn cg_genUndo(buf: int64, n: int64) {
    var i: int64 := n - 1;
    while (i >= 0) {
      var e: int64 := buf + i * 40;
      poke64(peek64(e), peek64(e + 8));
      poke64(peek64(e) + 8, peek64(e + 16));
      i -= 1;
    }
  }

  fn cg_genRedo(buf: int64, n: int64) {
    var i: int64 := 0;
    while (i < n) {
      var e: int64 := buf + i * 40;
      poke64(peek64(e), peek64(e + 24));
      poke64(peek64(e) + 8, peek64(e + 32));
      i += 1;
    }
  }

  // Signatur der Spezialisierung eintragen (cg_registerSigUnter, dieselbe
  // Stelle wie fuer jede Funktion): in der Tabelle der Deklaration, mit T
  // ersetzt. Laeuft das waehrend einer anderen Spezialisierung, ist deren
  // Ersetzung aktiv — sie kann dieselben Knoten betreffen (`f<T>` ruft
  // `f<int64>`) und wird dafuer kurz zurueckgenommen.
  fn cg_genSignatur(gmI: int64) {
    var m: int64 := self.gmRecs + gmI * CG_GM_SZ;
    var gr: int64 := self.gfRecs + peek64(m + CG_GM_OFF_GF) * CG_GF_SZ;
    if (self.genActN > 0) { self.cg_genUndo(self.genActBuf, self.genActN); }
    var svSrc: pchar := self.pSrc;
    var svNodes: int64 := self.pNodes;
    var svCnt: int64 := self.pNodeCount;
    self.pSrc := peek64(gr + CG_GF_OFF_SRC) as pchar;
    self.pNodes := peek64(gr + CG_GF_OFF_NODES);
    self.pNodeCount := peek64(gr + CG_GF_OFF_NCNT);
    var nc: int64 := alloc(8);
    var pb: int64 := self.cg_genPatch(gmI, nc);
    var pn: int64 := peek64(nc);
    free(nc, 8);
    self.cg_registerSigUnter(peek64(gr + CG_GF_OFF_NI), peek64(m) as pchar, peek64(m + CG_GM_OFF_LEN));
    self.cg_genUndo(pb, pn);
    self.pSrc := svSrc;
    self.pNodes := svNodes;
    self.pNodeCount := svCnt;
    if (self.genActN > 0) { self.cg_genRedo(self.genActBuf, self.genActN); }
  }

  // Alle angeforderten Spezialisierungen erzeugen — jede im Kontext ihrer
  // Unit (Quelltext, Knotentabelle, private Marken, Namensraum). Eine
  // Spezialisierung darf weitere anfordern; die Schleife liest die Anzahl
  // bei jedem Schritt neu.
  fn cg_genEmitPending() {
    var i: int64 := 0;
    while (i < self.gmN) {
      var m: int64 := self.gmRecs + i * CG_GM_SZ;
      if (peek64(m + CG_GM_OFF_DONE) == 0) {
        poke64(m + CG_GM_OFF_DONE, 1);
        var gr: int64 := self.gfRecs + peek64(m + CG_GM_OFF_GF) * CG_GF_SZ;
        if (peek64(gr + CG_GF_OFF_NESTED) != 0) {
          // Die innere Funktion traegt eine Marke je Tabelle (cg_nestPlan),
          // nicht je Spezialisierung — zwei Instanzen teilten sie sich.
          self.cg_genFehler("innere Funktion in einer generischen Funktion wird nicht unterstuetzt: "c,
                            peek64(gr) as pchar, peek64(gr + CG_GF_OFF_NAMELEN));
        }
        var svSrc: pchar := self.pSrc;
        var svNodes: int64 := self.pNodes;
        var svCnt: int64 := self.pNodeCount;
        var svHead: int64 := self.topLevelHead;
        var svTag: int64 := self.cgUnitTag;
        var svTagL: int64 := self.cgUnitTagLen;
        var svPT: int64 := self.cgUnitPrivTab;
        var svPC: int64 := self.cgUnitPrivCnt;
        var svPCap: int64 := self.cgUnitPrivCap;
        var svPVT: int64 := self.cgUnitPrivVTab;
        var svPVC: int64 := self.cgUnitPrivVCnt;
        var svAl: int64 := self.cgAlias;
        var svAlL: int64 := self.cgAliasLen;
        self.pSrc := peek64(gr + CG_GF_OFF_SRC) as pchar;
        self.pNodes := peek64(gr + CG_GF_OFF_NODES);
        self.pNodeCount := peek64(gr + CG_GF_OFF_NCNT);
        self.topLevelHead := peek64(gr + CG_GF_OFF_HEAD);
        self.cgUnitTag := peek64(gr + CG_GF_OFF_TAG);
        self.cgUnitTagLen := peek64(gr + CG_GF_OFF_TAGLEN);
        self.cgUnitPrivTab := peek64(gr + CG_GF_OFF_PTAB);
        self.cgUnitPrivCnt := peek64(gr + CG_GF_OFF_PCNT);
        self.cgUnitPrivCap := self.cgUnitPrivCnt;
        self.cgUnitPrivVTab := peek64(gr + CG_GF_OFF_PVTAB);
        self.cgUnitPrivVCnt := peek64(gr + CG_GF_OFF_PVCNT);
        self.cgAlias := peek64(gr + CG_GF_OFF_ALIAS);
        self.cgAliasLen := peek64(gr + CG_GF_OFF_ALIASL);
        var nc: int64 := alloc(8);
        self.genActBuf := self.cg_genPatch(i, nc);
        self.genActN := peek64(nc);
        free(nc, 8);
        self.genOvLbl := peek64(m);
        self.genOvLen := peek64(m + CG_GM_OFF_LEN);
        self.cg_genFuncDecl(peek64(gr + CG_GF_OFF_NI));
        self.cg_genUndo(self.genActBuf, self.genActN);
        self.genActN := 0;
        self.pSrc := svSrc;
        self.pNodes := svNodes;
        self.pNodeCount := svCnt;
        self.topLevelHead := svHead;
        self.cgUnitTag := svTag;
        self.cgUnitTagLen := svTagL;
        self.cgUnitPrivTab := svPT;
        self.cgUnitPrivCnt := svPC;
        self.cgUnitPrivCap := svPCap;
        self.cgUnitPrivVTab := svPVT;
        self.cgUnitPrivVCnt := svPVC;
        self.cgAlias := svAl;
        self.cgAliasLen := svAlL;
      }
      i += 1;
    }
  }

  // ------------------------------------------------------------------
  // Top-level file generation
  // ------------------------------------------------------------------

  // #1338: Konstanten und Enum-Mitglieder wurden in DEMSELBEN Durchlauf
  // eingetragen, der auch die Funktionsruempfe erzeugt. Eine `con`-Zeile
  // UNTER einer Funktion war beim Uebersetzen ihres Rumpfes also noch nicht
  // bekannt — und der Bezeichner loeste still zu 0 auf. 0 ist ein
  // unauffaelliger Wert: der Vergleich wird nie wahr, die Rechnung ergibt 0.
  // Genau so verschwanden in std/os.lyx alle Zweige gegen SC_PAGESIZE.
  //
  // Fuer FUNKTIONEN galt die Vorwaertsreferenz laengst; dass ausgerechnet
  // Konstanten anders sind, kann niemand erwarten. Dieser Vorpass traegt sie
  // ein, bevor der erste Rumpf entsteht — zweimal, damit auch eine Konstante
  // gilt, die auf eine weiter unten stehende verweist.
  // #1507: Die Enum-TABELLE entstand erst im Hauptdurchlauf — beim Auswerten
  // der `con`-Zeilen gab es sie also noch nicht, und `P.Read` fiel auf 0
  // zurueck. Dieselbe Reihenfolgefrage wie bei den Konstanten selbst (#1338)
  // und den Struct-Layouts (#1451): nicht falsch gerechnet, sondern zu spaet
  // vorhanden.
  fn cg_prebuildEnums(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_ENUM_DECL) {
        if (self.cg_findEnum(self.cg_nsval(cur), self.cg_nslen(cur)) < 0) {
          self.cg_buildEnumLayout(cur);
        }
      } else if (k == CGN_BLOCK) {
        self.cg_prebuildEnums(self.cg_nc0(cur));   // @if-Zweig
      }
      cur := self.cg_nnext(cur);
    }
  }

  fn cg_collectCons(head: int64) {
    var runde: int64 := 0;
    while (runde < 2) {
      // #2102: nur die zweite Runde des letzten Aufrufs ist streng.
      self.conStreng := 0;
      if (self.conStrengAnf != 0 && runde == 1) { self.conStreng := 1; }
      var cur: int64 := head;
      while (cur != -1) {
        var k: int64 := self.cg_nkind(cur);
        if (k == CGN_CON_DECL) {
          var initNode: int64 := self.cg_nc1(cur);
          if (initNode >= 0) {
            // #2026: Durch CASTS hindurchgreifen. `con H: int64 := "…"c as
            // int64` ist ein CGN_CAST UM das Literal; die Pruefung sah nur den
            // direkten Fall, der Wert fiel durch zu cg_evalConExpr — und das
            // rechnet ganzzahlig und lieferte fuer eine Zeichenkette STILL 0.
            // In std/cloud/cf/transport.lyx steht so CF_API_HOST, der Zielhost
            // JEDES Cloudflare-Aufrufs: er war 0. 15 Units betroffen.
            //
            // Dass derselbe Anfangswert an ein `var` auf Modulebene LAUT
            // abgelehnt wurde, machte es noch schwerer zu sehen: zwei
            // Entscheidungen fuer dieselbe Zuweisung.
            var conStrN: int64 := initNode;
            var conStrTiefer: int64 := 1;
            while (conStrTiefer != 0) {
              conStrTiefer := 0;
              if (self.cg_nkind(conStrN) == CGN_CAST) {
                var conStrInner: int64 := self.cg_nc0(conStrN);
                if (conStrInner >= 0) { conStrN := conStrInner; conStrTiefer := 1; }
              }
            }
            if (self.cg_nkind(conStrN) == CGN_LIT_STR) {
              // Die Zeichenkette darf nur EINMAL in den Datenbereich.
              if (runde == 0) {
                var dataOff: int64 := self.cg_addStr(self.cg_nsoff(conStrN), self.cg_nslen(conStrN));
                // Die LADEART gilt immer (der Wert IST ein Datenoffset). Ob die
                // Konstante als pchar GILT, entscheidet der deklarierte Typ:
                // bei `int64` muss `PrintLn(H)` die ZAHL ausgeben, nicht den
                // Text. Ohne Typangabe bleibt es wie bisher bei pchar.
                self.cg_addConStrAddr(self.cg_nsval(cur), self.cg_nslen(cur), dataOff);
                var conStrTy: int64 := self.cg_nc0(cur);
                var conStrIstPchar: int64 := 1;
                if (conStrTy >= 0 && self.cg_nkind(conStrTy) == 60) {
                  conStrIstPchar := self.cg_seq(self.cg_nsval(conStrTy), self.cg_nslen(conStrTy), "pchar"c, 5);
                }
                if (conStrIstPchar != 0) {
                  var conStrIdx: int64 := self.cg_findConIdx(self.cg_nsval(cur), self.cg_nslen(cur));
                  if (conStrIdx >= 0) { poke8(self.conIsPchar + conStrIdx, 1); }
                }
              }
            } else if (self.cg_nkind(initNode) == CGN_IDENT
                       && self.cg_isDeclaredFunc(self.cg_nsval(initNode), self.cg_nslen(initNode)) != 0) {
              // #1589: `con f: fn(int64): int64 := Dbl;`. Der Wert ist eine
              // CODEADRESSE — cg_evalConExpr haette hier 0 eingetragen, und der
              // Aufruf `f(21)` endete in "undefined function 'f'". Gemerkt
              // wird das Paar; die Marke bekommt f, sobald Dbl emittiert ist.
              if (runde == 0) {
                self.cg_addConFn(self.cg_nsval(cur), self.cg_nslen(cur),
                                 self.cg_nsval(initNode), self.cg_nslen(initNode));
              }
            } else {
              self.cg_addCon(self.cg_nsval(cur), self.cg_nslen(cur), self.cg_evalConExpr(initNode));
              // #1499: Gleitkomma merken — entweder steht es am Typ
              // (`con PI: f64 := …`) oder der Wert ist ein Fliesskommaliteral.
              var conF64: int64 := 0;
              var conTy: int64 := self.cg_nc0(cur);
              if (conTy >= 0 && self.cg_nkind(conTy) == 60
                  && self.cg_isFloatTypeName(self.cg_nsval(conTy), self.cg_nslen(conTy)) != 0) { conF64 := 1; }
              if (self.cg_nkind(initNode) == CGN_LIT_FLOAT) { conF64 := 1; }
              if (conF64 != 0) {
                var ci: int64 := self.cg_findConIdx(self.cg_nsval(cur), self.cg_nslen(cur));
                if (ci >= 0) { poke8(self.conIsF64 + ci, 1); }
              }
            }
          }
        } else if (k == CGN_ENUM_DECL) {
          if (runde == 0) {
            var mem: int64 := self.cg_nc0(cur);
            var nextVal: int64 := 0;
            while (mem != -1) {
              var valNode: int64 := self.cg_nc0(mem);
              // #2127: der Wert wird GEFALTET wie in cg_buildEnumLayout — die
              // beiden muessen uebereinstimmen. Bis 1.2.14C galt hier nur ein
              // Literal: `A = 2 + 3` ergab ohne Praefix still den Positionswert
              // 0, mit Praefix (`E.A`) 5. Was sich nicht falten laesst, meldet
              // cg_buildEnumLayout laut.
              if (valNode >= 0 && self.cg_foldConst(valNode) != 0) {
                nextVal := self.foldBuf;
              }
              self.cg_addCon(self.cg_nsval(mem), self.cg_nslen(mem), nextVal);
              nextVal += 1;
              mem := self.cg_nnext(mem);
            }
          }
        } else if (k == CGN_BLOCK) {
          self.cg_collectCons(self.cg_nc0(cur));   // @if-Zweig
        }
        cur := self.cg_nnext(cur);
      }
      runde += 1;
    }
  }

  // #2102: Einen Import abarbeiten. Bis 1.2.13F geschah das erst im
  // Hauptdurchlauf von cg_genFile, also NACH cg_collectCons — eine Konstante,
  // deren Startwert eine Konstante der importierten Unit nennt
  // (`pub con B_SIZE := A_SIZE;`), fand sie nicht und bekam still -1, sobald
  // das Programm die Quell-Unit nicht selbst zuerst importierte. Jetzt laufen
  // alle Importe einer Unit vor ihren Konstanten (cg_genFile).
  fn cg_genImportDecl(cur: int64) {
    // Process the imported module (WP-09: import resolution)
    var modName: pchar := self.cg_nsval(cur);
    var modLen:  int64 := self.cg_nslen(cur);
    // #1384: `import pfad.*;`. Der Codegen laeuft seine Importe getrennt
    // von sema durch — er braucht dieselbe Liste, und die kommt aus
    // derselben Funktion (src/wildcard_import.lyx), damit die beiden Wege
    // nicht auseinanderlaufen koennen.
    if (self.cg_nival(cur) == 1) {
      var wcListe: int64 := alloc(CG_WC_MAX_UNITS * 16);
      var wcN: int64 := WildcardUnits(modName, modLen, self.includePath, self.stdPath,
                                      wcListe, CG_WC_MAX_UNITS);
      var wcI: int64 := 0;
      while (wcI < wcN) {
        self.cg_processImport(peek64(wcListe + wcI * 16) as pchar,
                              peek64(wcListe + wcI * 16 + 8));
        wcI := wcI + 1;
      }
      return;
    }
    // #1262: Aliasknoten steht in c0.
    var aliNi: int64 := self.cg_nc0(cur);
    if (aliNi >= 0 && self.cg_nkind(aliNi) != CGN_IDENT) { aliNi := 0 - 1; }
    if (aliNi >= 0) {
      self.cg_processImportAs(modName, modLen,
                              self.cg_nsval(aliNi) as int64, self.cg_nslen(aliNi));
    }
    if (aliNi < 0) {
      self.cg_processImport(modName, modLen);
    }
  }

  fn cg_genFile(head: int64) {
    self.topLevelHead := head;   // A1: früh setzen (für cg_isDeclaredFunc beim Fn-Name-als-Wert)
    // #2134: generische Funktionen dieser Unit samt Kontext — vor jedem
    // Rumpf, der sie aufrufen koennte.
    self.cg_genRegistriere(head);
    // #2004: Die EINHEITENTYPEN muessen VOR den f64-Funktionen gesammelt
    // werden. cg_collectF64Funcs entscheidet ueber cg_isFloatTypeName, ob eine
    // Funktion Gleitkomma zurueckgibt — und diese Frage beantwortet seit #1955
    // auch cg_findUtype: ein Einheitentyp rechnet in Gleitkomma.
    //
    // Stand cg_collectUtypes danach, war die Tabelle beim Fragen noch LEER.
    // Jede Funktion mit Einheiten-Rueckgabetyp galt deshalb als ganzzahlig,
    // und `machW(i) as int64` lieferte statt der Zahl das rohe IEEE-Bitmuster:
    // aus 358 wurde 4645005618795511808. Kein Abbruch, keine Meldung.
    //
    // Der Fehler sah nach einem `wraps`-Problem aus und war keines — eine
    // Einheit OHNE wraps traf es genauso. Das Verhalten hing allein daran, ob
    // der Wert durch eine FUNKTION lief oder in einer lokalen Variablen blieb.
    self.cg_collectUtypes(head);          // #1110: Einheitentypen samt Faktor
    self.cg_collectWertAliase(head);      // #2161: `type Meter = f64`
    // Pre-pass: collect all user-defined functions returning f64 for cg_isF64Expr.
    self.cg_collectF64Funcs(head);
    self.cg_sammleEinbettbare(head);      // #2208
    // #2044: Marken der inneren Funktionen — nach den Signatur-Registern
    // (cg_nestPlan traegt die inneren dort unter ihrer Marke nach) und vor
    // jedem Rumpf.
    self.cg_nestPlan(head);
    self.cg_collectMethodAliases(head);   // B2: method-Typ-Aliase registrieren
    self.cg_fnWertAliaseAufloesen();      // #2133: braucht die fn-Aliase
    self.cg_collectRangeTypes(head);      // #1097: Bereichstypen samt Grenzen
    self.cg_collectIfaceSelectors(head);  // #1133: Interface-Selektoren (vor den Layouts!)
    self.cg_prebuildStructLayouts(head);  // #1451: Layouts vor jedem Rumpf
    self.cg_prebuildClassLayouts(head);   // #1663: dasselbe fuer Klassen
    self.cg_prebuildGlobals(head);        // #1665: und fuer Modulvariablen
    self.cg_collectFlightCrit(head);      // #1140: gibt es @flight_crit im Programm?
    self.cg_collectIntegrity(head);       // #1878: gibt es @integrity im Programm?
    // #1338/#1507: Konstanten und Enums verweisen wechselseitig aufeinander —
    // `enum R { CTRL = BASE }` braucht die Konstante, `con MASK := P.Read as
    // int64` das Enum. Deshalb dreimal: erst die Konstanten aus Literalen,
    // dann die Enums (die nun BASE kennen), dann die Konstanten erneut (die
    // nun P.Read kennen). Eine Reihenfolge allein kann es nicht geben.
    // #2102: erst die Importe — ihre oeffentlichen Konstanten muessen
    // bekannt sein, bevor die eigenen ausgerechnet werden.
    var impCur: int64 := head;
    while (impCur != -1) {
      if (self.cg_nkind(impCur) == CGN_IMPORT) { self.cg_genImportDecl(impCur); }
      impCur := self.cg_nnext(impCur);
    }
    self.cg_collectCons(head);
    self.cg_prebuildEnums(head);
    // #2102: Der letzte Durchlauf ist STRENG — ein Name, den es dann noch
    // nicht als Konstante gibt, wird gemeldet statt still -1 zu werden.
    self.conStrengAnf := 1;
    self.cg_collectCons(head);            // #1338: Konstanten VOR den Rumpfen
    self.conStrengAnf := 0;
    self.conStreng := 0;

    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_FUNC_DECL) {
        // extern fn NAME(...) link "lib.so": no body (c2 == -1) and a packed
        // library span in c3 ((len<<32)|off). Register it as an FFI import
        // instead of emitting a function body. The (body==-1 && c3!=-1) test
        // distinguishes externs from @export functions, which share iVal==1
        // but always carry a body.
        var libPacked: int64 := self.cg_nc3(cur);
        // #1287: c2 traegt den RUMPF — bei `extern fn` gibt es keinen, also -1.
        // Steht aber ein `@cap(...)` an der Deklaration, legt der Parser dort
        // die Annotation ab. Der Test "c2 == -1" las das als "hat einen Rumpf",
        // die Deklaration lief in cg_genFuncDecl und wurde als LEERE Funktion
        // emittiert: der Aufruf traf sie, tat nichts und lieferte 0 — kein
        // DT_NEEDED, kein PLT-Eintrag, das Binary blieb statisch. Genau die
        // Annotation, mit der jemand sagt "ich weiss, was ich tue", schaltete
        // den FFI-Aufruf also ab.
        var exBody: int64 := self.cg_nc2(cur);
        var exHasBody: int64 := 1;
        if (exBody == -1) { exHasBody := 0; }
        else if (self.cg_nkind(exBody) == CGN_CAPABILITY_ATTR) { exHasBody := 0; }
        if (self.cgNurDekl != 0) {
          // #2014: aus einer .lyu — kein Rumpf, keine Marke. Nur merken, damit
          // ein Aufruf mit dem richtigen Grund abgewiesen wird.
          self.cg_lyuNameMerke(self.cg_nsval(cur) as int64, self.cg_nslen(cur));
        } else if (exHasBody == 0 && libPacked != -1) {
          var libOff: int64 := libPacked & 0xFFFFFFFF;
          var libLen: int64 := (libPacked >> 32) & 0xFFFFFFFF;
          if (libLen > 0) {
            self.cg_addExternDecl(self.cg_nsval(cur), self.cg_nslen(cur),
                                  (self.pSrc as int64) + libOff, libLen, cur);   // #1486
          }
        } else {
          self.cg_genFuncDecl(cur);
        }
      } else if (k == CGN_RESOURCE) {
        // #1961 Stufe 2: nur MERKEN. Ausgelegt wird die Tabelle am Ende
        // (cg_patchAll → cg_emitResTable), wenn feststeht, wie viele es sind
        // und wo die Daten liegen.
        var rPfadN: int64 := self.cg_nc0(cur);
        self.cg_addResource(self.cg_nsval(cur), self.cg_nslen(cur),
                            self.cg_nsval(rPfadN), self.cg_nslen(rPfadN));
      } else if (k == CGN_EXTERN_DATA) {
        // WSP-07: externes Daten-Symbol registrieren (Name → UNDEF-Symbol in cg_writeELFObj).
        self.cg_addExternData(self.cg_nsval(cur), self.cg_nslen(cur));
      } else if (k == CGN_IMPORT) {
        // #2102: schon vor den Konstanten abgearbeitet (cg_genImportDecl).
      } else if (k == CGN_TYPE_DECL) {
        // B2: Typ-Alias (iv-Bit1) — kein Klassen/Struct-Layout. c0 = Alias-Target (kein Feld).
        // method-Aliase sind bereits via cg_collectMethodAliases registriert.
        if ((self.cg_nival(cur) & 2) != 0) {
          // nichts zu bauen — Alias ist reine Typ-Umbenennung
        } else {
        // NK_TYPE_DECL: class if it has methods (nc1 != -1), struct otherwise
        var hasMethods: int64 := self.cg_nc1(cur);
        // WP-BC-L2: a method-less class that `extends` a class WITH a vtable must
        // also be class-layout, so it inherits the vtable pointer + slots.
        var forceClass: int64 := 0;
        var tdParent: int64 := self.cg_nc2(cur);
        if (tdParent >= 0) {
          var tdPi: int64 := self.cg_findClass(self.cg_nsval(tdParent), self.cg_nslen(tdParent));
          if (tdPi >= 0) {
            if (peek64(self.classLayouts + tdPi * CG_CLASS_SZ + CG_CLASS_OFF_VMTSLOTS) > 0) { forceClass := 1; }
          }
        }
        if ((self.cg_nival(cur) & 32) != 0) {
          // #1133: Interface. Es bekommt ein Klassen-Layout, damit der Aufruf
          // ueber den Interface-Typ die Slotnummer findet — aber KEINE
          // Methodenruempfe. Bis 1.0.14C entstand fuer jede Interface-Methode
          // ein leerer Rumpf (`I_Zeig`), der 0 zurueckgab; genau den rief der
          // Aufruf ueber die Schnittstelle auf.
          // #1663: schon im Vorlauf gebaut — hier nur noch nachziehen, falls
          // der Vorlauf sie nicht erfasst hat.
          if (self.cg_findClass(self.cg_nsval(cur), self.cg_nslen(cur)) < 0) {
            self.cg_buildClassLayout(cur);
          }
        } else if (hasMethods == -1 && forceClass == 0) {
          // No methods → treat as struct (fields start at offset 0, no VMT)
          self.cg_buildStructLayout(cur);
        } else {
          // Has methods → class layout (fields at offset 8, VMT at 0)
          // #1663: der Vorlauf hat es in aller Regel schon getan.
          if (self.cg_findClass(self.cg_nsval(cur), self.cg_nslen(cur)) < 0) {
            self.cg_buildClassLayout(cur);
          }
          var clsName: pchar := self.cg_nsval(cur);
          var clsLen:  int64 := self.cg_nslen(cur);
          var method: int64 := hasMethods;
          while (method != -1) {
            var nextM: int64 := self.cg_nnext(method);
            // WP-BC-20: skip abstract methods (bit3 of iVal) — no code body
            var isAbstM: int64 := (self.cg_nival(method) >> 3) & 1;
            if (self.cgNurDekl != 0 && isAbstM == 0) {
              // #2014: Methode aus einer .lyu. Eine VIRTUELLE bekommt einen
              // Rumpf, der sich meldet — ihr VMT-Platz darf nicht 0 bleiben
              // (Sprung nach 0, siehe #1643). Ohne Marke: ein direkter Aufruf
              // bleibt unaufgeloest und wird beim Binden gemeldet.
              self.cg_lyuMethodeMerke(clsName, clsLen, self.cg_nsval(method), self.cg_nslen(method));
              if (((self.cg_nival(method) >> 1) & 1) != 0) {
                self.cg_genLyuStub(method, clsName, clsLen);
              }
            } else if (isAbstM == 0) {
              self.cg_genMethodDecl(method, clsName, clsLen);
            } else {
              // #1643: statt zu ueberspringen einen Rumpf, der sich meldet.
              self.cg_genAbstractStub(method, clsName, clsLen);
            }
            method := nextM;
          }
        }
        }
      } else if (k == CGN_STRUCT_DECL) {
        // Standalone struct declaration: register field layout (fields at offset 0)
        self.cg_buildStructLayout(cur);
      } else if (k == CGN_ENUM_DECL) {
        // BUG-08: Enum declaration: register variant layout for match analysis
        self.cg_buildEnumLayout(cur);
        // Register enum members as int64 constants (auto-increment from 0)
        var emem: int64 := self.cg_nc0(cur);
        var eVal: int64 := 0;
        while (emem != -1) {
          var evNode: int64 := self.cg_nc0(emem);
          // #2127: gefaltet wie in cg_buildEnumLayout und cg_collectCons.
          if (evNode >= 0 && self.cg_foldConst(evNode) != 0) {
            eVal := self.foldBuf;
          }
          self.cg_addCon(self.cg_nsval(emem), self.cg_nslen(emem), eVal);
          eVal += 1;
          emem := self.cg_nnext(emem);
        }
      } else if (k == CGN_VAR_DECL) {
        // Global variable: allocate 8 bytes in data section, register in global table
        // #1665: Der Vorlauf hat den Slot bereits angelegt — gIdx ist deshalb
        // der GEFUNDENE Eintrag, nicht der naechste freie.
        var doff: int64 := self.cg_addGlobal(self.cg_nsval(cur), self.cg_nslen(cur));
        var gIdx: int64 := self.cg_findGlobalIdx(self.cg_nsval(cur), self.cg_nslen(cur));
        var gtNode: int64 := self.cg_nc0(cur);
        self.cg_recordGlobalType(gIdx, gtNode);   // #1665: eine Quelle
        // #1141: @redundant an einer GLOBALEN Variablen. Bis 1.0.14M bekam sie
        // 8 Byte und keinen Voter — das Attribut war hier ein stiller Default.
        // Jetzt liegen drei Zellen hintereinander (A = doff, B, C), genau wie
        // im Rahmen bei einem Local.
        var gRedundant: int64 := (self.cg_nival(cur) & 4) != 0;
        // #1665: Der Vorlauf hat die drei Zellen bereits angelegt; ein zweites
        // Mal wuerde nur Datenbereich verschwenden und den Zaehler verfaelschen.
        if (gRedundant != 0 && peek8(self.globalIsRedundant + gIdx) == 0) {
          poke8(self.globalIsRedundant + gIdx, 1);
          var gz: int64 := 0;
          while (gz < 16) { self.cg_edata(0); gz := gz + 1; }
          self.tmrVarCount += 1;
        }
        // #1256/#1299: Ein AGGREGAT passt nicht in den 8-Byte-Slot. Es bekommt
        // einen eigenen Block im Datenbereich, der Slot einen Zeiger darauf —
        // dieselbe Form, die ein Local zur Laufzeit per mmap anlegt, nur schon
        // zur Uebersetzungszeit. Bis 1.0.16G blieb der Slot 0: `q[0] := 3`
        // schrieb nach Adresse 16 (Kopf uebersprungen) und stuerzte ab, ein
        // `s.x := 3` verpuffte, und ein Startwert fiel ersatzlos weg.
        var aggKind: int64 := 0;      // 2 = [N]T, 3 = Struct
        var aggElems: int64 := 0;
        var aggBlock: int64 := 0 - 1;
        if (gtNode >= 0 && self.cg_nkind(gtNode) == 101) {
          var gszNode: int64 := self.cg_nc1(gtNode);
          var gN: int64 := 0;
          if (gszNode >= 0 && self.cg_nkind(gszNode) == CGN_LIT_INT) { gN := self.cg_nival(gszNode); }
          if (gN <= 0 || gN > 0x1FFFFFF) {
            EPrintStr("codegen error: globales Array '"c);
            sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
            EPrintStrLn("': Elementzahl muss eine Konstante zwischen 1 und 33554431 sein"c);
            exit(1);
          }
          // Struct-Elemente traegt ein Local als ZEIGER je Slot, den es zur
          // Uebersetzungszeit nicht gibt (jedes Element bekaeme sonst ein
          // eigenes Objekt). Das ist offen und wird gemeldet, statt still
          // Nullzeiger auszuliefern — #1256 nennt den Fall.
          var gElemTy: int64 := self.cg_nc0(gtNode);
          if (gElemTy >= 0 && self.cg_nkind(gElemTy) == 60
              && self.cg_ensureStructLayout(self.cg_nsval(gElemTy), self.cg_nslen(gElemTy)) >= 0) {
            EPrintStr("codegen error: globales Array '"c);
            sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
            EPrintStrLn("': Struct-Elemente sind auf Modulebene noch nicht umgesetzt (#1256)"c);
            EPrintStrLn("  In einer fn deklarieren, oder Felder in getrennten Arrays halten."c);
            exit(1);
          }
          if (gRedundant != 0) {
            EPrintStr("codegen error: globales Array '"c);
            sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
            EPrintStrLn("': @redundant ist fuer Aggregate nicht umgesetzt (#1256)"c);
            exit(1);
          }
          // #1230: `[N][M]T` global — flach, N*M Slots, Zeilenlaenge vermerkt.
          var gRow: int64 := 0;
          if (gElemTy >= 0 && self.cg_nkind(gElemTy) == 101) {
            var gRowSz: int64 := self.cg_nc1(gElemTy);
            if (gRowSz >= 0 && self.cg_nkind(gRowSz) == CGN_LIT_INT) { gRow := self.cg_nival(gRowSz); }
            if (gRow <= 0) {
              EPrintStr("codegen error: globales Array '"c);
              sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
              EPrintStrLn("': Zeilenlaenge muss eine Konstante > 0 sein"c);
              exit(1);
            }
            poke64(self.globalArrayRow + gIdx * 8, gRow);
          }
          var gSlots: int64 := gN;
          if (gRow > 0) { gSlots := gN * gRow; }
          aggBlock := self.cg_reserveData(16 + gSlots * 8);
          // {cap,len}-Kopf, wie ihn der Lesepfad hinter `lea rcx,[rax+16]`
          // erwartet und die Bereichspruefung aus #1156 liest.
          poke64(self.data + aggBlock,     gSlots);
          poke64(self.data + aggBlock + 8, gSlots);
          self.cg_addPatch(doff, aggBlock, 0, CG_PATCH_DATA_PTR);
          poke8(self.globalIsArray + gIdx, 2);
          poke64(self.globalArraySize + gIdx * 8, gN);
          aggKind := 2; aggElems := gN;
        } else if (gtNode >= 0 && self.cg_nkind(gtNode) == 60) {
          // #1619: `var g: T := null;` ist eine REFERENZ, die bei 0 beginnt —
          // kein Objekt. Bisher bekam jede Globale mit Klassen- oder
          // Struct-Layout hier eigenen Speicher, und der Slot wurde auf dessen
          // Adresse gepatcht; die 0 aus dem Startwert wurde davon ueberschrieben.
          // `g == 0` war deshalb immer falsch, und weil #1519 die blosse
          // Deklaration abweist und `:= 0` am Typ scheitert, gab es GAR KEINEN
          // Weg zu einer nullwertigen globalen Klassenvariablen: das
          // Lazy-Init-Muster war unschreibbar.
          //
          // Ohne Startwert bleibt es beim eigenen Speicher — dort ist die
          // Globale ein Wert, und daran haengt der Bestand.
          var gInitNi: int64 := self.cg_nc1(cur);
          var gIstNull: int64 := 0;
          if (gInitNi >= 0 && self.cg_nkind(gInitNi) == CGN_LIT_NULL) { gIstNull := 1; }
          var gsci: int64 := 0 - 1;
          if (gIstNull == 0) { gsci := self.cg_ensureStructLayout(self.cg_nsval(gtNode), self.cg_nslen(gtNode)); }
          // #1619: Ohne Startwert bekam auch eine KLASSE eigenen Speicher, und
          // der Slot zeigte darauf. `g == null` war damit immer falsch, das
          // Lazy-Init-Muster lief nie in seinen Zweig und lieferte eine
          // Referenz auf ein Objekt, das nie ein Konstruktor gesehen hat —
          // still, mit Feldern voller Nullen oder Schlimmerem.
          //
          // Eine Klasse ist eine REFERENZ: ohne Zuweisung ist sie null, so wie
          // `:= null` es schon konnte. Ein STRUCT dagegen ist ein Wert und
          // behaelt seinen Speicher; daran haengt der Bestand (dt_root in
          // std/ml.lyx ist genau so gemeint).
          // #1595: hier stand cg_istStructTyp — dieselbe Verwechslung von
          // Layout und Wertsemantik. Eine Klasse ohne Methoden ist eine
          // Referenz und bekommt keinen eigenen Speicher.
          if (gsci >= 0 && self.cg_istWertStruct(gsci) == 0) { gsci := 0 - 1; }
          if (gsci >= 0 && gRedundant == 0) {
            var gssz: int64 := self.cg_classStructSize(gsci);
            aggBlock := self.cg_reserveData(gssz);
            self.cg_addPatch(doff, aggBlock, 0, CG_PATCH_DATA_PTR);
            poke8(self.globalIsArray + gIdx, 3);
            aggKind := 3;
          }
        }

        // #2078: ein DYNAMISCHES Array (`array<T>`, `Array<T>`, `T[]`) ohne
        // Startwert. Der Slot bleibt ein Zeiger, anfangs 0; der erste `push`
        // legt den Block per mmap an (wie beim Local, cg_emitEmptyDynArray) und
        // schreibt die Adresse zurueck. Bis 1.2.13C trug die Globale keinerlei
        // Merkung: `len(g)` lieferte still 0, `g[0]` las den Slot selbst — also
        // den Zeiger — als Element. Mit Merkung 1 laufen Laenge und Index wie
        // beim lokalen dynamischen Array.
        if (aggKind == 0 && self.cg_nc1(cur) < 0 && self.cg_typIstDynArray(gtNode) != 0) {
          poke8(self.globalIsArray + gIdx, 1);
        }

        // #2150: eine MAP ohne Startwert bekommt ihre leere Map zur Laufzeit,
        // wie das Local (mapNoInit, #1152) — sonst traf der erste Zugriff
        // den Nullzeiger. Gerechnet in cg_miEinsInit; cg_miLaufzeit sagt
        // dasselbe (die beiden muessen uebereinstimmen).
        if (aggKind == 0 && self.cg_nc1(cur) < 0 && gRedundant == 0 && (gtNode >= 0 && self.cg_nkind(gtNode) == 60 && self.cg_nslen(gtNode) == 3 && self.cg_seq(self.cg_nsval(gtNode), 3, "Map", 3))) {
          self.cg_miVormerken(cur);
        }

        // Write initializer directly into data section
        //
        // #1164: Bis 1.0.15C stand hier `== CGN_LIT_INT`, und alles andere fiel
        // durch — ohne Rechnung, ohne Code, ohne Meldung. Der Datenbereich ist
        // genullt, das Ergebnis sah deshalb aus wie eine gewollte Null. Betroffen
        // war ausgerechnet `0 - 1`, die uebliche Schreibweise fuer negative
        // Werte, und ebenso ein Float-Startwert oder ein benannter con.
        var initNode: int64 := self.cg_nc1(cur);
        if (initNode >= 0) {
          var ik: int64 := self.cg_nkind(initNode);
          if (ik == 100 && aggKind == 0 && gRedundant == 0) {
            // #1299: `var arr: array := [10,20,30]` — der Typ nennt keine
            // Groesse, das Literal schon. Der Block wird also nach dem
            // Startwert bemessen; danach laeuft es wie bei `[N]T`.
            var lcnt: int64 := 0;
            var lel: int64 := self.cg_nc0(initNode);
            while (lel != -1) { lcnt := lcnt + 1; lel := self.cg_nnext(lel); }
            if (lcnt > 0) {
              aggBlock := self.cg_reserveData(16 + lcnt * 8);
              poke64(self.data + aggBlock,     lcnt);
              poke64(self.data + aggBlock + 8, lcnt);
              self.cg_addPatch(doff, aggBlock, 0, CG_PATCH_DATA_PTR);
              poke8(self.globalIsArray + gIdx, 2);
              poke64(self.globalArraySize + gIdx * 8, lcnt);
              aggKind := 2; aggElems := lcnt;
            }
          }
          if (ik == 100 && aggKind == 2) {
            // #1299: Array-Literal als globaler Startwert. Die Elemente stehen
            // fest, wenn sie konstant sind — dann werden sie hier in den Block
            // geschrieben, statt (wie im Ausdruckspfad) zur Laufzeit auf dem
            // Stack aufgebaut.
            // #2136: Ein Element, das erst zur Laufzeit feststeht, rechnet die
            // Init-Funktion der Unit (cg_miEinsInit) in denselben Block; bis
            // 1.2.15A wurde es abgewiesen.
            var aEl: int64 := self.cg_nc0(initNode);
            var aI: int64 := 0;
            var aLauf: int64 := 0;
            while (aEl != -1) {
              if (aI >= aggElems) {
                EPrintStr("codegen error: globales Array '"c);
                sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
                EPrintStrLn("': Startwert hat mehr Elemente als das Array"c);
                exit(1);
              }
              if (self.cg_isConstExpr(aEl) == 0) {
                aLauf := 1;
              } else {
                poke64(self.data + aggBlock + 16 + aI * 8, self.cg_evalConExpr(aEl));
              }
              aI := aI + 1;
              aEl := self.cg_nnext(aEl);
            }
            if (aLauf != 0) { self.cg_miVormerken(cur); }
          } else if (ik == CGN_LIT_STR) {
            // #1164: Der Startwert ist die ADRESSE der Zeichenkette. Sie steht
            // erst fest, wenn die Codelaenge feststeht (der Datenbereich folgt
            // unmittelbar darauf), also wird der Slot vorgemerkt und in
            // cg_patchAll gefuellt — samt Basis-Relokation, damit der Zeiger
            // auch auf PE und LyxOS stimmt. Bis 1.0.15C blieb hier eine 0
            // stehen: ein Nullzeiger, der wie eine leere Zeichenkette aussieht.
            var gsOff: int64 := self.cg_addStr(self.cg_nsoff(initNode), self.cg_nslen(initNode));
            self.cg_addPatch(doff, gsOff, 0, CG_PATCH_DATA_PTR);
            if (gRedundant != 0) {
              self.cg_addPatch(doff + 8,  gsOff, 0, CG_PATCH_DATA_PTR);
              self.cg_addPatch(doff + 16, gsOff, 0, CG_PATCH_DATA_PTR);
            }
          } else if (self.cg_isConstExpr(initNode) != 0) {
            // #1151: Der Wert geht hier ohne Codeerzeugung in den Datenbereich —
            // die Kuerzung muss deshalb der Compiler selbst rechnen.
            var gRaw: int64 := self.cg_evalConExpr(initNode);
            var gInit: int64 := gRaw;
            // Ein f64-Startwert traegt IEEE-Bits; die Kuerzung auf schmale
            // Ganzzahltypen darf daran nicht drehen.
            if (ik != CGN_LIT_FLOAT) {
              gInit := self.cg_narrowConst(gRaw, self.cg_narrowKindOfTypeNode(gtNode));
            }
            poke64(self.data + doff, gInit);
            // Alle drei Kopien tragen den Anfangswert — sonst waere die Mehrheit
            // beim ersten Lesen 0 und der Initialisierer verloren.
            if (gRedundant != 0) {
              poke64(self.data + doff + 8,  gInit);
              poke64(self.data + doff + 16, gInit);
            }
          } else if (ik == CGN_CLOSURE) {
            // #1589: anonyme Funktion als globaler Startwert. Faengt sie nichts
            // ein, ist ihr Wert seit #1249 die blanke Codeadresse — also
            // genauso konstant wie der Verweis auf eine benannte Funktion, der
            // laengst geht. Die Meldung "Startwert ist zur Uebersetzungszeit
            // nicht bekannt" traf hier sachlich nicht zu.
            //
            // Der Rumpf wird hier in den Codestrom gelegt (mit Sprung
            // darueber, wie ueberall bei Lambdas); die Adresse traegt danach
            // dieselbe Patch-Art wie ein benannter Funktionsverweis.
            var glClos: int64 := self.closureCapturedCount;
            self.cg_scanClosureCaptures(self.cg_nc2(initNode), self.cg_nc0(initNode));
            var glCap: int64 := self.closureCapturedCount;
            self.closureCapturedCount := glClos;
            if (glCap != 0) {
              EPrintStr("codegen error: globale Variable '"c);
              sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
              EPrintStrLn("': die anonyme Funktion faengt Werte ein"c);
              EPrintStrLn("  Ein einfangendes Lambda lebt auf dem Heap; global gibt es dafuer keinen Ort."c);
              exit(1);
            }
            self.lastAnonName := 0;
            self.cg_genExpr(initNode);        // legt den Rumpf ab, Adresse in rax (hier tot)
            if (self.lastAnonName == 0) {
              EPrintStr("codegen error: globale Variable '"c);
              sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
              EPrintStrLn("': anonyme Funktion konnte nicht abgelegt werden"c);
              exit(1);
            }
            self.cg_addPatch(doff, self.lastAnonName, self.lastAnonNameLen, CG_PATCH_DATA_FN);
            poke8(self.globalIsFnPtr + gIdx, 1);
          } else if (ik == CGN_IDENT && self.cg_isDeclaredFunc(self.cg_nsval(initNode), self.cg_nslen(initNode)) != 0) {
            // #1574: `var gFn: fn(f64): f64 = Triple;` — der Startwert IST
            // uebersetzungszeitkonstant, nur eben eine Codeadresse. Bis 1.1.0A
            // fiel er in den Zweig darunter und wurde als "nicht bekannt"
            // gemeldet, obwohl derselbe Typ als Local seit #885 funktioniert.
            self.cg_addPatch(doff, self.cg_nsval(initNode) as int64,
                             self.cg_nslen(initNode), CG_PATCH_DATA_FN);
            poke8(self.globalIsFnPtr + gIdx, 1);
            if (gRedundant != 0) {
              self.cg_addPatch(doff + 8,  self.cg_nsval(initNode) as int64,
                               self.cg_nslen(initNode), CG_PATCH_DATA_FN);
              self.cg_addPatch(doff + 16, self.cg_nsval(initNode) as int64,
                               self.cg_nslen(initNode), CG_PATCH_DATA_FN);
            }
          } else {
            // #2136: Nicht ausrechenbar — bis 1.2.15A wurde hier abgewiesen
            // ("Startwert ist zur Uebersetzungszeit nicht bekannt"). Jetzt
            // rechnet ihn die Init-Funktion der Unit vor main.
            self.cg_miVormerken(cur);
          }
        }
      } else if (k == CGN_CON_DECL) {
        // #1338: bereits im Vorpass cg_collectCons eingetragen.
      } else if (k == CGN_ENUM_DECL) {
        // WP-10f: Enum-Mitglieder sind Konstanten — seit #1338 traegt sie der
        // Vorpass cg_collectCons ein, damit sie auch in einer Funktion
        // DARUEBER gelten.
      } else if (k == CGN_DIM_DECL || k == CGN_UTYPE_DECL) {
        // WP-BC-16: rein uebersetzungszeitlich; kein Code. Die Faktoren und
        // Grenzen sammelt cg_collectUtypes vorab ein (#1110).
      } else if (k == CGN_BLOCK) {
        // WP-CS-06: inlined @if branch — recurse into children
        self.cg_genFile(self.cg_nc0(cur));
      } else if (k == CGN_AT_DIRECTIVE) {  // WP-CS-07 / WP-AS-04/05 top-level
        var kind: int64 := self.cg_nival(cur);
        var val:  int64 := self.cg_nc0(cur);
        if (kind == 0) { self.ioCheckEnabled       := val; }
        if (kind == 1) { self.overflowCheckEnabled := val; }
        if (kind == 2) { self.boundsCheckEnabled   := val; }  // WP-AS-04
        if (kind == 2) { self.boundsCheckForced    := val; }  // #1124
        if (kind == 3) { self.debugMode            := val; }  // WP-AS-05
        if (kind == 4) { self.optLevel             := val; }  // WP-AS-04
      } else if (k == CGN_AT_CPU) {  // #2191: top-level @cpu(stufe)
        // Wie bei @energy ein BEREICHS-Stand: cg_genFuncDecl bestimmt die
        // Stufe je Funktion neu und wuerde einen nur hier gesetzten Wert
        // sonst zugunsten des CLI-Flags verwerfen.
        self.scopeCpuStufe := self.cg_nival(cur);
        self.fnCpuStufe    := self.cg_nival(cur);
      } else if (k == CGN_AT_ENERGY) {  // WP-EN-04: top-level @energy(N)
        // #1162: als Quelltext-Stand vermerken, nicht nur als aktuelle Stufe —
        // genFunc bestimmt die Stufe je Funktion neu und verwarf den Wert
        // sonst zugunsten des CLI-Flags.
        self.scopeEnergyLevel := self.cg_nival(cur);
        self.fnEnergyLevel    := self.cg_nival(cur);
      }
      cur := self.cg_nnext(cur);
    }
    // #2134: Hier standen die Sprungmarken der typgeloeschten Instanzen
    // (WP-BC-24). Die Spezialisierungen entstehen jetzt in Generate
    // (cg_genEmitPending), nachdem alle Units durchlaufen sind.
    // #1140: Restorer und SIGFPE-Handler ans Ende des Codes — nur wenn das
    // Programm ueberhaupt eine @flight_crit-Funktion hat.
    if (self.fcSeen != 0) { self.cg_fcEmitHandler(); }
    // #1878: Abbruchpfad und Sweep-Handler — je EINMAL. cg_genFile laeuft je
    // importierter Einheit erneut; ohne die Marke stuenden die Marken doppelt
    // im Erzeugnis.
    if (self.lockstepSeen != 0 && self.lockstepFailEmitted == 0) {
      self.lockstepFailEmitted := 1;
      self.cg_lockstepEmitFail();
    }
    if (self.scrubSeen != 0 && self.scrubEmitted == 0) {
      self.scrubEmitted := 1;
      self.cg_scrubEmitHandler();
    }
  }

