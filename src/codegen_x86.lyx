  // WP-BC-40: Look up or allocate a profiling entry for the given name.
  // Returns the data section offset of {tsc_start(8), call_count(8), total_cycles(8)}.
  // Also stores the name string in the data section (nameDataOff) for profile_report.
  fn cg_findOrAllocProfEntry(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.profEntryCount) {
      var eBase: int64 := self.profEntries + i * CG_PROF_SZ;
      var eName: pchar := peek64(eBase) as pchar;
      var eLen: int64 := peek64(eBase + CG_PR_OFF_NAMELEN);
      if (eLen == nlen) {
        var j: int64 := 0; var isMatch: int64 := 1;
        while (j < nlen) {
          if (StrCharAt(eName, j) != StrCharAt(name, j)) { isMatch := 0; }
          j += 1;
        }
        if (isMatch == 1) { return peek64(eBase + CG_PR_OFF_DOFF); }
      }
      i += 1;
    }
    if (self.profEntryCount >= self.profEntryCap) {
      var nc: int64 := self.profEntryCap * 2;
      var nb: int64 := alloc(nc * 32);
      var j: int64 := 0;
      memcpy(nb, self.profEntries, self.profEntryCount * CG_PROF_SZ);
      free(self.profEntries, self.profEntryCap * CG_PROF_SZ);
      self.profEntries := nb;
      self.profEntryCap := nc;
    }
    // Allocate runtime slots: tsc_start(8) + call_count(8) + total_cycles(8) = 24 bytes
    var dOff: int64 := self.dataLen;
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);  // tsc_start
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);  // call_count
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);  // total_cycles
    // Store name string in data section for profile_report output
    var nDOff: int64 := self.dataLen;
    var k: int64 := 0;
    while (k < nlen) { self.cg_edata(StrCharAt(name, k)); k := k + 1; }
    var eBase: int64 := self.profEntries + self.profEntryCount * CG_PROF_SZ;
    poke64(eBase,      name as int64);
    poke64(eBase + CG_PR_OFF_NAMELEN,  nlen);
    poke64(eBase + CG_PR_OFF_DOFF, dOff);
    poke64(eBase + CG_PR_OFF_NDOFF, nDOff);
    self.profEntryCount += 1;
    return dOff;
  }

  // WP-11: Parse float literal string src[off..off+len) to IEEE 754 double bits.
  // Handles: N, N.M, N[eE][+-]P format.
  fn cg_parseFloat(src: pchar, off: int64, len: int64): int64 {
    var i: int64 := off;
    var end: int64 := off + len;
    var neg: int64 := 0;
    if (i < end && StrCharAt(src, i) == 45) { neg := 1; i := i + 1; }
    var num: int64 := 0;
    var den: int64 := 1;
    var intExtra: int64 := 0;
    // Digit separators ('_') are accepted by the lexer in the whole literal
    // (ebnf.md §1), so every digit loop here has to skip them — a loop that
    // merely stops at '_' silently truncates the value (3.14_159 → 3.14).
    while (i < end) {
      var ic: int64 := StrCharAt(src, i);
      if (ic == 95) { i += 1; }
      else if (ic >= 48 && ic <= 57) {
        if (num < 900000000000000) { num := num * 10 + ic - 48; }
        else { intExtra := intExtra + 1; }
        i += 1;
      } else { break; }
    }
    if (i < end && StrCharAt(src, i) == 46) {
      i += 1;
      if (intExtra == 0) {
        while (i < end && den < 100000000) {
          var fc: int64 := StrCharAt(src, i);
          if (fc == 95) { i += 1; }
          else if (fc >= 48 && fc <= 57) {
            num := num * 10 + fc - 48;
            den := den * 10;
            i += 1;
          } else { break; }
        }
      }
      while (i < end) {
        var sc: int64 := StrCharAt(src, i);
        if (sc == 95 || (sc >= 48 && sc <= 57)) { i := i + 1; } else { break; }
      }
    }
    var expNeg: int64 := 0;
    var expVal: int64 := 0;
    if (i < end && (StrCharAt(src, i) == 101 || StrCharAt(src, i) == 69)) {
      i += 1;
      if (i < end && StrCharAt(src, i) == 45) { expNeg := 1; i := i + 1; }
      else if (i < end && StrCharAt(src, i) == 43) { i := i + 1; }
      while (i < end) {
        var xc: int64 := StrCharAt(src, i);
        if (xc == 95) { i += 1; }
        else if (xc >= 48 && xc <= 57) {
          expVal := expVal * 10 + xc - 48;
          i += 1;
        } else { break; }
      }
    }
    if (num == 0) { return 0; }
    // Fold dropped integer digits into the exponent (intExtra excess digits = *10^intExtra).
    if (intExtra > 0) {
      if (expNeg == 0) {
        expVal += intExtra;
      } else {
        if (expVal > intExtra) { expVal := expVal - intExtra; }
        else { expNeg := 0; expVal := intExtra - expVal; }
      }
    }
    var ej: int64 := 0;
    if (expNeg == 0) {
      while (ej < expVal && num < 100000000000000) { num := num * 10; ej := ej + 1; }
    } else {
      while (ej < expVal && den < 100000000000000) { den := den * 10; ej := ej + 1; }
    }
    // R7: apply remaining exponent factors.
    // Positive exp: multiply n by 10; halve n (not d) to prevent overflow and
    // track halvings in binExp so the value n/d * 2^binExp is preserved.
    // Negative exp: multiply d by 10; halve both n and d to prevent d overflow.
    var n: int64 := num;
    var d: int64 := den;
    var binExp: int64 := 0;
    if (expNeg == 0) {
      while (ej < expVal) {
        while (n > 922337203685477580) {
          n := n / 2;
          binExp += 1;
        }
        n := n * 10;
        ej += 1;
      }
    } else {
      while (ej < expVal) {
        while (d > 922337203685477580) {
          d := d / 2;
          n := n / 2;
        }
        d := d * 10;
        if (n == 0) { return 0; }
        ej += 1;
      }
    }
    // Normalize: find binary exponent so n/d ∈ [1, 2)
    while (n < d && n > 0) {
      if (n > 4611686018427387903) { d := d / 2; if (d == 0) { d := 1; } }
      else { n := n * 2; }
      binExp -= 1;
      if (binExp < -1074) { return 0; }
    }
    while (d < 4611686018427387903 && n >= d * 2) {
      d := d * 2; binExp := binExp + 1;
      if (binExp > 1023) {
        var pInf: int64 := 2047; pInf := pInf << 52;
        if (neg != 0) {
          var smI: int64 := 1; var sI: int64 := 0;
          while (sI < 63) { smI := smI * 2; sI := sI + 1; }
          return pInf | smI;
        }
        return pInf;
      }
    }
    n -= d;
    var mant: int64 := 0;
    var bit: int64 := 51;
    while (bit >= 0) {
      if (n > 4000000000000000) { n := n / 2; d := d / 2; if (d == 0) { d := 1; } }
      n := n * 2;
      if (n >= d) { mant := mant | (1 << bit); n := n - d; }
      bit -= 1;
    }
    var biasedE: int64 := binExp + 1023;
    if (biasedE <= 0) { return 0; }
    if (biasedE >= 2047) {
      var pInf2: int64 := 2047; pInf2 := pInf2 << 52;
      if (neg != 0) {
        var smJ: int64 := 1; var sJ: int64 := 0;
        while (sJ < 63) { smJ := smJ * 2; sJ := sJ + 1; }
        return pInf2 | smJ;
      }
      return pInf2;
    }
    var bits: int64 := (biasedE << 52) | mant;
    if (neg != 0) {
      var sm: int64 := 1; var sk: int64 := 0;
      while (sk < 63) { sm := sm * 2; sk := sk + 1; }
      bits := bits | sm;
    }
    return bits;
  }

  // call rel32  — placeholder; returns position of rel32 for patching
  fn cg_emitCall(): int64 {
    self.cg_e8(0xE8);
    var pos: int64 := self.codeLen;
    self.cg_e32(0);
    return pos;
  }

  // Emit function prologue: push rbp; mov rbp, rsp; sub rsp, imm32 (placeholder)
  // WP-18: Also reserves rbp-8 for stack canary (loads fs:0x28 there, clears rax).
  // Returns: code position of the imm32 (for later patching with final frame size)
  fn cg_emitPrologue(): int64 {
    self.cg_e8(0x55);                          // push rbp
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE5);  // mov rbp, rsp
    // sub rsp, imm32 (48 81 EC xx xx xx xx)
    self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC);
    var patchPos: int64 := self.codeLen;
    self.cg_e32(0);
    // WP-18: reserve [rbp-8] for canary before any locals
    self.frameSize += 8;
    // mov rax, [rip+CG_CANARY]  (load canary from global; patched by CG_PATCH_STR)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05);
    var pCanaryLoad: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pCanaryLoad, CG_CANARY, 0, CG_PATCH_STR);
    // mov [rbp-8], rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x45); self.cg_e8(0xF8);
    // xor rax, rax  (clear canary from register)
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    return patchPos;
  }

  // Emit function epilogue: check stack canary, then mov rsp,rbp; pop rbp; ret
  // WP-18: Uses r10/r11 (scratch) to compare [rbp-8] with _lyx_canary global.
  //        Does NOT touch rax (return value).
  fn cg_emitEpilogue() {
    // WP-18: canary check — r10/r11 are caller-saved scratch, do not affect rax
    // mov r11, [rbp-8]
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x5D); self.cg_e8(0xF8);
    // mov r10, [rip+CG_CANARY]  (expected canary from global)
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x15);
    var pCanaryChk: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pCanaryChk, CG_CANARY, 0, CG_PATCH_STR);
    // xor r11, r10
    self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xD3);
    // jnz __lyx_stack_fail (0F 85 rel32)
    self.cg_e8(0x0F); self.cg_e8(0x85);
    var failPatch: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(failPatch, "__lyx_stack_fail" as int64, 16, CG_PATCH_CALL);
    // Normal epilogue
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xEC);  // mov rsp, rbp
    self.cg_e8(0x5D);  // pop rbp
    self.cg_e8(0xC3);  // ret
  }

  // push rax
  fn cg_pushRax() { self.cg_e8(0x50); }
  // pop rax
  fn cg_popRax() { self.cg_e8(0x58); }
  // pop rbx
  fn cg_popRbx() { self.cg_e8(0x5B); }
  // pop rdi
  // _indirect_call_N(fnPtr, a1..aN): rohen Code-Pointer mit N Argumenten rufen.
  // argNode ist der fnPtr-Knoten, die Argumente hängen an dessen next-Kette.
  fn cg_genIndirectCallN(argNode: int64, n: int64) {
    // Argumente einsammeln
    var buf: int64 := alloc(n * 8);
    var cur: int64 := self.cg_nnext(argNode);
    var i: int64 := 0;
    while (i < n && cur != -1) {
      poke64(buf + i * 8, cur);
      cur := self.cg_nnext(cur);
      i += 1;
    }
    // in umgekehrter Reihenfolge pushen: aN zuerst, a1 zuletzt → a1 liegt oben
    var j: int64 := n - 1;
    while (j >= 0) {
      self.cg_genExpr(peek64(buf + j * 8));
      self.cg_pushRax();
      j -= 1;
    }
    self.cg_genExpr(argNode);          // rax = fnPtr (nach den Argumenten, damit
                                        // deren Auswertung rax nicht überschreibt)
    if (n >= 1) { self.cg_popRdi(); }
    if (n >= 2) { self.cg_popRsi(); }
    if (n >= 3) { self.cg_popRdx(); }
    if (n >= 4) { self.cg_popRcx(); }
    self.cg_e8(0xFF); self.cg_e8(0xD0);  // call rax
    free(buf, n * 8);
  }

  fn cg_popRdi() { self.cg_e8(0x5F); }
  // pop rsi
  fn cg_popRsi() { self.cg_e8(0x5E); }
  // pop rdx
  fn cg_popRdx() { self.cg_e8(0x5A); }
  // pop rcx
  fn cg_popRcx() { self.cg_e8(0x59); }

  // xor rax, rax  (zero rax)
  fn cg_zeroRax() {
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
  }

  // neg rax
  fn cg_negRax() {
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xD8);
  }

  // not rax  (bitwise NOT)
  fn cg_notRax() {
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xD0);
  }

  // test rax, rax; setnz al; movzx rax, al  (convert any non-zero to 1)
  fn cg_boolRax() {
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
    self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC0);   // setnz al
    self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);  // movzx rax, al
  }

  fn cg_registerF64Func(name: pchar, nameLen: int64) {
    if (self.f64FuncCount >= self.f64FuncCap) {
      var nc: int64 := self.f64FuncCap * 2;
      var nb: int64 := alloc(nc * 16);
      memcpy(nb, self.f64FuncList, self.f64FuncCount * 16);
      self.f64FuncList := nb;
      self.f64FuncCap  := nc;
    }
    var base: int64 := self.f64FuncList + self.f64FuncCount * 16;
    poke64(base,     name as int64);
    poke64(base + 8, nameLen);
    self.f64FuncCount += 1;
  }

  fn cg_isF64Func(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.f64FuncCount) {
      var base: int64 := self.f64FuncList + i * 16;
      var n: pchar  := peek64(base) as pchar;
      var l: int64  := peek64(base + 8);
      if (self.cg_seq(n, l, name, nameLen) != 0) { return 1; }
      i += 1;
    }
    return 0;
  }

  // Operator overloading (Stage 2c): record a function's declared return type.
  fn cg_registerFuncRet(name: pchar, nameLen: int64, retName: pchar, retLen: int64) {
    if (self.fnRetCount >= self.fnRetCap) {
      var nc: int64 := self.fnRetCap * 2;
      var nb: int64 := alloc(nc * 32);
      memcpy(nb, self.fnRetList, self.fnRetCount * 32);
      self.fnRetList := nb;
      self.fnRetCap  := nc;
    }
    var base: int64 := self.fnRetList + self.fnRetCount * 32;
    poke64(base,      name as int64);
    poke64(base + 8,  nameLen);
    poke64(base + 16, retName as int64);
    poke64(base + 24, retLen);
    self.fnRetCount += 1;
  }

  // Operator overloading (Stage 2c): class-layout index of a function's return
  // type, or -1 if the function is unknown or doesn't return a class.
  // #1058: Traegt die Funktion `name` den deklarierten Rueckgabetyp `tname`?
  // Greift auf dieselbe Registry wie cg_funcRetClassIdx zu (Name, Rueckgabetypname).
  fn cg_funcRetTypeIs(name: pchar, nameLen: int64, tname: pchar, tlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.fnRetCount) {
      var base: int64 := self.fnRetList + i * 32;
      var n: pchar := peek64(base) as pchar;
      var l: int64 := peek64(base + 8);
      if (self.cg_seq(n, l, name, nameLen) != 0) {
        var rn: pchar := peek64(base + 16) as pchar;
        var rl: int64 := peek64(base + 24);
        if (self.cg_seq(rn, rl, tname, tlen) != 0) { return 1; }
        return 0;
      }
      i += 1;
    }
    return 0 - 1;   // Funktion unbekannt (Builtin oder importiert)
  }

  // #1058: Builtins, die einen Zeichenketten-Zeiger liefern. Sie werden im
  // Codegen unmittelbar emittiert und tragen keinen Eintrag in der
  // Rueckgabetyp-Registry; ohne diese Liste gaebe Print den Zeiger als Zahl aus.
  fn cg_builtinReturnsPchar(nm: pchar, nl: int64): int64 {
    if (self.cg_seq(nm, nl, "StrFromInt", 10)) { return 1; }
    if (self.cg_seq(nm, nl, "IntToStr",    8)) { return 1; }
    if (self.cg_seq(nm, nl, "FloatToStr", 10)) { return 1; }
    if (self.cg_seq(nm, nl, "StrConcat",   9)) { return 1; }
    if (self.cg_seq(nm, nl, "StrCopy",     7)) { return 1; }
    if (self.cg_seq(nm, nl, "StrSub",      6)) { return 1; }
    if (self.cg_seq(nm, nl, "StrNew",      6)) { return 1; }
    if (self.cg_seq(nm, nl, "StrTrim",     7)) { return 1; }
    return 0;
  }

  fn cg_funcRetClassIdx(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.fnRetCount) {
      var base: int64 := self.fnRetList + i * 32;
      var n: pchar := peek64(base) as pchar;
      var l: int64 := peek64(base + 8);
      if (self.cg_seq(n, l, name, nameLen) != 0) {
        var rn: pchar := peek64(base + 16) as pchar;
        var rl: int64 := peek64(base + 24);
        return self.cg_findClass(rn, rl);
      }
      i += 1;
    }
    return 0 - 1;
  }

  // B2: method-Typ-Alias-Registry. Name = Alias der `type X = method(...)` ist → fat pointer.
  fn cg_registerMethodAlias(name: pchar, nameLen: int64) {
    if (self.methodAliasCount >= self.methodAliasCap) {
      var nc: int64 := self.methodAliasCap * 2;
      var nb: int64 := alloc(nc * 16);
      memcpy(nb, self.methodAliasList, self.methodAliasCount * 16);
      self.methodAliasList := nb;
      self.methodAliasCap  := nc;
    }
    var base: int64 := self.methodAliasList + self.methodAliasCount * 16;
    poke64(base,     name as int64);
    poke64(base + 8, nameLen);
    self.methodAliasCount += 1;
  }
  // Stack-Argumente nach einem Aufruf wieder abräumen.
  //
  // Ab dem 7. Slot passen Argumente nicht mehr in Register und werden nach der
  // SysV-Konvention über den Stack übergeben. Der Aufrufer muss sie nach dem
  // `call` selbst entfernen — genau das fehlte. Solange der Aufruf isoliert
  // stand, fiel es nicht auf (der Frame wird beim Funktionsende ohnehin über rbp
  // zurückgesetzt). Stand er aber INNERHALB der Argumentliste eines anderen
  // Aufrufs, lagen dort bereits die ausgewerteten Argumente des äußeren Aufrufs:
  // die zurückgelassenen Slots verschoben sie, der äußere Aufruf bekam Müll oder
  // stürzte ab. `show("n7", seven(7,7,7,7,7,7,7))` verlor den Namen bzw.
  // segfaultete.
  fn cg_popStackArgs(nTotal: int64) {
    if (nTotal <= 6) { return; }
    var bytes: int64 := (nTotal - 6) * 8;
    if (bytes <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(bytes & 255);   // add rsp, imm8
    } else {
      self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xC4);                            // add rsp, imm32
      self.cg_e8(bytes & 255);
      self.cg_e8((bytes >> 8) & 255);
      self.cg_e8((bytes >> 16) & 255);
      self.cg_e8((bytes >> 24) & 255);
    }
  }

  fn cg_isMethodType(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.methodAliasCount) {
      var base: int64 := self.methodAliasList + i * 16;
      if (self.cg_seq(peek64(base) as pchar, peek64(base + 8), name, nameLen) != 0) { return 1; }
      i += 1;
    }
    return 0;
  }
  // Pre-pass: alle `type X = method(...)`-Aliase registrieren (iv-Bit1 + c0=NK_METHOD_PTR).
  fn cg_collectMethodAliases(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_TYPE_DECL && (self.cg_nival(cur) & 2) != 0) {
        var body: int64 := self.cg_nc0(cur);
        if (body >= 0 && self.cg_nkind(body) == CGN_METHOD_PTR) {
          self.cg_registerMethodAlias(self.cg_nsval(cur), self.cg_nslen(cur));
        } else if (body >= 0 && self.cg_nkind(body) == CGN_FN_PTR_NODE) {
          self.cg_registerFnAlias(self.cg_nsval(cur), self.cg_nslen(cur));
        }
      }
      cur := self.cg_nnext(cur);
    }
  }
  fn cg_registerFnAlias(name: pchar, nameLen: int64) {
    if (self.fnAliasCount >= self.fnAliasCap) {
      var nc: int64 := self.fnAliasCap * 2;
      var nb: int64 := alloc(nc * 16);
      memcpy(nb, self.fnAliasList, self.fnAliasCount * 16);
      self.fnAliasList := nb;
      self.fnAliasCap  := nc;
    }
    var base: int64 := self.fnAliasList + self.fnAliasCount * 16;
    poke64(base,     name as int64);
    poke64(base + 8, nameLen);
    self.fnAliasCount += 1;
  }
  fn cg_isFnPtrAlias(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.fnAliasCount) {
      var base: int64 := self.fnAliasList + i * 16;
      if (self.cg_seq(peek64(base) as pchar, peek64(base + 8), name, nameLen) != 0) { return 1; }
      i += 1;
    }
    return 0;
  }

  // A1: ist `name` eine deklarierte Top-Level-Funktion? (Fn-Name als Wert → Adresse statt 0)
  fn cg_isDeclaredFunc(name: pchar, nlen: int64): int64 {
    var cur: int64 := self.topLevelHead;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_FUNC_DECL) {
        if (self.cg_seq(self.cg_nsval(cur), self.cg_nslen(cur), name, nlen) != 0) { return 1; }
      }
      cur := self.cg_nnext(cur);
    }
    return 0;
  }
  // A1: Fn-Adresse laden — lea rax, [rip+disp32]; disp via CG_PATCH_CALL (= target-(pos+4), wie call).
  fn cg_emitFuncAddr(name: pchar, nlen: int64) {
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
    var pos: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pos, name as int64, nlen, CG_PATCH_CALL);
  }

  // Pre-pass: scan all CGN_FUNC_DECL nodes and register those returning f64.
  fn cg_collectF64Funcs(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_FUNC_DECL) {
        var retNi: int64 := self.cg_nc1(cur);
        if (retNi >= 0) {
          var rname: pchar := self.cg_nsval(retNi);
          var rlen:  int64 := self.cg_nslen(retNi);
          if (self.cg_seq(rname, rlen, "f64", 3) != 0) {
            self.cg_registerF64Func(self.cg_nsval(cur), self.cg_nslen(cur));
          }
          // Stage 2c: record the return type so a call expression's static
          // class can be resolved (retName -> cg_findClass at lookup time).
          if (rlen > 0) {
            self.cg_registerFuncRet(self.cg_nsval(cur), self.cg_nslen(cur), rname, rlen);
          }
        }
      }
      // Stage 2c (methods): record class methods' return types under their
      // mangled "ClassName_Method" name, so `obj.M() + x` can resolve M's class.
      if (self.cg_nkind(cur) == CGN_TYPE_DECL && (self.cg_nival(cur) & 2) == 0) {
        var cln: pchar := self.cg_nsval(cur);
        var clnLen: int64 := self.cg_nslen(cur);
        var method: int64 := self.cg_nc1(cur);
        while (method != -1) {
          var mRetNi: int64 := self.cg_nc1(method);
          if (mRetNi >= 0) {
            var mrn: pchar := self.cg_nsval(mRetNi);
            var mrl: int64 := self.cg_nslen(mRetNi);
            if (mrl > 0) {
              var lc: int64 := alloc(8);
              var mb: int64 := self.cg_mangleInto(cln, clnLen, self.cg_nsval(method), self.cg_nslen(method), lc);
              var mbLen: int64 := peek64(lc);
              free(lc, 8);
              self.cg_registerFuncRet(mb as pchar, mbLen, mrn, mrl);
              self.cg_trackTempBuf(mb, mbLen + 1);
            }
          }
          method := self.cg_nnext(method);
        }
      }
      cur := self.cg_nnext(cur);
    }
  }

  // Returns 1 if expression ni produces an f64 value (IEEE-754 bits in GP register).
  fn cg_isF64Expr(ni: int64): int64 {
    if ni < 0 { return 0; }
    var k: int64 := self.cg_nkind(ni);
    if k == CGN_LIT_FLOAT { return 1; }
    if k == CGN_IDENT {
      var idx: int64 := self.cg_findLocalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if idx < 0 { return 0; }
      var tb:  int64 := self.localTypes + idx * CG_LOCTYPE_SZ;
      var tp:  pchar := peek64(tb) as pchar;
      var tln: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
      return self.cg_seq(tp, tln, "f64"c, 3);
    }
    if k == CGN_BINOP {
      var bop: int64 := self.cg_nival(ni);
      // Comparisons and logical ops produce int64 (0/1), not f64 — don't recurse.
      if bop == CGT_AND || bop == CGT_OR { return 0; }
      if bop == CGT_EQ2 || bop == CGT_NEQ { return 0; }
      if bop == CGT_LT || bop == CGT_LE || bop == CGT_GT || bop == CGT_GE { return 0; }
      if self.cg_isF64Expr(self.cg_nc0(ni)) != 0 { return 1; }
      return self.cg_isF64Expr(self.cg_nc1(ni));
    }
    if k == CGN_CALL {
      var fp: pchar := self.cg_nsval(ni);
      var fl: int64 := self.cg_nslen(ni);
      return self.cg_isF64Func(fp, fl);
    }
    // A cast `x as f64` yields an f64. Without this, a binop whose operands are
    // both `... as f64` casts was treated as int64 and used integer division on
    // the raw IEEE-754 bit patterns (e.g. (a as f64)/(b as f64) => garbage).
    if k == CGN_CAST {
      var tn: int64 := self.cg_nc1(ni);
      if tn >= 0 {
        return self.cg_seq(self.cg_nsval(tn), self.cg_nslen(tn), "f64"c, 3);
      }
      return 0;
    }
    return 0;
  }

  // Operator overloading: the method name a binary operator maps to, or 0 if the
  // operator has no overload. + Add, - Sub, * Mul, / Div, % Mod, == Eq, != Ne,
  // < Lt, <= Le, > Gt, >= Ge. (Index [] → Get is handled on CGN_INDEX.)
  fn cg_opMethodName(op: int64): pchar {
    if (op == CGT_PLUS)    { return "Add"; }
    if (op == CGT_MINUS)   { return "Sub"; }
    if (op == CGT_STAR)    { return "Mul"; }
    if (op == CGT_SLASH)   { return "Div"; }
    if (op == CGT_PERCENT) { return "Mod"; }
    if (op == CGT_EQ2)     { return "Eq"; }
    if (op == CGT_NEQ)     { return "Ne"; }
    if (op == CGT_LT)      { return "Lt"; }
    if (op == CGT_LE)      { return "Le"; }
    if (op == CGT_GT)      { return "Gt"; }
    if (op == CGT_GE)      { return "Ge"; }
    return 0 as pchar;
  }

  // Operator overloading: the class-layout index of an expression's static type,
  // or -1 if it isn't a class-typed expression. Handles identifiers (declared
  // type from localTypes) and — so chained expressions like `(a+b)+c` work — an
  // arithmetic operator overload, whose result class is its left operand's class
  // (the Vec+Vec→Vec convention). Comparison overloads yield bool, not a class.
  fn cg_exprClassName(ni: int64): int64 {
    if (ni < 0) { return 0 - 1; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_IDENT) {
      var idx: int64 := self.cg_findLocalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if (idx < 0) { return 0 - 1; }
      var tb: int64 := self.localTypes + idx * CG_LOCTYPE_SZ;
      var cln: pchar := peek64(tb) as pchar;
      var clnLen: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
      if (cln == 0 as pchar || clnLen <= 0) { return 0 - 1; }
      return self.cg_findClass(cln, clnLen);
    }
    if (k == CGN_BINOP) {
      var bop: int64 := self.cg_nival(ni);
      if (bop == CGT_PLUS || bop == CGT_MINUS || bop == CGT_STAR ||
          bop == CGT_SLASH || bop == CGT_PERCENT) {
        return self.cg_exprClassName(self.cg_nc0(ni));
      }
      return 0 - 1;
    }
    if (k == CGN_CALL) {
      // Free function whose return type is a class, e.g. `StringFromPchar(..) + ..`.
      if (self.cg_nival(ni) == 0) {
        return self.cg_funcRetClassIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      }
      // Method call `obj.M()`: resolve the receiver's class, then look up the
      // mangled "ReceiverClass_M" in the return-type registry.
      if (self.cg_nival(ni) == 1) {
        var recvCi: int64 := self.cg_exprClassName(self.cg_nc0(ni));
        if (recvCi < 0) { return 0 - 1; }
        var lc: int64 := alloc(8);
        var mb: int64 := self.cg_buildMethodMangled(recvCi, self.cg_nsval(ni), self.cg_nslen(ni), lc);
        var mbLen: int64 := peek64(lc);
        free(lc, 8);
        var res: int64 := self.cg_funcRetClassIdx(mb as pchar, mbLen);
        self.cg_trackTempBuf(mb, mbLen + 1);
        return res;
      }
    }
    return 0 - 1;
  }

  // Build "ClassName_Method" from raw name+length pairs (neither need be NUL-
  // terminated) into a fresh tracked buffer; returns the buffer (NUL-terminated)
  // and writes its length to `lenCell`.
  fn cg_mangleInto(cln: pchar, clnLen: int64, mname: pchar, mlen: int64, lenCell: int64): int64 {
    var mangLen: int64 := clnLen + 1 + mlen;
    var mangBuf: int64 := alloc(mangLen + 1);
    var ci2: int64 := 0;
    while (ci2 < clnLen) { poke8(mangBuf + ci2, StrCharAt(cln, ci2)); ci2 := ci2 + 1; }
    poke8(mangBuf + clnLen, 95);   // '_'
    var cj: int64 := 0;
    while (cj < mlen) { poke8(mangBuf + clnLen + 1 + cj, StrCharAt(mname, cj)); cj := cj + 1; }
    poke8(mangBuf + mangLen, 0);
    poke64(lenCell, mangLen);
    return mangBuf;
  }

  // Build the mangled method name "ClassName_Method" for class-layout index `ci`.
  fn cg_buildMethodMangled(ci: int64, mname: pchar, mlen: int64, lenCell: int64): int64 {
    var cbase: int64 := self.classLayouts + ci * CG_CLASS_SZ;
    var cln: pchar := peek64(cbase) as pchar;
    var clnLen: int64 := peek64(cbase + CG_CLASS_OFF_NAMELEN);
    return self.cg_mangleInto(cln, clnLen, mname, mlen, lenCell);
  }

  // Emit a direct 1-arg method call `recv.Method(arg)`: receiver→rdi (self),
  // arg→rsi, call the (already-built, defined) mangled name. Result in rax.
  fn cg_emitClassCall(recvNi: int64, argNi: int64, mangBuf: int64, mangLen: int64) {
    self.cg_genExpr(recvNi);
    self.cg_pushRax();
    self.cg_genExpr(argNi);
    self.cg_pushRax();
    self.cg_popRsi();   // arg  → rsi
    self.cg_popRdi();   // self → rdi
    var pp: int64 := self.cg_emitCall();
    self.cg_addPatch(pp, mangBuf, mangLen, CG_PATCH_CALL);
    self.cg_trackTempBuf(mangBuf, mangLen + 1);
  }

  // Operator overloading: if the binop `ni` has a class-typed left operand and
  // that class defines the operator's method, emit `lhs.Method(rhs)` and return
  // 1. Otherwise emit nothing and return 0 (normal integer/f64/pchar path).
  // Logical NOT of rax (0 → 1, non-zero → 0). Used for the != → !Eq fallback.
  fn cg_emitLogicalNot() {
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
    self.cg_e8(0x0F); self.cg_e8(0x94); self.cg_e8(0xC0);   // sete al
    self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);  // movzx rax, al
  }

  fn cg_tryClassBinop(ni: int64): int64 {
    var op: int64 := self.cg_nival(ni);
    var mname: pchar := self.cg_opMethodName(op);
    if (mname == 0 as pchar) { return 0; }
    var lhsNi: int64 := self.cg_nc0(ni);
    var ci: int64 := self.cg_exprClassName(lhsNi);
    if (ci < 0) { return 0; }
    var lenCell: int64 := alloc(8);
    var mangBuf: int64 := self.cg_buildMethodMangled(ci, mname, StrLen(mname), lenCell);
    var mangLen: int64 := peek64(lenCell);
    free(lenCell, 8);
    if (self.cg_findLabel(mangBuf as pchar, mangLen) >= 0) {
      self.cg_emitClassCall(lhsNi, self.cg_nc1(ni), mangBuf, mangLen);
      return 1;
    }
    self.cg_trackTempBuf(mangBuf, mangLen + 1);
    // != fallback: a class that defines Eq but not Ne still gets `!=` as !(Eq).
    if (op == CGT_NEQ) {
      var lc2: int64 := alloc(8);
      var eqBuf: int64 := self.cg_buildMethodMangled(ci, "Eq", 2, lc2);
      var eqLen: int64 := peek64(lc2);
      free(lc2, 8);
      if (self.cg_findLabel(eqBuf as pchar, eqLen) >= 0) {
        self.cg_emitClassCall(lhsNi, self.cg_nc1(ni), eqBuf, eqLen);
        self.cg_emitLogicalNot();
        return 1;
      }
      self.cg_trackTempBuf(eqBuf, eqLen + 1);
    }
    return 0;
  }

  // Operator overloading: if `ni` is `base[idx]` with a class-typed base that
  // defines Get, emit `base.Get(idx)` and return 1; otherwise return 0.
  fn cg_tryClassIndex(ni: int64): int64 {
    var baseNi: int64 := self.cg_nc0(ni);
    var ci: int64 := self.cg_exprClassName(baseNi);
    if (ci < 0) { return 0; }
    var lenCell: int64 := alloc(8);
    var mangBuf: int64 := self.cg_buildMethodMangled(ci, "Get", 3, lenCell);
    var mangLen: int64 := peek64(lenCell);
    free(lenCell, 8);
    if (self.cg_findLabel(mangBuf as pchar, mangLen) < 0) {
      self.cg_trackTempBuf(mangBuf, mangLen + 1);
      return 0;
    }
    self.cg_emitClassCall(baseNi, self.cg_nc1(ni), mangBuf, mangLen);
    return 1;
  }

  // f64 binary op: rbx=lhs IEEE-754 bits, rax=rhs IEEE-754 bits. Result in rax.
  fn cg_emitF64BinOp(op: int64) {
    // movq xmm0, rbx  (lhs)
    self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x6E); self.cg_e8(0xC3);
    // movq xmm1, rax  (rhs)
    self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x6E); self.cg_e8(0xC8);
    if op == CGT_PLUS {
      self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x58); self.cg_e8(0xC1);  // addsd xmm0, xmm1
    } else if op == CGT_MINUS {
      self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x5C); self.cg_e8(0xC1);  // subsd xmm0, xmm1
    } else if op == CGT_STAR {
      self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x59); self.cg_e8(0xC1);  // mulsd xmm0, xmm1
    } else if op == CGT_SLASH {
      self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x5E); self.cg_e8(0xC1);  // divsd xmm0, xmm1
    } else if op == CGT_GT || op == CGT_LT || op == CGT_EQ2 ||
              op == CGT_NEQ || op == CGT_GE || op == CGT_LE {
      // ucomisd xmm0, xmm1  (66 0F 2E C1)
      self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x2E); self.cg_e8(0xC1);
      if op == CGT_GT  { self.cg_e8(0x0F); self.cg_e8(0x97); self.cg_e8(0xC0); }  // seta  al
      if op == CGT_LT  { self.cg_e8(0x0F); self.cg_e8(0x92); self.cg_e8(0xC0); }  // setb  al
      if op == CGT_EQ2 { self.cg_e8(0x0F); self.cg_e8(0x94); self.cg_e8(0xC0); }  // sete  al
      if op == CGT_NEQ { self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC0); }  // setne al
      if op == CGT_GE  { self.cg_e8(0x0F); self.cg_e8(0x93); self.cg_e8(0xC0); }  // setae al
      if op == CGT_LE  { self.cg_e8(0x0F); self.cg_e8(0x96); self.cg_e8(0xC0); }  // setbe al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);     // movzx rax, al
      return;
    } else {
      self.cg_zeroRax();
      return;
    }
    // movq rax, xmm0  — result back to GP
    self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC0);
  }

  // WP-GPU-01: Emit inline SSE2 packed-f32 loop.
  // Convention: rdi=src1, rsi=src2, rdx=dst, rcx=element count.
  // Result: rax = dst ptr. Clobbers: rax, rcx, xmm0, xmm1.
  fn cg_emitSSE2BinOp(op: int64) {
    // xor eax, eax  (byte offset = 0)
    self.cg_e8(0x31); self.cg_e8(0xC0);
    // shl rcx, 2  (rcx = byte count)
    self.cg_e8(0x48); self.cg_e8(0xC1); self.cg_e8(0xE1); self.cg_e8(0x02);
    // [loop]: cmp rax, rcx
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);
    // jge +21 (.done)
    self.cg_e8(0x7D); self.cg_e8(0x15);
    // movaps xmm0, [rdi+rax]  (0F 28 04 07)
    self.cg_e8(0x0F); self.cg_e8(0x28); self.cg_e8(0x04); self.cg_e8(0x07);
    // movaps xmm1, [rsi+rax]  (0F 28 0C 06)
    self.cg_e8(0x0F); self.cg_e8(0x28); self.cg_e8(0x0C); self.cg_e8(0x06);
    // packed f32 op: addps/subps/mulps/divps xmm0, xmm1
    self.cg_e8(0x0F);
    if op == CGT_PLUS  { self.cg_e8(0x58); }
    else if op == CGT_MINUS { self.cg_e8(0x5C); }
    else if op == CGT_STAR  { self.cg_e8(0x59); }
    else                    { self.cg_e8(0x5E); }  // CGT_SLASH → divps
    self.cg_e8(0xC1);  // xmm0, xmm1
    // movaps [rdx+rax], xmm0  (0F 29 04 02)
    self.cg_e8(0x0F); self.cg_e8(0x29); self.cg_e8(0x04); self.cg_e8(0x02);
    // add rax, 16
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC0); self.cg_e8(0x10);
    // jmp -26 (back to [loop])  EB E6
    self.cg_e8(0xEB); self.cg_e8(0xE6);
    // [.done]: mov rax, rdx  (result ptr)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD0);
  }

  // Emit binary operation: rax=right operand, rbx=left operand (from stack pop)
  // Result left in rax.
  fn cg_emitBinOp(op: int64) {
    if (op == CGT_PLUS) {
      // add rax, rbx  (48 01 D8)
      self.cg_e8(0x48); self.cg_e8(0x01); self.cg_e8(0xD8);
      if (self.overflowCheckEnabled != 0) { self.cg_emitOverflowPanic(); }
    } else if (op == CGT_MINUS) {
      // sub rbx, rax; mov rax, rbx  (left - right); mov preserves OF
      self.cg_e8(0x48); self.cg_e8(0x29); self.cg_e8(0xC3);  // sub rbx, rax
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx
      if (self.overflowCheckEnabled != 0) { self.cg_emitOverflowPanic(); }
    } else if (op == CGT_STAR) {
      // imul rax, rbx  (48 0F AF C3)
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xAF); self.cg_e8(0xC3);
      if (self.overflowCheckEnabled != 0) { self.cg_emitOverflowPanic(); }
    } else if (op == CGT_SLASH) {
      // idiv: rax=right(divisor), rbx=left(dividend); want left/right
      // WP-BC-48: --runtime-checks → zero-check divisor before div
      if self.runtimeChecks != 0 {
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x75);                                         // jnz short +rel8
        var pSkipD: int64 := self.codeLen; self.cg_e8(0);
        var msgOffD: int64 := self.dataLen;
        self.cg_edata(100); self.cg_edata(105); self.cg_edata(118); // div
        self.cg_edata(105); self.cg_edata(115); self.cg_edata(105); // isi
        self.cg_edata(111); self.cg_edata(110); self.cg_edata(32);  // on
        self.cg_edata(98);  self.cg_edata(121);  self.cg_edata(32); // by
        self.cg_edata(122); self.cg_edata(101); self.cg_edata(114); // zer
        self.cg_edata(111); self.cg_edata(10);  self.cg_edata(0);   // o\n\0
        self.cg_emitLeaRdiData(msgOffD);
        self.cg_emitPanicBody();
        poke8(self.code + pSkipD, self.codeLen - pSkipD - 1);
      }
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);  // mov rcx, rax (divisor)
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx (dividend)
      self.cg_e8(0x48); self.cg_e8(0x99);                     // cqo — sign-extend rax → rdx:rax
      self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);  // idiv rcx
    } else if (op == CGT_PERCENT) {
      // same as div but result = rdx (remainder)
      // WP-BC-48: --runtime-checks → zero-check divisor before mod
      if self.runtimeChecks != 0 {
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x75);                                         // jnz short +rel8
        var pSkipM: int64 := self.codeLen; self.cg_e8(0);
        var msgOffM: int64 := self.dataLen;
        self.cg_edata(109); self.cg_edata(111); self.cg_edata(100); // mod
        self.cg_edata(117); self.cg_edata(108); self.cg_edata(111); // ulo
        self.cg_edata(32);  self.cg_edata(98);  self.cg_edata(121); //  by
        self.cg_edata(32);  self.cg_edata(122); self.cg_edata(101); //  ze
        self.cg_edata(114); self.cg_edata(111); self.cg_edata(10);  // ro\n
        self.cg_edata(0);                                            // \0
        self.cg_emitLeaRdiData(msgOffM);
        self.cg_emitPanicBody();
        poke8(self.code + pSkipM, self.codeLen - pSkipM - 1);
      }
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);  // mov rcx, rax
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx
      self.cg_e8(0x48); self.cg_e8(0x99);                     // cqo — sign-extend rax → rdx:rax
      self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);  // idiv rcx
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD0);  // mov rax, rdx
    } else if (op == CGT_SHL) {
      // shl rbx, cl  (48 D3 E3)  — rax=count → move to cl
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);  // mov rcx, rax
      self.cg_e8(0x48); self.cg_e8(0xD3); self.cg_e8(0xE3);  // shl rbx, cl
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx
    } else if (op == CGT_SHR) {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);  // mov rcx, rax
      self.cg_e8(0x48); self.cg_e8(0xD3); self.cg_e8(0xEB);  // sar rbx, cl (signed)
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx
    } else if (op == CGT_EQ2) {
      // cmp rbx, rax; sete al; movzx rax, al
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);  // cmp rbx, rax
      self.cg_e8(0x0F); self.cg_e8(0x94); self.cg_e8(0xC0);  // sete al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_NEQ) {
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);  // cmp rbx, rax
      self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC0);  // setne al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_LT) {
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);  // cmp rbx, rax
      self.cg_e8(0x0F); self.cg_e8(0x9C); self.cg_e8(0xC0);  // setl al (rbx < rax)
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_LE) {
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
      self.cg_e8(0x0F); self.cg_e8(0x9E); self.cg_e8(0xC0);  // setle al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_GT) {
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
      self.cg_e8(0x0F); self.cg_e8(0x9F); self.cg_e8(0xC0);  // setg al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_GE) {
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
      self.cg_e8(0x0F); self.cg_e8(0x9D); self.cg_e8(0xC0);  // setge al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_AND) {
      // logical and: both non-zero → 1
      // rax=right, rbx=left; test both
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
      self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC0);  // setnz al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0); // movzx rax,al
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xDB);  // test rbx, rbx
      self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC3);  // setnz bl
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xDB); // movzx rbx,bl
      self.cg_e8(0x48); self.cg_e8(0x21); self.cg_e8(0xD8);  // and rax, rbx
    } else if (op == CGT_OR) {
      // logical or
      self.cg_e8(0x48); self.cg_e8(0x09); self.cg_e8(0xD8);  // or rax, rbx
      self.cg_boolRax();
    } else if (op == CGT_BITAND) {
      // bitwise and rax, rbx
      self.cg_e8(0x48); self.cg_e8(0x21); self.cg_e8(0xD8);
    } else if (op == CGT_BITOR) {
      // bitwise or rax, rbx
      self.cg_e8(0x48); self.cg_e8(0x09); self.cg_e8(0xD8);
    } else if (op == 89) {
      // bitwise xor rax, rbx  (TK_BITXOR = 89, no CGT_BITXOR alias)
      self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD8);
    } else if (op == 88) {
      // bitwise nor: `a |~ b` = ~(a | b)  (TK_NOR = 88)
      // Der Lexer kennt |~ und der Parser gibt ihm eine Praezedenz, emittiert
      // wurde bisher aber nichts -- der Operator fiel in den Catch-all unten
      // und lieferte still 0.
      self.cg_e8(0x48); self.cg_e8(0x09); self.cg_e8(0xD8);  // or  rax, rbx
      self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xD0);  // not rax
    } else {
      // Unbekannter Operator: laut abbrechen statt still 0 zu liefern.
      EPrintStr("error: codegen: unbekannter Binaeroperator "c);
      EPrintInt(op); EPrintStrLn(""c);
      exit(70);
      self.cg_zeroRax();
    }
  }

  // ------------------------------------------------------------------
  // ------------------------------------------------------------------
  // OOP support: class layout table and local type tracking
  // ------------------------------------------------------------------

  fn cg_setLocalType(idx: int64, typePtr: pchar, typeLen: int64) {
    var base: int64 := self.localTypes + idx * CG_LOCTYPE_SZ;
    poke64(base,     typePtr as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR, typeLen);
  }

  fn cg_findClass(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.classCount) {
      var base: int64 := self.classLayouts + i * CG_CLASS_SZ;
      var p: pchar := peek64(base) as pchar;
      var n: int64 := peek64(base + CG_PATCH_OFF_NAMEPTR);
      if (n == nameLen && self.cg_seq(p, n, name, nameLen)) { return i; }
      i += 1;
    }
    return -1;
  }

  fn cg_getFieldOffset(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    return self.cg_findField(classIdx, fieldName, fieldLen);
  }

  fn cg_findField(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return -1; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar   := peek64(fb) as pchar;
      var n: int64   := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        return peek64(fb + CG_CFIELD_OFF_OFFSET);
      }
      i += 1;
    }
    return -1;
  }

  fn cg_getFieldClassIdx(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return -1; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar   := peek64(fb) as pchar;
      var n: int64   := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        var tp: pchar := peek64(fb + CG_CFIELD_OFF_TYPENAMEPTR) as pchar;
        var tn: int64 := peek64(fb + CG_CFIELD_OFF_TYPENAMELEN);
        if (tp == 0 as pchar || tn == 0) { return -1; }
        return self.cg_findClass(tp, tn);
      }
      i += 1;
    }
    return -1;
  }

  // B2: ist das Feld vom Typ eines method-Alias (→ fat pointer)? Liest Feld-Typ-Name + Registry.
  fn cg_fieldIsMethodType(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return 0; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar   := peek64(fb) as pchar;
      var n: int64   := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        // A2: method-Typ-Flag (Bit1 von fb+FLAGS), bei Layout-Build gesetzt (inline + Alias).
        return (peek64(fb + CG_CFIELD_OFF_FLAGS) >> 1) & 1;
      }
      i += 1;
    }
    return 0;
  }

  // B2: method-Referenz `obj.Method` (ungerufen) → heap-fat-pointer {code, data} (16B); rax = ptr.
  // code = Adresse von Klasse_Method (mangled), data = obj-Instanz-Pointer.
  fn cg_genMethodRef(rhs: int64) {
    var rObj:  int64 := self.cg_nc0(rhs);
    var mName: pchar := self.cg_nsval(rhs);
    var mLen:  int64 := self.cg_nslen(rhs);
    var rcls:  int64 := self.cg_objClassIdx(rObj);
    // 16B-Speicher via anon-mmap(4096) (wie new) → rax = p
    self.cg_movRaxImm(0);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7); // mov rdi,rax
    self.cg_movRaxImm(4096); self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6); // mov rsi,rax
    self.cg_movRaxImm(3);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2); // mov rdx,rax
    self.cg_movRaxImm(34);   self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2); // mov r10,rax
    self.cg_movRaxImm(-1);   self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0); // xor r8,r8
    self.cg_e8(0x49); self.cg_e8(0xFF); self.cg_e8(0xC8);                          // dec r8 → -1
    self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);                          // xor r9,r9
    self.cg_movRaxImm(9);    self.cg_e8(0x0F); self.cg_e8(0x05);                    // syscall mmap
    self.cg_pushRax();                                                              // [rsp] = p
    // code-Adresse: lea rax,[rip+ Klasse_Method ]
    if (rcls >= 0) {
      var clsBase: int64 := self.classLayouts + rcls * CG_CLASS_SZ;
      var clsName: pchar := peek64(clsBase) as pchar;
      var clsLen:  int64 := peek64(clsBase + CG_CLASS_OFF_NAMELEN);
      var mangLen: int64 := clsLen + 1 + mLen;
      var mangBuf: int64 := alloc(mangLen + 1);
      var mi: int64 := 0;
      while (mi < clsLen) { poke8(mangBuf + mi, StrCharAt(clsName, mi)); mi := mi + 1; }
      StrSetChar(mangBuf as pchar, clsLen, 95);
      var mj: int64 := 0;
      while (mj < mLen) { poke8(mangBuf + clsLen + 1 + mj, StrCharAt(mName, mj)); mj := mj + 1; }
      poke8(mangBuf + mangLen, 0);
      self.cg_emitFuncAddr(mangBuf as pchar, mangLen);   // rax = code
      self.cg_trackTempBuf(mangBuf, mangLen + 1);
    } else {
      self.cg_zeroRax();
    }
    // [p] = code
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x1C); self.cg_e8(0x24);  // mov rbx,[rsp] (p)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x03);                    // mov [rbx], rax
    // data = obj-Instanz → [p+8]
    self.cg_genExpr(rObj);                                                    // rax = data
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x1C); self.cg_e8(0x24);  // mov rbx,[rsp] (p)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x43); self.cg_e8(0x08);  // mov [rbx+8], rax
    self.cg_popRax();                                                         // rax = p (fat ptr)
  }

  // WP-4.1-B: return fb+40 flags for a named field: bit0=bigEndian, bits8..15=typeWidth.
  // Returns 0 if field not found or not big_endian.
  fn cg_getFieldBigEndian(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return 0; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar   := peek64(fb) as pchar;
      var n: int64   := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        return peek64(fb + CG_CFIELD_OFF_FLAGS);
      }
      i += 1;
    }
    return 0;
  }

  // Returns the byte size of a struct given its class index (fieldCnt * 8 for non-packed)
  fn cg_classStructSize(classIdx: int64): int64 {
    if (classIdx < 0) { return 8; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var cnt: int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    if (cnt <= 0) { return 8; }
    // WP-10.2: cnt*8 must not overflow int64
    if (cnt > 0x1FFFFFFFFFFFFFFF) { return 8; }
    // For struct fields the last field's offset + 8 = total size
    // Simpler: fieldCnt * 8 (all fields are 8 bytes in non-packed structs)
    return cnt * 8;
  }

  // Returns class index of the element type of an Array<T> field, or -1
  fn cg_getFieldElemClassIdx(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return -1; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar := peek64(fb) as pchar;
      var n: int64 := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        var ep: pchar := peek64(fb + CG_CFIELD_OFF_ELEMTYPEPTR) as pchar;
        var el: int64 := peek64(fb + CG_CFIELD_OFF_ELEMTYPELEN);
        if (ep == 0 as pchar || el == 0) { return -1; }
        return self.cg_findClass(ep, el);
      }
      i += 1;
    }
    return -1;
  }

  // Returns 1 if the named class field has type "Array<T>" (any T), 0 otherwise.
  // #1052: rax = [rax + rbx*w], breitengerecht (unsigned erweitert).
  fn cg_emitScaledLoadRax(w: int64) {
    if (w == 1) {
      // movzx rax, byte [rax+rbx*1]
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0x04); self.cg_e8(0x18);
    } else if (w == 2) {
      // movzx rax, word [rax+rbx*2]
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB7); self.cg_e8(0x04); self.cg_e8(0x58);
    } else if (w == 4) {
      // mov eax, [rax+rbx*4]  (nullt die oberen 32 Bit)
      self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0x98);
    } else {
      // mov rax, [rax+rbx*8]
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0xD8);
    }
  }

  // #1052: [rax + rbx*w] := rsi, breitengerecht.
  fn cg_emitScaledStore(w: int64) {
    if (w == 1) {
      // mov [rax+rbx*1], sil
      self.cg_e8(0x40); self.cg_e8(0x88); self.cg_e8(0x34); self.cg_e8(0x18);
    } else if (w == 2) {
      // mov [rax+rbx*2], si
      self.cg_e8(0x66); self.cg_e8(0x89); self.cg_e8(0x34); self.cg_e8(0x58);
    } else if (w == 4) {
      // mov [rax+rbx*4], esi
      self.cg_e8(0x89); self.cg_e8(0x34); self.cg_e8(0x98);
    } else {
      // mov [rax+rbx*8], rsi
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x34); self.cg_e8(0xD8);
    }
  }

  // #1052: Adresse eines inline-Array-Feldes nach rax. Fuer ein gewoehnliches
  // Feld liefert cg_genExpr den INHALT; ein inline liegendes Array hat aber
  // keinen Zeiger, seine Daten stehen unmittelbar an der Feldadresse.
  // Liefert die Elementbreite, oder 0 wenn `fieldNode` kein solches Feld ist —
  // dann hat der Aufrufer nichts emittiert bekommen.
  fn cg_emitInlineArrayAddr(fieldNode: int64): int64 {
    if (fieldNode < 0) { return 0; }
    if (self.cg_nkind(fieldNode) != CGN_FIELD) { return 0; }
    var innerObj: int64 := self.cg_nc0(fieldNode);
    var fldNm: pchar := self.cg_nsval(fieldNode);
    var fldNl: int64 := self.cg_nslen(fieldNode);
    var ci: int64 := self.cg_objClassIdx(innerObj);
    var w: int64 := self.cg_fieldInlineElemW(ci, fldNm, fldNl);
    if (w <= 0) { return 0; }
    var off: int64 := self.cg_getFieldOffset(ci, fldNm, fldNl);
    if (off < 0) { return 0; }
    self.cg_genExpr(innerObj);                 // rax = Objektzeiger
    if (off > 0) {
      // lea rax, [rax + off]
      if (off <= 127) {
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x40); self.cg_e8(off);
      } else {
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x80); self.cg_e32(off);
      }
    }
    return w;
  }

  // #1052: Zahl der Elemente eines `[N]T`-Typknotens (NK_TYPE_ARRAY_FIXED=101),
  // 0 wenn der Knoten keiner ist oder N kein Ganzzahl-Literal.
  fn cg_arrayFixedCount(typeNode: int64): int64 {
    if (typeNode < 0) { return 0; }
    if (self.cg_nkind(typeNode) != 101) { return 0; }
    var sizeNode: int64 := self.cg_nc1(typeNode);
    if (sizeNode < 0) { return 0; }
    if (self.cg_nkind(sizeNode) != CGN_LIT_INT) { return 0; }
    var n: int64 := self.cg_nival(sizeNode);
    if (n <= 0) { return 0; }
    return n;
  }

  // #1052: Elementbreite eines INLINE-Array-Feldes (`items: [4]int64`), sonst 0.
  // Abgegrenzt von cg_isFieldArray, das ausschliesslich `Array<T>` erkennt —
  // eine Heap-Struktur mit 16-Byte-Kopf. Ein inline geschriebenes Array liegt
  // dagegen unmittelbar im Objekt; sein Feldname bezeichnet die ADRESSE, nicht
  // einen Zeiger auf die Daten.
  fn cg_fieldInlineElemW(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return 0; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar := peek64(fb) as pchar;
      var n: int64 := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        var fl: int64 := peek64(fb + CG_CFIELD_OFF_FLAGS);
        if (((fl >> 3) & 1) == 0) { return 0; }
        return (fl >> 8) & 0xFF;
      }
      i += 1;
    }
    return 0;
  }

  fn cg_isFieldArray(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return 0; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar := peek64(fb) as pchar;
      var n: int64 := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        var tp: pchar := peek64(fb + CG_CFIELD_OFF_TYPENAMEPTR) as pchar;
        var tl: int64 := peek64(fb + CG_CFIELD_OFF_TYPENAMELEN);
        if (tp != 0 as pchar && tl == 5 && self.cg_seq(tp, tl, "Array", 5)) { return 1; }
        return 0;
      }
      i += 1;
    }
    return 0;
  }

  // WP-4.1-B: emit BSWAP/XCHG on rax after loading a big_endian field (load result in rax).
  fn cg_emitBswapRax(typeWidth: int64) {
    if (typeWidth == 2) {
      // XCHG al, ah: 86 C4
      self.cg_e8(0x86); self.cg_e8(0xC4);
      // movzx rax, ax: 48 0F B7 C0 (zero-extend to 64 bits)
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB7); self.cg_e8(0xC0);
    } else if (typeWidth == 4) {
      // BSWAP eax: 0F C8 (zeroes upper 32 bits of rax)
      self.cg_e8(0x0F); self.cg_e8(0xC8);
    } else {
      // BSWAP rax: 48 0F C8
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xC8);
    }
  }

  // WP-4.1-B: emit BSWAP/XCHG on rsi before storing a big_endian field (value in rsi).
  fn cg_emitBswapRsi(typeWidth: int64) {
    if (typeWidth == 2) {
      // ROL si, 8: 66 C1 C6 08
      self.cg_e8(0x66); self.cg_e8(0xC1); self.cg_e8(0xC6); self.cg_e8(8);
    } else if (typeWidth == 4) {
      // BSWAP esi: 0F CE
      self.cg_e8(0x0F); self.cg_e8(0xCE);
    } else {
      // BSWAP rsi: 48 0F CE
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xCE);
    }
  }

  fn cg_buildClassLayout(ni: int64) {
    var className: pchar := self.cg_nsval(ni);
    var classLen:  int64 := self.cg_nslen(ni);
    // WP-BC-INH: resolve parent class layout (field flattening + VMT inheritance).
    // Requires the parent class layout to be built already (declaration order).
    var parentNi: int64 := self.cg_nc2(ni);
    var pIdx: int64 := 0 - 1;
    var parentFieldCnt: int64 := 0;
    var parentFldsPtr: int64 := 0;
    if (parentNi >= 0) {
      pIdx := self.cg_findClass(self.cg_nsval(parentNi), self.cg_nslen(parentNi));
      if (pIdx >= 0) {
        parentFieldCnt := peek64(self.classLayouts + pIdx * CG_CLASS_SZ + CG_CLASS_OFF_FIELDCNT);
        parentFldsPtr  := peek64(self.classLayouts + pIdx * CG_CLASS_SZ + CG_CLASS_OFF_FIELDSPTR);
      }
    }
    // Count own fields (child0 chain)
    var fieldNode: int64 := self.cg_nc0(ni);
    var ownCnt: int64 := 0;
    var tmp: int64 := fieldNode;
    while (tmp != -1) { ownCnt := ownCnt + 1; tmp := self.cg_nnext(tmp); }
    // Total fields = inherited base fields + own fields
    var cnt: int64 := parentFieldCnt + ownCnt;
    // Allocate field array (base fields flattened first, then own)
    var flds: int64 := alloc((cnt + 1) * CG_CFIELD_SZ);
    // Copy inherited base-class field entries verbatim — their offsets (8,16,…)
    // stay valid because every class reserves offset 0 for the VMT pointer.
    if (parentFieldCnt > 0) { memcpy(flds, parentFldsPtr, parentFieldCnt * CG_CFIELD_SZ); }
    // WP-10a: offset 0 = VMT ptr; own fields continue after the base fields.
    var offset: int64 := 8 + parentFieldCnt * 8;
    var i: int64 := parentFieldCnt;
    tmp := fieldNode;
    while (tmp != -1) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      poke64(fb,      self.cg_nsval(tmp) as int64);
      poke64(fb + CG_CFIELD_OFF_FIELDLEN,  self.cg_nslen(tmp));
      poke64(fb + CG_CFIELD_OFF_OFFSET, offset);
      poke64(fb + CG_CFIELD_OFF_ELEMTYPEPTR, 0);
      poke64(fb + CG_CFIELD_OFF_ELEMTYPELEN, 0);
      var ftypeNode: int64 := self.cg_nc0(tmp);
      if (ftypeNode >= 0 && self.cg_nkind(ftypeNode) == 60) {
        var ftn: pchar := self.cg_nsval(ftypeNode);
        var ftl: int64 := self.cg_nslen(ftypeNode);
        poke64(fb + CG_CFIELD_OFF_TYPENAMEPTR, ftn as int64);
        poke64(fb + CG_CFIELD_OFF_TYPENAMELEN, ftl);
        if (self.cg_seq(ftn, ftl, "Array", 5)) {
          var elemNode: int64 := self.cg_nc1(ftypeNode);
          if (elemNode >= 0 && self.cg_nkind(elemNode) == 60) {
            poke64(fb + CG_CFIELD_OFF_ELEMTYPEPTR, self.cg_nsval(elemNode) as int64);
            poke64(fb + CG_CFIELD_OFF_ELEMTYPELEN, self.cg_nslen(elemNode));
          }
        }
      } else {
        poke64(fb + CG_CFIELD_OFF_TYPENAMEPTR, 0);
        poke64(fb + CG_CFIELD_OFF_TYPENAMELEN, 0);
      }
      // WP-4.1-B: store big_endian flag + type width at fb+40
      var beFlag: int64 := (self.cg_nival(tmp) >> 1) & 1;  // bit 1 of field iVal
      var tWidth: int64 := self.cg_typeSize(ftypeNode);
      // A2: method-Typ-Flag (Bit1) — inline `method(...)` ODER method-Alias-Name → fat pointer.
      var isMth: int64 := 0;
      if (ftypeNode >= 0) {
        if (self.cg_nkind(ftypeNode) == CGN_METHOD_PTR) { isMth := 1; }
        else if (self.cg_nkind(ftypeNode) == 60 && self.cg_isMethodType(self.cg_nsval(ftypeNode), self.cg_nslen(ftypeNode)) != 0) { isMth := 1; }
      }
      // #1038: Bit2 = vorzeichenbehafteter Schmaltyp (int8/i8/int16/i16/int32/i32).
      // Der Ladepfad braucht es, um movsx statt movzx zu emittieren.
      // #1052: `feld: [N]T` liegt INLINE im Objekt. Bit3 kennzeichnet das, die
      // Breite in Bits 8..15 ist dann die ELEMENTbreite.
      var inlN: int64 := self.cg_arrayFixedCount(ftypeNode);
      if (inlN > 0) { tWidth := self.cg_typeSize(self.cg_nc0(ftypeNode)); }
      var inlBit: int64 := 0;
      if (inlN > 0) { inlBit := 1; }
      poke64(fb + CG_CFIELD_OFF_FLAGS, beFlag | (tWidth << 8) | (isMth << 1) | (self.cg_typeIsSignedNarrow(ftypeNode) << 2) | (inlBit << 3));
      // #1052: ein inline `[N]T`-Feld belegt N * Elementbreite, nicht 8 Byte.
      // Ohne das ueberlappte das Folgefeld die Arraydaten.
      if (inlN > 0) { offset := offset + inlN * tWidth; } else { offset += 8; }
      i += 1;
      tmp := self.cg_nnext(tmp);
    }
    // WP-BC-19: parent VMT slots for inheritance (parentNi/pIdx resolved above)
    var parentSlotCount: int64 := 0;
    var parentMethodList: int64 := 0;
    if (pIdx >= 0) {
      parentSlotCount  := peek64(self.classLayouts + pIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTSLOTS);
      parentMethodList := peek64(self.classLayouts + pIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTLIST);
    }
    // Count own virtual methods that are new (not overriding a parent slot)
    var ownMethodCount: int64 := 0;
    var mthTmp2: int64 := self.cg_nc1(ni);
    while (mthTmp2 != -1) {
      var isVirt2: int64 := (self.cg_nival(mthTmp2) >> 1) & 1;
      if (isVirt2 != 0) {
        var mname2: pchar := self.cg_nsval(mthTmp2);
        var mlen2:  int64 := self.cg_nslen(mthTmp2);
        var overrides: int64 := 0;
        var si2: int64 := 0;
        while (si2 < parentSlotCount) {
          var sName2: pchar := peek64(parentMethodList + si2 * 16) as pchar;
          var sLen2:  int64 := peek64(parentMethodList + si2 * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN);
          if (self.cg_seq(sName2, sLen2, mname2, mlen2) != 0) { overrides := 1; break; }
          si2 += 1;
        }
        if (overrides == 0) { ownMethodCount := ownMethodCount + 1; }
      }
      mthTmp2 := self.cg_nnext(mthTmp2);
    }
    var totalSlots: int64 := parentSlotCount + ownMethodCount;
    // Allocate method name list: {namePtr:8, nameLen:8} per slot
    var methodList: int64 := alloc((totalSlots + 1) * 16);
    // Copy parent slots first
    var si3: int64 := 0;
    while (si3 < parentSlotCount) {
      poke64(methodList + si3 * 16,     peek64(parentMethodList + si3 * 16));
      poke64(methodList + si3 * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN, peek64(parentMethodList + si3 * 16 + 8));
      si3 += 1;
    }
    // Append own new virtual methods
    var slotAppend: int64 := parentSlotCount;
    var mthTmp3: int64 := self.cg_nc1(ni);
    while (mthTmp3 != -1) {
      var isVirt3: int64 := (self.cg_nival(mthTmp3) >> 1) & 1;
      if (isVirt3 != 0) {
        var mname3: pchar := self.cg_nsval(mthTmp3);
        var mlen3:  int64 := self.cg_nslen(mthTmp3);
        var overrides3: int64 := 0;
        var si4: int64 := 0;
        while (si4 < parentSlotCount) {
          var sName4: pchar := peek64(parentMethodList + si4 * 16) as pchar;
          var sLen4:  int64 := peek64(parentMethodList + si4 * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN);
          if (self.cg_seq(sName4, sLen4, mname3, mlen3) != 0) { overrides3 := 1; break; }
          si4 += 1;
        }
        if (overrides3 == 0) {
          poke64(methodList + slotAppend * 16,     mname3 as int64);
          poke64(methodList + slotAppend * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN, mlen3);
          slotAppend += 1;
        }
      }
      mthTmp3 := self.cg_nnext(mthTmp3);
    }
    // Emit VMT data: totalSlots * 8 bytes (each slot = one method pointer)
    var vmtDataOff: int64 := self.dataLen;
    var di: int64 := 0;
    while (di < totalSlots * 8) { self.cg_edata(0); di := di + 1; }
    // Ensure at least 8 bytes (classes with no methods still need a VMT identity slot)
    if (totalSlots == 0) {
      var de: int64 := 0; while (de < 8) { self.cg_edata(0); de := de + 1; }
    }
    // Grow class table if needed
    if (self.classCount >= self.classCap) {
      var nc: int64 := self.classCap * 2;
      var nb: int64 := alloc(nc * CG_CLASS_SZ);
      var ii: int64 := 0;
      memcpy(nb, self.classLayouts, self.classCount * CG_CLASS_SZ);
      self.classLayouts := nb;
      self.classCap := nc;
    }
    var base: int64 := self.classLayouts + self.classCount * CG_CLASS_SZ;
    poke64(base,      className as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  classLen);
    poke64(base + CG_CLASS_OFF_FIELDSPTR, flds);
    poke64(base + CG_CLASS_OFF_FIELDCNT, cnt);
    poke64(base + CG_CLASS_OFF_VMTOFF,   vmtDataOff);
    poke64(base + CG_CLASS_OFF_VMTSLOTS, totalSlots);
    poke64(base + CG_CLASS_OFF_VMTLIST,  methodList);
    poke64(base + CG_CLASS_OFF_PARENTIDX, pIdx);  // WP-BC-L2: for inherited-slot propagation
    // #1095: als struct deklariert? Ein struct MIT Methoden landet hier im
    // Klassen-Layout und ist sonst nicht mehr als struct erkennbar.
    poke64(base + CG_CLASS_OFF_ISSTRUCT, (self.cg_nival(ni) >> 4) & 1);
    self.classCount += 1;
    // Track temporary field array for later cleanup (BUG-02)
    // The flds pointer is stored in classLayouts and used by cg_findField/cg_getFieldOffset
    // until cg_patchAll() completes. cg_freeAllTempBufs() will release it.
    self.cg_trackTempBuf(flds, (cnt + 1) * CG_CFIELD_SZ);
    self.cg_trackTempBuf(methodList, (totalSlots + 1) * 16);
  }

  // Build struct field layout (WP-10d): like cg_buildClassLayout but fields at offset 0
  // and vmtDataOff stored as -1 (marks this entry as a struct, not a class).
  // WP-4.1-A: return the byte size of a named type for @packed structs
  fn cg_typeSize(typeNode: int64): int64 {
    if (typeNode < 0) { return 8; }
    var tn: pchar := self.cg_nsval(typeNode);
    var tl: int64 := self.cg_nslen(typeNode);
    if (tl == 5 && self.cg_seq(tn, tl, "uint8"c,  5)) { return 1; }
    if (tl == 4 && self.cg_seq(tn, tl, "int8"c,   4)) { return 1; }
    if (tl == 4 && self.cg_seq(tn, tl, "char"c,   4)) { return 1; }
    if (tl == 6 && self.cg_seq(tn, tl, "uint16"c, 6)) { return 2; }
    if (tl == 5 && self.cg_seq(tn, tl, "int16"c,  5)) { return 2; }
    if (tl == 6 && self.cg_seq(tn, tl, "uint32"c, 6)) { return 4; }
    if (tl == 5 && self.cg_seq(tn, tl, "int32"c,  5)) { return 4; }
    // #1010: hier standen bisher NUR die uintN-Schreibweisen -- ein `u16`-Feld
    // bekam damit Breite 8. Das trifft die @big_endian-Byteordnung (Breite steckt
    // im Feld-Flag) und die @packed-Schrittweite. Beide Schreibweisen jetzt gleich.
    if (tl == 2 && self.cg_seq(tn, tl, "u8"c,     2)) { return 1; }
    if (tl == 2 && self.cg_seq(tn, tl, "i8"c,     2)) { return 1; }
    if (tl == 3 && self.cg_seq(tn, tl, "u16"c,    3)) { return 2; }
    if (tl == 3 && self.cg_seq(tn, tl, "i16"c,    3)) { return 2; }
    if (tl == 3 && self.cg_seq(tn, tl, "u32"c,    3)) { return 4; }
    if (tl == 3 && self.cg_seq(tn, tl, "i32"c,    3)) { return 4; }
    if (tl == 3 && self.cg_seq(tn, tl, "f32"c,    3)) { return 4; }
    return 8;  // int64, uint64, f64, pchar, pointers — all 8 bytes
  }

  // #1038: Ist der Typ ein VORZEICHENBEHAFTETER Schmaltyp? Nur fuer diese wird
  // beim Laden vorzeichenrichtig erweitert (movsx); uintN/uN und char werden
  // genullt (movzx). Breite 8 spielt hier keine Rolle.
  fn cg_typeIsSignedNarrow(typeNode: int64): int64 {
    if (typeNode < 0) { return 0; }
    var tn: pchar := self.cg_nsval(typeNode);
    var tl: int64 := self.cg_nslen(typeNode);
    if (tl == 4 && self.cg_seq(tn, tl, "int8"c,  4)) { return 1; }
    if (tl == 5 && self.cg_seq(tn, tl, "int16"c, 5)) { return 1; }
    if (tl == 5 && self.cg_seq(tn, tl, "int32"c, 5)) { return 1; }
    if (tl == 2 && self.cg_seq(tn, tl, "i8"c,    2)) { return 1; }
    if (tl == 3 && self.cg_seq(tn, tl, "i16"c,   3)) { return 1; }
    if (tl == 3 && self.cg_seq(tn, tl, "i32"c,   3)) { return 1; }
    return 0;
  }

  fn cg_buildStructLayout(ni: int64) {
    var sName: pchar := self.cg_nsval(ni);
    var sLen:  int64 := self.cg_nslen(ni);
    // WP-BC-INH: a method-less class may still `extends` a base — flatten base fields.
    var parentNi: int64 := self.cg_nc2(ni);
    var parentFieldCnt: int64 := 0;
    var parentFldsPtr: int64 := 0;
    var pIdx: int64 := 0 - 1;
    if (parentNi >= 0) {
      pIdx := self.cg_findClass(self.cg_nsval(parentNi), self.cg_nslen(parentNi));
      if (pIdx >= 0) {
        parentFieldCnt := peek64(self.classLayouts + pIdx * CG_CLASS_SZ + CG_CLASS_OFF_FIELDCNT);
        parentFldsPtr  := peek64(self.classLayouts + pIdx * CG_CLASS_SZ + CG_CLASS_OFF_FIELDSPTR);
      }
    }
    var fieldNode: int64 := self.cg_nc0(ni);
    var ownCnt: int64 := 0;
    var tmp: int64 := fieldNode;
    while (tmp != -1) { ownCnt := ownCnt + 1; tmp := self.cg_nnext(tmp); }
    var cnt: int64 := parentFieldCnt + ownCnt;
    var flds: int64 := alloc((cnt + 1) * CG_CFIELD_SZ);
    // Inherited base fields first (offsets preserved); own fields continue after.
    if (parentFieldCnt > 0) { memcpy(flds, parentFldsPtr, parentFieldCnt * CG_CFIELD_SZ); }
    // WP-4.1-A: check for @packed flag (bit 0 of struct iVal) and at(offset) fields
    var isPacked: int64 := self.cg_nival(ni) & 1;
    // Structs: fields start at offset 0 (no VMT slot); derived continue after base.
    var offset: int64 := parentFieldCnt * 8;
    var i: int64 := parentFieldCnt;
    tmp := fieldNode;
    while (tmp != -1) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      poke64(fb,      self.cg_nsval(tmp) as int64);
      poke64(fb + CG_CFIELD_OFF_FIELDLEN,  self.cg_nslen(tmp));
      var ftypeNode: int64 := self.cg_nc0(tmp);
      // WP-4.1-A: determine field offset
      var fieldOff: int64 := offset;
      var fieldIVal: int64 := self.cg_nival(tmp);
      if ((fieldIVal & 1) != 0) {
        // Explicit at(expr) offset: read from c1 node's iVal (must be literal)
        var offsetNi: int64 := self.cg_nc1(tmp);
        if (offsetNi >= 0) { fieldOff := self.cg_nival(offsetNi); }
        offset := fieldOff;  // continue after explicit offset
      }
      poke64(fb + CG_CFIELD_OFF_OFFSET, fieldOff);
      poke64(fb + CG_CFIELD_OFF_ELEMTYPEPTR, 0);
      poke64(fb + CG_CFIELD_OFF_ELEMTYPELEN, 0);
      if (ftypeNode >= 0 && self.cg_nkind(ftypeNode) == 60) {
        var ftn: pchar := self.cg_nsval(ftypeNode);
        var ftl: int64 := self.cg_nslen(ftypeNode);
        poke64(fb + CG_CFIELD_OFF_TYPENAMEPTR, ftn as int64);
        poke64(fb + CG_CFIELD_OFF_TYPENAMELEN, ftl);
        // For Array<T> fields: store element type from generic arg nc1
        if (self.cg_seq(ftn, ftl, "Array", 5)) {
          var elemNode: int64 := self.cg_nc1(ftypeNode);
          if (elemNode >= 0 && self.cg_nkind(elemNode) == 60) {
            poke64(fb + CG_CFIELD_OFF_ELEMTYPEPTR, self.cg_nsval(elemNode) as int64);
            poke64(fb + CG_CFIELD_OFF_ELEMTYPELEN, self.cg_nslen(elemNode));
          }
        }
      } else {
        poke64(fb + CG_CFIELD_OFF_TYPENAMEPTR, 0);
        poke64(fb + CG_CFIELD_OFF_TYPENAMELEN, 0);
      }
      // WP-4.1-B: store big_endian flag + type width at fb+40
      var beFlag2: int64 := (self.cg_nival(tmp) >> 1) & 1;
      var tWidth2: int64 := self.cg_typeSize(ftypeNode);
      // A2: method-Typ-Flag (Bit1) — inline `method(...)` ODER method-Alias-Name.
      var isMth2: int64 := 0;
      if (ftypeNode >= 0) {
        if (self.cg_nkind(ftypeNode) == CGN_METHOD_PTR) { isMth2 := 1; }
        else if (self.cg_nkind(ftypeNode) == 60 && self.cg_isMethodType(self.cg_nsval(ftypeNode), self.cg_nslen(ftypeNode)) != 0) { isMth2 := 1; }
      }
      // #1038: Bit2 = vorzeichenbehafteter Schmaltyp, siehe cg_buildClassLayout.
      // #1052: siehe cg_buildClassLayout — inline `[N]T`-Feld.
      var inlN2: int64 := self.cg_arrayFixedCount(ftypeNode);
      if (inlN2 > 0) { tWidth2 := self.cg_typeSize(self.cg_nc0(ftypeNode)); }
      var inlBit2: int64 := 0;
      if (inlN2 > 0) { inlBit2 := 1; }
      poke64(fb + CG_CFIELD_OFF_FLAGS, beFlag2 | (tWidth2 << 8) | (isMth2 << 1) | (self.cg_typeIsSignedNarrow(ftypeNode) << 2) | (inlBit2 << 3));
      // WP-4.1-A: field stride
      // #1052: inline `[N]T` belegt N * Elementbreite — auch ungepackt.
      if (inlN2 > 0) {
        offset := offset + inlN2 * tWidth2;
      } else if (isPacked != 0) {
        offset := offset + self.cg_typeSize(ftypeNode);
      } else {
        offset += 8;  // default: 8-byte aligned
      }
      i += 1;
      tmp := self.cg_nnext(tmp);
    }
    if (self.classCount >= self.classCap) {
      var nc: int64 := self.classCap * 2;
      var nb: int64 := alloc(nc * CG_CLASS_SZ);
      var ii: int64 := 0;
      memcpy(nb, self.classLayouts, self.classCount * CG_CLASS_SZ);
      self.classLayouts := nb;
      self.classCap := nc;
    }
    var base: int64 := self.classLayouts + self.classCount * CG_CLASS_SZ;
    poke64(base,      sName as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  sLen);
    poke64(base + CG_CLASS_OFF_FIELDSPTR, flds);
    poke64(base + CG_CLASS_OFF_FIELDCNT, cnt);
    poke64(base + CG_CLASS_OFF_VMTOFF,   -1);
    poke64(base + CG_CLASS_OFF_VMTSLOTS, 0);
    poke64(base + CG_CLASS_OFF_VMTLIST, 0);
    // #1094: Die Elternklasse wird auch hier vermerkt. Sie steht fuer die
    // Vererbungskette, nicht fuer eine VMT — die bleibt ueber VMTOFF == -1
    // ausgeschlossen, und die Slot-Weitergabe (WP-BC-L2) prueft genau darauf.
    // Ohne den Eintrag waere `b is A` bei methodenlosen Klassen falsch: sie
    // bekommen struct-Layout, und die Kette waere abgeschnitten.
    poke64(base + CG_CLASS_OFF_PARENTIDX, pIdx);
    poke64(base + CG_CLASS_OFF_ISSTRUCT, (self.cg_nival(ni) >> 4) & 1);
    self.classCount += 1;
    // Track temporary field array for later cleanup (BUG-02)
    self.cg_trackTempBuf(flds, (cnt + 1) * CG_CFIELD_SZ);
  }

  // BUG-08: Build enum variant layout for match tag analysis
  // Enum layout: {namePtr:8, nameLen:8, variantsPtr:8, variantCnt:8}
  // Each variant: {namePtr:8, nameLen:8, tagValue:8, payloadSize:8} = 32 bytes
  fn cg_buildEnumLayout(ni: int64) {
    var enumName: pchar := self.cg_nsval(ni);
    var enumLen:  int64 := self.cg_nslen(ni);
    // Count variants (child0 chain)
    var variantNode: int64 := self.cg_nc0(ni);
    var cnt: int64 := 0;
    var tmp: int64 := variantNode;
    while (tmp != -1) { cnt := cnt + 1; tmp := self.cg_nnext(tmp); }
    // WP-10.2: cnt*32 must not overflow; no realistic enum has >64 M variants
    if (cnt < 0 || cnt > 0x3FFFFFFF) { return; }
    // Allocate variant array: 32 bytes per variant
    var vars: int64 := alloc(cnt * 32);
    var i: int64 := 0;
    tmp := variantNode;
    while (tmp != -1) {
      var vb: int64 := vars + i * 32;
      poke64(vb,      self.cg_nsval(tmp) as int64);   // variant name
      poke64(vb + CG_EVAR_OFF_NAMELEN,  self.cg_nslen(tmp));             // variant name len
      poke64(vb + CG_EVAR_OFF_TAGVAL, i);                              // tag value = index
      // Payload size: count children of variant (NK_PATTERN_BIND etc.)
      var payloadCnt: int64 := 0;
      var pc: int64 := self.cg_nc0(tmp);
      while (pc != -1) { payloadCnt := payloadCnt + 1; pc := self.cg_nnext(pc); }
      poke64(vb + CG_EVAR_OFF_PAYLOADSZ, payloadCnt);
      i += 1;
      tmp := self.cg_nnext(tmp);
    }
    // Grow enum table if needed
    if (self.enumCount >= self.enumCap) {
      var nc: int64 := self.enumCap * 2;
      var nb: int64 := alloc(nc * 32);
      var ii: int64 := 0;
      memcpy(nb, self.enumLayouts, self.enumCount * 32);
      free(self.enumLayouts, self.enumCap * 32);
      self.enumLayouts := nb;
      self.enumCap := nc;
    }
    var base: int64 := self.enumLayouts + self.enumCount * 32;
    poke64(base,      enumName as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  enumLen);
    poke64(base + CG_ENUM_OFF_VARSPTR, vars);
    poke64(base + CG_CLASS_OFF_FIELDCNT, cnt);
    self.enumCount += 1;
  }

  // BUG-08: Find enum layout by name, return index or -1
  fn cg_findEnum(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.enumCount) {
      var base: int64 := self.enumLayouts + i * 32;
      var p: pchar := peek64(base) as pchar;
      var n: int64 := peek64(base + CG_PATCH_OFF_NAMEPTR);
      if (n == nlen && self.cg_seq(p, n, name, nlen)) { return i; }
      i += 1;
    }
    return -1;
  }

  // BUG-08: Find variant tag value within enum by variant name
  // Returns {tagValue: low 32 bits, payloadSize: high 32 bits} packed in int64
  fn cg_findEnumVariant(enumIdx: int64, varName: pchar, varLen: int64): int64 {
    if (enumIdx < 0) { return -1; }
    var ebase: int64 := self.enumLayouts + enumIdx * 32;
    var vars: int64 := peek64(ebase + CG_ENUM_OFF_VARSPTR);
    var vcnt: int64 := peek64(ebase + CG_ENUM_OFF_VARCOUNT);
    var i: int64 := 0;
    while (i < vcnt) {
      var vb: int64 := vars + i * 32;
      var p: pchar := peek64(vb) as pchar;
      var n: int64 := peek64(vb + CG_EVAR_OFF_NAMELEN);
      if (n == varLen && self.cg_seq(p, n, varName, varLen)) {
        var tagVal: int64 := peek64(vb + CG_EVAR_OFF_TAGVAL);
        var paySz:  int64 := peek64(vb + CG_EVAR_OFF_PAYLOADSZ);
        return tagVal + (paySz << 32);
      }
      i += 1;
    }
    return -1;
  }

  fn cg_getLocalClassIdx(varName: pchar, varLen: int64): int64 {
    var i: int64 := self.localCount - 1;
    while (i >= 0) {
      var base: int64 := self.locals + i * CG_LOCAL_SZ;
      var p: pchar  := peek64(base) as pchar;
      var n: int64  := peek64(base + CG_LOCAL_OFF_NAMELEN);
      if (n == varLen && self.cg_seq(p, n, varName, varLen)) {
        var tb: int64 := self.localTypes + i * 16;
        var tp: pchar := peek64(tb) as pchar;
        var tn: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
        if (tp == 0 as pchar || tn == 0) { return -1; }
        return self.cg_findClass(tp, tn);
      }
      i -= 1;
    }
    return -1;
  }

  // WP-10a: record a VMT address patch (mov rcx,imm64 placeholder at codeOff for class)
  fn cg_addVmtPatch(codeOff: int64, className: pchar, classLen: int64) {
    if (self.vmtPatchCount >= self.vmtPatchCap) {
      var nc: int64 := self.vmtPatchCap * 2;
      var nb: int64 := alloc(nc * 24);
      var i: int64 := 0;
      memcpy(nb, self.vmtPatches, self.vmtPatchCount * 24);
      self.vmtPatches := nb; self.vmtPatchCap := nc;
    }
    var base: int64 := self.vmtPatches + self.vmtPatchCount * 24;
    poke64(base,      codeOff);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  className as int64);
    poke64(base + CG_VMT_PATCH_OFF_CLASSLEN, classLen);
    self.vmtPatchCount += 1;
  }

  // WP-BC-19: Record VMT method slot patch: after all code is generated,
  // write method vaddr into data[vmtDataSlotOff].
  fn cg_addVmtMethodPatch(vmtDataSlotOff: int64, methodCodeStart: int64) {
    if (self.vmtMethodPatchCount >= self.vmtMethodPatchCap) {
      var nc: int64 := self.vmtMethodPatchCap * 2;
      var nb: int64 := alloc(nc * CG_VMT_METH_PATCH_SZ);
      var i: int64 := 0;
      memcpy(nb, self.vmtMethodPatches, self.vmtMethodPatchCount * CG_VMT_METH_PATCH_SZ);
      self.vmtMethodPatches := nb; self.vmtMethodPatchCap := nc;
    }
    var base: int64 := self.vmtMethodPatches + self.vmtMethodPatchCount * CG_VMT_METH_PATCH_SZ;
    poke64(base,     vmtDataSlotOff);
    poke64(base + CG_PATCH_OFF_NAMEPTR, methodCodeStart);
    self.vmtMethodPatchCount += 1;
  }

  // WP-A2.2: register an 8-byte absolute pointer at image RVA `rva` (relative to
  // CG_ELF_BASE). Consumers relocate it by (load_base − CG_ELF_BASE): the PE backend
  // emits an IMAGE_REL_BASED_DIR64 entry + rebases the value; the LyxOS loader adds
  // its (load_base − 0x400000) delta. The default ELF exe loads at CG_ELF_BASE so no
  // adjustment is needed there.
  fn cg_addBaseReloc(rva: int64) {
    if (self.baseRelocCount >= self.baseRelocCap) {
      var nc: int64 := self.baseRelocCap * 2;
      var nb: int64 := alloc(nc * 8);
      memcpy(nb, self.baseRelocBuf, self.baseRelocCount * 8);
      self.baseRelocBuf := nb; self.baseRelocCap := nc;
    }
    poke64(self.baseRelocBuf + self.baseRelocCount * 8, rva);
    self.baseRelocCount += 1;
  }
  fn cg_getBaseRelocBuf(): int64 { return self.baseRelocBuf; }
  fn cg_getBaseRelocCount(): int64 { return self.baseRelocCount; }

  // Helper: get class index for object node (IDENT, FIELD chain, or INDEX for struct arrays)
  // #1094: Kanonische Nummer eines eingebauten Typnamens, 0 = kein eingebauter
  // Typ. Die Schreibvarianten muessen dieselbe Nummer bekommen, sonst waere
  // `x is uint64` bei `var x: u64` falsch — sie bezeichnen denselben Typ.
  fn cg_builtinTypeId(nm: pchar, nl: int64): int64 {
    if (self.cg_seq(nm, nl, "bool",   4)) { return 1; }
    if (self.cg_seq(nm, nl, "int64",  5)) { return 2; }
    if (self.cg_seq(nm, nl, "i64",    3)) { return 2; }
    if (self.cg_seq(nm, nl, "int32",  5)) { return 3; }
    if (self.cg_seq(nm, nl, "i32",    3)) { return 3; }
    if (self.cg_seq(nm, nl, "int16",  5)) { return 4; }
    if (self.cg_seq(nm, nl, "i16",    3)) { return 4; }
    if (self.cg_seq(nm, nl, "int8",   4)) { return 5; }
    if (self.cg_seq(nm, nl, "i8",     2)) { return 5; }
    if (self.cg_seq(nm, nl, "u64",    3)) { return 6; }
    if (self.cg_seq(nm, nl, "uint64", 6)) { return 6; }
    if (self.cg_seq(nm, nl, "u32",    3)) { return 7; }
    if (self.cg_seq(nm, nl, "uint32", 6)) { return 7; }
    if (self.cg_seq(nm, nl, "u16",    3)) { return 8; }
    if (self.cg_seq(nm, nl, "uint16", 6)) { return 8; }
    if (self.cg_seq(nm, nl, "u8",     2)) { return 9; }
    if (self.cg_seq(nm, nl, "uint8",  5)) { return 9; }
    if (self.cg_seq(nm, nl, "pchar",  5)) { return 10; }
    if (self.cg_seq(nm, nl, "f64",    3)) { return 11; }
    if (self.cg_seq(nm, nl, "f32",    3)) { return 12; }
    if (self.cg_seq(nm, nl, "char",   4)) { return 13; }
    if (self.cg_seq(nm, nl, "void",   4)) { return 14; }
    return 0;
  }

  // #1094: statischer Typname eines Ausdrucks; 0 = nicht bestimmbar.
  // Die Laenge steht danach in self.stnLen.
  //
  // `is` braucht diesen Namen zweimal: fuer die Frage, ob der Empfaenger
  // ueberhaupt eine Klasse mit VMT ist (nur dann darf zur Laufzeit geprueft
  // werden — bei einem int64 laege an [rax] keine VMT), und fuer die Antwort
  // in allen uebrigen Faellen, die statisch feststeht. Wo der Typ nicht
  // bestimmbar ist, MELDET `is` das; ein „unbekannt heisst false" waere genau
  // der stille Default, der den Fehler ausgemacht hat.
  fn cg_staticTypeName(ni: int64): pchar {
    self.stnLen := 0;
    if (ni < 0) { return 0 as pchar; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_LIT_INT)   { self.stnLen := 5; return "int64"c; }
    if (k == CGN_LIT_STR)   { self.stnLen := 5; return "pchar"c; }
    if (k == CGN_LIT_FLOAT) { self.stnLen := 3; return "f64"c;   }
    if (k == CGN_LIT_BOOL)  { self.stnLen := 4; return "bool"c;  }
    if (k == CGN_LIT_CHAR)  { self.stnLen := 4; return "char"c;  }
    // `x as T` und `new T` nennen ihren Typ selbst.
    if (k == CGN_CAST) {
      var tn2: int64 := self.cg_nc1(ni);
      if (tn2 < 0) { return 0 as pchar; }
      self.stnLen := self.cg_nslen(tn2);
      return self.cg_nsval(tn2);
    }
    if (k == CGN_NEW) {
      self.stnLen := self.cg_nslen(ni);
      return self.cg_nsval(ni);
    }
    if (k == CGN_IDENT) {
      var nm: pchar := self.cg_nsval(ni);
      var nl: int64 := self.cg_nslen(ni);
      if (self.cg_seq(nm, nl, "self", 4)) {
        if (self.curClassName == 0 as pchar) { return 0 as pchar; }
        self.stnLen := self.curClassNameLen;
        return self.curClassName;
      }
      var lidx: int64 := self.cg_findLocalIdx(nm, nl);
      if (lidx >= 0) {
        var tb: int64 := self.localTypes + lidx * CG_LOCTYPE_SZ;
        var tp: pchar := peek64(tb) as pchar;
        var tl: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
        if (tp == 0 as pchar || tl <= 0) { return 0 as pchar; }
        self.stnLen := tl;
        return tp;
      }
      var gidx: int64 := self.cg_findGlobalIdx(nm, nl);
      if (gidx >= 0) {
        var gp: pchar := peek64(self.globalTypeNames + gidx * 16) as pchar;
        var gl: int64 := peek64(self.globalTypeNames + gidx * 16 + 8);
        if (gp == 0 as pchar || gl <= 0) { return 0 as pchar; }
        self.stnLen := gl;
        return gp;
      }
      var cidx: int64 := self.cg_findConIdx(nm, nl);
      if (cidx >= 0) {
        if (peek8(self.conIsPchar + cidx) != 0) { self.stnLen := 5; return "pchar"c; }
        self.stnLen := 5; return "int64"c;
      }
      return 0 as pchar;
    }
    if (k == CGN_FIELD) {
      var ci: int64 := self.cg_objClassIdx(self.cg_nc0(ni));
      if (ci < 0) { return 0 as pchar; }
      var base: int64 := self.classLayouts + ci * CG_CLASS_SZ;
      var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
      var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
      var fn2: pchar  := self.cg_nsval(ni);
      var fl2: int64  := self.cg_nslen(ni);
      var i: int64 := 0;
      while (i < cnt) {
        var fb: int64 := flds + i * CG_CFIELD_SZ;
        var p: pchar  := peek64(fb) as pchar;
        var n: int64  := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
        if (self.cg_seq(p, n, fn2, fl2)) {
          var tp2: pchar := peek64(fb + CG_CFIELD_OFF_TYPENAMEPTR) as pchar;
          var tl2: int64 := peek64(fb + CG_CFIELD_OFF_TYPENAMELEN);
          if (tp2 == 0 as pchar || tl2 <= 0) { return 0 as pchar; }
          self.stnLen := tl2;
          return tp2;
        }
        i += 1;
      }
      return 0 as pchar;
    }
    if (k == CGN_CALL && self.cg_nival(ni) == 0) {
      var cnm: pchar := self.cg_nsval(ni);
      var cnl: int64 := self.cg_nslen(ni);
      var j: int64 := 0;
      while (j < self.fnRetCount) {
        var rb: int64 := self.fnRetList + j * 32;
        var rn: pchar := peek64(rb) as pchar;
        var rl: int64 := peek64(rb + 8);
        if (self.cg_seq(rn, rl, cnm, cnl)) {
          var rt: pchar := peek64(rb + 16) as pchar;
          var rtl: int64 := peek64(rb + 24);
          if (rt == 0 as pchar || rtl <= 0) { return 0 as pchar; }
          self.stnLen := rtl;
          return rt;
        }
        j += 1;
      }
      return 0 as pchar;
    }
    return 0 as pchar;
  }

  // #1094: Ist ci eine Klasse, die von target abstammt (oder target selbst)?
  fn cg_isDescendantClass(ci: int64, target: int64): int64 {
    var cur: int64 := ci;
    while (cur >= 0) {
      if (cur == target) { return 1; }
      cur := peek64(self.classLayouts + cur * CG_CLASS_SZ + CG_CLASS_OFF_PARENTIDX);
    }
    return 0;
  }

  // #1094: Hat die Klasse eine VMT? Ein `struct` hat keine — an [obj+0] liegt
  // dann das erste Feld, und ein Vergleich dort waere Unsinn.
  fn cg_classHasVmt(ci: int64): int64 {
    if (ci < 0) { return 0; }
    if (peek64(self.classLayouts + ci * CG_CLASS_SZ + CG_CLASS_OFF_VMTOFF) == -1) { return 0; }
    return 1;
  }

  fn cg_objClassIdx(objNode: int64): int64 {
    var k: int64 := self.cg_nkind(objNode);
    if (k == CGN_FIELD) {
      var innerObj: int64 := self.cg_nc0(objNode);
      var fldName: pchar  := self.cg_nsval(objNode);
      var fldLen:  int64  := self.cg_nslen(objNode);
      var parentIdx: int64 := self.cg_objClassIdx(innerObj);
      return self.cg_getFieldClassIdx(parentIdx, fldName, fldLen);
    }
    // For arr[i] where arr is Array<StructType>: return struct's class index
    if (k == CGN_INDEX) {
      var baseNode: int64 := self.cg_nc0(objNode);
      return self.cg_arrayElemClassIdx(baseNode);
    }
    // Empfänger ist selbst ein Aufruf: `t.Trim().ByteLength()` oder
    // `StringFromPchar(s).Length()`. Der Rückgabetyp steht in der fnRet-Registry
    // (freie Funktionen und Methoden werden beide dort eingetragen), und
    // cg_exprClassName löst ihn auf — inklusive Ketten, weil es sich für den
    // Empfänger selbst wieder aufruft. Vorher lieferte dieser Fall -1, der
    // Aufruf wurde ungemangelt emittiert und scheiterte beim Patchen mit
    // "undefined function 'ByteLength' — no codegen implementation found".
    if (k == CGN_CALL) {
      return self.cg_exprClassName(objNode);
    }
    if (k != CGN_IDENT) { return -1; }
    var oname: pchar := self.cg_nsval(objNode);
    var olen:  int64 := self.cg_nslen(objNode);
    if (self.cg_seq(oname, olen, "self", 4) != 0) {
      if (self.curClassName == 0 as pchar) { return -1; }
      return self.cg_findClass(self.curClassName, self.curClassNameLen);
    }
    return self.cg_getLocalClassIdx(oname, olen);
  }

  // Returns the class index of the element type for arr[i] expressions.
  // baseNode is the array expression (IDENT or FIELD).
  fn cg_arrayElemClassIdx(baseNode: int64): int64 {
    var bk: int64 := self.cg_nkind(baseNode);
    if (bk == CGN_IDENT) {
      // Local array variable: check localTypes for element type
      var bname: pchar := self.cg_nsval(baseNode);
      var blen:  int64 := self.cg_nslen(baseNode);
      var lidx: int64 := self.cg_findLocalIdx(bname, blen);
      if (lidx >= 0 && peek8(self.localIsArray + lidx) != 0) {
        var tb: int64 := self.localTypes + lidx * CG_LOCTYPE_SZ;
        var tp: pchar := peek64(tb) as pchar;
        var tn: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
        if (tp != 0 as pchar && tn > 0) { return self.cg_findClass(tp, tn); }
      }
      return -1;
    }
    if (bk == CGN_FIELD) {
      // Class field of Array<T> type: look up element type in CG_CFIELD
      var innerObj: int64 := self.cg_nc0(baseNode);
      var fldName:  pchar  := self.cg_nsval(baseNode);
      var fldLen:   int64  := self.cg_nslen(baseNode);
      var parentIdx: int64 := self.cg_objClassIdx(innerObj);
      return self.cg_getFieldElemClassIdx(parentIdx, fldName, fldLen);
    }
    return -1;
  }

  // Inline code for arr.push(val): alloc on first use, then append
  // Layout: [ptr+0]=cap, [ptr+8]=len, [ptr+16+i*8]=data[i]
  fn cg_genArrayPush(objNode: int64, valNode: int64) {
    var aname: pchar := self.cg_nsval(objNode);
    var anlen: int64 := self.cg_nslen(objNode);
    var off: int64 := self.cg_findLocal(aname, anlen);
    // Evaluate value → rax
    self.cg_genExpr(valNode);
    // push rax (save value)
    self.cg_e8(0x50);
    // mov rcx, [rbp+off]  (load array ptr)
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x4D); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x8D); self.cg_e32(off);
    }
    // test rcx, rcx
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC9);
    // jnz skip_alloc (rel32 placeholder)
    self.cg_e8(0x0F); self.cg_e8(0x85);
    var jnzPos: int64 := self.codeLen;
    self.cg_e32(0);
    // ---- mmap block: allocate (1026)*8 bytes ----
    // xor edi, edi          (rdi=0, addr=0)
    self.cg_e8(0x31); self.cg_e8(0xFF);
    // mov rsi, 8208         ((1024+2)*8)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC6);
    self.cg_e8(0x10); self.cg_e8(0x20); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov edx, 3            (PROT_RW)
    self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov eax, 34           (MAP_ANON|MAP_PRIVATE)
    self.cg_e8(0xB8); self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov r10, rax          (REX.B extends rm to r10: 49 89 C2)
    self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);
    // mov rax, -1           (fd=-1)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0);
    self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);
    // mov r8, rax
    self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC0);
    // xor r9d, r9d          (offset=0)
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);
    // mov eax, 9            (SYS_mmap)
    self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // mov rcx, 1024         (cap)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1);
    self.cg_e8(0x00); self.cg_e8(0x04); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov [rax], rcx        ([ptr+0] = cap)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x08);
    // xor rcx, rcx
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC9);
    // mov [rax+8], rcx      ([ptr+8] = len=0)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x48); self.cg_e8(0x08);
    // store rax back to local variable
    self.cg_storeRax(off);
    // mov rcx, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);
    // ---- end mmap block ----
    // Patch jnz to here (skip_alloc)
    poke32(self.code + jnzPos, self.codeLen - jnzPos - 4);
    // pop rax               (restore value)
    self.cg_e8(0x58);

    // ---- GROW CHECK ----
    // push rax (save value while we inspect cap/len)
    self.cg_e8(0x50);
    // mov rax, [rcx]        (rax = cap)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);
    // mov rdx, [rcx+8]      (rdx = len)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x51); self.cg_e8(0x08);
    // cmp rdx, rax          (len vs cap)
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC2);
    // jl .no_grow  (short — signed compare, both values non-negative)
    self.cg_e8(0x7C); var jlNoGrow: int64 := self.codeLen; self.cg_e8(0);

    // ---- GROW PATH ---- stack entering: [rsp+0]=value
    // push rcx  (save old_ptr)
    self.cg_e8(0x51);
    // shl rax, 1  (new_cap = cap * 2)
    self.cg_e8(0x48); self.cg_e8(0xD1); self.cg_e8(0xE0);
    // push rax  (save new_cap) — stack: [rsp+0]=new_cap [rsp+8]=old_ptr [rsp+16]=value
    self.cg_e8(0x50);
    // alloc(new_cap*8+16)
    // imul rsi, rax, 8
    self.cg_e8(0x48); self.cg_e8(0x6B); self.cg_e8(0xF0); self.cg_e8(0x08);
    // add rsi, 16
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC6); self.cg_e8(0x10);
    // xor edi, edi
    self.cg_e8(0x31); self.cg_e8(0xFF);
    // mov edx, 3
    self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov eax, 34  (MAP_ANON|MAP_PRIVATE)
    self.cg_e8(0xB8); self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov r10, rax
    self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);
    // mov rax, -1  (fd = -1, sign-extended imm32)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0);
    self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);
    // mov r8, rax
    self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC0);
    // xor r9d, r9d
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);
    // mov eax, 9
    self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall  → rax=new_ptr (rcx, r11 trashed by syscall)
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // push rax (save new_ptr) — stack: [rsp+0]=new_ptr [rsp+8]=new_cap [rsp+16]=old_ptr [rsp+24]=value
    self.cg_e8(0x50);

    // rep movsb: copy data from old+16 to new+16
    // mov r11, [rsp+16]  (r11 = old_ptr)
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x5C); self.cg_e8(0x24); self.cg_e8(0x10);
    // lea rdi, [rax+16]  (dst = new+16)
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x78); self.cg_e8(0x10);
    // lea rsi, [r11+16]  (src = old+16)
    self.cg_e8(0x49); self.cg_e8(0x8D); self.cg_e8(0x73); self.cg_e8(0x10);
    // mov rcx, [r11+8]   (rcx = len)
    self.cg_e8(0x49); self.cg_e8(0x8B); self.cg_e8(0x4B); self.cg_e8(0x08);
    // imul rcx, rcx, 8   (count in bytes = len * 8)
    self.cg_e8(0x48); self.cg_e8(0x6B); self.cg_e8(0xC9); self.cg_e8(0x08);
    // cld; rep movsb  (rcx, rdi, rsi trashed after)
    self.cg_e8(0xFC); self.cg_e8(0xF3); self.cg_e8(0xA4);

    // pop rax  (new_ptr)
    self.cg_e8(0x58);
    // pop rdx  (new_cap) — stack: [rsp+0]=old_ptr [rsp+8]=value
    self.cg_e8(0x5A);
    // mov [rax], rdx     ([new+0] = new_cap)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x10);
    // mov rcx, [rsp]     (rcx = old_ptr)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x0C); self.cg_e8(0x24);
    // mov rdx, [rcx+8]   (rdx = len)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x51); self.cg_e8(0x08);
    // mov [rax+8], rdx   ([new+8] = len)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x50); self.cg_e8(0x08);

    // free(old_ptr, old_cap*8+16)
    // push rax  (save new_ptr) — stack: [rsp+0]=new_ptr [rsp+8]=old_ptr [rsp+16]=value
    self.cg_e8(0x50);
    // mov rdi, rcx       (rdi = old_ptr)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xCF);
    // mov rdx, [rcx]     (rdx = old_cap)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x11);
    // imul rdx, rdx, 8
    self.cg_e8(0x48); self.cg_e8(0x6B); self.cg_e8(0xD2); self.cg_e8(0x08);
    // add rdx, 16
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC2); self.cg_e8(0x10);
    // mov eax, 11  (SYS_munmap)
    self.cg_e8(0xB8); self.cg_e8(0x0B); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall  (rax=0 on success; rcx, r11 trashed)
    self.cg_e8(0x0F); self.cg_e8(0x05);

    // pop rcx  (rcx = new_ptr) — stack: [rsp+0]=old_ptr [rsp+8]=value
    self.cg_e8(0x59);
    // store new_ptr to local variable: mov rax,rcx → storeRax → mov rcx,rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC8);
    self.cg_storeRax(off);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);
    // add rsp, 8  (discard old_ptr) — stack: [rsp+0]=value
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x08);

    // Patch jl .no_grow to here
    poke8(self.code + jlNoGrow, self.codeLen - jlNoGrow - 1);

    // ---- APPEND (both paths join here) ----
    // Stack: [rsp+0]=value, rcx=array_ptr
    // pop rax               (restore value)
    self.cg_e8(0x58);
    // mov rdx, [rcx+8]      (len — reload; may have changed after grow)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x51); self.cg_e8(0x08);
    // lea rsi, [rcx+16]     (rsi = data start)
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x71); self.cg_e8(0x10);
    // mov [rsi+rdx*8], rax  (data[len] = value)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0xD6);
    // inc rdx
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC2);
    // mov [rcx+8], rdx      ([ptr+8] = len+1)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x51); self.cg_e8(0x08);
    // xor rax, rax          (return 0)
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
  }

  // Inline code for arr.pop(): decrement len, return last element (0 if empty)
  fn cg_genArrayPop(objNode: int64) {
    var aname: pchar := self.cg_nsval(objNode);
    var anlen: int64 := self.cg_nslen(objNode);
    var off: int64 := self.cg_findLocal(aname, anlen);
    // Load array ptr into rcx
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x4D); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x8D); self.cg_e32(off);
    }
    // test rcx, rcx; jz empty
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC9);
    self.cg_e8(0x0F); self.cg_e8(0x84);
    var jz1Pos: int64 := self.codeLen;
    self.cg_e32(0);
    // rdx = [rcx+8]  (len)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x51); self.cg_e8(0x08);
    // test rdx, rdx; jz empty
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xD2);
    self.cg_e8(0x0F); self.cg_e8(0x84);
    var jz2Pos: int64 := self.codeLen;
    self.cg_e32(0);
    // dec rdx
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCA);
    // [rcx+8] = rdx  (new len)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x51); self.cg_e8(0x08);
    // lea rsi, [rcx+16]
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x71); self.cg_e8(0x10);
    // rax = [rsi+rdx*8]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0xD6);
    // jmp done
    self.cg_e8(0xE9);
    var jmpPos: int64 := self.codeLen;
    self.cg_e32(0);
    // empty: patch jz targets here
    poke32(self.code + jz1Pos, self.codeLen - jz1Pos - 4);
    poke32(self.code + jz2Pos, self.codeLen - jz2Pos - 4);
    // xor rax, rax
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    // done:
    poke32(self.code + jmpPos, self.codeLen - jmpPos - 4);
  }

  // Generate a field load: evaluates object into rax, then loads field
  fn cg_genFieldLoad(ni: int64) {
    var obj: int64 := self.cg_nc0(ni);
    var fieldName: pchar := self.cg_nsval(ni);
    var fieldLen:  int64 := self.cg_nslen(ni);
    self.cg_genExpr(obj);
    // #1092: Safe-Access `a?.v` (iv-Bit 0). Ist der Empfaenger null, wird das
    // Feld NICHT gelesen und das Ergebnis ist null. Der Empfaenger wird dabei
    // genau EINMAL ausgewertet -- eine Pruefung um den ganzen Aufruf herum
    // haette ihn zweimal berechnet, samt Seiteneffekten bei `f()?.v`.
    //
    // Die Sonderfaelle darunter (Array-.length, Enum-Mitglied, Typname.Feld)
    // haben keinen Empfaenger, der null sein koennte; fuer sie ist die
    // Markierung bedeutungslos und der Sprung wird sofort geschlossen.
    var safeJz: int64 := 0 - 1;
    if ((self.cg_nival(ni) & 1) != 0) {
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
      self.cg_e8(0x0F); self.cg_e8(0x84);                       // jz ueber den Zugriff
      safeJz := self.codeLen;
      self.cg_e32(0);
    }
    // Array .length / .data field accessors
    if (self.cg_identIsArray(obj) != 0) {
      var lenStr:  pchar := "length";
      var dataStr: pchar := "data";
      if (self.cg_seq(fieldName, fieldLen, lenStr, 6)) {
        // mov rax, [rax+8]   (load len field)
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40); self.cg_e8(0x08);
      } else if (self.cg_seq(fieldName, fieldLen, dataStr, 4)) {
        // lea rax, [rax+16]  (pointer to first element, past {cap,len} header)
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x40); self.cg_e8(0x10);
      } else {
        self.cg_zeroRax();
      }
      if (safeJz >= 0) { poke32(self.code + safeJz, self.codeLen - safeJz - 4); }
      return;
    }
    // Enum member access: EnumType.Variant → emit tag value as immediate
    if (self.cg_nkind(obj) == CGN_IDENT) {
      var ename: pchar := self.cg_nsval(obj);
      var elen:  int64 := self.cg_nslen(obj);
      var enumIdx: int64 := self.cg_findEnum(ename, elen);
      if (enumIdx >= 0) {
        var tagInfo: int64 := self.cg_findEnumVariant(enumIdx, fieldName, fieldLen);
        if (tagInfo >= 0) {
          self.cg_movRaxImm(tagInfo);
        } else {
          self.cg_zeroRax();
        }
        if (safeJz >= 0) { poke32(self.code + safeJz, self.codeLen - safeJz - 4); }
      return;
      }
      // TypeName.field — emit field byte offset as compile-time constant
      var classIdx0: int64 := self.cg_findClass(ename, elen);
      if (classIdx0 >= 0) {
        var foff0: int64 := self.cg_getFieldOffset(classIdx0, fieldName, fieldLen);
        if (foff0 >= 0) {
          self.cg_movRaxImm(foff0);
        } else {
          self.cg_zeroRax();
        }
        if (safeJz >= 0) { poke32(self.code + safeJz, self.codeLen - safeJz - 4); }
      return;
      }
    }
    var classIdx: int64 := self.cg_objClassIdx(obj);
    var foff: int64 := -1;
    if (classIdx >= 0) { foff := self.cg_getFieldOffset(classIdx, fieldName, fieldLen); }
    // #1038: Breite des Feldes. Bisher wurde IMMER mit 8 Byte geladen — in einem
    // @packed-Struct liegen die Nachbarfelder aber unmittelbar dahinter und kamen
    // damit im Ergebnis mit hoch: `magic` (uint8) auf Offset 0 lieferte alle acht
    // Bytes der Struktur. Beim SCHREIBEN wurde die Breite laengst beachtet, nur
    // beim Lesen nicht.
    var fFlags: int64 := 0;
    if (foff >= 0 && classIdx >= 0) {
      fFlags := self.cg_getFieldBigEndian(classIdx, fieldName, fieldLen);
    }
    var ldW: int64 := (fFlags >> 8) & 0xFF;
    var ldSigned: int64 := (fFlags >> 2) & 1;
    if (foff < 0) {
      self.cg_zeroRax();
    } else if (ldW == 1 || ldW == 2 || ldW == 4) {
      self.cg_emitNarrowLoadRax(foff, ldW, ldSigned);
    } else if (foff == 0) {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x00);
    } else if (foff <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40); self.cg_e8(foff);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80); self.cg_e32(foff);
    }
    // WP-4.1-B: emit BSWAP after load for @big_endian fields
    if (foff >= 0 && classIdx >= 0) {
      if ((fFlags & 1) != 0) {
        var tWidth: int64 := (fFlags >> 8) & 0xFF;
        self.cg_emitBswapRax(tWidth);
      }
    }
    // #1092: Ziel der Nullpruefung -- rax traegt dann bereits null.
    if (safeJz >= 0) { poke32(self.code + safeJz, self.codeLen - safeJz - 4); }
  }

  // #1038: schmales Feld aus [rax+off] nach rax laden.
  // width 1/2: movzx bzw. movsx nach rax; width 4: mov eax (nullt die oberen
  // 32 Bit implizit) bzw. movsxd. Vorzeichenbehaftet sind int8/i8/int16/i16/
  // int32/i32 — bei uintN/uN wird genullt.
  fn cg_emitNarrowLoadRax(off: int64, width: int64, isSigned: int64) {
    if (width == 1) {
      if (isSigned != 0) { self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBE); }  // movsx rax, byte
      else               { self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); }  // movzx rax, byte
    } else if (width == 2) {
      if (isSigned != 0) { self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBF); }  // movsx rax, word
      else               { self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB7); }  // movzx rax, word
    } else {
      if (isSigned != 0) { self.cg_e8(0x48); self.cg_e8(0x63); }                    // movsxd rax, dword
      else               { self.cg_e8(0x8B); }                                      // mov eax, dword
    }
    if (off == 0) {
      self.cg_e8(0x00);
    } else if (off <= 127) {
      self.cg_e8(0x40); self.cg_e8(off);
    } else {
      self.cg_e8(0x80); self.cg_e32(off);
    }
  }

  // Generate a method declaration (with implicit self as first param)
  fn cg_genMethodDecl(ni: int64, className: pchar, classNameLen: int64) {
    var mname: pchar := self.cg_nsval(ni);
    var mlen:  int64 := self.cg_nslen(ni);
    // WP-BC-19: record code start for VMT method slot patching
    var methodCodeStart: int64 := self.codeLen;
    // Build mangled name: className_methodName
    var mangLen: int64 := classNameLen + 1 + mlen;
    var mangBuf: int64 := alloc(mangLen + 1);
    var ii: int64 := 0;
    while (ii < classNameLen) { poke8(mangBuf + ii, StrCharAt(className, ii)); ii := ii + 1; }
    StrSetChar(mangBuf as pchar, classNameLen, 95);
    var jj: int64 := 0;
    while (jj < mlen) { poke8(mangBuf + classNameLen + 1 + jj, StrCharAt(mname, jj)); jj := jj + 1; }
    poke8(mangBuf + mangLen, 0);
    // Register label with mangled name
    self.cg_addLabel(mangBuf as pchar, mangLen, self.cg_lineOf(ni));
    // Track mangled name buffer for cleanup after patching (BUG-02)
    self.cg_trackTempBuf(mangBuf, mangLen + 1);
    // Reset locals
    self.localCount := 0;
    self.frameSize  := 0;
    // Set class context for self.field access
    self.curClassName    := className;
    self.curClassNameLen := classNameLen;
    // Emit prologue
    var prologuePatch: int64 := self.cg_emitPrologue();
    // Implicit self parameter at register 0 (rdi)
    var selfOff: int64 := self.cg_addLocal("self", 4);
    self.cg_setLocalType(self.localCount - 1, className, classNameLen);
    self.cg_spillRdi(selfOff);
    // Regular params start at register index 1
    var param: int64 := self.cg_nc0(ni);
    var paramIdx: int64 := 1;
    while (param != -1 && paramIdx < 6) {
      var pname: pchar := self.cg_nsval(param);
      var pnlen: int64 := self.cg_nslen(param);
      var poff: int64 := self.cg_addLocal(pname, pnlen);
      // Track param type if it's a user type (NK_TYPE_NAME = 60)
      var ptypeNode: int64 := self.cg_nc0(param);
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == 60) {
        self.cg_setLocalType(self.localCount - 1, self.cg_nsval(ptypeNode), self.cg_nslen(ptypeNode));
      }
      // #1003: inline geschriebener fn-Zeigertyp als Parameter
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == CGN_FN_PTR_NODE) {
        poke8(self.localIsFnPtr + self.localCount - 1, 1);
      }
      if (paramIdx == 1) { self.cg_spillRsi(poff); }
      else if (paramIdx == 2) { self.cg_spillRdx(poff); }
      else if (paramIdx == 3) { self.cg_spillRcx(poff); }
      else if (paramIdx == 4) { self.cg_spillR8(poff); }
      else if (paramIdx == 5) { self.cg_spillR9(poff); }
      paramIdx += 1;
      param := self.cg_nnext(param);
    }
    // L-4: stack params at [rbp+16], [rbp+24], ... (method explicit params 5+ on stack)
    var mspOff: int64 := 16;
    while (param != -1) {
      var mspName: pchar := self.cg_nsval(param);
      var mspNlen: int64 := self.cg_nslen(param);
      var mspLocal: int64 := self.cg_addLocal(mspName, mspNlen);
      var mspType: int64 := self.cg_nc0(param);
      if (mspType >= 0 && self.cg_nkind(mspType) == 60) {
        self.cg_setLocalType(self.localCount - 1, self.cg_nsval(mspType), self.cg_nslen(mspType));
      }
      self.cg_loadRax(mspOff);
      self.cg_storeRax(mspLocal);
      mspOff += 8;
      param := self.cg_nnext(param);
    }
    // Generate body
    var body: int64 := self.cg_nc2(ni);
    self.cg_genBlock(body);
    // Implicit return
    self.cg_zeroRax();
    self.cg_emitEpilogue();
    // Patch frame size
    var fs: int64 := self.frameSize + 15;
    var aligned: int64 := fs - (fs & 15);
    if (aligned == 0) { aligned := 16; }
    poke32(self.code + prologuePatch, aligned);
    // Clear class context
    self.curClassName    := 0 as pchar;
    self.curClassNameLen := 0;
    // WP-BC-19: register VMT method slot patch for virtual methods only
    var isVirtM: int64 := (self.cg_nival(ni) >> 1) & 1;
    var classIdx: int64 := self.cg_findClass(className, classNameLen);
    if (isVirtM != 0 && classIdx >= 0) {
      var slotCount: int64   := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTSLOTS);
      var methodList2: int64 := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTLIST);
      var vmtDataOff2: int64 := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTOFF);
      var si5: int64 := 0;
      while (si5 < slotCount) {
        var sName5: pchar := peek64(methodList2 + si5 * 16) as pchar;
        var sLen5:  int64 := peek64(methodList2 + si5 * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN);
        if (self.cg_seq(sName5, sLen5, mname, mlen) != 0) {
          self.cg_addVmtMethodPatch(vmtDataOff2 + si5 * 8, methodCodeStart);
          break;
        }
        si5 += 1;
      }
    }
  }

  // ------------------------------------------------------------------
  // Expression code generation — result always in RAX
  // ------------------------------------------------------------------

  fn cg_genExpr(ni: int64) {
    if (ni < 0) { self.cg_zeroRax(); return; }
    // #1030: Beim Emittieren eines aufgeschobenen Aufrufs liefern die
    // Argumentknoten den bei der Vormerkung gesicherten Wert.
    if (self.dfReplay != 0) {
      var dfIdx: int64 := self.cg_deferArgIdx(ni);
      if (dfIdx >= 0) { self.cg_loadRax(peek64(self.dfSlots + dfIdx * 8)); return; }
    }
    var k: int64 := self.cg_nkind(ni);

    if (k == CGN_MATCH) {
      // match als Ausdruck: cg_genMatch laesst den Wert des getroffenen
      // Fallrumpfes in rax stehen (jeder Fall endet mit cg_genExpr des Rumpfes
      // und springt danach ans Ende), im Durchfall 0.
      self.cg_genMatch(ni);

    } else if (k == CGN_LIT_INT) {
      self.cg_movRaxImm(self.cg_nival(ni));

    } else if (k == CGN_LIT_BOOL) {
      self.cg_movRaxImm(self.cg_nival(ni));

    } else if (k == CGN_LIT_CHAR) {
      self.cg_movRaxImm(self.cg_nival(ni));

    } else if (k == CGN_LIT_NULL) {
      self.cg_zeroRax();

    // WP-BC-13: format expression — evaluate inner expr; width/decimals available via nc1/nc2
    } else if (k == CGN_FORMAT_EXPR) {
      self.cg_genExpr(self.cg_nc0(ni));

    // WP-BC-14: null coalescing x ?? fallback — if x != null use x, else fallback
    } else if (k == CGN_NULL_COAL) {
      self.cg_genExpr(self.cg_nc0(ni));          // rax = lhs
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
      self.cg_e8(0x75);                            // jnz short (lhs is not null, keep it)
      var pSkip: int64 := self.codeLen;
      self.cg_e8(0);
      self.cg_genExpr(self.cg_nc1(ni));          // rax = fallback (only if lhs was null)
      poke8(self.code + pSkip, self.codeLen - pSkip - 1);

    // WP-BC-14: safe cast x as? T — pass-through in bootstrap (nullable = same repr)
    } else if (k == CGN_SAFE_CAST) {
      self.cg_genExpr(self.cg_nc0(ni));

    } else if (k == CGN_SIMD_NEW) {
      // WP-GPU-01: parallel Array<f32>(size) — alloc size*4+24 bytes (16 align + 8 count slot).
      // Layout: [count:8B][up-to-15B padding][aligned data: size*4 bytes]
      // ptr = (mmap_base + 23) & ~15 → always ptr-8 >= mmap_base; count stored at ptr-8.
