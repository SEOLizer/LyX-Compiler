      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x10);  // mov rdi, [rsp+16] = fd
      self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);
      // return buf
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0x24);  // mov rax, [rsp] = buf
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x18);  // add rsp, 24
      poke32(self.code + fraDone,   self.codeLen - fraDone   - 4);  // patch near jmp .fraDone (rel32)
      poke32(self.code + fraClose1, self.codeLen - fraClose1 - 4);  // WP-31: patch size<=0 error jmp
      poke32(self.code + fraClose2, self.codeLen - fraClose2 - 4);  // WP-31: patch size>256MB error jmp

    } else if (self.cg_seq(fname, fnlen, "FileWriteAll", 12)) {
      // FileWriteAll(path, data, len): rdi=path, rsi=data, rdx=len → rax=bytes written
      // open(path, O_WRONLY|O_CREAT|O_TRUNC=577, 0644)
      self.cg_e8(0x52);  // push rdx (len)
      self.cg_e8(0x56);  // push rsi (data)
      self.cg_e8(0xBE); self.cg_e8(0x41); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00);  // mov esi, 577
      self.cg_e8(0xBA); self.cg_e8(0xA4); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00);  // mov edx, 0644 (420)
      self.cg_e8(0xB8); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // open → rax=fd
      self.cg_e8(0x50);  // push rax (fd)
      // [rsp]=fd [rsp+8]=data [rsp+16]=len
      // write(fd, data, len)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0x24);  // mov rdi, [rsp] = fd
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rsi, [rsp+8] = data
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x10);  // mov rdx, [rsp+16] = len
      self.cg_movRaxImm(1);
      self.cg_e8(0x0F); self.cg_e8(0x05);  // write → rax=bytes_written
      self.cg_e8(0x50);  // push rax (bytes_written)
      // close(fd)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rdi, [rsp+8] = fd
      self.cg_e8(0xB8); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      self.cg_e8(0x0F); self.cg_e8(0x05);
      // return bytes_written
      self.cg_e8(0x58);  // pop rax (bytes_written)
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x18);  // add rsp, 24 (fd, data, len)

    } else if (self.cg_findExternDecl(fname, fnlen) >= 0) {
      // FFI call: register this declared extern's GOT slot now (lazy — only
      // called externs get slots/relocations) and call indirectly through it.
      // The SysV ABI requires %rsp 16-byte aligned at the call, or libc/OpenSSL
      // crash on aligned SSE moves (movaps). Lyx's own calls don't need this,
      // so we align locally only for FFI: save rsp, align down, restore after.
      // Args are already in rdi/rsi/rdx/rcx/r8/r9; aligning rsp doesn't touch
      // them. disp32 is patched in cg_writeELFDynamic once the GOT VA is known.
      var exd: int64 := self.cg_findExternDecl(fname, fnlen);
      var edb: int64 := self.externDecls + exd * CG_EXTERN_SZ;
      var exIdx: int64 := self.cg_addExtern(peek64(edb) as pchar, peek64(edb + CG_EXTERN_OFF_NAMELEN),
                                            peek64(edb + CG_EXTERN_OFF_LIBPTR), peek64(edb + CG_EXTERN_OFF_LIBLEN));
      self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xE3);            // mov r11, rsp
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xE4); self.cg_e8(0xF0);  // and rsp, -16
      self.cg_e8(0x41); self.cg_e8(0x53);                              // push r11
      self.cg_e8(0x41); self.cg_e8(0x53);                              // push r11 (keep 16-align)
      self.cg_e8(0x31); self.cg_e8(0xC0);                              // xor eax, eax
      self.cg_e8(0xFF); self.cg_e8(0x15);                              // call *disp32(%rip)
      var ppx: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_addPatch(ppx, exIdx, 0, CG_PATCH_EXTERN);
      self.cg_e8(0x41); self.cg_e8(0x5B);                              // pop r11
      self.cg_e8(0x5C);                                                 // pop rsp (restore)

    } else if (self.cg_seq(fname, fnlen, "sizeof", 6)) {
      // sizeof(Type) → compile-time byte size of class/struct
      var soArg: int64 := argNode;
      var soSize: int64 := 8;
      if (soArg >= 0) {
        var soName: pchar := self.cg_nsval(soArg);
        var soLen:  int64 := self.cg_nslen(soArg);
        var soClassIdx: int64 := self.cg_findClass(soName, soLen);
        if (soClassIdx >= 0) {
          var soCb: int64 := self.classLayouts + soClassIdx * CG_CLASS_SZ;
          var soFldCnt:   int64 := peek64(soCb + CG_CLASS_OFF_FIELDCNT);
          var soVmtSlots: int64 := peek64(soCb + CG_CLASS_OFF_VMTSLOTS);
          // #1084: Die Groesse aus dem tatsaechlichen Layout ableiten, nicht
          // aus der Feldzahl. Bei einem gepackten Struct lagen die Felder
          // laengst dicht beieinander, `sizeof` meldete aber weiter
          // Feldzahl * 8 -- drei uint8 ergaben 24 statt 3. Wer damit
          // allokiert oder serialisiert, rechnet still falsch.
          //
          // Fuer ungepackte Structs und Klassen aendert sich nichts: dort ist
          // der letzte Offset (n-1)*8 bzw. n*8 und die Breite 8, die Summe
          // also genau der bisherige Wert.
          var soFlds: int64 := peek64(soCb + CG_CLASS_OFF_FIELDSPTR);
          if (soFldCnt > 0 && soFlds != 0) {
            var soMax: int64 := 0;
            var soI: int64 := 0;
            while (soI < soFldCnt) {
              var soFb: int64 := soFlds + soI * CG_CFIELD_SZ;
              var soOff: int64 := peek64(soFb + CG_CFIELD_OFF_OFFSET);
              var soW: int64 := (peek64(soFb + CG_CFIELD_OFF_FLAGS) >> 8) & 0xFF;
              if (soW <= 0) { soW := 8; }
              if (soOff + soW > soMax) { soMax := soOff + soW; }
              soI := soI + 1;
            }
            soSize := soMax;
          } else {
            if (soVmtSlots > 0) {
              soSize := (soFldCnt + 1) * 8;
            } else {
              soSize := soFldCnt * 8;
            }
          }
        }
      }
      self.cg_movRaxImm(soSize);

    } else {
      // User-defined function call: emit call + patch
      var pp: int64 := self.cg_emitCall();
      self.cg_addPatch(pp, fname as int64, fnlen, CG_PATCH_CALL);
      self.cg_popStackArgs(nTotal);
    }
  }

  // ------------------------------------------------------------------
  // Statement code generation
  // ------------------------------------------------------------------

  // WSP-05: vergleicht Inhalt eines asm-String-Literals (zwischen den Quotes) mit Mnemonic m.
  fn cg_asmIs(child: int64, m: pchar, mlen: int64): int64 {
    var sp: int64 := self.cg_nsval(child) as int64;
    var sl: int64 := self.cg_nslen(child);
    var inner: int64 := 1;                       // sp[0] = '"'
    while (inner < sl && StrCharAt(sp as pchar, inner) != 34) { inner := inner + 1; }
    var innerLen: int64 := inner - 1;
    if (innerLen != mlen) { return 0; }
    return self.cg_seq((sp + 1) as pchar, innerLen, m, mlen);
  }

  // WSP-05: asm { "mnemonic" ... } → x86-Bytes via feste Mnemonic-Tabelle. Unbekannt = Fehler.
  fn cg_genAsm(ni: int64) {
    var c: int64 := self.cg_nc0(ni);
    while (c >= 0) {
      if      (self.cg_asmIs(c, "cli"c, 3))    { self.cg_e8(0xFA); }
      else if (self.cg_asmIs(c, "sti"c, 3))    { self.cg_e8(0xFB); }
      else if (self.cg_asmIs(c, "hlt"c, 3))    { self.cg_e8(0xF4); }
      else if (self.cg_asmIs(c, "nop"c, 3))    { self.cg_e8(0x90); }
      else if (self.cg_asmIs(c, "pause"c, 5))  { self.cg_e8(0xF3); self.cg_e8(0x90); }
      else if (self.cg_asmIs(c, "cpuid"c, 5))  { self.cg_e8(0x0F); self.cg_e8(0xA2); }
      else if (self.cg_asmIs(c, "iretq"c, 5))  { self.cg_e8(0x48); self.cg_e8(0xCF); }
      else if (self.cg_asmIs(c, "wbinvd"c, 6)) { self.cg_e8(0x0F); self.cg_e8(0x09); }
      else if (self.cg_asmIs(c, "invd"c, 4))   { self.cg_e8(0x0F); self.cg_e8(0x08); }
      else if (self.cg_asmIs(c, "sfence"c, 6)) { self.cg_e8(0x0F); self.cg_e8(0xAE); self.cg_e8(0xF8); }
      else if (self.cg_asmIs(c, "lfence"c, 6)) { self.cg_e8(0x0F); self.cg_e8(0xAE); self.cg_e8(0xE8); }
      else if (self.cg_asmIs(c, "mfence"c, 6)) { self.cg_e8(0x0F); self.cg_e8(0xAE); self.cg_e8(0xF0); }
      else if (self.cg_asmIs(c, "rdtsc"c, 5))  { self.cg_e8(0x0F); self.cg_e8(0x31); }
      else if (self.cg_asmIs(c, "ud2"c, 3))    { self.cg_e8(0x0F); self.cg_e8(0x0B); }
      else if (self.cg_asmIs(c, "int3"c, 4))   { self.cg_e8(0xCC); }
      else if (self.cg_asmIs(c, "leave"c, 5))  { self.cg_e8(0xC9); }
      else if (self.cg_asmIs(c, "ret"c, 3))    { self.cg_e8(0xC3); }
      else if (self.cg_asmIs(c, "lgdt [rdi]"c, 10))   { self.cg_e8(0x0F); self.cg_e8(0x01); self.cg_e8(0x17); }
      else if (self.cg_asmIs(c, "lidt [rdi]"c, 10))   { self.cg_e8(0x0F); self.cg_e8(0x01); self.cg_e8(0x1F); }
      else if (self.cg_asmIs(c, "invlpg [rdi]"c, 12)) { self.cg_e8(0x0F); self.cg_e8(0x01); self.cg_e8(0x3F); }
      else {
        EPrintStrLn("error: asm: unbekannte/nicht-unterstuetzte Mnemonic"c);
        exit(1);
      }
      c := self.cg_nnext(c);
    }
  }

  fn cg_genStmt(ni: int64) {
    if (ni < 0) { return; }
    var k: int64 := self.cg_nkind(ni);

    if (k == CGN_BLOCK) {
      self.cg_genBlock(ni);

    } else if (k == CGN_ASM) {
      self.cg_genAsm(ni);

    } else if (k == CGN_VAR_DECL || k == CGN_CON_DECL) {
      var name: pchar := self.cg_nsval(ni);
      var nlen: int64 := self.cg_nslen(ni);
      var off: int64 := self.cg_addLocal(name, nlen);
      var localIdx: int64 := self.localCount - 1;
      // Track type for OOP local lookup (child0 = type node, NK_TYPE_NAME = 60)
      var typeNode: int64 := self.cg_nc0(ni);
      if (typeNode >= 0 && self.cg_nkind(typeNode) == 60) {
        self.cg_setLocalType(localIdx, self.cg_nsval(typeNode), self.cg_nslen(typeNode));
      }
      // #1003: inline geschriebener fn-Zeigertyp — hat keinen Namen, den die
      // fnAlias-Liste tragen koennte, also am Local selbst vermerken.
      if (typeNode >= 0 && self.cg_nkind(typeNode) == CGN_FN_PTR_NODE) {
        poke8(self.localIsFnPtr + localIdx, 1);
      }
      // Track array locals: NK_TYPE_ARRAY (=61) or NK_TYPE_NAME "Array<T>" (uppercase, =60)
      if (typeNode >= 0 && self.cg_nkind(typeNode) == 61) {
        poke8(self.localIsArray + localIdx, 1);
        // For T[] where T is a struct: store element type name in localTypes
        var elemNode: int64 := self.cg_nc0(typeNode);
        if (elemNode >= 0 && self.cg_nkind(elemNode) == 60) {
          var etn: pchar := self.cg_nsval(elemNode);
          var etl: int64 := self.cg_nslen(elemNode);
          if (self.cg_findClass(etn, etl) >= 0) {
            self.cg_setLocalType(localIdx, etn, etl);
          }
        }
      }
      if (typeNode >= 0 && self.cg_nkind(typeNode) == 60) {
        var tnArr: pchar := self.cg_nsval(typeNode);
        var tnLen: int64 := self.cg_nslen(typeNode);
        if (self.cg_seq(tnArr, tnLen, "Array", 5)) {
          poke8(self.localIsArray + localIdx, 1);
          // For Array<T> where T is a struct: store element type name in localTypes
          var elemNode2: int64 := self.cg_nc1(typeNode);
          if (elemNode2 >= 0 && self.cg_nkind(elemNode2) == 60) {
            var etn2: pchar := self.cg_nsval(elemNode2);
            var etl2: int64 := self.cg_nslen(elemNode2);
            if (self.cg_findClass(etn2, etl2) >= 0) {
              self.cg_setLocalType(localIdx, etn2, etl2);
            }
          }
        }
      }
      // WP-GPU-01: CGN_TYPE_PARALLEL (=93) — mark as SIMD parallel array
      if (typeNode >= 0 && self.cg_nkind(typeNode) == 93) {
        poke8(self.localIsSimd + localIdx, 1);
        poke8(self.localIsArray + localIdx, 0);  // not a regular Array
      }
      // WP-BC-51: NK_TYPE_ARRAY_FIXED (=101) — store compile-time size
      if (typeNode >= 0 && self.cg_nkind(typeNode) == 101) {
        poke8(self.localIsArray + localIdx, 1);
        var sizeNode: int64 := self.cg_nc1(typeNode);
        if (sizeNode >= 0 && self.cg_nkind(sizeNode) == CGN_LIT_INT) {
          poke64(self.localArraySize + localIdx * 8, self.cg_nival(sizeNode));
        }
      }
      // Infer class type when declared as int64 but initialized from:
      //   var x: int64 := SomeClass.Create(...)  — static constructor
      //   var x: int64 := expr as SomeClass       — explicit cast
      if (self.cg_getLocalClassIdx(name, nlen) < 0) {
        var infInit: int64 := self.cg_nc1(ni);
        if (infInit >= 0) {
          // Pattern 1: TypeName.Method() static constructor
          if (self.cg_nkind(infInit) == CGN_CALL && self.cg_nival(infInit) == 1) {
            var infObj: int64 := self.cg_nc0(infInit);
            if (self.cg_nkind(infObj) == CGN_IDENT) {
              var infName: pchar := self.cg_nsval(infObj);
              var infLen:  int64 := self.cg_nslen(infObj);
              if (self.cg_findLocalIdx(infName, infLen) < 0 &&
                  self.cg_findClass(infName, infLen) >= 0) {
                self.cg_setLocalType(localIdx, infName, infLen);
              }
            }
          }
          // Pattern 2: expr as SomeClass
          if (self.cg_nkind(infInit) == CGN_CAST) {
            var castType: int64 := self.cg_nc1(infInit);
            if (castType >= 0) {
              var ctName: pchar := self.cg_nsval(castType);
              var ctLen:  int64 := self.cg_nslen(castType);
              if (self.cg_findClass(ctName, ctLen) >= 0) {
                self.cg_setLocalType(localIdx, ctName, ctLen);
              }
            }
          }
          // #1085: Muster 3 und 4 gelten nur OHNE Typangabe. Bisher blieb der
          // Typ einer so deklarierten Variablen leer, und alles, was ihn
          // braucht, nahm stillschweigend "Ganzzahl" an:
          //   var n := "Lyx";      PrintLn(n)  gab die ADRESSE aus
          //   var p := new Foo();  p.v         lieferte 0, Methoden brachen ab
          // Beides ohne Meldung. Die Dokumentation fuehrt genau diese Zeilen
          // als Beispiel mit dem Vermerk "Typ inferiert".
          if (typeNode < 0) {
            var ik: int64 := self.cg_nkind(infInit);
            // Muster 3: Literale tragen ihren Typ selbst.
            if (ik == CGN_LIT_STR)   { self.cg_setLocalType(localIdx, "pchar"c, 5); }
            if (ik == CGN_LIT_FLOAT) { self.cg_setLocalType(localIdx, "f64"c,   3); }
            if (ik == CGN_LIT_BOOL)  { self.cg_setLocalType(localIdx, "bool"c,  4); }
            // Muster 4: new T() -> T
            if (ik == CGN_NEW) {
              var nwName: pchar := self.cg_nsval(infInit);
              var nwLen:  int64 := self.cg_nslen(infInit);
              if (self.cg_findClass(nwName, nwLen) >= 0) {
                self.cg_setLocalType(localIdx, nwName, nwLen);
              }
            }
            // Muster 5: Ergebnis eines Aufrufs. Dieselbe Auskunft, die
            // cg_inferPrintType fuer #1058 benutzt -- zuerst der deklarierte
            // Rueckgabetyp aus der Registry, sonst die Zeichenketten-Builtins.
            if (ik == CGN_CALL && self.cg_nival(infInit) == 0) {
              var cnm2: pchar := self.cg_nsval(infInit);
              var cnl2: int64 := self.cg_nslen(infInit);
              var d2: int64 := self.cg_funcRetTypeIs(cnm2, cnl2, "pchar"c, 5);
              if (d2 == 1) { self.cg_setLocalType(localIdx, "pchar"c, 5); }
              else {
                if (d2 == 0) {
                  if (self.cg_funcRetTypeIs(cnm2, cnl2, "f64"c, 3) == 1) { self.cg_setLocalType(localIdx, "f64"c, 3); }
                  else { if (self.cg_funcRetTypeIs(cnm2, cnl2, "bool"c, 4) == 1) { self.cg_setLocalType(localIdx, "bool"c, 4); } }
                } else {
                  // Nicht in der Registry -> Builtin
                  if (self.cg_builtinReturnsPchar(cnm2, cnl2) != 0) { self.cg_setLocalType(localIdx, "pchar"c, 5); }
                }
              }
            }
          }
        }
      }
      var init: int64 := self.cg_nc1(ni);
      // WP-BC-51: count array literal elements for len() support
      if (init >= 0 && self.cg_nkind(init) == 100) {
        var acnt: int64 := 0;
        var ael: int64 := self.cg_nc0(init);
        while (ael != -1) { acnt := acnt + 1; ael := self.cg_nnext(ael); }
        poke8(self.localIsArray + localIdx, 1);
        poke64(self.localArraySize + localIdx * 8, acnt);
      }
      if (init >= 0) {
        self.cg_genExpr(init);
      } else {
        // Fixed-size array (int64[N]): heap-allocate N*8 bytes
        var fixedSz: int64 := peek64(self.localArraySize + localIdx * 8);
        if (typeNode >= 0 && self.cg_nkind(typeNode) == 101 && fixedSz > 0) {
          // mmap(0, fixedSz*8, PROT_RW, MAP_ANON, -1, 0)
          self.cg_zeroRax();    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7); // mov rdi,0
          self.cg_movRaxImm(fixedSz * 8); self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6); // mov rsi,sz
          self.cg_movRaxImm(3);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2); // mov rdx,3
          self.cg_movRaxImm(34);
          self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);  // mov r10, rax
          self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0);  // xor r8, r8
          self.cg_e8(0x49); self.cg_e8(0xFF); self.cg_e8(0xC8);  // dec r8 → r8=-1
          self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9, r9
          self.cg_movRaxImm(9);
          self.cg_e8(0x0F); self.cg_e8(0x05);
        } else {
        // WP-10d: auto-allocate struct locals (NK_TYPE_NAME=60, vmtDataOff==-1)
        // #1095: Ein struct-Local wird ohne `new` angelegt. Die Bedingung hing
        // bisher daran, dass der Typ KEIN VMT hat -- ein struct MIT Methoden
        // bekommt aber Klassen-Layout und fiel damit heraus. Die Variable blieb
        // uneingerichtet, und schon das erste `p.x := ...` schrieb an eine
        // Adresse nahe null: uebersetzt ohne Warnung, dann Segfault.
        // Jetzt entscheidet die Merkung "als struct deklariert".
        var sdoStruct: int64 := 0;
        if (typeNode >= 0 && self.cg_nkind(typeNode) == 60) {
          var sdoIdx: int64 := self.cg_findClass(self.cg_nsval(typeNode), self.cg_nslen(typeNode));
          if (sdoIdx >= 0) {
            var sdoBase: int64 := self.classLayouts + sdoIdx * CG_CLASS_SZ;
            var sdoVmt: int64 := peek64(sdoBase + CG_CLASS_OFF_VMTOFF);
            if (sdoVmt == -1) { sdoStruct := 1; }
            if (peek64(sdoBase + CG_CLASS_OFF_ISSTRUCT) != 0) { sdoStruct := 1; }
          }
        }
        if (sdoStruct != 0) {
          // alloc(4096) → rax = struct ptr
          self.cg_movRaxImm(0);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7); // mov rdi,rax
          self.cg_movRaxImm(4096); self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6); // mov rsi,rax
          self.cg_movRaxImm(3);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2); // mov rdx,rax
          self.cg_movRaxImm(34);
          self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);  // mov r10, rax
          self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0);  // xor r8, r8
