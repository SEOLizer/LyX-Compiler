      // Switch case body — generate body expression/block
      // c0 = case value (or null for default), c1 = body
      var bodyNode: int64 := self.cg_nc1(ni);
      if (bodyNode >= 0) {
        self.cg_genBlock(bodyNode);
      }

    } else if (k == CGN_MATCH_CASE) {
      // Match case body — generate body expression
      // c0 = pattern, c1 = body expression
      var bodyNode: int64 := self.cg_nc1(ni);
      if (bodyNode >= 0) {
        self.cg_genMatchBody(bodyNode);
      }

    } else if (k == CGN_FIELD_DECL) {
      // Field declaration in struct/class — no code generation needed
      // Layout is handled by cg_buildStructLayout/cg_buildClassLayout
      // Just skip (fields are processed during layout building)

    } else if (k == CGN_PARAM) {
      // Parameter declaration — already handled during function prologue generation
      // In IR-lowering context: register parameter as local variable
      var pname: pchar := self.cg_nsval(ni);
      var plen: int64 := self.cg_nslen(ni);
      var poff: int64 := self.cg_addLocal(pname, plen);
      // Track type if present (c0 = type node)
      var ptypeNode: int64 := self.cg_nc0(ni);
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == 60) {
        self.cg_setLocalType(self.localCount - 1, self.cg_nsval(ptypeNode), self.cg_nslen(ptypeNode));
      }
      // #1003: inline geschriebener fn-Zeigertyp als Parameter
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == CGN_FN_PTR_NODE) {
        poke8(self.localIsFnPtr + self.localCount - 1, 1);
      }

    } else if (k == CGN_AT_DIRECTIVE) {  // WP-CS-07 / WP-AS-04/05
      var kind: int64 := self.cg_nival(ni);
      var val:  int64 := self.cg_nc0(ni);
      if (kind == 0) { self.ioCheckEnabled       := val; }
      if (kind == 1) { self.overflowCheckEnabled := val; }
      if (kind == 2) { self.boundsCheckEnabled   := val; }  // WP-AS-04
      if (kind == 3) { self.debugMode            := val; }  // WP-AS-05: @debug_info aliases debugMode
      if (kind == 4) { self.optLevel             := val; }  // WP-AS-04

    } else if (k == CGN_AT_ENERGY) {  // WP-EN-04: @energy(N); statement override
      self.fnEnergyLevel := self.cg_nival(ni);

    } else if (k == CGN_DEFER) {
      // #1006: Der aufgeschobene Aufruf wird hier nur VORGEMERKT. Emittiert
      // wird er am Ende des umschliessenden Blocks (cg_genBlock) bzw. an jedem
      // vorzeitigen return. Die Vormerkung geschieht an der Stelle, an der das
      // defer im Quelltext steht — ein defer hinter einem return wird damit
      // nicht mehr ausgefuehrt, was der Blocksemantik entspricht.
      if (self.deferCount < self.deferCap) {
        poke64(self.deferBuf + self.deferCount * 8, self.cg_nc0(ni));
        self.deferCount += 1;
        // #1030: Argumente JETZT auswerten und sichern.
        self.cg_captureDeferArgs(self.cg_nc0(ni));
      }

    } else {
      // Other statement kinds: skip
    }
  }

  // WP-AS-10: emit deferred statements in LIFO order (last defer first).
  // Wird an return-Punkten benutzt: dort laufen ALLE noch offenen defers ab,
  // also auch die der umschliessenden Bloecke.
  fn cg_emitDefers() {
    var i: int64 := self.deferCount - 1;
    while (i >= 0) {
      self.cg_genStmt(peek64(self.deferBuf + i * 8));
      i -= 1;
    }
  }

  // #1006: defers eines Blocks abarbeiten — LIFO bis zurueck zum Stand bei
  // Blockeintritt. Der Rest gehoert den umschliessenden Bloecken und bleibt
  // stehen.
  fn cg_emitDefersDownTo(mark: int64) {
    var i: int64 := self.deferCount - 1;
    while (i >= mark) {
      var savedReplay: int64 := self.dfReplay;
      self.dfReplay := 1;                      // #1030
      self.cg_genStmt(peek64(self.deferBuf + i * 8));
      self.dfReplay := savedReplay;
      i -= 1;
    }
  }

  // #1030: Argumente des aufgeschobenen Aufrufs an der Stelle des `defer`
  // auswerten und in verdeckte Slots legen. Ohne das wuerden sie erst am
  // Blockende ausgewertet — `defer f(i)` in einer Schleife saehe dort das
  // bereits erhoehte i.
  fn cg_captureDeferArgs(stmtNi: int64) {
    if (stmtNi < 0) { return; }
    var callNi: int64 := stmtNi;
    if (self.cg_nkind(callNi) == CGN_EXPR_STMT) { callNi := self.cg_nc0(callNi); }
    if (callNi < 0) { return; }
    if (self.cg_nkind(callNi) != CGN_CALL) { return; }
    // Methodenaufruf (iVal==1): Argumente haengen an c1, sonst an c0.
    var argNi: int64 := self.cg_nc0(callNi);
    if (self.cg_nival(callNi) == 1) { argNi := self.cg_nc1(callNi); }
    while (argNi >= 0) {
      if (self.dfCount >= self.dfCap) { return; }
      self.cg_genExpr(argNi);
      var off: int64 := self.cg_addLocal("__dfarg__", 9);
      self.cg_storeRax(off);
      poke64(self.dfNodes + self.dfCount * 8, argNi);
      poke64(self.dfSlots + self.dfCount * 8, off);
      self.dfCount += 1;
      argNi := self.cg_nnext(argNi);
    }
  }

  // #1030: Index des gesicherten Slots fuer einen Argumentknoten, sonst -1.
  // Geliefert wird der INDEX, nicht der Offset: Rahmen-Offsets sind rbp-relativ
  // und damit negativ, ein Offset taugt hier nicht als Trefferkennung.
  fn cg_deferArgIdx(ni: int64): int64 {
    var i: int64 := self.dfCount - 1;
    while (i >= 0) {
      if (peek64(self.dfNodes + i * 8) == ni) { return i; }
      i -= 1;
    }
    return 0 - 1;
  }

  fn cg_genBlock(ni: int64) {
    if (ni < 0) { return; }
    var savedLocals: int64 := self.localCount;
    // #1006: Stand der offenen defers bei Blockeintritt merken.
    var savedDefers: int64 := self.deferCount;
    var stmt: int64 := self.cg_nc0(ni);
    while (stmt != -1) {
      var sk: int64 := self.cg_nkind(stmt);
      // WP-13: verschachtelte fn-Deklaration. NICHT hier emittieren — der Rumpf
      // landete sonst mitten im Instruktionsstrom der äußeren Funktion, die
      // anschließend hineinfällt (der Grund für den SIGSEGV). Stattdessen
      // vormerken und nach der äußeren Funktion emittieren.
      if (sk == CGN_FUNC_DECL) {
        self.cg_addPendingNested(stmt);
      } else {
        self.cg_genStmt(stmt);
      }
      stmt := self.cg_nnext(stmt);
    }
    // #1006: defers dieses Blocks laufen VOR dem Verwerfen der Locals — der
    // aufgeschobene Ausdruck darf auf Variablen des Blocks zugreifen.
    self.cg_emitDefersDownTo(savedDefers);
    self.deferCount := savedDefers;
    // Restore local scope (pop locals declared in this block)
    self.localCount := savedLocals;
  }

  // WP-13: Generate nested function with static link support
  fn cg_genNestedFunc(ni: int64) {
    // Register label for nested function (mangled with parent context)
    var fname: pchar := self.cg_nsval(ni);
    var fnlen: int64 := self.cg_nslen(ni);

    // Generate unique nested function name with parent suffix
    var nestedLabel: int64 := self._allocNestedLabel(fname, fnlen);
    self.cg_addLabel(nestedLabel, 16, self.cg_lineOf(ni));

    // Reset locals but preserve outer function's captured variables
    self.localCount := 0;
    self.frameSize := 0;

    // Check if we have a static link from parent (passed via [rbp+16])
    var hasStaticLink: int64 := 0;
    if (self.staticLinkOffset >= 0) {
      hasStaticLink := 1;
      // Save static link to local slot for captured variable access
      var slOff: int64 := self.cg_addLocal("__static_link__", 15);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x45); self.cg_e8(0x10); // mov rax, [rbp+16]
      self.cg_storeRax(slOff);  // store to local slot
    }

    // Emit prologue with extra space for static link parameter
    var prologuePatch: int64 := self.cg_emitPrologueNested();

    // Spill parameters (child0 = first param, linked via next)
    var param: int64 := self.cg_nc0(ni);
    var paramIdx: int64 := 0;
    while (param != -1 && paramIdx < 6) {
      var pname: pchar := self.cg_nsval(param);
      var pnlen: int64 := self.cg_nslen(param);
      var off: int64 := self.cg_addLocal(pname, pnlen);
      // #1003: inline geschriebener fn-Zeigertyp als Parameter
      var nfpType: int64 := self.cg_nc0(param);
      if (nfpType >= 0 && self.cg_nkind(nfpType) == CGN_FN_PTR_NODE) {
        poke8(self.localIsFnPtr + self.localCount - 1, 1);
      }
      if (paramIdx == 0) { self.cg_spillRdi(off); }
      else if (paramIdx == 1) { self.cg_spillRsi(off); }
      else if (paramIdx == 2) { self.cg_spillRdx(off); }
      else if (paramIdx == 3) { self.cg_spillRcx(off); }
      else if (paramIdx == 4) { self.cg_spillR8(off); }
      else if (paramIdx == 5) { self.cg_spillR9(off); }
      paramIdx += 1;
      param := self.cg_nnext(param);
    }

    // BUG-04: Capture analysis — scan body for identifiers not in local scope
    // These must be captured from the outer function's frame
    var body: int64 := self.cg_nc2(ni);
    self._analyzeCaptured(body);

    // Generate function body (child2 = block)
    var savedStaticLink: int64 := self.staticLinkOffset;
    var savedOuterName: pchar := self.outerFuncName;
    var savedOuterLen: int64 := self.outerFuncNameLen;

    // Set up static link context for this nested function
    self.staticLinkOffset := 16;  // rbp+16 = static link param position
    // Capture current function name as outer function

    body := self.cg_nc2(ni);
    self.cg_genBlock(body);

    // Restore outer function context
    self.staticLinkOffset := savedStaticLink;
    self.outerFuncName := savedOuterName;
    self.outerFuncNameLen := savedOuterLen;

    // Implicit return
    self.cg_zeroRax();
    self.cg_emitEpilogue();

    // Patch sub rsp with aligned frame size
    var fs: int64 := self.frameSize + 15;
    var aligned: int64 := fs - (fs & 15);
    if (aligned == 0) { aligned := 16; }
    poke32(self.code + prologuePatch, aligned);
  }

  // BUG-04: Recursively scan AST for identifiers not in local scope
  // and register them as captured variables from the outer function.
  // Must be called AFTER parameter locals are registered but BEFORE codegen.
  fn _analyzeCaptured(ni: int64) {
    if (ni < 0) { return; }
    var k: int64 := self.cg_nkind(ni);

    if (k == CGN_IDENT) {
      var name: pchar := self.cg_nsval(ni);
      var nlen: int64 := self.cg_nslen(ni);
      // Skip built-in identifiers and constants
      if (self.cg_findLocal(name, nlen) == 0 &&
          self.cg_hasConVal(name, nlen) == 0) {
        // Not local and not constant — check if already captured
        if (self.cg_findCapturedVar(name, nlen) == 0) {
          // Register as captured; offset resolved at runtime via static link
          self.cg_addCapturedVar(name, nlen, 0);
        }
      }
    }

    // Recurse into children (expressions and sub-statements)
    // Do NOT follow nnext here — statement lists are handled separately
    var c0: int64 := self.cg_nc0(ni);
    if (c0 >= 0) { self._analyzeCaptured(c0); }
    var c1: int64 := self.cg_nc1(ni);
    if (c1 >= 0) { self._analyzeCaptured(c1); }
    var c2: int64 := self.cg_nc2(ni);
    if (c2 >= 0) { self._analyzeCaptured(c2); }
  }

  // Walk a statement list (linked via nnext) and analyze each statement
  fn _analyzeCapturedStmtList(ni: int64) {
    var cur: int64 := ni;
    while (cur >= 0) {
      self._analyzeCaptured(cur);
      cur := self.cg_nnext(cur);
    }
  }

  // WP-13: Generate nested function prologue (accepts static link in rbp+16)
  // WP-18: Also installs stack canary at [rbp-8], same as cg_emitPrologue.
  fn cg_emitPrologueNested(): int64 {
    self.cg_e8(0x55);                          // push rbp
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE5);  // mov rbp, rsp
    // sub rsp, imm32 (48 81 EC xx xx xx xx)
    self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC);
    var patchPos: int64 := self.codeLen;
    self.cg_e32(0);
    // WP-18: reserve [rbp-8] for canary before any locals
    self.frameSize += 8;
    // mov rax, [rip+CG_CANARY]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05);
    var pCanaryNested: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pCanaryNested, CG_CANARY, 0, CG_PATCH_STR);
    // mov [rbp-8], rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x45); self.cg_e8(0xF8);
    // xor rax, rax
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    // Static link is already in [rbp+16] from caller
    return patchPos;
  }

  // WP-13: Allocate nested function label (simple numbered suffix)
  fn _allocNestedLabel(baseName: pchar, baseLen: int64): pchar {
    // For simplicity, return a fixed label format "_NESTED_0", etc.
    // In full implementation, would dynamically allocate string
    // Just return placeholder - actual label registration handles it
    return "__nested__";
  }

  fn cg_genIf(ni: int64) {
    // WP-10g: dead-branch elimination — if condition is a compile-time constant
    var condNi: int64 := self.cg_nc0(ni);
    if (self.cg_tryFold(condNi) != 0) {
      if (self.foldBuf != 0) {
        self.cg_genBlock(self.cg_nc1(ni));   // condition always true → emit then only
      } else {
        var elseDead: int64 := self.cg_nc2(ni);
        if (elseDead >= 0) {
          if (self.cg_nkind(elseDead) == CGN_BLOCK) {
            self.cg_genBlock(elseDead);
          } else {
            self.cg_genStmt(elseDead);
          }
        }
      }
      return;
    }
    // Evaluate condition
    self.cg_genExpr(condNi);
    // test rax, rax; jz else_label
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
    // jz rel32 (forward)
    self.cg_e8(0x0F); self.cg_e8(0x84);
    var jzPos: int64 := self.codeLen;
    self.cg_e32(0);  // placeholder

    // Then branch
    self.cg_genBlock(self.cg_nc1(ni));

    var elseNode: int64 := self.cg_nc2(ni);
    if (elseNode >= 0) {
      // jmp over else
      self.cg_e8(0xE9);
      var jmpPos: int64 := self.codeLen;
      self.cg_e32(0);
      // Patch jz to here (else start)
      poke32(self.code + jzPos, self.codeLen - jzPos - 4);
      // Else branch
      if (self.cg_nkind(elseNode) == CGN_BLOCK) {
        self.cg_genBlock(elseNode);
      } else {
        self.cg_genStmt(elseNode);
      }
      // Patch jmp to here (end)
      poke32(self.code + jmpPos, self.codeLen - jmpPos - 4);
    } else {
      // Patch jz to here (end, no else)
      poke32(self.code + jzPos, self.codeLen - jzPos - 4);
    }
  }

  // WP-EN-05: copy-unrolling with U copies (U = cg_unrollFactor()).
  // Each copy: eval cond → jz exit, body.
  // Continue in copy K (K<U-1) → start of copy K+1's condition.
  // Continue in last copy → loopTop.
  // All breaks → exit.
  fn cg_genWhile(ni: int64) {
    var U:              int64 := self.cg_unrollFactor();
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead:  int64 := self.curContHead;
    var allBreakHead:   int64 := -1;
    var jzHead:         int64 := -1;
    var prevContHead:   int64 := -1;
    var loopTop:        int64 := self.codeLen;

    var copy: int64 := 0;
    while (copy < U) {
      // Patch previous copy's continue list to here (start of this copy's condition)
      if (prevContHead != -1) { self.cg_patchList(prevContHead, self.codeLen); }
      // Condition
      self.cg_genExpr(self.cg_nc0(ni));
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
      self.cg_e8(0x0F); self.cg_e8(0x84);                     // jz rel32
      self.cg_e32(jzHead);
      jzHead := self.codeLen - 4;
      // Body
      self.curBreakHead := -1;
      self.curContHead  := -1;
      var savedMarkW: int64 := self.loopDeferMark;   // #1006
      self.loopDeferMark := self.deferCount;
      self.cg_genBlock(self.cg_nc1(ni));
      self.loopDeferMark := savedMarkW;
      // Accumulate break list; save this copy's continue list for later
      allBreakHead := self.cg_mergeBreakList(allBreakHead, self.curBreakHead);
      prevContHead := self.curContHead;
      copy += 1;
    }
    // Last copy's continue list → loopTop
    if (prevContHead != -1) { self.cg_patchList(prevContHead, loopTop); }
    // jmp loopTop
    self.cg_e8(0xE9);
    self.cg_e32(loopTop - self.codeLen - 4);
    // .exit: patch all condition exits and break jumps
    var exitPos: int64 := self.codeLen;
    self.cg_patchList(jzHead, exitPos);
    self.cg_patchList(allBreakHead, exitPos);
    // Restore outer loop's break/continue lists
    self.curBreakHead := savedBreakHead;
    self.curContHead  := savedContHead;
  }

  // WP-BC-04: repeat { body } until (cond)
  // body executes first; loop back while cond == 0 (false)
  fn cg_genRepeatUntil(ni: int64) {
    var loopTop: int64 := self.codeLen;
    // Save outer break/continue lists
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead:  int64 := self.curContHead;
    self.curBreakHead := -1;
    self.curContHead  := -1;
    // Body
    var savedMarkR: int64 := self.loopDeferMark;   // #1006
    self.loopDeferMark := self.deferCount;
    self.cg_genBlock(self.cg_nc0(ni));
    self.loopDeferMark := savedMarkR;
    // contPos: patch all continue jumps to here (before condition eval)
    var contPos: int64 := self.codeLen;
    var ch: int64 := self.curContHead;
    while (ch != -1) {
      var b0: int64 := peek8(self.code + ch) as int64;
      var b1: int64 := peek8(self.code + ch + 1) as int64;
      var b2: int64 := peek8(self.code + ch + 2) as int64;
      var b3: int64 := peek8(self.code + ch + 3) as int64;
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + ch, contPos - ch - 4);
      ch := nextLink;
    }
    // Condition → rax
    self.cg_genExpr(self.cg_nc1(ni));
    // test rax, rax; jz loopTop  (if cond false → loop back)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
    self.cg_e8(0x0F); self.cg_e8(0x84);                     // jz rel32
    self.cg_e32(loopTop - self.codeLen - 4);
    // exitPos: patch all break jumps here
    var bh: int64 := self.curBreakHead;
    while (bh != -1) {
      var b0: int64 := peek8(self.code + bh) as int64;
      var b1: int64 := peek8(self.code + bh + 1) as int64;
      var b2: int64 := peek8(self.code + bh + 2) as int64;
      var b3: int64 := peek8(self.code + bh + 3) as int64;
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + bh, self.codeLen - bh - 4);
      bh := nextLink;
    }
    // Restore outer loop lists
    self.curBreakHead := savedBreakHead;
    self.curContHead  := savedContHead;
  }

  // WP-BC-05: var a, b := fn()  — 2-value tuple destructure
  // SysV ABI: first return in rax, second in rdx.
  fn cg_genTupleVarDecl(ni: int64) {
    var name1: pchar := self.cg_nsval(ni);
    var len1:  int64 := self.cg_nslen(ni);
    var off1:  int64 := self.cg_addLocal(name1, len1);

    var secondNode: int64 := self.cg_nc0(ni);
    var name2: pchar := self.cg_nsval(secondNode);
    var len2:  int64 := self.cg_nslen(secondNode);
    var off2:  int64 := self.cg_addLocal(name2, len2);

    // Evaluate init (function call) → rax = first, rdx = second
    self.cg_genExpr(self.cg_nc1(ni));

    self.cg_storeRax(off1);
    self.cg_storeRdx(off2);
  }

  // WP-EN-05: copy-unrolling for range-based for.
  // Each copy: cond → jz exit, body, step (continue lands before step).
  fn cg_genFor(ni: int64) {
    var name: pchar := self.cg_nsval(ni);
    var nlen: int64 := self.cg_nslen(ni);
    var dir:  int64 := self.cg_nival(ni);  // 0=to, 1=downto
    var off:  int64 := self.cg_addLocal(name, nlen);
    // Init: v = start
    self.cg_genExpr(self.cg_nc0(ni));
    self.cg_storeRax(off);

    var U:              int64 := self.cg_unrollFactor();
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead:  int64 := self.curContHead;
    var allBreakHead:   int64 := -1;
    var jzHead:         int64 := -1;
    var loopTop:        int64 := self.codeLen;

    var copy: int64 := 0;
    while (copy < U) {
      // Condition: v <= limit (to) or v >= limit (downto)
      self.cg_loadRax(off);
      self.cg_pushRax();
      self.cg_genExpr(self.cg_nc1(ni));
      self.cg_popRbx();  // rbx=v, rax=limit
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);  // cmp rbx, rax
      self.cg_e8(0x0F);
      if (dir == 0) { self.cg_e8(0x8F); }  // jg exit (v > limit)
      else          { self.cg_e8(0x8C); }  // jl exit (v < limit, downto)
      self.cg_e32(jzHead);
      jzHead := self.codeLen - 4;
      // Body
      self.curBreakHead := -1;
      self.curContHead  := -1;
      var savedMarkF: int64 := self.loopDeferMark;   // #1006
      self.loopDeferMark := self.deferCount;
      self.cg_genBlock(self.cg_nc2(ni));
      self.loopDeferMark := savedMarkF;
      // contPos: continue lands here, before step
      self.cg_patchList(self.curContHead, self.codeLen);
      allBreakHead := self.cg_mergeBreakList(allBreakHead, self.curBreakHead);
      // Step: v++ or v--
      self.cg_loadRax(off);
      if (dir == 0) { self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC0); }  // inc rax
      else          { self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC8); }  // dec rax
      self.cg_storeRax(off);
      copy += 1;
    }
    // jmp loopTop
    self.cg_e8(0xE9);
    self.cg_e32(loopTop - self.codeLen - 4);
    // .exit
    var exitPos: int64 := self.codeLen;
    self.cg_patchList(jzHead, exitPos);
    self.cg_patchList(allBreakHead, exitPos);
    self.curBreakHead := savedBreakHead;
    self.curContHead  := savedContHead;
  }

  // for i in range([start,] stop) { }
  //
  // Wie cg_genFor, aber mit AUSSCHLIESSENDER Obergrenze: `to` laeuft bis
  // einschliesslich limit, `range` bis stop-1. Der Abbruch prueft daher
  // v >= stop (jge) statt v > limit (jg).
  //
  // Der Knoten wurde von Parser und sema erzeugt bzw. geprueft, hier aber nie
  // behandelt -- er fiel in den Catch-all am Ende von cg_genStmt und
  // verschwand spurlos. `for i in range(5) { s := s + i; }` liess s deshalb
  // unveraendert (Issue #1007).
  fn cg_genForRange(ni: int64) {
    var name: pchar := self.cg_nsval(ni);
    var nlen: int64 := self.cg_nslen(ni);
    var off:  int64 := self.cg_addLocal(name, nlen);
    // Init: v = start
    self.cg_genExpr(self.cg_nc0(ni));
    self.cg_storeRax(off);

    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead:  int64 := self.curContHead;
    var allBreakHead:   int64 := -1;
    var jzHead:         int64 := -1;
    var loopTop:        int64 := self.codeLen;

    // Bedingung: v < stop, sonst raus
    self.cg_loadRax(off);
    self.cg_pushRax();
    self.cg_genExpr(self.cg_nc1(ni));
    self.cg_popRbx();  // rbx = v, rax = stop
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);  // cmp rbx, rax
    self.cg_e8(0x0F); self.cg_e8(0x8D);                    // jge exit
    self.cg_e32(jzHead);
    jzHead := self.codeLen - 4;

    // Rumpf
    self.curBreakHead := -1;
    self.curContHead  := -1;
    var savedMarkG: int64 := self.loopDeferMark;   // #1006
    self.loopDeferMark := self.deferCount;
    self.cg_genBlock(self.cg_nc2(ni));
    self.loopDeferMark := savedMarkG;
    self.cg_patchList(self.curContHead, self.codeLen);
    allBreakHead := self.cg_mergeBreakList(allBreakHead, self.curBreakHead);

    // Schritt: v++
    self.cg_loadRax(off);
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC0);  // inc rax
    self.cg_storeRax(off);

    self.cg_e8(0xE9);
    self.cg_e32(loopTop - self.codeLen - 4);

    var exitPos: int64 := self.codeLen;
    self.cg_patchList(jzHead, exitPos);
    self.cg_patchList(allBreakHead, exitPos);
    self.curBreakHead := savedBreakHead;
    self.curContHead  := savedContHead;
  }

  // ------------------------------------------------------------------
  // C-style for loop code generation
  // NK_FOR_C: c0=NK_VAR_DECL(init), c1=cond, c2=step, c3=body
  // ------------------------------------------------------------------
  // WP-EN-05: copy-unrolling for C-style for (init; cond; step) { body }.
  // Each copy: cond → jz exit, body, step (continue lands before step).
  fn cg_genForC(ni: int64) {
    // Init: declare and initialize the loop variable
    var initNi: int64 := self.cg_nc0(ni);
    if (initNi >= 0) {
      var name: pchar := self.cg_nsval(initNi);
      var nlen: int64 := self.cg_nslen(initNi);
      var off:  int64 := self.cg_addLocal(name, nlen);
      var initExpr: int64 := self.cg_nc1(initNi);
      if (initExpr >= 0) {
        self.cg_genExpr(initExpr);
        self.cg_storeRax(off);
      }
    }

    var U:              int64 := self.cg_unrollFactor();
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead:  int64 := self.curContHead;
    var allBreakHead:   int64 := -1;
    var jzHead:         int64 := -1;
    var condNi:         int64 := self.cg_nc1(ni);
    var stepNi:         int64 := self.cg_nc2(ni);
    var bodyNi:         int64 := self.cg_nc3(ni);
    var loopTop:        int64 := self.codeLen;

    var copy: int64 := 0;
    while (copy < U) {
      // Condition (optional — absent means infinite loop)
      if (condNi >= 0) {
        self.cg_genExpr(condNi);
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x0F); self.cg_e8(0x84);                     // jz rel32
        self.cg_e32(jzHead);
        jzHead := self.codeLen - 4;
      }
      // Body
      self.curBreakHead := -1;
      self.curContHead  := -1;
      var savedMarkC: int64 := self.loopDeferMark;   // #1006
      self.loopDeferMark := self.deferCount;
      if (bodyNi >= 0) { self.cg_genBlock(bodyNi); }
      self.loopDeferMark := savedMarkC;
      // contPos: continue lands here, before step
      self.cg_patchList(self.curContHead, self.codeLen);
      allBreakHead := self.cg_mergeBreakList(allBreakHead, self.curBreakHead);
      // Step
      if (stepNi >= 0) { self.cg_genStmt(stepNi); }
      copy += 1;
    }
    // jmp loopTop
    self.cg_e8(0xE9);
    self.cg_e32(loopTop - self.codeLen - 4);
    // .exit
    var exitPos: int64 := self.codeLen;
    self.cg_patchList(jzHead, exitPos);
    self.cg_patchList(allBreakHead, exitPos);
    self.curBreakHead := savedBreakHead;
    self.curContHead  := savedContHead;
  }

  // ------------------------------------------------------------------
  // Switch/case code generation (WP-10c)
  // ------------------------------------------------------------------
  // AST: NK_SWITCH { nc0=subject, nc1=first_case }
  //      NK_CASE  { ival=0/1, nc0=value(if !default), nc1=body_block }
  // Strategy: linear if-else chain; default case runs last.
  // Implicit jmp after each case body uses the curBreakHead linked list,
  // so explicit break statements and implicit end-of-case jumps are both
  // patched to the switch_end at once.
  // ------------------------------------------------------------------

  fn cg_genSwitch(ni: int64) {
    // Allocate a temp local to hold the subject value
    var swVar: pchar := "__sw__";
    var swOff: int64 := self.cg_addLocal(swVar, 6);
    self.cg_genExpr(self.cg_nc0(ni));
    self.cg_storeRax(swOff);

    // Save and reset break list (shared between explicit break and implicit case exit)
    var savedBreakHead: int64 := self.curBreakHead;
    self.curBreakHead := -1;

    var defaultCaseNode: int64 := -1;
    var caseCur: int64 := self.cg_nc1(ni);
    while (caseCur != -1) {
      var isDefault: int64 := self.cg_nival(caseCur);
      if (isDefault != 0) {
        defaultCaseNode := caseCur;
      } else {
        // subject → rbx, case value → rax
        self.cg_loadRax(swOff);
        self.cg_pushRax();
        self.cg_genExpr(self.cg_nc0(caseCur));
        self.cg_popRbx();
        // cmp rbx, rax; jne skip_case (rel32)
        self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
        self.cg_e8(0x0F); self.cg_e8(0x85);
        var jnePos: int64 := self.codeLen;
        self.cg_e32(0);
        // Execute case body
        self.cg_genBlock(self.cg_nc1(caseCur));
        // Implicit jmp to switch_end (linked into break list)
        self.cg_e8(0xE9);
        var bp: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bp;
        // Patch jne to next case
        poke32(self.code + jnePos, self.codeLen - jnePos - 4);
      }
      caseCur := self.cg_nnext(caseCur);
    }

    // Default case executes last if no other case matched
    if (defaultCaseNode != -1) {
      self.cg_genBlock(self.cg_nc1(defaultCaseNode));
      // Implicit jmp to switch_end
      self.cg_e8(0xE9);
      var bpd: int64 := self.codeLen;
      self.cg_e32(self.curBreakHead);
      self.curBreakHead := bpd;
    }

    // switch_end: patch all break/implicit-break jmps here
    var bh: int64 := self.curBreakHead;
    while (bh != -1) {
      var b0: int64 := peek8(self.code + bh);
      var b1: int64 := peek8(self.code + bh + 1);
      var b2: int64 := peek8(self.code + bh + 2);
      var b3: int64 := peek8(self.code + bh + 3);
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + bh, self.codeLen - bh - 4);
      bh := nextLink;
    }
    self.curBreakHead := savedBreakHead;
  }

  // WP-15: Generate match statement (like switch but for pattern matching)
  // WP-BC-11: emit comparison for one or-pattern alternative; link je-body into self.orBodyHead
  fn cg_emitOrAlt(matchOff: int64, altPat: int64) {
    if (self.cg_nkind(altPat) == CGN_PATTERN_OR) {
      self.cg_emitOrAlt(matchOff, self.cg_nc0(altPat));
      self.cg_emitOrAlt(matchOff, self.cg_nc1(altPat));
    } else {
      self.cg_loadRax(matchOff);
      self.cg_pushRax();
      // #1024: Hier stand noch die alte Unterscheidung `ival != 0`, die #1020
      // im Hauptmuster laengst ersetzt hat — und der Bezeichner wurde nur in
      // den Locals gesucht, nicht in der Konstantentabelle. Enum-Mitglieder
      // trafen damit NIE; `case R | B` traf ausgerechnet R, weil der
      // Fehlschlagpfad 0 lud und R zufaellig 0 ist. Jetzt dieselbe Aufloesung
      // wie im Hauptmuster: unterschieden wird an der NAMENSLAENGE.
      var pl: int64 := self.cg_nslen(altPat);
      if (pl == 0) {
        self.cg_movRaxImm(self.cg_nival(altPat));
      } else {
        var pn: pchar := self.cg_nsval(altPat);
        var po: int64 := self.cg_findLocal(pn, pl);
        if (po != 0) {
          self.cg_loadRax(po);
        } else if (self.cg_hasConVal(pn, pl) != 0) {
          self.cg_movRaxImm(self.cg_findConVal(pn, pl));
        } else {
          EPrintStr("error: codegen: match-Muster ist weder Konstante noch "c);
          EPrintStr("lokale Variable: "c);
          var pc: int64 := 0;
          while (pc < pl) { PrintChar(StrCharAt(pn, pc)); pc := pc + 1; }
          EPrintStrLn(""c);
          exit(70);
        }
      }
      self.cg_popRbx();
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);   // cmp rbx, rax
      self.cg_e8(0x0F); self.cg_e8(0x84);                       // je rel32
      var jePos: int64 := self.codeLen;
      self.cg_e32(self.orBodyHead);
      self.orBodyHead := jePos;
    }
  }

  // #1024: Rumpf eines match-Falls emittieren. Ein Ausdruck laesst seinen Wert
  // in rax; ein BLOCK wird als Anweisungsfolge erzeugt und liefert den Wert
  // seiner letzten Anweisung, sofern das ein Ausdruck ist — sonst 0. Damit
  // bleibt `match` in beiden Rollen brauchbar: als Anweisung mit mehreren
  // Schritten je Zweig, und als Ausdruck mit einem Wert.
  fn cg_genMatchBody(bodyNode: int64) {
    if (bodyNode < 0) { self.cg_zeroRax(); return; }
    if (self.cg_nkind(bodyNode) != CGN_BLOCK) {
      self.cg_genExpr(bodyNode);
      return;
    }
    var savedLocals: int64 := self.localCount;
    var savedDefers: int64 := self.deferCount;
    var stmt: int64 := self.cg_nc0(bodyNode);
    if (stmt < 0) { self.cg_zeroRax(); return; }
    while (stmt != -1) {
      var nxt: int64 := self.cg_nnext(stmt);
      if (nxt == -1 && self.cg_nkind(stmt) == CGN_EXPR_STMT) {
        // letzte Anweisung ist ein Ausdruck → sein Wert ist der Wert des Blocks
        self.cg_genExpr(self.cg_nc0(stmt));
      } else {
        self.cg_genStmt(stmt);
        if (nxt == -1) { self.cg_zeroRax(); }
      }
      stmt := nxt;
    }
    self.cg_emitDefersDownTo(savedDefers);
    self.deferCount := savedDefers;
    self.localCount := savedLocals;
  }

  fn cg_genMatch(ni: int64) {
    // c0 = discriminant expression, c1 = cases (next-linked)
    // Allocate a temp local to hold the subject value
    var matchVar: pchar := "__match__";
    var matchOff: int64 := self.cg_addLocal(matchVar, 8);
    self.cg_genExpr(self.cg_nc0(ni));
    self.cg_storeRax(matchOff);

    // Save and reset break list
    var savedBreakHead: int64 := self.curBreakHead;
    self.curBreakHead := -1;

    var defaultCaseNode: int64 := -1;
    var caseCur: int64 := self.cg_nc1(ni);  // first match case
    while (caseCur != -1) {
      // c0 = pattern, c1 = body expression, c2 = guard (or -1)
      var patNode: int64 := self.cg_nc0(caseCur);
      var bodyNode: int64 := self.cg_nc1(caseCur);
      var guardNode: int64 := self.cg_nc2(caseCur);
      var patKind: int64 := self.cg_nkind(patNode);

      // WP-BC-11: or-pattern — try each alternative; if any matches, jmp to body
      if (patKind == CGN_PATTERN_OR) {
        var savedOrBodyHead: int64 := self.orBodyHead;
        self.orBodyHead := -1;
        self.cg_emitOrAlt(matchOff, patNode);   // emit je-body for each alt
        // No alternative matched → jmp next_case
        self.cg_e8(0xE9);
        var jmpNextCase: int64 := self.codeLen;
        self.cg_e32(0);
        // Patch all je-body jumps → current position (body entry)
        var oh: int64 := self.orBodyHead;
        while (oh != -1) {
          var lnk: int64 := peek8(self.code + oh) + peek8(self.code + oh + 1) * 256 + peek8(self.code + oh + 2) * 65536 + peek8(self.code + oh + 3) * 16777216;
          if (lnk >= 2147483648) { lnk := lnk - 4294967296; }
          poke32(self.code + oh, self.codeLen - oh - 4);
          oh := lnk;
        }
        self.orBodyHead := savedOrBodyHead;
        // Guard check (if present)
        var guardFailPos: int64 := -1;
        if (guardNode >= 0) {
          self.cg_genExpr(guardNode);
          self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
          self.cg_e8(0x0F); self.cg_e8(0x84);                      // jz guard_fail
          guardFailPos := self.codeLen;
          self.cg_e32(0);
        }
        self.cg_genMatchBody(bodyNode);
        self.cg_e8(0xE9);
        var bpOR: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bpOR;
        // Patch next_case and guard_fail → here
        poke32(self.code + jmpNextCase, self.codeLen - jmpNextCase - 4);
        if (guardFailPos >= 0) { poke32(self.code + guardFailPos, self.codeLen - guardFailPos - 4); }

      // `case _ =>` trifft immer.
      //
      // OHNE Guard ist das der Default-Fall: er wird ans Ende gestellt, damit
      // die konkreten Faelle zuerst geprueft werden. (Frueher fiel der
      // Wildcard in den Vergleichszweig unten, wo sein ival 0 gegen den Wert
      // verglichen wurde -- `case _` traf damit ausgerechnet nur bei 0,
      // Issue #1008.)
      //
      // MIT Guard darf er das NICHT. #1080: Ein bedingter Arm ist kein
      // Default; er gehoert an SEINE Stelle in der Reihenfolge, sonst
      // verliert er gegen spaetere Faelle. Zudem gibt es nur EINEN
      // defaultCaseNode -- ein zweiter Wildcard ueberschrieb den ersten
      // stillschweigend, und genau das liess `case _ if <cond>` nie treffen,
      // sobald ein `case _` folgte. Beides ohne Fehlermeldung.
      } else if (patKind == CGN_PATTERN_WILD) {
        if (guardNode >= 0) {
          // Bedingter Wildcard: an Ort und Stelle auswerten wie ein normaler
          // Fall, dessen Muster immer passt.
          self.cg_genExpr(guardNode);
          self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
          self.cg_e8(0x0F); self.cg_e8(0x84);                       // jz next_case
          var wildGuardFail: int64 := self.codeLen;
          self.cg_e32(0);
          self.cg_genMatchBody(bodyNode);
          self.cg_e8(0xE9);
          var bpWG: int64 := self.codeLen;
          self.cg_e32(self.curBreakHead);
          self.curBreakHead := bpWG;
          poke32(self.code + wildGuardFail, self.codeLen - wildGuardFail - 4);
        } else {
          // Der ERSTE unbedingte Wildcard gewinnt; alles danach ist
          // unerreichbar und darf ihn nicht verdraengen.
          if (defaultCaseNode == -1) { defaultCaseNode := caseCur; }
        }
      } else if (patKind == CGN_PATTERN_STRUCT) {
        // WP-15: Struct destructure pattern: Point { x: patX, y: patY }
        // sval = struct type name, c0 = first field pattern (NK_PATTERN_BIND)
        var structName: pchar := self.cg_nsval(patNode);
        var structLen: int64 := self.cg_nslen(patNode);
        
        // Load the struct value
        self.cg_loadRax(matchOff);
        self.cg_pushRax();  // save struct value
        
        // Find the struct/class layout
        var structOff: int64 := self.cg_findClass(structName, structLen);
        if (structOff != -1) {
          // Iterate over field patterns
          var fieldPat: int64 := self.cg_nc0(patNode);
          var matchFailed: int64 := 0;
          while (fieldPat != -1) {
            // fieldPat is NK_PATTERN_BIND with sval = field name
            var fieldName: pchar := self.cg_nsval(fieldPat);
            var fieldLen: int64 := self.cg_nslen(fieldPat);
            var innerPat: int64 := self.cg_nc0(fieldPat);  // inner pattern
            
            // Find field offset in struct
            var fldOff: int64 := self.cg_findField(structOff, fieldName, fieldLen);
            if (fldOff != -1) {
              // Load field value from struct
              self.cg_popRax();
              self.cg_pushRax();
              // mov rax, [rax + fieldOffset]
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40);
              self.cg_e8(fldOff as int64);
              
              // Generate code for inner pattern (recursive match on field value)
              var innerPatKind: int64 := self.cg_nkind(innerPat);
              if (innerPatKind == CGN_PATTERN_BIND) {
                // Binding pattern: bind field value to new variable
                var bindName: pchar := self.cg_nsval(innerPat);
                var bindLen: int64 := self.cg_nslen(innerPat);
                var bindOff: int64 := self.cg_addLocal(bindName, bindLen);
                self.cg_storeRax(bindOff);
              } else if (innerPatKind == CGN_PATTERN_LIT) {
                // Literal pattern: compare
                var patVal: int64 := self.cg_nival(innerPat);
                self.cg_pushRax();
                if (patVal != 0) {
                  self.cg_movRaxImm(patVal);
                } else {
                  var patName: pchar := self.cg_nsval(innerPat);
                  var patNameLen: int64 := self.cg_nslen(innerPat);
                  var patNameOff: int64 := self.cg_findLocal(patName, patNameLen);
                  if (patNameOff != 0) {
                    self.cg_loadRax(patNameOff);
                  } else {
                    self.cg_zeroRax();
                  }
                }
                self.cg_popRbx();
                // cmp rbx, rax; jne fail
                self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
                self.cg_e8(0x0F); self.cg_e8(0x85);
                var jnePos2: int64 := self.codeLen;
                self.cg_e32(0);
                // Field matched - continue
                poke32(self.code + jnePos2, self.codeLen - jnePos2 - 4);
              }
              // Wildcard pattern: do nothing (field value ignored)
            }
            fieldPat := self.cg_nnext(fieldPat);
          }
          // All fields matched - execute case body
          self.cg_popRax();
          self.cg_genMatchBody(bodyNode);
          // Implicit jmp to match_end
          self.cg_e8(0xE9);
          var bp2: int64 := self.codeLen;
          self.cg_e32(self.curBreakHead);
          self.curBreakHead := bp2;
        } else {
          // Unknown struct type - treat as wildcard
          self.cg_popRax();
          defaultCaseNode := caseCur;
        }
      } else if (patKind == CGN_PATTERN_ENUM) {
        // BUG-08: Enum payload pattern: Ok(value) or Err(msg)
        // sval = enum variant name, c0 = binding pattern for payload
        var varName: pchar := self.cg_nsval(patNode);
        var varLen: int64 := self.cg_nslen(patNode);

        // Find the variant tag across all enums
        var foundTag: int64 := -1;
        var payloadSize: int64 := 0;
        var ei: int64 := 0;
        while (ei < self.enumCount) {
          var tagInfo: int64 := self.cg_findEnumVariant(ei, varName, varLen);
          if (tagInfo >= 0) {
            foundTag := tagInfo & 0xFFFFFFFF;
            payloadSize := tagInfo >> 32;
            break;
          }
          ei += 1;
        }

        if (foundTag >= 0) {
          // Load subject value (tag is in lower 32 bits)
          self.cg_loadRax(matchOff);
          self.cg_pushRax();  // save subject for payload extraction

          // Compare subject tag with variant tag
          // mov rax, subject_tag (already in rax)
          // cmp rax, foundTag
          self.cg_e8(0x48); self.cg_e8(0x3D);
          self.cg_e32(foundTag);
          // jne skip_case
          self.cg_e8(0x0F); self.cg_e8(0x85);
          var jnePos: int64 := self.codeLen;
          self.cg_e32(0);

          // Tags match — extract payload bindings if present
          var bindPat: int64 := self.cg_nc0(patNode);
          var bindIdx: int64 := 0;
          while (bindPat != -1) {
            var bindName: pchar := self.cg_nsval(bindPat);
            var bindLen: int64 := self.cg_nslen(bindPat);
            // Payload is at subject + 8 (after tag) + bindIdx * 8
            self.cg_popRax();
            self.cg_pushRax();
            // mov rax, [rax + 8 + bindIdx*8]
            var payOff: int64 := 8 + bindIdx * 8;
            if (payOff <= 127) {
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40);
              self.cg_e8(payOff);
            } else {
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80);
              self.cg_e32(payOff);
            }
            // Store payload value in local variable
            var bindLocalOff: int64 := self.cg_addLocal(bindName, bindLen);
            self.cg_storeRax(bindLocalOff);
            self.cg_pushRax();  // restore subject for next binding
            bindIdx += 1;
            bindPat := self.cg_nnext(bindPat);
          }
          self.cg_popRax();  // discard saved subject

          // Execute case body
          self.cg_genMatchBody(bodyNode);
          // Implicit jmp to match_end
          self.cg_e8(0xE9);
          var bp: int64 := self.codeLen;
          self.cg_e32(self.curBreakHead);
          self.curBreakHead := bp;

          // Patch jne to next case
          poke32(self.code + jnePos, self.codeLen - jnePos - 4);
        } else {
          // Unknown variant — treat as wildcard/default
          defaultCaseNode := caseCur;
        }
      } else {
        // Load subject value, compare with pattern
        self.cg_loadRax(matchOff);
        self.cg_pushRax();
        // Ganzzahl-Literal und Bezeichner teilen sich NK_PATTERN_LIT; der
        // Parser setzt beim Literal nur ival, beim Bezeichner nur sVal.
        // Unterschieden wird deshalb an der NAMENSLAENGE -- die fruehere
        // Pruefung `ival != 0` hielt `case 0 =>` faelschlich fuer einen
        // Bezeichner.
        var patLen: int64 := self.cg_nslen(patNode);
        if (patLen == 0) {
          self.cg_movRaxImm(self.cg_nival(patNode));
        } else {
          var patName: pchar := self.cg_nsval(patNode);
          var patOff: int64 := self.cg_findLocal(patName, patLen);
          if (patOff != 0) {
            self.cg_loadRax(patOff);
          } else if (self.cg_hasConVal(patName, patLen) != 0) {
            // Konstante oder Enum-Mitglied
            self.cg_movRaxImm(self.cg_findConVal(patName, patLen));
          } else {
            // Weder lokale Variable noch Konstante: frueher wurde hier still 0
            // geladen, das Muster verglich also gegen 0 und traf praktisch nie.
            // Bindende Muster (`case x =>`, die jeden Wert annehmen und binden)
            // sind nicht umgesetzt -- ein blanker Bezeichner muss deshalb eine
            // Konstante, ein Enum-Mitglied oder eine lokale Variable benennen.
            EPrintStr("error: codegen: match-Muster ist weder Konstante noch "c);
            EPrintStr("lokale Variable: "c);
            var pc: int64 := 0;
            while (pc < patLen) { PrintChar(StrCharAt(patName, pc)); pc := pc + 1; }
            EPrintStrLn(""c);
            exit(70);
          }
        }
        self.cg_popRbx();
        // cmp rbx, rax; jne skip_case
        self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
        self.cg_e8(0x0F); self.cg_e8(0x85);
        var jnePos: int64 := self.codeLen;
        self.cg_e32(0);
        // WP-BC-11: guard check (c2 of case node)
        var guardFail2: int64 := -1;
        if (guardNode >= 0) {
          self.cg_genExpr(guardNode);
          self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
          self.cg_e8(0x0F); self.cg_e8(0x84);                      // jz guard_fail
          guardFail2 := self.codeLen;
          self.cg_e32(0);
        }
        // Execute case body
        self.cg_genMatchBody(bodyNode);
        // Implicit jmp to match_end
        self.cg_e8(0xE9);
        var bp: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bp;
        // Patch jne (and guard fail) to next case
        poke32(self.code + jnePos, self.codeLen - jnePos - 4);
        if (guardFail2 >= 0) { poke32(self.code + guardFail2, self.codeLen - guardFail2 - 4); }
      }
      caseCur := self.cg_nnext(caseCur);
    }

    // Default/wildcard case executes last if no other case matched
    if (defaultCaseNode != -1) {
      var bodyNode: int64 := self.cg_nc1(defaultCaseNode);
      var defGuard: int64 := self.cg_nc2(defaultCaseNode);
      if (defGuard >= 0) {
        self.cg_genExpr(defGuard);
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x74);                                         // jz short (skip default)
        var defSkip: int64 := self.codeLen;
        self.cg_e8(0);
        self.cg_genMatchBody(bodyNode);
        self.cg_e8(0xE9);
        var bpDefG: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bpDefG;
        poke8(self.code + defSkip, self.codeLen - defSkip - 1);
      } else {
        self.cg_genMatchBody(bodyNode);
        self.cg_e8(0xE9);
        var bpd: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bpd;
      }
    }

    // Durchfall: kein Fall hat getroffen und es gab keinen Default. Ohne dies
    // stuende in rax der Rest des letzten Vergleichs -- als Ausdruck ist das
    // ein undefinierter Wert. Die getroffenen Faelle springen hinter diese
    // Anweisung (die Sprungziele werden unten auf die dann aktuelle Position
    // gesetzt), sie laeuft also nur im Durchfall.
    self.cg_zeroRax();

    // match_end: patch all break/implicit jmps
    var bh: int64 := self.curBreakHead;
    while (bh != -1) {
      var b0: int64 := peek8(self.code + bh);
      var b1: int64 := peek8(self.code + bh + 1);
      var b2: int64 := peek8(self.code + bh + 2);
      var b3: int64 := peek8(self.code + bh + 3);
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + bh, self.codeLen - bh - 4);
      bh := nextLink;
    }
    self.curBreakHead := savedBreakHead;
  }

  // ------------------------------------------------------------------
  // Function declaration
  // ------------------------------------------------------------------

  // WP-EN-05: read the stored 4-byte linked-list link at `pos` in code buffer,
  // sign-extended to int64 (-1 = end-of-list sentinel).
  fn cg_readLink(pos: int64): int64 {
    var b0: int64 := peek8(self.code + pos) as int64;
    var b1: int64 := peek8(self.code + pos + 1) as int64;
    var b2: int64 := peek8(self.code + pos + 2) as int64;
    var b3: int64 := peek8(self.code + pos + 3) as int64;
    var v: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
    if (v >= 2147483648) { v := v - 4294967296; }
    return v;
  }

  // WP-EN-05: walk a linked list of rel32 placeholders and patch each to
  // (target - pos - 4). `head` = first node offset, -1 = empty.
  fn cg_patchList(head: int64, target: int64) {
    var p: int64 := head;
    while (p != -1) {
      var nxt: int64 := self.cg_readLink(p);
      poke32(self.code + p, target - p - 4);
      p := nxt;
    }
  }

  // WP-EN-05: append `dst` to the tail of the `src` linked list and return
  // the new head.  The tail is the node whose stored link equals -1.
  // If `src` == -1 (empty), returns `dst` unchanged.
  fn cg_mergeBreakList(dst: int64, src: int64): int64 {
    if (src == -1) { return dst; }
    var p: int64 := src;
    while (true) {
      var nxt: int64 := self.cg_readLink(p);
      if (nxt == -1) {
        poke32(self.code + p, dst);
        return src;
      }
      p := nxt;
    }
    return src;
  }

  // WP-EN-04: unroll factor for current function's energy level
  // Level 1→1, 2→2, 3→4, 4→4, 5→8
  fn cg_unrollFactor(): int64 {
    if (self.fnEnergyLevel <= 1) { return 1; }
    if (self.fnEnergyLevel == 2) { return 2; }
    if (self.fnEnergyLevel == 5) { return 8; }
    return 4;  // levels 3 and 4
  }

  // Verschachtelte fn-Deklaration für spätere Emission vormerken.
  fn cg_addPendingNested(ni: int64) {
    if (self.nestedCount >= self.nestedCap) {
      var nc: int64 := self.nestedCap * 2;
      var nb: int64 := alloc(nc * 8);
      memcpy(nb, self.nestedBuf, self.nestedCount * 8);
      self.nestedBuf := nb;
      self.nestedCap := nc;
    }
    poke64(self.nestedBuf + self.nestedCount * 8, ni);
    self.nestedCount += 1;
  }

  fn cg_genFuncDecl(ni: int64) {
    // Register label for this function
    var fname: pchar := self.cg_nsval(ni);
    var fnlen: int64 := self.cg_nslen(ni);
    self.cg_addLabel(fname, fnlen, self.cg_lineOf(ni));

    // Save and set outer function context for nested function capture analysis
    var savedOuterName: pchar := self.outerFuncName;
    var savedOuterLen: int64 := self.outerFuncNameLen;
    self.outerFuncName := fname;
    self.outerFuncNameLen := fnlen;

    // WP-EN-04: resolve effective energy level for this function
    // Priority: @energy(N) pragma on fn > CLI/global > hard-coded default 3
    var savedEnergy: int64 := self.fnEnergyLevel;
    var annoEnergy: int64 := (self.cg_nival(ni) >> ANNO_ENERGY_SHIFT) & 7;
    if (annoEnergy >= 1 && annoEnergy <= 5) {
      self.fnEnergyLevel := annoEnergy;
    } else if (self.globalEnergyLevel >= 1) {
      self.fnEnergyLevel := self.globalEnergyLevel;
    } else {
      self.fnEnergyLevel := 1;  // default: no unrolling (bootstrap-safe)
    }

    // Reset locals
    self.localCount := 0;
    self.frameSize  := 0;

    // WP-04: detect tuple return type ([T, T, ...])
    var retTyNode: int64 := self.cg_nc1(ni);
    self.funcHasTupleReturn := 0;
    if (retTyNode >= 0 && self.cg_nkind(retTyNode) == CGN_TYPE_TUPLE) {
      self.funcHasTupleReturn := 1;
    }

    // WP-18: initialize _lyx_canary BEFORE prologue stores it on stack.
    // Runs before push rbp, so the prologue can load the already-initialized value.
    // rdi/rsi (argc/argv) are saved around the call because getrandom clobbers them.
    if fnlen == 4 {
      if StrCharAt(fname, 0) == 109 && StrCharAt(fname, 1) == 97 &&
         StrCharAt(fname, 2) == 105 && StrCharAt(fname, 3) == 110 {
        self.cg_e8(0x57);                                                    // push rdi (argc)
        self.cg_e8(0x56);                                                    // push rsi (argv)
        // call __lyx_canary_init  (fills _lyx_canary via sys_getrandom)
        self.cg_e8(0xE8);
        var pp18: int64 := self.codeLen;
        self.cg_e32(0);
        self.cg_addPatch(pp18, "__lyx_canary_init" as int64, 17, CG_PATCH_CALL);
        self.cg_e8(0x5E);                                                    // pop rsi  (argv)
        self.cg_e8(0x5F);                                                    // pop rdi  (argc)
      }
    }

    // Emit prologue, capture patch position for sub rsp imm32
    var prologuePatch: int64 := self.cg_emitPrologue();

    // Spill parameters (child0 = first param, linked via next)
    var param: int64 := self.cg_nc0(ni);
    var paramIdx: int64 := 0;
    while (param != -1 && paramIdx < 6) {
      var pname: pchar := self.cg_nsval(param);
      var pnlen: int64 := self.cg_nslen(param);
      var off: int64 := self.cg_addLocal(pname, pnlen);
      // Track param type if it's a user type (NK_TYPE_NAME = 60)
      var ptypeNode: int64 := self.cg_nc0(param);
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == 60) {
        self.cg_setLocalType(self.localCount - 1, self.cg_nsval(ptypeNode), self.cg_nslen(ptypeNode));
      }
      // #1003: inline geschriebener fn-Zeigertyp als Parameter
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == CGN_FN_PTR_NODE) {
        poke8(self.localIsFnPtr + self.localCount - 1, 1);
      }
      if (paramIdx == 0) { self.cg_spillRdi(off); }
      else if (paramIdx == 1) { self.cg_spillRsi(off); }
      else if (paramIdx == 2) { self.cg_spillRdx(off); }
      else if (paramIdx == 3) { self.cg_spillRcx(off); }
      else if (paramIdx == 4) { self.cg_spillR8(off); }
      else if (paramIdx == 5) { self.cg_spillR9(off); }
      paramIdx += 1;
      param := self.cg_nnext(param);
    }
    // L-4: stack params at [rbp+16], [rbp+24], ... (args 7+ passed on caller stack)
    var spOff: int64 := 16;
    while (param != -1) {
      var spName: pchar := self.cg_nsval(param);
      var spNlen: int64 := self.cg_nslen(param);
      var spLocal: int64 := self.cg_addLocal(spName, spNlen);
      var spType: int64 := self.cg_nc0(param);
      if (spType >= 0 && self.cg_nkind(spType) == 60) {
        self.cg_setLocalType(self.localCount - 1, self.cg_nsval(spType), self.cg_nslen(spType));
      }
      self.cg_loadRax(spOff);
      self.cg_storeRax(spLocal);
      spOff += 8;
      param := self.cg_nnext(param);
    }

    // WP-25.2: Compat-Warnung + WP-R9/R10/R11: Proxy/Landlock/seccomp am Anfang von 'main'
    if fnlen == 4 {
      if StrCharAt(fname, 0) == 109 && StrCharAt(fname, 1) == 97 &&
         StrCharAt(fname, 2) == 105 && StrCharAt(fname, 3) == 110 {
        self.cg_emitCompatWarn();   // WP-25.2: Laufzeit-Warnung wenn Compat-Modus (noop sonst)
        if self.lcbsEnabled != 0 {
          self.cg_emitProxyStart();   // WP-R11: Proxy fork+socketpair (vor Landlock+seccomp)
          self.cg_emitLandlockInit(); // WP-R10: Landlock (vor seccomp)
          self.cg_emitSeccompInit();  // WP-R9: seccomp zuletzt
        }
      }
    }
    // Generate function body (child2 = block)
    var body: int64 := self.cg_nc2(ni);
    // #1006: defers werden beim Durchlaufen des Rumpfes vorgemerkt und an der
    // jeweiligen Blockgrenze emittiert; ein Vorab-Sammellauf ueber die ganze
    // Funktion gibt es nicht mehr. cg_genBlock arbeitet die defers der
    // aeussersten Ebene am Rumpfende ab, daher hier kein cg_emitDefers.
    self.deferCount := 0;
    self.dfCount    := 0;       // #1030: Argument-Slots gelten je Funktion
    self.loopDeferMark := -1;   // #1006: ausserhalb jeder Schleife
    self.cg_genBlock(body);

    self.cg_zeroRax();
    self.cg_emitEpilogue();

    // Patch sub rsp with aligned frame size
    var fs: int64 := self.frameSize + 15;
    var aligned: int64 := fs - (fs & 15);
    if (aligned == 0) { aligned := 16; }
    poke32(self.code + prologuePatch, aligned);

    // WP-EN-04: restore energy level for enclosing scope
    self.fnEnergyLevel := savedEnergy;

    // Restore outer function context
    self.outerFuncName := savedOuterName;
    self.outerFuncNameLen := savedOuterLen;

    // Vorgemerkte verschachtelte Funktionen jetzt emittieren — NACH der äußeren,
    // damit deren Instruktionsstrom nicht in sie hineinläuft.
    //
    // Die Liste wird zuerst kopiert und geleert: cg_genFuncDecl ruft sich für den
    // Rumpf rekursiv wieder hier hinein und meldet dort ggf. eigene verschachtelte
    // Funktionen an (fn in fn). Ohne die Kopie würde man über einen Puffer
    // iterieren, der sich unter einem verändert.
    if (self.nestedCount > 0) {
      var cnt: int64 := self.nestedCount;
      var snap: int64 := alloc(cnt * 8);
      memcpy(snap, self.nestedBuf, cnt * 8);
      self.nestedCount := 0;
      var i: int64 := 0;
      while (i < cnt) {
        self.cg_genFuncDecl(peek64(snap + i * 8));
        i += 1;
      }
      free(snap, cnt * 8);
    }
  }

  // ------------------------------------------------------------------
  // Helper functions emitted at start of code buffer
  // Fixed byte sequences encoding _start, _lyx_strlen, _lyx_print_str,
  // and _lyx_print_int.
  // ------------------------------------------------------------------

  fn cg_emitHelpers() {
    // ---- _start (65 bytes) ----
    // At Linux ABI entry: [rsp]=argc, [rsp+8]=argv[0], ...
    // First: call prlimit64 to remove RLIMIT_STACK (allows deep recursion in parser)
    // sub rsp, 16       (48 83 EC 10)
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x10);
    // mov rax, -1       (48 C7 C0 FF FF FF FF)  RLIM_INFINITY
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0);
    self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);
    // mov [rsp], rax    (48 89 04 24)  rlim_cur
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);
    // mov [rsp+8], rax  (48 89 44 24 08)  rlim_max
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);
    // xor edi, edi      (31 FF)  pid = 0
    self.cg_e8(0x31); self.cg_e8(0xFF);
    // mov esi, 3        (BE 03 00 00 00)  RLIMIT_STACK
    self.cg_e8(0xBE); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov rdx, rsp      (48 89 E2)  new_limit = &rlimit_struct
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE2);
    // xor r10d, r10d    (45 31 D2)  old_limit = NULL
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);
    // mov eax, 302      (B8 2E 01 00 00)  SYS_prlimit64
    self.cg_e8(0xB8); self.cg_e8(0x2E); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall           (0F 05)
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // add rsp, 16       (48 83 C4 10)  restore stack
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);
    // 5F               pop rdi          -- rdi = argc
    self.cg_e8(0x5F);
    // 48 89 E6         mov rsi, rsp     -- rsi = &argv[0] (argv pointer)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE6);
    // WP-BI-01: save argc and argv to globals so GetArgC/GetArgV/GetArg can read them
    // 48 89 3D xx xx xx xx   mov [rip+CG_ARGC], rdi
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x3D);
    var ppArgC: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(ppArgC, CG_ARGC, 0, CG_PATCH_STR);
    // 48 89 35 xx xx xx xx   mov [rip+CG_ARGV], rsi
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x35);
    var ppArgV: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(ppArgV, CG_ARGV, 0, CG_PATCH_STR);
    // E8 xx xx xx xx   call main        (patched after all functions)
    self.cg_e8(0xE8);
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, "main" as int64, 4, CG_PATCH_CALL);
    // 48 89 C7         mov rdi, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);
    // 48 C7 C0 3C 00 00 00   mov rax, 60 (sys_exit)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0);
    self.cg_e8(0x3C); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // 0F 05            syscall
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // _start is now 79 bytes  ✓  (WP-BI-01: +14 for argc/argv save)

    // ---- _lyx_strlen (24 bytes, starts at offset 79) — WP-33: null-pointer guard ----
    // test rdi, rdi
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);
    // jz +15 (to offset 20: xor rax,rax + ret — return 0 for null pointer)
    self.cg_e8(0x74); self.cg_e8(0x0F);
    // xor rax, rax  (len = 0)
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    // cmp byte [rdi+rax], 0
    self.cg_e8(0x80); self.cg_e8(0x3C); self.cg_e8(0x07); self.cg_e8(0x00);
    // jz +5 (to ret at offset 19 — null terminator found, return len)
    self.cg_e8(0x74); self.cg_e8(0x05);
    // inc rax
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC0);
    // jmp -11 (back to cmp at offset 8)
    self.cg_e8(0xEB); self.cg_e8(0xF5);
    // ret (offset 19 — returns len in rax)
    self.cg_e8(0xC3);
    // null case (offset 20): xor rax, rax; ret
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    self.cg_e8(0xC3);
    // strlen is now 24 bytes  ✓

    // ---- _lyx_print_str (26 bytes, starts at offset 103) ----
    // push rdi
    self.cg_e8(0x57);
    // call _lyx_strlen  (push at 103, E8 at 104, PC after = 109; rel32 = 79-109 = -30)
    self.cg_e8(0xE8); self.cg_e32(-30);
    // mov rdx, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2);
    // pop rdi
    self.cg_e8(0x5F);
    // mov rsi, rdi
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xFE);
    // mov edi, 1  (stdout)
    self.cg_e8(0xBF); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov eax, 1  (sys_write)
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // ret
    self.cg_e8(0xC3);
    // print_str is now 26 bytes  ✓

    // ---- _lyx_print_int (104 bytes, starts at offset 129) ----
    // sub rsp, 24          48 83 EC 18
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x18);
    // lea rsi, [rsp+23]    48 8D 74 24 17
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x17);
    // mov rax, rdi         48 89 F8
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF8);
    // test rax, rax        48 85 C0
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    // jnz +8 (to .nonzero at offset+25)  75 08
