        // B2: method-typed Feld + RHS = method-Referenz (obj2.Method) → fat pointer {code,data}.
        if (classIdx >= 0 && self.cg_nkind(rhs) == CGN_FIELD
            && self.cg_fieldIsMethodType(classIdx, fieldName, fieldLen) != 0) {
          self.cg_genMethodRef(rhs);
        } else {
          self.cg_genExpr(rhs);
        }
        // #1097: Feld vom Bereichstyp — der Wert steht in rax, bevor er in das
        // Feld geht.
        self.cg_emitRangeCheck(self.cg_rangeOfField(classIdx, fieldName, fieldLen), "Feld"c);
        // #1963: Ein Feld mit EINHEITENTYP bekam den Wert roh. `st.s := 2500`
        // legte die Ganzzahl 2500 in einen Slot, der seit #1955 als double
        // gelesen wird — herausgelesen kam 1,2e-320, formatiert 0.00. Dieselbe
        // Angleichung wie bei Deklaration (#1502) und Zuweisung an ein Local;
        // die drei Stellen muessen uebereinstimmen. Danach die Umrechnung, wie
        // ueberall: die Einheit des Feldes ist das Ziel.
        var utFld: int64 := 0 - 1;
        if (classIdx >= 0) {
          var fbx: int64 := alloc(8);
          var ftn: pchar := self.cg_fieldTypeNameIn(classIdx, fieldName, fieldLen, fbx);
          var ftnL: int64 := peek64(fbx);
          free(fbx, 8);
          if (ftn != 0 as pchar && ftnL > 0) {
            utFld := self.cg_findUtype(ftn, ftnL);
            // #2160: Feld vom Typ f64/f32 (oder Alias) — dieselbe Angleichung
            // wie bei der Deklaration, ohne Einheitenumrechnung.
            if (utFld < 0 && self.cg_isFloatTypeName(ftn, ftnL) != 0
                && self.cg_istSicherGanz(rhs) != 0) {
              self.cg_emitRaxIntToF64();
            }
          }
        }
        if (utFld >= 0) {
          if (self.cg_isF64Expr(rhs) == 0) { self.cg_emitRaxIntToF64(); }
          self.cg_emitUtypeConvExpr(utFld, rhs);
          self.cg_emitUtypeRange(utFld);
        }
        self.cg_pushRax();
        self.cg_genExpr(obj);
        var foff: int64 := -1;
        if (classIdx >= 0) { foff := self.cg_getFieldOffset(classIdx, fieldName, fieldLen); }
        self.cg_popRsi();
        // WP-4.1-B: emit BSWAP on rsi before storing @big_endian fields
        var beInfo2: int64 := 0;
        if (classIdx >= 0 && foff >= 0) {
          beInfo2 := self.cg_getFieldBigEndian(classIdx, fieldName, fieldLen);
          if ((beInfo2 & 1) != 0) {
            var tWidth3: int64 := (beInfo2 >> 8) & 0xFF;
            self.cg_emitBswapRsi(tWidth3);
          }
        }
        // #1248: Breite des Feldes beachten — spiegelbildlich zum Lesepfad
        // (#1038). Ohne sie schrieb jede Feldzuweisung 8 Byte und loeschte in
        // einem packed struct die Nachbarfelder.
        var stW: int64 := 0;
        if (foff >= 0 && classIdx >= 0) {
          stW := (self.cg_getFieldBigEndian(classIdx, fieldName, fieldLen) >> 8) & 0xFF;
        }
        // #1351/#1513: Ist das Ziel ein INLINE liegendes Struct, wird sein
        // Inhalt kopiert. Ein `mov [rax+off], rsi` legte stattdessen die
        // Adresse der Quelle in die ersten acht Byte des Feldes — der Rest
        // blieb, wie er war, und jeder spaetere Zugriff las Muell.
        var stInline: int64 := 0;
        if (foff >= 0 && classIdx >= 0) {
          stInline := (self.cg_getFieldBigEndian(classIdx, fieldName, fieldLen) >> 4) & 1;
        }
        // #1595: Liegt das Feld NICHT inline, nimmt es nur die Adresse der
        // Quelle auf. Dann muss die Quelle den Rahmen ueberleben, in dem sie
        // entstanden ist — also eine Kopie aus dem Bump-Bereich.
        //
        // Die Frage laesst sich NICHT am Typ der Quelle beantworten: ob ein
        // Typ irgendwo als Feldtyp auftaucht, weiss der Codegen beim
        // Uebersetzen seiner Unit noch gar nicht, weil die Importe erst der
        // Hauptdurchlauf einliest. Ein erster Anlauf hat genau daran
        // gescheitert — `V` sah in seiner eigenen Unit unbenutzt aus, wanderte
        // in den Rahmen, und `K.c` hielt danach einen Zeiger in einen
        // gefallenen Rahmen. Hier dagegen ist die Frage lokal entscheidbar:
        // an DIESER Zuweisung steht fest, dass ein Zeiger gespeichert wird.
        if (stInline == 0 && classIdx >= 0 && foff >= 0) {
          var zfk: int64 := self.cg_feldTypKlasse(classIdx, fieldName, fieldLen);
          if (zfk >= 0 && self.cg_istWertStruct(zfk) != 0) {
            var zfb: int64 := self.cg_classStructSize(zfk);
            if (zfb > 0) {
              self.cg_e8(0x50);                                     // push rax (Zielobjekt)
              self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF0); // mov rax, rsi (Quelle)
              self.cg_emitStructKopie(zfb);                         // Kopie ausserhalb des Rahmens
              self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6); // mov rsi, rax (Kopie)
              self.cg_e8(0x58);                                     // pop rax (Zielobjekt)
            }
          }
        }
        if (stInline != 0) {
          var stBytes: int64 := self.cg_fieldBytes(classIdx, fieldName, fieldLen);
          var stWorte: int64 := (stBytes + 7) / 8;
          // rax = Zielobjekt, rsi = Quelle
          if (foff == 0) {
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);                 // mov rdi, rax
          } else if (foff <= 127) {
            self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x78); self.cg_e8(foff); // lea rdi,[rax+off]
          } else {
            self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0xB8); self.cg_e32(foff);
          }
          self.cg_movRaxImm(stWorte);
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);                   // mov rcx, rax
          self.cg_e8(0xF3); self.cg_e8(0x48); self.cg_e8(0xA5);                   // rep movsq
        } else if (foff >= 0 && (stW == 1 || stW == 2 || stW == 4)) {
          // #2160: ein f32-Feld bekommt ein echtes single — im Register liegt
          // ein double (#1127); bis 1.2.17A landeten dessen untere vier Byte
          // im Feld (0.25 -> 0). Gegenstueck in cg_genFieldLoad.
          if (stW == 4 && self.cg_feldIstF32(classIdx, fieldName, fieldLen) != 0) {
            self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x6E); self.cg_e8(0xC6); // movq xmm0, rsi
            self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x5A); self.cg_e8(0xC0);                   // cvtsd2ss xmm0, xmm0
            self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC6);                   // movd esi, xmm0
          }
          self.cg_emitNarrowStoreRsi(foff, stW);
        } else if (foff == 0) {
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x30);
        } else if (foff > 0 && foff <= 127) {
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x70); self.cg_e8(foff);
        } else if (foff > 127) {
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xB0); self.cg_e32(foff);
        } else {
          // #2134: dieselbe Pruefung wie beim Lesen (cg_genFieldLoad) — die
          // beiden muessen uebereinstimmen.
          self.cg_genFeldOffen(fieldName, fieldLen, lhs);
        }
      } else if (self.cg_nkind(lhs) == CGN_INDEX && self.cg_localIsMap(self.cg_nc0(lhs)) != 0) {
        // #1152: m[k] := v schreibt ueber _lyx_map_set. Bis 1.0.15A nahm der
        // Array-Zweig den Map-Zeiger als Basis und schrieb an map+16+k*8 —
        // das war der SIGSEGV ohne Meldung.
        self.cg_genExpr(rhs);                                    // rax = Wert
        self.cg_pushRax();
        self.cg_genExpr(self.cg_nc1(lhs));                       // rax = Schluessel
        self.cg_pushRax();
        self.cg_genExpr(self.cg_nc0(lhs));                       // rax = Map
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);   // mov rdi, rax
        self.cg_e8(0x5E);                                        // pop rsi (Schluessel)
        self.cg_e8(0x5A);                                        // pop rdx (Wert)
        if (self.cg_isStrKeyMap(self.cg_nc0(lhs)) != 0) {          // #1291
          self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1);
          self.cg_e32(0);                                          // mov rcx,0 (setzen)
          var ppMSs: int64 := self.cg_emitCall();
          poke32(self.code + ppMSs, CG_H_MAP_STR - ppMSs - 4);
        } else {
          var ppMSt: int64 := self.cg_emitCall();
          poke32(self.code + ppMSt, CG_H_MAP_SET - ppMSt - 4);
        }
        return;

      } else if (self.cg_nkind(lhs) == CGN_INDEX) {
        // arr[i] := rhs — three-way dispatch (same as CGN_INDEX read)
        self.cg_genExpr(rhs);              // rax = value
        self.cg_pushRax();
        self.cg_genExpr(self.cg_nc1(lhs)); // rax = index
        self.cg_pushRax();
        // #1052: inline `[N]T`-Feld — Adresse statt Inhalt. Vorher wurde der
        // FELDINHALT als Zieladresse genommen (bei genulltem Speicher also 0),
        // was jeden Schreibzugriff zum Segfault machte.
        var wrInlW: int64 := self.cg_emitInlineArrayAddr(self.cg_nc0(lhs));
        if (wrInlW == 0) { self.cg_genExpr(self.cg_nc0(lhs)); }  // rax = array ptr
        self.cg_popRbx();                  // rbx = index
        if (wrInlW > 0) {
          self.cg_e8(0x5E);                // pop rsi (Wert)
          // #1612/#1636: Bei einem Feld mit Struct-Elementen halten die Slots
          // Zeiger (seit #1636 auch wirklich gefuellte). `c.items[i] := s`
          // darf den Zeiger nicht ueberschreiben, sonst teilen Element und
          // Quelle dasselbe Objekt.
          var wLc: int64 := alloc(8);
          var wEp: pchar := self.cg_fieldElemTypeNameOf(self.cg_nc0(lhs), wLc);
          var wEl: int64 := peek64(wLc);
          free(wLc, 8);
          var wBytes: int64 := 0;
          if (wEp != 0 as pchar && wEl > 0) {
            var wCi: int64 := self.cg_findClass(wEp, wEl);
            // #1646: siehe oben — Klassenelemente bleiben Referenzen.
            if (wCi >= 0 && self.cg_istStructTyp(wCi) != 0) {
              wBytes := self.cg_classStructSize(wCi);
            }
          }
          if (wBytes > 8) {
            // rax = Feldadresse, rbx = Index, rsi = Quelle
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0xD8);  // mov rdi, [rax+rbx*8]
            self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);                    // test rdi, rdi
            self.cg_e8(0x74);
            var wJz: int64 := self.codeLen; self.cg_e8(0);
            var wKopie: int64 := self.codeLen;
            self.cg_e8(0x51);                                                        // push rcx
            self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1); self.cg_e32(wBytes);
            self.cg_e8(0xF3); self.cg_e8(0xA4);                                      // rep movsb
            self.cg_e8(0x59);                                                        // pop rcx
            self.cg_e8(0xEB);
            var wJmp: int64 := self.codeLen; self.cg_e8(0);
            var wZeiger: int64 := self.codeLen;
            cg_patchRel8Wert(self.code, wJz, wZeiger - wKopie);
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x34); self.cg_e8(0xD8);  // mov [rax+rbx*8], rsi
            cg_patchRel8Wert(self.code, wJmp, self.codeLen - wZeiger);
            return;
          }
          self.cg_emitScaledStore(wrInlW);
          return;
        }
        var lhsBase: int64 := self.cg_nc0(lhs);
        var lhsIsArray: int64 := 0;
        var lhsIsSimd:  int64 := 0;
        var lhsIsSimdFloat: int64 := 0;   // #2183
        var lhsSimdBytes: int64 := 4;     // #2199
        var lhsIsPchar: int64 := 0;     // #1266
        var lhsFixedSize: int64 := 0;   // #1156
        var lhsElemBytes: int64 := 0;   // #1612: >0 = Struct-Element, so viele Byte
        // #1230: `m[i][j] := v` — die Basis ist die Zeilenadresse aus dem
        // Lesepfad. Kein Kopf, Schrittweite 8, Schranke ist die Zeilenlaenge.
        var lhsRowInner: int64 := 0;
        var lhsRowOuter: int64 := 0;
        if (self.cg_nkind(lhsBase) == CGN_INDEX) {
          var lrBase: int64 := self.cg_nc0(lhsBase);
          if (self.cg_nkind(lrBase) == CGN_IDENT) {
            var lrLi: int64 := self.cg_findLocalIdx(self.cg_nsval(lrBase), self.cg_nslen(lrBase));
            if (lrLi >= 0) {
              lhsRowInner := peek64(self.localArrayRow + lrLi * 8);
            } else {
              var lrGi: int64 := self.cg_findGlobalIdx(self.cg_nsval(lrBase), self.cg_nslen(lrBase));
              if (lrGi >= 0) { lhsRowInner := peek64(self.globalArrayRow + lrGi * 8); }
            }
          }
        }
        if (lhsRowInner > 0) {
          self.cg_emitIndexBoundsCheck(lhsRowInner, 0);
          self.cg_e8(0x5E);                                      // pop rsi (Wert)
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x34); self.cg_e8(0xD8); // mov [rax+rbx*8], rsi
          return;
        }
        if (self.cg_nkind(lhsBase) == CGN_IDENT) {
          var llidx: int64 := self.cg_findLocalIdx(self.cg_nsval(lhsBase), self.cg_nslen(lhsBase));
          if (llidx >= 0 && peek8(self.localIsArray + llidx) == 2) {   // #1155
            lhsFixedSize := peek64(self.localArraySize + llidx * 8);
            lhsRowOuter := peek64(self.localArrayRow + llidx * 8);   // #1230
          }
          if (llidx >= 0 && peek8(self.localIsArray + llidx) != 0) { lhsIsArray := 1; }
          // #1612: Traegt das Array Struct-Elemente? Dann halten die Slots
          // Zeiger auf je ein eigenes Objekt (so legt der Deklarationspfad sie
          // seit #1109 an), und `arr[i] := s` darf den Zeiger NICHT
          // ueberschreiben — sonst teilen Element und Quelle dasselbe Objekt,
          // und eine spaetere Aenderung an der Quelle veraendert scheinbar das
          // Array. Kopiert wird in das vorhandene Element.
          if (llidx >= 0 && lhsIsArray == 1) {
            var wtb: int64 := self.localTypes + llidx * CG_LOCTYPE_SZ;
            var wtp: pchar := peek64(wtb) as pchar;
            var wtn: int64 := peek64(wtb + CG_LOCTYPE_OFF_LEN);
            if (wtp != 0 as pchar && wtn > 0) {
              var wci: int64 := self.cg_findClass(wtp, wtn);
              // #1646: NUR bei einem Struct kopieren. Eine Klasse ist eine
              // Referenz — dort muss der Zeiger in den Slot, sonst verliert
              // das Element seine Identitaet.
              if (wci >= 0 && self.cg_istStructTyp(wci) != 0) {
                lhsElemBytes := self.cg_classStructSize(wci);
              }
            }
          }
          // WP-GPU-01: SIMD array store check
          if (llidx >= 0 && peek8(self.localIsSimd + llidx) != 0) { lhsIsSimd := 1; }
          if (lhsIsSimd == 1) { lhsSimdBytes := self.cg_simdBytesOf(llidx); }   // #2199
          // #2183: wie im Lesepfad — Gleitkomma-Elemente brauchen cvtsd2ss.
          if (lhsIsSimd == 1 && peek8(self.localElemFloat + llidx) != 0) { lhsIsSimdFloat := 1; }
          // #1266: `p[i] := x` auf einem pchar schrieb 8 Byte an Offset i*8 —
          // `p[0]` belegte die Bytes 0-7, `p[1]` die Bytes 8-15. Der LESEpfad
          // ermittelt die Zeichenkette laengst ueber denselben Typnamen und
          // liest byteweise; nur hier fehlte die Frage. std.conv war dadurch
          // unbrauchbar, und die Schreibvorgaenge trafen fremden Speicher.
          if (llidx >= 0) {
            var wtb: int64 := self.localTypes + llidx * CG_LOCTYPE_SZ;
            var wtp: pchar := peek64(wtb) as pchar;
            var wtn: int64 := peek64(wtb + CG_LOCTYPE_OFF_LEN);
            if (wtn == 5 && self.cg_seq(wtp, wtn, "pchar", 5)) { lhsIsPchar := 1; }
          }
          if (llidx < 0) {
            var wgidx: int64 := self.cg_findGlobalIdx(self.cg_nsval(lhsBase), self.cg_nslen(lhsBase));
            if (wgidx >= 0 && peek8(self.globalIsPchar + wgidx) != 0) { lhsIsPchar := 1; }
            // #1256: globales `[N]T` — Kopf ueberspringen wie beim Local.
            if (wgidx >= 0 && peek8(self.globalIsArray + wgidx) == 2) {
              lhsIsArray := 1;
              lhsFixedSize := peek64(self.globalArraySize + wgidx * 8);
              lhsRowOuter := peek64(self.globalArrayRow + wgidx * 8);   // #1230
            }
            if (wgidx >= 0 && peek8(self.globalIsArray + wgidx) == 1) { lhsIsArray := 1; }   // #2078
          }
        } else if (self.cg_nkind(lhsBase) == CGN_FIELD) {
          var lhsInner: int64 := self.cg_nc0(lhsBase);
          var lhsFldNm: pchar := self.cg_nsval(lhsBase);
          var lhsFldNl: int64 := self.cg_nslen(lhsBase);
          var lhsParentCi: int64 := self.cg_objClassIdx(lhsInner);
          if (self.cg_isFieldArray(lhsParentCi, lhsFldNm, lhsFldNl) != 0) { lhsIsArray := 1; }
        }
        // #2131: dieselbe Erweiterung wie im Lesepfad (CGN_INDEX in
        // cg_genExpr) — pchar-Feld, `x as pchar`, pchar-Konstante. Die beiden
        // muessen uebereinstimmen, sonst liest `p[i]` ein Byte und schreibt 8.
        if (lhsIsPchar == 0 && lhsIsArray == 0 && lhsIsSimd == 0
            && self.cg_isPcharExpr(lhsBase) != 0) {
          lhsIsPchar := 1;
        }
        // #1230: `m[i] := v` weist eine ganze ZEILE zu. Dafuer gibt es keine
        // Bedeutung — eine Zeile ist kein Wert, sondern eine Adresse im
        // flachen Block. Der Array-Zweig wuerde an Kopf+i*8 schreiben und
        // damit mitten in die erste Zeile: melden statt still danebenzutreffen.
        if (lhsRowOuter > 0) {
          EPrintStrLn("codegen error: Zuweisung an eine ganze Zeile eines mehrdimensionalen Arrays"c);
          EPrintStrLn("  Beide Indizes angeben: m[i][j] := v"c);
          exit(1);
        }
        // #1156: Bereichspruefung vor dem Schreiben. Der Wert liegt noch auf
        // dem Stack; der Panic-Pfad kehrt nicht zurueck, die Unwucht ist also
        // folgenlos.
        if (lhsIsArray == 1) { self.cg_emitIndexBoundsCheck(lhsFixedSize, 1); }
        // #2247: Ganzzahl-Elemente — abgelegt wird NUR die Breite selbst,
        // Gegenstueck zum Lesepfad, der sie vorzeichenerweitert zurueckholt.
        // Bis 1.2.24D fiel jede Ganzzahlart in den f32-Zweig darunter und
        // schrieb 4 Byte an einen 4-Byte-Platz; bei int8/int16 traf das den
        // falschen Platz und zerstoerte die Nachbarelemente, bei int64 ging
        // die obere Haelfte verloren (#2199).
        if (lhsIsSimd == 1 && lhsIsSimdFloat == 0) {
          self.cg_e8(0x59);                                                      // pop rcx (Wert)
          if (lhsSimdBytes == 1) {
            // mov [rax+rbx], cl        (88 0C 18)
            self.cg_e8(0x88); self.cg_e8(0x0C); self.cg_e8(0x18);
          } else if (lhsSimdBytes == 2) {
            // mov [rax+rbx*2], cx      (66 89 0C 58)
            self.cg_e8(0x66); self.cg_e8(0x89); self.cg_e8(0x0C); self.cg_e8(0x58);
          } else if (lhsSimdBytes == 4) {
            // mov [rax+rbx*4], ecx     (89 0C 98)
            self.cg_e8(0x89); self.cg_e8(0x0C); self.cg_e8(0x98);
          } else {
            // mov [rax+rbx*8], rcx     (48 89 0C D8)
            self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x0C); self.cg_e8(0xD8);
          }
        } else if (lhsIsSimd == 1 && lhsSimdBytes == 8) {
          // #2199: `parallel Array<f64>[i] := wert` — 8 Byte, movsd, ohne
          // Umrechnung. Gegenstueck zum Lesepfad (movsd dort); die beiden
          // muessen uebereinstimmen, sonst liest man anders, als man
          // geschrieben hat — genau der Fehler, den #2183 fuer f32 behoben
          // hat.
          self.cg_e8(0x59);                                                      // pop rcx (Wert)
          if (self.cg_isF64Expr(rhs) != 0) {
            // movq xmm0, rcx  (66 48 0F 6E C1)
            self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x6E); self.cg_e8(0xC1);
          } else {
            // Ganzzahliger Ausdruck in ein f64-Element: `v[0] := 2` legt 2.0
            // ab. cvtsi2sd xmm0, rcx  (F2 48 0F 2A C1)
            self.cg_e8(0xF2); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x2A); self.cg_e8(0xC1);
          }
          // movsd [rax+rbx*8], xmm0  (F2 0F 11 04 D8)
          self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x11); self.cg_e8(0x04); self.cg_e8(0xD8);
        } else if (lhsIsSimd == 1) {
          // WP-GPU-01: parallel Array<f32>[i] = val — movss store, 4-byte stride
          // stack: [value(rsi)]  rax=base  rbx=index
          // pop rcx (Wert)
          self.cg_e8(0x59);
          if (lhsIsSimdFloat == 1) {
            // #2183: Hier stand `movd xmm0, ecx` — das legte die unteren 32 Bit
            // des f64-BITMUSTERS ab, nicht den Wert. Bei 2.0, 3.0, 7.0 sind
            // diese Bits 0, jede Zuweisung schrieb also still eine Null; bei
            // 1.1 kam 0x9999999A heraus. Gemessen in #2183.
            // Dieselbe Umrechnung wie im lyxos-Backend (emit_lyxos.lyx,
            // CVTSD2SS) und Gegenstueck zum Lesepfad (cvtss2sd in cg_genExpr,
            // CGN_INDEX) — die drei muessen uebereinstimmen.
            if (self.cg_isF64Expr(rhs) != 0) {
              // movq xmm0, rcx  (66 48 0F 6E C1)
              self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x6E); self.cg_e8(0xC1);
              // cvtsd2ss xmm0, xmm0  (F2 0F 5A C0)
              self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x5A); self.cg_e8(0xC0);
            } else {
              // Ganzzahliger Ausdruck in ein f32-Element: `v[0] := 2` legt
              // 2.0f ab. Ohne diesen Zweig landete die Ganzzahl als Bitmuster
              // im Element und kam als winzige Denormalzahl zurueck.
              // cvtsi2ss xmm0, rcx  (F3 48 0F 2A C1)
              self.cg_e8(0xF3); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x2A); self.cg_e8(0xC1);
            }
          } else {
            // Ganzzahl-Elemente: rohes 32-Bit-Muster wie bisher (siehe
            // Lesepfad — die Schrittweite 4 Byte ist eine eigene Luecke).
            // movd xmm0, ecx  (66 0F 6E C1)
            self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x6E); self.cg_e8(0xC1);
          }
          // movss [rax+rbx*4], xmm0  (F3 0F 11 04 98)
          self.cg_e8(0xF3); self.cg_e8(0x0F); self.cg_e8(0x11); self.cg_e8(0x04); self.cg_e8(0x98);
        } else if (lhsIsArray == 1 && lhsElemBytes > 8 && lhsFixedSize > 0) {
          // #1612: Struct-Element — den INHALT in das vorhandene Objekt
          // kopieren. Ist der Slot noch leer (kein Objekt angelegt), bleibt es
          // beim Zeiger; das ist besser, als nach Adresse 0 zu schreiben.
          self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x48); self.cg_e8(0x10);   // lea rcx, [rax+16]
          self.cg_e8(0x5E);                                                          // pop rsi (Quelle)
          self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3C); self.cg_e8(0xD9);   // mov rdi, [rcx+rbx*8]
          self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);                     // test rdi, rdi
          // jz .zeiger  (Sprungweite unten eingesetzt)
          self.cg_e8(0x74);
          var jzPos: int64 := self.codeLen; self.cg_e8(0);
          var kopieStart: int64 := self.codeLen;
          self.cg_e8(0x51);                                                          // push rcx
          self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1); self.cg_e32(lhsElemBytes);  // mov rcx, n
          self.cg_e8(0xF3); self.cg_e8(0xA4);                                        // rep movsb
          self.cg_e8(0x59);                                                          // pop rcx
          // jmp .fertig
          self.cg_e8(0xEB);
          var jmpPos: int64 := self.codeLen; self.cg_e8(0);
          var zeigerStart: int64 := self.codeLen;
          cg_patchRel8Wert(self.code, jzPos, zeigerStart - kopieStart);
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x34); self.cg_e8(0xD9);   // mov [rcx+rbx*8], rsi
          cg_patchRel8Wert(self.code, jmpPos, self.codeLen - zeigerStart);
        } else if (lhsIsArray == 1) {
          // array<T> local: skip 16-byte header
          // lea rcx, [rax+16]
          self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x48); self.cg_e8(0x10);
          // pop rsi (value)
          self.cg_e8(0x5E);
          // mov [rcx+rbx*8], rsi
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x34); self.cg_e8(0xD9);
        } else if (lhsIsPchar == 1) {
          // #1266: pchar zeigt auf BYTES. Schrittweite 1, ein Byte breit —
          // spiegelbildlich zum Lesepfad, der movzx aus [rax+rbx] holt.
          self.cg_e8(0x5E);                                     // pop rsi (Wert)
          self.cg_e8(0x40); self.cg_e8(0x88); self.cg_e8(0x34); self.cg_e8(0x18); // mov [rax+rbx], sil
        } else {
          // #2131: dieselbe Grenze wie im Lesepfad (CGN_INDEX in
          // cg_genExpr) — die beiden muessen uebereinstimmen. Ein Wert, der
          // sich schreiben, aber nicht zuruecklesen laesst, ist kein Zugriff.
          // Gemessen: kein Treffer im Bestand.
          EPrintStrLn("error: codegen: Zuweisung an ein Element eines Ausdrucks ohne Elementtyp (weder Array noch pchar) — Byte: poke8(p + i, v), Wort: poke64(p + i * 8, v) (#2131)"c);
          exit(1);
        }
      } else {
        // #2075: Jedes andere Ziel fiel hier still durch — die Zuweisung
        // verschwand. sema weist es seither ab; kommt doch eines an, ist das
        // ein Fehler im Uebersetzer, kein Programm, das etwas Sinnvolles tut.
        EPrintStrLn("error: codegen: Zuweisungsziel ist weder Name noch Feld noch Element (#2075)"c);
        exit(1);
      }

    } else if (k == CGN_RETURN) {
      var expr: int64 := self.cg_nc0(ni);
      // #1595: Struct-Rueckgabe — der Wert wird in den Platz des Aufrufers
      // kopiert, dessen Adresse im Prolog gerettet wurde. Zurueck kommt diese
      // Adresse; damit sieht die Aufrufstelle dasselbe wie vorher, nur ohne
      // Belegung, die nie zurueckgegeben wird.
      if (self.fnRetStructBytes > 0 && expr >= 0) {
        // #1878: Lockstep vergleicht EINEN Wert in rax. Eine Struct-Rueckgabe
        // kopiert ein Feld nach dem anderen an den Platz des Aufrufers; dort
        // gaebe es nichts zu vergleichen, und stillschweigend nichts zu tun
        // waere genau der Zustand, den dieses Attribut hatte.
        if (self.lockstepActive != 0) {
          EPrintStrLn("error: @integrity(mode: software_lockstep): Struct-Rueckgabe wird nicht abgedeckt"c);
          EPrintStrLn("  Der Vergleich sitzt auf dem Rueckgabewert in einem Register; eine Struktur hat keinen."c);
          exit(1);
        }
        self.cg_genExpr(expr);                                   // rax = Quelle
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);    // mov rsi, rax
        self.cg_loadRax(self.fnRetSlotOff);                      // rax = Ziel
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);    // mov rdi, rax
        self.cg_pushRax();
        var worte: int64 := (self.fnRetStructBytes + 7) / 8;
        self.cg_movRaxImm(worte);
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);    // mov rcx, rax
        self.cg_e8(0xF3); self.cg_e8(0x48); self.cg_e8(0xA5);    // rep movsq
        self.cg_popRax();                                         // rax = Ziel
        if (self.deferCount > 0) { self.cg_pushRax(); self.cg_emitDefers(); self.cg_popRax(); }
        if (self.tryDepth > 0) { self.cg_pushRax(); self.cg_emitTryUnwindDownTo(0); self.cg_popRax(); }
        self.cg_emitEpilogue();
        return;
      }
      // WP-04: tuple return [a, b] → rax=first, rdx=second (SysV ABI)
      if (self.funcHasTupleReturn != 0 && expr >= 0 && self.cg_nkind(expr) == 100) {
        if (self.lockstepActive != 0) {
          EPrintStrLn("error: @integrity(mode: software_lockstep): Tupel-Rueckgabe wird nicht abgedeckt"c);
          EPrintStrLn("  Der Vergleich sitzt auf rax; das zweite Element liegt in rdx."c);
          exit(1);
        }
        var elem0: int64 := self.cg_nc0(expr);
        var elem1: int64 := self.cg_nnext(elem0);
        self.cg_genExpr(elem0);
        self.cg_pushRax();
        self.cg_genExpr(elem1);
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2);  // mov rdx, rax
        self.cg_popRax();
      } else if (self.deferCount > 0) {
        // WP-AS-10: save return value around defer emission
        if (expr >= 0) {
          if (self.curFnRetFnWert != 0) { self.cg_genAlsSatz(expr); }        // #2133
          else { self.cg_genExpr(expr); }
          self.cg_retToF64(expr);                                            // #2004
          if (self.lockstepActive != 0) { self.cg_lockstepPruefe(expr); }   // #1878
          self.cg_pushRax();
          self.cg_emitDefers();
          self.cg_popRax();
        } else {
          self.cg_emitDefers();
          self.cg_zeroRax();
        }
      } else {
        if (expr >= 0) {
          // #2133: ueber die Rueckgabegrenze geht ein Funktionswert als Satz
          // (siehe "Funktionswerte" bei cg_localRufArt).
          if (self.curFnRetFnWert != 0) { self.cg_genAlsSatz(expr); }
          else { self.cg_genExpr(expr); }
          self.cg_retToF64(expr);                                            // #2004
          // #1878: derselbe Vergleich wie im defer-Zweig darueber — die
          // beiden muessen uebereinstimmen, sonst haengt der Nachweis am
          // Vorhandensein eines `defer`.
          if (self.lockstepActive != 0) { self.cg_lockstepPruefe(expr); }
        } else {
          self.cg_zeroRax();
        }
      }
      // #1148: `return` verlaesst jeden offenen try-Block, ohne dessen Ende zu
      // erreichen. Die finally-Bloecke laufen hier — von innen nach aussen —
      // und der Ausnahme-Handler wird zurueckgesetzt, sonst zeigte er nach der
      // Rueckkehr auf einen toten Rahmen. Der Rueckgabewert steht in rax und
      // wird ueber die Rumpfe gerettet.
      if (self.tryDepth > 0) {
        self.cg_pushRax();
        self.cg_emitTryUnwindDownTo(0);
        self.cg_popRax();
      }
      // #1097: Rueckgabe vom Bereichstyp. Der Wert steht in rax; danach ist er
      // beim Aufrufer und traegt den Typ, also muss er hier passen.
      if (expr >= 0) {
        self.cg_emitRangeCheck(self.curFnRetRange, "Rueckgabe"c);
        // #1151: auf die Breite des Rueckgabetyps kuerzen. Der Aufrufer sieht
        // nur rax und kann die Breite nicht mehr kennen.
        self.cg_emitNarrowRax(self.curFnRetNarrow);
      }
      self.cg_emitEpilogue();

    } else if (k == CGN_EXPR_STMT) {
      self.cg_genExpr(self.cg_nc0(ni));

    } else if (k == CGN_IF) {
      self.cg_genIf(ni);

    } else if (k == CGN_WHILE) {
      self.cg_genWhile(ni);

    } else if (k == CGN_REPEAT_UNTIL) {
      self.cg_genRepeatUntil(ni);

    } else if (k == CGN_TUPLE_VAR_DECL) {
      self.cg_genTupleVarDecl(ni);

    } else if (k == CGN_FOR) {
      self.cg_genFor(ni);

    } else if (k == CGN_FOR_C) {
      self.cg_genForC(ni);

    } else if (k == CGN_FOR_RANGE) {
      self.cg_genForRange(ni);

    } else if (k == CGN_SWITCH) {
      self.cg_genSwitch(ni);

    // WP-15: Pattern matching - generate like switch
    } else if (k == CGN_MATCH) {
      self.cg_genMatch(ni);

    } else if (k == CGN_DISPOSE) {
      // #1235: Hier stand ein No-op mit dem Vermerk "Skip for bootstrap" — der
      // Ausdruck wurde ausgewertet und sonst nichts getan. `new` ruft Create
      // korrekt, `dispose` rief Destroy also nie. Wer einen Destruktor
      // schreibt, tut das wegen seiner Wirkung: freizugebende Handles, offene
      // Dateien, Gegenbuchungen. Dass er ausblieb, war beim Lesen des
      // Programms nicht zu sehen.
      //
      // Der Destruktor wird nur gerufen, wenn die Klasse einen hat; die
      // Registry der Rueckgabetypen kennt ihn unter dem gemangelten Namen und
      // liefert -1, wenn es ihn nicht gibt.
      //
      // Die Speicherfreigabe bleibt unveraendert aus: `new` alloziert aus dem
      // Arena-Allokator, der kein einzelnes Objekt zurueckgeben kann. Das ist
      // eine eigene Frage und wird hier nicht mitentschieden.
      // sema hat im iVal vermerkt, ob die Klasse einen Destruktor hat (1 = ja).
      // Der Codegen kann das nicht selbst feststellen: seine Registry der
      // Rueckgabetypen fuehrt nur Methoden MIT Rueckgabetyp, und ein
      // Destruktor hat typischerweise keinen.
      var dispCi: int64 := 0 - 1;
      // #2056: 2 = sema konnte es nicht entscheiden (Klasse oder Basis in
      // einem anderen Modul). Dann wird hier aufgeloest: findet
      // cg_findInheritedMangled einen Destruktor, laeuft er; findet es
      // keinen, bleibt es bei der blossen Auswertung — der Zweig unten macht
      // das schon. Bis 1.2.11C stand hier `== 1`, und jede importierte
      // Klasse kam mit 0 an.
      if (self.cg_nival(ni) == 1 || self.cg_nival(ni) == 2) { dispCi := self.cg_exprClassName(self.cg_nc0(ni)); }
      if (dispCi >= 0) {
        // #1624: auch hier darf der Destruktor aus einer Basisklasse stammen.
        var dlc: int64 := alloc(8);
        var dmb: int64 := self.cg_findInheritedMangled(dispCi, "Destroy"c, 7, dlc);
        var dmbLen: int64 := peek64(dlc);
        free(dlc, 8);
        if (dmb != 0) {
          self.cg_genExpr(self.cg_nc0(ni));   // Empfaenger → rax
          self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);  // mov rdi, rax
          var dpp: int64 := self.cg_emitCall();
          self.cg_addPatch(dpp, dmb, dmbLen, CG_PATCH_CALL);
          self.cg_trackTempBuf(dmb, dmbLen + 1);
        } else {
          self.cg_genExpr(self.cg_nc0(ni));
        }
      } else {
        self.cg_genExpr(self.cg_nc0(ni));
      }

    // WP-12: Exception handling — setjmp/longjmp based
    } else if (k == CGN_TRY) {
      // jmp_buf layout on stack (80 bytes):
      //   [rsp+0..39]: callee-saved regs (rbx,rbp,r12,r13,r14,r15)
      //   [rsp+48]: saved rsp (= jmp_buf base, since mov rax,rsp before sub)
      //   [rsp+56]: catch_label ip
      //   [rsp+64]: old _lyx_exn_ptr

      // sub rsp, 80
      self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC);
      self.cg_e8(0x50); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
      // Save callee-saved registers
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x1C); self.cg_e8(0x24); // mov [rsp], rbx
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x6C); self.cg_e8(0x24); self.cg_e8(0x08); // mov [rsp+8], rbp
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x64); self.cg_e8(0x24); self.cg_e8(0x10); // mov [rsp+16], r12
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x6C); self.cg_e8(0x24); self.cg_e8(0x18); // mov [rsp+24], r13
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x20); // mov [rsp+32], r14
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x28); // mov [rsp+40], r15
      // Save rsp value to [rsp+48] (= current rsp = jmp_buf base; longjmp restores rsp←rax)
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE0);                     // mov rax, rsp
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x30); // mov [rsp+48], rax
      // Save catch_label address to [rsp+56] via forward-patched LEA
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);  // lea rax, [rip+disp32]
      var catchLblPatch: int64 := self.codeLen;
      self.cg_e32(0);                                           // patched after catch label is known
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x38); // mov [rsp+56], rax
      // Save old handler from _lyx_exn_ptr to [rsp+64]
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);   // mov rax, [rcx]
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x40); // mov [rsp+64], rax
      // Install new handler: _lyx_exn_ptr ← rsp
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE0);   // mov rax, rsp
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x01);   // mov [rcx], rax
      // #1148: Ebene anmelden. Die jmp_buf-Basis (= rsp jetzt) kommt in einen
      // verdeckten Slot, damit `return` sie spaeter findet — an einer
      // return-Stelle ist rsp durch Zwischenwerte verschoben, [rsp+64] taugt
      // dort also nicht mehr.
      var finallyNi: int64 := self.cg_nc2(ni);
      var myTryLevel: int64 := self.tryDepth;
      var tryBaseSlot: int64 := self.cg_addLocal("__try_base"c, 10);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE0);   // mov rax, rsp
      self.cg_storeRax(tryBaseSlot);
      if (self.tryDepth >= self.tryCap) {
        // Wachsen statt Verwerfen: ein uebergangener Eintrag hiesse, dass
        // finally bei `return` wieder stumm ausfaellt — genau der Fehler,
        // den #1148 behebt.
        var ntc: int64 := self.tryCap * 2;
        var nsb: int64 := alloc(ntc * 8);
        var nfb: int64 := alloc(ntc * 8);
        memcpy(nsb, self.trySlotBuf, self.tryCap * 8);
        memcpy(nfb, self.tryFinBuf,  self.tryCap * 8);
        self.trySlotBuf := nsb;
        self.tryFinBuf  := nfb;
        self.tryCap     := ntc;
      }
      poke64(self.trySlotBuf + self.tryDepth * 8, tryBaseSlot);
      poke64(self.tryFinBuf  + self.tryDepth * 8, finallyNi);
      self.tryDepth += 1;
      // Generate try body
      // #1118: Stand merken, damit `throw` die defers dieses Blocks abarbeiten
      // kann. Verschachtelte try: der aeussere Stand wird gerettet.
      var savedTryMark: int64 := self.tryDeferMark;
      self.tryDeferMark := self.deferCount;
      self.cg_genBlock(self.cg_nc0(ni));
      self.tryDeferMark := savedTryMark;
      // Try success: restore old handler
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x40); // mov rax, [rsp+64]
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x01);   // mov [rcx], rax
      // Generate finally block on success path (if present)
      // #1148: waehrend des finally-Rumpfes gilt diese Ebene als verlassen —
      // ein `return` darin raeumt nur die aeusseren try-Bloecke ab.
      if (finallyNi >= 0) {
        self.tryDepth := myTryLevel;
        self.cg_genBlock(finallyNi);
        self.tryDepth := myTryLevel + 1;
      }
      // Jump past catch to try_done
      self.cg_e8(0xE9);
      var tryDonePatch: int64 := self.codeLen;
      self.cg_e32(0);
      // === catch_label ===
      var catchOff: int64 := self.codeLen;
      poke32(self.code + catchLblPatch, catchOff - catchLblPatch - 4);
      // longjmp has restored registers and rsp = jmp_buf base
      // Restore old handler
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x40); // mov rax, [rsp+64]
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x01);   // mov [rcx], rax
      // Generate catch clauses (c1 = first catch, nnext-linked)
      var catchNi: int64 := self.cg_nc1(ni);
      while (catchNi >= 0) {
        // #1147: geworfenen Wert JE Klausel neu laden. Ein Rumpf zerstoert rax;
        // die zweite Klausel bekaeme sonst Muell in ihre Bindung.
        self.cg_emitLeaRcxData(CG_EXN_VAL);
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);   // mov rax, [rcx]
        // #1147: `catch (e: T)` bindet den geworfenen Wert. Er steht in rax
        // (oben aus CG_EXN_VAL geladen); er bekommt einen eigenen Slot, damit
        // der Rumpf ihn wie eine gewoehnliche lokale Variable liest. Der Slot
        // wird VOR dem Rumpf angelegt und mit ihm wieder verworfen
        // (cg_genBlock stellt localCount zurueck) — ein gleichnamiges aeusseres
        // `e` bleibt also nach dem catch-Block wieder sichtbar, waehrend es im
        // Rumpf verdeckt ist (cg_findLocal sucht von hinten).
        var cvLen: int64 := self.cg_nslen(catchNi);
        if (cvLen > 0) {
          var savedCatchLocals: int64 := self.localCount;
          var cvOff: int64 := self.cg_addLocal(self.cg_nsval(catchNi), cvLen);
          var cvType: int64 := self.cg_nc1(catchNi);
          if (cvType >= 0 && self.cg_nkind(cvType) == 60) {
            self.cg_setLocalType(self.localCount - 1, self.cg_nsval(cvType), self.cg_nslen(cvType));
          }
          self.cg_storeRax(cvOff);
          self.cg_genBlock(self.cg_nc0(catchNi));  // catch body
          self.localCount := savedCatchLocals;
        } else {
          self.cg_genBlock(self.cg_nc0(catchNi));  // catch body
        }
        catchNi := self.cg_nnext(catchNi);
      }
      // Generate finally block on catch path
      if (finallyNi >= 0) {
        self.tryDepth := myTryLevel;                 // #1148, wie oben
        self.cg_genBlock(finallyNi);
        self.tryDepth := myTryLevel + 1;
      }
      // #1242: `try { … } finally { … }` OHNE catch faengt nichts — es raeumt
      // nur auf. Der Handler wird trotzdem installiert, damit das finally auf
      // dem Ausnahmeweg laeuft; danach muss die Ausnahme aber WEITERGEHEN.
      // Vorher fiel der Weg hier auf try_done durch: die Ausnahme war
      // verschluckt, das Programm lief weiter und endete mit rc=0 — aus einem
      // gemeldeten Fehler wurde stiller Erfolg. Jetzt wird sie erneut geworfen.
      if (self.cg_nc1(ni) < 0) {
        self.tryDepth := myTryLevel;
        self.cg_emitRethrow();
      }
      // #1148: Ebene abmelden — ab hier ist der try-Block verlassen.
      self.tryDepth := myTryLevel;
      // === try_done ===
      poke32(self.code + tryDonePatch, self.codeLen - tryDonePatch - 4);
      // add rsp, 80  — restore stack frame
      self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xC4);
      self.cg_e8(0x50); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);

    } else if (k == CGN_CATCH || k == CGN_FINALLY) {
      // Standalone catch/finally outside try — just generate body
      self.cg_genBlock(self.cg_nc0(ni));

    } else if (k == CGN_THROW) {
      // WP-12: throw expr — store exception value, longjmp or exit(1)
      self.cg_genExpr(self.cg_nc0(ni));               // rax = exception value
      // #1118: Der try-Block wird hier verlassen — seine defers laufen zuerst,
      // wie bei break/continue in einer Schleife (#1006). Der Wert steht schon
      // in rax; die defers duerfen ihn nicht verlieren, also gerettet.
      //
      // #1241: Steht der `throw` in KEINEM try dieser Funktion, dann verlaesst
      // die Ausnahme den Rahmen — der Sprung geht zu einem Handler im Aufrufer
      // oder gar nirgendwohin. Dann laufen ALLE defers dieser Funktion, nicht
      // bloss die eines try-Blocks. Vorher lief hier keiner: die Bedingung
      // verlangte einen umgebenden try, und genau im Fehlerfall — dem einzigen,
      // fuer den man `defer CloseFile(fd)` schreibt — leckte der Deskriptor.
      var throwDeferMark: int64 := self.tryDeferMark;
      if (throwDeferMark < 0) { throwDeferMark := 0; }
      // #1334: Traegt die Funktion einen Rahmen-Halt und steht der `throw` in
      // keinem try dieser Funktion, dann landet der Sprung im EIGENEN
      // Landepunkt — und der arbeitet die defers bereits ab. Hier nochmals zu
      // emittieren, hiesse jeden defer zweimal auszufuehren (die Reproduktion
      // aus #1241 zeigte "G1" doppelt). Innerhalb eines try bleibt es beim
      // alten Weg: dort springt der Wurf am Halt vorbei zum catch.
      var throwEigenerHalt: int64 := 0;
      if (self.deferDepthSlot != 0 && self.tryDeferMark < 0) { throwEigenerHalt := 1; }
      if (throwEigenerHalt == 0 && self.deferCount > throwDeferMark) {
        self.cg_pushRax();
        self.cg_emitDefersDownTo(throwDeferMark);
        self.cg_popRax();
      }
      self.cg_emitLeaRcxData(CG_EXN_VAL);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x01);   // mov [rcx], rax
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);   // mov rax, [rcx]
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
      self.cg_e8(0x0F); self.cg_e8(0x84);
      var throwNH: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_genLongjmp();
      poke32(self.code + throwNH, self.codeLen - throwNH - 4);
      // no handler: Prozess beenden (#1487)
      self.cg_movRaxImm(1);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);   // mov rdi, rax
      self.cg_movRaxImm(231);
      self.cg_e8(0x0F); self.cg_e8(0x05);                      // syscall (exit_group)

    } else if (k == CGN_ASSERT) {
      // WP-BC-07: assert(cond) — write "assertion failed\n" to stderr + exit(1) if cond == 0
      var condNode: int64 := self.cg_nc0(ni);
      if (condNode >= 0) {
        self.cg_genExpr(condNode);  // result in rax
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x75);                                         // jnz short (skip panic)
        var pSkip: int64 := self.codeLen;
        self.cg_e8(0);                                            // placeholder
        // Inline panic: lea rsi, [rip+msgOff]; mov edx, 17; mov edi, 2; mov eax, 1; syscall; exit(1)
        var msgOff: int64 := self.dataLen;
        self.cg_edata(97);  self.cg_edata(115); self.cg_edata(115); // ass
        self.cg_edata(101); self.cg_edata(114); self.cg_edata(116); // ert
        self.cg_edata(105); self.cg_edata(111); self.cg_edata(110); // ion
        self.cg_edata(32);  self.cg_edata(102); self.cg_edata(97);  //  fa
        self.cg_edata(105); self.cg_edata(108); self.cg_edata(101); // ile
        self.cg_edata(100); self.cg_edata(10);  self.cg_edata(0);   // d\n\0 (17 chars + NUL)
        // lea rsi, [rip+disp32]  (48 8D 35 disp32)
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
        var pData: int64 := self.codeLen;
        self.cg_e32(0);
        self.cg_addPatch(pData, msgOff, 0, CG_PATCH_STR);       // resolve RIP-relative offset
        self.cg_e8(0xBA); self.cg_e8(17);  self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);  // mov edx, 17
        self.cg_e8(0xBF); self.cg_e8(2);   self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);  // mov edi, 2 (stderr)
        self.cg_e8(0xB8); self.cg_e8(1);   self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);  // mov eax, 1 (sys_write)
        self.cg_e8(0x0F); self.cg_e8(0x05);                                                // syscall
        self.cg_e8(0xBF); self.cg_e8(1);   self.cg_e8(0); self.cg_e8(0); self.cg_e8(0);  // mov edi, 1 (exit code)
        self.cg_movRaxImm(231);                                                             // #1487: exit_group
        self.cg_e8(0x0F); self.cg_e8(0x05);                                                // syscall
        cg_patchRel8(self.code, pSkip, self.codeLen);  // patch jnz offset
      }

    // WP-BC-10: panic(msg) — evaluate msg → rdi, emit inline panic body
    } else if (k == CGN_PANIC) {
      var msgNode: int64 := self.cg_nc0(ni);
      if (msgNode >= 0) {
        self.cg_genExpr(msgNode);                                   // msg → rax
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);     // mov rdi, rax
        self.cg_emitPanicBody();
      }

    // WP-BC-09: pool { stmt* } — in bootstrap, pool is a no-op; just emit the body
    } else if (k == CGN_POOL) {
      var bodyNode: int64 := self.cg_nc0(ni);
      if (bodyNode >= 0) { self.cg_genStmt(bodyNode); }

    } else if (k == CGN_BREAK) {
      // #1006: offene defers des Schleifenrumpfes laufen vor dem Sprung.
      // Der Zaehler bleibt stehen — der Blockcode dahinter wird weiter erzeugt
      // und gilt fuer den Weg ohne break.
      if (self.loopDeferMark >= 0) { self.cg_emitDefersDownTo(self.loopDeferMark); }
      // #1148: dasselbe fuer die try-Bloecke, die der Sprung verlaesst — die
      // defers des Rumpfes zuerst, dann die finally-Bloecke darum herum.
      if (self.tryDepth > self.loopTryMark) { self.cg_emitTryUnwindDownTo(self.loopTryMark); }
      // jmp rel32 to loop exit; placeholder stores previous break-list head
      self.cg_e8(0xE9);
      var bp: int64 := self.codeLen;
      self.cg_e32(self.curBreakHead);  // link to previous
      self.curBreakHead := bp;

    } else if (k == CGN_CONTINUE) {
      // #1006: wie bei break — der Rumpf wird verlassen, seine defers laufen.
      if (self.loopDeferMark >= 0) { self.cg_emitDefersDownTo(self.loopDeferMark); }
      if (self.tryDepth > self.loopTryMark) { self.cg_emitTryUnwindDownTo(self.loopTryMark); }  // #1148
      // jmp rel32 to loop continue; placeholder stores previous continue-list head
      self.cg_e8(0xE9);
      var cp: int64 := self.codeLen;
      self.cg_e32(self.curContHead);  // link to previous
      self.curContHead := cp;

    } else if (k == CGN_CASE) {
      // Switch case body — generate body expression/block
      // c0 = case value (or null for default), c1 = body
      var bodyNode: int64 := self.cg_nc1(ni);
      if (bodyNode >= 0) {
        self.cg_genBlock(bodyNode);
      }

    } else if (k == CGN_MATCH_CASE) {
      // Match case body — generate body expression
      // c0 = pattern, c1 = body expression
      var bodyNode: int64 := self.cg_nc1(ni);
      if (bodyNode >= 0) {
        self.cg_genMatchBody(bodyNode);
      }

    } else if (k == CGN_FIELD_DECL) {
      // Field declaration in struct/class — no code generation needed
      // Layout is handled by cg_buildStructLayout/cg_buildClassLayout
      // Just skip (fields are processed during layout building)

    } else if (k == CGN_PARAM) {
      // Parameter declaration — already handled during function prologue generation
      // In IR-lowering context: register parameter as local variable
      var pname: pchar := self.cg_nsval(ni);
      var plen: int64 := self.cg_nslen(ni);
      var poff: int64 := self.cg_addLocal(pname, plen);
      // Track type if present (c0 = type node)
      var ptypeNode: int64 := self.cg_nc0(ni);
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == 60) {
        self.cg_setLocalType(self.localCount - 1, self.cg_nsval(ptypeNode), self.cg_nslen(ptypeNode));
      }
      self.cg_markArrayParam(self.localCount - 1, ptypeNode);   // #1115
      self.cg_markMapStrKey(self.localCount - 1, ptypeNode);            // #1291
      // #1003: inline geschriebener fn-Zeigertyp als Parameter
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == CGN_FN_PTR_NODE) {
        poke8(self.localIsFnPtr + self.localCount - 1, 1);
        // #1565: auch hier den Rueckgabetyp mitfuehren — dies ist die Stelle
        // fuer Parameter der obersten Ebene (`fn Apply(f: fn(f64): f64, …)`).
        // #1622: hier stand `ptypeNode` — den Namen gibt es nicht. Der
        // Rumpf einer Methode wurde nie geprueft, der Bezeichner wurde still
        // zu 0, und diese der vier Stellen aus #1565 war damit tot.
        if (self.cg_fnPtrRetIstF64(ptypeNode) != 0) {
          poke8(self.localFnPtrF64 + self.localCount - 1, 1);
        }
        poke8(self.localFnRetSatz + self.localCount - 1, self.cg_fnPtrRetTiefe(ptypeNode));   // #2143
      }

    } else if (k == CGN_AT_DIRECTIVE) {  // WP-CS-07 / WP-AS-04/05
      var kind: int64 := self.cg_nival(ni);
      var val:  int64 := self.cg_nc0(ni);
      if (kind == 0) { self.ioCheckEnabled       := val; }
      if (kind == 1) { self.overflowCheckEnabled := val; }
      if (kind == 2) { self.boundsCheckEnabled   := val; }  // WP-AS-04
      if (kind == 2) { self.boundsCheckForced    := val; }  // #1124
      if (kind == 3) { self.debugMode            := val; }  // WP-AS-05: @debug_info aliases debugMode
      if (kind == 4) { self.optLevel             := val; }  // WP-AS-04

    } else if (k == CGN_AT_CPU) {  // #2191: @cpu(stufe); innerhalb eines Blocks
      self.scopeCpuStufe := self.cg_nival(ni);
      self.fnCpuStufe    := self.cg_nival(ni);
    } else if (k == CGN_AT_ENERGY) {  // WP-EN-04: @energy(N); statement override
      self.fnEnergyLevel := self.cg_nival(ni);

    } else if (k == CGN_DEFER) {
      // #1006: Der aufgeschobene Aufruf wird hier nur VORGEMERKT. Emittiert
      // wird er am Ende des umschliessenden Blocks (cg_genBlock) bzw. an jedem
      // vorzeitigen return. Die Vormerkung geschieht an der Stelle, an der das
      // defer im Quelltext steht — ein defer hinter einem return wird damit
      // nicht mehr ausgefuehrt, was der Blocksemantik entspricht.
      if (self.deferCount < self.deferCap) {
        poke64(self.deferBuf + self.deferCount * 8, self.cg_nc0(ni));
        self.deferCount += 1;
        if (self.deferCount > self.deferMaxCount) { self.deferMaxCount := self.deferCount; }
        // #1334: Die erreichte Tiefe im Rahmen vermerken. Der Landepunkt
        // weiss sonst nicht, wie weit der Rumpf gekommen ist, wenn eine
        // Ausnahme von tiefer unten hereinschlaegt.
        if (self.deferDepthSlot != 0) {
          self.cg_movRaxImm(self.deferCount);
          self.cg_storeRax(self.deferDepthSlot);
        }
        // #1030: Argumente JETZT auswerten und sichern.
        self.cg_captureDeferArgs(self.cg_nc0(ni));
      }

    } else {
      // Other statement kinds: skip
    }
  }

  // WP-AS-10: emit deferred statements in LIFO order (last defer first).
  // Wird an return-Punkten benutzt: dort laufen ALLE noch offenen defers ab,
  // also auch die der umschliessenden Bloecke.
  // #1334: Rahmen-Halt installieren. Dieselbe Maschinerie wie `try` (jmp_buf
  // auf dem Stapel, Handler in CG_EXN_PTR), nur ohne catch: der Landepunkt
  // arbeitet die defers ab und wirft weiter.
  //
  // Ohne ihn sprang eine Ausnahme aus einer TIEFEREN Funktion per longjmp
  // direkt in den Handler weiter oben — der Rahmen dazwischen wurde
  // uebersprungen, und niemand fuehrte seine defers aus. `defer CloseFile(fd)`
  // leckte still, und zwar im haeufigeren Fall: man faengt oben, wirft unten.
  //
  // Liefert den Slot des Tiefenzaehlers, oder 0, wenn kein Halt noetig war.
  fn cg_emitDeferHalt(body: int64): int64 {
    if (self.cg_hatDefer(body) == 0) { return 0; }
    // sub rsp, 80
    self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC);
    self.cg_e8(0x50); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x1C); self.cg_e8(0x24);                     // mov [rsp], rbx
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x6C); self.cg_e8(0x24); self.cg_e8(0x08);   // mov [rsp+8], rbp
    self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x64); self.cg_e8(0x24); self.cg_e8(0x10);   // r12
    self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x6C); self.cg_e8(0x24); self.cg_e8(0x18);   // r13
    self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x20);   // r14
    self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x28);   // r15
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE0);                                       // mov rax, rsp
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x30);   // mov [rsp+48], rax
    // Landepunktadresse nach [rsp+56] — vorwaerts gepatcht.
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
    var landePatch: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x38);   // mov [rsp+56], rax
    // Alten Handler retten und eigenen setzen.
    self.cg_emitLeaRcxData(CG_EXN_PTR);
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);                                       // mov rax,[rcx]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x40);   // mov [rsp+64], rax
    self.cg_emitLeaRcxData(CG_EXN_PTR);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE0);                                       // mov rax, rsp
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x01);                                       // mov [rcx], rax
    // Als try-Ebene anmelden, damit `return` den Handler zurueckstellt (#1148).
    var basisSlot: int64 := self.cg_addLocal("__defer_base"c, 12);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE0);                                       // mov rax, rsp
    self.cg_storeRax(basisSlot);
    if (self.tryDepth < self.tryCap) {
      poke64(self.trySlotBuf + self.tryDepth * 8, basisSlot);
      poke64(self.tryFinBuf  + self.tryDepth * 8, -1);
      self.tryDepth += 1;
    }
    // Tiefenzaehler anlegen und nullen.
    var zSlot: int64 := self.cg_addLocal("__defer_n"c, 9);
    self.cg_zeroRax();
    self.cg_storeRax(zSlot);
    self.deferLandePatch := landePatch;
    return zSlot;
  }

  // #1334: Traegt dieser Teilbaum irgendwo ein `defer`? Verschachtelte
  // Funktionen zaehlen NICHT mit — die bringen ihren eigenen Rahmen und
  // damit ihren eigenen Halt.
  fn cg_hatDefer(ni: int64): int64 {
    var cur: int64 := ni;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_DEFER) { return 1; }
      if (k != CGN_FUNC_DECL) {
        if (self.cg_hatDefer(self.cg_nc0(cur)) != 0) { return 1; }
        if (self.cg_hatDefer(self.cg_nc1(cur)) != 0) { return 1; }
        if (self.cg_hatDefer(self.cg_nc2(cur)) != 0) { return 1; }
      }
      cur := self.cg_nnext(cur);
    }
    return 0;
  }

  // #1334: Der Landepunkt des Rahmen-Halts. Erreicht wird er nur ueber
  // longjmp; der stellt rsp auf die jmp_buf-Basis und die
  // Callee-saved-Register samt rbp wieder her.
  //
  // Abgearbeitet werden GENAU die defers, die zur Wurfzeit angemeldet waren —
  // das sagt der Zaehler im Rahmen. Ein statisches "alle" waere falsch: ein
  // defer hinter der Wurfstelle wurde nie angemeldet und darf nicht laufen.
  fn cg_emitDeferLandepunkt() {
    if (self.deferDepthSlot == 0) { return; }
    // Alten Handler zuruecksetzen: er steht im jmp_buf bei +64.
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x40); // mov rax,[rsp+64]
    self.cg_emitLeaRcxData(CG_EXN_PTR);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x01);   // mov [rcx], rax
    // Defers in LIFO-Reihenfolge, jeder unter der Bedingung "war angemeldet".
    var i: int64 := self.deferMaxCount - 1;
    while (i >= 0) {
      self.cg_loadRax(self.deferDepthSlot);
      self.cg_e8(0x48); self.cg_e8(0x3D); self.cg_e32(i + 1);   // cmp rax, i+1
      self.cg_e8(0x0F); self.cg_e8(0x8C);                        // jl ueber diesen defer
      var ueber: int64 := self.codeLen;
      self.cg_e32(0);
      // #1030-Wiedergabe gilt hier NICHT: die verdeckten Argument-Slots
      // gehoeren zum Rumpf, und der Landepunkt liegt hinter ihm. In einer
      // Schleife stand dort nichts Brauchbares mehr — der Aufruf gab eine
      // leere Zeile aus statt des Wertes. Am Landepunkt werden die Argumente
      // deshalb neu ausgewertet.
      var savedReplay: int64 := self.dfReplay;
      self.dfReplay := 0;
      self.cg_genStmt(peek64(self.deferBuf + i * 8));
      self.dfReplay := savedReplay;
      poke32(self.code + ueber, self.codeLen - ueber - 4);
      i -= 1;
    }
    // Weiterwerfen: der Wert steht noch in CG_EXN_VAL. Gibt es keinen
    // aeusseren Handler mehr, endet der Prozess — wie bei einem `throw` ohne
    // Handler (#1487).
    self.cg_emitLeaRcxData(CG_EXN_PTR);
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);   // mov rax, [rcx]
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
    self.cg_e8(0x0F); self.cg_e8(0x84);
    var keinH: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_genLongjmp();
    poke32(self.code + keinH, self.codeLen - keinH - 4);
    self.cg_movRaxImm(1);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);   // mov rdi, rax
    self.cg_movRaxImm(231);
    self.cg_e8(0x0F); self.cg_e8(0x05);                      // syscall exit_group
  }

  fn cg_emitDefers() {
    var i: int64 := self.deferCount - 1;
    while (i >= 0) {
      self.cg_genStmt(peek64(self.deferBuf + i * 8));
      i -= 1;
    }
    if (self.deferDepthSlot != 0 && self.deferCount > 0) {   // #1334
      self.cg_pushRax();
      self.cg_zeroRax();
      self.cg_storeRax(self.deferDepthSlot);
      self.cg_popRax();
    }
  }

  // #1006: defers eines Blocks abarbeiten — LIFO bis zurueck zum Stand bei
  // Blockeintritt. Der Rest gehoert den umschliessenden Bloecken und bleibt
  // stehen.
  fn cg_emitDefersDownTo(mark: int64) {
    var i: int64 := self.deferCount - 1;
    while (i >= mark) {
      var savedReplay: int64 := self.dfReplay;
      self.dfReplay := 1;                      // #1030
      self.cg_genStmt(peek64(self.deferBuf + i * 8));
      self.dfReplay := savedReplay;
      i -= 1;
    }
    // #1334: Was hier gelaufen ist, ist nicht mehr angemeldet. Ohne diese
    // Rueckmeldung an den Rahmenzaehler arbeitete der Landepunkt sie ein
    // zweites Mal ab — sichtbar an "d-innen", das zweimal kam, wenn ein
    // try-Block im selben Rahmen die Ausnahme schon teilweise abgewickelt
    // hatte.
    if (self.deferDepthSlot != 0 && self.deferCount > mark) {
      self.cg_pushRax();
      self.cg_movRaxImm(mark);
      self.cg_storeRax(self.deferDepthSlot);
      self.cg_popRax();
    }
  }

  // #1148: die try-Bloecke bis zurueck zu `mark` verlassen — von innen nach
  // aussen. Je Ebene wird zuerst der Ausnahme-Handler auf den Stand vor diesem
  // try zurueckgesetzt (er steht im jmp_buf bei +64, dessen Basis in einem
  // verdeckten Slot liegt), dann laeuft der finally-Block.
  //
  // Der Rueckgabewert steht beim Aufruf in rax und muss ihn ueberleben — der
  // Aufrufer rettet ihn. Hier duerfen nur rax und rcx benutzt werden, was
  // ausser dem finally-Rumpf selbst auch zutrifft; der Rumpf laeuft vor dem
  // Wiederherstellen des Wertes.
  //
  // Waehrend ein finally-Rumpf erzeugt wird, gilt seine eigene Ebene als
  // verlassen: ein `return` darin raeumt nur noch die AEUSSEREN try-Bloecke ab
  // und nicht sich selbst (sonst endlose Rekursion im Codegen).
  fn cg_emitTryUnwindDownTo(mark: int64) {
    var savedDepth: int64 := self.tryDepth;
    var i: int64 := self.tryDepth - 1;
    while (i >= mark) {
      self.cg_loadRax(peek64(self.trySlotBuf + i * 8));        // rax = jmp_buf-Basis
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40); self.cg_e8(0x40);  // mov rax, [rax+64]
      self.cg_emitLeaRcxData(CG_EXN_PTR);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x01);    // mov [rcx], rax
      var fin: int64 := peek64(self.tryFinBuf + i * 8);
      if (fin >= 0) {
        self.tryDepth := i;
        self.cg_genBlock(fin);
      }
      i -= 1;
    }
    self.tryDepth := savedDepth;
  }

  // #1030: Argumente des aufgeschobenen Aufrufs an der Stelle des `defer`
  // auswerten und in verdeckte Slots legen. Ohne das wuerden sie erst am
  // Blockende ausgewertet — `defer f(i)` in einer Schleife saehe dort das
  // bereits erhoehte i.
  fn cg_captureDeferArgs(stmtNi: int64) {
    if (stmtNi < 0) { return; }
    var callNi: int64 := stmtNi;
    if (self.cg_nkind(callNi) == CGN_EXPR_STMT) { callNi := self.cg_nc0(callNi); }
    if (callNi < 0) { return; }
    if (self.cg_nkind(callNi) != CGN_CALL) { return; }
    // Methodenaufruf (iVal==1): Argumente haengen an c1, sonst an c0.
    var argNi: int64 := self.cg_nc0(callNi);
    if (self.cg_nival(callNi) == 1) { argNi := self.cg_nc1(callNi); }
    while (argNi >= 0) {
      if (self.dfCount >= self.dfCap) { return; }
      self.cg_genExpr(argNi);
      var off: int64 := self.cg_addLocal("__dfarg__", 9);
      self.cg_storeRax(off);
      poke64(self.dfNodes + self.dfCount * 8, argNi);
      poke64(self.dfSlots + self.dfCount * 8, off);
      self.dfCount += 1;
      argNi := self.cg_nnext(argNi);
    }
  }

  // #1030: Index des gesicherten Slots fuer einen Argumentknoten, sonst -1.
  // Geliefert wird der INDEX, nicht der Offset: Rahmen-Offsets sind rbp-relativ
  // und damit negativ, ein Offset taugt hier nicht als Trefferkennung.
  fn cg_deferArgIdx(ni: int64): int64 {
    var i: int64 := self.dfCount - 1;
    while (i >= 0) {
      if (peek64(self.dfNodes + i * 8) == ni) { return i; }
      i -= 1;
    }
    return 0 - 1;
  }

  fn cg_genBlock(ni: int64) {
    if (ni < 0) { return; }
    var savedLocals: int64 := self.localCount;
    // #1006: Stand der offenen defers bei Blockeintritt merken.
    var savedDefers: int64 := self.deferCount;
    var stmt: int64 := self.cg_nc0(ni);
    while (stmt != -1) {
      var sk: int64 := self.cg_nkind(stmt);
      // WP-13: verschachtelte fn-Deklaration. NICHT hier emittieren — der Rumpf
      // landete sonst mitten im Instruktionsstrom der äußeren Funktion, die
      // anschließend hineinfällt (der Grund für den SIGSEGV). Stattdessen
      // vormerken und nach der äußeren Funktion emittieren.
      if (sk == CGN_FUNC_DECL) {
        self.cg_addPendingNested(stmt);
      } else {
        self.cg_genStmt(stmt);
      }
      stmt := self.cg_nnext(stmt);
    }
    // #1006: defers dieses Blocks laufen VOR dem Verwerfen der Locals — der
    // aufgeschobene Ausdruck darf auf Variablen des Blocks zugreifen.
    self.cg_emitDefersDownTo(savedDefers);
    self.deferCount := savedDefers;
    // Restore local scope (pop locals declared in this block)
    self.localCount := savedLocals;
  }

  // WP-13: Generate nested function prologue (accepts static link in rbp+16)
  // WP-18: Also installs stack canary at [rbp-8], same as cg_emitPrologue.
  fn cg_emitPrologueNested(): int64 {
    self.cg_e8(0x55);                          // push rbp
    self.cg_cfi(CFI_CFA_OFF, 16);              // #2135: wie cg_emitPrologue
    self.cg_cfi(CFI_SICHER, 6 | (2 << 8));
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE5);  // mov rbp, rsp
    self.cg_cfi(CFI_CFA_RBP, 0);
    // sub rsp, imm32 (48 81 EC xx xx xx xx)
    self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC);
    var patchPos: int64 := self.codeLen;
    self.cg_e32(0);
    // WP-18: reserve [rbp-8] for canary before any locals
    self.frameSize += 8;
    // mov rax, [rip+CG_CANARY]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05);
    var pCanaryNested: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pCanaryNested, CG_CANARY, 0, CG_PATCH_STR);
    // mov [rbp-8], rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x45); self.cg_e8(0xF8);
    // xor rax, rax
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    // #2081: rbx sichern. Nach SysV muss der GERUFENE rbx erhalten; der Codegen
    // benutzt es aber als Arbeitsregister (linker Operand jeder Binaeroperation,
    // Zieladresse indirekter Aufrufe). Fuer Lyx→Lyx war das unschaedlich, fuer
    // einen C-Aufrufer nicht: qsort mit einer Lyx-Vergleichsfunktion und
    // OpenSSL-Callbacks stuerzten ab. Der Slot liegt fest unter dem Canary
    // ([rbp-16]); cg_emitEpilogue laedt ihn zurueck — beide muessen
    // uebereinstimmen, auch in cg_emitPrologueNested.
    self.frameSize += 8;
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x5D); self.cg_e8(0xF0);  // mov [rbp-16], rbx
    self.cg_cfi(CFI_SICHER, 3 | (4 << 8));     // #2135: rbx bei rbp-16 = CFA-32
    // Static link is already in [rbp+16] from caller
    return patchPos;
  }

  fn cg_genIf(ni: int64) {
    // WP-10g: dead-branch elimination — if condition is a compile-time constant
    var condNi: int64 := self.cg_nc0(ni);
    if (self.cg_tryFold(condNi) != 0) {
      if (self.foldBuf != 0) {
        self.cg_genBlock(self.cg_nc1(ni));   // condition always true → emit then only
      } else {
        var elseDead: int64 := self.cg_nc2(ni);
        if (elseDead >= 0) {
          if (self.cg_nkind(elseDead) == CGN_BLOCK) {
            self.cg_genBlock(elseDead);
          } else {
            self.cg_genStmt(elseDead);
          }
        }
      }
      return;
    }
    // Evaluate condition
    // #2114: test rax, rax; jz else_label — oder direkt j(nicht cc)
    self.cg_genSprungWennFalsch(condNi);
    var jzPos: int64 := self.codeLen;
    self.cg_e32(0);  // placeholder

    // Then branch
    self.cg_genBlock(self.cg_nc1(ni));

    var elseNode: int64 := self.cg_nc2(ni);
    if (elseNode >= 0) {
      // jmp over else
      self.cg_paarAusrichten(self.codeLen, 5);   // #2244
      self.cg_e8(0xE9);
      var jmpPos: int64 := self.codeLen;
      self.cg_e32(0);
      // Patch jz to here (else start)
      poke32(self.code + jzPos, self.codeLen - jzPos - 4);
      // Else branch
      if (self.cg_nkind(elseNode) == CGN_BLOCK) {
        self.cg_genBlock(elseNode);
      } else {
        self.cg_genStmt(elseNode);
      }
      // Patch jmp to here (end)
      poke32(self.code + jmpPos, self.codeLen - jmpPos - 4);
    } else {
      // Patch jz to here (end, no else)
      poke32(self.code + jzPos, self.codeLen - jzPos - 4);
    }
  }

  // WP-EN-05: copy-unrolling with U copies (U = cg_unrollFactor()).
  // Each copy: eval cond → jz exit, body.
  // Continue in copy K (K<U-1) → start of copy K+1's condition.
  // Continue in last copy → loopTop.
  // All breaks → exit.
  // #1103: Iterationsschranke `while (c) limit(N)`. Der Wert muss zur
  // Uebersetzungszeit feststehen (ebnf.md §12: ConstExpr) -- eine Schranke,
  // die selbst erst berechnet wird, sichert nichts zu. -1 = keine Schranke.
  fn cg_limitValue(limNode: int64): int64 {
    if (limNode < 0) { return 0 - 1; }
    var k: int64 := self.cg_nkind(limNode);
    if (k == CGN_LIT_INT) { return self.cg_nival(limNode); }
    if (k == CGN_IDENT) {
      var nm: pchar := self.cg_nsval(limNode);
      var nl: int64 := self.cg_nslen(limNode);
      if (self.cg_hasConVal(nm, nl) != 0) { return self.cg_findConVal(nm, nl); }
    }
    EPrintStrLn("error: limit(N) verlangt eine Konstante"c);
    EPrintStrLn("  Zulaessig sind ein Ganzzahlliteral und ein `con`. Eine berechnete"c);
    EPrintStrLn("  Schranke sichert die Endlichkeit der Schleife nicht zu."c);
    exit(1);
    return 0 - 1;
  }

  // #1103: Zaehler hochzaehlen und gegen die Schranke pruefen. Steht am Anfang
  // des Rumpfes, also VOR dem ersten Durchlauf des Rumpfinhalts: die Schranke
  // begrenzt die Zahl der Durchlaeufe, nicht die der Bedingungspruefungen.
  //
  // Die Schranke wird DURCHGESETZT, nicht bloss vermerkt. Ein Vermerk, den
  // niemand prueft, sagt ueber die Endlichkeit der Schleife nichts aus -- das
  // ist derselbe stille Nachweis wie bei den Attributen in #1099.
  fn cg_emitLimitCheck(cntOff: int64, limVal: int64, msgOff: int64) {
    self.cg_loadRax(cntOff);
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC0);   // inc rax
    self.cg_storeRax(cntOff);
    self.cg_e8(0x48); self.cg_e8(0xB9); self.cg_e64(limVal); // mov rcx, N
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);   // cmp rax, rcx
    self.cg_e8(0x0F); self.cg_e8(0x8E);                     // jle .ok
    var jOk: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_emitLeaRdiData(msgOff);
    self.cg_emitPanicBody();
    poke32(self.code + jOk, self.codeLen - jOk - 4);
  }

  fn cg_genWhile(ni: int64) {
    var U:              int64 := self.cg_unrollFactor();
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead:  int64 := self.curContHead;
    var allBreakHead:   int64 := -1;
    var jzHead:         int64 := -1;
    var prevContHead:   int64 := -1;

    // #1103: Schranke vorbereiten -- Zaehlerzelle nullen, Meldung ablegen.
    // Beides VOR loopTop, sonst begaenne jeder Durchlauf wieder bei null.
    var limVal: int64 := self.cg_limitValue(self.cg_nc2(ni));
    var limCnt: int64 := 0;
    var limMsg: int64 := 0;
    if (limVal >= 0) {
      limCnt := self.cg_addLocal("__lyx_limit"c, 11);
      self.cg_zeroRax();
      self.cg_storeRax(limCnt);
      var lm: pchar := StrConcat("Schleifenschranke ueberschritten: limit("c, IntToStr(limVal));
      lm := StrConcat(lm, ")\n"c);
      limMsg := self.cg_emitCStrData(lm);
    }

    // #2206: Marke der Vektorarena. Legt der Rumpf Vektorablagen an, die ihn
    // nicht verlassen, wird die Arena bei jedem Durchlauf auf diesen Stand
    // zurueckgesetzt — dieselben Seiten werden wiederverwendet. Gemessen
    // waren es vorher 86696 Seitenfehler gegen 94 bei der C-Fassung, und
    // darin lagen rund 90 % der Laufzeit, nicht im mmap.
    //
    // Gesichert wird NUR, wenn nichts entkommen kann (cg_vecEntkommt). Die
    // Marke steht VOR loopTop, das Zuruecksetzen dahinter: so wirkt es in
    // jedem Durchlauf, auch nach `continue` oder `break`.
    var vecMarke: int64 := 1;   // 1 = keine Marke (Rahmenabstaende sind negativ)
    if (self.cg_vecRumpfLegtAnRumpf(self.cg_nc1(ni)) != 0
        && self.cg_vecEntkommtRumpf(self.cg_nc1(ni)) == 0) {
      vecMarke := self.cg_vecMarkeSetzen();
    }

    var loopTop:        int64 := self.codeLen;
    self.cg_vecMarkeZurueck(vecMarke);   // #2206

    var copy: int64 := 0;
    while (copy < U) {
      // Patch previous copy's continue list to here (start of this copy's condition)
      if (prevContHead != -1) { self.cg_patchList(prevContHead, self.codeLen); }
      // Condition
      self.cg_genSprungWennFalsch(self.cg_nc0(ni));   // #2114: test/jz oder j(nicht cc)
      self.cg_e32(jzHead);
      jzHead := self.codeLen - 4;
      // Body
      self.curBreakHead := -1;
      self.curContHead  := -1;
      var savedMarkW: int64 := self.loopDeferMark;
      var savedTryMarkW: int64 := self.loopTryMark;   // #1148
      self.loopDeferMark := self.deferCount;
      self.loopTryMark   := self.tryDepth;   // #1148
      if (limVal >= 0) { self.cg_emitLimitCheck(limCnt, limVal, limMsg); }   // #1103
      self.cg_genBlock(self.cg_nc1(ni));
      self.loopDeferMark := savedMarkW;
      self.loopTryMark   := savedTryMarkW;   // #1148
      // Accumulate break list; save this copy's continue list for later
      allBreakHead := self.cg_mergeBreakList(allBreakHead, self.curBreakHead);
      prevContHead := self.curContHead;
      copy += 1;
    }
    // Last copy's continue list → loopTop
    if (prevContHead != -1) { self.cg_patchList(prevContHead, loopTop); }
    // jmp loopTop
    self.cg_paarAusrichten(self.codeLen, 5);   // #2244: Ruecksprung nicht ueber eine 32-Byte-Grenze
    self.cg_e8(0xE9);
    self.cg_e32(loopTop - self.codeLen - 4);
    // .exit: patch all condition exits and break jumps
    var exitPos: int64 := self.codeLen;
    self.cg_patchList(jzHead, exitPos);
    self.cg_patchList(allBreakHead, exitPos);
    // Restore outer loop's break/continue lists
    self.curBreakHead := savedBreakHead;
    self.curContHead  := savedContHead;
  }

  // WP-BC-04: repeat { body } until (cond)
  // body executes first; loop back while cond == 0 (false)
  fn cg_genRepeatUntil(ni: int64) {
    // #2206: Marke der Vektorarena — `repeat ... until`, Rumpf in c0.
    var vecMarke: int64 := 1;   // 1 = keine Marke (Rahmenabstaende sind negativ)
    if (self.cg_vecRumpfLegtAnRumpf(self.cg_nc0(ni)) != 0
        && self.cg_vecEntkommtRumpf(self.cg_nc0(ni)) == 0) {
      vecMarke := self.cg_vecMarkeSetzen();
    }
    var loopTop: int64 := self.codeLen;
    self.cg_vecMarkeZurueck(vecMarke);   // #2206
    // Save outer break/continue lists
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead:  int64 := self.curContHead;
    self.curBreakHead := -1;
    self.curContHead  := -1;
    // Body
    var savedMarkR: int64 := self.loopDeferMark;
    var savedTryMarkR: int64 := self.loopTryMark;   // #1148
    self.loopDeferMark := self.deferCount;
    self.loopTryMark   := self.tryDepth;   // #1148
    self.cg_genBlock(self.cg_nc0(ni));
    self.loopDeferMark := savedMarkR;
    self.loopTryMark   := savedTryMarkR;   // #1148
    // contPos: patch all continue jumps to here (before condition eval)
    var contPos: int64 := self.codeLen;
    var ch: int64 := self.curContHead;
    while (ch != -1) {
      var b0: int64 := peek8(self.code + ch) as int64;
      var b1: int64 := peek8(self.code + ch + 1) as int64;
      var b2: int64 := peek8(self.code + ch + 2) as int64;
      var b3: int64 := peek8(self.code + ch + 3) as int64;
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + ch, contPos - ch - 4);
      ch := nextLink;
    }
    // Condition → rax
    self.cg_genExpr(self.cg_nc1(ni));
    // test rax, rax; jz loopTop  (if cond false → loop back)
    self.cg_paarAusrichten(self.codeLen, 9);               // #2244
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
    self.cg_e8(0x0F); self.cg_e8(0x84);                     // jz rel32
    self.cg_e32(loopTop - self.codeLen - 4);
    // exitPos: patch all break jumps here
    var bh: int64 := self.curBreakHead;
    while (bh != -1) {
      var b0: int64 := peek8(self.code + bh) as int64;
      var b1: int64 := peek8(self.code + bh + 1) as int64;
      var b2: int64 := peek8(self.code + bh + 2) as int64;
      var b3: int64 := peek8(self.code + bh + 3) as int64;
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + bh, self.codeLen - bh - 4);
      bh := nextLink;
    }
    // Restore outer loop lists
    self.curBreakHead := savedBreakHead;
    self.curContHead  := savedContHead;
  }

  // WP-BC-05: var a, b := fn()  — 2-value tuple destructure
  // SysV ABI: first return in rax, second in rdx.
  fn cg_genTupleVarDecl(ni: int64) {
    var name1: pchar := self.cg_nsval(ni);
    var len1:  int64 := self.cg_nslen(ni);
    var off1:  int64 := self.cg_addLocal(name1, len1);
    var idx1:  int64 := self.localCount - 1;

    var secondNode: int64 := self.cg_nc0(ni);
    var name2: pchar := self.cg_nsval(secondNode);
    var len2:  int64 := self.cg_nslen(secondNode);
    var off2:  int64 := self.cg_addLocal(name2, len2);
    var idx2:  int64 := self.localCount - 1;

    // #1122: Der Typ der beiden Namen steht nirgends im Quelltext -- die
    // Schreibweise `var a, b := F();` traegt keine Annotation. Ohne Vermerk
    // blieb der Slot typlos: `a.v` fand keine Klasse, bekam Feldoffset -1 und
    // lieferte still 0, obwohl der ZEIGER korrekt ankam. Also den deklarierten
    // Elementtyp des Aufgerufenen uebernehmen.
    var initNi: int64 := self.cg_nc1(ni);
    self.cg_applyTupleElemTypes(initNi, idx1, idx2);

    // #2075: Ein Tupel-AUSDRUCK `var a, b := (x, y);` ist kein Aufruf — er
    // legt ein Array-Literal an, und rdx traegt dabei nichts. Bis 1.2.13A
    // bekam a den Zeiger und b den Inhalt eines Registers. Die beiden Werte
    // werden hier direkt zugewiesen (y vor dem Speichern von x ausgewertet,
    // damit `var a, b := (b, a)`-artige Formen nicht ihr eigenes Ergebnis lesen).
    if (initNi >= 0 && self.cg_nkind(initNi) == 100) {
      var tE0: int64 := self.cg_nc0(initNi);
      var tE1: int64 := 0 - 1;
      if (tE0 >= 0) { tE1 := self.cg_nnext(tE0); }
      if (tE0 < 0 || tE1 < 0 || self.cg_nnext(tE1) >= 0) {
        EPrintStrLn("error: `var a, b := (...)` braucht genau zwei Elemente (#2075)"c);
        exit(1);
      }
      self.cg_genExpr(tE0);
      self.cg_pushRax();
      self.cg_genExpr(tE1);
      self.cg_storeRax(off2);
      self.cg_popRax();
      self.cg_storeRax(off1);
      return;
    }

    // Evaluate init (function call) → rax = first, rdx = second
    self.cg_genExpr(initNi);

    self.cg_storeRax(off1);
    self.cg_storeRdx(off2);
  }

  // #1122: Elementtypen des Tupel-Rueckgabetyps an den beiden entpackten
  // Namen vermerken. Ist der Aufgerufene unbekannt (Builtin, importiert, kein
  // Aufruf), bleibt es beim bisherigen Zustand -- die Slots bleiben typlos,
  // wie sie es vorher immer waren.
  fn cg_applyTupleElemTypes(initNi: int64, idx1: int64, idx2: int64) {
    if (initNi < 0) { return; }
    if (self.cg_nkind(initNi) != CGN_CALL) { return; }
    var entry: int64 := 0 - 1;
    var callKind: int64 := self.cg_nival(initNi);
    if (callKind == 0) {
      var tnLc: int64 := alloc(8);   // #2044
      var tnP: pchar := self.cg_callName(initNi, tnLc);
      entry := self.cg_findTupleRet(tnP, peek64(tnLc));
      free(tnLc, 8);
    } else if (callKind == 1) {
      // Methodenaufruf: der Eintrag steht unter "Klasse_Methode". Massgeblich
      // ist die Klasse, die die Methode DEKLARIERT (#1120) -- bei einer
      // geerbten Methode liegt der Rueckgabetyp beim Elternteil.
      var recvNi: int64 := self.cg_nc0(initNi);
      var recvCi: int64 := self.cg_exprClassName(recvNi);
      if (recvCi < 0 && recvNi >= 0 && self.cg_nkind(recvNi) == CGN_IDENT) {
        // `TypeName.M()`: der Empfaenger ist die KLASSE selbst, kein Wert —
        // cg_exprClassName findet dafuer nichts. Wie in cg_genCall gilt der
        // Name nur dann als Typ, wenn es keine gleichnamige lokale Variable gibt.
        if (self.cg_findLocalIdx(self.cg_nsval(recvNi), self.cg_nslen(recvNi)) < 0) {
          recvCi := self.cg_findClass(self.cg_nsval(recvNi), self.cg_nslen(recvNi));
        }
      }
      if (recvCi < 0) { return; }
      var ownCi: int64 := self.cg_findMethodOwner(recvCi, self.cg_nsval(initNi), self.cg_nslen(initNi));
      if (ownCi >= 0) { recvCi := ownCi; }
      var lc: int64 := alloc(8);
      var mb: int64 := self.cg_buildMethodMangled(recvCi, self.cg_nsval(initNi), self.cg_nslen(initNi), lc);
      var mbLen: int64 := peek64(lc);
      free(lc, 8);
      entry := self.cg_findTupleRet(mb as pchar, mbLen);
      self.cg_trackTempBuf(mb, mbLen + 1);
    }
    if (entry < 0) { return; }
    self.cg_setLocalType(idx1, peek64(entry + 16) as pchar, peek64(entry + 24));
    self.cg_setLocalType(idx2, peek64(entry + 32) as pchar, peek64(entry + 40));
  }

  // WP-EN-05: copy-unrolling for range-based for.
  // Each copy: cond → jz exit, body, step (continue lands before step).
  fn cg_genFor(ni: int64) {
    var savedForLocals: int64 := self.localCount;   // #2277
    var name: pchar := self.cg_nsval(ni);
    var nlen: int64 := self.cg_nslen(ni);
    var dir:  int64 := self.cg_nival(ni);  // 0=to, 1=downto
    var off:  int64 := self.cg_addLocal(name, nlen);
    // Init: v = start
    self.cg_genExpr(self.cg_nc0(ni));
    self.cg_storeRax(off);

    var U:              int64 := self.cg_unrollFactor();
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead:  int64 := self.curContHead;
    var allBreakHead:   int64 := -1;
    var jzHead:         int64 := -1;
    // #2206: Marke der Vektorarena — `for`, Rumpf in c2.
    var vecMarke: int64 := 1;   // 1 = keine Marke (Rahmenabstaende sind negativ)
    if (self.cg_vecRumpfLegtAnRumpf(self.cg_nc2(ni)) != 0
        && self.cg_vecEntkommtRumpf(self.cg_nc2(ni)) == 0) {
      vecMarke := self.cg_vecMarkeSetzen();
    }
    var loopTop:        int64 := self.codeLen;
    self.cg_vecMarkeZurueck(vecMarke);   // #2206

    var copy: int64 := 0;
    while (copy < U) {
      // Condition: v <= limit (to) or v >= limit (downto)
      self.cg_loadRax(off);
      self.cg_pushRax();
      self.cg_genExpr(self.cg_nc1(ni));
      self.cg_popRbx();  // rbx=v, rax=limit
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);  // cmp rbx, rax
      self.cg_e8(0x0F);
      if (dir == 0) { self.cg_e8(0x8F); }  // jg exit (v > limit)
      else          { self.cg_e8(0x8C); }  // jl exit (v < limit, downto)
      self.cg_e32(jzHead);
      jzHead := self.codeLen - 4;
      // Body
      self.curBreakHead := -1;
      self.curContHead  := -1;
      var savedMarkF: int64 := self.loopDeferMark;
      var savedTryMarkF: int64 := self.loopTryMark;   // #1148
      self.loopDeferMark := self.deferCount;
      self.loopTryMark   := self.tryDepth;   // #1148
      self.cg_genBlock(self.cg_nc2(ni));
      self.loopDeferMark := savedMarkF;
      self.loopTryMark   := savedTryMarkF;   // #1148
      // contPos: continue lands here, before step
      self.cg_patchList(self.curContHead, self.codeLen);
      allBreakHead := self.cg_mergeBreakList(allBreakHead, self.curBreakHead);
      // Step: v++ or v--
      self.cg_loadRax(off);
      if (dir == 0) { self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC0); }  // inc rax
      else          { self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC8); }  // dec rax
      self.cg_storeRax(off);
      copy += 1;
    }
    // jmp loopTop
    self.cg_paarAusrichten(self.codeLen, 5);   // #2244: Ruecksprung nicht ueber eine 32-Byte-Grenze
    self.cg_e8(0xE9);
    self.cg_e32(loopTop - self.codeLen - 4);
    // .exit
    var exitPos: int64 := self.codeLen;
    self.cg_patchList(jzHead, exitPos);
    self.cg_patchList(allBreakHead, exitPos);
    // #2277: Die Laufvariable ist BLOCKWEISE. Bis 1.2.21D blieb ihr
    // Eintrag in der Lokalenliste stehen und verdeckte fuer den Rest der
    // Funktion eine gleichnamige aeussere Variable:
    //
    //   var i: int64 := 40;  for i in 0..3 { }  PrintLn(i)   ->  4
    //
    // Gedruckt wurde die Schleifenvariable, nicht das aeussere i. Die
    // IR-Ziele (lowerRangeFor, seit #2270) legen dafuer eine eigene Variable
    // an und lassen das aeussere unberuehrt — ein Programm gab also je nach
    // Ziel 4 oder 40 aus. Festgelegt gilt die blockweise Lesart (ebnf.md):
    // das aeussere i bleibt, was es war. sema sieht es ohnehin so, denn OHNE
    // aeussere Variable ist der Name nach der Schleife unbekannt.
    //
    // Der Rahmenplatz bleibt vergeben (frameSize waechst weiter) — nur der
    // NAME wird wieder unsichtbar, genau wie cg_genBlock es am Blockende tut.
    self.localCount := savedForLocals;
    self.curBreakHead := savedBreakHead;
    self.curContHead  := savedContHead;
  }

  // for i in range([start,] stop) { }
  //
  // Wie cg_genFor, aber mit AUSSCHLIESSENDER Obergrenze: `to` laeuft bis
  // einschliesslich limit, `range` bis stop-1. Der Abbruch prueft daher
  // v >= stop (jge) statt v > limit (jg).
  //
  // Der Knoten wurde von Parser und sema erzeugt bzw. geprueft, hier aber nie
  // behandelt -- er fiel in den Catch-all am Ende von cg_genStmt und
  // verschwand spurlos. `for i in range(5) { s := s + i; }` liess s deshalb
  // unveraendert (Issue #1007).
  fn cg_genForRange(ni: int64) {
    var savedForLocals: int64 := self.localCount;   // #2277
    var name: pchar := self.cg_nsval(ni);
    var nlen: int64 := self.cg_nslen(ni);
    var off:  int64 := self.cg_addLocal(name, nlen);
    // Init: v = start
    self.cg_genExpr(self.cg_nc0(ni));
    self.cg_storeRax(off);

    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead:  int64 := self.curContHead;
    var allBreakHead:   int64 := -1;
    var jzHead:         int64 := -1;
    // #2206: Marke der Vektorarena — `for ... in a..b`, Rumpf in c2.
    var vecMarke: int64 := 1;   // 1 = keine Marke (Rahmenabstaende sind negativ)
    if (self.cg_vecRumpfLegtAnRumpf(self.cg_nc2(ni)) != 0
        && self.cg_vecEntkommtRumpf(self.cg_nc2(ni)) == 0) {
      vecMarke := self.cg_vecMarkeSetzen();
    }
    var loopTop:        int64 := self.codeLen;
    self.cg_vecMarkeZurueck(vecMarke);   // #2206

    // Bedingung: v < stop, sonst raus
    self.cg_loadRax(off);
    self.cg_pushRax();
    self.cg_genExpr(self.cg_nc1(ni));
    self.cg_popRbx();  // rbx = v, rax = stop
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);  // cmp rbx, rax
    self.cg_e8(0x0F); self.cg_e8(0x8D);                    // jge exit
    self.cg_e32(jzHead);
    jzHead := self.codeLen - 4;

    // Rumpf
    self.curBreakHead := -1;
    self.curContHead  := -1;
    var savedMarkG: int64 := self.loopDeferMark;
    var savedTryMarkG: int64 := self.loopTryMark;   // #1148
    self.loopDeferMark := self.deferCount;
    self.loopTryMark   := self.tryDepth;   // #1148
    self.cg_genBlock(self.cg_nc2(ni));
    self.loopDeferMark := savedMarkG;
    self.loopTryMark   := savedTryMarkG;   // #1148
    self.cg_patchList(self.curContHead, self.codeLen);
    allBreakHead := self.cg_mergeBreakList(allBreakHead, self.curBreakHead);

    // Schritt: v++
    self.cg_loadRax(off);
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC0);  // inc rax
    self.cg_storeRax(off);

    self.cg_paarAusrichten(self.codeLen, 5);   // #2244: Ruecksprung nicht ueber eine 32-Byte-Grenze
    self.cg_e8(0xE9);
    self.cg_e32(loopTop - self.codeLen - 4);

    var exitPos: int64 := self.codeLen;
    self.cg_patchList(jzHead, exitPos);
    self.cg_patchList(allBreakHead, exitPos);
    // #2277: Laufvariable blockweise — DIESELBE Festlegung wie in
    // cg_genFor, dort steht die Begruendung. Die drei for-Formen (to/downto,
    // Bereich, C-artig) muessen uebereinstimmen.
    self.localCount := savedForLocals;
    self.curBreakHead := savedBreakHead;
    self.curContHead  := savedContHead;
  }

  // ------------------------------------------------------------------
  // C-style for loop code generation
  // NK_FOR_C: c0=NK_VAR_DECL(init), c1=cond, c2=step, c3=body
  // ------------------------------------------------------------------
  // WP-EN-05: copy-unrolling for C-style for (init; cond; step) { body }.
  // Each copy: cond → jz exit, body, step (continue lands before step).
  fn cg_genForC(ni: int64) {
    var savedForLocals: int64 := self.localCount;   // #2277
    // Init: declare and initialize the loop variable
    var initNi: int64 := self.cg_nc0(ni);
    if (initNi >= 0) {
      var name: pchar := self.cg_nsval(initNi);
      var nlen: int64 := self.cg_nslen(initNi);
      var off:  int64 := self.cg_addLocal(name, nlen);
      var initExpr: int64 := self.cg_nc1(initNi);
      if (initExpr >= 0) {
        self.cg_genExpr(initExpr);
        self.cg_storeRax(off);
      }
    }

    var U:              int64 := self.cg_unrollFactor();
    var savedBreakHead: int64 := self.curBreakHead;
    var savedContHead:  int64 := self.curContHead;
    var allBreakHead:   int64 := -1;
    var jzHead:         int64 := -1;
    var condNi:         int64 := self.cg_nc1(ni);
    var stepNi:         int64 := self.cg_nc2(ni);
    var bodyNi:         int64 := self.cg_nc3(ni);
    // #2206: Marke der Vektorarena — `for (init; cond; step)`, Rumpf in c3.
    var vecMarke: int64 := 1;   // 1 = keine Marke (Rahmenabstaende sind negativ)
    if (self.cg_vecRumpfLegtAnRumpf(self.cg_nc3(ni)) != 0
        && self.cg_vecEntkommtRumpf(self.cg_nc3(ni)) == 0) {
      vecMarke := self.cg_vecMarkeSetzen();
    }
    var loopTop:        int64 := self.codeLen;
    self.cg_vecMarkeZurueck(vecMarke);   // #2206

    var copy: int64 := 0;
    while (copy < U) {
      // Condition (optional — absent means infinite loop)
      if (condNi >= 0) {
        self.cg_genSprungWennFalsch(condNi);   // #2114: test/jz oder j(nicht cc)
        self.cg_e32(jzHead);
        jzHead := self.codeLen - 4;
      }
      // Body
      self.curBreakHead := -1;
      self.curContHead  := -1;
      var savedMarkC: int64 := self.loopDeferMark;
      var savedTryMarkC: int64 := self.loopTryMark;   // #1148
      self.loopDeferMark := self.deferCount;
      self.loopTryMark   := self.tryDepth;   // #1148
      if (bodyNi >= 0) { self.cg_genBlock(bodyNi); }
      self.loopDeferMark := savedMarkC;
      self.loopTryMark   := savedTryMarkC;   // #1148
      // contPos: continue lands here, before step
      self.cg_patchList(self.curContHead, self.codeLen);
      allBreakHead := self.cg_mergeBreakList(allBreakHead, self.curBreakHead);
      // Step
      if (stepNi >= 0) { self.cg_genStmt(stepNi); }
      copy += 1;
    }
    // jmp loopTop
    self.cg_paarAusrichten(self.codeLen, 5);   // #2244: Ruecksprung nicht ueber eine 32-Byte-Grenze
    self.cg_e8(0xE9);
    self.cg_e32(loopTop - self.codeLen - 4);
    // .exit
    var exitPos: int64 := self.codeLen;
    self.cg_patchList(jzHead, exitPos);
    self.cg_patchList(allBreakHead, exitPos);
    // #2277: Laufvariable blockweise — DIESELBE Festlegung wie in
    // cg_genFor, dort steht die Begruendung. Die drei for-Formen (to/downto,
    // Bereich, C-artig) muessen uebereinstimmen.
    self.localCount := savedForLocals;
    self.curBreakHead := savedBreakHead;
    self.curContHead  := savedContHead;
  }

  // ------------------------------------------------------------------
  // Switch/case code generation (WP-10c)
  // ------------------------------------------------------------------
  // AST: NK_SWITCH { nc0=subject, nc1=first_case }
  //      NK_CASE  { ival=0/1, nc0=value(if !default), nc1=body_block }
  // Strategy: linear if-else chain; default case runs last.
  // Implicit jmp after each case body uses the curBreakHead linked list,
  // so explicit break statements and implicit end-of-case jumps are both
  // patched to the switch_end at once.
  // ------------------------------------------------------------------

  fn cg_genSwitch(ni: int64) {
    // Allocate a temp local to hold the subject value
    var swVar: pchar := "__sw__";
    var swOff: int64 := self.cg_addLocal(swVar, 6);
    self.cg_genExpr(self.cg_nc0(ni));
    self.cg_storeRax(swOff);

    // Save and reset break list (shared between explicit break and implicit case exit)
    var savedBreakHead: int64 := self.curBreakHead;
    self.curBreakHead := -1;

    // #1118: Ein `break` im switch-Zweig verlaesst diesen Zweig — seine defers
    // laufen davor, genau wie beim Schleifen-break (#1006). Der Compiler
    // ERZWINGT `break` oder `return` in jedem Zweig ("switch case may fall
    // through"), der fehleranfaellige Pfad war also der vorgeschriebene.
    var savedSwMark: int64 := self.loopDeferMark;
    var savedTrySwMark: int64 := self.loopTryMark;   // #1148
    self.loopDeferMark := self.deferCount;
    self.loopTryMark   := self.tryDepth;   // #1148

    var defaultCaseNode: int64 := -1;
    var caseCur: int64 := self.cg_nc1(ni);
    while (caseCur != -1) {
      var isDefault: int64 := self.cg_nival(caseCur);
      if (isDefault != 0) {
        defaultCaseNode := caseCur;
      } else {
        // subject → rbx, case value → rax
        self.cg_loadRax(swOff);
        self.cg_pushRax();
        self.cg_genExpr(self.cg_nc0(caseCur));
        self.cg_popRbx();
        // cmp rbx, rax; jne skip_case (rel32)
        self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
        self.cg_e8(0x0F); self.cg_e8(0x85);
        var jnePos: int64 := self.codeLen;
        self.cg_e32(0);
        // Execute case body
        self.cg_genBlock(self.cg_nc1(caseCur));
        // Implicit jmp to switch_end (linked into break list)
        self.cg_e8(0xE9);
        var bp: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bp;
        // Patch jne to next case
        poke32(self.code + jnePos, self.codeLen - jnePos - 4);
      }
      caseCur := self.cg_nnext(caseCur);
    }

    // Default case executes last if no other case matched
    if (defaultCaseNode != -1) {
      self.cg_genBlock(self.cg_nc1(defaultCaseNode));
      // Implicit jmp to switch_end
      self.cg_e8(0xE9);
      var bpd: int64 := self.codeLen;
      self.cg_e32(self.curBreakHead);
      self.curBreakHead := bpd;
    }

    // switch_end: patch all break/implicit-break jmps here
    var bh: int64 := self.curBreakHead;
    while (bh != -1) {
      var b0: int64 := peek8(self.code + bh);
      var b1: int64 := peek8(self.code + bh + 1);
      var b2: int64 := peek8(self.code + bh + 2);
      var b3: int64 := peek8(self.code + bh + 3);
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + bh, self.codeLen - bh - 4);
      bh := nextLink;
    }
    self.curBreakHead := savedBreakHead;
    self.loopDeferMark := savedSwMark;   // #1118
    self.loopTryMark   := savedTrySwMark;   // #1148
  }

  // WP-15: Generate match statement (like switch but for pattern matching)
  // WP-BC-11: emit comparison for one or-pattern alternative; link je-body into self.orBodyHead
  fn cg_emitOrAlt(matchOff: int64, altPat: int64) {
    if (self.cg_nkind(altPat) == CGN_PATTERN_OR) {
      self.cg_emitOrAlt(matchOff, self.cg_nc0(altPat));
      self.cg_emitOrAlt(matchOff, self.cg_nc1(altPat));
    } else if (self.cg_nkind(altPat) == CGN_PATTERN_RANGE) {
      // #1113: `case 0..9 | 20..29 =>`. Anders als der Gleichheitsvergleich
      // braucht ein Bereich ZWEI Vergleiche, und der Treffer-Sprung darf erst
      // fallen, wenn beide zusagen. Deshalb zuerst ueber die Alternative
      // hinwegspringen, wenn eine Grenze verletzt ist.
      var oLo: int64 := self.cg_nival(altPat);
      var oHiN: int64 := self.cg_nc1(altPat);
      self.cg_loadRax(matchOff);
      self.cg_e8(0x48); self.cg_e8(0x3D); self.cg_e32(oLo);      // cmp rax, lo
      self.cg_e8(0x0F); self.cg_e8(0x8C);                          // jl  weiter
      var ojLo: int64 := self.codeLen; self.cg_e32(0);
      var ojHi: int64 := 0 - 1;
      if (oHiN >= 0) {
        self.cg_e8(0x48); self.cg_e8(0x3D); self.cg_e32(self.cg_nival(oHiN));
        self.cg_e8(0x0F); self.cg_e8(0x8F);                        // jg  weiter
        ojHi := self.codeLen; self.cg_e32(0);
      }
      // Getroffen: in die Trefferkette einhaengen (unbedingter Sprung).
      self.cg_e8(0xE9);
      var oHit: int64 := self.codeLen;
      self.cg_e32(self.orBodyHead);
      self.orBodyHead := oHit;
      poke32(self.code + ojLo, self.codeLen - ojLo - 4);
      if (ojHi >= 0) { poke32(self.code + ojHi, self.codeLen - ojHi - 4); }
    } else {
      self.cg_loadRax(matchOff);
      self.cg_pushRax();
      // #1024: Hier stand noch die alte Unterscheidung `ival != 0`, die #1020
      // im Hauptmuster laengst ersetzt hat — und der Bezeichner wurde nur in
      // den Locals gesucht, nicht in der Konstantentabelle. Enum-Mitglieder
      // trafen damit NIE; `case R | B` traf ausgerechnet R, weil der
      // Fehlschlagpfad 0 lud und R zufaellig 0 ist. Jetzt dieselbe Aufloesung
      // wie im Hauptmuster: unterschieden wird an der NAMENSLAENGE.
      var pl: int64 := self.cg_nslen(altPat);
      if (pl == 0) {
        self.cg_movRaxImm(self.cg_nival(altPat));
      } else {
        var pn: pchar := self.cg_nsval(altPat);
        var po: int64 := self.cg_findLocal(pn, pl);
        if (po != 0) {
          self.cg_loadRax(po);
        } else if (self.cg_hasConVal(pn, pl) != 0) {
          self.cg_movRaxImm(self.cg_findConVal(pn, pl));
        } else {
          EPrintStr("error: codegen: match-Muster ist weder Konstante noch "c);
          EPrintStr("lokale Variable: "c);
          var pc: int64 := 0;
          while (pc < pl) { PrintChar(StrCharAt(pn, pc)); pc := pc + 1; }
          EPrintStrLn(""c);
          exit(70);
        }
      }
      self.cg_popRbx();
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);   // cmp rbx, rax
      self.cg_e8(0x0F); self.cg_e8(0x84);                       // je rel32
      var jePos: int64 := self.codeLen;
      self.cg_e32(self.orBodyHead);
      self.orBodyHead := jePos;
    }
  }

  // #1024: Rumpf eines match-Falls emittieren. Ein Ausdruck laesst seinen Wert
  // in rax; ein BLOCK wird als Anweisungsfolge erzeugt und liefert den Wert
  // seiner letzten Anweisung, sofern das ein Ausdruck ist — sonst 0. Damit
  // bleibt `match` in beiden Rollen brauchbar: als Anweisung mit mehreren
  // Schritten je Zweig, und als Ausdruck mit einem Wert.
  fn cg_genMatchBody(bodyNode: int64) {
    if (bodyNode < 0) { self.cg_zeroRax(); return; }
    if (self.cg_nkind(bodyNode) != CGN_BLOCK) {
      self.cg_genExpr(bodyNode);
      return;
    }
    var savedLocals: int64 := self.localCount;
    var savedDefers: int64 := self.deferCount;
    var stmt: int64 := self.cg_nc0(bodyNode);
    if (stmt < 0) { self.cg_zeroRax(); return; }
    while (stmt != -1) {
      var nxt: int64 := self.cg_nnext(stmt);
      if (nxt == -1 && self.cg_nkind(stmt) == CGN_EXPR_STMT) {
        // letzte Anweisung ist ein Ausdruck → sein Wert ist der Wert des Blocks
        self.cg_genExpr(self.cg_nc0(stmt));
      } else {
        self.cg_genStmt(stmt);
        if (nxt == -1) { self.cg_zeroRax(); }
      }
      stmt := nxt;
    }
    self.cg_emitDefersDownTo(savedDefers);
    self.deferCount := savedDefers;
    self.localCount := savedLocals;
  }

  fn cg_genMatch(ni: int64) {
    // c0 = discriminant expression, c1 = cases (next-linked)
    // Allocate a temp local to hold the subject value
    var matchVar: pchar := "__match__";
    var matchOff: int64 := self.cg_addLocal(matchVar, 8);
    self.cg_genExpr(self.cg_nc0(ni));
    self.cg_storeRax(matchOff);

    // Save and reset break list
    var savedBreakHead: int64 := self.curBreakHead;
    self.curBreakHead := -1;

    // #1118: wie beim switch — ein `break` im Zweig verlaesst nur diesen Zweig.
    var savedSwMark: int64 := self.loopDeferMark;
    var savedTrySwMark: int64 := self.loopTryMark;   // #1148
    self.loopDeferMark := self.deferCount;
    self.loopTryMark   := self.tryDepth;   // #1148

    var defaultCaseNode: int64 := -1;
    var caseCur: int64 := self.cg_nc1(ni);  // first match case
    while (caseCur != -1) {
      // c0 = pattern, c1 = body expression, c2 = guard (or -1)
      var patNode: int64 := self.cg_nc0(caseCur);
      var bodyNode: int64 := self.cg_nc1(caseCur);
      var guardNode: int64 := self.cg_nc2(caseCur);
      var patKind: int64 := self.cg_nkind(patNode);

      // WP-BC-11: or-pattern — try each alternative; if any matches, jmp to body
      if (patKind == CGN_PATTERN_OR) {
        var savedOrBodyHead: int64 := self.orBodyHead;
        self.orBodyHead := -1;
        self.cg_emitOrAlt(matchOff, patNode);   // emit je-body for each alt
        // No alternative matched → jmp next_case
        self.cg_e8(0xE9);
        var jmpNextCase: int64 := self.codeLen;
        self.cg_e32(0);
        // Patch all je-body jumps → current position (body entry)
        var oh: int64 := self.orBodyHead;
        while (oh != -1) {
          var lnk: int64 := peek8(self.code + oh) + peek8(self.code + oh + 1) * 256 + peek8(self.code + oh + 2) * 65536 + peek8(self.code + oh + 3) * 16777216;
          if (lnk >= 2147483648) { lnk := lnk - 4294967296; }
          poke32(self.code + oh, self.codeLen - oh - 4);
          oh := lnk;
        }
        self.orBodyHead := savedOrBodyHead;
        // Guard check (if present)
        var guardFailPos: int64 := -1;
        if (guardNode >= 0) {
          self.cg_genSprungWennFalsch(guardNode);   // #2114: test/jz oder j(nicht cc)
          guardFailPos := self.codeLen;
          self.cg_e32(0);
        }
        self.cg_genMatchBody(bodyNode);
        self.cg_e8(0xE9);
        var bpOR: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bpOR;
        // Patch next_case and guard_fail → here
        poke32(self.code + jmpNextCase, self.codeLen - jmpNextCase - 4);
        if (guardFailPos >= 0) { poke32(self.code + guardFailPos, self.codeLen - guardFailPos - 4); }

      // `case _ =>` trifft immer.
      //
      // OHNE Guard ist das der Default-Fall: er wird ans Ende gestellt, damit
      // die konkreten Faelle zuerst geprueft werden. (Frueher fiel der
      // Wildcard in den Vergleichszweig unten, wo sein ival 0 gegen den Wert
      // verglichen wurde -- `case _` traf damit ausgerechnet nur bei 0,
      // Issue #1008.)
      //
      // MIT Guard darf er das NICHT. #1080: Ein bedingter Arm ist kein
      // Default; er gehoert an SEINE Stelle in der Reihenfolge, sonst
      // verliert er gegen spaetere Faelle. Zudem gibt es nur EINEN
      // defaultCaseNode -- ein zweiter Wildcard ueberschrieb den ersten
      // stillschweigend, und genau das liess `case _ if <cond>` nie treffen,
      // sobald ein `case _` folgte. Beides ohne Fehlermeldung.
      } else if (patKind == CGN_PATTERN_WILD) {
        if (guardNode >= 0) {
          // Bedingter Wildcard: an Ort und Stelle auswerten wie ein normaler
          // Fall, dessen Muster immer passt.
          self.cg_genExpr(guardNode);
          self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
          self.cg_e8(0x0F); self.cg_e8(0x84);                       // jz next_case
          var wildGuardFail: int64 := self.codeLen;
          self.cg_e32(0);
          self.cg_genMatchBody(bodyNode);
          self.cg_e8(0xE9);
          var bpWG: int64 := self.codeLen;
          self.cg_e32(self.curBreakHead);
          self.curBreakHead := bpWG;
          poke32(self.code + wildGuardFail, self.codeLen - wildGuardFail - 4);
        } else {
          // Der ERSTE unbedingte Wildcard gewinnt; alles danach ist
          // unerreichbar und darf ihn nicht verdraengen.
          if (defaultCaseNode == -1) { defaultCaseNode := caseCur; }
        }
      } else if (patKind == CGN_PATTERN_STRUCT) {
        // WP-15 / #1104: Struktur-Muster `case P { t: 1, f: 0 } =>`.
        //
        // Das Muster passte IMMER. Zwei Fehler uebereinander: der Sprung bei
        // einem nicht passenden Feld wurde auf die unmittelbar folgende
        // Anweisung gepatcht (er sprang also nirgendwohin), und der Vergleich
        // lief ohnehin nie an -- der Parser legt den Feldwert als AUSDRUCK ab
        // (NK_LIT_INT), gepruef wurde aber auf CGN_PATTERN_LIT. Ein `match`
        // mit mehreren Struktur-Fallen nahm damit stets den ersten, ohne
        // Meldung.
        //
        // sval = Typname, c0 = erstes Feldmuster (NK_PATTERN_BIND: sval =
        // Feldname, c0 = Wert bzw. Bindung).
        var structName: pchar := self.cg_nsval(patNode);
        var structLen: int64 := self.cg_nslen(patNode);
        var structOff: int64 := self.cg_findClass(structName, structLen);
        if (structOff < 0) {
          // Frueher: "unbekannter Typ → wie ein Wildcard behandeln". Damit
          // wurde ein vertippter Typname zum Default-Fall.
          EPrintStr("error: unbekannter Typ im Struktur-Muster: '"c);
          sys_write(2, structName, structLen);
          EPrintStr("'\n"c);
          exit(1);
        }
        var failHead: int64 := 0 - 1;
        var fieldPat: int64 := self.cg_nc0(patNode);
        while (fieldPat != -1) {
          var fieldName: pchar := self.cg_nsval(fieldPat);
          var fieldLen: int64 := self.cg_nslen(fieldPat);
          var innerPat: int64 := self.cg_nc0(fieldPat);
          var fldOff: int64 := self.cg_findField(structOff, fieldName, fieldLen);
          if (fldOff < 0) {
            EPrintStr("error: unbekanntes Feld im Struktur-Muster: '"c);
            sys_write(2, fieldName, fieldLen);
            EPrintStr("'\n"c);
            exit(1);
          }
          // Feldwert laden: rax = [struct + fldOff]
          self.cg_loadRax(matchOff);
          if (fldOff == 0) {
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x00);
          } else if (fldOff <= 127) {
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40); self.cg_e8(fldOff);
          } else {
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80); self.cg_e32(fldOff);
          }
          var innerKind: int64 := self.cg_nkind(innerPat);
          var cmpVal: int64 := 0;
          var doCmp: int64 := 0;
          if (innerKind == CGN_LIT_INT) {
            cmpVal := self.cg_nival(innerPat); doCmp := 1;
          } else if (innerKind == CGN_IDENT) {
            var inm: pchar := self.cg_nsval(innerPat);
            var inl: int64 := self.cg_nslen(innerPat);
            if (inl == 1 && StrCharAt(inm, 0) == 95) {
              doCmp := 0;               // `_` — Feld wird nicht geprueft
            } else if (self.cg_hasConVal(inm, inl) != 0) {
              // Ein blanker Bezeichner ist ein VERWEIS, wenn er einen kennt --
              // dieselbe Lesart wie beim Enum-Muster (#1024).
              cmpVal := self.cg_findConVal(inm, inl); doCmp := 1;
            } else {
              // sonst: Bindung, das Feld wird an den Namen gebunden
              var bindOff: int64 := self.cg_addLocal(inm, inl);
              self.cg_storeRax(bindOff);
              doCmp := 0;
            }
          } else if (innerKind == CGN_PATTERN_WILD) {
            doCmp := 0;
          } else {
            EPrintStrLn("error: Feldmuster muss ein Ganzzahlliteral, ein `con`, ein Name oder `_` sein"c);
            exit(1);
          }
          if (doCmp != 0) {
            self.cg_e8(0x48); self.cg_e8(0xB9); self.cg_e64(cmpVal);   // mov rcx, wert
            self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);      // cmp rax, rcx
            self.cg_e8(0x0F); self.cg_e8(0x85);                        // jne -> naechster Fall
            self.cg_e32(failHead);
            failHead := self.codeLen - 4;
          }
          fieldPat := self.cg_nnext(fieldPat);
        }
        // Alle Felder passen: Rumpf, dann ans Ende des match.
        self.cg_genMatchBody(bodyNode);
        self.cg_e8(0xE9);
        var bp2: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bp2;
        // Fehlschlaege springen HIERHER -- an den naechsten Fall, nicht auf
        // die naechste Anweisung.
        self.cg_patchList(failHead, self.codeLen);

      } else if (patKind == CGN_PATTERN_TUPLE) {
        // #1250: `case (1, 2)`. Ein Tupel-Ausdruck `(a, b)` ist in Lyx
        // dasselbe wie ein Array-Literal: Kopf {cap,len}, dann die Elemente.
        // Geprueft wird deshalb zuerst die LAENGE — ein Muster mit zwei
        // Teilen darf nicht auf ein dreielementiges Tupel passen — und danach
        // Element fuer Element. `_` laesst seine Stelle aus.
        //
        // Vorher gab es das Muster nicht: der Parser meldete `expected =>,
        // got (` und nannte damit die Klammer statt der fehlenden Sache.
        var tupCount: int64 := self.cg_nival(patNode);
        var tupFail: int64 := 0 - 1;
        // Laenge vergleichen: rax = [subject + 8]
        self.cg_loadRax(matchOff);
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40); self.cg_e8(0x08);  // mov rax,[rax+8]
        self.cg_e8(0x48); self.cg_e8(0xB9); self.cg_e64(tupCount);               // mov rcx, n
        self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);                    // cmp rax, rcx
        self.cg_e8(0x0F); self.cg_e8(0x85); self.cg_e32(tupFail);                // jne -> naechster Fall
        tupFail := self.codeLen - 4;
        var tupElem: int64 := self.cg_nc0(patNode);
        var tupIdx: int64 := 0;
        while (tupElem != -1) {
          var teKind: int64 := self.cg_nkind(tupElem);
          var teCmp: int64 := 0;
          var teVal: int64 := 0;
          if (teKind == CGN_PATTERN_LIT) {
            teVal := self.cg_nival(tupElem); teCmp := 1;
          } else if (teKind == CGN_IDENT) {
            var teNm: pchar := self.cg_nsval(tupElem);
            var teNl: int64 := self.cg_nslen(tupElem);
            if (self.cg_hasConVal(teNm, teNl) != 0) {
              teVal := self.cg_findConVal(teNm, teNl); teCmp := 1;
            } else {
              // Wie beim Struktur- und beim Bezeichner-Muster: ein blanker
              // Name ist ein VERWEIS. Benennt er nichts, wird das gemeldet —
              // eine Bindung gibt es in Mustern nicht (ebnf.md 14).
              EPrintStr("error: unbekannter Name im Tupel-Muster: '"c);
              sys_write(2, teNm as int64, teNl);
              EPrintStrLn("'"c);
              exit(1);
            }
          } else if (teKind == CGN_PATTERN_WILD) {
            teCmp := 0;
          } else {
            EPrintStrLn("error: Tupel-Muster: Teilmuster muss ein Ganzzahlliteral, ein `con` oder `_` sein"c);
            exit(1);
          }
          if (teCmp != 0) {
            // rax = [subject + 16 + idx*8]  (16 = {cap,len}-Kopf)
            self.cg_loadRax(matchOff);
            var teOff: int64 := 16 + tupIdx * 8;
            if (teOff <= 127) {
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40); self.cg_e8(teOff);
            } else {
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80); self.cg_e32(teOff);
            }
            self.cg_e8(0x48); self.cg_e8(0xB9); self.cg_e64(teVal);              // mov rcx, wert
            self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);                // cmp rax, rcx
            self.cg_e8(0x0F); self.cg_e8(0x85); self.cg_e32(tupFail);            // jne -> naechster Fall
            tupFail := self.codeLen - 4;
          }
          tupIdx := tupIdx + 1;
          tupElem := self.cg_nnext(tupElem);
        }
        self.cg_genMatchBody(bodyNode);
        self.cg_e8(0xE9);
        var bpTup: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bpTup;
        self.cg_patchList(tupFail, self.codeLen);

      } else if (patKind == CGN_PATTERN_ENUM) {
        // BUG-08: Enum payload pattern: Ok(value) or Err(msg)
        // sval = enum variant name, c0 = binding pattern for payload
        var varName: pchar := self.cg_nsval(patNode);
        var varLen: int64 := self.cg_nslen(patNode);

        // Find the variant tag across all enums
        var foundTag: int64 := -1;
        var payloadSize: int64 := 0;
        var ei: int64 := 0;
        while (ei < self.enumCount) {
          var tagInfo: int64 := self.cg_findEnumVariant(ei, varName, varLen);
          if (tagInfo >= 0) {
            foundTag := tagInfo & 0xFFFFFFFF;
            payloadSize := tagInfo >> 32;
            break;
          }
          ei += 1;
        }

        if (foundTag >= 0) {
          // Load subject value (tag is in lower 32 bits)
          self.cg_loadRax(matchOff);
          self.cg_pushRax();  // save subject for payload extraction

          // Compare subject tag with variant tag
          // mov rax, subject_tag (already in rax)
          // cmp rax, foundTag
          self.cg_e8(0x48); self.cg_e8(0x3D);
          self.cg_e32(foundTag);
          // jne skip_case
          self.cg_e8(0x0F); self.cg_e8(0x85);
          var jnePos: int64 := self.codeLen;
          self.cg_e32(0);

          // Tags match — extract payload bindings if present
          var bindPat: int64 := self.cg_nc0(patNode);
          var bindIdx: int64 := 0;
          while (bindPat != -1) {
            var bindName: pchar := self.cg_nsval(bindPat);
            var bindLen: int64 := self.cg_nslen(bindPat);
            // Payload is at subject + 8 (after tag) + bindIdx * 8
            self.cg_popRax();
            self.cg_pushRax();
            // mov rax, [rax + 8 + bindIdx*8]
            var payOff: int64 := 8 + bindIdx * 8;
            if (payOff <= 127) {
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40);
              self.cg_e8(payOff);
            } else {
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80);
              self.cg_e32(payOff);
            }
            // Store payload value in local variable
            var bindLocalOff: int64 := self.cg_addLocal(bindName, bindLen);
            self.cg_storeRax(bindLocalOff);
            self.cg_pushRax();  // restore subject for next binding
            bindIdx += 1;
            bindPat := self.cg_nnext(bindPat);
          }
          self.cg_popRax();  // discard saved subject

          // Execute case body
          self.cg_genMatchBody(bodyNode);
          // Implicit jmp to match_end
          self.cg_e8(0xE9);
          var bp: int64 := self.codeLen;
          self.cg_e32(self.curBreakHead);
          self.curBreakHead := bp;

          // Patch jne to next case
          poke32(self.code + jnePos, self.codeLen - jnePos - 4);
        } else {
          // Unknown variant — treat as wildcard/default
          defaultCaseNode := caseCur;
        }
      } else if (patKind == CGN_PATTERN_RANGE) {
        // #1113: `case lo..hi =>` bzw. `case lo.. =>`. Zwei Vergleiche statt
        // einem — die OR-Liste waere bei `0..500` 501 Alternativen, und eine
        // if-Kette nimmt `match` genau den Vorteil, fuer den es da ist.
        var rLo: int64 := self.cg_nival(patNode);
        var rHiNode: int64 := self.cg_nc1(patNode);
        self.cg_loadRax(matchOff);
        // cmp rax, lo; jl next_case
        self.cg_e8(0x48); self.cg_e8(0x3D); self.cg_e32(rLo);
        self.cg_e8(0x0F); self.cg_e8(0x8C);
        var rjLo: int64 := self.codeLen; self.cg_e32(0);
        var rjHi: int64 := 0 - 1;
        if (rHiNode >= 0) {
          // cmp rax, hi; jg next_case   — Grenzen einschliesslich, wie beim
          // Bereichstyp (#1082).
          self.cg_e8(0x48); self.cg_e8(0x3D); self.cg_e32(self.cg_nival(rHiNode));
          self.cg_e8(0x0F); self.cg_e8(0x8F);
          rjHi := self.codeLen; self.cg_e32(0);
        }
        var rGuardFail: int64 := 0 - 1;
        if (guardNode >= 0) {
          self.cg_genExpr(guardNode);
          self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
          self.cg_e8(0x0F); self.cg_e8(0x84);
          rGuardFail := self.codeLen; self.cg_e32(0);
        }
        self.cg_genMatchBody(bodyNode);
        self.cg_e8(0xE9);
        var bpR: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bpR;
        poke32(self.code + rjLo, self.codeLen - rjLo - 4);
        if (rjHi >= 0) { poke32(self.code + rjHi, self.codeLen - rjHi - 4); }
        if (rGuardFail >= 0) { poke32(self.code + rGuardFail, self.codeLen - rGuardFail - 4); }

      } else {
        // Load subject value, compare with pattern
        self.cg_loadRax(matchOff);
        self.cg_pushRax();
        // Ganzzahl-Literal und Bezeichner teilen sich NK_PATTERN_LIT; der
        // Parser setzt beim Literal nur ival, beim Bezeichner nur sVal.
        // Unterschieden wird deshalb an der NAMENSLAENGE -- die fruehere
        // Pruefung `ival != 0` hielt `case 0 =>` faelschlich fuer einen
        // Bezeichner.
        var patLen: int64 := self.cg_nslen(patNode);
        if (patLen == 0) {
          self.cg_movRaxImm(self.cg_nival(patNode));
        } else {
          var patName: pchar := self.cg_nsval(patNode);
          var patOff: int64 := self.cg_findLocal(patName, patLen);
          if (patOff != 0) {
            self.cg_loadRax(patOff);
          } else if (self.cg_hasConVal(patName, patLen) != 0) {
            // Konstante oder Enum-Mitglied
            self.cg_movRaxImm(self.cg_findConVal(patName, patLen));
          } else {
            // Weder lokale Variable noch Konstante: frueher wurde hier still 0
            // geladen, das Muster verglich also gegen 0 und traf praktisch nie.
            // Bindende Muster (`case x =>`, die jeden Wert annehmen und binden)
            // sind nicht umgesetzt -- ein blanker Bezeichner muss deshalb eine
            // Konstante, ein Enum-Mitglied oder eine lokale Variable benennen.
            EPrintStr("error: codegen: match-Muster ist weder Konstante noch "c);
            EPrintStr("lokale Variable: "c);
            var pc: int64 := 0;
            while (pc < patLen) { PrintChar(StrCharAt(patName, pc)); pc := pc + 1; }
            EPrintStrLn(""c);
            exit(70);
          }
        }
        self.cg_popRbx();
        // cmp rbx, rax; jne skip_case
        self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
        self.cg_e8(0x0F); self.cg_e8(0x85);
        var jnePos: int64 := self.codeLen;
        self.cg_e32(0);
        // WP-BC-11: guard check (c2 of case node)
        var guardFail2: int64 := -1;
        if (guardNode >= 0) {
          self.cg_genSprungWennFalsch(guardNode);   // #2114: test/jz oder j(nicht cc)
          guardFail2 := self.codeLen;
          self.cg_e32(0);
        }
        // Execute case body
        self.cg_genMatchBody(bodyNode);
        // Implicit jmp to match_end
        self.cg_e8(0xE9);
        var bp: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bp;
        // Patch jne (and guard fail) to next case
        poke32(self.code + jnePos, self.codeLen - jnePos - 4);
        if (guardFail2 >= 0) { poke32(self.code + guardFail2, self.codeLen - guardFail2 - 4); }
      }
      caseCur := self.cg_nnext(caseCur);
    }

    // Default/wildcard case executes last if no other case matched
    if (defaultCaseNode != -1) {
      var bodyNode: int64 := self.cg_nc1(defaultCaseNode);
      var defGuard: int64 := self.cg_nc2(defaultCaseNode);
      if (defGuard >= 0) {
        self.cg_genExpr(defGuard);
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x74);                                         // jz short (skip default)
        var defSkip: int64 := self.codeLen;
        self.cg_e8(0);
        self.cg_genMatchBody(bodyNode);
        self.cg_e8(0xE9);
        var bpDefG: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bpDefG;
        cg_patchRel8(self.code, defSkip, self.codeLen);
      } else {
        self.cg_genMatchBody(bodyNode);
        self.cg_e8(0xE9);
        var bpd: int64 := self.codeLen;
        self.cg_e32(self.curBreakHead);
        self.curBreakHead := bpd;
      }
    }

    // Durchfall: kein Fall hat getroffen und es gab keinen Default. Ohne dies
    // stuende in rax der Rest des letzten Vergleichs -- als Ausdruck ist das
    // ein undefinierter Wert. Die getroffenen Faelle springen hinter diese
    // Anweisung (die Sprungziele werden unten auf die dann aktuelle Position
    // gesetzt), sie laeuft also nur im Durchfall.
    self.cg_zeroRax();

    // match_end: patch all break/implicit jmps
    var bh: int64 := self.curBreakHead;
    while (bh != -1) {
      var b0: int64 := peek8(self.code + bh);
      var b1: int64 := peek8(self.code + bh + 1);
      var b2: int64 := peek8(self.code + bh + 2);
      var b3: int64 := peek8(self.code + bh + 3);
      var nextLink: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
      if (nextLink >= 2147483648) { nextLink := nextLink - 4294967296; }
      poke32(self.code + bh, self.codeLen - bh - 4);
      bh := nextLink;
    }
    self.curBreakHead := savedBreakHead;
    self.loopDeferMark := savedSwMark;   // #1118
    self.loopTryMark   := savedTrySwMark;   // #1148
  }

  // ------------------------------------------------------------------
  // Function declaration
  // ------------------------------------------------------------------

  // WP-EN-05: read the stored 4-byte linked-list link at `pos` in code buffer,
  // sign-extended to int64 (-1 = end-of-list sentinel).
  fn cg_readLink(pos: int64): int64 {
    var b0: int64 := peek8(self.code + pos) as int64;
    var b1: int64 := peek8(self.code + pos + 1) as int64;
    var b2: int64 := peek8(self.code + pos + 2) as int64;
    var b3: int64 := peek8(self.code + pos + 3) as int64;
    var v: int64 := b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
    if (v >= 2147483648) { v := v - 4294967296; }
    return v;
  }

  // WP-EN-05: walk a linked list of rel32 placeholders and patch each to
  // (target - pos - 4). `head` = first node offset, -1 = empty.
  fn cg_patchList(head: int64, target: int64) {
    var p: int64 := head;
    while (p != -1) {
      var nxt: int64 := self.cg_readLink(p);
      poke32(self.code + p, target - p - 4);
      p := nxt;
    }
  }

  // WP-EN-05: append `dst` to the tail of the `src` linked list and return
  // the new head.  The tail is the node whose stored link equals -1.
  // If `src` == -1 (empty), returns `dst` unchanged.
  fn cg_mergeBreakList(dst: int64, src: int64): int64 {
    if (src == -1) { return dst; }
    var p: int64 := src;
    while (true) {
      var nxt: int64 := self.cg_readLink(p);
      if (nxt == -1) {
        poke32(self.code + p, dst);
        return src;
      }
      p := nxt;
    }
    return src;
  }

  // ===========================================================================
  // #2192: VEX-Praefix. Schnitt 1 — der Encoder fuer sich, noch OHNE Nutzung.
  //
  // AVX2 wird erkannt (#2187) und nirgends emittiert: im ganzen Compiler gab
  // es kein einziges VEX-kodiertes Wort. Der Encoder ist die Voraussetzung
  // dafuer, und er wird hier zuerst allein nachgewiesen, weil ein falsch
  // gesetztes Bit keinen Fehler erzeugt, sondern einen ANDEREN gueltigen
  // Befehl. Bei der NEON-Tabelle aus #2185 waren vier von vier Woertern
  // falsch, und drei davon sahen wie gueltige Befehle aus; VEX hat sechs
  // Felder statt zweier.
  //
  // Aufbau (Intel SDM 2.3). Zwei Formen:
  //
  //   zweibyteig  C5 | ~R vvvv~ L pp
  //   dreibyteig  C4 | ~R ~X ~B mmmmm | W vvvv~ L pp
  //
  // Die kurze Form geht nur, wenn X und B unbenutzt sind, W = 0 ist und die
  // Opcode-Karte 0F lautet; sonst die lange. R, X, B und vvvv stehen
  // INVERTIERT im Praefix — ein Feld, das man vergisst zu invertieren,
  // adressiert ein anderes Register, ohne dass etwas auffaellt.
  //
  //   r, x, b   die oberen Registerbits (je 0 oder 1)
  //   vvvv      zweiter Quelloperand, 0..15 (bei unaeren Formen 0)
  //   l         0 = 128 Bit (xmm), 1 = 256 Bit (ymm)
  //   pp        0 = kein Praefix, 1 = 66, 2 = F3, 3 = F2
  //   mm        1 = 0F, 2 = 0F 38, 3 = 0F 3A
  //   w         wie REX.W
  // ===========================================================================
  fn cg_vexPrefix(r: int64, x: int64, b: int64, vvvv: int64,
                  l: int64, pp: int64, mm: int64, w: int64) {
    if (r < 0 || r > 1 || x < 0 || x > 1 || b < 0 || b > 1) {
      EPrintStrLn("interner fehler: cg_vexPrefix: r/x/b sind je 0 oder 1 (#2192)."c);
      exit(1);
    }
    if (vvvv < 0 || vvvv > 15) {
      EPrintStrLn("interner fehler: cg_vexPrefix: vvvv ausserhalb 0..15 (#2192)."c);
      exit(1);
    }
    if (l < 0 || l > 1 || pp < 0 || pp > 3 || mm < 1 || mm > 3 || w < 0 || w > 1) {
      EPrintStrLn("interner fehler: cg_vexPrefix: l/pp/mm/w ausserhalb des Bereichs (#2192)."c);
      exit(1);
    }
    var nv: int64 := (15 - vvvv) & 15;   // vvvv invertiert
    if (x == 0 && b == 0 && w == 0 && mm == 1) {
      // zweibyteige Form
      self.cg_e8(0xC5);
      self.cg_e8((((1 - r) & 1) << 7) | (nv << 3) | (l << 2) | pp);
      return;
    }
    self.cg_e8(0xC4);
    self.cg_e8((((1 - r) & 1) << 7) | (((1 - x) & 1) << 6) | (((1 - b) & 1) << 5) | mm);
    self.cg_e8((w << 7) | (nv << 3) | (l << 2) | pp);
  }

  // #2192: eine vollstaendige Register-Register-Form.
  //   dst   Zielregister 0..15      (ModRM.reg, oberes Bit nach VEX.R)
  //   src1  erster Quelloperand     (VEX.vvvv)
  //   src2  zweiter Quelloperand    (ModRM.rm, oberes Bit nach VEX.B)
  // Unaere Formen (nur dst und src2) geben src1 = 0 an.
  fn cg_vexOpRR(opcode: int64, dst: int64, src1: int64, src2: int64,
                l: int64, pp: int64, mm: int64, w: int64) {
    if (dst < 0 || dst > 15 || src1 < 0 || src1 > 15 || src2 < 0 || src2 > 15) {
      EPrintStrLn("interner fehler: cg_vexOpRR: Register ausserhalb 0..15 (#2192)."c);
      exit(1);
    }
    self.cg_vexPrefix(dst >> 3, 0, src2 >> 3, src1, l, pp, mm, w);
    self.cg_e8(opcode);
    self.cg_e8(0xC0 | ((dst & 7) << 3) | (src2 & 7));   // ModRM: reg-direkt
  }

  // #2192: Selbsttest des Encoders. Gibt je Zeile den erwarteten Befehl und
  // die erzeugten Bytes aus:
  //
  //   vaddps ymm0, ymm1, ymm2	c5 f4 58 c2
  //
  // tests/vex_encoder_test.sh liest die Bytes zurueck und laesst sie von
  // llvm-mc DISASSEMBLIEREN, statt sie mit einer Liste zu vergleichen, die
  // ich selbst getippt habe. Nur so ist belegt, dass die Kodierung den
  // gemeinten Befehl ergibt und nicht einen anderen gueltigen — und nur so
  // faellt eine ungueltige Kodierung ueberhaupt auf (llvm-mc nennt sie
  // ausdruecklich "invalid instruction encoding"; genau daran hing #2185).
  //
  // Die Tabelle deckt bewusst die Faelle ab, in denen sich Felder verwechseln
  // lassen: beide Praefixformen, hohe Register (R und B), alle drei
  // Opcode-Karten, W = 1, beide Breiten und die drei pp-Werte.
  pub fn cg_vexSelftest() {
    self.codeLen := 0;
    var von: int64 := 0;

    // -- zweibyteige Form, Karte 0F, pp = 0 --
    von := self.codeLen; self.cg_vexOpRR(0x58, 0, 1, 2, 1, 0, 1, 0);
    self.cg_vexZeile("vaddps ymm0, ymm1, ymm2"c, von);
    von := self.codeLen; self.cg_vexOpRR(0x58, 0, 1, 2, 0, 0, 1, 0);
    self.cg_vexZeile("vaddps xmm0, xmm1, xmm2"c, von);
    von := self.codeLen; self.cg_vexOpRR(0x5C, 3, 4, 5, 1, 0, 1, 0);
    self.cg_vexZeile("vsubps ymm3, ymm4, ymm5"c, von);
    von := self.codeLen; self.cg_vexOpRR(0x59, 6, 7, 1, 1, 0, 1, 0);
    self.cg_vexZeile("vmulps ymm6, ymm7, ymm1"c, von);
    von := self.codeLen; self.cg_vexOpRR(0x5E, 2, 3, 4, 1, 0, 1, 0);
    self.cg_vexZeile("vdivps ymm2, ymm3, ymm4"c, von);
    von := self.codeLen; self.cg_vexOpRR(0x10, 0, 0, 1, 1, 0, 1, 0);
    self.cg_vexZeile("vmovups ymm0, ymm1"c, von);

    // -- pp = 1 (66): die f64-Formen --
    von := self.codeLen; self.cg_vexOpRR(0x58, 0, 1, 2, 1, 1, 1, 0);
    self.cg_vexZeile("vaddpd ymm0, ymm1, ymm2"c, von);
    von := self.codeLen; self.cg_vexOpRR(0x5E, 1, 2, 3, 1, 1, 1, 0);
    self.cg_vexZeile("vdivpd ymm1, ymm2, ymm3"c, von);

    // -- pp = 2 (F3) und pp = 3 (F2): die skalaren Formen --
    von := self.codeLen; self.cg_vexOpRR(0x58, 0, 1, 2, 0, 2, 1, 0);
    self.cg_vexZeile("vaddss xmm0, xmm1, xmm2"c, von);
    von := self.codeLen; self.cg_vexOpRR(0x58, 0, 1, 2, 0, 3, 1, 0);
    self.cg_vexZeile("vaddsd xmm0, xmm1, xmm2"c, von);

    // -- hohe Register: erzwingen die dreibyteige Form ueber R bzw. B --
    von := self.codeLen; self.cg_vexOpRR(0x58, 8, 1, 2, 1, 0, 1, 0);
    self.cg_vexZeile("vaddps ymm8, ymm1, ymm2"c, von);
    von := self.codeLen; self.cg_vexOpRR(0x58, 0, 1, 10, 1, 0, 1, 0);
    self.cg_vexZeile("vaddps ymm0, ymm1, ymm10"c, von);
    von := self.codeLen; self.cg_vexOpRR(0x58, 12, 13, 14, 1, 0, 1, 0);
    self.cg_vexZeile("vaddps ymm12, ymm13, ymm14"c, von);

    // -- Karte 0F 38 (mm = 2): dort liegen die FMA-Formen (#2193) --
    von := self.codeLen; self.cg_vexOpRR(0xA8, 0, 1, 2, 1, 1, 2, 0);
    self.cg_vexZeile("vfmadd213ps ymm0, ymm1, ymm2"c, von);
    von := self.codeLen; self.cg_vexOpRR(0xA8, 0, 1, 2, 1, 1, 2, 1);
    self.cg_vexZeile("vfmadd213pd ymm0, ymm1, ymm2"c, von);

    // -- W = 1 auf Karte 0F (vpermilpd braucht sie nicht, vpsllq schon) --
    von := self.codeLen; self.cg_vexOpRR(0xF3, 0, 1, 2, 1, 1, 1, 1);
    self.cg_vexZeile("vpsllq ymm0, ymm1, xmm2"c, von);

    // -- VZEROUPPER --
    von := self.codeLen; self.cg_vexZeroupper();
    self.cg_vexZeile("vzeroupper"c, von);
  }

  // #2192: eine Zeile des Selbsttests — Name, Tabulator, Bytes in Hex.
  fn cg_vexZeile(name: pchar, von: int64) {
    PrintStr(name);
    PrintStr("\t"c);
    var i: int64 := von;
    while (i < self.codeLen) {
      var b: int64 := peek8(self.code + i) as int64;
      self.cg_vexHexByte(b);
      if (i + 1 < self.codeLen) { PrintStr(" "c); }
      i := i + 1;
    }
    PrintStr("\n"c);
  }

  fn cg_vexHexByte(b: int64) {
    var hi: int64 := (b >> 4) & 15;
    var lo: int64 := b & 15;
    self.cg_vexHexZiffer(hi);
    self.cg_vexHexZiffer(lo);
  }

  fn cg_vexHexZiffer(d: int64) {
    var buf: int64 := alloc(2);
    if (d < 10) { poke8(buf, 48 + d); } else { poke8(buf, 97 + d - 10); }
    poke8(buf + 1, 0);
    PrintStr(buf as pchar);
    free(buf, 2);
  }

  // #2192: VZEROUPPER. Gehoert zum Encoder und nicht zum spaeteren Vektorpfad,
  // weil die Regel dazu eine Eigenschaft der Kodierung ist: wer 256-Bit-Code
  // emittiert und vor der Rueckkehr in SSE-Code den oberen Teil nicht loescht,
  // zahlt den Zustandswechsel bei JEDEM folgenden SSE-Befehl — oft mehr, als
  // die breiten Vektoren eingebracht haben. VEX.128, kein Operand.
  fn cg_vexZeroupper() {
    self.cg_vexPrefix(0, 0, 0, 0, 0, 0, 1, 0);
    self.cg_e8(0x77);
  }

  // #2191: Deckt die wirksame CPU-Stufe die verlangte Faehigkeit?
  //
  // Die Stufen sind aufsteigend gedacht: avx2 kann alles, was sse4 kann. Wer
  // eine Stelle hinzufuegt, die mehr als den Grundbestand braucht, ruft
  // cg_cpuVerlange() — das scheitert LAUT, wenn die Stufe nicht reicht. Ein
  // Default, der stattdessen die schmalere Form emittiert, waere genau der
  // stille Fehler, den dieses Feld verhindern soll: der Code lief dann, waere
  // aber langsamer als zugesagt, und niemand haette es gemerkt.
  //
  // Der Grundbestand (Stufe 0) ist alles, was jedes x86-64 hat: SSE und SSE2
  // samt der packed-f32-Schleife, dazu BSWAP, ROL und ROR.
  fn cg_cpuHat(stufe: int64): int64 {
    if (self.fnCpuStufe >= stufe) { return 1; }
    return 0;
  }

  // #2191: wie cg_cpuHat, aber mit Abbruch und Begruendung. `was` benennt die
  // Faehigkeit so, wie sie in --target-cpu heisst, damit die Meldung sagt, was
  // zu tun ist.
  fn cg_cpuVerlange(stufe: int64, was: pchar) {
    if (self.cg_cpuHat(stufe) != 0) { return; }
    EPrintStr("error: codegen: diese Stelle braucht "c);
    EPrintStr(was);
    EPrintStrLn(", die Ziel-CPU deckt es nicht (#2191)."c);
    EPrintStr("  Entweder mit --target-cpu="c);
    EPrintStr(was);
    EPrintStrLn(" uebersetzen oder die Funktion mit @cpu(...) auszeichnen."c);
    EPrintStrLn("  Ohne Zusage darf hier nichts emittiert werden: auf einer aelteren CPU"c);
    EPrintStrLn("  endet der Befehl in SIGILL."c);
    exit(1);
  }

  // WP-EN-04: unroll factor for current function's energy level
  // Level 1→1, 2→2, 3→4, 4→4, 5→8
  fn cg_unrollFactor(): int64 {
    if (self.fnEnergyLevel <= 1) { return 1; }
    if (self.fnEnergyLevel == 2) { return 2; }
    if (self.fnEnergyLevel == 5) { return 8; }
    return 4;  // levels 3 and 4
  }

  // Verschachtelte fn-Deklaration für spätere Emission vormerken.
  fn cg_addPendingNested(ni: int64) {
    if (self.nestedCount >= self.nestedCap) {
      var nc: int64 := self.nestedCap * 2;
      var nb: int64 := alloc(nc * 8);
      memcpy(nb, self.nestedBuf, self.nestedCount * 8);
      self.nestedBuf := nb;
      self.nestedCap := nc;
    }
    poke64(self.nestedBuf + self.nestedCount * 8, ni);
    self.nestedCount += 1;
  }

  // Vorgemerkte verschachtelte Funktionen jetzt emittieren — NACH der äußeren,
  // damit deren Instruktionsstrom nicht in sie hineinläuft.
  //
  // Die Liste wird zuerst kopiert und geleert: cg_genFuncDecl ruft sich für den
  // Rumpf rekursiv wieder hier hinein und meldet dort ggf. eigene verschachtelte
  // Funktionen an (fn in fn). Ohne die Kopie würde man über einen Puffer
  // iterieren, der sich unter einem verändert.
  //
  // #2044: Auch am Ende einer METHODE. Bis 1.2.12A stand diese Ausgabe nur in
  // cg_genFuncDecl; die innere Funktion einer Methode wurde damit erst nach
  // der naechsten freien Funktion erzeugt — oder gar nicht, wenn keine mehr
  // folgte.
  fn cg_flushNested() {
    if (self.nestedCount > 0) {
      var cnt: int64 := self.nestedCount;
      var snap: int64 := alloc(cnt * 8);
      memcpy(snap, self.nestedBuf, cnt * 8);
      self.nestedCount := 0;
      var i: int64 := 0;
      while (i < cnt) {
        self.cg_genFuncDecl(peek64(snap + i * 8));
        i += 1;
      }
      free(snap, cnt * 8);
    }
  }

  // ------------------------------------------------------------------
  // #2044: Marken innerer Funktionen
  //
  // Eine innere Funktion bekam bis 1.2.12A ihren BLANKEN Namen als Marke. Zwei
  // gleichnamige innere Funktionen — oder eine innere und eine gleichnamige
  // auf Modulebene — ergaben dieselbe Marke, und jeder Aufruf traf die zuerst
  // angelegte. Fehlerfrei uebersetzt, falsches Ergebnis.
  //
  // Jetzt heisst sie "Aussen@innen" — wie im IR-Weg seit #2020; `@` kommt in
  // keinem Bezeichner vor. Welche Funktion ein Aufruf meint, entscheidet ein
  // Vorpass mit derselben Gueltigkeit wie sema (_checkStmt, SNK_BLOCK): eine
  // innere Funktion gilt in ihrem BLOCK, dort auch vor ihrer Zeile, und
  // verdeckt Gleichnamiges von weiter aussen. Eine Variable oder ein Parameter
  // desselben Namens verdeckt wiederum sie.
  //
  // Der Vorpass legt das Ergebnis je KNOTEN ab (nestMap), nicht im Knoten: der
  // Name eines Knotens ist ein Versatz in den Quelltext, und cg_lineOf zaehlt
  // bis dorthin Zeilen. Gefragt wird an jeder Stelle, die aus einem Namen eine
  // Marke macht: Deklaration (cg_genFuncDecl), Aufruf (cg_genCall,
  // cg_callRetStructBytes) und Funktion als Wert (CGN_IDENT in cg_genExpr).
  // ------------------------------------------------------------------

  // Index in nestMap fuer Knoten `ni` des gerade aktiven Baums, sonst -1.
  fn cg_nestIdx(ni: int64): int64 {
    if (self.nestMapCnt == 0 || ni < 0) { return 0 - 1; }
    var i: int64 := 0;
    while (i < self.nestMapCnt) {
      var b: int64 := self.nestMap + i * 40;
      if (peek64(b) == self.pNodes && peek64(b + 8) == ni) { return i; }
      i += 1;
    }
    return 0 - 1;
  }
  fn cg_nestLbl(i: int64): pchar   { return peek64(self.nestMap + i * 40 + 16) as pchar; }
  fn cg_nestLblLen(i: int64): int64 { return peek64(self.nestMap + i * 40 + 24); }
  fn cg_nestDecl(i: int64): int64   { return peek64(self.nestMap + i * 40 + 32); }

  // Der Name, unter dem ein GEWOEHNLICHER Aufruf (iVal 0) in den Registern
  // steht: die Marke der inneren Funktion, die er meint, sonst sein Name.
  // Jede Stelle, die zu einem Aufrufknoten Rueckgabetyp, f64-Kennzeichen,
  // Tupelform oder Struct-Groesse nachschlaegt, fragt hier — eine Stelle, die
  // den Knotennamen direkt nimmt, faende bei einer Kollision die gleichnamige
  // Modulfunktion.
  fn cg_callName(ni: int64, lenCell: int64): pchar {
    // #2134: ein generischer Aufruf meint seine Spezialisierung — unter
    // deren Namen stehen Rueckgabetyp und f64-Merkung in den Registern.
    if (self.cg_nival(ni) == 2) { return self.cg_genInstanz(ni, lenCell); }
    if (self.cg_nival(ni) == 0) {
      var i: int64 := self.cg_nestIdx(ni);
      if (i >= 0) {
        poke64(lenCell, self.cg_nestLblLen(i));
        return self.cg_nestLbl(i);
      }
    }
    poke64(lenCell, self.cg_nslen(ni));
    return self.cg_nsval(ni);
  }

  fn cg_nestMapAdd(ni: int64, lbl: pchar, llen: int64, declNi: int64) {
    if (self.cg_nestIdx(ni) >= 0) { return; }   // Vorpass kann zweimal laufen (@if-Zweig)
    if (self.nestMapCnt >= self.nestMapCap) {
      var nc: int64 := self.nestMapCap * 2;
      var nb: int64 := alloc(nc * 40);
      memcpy(nb, self.nestMap, self.nestMapCnt * 40);
      self.nestMap := nb;
      self.nestMapCap := nc;
    }
    var b: int64 := self.nestMap + self.nestMapCnt * 40;
    poke64(b, self.pNodes);
    poke64(b + 8, ni);
    poke64(b + 16, lbl as int64);
    poke64(b + 24, llen);
    poke64(b + 32, declNi);
    self.nestMapCnt += 1;
  }

  // lbl == 0: der Name ist hier durch eine Variable oder einen Parameter verdeckt.
  fn cg_nestScopePush(name: pchar, nlen: int64, lbl: pchar, llen: int64, declNi: int64) {
    if (self.nestScopeCnt >= self.nestScopeCap) {
      var nc: int64 := self.nestScopeCap * 2;
      var nb: int64 := alloc(nc * 40);
      memcpy(nb, self.nestScope, self.nestScopeCnt * 40);
      self.nestScope := nb;
      self.nestScopeCap := nc;
    }
    var b: int64 := self.nestScope + self.nestScopeCnt * 40;
    poke64(b, name as int64);
    poke64(b + 8, nlen);
    poke64(b + 16, lbl as int64);
    poke64(b + 24, llen);
    poke64(b + 32, declNi);
    self.nestScopeCnt += 1;
  }

  // Innerster sichtbarer Eintrag dieses Namens; -1, wenn keiner da ist oder
  // der innerste eine Variable ist. Dann gilt der bisherige Weg ueber den
  // blanken Namen (Modulfunktion, Builtin, Funktionszeiger).
  fn cg_nestScopeFind(name: pchar, nlen: int64): int64 {
    var i: int64 := self.nestScopeCnt - 1;
    while (i >= 0) {
      var b: int64 := self.nestScope + i * 40;
      if (self.cg_seq(peek64(b) as pchar, peek64(b + 8), name, nlen)) {
        if (peek64(b + 16) == 0) { return 0 - 1; }
        return i;
      }
      i -= 1;
    }
    return 0 - 1;
  }

  // Ist `lbl` schon die Marke einer inneren Funktion (irgendeines Moduls)?
  fn cg_nestLabelUsed(lbl: pchar, llen: int64): int64 {
    var i: int64 := 0;
    while (i < self.nestMapCnt) {
      var b: int64 := self.nestMap + i * 40;
      if (peek64(b + 8) == peek64(b + 32)) {     // Deklarationseintrag
        if (self.cg_seq(peek64(b + 16) as pchar, peek64(b + 24), lbl, llen)) { return 1; }
      }
      i += 1;
    }
    return 0;
  }

  // "base@name"; steht derselbe Name in zwei Bloecken derselben Funktion,
  // traegt die zweite "base@name@2", die dritte "@3". Eine Ziffer kann keinen
  // Bezeichner beginnen, die Form ist also mit keinem Namen verwechselbar.
  fn cg_nestMakeLabel(base: pchar, blen: int64, name: pchar, nlen: int64, lenCell: int64): pchar {
    var k: int64 := 1;
    while (k < 1000000) {
      var dig: int64 := alloc(24);
      var dl: int64 := 0;
      if (k > 1) {
        var t: int64 := k;
        while (t > 0) {
          poke8(dig + dl, 48 + (t - (t / 10) * 10));
          dl := dl + 1;
          t := t / 10;
        }
      }
      var extra: int64 := 0;
      if (dl > 0) { extra := 1 + dl; }
      var len: int64 := blen + 1 + nlen + extra;
      var buf: int64 := alloc(len + 1);
      var i: int64 := 0;
      while (i < blen) { poke8(buf + i, StrCharAt(base, i)); i := i + 1; }
      poke8(buf + blen, 64);   // '@'
      i := 0;
      while (i < nlen) { poke8(buf + blen + 1 + i, StrCharAt(name, i)); i := i + 1; }
      if (dl > 0) {
        poke8(buf + blen + 1 + nlen, 64);
        i := 0;
        while (i < dl) {   // Ziffern liegen verkehrt herum in dig
          poke8(buf + blen + 2 + nlen + i, peek8(dig + dl - 1 - i));
          i := i + 1;
        }
      }
      poke8(buf + len, 0);
      free(dig, 24);
      if (self.cg_nestLabelUsed(buf as pchar, len) == 0) {
        poke64(lenCell, len);
        return buf as pchar;
      }
      free(buf, len + 1);
      k := k + 1;
    }
    EPrintStrLn("error: codegen: keine freie Marke fuer eine innere Funktion (#2044)"c);
    exit(1);
    return 0 as pchar;
  }

  // Die Marke einer Funktion der OBERSTEN Ebene. Dieselbe Rechnung, die
  // cg_genFuncDecl fuer die Deklaration nimmt — beide fragen hier, damit der
  // Praefix einer inneren Funktion genau die Marke der aeusseren ist (und
  // zwei private gleichnamige Aussenfunktionen zweier Units getrennt bleiben).
  fn cg_topFnLabel(ni: int64, lenCell: int64): pchar {
    var fname: pchar := self.cg_nsval(ni);
    var fnlen: int64 := self.cg_nslen(ni);
    // #1262: In einem Namensraum heisst die Marke "alias_Name". Ohne das
    // traegt der Codestrom zweimal `Wert`, und welche Fassung ein Aufruf
    // trifft, entschiede die Reihenfolge der Marken — genau das stille
    // Falschbinden, das der Alias verhindern soll.
    if (self.cgAlias != 0) {
      var mb: int64 := self.cg_mangleInto(self.cgAlias as pchar, self.cgAliasLen,
                                          fname, fnlen, lenCell);
      return mb as pchar;
    }
    if (self.cgUnitTag != 0 &&
        peek64(self.cg_noff(ni) + CG_OFF_ISPUB) == 0 &&
        self.cg_unitPrivHat(fname, fnlen) != 0) {
      // #1655: private Funktion einer importierten Unit — Marke unit-lokal.
      // Die Bedingung fragt DENSELBEN Helfer wie die Aufrufstelle. Wer eine
      // Marke umbenennt, muss beide Enden an dieselbe Bedingung binden, nicht
      // an zwei aehnliche.
      var ub: int64 := self.cg_unitPrivMangle(fname, fnlen, lenCell);
      return ub as pchar;
    }
    poke64(lenCell, fnlen);
    return fname;
  }

  // Vorpass ueber ein Modul: Marken vergeben und Aufrufe zuordnen. Laeuft in
  // cg_genFile nach cg_collectF64Funcs (die Signatur-Register muessen stehen)
  // und — bei einem Import — nach cg_unitPrivCollect (cg_topFnLabel fragt sie).
  fn cg_nestPlan(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_FUNC_DECL) {
        // Ein Rumpf ist ein Block. NICHT "c2 >= 0": bei `extern fn` mit
        // @capabilities haengt dort das Attribut (Parser, _pendingCapAttr).
        if (self.cg_nestHatRumpf(cur) != 0) {
          var lc: int64 := alloc(8);
          var lb: pchar := self.cg_topFnLabel(cur, lc);
          self.cg_nestWalkFunc(cur, lb, peek64(lc));
          free(lc, 8);
        }
      } else if (k == CGN_TYPE_DECL) {
        // Methoden: Marke "Klasse_Methode", wie cg_genMethodDecl sie anlegt.
        var cln: pchar := self.cg_nsval(cur);
        var clnLen: int64 := self.cg_nslen(cur);
        var m: int64 := self.cg_nc1(cur);
        while (m != -1) {
          if (self.cg_nkind(m) == CGN_FUNC_DECL && self.cg_nestHatRumpf(m) != 0) {
            var mlc: int64 := alloc(8);
            var mb: int64 := self.cg_mangleInto(cln, clnLen, self.cg_nsval(m), self.cg_nslen(m), mlc);
            self.cg_nestWalkFunc(m, mb as pchar, peek64(mlc));
            free(mlc, 8);
          }
          m := self.cg_nnext(m);
        }
      } else if (k == CGN_BLOCK) {
        self.cg_nestPlan(self.cg_nc0(cur));   // eingebetteter @if-Zweig
      }
      cur := self.cg_nnext(cur);
    }
  }

  // Ein Funktionsrumpf: die Parameter verdecken Gleichnamiges von aussen.
  fn cg_nestWalkFunc(fni: int64, base: pchar, blen: int64) {
    var saved: int64 := self.nestScopeCnt;
    var p: int64 := self.cg_nc0(fni);
    while (p >= 0) {
      if (self.cg_nkind(p) == CGN_PARAM) {
        self.cg_nestScopePush(self.cg_nsval(p), self.cg_nslen(p), 0 as pchar, 0, 0 - 1);
      }
      p := self.cg_nnext(p);
    }
    if (self.cg_nestHatRumpf(fni) != 0) { self.cg_nestWalkOne(self.cg_nc2(fni), base, blen); }
    self.nestScopeCnt := saved;
  }

  fn cg_nestHatRumpf(fni: int64): int64 {
    var b: int64 := self.cg_nc2(fni);
    if (b < 0) { return 0; }
    if (self.cg_nkind(b) != CGN_BLOCK) { return 0; }
    return 1;
  }

  fn cg_nestWalkList(head: int64, base: pchar, blen: int64) {
    var cur: int64 := head;
    while (cur >= 0) {
      self.cg_nestWalkOne(cur, base, blen);
      cur := self.cg_nnext(cur);
    }
  }

  fn cg_nestWalkKids(ni: int64, base: pchar, blen: int64) {
    self.cg_nestWalkList(self.cg_nc0(ni), base, blen);
    self.cg_nestWalkList(self.cg_nc1(ni), base, blen);
    self.cg_nestWalkList(self.cg_nc2(ni), base, blen);
  }

  // Ein Bezeichner oder Aufruf, der eine sichtbare innere Funktion meint.
  fn cg_nestBind(ni: int64) {
    var si: int64 := self.cg_nestScopeFind(self.cg_nsval(ni), self.cg_nslen(ni));
    if (si < 0) { return; }
    var b: int64 := self.nestScope + si * 40;
    self.cg_nestMapAdd(ni, peek64(b + 16) as pchar, peek64(b + 24), peek64(b + 32));
  }

  fn cg_nestWalkOne(ni: int64, base: pchar, blen: int64) {
    var k: int64 := self.cg_nkind(ni);
    // Nicht jede Kindkante ist ein Knoten: bei @bounds_check(true) u. a.
    // steht in c0 der WERT (Parser: "no iv2 slot in node layout"). Als Index
    // gelesen fuehrte true = 1 auf Knoten 1 — eine Funktionsdeklaration.
    // Alle uebrigen Kanten, die in einem Rumpf vorkommen, sind Knoten oder -1
    // (nachgesehen an jedem _sc0/_sc1/_sc2 in src/parser.lyx).
    if (k == CGN_AT_DIRECTIVE) { return; }
    if (k == CGN_BLOCK) {
      var saved: int64 := self.nestScopeCnt;
      // Wie sema: die fn-Deklarationen eines Blocks gelten im GANZEN Block,
      // auch vor ihrer Zeile — erst alle eintragen, dann den Block ablaufen.
      var s: int64 := self.cg_nc0(ni);
      while (s >= 0) {
        if (self.cg_nkind(s) == CGN_FUNC_DECL) {
          var vi: int64 := self.cg_nestIdx(s);
          if (vi < 0) {
            var lc: int64 := alloc(8);
            var lb: pchar := self.cg_nestMakeLabel(base, blen, self.cg_nsval(s), self.cg_nslen(s), lc);
            self.cg_nestMapAdd(s, lb, peek64(lc), s);
            self.cg_registerSigUnter(s, lb, peek64(lc));
            free(lc, 8);
            vi := self.cg_nestIdx(s);
          }
          self.cg_nestScopePush(self.cg_nsval(s), self.cg_nslen(s),
                                self.cg_nestLbl(vi), self.cg_nestLblLen(vi), s);
        }
        s := self.cg_nnext(s);
      }
      s := self.cg_nc0(ni);
      while (s >= 0) {
        var sk: int64 := self.cg_nkind(s);
        if (sk == CGN_FUNC_DECL) {
          var fi: int64 := self.cg_nestIdx(s);
          self.cg_nestWalkFunc(s, self.cg_nestLbl(fi), self.cg_nestLblLen(fi));
        } else if (sk == CGN_VAR_DECL) {
          // Der Initialisierer sieht noch den alten Bereich; danach verdeckt
          // die Variable (sema traegt sie erst an ihrer Zeile ein).
          self.cg_nestWalkKids(s, base, blen);
          self.cg_nestScopePush(self.cg_nsval(s), self.cg_nslen(s), 0 as pchar, 0, 0 - 1);
        } else {
          self.cg_nestWalkOne(s, base, blen);
        }
        s := self.cg_nnext(s);
      }
      self.nestScopeCnt := saved;
      return;
    }
    if (k == CGN_FUNC_DECL) {
      // Ausserhalb eines Blocks kommt keine vor; ein Rumpf hier waere ohne
      // Marke und wuerde unter dem blanken Namen erzeugt.
      EPrintStrLn("error: codegen: fn-Deklaration ausserhalb eines Blocks (#2044)"c);
      exit(1);
    }
    if (k == CGN_FOR || k == CGN_FOR_RANGE) {
      // Die Laufvariable verdeckt im Rumpf.
      var saved2: int64 := self.nestScopeCnt;
      self.cg_nestWalkList(self.cg_nc0(ni), base, blen);
      self.cg_nestWalkList(self.cg_nc1(ni), base, blen);
      self.cg_nestScopePush(self.cg_nsval(ni), self.cg_nslen(ni), 0 as pchar, 0, 0 - 1);
      self.cg_nestWalkList(self.cg_nc2(ni), base, blen);
      self.nestScopeCnt := saved2;
      return;
    }
    if (k == CGN_FOR_C) {
      // c0 = Initialisierung (eine Variable, gilt fuer die ganze Schleife),
      // c3 = Rumpf — die einzige Knotenart mit Anweisungen in c3.
      var saved3: int64 := self.nestScopeCnt;
      var ini: int64 := self.cg_nc0(ni);
      if (ini >= 0) {
        if (self.cg_nkind(ini) == CGN_VAR_DECL) {
          self.cg_nestWalkKids(ini, base, blen);
          self.cg_nestScopePush(self.cg_nsval(ini), self.cg_nslen(ini), 0 as pchar, 0, 0 - 1);
        } else {
          self.cg_nestWalkOne(ini, base, blen);
        }
      }
      self.cg_nestWalkList(self.cg_nc1(ni), base, blen);
      self.cg_nestWalkList(self.cg_nc2(ni), base, blen);
      self.cg_nestWalkList(self.cg_nc3(ni), base, blen);
      self.nestScopeCnt := saved3;
      return;
    }
    if (k == CGN_CALL && self.cg_nival(ni) == 0) { self.cg_nestBind(ni); }
    else if (k == CGN_IDENT) { self.cg_nestBind(ni); }
    self.cg_nestWalkKids(ni, base, blen);
  }

  // ------------------------------------------------------------------
  // #1140: @flight_crit — FPU-Ausnahmen fuer NaN/Inf
  // ------------------------------------------------------------------
  //
  // `sprache/datentypen.txt` sagt zu, dass in @flight_crit-Code jede
  // entstehende NaN/Inf-Operation panic ausloest statt still weiterzulaufen.
  // Umgesetzt ueber MXCSR: die Masken fuer *invalid* (Bit 7) und
  // *divide-by-zero* (Bit 9) werden beim Eintritt geloescht und beim
  // Verlassen zurueckgeschrieben.
  //
  // REICHWEITE: MXCSR ist Thread-Zustand. Ab dem Eintritt gilt der Trap
  // deshalb auch fuer alles, was die Funktion RUFT — bis sie zurueckkehrt.
  // Das ist die Zusage "hier entsteht keine NaN unbemerkt"; ein Maskieren vor
  // jedem Aufruf wuerde sie an der ersten Funktionsgrenze enden lassen.
  //
  // Der ausgeloeste SIGFPE trifft einen Handler, den der Compiler mitgibt —
  // ohne ihn staerbe das Programm wortlos, was fuer einen Nachweis zu wenig
  // waere. Damit die Meldung sagt, WO es passierte, legt der Prolog einen
  // Zeiger auf den Funktionsnamen in _lyx_fc_name ab (alter Wert im Rahmen,
  // damit Schachtelung traegt).

  // Zeichenkette in den Datenbereich legen, NUL-terminiert. Liefert den Offset.
  fn cg_fcDataStr(sptr: pchar, slen: int64): int64 {
    var doff: int64 := self.dataLen;
    var i: int64 := 0;
    while (i < slen) { self.cg_edata(peek8(sptr + i)); i := i + 1; }
    self.cg_edata(0);
    return doff;
  }

  // Kommt @flight_crit ueberhaupt vor? Methoden zaehlen mit — dort steht das
  // Flag in derselben iVal wie die Modifier-Bits.
  fn cg_collectFlightCrit(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_FUNC_DECL) {
        if ((self.cg_nival(cur) & ANNO_FLIGHTCRIT) != 0) { self.fcSeen := 1; }
      } else if (k == CGN_TYPE_DECL) {
        var m: int64 := self.cg_nc1(cur);
        while (m != -1) {
          if (self.cg_nkind(m) == CGN_FUNC_DECL) {
            if ((self.cg_nival(m) & ANNO_FLIGHTCRIT) != 0) { self.fcSeen := 1; }
          }
          m := self.cg_nnext(m);
        }
      }
      cur := self.cg_nnext(cur);
    }
  }

  // #1878: Kommt `@integrity(mode: scrubbed)` vor? Dieselbe Aufzaehlung wie
  // oben — freie Funktion UND Methode. Eine Aufzaehlung, die nur den einen
  // Fall kennt, ist der Fehler, der in #1787/#1806/#1812 dreimal auftrat.
  fn cg_collectIntegrity(head: int64) {
    // #1916: Die Unit-Form traegt keinen Funktionsknoten — sie kommt als
    // Schalter aus dem Parser. Sie hier hereinzunehmen genuegt, weil der
    // Sweep ohnehin programmweit ist: es gibt nichts je Funktion zu tun.
    if (self.unitScrubbed != 0) { self.scrubSeen := 1; }
    var cur: int64 := head;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_FUNC_DECL) {
        if (self.cg_integrityMode(cur) == INTEGRITY_SCRUBBED) { self.scrubSeen := 1; }
        if (self.cg_integrityMode(cur) == INTEGRITY_LOCKSTEP) { self.lockstepSeen := 1; }
      } else if (k == CGN_TYPE_DECL) {
        var m: int64 := self.cg_nc1(cur);
        while (m != -1) {
          if (self.cg_nkind(m) == CGN_FUNC_DECL) {
            if (self.cg_integrityMode(m) == INTEGRITY_SCRUBBED) { self.scrubSeen := 1; }
            if (self.cg_integrityMode(m) == INTEGRITY_LOCKSTEP) { self.lockstepSeen := 1; }
          }
          m := self.cg_nnext(m);
        }
      }
      cur := self.cg_nnext(cur);
    }
    // Die Zelle mit dem Tabellenzeiger muss VOR dem Handler stehen — der
    // Handler laedt sie ueber [rip+Zelle]. Die Tabelle selbst entsteht erst,
    // wenn der Code fertig ist (ihre Groesse haengt an der Codelaenge).
    // Ein `@integrity(mode: scrubbed)` in einer importierten Einheit wird erst
    // hier sichtbar — da steht der seccomp-Filter schon. Der Sweep liefe dann
    // in ein SIGSYS statt zu pruefen; das wird GEMELDET, nicht abgewartet.
    if (self.scrubSeen != 0 && self.lcbsBpfDone != 0 && self.lcbsCapCount > 0
        && self.scrubPtrCell == 0) {
      EPrintStrLn("error: @integrity(mode: scrubbed) in einer importierten Einheit zusammen mit @capabilities"c);
      EPrintStrLn("  Der seccomp-Filter steht zu diesem Zeitpunkt bereits; `setitimer` waere darin nicht freigegeben."c);
      EPrintStrLn("  Das Attribut gehoert an eine Funktion der Haupteinheit."c);
      exit(1);
    }
    if (self.scrubSeen != 0 && self.scrubPtrCell == 0) {
      self.scrubPtrCell := self.cg_reserveData(8);
      if (self.integrityIntervalMs == 0) {
        self.integrityIntervalMs := INTEGRITY_INTERVAL_DEFAULT;
      }
    }
  }

  fn cg_integrityMode(ni: int64): int64 {
    return (self.cg_nival(ni) >> ANNO_INTEGRITY_SHIFT) & ANNO_INTEGRITY_MASK;
  }

  // ------------------------------------------------------------------
  // #1878: software_lockstep — den Rueckgabeausdruck zweimal rechnen und die
  // beiden Ergebnisse vergleichen. Das ist Lockstep auf Registerebene: ein
  // Kipper waehrend einer der beiden Auswertungen faellt auf, weil die zweite
  // ihn nicht wiederholt. Was es NICHT sieht, steht in der Doku und im Test:
  // einen Kipper im gespeicherten Eingabewert, den beide Laeufe gleich lesen.
  //
  // Deshalb darf der Ausdruck keine Wirkung haben. Ein Aufruf wuerde zweimal
  // laufen (und zweimal schreiben, zweimal belegen); statt das stillschweigend
  // zu tun, wird es GEMELDET.
  // ------------------------------------------------------------------
  fn cg_lockstepDuplizierbar(ni: int64): int64 {
    if (ni < 0) { return 1; }
    var k: int64 := self.cg_nkind(ni);
    var ok: int64 := 0;
    if (k == CGN_LIT_INT)   { ok := 1; }
    if (k == CGN_LIT_FLOAT) { ok := 1; }
    if (k == CGN_LIT_CHAR)  { ok := 1; }
    if (k == CGN_LIT_BOOL)  { ok := 1; }
    if (k == CGN_LIT_NULL)  { ok := 1; }
    if (k == CGN_IDENT)     { ok := 1; }
    if (k == CGN_BINOP)     { ok := 1; }
    if (k == CGN_UNOP)      { ok := 1; }
    if (k == CGN_INDEX)     { ok := 1; }
    if (k == CGN_FIELD)     { ok := 1; }
    if (k == CGN_CAST)      { ok := 1; }
    if (ok == 0) { return 0; }
    if (self.cg_lockstepDuplizierbar(self.cg_nc0(ni)) == 0) { return 0; }
    if (self.cg_lockstepDuplizierbar(self.cg_nc1(ni)) == 0) { return 0; }
    if (self.cg_lockstepDuplizierbar(self.cg_nc2(ni)) == 0) { return 0; }
    return 1;
  }

  // rax traegt das Ergebnis des ERSTEN Laufs. Danach steht dort das Ergebnis
  // des zweiten — beide sind gleich, sonst wurde vorher abgebrochen.
  fn cg_lockstepPruefe(expr: int64) {
    if (self.cg_lockstepDuplizierbar(expr) == 0) {
      EPrintStr("error: @integrity(mode: software_lockstep) in `"c);
      sys_write(2, self.lockstepName as int64, self.lockstepNameLen);
      EPrintStrLn("`: der Rueckgabeausdruck hat eine Wirkung (Aufruf, `new`, Zuweisung) und laesst sich nicht zweimal rechnen"c);
      EPrintStrLn("  Zwischenergebnis in eine Variable legen und diese zurueckgeben."c);
      exit(1);
    }
    self.cg_pushRax();
    self.cg_genExpr(expr);
    // pop rcx; cmp rax, rcx; je weiter
    self.cg_e8(0x59);
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);
    self.cg_e8(0x74); self.cg_e8(0x05);
    // call __lyx_lockstep_fail  (kehrt nicht zurueck)
    self.cg_e8(0xE8);
    self.cg_addPatch(self.codeLen, "__lyx_lockstep_fail" as int64, 19, CG_PATCH_CALL);
    self.cg_e32(0);
  }

  // Der Abbruchpfad. Steht einmal im Erzeugnis, gerufen von jeder
  // lockstep-Rueckgabe. rcx traegt den ersten, rax den zweiten Wert — beide
  // werden gemeldet, sonst ist die Meldung nicht nachvollziehbar.
  fn cg_lockstepEmitFail() {
    var m1: pchar := "panic: @integrity(mode: software_lockstep): die beiden Berechnungen des Rueckgabewerts stimmen nicht ueberein\n"c;
    var m1len: int64 := StrLen(m1);
    var m1off: int64 := self.cg_fcDataStr(m1, m1len);
    self.cg_addLabel("__lyx_lockstep_fail"c, 19, 0);
    // write(2, m1, m1len)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e32(1);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7); self.cg_e32(2);
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
    var p1: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(p1, m1off, 0, CG_PATCH_STR);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e32(m1len);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // exit_group(133)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e32(231);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7); self.cg_e32(133);
    self.cg_e8(0x0F); self.cg_e8(0x05);
  }

  // ==================================================================
  // #1878/#1877/#1879: mode: scrubbed — periodischer CRC32-Sweep ueber den
  // GELADENEN Code.
  //
  // Geprueft wird der Speicher, nicht die Datei: `MetaSafeVerify` liest
  // /proc/self/exe und erkennt damit eine Manipulation des Abbilds, aber
  // keinen Kipper in einer laengst geladenen, privaten Codeseite (#1879).
  // Der Sweep hier rechnet ueber code_start_va..code_end_va.
  //
  // Die Referenzhashes liegen DREIFACH im Datenbereich, je 4096 Byte
  // auseinander (#1877). Ohne diese Redundanz waere ein Kipper im Hashfeld von
  // einem Kipper im Code nicht zu unterscheiden — die Pruefung meldete in
  // beiden Faellen "korrupt", und es gaebe keine Mehrheit, die sagt, welche
  // Seite recht hat. Stimmen alle drei Kopien nicht ueberein, wird das als
  // eigener Fall gemeldet; still auf die erste Kopie zu fallen waere der
  // stille Default in neuer Form.
  //
  // Tabellenkopf (64 Byte), dann drei Kopien im Abstand `stride`:
  //    +0  "METASAF2"      +8  pageCount(u32)   +12 mode(u32)
  //   +16  codeLen(u64)   +24  code_start_va    +32 code_end_va
  //   +40  interval_ms(u32) +44 stride(u32)     +48 recovery_ptr(u64)
  //   +56  sweepCount(u64) — zur Laufzeit hochgezaehlt, damit ein Test die
  //        WIRKUNG messen kann und nicht nur das Vorhandensein des Handlers.
  // ==================================================================
  // In `main`, vor jedem Benutzercode: Handler einhaengen und Zeitgeber
  // stellen. Ohne den Zeitgeber liefe der Sweep nur auf Zuruf — genau die
  // Einschraenkung aus #1879.
  fn cg_scrubInstall() {
    var ms:  int64 := self.integrityIntervalMs;
    var sek: int64 := ms / 1000;
    var usek: int64 := (ms - sek * 1000) * 1000;
    // sub rsp, 64
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x40);
    // lea rax, [rip+__lyx_scrub_handler]; mov [rsp], rax
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
    var pH: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(pH, "__lyx_scrub_handler" as int64, 19, CG_PATCH_CALL);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);
    // mov rax, SA_RESTORER; mov [rsp+8], rax
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e32(67108864);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);
    // lea rax, [rip+__lyx_scrub_restorer]; mov [rsp+16], rax
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
    var pR: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(pR, "__lyx_scrub_restorer" as int64, 20, CG_PATCH_CALL);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x10);
    // xor rax, rax; mov [rsp+24], rax   (leere sa_mask)
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x18);
    // rt_sigaction(SIGALRM=14, rsp, 0, 8)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e32(13);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7); self.cg_e32(14);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE6);
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);
    self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e32(8);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // itimerval bei [rsp+32]: it_interval{sek,usek}, it_value{sek,usek}
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e32(sek);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x20);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x30);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e32(usek);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x28);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x38);
    // setitimer(ITIMER_REAL=0, rsp+32, 0)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e32(38);
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xFF);
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x20);
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // add rsp, 64
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x40);
  }

  fn cg_scrubEmitHandler() {
    // ---- __lyx_scrub_restorer: rt_sigreturn ----
    self.cg_addLabel("__lyx_scrub_restorer"c, 20, 0);
    self.cg_e8(0xB8); self.cg_e32(15);
    self.cg_e8(0x0F); self.cg_e8(0x05);

    var mBad: pchar := "panic: @integrity(mode: scrubbed): Codeseite im Speicher stimmt nicht mit dem Referenzhash ueberein\n"c;
    var mMaj: pchar := "panic: @integrity(mode: scrubbed): keine Mehrheit unter den drei Referenzhashes — auch die Tabelle ist beschaedigt\n"c;
    var mBadLen: int64 := StrLen(mBad);
    var mMajLen: int64 := StrLen(mMaj);
    var mBadOff: int64 := self.cg_fcDataStr(mBad, mBadLen);
    var mMajOff: int64 := self.cg_fcDataStr(mMaj, mMajLen);

    self.cg_addLabel("__lyx_scrub_handler"c, 19, 0);
    // mov rdi, [rip+scrubPtrCell]      — Adresse der Tabelle
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x3D);
    var pT: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(pT, self.scrubPtrCell, 0, CG_PATCH_STR);
    // inc qword [rdi+56]               — Sweep-Zaehler
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0x47); self.cg_e8(0x38);
    // xor r8, r8                       — Seitenindex
    self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0);
    // mov r9d, [rdi+8]                 — pageCount
    self.cg_e8(0x44); self.cg_e8(0x8B); self.cg_e8(0x4F); self.cg_e8(0x08);

    var seitenSchleife: int64 := self.codeLen;
    // cmp r8, r9; jge fertig
    self.cg_e8(0x4D); self.cg_e8(0x39); self.cg_e8(0xC8);
    self.cg_e8(0x0F); self.cg_e8(0x8D);
    var pFertig: int64 := self.codeLen; self.cg_e32(0);
    // rsi = code_start_va + index*4096
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x77); self.cg_e8(0x18);
    self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0xC0);          // mov rax, r8
    self.cg_e8(0x48); self.cg_e8(0xC1); self.cg_e8(0xE0); self.cg_e8(0x0C);  // shl rax, 12
    self.cg_e8(0x48); self.cg_e8(0x01); self.cg_e8(0xC6);          // add rsi, rax
    // rdx = min(4096, codeLen - index*4096)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x57); self.cg_e8(0x10);
    self.cg_e8(0x48); self.cg_e8(0x29); self.cg_e8(0xC2);          // sub rdx, rax
    self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xFA); self.cg_e32(4096);
    self.cg_e8(0x7E); self.cg_e8(0x07);                            // jle +7
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e32(4096);
    // ---- CRC32 ueber [rsi, rdx) nach eax ----
    self.cg_e8(0xB8); self.cg_e32(4294967295);                     // mov eax, 0xFFFFFFFF
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC9);          // xor rcx, rcx
    var byteSchleife: int64 := self.codeLen;
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xD1);          // cmp rcx, rdx
    self.cg_e8(0x0F); self.cg_e8(0x8D);
    var pCrcFertig: int64 := self.codeLen; self.cg_e32(0);         // jge crcFertig
    self.cg_e8(0x44); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0x14); self.cg_e8(0x0E); // movzx r10d,[rsi+rcx]
    self.cg_e8(0x44); self.cg_e8(0x31); self.cg_e8(0xD0);          // xor eax, r10d
    self.cg_e8(0x41); self.cg_e8(0xBB); self.cg_e32(8);            // mov r11d, 8
    var bitSchleife: int64 := self.codeLen;
    self.cg_e8(0xD1); self.cg_e8(0xE8);                            // shr eax, 1
    self.cg_e8(0x73); self.cg_e8(0x05);                            // jnc +5
    self.cg_e8(0x35); self.cg_e32(3988292384);                     // xor eax, 0xEDB88320
    self.cg_e8(0x41); self.cg_e8(0xFF); self.cg_e8(0xCB);          // dec r11d
    self.cg_e8(0x75);
    self.cg_e8((bitSchleife - self.codeLen - 1) & 255);            // jnz bitSchleife
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC1);          // inc rcx
    self.cg_e8(0xE9);
    self.cg_e32(byteSchleife - self.codeLen - 4);                  // jmp byteSchleife
    poke32(self.code + pCrcFertig, self.codeLen - pCrcFertig - 4);
    self.cg_e8(0xF7); self.cg_e8(0xD0);                            // not eax

    // ---- Mehrheitsentscheid ueber die drei Kopien ----
    self.cg_e8(0x44); self.cg_e8(0x8B); self.cg_e8(0x5F); self.cg_e8(0x2C);  // mov r11d,[rdi+44] (stride)
    self.cg_e8(0x4D); self.cg_e8(0x89); self.cg_e8(0xC2);          // mov r10, r8
    self.cg_e8(0x49); self.cg_e8(0xC1); self.cg_e8(0xE2); self.cg_e8(0x03);  // shl r10, 3
    self.cg_e8(0x49); self.cg_e8(0x01); self.cg_e8(0xFA);          // add r10, rdi
    self.cg_e8(0x49); self.cg_e8(0x83); self.cg_e8(0xC2); self.cg_e8(0x40);  // add r10, 64
    self.cg_e8(0x41); self.cg_e8(0x8B); self.cg_e8(0x4A); self.cg_e8(0x04);  // mov ecx,[r10+4]
    self.cg_e8(0x4D); self.cg_e8(0x01); self.cg_e8(0xDA);          // add r10, r11
    self.cg_e8(0x41); self.cg_e8(0x8B); self.cg_e8(0x72); self.cg_e8(0x04);  // mov esi,[r10+4]
    self.cg_e8(0x4D); self.cg_e8(0x01); self.cg_e8(0xDA);          // add r10, r11
    self.cg_e8(0x41); self.cg_e8(0x8B); self.cg_e8(0x52); self.cg_e8(0x04);  // mov edx,[r10+4]
    // c0 == c1 ? -> ecx gilt
    self.cg_e8(0x39); self.cg_e8(0xF1);                            // cmp ecx, esi
    self.cg_e8(0x74); self.cg_e8(0x0A);                            // je +10 (auf den Vergleich)
    self.cg_e8(0x39); self.cg_e8(0xD1);                            // cmp ecx, edx
    self.cg_e8(0x74); self.cg_e8(0x06);                            // je +6
    self.cg_e8(0x39); self.cg_e8(0xD6);                            // cmp esi, edx
    self.cg_e8(0x75);
    var pKeineMehrheit: int64 := self.codeLen; self.cg_e8(0);      // jne keineMehrheit
    self.cg_e8(0x89); self.cg_e8(0xF1);                            // mov ecx, esi
    // cmp eax, ecx; jne beschaedigt
    self.cg_e8(0x39); self.cg_e8(0xC8);
    self.cg_e8(0x0F); self.cg_e8(0x85);
    var pBeschaedigt: int64 := self.codeLen; self.cg_e32(0);
    // naechste Seite
    self.cg_e8(0x49); self.cg_e8(0xFF); self.cg_e8(0xC0);          // inc r8
    self.cg_e8(0xE9);
    self.cg_e32(seitenSchleife - self.codeLen - 4);
    poke32(self.code + pFertig, self.codeLen - pFertig - 4);
    self.cg_e8(0xC3);                                              // ret

    cg_patchRel8(self.code, pKeineMehrheit, self.codeLen);
    self.cg_scrubEmitAbbruch(mMajOff, mMajLen, 136);
    poke32(self.code + pBeschaedigt, self.codeLen - pBeschaedigt - 4);
    self.cg_scrubEmitAbbruch(mBadOff, mBadLen, 135);
  }

  fn cg_scrubEmitAbbruch(msgOff: int64, msgLen: int64, code: int64) {
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e32(1);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7); self.cg_e32(2);
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
    var p1: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(p1, msgOff, 0, CG_PATCH_STR);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e32(msgLen);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e32(231);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7); self.cg_e32(code);
    self.cg_e8(0x0F); self.cg_e8(0x05);
  }

  // Nach dem Code, VOR cg_patchAll: Tabelle im Datenbereich anlegen und den
  // Zeiger darauf eintragen. Die Hashes bleiben hier 0 — sie werden erst
  // gefuellt, wenn die Sprungziele im Code stehen (cg_scrubFillHashes).
  fn cg_scrubBuildTable() {
    if (self.scrubSeen == 0) { return; }
    var codeLen: int64 := self.codeLen;
    var pages:   int64 := (codeLen + 4095) / 4096;
    var eintraege: int64 := pages * 8;
    var stride: int64 := ((eintraege + 4095) / 4096) * 4096;
    if (stride < 4096) { stride := 4096; }
    // Auf 8 ausrichten, damit die 64-Bit-Felder im Kopf gerade liegen.
    while ((self.dataLen & 7) != 0) { self.cg_edata(0); }
    var off: int64 := self.dataLen;
    var gesamt: int64 := CG_SCRUB_HDR + 3 * stride;
    var i: int64 := 0;
    while (i < gesamt) { self.cg_edata(0); i := i + 1; }
    poke8(self.data + off + 0, 77); poke8(self.data + off + 1, 69);   // ME
    poke8(self.data + off + 2, 84); poke8(self.data + off + 3, 65);   // TA
    poke8(self.data + off + 4, 83); poke8(self.data + off + 5, 65);   // SA
    poke8(self.data + off + 6, 70); poke8(self.data + off + 7, 50);   // F2
    poke32(self.data + off + 8,  pages);
    poke32(self.data + off + 12, INTEGRITY_SCRUBBED);
    poke64(self.data + off + 16, codeLen);
    poke64(self.data + off + 24, CG_ELF_BASE + CG_CODE_OFF);
    poke64(self.data + off + 32, CG_ELF_BASE + CG_CODE_OFF + codeLen);
    // #2135: Beide sind absolute Adressen (Codeanfang/-ende) — dieselbe
    // Basis-Relocation wie jeder Zeiger im Datenbereich, sonst prueft der
    // Sweep bei abweichender Ladebasis (PE, LyxOS) Speicher bei 0x400000.
    // codeLen ist hier endgueltig (Generate fuellt vorher auf).
    self.cg_addBaseReloc(CG_CODE_OFF + codeLen + off + 24);
    self.cg_addBaseReloc(CG_CODE_OFF + codeLen + off + 32);
    poke32(self.data + off + 40, self.integrityIntervalMs);
    poke32(self.data + off + 44, stride);
    self.scrubTableOff  := off;
    self.scrubPageCount := pages;
    self.scrubStride    := stride;
    // Die Zelle bekommt die geladene Adresse der Tabelle — dieselbe Mechanik
    // wie ein globaler Zeiger mit Startwert (#1164/#1298), samt Basis-Reloc.
    self.cg_addPatch(self.scrubPtrCell, off, 0, CG_PATCH_DATA_PTR);
  }

  // Nach cg_patchAll: jetzt stehen alle disp32 im Code, die Bytes sind final.
  fn cg_scrubFillHashes() {
    if (self.scrubSeen == 0) { return; }
    var off: int64 := self.scrubTableOff;
    var pi: int64 := 0;
    while (pi < self.scrubPageCount) {
      var seitenOff: int64 := pi * 4096;
      var len: int64 := 4096;
      if (self.codeLen - seitenOff < 4096) { len := self.codeLen - seitenOff; }
      var crc: int64 := cg_crc32(self.code + seitenOff, len);
      var k: int64 := 0;
      while (k < 3) {
        var eintrag: int64 := self.data + off + CG_SCRUB_HDR + k * self.scrubStride + pi * 8;
        poke32(eintrag, seitenOff);
        poke32(eintrag + 4, crc);
        k := k + 1;
      }
      pi := pi + 1;
    }
  }

  // Prolog: MXCSR sichern, Masken 7 und 9 loeschen, Namenszeiger setzen.
  fn cg_fcArm(fname: pchar, fnlen: int64) {
    self.fcMxSlot   := self.cg_addLocal("__fc_mxcsr"c, 10);
    self.fcNameSlot := self.cg_addLocal("__fc_name"c, 9);
    // stmxcsr [rbp+mx]
    self.cg_e8(0x0F); self.cg_e8(0xAE); self.cg_e8(0x9D); self.cg_e32(self.fcMxSlot);
    // mov eax, [rbp+mx]
    self.cg_e8(0x8B); self.cg_e8(0x85); self.cg_e32(self.fcMxSlot);
    // and eax, 0xFFFFFD7F   (Bit 7 = invalid, Bit 9 = divide-by-zero loeschen)
    self.cg_e8(0x25); self.cg_e8(0x7F); self.cg_e8(0xFD); self.cg_e8(0xFF); self.cg_e8(0xFF);
    // mov [rbp+mx+4], eax   (der entschaerfte Wert; die oberen 4 Byte des Slots)
    self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(self.fcMxSlot + 4);
    // ldmxcsr [rbp+mx+4]
    self.cg_e8(0x0F); self.cg_e8(0xAE); self.cg_e8(0x95); self.cg_e32(self.fcMxSlot + 4);
    // mov rax, [rip+CG_FC_NAME]   (bisheriger Name)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05);
    var pOld: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pOld, CG_FC_NAME, 0, CG_PATCH_STR);
    // mov [rbp+nm], rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(self.fcNameSlot);
    // lea rax, [rip+name]
    var nOff: int64 := self.cg_fcDataStr(fname, fnlen);
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
    var pName: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pName, nOff, 0, CG_PATCH_STR);
    // mov [rip+CG_FC_NAME], rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05);
    var pSet: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pSet, CG_FC_NAME, 0, CG_PATCH_STR);
  }

  // Epilog: alten MXCSR und alten Namenszeiger zurueck. rax bleibt unberuehrt
  // (Rueckgabewert) — deshalb r11 als Zwischenspeicher, wie bei der Canary.
  fn cg_fcDisarm() {
    // ldmxcsr [rbp+mx]
    self.cg_e8(0x0F); self.cg_e8(0xAE); self.cg_e8(0x95); self.cg_e32(self.fcMxSlot);
    // mov r11, [rbp+nm]
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x9D); self.cg_e32(self.fcNameSlot);
    // mov [rip+CG_FC_NAME], r11
    self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x1D);
    var pR: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pR, CG_FC_NAME, 0, CG_PATCH_STR);
  }

  // In main: rt_sigaction(SIGFPE, {handler, SA_RESTORER, restorer, 0}, 0, 8).
  // SA_RESTORER ist auf x86-64 PFLICHT — ohne das Flag und einen Restorer
  // bricht die Zustellung selbst zusammen (der Rahmenaufbau scheitert, das
  // Programm stirbt mit SIGSEGV statt den Handler zu erreichen).
  fn cg_fcInstallHandler() {
    // sub rsp, 32   (Platz fuer die sigaction-Struktur, 16-Byte-Ausrichtung bleibt)
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x20);
    // lea rax, [rip+__lyx_fc_handler]; mov [rsp], rax
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
    var pH: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pH, "__lyx_fc_handler" as int64, 16, CG_PATCH_CALL);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);
    // mov rax, 0x04000000 (SA_RESTORER); mov [rsp+8], rax
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0);
    self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x04);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);
    // lea rax, [rip+__lyx_fc_restorer]; mov [rsp+16], rax
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
    var pR2: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pR2, "__lyx_fc_restorer" as int64, 17, CG_PATCH_CALL);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x10);
    // xor rax, rax; mov [rsp+24], rax   (leere sa_mask)
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x18);
    // mov rax, 13 (rt_sigaction); mov rdi, 8 (SIGFPE); mov rsi, rsp;
    // xor rdx, rdx; mov r10, 8; syscall
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e8(0x0D); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7); self.cg_e8(0x08); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE6);
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);
    self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e8(0x08); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // add rsp, 32
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x20);
  }

  // Restorer und Handler. Beide werden NACH dem Benutzercode emittiert — der
  // feste Helfer-Block am Dateianfang hat eine nachgerechnete Groesse
  // (CG_H_USER), an der andere Backends haengen.
  fn cg_fcEmitHandler() {
    // ---- __lyx_fc_restorer: mov eax, 15 (rt_sigreturn); syscall ----
    self.cg_addLabel("__lyx_fc_restorer", 17, 0);
    self.cg_e8(0xB8); self.cg_e8(0x0F); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);

    // ---- __lyx_fc_handler ----
    // Der Text nennt beide Anlaesse: SIGFPE kommt sowohl von den
    // freigeschalteten SSE-Ausnahmen als auch von einer ganzzahligen Division
    // durch 0 (#DE). "nur NaN/Inf" waere im zweiten Fall falsch.
    var m1: pchar := "panic: FPU-Ausnahme (NaN/Inf oder Division durch 0) unter @flight_crit in `"c;
    var m1len: int64 := StrLen(m1);
    var m2: pchar := "`\n"c;
    var m2len: int64 := StrLen(m2);
    var m1off: int64 := self.cg_fcDataStr(m1, m1len);
    var m2off: int64 := self.cg_fcDataStr(m2, m2len);

    self.cg_addLabel("__lyx_fc_handler", 16, 0);
    // write(2, m1, m1len)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
    var p1: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(p1, m1off, 0, CG_PATCH_STR);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e32(m1len);
    self.cg_e8(0x0F); self.cg_e8(0x05);

    // rsi := [rip+CG_FC_NAME]; ist er 0, wird kein Name geschrieben.
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x35);
    var p2: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(p2, CG_FC_NAME, 0, CG_PATCH_STR);
    // test rsi, rsi
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xF6);
    // jz +len(strlen+write)  — Sprungweite unten nachgetragen
    self.cg_e8(0x74);
    var pJz: int64 := self.codeLen;
    self.cg_e8(0);
    var afterJz: int64 := self.codeLen;
    // xor rdx, rdx
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);
    var loopStart: int64 := self.codeLen;
    // cmp byte [rsi+rdx], 0
    self.cg_e8(0x80); self.cg_e8(0x3C); self.cg_e8(0x16); self.cg_e8(0x00);
    // je +5 (ueber inc/jmp hinweg)
    self.cg_e8(0x74); self.cg_e8(0x05);
    // inc rdx
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC2);
    // jmp loopStart
    self.cg_e8(0xEB);
    self.cg_e8((loopStart - self.codeLen - 1) & 255);
    // write(2, rsi, rdx)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    cg_patchRel8(self.code, pJz, self.codeLen);

    // write(2, m2, m2len)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x35);
    var p3: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(p3, m2off, 0, CG_PATCH_STR);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e32(m2len);
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // exit_group(134)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e8(0xE7); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC7); self.cg_e8(0x86); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    self.cg_e8(0x0F); self.cg_e8(0x05);
  }

  fn cg_genFuncDecl(ni: int64) {
    // Register label for this function
    var fname: pchar := self.cg_nsval(ni);
    var fnlen: int64 := self.cg_nslen(ni);
    // #2044: Eine innere Funktion traegt die Marke, die cg_nestPlan ihr gab
    // ("Aussen@innen"). Bis 1.2.12A war es der blanke Name, und zwei
    // gleichnamige innere Funktionen — oder eine innere und eine gleichnamige
    // Modulfunktion — fielen auf eine Marke zusammen.
    var nestI: int64 := self.cg_nestIdx(ni);
    self.genCurFd := ni;   // #2134
    if (self.genOvLen > 0) {
      // #2134: Spezialisierung einer generischen Funktion (cg_genEmitPending).
      fname := self.genOvLbl as pchar;
      fnlen := self.genOvLen;
      self.genOvLbl := 0;
      self.genOvLen := 0;
    } else if (nestI >= 0) {
      fname := self.cg_nestLbl(nestI);
      fnlen := self.cg_nestLblLen(nestI);
    } else {
      // #1262 (Namensraum) und #1655 (private Funktion einer Unit): dieselbe
      // Rechnung, die cg_nestPlan fuer den Praefix der inneren Funktionen nimmt.
      //
      // #1655 hatte hier zuerst eine Sonderbedingung fuer GESCHACHTELTE
      // Funktionen noetig (`w4` in std/cloud/aws/sigv4.lyx): die Aufrufstelle
      // fand sie nicht in der Top-Level-Kette. Seit #2044 kommt eine innere
      // Funktion gar nicht mehr hierher.
      var tlc: int64 := alloc(8);
      fname := self.cg_topFnLabel(ni, tlc);
      fnlen := peek64(tlc);
      free(tlc, 8);
    }
    self.cg_addLabel(fname, fnlen, self.cg_lineOf(ni));
    self.cg_cfi(CFI_FN, 0);   // #2135: Abwickelbereich beginnt an der Marke
    self.cfiInFn := 1;

    // Save and set outer function context for nested function capture analysis
    var savedOuterName: pchar := self.outerFuncName;
    var savedOuterLen: int64 := self.outerFuncNameLen;
    self.outerFuncName := fname;
    self.outerFuncNameLen := fnlen;

    // WP-EN-04: resolve effective energy level for this function
    // Reihenfolge: @energy(N) an der fn > `@energy(N);` als Direktive im
    // Quelltext > CLI/global > Vorgabe 3.
    //
    // #1162: Bis 1.0.15B gewann das CLI-Flag gegen beide Quelltext-Formen,
    // weil `@energy(N)` vor einer fn auf oberster Ebene als eigener Knoten
    // geparst wird und die Annotationsbits deshalb 0 blieben. Eine Funktion,
    // die ausdruecklich `@energy(1)` trug, wurde bei --target-energy=5
    // trotzdem aggressiv uebersetzt — die zugesagte Energie-Barriere gab es
    // nicht. Der Quelltext ist die genauere Angabe und schlaegt das Flag.
    var savedEnergy: int64 := self.fnEnergyLevel;
    var annoEnergy: int64 := (self.cg_nival(ni) >> ANNO_ENERGY_SHIFT) & 7;
    if (annoEnergy >= 1 && annoEnergy <= 5) {
      self.fnEnergyLevel := annoEnergy;
    } else if (self.scopeEnergyLevel >= 1) {
      self.fnEnergyLevel := self.scopeEnergyLevel;
    } else if (self.globalEnergyLevel >= 1) {
      self.fnEnergyLevel := self.globalEnergyLevel;
    } else {
      // #1162: Vorgabe 3, wie Quelltext-Kommentar und `sprache/`-Doku sie
      // seit WP-EN-01 zusagen. Bis 1.0.15B stand hier 1, der Normalfall
      // uebersetzte also durchgaengig im sparsamsten Modus.
      self.fnEnergyLevel := 3;
    }

    // #2191: dieselbe Übernahme fuer die CPU-Stufe. `@cpu(...)` an der
    // Funktion schlaegt --target-cpu — der Quelltext ist die genauere Angabe,
    // genau wie oben bei @energy. Umgekehrt NICHT: eine Funktion darf nicht
    // unter die Zusage des Aufrufs fallen, deshalb wird nur nach oben
    // abgewichen.
    var savedCpu: int64 := self.fnCpuStufe;
    if (self.scopeCpuStufe > self.cgCpuStufe) {
      self.fnCpuStufe := self.scopeCpuStufe;
    } else {
      self.fnCpuStufe := self.cgCpuStufe;
    }

    // Reset locals
    self.localCount := 0;
    self.frameSize  := 0;

    // WP-04: detect tuple return type ([T, T, ...])
    var retTyNode: int64 := self.cg_nc1(ni);
    self.funcHasTupleReturn := 0;
    if (retTyNode >= 0 && self.cg_nkind(retTyNode) == CGN_TYPE_TUPLE) {
      self.funcHasTupleReturn := 1;
    }

    // WP-18: initialize _lyx_canary BEFORE prologue stores it on stack.
    // Runs before push rbp, so the prologue can load the already-initialized value.
    // rdi/rsi (argc/argv) are saved around the call because getrandom clobbers them.
    if fnlen == 4 {
      if StrCharAt(fname, 0) == 109 && StrCharAt(fname, 1) == 97 &&
         StrCharAt(fname, 2) == 105 && StrCharAt(fname, 3) == 110 {
        self.cg_e8(0x57);                                                    // push rdi (argc)
        self.cg_cfi(CFI_CFA_OFF, 16);                                        // #2135
        self.cg_e8(0x56);                                                    // push rsi (argv)
        self.cg_cfi(CFI_CFA_OFF, 24);
        // call __lyx_canary_init  (fills _lyx_canary via sys_getrandom)
        self.cg_e8(0xE8);
        var pp18: int64 := self.codeLen;
        self.cg_e32(0);
        self.cg_addPatch(pp18, "__lyx_canary_init" as int64, 17, CG_PATCH_CALL);
        self.cg_e8(0x5E);                                                    // pop rsi  (argv)
        self.cg_cfi(CFI_CFA_OFF, 16);
        self.cg_e8(0x5F);                                                    // pop rdi  (argc)
        self.cg_cfi(CFI_CFA_OFF, 8);
      }
    }

    // #1370: Name fuer die Messung merken (siehe cg_emitPrologue).
    self.profCurName := fname;
    self.profCurLen  := fnlen;

    self.rlSelfKnoten := 0 - 1;   // #2228: freie Funktion, kein `self`
    self.cg_rlWaehlen(ni);   // #2114: vor dem Prolog, der die Register sichert
    // #2245: vor dem Prolog entscheiden — der Epilog liest dasselbe Feld.
    self.canaryAn := self.cg_funcBrauchtCanary(self.cg_nc2(ni));

    // Emit prologue, capture patch position for sub rsp imm32
    var prologuePatch: int64 := self.cg_emitPrologue();

    // #1595: Gibt diese Funktion ein STRUCT by value zurueck, dann steht in
    // rdi die vom Aufrufer bereitgestellte Zieladresse — ein verdecktes
    // erstes Argument. Es wird als erstes in den Rahmen gerettet, danach
    // ruecken alle echten Parameter um ein Register weiter.
    self.fnRetStructBytes := 0;
    self.fnRetSlotOff     := 0;
    self.fnRetIsFloat     := 0;
    if (retTyNode >= 0) {
      if (self.cg_isFloatTypeName(self.cg_nsval(retTyNode), self.cg_nslen(retTyNode)) != 0) {
        self.fnRetIsFloat := 1;
      }
    }
    if (retTyNode >= 0 && self.cg_nkind(retTyNode) == 60) {
      var rci: int64 := self.cg_findClass(self.cg_nsval(retTyNode), self.cg_nslen(retTyNode));
      if (rci >= 0 && self.cg_istWertStruct(rci) != 0
          && self.cg_structSelbstEnthalten(rci, 0) != 0) {
        var rsz: int64 := self.cg_classStructSize(rci);
        if (rsz > 0) {
          self.fnRetStructBytes := rsz;
          self.fnRetSlotOff := self.cg_reserveFrame(8);
          self.cg_spillRdi(self.fnRetSlotOff);
        }
      }
    }

    // #1140: @flight_crit — SSE-Ausnahmen freischalten. Der Zustand wird
    // gerettet und wiederhergestellt, damit eine geschachtelt erzeugte
    // Funktion die aeussere nicht umschaltet.
    var savedFcActive: int64 := self.fcActive;
    var savedFcMx:     int64 := self.fcMxSlot;
    var savedFcName:   int64 := self.fcNameSlot;
    self.fcActive := 0;
    if ((self.cg_nival(ni) & ANNO_FLIGHTCRIT) != 0) {
      self.cg_fcArm(fname, fnlen);
      self.fcActive := 1;
    }
    // #1878: @integrity(mode: software_lockstep) an einer freien Funktion.
    var savedLs:     int64 := self.lockstepActive;
    var savedLsName: pchar := self.lockstepName;
    var savedLsLen:  int64 := self.lockstepNameLen;
    self.lockstepActive := 0;
    if (self.cg_integrityMode(ni) == INTEGRITY_LOCKSTEP) {
      self.lockstepActive  := 1;
      self.lockstepName    := fname;
      self.lockstepNameLen := fnlen;
    }
    // Der SIGFPE-Handler wird einmal in main eingehaengt — vor jedem
    // Benutzercode, damit auch ein Trap in der ersten Anweisung ankommt.
    if (self.fcSeen != 0 && fnlen == 4) {
      if StrCharAt(fname, 0) == 109 && StrCharAt(fname, 1) == 97 &&
         StrCharAt(fname, 2) == 105 && StrCharAt(fname, 3) == 110 {
        self.cg_fcInstallHandler();
      }
    }
    // #1878: derselbe Ort fuer den Sweep — Handler und Zeitgeber stehen vor
    // dem ersten Benutzerbefehl, damit auch eine lange erste Berechnung schon
    // ueberwacht ist.
    if (self.scrubSeen != 0 && fnlen == 4) {
      if StrCharAt(fname, 0) == 109 && StrCharAt(fname, 1) == 97 &&
         StrCharAt(fname, 2) == 105 && StrCharAt(fname, 3) == 110 {
        self.cg_scrubInstall();
      }
    }

    // Spill parameters (child0 = first param, linked via next)
    var param: int64 := self.cg_nc0(ni);
    var paramIdx: int64 := 0;
    // #1595-Nachtrag: Mit Struct-Rueckgabe belegt der verdeckte Zeiger rdi,
    // es bleiben also nur FUENF Registerplaetze. Die Schranke stand weiter auf
    // sechs: bei paramIdx == 5 wurde regIdx == 6, kein Spill-Zweig traf, der
    // Parameter bekam einen Slot und wurde nie befuellt — er las 0. Die
    // folgenden Parameter rutschten dann um eine Stelle auf dem Stapel.
    //
    // Sichtbar an `Mat3New(...)`: neun Argumente, Struct-Rueckgabe. Aus
    // 2 1 3 | 0 4 5 | 6 7 1 wurde 2 1 3 | 0 4 0 | 5 6 7. Die AUFRUFSTELLE war
    // korrekt — sie legt fuenf Argumente in Register und den Rest auf den
    // Stapel; der Gerufene erwartete sechs.
    //
    // Nur hier noetig: der Methodenprolog traegt den Versatz schon im
    // Startwert von paramIdx, und geschachtelte Funktionen kennen keine
    // Struct-Rueckgabe ueber diesen Weg.
    var regMax: int64 := 6;
    if (self.fnRetStructBytes > 0) { regMax := 5; }
    while (param != -1 && paramIdx < regMax) {
      var pname: pchar := self.cg_nsval(param);
      var pnlen: int64 := self.cg_nslen(param);
      var off: int64 := self.cg_addLocal(pname, pnlen);
      self.cg_rlBinde(param, off);   // #2114
      // Track param type if it's a user type (NK_TYPE_NAME = 60)
      var ptypeNode: int64 := self.cg_nc0(param);
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == 60) {
        self.cg_setLocalType(self.localCount - 1, self.cg_nsval(ptypeNode), self.cg_nslen(ptypeNode));
      }
      self.cg_markArrayParam(self.localCount - 1, ptypeNode);   // #1115
      self.cg_markMapStrKey(self.localCount - 1, ptypeNode);            // #1291
      // #1003: inline geschriebener fn-Zeigertyp als Parameter
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == CGN_FN_PTR_NODE) {
        poke8(self.localIsFnPtr + self.localCount - 1, 1);
        // #1565: Rueckgabetyp mitfuehren. Diese Markierung steht an VIER
        // Stellen (Methode, verschachtelte fn, Closure, freie Funktion) — die
        // Auskunft muss an jeder davon entstehen, sonst gilt `f(x)` je nach
        // Aufrufort mal als f64 und mal als Ganzzahl.
        // #1622: hier stand `ptypeNode` — den Namen gibt es nicht. Der
        // Rumpf einer Methode wurde nie geprueft, der Bezeichner wurde still
        // zu 0, und diese der vier Stellen aus #1565 war damit tot.
        if (self.cg_fnPtrRetIstF64(ptypeNode) != 0) {
          poke8(self.localFnPtrF64 + self.localCount - 1, 1);
        }
        poke8(self.localFnRetSatz + self.localCount - 1, self.cg_fnPtrRetTiefe(ptypeNode));   // #2143
      }
      // #1595: Bei Struct-Rueckgabe belegt der verdeckte Zeiger rdi.
      var regIdx: int64 := paramIdx;
      if (self.fnRetStructBytes > 0) { regIdx := paramIdx + 1; }
      if (regIdx == 0) { self.cg_spillRdi(off); }
      else if (regIdx == 1) { self.cg_spillRsi(off); }
      else if (regIdx == 2) { self.cg_spillRdx(off); }
      else if (regIdx == 3) { self.cg_spillRcx(off); }
      else if (regIdx == 4) { self.cg_spillR8(off); }
      else if (regIdx == 5) { self.cg_spillR9(off); }
      paramIdx += 1;
      param := self.cg_nnext(param);
    }
    // #1351/#1528: Die Kopie der Wert-Structs steht weiter unten — nach ALLEN
    // Spills, auch denen der Stack-Parameter.
    // L-4: stack params at [rbp+16], [rbp+24], ... (args 7+ passed on caller stack)
    var spOff: int64 := 16;
    while (param != -1) {
      var spName: pchar := self.cg_nsval(param);
      var spNlen: int64 := self.cg_nslen(param);
      var spLocal: int64 := self.cg_addLocal(spName, spNlen);
      self.cg_rlBinde(param, spLocal);   // #2114
      var spType: int64 := self.cg_nc0(param);
      if (spType >= 0 && self.cg_nkind(spType) == 60) {
        self.cg_setLocalType(self.localCount - 1, self.cg_nsval(spType), self.cg_nslen(spType));
      }
      self.cg_markArrayParam(self.localCount - 1, spType);      // #1115
      self.cg_markMapStrKey(self.localCount - 1, spType);            // #1291
      self.cg_loadRax(spOff);
      self.cg_storeRax(spLocal);
      spOff += 8;
      param := self.cg_nnext(param);
    }

    // #1528: Struct-Parameter sind WERTE. Der Aufrufer uebergibt die Adresse
    // (etwas anderes passt nicht ins Register), also wird beim Eintritt eine
    // Kopie angelegt und der Slot auf sie umgebogen — `p.x := 999` im Rumpf
    // trifft dann die Kopie, nicht das Original des Aufrufers.
    //
    // ERST HIER, nach ALLEN Spills: `rep movsq` in cg_emitStructKopie
    // ueberschreibt rdi, rsi und rcx. Zwischen zwei Spills eingefuegt hat es
    // beim ersten Versuch (#1351) das zweite Argument zerstoert — TCPListenerBind
    // band an eine falsche Adresse, waehrend bind() weiter 0 lieferte.
    //
    // `ref` schliesst die Kopie aus. Das ist der Weg fuer die Faelle, die ihren
    // Parameter mit Absicht aendern (MySQLQuery, MongoDocAddString,
    // BGPSendOpen, TerminalDraw und 47 weitere in der stdlib).
    var kopP: int64 := self.cg_nc0(ni);
    while (kopP != -1) {
      var kopTy: int64 := self.cg_nc0(kopP);
      if ((self.cg_nival(kopP) & 2) == 0 && self.cg_typeIstWertStruct(kopTy) != 0) {
        var kopOff: int64 := self.cg_findLocal(self.cg_nsval(kopP), self.cg_nslen(kopP));
        if (kopOff != 0) {
          self.cg_loadRax(kopOff);
          self.cg_emitStructKopieVon(self.cg_inlineStructBytes(kopTy),
                                     self.cg_findClass(self.cg_nsval(kopTy), self.cg_nslen(kopTy)));
          self.cg_storeRax(kopOff);
        }
      }
      kopP := self.cg_nnext(kopP);
    }

    // #1097: Parameter vom Bereichstyp pruefen, nachdem alle abgelegt sind.
    // Der Aufrufer kann einen beliebigen int64 uebergeben haben; die Grenzen
    // stehen im Typ des PARAMETERS, also gehoert die Pruefung an den Eintritt.
    var rgP: int64 := self.cg_nc0(ni);
    while (rgP != -1) {
      var rgIdx: int64 := self.cg_rangeOfTypeNode(self.cg_nc0(rgP));
      if (rgIdx >= 0) {
        self.cg_loadLocalByName(self.cg_nsval(rgP), self.cg_nslen(rgP));
        self.cg_emitRangeCheck(rgIdx, "Parameter"c);
      }
      // #1151: schmaler Parametertyp — der Aufrufer legt einen vollen int64
      // ins Register, gekuerzt wird am Eintritt.
      self.cg_narrowLocalSlot(self.cg_findLocal(self.cg_nsval(rgP), self.cg_nslen(rgP)),
                              self.cg_nc0(rgP));
      rgP := self.cg_nnext(rgP);
    }

    // #1097: Bereichstyp des Rueckgabewerts fuer die `return`-Pruefung merken.
    var savedRetRange: int64 := self.curFnRetRange;
    self.curFnRetRange := self.cg_rangeOfTypeNode(retTyNode);
    // #1151: Breite des Rueckgabetyps ebenso.
    var savedRetNarrow: int64 := self.curFnRetNarrow;
    self.curFnRetNarrow := self.cg_narrowKindOfTypeNode(retTyNode);
    // #2133: Funktionstyp als Rueckgabe — `return` liefert einen Satz.
    var savedRetFnWert: int64 := self.curFnRetFnWert;
    self.curFnRetFnWert := self.cg_typIstFnWert(retTyNode);

    // WP-25.2: Compat-Warnung + WP-R9/R10/R11: Proxy/Landlock/seccomp am Anfang von 'main'
    if fnlen == 4 {
      if StrCharAt(fname, 0) == 109 && StrCharAt(fname, 1) == 97 &&
         StrCharAt(fname, 2) == 105 && StrCharAt(fname, 3) == 110 {
        self.cg_emitCompatWarn();   // WP-25.2: Laufzeit-Warnung wenn Compat-Modus (noop sonst)
        if self.lcbsEnabled != 0 {
          self.cg_emitProxyStart();   // WP-R11: Proxy fork+socketpair (vor Landlock+seccomp)
          self.cg_emitLandlockInit(); // WP-R10: Landlock (vor seccomp)
          self.cg_emitSeccompInit();  // WP-R9: seccomp zuletzt
        }
        // #2136: Anfangswerte der Modulvariablen — NACH der Haertung, damit
        // auch Code in einem Anfangswert unter seccomp/landlock laeuft, und
        // vor dem ersten Befehl des Rumpfs. Nur main des Hauptmoduls; in
        // einer Bibliothek ruft __lyx_so_init (cg_soEmitInit).
        if (self.cgUnitTag == 0 && self.sharedLib == 0 && self.miMainFertig == 0) {
          if (self.cg_miMainBraucht(ni) != 0) {
            self.cg_e8(0xE8);                                   // call __lyx_modinit
            var ppMi: int64 := self.codeLen;
            self.cg_e32(0);
            self.cg_addPatch(ppMi, "__lyx_modinit" as int64, 13, CG_PATCH_CALL);
            self.miMainRuft := 1;
          }
          self.miMainFertig := 1;
        }
      }
    }
    // Generate function body (child2 = block)
    var body: int64 := self.cg_nc2(ni);
    // #1006: defers werden beim Durchlaufen des Rumpfes vorgemerkt und an der
    // jeweiligen Blockgrenze emittiert; ein Vorab-Sammellauf ueber die ganze
    // Funktion gibt es nicht mehr. cg_genBlock arbeitet die defers der
    // aeussersten Ebene am Rumpfende ab, daher hier kein cg_emitDefers.
    self.deferCount := 0;
    self.dfCount    := 0;       // #1030: Argument-Slots gelten je Funktion
    self.loopDeferMark := -1;   // #1006: ausserhalb jeder Schleife
    self.tryDepth      := 0;    // #1148
    self.loopTryMark   := 0;
    self.tryDeferMark  := -1;   // #1118: ausserhalb jedes try
    // #1334: Traegt die Funktion defers, wird sie zum Halt der Abwicklung.
    self.deferMaxCount := 0;
    self.localHigh := self.localCount;
    self.deferDepthSlot := self.cg_emitDeferHalt(body);
    // #2143: der typgeloeschte Rumpf einer generischen Funktion, die einen
    // generischen Typ ueber ihren Typparameter nennt (`Box<T>`), hat keine
    // Klasse dafuer — "Box<T>" gibt es nur je Spezialisierung. Erreichbar ist
    // er nur ueber einen Aufruf OHNE Typargumente oder die Funktion als Wert;
    // er bricht dann laut ab (wie ein Feld ueber T, cg_genFeldOffen). Der
    // IR-Weg ebenso (_genAbhRumpf), die beiden muessen uebereinstimmen.
    if (self.genActN == 0 && self.cg_genHatAbh(ni) != 0) {
      var gaOff: int64 := self.cg_emitCStrData(
        "lyxc: generische Funktion ohne Typargumente aufgerufen, sie nennt einen generischen Typ ueber ihren Typparameter (#2143)\n"c);
      self.cg_emitLeaRdiData(gaOff);
      self.cg_emitPanicBody();
    } else {
      self.cg_genBlock(body);
    }

    self.cg_zeroRax();
    self.cg_emitEpilogue();
    // #1334: Der Landepunkt liegt HINTER dem Rumpf und wird nur ueber longjmp
    // erreicht — der normale Weg ist mit dem Epilog vorbei.
    if (self.deferDepthSlot != 0) {
      poke32(self.code + self.deferLandePatch, self.codeLen - self.deferLandePatch - 4);
      self.localCount := self.localHigh;   // #1334: Namen wieder sichtbar
      self.cg_emitDeferLandepunkt();
      self.deferDepthSlot := 0;
    }

    // Patch sub rsp with aligned frame size
    var fs: int64 := self.frameSize + 15;
    var aligned: int64 := fs - (fs & 15);
    if (aligned == 0) { aligned := 16; }
    poke32(self.code + prologuePatch, aligned);
    self.rlAnz := 0;   // #2114: Zuteilung endet mit dem Rumpf

    // #1138: `@stack_limit(N)` sagt eine obere Schranke fuer den Stapel zu.
    // Hier steht die Rahmengroesse fest — ist schon EIN Aufruf groesser als
    // die Schranke, ist die Zusicherung verletzt, ohne dass es auf Rekursion
    // oder Aufruftiefe ankaeme. Bis 1.0.14J wurde nur vermerkt, dass niemand
    // die Zusage prueft; das ist der erste Teil des Nachweises.
    var slBytes: int64 := (self.cg_nival(ni) >> 16) & 16777215;
    if (slBytes > 0 && aligned > slBytes) {
      EPrintStr("error: "c);
      sys_write(2, fname as int64, fnlen);
      EPrintStr(": @stack_limit("c);
      self.cg_eprintInt(slBytes);
      EPrintStr(") verletzt — der Rahmen belegt "c);
      self.cg_eprintInt(aligned);
      EPrintStrLn(" Byte"c);
      exit(1);
    }

    // WP-EN-04: restore energy level for enclosing scope
    self.fnEnergyLevel := savedEnergy;
    self.fnCpuStufe    := savedCpu;   // #2191
    self.fcActive   := savedFcActive;   // #1140
    self.lockstepActive  := savedLs;         // #1878
    self.lockstepName    := savedLsName;
    self.lockstepNameLen := savedLsLen;
    self.fcMxSlot   := savedFcMx;
    self.fcNameSlot := savedFcName;
    self.curFnRetRange := savedRetRange;   // #1097
    self.curFnRetNarrow := savedRetNarrow; // #1151
    self.curFnRetFnWert := savedRetFnWert; // #2133

    // Restore outer function context
    self.outerFuncName := savedOuterName;
    self.outerFuncNameLen := savedOuterLen;

    // #2135: Ende des Abwickelbereichs — VOR den inneren Funktionen, die
    // ihren eigenen bekommen.
    self.cg_cfi(CFI_ENDE, 0);
    self.cfiInFn := 0;
    // Vorgemerkte verschachtelte Funktionen jetzt emittieren (cg_flushNested).
    self.cg_flushNested();
  }

  // ------------------------------------------------------------------
  // Helper functions emitted at start of code buffer
  // Fixed byte sequences encoding _start, _lyx_strlen, _lyx_print_str,
  // and _lyx_print_int.
  // ------------------------------------------------------------------

  fn cg_emitHelpers() {
    var sStart: int64 := self.codeLen;   // #1389
    if self.kernelMode != 0 {
      // #1389/#1410: freistehendes _start.
      //
      // Die Linux-Fassung setzt als erstes prlimit64 ab und beendet sich mit
      // exit — beides Syscalls, die es hier nicht gibt.
      //
      // #1410: Hier stand `xor edi,edi; xor esi,esi`, mit der Begruendung, auf
      // blankem Blech gebe es keine Argumente. Das war falsch. Argumente im
      // Sinne von argc/argv gibt es nicht — ein UEBERGABEREGISTER aber sehr
      // wohl: der Bootloader reicht dem Kernel seinen boot_info-Zeiger, und
      // `fn main(boot_info_ptr: int64)` erwartet ihn nach SysV in RDI. Das
      // Nullen loeschte ihn, der Kernel las seine Speicherkarte aus Adresse 0.
      //
      // RDI und RSI werden deshalb NICHT angefasst. Damit gilt fuer
      // --target=lyxos-kernel dieselbe Aufrufkonvention wie ueberall sonst in
      // der Sprache: die Firmware setzt RDI (und bei Bedarf RSI) und springt
      // den Eintrittspunkt an. Das ist die einzige Stelle, an der Firmware und
      // lyxc-Code aufeinandertreffen; sie soll keine Sonderregel haben.
      //
      // argc/argv bleiben definiert 0 — ueber rax, nicht ueber rdi/rsi, damit
      // die Uebergabe unberuehrt bleibt. GetArgC/GetArgV liefern also 0 statt
      // dessen, was der Bootloader auf dem Stapel liegen liess.
      self.cg_e8(0x31); self.cg_e8(0xC0);                   // xor eax, eax
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05); // mov [rip+CG_ARGC], rax
      var kArgC: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_addPatch(kArgC, CG_ARGC, 0, CG_PATCH_STR);
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05); // mov [rip+CG_ARGV], rax
      var kArgV: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_addPatch(kArgV, CG_ARGV, 0, CG_PATCH_STR);
      self.cg_e8(0xE8);                                     // call main
      var kMain: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_addPatch(kMain, "main" as int64, 4, CG_PATCH_CALL);
      // Kehrt main zurueck, ist der Kernel fertig — es gibt niemanden, dem man
      // einen Rueckgabewert melden koennte. Anhalten statt exit.
      self.cg_e8(0xFA); self.cg_e8(0xF4);                   // cli; hlt
      self.cg_e8(0xEB); self.cg_e8(0xFD);                   // jmp -3
      while (self.codeLen - sStart) < 79 { self.cg_e8(0x90); }   // feste 79 Bytes
    }
    if self.kernelMode == 0 && self.sharedLib != 0 {
      // #2124: Eine Bibliothek hat keinen Einsprungpunkt. Das Linux-`_start`
      // haette prlimit gesetzt (am Host-Prozess!) und main gerufen; beides
      // gehoert nicht in eine .so. Was davon die Bibliothek braucht —
      // argc/argv und den Canary —, erledigt __lyx_so_init ueber
      // DT_INIT_ARRAY. Die 79 Byte bleiben belegt (feste Handler-Offsets);
      // wer hier landet, landet auf ud2 statt in fremdem Code.
      self.cg_e8(0x0F); self.cg_e8(0x0B);                   // ud2
      while (self.codeLen - sStart) < 79 { self.cg_e8(0xCC); }   // int3
    }
    if self.kernelMode == 0 && self.sharedLib == 0 {
    // ---- _start (65 bytes) ----
    // At Linux ABI entry: [rsp]=argc, [rsp+8]=argv[0], ...
    // First: call prlimit64 to remove RLIMIT_STACK (allows deep recursion in parser)
    // sub rsp, 16       (48 83 EC 10)
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x10);
    // mov rax, -1       (48 C7 C0 FF FF FF FF)  RLIM_INFINITY
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0);
    self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);
    // mov [rsp], rax    (48 89 04 24)  rlim_cur
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x24);
    // mov [rsp+8], rax  (48 89 44 24 08)  rlim_max
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x44); self.cg_e8(0x24); self.cg_e8(0x08);
    // xor edi, edi      (31 FF)  pid = 0
    self.cg_e8(0x31); self.cg_e8(0xFF);
    // mov esi, 3        (BE 03 00 00 00)  RLIMIT_STACK
    self.cg_e8(0xBE); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov rdx, rsp      (48 89 E2)  new_limit = &rlimit_struct
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE2);
    // xor r10d, r10d    (45 31 D2)  old_limit = NULL
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xD2);
    // mov eax, 302      (B8 2E 01 00 00)  SYS_prlimit64
    self.cg_e8(0xB8); self.cg_e8(0x2E); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall           (0F 05)
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // add rsp, 16       (48 83 C4 10)  restore stack
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x10);
    // 5F               pop rdi          -- rdi = argc
    self.cg_e8(0x5F);
    // 48 89 E6         mov rsi, rsp     -- rsi = &argv[0] (argv pointer)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE6);
    // WP-BI-01: save argc and argv to globals so GetArgC/GetArgV/GetArg can read them
    // 48 89 3D xx xx xx xx   mov [rip+CG_ARGC], rdi
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x3D);
    var ppArgC: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(ppArgC, CG_ARGC, 0, CG_PATCH_STR);
    // 48 89 35 xx xx xx xx   mov [rip+CG_ARGV], rsi
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x35);
    var ppArgV: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(ppArgV, CG_ARGV, 0, CG_PATCH_STR);
    // E8 xx xx xx xx   call main        (patched after all functions)
    self.cg_e8(0xE8);
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, "main" as int64, 4, CG_PATCH_CALL);
    // 48 89 C7         mov rdi, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);
    // #1487: exit_group (231 = 0xE7), nicht exit (60). Gleiche Befehlslaenge,
    // die festen Handler-Offsets bleiben unberuehrt.
    // 48 C7 C0 E7 00 00 00   mov rax, 231 (exit_group)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0);
    self.cg_e8(0xE7); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // 0F 05            syscall
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // _start is now 79 bytes  ✓  (WP-BI-01: +14 for argc/argv save)
    }
    if (self.codeLen - sStart) != 79 {
      EPrintStrLn("interner fehler: _start belegt nicht 79 Bytes (#1389)"c);
      exit(1);
    }

    // ---- _lyx_strlen (24 bytes, starts at offset 79) — WP-33: null-pointer guard ----
    // test rdi, rdi
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);
    // jz +15 (to offset 20: xor rax,rax + ret — return 0 for null pointer)
    self.cg_e8(0x74); self.cg_e8(0x0F);
    // xor rax, rax  (len = 0)
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    // cmp byte [rdi+rax], 0
    self.cg_e8(0x80); self.cg_e8(0x3C); self.cg_e8(0x07); self.cg_e8(0x00);
    // jz +5 (to ret at offset 19 — null terminator found, return len)
    self.cg_e8(0x74); self.cg_e8(0x05);
    // inc rax
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC0);
    // jmp -11 (back to cmp at offset 8)
    self.cg_e8(0xEB); self.cg_e8(0xF5);
    // ret (offset 19 — returns len in rax)
    self.cg_e8(0xC3);
    // null case (offset 20): xor rax, rax; ret
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    self.cg_e8(0xC3);
    // strlen is now 24 bytes  ✓

    // ---- _lyx_print_str (26 bytes, starts at offset 103) ----
    // push rdi
    self.cg_e8(0x57);
    // call _lyx_strlen  (push at 103, E8 at 104, PC after = 109; rel32 = 79-109 = -30)
    self.cg_e8(0xE8); self.cg_e32(-30);
    // mov rdx, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2);
    // pop rdi
    self.cg_e8(0x5F);
    // mov rsi, rdi
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xFE);
    // mov edi, 1  (stdout)
    self.cg_e8(0xBF); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov eax, 1  (sys_write)
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // ret
    self.cg_e8(0xC3);
    // print_str is now 26 bytes  ✓

    // ---- _lyx_print_int (104 bytes, starts at offset 129) ----
    // sub rsp, 24          48 83 EC 18
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x18);
    // lea rsi, [rsp+23]    48 8D 74 24 17
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x17);
    // mov rax, rdi         48 89 F8
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF8);
    // test rax, rax        48 85 C0
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    // jnz +8 (to .nonzero at offset+25)  75 08
    self.cg_e8(0x75); self.cg_e8(0x08);
    // mov byte [rsi], '0'  C6 06 30
    self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x30);
    // dec rsi              48 FF CE
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);
    // jmp .emit (+48)      EB 30  (was +43=EB2B; .emit now 5 bytes further due to sign check)
    self.cg_e8(0xEB); self.cg_e8(0x30);
    // .nonzero: test rax, rax  48 85 C0
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    // jge +3 (.digitloop)  7D 03  (was +9; skip only neg rax, sign written after loop)
    self.cg_e8(0x7D); self.cg_e8(0x03);
    // neg rax              48 F7 D8
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xD8);
    // .digitloop: test rax, rax  48 85 C0
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);
    // jz +24 (.sign)       74 18  (displacement unchanged: loop shrunk 6, target shrunk 6)
    self.cg_e8(0x74); self.cg_e8(0x18);
    // xor rdx, rdx         48 31 D2
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);
    // mov rcx, 10          48 C7 C1 0A 00 00 00
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1);
    self.cg_e8(0x0A); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // idiv rcx             48 F7 F9
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);
    // add rdx, 48          48 83 C2 30
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC2); self.cg_e8(0x30);
    // mov [rsi], dl        88 16
    self.cg_e8(0x88); self.cg_e8(0x16);
    // dec rsi              48 FF CE
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);
    // jmp .digitloop (-29) EB E3  (displacement unchanged)
    self.cg_e8(0xEB); self.cg_e8(0xE3);
    // .sign: test rdi, rdi (check original sign; rdi preserved through loop)  48 85 FF
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);
    // jns +6 (skip '-' if non-negative)  79 06
    self.cg_e8(0x79); self.cg_e8(0x06);
    // mov byte [rsi], '-'  C6 06 2D
    self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x2D);
    // dec rsi              48 FF CE
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);
    // .emit: inc rsi       48 FF C6
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC6);
    // lea rdx, [rsp+23]    48 8D 54 24 17
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x17);
    // sub rdx, rsi         48 29 F2
    self.cg_e8(0x48); self.cg_e8(0x29); self.cg_e8(0xF2);
    // inc rdx              48 FF C2
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC2);
    // mov edi, 1           BF 01 00 00 00
    self.cg_e8(0xBF); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov eax, 1           B8 01 00 00 00
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall              0F 05
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // add rsp, 24          48 83 C4 18
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x18);
    // ret                  C3
    self.cg_e8(0xC3);
