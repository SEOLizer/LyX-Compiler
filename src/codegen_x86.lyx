    // `mmap` Nachschub, und win64 kopiert den Helferblock nur bis dorthin
    // woertlich (win_x86.lyx, WIN_HELPERS_SZ) — ein roher Syscall in einer
    // PE-Datei waere genau das, was tests/win64_syscalls_test.sh zaehlt.
    // Dieselbe Erwaegung wie bei __lyx_f64_to_str_chk und dem Map-Kern.
    var bumpStart: int64 := self.codeLen;
    if (bumpStart != CG_H_BUMP) {
      EPrintStr("codegen error: Arena-Helfer beginnt bei "c); EPrintInt(bumpStart);
      EPrintStr(", erwartet "c); EPrintInt(CG_H_BUMP);
      EPrintStrLn(" — CG_H_BUMP anpassen (#2296)"c);
      exit(1);
    }
    // Der Sprung zum Melder gilt NUR fuer diesen Helfer; danach wieder die
    // eigene Kopie, die im Benutzercode richtig ist (sie wird nicht kopiert).
    self.cg_emitBumpAllocRsi();   // rax = Puffer
    self.mmapOomSprung := 0;
    self.cg_e8(0xC3);             // ret
    // Gemessen statt gezaehlt, wie bei den beiden Helfern darueber (#1284):
    // ein Versatz legte den Benutzercode an die falsche Stelle, und das
    // traefe JEDES Programm.
    if (self.codeLen - bumpStart != CG_H_BUMP_LEN) {
      EPrintStr("codegen error: Arena-Helfer hat "c);
      EPrintInt(self.codeLen - bumpStart);
      EPrintStr(" Byte, erwartet "c);
      EPrintInt(CG_H_BUMP_LEN);
      EPrintStrLn(" — CG_H_BUMP_LEN und CG_H_USER anpassen (#2296)"c);
      exit(1);
    }
  }

