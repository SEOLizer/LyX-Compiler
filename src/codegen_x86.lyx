// Codegen class
// ============================================================================


// #1853: Freie Funktionen, KEINE Methoden. Eine zusaetzliche Methode
// verschiebt die Vtable der Klasse, und der Seed stolpert darueber —
// derselbe Hinweis steht in ir_lower.lyx. Beim ersten Anlauf kamen aus
// der Faltung plausible, aber falsche Zahlen (2.0/4.0 = 0.999024).
// #1853: Bits <-> f64. Der Compiler traegt Gleitkommakonstanten als IEEE-
// Bitmuster in einem int64; zum RECHNEN muessen sie kurz wieder Zahlen sein.
// Der Umweg ueber acht Byte Speicher ist der einzige Weg dorthin — einen
// Cast gibt es nicht, und `as f64` wuerde den Wert umwandeln statt die Bits
// umzudeuten.
fn cg_bitsAlsF64(bits: int64): f64 {
  var p: int64 := alloc(8);
  poke64(p, bits);
  var v: f64 := peekf64(p);
  free(p, 8);
  return v;
  }

fn cg_f64AlsBits(v: f64): int64 {
  var p: int64 := alloc(8);
  pokef64(p, v);
  var b: int64 := peek64(p);
  free(p, 8);
  return b;
  }

// #1853: Ein Rechenschritt zwischen zwei Gleitkommakonstanten. Gibt die
// IEEE-Bits des Ergebnisses zurueck.
//
// Division durch 0 wird NICHT abgefangen: fuer Gleitkomma ist sie definiert
// und liefert inf bzw. NaN. Die ganzzahlige Fassung darunter faengt sie ab,
// weil dort eine Division durch 0 die Uebersetzung abbraeche — hier waere
// dasselbe Verhalten falsch und wuerde `1.0 / 0.0` still zu 0 machen.
fn cg_faltF64(bop: int64, lb: int64, rb: int64): int64 {
  var a: f64 := cg_bitsAlsF64(lb);
  var b: f64 := cg_bitsAlsF64(rb);
  if (bop == 70) { return cg_f64AlsBits(a + b); }   // TK_PLUS
  if (bop == 71) { return cg_f64AlsBits(a - b); }   // TK_MINUS
  if (bop == 72) { return cg_f64AlsBits(a * b); }   // TK_STAR
  if (bop == 73) { return cg_f64AlsBits(a / b); }   // TK_SLASH
// Vergleiche liefern 0/1, keine Bits.
  if (bop == 79) { if (a == b) { return 1; } return 0; }  // ==
  if (bop == 80) { if (a != b) { return 1; } return 0; }  // !=
  if (bop == 81) { if (a <  b) { return 1; } return 0; }  // <
  // #2148: 82 ist TK_LE, 83 TK_GT (lexer.lyx). Hier standen sie vertauscht,
  // `X <= Y` und `X > Y` falteten auf f64 also jeweils zum Gegenteil. Die
  // ganzzahlige Faltung in cg_evalConExpr hatte die Zuordnung richtig.
  if (bop == 82) { if (a <= b) { return 1; } return 0; }  // <=
  if (bop == 83) { if (a >  b) { return 1; } return 0; }  // >
  if (bop == 84) { if (a >= b) { return 1; } return 0; }  // >=
// Alles Uebrige gibt es fuer Gleitkomma nicht: %, Schiebeoperationen und
// die Bitverknuepfungen wuerden auf dem Bitmuster arbeiten und etwas
// liefern, das wie eine Zahl aussieht. Melden statt rechnen.
  EPrintStr("error: Operator (Token "c);
  EPrintInt(bop);
  EPrintStrLn(") ist fuer Gleitkomma-Konstanten nicht definiert (#1853)."c);
  EPrintStrLn("  Behandelt werden + - * / und die Vergleiche. Bis 1.1.13A rechnete"c);
  EPrintStrLn("  diese Stelle ganzzahlig auf den IEEE-Bits und lieferte still"c);
  EPrintStrLn("  eine plausible, aber falsche Zahl."c);
  exit(1);
  return 0;
  }

// #2148: Ein eingebauter Ganzzahltyp? Fuer `<f64> as T` im Anfangswert einer
// Konstanten: nur dorthin wird abgeschnitten. Freie Funktion aus demselben
// Grund wie cg_faltF64 (#1853, Vtable).
// #2174: monotone Uhr in Nanosekunden (fuer die Zeitlinie).
fn cg_zlJetztNs(): int64 {
  var ts: int64 := alloc(16);
  clock_gettime(1, ts);
  var r: int64 := peek64(ts) * 1000000000 + peek64(ts + 8);
  free(ts, 16);
  return r;
}

fn cg_istGanzzahlTypName(tp: pchar, tl: int64): int64 {
  if (tl < 2 || tl > 6) { return 0; }
  var i: int64 := 0;
  var c0: int64 := StrCharAt(tp, 0) & 255;
  if (c0 == 117) { i := 1; }                      // u...
  // "int"/"uint" + Breite oder "i"/"u" + Breite
  var rest: int64 := i;
  if (tl - i >= 3 && (StrCharAt(tp, i) & 255) == 105 && (StrCharAt(tp, i + 1) & 255) == 110
      && (StrCharAt(tp, i + 2) & 255) == 116) {
    rest := i + 3;
  } else if (i == 0 && c0 == 105) {
    rest := 1;
  } else if (i == 1) {
    rest := 1;
  } else {
    return 0;
  }
  var bl: int64 := tl - rest;
  if (bl == 1 && (StrCharAt(tp, rest) & 255) == 56) { return 1; }                                     // 8
  if (bl != 2) { return 0; }
  var a: int64 := StrCharAt(tp, rest) & 255;
  var b: int64 := StrCharAt(tp, rest + 1) & 255;
  if (a == 49 && b == 54) { return 1; }   // 16
  if (a == 51 && b == 50) { return 1; }   // 32
  if (a == 54 && b == 52) { return 1; }   // 64
  return 0;
  }

// #1799: Ein unaerer Operator im Anfangswert einer Konstanten, den
// cg_evalConExpr nicht kennt. Vorher wurde daraus still 0.
fn cg_konstOpUnbekannt(uop: int64) {
  EPrintStr("error: unbekannter unaerer Operator (Token "c);
  EPrintInt(uop);
  EPrintStrLn(") im Anfangswert einer Konstanten (#1799)."c);
  EPrintStrLn("  Behandelt werden - (71), ! (87) und ~ (92). Bis 1.1.10C wurde"c);
  EPrintStrLn("  daraus still 0, und der Fehler zeigte sich erst bei der Benutzung."c);
  exit(1);
  }

pub type Codegen = class {

  // Code emission buffer
  code:    int64;
  codeLen: int64;
  codeCap: int64;

  // String literal data buffer
  data:    int64;
  dataLen: int64;
  embeds:     int64;   // #1961: {pfad, pfadLen, dataOff} je 24 Byte
  embedCount: int64;
  embedCap:   int64;
  // #1961 Stufe 2: gesammelte @resource-Angaben, je CG_RES_SZ Byte
  // {namePtr, nameLen, pfadPtr, pfadLen, datenPtr, datenLen, kurzAb}.
  // Ausgelegt wird die Tabelle erst NACH dem Durchlauf (cg_emitResTable) —
  // vorher steht nicht fest, wie viele es sind.
  // #1971: Der Name ist einheitsqualifiziert (`unit:name`, kurzAb = Index des
  // Kurznamens dahinter), der Pfad schon aufgeloest — relativ zu der Datei,
  // die ihn nennt. datenPtr != 0: die Bytes kommen aus einer .lyu, einen
  // Pfad gibt es dann nicht.
  pub ress:      int64;
  pub resCount:  int64;
  resCap:    int64;
  // #1971: Pfad der zuletzt erfolgreich gelesenen Datei (cg_readFile), damit
  // cg_processImportAs die Datei der importierten Unit kennt — Pfade in ihren
  // @embed/@resource gelten relativ zu IHR, nicht zum Hauptprogramm.
  cgLesePfad: int64;
  resTabOff: int64;   // Datenoffset der fertigen Tabelle, -1 solange keine da
  dataCap: int64;

  // Local variable table
  locals:     int64;
  localCount: int64;
  localCap:   int64;
  frameSize:  int64;   // bytes allocated below rbp (grows with each local)
  structArenaOff:  int64;   // #1580/#1595: Datenoffset des Bump-Bereichs, -1 = ungenutzt

  // Function label table
  labels:     int64;
  labelCount: int64;
  labelCap:   int64;

  // Backpatch table
  patches:    int64;
  patchCount: int64;
  patchCap:   int64;

  // FFI imports. externDecls holds every declared `extern fn ... link "lib"`
  // (name + library) for lookup. externSyms holds only the ones actually
  // CALLED — those get a GOT slot, .dynsym/.rela.dyn entry and DT_NEEDED. This
  // lazy registration matters under DT_BIND_NOW: a declared-but-unused extern
  // (or a stale/mis-named one) must not force the loader to resolve it.
  // Both use CG_EXTERN_SZ-byte entries: namePtr,nameLen,libPtr,libLen.
  externDecls:     int64;
  externDeclCount: int64;
  externDeclCap:   int64;
  externSyms:      int64;
  externCount:     int64;
  externCap:       int64;
  // WSP-07: externe Daten-Symbole (extern "asm"). Entry = {namePtr:i64, nameLen:i64} (16 B).
  externData:      int64;
  externDataCount: int64;
  externDataCap:   int64;
  objMode:         int64;   // WSP-07: 1 = ET_REL-Objekt (--emit=obj); extern "asm" nur hier erlaubt
  // #1389: 1 = freistehendes Ziel (--target=lyxos-kernel). Unter dem erzeugten
  // Code laeuft KEIN Linux; jeder `syscall` trifft ins Leere. Betrifft die
  // beiden Handler, die von sich aus einen absetzen: __lyx_canary_init
  // (getrandom) und __lyx_stack_fail (write/exit).
  kernelMode:      int64;
  // #2124: 1 = gemeinsame Bibliothek (--shared fuer x86-64/android-x86_64).
  // Kein `_start`, kein Aufruf von main; Init ueber DT_INIT_ARRAY
  // (__lyx_so_init), je @export/@jni-Funktion eine Huelle nach SysV
  // (cg_soEmitHuellen). Absolute Adressen nur im Datenbereich (die VMT-
  // Adresse im Code wird zu `lea [rip+X]`), geschrieben von cg_writeELFShared.
  // Muss VOR Init gesetzt sein: Init emittiert `_start`.
  sharedLib:       int64;
  soExpTab:        int64;   // je Export 16 Byte: {Knoten, Codeoffset der Huelle}
  soExpCount:      int64;
  soInitOff:       int64;   // Codeoffset von __lyx_so_init
  // #2144: Wo der Schreiber den Code abgelegt hat — Dateioffset und
  // virtuelle Adresse. 0 = noch kein Schreiber gelaufen. --meta-safe liest
  // beides hier, statt 176 und 0x400000 anzunehmen (ms_appendMetaSafe).
  codeFileOff:     int64;
  codeStartVa:     int64;
  // #2136: Anfangswerte von Modulvariablen zur LAUFZEIT — dieselbe Form wie
  // im IR-Weg seit #2123 (ir_lower._modInitEinheit/_modInitHaupt; die beiden
  // muessen uebereinstimmen). Je Unit eine Funktion `__lyx_modinit_<n>`,
  // erzeugt am Ende ihres cg_genFile (Importe also vor dem Importeur), und
  // eine Sammelfunktion `__lyx_modinit`, die main nach der Haertung ruft
  // bzw. in einer Bibliothek __lyx_so_init.
  //   miPend*  — Deklarationsknoten mit Laufzeit-Anfangswert, als Stapel:
  //              eine Unit verarbeitet nur die Eintraege ab ihrem Anfang.
  //   miFn*    — je 16 B: Name der Unit-Funktion (Zeiger, Laenge)
  //   miMainRuft    — 1, wenn main __lyx_modinit ruft
  //   miMainFertig  — 1, sobald main des Hauptmoduls erzeugt ist
  miPendBuf:       int64;
  miPendN:         int64;
  miPendCap:       int64;
  miFnBuf:         int64;
  miFnN:           int64;
  miFnCap:         int64;
  miMainRuft:      int64;
  miMainFertig:    int64;
  // #1262: Namensraum der gerade eingelesenen Unit (`import M as m;`). Solange
  // gesetzt, entstehen Funktionsmarken als "m_Name" — sonst traegt der
  // Codestrom zweimal dasselbe Symbol und ein Aufruf traefe die falsche
  // Funktion. Sema kann das nicht fuer uns erledigen: der Codegen liest die
  // Units ein zweites Mal, unabhaengig davon.
  cgAlias:         int64;
  cgAliasLen:      int64;
  // #1655: Name der Unit, die gerade uebersetzt wird (0 = die Hauptdatei).
  // Marken NICHT-oeffentlicher Funktionen tragen ihn als Praefix, damit zwei
  // Units je ein eigenes privates `_fail` haben duerfen. Ohne das trug der
  // Codestrom zweimal dieselbe Marke, und cg_findLabel nimmt die erste —
  // welche Fassung ein Aufruf trifft, entschied die Import-Reihenfolge.
  cgUnitTag:       int64;
  cgUnitTagLen:    int64;
  // #1655: Namen der privaten Funktionen DIESER Unit — einschliesslich der
  // geschachtelten. Die Tabelle entsteht in einem Vorlauf ueber den Baum,
  // bevor Code erzeugt wird; Deklaration und Aufruf fragen danach dieselbe
  // Quelle. Ein Vorlauf ist noetig, weil ein Aufruf vor der Deklaration
  // stehen darf — wer stattdessen "schon gesehen?" fragt, entscheidet je
  // nach Reihenfolge anders.
  cgUnitPrivTab:   int64;   // Paare (namePtr, nameLen)
  cgUnitPrivCnt:   int64;
  cgUnitPrivCap:   int64;
  // #2097/#2099: private Modulvariablen und Konstanten der laufenden Unit.
  // Je Eintrag 32 Byte: Name, Laenge, Marke, Markenlaenge.
  cgUnitPrivVTab:  int64;
  cgUnitPrivVCnt:  int64;
  conStrengAnf:    int64;   // #2102
  conStreng:       int64;   // #2102
  // #1262: bekannte Import-Aliase (Name/Laenge paarweise), fuer die
  // Aufrufstelle `m.Wert()`.
  cgAliasTab:      int64;
  cgAliasTabCount: int64;

  // Parser output (set by Init)
  pSrc:   pchar;
  pNodes: int64;
  pToks:  int64;

  // #2208: Einbettung kleiner Funktionen.
  //   inlNodes/-Count/-Cap  Ablage der Knotenkopien (cg_klonKnoten)
  //   inlTab/-N/-Cap        einbettbare Funktionen der laufenden Unit
  //   inlArg*               Parametername -> Argumentknoten, nur waehrend
  //                         eines Klonens belegt
  inlNodes:     int64;
  inlNodeCount: int64;
  inlNodeCap:   int64;
  inlTab:       int64;
  inlTabN:      int64;
  inlTabCap:    int64;
  inlArgList:   int64;
  inlArgCount:  int64;
  inlArgCap:    int64;

  // Unique id for anonymous labels (if/while)
  nextLblId: int64;

  // Import deduplication (WP-09: avoid processing same module twice)
  importNames: int64;  // mmap buffer of {ptr:int64, len:int64} pairs (16 bytes each)
  importCount: int64;
  importCap:   int64;

  // Class layout table (WP-09 OOP support)
  classLayouts: int64;   // {namePtr:8, nameLen:8, fieldsPtr:8, fieldCnt:8} each
  classCount:   int64;
  // #2173: Zwischenspeicher fuer cg_findMethodDeclNi — je Klassenindex
  // {pNodes, topLevelHead, Knoten der Typdeklaration}.
  mdCache:      int64;
  mdCacheCap:   int64;
  classCap:     int64;

  // Enum layout table (BUG-08: enum tag analysis for match)
  // Each entry: {namePtr:8, nameLen:8, variantsPtr:8, variantCnt:8} = 32 bytes
  // Each variant: {namePtr:8, nameLen:8, tagValue:8, payloadSize:8} = 32 bytes
  enumLayouts:  int64;
  enumCount:    int64;
  enumCap:      int64;

  // Per-local type tracking (parallel to locals, {typePtr:8, typeLen:8} each)
  localTypes:   int64;

  // Current method class context (set while generating a method body)
  curClassName:    pchar;
  curClassNameLen: int64;

  // Module-level constant table {namePtr:8, nameLen:8, value:8} = 24 bytes per entry
  conTable:   int64;
  conCount:   int64;
  conCap:     int64;
  conIsPchar: int64;  // byte buffer parallel to conTable: 1 = pchar string constant
  // #2026: 1 = der Wert ist ein DATENOFFSET und muss als Adresse geladen
  // werden (LEA), nicht als Zahl (MOV imm64).
  //
  // Bewusst GETRENNT von conIsPchar: das steuerte bis 1.2.5D beides zugleich,
  // die Ladeart UND ob der Ausdruck als pchar gilt. Bei
  // `con H: int64 := "…"c as int64` faellt das auseinander — der Wert ist eine
  // Adresse, der deklarierte Typ aber int64, und `PrintLn(H)` muss die ZAHL
  // ausgeben. Wer hier nur conIsPchar setzte, tauschte einen stillen Fehler
  // gegen einen anderen.
  conIsStrAddr: int64;
  // #1499: dasselbe fuer Gleitkomma. Eine `con PI: f64 := 3.14159` steht in
  // derselben Tabelle wie jede andere Konstante — mit den IEEE-Bits als Wert.
  // Ohne diese Merkung galt sie als Ganzzahl, und `p * PI` multiplizierte zwei
  // Bitmuster. Der Wert war die ganze Zeit richtig; nur wusste niemand, was er
  // bedeutet.
  conIsF64: int64;

  // Break support: linked list of pending jmp-rel32 placeholders in code buffer.
  // curBreakHead holds the code offset of the most recent break's 4-byte placeholder,
  // or -1 if no break is pending. Each placeholder stores the previous head as the link.
  curBreakHead: int64;

  // Continue support: linked list of pending jmp-rel32 placeholders for continue
  curContHead: int64;

  // #1030: Argumente eines aufgeschobenen Aufrufs werden bei der VORMERKUNG
  // ausgewertet und in verdeckte lokale Slots gelegt. dfNodes haelt die
  // Argumentknoten, dfSlots den zugehoerigen Rahmen-Offset. Beim Emittieren
  // des Aufrufs am Blockende liefert cg_genExpr fuer diese Knoten den
  // gespeicherten Wert statt neu auszuwerten.
  dfNodes:  int64;
  dfSlots:  int64;
  dfCount:  int64;
  dfCap:    int64;
  dfReplay: int64;   // 1 = wir emittieren gerade einen aufgeschobenen Aufruf

  // #1006: Stand des defer-Puffers beim Eintritt in den Rumpf der innersten
  // Schleife. break und continue verlassen den Rumpf, ohne dessen Blockende zu
  // erreichen — sie muessen die dort offenen defers vorher selbst abarbeiten.
  // -1 = ausserhalb jeder Schleife.
  loopDeferMark: int64;
  // #1118: Stand des defer-Stapels beim Eintritt in den try-Block. `throw`
  // verlaesst den Block wie ein `break` die Schleife — die offenen defers
  // muessen vorher laufen, sonst leckt die Freigabe genau im Fehlerfall.
  tryDeferMark: int64;
  // #1148: die offenen try-Bloecke der laufenden Funktion. `return`, `break`
  // und `continue` verlassen sie, ohne ihr Blockende zu erreichen — ihre
  // finally-Bloecke liefen deshalb nicht (die Freigabe unterblieb lautlos),
  // und der installierte Ausnahme-Handler zeigte danach auf einen toten
  // Rahmen. Je Ebene: rbp-Offset eines verdeckten Slots mit der jmp_buf-Basis
  // und der Knoten des finally-Blocks (-1 = keiner).
  trySlotBuf:  int64;
  tryFinBuf:   int64;
  tryDepth:    int64;
  tryCap:      int64;
  // Stand von tryDepth beim Eintritt in den innersten Schleifenrumpf; break
  // und continue raeumen nur die try-Bloecke ab, die sie wirklich verlassen.
  loopTryMark: int64;

  // WP-BC-11: or-pattern body forward jump list (je body, linked list of rel32 positions)
  orBodyHead: int64;

  // VMT address patch table (WP-10a): {codeOff:8, classNamePtr:8, classNameLen:8}
  // Each entry says: at code offset codeOff there is a mov-rcx-imm64 placeholder
  // that needs the absolute vaddr of the VMT table for the named class.
  vmtPatches:    int64;
  vmtPatchCount: int64;
  vmtPatchCap:   int64;

  // WP-BC-19: VMT method patch table: {vmtDataSlotOff:8, methodCodeStart:8}
  // After all code is generated, fill each VMT slot with the method's vaddr.
  vmtMethodPatches:     int64;
  vmtMethodPatchCount:  int64;
  vmtMethodPatchCap:    int64;

  // WP-A2.2: base relocations — image RVAs (relative to CG_ELF_BASE) of 8-byte
  // absolute pointers (VMT slots + VMT-address movabs) that consumers must adjust
  // by (load_base − CG_ELF_BASE). Used by the PE .reloc emitter and the LyxOS loader.
  baseRelocBuf:    int64;
  baseRelocCount:  int64;
  baseRelocCap:    int64;

  // #2135: Abwickelangaben (DWARF CFI) — je Ereignis 16 Byte {Codeoffset,
  // Art | Argument << 8}. Gesammelt beim Erzeugen, weil nur der Codegen
  // weiss, wo Prolog, Epilog und Huellen liegen; cg_writeELFShared baut
  // daraus .eh_frame und .eh_frame_hdr (Arten: CFI_*).
  cfiBuf:          int64;
  cfiCount:        int64;
  cfiCap:          int64;
  cfiInFn:         int64;   // 1 = gerade im Rumpf einer Funktion mit rbp-Rahmen

  // f64-returning user-defined functions: {namePtr:8, nameLen:8} = 16 bytes per entry
  // #2004 (Folgebefund): Gibt die GERADE erzeugte Funktion Gleitkomma zurueck?
  // `return 2500;` in einer Funktion mit f64- oder Einheiten-Rueckgabetyp gab
  // die rohe Ganzzahl zurueck, statt sie umzuwandeln.
  fnRetIsFloat: int64;
  f64FuncList:  int64;
  f64FuncCount: int64;
  f64FuncCap:   int64;
  // Function return types (operator overloading Stage 2c): {funcNamePtr:8,
  // funcNameLen:8, retNamePtr:8, retNameLen:8} = 32 bytes per entry. Lets a call
  // expression's static class be resolved (retName -> cg_findClass at lookup).
  fnRetList:  int64;
  fnRetCount: int64;
  // #1122: Elementtypen eines TUPEL-Rueckgabetyps, je Funktion bzw. je
  // gemangelter Methode. Die gewoehnliche Rueckgabetyp-Registry haelt EINEN
  // Namen; ein Tupel hat zwei, und ohne sie blieb der entpackte Wert ohne
  // Typ — `a.v` fand kein Feld und lieferte still 0.
  // Eintrag (48 Byte): {namePtr, nameLen, t0Ptr, t0Len, t1Ptr, t1Len}.
  // #1133: Selektoren — die Namen ALLER in Interfaces deklarierten Methoden,
  // in Deklarationsreihenfolge. Ihr Index ist der VMT-Slot, den JEDE Klasse an
  // derselben Stelle fuehrt. Nur so trifft ein Aufruf ueber den Interface-Typ
  // (wo nur das Interface bekannt ist) die Methode der wirklichen Klasse.
  // Eintrag: {namePtr:8, nameLen:8}.
  ifaceSelList:  int64;
  ifaceSelCount: int64;
  ifaceSelCap:   int64;

  fnTupRetList:  int64;
  fnTupRetCount: int64;
  fnTupRetCap:   int64;
  fnRetCap:   int64;
  // B2: method-Typ-Alias-Namen (Registry für fat-pointer-Detektion)
  methodAliasList:  int64;
  methodAliasCount: int64;
  methodAliasCap:   int64;
  // fn-Typ-Alias-Namen (thin-fn-pointer; lokaler plain-fn-ptr-Call)
  fnAliasList:  int64;
  fnAliasCount: int64;
  fnAliasCap:   int64;
  // #2161: Aliase auf benannte Typen (`type Meter = f64`), je 32 Byte:
  // Name (ptr,len) + Zielname (ptr,len). Aufgeloest wird beim Fragen
  // (cg_aliasZiel), damit auch Aliase importierter Units zaehlen.
  wertAliasList:  int64;
  wertAliasCount: int64;
  wertAliasCap:   int64;

  // #2134: Monomorphisierung generischer Funktionen (siehe cg_genInstanz).
  // Bis 1.2.15A gab es EINEN typgeloeschten Rumpf und je Instanz nur einen
  // Sprung dorthin: `p.x` ueber T fand kein Feld und lieferte still 0,
  // Gleitkomma rechnete auf den IEEE-Bits.
  gfRecs: int64;
  gfN:    int64;
  gfCap:  int64;
  gmRecs: int64;
  gmN:    int64;
  gmCap:  int64;
  // Knotenzahl der aktiven Tabelle (pNodes). Der Treiber setzt sie fuer das
  // Hauptmodul, cg_processImport fuer jede Unit.
  pNodeCount: int64;
  // Deklaration der freien Funktion, deren Rumpf gerade entsteht (-1 in
  // einer Methode) — cg_genFeldOffen fragt, ob es ein typgeloeschter
  // generischer Rumpf ist.
  genCurFd: int64;
  // Marke fuer den naechsten cg_genFuncDecl (Spezialisierung), 0 = keine.
  genOvLbl: int64;
  genOvLen: int64;
  // Die gerade aktive Ersetzung T -> Argument: Eintraege (Adresse des
  // SVAL-Felds, alter Versatz, alte Laenge, neuer Versatz, neue Laenge).
  genActBuf: int64;
  genActN:   int64;

  // WP-13: Closure support - static link for nested functions
  staticLinkOffset: int64;  // rbp offset of static link param (or -1 if not nested)
  // #2114: Locals in r12..r15 (cg_rlWaehlen). rlTab je Eintrag 48 Byte:
  // [0] Name, [8] Laenge, [16] Zahl der Slots, [24] Sicherungsslot des
  // Registers, [32] Puffer der Rahmenversaetze, [40] dessen Kapazitaet. Mehrere Slots, weil der
  // Codegen eine Deklaration mehrfach erzeugen kann (Schleifenrumpf in
  // mehreren Kopien) — jede Kopie legt ihr Local neu an, alle meinen dieselbe
  // Variable. rlAnz = Zahl der gewaehlten Register.
  rlAnz:  int64;
  rlTab:  int64;
  // #2228: Deklarationsknoten je gewaehltem Register (parallel zu rlTab).
  // Gebunden wird ueber den KNOTEN, nicht den Namen: zwei gleichnamige
  // Deklarationen (auch verdeckende, sema laesst das zu) bekommen so je ihre
  // eigene Zuordnung, und keine kann die andere im Register ueberschreiben.
  rlKnoten: int64;
  // #2228: In einer Methode ist `self` Kandidat wie ein Parameter. Sein
  // Kandidatenknoten ist die Methodendeklaration selbst (rlSelfKnoten), der
  // Name wird ueber cg_rlKName gelesen.
  rlSelfKnoten: int64;
  // #2228: zurueckgehaltene Argumente zwischen Auswertung und Pop-Stelle in
  // cg_genCall: direktAb = erster zurueckgehaltener Index + 1 (0 = keine).
  direktAb: int64;
  direktArgs: int64;
  direktMitSelf: int64;
  direktSelf: int64;
  // #2174: Zeitlinie (--time-trace). zlAktiv schaltet die Zaehlung ein;
  // ohne Option bleibt alles 0 und das Erzeugnis unveraendert.
  zlAktiv: int64;
  zlImpNs: int64;    // Zeit in cg_processImportAs (aeusserste Ebene)
  zlImpN:  int64;    // verarbeitete Units (cg_markImported)
  zlTiefe: int64;
  zlFlA: int64; zlFlV: int64;    // cg_findLocal: Aufrufe, Vergleiche
  zlFiA: int64; zlFiV: int64;    // cg_findLocalIdx
  zlFuA: int64; zlFuV: int64;    // cg_findUtype
  // Aufrufe und Tabellengroesse beim Aufruf (obere Schranke der Vergleiche)
  zlFrA: int64; zlFrT: int64;    // cg_funcRetTypeName
  zlLbA: int64; zlLbT: int64;    // cg_findLabel
  zlCoA: int64; zlCoT: int64;    // cg_findConIdx
  zlLnA: int64; zlLnT: int64;    // cg_lineOf (Suchschritte + einmal gelesene Zeichen, #2175)
  // #2310: Merker fuer cg_isF64Expr. Gemessen waren 3,44 Mio Aufrufe je
  // Selbstbau, davon 91,4 % WIEDERHOLUNGEN derselben Frage bei unveraenderter
  // Lage; im Aufrufbaum traegt die Funktion mit ihren Kindern rund ein Fuenftel
  // der Zeit (perf --call-graph: 318 von 1522 Stacks).
  //
  // Die Antwort haengt NICHT nur am Knoten. Fuer CGN_IDENT entscheidet
  // cg_findLocalIdx, also der Stand der Locals-Tabelle: derselbe Knoten
  // antwortet in einer anderen Funktion anders — und schon nach einer
  // weiteren var-Deklaration in DERSELBEN Funktion. Dazu kommen Erfassungen
  // (capturedVars, outerFuncName), Globale, Konstanten und — ueber
  // cg_isF64ElemOf und cg_fieldTypeNameOf — die Klassenlayouts.
  //
  // Deshalb steht die ganze LAGE im Schluessel, statt eine Generation an den
  // Schreibstellen zu zaehlen: eine vergessene Schreibstelle waere ein
  // stiller falscher f64-Befund, und genau diese Fehlerart hat #905, #1373,
  // #1499 und #2287 gekostet. Was im Schluessel steht, kann nicht veralten.
  //
  // Eintrag (80 Byte): ni+1 (0 = leer), pNodes, localBase, localCount,
  // capturedCount, outerFuncName, globalVarCount, conCount, classCount,
  // Antwort.
  zlF4A: int64; zlF4W: int64;
  zlF4Tab: int64; zlF4Cap: int64;
  // #2175: Zeilenanfaenge je Quelltext fuer cg_lineOf. Eintrag (32 Byte):
  // Quelltextzeiger, Laenge, Zeiger auf die aufsteigenden Offsets aller '\n',
  // deren Anzahl. lnLetzt = zuletzt benutzter Eintrag.
  lnTab: int64; lnAnz: int64; lnCap: int64; lnLetzt: int64;
  // #2175: Namensindex (cg_hxNeu) fuer Marken, Modulkonstanten und die
  // Rueckgabetyp-Registry. Er liefert den ERSTEN Eintrag eines Namens, wie
  // die lineare Suche davor; die Tabellen werden nur angehaengt.
  lbHx: int64; coHx: int64; frHx: int64;
  // #2176: je ein Merker fuer die letzte Antwort von cg_findClass und
  // cg_fieldTypeNameOf. Beide werden aus derselben Kette gerufen —
  // cg_isF64Expr -> cg_fieldTypeNameOf -> cg_objClassIdx -> cg_findClass —
  // und dort mehrfach je Ausdruck mit demselben Argument. Im Profil lagen
  // deshalb 4,4 % bzw. 4,2 % in zwei Schleifen, die beide schon knapp sind.
  //
  // Schluessel ist der ZEIGER auf den Namen (plus Laenge), nicht sein Inhalt:
  // gleicher Zeiger heisst gleicher Name, und der Vergleich kostet dann
  // nichts. Ein anderer Zeiger auf denselben Namen verfehlt den Merker nur,
  // die Suche laeuft dann wie bisher. classCount gehoert zum Schluessel,
  // damit eine spaeter angelegte Klasse den Merker nicht veralten laesst.
  fcNameP: int64; fcNameL: int64; fcIdx: int64; fcCnt: int64;
  ftnNi: int64; ftnP: int64; ftnL: int64; ftnCnt: int64;
  zlHxS: int64;                  // #2175: verglichene Eintraege in cg_hxSuch (fuer die Zaehler)
  // #2175: Funktionsindex der obersten Ebene je (Knotentabelle, Kopf,
  // Quelltext), siehe cg_tlEintrag. Eintrag 48 Byte.
  tlTab: int64; tlAnz: int64; tlCap: int64; tlLetzt: int64;
  // #2114: belegt gerade ein linker Operand r11 (cg_lhsRhsNachRbxRax)?
  r11Belegt: int64;
  // #2228: codeLen direkt hinter dem letzten cg_pushRax. Steht die Pop-Stelle
  // eines Aufrufs genau dort, wird aus `push rax; pop reg` ein `mov reg, rax`.
  pushRaxEnde: int64;
  // #2228: codeLen am Anfang des zuletzt ausgegebenen cmp vor einem setcc
  // (cg_emitBinOp, cg_emitBinOpImm, cg_binOpLocalRechts). cg_genSprungWennFalsch
  // braucht ihn, um das Paar cmp+jcc als Ganzes zu verschieben.
  cmpAnfang: int64;
  outerFuncName:    pchar;  // name of outer function (for static link)
  outerFuncNameLen: int64;

  // WP-02: anonymous closure support
  anonFnCounter:         int64;   // counter for unique __anon_N labels
  closureEnvPtrOff:      int64;   // rbp offset of __env_ptr__ in inner fn body (0 = not in closure)
  closureCapturedBuf:    int64;   // pchar array[32]: captured var name ptrs
  closureCapturedLenBuf: int64;   // int64 array[32]: captured var name lengths
  closureCapturedOutBuf: int64;   // int64 array[32]: outer rbp offsets of captured vars
  closureCapturedCount:  int64;   // number of captured variables
  // #2133: je Erfassung der Index des aeusseren Locals (-1 = keiner) — daraus
  // Typ (f64?) und Darstellung (Satz oder Adresse) im Rumpf des Lambdas.
  closureCapturedIdxBuf: int64;
  closureCapturedEnvBuf: int64;   // #2133: >= 0 = Erfassung einer Erfassung (Index in der Umgebung des Erzeugers)
  // #2133: die Listen des ERZEUGERS waehrend der Suche (cg_capSuche) — ein
  // Lambda im Rumpf eines Lambdas findet dessen Erfassungen dort.
  capErzBuf:             int64;
  capErzLenBuf:          int64;
  capErzIdxBuf:          int64;
  capErzCount:           int64;
  // #2133: Funktionswerte. Ein Funktionswert ist entweder die blanke
  // Codeadresse ("duenn") oder ein Heap-Satz {Code, Umgebung}; Umgebung 0
  // heisst "eingepackte Adresse". satzKontext = 1: der naechste Bezeichner
  // oder Aufruf in cg_genExpr soll einen Satz liefern (nicht auspacken).
  satzKontext:           int64;
  fnWertFnList:          int64;   // Funktionen mit Funktionstyp als Rueckgabe (CG_FW_SZ, cg_registerFnWertKandidat)
  fnWertFnCount:         int64;
  fnWertFnCap:           int64;
  curFnRetFnWert:        int64;   // 1 = die gerade erzeugte Funktion gibt einen Funktionswert zurueck
  satzLocalJe:           int64;   // 1 = irgendein Local wurde schon als Satz vermerkt (Abkuerzung)
  // #2245: 1 = diese Funktion traegt einen Stack-Canary. Gesetzt VOR dem
  // Prolog aus cg_funcBrauchtCanary(ni); Prolog und Epilog lesen dasselbe
  // Feld — die beiden muessen uebereinstimmen, sonst prueft der Epilog einen
  // Slot, den der Prolog nie beschrieben hat.
  canaryAn:              int64;
  localBase:             int64;   // cg_findLocal searches [localBase, localCount) only

  // Per-local array flag (WP-10b): byte buffer parallel to locals, 1 = array type
  localIsArray:      int64;
  localElemFloat:    int64;   // #1374: 1 = Elementtyp des Arrays ist f64/f32
  localMapStrKey:    int64;   // #1291: 1 = Map<pchar,V> — Schluessel per Inhalt vergleichen
  localArraySize:    int64;  // WP-BC-51: int64 buffer, stores array length per local (0 = not array)
  // #1230: Zeilenlaenge M eines `[N][M]T`. 0 = eindimensional. Das Layout ist
  // FLACH (N*M Slots hinter einem {cap,len}-Kopf); `m[i]` liefert die Adresse
  // der Zeile i, `m[i][j]` liest von dort mit Schrittweite 8. Zeiger auf
  // Zeiger waere die Alternative gewesen und haette je Zeile eine eigene
  // Belegung gebraucht — genau die fehlte bis 1.0.16G und war der Absturz.
  localArrayRow:     int64;
  globalArrayRow:    int64;
  // WP-3.1: byte buffer parallel to locals, 1 = @redundant var (TMR triple storage)
  localIsRedundant:  int64;

  // #1141: dasselbe fuer GLOBALE Variablen. `@redundant` wirkte dort gar
  // nicht — die Variable bekam 8 Byte im Datensegment, keinen Voter, keine
  // Kopien. Das Attribut war auf Modulebene ein stiller Default.
  globalIsRedundant: int64;

  // #1141: Bilanz der TMR-Zugriffe fuer --verify-tmr. Gezaehlt wird beim
  // Erzeugen des Codes; was am Voter vorbeigeht, wird einzeln gemeldet.
  verifyTmr:     int64;   // 1 = --verify-tmr
  tmrVarCount:   int64;   // deklarierte @redundant-Variablen
  tmrReadVoted:  int64;   // Lesezugriffe ueber die Mehrheitsentscheidung
  tmrWriteTriple:int64;   // Schreibzugriffe in alle drei Kopien
  tmrBypass:     int64;   // Zugriffe am Voter vorbei (Adresse-von)
  // WP-GPU-01: byte buffer parallel to locals, 1 = parallel Array<f32> (SIMD)
  localIsSimd:       int64;
  // #2199: Elementbreite eines `parallel Array<T>`-Locals in BYTE (4 oder 8).
  //
  // Eigenes Feld, kein umgedeutetes: `localElemFloat` traegt an einem
  // gewoehnlichen `Array<f64>` schon die 1, und `localIsSimd` wird an sechs
  // Stellen auf `!= 0` geprueft. Eine der beiden zur Breite zu erklaeren
  // haette eine dieser Stellen stillschweigend etwas anderes bedeuten
  // lassen.
  localSimdBytes:    int64;
  // #2213: Rahmenabstand der Vektorvariablen, in die eine Zuweisung gerade
  // schreibt — oder 1, wenn keine. Positiv kann kein Rahmenabstand sein
  // (cg_addLocal liefert -frameSize), taugt also als "nicht gesetzt";
  // dieselbe Kodierung wie bei der Marke aus #2206, wo `slot < 0` als
  // "nicht gesetzt" die Stelle immer abgewuergt hat.
  simdZielOff:       int64;
  // #2247: `peek32(adr) & 0xFFFFFFFF` ist der vorzeichenLOSE 32-Bit-Zugriff.
  // peek32 erweitert mit Vorzeichen, die Maske schneidet danach die oberen
  // 32 Bit ab — zwei Befehle fuer etwas, das x86 in EINEM kann: ein
  // 32-Bit-Ladebefehl null-erweitert von sich aus.
  //
  // Zwei Felder statt eines, damit die Verdeckungsregeln des Builtins (#1311,
  // #2082: verdeckende Funktion, abweichende Argumentzahl, Methode, innere
  // Funktion) NICHT ein zweites Mal an der Operatorstelle stehen muessen —
  // das waere genau die "zweite Stelle", die hier regelmaessig auseinander
  // laeuft. Der Operator aeussert den Wunsch, cg_genCall meldet die
  // Erfuellung; nur dann darf die Maske entfallen.
  //
  // cg_genCall liest den Wunsch am EINTRITT und loescht ihn sofort, damit er
  // nicht in die Auswertung der Argumente durchsickert.
  // #2296: Wohin ein gescheitertes mmap springen soll, statt einen eigenen
  // Melder mitzubringen — Versatz des OOM-Melders aus Map-Teil 1, oder 0.
  //
  // Gebraucht fuer den Arena-Helfer: der liegt HINTER 1372, und win64 kopiert
  // von dort alles woertlich in die PE (win_x86.lyx, WIN_HELPERS_SZ). Ein
  // eigener Melder waere dort `write` und `exit_group` als rohe Syscalls —
  // tests/win64_syscalls_test.sh zaehlt genau das, und mit der ersten Fassung
  // stieg die Zahl von 3 auf 5. Der Melder in Map-Teil 1 liegt VOR 1372 und
  // wird nicht kopiert.
  mmapOomSprung:     int64;
  p32Wunsch:         int64;
  p32Erfuellt:       int64;
  // #1003: byte buffer parallel to locals, 1 = INLINE geschriebener fn-Zeigertyp
  // (`var f: fn(int64): int64`). Ueber einen Typalias merkt sich das die
  // fnAlias-Liste am Namen; ein inline geschriebener Typ HAT keinen Namen und
  // fiel deshalb in den Closure-Pfad, der {fnPtr,env} erwartet -> Absturz.
  localIsFnPtr:      int64;
  // #1565: Traegt der Funktionszeiger einen Fliesskomma-Rueckgabetyp? Der Name
  // eines Zeiger-Aufrufs steht in keiner Funktionsregistry, also muss die
  // Auskunft am Local haengen.
  localFnPtrF64:     int64;
  // #2143: Liefert ein Aufruf ueber dieses Local einen Funktionswert, also
  // einen Satz {Code, Umgebung}? Ein Lambda (oder ein `fn(...)`-Typ) mit
  // Funktionstyp als Rueckgabe — dieselbe Auskunft wie fnWertFnList fuer
  // benannte Funktionen, nur am Local, weil der Name keine Funktion ist.
  localFnRetSatz:    int64;
  foldBuf:          int64;  // WP-10g: scratch for cg_tryFold constant-folding results

  // Temporary buffer tracking (BUG-02: prevent mmap leaks)
  // Each entry: {bufPtr:8, bufSize:8} = 16 bytes
  tempBufs:      int64;
  tempBufCount:  int64;
  tempBufCap:    int64;

  // WP-13: Captured variable table for nested functions
  // Each entry: {outerFuncPtr:8, outerFuncLen:8, varNamePtr:8, varNameLen:8, offset:8} = 40 bytes
  capturedVars:      int64;
  capturedCount:     int64;
  capturedCap:       int64;

  // Global variable table: {namePtr:8, nameLen:8, dataOff:8} = 24 bytes per entry
  globalVars:     int64;
  globalVarCount: int64;
  globalVarCap:   int64;
  globalIsPchar:  int64;  // byte buffer parallel to globalVars: 1 = pchar type
  // #1574: 1 = globale Variable traegt einen Funktionszeiger. Ohne diese
  // Spalte deutete der Codegen `gFn(4.0)` als Aufruf einer FUNKTION dieses
  // Namens und meldete "undefined function 'gFn'" — lokal ging derselbe Typ
  // laengst (localIsFnPtr).
  globalIsFnPtr:  int64;
  // #1574: 1 = der Zeiger liefert Gleitkomma. Dieselbe Spalte wie
  // localFnPtrF64 (#1565) — ohne sie faellt `var v: f64 = gFn(4.0)` still auf
  // int64 zurueck und aus 12.0 wird 4622945017495814144.
  globalFnPtrF64: int64;
  // #2150: 1 = Modulvariable vom Typ Map<pchar, V> — Gegenstueck zu
  // localMapStrKey (#1291). Ob eine Globale ueberhaupt eine Map ist, steht
  // im Typnamen (globalTypeNames, "Map"); der Schluesseltyp nur hier.
  globalMapStrKey: int64;
  // #1587: Pruefmodus fuer `--compile-unit`. Der Codegen laeuft vollstaendig
  // durch, damit seine Diagnose greift; das Erzeugnis wird verworfen. Eine
  // Unit hat aber kein `main` — der Einsprungpunkt, den Init vorsorglich
  // emittiert, bleibt hier ohne Ziel und darf deshalb nicht als Fehler gelten.
  unitCheckMode: int64;
  // #2014 Stufen 2–4: 1, solange eine Unit aus den DEKLARATIONEN einer .lyu
  // verarbeitet wird (LyuReader.LyrDeklText). Ihre Funktionen und Methoden
  // haben dann keinen Rumpf — der Code fehlt auf x86 bis Stufe 5. Es entsteht
  // nichts unter ihrem Namen: ein Aufruf bleibt unaufgeloest und wird in
  // cg_patchAll mit Begruendung gemeldet (cgLyuNamen).
  cgNurDekl: int64;
  cgLyuNamen: int64;   // {ptr, len} je Name ohne Code (Funktion oder Klasse_Methode)
  cgLyuNamenN: int64;
  cgLyuNamenCap: int64;
  // #1589: `con f: fn(...) := Dbl;` — ein con mit Funktionsverweis. Der Wert
  // ist eine Codeadresse, die erst feststeht, wenn die Funktion emittiert ist.
  // Gemerkt wird das Paar; nach dem Emittieren bekommt der con-Name dieselbe
  // Marke wie die Funktion, damit Aufruf UND Adressnahme ohne Sonderweg gehen.
  conFnTab:     int64;   // {aliasPtr, aliasLen, zielPtr, zielLen} je 32 Byte
  conFnCount:   int64;
  conFnCap:     int64;
  // #1589: Name des zuletzt erzeugten anonymen Funktionsrumpfs.
  lastAnonName:    int64;
  lastAnonNameLen: int64;
  // #1580: Bump-Bereich fuer Wert-Kopien von Structs. -1 = noch nicht angelegt.
  // #1256/#1299: Ein globales AGGREGAT — `[N]T` oder ein Struct — passt nicht
  // in den 8-Byte-Slot. Der Slot traegt deshalb einen ZEIGER auf einen eigenen
  // Block im Datenbereich, genau wie ein Local auf seinen mmap-Block zeigt.
  // Bis 1.0.16G blieb dieser Slot 0: `q[0] := 3` schrieb nach Adresse 16 und
  // stuerzte ab, `s.x := 3` verpuffte, ein Startwert fiel weg.
  // 2 = feste Groesse `[N]T` (Laenge in globalArraySize), 3 = Struct/Klasse.
  globalIsArray:  int64;  // byte buffer parallel zu globalVars
  globalArraySize: int64; // int64-Puffer: Elementzahl bei 2, sonst 0
  // #1094: deklarierter Typname je globaler Variable {ptr:8, len:8}, parallel
  // zu globalVars. Ohne ihn waere der statische Typ einer globalen Variablen
  // im Codegen nicht bestimmbar — `g is int64` muesste dann melden statt zu
  // antworten.
  globalTypeNames: int64;
  // #1094: Laenge des zuletzt von cg_staticTypeName gelieferten Typnamens.
  stnLen:         int64;
  // #1097: Bereichstypen {namePtr:8, nameLen:8, lo:8, hi:8, flags:8} = 40 Byte.
  // #1882: flags Bit0 = `wraps` statt `range` — melden oder umrechnen.
  rangeTypes:      int64;
  rangeTypeCount:  int64;
  rangeTypeCap:    int64;
  // #1110: Einheitentypen. Eintrag: {namePtr, nameLen, faktor, dimPtr, dimLen,
  // rngLo, rngHi, flags} = 64 Byte. flags Bit0 = Grenzen vorhanden,
  // Bit1 = `wraps` statt `range`.
  utypes:          int64;
  utypeCount:      int64;
  utypeCap:        int64;
  // #1097: Bereichstyp des Rueckgabewerts der gerade erzeugten Funktion (-1 = keiner).
  curFnRetRange:   int64;
  // #1151: Breite des Rueckgabetyps der gerade erzeugten Funktion (0 = voll).
  curFnRetNarrow:  int64;

  // WP-BC-40: Compile-time profiling entry table (x86_64 only)
  // Entry: {namePtr:8 (src ptr), nameLen:8, dataOff:8, nameDataOff:8} = 32 bytes
  // dataOff → data section: tsc_start(8) + call_count(8) + total_cycles(8) = 24 bytes
  // nameDataOff → data section: name string (for profile_report output)
  profEntries:    int64;
  profEntryCount: int64;
  profEntryCap:   int64;

  // WP-BC-25: DWARF debug info generation
  debugMode:   int64;
  srcFilePath: pchar;
  srcFileLen:  int64;

  // WP-BC-48: --runtime-checks — emit bounds/null/zero checks inline
  runtimeChecks: int64;

  // WP-CS-07: @io_check / @overflow_check runtime flags
  ioCheckEnabled:       int64;  // 0=off (default), 1=on
  overflowCheckEnabled: int64;  // 0=off (default), 1=on

  // WP-CS-09: cached data offset of the io_error message string; -1 = not yet emitted
  ioCheckMsgOff: int64;

  // WP-CS-10: cached data offset of the overflow error message string; -1 = not yet emitted
  overflowMsgOff: int64;

  // WP-EN-01: energy levels — 0 = not set (codegen will default to 3)
  globalEnergyLevel: int64;  // from CLI --target-energy
  // #2191: Mindest-CPU aus --target-cpu bzw. @cpu(...). 0 = baseline,
  // 1 = sse4, 2 = avx2, 3 = avx512. Jede Emissionsstelle, die mehr als den
  // Grundbestand braucht, fragt cg_cpuHat() — und scheitert laut, wenn die
  // Stufe es nicht deckt, statt etwas Plausibles zu emittieren.
  cgCpuStufe:   int64;
  fnCpuStufe:   int64;   // wirksame Stufe der laufenden Funktion
  fnEnergyLevel:     int64;  // effective for current function
  // #1162: `@energy(N);` als Direktive vor/zwischen den Deklarationen. Auf
  // oberster Ebene nimmt der Parser diese Schreibweise als eigenen Knoten,
  // nicht als Annotation der folgenden fn — der Wert ging deshalb verloren,
  // sobald genFunc die Stufe neu bestimmte. Er steht hier als Quelltext-Stand
  // und schlaegt das CLI-Flag; 0 = nicht gesetzt.
  scopeEnergyLevel:  int64;
  scopeCpuStufe:     int64;   // #2191: Stand aus `@cpu(stufe);`
  vecMarkeEnde:      int64;   // #2206: Rahmenplatz der END-Marke der Vektorarena
  vecMarkeSumme:     int64;   // #2253: Rahmenplatz des gesicherten CG_VEC_SUM

  // WP-AS-04/05: @bounds_check / @debug_info / @optimization_level scope flags
  boundsCheckEnabled: int64;  // 1=on (default 1), 0=off
  // #1124: Wurde @bounds_check(true) GESCHRIEBEN? Der Vorgabewert von
  // boundsCheckEnabled ist 1, "an" liess sich davon also nicht unterscheiden —
  // die Direktive konnte nur abschalten. Wer sie setzte, bekam ohne
  // --runtime-checks dieselbe Binary wie ohne sie.
  boundsCheckForced: int64;   // 1 = @bounds_check(true) gesehen
  // #1674: 1 = Ziel win64. Die Microsoft-x64-Konvention uebergibt in
  // rcx/rdx/r8/r9 statt rdi/rsi/rdx/rcx und verlangt vom Aufrufer 32 Byte
  // Schattenspeicher. Bis 1.1.3D erzeugte der FFI-Pfad auch fuer win64 die
  // SysV-Form: ein Aufruf OHNE Argumente ging gut, jeder MIT Argumenten kam
  // falsch an (lstrlenA("abc") lieferte 7 statt 3).
  msAbi:             int64;
  // #2151: Das Feld stand hier ein zweites Mal (samt Kommentar) — gefunden von
  // der Doppelpruefung, die jetzt auch importierte Units sieht.
  debugInfoEnabled:   int64;  // set by @debug_info(true) — aliases debugMode
  optLevel:           int64;  // 0=none, 1=min, 2=default, 3=aggressive

  // WP-AS-10: defer emission buffer (LIFO)
  deferBuf:   int64;  // mmap'd int64 array of node indices
  deferCount: int64;
  deferCap:   int64;
  // #1334: Rahmen-eigener Ausnahme-Halt. Der Codegen weiss STATISCH, welche
  // defers eine Funktion traegt — zur Laufzeit weiss er aber nicht, wie weit
  // der Rumpf gekommen ist, wenn eine Ausnahme aus einer TIEFEREN Funktion
  // hereinschlaegt. Deshalb ein Zaehler im Rahmen: jede defer-Anmeldung setzt
  // ihn hoch, der Landepunkt liest ihn und arbeitet genau die angemeldeten ab.
  // 0 = diese Funktion hat keinen (kein defer im Rumpf).
  deferDepthSlot: int64;
  // #1334: Hoechststand der Anmeldungen in dieser Funktion. deferCount selbst
  // taugt am Landepunkt nicht: cg_genBlock setzt ihn am Blockende auf den
  // Stand bei Blockeintritt zurueck, am Rumpfende steht dort also 0. Die
  // Eintraege im Puffer bleiben — nur der Zeiger wandert.
  deferMaxCount: int64;
  // #1334: Hoechststand der Lokalentabelle. cg_genBlock setzt localCount am
  // Blockende zurueck; die EINTRAEGE bleiben stehen, nur der Zeiger wandert.
  // Der Landepunkt liegt hinter dem Rumpf und muss die Namen wiederfinden —
  // sonst loest `x` in einem aufgeschobenen Aufruf zu nichts auf und der
  // Aufruf bekommt 0 statt des Wertes.
  localHigh: int64;
  deferLandePatch: int64;   // #1334: Patchstelle der Landepunktadresse

  // Verschachtelte fn-Deklarationen, die nach der äußeren Funktion emittiert
  // werden. Inline emittiert liefe die äußere Funktion in den Rumpf hinein.
  nestedBuf:   int64;
  nestedCount: int64;
  nestedCap:   int64;
  // #2044: eindeutige Marken fuer innere Funktionen (cg_nestPlan).
  // nestMap   — je 40 B: pNodes, Knoten, Marke, Markenlaenge, Deklarationsknoten.
  //             Eingetragen werden die Deklaration selbst und jeder Aufruf
  //             bzw. Bezeichner, der sie meint.
  // nestScope — der Gueltigkeitsstapel waehrend des Vorpasses, je 40 B: Name,
  //             Laenge, Marke (0 = durch Variable/Parameter verdeckt),
  //             Markenlaenge, Deklarationsknoten.
  nestMap:      int64;
  nestMapCnt:   int64;
  nestMapCap:   int64;
  nestScope:    int64;
  nestScopeCnt: int64;
  nestScopeCap: int64;

  // WP-04: set to 1 when current function has a [T, T] tuple return type
  funcHasTupleReturn: int64;
  // #1595: Rueckgabe eines STRUCTS by value. Bis 1.1.3H holte der Aufgerufene
  // seinen Platz aus einem Bump-Bereich, der nie zurueckgegeben wurde: 200 000
  // Rueckgaben belegten 6 MB, zwei Millionen 62 MB — linear, ohne Ende.
  //
  // Jetzt stellt der AUFRUFER den Platz und reicht die Adresse als verdecktes
  // erstes Argument durch; der Aufgerufene schreibt hinein. Damit gibt es
  // keine Belegung mehr, die freigegeben werden muesste.
  //
  // Groesse der Struct-Rueckgabe der gerade uebersetzten Funktion (0 = keine),
  // und der Rahmenplatz, in dem der verdeckte Zeiger liegt.
  fnRetStructBytes: int64;
  fnRetSlotOff:     int64;

  // #1140: @flight_crit — SSE-Ausnahmen fuer *invalid* und *divide-by-zero*
  // sind in der annotierten Funktion freigeschaltet. fcSeen sagt, ob das
  // Programm ueberhaupt eine solche Funktion hat (dann wird der SIGFPE-Handler
  // installiert); fcActive gilt waehrend der Erzeugung EINER solchen Funktion
  // und laesst den Epilog den alten MXCSR zurueckschreiben.
  fcSeen:      int64;
  fcActive:    int64;
  // #1878: @integrity. `scrubSeen` sagt, ob das Programm ueberhaupt einen
  // periodischen Sweep braucht; `lockstepActive` gilt je Funktion und schaltet
  // die doppelte Berechnung des Rueckgabeausdrucks ein.
  scrubSeen:        int64;
  unitScrubbed:     int64;   // #1916: @integrity(mode: scrubbed) vor `unit`
  lcbsBpfDone:      int64;   // #1878: BPF steht schon — ein spaeter Sweep waere ungedeckt
  scrubEmitted:     int64;   // Handler nur EINMAL — cg_genFile laeuft je Import erneut
  scrubPtrCell:     int64;   // Datenzelle mit der Adresse der Hashtabelle (0 = keine)
  scrubTableOff:    int64;   // Offset der Tabelle im Datenbereich
  scrubPageCount:   int64;
  scrubStride:      int64;   // Abstand der drei Kopien, Vielfaches von 4096
  integrityIntervalMs: int64;
  lockstepActive:   int64;
  lockstepSeen:     int64;   // irgendwo im Programm: Abbruchpfad wird gebraucht
  lockstepFailEmitted: int64;
  lockstepName:     pchar;   // Funktionsname fuer die Meldung
  lockstepNameLen:  int64;
  fcMxSlot:    int64;   // rbp-Offset: gesicherter MXCSR (+4: der entschaerfte)
  fcNameSlot:  int64;   // rbp-Offset: vorheriger Wert von _lyx_fc_name

  // #1370: --profile — jede Funktion bekommt Eintritts- und Austrittsmessung,
  // und `main` ruft beim Verlassen den Bericht. profCurName/-Len tragen den
  // Namen der gerade uebersetzten Funktion; ohne ihn wuesste der Prolog nicht,
  // welchen Eintrag er zaehlen soll.
  profileAll:  int64;
  profCurName: pchar;
  profCurLen:  int64;

  // Import search paths (mirrors sema's includePath/stdPath)
  // Set by lyxc after CLI parsing / env-var reading
  includePath: int64;  // pchar to extra include dir, 0 = not set
  stdPath:     int64;  // pchar to stdlib root, 0 = not set

  // WP-LIC-10: license watermark — set by lyxc after successful verification
  licenseKey:    int64;   // pchar to 29-char key (e.g. "WXDHJ-NFZ18-…"), 0 = no watermark
  licenseKeyLen: int64;   // always 29 when set

  // #1342: Vorgabewerte IMPORTIERTER Funktionen. Der Codegen sucht die
  // Deklaration nur in der eigenen Modulkette (WP-MEM-05); die Knoten einer
  // importierten Unit sind nach dem Import ohnehin fort. Beim Einlesen ist der
  // Ausdruck aber lesbar — konstante Vorgaben werden hier abgeschrieben und am
  // Aufrufpunkt eingesetzt.
  // Eintrag (48 Byte): namePtr, nameLen, paramIdx, art, wert, wert2
  //   art 1 = Ganzzahl/Wahrheitswert (wert), 2 = f64-Bits (wert),
  //       3 = Zeichenkette (wert = Zeiger, wert2 = Laenge)
  defTab:      int64;
  defCount:    int64;
  defCap:      int64;

  // WP-MEM-05: top-level AST head for default-param lookup in cg_genCall
  topLevelHead: int64;
  // #1252: geordnete Argumentliste eines Aufrufs mit benannten Argumenten UND
  // einer Luecke, die ein Vorgabewert schliesst. Sie entsteht nur fuer diesen
  // Fall; jeder andere Aufruf laeuft weiter ueber die Knotenkette.
  cgOrdBuf: int64;

  // WP-R9: seccomp-BPF
  lcbsCapBuf:     int64;  // alloc'd int64[64]: collected capIds
  lcbsCapCount:   int64;
  lcbsBpfDataOff: int64;  // data section offset of BPF instructions (-1 = disabled)
  lcbsBpfCount:   int64;  // number of BPF instructions
  lcbsEnabled:    int64;  // 1 if any @capabilities annotation found → install seccomp

  // WP-R10: Landlock
  lcbsLandlockHandled:    int64;  // handled_access_fs bitmask für landlock_create_ruleset
  lcbsLandlockAllowed:    int64;  // allowed_access für "/" Regel (0 = keine fs-Caps)
  lcbsLandlockHasDev:     int64;  // 1 wenn Hardware-Caps → /dev-Regel
  lcbsLandlockDevAllowed: int64;  // allowed_access für "/dev" Regel

  // WP-R11: Userspace-Netzwerk-Proxy
  lcbsProxyEnabled:    int64;  // 1 wenn Netzwerk-Proxy-Caps vorhanden
  lcbsProxyBpfDataOff: int64;  // Daten-Offset des Proxy-BPF-Filters
  lcbsProxyBpfCount:   int64;  // Anzahl Proxy-BPF-Befehle
  lcbsProxyCodeOff:    int64;  // Code-Offset der proxy_loop-Funktion
  lcbsProxyFdDataOff:  int64;  // Daten-Offset für proxy_fd-Speicher (4 Bytes)

  // WP-H12: Hardware-Capability-Argumente und Gerätepfad-Offsets
  lcbsHwArgBuf:     int64;  // alloc'd [capId(8), arg0(8), arg1(8)] × 32 Einträge = 768 Bytes
  lcbsHwArgCount:   int64;
  lcbsHwDevPathOff: int64;  // alloc'd int64[32]: Datensektion-Offsets der Gerätepfad-Strings
  // #1173: `path:`-Argumente der fs-Capabilities. Bis 1.0.15D wirkte
  // @capabilities([fs.read(path: "/tmp")]) als Ja/Nein — es entstand EINE
  // Landlock-Regel fuer "/", der genannte Pfad ging in die Rechnung nicht ein.
  // Ein Zugriff ausserhalb von /tmp gelang also trotzdem.
  lcbsFsArgBuf:     int64;  // alloc'd [capId(8), strNodeIdx(8), reserviert(8)] × 32
  lcbsFsArgCount:   int64;
  lcbsFsPathOff:    int64;  // alloc'd int64[32]: Datensektion-Offsets der Pfad-Strings
  // 1 = mindestens eine fs-Capability OHNE path:. Dann bleibt die "/"-Regel,
  // sonst waere die Sandbox schaerfer als deklariert.
  lcbsFsCapNoPath:  int64;

  // WP-T13: Audit-Daten (gesammelt in cg_collectCaps)
  lcbsMissingGrants:  int64;  // Anzahl Imports ohne explizites grant
  lcbsFastpathCount:  int64;  // Anzahl @fastpath-Nutzungen
  lcbsAuditSrcPath:   pchar;  // Quell-Dateipfad (gesetzt von lyxc.lyx vor Generate)

  // WP-T14: --capabilities=compat: kein seccomp/landlock/proxy trotz @capabilities
  lcbsCompatMode:     int64;  // 1 = Compat-Modus aktiv (gesetzt von lyxc.lyx)
  lcbsSeccompTrap:    int64;  // #1348: 1 = SECCOMP_RET_TRAP statt KILL_PROCESS
  lcbsUsesTls:        int64;  // #1348: Programm importiert std.net.tls/https
  // WP-25: Runtime-Warnung im generierten Binary
  lcbsCompatWarnOff:  int64;  // Daten-Offset der Warnung (-1 = nicht gesetzt)
  lcbsCompatWarnLen:  int64;  // Länge der Warnung in Bytes
  // WP-6: W^X — 1 wenn zwei PT_LOAD-Segmente (RX + RW) emittiert werden
  lcbsWxActive:       int64;

  // WP-34: overflow flags — set when code/data buffer exceeds 512 MB limit
  codeOverflow: int64;
  dataOverflow: int64;

  // ------------------------------------------------------------------
  // Raw byte emitters (code buffer)
  // ------------------------------------------------------------------

  fn cg_trackTempBuf(buf: int64, size: int64) {
    if (self.tempBufCount >= self.tempBufCap) {
      var nc: int64 := self.tempBufCap * 2;
      var nb: int64 := alloc(nc * 16);
      var i: int64 := 0;
      memcpy(nb, self.tempBufs, self.tempBufCount * 16);
      if (self.tempBufs != 0) { free(self.tempBufs, self.tempBufCap * 16); }
      self.tempBufs := nb;
      self.tempBufCap := nc;
    }
    var base: int64 := self.tempBufs + self.tempBufCount * 16;
    poke64(base,     buf);
    poke64(base + CG_TEMPBUF_OFF_SIZE, size);
    self.tempBufCount += 1;
  }

  fn cg_freeAllTempBufs() {
    var i: int64 := 0;
    while (i < self.tempBufCount) {
      var base: int64 := self.tempBufs + i * 16;
      var buf:  int64 := peek64(base);
      var size: int64 := peek64(base + CG_TEMPBUF_OFF_SIZE);
      free(buf, size);
      i += 1;
    }
    self.tempBufCount := 0;
  }

  fn cg_grow() {
    var nc: int64 := self.codeCap * 2;
    // WP-34: 512 MB limit — prevents OOM via crafted large inputs
    if (nc > 536870912) {
      EPrintStrLn("error: codegen: Codepuffer überschreitet 512-MB-Limit"c);
      self.codeOverflow := 1;
      return;
    }
    var nb: int64 := alloc(nc);
    var i: int64 := 0;
    memcpy(nb, self.code, self.codeLen);
    self.code := nb; self.codeCap := nc;
  }

  fn cg_e8(b: int64) {
    // WP-34: stop writing if code buffer overflow was detected
    if (self.codeOverflow != 0) { return; }
    if (self.codeLen >= self.codeCap) { self.cg_grow(); }
    poke8(self.code + self.codeLen, b & 255);
    self.codeLen += 1;
  }

  fn cg_e32(n: int64) {
    self.cg_e8(n); self.cg_e8(n >> 8); self.cg_e8(n >> 16); self.cg_e8(n >> 24);
  }

  fn cg_e64(n: int64) {
    self.cg_e32(n); self.cg_e32(n >> 32);
  }

  // ------------------------------------------------------------------
  // Data buffer emitter
  // ------------------------------------------------------------------

  fn cg_growData() {
    var nc: int64 := self.dataCap * 2;
    // WP-34: 512 MB limit for data buffer as well
    if (nc > 536870912) {
      EPrintStrLn("error: codegen: Datenpuffer überschreitet 512-MB-Limit"c);
      self.dataOverflow := 1;
      return;
    }
    var nb: int64 := alloc(nc);
    var i: int64 := 0;
    memcpy(nb, self.data, self.dataLen);
    self.data := nb; self.dataCap := nc;
  }

  fn cg_edata(b: int64) {
    // WP-34: stop writing if data buffer overflow was detected
    if (self.dataOverflow != 0) { return; }
    if (self.dataLen >= self.dataCap) { self.cg_growData(); }
    poke8(self.data + self.dataLen, b & 255);
    self.dataLen += 1;
  }

  // ------------------------------------------------------------------
  // Node accessors (prefixed cg_ to avoid VMT collision with Parser)
  // ------------------------------------------------------------------

  // #2208: Knoten kommen aus ZWEI Ablagen. Unter CG_INL_BASIS liegen die des
  // Parsers, darueber die KOPIEN, die die Einbettung anlegt (cg_klonKnoten).
  //
  // Eine zweite Ablage ist noetig, weil der Codegen die Kapazitaet des
  // Parser-Puffers nicht kennt — nur den Zeiger und die Zahl der belegten
  // Knoten. Anhaengen wuerde in fremden Speicher schreiben.
  //
  // Dass eine einzige Stelle genuegt, ist der Grund fuer diesen Weg: ALLE
  // Zugriffe (cg_nkind, cg_nc0..c3, cg_nnext, cg_nival, cg_nsval, cg_nslen)
  // gehen hier durch. Der vorige Versuch hatte stattdessen im Emitter
  // ersetzt und scheiterte daran, dass Bezeichner an mindestens acht Stellen
  // aufgeloest werden — die Schnellwege aus #2114 gehen nicht ueber
  // cg_genExpr. Eine Kopie des Baums braucht nirgends einen Sonderfall.
  // #2228: Knotenadresse VERZWEIGUNGSFREI als ein Ausdruck: liegt i in der
  // Ablage der Einbettung (i >= CG_INL_BASIS), kommt der Versatz zwischen
  // den beiden Ablagen dazu, sonst 0. Gleichbedeutend mit
  //   i >= CG_INL_BASIS ? inlNodes + (i - CG_INL_BASIS) * 88 : pNodes + i * 88
  // Als ein `return <ausdruck>` ohne Aufruf sind die Zugriffe unten selbst
  // einbettbar (Methoden-Einbettung, cg_genCall) — mit `if` und zwei
  // `return` waren sie es nicht. Sie sind die heissesten Funktionen des
  // Compilers (cg_nkind, cg_nnext, cg_nc0 .. zusammen rund 15 % der
  // Selbstzeit). Alle rechnen dieselbe Adresse wie cg_noff — die Formeln
  // muessen uebereinstimmen.
  fn cg_noff(i: int64): int64 {
    return self.pNodes + i * 88
           + ((i >= CG_INL_BASIS) as int64) * (self.inlNodes - self.pNodes - CG_INL_BASIS * 88);
  }
  fn cg_nkind(i: int64): int64 {
    return peek64(self.pNodes + i * 88 + CG_OFF_KIND
                  + ((i >= CG_INL_BASIS) as int64) * (self.inlNodes - self.pNodes - CG_INL_BASIS * 88));
  }
  fn cg_nc0(i: int64): int64 {
    return peek64(self.pNodes + i * 88 + CG_OFF_C0
                  + ((i >= CG_INL_BASIS) as int64) * (self.inlNodes - self.pNodes - CG_INL_BASIS * 88));
  }
  fn cg_nc1(i: int64): int64 {
    return peek64(self.pNodes + i * 88 + CG_OFF_C1
                  + ((i >= CG_INL_BASIS) as int64) * (self.inlNodes - self.pNodes - CG_INL_BASIS * 88));
  }
  fn cg_nc2(i: int64): int64 {
    return peek64(self.pNodes + i * 88 + CG_OFF_C2
                  + ((i >= CG_INL_BASIS) as int64) * (self.inlNodes - self.pNodes - CG_INL_BASIS * 88));
  }
  fn cg_nc3(i: int64): int64 {
    return peek64(self.pNodes + i * 88 + CG_OFF_C3
                  + ((i >= CG_INL_BASIS) as int64) * (self.inlNodes - self.pNodes - CG_INL_BASIS * 88));
  }
  fn cg_nnext(i: int64): int64 {
    return peek64(self.pNodes + i * 88 + CG_OFF_NEXT
                  + ((i >= CG_INL_BASIS) as int64) * (self.inlNodes - self.pNodes - CG_INL_BASIS * 88));
  }
  fn cg_nival(i: int64): int64 {
    return peek64(self.pNodes + i * 88 + CG_OFF_IVAL
                  + ((i >= CG_INL_BASIS) as int64) * (self.inlNodes - self.pNodes - CG_INL_BASIS * 88));
  }
  fn cg_nsoff(i: int64): int64 {
    return peek64(self.pNodes + i * 88 + CG_OFF_SVAL
                  + ((i >= CG_INL_BASIS) as int64) * (self.inlNodes - self.pNodes - CG_INL_BASIS * 88));
  }
  fn cg_nslen(i: int64): int64 {
    return peek64(self.pNodes + i * 88 + CG_OFF_SLEN
                  + ((i >= CG_INL_BASIS) as int64) * (self.inlNodes - self.pNodes - CG_INL_BASIS * 88));
  }
  fn cg_nsval(i: int64): pchar  {
    return self.pSrc + peek64(self.pNodes + i * 88 + CG_OFF_SVAL
                  + ((i >= CG_INL_BASIS) as int64) * (self.inlNodes - self.pNodes - CG_INL_BASIS * 88));
  }

  // ------------------------------------------------------------------
  // String comparison (length-delimited)
  // ------------------------------------------------------------------

  // #2176: acht Byte am Stueck. Die Fassung davor rief `StrCharAt` je Zeichen,
  // also einen Builtin-Aufruf pro Byte; im Selbstbau lagen damit 15,9 % der
  // Zeit in dieser einen Funktion (perf, i5-8250U, 2990 Proben). Gerufen wird
  // sie von jeder Namenssuche im Codegen — cg_findLocalIdx allein 3,3 Mio mal
  // je Selbstbau.
  //
  // `peek64` liest nur dann, wenn acht Byte VOLLSTAENDIG in der geprueften
  // Laenge liegen (i < an - 7); der Rest geht byteweise. Damit wird nie ueber
  // das Ende hinaus gelesen, auch nicht spekulativ — das ist der Grund fuer
  // die zweite Schleife statt einer Maske.
  fn cg_seq(a: pchar, an: int64, b: pchar, bn: int64): bool {
    if (an != bn) { return false; }
    var pa: int64 := a as int64;
    var pb: int64 := b as int64;
    var i: int64 := 0;
    var acht: int64 := an - 7;
    while (i < acht) {
      if (peek64(pa + i) != peek64(pb + i)) { return false; }
      i += 8;
    }
    while (i < an) {
      if (peek8(pa + i) != peek8(pb + i)) { return false; }
      i += 1;
    }
    return true;
  }

  // ------------------------------------------------------------------
  // Local variable table  (name, nameLen, rbpOff) × CG_LOCAL_SZ bytes
  // ------------------------------------------------------------------

  // #1595: `bytes` Byte im Rahmen belegen und den rbp-relativen Offset melden.
  // Anders als cg_addLocal entsteht dabei KEIN benanntes Local — der Platz
  // gehoert einem Zwischenergebnis (Rueckgabepuffer, Struct-Kopie).
  // #1595: Wurde dieser Typ als `struct` DEKLARIERT? Nur dann ist er ein
  // Wert, der by value zurueckgegeben wird.
  //
  // cg_istStructTyp fragt das LAYOUT (keine VMT) und taugt hier nicht: eine
  // Klasse OHNE Methoden bekommt ebenfalls struct-Layout, ist aber eine
  // REFERENZ. Genau daran ist der erste Anlauf gescheitert — `fn Frei(): T {
  // return 0; }` mit `type T = class { v: int64; }` kopierte 8 Byte von
  // Adresse 0 und stuerzte ab (tests/klassen_runde4_test.sh, #1629).
  // #1595: Liegt dieses Struct vollstaendig in seinem eigenen Speicher — also
  // ohne ein verschachteltes Struct-Feld, das nur als ZEIGER darin steht?
  // Nur dann darf sein Platz aus dem Rahmen kommen: eine flache Kopie traegt
  // sonst einen Zeiger auf Speicher, der mit dem Rahmen faellt.
  fn cg_structSelbstEnthalten(classIdx: int64, tiefe: int64): int64 {
    if (classIdx < 0) { return 0; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    if (cnt <= 0) { return 0; }
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var tp: pchar := peek64(fb + CG_CFIELD_OFF_TYPENAMEPTR) as pchar;
      var tl: int64 := peek64(fb + CG_CFIELD_OFF_TYPENAMELEN);
      // Bewusst streng: NUR eingebaute Grundtypen. Jedes Feld mit einem
      // benannten Typ — Struct, Klasse, Alias — faellt durch.
      //
      // Die Layouttabelle taugt fuer eine feinere Regel nicht: bei `Circle`
      // aus std.circle meldet die Feldbreite von `center` 16 Byte, waehrend
      // Groesse (16) und der Offset von `radius` (8) sagen, dass dort nur ein
      // ZEIGER steht. Drei Versuche, das ueber Breite, Summe oder
      // Registrierung zu entscheiden, haben genau diesen Widerspruch nicht
      // aufgeloest; die strenge Regel ist nachpruefbar und faellt im
      // Zweifel auf den alten Weg zurueck.
      if (tp == 0 as pchar || tl <= 0) { return 0; }
      if (self.cg_builtinTypeId(tp, tl) == 0) { return 0; }
      i := i + 1;
    }
    return 1;
  }

  fn cg_istWertStruct(classIdx: int64): int64 {
    if (classIdx < 0) { return 0; }
    if (peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_ISSTRUCT) == 0) { return 0; }
    return 1;
  }

  // #2245: Braucht DIESE Funktion einen Stack-Canary?
  //
  // Regel wie `-fstack-protector-strong`: nur Funktionen, deren Rahmen
  // ueberhaupt ueberschrieben werden KANN, pruefen ihn. Das sind die mit
  // einem Aggregat im Rahmen (Feld, festes Feld, Wert-Struct, Tupel,
  // Ringpuffer, parallel Array, Feld-Literal), die, von deren Local jemand
  // die ADRESSE nimmt (`@x` — danach schreibt beliebiger Code dorthin), und
  // die mit einem asm-Block. Eine Funktion, die nur Skalare in Registern und
  // Rahmen-Slots haelt, kann ihren Rueckkehrpunkt nicht ueber einen
  // Pufferueberlauf zerschreiben: es gibt keinen Puffer.
  //
  // Bis 1.2.21D trug JEDE Funktion einen: 13 215 Pruefungen bei 3 430
  // Funktionen, rund 11 % der Proben im Selbstbau (#2228).
  //
  // DIE RICHTUNG DES IRRTUMS IST ENTSCHEIDEND. Ein falsches "kein Canary" bei
  // einer Funktion MIT Puffer waere eine Sicherheitsregression; ein falsches
  // "Canary" kostet fuenf Befehle. Deshalb ist die Antwort hier 1, sobald
  // etwas nicht eindeutig als Skalar erkennbar ist: unbekannter Knoten, zu
  // tiefe Verschachtelung, Deklaration ohne Typangabe mit einem Startwert,
  // der kein Literal und kein Aufruf ist.
  fn cg_funcBrauchtCanary(body: int64): int64 {
    if (body < 0) { return 1; }
    return self.cg_canaryScan(body, 0);
  }

  // Ist dieser Typknoten eindeutig ein SKALAR (etwas, das in ein
  // Maschinenwort passt und keinen Inhalt im Rahmen hat)? Dieselbe
  // Unterscheidung wie cg_rlTypOk (#2228) trifft, nur weiter: dort ging es um
  // "passt in ein Register", hier um "ist kein Puffer". Ein Wert-Struct liegt
  // im Rahmen selbst und zaehlt deshalb NICHT als Skalar.
  fn cg_canarySkalarTyp(tn: int64): int64 {
    if (tn < 0) { return 0; }
    if (self.cg_nkind(tn) != 60) { return 0; }   // nur ein benannter Typ
    var p: pchar := self.cg_nsval(tn);
    var l: int64 := self.cg_nslen(tn);
    if (l <= 0) { return 0; }
    var ci: int64 := self.cg_findClass(p, l);
    if (ci >= 0) {
      // Klasse: Referenz auf den Haufen, also ein Zeiger. Wert-Struct: Inhalt
      // im Rahmen.
      if (self.cg_istWertStruct(ci) != 0) { return 0; }
      return 1;
    }
    // Generische Namen (Array, Map, Set, RingBuffer, Vec, Box …) sind keine
    // Skalare; sie tragen ihren Inhalt mit. Eindeutig skalar sind die
    // Grundtypen und der Zeiger auf Zeichen.
    if (self.cg_seq(p, l, "int64"c, 5) || self.cg_seq(p, l, "uint64"c, 6)) { return 1; }
    if (self.cg_seq(p, l, "int32"c, 5) || self.cg_seq(p, l, "uint32"c, 6)) { return 1; }
    if (self.cg_seq(p, l, "int16"c, 5) || self.cg_seq(p, l, "uint16"c, 6)) { return 1; }
    if (self.cg_seq(p, l, "int8"c, 4)  || self.cg_seq(p, l, "uint8"c, 5))  { return 1; }
    if (self.cg_seq(p, l, "i64"c, 3) || self.cg_seq(p, l, "u64"c, 3)) { return 1; }
    if (self.cg_seq(p, l, "i32"c, 3) || self.cg_seq(p, l, "u32"c, 3)) { return 1; }
    if (self.cg_seq(p, l, "i16"c, 3) || self.cg_seq(p, l, "u16"c, 3)) { return 1; }
    if (self.cg_seq(p, l, "i8"c, 2)  || self.cg_seq(p, l, "u8"c, 2))  { return 1; }
    if (self.cg_seq(p, l, "f64"c, 3) || self.cg_seq(p, l, "f32"c, 3)) { return 1; }
    if (self.cg_seq(p, l, "bool"c, 4) || self.cg_seq(p, l, "char"c, 4)) { return 1; }
    if (self.cg_seq(p, l, "byte"c, 4) || self.cg_seq(p, l, "pchar"c, 5)) { return 1; }
    if (self.cg_seq(p, l, "void"c, 4)) { return 1; }
    return 0;
  }

  // Ein Startwert OHNE Typangabe: nur offensichtliche Skalarwerte gelten als
  // harmlos. Ein Feld-Literal (Knotenart 100) liegt im Rahmen, `parallel`
  // ebenso; alles Unbekannte faellt auf die sichere Seite.
  fn cg_canarySkalarWert(ni: int64): int64 {
    if (ni < 0) { return 1; }   // keine Angabe, kein Wert: nichts im Rahmen
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_LIT_INT || k == CGN_LIT_FLOAT || k == CGN_LIT_STR) { return 1; }
    if (k == CGN_LIT_CHAR || k == CGN_LIT_BOOL || k == CGN_LIT_NULL) { return 1; }
    return 0;
  }

  fn cg_canaryScan(ni: int64, tiefe: int64): int64 {
    if (ni < 0) { return 0; }
    if (tiefe > 64) { return 1; }   // nicht mehr zu ueberblicken → Canary
    var cur: int64 := ni;
    while (cur >= 0) {
      var k: int64 := self.cg_nkind(cur);
      // Adresse eines Locals: danach schreibt beliebiger Code in den Rahmen.
      if (k == CGN_UNOP && self.cg_nival(cur) == 111) { return 1; }
      // asm-Block: was er tut, steht nicht im AST.
      if (k == CGN_ASM) { return 1; }
      // Feld-Literal und parallel Array legen im Rahmen an.
      if (k == 100 || k == CGN_SIMD_NEW || k == CGN_MAP_LIT) { return 1; }
      if (k == CGN_VAR_DECL || k == CGN_CON_DECL) {
        var tn: int64 := self.cg_nc0(cur);
        if (tn >= 0) {
          if (self.cg_canarySkalarTyp(tn) == 0) { return 1; }
        } else {
          if (self.cg_canarySkalarWert(self.cg_nc1(cur)) == 0) { return 1; }
        }
      }
      if (self.cg_canaryScan(self.cg_nc0(cur), tiefe + 1) != 0) { return 1; }
      if (self.cg_canaryScan(self.cg_nc1(cur), tiefe + 1) != 0) { return 1; }
      if (self.cg_canaryScan(self.cg_nc2(cur), tiefe + 1) != 0) { return 1; }
      if (self.cg_canaryScan(self.cg_nc3(cur), tiefe + 1) != 0) { return 1; }
      cur := self.cg_nnext(cur);
    }
    return 0;
  }

  fn cg_reserveFrame(bytes: int64): int64 {
    var b: int64 := (bytes + 7) / 8 * 8;
    if (b <= 0) { b := 8; }
    self.frameSize += b;
    return 0 - self.frameSize;
  }

  fn cg_addLocal(name: pchar, nlen: int64): int64 {
    if (self.localCount >= self.localCap) {
      var nc: int64 := self.localCap * 2;
      var nb: int64 := alloc(nc * CG_LOCAL_SZ);
      var i: int64 := 0;
      memcpy(nb, self.locals, self.localCount * CG_LOCAL_SZ);
      self.locals := nb;
      var tb: int64 := alloc(nc * 16);
      i := 0;
      memcpy(tb, self.localTypes, self.localCount * 16);
      self.localTypes := tb;
      var ab: int64 := alloc(nc);
      i := 0;
      memcpy(ab, self.localIsArray, self.localCount);
      self.localIsArray := ab;
      var efb: int64 := alloc(nc);              // #1374
      memcpy(efb, self.localElemFloat, self.localCount);
      self.localElemFloat := efb;
      var mkb: int64 := alloc(nc);              // #1291
      memcpy(mkb, self.localMapStrKey, self.localCount);
      self.localMapStrKey := mkb;
      var sb: int64 := alloc(nc * 8);
      i := 0;
      memcpy(sb, self.localArraySize, self.localCount * 8);
      self.localArraySize := sb;
      var rowb: int64 := alloc(nc * 8);        // #1230
      memcpy(rowb, self.localArrayRow, self.localCount * 8);
      self.localArrayRow := rowb;
      // WP-3.1: grow redundant flag buffer
      var rb: int64 := alloc(nc);
      i := 0;
      memcpy(rb, self.localIsRedundant, self.localCount);
      self.localIsRedundant := rb;
      var simdb: int64 := alloc(nc);
      i := 0;
      memcpy(simdb, self.localIsSimd, self.localCount);
      self.localIsSimd := simdb;
      var simdw: int64 := alloc(nc);        // #2199
      memcpy(simdw, self.localSimdBytes, self.localCount);
      self.localSimdBytes := simdw;
      var fpb: int64 := alloc(nc);
      i := 0;
      memcpy(fpb, self.localIsFnPtr, self.localCount);
      self.localIsFnPtr := fpb;
      var fpf: int64 := alloc(nc);            // #1565
      memcpy(fpf, self.localFnPtrF64, self.localCount);
      self.localFnPtrF64 := fpf;
      var frs: int64 := alloc(nc);            // #2143
      memcpy(frs, self.localFnRetSatz, self.localCount);
      self.localFnRetSatz := frs;
      self.localCap := nc;
    }
    self.frameSize += 8;
    var off: int64 := self.locals + self.localCount * CG_LOCAL_SZ;
    poke64(off,                       name as int64);
    poke64(off + CG_LOCAL_OFF_NAMELEN, nlen);
    poke64(off + CG_LOCAL_OFF_RBPOFF,  0 - self.frameSize);
    if (self.localCount + 1 > self.localHigh) { self.localHigh := self.localCount + 1; }   // #1334
    // Zero the type entry for this new local
    var toff: int64 := self.localTypes + self.localCount * CG_LOCTYPE_SZ;
    poke64(toff,                   0);
    poke64(toff + CG_LOCTYPE_OFF_LEN, 0);
    poke8(self.localIsArray      + self.localCount, 0);
    poke8(self.localElemFloat    + self.localCount, 0);   // #1374
    poke8(self.localMapStrKey    + self.localCount, 0);   // #1291
    poke64(self.localArraySize   + self.localCount * 8, 0);
    poke64(self.localArrayRow    + self.localCount * 8, 0);   // #1230
    poke8(self.localIsRedundant  + self.localCount, 0);  // WP-3.1
    poke8(self.localIsSimd       + self.localCount, 0);  // WP-GPU-01
    poke8(self.localIsFnPtr      + self.localCount, 0);  // #1003
    poke8(self.localFnPtrF64     + self.localCount, 0);  // #1565
    poke8(self.localFnRetSatz    + self.localCount, 0);  // #2143
    self.localCount += 1;
    return 0 - self.frameSize;
  }

  fn cg_findLocal(name: pchar, nlen: int64): int64 {
    var i: int64 := self.localCount - 1;
    while (i >= self.localBase) {  // WP-02: respect localBase for closure inner fn scope
      var base: int64 := self.locals + i * CG_LOCAL_SZ;
      var sname: pchar := peek64(base) as pchar;
      var slen:  int64 := peek64(base + CG_LOCAL_OFF_NAMELEN);
      if (slen == nlen && self.cg_seq(sname, slen, name, nlen)) {   // #2176
        if (self.zlAktiv != 0) { self.zlFlA += 1; self.zlFlV += self.localCount - i; }   // #2174
        return peek64(base + CG_LOCAL_OFF_RBPOFF);
      }
      i -= 1;
    }
    if (self.zlAktiv != 0) { self.zlFlA += 1; self.zlFlV += self.localCount - self.localBase; }   // #2174
    return 0;  // 0 = not found (valid offsets are always negative)
  }

  // Returns index (0-based) of local by name, or -1 if not found
  // #1091: Klassenindex der gerade erzeugten Klasse (fuer `super`).
  fn cg_curClassIdx(): int64 {
    if (self.curClassName == 0 as pchar) { return 0 - 1; }
    return self.cg_findClass(self.curClassName, self.curClassNameLen);
  }

  // #1091: Lokale Variable ueber ihren Namen nach rax laden.
  fn cg_loadLocalByName(name: pchar, nlen: int64): void {
    var li: int64 := self.cg_findLocalIdx(name, nlen);
    if (li < 0) { self.cg_zeroRax(); return; }
    self.cg_loadRax(peek64(self.locals + li * CG_LOCAL_SZ + CG_LOCAL_OFF_RBPOFF));
  }

  fn cg_findLocalIdx(name: pchar, nlen: int64): int64 {
    var i: int64 := self.localCount - 1;
    while (i >= self.localBase) {  // WP-02: respect localBase
      var base: int64 := self.locals + i * CG_LOCAL_SZ;
      var sname: pchar := peek64(base) as pchar;
      var slen:  int64 := peek64(base + CG_LOCAL_OFF_NAMELEN);
      // #2176: Laenge VOR dem Aufruf. cg_seq pruefte sie als erstes selbst,
      // der Aufruf samt Rahmen entstand aber trotzdem — bei 3,3 Mio Aufrufen
      // je Selbstbau lagen deshalb 15 % der Zeit in cg_seq.
      if (slen == nlen && self.cg_seq(sname, slen, name, nlen)) {
        if (self.zlAktiv != 0) { self.zlFiA += 1; self.zlFiV += self.localCount - i; }   // #2174
        return i;
      }
      i -= 1;
    }
    if (self.zlAktiv != 0) { self.zlFiA += 1; self.zlFiV += self.localCount - self.localBase; }   // #2174
    return -1;
  }

  // WP-3.1: TMR helpers

  fn cg_isLocalRedundant(idx: int64): int64 {
    if (idx < 0) { return 0; }
    return peek8(self.localIsRedundant + idx) as int64;
  }

  // Emit inline x86_64 majority vote for three copies at offA, offB, offC (rbp-relative).
  // Algorithm:
  //   load rax=A, rdx=B, rcx=C
  //   if B==C: if A==B: done (all equal, result=A)
  //            else:    result=B, self-heal A  (B is majority)
  //   else:    result=A  (A==B, A==C, or triple mismatch → keep A)
  // Always uses 32-bit rbp displacement forms for predictable encoding.
  // #1141: derselbe Mehrheitsentscheid fuer eine GLOBALE Variable. Die drei
  // Zellen liegen hintereinander im Datensegment (A = doff, B = doff+8,
  // C = doff+16); jede rip-relative Form ist genauso lang wie ihre
  // rbp-relative Entsprechung (7 Byte), die Sprungweiten unten sind deshalb
  // dieselben wie in cg_emitTmrRead.
  fn cg_emitTmrReadGlobal(doff: int64) {
    // mov rax,[rip+A]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05);
    var pA: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(pA, doff, 0, CG_PATCH_STR);
    // mov rdx,[rip+B]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x15);
    var pB: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(pB, doff + 8, 0, CG_PATCH_STR);
    // mov rcx,[rip+C]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x0D);
    var pC: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(pC, doff + 16, 0, CG_PATCH_STR);
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xD0);   // cmp rax,rdx
    self.cg_e8(0x74); self.cg_e8(0x11);                      // je a_eq_b (+17)
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);   // cmp rax,rcx
    self.cg_e8(0x74); self.cg_e8(0x1A);                      // je a_eq_c (+26)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD0);   // mov rax,rdx
    // mov [rip+A],rax   (Minderheit heilen)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05);
    var hA: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(hA, doff, 0, CG_PATCH_STR);
    self.cg_e8(0xEB); self.cg_e8(0x15);                      // jmp done (+21)
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);   // a_eq_b: cmp rax,rcx
    self.cg_e8(0x74); self.cg_e8(0x10);                      // je done (+16)
    // mov [rip+C],rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05);
    var hC: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(hC, doff + 16, 0, CG_PATCH_STR);
    self.cg_e8(0xEB); self.cg_e8(0x07);                      // jmp done (+7)
    // a_eq_c: mov [rip+B],rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05);
    var hB: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(hB, doff + 8, 0, CG_PATCH_STR);
    // done
  }

  // #1141: Bilanz nach --verify-tmr. Sie ist kein blosser Bericht: geht auch
  // nur EIN Zugriff am Voter vorbei, schlaegt der Lauf fehl. Ein Bericht, den
  // man uebersehen kann, waere fuer eine Sicherheitszusage wertlos.
  fn cg_tmrReport() {
    if (self.verifyTmr == 0) { return; }
    EPrintStr("TMR: "c);
    self.cg_eprintInt(self.tmrVarCount);
    EPrintStr(" @redundant-Variable(n), "c);
    self.cg_eprintInt(self.tmrReadVoted);
    EPrintStr(" gevotete(r) Lesezugriff(e), "c);
    self.cg_eprintInt(self.tmrWriteTriple);
    EPrintStr(" dreifache(r) Schreibzugriff(e), "c);
    self.cg_eprintInt(self.tmrBypass);
    EPrintStrLn(" am Voter vorbei"c);
    if (self.tmrBypass > 0) {
      EPrintStrLn("error: --verify-tmr: die Redundanz ist nicht durchgehend — siehe die Meldungen oben"c);
      exit(1);
    }
  }

  fn cg_isGlobalRedundant(idx: int64): int64 {
    if (idx < 0) { return 0; }
    return peek8(self.globalIsRedundant + idx) as int64;
  }

  // #1141: Lesezugriff auf eine globale Variable — ueber den Voter, wenn sie
  // redundant ist. Alle Lesestellen laufen hier zusammen, damit die Bilanz
  // vollstaendig ist.
  fn cg_emitGlobalRead(name: pchar, nlen: int64, doff: int64) {
    if (self.cg_isGlobalRedundant(self.cg_findGlobalIdx(name, nlen)) != 0) {
      self.cg_emitTmrReadGlobal(doff);
      self.tmrReadVoted += 1;
      return;
    }
    self.cg_loadRaxGlobal(doff);
  }

  // #1141: Schreibzugriff — alle drei Kopien.
  fn cg_emitGlobalWrite(name: pchar, nlen: int64, doff: int64) {
    if (self.cg_isGlobalRedundant(self.cg_findGlobalIdx(name, nlen)) != 0) {
      self.cg_storeRaxGlobal(doff);
      self.cg_storeRaxGlobal(doff + 8);
      self.cg_storeRaxGlobal(doff + 16);
      self.tmrWriteTriple += 1;
      return;
    }
    self.cg_storeRaxGlobal(doff);
  }

  // #1141: Die Adresse-von-Form liefert die Adresse EINER Kopie; wer darueber
  // schreibt, umgeht den Voter, und der Schreibzugriff geht beim naechsten
  // Mehrheitsentscheid verloren. Das wird gezaehlt und gemeldet — unter
  // --verify-tmr als Fehler, sonst als Warnung. Stillschweigend durchlassen
  // waere das Gegenteil dessen, was das Attribut zusagt.
  fn cg_tmrBypassAt(name: pchar, nlen: int64) {
    self.tmrBypass += 1;
    if (self.verifyTmr != 0) { EPrintStr("error: "c); } else { EPrintStr("warning: "c); }
    EPrintStr("@"c);
    sys_write(2, name as int64, nlen);
    EPrintStrLn(": Adresse-von umgeht die TMR-Mehrheitsentscheidung — ein Schreibzugriff darueber trifft nur eine Kopie"c);
  }

  fn cg_emitTmrRead(offA: int64, offB: int64, offC: int64) {
    // WP-B1: Full majority-vote with self-heal for all 3 single-fault cases.
    // Layout: A=offA (lowest addr, &var+0), B=offB (&var+8), C=offC (&var+16)
    // Result lands in rax. Heals the minority copy.
    //
    // Byte map (all off32 loads/stores, 7 bytes each):
    //  [0]  mov rax,[rbp+offA]   7   load A
    //  [7]  mov rdx,[rbp+offB]   7   load B
    // [14]  mov rcx,[rbp+offC]   7   load C
    // [21]  cmp rax,rdx          3   A==B?
    // [24]  je  a_eq_b          +17  → [43]
    // [26]  cmp rax,rcx          3   A==C?
    // [29]  je  a_eq_c          +26  → [57]
    // [31]  mov rax,rdx          3   A!=B,A!=C: use B (B==C or all differ), result=B
    // [34]  mov [rbp+offA],rax   7   heal A
    // [41]  jmp done            +21  → [64]
    // [43]  cmp rax,rcx          3   a_eq_b: A==B, check C
    // [46]  je  done            +16  → [64] (all same)
    // [48]  mov [rbp+offC],rax   7   A==B,C!=A: heal C
    // [55]  jmp done            + 7  → [64]
    // [57]  mov [rbp+offB],rax   7   a_eq_c: A==C, heal B
    // [64]  done
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x85); self.cg_e32(offA);  // mov rax,[rbp+offA]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x95); self.cg_e32(offB);  // mov rdx,[rbp+offB]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x8D); self.cg_e32(offC);  // mov rcx,[rbp+offC]
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xD0);                      // cmp rax,rdx
    self.cg_e8(0x74); self.cg_e8(0x11);                                         // je  a_eq_b (+17)
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);                      // cmp rax,rcx
    self.cg_e8(0x74); self.cg_e8(0x1A);                                         // je  a_eq_c (+26)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD0);                      // mov rax,rdx  (B→rax)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(offA);  // mov [rbp+offA],rax  heal A
    self.cg_e8(0xEB); self.cg_e8(0x15);                                         // jmp done (+21)
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);                      // a_eq_b: cmp rax,rcx
    self.cg_e8(0x74); self.cg_e8(0x10);                                         // je  done (+16, all same)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(offC);  // mov [rbp+offC],rax  heal C
    self.cg_e8(0xEB); self.cg_e8(0x07);                                         // jmp done (+7)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(offB);  // a_eq_c: mov [rbp+offB],rax  heal B
    // done: rax = majority value
  }

  // Global variable table helpers
  //
  // #1665: Ist der Name schon eingetragen, wird KEIN zweiter Slot angelegt,
  // sondern der vorhandene gemeldet. Der Vorlauf unten registriert alle
  // Modulvariablen, bevor irgendein Rumpf uebersetzt wird; der Hauptdurchlauf
  // kommt spaeter an derselben Deklaration vorbei und muss dann denselben
  // Speicher meinen — sonst gaebe es die Variable zweimal, und genau das war
  // der Defekt.
  fn cg_addGlobal(name: pchar, nlen: int64): int64 {
    var pvI: int64 := self.cg_privIdx(name, nlen);   // #2097/#2099
    if (pvI >= 0) {
      name := peek64(self.cgUnitPrivVTab + pvI * 32 + 16) as pchar;
      nlen := peek64(self.cgUnitPrivVTab + pvI * 32 + 24);
    }
    var vorhanden: int64 := self.cg_findGlobalIdx(name, nlen);
    if (vorhanden >= 0) {
      return peek64(self.globalVars + vorhanden * 24 + CG_GLOBAL_OFF_DOFF);
    }
    if (self.globalVarCount >= self.globalVarCap) {
      var nc: int64 := self.globalVarCap * 2;
      var nb: int64 := alloc(nc * 24);
      var np: int64 := alloc(nc);
      var nt: int64 := alloc(nc * 16);
      var nr: int64 := alloc(nc);          // #1141
      var na: int64 := alloc(nc);          // #1256
      var ns: int64 := alloc(nc * 8);      // #1256
      var ng: int64 := alloc(nc * 8);      // #1230
      var nf: int64 := alloc(nc);          // #1574
      var nff: int64 := alloc(nc);         // #1574
      var nmk: int64 := alloc(nc);         // #2150
      var i: int64 := 0;
      memcpy(nb, self.globalVars, self.globalVarCount * 24);
      i := 0;
      memcpy(np, self.globalIsPchar, self.globalVarCount);
      memcpy(nf, self.globalIsFnPtr, self.globalVarCount);       // #1574
      memcpy(nff, self.globalFnPtrF64, self.globalVarCount);     // #1574
      memcpy(nmk, self.globalMapStrKey, self.globalVarCount);    // #2150
      memcpy(nt, self.globalTypeNames, self.globalVarCount * 16);
      memcpy(nr, self.globalIsRedundant, self.globalVarCount);   // #1141
      memcpy(na, self.globalIsArray, self.globalVarCount);       // #1256
      memcpy(ns, self.globalArraySize, self.globalVarCount * 8); // #1256
      memcpy(ng, self.globalArrayRow, self.globalVarCount * 8);  // #1230
      self.globalVars := nb; self.globalVarCap := nc; self.globalIsPchar := np;
      self.globalTypeNames := nt;
      self.globalIsRedundant := nr;
      self.globalIsArray := na;
      self.globalArraySize := ns;
      self.globalArrayRow := ng;
      self.globalIsFnPtr := nf;                                  // #1574
      self.globalFnPtrF64 := nff;                                // #1574
      self.globalMapStrKey := nmk;                               // #2150
    }
    var doff: int64 := self.dataLen;
    // Reserve 8 zero bytes in data section (mmap is zero-initialized)
    var j: int64 := 0;
    while (j < 8) { self.cg_edata(0); j := j + 1; }
    var base: int64 := self.globalVars + self.globalVarCount * 24;
    poke64(base,      name as int64);
    poke64(base + CG_GLOBAL_OFF_NAMELEN,  nlen);
    poke64(base + CG_GLOBAL_OFF_DOFF, doff);
    poke8(self.globalIsPchar + self.globalVarCount, 0);
    poke8(self.globalIsFnPtr + self.globalVarCount, 0);       // #1574
    poke8(self.globalFnPtrF64 + self.globalVarCount, 0);      // #1574
    poke8(self.globalMapStrKey + self.globalVarCount, 0);     // #2150
    poke8(self.globalIsRedundant + self.globalVarCount, 0);   // #1141
    poke8(self.globalIsArray + self.globalVarCount, 0);       // #1256
    poke64(self.globalArraySize + self.globalVarCount * 8, 0);
    poke64(self.globalArrayRow + self.globalVarCount * 8, 0);   // #1230
    poke64(self.globalTypeNames + self.globalVarCount * 16, 0);
    poke64(self.globalTypeNames + self.globalVarCount * 16 + 8, 0);
    self.globalVarCount += 1;
    return doff;
  }

  // #1670: Einen Namen als NUL-terminierte Zeichenkette in den Datenbereich
  // legen und den Offset melden. cg_addStr arbeitet mit einem Offset in den
  // Quelltext; hier liegt der Name als Zeiger vor (Klassenname aus der
  // Layouttabelle), deshalb byteweise.
  fn cg_addNameData(nm: pchar, nlen: int64): int64 {
    var off: int64 := self.dataLen;
    var i: int64 := 0;
    while (i < nlen) { self.cg_edata(StrCharAt(nm, i) & 255); i := i + 1; }
    self.cg_edata(0);
    return off;
  }

  // ---------------------------------------------------------------------
  // #1961: `@embed("pfad")` — Dateiinhalt zur Uebersetzungszeit einbetten.
  // ---------------------------------------------------------------------
  //
  // Die Bytes gehen DIREKT in den Datenbereich (cg_edata), nicht ueber
  // erzeugten Quelltext. Eine Daten-Unit mit poke-Initialisierung bringt
  // lyxc jenseits von rund 1 MB zum Absturz — der Weg ueber Parser und sema
  // waere fuer eingebettete Dateien also von vornherein untauglich.
  //
  // Der Pfad wird RELATIV ZUR QUELLDATEI aufgeloest, wie beim Import. Relativ
  // zum Arbeitsverzeichnis haette das Erzeugnis davon abgehangen, aus welchem
  // Verzeichnis der Compiler gerufen wurde.
  fn cg_embedPfad(rel: pchar, relLen: int64, lenBox: int64): pchar {
    poke64(lenBox, 0);
    // Ein absoluter Pfad bleibt, wie er ist.
    if (relLen > 0 && StrCharAt(rel, 0) == 47) {
      var abuf: int64 := alloc(relLen + 1);
      var ai: int64 := 0;
      while (ai < relLen) { poke8(abuf + ai, StrCharAt(rel, ai)); ai := ai + 1; }
      poke8(abuf + relLen, 0);
      poke64(lenBox, relLen);
      return abuf as pchar;
    }
    // Verzeichnis der Quelldatei bestimmen: alles bis zum letzten '/'.
    var dirLen: int64 := 0;
    if (self.srcFilePath != 0 as pchar) {
      var si: int64 := 0;
      while (si < self.srcFileLen) {
        if (StrCharAt(self.srcFilePath, si) == 47) { dirLen := si + 1; }
        si := si + 1;
      }
    }
    var tot: int64 := dirLen + relLen;
    var buf: int64 := alloc(tot + 1);
    var i: int64 := 0;
    while (i < dirLen) { poke8(buf + i, StrCharAt(self.srcFilePath, i)); i := i + 1; }
    var j: int64 := 0;
    while (j < relLen) { poke8(buf + dirLen + j, StrCharAt(rel, j)); j := j + 1; }
    poke8(buf + tot, 0);
    poke64(lenBox, tot);
    return buf as pchar;
  }

  // Groesse der Datei, oder -1. Getrennt von cg_embedBytes, weil
  // `@embed_len` nur die Zahl braucht und die Datei dafuer nicht gelesen
  // werden muss.
  fn cg_embedGroesse(pfad: pchar): int64 {
    var fd: int64 := open(pfad, 0, 0);
    if (fd < 0) { return 0 - 1; }
    var sz: int64 := lseek(fd, 0, 2);
    close(fd);
    if (sz < 0) { return 0 - 1; }
    return sz;
  }

  // Fehlende Datei ist ein HARTER Fehler mit Pfad in der Meldung. Ein stiller
  // Ersatz (leere Ressource, Offset 0) waere die schlimmste Antwort: das
  // Programm liefe und zeigte nichts, und die Ursache stuende nirgends.
  fn cg_embedFehlt(pfad: pchar, was: pchar) {
    EPrintStr("error: "c);
    EPrintStr(was);
    EPrintStr(": Datei nicht lesbar: "c);
    EPrintStrLn(pfad);
    exit(1);
  }

  // Bytes einbetten und den Datenoffset melden. Gleiche Pfade werden
  // WIEDERVERWENDET — sonst laege dieselbe Datei mehrfach im Erzeugnis, und
  // `@embed` neben `@embed_len` auf denselben Pfad ist der Normalfall.
  fn cg_embedBytes(pfad: pchar, pfadLen: int64): int64 {
    var e: int64 := 0;
    while (e < self.embedCount) {
      var eb: int64 := self.embeds + e * 24;
      var ep: pchar := peek64(eb) as pchar;
      var el: int64 := peek64(eb + 8);
      if (el == pfadLen && self.cg_seq(ep, el, pfad, pfadLen) != 0) {
        return peek64(eb + 16);
      }
      e := e + 1;
    }
    var fd: int64 := open(pfad, 0, 0);
    if (fd < 0) { self.cg_embedFehlt(pfad, "@embed"c); }
    var sz: int64 := lseek(fd, 0, 2);
    lseek(fd, 0, 0);
    if (sz < 0) { close(fd); self.cg_embedFehlt(pfad, "@embed"c); }
    var off: int64 := self.dataLen;
    if (sz > 0) {
      var tmp: int64 := alloc(sz);
      var gelesen: int64 := 0;
      while (gelesen < sz) {
        var n: int64 := read(fd, (tmp + gelesen) as pchar, sz - gelesen);
        if (n <= 0) { close(fd); self.cg_embedFehlt(pfad, "@embed"c); }
        gelesen := gelesen + n;
      }
      var bi: int64 := 0;
      while (bi < sz) { self.cg_edata(peek8(tmp + bi)); bi := bi + 1; }
    }
    close(fd);
    // Abschliessende Null: eingebettete TEXTdateien lassen sich damit direkt
    // als pchar benutzen. Sie zaehlt NICHT zur gemeldeten Groesse — binaere
    // Daten duerfen davon nichts merken.
    self.cg_edata(0);
    if (self.embedCount >= self.embedCap) {
      var nc: int64 := self.embedCap * 2;
      if (nc < 8) { nc := 8; }
      var nb: int64 := alloc(nc * 24);
      memcpy(nb, self.embeds, self.embedCount * 24);
      self.embeds := nb;
      self.embedCap := nc;
    }
    var nbase: int64 := self.embeds + self.embedCount * 24;
    poke64(nbase, pfad as int64);
    poke64(nbase + 8, pfadLen);
    poke64(nbase + 16, off);
    self.embedCount := self.embedCount + 1;
    return off;
  }

  // #1961 Stufe 2: eine `@resource`-Angabe merken. Der Name muss EINDEUTIG
  // sein — "letzter gewinnt" waere ein stiller Austausch, und welche Datei
  // dann im Erzeugnis landet, saehe man erst am laufenden Programm.
  //
  // #1971: In einer importierten Unit (cgUnitTag) heisst die Ressource
  // `unit:name`. Der Pfad wird HIER aufgeloest — relativ zu der Datei, die
  // gerade uebersetzt wird; beim Auslegen am Ende stuende die Datei der Unit
  // nicht mehr fest.
  fn cg_addResource(nm: pchar, nmLen: int64, pf: pchar, pfLen: int64) {
    var q: int64 := 0;
    while (q < nmLen) {
      if (StrCharAt(nm, q) == 58) {
        EPrintStr("error: @resource: ':' trennt Unit und Name und darf im Namen nicht vorkommen: "c);
        sys_write(2, nm as int64, nmLen);
        EPrintStrLn(""c);
        exit(1);
      }
      q := q + 1;
    }
    var pbox: int64 := alloc(8);
    var voll: pchar := self.cg_embedPfad(pf, pfLen, pbox);
    var vollLen: int64 := peek64(pbox);
    free(pbox, 8);
    self.cg_resEintragen(self.cgUnitTag, self.cgUnitTagLen, nm, nmLen, voll, vollLen, 0, 0);
  }

  // #1971: Ressource aus einer importierten .lyu — die Bytes liegen schon vor.
  fn cg_addResourceBytes(tag: int64, tagLen: int64, nm: pchar, nmLen: int64,
                         daten: int64, datenLen: int64) {
    self.cg_resEintragen(tag, tagLen, nm, nmLen, 0 as pchar, 0, daten, datenLen);
  }

  // #1971: Herkunft eines Eintrags fuer Meldungen: die Unit vor dem ':' oder
  // "das Programm selbst".
  fn cg_resHerkunft(i: int64) {
    var rb: int64 := self.ress + i * CG_RES_SZ;
    var ab: int64 := peek64(rb + 48);
    if (ab <= 0) { EPrintStr("das Programm selbst"c); return; }
    EPrintStr("Unit "c);
    sys_write(2, peek64(rb), ab - 1);
  }

  // Gemeinsamer Eintrag beider Wege. Name: `tag:nm` (ohne tag nur nm).
  //
  // Kollisionen werden HIER gemeldet, mit beiden Herkuenften:
  //   * gleicher voller Name    — dieselbe Unit nennt ihn zweimal (#1961)
  //   * gleicher Kurzname aus zwei verschiedenen Units (#1971): der Kurzname
  //     ist nur erlaubt, solange er im Programm eindeutig ist. Zur Laufzeit
  //     haette ResFind("logo") sonst zwei Treffer, und welcher gewaenne,
  //     hinge an der Importreihenfolge.
  fn cg_resEintragen(tag: int64, tagLen: int64, nm: pchar, nmLen: int64,
                     voll: pchar, vollLen: int64, daten: int64, datenLen: int64) {
    var gl: int64 := nmLen;
    var kurzAb: int64 := 0;
    if (tag != 0 && tagLen > 0) { gl := tagLen + 1 + nmLen; kurzAb := tagLen + 1; }
    var gb: int64 := alloc(gl + 1);
    if (kurzAb > 0) {
      memcpy(gb, tag, tagLen);
      poke8(gb + tagLen, 58);   // ':'
    }
    memcpy(gb + kurzAb, nm as int64, nmLen);
    poke8(gb + gl, 0);
    var i: int64 := 0;
    while (i < self.resCount) {
      var rb: int64 := self.ress + i * CG_RES_SZ;
      var rKurz: int64 := peek64(rb + 48);
      var rLen: int64 := peek64(rb + 8);
      if (rLen == gl && self.cg_seq(peek64(rb) as pchar, rLen, gb as pchar, gl) != 0) {
        EPrintStr("error: @resource: der Name kommt zweimal vor: "c);
        EPrintStrLn(gb as pchar);
        exit(1);
      }
      if (rLen - rKurz == nmLen && self.cg_seq((peek64(rb) + rKurz) as pchar, nmLen, nm, nmLen) != 0) {
        EPrintStr("error: @resource: der Kurzname '"c);
        sys_write(2, nm as int64, nmLen);
        EPrintStr("' kommt aus zwei Herkuenften: "c);
        self.cg_resHerkunft(i);
        EPrintStr(" und "c);
        if (kurzAb > 0) { EPrintStr("Unit "c); sys_write(2, tag, tagLen); }
        else { EPrintStr("das Programm selbst"c); }
        EPrintStrLn(""c);
        EPrintStrLn("  Ein Kurzname ist nur erlaubt, solange er im Programm eindeutig ist (#1971)."c);
        EPrintStrLn("  Zur Laufzeit liefert ResFind(\"unit:name\") jede Ressource eindeutig."c);
        exit(1);
      }
      i := i + 1;
    }
    if (self.resCount >= self.resCap) {
      var nc: int64 := self.resCap * 2;
      if (nc < 8) { nc := 8; }
      var nb: int64 := alloc(nc * CG_RES_SZ);
      memcpy(nb, self.ress, self.resCount * CG_RES_SZ);
      self.ress := nb;
      self.resCap := nc;
    }
    var base: int64 := self.ress + self.resCount * CG_RES_SZ;
    poke64(base,      gb);
    poke64(base + 8,  gl);
    poke64(base + 16, voll as int64);
    poke64(base + 24, vollLen);
    poke64(base + 32, daten);
    poke64(base + 40, datenLen);
    poke64(base + 48, kurzAb);
    self.resCount := self.resCount + 1;
  }

  // Die Tabelle auslegen: erst die Bytes und die Namen, dann die Tabelle
  // selbst. Die Datenoffsets stehen erst danach fest, deshalb werden sie
  // zwischengespeichert. Alle Felder sind int64 — std.res liest sie mit
  // peek64, ohne Kenntnis des Speicherlayouts des Compilers.
  fn cg_emitResTable() {
    if (self.resCount <= 0) { return; }
    var offs: int64 := alloc(self.resCount * 32);
    var i: int64 := 0;
    while (i < self.resCount) {
      var rb: int64 := self.ress + i * CG_RES_SZ;
      var nm: pchar := peek64(rb) as pchar;
      var nmLen: int64 := peek64(rb + 8);
      var voll: pchar := peek64(rb + 16) as pchar;
      var vollLen: int64 := peek64(rb + 24);
      var rDaten: int64 := peek64(rb + 32);
      var gr: int64 := 0;
      var dOff: int64 := 0;
      if (rDaten != 0) {
        // #1971: aus einer .lyu — die Bytes direkt, mit derselben
        // abschliessenden Null wie cg_embedBytes (zaehlt nicht mit).
        gr := peek64(rb + 40);
        dOff := self.dataLen;
        var bi: int64 := 0;
        while (bi < gr) { self.cg_edata(peek8(rDaten + bi)); bi := bi + 1; }
        self.cg_edata(0);
      } else {
        gr := self.cg_embedGroesse(voll);
        if (gr < 0) { self.cg_embedFehlt(voll, "@resource"c); }
        // Die Bytes teilen sich die Ablage mit `@embed`: derselbe Pfad liegt
        // einmal im Erzeugnis, gleich ueber welche der beiden Formen er kam.
        dOff := self.cg_embedBytes(voll, vollLen);
      }
      var nOff: int64 := self.cg_addNameData(nm, nmLen);
      var ob: int64 := offs + i * 32;
      poke64(ob,      nOff);
      poke64(ob + 8,  nmLen);
      poke64(ob + 16, dOff);
      poke64(ob + 24, gr);
      i := i + 1;
    }
    // Auf 8 ausrichten, damit peek64 auf der Tabelle definiert ist.
    while ((self.dataLen & 7) != 0) { self.cg_edata(0); }
    var tab: int64 := self.dataLen;
    self.cg_edata8Zahl(self.resCount);
    i := 0;
    while (i < self.resCount) {
      var ob2: int64 := offs + i * 32;
      // Die drei Zeiger sind DATENOFFSETS und muessen beim Schreiben des ELF
      // zu Adressen werden — dafuer sorgt der Nachtrag unten in cg_writeELF,
      // wo die Datenbasis feststeht. Hier steht der reine Offset.
      self.cg_edata8Zahl(peek64(ob2));
      self.cg_edata8Zahl(peek64(ob2 + 8));
      self.cg_edata8Zahl(peek64(ob2 + 16));
      self.cg_edata8Zahl(peek64(ob2 + 24));
      i := i + 1;
    }
    self.resTabOff := tab;
  }

  // #1961: Ein 8-Byte-Feld im Datenbereich, das bisher einen OFFSET traegt,
  // auf die endgueltige Adresse heben.
  fn cg_datenOffsetZuAdresse(feldOff: int64, basis: int64) {
    var alt: int64 := 0;
    var i: int64 := 0;
    while (i < 8) {
      alt := alt | ((peek8(self.data + feldOff + i) & 255) << (i * 8));
      i := i + 1;
    }
    var neu: int64 := basis + alt;
    i := 0;
    while (i < 8) {
      poke8(self.data + feldOff + i, (neu >> (i * 8)) & 255);
      i := i + 1;
    }
  }

  // Acht Byte little-endian in den Datenbereich.
  fn cg_edata8Zahl(v: int64) {
    var i: int64 := 0;
    while (i < 8) { self.cg_edata((v >> (i * 8)) & 255); i := i + 1; }
  }

  // #1256: n genullte Bytes im Datenbereich belegen, Offset zurueckgeben.
  fn cg_reserveData(nbytes: int64): int64 {
    var off: int64 := self.dataLen;
    var i: int64 := 0;
    while (i < nbytes) { self.cg_edata(0); i := i + 1; }
    return off;
  }

  // #1256: Layout eines Structs vorziehen, das erst WEITER UNTEN in der Datei
  // steht. Eine globale Variable dieses Typs braucht die Groesse schon bei
  // ihrer Deklaration — der Hauptdurchlauf ist an dieser Stelle noch nicht bis
  // zum Typ gekommen. Ohne das Vorziehen waere die Groesse unbekannt und die
  // Variable bekaeme wieder nur einen Zeiger-Slot ohne Ziel.
  fn cg_ensureStructLayout(name: pchar, nlen: int64): int64 {
    var ci: int64 := self.cg_findClass(name, nlen);
    if (ci >= 0) { return ci; }
    var cur: int64 := self.topLevelHead;
    while (cur != -1) {
      var k: int64 := self.cg_nkind(cur);
      // `type S = struct {…}` steht als CGN_TYPE_DECL im Baum, `struct S {…}`
      // als CGN_STRUCT_DECL. Ein Alias (iVal-Bit1) benennt nur um, und ein Typ
      // MIT Methoden ist eine Klasse: die braucht VMT-Layout und bleibt hier
      // aussen vor — eine globale Klassenvariable ist nicht Teil von #1256.
      var isStructDecl: int64 := 0;
      if (k == CGN_STRUCT_DECL) { isStructDecl := 1; }
      if (k == CGN_TYPE_DECL && (self.cg_nival(cur) & 2) == 0 && self.cg_nc1(cur) == -1) {
        isStructDecl := 1;
      }
      if (isStructDecl != 0) {
        if (self.cg_seq(self.cg_nsval(cur), self.cg_nslen(cur), name, nlen)) {
          self.cg_buildStructLayout(cur);
          return self.cg_findClass(name, nlen);
        }
      }
      cur := self.cg_nnext(cur);
    }
    return -1;
  }

  // #1451: Alle Struct-Layouts vorziehen, bevor irgendein Rumpf uebersetzt
  // wird. Bis hierher entstand ein Layout erst, wenn der Hauptdurchlauf die
  // Deklaration erreichte — eine LOKALE Variable eines Typs, der weiter unten
  // in der Datei steht, bekam deshalb keine Groesse und damit keinen
  // Speicher. Die Funktion lief durch, der erste Zugriff auf ein Feld traf
  // ins Leere.
  //
  // Fuer GLOBALE Variablen gab es das Vorziehen bereits (#1256,
  // cg_ensureStructLayout) — nur eben punktuell an der Stelle, an der es
  // damals fehlte. Das ist dieselbe Sorte Luecke wie beim `con`-Vorabpass
  // (#1338): nicht "hier wird falsch gerechnet", sondern "die Reihenfolge
  // entscheidet ueber die Sichtbarkeit".
  //
  // In std/net/socket.lyx steht `TCPConn` hinter `TCPListenerAccept`, das den
  // Typ zurueckgibt — jeder TCP-Server stuerzte beim ersten Zugriff auf das
  // Ergebnis ab.
  // Nur, was der Hauptdurchlauf ebenfalls als Struct vermisst — sonst nimmt
  // das Vorziehen der Klassenstrecke die Arbeit weg.
  //   iVal-Bit 1 : Typalias, benennt nur um
  //   iVal-Bit 5 : Interface, bekommt Klassenlayout (#1133)
  //   c1 != -1   : hat Methoden, ist also eine Klasse
  //   c2 != -1   : erbt; erbt es von einer Klasse MIT VMT, muss es selbst
  //                Klassenlayout bekommen (WP-BC-L2). Das entscheidet sich
  //                erst, wenn die Elternklasse vermessen ist — hier also
  //                aussen vor lassen, statt es zu raten.
  fn cg_istStructDecl(ni: int64): int64 {
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_STRUCT_DECL) { return 1; }
    if (k == CGN_TYPE_DECL && (self.cg_nival(ni) & 2) == 0 && (self.cg_nival(ni) & 32) == 0
        && self.cg_nc1(ni) == -1 && self.cg_nc2(ni) == -1) { return 1; }
    return 0;
  }

  // Gibt es unter den Deklarationen ein Struct dieses Namens?
  fn cg_findStructDecl(head: int64, name: pchar, nlen: int64): int64 {
    var cur: int64 := head;
    while (cur != -1) {
      if (self.cg_istStructDecl(cur) != 0 && self.cg_nslen(cur) == nlen) {
        if (self.cg_seq(self.cg_nsval(cur), nlen, name, nlen)) { return cur; }
      }
      cur := self.cg_nnext(cur);
    }
    return -1;
  }

  // Ein Struct laesst sich erst vermessen, wenn jedes Feld, das selbst ein
  // Struct ist, schon ein Layout hat — sonst geht das Feld mit Groesse 0 ein.
  fn cg_structFelderBereit(head: int64, ni: int64): int64 {
    var f: int64 := self.cg_nc0(ni);
    while (f != -1) {
      var tn: int64 := self.cg_nc0(f);
      if (tn != -1) {
        var nm: pchar := self.cg_nsval(tn);
        var nl: int64 := self.cg_nslen(tn);
        if (nl > 0) {
          if (self.cg_findClass(nm, nl) < 0 && self.cg_findStructDecl(head, nm, nl) != -1) {
            return 0;
          }
        }
      }
      f := self.cg_nnext(f);
    }
    return 1;
  }

  // #1663: Ist das eine Deklaration, die ein KLASSEN-Layout bekommt? Die
  // Antwort steckte bisher nur im Hauptdurchlauf, verteilt ueber drei
  // Bedingungen. Der Vorlauf unten braucht dieselbe Antwort — und wenn zwei
  // Stellen dieselbe Frage getrennt beantworten, laufen sie irgendwann
  // auseinander (siehe #1655). Deshalb genau hier, einmal.
  fn cg_istKlassenDecl(cur: int64): int64 {
    if (self.cg_nkind(cur) != CGN_TYPE_DECL) { return 0; }
    if ((self.cg_nival(cur) & 2) != 0)  { return 0; }   // Alias benennt nur um
    if ((self.cg_nival(cur) & 32) != 0) { return 1; }   // Interface (#1133)
    if (self.cg_nc1(cur) != -1) { return 1; }           // hat Methoden
    // WP-BC-L2: methodenlose Klasse, deren Elternklasse eine VMT hat.
    var par: int64 := self.cg_nc2(cur);
    if (par >= 0) {
      var pi: int64 := self.cg_findClass(self.cg_nsval(par), self.cg_nslen(par));
      if (pi >= 0) {
        if (peek64(self.classLayouts + pi * CG_CLASS_SZ + CG_CLASS_OFF_VMTSLOTS) > 0) { return 1; }
      }
    }
    return 0;
  }

  // #1663: Gibt es in dieser Datei eine Typdeklaration dieses Namens?
  fn cg_hatTypDecl(head: int64, nm: pchar, nl: int64): int64 {
    var cur: int64 := head;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_TYPE_DECL) {
        if (self.cg_seq(self.cg_nsval(cur), self.cg_nslen(cur), nm, nl)) { return 1; }
      }
      cur := self.cg_nnext(cur);
    }
    return 0;
  }

  // #1663: Alle KLASSEN-Layouts vorziehen, bevor irgendein Rumpf uebersetzt
  // wird — dasselbe, was #1451 fuer Structs tut. Bis hierher entstand ein
  // Klassenlayout erst, wenn der Hauptdurchlauf die Deklaration erreichte.
  // Eine Klasse, die eine WEITER UNTEN deklarierte als Parametertyp nimmt,
  // uebersetzte deshalb gegen ein Layout, das es noch nicht gab: der
  // Feldzugriff bekam Offset 0 und lieferte still 0, ein Methodenaufruf fand
  // die Marke nicht und brach ab. Die Deklarationsreihenfolge entschied damit
  // ueber die Bedeutung des Programms.
  //
  // In Runden wie bei den Structs, denn eine Klasse kann von einer erben, die
  // weiter unten steht: gebaut wird nur, wessen Elternklasse schon steht.
  // #1665: Typangaben einer Modulvariablen vermerken. Steht in einer eigenen
  // Funktion, weil Vorlauf und Hauptdurchlauf dieselbe Auskunft brauchen —
  // zwei getrennte Fassungen laufen frueher oder spaeter auseinander (#1655).
  fn cg_recordGlobalType(gIdx: int64, gtNode: int64) {
    if (gIdx < 0) { return; }
    if (gtNode >= 0 && self.cg_nkind(gtNode) == 60) {
      var gtp: pchar := self.cg_nsval(gtNode);
      var gtn: int64 := self.cg_nslen(gtNode);
      if (gtn == 5 && self.cg_seq(gtp, gtn, "pchar", 5)) {
        poke8(self.globalIsPchar + gIdx, 1);
      }
      // #1094: Typname merken (siehe cg_staticTypeName).
      poke64(self.globalTypeNames + gIdx * 16,     gtp as int64);
      poke64(self.globalTypeNames + gIdx * 16 + 8, gtn);
      // #1574: benannter fn-Typ (`type Cb = fn(int64): int64`).
      if (self.cg_isFnPtrAlias(gtp, gtn) != 0) { poke8(self.globalIsFnPtr + gIdx, 1); }
      // #2150: Map<pchar, V> — Schluesseltyp im ersten Typargument, wie
      // cg_markMapStrKey beim Local.
      if (gtn == 3 && self.cg_seq(gtp, gtn, "Map", 3)) {
        var gmk: int64 := self.cg_nc0(gtNode);
        if (gmk >= 0 && self.cg_nkind(gmk) == 60
            && self.cg_seq(self.cg_nsval(gmk), self.cg_nslen(gmk), "pchar", 5) != 0) {
          poke8(self.globalMapStrKey + gIdx, 1);
        }
      }
    }
    // #1574: inline geschriebener Zeigertyp `var gFn: fn(f64): f64`.
    if (gtNode >= 0 && self.cg_nkind(gtNode) == CGN_FN_PTR_NODE) {
      poke8(self.globalIsFnPtr + gIdx, 1);
      if (self.cg_fnPtrRetIstF64(gtNode) != 0) {
        poke8(self.globalFnPtrF64 + gIdx, 1);
      }
    }
  }

  // #1665: Alle Modulvariablen registrieren, bevor ein Rumpf uebersetzt wird.
  // Bis hierher entstand der Slot erst, wenn der Hauptdurchlauf die
  // Deklaration erreichte. Eine Funktion, die WEITER OBEN steht und die
  // Variable schreibt, fand sie deshalb nicht — und der Schreibzugriff wurde
  // still verworfen (`if (goff >= 0)` in der Zuweisung). Das Programm hatte
  // damit faktisch zwei Variablen: die Schreibstelle oberhalb traf keine, die
  // Lesestelle unterhalb die deklarierte, die nie beschrieben wurde.
  //
  // Funktionen sind in dieser Sprache reihenfolgeunabhaengig; Modulvariablen
  // sind es jetzt auch. Reserviert wird hier nur der Slot samt Typangabe —
  // Startwerte, Aggregate und Patches macht der Hauptdurchlauf wie bisher,
  // und dank des Nachschlags in cg_addGlobal auf demselben Slot.
  fn cg_prebuildGlobals(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_VAR_DECL) {
        var nm: pchar := self.cg_nsval(cur);
        var nl: int64 := self.cg_nslen(cur);
        if (self.cg_findGlobalIdx(nm, nl) < 0) {
          self.cg_addGlobal(nm, nl);
          var pgi: int64 := self.cg_findGlobalIdx(nm, nl);
          self.cg_recordGlobalType(pgi, self.cg_nc0(cur));
          // #1141/#1665: Eine @redundant-Globale belegt DREI Zellen direkt
          // hintereinander (A = doff, B, C). Die beiden zusaetzlichen muessen
          // hier fallen, unmittelbar nach dem Slot — reservierte sie erst der
          // Hauptdurchlauf, laege inzwischen der naechste Slot dazwischen und
          // der Voter laese fremde Zellen. Genau daran sind beim ersten Anlauf
          // zwei Faelle in tmr_test.sh gescheitert.
          if ((self.cg_nival(cur) & 4) != 0) {
            poke8(self.globalIsRedundant + pgi, 1);
            var pz: int64 := 0;
            while (pz < 16) { self.cg_edata(0); pz := pz + 1; }
            self.tmrVarCount += 1;
          }
        }
      }
      cur := self.cg_nnext(cur);
    }
  }

  fn cg_prebuildClassLayouts(head: int64) {
    var fortschritt: int64 := 1;
    while (fortschritt != 0) {
      fortschritt := 0;
      var cur: int64 := head;
      while (cur != -1) {
        if (self.cg_istKlassenDecl(cur) != 0) {
          if (self.cg_findClass(self.cg_nsval(cur), self.cg_nslen(cur)) < 0) {
            var bereit: int64 := 1;
            var par: int64 := self.cg_nc2(cur);
            if (par >= 0) {
              // Eine Elternklasse, die hier noch nicht steht, darf NICHT
              // uebergangen werden: sie kann aus einem Import stammen, und die
              // Importe liest der Hauptdurchlauf erst spaeter ein. Baute der
              // Vorlauf trotzdem, entstand das Layout ohne Elternteil — ohne
              // geerbte Felder und ohne VMT-Slots. Beim ersten Anlauf verlor
              // Vega/ListCtrls.lyx dadurch TScrollBar_Init.
              //
              // Steht sie weiter unten in DIESER Datei, holt die naechste
              // Runde sie nach; ist sie importiert, bleibt die Klasse dem
              // Hauptdurchlauf ueberlassen, also genau wie vor #1663.
              if (self.cg_findClass(self.cg_nsval(par), self.cg_nslen(par)) < 0) {
                bereit := 0;
              }
            }
            if (bereit != 0) {
              self.cg_buildClassLayout(cur);
              fortschritt := 1;
            }
          }
        }
        cur := self.cg_nnext(cur);
      }
    }
  }

  fn cg_prebuildStructLayouts(head: int64) {
    // In Runden, weil ein Struct ein anderes enthalten kann, das weiter unten
    // steht: gebaut wird nur, was vollstaendig vermessbar ist, und danach
    // erneut geschaut. Ohne die Runden bekam das aeussere Struct fuer sein
    // inneres Feld die Groesse 0.
    var fortschritt: int64 := 1;
    while (fortschritt != 0) {
      fortschritt := 0;
      var cur: int64 := head;
      while (cur != -1) {
        if (self.cg_istStructDecl(cur) != 0) {
          if (self.cg_findClass(self.cg_nsval(cur), self.cg_nslen(cur)) < 0) {
            if (self.cg_structFelderBereit(head, cur) != 0) {
              self.cg_buildStructLayout(cur);
              fortschritt := 1;
            }
          }
        }
        cur := self.cg_nnext(cur);
      }
    }
    // Was uebrig bleibt, haengt in einem Zyklus (A enthaelt B enthaelt A).
    // Das ist ein eigener Fehler und gehoert nicht hierher entschieden — die
    // Layouts entstehen wie bisher, damit hier nichts stumm ausfaellt.
    var rest: int64 := head;
    while (rest != -1) {
      if (self.cg_istStructDecl(rest) != 0) {
        if (self.cg_findClass(self.cg_nsval(rest), self.cg_nslen(rest)) < 0) {
          self.cg_buildStructLayout(rest);
        }
      }
      rest := self.cg_nnext(rest);
    }
  }

  fn cg_findGlobal(name: pchar, nlen: int64): int64 {
    var pvI: int64 := self.cg_privIdx(name, nlen);   // #2097/#2099
    if (pvI >= 0) {
      name := peek64(self.cgUnitPrivVTab + pvI * 32 + 16) as pchar;
      nlen := peek64(self.cgUnitPrivVTab + pvI * 32 + 24);
    }
    var i: int64 := 0;
    while (i < self.globalVarCount) {
      var base: int64 := self.globalVars + i * 24;
      var gname: pchar := peek64(base) as pchar;
      var glen:  int64 := peek64(base + CG_GLOBAL_OFF_NAMELEN);
      if (self.cg_seq(gname, glen, name, nlen)) { return peek64(base + CG_GLOBAL_OFF_DOFF); }
      i += 1;
    }
    return -1;
  }

  fn cg_findGlobalIdx(name: pchar, nlen: int64): int64 {
    var pvI: int64 := self.cg_privIdx(name, nlen);   // #2097/#2099
    if (pvI >= 0) {
      name := peek64(self.cgUnitPrivVTab + pvI * 32 + 16) as pchar;
      nlen := peek64(self.cgUnitPrivVTab + pvI * 32 + 24);
    }
    var i: int64 := 0;
    while (i < self.globalVarCount) {
      var base: int64 := self.globalVars + i * 24;
      var gname: pchar := peek64(base) as pchar;
      var glen:  int64 := peek64(base + CG_GLOBAL_OFF_NAMELEN);
      if (glen == nlen && self.cg_seq(gname, glen, name, nlen)) { return i; }   // #2176
      i += 1;
    }
    return -1;
  }

  // mov rax, [rip+disp32]
  fn cg_loadRaxGlobal(dataOff: int64) {
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05);
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, dataOff, 0, CG_PATCH_STR);
  }

  // mov [rip+disp32], rax
  fn cg_storeRaxGlobal(dataOff: int64) {
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05);
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, dataOff, 0, CG_PATCH_STR);
  }

  // Returns 1 if the CGN_IDENT node ni refers to an array-typed local
  fn cg_identIsArray(ni: int64): int64 {
    if (self.cg_nkind(ni) != CGN_IDENT) { return 0; }
    var idx: int64 := self.cg_findLocalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
    if (idx < 0) { return 0; }
    return peek8(self.localIsArray + idx);
  }

  // Returns 1 if expression node ni produces a pchar value.
  // Covers: string literals, pchar-typed locals, known string-returning builtins,
  // and + binops where either operand is pchar (enabling chaining).
  fn cg_isPcharExpr(ni: int64): int64 {
    if (ni < 0) { return 0; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_LIT_STR) { return 1; }
    // #1961: `@embed(...)` ist die Adresse der eingebetteten Bytes, also ein
    // pchar; `@embed_len(...)` (iVal != 0) ist eine Zahl. Ohne diese Zeile gab
    // `PrintLn(@embed("vorlage.txt"))` die ADRESSE als Zahl aus — dieselbe
    // Bauart wie #1286 (Rueckgabetyp), #1328 (Feld) und #1652 (Modulvariable),
    // die weiter unten schon aufgezaehlt sind.
    if (k == CGN_EMBED && self.cg_nival(ni) == 0) { return 1; }
    if (k == CGN_IDENT) {
      var idx: int64 := self.cg_findLocalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if (idx >= 0) {
        var tb: int64 := self.localTypes + idx * CG_LOCTYPE_SZ;
        var tp: pchar := peek64(tb) as pchar;
        var tl: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
        if (self.cg_seq(tp, tl, "pchar", 5)) { return 1; }
      }
      // pchar string constants (pub con NAME: pchar := "..."c)
      var cidx: int64 := self.cg_findConIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if (cidx >= 0) {
        if (peek8(self.conIsPchar + cidx) != 0) { return 1; }
      }
      // #1652: Eine Variable auf MODULEBENE (`let`/`var`) wurde hier nie
      // gefragt. Sie ist kein Local, steht nicht in der con-Tabelle — also
      // galt sie als Zahl, und `"[" + G + "]"` addierte Adressen statt zu
      // verketten. Das Ergebnis war keine Zeichenkette; PrintLn lief in den
      // Speicherzugriffsfehler. Ob sie pchar ist, steht in globalIsPchar und
      // wurde an dieser Stelle nur nicht herangezogen — dieselbe Bauart wie
      // #1286 (Rueckgabetyp) und #1328 (Feld).
      var gidx: int64 := self.cg_findGlobalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if (gidx >= 0) {
        if (peek8(self.globalIsPchar + gidx) != 0) { return 1; }
      }
      return 0;
    }
    if (k == CGN_CALL) {
      var fpLc: int64 := alloc(8);   // #2044: Marke der inneren Funktion, sonst der Name
      var fp: pchar := self.cg_callName(ni, fpLc);
      var fl: int64 := peek64(fpLc);
      free(fpLc, 8);
      // #1286: Zuerst der DEKLARIERTE Rueckgabetyp. Hier stand nur eine feste
      // Liste von Builtins; der Aufruf einer eigenen Funktion mit
      // `pchar`-Rueckgabe galt damit nicht als Zeichenkette, und `+` addierte
      // die Adressen statt zu verketten. Bei zwei Operanden kam eine sinnlose
      // Zahl heraus, bei dreien stuerzte das Programm ab — die erfundene
      // Adresssumme wurde dereferenziert. Die Angabe steht im Quelltext; sie
      // wurde an dieser Stelle nur nicht herangezogen.
      if (self.cg_funcRetTypeIs(fp, fl, "pchar"c, 5) == 1) { return 1; }
      // #1381: dasselbe fuer Methodenaufrufe (gemangelter Name in der Registry).
      if (self.cg_callRetTypeIs(ni, "pchar"c, 5) == 1) { return 1; }
      // #2274: EINE Liste fuer alle drei Stellen (src/backend/builtin_typen.lyx).
      // Bis 1.2.21B standen hier und in cg_builtinReturnsPchar zwei
      // verschiedene Aufzaehlungen, und ArgvGet fehlte in beiden.
      if (BuiltinLiefertPchar(fp, fl) != 0) { return 1; }
      return 0;
    }
    // #1328/#1286: ein pchar-FELD ist ebenfalls eine Zeichenkette —
    // `"[" + t.name + "]"` verkettet damit, statt Adressen zu addieren.
    if (k == CGN_FIELD) {
      var pfBox: int64 := alloc(8);
      var pftp: pchar := self.cg_fieldTypeNameOf(ni, pfBox);
      var pftl: int64 := peek64(pfBox);
      free(pfBox, 8);
      if (pftp != 0 as pchar && pftl > 0) {
        if (self.cg_seq(pftp, pftl, "pchar", 5)) { return 1; }
      }
      return 0;
    }
    // Ein `x as pchar` sagt es ausdruecklich.
    if (k == CGN_CAST) {
      var ctn2: int64 := self.cg_nc1(ni);
      if (ctn2 >= 0) {
        if (self.cg_seq(self.cg_nsval(ctn2), self.cg_nslen(ctn2), "pchar", 5)) { return 1; }
      }
      return 0;
    }
    if (k == CGN_BINOP && self.cg_nival(ni) == CGT_PLUS) {
      if (self.cg_isPcharExpr(self.cg_nc0(ni)) != 0) { return 1; }
      if (self.cg_isPcharExpr(self.cg_nc1(ni)) != 0) { return 1; }
    }
    return 0;
  }

  // Emit StrConcat inline body. Assumes rdi=a, rsi=b on entry; result in rax.
  fn cg_emitStrConcatBody() {
    self.cg_e8(0x57);  // push rdi (a)
    self.cg_e8(0x56);  // push rsi (b)
    var sc1pp: int64 := self.cg_emitCall();
    poke32(self.code + sc1pp, CG_H_STRLEN - sc1pp - 4);
    self.cg_e8(0x50);  // push rax (len_a)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rdi, [rsp+8]=b
    var sc2pp: int64 := self.cg_emitCall();
    poke32(self.code + sc2pp, CG_H_STRLEN - sc2pp - 4);
    self.cg_e8(0x50);  // push rax (len_b)
    // [rsp]=len_b [rsp+8]=len_a [rsp+16]=b [rsp+24]=a
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x00);  // mov rsi,[rsp]=len_b
    self.cg_e8(0x48); self.cg_e8(0x03); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x08);  // add rsi,[rsp+8]=len_a
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC6); self.cg_e8(0x11);  // add rsi,17
    // #1980: aus dem Bump-Block herausgeben statt je Verkettung ein eigenes
    // mmap. Der Syscall belegte mindestens eine SEITE — 4096 Byte fuer ein
    // Ergebnis von elf Zeichen — und gab nie etwas zurueck; 100.000
    // Verkettungen kosteten 400 MB. Dieselbe Rechnung wie bei `new` vor #1836.
    self.cg_emitBumpAllocRsi();  // rsi = Groesse → rax = Puffer
    self.cg_e8(0x50);  // push rax (buf)
    // [rsp]=buf [rsp+8]=len_b [rsp+16]=len_a [rsp+24]=b [rsp+32]=a
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x7C); self.cg_e8(0x24); self.cg_e8(0x00);  // mov rdi,[rsp]=buf
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x20);  // mov rsi,[rsp+32]=a
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x4C); self.cg_e8(0x24); self.cg_e8(0x10);  // mov rcx,[rsp+16]=len_a
    self.cg_e8(0xF3); self.cg_e8(0xA4);  // rep movsb (copy a)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x18);  // mov rsi,[rsp+24]=b
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x4C); self.cg_e8(0x24); self.cg_e8(0x08);  // mov rcx,[rsp+8]=len_b
    self.cg_e8(0xF3); self.cg_e8(0xA4);  // rep movsb (copy b)
    self.cg_e8(0xC6); self.cg_e8(0x07); self.cg_e8(0x00);  // mov byte[rdi],0 (null term)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0x24);  // mov rax,[rsp]=buf
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x28);  // add rsp,40
  }

  // WP-02: Find a closure-captured variable by name.
  // Returns env slot index (0-based), or -1 if not found.
  fn cg_findClosureCap(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.closureCapturedCount) {
      var capName: pchar := peek64(self.closureCapturedBuf + i * 8) as pchar;
      var capLen:  int64 := peek64(self.closureCapturedLenBuf + i * 8);
      if (self.cg_seq(capName, capLen, name, nlen)) { return i; }
      i += 1;
    }
    return -1;
  }

  // WP-02: Scan AST body for identifiers present in outer locals (captures).
  // Populates closureCaptured* arrays. Call BEFORE resetting localBase.
  fn cg_scanClosureCaptures(bodyNi: int64, paramNi: int64) {
    self.closureCapturedCount := 0;
    self._scanCap(bodyNi, paramNi);
  }

  fn _scanCap(ni: int64, paramNi: int64) {
    if (ni < 0) { return; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_IDENT) {
      self._scanCapName(self.cg_nsval(ni), self.cg_nslen(ni), paramNi);
    }
    // #2133: `c()` im Rumpf — c steht dort als AUFRUFNAME, nicht als
    // Bezeichner. Ist c ein Local der Erzeugungsstelle (ein Lambda in einer
    // Variablen), muss es ebenso in die Umgebung wie jeder gelesene Name;
    // sonst fand der Rumpf es nicht ("undefined function 'c'"). Eine innere
    // benannte Funktion (cg_nestIdx) ist keine Variable.
    if (k == CGN_CALL && self.cg_nival(ni) == 0 && self.cg_nestIdx(ni) < 0) {
      self._scanCapName(self.cg_nsval(ni), self.cg_nslen(ni), paramNi);
    }
    // Recurse into children and siblings (statement list)
    self._scanCap(self.cg_nc0(ni), paramNi);
    self._scanCap(self.cg_nc1(ni), paramNi);
    self._scanCap(self.cg_nc2(ni), paramNi);
    var nxt: int64 := self.cg_nnext(ni);
    if (nxt >= 0) { self._scanCap(nxt, paramNi); }
  }

  // Ein Name des Rumpfes: erfassen, wenn er kein Parameter des Lambdas ist
  // und an der Erzeugungsstelle ein Local meint.
  fn _scanCapName(name: pchar, nlen: int64, paramNi: int64) {
    var p: int64 := paramNi;
    while (p >= 0) {
      if (self.cg_seq(self.cg_nsval(p), self.cg_nslen(p), name, nlen)) { return; }
      p := self.cg_nnext(p);
    }
    // Ein Local der ERZEUGUNGSSTELLE. #2133: bis dahin wurde mit
    // localBase = 0 gesucht — in einem Lambda, das selbst in einem Lambda
    // steht, fand das die Locals der aeusseren Funktion und kopierte sie aus
    // dem falschen Rahmen (rbp gehoert dort dem mittleren Lambda).
    var outerOff: int64 := self.cg_findLocal(name, nlen);
    self.cg_rlNichtImRegister(outerOff, "Erfassung durch ein Lambda"c);   // #2114
    var outerIdx: int64 := self.cg_findLocalIdx(name, nlen);
    var envIdx: int64 := 0 - 1;
    if (outerOff == 0) {
      // Eine Erfassung des umgebenden Lambdas: aus dessen Umgebung kopieren.
      // Typ und Darstellung erbt sie von dort.
      if (self.closureEnvPtrOff == 0) { return; }
      envIdx := self.cg_findClosureCapIn(self.capErzBuf, self.capErzLenBuf, self.capErzCount, name, nlen);
      if (envIdx < 0) { return; }
      outerIdx := peek64(self.capErzIdxBuf + envIdx * 8);
    }
    if (self.cg_findClosureCap(name, nlen) >= 0) { return; }
    if (self.closureCapturedCount >= 32) {
      // Bis #2133 fiel die 33. Erfassung still weg — ihr Name lief im Rumpf
      // dann in die globale Suche und wurde zu 0 oder zu einem fremden Wert.
      EPrintStrLn("codegen error: Lambda erfasst mehr als 32 Variablen (#2133)"c);
      exit(1);
    }
    var idx: int64 := self.closureCapturedCount;
    poke64(self.closureCapturedBuf + idx * 8, name as int64);
    poke64(self.closureCapturedLenBuf + idx * 8, nlen);
    poke64(self.closureCapturedOutBuf + idx * 8, outerOff);
    poke64(self.closureCapturedIdxBuf + idx * 8, outerIdx);   // #2133
    poke64(self.closureCapturedEnvBuf + idx * 8, envIdx);     // #2133: >= 0 = aus der Umgebung
    self.closureCapturedCount := idx + 1;
  }

  // #2133: Erfassungssuche in EIGENE Listen. Die bisherigen (die des
  // Lambdas, in dessen Rumpf wir stehen) bleiben als Erzeuger-Listen
  // sichtbar und unberuehrt; der Aufrufer stellt sie danach wieder her.
  fn cg_capSuche(bodyNi: int64, paramNi: int64) {
    self.capErzBuf    := self.closureCapturedBuf;
    self.capErzLenBuf := self.closureCapturedLenBuf;
    self.capErzIdxBuf := self.closureCapturedIdxBuf;
    self.capErzCount  := self.closureCapturedCount;
    self.closureCapturedBuf    := alloc(32 * 8);
    self.closureCapturedLenBuf := alloc(32 * 8);
    self.closureCapturedOutBuf := alloc(32 * 8);
    self.closureCapturedIdxBuf := alloc(32 * 8);
    self.closureCapturedEnvBuf := alloc(32 * 8);
    self.cg_scanClosureCaptures(bodyNi, paramNi);
  }

  // Wie cg_findClosureCap, aber in den angegebenen Listen.
  fn cg_findClosureCapIn(buf: int64, lenBuf: int64, n: int64, name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < n) {
      if (self.cg_seq(peek64(buf + i * 8) as pchar, peek64(lenBuf + i * 8), name, nlen)) { return i; }
      i += 1;
    }
    return 0 - 1;
  }

  // ==================================================================
  // #2133: Funktionswerte — Adresse oder Satz.
  //
  // Ein Funktionswert ist entweder die blanke Codeadresse ("duenn": ein
  // Funktionsname, ein Lambda ohne Erfassung, alles in einem `fn(...)`-Typ)
  // oder ein Heap-Satz {Code, Umgebung} (ein einfangendes Lambda, eine
  // Methodenreferenz). Dieselbe Semantik wie im IR-Weg (src/ir_lower.lyx,
  // _clVarMerken und Nachbarn) — die beiden muessen uebereinstimmen:
  //
  //  * Ob ein Local einen Satz haelt, entscheidet seine DEKLARATION:
  //    ohne Typangabe ein Satz genau dann, wenn der Startwert einer ist
  //    (cg_istSatzWert, einfangendes Lambda, Methodenreferenz); sonst die
  //    Adresse. Bis #2133 galt auf x86 umgekehrt JEDER untypisierte Startwert
  //    als Satz — `var h := plus; h(2, 3)` las {Code, Umgebung} aus dem Code
  //    von plus und stuerzte ab, der IR-Weg rechnete richtig.
  //  * Ueber eine RUECKGABEGRENZE geht ein Funktionswert immer als Satz: eine
  //    Funktion mit Funktionstyp als Rueckgabe packt eine Adresse in
  //    {Adresse, 0} ein (cg_emitSatzEinpacken). Bis #2133 lieferte `mk7()`
  //    ohne Erfassung die Adresse, `makeCounter()` mit Erfassung den Satz —
  //    der Aufrufer konnte die beiden nicht unterscheiden und stuerzte bei
  //    `var f := mk7(); f(1)` ab (beide Wege).
  //  * Wo eine Adresse gebraucht wird (`fn(...)`-Variable, Argument, Rechnung),
  //    wird ein Satz ausgepackt — nur mit Umgebung 0; sonst bricht das
  //    Programm laut ab, denn ein `fn(...)`-Typ kann keine Umgebung tragen
  //    (dieselbe Regel wie #1249, nur erst zur Laufzeit entscheidbar).
  //  * Ein Aufruf ueber einen Satz mit Umgebung 0 ist ein duenner Aufruf.
  // ==================================================================

  // Wie wird ueber das Local `idx` gerufen? 1 = Adresse, 2 = Satz.
  fn cg_localRufArt(idx: int64): int64 {
    if (idx < 0) { return 2; }
    if (peek8(self.localIsFnPtr + idx) == 1) { return 1; }
    var ltb: int64 := self.localTypes + idx * CG_LOCTYPE_SZ;
    var ltp: pchar := peek64(ltb) as pchar;
    var ltl: int64 := peek64(ltb + CG_LOCTYPE_OFF_LEN);
    if (ltp != 0 as pchar && ltl > 0 && self.cg_isFnPtrAlias(ltp, ltl) != 0) { return 1; }
    return 2;
  }

  // Der Funktionswert nach rax: quelle 0 = Local (rbp-Offset wo),
  // 1 = Erfassung (Index wo in der Umgebung des laufenden Lambdas).
  fn cg_ladeFnWert(quelle: int64, wo: int64) {
    if (quelle == 0) { self.cg_loadRax(wo); return; }
    self.cg_loadRax(self.closureEnvPtrOff);
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80); self.cg_e32(wo * 8);   // mov rax, [rax+disp32]
  }

  // Aufruf ueber einen Funktionswert (siehe cg_ladeFnWert); art 1 = Adresse,
  // 2 = Satz. Beim Satz entscheidet die Laufzeit: Umgebung 0 ist eine
  // eingepackte Adresse und wird duenn gerufen. Die Argumente stehen deshalb
  // in beiden Zweigen — ausgewertet wird nur einer.
  fn cg_genFnWertRuf(argNode: int64, quelle: int64, wo: int64, art: int64, sret: int64) {
    if (art == 1) { self.cg_fnWertRufDuenn(argNode, quelle, wo, 0, sret); return; }
    self.cg_ladeFnWert(quelle, wo);
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0x78); self.cg_e8(0x08); self.cg_e8(0x00);   // cmp qword [rax+8], 0
    self.cg_e8(0x0F); self.cg_e8(0x84);                                                        // je .duenn
    var jDuenn: int64 := self.codeLen;
    self.cg_e32(0);
    // Evaluate explicit args and push them. #2084: rdi traegt die Umgebung,
    // fuer explizite Argumente bleiben fuenf Register; der Rest auf den Stapel.
    var clN: int64 := self.cg_indirektStapelArgs(argNode, 5);
    var clArgc: int64 := self.cg_indirektRegArgs(argNode, 5);
    self.cg_ladeFnWert(quelle, wo);   // rax = closure ptr {fnPtr, envPtr}
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x78); self.cg_e8(0x08);  // mov rdi, [rax+8]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x18);                    // mov rbx, [rax]
    if (clArgc >= 5) { self.cg_e8(0x41); self.cg_e8(0x59); }  // pop r9
    if (clArgc >= 4) { self.cg_e8(0x41); self.cg_e8(0x58); }  // pop r8
    if (clArgc >= 3) { self.cg_popRcx(); }
    if (clArgc >= 2) { self.cg_popRdx(); }
    if (clArgc >= 1) { self.cg_popRsi(); }
    self.cg_e8(0xFF); self.cg_e8(0xD3);  // call rbx
    self.cg_popStackArgs(clN + 1);       // #2084: +1 = Umgebung in rdi
    self.cg_e8(0xE9);                    // jmp .ende
    var jEnde: int64 := self.codeLen;
    self.cg_e32(0);
    poke32(self.code + jDuenn, self.codeLen - jDuenn - 4);
    self.cg_fnWertRufDuenn(argNode, quelle, wo, 1, sret);
    poke32(self.code + jEnde, self.codeLen - jEnde - 4);
  }

  // Duenner Aufruf: Args in rdi.. wie beim direkten Aufruf. ausSatz = 1: der
  // Wert ist ein Satz mit Umgebung 0, die Adresse steht in seinem ersten Wort.
  fn cg_fnWertRufDuenn(argNode: int64, quelle: int64, wo: int64, ausSatz: int64, sret: int64) {
    // #2084: Stapel-, verdeckte und Registerargumente wie beim direkten Aufruf.
    var tfVerdeckt: int64 := 0;
    if (sret > 0) { tfVerdeckt := 1; }
    var tfN: int64 := self.cg_indirektStapelArgs(argNode, 6 - tfVerdeckt);
    var tfArgc: int64 := self.cg_indirektSretVorschub(sret);
    tfArgc := tfArgc + self.cg_indirektRegArgs(argNode, 6 - tfVerdeckt);
    self.cg_ladeFnWert(quelle, wo);
    if (ausSatz != 0) { self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x00); }   // mov rax, [rax]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC3);   // mov rbx, rax
    if (tfArgc >= 6) { self.cg_e8(0x41); self.cg_e8(0x59); }  // pop r9
    if (tfArgc >= 5) { self.cg_e8(0x41); self.cg_e8(0x58); }  // pop r8
    if (tfArgc >= 4) { self.cg_popRcx(); }
    if (tfArgc >= 3) { self.cg_popRdx(); }
    if (tfArgc >= 2) { self.cg_popRsi(); }
    if (tfArgc >= 1) { self.cg_popRdi(); }
    self.cg_e8(0xFF); self.cg_e8(0xD3);                     // call rbx
    self.cg_popStackArgs(tfN + tfVerdeckt);                 // #2084
  }

  // Ist der Typknoten ein Funktionstyp (`fn(...): R` oder ein Alias darauf)?
  fn cg_typIstFnWert(tn: int64): int64 {
    if (tn < 0) { return 0; }
    var k: int64 := self.cg_nkind(tn);
    if (k == CGN_FN_PTR_NODE) { return 1; }
    if (k == 60 && self.cg_nslen(tn) > 0 && self.cg_isFnPtrAlias(self.cg_nsval(tn), self.cg_nslen(tn)) != 0) { return 1; }
    return 0;
  }

  // Vormerken: die Funktion `name` hat den Rueckgabetyp `retNi`. Ein
  // Funktionstyp wird sofort eingetragen; ein Typname erst, wenn er sich als
  // Alias darauf herausstellt (die Aliase sind beim Vorlauf noch nicht
  // gesammelt — cg_fnWertAliaseAufloesen nach cg_collectMethodAliases).
  // Eintrag 32 B: Name, Laenge, Typname, Laenge (0 = sicher ein Funktionstyp).
  fn cg_registerFnWertKandidat(name: pchar, nlen: int64, retNi: int64) {
    if (retNi < 0) { return; }
    var k: int64 := self.cg_nkind(retNi);
    if (k != CGN_FN_PTR_NODE && k != 60) { return; }
    if (k == 60 && self.cg_nslen(retNi) <= 0) { return; }
    if (self.fnWertFnCount >= self.fnWertFnCap) {
      var nc: int64 := self.fnWertFnCap * 2;
      var nb: int64 := alloc(nc * CG_FW_SZ);
      memcpy(nb, self.fnWertFnList, self.fnWertFnCount * CG_FW_SZ);
      self.fnWertFnList := nb;
      self.fnWertFnCap  := nc;
    }
    var b: int64 := self.fnWertFnList + self.fnWertFnCount * CG_FW_SZ;
    poke64(b, name as int64);
    poke64(b + 8, nlen);
    poke64(b + 16, 0);
    poke64(b + 24, 0);
    if (k == 60) {
      poke64(b + 16, self.cg_nsval(retNi) as int64);
      poke64(b + 24, self.cg_nslen(retNi));
    }
    self.cg_fnTiefeEintragen(b, retNi);   // #2143
    self.fnWertFnCount += 1;
  }

  // Kandidaten mit Typnamen: behalten, wenn der Name ein Funktionstyp-Alias
  // ist, sonst streichen. Danach steht jeder Eintrag sicher (Laenge 0).
  fn cg_fnWertAliaseAufloesen() {
    var i: int64 := 0;
    var j: int64 := 0;
    while (i < self.fnWertFnCount) {
      var b: int64 := self.fnWertFnList + i * CG_FW_SZ;
      var tl: int64 := peek64(b + 24);
      var behalten: int64 := 1;
      if (tl > 0 && self.cg_isFnPtrAlias(peek64(b + 16) as pchar, tl) == 0) { behalten := 0; }
      if (behalten != 0) {
        if (j != i) { memcpy(self.fnWertFnList + j * CG_FW_SZ, b, CG_FW_SZ); }
        poke64(self.fnWertFnList + j * CG_FW_SZ + 24, 0);
        j += 1;
      }
      i += 1;
    }
    self.fnWertFnCount := j;
  }

  fn cg_istFnWertFunc(name: pchar, nlen: int64): int64 {
    if (self.cg_fnWertFuncEintrag(name, nlen) != 0) { return 1; }
    return 0;
  }

  // #2143: Eintrag der Funktion in fnWertFnList (0 = keiner).
  fn cg_fnWertFuncEintrag(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.fnWertFnCount) {
      var b: int64 := self.fnWertFnList + i * CG_FW_SZ;
      if (peek64(b + 24) == 0 && self.cg_seq(peek64(b) as pchar, peek64(b + 8), name, nlen) != 0) { return b; }
      i += 1;
    }
    return 0;
  }

  // ==================================================================
  // #2143: Funktionstyp-TIEFE. Ein Funktionswert vom Typ `fn(...): R` liefert
  // beim Aufruf einen Wert vom Typ R; ist R selbst ein Funktionstyp, geht
  // dieser Wert als Satz ueber die Rueckgabegrenze (#2133), und wer ihn
  // haelt, muss wissen, ob SEIN Aufruf wieder einen liefert. Tiefe(T) = 0 fuer
  // jeden anderen Typ, 1 + Tiefe(R) fuer `fn(...): R` (auch ueber Aliase).
  //
  // Am Local steht localFnRetSatz = Tiefe(R) des gehaltenen Funktionswerts:
  // >= 1 heisst "der Aufruf liefert einen Satz", das Ergebnis haelt dann
  // Tiefe(R) - 1. Bis 1.2.16A gab es die Auskunft nur fuer benannte
  // Funktionen (fnWertFnList) — `var a := mk(10); a(1)` mit einem Lambda mk
  // nahm den Satz als Adresse. Dieselbe Rechnung wie _clRufLiefertFnWert auf
  // dem IR-Weg, die beiden muessen uebereinstimmen.
  //
  // Gespeichert wird je Rueckgabetyp R nur NAMENSFEST (Knotenindizes gelten
  // nur in ihrer Tabelle): +32 die Zahl der inline geschriebenen fn-Ebenen,
  // +40/+48 der Typname am Ende der Kette (ein Alias zaehlt dort weiter).
  // ==================================================================
  fn cg_fnTiefeEintragen(b: int64, r: int64) {
    var n: int64 := 0;
    var cur: int64 := r;
    while (cur >= 0 && self.cg_nkind(cur) == CGN_FN_PTR_NODE && n < 32) {
      n += 1;
      cur := self.cg_nc1(cur);
    }
    poke64(b + 32, n);
    poke64(b + 40, 0);
    poke64(b + 48, 0);
    if (cur >= 0 && self.cg_nkind(cur) == 60 && self.cg_nslen(cur) > 0) {
      poke64(b + 40, self.cg_nsval(cur) as int64);
      poke64(b + 48, self.cg_nslen(cur));
    }
  }

  // Tiefe eines Rueckgabetyps aus den drei Feldern ab b + 32.
  fn cg_fnTiefeAusEintrag(b: int64, tiefe: int64): int64 {
    var t: int64 := peek64(b + 32);
    var el: int64 := peek64(b + 48);
    if (el > 0) { t := t + self.cg_fnTiefeAlias(peek64(b + 40) as pchar, el, tiefe + 1); }
    return t;
  }

  // Tiefe des Typnamens (0, wenn er kein Funktionstyp-Alias ist).
  fn cg_fnTiefeAlias(name: pchar, nlen: int64, tiefe: int64): int64 {
    if (tiefe > 32) { return 0; }
    var i: int64 := 0;
    while (i < self.fnAliasCount) {
      var base: int64 := self.fnAliasList + i * CG_FNALIAS_SZ;
      if (self.cg_seq(peek64(base) as pchar, peek64(base + 8), name, nlen) != 0) {
        return 1 + self.cg_fnTiefeAusEintrag(base, tiefe);
      }
      i += 1;
    }
    return 0;
  }

  // Tiefe eines Typknotens der GERADE eingesetzten Tabelle.
  fn cg_fnTiefeKnoten(n: int64): int64 {
    var t: int64 := 0;
    var cur: int64 := n;
    while (cur >= 0 && self.cg_nkind(cur) == CGN_FN_PTR_NODE && t < 32) {
      t += 1;
      cur := self.cg_nc1(cur);
    }
    if (cur >= 0 && self.cg_nkind(cur) == 60 && self.cg_nslen(cur) > 0) {
      t := t + self.cg_fnTiefeAlias(self.cg_nsval(cur), self.cg_nslen(cur), 0);
    }
    return t;
  }

  // localFnRetSatz eines Locals (Index), bei einem Alias als Typangabe aus
  // dem Alias.
  fn cg_localFnTiefe(idx: int64): int64 {
    if (idx < 0) { return 0; }
    var t: int64 := peek8(self.localFnRetSatz + idx) as int64;
    if (t > 0) { return t; }
    var ltb: int64 := self.localTypes + idx * CG_LOCTYPE_SZ;
    var ltp: pchar := peek64(ltb) as pchar;
    var ltl: int64 := peek64(ltb + CG_LOCTYPE_OFF_LEN);
    if (ltp != 0 as pchar && ltl > 0) {
      var at: int64 := self.cg_fnTiefeAlias(ltp, ltl, 0);
      if (at > 0) { return at - 1; }
    }
    return 0;
  }

  // Tiefe des ERGEBNISSES eines Aufrufs (Wert fuer localFnRetSatz des
  // Locals, das es aufnimmt), 0 wenn er keinen Funktionswert liefert.
  fn cg_callErgebnisTiefe(ni: int64): int64 {
    if (ni < 0 || self.cg_nkind(ni) != CGN_CALL) { return 0; }
    var lc: int64 := alloc(8);
    var fp: pchar := self.cg_callName(ni, lc);
    var fl: int64 := peek64(lc);
    free(lc, 8);
    if (self.cg_nival(ni) == 1) {
      var mRecv: int64 := self.cg_nc0(ni);
      var mCls:  int64 := self.cg_exprClassName(mRecv);
      if (mCls < 0 && mRecv >= 0 && self.cg_nkind(mRecv) == CGN_IDENT) {
        if (self.cg_findLocalIdx(self.cg_nsval(mRecv), self.cg_nslen(mRecv)) < 0) {
          mCls := self.cg_findClass(self.cg_nsval(mRecv), self.cg_nslen(mRecv));
        }
      }
      if (mCls < 0) { return 0; }
      var mOwn: int64 := self.cg_findMethodOwner(mCls, fp, fl);
      if (mOwn >= 0) { mCls := mOwn; }
      var mlcb: int64 := alloc(8);
      var mmb:  int64 := self.cg_buildMethodMangled(mCls, fp, fl, mlcb);
      var mmbL: int64 := peek64(mlcb);
      free(mlcb, 8);
      var me: int64 := self.cg_fnWertFuncEintrag(mmb as pchar, mmbL);
      self.cg_trackTempBuf(mmb, mmbL + 1);
      if (me == 0) { return 0; }
      return self.cg_fnTiefeAusEintrag(me, 0) - 1;
    }
    if (self.cg_nival(ni) != 0) { return 0; }
    var rli: int64 := self.cg_findLocalIdx(fp, fl);
    if (rli < 0) { rli := self.cg_capOuterIdx(fp, fl); }
    if (rli >= 0) {
      var lt: int64 := self.cg_localFnTiefe(rli);
      if (lt > 0) { return lt - 1; }
      return 0;
    }
    var fe: int64 := self.cg_fnWertFuncEintrag(fp, fl);
    if (fe == 0) { return 0; }
    return self.cg_fnTiefeAusEintrag(fe, 0) - 1;
  }

  // Liefert der Aufruf `ni` einen Funktionswert ueber eine Rueckgabegrenze
  // (also einen Satz)? Freie Funktion, innere Funktion oder Methode.
  fn cg_callLiefertFnWert(ni: int64): int64 {
    var lc: int64 := alloc(8);
    var fp: pchar := self.cg_callName(ni, lc);
    var fl: int64 := peek64(lc);
    free(lc, 8);
    if (self.cg_nival(ni) == 1) {
      // Methode: wie in cg_isF64Expr (#1887) ueber den gemangelten Namen
      // der deklarierenden Klasse.
      var mRecv: int64 := self.cg_nc0(ni);
      var mCls:  int64 := self.cg_exprClassName(mRecv);
      if (mCls < 0 && mRecv >= 0 && self.cg_nkind(mRecv) == CGN_IDENT) {
        if (self.cg_findLocalIdx(self.cg_nsval(mRecv), self.cg_nslen(mRecv)) < 0) {
          mCls := self.cg_findClass(self.cg_nsval(mRecv), self.cg_nslen(mRecv));
        }
      }
      if (mCls < 0) { return 0; }
      var mOwn: int64 := self.cg_findMethodOwner(mCls, fp, fl);
      if (mOwn >= 0) { mCls := mOwn; }
      var mlcb: int64 := alloc(8);
      var mmb:  int64 := self.cg_buildMethodMangled(mCls, fp, fl, mlcb);
      var mmbL: int64 := peek64(mlcb);
      free(mlcb, 8);
      var r: int64 := self.cg_istFnWertFunc(mmb as pchar, mmbL);
      self.cg_trackTempBuf(mmb, mmbL + 1);
      return r;
    }
    if (self.cg_nival(ni) != 0) { return 0; }
    // Ein Aufruf ueber ein Local oder eine Erfassung ruft keine Funktion
    // dieses Namens. #2143: er liefert einen Satz, wenn das Lambda (der
    // fn-Typ) dahinter einen Funktionstyp zurueckgibt — vermerkt am Local.
    var rli: int64 := self.cg_findLocalIdx(fp, fl);
    if (rli < 0) { rli := self.cg_capOuterIdx(fp, fl); }
    if (rli >= 0) {
      if (self.cg_localFnTiefe(rli) > 0) { return 1; }
      return 0;
    }
    return self.cg_istFnWertFunc(fp, fl);
  }

  // Liefert der Ausdruck einen Satz {Code, Umgebung}? Bezeichner eines
  // Locals/einer Erfassung, das einen Satz haelt, oder ein Aufruf nach
  // cg_callLiefertFnWert. (Ein einfangendes Lambda ebenfalls — das fragt
  // der Aufrufer selbst, cg_lambdaFaengt.)
  fn cg_istSatzWert(ni: int64): int64 {
    if (ni < 0) { return 0; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_IDENT) {
      if (self.satzLocalJe == 0) { return 0; }
      var idx: int64 := self.cg_findLocalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if (idx >= 0) {
        if (peek8(self.localIsFnPtr + idx) == 2) { return 1; }
        return 0;
      }
      var oi: int64 := self.cg_capOuterIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if (oi >= 0 && peek8(self.localIsFnPtr + oi) == 2) { return 1; }
      return 0;
    }
    if (k == CGN_CALL) { return self.cg_callLiefertFnWert(ni); }
    return 0;
  }

  // rax = Satz → rax = Adresse. Umgebung != 0: laut abbrechen.
  fn cg_emitSatzAuspacken() {
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x58); self.cg_e8(0x08);   // mov rbx, [rax+8]
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xDB);                     // test rbx, rbx
    self.cg_e8(0x0F); self.cg_e8(0x84);                                       // je .ok
    var jOk: int64 := self.codeLen;
    self.cg_e32(0);
    var msgOff: int64 := self.cg_emitCStrData(
      "Laufzeitfehler: einfangendes Lambda, wo nur eine Funktionsadresse Platz hat (fn-Typ, Argument) (#2133)\n"c);
    self.cg_emitLeaRdiData(msgOff);
    self.cg_emitPanicBody();
    poke32(self.code + jOk, self.codeLen - jOk - 4);
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x00);                     // mov rax, [rax]
  }

  // rax = Adresse → rax = Satz {Adresse, 0}.
  fn cg_emitSatzEinpacken() {
    self.cg_pushRax();
    self.cg_e8(0x31); self.cg_e8(0xFF);  // xor edi, edi
    self.cg_e8(0xBE); self.cg_e8(0x10); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov esi, 16
    self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov edx,3
    self.cg_e8(0x41); self.cg_e8(0xBA); self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov r10d,34
    self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);  // mov r8d,-1
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);  // xor r9d,r9d
    self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);  // mov eax,9
    self.cg_e8(0x0F); self.cg_e8(0x05);  // syscall → rax = Satz
    self.cg_popRcx();
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x08);                                       // mov [rax], rcx
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0x40); self.cg_e8(0x08); self.cg_e32(0);      // mov qword [rax+8], 0
  }

  // Den Ausdruck als Satz erzeugen (Rueckgabe einer Funktion mit
  // Funktionstyp, Zuweisung an ein Satz-Local): ist er schon einer, nichts
  // auspacken; sonst die Adresse einpacken.
  fn cg_genAlsSatz(ni: int64) {
    if (self.cg_closureCaptures(ni) > 0) { self.cg_genExpr(ni); return; }
    if (self.cg_istSatzWert(ni) != 0) {
      self.satzKontext := 1;
      self.cg_genExpr(ni);
      return;
    }
    self.cg_genExpr(ni);
    self.cg_emitSatzEinpacken();
  }

  // #2133: Index des aeusseren Locals hinter der Erfassung `name` im Rumpf
  // des gerade erzeugten Lambdas, oder -1 (kein Lambda / keine Erfassung).
  fn cg_capOuterIdx(name: pchar, nlen: int64): int64 {
    if (self.closureEnvPtrOff == 0) { return 0 - 1; }
    var ci: int64 := self.cg_findClosureCap(name, nlen);
    if (ci < 0) { return 0 - 1; }
    return peek64(self.closureCapturedIdxBuf + ci * 8);
  }

  // WP-02: Build anonymous function label name: "__anon_N\0" in a heap buffer.
  // Returns pointer to null-terminated string, length stored in *outLen.
  fn cg_buildAnonName(idx: int64): pchar {
    var buf: int64 := alloc(32);
    // "__anon_" = 7 chars
    poke8(buf + 0, 95); poke8(buf + 1, 95);  // __
    poke8(buf + 2, 97); poke8(buf + 3, 110); // an
    poke8(buf + 4, 111); poke8(buf + 5, 110); // on
    poke8(buf + 6, 95);  // _
    // Decimal digits of idx
    var pos: int64 := 7;
    if (idx == 0) {
      poke8(buf + pos, 48); pos := pos + 1;
    } else {
      var tmp: int64 := alloc(24);
      var dcount: int64 := 0;
      var n: int64 := idx;
      while (n > 0) {
        poke8(tmp + dcount, (n & 0x7FFFFFFFFFFFFFFF) - ((n & 0x7FFFFFFFFFFFFFFF) / 10) * 10 + 48);
        n := n / 10;
        dcount += 1;
      }
      // digits are in reverse in tmp; copy forward
      var di: int64 := dcount - 1;
      while (di >= 0) {
        poke8(buf + pos, peek8(tmp + di) as int64);
        pos += 1;
        di -= 1;
      }
      free(tmp, 24);
    }
    poke8(buf + pos, 0);  // null terminator
    return buf as pchar;
  }

  // WP-13: Find captured variable from outer function's frame via static link
  // Returns the offset in the captured environment, or 0 if not found
  fn cg_findCapturedVar(name: pchar, nlen: int64): int64 {
    // Search the captured vars table for the current outer function
    var i: int64 := 0;
    while (i < self.capturedCount) {
      var base: int64 := self.capturedVars + i * CG_CAPTVAR_SZ;
      var funcPtr:  pchar := peek64(base) as pchar;
      var funcLen:  int64 := peek64(base + CG_CAPTVAR_OFF_FUNCLEN);
      var varPtr:   pchar := peek64(base + CG_CAPTVAR_OFF_VARPTR) as pchar;
      var varLen:   int64 := peek64(base + CG_CAPTVAR_OFF_VARLEN);
      var varOff:   int64 := peek64(base + CG_CAPTVAR_OFF_RBPOFF);
      // Match both outer function name and variable name
      if (funcLen == self.outerFuncNameLen &&
          self.cg_seq(funcPtr, funcLen, self.outerFuncName, self.outerFuncNameLen) &&
          varLen == nlen && self.cg_seq(varPtr, varLen, name, nlen)) {
        return varOff;
      }
      i += 1;
    }
    return 0;
  }

  // WP-13: Register a captured variable for the current outer function
  fn cg_addCapturedVar(varName: pchar, varLen: int64, off: int64) {
    // Check if already captured
    var i: int64 := 0;
    while (i < self.capturedCount) {
      var base: int64 := self.capturedVars + i * CG_CAPTVAR_SZ;
      var funcPtr:  pchar := peek64(base) as pchar;
      var funcLen:  int64 := peek64(base + CG_CAPTVAR_OFF_FUNCLEN);
      var varPtr:   pchar := peek64(base + CG_CAPTVAR_OFF_VARPTR) as pchar;
      var varLen2:  int64 := peek64(base + CG_CAPTVAR_OFF_VARLEN);
      if (funcLen == self.outerFuncNameLen &&
          self.cg_seq(funcPtr, funcLen, self.outerFuncName, self.outerFuncNameLen) &&
          varLen2 == varLen && self.cg_seq(varPtr, varLen2, varName, varLen)) {
        return;  // Already captured
      }
      i += 1;
    }
    // Grow table if needed
    if (self.capturedCount >= self.capturedCap) {
      var nc: int64 := self.capturedCap * 2;
      var nb: int64 := alloc(nc * 40);
      var j: int64 := 0;
      memcpy(nb, self.capturedVars, self.capturedCount * CG_CAPTVAR_SZ);
      free(self.capturedVars, self.capturedCap * CG_CAPTVAR_SZ);
      self.capturedVars := nb;
      self.capturedCap := nc;
    }
    var entry: int64 := self.capturedVars + self.capturedCount * CG_CAPTVAR_SZ;
    poke64(entry,      self.outerFuncName as int64);
    poke64(entry + CG_CAPTVAR_OFF_FUNCLEN,  self.outerFuncNameLen);
    poke64(entry + CG_CAPTVAR_OFF_VARPTR, varName as int64);
    poke64(entry + CG_CAPTVAR_OFF_VARLEN, varLen);
    poke64(entry + CG_CAPTVAR_OFF_RBPOFF, off);
    self.capturedCount += 1;
  }

  // ------------------------------------------------------------------
  // Label table  (name, nameLen, codeOff, lineNum) × CG_LABEL_SZ bytes
  // ------------------------------------------------------------------

  // WP-BC-49: compute source line of an AST node from its source offset
  fn cg_lineOf(ni: int64): int64 {
    var soff: int64 := self.cg_nsoff(ni);
    if (soff <= 0) { return 1; }
    if (self.zlAktiv != 0) { self.zlLnA += 1; }   // #2174
    // #2175: Zeile = 1 + Zahl der '\n' vor soff, binaer in der Tabelle der
    // Zeilenumbrueche gesucht. Bis 1.2.18B zaehlte jeder Aufruf vom
    // Dateianfang: beim Selbstbau 1,3 Mrd gelesene Zeichen.
    var e: int64 := self.cg_lnEintrag();
    if (soff > peek64(e + 8)) {
      // hinter dem Textende (kann nicht vorkommen) — wie frueher zaehlen
      var line: int64 := 1;
      var i: int64 := 0;
      while (i < soff) {
        if (StrCharAt(self.pSrc, i) == 10) { line := line + 1; }
        i += 1;
      }
      return line;
    }
    var nl: int64 := peek64(e + 16);
    var lo: int64 := 0;
    var hi: int64 := peek64(e + 24);   // erstes '\n' mit Offset >= soff liegt in [lo, hi]
    while (lo < hi) {
      var mid: int64 := (lo + hi) >> 1;
      if (self.zlAktiv != 0) { self.zlLnT += 1; }   // #2174/#2175
      if (peek64(nl + mid * 8) < soff) { lo := mid + 1; } else { hi := mid; }
    }
    return lo + 1;
  }

  // #2175: Tabelleneintrag zum aktuellen Quelltext self.pSrc; beim ersten
  // Zugriff wird der Text einmal durchlaufen. Quelltexte liegen in der Arena
  // und werden nicht veraendert, der Zeiger ist also ein tragfaehiger Schluessel.
  fn cg_lnEintrag(): int64 {
    var key: int64 := self.pSrc as int64;
    if (self.lnAnz > 0) {
      var le: int64 := self.lnTab + self.lnLetzt * 32;
      if (peek64(le) == key) { return le; }
    }
    var k: int64 := 0;
    while (k < self.lnAnz) {
      if (peek64(self.lnTab + k * 32) == key) { self.lnLetzt := k; return self.lnTab + k * 32; }
      k += 1;
    }
    if (self.lnAnz >= self.lnCap) {
      var nc: int64 := self.lnCap * 2;
      var nb: int64 := alloc(nc * 32);
      memcpy(nb, self.lnTab, self.lnAnz * 32);
      self.lnTab := nb; self.lnCap := nc;
    }
    var len: int64 := StrLen(self.pSrc);
    var anz: int64 := 0;
    var i: int64 := 0;
    while (i < len) { if (StrCharAt(self.pSrc, i) == 10) { anz += 1; } i += 1; }
    if (self.zlAktiv != 0) { self.zlLnT += len; }   // #2174/#2175: einmaliger Durchlauf
    var nl: int64 := alloc(anz * 8 + 8);
    var j: int64 := 0;
    i := 0;
    while (i < len) { if (StrCharAt(self.pSrc, i) == 10) { poke64(nl + j * 8, i); j += 1; } i += 1; }
    var e: int64 := self.lnTab + self.lnAnz * 32;
    poke64(e, key); poke64(e + 8, len); poke64(e + 16, nl); poke64(e + 24, anz);
    self.lnLetzt := self.lnAnz;
    self.lnAnz += 1;
    return e;
  }

  fn cg_addLabel(name: pchar, nlen: int64, lineNum: int64) {
    if (self.labelCount >= self.labelCap) {
      var nc: int64 := self.labelCap * 2;
      var nb: int64 := alloc(nc * CG_LABEL_SZ);
      var i: int64 := 0;
      memcpy(nb, self.labels, self.labelCount * CG_LABEL_SZ);
      self.labels := nb; self.labelCap := nc;
    }
    var base: int64 := self.labels + self.labelCount * CG_LABEL_SZ;
    poke64(base,      name as int64);
    poke64(base + CG_LABEL_OFF_NAMELEN,  nlen);
    poke64(base + CG_LABEL_OFF_CODEOFF, self.codeLen);
    poke64(base + CG_LABEL_OFF_LINENUM, lineNum);
    self.lbHx := self.cg_hxEin(self.lbHx, self.labels, CG_LABEL_SZ, CG_LABEL_OFF_NAMELEN, self.labelCount);   // #2175
    self.labelCount += 1;
  }

  fn cg_findLabel(name: pchar, nlen: int64): int64 {
    var hs0: int64 := self.zlHxS;
    var i: int64 := self.cg_hxSuch(self.lbHx, self.labels, CG_LABEL_SZ, CG_LABEL_OFF_NAMELEN, name, nlen);   // #2175
    if (self.zlAktiv != 0) { self.zlLbA += 1; self.zlLbT += self.zlHxS - hs0; }   // #2174
    if (i < 0) { return -1; }
    return peek64(self.labels + i * CG_LABEL_SZ + CG_LABEL_OFF_CODEOFF);
  }

  // ------------------------------------------------------------------
  // #2175: Namensindex ueber eine angehaengte Tabelle (Eintrag: Namenszeiger
  // bei +0, Laenge bei lenOff, Schrittweite stride). Offene Adressierung,
  // Platz = Index des ERSTEN Eintrags dieses Namens; ein spaeterer gleich-
  // namiger Eintrag wird nicht aufgenommen — dasselbe Ergebnis wie die
  // lineare Suche von vorn, die cg_findLabel & Co. bis 1.2.18B machten.
  // Kopf: [0] Plaetze (Zweierpotenz), [8] belegt; ab 16 die Plaetze (-1 = frei).
  // ------------------------------------------------------------------
  fn cg_hxNeu(plaetze: int64): int64 {
    var hx: int64 := alloc(16 + plaetze * 8);
    poke64(hx, plaetze); poke64(hx + 8, 0);
    var i: int64 := 0;
    while (i < plaetze) { poke64(hx + 16 + i * 8, 0 - 1); i += 1; }
    return hx;
  }

  fn cg_hxHash(name: pchar, nlen: int64): int64 {
    var h: int64 := 0 - 3750763034362895579;   // FNV-1a, wie Sema._symHash
    var i: int64 := 0;
    while (i < nlen) { h := (h ^ (StrCharAt(name, i) & 255)) * 1099511628211; i += 1; }
    return h ^ (h >> 29);
  }

  fn cg_hxSuch(hx: int64, tab: int64, stride: int64, lenOff: int64, name: pchar, nlen: int64): int64 {
    var maske: int64 := peek64(hx) - 1;
    var h: int64 := self.cg_hxHash(name, nlen) & maske;
    while (true) {
      var v: int64 := peek64(hx + 16 + h * 8);
      if (v < 0) { return 0 - 1; }
      if (self.zlAktiv != 0) { self.zlHxS += 1; }
      var b: int64 := tab + v * stride;
      if (self.cg_seq(peek64(b) as pchar, peek64(b + lenOff), name, nlen)) { return v; }
      h := (h + 1) & maske;
    }
    return 0 - 1;
  }

  // Eintrag idx aufnehmen; liefert den (bei Bedarf vergroesserten) Index.
  fn cg_hxEin(hx: int64, tab: int64, stride: int64, lenOff: int64, idx: int64): int64 {
    var plaetze: int64 := peek64(hx);
    if ((peek64(hx + 8) + 1) * 2 > plaetze) {
      var neu: int64 := self.cg_hxNeu(plaetze * 2);
      var nm: int64 := plaetze * 2 - 1;
      var k: int64 := 0;
      while (k < plaetze) {
        var w: int64 := peek64(hx + 16 + k * 8);
        if (w >= 0) {
          var wb: int64 := tab + w * stride;
          var wh: int64 := self.cg_hxHash(peek64(wb) as pchar, peek64(wb + lenOff)) & nm;
          while (peek64(neu + 16 + wh * 8) >= 0) { wh := (wh + 1) & nm; }
          poke64(neu + 16 + wh * 8, w);
        }
        k += 1;
      }
      poke64(neu + 8, peek64(hx + 8));
      hx := neu; plaetze := plaetze * 2;
    }
    var maske: int64 := plaetze - 1;
    var eb: int64 := tab + idx * stride;
    var name: pchar := peek64(eb) as pchar;
    var nlen: int64 := peek64(eb + lenOff);
    var h: int64 := self.cg_hxHash(name, nlen) & maske;
    while (true) {
      var v: int64 := peek64(hx + 16 + h * 8);
      if (v < 0) {
        poke64(hx + 16 + h * 8, idx);
        poke64(hx + 8, peek64(hx + 8) + 1);
        return hx;
      }
      var b: int64 := tab + v * stride;
      if (self.cg_seq(peek64(b) as pchar, peek64(b + lenOff), name, nlen)) { return hx; }   // erster bleibt
      h := (h + 1) & maske;
    }
    return hx;
  }

  // ------------------------------------------------------------------
  // Module-level constant table  (namePtr, nameLen, value) × 24 bytes
  // Populated from CGN_CON_DECL nodes at module scope; used for identifier
  // resolution inside method bodies where only locals would otherwise work.
  // ------------------------------------------------------------------

  // WP-CS-05: public entry point to pre-seed conTable with compile-time constants
  pub fn AddBuiltinCon(name: pchar, val: int64): void {
    var _nlen: int64 := StrLen(name);
    self.cg_addCon(name, _nlen, val);
  }

  fn cg_addCon(name: pchar, nlen: int64, val: int64) {
    var pvI: int64 := self.cg_privIdx(name, nlen);   // #2097/#2099
    if (pvI >= 0) {
      name := peek64(self.cgUnitPrivVTab + pvI * 32 + 16) as pchar;
      nlen := peek64(self.cgUnitPrivVTab + pvI * 32 + 24);
    }
    // #1338: Der Vorpass laeuft zweimal, damit eine Konstante gilt, die auf
    // eine weiter unten stehende verweist. Beim zweiten Lauf muss der bessere
    // Wert den ersten ERSETZEN — wuerde er nur angehaengt, faende die Suche
    // weiter den alten Eintrag (sie nimmt den ersten Treffer), und die
    // Ableitung bliebe auf ihrem Zwischenwert stehen.
    var vorh: int64 := self.cg_findConIdx(name, nlen);
    if (vorh >= 0) {
      poke64(self.conTable + vorh * CG_CON_SZ + CG_CON_OFF_VAL, val);
      return;
    }
    if (self.conCount >= self.conCap) {
      var nc: int64 := self.conCap * 2;
      var nb: int64 := alloc(nc * CG_CON_SZ);
      var np: int64 := alloc(nc);
      memcpy(nb, self.conTable, self.conCount * CG_CON_SZ);
      var nf: int64 := alloc(nc);
      var na: int64 := alloc(nc);                       // #2026
      memcpy(np, self.conIsPchar, self.conCount);
      memcpy(nf, self.conIsF64, self.conCount);
      memcpy(na, self.conIsStrAddr, self.conCount);     // #2026
      self.conTable := nb; self.conCap := nc; self.conIsPchar := np; self.conIsF64 := nf;
      self.conIsStrAddr := na;
    }
    var base: int64 := self.conTable + self.conCount * CG_CON_SZ;
    poke64(base,                       name as int64);
    poke64(base + CG_CON_OFF_NAMELEN,  nlen);
    poke64(base + CG_CON_OFF_VAL,      val);
    poke8(self.conIsPchar + self.conCount, 0);
    poke8(self.conIsF64 + self.conCount, 0);
    poke8(self.conIsStrAddr + self.conCount, 0);   // #2026
    self.coHx := self.cg_hxEin(self.coHx, self.conTable, CG_CON_SZ, CG_CON_OFF_NAMELEN, self.conCount);   // #2175
    self.conCount += 1;
  }

  fn cg_findConVal(name: pchar, nlen: int64): int64 {
    var pvI: int64 := self.cg_privIdx(name, nlen);   // #2097/#2099
    if (pvI >= 0) {
      name := peek64(self.cgUnitPrivVTab + pvI * 32 + 16) as pchar;
      nlen := peek64(self.cgUnitPrivVTab + pvI * 32 + 24);
    }
    var i: int64 := self.cg_hxSuch(self.coHx, self.conTable, CG_CON_SZ, CG_CON_OFF_NAMELEN, name, nlen);   // #2175
    if (i < 0) { return -1; }
    return peek64(self.conTable + i * CG_CON_SZ + CG_CON_OFF_VAL);
  }

  // Returns 1 if constant exists, 0 if not (avoids -1 sentinel confusion with FD_NONE=-1)
  fn cg_hasConVal(name: pchar, nlen: int64): int64 {
    var pvI: int64 := self.cg_privIdx(name, nlen);   // #2097/#2099
    if (pvI >= 0) {
      name := peek64(self.cgUnitPrivVTab + pvI * 32 + 16) as pchar;
      nlen := peek64(self.cgUnitPrivVTab + pvI * 32 + 24);
    }
    if (self.cg_hxSuch(self.coHx, self.conTable, CG_CON_SZ, CG_CON_OFF_NAMELEN, name, nlen) >= 0) { return 1; }   // #2175
    return 0;
  }

  // Returns the index of a constant in conTable, or -1 if not found.
  fn cg_findConIdx(name: pchar, nlen: int64): int64 {
    var pvI: int64 := self.cg_privIdx(name, nlen);   // #2097/#2099
    if (pvI >= 0) {
      name := peek64(self.cgUnitPrivVTab + pvI * 32 + 16) as pchar;
      nlen := peek64(self.cgUnitPrivVTab + pvI * 32 + 24);
    }
    var hs0: int64 := self.zlHxS;
    var ci: int64 := self.cg_hxSuch(self.coHx, self.conTable, CG_CON_SZ, CG_CON_OFF_NAMELEN, name, nlen);   // #2175
    if (self.zlAktiv != 0) { self.zlCoA += 1; self.zlCoT += self.zlHxS - hs0; }   // #2174
    return ci;
  }

  // Add a pchar string constant: stores data offset in conTable and marks conIsPchar.
  // #2026: Nur die LADEART merken — der Wert ist ein Datenoffset und wird per
  // LEA geladen. Ob die Konstante als pchar GILT, entscheidet ihr deklarierter
  // Typ und wird getrennt gesetzt (cg_addConStr).
  fn cg_addConStrAddr(name: pchar, nlen: int64, dataOff: int64) {
    self.cg_addCon(name, nlen, dataOff);
    // #1338: seit cg_addCon einen vorhandenen Eintrag ERSETZT, ist der neue
    // nicht mehr zwingend der letzte. Die Markierung gehoert an den Eintrag,
    // der eben geschrieben wurde — sonst traegt bei einem gleichnamigen
    // zweiten Eintrag eine fremde Konstante das Kennzeichen und wird als
    // Adresse geladen.
    var idx: int64 := self.cg_findConIdx(name, nlen);
    if (idx >= 0) { poke8(self.conIsStrAddr + idx, 1); }
  }

  fn cg_addConStr(name: pchar, nlen: int64, dataOff: int64) {
    self.cg_addConStrAddr(name, nlen, dataOff);
    var idx: int64 := self.cg_findConIdx(name, nlen);
    if (idx >= 0) { poke8(self.conIsPchar + idx, 1); }
  }

  // Emit code to load a constant into rax.
  // For pchar string constants: emits lea rax,[rip+disp32] with a CG_PATCH_STR patch.
  // For int64 constants: emits mov rax, imm64.
  fn cg_emitConLoad(name: pchar, nlen: int64) {
    var idx: int64 := self.cg_findConIdx(name, nlen);
    if (idx < 0) { self.cg_zeroRax(); return; }
    var val: int64 := peek64(self.conTable + idx * CG_CON_SZ + CG_CON_OFF_VAL);
    // #2026: Die LADEART haengt daran, ob der Wert ein Datenoffset ist — nicht
    // daran, ob die Konstante als pchar gilt. Bei `con H: int64 := "…"c as
    // int64` ist beides verschieden: Adresse laden, aber int64 bleiben.
    if (peek8(self.conIsStrAddr + idx) != 0) {
      var pp: int64 := self.cg_emitLeaStr();
      self.cg_addPatch(pp, val, 0, CG_PATCH_STR);
    } else {
      self.cg_movRaxImm(val);
    }
  }

  // Evaluates a compile-time constant expression node and returns its int64 value.
  // Handles literals, unary minus/not, and binary arithmetic/bitwise/comparison ops.
  // Used by cg_genFile to populate conTable for con declarations.
  // #1164: Laesst sich dieser Ausdruck zur Uebersetzungszeit ausrechnen?
  //
  // cg_evalConExpr liefert fuer alles Unbekannte 0 und ist davon nicht zu
  // unterscheiden. Fuer die globale Initialisierung braucht es aber genau
  // diese Unterscheidung: eine 0, die herausgerechnet wurde, ist etwas
  // anderes als eine 0, die entstand, weil niemand hingesehen hat. Die Liste
  // haelt sich absichtlich an dieselben Knotenarten wie cg_evalConExpr —
  // wer dort einen Fall ergaenzt, ergaenzt ihn hier mit.
  fn cg_isConstExpr(node: int64): int64 {
    if (node < 0) { return 0; }
    var k: int64 := self.cg_nkind(node);
    if (k == CGN_LIT_INT)   { return 1; }
    if (k == CGN_LIT_FLOAT) { return 1; }
    // #1514: `false`/`true` sind Literale — der Wert steht zur
    // Uebersetzungszeit fest. Sie fehlten hier, und weil der Zweig fuer
    // globale Startwerte ohne Ausweg endet, wurde daraus die Meldung
    // "Startwert ist zur Uebersetzungszeit nicht bekannt": eine Aussage, die
    // fuer ein Literal nicht zutrifft. `var flag: bool = false` war damit
    // nicht uebersetzbar, `int64` und `f64` an derselben Stelle schon.
    // cg_faltIntConst und cg_tryFold kannten CGN_LIT_BOOL laengst.
    if (k == CGN_LIT_BOOL)  { return 1; }
    if (k == CGN_LIT_CHAR)  { return 1; }
    // #1619: `null` ist die 0 und steht damit fest. cg_evalConExpr kennt den
    // Fall laengst; hier fehlte er, und deshalb war `var g: T := null;` als
    // globaler Startwert nicht uebersetzbar. Zusammen mit #1519 (blosse
    // Deklaration wird abgewiesen) und dem abgewiesenen `:= 0` gab es damit
    // GAR KEINEN Weg, eine globale Klassenvariable in einen definierten
    // Nullzustand zu bringen — das Lazy-Init-Muster war unschreibbar.
    if (k == CGN_LIT_NULL)  { return 1; }
    if (k == CGN_IDENT) {
      return self.cg_hasConVal(self.cg_nsval(node), self.cg_nslen(node));
    }
    if (k == CGN_UNOP) {
      var uop: int64 := self.cg_nival(node);
      if (uop != 87 && uop != 71) { return 0; }   // nur ! und unaeres Minus
      return self.cg_isConstExpr(self.cg_nc0(node));
    }
    if (k == CGN_BINOP) {
      if (self.cg_isConstExpr(self.cg_nc0(node)) == 0) { return 0; }
      return self.cg_isConstExpr(self.cg_nc1(node));
    }
    // #1507: `P.Read as int64` ist zur Uebersetzungszeit bekannt. Der Cast
    // aendert am WERT nichts, der Enum-Wert steht in der Variantentabelle.
    // Bis hierher fiel beides durch: `con MASK := P.Read as int64 | P.Write as
    // int64` wurde still 0, und jede Pruefung `(w & MASK) != 0` damit immer
    // falsch — genau die Schreibweise, die man fuer Flagmasken erwartet.
    if (k == CGN_CAST) {
      return self.cg_isConstExpr(self.cg_nc0(node));
    }
    if (k == CGN_FIELD) {
      if (self.cg_enumFeldWert(node, 0) != 0) { return 1; }
      return 0;
    }
    if (k == CGN_CALL) {
      // sizeof(Type) ist zur Uebersetzungszeit bekannt (BUG-5).
      if (self.cg_seq(self.cg_nsval(node), self.cg_nslen(node), "sizeof", 6)) { return 1; }
      return 0;
    }
    return 0;
  }

  // #1507: Ist `node` ein Enum-Mitglied (Typname.Variante)? Dann 1, und der
  // Wert landet in wertZelle, falls diese nicht 0 ist.
  fn cg_enumFeldWert(node: int64, wertZelle: int64): int64 {
    if (node < 0) { return 0; }
    if (self.cg_nkind(node) != CGN_FIELD) { return 0; }
    var obj: int64 := self.cg_nc0(node);
    if (obj < 0 || self.cg_nkind(obj) != CGN_IDENT) { return 0; }
    var ei: int64 := self.cg_findEnum(self.cg_nsval(obj), self.cg_nslen(obj));
    if (ei < 0) { return 0; }
    var tag: int64 := self.cg_findEnumVariant(ei, self.cg_nsval(node), self.cg_nslen(node));
    if (tag < 0) { return 0; }
    if (wertZelle != 0) { poke64(wertZelle, tag); }
    return 1;
  }

  // #1803: Traegt dieser Knoten ein Gleitkomma-Bitmuster? Nur dann darf das
  // unaere Minus das Vorzeichenbit kippen statt ganzzahlig zu rechnen.
  fn cg_istF64Konstante(node: int64): int64 {
    if (node < 0) { return 0; }
    if (self.cg_nkind(node) == CGN_LIT_FLOAT) { return 1; }
    if (self.cg_nkind(node) == CGN_IDENT) {
      var ci: int64 := self.cg_findConIdx(self.cg_nsval(node), self.cg_nslen(node));
      if (ci >= 0) { if (peek8(self.conIsF64 + ci) != 0) { return 1; } }
    }
    // #1853: Auch ein zusammengesetzter Ausdruck ist Gleitkomma, sobald es
    // einer seiner Operanden ist. Ohne die Rekursion sah `(1.0 / 2.0) * 3.0`
    // ganzzahlig aus, und die Faltung rechnete auf den IEEE-Bits weiter.
    if (self.cg_nkind(node) == CGN_UNOP) {
      return self.cg_istF64Konstante(self.cg_nc0(node));
    }
    if (self.cg_nkind(node) == CGN_BINOP) {
      if (self.cg_istF64Konstante(self.cg_nc0(node)) != 0) { return 1; }
      return self.cg_istF64Konstante(self.cg_nc1(node));
    }
    // #2148: `x as f64` IST Gleitkomma, `y as int64` ist es nicht — massgeblich
    // ist der Zieltyp, nicht der Operand. Ohne diesen Fall sah
    // `(3 as f64) * 0.5` nur ueber die 0.5 nach Gleitkomma aus, die 3 blieb
    // aber eine rohe Ganzzahl, und die Faltung las sie als IEEE-Bits (still 0).
    // Dieselbe Frage beantwortet cg_isF64Expr fuer den Laufzeitweg — die
    // beiden muessen uebereinstimmen.
    if (self.cg_nkind(node) == CGN_CAST) {
      var ctn: int64 := self.cg_nc1(node);
      if (ctn < 0) { return 0; }
      return self.cg_isFloatTypeName(self.cg_nsval(ctn), self.cg_nslen(ctn));
    }
    return 0;
  }

  fn cg_evalConExpr(node: int64): int64 {
    if (node < 0) { return 0; }
    var k: int64 := self.cg_nkind(node);
    if (k == CGN_LIT_INT) { return self.cg_nival(node); }
    if (k == CGN_LIT_BOOL) { return self.cg_nival(node); }   // #1514
    if (k == CGN_LIT_CHAR) { return self.cg_nival(node); }   // #1514
    if (k == CGN_LIT_FLOAT) {
      return self.cg_parseFloat(self.pSrc, self.cg_nsoff(node), self.cg_nslen(node));
    }
    if (k == CGN_IDENT) {
      // #2102: cg_findConVal liefert -1, wenn es den Namen nicht gibt — ein
      // stiller Ersatzwert, den `alloc` zu einem Byte machte. Im strengen
      // (letzten) Durchlauf von cg_collectCons ist das ein Fehler.
      if (self.conStreng != 0 && self.cg_hasConVal(self.cg_nsval(node), self.cg_nslen(node)) == 0) {
        EPrintStr("codegen error: Startwert einer Konstante nennt '"c);
        sys_write(2, self.cg_nsval(node) as int64, self.cg_nslen(node));
        EPrintStrLn("' — das ist hier keine bekannte Konstante (#2102)"c);
        exit(1);
      }
      return self.cg_findConVal(self.cg_nsval(node), self.cg_nslen(node));
    }
    if (k == CGN_UNOP) {
      var uop: int64 := self.cg_nival(node);
      var cv:  int64 := self.cg_evalConExpr(self.cg_nc0(node));
      if (uop == 87) { if (cv == 0) { return 1; } else { return 0; } }  // TK_NOT
      // #1803: Bei GLEITKOMMA traegt cv die IEEE-Bits, und fuer die ist
      // `0 - cv` nicht definiert — es gehoert nur das Vorzeichenbit gekippt.
      // `con N: f64 := -1.5` ergab sonst -3.0: 0 - 0x3FF8000000000000 ist
      // 0xC008000000000000, und das ist als Gleitkomma gelesen -3.0. Dass
      // daraus eine plausible Zahl wird und kein NaN, hat den Fehler getragen.
      //
      // Dieselbe Sperre steht seit #1499 in cg_foldConst; dem unaeren Zweig
      // hier hat sie gefehlt.
      if (uop == 71) {
        if (self.cg_istF64Konstante(self.cg_nc0(node)) != 0) { return cv ^ (1 << 63); }
        return 0 - cv;
      }                                                                  // TK_MINUS
      // #1799: TK_BITNOT fehlte, und der Durchfall darunter lieferte still 0.
      // `con MASKE: int64 := ~0;` war damit 0 statt -1 — und eine Maske, die
      // still 0 wird, macht jede Und-Verknuepfung damit zu 0. Auffallen konnte
      // das erst weit weg von der Deklaration. cg_foldConst rechnete dieselbe
      // Sache eine Zeile weiter richtig (-1 - v); nur diese Stelle nicht.
      if (uop == 92) { return 0 - cv - 1; }                              // TK_BITNOT
      // Kein stiller Default mehr: ein unaerer Operator, der hier nicht steht,
      // wird gemeldet. Geprueft, dass der Bestand keinen solchen Anfangswert
      // benutzt (@ und & kommen in keiner con-Deklaration vor) — sonst waere
      // das Entschaerfen dieser Meldung faellig gewesen, nicht ihr Einbau.
      cg_konstOpUnbekannt(uop);
      return 0;
    }
    if (k == CGN_BINOP) {
      var bop: int64 := self.cg_nival(node);
      var lv:  int64 := self.cg_evalConExpr(self.cg_nc0(node));
      if (bop == 85) { if (lv == 0) { return 0; } return self.cg_evalConExpr(self.cg_nc1(node)); }  // TK_AND
      if (bop == 86) { if (lv != 0) { return 1; } return self.cg_evalConExpr(self.cg_nc1(node)); }  // TK_OR
      var rv: int64 := self.cg_evalConExpr(self.cg_nc1(node));
      // #1853: Sind die Operanden Gleitkomma, tragen lv und rv IEEE-BITS.
      // `lv + rv` darauf ist keine Addition, sondern Unsinn, der wie eine Zahl
      // aussieht: `con H: f64 := 0.0 - 0.5` ergab -8.0, `2.0 * 3.0` ergab 0.0
      // und `0.25 + 0.25` einen Wert, den die Ausgabe als "overflow" meldete.
      //
      // Dieselbe Sperre steht seit #1499 in cg_foldConst und seit #1803 im
      // unaeren Zweig darueber — dem binaeren hat sie gefehlt. Das ist der
      // sechste Fall dieser Familie (#1373, #1499, #1512, #1801, #1803).
      var lF: int64 := self.cg_istF64Konstante(self.cg_nc0(node));
      var rF: int64 := self.cg_istF64Konstante(self.cg_nc1(node));
      if (lF != 0 || rF != 0) {
        // #2148: Ist nur EINE Seite Gleitkomma, traegt die andere eine Zahl,
        // keine Bits — `1.5 * 2` rechnete 1.5 mal das Bitmuster 2 (eine
        // denormale Zahl nahe 0). Umrechnen wie zur Laufzeit (#1212).
        if (lF == 0) { lv := cg_f64AlsBits(lv as f64); }
        if (rF == 0) { rv := cg_f64AlsBits(rv as f64); }
        return cg_faltF64(bop, lv, rv);
      }
      if (bop == 70) { return lv + rv; }                                  // TK_PLUS
      if (bop == 71) { return lv - rv; }                                  // TK_MINUS
      if (bop == 72) { return lv * rv; }                                  // TK_STAR
      if (bop == 73) { if (rv == 0) { return 0; } return lv / rv; }      // TK_SLASH
      if (bop == 74) { if (rv == 0) { return 0; } return lv % rv; }      // TK_PERCENT
      if (bop == 89) { return lv ^ rv; }                                  // TK_BITXOR
      if (bop == 90) { return lv & rv; }                                  // TK_BITAND
      if (bop == 91) { return lv | rv; }                                  // TK_BITOR
      if (bop == 93) { return lv << rv; }                                 // TK_SHL
      if (bop == 94) { return self.cg_sarConst(lv, rv); }                 // TK_SHR (#1125)
      if (bop == 79) { if (lv == rv) { return 1; } else { return 0; } }  // TK_EQ2 ==
      if (bop == 80) { if (lv != rv) { return 1; } else { return 0; } }  // TK_NEQ !=
      if (bop == 81) { if (lv < rv)  { return 1; } else { return 0; } }  // TK_LT  <
      if (bop == 82) { if (lv <= rv) { return 1; } else { return 0; } }  // TK_LE  <=
      if (bop == 83) { if (lv > rv)  { return 1; } else { return 0; } }  // TK_GT  >
      if (bop == 84) { if (lv >= rv) { return 1; } else { return 0; } }  // TK_GE  >=
      return 0;
    }
    if (k == CGN_CAST) {
      // #1507: Fuer Ganzzahl und Enum aendert der Cast am WERT nichts.
      // #2148: Zwischen Ganzzahl und Gleitkomma aendert er die DARSTELLUNG —
      // `3 as f64` traegt die IEEE-Bits von 3.0, `2.5 as int64` die Zahl 2
      // (abgeschnitten wie cvttsd2si). Bis 1.2.16B lief der Wert unveraendert
      // durch, und `con W: f64 := (3 as f64) * 0.5` war still 0.
      var cInner: int64 := self.cg_nc0(node);
      var cv: int64 := self.cg_evalConExpr(cInner);
      var zielF: int64 := self.cg_istF64Konstante(node);
      var quelleF: int64 := self.cg_istF64Konstante(cInner);
      if (zielF != 0 && quelleF == 0) { return cg_f64AlsBits(cv as f64); }
      if (zielF == 0 && quelleF != 0) {
        var ctn2: int64 := self.cg_nc1(node);
        // Nur in eine Ganzzahl abschneiden; jeder andere Zieltyp (bool, pchar)
        // aus einem Gleitkommawert wird nicht still erraten.
        if (ctn2 >= 0 && cg_istGanzzahlTypName(self.cg_nsval(ctn2), self.cg_nslen(ctn2)) != 0) {
          return cg_bitsAlsF64(cv) as int64;
        }
        EPrintStrLn("error: Cast eines Gleitkommawerts in einen Nicht-Ganzzahltyp im Anfangswert einer Konstanten (#2148)."c);
        exit(1);
      }
      return cv;
    }
    if (k == CGN_FIELD) {
      var ez: int64 := alloc(8);
      poke64(ez, 0);
      var okE: int64 := self.cg_enumFeldWert(node, ez);
      var evWert: int64 := peek64(ez);
      free(ez, 8);
      if (okE != 0) { return evWert; }
      return 0;
    }
    if (k == CGN_CALL) {
      // sizeof(Type) in const expression context (BUG-5)
      var cfname: pchar := self.cg_nsval(node);
      var cfnlen: int64 := self.cg_nslen(node);
      if (self.cg_seq(cfname, cfnlen, "sizeof", 6)) {
        var soArg: int64 := self.cg_nc0(node);
        var soSize: int64 := 8;
        if (soArg >= 0) {
          var soName: pchar := self.cg_nsval(soArg);
          var soLen:  int64 := self.cg_nslen(soArg);
          var soClassIdx: int64 := self.cg_findClass(soName, soLen);
          if (soClassIdx >= 0) {
            var soCb: int64 := self.classLayouts + soClassIdx * CG_CLASS_SZ;
            var soFldCnt:   int64 := peek64(soCb + CG_CLASS_OFF_FIELDCNT);
            var soVmtSlots: int64 := peek64(soCb + CG_CLASS_OFF_VMTSLOTS);
            // #1513: die Feldzahl mal acht stimmt nicht mehr, sobald ein Feld
            // inline liegt (Struct als Feld, `[N]T`) oder @packed schmaler ist.
            if (soVmtSlots > 0) {
              soSize := self.cg_classStructSize(soClassIdx) + 8;
            } else {
              soSize := self.cg_classStructSize(soClassIdx);
            }
            if (soFldCnt <= 0) { soSize := 0; }
          }
        }
        return soSize;
      }
      return 0;
    }
    return 0;
  }

  fn cg_addBuiltinCons() {
    // mmap/file descriptor constants (Linux x86-64)
    self.cg_addCon("PROT_READ"c,    9,  1);
    self.cg_addCon("PROT_WRITE"c,   10, 2);
    self.cg_addCon("PROT_RW"c,      7,  3);
    self.cg_addCon("PROT_NONE"c,    9,  0);
    self.cg_addCon("MAP_SHARED"c,   10, 1);
    self.cg_addCon("MAP_PRIVATE"c,  11, 2);
    // #2033: stand auf 12 — der Name hat 13 Zeichen, die Konstante war
    // damit als "MAP_ANONYMOU" abgelegt und `MAP_ANONYMOUS` lieferte still 0.
    // sema kennt den Namen (_regBuiltinCon), liess ihn also durch.
    self.cg_addCon("MAP_ANONYMOUS"c,13, 32);
    self.cg_addCon("MAP_ANON"c,     8,  34);  // MAP_PRIVATE|MAP_ANONYMOUS
    self.cg_addCon("FD_NONE"c,      7,  -1);
    // O_* flags (file open modes)
    // #2033: 8 Zeichen, nicht 7. Heute folgenlos, weil sema den Namen gar
    // nicht fuehrt — aber sobald er dort nachgetragen wird, waere es derselbe
    // stille Fehler wie bei MAP_ANONYMOUS, bei O_WRONLY sogar "schreiben"
    // als "lesen".
    self.cg_addCon("O_RDONLY"c,  8, 0);
    self.cg_addCon("O_WRONLY"c,  8, 1);
    self.cg_addCon("O_RDWR"c,    6, 2);
    self.cg_addCon("O_CREAT"c,   7, 64);
    self.cg_addCon("O_TRUNC"c,   7, 512);
    self.cg_addCon("O_APPEND"c,  8, 1024);
    // Boolean
    self.cg_addCon("true"c,  4, 1);
    self.cg_addCon("false"c, 5, 0);
  }

  // ------------------------------------------------------------------
  // WP-10g: Constant Folding + Peephole CSE helpers
  // ------------------------------------------------------------------

  // mov rbx, imm64  (48 BB xx ... xx) — for const-LHS binop optimisation
  fn cg_movRbxImm(val: int64) {
    self.cg_e8(0x48); self.cg_e8(0xBB); self.cg_e64(val);
  }

  // Try to evaluate node ni as a compile-time integer constant.
  // Returns 1 if successful and stores the value in self.foldBuf; 0 otherwise.
  // #1371: Der x86-Schnellweg hat keinen IR-Optimierer — er vereinfacht aber
  // beim Emittieren: Konstantenfaltung (binaer wie unaer) und das Weglassen
  // eines Zweiges, dessen Bedingung feststeht. Genau das haengt jetzt an der
  // Optimierstufe. `--no-opt` / `-O0` schaltet es ab, und der Schalter hat auf
  // diesem Ziel damit eine ehrliche, wenn auch schmale Bedeutung.
  //
  // Das ersetzt NICHT die eigentliche Aufloesung (den x86-Weg ueber dieselbe
  // IR zu fuehren wie die anderen Ziele) — die bleibt in #1371 als Weg 2
  // beschrieben.
  // #1647: Faltung als OPTIMIERUNG — bei -O0 findet sie nicht statt, und das
  // ist richtig so. Wer einen Wert zur Uebersetzungszeit BRAUCHT (die
  // enum-Deklaration braucht ihn), nimmt cg_foldConst: dieselbe Rechnung ohne
  // die Optimierungsschranke. Bis hierher gab es nur diese eine Funktion, und
  // damit wies -O0 gueltige enum-Konstanten aus importierten Units ab,
  // waehrend -O1..-O3 uebersetzten — ausgerechnet der Schalter, mit dem man
  // Codegen-Fehler eingrenzt, fiel dabei aus.
  fn cg_tryFold(ni: int64): int64 {
    if (self.optLevel == 0) { return 0; }
    return self.cg_foldConst(ni);
  }

  fn cg_foldConst(ni: int64): int64 {
    if (ni < 0) { return 0; }
    // #1499: GLEITKOMMA wird hier nicht gefaltet. Die Faltung rechnet
    // ganzzahlig; auf zwei f64-Konstanten losgelassen, teilte sie deren
    // IEEE-Bitmuster durcheinander — `PI / ZWEI` ergab 0. Fuer Gleitkomma
    // emittiert der Codegen die richtige Rechnung, er darf nur nicht vorher
    // ueberholt werden.
    if (self.cg_isF64Expr(ni) != 0) { return 0; }
    var k: int64 := self.cg_nkind(ni);
    // Integer / bool literal
    if (k == CGN_LIT_INT || k == CGN_LIT_BOOL) {
      self.foldBuf := self.cg_nival(ni);
      return 1;
    }
    // Named constant (con FOO = val)
    if (k == CGN_IDENT) {
      var nm: pchar := self.cg_nsval(ni);
      var nl: int64 := self.cg_nslen(ni);
      if (self.cg_findLocal(nm, nl) != 0) { return 0; }  // local var, not foldable
      if (self.cg_hasConVal(nm, nl) == 0) { return 0; }  // not in con-table
      // #1652: Eine ZEICHENKETTEN-Konstante hat hier keinen Wert zu holen.
      // Die Faltung rechnet ganzzahlig; auf `con C: pchar := "CON"` gab sie
      // die Zahl aus der con-Tabelle zurueck, und der Schnellpfad in
      // cg_genBinop emittierte daraufhin eine Addition, bevor der Zweig fuer
      // `pchar + pchar` ueberhaupt geprueft wurde. `"B[" + C + "]"` verlor so
      // den vorderen Teil. Dieselbe Ueberholung wie bei f64 (#1499) — dort
      // steht die Sperre oben schon.
      var cfi: int64 := self.cg_findConIdx(nm, nl);
      if (cfi >= 0) {
        if (peek8(self.conIsPchar + cfi) != 0) { return 0; }
      }
      self.foldBuf := self.cg_findConVal(nm, nl);        // value may be -1, valid
      return 1;
    }
    // Unary: -const, !const, ~const
    if (k == CGN_UNOP) {
      if (self.cg_foldConst(self.cg_nc0(ni)) == 0) { return 0; }
      var uop: int64 := self.cg_nival(ni);
      if (uop == CGT_MINUS)  { self.foldBuf := 0 - self.foldBuf; return 1; }
      if (uop == CGT_NOT)    { if (self.foldBuf == 0) { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (uop == CGT_BITNOT) { self.foldBuf := -1 - self.foldBuf; return 1; }
      return 0;
    }
    // Binary: both sides must fold
    if (k == CGN_BINOP) {
      if (self.cg_foldConst(self.cg_nc0(ni)) == 0) { return 0; }
      var lv: int64 := self.foldBuf;
      if (self.cg_foldConst(self.cg_nc1(ni)) == 0) { return 0; }
      var rv: int64 := self.foldBuf;
      var bop: int64 := self.cg_nival(ni);
      if (bop == CGT_PLUS)    { self.foldBuf := lv + rv;  return 1; }
      if (bop == CGT_MINUS)   { self.foldBuf := lv - rv;  return 1; }
      if (bop == CGT_STAR)    { self.foldBuf := lv * rv;  return 1; }
      if (bop == CGT_SLASH)   { if (rv == 0) { return 0; } self.foldBuf := lv / rv; return 1; }
      if (bop == CGT_PERCENT) { if (rv == 0) { return 0; } self.foldBuf := lv % rv; return 1; }
      if (bop == CGT_EQ2)  { if (lv == rv) { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_NEQ)  { if (lv != rv) { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_LT)   { if (lv < rv)  { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_LE)   { if (lv <= rv) { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_GT)   { if (lv > rv)  { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_GE)   { if (lv >= rv) { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_AND)  { if (lv != 0 && rv != 0) { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_OR)   { if (lv != 0 || rv != 0) { self.foldBuf := 1; } else { self.foldBuf := 0; } return 1; }
      if (bop == CGT_BITAND) { self.foldBuf := lv & rv; return 1; }
      if (bop == CGT_BITOR)  { self.foldBuf := lv | rv; return 1; }
      if (bop == CGT_SHL)    { self.foldBuf := lv << rv; return 1; }
      if (bop == CGT_SHR)    { self.foldBuf := self.cg_sarConst(lv, rv); return 1; }  // #1125
      return 0;
    }
    return 0;
  }

  // ------------------------------------------------------------------
  // Patch table  (codeOff, namePtr, nameLen, kind) × CG_PATCH_SZ
  // For CG_PATCH_STR: namePtr = dataOff (int64 cast as ptr), nameLen = 0
  // ------------------------------------------------------------------

  fn cg_addPatch(codeOff: int64, namePtr: int64, nlen: int64, kind: int64) {
    if (self.patchCount >= self.patchCap) {
      var nc: int64 := self.patchCap * 2;
      var nb: int64 := alloc(nc * CG_PATCH_SZ);
      var i: int64 := 0;
      memcpy(nb, self.patches, self.patchCount * CG_PATCH_SZ);
      self.patches := nb; self.patchCap := nc;
    }
    var base: int64 := self.patches + self.patchCount * CG_PATCH_SZ;
    poke64(base,      codeOff);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  namePtr);
    poke64(base + CG_PATCH_OFF_NAMELEN, nlen);
    poke64(base + CG_PATCH_OFF_KIND, kind);
    self.patchCount += 1;
  }

  // #1486: Klassifiziert einen Parametertyp nach SysV: 0 = Ganzzahl/Zeiger
  // (rdi, rsi, rdx, rcx, r8, r9), 1 = f64, 2 = f32 (beide xmm0..xmm7).
  // Lyx fuehrt f32 intern als f64-Bits (#1127) — fuer den Aufruf muss daraus
  // ein echtes single werden, sonst liest der Callee die unteren 32 Bit eines
  // double, und die sind bei 1.0 exakt 0.0f.
  fn cg_ffiArgClass(typeNi: int64): int64 {
    if (typeNi < 0) { return 0; }
    var tn: pchar := self.cg_nsval(typeNi);
    var tl: int64 := self.cg_nslen(typeNi);
    if (tl <= 0) { return 0; }
    if (self.cg_seq(tn, tl, "f32"c, 3)) { return 2; }
    if (self.cg_seq(tn, tl, "f64"c, 3)) { return 1; }
    return 0;
  }

  // Das n-te Argumentregister der Ganzzahlreihe als (REX-Bit, ModRM-Nummer).
  // 0=rdi(7) 1=rsi(6) 2=rdx(2) 3=rcx(1) 4=r8(0,REX) 5=r9(1,REX)
  // #1674: Zielregister der Microsoft-Konvention: rcx, rdx, r8, r9.
  fn cg_msIntReg(idx: int64): int64 {
    if (idx == 0) { return 1; }    // rcx
    if (idx == 1) { return 2; }    // rdx
    if (idx == 2) { return 8; }    // r8
    return 9;                      // r9
  }

  // #1674: `push <SysV-Argumentregister idx>` — der Opcode-Zusatz zu 0x50.
  fn cg_ffiPushOp(idx: int64): int64 {
    var r: int64 := self.cg_ffiIntReg(idx);
    if (r >= 8) { self.cg_e8(0x41); return r - 8; }   // REX.B fuer r8/r9
    return r;
  }

  // #1674: `pop <MS-Zielregister idx>`.
  fn cg_ffiPopMs(idx: int64) {
    var r: int64 := self.cg_msIntReg(idx);
    if (r >= 8) { self.cg_e8(0x41); self.cg_e8(0x58 + r - 8); }
    else { self.cg_e8(0x58 + r); }
  }

  fn cg_ffiIntReg(idx: int64): int64 {
    if (idx == 0) { return 7; }
    if (idx == 1) { return 6; }
    if (idx == 2) { return 2; }
    if (idx == 3) { return 1; }
    if (idx == 4) { return 8; }    // r8  — 8 markiert "braucht REX.B/R"
    return 9;                       // r9
  }

  // #1640: movsd xmm_k, [rsp+off]  (F2 0F 10 /r, mod=01, rm=100 → SIB 0x24)
  // Fuer ein Gleitkommaargument, das der allgemeine Aufrufpfad auf den Stapel
  // gelegt hat (Position >= 6). Der Umweg ueber ein GP-Register geht dort
  // nicht — in den GP-Registern liegen nur die ersten sechs Argumente.
  fn cg_ffiMovsdXmmFromRsp(k: int64, off: int64) {
    self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x10);
    if (off <= 127) {
      self.cg_e8(0x44 + k * 8); self.cg_e8(0x24); self.cg_e8(off);
    } else {
      self.cg_e8(0x84 + k * 8); self.cg_e8(0x24); self.cg_e32(off);
    }
  }

  // #1640: mov gpr, [rsp+off]  (REX.W 8B /r)
  fn cg_ffiMovGprFromRsp(gpr: int64, off: int64) {
    var rex: int64 := 0x48;
    var reg: int64 := gpr;
    if (gpr >= 8) { rex := 0x4C; reg := gpr - 8; }
    self.cg_e8(rex); self.cg_e8(0x8B);
    if (off <= 127) {
      self.cg_e8(0x44 + reg * 8); self.cg_e8(0x24); self.cg_e8(off);
    } else {
      self.cg_e8(0x84 + reg * 8); self.cg_e8(0x24); self.cg_e32(off);
    }
  }

  // movq xmm_k, gpr   (66 REX.W 0F 6E /r)
  fn cg_ffiMovqXmmFromGpr(k: int64, gpr: int64) {
    var rex: int64 := 0x48;
    var rm:  int64 := gpr;
    if (gpr >= 8) { rex := 0x49; rm := gpr - 8; }
    self.cg_e8(0x66); self.cg_e8(rex); self.cg_e8(0x0F); self.cg_e8(0x6E);
    self.cg_e8(0xC0 + k * 8 + rm);
  }

  // mov gprDst, gprSrc   (REX.W 89 /r)
  fn cg_ffiMovGpr(dst: int64, src: int64) {
    var rex: int64 := 0x48;
    var d: int64 := dst;
    var sv: int64 := src;
    if (d >= 8)  { rex := rex + 1; d := d - 8; }     // REX.B (rm = Ziel)
    if (sv >= 8) { rex := rex + 4; sv := sv - 8; }   // REX.R (reg = Quelle)
    self.cg_e8(rex); self.cg_e8(0x89); self.cg_e8(0xC0 + sv * 8 + d);
  }

  // #1342: Eine konstante Vorgabe merken.
  fn cg_addDefault(namePtr: pchar, nameLen: int64, pidx: int64, art: int64, wert: int64, wert2: int64) {
    if (self.defCount >= self.defCap) {
      var nc: int64 := self.defCap * 2;
      var nb: int64 := alloc(nc * 48);
      memcpy(nb, self.defTab, self.defCount * 48);
      self.defTab := nb; self.defCap := nc;
    }
    var b: int64 := self.defTab + self.defCount * 48;
    poke64(b,      namePtr as int64);
    poke64(b + 8,  nameLen);
    poke64(b + 16, pidx);
    poke64(b + 24, art);
    poke64(b + 32, wert);
    poke64(b + 40, wert2);
    self.defCount := self.defCount + 1;
  }

  // #1342: Vorgabe fuer Parameter pidx von namePtr — Index im defTab oder -1.
  fn cg_findDefault(namePtr: pchar, nameLen: int64, pidx: int64): int64 {
    var i: int64 := 0;
    while (i < self.defCount) {
      var b: int64 := self.defTab + i * 48;
      if (peek64(b + 16) == pidx) {
        if (peek64(b + 8) == nameLen) {
          if (self.cg_seq(peek64(b) as pchar, nameLen, namePtr, nameLen)) { return i; }
        }
      }
      i := i + 1;
    }
    return 0 - 1;
  }

  // #1342: Ganzzahlige Vorgabe ausrechnen, soweit sie zur Uebersetzungszeit
  // feststeht. Bewusst SCHMAL gehalten — Literal, unaeres Minus darauf und die
  // Grundrechenarten zwischen Literalen. sema muss dieselben Formen annehmen
  // (siehe _defaultIstKonstant dort): waere sema grosszuegiger, liesse es
  // einen Aufruf durch, fuer den hier nichts eingesetzt wird, und der
  // Parameter bekaeme wieder einen Wert vom Stack.
  // Rueckgabe: 1 = gelungen (Wert in wertZelle), 0 = nicht konstant.
  fn cg_faltIntConst(ni: int64, wertZelle: int64): int64 {
    if (ni < 0) { return 0; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_LIT_INT || k == CGN_LIT_BOOL || k == CGN_LIT_CHAR) {
      poke64(wertZelle, self.cg_nival(ni));
      return 1;
    }
    if (k == CGN_LIT_NULL) { poke64(wertZelle, 0); return 1; }
    if (k == CGN_UNOP) {
      if (self.cg_nival(ni) == CGT_MINUS) {
        var innen: int64 := alloc(8);
        var okU: int64 := self.cg_faltIntConst(self.cg_nc0(ni), innen);
        if (okU != 0) { poke64(wertZelle, 0 - peek64(innen)); }
        free(innen, 8);
        return okU;
      }
      return 0;
    }
    if (k == CGN_BINOP) {
      var op: int64 := self.cg_nival(ni);
      if (op != CGT_PLUS && op != CGT_MINUS && op != CGT_STAR) { return 0; }
      var lz: int64 := alloc(8);
      var rz: int64 := alloc(8);
      var okL: int64 := self.cg_faltIntConst(self.cg_nc0(ni), lz);
      var okR: int64 := self.cg_faltIntConst(self.cg_nc1(ni), rz);
      var erg: int64 := 0;
      if (okL != 0 && okR != 0) {
        if (op == CGT_PLUS)  { poke64(wertZelle, peek64(lz) + peek64(rz)); erg := 1; }
        if (op == CGT_MINUS) { poke64(wertZelle, peek64(lz) - peek64(rz)); erg := 1; }
        if (op == CGT_STAR)  { poke64(wertZelle, peek64(lz) * peek64(rz)); erg := 1; }
      }
      free(lz, 8); free(rz, 8);
      return erg;
    }
    return 0;
  }

  // #1342: Beim Einlesen einer Unit die konstanten Vorgaben abschreiben.
  // Nicht-konstante Vorgaben bleiben aussen vor — fuer sie meldet sema
  // weiterhin, statt etwas zu raten.
  fn cg_collectImportDefaults(head: int64) {
    var cur: int64 := head;
    while (cur >= 0) {
      if (self.cg_nkind(cur) == CGN_FUNC_DECL) {
        var fnm: pchar := self.cg_nsval(cur);
        var fnl: int64 := self.cg_nslen(cur);
        var pn: int64 := self.cg_nc0(cur);
        var pidx: int64 := 0;
        while (pn >= 0) {
          var dv: int64 := self.cg_nc1(pn);
          if (dv >= 0) {
            var dk: int64 := self.cg_nkind(dv);
            if (dk != CGN_LIT_FLOAT) {
              var wz: int64 := alloc(8);
              if (self.cg_faltIntConst(dv, wz) != 0) {
                self.cg_addDefault(fnm, fnl, pidx, 1, peek64(wz), 0);
              }
              free(wz, 8);
            }
            if (dk == CGN_LIT_FLOAT) {
              // Der Text des Literals liegt in der Quelle der importierten
              // Unit; die bleibt geladen (siehe Hinweis in cg_processImportAs).
              self.cg_addDefault(fnm, fnl, pidx, 2,
                                 self.cg_parseFloat(self.pSrc, self.cg_nsoff(dv), self.cg_nslen(dv)), 0);
            }
            // Zeichenketten-Vorgaben bleiben aussen vor: ihr Text liegt in
            // der Quelle der importierten Unit, und die Aufnahme in den
            // eigenen Datenbereich ist ein eigener Schritt. sema meldet sie
            // weiterhin, statt dass hier etwas geraten wird.
          }
          pn := self.cg_nnext(pn);
          pidx := pidx + 1;
        }
      }
      cur := self.cg_nnext(cur);
    }
  }

  // Record a declared extern (lookup only — no GOT slot until it is called).
  fn cg_addExternDecl(namePtr: pchar, nlen: int64, libPtr: int64, liblen: int64, declNi: int64) {
    if (self.externDeclCount >= self.externDeclCap) {
      var nc: int64 := self.externDeclCap * 2;
      var nb: int64 := alloc(nc * CG_EXTERN_SZ);
      var i: int64 := 0;
      memcpy(nb, self.externDecls, self.externDeclCount * CG_EXTERN_SZ);
      self.externDecls := nb; self.externDeclCap := nc;
    }
    var base: int64 := self.externDecls + self.externDeclCount * CG_EXTERN_SZ;
    poke64(base,      namePtr as int64);
    poke64(base + CG_EXTERN_OFF_NAMELEN,  nlen);
    poke64(base + CG_EXTERN_OFF_LIBPTR, libPtr);
    poke64(base + CG_EXTERN_OFF_LIBLEN, liblen);
    poke64(base + CG_EXTERN_OFF_NODE, declNi);   // #1486
    self.externDeclCount += 1;
  }

  // Find a declared extern by name; returns its index in externDecls or -1.
  fn cg_findExternDecl(namePtr: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.externDeclCount) {
      var b: int64 := self.externDecls + i * CG_EXTERN_SZ;
      if (self.cg_seq(peek64(b) as pchar, peek64(b + CG_EXTERN_OFF_NAMELEN), namePtr, nlen)) { return i; }
      i += 1;
    }
    return -1;
  }

  // FFI import table: find an extern symbol by name, or register it.
  fn cg_findExtern(namePtr: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.externCount) {
      var b: int64 := self.externSyms + i * CG_EXTERN_SZ;
      if (self.cg_seq(peek64(b) as pchar, peek64(b + CG_EXTERN_OFF_NAMELEN), namePtr, nlen)) { return i; }
      i += 1;
    }
    return -1;
  }

  fn cg_addExtern(namePtr: pchar, nlen: int64, libPtr: int64, liblen: int64): int64 {
    var ex: int64 := self.cg_findExtern(namePtr, nlen);
    if (ex >= 0) { return ex; }
    if (self.externCount >= self.externCap) {
      var nc: int64 := self.externCap * 2;
      var nb: int64 := alloc(nc * CG_EXTERN_SZ);
      var i: int64 := 0;
      memcpy(nb, self.externSyms, self.externCount * CG_EXTERN_SZ);
      self.externSyms := nb; self.externCap := nc;
    }
    var base: int64 := self.externSyms + self.externCount * CG_EXTERN_SZ;
    poke64(base,      namePtr as int64);
    poke64(base + CG_EXTERN_OFF_NAMELEN,  nlen);
    poke64(base + CG_EXTERN_OFF_LIBPTR, libPtr);
    poke64(base + CG_EXTERN_OFF_LIBLEN, liblen);
    var idx: int64 := self.externCount;
    self.externCount += 1;
    return idx;
  }

  // WSP-07: externes Daten-Symbol (extern "asm") suchen / registrieren.
  fn cg_findExternDataIdx(namePtr: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.externDataCount) {
      var b: int64 := self.externData + i * 16;
      if (self.cg_seq(peek64(b) as pchar, peek64(b + 8), namePtr, nlen)) { return i; }
      i += 1;
    }
    return -1;
  }

  fn cg_addExternData(namePtr: pchar, nlen: int64): int64 {
    var ex: int64 := self.cg_findExternDataIdx(namePtr, nlen);
    if (ex >= 0) { return ex; }
    if (self.externDataCount >= self.externDataCap) {
      var nc: int64 := self.externDataCap * 2;
      var nb: int64 := alloc(nc * 16);
      memcpy(nb, self.externData, self.externDataCount * 16);
      self.externData := nb; self.externDataCap := nc;
    }
    var base: int64 := self.externData + self.externDataCount * 16;
    poke64(base,     namePtr as int64);
    poke64(base + 8, nlen);
    var idx: int64 := self.externDataCount;
    self.externDataCount += 1;
    return idx;
  }

  // WSP-07: lea rax, [rip+disp32] auf ein externes Daten-Symbol. disp32 bleibt 0 und
  // wird NICHT in cg_patchAll aufgelöst — cg_writeELFObj erzeugt daraus R_X86_64_PC32.
  fn cg_emitExternDataAddr(name: pchar, nlen: int64) {
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);   // lea rax, [rip+disp32]
    var pos: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pos, name as int64, nlen, CG_PATCH_EXTERN_DATA);
  }

  // #1589: Paar merken (con-Name -> Funktionsname).
  fn cg_addConFn(aliasP: pchar, aliasL: int64, zielP: pchar, zielL: int64) {
    if (self.conFnCount >= self.conFnCap) {
      var nc: int64 := self.conFnCap * 2;
      var nb: int64 := alloc(nc * 32);
      memcpy(nb, self.conFnTab, self.conFnCount * 32);
      self.conFnTab := nb;
      self.conFnCap := nc;
    }
    var base: int64 := self.conFnTab + self.conFnCount * 32;
    poke64(base,      aliasP as int64);
    poke64(base + 8,  aliasL);
    poke64(base + 16, zielP as int64);
    poke64(base + 24, zielL);
    self.conFnCount := self.conFnCount + 1;
  }

  // #1589: nach dem Emittieren aller Funktionen den con-Namen auf dieselbe
  // Stelle legen. Danach loest sich `f(21)` wie ein gewoehnlicher Aufruf auf,
  // statt in "undefined function 'f'" zu enden.
  fn cg_bindConFns() {
    var i: int64 := 0;
    while (i < self.conFnCount) {
      var base: int64 := self.conFnTab + i * 32;
      var zielP: pchar := peek64(base + 16) as pchar;
      var zielL: int64 := peek64(base + 24);
      var off: int64 := self.cg_findLabel(zielP, zielL);
      if (off >= 0) {
        var aliasP: pchar := peek64(base) as pchar;
        var aliasL: int64 := peek64(base + 8);
        if (self.cg_findLabel(aliasP, aliasL) < 0) {
          self.cg_addLabel(aliasP, aliasL, 0);
          poke64(self.labels + (self.labelCount - 1) * CG_LABEL_SZ + CG_LABEL_OFF_CODEOFF, off);
        }
      }
      i := i + 1;
    }
  }

  fn cg_patchAll() {
    var i: int64 := 0;
    while (i < self.patchCount) {
      var base: int64 := self.patches + i * CG_PATCH_SZ;
      var codeOff: int64 := peek64(base);
      var namePtr: int64 := peek64(base + CG_PATCH_OFF_NAMEPTR);
      var nlen:    int64 := peek64(base + CG_PATCH_OFF_NAMELEN);
      var kind:    int64 := peek64(base + CG_PATCH_OFF_KIND);
      if (kind == CG_PATCH_CALL) {
        var targetOff: int64 := self.cg_findLabel(namePtr as pchar, nlen);
        if (targetOff >= 0) {
          var rel32: int64 := targetOff - codeOff - 4;
          poke32(self.code + codeOff, rel32);
        } else if (self.unitCheckMode != 0 && nlen == 4
                   && self.cg_seq(namePtr as pchar, nlen, "main", 4)) {
          // #1587: eine Unit hat kein main. Der Aufruf im Einsprungpunkt bleibt
          // unaufgeloest — im Pruefmodus wird das Erzeugnis ohnehin verworfen.
          // JEDER ANDERE unaufgeloeste Name bleibt ein Fehler; sonst pruefte
          // dieser Lauf weniger, als er verspricht.
        } else if (self.cg_lyuNameHat(namePtr, nlen) != 0) {
          // #2014: deklariert, aber nur aus einer .lyu — ihr Code fehlt auf
          // x86 bis Stufe 5 (Objektcode in der .lyu + eingebauter Binder).
          EPrintStr("error: '"c);
          sys_write(2, namePtr, nlen);
          EPrintStrLn("' stammt aus einer .lyu ohne Objektcode und ist auf x86 noch nicht aufrufbar"c);
          EPrintStrLn("  Die .lyu beschreibt Konstanten, Signaturen und Layouts (#2014 Stufen 1–4), traegt"c);
          EPrintStrLn("  aber keinen x86-Code (Stufe 5). Abhilfe: die .lyx der Unit beilegen, oder ein"c);
          EPrintStrLn("  IR-Ziel waehlen (--target=arm64/riscv) mit einer fuer dieses Ziel gebauten .lyu."c);
          exit(1);
        } else {
          EPrintStr("error: undefined function '"c);
          sys_write(2, namePtr, nlen);
          EPrintStr("' — no codegen implementation found\n"c);
          exit(1);
        }
      } else if (kind == CG_PATCH_EXTERN) {
        // FFI call disp32 — resolved in cg_writeELFDynamic once the GOT
        // virtual address is known. Nothing to do here.
      } else if (kind == CG_PATCH_EXTERN_DATA) {
        // WSP-07: externes Daten-Symbol — nur im ET_REL-Objektmodus auflösbar (via ld).
        // In einem normalen Executable gibt es keinen Linker → fail-closed.
        if (self.objMode == 0) {
          EPrintStr("error: extern \"asm\" '"c);
          sys_write(2, namePtr, nlen);
          EPrintStr("' benoetigt --emit=obj (Linker-aufgeloestes Symbol)\n"c);
          exit(1);
        }
        // disp32 bleibt 0 → wird in cg_writeELFObj zu R_X86_64_PC32.
      } else if (kind == CG_PATCH_DATA_FN) {
        // #1574: globaler Funktionszeiger mit Startwert.
        var fnOff: int64 := self.cg_findLabel(namePtr as pchar, nlen);
        if (fnOff < 0) {
          EPrintStr("error: globaler Funktionszeiger: unbekannte Funktion '"c);
          sys_write(2, namePtr, nlen);
          EPrintStr("'\n"c);
          exit(1);
        }
        poke64(self.data + codeOff, CG_ELF_BASE + CG_CODE_OFF + fnOff);
        // Absolute Adresse im Datenbereich: PE und der LyxOS-Loader muessen
        // sie verschieben, genau wie bei CG_PATCH_DATA_PTR.
        self.cg_addBaseReloc(CG_CODE_OFF + self.codeLen + codeOff);
      } else if (kind == CG_PATCH_DATA_PTR) {
        // #1164/#1298: Der Datenbereich folgt unmittelbar auf den Code — die
        // Adresse steht also erst hier fest. codeOff ist der Slot IM
        // DATENBEREICH, namePtr der Offset der Zeichenkette.
        var slotOff: int64 := codeOff;
        var strOff:  int64 := namePtr;
        poke64(self.data + slotOff, CG_ELF_BASE + CG_CODE_OFF + self.codeLen + strOff);
        // Der Slot traegt eine absolute Adresse: PE und der LyxOS-Loader
        // muessen ihn um (load_base - CG_ELF_BASE) verschieben. Ohne diesen
        // Eintrag waere der Zeiger ueberall dort falsch, wo nicht auf
        // 0x400000 geladen wird.
        self.cg_addBaseReloc(CG_CODE_OFF + self.codeLen + slotOff);
      } else {
        // CG_PATCH_STR: namePtr encodes data offset
        var dataOff: int64 := namePtr;
        var disp32: int64 := self.codeLen - codeOff - 4 + dataOff;
        poke32(self.code + codeOff, disp32);
      }
      i += 1;
    }
    // #1961 Stufe 2: Die Ressourcentabelle entsteht HIER, nicht waehrend des
    // Durchlaufs: erst jetzt steht fest, welche Angaben es gibt, und erst hier
    // ist die Codelaenge endgueltig, aus der sich die Datenadresse ergibt.
    //
    // In der Tabelle stehen bis dahin DATENOFFSETS. Ein Offset ist zur
    // Laufzeit keine gueltige Adresse — ohne den Nachtrag unten zeigte jeder
    // Eintrag an den Anfang des Adressraums, und der erste Zugriff faultete.
    var datenBasis: int64 := CG_ELF_BASE + CG_CODE_OFF + self.codeLen;
    self.cg_emitResTable();
    if (self.resTabOff >= 0) {
      // Der Zeiger auf die Tabelle in den reservierten Platz, den
      // GetResTable() liest.
      var rtAdr: int64 := datenBasis + self.resTabOff;
      var rb2: int64 := 0;
      while (rb2 < 8) {
        poke8(self.data + CG_RESTAB + rb2, (rtAdr >> (rb2 * 8)) & 255);
        rb2 := rb2 + 1;
      }
      // Namens- und Datenzeiger jedes Eintrags von Offset auf Adresse heben.
      var ri: int64 := 0;
      while (ri < self.resCount) {
        var ez: int64 := self.resTabOff + 8 + ri * 32;   // Tabelle: 4 x int64 je Eintrag
        self.cg_datenOffsetZuAdresse(ez,     datenBasis);   // Name
        self.cg_datenOffsetZuAdresse(ez + 16, datenBasis);  // Bytes
        // #2124/#2135: absolute Zeiger wie jeder andere — die .so (RELATIVE),
        // PE (.reloc) und LyxOS (PT_LYXRELOC) muessen sie verschieben. Bis
        // 1.2.15A nur fuer die .so; im PE und unter LyxOS zeigten sie bei
        // abweichender Ladebasis weiter nach 0x400000.
        self.cg_addBaseReloc(CG_CODE_OFF + self.codeLen + ez);
        self.cg_addBaseReloc(CG_CODE_OFF + self.codeLen + ez + 16);
        ri := ri + 1;
      }
      self.cg_addBaseReloc(CG_CODE_OFF + self.codeLen + CG_RESTAB);
    }
    // WP-10a: patch VMT address placeholders
    // vmtVaddr = CG_ELF_BASE + CG_CODE_OFF + codeLen + vmtDataOff
    var vmtBase: int64 := CG_ELF_BASE + CG_CODE_OFF + self.codeLen;
    var j: int64 := 0;
    while (j < self.vmtPatchCount) {
      var vbase: int64 := self.vmtPatches + j * CG_VMT_PATCH_SZ;
      var codeOff2:  int64 := peek64(vbase);
      var namePtr2: pchar   := peek64(vbase + CG_PATCH_OFF_NAMEPTR) as pchar;
      var nameLen2:  int64 := peek64(vbase + CG_PATCH_OFF_NAMELEN);
      var classIdx: int64 := self.cg_findClass(namePtr2, nameLen2);
      if (classIdx >= 0) {
        var cb: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
        var vmtDataOff: int64 := peek64(cb + CG_CLASS_OFF_VMTOFF);
        if (self.sharedLib != 0) {
          // #2124: In einer .so waere die absolute Adresse eine Relocation im
          // Code — eine Text-Relocation, die bionic ab API 23 ablehnt. Der
          // Abstand Code→Daten steht fest, also PC-relativ.
          self.cg_soMovabsZuLea(codeOff2, self.codeLen + vmtDataOff);
        } else {
          poke64(self.code + codeOff2, vmtBase + vmtDataOff);
          // WP-A2.2: the movabs imm64 just written is an absolute pointer → base reloc.
          self.cg_addBaseReloc(CG_CODE_OFF + codeOff2);
        }
      }
      j += 1;
    }
    // WP-BC-19: fill VMT method slots with method code virtual addresses
    // Method code vaddr = CG_ELF_BASE + CG_CODE_OFF + methodCodeStart
    var codeBase: int64 := CG_ELF_BASE + CG_CODE_OFF;
    var mp: int64 := 0;
    while (mp < self.vmtMethodPatchCount) {
      var mpBase: int64 := self.vmtMethodPatches + mp * CG_VMT_METH_PATCH_SZ;
      var slotDataOff:  int64 := peek64(mpBase);
      var methCodeStart: int64 := peek64(mpBase + CG_VMT_METH_OFF_CODESTART);
      poke64(self.data + slotDataOff, codeBase + methCodeStart);
      // WP-A2.2: VMT slot holds an absolute code pointer (data RVA = code + codeLen + off).
      self.cg_addBaseReloc(CG_CODE_OFF + self.codeLen + slotDataOff);
      mp += 1;
    }
    // WP-BC-L2: propagate inherited (non-overridden) vtable slots base→derived.
    // Own/overridden slots were filled above (non-zero code vaddr); slots still 0
    // are inherited and copied from the parent vtable. Declaration order guarantees
    // each parent is fully resolved before its children (incl. multi-level chains).
    var ciP: int64 := 0;
    while (ciP < self.classCount) {
      var cbpP: int64 := self.classLayouts + ciP * CG_CLASS_SZ;
      var parIdxP: int64 := peek64(cbpP + CG_CLASS_OFF_PARENTIDX);
      var myOffP: int64 := peek64(cbpP + CG_CLASS_OFF_VMTOFF);
      if (parIdxP >= 0 && myOffP >= 0) {
        var pbpP: int64 := self.classLayouts + parIdxP * CG_CLASS_SZ;
        var pOffP: int64 := peek64(pbpP + CG_CLASS_OFF_VMTOFF);
        var mySlotsP: int64 := peek64(cbpP + CG_CLASS_OFF_VMTSLOTS);
        var pSlotsP: int64 := peek64(pbpP + CG_CLASS_OFF_VMTSLOTS);
        if (pOffP >= 0) {
          var limP: int64 := pSlotsP;
          if (mySlotsP < limP) { limP := mySlotsP; }
          var sP: int64 := 0;
          while (sP < limP) {
            if (peek64(self.data + myOffP + sP * 8) == 0) {
              poke64(self.data + myOffP + sP * 8, peek64(self.data + pOffP + sP * 8));
              // WP-A2.2: inherited slot now holds an absolute code pointer → base reloc.
              self.cg_addBaseReloc(CG_CODE_OFF + self.codeLen + myOffP + sP * 8);
            }
            sP += 1;
          }
        }
      }
      ciP += 1;
    }
  }

  // ------------------------------------------------------------------
  // String data section
  // Copies source string (with escape processing) into data buffer.
  // sOff = offset in source of opening quote char '"'
  // sLen = raw token length including both quotes
  // Returns: offset within data buffer (for use in LEA disp32 patch)
  // ------------------------------------------------------------------

  // #1285: Wert einer Hexziffer, oder -1.
  fn cg_hexVal(ch: int64): int64 {
    if (ch >= 48 && ch <= 57)  { return ch - 48; }       // 0-9
    if (ch >= 97 && ch <= 102) { return ch - 97 + 10; }   // a-f
    if (ch >= 65 && ch <= 70)  { return ch - 65 + 10; }   // A-F
    return 0 - 1;
  }

  // #1378: Rohzeichenkette — Bytes unveraendert uebernehmen. Ein Regex-Literal
  // `r"\d+"` ist genau dafuer da, dass der Backslash stehen bleibt; die
  // Escape-Auswertung von cg_addStr machte daraus einen Fehler
  // ("unbekannte Escape-Sequenz '\d'") und aus `r"a\nb"` einen Zeilenumbruch.
  // Uebersprungen werden nur die beiden Anfuehrungszeichen.
  fn cg_addStrRaw(sOff: int64, sLen: int64): int64 {
    var doff: int64 := self.dataLen;
    var i: int64 := sOff + 1;
    var eend: int64 := sOff + sLen - 1;
    while (i < eend) {
      self.cg_edata(StrCharAt(self.pSrc, i) & 255);
      i := i + 1;
    }
    self.cg_edata(0);
    return doff;
  }

  // #2014: Bytes, die NICHT aus dem Quelltextpuffer stammen, in den
  // Datenbereich legen. cg_addStr liest aus self.pSrc und loest dabei
  // Anfuehrungszeichen und Escapes auf; ein Konstantenwert aus einer `.lyu`
  // ist bereits aufgeloest und liegt woanders.
  fn cg_addStrRoh(ptr: int64, len: int64): int64 {
    var doff: int64 := self.dataLen;
    var i: int64 := 0;
    while (i < len) { self.cg_edata(peek8(ptr + i)); i += 1; }
    self.cg_edata(0);
    return doff;
  }

  fn cg_addStr(sOff: int64, sLen: int64): int64 {
    var doff: int64 := self.dataLen;
    var i: int64 := sOff + 1;          // skip opening '"'
    var eend: int64 := sOff + sLen - 1; // stop before closing '"'
    if (StrCharAt(self.pSrc, sOff + sLen - 1) == 99) { eend := eend - 1; } // pchar 'c' suffix
    while (i < eend) {
      var c: int64 := StrCharAt(self.pSrc, i);
      if (c == 92 && i + 1 < eend) {   // backslash
        // #1285: Der Catch-all gab frueher einfach das Zeichen nach dem
        // Backslash aus — aus "A\x42C" wurde "Ax42C", aus dem ANSI-Praefix
        // "\x1b[30m" das sichtbare "x1b[30m". std/crt.lyx baut seine
        // Farbausgabe genau darauf auf und war damit wirkungslos, ohne dass
        // etwas gemeldet wurde.
        var esc: int64 := StrCharAt(self.pSrc, i + 1);
        if (esc == 110) { self.cg_edata(10); i += 2; }        // \n
        else if (esc == 114) { self.cg_edata(13); i += 2; }   // \r
        else if (esc == 116) { self.cg_edata(9);  i += 2; }   // \t
        else if (esc == 48)  { self.cg_edata(0);  i += 2; }   // \0
        else if (esc == 92)  { self.cg_edata(92); i += 2; }   // \\
        else if (esc == 34)  { self.cg_edata(34); i += 2; }   // \"
        else if (esc == 39)  { self.cg_edata(39); i += 2; }   // \'
        else if (esc == 120 || esc == 88) {
          // \xHH — zwei Hexziffern. Steht so nicht in ebnf.md §1, wird im
          // Bestand aber gebraucht (std/crt.lyx: ANSI-Sequenzen) und ist die
          // Schreibweise, die jeder erwartet. Die Grammatik ist entsprechend
          // nachgezogen.
          var h1: int64 := 0 - 1;
          var h2: int64 := 0 - 1;
          if (i + 3 < eend) {
            h1 := self.cg_hexVal(StrCharAt(self.pSrc, i + 2));
            h2 := self.cg_hexVal(StrCharAt(self.pSrc, i + 3));
          }
          if (h1 < 0 || h2 < 0) {
            EPrintStrLn("codegen error: \\x erwartet genau zwei Hexziffern (#1285)"c);
            exit(1);
          }
          self.cg_edata(h1 * 16 + h2);
          i += 4;
        } else {
          // Unbekannte Sequenz: melden statt das Zeichen durchzureichen.
          EPrintStr("codegen error: unbekannte Escape-Sequenz '\\"c);
          sys_write(2, self.pSrc as int64 + i + 1, 1);
          EPrintStrLn("' (#1285)"c);
          EPrintStrLn("  Erlaubt sind \\n \\r \\t \\0 \\\\ \\\" \\' und \\xHH."c);
          exit(1);
        }
      } else {
        self.cg_edata(c);
        i += 1;
      }
    }
    self.cg_edata(0);  // null terminator
    return doff;
  }

  // ------------------------------------------------------------------
  // x86_64 instruction emitters
  // ------------------------------------------------------------------

  // mov rax, imm64   (10 bytes: 48 B8 + 8 byte LE)
  fn cg_movRaxImm(n: int64) {
    self.cg_e8(0x48); self.cg_e8(0xB8); self.cg_e64(n);
  }

  // #2247: In welchem Register liegt dieser Bezeichner — 12..15 fuer r12..r15,
  // sonst -1. Gefragt wird dieselbe Auskunft wie cg_loadRax/cg_storeRax
  // benutzen (cg_rlReg, #2114); hier nur fuer die Adressrechnung von
  // peek*/poke*, damit dafuer kein Register materialisiert werden muss.
  fn cg_adrRegVon(ni: int64): int64 {
    if (ni < 0) { return 0 - 1; }
    if (self.cg_nkind(ni) != CGN_IDENT) { return 0 - 1; }
    var off: int64 := self.cg_findLocal(self.cg_nsval(ni), self.cg_nslen(ni));
    if (off == 0) { return 0 - 1; }
    var r: int64 := self.cg_rlReg(off);
    if (r < 0) { return 0 - 1; }
    return 12 + r;
  }

  // #2247: Zerlegt die Adresse eines peek*/poke* in `basis + index * k`.
  //
  // Erkannt werden `A + B` und `A + B * k` mit k aus {1,2,4,8} (die Formen,
  // die x86 im Operanden traegt). Geliefert wird ueber die drei Kaestchen:
  // Basisknoten, Indexregister (12..15) und k. Rueckgabe 1 = erkannt.
  //
  // Der INDEX muss in einem Register liegen (cg_rlReg, #2114) — ihn zu laden
  // wuerde den Gewinn wieder aufheben. Die BASIS darf auch im Rahmen liegen;
  // der Aufrufer laedt sie dann einmal, was immer noch kuerzer ist als
  // Adresse rechnen, retten und zurueckholen.
  fn cg_adrZerlegen(adrNi: int64, basisBox: int64, idxBox: int64, kBox: int64): int64 {
    if (adrNi < 0) { return 0; }
    if (self.cg_nkind(adrNi) != CGN_BINOP) { return 0; }
    if (self.cg_nival(adrNi) != CGT_PLUS) { return 0; }
    var li: int64 := self.cg_nc0(adrNi);
    var ri: int64 := self.cg_nc1(adrNi);
    if (li < 0 || ri < 0) { return 0; }
    // Form 1: A + B   (B im Register)
    var rr: int64 := self.cg_adrRegVon(ri);
    if (rr >= 12) {
      poke64(basisBox, li); poke64(idxBox, rr); poke64(kBox, 1);
      return 1;
    }
    // Form 2: A + B * k   (B im Register, k Literal 1/2/4/8)
    if (self.cg_nkind(ri) == CGN_BINOP && self.cg_nival(ri) == CGT_STAR) {
      var fi: int64 := self.cg_nc0(ri);
      var ki: int64 := self.cg_nc1(ri);
      var fr: int64 := self.cg_adrRegVon(fi);
      if (fr >= 12 && self.cg_tryFold(ki) != 0) {
        var kv: int64 := self.foldBuf;
        if (kv == 1 || kv == 2 || kv == 4 || kv == 8) {
          poke64(basisBox, li); poke64(idxBox, fr); poke64(kBox, kv);
          return 1;
        }
      }
    }
    return 0;
  }

  // #2247: `[basis + index * k]` als Speicheroperand, ModRM/SIB ohne
  // Verschiebung. reg ist das Registerfeld (0..7, hier immer rax = 0).
  //
  // Zwei Fallen, beide aus #2205 bekannt: mit mod = 00 heisst Basis 101
  // (rbp/r13) "32-Bit-Verschiebung ohne Basis", und Index 100 ist ohne REX.X
  // "kein Index". Der Aufrufer dreht die beiden deshalb so, dass r13 als
  // INDEX steht (dort ist 101 gueltig) — Addition ist kommutativ. Beide
  // Register liegen in r12..r15, REX.X und REX.B sind also immer gesetzt und
  // Index 100 bedeutet r12, nicht rsp.
  fn cg_memBasisIndex(reg: int64, basis: int64, index: int64, k: int64) {
    var sc: int64 := 0;
    if (k == 2) { sc := 1; }
    if (k == 4) { sc := 2; }
    if (k == 8) { sc := 3; }
    self.cg_e8(0x04 | ((reg & 7) << 3));          // ModRM: mod=00, rm=100 (SIB)
    self.cg_e8((sc * 64) | ((index & 7) << 3) | (basis & 7));
  }

  // mov [rbp+off], rax  (store rax at rbp-relative offset)
  fn cg_storeRax(off: int64) {
    var rlR: int64 := self.cg_rlReg(off);   // #2114
    if (rlR >= 0) { self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC4 + rlR); return; }   // mov r12+i, rax
    if (off >= -128 && off <= 127) {
      // 48 89 45 off8
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x45); self.cg_e8(off);
    } else {
      // 48 89 85 off32
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(off);
    }
  }

  // mov [rbp+off], rdx  (store second tuple return value)
  fn cg_storeRdx(off: int64) {
    var rlR: int64 := self.cg_rlReg(off);   // #2114
    if (rlR >= 0) { self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xD4 + rlR); return; }   // mov r12+i, rdx
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x55); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x95); self.cg_e32(off);
    }
  }

  // mov rax, [rbp+off]
  fn cg_loadRax(off: int64) {
    var rlR: int64 := self.cg_rlReg(off);   // #2114
    if (rlR >= 0) { self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0xE0 + (rlR << 3)); return; }   // mov rax, r12+i
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x45); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x85); self.cg_e32(off);
    }
  }

  // mov [rbp+off], rdi  (spill arg0 to stack)
  fn cg_spillRdi(off: int64) {
    var rlS: int64 := self.cg_rlReg(off);   // #2114: Parameter im Register
    if (rlS >= 0) { self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xFC + rlS); return; }
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x7D); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xBD); self.cg_e32(off);
    }
  }

  // mov [rbp+off], rsi  (spill arg1)
  fn cg_spillRsi(off: int64) {
    var rlS: int64 := self.cg_rlReg(off);   // #2114: Parameter im Register
    if (rlS >= 0) { self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xF4 + rlS); return; }
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x75); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xB5); self.cg_e32(off);
    }
  }

  // mov [rbp+off], rdx  (spill arg2)
  fn cg_spillRdx(off: int64) {
    var rlS: int64 := self.cg_rlReg(off);   // #2114: Parameter im Register
    if (rlS >= 0) { self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xD4 + rlS); return; }
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x55); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x95); self.cg_e32(off);
    }
  }

  // mov [rbp+off], rcx  (spill arg3)
  fn cg_spillRcx(off: int64) {
    var rlS: int64 := self.cg_rlReg(off);   // #2114: Parameter im Register
    if (rlS >= 0) { self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xCC + rlS); return; }
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x4D); self.cg_e8(off);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x8D); self.cg_e32(off);
    }
  }

  // mov [rbp+off], r8  (spill arg4)
  fn cg_spillR8(off: int64) {
    var rlS: int64 := self.cg_rlReg(off);   // #2114: Parameter im Register
    if (rlS >= 0) { self.cg_e8(0x4D); self.cg_e8(0x89); self.cg_e8(0xC4 + rlS); return; }
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x45); self.cg_e8(off);
    } else {
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(off);
    }
  }

  // mov [rbp+off], r9  (spill arg5)
  fn cg_spillR9(off: int64) {
    var rlS: int64 := self.cg_rlReg(off);   // #2114: Parameter im Register
    if (rlS >= 0) { self.cg_e8(0x4D); self.cg_e8(0x89); self.cg_e8(0xCC + rlS); return; }
    if (off >= -128 && off <= 127) {
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x4D); self.cg_e8(off);
    } else {
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x8D); self.cg_e32(off);
    }
  }

  // lea rax, [rip + disp32]  — for string literals; disp32 is placeholder 0
  // Returns: position of disp32 in code buffer (for patching)
  fn cg_emitLeaStr(): int64 {
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
    var pos: int64 := self.codeLen;
    self.cg_e32(0);
    return pos;
  }

  // WP-12: Emit lea rcx, [rip+disp32] to access a data section global.
  // dataOff = CG_EXN_VAL (0) or CG_EXN_PTR (8). Adds a CG_PATCH_STR patch.
  fn cg_emitLeaRcxData(dataOff: int64) {
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x0D);  // lea rcx, [rip+disp32]
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, dataOff, 0, CG_PATCH_STR);
  }

  // WP-BC-01: lea rdi, [rip+disp32]  (48 8D 3D disp32)
  fn cg_emitLeaRdiData(dataOff: int64) {
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x3D);  // lea rdi, [rip+disp32]
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, dataOff, 0, CG_PATCH_STR);
  }

  // WP-BC-02: lea rax, [rip+disp32]  (48 8D 05 disp32)
  fn cg_emitLeaRaxData(dataOff: int64) {
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);  // lea rax, [rip+disp32]
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, dataOff, 0, CG_PATCH_STR);
  }

  // WP-CS-09: mov [rip+CG_IO_RESULT], rax  (48 89 05 disp32)
  fn cg_emitIoResultSave() {
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05);
    var pp: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pp, CG_IO_RESULT, 0, CG_PATCH_STR);
  }

  // WP-CS-09: if rax < 0 (syscall error): panic with io error message
  fn cg_emitIoCheckPanic() {
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
    self.cg_e8(0x79);                                         // jns .ok
    var pSkip: int64 := self.codeLen;
    self.cg_e8(0);
    if (self.ioCheckMsgOff < 0) {
      self.ioCheckMsgOff := self.dataLen;
      // "lyxc: I/O error (use @io_check(false) to suppress)\n\0"
      self.cg_edata(108); self.cg_edata(121); self.cg_edata(120); self.cg_edata(99);   // lyxc
      self.cg_edata(58);  self.cg_edata(32);                                           // ": "
      self.cg_edata(73);  self.cg_edata(47);  self.cg_edata(79);  self.cg_edata(32);  // "I/O "
      self.cg_edata(101); self.cg_edata(114); self.cg_edata(114); self.cg_edata(111); self.cg_edata(114); // "error"
      self.cg_edata(32);                                                                // " "
      self.cg_edata(40);                                                                // "("
      self.cg_edata(117); self.cg_edata(115); self.cg_edata(101);                      // "use"
      self.cg_edata(32);                                                                // " "
      self.cg_edata(64);                                                                // "@"
      self.cg_edata(105); self.cg_edata(111); self.cg_edata(95);                       // "io_"
      self.cg_edata(99);  self.cg_edata(104); self.cg_edata(101); self.cg_edata(99); self.cg_edata(107); // "check"
      self.cg_edata(40);  self.cg_edata(102); self.cg_edata(97);  self.cg_edata(108); self.cg_edata(115); self.cg_edata(101); self.cg_edata(41); // "(false)"
      self.cg_edata(32);  self.cg_edata(116); self.cg_edata(111); self.cg_edata(32);  // " to "
      self.cg_edata(115); self.cg_edata(117); self.cg_edata(112); self.cg_edata(112); self.cg_edata(114); // "suppr"
      self.cg_edata(101); self.cg_edata(115); self.cg_edata(115);                      // "ess"
      self.cg_edata(41);                                                                // ")"
      self.cg_edata(10);                                                                // "\n"
      self.cg_edata(0);                                                                 // NUL
    }
    self.cg_emitLeaRdiData(self.ioCheckMsgOff);
    self.cg_emitPanicBody();
    // .ok:
    cg_patchRel8(self.code, pSkip, self.codeLen);
  }

  // WP-CS-10: if OF is set (signed overflow): panic with overflow message
  fn cg_emitOverflowPanic() {
    self.cg_e8(0x71);                                               // jno .ok
    var pSkip: int64 := self.codeLen;
    self.cg_e8(0);
    if (self.overflowMsgOff < 0) {
      self.overflowMsgOff := self.dataLen;
      // "lyxc: integer overflow detected\n\0"
      self.cg_edata(108); self.cg_edata(121); self.cg_edata(120); self.cg_edata(99);   // lyxc
      self.cg_edata(58);  self.cg_edata(32);                                           // ": "
      self.cg_edata(105); self.cg_edata(110); self.cg_edata(116); self.cg_edata(101); // "inte"
      self.cg_edata(103); self.cg_edata(101); self.cg_edata(114); self.cg_edata(32);  // "ger "
      self.cg_edata(111); self.cg_edata(118); self.cg_edata(101); self.cg_edata(114); // "over"
      self.cg_edata(102); self.cg_edata(108); self.cg_edata(111); self.cg_edata(119); // "flow"
      self.cg_edata(32);                                                                // " "
      self.cg_edata(100); self.cg_edata(101); self.cg_edata(116); self.cg_edata(101); // "dete"
      self.cg_edata(99);  self.cg_edata(116); self.cg_edata(101); self.cg_edata(100); // "cted"
      self.cg_edata(10);  self.cg_edata(0);                                            // "\n\0"
    }
    self.cg_emitLeaRdiData(self.overflowMsgOff);
    self.cg_emitPanicBody();
    // .ok:
    cg_patchRel8(self.code, pSkip, self.codeLen);
  }

  // WP-12: Emit longjmp code. rax must hold jmp_buf base pointer.
  // Restores rbx, rbp, r12..r15; sets rsp=rax; then jmp [rsp+56] (catch label).
  fn cg_genLongjmp() {
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x18);                     // mov rbx, [rax]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x68); self.cg_e8(0x08);  // mov rbp, [rax+8]
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x60); self.cg_e8(0x10);  // mov r12, [rax+16]
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x68); self.cg_e8(0x18);  // mov r13, [rax+24]
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x70); self.cg_e8(0x20);  // mov r14, [rax+32]
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x78); self.cg_e8(0x28);  // mov r15, [rax+40]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC4);                     // mov rsp, rax
    self.cg_e8(0xFF); self.cg_e8(0x64); self.cg_e8(0x24); self.cg_e8(0x38);  // jmp [rsp+56]
  }

  // #1242: Die anliegende Ausnahme weiterreichen. Der Wert steht unveraendert
  // in CG_EXN_VAL — niemand hat ihn gefangen —, gesucht wird also nur der
  // naechste Handler. Gibt es keinen, endet das Programm mit 1, genau wie ein
  // `throw` ohne jeden try. Aufgerufen wird das auf dem Ausnahmeweg eines
  // try-Blocks OHNE catch, nachdem sein finally gelaufen ist.
  //
  // Die verbliebenen defers dieses Rahmens laufen davor: die Ausnahme verlaesst
  // die Funktion, und was der Rumpf vor dem try angemeldet hat, waere sonst
  // uebersprungen (dieselbe Luecke wie #1241 am throw selbst).
  fn cg_emitRethrow() {
    if (self.deferCount > 0) { self.cg_emitDefersDownTo(0); }
    self.cg_emitLeaRcxData(CG_EXN_PTR);
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);   // mov rax, [rcx]
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
    self.cg_e8(0x0F); self.cg_e8(0x84);                      // jz .noHandler
    var rtNH: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_genLongjmp();
    poke32(self.code + rtNH, self.codeLen - rtNH - 4);
    // kein Handler: Prozess beenden (#1487: exit_group, nicht exit)
    self.cg_movRaxImm(1);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);   // mov rdi, rax
    self.cg_movRaxImm(231);
    self.cg_e8(0x0F); self.cg_e8(0x05);                      // syscall
  }

  // WP-BC-01: Emit inline panic body — rdi must hold the message pointer.
  // Writes message to stderr then exits(1) (or longjmps if handler is installed).
  fn cg_emitPanicBody() {
    self.cg_emitLeaRcxData(CG_EXN_VAL);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x39);                                                             // mov [rcx], rdi
    self.cg_e8(0x57);                                                                                                   // push rdi
    var ppSL: int64 := self.cg_emitCall();
    poke32(self.code + ppSL, CG_H_STRLEN - ppSL - 4);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2);                                                             // mov rdx, rax
    self.cg_e8(0x5F);                                                                                                   // pop rdi
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xFE);                                                             // mov rsi, rdi
    self.cg_e8(0xBF); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);                       // mov edi, 2
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);                       // mov eax, 1
    self.cg_e8(0x0F); self.cg_e8(0x05);                                                                                // syscall (write)
    // #1149: KEIN longjmp. panic meldet einen Zustand, der nicht auftreten
    // darf — eine verletzte Invariante, einen Programmierfehler, einen
    // Hardwaredefekt. Bis 1.0.15A sprang der Abbruch in einen installierten
    // Handler, ein `try`/`catch` verschluckte ihn also und das Programm lief
    // mit gebrochener Invariante weiter (Exit 0). Der Prozess endet hier
    // unbedingt; das ist genau die Zusicherung des Konstrukts.
    self.cg_movRaxImm(1);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);                                                             // mov rdi, rax
    self.cg_movRaxImm(231);                                                                                            // #1487
    self.cg_e8(0x0F); self.cg_e8(0x05);                                                                                // syscall (exit_group)
    self.cg_zeroRax();
  }

  // WP-BC-39: Print int64 in rdi to stderr as decimal, followed by "\n".
  // Clobbers: rax, rcx, rdx, rsi.  Uses a 32-byte stack buffer.
  fn cg_emitInspectPrintInt() {
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x20);                    // sub rsp, 32
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x1F); // lea rsi, [rsp+31]
    self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x0A);                                      // mov byte [rsi], '\n'
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);                                      // dec rsi
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF8);                                      // mov rax, rdi
    // test rax,rax; jnz .nonzero (+8)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);                                      // test rax, rax
    self.cg_e8(0x75); self.cg_e8(0x08);                                                         // jnz +8
    self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x30);                                      // mov byte [rsi], '0'
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);                                      // dec rsi
    self.cg_e8(0xEB); self.cg_e8(0x30);                                                         // jmp .emit (+48)
    // .nonzero: test rax,rax; jge .positive (+3)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);                                      // test rax, rax
    self.cg_e8(0x7D); self.cg_e8(0x03);                                                         // jge +3
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xD8);                                      // neg rax
    // .digitloop: test rax,rax; jz .sign (+24)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);                                      // test rax, rax
    self.cg_e8(0x74); self.cg_e8(0x18);                                                         // jz +24
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);                                      // xor rdx, rdx
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1);
    self.cg_e8(0x0A); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);                   // mov rcx, 10
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);                                      // idiv rcx
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC2); self.cg_e8(0x30);                   // add rdx, '0'
    self.cg_e8(0x88); self.cg_e8(0x16);                                                         // mov [rsi], dl
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);                                      // dec rsi
    self.cg_e8(0xEB); self.cg_e8(0xE3);                                                         // jmp .digitloop (-29)
    // .sign: test rdi,rdi; jns .emit (+6)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);                                      // test rdi, rdi
    self.cg_e8(0x79); self.cg_e8(0x06);                                                         // jns +6
    self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x2D);                                      // mov byte [rsi], '-'
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);                                      // dec rsi
    // .emit: inc rsi; lea rdx,[rsp+31]; sub rdx,rsi; inc rdx
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC6);                                      // inc rsi
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x1F); // lea rdx, [rsp+31]
    self.cg_e8(0x48); self.cg_e8(0x29); self.cg_e8(0xF2);                                      // sub rdx, rsi
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC2);                                      // inc rdx  (+1 for '\n')
    self.cg_e8(0xBF); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov edi, 2 (stderr)
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 1 (sys_write)
    self.cg_e8(0x0F); self.cg_e8(0x05);                                                         // syscall
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x20);                   // add rsp, 32
  }

  // WP-BC-40: Print int64 in rdi as decimal to stderr, NO newline.
  // Same as cg_emitInspectPrintInt but omits the trailing '\n'.
  fn cg_emitStderrInt() {
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xEC); self.cg_e8(0x20);                    // sub rsp, 32
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x74); self.cg_e8(0x24); self.cg_e8(0x1E); // lea rsi, [rsp+30]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF8);                                      // mov rax, rdi
    // test rax,rax; jnz .nonzero (+8)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);                                      // test rax, rax
    self.cg_e8(0x75); self.cg_e8(0x08);                                                         // jnz +8
    self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x30);                                      // mov byte [rsi], '0'
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);                                      // dec rsi
    self.cg_e8(0xEB); self.cg_e8(0x30);                                                         // jmp .emit (+48)
    // .nonzero: test rax,rax; jge .positive (+3)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);                                      // test rax, rax
    self.cg_e8(0x7D); self.cg_e8(0x03);                                                         // jge +3
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xD8);                                      // neg rax
    // .digitloop: test rax,rax; jz .sign (+24)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);                                      // test rax, rax
    self.cg_e8(0x74); self.cg_e8(0x18);                                                         // jz +24
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);                                      // xor rdx, rdx
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1);
    self.cg_e8(0x0A); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);                   // mov rcx, 10
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);                                      // idiv rcx
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC2); self.cg_e8(0x30);                   // add rdx, '0'
    self.cg_e8(0x88); self.cg_e8(0x16);                                                         // mov [rsi], dl
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);                                      // dec rsi
    self.cg_e8(0xEB); self.cg_e8(0xE3);                                                         // jmp .digitloop (-29)
    // .sign: test rdi,rdi; jns .emit (+6)
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xFF);                                      // test rdi, rdi
    self.cg_e8(0x79); self.cg_e8(0x06);                                                         // jns +6
    self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x2D);                                      // mov byte [rsi], '-'
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);                                      // dec rsi
    // .emit: inc rsi; lea rdx,[rsp+30]; sub rdx,rsi; inc rdx (no '\n')
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC6);                                      // inc rsi
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x1E); // lea rdx, [rsp+30]
    self.cg_e8(0x48); self.cg_e8(0x29); self.cg_e8(0xF2);                                      // sub rdx, rsi
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC2);                                      // inc rdx
    self.cg_e8(0xBF); self.cg_e8(0x02); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov edi, 2 (stderr)
    self.cg_e8(0xB8); self.cg_e8(0x01); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, 1 (sys_write)
    self.cg_e8(0x0F); self.cg_e8(0x05);                                                         // syscall
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x20);                   // add rsp, 32
  }

  // WP-BC-40: Look up or allocate a profiling entry for the given name.
  // Returns the data section offset of {tsc_start(8), call_count(8), total_cycles(8)}.
  // Also stores the name string in the data section (nameDataOff) for profile_report.
  fn cg_findOrAllocProfEntry(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.profEntryCount) {
      var eBase: int64 := self.profEntries + i * CG_PROF_SZ;
      var eName: pchar := peek64(eBase) as pchar;
      var eLen: int64 := peek64(eBase + CG_PR_OFF_NAMELEN);
      if (eLen == nlen) {
        var j: int64 := 0; var isMatch: int64 := 1;
        while (j < nlen) {
          if (StrCharAt(eName, j) != StrCharAt(name, j)) { isMatch := 0; }
          j += 1;
        }
        if (isMatch == 1) { return peek64(eBase + CG_PR_OFF_DOFF); }
      }
      i += 1;
    }
    if (self.profEntryCount >= self.profEntryCap) {
      var nc: int64 := self.profEntryCap * 2;
      var nb: int64 := alloc(nc * 32);
      var j: int64 := 0;
      memcpy(nb, self.profEntries, self.profEntryCount * CG_PROF_SZ);
      free(self.profEntries, self.profEntryCap * CG_PROF_SZ);
      self.profEntries := nb;
      self.profEntryCap := nc;
    }
    // Allocate runtime slots: tsc_start(8) + call_count(8) + total_cycles(8) + depth(8) = 32 bytes (#2249)
    var dOff: int64 := self.dataLen;
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);  // tsc_start
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);  // call_count
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);  // total_cycles
    // #2249: Aufruftiefe — nur der aeusserste Aufruf misst (Rekursion).
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);
    self.cg_edata(0); self.cg_edata(0); self.cg_edata(0); self.cg_edata(0);  // depth (+24)
    // Store name string in data section for profile_report output
    var nDOff: int64 := self.dataLen;
    var k: int64 := 0;
    while (k < nlen) { self.cg_edata(StrCharAt(name, k)); k := k + 1; }
    var eBase: int64 := self.profEntries + self.profEntryCount * CG_PROF_SZ;
    poke64(eBase,      name as int64);
    poke64(eBase + CG_PR_OFF_NAMELEN,  nlen);
    poke64(eBase + CG_PR_OFF_DOFF, dOff);
    poke64(eBase + CG_PR_OFF_NDOFF, nDOff);
    self.profEntryCount += 1;
    return dOff;
  }

  // WP-11: Parse float literal string src[off..off+len) to IEEE 754 double bits.
  // Handles: N, N.M, N[eE][+-]P format.
  // #1158: Umrechnungsfaktor eines Einheitentyps als BRUCH.
  //
  // cg_parseFloat liefert IEEE-Bits; die Umrechnung rechnet aber ganzzahlig,
  // und ein Faktor wie `0.017453` (Grad in Radiant) laesst sich als int64 gar
  // nicht ausdruecken. Hier entsteht deshalb Zaehler und Nenner: `1000.0`
  // wird 1000/1, `0.017453` wird 17453/1000000.
  //
  // Rueckgabe ist der Zaehler, der Nenner landet in denBox. Ein Ausdruck, den
  // diese Funktion nicht vollstaendig liest, ergibt 0 — der Aufrufer meldet
  // das, statt stillschweigend mit 1 weiterzurechnen (bis 1.0.15B fiel jeder
  // Float-Faktor genau so auf 1 zurueck und blieb damit wirkungslos).
  fn cg_parseFactorRatio(src: pchar, off: int64, len: int64, denBox: int64): int64 {
    poke64(denBox, 1);
    var i:   int64 := off;
    var end: int64 := off + len;
    if (i < end && StrCharAt(src, i) == 45) { return 0; }   // negative Faktoren: sinnlos
    var num: int64 := 0;
    var den: int64 := 1;
    var seen: int64 := 0;
    while (i < end) {
      var ic: int64 := StrCharAt(src, i);
      if (ic == 95) { i += 1; }
      else if (ic >= 48 && ic <= 57) {
        if (num > 900000000000000) { return 0; }   // zu gross: lieber melden
        num := num * 10 + ic - 48;
        seen := 1;
        i += 1;
      } else { break; }
    }
    if (i < end && StrCharAt(src, i) == 46) {
      i += 1;
      while (i < end) {
        var fc: int64 := StrCharAt(src, i);
        if (fc == 95) { i += 1; }
        else if (fc >= 48 && fc <= 57) {
          if (num > 900000000000000 || den > 100000000000000) { return 0; }
          num := num * 10 + fc - 48;
          den := den * 10;
          seen := 1;
          i += 1;
        } else { break; }
      }
    }
    // Zehnerexponent: `1e3` und `1.5e-3` sind gueltige Zahlliterale (§1).
    if (i < end && (StrCharAt(src, i) == 101 || StrCharAt(src, i) == 69)) {
      i += 1;
      var eNeg: int64 := 0;
      if (i < end && StrCharAt(src, i) == 45) { eNeg := 1; i += 1; }
      else if (i < end && StrCharAt(src, i) == 43) { i += 1; }
      var eVal: int64 := 0;
      var eSeen: int64 := 0;
      while (i < end) {
        var xc: int64 := StrCharAt(src, i);
        if (xc == 95) { i += 1; }
        else if (xc >= 48 && xc <= 57) { eVal := eVal * 10 + xc - 48; eSeen := 1; i += 1; }
        else { break; }
      }
      if (eSeen == 0) { return 0; }
      var ej: int64 := 0;
      while (ej < eVal) {
        if (eNeg == 0) {
          if (num > 900000000000000) { return 0; }
          num := num * 10;
        } else {
          if (den > 100000000000000) { return 0; }
          den := den * 10;
        }
        ej += 1;
      }
    }
    // Der Ausdruck muss VOLLSTAENDIG gelesen sein — ein Rest bedeutet, dass
    // hier etwas steht, das diese Funktion nicht versteht.
    if (i != end) { return 0; }
    if (seen == 0 || num <= 0) { return 0; }
    poke64(denBox, den);
    return num;
  }

  // Groesster gemeinsamer Teiler — kuerzt den Umrechnungsbruch, damit die
  // Zwischenprodukte klein bleiben (#1158).
  fn cg_gcd(a: int64, b: int64): int64 {
    var x: int64 := a;
    var y: int64 := b;
    if (x < 0) { x := 0 - x; }
    if (y < 0) { y := 0 - y; }
    while (y != 0) {
      var t: int64 := x % y;
      x := y;
      y := t;
    }
    if (x == 0) { return 1; }
    return x;
  }

  fn cg_parseFloat(src: pchar, off: int64, len: int64): int64 {
    var i: int64 := off;
    var end: int64 := off + len;
    var neg: int64 := 0;
    if (i < end && StrCharAt(src, i) == 45) { neg := 1; i := i + 1; }
    var num: int64 := 0;
    var den: int64 := 1;
    var intExtra: int64 := 0;
    // Digit separators ('_') are accepted by the lexer in the whole literal
    // (ebnf.md §1), so every digit loop here has to skip them — a loop that
    // merely stops at '_' silently truncates the value (3.14_159 → 3.14).
    while (i < end) {
      var ic: int64 := StrCharAt(src, i);
      if (ic == 95) { i += 1; }
      else if (ic >= 48 && ic <= 57) {
        if (num < 900000000000000) { num := num * 10 + ic - 48; }
        else { intExtra := intExtra + 1; }
        i += 1;
      } else { break; }
    }
    if (i < end && StrCharAt(src, i) == 46) {
      i += 1;
      if (intExtra == 0) {
      // #1461: Die Grenze stand bei den 8 Nachkommastellen, die `den < 100000000`
      // zulaesst — danach wurden die Ziffern GELESEN UND WEGGEWORFEN.
      // `3.14159265358979` kam als 3.14159265 an, also um rund 8 Millionen ULP
      // daneben. Ein double traegt knapp 17 signifikante Dezimalstellen; die
      // Grenze liegt jetzt dort, wo int64 wirklich endet.
        while (i < end && den < 100000000000000000 && num < 900000000000000000) {
          var fc: int64 := StrCharAt(src, i);
          if (fc == 95) { i += 1; }
          else if (fc >= 48 && fc <= 57) {
            num := num * 10 + fc - 48;
            den := den * 10;
            i += 1;
          } else { break; }
        }
      }
      while (i < end) {
        var sc: int64 := StrCharAt(src, i);
        if (sc == 95 || (sc >= 48 && sc <= 57)) { i := i + 1; } else { break; }
      }
    }
    var expNeg: int64 := 0;
    var expVal: int64 := 0;
    if (i < end && (StrCharAt(src, i) == 101 || StrCharAt(src, i) == 69)) {
      i += 1;
      if (i < end && StrCharAt(src, i) == 45) { expNeg := 1; i := i + 1; }
      else if (i < end && StrCharAt(src, i) == 43) { i := i + 1; }
      while (i < end) {
        var xc: int64 := StrCharAt(src, i);
        if (xc == 95) { i += 1; }
        else if (xc >= 48 && xc <= 57) {
          expVal := expVal * 10 + xc - 48;
          i += 1;
        } else { break; }
      }
    }
    if (num == 0) { return 0; }
    // Fold dropped integer digits into the exponent (intExtra excess digits = *10^intExtra).
    if (intExtra > 0) {
      if (expNeg == 0) {
        expVal += intExtra;
      } else {
        if (expVal > intExtra) { expVal := expVal - intExtra; }
        else { expNeg := 0; expVal := intExtra - expVal; }
      }
    }
    var ej: int64 := 0;
    if (expNeg == 0) {
      while (ej < expVal && num < 100000000000000) { num := num * 10; ej := ej + 1; }
    } else {
      while (ej < expVal && den < 100000000000000) { den := den * 10; ej := ej + 1; }
    }
    // R7: apply remaining exponent factors.
    // Positive exp: multiply n by 10; halve n (not d) to prevent overflow and
    // track halvings in binExp so the value n/d * 2^binExp is preserved.
    // Negative exp: multiply d by 10; halve both n and d to prevent d overflow.
    var n: int64 := num;
    var d: int64 := den;
    // #1478: gemeinsame Zehnerfaktoren vorweg kuerzen. `1.0e-27` kommt als
    // 10/10 herein — gekuerzt 1/1 bleibt dem Nenner der ganze Spielraum fuer
    // die Skalierung. Ohne das ist er schon belegt, bevor die Rechnung anfaengt.
    while ((n % 10) == 0 && (d % 10) == 0 && d > 1) { n := n / 10; d := d / 10; }
    var binExp: int64 := 0;
    if (expNeg == 0) {
      // #1657: Hier wurde `n` per Ganzzahldivision halbiert — und dabei jedes
      // Mal ABGESCHNITTEN. Bei einem grossen Exponenten summieren sich die
      // Abschnitte, und zwar einseitig: das Ergebnis lag systematisch zu
      // niedrig (1.0e300 um 2 ULP, 1.0e308 um 1 ULP, beide nach unten).
      // Zwei Aenderungen:
      //   * Beim Halbieren wird zur naechsten Zahl gerundet statt abgeschnitten
      //     — damit ist der Fehler nicht mehr einseitig.
      //   * Multipliziert wird mit 5 statt mit 10; der Faktor 2 wandert in den
      //     Binaerexponenten. Der Zaehler waechst dadurch langsamer, es muss
      //     seltener halbiert werden, und jede vermiedene Halbierung ist ein
      //     nicht verlorenes Bit. Denselben Kniff nutzt der Zweig fuer
      //     negative Exponenten unten schon (#1569).
      while (ej < expVal) {
        while (n > 1844674407370955161) {   // n*5 bleibt in int64
          // Zur GERADEN Zahl runden, nicht auf. Ein blosses Aufrunden
          // ((n+1)/2) verschiebt den Fehler nur auf die andere Seite: damit
          // lief 1.7976931348623157e308 (der groesste darstellbare double)
          // ueber und kam als +Inf heraus. Bei genau der Haelfte entscheidet
          // die Paritaet, sodass sich die Fehler ueber die vielen
          // Halbierungen gegenseitig aufheben statt sich zu summieren.
          var q: int64 := n / 2;
          if ((n % 2) != 0 && (q % 2) != 0) { q := q + 1; }
          n := q;
          binExp += 1;
        }
        n := n * 5;
        binExp += 1;                        // der Faktor 2 aus 10 = 5 * 2
        ej += 1;
      }
    } else {
      // #1478 hatte hier den Nenner statt um 10 nur um 5 wachsen lassen und
      // den Faktor 2 in den Binaerexponenten geschoben — das trug bis 1e-27.
      // #1569: Der Nenner traegt nur bis etwa 1e-27. Danach lief die alte
      // Fassung in ihren Notzweig, halbierte den ohnehin winzigen Zaehler und
      // gab bei n == 0 eine glatte Null zurueck — jedes Literal ab 1e-28 wurde
      // still zu 0, obwohl f64 bis 5e-324 traegt.
      //
      // Der Bruch wird hier gar nicht mehr gebraucht: 10 ist 5 mal 2, der
      // Faktor 2 wandert in den Binaerexponenten, und durch 5 kann man TEILEN,
      // statt den Nenner wachsen zu lassen. Damit die Division nichts
      // wegwirft, wird der Zaehler vorher so weit nach oben geschoben, wie
      // int64 es zulaesst — rund 60 Bit Genauigkeit, deutlich mehr als die 53
      // eines double.
      while (ej < expVal) {
        while (n <= 4611686018427387903) {   // n*2 bleibt in int64
          n := n * 2;
          binExp := binExp - 1;
        }
        // #1657: Auch hier wurde abgeschnitten, und auch hier einseitig nach
        // unten — 1.0e-300 kam um ein ULP zu klein an. Ein Rest von mehr als
        // 5/2 gehoert aufgerundet; genau die Haelfte kann bei einem ungeraden
        // Teiler nicht auftreten, ein Sonderfall entfaellt also.
        var rest: int64 := n % 5;
        n := n / 5;
        if (rest * 2 > 5) { n := n + 1; }
        binExp := binExp - 1;      // der Faktor 2 aus 10 = 5 * 2
        if (n == 0) { return 0; }  // wirklich unter dem Wertebereich
        ej += 1;
      }
    }
    // Normalize: find binary exponent so n/d ∈ [1, 2)
    while (n < d && n > 0) {
      if (n > 4611686018427387903) { d := d / 2; if (d == 0) { d := 1; } }
      else { n := n * 2; }
      binExp -= 1;
      // #1662: Die Schranke stand bei -1074 und gab dort glatt 0 zurueck. Der
      // kleinste subnormale double IST 2^-1074 — abgeschnitten wurde also
      // schon der darstellbare Rand. Ein Stueck Luft darunter, damit die
      // Rundung weiter unten entscheiden kann; wirklich zu klein wird erst
      // dort abgefangen.
      if (binExp < -1090) { return 0; }
    }
    while (d < 4611686018427387903 && n >= d * 2) {
      d := d * 2; binExp := binExp + 1;
      if (binExp > 1023) {
        var pInf: int64 := 2047; pInf := pInf << 52;
        if (neg != 0) {
          var smI: int64 := 1; var sI: int64 := 0;
          while (sI < 63) { smI := smI * 2; sI := sI + 1; }
          return pInf | smI;
        }
        return pInf;
      }
    }
    n -= d;
    var mant: int64 := 0;
    var bit: int64 := 51;
    while (bit >= 0) {
      // #1461: Die Schranke stand bei 4e15 und halbierte damit Zaehler UND
      // Nenner schon, wenn beide noch bequem in int64 passen — bei jedem
      // Halbieren geht ein Bit verloren. Ueberlaufen kann `n * 2` erst ab
      // 2^62; dort liegt die Schranke jetzt. `1.4142135623730951` kam vorher
      // um ein ULP zu niedrig an.
      if (n > 4611686018427387903) { n := n / 2; d := d / 2; if (d == 0) { d := 1; } }
      n := n * 2;
      if (n >= d) { mant := mant | (1 << bit); n := n - d; }
      bit -= 1;
    }

    // #1461: Hier war Schluss — die 52 Bits wurden abgeschnitten, nie
    // gerundet. Das Ergebnis lag damit systematisch UNTER dem naechstgelegenen
    // double: `1.995` kam als 1.99499999999999999556 an statt als
    // 1.99500000000000010658, und `FloatToStr(1.995, 2)` gab folgerichtig 1.99
    // aus, wo printf und Python 2.00 sagen. Der Formatierer rundete richtig —
    // er bekam nur eine andere Zahl, als im Quelltext stand.
    //
    // Der verbliebene Rest n/d entscheidet: ist er mindestens eine halbe
    // Einheit der letzten Stelle, wird aufgerundet. Traegt die Mantisse dabei
    // ueber, wandert der Uebertrag in den Exponenten.
    //
    // Gerundet wird zur naechsten Zahl, bei genau der Haelfte nach oben. Die
    // Norm sagt hier "zur geraden Zahl"; der Unterschied betrifft nur exakt
    // darstellbare Haelften, und die entstehen aus einem Dezimalliteral
    // praktisch nie.
    if (n > 4611686018427387903) { n := n / 2; d := d / 2; if (d == 0) { d := 1; } }
    n := n * 2;
    if (n >= d) {
      mant := mant + 1;
      if (mant > 4503599627370495) { mant := 0; binExp := binExp + 1; }
    }

    var biasedE: int64 := binExp + 1023;
    // #1662: Hier wurde jeder Wert unterhalb des kleinsten NORMALEN double
    // still zu 0 — der gesamte subnormale Bereich, immerhin von
    // 2.2250738585072014e-308 hinunter bis 4.9e-324. Ein Literal wie
    // `1.0e-320` stand im Quelltext und war im Programm eine Null, ohne
    // Meldung.
    //
    // Ein subnormaler Wert hat keine fuehrende Eins: das Exponentenfeld ist 0,
    // und die Mantisse traegt die Stellen nach rechts geschoben. Genau das
    // passiert hier — mit derselben Rundung zur naechsten Zahl, die oben schon
    // gilt, damit die letzte Stelle stimmt.
    if (biasedE <= 0) {
      var schieb: int64 := 1 - biasedE;
      // Mehr als 53 Stellen nach rechts, und es bleibt nichts uebrig; dort ist
      // der Wert wirklich nicht mehr darstellbar.
      if (schieb > 53) { return 0; }
      var voll: int64 := (1 << 52) | mant;        // die fuehrende Eins wird explizit
      var rest: int64 := voll & ((1 << schieb) - 1);
      var sub:  int64 := voll >> schieb;
      var haelfte: int64 := 1 << (schieb - 1);
      if (rest > haelfte) { sub := sub + 1; }
      else if (rest == haelfte && (sub & 1) != 0) { sub := sub + 1; }   // zur geraden Zahl
      if (sub == 0) { 
        // Auf 0 gerundet — der Wert liegt unter der halben kleinsten Stufe.
        if (neg != 0) {
          var smN: int64 := 1; var sN: int64 := 0;
          while (sN < 63) { smN := smN * 2; sN := sN + 1; }
          return smN;          // negative Null
        }
        return 0;
      }
      // Traegt die Rundung ueber 2^52 hinaus, ist daraus der kleinste NORMALE
      // Wert geworden: Exponentenfeld 1, Mantisse 0.
      var subBits: int64 := sub;
      if (sub >= (1 << 52)) { subBits := (1 << 52); }
      if (neg != 0) {
        var smS: int64 := 1; var sS: int64 := 0;
        while (sS < 63) { smS := smS * 2; sS := sS + 1; }
        return subBits | smS;
      }
      return subBits;
    }
    if (biasedE >= 2047) {
      var pInf2: int64 := 2047; pInf2 := pInf2 << 52;
      if (neg != 0) {
        var smJ: int64 := 1; var sJ: int64 := 0;
        while (sJ < 63) { smJ := smJ * 2; sJ := sJ + 1; }
        return pInf2 | smJ;
      }
      return pInf2;
    }
    var bits: int64 := (biasedE << 52) | mant;
    if (neg != 0) {
      var sm: int64 := 1; var sk: int64 := 0;
      while (sk < 63) { sm := sm * 2; sk := sk + 1; }
      bits := bits | sm;
    }
    return bits;
  }

  // call rel32  — placeholder; returns position of rel32 for patching
  fn cg_emitCall(): int64 {
    self.cg_e8(0xE8);
    var pos: int64 := self.codeLen;
    self.cg_e32(0);
    return pos;
  }

  // Emit function prologue: push rbp; mov rbp, rsp; sub rsp, imm32 (placeholder)
  // WP-18: Also reserves rbp-8 for stack canary (loads fs:0x28 there, clears rax).
  // Returns: code position of the imm32 (for later patching with final frame size)
  fn cg_emitPrologue(): int64 {
    self.cg_e8(0x55);                          // push rbp
    self.cg_cfi(CFI_CFA_OFF, 16);              // #2135
    self.cg_cfi(CFI_SICHER, 6 | (2 << 8));     // rbp bei CFA-16
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xE5);  // mov rbp, rsp
    self.cg_cfi(CFI_CFA_RBP, 0);
    // sub rsp, imm32 (48 81 EC xx xx xx xx)
    self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xEC);
    var patchPos: int64 := self.codeLen;
    self.cg_e32(0);
    // WP-18: reserve [rbp-8] for canary before any locals
    //
    // #2245: Der SLOT bleibt in jedem Fall reserviert, auch wenn diese
    // Funktion keinen Canary traegt. Gespart werden die drei Befehle, nicht
    // die acht Bytes: rbx liegt fest bei [rbp-16] (#2081) und r12..r15
    // darunter (#2114), beides an mehreren Stellen fest verdrahtet. Den
    // Rahmen zu verschieben waere eine zweite, viel groessere Aenderung mit
    // demselben Ertrag von acht Byte je Rahmen.
    self.frameSize += 8;
    if (self.canaryAn != 0) {
      // mov rax, [rip+CG_CANARY]  (load canary from global; patched by CG_PATCH_STR)
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05);
      var pCanaryLoad: int64 := self.codeLen;
      self.cg_e32(0);
      self.cg_addPatch(pCanaryLoad, CG_CANARY, 0, CG_PATCH_STR);
      // mov [rbp-8], rax
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x45); self.cg_e8(0xF8);
      // xor rax, rax  (clear canary from register)
      self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    }
    // #2081: rbx sichern. Nach SysV muss der GERUFENE rbx erhalten; der Codegen
    // benutzt es aber als Arbeitsregister (linker Operand jeder Binaeroperation,
    // Zieladresse indirekter Aufrufe). Fuer Lyx→Lyx war das unschaedlich, fuer
    // einen C-Aufrufer nicht: qsort mit einer Lyx-Vergleichsfunktion und
    // OpenSSL-Callbacks stuerzten ab. Der Slot liegt fest unter dem Canary
    // ([rbp-16]); cg_emitEpilogue laedt ihn zurueck — beide muessen
    // uebereinstimmen, auch in cg_emitPrologueNested.
    self.frameSize += 8;
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x5D); self.cg_e8(0xF0);  // mov [rbp-16], rbx
    self.cg_cfi(CFI_SICHER, 3 | (4 << 8));     // #2135: rbx bei rbp-16 = CFA-32
    // #2114: die von cg_rlWaehlen belegten r12..r15 sichern (callee-saved);
    // cg_emitEpilogue laedt sie zurueck. Fuer die Abwicklungstabelle wie rbx
    // (#2135): der Slot liegt bei CFA-(16-off).
    var rli: int64 := 0;
    while (rli < self.rlAnz) {
      self.frameSize += 8;
      var rlSo: int64 := 0 - self.frameSize;
      poke64(self.rlTab + rli * 48 + 24, rlSo);
      self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x65 + (rli << 3)); self.cg_e8(rlSo & 255);   // mov [rbp+off], r12+i
      self.cg_cfi(CFI_SICHER, (12 + rli) | (((16 - rlSo) / 8) << 8));
      rli += 1;
    }
    // #1370: --profile misst jede Funktion. Hier, nach dem Rahmenaufbau, sind
    // die Argumentregister noch unberuehrt, weil sie erst danach in den
    // Rahmen gerettet werden.
    //
    // #2180: Deshalb darf die Messung sie NICHT veraendern. Hier stand "rax/rdx
    // frei" — rdx ist aber das DRITTE Argumentregister, und rdtsc schreibt
    // hinein. Jede Funktion mit drei oder mehr Parametern bekam als dritten
    // die oberen Bits des Zeitstempelzaehlers: drei(1, 2, 3) rechnete mit
    // c = 0x...; der mit --profile gebaute Compiler starb beim Selbstbau mit
    // SIGSEGV. rdx wird jetzt um die Messung herum gerettet.
    if (self.profileAll != 0 && self.profCurLen > 0) {
      var pdo: int64 := self.cg_findOrAllocProfEntry(self.profCurName, self.profCurLen);
      self.cg_e8(0x52);                                        // push rdx
      self.cg_profEnterBytes(pdo);
      self.cg_e8(0x5A);                                        // pop rdx
      self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);   // xor rax, rax
    }
    return patchPos;
  }

  // Emit function epilogue: check stack canary, then mov rsp,rbp; pop rbp; ret
  // WP-18: Uses r10/r11 (scratch) to compare [rbp-8] with _lyx_canary global.
  //        Does NOT touch rax (return value).
  fn cg_emitEpilogue() {
    // #1370: --profile. Der Rueckgabewert steht in rax, und die Messung
    // benutzt rax/rcx/rdx — deshalb wird er ueber den Stapel gerettet. Diese
    // Stelle ist der einzige Trichter: alle sechs Rueckgabewege im Codegen
    // rufen sie, auch die vorzeitigen `return`.
    // #2180: rdx ebenfalls retten — er traegt bei zweiteiligen Rueckgaben die
    // obere Haelfte, und zwei Pushes halten den Stapel fuer den Berichtsaufruf
    // in main 16-Byte-ausgerichtet.
    if (self.profileAll != 0 && self.profCurLen > 0) {
      self.cg_e8(0x50);                                        // push rax
      self.cg_e8(0x52);                                        // push rdx
      var pdoE: int64 := self.cg_findOrAllocProfEntry(self.profCurName, self.profCurLen);
      self.cg_profLeaveBytes(pdoE);
      // In `main` folgt der Bericht — nach der eigenen Messung, damit main
      // selbst mit in der Tabelle steht. Die Helferfunktion liegt hinter
      // allen uebrigen Funktionen; ihre Adresse traegt der Patch nach.
      if (self.cg_seq(self.profCurName, self.profCurLen, "main"c, 4)) {
        self.cg_e8(0xE8);
        var ppRep: int64 := self.codeLen; self.cg_e32(0);
        self.cg_addPatch(ppRep, "__lyx_profile_report" as int64, 20, CG_PATCH_CALL);
      }
      self.cg_e8(0x5A);                                        // pop rdx
      self.cg_e8(0x58);                                        // pop rax
    }
    // #1140: @flight_crit — alten MXCSR und Namenszeiger zurueck, BEVOR der
    // Rahmen faellt (beide liegen darin). Jede Rueckkehr kommt hier vorbei,
    // deshalb genuegt diese eine Stelle.
    if (self.fcActive != 0) { self.cg_fcDisarm(); }
    // WP-18: canary check — r10/r11 are caller-saved scratch, do not affect rax
    //
    // #2245: nur wenn diese Funktion ueberhaupt einen traegt. canaryAn setzt
    // die Aufrufstelle VOR dem Prolog (cg_funcBrauchtCanary); Prolog und
    // Epilog muessen dieselbe Antwort benutzen, sonst prueft der Epilog
    // einen Slot, den der Prolog nie beschrieben hat — und das waere ein
    // Abbruch bei JEDER Rueckkehr.
    if (self.canaryAn != 0) {
    // mov r11, [rbp-8]
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x5D); self.cg_e8(0xF8);
    // mov r10, [rip+CG_CANARY]  (expected canary from global)
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x15);
    var pCanaryChk: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pCanaryChk, CG_CANARY, 0, CG_PATCH_STR);
    // #2244: cmp statt xor — dieselbe Null-Flagge, aber cmp+jne verschmilzt zu
    // EINEM Makro-Op (xor+jcc nicht), und das Paar wird wie jedes andere
    // ausgerichtet (cg_paarAusrichten). Bis 1.2.20D lag der Sprung in 2308
    // von rund 3400 Epilogen des Selbstbaus ueber oder an einer
    // 32-Byte-Grenze — und dieser Epilog laeuft bei JEDER Rueckkehr.
    self.cg_paarAusrichten(self.codeLen, 9);
    // cmp r11, r10
    self.cg_e8(0x4D); self.cg_e8(0x39); self.cg_e8(0xD3);
    // jnz __lyx_stack_fail (0F 85 rel32)
    self.cg_e8(0x0F); self.cg_e8(0x85);
    var failPatch: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(failPatch, "__lyx_stack_fail" as int64, 16, CG_PATCH_CALL);
    }
    // #2081: rbx des Aufrufers zurueck (gesichert im Prolog bei [rbp-16])
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x5D); self.cg_e8(0xF0);  // mov rbx, [rbp-16]
    // #2114: r12..r15 des Aufrufers zurueck (cg_emitPrologue)
    var rle: int64 := 0;
    while (rle < self.rlAnz) {
      var rlSe: int64 := peek64(self.rlTab + rle * 48 + 24);
      self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x65 + (rle << 3)); self.cg_e8(rlSe & 255);   // mov r12+i, [rbp+off]
      rle += 1;
    }
    // Normal epilogue
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xEC);  // mov rsp, rbp
    self.cg_e8(0x5D);  // pop rbp
    self.cg_cfi(CFI_CFA_RSP8, 0);   // #2135: Rahmen gefallen, CFA = rsp+8
    self.cg_e8(0xC3);  // ret
    self.cg_cfi(CFI_RAHMEN, 0);     // dahinter (spaeteres return, Landepunkt) wieder im Rahmen
  }

  // push rax
  fn cg_pushRax() {
    self.cg_e8(0x50);
    self.pushRaxEnde := self.codeLen;   // #2228: fuer die Pop-Stelle in cg_genCall
  }
  // pop rax
  fn cg_popRax() { self.cg_e8(0x58); }
  // pop rbx
  fn cg_popRbx() { self.cg_e8(0x5B); }
  // pop rdi
  // _indirect_call_N(fnPtr, a1..aN): rohen Code-Pointer mit N Argumenten rufen.
  // argNode ist der fnPtr-Knoten, die Argumente hängen an dessen next-Kette.
  fn cg_genIndirectCallN(argNode: int64, n: int64) {
    // Argumente einsammeln
    var buf: int64 := alloc(n * 8);
    var cur: int64 := self.cg_nnext(argNode);
    var i: int64 := 0;
    while (i < n && cur != -1) {
      poke64(buf + i * 8, cur);
      cur := self.cg_nnext(cur);
      i += 1;
    }
    // in umgekehrter Reihenfolge pushen: aN zuerst, a1 zuletzt → a1 liegt oben
    var j: int64 := n - 1;
    while (j >= 0) {
      self.cg_genExpr(peek64(buf + j * 8));
      self.cg_pushRax();
      j -= 1;
    }
    self.cg_genExpr(argNode);          // rax = fnPtr (nach den Argumenten, damit
                                        // deren Auswertung rax nicht überschreibt)
    if (n >= 1) { self.cg_popRdi(); }
    if (n >= 2) { self.cg_popRsi(); }
    if (n >= 3) { self.cg_popRdx(); }
    if (n >= 4) { self.cg_popRcx(); }
    self.cg_e8(0xFF); self.cg_e8(0xD0);  // call rax
    free(buf, n * 8);
  }

  fn cg_popRdi() { self.cg_e8(0x5F); }
  // pop rsi
  fn cg_popRsi() { self.cg_e8(0x5E); }
  // pop rdx
  fn cg_popRdx() { self.cg_e8(0x5A); }
  // pop rcx
  fn cg_popRcx() { self.cg_e8(0x59); }

  // xor rax, rax  (zero rax)
  fn cg_zeroRax() {
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
  }

  // neg rax
  fn cg_negRax() {
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xD8);
  }

  // not rax  (bitwise NOT)
  fn cg_notRax() {
    self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xD0);
  }

  // test rax, rax; setnz al; movzx rax, al  (convert any non-zero to 1)
  fn cg_boolRax() {
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
    self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC0);   // setnz al
    self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);  // movzx rax, al
  }

  fn cg_registerF64Func(name: pchar, nameLen: int64) {
    if (self.f64FuncCount >= self.f64FuncCap) {
      var nc: int64 := self.f64FuncCap * 2;
      var nb: int64 := alloc(nc * 16);
      memcpy(nb, self.f64FuncList, self.f64FuncCount * 16);
      self.f64FuncList := nb;
      self.f64FuncCap  := nc;
    }
    var base: int64 := self.f64FuncList + self.f64FuncCount * 16;
    poke64(base,     name as int64);
    poke64(base + 8, nameLen);
    self.f64FuncCount += 1;
  }

  fn cg_isF64Func(name: pchar, nameLen: int64): int64 {
    // #1502: die EINGEBAUTEN Gleitkommaquellen. Die Liste darunter fuehrt nur
    // Benutzerfunktionen mit deklariertem f64-Rueckgabetyp; `peekf64` und
    // Verwandte stehen nirgends. Ohne sie galt `var v: f64 := peekf64(t);` als
    // Ganzzahlzuweisung — und die Umrechnung, die #1502 dort einfuehrt, machte
    // aus dem Bitmuster eine Zahl (std.pack lieferte 4.6e18 statt 3.5).
    if (self.cg_seq(name, nameLen, "peekf64"c, 7)) { return 1; }
    if (self.cg_seq(name, nameLen, "peekf32"c, 7)) { return 1; }
    // #2160: der Builtin heisst peek32f (sema._regBuiltin) — "peekf32" oben
    // gibt es nicht. `var v: f64 := peek32f(t)` wandelte das Ergebnis deshalb
    // ein zweites Mal (12.1 -> 4.6e18).
    if (self.cg_seq(name, nameLen, "peek32f"c, 7)) { return 1; }
    var i: int64 := 0;
    while (i < self.f64FuncCount) {
      var base: int64 := self.f64FuncList + i * 16;
      var n: pchar  := peek64(base) as pchar;
      var l: int64  := peek64(base + 8);
      if (self.cg_seq(n, l, name, nameLen) != 0) { return 1; }
      i += 1;
    }
    return 0;
  }

  // #1381: Rueckgabetyp eines AUFRUFS — gleich, ob freie Funktion oder Methode.
  // Methoden stehen in der Registry unter dem gemangelten Namen
  // `Klasse_Methode`; wer nur den Methodennamen nachschlaegt, findet nichts und
  // haelt das Ergebnis fuer eine Ganzzahl. Genau daran gab
  // `PrintLn(sb.ToString())` die Adresse aus statt der Zeichenkette.
  // Rueckgabe: 1 = ja, 0 = nein (Typ bekannt), -1 = unbekannt.
  // #1595: Struct-Rueckgabegroesse eines AUFRUFS — freie Funktion oder
  // Methode. Fuer Methoden dieselbe Kette wie in cg_callRetTypeIs: die
  // Registry fuehrt sie unter der Klasse, die sie DEKLARIERT (#1621).
  // #1595: Ruft die Stelle ueber einen FUNKTIONSZEIGER, steht unter dem Namen
  // keine Funktion, sondern eine Variable. Ihr Typ ist ein Zeigertyp-Alias,
  // und der nennt den Rueckgabetyp — nur fragt hier bisher niemand danach.
  // `ResultInt64AndThen` stuerzte deshalb ab: der Gerufene erwartete das
  // verdeckte erste Argument, die indirekte Aufrufstelle gab keines mit.
  // #1595: Verdecktes erstes Argument fuer einen INDIREKTEN Aufruf. Der
  // Gerufene ist eine ganz normale Funktion mit Struct-Rueckgabe und erwartet
  // die Zieladresse in rdi — ob er direkt oder ueber einen Zeiger gerufen
  // wird, sieht er nicht. Fehlt sie, schreibt er in einen Zeiger, den ihm
  // niemand gegeben hat: `ResultInt64AndThen` stuerzte genau so ab.
  //
  // Die Adresse wird VOR den Argumenten geschoben, damit sie beim
  // spiegelbildlichen Auspacken zuletzt nach rdi geht.
  fn cg_indirektSretVorschub(bytes: int64): int64 {
    if (bytes <= 0) { return 0; }
    var off: int64 := self.cg_reserveFrame((bytes + 7) / 8 * 8);
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x85); self.cg_e32(off);  // lea rax,[rbp+off]
    self.cg_pushRax();
    return 1;
  }

  // #1595: dasselbe fuer eine GLOBALE Variable vom Funktionstyp.
  fn cg_globalRetStructBytes(fp: pchar, fl: int64): int64 {
    var gi: int64 := self.cg_findGlobalIdx(fp, fl);
    if (gi < 0) { return 0; }
    var tb: int64 := self.globalTypeNames + gi * 16;
    var tp: pchar := peek64(tb) as pchar;
    var tl: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
    if (tp == 0 as pchar || tl <= 0) { return 0; }
    return self.cg_fnAliasRetStructBytes(tp, tl);
  }

  // #2084: Argumente eines INDIREKTEN Aufrufs (ueber einen Funktionszeiger,
  // eine Closure, ein Feld). Bis 1.2.13C kannten diese Wege nur Register-
  // argumente: zwei meldeten ab dem siebten Argument faelschlich "Struct-
  // Rueckgabe", vier verloren die ueberzaehligen Argumente STILL und liessen
  // sie auf dem Stapel liegen. Jetzt dieselbe Anordnung wie beim direkten
  // Aufruf (cg_genCall, "7+ param path") — die beiden muessen uebereinstimmen:
  //   1. Stapelargumente, das letzte zuerst (SysV: das 7. liegt bei [rsp]),
  //   2. ggf. verdeckte Werte des Aufrufers (Rueckgabezeiger),
  //   3. Registerargumente in Reihenfolge — sie werden rueckwaerts gepoppt.
  // `regPlaetze` = Register fuer explizite Argumente (6 minus verdeckte wie
  // Rueckgabezeiger, Umgebung oder self). Nach dem `call` raeumt
  // cg_popStackArgs(explizit + verdeckt) den Stapel.
  fn cg_indirektStapelArgs(argNode: int64, regPlaetze: int64): int64 {
    var n: int64 := 0;
    var cur: int64 := argNode;
    while (cur >= 0) { n := n + 1; cur := self.cg_nnext(cur); }
    if (n <= regPlaetze) { return n; }
    var buf: int64 := alloc(n * 8);
    var i: int64 := 0;
    cur := argNode;
    while (cur >= 0) { poke64(buf + i * 8, cur); i := i + 1; cur := self.cg_nnext(cur); }
    var j: int64 := n - 1;
    while (j >= regPlaetze) {
      self.cg_genExpr(peek64(buf + j * 8));
      self.cg_pushRax();
      j := j - 1;
    }
    free(buf, n * 8);
    return n;
  }

  // Teil 3: die Registerargumente (die ersten regPlaetze) in Reihenfolge pushen.
  // Liefert, wie viele es waren.
  fn cg_indirektRegArgs(argNode: int64, regPlaetze: int64): int64 {
    var k: int64 := 0;
    var cur: int64 := argNode;
    while (cur >= 0 && k < regPlaetze) {
      self.cg_genExpr(cur);
      self.cg_pushRax();
      k := k + 1;
      cur := self.cg_nnext(cur);
    }
    return k;
  }

  fn cg_indirektRetStructBytes(fp: pchar, fl: int64): int64 {
    var li: int64 := self.cg_findLocalIdx(fp, fl);
    if (li >= 0) {
      var tb: int64 := self.localTypes + li * CG_LOCTYPE_SZ;
      var tp: pchar := peek64(tb) as pchar;
      var tl: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
      if (tp != 0 as pchar && tl > 0) {
        return self.cg_fnAliasRetStructBytes(tp, tl);
      }
    }
    return 0;
  }

  fn cg_callRetStructBytes(ni: int64): int64 {
    var fpLc: int64 := alloc(8);   // #2044: Marke der inneren Funktion, sonst der Name
    var fp: pchar := self.cg_callName(ni, fpLc);
    var fl: int64 := peek64(fpLc);
    free(fpLc, 8);
    // #1712: iVal unterscheidet die Aufrufarten — 0 gewoehnlich, 1 Methode,
    // 2 generisch, 3 super. Geprueft wurde nur auf 0, jede andere Art galt
    // also als Methode und ihr c0 als Empfaenger. Bei einem generischen
    // Aufruf ist c0 aber die ARGUMENTLISTE: stand dort ein weiterer Aufruf,
    // ging die Empfaengersuche darauf los.
    if (self.cg_nival(ni) == 0 || self.cg_nival(ni) == 2) {
      var direkt: int64 := self.cg_fnRetStructBytes(fp, fl);
      if (direkt > 0) { return direkt; }
      return self.cg_indirektRetStructBytes(fp, fl);
    }
    var clsIdx: int64 := self.cg_exprClassName(self.cg_nc0(ni));
    if (clsIdx < 0) { return 0; }
    var lcell: int64 := alloc(8);
    var erg: int64 := 0;
    var cur: int64 := clsIdx;
    var tiefe: int64 := 0;
    while (cur >= 0 && tiefe < 32) {
      var cbase: int64 := self.classLayouts + cur * CG_CLASS_SZ;
      var cnp: pchar := peek64(cbase) as pchar;
      var cnl: int64 := peek64(cbase + CG_PATCH_OFF_NAMEPTR);
      if (cnp != 0 as pchar && cnl > 0) {
        var mbuf: int64 := self.cg_mangleInto(cnp, cnl, fp, fl, lcell);
        var mlen: int64 := peek64(lcell);
        var rr: int64 := self.cg_fnRetStructBytes(mbuf as pchar, mlen);
        self.cg_trackTempBuf(mbuf, mlen + 1);
        if (rr > 0) { erg := rr; cur := 0 - 1; tiefe := 99; }
      }
      if (tiefe < 99) {
        cur := peek64(self.classLayouts + cur * CG_CLASS_SZ + CG_CLASS_OFF_PARENTIDX);
        tiefe := tiefe + 1;
      }
    }
    free(lcell, 8);
    return erg;
  }

  fn cg_callRetTypeIs(ni: int64, tname: pchar, tlen: int64): int64 {
    var fpLc: int64 := alloc(8);   // #2044: Marke der inneren Funktion, sonst der Name
    var fp: pchar := self.cg_callName(ni, fpLc);
    var fl: int64 := peek64(fpLc);
    free(fpLc, 8);
    // #1712: dieselbe Unterscheidung wie in cg_callRetStructBytes — ein
    // generischer Aufruf wird ueber seinen Funktionsnamen aufgeloest.
    if (self.cg_nival(ni) == 0 || self.cg_nival(ni) == 2) {
      return self.cg_funcRetTypeIs(fp, fl, tname, tlen);
    }
    var clsIdx: int64 := self.cg_exprClassName(self.cg_nc0(ni));
    if (clsIdx < 0) { return 0 - 1; }
    // #1621: Die Registry fuehrt die Methode unter dem Namen der Klasse, die
    // sie DEKLARIERT. Erbt eine Ableitung sie, ohne sie zu ueberschreiben,
    // stand unter ihrem eigenen Namen nichts — und der Rueckgabetyp galt als
    // unbekannt, also int64. PrintLn gab bei pchar die Adresse aus. Deshalb
    // die Kette hoch, bis eine Klasse die Methode kennt.
    var lcell: int64 := alloc(8);
    var r: int64 := 0 - 1;
    var cur: int64 := clsIdx;
    var tiefe: int64 := 0;
    while (cur >= 0 && tiefe < 32) {
      var cbase: int64 := self.classLayouts + cur * CG_CLASS_SZ;
      var cnp: pchar := peek64(cbase) as pchar;
      var cnl: int64 := peek64(cbase + CG_PATCH_OFF_NAMEPTR);
      if (cnp != 0 as pchar && cnl > 0) {
        var mbuf: int64 := self.cg_mangleInto(cnp, cnl, fp, fl, lcell);
        var mlen: int64 := peek64(lcell);
        var rr: int64 := self.cg_funcRetTypeIs(mbuf as pchar, mlen, tname, tlen);
        self.cg_trackTempBuf(mbuf, mlen + 1);
        if (rr >= 0) { r := rr; cur := 0 - 1; }
      }
      if (cur >= 0) {
        cur := peek64(self.classLayouts + cur * CG_CLASS_SZ + CG_CLASS_OFF_PARENTIDX);
        tiefe := tiefe + 1;
      }
    }
    free(lcell, 8);
    return r;
  }

  // Operator overloading (Stage 2c): record a function's declared return type.
  fn cg_registerFuncRet(name: pchar, nameLen: int64, retName: pchar, retLen: int64) {
    if (self.fnRetCount >= self.fnRetCap) {
      var nc: int64 := self.fnRetCap * 2;
      var nb: int64 := alloc(nc * 32);
      memcpy(nb, self.fnRetList, self.fnRetCount * 32);
      self.fnRetList := nb;
      self.fnRetCap  := nc;
    }
    var base: int64 := self.fnRetList + self.fnRetCount * 32;
    poke64(base,      name as int64);
    poke64(base + 8,  nameLen);
    poke64(base + 16, retName as int64);
    poke64(base + 24, retLen);
    self.frHx := self.cg_hxEin(self.frHx, self.fnRetList, 32, 8, self.fnRetCount);   // #2175
    self.fnRetCount += 1;
  }

  // #2175: erster Registry-Eintrag einer Funktion oder -1.
  fn cg_funcRetIdx(name: pchar, nameLen: int64): int64 {
    return self.cg_hxSuch(self.frHx, self.fnRetList, 32, 8, name, nameLen);
  }

  // #1122: die beiden Elementtypen eines Tupel-Rueckgabetyps vermerken.
  fn cg_registerTupleRet(name: pchar, nameLen: int64,
                         t0: pchar, t0Len: int64, t1: pchar, t1Len: int64) {
    if (self.fnTupRetCount >= self.fnTupRetCap) {
      var nc: int64 := self.fnTupRetCap * 2;
      var nb: int64 := alloc(nc * 48);
      memcpy(nb, self.fnTupRetList, self.fnTupRetCount * 48);
      self.fnTupRetList := nb;
      self.fnTupRetCap  := nc;
    }
    var base: int64 := self.fnTupRetList + self.fnTupRetCount * 48;
    poke64(base,      name as int64);
    poke64(base + 8,  nameLen);
    poke64(base + 16, t0 as int64);
    poke64(base + 24, t0Len);
    poke64(base + 32, t1 as int64);
    poke64(base + 40, t1Len);
    self.fnTupRetCount += 1;
  }

  // #1122: Eintrag suchen; liefert die Basisadresse des Eintrags oder -1.
  fn cg_findTupleRet(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.fnTupRetCount) {
      var base: int64 := self.fnTupRetList + i * 48;
      var n: pchar := peek64(base) as pchar;
      var l: int64 := peek64(base + 8);
      if (self.cg_seq(n, l, name, nameLen) != 0) { return base; }
      i += 1;
    }
    return 0 - 1;
  }

  // Operator overloading (Stage 2c): class-layout index of a function's return
  // type, or -1 if the function is unknown or doesn't return a class.
  // #1058: Traegt die Funktion `name` den deklarierten Rueckgabetyp `tname`?
  // Greift auf dieselbe Registry wie cg_funcRetClassIdx zu (Name, Rueckgabetypname).
  // #1595: Liefert die Groesse, wenn diese Funktion ein STRUCT by value
  // zurueckgibt, sonst 0. Klassen zaehlen nicht — sie sind Referenzen und
  // werden weiterhin als Zeiger zurueckgegeben.
  fn cg_fnRetStructBytes(name: pchar, nameLen: int64): int64 {
    var lb: int64 := alloc(8);
    var rn: pchar := self.cg_funcRetTypeName(name, nameLen, lb);
    var rl: int64 := peek64(lb);
    free(lb, 8);
    if (rn == 0 as pchar || rl <= 0) { return 0; }
    var ci: int64 := self.cg_findClass(rn, rl);
    if (ci < 0) { return 0; }
    if (self.cg_istWertStruct(ci) == 0) { return 0; }
    // #1595: Nicht selbstenthaltene Structs behalten den alten Weg — sonst
    // traegt die flache Kopie einen Zeiger in einen gefallenen Rahmen.
    if (self.cg_structSelbstEnthalten(ci, 0) == 0) { return 0; }
    var sz: int64 := self.cg_classStructSize(ci);
    if (sz <= 0) { return 0; }
    return sz;
  }

  fn cg_funcRetTypeIs(name: pchar, nameLen: int64, tname: pchar, tlen: int64): int64 {
    var i: int64 := self.cg_funcRetIdx(name, nameLen);   // #2175
    if (i >= 0) {
      var base: int64 := self.fnRetList + i * 32;
      var rn: pchar := peek64(base + 16) as pchar;
      var rl: int64 := peek64(base + 24);
      if (self.cg_seq(rn, rl, tname, tlen) != 0) { return 1; }
      return 0;
    }
    return 0 - 1;   // Funktion unbekannt (Builtin oder importiert)
  }

  // #1174: Name des deklarierten Rueckgabetyps einer Funktion; Laenge in
  // lenBox, 0 wenn die Funktion nicht in der Registry steht (Builtin oder
  // importiert). cg_funcRetTypeIs beantwortet nur "ist es DIESER Typ" und
  // taugt deshalb nicht, um einen Klassennamen zu uebernehmen.
  fn cg_funcRetTypeName(name: pchar, nameLen: int64, lenBox: int64): pchar {
    poke64(lenBox, 0);
    var hs0: int64 := self.zlHxS;
    var i: int64 := self.cg_funcRetIdx(name, nameLen);   // #2175
    if (self.zlAktiv != 0) { self.zlFrA += 1; self.zlFrT += self.zlHxS - hs0; }   // #2174
    if (i >= 0) {
      var base: int64 := self.fnRetList + i * 32;
      poke64(lenBox, peek64(base + 24));
      return peek64(base + 16) as pchar;
    }
    return 0 as pchar;
  }

  // #1058: Builtins, die einen Zeichenketten-Zeiger liefern. Sie werden im
  // Codegen unmittelbar emittiert und tragen keinen Eintrag in der
  // Rueckgabetyp-Registry; ohne diese Liste gaebe Print den Zeiger als Zahl aus.
  // #2274: nur noch die Weiterleitung auf die gemeinsame Liste
  // (src/backend/builtin_typen.lyx) — dieselbe Auskunft wie cg_isPcharExpr
  // und wie _printArt im IR-Weg. Die drei muessen uebereinstimmen.
  fn cg_builtinReturnsPchar(nm: pchar, nl: int64): int64 {
    return BuiltinLiefertPchar(nm, nl);
  }

  fn cg_funcRetClassIdx(name: pchar, nameLen: int64): int64 {
    var i: int64 := self.cg_funcRetIdx(name, nameLen);   // #2175
    if (i >= 0) {
      var base: int64 := self.fnRetList + i * 32;
      var rn: pchar := peek64(base + 16) as pchar;
      var rl: int64 := peek64(base + 24);
      return self.cg_findClass(rn, rl);
    }
    return 0 - 1;
  }

  // B2: method-Typ-Alias-Registry. Name = Alias der `type X = method(...)` ist → fat pointer.
  fn cg_registerMethodAlias(name: pchar, nameLen: int64) {
    if (self.methodAliasCount >= self.methodAliasCap) {
      var nc: int64 := self.methodAliasCap * 2;
      var nb: int64 := alloc(nc * 16);
      memcpy(nb, self.methodAliasList, self.methodAliasCount * 16);
      self.methodAliasList := nb;
      self.methodAliasCap  := nc;
    }
    var base: int64 := self.methodAliasList + self.methodAliasCount * 16;
    poke64(base,     name as int64);
    poke64(base + 8, nameLen);
    self.methodAliasCount += 1;
  }
  // Stack-Argumente nach einem Aufruf wieder abräumen.
  //
  // Ab dem 7. Slot passen Argumente nicht mehr in Register und werden nach der
  // SysV-Konvention über den Stack übergeben. Der Aufrufer muss sie nach dem
  // `call` selbst entfernen — genau das fehlte. Solange der Aufruf isoliert
  // stand, fiel es nicht auf (der Frame wird beim Funktionsende ohnehin über rbp
  // zurückgesetzt). Stand er aber INNERHALB der Argumentliste eines anderen
  // Aufrufs, lagen dort bereits die ausgewerteten Argumente des äußeren Aufrufs:
  // die zurückgelassenen Slots verschoben sie, der äußere Aufruf bekam Müll oder
  // stürzte ab. `show("n7", seven(7,7,7,7,7,7,7))` verlor den Namen bzw.
  // segfaultete.
  fn cg_popStackArgs(nTotal: int64) {
    if (nTotal <= 6) { return; }
    var bytes: int64 := (nTotal - 6) * 8;
    if (bytes <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(bytes & 255);   // add rsp, imm8
    } else {
      self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xC4);                            // add rsp, imm32
      self.cg_e8(bytes & 255);
      self.cg_e8((bytes >> 8) & 255);
      self.cg_e8((bytes >> 16) & 255);
      self.cg_e8((bytes >> 24) & 255);
    }
  }

  fn cg_isMethodType(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.methodAliasCount) {
      var base: int64 := self.methodAliasList + i * 16;
      if (self.cg_seq(peek64(base) as pchar, peek64(base + 8), name, nameLen) != 0) { return 1; }
      i += 1;
    }
    return 0;
  }
  // Pre-pass: alle `type X = method(...)`-Aliase registrieren (iv-Bit1 + c0=NK_METHOD_PTR).
  fn cg_collectMethodAliases(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_TYPE_DECL && (self.cg_nival(cur) & 2) != 0) {
        var body: int64 := self.cg_nc0(cur);
        if (body >= 0 && self.cg_nkind(body) == CGN_METHOD_PTR) {
          self.cg_registerMethodAlias(self.cg_nsval(cur), self.cg_nslen(cur));
        } else if (body >= 0 && self.cg_nkind(body) == CGN_FN_PTR_NODE) {
          self.cg_registerFnAliasR(self.cg_nsval(cur), self.cg_nslen(cur),
                                   self.cg_nc1(body));   // #1595: Rueckgabetyp
}
      }
      cur := self.cg_nnext(cur);
    }
  }
  // #1097: Bereichstypen einsammeln, BEVOR Funktionen erzeugt werden — eine
  // hinter der ersten Funktion deklarierte Typdeklaration waere sonst zur
  // Pruefzeit noch unbekannt, und die Zusicherung haenge an der Reihenfolge im
  // Quelltext.
  fn cg_collectRangeTypes(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_TYPE_DECL && (self.cg_nival(cur) & 4) != 0) {
        var rn: int64 := self.cg_nc1(cur);
        if (rn >= 0) {
          var loN: int64 := self.cg_nc0(rn);
          var hiN: int64 := self.cg_nc1(rn);
          if (loN >= 0 && hiN >= 0) {
            // #1882: iv-Bit 3 am Typknoten heisst `wraps`.
            var rFlags: int64 := 0;
            if ((self.cg_nival(cur) & 8) != 0) { rFlags := 1; }
            self.cg_addRangeType(self.cg_nsval(cur), self.cg_nslen(cur),
                                 self.cg_nival(loN), self.cg_nival(hiN), rFlags);
          }
        }
      }
      cur := self.cg_nnext(cur);
    }
  }

  // #1110: Einheitentypen einsammeln, BEVOR Funktionen erzeugt werden — aus
  // demselben Grund wie bei den Bereichstypen: sonst haenge die Umrechnung an
  // der Reihenfolge im Quelltext.
  fn cg_collectUtypes(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_UTYPE_DECL) {
        var utDim: int64 := self.cg_nc0(cur);
        var utFac: int64 := self.cg_nc1(cur);
        var utRng: int64 := self.cg_nc2(cur);
        // #1158: Bis 1.0.15B wurde hier NUR ein ganzzahliges Literal gelesen.
        // Ein Faktor wie `1000.0` fiel stillschweigend auf 1 zurueck und blieb
        // damit wirkungslos — genau die Schreibweise, die std/units.lyx
        // durchgehend benutzt. Jetzt wird der Faktor als Bruch gelesen.
        var facVal: int64 := 1;
        var facDenBox: int64 := alloc(8);
        poke64(facDenBox, 1);
        if (utFac >= 0 && self.cg_nkind(utFac) == CGN_LIT_INT) {
          facVal := self.cg_nival(utFac);
        } else if (utFac >= 0 && self.cg_nkind(utFac) == CGN_LIT_FLOAT) {
          facVal := self.cg_parseFactorRatio(self.pSrc, self.cg_nsoff(utFac),
                                             self.cg_nslen(utFac), facDenBox);
          if (facVal <= 0) {
            // #2006: Der Kommentar hier sagte "melden, nicht heimlich 1
            // rechnen" — und die zwei Zeilen darunter rechneten heimlich 1.
            // Die Absicht war da, die Durchsetzung fehlte: der Bau lief mit
            // rc=0 weiter, und aus 360 Grad wurden 360 Radiant. Stiller
            // Default in seiner unangenehmsten Form, weil der Fehler sogar
            // AUSGEGEBEN und dann uebergangen wurde — im Protokoll sichtbar,
            // am Rueckgabewert nicht, also fuer jede CI unsichtbar.
            //
            // Die Grenze wird mitgenannt: sie ist nicht offensichtlich und
            // steht sonst nirgends, wo ein Nutzer sie liest.
            EPrintStr("codegen error: utype '"c);
            sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
            EPrintStrLn("': Umrechnungsfaktor ist kein lesbares Zahlliteral"c);
            EPrintStrLn("  Hoechstens 14 Nachkommastellen; der Faktor wird als Bruch aus int64 gefuehrt."c);
            exit(1);
          }
        } else if (utFac >= 0) {
          EPrintStr("codegen error: utype '"c);
          sys_write(2, self.cg_nsval(cur) as int64, self.cg_nslen(cur));
          EPrintStrLn("': Umrechnungsfaktor muss ein Zahlliteral sein"c);
          exit(1);   // #2006: dieselbe Luecke, eine Zeile weiter
        }
        var dimP: pchar := 0 as pchar;
        var dimL: int64 := 0;
        if (utDim >= 0) { dimP := self.cg_nsval(utDim); dimL := self.cg_nslen(utDim); }
        var rlo: int64 := 0;
        var rhi: int64 := 0;
        var uflags: int64 := 0;
        if (utRng >= 0) {
          var loN: int64 := self.cg_nc0(utRng);
          var hiN: int64 := self.cg_nc1(utRng);
          if (loN >= 0 && hiN >= 0) {
            rlo := self.cg_nival(loN);
            rhi := self.cg_nival(hiN);
            uflags := 1;
            if ((self.cg_nival(cur) & 2) != 0) { uflags := 3; }   // wraps
          }
        }
        self.cg_addUtype(self.cg_nsval(cur), self.cg_nslen(cur), facVal,
                         dimP, dimL, rlo, rhi, uflags, peek64(facDenBox));
      }
      cur := self.cg_nnext(cur);
    }
  }

  // #1595: Der Eintrag traegt jetzt auch den RUECKGABETYP des Zeigertyps.
  // Ohne ihn kann eine indirekte Aufrufstelle nicht wissen, dass der Gerufene
  // ein Struct by value liefert und deshalb das verdeckte erste Argument
  // erwartet — und genau daran ist `ResultInt64AndThen` abgestuerzt: der
  // Gerufene schrieb in einen Zeiger, den ihm niemand gegeben hatte.
  fn cg_registerFnAliasR(name: pchar, nameLen: int64, retNode: int64) {
    if (self.fnAliasCount >= self.fnAliasCap) {
      var nc: int64 := self.fnAliasCap * 2;
      var nb: int64 := alloc(nc * CG_FNALIAS_SZ);
      memcpy(nb, self.fnAliasList, self.fnAliasCount * CG_FNALIAS_SZ);
      self.fnAliasList := nb;
      self.fnAliasCap  := nc;
    }
    var base: int64 := self.fnAliasList + self.fnAliasCount * CG_FNALIAS_SZ;
    poke64(base,      name as int64);
    poke64(base + 8,  nameLen);
    poke64(base + 16, 0);
    poke64(base + 24, 0);
    if (retNode >= 0 && self.cg_nkind(retNode) == 60) {
      poke64(base + 16, self.cg_nsval(retNode) as int64);
      poke64(base + 24, self.cg_nslen(retNode));
    }
    self.cg_fnTiefeEintragen(base, retNode);   // #2143
    self.fnAliasCount += 1;
  }
  fn cg_registerFnAlias(name: pchar, nameLen: int64) {
    self.cg_registerFnAliasR(name, nameLen, 0 - 1);
  }
  fn cg_isFnPtrAlias(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.fnAliasCount) {
      var base: int64 := self.fnAliasList + i * CG_FNALIAS_SZ;
      if (self.cg_seq(peek64(base) as pchar, peek64(base + 8), name, nameLen) != 0) { return 1; }
      i += 1;
    }
    return 0;
  }

  // #1595: Liefert ein Zeigertyp dieses Namens ein Struct by value zurueck?
  // 0 = nein oder unbekannt.
  fn cg_fnAliasRetStructBytes(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.fnAliasCount) {
      var base: int64 := self.fnAliasList + i * CG_FNALIAS_SZ;
      if (self.cg_seq(peek64(base) as pchar, peek64(base + 8), name, nameLen) != 0) {
        var rp: pchar := peek64(base + 16) as pchar;
        var rl: int64 := peek64(base + 24);
        if (rp == 0 as pchar || rl <= 0) { return 0; }
        var rci: int64 := self.cg_findClass(rp, rl);
        if (rci < 0) { return 0; }
        if (self.cg_istWertStruct(rci) == 0) { return 0; }
        return self.cg_classStructSize(rci);
      }
      i += 1;
    }
    return 0;
  }

  // A1: ist `name` eine deklarierte Top-Level-Funktion? (Fn-Name als Wert → Adresse statt 0)
  fn cg_isDeclaredFunc(name: pchar, nlen: int64): int64 {
    var cur: int64 := self.topLevelHead;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_FUNC_DECL) {
        if (self.cg_seq(self.cg_nsval(cur), self.cg_nslen(cur), name, nlen) != 0) { return 1; }
      }
      cur := self.cg_nnext(cur);
    }
    // #2113: eine OEFFENTLICHE Funktion einer importierten Unit. Die steht
    // nicht in topLevelHead (das ist nur die laufende Unit), sondern ist seit
    // ihrer Erzeugung als Marke eingetragen — unter dem schlichten Namen, wie
    // der Direktaufruf sie ueber CG_PATCH_CALL findet (cg_collectImportLabels;
    // private Funktionen fremder Units tragen dort ihre Unit-Marke und treffen
    // hier nicht). Bis 1.2.14B fehlte diese Herkunft: der Bezeichner fiel in
    // cg_genExpr bis auf cg_zeroRax durch, und der Aufruf ueber den
    // Funktionswert sprang nach 0.
    if (self.cg_findLabel(name, nlen) >= 0) { return 1; }
    return 0;
  }

  // #2113: Ein Bezeichner als Wert, den keine Herkunft kennt (Local,
  // Parameter, Capture, Global, Konstante, extern-Datum, Funktion). Bis
  // 1.2.14B stand hier still cg_zeroRax — eine fehlende Herkunft in der
  // Aufzaehlung wurde so zu einem Nullwert, ueber den der Aufruf nach 0
  // sprang. sema hat unbekannte Namen da laengst abgewiesen; was hier
  // ankommt, ist eine Luecke im Codegen und scheitert laut.
  fn cg_identUnaufgeloest(name: pchar, nlen: int64) {
    // Gewollter Durchfall: ein TYPNAME als Empfaenger eines statischen
    // Aufrufs (`StringBuilder.Create(...)`, self = 0). Der Wert wird nicht
    // benutzt.
    if (self.cg_findClass(name, nlen) >= 0) { self.cg_zeroRax(); return; }
    // Ebenso ein ENUM-Name vor seinem Element (`A.Y`): der Feldzugriff
    // wertet die Basis aus, den Wert liefert danach das Element
    // (tests/typidentitaet_test.sh, "dasselbe Enum geht weiter").
    if (self.cg_findEnum(name, nlen) >= 0) { self.cg_zeroRax(); return; }
    // Und ein TYPNAME an Wertstelle, wie ihn `var c: array[int64]` als
    // Indexausdruck mitbringt (tests/dyn_array_decl_test.sh): eingebaute
    // Typen und Typdeklarationen der Datei. Der Wert wird nicht benutzt.
    if (self.cg_builtinTypeId(name, nlen) != 0) { self.cg_zeroRax(); return; }
    if (self.cg_hatTypDecl(self.topLevelHead, name, nlen) != 0) { self.cg_zeroRax(); return; }
    // Ebenso ein Import-ALIAS als Namensraum vor seinem Aufruf (`e.Wert()`,
    // #1262; tests/import_namensraum_test.sh).
    if (self.cg_isAlias(name, nlen) != 0) { self.cg_zeroRax(); return; }
    EPrintStr("error: codegen: Bezeichner '"c);
    sys_write(2, name, nlen);
    EPrintStr("' als Wert hat keine bekannte Herkunft (Local/Global/Konstante/Funktion)\n"c);
    exit(1);
  }
  // A1: Fn-Adresse laden — lea rax, [rip+disp32]; disp via CG_PATCH_CALL (= target-(pos+4), wie call).
  //
  // #1655: Auch hier gilt die unit-eigene Marke. Beim ersten Anlauf stand die
  // Umsetzung nur an den beiden Aufrufstellen — eine private Funktion, deren
  // ADRESSE genommen wird (`_thrTrampoline` in std/thread.lyx), wurde damit
  // unter ihrem Unit-Namen erzeugt und unter dem schlichten Namen gesucht:
  // "undefined function '_thrTrampoline'". Wer eine Marke umbenennt, muss
  // JEDE Stelle mitnehmen, die auf sie verweist.
  fn cg_emitFuncAddr(name: pchar, nlen: int64) {
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x05);
    if (self.cg_unitPrivHat(name, nlen) != 0) {
      var upl: int64 := alloc(8);
      var upm: int64 := self.cg_unitPrivMangle(name, nlen, upl);
      name := upm as pchar;
      nlen := peek64(upl);
      self.cg_trackTempBuf(upm, nlen + 1);
      free(upl, 8);
    }
    var pos: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(pos, name as int64, nlen, CG_PATCH_CALL);
  }

  // Pre-pass: scan all CGN_FUNC_DECL nodes and register those returning f64.
  // f64-Kennzeichen, Rueckgabetyp und Tupelform der Funktion `fni` unter dem
  // Namen `name` eintragen. Aufgerufen fuer jede Funktion der obersten Ebene
  // (cg_collectF64Funcs) und fuer jede innere Funktion unter ihrer Marke
  // (#2044, cg_nestPlan) — ohne den zweiten Weg galt eine innere Funktion mit
  // f64-Rueckgabe als ganzzahlig.
  fn cg_registerSigUnter(fni: int64, name: pchar, nlen: int64) {
    var retNi: int64 := self.cg_nc1(fni);
    if (retNi < 0) { return; }
    self.cg_registerFnWertKandidat(name, nlen, retNi);   // #2133
    var rname: pchar := self.cg_nsval(retNi);
    var rlen:  int64 := self.cg_nslen(retNi);
    if (self.cg_isFloatTypeName(rname, rlen) != 0) {   // #1127: f32 zaehlt mit
      self.cg_registerF64Func(name, nlen);
    }
    // Stage 2c: record the return type so a call expression's static
    // class can be resolved (retName -> cg_findClass at lookup time).
    if (rlen > 0) {
      self.cg_registerFuncRet(name, nlen, rname, rlen);
    }
    // #1122: Tupel-Rueckgabe traegt zwei Typen — der Knoten selbst hat
    // keinen Namen, die Elementtypen haengen an c0 und dessen next.
    if (self.cg_nkind(retNi) == CGN_TYPE_TUPLE) {
      var e0: int64 := self.cg_nc0(retNi);
      if (e0 >= 0) {
        var e1: int64 := self.cg_nnext(e0);
        if (e1 >= 0) {
          self.cg_registerTupleRet(name, nlen,
                                   self.cg_nsval(e0), self.cg_nslen(e0),
                                   self.cg_nsval(e1), self.cg_nslen(e1));
        }
      }
    }
  }

  fn cg_collectF64Funcs(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_FUNC_DECL) {
        var retNi: int64 := self.cg_nc1(cur);
        // #1566: Bei `extern fn` laesst der Parser c0 und c1 auf -1 — der
        // Rueckgabetyp steht NICHT im Baum ("call-site arity is enough", siehe
        // _parseExternDecl). Diese Pre-Pass sah dort also nie einen
        // Fliesskommatyp, und die Funktion fehlte in der f64-Registry:
        // `var v: f64 := fabs(x)` galt als Ganzzahlzuweisung, und die
        // Umrechnung aus #1502 machte aus dem korrekten Bitmuster eine Zahl
        // (4.6e18). Dass `sqrt` funktionierte, war Zufall — der Name steht
        // ohnehin als Builtin in der Registry.
        //
        // Die Rueckgabeklasse liegt seit #1486 in iVal, Bits 48-49:
        // 1 = f64, 2 = f32. Beide zaehlen als Gleitkomma.
        //
        // #1704: ...aber NUR bei einer echten extern-Deklaration. Die Bits
        // 48-49 sind doppelt belegt: `@wcet(N)` legt seine Schranke ab Bit 40
        // ab (ANNO_WCET_SHIFT, 24 Bit breit), ueberdeckt also 48-63. Beide
        // Kodierungen waren fuer verschiedene Knoten gedacht — eine
        // extern-Deklaration traegt kein @wcet —, nur fragte dieser Vorlauf
        // nicht, welche Sorte er vor sich hat.
        //
        // Folge: `@wcet(500)` setzte `(500 >> 8) & 3 == 1`, die Funktion galt
        // als f64, und ein Aufruf IM AUSDRUCK rechnete in Gleitkomma:
        // `F(20) + 1` lieferte das Bitmuster von 1.0. Ueber eine
        // Zwischenvariable stimmte derselbe Aufruf, weil dort der deklarierte
        // Typ zaehlt. Genau bei 256 kippt es, darunter ist nichts zu sehen.
        //
        // Das Unterscheidungsmerkmal steht im Kommentar darueber: bei einer
        // extern-Deklaration laesst der Parser c1 auf -1, der Rueckgabetyp
        // steht NICHT im Baum — deshalb gibt es die Bits ueberhaupt. Eine
        // gewoehnliche Funktion mit `@wcet` hat ihren Rueckgabetyp dagegen
        // deklariert, also c1 >= 0. Genau daran laesst sich sauber trennen.
        //
        // Zwei engere Anlaeufe daneben: "rumpflos" (c2 == -1) und "rumpflos
        // mit Bibliotheksangabe" (c2 == -1 && c3 != -1) trafen beide nicht,
        // was #1566 braucht.
        var istExtern: int64 := 0;
        if (self.cg_nc1(cur) == -1) { istExtern := 1; }
        var externRet: int64 := 0;
        if (istExtern != 0) { externRet := (self.cg_nival(cur) >> 48) & 3; }
        if (externRet != 0) {
          self.cg_registerF64Func(self.cg_nsval(cur), self.cg_nslen(cur));
        }
        // #2044: dieselbe Registrierung nehmen die inneren Funktionen unter
        // ihrer Marke (cg_nestPlan) — deshalb ein Helfer statt zweier Kopien.
        self.cg_registerSigUnter(cur, self.cg_nsval(cur), self.cg_nslen(cur));
      }
      // Stage 2c (methods): record class methods' return types under their
      // mangled "ClassName_Method" name, so `obj.M() + x` can resolve M's class.
      if (self.cg_nkind(cur) == CGN_TYPE_DECL && (self.cg_nival(cur) & 2) == 0) {
        var cln: pchar := self.cg_nsval(cur);
        var clnLen: int64 := self.cg_nslen(cur);
        var method: int64 := self.cg_nc1(cur);
        while (method != -1) {
          var mRetNi: int64 := self.cg_nc1(method);
          if (mRetNi >= 0 && self.cg_nkind(mRetNi) == CGN_TYPE_TUPLE) {
            // #1122: dieselbe Merkung fuer Methoden, unter dem gemangelten Namen.
            var me0: int64 := self.cg_nc0(mRetNi);
            if (me0 >= 0) {
              var me1: int64 := self.cg_nnext(me0);
              if (me1 >= 0) {
                var mlc: int64 := alloc(8);
                var mmb: int64 := self.cg_mangleInto(cln, clnLen, self.cg_nsval(method), self.cg_nslen(method), mlc);
                var mmbLen: int64 := peek64(mlc);
                free(mlc, 8);
                self.cg_registerTupleRet(mmb as pchar, mmbLen,
                                         self.cg_nsval(me0), self.cg_nslen(me0),
                                         self.cg_nsval(me1), self.cg_nslen(me1));
                self.cg_trackTempBuf(mmb, mmbLen + 1);
              }
            }
          }
          if (mRetNi >= 0 && self.cg_nkind(mRetNi) == CGN_FN_PTR_NODE) {
            // #2133: Methode mit Funktionstyp als Rueckgabe (der Typ hat
            // keinen Namen, die Schleife darunter saehe ihn nicht).
            var fwl: int64 := alloc(8);
            var fwb: int64 := self.cg_mangleInto(cln, clnLen, self.cg_nsval(method), self.cg_nslen(method), fwl);
            self.cg_registerFnWertKandidat(fwb as pchar, peek64(fwl), mRetNi);
            free(fwl, 8);
          }
          if (mRetNi >= 0) {
            var mrn: pchar := self.cg_nsval(mRetNi);
            var mrl: int64 := self.cg_nslen(mRetNi);
            if (mrl > 0) {
              var lc: int64 := alloc(8);
              var mb: int64 := self.cg_mangleInto(cln, clnLen, self.cg_nsval(method), self.cg_nslen(method), lc);
              var mbLen: int64 := peek64(lc);
              free(lc, 8);
              self.cg_registerFuncRet(mb as pchar, mbLen, mrn, mrl);
              // #2133: Alias auf einen Funktionstyp? (aufgeloest nach den Aliasen)
              var fwb2: int64 := alloc(mbLen + 1);
              memcpy(fwb2, mb, mbLen + 1);
              self.cg_registerFnWertKandidat(fwb2 as pchar, mbLen, mRetNi);
              // #1887: HIER fehlte das Gleitkomma-Kennzeichen. Diese Schleife
              // merkt sich fuer jede Methode den Rueckgabetyp und die
              // Tupelform — nur die f64-Registry blieb aussen vor, und die
              // fragt cg_isF64Expr beim Aufruf ab. Eine Methode mit
              // f64-Rueckgabe galt damit als Ganzzahl, sobald ihr Ergebnis in
              // eine Variable oder einen Ausdruck ging:
              //
              //     return self.M();          richtig  (der return-Pfad kennt
              //                                         den Typ aus der Signatur)
              //     var e: f64 := self.M();   4621819117588971520
              //                               (= 0x4024000000000000, die Bits
              //                                von 10.0)
              //     self.M() * 2.0            "overflow"
              //
              // Dieselbe Klasse wie #905 (Cast), #1203 (Feld), #1373
              // (Globale), #1374 (Arrayelement), #1499 (Konstante), #1565
              // (Funktionszeiger): die Aufzaehlung, woher ein f64 kommen kann,
              // vergisst eine Herkunft. Registriert wird unter dem GEMANGELTEN
              // Namen, damit nicht jede gleichnamige Methode einer anderen
              // Klasse mitgerissen wird.
              if (self.cg_isFloatTypeName(mrn, mrl) != 0) {
                self.cg_registerF64Func(mb as pchar, mbLen);
              }
              self.cg_trackTempBuf(mb, mbLen + 1);
            }
          }
          method := self.cg_nnext(method);
        }
      }
      cur := self.cg_nnext(cur);
    }
  }

  // #1127: `f32` ist ein Fliesskommatyp wie `f64`. Der Wert liegt in beiden
  // Faellen als double im GP-Register — eine eigene 32-Bit-Darstellung gibt es
  // nicht, und Struct-Felder wie Array-Elemente belegen ohnehin 8 Byte. Ohne
  // diese Erkennung galt eine `f32`-Variable als Ganzzahl: Arithmetik und
  // `as int64` arbeiteten dann auf dem rohen Bitmuster.
  // #1565: Rueckgabetyp eines fn-Zeigertyps `fn(...): R`. R haengt an c1.
  fn cg_fnPtrRetIstF64(typeNode: int64): int64 {
    if (typeNode < 0) { return 0; }
    if (self.cg_nkind(typeNode) != CGN_FN_PTR_NODE) { return 0; }
    var r: int64 := self.cg_nc1(typeNode);
    if (r < 0) { return 0; }
    return self.cg_isFloatTypeName(self.cg_nsval(r), self.cg_nslen(r));
  }

  // #2143: Tiefe des Rueckgabetyps eines fn-Zeigertyps `fn(...): R` (siehe
  // cg_fnTiefeEintragen) — >= 1: ein Aufruf darueber liefert einen Satz.
  // Gegenstueck zu cg_fnPtrRetIstF64, die Merkung steht an denselben Stellen.
  fn cg_fnPtrRetTiefe(typeNode: int64): int64 {
    if (typeNode < 0) { return 0; }
    if (self.cg_nkind(typeNode) != CGN_FN_PTR_NODE) { return 0; }
    return self.cg_fnTiefeKnoten(self.cg_nc1(typeNode));
  }

  // #2161: Aliase auf benannte Typen einsammeln — VOR cg_collectF64Funcs,
  // denn dort entscheidet cg_isFloatTypeName ueber den Rueckgabetyp (dieselbe
  // Reihenfolgefalle wie #2004 bei den Einheitentypen).
  fn cg_collectWertAliase(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_TYPE_DECL && (self.cg_nival(cur) & 2) != 0) {
        var body: int64 := self.cg_nc0(cur);
        if (body >= 0 && self.cg_nkind(body) == 60 && self.cg_nslen(body) > 0) {
          self.cg_registerWertAlias(self.cg_nsval(cur), self.cg_nslen(cur),
                                    self.cg_nsval(body), self.cg_nslen(body));
        }
      }
      cur := self.cg_nnext(cur);
    }
  }

  fn cg_registerWertAlias(np: pchar, nl: int64, zp: pchar, zl: int64) {
    if (self.wertAliasCount >= self.wertAliasCap) {
      var nc: int64 := self.wertAliasCap * 2;
      if (nc < 32) { nc := 32; }
      var nb: int64 := alloc(nc * 32);
      if (self.wertAliasCount > 0) { memcpy(nb, self.wertAliasList, self.wertAliasCount * 32); }
      self.wertAliasList := nb;
      self.wertAliasCap  := nc;
    }
    var b: int64 := self.wertAliasList + self.wertAliasCount * 32;
    poke64(b, np as int64); poke64(b + 8, nl);
    poke64(b + 16, zp as int64); poke64(b + 24, zl);
    self.wertAliasCount += 1;
  }

  // #2161: Eintrag des Alias `name` oder -1.
  fn cg_aliasIdx(name: pchar, nl: int64): int64 {
    var i: int64 := 0;
    while (i < self.wertAliasCount) {
      var b: int64 := self.wertAliasList + i * 32;
      if (peek64(b + 8) == nl && self.cg_seq(peek64(b) as pchar, nl, name, nl) != 0) { return i; }
      i += 1;
    }
    return 0 - 1;
  }

  // #2160: Ist das Feld vom Typ f32? Nur dann hat es vier Byte (cg_typeSize);
  // ein Alias auf f32 belegt acht und haelt den double unveraendert.
  // Dieselbe Abgrenzung wie _tnIstF32 im IR-Weg.
  fn cg_feldIstF32(classIdx: int64, fname: pchar, flen: int64): int64 {
    if (classIdx < 0) { return 0; }
    var bx: int64 := alloc(8);
    var tp: pchar := self.cg_fieldTypeNameIn(classIdx, fname, flen, bx);
    var tl: int64 := peek64(bx);
    free(bx, 8);
    if (tp == 0 as pchar || tl <= 0) { return 0; }
    if (self.cg_seq(tp, tl, "f32"c, 3)) { return 1; }
    return 0;
  }

  fn cg_isFloatTypeName(tp: pchar, tln: int64): int64 {
    return self.cg_isFloatTypeNameT(tp, tln, 0);
  }

  fn cg_isFloatTypeNameT(tp: pchar, tln: int64, tiefe: int64): int64 {
    if (self.cg_seq(tp, tln, "f64"c, 3) != 0) { return 1; }
    if (self.cg_seq(tp, tln, "f32"c, 3) != 0) { return 1; }
    // #2161: `type Meter = f64` — bis 1.2.17A galt der Alias als Ganzzahl,
    // Literal und Arithmetik liefen auf dem IEEE-Bitmuster. Dieselbe
    // Aufloesung wie parser._sigFloatName fuer extern-Signaturen; die
    // Tiefe begrenzt einen (von sema abgewiesenen) Alias-Kreis.
    var ai: int64 := self.cg_aliasIdx(tp, tln);
    if (ai >= 0 && tiefe < 16) {
      var ab: int64 := self.wertAliasList + ai * 32;
      return self.cg_isFloatTypeNameT(peek64(ab + 16) as pchar, peek64(ab + 24), tiefe + 1);
    }
    // #1955: Einheitentypen rechnen ab 1.2.1A in Gleitkomma.
    //
    // Bis dahin lagen sie in ganzzahligen Slots (#1358), und damit war jede
    // physikalische Groesse gesperrt: 12,5 V, 4,7 kOhm, 10 nF liessen sich
    // nicht ausdruecken. Fuer Laengen in Metern reichte das, fuer alles
    // Technische nicht — also ausgerechnet dort nicht, wo eine
    // Einheitenverwechslung am teuersten ist.
    //
    // Der Umrechnungsfaktor bleibt ein BRUCH (cg_utypeFactor/-Den, #1158):
    // gerechnet wird `wert * zaehler / nenner` in Gleitkomma, `deg` also
    // weiterhin exakt als 17453.../1000000 und nicht als eingefrorener,
    // abgeschnittener Gleitkommafaktor.
    //
    // Diese eine Zeile lenkt den gesamten Wertepfad um: Speicher, Arithmetik
    // und Ausgabe entscheiden sich im Codegen am TYPNAMEN, nicht an einer
    // eigenen Fallunterscheidung.
    if (self.cg_findUtype(tp, tln) >= 0) { return 1; }
    return 0;
  }

  // #1291: `Map<pchar, V>` am Local vermerken. Der Typname allein sagt es
  // nicht — er lautet nur "Map"; der Schluesseltyp steht im ersten Typargument
  // (c0; der Wertetyp in c1, dieselbe Stelle liest sema in _checkMapKeyType).
  fn cg_markMapStrKey(localIdx: int64, typeNode: int64) {
    if (localIdx < 0 || typeNode < 0) { return; }
    if (self.cg_nkind(typeNode) != 60) { return; }
    if (self.cg_seq(self.cg_nsval(typeNode), self.cg_nslen(typeNode), "Map", 3) == 0) { return; }
    var keyTy: int64 := self.cg_nc0(typeNode);
    if (keyTy < 0 || self.cg_nkind(keyTy) != 60) { return; }
    if (self.cg_seq(self.cg_nsval(keyTy), self.cg_nslen(keyTy), "pchar", 5) != 0) {
      poke8(self.localMapStrKey + localIdx, 1);
    }
  }

  // #1291: Ist der Ausdruck eine Map mit Zeichenketten-Schluesseln? Nur der
  // einfache Fall — eine Variable. Ein Map-Literal an Ort und Stelle wird
  // unten am Literal selbst entschieden.
  fn cg_isStrKeyMap(ni: int64): int64 {
    if (ni < 0) { return 0; }
    if (self.cg_nkind(ni) != CGN_IDENT) { return 0; }
    var li: int64 := self.cg_findLocalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
    if (li < 0) {
      // #2150: Modulvariable — dieselbe Reihenfolge wie cg_localIsMap.
      var gi: int64 := self.cg_findGlobalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if (gi < 0) { return 0; }
      return peek8(self.globalMapStrKey + gi) as int64;
    }
    return peek8(self.localMapStrKey + li) as int64;
  }

  // #1374: Elementtyp beim Anlegen des Locals vermerken. Der Typname des
  // Arrays selbst taugt dafuer nicht — `[3]f64` steht als eigener Knoten da,
  // und localTypes traegt (fuer Klassen) den Elementtyp, fuer f64 aber nichts.
  // Ein eigenes Kennzeichen ist sauberer, als den Typnamen umzudeuten: `arr`
  // ist KEIN f64, nur `arr[i]` ist eines.
  // #2199: Elementbreite aus dem Elementtyp eines `parallel Array<T>`.
  //
  // Vorgabe ist 4 (f32) — nicht, weil f32 der Normalfall waere, sondern weil
  // die Ablage bis 1.2.19F ueberhaupt nur diese Breite kannte. `f64` lieferte
  // deshalb still f32: `v[0] := 0.1` ergab 0.10000000149011612, `1e40` wurde
  // inf. Beim Lesen wandelte cvtss2sd zurueck (#2183), weshalb runde Werte
  // wie 1.5 richtig aussahen und der Fehler unentdeckt blieb (#2199).
  // #2247: Elementkennung eines `parallel Array<T>` — Breite UND Art in einem
  // Byte, weil die Breite allein nicht mehr eindeutig ist: 4 kann f32 oder
  // int32 bedeuten. Gleitkomma behaelt die nackte Breite (4 bzw. 8), damit
  // jeder vorhandene Vergleich `== 8` aus #2224 weiter gilt; Ganzzahl setzt
  // zusaetzlich CG_SIMD_GANZ.
  //
  // Unbekannter oder fehlender Typ ergibt weiter 4 (f32) — das ist der
  // Vorgabewert aus #2224 und keine neue stille Annahme: sema hat die
  // Elementart vorher geprueft (_simdElemPruefen) und laesst nichts anderes
  // durch.
  fn cg_simdKennungVonTyp(elemTypeNode: int64): int64 {
    if (elemTypeNode < 0) { return 4; }
    if (self.cg_nkind(elemTypeNode) != 60) { return 4; }
    var nm: pchar := self.cg_nsval(elemTypeNode);
    var nl: int64 := self.cg_nslen(elemTypeNode);
    if (self.cg_seq(nm, nl, "f64", 3)) { return 8; }
    if (self.cg_seq(nm, nl, "f32", 3)) { return 4; }
    if (self.cg_seq(nm, nl, "int8", 4))  { return CG_SIMD_GANZ | 1; }
    if (self.cg_seq(nm, nl, "int16", 5)) { return CG_SIMD_GANZ | 2; }
    if (self.cg_seq(nm, nl, "int32", 5)) { return CG_SIMD_GANZ | 4; }
    if (self.cg_seq(nm, nl, "int64", 5)) { return CG_SIMD_GANZ | 8; }
    return 4;
  }

  // Nur die Breite, ohne die Art — 1, 2, 4 oder 8.
  fn cg_simdBytesVonTyp(elemTypeNode: int64): int64 {
    return self.cg_simdKennungVonTyp(elemTypeNode) & CG_SIMD_BREITE;
  }

  // Elementbreite eines SIMD-Locals; 4, wenn nichts vermerkt ist.
  fn cg_simdBytesOf(localIdx: int64): int64 {
    if (localIdx < 0) { return 4; }
    var b: int64 := peek8(self.localSimdBytes + localIdx) & CG_SIMD_BREITE;
    if (b == 1 || b == 2 || b == 4 || b == 8) { return b; }
    return 4;
  }

  // #2247: Ist die Elementart eine GANZZAHL? Entscheidet die Operationstabelle
  // (PADDB/W/D/Q statt ADDPS/ADDPD) und den Rest-Durchgang.
  fn cg_simdGanzOf(localIdx: int64): int64 {
    if (localIdx < 0) { return 0; }
    if ((peek8(self.localSimdBytes + localIdx) & CG_SIMD_GANZ) != 0) { return 1; }
    return 0;
  }

  fn cg_markElemFloat(localIdx: int64, elemTypeNode: int64) {
    if (localIdx < 0 || elemTypeNode < 0) { return; }
    if (self.cg_nkind(elemTypeNode) != 60) { return; }
    if (self.cg_isFloatTypeName(self.cg_nsval(elemTypeNode), self.cg_nslen(elemTypeNode)) != 0) {
      poke8(self.localElemFloat + localIdx, 1);
    }
  }

  // #1374: Traegt der Grundausdruck eines Index-Zugriffs Fliesskomma-Elemente?
  // Der deklarierte Typ steht als NAME da — `[3]f64`, `f64[]`, `Array<f64>`.
  // Geprueft wird deshalb auf den Elementnamen im Typnamen, statt eine eigene
  // Typdarstellung zu erfinden, die es an dieser Stelle nicht gibt.
  fn cg_isF64ElemOf(baseNi: int64): int64 {
    if (baseNi < 0) { return 0; }
    // #1498: der Grundausdruck darf auch ein FELD sein — `s.e[0]` bei
    // `e: [2]f64`. Bis hierher sah die Funktion nur Locals; ein Feld-Array
    // lieferte deshalb 0, und `s.e[0] + s.e[1]` addierte Bitmuster (nan).
    if (self.cg_nkind(baseNi) == CGN_FIELD) {
      var fbox2: int64 := alloc(8);
      var etp: pchar := self.cg_fieldElemTypeNameOf(baseNi, fbox2);
      var etl: int64 := peek64(fbox2);
      free(fbox2, 8);
      if (etp != 0 as pchar && etl > 0) { return self.cg_isFloatTypeName(etp, etl); }
      return 0;
    }
    if (self.cg_nkind(baseNi) != CGN_IDENT) { return 0; }
    var li: int64 := self.cg_findLocalIdx(self.cg_nsval(baseNi), self.cg_nslen(baseNi));
    if (li < 0) { return 0; }
    return peek8(self.localElemFloat + li) as int64;
  }

  // #1498: Elementtypname eines inline liegenden Feld-Arrays. Der Name steht
  // seit #1493 im Feldeintrag (CG_CFIELD_OFF_ELEMTYPEPTR).
  fn cg_fieldElemTypeNameOf(fieldNi: int64, lenBox: int64): pchar {
    poke64(lenBox, 0);
    if (self.cg_nkind(fieldNi) != CGN_FIELD) { return 0 as pchar; }
    var ci: int64 := self.cg_objClassIdx(self.cg_nc0(fieldNi));
    if (ci < 0) { return 0 as pchar; }
    var base: int64 := self.classLayouts + ci * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var fname: pchar := self.cg_nsval(fieldNi);
    var flen:  int64 := self.cg_nslen(fieldNi);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      if (peek64(fb + CG_CFIELD_OFF_FIELDLEN) == flen
          && self.cg_seq(peek64(fb) as pchar, flen, fname, flen)) {
        var ep: pchar := peek64(fb + CG_CFIELD_OFF_ELEMTYPEPTR) as pchar;
        var el: int64 := peek64(fb + CG_CFIELD_OFF_ELEMTYPELEN);
        if (ep == 0 as pchar || el <= 0) { return 0 as pchar; }
        poke64(lenBox, el);
        return ep;
      }
      i += 1;
    }
    return 0 as pchar;
  }

  // Returns 1 if expression ni produces an f64 value (IEEE-754 bits in GP register).
  // #2310: Mantel um cg_isF64ExprKern. Er beantwortet die Frage aus dem
  // Merker, wenn derselbe Knoten bei GLEICHER Lage schon gefragt wurde.
  fn cg_isF64Expr(ni: int64): int64 {
    if ni < 0 { return 0; }
    if (self.zlF4Tab == 0) { return self.cg_isF64ExprKern(ni); }
    var h: int64 := ni * 2654435761;
    if (h < 0) { h := 0 - h; }
    var e: int64 := self.zlF4Tab + (h % self.zlF4Cap) * 80;
    if (self.zlAktiv != 0) { self.zlF4A += 1; }
    if (peek64(e) == ni + 1
        && peek64(e + 8)  == self.pNodes
        && peek64(e + 16) == self.localBase
        && peek64(e + 24) == self.localCount
        && peek64(e + 32) == self.capturedCount
        && peek64(e + 40) == (self.outerFuncName as int64)
        && peek64(e + 48) == self.globalVarCount
        && peek64(e + 56) == self.conCount
        && peek64(e + 64) == self.classCount) {
      if (self.zlAktiv != 0) { self.zlF4W += 1; }
      return peek64(e + 72);
    }
    var r: int64 := self.cg_isF64ExprKern(ni);
    // Die Lage wird NACH dem Kern gelesen: er fragt nur, er veraendert nichts
    // — und wenn das eines Tages nicht mehr stimmt, gehoert der dann gueltige
    // Stand in den Eintrag, nicht der von vorher.
    poke64(e,      ni + 1);
    poke64(e + 8,  self.pNodes);
    poke64(e + 16, self.localBase);
    poke64(e + 24, self.localCount);
    poke64(e + 32, self.capturedCount);
    poke64(e + 40, self.outerFuncName as int64);
    poke64(e + 48, self.globalVarCount);
    poke64(e + 56, self.conCount);
    poke64(e + 64, self.classCount);
    poke64(e + 72, r);
    return r;
  }

  fn cg_isF64ExprKern(ni: int64): int64 {
    if ni < 0 { return 0; }
    var k: int64 := self.cg_nkind(ni);
    if k == CGN_LIT_FLOAT { return 1; }
    if k == CGN_IDENT {
      var idx: int64 := self.cg_findLocalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if idx >= 0 {
        var tb:  int64 := self.localTypes + idx * CG_LOCTYPE_SZ;
        var tp:  pchar := peek64(tb) as pchar;
        var tln: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
        return self.cg_isFloatTypeName(tp, tln);
      }
      // #2133: im Rumpf eines Lambdas eine ERFASSUNG — ihr Typ ist der des
      // aeusseren Locals. Fehlte: `x * y` mit erfasstem `x: f64` rechnete als
      // Ganzzahl (1.5 * 4.0 -> 0). Vor den Globalen, wie beim Lesen.
      var capOi: int64 := self.cg_capOuterIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if capOi >= 0 {
        var ctb:  int64 := self.localTypes + capOi * CG_LOCTYPE_SZ;
        return self.cg_isFloatTypeName(peek64(ctb) as pchar, peek64(ctb + CG_LOCTYPE_OFF_LEN));
      }
      // #1373: GLOBALE waren hier nicht vorgesehen — die Funktion sah nur in
      // der Liste der Locals nach und gab sonst 0 zurueck. Eine globale f64
      // galt damit als Ganzzahl: `g as int64` lieferte das rohe Bitmuster,
      // Arithmetik rechnete auf den IEEE-Bits. Dieselbe Luecke wie beim
      // `as`-Cast (#905), beim Feldzugriff (#1203) und beim Einheitentyp
      // (#1358) — nur eine Knotenart weiter.
      var gidx: int64 := self.cg_findGlobalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if gidx >= 0 {
        var gp: pchar := peek64(self.globalTypeNames + gidx * 16) as pchar;
        var gl: int64 := peek64(self.globalTypeNames + gidx * 16 + 8);
        if (gp == 0 as pchar || gl <= 0) { return 0; }
        return self.cg_isFloatTypeName(gp, gl);
      }
      // #1499: eine benannte KONSTANTE. Sie steht weder unter den Locals noch
      // unter den Globalen — ohne diesen Zweig galt jede f64-Konstante als
      // Ganzzahl.
      var conIdx: int64 := self.cg_findConIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if (conIdx >= 0) { return peek8(self.conIsF64 + conIdx) as int64; }
      return 0;
    }
    // #1374: das ARRAY-ELEMENT. `arr[0]` mit `arr: [3]f64` galt ebenfalls als
    // Ganzzahl. Massgeblich ist der Elementtyp des Grundausdrucks; steht dort
    // ein Fliesskommatyp, traegt auch das Element einen.
    if k == CGN_INDEX {
      return self.cg_isF64ElemOf(self.cg_nc0(ni));
    }
    // #1512/#1496: das unaere Minus. `-a` und `-2.0` galten als Ganzzahl, also
    // rechnete `-a - b` auf den Bitmustern. Das Vorzeichen aendert den TYP
    // nicht — massgeblich ist der Operand.
    if k == CGN_UNOP {
      var uop: int64 := self.cg_nival(ni);
      if (uop == CGT_MINUS) { return self.cg_isF64Expr(self.cg_nc0(ni)); }
      return 0;
    }
    if k == CGN_BINOP {
      var bop: int64 := self.cg_nival(ni);
      // Comparisons and logical ops produce int64 (0/1), not f64 — don't recurse.
      if bop == CGT_AND || bop == CGT_OR { return 0; }
      if bop == CGT_EQ2 || bop == CGT_NEQ { return 0; }
      if bop == CGT_LT || bop == CGT_LE || bop == CGT_GT || bop == CGT_GE { return 0; }
      if self.cg_isF64Expr(self.cg_nc0(ni)) != 0 { return 1; }
      return self.cg_isF64Expr(self.cg_nc1(ni));
    }
    if k == CGN_CALL {
      var fpLc: int64 := alloc(8);   // #2044: Marke der inneren Funktion, sonst der Name
      var fp: pchar := self.cg_callName(ni, fpLc);
      var fl: int64 := peek64(fpLc);
      free(fpLc, 8);
      // #1887: METHODENAUFRUF (iVal == 1). Er steht in der Registry unter
      // "Klasse_Methode"; die Suche nach dem nackten Namen ging deshalb ins
      // Leere. Aufgeloest wird wie in cg_setLocalTypesFromTupleCall: Empfaenger
      // -> Klasse -> deklarierende Klasse (bei geerbten Methoden liegt der
      // Rueckgabetyp beim Elternteil, #1120) -> gemangelter Name.
      //
      // Nach dem nackten Namen zu suchen waere die bequeme Abkuerzung und
      // zugleich eine Rechtevergabe zu weit: eine gleichnamige Methode einer
      // anderen Klasse mit int64-Rueckgabe wuerde dann als f64 gelten.
      if (self.cg_nival(ni) == 1) {
        var mRecv: int64 := self.cg_nc0(ni);
        var mCls:  int64 := self.cg_exprClassName(mRecv);
        if (mCls < 0 && mRecv >= 0 && self.cg_nkind(mRecv) == CGN_IDENT) {
          // `TypeName.M()`: der Empfaenger ist die Klasse selbst. Wie in
          // cg_genCall gilt der Name nur dann als Typ, wenn es keine
          // gleichnamige lokale Variable gibt.
          if (self.cg_findLocalIdx(self.cg_nsval(mRecv), self.cg_nslen(mRecv)) < 0) {
            mCls := self.cg_findClass(self.cg_nsval(mRecv), self.cg_nslen(mRecv));
          }
        }
        if (mCls < 0) { return 0; }
        var mOwn: int64 := self.cg_findMethodOwner(mCls, fp, fl);
        if (mOwn >= 0) { mCls := mOwn; }
        var mlcb: int64 := alloc(8);
        var mmb:  int64 := self.cg_buildMethodMangled(mCls, fp, fl, mlcb);
        var mmbL: int64 := peek64(mlcb);
        free(mlcb, 8);
        var mIsF: int64 := self.cg_isF64Func(mmb as pchar, mmbL);
        self.cg_trackTempBuf(mmb, mmbL + 1);
        return mIsF;
      }
      if (self.cg_isF64Func(fp, fl) != 0) { return 1; }
      // #1565: Aufruf ueber einen FUNKTIONSZEIGER. Der Name ist dann kein
      // Funktionsname, sondern eine Variable — die Registry kennt ihn nicht,
      // und `var v: f64 := f(x)` galt als Ganzzahl. Massgeblich ist der
      // Rueckgabetyp des Zeigertyps, der am Local vermerkt ist.
      var li: int64 := self.cg_findLocalIdx(fp, fl);
      if (li >= 0 && peek8(self.localFnPtrF64 + li) != 0) { return 1; }
      // #2133: dasselbe ueber eine ERFASSUNG im Rumpf eines Lambdas.
      if (li < 0) {
        var cfi: int64 := self.cg_capOuterIdx(fp, fl);
        if (cfi >= 0) { return peek8(self.localFnPtrF64 + cfi) as int64; }
      }
      // #1574: derselbe Fall fuer eine GLOBALE Zeigervariable. Ein Local
      // gleichen Namens verdeckt sie, darum erst hier.
      if (li < 0) {
        var gi2: int64 := self.cg_findGlobalIdx(fp, fl);
        if (gi2 >= 0 && peek8(self.globalFnPtrF64 + gi2) != 0) { return 1; }
      }
      return 0;
    }
    // #1203: der FELDZUGRIFF. `s.lat as int64` mit `lat: f64` lieferte das
    // rohe Bitmuster statt der Umrechnung, weil diese Funktion den Knoten
    // nicht kannte und das Feld als Ganzzahl galt. Dieselbe Luecke wie beim
    // Cast in #905 — nur eine Knotenart weiter.
    if k == CGN_FIELD {
      var fbox: int64 := alloc(8);
      var ftp: pchar := self.cg_fieldTypeNameOf(ni, fbox);
      var ftl: int64 := peek64(fbox);
      free(fbox, 8);
      if (ftp != 0 as pchar && ftl > 0) { return self.cg_isFloatTypeName(ftp, ftl); }
      return 0;
    }
    // A cast `x as f64` yields an f64. Without this, a binop whose operands are
    // both `... as f64` casts was treated as int64 and used integer division on
    // the raw IEEE-754 bit patterns (e.g. (a as f64)/(b as f64) => garbage).
    if k == CGN_CAST {
      var tn: int64 := self.cg_nc1(ni);
      if tn >= 0 {
        return self.cg_isFloatTypeName(self.cg_nsval(tn), self.cg_nslen(tn));
      }
      return 0;
    }
    return 0;
  }

  // #1212: Ganzzahl in rax nach IEEE-754 double wandeln (cvtsi2sd + movq
  // zurueck). Dieselbe Folge wie im Cast-Pfad `x as f64` — hier als eigene
  // Funktion, weil die gemischte Arithmetik sie an zwei Stellen braucht.
  // #2004 (Folgebefund): `return 2500;` in einer Funktion mit f64- oder
  // Einheiten-Rueckgabetyp gab die rohe Ganzzahl zurueck. Der Aufrufer las sie
  // als IEEE-Bitmuster — 2500 ist dort eine denormale Zahl nahe null, und
  // `hoehe(): M { return 2500; }` lieferte 0.0000 statt 2500.
  //
  // Vorbestehend und gegen 1.2.4D belegt; er fiel nur nicht auf, weil sich
  // zwei Fehler aufhoben: solange eine Einheiten-Rueckgabe faelschlich als
  // GANZZAHL galt, passte die falsche Rueckgabe zur falschen Erwartung. Mit
  // der berichtigten Reihenfolge oben passt sie nicht mehr — der Fix hat den
  // Fehler nicht erzeugt, sondern aufgedeckt.
  // Umgewandelt wird nur, wenn der Ausdruck NACHWEISLICH eine Ganzzahl ist —
  // nicht schon dann, wenn cg_isF64Expr ihn nicht als f64 erkennt.
  //
  // Die Unterscheidung ist tragend. cg_isF64Expr ist eine Aufzaehlung, und
  // Aufzaehlungen sind in diesem Modul mehrfach unvollstaendig gewesen (#1787,
  // #1806, #1812, zuletzt #1956). Ein "nein" von ihr heisst deshalb "nicht
  // erkannt", nicht "ist keine". Wer daraufhin umwandelt, zerstoert jeden
  // Wert, den sie nicht kennt.
  //
  // Genau das ist beim ersten Anlauf passiert: `FloorF64` gibt `fFloor(x)`
  // zurueck, und `fFloor` steht nicht in der Liste der eingebauten
  // Gleitkommaquellen (dort stehen nur fAdd, fSub, fMul, fDiv, fNeg, fAbs,
  // sqrt). Der Rueckgabewert bekam eine cvtsi2sd auf sein Bitmuster, und weil
  // FloorF64 in der Argumentreduktion von SinF64 sitzt, lieferte der Sinus
  // ausserhalb von 2pi `inf` — 550 Ausreisser in stdlib_z20_test.
  //
  // Der Zweifel muss also zur sicheren Seite fallen: keine Umwandlung.
  // Erfasst werden das Ganzzahlliteral und jeder Ausdruck, den cg_tryFold zu
  // einer ganzzahligen Konstanten zusammenrechnet — `return 2500;` und
  // `return 2500 * 2;`. Das deckt den gemeldeten Fall (#2007) ab und laesst
  // alles Unsichere unberuehrt.
  fn cg_retToF64(expr: int64) {
    if (self.fnRetIsFloat == 0) { return; }
    if (self.cg_istSicherGanz(expr) == 0) { return; }
    self.cg_emitRaxIntToF64();
  }

  // #2160: dieselbe Abgrenzung fuer die Zuweisung an ein Gleitkommaziel —
  // Literal oder ganzzahlig faltbar, und nicht als f64 erkannt. Die IR-Seite
  // (_nachGleit) muss uebereinstimmen.
  fn cg_istSicherGanz(expr: int64): int64 {
    if (expr < 0) { return 0; }
    if (self.cg_isF64Expr(expr) != 0) { return 0; }   // liegt schon als f64 vor
    if (self.cg_nkind(expr) == CGN_LIT_INT) { return 1; }
    if (self.cg_tryFold(expr) != 0) { return 1; }
    return 0;
  }

  fn cg_emitRaxIntToF64() {
    self.cg_e8(0xF2); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x2A); self.cg_e8(0xC0); // cvtsi2sd xmm0, rax
    self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC0); // movq rax, xmm0
  }

  // #1212: dasselbe fuer rbx (die linke Seite liegt dort, siehe cg_popRbx).
  fn cg_emitRbxIntToF64() {
    self.cg_e8(0xF2); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x2A); self.cg_e8(0xC3); // cvtsi2sd xmm0, rbx
    self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC3); // movq rbx, xmm0
  }

  // #1212: Gemischte Arithmetik. Ist EINE Seite f64, wurde bisher einfach die
  // f64-Operation emittiert — die ganzzahlige Seite ging dabei als Bitmuster
  // eines double in die Rechnung. `10 - 2.5` ergab -1.75, `2.5 + 10` ergab
  // 2.5, `7.0 / 2` ergab 0.0: stille Falschrechnung in jeder Formel, die
  // beide Arten mischt. Die ganzzahlige Seite wird jetzt gewandelt.
  //
  // Aufzurufen NACH `cg_popRbx` (lhs in rbx, rhs in rax) und VOR
  // cg_emitF64BinOp.
  fn cg_emitMixedToF64(lhsNi: int64, rhsNi: int64) {
    var lF: int64 := self.cg_isF64Expr(lhsNi);
    var rF: int64 := self.cg_isF64Expr(rhsNi);
    if (lF != 0 && rF == 0) { self.cg_emitRaxIntToF64(); }
    if (rF != 0 && lF == 0) { self.cg_emitRbxIntToF64(); }
  }

  // Operator overloading: the method name a binary operator maps to, or 0 if the
  // operator has no overload. + Add, - Sub, * Mul, / Div, % Mod, == Eq, != Ne,
  // < Lt, <= Le, > Gt, >= Ge. (Index [] → Get is handled on CGN_INDEX.)
  fn cg_opMethodName(op: int64): pchar {
    if (op == CGT_PLUS)    { return "Add"; }
    if (op == CGT_MINUS)   { return "Sub"; }
    if (op == CGT_STAR)    { return "Mul"; }
    if (op == CGT_SLASH)   { return "Div"; }
    if (op == CGT_PERCENT) { return "Mod"; }
    if (op == CGT_EQ2)     { return "Eq"; }
    if (op == CGT_NEQ)     { return "Ne"; }
    if (op == CGT_LT)      { return "Lt"; }
    if (op == CGT_LE)      { return "Le"; }
    if (op == CGT_GT)      { return "Gt"; }
    if (op == CGT_GE)      { return "Ge"; }
    return 0 as pchar;
  }

  // Operator overloading: the class-layout index of an expression's static type,
  // or -1 if it isn't a class-typed expression. Handles identifiers (declared
  // type from localTypes) and — so chained expressions like `(a+b)+c` work — an
  // arithmetic operator overload, whose result class is its left operand's class
  // (the Vec+Vec→Vec convention). Comparison overloads yield bool, not a class.
  fn cg_exprClassName(ni: int64): int64 {
    if (ni < 0) { return 0 - 1; }
    var k: int64 := self.cg_nkind(ni);
    // #1588: derselbe Fall wie in cg_objClassIdx — hier haengt der
    // METHODENAUFRUF daran. Ohne diesen Zweig wurde `(a as Basis).Zeige()`
    // ungemangelt emittiert und scheiterte mit "undefined function 'Zeige'".
    if (k == CGN_CAST) {
      var ecT: int64 := self.cg_nc1(ni);
      if (ecT < 0) { return 0 - 1; }
      return self.cg_findClass(self.cg_nsval(ecT), self.cg_nslen(ecT));
    }
    if (k == CGN_IDENT) {
      var idx: int64 := self.cg_findLocalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if (idx >= 0) {
        var tb: int64 := self.localTypes + idx * CG_LOCTYPE_SZ;
        var cln: pchar := peek64(tb) as pchar;
        var clnLen: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
        if (cln == 0 as pchar || clnLen <= 0) { return 0 - 1; }
        return self.cg_findClass(cln, clnLen);
      }
      // #1631: Kein Local dieses Namens — dann kann es eine GLOBALE Variable
      // sein. Ihr Typname steht seit #1094 in globalTypeNames; hier wurde er
      // nie gelesen, und damit blieb der Klassenindex -1. Ein verketteter
      // Aufruf `g.Item(0).SetS(...)` fand deshalb keinen Empfaengertyp und
      // brach mit "no codegen implementation found" ab — dieselbe Zeile mit
      // einer lokalen Variablen uebersetzte. Dieselbe Auskunft holt sich der
      // Schreibpfad seit #1256 an genau dieser Stelle.
      var gidxC: int64 := self.cg_findGlobalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if (gidxC >= 0) {
        var gpC: pchar := peek64(self.globalTypeNames + gidxC * 16) as pchar;
        var glC: int64 := peek64(self.globalTypeNames + gidxC * 16 + 8);
        if (gpC != 0 as pchar && glC > 0) { return self.cg_findClass(gpC, glC); }
      }
      return 0 - 1;
    }
    if (k == CGN_BINOP) {
      var bop: int64 := self.cg_nival(ni);
      if (bop == CGT_PLUS || bop == CGT_MINUS || bop == CGT_STAR ||
          bop == CGT_SLASH || bop == CGT_PERCENT) {
        return self.cg_exprClassName(self.cg_nc0(ni));
      }
      return 0 - 1;
    }
    if (k == CGN_CALL) {
      // Free function whose return type is a class, e.g. `StringFromPchar(..) + ..`.
      if (self.cg_nival(ni) == 0) {
        return self.cg_funcRetClassIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      }
      // Method call `obj.M()`: resolve the receiver's class, then look up the
      // mangled "ReceiverClass_M" in the return-type registry.
      // #1712: Ein GENERISCHER Aufruf traegt iVal == 2. Sein c0 ist die
      // Argumentliste, nicht ein Empfaenger — er gehoert also auf denselben
      // Weg wie der gewoehnliche Aufruf, ueber den Funktionsnamen. Ohne
      // diesen Zweig fiel er bis zum Rueckfall am Ende durch, und der
      // schickte ihn an cg_objClassIdx, das fuer einen CGN_CALL sofort
      // wieder hierher zurueckkam: eine wechselseitige Endlosrekursion aus
      // zwei Endaufrufen, also mit gleichbleibendem Stapel und ohne
      // Speicherwachstum. Der Compiler drehte sich still fest, statt zu
      // scheitern.
      if (self.cg_nival(ni) == 2) {
        // #2134: unter dem Namen der Spezialisierung (cg_callName).
        var gcLc: int64 := alloc(8);
        var gcP: pchar := self.cg_callName(ni, gcLc);
        var gcL: int64 := peek64(gcLc);
        free(gcLc, 8);
        return self.cg_funcRetClassIdx(gcP, gcL);
      }
      if (self.cg_nival(ni) == 1) {
        var recvCi: int64 := self.cg_exprClassName(self.cg_nc0(ni));
        if (recvCi < 0) { return 0 - 1; }
        // #1621: auch hier die Vererbungskette hoch — die Registry kennt die
        // Methode unter der Klasse, die sie deklariert.
        var lc: int64 := alloc(8);
        var res: int64 := 0 - 1;
        var rc: int64 := recvCi;
        var rt: int64 := 0;
        while (rc >= 0 && rt < 32 && res < 0) {
          var mb: int64 := self.cg_buildMethodMangled(rc, self.cg_nsval(ni), self.cg_nslen(ni), lc);
          var mbLen: int64 := peek64(lc);
          res := self.cg_funcRetClassIdx(mb as pchar, mbLen);
          self.cg_trackTempBuf(mb, mbLen + 1);
          rc := peek64(self.classLayouts + rc * CG_CLASS_SZ + CG_CLASS_OFF_PARENTIDX);
          rt := rt + 1;
        }
        free(lc, 8);
        return res;
      }
      // #1712: jede andere Aufrufart endet hier. Der Rueckfall unten gilt
      // ausdruecklich NICHT fuer CGN_CALL — er ruft fuer diesen Knoten
      // wieder diese Funktion auf.
      return 0 - 1;
    }
    // #1694: Bis hierher kennt diese Auskunft nur Cast, Ident und Aufruf —
    // einen FELDAUSDRUCK als Empfaenger nicht. `cg_objClassIdx` kennt ihn
    // laengst (Feld, Index, verketteter Aufruf), und der Dispatch benutzt
    // genau die. Zwei Stellen beantworteten damit dieselbe Frage
    // unterschiedlich, und das war teuer:
    //
    // `cg_callRetStructBytes` entscheidet hierueber, ob ein Aufruf das
    // verdeckte erste Argument mitgibt. Bei `h.Feld.Methode()` fiel die
    // Auskunft auf -1, die Aufrufstelle gab also KEINEN Zeiger mit — waehrend
    // der Gerufene einen erwartete und in rdi den EMPFAENGER vorfand. Er
    // schrieb sein Ergebnis damit ueber das Objekt: aus `Kennung=4242` wurde
    // der Inhalt des Structs. Der Absturz kam erst beim naechsten Zugriff,
    // weshalb es nach "jeder zweite Aufruf" aussah.
    //
    // Deshalb hier der Rueckfall auf dieselbe Quelle, die der Dispatch
    // benutzt, statt die Faelle ein zweites Mal aufzuzaehlen.
    return self.cg_objClassIdx(ni);
  }

  // Build "ClassName_Method" from raw name+length pairs (neither need be NUL-
  // terminated) into a fresh tracked buffer; returns the buffer (NUL-terminated)
  // and writes its length to `lenCell`.
  fn cg_mangleInto(cln: pchar, clnLen: int64, mname: pchar, mlen: int64, lenCell: int64): int64 {
    var mangLen: int64 := clnLen + 1 + mlen;
    var mangBuf: int64 := alloc(mangLen + 1);
    var ci2: int64 := 0;
    while (ci2 < clnLen) { poke8(mangBuf + ci2, StrCharAt(cln, ci2)); ci2 := ci2 + 1; }
    poke8(mangBuf + clnLen, 95);   // '_'
    var cj: int64 := 0;
    while (cj < mlen) { poke8(mangBuf + clnLen + 1 + cj, StrCharAt(mname, cj)); cj := cj + 1; }
    poke8(mangBuf + mangLen, 0);
    poke64(lenCell, mangLen);
    return mangBuf;
  }

  // Build the mangled method name "ClassName_Method" for class-layout index `ci`.
  fn cg_buildMethodMangled(ci: int64, mname: pchar, mlen: int64, lenCell: int64): int64 {
    var cbase: int64 := self.classLayouts + ci * CG_CLASS_SZ;
    var cln: pchar := peek64(cbase) as pchar;
    var clnLen: int64 := peek64(cbase + CG_CLASS_OFF_NAMELEN);
    return self.cg_mangleInto(cln, clnLen, mname, mlen, lenCell);
  }

  // #1624: Der gemangelte Name der Methode, die fuer diese Klasse WIRKLICH
  // gilt — die eigene oder die der naechsten Basisklasse, die sie definiert.
  // `Create` und `Destroy` wurden nur unter dem eigenen Klassennamen gesucht;
  // fehlte das Label, unterblieb der Aufruf stillschweigend. Genau das machte
  // eine Ableitung ohne eigenen Konstruktor zu einem Objekt aus lauter Nullen.
  //
  // Liefert den Puffer (Aufrufer gibt ihn frei bzw. haengt ihn an einen Patch)
  // und die Laenge in lenCell, oder 0, wenn keine Klasse der Kette sie hat.
  fn cg_findInheritedMangled(ci: int64, mname: pchar, mlen: int64, lenCell: int64): int64 {
    var cur: int64 := ci;
    var tiefe: int64 := 0;
    while (cur >= 0 && tiefe < 32) {
      var buf: int64 := self.cg_buildMethodMangled(cur, mname, mlen, lenCell);
      var bl: int64 := peek64(lenCell);
      if (self.cg_findLabel(buf as pchar, bl) >= 0) { return buf; }
      free(buf, bl + 1);
      cur := peek64(self.classLayouts + cur * CG_CLASS_SZ + CG_CLASS_OFF_PARENTIDX);
      tiefe := tiefe + 1;
    }
    poke64(lenCell, 0);
    return 0;
  }

  // Emit a direct 1-arg method call `recv.Method(arg)`: receiver→rdi (self),
  // arg→rsi, call the (already-built, defined) mangled name. Result in rax.
  fn cg_emitClassCall(recvNi: int64, argNi: int64, mangBuf: int64, mangLen: int64) {
    self.cg_genExpr(recvNi);
    self.cg_pushRax();
    self.cg_genExpr(argNi);
    self.cg_pushRax();
    self.cg_popRsi();   // arg  → rsi
    self.cg_popRdi();   // self → rdi
    var pp: int64 := self.cg_emitCall();
    self.cg_addPatch(pp, mangBuf, mangLen, CG_PATCH_CALL);
    self.cg_trackTempBuf(mangBuf, mangLen + 1);
  }

  // Operator overloading: if the binop `ni` has a class-typed left operand and
  // that class defines the operator's method, emit `lhs.Method(rhs)` and return
  // 1. Otherwise emit nothing and return 0 (normal integer/f64/pchar path).
  // Logical NOT of rax (0 → 1, non-zero → 0). Used for the != → !Eq fallback.
  fn cg_emitLogicalNot() {
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
    self.cg_e8(0x0F); self.cg_e8(0x94); self.cg_e8(0xC0);   // sete al
    self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);  // movzx rax, al
  }

  fn cg_tryClassBinop(ni: int64): int64 {
    var op: int64 := self.cg_nival(ni);
    var mname: pchar := self.cg_opMethodName(op);
    if (mname == 0 as pchar) { return 0; }
    var lhsNi: int64 := self.cg_nc0(ni);
    var ci: int64 := self.cg_exprClassName(lhsNi);
    if (ci < 0) { return 0; }
    // #2060: die Methode darf aus einer BASISKLASSE stammen. Hier stand
    // cg_buildMethodMangled + cg_findLabel — gesucht wurde nur in der Klasse
    // selbst. Eine Ableitung ohne eigenes `Add` behielt damit die eingebaute
    // Bedeutung von `+`: zwei Objektadressen wurden addiert und das Ergebnis
    // als Objekt benutzt. Der IR-Weg loest ueber _resolveMethodIdx auf, das
    // die Kette mitlaeuft; die beiden muessen uebereinstimmen.
    var lenCell: int64 := alloc(8);
    var mangBuf: int64 := self.cg_findInheritedMangled(ci, mname, StrLen(mname), lenCell);
    var mangLen: int64 := peek64(lenCell);
    free(lenCell, 8);
    if (mangBuf != 0) {
      self.cg_emitClassCall(lhsNi, self.cg_nc1(ni), mangBuf, mangLen);
      return 1;
    }
    // != fallback: a class that defines Eq but not Ne still gets `!=` as !(Eq).
    if (op == CGT_NEQ) {
      var lc2: int64 := alloc(8);
      var eqBuf: int64 := self.cg_findInheritedMangled(ci, "Eq", 2, lc2);
      var eqLen: int64 := peek64(lc2);
      free(lc2, 8);
      if (eqBuf != 0) {
        self.cg_emitClassCall(lhsNi, self.cg_nc1(ni), eqBuf, eqLen);
        self.cg_emitLogicalNot();
        return 1;
      }
    }
    return 0;
  }

  // Operator overloading: if `ni` is `base[idx]` with a class-typed base that
  // defines Get, emit `base.Get(idx)` and return 1; otherwise return 0.
  fn cg_tryClassIndex(ni: int64): int64 {
    var baseNi: int64 := self.cg_nc0(ni);
    // #1109: Ein ARRAY von Klassenwerten ist kein Klassenobjekt. Seit der
    // Elementtyp am Local vermerkt wird, faende cg_exprClassName hier die
    // Klasse des ELEMENTS — und `cs[1]` wuerde zu `cs.Get(1)`, mit der
    // Array-Basis als Empfaenger. Der Index-Operator gehoert nur einer
    // Variablen, die selbst ein Klassenobjekt IST.
    if (self.cg_nkind(baseNi) == CGN_IDENT) {
      var abIdx: int64 := self.cg_findLocalIdx(self.cg_nsval(baseNi), self.cg_nslen(baseNi));
      if (abIdx >= 0 && peek8(self.localIsArray + abIdx) != 0) { return 0; }
    }
    var ci: int64 := self.cg_exprClassName(baseNi);
    if (ci < 0) { return 0; }
    var lenCell: int64 := alloc(8);
    var mangBuf: int64 := self.cg_findInheritedMangled(ci, "Get", 3, lenCell);   // #2060: auch geerbt
    var mangLen: int64 := peek64(lenCell);
    free(lenCell, 8);
    if (mangBuf == 0) { return 0; }
    self.cg_emitClassCall(baseNi, self.cg_nc1(ni), mangBuf, mangLen);
    return 1;
  }

  // f64 binary op: rbx=lhs IEEE-754 bits, rax=rhs IEEE-754 bits. Result in rax.
  fn cg_emitF64BinOp(op: int64) {
    // movq xmm0, rbx  (lhs)
    self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x6E); self.cg_e8(0xC3);
    // movq xmm1, rax  (rhs)
    self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x6E); self.cg_e8(0xC8);
    if op == CGT_PLUS {
      self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x58); self.cg_e8(0xC1);  // addsd xmm0, xmm1
    } else if op == CGT_MINUS {
      self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x5C); self.cg_e8(0xC1);  // subsd xmm0, xmm1
    } else if op == CGT_STAR {
      self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x59); self.cg_e8(0xC1);  // mulsd xmm0, xmm1
    } else if op == CGT_SLASH {
      self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x5E); self.cg_e8(0xC1);  // divsd xmm0, xmm1
    } else if op == CGT_GT || op == CGT_LT || op == CGT_EQ2 ||
              op == CGT_NEQ || op == CGT_GE || op == CGT_LE {
      // #1128: `ucomisd` setzt bei einem NaN-Operanden ZF=1, PF=1 UND CF=1
      // ("unordered"). Nur `seta`/`setae` sind darauf schon richtig — beide
      // verlangen CF=0 und liefern deshalb false. `sete`, `setb` und `setbe`
      // lasen dagegen bloss ZF bzw. CF und meldeten wahr; damit war `NaN == NaN`
      // wahr und `x != x` — das verbreitete NaN-Idiom — immer falsch.
      //
      // Deshalb: `<` und `<=` werden mit VERTAUSCHTEN Operanden als `>`/`>=`
      // gerechnet, und Gleichheit prueft zusaetzlich das Paritaetsflag.
      if op == CGT_LT || op == CGT_LE {
        // ucomisd xmm1, xmm0 — Operanden getauscht (66 0F 2E C8)
        self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x2E); self.cg_e8(0xC8);
        if op == CGT_LT { self.cg_e8(0x0F); self.cg_e8(0x97); self.cg_e8(0xC0); }  // seta  al
        else            { self.cg_e8(0x0F); self.cg_e8(0x93); self.cg_e8(0xC0); }  // setae al
        self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);    // movzx rax, al
        return;
      }
      // ucomisd xmm0, xmm1  (66 0F 2E C1)
      self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x2E); self.cg_e8(0xC1);
      if op == CGT_GT  { self.cg_e8(0x0F); self.cg_e8(0x97); self.cg_e8(0xC0); }  // seta  al
      if op == CGT_GE  { self.cg_e8(0x0F); self.cg_e8(0x93); self.cg_e8(0xC0); }  // setae al
      if op == CGT_EQ2 {
        self.cg_e8(0x0F); self.cg_e8(0x94); self.cg_e8(0xC0);   // sete  al  (ZF=1)
        self.cg_e8(0x0F); self.cg_e8(0x9B); self.cg_e8(0xC3);   // setnp bl  (PF=0, also geordnet)
        self.cg_e8(0x20); self.cg_e8(0xD8);                     // and   al, bl
      }
      if op == CGT_NEQ {
        self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC0);   // setne al  (ZF=0)
        self.cg_e8(0x0F); self.cg_e8(0x9A); self.cg_e8(0xC3);   // setp  bl  (PF=1, also unordered)
        self.cg_e8(0x08); self.cg_e8(0xD8);                     // or    al, bl
      }
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);     // movzx rax, al
      return;
    } else {
      self.cg_zeroRax();
      return;
    }
    // movq rax, xmm0  — result back to GP
    self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC0);
  }

  // WP-GPU-01: Emit inline SSE2 packed-f32 loop.
  // Convention: rdi=src1, rsi=src2, rdx=dst, rcx=element count.
  // Result: rax = dst ptr. Clobbers: rax, rcx, xmm0, xmm1.
  // #2206: Darf die Vektorarena am Ende eines Schleifendurchlaufs auf die
  // Marke zurueckgesetzt werden?
  //
  // Zurueckgesetzt wird nur, wenn im Rumpf kein Vektor ENTKOMMEN kann. Die
  // Pruefung ist bewusst konservativ und rein syntaktisch — eine
  // Lebendigkeitsanalyse gibt es hier nicht, und eine falsche Zusage waere
  // Speicherkorruption statt eines Lecks. Unsicher ist ein Rumpf, der
  //
  //   * ein `return` enthaelt (der Wert verlaesst die Funktion),
  //   * einen Vektor an etwas ZUWEIST, das schon existiert (`c := a + b` auf
  //     ein aeusseres `c`; ein `var c := a + b` IM Rumpf ist dagegen frisch
  //     und verschwindet mit ihm),
  //   * einen Vektor als ARGUMENT weitergibt (die gerufene Funktion kann ihn
  //     ablegen, und was sie tut, steht hier nicht).
  //
  // Alles andere bleibt im Rumpf und darf verfallen. Rueckgabe: 1 = es kann
  // etwas entkommen, also NICHT zuruecksetzen.
  // #2206: Legt dieser Rumpf ueberhaupt eine Vektorablage an?
  //
  // Ohne diese Frage bekam JEDE Schleife eine Marke — samt der Belegung, die
  // einen Block erzwingt, also samt mmap im langsamen Zweig. Gemessen:
  // tests/image_freestanding_test.sh meldete fuer png_mem 81 Syscalls statt
  // 12, und der Befehlsbereich der Benchmark-Erzeugnisse wuchs von 91 auf
  // 132 KiB. Eine Vorkehrung fuer Vektoren darf Programme ohne Vektoren
  // nicht anfassen.
  //
  // Angelegt wird bei `parallel Array<T>(n)` und bei jeder Verknuepfung, die
  // eine neue Ablage liefert (`a + b` auf zwei Vektoren, `-a`).
  fn cg_vecRumpfLegtAn(ni: int64, tiefe: int64): int64 {
    if (ni < 0) { return 0; }
    if (tiefe > 64) { return 0; }
    var cur: int64 := ni;
    while (cur >= 0) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_SIMD_NEW) { return 1; }
      if (k == CGN_BINOP || k == CGN_UNOP) {
        if (self.cg_istSimdAusdruck(cur) != 0) { return 1; }
      }
      if (self.cg_vecRumpfLegtAn(self.cg_nc0(cur), tiefe + 1) != 0) { return 1; }
      if (self.cg_vecRumpfLegtAn(self.cg_nc1(cur), tiefe + 1) != 0) { return 1; }
      if (self.cg_vecRumpfLegtAn(self.cg_nc2(cur), tiefe + 1) != 0) { return 1; }
      if (self.cg_vecRumpfLegtAn(self.cg_nc3(cur), tiefe + 1) != 0) { return 1; }
      cur := self.cg_nnext(cur);
    }
    return 0;
  }

  // Wie cg_vecEntkommtRumpf: NICHT dem next des Rumpfknotens folgen, sonst
  // zaehlt der Code HINTER der Schleife mit.
  fn cg_vecRumpfLegtAnRumpf(body: int64): int64 {
    if (body < 0) { return 0; }
    if (self.cg_vecRumpfLegtAn(self.cg_nc0(body), 0) != 0) { return 1; }
    if (self.cg_vecRumpfLegtAn(self.cg_nc1(body), 0) != 0) { return 1; }
    if (self.cg_vecRumpfLegtAn(self.cg_nc2(body), 0) != 0) { return 1; }
    return self.cg_vecRumpfLegtAn(self.cg_nc3(body), 0);
  }

  // #2206: Einstieg fuer einen SCHLEIFENRUMPF. Wichtig: NICHT cg_vecEntkommt
  // mit dem Rumpfknoten selbst aufrufen — der haengt in der Anweisungsliste
  // seines Blocks, und `cg_nnext` fuehrt damit aus dem Rumpf HERAUS. Genau
  // das hatte die erste Fassung getan: sie sah `PrintLn(r)` und `return 0`
  // HINTER der Schleife, meldete "entkommt" und setzte nie zurueck. Gemessen
  // wuchs der Speicher weiter, als gaebe es die Marke nicht; sichtbar wurde
  // es erst, als ein `ud2` im Ruecksetz-Code nicht ausloeste — der Code war
  // gar nicht erzeugt worden.
  fn cg_vecEntkommtRumpf(body: int64): int64 {
    if (body < 0) { return 1; }
    if (self.cg_vecEntkommt(self.cg_nc0(body), 0) != 0) { return 1; }
    if (self.cg_vecEntkommt(self.cg_nc1(body), 0) != 0) { return 1; }
    if (self.cg_vecEntkommt(self.cg_nc2(body), 0) != 0) { return 1; }
    return self.cg_vecEntkommt(self.cg_nc3(body), 0);
  }

  fn cg_vecEntkommt(ni: int64, tiefe: int64): int64 {
    if (ni < 0) { return 0; }
    if (tiefe > 64) { return 1; }   // zu tief, um es zu ueberblicken → vorsichtig
    var cur: int64 := ni;
    while (cur >= 0) {
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_RETURN) { return 1; }
      if (k == CGN_ASSIGN) {
        if (self.cg_istSimdAusdruck(self.cg_nc1(cur)) != 0) { return 1; }
      }
      if (k == CGN_CALL) {
        var a: int64 := self.cg_nc1(cur);
        while (a >= 0) {
          if (self.cg_istSimdAusdruck(a) != 0) { return 1; }
          a := self.cg_nnext(a);
        }
      }
      if (self.cg_vecEntkommt(self.cg_nc0(cur), tiefe + 1) != 0) { return 1; }
      if (self.cg_vecEntkommt(self.cg_nc1(cur), tiefe + 1) != 0) { return 1; }
      if (self.cg_vecEntkommt(self.cg_nc2(cur), tiefe + 1) != 0) { return 1; }
      if (self.cg_vecEntkommt(self.cg_nc3(cur), tiefe + 1) != 0) { return 1; }
      cur := self.cg_nnext(cur);
    }
    return 0;
  }

  // #2206: Traegt dieser Ausdruck eine Vektorablage? Geprueft wird der
  // einfache, haeufige Fall — ein Bezeichner, der als `parallel` angelegt
  // wurde, und eine Verknuepfung zweier solcher. Bei allem anderen wird
  // VORSICHTSHALBER 1 geliefert, wo es um das Entkommen geht: lieber eine
  // Arena, die nicht zuruecksetzt, als eine, die zu frueh zuruecksetzt.
  fn cg_istSimdAusdruck(ni: int64): int64 {
    if (ni < 0) { return 0; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_IDENT) {
      var li: int64 := self.cg_findLocalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if (li >= 0 && peek8(self.localIsSimd + li) != 0) { return 1; }
      return 0;
    }
    if (k == CGN_SIMD_NEW) { return 1; }
    if (k == CGN_BINOP) {
      if (self.cg_istSimdAusdruck(self.cg_nc0(ni)) != 0) { return 1; }
      return self.cg_istSimdAusdruck(self.cg_nc1(ni));
    }
    if (k == CGN_UNOP) { return self.cg_istSimdAusdruck(self.cg_nc0(ni)); }
    return 0;
  }

  // #2206: Marke der Vektorarena in einen Rahmenplatz sichern. Rueckgabe:
  // der Platz, oder -1, wenn nicht gesichert wurde.
  // Gesichert werden BEIDE Zeiger, nicht nur PTR. Mit PTR allein waere der
  // Fehler eingebaut: holt der Rumpf einen neuen Block, zeigt END hinter
  // dessen Ende, waehrend die Marke in den ALTEN Block zeigt. Nach dem
  // Zuruecksetzen glaubte der Allokator, ab der alten Stelle bis zum neuen
  // Ende Platz zu haben — er gaebe Speicher aus einem Block heraus, der dort
  // laengst zu Ende ist. PTR und END gehoeren immer zum selben Block.
  // Rueckgabe ist der Platz der PTR-Marke; der END-Platz liegt in
  // self.vecMarkeEnde. Die beiden Plaetze werden EINZELN erfragt und nicht
  // aus einer angenommenen Schrittweite gerechnet — cg_addLocal liefert
  // -frameSize, und wie weit der zwischen zwei Aufrufen waechst, ist nicht
  // Sache dieser Funktion.
  fn cg_vecMarkeSetzen(): int64 {
    // #2206: ERST einen Block erzwingen, DANN die Marke nehmen.
    //
    // Ohne das stand hier der Fehler, den die Messung gezeigt hat: vor der
    // ersten Belegung sind PTR und END beide 0, die Marke haelt also "Arena
    // leer". Jeder Durchlauf setzte darauf zurueck, und die naechste Belegung
    // fand eine leere Arena vor und holte sich einen neuen Block — ein mmap
    // je Durchlauf, genau wie vorher. Gemessen blieben die Seitenfehler bei
    // 80345 statt zu fallen.
    //
    // Eine Belegung von einem Byte legt den Block an; die Marke zeigt danach
    // in einen Block, der auch beim Zuruecksetzen noch gilt.
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC6); self.cg_e32(1);   // mov rsi, 1
    self.cg_emitBumpAtomarIn(0, 0, CG_VEC_PTR, CG_VEC_END, 1048576);
    var slotPtr: int64 := self.cg_addLocal("__lyx_vecmarke"c, 14);
    var slotEnd: int64 := self.cg_addLocal("__lyx_vecende"c, 13);
    self.vecMarkeEnde := slotEnd;
    // Geschrieben wird DIREKT ueber rbp, nicht ueber cg_storeRax. Der
    // Registerzuteiler (#2114) bildet Rahmenplaetze auf r12..r15 ab; er hat
    // diese Funktion aber beim Start der Funktion verteilt, als es die zwei
    // Plaetze hier noch nicht gab. Ueber cg_storeRax landete die Marke
    // deshalb in einem Register, das der Rumpf fuer eine ANDERE Variable
    // benutzt — zurueckgelesen wurde Unsinn, der Allokator fand eine
    // unbrauchbare Arena vor und holte jedes Mal einen neuen Block. Gemessen:
    // der Speicher wuchs weiter linear, als gaebe es die Marke nicht.
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05); self.cg_bumpRip(CG_VEC_PTR);  // mov rax, [VEC_PTR]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(slotPtr);         // mov [rbp+slotPtr], rax
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05); self.cg_bumpRip(CG_VEC_END);  // mov rax, [VEC_END]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(slotEnd);         // mov [rbp+slotEnd], rax
    // #2253: Bedarfszaehler mitsichern (Begruendung bei cg_vecMarkeZurueck).
    var slotSum: int64 := self.cg_addLocal("__lyx_vecsumme"c, 14);
    self.vecMarkeSumme := slotSum;
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05); self.cg_bumpRip(CG_VEC_SUM);  // mov rax, [VEC_SUM]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(slotSum);         // mov [rbp+slotSum], rax
    return slotPtr;
  }

  // #2206: Arena auf die gesicherte Marke zuruecksetzen. Damit benutzt der
  // naechste Durchlauf DIESELBEN Seiten wieder — der gemessene Aufwand lag
  // nicht im mmap, sondern in 86696 Seitenfehlern auf immer frischem
  // Speicher (gegen 94 bei der C-Fassung).
  // `slot` ist ein RAHMENABSTAND und damit NEGATIV (cg_addLocal liefert
  // -frameSize). Die erste Fassung pruefte hier `slot < 0` als "keine Marke
  // gesetzt" — und wuergte sich damit immer selbst ab: das Zuruecksetzen
  // wurde nie emittiert, der Speicher wuchs weiter linear, und die
  // Markierung davor lief ins Leere. Gefunden mit einem `ud2` an dieser
  // Stelle: es landete nicht einmal im Erzeugnis.
  //
  // Als "keine Marke" gilt deshalb 1 — ein positiver Wert kann kein
  // Rahmenabstand sein.
  fn cg_vecMarkeZurueck(slot: int64) {
    if (slot > 0) { return; }
    // #2253: Hat der letzte Durchlauf einen NEUEN Block geholt (END weicht von
    // der Marke ab), passt sein Bedarf nicht in den Rest des Markenblocks.
    // Bis 1.2.20F sprang das Zuruecksetzen trotzdem dorthin zurueck: jeder
    // Durchlauf holte erneut einen Block, der alte blieb liegen — gemessen
    // bei 131072 f32-Elementen ein mmap je Wiederholung, 77 662 Seitenfehler,
    // 310 MB nach 600 Wiederholungen. Jetzt wird EINMAL ein Block geholt, der
    // den ganzen Bedarf eines Durchlaufs fasst (CG_VEC_SUM seit der Marke,
    // auf Seiten aufgerundet), und die Marke rueckt dorthin. Ab dem naechsten
    // Durchlauf liegt alles in diesem Block.
    //
    // Der Bedarf ist der eines Durchlaufs, auch mit inneren Schleifen: deren
    // Zuruecksetzen stellt CG_VEC_SUM auf ihre eigene Marke zurueck, es zaehlt
    // also nur ihr letzter Durchlauf mit — genau ihr Spitzenbedarf.
    //
    // Hier, am Schleifenkopf, ist kein Ausdruck in Arbeit; rax/rcx/rdx/rsi/
    // rdi/r8-r11 sind frei (r12-r15 der Registerzuteilung bleiben unberuehrt).
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05); self.cg_bumpRip(CG_VEC_END);   // mov rax, [VEC_END]
    self.cg_e8(0x48); self.cg_e8(0x3B); self.cg_e8(0x85); self.cg_e32(self.vecMarkeEnde); // cmp rax, [rbp+ende]
    self.cg_e8(0x0F); self.cg_e8(0x84); var pGleich: int64 := self.codeLen; self.cg_e32(0);  // je gleich
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x35); self.cg_bumpRip(CG_VEC_SUM);   // mov rsi, [VEC_SUM]
    self.cg_e8(0x48); self.cg_e8(0x2B); self.cg_e8(0xB5); self.cg_e32(self.vecMarkeSumme); // sub rsi, [rbp+summe]
    self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xC6); self.cg_e32(4095);              // add rsi, 4095
    self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xE6); self.cg_e32(0 - 4096);          // and rsi, -4096
    self.cg_e8(0x56);                                                                      // push rsi (Groesse)
    self.cg_e8(0x31); self.cg_e8(0xFF);                                                    // xor edi, edi
    self.cg_e8(0xBA); self.cg_e32(3);                                                      // mov edx, 3
    self.cg_e8(0x41); self.cg_e8(0xBA); self.cg_e32(34);                                   // mov r10d, 34
    self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e32(0 - 1);              // mov r8, -1
    self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);                                  // xor r9, r9
    self.cg_e8(0xB8); self.cg_e32(9);                                                      // mov eax, 9
    self.cg_e8(0x0F); self.cg_e8(0x05);                                                    // syscall
    self.cg_emitMmapGeprueft();                                                            // #2144
    self.cg_e8(0x5E);                                                                      // pop rsi
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(slot);               // mov [rbp+marke], rax
    self.cg_e8(0x48); self.cg_e8(0x01); self.cg_e8(0xF0);                                  // add rax, rsi
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x85); self.cg_e32(self.vecMarkeEnde);  // mov [rbp+ende], rax
    poke32(self.code + pGleich, self.codeLen - pGleich - 4);
    // gleich: Zaehler auf den Stand der Marke
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x85); self.cg_e32(self.vecMarkeSumme); // mov rax, [rbp+summe]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05); self.cg_bumpRip(CG_VEC_SUM);   // mov [VEC_SUM], rax
    // Reihenfolge: zuerst END, dann PTR. Dazwischen darf kein anderer Faden
    // belegen — END = 1 waere die Sperre des Allokators, und die wird hier
    // nicht genommen. Fuer einen Rumpf, der selbst keine Faden startet, ist
    // das in Ordnung; nebenlaeufige Nutzung derselben Arena ist es nicht.
    // Siehe #2206: die Marke gilt nur fuer Rumpfe, aus denen nichts entkommt.
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x85); self.cg_e32(self.vecMarkeEnde);  // mov rax, [rbp+ende]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05); self.cg_bumpRip(CG_VEC_END);      // mov [VEC_END], rax
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x85); self.cg_e32(slot);                // mov rax, [rbp+marke]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x05); self.cg_bumpRip(CG_VEC_PTR);      // mov [VEC_PTR], rax
  }

  // #2206: Vektorablage aus dem BUMP-ALLOKATOR, nicht per eigenem mmap.
  //
  // Bis 1.2.18G machte jede Anlage einer `parallel Array<f32>` — und jede
  // Vektoroperation, denn `a + b` legt das Ergebnis neu an — einen eigenen
  // mmap-Syscall. Freigegeben wurde nie. Gemessen mit 131072 Elementen und
  // 500 Wiederholungen: 502 Anforderungen, 0 Rueckgaben, 253 MiB belegt fuer
  // eine Rechnung, die 1,5 MiB Daten braucht. Ein mmap kostet rund 3 µs; bei
  // kleinen Feldern ist das mehr als die Addition selbst, und der Abstand zu
  // gcc schrumpfte in der Messung von 12,8x (im L1) auf 3,2x (ueber dem
  // letzten Cache) — genau das Bild eines konstanten Aufwands JE OPERATION.
  //
  // Der Bump-Allokator aus #1836 (CG_HEAP_PTR/CG_HEAP_END) liegt ohnehin im
  // Erzeugnis und holt seine Bloecke zu 64 KiB; cg_emitBumpAtomar nimmt bei
  // `groesse == 0` die Groesse aus rsi, kann also auch eine zur Laufzeit
  // berechnete Menge belegen. Damit kostet eine Vektoroperation keinen
  // Kernelwechsel mehr.
  //
  // Erwartet: rax = Elementzahl. Ergebnis: rax = ausgerichteter Zeiger, die
  // Elementzahl steht bei ptr-8. Belegt werden n*4 + 24 Byte — 8 fuer den
  // Zaehler und bis zu 15 fuer die Ausrichtung auf 16.
  //
  // NICHT behoben ist damit das Wachstum: der Bump-Allokator gibt nichts
  // zurueck, der Speicher waechst also weiter, nur ohne Syscall. Das braucht
  // eine Aussage darueber, wann eine Ablage noch gehalten wird; siehe #2206.
  //
  // #2199: `bytes` ist die ELEMENTBREITE (4 fuer f32, 8 fuer f64). Bis 1.2.19F
  // stand hier fest `shl rax, 2`; eine f64-Ablage war damit halb so gross wie
  // noetig. Aufgefallen ist das nicht durch einen Absturz, sondern weil die
  // ZUGRIFFE ebenfalls 4 Byte nahmen und den Wert als f32 ablegten — die
  // Ablage war in sich konsistent und still ungenau (0.1 wurde
  // 0.10000000149011612).
  fn cg_emitSimdBumpAlloc(bytes: int64) {
    var schub: int64 := 2;
    if (bytes == 1) { schub := 0; }   // #2247
    if (bytes == 2) { schub := 1; }   // #2247
    if (bytes == 8) { schub := 3; }
    self.cg_e8(0x50);                                                        // push rax (Elementzahl)
    self.cg_e8(0x48); self.cg_e8(0xC1); self.cg_e8(0xE0); self.cg_e8(schub); // shl rax, 2 bzw. 3
    // #2215: Platz fuer den Zaehler (8) und bis zu 63 Byte Ausrichtung — die
    // Daten beginnen auf einer CACHE-LINE. Mit 16 Byte (bis 1.2.20E) lag jeder
    // zweite 32-Byte-AVX-Zugriff ueber zwei Lines (mem_inst_retired.split_loads
    // = die Haelfte aller Ladebefehle); der f32-Kern lief 1,17x hinter gcc.
    // In C gegengemessen: dieselbe Rechnung, Felder auf 4096 statt malloc+16,
    // 404 statt 496 Mio. Takte.
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC0); self.cg_e8(0x48);  // add rax, 72
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);                    // mov rsi, rax (Groesse)
    self.cg_e8(0x48); self.cg_e8(0x01); self.cg_e8(0x35); self.cg_bumpRip(CG_VEC_SUM);  // add [VEC_SUM], rsi  (#2253)
    // #2206: aus der VEKTORARENA, mit 1-MiB-Bloecken. Die Trennung von
    // CG_HEAP_* ist Voraussetzung fuer das Zuruecksetzen der Marke (siehe
    // cg_vecMarkeSetzen) — auf dem `new`-Heap waere es Speicherkorruption.
    self.cg_emitBumpAtomarIn(0, 0, CG_VEC_PTR, CG_VEC_END, 1048576);   // rax = Blockstelle
    self.cg_e8(0x59);                                                        // pop rcx (Elementzahl)
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC0); self.cg_e8(0x47);  // add rax, 71
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xE0); self.cg_e8(0xC0);  // and rax, -64
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x48); self.cg_e8(0xF8);  // mov [rax-8], rcx
  }

  // #2184: Hier lief eine einzige Schleife in 16-Byte-Schritten, Abbruch erst
  // bei `rax >= n*4`. Bei n = 5 verarbeitete die zweite Iteration die Bytes
  // 16..31, also zwoelf Byte HINTER dem letzten Element — aus beiden Quellen
  // gelesen und ins Ziel GESCHRIEBEN. Verdeckt wurde das von der 24-Byte-
  // Reserve der Anlage; alle vorhandenen Faelle nutzten n = 4.
  // Jetzt: Vektorteil nur bis zum letzten vollen 16-Byte-Block, danach ein
  // skalarer Durchgang in 4-Byte-Schritten fuer die bis zu drei Reste.
  //
  // Die Sprungweiten werden nachgetragen statt gezaehlt — die alten festen
  // Werte (+21, -26) waren beim naechsten eingefuegten Befehl falsch.
  // #2192 Schnitt 2: eine Speicherform mit Basis- und Indexregister,
  // `[basis + index]` ohne Verschiebung und ohne Skalierung — genau die Form,
  // die die Vektorschleife braucht (`[rdi+rax]`).
  //
  // ModRM: mod = 00, rm = 100 (SIB folgt). SIB: scale = 00, index, basis.
  // Mit mod = 00 bedeutet basis = 101 (rbp/r13) nicht "rbp", sondern eine
  // 32-Bit-Verschiebung ohne Basis — deshalb hier laut abgewiesen statt
  // still eine andere Adresse zu kodieren.
  fn cg_vexOpRM(opcode: int64, dst: int64, src1: int64,
                basis: int64, index: int64,
                l: int64, pp: int64, mm: int64, w: int64) {
    if (dst < 0 || dst > 15 || src1 < 0 || src1 > 15
        || basis < 0 || basis > 15 || index < 0 || index > 15) {
      EPrintStrLn("interner fehler: cg_vexOpRM: Register ausserhalb 0..15 (#2205)."c);
      exit(1);
    }
    if ((basis & 7) == 5) {
      EPrintStrLn("interner fehler: cg_vexOpRM: rbp/r13 als Basis braucht eine Verschiebung (#2205)."c);
      exit(1);
    }
    if ((index & 7) == 4) {
      EPrintStrLn("interner fehler: cg_vexOpRM: rsp/r12 ist als Index nicht kodierbar (#2205)."c);
      exit(1);
    }
    self.cg_vexPrefix(dst >> 3, index >> 3, basis >> 3, src1, l, pp, mm, w);
    self.cg_e8(opcode);
    self.cg_e8(0x04 | ((dst & 7) << 3));          // mod 00, reg = dst, rm = SIB
    self.cg_e8(((index & 7) << 3) | (basis & 7));  // scale 1
  }

  // #2205: derselbe Rechenschritt in 256 Bit. `l` waehlt die Breite
  // (1 = ymm, 0 = xmm), die Register sind fest: 0 = Ergebnis, 1 = rechter
  // Operand, Basis rdi (links), rsi (rechts), rdx (Ziel), Index rax.
  //
  // Geladen und gespeichert wird mit vmovups, NICHT vmovaps: die Anlage
  // (cg_emitSimdBumpAlloc) richtet auf 16 Byte aus, 32 sind NICHT zugesichert
  // — vmovaps faultete dort bei jeder zweiten Ablage. Die Alternative waere,
  // die Anlage auf 32 Byte zu heben; gemessen hat die unausgerichtete Form
  // auf dem Messgeraet keinen Unterschied gemacht, also bleibt die Anlage
  // unberuehrt und die Entscheidung steht hier statt in einer Vermutung.
  //
  // #2199: `bytes` waehlt die Breite der PACKED-Rechnung ueber das pp-Feld
  // des VEX-Praefixes: pp=0 ergibt vaddps (f32), pp=1 ergibt vaddpd (f64).
  // Die Ladebefehle bleiben vmovups — sie kopieren Bytes, nicht Zahlen.
  fn cg_emitVexF32Schritt(op: int64, l: int64, bytes: int64) {
    var pp: int64 := 0;
    if (bytes == 8) { pp := 1; }
    self.cg_vexOpRM(0x10, 0, 0, 7, 0, l, 0, 1, 0);   // vmovups v0, [rdi+rax]
    self.cg_vexOpRM(0x10, 1, 0, 6, 0, l, 0, 1, 0);   // vmovups v1, [rsi+rax]
    self.cg_vexOpRR(self.cg_sseF32Opcode(op), 0, 0, 1, l, pp, 1, 0);  // vXXXps/pd v0, v0, v1
    self.cg_vexOpRM(0x11, 0, 0, 2, 0, l, 0, 1, 0);   // vmovups [rdx+rax], v0
  }

  // #2247: derselbe Schritt fuer GANZZAHLEN. Geladen und geschrieben wird mit
  // VMOVDQA (VEX.66.0F 6F/7F), gerechnet mit VPADD*/VPSUB*/VPMULL* — dieselben
  // Opcodes wie die SSE-Form (cg_sseGanzOpcode), nur mit VEX davor. pp = 1
  // ist dabei immer gesetzt (das 0x66 der Ganzzahlgruppe), und die Breite
  // steckt im Opcode, nicht im Praefix.
  //
  // PMULLD kommt aus der 0F-38-Gruppe, also mm = 2 statt 1.
  fn cg_emitVexGanzSchritt(op: int64, l: int64, bytes: int64) {
    var gOpc: int64 := self.cg_sseGanzOpcode(op, bytes);
    if (gOpc < 0) {
      EPrintStrLn("lyxc: interner Fehler (#2247): Ganzzahl-Vektoroperation ohne Befehl — sema haette das abweisen muessen (_pruefeVektorOpArt)."c);
      exit(70);
    }
    self.cg_vexOpRM(0x6F, 0, 0, 7, 0, l, 1, 1, 0);   // vmovdqa v0, [rdi+rax]
    self.cg_vexOpRM(0x6F, 1, 0, 6, 0, l, 1, 1, 0);   // vmovdqa v1, [rsi+rax]
    if (gOpc > 255) {
      self.cg_vexOpRR(gOpc >> 8, 0, 0, 1, l, 1, 2, 0);   // vpmulld v0, v0, v1
    } else {
      self.cg_vexOpRR(gOpc, 0, 0, 1, l, 1, 1, 0);        // vpadd*/vpsub*/vpmullw
    }
    self.cg_vexOpRM(0x7F, 0, 0, 2, 0, l, 1, 1, 0);   // vmovdqa [rdx+rax], v0
  }

  // #2205: Vektorpfad in 256 Bit, als Vorlauf der 128-Bit-Schleife.
  //
  // Gemessen wurde VOR dem Bauen, weil der Pfad sich nicht ueberall lohnt
  // (bench/f32_breite.c, i5-8250U, je fuenf Laeufe, Minimum):
  //
  //            add    sub    mul    div
  //   im L1    2,12x  2,00x  2,00x  1,19x
  //   im L2    1,22x  1,62x  1,71x  1,33x
  //   im RAM   1,03x  0,97x  1,00x  1,00x
  //
  // Zwei Dinge stehen damit fest. Erstens: im Cache bringt die doppelte
  // Breite fast genau den Faktor zwei — ausser bei der Division, die
  // dieselbe Dividiereinheit benutzt (1,19x). Zweitens: ueber dem letzten
  // Cache bringt sie NICHTS, dort entscheidet die Speicherbandbreite. Sie
  // kostet dort aber auch nichts, und die Laenge steht erst zur Laufzeit
  // fest — eine Verzweigung nach Groesse waere also eine Laufzeitabfrage fuer
  // einen Gewinn von null. Deshalb: ein Pfad fuer alle Groessen.
  //
  // Die Division ist mit aufgenommen, obwohl sie am wenigsten bringt. Sie ist
  // dieselbe Schleife mit einem anderen Opcode-Byte; sie auszunehmen hiesse,
  // einen zweiten Weg zu pflegen, der 1,19x liegenlaesst.
  //
  // Aufbau — drei Stufen, weil ein Rest bis zu 31 Byte lang sein kann:
  //   32 Byte je Durchlauf, solange ein voller Block passt (VEX.256)
  //   dann EINMAL 16 Byte, wenn noch einer passt                (VEX.128)
  //   vzeroupper
  //   dann bis zu drei Einzelelemente                           (SSE skalar)
  //
  // Die dritte Stufe ist dieselbe Pflicht wie in #2184, wo eine einzige
  // 16-Byte-Schleife bei n = 5 zwoelf Byte hinter dem letzten Element
  // gelesen UND geschrieben hat. Mit 32 Byte je Schritt waeren es bis zu 28.
  fn cg_emitAVX2BinOp(op: int64, kennung: int64) {
    // #2199: Bytezahl = Elementzahl * Elementbreite. Die Blockgroessen
    // darunter bleiben in BYTE (32 und 16) — sie haengen an der
    // Registerbreite, nicht an der Elementart; ein 32-Byte-Block fasst acht
    // f32 oder vier f64. Nur der skalare Rest zaehlt in Elementen.
    //
    // #2247: `kennung` traegt Breite UND Art; fuer Ganzzahlen rechnet
    // cg_emitVexGanzSchritt und der Rest laeuft in Allzweckregistern.
    var bytes: int64 := kennung & CG_SIMD_BREITE;
    var ganz:  int64 := 0;
    if ((kennung & CG_SIMD_GANZ) != 0) { ganz := 1; }
    if (bytes != 1 && bytes != 2 && bytes != 4 && bytes != 8) {
      EPrintStrLn("lyxc: interner Fehler (#2224/#2247): Vektorschleife mit einer Elementbreite, die es nicht gibt."c);
      exit(70);
    }
    if (ganz == 0 && bytes != 4 && bytes != 8) {
      EPrintStrLn("lyxc: interner Fehler (#2247): Gleitkomma-Vektor mit einer Breite ausser 4 und 8."c);
      exit(70);
    }
    // #2247: PMULLD/VPMULLD erst ab sse4 — die Zusage gilt fuer beide
    // Blockbreiten, deshalb hier EINMAL gefragt statt in jedem Schritt.
    if (ganz != 0 && self.cg_sseGanzOpcode(op, bytes) > 255) { self.cg_cpuVerlange(1, "sse4"c); }
    var schub: int64 := 2;
    if (bytes == 1) { schub := 0; }
    if (bytes == 2) { schub := 1; }
    if (bytes == 8) { schub := 3; }
    var skPf: int64 := self.cg_sseSkalarPraefix(bytes);
    self.cg_e8(0x31); self.cg_e8(0xC0);                                      // xor eax, eax
    self.cg_e8(0x48); self.cg_e8(0xC1); self.cg_e8(0xE1); self.cg_e8(schub); // shl rcx, 2 bzw. 3
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xE9); self.cg_e8(0x20);  // sub rcx, 32

    // ---- 32 Byte je Durchlauf ----
    // #2215: unten geprueft (Eintrittspruefung einmal, dann add/cmp/jle) —
    // ein Sprung je Durchlauf statt zwei. Bis 1.2.20E stand die Pruefung oben
    // und am Ende ein `jmp` zurueck; dieser kurze Sprung endete in allen vier
    // abgerollten Kopien von bench/arr_add_f32 GENAU an einer 32-Byte-Grenze
    // (JCC-Erratum, siehe cg_paarAusrichten) — gemessen 1,17x hinter gcc.
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);                    // cmp rax, rcx
    self.cg_e8(0x7F); var jg256: int64 := self.codeLen; self.cg_e8(0);       // jg nach dem Block (kein voller Block)
    var v256Body: int64 := self.codeLen;
    if (ganz != 0) { self.cg_emitVexGanzSchritt(op, 1, bytes); } else { self.cg_emitVexF32Schritt(op, 1, bytes); }
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC0); self.cg_e8(0x20);  // add rax, 32
    self.cg_paarAusrichten(self.codeLen, 5);                                 // cmp+jle als Paar
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);                    // cmp rax, rcx
    self.cg_e8(0x7E); var back256: int64 := self.codeLen;                   // jle Rumpf
    self.cg_e8(v256Body - (back256 + 1));

    // ---- einmal 16 Byte, falls noch einer passt ----
    var nach256: int64 := self.codeLen;
    cg_patchRel8Wert(self.code, jg256, nach256 - v256Body);
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC1); self.cg_e8(0x10);  // add rcx, 16  (= n*4 - 16)
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);                    // cmp rax, rcx
    self.cg_e8(0x7F); var jg128: int64 := self.codeLen; self.cg_e8(0);       // jg nach dem Block
    var v128Body: int64 := self.codeLen;
    if (ganz != 0) { self.cg_emitVexGanzSchritt(op, 0, bytes); } else { self.cg_emitVexF32Schritt(op, 0, bytes); }
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC0); self.cg_e8(0x10);  // add rax, 16
    var nach128: int64 := self.codeLen;
    cg_patchRel8Wert(self.code, jg128, nach128 - v128Body);

    // ---- zurueck in den SSE-Zustand, BEVOR ein SSE-Befehl kommt ----
    //
    // Ohne vzeroupper zahlt jeder folgende SSE-Befehl einen Zustandswechsel.
    // Die Stelle ist bewusst hier und nicht am Ende: der skalare Rest unten
    // ist SSE-Code, und auch der Aufrufer rechnet mit SSE weiter.
    self.cg_vexZeroupper();

    // ---- bis zu drei Einzelelemente, skalar ----
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC1); self.cg_e8(0x10);  // add rcx, 16  (= n*4)
    var skStart: int64 := self.codeLen;
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);                    // cmp rax, rcx
    self.cg_e8(0x7D); var jge: int64 := self.codeLen; self.cg_e8(0);         // jge .done
    var skBody: int64 := self.codeLen;
    if (ganz != 0) {
      self.cg_emitGanzRestOp(op, bytes);   // #2247: Allzweckregister
    } else {
    self.cg_e8(skPf); self.cg_e8(0x0F); self.cg_e8(0x10); self.cg_e8(0x04); self.cg_e8(0x07);  // movss/sd xmm0, [rdi+rax]
    self.cg_e8(skPf); self.cg_e8(0x0F); self.cg_e8(0x10); self.cg_e8(0x0C); self.cg_e8(0x06);  // movss/sd xmm1, [rsi+rax]
    self.cg_e8(skPf); self.cg_e8(0x0F);
    self.cg_e8(self.cg_sseF32Opcode(op));
    self.cg_e8(0xC1);                                                        // addss/addsd xmm0, xmm1
    self.cg_e8(skPf); self.cg_e8(0x0F); self.cg_e8(0x11); self.cg_e8(0x04); self.cg_e8(0x02);  // movss/sd [rdx+rax], xmm0
    }
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC0); self.cg_e8(bytes); // add rax, 4 bzw. 8
    self.cg_e8(0xEB); var backSk: int64 := self.codeLen;
    self.cg_e8(skStart - (backSk + 1));

    var done: int64 := self.codeLen;
    cg_patchRel8Wert(self.code, jge, done - skBody);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD0);                    // mov rax, rdx
  }

  // #2213: Ergebnisablage einer Vektoroperation. Erwartet rcx = Elementzahl,
  // liefert rdx = Zielzeiger; rax und r8 werden benutzt, rcx/rdi/rsi muss der
  // Aufrufer selbst sichern (sie gehen durch die Anlage verloren).
  // Herausgeloest aus dem Binop-Pfad, weil die Negation (#2222) dieselbe
  // Ablage braucht — eine Stelle, damit die beiden nicht auseinanderlaufen.
  fn cg_emitSimdZielAblage(simdOpBytes: int64) {
    var zielOff: int64 := self.simdZielOff;
    var pNeu: int64 := 0 - 1;
    var pHaben: int64 := 0 - 1;
    if (zielOff < 0) {
      // mov rdx, [rbp+zielOff]
      if (zielOff >= -128) {
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x55); self.cg_e8(zielOff);
      } else {
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x95); self.cg_e32(zielOff);
      }
      // Beide Spruenge als rel32. Der erste Anlauf nahm Kurzspruenge und
      // scheiterte laut: `je haben` ueberspringt die ganze Anlage, und
      // die ist 296 Byte lang (#1915 meldet das, statt still falsch zu
      // kodieren).
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xD2);               // test rdx, rdx
      self.cg_e8(0x0F); self.cg_e8(0x84); pNeu := self.codeLen; self.cg_e32(0);   // jz anlegen
      self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x42); self.cg_e8(0xF8);  // mov r8, [rdx-8]
      self.cg_e8(0x4C); self.cg_e8(0x39); self.cg_e8(0xC1);               // cmp rcx, r8
      self.cg_e8(0x0F); self.cg_e8(0x84); pHaben := self.codeLen; self.cg_e32(0); // je haben
      poke32(self.code + pNeu, self.codeLen - pNeu - 4);
      pNeu := 0 - 1;
    }
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC8);  // mov rax, rcx (Elementzahl)
    // #2199: dieselbe Breite wie die Quellen — sonst waere die
    // Ergebnisablage halb so gross wie die Rechnung braucht.
    self.cg_emitSimdBumpAlloc(simdOpBytes);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2);  // mov rdx, rax (dst ptr)
    if (pHaben >= 0) {
      poke32(self.code + pHaben, self.codeLen - pHaben - 4);
    }
  }

  // #2222: `-a` auf `parallel Array<f32|f64>` — Vorzeichenbit je Element
  // kippen. Dieselbe Rechnung wie emitSimdNeg/SIMD_RUMPF_NEG in
  // backend/lyxos/emit_lyxos.lyx; die beiden muessen uebereinstimmen.
  // Erwartet rdi = Quelle, rdx = Ziel, rcx = Elementzahl; liefert rax = Ziel.
  //
  // Gekippt wird per xorps mit einer Maske, NICHT als `0 - x`: das ergaebe
  // fuer +0.0 wieder +0.0 statt -0.0, und NaN behielte sein Vorzeichen.
  // Die Maske entsteht ohne Speicherzugriff: pcmpeqd setzt alle Bits, der
  // Shift laesst je Lane nur das oberste stehen — fuer f32 `pslld xmm2, 31`
  // (66 0F 72 F2 1F), fuer f64 `psllq xmm2, 63` (66 0F 73 F2 3F). Anderes
  // Opcode-Byte UND andere Weite; mit dem f32-Wort waere bei f64 ein
  // Mantissenbit gekippt worden (#2199).
  //
  // Aufbau wie cg_emitSSE2BinOp: 16 Byte je Durchlauf, danach Einzelelemente
  // (#2184 — sonst liest und schreibt der letzte Block hinter das Ende).
  // xorps im skalaren Rest trifft mit Lane 0 genau das Element; die oberen
  // Lanes von xmm0 werden nicht gespeichert.
  fn cg_emitSSE2Neg(bytes: int64) {
    var schub: int64 := 2;
    if (bytes == 8) { schub := 3; }
    var skPf: int64 := self.cg_sseSkalarPraefix(bytes);
    // Maske in xmm2
    self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x76); self.cg_e8(0xD2);  // pcmpeqd xmm2, xmm2
    if (bytes == 8) {
      self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x73); self.cg_e8(0xF2); self.cg_e8(0x3F);  // psllq xmm2, 63
    } else {
      self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x72); self.cg_e8(0xF2); self.cg_e8(0x1F);  // pslld xmm2, 31
    }
    self.cg_e8(0x31); self.cg_e8(0xC0);                                      // xor eax, eax
    self.cg_e8(0x48); self.cg_e8(0xC1); self.cg_e8(0xE1); self.cg_e8(schub); // shl rcx, 2 bzw. 3
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xE9); self.cg_e8(0x10);  // sub rcx, 16

    // ---- Vektorteil: while (rax <= rcx), unten geprueft (#2215, wie cg_emitAVX2BinOp) ----
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);                    // cmp rax, rcx
    self.cg_e8(0x7F); var jgPos: int64 := self.codeLen; self.cg_e8(0);       // jg .tail
    var vecBody: int64 := self.codeLen;
    self.cg_e8(0x0F); self.cg_e8(0x28); self.cg_e8(0x04); self.cg_e8(0x07);  // movaps xmm0, [rdi+rax]
    self.cg_e8(0x0F); self.cg_e8(0x57); self.cg_e8(0xC2);                    // xorps xmm0, xmm2
    self.cg_e8(0x0F); self.cg_e8(0x29); self.cg_e8(0x04); self.cg_e8(0x02);  // movaps [rdx+rax], xmm0
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC0); self.cg_e8(0x10);  // add rax, 16
    self.cg_paarAusrichten(self.codeLen, 5);                                 // cmp+jle als Paar
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);                    // cmp rax, rcx
    self.cg_e8(0x7E); var vecBackPos: int64 := self.codeLen;
    self.cg_e8(vecBody - (vecBackPos + 1));                                  // jle Rumpf

    // ---- Rest: Element fuer Element ----
    var tailStart: int64 := self.codeLen;
    cg_patchRel8Wert(self.code, jgPos, tailStart - vecBody);
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC1); self.cg_e8(0x10);  // add rcx, 16
    var scalarStart: int64 := self.codeLen;
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);                    // cmp rax, rcx
    self.cg_e8(0x7D); var jgePos: int64 := self.codeLen; self.cg_e8(0);      // jge .done
    var scalarBody: int64 := self.codeLen;
    self.cg_e8(skPf); self.cg_e8(0x0F); self.cg_e8(0x10); self.cg_e8(0x04); self.cg_e8(0x07);  // movss/sd xmm0, [rdi+rax]
    self.cg_e8(0x0F); self.cg_e8(0x57); self.cg_e8(0xC2);                    // xorps xmm0, xmm2
    self.cg_e8(skPf); self.cg_e8(0x0F); self.cg_e8(0x11); self.cg_e8(0x04); self.cg_e8(0x02);  // movss/sd [rdx+rax], xmm0
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC0); self.cg_e8(bytes); // add rax, 4 bzw. 8
    self.cg_e8(0xEB); var scalarBackPos: int64 := self.codeLen;
    self.cg_e8(scalarStart - (scalarBackPos + 1));                           // jmp .scalarStart

    var donePos: int64 := self.codeLen;
    cg_patchRel8Wert(self.code, jgePos, donePos - scalarBody);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD0);                    // mov rax, rdx
  }

  // #2222: Unaere Operation auf einem Vektor. Vorher lief `-a` in den
  // skalaren Zweig: er negierte den ZEIGER (btc bzw. neg rax), und der
  // naechste Zugriff ging an eine Adresse im Kernelbereich — SIGSEGV.
  //
  // Umgesetzt ist die Negation eines Vektor-BEZEICHNERS, wie beim Binop-Pfad
  // (beide Seiten Bezeichner). Alles andere wird laut abgewiesen statt
  // geraten: ein verschachtelter Vektorausdruck wuerde die Zielablage
  // (simdZielOff) schon fuer das Zwischenergebnis benutzen.
  fn cg_genSimdUnop(op: int64, inner: int64) {
    if (op != CGT_MINUS) {
      EPrintStrLn("error: dieser unaere Operator ist auf `parallel Array` nicht umgesetzt — nur die Negation `-a` (#2222)."c);
      exit(1);
    }
    var li: int64 := 0 - 1;
    if (self.cg_nkind(inner) == CGN_IDENT) {
      li := self.cg_findLocalIdx(self.cg_nsval(inner), self.cg_nslen(inner));
    }
    if (li < 0 || peek8(self.localIsSimd + li) == 0) {
      EPrintStrLn("error: Negation eines Vektorausdrucks ist auf x86-64 nur fuer einen Namen umgesetzt (`-a`, #2222)."c);
      EPrintStrLn("  Das Zwischenergebnis erst einer Variablen zuweisen: `let t: parallel Array<f64> = a + b; let n: parallel Array<f64> = -t;`"c);
      exit(1);
    }
    var bytes: int64 := self.cg_simdBytesOf(li);
    var off: int64 := self.cg_findLocal(self.cg_nsval(inner), self.cg_nslen(inner));
    if (off >= -128 && off <= -1) {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x45); self.cg_e8(off);     // mov rax, [rbp+off8]
    } else {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x85); self.cg_e32(off);    // mov rax, [rbp+off32]
    }
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);                         // mov rdi, rax
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x4F); self.cg_e8(0xF8);       // mov rcx, [rdi-8]
    self.cg_e8(0x51);                                                             // push rcx
    self.cg_e8(0x57);                                                             // push rdi
    self.cg_emitSimdZielAblage(bytes);                                            // rdx = Ziel
    self.cg_e8(0x5F);                                                             // pop rdi
    self.cg_e8(0x59);                                                             // pop rcx
    self.cg_emitSSE2Neg(bytes);                                                   // rax = Ziel
  }

  // #2222: Rechnet dieser Binop mit einem Vektor, den der x86-Pfad NICHT
  // vektorisiert? Umgesetzt sind + - * / auf zwei Vektor-BEZEICHNERN (der
  // Zweig unten mit cg_emitSSE2BinOp). Alles andere — Skalar mit Vektor
  // (`0.0 - a`, `a * 2.0`), ein verschachtelter Vektorausdruck, eine
  // Bit-Operation — lief bisher in den skalaren Zweig und rechnete auf dem
  // ZEIGER; der naechste Zugriff stuerzte ab (SIGSEGV) oder las still
  // fremden Speicher. Gemischte Formen weist schon sema ab
  // (_checkVektorBinop); diese Stelle faengt, was sema durchlaesst, laut ab.
  // Vergleiche sind ausgenommen: sie liefern keinen Vektor.
  fn cg_vektorBinopOhneWeg(op: int64, lhsNi: int64, rhsNi: int64): int64 {
    var rechnend: int64 := 0;
    if (op == CGT_PLUS || op == CGT_MINUS || op == CGT_STAR || op == CGT_SLASH || op == CGT_PERCENT) { rechnend := 1; }
    if (op == CGT_BITAND || op == CGT_BITOR || op == 89 || op == CGT_SHL || op == CGT_SHR) { rechnend := 1; }   // 89 = ^
    if (rechnend == 0) { return 0; }
    var lv: int64 := self.cg_istSimdAusdruck(lhsNi);
    var rv: int64 := self.cg_istSimdAusdruck(rhsNi);
    if (lv == 0 && rv == 0) { return 0; }
    if ((op == CGT_PLUS || op == CGT_MINUS || op == CGT_STAR || op == CGT_SLASH) &&
        self.cg_nkind(lhsNi) == CGN_IDENT && self.cg_nkind(rhsNi) == CGN_IDENT && lv != 0 && rv != 0) {
      return 0;
    }
    EPrintStrLn("error: diese Rechnung mit `parallel Array` ist auf x86-64 nicht umgesetzt (#2222)."c);
    EPrintStrLn("  Umgesetzt: + - * / auf zwei Vektor-Variablen gleicher Elementart, und die Negation `-a`."c);
    EPrintStrLn("  Ein Zwischenergebnis erst einer Variablen zuweisen; Skalar und Vektor nicht mischen."c);
    exit(1);
    return 1;
  }

  fn cg_emitSSE2BinOp(op: int64, kennung: int64) {
    // #2199: Bytezahl = Elementzahl * Elementbreite; der 16-Byte-Block fasst
    // vier f32 oder zwei f64. Die packed-Form waehlt das Praefix (kein
    // Praefix = addps, 0x66 = addpd), die skalare F3 bzw. F2.
    //
    // #2247: `kennung` traegt Breite UND Art. Fuer Ganzzahlen ist alles
    // anders: das Praefix ist immer 0x66, die Breite steckt im Opcode, die
    // Blockbefehle heissen MOVDQA statt MOVAPS, und der Rest rechnet in
    // Allzweckregistern (cg_emitGanzRestOp).
    var bytes: int64 := kennung & CG_SIMD_BREITE;
    var ganz:  int64 := 0;
    if ((kennung & CG_SIMD_GANZ) != 0) { ganz := 1; }
    // #2224: die Breite muss eine der vorgesehenen sein. Stand hier 0, wurde
    // `add rax, 0` eine Endlosschleife — gemeldet als Zeitablauf, nicht als
    // falscher Wert. Seit #2247 sind 1 und 2 ebenfalls gueltig.
    if (bytes != 1 && bytes != 2 && bytes != 4 && bytes != 8) {
      EPrintStrLn("lyxc: interner Fehler (#2224/#2247): Vektorschleife mit einer Elementbreite, die es nicht gibt."c);
      exit(70);
    }
    if (ganz == 0 && bytes != 4 && bytes != 8) {
      EPrintStrLn("lyxc: interner Fehler (#2247): Gleitkomma-Vektor mit einer Breite ausser 4 und 8."c);
      exit(70);
    }
    var schub: int64 := 2;
    if (bytes == 1) { schub := 0; }
    if (bytes == 2) { schub := 1; }
    if (bytes == 8) { schub := 3; }
    var pkPf: int64 := self.cg_ssePackedPraefix(bytes);
    var skPf: int64 := self.cg_sseSkalarPraefix(bytes);
    // xor eax, eax  (byte offset = 0)
    self.cg_e8(0x31); self.cg_e8(0xC0);
    // shl rcx, 2 bzw. 3  (rcx = Bytezahl)
    self.cg_e8(0x48); self.cg_e8(0xC1); self.cg_e8(0xE1); self.cg_e8(schub);
    // sub rcx, 16  (rcx = letzter Offset, an dem noch ein voller Block passt;
    //               darf negativ werden, der Vergleich unten ist vorzeichenbehaftet)
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xE9); self.cg_e8(0x10);

    // ---- Vektorteil: while (rax <= rcx), unten geprueft (#2215, wie cg_emitAVX2BinOp) ----
    // cmp rax, rcx
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);
    // jg .tail
    self.cg_e8(0x7F);
    var jgPos: int64 := self.codeLen; self.cg_e8(0);
    var vecBody: int64 := self.codeLen;
    if (ganz != 0) {
      // #2247: movdqa xmm0, [rdi+rax] / xmm1, [rsi+rax]  (66 0F 6F ..)
      self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x6F); self.cg_e8(0x04); self.cg_e8(0x07);
      self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x6F); self.cg_e8(0x0C); self.cg_e8(0x06);
      var gOpc: int64 := self.cg_sseGanzOpcode(op, bytes);
      if (gOpc < 0) {
        EPrintStrLn("lyxc: interner Fehler (#2247): Ganzzahl-Vektoroperation ohne Befehl — sema haette das abweisen muessen (_pruefeVektorOpArt)."c);
        exit(70);
      }
      self.cg_e8(0x66); self.cg_e8(0x0F);
      if (gOpc > 255) {
        // 0F 38 40 — PMULLD, erst ab sse4. Ohne die Zusage wird laut
        // abgebrochen statt still etwas Langsameres zu erzeugen (#2191).
        self.cg_cpuVerlange(1, "sse4"c);
        self.cg_e8(gOpc & 255); self.cg_e8(gOpc >> 8);
      } else {
        self.cg_e8(gOpc);
      }
      self.cg_e8(0xC1);  // xmm0, xmm1
      // movdqa [rdx+rax], xmm0  (66 0F 7F 04 02)
      self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x7F); self.cg_e8(0x04); self.cg_e8(0x02);
    } else {
    // movaps xmm0, [rdi+rax]  (0F 28 04 07)
    self.cg_e8(0x0F); self.cg_e8(0x28); self.cg_e8(0x04); self.cg_e8(0x07);
    // movaps xmm1, [rsi+rax]  (0F 28 0C 06)
    self.cg_e8(0x0F); self.cg_e8(0x28); self.cg_e8(0x0C); self.cg_e8(0x06);
    // packed op: addps/subps/mulps/divps bzw. addpd/... xmm0, xmm1
    // #2199: dasselbe Opcode-Byte, nur das Praefix entscheidet die Breite.
    if (pkPf != 0) { self.cg_e8(pkPf); }
    self.cg_e8(0x0F);
    self.cg_e8(self.cg_sseF32Opcode(op));
    self.cg_e8(0xC1);  // xmm0, xmm1
    // movaps [rdx+rax], xmm0  (0F 29 04 02)
    self.cg_e8(0x0F); self.cg_e8(0x29); self.cg_e8(0x04); self.cg_e8(0x02);
    }
    // add rax, 16
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC0); self.cg_e8(0x10);
    // cmp rax, rcx; jle Rumpf — als Paar ausgerichtet
    self.cg_paarAusrichten(self.codeLen, 5);
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);
    self.cg_e8(0x7E);
    var vecBackPos: int64 := self.codeLen;
    self.cg_e8(vecBody - (vecBackPos + 1));

    // ---- Rest: rcx zurueck auf die volle Bytezahl, dann 4 Byte je Schritt ----
    var tailStart: int64 := self.codeLen;
    cg_patchRel8Wert(self.code, jgPos, tailStart - vecBody);
    // add rcx, 16
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC1); self.cg_e8(0x10);
    var scalarStart: int64 := self.codeLen;
    // cmp rax, rcx
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);
    // jge .done
    self.cg_e8(0x7D);
    var jgePos: int64 := self.codeLen; self.cg_e8(0);
    var scalarBody: int64 := self.codeLen;
    if (ganz != 0) {
      self.cg_emitGanzRestOp(op, bytes);   // #2247: Allzweckregister
    } else {
    // movss/movsd xmm0, [rdi+rax]   (#2199: F3 bzw. F2)
    self.cg_e8(skPf); self.cg_e8(0x0F); self.cg_e8(0x10); self.cg_e8(0x04); self.cg_e8(0x07);
    // movss/movsd xmm1, [rsi+rax]
    self.cg_e8(skPf); self.cg_e8(0x0F); self.cg_e8(0x10); self.cg_e8(0x0C); self.cg_e8(0x06);
    // skalares f32-Gegenstueck: addss/subss/mulss/divss xmm0, xmm1 — derselbe
    // Opcode wie packed, nur mit F3-Praefix.
    self.cg_e8(skPf); self.cg_e8(0x0F);
    self.cg_e8(self.cg_sseF32Opcode(op));
    self.cg_e8(0xC1);
    // movss/movsd [rdx+rax], xmm0
    self.cg_e8(skPf); self.cg_e8(0x0F); self.cg_e8(0x11); self.cg_e8(0x04); self.cg_e8(0x02);
    }
    // add rax, 4 bzw. 8  (#2199: ein ELEMENT weiter)
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC0); self.cg_e8(bytes);
    // jmp .scalarStart
    self.cg_e8(0xEB);
    var scalarBackPos: int64 := self.codeLen;
    self.cg_e8(scalarStart - (scalarBackPos + 1));

    var donePos: int64 := self.codeLen;
    cg_patchRel8Wert(self.code, jgePos, donePos - scalarBody);
    // [.done]: mov rax, rdx  (Ergebniszeiger)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD0);
  }

  // #2184: eine Stelle fuer die vier Opcodes, damit packed und skalar nicht
  // auseinanderlaufen koennen. Gilt fuer `..ps` wie fuer `..ss`.
  // #2199: Das Praefixbyte, das die Breite der PACKED-Form waehlt.
  //   f32: kein Praefix     -> addps  (0F 58)
  //   f64: 0x66             -> addpd  (66 0F 58)
  // Und fuer die SKALARE Form des Rest-Durchgangs:
  //   f32: 0xF3             -> addss
  //   f64: 0xF2             -> addsd
  // Die Opcodes selbst sind identisch (cg_sseF32Opcode) — nur das Praefix
  // entscheidet. Deshalb eine Stelle fuer beide Breiten, wie #2184 es fuer
  // packed und skalar schon festgelegt hat.
  // #2247: Opcode der GANZZAHL-Vektoroperation, 0x66-Praefix vorausgesetzt.
  // Zwei Bytes, weil PMULLD aus der 0F-38-Gruppe kommt: Rueckgabe ist
  // (zweites Byte) * 256 + (erstes Byte), oder -1, wenn es den Befehl nicht
  // gibt. Die Breite steckt im Opcode selbst, nicht im Praefix — anders als
  // bei Gleitkomma, wo dasselbe Byte mit 0x66 die Breite wechselt.
  //
  //   +  PADDB 0F FC | PADDW 0F FD | PADDD 0F FE | PADDQ 0F D4
  //   -  PSUBB 0F F8 | PSUBW 0F F9 | PSUBD 0F FA | PSUBQ 0F FB
  //   *  PMULLW 0F D5 (16 Bit) | PMULLD 0F 38 40 (32 Bit, sse4)
  //
  // Fuer * mit 8 oder 64 Bit und fuer / und % gibt es keinen Befehl; sema
  // weist das vorher ab (_pruefeVektorOpArt). Kommt hier doch einer an, ist
  // das ein Loch zwischen den beiden Stellen und wird laut gemeldet.
  fn cg_sseGanzOpcode(op: int64, bytes: int64): int64 {
    if (op == CGT_PLUS) {
      if (bytes == 1) { return 0xFC; }
      if (bytes == 2) { return 0xFD; }
      if (bytes == 4) { return 0xFE; }
      if (bytes == 8) { return 0xD4; }
    }
    if (op == CGT_MINUS) {
      if (bytes == 1) { return 0xF8; }
      if (bytes == 2) { return 0xF9; }
      if (bytes == 4) { return 0xFA; }
      if (bytes == 8) { return 0xFB; }
    }
    if (op == CGT_STAR) {
      if (bytes == 2) { return 0xD5; }
      if (bytes == 4) { return 0x38 + 0x40 * 256; }   // 0F 38 40
    }
    return 0 - 1;
  }

  // #2247: Der skalare Rest eines Ganzzahlvektors laeuft NICHT ueber SSE —
  // bei Gleitkomma ist der Rest einfach dieselbe Operation mit F3/F2-Praefix,
  // fuer Ganzzahlen gibt es diese Entsprechung nicht. Gerechnet wird deshalb
  // in Allzweckregistern, ein Element je Durchgang, mit der Breite im
  // Ladebefehl.
  //
  // r8 = Wert links, r9 = Wert rechts; beide vorzeichenerweitert geladen,
  // damit die Rechnung derselben Bedeutung folgt wie peek8/16/32 (#2300:
  // int32 erweitert mit Vorzeichen). Geschrieben wird nur die Breite selbst.
  fn cg_emitGanzRestOp(op: int64, bytes: int64) {
    // r8 = [rdi+rax]
    if (bytes == 1)      { self.cg_e8(0x4C); self.cg_e8(0x0F); self.cg_e8(0xBE); self.cg_e8(0x04); self.cg_e8(0x07); }
    else if (bytes == 2) { self.cg_e8(0x4C); self.cg_e8(0x0F); self.cg_e8(0xBF); self.cg_e8(0x04); self.cg_e8(0x07); }
    else if (bytes == 4) { self.cg_e8(0x4C); self.cg_e8(0x63); self.cg_e8(0x04); self.cg_e8(0x07); }
    else                 { self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0x07); }
    // r9 = [rsi+rax]
    if (bytes == 1)      { self.cg_e8(0x4C); self.cg_e8(0x0F); self.cg_e8(0xBE); self.cg_e8(0x0C); self.cg_e8(0x06); }
    else if (bytes == 2) { self.cg_e8(0x4C); self.cg_e8(0x0F); self.cg_e8(0xBF); self.cg_e8(0x0C); self.cg_e8(0x06); }
    else if (bytes == 4) { self.cg_e8(0x4C); self.cg_e8(0x63); self.cg_e8(0x0C); self.cg_e8(0x06); }
    else                 { self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x0C); self.cg_e8(0x06); }
    // r8 <op>= r9
    if (op == CGT_PLUS)       { self.cg_e8(0x4D); self.cg_e8(0x01); self.cg_e8(0xC8); }   // add r8, r9
    else if (op == CGT_MINUS) { self.cg_e8(0x4D); self.cg_e8(0x29); self.cg_e8(0xC8); }   // sub r8, r9
    else if (op == CGT_STAR)  { self.cg_e8(0x4D); self.cg_e8(0x0F); self.cg_e8(0xAF); self.cg_e8(0xC1); }  // imul r8, r9
    else {
      EPrintStrLn("lyxc: interner Fehler (#2247): cg_emitGanzRestOp mit einer Operation ohne Ganzzahlform."c);
      exit(70);
    }
    // [rdx+rax] = r8  (nur die Breite selbst)
    if (bytes == 1)      { self.cg_e8(0x44); self.cg_e8(0x88); self.cg_e8(0x04); self.cg_e8(0x02); }
    else if (bytes == 2) { self.cg_e8(0x66); self.cg_e8(0x44); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x02); }
    else if (bytes == 4) { self.cg_e8(0x44); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x02); }
    else                 { self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0x02); }
  }

  fn cg_ssePackedPraefix(bytes: int64): int64 {
    if (bytes == 8) { return 0x66; }
    return 0;
  }
  fn cg_sseSkalarPraefix(bytes: int64): int64 {
    if (bytes == 8) { return 0xF2; }
    return 0xF3;
  }

  fn cg_sseF32Opcode(op: int64): int64 {
    if (op == CGT_PLUS)  { return 0x58; }   // addps / addss
    if (op == CGT_MINUS) { return 0x5C; }   // subps / subss
    if (op == CGT_STAR)  { return 0x59; }   // mulps / mulss
    if (op == CGT_SLASH) { return 0x5E; }   // divps / divss
    EPrintStrLn("interner fehler: cg_sseF32Opcode mit einem Operator, der keine Vektorform hat (#2184)."c);
    exit(1);
    return 0;
  }

  // Emit binary operation: rax=right operand, rbx=left operand (from stack pop)
  // Result left in rax.
  // #1125: `lhsUnsigned` beschreibt den LINKEN Operanden — nur der entscheidet
  // beim Rechtsshift zwischen SAR und SHR. Alle uebrigen Operationen sind von
  // ihm unberuehrt.
  // #1126: `cmpUnsigned` gilt fuer die VERGLEICHE — dort zaehlt, ob EINER der
  // beiden Operanden vorzeichenlos ist (wie bei den ueblichen arithmetischen
  // Konversionen). `lhsUnsigned` bleibt dem Rechtsshift vorbehalten, wo allein
  // der linke Operand entscheidet.
  // #2114: Ganzzahl-Binaeroperation mit konstantem rechtem Operanden direkt
  // auf rax (links). Liefert 1, wenn emittiert — sonst 0, und der Aufrufer
  // nimmt den allgemeinen Weg ueber rbx/rax und cg_emitBinOp. Dieselben
  // Ergebnisse und Flags wie dort (die beiden muessen uebereinstimmen):
  // add/sub/imul setzen OF wie `add rax, rbx` usw., die Ueberlaufpruefung
  // haengt deshalb unveraendert dahinter; Schiebeweiten maskiert die CPU bei
  // `shl rax, imm8` genauso wie bei `shl rbx, cl`. Keine neue Verzweigung —
  // Maskenarithmetik bleibt verzweigungsfrei (Konstantzeit, #2114 Punkt 3).
  fn cg_emitBinOpImm(op: int64, imm: int64, lhsUnsigned: int64, cmpUnsigned: int64): int64 {
    var passt8: int64 := 0;
    if (imm >= -128 && imm <= 127) { passt8 := 1; }
    var passt32: int64 := 0;
    if (imm >= -2147483648 && imm <= 2147483647) { passt32 := 1; }
    // Arithmetik und Bitlogik: /0 add, /5 sub, /4 and, /1 or, /6 xor, /7 cmp
    var ext: int64 := -1;
    if (op == CGT_PLUS)   { ext := 0; }
    if (op == CGT_MINUS)  { ext := 5; }
    if (op == CGT_BITAND) { ext := 4; }
    if (op == CGT_BITOR)  { ext := 1; }
    if (op == 89)         { ext := 6; }   // xor (TK_BITXOR)
    if (op == CGT_EQ2 || op == CGT_NEQ || op == CGT_LT || op == CGT_LE || op == CGT_GT || op == CGT_GE) { ext := 7; }
    if (op == CGT_BITAND && imm == 4294967295) {
      self.cg_e8(0x89); self.cg_e8(0xC0);                       // mov eax, eax (nullt die oberen 32 Bit)
      return 1;
    }
    if (ext >= 0) {
      self.cmpAnfang := self.codeLen;   // #2228: Anfang eines moeglichen cmp
      if (passt8 != 0) {
        self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC0 | (ext << 3)); self.cg_e8(imm & 255);
      } else if (passt32 != 0) {
        self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xC0 | (ext << 3)); self.cg_e32(imm);
      } else {
        return 0;
      }
      if (ext == 7) {
        self.cg_emitSetccRax(op, cmpUnsigned);
      } else if ((op == CGT_PLUS || op == CGT_MINUS) && self.overflowCheckEnabled != 0) {
        self.cg_emitOverflowPanic();
      }
      return 1;
    }
    if (op == CGT_STAR) {
      if (passt8 != 0) {
        self.cg_e8(0x48); self.cg_e8(0x6B); self.cg_e8(0xC0); self.cg_e8(imm & 255);   // imul rax, rax, imm8
      } else if (passt32 != 0) {
        self.cg_e8(0x48); self.cg_e8(0x69); self.cg_e8(0xC0); self.cg_e32(imm);       // imul rax, rax, imm32
      } else {
        return 0;
      }
      if (self.overflowCheckEnabled != 0) { self.cg_emitOverflowPanic(); }
      return 1;
    }
    if (op == CGT_SHL || op == CGT_SHR) {
      var sub: int64 := 0xE0;                                    // shl /4
      if (op == CGT_SHR) {
        if (lhsUnsigned != 0) { sub := 0xE8; }                   // shr /5
        else                  { sub := 0xF8; }                   // sar /7 (#1125)
      }
      self.cg_e8(0x48); self.cg_e8(0xC1); self.cg_e8(sub); self.cg_e8(imm & 255);
      return 1;
    }
    return 0;
  }

  // #2114: setcc al + movzx rax, al nach einem `cmp` mit LINKS als erstem
  // Operanden — dieselbe Zuordnung wie in cg_emitBinOp (cmp rbx, rax).
  fn cg_emitSetccRax(op: int64, cmpUnsigned: int64) {
    var cc: int64 := 0x94;                                       // sete
    if (op == CGT_NEQ) { cc := 0x95; }
    if (op == CGT_LT)  { cc := 0x9C; if (cmpUnsigned != 0) { cc := 0x92; } }
    if (op == CGT_LE)  { cc := 0x9E; if (cmpUnsigned != 0) { cc := 0x96; } }
    if (op == CGT_GT)  { cc := 0x9F; if (cmpUnsigned != 0) { cc := 0x97; } }
    if (op == CGT_GE)  { cc := 0x9D; if (cmpUnsigned != 0) { cc := 0x93; } }
    self.cg_e8(0x0F); self.cg_e8(cc); self.cg_e8(0xC0);
    self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
  }

  // #2114: Rahmenversatz eines Locals, das cg_genExpr mit genau einem
  // `mov rax, [rbp+off]` laedt (cg_loadRax) — 0, wenn nicht. Ausgeschlossen
  // ist alles, was der IDENT-Zweig dort anders behandelt: Wiedergabe
  // eines aufgeschobenen Aufrufs, Funktionswert-Satz, innere Funktion,
  // @redundant (Mehrheitslesen), Erfassung, Globale, Konstante.
  fn cg_einfachesLocalOff(ni: int64): int64 {
    if (ni < 0) { return 0; }
    if (self.cg_nkind(ni) != CGN_IDENT) { return 0; }
    if (self.dfReplay != 0 && self.cg_deferArgIdx(ni) >= 0) { return 0; }
    if (self.satzKontext != 0) { return 0; }
    if (self.cg_istSatzWert(ni) != 0) { return 0; }
    if (self.cg_nestIdx(ni) >= 0) { return 0; }
    var off: int64 := self.cg_findLocal(self.cg_nsval(ni), self.cg_nslen(ni));
    if (off == 0) { return 0; }
    var ridx: int64 := self.cg_findLocalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
    if (ridx >= 0 && self.cg_isLocalRedundant(ridx) != 0) { return 0; }
    return off;
  }

  // #2114: `links OP local` mit einem einfachen Local rechts: links nach rax,
  // dann `op rax, [rbp+off]` — kein push/pop, keine zweite Ladung. Dieselbe
  // Auswertungsreihenfolge wie der allgemeine Weg (erst links, dann das Local
  // lesen). Nur Ganzzahl; liefert 0, wenn der Fall nicht passt.
  // #2247: Ist die Operation kommutativ, darf das einfache Local auch LINKS
  // stehen — getauscht stellt es denselben Speicheroperanden. Nicht fuer
  // MINUS/PERCENT/Schiebungen (nicht kommutativ) und nicht fuer LT/LE/GT/GE
  // (ein Tausch kehrt den Vergleich um); EQ2/NEQ sind symmetrisch.
  // #2247: Traegt dieses Local GENAU den Typ int64? Die Frage ist die
  // Eintrittskarte fuer den Schnellweg der Schleifenverwaltung.
  //
  // Gefragt wird nach dem Typnamen und nicht nach den acht Haken, die der
  // allgemeine Zuweisungsweg abarbeitet (Bereichspruefung, Verschmaelerung,
  // Einheitentyp, f64-Angleichung, Vektorablage, Satz, Methodentyp,
  // Struct-Kopie). Eine Aufzaehlung dieser Haken waere genau die Fehlerart,
  // die in diesem Uebersetzer dreimal belegt ist: einer fehlt, und der
  // Schnellweg laesst ihn still ausfallen. `int64` schliesst alle acht auf
  // einmal aus — ein breiter, vorzeichenbehafteter Ganzzahltyp ohne Bereich,
  // ohne Einheit, ohne Ablage.
  //
  // Ohne aufgezeichneten Typ (`var i := 0`) lautet die Antwort NEIN, nicht
  // "wahrscheinlich int64": der Typ koennte hergeleitet f64 sein.
  fn cg_lokalIstInt64(ni: int64): int64 {
    if (ni < 0 || self.cg_nkind(ni) != CGN_IDENT) { return 0; }
    var li: int64 := self.cg_findLocalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
    if (li < 0) { return 0; }
    var tb: int64 := self.localTypes + li * CG_LOCTYPE_SZ;
    var tp: pchar := peek64(tb) as pchar;
    var tl: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
    if (tp == 0 as pchar || tl <= 0) { return 0; }
    if (self.cg_seq(tp, tl, "int64", 5) == 0) { return 0; }
    if (peek8(self.localIsSimd + li) != 0) { return 0; }
    if (peek8(self.localIsFnPtr + li) != 0) { return 0; }
    return 1;
  }

  // #2247: `add`/`sub` mit Direktoperand UNMITTELBAR auf r12+i.
  // rlR ist 0..3 (r12..r15), op CGT_PLUS oder CGT_MINUS, k passt in 32 Bit.
  fn cg_regAddImm(rlR: int64, op: int64, k: int64) {
    var ext: int64 := 0;                       // ModRM-reg: /0 = add, /5 = sub
    if (op == CGT_MINUS) { ext := 5; }
    self.cg_e8(0x49);                          // REX.W | REX.B
    if (k >= -128 && k <= 127) {
      self.cg_e8(0x83);
      self.cg_e8(0xC0 | (ext << 3) | (4 + rlR));
      self.cg_e8(k & 255);
    } else {
      self.cg_e8(0x81);
      self.cg_e8(0xC0 | (ext << 3) | (4 + rlR));
      self.cg_e32(k);
    }
  }

  // #2247: `<op> %rax, %r12+i` — der Akkumulator rechnet UNMITTELBAR in
  // seinem Register, der Wert steht in rax. rlR ist 0..3 (r12..r15).
  //
  // Die Richtung ist entscheidend: das Local ist ZIEL, rax die Quelle.
  // 0x01/0x29/0x21/0x09/0x31 rechnen r/m64 <op>= r64, also Register <op>= rax
  // — bei MINUS damit `rX - rax`, die Reihenfolge des Quelltextes. `imul`
  // hat nur die andere Form (reg <- reg * r/m), deshalb dort reg = das
  // Local und rm = rax; die Multiplikation ist kommutativ, das Ergebnis
  // landet richtig.
  //
  // Die Frage wird VOR dem Erzeugen des Wertes gestellt. Ein Rueckzieher
  // waere nicht tragfaehig: cg_genExpr legt neben Befehlsbytes auch
  // Flickstellen, Datenzellen und Zaehler an — codeLen zurueckzusetzen
  // liesse die auf Code zeigen, der danach ueberschrieben wird.
  fn cg_regOpMoeglich(op: int64): int64 {
    if (op == CGT_PLUS || op == CGT_MINUS || op == CGT_STAR) { return 1; }
    if (op == CGT_BITAND || op == CGT_BITOR || op == 89) { return 1; }
    return 0;    // Division, Modulo, Schiebungen, Vergleiche
  }

  fn cg_regOpRax(rlR: int64, op: int64) {
    var opc: int64 := 0 - 1;
    if (op == CGT_PLUS)   { opc := 0x01; }
    if (op == CGT_MINUS)  { opc := 0x29; }
    if (op == CGT_BITAND) { opc := 0x21; }
    if (op == CGT_BITOR)  { opc := 0x09; }
    if (op == 89)         { opc := 0x31; }
    if (opc >= 0) {
      self.cg_e8(0x49);                                 // REX.W | REX.B
      self.cg_e8(opc);
      self.cg_e8(0xC0 | (4 + rlR));                     // mod=11, reg=rax, rm=r12+i
      return;
    }
    if (op == CGT_STAR) {
      self.cg_e8(0x4C);                                 // REX.W | REX.R
      self.cg_e8(0x0F); self.cg_e8(0xAF);               // imul r12+i, rax
      self.cg_e8(0xC0 | ((4 + rlR) << 3));
      return;
    }
    // Der Aufrufer hat cg_regOpMoeglich nicht gefragt. Laut scheitern, nie
    // still etwas Plausibles tun.
    EPrintStr("lyxc: interner Fehler (#2247): cg_regOpRax ohne erzeugbare Operation: "c);
    EPrintInt(op); EPrintStr("\n"c);
    exit(70);
  }

  fn cg_binOpKommutativ(op: int64): int64 {
    if (op == CGT_PLUS || op == CGT_STAR) { return 1; }
    if (op == CGT_BITAND || op == CGT_BITOR || op == 89) { return 1; }
    if (op == CGT_EQ2 || op == CGT_NEQ) { return 1; }
    return 0;
  }

  fn cg_binOpLocalRechts(op: int64, lhsNi: int64, rhsNi: int64): int64 {
    var lN: int64 := lhsNi;
    var rN: int64 := rhsNi;
    var off: int64 := self.cg_einfachesLocalOff(rN);
    // #2247: `local + <Ausdruck>` ist der Akkumulator einer Schleife
    // (`sum += peek32(...)`). Ungetauscht rettet der allgemeine Weg das Local
    // mit push/pop ueber die Auswertung der rechten Seite und haengt damit an
    // einer Store->Load-Weiterleitung je Glied; getauscht bleibt `add rax,
    // local` uebrig. Gemessen am Kern sum32 aus bench/arr_int.lyx: 12 Befehle
    // je Element auf 2.
    //
    // Der Tausch zieht die Auswertung der rechten Seite VOR das Lesen des
    // Locals. Das ist nur dann folgenlos, wenn die rechte Seite das Local
    // nicht schreiben kann — deshalb ausschliesslich fuer ein Local im
    // Register (#2114): dessen Slot wird nirgends als Speicher benutzt, es
    // ist also nicht ueber eine Adresse erreichbar. Ein Local im Rahmen,
    // dessen Adresse genommen wurde, bliebe angreifbar.
    if (off == 0 && self.cg_binOpKommutativ(op) != 0) {
      var offL: int64 := self.cg_einfachesLocalOff(lN);
      if (offL != 0 && self.cg_rlReg(offL) >= 0) {
        lN := rhsNi;
        rN := lhsNi;
        off := offL;
      }
    }
    if (off == 0) { return 0; }
    if (self.cg_isF64Expr(lN) != 0 || self.cg_isF64Expr(rN) != 0) { return 0; }
    var opc: int64 := -1;
    if (op == CGT_PLUS)   { opc := 0x03; }
    if (op == CGT_MINUS)  { opc := 0x2B; }
    if (op == CGT_BITAND) { opc := 0x23; }
    if (op == CGT_BITOR)  { opc := 0x0B; }
    if (op == 89)         { opc := 0x33; }
    if (op == CGT_EQ2 || op == CGT_NEQ || op == CGT_LT || op == CGT_LE || op == CGT_GT || op == CGT_GE) { opc := 0x3B; }
    var istMul: int64 := 0;
    if (op == CGT_STAR) { istMul := 1; }
    if (opc < 0 && istMul == 0) { return 0; }
    // #2247: Steht LINKS ebenfalls ein Local im Register und ist die
    // Operation ein VERGLEICH, braucht die linke Seite kein rax: `cmp r15,
    // r12` statt `mov r12,rax ; cmp r15,rax`. Das ist der Schleifentest
    // `i < n` und spart dort einen von drei Befehlen je Durchlauf.
    //
    // Nur fuer den Vergleich. Die Rechenoperationen schreiben ihren linken
    // Operanden (`add rax, X` legt das Ergebnis in rax ab) — mit dem Local
    // als Ziel wuerde die Variable selbst ueberschrieben. `cmp` setzt nur
    // Flaggen und laesst beide Operanden stehen.
    var lReg: int64 := 0 - 1;
    if (opc == 0x3B && istMul == 0) {
      var lOff: int64 := self.cg_einfachesLocalOff(lN);
      if (lOff != 0) { lReg := self.cg_rlReg(lOff); }
    }
    if (lReg < 0) { self.cg_genExpr(lN); }
    self.cmpAnfang := self.codeLen;   // #2228: Anfang eines moeglichen cmp
    // Registerfeld des Befehls: rax (0) oder das Local links (r12+i -> 4+i,
    // dann REX.R). Die Richtung bleibt dieselbe wie auf dem allgemeinen Weg
    // — opcode 0x3B rechnet reg MINUS rm, also links minus rechts.
    var regF: int64 := 0;
    var rexR: int64 := 0;
    if (lReg >= 0) { regF := 4 + lReg; rexR := 4; }
    var rlR: int64 := self.cg_rlReg(off);
    if (rlR >= 0) {
      // Local im Register: dieselbe Operation mit Registeroperand (r12+i).
      self.cg_e8(0x48 | rexR | 1);                               // REX.W|R?|B
      if (istMul != 0) { self.cg_e8(0x0F); self.cg_e8(0xAF); }   // imul rax, r12+i
      else             { self.cg_e8(opc); }
      self.cg_e8(0xC0 | ((regF & 7) << 3) | (4 + rlR));
    } else {
    self.cg_e8(0x48 | rexR);
    if (istMul != 0) { self.cg_e8(0x0F); self.cg_e8(0xAF); }     // imul rax, [rbp+off]
    else             { self.cg_e8(opc); }
    if (off >= -128 && off <= 127) { self.cg_e8(0x40 | ((regF & 7) << 3) | 5); self.cg_e8(off & 255); }
    else                           { self.cg_e8(0x80 | ((regF & 7) << 3) | 5); self.cg_e32(off); }
    }
    var cmpU: int64 := self.cg_isUnsignedExpr(lN) | self.cg_isUnsignedExpr(rN);
    if (opc == 0x3B) {
      self.cg_emitSetccRax(op, cmpU);
    } else if ((op == CGT_PLUS || op == CGT_MINUS || op == CGT_STAR) && self.overflowCheckEnabled != 0) {
      self.cg_emitOverflowPanic();
    }
    return 1;
  }

  // ------------------------------------------------------------------
  // #2114: skalare Locals in r12..r15.
  //
  // Bis 1.2.17D lag jedes Local im Rahmen; eine Rechenschleife lief damit
  // ueber Store->Load-Weiterleitung (4-5 Takte je Glied) und war latenz-
  // gebunden — auch mit kuerzerem Code (Direktoperanden) nicht schneller.
  //
  // Der Slot bleibt reserviert, nur das Laden und Speichern geht ueber
  // cg_loadRax/cg_storeRax/cg_storeRdx, die fuer ein registerresidentes Local
  // auf das Register umlenken. Alle Zugriffe, die einen Local-Versatz
  // ANDERS benutzen (Adresse, Erfassung, Feldbasis), sind entweder durch die
  // Auswahl ausgeschlossen oder melden sich laut (cg_rlNichtImRegister).
  //
  // Die Auswahl ist DETERMINISTISCH (Gewicht, dann Deklarationsreihenfolge)
  // und fuegt keinen Sprung ein — Konstantzeit-Code bleibt verzweigungsfrei.
  // ------------------------------------------------------------------

  // Register (0..3 = r12..r15) des Locals mit diesem Slot, sonst -1.
  fn cg_rlReg(off: int64): int64 {
    if (self.rlAnz == 0 || off == 0) { return 0 - 1; }
    var i: int64 := 0;
    while (i < self.rlAnz) {
      var b: int64 := self.rlTab + i * 48;
      var sb: int64 := peek64(b + 32);
      var j: int64 := 0;
      while (j < peek64(b + 16)) {
        if (peek64(sb + j * 8) == off) { return i; }
        j += 1;
      }
      i += 1;
    }
    return 0 - 1;
  }

  // Ein Zugriff, der den Slot als SPEICHER braucht, auf ein Local im
  // Register: die Auswahl haette es ausschliessen muessen. Laut, nie still.
  fn cg_rlNichtImRegister(off: int64, wo: pchar) {
    if (self.cg_rlReg(off) < 0) { return; }
    EPrintStr("lyxc: interner Fehler (#2114): Local im Register an einer Stelle, die seinen Speicher braucht: "c);
    EPrintStrLn(wo);
    exit(70);
  }

  // Deklaration eines gewaehlten Locals: Slot dem Register zuordnen.
  fn cg_rlBinde(knoten: int64, off: int64) {
    var i: int64 := 0;
    while (i < self.rlAnz) {
      var b: int64 := self.rlTab + i * 48;
      if (peek64(self.rlKnoten + i * 8) == knoten) {
        var ns: int64 := peek64(b + 16);
        if (ns >= peek64(b + 40)) {
          var nc: int64 := peek64(b + 40) * 2;
          var nbuf: int64 := alloc(nc * 8);
          memcpy(nbuf, peek64(b + 32), ns * 8);
          poke64(b + 32, nbuf); poke64(b + 40, nc);
        }
        poke64(peek64(b + 32) + ns * 8, off);
        poke64(b + 16, ns + 1);
        return;
      }
      i += 1;
    }
  }


  // Ist der Typknoten ein 64-Bit-Ganzzahltyp ohne Sonderbehandlung (keine
  // Kuerzung, keine Einheit, kein Bereich, kein Gleitkomma)?
  fn cg_rlTypOk(tn: int64): int64 {
    if (tn < 0 || self.cg_nkind(tn) != 60) { return 0; }
    var p: pchar := self.cg_nsval(tn);
    var l: int64 := self.cg_nslen(tn);
    if (self.cg_findUtype(p, l) >= 0) { return 0; }
    if (self.cg_rangeOfTypeNode(tn) >= 0) { return 0; }
    if (self.cg_seq(p, l, "int64"c, 5) || self.cg_seq(p, l, "uint64"c, 6)) { return 1; }
    if (self.cg_seq(p, l, "i64"c, 3) || self.cg_seq(p, l, "u64"c, 3)) { return 1; }
    // #2228: Zeiger sind ein Maschinenwort wie int64 und gehen ueber dieselben
    // Lade-/Speicherwege (cg_loadRax/cg_storeRax): pchar und Referenzen auf
    // Klassen. NICHT Wert-Structs (cg_istWertStruct): deren Inhalt liegt im
    // Rahmen selbst, der Slot ist kein Wert, der in ein Register passt.
    if (self.cg_seq(p, l, "pchar"c, 5)) { return 1; }
    var ci: int64 := self.cg_findClass(p, l);
    if (ci >= 0 && self.cg_istWertStruct(ci) == 0) { return 1; }
    return 0;
  }

  // #2228: Name eines Kandidaten — fuer `self` (Kandidatenknoten = Methode)
  // nicht der Methodenname, sondern "self".
  fn cg_rlKNameP(k: int64): pchar {
    if (k == self.rlSelfKnoten && k >= 0) { return "self"c; }
    return self.cg_nsval(k);
  }
  fn cg_rlKNameL(k: int64): int64 {
    if (k == self.rlSelfKnoten && k >= 0) { return 4; }
    return self.cg_nslen(k);
  }

  // #2228: Kandidat zu genau diesem Deklarationsknoten, sonst -1.
  fn cg_rlKnotenIdx(kb: int64, kn: int64, knoten: int64): int64 {
    var i: int64 := 0;
    while (i < kn) {
      if (peek64(kb + i * 40) == knoten) { return i; }
      i += 1;
    }
    return 0 - 1;
  }

  // #2228: Unter den gleichnamigen Kandidaten der mit dem hoechsten Stempel
  // (zuletzt im Durchgang deklariert); ohne Stempel der erste.
  fn cg_rlZuletzt(kb: int64, kn: int64, np: pchar, nl: int64): int64 {
    var best: int64 := 0 - 1;
    var bestS: int64 := 0 - 1;
    var i: int64 := 0;
    while (i < kn) {
      var k: int64 := peek64(kb + i * 40);
      if (self.cg_rlKNameL(k) == nl && self.cg_seq(self.cg_rlKNameP(k), nl, np, nl)) {
        if (best < 0 || peek64(kb + i * 40 + 32) > bestS) { best := i; bestS := peek64(kb + i * 40 + 32); }
      }
      i += 1;
    }
    return best;
  }

  // Kandidatenpuffer: je 40 Byte {Knoten, Gewicht, ok, Deklarationen, Stempel}.
  fn cg_rlKandIdx(kb: int64, kn: int64, np: pchar, nl: int64): int64 {
    if (nl <= 0) { return 0 - 1; }
    var i: int64 := 0;
    while (i < kn) {
      var k: int64 := peek64(kb + i * 40);
      if (self.cg_rlKNameL(k) == nl && self.cg_seq(self.cg_rlKNameP(k), nl, np, nl)) { return i; }
      i += 1;
    }
    return 0 - 1;
  }

  // Durchgang ueber einen Rumpf (Kanten wie cg_nestWalkOne: AT_DIRECTIVE
  // traegt in c0 einen Wert, c3 ist nur bei FOR_C ein Knoten).
  //   modus 0: Kandidaten sammeln, Ausschlussgruende fuer die ganze Funktion
  //   modus 1: Nutzungen gewichten, Konflikte je Name
  // Rueckgabe des Puffers in kbBox: [0] Puffer, [8] Anzahl, [16] Ausschluss.
  fn cg_rlLauf(ni: int64, modus: int64, tiefe: int64, kbBox: int64, rek: int64) {
    var cur: int64 := ni;
    while (cur >= 0) {
      if (rek > 400) { poke64(kbBox + 16, 1); return; }
      var k: int64 := self.cg_nkind(cur);
      if (k == CGN_AT_DIRECTIVE) { cur := self.cg_nnext(cur); continue; }
      if (k == CGN_TRY || k == CGN_DEFER || k == CGN_ASM || k == CGN_CLOSURE || k == CGN_FUNC_DECL
          || k == CGN_TUPLE_VAR_DECL) {
        poke64(kbBox + 16, 1);
      }
      var kb: int64 := peek64(kbBox);
      var kn: int64 := peek64(kbBox + 8);
      if (modus == 0 && k == CGN_VAR_DECL && (self.cg_nival(cur) & 4) == 0
          && self.cg_rlTypOk(self.cg_nc0(cur)) != 0 && kn < 64) {
        var nb: int64 := kb + kn * 40;
        poke64(nb, cur); poke64(nb + 8, 0); poke64(nb + 16, 1); poke64(nb + 24, 0); poke64(nb + 32, 0);
        poke64(kbBox + 8, kn + 1);
      }
      if (modus == 1) {
        var ki: int64 := self.cg_rlKandIdx(kb, kn, self.cg_nsval(cur), self.cg_nslen(cur));
        if (ki >= 0) {
          if (k == CGN_IDENT) {
            // #2228: Gewicht an die zuletzt gesehene gleichnamige Deklaration.
            // Ungenau bei Verdeckung — das betrifft nur die Auswahl, nicht die
            // Korrektheit: gebunden wird ueber den Knoten (cg_rlBinde), und
            // welcher Slot gemeint ist, entscheidet der Codegen selbst.
            var kz: int64 := self.cg_rlZuletzt(kb, kn, self.cg_nsval(cur), self.cg_nslen(cur));
            var kr: int64 := kb + kz * 40;
            var gw: int64 := 1;
            var t: int64 := tiefe;
            if (t > 3) { t := 3; }
            while (t > 0) { gw := gw * 8; t -= 1; }
            poke64(kr + 8, peek64(kr + 8) + gw);
          } else if (k == CGN_VAR_DECL && self.cg_rlKnotenIdx(kb, kn, cur) >= 0) {
            // #2228: JEDE Deklaration hat ihren eigenen Kandidaten. Bis
            // 1.2.19J schied ein Name mit zweiter Deklaration ganz aus —
            // `var i` in zwei Schleifen sperrte beide —, weil ueber den
            // Namen gebunden wurde.
            var kd: int64 := kb + self.cg_rlKnotenIdx(kb, kn, cur) * 40;
            poke64(kd + 24, peek64(kd + 24) + 1);
            poke64(kbBox + 32, peek64(kbBox + 32) + 1);
            poke64(kd + 32, peek64(kbBox + 32) + 1);
          } else if (k != CGN_VAR_DECL) {
            // Jede andere Nennung desselben Namens (Laufvariable,
            // Musterbindung, gleichnamiges Feld …): nicht waehlen. Diese
            // Formen legen Locals auf anderen Wegen an; ob sie denselben Slot
            // meinen, ist hier nicht sicher zu entscheiden.
            var ka: int64 := 0;
            while (ka < kn) {
              var kq: int64 := peek64(kb + ka * 40);
              if (self.cg_rlKNameL(kq) == self.cg_nslen(cur)
                  && self.cg_seq(self.cg_rlKNameP(kq), self.cg_nslen(cur), self.cg_nsval(cur), self.cg_nslen(cur))) {
                poke64(kb + ka * 40 + 16, 0);
              }
              ka += 1;
            }
          }
        }
        // `@x` — die Adresse eines Locals im Register gibt es nicht.
        if (k == CGN_UNOP && self.cg_nival(cur) == 111) {
          var ai: int64 := self.cg_nc0(cur);
          if (ai >= 0 && self.cg_nkind(ai) == CGN_IDENT) {
            var ak: int64 := self.cg_rlKandIdx(kb, kn, self.cg_nsval(ai), self.cg_nslen(ai));
            if (ak >= 0) { poke64(kb + ak * 40 + 16, 0); }
          }
        }
      }
      var schleife: int64 := 0;
      if (k == CGN_WHILE || k == CGN_FOR || k == CGN_FOR_C || k == CGN_FOR_RANGE || k == CGN_REPEAT_UNTIL) { schleife := 1; }
      self.cg_rlLauf(self.cg_nc0(cur), modus, tiefe + schleife, kbBox, rek + 1);
      self.cg_rlLauf(self.cg_nc1(cur), modus, tiefe + schleife, kbBox, rek + 1);
      self.cg_rlLauf(self.cg_nc2(cur), modus, tiefe + schleife, kbBox, rek + 1);
      if (k == CGN_FOR_C) { self.cg_rlLauf(self.cg_nc3(cur), modus, tiefe + 1, kbBox, rek + 1); }
      cur := self.cg_nnext(cur);
    }
  }

  // Waehlt fuer die Funktion fni (Parameterliste c0, Rumpf c2) bis zu vier
  // Locals fuer r12..r15. Ausgeschlossen sind Funktionen, deren Rahmen von
  // aussen gelesen oder per longjmp betreten wird: innere Funktionen und
  // Lambdas (Erfassung ueber den Rahmen), try (der Handler setzt r12..r15 auf
  // den Stand beim Eintritt zurueck), defer (Landepunkt per longjmp), asm,
  // Debug-Information (DWARF nennt den Slot).
  fn cg_rlWaehlen(fni: int64) {
    if (self.rlAnz != 0) {
      EPrintStrLn("lyxc: interner Fehler (#2114): Registerzuteilung einer Funktion noch aktiv"c);
      exit(70);
    }
    if (self.debugMode != 0 || self.debugInfoEnabled != 0) { return; }
    if (self.cg_nestIdx(fni) >= 0) { return; }
    if (self.closureEnvPtrOff != 0) { return; }
    var body: int64 := self.cg_nc2(fni);
    if (body < 0 || self.cg_nkind(body) != CGN_BLOCK) { return; }
    var kbBox: int64 := alloc(40);
    poke64(kbBox, alloc(64 * 40)); poke64(kbBox + 8, 0); poke64(kbBox + 16, 0);
    poke64(kbBox + 32, 1);   // #2228: Stempelzaehler (Parameter haben 1)
    // Parameter zuerst: ein int64-Parameter ist Kandidat wie ein Local, seine
    // "Deklaration" ist der Spill im Prolog (cg_spillRdi..R9 bzw. die Kopie
    // eines Stapelparameters ueber cg_storeRax). Ein gleichnamiges Local im
    // Rumpf verdeckt ihn — dann scheiden beide aus (Konflikt im Durchgang 1).
    if (self.rlSelfKnoten == fni) {
      var sb: int64 := peek64(kbBox);
      poke64(sb, fni); poke64(sb + 8, 0); poke64(sb + 16, 1); poke64(sb + 24, 1); poke64(sb + 32, 1);
      poke64(kbBox + 8, 1);
    }
    var pp: int64 := self.cg_nc0(fni);
    while (pp >= 0) {
      var pkn: int64 := peek64(kbBox + 8);
      if (self.cg_nkind(pp) == CGN_PARAM && pkn < 64) {
        var pb: int64 := peek64(kbBox) + pkn * 40;
        var pok: int64 := self.cg_rlTypOk(self.cg_nc0(pp));
        if (self.cg_rlKandIdx(peek64(kbBox), pkn, self.cg_nsval(pp), self.cg_nslen(pp)) >= 0) { pok := 0; }
        poke64(pb, pp); poke64(pb + 8, 0); poke64(pb + 16, pok); poke64(pb + 24, 1);
        poke64(pb + 32, 1);   // #2228: Stempel — vor jeder Deklaration im Rumpf sichtbar
        poke64(kbBox + 8, pkn + 1);
      }
      pp := self.cg_nnext(pp);
    }
    self.cg_rlLauf(body, 0, 0, kbBox, 0);
    if (peek64(kbBox + 16) != 0 || peek64(kbBox + 8) == 0) { return; }
    self.cg_rlLauf(body, 1, 0, kbBox, 0);
    var kb: int64 := peek64(kbBox);
    var kn: int64 := peek64(kbBox + 8);
    // Bis zu vier mit dem hoechsten Gewicht; bei Gleichstand die frueher
    // deklarierte. Mindestens zwei Nutzungen, sonst lohnt es nicht.
    var tab: int64 := alloc(4 * 48);
    var knt: int64 := alloc(4 * 8);
    var n: int64 := 0;
    while (n < 4) {
      var best: int64 := 0 - 1;
      var bestW: int64 := 1;
      var i: int64 := 0;
      while (i < kn) {
        var r: int64 := kb + i * 40;
        if (peek64(r + 16) != 0 && peek64(r + 24) == 1 && peek64(r + 8) > bestW) {
          best := i; bestW := peek64(r + 8);
        }
        i += 1;
      }
      if (best < 0) { break; }
      var br: int64 := kb + best * 40;
      var bk: int64 := peek64(br);
      poke64(tab + n * 48, self.cg_rlKNameP(bk) as int64);
      poke64(tab + n * 48 + 8, self.cg_rlKNameL(bk));
      poke64(tab + n * 48 + 16, 0);
      poke64(tab + n * 48 + 24, 0);
      poke64(tab + n * 48 + 32, alloc(8 * 8));
      poke64(tab + n * 48 + 40, 8);
      poke64(knt + n * 8, bk);
      poke64(br + 16, 0);
      n += 1;
    }
    self.rlKnoten := knt;
    self.rlTab := tab;
    self.rlAnz := n;
  }

  // #2114: Bedingung auswerten und den Opcode eines Sprungs "wenn falsch"
  // emittieren (0F 8x, das rel32 setzt der Aufrufer). Endet die Bedingung
  // mit `setcc al; movzx rax, al` (jeder Ganzzahlvergleich), werden diese
  // sieben Byte zurueckgenommen und durch j(nicht cc) ersetzt: dieselben
  // Flags, die setcc gelesen haette, und derselbe EINE bedingte Sprung, der
  // vorher hinter `test rax, rax` stand — kein zusaetzlicher (Konstantzeit,
  // #2114 Punkt 3). Sonst wie bisher `test rax, rax; jz`.
  //
  // Nur fuer einen Vergleich als Wurzel (79..84) und ohne Gleitkomma: dort
  // springt kein Code in die Mitte der setcc-Folge.
  fn cg_genSprungWennFalsch(cond: int64) {
    var start: int64 := self.codeLen;
    self.cg_genExpr(cond);
    var verschm: int64 := 0;
    if (cond >= 0 && self.cg_nkind(cond) == CGN_BINOP && self.codeLen - start >= 7) {
      var op: int64 := self.cg_nival(cond);
      if (op >= CGT_EQ2 && op <= CGT_GE
          && self.cg_isF64Expr(self.cg_nc0(cond)) == 0 && self.cg_isF64Expr(self.cg_nc1(cond)) == 0) {
        var e: int64 := self.code + self.codeLen;
        if (peek8(e - 7) == 0x0F && (peek8(e - 6) & 0xF0) == 0x90 && peek8(e - 5) == 0xC0
            && peek8(e - 4) == 0x48 && peek8(e - 3) == 0x0F && peek8(e - 2) == 0xB6 && peek8(e - 1) == 0xC0) {
          var cc: int64 := peek8(e - 6) & 15;
          self.codeLen := self.codeLen - 7;
          // #2228: das Paar cmp+jcc darf keine 32-Byte-Grenze kreuzen
          // (JCC-Erratum, siehe cg_paarAusrichten). Nur wenn der Anfang des cmp
          // sicher bekannt ist: gesetzt von der Stelle, die ihn ausgegeben hat,
          // innerhalb dieser Bedingung und hoechstens 7 Byte lang.
          if (self.cmpAnfang >= start && self.cmpAnfang < self.codeLen
              && self.codeLen - self.cmpAnfang <= 7) {
            self.cg_paarAusrichten(self.cmpAnfang, 6);
          }
          self.cg_e8(0x0F); self.cg_e8(0x80 | (cc ^ 1));         // j(nicht cc) rel32
          verschm := 1;
        }
      }
    }
    if (verschm == 0) {
      self.cg_paarAusrichten(self.codeLen, 9);                  // #2228: test+jz zusammen
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);    // test rax, rax
      self.cg_e8(0x0F); self.cg_e8(0x84);                       // jz rel32
    }
  }

  // #2228: JCC-Erratum (Intel Skylake bis Coffee Lake, mit dem Microcode von
  // 2019): ein bedingter Sprung — als makrofusioniertes Paar mit seinem cmp/
  // test —, der eine 32-Byte-Grenze KREUZT oder an ihr ENDET, wird nicht mehr
  // aus dem uop-Cache geliefert. Gemessen am Sortieren (std/sort.lyx,
  // Partition): eine Fassung, deren Schleifensprung `jge` bei 0x15a5d..62 die
  // Grenze 0x15a60 kreuzte, lief 8-10 % langsamer als eine mit EINEM Befehl
  // weniger davor. gcc behandelt das mit -mbranches-within-32B-boundaries.
  //
  // Das Paar beginnt bei `anfang` (schon ausgegeben bis codeLen) und ist
  // insgesamt (codeLen - anfang) + `rest` Byte lang. Kreuzt es, werden vor
  // `anfang` NOPs eingeschoben, bis es an der naechsten Grenze beginnt.
  // Zwischen anfang und codeLen steht nur der cmp/test selbst — ohne Patch,
  // ohne Sprungziel (die Bedingung beginnt davor).
  //
  // Die Adresse rechnet mit dem Textbeginn des ELF-Programms (Datei-Offset
  // 0xb0, also 16 mod 32). In anderen Ausgabeformaten ist die Ausrichtung
  // dann nur ungenau, nie falsch: NOPs aendern keine Bedeutung.
  fn cg_paarAusrichten(anfang: int64, rest: int64) {
    var a: int64 := anfang + 0xb0;
    var ende: int64 := self.codeLen + rest + 0xb0;          // exklusiv
    if ((a >> 5) == ((ende - 1) >> 5) && (ende & 31) != 0) { return; }
    var pad: int64 := 32 - (a & 31);
    var lang: int64 := self.codeLen - anfang;
    var i: int64 := 0;
    while (i < pad) { self.cg_e8(0x90); i += 1; }            // Platz schaffen (codeLen waechst, Puffer ok)
    // cmp/test nach hinten verschieben (von hinten, die Bereiche ueberlappen).
    // Kein Sprungpatch — das Ziel des Waechters cg_patchRel8 (#1915) sind
    // Sprungweiten, hier werden ganze Befehlsbytes umgesetzt.
    var quelle: int64 := self.code + anfang;
    var ziel:   int64 := quelle + pad;
    i := lang - 1;
    while (i >= 0) {
      poke8(ziel + i, peek8(quelle + i));
      i -= 1;
    }
    self.cg_nopsSchreiben(anfang, pad);
  }

  // #2247: Den naechsten Befehl auf eine 32-Byte-Grenze legen.
  //
  // Gedacht fuer die handgeschriebenen Bausteine, deren innere Spruenge NICHT
  // einzeln ausgerichtet werden koennen: ihre rel8-Weiten stehen fest und
  // ihre Flickstellen sind als Versatz vermerkt, eine Fuellung MITTEN im
  // Baustein wuerde beides verschieben. Ausgerichtet wird deshalb der
  // Baustein als GANZES — dann liegt sein Inneres immer gleich, und die
  // Pruefung in tests/sprung_ausrichtung_2244_test.sh haelt es fest.
  //
  // Ohne das entscheidet die Laenge des davorstehenden Codes darueber, ob ein
  // innerer Sprung eine Grenze kreuzt: beim IntToStr-Baustein endete `jmp
  // .itsdone` je nach Lage genau auf einer Grenze (JCC-Erratum, #2244).
  // Gemessen am Testprogramm von #2244 traf das 120 von 1056 jmp, allein
  // weil die Schleifenverwaltung (#2247) ein paar Befehle kuerzer wurde.
  fn cg_auf32() {
    var pad: int64 := 32 - ((self.codeLen + 0xb0) & 31);
    if (pad == 32) { return; }
    var pos: int64 := self.codeLen;
    var i: int64 := 0;
    while (i < pad) { self.cg_e8(0x90); i += 1; }
    self.cg_nopsSchreiben(pos, pad);
  }

  // Mehrbyte-NOPs (Intel-Empfehlung) in [pos, pos+n) schreiben.
  fn cg_nopsSchreiben(pos: int64, n: int64) {
    var p: int64 := pos;
    var rest: int64 := n;
    while (rest > 0) {
      var k: int64 := rest;
      if (k > 9) { k := 9; }
      var b: int64 := self.code + p;
      if (k == 1) { poke8(b, 0x90); }
      else if (k == 2) { poke8(b, 0x66); poke8(b + 1, 0x90); }
      else if (k == 3) { poke8(b, 0x0F); poke8(b + 1, 0x1F); poke8(b + 2, 0x00); }
      else if (k == 4) { poke8(b, 0x0F); poke8(b + 1, 0x1F); poke8(b + 2, 0x40); poke8(b + 3, 0x00); }
      else if (k == 5) { poke8(b, 0x0F); poke8(b + 1, 0x1F); poke8(b + 2, 0x44); poke8(b + 3, 0x00); poke8(b + 4, 0x00); }
      else if (k == 6) { poke8(b, 0x66); poke8(b + 1, 0x0F); poke8(b + 2, 0x1F); poke8(b + 3, 0x44); poke8(b + 4, 0x00); poke8(b + 5, 0x00); }
      else if (k == 7) { poke8(b, 0x0F); poke8(b + 1, 0x1F); poke8(b + 2, 0x80); poke32(b + 3, 0); }
      else if (k == 8) { poke8(b, 0x0F); poke8(b + 1, 0x1F); poke8(b + 2, 0x84); poke8(b + 3, 0x00); poke32(b + 4, 0); }
      else { poke8(b, 0x66); poke8(b + 1, 0x0F); poke8(b + 2, 0x1F); poke8(b + 3, 0x84); poke8(b + 4, 0x00); poke32(b + 5, 0); }
      p += k;
      rest -= k;
    }
  }

  // #2114: Ist der Ausdruck "rein" — nur Ganzzahl-Locals, Konstanten und
  // Arithmetik, kein Aufruf, kein Systemaufruf, kein Gleitkomma? Dann
  // beruehrt seine Auswertung nur rax/rbx/rcx/rdx und die Halteregister
  // oberhalb des eigenen (cg_lhsRhsNachRbxRax), und ein linker Operand kann
  // dort statt auf dem Stapel warten.
  // #2114: links nach rbx, rechts nach rax (die Konvention von cg_emitBinOp).
  // Ist die rechte Seite rein (cg_exprRein) und r11 frei, wartet links in
  // r11 statt auf dem Stapel — push/pop lag auf dem kritischen Pfad jeder
  // Rotation `(x << k) | (x >> m)` (Store->Load-Weiterleitung). r10 nicht:
  // dort liegt beim Aufruf einer inneren Funktion der statische Link.
  //
  // #2228: Nicht nur r11, sondern ein kleiner STAPEL von Halteregistern —
  // r11, r9, r8, rdi, rsi, in dieser Reihenfolge. r11Belegt zaehlt, wie
  // viele davon gerade einen wartenden linken Operanden halten. Mit nur r11
  // fiel jede zweite Verschachtelung auf push/pop zurueck: in SHA-256
  // `((a >> 13) | (a << 19))` innerhalb eines Ausdrucks, der schon in r11
  // wartete — 17,5 % der Befehle des Blocks waren push/pop.
  //
  // Warum die vier zusaetzlichen frei sind: eine reine rechte Seite
  // (cg_exprRein) rechnet nur ueber rax/rbx/rcx/rdx und die hoeheren
  // Stapelplaetze. Und kein Codegenpfad haelt einen Wert in rdi/rsi/r8/r9
  // ueber ein cg_genExpr hinweg — ein allgemeiner Ausdruck kann ohnehin eine
  // Funktion rufen, die alle vier ueberschreibt (SysV: vom Aufrufer zu
  // sichern). Dieselbe Ueberlegung, die r11 in #2114 zulaessig gemacht hat.
  fn cg_lhsRhsNachRbxRax(lhsNi: int64, rhsNi: int64) {
    if (self.r11Belegt < 5 && self.cg_exprRein(rhsNi, 0) != 0) {
      var h: int64 := self.r11Belegt;
      self.cg_genExpr(lhsNi);
      self.cg_movHalteRax(h);                                      // mov <Halteregister h>, rax
      self.r11Belegt := h + 1;
      self.cg_genExpr(rhsNi);
      self.r11Belegt := h;
      self.cg_movRbxHalte(h);                                      // mov rbx, <Halteregister h>
      return;
    }
    self.cg_genExpr(lhsNi);
    self.cg_pushRax();
    self.cg_genExpr(rhsNi);
    self.cg_popRbx();
  }

  // #2228: Halteregister h (0..4) = r11, r9, r8, rdi, rsi.
  fn cg_movHalteRax(h: int64) {
    if (h == 0) { self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC3); }        // mov r11, rax
    else if (h == 1) { self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC1); }   // mov r9, rax
    else if (h == 2) { self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC0); }   // mov r8, rax
    else if (h == 3) { self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7); }   // mov rdi, rax
    else if (h == 4) { self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6); }   // mov rsi, rax
    else { EPrintStrLn("lyxc: interner Fehler (#2228): Halteregister ausserhalb 0..4"c); exit(70); }
  }
  fn cg_movRbxHalte(h: int64) {
    if (h == 0) { self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0xDB); }        // mov rbx, r11
    else if (h == 1) { self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0xCB); }   // mov rbx, r9
    else if (h == 2) { self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0xC3); }   // mov rbx, r8
    else if (h == 3) { self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xFB); }   // mov rbx, rdi
    else if (h == 4) { self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF3); }   // mov rbx, rsi
    else { EPrintStrLn("lyxc: interner Fehler (#2228): Halteregister ausserhalb 0..4"c); exit(70); }
  }

  fn cg_exprRein(ni: int64, tiefe: int64): int64 {
    if (ni < 0 || tiefe > 6) { return 0; }
    if (self.cg_tryFold(ni) != 0) { return 1; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_LIT_INT || k == CGN_LIT_BOOL || k == CGN_LIT_CHAR) { return 1; }
    if (self.cg_isF64Expr(ni) != 0) { return 0; }
    if (k == CGN_IDENT) {
      if (self.cg_einfachesLocalOff(ni) == 0) { return 0; }
      var li: int64 := self.cg_findLocalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if (li < 0) { return 0; }
      var tb: int64 := self.localTypes + li * CG_LOCTYPE_SZ;
      var tp: pchar := peek64(tb) as pchar;
      var tl: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
      if (tp == 0 as pchar || tl <= 0) { return 0; }
      return cg_istGanzzahlTypName(tp, tl);
    }
    if (k == CGN_BINOP) {
      var op: int64 := self.cg_nival(ni);
      var ok: int64 := 0;
      if (op >= CGT_PLUS && op <= CGT_PERCENT) { ok := 1; }
      if (op >= CGT_EQ2 && op <= CGT_GE) { ok := 1; }
      if (op == CGT_BITAND || op == CGT_BITOR || op == 89 || op == CGT_SHL || op == CGT_SHR) { ok := 1; }
      if (ok == 0) { return 0; }
      if (self.cg_exprRein(self.cg_nc0(ni), tiefe + 1) == 0) { return 0; }
      return self.cg_exprRein(self.cg_nc1(ni), tiefe + 1);
    }
    return 0;
  }

  fn cg_emitBinOp(op: int64, lhsUnsigned: int64, cmpUnsigned: int64) {
    if (op == CGT_PLUS) {
      // add rax, rbx  (48 01 D8)
      self.cg_e8(0x48); self.cg_e8(0x01); self.cg_e8(0xD8);
      if (self.overflowCheckEnabled != 0) { self.cg_emitOverflowPanic(); }
    } else if (op == CGT_MINUS) {
      // sub rbx, rax; mov rax, rbx  (left - right); mov preserves OF
      self.cg_e8(0x48); self.cg_e8(0x29); self.cg_e8(0xC3);  // sub rbx, rax
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx
      if (self.overflowCheckEnabled != 0) { self.cg_emitOverflowPanic(); }
    } else if (op == CGT_STAR) {
      // imul rax, rbx  (48 0F AF C3)
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xAF); self.cg_e8(0xC3);
      if (self.overflowCheckEnabled != 0) { self.cg_emitOverflowPanic(); }
    } else if (op == CGT_SLASH) {
      // idiv: rax=right(divisor), rbx=left(dividend); want left/right
      // WP-BC-48: --runtime-checks → zero-check divisor before div
      if self.runtimeChecks != 0 {
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x75);                                         // jnz short +rel8
        var pSkipD: int64 := self.codeLen; self.cg_e8(0);
        var msgOffD: int64 := self.dataLen;
        self.cg_edata(100); self.cg_edata(105); self.cg_edata(118); // div
        self.cg_edata(105); self.cg_edata(115); self.cg_edata(105); // isi
        self.cg_edata(111); self.cg_edata(110); self.cg_edata(32);  // on
        self.cg_edata(98);  self.cg_edata(121);  self.cg_edata(32); // by
        self.cg_edata(122); self.cg_edata(101); self.cg_edata(114); // zer
        self.cg_edata(111); self.cg_edata(10);  self.cg_edata(0);   // o\n\0
        self.cg_emitLeaRdiData(msgOffD);
        self.cg_emitPanicBody();
        cg_patchRel8(self.code, pSkipD, self.codeLen);
      }
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);  // mov rcx, rax (divisor)
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx (dividend)
      // #1352: Vergleiche und Rechtsshift richteten sich laengst nach dem
      // Vorzeichen des Typs, Division und Rest nicht — hier stand immer
      // `cqo; idiv`. Bei einem uint64 mit gesetztem oberstem Bit las idiv den
      // Wert als negativ: 2^64-2 durch 2 ergab -1 statt 9223372036854775807.
      if (lhsUnsigned != 0) {
        self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);  // xor rdx, rdx
        self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF1);  // div rcx (vorzeichenlos)
      } else {
        self.cg_e8(0x48); self.cg_e8(0x99);                     // cqo — sign-extend rax → rdx:rax
        self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);  // idiv rcx
      }
    } else if (op == CGT_PERCENT) {
      // same as div but result = rdx (remainder)
      // WP-BC-48: --runtime-checks → zero-check divisor before mod
      if self.runtimeChecks != 0 {
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
        self.cg_e8(0x75);                                         // jnz short +rel8
        var pSkipM: int64 := self.codeLen; self.cg_e8(0);
        var msgOffM: int64 := self.dataLen;
        self.cg_edata(109); self.cg_edata(111); self.cg_edata(100); // mod
        self.cg_edata(117); self.cg_edata(108); self.cg_edata(111); // ulo
        self.cg_edata(32);  self.cg_edata(98);  self.cg_edata(121); //  by
        self.cg_edata(32);  self.cg_edata(122); self.cg_edata(101); //  ze
        self.cg_edata(114); self.cg_edata(111); self.cg_edata(10);  // ro\n
        self.cg_edata(0);                                            // \0
        self.cg_emitLeaRdiData(msgOffM);
        self.cg_emitPanicBody();
        cg_patchRel8(self.code, pSkipM, self.codeLen);
      }
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);  // mov rcx, rax
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx
      if (lhsUnsigned != 0) {                                  // #1352
        self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD2);  // xor rdx, rdx
        self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF1);  // div rcx
      } else {
        self.cg_e8(0x48); self.cg_e8(0x99);                     // cqo
        self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);  // idiv rcx
      }
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD0);  // mov rax, rdx
    } else if (op == CGT_SHL) {
      // shl rbx, cl  (48 D3 E3)  — rax=count → move to cl
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);  // mov rcx, rax
      self.cg_e8(0x48); self.cg_e8(0xD3); self.cg_e8(0xE3);  // shl rbx, cl
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx
    } else if (op == CGT_SHR) {
      // #1125: Der Kommentar sagte seit jeher "sar (signed)", die Bytes taten
      // etwas anderes: ModRM 0xEB ist /5 = SHR, SAR waere /7 = 0xFB. Auf einem
      // vorzeichenbehafteten Typ fuellte der Shift also mit Nullen auf, und
      // `-8 >> 1` ergab 9223372036854775804 statt -4 — still, und das Ergebnis
      // riesig positiv, weshalb typischerweise ein Speicher- oder Indexfehler
      // folgte statt einer Meldung.
      //
      // Auf einem vorzeichenLOSEN Typ (u8..u64) ist das Auffuellen richtig, dort
      // bleibt es bei SHR.
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);  // mov rcx, rax
      self.cg_e8(0x48); self.cg_e8(0xD3);
      if (lhsUnsigned != 0) { self.cg_e8(0xEB); }            // shr rbx, cl (/5)
      else                  { self.cg_e8(0xFB); }            // sar rbx, cl (/7)
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD8);  // mov rax, rbx
    } else if (op == CGT_EQ2) {
      // cmp rbx, rax; sete al; movzx rax, al
      self.cmpAnfang := self.codeLen;                        // #2228
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);  // cmp rbx, rax
      self.cg_e8(0x0F); self.cg_e8(0x94); self.cg_e8(0xC0);  // sete al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_NEQ) {
      self.cmpAnfang := self.codeLen;                        // #2228
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);  // cmp rbx, rax
      self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC0);  // setne al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_LT) {
      self.cmpAnfang := self.codeLen;                        // #2228
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);  // cmp rbx, rax
      self.cg_e8(0x0F);
      if (cmpUnsigned != 0) { self.cg_e8(0x92); }   // setb al  — unsigned <
      else                  { self.cg_e8(0x9C); }   // setl al (rbx < rax)
      self.cg_e8(0xC0);
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_LE) {
      self.cmpAnfang := self.codeLen;                        // #2228
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
      self.cg_e8(0x0F);
      if (cmpUnsigned != 0) { self.cg_e8(0x96); }   // setbe al — unsigned <=
      else                  { self.cg_e8(0x9E); }   // setle al
      self.cg_e8(0xC0);
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_GT) {
      self.cmpAnfang := self.codeLen;                        // #2228
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
      self.cg_e8(0x0F);
      if (cmpUnsigned != 0) { self.cg_e8(0x97); }   // seta al  — unsigned >
      else                  { self.cg_e8(0x9F); }   // setg al
      self.cg_e8(0xC0);
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_GE) {
      self.cmpAnfang := self.codeLen;                        // #2228
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC3);
      self.cg_e8(0x0F);
      if (cmpUnsigned != 0) { self.cg_e8(0x93); }   // setae al — unsigned >=
      else                  { self.cg_e8(0x9D); }   // setge al
      self.cg_e8(0xC0);
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);
    } else if (op == CGT_AND) {
      // logical and: both non-zero → 1
      // rax=right, rbx=left; test both
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);  // test rax, rax
      self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC0);  // setnz al
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0); // movzx rax,al
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xDB);  // test rbx, rbx
      self.cg_e8(0x0F); self.cg_e8(0x95); self.cg_e8(0xC3);  // setnz bl
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xDB); // movzx rbx,bl
      self.cg_e8(0x48); self.cg_e8(0x21); self.cg_e8(0xD8);  // and rax, rbx
    } else if (op == CGT_OR) {
      // logical or
      self.cg_e8(0x48); self.cg_e8(0x09); self.cg_e8(0xD8);  // or rax, rbx
      self.cg_boolRax();
    } else if (op == CGT_BITAND) {
      // bitwise and rax, rbx
      self.cg_e8(0x48); self.cg_e8(0x21); self.cg_e8(0xD8);
    } else if (op == CGT_BITOR) {
      // bitwise or rax, rbx
      self.cg_e8(0x48); self.cg_e8(0x09); self.cg_e8(0xD8);
    } else if (op == 89) {
      // bitwise xor rax, rbx  (TK_BITXOR = 89, no CGT_BITXOR alias)
      self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xD8);
    } else if (op == 88) {
      // bitwise nor: `a |~ b` = ~(a | b)  (TK_NOR = 88)
      // Der Lexer kennt |~ und der Parser gibt ihm eine Praezedenz, emittiert
      // wurde bisher aber nichts -- der Operator fiel in den Catch-all unten
      // und lieferte still 0.
      self.cg_e8(0x48); self.cg_e8(0x09); self.cg_e8(0xD8);  // or  rax, rbx
      self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xD0);  // not rax
    } else {
      // Unbekannter Operator: laut abbrechen statt still 0 zu liefern.
      EPrintStr("error: codegen: unbekannter Binaeroperator "c);
      EPrintInt(op); EPrintStrLn(""c);
      exit(70);
      self.cg_zeroRax();
    }
  }

  // ------------------------------------------------------------------
  // ------------------------------------------------------------------
  // OOP support: class layout table and local type tracking
  // ------------------------------------------------------------------

  // #1152/#1205: Ist `node` eine lokale Variable vom Typ Map<K,V>?
  // Der Typname steht bereits in localTypes — NK_TYPE_NAME traegt "Map" als
  // sVal, CGN_VAR_DECL uebernimmt ihn wie jeden anderen Typnamen. Damit
  // braucht die Unterscheidung kein eigenes Flag-Feld.
  fn cg_localIsMap(node: int64): int64 {
    if (node < 0) { return 0; }
    if (self.cg_nkind(node) != CGN_IDENT) { return 0; }
    var li: int64 := self.cg_findLocalIdx(self.cg_nsval(node), self.cg_nslen(node));
    if (li < 0) {
      // #2150: auch eine MODULVARIABLE kann eine Map sein. Bis 1.2.16B sah
      // der x86-Weg nur Locals, `g[3] := 30` auf `var g: Map<..>` scheiterte
      // als "Element eines Ausdrucks ohne Elementtyp"; der IR-Weg kennt
      // Modulvariablen seit #1812 (_localTypeNode). Ein Local verdeckt die
      // Globale — deshalb erst hier.
      var gi: int64 := self.cg_findGlobalIdx(self.cg_nsval(node), self.cg_nslen(node));
      if (gi < 0) { return 0; }
      var gtp: pchar := peek64(self.globalTypeNames + gi * 16) as pchar;
      var gtn: int64 := peek64(self.globalTypeNames + gi * 16 + 8);
      if (gtn == 3 && self.cg_seq(gtp, gtn, "Map", 3)) { return 1; }
      return 0;
    }
    var tb: int64 := self.localTypes + li * CG_LOCTYPE_SZ;
    var tp: pchar := peek64(tb) as pchar;
    var tn: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
    if (tn == 3 && self.cg_seq(tp, tn, "Map", 3)) { return 1; }
    return 0;
  }

  fn cg_setLocalType(idx: int64, typePtr: pchar, typeLen: int64) {
    var base: int64 := self.localTypes + idx * CG_LOCTYPE_SZ;
    poke64(base,     typePtr as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR, typeLen);
  }

  // #1133: Selektor eintragen, falls noch nicht vorhanden; liefert den Index.
  fn cg_addIfaceSelector(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.ifaceSelCount) {
      var b: int64 := self.ifaceSelList + i * 16;
      if (self.cg_seq(peek64(b) as pchar, peek64(b + 8), name, nameLen) != 0) { return i; }
      i += 1;
    }
    if (self.ifaceSelCount >= self.ifaceSelCap) {
      var nc: int64 := self.ifaceSelCap * 2;
      var nb: int64 := alloc(nc * 16);
      memcpy(nb, self.ifaceSelList, self.ifaceSelCount * 16);
      self.ifaceSelList := nb;
      self.ifaceSelCap  := nc;
    }
    var base: int64 := self.ifaceSelList + self.ifaceSelCount * 16;
    poke64(base,     name as int64);
    poke64(base + 8, nameLen);
    var idx: int64 := self.ifaceSelCount;
    self.ifaceSelCount += 1;
    return idx;
  }

  // #1133: Steht der Name unter den Selektoren? Dann hat er seinen Slot schon.
  fn cg_isIfaceSelector(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.ifaceSelCount) {
      var b: int64 := self.ifaceSelList + i * 16;
      if (self.cg_seq(peek64(b) as pchar, peek64(b + 8), name, nameLen) != 0) { return 1; }
      i += 1;
    }
    return 0;
  }

  // #1133: Vorabpass ueber alle Interface-Deklarationen. Muss VOR dem Bau der
  // Klassen-Layouts laufen: die Slotzahl steht sonst noch nicht fest, und eine
  // Klasse, die frueher gebaut wird als ein spaeter deklariertes Interface,
  // haette zu wenige Slots.
  fn cg_collectIfaceSelectors(head: int64) {
    var cur: int64 := head;
    while (cur != -1) {
      if (self.cg_nkind(cur) == CGN_TYPE_DECL && (self.cg_nival(cur) & 32) != 0) {
        var m: int64 := self.cg_nc1(cur);
        while (m != -1) {
          self.cg_addIfaceSelector(self.cg_nsval(m), self.cg_nslen(m));
          m := self.cg_nnext(m);
        }
      }
      cur := self.cg_nnext(cur);
    }
  }

  // #1138: Zahl auf stderr — Fehlermeldungen gehoeren dorthin, PrintInt
  // schreibt nach stdout.
  fn cg_eprintInt(v: int64) {
    if (v < 0) { EPrintStr("-"c); v := 0 - v; }
    if (v == 0) { EPrintStr("0"c); return; }
    var buf: int64 := alloc(24);
    var pos: int64 := 0;
    while (v > 0) {
      poke8(buf + pos, 48 + (v % 10));
      v := v / 10;
      pos := pos + 1;
    }
    var i: int64 := pos - 1;
    while (i >= 0) {
      sys_write(2, buf + i, 1);
      i := i - 1;
    }
    free(buf, 24);
  }

  fn cg_findClass(name: pchar, nameLen: int64): int64 {
    // #2176: letzte Antwort, Schluessel Zeiger + Laenge + classCount.
    if ((name as int64) == self.fcNameP && nameLen == self.fcNameL
        && self.classCount == self.fcCnt) {
      return self.fcIdx;
    }
    var i: int64 := 0;
    while (i < self.classCount) {
      var base: int64 := self.classLayouts + i * CG_CLASS_SZ;
      var p: pchar := peek64(base) as pchar;
      var n: int64 := peek64(base + CG_PATCH_OFF_NAMEPTR);
      if (n == nameLen && self.cg_seq(p, n, name, nameLen)) {
        self.fcNameP := name as int64; self.fcNameL := nameLen;
        self.fcIdx := i; self.fcCnt := self.classCount;
        return i;
      }
      i += 1;
    }
    self.fcNameP := name as int64; self.fcNameL := nameLen;
    self.fcIdx := -1; self.fcCnt := self.classCount;
    return -1;
  }

  fn cg_getFieldOffset(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    return self.cg_findField(classIdx, fieldName, fieldLen);
  }

  fn cg_findField(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return -1; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar   := peek64(fb) as pchar;
      var n: int64   := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        return peek64(fb + CG_CFIELD_OFF_OFFSET);
      }
      i += 1;
    }
    return -1;
  }

  // #1328/#1203: Deklarierter TYPNAME eines Feldzugriffs `obj.feld`.
  //
  // Die Typbestimmungen des Codegens kannten den Feldzugriff nicht: sie fielen
  // auf 0 durch und behandelten den Wert als Ganzzahl. Bei `Print(t.name)` mit
  // `name: pchar` wurde deshalb die ADRESSE gedruckt, bei `s.lat as int64` mit
  // `lat: f64` das rohe Bitmuster statt der Umrechnung. Ueber eine
  // Zwischenvariable ging beides, weil der Zweig fuer CGN_IDENT den
  // deklarierten Typ liest — genau dieser Unterschied machte die Faelle so
  // verwirrend.
  //
  // Der Typname steht im Feldeintrag der Klassenablage; hier wird er
  // herausgesucht. Laenge in lenBox, 0 wenn der Typ nicht bestimmbar ist
  // (unbekannte Klasse, unbekanntes Feld) — dann bleibt es beim bisherigen
  // Verhalten, unentscheidbar ist nicht falsch.
  fn cg_fieldTypeNameOf(fieldNi: int64, lenBox: int64): pchar {
    poke64(lenBox, 0);
    if (fieldNi < 0) { return 0 as pchar; }
    // #2176: letzte Antwort. Zum Schluessel gehoert pNodes — ein Knotenindex
    // gilt nur in SEINER Tabelle, und der Codegen tauscht sie je Unit
    // (cg_processImportAs). Ohne pNodes im Schluessel wuerde der Merker den
    // Typnamen eines gleichnumerierten Knotens einer anderen Unit liefern.
    if (fieldNi == self.ftnNi && self.pNodes == self.ftnCnt) {
      poke64(lenBox, self.ftnL);
      return self.ftnP as pchar;
    }
    if (self.cg_nkind(fieldNi) != CGN_FIELD) { return 0 as pchar; }
    var ci: int64 := self.cg_objClassIdx(self.cg_nc0(fieldNi));
    if (ci < 0) { return 0 as pchar; }
    var fname: pchar := self.cg_nsval(fieldNi);
    var flen:  int64 := self.cg_nslen(fieldNi);
    var base: int64 := self.classLayouts + ci * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar := peek64(fb) as pchar;
      var n: int64 := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == flen && self.cg_seq(p, n, fname, flen)) {
        var tnl: int64 := peek64(fb + CG_CFIELD_OFF_TYPENAMELEN);
        var tnp: int64 := peek64(fb + CG_CFIELD_OFF_TYPENAMEPTR);
        poke64(lenBox, tnl);
        self.ftnNi := fieldNi; self.ftnP := tnp; self.ftnL := tnl;
        self.ftnCnt := self.pNodes;
        return tnp as pchar;
      }
      i += 1;
    }
    self.ftnNi := fieldNi; self.ftnP := 0; self.ftnL := 0;
    self.ftnCnt := self.pNodes;
    return 0 as pchar;
  }

  // #1963: Der Typname eines Feldes, gesucht ueber den KLASSENINDEX statt
  // ueber den Ausdrucksknoten. Der Schreibpfad hat den Knoten nicht zur Hand,
  // nur Klasse und Feldname. cg_fieldTypeNameOf oben macht dieselbe Suche mit
  // dem Knoten und ruft jetzt hierher durch — zwei Abschriften derselben
  // Schleife waeren genau die Sorte Doppelung, aus der spaeter eine Divergenz
  // wird.
  fn cg_fieldTypeNameIn(classIdx: int64, fieldName: pchar, fieldLen: int64, lenBox: int64): pchar {
    poke64(lenBox, 0);
    if (classIdx < 0) { return 0 as pchar; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar := peek64(fb) as pchar;
      var n: int64 := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        poke64(lenBox, peek64(fb + CG_CFIELD_OFF_TYPENAMELEN));
        return peek64(fb + CG_CFIELD_OFF_TYPENAMEPTR) as pchar;
      }
      i += 1;
    }
    return 0 as pchar;
  }

  fn cg_getFieldClassIdx(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return -1; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar   := peek64(fb) as pchar;
      var n: int64   := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        var tp: pchar := peek64(fb + CG_CFIELD_OFF_TYPENAMEPTR) as pchar;
        var tn: int64 := peek64(fb + CG_CFIELD_OFF_TYPENAMELEN);
        if (tp == 0 as pchar || tn == 0) { return -1; }
        return self.cg_findClass(tp, tn);
      }
      i += 1;
    }
    return -1;
  }

  // B2: ist das Feld vom Typ eines method-Alias (→ fat pointer)? Liest Feld-Typ-Name + Registry.
  fn cg_fieldIsMethodType(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return 0; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar   := peek64(fb) as pchar;
      var n: int64   := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        // A2: method-Typ-Flag (Bit1 von fb+FLAGS), bei Layout-Build gesetzt (inline + Alias).
        return (peek64(fb + CG_CFIELD_OFF_FLAGS) >> 1) & 1;
      }
      i += 1;
    }
    return 0;
  }

  // #1106: Ist `expr` eine ungerufene Methoden-Referenz `obj.Method`?
  //
  // Die Unterscheidung, auf die es ankommt: `obj.name` ist entweder ein FELD
  // (dann wird geladen) oder eine METHODE (dann muss ein fat pointer gebunden
  // werden). Entschieden wird sie am Klassenlayout — ein Name, den die Klasse
  // nicht als Feld führt, ist die Methode. Ohne diese Frage lud `var m: TM :=
  // f.Handle;` das Feld `Handle`, das es nicht gibt: Offset 0, also der
  // VMT-Zeiger, und der Aufruf sprang ins Leere (Exit 139).
  //
  // Der Zieltyp wird zusaetzlich verlangt, damit die Regel eng bleibt: nur wo
  // ein `method(...)`-Alias steht, wird gebunden.
  // #1115: Ein Array als PARAMETER. Der Aufrufer uebergibt den Zeiger auf die
  // Ablage (mit {cap,len}-Kopf, siehe #1109) — im Callee fehlte aber die
  // Merkung "das ist ein Array": localIsArray blieb 0, und der Indexzugriff
  // fiel in den Zweig fuer einen rohen Zeiger. Gelesen wurde damit an der
  // falschen Stelle, geschrieben ins Leere; uebersetzt ohne Meldung.
  //
  // Die Groesse steht im Parametertyp und wird mitgenommen, damit die
  // Bereichspruefung aus #1156 auch hier greift. Der Elementtyp landet wie bei
  // #1109 in localTypes, sonst faende `a[0].feld` die Klasse nicht.
  fn cg_markArrayParam(localIdx: int64, ptypeNode: int64) {
    if (localIdx < 0) { return; }
    if (ptypeNode < 0) { return; }
    // #1197: Bis 1.0.16K griff das nur fuer die FESTE Form `T[N]` (Knotenart
    // 101). Ein `array<T>`/`Array<T>`/`T[]`-Parameter blieb ungemarkt, der
    // Indexzugriff fiel in den Zweig fuer einen rohen Zeiger und las 16 Byte zu
    // frueh — also den {cap,len}-Kopf statt des ersten Elements. `F(v)` gab
    // deshalb eine Adresse zurueck, wechselnd von Lauf zu Lauf. Dieselbe
    // Merkung, die die Deklaration seit jeher setzt, gilt jetzt auch hier.
    var pk: int64 := self.cg_nkind(ptypeNode);
    if (pk == 61) {
      poke8(self.localIsArray + localIdx, 1);
      var dynEl: int64 := self.cg_nc0(ptypeNode);
      if (dynEl >= 0 && self.cg_nkind(dynEl) == 60) {
        var dtn: pchar := self.cg_nsval(dynEl);
        var dtl: int64 := self.cg_nslen(dynEl);
        if (self.cg_findClass(dtn, dtl) >= 0) { self.cg_setLocalType(localIdx, dtn, dtl); }
      }
      return;
    }
    if (pk == 60) {
      var anm: pchar := self.cg_nsval(ptypeNode);
      var anl: int64 := self.cg_nslen(ptypeNode);
      if (self.cg_seq(anm, anl, "Array", 5) || self.cg_seq(anm, anl, "array", 5)) {
        poke8(self.localIsArray + localIdx, 1);
        var genEl: int64 := self.cg_nc1(ptypeNode);
        if (genEl >= 0 && self.cg_nkind(genEl) == 60) {
          var gtn: pchar := self.cg_nsval(genEl);
          var gtl: int64 := self.cg_nslen(genEl);
          if (self.cg_findClass(gtn, gtl) >= 0) { self.cg_setLocalType(localIdx, gtn, gtl); }
        }
      }
      return;
    }
    if (pk != 101) { return; }
    // #1597: Ein `[N]T`-PARAMETER wurde mit 1 vermerkt, eine gleichnamige
    // lokale Variable seit #1155 mit 2 ("feste Groesse"). An dieser einen
    // Ziffer haengt mehr als eine Schranke: der Lesepfad entscheidet an
    // `arrFixedSize == 0`, OB die Elemente inline liegen (dann liefert er die
    // Elementadresse) oder ob die Slots Zeiger tragen (dann laedt er den
    // Zeiger). Ein `[3]Struct` legt Zeiger-Slots an — im Rumpf der Funktion
    // wurde daraus die Adresse des Slots, und `a[0].x` las den Zeiger selbst
    // als Zahl. Zwei Wege, die dasselbe meinen und einander nicht kannten;
    // mit skalaren Elementen fiel es nicht auf, weil dort beide Formen
    // dieselbe Adresse ergeben.
    poke8(self.localIsArray + localIdx, 2);
    var szNode: int64 := self.cg_nc1(ptypeNode);
    if (szNode >= 0 && self.cg_nkind(szNode) == CGN_LIT_INT) {
      poke64(self.localArraySize + localIdx * 8, self.cg_nival(szNode));
    }
    var elTy: int64 := self.cg_nc0(ptypeNode);
    if (elTy >= 0 && self.cg_nkind(elTy) == 60) {
      var etn: pchar := self.cg_nsval(elTy);
      var etl: int64 := self.cg_nslen(elTy);
      if (self.cg_findClass(etn, etl) >= 0) {
        self.cg_setLocalType(localIdx, etn, etl);
      }
    }
  }

  fn cg_isMethodRefExpr(expr: int64): int64 {
    if (expr < 0) { return 0; }
    if (self.cg_nkind(expr) != CGN_FIELD) { return 0; }
    var ci: int64 := self.cg_objClassIdx(self.cg_nc0(expr));
    if (ci < 0) { return 0; }
    if (self.cg_findField(ci, self.cg_nsval(expr), self.cg_nslen(expr)) >= 0) { return 0; }
    return 1;
  }

  // #1106: Wert fuer eine Variable vom `method(...)`-Typ erzeugen. Steht rechts
  // eine Methoden-Referenz, wird gebunden; steht dort ein bereits gebundener
  // fat pointer (Feld, andere Variable), wird schlicht geladen.
  fn cg_genMethodTypedValue(rhs: int64) {
    if (self.cg_isMethodRefExpr(rhs) != 0) { self.cg_genMethodRef(rhs); }
    else { self.cg_genExpr(rhs); }
  }

  // B2: method-Referenz `obj.Method` (ungerufen) → heap-fat-pointer {code, data} (16B); rax = ptr.
  // code = Adresse von Klasse_Method (mangled), data = obj-Instanz-Pointer.
  fn cg_genMethodRef(rhs: int64) {
    var rObj:  int64 := self.cg_nc0(rhs);
    var mName: pchar := self.cg_nsval(rhs);
    var mLen:  int64 := self.cg_nslen(rhs);
    var rcls:  int64 := self.cg_objClassIdx(rObj);
    // 16B-Speicher via anon-mmap(4096) (wie new) → rax = p
    self.cg_movRaxImm(0);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7); // mov rdi,rax
    self.cg_movRaxImm(4096); self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6); // mov rsi,rax
    self.cg_movRaxImm(3);    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC2); // mov rdx,rax
    self.cg_movRaxImm(34);   self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2); // mov r10,rax
    self.cg_movRaxImm(-1);   self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0); // xor r8,r8
    self.cg_e8(0x49); self.cg_e8(0xFF); self.cg_e8(0xC8);                          // dec r8 → -1
    self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);                          // xor r9,r9
    self.cg_movRaxImm(9);    self.cg_e8(0x0F); self.cg_e8(0x05);                    // syscall mmap
    self.cg_emitMmapGeprueft();   // #2144
    self.cg_pushRax();                                                              // [rsp] = p
    // code-Adresse: lea rax,[rip+ Klasse_Method ]
    if (rcls >= 0) {
      var clsBase: int64 := self.classLayouts + rcls * CG_CLASS_SZ;
      var clsName: pchar := peek64(clsBase) as pchar;
      var clsLen:  int64 := peek64(clsBase + CG_CLASS_OFF_NAMELEN);
      var mangLen: int64 := clsLen + 1 + mLen;
      var mangBuf: int64 := alloc(mangLen + 1);
      var mi: int64 := 0;
      while (mi < clsLen) { poke8(mangBuf + mi, StrCharAt(clsName, mi)); mi := mi + 1; }
      StrSetChar(mangBuf as pchar, clsLen, 95);
      var mj: int64 := 0;
      while (mj < mLen) { poke8(mangBuf + clsLen + 1 + mj, StrCharAt(mName, mj)); mj := mj + 1; }
      poke8(mangBuf + mangLen, 0);
      self.cg_emitFuncAddr(mangBuf as pchar, mangLen);   // rax = code
      self.cg_trackTempBuf(mangBuf, mangLen + 1);
    } else {
      self.cg_zeroRax();
    }
    // [p] = code
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x1C); self.cg_e8(0x24);  // mov rbx,[rsp] (p)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x03);                    // mov [rbx], rax
    // data = obj-Instanz → [p+8]
    self.cg_genExpr(rObj);                                                    // rax = data
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x1C); self.cg_e8(0x24);  // mov rbx,[rsp] (p)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x43); self.cg_e8(0x08);  // mov [rbx+8], rax
    self.cg_popRax();                                                         // rax = p (fat ptr)
  }

  // WP-4.1-B: return fb+40 flags for a named field: bit0=bigEndian, bits8..15=typeWidth.
  // Returns 0 if field not found or not big_endian.
  fn cg_getFieldBigEndian(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return 0; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar   := peek64(fb) as pchar;
      var n: int64   := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        return peek64(fb + CG_CFIELD_OFF_FLAGS);
      }
      i += 1;
    }
    return 0;
  }

  // Groesse eines Structs in Byte.
  //
  // #1513: gerechnet wurde `fieldCnt * 8`. Das stimmt nur, solange jedes Feld
  // acht Byte belegt — ein inline `[N]T` (#1052) oder ein Struct als Feld
  // belegt mehr, ein @packed-Feld weniger. Jetzt wird das Ende des letzten
  // Feldes genommen: Offset plus die im Eintrag vermerkte Breite.
  // #1646: Ist dieser Typ ein STRUCT (Wert) oder eine KLASSE (Referenz)?
  // Am Layout ablesbar: ein Struct hat keine VMT, sein VMTOFF ist -1. Der
  // `new`-Pfad unterscheidet seit WP-10d genau so.
  //
  // Der Unterschied entscheidet, was `arr[i] := x` bedeutet: bei einem Struct
  // den INHALT kopieren (Wertsemantik, #1612), bei einer Klasse den ZEIGER
  // ablegen — sonst verliert das Element seine Identitaet, `back == t` waere
  // falsch und Schreibzugriffe erreichten das Original nicht.
  fn cg_istStructTyp(classIdx: int64): int64 {
    if (classIdx < 0) { return 0; }
    if (peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTOFF) == -1) { return 1; }
    return 0;
  }

  // #1836: Speicher fuer `new T()`.
  //
  // Bis 1.1.12B stand hier ein mmap ueber 4096 Byte — je Objekt eine eigene
  // Seite, unabhaengig von seiner Groesse. Ein Objekt mit einem einzigen
  // int64-Feld kostete damit 4 KB residenten Speicher UND einen Syscall:
  // 100.000 Stueck brauchten 400 MB und 1,64 s, waehrend 100.000 x alloc(16)
  // in 7,4 ms und 12 KB fertig waren (Faktor 220 in der Zeit).
  //
  // Jetzt wird aus einem Block herausgegeben: CG_HEAP_PTR zeigt auf die
  // naechste freie Stelle, CG_HEAP_END hinter das Blockende. Passt das Objekt
  // nicht mehr, wird ein neuer Block geholt und der Rest des alten liegen
  // gelassen.
  //
  // KEINE Freiliste, und das ist Absicht: `dispose` gibt Speicher ohnehin
  // nicht zurueck (siehe CGN_DISPOSE), und weil nie etwas wiederverwendet
  // wird, ist jede herausgegebene Stelle frisch aus mmap — also GENULLT. Ein
  // Konstruktor, der ein Feld nicht setzt, findet dort weiterhin 0 vor, genau
  // wie beim bisherigen mmap je Objekt.
  //
  // Die Groesse kommt aus dem Klassenlayout (cg_classStructSize: Ende des
  // weitesten Feldes, Offset 0 ist der VMT-Zeiger, geerbte Felder sind beim
  // Bauen des Layouts eingeflacht). Aufgerundet auf 16, damit die
  // Ausrichtung ueber die Kette erhalten bleibt.
  // #1980: Bump-Belegung mit einer erst zur LAUFZEIT bekannten Groesse.
  //
  // cg_emitNewBump daneben kennt die Groesse beim Uebersetzen (Klassenlayout)
  // und kann sie als Sofortwert einsetzen. Fuer StrConcat steht sie erst zur
  // Laufzeit fest — Laenge a plus Laenge b plus Kopf. Die Rechnung ist
  // dieselbe, nur kommt die Groesse aus einem REGISTER.
  //
  // Erwartet die Groesse in rsi. Liefert den Puffer in rax. rcx wird
  // ueberschrieben.
  //
  // Warum das ueberhaupt sein muss: bis 1.2.3F machte jede Verkettung einen
  // eigenen mmap-Syscall. Der belegt mindestens eine SEITE, also 4096 Byte —
  // gleich, ob das Ergebnis elf Zeichen lang ist oder tausend. Und weil nichts
  // freigegeben wird, wuchs der Speicher linear mit der Zahl der Aufrufe:
  // 100.000 Verkettungen kosteten 400 MB. Genau derselbe Befund wie bei `new`
  // vor #1836.
  fn cg_emitBumpAllocRsi() {
    // Auf 16 aufrunden, damit die Ausrichtung ueber die Kette erhalten bleibt:
    // rsi := (rsi + 15) & ~15
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC6); self.cg_e8(0x0F);   // add rsi, 15
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xE6); self.cg_e8(0xF0);   // and rsi, -16
    self.cg_emitBumpAtomar(0, 0);
  }

  fn cg_emitNewBump(classIdx: int64) {
    // Ohne Layout ist die Groesse unbekannt — dann bleibt es beim alten Weg
    // mit einer ganzen Seite. Das ist verschwenderisch, aber nie zu klein.
    var groesse: int64 := 4096;
    if (classIdx >= 0) {
      groesse := self.cg_classStructSize(classIdx);
      if (groesse < 8) { groesse := 8; }
      var rest: int64 := groesse % 16;
      if (rest != 0) { groesse := groesse + (16 - rest); }
    }
    // Blockgroesse: 64 KB, oder das Objekt selbst, wenn es groesser ist
    // (auf ganze Seiten aufgerundet).
    var block: int64 := 65536;
    if (groesse > block) {
      block := groesse;
      var pr: int64 := block % 4096;
      if (pr != 0) { block := block + (4096 - pr); }
    }
    self.cg_emitBumpAtomar(groesse, block);
  }

  // `jcc rel32` / `jmp rel32` nach vorn: Stelle des rel32 merken, spaeter
  // cg_bumpZiel. Rueckwaerts: cg_bumpZurueck.
  fn cg_bumpZiel(stelle: int64) { poke32(self.code + stelle, self.codeLen - stelle - 4); }
  // #2244: beide Sprungformen des Bump-Blocks liegen nie ueber einer
  // 32-Byte-Grenze (cg_paarAusrichten) — der Block laeuft bei jeder
  // Anforderung (new, IntToStr, StrConcat ...).
  fn cg_bumpZurueck(op: int64, ziel: int64) {
    if (op == 0xE9) { self.cg_paarAusrichten(self.codeLen, 5); } else { self.cg_paarAusrichten(self.codeLen, 6); }
    if (op == 0xE9) { self.cg_e8(0xE9); } else { self.cg_e8(0x0F); self.cg_e8(op); }
    self.cg_e32(ziel - self.codeLen - 4);
  }
  fn cg_bumpVor(op: int64): int64 {
    if (op == 0xE9) { self.cg_paarAusrichten(self.codeLen, 5); } else { self.cg_paarAusrichten(self.codeLen, 6); }
    if (op == 0xE9) { self.cg_e8(0xE9); } else { self.cg_e8(0x0F); self.cg_e8(op); }
    var p: int64 := self.codeLen;
    self.cg_e32(0);
    return p;
  }
  // disp32 eines `[rip + X]`, das den Befehl abschliesst: X = datenOff im Datenbereich.
  fn cg_bumpRip(datenOff: int64) {
    var p: int64 := self.codeLen;
    self.cg_e32(0);
    self.cg_addPatch(p, datenOff, 0, CG_PATCH_STR);
  }

  // #2135: Belegung aus dem Bump-Block — THREADSICHER. Bis 1.2.15A lasen und
  // schrieben zwei Threads CG_HEAP_PTR ohne jede Sperre: beide bekamen
  // dieselbe Stelle und schrieben einander in die Objekte. In einem Programm
  // gibt es nur einen Thread, in einer .so ruft der Host aus beliebig vielen
  // (Java-Threads ueber JNI, pthreads).
  //
  // Schnellweg ohne Sperre: rax = PTR, rcx = rax + Groesse, passt rcx unter
  // END, setzt `lock cmpxchg` PTR von rax auf rcx — nur, wenn kein anderer
  // dazwischen kam; sonst von vorn.
  //
  // Neuer Block unter einer Sperre IN END: END = 1 heisst "es wird gerade ein
  // Block geholt" (rax + Groesse > 1, der Schnellweg faellt also immer in den
  // langsamen, und der wartet). Wer END per cmpxchg von seinem gelesenen Wert
  // auf 1 setzt, holt den Block, schreibt ERST PTR und DANN END (x86 haelt
  // die Reihenfolge zweier Schreibzugriffe) und gibt damit die Sperre frei.
  // Ein Schnellweg, der PTR noch aus dem alten Block las, scheitert danach
  // an seinem cmpxchg, weil PTR sich geaendert hat. Anfangszustand PTR = END
  // = 0: der erste Aufruf nimmt die Sperre von 0 auf 1.
  //
  // groesse > 0: Sofortwert (cg_emitNewBump), block die Blockgroesse.
  // groesse = 0: Groesse in rsi, schon auf 16 gerundet (cg_emitBumpAllocRsi);
  // die Blockgroesse wird zur Laufzeit bestimmt. Ergebnis in rax;
  // ueberschrieben werden rcx, rdx und im langsamen Weg die Syscall-Register.
  // #2206: `ptrOff`/`endOff` benennen die Arena (CG_HEAP_* oder CG_VEC_*),
  // `minBlock` ihre Mindestblockgroesse. Vorher war beides auf den
  // `new`-Heap und 64 KiB festgeschrieben.
  fn cg_emitBumpAtomar(groesse: int64, block: int64) {
    self.cg_emitBumpAtomarIn(groesse, block, CG_HEAP_PTR, CG_HEAP_END, 65536);
  }

  fn cg_emitBumpAtomarIn(groesse: int64, block: int64,
                         ptrOff: int64, endOff: int64, minBlock: int64) {
    var oben: int64 := self.codeLen;
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05); self.cg_bumpRip(ptrOff);   // mov rax, [PTR]
    if (groesse > 0) {
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x88); self.cg_e32(groesse);        // lea rcx, [rax + groesse]
    } else {
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x0C); self.cg_e8(0x30);            // lea rcx, [rax + rsi]
    }
    self.cg_paarAusrichten(self.codeLen, 13);                                              // #2244: cmp+ja als Paar
    self.cg_e8(0x48); self.cg_e8(0x3B); self.cg_e8(0x0D); self.cg_bumpRip(endOff);   // cmp rcx, [END]
    var pLangsam: int64 := self.cg_bumpVor(0x87);                                          // ja langsam
    self.cg_e8(0xF0); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB1); self.cg_e8(0x0D);
    self.cg_bumpRip(ptrOff);                                                          // lock cmpxchg [PTR], rcx
    self.cg_bumpZurueck(0x85, oben);                                                       // jne oben
    var pFertig1: int64 := self.cg_bumpVor(0xE9);                                          // jmp fertig

    // langsam: Sperre nehmen oder warten
    self.cg_bumpZiel(pLangsam);
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x15); self.cg_bumpRip(endOff);   // mov rdx, [END]
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xFA); self.cg_e8(0x01);               // cmp rdx, 1
    var pWarten: int64 := self.cg_bumpVor(0x84);                                           // je warten
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD0);                                 // mov rax, rdx
    self.cg_e8(0xB9); self.cg_e32(1);                                                      // mov ecx, 1
    self.cg_e8(0xF0); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB1); self.cg_e8(0x0D);
    self.cg_bumpRip(endOff);                                                          // lock cmpxchg [END], rcx
    self.cg_bumpZurueck(0x85, oben);                                                       // jne oben (ein anderer war schneller)

    // Sperre gehalten: neuen Block holen. mmap(0, n, PROT_RW, PRIVATE|ANON, -1, 0)
    if (groesse > 0) {
      self.cg_e8(0x31); self.cg_e8(0xFF);                     // xor edi, edi
      self.cg_e8(0xBE); self.cg_e32(block);                   // mov esi, block
    } else {
      // 64 KB, oder die Anforderung selbst, auf ganze Seiten aufgerundet.
      self.cg_e8(0x56);                                       // push rsi (Groesse)
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xF2);   // mov rdx, rsi
      self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xC2); self.cg_e32(4095);    // add rdx, 4095
      self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xE2); self.cg_e32(0 - 4096); // and rdx, -4096
      self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC6); self.cg_e32(minBlock);   // mov rsi, 65536
      self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xF2);   // cmp rdx, rsi
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x47); self.cg_e8(0xF2);     // cmova rsi, rdx
      self.cg_e8(0x56);                                       // push rsi (Blockgroesse)
      self.cg_e8(0x31); self.cg_e8(0xFF);                     // xor edi, edi
    }
    self.cg_e8(0xBA); self.cg_e32(3);                       // mov edx, 3
    self.cg_e8(0x41); self.cg_e8(0xBA); self.cg_e32(34);    // mov r10d, 34
    self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC0);   // mov r8, -1
    self.cg_e32(0 - 1);
    self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);   // xor r9, r9
    self.cg_e8(0xB8); self.cg_e32(9);                       // mov eax, 9
    self.cg_e8(0x0F); self.cg_e8(0x05);                     // syscall → rax = Blockanfang
    // #2144: dieselbe Pruefung wie hinter jedem anderen mmap (#1947). Bis
    // 1.2.16A lief -ENOMEM hier als Blockanfang weiter: PTR/END zeigten in den
    // Fehlerbereich, `new` lieferte 0xFFFF...F4 + n, der erste Feldzugriff
    // faultete (rc 139 ohne Aussage). Die Sperre (END = 1) bleibt dabei
    // stehen — der Prozess endet ohnehin.
    self.cg_emitMmapGeprueft();
    if (groesse > 0) {
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x90); self.cg_e32(block);     // lea rdx, [rax + block]
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x88); self.cg_e32(groesse);   // lea rcx, [rax + groesse]
    } else {
      self.cg_e8(0x5E);                                                             // pop rsi (Blockgroesse)
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x14); self.cg_e8(0x30);       // lea rdx, [rax + rsi]
      self.cg_e8(0x5E);                                                             // pop rsi (Groesse)
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x0C); self.cg_e8(0x30);       // lea rcx, [rax + rsi]
    }
    // Erst PTR, dann END — das zweite gibt die Sperre frei.
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x0D); self.cg_bumpRip(ptrOff);   // mov [PTR], rcx
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x15); self.cg_bumpRip(endOff);   // mov [END], rdx
    var pFertig2: int64 := self.cg_bumpVor(0xE9);                                          // jmp fertig

    // warten: ein anderer holt gerade einen Block
    self.cg_bumpZiel(pWarten);
    self.cg_e8(0xF3); self.cg_e8(0x90);                                                    // pause
    self.cg_bumpZurueck(0xE9, oben);                                                       // jmp oben

    self.cg_bumpZiel(pFertig1);
    self.cg_bumpZiel(pFertig2);
  }

  fn cg_classStructSize(classIdx: int64): int64 {
    if (classIdx < 0) { return 8; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var cnt: int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    if (cnt <= 0) { return 8; }
    if (cnt > 0x1FFFFFFFFFFFFFFF) { return 8; }
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    if (flds == 0) { return cnt * 8; }
    var ende: int64 := 0;
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var b: int64 := peek64(fb + CG_CFIELD_OFF_BYTES);
      if (b <= 0) { b := 8; }
      var e: int64 := peek64(fb + CG_CFIELD_OFF_OFFSET) + b;
      if (e > ende) { ende := e; }
      i += 1;
    }
    if (ende <= 0) { return cnt * 8; }
    // #1516: Die Gesamtgroesse wird auf die groesste Feldausrichtung
    // aufgerundet — sonst richtet ein Array aus diesen Structs schon das erste
    // Feld des zweiten Elements nicht mehr aus (die alten 9 und 17 Byte waren
    // selbst kein Vielfaches von 8). @packed setzt ALIGN auf 1 und rundet nicht.
    var al: int64 := peek64(base + CG_CLASS_OFF_ALIGN);
    if (al > 1) {
      var rest: int64 := ende % al;
      if (rest != 0) { ende := ende + (al - rest); }
    }
    return ende;
  }

  // #1513: Benennt der Typknoten ein STRUCT (kein Klassentyp, keine
  // eingebaute Breite)? Nur dann liegt das Feld inline im Objekt.
  // Klassen bleiben Referenzen und belegen weiterhin acht Byte.
  fn cg_typeIstInlineStruct(typeNode: int64): int64 {
    if (typeNode < 0) { return 0; }
    if (self.cg_nkind(typeNode) != 60) { return 0; }
    var tn: pchar := self.cg_nsval(typeNode);
    var tl: int64 := self.cg_nslen(typeNode);
    if (tl <= 0) { return 0; }
    var ci: int64 := self.cg_findClass(tn, tl);
    if (ci < 0) { return 0; }
    var base: int64 := self.classLayouts + ci * CG_CLASS_SZ;
    // Entscheidend ist die Merkung des PARSERS (STRUCT_FLAG_ISSTRUCT), nicht
    // "hat keine VMT": eine methodenlose KLASSE bekommt ebenfalls
    // Struct-Layout, bleibt aber ein Referenztyp — `var a: A := null` ist dort
    // gueltig und darf nicht kopiert werden.
    if (peek64(base + CG_CLASS_OFF_ISSTRUCT) == 0) { return 0; }
    if (peek64(base + CG_CLASS_OFF_VMTOFF) != -1) { return 0; }
    if (peek64(base + CG_CLASS_OFF_VMTSLOTS) > 0) { return 0; }
    return 1;
  }

  // #1351: Structs hatten keine Wertsemantik — `var b: T := a` und die
  // Parameteruebergabe reichten denselben Zeiger weiter, ein Schreiben auf die
  // "Kopie" traf das Original. Still, ohne Warnung.
  //
  // #1595: Der Bump-Bereich aus #1580 wird nur noch fuer Structs gebraucht,
  // die NICHT selbstenthalten sind — also solche mit einem verschachtelten
  // Struct-Feld, das als ZEIGER liegt statt inline. Bei denen kopiert eine
  // flache Kopie nur den Zeiger; laege das Ziel im Rahmen, waere es nach der
  // Rueckkehr tot. Fuer alle uebrigen kommt der Platz aus dem Rahmen, und
  // dort waechst nichts mehr.
  //
  // Wann ein Feld zum Zeiger wird, entscheidet sich beim Bau des Layouts:
  // stammt der Feldtyp aus einer anderen Unit, ist seine Groesse dort noch
  // nicht bekannt und das Feld bekommt acht Byte. `Circle` aus std.circle ist
  // genau so ein Fall (`center: Vec2` aus std.vector) — sizeof(Circle) ist 16,
  // nicht 24. Das ist eine eigene Schwaeche und aelter als diese Aenderung:
  // derselbe Aufbau stuerzt auch mit 1.1.3H ab, wenn der verschachtelte Typ
  // aus einer dritten Unit kommt.

  // Kopiert `bytes` Byte von der Adresse in rax in frischen Speicher und
  // laesst dessen Adresse in rax zurueck. Alles, was hier benutzt wird, wird
  // vorher gesichert: der Aufrufer sieht nur rax veraendert.
  // #1580: rax := belegte Adresse aus dem Bump-Bereich, um `groesse` weiter.
  //
  // NEBENLAEUFIG: der Zeiger ist geteilt. Die erste Fassung las und schrieb ihn
  // gewoehnlich — zwei Threads bekamen damit DIESELBE Adresse, und der
  // Atomics-Test (vier Threads, tests/thread_concurrency_test.lyx) lief in
  // seine Zeitgrenze, weil beide auf demselben Mutex-Speicher arbeiteten.
  // Deshalb `lock cmpxchg`: gewinnt ein anderer Thread das Rennen, wird der
  // Versuch wiederholt.
  //
  // Reicht der Rest nicht, holt der Thread sich einen eigenen Block. Rennen
  // sich zwei Threads dabei, kostet das im schlimmsten Fall einen ungenutzten
  // Block — jeder bekommt gueltigen, eigenen Speicher.
  //
  // rdi/rsi/rcx bleiben unberuehrt: der Aufrufer benutzt sie unmittelbar
  // danach fuer `rep movsq`.
  fn cg_emitStructArenaAlloc(groesse: int64) {
    if (self.structArenaOff < 0) {
      // Die beiden Zeiger werden mit `lock cmpxchg` fortgeschrieben. Ein
      // unausgerichteter atomarer Zugriff sperrt nicht die Cache-Zeile,
      // sondern den BUS — gemessen rund 1,9 Mikrosekunden je Belegung statt
      // weniger als 20 Nanosekunden. Der Datenbereich haette sie sonst an
      // eine ungerade Adresse gelegt (0x…17f).
      while ((self.dataLen & 7) != 0) { self.cg_edata(0); }
      self.structArenaOff := self.cg_reserveData(16);
    }
    var aOff: int64 := self.structArenaOff;
    self.cg_e8(0x52);                                          // push rdx
    var retry: int64 := self.codeLen;
    // rax = [arena]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x05);
    var p1: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(p1, aOff, 0, CG_PATCH_STR);
    // rdx = rax + groesse
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x90); self.cg_e32(groesse);
    // cmp rdx, [arena+8]
    self.cg_e8(0x48); self.cg_e8(0x3B); self.cg_e8(0x15);
    var p2: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(p2, aOff + 8, 0, CG_PATCH_STR);
    self.cg_e8(0x77);                                          // ja .nachlegen
    var jaPos: int64 := self.codeLen; self.cg_e8(0);
    // lock cmpxchg [arena], rdx   (rax = erwarteter alter Wert)
    self.cg_e8(0xF0); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB1); self.cg_e8(0x15);
    var p3: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(p3, aOff, 0, CG_PATCH_STR);
    // #2144: jz rel32 statt rel8 — die mmap-Pruefung in .nachlegen
    // (Meldung + Abbruch) macht den Weg laenger als 127 Byte.
    self.cg_e8(0x0F); self.cg_e8(0x84);                        // jz .fertig (rax = alte Adresse)
    var jzPos: int64 := self.codeLen; self.cg_e32(0);
    self.cg_e8(0xEB);                                          // jmp retry
    self.cg_e8((retry - self.codeLen - 1) & 255);
    // --- .nachlegen: eigener Block per mmap(1 MiB) ---
    cg_patchRel8(self.code, jaPos, self.codeLen);
    self.cg_e8(0x57); self.cg_e8(0x56); self.cg_e8(0x51);      // push rdi, rsi, rcx
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xFF);      // xor rdi, rdi
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC6); self.cg_e32(1048576);
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e32(3);
    self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e32(34);
    self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0);      // xor r8, r8
    self.cg_e8(0x49); self.cg_e8(0xFF); self.cg_e8(0xC8);      // dec r8 -> -1
    self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);      // xor r9, r9
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e32(9);
    self.cg_e8(0x0F); self.cg_e8(0x05);                        // syscall
    self.cg_emitMmapGeprueft();   // #2144
    self.cg_e8(0x59); self.cg_e8(0x5E); self.cg_e8(0x5F);      // pop rcx, rsi, rdi
    // [arena+8] := rax + 1 MiB ; [arena] := rax + groesse ; rax bleibt der Block
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x90); self.cg_e32(1048576);  // lea rdx,[rax+1MiB]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x15);      // mov [arena+8], rdx
    var p4: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(p4, aOff + 8, 0, CG_PATCH_STR);
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x90); self.cg_e32(groesse);  // lea rdx,[rax+groesse]
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x15);      // mov [arena], rdx
    var p5: int64 := self.codeLen; self.cg_e32(0);
    self.cg_addPatch(p5, aOff, 0, CG_PATCH_STR);
    // .fertig
    poke32(self.code + jzPos, self.codeLen - jzPos - 4);
    self.cg_e8(0x5A);                                          // pop rdx
  }

  // #1595: `ci` ist der Klassenindex des kopierten Typs (-1 = unbekannt). Nur
  // ein selbstenthaltenes Struct darf seine Kopie im Rahmen halten; bei einem
  // verschachtelten Struct-Feld, das als Zeiger liegt, muss der Speicher die
  // Rueckkehr ueberleben.
  fn cg_emitStructKopieVon(bytes: int64, ci: int64) {
    if (bytes <= 0) { return; }
    var worte: int64 := (bytes + 7) / 8;
    var imRahmen: int64 := 0;
    var kopieOff: int64 := 0;
    if (ci >= 0 && self.cg_structSelbstEnthalten(ci, 0) != 0) {
      imRahmen := 1;
      kopieOff := self.cg_reserveFrame(worte * 8);
    }
    self.cg_e8(0x50);                                        // push rax (Quelle)
    // #1580: Bis 1.1.0A stand hier ein mmap JE KOPIE — zwei je Rueckgabe eines
    // Structs, und nie ein munmap. Das kostete rund 32 Mikrosekunden statt
    // 0,05 (Faktor ~640, zwei Systemaufrufe und zwei Seiten Verwaltung je
    // Aufruf) und liess den Speicher unbegrenzt wachsen: 200 000 Rueckgaben
    // belegten 1,6 GB, weil mmap immer eine ganze Seite gibt.
    //
    // Jetzt kommt der Platz aus einem Bump-Bereich: die naechste freie Adresse
    // steht im Datensegment, die Belegung ist eine Addition. Nachgelegt wird
    // seitenweise (1 MiB), also einmal je 65 536 Paaren statt einmal je Kopie.
    if (imRahmen != 0) {
      self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x85); self.cg_e32(kopieOff);  // lea rax,[rbp+off]
    } else {
      self.cg_emitStructArenaAlloc(worte * 8);
    }
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);    // mov rdi, rax (Ziel)
    self.cg_e8(0x5E);                                        // pop rsi (Quelle)
    self.cg_e8(0x57);                                        // push rdi
    self.cg_movRaxImm(worte);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);    // mov rcx, rax
    self.cg_e8(0xF3); self.cg_e8(0x48); self.cg_e8(0xA5);    // rep movsq
    self.cg_e8(0x58);                                        // pop rax (Ziel)
  }

  // #1595: alte Form ohne Klassenindex — sie kann die Frage nicht beantworten
  // und bleibt deshalb beim Bump-Bereich.
  fn cg_emitStructKopie(bytes: int64) { self.cg_emitStructKopieVon(bytes, 0 - 1); }

  // #1351: Inhalt kopieren, statt den Zeiger zu tauschen. `b := a` schreibt in
  // den Speicher, den b schon hat — eine Neubindung waere bei einem Wertetyp
  // von aussen nicht zu unterscheiden, wuerde aber jedes `var`-Ziel neu
  // allokieren und den alten Inhalt verlieren, auf den ein Feldzugriff
  // vielleicht schon zeigt.
  // rax = Quelle, [rbp+dstOff] = Ziel.
  fn cg_emitStructKopieNach(dstOff: int64, bytes: int64) {
    if (bytes <= 0) { return; }
    var worte: int64 := (bytes + 7) / 8;
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);   // mov rsi, rax
    self.cg_loadRax(dstOff);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC7);   // mov rdi, rax
    self.cg_movRaxImm(worte);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);   // mov rcx, rax
    self.cg_e8(0xF3); self.cg_e8(0x48); self.cg_e8(0xA5);   // rep movsq
  }

  // Traegt das Local einen Struct-Typ? Liefert die Groesse in Byte, sonst 0.
  fn cg_localWertStructBytes(name: pchar, nlen: int64): int64 {
    var li: int64 := self.cg_findLocalIdx(name, nlen);
    if (li < 0) { return 0; }
    var tb: int64 := self.localTypes + li * CG_LOCTYPE_SZ;
    var tp: pchar := peek64(tb) as pchar;
    var tl: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
    if (tp == 0 as pchar || tl <= 0) { return 0; }
    if (peek8(self.localIsArray + li) != 0) { return 0; }
    var ci: int64 := self.cg_findClass(tp, tl);
    if (ci < 0) { return 0; }
    var base: int64 := self.classLayouts + ci * CG_CLASS_SZ;
    if (peek64(base + CG_CLASS_OFF_ISSTRUCT) == 0) { return 0; }
    if (peek64(base + CG_CLASS_OFF_VMTOFF) != -1) { return 0; }
    if (peek64(base + CG_CLASS_OFF_VMTSLOTS) > 0) { return 0; }
    if (peek64(base + CG_CLASS_OFF_PARENTIDX) >= 0) { return 0; }
    return self.cg_classStructSize(ci);
  }

  // Ist der Typknoten ein Struct — also etwas, das nach Wert kopiert gehoert?
  // Klassen bleiben Referenzen; `new` gibt sie aus, geteilt wird mit Absicht.
  fn cg_typeIstWertStruct(typeNode: int64): int64 {
    if (typeNode < 0) { return 0; }
    if (self.cg_nkind(typeNode) != 60) { return 0; }
    var ci: int64 := self.cg_findClass(self.cg_nsval(typeNode), self.cg_nslen(typeNode));
    if (ci < 0) { return 0; }
    var base: int64 := self.classLayouts + ci * CG_CLASS_SZ;
    if (peek64(base + CG_CLASS_OFF_ISSTRUCT) == 0) { return 0; }
    if (peek64(base + CG_CLASS_OFF_VMTOFF) != -1) { return 0; }
    if (peek64(base + CG_CLASS_OFF_VMTSLOTS) > 0) { return 0; }
    if (peek64(base + CG_CLASS_OFF_PARENTIDX) >= 0) { return 0; }
    return 1;
  }

  fn cg_inlineStructBytes(typeNode: int64): int64 {
    var ci: int64 := self.cg_findClass(self.cg_nsval(typeNode), self.cg_nslen(typeNode));
    if (ci < 0) { return 8; }
    return self.cg_classStructSize(ci);
  }

  // #1513: Wieviele Byte belegt dieses Feld? Fuer inline liegende Structs die
  // Groesse des Structs, sonst acht.
  fn cg_fieldBytes(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return 8; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar := peek64(fb) as pchar;
      var n: int64 := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        var b: int64 := peek64(fb + CG_CFIELD_OFF_BYTES);
        if (b <= 0) { return 8; }
        return b;
      }
      i += 1;
    }
    return 8;
  }

  // #1595: Klassenindex des FELDTYPS — gebraucht, um zu erkennen, ob in ein
  // Feld ein Struct-WERT geschrieben wird, das Feld den Wert aber nur als
  // Zeiger aufnimmt.
  fn cg_feldTypKlasse(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return -1; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar := peek64(fb) as pchar;
      var n: int64 := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        var tp: pchar := peek64(fb + CG_CFIELD_OFF_TYPENAMEPTR) as pchar;
        var tl: int64 := peek64(fb + CG_CFIELD_OFF_TYPENAMELEN);
        if (tp == 0 as pchar || tl <= 0) { return -1; }
        return self.cg_findClass(tp, tl);
      }
      i += 1;
    }
    return -1;
  }

  // Returns class index of the element type of an Array<T> field, or -1
  fn cg_getFieldElemClassIdx(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return -1; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar := peek64(fb) as pchar;
      var n: int64 := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        var ep: pchar := peek64(fb + CG_CFIELD_OFF_ELEMTYPEPTR) as pchar;
        var el: int64 := peek64(fb + CG_CFIELD_OFF_ELEMTYPELEN);
        if (ep == 0 as pchar || el == 0) { return -1; }
        return self.cg_findClass(ep, el);
      }
      i += 1;
    }
    return -1;
  }

  // #1156: Bereichspruefung fuer einen Indexzugriff. rax = Basiszeiger,
  // rbx = Index; beide bleiben erhalten, wenn der Zugriff gueltig ist.
  //
  // `--runtime-checks` versprach seit jeher "bounds, null, zero" und emittierte
  // fuer Indizes nichts: ein Zugriff ausserhalb las den Speicher hinter dem
  // Array und lief weiter. Eine Option, die Pruefungen zusagt und keine
  // erzeugt, ist schlimmer als gar keine — sie begruendet Vertrauen, das
  // nichts traegt.
  //
  //   fixedSz > 0 : Groesse steht zur Uebersetzungszeit fest -> gegen Immediate
  //   isDyn  != 0 : dynamisches Array mit {cap,len}-Kopf     -> gegen [rax+8]
  //   sonst       : es gibt keine Laenge (roher Zeiger, pchar) — nichts zu
  //                 pruefen. Das ist eine benannte Luecke, kein stiller Default.
  //
  // Der Vergleich ist UNSIGNED (jb): ein negativer Index ist als vorzeichenlose
  // Zahl riesig und faellt damit in denselben Zweig wie ein zu grosser.
  fn cg_emitIndexBoundsCheck(fixedSz: int64, isDyn: int64) {
    // #1124: `@bounds_check(true)` fordert die Pruefung AN und wirkt damit auch
    // ohne --runtime-checks. Umgekehrt schaltet `@bounds_check(false)` sie ab,
    // auch wenn die Option gesetzt ist — die Direktive steht naeher am Code.
    if (self.boundsCheckEnabled == 0) { return; }   // @bounds_check(false)
    if (self.runtimeChecks == 0 && self.boundsCheckForced == 0) { return; }
    if (fixedSz > 0) {
      // cmp rbx, imm32
      self.cg_e8(0x48); self.cg_e8(0x81); self.cg_e8(0xFB); self.cg_e32(fixedSz);
    } else if (isDyn != 0) {
      // cmp rbx, [rax+8]   (Laenge des dynamischen Arrays)
      self.cg_e8(0x48); self.cg_e8(0x3B); self.cg_e8(0x58); self.cg_e8(0x08);
    } else {
      return;
    }
    self.cg_e8(0x72);                                  // jb short .ok
    var pSkip: int64 := self.codeLen; self.cg_e8(0);
    var msgOff: int64 := self.dataLen;
    var msg: pchar := "index out of bounds\n"c;
    var mi: int64 := 0;
    while (mi < 20) { self.cg_edata(StrCharAt(msg, mi)); mi := mi + 1; }
    self.cg_edata(0);
    self.cg_emitLeaRdiData(msgOff);
    self.cg_emitPanicBody();
    cg_patchRel8(self.code, pSkip, self.codeLen);
  }

  // #1255: `new T[n]` — Belegung mit einer erst zur Laufzeit bekannten Laenge.
  // Dieselbe Form wie ein festes `[N]T`: {cap,len}-Kopf, dann n Slots zu 8
  // Byte. Der Kopf ist nicht schmueckend — die dynamische Bereichspruefung
  // liest die Laenge aus [rax+8], und `len(a)` liest denselben Slot.
  // #1506: `new T` fuer einen EINZELWERT. Bewusst OHNE {cap,len}-Kopf: der
  // Zeiger zeigt auf die Zelle selbst, `poke64(p, 42)` schreibt also den Wert
  // und nicht in den Kopf. `new T[1]` bleibt das Array mit einem Element —
  // die beiden Formen unterscheiden sich, und zwar sichtbar.
  fn cg_genArrayNewEins() {
    self.cg_movRaxImm(8);                                                     // eine Zelle
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);                     // mov rsi, rax
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xFF);                     // xor rdi, rdi
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e32(3);     // rdx = PROT_READ|WRITE
    self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e32(34);    // r10 = MAP_PRIVATE|ANON
    self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0);                     // xor r8, r8
    self.cg_e8(0x49); self.cg_e8(0xFF); self.cg_e8(0xC8);                     // dec r8 -> fd = -1
    self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);                     // xor r9, r9
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e32(9);     // rax = SYS_mmap
    self.cg_e8(0x0F); self.cg_e8(0x05);                                       // syscall
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0x00); self.cg_e32(0);     // Zelle nullen
  }

  fn cg_genArrayNew(cntNi: int64) {
    self.cg_genArrayNewEx(cntNi, 0);
  }

  // #1508: nurKapazitaet = 1 -> Kopf traegt cap = n, len = 0.
  fn cg_genArrayNewEx(cntNi: int64, nurKapazitaet: int64) {
    self.cg_genExpr(cntNi);              // rax = n
    // Eine Laenge <= 0 waere ein negatives oder leeres mmap: es scheiterte,
    // lieferte -errno, und der Kopf-Schreibzugriff darauf stuerzte ab. Melden
    // statt danebenzutreffen.
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xF8); self.cg_e8(0x00);  // cmp rax, 0
    self.cg_e8(0x7F);                                   // jg short .ok
    var pSkip: int64 := self.codeLen; self.cg_e8(0);
    var msgOff: int64 := self.dataLen;
    var msg: pchar := "new T[n]: Laenge muss > 0 sein\n"c;
    var mi: int64 := 0;
    while (mi < 31) { self.cg_edata(StrCharAt(msg, mi)); mi := mi + 1; }
    self.cg_edata(0);
    self.cg_emitLeaRdiData(msgOff);
    self.cg_emitPanicBody();
    cg_patchRel8(self.code, pSkip, self.codeLen);
    self.cg_pushRax();                                                        // n retten
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);                     // mov rsi, rax
    self.cg_e8(0x48); self.cg_e8(0xC1); self.cg_e8(0xE6); self.cg_e8(0x03);   // shl rsi, 3
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC6); self.cg_e8(0x10);   // add rsi, 16 (Kopf)
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xFF);                     // xor rdi, rdi
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e32(3);     // mov rdx, PROT_READ|WRITE
    self.cg_e8(0x49); self.cg_e8(0xC7); self.cg_e8(0xC2); self.cg_e32(34);    // mov r10, MAP_PRIVATE|ANON
    self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC0);                     // xor r8, r8
    self.cg_e8(0x49); self.cg_e8(0xFF); self.cg_e8(0xC8);                     // dec r8 -> fd = -1
    self.cg_e8(0x4D); self.cg_e8(0x31); self.cg_e8(0xC9);                     // xor r9, r9
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0); self.cg_e32(9);     // mov rax, SYS_mmap
    self.cg_e8(0x0F); self.cg_e8(0x05);                                       // syscall
    self.cg_e8(0x5B);                                                         // pop rbx (n)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x18);                     // mov [rax], rbx    (cap)
    if (nurKapazitaet != 0) {
      // #1508: `new T[](n)` — Platz fuer n, aber noch nichts drin.
      self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0x40); self.cg_e8(0x08); self.cg_e32(0);  // mov qword [rax+8], 0
    } else {
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x58); self.cg_e8(0x08); // mov [rax+8], rbx  (len)
    }
  }

  // Returns 1 if the named class field has type "Array<T>" (any T), 0 otherwise.
  // #1052: rax = [rax + rbx*w], breitengerecht (unsigned erweitert).
  fn cg_emitScaledLoadRax(w: int64) {
    if (w == 1) {
      // movzx rax, byte [rax+rbx*1]
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0x04); self.cg_e8(0x18);
    } else if (w == 2) {
      // movzx rax, word [rax+rbx*2]
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB7); self.cg_e8(0x04); self.cg_e8(0x58);
    } else if (w == 4) {
      // mov eax, [rax+rbx*4]  (nullt die oberen 32 Bit)
      self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0x98);
    } else {
      // mov rax, [rax+rbx*8]
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0xD8);
    }
  }

  // #1052: [rax + rbx*w] := rsi, breitengerecht.
  fn cg_emitScaledStore(w: int64) {
    if (w == 1) {
      // mov [rax+rbx*1], sil
      self.cg_e8(0x40); self.cg_e8(0x88); self.cg_e8(0x34); self.cg_e8(0x18);
    } else if (w == 2) {
      // mov [rax+rbx*2], si
      self.cg_e8(0x66); self.cg_e8(0x89); self.cg_e8(0x34); self.cg_e8(0x58);
    } else if (w == 4) {
      // mov [rax+rbx*4], esi
      self.cg_e8(0x89); self.cg_e8(0x34); self.cg_e8(0x98);
    } else {
      // mov [rax+rbx*8], rsi
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x34); self.cg_e8(0xD8);
    }
  }

  // #1052: Adresse eines inline-Array-Feldes nach rax. Fuer ein gewoehnliches
  // Feld liefert cg_genExpr den INHALT; ein inline liegendes Array hat aber
  // keinen Zeiger, seine Daten stehen unmittelbar an der Feldadresse.
  // Liefert die Elementbreite, oder 0 wenn `fieldNode` kein solches Feld ist —
  // dann hat der Aufrufer nichts emittiert bekommen.
  fn cg_emitInlineArrayAddr(fieldNode: int64): int64 {
    if (fieldNode < 0) { return 0; }
    if (self.cg_nkind(fieldNode) != CGN_FIELD) { return 0; }
    var innerObj: int64 := self.cg_nc0(fieldNode);
    var fldNm: pchar := self.cg_nsval(fieldNode);
    var fldNl: int64 := self.cg_nslen(fieldNode);
    var ci: int64 := self.cg_objClassIdx(innerObj);
    var w: int64 := self.cg_fieldInlineElemW(ci, fldNm, fldNl);
    if (w <= 0) { return 0; }
    var off: int64 := self.cg_getFieldOffset(ci, fldNm, fldNl);
    if (off < 0) { return 0; }
    self.cg_genExpr(innerObj);                 // rax = Objektzeiger
    if (off > 0) {
      // lea rax, [rax + off]
      if (off <= 127) {
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x40); self.cg_e8(off);
      } else {
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x80); self.cg_e32(off);
      }
    }
    return w;
  }

  // #1052: Zahl der Elemente eines `[N]T`-Typknotens (NK_TYPE_ARRAY_FIXED=101),
  // 0 wenn der Knoten keiner ist oder N kein Ganzzahl-Literal.
  fn cg_arrayFixedCount(typeNode: int64): int64 {
    if (typeNode < 0) { return 0; }
    if (self.cg_nkind(typeNode) != 101) { return 0; }
    var sizeNode: int64 := self.cg_nc1(typeNode);
    if (sizeNode < 0) { return 0; }
    if (self.cg_nkind(sizeNode) != CGN_LIT_INT) { return 0; }
    var n: int64 := self.cg_nival(sizeNode);
    if (n <= 0) { return 0; }
    return n;
  }

  // #1052: Elementbreite eines INLINE-Array-Feldes (`items: [4]int64`), sonst 0.
  // Abgegrenzt von cg_isFieldArray, das ausschliesslich `Array<T>` erkennt —
  // eine Heap-Struktur mit 16-Byte-Kopf. Ein inline geschriebenes Array liegt
  // dagegen unmittelbar im Objekt; sein Feldname bezeichnet die ADRESSE, nicht
  // einen Zeiger auf die Daten.
  fn cg_fieldInlineElemW(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return 0; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar := peek64(fb) as pchar;
      var n: int64 := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        var fl: int64 := peek64(fb + CG_CFIELD_OFF_FLAGS);
        if (((fl >> 3) & 1) == 0) { return 0; }
        return (fl >> 8) & 0xFF;
      }
      i += 1;
    }
    return 0;
  }

  fn cg_isFieldArray(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return 0; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar := peek64(fb) as pchar;
      var n: int64 := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fieldLen && self.cg_seq(p, n, fieldName, fieldLen)) {
        var tp: pchar := peek64(fb + CG_CFIELD_OFF_TYPENAMEPTR) as pchar;
        var tl: int64 := peek64(fb + CG_CFIELD_OFF_TYPENAMELEN);
        if (tp != 0 as pchar && tl == 5 && self.cg_seq(tp, tl, "Array", 5)) { return 1; }
        return 0;
      }
      i += 1;
    }
    return 0;
  }

  // WP-4.1-B: emit BSWAP/XCHG on rax after loading a big_endian field (load result in rax).
  fn cg_emitBswapRax(typeWidth: int64) {
    if (typeWidth == 2) {
      // XCHG al, ah: 86 C4
      self.cg_e8(0x86); self.cg_e8(0xC4);
      // movzx rax, ax: 48 0F B7 C0 (zero-extend to 64 bits)
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB7); self.cg_e8(0xC0);
    } else if (typeWidth == 4) {
      // BSWAP eax: 0F C8 (zeroes upper 32 bits of rax)
      self.cg_e8(0x0F); self.cg_e8(0xC8);
    } else {
      // BSWAP rax: 48 0F C8
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xC8);
    }
  }

  // WP-4.1-B: emit BSWAP/XCHG on rsi before storing a big_endian field (value in rsi).
  fn cg_emitBswapRsi(typeWidth: int64) {
    if (typeWidth == 2) {
      // ROL si, 8: 66 C1 C6 08
      self.cg_e8(0x66); self.cg_e8(0xC1); self.cg_e8(0xC6); self.cg_e8(8);
    } else if (typeWidth == 4) {
      // BSWAP esi: 0F CE
      self.cg_e8(0x0F); self.cg_e8(0xCE);
    } else {
      // BSWAP rsi: 48 0F CE
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xCE);
    }
  }

  fn cg_buildClassLayout(ni: int64) {
    var className: pchar := self.cg_nsval(ni);
    var classLen:  int64 := self.cg_nslen(ni);
    // WP-BC-INH: resolve parent class layout (field flattening + VMT inheritance).
    // Requires the parent class layout to be built already (declaration order).
    var parentNi: int64 := self.cg_nc2(ni);
    var pIdx: int64 := 0 - 1;
    var parentFieldCnt: int64 := 0;
    var parentFldsPtr: int64 := 0;
    if (parentNi >= 0) {
      pIdx := self.cg_findClass(self.cg_nsval(parentNi), self.cg_nslen(parentNi));
      if (pIdx >= 0) {
        parentFieldCnt := peek64(self.classLayouts + pIdx * CG_CLASS_SZ + CG_CLASS_OFF_FIELDCNT);
        parentFldsPtr  := peek64(self.classLayouts + pIdx * CG_CLASS_SZ + CG_CLASS_OFF_FIELDSPTR);
      }
    }
    // Count own fields (child0 chain)
    var fieldNode: int64 := self.cg_nc0(ni);
    var ownCnt: int64 := 0;
    var tmp: int64 := fieldNode;
    while (tmp != -1) { ownCnt := ownCnt + 1; tmp := self.cg_nnext(tmp); }
    // Total fields = inherited base fields + own fields
    var cnt: int64 := parentFieldCnt + ownCnt;
    // Allocate field array (base fields flattened first, then own)
    var flds: int64 := alloc((cnt + 1) * CG_CFIELD_SZ);
    // Copy inherited base-class field entries verbatim — their offsets (8,16,…)
    // stay valid because every class reserves offset 0 for the VMT pointer.
    if (parentFieldCnt > 0) { memcpy(flds, parentFldsPtr, parentFieldCnt * CG_CFIELD_SZ); }
    // WP-10a: offset 0 = VMT ptr; own fields continue after the base fields.
    //
    // #1630: Hier stand `8 + parentFieldCnt * 8` — die Rechnung unterstellte,
    // dass JEDES Feld der Basisklasse acht Byte belegt. Ein inline liegendes
    // `[64]int64` belegt aber 512. Das erste eigene Feld der Ableitung landete
    // damit MITTEN im Array der Basisklasse und ueberschrieb es samt der
    // dahinter liegenden Basisfelder — ohne Warnung, der Code lief.
    //
    // Die Basisfelder wurden gerade eben mitsamt ihren Offsets und Breiten
    // hierher kopiert; das Ende ergibt sich also aus ihnen selbst.
    var offset: int64 := 8;
    var pf: int64 := 0;
    while (pf < parentFieldCnt) {
      var pfb: int64 := flds + pf * CG_CFIELD_SZ;
      var pfBytes: int64 := peek64(pfb + CG_CFIELD_OFF_BYTES);
      if (pfBytes <= 0) { pfBytes := 8; }
      var pfEnde: int64 := peek64(pfb + CG_CFIELD_OFF_OFFSET) + pfBytes;
      if (pfEnde > offset) { offset := pfEnde; }
      pf := pf + 1;
    }
    while ((offset & 7) != 0) { offset := offset + 1; }   // 8er-Ausrichtung
    var i: int64 := parentFieldCnt;
    tmp := fieldNode;
    while (tmp != -1) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      poke64(fb,      self.cg_nsval(tmp) as int64);
      poke64(fb + CG_CFIELD_OFF_FIELDLEN,  self.cg_nslen(tmp));
      poke64(fb + CG_CFIELD_OFF_OFFSET, offset);
      poke64(fb + CG_CFIELD_OFF_ELEMTYPEPTR, 0);
      poke64(fb + CG_CFIELD_OFF_ELEMTYPELEN, 0);
      var ftypeNode: int64 := self.cg_nc0(tmp);
      if (ftypeNode >= 0 && self.cg_nkind(ftypeNode) == 60) {
        var ftn: pchar := self.cg_nsval(ftypeNode);
        var ftl: int64 := self.cg_nslen(ftypeNode);
        poke64(fb + CG_CFIELD_OFF_TYPENAMEPTR, ftn as int64);
        poke64(fb + CG_CFIELD_OFF_TYPENAMELEN, ftl);
        if (self.cg_seq(ftn, ftl, "Array", 5)) {
          var elemNode: int64 := self.cg_nc1(ftypeNode);
          if (elemNode >= 0 && self.cg_nkind(elemNode) == 60) {
            poke64(fb + CG_CFIELD_OFF_ELEMTYPEPTR, self.cg_nsval(elemNode) as int64);
            poke64(fb + CG_CFIELD_OFF_ELEMTYPELEN, self.cg_nslen(elemNode));
          }
        }
      } else {
        poke64(fb + CG_CFIELD_OFF_TYPENAMEPTR, 0);
        poke64(fb + CG_CFIELD_OFF_TYPENAMELEN, 0);
      }
      // WP-4.1-B: store big_endian flag + type width at fb+40
      var beFlag: int64 := (self.cg_nival(tmp) >> 1) & 1;  // bit 1 of field iVal
      var tWidth: int64 := self.cg_typeSize(ftypeNode);
      // A2: method-Typ-Flag (Bit1) — inline `method(...)` ODER method-Alias-Name → fat pointer.
      var isMth: int64 := 0;
      if (ftypeNode >= 0) {
        if (self.cg_nkind(ftypeNode) == CGN_METHOD_PTR) { isMth := 1; }
        else if (self.cg_nkind(ftypeNode) == 60 && self.cg_isMethodType(self.cg_nsval(ftypeNode), self.cg_nslen(ftypeNode)) != 0) { isMth := 1; }
      }
      // #1038: Bit2 = vorzeichenbehafteter Schmaltyp (int8/i8/int16/i16/int32/i32).
      // Der Ladepfad braucht es, um movsx statt movzx zu emittieren.
      // #1052: `feld: [N]T` liegt INLINE im Objekt. Bit3 kennzeichnet das, die
      // Breite in Bits 8..15 ist dann die ELEMENTbreite.
      var inlN: int64 := self.cg_arrayFixedCount(ftypeNode);
      if (inlN > 0) {
        tWidth := self.cg_typeSize(self.cg_nc0(ftypeNode));
        // #1493: Auch bei einem inline `[N]T`-Feld den ELEMENTTYP vermerken.
        // Bis hierher stand er nur bei `Array<T>` — deshalb wusste
        // `b.kids[0].x` nicht, WELCHE Klasse dort liegt, fand kein Feld `x`
        // und lieferte still 0. Mit skalaren Elementen fiel es nicht auf: die
        // brauchen keinen Klassenbezug.
        var inlElem: int64 := self.cg_nc0(ftypeNode);
        if (inlElem >= 0 && self.cg_nkind(inlElem) == 60) {
          poke64(fb + CG_CFIELD_OFF_ELEMTYPEPTR, self.cg_nsval(inlElem) as int64);
          poke64(fb + CG_CFIELD_OFF_ELEMTYPELEN, self.cg_nslen(inlElem));
        }
      }
      var inlBit: int64 := 0;
      if (inlN > 0) { inlBit := 1; }
      // #1513: Bit4 = Struct als Feld, liegt inline (gilt auch in Klassen).
      var inlStr: int64 := 0;
      if (inlN == 0 && self.cg_typeIstInlineStruct(ftypeNode) != 0) { inlStr := 1; }
      poke64(fb + CG_CFIELD_OFF_FLAGS, beFlag | (tWidth << 8) | (isMth << 1) | (self.cg_typeIsSignedNarrow(ftypeNode) << 2) | (inlBit << 3) | (inlStr << 4));
      // #1052: ein inline `[N]T`-Feld belegt N * Elementbreite, nicht 8 Byte.
      // Ohne das ueberlappte das Folgefeld die Arraydaten.
      var breite: int64 := 8;
      if (inlN > 0) { breite := inlN * tWidth; }
      else if (inlStr != 0) { breite := self.cg_inlineStructBytes(ftypeNode); }
      poke64(fb + CG_CFIELD_OFF_BYTES, breite);
      offset := offset + breite;
      i += 1;
      tmp := self.cg_nnext(tmp);
    }
    // WP-BC-19: parent VMT slots for inheritance (parentNi/pIdx resolved above)
    var parentSlotCount: int64 := 0;
    var parentMethodList: int64 := 0;
    if (pIdx >= 0) {
      parentSlotCount  := peek64(self.classLayouts + pIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTSLOTS);
      parentMethodList := peek64(self.classLayouts + pIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTLIST);
    }
    // #1133: Ohne Elternklasse bilden die Selektoren die Basis der VMT — bei
    // JEDER Klasse, nicht nur bei implementierenden. Nur wenn alle dieselbe
    // Basis haben, stimmen die Slotnummern zwischen Elternteil und Kind
    // weiterhin ueberein (die Slot-Weitergabe kopiert stellengleich), und ein
    // Aufruf ueber den Interface-Typ trifft dieselbe Stelle. Mit Elternteil
    // kommen die Selektoren ueber dessen Liste mit, sie stehen dort ebenfalls
    // vorn.
    var selBase: int64 := 0;
    if (pIdx < 0) { selBase := self.ifaceSelCount; }

    // Count own virtual methods that are new (not overriding a parent slot)
    var ownMethodCount: int64 := 0;
    var mthTmp2: int64 := self.cg_nc1(ni);
    while (mthTmp2 != -1) {
      var isVirt2: int64 := (self.cg_nival(mthTmp2) >> 1) & 1;
      if (isVirt2 != 0) {
        var mname2: pchar := self.cg_nsval(mthTmp2);
        var mlen2:  int64 := self.cg_nslen(mthTmp2);
        var overrides: int64 := 0;
        var si2: int64 := 0;
        while (si2 < parentSlotCount) {
          var sName2: pchar := peek64(parentMethodList + si2 * 16) as pchar;
          var sLen2:  int64 := peek64(parentMethodList + si2 * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN);
          if (self.cg_seq(sName2, sLen2, mname2, mlen2) != 0) { overrides := 1; break; }
          si2 += 1;
        }
        // #1133: Ein Name, der schon als Selektor einen Slot hat, bekommt
        // keinen zweiten.
        if (selBase > 0 && self.cg_isIfaceSelector(mname2, mlen2) != 0) { overrides := 1; }
        if (overrides == 0) { ownMethodCount := ownMethodCount + 1; }
      }
      mthTmp2 := self.cg_nnext(mthTmp2);
    }
    var totalSlots: int64 := selBase + parentSlotCount + ownMethodCount;
    // Allocate method name list: {namePtr:8, nameLen:8} per slot
    var methodList: int64 := alloc((totalSlots + 1) * 16);
    // #1133: Selektoren zuerst (nur ohne Elternteil — sonst stecken sie schon
    // in dessen Liste).
    var sel0: int64 := 0;
    while (sel0 < selBase) {
      poke64(methodList + sel0 * 16,     peek64(self.ifaceSelList + sel0 * 16));
      poke64(methodList + sel0 * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN, peek64(self.ifaceSelList + sel0 * 16 + 8));
      sel0 += 1;
    }
    // Copy parent slots first
    var si3: int64 := 0;
    while (si3 < parentSlotCount) {
      poke64(methodList + (selBase + si3) * 16,     peek64(parentMethodList + si3 * 16));
      poke64(methodList + (selBase + si3) * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN, peek64(parentMethodList + si3 * 16 + 8));
      si3 += 1;
    }
    // Append own new virtual methods
    var slotAppend: int64 := selBase + parentSlotCount;
    var mthTmp3: int64 := self.cg_nc1(ni);
    while (mthTmp3 != -1) {
      var isVirt3: int64 := (self.cg_nival(mthTmp3) >> 1) & 1;
      if (isVirt3 != 0) {
        var mname3: pchar := self.cg_nsval(mthTmp3);
        var mlen3:  int64 := self.cg_nslen(mthTmp3);
        var overrides3: int64 := 0;
        var si4: int64 := 0;
        while (si4 < parentSlotCount) {
          var sName4: pchar := peek64(parentMethodList + si4 * 16) as pchar;
          var sLen4:  int64 := peek64(parentMethodList + si4 * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN);
          if (self.cg_seq(sName4, sLen4, mname3, mlen3) != 0) { overrides3 := 1; break; }
          si4 += 1;
        }
        if (selBase > 0 && self.cg_isIfaceSelector(mname3, mlen3) != 0) { overrides3 := 1; }
        if (overrides3 == 0) {
          poke64(methodList + slotAppend * 16,     mname3 as int64);
          poke64(methodList + slotAppend * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN, mlen3);
          slotAppend += 1;
        }
      }
      mthTmp3 := self.cg_nnext(mthTmp3);
    }
    // #1670: Unmittelbar VOR der VMT steht ein Zeiger auf den Klassennamen.
    // Er liegt bei [vmt-8], damit die Slot-Nummern unveraendert bleiben und
    // `is` weiterhin die VMT-Basis vergleicht — beides haengt an dieser Lage.
    // Damit traegt jedes Objekt mit VMT seinen Namen bei sich: obj[0] ist die
    // VMT, [vmt-8] der Name.
    var nameStrOff: int64 := self.cg_addNameData(self.cg_nsval(ni), self.cg_nslen(ni));
    var nameCell:   int64 := self.cg_reserveData(8);
    self.cg_addPatch(nameCell, nameStrOff, 0, CG_PATCH_DATA_PTR);

    // Emit VMT data: totalSlots * 8 bytes (each slot = one method pointer)
    var vmtDataOff: int64 := self.dataLen;
    var di: int64 := 0;
    while (di < totalSlots * 8) { self.cg_edata(0); di := di + 1; }
    // Ensure at least 8 bytes (classes with no methods still need a VMT identity slot)
    if (totalSlots == 0) {
      var de: int64 := 0; while (de < 8) { self.cg_edata(0); de := de + 1; }
    }
    // Grow class table if needed
    if (self.classCount >= self.classCap) {
      var nc: int64 := self.classCap * 2;
      var nb: int64 := alloc(nc * CG_CLASS_SZ);
      var ii: int64 := 0;
      memcpy(nb, self.classLayouts, self.classCount * CG_CLASS_SZ);
      self.classLayouts := nb;
      self.classCap := nc;
    }
    // #1120: alle deklarierten Methoden dieser Klasse merken (virtuell oder
    // nicht). Nur die eigenen — die geerbten findet cg_findMethodOwner ueber
    // PARENTIDX, und genau diese Trennung entscheidet bei gleichem Namen fuer
    // die naeher liegende Definition.
    var declCnt: int64 := 0;
    var mthC: int64 := self.cg_nc1(ni);
    while (mthC != -1) { declCnt := declCnt + 1; mthC := self.cg_nnext(mthC); }
    var declList: int64 := alloc((declCnt + 1) * 16);
    var declI: int64 := 0;
    mthC := self.cg_nc1(ni);
    while (mthC != -1) {
      poke64(declList + declI * 16,     self.cg_nsval(mthC) as int64);
      poke64(declList + declI * 16 + 8, self.cg_nslen(mthC));
      declI := declI + 1;
      mthC := self.cg_nnext(mthC);
    }

    var base: int64 := self.classLayouts + self.classCount * CG_CLASS_SZ;
    poke64(base,      className as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  classLen);
    poke64(base + CG_CLASS_OFF_FIELDSPTR, flds);
    poke64(base + CG_CLASS_OFF_FIELDCNT, cnt);
    poke64(base + CG_CLASS_OFF_VMTOFF,   vmtDataOff);
    poke64(base + CG_CLASS_OFF_VMTSLOTS, totalSlots);
    poke64(base + CG_CLASS_OFF_VMTLIST,  methodList);
    poke64(base + CG_CLASS_OFF_PARENTIDX, pIdx);  // WP-BC-L2: for inherited-slot propagation
    // #1095: als struct deklariert? Ein struct MIT Methoden landet hier im
    // Klassen-Layout und ist sonst nicht mehr als struct erkennbar.
    poke64(base + CG_CLASS_OFF_ALIGN, 0);   // #1516: Klassen werden nicht aufgerundet
    poke64(base + CG_CLASS_OFF_ISSTRUCT, (self.cg_nival(ni) >> 4) & 1);
    poke64(base + CG_CLASS_OFF_METHLIST, declList);   // #1120
    poke64(base + CG_CLASS_OFF_METHCNT,  declCnt);
    self.classCount += 1;
    self.cg_trackTempBuf(declList, (declCnt + 1) * 16);
    // Track temporary field array for later cleanup (BUG-02)
    // The flds pointer is stored in classLayouts and used by cg_findField/cg_getFieldOffset
    // until cg_patchAll() completes. cg_freeAllTempBufs() will release it.
    self.cg_trackTempBuf(flds, (cnt + 1) * CG_CFIELD_SZ);
    self.cg_trackTempBuf(methodList, (totalSlots + 1) * 16);
  }

  // Build struct field layout (WP-10d): like cg_buildClassLayout but fields at offset 0
  // and vmtDataOff stored as -1 (marks this entry as a struct, not a class).
  // WP-4.1-A: return the byte size of a named type for @packed structs
  fn cg_typeSize(typeNode: int64): int64 {
    if (typeNode < 0) { return 8; }
    var tn: pchar := self.cg_nsval(typeNode);
    var tl: int64 := self.cg_nslen(typeNode);
    if (tl == 5 && self.cg_seq(tn, tl, "uint8"c,  5)) { return 1; }
    if (tl == 4 && self.cg_seq(tn, tl, "int8"c,   4)) { return 1; }
    if (tl == 4 && self.cg_seq(tn, tl, "char"c,   4)) { return 1; }
    if (tl == 6 && self.cg_seq(tn, tl, "uint16"c, 6)) { return 2; }
    if (tl == 5 && self.cg_seq(tn, tl, "int16"c,  5)) { return 2; }
    if (tl == 6 && self.cg_seq(tn, tl, "uint32"c, 6)) { return 4; }
    if (tl == 5 && self.cg_seq(tn, tl, "int32"c,  5)) { return 4; }
    // #1010: hier standen bisher NUR die uintN-Schreibweisen -- ein `u16`-Feld
    // bekam damit Breite 8. Das trifft die @big_endian-Byteordnung (Breite steckt
    // im Feld-Flag) und die @packed-Schrittweite. Beide Schreibweisen jetzt gleich.
    if (tl == 2 && self.cg_seq(tn, tl, "u8"c,     2)) { return 1; }
    if (tl == 2 && self.cg_seq(tn, tl, "i8"c,     2)) { return 1; }
    if (tl == 3 && self.cg_seq(tn, tl, "u16"c,    3)) { return 2; }
    if (tl == 3 && self.cg_seq(tn, tl, "i16"c,    3)) { return 2; }
    if (tl == 3 && self.cg_seq(tn, tl, "u32"c,    3)) { return 4; }
    if (tl == 3 && self.cg_seq(tn, tl, "i32"c,    3)) { return 4; }
    if (tl == 3 && self.cg_seq(tn, tl, "f32"c,    3)) { return 4; }
    return 8;  // int64, uint64, f64, pchar, pointers — all 8 bytes
  }

  // #1038: Ist der Typ ein VORZEICHENBEHAFTETER Schmaltyp? Nur fuer diese wird
  // beim Laden vorzeichenrichtig erweitert (movsx); uintN/uN und char werden
  // genullt (movzx). Breite 8 spielt hier keine Rolle.
  fn cg_typeIsSignedNarrow(typeNode: int64): int64 {
    if (typeNode < 0) { return 0; }
    var tn: pchar := self.cg_nsval(typeNode);
    var tl: int64 := self.cg_nslen(typeNode);
    if (tl == 4 && self.cg_seq(tn, tl, "int8"c,  4)) { return 1; }
    if (tl == 5 && self.cg_seq(tn, tl, "int16"c, 5)) { return 1; }
    if (tl == 5 && self.cg_seq(tn, tl, "int32"c, 5)) { return 1; }
    if (tl == 2 && self.cg_seq(tn, tl, "i8"c,    2)) { return 1; }
    if (tl == 3 && self.cg_seq(tn, tl, "i16"c,   3)) { return 1; }
    if (tl == 3 && self.cg_seq(tn, tl, "i32"c,   3)) { return 1; }
    return 0;
  }

  fn cg_buildStructLayout(ni: int64) {
    var sName: pchar := self.cg_nsval(ni);
    var sLen:  int64 := self.cg_nslen(ni);
    // #1256: Ein globales Struct braucht seine GROESSE schon bei der
    // Deklaration — steht der Typ weiter unten in der Datei, wird sein Layout
    // vorgezogen (cg_ensureStructLayout). Der Hauptdurchlauf kommt danach
    // erneut vorbei; ein zweiter Eintrag waere tote Last, denn cg_findClass
    // liefert ohnehin den ersten. Also einmal registrieren und fertig.
    if (self.cg_findClass(sName, sLen) >= 0) { return; }
    // WP-BC-INH: a method-less class may still `extends` a base — flatten base fields.
    var parentNi: int64 := self.cg_nc2(ni);
    var parentFieldCnt: int64 := 0;
    var parentFldsPtr: int64 := 0;
    var pIdx: int64 := 0 - 1;
    if (parentNi >= 0) {
      pIdx := self.cg_findClass(self.cg_nsval(parentNi), self.cg_nslen(parentNi));
      if (pIdx >= 0) {
        parentFieldCnt := peek64(self.classLayouts + pIdx * CG_CLASS_SZ + CG_CLASS_OFF_FIELDCNT);
        parentFldsPtr  := peek64(self.classLayouts + pIdx * CG_CLASS_SZ + CG_CLASS_OFF_FIELDSPTR);
      }
    }
    var fieldNode: int64 := self.cg_nc0(ni);
    var ownCnt: int64 := 0;
    var tmp: int64 := fieldNode;
    while (tmp != -1) { ownCnt := ownCnt + 1; tmp := self.cg_nnext(tmp); }
    var cnt: int64 := parentFieldCnt + ownCnt;
    var flds: int64 := alloc((cnt + 1) * CG_CFIELD_SZ);
    // Inherited base fields first (offsets preserved); own fields continue after.
    if (parentFieldCnt > 0) { memcpy(flds, parentFldsPtr, parentFieldCnt * CG_CFIELD_SZ); }
    // WP-4.1-A: check for @packed flag (bit 0 of struct iVal) and at(offset) fields
    var isPacked: int64 := self.cg_nival(ni) & 1;
    // #1516: Nur ein echtes `struct` bekommt die ABI-Ausrichtung. Diese Funktion
    // baut auch das Layout methodenloser KLASSEN; die bleiben Referenztypen mit
    // acht Byte je Feld, damit die Vererbungskette ihre Offsets behaelt.
    var istStruct: int64 := (self.cg_nival(ni) >> 4) & 1;
    var natAlign: int64 := 0;
    if (istStruct != 0 && isPacked == 0) { natAlign := 1; }
    // Structs: fields start at offset 0 (no VMT slot); derived continue after base.
    // #1630: auch hier galt "jedes Basisfeld ist acht Byte breit". Dieselbe
    // Rechnung wie im Klassen-Layout: das Ende ergibt sich aus den gerade
    // kopierten Feldern selbst. Ein Typ OHNE Methoden laeuft ueber diesen
    // Bauweg — die Ableitung im Bericht ist genau so einer.
    var offset: int64 := 0;
    var pfS: int64 := 0;
    while (pfS < parentFieldCnt) {
      var pfbS: int64 := flds + pfS * CG_CFIELD_SZ;
      var pfBytesS: int64 := peek64(pfbS + CG_CFIELD_OFF_BYTES);
      if (pfBytesS <= 0) { pfBytesS := 8; }
      var pfEndeS: int64 := peek64(pfbS + CG_CFIELD_OFF_OFFSET) + pfBytesS;
      if (pfEndeS > offset) { offset := pfEndeS; }
      pfS := pfS + 1;
    }
    while ((offset & 7) != 0) { offset := offset + 1; }
    var i: int64 := parentFieldCnt;
    tmp := fieldNode;
    while (tmp != -1) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      poke64(fb,      self.cg_nsval(tmp) as int64);
      poke64(fb + CG_CFIELD_OFF_FIELDLEN,  self.cg_nslen(tmp));
      var ftypeNode: int64 := self.cg_nc0(tmp);
      // WP-4.1-A: determine field offset
      var fieldOff: int64 := offset;
      var fieldIVal: int64 := self.cg_nival(tmp);
      // #1516: Jedes Feld nach dem ersten begann bei 8*n, egal wie breit sein
      // Typ war — drei `int8` belegten 17 statt 3 Byte, und das Speicherbild
      // passte zu keinem C-Struct. Ausgerichtet wird jetzt auf die Typbreite
      // (SysV): int8 auf 1, int16 auf 2, int32/f32 auf 4, alles uebrige auf 8.
      // Die Breite selbst faellt weiter unten (breite2) an; hier wird nur die
      // ANFANGSGRENZE gesetzt, weshalb cg_typeSize hier ein zweites Mal
      // gefragt wird statt das Ergebnis herumzureichen.
      if (natAlign != 0) {
        var aInl: int64 := self.cg_arrayFixedCount(ftypeNode);
        var fAlign: int64 := 8;
        if (aInl > 0) { fAlign := self.cg_typeSize(self.cg_nc0(ftypeNode)); }
        else if (self.cg_typeIstInlineStruct(ftypeNode) != 0) { fAlign := 8; }
        else { fAlign := self.cg_typeSize(ftypeNode); }
        if (fAlign < 1) { fAlign := 1; }
        if (fAlign > 8) { fAlign := 8; }
        var vor: int64 := fieldOff % fAlign;
        if (vor != 0) { fieldOff := fieldOff + (fAlign - vor); }
        offset := fieldOff;
        if (fAlign > natAlign) { natAlign := fAlign; }
      }
      if ((fieldIVal & 1) != 0) {
        // Explicit at(expr) offset: read from c1 node's iVal (must be literal)
        var offsetNi: int64 := self.cg_nc1(tmp);
        if (offsetNi >= 0) { fieldOff := self.cg_nival(offsetNi); }
        offset := fieldOff;  // continue after explicit offset
      }
      poke64(fb + CG_CFIELD_OFF_OFFSET, fieldOff);
      poke64(fb + CG_CFIELD_OFF_ELEMTYPEPTR, 0);
      poke64(fb + CG_CFIELD_OFF_ELEMTYPELEN, 0);
      if (ftypeNode >= 0 && self.cg_nkind(ftypeNode) == 60) {
        var ftn: pchar := self.cg_nsval(ftypeNode);
        var ftl: int64 := self.cg_nslen(ftypeNode);
        poke64(fb + CG_CFIELD_OFF_TYPENAMEPTR, ftn as int64);
        poke64(fb + CG_CFIELD_OFF_TYPENAMELEN, ftl);
        // For Array<T> fields: store element type from generic arg nc1
        if (self.cg_seq(ftn, ftl, "Array", 5)) {
          var elemNode: int64 := self.cg_nc1(ftypeNode);
          if (elemNode >= 0 && self.cg_nkind(elemNode) == 60) {
            poke64(fb + CG_CFIELD_OFF_ELEMTYPEPTR, self.cg_nsval(elemNode) as int64);
            poke64(fb + CG_CFIELD_OFF_ELEMTYPELEN, self.cg_nslen(elemNode));
          }
        }
      } else {
        poke64(fb + CG_CFIELD_OFF_TYPENAMEPTR, 0);
        poke64(fb + CG_CFIELD_OFF_TYPENAMELEN, 0);
      }
      // WP-4.1-B: store big_endian flag + type width at fb+40
      var beFlag2: int64 := (self.cg_nival(tmp) >> 1) & 1;
      var tWidth2: int64 := self.cg_typeSize(ftypeNode);
      // A2: method-Typ-Flag (Bit1) — inline `method(...)` ODER method-Alias-Name.
      var isMth2: int64 := 0;
      if (ftypeNode >= 0) {
        if (self.cg_nkind(ftypeNode) == CGN_METHOD_PTR) { isMth2 := 1; }
        else if (self.cg_nkind(ftypeNode) == 60 && self.cg_isMethodType(self.cg_nsval(ftypeNode), self.cg_nslen(ftypeNode)) != 0) { isMth2 := 1; }
      }
      // #1038: Bit2 = vorzeichenbehafteter Schmaltyp, siehe cg_buildClassLayout.
      // #1052: siehe cg_buildClassLayout — inline `[N]T`-Feld.
      var inlN2: int64 := self.cg_arrayFixedCount(ftypeNode);
      if (inlN2 > 0) {
        tWidth2 := self.cg_typeSize(self.cg_nc0(ftypeNode));
        var inlElem2: int64 := self.cg_nc0(ftypeNode);   // #1493
        if (inlElem2 >= 0 && self.cg_nkind(inlElem2) == 60) {
          poke64(fb + CG_CFIELD_OFF_ELEMTYPEPTR, self.cg_nsval(inlElem2) as int64);
          poke64(fb + CG_CFIELD_OFF_ELEMTYPELEN, self.cg_nslen(inlElem2));
        }
      }
      var inlBit2: int64 := 0;
      if (inlN2 > 0) { inlBit2 := 1; }
      // #1513: Bit4 = das Feld ist selbst ein Struct und liegt inline.
      var inlStr2: int64 := 0;
      if (inlN2 == 0 && self.cg_typeIstInlineStruct(ftypeNode) != 0) { inlStr2 := 1; }
      poke64(fb + CG_CFIELD_OFF_FLAGS, beFlag2 | (tWidth2 << 8) | (isMth2 << 1) | (self.cg_typeIsSignedNarrow(ftypeNode) << 2) | (inlBit2 << 3) | (inlStr2 << 4));
      // WP-4.1-A: field stride
      // #1052: inline `[N]T` belegt N * Elementbreite — auch ungepackt.
      var breite2: int64 := 8;
      if (inlN2 > 0) {
        breite2 := inlN2 * tWidth2;
      } else if (inlStr2 != 0) {
        breite2 := self.cg_inlineStructBytes(ftypeNode);
      } else if (isPacked != 0 || natAlign != 0) {
        // #1516: bisher nur bei @packed — ungepackt belegte auch ein int8
        // volle acht Byte.
        breite2 := self.cg_typeSize(ftypeNode);
      }
      poke64(fb + CG_CFIELD_OFF_BYTES, breite2);
      offset := offset + breite2;
      i += 1;
      tmp := self.cg_nnext(tmp);
    }
    if (self.classCount >= self.classCap) {
      var nc: int64 := self.classCap * 2;
      var nb: int64 := alloc(nc * CG_CLASS_SZ);
      var ii: int64 := 0;
      memcpy(nb, self.classLayouts, self.classCount * CG_CLASS_SZ);
      self.classLayouts := nb;
      self.classCap := nc;
    }
    var base: int64 := self.classLayouts + self.classCount * CG_CLASS_SZ;
    poke64(base,      sName as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  sLen);
    poke64(base + CG_CLASS_OFF_FIELDSPTR, flds);
    poke64(base + CG_CLASS_OFF_FIELDCNT, cnt);
    poke64(base + CG_CLASS_OFF_VMTOFF,   -1);
    poke64(base + CG_CLASS_OFF_VMTSLOTS, 0);
    poke64(base + CG_CLASS_OFF_VMTLIST, 0);
    // #1094: Die Elternklasse wird auch hier vermerkt. Sie steht fuer die
    // Vererbungskette, nicht fuer eine VMT — die bleibt ueber VMTOFF == -1
    // ausgeschlossen, und die Slot-Weitergabe (WP-BC-L2) prueft genau darauf.
    // Ohne den Eintrag waere `b is A` bei methodenlosen Klassen falsch: sie
    // bekommen struct-Layout, und die Kette waere abgeschnitten.
    poke64(base + CG_CLASS_OFF_PARENTIDX, pIdx);
    poke64(base + CG_CLASS_OFF_ISSTRUCT, (self.cg_nival(ni) >> 4) & 1);
    poke64(base + CG_CLASS_OFF_ALIGN, natAlign);   // #1516; 0 = nicht aufrunden
    // #1120: auch hier — ein struct kann Methoden tragen und beerbt werden.
    var sDeclCnt: int64 := 0;
    var sMth: int64 := self.cg_nc1(ni);
    while (sMth != -1) { sDeclCnt := sDeclCnt + 1; sMth := self.cg_nnext(sMth); }
    var sDeclList: int64 := alloc((sDeclCnt + 1) * 16);
    var sDeclI: int64 := 0;
    sMth := self.cg_nc1(ni);
    while (sMth != -1) {
      poke64(sDeclList + sDeclI * 16,     self.cg_nsval(sMth) as int64);
      poke64(sDeclList + sDeclI * 16 + 8, self.cg_nslen(sMth));
      sDeclI := sDeclI + 1;
      sMth := self.cg_nnext(sMth);
    }
    poke64(base + CG_CLASS_OFF_METHLIST, sDeclList);
    poke64(base + CG_CLASS_OFF_METHCNT,  sDeclCnt);
    self.classCount += 1;
    self.cg_trackTempBuf(sDeclList, (sDeclCnt + 1) * 16);
    // Track temporary field array for later cleanup (BUG-02)
    self.cg_trackTempBuf(flds, (cnt + 1) * CG_CFIELD_SZ);
  }

  // BUG-08: Build enum variant layout for match tag analysis
  // Enum layout: {namePtr:8, nameLen:8, variantsPtr:8, variantCnt:8}
  // Each variant: {namePtr:8, nameLen:8, tagValue:8, payloadSize:8} = 32 bytes
  fn cg_buildEnumLayout(ni: int64) {
    var enumName: pchar := self.cg_nsval(ni);
    var enumLen:  int64 := self.cg_nslen(ni);
    // Count variants (child0 chain)
    var variantNode: int64 := self.cg_nc0(ni);
    var cnt: int64 := 0;
    var tmp: int64 := variantNode;
    while (tmp != -1) { cnt := cnt + 1; tmp := self.cg_nnext(tmp); }
    // WP-10.2: cnt*32 must not overflow; no realistic enum has >64 M variants
    if (cnt < 0 || cnt > 0x3FFFFFFF) { return; }
    // Allocate variant array: 32 bytes per variant
    var vars: int64 := alloc(cnt * 32);
    var i: int64 := 0;
    // #1131: Zaehler fuer Mitglieder OHNE eigenen Wert. Ein expliziter Wert
    // setzt ihn neu, das naechste Mitglied zaehlt von dort weiter (`A = 5, B`
    // ergibt 5 und 6) — dieselbe Regel wie in C.
    var nextTag: int64 := 0;
    tmp := variantNode;
    while (tmp != -1) {
      var vb: int64 := vars + i * 32;
      poke64(vb,      self.cg_nsval(tmp) as int64);   // variant name
      poke64(vb + CG_EVAR_OFF_NAMELEN,  self.cg_nslen(tmp));             // variant name len
      // #1131: c0 traegt den ausdruecklich angegebenen Wert (`A = 10`). Er
      // wurde bisher als NUTZLAST gezaehlt: payloadCnt wurde 1, landete in der
      // oberen Haelfte des gepackten Ergebnisses und der Tag blieb der
      // Positionsindex — `E.A` lieferte 2^32 + 0 statt 10.
      var valNi: int64 := self.cg_nc0(tmp);
      var tagVal: int64 := nextTag;
      if (valNi >= 0) {
        if (self.cg_foldConst(valNi) != 0) {   // #1647: unabhaengig von -O
          tagVal := self.foldBuf;
          // #1131: Der Wert wird zusammen mit der Nutzlastgroesse in einer
          // int64 gefuehrt (Wert unten, Groesse oben). Ein negativer Wert oder
          // einer jenseits von 2^32-1 liefe in die obere Haelfte und kaeme als
          // etwas voellig anderem zurueck. `EnumMember = Ident [ "=" IntLiteral ]`
          // (ebnf.md §10) sieht ohnehin keine negativen Werte vor — also melden,
          // statt still das Falsche zu tun.
          if (tagVal < 0 || tagVal > 4294967295) {
            EPrintStr("error: enum "c);
            sys_write(2, enumName as int64, enumLen);
            EPrintStr(": der Wert von "c);
            sys_write(2, self.cg_nsval(tmp) as int64, self.cg_nslen(tmp));
            EPrintStrLn(" liegt ausserhalb von 0..4294967295"c);
            exit(1);
          }
        } else {
          // Kein stiller Default: ein Wert, der erst zur Laufzeit feststuende,
          // waere als Marke im uebersetzten Code nicht darstellbar.
          EPrintStr("error: enum "c);
          sys_write(2, enumName as int64, enumLen);
          EPrintStr(": der Wert von "c);
          sys_write(2, self.cg_nsval(tmp) as int64, self.cg_nslen(tmp));
          EPrintStrLn(" muss zur Uebersetzungszeit feststehen"c);
          exit(1);
        }
      }
      poke64(vb + CG_EVAR_OFF_TAGVAL, tagVal);
      nextTag := tagVal + 1;
      // Eine Nutzlast gibt es in der Deklaration nicht — `EnumMember` ist
      // `Ident [ "=" IntLiteral ]` (ebnf.md §10). Die Musterform `Ok(wert)`
      // wird beim MATCH aufgeloest, nicht hier.
      poke64(vb + CG_EVAR_OFF_PAYLOADSZ, 0);
      i += 1;
      tmp := self.cg_nnext(tmp);
    }
    // Grow enum table if needed
    if (self.enumCount >= self.enumCap) {
      var nc: int64 := self.enumCap * 2;
      var nb: int64 := alloc(nc * 32);
      var ii: int64 := 0;
      memcpy(nb, self.enumLayouts, self.enumCount * 32);
      free(self.enumLayouts, self.enumCap * 32);
      self.enumLayouts := nb;
      self.enumCap := nc;
    }
    var base: int64 := self.enumLayouts + self.enumCount * 32;
    poke64(base,      enumName as int64);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  enumLen);
    poke64(base + CG_ENUM_OFF_VARSPTR, vars);
    poke64(base + CG_CLASS_OFF_FIELDCNT, cnt);
    self.enumCount += 1;
  }

  // BUG-08: Find enum layout by name, return index or -1
  fn cg_findEnum(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while (i < self.enumCount) {
      var base: int64 := self.enumLayouts + i * 32;
      var p: pchar := peek64(base) as pchar;
      var n: int64 := peek64(base + CG_PATCH_OFF_NAMEPTR);
      if (n == nlen && self.cg_seq(p, n, name, nlen)) { return i; }
      i += 1;
    }
    return -1;
  }

  // BUG-08: Find variant tag value within enum by variant name
  // Returns {tagValue: low 32 bits, payloadSize: high 32 bits} packed in int64
  fn cg_findEnumVariant(enumIdx: int64, varName: pchar, varLen: int64): int64 {
    if (enumIdx < 0) { return -1; }
    var ebase: int64 := self.enumLayouts + enumIdx * 32;
    var vars: int64 := peek64(ebase + CG_ENUM_OFF_VARSPTR);
    var vcnt: int64 := peek64(ebase + CG_ENUM_OFF_VARCOUNT);
    var i: int64 := 0;
    while (i < vcnt) {
      var vb: int64 := vars + i * 32;
      var p: pchar := peek64(vb) as pchar;
      var n: int64 := peek64(vb + CG_EVAR_OFF_NAMELEN);
      if (n == varLen && self.cg_seq(p, n, varName, varLen)) {
        var tagVal: int64 := peek64(vb + CG_EVAR_OFF_TAGVAL);
        var paySz:  int64 := peek64(vb + CG_EVAR_OFF_PAYLOADSZ);
        return tagVal + (paySz << 32);
      }
      i += 1;
    }
    return -1;
  }

  fn cg_getLocalClassIdx(varName: pchar, varLen: int64): int64 {
    var i: int64 := self.localCount - 1;
    while (i >= 0) {
      var base: int64 := self.locals + i * CG_LOCAL_SZ;
      var p: pchar  := peek64(base) as pchar;
      var n: int64  := peek64(base + CG_LOCAL_OFF_NAMELEN);
      if (n == varLen && self.cg_seq(p, n, varName, varLen)) {
        var tb: int64 := self.localTypes + i * 16;
        var tp: pchar := peek64(tb) as pchar;
        var tn: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
        if (tp == 0 as pchar || tn == 0) { return -1; }
        return self.cg_findClass(tp, tn);
      }
      i -= 1;
    }
    // #1256: kein Local dieses Namens — dann kann es eine GLOBALE Variable
    // sein. Ihr Typname steht seit #1094 in globalTypeNames; ohne diese Frage
    // blieb der Klassenindex -1, der Feldoffset damit -1, und `s.x := 3` fiel
    // durch alle Schreibzweige, ohne etwas zu tun. Genau das war der stille
    // Teil von #1256: kein Absturz, nur Nullen.
    var gi: int64 := self.cg_findGlobalIdx(varName, varLen);
    if (gi >= 0) {
      var gp: pchar := peek64(self.globalTypeNames + gi * 16) as pchar;
      var gl: int64 := peek64(self.globalTypeNames + gi * 16 + 8);
      if (gp != 0 as pchar && gl > 0) { return self.cg_findClass(gp, gl); }
    }
    return -1;
  }

  // WP-10a: record a VMT address patch (mov rcx,imm64 placeholder at codeOff for class)
  fn cg_addVmtPatch(codeOff: int64, className: pchar, classLen: int64) {
    if (self.vmtPatchCount >= self.vmtPatchCap) {
      var nc: int64 := self.vmtPatchCap * 2;
      var nb: int64 := alloc(nc * 24);
      var i: int64 := 0;
      memcpy(nb, self.vmtPatches, self.vmtPatchCount * 24);
      self.vmtPatches := nb; self.vmtPatchCap := nc;
    }
    var base: int64 := self.vmtPatches + self.vmtPatchCount * 24;
    poke64(base,      codeOff);
    poke64(base + CG_PATCH_OFF_NAMEPTR,  className as int64);
    poke64(base + CG_VMT_PATCH_OFF_CLASSLEN, classLen);
    self.vmtPatchCount += 1;
  }

  // WP-BC-19: Record VMT method slot patch: after all code is generated,
  // write method vaddr into data[vmtDataSlotOff].
  fn cg_addVmtMethodPatch(vmtDataSlotOff: int64, methodCodeStart: int64) {
    if (self.vmtMethodPatchCount >= self.vmtMethodPatchCap) {
      var nc: int64 := self.vmtMethodPatchCap * 2;
      var nb: int64 := alloc(nc * CG_VMT_METH_PATCH_SZ);
      var i: int64 := 0;
      memcpy(nb, self.vmtMethodPatches, self.vmtMethodPatchCount * CG_VMT_METH_PATCH_SZ);
      self.vmtMethodPatches := nb; self.vmtMethodPatchCap := nc;
    }
    var base: int64 := self.vmtMethodPatches + self.vmtMethodPatchCount * CG_VMT_METH_PATCH_SZ;
    poke64(base,     vmtDataSlotOff);
    poke64(base + CG_PATCH_OFF_NAMEPTR, methodCodeStart);
    self.vmtMethodPatchCount += 1;
  }

  // WP-A2.2: register an 8-byte absolute pointer at image RVA `rva` (relative to
  // CG_ELF_BASE). Consumers relocate it by (load_base − CG_ELF_BASE): the PE backend
  // emits an IMAGE_REL_BASED_DIR64 entry + rebases the value; the LyxOS loader adds
  // its (load_base − 0x400000) delta. The default ELF exe loads at CG_ELF_BASE so no
  // adjustment is needed there.
  fn cg_addBaseReloc(rva: int64) {
    if (self.baseRelocCount >= self.baseRelocCap) {
      var nc: int64 := self.baseRelocCap * 2;
      var nb: int64 := alloc(nc * 8);
      memcpy(nb, self.baseRelocBuf, self.baseRelocCount * 8);
      self.baseRelocBuf := nb; self.baseRelocCap := nc;
    }
    poke64(self.baseRelocBuf + self.baseRelocCount * 8, rva);
    self.baseRelocCount += 1;
  }
  // #2135: ein Ereignis der Abwickelangaben an der aktuellen Codestelle.
  fn cg_cfi(art: int64, arg: int64) {
    if (self.cfiCount >= self.cfiCap) {
      var nc: int64 := self.cfiCap * 2;
      var nb: int64 := alloc(nc * 16);
      memcpy(nb, self.cfiBuf, self.cfiCount * 16);
      self.cfiBuf := nb; self.cfiCap := nc;
    }
    poke64(self.cfiBuf + self.cfiCount * 16, self.codeLen);
    poke64(self.cfiBuf + self.cfiCount * 16 + 8, art | (arg << 8));
    self.cfiCount += 1;
  }

  // #1370: Zugriff auf die Tabellen, aus denen --dump-relocs und --map-file
  // ihre Ausgabe bauen. Sie stehen nach Generate() fertig da; bis hierher las
  // sie nur der Patcher selbst.
  fn cg_getPatchBuf(): int64   { return self.patches; }
  fn cg_getPatchCount(): int64 { return self.patchCount; }
  fn cg_getLabelBuf(): int64   { return self.labels; }
  fn cg_getLabelCount(): int64 { return self.labelCount; }

  // #1671: Die tatsaechlich AUFGERUFENEN Externs (Reihenfolge = Index in den
  // CG_PATCH_EXTERN-Patches). Das PE-Backend baut daraus die Import-Tabelle;
  // bis 1.1.3D stand dort eine fest verdrahtete Liste mit fuenf
  // kernel32-Funktionen, und jede eigene `extern fn ... link "x.dll"` fehlte.
  fn cg_getExternSymBuf(): int64   { return self.externSyms; }
  fn cg_getExternSymCount(): int64 { return self.externCount; }

  fn cg_getBaseRelocBuf(): int64 { return self.baseRelocBuf; }
  fn cg_getBaseRelocCount(): int64 { return self.baseRelocCount; }

  // Helper: get class index for object node (IDENT, FIELD chain, or INDEX for struct arrays)
  // #1097: Bereichstyp-Registry. `type X = int64 range LO..HI;` sicherte bisher
  // nur zu, was zur UEBERSETZUNGSZEIT feststand — ein berechneter Wert, ein
  // Parameter, eine Rueckgabe liefen ungeprueft durch. Die Grenzen stehen im
  // Typ, also muss die Pruefung dort stattfinden, wo ein Wert diesen Typ
  // ANNIMMT, und nicht nur dort, wo sie sich statisch ausrechnen laesst.
  // #1110: Einheitentyp merken. Der Faktor ist das, was `utype Km: Meter = 1000`
  // zusagt — und was bis 1.0.13D folgenlos blieb: `var b: M := a` uebernahm den
  // Zahlenwert unveraendert, statt ihn umzurechnen.
  fn cg_addUtype(name: pchar, nameLen: int64, factor: int64,
                 dimName: pchar, dimLen: int64,
                 rlo: int64, rhi: int64, flags: int64, factorDen: int64) {
    if (self.utypeCount >= self.utypeCap) {
      var nc: int64 := self.utypeCap * 2;
      var nb: int64 := alloc(nc * 72);
      memcpy(nb, self.utypes, self.utypeCount * 72);
      self.utypes := nb;
      self.utypeCap := nc;
    }
    var base: int64 := self.utypes + self.utypeCount * 72;
    poke64(base,      name as int64);
    poke64(base + 8,  nameLen);
    poke64(base + 16, factor);
    poke64(base + 24, dimName as int64);
    poke64(base + 32, dimLen);
    poke64(base + 40, rlo);
    poke64(base + 48, rhi);
    poke64(base + 56, flags);
    poke64(base + 64, factorDen);   // #1158: Nenner des Umrechnungsbruchs
    self.utypeCount += 1;
  }

  // Index des Einheitentyps mit diesem Namen, sonst -1.
  fn cg_findUtype(name: pchar, nameLen: int64): int64 {
    if (nameLen <= 0) { return 0 - 1; }
    var i: int64 := 0;
    while (i < self.utypeCount) {
      var base: int64 := self.utypes + i * 72;
      var p: pchar := peek64(base) as pchar;
      var n: int64 := peek64(base + 8);
      if (n == nameLen && self.cg_seq(p, n, name, nameLen)) {
        if (self.zlAktiv != 0) { self.zlFuA += 1; self.zlFuV += i + 1; }   // #2174
        return i;
      }
      i += 1;
    }
    if (self.zlAktiv != 0) { self.zlFuA += 1; self.zlFuV += self.utypeCount; }   // #2174
    return 0 - 1;
  }

  fn cg_utypeFactor(idx: int64): int64 {
    if (idx < 0) { return 1; }
    var f: int64 := peek64(self.utypes + idx * 72 + 16);
    if (f <= 0) { return 1; }
    return f;
  }

  // #1158: Nenner des Umrechnungsfaktors. 1 fuer ganzzahlige Faktoren.
  fn cg_utypeFactorDen(idx: int64): int64 {
    if (idx < 0) { return 1; }
    var d: int64 := peek64(self.utypes + idx * 72 + 64);
    if (d <= 0) { return 1; }
    return d;
  }

  // Einheitentyp einer lokalen Variablen ueber ihren deklarierten Typnamen.
  fn cg_utypeOfLocal(name: pchar, nameLen: int64): int64 {
    var lidx: int64 := self.cg_findLocalIdx(name, nameLen);
    if (lidx < 0) { return 0 - 1; }
    var tb: int64 := self.localTypes + lidx * CG_LOCTYPE_SZ;
    var tp: pchar := peek64(tb) as pchar;
    var tl: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
    if (tp == 0 as pchar || tl <= 0) { return 0 - 1; }
    return self.cg_findUtype(tp, tl);
  }

  fn cg_utypeOfTypeNode(typeNode: int64): int64 {
    if (typeNode < 0) { return 0 - 1; }
    if (self.cg_nkind(typeNode) != 60) { return 0 - 1; }
    return self.cg_findUtype(self.cg_nsval(typeNode), self.cg_nslen(typeNode));
  }

  // #1110: rax von der Quell- in die Zieleinheit umrechnen. Erst
  // multiplizieren, dann teilen — die andere Reihenfolge verschenkte bei
  // ganzzahliger Rechnung unnoetig Stellen. Km -> M ist exakt, M -> Km
  // schneidet ab, wie die Ganzzahldivision sonst auch (ebnf.md §20.1).
  // Hilfsbefehle fuer die Einheitenrechnung (#1955). Der Wert liegt in rax als
  // IEEE-754-Bitmuster, genau wie bei jedem anderen f64 im Codegen.
  fn cg_uMovXmm0Rax()   { self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x6E); self.cg_e8(0xC0); }
  fn cg_uMovRaxXmm0()   { self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC0); }
  // movabs rcx, v; cvtsi2sd <xmmReg>, rcx  — Ganzzahl v als f64 laden.
  fn cg_uLoadConst(xmmReg: int64, v: int64) {
    self.cg_e8(0x48); self.cg_e8(0xB9); self.cg_e64(v);
    self.cg_e8(0xF2); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x2A);
    self.cg_e8(0xC1 + xmmReg * 8);
  }

  // #1956: Treffen in EINER Rechnung zwei Einheiten DERSELBEN Dimension mit
  // verschiedenem Faktor aufeinander, muss vor der Operation umgerechnet
  // werden.
  //
  // Bis 1.2.4B geschah das nur bei der ZUWEISUNG. `500 m + 1 km` addierte die
  // rohen Zahlen zu 501 — unabhaengig vom Zieltyp, weil beide Seiten so
  // behandelt wurden, als truegen sie denselben Faktor. Der Fall faellt nicht
  // auf: das Ergebnis ist eine plausible Zahl, und der Typ stimmt sogar. Es
  // ist genau die Fehlerklasse, gegen die Einheitentypen antreten.
  //
  // Ebenso der Vergleich: `500 m > 1 km` verglich 500 mit 1 und war wahr.
  //
  // Massgeblich ist die LINKE Seite — dieselbe Festlegung wie in
  // _utypeOfExpr (sema), wo der Ergebnistyp eines `+` die linke Einheit ist.
  // Die beiden muessen uebereinstimmen, sonst rechnet der Codegen in eine
  // andere Einheit, als die Typpruefung annimmt.
  //
  // Dass beide Seiten DIESELBE Dimension tragen, ist hier bereits sicher:
  // _checkUtypeBinop weist Rechnungen und Vergleiche ueber Dimensionsgrenzen
  // ab, bevor der Codegen laeuft. Deshalb genuegt der Vergleich der Indizes.
  fn cg_utypeBinopConvNeeded(ni: int64): int64 {
    var op: int64 := self.cg_nival(ni);
    var passt: int64 := 0;
    if (op == CGT_PLUS || op == CGT_MINUS) { passt := 1; }
    if (op == CGT_GT || op == CGT_LT || op == CGT_GE || op == CGT_LE ||
        op == CGT_EQ2 || op == CGT_NEQ) { passt := 1; }
    if (passt == 0) { return 0; }
    var lu: int64 := self.cg_utypeOfExpr(self.cg_nc0(ni));
    if (lu < 0) { return 0; }
    var ru: int64 := self.cg_utypeOfExpr(self.cg_nc1(ni));
    if (ru < 0) { return 0; }
    if (lu == ru) { return 0; }
    return 1;
  }

  // #1962: Der FAKTOR eines Ausdrucks, als Bruch. Rueckgabe:
  //   0 = traegt keine Einheit und ist auch kein Skalar (nicht behandelbar),
  //   1 = traegt eine Einheit, Faktor steht in den Boxen,
  //   2 = dimensionsloser Skalar (neutrales Element, Faktor 1/1).
  //
  // Die Unterscheidung 1 gegen 2 ist tragend: ein Literal darf NICHT
  // umgerechnet werden. `var a: Km := 2` muss 2 bleiben — wer hier den
  // Zielfaktor anbraechte, machte aus jeder Startbelegung eine Umrechnung.
  fn cg_convOverflow() {
    EPrintStrLn("codegen error: Umrechnungsfaktor laesst sich nicht als int64-Bruch fuehren"c);
    EPrintStrLn("  Die beiden Einheiten sind zu fein gegeneinander aufgeloest. Weniger"c);
    EPrintStrLn("  Nachkommastellen waehlen oder eine groebere Basiseinheit nehmen."c);
    exit(1);
  }

  fn cg_utypeFracOfExpr(ni: int64, numBox: int64, denBox: int64): int64 {
    if (ni < 0) { return 0; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_LIT_INT || k == CGN_LIT_FLOAT) {
      poke64(numBox, 1); poke64(denBox, 1);
      return 2;
    }
    if (k == CGN_BINOP) {
      var op: int64 := self.cg_nival(ni);
      if (op != CGT_STAR && op != CGT_SLASH) { return 0; }
      var ln: int64 := alloc(8); var ld: int64 := alloc(8);
      var rn: int64 := alloc(8); var rd: int64 := alloc(8);
      var lo: int64 := self.cg_utypeFracOfExpr(self.cg_nc0(ni), ln, ld);
      var ro: int64 := self.cg_utypeFracOfExpr(self.cg_nc1(ni), rn, rd);
      var erg: int64 := 0;
      if (lo != 0 && ro != 0) {
        var a: int64 := peek64(ln); var b: int64 := peek64(ld);
        var c: int64 := peek64(rn); var d: int64 := peek64(rd);
        if (op == CGT_STAR) { poke64(numBox, a * c); poke64(denBox, b * d); }
        else                { poke64(numBox, a * d); poke64(denBox, b * c); }
        if (lo == 2 && ro == 2) { erg := 2; } else { erg := 1; }
      }
      free(ln, 8); free(ld, 8); free(rn, 8); free(rd, 8);
      return erg;
    }
    var u: int64 := self.cg_utypeOfExpr(ni);
    if (u < 0) { return 0; }
    poke64(numBox, self.cg_utypeFactor(u));
    poke64(denBox, self.cg_utypeFactorDen(u));
    return 1;
  }

  // #1962: Umrechnung eines beliebigen AUSDRUCKS auf den Zieltyp. Erst der
  // bisherige Weg ueber den Index — er deckt jeden einfachen Fall und bleibt
  // Bit fuer Bit wie zuvor. Nur wenn der Ausdruck keinem deklarierten
  // Einheitentyp entspricht (also eine ABGELEITETE Groesse ist), wird der
  // Faktor als Bruch bestimmt.
  fn cg_emitUtypeConvExpr(dstIdx: int64, srcNi: int64) {
    if (dstIdx < 0 || srcNi < 0) { return; }
    var src: int64 := self.cg_utypeOfExpr(srcNi);
    if (src >= 0) { self.cg_emitUtypeConv(dstIdx, src); return; }
    var nb: int64 := alloc(8); var db: int64 := alloc(8);
    var art: int64 := self.cg_utypeFracOfExpr(srcNi, nb, db);
    if (art == 1) {
      self.cg_emitConvFrac(peek64(nb), peek64(db),
                           self.cg_utypeFactor(dstIdx), self.cg_utypeFactorDen(dstIdx));
    }
    free(nb, 8); free(db, 8);
  }

  fn cg_emitUtypeConv(dstIdx: int64, srcIdx: int64) {
    if (dstIdx < 0 || srcIdx < 0) { return; }
    if (dstIdx == srcIdx) { return; }
    // #1158: Die Faktoren sind Brueche (sn/sd bzw. dn/dd). Umgerechnet wird
    // mit  wert * (sn*dd) / (sd*dn)  — erst multiplizieren, dann teilen.
    // Gekuerzt wird vorher, sonst laufen die Zwischenprodukte bei Faktoren wie
    // 0.017453 unnoetig gross.
    //
    // #1955: Gerechnet wird seit 1.2.2A in GLEITKOMMA. Der Faktor bleibt aber
    // ein BRUCH — er wird erst hier, im letzten Moment, zu zwei f64-Werten
    // erweitert und nie als abgeschnittene Dezimalzahl gespeichert. `deg` ist
    // damit weiterhin exakt 17453.../1000000. Vorher lief dieselbe Rechnung
    // ganzzahlig auf rax, und `2500 M as Km` ergab 2 statt 2.5: die
    // Umrechnung selbst warf die Nachkommastellen weg.
    var sn: int64 := self.cg_utypeFactor(srcIdx);
    var sd: int64 := self.cg_utypeFactorDen(srcIdx);
    var dn: int64 := self.cg_utypeFactor(dstIdx);
    var dd: int64 := self.cg_utypeFactorDen(dstIdx);
    self.cg_emitConvFrac(sn, sd, dn, dd);
  }

  // Derselbe Rumpf, aber mit dem Quellfaktor als BRUCH statt als Index. Das
  // braucht #1962: das Ergebnis von `s / t` ist kein DEKLARIERTER
  // Einheitentyp, es hat aber sehr wohl einen Faktor — bei km durch h eben
  // 1000/3600. Ohne diesen Weg stimmte die Dimensionspruefung, aber die Zahl
  // nicht: 36 km/h ergaben 36 statt 10 m/s.
  fn cg_emitConvFrac(sn: int64, sd: int64, dn: int64, dd: int64) {
    if (sd == 0 || dn == 0) { return; }
    // #1953: ERST KUERZEN, DANN MULTIPLIZIEREN. Vorher wurde `sn * dd` und
    // `sd * dn` roh gerechnet und das Ergebnis hinterher gekuerzt — bei zwei
    // genauen Faktoren lief das ueber:
    //
    //   oz = 0.028349523125 (28349523125/1e12), lb = 0.45359237 (45359237/1e8)
    //   div = 1e12 * 45359237 = 4.5e19  >  int64-Grenze 9.2e18
    //
    // 16 oz ergaben damit 5.357971 lb statt 1. Der Waechter in
    // cg_parseFactorRatio (`den > 1e14`) begrenzt jeden Faktor EINZELN und
    // sagt nichts ueber das Produkt zweier Faktoren — die zweite Stelle war
    // nicht nachgezogen.
    //
    // Gekuerzt wird ueber Kreuz, weil genau die Paare gemeinsame Teiler
    // haben, die miteinander multipliziert werden: im Beispiel ist
    // gcd(28349523125, 45359237) = 45359237, uebrig bleibt 625/10000 = 1/16.
    var gk1: int64 := self.cg_gcd(sn, dn);
    if (gk1 > 1) { sn := sn / gk1; dn := dn / gk1; }
    var gk2: int64 := self.cg_gcd(sd, dd);
    if (gk2 > 1) { sd := sd / gk2; dd := dd / gk2; }
    // Nach dem Kuerzen darf das Produkt immer noch nicht passen. Dann wird
    // gemeldet statt gerechnet: ein uebergelaufener Faktor ist keine
    // Umrechnung, sondern eine Zufallszahl (#2006, dieselbe Haltung).
    var grenze: int64 := 4611686018427387904;      // 2^62, mit Luft
    if (sn != 0 && dd > grenze / sn) { self.cg_convOverflow(); }
    if (sd != 0 && dn > grenze / sd) { self.cg_convOverflow(); }
    var mul: int64 := sn * dd;
    var div: int64 := sd * dn;
    var g: int64 := self.cg_gcd(mul, div);
    mul := mul / g;
    div := div / g;
    if (mul == div) { return; }
    self.cg_uMovXmm0Rax();
    if (mul != 1) {
      self.cg_uLoadConst(1, mul);
      self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x59); self.cg_e8(0xC1);  // mulsd xmm0, xmm1
    }
    if (div != 1) {
      self.cg_uLoadConst(1, div);
      self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x5E); self.cg_e8(0xC1);  // divsd xmm0, xmm1
    }
    self.cg_uMovRaxXmm0();
  }


  // #1110: Grenzen eines Einheitentyps durchsetzen (§11 UtypeRangeModifier).
  // `range` bricht ausserhalb mit panic ab — wie der Bereichstyp aus #1097.
  // `wraps` rechnet stattdessen in den Bereich zurueck; dafuer gibt es die
  // Schreibweise ueberhaupt (Winkel, Uhrzeiten).
  //
  // Die Grenzen sind EINSCHLIESSLICH, wie bei den Bereichstypen; die Spanne
  // ist also hi-lo+1.
  fn cg_emitUtypeRange(idx: int64) {
    if (idx < 0) { return; }
    var base: int64  := self.utypes + idx * 72;
    var flags: int64 := peek64(base + 56);
    if ((flags & 1) == 0) { return; }
    var lo: int64 := peek64(base + 40);
    var hi: int64 := peek64(base + 48);
    // #1955: Seit Einheitenwerte in Gleitkomma liegen, MUSS auch hier in
    // Gleitkomma verglichen werden. Ein ganzzahliger `cmp rax, lo` auf einem
    // IEEE-Bitmuster vergleicht nicht den Wert, sondern die Bits — die Grenzen
    // pruefen dann stillschweigend gar nichts mehr (jede positive Zahl haette
    // ein riesiges Bitmuster). Das ist die Klasse "zweite Stelle nicht
    // nachgezogen": die Rechnung wurde umgestellt, die Pruefung daneben nicht.
    if ((flags & 2) != 0) {
      // wraps: wert := x - floor(x/span) * span + lo,  mit x = wert - lo.
      //
      // #2004: Hier stand `(t - floor(t)) * span + lo`. Mathematisch dasselbe,
      // in Gleitkomma aber nicht: der Nachkommateil wird ausgerechnet und mit
      // span zurueckmultipliziert, und dabei geht die letzte Stelle verloren.
      // Aus 362 wurde 0 statt 1, aus 370 wurde 8 statt 9 — waehrend 361 und
      // 720 stimmten, weil dort der Nachkommateil exakt null bzw. exakt
      // darstellbar war. Ein Ergebnistest an einer einzelnen Zahl haette den
      // Fehler nicht gefunden.
      //
      // Die stabile Form subtrahiert das VIELFACHE vom Ausgangswert, statt
      // den Bruchteil zurueckzuskalieren: floor(t) ist eine ganze Zahl,
      // floor(t)*span damit exakt, und die Subtraktion verliert nichts.
      var span: int64 := hi - lo + 1;
      if (span <= 0) { return; }
      self.cg_uMovXmm0Rax();
      if (lo != 0) {
        self.cg_uLoadConst(1, lo);
        self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x5C); self.cg_e8(0xC1);  // subsd xmm0, xmm1
      }
      self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x28); self.cg_e8(0xE0);    // movapd xmm4, xmm0 (x sichern)
      self.cg_uLoadConst(3, span);                                              // xmm3 = span
      self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x5E); self.cg_e8(0xC3);    // divsd xmm0, xmm3
      // floor(t): abschneiden, und bei negativem t um 1 zurueck. `roundsd`
      // waere kuerzer, verlangt aber SSE4.1 — der Codegen setzt nur den
      // x86-64-Grundbefehlssatz voraus.
      self.cg_e8(0xF2); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x2C); self.cg_e8(0xC8); // cvttsd2si rcx, xmm0
      self.cg_e8(0xF2); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x2A); self.cg_e8(0xD1); // cvtsi2sd xmm2, rcx
      self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x2E); self.cg_e8(0xD0);   // ucomisd xmm2, xmm0
      self.cg_e8(0x76); var pSkip: int64 := self.codeLen; self.cg_e8(0);        // jbe skip
      self.cg_uLoadConst(1, 1);
      self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x5C); self.cg_e8(0xD1);   // subsd xmm2, xmm1
      cg_patchRel8(self.code, pSkip, self.codeLen);
      self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x59); self.cg_e8(0xD3);   // mulsd xmm2, xmm3 (floor(t)*span)
      self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x28); self.cg_e8(0xC4);   // movapd xmm0, xmm4 (x zurueck)
      self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x5C); self.cg_e8(0xC2);   // subsd xmm0, xmm2
      if (lo != 0) {
        self.cg_uLoadConst(1, lo);
        self.cg_e8(0xF2); self.cg_e8(0x0F); self.cg_e8(0x58); self.cg_e8(0xC1); // addsd xmm0, xmm1
      }
      self.cg_uMovRaxXmm0();
      return;
    }
    // range: unter lo oder ueber hi -> panic. `jb` faengt zugleich NaN ab:
    // ucomisd setzt bei einem NaN-Operanden CF=1 (#1128), der Wert gilt damit
    // als ausserhalb — richtig, ein NaN liegt in keinem Bereich.
    self.cg_uMovXmm0Rax();
    self.cg_uLoadConst(1, lo);
    self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x2E); self.cg_e8(0xC1);     // ucomisd xmm0, xmm1
    self.cg_e8(0x72); var pLo: int64 := self.codeLen; self.cg_e8(0);            // jb -> panic
    self.cg_uLoadConst(1, hi);
    self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x2E); self.cg_e8(0xC1);     // ucomisd xmm0, xmm1
    self.cg_e8(0x76); var pOk: int64 := self.codeLen; self.cg_e8(0);            // jbe -> ok
    cg_patchRel8(self.code, pLo, self.codeLen);
    self.cg_pushRax();
    var msgOff: int64 := self.dataLen;
    var msg: pchar := "unit value out of range\n"c;
    var mi: int64 := 0;
    while (mi < 24) { self.cg_edata(StrCharAt(msg, mi)); mi := mi + 1; }
    self.cg_edata(0);
    self.cg_emitLeaRdiData(msgOff);
    self.cg_emitPanicBody();
    self.cg_popRax();
    cg_patchRel8(self.code, pOk, self.codeLen);
  }


  // #1110: Einheit des Ausdrucks, soweit der Codegen sie kennt. Nur der Fall,
  // der zaehlt: eine Variable mit deklariertem Einheitentyp. Alles andere
  // liefert -1 und loest keine Umrechnung aus.
  // #1963: Woher kann ein Einheitenwert kommen?
  //
  // Diese Funktion kannte NUR den Bezeichner. Alles andere lieferte -1, und
  // cg_emitUtypeConv kehrt bei -1 sofort zurueck — die Umrechnung entfiel
  // damit STUMM. `var b: Km := a;` ergab 2.5, `var b: Km := a as Km;` dagegen
  // 2500. Kein Fehler, keine Meldung, nur eine falsche Zahl, die wie eine
  // gueltige Groesse aussieht.
  //
  // Es ist die im Projekt mehrfach belegte Klasse "eine Aufzaehlung ist
  // unvollstaendig" — dieselbe Form wie _localTypeNode (#1787, #1812) und
  // _findLocalSlot (#1806). Die Herkuenfte sind deshalb hier dieselben wie in
  // cg_isF64Expr; die beiden Aufzaehlungen beantworten verschiedene Fragen
  // ueber DENSELBEN Ausdruck und muessen zusammen wachsen. Wer eine neue
  // Herkunft anlegt, traegt sie in BEIDE ein.
  fn cg_utypeOfExpr(ni: int64): int64 {
    if (ni < 0) { return 0 - 1; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_IDENT) {
      var uLoc: int64 := self.cg_utypeOfLocal(self.cg_nsval(ni), self.cg_nslen(ni));
      if (uLoc >= 0) { return uLoc; }
      // Eine GLOBALE Variable mit Einheitentyp. Ein Local gleichen Namens
      // verdeckt sie, darum erst hier — wie in cg_isF64Expr (#1373).
      var gi: int64 := self.cg_findGlobalIdx(self.cg_nsval(ni), self.cg_nslen(ni));
      if (gi >= 0) {
        var gp: pchar := peek64(self.globalTypeNames + gi * 16) as pchar;
        var gl: int64 := peek64(self.globalTypeNames + gi * 16 + 8);
        if (gp != 0 as pchar && gl > 0) { return self.cg_findUtype(gp, gl); }
      }
      return 0 - 1;
    }
    // Der `as`-Cast zwischen zwei Einheiten DERSELBEN Dimension ist eine
    // Umrechnung, keine Umdeutung: `a as Km` meint dieselbe Strecke in einer
    // anderen Einheit. Die Quelleinheit steht am Ausdruck darunter, die
    // Zieleinheit am Typknoten — massgeblich ist hier das ZIEL, denn der
    // Cast-Ausdruck traegt die Einheit, in die er umwandelt.
    if (k == CGN_CAST) {
      var tn: int64 := self.cg_nc1(ni);
      if (tn >= 0) { return self.cg_utypeOfTypeNode(tn); }
      return 0 - 1;
    }
    // #1956: die RECHNUNG selbst. Ohne diesen Fall gab cg_utypeOfExpr fuer
    // `a + b` still -1 zurueck, und die Zuweisung des Ergebnisses rechnete
    // deshalb nicht um: `var s: KM := a + b;` lieferte 1500 statt 1.5, obwohl
    // die Summe in Metern bereits richtig war. Wieder die Klasse "eine
    // Aufzaehlung ist unvollstaendig" — dieselbe, vor der der Kommentar oben
    // warnt, nur eine Herkunft weiter.
    //
    // Massgeblich ist die LINKE Seite; das deckt sich mit _utypeOfExpr in
    // sema, wo der Ergebnistyp eines `+` die linke Einheit ist. Traegt nur
    // die rechte eine Einheit (`3 * laenge`), gilt deren.
    //
    // NUR fuer + und -. Bei * und / ergaeben zwei Einheiten eine ABGELEITETE
    // Dimension, und die rechnet der Compiler bis heute nicht aus (#1962);
    // hier "unbekannt" zu liefern ist die ehrliche Antwort. Skalierung mit
    // einer dimensionslosen Zahl behaelt dagegen die Einheit.
    if (k == CGN_BINOP) {
      var bop: int64 := self.cg_nival(ni);
      var lb: int64 := self.cg_utypeOfExpr(self.cg_nc0(ni));
      var rb: int64 := self.cg_utypeOfExpr(self.cg_nc1(ni));
      if (bop == CGT_PLUS || bop == CGT_MINUS) {
        if (lb >= 0) { return lb; }
        return rb;
      }
      if (bop == CGT_STAR || bop == CGT_SLASH) {
        if (lb >= 0 && rb >= 0) { return 0 - 1; }   // abgeleitet: #1962
        if (bop == CGT_STAR && rb >= 0) { return rb; }
        return lb;
      }
      return 0 - 1;
    }
    // Das AUFRUFERGEBNIS. `var b: Km := hoehe();` mit `hoehe(): M` rechnete
    // nicht um. Methodenaufrufe (iVal == 1) bleiben aussen vor: ihr
    // Rueckgabetyp steht unter dem gemangelten Namen "Klasse_Methode", und
    // nach dem nackten Namen zu suchen waere eine Zuordnung zu weit — eine
    // gleichnamige Methode einer anderen Klasse wuerde dann die Einheit
    // stellen. Der Fall gehoert nachgezogen, sobald er gebraucht wird; bis
    // dahin gilt hier "unbekannt" (-1) und nicht "irgendeine Einheit".
    if (k == CGN_CALL) {
      if (self.cg_nival(ni) == 1) { return 0 - 1; }
      var rbox: int64 := alloc(8);
      var rnLc: int64 := alloc(8);   // #2044
      var rnP: pchar := self.cg_callName(ni, rnLc);
      var rtp: pchar := self.cg_funcRetTypeName(rnP, peek64(rnLc), rbox);
      free(rnLc, 8);
      var rtl: int64 := peek64(rbox);
      free(rbox, 8);
      if (rtp != 0 as pchar && rtl > 0) { return self.cg_findUtype(rtp, rtl); }
      return 0 - 1;
    }
    // Der FELDZUGRIFF: `var b: Km := s.strecke;` mit `strecke: M`.
    if (k == CGN_FIELD) {
      var fbox: int64 := alloc(8);
      var ftp: pchar := self.cg_fieldTypeNameOf(ni, fbox);
      var ftl: int64 := peek64(fbox);
      free(fbox, 8);
      if (ftp != 0 as pchar && ftl > 0) { return self.cg_findUtype(ftp, ftl); }
      return 0 - 1;
    }
    return 0 - 1;
  }

  fn cg_addRangeType(name: pchar, nameLen: int64, lo: int64, hi: int64, flags: int64) {
    if (self.rangeTypeCount >= self.rangeTypeCap) {
      var nc: int64 := self.rangeTypeCap * 2;
      var nb: int64 := alloc(nc * 40);
      memcpy(nb, self.rangeTypes, self.rangeTypeCount * 40);
      self.rangeTypes := nb;
      self.rangeTypeCap := nc;
    }
    var base: int64 := self.rangeTypes + self.rangeTypeCount * 40;
    poke64(base,      name as int64);
    poke64(base + 8,  nameLen);
    poke64(base + 16, lo);
    poke64(base + 24, hi);
    poke64(base + 32, flags);     // #1882: Bit0 = wraps
    self.rangeTypeCount += 1;
  }

  fn cg_findRangeType(name: pchar, nameLen: int64): int64 {
    if (nameLen <= 0) { return 0 - 1; }
    var i: int64 := 0;
    while (i < self.rangeTypeCount) {
      var base: int64 := self.rangeTypes + i * 40;
      var p: pchar := peek64(base) as pchar;
      var n: int64 := peek64(base + 8);
      if (self.cg_seq(p, n, name, nameLen)) { return i; }
      i += 1;
    }
    return 0 - 1;
  }

  // Bereichstyp eines Typknotens (NK_TYPE_NAME); -1 wenn keiner.
  fn cg_rangeOfTypeNode(typeNode: int64): int64 {
    if (typeNode < 0) { return 0 - 1; }
    if (self.cg_nkind(typeNode) != 60) { return 0 - 1; }
    return self.cg_findRangeType(self.cg_nsval(typeNode), self.cg_nslen(typeNode));
  }

  // Bereichstyp einer Variablen ueber ihren deklarierten Typnamen — lokal wie
  // global. Eine globale Variable vom Bereichstyp waere sonst der eine Weg,
  // auf dem die Zusicherung weiter durchfiele.
  fn cg_rangeOfLocal(name: pchar, nameLen: int64): int64 {
    var lidx: int64 := self.cg_findLocalIdx(name, nameLen);
    if (lidx >= 0) {
      var tb: int64 := self.localTypes + lidx * CG_LOCTYPE_SZ;
      var tp: pchar := peek64(tb) as pchar;
      var tl: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
      if (tp == 0 as pchar || tl <= 0) { return 0 - 1; }
      return self.cg_findRangeType(tp, tl);
    }
    var gidx: int64 := self.cg_findGlobalIdx(name, nameLen);
    if (gidx >= 0) {
      var gp: pchar := peek64(self.globalTypeNames + gidx * 16) as pchar;
      var gl: int64 := peek64(self.globalTypeNames + gidx * 16 + 8);
      if (gp == 0 as pchar || gl <= 0) { return 0 - 1; }
      return self.cg_findRangeType(gp, gl);
    }
    return 0 - 1;
  }

  // Bereichstyp eines Strukturfeldes ueber seinen deklarierten Typnamen.
  fn cg_rangeOfField(classIdx: int64, fieldName: pchar, fieldLen: int64): int64 {
    if (classIdx < 0) { return 0 - 1; }
    var base: int64 := self.classLayouts + classIdx * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var p: pchar := peek64(fb) as pchar;
      var n: int64 := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (self.cg_seq(p, n, fieldName, fieldLen)) {
        var tp: pchar := peek64(fb + CG_CFIELD_OFF_TYPENAMEPTR) as pchar;
        var tl: int64 := peek64(fb + CG_CFIELD_OFF_TYPENAMELEN);
        if (tp == 0 as pchar || tl <= 0) { return 0 - 1; }
        return self.cg_findRangeType(tp, tl);
      }
      i += 1;
    }
    return 0 - 1;
  }

  // #1151: Schmale Ganzzahltypen. Ein Local, ein Parameter und eine globale
  // Variable belegen IMMER einen 64-Bit-Slot — auch wenn sie `int8` heissen.
  // Bis 1.0.11D wurde der Wert ungekuerzt hineingelegt: `var a: int8 := 130`
  // lieferte 130 statt -126, `var d: uint8 := 0-1` lieferte -1 statt 255. Der
  // Typ trug seine Breite also nur im Namen.
  //
  // Strukturfelder waren nie betroffen: sie liegen in ihrer eigenen Breite im
  // Speicher, das Kuerzen erledigt dort der Speicherbefehl.
  //
  // Rueckgabe: 0 = kein schmaler Typ, sonst die Kennung fuer cg_emitNarrowRax.
  // #1125: Ist der Typname vorzeichenlos? Deckt die kurze und die lange
  // Schreibweise ab (`u32` wie `uint32`) und schliesst `uint64`/`u64` ein, das
  // cg_narrowKindOf nicht kennt — dort geht es um die BREITE, hier um das
  // Vorzeichen.
  // #1125: Arithmetischer Rechtsshift zur UEBERSETZUNGSZEIT. Der Falter darf
  // nicht das `>>` des bauenden Compilers benutzen: dessen Verhalten ist
  // genau das, was hier repariert wird — ein aelterer Wirt faltete logisch,
  // ein neuerer arithmetisch, und der Fixpunkt haette davon abgehangen.
  // Gerechnet wird deshalb ausdruecklich: floor(v / 2^n), also fuer negative
  // Werte abrundend statt gegen null trunkierend (die Division tut Letzteres).
  // Der Shift-Betrag wird wie in der Hardware auf 6 Bit maskiert.
  fn cg_sarConst(v: int64, n: int64): int64 {
    var sh: int64 := n & 63;
    var pow: int64 := 1;
    var i: int64 := 0;
    while (i < sh) { pow := pow * 2; i := i + 1; }
    if (v >= 0) { return v / pow; }
    return 0 - ((0 - v + pow - 1) / pow);
  }

  fn cg_typeNameIsUnsigned(tname: pchar, tlen: int64): int64 {
    if (tlen <= 0) { return 0; }
    if (self.cg_seq(tname, tlen, "u8", 2)  || self.cg_seq(tname, tlen, "uint8", 5))  { return 1; }
    if (self.cg_seq(tname, tlen, "u16", 3) || self.cg_seq(tname, tlen, "uint16", 6)) { return 1; }
    if (self.cg_seq(tname, tlen, "u32", 3) || self.cg_seq(tname, tlen, "uint32", 6)) { return 1; }
    if (self.cg_seq(tname, tlen, "u64", 3) || self.cg_seq(tname, tlen, "uint64", 6)) { return 1; }
    return 0;
  }

  // #1125: Traegt der Ausdruck einen vorzeichenlosen Typ? Massgeblich fuer den
  // Rechtsshift. Bekannt sind die Faelle, in denen der Typ ohne Aufwand
  // feststeht: eine Variable mit deklariertem Typ (lokal oder global) und ein
  // `as`-Cast. Alles andere gilt als vorzeichenbehaftet — das ist die Vorgabe
  // von `int64` und die sichere Antwort, denn sie erhaelt das Vorzeichen.
  fn cg_isUnsignedExpr(ni: int64): int64 {
    if (ni < 0) { return 0; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_IDENT) {
      var nm: pchar := self.cg_nsval(ni);
      var nl: int64 := self.cg_nslen(ni);
      var lidx: int64 := self.cg_findLocalIdx(nm, nl);
      if (lidx >= 0) {
        var tb: int64 := self.localTypes + lidx * CG_LOCTYPE_SZ;
        var tp: pchar := peek64(tb) as pchar;
        var tl: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
        if (tp == 0 as pchar || tl <= 0) { return 0; }
        return self.cg_typeNameIsUnsigned(tp, tl);
      }
      var gidx: int64 := self.cg_findGlobalIdx(nm, nl);
      if (gidx >= 0) {
        var gp: pchar := peek64(self.globalTypeNames + gidx * 16) as pchar;
        var gl: int64 := peek64(self.globalTypeNames + gidx * 16 + 8);
        if (gp == 0 as pchar || gl <= 0) { return 0; }
        return self.cg_typeNameIsUnsigned(gp, gl);
      }
      return 0;
    }
    if (k == CGN_CAST) {
      var tn: int64 := self.cg_nc1(ni);
      if (tn >= 0 && self.cg_nkind(tn) == 60) {
        return self.cg_typeNameIsUnsigned(self.cg_nsval(tn), self.cg_nslen(tn));
      }
      return 0;
    }
    return 0;
  }

  fn cg_narrowKindOf(tname: pchar, tlen: int64): int64 {
    if (tlen <= 0) { return 0; }
    if (self.cg_seq(tname, tlen, "i8", 2)     || self.cg_seq(tname, tlen, "int8", 4))   { return 1; }
    if (self.cg_seq(tname, tlen, "u8", 2)     || self.cg_seq(tname, tlen, "uint8", 5))  { return 2; }
    if (self.cg_seq(tname, tlen, "i16", 3)    || self.cg_seq(tname, tlen, "int16", 5))  { return 3; }
    if (self.cg_seq(tname, tlen, "u16", 3)    || self.cg_seq(tname, tlen, "uint16", 6)) { return 4; }
    if (self.cg_seq(tname, tlen, "i32", 3)    || self.cg_seq(tname, tlen, "int32", 5))  { return 5; }
    if (self.cg_seq(tname, tlen, "u32", 3)    || self.cg_seq(tname, tlen, "uint32", 6)) { return 6; }
    return 0;
  }

  // rax auf die Breite des Typs kuerzen: vorzeichenbehaftet bei `intN`,
  // vorzeichenlos bei `uintN`.
  fn cg_emitNarrowRax(kind: int64) {
    if (kind == 1) {
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBE); self.cg_e8(0xC0);  // movsx rax, al
    } else if (kind == 2) {
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); self.cg_e8(0xC0);  // movzx rax, al
    } else if (kind == 3) {
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBF); self.cg_e8(0xC0);  // movsx rax, ax
    } else if (kind == 4) {
      self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB7); self.cg_e8(0xC0);  // movzx rax, ax
    } else if (kind == 5) {
      self.cg_e8(0x48); self.cg_e8(0x63); self.cg_e8(0xC0);                     // movsxd rax, eax
    } else if (kind == 6) {
      self.cg_e8(0x89); self.cg_e8(0xC0);                                       // mov eax, eax
    }
  }

  // Dieselbe Kuerzung zur Uebersetzungszeit, fuer Werte, die ohne Codeerzeugung
  // in den Datenbereich gehen (globale Literal-Initialisierung).
  fn cg_narrowConst(v: int64, kind: int64): int64 {
    if (kind == 1) { var b: int64 := v & 255;        if (b >= 128)        { return b - 256; }        return b; }
    if (kind == 2) { return v & 255; }
    if (kind == 3) { var w: int64 := v & 65535;      if (w >= 32768)      { return w - 65536; }      return w; }
    if (kind == 4) { return v & 65535; }
    if (kind == 5) { var d: int64 := v & 4294967295; if (d >= 2147483648) { return d - 4294967296; } return d; }
    if (kind == 6) { return v & 4294967295; }
    return v;
  }

  fn cg_narrowKindOfTypeNode(typeNode: int64): int64 {
    if (typeNode < 0) { return 0; }
    if (self.cg_nkind(typeNode) != 60) { return 0; }
    return self.cg_narrowKindOf(self.cg_nsval(typeNode), self.cg_nslen(typeNode));
  }

  // Breite einer Variablen ueber ihren deklarierten Typnamen — lokal wie
  // global. Ohne den globalen Zweig bliebe `var g: int8` der eine Weg, auf
  // dem die Breite weiter durchfiele.
  fn cg_narrowKindOfVar(name: pchar, nameLen: int64): int64 {
    var lidx: int64 := self.cg_findLocalIdx(name, nameLen);
    if (lidx >= 0) {
      var tb: int64 := self.localTypes + lidx * CG_LOCTYPE_SZ;
      var tp: pchar := peek64(tb) as pchar;
      var tl: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
      if (tp == 0 as pchar || tl <= 0) { return 0; }
      return self.cg_narrowKindOf(tp, tl);
    }
    var gidx: int64 := self.cg_findGlobalIdx(name, nameLen);
    if (gidx >= 0) {
      var gp: pchar := peek64(self.globalTypeNames + gidx * 16) as pchar;
      var gl: int64 := peek64(self.globalTypeNames + gidx * 16 + 8);
      if (gp == 0 as pchar || gl <= 0) { return 0; }
      return self.cg_narrowKindOf(gp, gl);
    }
    return 0;
  }

  // Einen bereits abgelegten Slot nachtraeglich kuerzen. Parameter kommen aus
  // dem Register in ihren Slot; die Kuerzung dort nachzuziehen ist billiger,
  // als jede der sechs Spill-Stellen zu verdoppeln.
  fn cg_narrowLocalSlot(off: int64, typeNode: int64) {
    var kind: int64 := self.cg_narrowKindOfTypeNode(typeNode);
    if (kind == 0) { return; }
    self.cg_loadRax(off);
    self.cg_emitNarrowRax(kind);
    self.cg_storeRax(off);
  }

  // Zeichenkette als NUL-terminierte Datenkonstante ablegen; liefert den Offset.
  fn cg_emitCStrData(s: pchar): int64 {
    var off: int64 := self.dataLen;
    var n: int64 := StrLen(s);
    var i: int64 := 0;
    while (i < n) { self.cg_edata(StrCharAt(s, i)); i += 1; }
    self.cg_edata(0);
    return off;
  }

  // #1097: rax gegen die Grenzen des Bereichstyps pruefen; ausserhalb → panic.
  //
  // rax bleibt erhalten, die Pruefung benutzt nur rcx. Sie haengt NICHT an
  // --runtime-checks: eine Zusicherung, die von einem Uebersetzungsschalter
  // abhaengt, ist eine Zusicherung mit Fussnote, und der Bereich ist der
  // einzige Inhalt dieses Typs.
  fn cg_emitRangeCheck(idx: int64, ctx: pchar) {
    if (idx < 0) { return; }
    var base: int64 := self.rangeTypes + idx * 40;
    var tnp: pchar := peek64(base) as pchar;
    var tnl: int64 := peek64(base + 8);
    var lo: int64 := peek64(base + 16);
    var hi: int64 := peek64(base + 24);
    // #1882: `wraps` rechnet um, statt zu melden. Dieselbe Rechnung wie in
    // cg_emitUtypeRange — die beiden muessen uebereinstimmen:
    //   rax := ((rax - lo) mod span + span) mod span + lo,  span = hi - lo + 1
    // Die Grenzen sind EINSCHLIESSLICH, `wraps 0..360` rechnet also modulo
    // 361. Das ist beim Einheitentyp seit jeher so und bleibt hier gleich.
    if ((peek64(base + 32) & 1) != 0) {
      var span: int64 := hi - lo + 1;
      if (span <= 0) { return; }
      if (lo != 0) {
        self.cg_e8(0x48); self.cg_e8(0x2D); self.cg_e32(lo);                     // sub rax, lo
      }
      self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1); self.cg_e32(span);   // mov rcx, span
      self.cg_e8(0x48); self.cg_e8(0x99);                                        // cqo
      self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);                      // idiv rcx
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD0);                      // mov rax, rdx
      self.cg_e8(0x48); self.cg_e8(0x05); self.cg_e32(span);                     // add rax, span
      self.cg_e8(0x48); self.cg_e8(0x99);                                        // cqo
      self.cg_e8(0x48); self.cg_e8(0xF7); self.cg_e8(0xF9);                      // idiv rcx
      self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xD0);                      // mov rax, rdx
      if (lo != 0) {
        self.cg_e8(0x48); self.cg_e8(0x05); self.cg_e32(lo);                     // add rax, lo
      }
      return;
    }
    // Meldung zur Uebersetzungszeit bauen: sie nennt den Typ, die Grenzen und
    // die Stelle — "ausserhalb des Bereichs" allein liesse offen, welcher.
    var msg: pchar := StrConcat("Bereichstyp "c, StrSub(tnp, 0, tnl));
    msg := StrConcat(msg, ": Wert ausserhalb von "c);
    msg := StrConcat(msg, IntToStr(lo));
    msg := StrConcat(msg, ".."c);
    msg := StrConcat(msg, IntToStr(hi));
    msg := StrConcat(msg, " ("c);
    msg := StrConcat(msg, ctx);
    msg := StrConcat(msg, ")\n"c);
    var msgOff: int64 := self.cg_emitCStrData(msg);
    // mov rcx, lo ; cmp rax, rcx ; jl fail
    self.cg_e8(0x48); self.cg_e8(0xB9); self.cg_e64(lo);
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);   // cmp rax, rcx
    self.cg_e8(0x0F); self.cg_e8(0x8C);                     // jl  .fail
    var jFail: int64 := self.codeLen;
    self.cg_e32(0);
    // mov rcx, hi ; cmp rax, rcx ; jle ok
    self.cg_e8(0x48); self.cg_e8(0xB9); self.cg_e64(hi);
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC8);   // cmp rax, rcx
    self.cg_e8(0x0F); self.cg_e8(0x8E);                     // jle .ok
    var jOk: int64 := self.codeLen;
    self.cg_e32(0);
    poke32(self.code + jFail, self.codeLen - jFail - 4);
    self.cg_emitLeaRdiData(msgOff);
    self.cg_emitPanicBody();
    poke32(self.code + jOk, self.codeLen - jOk - 4);
  }

  // #1094: Kanonische Nummer eines eingebauten Typnamens, 0 = kein eingebauter
  // Typ. Die Schreibvarianten muessen dieselbe Nummer bekommen, sonst waere
  // `x is uint64` bei `var x: u64` falsch — sie bezeichnen denselben Typ.
  fn cg_builtinTypeId(nm: pchar, nl: int64): int64 {
    if (self.cg_seq(nm, nl, "bool",   4)) { return 1; }
    if (self.cg_seq(nm, nl, "int64",  5)) { return 2; }
    if (self.cg_seq(nm, nl, "i64",    3)) { return 2; }
    if (self.cg_seq(nm, nl, "int32",  5)) { return 3; }
    if (self.cg_seq(nm, nl, "i32",    3)) { return 3; }
    if (self.cg_seq(nm, nl, "int16",  5)) { return 4; }
    if (self.cg_seq(nm, nl, "i16",    3)) { return 4; }
    if (self.cg_seq(nm, nl, "int8",   4)) { return 5; }
    if (self.cg_seq(nm, nl, "i8",     2)) { return 5; }
    if (self.cg_seq(nm, nl, "u64",    3)) { return 6; }
    if (self.cg_seq(nm, nl, "uint64", 6)) { return 6; }
    if (self.cg_seq(nm, nl, "u32",    3)) { return 7; }
    if (self.cg_seq(nm, nl, "uint32", 6)) { return 7; }
    if (self.cg_seq(nm, nl, "u16",    3)) { return 8; }
    if (self.cg_seq(nm, nl, "uint16", 6)) { return 8; }
    if (self.cg_seq(nm, nl, "u8",     2)) { return 9; }
    if (self.cg_seq(nm, nl, "uint8",  5)) { return 9; }
    if (self.cg_seq(nm, nl, "pchar",  5)) { return 10; }
    if (self.cg_seq(nm, nl, "f64",    3)) { return 11; }
    if (self.cg_seq(nm, nl, "f32",    3)) { return 12; }
    if (self.cg_seq(nm, nl, "char",   4)) { return 13; }
    if (self.cg_seq(nm, nl, "void",   4)) { return 14; }
    return 0;
  }

  // #1094: statischer Typname eines Ausdrucks; 0 = nicht bestimmbar.
  // Die Laenge steht danach in self.stnLen.
  //
  // `is` braucht diesen Namen zweimal: fuer die Frage, ob der Empfaenger
  // ueberhaupt eine Klasse mit VMT ist (nur dann darf zur Laufzeit geprueft
  // werden — bei einem int64 laege an [rax] keine VMT), und fuer die Antwort
  // in allen uebrigen Faellen, die statisch feststeht. Wo der Typ nicht
  // bestimmbar ist, MELDET `is` das; ein „unbekannt heisst false" waere genau
  // der stille Default, der den Fehler ausgemacht hat.
  fn cg_staticTypeName(ni: int64): pchar {
    self.stnLen := 0;
    if (ni < 0) { return 0 as pchar; }
    var k: int64 := self.cg_nkind(ni);
    if (k == CGN_LIT_INT)   { self.stnLen := 5; return "int64"c; }
    if (k == CGN_LIT_STR)   { self.stnLen := 5; return "pchar"c; }
    if (k == CGN_LIT_FLOAT) { self.stnLen := 3; return "f64"c;   }
    if (k == CGN_LIT_BOOL)  { self.stnLen := 4; return "bool"c;  }
    if (k == CGN_LIT_CHAR)  { self.stnLen := 4; return "char"c;  }
    // `x as T` und `new T` nennen ihren Typ selbst.
    if (k == CGN_CAST) {
      var tn2: int64 := self.cg_nc1(ni);
      if (tn2 < 0) { return 0 as pchar; }
      self.stnLen := self.cg_nslen(tn2);
      return self.cg_nsval(tn2);
    }
    if (k == CGN_NEW) {
      self.stnLen := self.cg_nslen(ni);
      return self.cg_nsval(ni);
    }
    if (k == CGN_IDENT) {
      var nm: pchar := self.cg_nsval(ni);
      var nl: int64 := self.cg_nslen(ni);
      if (self.cg_seq(nm, nl, "self", 4)) {
        if (self.curClassName == 0 as pchar) { return 0 as pchar; }
        self.stnLen := self.curClassNameLen;
        return self.curClassName;
      }
      var lidx: int64 := self.cg_findLocalIdx(nm, nl);
      if (lidx >= 0) {
        var tb: int64 := self.localTypes + lidx * CG_LOCTYPE_SZ;
        var tp: pchar := peek64(tb) as pchar;
        var tl: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
        if (tp == 0 as pchar || tl <= 0) { return 0 as pchar; }
        self.stnLen := tl;
        return tp;
      }
      var gidx: int64 := self.cg_findGlobalIdx(nm, nl);
      if (gidx >= 0) {
        var gp: pchar := peek64(self.globalTypeNames + gidx * 16) as pchar;
        var gl: int64 := peek64(self.globalTypeNames + gidx * 16 + 8);
        if (gp == 0 as pchar || gl <= 0) { return 0 as pchar; }
        self.stnLen := gl;
        return gp;
      }
      var cidx: int64 := self.cg_findConIdx(nm, nl);
      if (cidx >= 0) {
        if (peek8(self.conIsPchar + cidx) != 0) { self.stnLen := 5; return "pchar"c; }
        self.stnLen := 5; return "int64"c;
      }
      return 0 as pchar;
    }
    if (k == CGN_FIELD) {
      var ci: int64 := self.cg_objClassIdx(self.cg_nc0(ni));
      if (ci < 0) { return 0 as pchar; }
      var base: int64 := self.classLayouts + ci * CG_CLASS_SZ;
      var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
      var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
      var fn2: pchar  := self.cg_nsval(ni);
      var fl2: int64  := self.cg_nslen(ni);
      var i: int64 := 0;
      while (i < cnt) {
        var fb: int64 := flds + i * CG_CFIELD_SZ;
        var p: pchar  := peek64(fb) as pchar;
        var n: int64  := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
        if (self.cg_seq(p, n, fn2, fl2)) {
          var tp2: pchar := peek64(fb + CG_CFIELD_OFF_TYPENAMEPTR) as pchar;
          var tl2: int64 := peek64(fb + CG_CFIELD_OFF_TYPENAMELEN);
          if (tp2 == 0 as pchar || tl2 <= 0) { return 0 as pchar; }
          self.stnLen := tl2;
          return tp2;
        }
        i += 1;
      }
      return 0 as pchar;
    }
    if (k == CGN_CALL && self.cg_nival(ni) == 0) {
      var cnm: pchar := self.cg_nsval(ni);
      var cnl: int64 := self.cg_nslen(ni);
      var j: int64 := self.cg_funcRetIdx(cnm, cnl);   // #2175
      if (j >= 0) {
        var rb: int64 := self.fnRetList + j * 32;
        var rt: pchar := peek64(rb + 16) as pchar;
        var rtl: int64 := peek64(rb + 24);
        if (rt == 0 as pchar || rtl <= 0) { return 0 as pchar; }
        self.stnLen := rtl;
        return rt;
      }
      return 0 as pchar;
    }
    return 0 as pchar;
  }

  // #1094: Ist ci eine Klasse, die von target abstammt (oder target selbst)?
  // #1120: die Klasse der Kette finden, die `name` tatsaechlich DEKLARIERT.
  // Der Aufruf `b.G()` wurde bisher stur auf den statischen Typ des Empfaengers
  // gemangelt (`B_G`), obwohl die nicht-virtuelle Methode bei A liegt und nicht
  // wie die Felder in die abgeleitete Klasse kopiert wird. Ergebnis war ein
  // Abbruch mit einem Namen, den niemand geschrieben hat.
  //
  // Die naeheste Definition gewinnt: eine in B neu definierte Methode gleichen
  // Namens trifft weiterhin B. Findet sich nichts, kommt -1 zurueck — der
  // Aufrufer mangelt dann wie bisher und der Fehler bleibt laut.
  fn cg_findMethodOwner(ci: int64, name: pchar, nameLen: int64): int64 {
    var cur: int64 := ci;
    while (cur >= 0) {
      var cb: int64 := self.classLayouts + cur * CG_CLASS_SZ;
      var lst: int64 := peek64(cb + CG_CLASS_OFF_METHLIST);
      var cnt: int64 := peek64(cb + CG_CLASS_OFF_METHCNT);
      var k: int64 := 0;
      while (k < cnt) {
        var mn: pchar := peek64(lst + k * 16) as pchar;
        var ml: int64 := peek64(lst + k * 16 + 8);
        if (self.cg_seq(mn, ml, name, nameLen) != 0) { return cur; }
        k := k + 1;
      }
      cur := peek64(cb + CG_CLASS_OFF_PARENTIDX);
    }
    return 0 - 1;
  }

  fn cg_isDescendantClass(ci: int64, target: int64): int64 {
    var cur: int64 := ci;
    while (cur >= 0) {
      if (cur == target) { return 1; }
      cur := peek64(self.classLayouts + cur * CG_CLASS_SZ + CG_CLASS_OFF_PARENTIDX);
    }
    return 0;
  }

  // #1094: Hat die Klasse eine VMT? Ein `struct` hat keine — an [obj+0] liegt
  // dann das erste Feld, und ein Vergleich dort waere Unsinn.
  fn cg_classHasVmt(ci: int64): int64 {
    if (ci < 0) { return 0; }
    if (peek64(self.classLayouts + ci * CG_CLASS_SZ + CG_CLASS_OFF_VMTOFF) == -1) { return 0; }
    return 1;
  }

  // #2014 Stufen 3/4: Layout eines Typs fuer die .lyu — und fuer den
  // Abgleich beim Lesen. EINE Quelle: dieselben Tabellen, mit denen der
  // Codegen Feldzugriffe uebersetzt (cg_findClass/cg_classStructSize). Wer
  // das Layout hier neu ausrechnete, haette eine zweite Stelle, die mit der
  // ersten auseinanderlaufen kann (#1998).
  //   box[0] = Gesamtgroesse, box[1] = 1, wenn ein VMT-Zeiger auf Offset 0
  //   liegt (x86: jede Klasse, kein Struct). Rueckgabe 0 = Typ unbekannt.
  pub fn CgLyuTyp(np: pchar, nl: int64, box: int64): int64 {
    var ci: int64 := self.cg_findClass(np, nl);
    if (ci < 0) { return 0; }
    poke64(box, self.cg_classStructSize(ci));
    poke64(box + 8, self.cg_classHasVmt(ci));
    return 1;
  }
  //   box[0] = Offset im Objekt, box[1] = belegte Bytes. 0 = Feld unbekannt.
  pub fn CgLyuFeld(tp: pchar, tl: int64, fp: pchar, fl: int64, box: int64): int64 {
    var ci: int64 := self.cg_findClass(tp, tl);
    if (ci < 0) { return 0; }
    var base: int64 := self.classLayouts + ci * CG_CLASS_SZ;
    var flds: int64 := peek64(base + CG_CLASS_OFF_FIELDSPTR);
    var cnt:  int64 := peek64(base + CG_CLASS_OFF_FIELDCNT);
    var i: int64 := 0;
    while (i < cnt) {
      var fb: int64 := flds + i * CG_CFIELD_SZ;
      var n: int64 := peek64(fb + CG_CFIELD_OFF_FIELDLEN);
      if (n == fl && self.cg_seq(peek64(fb) as pchar, n, fp, fl)) {
        poke64(box, peek64(fb + CG_CFIELD_OFF_OFFSET));
        var b: int64 := peek64(fb + CG_CFIELD_OFF_BYTES);
        if (b <= 0) { b := 8; }   // dieselbe Annahme wie cg_classStructSize
        poke64(box + 8, b);
        return 1;
      }
      i += 1;
    }
    return 0;
  }

  fn cg_objClassIdx(objNode: int64): int64 {
    var k: int64 := self.cg_nkind(objNode);
    // #1588: `(x as Klasse)` als Empfaenger. Der Typ steht am Cast-Knoten und
    // ist damit bekannt — diese Funktion kannte den Knoten nur nicht. Sie gab
    // -1 zurueck, der Feldoffset wurde -1, und cg_genFieldLoad nullte rax:
    // `(a as Basis).wert` lieferte STILL 0 statt 42. Die Sprachreferenz zeigt
    // genau dieses Muster fuer Klassenzeiger in int64-Variablen.
    if (k == CGN_CAST) {
      var castT: int64 := self.cg_nc1(objNode);
      if (castT < 0) { return -1; }
      return self.cg_findClass(self.cg_nsval(castT), self.cg_nslen(castT));
    }
    if (k == CGN_FIELD) {
      var innerObj: int64 := self.cg_nc0(objNode);
      var fldName: pchar  := self.cg_nsval(objNode);
      var fldLen:  int64  := self.cg_nslen(objNode);
      var parentIdx: int64 := self.cg_objClassIdx(innerObj);
      return self.cg_getFieldClassIdx(parentIdx, fldName, fldLen);
    }
    // For arr[i] where arr is Array<StructType>: return struct's class index
    if (k == CGN_INDEX) {
      var baseNode: int64 := self.cg_nc0(objNode);
      return self.cg_arrayElemClassIdx(baseNode);
    }
    // Empfänger ist selbst ein Aufruf: `t.Trim().ByteLength()` oder
    // `StringFromPchar(s).Length()`. Der Rückgabetyp steht in der fnRet-Registry
    // (freie Funktionen und Methoden werden beide dort eingetragen), und
    // cg_exprClassName löst ihn auf — inklusive Ketten, weil es sich für den
    // Empfänger selbst wieder aufruft. Vorher lieferte dieser Fall -1, der
    // Aufruf wurde ungemangelt emittiert und scheiterte beim Patchen mit
    // "undefined function 'ByteLength' — no codegen implementation found".
    if (k == CGN_CALL) {
      return self.cg_exprClassName(objNode);
    }
    if (k != CGN_IDENT) { return -1; }
    var oname: pchar := self.cg_nsval(objNode);
    var olen:  int64 := self.cg_nslen(objNode);
    if (self.cg_seq(oname, olen, "self", 4) != 0) {
      if (self.curClassName == 0 as pchar) { return -1; }
      return self.cg_findClass(self.curClassName, self.curClassNameLen);
    }
    return self.cg_getLocalClassIdx(oname, olen);
  }

  // Returns the class index of the element type for arr[i] expressions.
  // baseNode is the array expression (IDENT or FIELD).
  fn cg_arrayElemClassIdx(baseNode: int64): int64 {
    var bk: int64 := self.cg_nkind(baseNode);
    if (bk == CGN_IDENT) {
      // Local array variable: check localTypes for element type
      var bname: pchar := self.cg_nsval(baseNode);
      var blen:  int64 := self.cg_nslen(baseNode);
      var lidx: int64 := self.cg_findLocalIdx(bname, blen);
      if (lidx >= 0 && peek8(self.localIsArray + lidx) != 0) {
        var tb: int64 := self.localTypes + lidx * CG_LOCTYPE_SZ;
        var tp: pchar := peek64(tb) as pchar;
        var tn: int64 := peek64(tb + CG_LOCTYPE_OFF_LEN);
        if (tp != 0 as pchar && tn > 0) { return self.cg_findClass(tp, tn); }
      }
      return -1;
    }
    if (bk == CGN_FIELD) {
      // Class field of Array<T> type: look up element type in CG_CFIELD
      var innerObj: int64 := self.cg_nc0(baseNode);
      var fldName:  pchar  := self.cg_nsval(baseNode);
      var fldLen:   int64  := self.cg_nslen(baseNode);
      var parentIdx: int64 := self.cg_objClassIdx(innerObj);
      return self.cg_getFieldElemClassIdx(parentIdx, fldName, fldLen);
    }
    return -1;
  }

  // Inline code for arr.push(val): alloc on first use, then append
  // Layout: [ptr+0]=cap, [ptr+8]=len, [ptr+16+i*8]=data[i]
  // #1177: Ein leeres dynamisches Array anlegen — rax = Zeiger auf
  // {cap=1024, len=0} samt Ablage dahinter.
  //
  // Bis 1.0.13G legte NUR `push` an, und zwar beim ersten Aufruf. Eine
  // Variable, die nur deklariert war, blieb NULL: `len(a)` und `a[0]` trafen
  // die Null, und `a[0] := 5` schrieb dorthin. Ein `int64[N]` wird seit jeher
  // belegt, ein `var s: S;` seit WP-10d — die dynamische Schreibweise fiel als
  // einzige heraus.
  //
  // Dieselbe Folge steht in cg_genArrayPush; sie liegt hier, damit beide
  // Stellen nicht auseinanderlaufen koennen. `push` findet den Zeiger dann
  // gesetzt vor und ueberspringt seinen eigenen Allokationszweig.
  fn cg_emitEmptyDynArray() {
    self.cg_e8(0x31); self.cg_e8(0xFF);                                        // xor edi, edi
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC6);
    self.cg_e8(0x10); self.cg_e8(0x20); self.cg_e8(0x00); self.cg_e8(0x00);   // mov rsi, (1024+2)*8
    self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov edx, PROT_RW
    self.cg_e8(0xB8); self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, MAP_ANON|PRIVATE
    self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);                      // mov r10, rax
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0);
    self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);   // mov rax, -1
    self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC0);                      // mov r8, rax
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);                      // xor r9d, r9d
    self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00); // mov eax, SYS_mmap
    self.cg_e8(0x0F); self.cg_e8(0x05);                                        // syscall
    // #1947: erst pruefen, dann als Adresse benutzen. Ohne das schrieb das
    // folgende `mov [rax], rcx` bei fehlgeschlagener Anforderung nach
    // 0xFFFFFFFFFFFFFFF4 — ein Segfault statt einer Meldung. Dies ist die
    // Stelle, die schon beim ERSTEN Anlegen greift; deshalb scheiterte
    // tests/kurzsprung_test.sh auf knappem Adressraum auch ohne jedes Local.
    self.cg_emitMmapGeprueft();
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC1);
    self.cg_e8(0x00); self.cg_e8(0x04); self.cg_e8(0x00); self.cg_e8(0x00);   // mov rcx, 1024
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x08);                      // mov [rax], rcx   (cap)
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC9);                      // xor rcx, rcx
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x48); self.cg_e8(0x08);   // mov [rax+8], rcx (len)
  }

  // #2078: Den Array-Zeiger fuer push/pop nach rcx laden bzw. rax dorthin
  // zurueckschreiben — lokal ODER global. Bis 1.2.13C kannten push und pop
  // nur Locals: fuer eine Modulvariable lieferte cg_findLocal 0, gelesen und
  // beschrieben wurde [rbp+0] — der gesicherte Rahmenzeiger des Aufrufers.
  // In main verpuffte push still (len blieb 0), aus einer Hilfsfunktion
  // stuerzte das Programm ab, und `array<F>` sprang nach Adresse 0.
  // Jede andere Form (Feld, Ausdruck) wird abgewiesen, statt in einen fremden
  // Rahmen zu schreiben.
  fn cg_arrZielPruefen(objNode: int64) {
    if (self.cg_nkind(objNode) == CGN_IDENT) {
      if (self.cg_findLocal(self.cg_nsval(objNode), self.cg_nslen(objNode)) != 0) { return; }
      var zg: int64 := self.cg_findGlobalIdx(self.cg_nsval(objNode), self.cg_nslen(objNode));
      if (zg >= 0) {
        // Ein globales `[N]T` oder ein Array mit Startwert liegt im
        // Datenbereich. Waechst es, gibt push den alten Block per munmap frei
        // — mitten aus dem Datenbereich des Programms. Abweisen statt
        // fremde Globale mitzureissen.
        if (peek8(self.globalIsArray + zg) == 2) {
          EPrintStr("error: codegen: push/pop auf ein Array fester Groesse auf Modulebene: '"c);
          sys_write(2, self.cg_nsval(objNode) as int64, self.cg_nslen(objNode));
          EPrintStrLn("' (#2078)"c);
          EPrintStrLn("  Fuer ein wachsendes Array `var g: array<T>;` ohne Startwert deklarieren."c);
          exit(1);
        }
        return;
      }
    }
    EPrintStrLn("error: codegen: push/pop braucht ein lokales oder globales dynamisches Array als ersten Operanden (#2078)"c);
    exit(1);
  }
  fn cg_arrPtrNachRcx(objNode: int64) {
    var an: pchar := self.cg_nsval(objNode);
    var al: int64 := self.cg_nslen(objNode);
    var off: int64 := self.cg_findLocal(an, al);
    // #2114: liegt das Local im Register, ist es dort zu lesen (mov rcx, r12+i)
    // — dasselbe wie das Laden aus dem Slot darunter.
    var rlA: int64 := self.cg_rlReg(off);
    if (rlA >= 0) { self.cg_e8(0x4C); self.cg_e8(0x89); self.cg_e8(0xE1 + (rlA << 3)); return; }
    if (off != 0) {
      if (off >= -128 && off <= 127) {
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x4D); self.cg_e8(off);
      } else {
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x8D); self.cg_e32(off);
      }
      return;
    }
    self.cg_emitGlobalRead(an, al, self.cg_findGlobal(an, al));   // rax = Zeiger
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);        // mov rcx, rax
  }
  fn cg_arrPtrAusRax(objNode: int64) {
    var an: pchar := self.cg_nsval(objNode);
    var al: int64 := self.cg_nslen(objNode);
    var off: int64 := self.cg_findLocal(an, al);
    if (off != 0) { self.cg_storeRax(off); return; }
    self.cg_emitGlobalWrite(an, al, self.cg_findGlobal(an, al));
  }

  // #2078: Ist dieser Typknoten ein DYNAMISCHES Array? Dieselbe Erkennung wie
  // in cg_markArrayParam (61 = `T[]`, 60 mit Namen Array/array) — die beiden
  // muessen uebereinstimmen.
  fn cg_typIstDynArray(t: int64): int64 {
    if (t < 0) { return 0; }
    if (self.cg_nkind(t) == 61) { return 1; }
    if (self.cg_nkind(t) == 60) {
      var tn: pchar := self.cg_nsval(t);
      var tl: int64 := self.cg_nslen(t);
      if (self.cg_seq(tn, tl, "Array", 5) || self.cg_seq(tn, tl, "array", 5)) { return 1; }
    }
    return 0;
  }

  fn cg_genArrayPush(objNode: int64, valNode: int64) {
    self.cg_arrZielPruefen(objNode);   // #2078
    // Evaluate value → rax
    self.cg_genExpr(valNode);
    // push rax (save value)
    self.cg_e8(0x50);
    // rcx = Array-Zeiger (lokal oder global, #2078)
    self.cg_arrPtrNachRcx(objNode);
    // test rcx, rcx
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC9);
    // jnz skip_alloc (rel32 placeholder)
    self.cg_e8(0x0F); self.cg_e8(0x85);
    var jnzPos: int64 := self.codeLen;
    self.cg_e32(0);
    // ---- #1177: dieselbe Folge wie bei der Deklaration ----
    self.cg_emitEmptyDynArray();
    // store rax back to the variable (lokal oder global, #2078)
    self.cg_arrPtrAusRax(objNode);
    // mov rcx, rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);
    // ---- end mmap block ----
    // Patch jnz to here (skip_alloc)
    poke32(self.code + jnzPos, self.codeLen - jnzPos - 4);
    // pop rax               (restore value)
    self.cg_e8(0x58);

    // ---- GROW CHECK ----
    // push rax (save value while we inspect cap/len)
    self.cg_e8(0x50);
    // mov rax, [rcx]        (rax = cap)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x01);
    // mov rdx, [rcx+8]      (rdx = len)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x51); self.cg_e8(0x08);
    // cmp rdx, rax          (len vs cap)
    self.cg_e8(0x48); self.cg_e8(0x39); self.cg_e8(0xC2);
    // jl .no_grow
    //
    // #1915: Hier stand ein KURZSPRUNG. Der Wachstumspfad darunter ist rund
    // 127 Byte lang — plus `cg_storeRax`, das drei Byte mehr braucht, sobald
    // der Rahmenversatz des Arrays jenseits von rbp-128 liegt. Ab der
    // sechzehnten vorangehenden lokalen Variablen kippte die Distanz damit
    // auf 130, `poke8` schnitt sie auf ein Byte, und die CPU las -126: der
    // Sprung ging RUECKWAERTS in den Pfad, den er ueberspringen sollte.
    //
    // Nachgemessen am Erzeugnis: 14 Locals davor -> rel8 = 127 (die Grenze
    // exakt ausgereizt), 16 Locals -> 130 = -126 und Speicherzugriffsfehler.
    // Ein langer Sprung kostet drei Byte und nimmt der Stelle die Grenze.
    self.cg_e8(0x0F); self.cg_e8(0x8C); var jlNoGrow: int64 := self.codeLen; self.cg_e32(0);

    // ---- GROW PATH ---- stack entering: [rsp+0]=value
    // push rcx  (save old_ptr)
    self.cg_e8(0x51);
    // shl rax, 1  (new_cap = cap * 2)
    self.cg_e8(0x48); self.cg_e8(0xD1); self.cg_e8(0xE0);
    // push rax  (save new_cap) — stack: [rsp+0]=new_cap [rsp+8]=old_ptr [rsp+16]=value
    self.cg_e8(0x50);
    // alloc(new_cap*8+16)
    // imul rsi, rax, 8
    self.cg_e8(0x48); self.cg_e8(0x6B); self.cg_e8(0xF0); self.cg_e8(0x08);
    // add rsi, 16
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC6); self.cg_e8(0x10);
    // xor edi, edi
    self.cg_e8(0x31); self.cg_e8(0xFF);
    // mov edx, 3
    self.cg_e8(0xBA); self.cg_e8(0x03); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov eax, 34  (MAP_ANON|MAP_PRIVATE)
    self.cg_e8(0xB8); self.cg_e8(0x22); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // mov r10, rax
    self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC2);
    // mov rax, -1  (fd = -1, sign-extended imm32)
    self.cg_e8(0x48); self.cg_e8(0xC7); self.cg_e8(0xC0);
    self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF); self.cg_e8(0xFF);
    // mov r8, rax
    self.cg_e8(0x49); self.cg_e8(0x89); self.cg_e8(0xC0);
    // xor r9d, r9d
    self.cg_e8(0x45); self.cg_e8(0x31); self.cg_e8(0xC9);
    // mov eax, 9
    self.cg_e8(0xB8); self.cg_e8(0x09); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall  → rax=new_ptr (rcx, r11 trashed by syscall)
    self.cg_e8(0x0F); self.cg_e8(0x05);
    // #1947: dieselbe Pruefung wie in cg_emitEmptyDynArray — die beiden
    // muessen uebereinstimmen. Ohne sie lief `-ENOMEM` als Zeiger in das
    // `rep movsb` weiter, das gleich darunter kopiert.
    self.cg_emitMmapGeprueft();
    // push rax (save new_ptr) — stack: [rsp+0]=new_ptr [rsp+8]=new_cap [rsp+16]=old_ptr [rsp+24]=value
    self.cg_e8(0x50);

    // rep movsb: copy data from old+16 to new+16
    // mov r11, [rsp+16]  (r11 = old_ptr)
    self.cg_e8(0x4C); self.cg_e8(0x8B); self.cg_e8(0x5C); self.cg_e8(0x24); self.cg_e8(0x10);
    // lea rdi, [rax+16]  (dst = new+16)
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x78); self.cg_e8(0x10);
    // lea rsi, [r11+16]  (src = old+16)
    self.cg_e8(0x49); self.cg_e8(0x8D); self.cg_e8(0x73); self.cg_e8(0x10);
    // mov rcx, [r11+8]   (rcx = len)
    self.cg_e8(0x49); self.cg_e8(0x8B); self.cg_e8(0x4B); self.cg_e8(0x08);
    // imul rcx, rcx, 8   (count in bytes = len * 8)
    self.cg_e8(0x48); self.cg_e8(0x6B); self.cg_e8(0xC9); self.cg_e8(0x08);
    // cld; rep movsb  (rcx, rdi, rsi trashed after)
    self.cg_e8(0xFC); self.cg_e8(0xF3); self.cg_e8(0xA4);

    // pop rax  (new_ptr)
    self.cg_e8(0x58);
    // pop rdx  (new_cap) — stack: [rsp+0]=old_ptr [rsp+8]=value
    self.cg_e8(0x5A);
    // mov [rax], rdx     ([new+0] = new_cap)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x10);
    // mov rcx, [rsp]     (rcx = old_ptr)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x0C); self.cg_e8(0x24);
    // mov rdx, [rcx+8]   (rdx = len)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x51); self.cg_e8(0x08);
    // mov [rax+8], rdx   ([new+8] = len)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x50); self.cg_e8(0x08);

    // free(old_ptr, old_cap*8+16)
    // push rax  (save new_ptr) — stack: [rsp+0]=new_ptr [rsp+8]=old_ptr [rsp+16]=value
    self.cg_e8(0x50);
    // mov rdi, rcx       (rdi = old_ptr)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xCF);
    //
    // #2050: Die Laenge gehoert in RSI. munmap(addr, len) nimmt seine beiden
    // Argumente in rdi und rsi; hier stand sie in RDX, dem dritten Register,
    // das munmap gar nicht liest. In rsi stand stattdessen, was `rep movsb`
    // weiter oben hinterlassen hatte: der Zeiger hinter das letzte kopierte
    // Element — eine ADRESSE als Laenge, rund 130 TB.
    //
    // Was daraus wurde, hing an der Adresslage des Prozesses:
    //   * gewoehnlich (Zuteilung von oben, Adressen um 0x7f...): Adresse plus
    //     Laenge ueberschreitet den Adressraum, munmap antwortet EINVAL und
    //     tut nichts. Kein Absturz — aber auch keine Freigabe: jeder alte
    //     Block blieb stehen, ein wachsendes Array hielt das Doppelte.
    //   * im Legacy-Layout (Zuteilung von unten, Adressen um 0x2a... bis
    //     0x3f...; der Kernel nimmt es bei `ulimit -s unlimited`): die Summe
    //     passt, munmap GELINGT und gibt alles oberhalb des alten Blocks
    //     frei — darunter den neuen, eben befuellten. Der naechste Zugriff
    //     auf das Array ist ein SIGSEGV.
    //
    // Der zweite Fall war der "nicht deterministische" Absturz auf dem
    // CI-Runner: gleicher Commit, gleiches Kompilat, mal rot, mal gruen.
    //
    // mov rsi, [rcx]     (rsi = old_cap)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x31);
    // imul rsi, rsi, 8
    self.cg_e8(0x48); self.cg_e8(0x6B); self.cg_e8(0xF6); self.cg_e8(0x08);
    // add rsi, 16
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC6); self.cg_e8(0x10);
    // mov eax, 11  (SYS_munmap)
    self.cg_e8(0xB8); self.cg_e8(0x0B); self.cg_e8(0x00); self.cg_e8(0x00); self.cg_e8(0x00);
    // syscall  (rax=0 on success; rcx, r11 trashed)
    self.cg_e8(0x0F); self.cg_e8(0x05);

    // pop rcx  (rcx = new_ptr) — stack: [rsp+0]=old_ptr [rsp+8]=value
    self.cg_e8(0x59);
    // store new_ptr to the variable: mov rax,rcx → (lokal/global, #2078) → mov rcx,rax
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC8);
    self.cg_arrPtrAusRax(objNode);
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC1);
    // add rsp, 8  (discard old_ptr) — stack: [rsp+0]=value
    self.cg_e8(0x48); self.cg_e8(0x83); self.cg_e8(0xC4); self.cg_e8(0x08);

    // Patch jl .no_grow to here
    poke32(self.code + jlNoGrow, self.codeLen - jlNoGrow - 4);

    // ---- APPEND (both paths join here) ----
    // Stack: [rsp+0]=value, rcx=array_ptr
    // pop rax               (restore value)
    self.cg_e8(0x58);
    // mov rdx, [rcx+8]      (len — reload; may have changed after grow)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x51); self.cg_e8(0x08);
    // lea rsi, [rcx+16]     (rsi = data start)
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x71); self.cg_e8(0x10);
    // mov [rsi+rdx*8], rax  (data[len] = value)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x04); self.cg_e8(0xD6);
    // inc rdx
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC2);
    // mov [rcx+8], rdx      ([ptr+8] = len+1)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x51); self.cg_e8(0x08);
    // xor rax, rax          (return 0)
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
  }

  // Inline code for arr.pop(): decrement len, return last element (0 if empty)
  fn cg_genArrayPop(objNode: int64) {
    self.cg_arrZielPruefen(objNode);   // #2078
    // Load array ptr into rcx (lokal oder global, #2078)
    self.cg_arrPtrNachRcx(objNode);
    // test rcx, rcx; jz empty
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC9);
    self.cg_e8(0x0F); self.cg_e8(0x84);
    var jz1Pos: int64 := self.codeLen;
    self.cg_e32(0);
    // rdx = [rcx+8]  (len)
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x51); self.cg_e8(0x08);
    // test rdx, rdx; jz empty
    self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xD2);
    self.cg_e8(0x0F); self.cg_e8(0x84);
    var jz2Pos: int64 := self.codeLen;
    self.cg_e32(0);
    // dec rdx
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCA);
    // [rcx+8] = rdx  (new len)
    self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0x51); self.cg_e8(0x08);
    // lea rsi, [rcx+16]
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x71); self.cg_e8(0x10);
    // rax = [rsi+rdx*8]
    self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x04); self.cg_e8(0xD6);
    // jmp done
    self.cg_e8(0xE9);
    var jmpPos: int64 := self.codeLen;
    self.cg_e32(0);
    // empty: patch jz targets here
    poke32(self.code + jz1Pos, self.codeLen - jz1Pos - 4);
    poke32(self.code + jz2Pos, self.codeLen - jz2Pos - 4);
    // xor rax, rax
    self.cg_e8(0x48); self.cg_e8(0x31); self.cg_e8(0xC0);
    // done:
    poke32(self.code + jmpPos, self.codeLen - jmpPos - 4);
  }

  // Generate a field load: evaluates object into rax, then loads field
  fn cg_genFieldLoad(ni: int64) {
    var obj: int64 := self.cg_nc0(ni);
    var fieldName: pchar := self.cg_nsval(ni);
    var fieldLen:  int64 := self.cg_nslen(ni);
    self.cg_genExpr(obj);
    // #1092: Safe-Access `a?.v` (iv-Bit 0). Ist der Empfaenger null, wird das
    // Feld NICHT gelesen und das Ergebnis ist null. Der Empfaenger wird dabei
    // genau EINMAL ausgewertet -- eine Pruefung um den ganzen Aufruf herum
    // haette ihn zweimal berechnet, samt Seiteneffekten bei `f()?.v`.
    //
    // Die Sonderfaelle darunter (Array-.length, Enum-Mitglied, Typname.Feld)
    // haben keinen Empfaenger, der null sein koennte; fuer sie ist die
    // Markierung bedeutungslos und der Sprung wird sofort geschlossen.
    var safeJz: int64 := 0 - 1;
    if ((self.cg_nival(ni) & 1) != 0) {
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
      self.cg_e8(0x0F); self.cg_e8(0x84);                       // jz ueber den Zugriff
      safeJz := self.codeLen;
      self.cg_e32(0);
    }
    // Array .length / .data field accessors
    if (self.cg_identIsArray(obj) != 0) {
      var lenStr:  pchar := "length";
      var dataStr: pchar := "data";
      if (self.cg_seq(fieldName, fieldLen, lenStr, 6)) {
        // mov rax, [rax+8]   (load len field)
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40); self.cg_e8(0x08);
      // #1154: `len` und `cap` sind die Namen, unter denen die Dokumentation
      // den Fat-Pointer beschreibt. Sie lieferten still 0 — jetzt lesen sie
      // die Felder, die es wirklich gibt: [ptr+8] Laenge, [ptr+0] Kapazitaet.
      } else if (self.cg_seq(fieldName, fieldLen, "len"c, 3)) {
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40); self.cg_e8(0x08); // mov rax,[rax+8]
      } else if (self.cg_seq(fieldName, fieldLen, "cap"c, 3)) {
        self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x00);                   // mov rax,[rax]
      } else if (self.cg_seq(fieldName, fieldLen, dataStr, 4)) {
        // lea rax, [rax+16]  (pointer to first element, past {cap,len} header)
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x40); self.cg_e8(0x10);
      } else {
        // Unbekannter Name an einem Array: sema meldet ihn (#1154). Kommt er
        // hier trotzdem an (importiert, nicht entscheidbar), bleibt es beim
        // alten Verhalten.
        self.cg_zeroRax();
      }
      if (safeJz >= 0) { poke32(self.code + safeJz, self.codeLen - safeJz - 4); }
      return;
    }
    // Enum member access: EnumType.Variant → emit tag value as immediate
    if (self.cg_nkind(obj) == CGN_IDENT) {
      var ename: pchar := self.cg_nsval(obj);
      var elen:  int64 := self.cg_nslen(obj);
      var enumIdx: int64 := self.cg_findEnum(ename, elen);
      if (enumIdx >= 0) {
        var tagInfo: int64 := self.cg_findEnumVariant(enumIdx, fieldName, fieldLen);
        if (tagInfo >= 0) {
          self.cg_movRaxImm(tagInfo);
        } else {
          self.cg_zeroRax();
        }
        if (safeJz >= 0) { poke32(self.code + safeJz, self.codeLen - safeJz - 4); }
      return;
      }
      // TypeName.field — emit field byte offset as compile-time constant
      var classIdx0: int64 := self.cg_findClass(ename, elen);
      if (classIdx0 >= 0) {
        var foff0: int64 := self.cg_getFieldOffset(classIdx0, fieldName, fieldLen);
        if (foff0 >= 0) {
          self.cg_movRaxImm(foff0);
        } else {
          self.cg_zeroRax();
        }
        if (safeJz >= 0) { poke32(self.code + safeJz, self.codeLen - safeJz - 4); }
      return;
      }
    }
    var classIdx: int64 := self.cg_objClassIdx(obj);
    var foff: int64 := -1;
    if (classIdx >= 0) { foff := self.cg_getFieldOffset(classIdx, fieldName, fieldLen); }
    // #1038: Breite des Feldes. Bisher wurde IMMER mit 8 Byte geladen — in einem
    // @packed-Struct liegen die Nachbarfelder aber unmittelbar dahinter und kamen
    // damit im Ergebnis mit hoch: `magic` (uint8) auf Offset 0 lieferte alle acht
    // Bytes der Struktur. Beim SCHREIBEN wurde die Breite laengst beachtet, nur
    // beim Lesen nicht.
    var fFlags: int64 := 0;
    if (foff >= 0 && classIdx >= 0) {
      fFlags := self.cg_getFieldBigEndian(classIdx, fieldName, fieldLen);
    }
    var ldW: int64 := (fFlags >> 8) & 0xFF;
    var ldSigned: int64 := (fFlags >> 2) & 1;
    // #1513: Ein Feld, das selbst ein Struct ist, liegt INLINE. Sein "Wert" ist
    // die Adresse seiner Felder, nicht der Inhalt der ersten acht Byte —
    // `a.innen.wert` las bis hierher den Wert von `wert` und benutzte ihn als
    // Adresse. Deshalb `lea` statt `mov`; der Zugriff dahinter rechnet den
    // inneren Offset einfach darauf.
    var istInline: int64 := (fFlags >> 4) & 1;
    if (foff >= 0 && istInline != 0) {
      if (foff == 0) {
        // Adresse unveraendert — rax zeigt schon auf das Feld.
      } else if (foff <= 127) {
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x40); self.cg_e8(foff);   // lea rax,[rax+off]
      } else {
        self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x80); self.cg_e32(foff);
      }
      if (safeJz >= 0) { poke32(self.code + safeJz, self.codeLen - safeJz - 4); }
      return;
    }
    if (foff < 0) {
      self.cg_genFeldOffen(fieldName, fieldLen, ni);   // #2134, #2141
      self.cg_zeroRax();
    } else if (ldW == 1 || ldW == 2 || ldW == 4) {
      self.cg_emitNarrowLoadRax(foff, ldW, ldSigned);
      // #2160: f32-Feld -> double im Register (Gegenstueck zum Schreiben).
      if (ldW == 4 && self.cg_feldIstF32(classIdx, fieldName, fieldLen) != 0) {
        self.cg_e8(0x66); self.cg_e8(0x0F); self.cg_e8(0x6E); self.cg_e8(0xC0);                     // movd xmm0, eax
        self.cg_e8(0xF3); self.cg_e8(0x0F); self.cg_e8(0x5A); self.cg_e8(0xC0);                     // cvtss2sd xmm0, xmm0
        self.cg_e8(0x66); self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0x7E); self.cg_e8(0xC0);   // movq rax, xmm0
      }
    } else if (foff == 0) {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x00);
    } else if (foff <= 127) {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40); self.cg_e8(foff);
    } else {
      self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80); self.cg_e32(foff);
    }
    // WP-4.1-B: emit BSWAP after load for @big_endian fields
    if (foff >= 0 && classIdx >= 0) {
      if ((fFlags & 1) != 0) {
        var tWidth: int64 := (fFlags >> 8) & 0xFF;
        self.cg_emitBswapRax(tWidth);
      }
    }
    // #1092: Ziel der Nullpruefung -- rax traegt dann bereits null.
    if (safeJz >= 0) { poke32(self.code + safeJz, self.codeLen - safeJz - 4); }
  }

  // #1038: schmales Feld aus [rax+off] nach rax laden.
  // width 1/2: movzx bzw. movsx nach rax; width 4: mov eax (nullt die oberen
  // 32 Bit implizit) bzw. movsxd. Vorzeichenbehaftet sind int8/i8/int16/i16/
  // int32/i32 — bei uintN/uN wird genullt.
  fn cg_emitNarrowLoadRax(off: int64, width: int64, isSigned: int64) {
    if (width == 1) {
      if (isSigned != 0) { self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBE); }  // movsx rax, byte
      else               { self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB6); }  // movzx rax, byte
    } else if (width == 2) {
      if (isSigned != 0) { self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xBF); }  // movsx rax, word
      else               { self.cg_e8(0x48); self.cg_e8(0x0F); self.cg_e8(0xB7); }  // movzx rax, word
    } else {
      if (isSigned != 0) { self.cg_e8(0x48); self.cg_e8(0x63); }                    // movsxd rax, dword
      else               { self.cg_e8(0x8B); }                                      // mov eax, dword
    }
    if (off == 0) {
      self.cg_e8(0x00);
    } else if (off <= 127) {
      self.cg_e8(0x40); self.cg_e8(off);
    } else {
      self.cg_e8(0x80); self.cg_e32(off);
    }
  }

  // #1248: schmales Feld aus rsi nach [rax+off] schreiben — das Gegenstueck zu
  // cg_emitNarrowLoadRax.
  //
  // Der Schreibzugriff emittierte bisher IMMER `mov [rax+off], rsi` mit REX.W,
  // also volle 8 Byte, unabhaengig von der deklarierten Feldbreite. In einem
  // packed struct liegen die Nachbarfelder unmittelbar dahinter und wurden
  // dabei mitgenullt: `s.a := 20` bei `packed { a: int16; b: int8; }` loeschte
  // `b`. Ohne `packed` verdeckte das Ausrichtungs-Padding den Fehler, weil
  // jedes Feld ohnehin 8 Byte belegt.
  //
  // Der LESEpfad verschmaelert seit #1038 bei Breite 1/2/4 — fuer gepackte wie
  // ungepackte Strukturen. Der Kommentar dort sagt, beim Schreiben werde die
  // Breite "laengst beachtet"; das war die Annahme, die hier fehlte. Jetzt sind
  // beide Seiten symmetrisch.
  fn cg_emitNarrowStoreRsi(off: int64, width: int64) {
    if (width == 1) {
      self.cg_e8(0x40); self.cg_e8(0x88);            // mov [..], sil (REX fuer sil noetig)
    } else if (width == 2) {
      self.cg_e8(0x66); self.cg_e8(0x89);            // mov [..], si
    } else {
      self.cg_e8(0x89);                              // mov [..], esi
    }
    if (off == 0) {
      self.cg_e8(0x30);
    } else if (off <= 127) {
      self.cg_e8(0x70); self.cg_e8(off);
    } else {
      self.cg_e8(0xB0); self.cg_e32(off);
    }
  }

  // Generate a method declaration (with implicit self as first param)
  // #1643: Rumpf fuer eine ABSTRAKTE Methode.
  //
  // Bisher wurde sie uebersprungen — kein Code, kein Label, und ihr VMT-Slot
  // blieb 0. Der Aufruf sprang damit nach Adresse 0: ein Segfault, der weder
  // die Klasse noch die Methode nennt. Wer eine Basisklasse erweitert und eine
  // Methode zu ueberschreiben vergisst, stand vor einem Absturz ohne Hinweis.
  //
  // Der Slot bekommt jetzt einen Rumpf, der genau das sagt und definiert
  // abbricht — dieselbe Bauart wie die lauten Defaults aus #1339.
  fn cg_genAbstractStub(ni: int64, className: pchar, classNameLen: int64) {
    var mname: pchar := self.cg_nsval(ni);
    var mlen:  int64 := self.cg_nslen(ni);
    var methodCodeStart: int64 := self.codeLen;

    // Label unter dem gemangelten Namen, damit auch der DIREKTE Aufruf hier
    // landet und nicht auf ein fehlendes Symbol laeuft.
    var mangLen: int64 := classNameLen + 1 + mlen;
    var mangBuf: int64 := alloc(mangLen + 1);
    var ii: int64 := 0;
    while (ii < classNameLen) { poke8(mangBuf + ii, StrCharAt(className, ii)); ii := ii + 1; }
    StrSetChar(mangBuf as pchar, classNameLen, 95);
    var jj: int64 := 0;
    while (jj < mlen) { poke8(mangBuf + classNameLen + 1 + jj, StrCharAt(mname, jj)); jj := jj + 1; }
    poke8(mangBuf + mangLen, 0);
    self.cg_addLabel(mangBuf as pchar, mangLen, self.cg_lineOf(ni));
    self.cg_trackTempBuf(mangBuf, mangLen + 1);

    // Meldung: "lyxc: abstrakte Methode Klasse.Methode ohne Implementierung
    // aufgerufen\n" — mit den Namen, sonst waere der Abbruch so wortkarg wie
    // der Segfault davor.
    var msgOff: int64 := self.dataLen;
    var vorspann: pchar := "lyxc: abstrakte Methode "c;
    var vI: int64 := 0;
    while (vI < 24) { self.cg_edata(StrCharAt(vorspann, vI)); vI := vI + 1; }
    var cI: int64 := 0;
    while (cI < classNameLen) { self.cg_edata(StrCharAt(className, cI)); cI := cI + 1; }
    self.cg_edata(46);                                    // '.'
    var mI: int64 := 0;
    while (mI < mlen) { self.cg_edata(StrCharAt(mname, mI)); mI := mI + 1; }
    var nachspann: pchar := " ohne Implementierung aufgerufen"c;
    var nI: int64 := 0;
    while (nI < 32) { self.cg_edata(StrCharAt(nachspann, nI)); nI := nI + 1; }
    self.cg_edata(10); self.cg_edata(0);                  // "\n\0"

    self.cg_emitLeaRdiData(msgOff);
    self.cg_emitPanicBody();

    // Der VMT-Slot zeigt jetzt auf diesen Rumpf statt auf 0.
    var classIdx: int64 := self.cg_findClass(className, classNameLen);
    if (classIdx >= 0) {
      var slotCount: int64   := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTSLOTS);
      var methodList2: int64 := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTLIST);
      var vmtDataOff2: int64 := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTOFF);
      var si: int64 := 0;
      while (si < slotCount) {
        var sName: pchar := peek64(methodList2 + si * 16) as pchar;
        var sLen:  int64 := peek64(methodList2 + si * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN);
        if (self.cg_seq(sName, sLen, mname, mlen) != 0) {
          self.cg_addVmtMethodPatch(vmtDataOff2 + si * 8, methodCodeStart);
          si := slotCount;
        } else {
          si := si + 1;
        }
      }
    }
  }

  // #2014: Namen ohne Code merken (aus einer .lyu, Deklarationsmodus).
  fn cg_lyuNameMerke(p: int64, l: int64) {
    if (self.cgLyuNamenN >= self.cgLyuNamenCap) {
      var nc: int64 := self.cgLyuNamenCap * 2;
      if (nc < 32) { nc := 32; }
      var nb: int64 := alloc(nc * 16);
      if (self.cgLyuNamenN > 0) { memcpy(nb, self.cgLyuNamen, self.cgLyuNamenN * 16); }
      self.cgLyuNamen := nb;
      self.cgLyuNamenCap := nc;
    }
    poke64(self.cgLyuNamen + self.cgLyuNamenN * 16, p);
    poke64(self.cgLyuNamen + self.cgLyuNamenN * 16 + 8, l);
    self.cgLyuNamenN := self.cgLyuNamenN + 1;
  }
  // Methode unter dem Namen, unter dem ein Aufruf sie sucht ("Klasse_Methode").
  fn cg_lyuMethodeMerke(cp: pchar, cl: int64, mp: pchar, ml: int64) {
    var b: int64 := alloc(cl + 1 + ml + 1);
    memcpy(b, cp as int64, cl);
    poke8(b + cl, 95);
    memcpy(b + cl + 1, mp as int64, ml);
    poke8(b + cl + 1 + ml, 0);
    self.cg_lyuNameMerke(b, cl + 1 + ml);
  }
  fn cg_lyuNameHat(p: int64, l: int64): int64 {
    var i: int64 := 0;
    while (i < self.cgLyuNamenN) {
      if (peek64(self.cgLyuNamen + i * 16 + 8) == l) {
        if (self.cg_seq(peek64(self.cgLyuNamen + i * 16) as pchar, l, p as pchar, l) != 0) { return 1; }
      }
      i := i + 1;
    }
    return 0;
  }

  // #2014: VMT-Rumpf einer virtuellen Methode, die nur als .lyu vorliegt.
  // Dieselbe Bauart wie cg_genAbstractStub (#1643) — eine definierte, benannte
  // Meldung statt eines Sprungs nach 0 —, aber OHNE Marke: ein direkter Aufruf
  // soll schon beim Uebersetzen scheitern, nicht erst zur Laufzeit.
  fn cg_genLyuStub(ni: int64, className: pchar, classNameLen: int64) {
    var mname: pchar := self.cg_nsval(ni);
    var mlen:  int64 := self.cg_nslen(ni);
    var methodCodeStart: int64 := self.codeLen;
    var msgOff: int64 := self.dataLen;
    var vorspann: pchar := "lyxc: Methode "c;
    var vl: int64 := StrLen(vorspann);
    var vI: int64 := 0;
    while (vI < vl) { self.cg_edata(StrCharAt(vorspann, vI)); vI := vI + 1; }
    var cI: int64 := 0;
    while (cI < classNameLen) { self.cg_edata(StrCharAt(className, cI)); cI := cI + 1; }
    self.cg_edata(46);
    var mI: int64 := 0;
    while (mI < mlen) { self.cg_edata(StrCharAt(mname, mI)); mI := mI + 1; }
    var nachspann: pchar := " liegt nur als .lyu vor, ihr Objektcode fehlt (#2014 Stufe 5)"c;
    var nl: int64 := StrLen(nachspann);
    var nI: int64 := 0;
    while (nI < nl) { self.cg_edata(StrCharAt(nachspann, nI)); nI := nI + 1; }
    self.cg_edata(10); self.cg_edata(0);
    self.cg_emitLeaRdiData(msgOff);
    self.cg_emitPanicBody();
    // VMT-Platz auf diesen Rumpf — dieselbe Suche wie in cg_genAbstractStub.
    var classIdx: int64 := self.cg_findClass(className, classNameLen);
    if (classIdx >= 0) {
      var slotCount: int64   := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTSLOTS);
      var methodList2: int64 := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTLIST);
      var vmtDataOff2: int64 := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTOFF);
      var si: int64 := 0;
      while (si < slotCount) {
        var sName: pchar := peek64(methodList2 + si * 16) as pchar;
        var sLen:  int64 := peek64(methodList2 + si * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN);
        if (self.cg_seq(sName, sLen, mname, mlen) != 0) {
          self.cg_addVmtMethodPatch(vmtDataOff2 + si * 8, methodCodeStart);
          si := slotCount;
        } else {
          si := si + 1;
        }
      }
    }
  }

  // #2014: Layouts einer .lyu gegen die eigenen Tabellen pruefen (nach
  // cg_genFile auf ihren Deklarationen). Die Datei nennt Groesse, Typwort und
  // Feld-Offsets des ERZEUGENDEN Backends; weichen sie ab, ist die .lyu fuer
  // ein anderes gebaut (der IR-Weg legt eine Klasse ohne VMT ab 0 an, x86 ab
  // 8) — gemeldet statt uebernommen, sonst fiele es erst am Programm auf.
  // Dieselbe Pruefung wie IRLower._irLyuPruefe; die beiden muessen
  // uebereinstimmen.
  fn cg_lyuPruefeLayout(r: LyuReader) {
    var nb: int64 := alloc(8); var nlb: int64 := alloc(8);
    var szb: int64 := alloc(8); var vmb: int64 := alloc(8); var nfb: int64 := alloc(8);
    var fnb: int64 := alloc(8); var fnlb: int64 := alloc(8);
    var fob: int64 := alloc(8); var fsb: int64 := alloc(8);
    var box: int64 := alloc(16);
    var n: int64 := r.LyrTypN();
    var i: int64 := 0;
    while (i < n) {
      if (r.LyrTypInfo(i, nb, nlb, szb, vmb, nfb)) {
        var np: pchar := peek64(nb) as pchar;
        var nl: int64 := peek64(nlb);
        var fehler: int64 := 0;
        if (self.CgLyuTyp(np, nl, box) == 0) { fehler := 1; }
        else {
          if (peek64(box) != peek64(szb) || peek64(box + 8) != peek64(vmb)) { fehler := 2; }
          var fi: int64 := 0;
          while (fi < peek64(nfb) && fehler == 0) {
            if (r.LyrTypFeld(i, fi, fnb, fnlb, fob, fsb)) {
              if (self.CgLyuFeld(np, nl, peek64(fnb) as pchar, peek64(fnlb), box) == 0) { fehler := 3; }
              else if (peek64(box) != peek64(fob) || peek64(box + 8) != peek64(fsb)) { fehler := 3; }
            }
            fi := fi + 1;
          }
        }
        if (fehler != 0) {
          EPrintStr("error: .lyu: Layout von '"c);
          sys_write(2, np as int64, nl);
          if (fehler == 1) { EPrintStrLn("' ist nach dem Lesen nicht bestimmbar"c); }
          else if (fehler == 2) {
            EPrintStr("' weicht ab: Datei Groesse "c); EPrintStr(IntToStr(peek64(szb)));
            EPrintStr(" Typwort "c); EPrintStr(IntToStr(peek64(vmb)));
            EPrintStr(", dieses Ziel Groesse "c); EPrintStr(IntToStr(peek64(box)));
            EPrintStr(" Typwort "c); EPrintStrLn(IntToStr(peek64(box + 8)));
          } else {
            EPrintStr("' weicht ab im Feld '"c);
            sys_write(2, peek64(fnb), peek64(fnlb));
            EPrintStr("': Datei Offset "c); EPrintStr(IntToStr(peek64(fob)));
            EPrintStr(", dieses Ziel "c); EPrintStrLn(IntToStr(peek64(box)));
          }
          EPrintStrLn("  Die .lyu wurde fuer ein Backend mit anderem Layout gebaut — fuer dieses Ziel"c);
          EPrintStrLn("  neu uebersetzen: lyxc --compile-unit --target=<ziel> (#2014)."c);
          exit(1);
        }
      }
      i := i + 1;
    }
  }

  fn cg_genMethodDecl(ni: int64, className: pchar, classNameLen: int64) {
    var mname: pchar := self.cg_nsval(ni);
    var mlen:  int64 := self.cg_nslen(ni);
    self.genCurFd := 0 - 1;   // #2134: Methode, kein generischer Rumpf
    // WP-BC-19: record code start for VMT method slot patching
    var methodCodeStart: int64 := self.codeLen;
    // Build mangled name: className_methodName
    var mangLen: int64 := classNameLen + 1 + mlen;
    var mangBuf: int64 := alloc(mangLen + 1);
    var ii: int64 := 0;
    while (ii < classNameLen) { poke8(mangBuf + ii, StrCharAt(className, ii)); ii := ii + 1; }
    StrSetChar(mangBuf as pchar, classNameLen, 95);
    var jj: int64 := 0;
    while (jj < mlen) { poke8(mangBuf + classNameLen + 1 + jj, StrCharAt(mname, jj)); jj := jj + 1; }
    poke8(mangBuf + mangLen, 0);
    // Register label with mangled name
    self.cg_addLabel(mangBuf as pchar, mangLen, self.cg_lineOf(ni));
    self.cg_cfi(CFI_FN, 0);   // #2135: wie cg_genFuncDecl
    self.cfiInFn := 1;
    // Track mangled name buffer for cleanup after patching (BUG-02)
    self.cg_trackTempBuf(mangBuf, mangLen + 1);
    // Reset locals
    self.localCount := 0;
    self.frameSize  := 0;
    // #1121: Tupel-Rueckgabetyp erkennen — genau wie cg_genFuncDecl es tut.
    // Eine Methode wird vom Parser als gewoehnlicher Funktionsknoten gebaut
    // (ParseFuncDecl), der Rueckgabetyp steht also ebenfalls in c1. Ohne diese
    // Zeilen blieb die Merkung stehen, die die zuletzt uebersetzte FUNKTION
    // hinterlassen hat: `return (3, 6)` legte dann nur rax an, rdx trug, was
    // zufaellig drin stand, und der Aufrufer las daraus seinen zweiten Wert.
    var mRetTy: int64 := self.cg_nc1(ni);
    self.funcHasTupleReturn := 0;
    if (mRetTy >= 0 && self.cg_nkind(mRetTy) == CGN_TYPE_TUPLE) {
      self.funcHasTupleReturn := 1;
    }
    // Set class context for self.field access
    self.curClassName    := className;
    self.curClassNameLen := classNameLen;
    // #1370: Methoden werden ebenso gemessen, unter ihrem verketteten Namen
    // (Klasse_Methode) — sonst faenden sich zwei gleichnamige Methoden
    // verschiedener Klassen in einem Eintrag wieder.
    self.profCurName := mangBuf as pchar;
    self.profCurLen  := mangLen;
    // Emit prologue
    self.rlSelfKnoten := ni;   // #2228: `self` ist Kandidat dieser Methode
    self.cg_rlWaehlen(ni);   // #2114
    // #2245: vor dem Prolog entscheiden — der Epilog liest dasselbe Feld.
    self.canaryAn := self.cg_funcBrauchtCanary(self.cg_nc2(ni));
    var prologuePatch: int64 := self.cg_emitPrologue();
    // #1140: @flight_crit an einer METHODE. Ohne diese Stelle gaelte die
    // Zusicherung fuer freie Funktionen und nicht fuer Methoden — sie haenge
    // also am Ort der Deklaration statt an der Annotation.
    var savedMFcActive: int64 := self.fcActive;
    var savedMFcMx:     int64 := self.fcMxSlot;
    var savedMFcName:   int64 := self.fcNameSlot;
    self.fcActive := 0;
    if ((self.cg_nival(ni) & ANNO_FLIGHTCRIT) != 0) {
      self.cg_fcArm(self.cg_nsval(ni), self.cg_nslen(ni));
      self.fcActive := 1;
    }
    // #1595: Gibt die Methode ein STRUCT by value zurueck, liegt in rdi die
    // Zieladresse des Aufrufers und `self` rueckt nach rsi; die echten
    // Parameter beginnen dann bei rdx. Ohne diese Behandlung zeigte der
    // Rueckgabewert in den Rahmen der Methode — der beim Zuruecksetzen faellt,
    // und dass der Aufrufer dort noch die richtigen Bytes vorfand, war Glueck
    // und keine Zusicherung.
    self.fnRetStructBytes := 0;
    self.fnRetSlotOff     := 0;
    var mRetTyN: int64 := self.cg_nc1(ni);
    self.fnRetIsFloat := 0;
    if (mRetTyN >= 0) {
      if (self.cg_isFloatTypeName(self.cg_nsval(mRetTyN), self.cg_nslen(mRetTyN)) != 0) {
        self.fnRetIsFloat := 1;
      }
    }
    if (mRetTyN >= 0 && self.cg_nkind(mRetTyN) == 60) {
      var mrci: int64 := self.cg_findClass(self.cg_nsval(mRetTyN), self.cg_nslen(mRetTyN));
      if (mrci >= 0 && self.cg_istWertStruct(mrci) != 0
          && self.cg_structSelbstEnthalten(mrci, 0) != 0) {
        var mrsz: int64 := self.cg_classStructSize(mrci);
        if (mrsz > 0) {
          self.fnRetStructBytes := mrsz;
          self.fnRetSlotOff := self.cg_reserveFrame(8);
          self.cg_spillRdi(self.fnRetSlotOff);
        }
      }
    }

    // Implicit self parameter at register 0 (rdi) — bei Struct-Rueckgabe rsi.
    var selfOff: int64 := self.cg_addLocal("self", 4);
    self.cg_rlBinde(ni, selfOff);   // #2228
    self.cg_setLocalType(self.localCount - 1, className, classNameLen);
    if (self.fnRetStructBytes > 0) { self.cg_spillRsi(selfOff); }
    else { self.cg_spillRdi(selfOff); }
    // Regular params start at register index 1
    var param: int64 := self.cg_nc0(ni);
    var paramIdx: int64 := 1;
    if (self.fnRetStructBytes > 0) { paramIdx := 2; }
    while (param != -1 && paramIdx < 6) {
      var pname: pchar := self.cg_nsval(param);
      var pnlen: int64 := self.cg_nslen(param);
      var poff: int64 := self.cg_addLocal(pname, pnlen);
      self.cg_rlBinde(param, poff);   // #2114
      // Track param type if it's a user type (NK_TYPE_NAME = 60)
      var ptypeNode: int64 := self.cg_nc0(param);
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == 60) {
        self.cg_setLocalType(self.localCount - 1, self.cg_nsval(ptypeNode), self.cg_nslen(ptypeNode));
        // #1291: auch ein PARAMETER kann eine Map mit Zeichenketten-Schluesseln
        // sein. Ohne diese Zeile las eine Funktion, die so eine Map bekommt,
        // mit dem Zahlenvergleich — und fand nichts, waehrend derselbe Zugriff
        // beim Aufrufer stimmte. Die Markierung gehoert an jede Stelle, an der
        // ein Local mit deklariertem Typ entsteht.
        self.cg_markMapStrKey(self.localCount - 1, ptypeNode);
      }
      self.cg_markArrayParam(self.localCount - 1, ptypeNode);   // #1115
      self.cg_markMapStrKey(self.localCount - 1, ptypeNode);            // #1291
      // #1003: inline geschriebener fn-Zeigertyp als Parameter
      if (ptypeNode >= 0 && self.cg_nkind(ptypeNode) == CGN_FN_PTR_NODE) {
        poke8(self.localIsFnPtr + self.localCount - 1, 1);
        // #1565: Rueckgabetyp mitfuehren — sonst gilt `f(x)` als Ganzzahl.
        // #1622: hier stand `ptypeNode` — den Namen gibt es nicht. Der
        // Rumpf einer Methode wurde nie geprueft, der Bezeichner wurde still
        // zu 0, und diese der vier Stellen aus #1565 war damit tot.
        if (self.cg_fnPtrRetIstF64(ptypeNode) != 0) {
          poke8(self.localFnPtrF64 + self.localCount - 1, 1);
        }
        poke8(self.localFnRetSatz + self.localCount - 1, self.cg_fnPtrRetTiefe(ptypeNode));   // #2143
      }
      if (paramIdx == 1) { self.cg_spillRsi(poff); }
      else if (paramIdx == 2) { self.cg_spillRdx(poff); }
      else if (paramIdx == 3) { self.cg_spillRcx(poff); }
      else if (paramIdx == 4) { self.cg_spillR8(poff); }
      else if (paramIdx == 5) { self.cg_spillR9(poff); }
      paramIdx += 1;
      param := self.cg_nnext(param);
    }
    // L-4: stack params at [rbp+16], [rbp+24], ... (method explicit params 5+ on stack)
    var mspOff: int64 := 16;
    while (param != -1) {
      var mspName: pchar := self.cg_nsval(param);
      var mspNlen: int64 := self.cg_nslen(param);
      var mspLocal: int64 := self.cg_addLocal(mspName, mspNlen);
      self.cg_rlBinde(param, mspLocal);   // #2114
      var mspType: int64 := self.cg_nc0(param);
      if (mspType >= 0 && self.cg_nkind(mspType) == 60) {
        self.cg_setLocalType(self.localCount - 1, self.cg_nsval(mspType), self.cg_nslen(mspType));
      }
      self.cg_markArrayParam(self.localCount - 1, mspType);     // #1115
      self.cg_markMapStrKey(self.localCount - 1, mspType);            // #1291
      self.cg_loadRax(mspOff);
      self.cg_storeRax(mspLocal);
      mspOff += 8;
      param := self.cg_nnext(param);
    }
    // #1097: Bereichstyp an Methoden-Parametern und -Rueckgabe. Ohne diese
    // Stelle gaelte die Zusicherung fuer freie Funktionen und nicht fuer
    // Methoden -- eine Zusicherung, die vom Ort der Deklaration abhaengt.
    var mrgP: int64 := self.cg_nc0(ni);
    while (mrgP != -1) {
      var mrgIdx: int64 := self.cg_rangeOfTypeNode(self.cg_nc0(mrgP));
      if (mrgIdx >= 0) {
        self.cg_loadLocalByName(self.cg_nsval(mrgP), self.cg_nslen(mrgP));
        self.cg_emitRangeCheck(mrgIdx, "Parameter"c);
      }
      // #1151: schmaler Parametertyp an einer Methode.
      self.cg_narrowLocalSlot(self.cg_findLocal(self.cg_nsval(mrgP), self.cg_nslen(mrgP)),
                              self.cg_nc0(mrgP));
      mrgP := self.cg_nnext(mrgP);
    }
    var savedMRetRange: int64 := self.curFnRetRange;
    self.curFnRetRange := self.cg_rangeOfTypeNode(self.cg_nc1(ni));
    var savedMRetNarrow: int64 := self.curFnRetNarrow;          // #1151
    self.curFnRetNarrow := self.cg_narrowKindOfTypeNode(self.cg_nc1(ni));
    var savedMRetFnWert: int64 := self.curFnRetFnWert;          // #2133
    self.curFnRetFnWert := self.cg_typIstFnWert(self.cg_nc1(ni));
    // #1878: Lockstep an einer METHODE. Zweite Stelle derselben Aufzaehlung —
    // die freie Funktion steht in cg_genFuncDecl, die beiden muessen
    // uebereinstimmen.
    var savedMLs:     int64 := self.lockstepActive;
    var savedMLsName: pchar := self.lockstepName;
    var savedMLsLen:  int64 := self.lockstepNameLen;
    self.lockstepActive := 0;
    if (self.cg_integrityMode(ni) == INTEGRITY_LOCKSTEP) {
      self.lockstepActive  := 1;
      self.lockstepName    := self.cg_nsval(ni);
      self.lockstepNameLen := self.cg_nslen(ni);
    }
    // Generate body
    var body: int64 := self.cg_nc2(ni);
    self.cg_genBlock(body);
    self.lockstepActive  := savedMLs;
    self.lockstepName    := savedMLsName;
    self.lockstepNameLen := savedMLsLen;
    self.curFnRetRange := savedMRetRange;
    self.curFnRetNarrow := savedMRetNarrow;                     // #1151
    self.curFnRetFnWert := savedMRetFnWert;                     // #2133
    // Implicit return
    self.cg_zeroRax();
    self.cg_emitEpilogue();
    // Patch frame size
    var fs: int64 := self.frameSize + 15;
    var aligned: int64 := fs - (fs & 15);
    if (aligned == 0) { aligned := 16; }
    poke32(self.code + prologuePatch, aligned);
    self.rlAnz := 0;   // #2114
    self.fcActive   := savedMFcActive;   // #1140
    self.fcMxSlot   := savedMFcMx;
    self.fcNameSlot := savedMFcName;
    // Clear class context
    self.curClassName    := 0 as pchar;
    self.curClassNameLen := 0;
    // WP-BC-19: register VMT method slot patch for virtual methods.
    // #1133: ebenso fuer eine Methode, die einen Interface-Selektor erfuellt.
    // Sie traegt kein `virtual` — die Zusage steckt im `implements` der Klasse,
    // und ihr Slot existiert bereits. Ohne den Eintrag bliebe er 0 und der
    // Aufruf ueber den Interface-Typ spraenge nach null.
    var isVirtM: int64 := (self.cg_nival(ni) >> 1) & 1;
    if (isVirtM == 0 && self.cg_isIfaceSelector(mname, mlen) != 0) { isVirtM := 1; }
    var classIdx: int64 := self.cg_findClass(className, classNameLen);
    if (isVirtM != 0 && classIdx >= 0) {
      var slotCount: int64   := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTSLOTS);
      var methodList2: int64 := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTLIST);
      var vmtDataOff2: int64 := peek64(self.classLayouts + classIdx * CG_CLASS_SZ + CG_CLASS_OFF_VMTOFF);
      var si5: int64 := 0;
      while (si5 < slotCount) {
        var sName5: pchar := peek64(methodList2 + si5 * 16) as pchar;
        var sLen5:  int64 := peek64(methodList2 + si5 * CG_VMTMETH_SZ + CG_VMTMETH_OFF_NAMELEN);
        if (self.cg_seq(sName5, sLen5, mname, mlen) != 0) {
          self.cg_addVmtMethodPatch(vmtDataOff2 + si5 * 8, methodCodeStart);
          break;
        }
        si5 += 1;
      }
    }
    self.cg_cfi(CFI_ENDE, 0);   // #2135: wie am Ende von cg_genFuncDecl
    self.cfiInFn := 0;
    // #2044: innere Funktionen der Methode — wie am Ende von cg_genFuncDecl.
    self.cg_flushNested();
  }

  // ------------------------------------------------------------------
  // Expression code generation — result always in RAX
  // ------------------------------------------------------------------

  fn cg_genExpr(ni: int64) {
    if (ni < 0) { self.cg_zeroRax(); return; }
    // #1030: Beim Emittieren eines aufgeschobenen Aufrufs liefern die
    // Argumentknoten den bei der Vormerkung gesicherten Wert.
    if (self.dfReplay != 0) {
      var dfIdx: int64 := self.cg_deferArgIdx(ni);
      if (dfIdx >= 0) { self.cg_loadRax(peek64(self.dfSlots + dfIdx * 8)); return; }
    }
    var k: int64 := self.cg_nkind(ni);
    // #2133: ein Satz {Code, Umgebung} an einer Stelle, die eine Adresse
    // braucht (alles ausser den Satz-Stellen, die satzKontext setzen):
    // auspacken. Die Markierung gilt nur fuer DIESEN Knoten.
    if (k == CGN_IDENT || k == CGN_CALL) {
      var satzGew: int64 := self.satzKontext;
      self.satzKontext := 0;
      if (satzGew == 0 && self.cg_istSatzWert(ni) != 0) {
        self.satzKontext := 1;
        self.cg_genExpr(ni);
        self.cg_emitSatzAuspacken();
        return;
      }
    }

    if (k == CGN_MATCH) {
      // match als Ausdruck: cg_genMatch laesst den Wert des getroffenen
      // Fallrumpfes in rax stehen (jeder Fall endet mit cg_genExpr des Rumpfes
      // und springt danach ans Ende), im Durchfall 0.
      self.cg_genMatch(ni);

    } else if (k == CGN_LIT_INT) {
      self.cg_movRaxImm(self.cg_nival(ni));

    } else if (k == CGN_LIT_BOOL) {
      self.cg_movRaxImm(self.cg_nival(ni));

    } else if (k == CGN_LIT_CHAR) {
      self.cg_movRaxImm(self.cg_nival(ni));

    } else if (k == CGN_LIT_NULL) {
      self.cg_zeroRax();

    // WP-BC-13: format expression — evaluate inner expr; width/decimals available via nc1/nc2
    } else if (k == CGN_FORMAT_EXPR) {
      self.cg_genExpr(self.cg_nc0(ni));

    // WP-BC-14: null coalescing x ?? fallback — if x != null use x, else fallback
    } else if (k == CGN_NULL_COAL) {
      self.cg_genExpr(self.cg_nc0(ni));          // rax = lhs
      self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
      self.cg_e8(0x75);                            // jnz short (lhs is not null, keep it)
      var pSkip: int64 := self.codeLen;
      self.cg_e8(0);
      self.cg_genExpr(self.cg_nc1(ni));          // rax = fallback (only if lhs was null)
      cg_patchRel8(self.code, pSkip, self.codeLen);

    // WP-BC-14: safe cast x as? T — pass-through in bootstrap (nullable = same repr)
    } else if (k == CGN_SAFE_CAST) {
      self.cg_genExpr(self.cg_nc0(ni));

    } else if (k == CGN_SIMD_NEW) {
      // WP-GPU-01: parallel Array<f32>(size) — alloc size*4+24 bytes (16 align + 8 count slot).
      // Layout: [count:8B][up-to-15B padding][aligned data: size*4 bytes]
      // ptr = (mmap_base + 23) & ~15 → always ptr-8 >= mmap_base; count stored at ptr-8.
      var sizeNode: int64 := self.cg_nc1(ni);
      if (sizeNode >= 0) {
        self.cg_genExpr(sizeNode);    // rax = element count
      } else {
        self.cg_movRaxImm(0);
      }
      // #2206: aus dem Bump-Allokator statt per eigenem mmap — siehe
      // cg_emitSimdBumpAlloc. Layout unveraendert: Zaehler bei ptr-8,
      // Zeiger auf 16 ausgerichtet.
      // #2199: c0 ist der Elementtyp (parser.lyx:1291) — er entscheidet die
      // Breite der Ablage.
      self.cg_emitSimdBumpAlloc(self.cg_simdBytesVonTyp(self.cg_nc0(ni)));

    // WP-17: Range expression (1..100) - returns start value in rax
    } else if (k == CGN_RANGE) {
      // c0 = start, c1 = end
      // Generate: push start onto stack, then evaluate end, then pop start back
      // Result: rax = start value (end is stored but needs to be handled by caller)
      self.cg_genExpr(self.cg_nc0(ni));
      self.cg_pushRax();
      self.cg_genExpr(self.cg_nc1(ni));
      // Now rax = end, stack has start
      // For range iteration, we store end in a local for the loop
      // The caller (for loop) will handle iteration
      
    // WP-17: Where clause - just evaluate base type, constraint is compile-time only
    } else if (k == CGN_WHERE) {
      self.cg_genExpr(self.cg_nc0(ni));

    } else if (k == CGN_LIT_STR) {
      var sOff: int64 := self.cg_nsoff(ni);
      var sLen: int64 := self.cg_nslen(ni);
      var dataOff: int64 := self.cg_addStr(sOff, sLen);
      var patchPos: int64 := self.cg_emitLeaStr();
      self.cg_addPatch(patchPos, dataOff, 0, CG_PATCH_STR);

    } else if (k == CGN_REGEX_LIT) {
      var sOff: int64 := self.cg_nsoff(ni);
      var sLen: int64 := self.cg_nslen(ni);
      var dataOff: int64 := self.cg_addStrRaw(sOff, sLen);   // #1378
      var patchPos: int64 := self.cg_emitLeaStr();
      self.cg_addPatch(patchPos, dataOff, 0, CG_PATCH_STR);

    } else if (k == CGN_IDENT) {
      var name: pchar := self.cg_nsval(ni);
      var nlen: int64 := self.cg_nslen(ni);
      // #2044: eine innere Funktion als WERT (`var f: fn(int64): int64 :=
      // innen;`). Bis 1.2.12A kannte cg_isDeclaredFunc nur die oberste Ebene,
      // der Bezeichner fiel bis auf cg_zeroRax durch, und der Aufruf ueber f
      // sprang nach 0. Der Vorpass hat Verdeckung durch Variablen schon
      // beruecksichtigt — ein eingetragener Bezeichner IST die Funktion.
      var idNest: int64 := self.cg_nestIdx(ni);
      var off: int64 := 0;
      if (idNest < 0) { off := self.cg_findLocal(name, nlen); }
      if (idNest >= 0) {
        self.cg_emitFuncAddr(self.cg_nestLbl(idNest), self.cg_nestLblLen(idNest));
      } else if (off != 0) {
        // WP-B1: @redundant vars use TMR majority-vote read
        // Layout: A=off-16 (lowest addr/@x), B=off-8, C=off
        var ridx: int64 := self.cg_findLocalIdx(name, nlen);
        if (ridx >= 0 && self.cg_isLocalRedundant(ridx) != 0) {
          self.cg_emitTmrRead(off - 16, off - 8, off);
          self.tmrReadVoted += 1;   // #1141
        } else {
          self.cg_loadRax(off);
        }
      } else if (self.closureEnvPtrOff != 0) {
        // WP-02: Inside closure inner function — look up via env ptr
        var capIdx: int64 := self.cg_findClosureCap(name, nlen);
        if (capIdx >= 0) {
          // mov rbx, [rbp + envPtrOff]  (env ptr)
          self.cg_loadRax(self.closureEnvPtrOff);
          // mov rax, [rax + capIdx*8]
          var envOff: int64 := capIdx * 8;
          if (envOff == 0) {
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x00);  // mov rax, [rax]
          } else if (envOff < 128) {
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x40); self.cg_e8(envOff);
          } else {
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x80); self.cg_e32(envOff);
          }
        } else {
          var goffC: int64 := self.cg_findGlobal(name, nlen);
          if (goffC >= 0) { self.cg_emitGlobalRead(name, nlen, goffC); }   // #1141
          else if (self.cg_hasConVal(name, nlen) != 0) { self.cg_emitConLoad(name, nlen); }
          else if (self.cg_findExternDataIdx(name, nlen) >= 0) { self.cg_emitExternDataAddr(name, nlen); }
          else if (self.cg_isDeclaredFunc(name, nlen) != 0) { self.cg_emitFuncAddr(name, nlen); }
          else { self.cg_identUnaufgeloest(name, nlen); }
        }
      } else {
        // WP-13: Check if this is a captured variable from outer scope
        // If we have a static link, check if variable is captured via outer frame
        if (self.staticLinkOffset >= 0) {
          var capturedOff: int64 := self.cg_findCapturedVar(name, nlen);
          if (capturedOff != 0) {
            // Load static link into rbx, then access captured var via [rbx+offset]
            self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x5D); self.cg_e8(0x10); // mov rbx, [rbp+16]
            // mov rax, [rbx+capturedOff]
            if (capturedOff >= -128 && capturedOff <= 127) {
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x44); self.cg_e8(0x1B); self.cg_e8(capturedOff);
            } else {
              self.cg_e8(0x48); self.cg_e8(0x8B); self.cg_e8(0x84); self.cg_e8(0x1B);
              self.cg_e32(capturedOff);
            }
          } else {
            // Not local and not captured - check global, then constant
            var goff1: int64 := self.cg_findGlobal(name, nlen);
            if (goff1 >= 0) {
              self.cg_emitGlobalRead(name, nlen, goff1);   // #1141
            } else if (self.cg_hasConVal(name, nlen) != 0) {
              self.cg_emitConLoad(name, nlen);
            } else if (self.cg_findExternDataIdx(name, nlen) >= 0) {
              self.cg_emitExternDataAddr(name, nlen);
            } else if (self.cg_isDeclaredFunc(name, nlen) != 0) {
              self.cg_emitFuncAddr(name, nlen);
            } else {
              self.cg_identUnaufgeloest(name, nlen);
            }
          }
        } else {
          var goff2: int64 := self.cg_findGlobal(name, nlen);
          if (goff2 >= 0) {
            self.cg_emitGlobalRead(name, nlen, goff2);   // #1141
          } else if (self.cg_hasConVal(name, nlen) != 0) {
            self.cg_emitConLoad(name, nlen);
          } else if (self.cg_findExternDataIdx(name, nlen) >= 0) {
            self.cg_emitExternDataAddr(name, nlen);
          } else if (self.cg_isDeclaredFunc(name, nlen) != 0) {
            self.cg_emitFuncAddr(name, nlen);
          } else {
            self.cg_identUnaufgeloest(name, nlen);
          }
        }
      }

    } else if (k == CGN_BINOP) {
      var op: int64 := self.cg_nival(ni);
      var lhsNi: int64 := self.cg_nc0(ni);
      var rhsNi: int64 := self.cg_nc1(ni);
      // WP-10g: Constant Folding — both sides constant → single immediate
      if (self.cg_tryFold(ni) != 0) {
        self.cg_movRaxImm(self.foldBuf);

      } else if (op == CGT_AND) {
        // Kurzschluss: ist die linke Seite falsch, wird die rechte GAR NICHT
        // ausgewertet. Vorher wurden beide Seiten zu Werten ausgewertet und
        // danach verknuepft -- damit lief `p != 0 && deref(p)` auch bei p == 0
        // in die Dereferenzierung (Issue #1023).
        // #2244: jedes test+jcc und der jmp wie in cg_genSprungWennFalsch
        // ausgerichtet (JCC-Erratum, cg_paarAusrichten) — nur Fuellung davor,
        // nichts wird verschoben.
        self.cg_genExpr(lhsNi);
        self.cg_paarAusrichten(self.codeLen, 9);
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
        self.cg_e8(0x0F); self.cg_e8(0x84);                     // jz  -> falsch
        var scaF1: int64 := self.codeLen; self.cg_e32(0);
        self.cg_genExpr(rhsNi);
        self.cg_paarAusrichten(self.codeLen, 9);
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
        self.cg_e8(0x0F); self.cg_e8(0x84);                     // jz  -> falsch
        var scaF2: int64 := self.codeLen; self.cg_e32(0);
        self.cg_movRaxImm(1);
        self.cg_paarAusrichten(self.codeLen, 5);
        self.cg_e8(0xE9);                                       // jmp -> Ende
        var scaEnd: int64 := self.codeLen; self.cg_e32(0);
        poke32(self.code + scaF1, self.codeLen - scaF1 - 4);
        poke32(self.code + scaF2, self.codeLen - scaF2 - 4);
        self.cg_zeroRax();
        poke32(self.code + scaEnd, self.codeLen - scaEnd - 4);

      } else if (op == CGT_OR) {
        // Kurzschluss: ist die linke Seite wahr, wird die rechte nicht
        // ausgewertet.
        self.cg_genExpr(lhsNi);
        self.cg_paarAusrichten(self.codeLen, 9);                  // #2244
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
        self.cg_e8(0x0F); self.cg_e8(0x85);                     // jnz -> wahr
        var scoT1: int64 := self.codeLen; self.cg_e32(0);
        self.cg_genExpr(rhsNi);
        self.cg_paarAusrichten(self.codeLen, 9);                  // #2244
        self.cg_e8(0x48); self.cg_e8(0x85); self.cg_e8(0xC0);   // test rax, rax
        self.cg_e8(0x0F); self.cg_e8(0x85);                     // jnz -> wahr
        var scoT2: int64 := self.codeLen; self.cg_e32(0);
        self.cg_zeroRax();
        self.cg_paarAusrichten(self.codeLen, 5);                  // #2244
        self.cg_e8(0xE9);                                       // jmp -> Ende
        var scoEnd: int64 := self.codeLen; self.cg_e32(0);
        poke32(self.code + scoT1, self.codeLen - scoT1 - 4);
        poke32(self.code + scoT2, self.codeLen - scoT2 - 4);
        self.cg_movRaxImm(1);
        poke32(self.code + scoEnd, self.codeLen - scoEnd - 4);

      } else if (self.cg_vektorBinopOhneWeg(op, lhsNi, rhsNi) != 0) {
        // #2222: meldet und beendet selbst; hier kommt nichts an.

      } else if (self.cg_utypeBinopConvNeeded(ni) != 0) {
        // #1956: zwei Einheiten derselben Dimension mit verschiedenem Faktor.
        // Die rechte Seite wird auf die Einheit der linken gebracht, DANN
        // gerechnet. Der Zweig steht bewusst vor den Konstanten-Schnellpfaden:
        // die emittieren die Operation direkt und haetten keine Stelle, an der
        // sich der Faktor noch anbringen liesse.
        var uLhs: int64 := self.cg_utypeOfExpr(lhsNi);
        var uRhs: int64 := self.cg_utypeOfExpr(rhsNi);
        self.cg_genExpr(lhsNi);
        self.cg_pushRax();
        self.cg_genExpr(rhsNi);
        self.cg_emitUtypeConv(uLhs, uRhs);      // rechte Seite in die linke Einheit
        self.cg_popRbx();
        self.cg_emitF64BinOp(op);

      } else if (op != CGT_AND && op != CGT_OR && self.cg_tryFold(lhsNi) != 0) {
        // LHS is constant: push it so the RHS function call can't clobber rbx
        var lhsVal: int64 := self.foldBuf;
        self.cg_movRaxImm(lhsVal);
        self.cg_pushRax();
        self.cg_genExpr(rhsNi);
        self.cg_popRbx();
        // #1212: Dieser Schnellpfad emittierte immer die GANZZAHL-Operation,
        // auch wenn die andere Seite ein f64 ist — `10 - 2.5` subtrahierte
        // ganzzahlig auf dem Bitmuster des double. cg_tryFold liefert nur
        // ganzzahlige Konstanten, die linke Seite ist hier also stets int.
        if (self.cg_isF64Expr(rhsNi) != 0) {
          self.cg_emitMixedToF64(lhsNi, rhsNi);
          self.cg_emitF64BinOp(op);
        } else {
          self.cg_emitBinOp(op, self.cg_isUnsignedExpr(lhsNi),
                            self.cg_isUnsignedExpr(lhsNi) | self.cg_isUnsignedExpr(rhsNi));
        }
      } else if (op != CGT_AND && op != CGT_OR && self.cg_tryFold(rhsNi) != 0) {
        // CSE: RHS is constant → eval LHS into rax, mov rbx,rax, load const (no push/pop)
        var rhsVal: int64 := self.foldBuf;
        // #2247: `peek32(adr) & 0xFFFFFFFF` ist ein vorzeichenloser 32-Bit-
        // Zugriff. peek32 erweitert mit Vorzeichen, die Maske schneidet die
        // oberen 32 Bit wieder ab — ein 32-Bit-Ladebefehl macht beides in
        // einem Befehl. Im Summenkern aus bench/arr_int.lyx war das der
        // letzte reine Transportbefehl im Schleifenrumpf.
        //
        // Geaeussert wird nur ein WUNSCH; ob er erfuellt wird, entscheidet
        // cg_genCall hinter seinen Verdeckungsregeln (#1311, #2082) und
        // meldet es ueber p32Erfuellt zurueck. Bleibt die Erfuellung aus,
        // laeuft der Weg unten unveraendert weiter und die Maske wird
        // erzeugt — die Regeln stehen damit an EINER Stelle.
        if (op == CGT_BITAND && rhsVal == 4294967295
            && lhsNi >= 0 && self.cg_nkind(lhsNi) == CGN_CALL
            && self.cg_isF64Expr(lhsNi) == 0) {
          var p32Alt: int64 := self.p32Wunsch;
          var p32ErfAlt: int64 := self.p32Erfuellt;
          self.p32Wunsch := 1;
          self.p32Erfuellt := 0;
          self.cg_genExpr(lhsNi);
          var p32Ok: int64 := self.p32Erfuellt;
          self.p32Wunsch := p32Alt;
          self.p32Erfuellt := p32ErfAlt;
          if (p32Ok != 0) { return; }
          // Nicht erfuellt: der Wert steht wie gewohnt in rax, es fehlt nur
          // die Maske. Sie wird hier nachgezogen, statt den Ausdruck ein
          // zweites Mal auszuwerten.
          self.cg_e8(0x89); self.cg_e8(0xC0);            // mov eax, eax
          return;
        }
        self.cg_genExpr(lhsNi);
        // #2114: Ganzzahl OP Konstante direkt als Operand (`and rax, imm`,
        // `shl rax, imm`), ohne die Konstante erst nach rax zu laden.
        var rhsDirekt: int64 := 0;
        if (self.cg_isF64Expr(lhsNi) == 0) {
          rhsDirekt := self.cg_emitBinOpImm(op, rhsVal, self.cg_isUnsignedExpr(lhsNi),
                                            self.cg_isUnsignedExpr(lhsNi) | self.cg_isUnsignedExpr(rhsNi));
        }
        if (rhsDirekt == 0) {
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC3);  // mov rbx, rax
        self.cg_movRaxImm(rhsVal);
        // #1212: dieselbe Luecke mit vertauschten Rollen — `2.5 + 10` liess
        // den ganzzahligen Summanden unbeachtet und ergab 2.5.
        if (self.cg_isF64Expr(lhsNi) != 0) {
          self.cg_emitMixedToF64(lhsNi, rhsNi);
          self.cg_emitF64BinOp(op);
        } else {
          self.cg_emitBinOp(op, self.cg_isUnsignedExpr(lhsNi),
                            self.cg_isUnsignedExpr(lhsNi) | self.cg_isUnsignedExpr(rhsNi));
        }
        }
      } else if (self.cg_tryClassBinop(ni) != 0) {
        // operator overloading: a.Op(b) for a class-typed left operand — emitted
        // by cg_tryClassBinop (result already in rax).
      } else if (op == CGT_PLUS && self.cg_isPcharExpr(lhsNi) != 0 && self.cg_isPcharExpr(rhsNi) != 0) {
        // pchar + pchar → StrConcat: eval lhs→rdi, rhs→rsi, emit concat body
        self.cg_genExpr(lhsNi);
        self.cg_pushRax();
        self.cg_genExpr(rhsNi);
        self.cg_e8(0x48); self.cg_e8(0x89); self.cg_e8(0xC6);  // mov rsi, rax (b)
        self.cg_popRdi();                                         // pop rdi     (a)
        self.cg_emitStrConcatBody();
      } else if ((op == CGT_PLUS || op == CGT_MINUS || op == CGT_STAR || op == CGT_SLASH) &&
