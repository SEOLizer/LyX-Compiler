    self.cg_e8(0xC6); self.cg_e8(0x06); self.cg_e8(0x2D);                                      // mov byte [rsi], '-'
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xCE);                                      // dec rsi
    // .emit: inc rsi; lea rdx,[rsp+30]; sub rdx,rsi; inc rdx (no '\n')
    self.cg_e8(0x48); self.cg_e8(0xFF); self.cg_e8(0xC6);                                      // inc rsi
    self.cg_e8(0x48); self.cg_e8(0x8D); self.cg_e8(0x54); self.cg_e8(0x24); self.cg_e8(0x1E); // lea rdx, [rsp+30]
    self.cg_e8(0x48); self.cg_e8(0x29); self.cg_e8(0xF2);                                      // sub rdx, rsi
