// #1915: Einen KURZSPRUNG (rel8) nachtragen — mit Pruefung statt mit Abschnitt.
//
// `poke8` nimmt jeden Wert und verwirft die oberen Bits. Aus einer Distanz von
// 130 wird damit das Byte 130, und das liest die CPU als -126: der Sprung geht
// RUECKWAERTS mitten in den uebersprungenen Block. Genau so ist #1915
// entstanden — `push` auf ein Array, dessen Local jenseits von rbp-128 liegt,
// sprang in den eigenen Wachstumspfad zurueck und lief in einen
// Speicherzugriffsfehler.
//
// Der Fehler ist von aussen nicht zu sehen: dasselbe Programm mit einer
// Variablen weniger uebersetzt zu einem tadellosen Erzeugnis. Deshalb scheitert
// diese Stelle jetzt LAUT. Wer einen Zweig verlaengert, bis er nicht mehr in
// einen Kurzsprung passt, erfaehrt es beim Uebersetzen und nicht beim Absturz
// eines fremden Programms.
//
// Freie Funktion, KEINE Methode — eine zusaetzliche Methode verschiebt die
// Vtable der Klasse (#1853).
// Dieselbe Pruefung fuer eine bereits ausgerechnete Distanz — etwa dort, wo
// der Abstand zwischen zwei Marken eingetragen wird.
fn cg_patchRel8Wert(code: int64, pos: int64, dist: int64): void {
  if (dist < 0 || dist > 127) {
    EPrintStr("error: codegen: Kurzsprung ueberschreitet 127 Byte (Distanz "c);
    EPrintStr(IntToStr(dist));
    EPrintStrLn(") — dieser Zweig braucht einen langen Sprung (rel32). Siehe #1915."c);
    exit(1);
  }
  poke8(code + pos, dist);
}

fn cg_patchRel8(code: int64, pos: int64, codeLen: int64): void {
  var dist: int64 := codeLen - pos - 1;
  if (dist < 0 || dist > 127) {
    EPrintStr("error: codegen: Kurzsprung ueberschreitet 127 Byte (Distanz "c);
    EPrintStr(IntToStr(dist));
    EPrintStrLn(") — dieser Zweig braucht einen langen Sprung (rel32). Siehe #1915."c);
    exit(1);
  }
  poke8(code + pos, dist);
}

// #1878: Kopfgroesse der Scrub-Tabelle (siehe cg_scrubBuildTable).
con CG_SCRUB_HDR: int64 := 64;

// #1878: CRC32 (IEEE 802.3) ueber einen Speicherbereich. Dieselbe Rechnung wie
// `ms_crc32` in src/lyxc.lyx und `_ms_crc32` in std/meta_safe.lyx — die drei
// muessen uebereinstimmen, sonst meldet der Sweep eine heile Seite als
// beschaedigt. Der Handler im Erzeugnis rechnet sie ein viertes Mal in
// Maschinencode nach (cg_scrubEmitHandler); auch der gehoert dazu.
// Freie Funktion, KEINE Methode: eine zusaetzliche Methode verschiebt die
// Vtable der Klasse (#1853).
fn cg_crc32(data: int64, len: int64): int64 {
  var crc: int64 := 0xFFFFFFFF;
  var i: int64 := 0;
  while (i < len) {
    crc := crc ^ (peek8(data + i) & 0xFF);
    var b: int64 := 0;
    while (b < 8) {
      if ((crc & 1) != 0) {
        crc := ((crc >> 1) & 0x7FFFFFFF) ^ (0 - 306674912);
      } else {
        crc := (crc >> 1) & 0x7FFFFFFF;
      }
      b += 1;
    }
    i += 1;
  }
  return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF;
}

