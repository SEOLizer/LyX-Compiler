// ============================================================================
// File I/O Helpers (using syscalls)
// ============================================================================

// Open file - returns fd or -1 on error
pub fn FileOpen(path: pchar, flags: int64, mode: int64): int64 {
  return open(path, flags, mode);
}

// Close file
pub fn FileClose(fd: int64): int64 {
  return close(fd);
}

// Read from file
pub fn FileRead(fd: int64, buf: int64, count: int64): int64 {
  return read(fd, buf, count);
}

// Write to file
pub fn FileWrite(fd: int64, buf: int64, count: int64): int64 {
  return write(fd, buf, count);
}

// Seek in file
pub fn FileSeek(fd: int64, offset: int64, whence: int64): int64 {
  return lseek(fd, offset, whence);
}

// FileSize gehoert nach src/std/fs.lyx (stat-basiert) und existiert zusaetzlich
// als Builtin. Die lseek-Fassung stand hier zweitens im Weg: wer beide Units
// importierte, band je nach Import-Reihenfolge die eine oder die andere. (#1028)

// Read entire file
pub fn FileReadAll(path: pchar): pchar {
  var fd: int64 := open(path, 0, 0);
  if fd < 0 { return 0 as pchar; }
  
  var size: int64 := lseek(fd, 0, 2);
  if size <= 0 {
    close(fd);
    return 0 as pchar;
  }
  // WP-31: Dateigrößen-Limit 256 MB — verhindert OOM durch präparierte Eingaben
  if size > 268435456 {
    EPrintStr("error: FileReadAll: Datei überschreitet 256-MB-Limit: "c);
    EPrintStr(path);
    EPrintStr("\n"c);
    close(fd);
    return 0 as pchar;
  }

  lseek(fd, 0, 0);

  // mmap mit 6 Argumenten für Dateilesen: addr=0, length=size+1, prot=1, flags=34, fd=-1, offset=0
  var buf: int64 := alloc(size + 1);
  var bytesRead: int64 := read(fd, buf, size);
  
  close(fd);
  
  if bytesRead != size {
    free(buf, size + 1);
    return 0 as pchar;
  }
  
  poke8(buf + size, 0);
  return buf as pchar;
}

// Print int64 as 16-digit uppercase hex with "0x" prefix
pub fn PrintHex(n: int64): void {
  PrintStr("0x"c);
  var buf: int64 := alloc(16);
  var i: int64 := 15;
  while i >= 0 {
    var nibble: int64 := (n >> (i * 4)) & 15;
    if nibble < 10 {
      poke8(buf + (15 - i), 48 + nibble);
    } else {
      poke8(buf + (15 - i), 55 + nibble);
    }
    i := i - 1;
  }
  write(STDOUT_FILENO, buf, 16);
  free(buf, 16);
}

// Print byte as 2-digit uppercase hex (no prefix)
pub fn PrintHexByte(n: int64): void {
  var buf: int64 := alloc(2);
  var hi: int64 := (n >> 4) & 15;
  var lo: int64 := n & 15;
  if hi < 10 { poke8(buf, 48 + hi); } else { poke8(buf, 55 + hi); }
  if lo < 10 { poke8(buf + 1, 48 + lo); } else { poke8(buf + 1, 55 + lo); }
  write(STDOUT_FILENO, buf, 2);
  free(buf, 2);
}

// Write entire file
pub fn FileWriteAll(path: pchar, data: pchar, size: int64): bool {
  var fd: int64 := open(path, 65, 384);  // O_WRONLY | O_CREAT | O_TRUNC, 0600
  if fd < 0 { return false; }
  
  var written: int64 := write(fd, data, size);
  close(fd);
  
  return written == size;
}
