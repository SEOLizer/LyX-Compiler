// src/std/lyxos/lbf_layout.lyx — Physische Konstanten des LBF-Nativ-Formats (LYX!)
//
// Produktionsformat für den LyxOS-Kernel. Magic: LYX! (0x4C 0x59 0x58 0x21)
// Jeder Block exakt 4096 Bytes: 64 B Header + 4032 B Payload.

// ── Block-Geometrie ───────────────────────────────────────────────────────────

pub con LBF_BLOCK_SIZE   : int64 := 4096;
pub con LBF_HEADER_SIZE  : int64 := 64;
pub con LBF_PAYLOAD_SIZE : int64 := 4032;
pub con LBF_TLV_MAX_SIZE : int64 := 3904;  // TLV-Pool im Genesis-Payload

// ── Magic-Bytes: 'L' 'Y' 'X' '!' ─────────────────────────────────────────────

pub con LBF_MAGIC_0 : int64 := 76;   // 'L'
pub con LBF_MAGIC_1 : int64 := 89;   // 'Y'
pub con LBF_MAGIC_2 : int64 := 88;   // 'X'
pub con LBF_MAGIC_3 : int64 := 33;   // '!'

// ── page_type ─────────────────────────────────────────────────────────────────

pub con LBF_PAGE_EXECUTABLE : int64 := 4;   // 0x04

// ── flags (Bitmask) ───────────────────────────────────────────────────────────

pub con LBF_FLAG_IMMUTABLE : int64 := 1;    // bit0 → .text/.rodata

// ── Block-Header-Feld-Offsets (Bytes) ────────────────────────────────────────
//
//  +0x0000  [4]  Magic
//  +0x0004  [1]  page_type
//  +0x0005  [1]  flags
//  +0x0006  [2]  edge_offset
//  +0x0008  [8]  lpid
//  +0x0010  [2]  payload_size
//  +0x0018  [4]  block_crc32c
//  +0x001C  [4]  meta_offset
//  +0x0020  [8]  cont_lpid
//  +0x0028  [4]  block_index
//  +0x002C  [4]  total_blocks
//  +0x0038  [8]  compiled_at

pub con LBF_H_MAGIC       : int64 := 0;    // [4] Magic bytes
pub con LBF_H_PAGE_TYPE   : int64 := 4;    // [1] page_type
pub con LBF_H_FLAGS       : int64 := 5;    // [1] flags (Immutable etc.)
pub con LBF_H_EDGE_OFF    : int64 := 6;    // [2] edge_offset
pub con LBF_H_LPID        : int64 := 8;    // [8] Logical Page ID
pub con LBF_H_PAYLOAD_SZ  : int64 := 16;   // [2] payload_size (always 4032)
pub con LBF_H_CRC32C      : int64 := 24;   // [4] CRC32C des Payloads
pub con LBF_H_META_OFF    : int64 := 28;   // [4] meta_offset
pub con LBF_H_CONT_LPID   : int64 := 32;   // [8] Fortsetzungs-LPID
pub con LBF_H_BLOCK_IDX   : int64 := 40;   // [4] block_index
pub con LBF_H_TOTAL_BLK   : int64 := 44;   // [4] total_blocks
pub con LBF_H_COMPILED_AT : int64 := 56;   // [8] Zeitstempel Epoch µs

// ── Genesis-spezifische Werte ─────────────────────────────────────────────────

pub con LBF_GENESIS_EDGE_OFF : int64 := 64;   // 0x0040 — edge_offset im Genesis-Header
pub con LBF_GENESIS_META_OFF : int64 := 64;   // 0x0040 — meta_offset im Genesis-Header

// ── target_arch-Werte (Genesis-Payload +0x0001) ──────────────────────────────

pub con LBF_ARCH_X86_64 : int64 := 1;
pub con LBF_ARCH_ARM64  : int64 := 2;
pub con LBF_ARCH_RISCV  : int64 := 3;

// ── Genesis-Payload content_type ─────────────────────────────────────────────

pub con LBF_GEN_CONTENT_EXECUTABLE : int64 := 1;

// ── Genesis-Payload Packed-Binary Offsets (GEN_P_*) ──────────────────────────
//
//  +0x0000  [1]   content_type
//  +0x0001  [1]   target_arch
//  +0x0002  [2]   os_version_min (u16le)
//  +0x0004  [8]   entry_point    (u64le)
//  +0x000C  [4]   file_size      (u32le)
//  +0x0010  [2]   text_blocks    (u16le)
//  +0x0012  [2]   rodata_blocks  (u16le)
//  +0x0014  [2]   data_blocks    (u16le)
//  +0x0016  [2]   bss_blocks     (u16le)
//  +0x0018  [4]   stack_size     (u32le, default 0x20000)
//  +0x001C  [4]   file_crc32c    (u32le, 0 beim Serialisieren)
//  +0x0020  [16]  compiler_name  ("lyxc" + Nullen)
//  +0x0030  [4]   compiler_ver   (u32le, packed Major.Minor.Patch)
//  +0x0034  [8]   compiled_at    (u64le, Epoch µs)
//  +0x003C  [16]  compiler_uuid  (UUID v4)
//  +0x004C  [32]  source_sha256  (SHA-256 der Quelldateien)
//  +0x006C  [2]   tlv_offset     (u16le, 0x0080 Standard)
//  +0x006E  [2]   tlv_used       (u16le)
//  +0x0080  [3904] tlv_pool

pub con GEN_P_CONTENT_TYPE  : int64 := 0;
pub con GEN_P_TARGET_ARCH   : int64 := 1;
pub con GEN_P_OS_VER_MIN    : int64 := 2;
pub con GEN_P_ENTRY_POINT   : int64 := 4;
pub con GEN_P_FILE_SIZE     : int64 := 12;
pub con GEN_P_TEXT_BLOCKS   : int64 := 16;
pub con GEN_P_RODATA_BLOCKS : int64 := 18;
pub con GEN_P_DATA_BLOCKS   : int64 := 20;
pub con GEN_P_BSS_BLOCKS    : int64 := 22;
pub con GEN_P_STACK_SIZE    : int64 := 24;
pub con GEN_P_FILE_CRC32C   : int64 := 28;
pub con GEN_P_COMPILER_NAME : int64 := 32;
pub con GEN_P_COMPILER_VER  : int64 := 48;
pub con GEN_P_COMPILED_AT   : int64 := 52;
pub con GEN_P_COMPILER_UUID : int64 := 60;
pub con GEN_P_SOURCE_SHA256 : int64 := 76;
pub con GEN_P_TLV_OFFSET    : int64 := 108;
pub con GEN_P_TLV_USED      : int64 := 110;
pub con GEN_P_TLV_POOL      : int64 := 128;

// ── Lifecycle-Descriptor (TLV 0x08) ──────────────────────────────────────────

pub con LBF_LC_ONE_SHOT   : int64 := 0;   // CLI: start → main → exit
pub con LBF_LC_EVENT_LOOP : int64 := 1;   // Explizite Event-Schleife
pub con LBF_LC_DAEMON     : int64 := 2;   // Langlebiger Hintergrundprozess
pub con LBF_LC_REACTIVE   : int64 := 3;   // Lazy-Start: nur bei erstem Event

// ── TLV-Typen ─────────────────────────────────────────────────────────────────

pub con LBF_TLV_HUMAN_INTENT  : int64 := 1;  // UTF-8 Freitext aus ///-Doc-Comment
pub con LBF_TLV_DEP_HASH_GRAPH: int64 := 2;  // SHA-256-Hashes der Abhängigkeiten
pub con LBF_TLV_SYM_INTERFACE : int64 := 3;  // Funktions-Signaturen + Contract-Hashes
pub con LBF_TLV_ISA_EXTENSIONS: int64 := 4;  // uint64 Bitmaske (AVX2=0, AVX512=1...)
pub con LBF_TLV_CAPABILITIES  : int64 := 5;  // uint64 Capability-Bits
pub con LBF_TLV_SOURCE_MAP    : int64 := 6;  // Git-Commit-Hash / Quellcode-URI
pub con LBF_TLV_BUILD_MANIFEST: int64 := 7;  // Array (filename[64]+sha256[32])
pub con LBF_TLV_LIFECYCLE     : int64 := 8;
pub con LBF_TLV_SECTION_MAP  : int64 := 9;   // TLV-intern: Segment-Deskriptor

// ── Section-Typ- und Schutz-Werte (TLV SECTION_MAP) ──────────────────────────

pub con LBF_SECT_TYPE_TEXT   : int64 := 1;
pub con LBF_SECT_TYPE_RODATA : int64 := 2;
pub con LBF_SECT_TYPE_DATA   : int64 := 3;
pub con LBF_SECT_TYPE_BSS    : int64 := 4;

pub con LBF_SECT_PROT_RX : int64 := 5;   // Read+Execute (.text)
pub con LBF_SECT_PROT_R  : int64 := 4;   // Read-only (.rodata)
pub con LBF_SECT_PROT_RW : int64 := 3;   // Read+Write (.data, .bss, Stack)  // Lifecycle-Descriptor

// ── Capability-Bits (TLV 0x05) ───────────────────────────────────────────────

pub con LBF_CAP_FS_READ        : int64 := 1;
pub con LBF_CAP_FS_WRITE       : int64 := 2;
pub con LBF_CAP_NET_SOCKET     : int64 := 4;
pub con LBF_CAP_PROC_SPAWN     : int64 := 8;
pub con LBF_CAP_KI_EMBED       : int64 := 16;
pub con LBF_CAP_KI_GRAPH_WRITE : int64 := 32;
// #1755: Rohzugriff auf Blockgeraete (Kernel-Klasse PLEDGE_BLOCK, Syscalls
// 98-102: sys_block_open/read/write/info, sys_gpt_create).
//
// Der Vorschlag im Issue nannte 0x10 — die ist hier seit jeher LBF_CAP_KI_EMBED.
// Wer nur die vier gesetzten Bits eines Testprogramms misst, sieht die schon
// vergebenen nicht. 0x40 ist die naechste freie Stelle (belegt sind 1, 2, 4, 8,
// 16, 32, 128).
pub con LBF_CAP_BLOCK_RAW      : int64 := 64;
pub con LBF_CAP_AUDIO_MIC      : int64 := 128;

// ── Event-IDs (Lifecycle REACTIVE/EVENT_LOOP) ─────────────────────────────────

pub con LBF_EV_STDIN      : int64 := 1;
pub con LBF_EV_FD         : int64 := 2;
pub con LBF_EV_TIMER      : int64 := 3;
pub con LBF_EV_SIGNAL     : int64 := 4;
pub con LBF_EV_NET_ACCEPT : int64 := 5;
pub con LBF_EV_NET_RECV   : int64 := 6;
pub con LBF_EV_IOFS_EVENT : int64 := 7;
pub con LBF_EV_KI_MESSAGE : int64 := 8;
pub con LBF_EV_CHILD_EXIT : int64 := 9;
pub con LBF_EV_AUDIO_IN   : int64 := 10;
