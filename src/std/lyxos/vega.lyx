// src/std/lyxos/vega.lyx
// LX-WP17: Vega Window System — constants and syscall wrappers

@description("LyxOS Vega window system: window manager, framebuffer, events, mouse, keyboard, shared memory")
@author("Andreas Röne")
@copyright("2026 Andreas Röne")
unit src.std.lyxos.vega;  // #1237: Name folgte dem Pfad nicht; die Zeile war folgenlos, jetzt wird sie geprueft

// ============================================================
// Window flags (sys_win_create)
// ============================================================
pub con VEGA_WIN_NORMAL:     int64 := 0;
pub con VEGA_WIN_BORDERLESS: int64 := 1;
pub con VEGA_WIN_FULLSCREEN: int64 := 2;
pub con VEGA_WIN_RESIZABLE:  int64 := 4;
pub con VEGA_WIN_HIDDEN:     int64 := 8;

// ============================================================
// Event types (sys_event_send / sys_event_recv)
// ============================================================
pub con VEGA_EVT_KEY_DOWN:    int64 := 1;
pub con VEGA_EVT_KEY_UP:      int64 := 2;
pub con VEGA_EVT_MOUSE_MOVE:  int64 := 3;
pub con VEGA_EVT_MOUSE_BTN:   int64 := 4;
pub con VEGA_EVT_WIN_CLOSE:   int64 := 5;
pub con VEGA_EVT_WIN_RESIZE:  int64 := 6;
pub con VEGA_EVT_WIN_FOCUS:   int64 := 7;

// ============================================================
// Mouse button bits (sys_get_mouse_btn)
// ============================================================
pub con VEGA_MBTN_LEFT:   int64 := 1;
pub con VEGA_MBTN_RIGHT:  int64 := 2;
pub con VEGA_MBTN_MIDDLE: int64 := 4;

// ============================================================
// Window Manager
// ============================================================

// sys_win_create(x, y, w, h, flags) → win_id (0=error)
pub fn VegaWinCreate(x: int64, y: int64, w: int64, h: int64, flags: int64): int64 {
    return sys_win_create(x, y, w, h, flags);
}

// sys_win_destroy(win_id) → 0=ok
pub fn VegaWinDestroy(winId: int64): int64 {
    return sys_win_destroy(winId);
}

// sys_win_raise(win_id) → 0=ok
pub fn VegaWinRaise(winId: int64): int64 {
    return sys_win_raise(winId);
}

// sys_win_move(win_id, x, y) → 0=ok
pub fn VegaWinMove(winId: int64, x: int64, y: int64): int64 {
    return sys_win_move(winId, x, y);
}

// sys_win_resize(win_id, new_w, new_h) → 0=ok
pub fn VegaWinResize(winId: int64, newW: int64, newH: int64): int64 {
    return sys_win_resize(winId, newW, newH);
}

// sys_win_get_fb(win_id) → framebuffer UVA (0=error)
pub fn VegaWinGetFb(winId: int64): int64 {
    return sys_win_get_fb(winId);
}

// sys_win_get_table_phys() → window table physical address
pub fn VegaWinGetTablePhys(): int64 {
    return sys_win_get_table_phys();
}

// ============================================================
// Display / Framebuffer
// ============================================================

// sys_vsync_wait() — block until next VSync
pub fn VegaVsyncWait(): int64 {
    return sys_vsync_wait();
}

// sys_fb_map_user(fb_phys, fb_w, fb_h, stride) → UVA of mapped framebuffer
pub fn VegaFbMapUser(fbPhys: int64, fbW: int64, fbH: int64, stride: int64): int64 {
    return sys_fb_map_user(fbPhys, fbW, fbH, stride);
}

// ============================================================
// Shared Memory
// ============================================================

// sys_shm_create(size) → shm_id (0=error)
pub fn VegaShmCreate(size: int64): int64 {
    return sys_shm_create(size);
}

// sys_shm_map(shm_id) → UVA (0=error)
pub fn VegaShmMap(shmId: int64): int64 {
    return sys_shm_map(shmId);
}

// sys_shm_unmap(shm_id) → 0=ok
pub fn VegaShmUnmap(shmId: int64): int64 {
    return sys_shm_unmap(shmId);
}

// ============================================================
// Events
// ============================================================

// sys_event_send(pid, type, a, b) → 0=ok
pub fn VegaEventSend(pid: int64, evtType: int64, a: int64, b: int64): int64 {
    return sys_event_send(pid, evtType, a, b);
}

// sys_event_recv(out_buf_uva) → event count written to buf
pub fn VegaEventRecv(outBuf: int64): int64 {
    return sys_event_recv(outBuf);
}

// sys_set_console(pid, shm_id) → 0=ok
pub fn VegaSetConsole(pid: int64, shmId: int64): int64 {
    return sys_set_console(pid, shmId);
}

// ============================================================
// PS/2 Mouse
// ============================================================

pub fn VegaGetMouseX(): int64 {
    return sys_get_mouse_x();
}

pub fn VegaGetMouseY(): int64 {
    return sys_get_mouse_y();
}

pub fn VegaGetMouseBtn(): int64 {
    return sys_get_mouse_btn();
}

// sys_set_mouse_bounds(max_x, max_y) → 0=ok
pub fn VegaSetMouseBounds(maxX: int64, maxY: int64): int64 {
    return sys_set_mouse_bounds(maxX, maxY);
}

// ============================================================
// Keyboard
// ============================================================

// sys_kbd_poll() → scancode (0=no key)
pub fn VegaKbdPoll(): int64 {
    return sys_kbd_poll();
}

// ============================================================
// Time
// ============================================================

// sys_time_ns() → nanoseconds since boot
pub fn VegaTimeNs(): int64 {
    return sys_time_ns();
}
