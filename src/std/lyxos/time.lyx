// src/std/lyxos/time.lyx — LX-11 Zeit-Konstanten

pub con CLOCK_REAL   : int64 := 0;   // Wanduhr (UTC, kann springen)
pub con CLOCK_MONO   : int64 := 1;   // Monoton seit Boot (kein Sprung)
pub con CLOCK_CPU    : int64 := 2;   // CPU-Zeit des aktuellen Prozesses
pub con CLOCK_THREAD : int64 := 3;   // CPU-Zeit des aktuellen Threads

pub con TIMER_PERIODIC : int64 := 1;  // Timer feuert wiederholt
pub con TIMER_ONESHOT  : int64 := 0;  // Timer feuert einmalig

pub con TIMER_DISARM_INTERVAL : int64 := 0;  // interval_ns=0 → einmaliger Schuss
pub con TIMER_DISARM_INITIAL  : int64 := 0;  // initial_ns=0 → Timer stoppen
