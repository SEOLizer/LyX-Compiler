// LX-10: LyxOS IPC & Synchronisation — Konstanten für 0x0400–0x040C
//
// Import:  import src.std.lyxos.ipc;
// Target:  --target=lyxos
//
// sys_mutex_lock, sys_mutex_unlock,
// sys_sem_create, sys_sem_wait, sys_sem_post, sys_sem_destroy,
// sys_channel_create, sys_channel_send, sys_channel_recv,
// sys_notify_create, sys_notify_send, sys_notify_recv,
// sys_futex
// sind Compiler-Builtins.

// ── Mutex (0x0400–0x0401) ─────────────────────────────────────────────────────
//
// sys_mutex_lock(mutex: int64): int64   — blockiert bis Mutex frei
// sys_mutex_unlock(mutex: int64): int64 — gibt Mutex frei

// ── Semaphor (0x0402–0x0405) ──────────────────────────────────────────────────
//
// sys_sem_create(initial: int64): int64  — erzeugt Semaphor mit Startwert
// sys_sem_wait(sem: int64): int64        — dekrementiert (blockiert bei 0)
// sys_sem_post(sem: int64): int64        — inkrementiert
// sys_sem_destroy(sem: int64): int64     — gibt Semaphor frei

pub con SEM_MAX: int64 := 32767;   // Maximaler Semaphor-Startwert

// ── Channel (Mach-inspiriert, 0x0406–0x0408) ──────────────────────────────────
//
// sys_channel_create(flags: int64): int64
//   → Rückgabe: (send_fd << 32) | recv_fd
//
// sys_channel_send(fd: int64, buf: pchar, len: int64): int64
// sys_channel_recv(fd: int64, buf: pchar, len: int64): int64

pub con CHAN_NONE:      int64 := 0;    // Standard-Channel
pub con CHAN_NONBLOCK:  int64 := 1;    // Nicht-blockierender Modus
pub con CHAN_MAX_MSG:   int64 := 4096; // Maximale Nachrichtengröße in Bytes

// Hilfsmakro-Konstanten für Channel-fd-Splitting
pub con CHAN_SEND_SHIFT: int64 := 32;
pub con CHAN_RECV_MASK:  int64 := 0xFFFFFFFF;

// ── Notification-Queue (0x0409–0x040B) ────────────────────────────────────────
//
// sys_notify_create(flags: int64): int64        — erzeugt Notification-Queue
// sys_notify_send(nq: int64, event: int64): int64
// sys_notify_recv(nq: int64, timeout_ns: int64): int64 — gibt event zurück

pub con NOTIFY_NONE:     int64 := 0;  // Standard
pub con NOTIFY_NONBLOCK: int64 := 1;  // Nicht-blockierend
pub con NOTIFY_WAIT_ANY: int64 := 0 - 1;  // Endlos warten (timeout_ns = -1)

// ── Futex (0x040C) ────────────────────────────────────────────────────────────
//
// sys_futex(addr: pchar, op: int64, val: int64): int64

pub con FUTEX_WAIT:   int64 := 0;   // Warten bis *addr != val
pub con FUTEX_WAKE:   int64 := 1;   // val Threads aufwecken
pub con FUTEX_REQUEUE: int64 := 3;  // Aufwecken und Wartende in neue Queue

// ── Hilfs-Konstanten für Mutex-Zustände ──────────────────────────────────────
pub con MUTEX_UNLOCKED: int64 := 0;
pub con MUTEX_LOCKED:   int64 := 1;
