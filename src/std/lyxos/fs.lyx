// LX-06: LyxOS VFS — Konstanten für die 22 Dateisystem-Syscalls
//
// Import:  import src.std.lyxos.fs;
// Target:  --target=lyxos  (Syscall-Nummern 0x0200–0x0215)
//
// Die Funktionen sys_open, sys_close, sys_read, sys_write, etc. sind
// Compiler-Builtins (erkannt via ir_lower seq-Checks → IRO_CALL_BUILTIN).
// Sie brauchen KEINEN Import — sind aber erst nach diesem Import bekannt
// für den Sema-Pass, wenn die Fehlermeldung "undefined function" kommt.
//
// Alle Pfad-Syscalls: dir_fd als erstes Argument; AT_CWD = -1 für CWD-relativ.
// ABI:  rax = Fehlercode (0=ok, <0=Fehler),  rdx = Nutzwert (Rückgabewert).

// ── Verzeichnis-Konstante ───────────────────────────────────────────────────

pub con AT_CWD: int64 := -1;

// ── Open-Flags ──────────────────────────────────────────────────────────────

pub con O_RDONLY:  int64 := 0;
pub con O_WRONLY:  int64 := 1;
pub con O_RDWR:    int64 := 2;
pub con O_CREAT:   int64 := 64;
pub con O_EXCL:    int64 := 128;
pub con O_TRUNC:   int64 := 512;
pub con O_APPEND:  int64 := 1024;
pub con O_INHERIT: int64 := 32768;   // opt-in fd inheritance über spawn

// ── Seek-Whence ─────────────────────────────────────────────────────────────

pub con SEEK_SET: int64 := 0;
pub con SEEK_CUR: int64 := 1;
pub con SEEK_END: int64 := 2;

// ── POSIX-Modus-Bits ────────────────────────────────────────────────────────

pub con S_IRWXU: int64 := 448;
pub con S_IRUSR: int64 := 256;
pub con S_IWUSR: int64 := 128;
pub con S_IXUSR: int64 := 64;
pub con S_IRWXG: int64 := 56;
pub con S_IRGRP: int64 := 32;
pub con S_IRWXO: int64 := 7;

// ── content_id-Algorithmus ──────────────────────────────────────────────────

pub con CID_BLAKE3: int64 := 0;   // 32-Byte-Hash

// ── stat_out-Layout (64 Bytes) ──────────────────────────────────────────────
//  +0  dev    (int64)   +8  ino    (int64)   +16 mode (int32)
//  +20 nlink  (int32)   +24 uid   (int32)    +28 gid  (int32)
//  +32 size   (int64)   +40 atime (int64)    +48 mtime (int64)
//  +56 ctime  (int64)

pub con STAT_SIZE: int64 := 64;

