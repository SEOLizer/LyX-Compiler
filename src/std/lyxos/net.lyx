// LX-08: LyxOS Netzwerk — Konstanten für 0x0600–0x0609
//
// Import:  import src.std.lyxos.net;
// Target:  --target=lyxos
//
// sys_socket, sys_bind, sys_listen, sys_accept, sys_connect,
// sys_sendmsg, sys_recvmsg, sys_setsockopt, sys_getsockopt, sys_shutdown
// sind Compiler-Builtins.

// ── Adressfamilien ───────────────────────────────────────────────────────────

pub con AF_UNIX:  int64 := 1;
pub con AF_INET:  int64 := 2;
pub con AF_INET6: int64 := 10;

// ── Socket-Typen ─────────────────────────────────────────────────────────────

pub con SOCK_STREAM:   int64 := 1;
pub con SOCK_DGRAM:    int64 := 2;
pub con SOCK_RAW:      int64 := 3;
pub con SOCK_NONBLOCK: int64 := 2048;
pub con SOCK_CLOEXEC:  int64 := 524288;

// ── Protokolle ───────────────────────────────────────────────────────────────

pub con IPPROTO_IP:  int64 := 0;
pub con IPPROTO_TCP: int64 := 6;
pub con IPPROTO_UDP: int64 := 17;

// ── sys_shutdown: how ────────────────────────────────────────────────────────

pub con SHUT_READ:  int64 := 0;
pub con SHUT_WRITE: int64 := 1;
pub con SHUT_RDWR:  int64 := 2;

// ── sys_sendmsg / sys_recvmsg: flags ─────────────────────────────────────────

pub con MSG_PEEK:     int64 := 1;
pub con MSG_WAITALL:  int64 := 2;
pub con MSG_OOB:      int64 := 1;
pub con MSG_DONTWAIT: int64 := 64;
pub con MSG_NOSIGNAL: int64 := 16384;

// ── sys_setsockopt / sys_getsockopt: Ebenen ──────────────────────────────────

pub con SOL_SOCKET: int64 := 1;

// ── SO_*-Optionen (SOL_SOCKET-Ebene) ─────────────────────────────────────────

pub con SO_TYPE:      int64 := 3;
pub con SO_ERROR:     int64 := 4;
pub con SO_SNDBUF:    int64 := 7;
pub con SO_RCVBUF:    int64 := 8;
pub con SO_KEEPALIVE: int64 := 9;
pub con SO_REUSEADDR: int64 := 2;
pub con SO_REUSEPORT: int64 := 15;
pub con SO_LINGER:    int64 := 13;

// ── TCP_*-Optionen (IPPROTO_TCP-Ebene) ───────────────────────────────────────

pub con TCP_NODELAY:   int64 := 1;
pub con TCP_KEEPIDLE:  int64 := 4;
pub con TCP_KEEPINTVL: int64 := 5;
pub con TCP_KEEPCNT:   int64 := 6;

// ── SockAddrIn-Layout (16 Bytes, für sys_bind/sys_connect/sys_accept) ────────
//
//  +0   sin_family:  uint16  (AF_INET = 2, big-endian)
//  +2   sin_port:    uint16  (Port, big-endian — htons() nötig)
//  +4   sin_addr:    uint32  (IPv4-Adresse, big-endian)
//  +8   sin_zero:    [8]uint8 (Nullen)

pub con SOCK_ADDR_IN_SIZE:  int64 := 16;
pub con SOCK_ADDR_IN6_SIZE: int64 := 28;
pub con SOCK_ADDR_UN_SIZE:  int64 := 110;   // 2 + 108-Byte-Pfad

// ── INADDR-Konstanten ────────────────────────────────────────────────────────

pub con INADDR_ANY:       int64 := 0;
pub con INADDR_LOOPBACK:  int64 := 2130706433;   // 127.0.0.1 host-order
pub con INADDR_BROADCAST: int64 := 4294967295;   // 255.255.255.255
