// src/std/lyxos/debug.lyx — Debug & Telemetrie Konstanten für LyxOS
//
// Syscalls (0x0A00–0x0A05) — alle Compiler-Builtins, kein Import nötig für Aufrufe.
// Import: import src.std.lyxos.debug;
// Target: --target=lyxos

// ── sys_trace_event — Event-IDs ──────────────────────────────────────────────

pub con TRACE_SYSCALL_ENTER: int64 := 0;
pub con TRACE_SYSCALL_EXIT:  int64 := 1;
pub con TRACE_SCHED:         int64 := 2;
pub con TRACE_ALLOC:         int64 := 3;
pub con TRACE_FREE:          int64 := 4;
pub con TRACE_USER:          int64 := 16; // Anwendungs-definierte Events ab 16

// ── sys_perf_counter — Counter-IDs ───────────────────────────────────────────

pub con PERF_CYCLES:         int64 := 0;
pub con PERF_INSTRUCTIONS:   int64 := 1;
pub con PERF_CACHE_REFS:     int64 := 2;
pub con PERF_CACHE_MISSES:   int64 := 3;
pub con PERF_BRANCHES:       int64 := 4;
pub con PERF_BRANCH_MISSES:  int64 := 5;
pub con PERF_WALL_NS:        int64 := 6; // Wanduhrzeit in Nanosekunden

// ── sys_watchpoint_set — Flags ────────────────────────────────────────────────

pub con WP_READ:   int64 := 1; // Watchpoint bei Lesezugriff
pub con WP_WRITE:  int64 := 2; // Watchpoint bei Schreibzugriff
pub con WP_EXEC:   int64 := 4; // Watchpoint bei Ausführung
pub con WP_RW:     int64 := 3; // Lesen + Schreiben
