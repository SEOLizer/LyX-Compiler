// LX-09: LyxOS Prozess & Threads — Konstanten für 0x0000–0x000D
//
// Import:  import src.std.lyxos.process;
// Target:  --target=lyxos
//
// sys_version, sys_exit, sys_exit_group, sys_spawn, sys_thread_spawn,
// sys_thread_exit, sys_wait, sys_getpid, sys_gettid, sys_yield,
// sys_sleep_ns, sys_priority, sys_getrandom, sys_signal_mask
// sind Compiler-Builtins.

// ── sys_spawn: Flags ─────────────────────────────────────────────────────────

pub con SPAWN_NONE:    int64 := 0;
pub con SPAWN_REPLACE: int64 := 1;   // Aktuellen Prozess ersetzen (exec-Äquivalent)
pub con SPAWN_WAIT:    int64 := 2;   // Blockieren bis Kind beendet
pub con SPAWN_NEWENV:  int64 := 4;   // Leere Umgebung (kein Erbe)
pub con SPAWN_NEWNS:   int64 := 8;   // Neuer Dateisystem-Namespace
pub con SPAWN_NEWNET:  int64 := 16;  // Neuer Netzwerk-Namespace

// ── SpawnOpts-Layout (72 Bytes, für sys_spawn letztes Argument) ──────────────
//
//  +0   flags:          int64  (SPAWN_*)
//  +8   cwd_fd:         int64  (-1 = erben)
//  +16  stdin_fd:       int64  (-1 = /dev/null)
//  +24  stdout_fd:      int64
//  +32  stderr_fd:      int64
//  +40  extra_fds:      int64  (Zeiger auf int64-Array weiterer fds)
//  +48  extra_fd_count: int64
//  +56  stack_size:     int64  (0 = Default 2 MB)
//  +64  priority:       int64  (0 = normal)

pub con SPAWN_OPTS_SIZE:         int64 := 72;
pub con SPAWN_OPTS_FLAGS:        int64 := 0;
pub con SPAWN_OPTS_CWD_FD:       int64 := 8;
pub con SPAWN_OPTS_STDIN_FD:     int64 := 16;
pub con SPAWN_OPTS_STDOUT_FD:    int64 := 24;
pub con SPAWN_OPTS_STDERR_FD:    int64 := 32;
pub con SPAWN_OPTS_EXTRA_FDS:    int64 := 40;
pub con SPAWN_OPTS_EXTRA_COUNT:  int64 := 48;
pub con SPAWN_OPTS_STACK_SIZE:   int64 := 56;
pub con SPAWN_OPTS_PRIORITY:     int64 := 64;

// ── sys_getrandom: Flags ─────────────────────────────────────────────────────

pub con GRND_BLOCK:    int64 := 0;   // Blockieren bis Entropie vorhanden
pub con GRND_NONBLOCK: int64 := 1;   // ERR_NONBLOCK wenn keine Entropie

// ── sys_priority: Prioritätswerte ────────────────────────────────────────────

pub con PRIO_NORMAL:   int64 := 0;
pub con PRIO_HIGH:     int64 := -10;
pub con PRIO_LOW:      int64 := 10;
pub con PRIO_REALTIME: int64 := -20;

// ── sys_wait: Timeout-Konstante ───────────────────────────────────────────────

pub con WAIT_FOREVER: int64 := -1;

// ── Zeit-Konstanten für sys_sleep_ns ─────────────────────────────────────────

pub con NS_PER_US:  int64 := 1000;
pub con NS_PER_MS:  int64 := 1000000;
pub con NS_PER_SEC: int64 := 1000000000;
