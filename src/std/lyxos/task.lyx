// src/std/lyxos/task.lyx — LX-13 Task-Scheduler-Konstanten

// sys_task_spawn flags
pub con TASK_DETACHED   : int64 := 1;  // Kein sys_task_await nötig; Ressourcen auto-frei
pub con TASK_HIGH_PRIO  : int64 := 2;  // Work-Stealing-Priorität erhöht
pub con TASK_PIN_CALLER : int64 := 4;  // Task startet bevorzugt auf dem aufrufenden Core

// sys_numa_alloc node_hint
pub con NUMA_NODE_ANY   : int64 := 0;  // Kernel wählt optimalen Node (0 = no preference)
