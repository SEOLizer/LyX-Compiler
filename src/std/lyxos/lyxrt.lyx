// src/std/lyxos/lyxrt.lyx — LyxOS Minimale Runtime
//
// Bereitgestellt von jedem Programm, das auf LyxOS läuft und
// einen Heap-Allocator oder Panik-Handler benötigt.
// Wird via `import src.std.lyxos.lyxrt;` eingebunden.

con RT_PROT_RW:  int64 := 3;   // PROT_READ | PROT_WRITE
con RT_MAP_ANON: int64 := 34;  // MAP_PRIVATE | MAP_ANONYMOUS
con RT_CHUNK:    int64 := 67108864; // 64 MB pro Chunk

var _rt_base: int64 := 0;
var _rt_off:  int64 := 0;
var _rt_cap:  int64 := 0;

// rt_alloc(size) — Bump-Pointer Arena auf sys_mmap (0x0100)
//
// #1698: Hiess bis 1.1.3L `alloc` und war nicht pub — die Unit war damit
// unbenutzbar, obwohl ihr Kopf sie als importierbaren Heap-Allocator
// beschreibt. Sie einfach oeffentlich zu machen waere die schlechtere Loesung
// gewesen: `alloc` ist zugleich ein BUILTIN, und ein Import haette dann still
// entschieden, welcher von beiden ein Aufruf trifft — Arena auf sys_mmap oder
// Builtin. Genau diese Verwechslung hat im Bestand schon einmal Zeit gekostet
// ("den" Allocator gibt es nicht). Der eindeutige Name beantwortet die Frage
// nicht, er stellt sie gar nicht erst.
pub fn rt_alloc(size: int64): int64 {
    var aligned: int64 := ((size + 15) / 16) * 16;
    if _rt_off + aligned > _rt_cap {
        var chunk: int64 := RT_CHUNK;
        if aligned > chunk { chunk := aligned + 65536; }
        var base: int64 := mmap(0, chunk, RT_PROT_RW, RT_MAP_ANON, -1, 0);
        if base < 0 {
            sys_write(2, "lyxrt: fatal: mmap failed\n"c, 26);
            sys_exit_group(1);
        }
        _rt_base := base;
        _rt_off  := 0;
        _rt_cap  := chunk;
    }
    var ptr: int64 := _rt_base + _rt_off;
    _rt_off := _rt_off + aligned;
    return ptr;
}

// rt_free(ptr, size) — No-op; die Arena faellt beim Prozess-Exit weg.
// Bewusst vorhanden, damit Aufrufer paarig schreiben koennen (#1698).
pub fn rt_free(ptr: int64, size: int64): void {
}

// rt_panic(msg, len) — Schreibt msg auf stderr und beendet den Prozess
pub fn rt_panic(msg: pchar, len: int64): void {
    sys_write(2, msg, len);
    sys_exit_group(1);
}
