// src/std/lyxos/graph.lyx — LX-16 Semantisches Paging & Wissensgraph-Konstanten

// sys_graph_node_create flags
// #2035: Interface-Konstanten, siehe lyra.lyx — das pub fehlte an allen.
pub con GRAPH_PERSIST    : int64 := 1   // Knoten überlebt fd-Close
pub con GRAPH_AUTO_EMBED : int64 := 2   // Kernel löst Embedding beim Close aus

// sys_graph_query rel_type
pub con GRAPH_REL_ANY         : int64 := -1   // Alle Kantentypen
pub con GRAPH_REL_CREATED_BY  : int64 := 1    // Erstellt von (Prozess/Agent)
pub con GRAPH_REL_BELONGS_TO  : int64 := 2    // Gehört zu (Projekt, Kontext)
pub con GRAPH_REL_REFERENCES  : int64 := 3    // Referenziert (Import, Link, Zitat)
pub con GRAPH_REL_DERIVED_FROM: int64 := 4    // Abgeleitet von (Version, Transformation)
pub con GRAPH_REL_TEMPORAL    : int64 := 5    // Zeitliche Nähe (innerhalb eines Workflows)
pub con GRAPH_REL_SEMANTIC    : int64 := 6    // Semantische Ähnlichkeit (KNN-basiert)
pub con GRAPH_REL_DEPENDS_ON  : int64 := 7    // Abhängigkeit (Code-Modul, Datei)
