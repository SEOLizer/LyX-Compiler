// die Argumente von sys_intent_submit, sys_lyra_event, sys_dream_register und
// sys_memory_store. Ihr Zweck IST der Export; das pub fehlte an allen.
pub con INTENT_PRIO_HIGH   : int64 := -1
pub con INTENT_PRIO_NORMAL : int64 :=  0
pub con INTENT_PRIO_LOW    : int64 :=  1

// sys_lyra_event event_type
pub con LYRA_VOICE  : int64 := 1   // Spracheingabe
pub con LYRA_GAZE   : int64 := 2   // Eye-Contact-Signal
pub con LYRA_SENSOR : int64 := 3   // Umgebungsdaten

// sys_dream_register flags
pub con DREAM_ONESHOT : int64 := 1   // Einmalig; danach automatisch unregistrieren

// sys_memory_store flags
pub con MEM_PERSIST : int64 := 1   // Eintrag überlebt Ring-TTL → Core Archive
pub con MEM_ENCRYPT : int64 := 2   // Verschlüsselung vor dem Speichern
