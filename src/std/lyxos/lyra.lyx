// sys_dream_register flags
con DREAM_ONESHOT : int64 := 1   // Einmalig; danach automatisch unregistrieren

// sys_memory_store flags
con MEM_PERSIST : int64 := 1   // Eintrag überlebt Ring-TTL → Core Archive
con MEM_ENCRYPT : int64 := 2   // Verschlüsselung vor dem Speichern
