// src/std/lyxos/errno.lyx — LX-23 Fehlercode-Konstanten für LyxOS

pub con ERR_OK      : int64 := 0;    // Kein Fehler
pub con ERR_PERM    : int64 := 1;    // Keine Berechtigung (EPERM)
pub con ERR_NOENT   : int64 := 2;    // Datei nicht gefunden (ENOENT)
pub con ERR_NOTSUP  : int64 := 95;   // Operation nicht unterstützt (EOPNOTSUPP)
pub con ERR_CAPVIOL : int64 := 125;  // Capability-Verletzung (LyxOS-spezifisch)
