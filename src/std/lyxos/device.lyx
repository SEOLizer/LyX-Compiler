// LX-07: LyxOS I/O-Geräte & Poll — Konstanten für 0x0300–0x0305
//
// Import:  import src.std.lyxos.device;
// Target:  --target=lyxos
//
// sys_poll, sys_ioctl, sys_mmap_device, sys_irq_bind, sys_port_in, sys_port_out
// sind Compiler-Builtins — kein Import nötig, aber die Konstanten erfordern diesen Import.

// ── Poll-Event-Flags ────────────────────────────────────────────────────────

pub con POLL_IN:   int64 := 1;    // Daten zum Lesen verfügbar
pub con POLL_OUT:  int64 := 4;    // Schreiben möglich (kein Blocking)
pub con POLL_ERR:  int64 := 8;    // Fehlerzustand auf fd
pub con POLL_HUP:  int64 := 16;   // Verbindung getrennt
pub con POLL_NVAL: int64 := 32;   // fd ist kein offener Dateideskriptor

// ── PollEvent-Struktur-Layout (16 Bytes, für sys_poll-Events-Array) ─────────
//
//  +0   fd:      int64   (8 Bytes)
//  +8   events:  uint32  (4 Bytes, Eingabe-Flags)
//  +12  revents: uint32  (4 Bytes, Ausgabe-Flags, vom Kernel befüllt)

pub con POLL_EVENT_SIZE: int64 := 16;

// ── Schutzbits für sys_mmap_device ──────────────────────────────────────────

pub con PROT_READ:  int64 := 1;
pub con PROT_WRITE: int64 := 2;
pub con PROT_EXEC:  int64 := 4;
pub con PROT_RW:    int64 := 3;   // PROT_READ | PROT_WRITE

// ── sys_ioctl-Request-Basis — geräteklassenspezifisch ───────────────────────

pub con IOCTL_TERMINAL_BASE: int64 := 0x5400;  // Terminalbefehle (tty)
pub con IOCTL_BLOCK_BASE:    int64 := 0x1200;  // Block-Geräte
pub con IOCTL_NET_BASE:      int64 := 0x8900;  // Netzwerk-Geräte

// ── sys_port_in/out: Breiten ─────────────────────────────────────────────────

pub con PORT_WIDTH_8:  int64 := 1;
pub con PORT_WIDTH_16: int64 := 2;
pub con PORT_WIDTH_32: int64 := 4;
