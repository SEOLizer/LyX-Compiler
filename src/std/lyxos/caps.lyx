// src/std/lyxos/caps.lyx — LX-12 Capability-, Pledge- und Unveil-Konstanten

// Capability-Rechte (Bitmask)
pub con RIGHT_READ    : int64 := 1;
pub con RIGHT_WRITE   : int64 := 2;
pub con RIGHT_EXEC    : int64 := 4;
pub con RIGHT_MMAP    : int64 := 8;
pub con RIGHT_SEEK    : int64 := 16;
pub con RIGHT_STAT    : int64 := 32;
pub con RIGHT_DELETE  : int64 := 64;
pub con RIGHT_CONTROL : int64 := 128;  // ioctl, setsockopt
pub con RIGHT_ALL     : int64 := 0x7FFFFFFFFFFFFFFF;

// seccomp-Modi
pub con SECCOMP_STRICT : int64 := 1;   // Nur read/write/exit/sigreturn
pub con SECCOMP_FILTER : int64 := 2;   // BPF-Filterprogramm
