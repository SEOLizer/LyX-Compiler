// src/std/lyxos/io.lyx — I/O Utilities für LyxOS
//
// Entspricht src/std/io.lyx, nutzt aber LyxOS-Syscalls:
//   sys_write  (0x0203)  statt write  (Linux #1)
//   sys_read   (0x0202)  statt read   (Linux #0)
//   sys_open   (0x0200)  statt open   (Linux #2); erstes Arg: AT_CWD = -1
//   sys_close  (0x0201)  statt close  (Linux #3)
//   sys_seek   (0x0204)  statt lseek  (Linux #8)
//
// Import:  import src.std.lyxos.io;
// Target:  --target=lyxos

import src.std.string;
import src.std.alloc;
import src.std.lyxos.fs;

con IO_STDIN:  int64 := 0;
con IO_STDOUT: int64 := 1;
con IO_STDERR: int64 := 2;

// ── Print ────────────────────────────────────────────────────────────────────

pub fn PrintStr(s: pchar): void {
    var len: int64 := StrLen(s);
    if len > 0 {
        sys_write(IO_STDOUT, s, len);
    }
}

pub fn PrintStrLn(s: pchar): void {
    PrintStr(s);
    sys_write(IO_STDOUT, "\n"c, 1);
}

pub fn PrintInt(n: int64): void {
    var buf: int64 := alloc(32);
    var neg: bool := false;
    if n < 0 { neg := true; n := 0 - n; }
    var len: int64 := 0;
    if n == 0 {
        poke8(buf, 48);
        len := 1;
    } else {
        while n > 0 {
            poke8(buf + len, 48 + (n % 10));
            len := len + 1;
            n := n / 10;
        }
    }
    if neg { poke8(buf + len, 45); len := len + 1; }
    var i: int64 := len - 1;
    while i >= 0 {
        sys_write(IO_STDOUT, buf + i, 1);
        i := i - 1;
    }
    free(buf, 32);
}

pub fn PrintIntLn(n: int64): void {
    PrintInt(n);
    sys_write(IO_STDOUT, "\n"c, 1);
}

// #1776: PrintFloat stand auch hier als Lyx-Fassung und verdeckte das
// Builtin (ID 9), das dieses Backend seit jeher hat — mit drei
// Nachkommastellen statt sechs und ohne fuehrende Nullen. Zwei Fassungen
// nebeneinander, von denen je nach Ziel eine andere laeuft, ist die
// schlechtere Haelfte beider Wege; es bleibt das Builtin.

pub fn PrintChar(c: int64): void {
    var buf: int64 := alloc(1);
    poke8(buf, c);
    sys_write(IO_STDOUT, buf, 1);
    free(buf, 1);
}

pub fn PrintBool(b: bool): void {
    if b { PrintStr("true"c); } else { PrintStr("false"c); }
}

pub fn PrintLn(): void {
    sys_write(IO_STDOUT, "\n"c, 1);
}

// ── Stderr ───────────────────────────────────────────────────────────────────

pub fn EPrintStr(s: pchar): void {
    var len: int64 := StrLen(s);
    if len > 0 { sys_write(IO_STDERR, s, len); }
}

pub fn EPrintStrLn(s: pchar): void {
    EPrintStr(s);
    sys_write(IO_STDERR, "\n"c, 1);
}

// ── Input ────────────────────────────────────────────────────────────────────

pub fn ReadLine(): pchar {
    var cap: int64 := 256;
    var buf: int64 := alloc(cap);
    var len: int64 := 0;
    while true {
        var tmp: int64 := alloc(1);
        var nr: int64 := sys_read(IO_STDIN, tmp, 1);
        if nr <= 0 { free(tmp, 1); break; }
        var c: int64 := peek8(tmp);
        free(tmp, 1);
        if c == 10 { break; }
        if c == 13 { continue; }
        if len >= cap - 1 {
            var nc: int64 := cap * 2;
            var nb: int64 := alloc(nc);
            var j: int64 := 0;
            while j < len { poke8(nb + j, peek8(buf + j)); j := j + 1; }
            free(buf, cap);
            buf := nb;
            cap := nc;
        }
        poke8(buf + len, c);
        len := len + 1;
    }
    poke8(buf + len, 0);
    return buf as pchar;
}

pub fn ReadChar(): int64 {
    var tmp: int64 := alloc(1);
    var nr: int64 := sys_read(IO_STDIN, tmp, 1);
    if nr <= 0 { free(tmp, 1); return 0; }
    var c: int64 := peek8(tmp);
    free(tmp, 1);
    return c;
}

pub fn ReadInt(): int64 {
    var buf: int64 := alloc(1);
    var c: int64 := 0;
    while true {
        var nr: int64 := sys_read(IO_STDIN, buf, 1);
        if nr <= 0 { free(buf, 1); return 0; }
        c := peek8(buf);
        if c == 45 || (c >= 48 && c <= 57) { break; }
    }
    var result: int64 := 0;
    var neg: bool := false;
    if c == 45 {
        neg := true;
        sys_read(IO_STDIN, buf, 1);
    } else {
        result := c - 48;
    }
    while true {
        var nr: int64 := sys_read(IO_STDIN, buf, 1);
        if nr <= 0 { break; }
        c := peek8(buf);
        if c < 48 || c > 57 { break; }
        result := result * 10 + (c - 48);
    }
    free(buf, 1);
    if neg { return 0 - result; }
    return result;
}

// ── File I/O ──────────────────────────────────────────────────────────────────

pub fn FileOpen(path: pchar, flags: int64, mode: int64): int64 {
    return sys_open(AT_CWD, path, flags, mode);
}

pub fn FileClose(fd: int64): int64 {
    return sys_close(fd);
}

pub fn FileRead(fd: int64, buf: int64, count: int64): int64 {
    return sys_read(fd, buf, count);
}

pub fn FileWrite(fd: int64, buf: int64, count: int64): int64 {
    return sys_write(fd, buf, count);
}

pub fn FileSeek(fd: int64, offset: int64, whence: int64): int64 {
    return sys_seek(fd, offset, whence);
}

pub fn FileSize(path: pchar): int64 {
    var fd: int64 := sys_open(AT_CWD, path, O_RDONLY, 0);
    if fd < 0 { return -1; }
    var sz: int64 := sys_seek(fd, 0, SEEK_END);
    sys_close(fd);
    return sz;
}

pub fn FileReadAll(path: pchar): pchar {
    var fd: int64 := sys_open(AT_CWD, path, O_RDONLY, 0);
    if fd < 0 { return 0 as pchar; }
    var size: int64 := sys_seek(fd, 0, SEEK_END);
    if size <= 0 { sys_close(fd); return 0 as pchar; }
    sys_seek(fd, 0, SEEK_SET);
    var buf: int64 := alloc(size + 1);
    var nr: int64 := sys_read(fd, buf, size);
    sys_close(fd);
    if nr != size { free(buf, size + 1); return 0 as pchar; }
    poke8(buf + size, 0);
    return buf as pchar;
}

pub fn FileWriteAll(path: pchar, data: pchar, size: int64): bool {
    var flags: int64 := O_WRONLY + O_CREAT + O_TRUNC;
    var fd: int64 := sys_open(AT_CWD, path, flags, 384);
    if fd < 0 { return false; }
    var written: int64 := sys_write(fd, data, size);
    sys_close(fd);
    return written == size;
}

