// src/std/lyxos/ai.lyx — LX-14 KI-Basis-Konstanten

// sys_ai_model_load flags
con AI_MODEL_SHARED  : int64 := 1   // Kernel-weites Shared-Memory für Weights
con AI_MODEL_LAZY    : int64 := 2   // Lazy-Load per Page-Fault (Standard)
con AI_MODEL_EAGER   : int64 := 4   // Weights sofort vollständig laden

// sys_ai_ctx_create flags
con AI_CTX_DEFAULT   : int64 := 0   // Modell-Default-Kontextgröße
con AI_CTX_STREAMING : int64 := 1   // Token-für-Token-Streaming aktiv

// sys_ai_infer flags (in AiInferOpts.flags)
con AI_INFER_GREEDY  : int64 := 1   // Greedy-Decoding (temperature ignoriert)
con AI_INFER_SAMPLE  : int64 := 2   // Nucleus-Sampling (top_p aktiv)
