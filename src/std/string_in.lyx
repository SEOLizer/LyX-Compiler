// src/std/string_in.lyx — Zeichenketten in einen MITGEGEBENEN Puffer (#1744).
//
// Diese Unit ist bewusst klein und haengt an NICHTS: kein Allokator, keine
// Ein-/Ausgabe, keine Gleitkommazahl. Genau deshalb steht sie hier und nicht
// in std/string — jene Unit bringt ueber die StringBuilder-Methode
// AppendFloat Gleitkomma-Rechnung mit, und der Erreichbarkeitsfilter (#1727)
// greift bei METHODEN nicht. Ein freistehendes Ziel scheiterte damit schon am
// Import, bevor es zu diesen Funktionen kam.


// ============================================================================
// #1744: die beiden Fassungen mit mitgegebenem Puffer
// ============================================================================
//
// IntToStr und StrSub liefern einen Zeiger auf frischen Speicher. Auf Linux
// kommt der aus mmap; ein freistehendes Ziel (Cortex-M, Xtensa) hat weder
// mmap noch einen Allokator, und ein gemeinsamer fester Puffer waere still
// falsch: zwei Aufrufe hintereinander lieferten denselben Zeiger, der zweite
// ueberschriebe den ersten, und niemand saehe es.
//
// Diese beiden Fassungen bekommen den Puffer vom Aufrufer. Damit liegt die
// Lebensdauer dort, wo sie auf einem Mikrocontroller hingehoert. Sie sind in
// Lyx geschrieben und brauchen nichts als Division, poke8 und StrLen — also
// kein Betriebssystem und keinen Eintrag in vier Backends.
//
// Beide geben die Anzahl der geschriebenen Zeichen zurueck (ohne die
// abschliessende Null) oder -1, wenn der Puffer zu klein ist. Ein zu kleiner
// Puffer wird NICHT halb gefuellt: entweder steht das Ergebnis vollstaendig
// da oder gar nichts.

pub fn IntToStrIn(n: int64, puffer: int64, groesse: int64): int64 {
  if puffer == 0 { return 0 - 1; }
  if groesse <= 1 { return 0 - 1; }

  // Wieviele Zeichen braucht die Zahl? Erst zaehlen, dann schreiben — so
  // faellt ein zu kleiner Puffer auf, BEVOR etwas darin steht.
  var stellen: int64 := 1;
  var rest: int64 := n;
  if n < 0 {
    stellen := 2;          // Vorzeichen und mindestens eine Ziffer
    rest := 0 - n;
  }
  var teiler: int64 := 1;
  while rest / teiler >= 10 {
    teiler := teiler * 10;
    stellen := stellen + 1;
  }
  if stellen + 1 > groesse { return 0 - 1; }

  var pos: int64 := 0;
  if n < 0 {
    poke8(puffer, 45);     // '-'
    pos := 1;
  }
  while teiler > 0 {
    poke8(puffer + pos, 48 + (rest / teiler) % 10);
    pos := pos + 1;
    teiler := teiler / 10;
  }
  poke8(puffer + pos, 0);
  return pos;
}

pub fn StrSubIn(s: pchar, start: int64, len: int64, puffer: int64, groesse: int64): int64 {
  if puffer == 0 { return 0 - 1; }
  if groesse <= 0 { return 0 - 1; }
  if s == 0 as pchar { return 0 - 1; }
  if start < 0 { return 0 - 1; }
  if len < 0 { return 0 - 1; }

  // Nicht ueber das Ende der Kette hinaus lesen, auch wenn der Aufrufer mehr
  // verlangt — dieselbe Vorsicht wie in StrSubstr.
  var vorhanden: int64 := StrLen(s);
  if start > vorhanden { return 0 - 1; }
  var nimm: int64 := len;
  if start + nimm > vorhanden { nimm := vorhanden - start; }
  if nimm + 1 > groesse { return 0 - 1; }

  var i: int64 := 0;
  while i < nimm {
    poke8(puffer + i, peek8((s as int64) + start + i));
    i := i + 1;
  }
  poke8(puffer + nimm, 0);
  return nimm;
}
