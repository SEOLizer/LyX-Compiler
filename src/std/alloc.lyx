// src/std/alloc.lyx — mmap-basierte Speicher-Wrapper für den Compiler-Selbst-Build

con MMAP_PROT_RW:  int64 := 3;   // PROT_READ | PROT_WRITE
con MMAP_ANON:     int64 := 34;  // MAP_PRIVATE | MAP_ANONYMOUS

fn alloc(size: int64): int64 {
  return mmap(0, size, MMAP_PROT_RW, MMAP_ANON, -1, 0);
}

fn free(ptr: int64, size: int64): void {
  munmap(ptr, size);
}
