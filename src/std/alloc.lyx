// src/std/alloc.lyx — Arena-Allocator für den Compiler-Selbst-Build
//
// Problem: viele separate mmap()-Calls fragmentieren den Adressraum und
// kollidieren ohne ASLR immer mit dem Stack (100% Crash-Rate bei lyxc.lyx).
// Lösung: ein großes Arena-Segment früh mappen, dann Bump-Pointer intern.

con MMAP_PROT_RW:  int64 := 3;   // PROT_READ | PROT_WRITE
con MMAP_ANON:     int64 := 34;  // MAP_PRIVATE | MAP_ANONYMOUS
con ARENA_CHUNK:   int64 := 268435456; // 256 MB pro Chunk

// Arena-Zustand (global, zero-initialisiert)
var _arena_base: int64 := 0;
var _arena_off:  int64 := 0;
var _arena_cap:  int64 := 0;

pub fn alloc(size: int64): int64 {
  // WP-26: Zero-Alloc-Aliasing verhindern (C-2)
  if size <= 0 { size := 1; }
  // WP-26: Integer-Overflow-Guard — max 1 GB pro Allokation (C-1)
  if size > 1073741824 { return 0; }

  // Auf 16 Bytes aufrunden
  var aligned: int64 := ((size + 15) / 16) * 16;

  // Lazy-Init oder Chunk erschöpft → neuen Chunk mappen
  if _arena_off + aligned > _arena_cap {
    var chunk: int64 := ARENA_CHUNK;
    if aligned > chunk { chunk := aligned + 65536; }
    var base: int64 := mmap(0, chunk, MMAP_PROT_RW, MMAP_ANON, -1, 0);
    // MAP_FAILED = -1 als signed int64; 0 als Rückgabe zeigt dem Caller
    // sofort durch Null-Deref wo das Problem liegt.
    if base < 0 { base := 0; }
    _arena_base := base;
    _arena_off  := 0;
    _arena_cap  := chunk;
  }

  var ptr: int64 := _arena_base + _arena_off;
  _arena_off := _arena_off + aligned;
  return ptr;
}

pub fn free(ptr: int64, size: int64): void {
  // Arena: kein Freigeben nötig — Compiler läuft single-pass,
  // der gesamte Adressraum wird beim Prozess-Exit zurückgegeben.
}
