// ===========================================================================
// WP-T13: Security Audit Output + Score
// ===========================================================================
// Stellt Hilfsfunktionen für den LCBS Security Audit bereit.
// Die Hauptausgabe erfolgt via cg_runAudit() in codegen_x86.lyx.
//
// Score-Berechnung (max 50 + 5 Bonus Stack Canaries):
//   +10: Kein Klasse-3-Extern ohne system.unsafe.format_string
//   + 5: W^X (zwei PT_LOAD: RX + RW — nur statisch; WP-6 offen für dynamisch)
//   + 5: RELRO (kein GOT/PLT — nur statisches ELF; WP-6b für dynamisch)
//   + 0: PIE  (nicht implementiert; geplant für zukünftiges WP)
//   +10: Grant-Vollständigkeit (–2 pro fehlendem grant)
//   + 5: seccomp aktiv (SECCOMP_RET_KILL_PROCESS)
//   + 5: landlock aktiv
//   – 3: pro @fastpath-Nutzung
//   + 5: Stack Canaries (WP-18)

// Kurzname einer Capability-ID (Bootstrap-sichere Kopie aus capabilities.lyx)
pub fn audit_cap_name(capId: int64): pchar {
  if capId == 0  { return "system.exit"c; }
  if capId == 1  { return "system.memory.heap"c; }
  if capId == 2  { return "system.memory.stack"c; }
  if capId == 3  { return "system.time"c; }
  if capId == 4  { return "system.env"c; }
  if capId == 5  { return "system.rand"c; }
  if capId == 6  { return "system.unsafe.format_string"c; }
  if capId == 7  { return "fs.read"c; }
  if capId == 8  { return "fs.write"c; }
  if capId == 9  { return "fs.create"c; }
  if capId == 10 { return "fs.delete"c; }
  if capId == 11 { return "fs.meta"c; }
  if capId == 12 { return "fs.exec"c; }
  if capId == 13 { return "memory.mmap"c; }
  if capId == 14 { return "memory.lock"c; }
  if capId == 15 { return "network.tcp.bind"c; }
  if capId == 16 { return "network.tcp.connect"c; }
  if capId == 17 { return "network.udp.bind"c; }
  if capId == 18 { return "network.udp.connect"c; }
  if capId == 19 { return "network.unix"c; }
  if capId == 20 { return "network.raw"c; }
  if capId == 21 { return "hardware.gpio"c; }
  if capId == 22 { return "hardware.i2c"c; }
  if capId == 23 { return "hardware.spi"c; }
  if capId == 24 { return "hardware.usb"c; }
  if capId == 25 { return "process.fork"c; }
  if capId == 26 { return "process.exec"c; }
  if capId == 27 { return "process.signal"c; }
  if capId == 28 { return "process.sched"c; }
  if capId == 29 { return "process.exit"c; }
  if capId == 30 { return "fs.perm"c; }        // #1188
  return "unknown"c;
}

// Berechnet den Sicherheits-Score (0–50; negativ möglich bei vielen @fastpath).
// seccompOk, landlockOk, relroOk: 1 wenn aktiv.
// missingGrants: Anzahl Imports ohne explizites grant.
// fastpathCount: Anzahl @fastpath-Nutzungen.
pub fn audit_compute_score(seccompOk: int64, landlockOk: int64, missingGrants: int64, fastpathCount: int64, wxActive: int64, relroOk: int64): int64 {
  var s: int64 := 0;
  s := s + 10;  // +10: kein Klasse-3-Extern (Build würde sonst fehlschlagen)
  if wxActive  != 0 { s := s + 5; }  // + 5: W^X (zwei PT_LOAD: RX + RW)
  if relroOk   != 0 { s := s + 5; }  // + 5: RELRO (kein GOT/PLT — statisches ELF)
  // PIE: 0 (nicht implementiert — geplant für zukünftiges WP)
  var grantScore: int64 := 10 - missingGrants * 2;
  if grantScore < 0 { grantScore := 0; }
  s := s + grantScore;
  if seccompOk  != 0 { s := s + 5; }
  if landlockOk != 0 { s := s + 5; }
  s := s - fastpathCount * 3;
  return s;
}
