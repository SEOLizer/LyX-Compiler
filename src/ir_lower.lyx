  fn _fieldTypeNodeIn(typeDecl: int64, fp: pchar, fl: int64): int64 {
    var pn: int64 := self.nodeC2(typeDecl);
    if pn >= 0 {
      var base: int64 := self._findTypeDecl(self.nodeSVal(pn), self.nodeSLen(pn));
      if base >= 0 {
        var r: int64 := self._fieldTypeNodeIn(base, fp, fl);
        if r >= 0 { return r; }
