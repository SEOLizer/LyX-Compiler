    var tn: int64 := self._baseTypeNode(baseNode);
    if tn < 0 { return 0 - 1; }
    var g: int64 := self._tregFind(self.nodeSVal(tn), self.nodeSLen(tn));
    if g < 0 { return 0 - 1; }
    var offg: int64 := self._tregFieldOffG(g, fp, fl);
    if offg >= 0 { if self._tregHasVmtG(g) != 0 { offg := offg + 8; } }
