  // ============================================================================
  // WP-20: Generics Lowering
  // ============================================================================
  
  // WP-2.1: Lower a generic call like max[int64](3, 7).
  // NK_CALL with iVal=2:
  //   sVal/sLen = generic function name ("max")
  //   c0        = first argument (linked via nodeNext)
  //   c2        = first type-arg AST node (NK_TYPE_NAME "int64", linked via nodeNext)
  fn lowerGenericCall(expr: int64): int64 {
    var dest: int64 := self.allocTemp();
    var genName: pchar := self.nodeSVal(expr);
    var genLen: int64  := self.nodeSLen(expr);
    var typeArgNode: int64 := self.nodeC2(expr);
    var arg0: int64 := self.nodeC0(expr);

    // Build mangled name: "genName__type1__type2..."
    var mangBuf: int64 := alloc(genLen + 512);
    if (mangBuf == 0) { return dest; }
    var pos: int64 := 0;
    var i: int64 := 0;
    while (i < genLen) {
      poke8(mangBuf + pos, StrCharAt(genName, i)); pos := pos + 1; i := i + 1;
    }
    var ta: int64 := typeArgNode;
    while (ta >= 0) {
      StrSetChar(mangBuf as pchar, pos, 95); pos := pos + 1;  // '_'
      StrSetChar(mangBuf as pchar, pos, 95); pos := pos + 1;  // '_'
      var tName: pchar := self.nodeSVal(ta);
      var tLen: int64  := self.nodeSLen(ta);
      var j: int64 := 0;
      while (j < tLen) {
        poke8(mangBuf + pos, StrCharAt(tName, j)); pos := pos + 1; j := j + 1;
      }
      ta := self.nodeNext(ta);
    }
    poke8(mangBuf + pos, 0);

    // Find the generic declaration node by searching genFuncBuf
    var genFuncNodeIdx: int64 := -1;
    var gi: int64 := 0;
    while (gi < self.genFuncCount) {
      var gRec: int64 := self.genFuncBuf + gi * 24;
      var gNPtr: pchar := peek64(gRec) as pchar;
      var gNLen: int64 := peek64(gRec + GENFUNC_REC_OFF_NAMELEN);
      if (gNLen == genLen) {
        var isMatch: int64 := 1;
        var k: int64 := 0;
        while (k < genLen) {
          if (StrCharAt(gNPtr, k) != StrCharAt(genName, k)) { isMatch := 0; break; }
          k += 1;
        }
        if (isMatch != 0) { genFuncNodeIdx := peek64(gRec + GENFUNC_REC_OFF_NODEIDX); break; }
      }
      gi += 1;
    }

    // Check if this specialization is already in the pending queue
    var already: int64 := 0;
    var pi: int64 := 0;
    while (pi < self.pendingGenCount) {
      var pRec: int64 := self.pendingGenBuf + pi * 32;
      var pLen: int64 := peek64(pRec + PENDING_REC_OFF_MANGLEN);
      if (pLen == pos) {
        var pPtr: pchar := peek64(pRec) as pchar;
        var m2: int64 := 1; var k2: int64 := 0;
        while (k2 < pos) {
          if (StrCharAt(pPtr, k2) != StrCharAt(mangBuf as pchar, k2)) { m2 := 0; break; }
          k2 += 1;
        }
        if (m2 != 0) { already := 1; break; }
      }
      pi += 1;
    }

    // Enqueue if not yet pending
    if (already == 0 && genFuncNodeIdx >= 0) {
      if (self.pendingGenCount >= self.pendingGenCap) {
        var pnc: int64 := self.pendingGenCap * 2;
        var pnb: int64 := alloc(pnc * 32);
        var pni: int64 := 0;
        memcpy(pnb, self.pendingGenBuf, self.pendingGenCount * 32);
        free(self.pendingGenBuf, self.pendingGenCap * 32);
        self.pendingGenBuf := pnb; self.pendingGenCap := pnc;
      }
      var pRec2: int64 := self.pendingGenBuf + self.pendingGenCount * 32;
      poke64(pRec2,      mangBuf);           // mangledPtr
      poke64(pRec2 + PENDING_REC_OFF_MANGLEN,  pos);               // mangledLen
      poke64(pRec2 + PENDING_REC_OFF_NODEIDX, genFuncNodeIdx);    // genFuncNodeIdx
      poke64(pRec2 + PENDING_REC_OFF_EMITTED, 0);                 // emitted = false
      self.pendingGenCount += 1;
    }

    // Lower the actual call arguments
    var argTemps: int64 := alloc(64 * 8);  // up to 64 args
    var argCount: int64 := 0;
    var argNode: int64 := arg0;
    while (argNode >= 0 && argCount < 64) {
      var aTemp: int64 := self.lowerExpr(argNode);
      poke64(argTemps + argCount * 8, aTemp);
      argCount += 1;
      argNode := self.nodeNext(argNode);
    }
    // Emit: call mangled_name(arg0, arg1, ...)
    var mangNameOff: int64 := self.irAddString(mangBuf as pchar, pos);
    var ai: int64 := 0;
    while (ai < argCount) {
      self.irAddInstrDirect(IRO_STORE_LOCAL, ai, peek64(argTemps + ai * 8), -1, 0);
      ai += 1;
    }
    self.irAddInstrDirect(IRO_CALL, dest, mangNameOff, -1, argCount);
    free(argTemps, 64 * 8);
    // Note: mangBuf is kept alive (stored in pendingGenBuf) until module lowering completes
    return dest;
  }
  
