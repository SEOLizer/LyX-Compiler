    }
    return 0;
  }

  fn lowerField(expr: int64): int64 {
    var dest: int64 := self.allocTemp();
    var baseNode: int64 := self.nodeC0(expr);

    // TypeName.field — resolve to compile-time byte offset constant
    if self.nodeKind(baseNode) == NK_IDENT {
      var bSVal: pchar := self.nodeSVal(baseNode);
      var bSLen: int64 := self.nodeSLen(baseNode);
      var fSVal: pchar := self.nodeSVal(expr);
      var fSLen: int64 := self.nodeSLen(expr);

      var ti: int64 := 0;
      while ti < self.nodeCount {
        if self.nodeKind(ti) == NK_TYPE_DECL {
          if self.seq(self.nodeSVal(ti), self.nodeSLen(ti), bSVal, bSLen) {
            var offset: int64 := 0;
            var fd: int64 := self.nodeC0(ti);
            while fd >= 0 {
              // Explicit at(offset) override (iVal bit0 = FIELD_FLAG_PACKED_OFFSET)
              if (self.nodeIVal(fd) & 1) != 0 {
                var offNode: int64 := self.nodeC1(fd);
                if offNode >= 0 {
                  if self.nodeKind(offNode) == NK_LIT_INT {
                    offset := self.nodeIVal(offNode);
                  }
                }
              }
              if self.seq(self.nodeSVal(fd), self.nodeSLen(fd), fSVal, fSLen) {
                self.irAddInstrDirect(IRO_CONST_INT, dest, -1, -1, offset);
                return dest;
              }
              offset := offset + self.fieldTypeSize(self.nodeC0(fd));
              fd := self.nodeNext(fd);
            }
          }
        }
        ti += 1;
      }
    }

    // ARM64-OOP: Instanz-Feldzugriff p.x — base = Objekt-Pointer, Offset aus p's Typ.
    var base: int64 := self.lowerExpr(baseNode);
    var ifOff: int64 := self._instanceFieldOffset(baseNode, self.nodeSVal(expr), self.nodeSLen(expr));
    if ifOff >= 0 {
      self.irAddInstrDirect(IRO_LOAD_FIELD, dest, base, ifOff, 0);
    }
    return dest;
  }
  
  // ------------------------------------------------------------------
  // Cast Lowering
  // ------------------------------------------------------------------
  
  fn lowerCast(expr: int64): int64 {
    // WP-F64: war STUB (dest uninitialisiert → Garbage bei `x as T`). Jetzt: f64↔int echt
    // konvertieren (FTOI/ITOF), gleiche Repräsentationsklasse = pass-through (int↔int, ptr-casts).
    var src: int64 := self.lowerExpr(self.nodeC0(expr));
    var tt: int64 := self.nodeC1(expr);
    var tgtF64: int64 := 0;
    if tt >= 0 { tgtF64 := self.seq(self.nodeSVal(tt), self.nodeSLen(tt), "f64", 3); }
    var srcF64: int64 := self._isF64Expr(self.nodeC0(expr));
    if tgtF64 != 0 {
      if srcF64 == 0 {
        var d1: int64 := self.allocTemp();
        self.irAddInstrDirect(IRO_ITOF, d1, src, -1, 0);   // int → f64
        return d1;
      }
      return src;   // f64 → f64
    }
    if srcF64 != 0 {
      var d2: int64 := self.allocTemp();
      self.irAddInstrDirect(IRO_FTOI, d2, src, -1, 0);     // f64 → int (Trunkierung)
      return d2;
    }
    return src;   // int → int / ptr-cast: gleiche Repräsentation, pass-through
  }
  
  // ------------------------------------------------------------------
  // New Expression Lowering
  // ------------------------------------------------------------------
  
  fn lowerNew(expr: int64): int64 {
    // ARM64-OOP: `new T()` → IRO_ALLOC(typeSize) → dest = Objekt-Pointer.
    // Typname = sVal des NK_NEW-Nodes (c0 = Konstruktor-Args, hier ignoriert).
    // Layout: plain structs/methodenlose Klassen Felder ab Offset 0.
    // WP-VMT-lyxos: Klassen MIT virtueller Methode reservieren Offset 0 für die type-id
    // (= NK_TYPE_DECL-Node-Index), Felder ab +8. new schreibt die type-id nach obj[0].
    var dest: int64 := self.allocTemp();
    // WP-XMOD-OOP: Typ über globales Registry auflösen (auch IMPORTIERTE Klassen) → korrekte
    // Größe/VMT/type-id. type-id = globaler Registry-Index g (modul-unabhängig, konsistent mit
    // virtueller Dispatch). Vorher: _findTypeDecl(cwd) → importierte Klasse = Default-Größe 8.
    var g: int64 := self._tregFind(self.nodeSVal(expr), self.nodeSLen(expr));
    var sz: int64 := 8;
    var hasVmt: int64 := 0;
    if g >= 0 {
      var tsz: int64 := self._tregSizeG(g);
      if tsz > 0 { sz := tsz; }
      hasVmt := self._tregHasVmtG(g);
      if hasVmt != 0 { sz := sz + 8; }   // type-id-Slot @ Offset 0
    }
    var szTemp: int64 := self.allocTemp();
    self.irAddInstrDirect(IRO_CONST_INT, szTemp, -1, -1, sz);
    self.irAddInstrDirect(IRO_ALLOC, dest, szTemp, -1, 0);
    if hasVmt != 0 {
      // type-id (= globaler Registry-Index g) nach obj[0] schreiben — Laufzeit-Typ für virtuelle Dispatch.
      var tidTemp: int64 := self.allocTemp();
      self.irAddInstrDirect(IRO_CONST_INT, tidTemp, -1, -1, g);
      self.irAddInstrDirect(IRO_STORE_FIELD, 0, tidTemp, dest, 0);   // STORE_FIELD(off=0, value=tid, base=obj)
    }
    // WP-CTOR-lyxos: Konstruktor `ClassName_Create(self, args...)` aufrufen falls definiert
    // (Konvention wie ELF codegen_x86 #683). Vorher wurden Konstruktor-Args ignoriert →
    // new C(11) ließ Felder 0. Args = NK_NEW.c0-Chain; self = neues Objekt @ argBase[0].
    var ccName: pchar := "Create"c;
    var ctorMang: int64 := self._methodMangle(self.nodeSVal(expr), self.nodeSLen(expr), ccName, 6);
    var ctorLen:  int64 := self.nodeSLen(expr) + 1 + 6;
    var ctorIdx:  int64 := self._findFuncByName(ctorMang as pchar, ctorLen);
    if ctorIdx >= 0 {
      var cArgBase: int64 := self.tempCount;
      var cRsv: int64 := 0; while cRsv < 8 { self.allocTemp(); cRsv := cRsv + 1; }
      self.irAddInstrDirect(IRO_STORE_LOCAL, cArgBase, dest, -1, 0);   // self = neues Objekt
      var cCnt: int64 := 1;
      var cArg: int64 := self.nodeC0(expr);
      while cArg >= 0 {
        var cT: int64 := self.lowerExpr(cArg);
        self.irAddInstrDirect(IRO_STORE_LOCAL, cArgBase + cCnt, cT, -1, 0);
        cCnt += 1;
        cArg := self.nodeNext(cArg);
      }
      var ctorRes: int64 := self.allocTemp();
      self.irAddInstrDirect(IRO_CALL, ctorRes, ctorIdx, cArgBase, cCnt);
    }
    return dest;
  }
  
  // ------------------------------------------------------------------
  // Range Expression Lowering
  // ------------------------------------------------------------------
  
  fn lowerRange(expr: int64): int64 {
    var lo: int64 := self.lowerExpr(self.nodeC0(expr));
    var hi: int64 := self.lowerExpr(self.nodeC1(expr));
    var dest: int64 := self.allocTemp();
    
    // Emit range construction
    return dest;
  }
  
  // ------------------------------------------------------------------
  // Statement Lowering
  // ------------------------------------------------------------------
  
  // WSP-05: Inhalt eines asm-String-Literals (zwischen Quotes) == Mnemonic m?
  fn _asmInnerEq(child: int64, m: pchar, mlen: int64): int64 {
    var sp: int64 := self.nodeSVal(child) as int64;
    var sl: int64 := self.nodeSLen(child);
    var inner: int64 := 1;                       // sp[0] = '"'
    while (inner < sl && peek8(sp + inner) != 34) { inner := inner + 1; }
    if (inner - 1 != mlen) { return 0; }
    return self.seq((sp + 1) as pchar, mlen, m, mlen);
  }
  // WSP-05: Mnemonic-String → arch-spezifische asmId. Die Id-Tabelle ist PRO
  // Ziel-Architektur getrennt (0-basiert je Familie) und MUSS exakt mit dem
  // IRO_ASM-Decode im jeweiligen Backend übereinstimmen. -1 = unbekannt/nicht
  // unterstützt (harter Compile-Fehler im Aufrufer). Ein Backend läuft immer nur
  // für seine Architektur, daher sind die überlappenden Id-Werte kollisionsfrei.
  fn _asmMnemonicId(child: int64): int64 {
    var t: int64 := self.target;

    // --- x86-Familie (X86_64=1, MACOS_X86=5, WIN_X86=6, ANDROID_X86=13, LYXOS=14, Default=0) ---
    // Konsument: emit_lyxos.lyx op==167 (und AST-Pfad codegen_x86.cg_genAsm für ELF/macos/win-x86).
    if t == 0 || t == 1 || t == 5 || t == 6 || t == 13 || t == 14 {
      if self._asmInnerEq(child, "cli"c, 3)    { return 0; }
      if self._asmInnerEq(child, "sti"c, 3)    { return 1; }
      if self._asmInnerEq(child, "hlt"c, 3)    { return 2; }
      if self._asmInnerEq(child, "nop"c, 3)    { return 3; }
      if self._asmInnerEq(child, "pause"c, 5)  { return 4; }
      if self._asmInnerEq(child, "cpuid"c, 5)  { return 5; }
      if self._asmInnerEq(child, "iretq"c, 5)  { return 6; }
      if self._asmInnerEq(child, "wbinvd"c, 6) { return 7; }
      if self._asmInnerEq(child, "invd"c, 4)   { return 8; }
      if self._asmInnerEq(child, "sfence"c, 6) { return 9; }
      if self._asmInnerEq(child, "lfence"c, 6) { return 10; }
      if self._asmInnerEq(child, "mfence"c, 6) { return 11; }
      if self._asmInnerEq(child, "rdtsc"c, 5)  { return 12; }
      if self._asmInnerEq(child, "ud2"c, 3)    { return 13; }
      if self._asmInnerEq(child, "int3"c, 4)   { return 14; }
      if self._asmInnerEq(child, "leave"c, 5)  { return 15; }
      if self._asmInnerEq(child, "ret"c, 3)    { return 16; }
      if self._asmInnerEq(child, "lgdt [rdi]"c, 10)   { return 17; }
      if self._asmInnerEq(child, "lidt [rdi]"c, 10)   { return 18; }
      if self._asmInnerEq(child, "invlpg [rdi]"c, 12) { return 19; }
      return 0 - 1;
    }

    // --- ARM64/AArch64-Familie (ARM64=2, MACOS_ARM64=7, WIN_ARM64=8, ANDROID_ARM64=12) ---
    // Konsument: backend/arm64/emit_arm64.lyx op==167.
    if t == 2 || t == 7 || t == 8 || t == 12 {
      if self._asmInnerEq(child, "nop"c, 3)   { return 0; }
      if self._asmInnerEq(child, "wfi"c, 3)   { return 1; }
      if self._asmInnerEq(child, "wfe"c, 3)   { return 2; }
      if self._asmInnerEq(child, "sev"c, 3)   { return 3; }
      if self._asmInnerEq(child, "sevl"c, 4)  { return 4; }
      if self._asmInnerEq(child, "yield"c, 5) { return 5; }
      if self._asmInnerEq(child, "isb"c, 3)   { return 6; }
      if self._asmInnerEq(child, "dsb"c, 3)   { return 7; }
      if self._asmInnerEq(child, "dmb"c, 3)   { return 8; }
      if self._asmInnerEq(child, "svc"c, 3)   { return 9; }
      if self._asmInnerEq(child, "brk"c, 3)   { return 10; }
      if self._asmInnerEq(child, "hlt"c, 3)   { return 11; }
      if self._asmInnerEq(child, "ret"c, 3)   { return 12; }
      if self._asmInnerEq(child, "eret"c, 4)  { return 13; }
      return 0 - 1;
    }

    // --- ARM Cortex-M / Thumb-2 (ARM_CM=4, ARM_CM4=10) ---
    // Konsument: backend/arm_cm_backend.lyx op==167.
    if t == 4 || t == 10 {
      if self._asmInnerEq(child, "nop"c, 3)     { return 0; }
      if self._asmInnerEq(child, "wfi"c, 3)     { return 1; }
      if self._asmInnerEq(child, "wfe"c, 3)     { return 2; }
      if self._asmInnerEq(child, "sev"c, 3)     { return 3; }
      if self._asmInnerEq(child, "yield"c, 5)   { return 4; }
      if self._asmInnerEq(child, "isb"c, 3)     { return 5; }
      if self._asmInnerEq(child, "dsb"c, 3)     { return 6; }
      if self._asmInnerEq(child, "dmb"c, 3)     { return 7; }
      if self._asmInnerEq(child, "svc"c, 3)     { return 8; }
      if self._asmInnerEq(child, "bkpt"c, 4)    { return 9; }
      if self._asmInnerEq(child, "cpsid i"c, 7) { return 10; }
      if self._asmInnerEq(child, "cpsie i"c, 7) { return 11; }
      return 0 - 1;
    }

    // --- RISC-V (RISCV64=3, LINUX_RISCV64=9) ---
    // Konsument: backend/riscv_linux.lyx op==167.
    if t == 3 || t == 9 {
      if self._asmInnerEq(child, "nop"c, 3)     { return 0; }
      if self._asmInnerEq(child, "wfi"c, 3)     { return 1; }
      if self._asmInnerEq(child, "fence"c, 5)   { return 2; }
      if self._asmInnerEq(child, "fence.i"c, 7) { return 3; }
      if self._asmInnerEq(child, "ecall"c, 5)   { return 4; }
      if self._asmInnerEq(child, "ebreak"c, 6)  { return 5; }
      if self._asmInnerEq(child, "mret"c, 4)    { return 6; }
      if self._asmInnerEq(child, "sret"c, 4)    { return 7; }
      return 0 - 1;
    }

    // --- Xtensa (XTENSA=11) — nur `nop` ist gegen die Backend-Byte-Konvention
    // verifizierbar (xt_NOP); alle anderen Mnemonics sind hier bewusst nicht
    // unterstützt statt potentiell falsche Bytes zu emittieren. ---
    if t == 11 {
      if self._asmInnerEq(child, "nop"c, 3) { return 0; }
      return 0 - 1;
    }

    return 0 - 1;
  }

  fn lowerStmt(stmt: int64) {
    if (stmt < 0) { return; }

    // WP-BC-44: update source line for --ir-source-map
    poke64(self.ir + IR_MOD_OFF_CURSRCLINE, self._lineOf(stmt));  // curSrcLine at +160
    // WP-BC-47: update current AST node for --provenance
    poke64(self.ir + IR_MOD_OFF_CURASTNODE, stmt);  // curAstNode at +192

    var k: int64 := self.nodeKind(stmt);

    if (k == NK_BLOCK) {
      self.lowerBlock(stmt);
    }
    else if (k == NK_ASM) {
      // WSP-05: jede Mnemonic → IRO_ASM(imm=asmId). Unbekannt = harter Fehler.
      var ac: int64 := self.nodeC0(stmt);
      while (ac >= 0) {
        var aid: int64 := self._asmMnemonicId(ac);
        if aid < 0 {
          Print("lyxc: asm: unbekannte/nicht-unterstuetzte Mnemonic fuer Ziel-Architektur\n"c);
          exit(1);
        }
        self.irAddInstrDirect(IRO_ASM, 0, -1, -1, aid);
        ac := self.nodeNext(ac);
      }
    }
    else if (k == NK_IF) {
      self.lowerIf(stmt); 
    }
    else if (k == NK_WHILE) {
      self.lowerWhile(stmt);
    }
    else if (k == NK_REPEAT_UNTIL) {
      self.lowerRepeatUntil(stmt);
    }
    else if (k == NK_TUPLE_VAR_DECL) {
      self.lowerTupleVarDecl(stmt);
    }
    else if (k == NK_FOR) {
      self.lowerRangeFor(stmt);
    }
    else if (k == NK_FOR_RANGE) {
      self.lowerCallRange(stmt);
    }
    else if (k == NK_FOR_C) {
      self.lowerFor(stmt);
    }
    else if (k == NK_RETURN) {
      self.lowerReturn(stmt);
    }
    else if (k == NK_DEFER) {
      // WP-2.2-B: push the deferred statement onto the scope stack
      var inner: int64 := self.nodeC0(stmt);
      if (inner >= 0) {
        if (self.deferCount >= self.deferCap) {
          var dc: int64 := self.deferCap * 2;
          var db: int64 := alloc(dc * 8);
          var di: int64 := 0;
          memcpy(db, self.deferBuf, self.deferCount * 8);
          free(self.deferBuf, self.deferCap * 8);
          self.deferBuf := db; self.deferCap := dc;
        }
        poke64(self.deferBuf + self.deferCount * 8, inner);
        self.deferCount += 1;
      }
    }
    else if (k == NK_EXPR_STMT) { 
      var expr: int64 := self.nodeC0(stmt); 
      if (expr >= 0) { self.lowerExpr(expr); } 
    }
    else if (k == NK_ASSIGN) { 
      self.lowerAssign(stmt); 
    }
    else if (k == NK_BREAK) { 
      self.lowerBreak(stmt); 
    }
    else if (k == NK_CONTINUE) { 
      self.lowerContinue(stmt); 
    }
    else if (k == NK_DISPOSE) { 
      self.lowerDispose(stmt); 
    }
    else if (k == NK_THROW) { 
      self.lowerThrow(stmt); 
    }
    else if (k == NK_TRY) { 
      self.lowerTryStmt(stmt); 
    }
    else if (k == NK_SWITCH) { 
      self.lowerSwitch(stmt); 
    }
    else if (k == NK_DISPOSE) {
      self.lowerDispose(stmt);
    }
    // WP-BC-07: assert(cond) → IRO_ASSERT_TRUE
    else if (k == NK_ASSERT) {
      var condNode: int64 := self.nodeC0(stmt);
      if (condNode >= 0) {
        var condTemp: int64 := self.lowerExpr(condNode);
        self.irAddInstrDirect(IRO_ASSERT_TRUE, -1, condTemp, -1, 0);
      }
    }
    // WP-BC-09: pool { stmt* }
    else if (k == NK_POOL) {
      self.lowerPool(stmt);
    }
    // WP-BC-10: panic(msg) → IRO_PANIC
    else if (k == NK_PANIC) {
      self.lowerPanic(stmt);
    }
    // WP-AND-upstream-fix v4: `var x: T := expr;` inside a function body.
    // Allocate a slot, lower the init expression, store into the slot, and
    // record name->slot in localNameBuf so subsequent NK_IDENT lookups can
    // find it. Inline (no helper method) for vtable stability.
    else if (k == NK_VAR_DECL) {
      var vdSlot: int64 := self.allocTemp();
      // WP-VOLATILE: @volatile-Local (Parser-Flag VAR_FLAG_VOLATILE=1) → Slot vormerken,
      // damit dessen LOAD_LOCAL nicht von DCE eliminiert wird (MMIO/Hardware-Register).
      if (self.nodeIVal(stmt) & 1) != 0 {
        if self._volSlotN < 256 { poke64(self._volSlotList + self._volSlotN * 8, vdSlot); self._volSlotN := self._volSlotN + 1; }
      }
      var vdInit: int64 := self.nodeC1(stmt);
      if vdInit >= 0 {
        var vdTemp: int64 := self.lowerExpr(vdInit);
        self.irAddInstrDirect(IRO_STORE_LOCAL, vdSlot, vdTemp, -1, 0);
      } else {
        // ARM64-FIX: `var a: [N]T` ohne Init → Heap-Storage allozieren, vdSlot = Pointer
        // (wie x86 codegen). 8 Byte/Element (emitLoadIdx/StoreIdx nutzen LSL#3).
        var vdType: int64 := self.nodeC0(stmt);
        if vdType >= 0 && self.nodeKind(vdType) == NK_TYPE_ARRAY_FIXED {
          var vdSzNode: int64 := self.nodeC1(vdType);
          var vdN: int64 := 0;
          if vdSzNode >= 0 && self.nodeKind(vdSzNode) == NK_LIT_INT {
            vdN := self.nodeIVal(vdSzNode);
          }
          if vdN > 0 {
            var vdSzTemp: int64 := self.allocTemp();
            self.irAddInstrDirect(IRO_CONST_INT, vdSzTemp, -1, -1, vdN * 8);
            // WP-ALIGN: @align(n) → Boundary aus iv-Bits 8+ (n direkt gespeichert); imm der ALLOC.
            var vdAlign: int64 := (self.nodeIVal(stmt) >> 8) & 0xFFFFFF;
            self.irAddInstrDirect(IRO_ALLOC, vdSlot, vdSzTemp, -1, vdAlign);
          }
        }
      }
      // Register name -> slot. Grow the buffer geometrically if full.
      if self.localNameCnt >= self.localNameCap {
        var vdNewCap: int64 := self.localNameCap * 2;
        var vdNb: int64 := alloc(vdNewCap * 24);
        var vdI: int64 := 0;
        memcpy(vdNb, self.localNameBuf, self.localNameCnt * 24);
        self.localNameBuf := vdNb;
        // ARM64-OOP: localTypeBuf parallel mit-growen.
        var vdTb: int64 := alloc(vdNewCap * 8);
        memcpy(vdTb, self.localTypeBuf, self.localNameCnt * 8);
        self.localTypeBuf := vdTb;
        self.localNameCap := vdNewCap;
      }
      var vdRec: int64 := self.localNameBuf + self.localNameCnt * 24;
      poke64(vdRec +  0, peek64(self.nodeOff(stmt) + NODE_OFF_SVAL));  // src nameOff
      poke64(vdRec +  8, self.nodeSLen(stmt));
      poke64(vdRec + LOCAL_REC_OFF_SLOT, vdSlot);
      // ARM64-OOP: Typ-Node des Locals merken (nodeC0 = Typ; -1 wenn keiner).
      poke64(self.localTypeBuf + self.localNameCnt * 8, self.nodeC0(stmt));
      self.localNameCnt += 1;
    }
    // Try/Catch/Finally handled in lowering blocks
  }
  
  // ------------------------------------------------------------------
  // Block Lowering
  // ------------------------------------------------------------------
  
  fn lowerBlock(block: int64) {
    // WP-2.2-B: save the defer-stack depth for this scope
    var scopeStart: int64 := self.deferCount;
    var stmt: int64 := self.nodeC0(block);
    if (stmt < 0) {
      // empty block — still need to restore scope (no defers to emit)
      self.deferCount := scopeStart;
      return;
    }
    while (stmt >= 0) {
      self.lowerStmt(stmt);
      stmt := self.nodeNext(stmt);
    }
    // WP-2.2-B: emit this block's deferred stmts in LIFO order (normal exit path)
    var di: int64 := self.deferCount - 1;
    while (di >= scopeStart) {
      var defNode: int64 := peek64(self.deferBuf + di * 8);
      self.lowerStmt(defNode);
      di -= 1;
    }
    // Pop this scope's entries from the stack
    self.deferCount := scopeStart;
  }
  
  // ------------------------------------------------------------------
  // If Statement Lowering
  // ------------------------------------------------------------------
  
  fn lowerIf(stmt: int64) {
    var cond: int64 := self.nodeC0(stmt);
    var condTemp: int64 := self.lowerExpr(cond);

    var elseLbl: int64 := self.genLabel();
    var endLbl: int64 := self.genLabel();

    // if not condTemp goto elseLbl
    self.irEmitBrFalse(condTemp, elseLbl);

    // Then block
    if (self.nodeC1(stmt) >= 0) {
      self.lowerBlock(self.nodeC1(stmt));
    }

    // goto endLbl (skip else)
    self.irEmitJmp(endLbl);

    // elseLbl:
    self.irEmitLabel(elseLbl);

    // Else block
    if (self.nodeC2(stmt) >= 0) {
      self.lowerBlock(self.nodeC2(stmt));
    }

    // endLbl:
    self.irEmitLabel(endLbl);
  }
  
  // ------------------------------------------------------------------
  // While Statement Lowering
  // ------------------------------------------------------------------
  
  fn lowerWhile(stmt: int64) {
    var loopLbl: int64 := self.genLabel();
    var exitLbl: int64 := self.genLabel();

    // Save outer loop labels
    var savedExit: int64 := self.loopExitLabel;
    var savedCont: int64 := self.loopContLabel;

    self.loopExitLabel := exitLbl;
    self.loopContLabel := loopLbl;

    // loopLbl:
    self.irEmitLabel(loopLbl);

    // Condition
    var cond: int64 := self.nodeC0(stmt);
    var condTemp: int64 := self.lowerExpr(cond);

    // if not condTemp goto exitLbl
    self.irEmitBrFalse(condTemp, exitLbl);

    // Loop body
    if (self.nodeC1(stmt) >= 0) {
      self.lowerBlock(self.nodeC1(stmt));
    }

    // goto loopLbl
    self.irEmitJmp(loopLbl);

    // exitLbl:
    self.irEmitLabel(exitLbl);

    // Restore outer loop labels
    self.loopExitLabel := savedExit;
    self.loopContLabel := savedCont;
  }
  
  // ------------------------------------------------------------------
  // Repeat..Until Statement Lowering  (WP-BC-04)
  // ------------------------------------------------------------------
  // repeat { body } until (cond)
  // Executes body first, then checks cond; loops while cond is false.
  // Layout:
  //   loopLbl:  [body]  contLbl:  condTemp = cond  brFalse contLbl → loopLbl  exitLbl:

  fn lowerRepeatUntil(stmt: int64) {
    var loopLbl: int64 := self.genLabel();
    var contLbl: int64 := self.genLabel();
    var exitLbl: int64 := self.genLabel();

    var savedExit: int64 := self.loopExitLabel;
    var savedCont: int64 := self.loopContLabel;
    self.loopExitLabel := exitLbl;
    self.loopContLabel := contLbl;

    self.irEmitLabel(loopLbl);

    if (self.nodeC0(stmt) >= 0) {
      self.lowerBlock(self.nodeC0(stmt));
    }

    // contLbl: continue jumps to condition evaluation
    self.irEmitLabel(contLbl);

    var cond: int64 := self.nodeC1(stmt);
    var condTemp: int64 := self.lowerExpr(cond);

    // if cond is false → loop back to loopLbl
    self.irEmitBrFalse(condTemp, loopLbl);

    self.irEmitLabel(exitLbl);

    self.loopExitLabel := savedExit;
    self.loopContLabel := savedCont;
  }

  // ------------------------------------------------------------------
  // Tuple VarDecl Lowering  (WP-BC-05)
  // ------------------------------------------------------------------
  // var a, b := fn()  — lower init expr (call), results in rax+rdx

  fn lowerTupleVarDecl(stmt: int64) {
    // var firstName, secondName := initExpr
    // firstName = sval/slen on the node; secondName = c0 (NK_IDENT).
    // LX-21: on lyxos, SYSCALL sets rax=error, rdx=value.
    //   IRO_CALL_BUILTIN stores rdx (value) → valSlot.
    //   IRO_LOAD_ERRVAL  reads rax shadow (r15) → errSlot.

    var valSlot: int64 := self.allocTemp();

    // Determine second name — is it discard ("_")?
    var secondNode: int64 := self.nodeC0(stmt);
    var errSlot: int64 := -1;
    if secondNode >= 0 {
      var sLen2: int64 := self.nodeSLen(secondNode);
      var sAddr2: int64 := self.nodeSVal(secondNode) as int64;
      var isDiscard: bool := sLen2 == 1 && peek8(sAddr2) == 95;
      if !isDiscard {
        errSlot := self.allocTemp();
      }
    }

    // Lower init expression → temp slot (val)
    var initExpr: int64 := self.nodeC1(stmt);
    if initExpr >= 0 {
      var initTemp: int64 := self.lowerExpr(initExpr);
      self.irAddInstrDirect(IRO_STORE_LOCAL, valSlot, initTemp, -1, 0);
      if errSlot >= 0 {
        self.irAddInstrDirect(IRO_LOAD_ERRVAL, errSlot, 0, -1, 0);
      }
    }

    // Register firstName → valSlot
    if self.localNameCnt >= self.localNameCap {
      var tvNewCap: int64 := self.localNameCap * 2;
      var tvNb: int64 := alloc(tvNewCap * 24);
      memcpy(tvNb, self.localNameBuf, self.localNameCnt * 24);
      self.localNameBuf := tvNb;
      self.localNameCap := tvNewCap;
    }
    var tvRec1: int64 := self.localNameBuf + self.localNameCnt * 24;
    poke64(tvRec1 + 0, peek64(self.nodeOff(stmt) + NODE_OFF_SVAL));
    poke64(tvRec1 + 8, self.nodeSLen(stmt));
    poke64(tvRec1 + LOCAL_REC_OFF_SLOT, valSlot);
    self.localNameCnt += 1;

    // Register secondName → errSlot (only if not discard)
    if errSlot >= 0 {
      if self.localNameCnt >= self.localNameCap {
        var tvNewCap2: int64 := self.localNameCap * 2;
        var tvNb2: int64 := alloc(tvNewCap2 * 24);
        memcpy(tvNb2, self.localNameBuf, self.localNameCnt * 24);
        self.localNameBuf := tvNb2;
        self.localNameCap := tvNewCap2;
      }
      var tvRec2: int64 := self.localNameBuf + self.localNameCnt * 24;
      poke64(tvRec2 + 0, peek64(self.nodeOff(secondNode) + NODE_OFF_SVAL));
      poke64(tvRec2 + 8, self.nodeSLen(secondNode));
      poke64(tvRec2 + LOCAL_REC_OFF_SLOT, errSlot);
      self.localNameCnt += 1;
    }
  }

  // ------------------------------------------------------------------
  // For Statement Lowering
  // ------------------------------------------------------------------

  fn lowerRangeFor(stmt: int64) {
    // for VAR := start to/downto end [do] { body }
    // sOff/sLen = var name, c0 = start expr, c1 = end expr, c2 = body, iVal = dir (0=to,1=downto)
    var varSlot: int64 := self.allocTemp();

    // Register var name → slot in localNameBuf
    if self.localNameCnt >= self.localNameCap {
      var rfNewCap: int64 := self.localNameCap * 2;
      var rfNb: int64 := alloc(rfNewCap * 24);
      var rfI: int64 := 0;
      memcpy(rfNb, self.localNameBuf, self.localNameCnt * 24);
      self.localNameBuf := rfNb;
      self.localNameCap := rfNewCap;
    }
    var rfRec: int64 := self.localNameBuf + self.localNameCnt * 24;
    poke64(rfRec +  0, peek64(self.nodeOff(stmt) + NODE_OFF_SVAL));
    poke64(rfRec +  8, self.nodeSLen(stmt));
    poke64(rfRec + LOCAL_REC_OFF_SLOT, varSlot);
    self.localNameCnt += 1;

    // Init: varSlot = start
    var startTemp: int64 := self.lowerExpr(self.nodeC0(stmt));
    self.irAddInstrDirect(IRO_STORE_LOCAL, varSlot, startTemp, -1, 0);

    var loopLbl: int64 := self.genLabel();
    var contLbl: int64 := self.genLabel();
    var exitLbl: int64 := self.genLabel();

    var savedExit: int64 := self.loopExitLabel;
    var savedCont: int64 := self.loopContLabel;
    self.loopExitLabel := exitLbl;
    self.loopContLabel := contLbl;

    // loopLbl:
    self.irEmitLabel(loopLbl);

    // Condition: load var, load limit, compare
    var varTemp: int64 := self.allocTemp();
    self.irAddInstrDirect(IRO_LOAD_LOCAL, varTemp, varSlot, -1, 0);
    var limitTemp: int64 := self.lowerExpr(self.nodeC1(stmt));
    var condTemp: int64 := self.allocTemp();
    var dir: int64 := self.nodeIVal(stmt);
    if (dir == 0) {
      self.irAddInstrDirect(IRO_CMP_LE, condTemp, varTemp, limitTemp, 0);
    } else {
      self.irAddInstrDirect(IRO_CMP_GE, condTemp, varTemp, limitTemp, 0);
    }
    self.irEmitBrFalse(condTemp, exitLbl);

    // Body
    if (self.nodeC2(stmt) >= 0) { self.lowerBlock(self.nodeC2(stmt)); }

    // contLbl:
    self.irEmitLabel(contLbl);

    // Step: var := var +/- 1
    var curTemp: int64 := self.allocTemp();
    self.irAddInstrDirect(IRO_LOAD_LOCAL, curTemp, varSlot, -1, 0);
    var oneTemp: int64 := self.allocTemp();
    self.irAddInstrDirect(IRO_CONST_INT, oneTemp, -1, -1, 1);
    var nextTemp: int64 := self.allocTemp();
    if (dir == 0) {
      self.irAddInstrDirect(IRO_ADD, nextTemp, curTemp, oneTemp, 0);
    } else {
      self.irAddInstrDirect(IRO_SUB, nextTemp, curTemp, oneTemp, 0);
    }
    self.irAddInstrDirect(IRO_STORE_LOCAL, varSlot, nextTemp, -1, 0);

    // goto loopLbl
    self.irEmitJmp(loopLbl);

    // exitLbl:
    self.irEmitLabel(exitLbl);

    self.loopExitLabel := savedExit;
    self.loopContLabel := savedCont;
  }

  // WP-1.1-A: for i in range(start, stop) — stop is exclusive (IRO_CMP_LT)
  fn lowerCallRange(stmt: int64) {
    var varSlot: int64 := self.allocTemp();
    if self.localNameCnt >= self.localNameCap {
      var crNewCap: int64 := self.localNameCap * 2;
      var crNb: int64 := alloc(crNewCap * 24);
      var crI: int64 := 0;
      memcpy(crNb, self.localNameBuf, self.localNameCnt * 24);
      self.localNameBuf := crNb;
      self.localNameCap := crNewCap;
    }
    var crRec: int64 := self.localNameBuf + self.localNameCnt * 24;
    poke64(crRec +  0, peek64(self.nodeOff(stmt) + NODE_OFF_SVAL));
    poke64(crRec +  8, self.nodeSLen(stmt));
    poke64(crRec + LOCAL_REC_OFF_SLOT, varSlot);
    self.localNameCnt += 1;

    var crStart: int64 := self.lowerExpr(self.nodeC0(stmt));
    self.irAddInstrDirect(IRO_STORE_LOCAL, varSlot, crStart, -1, 0);

    var crLoop: int64 := self.genLabel();
    var crCont: int64 := self.genLabel();
    var crExit: int64 := self.genLabel();
    var crSavedExit: int64 := self.loopExitLabel;
    var crSavedCont: int64 := self.loopContLabel;
    self.loopExitLabel := crExit;
    self.loopContLabel := crCont;

    self.irEmitLabel(crLoop);
    var crVar: int64 := self.allocTemp();
    self.irAddInstrDirect(IRO_LOAD_LOCAL, crVar, varSlot, -1, 0);
    var crLimit: int64 := self.lowerExpr(self.nodeC1(stmt));
    var crCond: int64 := self.allocTemp();
    self.irAddInstrDirect(IRO_CMP_LT, crCond, crVar, crLimit, 0);
    self.irEmitBrFalse(crCond, crExit);

    if (self.nodeC2(stmt) >= 0) { self.lowerBlock(self.nodeC2(stmt)); }

    self.irEmitLabel(crCont);
    var crCur: int64 := self.allocTemp();
    self.irAddInstrDirect(IRO_LOAD_LOCAL, crCur, varSlot, -1, 0);
    var crOne: int64 := self.allocTemp();
    self.irAddInstrDirect(IRO_CONST_INT, crOne, -1, -1, 1);
    var crNext: int64 := self.allocTemp();
    self.irAddInstrDirect(IRO_ADD, crNext, crCur, crOne, 0);
    self.irAddInstrDirect(IRO_STORE_LOCAL, varSlot, crNext, -1, 0);
    self.irEmitJmp(crLoop);

    self.irEmitLabel(crExit);
    self.loopExitLabel := crSavedExit;
    self.loopContLabel := crSavedCont;
  }

  fn lowerFor(stmt: int64) {
    // C-style for loop:
    // C0: init (assign or var decl)
    // C1: condition
    // C2: step
    // C3: body

    var loopLbl: int64 := self.genLabel();
    var contLbl: int64 := self.genLabel();  // continue target: before step
    var exitLbl: int64 := self.genLabel();

    var savedExit: int64 := self.loopExitLabel;
    var savedCont: int64 := self.loopContLabel;

    self.loopExitLabel := exitLbl;
    self.loopContLabel := contLbl;

    // Init (C0)
    var init: int64 := self.nodeC0(stmt);
    if (init >= 0) { self.lowerStmt(init); }

    // loopLbl:
    self.irEmitLabel(loopLbl);

    // Condition (C1)
    var cond: int64 := self.nodeC1(stmt);
    if (cond >= 0) {
      var condTemp: int64 := self.lowerExpr(cond);
      self.irEmitBrFalse(condTemp, exitLbl);
    }

    // Body (C3)
    var body: int64 := self.nodeC3(stmt);
    if (body >= 0) { self.lowerBlock(body); }

    // contLbl: (continue lands here, then executes step)
    self.irEmitLabel(contLbl);

    // Step (C2)
    var step: int64 := self.nodeC2(stmt);
    if (step >= 0) { self.lowerStmt(step); }

    // goto loopLbl
    self.irEmitJmp(loopLbl);

    // exitLbl:
    self.irEmitLabel(exitLbl);

    self.loopExitLabel := savedExit;
    self.loopContLabel := savedCont;
  }
  
  // ------------------------------------------------------------------
  // Return Statement Lowering
  // ------------------------------------------------------------------
  
  fn lowerReturn(stmt: int64) {
    var retVal: int64 := self.nodeC0(stmt);
    if (retVal >= 0) {
      var retTemp: int64 := self.lowerExpr(retVal);
      self.irAddInstrDirect(IRO_STORE_LOCAL, self.retValTemp, retTemp, -1, 0);
    }
    // WP-2.2-B: on early return, emit ALL accumulated deferred stmts (entire stack)
    // in LIFO order — covers all enclosing scopes up to the function boundary.
    var ri: int64 := self.deferCount - 1;
    while (ri >= 0) {
      var defNode: int64 := peek64(self.deferBuf + ri * 8);
      self.lowerStmt(defNode);
      ri -= 1;
    }
    self.irEmitJmp(self.funcExitLabel);
  }
  
  // ------------------------------------------------------------------
  // Assignment Lowering
  // ------------------------------------------------------------------
  
  fn lowerAssign(stmt: int64) {
    var target: int64 := self.nodeC0(stmt);
    var val: int64 := self.nodeC1(stmt);
    
    if (target >= 0 && val >= 0) {
      var valTemp: int64 := self.lowerExpr(val);

      // Target is IDENT — store to local variable or parameter slot.
      // ARM64-FIX: war Stub (kein Store emittiert) → Assignments waren no-ops,
      // while-Schleifen liefen endlos. Slot-Resolution spiegelt den Read-Pfad
      // (NK_IDENT in lowerExpr): erst localNameBuf (latest-first/shadowing), dann Params.
      if (self.nodeKind(target) == NK_IDENT) {
        if self.curFunc >= 0 {
          var idName: pchar := self.nodeSVal(target);
          var idLen:  int64 := self.nodeSLen(target);
          var idPtrL: int64 := (idName) as int64;
          var slot:   int64 := 0 - 1;
          var lnI:    int64 := self.localNameCnt - 1;
          while lnI >= 0 {
            if slot < 0 {
              var lnRec:    int64 := self.localNameBuf + lnI * 24;
              var lnLen:    int64 := peek64(lnRec + LOCAL_REC_OFF_NAMELEN);
              if lnLen == idLen {
                var lnNameOff: int64 := peek64(lnRec + 0);
                var lnPtr:     int64 := (self.src as int64) + lnNameOff;
                var lnMatch:   int64 := 1;
                var lnJ:       int64 := 0;
                while lnJ < idLen {
                  if lnMatch != 0 {
                    if peek8(lnPtr + lnJ) != peek8(idPtrL + lnJ) { lnMatch := 0; }
                  }
                  lnJ += 1;
                }
                if lnMatch != 0 { slot := peek64(lnRec + LOCAL_REC_OFF_SLOT); }
              }
            }
            lnI -= 1;
          }
          if slot < 0 {
            var pnode: int64 := self.nodeC0(self.curFunc);
            var pidx:  int64 := 0;
            while pnode >= 0 {
              if self.nodeKind(pnode) == NK_PARAM {
                if slot < 0 {
                  var pnLen: int64 := self.nodeSLen(pnode);
                  if pnLen == idLen {
                    var pnPtr:  int64 := (self.nodeSVal(pnode)) as int64;
                    var pmatch: int64 := 1;
                    var pj:     int64 := 0;
                    while pj < idLen {
                      if pmatch != 0 {
                        if peek8(pnPtr + pj) != peek8(idPtrL + pj) { pmatch := 0; }
                      }
                      pj += 1;
                    }
                    if pmatch != 0 { slot := pidx; }
                  }
                }
                pidx += 1;
              }
              pnode := self.nodeNext(pnode);
            }
          }
          if slot >= 0 {
            self.irAddInstrDirect(IRO_STORE_LOCAL, slot, valTemp, -1, 0);
          } else {
            // ARM64-FIX: kein local/param → global suchen (globalNameBuf) und
            // IRO_STORE_GLOBAL(gIdx, value) emittieren. Sonst war `g := x` für
            // module-scope Globals ein no-op (Write persistierte nicht).
            var asgGI: int64 := 0;
            var asgFound: int64 := 0 - 1;
            while asgGI < self.globalNameCnt {
              if asgFound < 0 {
                var asgRec:  int64 := self.globalNameBuf + asgGI * 32;
                var asgLen:  int64 := peek64(asgRec + GLOBAL_REC_OFF_NAMELEN);
                if asgLen == idLen {
                  var asgOff:  int64 := peek64(asgRec + 0);
                  var asgPtr:  int64 := peek64(self.ir + IR_MOD_OFF_STRBUF) + asgOff;
                  var asgM:    int64 := 1;
                  var asgJ:    int64 := 0;
                  while asgJ < idLen {
                    if asgM != 0 {
                      if peek8(asgPtr + asgJ) != peek8(idPtrL + asgJ) { asgM := 0; }
                    }
                    asgJ += 1;
                  }
                  if asgM != 0 { asgFound := peek64(asgRec + GLOBAL_REC_OFF_IDX); }
                }
              }
              asgGI += 1;
            }
            if asgFound >= 0 {
              self.irAddInstrDirect(IRO_STORE_GLOBAL, asgFound, valTemp, -1, 0);
            }
          }
        }
      }
      // Target is FIELD — ARM64-OOP: p.x := v → IRO_STORE_FIELD(value, base, fieldOff).
      else if (self.nodeKind(target) == NK_FIELD) {
        var afBase: int64 := self.lowerExpr(self.nodeC0(target));
        var afOff:  int64 := self._instanceFieldOffset(self.nodeC0(target), self.nodeSVal(target), self.nodeSLen(target));
        // B2: method-typed Feld + RHS = method-Referenz (obj2.Method) → fat pointer {code,data}.
        if (afOff >= 0 && self.nodeKind(val) == NK_FIELD
            && self._fieldIsMethodType(self.nodeC0(target), self.nodeSVal(target), self.nodeSLen(target)) != 0) {
          var afFat: int64 := self._lowerMethodRef(val);
          self.irAddInstrDirect(IRO_STORE_FIELD, afOff, afFat, afBase, 0);
        } else if (afOff >= 0) {
          self.irAddInstrDirect(IRO_STORE_FIELD, afOff, valTemp, afBase, 0);
        }
      }
      // Target is INDEX — store to array element. ARM64-FIX: war Stub.
      // IRO_STORE_IDX: src1=value, src2=base, dest=idx (emitStoreIdx: STR value,[base,idx,LSL#3]).
      else if (self.nodeKind(target) == NK_INDEX) {
        var aiSimd: int64 := self._isSimdExpr(self.nodeC0(target));
        var aiBase: int64 := self.lowerExpr(self.nodeC0(target));
        var aiIdx:  int64 := self.lowerExpr(self.nodeC1(target));
        // WP-SIMD: parallel-Array<f32>[i] := v → f64-Wert nach f32 konvertieren + speichern.
        if aiSimd != 0 {
          self.irAddInstrDirect(IRO_SIMD_STORE_ELEM, aiIdx, valTemp, aiBase, 0);
        } else {
          self.irAddInstrDirect(IRO_STORE_IDX, aiIdx, valTemp, aiBase, 0);
        }
      }
    }
  }
  
  // ------------------------------------------------------------------
  // Break Statement Lowering
  // ------------------------------------------------------------------
  
  fn lowerBreak(stmt: int64) {
    if (self.loopExitLabel >= 0) {
      self.irEmitJmp(self.loopExitLabel);
    }
  }
  
  // ------------------------------------------------------------------
  // Continue Statement Lowering
  // ------------------------------------------------------------------
  
  fn lowerContinue(stmt: int64) {
    if (self.loopContLabel >= 0) {
      self.irEmitJmp(self.loopContLabel);
    }
  }
  
  // ------------------------------------------------------------------
  // Dispose Statement Lowering
  // ------------------------------------------------------------------
  
  // WP-BC-08: dispose obj  → evaluate pointer + IRO_FREE
  fn lowerDispose(stmt: int64) {
    var ptr: int64 := self.nodeC0(stmt);
    if (ptr >= 0) {
      var ptrTemp: int64 := self.lowerExpr(ptr);
      self.irAddInstrDirect(IRO_FREE, -1, ptrTemp, -1, 0);
    }
  }
  
  // ------------------------------------------------------------------
  // Pool Statement Lowering
  // ------------------------------------------------------------------

  // WP-BC-09: pool { stmt* } → IRO_POOL_ALLOC marker + lower body + IRO_POOL_FREE
  fn lowerPool(stmt: int64) {
    self.irAddInstrDirect(IRO_POOL_ALLOC, -1, -1, -1, 0);
    var bodyNode: int64 := self.nodeC0(stmt);
    if (bodyNode >= 0) {
      self.lowerBlock(bodyNode);
    }
    self.irAddInstrDirect(IRO_POOL_FREE, -1, -1, -1, 0);
  }

  // ------------------------------------------------------------------
  // Panic Statement Lowering
  // ------------------------------------------------------------------

  // WP-BC-10: panic(msg) → evaluate msg + IRO_PANIC
  fn lowerPanic(stmt: int64) {
    var msgNode: int64 := self.nodeC0(stmt);
    if (msgNode >= 0) {
      var msgTemp: int64 := self.lowerExpr(msgNode);
      self.irAddInstrDirect(IRO_PANIC, -1, msgTemp, -1, 0);
    }
  }

  // ------------------------------------------------------------------
  // Throw Statement Lowering
  // ------------------------------------------------------------------

  fn lowerThrow(stmt: int64) {
    var exn: int64 := self.nodeC0(stmt);
    if (exn >= 0) {
      var exnTemp: int64 := self.lowerExpr(exn);
      // Emit: throw exnTemp
    }
  }
  
  // ------------------------------------------------------------------
  // Try Statement Lowering
  // ------------------------------------------------------------------
  
  // #1281: try/catch wird hier NICHT abgesenkt, sondern abgewiesen.
  //
  // Was vorher hier stand, sah nach einer Absenkung aus und war keine: die
  // Stellen fuer push_handler, pop_handler, die Spruenge und die Label waren
  // Kommentare ohne Code. Erzeugt wurde damit try-Rumpf, dann catch-Rumpf,
  // dann finally — hintereinander weg. Der catch-Zweig lief also IMMER, auch
  // ohne `throw`, und ein `throw` fand keinen Handler.
  //
  // Dazu las die Funktion eine Knotenform, die der Parser gar nicht erzeugt
  // (C1 = catchVar / C2 = catchBody / C3 = finallyBody), waehrend dort seit
  // #1147 C1 = die NK_CATCH-Kette und C2 = der finally-Block stehen —
  // `lowerBlock` bekam also einen Catch-Knoten als Block und den
  // finally-Block als "catch".
  //
  // Und sie schrieb den Sprungpunkt fuer `break` um (`self.loopExitLabel :=
  // catchLbl`): ein `break` in einer Schleife innerhalb eines `try` waere im
  // catch-Zweig gelandet.
  //
  // Betroffen ist jedes Ziel, das ueber ir_lower geht (lyxos, arm64, riscv,
  // arm-cm4, xtensa); der produktive x86-Codegen benutzt ir_lower nicht und
  // ist seit #1147 in Ordnung. Ein Programm mit try/catch uebersetzte fuer
  // diese Ziele ohne Meldung und trug die falsche Semantik still ins
  // Ergebnis.
  //
  // Bis die Handler-Kette als IR steht (push_handler/pop_handler, Label,
  // `throw` springt zum aktuellen Handler, Ausnahmewert in einem festen Slot
  // wie CG_EXN_VAL im x86-Pfad), ist die Meldung das ehrlichere Verhalten:
  // lieber kein Binary als eines, das Ausnahmen falsch behandelt.
  fn lowerTryStmt(stmt: int64) {
    EPrintStrLn("ir_lower error: try/catch wird fuer dieses Ziel noch nicht unterstuetzt (#1281)"c);
    EPrintStrLn("  Der x86-64-ELF-Pfad beherrscht es; fuer lyxos, arm64, riscv, arm-cm4 und"c);
    EPrintStrLn("  xtensa fehlt die Handler-Absenkung. Eine Uebersetzung waere still falsch:"c);
    EPrintStrLn("  der catch-Rumpf liefe immer, auch ohne throw."c);
    exit(1);
  }

  // ------------------------------------------------------------------
  // Function Lowering
  // ------------------------------------------------------------------
  
  fn lowerFunc(funcNode: int64) {
    var savedLocal: int64 := self.localCount;
    var savedParam: int64 := self.paramCount;
    var savedTemp: int64 := self.tempCount;
    var savedRetVal: int64 := self.retValTemp;

    self.localCount := 0;
    self.paramCount := 0;
    self.tempCount := 0;
    self.localNameCnt := 0;
    self._volSlotN := 0;   // WP-VOLATILE: volatile-Slot-Liste pro Funktion zurücksetzen
    self.curFunc := funcNode;

    // WP-AND-upstream-fix v8: allocate params FIRST (slots 0..paramCount-1)
    // so they line up with the AAPCS64 spill the prologue performs and with
    // NK_IDENT's pidx-based loads. retValTemp moves AFTER params so it
    // doesn't share a slot with the first spilled parameter.
    // ARM64-OOP: bei Methoden belegt das implizite self Slot 0 (= erstes Arg x0).
    if self.methodParamBase != 0 { self.allocParam(); }
    var param: int64 := self.nodeC0(funcNode);
    while (param >= 0) {
      self.allocParam();
      param := self.nodeNext(param);
    }

    self.retValTemp := self.allocTemp();
    self.funcExitLabel := self.genLabel();

    self.funcInstrStart := peek64(self.ir + IR_MOD_OFF_INSTRLEN);

    var body: int64 := self.nodeC2(funcNode);
    if (body >= 0) { self.lowerBlock(body); }

    self.irEmitLabel(self.funcExitLabel);
    // WP-AND-upstream-fix v7: load the return-value slot into x0 right
    // before the epilogue. emitLoadLocal's first action is `LDUR x0,
    // [fp + slotOff(src)]`, and x0 survives the epilogue's MOV-sp /
    // LDP / RET sequence, so this satisfies AAPCS64's return-register
    // convention. Dest is harmless — STUR to slot 0 just writes
    // (the same) value back to itself.
    if self.retValTemp >= 0 {
      self.irAddInstrDirect(IRO_LOAD_LOCAL, 0, self.retValTemp, -1, 0);
    }
    self._addFunc();
  }
   
  // ------------------------------------------------------------------
  // Module Lowering
  // ------------------------------------------------------------------
  
  fn lowerModule(decls: int64) {
    // WP-AND-upstream-fix v4: pre-pass — register every top-level NK_VAR_DECL
    // as a global. NK_IDENT lookups in expressions later in this lowerModule
    // (and in nested lowerModule calls for imports) can then resolve them.
    var ggCur: int64 := decls;
    while ggCur >= 0 {
      if self.nodeKind(ggCur) == NK_VAR_DECL {
        if self.globalNameCnt >= self.globalNameCap {
          var ggNewCap: int64 := self.globalNameCap * 2;
          var ggNb: int64 := alloc(ggNewCap * 32);
          var ggI: int64 := 0;
          memcpy(ggNb, self.globalNameBuf, self.globalNameCnt * 32);
          self.globalNameBuf := ggNb;
          self.globalNameCap := ggNewCap;
        }
        // Extract init value if it's a simple int literal; everything else
        // defaults to 0 (runtime init via constructors etc. is future work).
        var ggInit: int64 := 0;
        var ggInitNode: int64 := self.nodeC1(ggCur);
        if ggInitNode >= 0 {
          if self.nodeKind(ggInitNode) == NK_LIT_INT {
            ggInit := self.nodeIVal(ggInitNode);
          }
        }
        // WP-AND-upstream-fix v5/cross-module: copy the name into the IR
        // string table so subsequent NK_IDENT lookups don't depend on
        // self.src (which gets swapped while lowering imports). The stored
        // offset is into ir.strBuffer, not into any parser's src.
        var ggNamePtr: pchar := self.nodeSVal(ggCur);
        var ggNameLen: int64 := self.nodeSLen(ggCur);
        var ggStrOff:  int64 := self.irAddString(ggNamePtr, ggNameLen);
        var ggRec: int64 := self.globalNameBuf + self.globalNameCnt * 32;
        poke64(ggRec +  0, ggStrOff);                            // IR strBuf offset
        poke64(ggRec +  8, ggNameLen);
        poke64(ggRec + GLOBAL_REC_OFF_IDX, self.globalNameCnt);                  // globalIdx
        poke64(ggRec + GLOBAL_REC_OFF_INIT, ggInit);                              // init value
        // Also mirror into IR module's globalBuffer (8 bytes per global, init
        // value at globalIdx*8). writeELFSharedLib reads from here to emit
        // the .data section. IR module layout: globalBuffer @ +104,
        // globalCap @ +112, globalLen @ +120 (offsets follow the class field
        // order in ir.lyx).
        var ggBuf: int64 := peek64(self.ir + IR_MOD_OFF_GLOBALBUF);
        var ggCap: int64 := peek64(self.ir + IR_MOD_OFF_GLOBALCAP);
        if self.globalNameCnt * 8 + 8 > ggCap {
          var ggNewCap2: int64 := ggCap * 2;
          if ggNewCap2 < self.globalNameCnt * 8 + 8 { ggNewCap2 := self.globalNameCnt * 8 + 64; }
          var ggNb2: int64 := alloc(ggNewCap2);
          var ggI2: int64 := 0;
          memcpy(ggNb2, ggBuf, self.globalNameCnt * 8);
          ggBuf := ggNb2;
          poke64(self.ir + IR_MOD_OFF_GLOBALBUF, ggBuf);
          poke64(self.ir + IR_MOD_OFF_GLOBALCAP, ggNewCap2);
        }
        poke64(ggBuf + self.globalNameCnt * 8, ggInit);
        poke64(self.ir + IR_MOD_OFF_GLOBALLEN, self.globalNameCnt + 1);   // globalLen
        self.globalNameCnt += 1;
      }
      ggCur := self.nodeNext(ggCur);
    }

    // WP-AND-upstream-fix v9: forward-reference pre-pass.
    // Register every top-level NK_FUNC_DECL name in funcBuffer with a
    // placeholder body before any function body is lowered. _addFunc
    // detects the existing entry on the second pass and updates it
    // (rather than allocating a new one). Imports aren't pre-passed
    // here; the body-pass below recurses into lowerModule for each
    // import, which performs its own pre-pass. Convention: imports
    // appear before function bodies in source order, so the chain
    // resolves correctly.
    var pfCur: int64 := decls;
    while pfCur >= 0 {
      var pfKind: int64 := self.nodeKind(pfCur);
      if pfKind == NK_FUNC_DECL {
        // Skip `extern fn ... link` decls (bodyless NK_FUNC_DECL with the
        // packed library span in c3): they are FFI imports, not internal
        // functions. Registering them in funcBuffer would make lowerCall
        // resolve them as user calls instead of emitting IRO_CALL_EXTERN.
        var pfIsExtern: int64 := 0;
        if self.nodeC2(pfCur) == -1 && self.nodeC3(pfCur) != -1 { pfIsExtern := 1; }
        if pfIsExtern == 0 {
          var pfNamePtr: pchar := self.nodeSVal(pfCur);
          var pfNameLen: int64 := self.nodeSLen(pfCur);
          var pfNameOff: int64 := self.irAddString(pfNamePtr, pfNameLen);
          self.irAddFunc(pfNameOff, pfNameLen, 0, 0);
        }
      } else if pfKind == NK_TYPE_DECL {
        // ARM64-OOP: Methoden (c1-Chain) unter mangled Namen "Class_method" registrieren.
        var pmM: int64 := self.nodeC1(pfCur);
        while pmM >= 0 {
          if self.nodeKind(pmM) == NK_FUNC_DECL {
            var pmMang: int64 := self._methodMangle(self.nodeSVal(pfCur), self.nodeSLen(pfCur),
                                                    self.nodeSVal(pmM), self.nodeSLen(pmM));
            var pmLen:  int64 := self.nodeSLen(pfCur) + 1 + self.nodeSLen(pmM);
            var pmOff:  int64 := self.irAddString(pmMang as pchar, pmLen);
            self.irAddFunc(pmOff, pmLen, 0, 0);
          }
          pmM := self.nodeNext(pmM);
        }
      } else if pfKind == NK_GENERIC_DECL {
        // WP-2.1: register generic declarations in genFuncBuf, NOT funcBuffer.
        // They are not emitted directly — only their specializations are.
        if (self.genFuncCount >= self.genFuncCap) {
          var gfc: int64 := self.genFuncCap * 2;
          var gfb: int64 := alloc(gfc * 24);
          var gfi: int64 := 0;
          memcpy(gfb, self.genFuncBuf, self.genFuncCount * 24);
          free(self.genFuncBuf, self.genFuncCap * 24);
          self.genFuncBuf := gfb; self.genFuncCap := gfc;
        }
        var gfRec: int64 := self.genFuncBuf + self.genFuncCount * 24;
        poke64(gfRec,      self.nodeSVal(pfCur) as int64);
        poke64(gfRec + GENFUNC_REC_OFF_NAMELEN,  self.nodeSLen(pfCur));
        poke64(gfRec + GENFUNC_REC_OFF_NODEIDX, pfCur);
        self.genFuncCount += 1;
      }
      pfCur := self.nodeNext(pfCur);
    }

    // StrLen-fix: globaler TRANSITIVER Import-Funktions-Pre-Pass (nur top-level lowerModule).
    // Registriert ALLE (transitiv) importierten Top-Level-Funktionen im funcBuffer BEVOR
    // irgendein Body gelowert wird. Sonst scheitert ein Modul-Body, der eine Funktion aus
    // einem in Quelltext-Reihenfolge noch nicht verarbeiteten Import nutzt (z.B.
    // error_collector → StrLen aus std.string; lyxc importiert std.string nur transitiv).
    // Iterativ (Work-Queue, KEINE neue IRLower-Methode — Seed-vtable-Schutz, vgl. v3-Kommentar)
    // mit Pfad-Dedup gegen Mehrfach-Parse bei Diamond-Imports.
    if self._importsDone == 0 {
      self._importsDone := 1;
      var WLCAP: int64 := 4096;
      var wlSrc:   int64 := alloc(WLCAP * 8);
      var wlNodes: int64 := alloc(WLCAP * 8);
      var wlCnt:   int64 := alloc(WLCAP * 8);
      var wlHead:  int64 := alloc(WLCAP * 8);
      var wlW: int64 := 0; var wlR: int64 := 0;
      // Visited-Pfade (Dedup): Bytes + (off,len)-Paare.
      var visBuf:  int64 := alloc(256 * 1024);
      var visPair: int64 := alloc(WLCAP * 16);
      var visN: int64 := 0; var visUsed: int64 := 0;
      // Seed = aktuelles (top) Modul.
      poke64(wlSrc, self.src as int64); poke64(wlNodes, self.nodes);
      poke64(wlCnt, self.nodeCount);    poke64(wlHead, decls);
      wlW := 1;
      while wlR < wlW {
        var mSrc:   int64 := peek64(wlSrc + wlR * 8);
        var mNodes: int64 := peek64(wlNodes + wlR * 8);
        var mCnt:   int64 := peek64(wlCnt + wlR * 8);
        var mHead:  int64 := peek64(wlHead + wlR * 8);
        wlR += 1;
        var svSrc: pchar := self.src; var svNodes: int64 := self.nodes; var svCnt: int64 := self.nodeCount;
        self.src := mSrc as pchar; self.nodes := mNodes; self.nodeCount := mCnt;
        var dc: int64 := mHead;
        while dc >= 0 {
          // WP-XMOD-OOP: jeden NK_TYPE_DECL dieses Moduls global registrieren (stabile type-id).
          if self.nodeKind(dc) == NK_TYPE_DECL { self._tregRegister(dc); }
          if self.nodeKind(dc) == NK_IMPORT {
            var nmP: pchar := self.nodeSVal(dc); var nmL: int64 := self.nodeSLen(dc);
            // Pfad "a.b.c" -> "a/b/c.lyx"
            var pb: int64 := alloc(nmL + 8); var pi: int64 := 0;
            while pi < nmL {
              var ch: int64 := peek8((nmP as int64) + pi);
              if ch == 46 { ch := 47; }
              poke8(pb + pi, ch); pi := pi + 1;
            }
            var dotLyx: pchar := ".lyx";
            memcpy(pb + nmL, dotLyx as int64, 5);
            // Dedup gegen visited (Modul-Name nmL Bytes).
            var seen: int64 := 0; var vi: int64 := 0;
            while vi < visN {
              if peek64(visPair + vi * 16 + 8) == nmL {
                var vo: int64 := peek64(visPair + vi * 16); var bm: int64 := 1; var bi: int64 := 0;
                while bi < nmL { if peek8(visBuf + vo + bi) != peek8(pb + bi) { bm := 0; bi := nmL; } bi := bi + 1; }
                if bm != 0 { seen := 1; vi := visN; }
              }
              vi += 1;
            }
            if seen == 0 {
              // visited eintragen
              var ci: int64 := 0;
              while ci < nmL { poke8(visBuf + visUsed + ci, peek8(pb + ci)); ci := ci + 1; }
              poke64(visPair + visN * 16, visUsed); poke64(visPair + visN * 16 + 8, nmL);
              visN += 1; visUsed := visUsed + nmL;
              var isrc: pchar := FileReadAll(pb as pchar);
              if (isrc as int64) != 0 {
                var ip: Parser := new Parser();
                ip.Init(isrc, StrLen(isrc));
                var ih: int64 := ip.Parse();
                if ip.hadError == 0 {
                  // Top-Level-Funktionen dieses Imports registrieren (src=ip.src).
                  var rsv: pchar := self.src; var rnd: int64 := self.nodes; var rcn: int64 := self.nodeCount;
                  self.src := ip.src; self.nodes := ip.nodes; self.nodeCount := ip.nodeCount;
                  var fd2: int64 := ih;
                  while fd2 >= 0 {
                    if self.nodeKind(fd2) == NK_FUNC_DECL {
                      var ext2: int64 := 0;
                      if self.nodeC2(fd2) == -1 && self.nodeC3(fd2) != -1 { ext2 := 1; }
                      if ext2 == 0 {
                        var noff: int64 := self.irAddString(self.nodeSVal(fd2), self.nodeSLen(fd2));
                        self.irAddFunc(noff, self.nodeSLen(fd2), 0, 0);
                      }
                    } else if self.nodeKind(fd2) == NK_TYPE_DECL {
                      // WP-VMT-lyxos: Methoden importierter Klassen mangled registrieren
                      // ("Class_method") — sonst scheitert ein Methoden-Call im importierenden
                      // Modul, das VOR dem Import gelowert wird (Ordering, vgl. StrLen-Pre-Pass).
                      var mm: int64 := self.nodeC1(fd2);
                      while mm >= 0 {
                        if self.nodeKind(mm) == NK_FUNC_DECL {
                          if self.nodeC2(mm) >= 0 {   // nur mit Body
                            var mMang: int64 := self._methodMangle(self.nodeSVal(fd2), self.nodeSLen(fd2),
                                                                   self.nodeSVal(mm), self.nodeSLen(mm));
                            var mLen:  int64 := self.nodeSLen(fd2) + 1 + self.nodeSLen(mm);
                            var mOff:  int64 := self.irAddString(mMang as pchar, mLen);
                            self.irAddFunc(mOff, mLen, 0, 0);
                          }
                        }
                        mm := self.nodeNext(mm);
                      }
                    }
                    fd2 := self.nodeNext(fd2);
                  }
                  self.src := rsv; self.nodes := rnd; self.nodeCount := rcn;
                  // Transitiv enqueuen.
                  if wlW < WLCAP {
                    poke64(wlSrc + wlW * 8, ip.src as int64); poke64(wlNodes + wlW * 8, ip.nodes);
                    poke64(wlCnt + wlW * 8, ip.nodeCount);    poke64(wlHead + wlW * 8, ih);
                    wlW += 1;
                  }
                }
              }
            }
          }
          dc := self.nodeNext(dc);
        }
        self.src := svSrc; self.nodes := svNodes; self.nodeCount := svCnt;
      }
    }

    var cur: int64 := decls;
    while (cur >= 0) {
      var kind: int64 := self.nodeKind(cur);
      if (kind == NK_FUNC_DECL) {
        // Skip extern (FFI) decls — no body to lower; calls become IRO_CALL_EXTERN.
        var bodyIsExtern: int64 := 0;
        if self.nodeC2(cur) == -1 && self.nodeC3(cur) != -1 { bodyIsExtern := 1; }
        if bodyIsExtern == 0 {
          self.lowerFunc(cur);
        }
      } else if (kind == NK_TYPE_DECL) {
        // ARM64-OOP: Methoden (c1-Chain) als Funktionen mit mangled Namen + impliziten
        // self-Param (Slot 0) lowern. methodParamBase=1 verschiebt explizite Params,
        // curMethodClassType erlaubt `self.field`-Auflösung.
        var mtM: int64 := self.nodeC1(cur);
        while mtM >= 0 {
          if self.nodeKind(mtM) == NK_FUNC_DECL {
            if self.nodeC2(mtM) >= 0 {   // nur mit Body
              var mtMang: int64 := self._methodMangle(self.nodeSVal(cur), self.nodeSLen(cur),
                                                      self.nodeSVal(mtM), self.nodeSLen(mtM));
              self.overrideFuncName    := mtMang as pchar;
              self.overrideFuncNameLen := self.nodeSLen(cur) + 1 + self.nodeSLen(mtM);
              self.methodParamBase     := 1;
              self.curMethodClassType  := cur;
              self.lowerFunc(mtM);
              self.overrideFuncName    := 0 as pchar;
              self.overrideFuncNameLen := 0;
              self.methodParamBase     := 0;
              self.curMethodClassType  := 0 - 1;
            }
          }
          mtM := self.nodeNext(mtM);
        }
      } else if (kind == NK_GENERIC_DECL) {
        // WP-2.1: generic declarations are emitted only as specializations (see below)
      } else if (kind == NK_IMPORT) {
        // WP-AND-upstream-fix v3: actually lower imported function bodies.
        // Sema's _sema_processImport reads + parses imports but disposes the
        // AST after Pass1, so ir_lower can't see imported decls. We re-read +
        // re-parse here. Logic is inlined rather than factored into a helper
        // method — earlier attempts at the v2 fix found that adding methods
        // to IRLower shifts its vtable in ways the seed compiler stumbles on.
        //
        // Path resolution: same convention as sema (`a.b.c` -> `a/b/c.lyx`).
        // No includePath / stdPath fallback yet; relative paths work for
        // tests run from the project root.
        var impModName: pchar := self.nodeSVal(cur);
        var impModLen:  int64 := self.nodeSLen(cur);
        var impPathBuf: int64 := alloc(impModLen + 8);
        var impI: int64 := 0;
        while impI < impModLen {
          var impC: int64 := peek8((impModName as int64) + impI);
          if impC == 46 { impC := 47; }   // '.' -> '/'
          poke8(impPathBuf + impI, impC);
          impI += 1;
        }
        var lyxExt: pchar := ".lyx";
        memcpy(impPathBuf + impModLen, lyxExt as int64, 5);

        var impSrc: pchar := FileReadAll(impPathBuf as pchar);
        if (impSrc as int64) != 0 {
          var impP: Parser := new Parser();
          impP.Init(impSrc, StrLen(impSrc));
          var impHead: int64 := impP.Parse();
          if impP.hadError == 0 {
            var impSavedSrc:    pchar := self.src;
            var impSavedNodes:  int64 := self.nodes;
            var impSavedCount:  int64 := self.nodeCount;
            self.src       := impP.src;
            self.nodes     := impP.nodes;
            self.nodeCount := impP.nodeCount;
            self.lowerModule(impHead);
            self.src       := impSavedSrc;
            self.nodes     := impSavedNodes;
            self.nodeCount := impSavedCount;
          }
        }
      }
      cur := self.nodeNext(cur);
    }

    // WP-2.1: emit pending generic specializations collected during this module.
    // Each pending record: {mangledPtr:8, mangledLen:8, genFuncNodeIdx:8, emitted:8}
    var pi: int64 := 0;
    while (pi < self.pendingGenCount) {
      var pRec: int64 := self.pendingGenBuf + pi * 32;
      var pEmitted: int64 := peek64(pRec + PENDING_REC_OFF_EMITTED);
      if (pEmitted == 0) {
        poke64(pRec + PENDING_REC_OFF_EMITTED, 1);  // mark as emitted
        var mangPtr: pchar := peek64(pRec) as pchar;
        var mangLen: int64 := peek64(pRec + PENDING_REC_OFF_MANGLEN);
        var gNodeIdx: int64 := peek64(pRec + PENDING_REC_OFF_NODEIDX);
        if (gNodeIdx >= 0) {
          // Register the specialization in funcBuffer so calls resolve
          var mangOff: int64 := self.irAddString(mangPtr, mangLen);
          self.irAddFunc(mangOff, mangLen, 0, 0);
          // Lower the generic body with the mangled name
          self.overrideFuncName    := mangPtr;
          self.overrideFuncNameLen := mangLen;
          self.lowerFunc(gNodeIdx);
          self.overrideFuncName    := 0;
          self.overrideFuncNameLen := 0;
        }
      }
      pi += 1;
    }
  }

  // ------------------------------------------------------------------
  // Accessors
  // ------------------------------------------------------------------
  
  // Add function to IR module. WP-AND-upstream-fix v9: support forward
  // references by detecting a pre-registered entry (same name) and
  // updating it instead of allocating a new one. The lookup uses early-
  // termination via a sentinel flag rather than mutating the loop bound
  // — earlier attempts to break by setting `fi := funcLen` hung the
  // seed compiler while it processed this source.
  fn _addFunc() {
    // WP-2.1: when lowering a monomorphized specialization, use the mangled name
    var fnNamePtr: pchar;
    var fnNameLen: int64;
    if (self.overrideFuncName != 0) {
      fnNamePtr := self.overrideFuncName;
      fnNameLen := self.overrideFuncNameLen;
    } else {
      fnNamePtr := self.nodeSVal(self.curFunc);
      fnNameLen := self.nodeSLen(self.curFunc);
    }

    var funcBuf2: int64 := peek64(self.ir + IR_MOD_OFF_FUNCBUF);
    var strBuf2:  int64 := peek64(self.ir + IR_MOD_OFF_STRBUF);
    var funcLen2: int64 := peek64(self.ir + IR_MOD_OFF_FUNCLEN);
    var funcIdx:  int64 := -1;
    var fi2: int64 := 0;
    while fi2 < funcLen2 {
      if funcIdx < 0 {
        var nOff2: int64 := peek64(funcBuf2 + fi2 * IR_FUNC_SIZE);
        var nLen2: int64 := peek64(funcBuf2 + fi2 * IR_FUNC_SIZE + IR_FUNC_OFF_NAMELEN);
        if nLen2 == fnNameLen {
          var match2: int64 := 1;
          var j2: int64 := 0;
          while j2 < nLen2 {
            if match2 != 0 {
              if peek8(strBuf2 + nOff2 + j2) != peek8((fnNamePtr as int64) + j2) { match2 := 0; }
            }
            j2 += 1;
          }
          if match2 != 0 { funcIdx := fi2; }
        }
      }
      fi2 += 1;
    }

    if funcIdx < 0 {
      var nameOff: int64 := self.irAddString(fnNamePtr, fnNameLen);
      funcIdx := self.irAddFunc(nameOff, fnNameLen, self.localCount, self.paramCount);
      self.globalFuncCount += 1;
    } else {
      // Pre-registered: fill in real locals/params.
      poke64(funcBuf2 + funcIdx * IR_FUNC_SIZE + IR_FUNC_OFF_LOCALCOUNT, self.localCount);
      poke64(funcBuf2 + funcIdx * IR_FUNC_SIZE + IR_FUNC_OFF_PARAMCOUNT, self.paramCount);
    }

    // Patch instrsOff and instrCount.
    var instrLen: int64 := peek64(self.ir + IR_MOD_OFF_INSTRLEN);
    var off: int64 := funcIdx * 80;
    poke64(funcBuf2 + off + IR_FUNC_OFF_INSTRSOFF, self.funcInstrStart);
    poke64(funcBuf2 + off + IR_FUNC_OFF_INSTRCOUNT, instrLen - self.funcInstrStart);
  }

  fn getStringLen(off: int64): int64 {
    var strBuf: int64 := peek64(self.ir + IR_MOD_OFF_STRBUF);  // strBuffer at +32 (after VMT)
    var ptr: int64 := strBuf + off;
    var len: int64 := 0;
    while peek8(ptr + len) != 0 { len := len + 1; }
    return len;
  }
  
  fn getLocalCount(): int64 { return self.localCount; }
  fn getParamCount(): int64 { return self.paramCount; }
  fn getTempCount(): int64 { return self.tempCount; }
  
  // ============================================================================
  // WP-20: Struct Lowering
  // ============================================================================
  
  // Load field from struct (stack-allocated)
  fn lowerLoadField(expr: int64): int64 {
    // C0: base struct (already lowered to temp)
    // C1: field index (or name string offset)
    var baseTemp: int64 := self.lowerExpr(self.nodeC0(expr));
    var fieldIdx: int64 := self.nodeIVal(self.nodeC1(expr));
    var dest: int64 := self.allocTemp();
    
    // Emit: dest = load baseTemp.fieldOffset
    // Field offset = fieldIdx * 8 (assuming 8-byte alignment)
    return dest;
  }
  
  // Store field to struct (stack-allocated)
  fn lowerStoreField(expr: int64): int64 {
    var baseTemp: int64 := self.lowerExpr(self.nodeC0(expr));
    var fieldIdx: int64 := self.nodeIVal(self.nodeC1(expr));
    var srcTemp: int64 := self.lowerExpr(self.nodeC2(expr));
    
    // Emit: store srcTemp to baseTemp.fieldOffset
    return srcTemp;
  }
  
  // Load element from struct array (static array)
  fn lowerLoadElem(expr: int64): int64 {
    var baseTemp: int64 := self.lowerExpr(self.nodeC0(expr));
    var idxTemp: int64 := self.lowerExpr(self.nodeC1(expr));
    var dest: int64 := self.allocTemp();
    
    // Emit: dest = load baseTemp[idxTemp * elemSize]
    return dest;
  }
  
  // Store element to struct array (static array)
  fn lowerStoreElem(expr: int64): int64 {
    var baseTemp: int64 := self.lowerExpr(self.nodeC0(expr));
    var idxTemp: int64 := self.lowerExpr(self.nodeC1(expr));
    var srcTemp: int64 := self.lowerExpr(self.nodeC2(expr));
    
    // Emit: store srcTemp to baseTemp[idxTemp * elemSize]
    return srcTemp;
  }
  
  // Struct-by-value copy (for assignment/return)
  fn lowerStructCopy(structTemp: int64, fieldCount: int64): int64 {
    // Copy all fields: for i in 0..fieldCount-1: dest[i] = src[i]
    var i: int64 := 0;
    while (i < fieldCount) {
      // Emit load field i to temp
      // Emit store to dest field i
      i += 1;
    }
    return structTemp;
  }
  
  // ============================================================================
  // WP-20: Class/Object Lowering
  // ============================================================================
  
  // new T() - heap allocation
  fn lowerNewClass(expr: int64): int64 {
    // C0: class type node (or size)
    var size: int64 := self.nodeIVal(expr);
    var dest: int64 := self.allocTemp();
    
    // Emit: dest = alloc(size)
    // Then: store VMT pointer at dest[0]
    return dest;
  }
  
  // dispose obj - heap deallocation
  fn lowerDisposeClass(objTemp: int64): int64 {
    // Emit: free objTemp
    return objTemp;
  }
  
  // Load field from heap object
  fn lowerLoadFieldHeap(expr: int64): int64 {
    var objTemp: int64 := self.lowerExpr(self.nodeC0(expr));
    var fieldOffset: int64 := self.nodeIVal(self.nodeC1(expr));
    var dest: int64 := self.allocTemp();
    
    // Emit: dest = load objTemp[fieldOffset]
    return dest;
  }
  
  // Store field to heap object
  fn lowerStoreFieldHeap(expr: int64): int64 {
    var objTemp: int64 := self.lowerExpr(self.nodeC0(expr));
    var fieldOffset: int64 := self.nodeIVal(self.nodeC1(expr));
