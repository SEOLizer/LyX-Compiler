    var mName: pchar := self.nodeSVal(rhs);
    var mLen:  int64 := self.nodeSLen(rhs);
    var szT: int64 := self.allocTemp();
    self.irAddInstrDirect(IRO_CONST_INT, szT, -1, -1, 16);
    var p: int64 := self.allocTemp();
    self.irAddInstrDirect(IRO_ALLOC, p, szT, -1, 0);
