// ============================================================================
// IRLower Class
// ============================================================================

pub type IRLower = class {
  // Global function count workaround (since IRModule access is broken across S1/S2)
  // Initialized in init() method
  globalFuncCount: int64;
  
  // IR Module reference (stored as int64, accessed via helper functions)
  ir: int64;
  
  // Reference to IRModule object (for method calls)
  irModule: IRModule;
  
  // AST data
  nodes: int64;
  nodeCount: int64;
  src: pchar;

  // WSP-05: Ziel-Architektur (LYX_TC_*, von lyxc nach init() gesetzt). Steuert die
  // arch-spezifische asm-Mnemonic→Id-Tabelle in _asmMnemonicId. 0 = x86-Default.
  target: int64;

  // Current function context
  curFunc: int64;
  
  // Local variable tracking
  localCount: int64;
  paramCount: int64;

  // WP-AND-upstream-fix v4: per-function name->slot mapping for declared
  // locals (NK_VAR_DECL inside a body). Records are 24 bytes:
  // {srcNameOff:i64, nameLen:i64, slotIdx:i64}. Resized geometrically.
  // Cleared at the start of each lowerFunc.
  localNameBuf: int64;
  localNameCnt: int64;
  localNameCap: int64;
  // ARM64-OOP: parallel zu localNameBuf — type-name-Node pro Local (oder -1).
  // Erlaubt Instanz-Feldzugriff `p.x`: p's Typ → Feld-Offset.
  localTypeBuf: int64;
  // ARM64-OOP statische Methoden: in einer Methode = 1 (self belegt Slot 0, explizite
  // Params verschieben sich um +1), sonst 0. curMethodClassType = NK_TYPE_NAME-Node der
  // umgebenden Klasse (für `self.field`-Auflösung) oder -1.
  methodParamBase:    int64;
  curMethodClassType: int64;

  // WP-AND-upstream-fix v4/v5: module-scope mapping for top-level NK_VAR_DECLs.
  // Records are 32 bytes: {srcNameOff:i64, nameLen:i64, globalIdx:i64, initValue:i64}.
  // Populated once in the lowerModule pre-pass and never cleared. Used by
  // NK_IDENT lookups as the final fallback (after locals + params).
  globalNameBuf: int64;
  globalNameCnt: int64;
  globalNameCap: int64;
  
  // Label and temp counters
  labelCount: int64;
  tempCount: int64;
  
  // Loop control (for break/continue)
  loopExitLabel: int64;
  loopContLabel: int64;
  
  // Return value temp (for functions with non-void return)
  retValTemp: int64;
  
  // Function exit label (for return statements to jump to)
  funcExitLabel: int64;

  // Instruction index at which the current function's body started
  funcInstrStart: int64;
  
  // Class/Struct metadata (for field lookups)
  structFieldOffsets: int64;  // buffer: structName -> fieldOffset
  classVmtOffsets: int64;    // buffer: className -> methodOffset
  currentClass: int64;        // current class being lowered
  
  // Generic type arguments
  typeArgs: int64;           // current type arguments for generic instantiation
  typeArgCount: int64;

  // WP-2.2-B: Defer scope stack
  // Flat buffer of deferred statement node indices — block-scoped LIFO.
  // Records: {stmtNodeIdx: int64} = 8 bytes each.
  // On block entry: save deferCount. On block exit: emit LIFO from saved..deferCount-1, restore.
  // On return: emit ALL entries LIFO (entire stack), then jump.
  deferBuf:   int64;
  deferCount: int64;
  deferCap:   int64;

  // WP-2.1: Generic monomorphization support
  // Override function name used by _addFunc when lowering a specialization
  overrideFuncName:    pchar;   // non-null = use this name in _addFunc
  overrideFuncNameLen: int64;
  // Registry of generic function declarations seen in lowerModule pre-pass
  // Records: {namePtr:8, nameLen:8, nodeIdx:8} = 24 bytes each
  genFuncBuf:   int64;
  genFuncCount: int64;
  genFuncCap:   int64;
  _importsDone: int64;  // StrLen-fix: globaler transitiver Import-Func-Pre-Pass nur 1× (top-level)
  // WP-XMOD-OOP: globales Type-Registry (cross-module). Jeder NK_TYPE_DECL aller Module bekommt
  // eine stabile globale type-id (= Registry-Index). Gefüllt im Import-Pre-Pass. Ermöglicht
  // korrektes new (Größe/type-id) + virtuelle Dispatch für IMPORTIERTE Klassen.
  _tregSrc:   int64;    // [] src-Pointer des Moduls je Eintrag
  _tregNodes: int64;    // [] nodes-Pointer
  _tregCnt:   int64;    // [] nodeCount
  _tregIdx:   int64;    // [] lokaler Node-Index des NK_TYPE_DECL im Modul
  _tregNameP: int64;    // [] absoluter Pointer auf Klassennamen
  _tregNameL: int64;    // [] Namenslänge
  _tregN:     int64;    // Anzahl Einträge
  _tregCap:   int64;    // Kapazität
  // WP-VOLATILE: Slot-Nummern volatiler Locals der AKTUELLEN Funktion (rare → kleine Liste,
  // Reset O(1) pro Funktion). Volatile LOAD_LOCAL werden mit callmode-Sentinel markiert,
  // damit DCE sie nicht entfernt (MMIO/Hardware-Register-Reads müssen erhalten bleiben).
  _volSlotList: int64;  // [] Slot-Nummern
  _volSlotN:    int64;  // Anzahl
  // Queue of pending specializations to emit after the main lowering loop
  // Records: {mangledPtr:8, mangledLen:8, genFuncNodeIdx:8, emitted:8} = 32 bytes each
  pendingGenBuf:   int64;
  pendingGenCount: int64;
  pendingGenCap:   int64;
  
  // ------------------------------------------------------------------
  // Initialization
  // ------------------------------------------------------------------
  
  fn init(irModPtr: int64, astNodes: int64, astNodeCount: int64, astSrc: pchar, irMod: IRModule) {
    self.ir := irModPtr;
    self.irModule := irMod;
    self.nodes := astNodes;
    self.nodeCount := astNodeCount;
    self.src := astSrc;
    self.target := 0;  // WSP-05: x86-Default; lyxc überschreibt nach init()
    // Initialize global function count
    self.globalFuncCount := 0;
    self.localCount := 0;
    self.paramCount := 0;
    self.labelCount := 0;
    self.tempCount := 0;
    self.localNameCap := 32;
    self.localNameBuf := alloc(32 * 24);
    self.localTypeBuf := alloc(32 * 8);
    self.localNameCnt := 0;
    self.methodParamBase    := 0;
    self.curMethodClassType := 0 - 1;
    self.globalNameCap := 32;
    self.globalNameBuf := alloc(32 * 32);
    self.globalNameCnt := 0;
    self.loopExitLabel := -1;
    self.loopContLabel := -1;
    self.curFunc := -1;
    self.retValTemp := -1;
    self.structFieldOffsets := 0;
    self.classVmtOffsets := 0;
    self.currentClass := -1;
    self.typeArgs := 0;
    self.typeArgCount := 0;
    self.funcInstrStart := 0;
    // WP-2.2-B: defer stack
    self.deferCap   := 32;
    self.deferBuf   := alloc(32 * 8);
    self.deferCount := 0;
    // WP-2.1: generics
    self.overrideFuncName    := 0;
    self.overrideFuncNameLen := 0;
    self.genFuncCap   := 16;
    self.genFuncBuf   := alloc(16 * 24);
    self.genFuncCount := 0;
    self._importsDone := 0;
    self._tregCap := 1024;
    self._tregN := 0;
    self._tregSrc   := alloc(self._tregCap * 8);
    self._tregNodes := alloc(self._tregCap * 8);
    self._tregCnt   := alloc(self._tregCap * 8);
    self._tregIdx   := alloc(self._tregCap * 8);
    self._tregNameP := alloc(self._tregCap * 8);
    self._tregNameL := alloc(self._tregCap * 8);
    self._volSlotList := alloc(256 * 8);
    self._volSlotN := 0;
    self.pendingGenCap   := 16;
    self.pendingGenBuf   := alloc(16 * 32);
    self.pendingGenCount := 0;
  }
  
  // Helper function to call IRModule methods via vtable
  // Since we're storing the pointer directly, we need to find the vtable and methods
  fn initIRHelper(ptr: int64) {
    // The IRModule has a vtable at offset 0, methods at vtable[0], vtable[1], etc.
    // addFunc is method #X, getFuncCount is method #Y
    // We can't easily call them directly without knowing the vtable layout
    // For now, we'll just use raw memory access
  }
  
  // Helper: add function directly to IRModule via raw memory
  // Bypasses method calls that don't work in S1→S2 context
  fn irAddFunc(nameOff: int64, nameLen: int64, localCount: int64, paramCount: int64): int64 {
    // IRModule layout:
    //   funcBuffer at +80 (field 10)
    //   funcCap at +88 (field 11)  
    //   funcLen at +96 (field 12)
    // IR_FUNC_SIZE = 80 bytes per function
    
    var funcLen: int64 := peek64(self.ir + IR_MOD_OFF_FUNCLEN);
    var funcCap: int64 := peek64(self.ir + IR_MOD_OFF_FUNCCAP);
    
    // Compute idx
    var idx: int64 := funcLen;
    
    // Grow if needed
    if (((funcLen + 1) * 80) > funcCap) {
      var newCap: int64 := funcCap * 2;
      var oldBuf: int64 := peek64(self.ir + IR_MOD_OFF_FUNCBUF);
      var newBuf: int64 := alloc(newCap);
      // Copy existing functions
      var i: int64 := 0;
      while (i < funcLen) {
        var j: int64 := 0;
        memcpy(newBuf + i * 80, oldBuf + i * 80, 80);
        i += 1;
      }
      // Update funcBuffer and funcCap
      poke64(self.ir + IR_MOD_OFF_FUNCBUF, newBuf);
      poke64(self.ir + IR_MOD_OFF_FUNCCAP, newCap);
      funcCap := newCap;
    }
    
    // Get funcBuffer
    var funcBuf: int64 := peek64(self.ir + IR_MOD_OFF_FUNCBUF);
    var off: int64 := idx * 80;
    
    // Store function data
    poke64(funcBuf + off + 0, nameOff);   // nameOff
    poke64(funcBuf + off + IR_FUNC_OFF_NAMELEN, nameLen);   // nameLen
    poke64(funcBuf + off + IR_FUNC_OFF_INSTRSOFF, 0);        // instrsOff (will be set later)
    poke64(funcBuf + off + IR_FUNC_OFF_INSTRCOUNT, 0);        // instrCount
    poke64(funcBuf + off + IR_FUNC_OFF_LOCALCOUNT, localCount);  // localCount
    poke64(funcBuf + off + IR_FUNC_OFF_PARAMCOUNT, paramCount);  // paramCount
    poke64(funcBuf + off + IR_FUNC_OFF_RETSTRUCTSIZE, 0);        // retStructSize
    poke64(funcBuf + off + IR_FUNC_OFF_CAPTUREDOFF, 0);        // capturedVarsOff
    poke64(funcBuf + off + IR_FUNC_OFF_CAPTUREDCOUNT, 0);        // capturedCount
    poke64(funcBuf + off + IR_FUNC_OFF_STATICLINK, 0);        // needsStaticLink
    
    funcLen += 1;
    poke64(self.ir + IR_MOD_OFF_FUNCLEN, funcLen);
    
    return idx;
  }
  
  fn irGetFuncCount(): int64 {
    return peek64(self.ir + IR_MOD_OFF_FUNCLEN);
  }
  
  // Remove duplicate global
  // ------------------------------------------------------------------
  // AST Node Access Helpers
  // ------------------------------------------------------------------
  
  fn nodeOff(i: int64): int64 { return self.nodes + i * 88; }
  fn nodeKind(i: int64): int64 { return peek64(self.nodeOff(i)); }
  fn nodeC0(i: int64): int64 { return peek64(self.nodeOff(i) + NODE_OFF_C0); }
  fn nodeC1(i: int64): int64 { return peek64(self.nodeOff(i) + NODE_OFF_C1); }
  fn nodeC2(i: int64): int64 { return peek64(self.nodeOff(i) + NODE_OFF_C2); }
  fn nodeC3(i: int64): int64 { return peek64(self.nodeOff(i) + NODE_OFF_C3); }
  fn nodeIVal(i: int64): int64 { return peek64(self.nodeOff(i) + NODE_OFF_IVAL); }
  fn nodeSVal(i: int64): pchar { return self.src + peek64(self.nodeOff(i) + NODE_OFF_SVAL); }
  fn nodeSLen(i: int64): int64 { return peek64(self.nodeOff(i) + NODE_OFF_SLEN); }
  fn nodeNext(i: int64): int64 { return peek64(self.nodeOff(i) + NODE_OFF_NEXT); }

  // WP-BC-44: compute 1-based source line number from AST node index
  fn _lineOf(ni: int64): int64 {
    if (ni < 0) { return -1; }
    var soff: int64 := peek64(self.nodeOff(ni) + NODE_OFF_SVAL);
    if (soff <= 0) { return 1; }
    var line: int64 := 1;
    var i: int64 := 0;
    while (i < soff) {
      if (StrCharAt(self.src, i) == 10) { line := line + 1; }
      i += 1;
    }
    return line;
  }

  // WP-BC-01: length-aware string comparison (source tokens are not null-terminated)
  fn seq(a: pchar, an: int64, b: pchar, bn: int64): bool {
    if (an != bn) { return false; }
    var i: int64 := 0;
    while (i < an) {
      if (StrCharAt(a, i) != StrCharAt(b, i)) { return false; }
      i += 1;
    }
    return true;
  }

  // ------------------------------------------------------------------
  // IR Module Helpers (call through function pointers)
  // ------------------------------------------------------------------
  
  // Helper: add IR instruction directly to IRModule
  // When IRModule is passed as int64 (from "as int64" cast), it's the VTable pointer
  // The actual object fields are accessed via VTable pointer
  fn irAddInstrDirect(op: int64, dest: int64, src1: int64, src2: int64, imm: int64): int64 {
    var instrBuf: int64 := peek64(self.ir + IR_MOD_OFF_INSTRBUF);   // instrBuffer at +8 (after VMT)
    var instrCap: int64 := peek64(self.ir + IR_MOD_OFF_INSTRCAP);  // instrCap at +16
    var instrLen: int64 := peek64(self.ir + IR_MOD_OFF_INSTRLEN);  // instrLen at +24 (stored as count)

    // Grow if needed (IR_INSTR_SIZE = 80 bytes)
    if (((instrLen + 1) * 80) > instrCap) {
      var newCap: int64 := instrCap * 2;
      var nb: int64 := alloc(newCap);
      var i: int64 := 0;
      while (i < instrLen) {
        var j: int64 := 0;
        memcpy(nb + i * 80, instrBuf + i * 80, 80);
        i += 1;
      }
      poke64(self.ir + IR_MOD_OFF_INSTRBUF, nb);
      poke64(self.ir + IR_MOD_OFF_INSTRCAP, newCap);
      instrCap := newCap;
      instrBuf := nb;
    }

    // Store instruction
    var off: int64 := instrLen * 80;
    poke64(instrBuf + off + 0, op);
    poke64(instrBuf + off + IR_INSTR_OFF_DEST, dest);
    poke64(instrBuf + off + IR_INSTR_OFF_SRC1, src1);
    poke64(instrBuf + off + IR_INSTR_OFF_SRC2, src2);
    poke64(instrBuf + off + IR_INSTR_OFF_SRC3, -1);
    poke64(instrBuf + off + IR_INSTR_OFF_IMMINT, imm);

    // WP-BC-47: populate provenance side table using raw pointer access
    // (Field access via self.irModule.xxx gives wrong values; use peek/poke directly)
    // Verified offsets: provenance=+184(1b), curAstNode=+192, astNodeBuf=+200, astNodeBufCap=+208
    var irProvenance: int64 := peek8(self.ir + IR_MOD_OFF_PROVENANCE);
    var irAstNodeBufCap: int64 := peek64(self.ir + IR_MOD_OFF_ASTNODEBUFC);
    var irAstNodeBuf: int64 := peek64(self.ir + IR_MOD_OFF_ASTNODEBUF);
    var irCurAstNode: int64 := peek64(self.ir + IR_MOD_OFF_CURASTNODE);
    if irProvenance != 0 {
      var needed: int64 := (instrLen + 1) * 8;
      if needed > irAstNodeBufCap {
        var newCap: int64 := needed * 2 + 128;
        var nb: int64 := alloc(newCap);
        var ji: int64 := 0;
        memcpy(nb, irAstNodeBuf, irAstNodeBufCap);
        poke64(self.ir + IR_MOD_OFF_ASTNODEBUF, nb);
        poke64(self.ir + IR_MOD_OFF_ASTNODEBUFC, newCap);
        irAstNodeBuf := nb;
      }
      poke64(irAstNodeBuf + instrLen * 8, irCurAstNode);
    }

    // Increment instrLen (count convention)
    instrLen += 1;
    poke64(self.ir + IR_MOD_OFF_INSTRLEN, instrLen);

    return instrLen - 1;
  }

  // WP-BC-39: Add a string to the IR module's string table; return byte offset
  fn irAddString(s: pchar, slen: int64): int64 {
    var strBuf: int64 := peek64(self.ir + IR_MOD_OFF_STRBUF);
    var strCap: int64 := peek64(self.ir + IR_MOD_OFF_STRCAP);
    var strLen: int64 := peek64(self.ir + IR_MOD_OFF_STRLEN);
    if (strLen + slen + 1 > strCap) {
      var newCap: int64 := strCap * 2;
      var nb: int64 := alloc(newCap);
      var ci: int64 := 0;
      memcpy(nb, strBuf, strLen);
      strBuf := nb;
      strCap := newCap;
      poke64(self.ir + IR_MOD_OFF_STRBUF, strBuf);
      poke64(self.ir + IR_MOD_OFF_STRCAP, strCap);
    }
    var off: int64 := strLen;
    var src: int64 := s as int64;
    var si: int64 := 0;
    memcpy(strBuf + off, src, slen);
    poke8(strBuf + off + slen, 0);
    strLen := strLen + slen + 1;
    poke64(self.ir + IR_MOD_OFF_STRLEN, strLen);
    return off;
  }

  // WP-BC-39: Set strOff field of instruction at index idx
  fn irSetStrOff(idx: int64, off: int64) {
    var instrBuf: int64 := peek64(self.ir + IR_MOD_OFF_INSTRBUF);
    poke64(instrBuf + idx * IR_INSTR_SIZE + IR_INSTR_OFF_STROFF, off);
  }

  // Control-flow emit helpers
  fn irEmitLabel(labelId: int64) {
    self.irAddInstrDirect(IRO_LABEL, -1, -1, -1, labelId);
  }

  fn irEmitJmp(labelId: int64) {
    self.irAddInstrDirect(IRO_JMP, -1, -1, -1, labelId);
  }

  fn irEmitBrFalse(cond: int64, labelId: int64) {
    self.irAddInstrDirect(IRO_BR_FALSE, -1, cond, -1, labelId);
  }
  
  // ------------------------------------------------------------------
  // Label Generation
  // ------------------------------------------------------------------
  
  fn genLabel(): int64 {
    var lbl: int64 := self.labelCount;
    self.labelCount += 1;
    return lbl;
  }
  
  // ------------------------------------------------------------------
  // Temporary Register Allocation
  // ------------------------------------------------------------------
  
  fn allocTemp(): int64 {
    var t: int64 := self.tempCount;
    self.tempCount += 1;
    if (t >= self.localCount) { self.localCount := t + 1; }
    return t;
  }
  
  // WP-AND-upstream-fix v8: allocParam now bumps the same counter as
  // allocTemp. Previously paramCount and tempCount were independent which
  // meant a function with two params and one explicit retValTemp had
  // *three* values all claiming slot 0..2 by overlap. With the shared
  // counter, params occupy 0..paramCount-1 cleanly, and the subsequent
  // allocTemp for retValTemp returns paramCount (a fresh slot). NK_IDENT's
  // pidx-based loads still match because params keep their 0-based order.
  fn allocParam(): int64 {
    var p: int64 := self.tempCount;
    self.tempCount += 1;
    if (p >= self.localCount) { self.localCount := p + 1; }
    self.paramCount += 1;
    return p;
  }
  
  // ------------------------------------------------------------------
  // Expression Lowering
  // ------------------------------------------------------------------
  
  fn lowerExpr(expr: int64): int64 {
    // Invalid node
    if (expr < 0) { 
      return self.allocTemp();  // Allocate temp anyway for safety
    }
    
    var k: int64 := self.nodeKind(expr);

    // Literal: integer constant
    if (k == NK_LIT_INT) {
      var dest: int64 := self.allocTemp();
      var val: int64 := self.nodeIVal(expr);
      // Emit: dest = const val
      self.irAddInstrDirect(IRO_CONST_INT, dest, -1, -1, val);
      return dest;
    }
    
    // Literal: float constant — WP-F64: Quelltext ("2.0") → IEEE-754-Bits parsen → CONST_INT.
    // (Node speichert TEXT via _ssv, nicht Bits; vorher emittierte der Zweig NICHTS → Garbage.)
    if (k == NK_LIT_FLOAT) {
      var dest: int64 := self.allocTemp();
      var bits: int64 := self._parseFloatBits(self.nodeSVal(expr), self.nodeSLen(expr));
      self.irAddInstrDirect(IRO_CONST_INT, dest, -1, -1, bits);
      return dest;
    }
    
    // Literal: string constant
    if (k == NK_LIT_STR) {
      var dest: int64 := self.allocTemp();
      // LYXOS-pchar-fix2: IR-Backends brauchen den Offset im IR-strBuf, NICHT nodeIVal
      // (= Parser-/Quell-Offset). Sonst zeigt CONST_STR in die Symbol-/Namen-Tabelle
      // (z. B. "main"). String aus nodeSVal extrahieren, Escapes verarbeiten, in den
      // IR-strBuf internieren (irAddString null-terminiert → strlen-tauglich).
      var lsStart:  int64 := (self.nodeSVal(expr) as int64) + 1;  // opening quote überspringen
      var lsSrcLen: int64 := self.nodeSLen(expr) - 2;             // beide quotes weg
      if (lsSrcLen < 0) { lsSrcLen := 0; }
      var lsBuf: int64 := alloc(lsSrcLen + 8);
      var lsOut: int64 := 0;
      var lsI:   int64 := 0;
      while lsI < lsSrcLen {
        var lsC: int64 := peek8(lsStart + lsI);
        if lsC == 92 && lsI + 1 < lsSrcLen {       // backslash-Escape
          var lsN: int64 := peek8(lsStart + lsI + 1);
          if lsN == 110      { lsC := 10; lsI := lsI + 1; }   // \n
          else if lsN == 116 { lsC := 9;  lsI := lsI + 1; }   // \t
          else if lsN == 114 { lsC := 13; lsI := lsI + 1; }   // \r
          else if lsN == 92  { lsC := 92; lsI := lsI + 1; }   // \\
          else if lsN == 34  { lsC := 34; lsI := lsI + 1; }   // \"
          else if lsN == 48  { lsC := 0;  lsI := lsI + 1; }   // \0
        }
        poke8(lsBuf + lsOut, lsC);
        lsOut += 1;
        lsI += 1;
      }
      var strOff: int64 := self.irAddString(lsBuf as pchar, lsOut);
      self.irAddInstrDirect(IRO_CONST_STR, dest, -1, -1, strOff);
      return dest;
    }
    
    // Literal: boolean
    if (k == NK_LIT_BOOL) {
      var dest: int64 := self.allocTemp();
      var val: int64 := self.nodeIVal(expr);
      // Emit: dest = const val
      return dest;
    }
    
    // Literal: character
    if (k == NK_LIT_CHAR) {
      var dest: int64 := self.allocTemp();
      var val: int64 := self.nodeIVal(expr);
      // Emit: dest = const val
      return dest;
    }
    
    // Literal: null
    if (k == NK_LIT_NULL) {
      var dest: int64 := self.allocTemp();
      // Emit: dest = const 0
      return dest;
    }
    
    // Identifier (variable reference). WP-AND-upstream-fix v4: previously a
    // pure stub — allocate temp, return without emitting any load. As a
    // result every `a + b` style expression was reading whatever the
    // zeroed temp slot happened to contain. We now walk the current
    // function's parameter list (NK_PARAM chain in curFunc.nodeC0) and,
    // on a name match, emit IRO_LOAD_LOCAL with src = position-in-chain.
    // Locals declared via NK_VAR_DECL still unhandled — separate step.
    // Globals also unhandled — see work/android.md for the open list.
    if (k == NK_IDENT) {
      var dest: int64 := self.allocTemp();
      if self.curFunc >= 0 {
        var idName: pchar := self.nodeSVal(expr);
        var idLen:  int64 := self.nodeSLen(expr);
        var idPtrL: int64 := (idName) as int64;
        // ARM64-OOP: `self` in einer Methode → impliziter Param-Slot 0 (Objekt-Pointer).
        if self.methodParamBase != 0 && idLen == 4 {
          if peek8(idPtrL) == 115 && peek8(idPtrL + 1) == 101 &&
             peek8(idPtrL + 2) == 108 && peek8(idPtrL + 3) == 102 {   // "self"
            self.irAddInstrDirect(IRO_LOAD_LOCAL, dest, 0, -1, 0);
            return dest;
          }
        }
        // WP-AND-upstream-fix v4: locals declared via NK_VAR_DECL come first.
        var lnI: int64 := self.localNameCnt - 1;   // shadowing: latest wins
        while lnI >= 0 {
          var lnRec:    int64 := self.localNameBuf + lnI * 24;
          var lnNameOff:int64 := peek64(lnRec + 0);
          var lnLen:    int64 := peek64(lnRec + LOCAL_REC_OFF_NAMELEN);
          var lnSlot:   int64 := peek64(lnRec + LOCAL_REC_OFF_SLOT);
          if lnLen == idLen {
            var lnPtr: int64 := (self.src as int64) + lnNameOff;
            var lnMatch: int64 := 1;
            var lnJ: int64 := 0;
            while lnJ < idLen {
              if lnMatch != 0 {
                if peek8(lnPtr + lnJ) != peek8(idPtrL + lnJ) { lnMatch := 0; }
              }
              lnJ += 1;
            }
            if lnMatch != 0 {
              var llIdx: int64 := self.irAddInstrDirect(IRO_LOAD_LOCAL, dest, lnSlot, -1, 0);
              if self._isVolSlot(lnSlot) != 0 { self._markVolatileInstr(llIdx); }   // WP-VOLATILE
              return dest;
            }
          }
          lnI -= 1;
        }
        var pnode:  int64 := self.nodeC0(self.curFunc);
        var pidx:   int64 := 0;
        while pnode >= 0 {
          if self.nodeKind(pnode) == NK_PARAM {
            var pnLen: int64 := self.nodeSLen(pnode);
            if pnLen == idLen {
              var pnPtr: int64 := (self.nodeSVal(pnode)) as int64;
              var idPtr: int64 := (idName) as int64;
              var pmatch: int64 := 1;
              var pj: int64 := 0;
              while pj < idLen {
                if pmatch != 0 {
                  if peek8(pnPtr + pj) != peek8(idPtr + pj) { pmatch := 0; }
                }
                pj += 1;
              }
              if pmatch != 0 {
                // ARM64-OOP: in Methoden ist self Slot 0 → explizite Params +methodParamBase.
                self.irAddInstrDirect(IRO_LOAD_LOCAL, dest, pidx + self.methodParamBase, -1, 0);
                return dest;
              }
            }
            pidx += 1;
          }
          pnode := self.nodeNext(pnode);
        }
        // WP-AND-upstream-fix v4: globals fallback. The src nameOff stored
        // in globalNameBuf points into the main file's src — which is what
        // self.src is set to during a top-level lowerModule pass. (Imported
        // bodies temporarily swap self.src; if they reference a global from
        // the main file, that lookup will compare bytes against the wrong
        // buffer. Acceptable initial limitation: cross-module globals not
        // supported yet.)
        var gnI: int64 := 0;
        // WP-AND-upstream-fix v5/cross-module: names live in IR strBuffer.
        var gnStrBuf: int64 := peek64(self.ir + IR_MOD_OFF_STRBUF);
        while gnI < self.globalNameCnt {
          var gnRec:     int64 := self.globalNameBuf + gnI * 32;
          var gnNameOff: int64 := peek64(gnRec + 0);
          var gnLen:     int64 := peek64(gnRec + GLOBAL_REC_OFF_NAMELEN);
          var gnIdx:     int64 := peek64(gnRec + GLOBAL_REC_OFF_IDX);
          if gnLen == idLen {
            var gnPtr: int64 := gnStrBuf + gnNameOff;
            var gnMatch: int64 := 1;
            var gnJ: int64 := 0;
            while gnJ < idLen {
              if gnMatch != 0 {
                if peek8(gnPtr + gnJ) != peek8(idPtrL + gnJ) { gnMatch := 0; }
              }
              gnJ += 1;
            }
            if gnMatch != 0 {
              self.irAddInstrDirect(IRO_LOAD_GLOBAL, dest, gnIdx, -1, 0);
              return dest;
            }
          }
          gnI += 1;
        }
        // WP-A1: kein Local/Param/Global → Funktions-NAME als Wert? → Funktions-Adresse laden
        // (fn-ptr-Zuweisung, z.B. `b.on_click := h`). Vorher: uninitialisierter Temp (Garbage).
        var faFn: int64 := self._findFuncByName(idName, idLen);
        if faFn >= 0 { self.irAddInstrDirect(IRO_FUNC_ADDR, dest, faFn, -1, 0); return dest; }
      }
      return dest;
    }

    // Binary operation
    if (k == NK_BINOP) {
      return self.lowerBinOp(expr);
    }
    
    // Unary operation
    if (k == NK_UNOP) {
      return self.lowerUnOp(expr);
    }
    
    // Function call
    if (k == NK_CALL) {
      return self.lowerCall(expr);
    }
    
    // Array index access
    if (k == NK_INDEX) {
      return self.lowerIndex(expr);
    }
    
    // Field access
    if (k == NK_FIELD) {
      return self.lowerField(expr);
    }
    
    // Cast expression
    if (k == NK_CAST) {
      return self.lowerCast(expr);
    }
    
    // New (heap allocation)
    if (k == NK_NEW) {
      return self.lowerNew(expr);
    }
    
    // Range expression
    if (k == NK_RANGE) {
      return self.lowerRange(expr);
    }
    // WP-BC-06: map/set literals and in-expr — stubs return a temp
    if (k == NK_MAP_LIT || k == NK_SET_LIT || k == NK_IN_EXPR) {
      return self.allocTemp();
    }
    // WP-BC-13: format expression — lower inner expression, ignore width/decimals
    if (k == NK_FORMAT_EXPR) {
      return self.lowerExpr(self.nodeC0(expr));
    }
    // WP-BC-14: null coalescing x ?? fallback — lower both sides, return lhs temp
    if (k == NK_NULL_COAL) {
      var lhsTemp: int64 := self.lowerExpr(self.nodeC0(expr));
      self.lowerExpr(self.nodeC1(expr));
      return lhsTemp;
    }
    // WP-BC-14: safe cast x as? T — pass-through (nullable = same repr)
    if (k == NK_SAFE_CAST) {
      return self.lowerExpr(self.nodeC0(expr));
    }
    // WP-BC-18: parallel Array<T>(size) — lower size, return alloc temp
    if (k == NK_SIMD_NEW) {
      // WP-SIMD: parallel Array<f32>(n) → IRO_SIMD_NEW(dest, countTemp). emit_lyxos: aligned mmap,
      // count @ ptr-8, 16-Byte-Alignment (wie ELF cg SIMD_NEW). c1 = Größen-Ausdruck.
      var dest: int64 := self.allocTemp();
      var cnt: int64 := self.lowerExpr(self.nodeC1(expr));
      self.irAddInstrDirect(IRO_SIMD_NEW, dest, cnt, -1, 0);
      return dest;
    }
    // WP-BC-15: regex literal — lower as string constant
    if (k == NK_REGEX_LIT) {
      var dest: int64 := self.allocTemp();
      var strOff: int64 := self.nodeIVal(expr);
      self.irAddInstrDirect(IRO_CONST_STR, dest, -1, -1, strOff);
      return dest;
    }

    // WP-MEM-05: named arg used positionally — evaluate the value (c0)
    if (k == 108) {
      return self.lowerExpr(self.nodeC0(expr));
    }

    // Unknown expression type - allocate temp
    var t: int64 := self.allocTemp();
    return t;
  }
  
  // ------------------------------------------------------------------
  // Binary Operation Lowering
  // ------------------------------------------------------------------
  
  // WP-F64: Float-Literal-Text ("2.0", "1e-3") → IEEE-754-Bits (int64). Repliziert ELF
  // codegen_x86.cg_parseFloat (p[0..len) statt src/off). Lyx kennt keinen strtod-Builtin.
  fn _parseFloatBits(p: pchar, len: int64): int64 {
    var i: int64 := 0;
    var neg: int64 := 0;
    if i < len && StrCharAt(p, i) == 45 { neg := 1; i := i + 1; }
    var num: int64 := 0;
    var den: int64 := 1;
    var intExtra: int64 := 0;
    // '_' ist im ganzen Zahlliteral erlaubt (ebnf.md §1) — jede Ziffernschleife
    // muss ihn überspringen, sonst kürzt sie den Wert stillschweigend.
    while i < len {
      var ic: int64 := StrCharAt(p, i);
      if ic == 95 { i += 1; }
      else if ic >= 48 && ic <= 57 {
        if num < 900000000000000 { num := num * 10 + ic - 48; }
        else { intExtra := intExtra + 1; }
        i += 1;
      } else { break; }
    }
    if i < len && StrCharAt(p, i) == 46 {
      i += 1;
      if intExtra == 0 {
        while i < len && den < 100000000 {
          var fc: int64 := StrCharAt(p, i);
          if fc == 95 { i := i + 1; }
          else if fc >= 48 && fc <= 57 { num := num * 10 + fc - 48; den := den * 10; i := i + 1; }
          else { break; }
        }
      }
      while i < len {
        var sc: int64 := StrCharAt(p, i);
        if sc == 95 || (sc >= 48 && sc <= 57) { i := i + 1; } else { break; }
      }
    }
    var expNeg: int64 := 0;
    var expVal: int64 := 0;
    if i < len && (StrCharAt(p, i) == 101 || StrCharAt(p, i) == 69) {
      i += 1;
      if i < len && StrCharAt(p, i) == 45 { expNeg := 1; i := i + 1; }
      else if i < len && StrCharAt(p, i) == 43 { i := i + 1; }
      while i < len {
        var xc: int64 := StrCharAt(p, i);
        if xc == 95 { i := i + 1; }
        else if xc >= 48 && xc <= 57 { expVal := expVal * 10 + xc - 48; i := i + 1; }
        else { break; }
      }
    }
    if num == 0 { return 0; }
    if intExtra > 0 {
      if expNeg == 0 { expVal := expVal + intExtra; }
      else { if expVal > intExtra { expVal := expVal - intExtra; } else { expNeg := 0; expVal := intExtra - expVal; } }
    }
    var ej: int64 := 0;
    if expNeg == 0 { while ej < expVal && num < 100000000000000 { num := num * 10; ej := ej + 1; } }
    else { while ej < expVal && den < 100000000000000 { den := den * 10; ej := ej + 1; } }
    var n: int64 := num;
    var d: int64 := den;
    var binExp: int64 := 0;
    if expNeg == 0 {
      while ej < expVal { while n > 922337203685477580 { n := n / 2; binExp := binExp + 1; } n := n * 10; ej := ej + 1; }
    } else {
      while ej < expVal { while d > 922337203685477580 { d := d / 2; n := n / 2; } d := d * 10; if n == 0 { return 0; } ej := ej + 1; }
    }
    while n < d && n > 0 {
      if n > 4611686018427387903 { d := d / 2; if d == 0 { d := 1; } } else { n := n * 2; }
      binExp -= 1;
      if binExp < (0 - 1074) { return 0; }
    }
    while d < 4611686018427387903 && n >= d * 2 {
      d := d * 2; binExp := binExp + 1;
      if binExp > 1023 {
        var pInf: int64 := 2047; pInf := pInf << 52;
        if neg != 0 { var smI: int64 := 1; var sI: int64 := 0; while sI < 63 { smI := smI * 2; sI := sI + 1; } return pInf | smI; }
        return pInf;
      }
    }
    n -= d;
    var mant: int64 := 0;
    var bit: int64 := 51;
    while bit >= 0 {
      if n > 4000000000000000 { n := n / 2; d := d / 2; if d == 0 { d := 1; } }
      n := n * 2;
      if n >= d { mant := mant | (1 << bit); n := n - d; }
      bit -= 1;
    }
    var biasedE: int64 := binExp + 1023;
    if biasedE <= 0 { return 0; }
    if biasedE >= 2047 {
      var pInf2: int64 := 2047; pInf2 := pInf2 << 52;
      if neg != 0 { var smJ: int64 := 1; var sJ: int64 := 0; while sJ < 63 { smJ := smJ * 2; sJ := sJ + 1; } return pInf2 | smJ; }
      return pInf2;
    }
    var bits: int64 := (biasedE << 52) | mant;
    if neg != 0 { var sm: int64 := 1; var sk: int64 := 0; while sk < 63 { sm := sm * 2; sk := sk + 1; } bits := bits | sm; }
    return bits;
  }

  // WP-F64: liefert Ausdruck einen f64-Wert? (lit_float, f64-typisierter Ident, f64-Binop,
  // cast→f64, sqrt-Call, unäres -f). Vergleiche/Logik liefern int (0/1). Vorlage: ELF cg_isF64Expr.
  fn _isF64Expr(expr: int64): int64 {
    if expr < 0 { return 0; }
    var k: int64 := self.nodeKind(expr);
    if k == NK_LIT_FLOAT { return 1; }
    if k == NK_IDENT {
      var tn: int64 := self._localTypeNode(self.nodeSVal(expr), self.nodeSLen(expr));
      if tn >= 0 { return self.seq(self.nodeSVal(tn), self.nodeSLen(tn), "f64", 3); }
      return 0;
    }
    if k == NK_CAST {
      var tt: int64 := self.nodeC1(expr);
      if tt >= 0 { return self.seq(self.nodeSVal(tt), self.nodeSLen(tt), "f64", 3); }
      return 0;
    }
    if k == NK_BINOP {
      var bop: int64 := self.nodeIVal(expr);
      if bop >= 79 { return 0; }   // Vergleiche(79-84)/AND(85)/OR(86) → int
      if self._isF64Expr(self.nodeC0(expr)) != 0 { return 1; }
      return self._isF64Expr(self.nodeC1(expr));
    }
    if k == NK_UNOP { return self._isF64Expr(self.nodeC0(expr)); }
    if k == NK_CALL { return self.seq(self.nodeSVal(expr), self.nodeSLen(expr), "sqrt", 4); }
    // WP-SIMD: Element einer parallel-Array<f32> wird als f64 geladen (cvtss2sd) → f64-Ausdruck.
    if k == NK_INDEX { return self._isSimdExpr(self.nodeC0(expr)); }
    return 0;
  }

  // WP-VOLATILE: ist Slot in der volatile-Liste der aktuellen Funktion?
  fn _isVolSlot(slot: int64): int64 {
    var i: int64 := 0;
    while i < self._volSlotN {
      if peek64(self._volSlotList + i * 8) == slot { return 1; }
      i += 1;
    }
    return 0;
  }
  // WP-VOLATILE: Instr idx als volatile markieren (callmode-Sentinel) → DCE behält sie.
  fn _markVolatileInstr(idx: int64): void {
    var ib: int64 := peek64(self.ir + IR_MOD_OFF_INSTRBUF);
    poke64(ib + idx * 80 + IR_INSTR_OFF_CALLMODE, 1448232516);   // 0x564F4C44 "VOLD"
  }

  // WP-SIMD: ist expr eine parallel-Array<f32>-Variable (NK_TYPE_PARALLEL=93)? → SSE2-Vektor-Pfad.
  fn _isSimdExpr(expr: int64): int64 {
    if expr < 0 { return 0; }
    if self.nodeKind(expr) != NK_IDENT { return 0; }
    var tn: int64 := self._localTypeNode(self.nodeSVal(expr), self.nodeSLen(expr));
    if tn < 0 { return 0; }
    if self.nodeKind(tn) == 93 { return 1; }   // NK_TYPE_PARALLEL
    return 0;
  }

  fn lowerBinOp(expr: int64): int64 {
    var op: int64 := self.nodeIVal(expr);
    var t1: int64 := self.lowerExpr(self.nodeC0(expr));
    var t2: int64 := self.lowerExpr(self.nodeC1(expr));
    var dest: int64 := self.allocTemp();
    // WP-AND-upstream-fix v4: previously the helper just allocated a temp
    // and returned it -- every binop in IR mode was silently dropping its
    // operation. Map the parser's TK_* opcode (stored in iVal by the
    // parser) to the corresponding IRO_* and emit the 3-address instruction.
    var iro: int64 := -1;
    if op == 70  { iro := IRO_ADD; }    // TK_PLUS
    else if op == 71  { iro := IRO_SUB; }   // TK_MINUS
    else if op == 72  { iro := IRO_MUL; }   // TK_STAR
    else if op == 73  { iro := IRO_DIV; }   // TK_SLASH
    else if op == 74  { iro := IRO_MOD; }   // TK_PERCENT
    else if op == 79  { iro := IRO_CMP_EQ; }  // TK_EQ2 (==)
    else if op == 80  { iro := IRO_CMP_NEQ; } // TK_NEQ
    else if op == 81  { iro := IRO_CMP_LT; }  // TK_LT
    else if op == 82  { iro := IRO_CMP_LE; }  // TK_LE
    else if op == 83  { iro := IRO_CMP_GT; }  // TK_GT
    else if op == 84  { iro := IRO_CMP_GE; }  // TK_GE
    else if op == 90  { iro := IRO_AND; }   // TK_BITAND
    else if op == 91  { iro := IRO_OR;  }   // TK_BITOR
    else if op == 89  { iro := IRO_XOR; }   // TK_BITXOR
    else if op == 93  { iro := IRO_SHL; }   // TK_SHL
    else if op == 94  { iro := IRO_SHR; }   // TK_SHR
    else if op == 85  { iro := IRO_AND; }   // TK_AND (&&; treat as bitwise for now)
    else if op == 86  { iro := IRO_OR;  }   // TK_OR (||)
    if iro >= 0 {
      // WP-F64: f64-Operanden → Float-Ops (sonst Integer-Bit-Arithmetik der IEEE-Muster = Garbage).
      if iro == IRO_ADD || iro == IRO_SUB || iro == IRO_MUL || iro == IRO_DIV {
        if self._isF64Expr(expr) != 0 {
          if iro == IRO_ADD { iro := IRO_FADD; }
          else if iro == IRO_SUB { iro := IRO_FSUB; }
          else if iro == IRO_MUL { iro := IRO_FMUL; }
          else { iro := IRO_FDIV; }
        }
      }
      // WP-SIMD: beide Operanden parallel-Array<f32> → vektorisierte SSE2-Op.
      if self._isSimdExpr(self.nodeC0(expr)) != 0 && self._isSimdExpr(self.nodeC1(expr)) != 0 {
        // Arithmetik ADD(10)/SUB(11)/MUL(12)/DIV(13) → IRO_SIMD_ADD..DIV(122-125) = +112.
        if iro == IRO_ADD || iro == IRO_SUB || iro == IRO_MUL || iro == IRO_DIV { iro := iro + 112; }
        // Bitwise (andps/orps/xorps).
        else if iro == IRO_AND { iro := IRO_SIMD_AND; }
        else if iro == IRO_OR  { iro := IRO_SIMD_OR; }
        else if iro == IRO_XOR { iro := IRO_SIMD_XOR; }
        // Vergleich CMP_x(30-35) → SIMD_CMP_x(130-135) = +100 (cmpps, Masken-Vektor).
        else if iro >= IRO_CMP_EQ && iro <= IRO_CMP_GE { iro := iro + 100; }
      }
      // WP-F64-CMP: f64-Vergleich → IRO_FCMP_* (ucomisd) statt Integer-CMP der Bits (nur für
      // positive f64 korrekt; negative Ordering kaputt). CMP_x(30..35) → FCMP_x(40..45) = +10.
      if iro >= IRO_CMP_EQ && iro <= IRO_CMP_GE {
        if self._isF64Expr(self.nodeC0(expr)) != 0 || self._isF64Expr(self.nodeC1(expr)) != 0 {
          iro += 10;
        }
      }
      // WP-OPCODE-REST: Integer-Div/Mod durch 0 → kontrollierter ASSERT_NOT_ZERO (Panic) statt SIGFPE.
      if iro == IRO_DIV || iro == IRO_MOD {
        self.irAddInstrDirect(IRO_ASSERT_NOT_ZERO, -1, t2, -1, 0);
      }
      self.irAddInstrDirect(iro, dest, t1, t2, 0);
    }
    return dest;
  }

  // WP-OPCODE-REST: lokalen Slot eines Namens auflösen (Locals shadowing-latest, dann Params).
  // -1 wenn kein lokaler/Param. Für &local (Adresse statt Wert).
  fn _resolveLocalSlotForAddr(idName: pchar, idLen: int64): int64 {
    var idPtrL: int64 := (idName) as int64;
    var lnI: int64 := self.localNameCnt - 1;
    while lnI >= 0 {
      var lnRec: int64 := self.localNameBuf + lnI * 24;
      var lnLen: int64 := peek64(lnRec + LOCAL_REC_OFF_NAMELEN);
      if lnLen == idLen {
        var lnPtr: int64 := (self.src as int64) + peek64(lnRec + 0);
        var m: int64 := 1; var j: int64 := 0;
        while j < idLen { if m != 0 { if peek8(lnPtr + j) != peek8(idPtrL + j) { m := 0; } } j := j + 1; }
        if m != 0 { return peek64(lnRec + LOCAL_REC_OFF_SLOT); }
      }
      lnI -= 1;
    }
    if self.curFunc >= 0 {
      var pnode: int64 := self.nodeC0(self.curFunc);
      var pidx: int64 := 0;
      while pnode >= 0 {
        if self.nodeKind(pnode) == NK_PARAM {
          var pnLen: int64 := self.nodeSLen(pnode);
          if pnLen == idLen {
            var pnPtr: int64 := (self.nodeSVal(pnode)) as int64;
            var m: int64 := 1; var j: int64 := 0;
            while j < idLen { if m != 0 { if peek8(pnPtr + j) != peek8(idPtrL + j) { m := 0; } } j := j + 1; }
            if m != 0 { return pidx + self.methodParamBase; }
          }
          pidx += 1;
        }
        pnode := self.nodeNext(pnode);
      }
    }
    return 0 - 1;
  }

  // ------------------------------------------------------------------
  // Unary Operation Lowering
  // ------------------------------------------------------------------

  fn lowerUnOp(expr: int64): int64 {
    var op: int64 := self.nodeIVal(expr);
    // WP-ADDR: @local (TK_AT, op==111, unär — kanonischer Adresse-von-Operator wie ELF) → ADRESSE
    // des Slots via IRO_LOAD_LOCAL_ADDR. Nur für lokale/Param-Identifier; sonst Fallback = Wert.
    if op == 111 {
      var aOperand: int64 := self.nodeC0(expr);
      if self.nodeKind(aOperand) == NK_IDENT {
        var aSlot: int64 := self._resolveLocalSlotForAddr(self.nodeSVal(aOperand), self.nodeSLen(aOperand));
        if aSlot >= 0 {
          var aDest: int64 := self.allocTemp();
          self.irAddInstrDirect(IRO_LOAD_LOCAL_ADDR, aDest, aSlot, -1, 0);
          return aDest;
        }
      }
    }
    var t1: int64 := self.lowerExpr(self.nodeC0(expr));
    var dest: int64 := self.allocTemp();
    // WP-AND-upstream-fix v6: emit actual ops. Map the parser's TK_*
    // operator to the corresponding IRO_*.
    //   TK_MINUS  (-x)   -> IRO_NEG
    //   TK_NOT    (!x)   -> IRO_NOT     (logical negation)
    //   TK_BITNOT (~x)   -> IRO_BITNOT  (bitwise complement)
    //   TK_BITAND (&x)   -> address-of: needs IRO_LOAD_LOCAL_ADDR-style
    //     emission; current ir_lower has no address-of pathway, so we
    //     fall through and return the loaded value (a known compromise;
    //     real address-taking should arrive with NK_FIELD's & operator).
    var iro: int64 := -1;
    if op == 71 { iro := IRO_NEG;    }   // TK_MINUS
    else if op == 87 { iro := IRO_NOT;    }   // TK_NOT
    else if op == 92 { iro := IRO_BITNOT; }   // TK_BITNOT
    // WP-SIMD: -vec auf parallel-Array<f32> → IRO_SIMD_NEG (packed Vorzeichenbit-Flip).
    if iro == IRO_NEG { if self._isSimdExpr(self.nodeC0(expr)) != 0 { iro := IRO_SIMD_NEG; } }
    if iro >= 0 {
      self.irAddInstrDirect(iro, dest, t1, -1, 0);
    }
    return dest;
  }
  
  fn _unused_placeholder_lx10(): void {
    // Slot-Padding: IRLower braucht gerade Methodenanzahl für VMT-Alignment
  }

  // ------------------------------------------------------------------
  // Function Call Lowering
  // ------------------------------------------------------------------

  fn lowerCall(expr: int64): int64 {
    // WP-2.1: generic calls (iVal=2) go through the monomorphization path
    if (self.nodeIVal(expr) == 2) {
      return self.lowerGenericCall(expr);
    }
    // ARM64-OOP: Methoden-Call (iVal=1): c0=Objekt, sVal=Methode, c1=Args.
    // Statische Dispatch: Klasse von c0 auflösen → mangled "Class_method" → IRO_CALL
    // mit self=Objekt als arg0, dann explizite Args (im argBase-Block, vgl. nested-call).
    if (self.nodeIVal(expr) == 1) {
      var mcDest:     int64 := self.allocTemp();
      var mcBaseNode: int64 := self.nodeC0(expr);
      // WP-A1: obj.field(args), wobei `field` ein Klassen-FELD (Fn-Pointer) ist (keine Methode).
      // → Feld laden (= Fn-Adresse) + IRO_CALL_INDIRECT (plain, KEIN self). Methoden sind keine
      // Felder → _instanceFieldOffset(-1) → normaler Dispatch. Vorher: Methoden-Mangle ins Leere.
      var fpName: pchar := self.nodeSVal(expr);
      var fpNameL: int64 := self.nodeSLen(expr);
      var fpOff: int64 := self._instanceFieldOffset(mcBaseNode, fpName, fpNameL);
      if fpOff >= 0 && self._fieldIsMethodType(mcBaseNode, fpName, fpNameL) != 0 {
        // B2 fat-call: p=[base+off]; code=[p+0]; self=data=[p+8]→slot0; Args→slot1..; CALL_INDIRECT.
        var mfBase: int64 := self.lowerExpr(mcBaseNode);
        var mfP: int64 := self.allocTemp();
        self.irAddInstrDirect(IRO_LOAD_FIELD, mfP, mfBase, fpOff, 0);
        var mfCode: int64 := self.allocTemp();
        self.irAddInstrDirect(IRO_LOAD_FIELD, mfCode, mfP, 0, 0);
        var mfData: int64 := self.allocTemp();
        self.irAddInstrDirect(IRO_LOAD_FIELD, mfData, mfP, 8, 0);
        self.irAddInstrDirect(IRO_STORE_LOCAL, 0, mfData, -1, 0);   // self → slot 0
        var mfArg: int64 := self.nodeC1(expr); var mfI: int64 := 1;
        while mfArg >= 0 {
          var mfAT: int64 := self.lowerExpr(mfArg);
          self.irAddInstrDirect(IRO_STORE_LOCAL, mfI, mfAT, -1, 0);
          mfI += 1; mfArg := self.nodeNext(mfArg);
        }
        self.irAddInstrDirect(IRO_CALL_INDIRECT, mcDest, mfCode, -1, mfI);
        return mcDest;
      }
      if fpOff >= 0 {
        var fpBase: int64 := self.lowerExpr(mcBaseNode);
        var fpFn: int64 := self.allocTemp();
        self.irAddInstrDirect(IRO_LOAD_FIELD, fpFn, fpBase, fpOff, 0);
        var fpArg: int64 := self.nodeC1(expr); var fpI: int64 := 0;
        while fpArg >= 0 {
          var fpAT: int64 := self.lowerExpr(fpArg);
          self.irAddInstrDirect(IRO_STORE_LOCAL, fpI, fpAT, -1, 0);
          fpI += 1; fpArg := self.nodeNext(fpArg);
        }
        self.irAddInstrDirect(IRO_CALL_INDIRECT, mcDest, fpFn, -1, fpI);
        return mcDest;
      }
      // WP-XMOD-OOP: Klassenname + lokales decl holen. localDecl>=0 = same-module (Fast-Path,
      // kein Registry); localDecl<0 = importiert. Registry (globale type-id) nur für VIRTUELLE
      // Dispatch nötig (type-id-Konsistenz cross-module) — non-virtuell läuft per Mangle-by-name.
      var mcTn:      int64 := self._baseTypeNode(mcBaseNode);
      var mcCName:   pchar := 0 as pchar;
      var mcCNameL:  int64 := 0;
      var mcLocal:   int64 := 0 - 1;
      if mcTn >= 0 {
        mcCName := self.nodeSVal(mcTn); mcCNameL := self.nodeSLen(mcTn);
        if self.nodeKind(mcTn) == NK_TYPE_DECL { mcLocal := mcTn; }
        else { mcLocal := self._findTypeDecl(mcCName, mcCNameL); }
      }
      if mcCNameL > 0 {
        var mNameP: pchar := self.nodeSVal(expr);
        var mNameL: int64 := self.nodeSLen(expr);
        // Virtuell? Fast lokal, sonst via Registry (importiert).
        var mcVirt: int64 := 0;
        if mcLocal >= 0 { mcVirt := self._methodVirtual(mcLocal, mNameP, mNameL); }
        else { mcVirt := self._tregMethodVirtualG(self._tregFind(mcCName, mcCNameL), mNameP, mNameL); }
        // Arg-Block: self @ argBase, dann explizite Args.
        var mcArgBase: int64 := self.tempCount;
        var mcRsv: int64 := 0;
        while mcRsv < 8 { self.allocTemp(); mcRsv := mcRsv + 1; }
        var mcSelf: int64 := self.lowerExpr(mcBaseNode);
        self.irAddInstrDirect(IRO_STORE_LOCAL, mcArgBase, mcSelf, -1, 0);
        var mcCnt: int64 := 1;
        var mcArg: int64 := self.nodeC1(expr);
        while mcArg >= 0 {
          var mcAT: int64 := self.lowerExpr(mcArg);
          self.irAddInstrDirect(IRO_STORE_LOCAL, mcArgBase + mcCnt, mcAT, -1, 0);
          mcCnt += 1;
          mcArg := self.nodeNext(mcArg);
        }
        if mcVirt == 0 {
          // STATISCHE Dispatch: nächste Definition ab decl (Mangle by-name, cross-module via funcBuffer).
          var mcIdx: int64 := 0 - 1;
          if mcLocal >= 0 { mcIdx := self._resolveMethodIdx(mcLocal, mNameP, mNameL); }
          else {
            var sbg: int64 := self._tregFind(mcCName, mcCNameL);
            if sbg >= 0 { mcIdx := self._tregResolveMethodIdxG(sbg, mNameP, mNameL); }
            else {
              var sMang: int64 := self._methodMangle(mcCName, mcCNameL, mNameP, mNameL);
              mcIdx := self._findFuncByName(sMang as pchar, mcCNameL + 1 + mNameL);
            }
          }
          if mcIdx >= 0 { self.irAddInstrDirect(IRO_CALL, mcDest, mcIdx, mcArgBase, mcCnt); }
        } else {
          var baseG: int64 := self._tregFind(mcCName, mcCNameL);
          // WP-XMOD-OOP: VIRTUELLE Switch-Dispatch über type-id @ obj[0] in GLOBALER Registry-Space
          // (cross-module Subklassen). tid==g → g's Override; Fallback = baseG's Auflösung.
          var tidTemp: int64 := self.allocTemp();
          self.irAddInstrDirect(IRO_LOAD_FIELD, tidTemp, mcSelf, 0, 0);   // tid = obj[0]
          var vEnd: int64 := self.genLabel();
          var gi: int64 := 0;
          while gi < self._tregN {
            if self._extendsClassG(gi, baseG) != 0 {
              if self._tregOwnHasMethodG(gi, mNameP, mNameL) != 0 {
                var subIdx: int64 := self._tregResolveMethodIdxG(gi, mNameP, mNameL);
                if subIdx >= 0 {
                  var cTid: int64 := self.allocTemp();
                  self.irAddInstrDirect(IRO_CONST_INT, cTid, -1, -1, gi);
                  var cmpT: int64 := self.allocTemp();
                  self.irAddInstrDirect(IRO_CMP_EQ, cmpT, tidTemp, cTid, 0);
                  var vNext: int64 := self.genLabel();
                  self.irEmitBrFalse(cmpT, vNext);
                  self.irAddInstrDirect(IRO_CALL, mcDest, subIdx, mcArgBase, mcCnt);
                  self.irEmitJmp(vEnd);
                  self.irEmitLabel(vNext);
                }
              }
            }
            gi += 1;
          }
          var baseIdx: int64 := self._tregResolveMethodIdxG(baseG, mNameP, mNameL);
          if baseIdx >= 0 { self.irAddInstrDirect(IRO_CALL, mcDest, baseIdx, mcArgBase, mcCnt); }
          self.irEmitLabel(vEnd);
        }
      }
      return mcDest;
    }
    // NK_CALL: sVal = function name, C0 = first argument (linked via nodeNext)
    var dest: int64 := self.allocTemp();
    var fname: pchar := self.nodeSVal(expr);
    var fnlen: int64 := self.nodeSLen(expr);
    var arg0: int64 := self.nodeC0(expr);

    // WP-AND-upstream-fix: _indirect_call_N(fnPtr, ...args) — N in 0..4.
    // First user-syntax argument is the function pointer; remaining N are
    // the call args. We lower the fn pointer to a temp, lower each user arg
    // to a temp, copy those into slots 0..N-1 (the AArch64 emitter loads
    // those slots into x0..x7 right before BLR), and emit IRO_CALL_INDIRECT
    // with imm = N. NOTE: this clobbers the function's own slots 0..N-1 —
    // callers (typically thin JNI / libandroid wrappers with no live locals
    // other than the args they want to forward) should be written with that
    // in mind. Once a full callee-saved-spill pass lands, this restriction
    // disappears.
    var indN: int64 := -1;
    if (self.seq(fname, fnlen, "_indirect_call_0", 16)) { indN := 0; }
    else if (self.seq(fname, fnlen, "_indirect_call_1", 16)) { indN := 1; }
    else if (self.seq(fname, fnlen, "_indirect_call_2", 16)) { indN := 2; }
    else if (self.seq(fname, fnlen, "_indirect_call_3", 16)) { indN := 3; }
    else if (self.seq(fname, fnlen, "_indirect_call_4", 16)) { indN := 4; }
    if (indN >= 0) {
      if (arg0 < 0) { return dest; }
      var fnTemp: int64 := self.lowerExpr(arg0);
      var argNode: int64 := self.nodeNext(arg0);
      var i: int64 := 0;
      while (i < indN && argNode >= 0) {
        var aTemp: int64 := self.lowerExpr(argNode);
        // Store argTemp into slot `i` so the AArch64 emitter loads it into x{i}.
        self.irAddInstrDirect(IRO_STORE_LOCAL, i, aTemp, -1, 0);
        argNode := self.nodeNext(argNode);
        i += 1;
      }
      // src1 = slot index of fn pointer, imm = arg count.
      self.irAddInstrDirect(IRO_CALL_INDIRECT, dest, fnTemp, -1, indN);
      return dest;
    }

    // WP-BC-01: sqrt(f64) → IRO_FSQRT (sqrtsd in codegen)
    if (self.seq(fname, fnlen, "sqrt", 4)) {
      var src: int64 := dest;
      if (arg0 >= 0) { src := self.lowerExpr(arg0); }
      self.irAddInstrDirect(IRO_FSQRT, dest, src, -1, 0);
      return dest;
    }

    // WP-BC-01: assert(cond) / assertTrue(cond) → IRO_ASSERT_TRUE
    if (self.seq(fname, fnlen, "assert", 6) || self.seq(fname, fnlen, "assertTrue", 10)) {
      if (arg0 >= 0) {
        var condSrc: int64 := self.lowerExpr(arg0);
        self.irAddInstrDirect(IRO_ASSERT_TRUE, -1, condSrc, -1, 0);
      }
      return dest;
    }

    // WP-BC-01: assertNotNull(ptr) → IRO_ASSERT_NOT_NULL
    if (self.seq(fname, fnlen, "assertNotNull", 13)) {
      if (arg0 >= 0) {
        var ptrSrc: int64 := self.lowerExpr(arg0);
        self.irAddInstrDirect(IRO_ASSERT_NOT_NULL, -1, ptrSrc, -1, 0);
      }
      return dest;
    }

    // WP-BC-01: assertNotZero(val) → IRO_ASSERT_NOT_ZERO
    if (self.seq(fname, fnlen, "assertNotZero", 13)) {
      if (arg0 >= 0) {
        var valSrc: int64 := self.lowerExpr(arg0);
        self.irAddInstrDirect(IRO_ASSERT_NOT_ZERO, -1, valSrc, -1, 0);
      }
      return dest;
    }

    // WP-BC-01: assertBounds(value, bound) → IRO_ASSERT_BOUNDS (ImmInt = bound temp)
    if (self.seq(fname, fnlen, "assertBounds", 12)) {
      var arg1: int64 := -1;
      if (arg0 >= 0) { arg1 := self.nodeNext(arg0); }
      if (arg0 >= 0) {
        var valSrc:   int64 := self.lowerExpr(arg0);
        var boundSrc: int64 := -1;
        if (arg1 >= 0) { boundSrc := self.lowerExpr(arg1); }
        self.irAddInstrDirect(IRO_ASSERT_BOUNDS, -1, valSrc, boundSrc, 0);
      }
      return dest;
    }

    // WP-BC-40: Profiling builtins — x86_64 handles these in codegen; IR path emits NOPs
    if (self.seq(fname, fnlen, "profile_enter", 13)) {
      self.irAddInstrDirect(IRO_PROFILE_ENTER, -1, -1, -1, 0);
      return dest;
    }
    if (self.seq(fname, fnlen, "profile_leave", 13)) {
      self.irAddInstrDirect(IRO_PROFILE_LEAVE, -1, -1, -1, 0);
      return dest;
    }
    if (self.seq(fname, fnlen, "profile_report", 14)) {
      self.irAddInstrDirect(IRO_PROFILE_REPORT, -1, -1, -1, 0);
      return dest;
    }

    // WP-BC-39: Inspect(expr) → IRO_INSPECT with variable name in string table
    if (self.seq(fname, fnlen, "Inspect", 7)) {
      if (arg0 >= 0) {
        var valSrc: int64 := self.lowerExpr(arg0);
        var nameOff: int64 := 0;
        if (self.nodeKind(arg0) == NK_IDENT) {
          nameOff := self.irAddString(self.nodeSVal(arg0), self.nodeSLen(arg0));
        } else {
          nameOff := self.irAddString("?"c, 1);
        }
        var instrIdx: int64 := self.irAddInstrDirect(IRO_INSPECT, -1, valSrc, -1, 0);
        self.irSetStrOff(instrIdx, nameOff);
      }
      return dest;
    }

    // PrintLn("literal") / Print("literal"): same mechanism as PrintStr below,
    // but PrintLn appends '\n'. Inline — adding helper methods shifts vtable.
    if ((self.seq(fname, fnlen, "PrintLn", 7) || self.seq(fname, fnlen, "Print", 5)) &&
        arg0 >= 0 && self.nodeKind(arg0) == NK_LIT_STR) {
      var plAddNl: int64 := 0;
      if self.seq(fname, fnlen, "PrintLn", 7) { plAddNl := 1; }
      var plStart: int64 := (self.nodeSVal(arg0) as int64) + 1;
      var plSrcLen: int64 := self.nodeSLen(arg0) - 2;
      if (plSrcLen < 0) { plSrcLen := 0; }
      var plBuf: int64 := alloc(plSrcLen + 9);
      var plOut: int64 := 0;
      var plI: int64 := 0;
      while plI < plSrcLen {
        var plC: int64 := peek8(plStart + plI);
        if plC == 92 && plI + 1 < plSrcLen {
          var plN: int64 := peek8(plStart + plI + 1);
          if plN == 110      { plC := 10; plI := plI + 1; }
          else if plN == 116 { plC := 9;  plI := plI + 1; }
          else if plN == 114 { plC := 13; plI := plI + 1; }
          else if plN == 92  { plC := 92; plI := plI + 1; }
          else if plN == 34  { plC := 34; plI := plI + 1; }
          else if plN == 48  { plC := 0;  plI := plI + 1; }
        }
        poke8(plBuf + plOut, plC);
        plOut += 1;
        plI += 1;
      }
      if plAddNl != 0 { poke8(plBuf + plOut, 10); plOut := plOut + 1; }
      var plStrOff: int64 := self.irAddString(plBuf as pchar, plOut);
      var plA: int64 := self.allocTemp();
      self.irAddInstrDirect(IRO_CONST_STR, plA, -1, -1, plStrOff);
      self.irAddInstrDirect(IRO_STORE_LOCAL, 0, plA, -1, 0);
      var plL: int64 := self.allocTemp();
      self.irAddInstrDirect(IRO_CONST_INT, plL, -1, -1, plOut);
      self.irAddInstrDirect(IRO_STORE_LOCAL, 1, plL, -1, 0);
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, -1, -1, 1);
      return dest;
    }

    // PrintStr("literal"): the arm64/IR builtin path needs the string ADDRESS
    // in slot 0 and its LENGTH in slot 1 (emitBuiltinCall id 1 does
    // write(1, slot0, slot1)). Extract the literal, process escapes at compile
    // time, intern it in the IR string table, and emit CONST_STR + CONST_INT.
    // Inline (no IRLower helper method — that shifts the vtable, breaks seed).
    if (self.seq(fname, fnlen, "PrintStr", 8) && arg0 >= 0 && self.nodeKind(arg0) == NK_LIT_STR) {
      var psStart: int64 := (self.nodeSVal(arg0) as int64) + 1;   // skip opening quote
      var psSrcLen: int64 := self.nodeSLen(arg0) - 2;             // drop both quotes
      if (psSrcLen < 0) { psSrcLen := 0; }
      var psBuf: int64 := alloc(psSrcLen + 8);
      var psOut: int64 := 0;
      var psI: int64 := 0;
      while psI < psSrcLen {
        var psC: int64 := peek8(psStart + psI);
        if psC == 92 && psI + 1 < psSrcLen {       // backslash escape
          var psN: int64 := peek8(psStart + psI + 1);
          if psN == 110      { psC := 10; psI := psI + 1; }   // \n
          else if psN == 116 { psC := 9;  psI := psI + 1; }   // \t
          else if psN == 114 { psC := 13; psI := psI + 1; }   // \r
          else if psN == 92  { psC := 92; psI := psI + 1; }   // \\
          else if psN == 34  { psC := 34; psI := psI + 1; }   // \"
          else if psN == 48  { psC := 0;  psI := psI + 1; }   // \0
        }
        poke8(psBuf + psOut, psC);
