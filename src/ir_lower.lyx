  fn _hasVmt(typeDecl: int64): int64 {
    var tc: int64 := typeDecl;
    while tc >= 0 {
      var m: int64 := self.nodeC1(tc);
      while m >= 0 {
        if self.nodeKind(m) == NK_FUNC_DECL { if (self.nodeIVal(m) & 14) != 0 { return 1; } }
        m := self.nodeNext(m);
