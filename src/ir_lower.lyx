  // weil _findTypeDecl nur das aktuelle Modul scannt; Methoden-Dispatch braucht aber nur
  // den Namen für statische Mangle "Class_method" (funcBuffer ist cross-module via _findFuncByName).
  fn _baseTypeNode(baseNode: int64): int64 {
    if self.nodeKind(baseNode) != NK_IDENT { return 0 - 1; }
    if self.methodParamBase != 0 && self.nodeSLen(baseNode) == 4 {
      var sp: int64 := (self.nodeSVal(baseNode)) as int64;
      if peek8(sp) == 115 && peek8(sp+1) == 101 && peek8(sp+2) == 108 && peek8(sp+3) == 102 {
        return self.curMethodClassType;
