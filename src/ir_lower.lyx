    if t < 0 { return 0; }
    if (self.nodeIVal(t) & 2) == 0 { return 0; }
    var body: int64 := self.nodeC0(t);
    if body < 0 { return 0; }
    if self.nodeKind(body) == NK_METHOD_PTR { return 1; }
    return 0;
  }
