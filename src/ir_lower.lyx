// AST node field offsets (node size = 88 bytes)
con NODE_OFF_C0:     int64 := 8;
con NODE_OFF_C1:     int64 := 16;
con NODE_OFF_C2:     int64 := 24;
con NODE_OFF_C3:     int64 := 32;
con NODE_OFF_NEXT:   int64 := 40;
con NODE_OFF_IVAL:   int64 := 56;
con NODE_OFF_SVAL:   int64 := 64;
con NODE_OFF_SLEN:   int64 := 72;

// localNameBuf entry (24 bytes): nameOff + nameLen + slot
con LOCAL_REC_SIZE:       int64 := 24;
con LOCAL_REC_OFF_NAMELEN: int64 := 8;
con LOCAL_REC_OFF_SLOT:   int64 := 16;

// globalNameBuf entry (32 bytes): nameOff + nameLen + idx + init
con GLOBAL_REC_SIZE:       int64 := 32;
con GLOBAL_REC_OFF_NAMELEN: int64 := 8;
con GLOBAL_REC_OFF_IDX:    int64 := 16;
con GLOBAL_REC_OFF_INIT:   int64 := 24;

// genFuncBuf entry (24 bytes): namePtr + nameLen + nodeIdx
con GENFUNC_REC_SIZE:       int64 := 24;
con GENFUNC_REC_OFF_NAMELEN: int64 := 8;
con GENFUNC_REC_OFF_NODEIDX: int64 := 16;

// pendingGenBuf entry (32 bytes): mangledPtr + mangledLen + genFuncNodeIdx + emitted
con PENDING_REC_SIZE:         int64 := 32;
con PENDING_REC_OFF_MANGLEN:  int64 := 8;
con PENDING_REC_OFF_NODEIDX:  int64 := 16;
con PENDING_REC_OFF_EMITTED:  int64 := 24;

