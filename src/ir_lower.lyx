      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, k32fB, -1, 256); return dest;
    }
    // lyxc→LyxOS Gruppe C: pure-compute Intrinsics (peek16/poke16/memcpy), argBase-Konvention.
    if (self.seq(fname, fnlen, "peek16", 6)) {
      var p16B: int64 := self.tempCount; var p16R: int64 := 0; while p16R < 4 { self.allocTemp(); p16R := p16R + 1; }
      if arg0 >= 0 { var t: int64 := self.lowerExpr(arg0); self.irAddInstrDirect(IRO_STORE_LOCAL, p16B, t, -1, 0); }
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, p16B, -1, 208); return dest;
    }
    if (self.seq(fname, fnlen, "poke16", 6)) {
      var po16B: int64 := self.tempCount; var po16R: int64 := 0; while po16R < 4 { self.allocTemp(); po16R := po16R + 1; }
      var po16A: int64 := arg0;
      if po16A >= 0 { var t: int64 := self.lowerExpr(po16A); self.irAddInstrDirect(IRO_STORE_LOCAL, po16B, t, -1, 0); po16A := self.nodeNext(po16A); }
      if po16A >= 0 { var t: int64 := self.lowerExpr(po16A); self.irAddInstrDirect(IRO_STORE_LOCAL, po16B + 1, t, -1, 0); }
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, po16B, -1, 209); return dest;
    }
    if (self.seq(fname, fnlen, "memcpy", 6) || self.seq(fname, fnlen, "MemCopy", 7)) {
      var mcB: int64 := self.tempCount; var mcR: int64 := 0; while mcR < 4 { self.allocTemp(); mcR := mcR + 1; }
      var mcA: int64 := arg0;
      if mcA >= 0 { var t: int64 := self.lowerExpr(mcA); self.irAddInstrDirect(IRO_STORE_LOCAL, mcB, t, -1, 0); mcA := self.nodeNext(mcA); }
      if mcA >= 0 { var t: int64 := self.lowerExpr(mcA); self.irAddInstrDirect(IRO_STORE_LOCAL, mcB + 1, t, -1, 0); mcA := self.nodeNext(mcA); }
      if mcA >= 0 { var t: int64 := self.lowerExpr(mcA); self.irAddInstrDirect(IRO_STORE_LOCAL, mcB + 2, t, -1, 0); }
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, mcB, -1, 210); return dest;
    }
    // lyxc→LyxOS Gruppe A: POSIX-File-Builtins → flache §10.4-Syscalls (KEIN dir_fd;
    // implementierter Kernel ist flach). Args in hohen argBase-Block, src1=argBase.
    // 1-arg: close(221)/unlink(225)/exit(227); mkdir(226) nur path (mode verworfen).
    if (self.seq(fname, fnlen, "close", 5) || self.seq(fname, fnlen, "unlink", 6) ||
        self.seq(fname, fnlen, "exit", 4)  || self.seq(fname, fnlen, "mkdir", 5)) {
      var a1B: int64 := self.tempCount; var a1R: int64 := 0; while a1R < 2 { self.allocTemp(); a1R := a1R + 1; }
      if arg0 >= 0 { var t: int64 := self.lowerExpr(arg0); self.irAddInstrDirect(IRO_STORE_LOCAL, a1B, t, -1, 0); }
      var a1id: int64 := 221;
      if self.seq(fname, fnlen, "unlink", 6) { a1id := 225; }
      if self.seq(fname, fnlen, "exit", 4)   { a1id := 227; }
      if self.seq(fname, fnlen, "mkdir", 5)  { a1id := 226; }
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, a1B, -1, a1id); return dest;
    }
    // 2-arg: rename(224)
    if (self.seq(fname, fnlen, "rename", 6)) {
      var a2B: int64 := self.tempCount; var a2R: int64 := 0; while a2R < 4 { self.allocTemp(); a2R := a2R + 1; }
      var a2A: int64 := arg0;
      if a2A >= 0 { var t: int64 := self.lowerExpr(a2A); self.irAddInstrDirect(IRO_STORE_LOCAL, a2B, t, -1, 0); a2A := self.nodeNext(a2A); }
      if a2A >= 0 { var t: int64 := self.lowerExpr(a2A); self.irAddInstrDirect(IRO_STORE_LOCAL, a2B + 1, t, -1, 0); }
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, a2B, -1, 224); return dest;
    }
    // 3-arg: open(220)/read(222)/write(223)
    if (self.seq(fname, fnlen, "open", 4) || self.seq(fname, fnlen, "read", 4) ||
        self.seq(fname, fnlen, "write", 5)) {
      var a3B: int64 := self.tempCount; var a3R: int64 := 0; while a3R < 4 { self.allocTemp(); a3R := a3R + 1; }
      var a3A: int64 := arg0;
      if a3A >= 0 { var t: int64 := self.lowerExpr(a3A); self.irAddInstrDirect(IRO_STORE_LOCAL, a3B, t, -1, 0); a3A := self.nodeNext(a3A); }
      if a3A >= 0 { var t: int64 := self.lowerExpr(a3A); self.irAddInstrDirect(IRO_STORE_LOCAL, a3B + 1, t, -1, 0); a3A := self.nodeNext(a3A); }
      if a3A >= 0 { var t: int64 := self.lowerExpr(a3A); self.irAddInstrDirect(IRO_STORE_LOCAL, a3B + 2, t, -1, 0); }
      var a3id: int64 := 220;
      if self.seq(fname, fnlen, "read", 4)  { a3id := 222; }
      if self.seq(fname, fnlen, "write", 5) { a3id := 223; }
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, a3B, -1, a3id); return dest;
    }
    // lyxc→LyxOS Kat-B: getdents64(fd,buf,n) → read-on-dirfd (sys_read=0, liefert DirEntry-Array).
    if (self.seq(fname, fnlen, "getdents64", 10)) {
      var gdB: int64 := self.tempCount; var gdR: int64 := 0; while gdR < 4 { self.allocTemp(); gdR := gdR + 1; }
      var gdA: int64 := arg0;
      if gdA >= 0 { var t: int64 := self.lowerExpr(gdA); self.irAddInstrDirect(IRO_STORE_LOCAL, gdB, t, -1, 0); gdA := self.nodeNext(gdA); }
      if gdA >= 0 { var t: int64 := self.lowerExpr(gdA); self.irAddInstrDirect(IRO_STORE_LOCAL, gdB + 1, t, -1, 0); gdA := self.nodeNext(gdA); }
      if gdA >= 0 { var t: int64 := self.lowerExpr(gdA); self.irAddInstrDirect(IRO_STORE_LOCAL, gdB + 2, t, -1, 0); }
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, gdB, -1, 222); return dest;
    }
    // lyxc→LyxOS Kat-B: clock_gettime(clk_id, ts) → sys_time_ns + timespec-Split (id 211).
    if (self.seq(fname, fnlen, "clock_gettime", 13)) {
      var cgB: int64 := self.tempCount; var cgR: int64 := 0; while cgR < 4 { self.allocTemp(); cgR := cgR + 1; }
      var cgA: int64 := arg0;
      if cgA >= 0 { var t: int64 := self.lowerExpr(cgA); self.irAddInstrDirect(IRO_STORE_LOCAL, cgB, t, -1, 0); cgA := self.nodeNext(cgA); }
      if cgA >= 0 { var t: int64 := self.lowerExpr(cgA); self.irAddInstrDirect(IRO_STORE_LOCAL, cgB + 1, t, -1, 0); }
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, cgB, -1, 211); return dest;
    }
    // WP-WSP: Kernel-Systemprimitive. No-arg cpu-ctrl/Fences (id 240-243,246-248).
    if (self.seq(fname, fnlen, "cpu_pause", 9))  { self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, -1, -1, 240); return dest; }
    if (self.seq(fname, fnlen, "cpu_hlt", 7))    { self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, -1, -1, 241); return dest; }
    if (self.seq(fname, fnlen, "cpu_cli", 7))    { self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, -1, -1, 242); return dest; }
    if (self.seq(fname, fnlen, "cpu_sti", 7))    { self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, -1, -1, 243); return dest; }
    if (self.seq(fname, fnlen, "fence_sfence", 12)) { self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, -1, -1, 246); return dest; }
    if (self.seq(fname, fnlen, "fence_lfence", 12)) { self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, -1, -1, 247); return dest; }
    if (self.seq(fname, fnlen, "fence_mfence", 12)) { self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, -1, -1, 248); return dest; }
    // Arg-tragende WSP-Builtins: Args in argBase-Block spillen (vgl. clock_gettime).
    if (self.seq(fname, fnlen, "cpu_rdmsr", 9) || self.seq(fname, fnlen, "atomic_load", 11)) {
      var w1B: int64 := self.tempCount; var w1R: int64 := 0; while w1R < 4 { self.allocTemp(); w1R := w1R + 1; }
      if arg0 >= 0 { var t: int64 := self.lowerExpr(arg0); self.irAddInstrDirect(IRO_STORE_LOCAL, w1B, t, -1, 0); }
      var w1id: int64 := 244; if self.seq(fname, fnlen, "atomic_load", 11) { w1id := 249; }
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, w1B, -1, w1id); return dest;
    }
    if (self.seq(fname, fnlen, "cpu_wrmsr", 9) || self.seq(fname, fnlen, "atomic_store", 12) ||
        self.seq(fname, fnlen, "atomic_fetch_add", 16)) {
      var w2B: int64 := self.tempCount; var w2R: int64 := 0; while w2R < 4 { self.allocTemp(); w2R := w2R + 1; }
      var w2A: int64 := arg0; var w2N: int64 := 0;
      while w2A >= 0 && w2N < 2 { var t: int64 := self.lowerExpr(w2A); self.irAddInstrDirect(IRO_STORE_LOCAL, w2B + w2N, t, -1, 0); w2N := w2N + 1; w2A := self.nodeNext(w2A); }
      var w2id: int64 := 245; if self.seq(fname, fnlen, "atomic_store", 12) { w2id := 250; } if self.seq(fname, fnlen, "atomic_fetch_add", 16) { w2id := 252; }
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, w2B, -1, w2id); return dest;
    }
    if (self.seq(fname, fnlen, "atomic_cas", 10)) {
      var w3B: int64 := self.tempCount; var w3R: int64 := 0; while w3R < 4 { self.allocTemp(); w3R := w3R + 1; }
      var w3A: int64 := arg0; var w3N: int64 := 0;
      while w3A >= 0 && w3N < 3 { var t: int64 := self.lowerExpr(w3A); self.irAddInstrDirect(IRO_STORE_LOCAL, w3B + w3N, t, -1, 0); w3N := w3N + 1; w3A := self.nodeNext(w3A); }
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, w3B, -1, 251); return dest;
    }
    // lyxc→LyxOS Kat-C: chmod/chown → no-op return 0 (LyxOS capability-basiert, keine POSIX-perms).
    if (self.seq(fname, fnlen, "chmod", 5) || self.seq(fname, fnlen, "chown", 5)) {
      self.irAddInstrDirect(IRO_CONST_INT, dest, -1, -1, 0); return dest;
    }
    // lyxc→LyxOS 0x0200-Block (kernel-adoptiert). lseek/pipe(3-arg), truncate(2-arg) direkt.
    if (self.seq(fname, fnlen, "lseek", 5) || self.seq(fname, fnlen, "pipe", 4) ||
        self.seq(fname, fnlen, "truncate", 8)) {
      var fxB: int64 := self.tempCount; var fxR: int64 := 0; while fxR < 4 { self.allocTemp(); fxR := fxR + 1; }
      var fxA: int64 := arg0; var fxN: int64 := 0;
      while fxA >= 0 && fxN < 3 {
        var t: int64 := self.lowerExpr(fxA);
        self.irAddInstrDirect(IRO_STORE_LOCAL, fxB + fxN, t, -1, 0);
        fxA := self.nodeNext(fxA); fxN := fxN + 1;
      }
      var fxId: int64 := 228;                                   // lseek
      if self.seq(fname, fnlen, "pipe", 4)     { fxId := 231; }
      if self.seq(fname, fnlen, "truncate", 8) { fxId := 232; }
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, fxB, -1, fxId); return dest;
    }
    // stat(path,out) / lstat(path,out) → sys_stat(AT_CWD=-1, path, out, flags) — id 229.
    if (self.seq(fname, fnlen, "stat", 4) || self.seq(fname, fnlen, "lstat", 5)) {
      var stB: int64 := self.tempCount; var stR: int64 := 0; while stR < 4 { self.allocTemp(); stR := stR + 1; }
      var stCwd: int64 := self.allocTemp();
      self.irAddInstrDirect(IRO_CONST_INT, stCwd, -1, -1, -1);  // AT_CWD = -1
      self.irAddInstrDirect(IRO_STORE_LOCAL, stB, stCwd, -1, 0);
      var stA: int64 := arg0;
      if stA >= 0 { var t: int64 := self.lowerExpr(stA); self.irAddInstrDirect(IRO_STORE_LOCAL, stB + 1, t, -1, 0); stA := self.nodeNext(stA); }
      if stA >= 0 { var t: int64 := self.lowerExpr(stA); self.irAddInstrDirect(IRO_STORE_LOCAL, stB + 2, t, -1, 0); }
      var stFlags: int64 := self.allocTemp();
      var stFv: int64 := 0;
      if self.seq(fname, fnlen, "lstat", 5) { stFv := 1; }      // STAT_NOFOLLOW
      self.irAddInstrDirect(IRO_CONST_INT, stFlags, -1, -1, stFv);
      self.irAddInstrDirect(IRO_STORE_LOCAL, stB + 3, stFlags, -1, 0);
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, stB, -1, 229); return dest;
    }
    // symlink(target, link) → sys_symlink(target, AT_CWD=-1, link) — id 230.
    if (self.seq(fname, fnlen, "symlink", 7)) {
      var syB: int64 := self.tempCount; var syR: int64 := 0; while syR < 4 { self.allocTemp(); syR := syR + 1; }
      var syA: int64 := arg0;
      if syA >= 0 { var t: int64 := self.lowerExpr(syA); self.irAddInstrDirect(IRO_STORE_LOCAL, syB, t, -1, 0); syA := self.nodeNext(syA); }
      var syCwd: int64 := self.allocTemp();
      self.irAddInstrDirect(IRO_CONST_INT, syCwd, -1, -1, -1);  // AT_CWD = -1
      self.irAddInstrDirect(IRO_STORE_LOCAL, syB + 1, syCwd, -1, 0);
      if syA >= 0 { var t: int64 := self.lowerExpr(syA); self.irAddInstrDirect(IRO_STORE_LOCAL, syB + 2, t, -1, 0); }
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, syB, -1, 230); return dest;
    }
    // nanosleep(ts, rem) → sys_sleep_ns (timespec→ns). rem ignoriert — id 233.
    if (self.seq(fname, fnlen, "nanosleep", 9)) {
      var nsB: int64 := self.tempCount; var nsR: int64 := 0; while nsR < 4 { self.allocTemp(); nsR := nsR + 1; }
      if arg0 >= 0 { var t: int64 := self.lowerExpr(arg0); self.irAddInstrDirect(IRO_STORE_LOCAL, nsB, t, -1, 0); }
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, nsB, -1, 233); return dest;
    }
    // lyxc→LyxOS: EPrintInt → stderr (Arg in Slot 0 wie PrintInt id 2, id 234).
    if (self.seq(fname, fnlen, "EPrintInt", 9)) {
      if arg0 >= 0 {
        var epTemp: int64 := self.lowerExpr(arg0);
        self.irAddInstrDirect(IRO_STORE_LOCAL, 0, epTemp, -1, 0);
        self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, -1, -1, 234);
      }
      return dest;
    }
    // lyxc→LyxOS: ArgvGet(argv, i) → lea [argv+i*8]; deref (id 235, argBase 2-arg).
    if (self.seq(fname, fnlen, "ArgvGet", 7)) {
      var agB: int64 := self.tempCount; var agR: int64 := 0; while agR < 4 { self.allocTemp(); agR := agR + 1; }
      var agA: int64 := arg0;
      if agA >= 0 { var t: int64 := self.lowerExpr(agA); self.irAddInstrDirect(IRO_STORE_LOCAL, agB, t, -1, 0); agA := self.nodeNext(agA); }
      if agA >= 0 { var t: int64 := self.lowerExpr(agA); self.irAddInstrDirect(IRO_STORE_LOCAL, agB + 1, t, -1, 0); }
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, agB, -1, 235); return dest;
    }
    // lyxc→LyxOS Gruppe D: fork/execve/wait4 → return -1 ("nicht unterstützt"). LyxOS hat
    // KEIN fork/exec/wait-Prozessmodell (nur sys_spawn_child=91, synchron). Einzige Nutzer:
    // self_test.lyx (Test-Harness, läuft nicht auf LyxOS) + lbf_loader (Linux-Tool). Lowering
    // als -1 macht lyxc-LBF baubar; diese Pfade werden auf LyxOS nicht ausgeführt.
    if (self.seq(fname, fnlen, "sys_fork", 8) || self.seq(fname, fnlen, "sys_execve", 10) ||
        self.seq(fname, fnlen, "sys_wait4", 9)) {
      self.irAddInstrDirect(IRO_CONST_INT, dest, -1, -1, -1); return dest;
    }
    // rmdir(path) → sys_unlink(AT_CWD=-1, path, UNLINK_DIR=1) @ 0x0208 — id 236.
    if (self.seq(fname, fnlen, "rmdir", 5)) {
      var rdB: int64 := self.tempCount; var rdR: int64 := 0; while rdR < 4 { self.allocTemp(); rdR := rdR + 1; }
      var rdCwd: int64 := self.allocTemp();
      self.irAddInstrDirect(IRO_CONST_INT, rdCwd, -1, -1, -1);   // AT_CWD = -1
      self.irAddInstrDirect(IRO_STORE_LOCAL, rdB, rdCwd, -1, 0);
      if arg0 >= 0 { var t: int64 := self.lowerExpr(arg0); self.irAddInstrDirect(IRO_STORE_LOCAL, rdB + 1, t, -1, 0); }
      var rdFlag: int64 := self.allocTemp();
      self.irAddInstrDirect(IRO_CONST_INT, rdFlag, -1, -1, 1);   // UNLINK_DIR = 1
      self.irAddInstrDirect(IRO_STORE_LOCAL, rdB + 2, rdFlag, -1, 0);
      self.irAddInstrDirect(IRO_CALL_BUILTIN, dest, rdB, -1, 236); return dest;
    }

    // lyxc→LyxOS: sizeof(Type) → compile-time Konstante (Summe Feld-Größen),
    // wie lowerNew. Primitive/unbekannt → 8. Emittiert IRO_CONST_INT statt Call.
    if (self.seq(fname, fnlen, "sizeof", 6)) {
      var szf: int64 := 8;
      if arg0 >= 0 {
        var szDecl: int64 := self._findTypeDecl(self.nodeSVal(arg0), self.nodeSLen(arg0));
        if szDecl >= 0 { var ts: int64 := self._typeSizeOf(szDecl); if ts > 0 { szf := ts; } }
      }
      self.irAddInstrDirect(IRO_CONST_INT, dest, -1, -1, szf); return dest;
    }

    // #1: lokaler plain fn-ptr `f(args)` (f = NK_VAR_DECL-Local, keine Funktion) → indirekter Call.
    // fn-Adresse zuerst laden (vor Arg-Stores in slots 0..N-1, die f's Slot überschreiben könnten).
    var lfSlot: int64 := self._findLocalSlot(fname, fnlen);
    if lfSlot >= 0 {
      var lfFn: int64 := self.allocTemp();
      self.irAddInstrDirect(IRO_LOAD_LOCAL, lfFn, lfSlot, -1, 0);
      var lfArg: int64 := arg0; var lfI: int64 := 0;
      while lfArg >= 0 {
        var lfAT: int64 := self.lowerExpr(lfArg);
        self.irAddInstrDirect(IRO_STORE_LOCAL, lfI, lfAT, -1, 0);
        lfI += 1; lfArg := self.nodeNext(lfArg);
      }
      self.irAddInstrDirect(IRO_CALL_INDIRECT, dest, lfFn, -1, lfI);
      return dest;
    }

    // fix/lyxos-builtin-misdispatch: KEIN stiller id=1=PrintStr-Default mehr.
    // Unbekannter Name (kein User-Fn, kein FFI-Extern, kein bekannter Builtin) =
    // harter Compile-Fehler statt Garbage. Der stille Default versteckte den fb-Bug.
    Print("lyxc: --target=lyxos: unbekannter Builtin/Funktion: "c);
    var ucI: int64 := 0;
    while (ucI < fnlen) { PrintChar(StrCharAt(fname, ucI)); ucI := ucI + 1; }
    PrintLn(""c);
    exit(1);

    return dest;
  }

  // ------------------------------------------------------------------
  // Index/Array Access Lowering
  // ------------------------------------------------------------------
  
  fn lowerIndex(expr: int64): int64 {
    var simd: int64 := self._isSimdExpr(self.nodeC0(expr));
    var base: int64 := self.lowerExpr(self.nodeC0(expr));
    var idx: int64 := self.lowerExpr(self.nodeC1(expr));
    var dest: int64 := self.allocTemp();
    // WP-SIMD: parallel-Array<f32>[i] → f32-Element laden + nach f64 konvertieren (LOAD_ELEM).
    if simd != 0 {
      self.irAddInstrDirect(IRO_SIMD_LOAD_ELEM, dest, base, idx, 0);
      return dest;
    }
    // ARM64-FIX: war Stub. base = Array-Pointer (aus IRO_ALLOC), idx = Index.
    // emitLoadIdx: LDR dest, [base, idx, LSL #3] (8-Byte-Elemente).
    self.irAddInstrDirect(IRO_LOAD_IDX, dest, base, idx, 0);
    return dest;
  }
  
  // ------------------------------------------------------------------
  // Field Access Lowering
  // ------------------------------------------------------------------

  fn fieldTypeSize(typeNode: int64): int64 {
    if typeNode < 0 { return 8; }
    var tv: pchar := self.nodeSVal(typeNode);
    var tl: int64 := self.nodeSLen(typeNode);
    if self.seq(tv, tl, "int8",  4) { return 1; }
    if self.seq(tv, tl, "u8",    2) { return 1; }
    if self.seq(tv, tl, "uint8", 5) { return 1; }   // #1010: Schreibweise von u8
    if self.seq(tv, tl, "char",  4) { return 1; }
    if self.seq(tv, tl, "int16", 5) { return 2; }
    if self.seq(tv, tl, "u16",   3) { return 2; }
    if self.seq(tv, tl, "uint16", 6) { return 2; }
    if self.seq(tv, tl, "int32", 5) { return 4; }
    if self.seq(tv, tl, "u32",   3) { return 4; }
    if self.seq(tv, tl, "uint32", 6) { return 4; }
    if self.seq(tv, tl, "f32",   3) { return 4; }
    return 8;
  }

  // ARM64-OOP: NK_TYPE_DECL für einen Typ-Namen finden (-1 wenn keiner).
  fn _findTypeDecl(np: pchar, nl: int64): int64 {
    var ti: int64 := 0;
    while ti < self.nodeCount {
      if self.nodeKind(ti) == NK_TYPE_DECL {
        if self.seq(self.nodeSVal(ti), self.nodeSLen(ti), np, nl) { return ti; }
      }
      ti += 1;
    }
    return 0 - 1;
  }

  // ARM64-OOP: Byte-Offset eines Feldes in NK_TYPE_DECL (-1 wenn nicht gefunden).
  // WP-INH-lyxos: geerbte Basis-Felder zuerst (flach vorangestellt, wie ELF cg_buildClassLayout).
  // Basis via extends (c2=NK_TYPE_NAME) inline aufgelöst (keine neue IRLower-Methode — Seed-vtable).
  fn _fieldOffsetIn(typeDecl: int64, fp: pchar, fl: int64): int64 {
    var off: int64 := 0;
    var pn: int64 := self.nodeC2(typeDecl);
    if pn >= 0 {
      var base: int64 := self._findTypeDecl(self.nodeSVal(pn), self.nodeSLen(pn));
