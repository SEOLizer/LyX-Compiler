  asmListing: bool;
  mcdc: bool;
  mcdcReport: bool;
  staticAnalysis: bool;
  callGraph: bool;
  mapFile: bool;
  warningsAsErrors: bool;
  warnAll: bool;
  quiet: bool;
  includePath: int64;
  stdPath: int64;
  arch: int64;
  defineMacros: int64;
  emitRelocs: bool;
  stripDebug: bool;
  cHeaderFile: int64;  // WP-BC-30: --include <header.h>

  // WP-BC-43: trace / profile flags
  traceEnabled:   bool;
  profileEnabled: bool;

  // WP-BC-44: diagnostic flags
  tracePasses: bool;
  irSourceMap:  bool;

  // WP-BC-45: dump flags
  astDump:     bool;
  symtabDump:  bool;

  // WP-BC-46: sema verbose flags
  typeReasoning: bool;
  constraintLog: bool;

  // WP-BC-47: IR provenance tracking
  provenance: bool;

  // WP-BC-48: inline runtime checks (bounds/null/zero)
  runtimeChecks: bool;
  verifyTmr:     bool;   // #1141: --verify-tmr

  // WP-BC-49: DWARF debug symbol generation
  debugSymbols: bool;

  // WP-3.2: --meta-safe: append .meta_safe section with CRC32 page hashes
  metaSafe: bool;

  // WP-T14: Migration Tool + Compat-Modus
  migrateCaps: bool;  // --migrate-capabilities: Manifest generieren und ausgeben
  capCompat:   bool;  // --capabilities=compat: kein seccomp/landlock trotz @capabilities

  // WP-T15: LCBS-Selbsttest
  selfTest: bool;  // --self-test

  // WP-BC-50: .lyu pre-compiled unit format
  compileUnit:   bool;    // --compile-unit: write .lyu after sema
  unitInfoFile:  int64;   // --unit-info: 0=unset, 1=sentinel, 2=set (path in unitInfoPath)
  unitInfoPath:  int64;   // --unit-info <file> path (stored as int64, cast to pchar)

  // WP-AND-02: shared library output (--output-type=shared-lib / --shared)
  outputType:    int64;   // OUTPUT_TYPE_EXECUTABLE (default) | OUTPUT_TYPE_SHARED_LIB

  // WP-AND-02 Phase B/B2: export table populated by codegen, consumed by writeELFSharedLib.
  // Records are 24 bytes: [namePtr:i64 (absolute pchar), nameLen:i64, stValue:i64].
  // namePtr may point into parser.src (for @export) or into mangledNamesBuf (for @jni).
  exportBuf:        int64;
  exportCount:      int64;
  // Backing store for Java_*-mangled names produced by @jni (Phase B2). Grows as needed.
  mangledNamesBuf:  int64;
  mangledNamesLen:  int64;
  mangledNamesCap:  int64;
  // Stub bytes prepended to .text by emitARM64 (12 for _start; 0 for shared-lib mode).
  codeStubOff:      int64;
  // funcAddrs pointer from EmitARM64 (funcId -> offset_in_irCodeBuf), used to look up export offsets.
  codeFuncAddrs:    int64;
  // WP-AND-03: per-function prologue length (parallel array, funcId -> byte length).
  // Used by the DWARF CFI emitter in writeELFSharedLib to advance_loc.
  codeFuncPrologueLen: int64;
  // Total number of IR functions emitted (= EmitARM64.funcCount); used to walk both tables.
  codeFuncTotal:    int64;
  // WP-AND-02 Phase C: dynamic relocations harvested from EmitARM64 (Elf64_Rela records).
  relocBuf:         int64;
  relocCount:       int64;

  // ARM64 FFI: extern-symbol table harvested from EmitARM64 (32-byte entries
  // {nameStrOff, nameLen, libStrOff, libLen} into the IR string table). Drives
  // .dynsym/.dynstr/DT_NEEDED in the dynamic ET_EXEC writer.
  armExternBuf:     int64;
  armExternCount:   int64;


  // WP-AND-upstream-fix v5: global-load slot tracking. globalRelocBuf records
  // (slotCodeOff, globalIdx) pairs (16 bytes each) so writeELFSharedLib can
  // build the .data section, patch each slot with the global's resolved
  // address, and emit a matching R_AARCH64_RELATIVE entry per slot.
  // irModulePtr exposes the IR module so the writer can read globalBuffer
  // (which ir_lower populates with init values).
  globalRelocBuf:   int64;
  globalRelocCount: int64;
  irModulePtr:      int64;

  // WP-AND-03: target Android API level (--android-api=N). Used by the .note.android.ident
  // section and reserved for future API-conditional codegen choices.
  androidApiLevel:  int64;

  // WP-LIC-06: License CLI flags
  licenseFile:   int64;   // --license-file=<path>  (pchar into argv)
  licenseKey:    int64;   // pchar to 29-char verified key (persistent mmap), 0 = none
  licenseKeyLen: int64;   // always 29 when licenseKey is set
  licenseName:   int64;   // --name=NAME             (pchar into argv)
  licenseEmail:  int64;   // --email=EMAIL           (pchar into argv)
  checkBinary:   int64;   // --check-binary=<path>   (pchar into argv)
  noLicense:     bool;    // --no-license
  daaWarn:       int64;   // WP-AS-15: 0=off, 1=warn, 2=error

  // WP-3.2: --meta-safe: append .meta_safe section with CRC32 page hashes
  metaSafe: bool;

  // WP-A5: --no-libc-init: skip __libc_start_main, call main directly
  noLibcInit: bool;
  arm64LibcStartMainUsed: bool;

  // LX-00: --emit=lbf: serialize IR to .lbf bytecode (only with --target=lyxos)
  emitLBF: bool;

  // WSP-07: --emit=obj / -c: relocatable ELF-Objekt (ET_REL) statt Executable (x86_64)
  emitObj: bool;

  // LX-36: lifecycle kind from @lifecycle annotation (0=ONE_SHOT default)
  lifecycleKind: int64;

  // CAPS-TLV: Union der @capabilities-Bits (LBF_CAP_*) für den LBF-Nativ-Output.
  lyxosCapBits: int64;

  // WP-KM-01: --target=lyxos-kernel: reject POSIX-dependent imports
  kernelMode: int64;

  // WP-T14: Migration Tool + Compat-Modus
  migrateCaps: bool;
  capCompat:   bool;

  // Compilation state
  exitCode: int64;
  earlyExit: bool;
  // #1163: unbekannter Schalter oder ungueltiger Wert auf der Kommandozeile.
  // Der Lauf bricht danach ab, statt etwas anderes zu bauen als gemeint.
  badArg: bool;
  errorCount: int64;
  warningCount: int64;
  codeSize: int64;
  
  // Module cache
  unitCache: int64;
  
  // Build info
  buildTime: int64;
  
