  pub fn Compile(inputFile: pchar, outputFile: pchar): int64 {
    // WP-T15: --self-test — LCBS-Integrationstest (läuft vor dem normalen Compile-Pfad)
    if self.selfTest {
      // inputFile = argv[0] (lyxc-Binary-Pfad) wenn via main() übergeben
      var lyxcPath: pchar := inputFile;
