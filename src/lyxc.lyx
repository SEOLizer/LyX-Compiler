// ============================================================================
// WP-3.2: CRC32 (IEEE 802.3) + .meta_safe section post-processor
// ============================================================================

// IEEE 802.3 CRC32: polynomial 0xEDB88320 (bit-reversed 0x04C11DB7).
// Returns the 32-bit CRC of data[0..len-1] as a positive int64.
fn ms_crc32(data: int64, len: int64): int64 {
  var crc: int64 := 0xFFFFFFFF;
  var i: int64 := 0;
  while (i < len) {
    crc := crc ^ (peek8(data + i) & 0xFF);
    var b: int64 := 0;
    while (b < 8) {
      if ((crc & 1) != 0) {
        crc := ((crc >> 1) & 0x7FFFFFFF) ^ (0 - 306674912);
        // 0xEDB88320 as signed int64:  0xEDB88320 = 3988292384
        // As negative two's-complement: 3988292384 - 4294967296 = -306674912
      } else {
        crc := (crc >> 1) & 0x7FFFFFFF;
      }
      b += 1;
    }
    i += 1;
  }
  return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF;
}

// Append a .meta_safe section to the ELF binary at `path`.
// codeOff  = file offset of .text (176 for static x86_64 ELF: 64-byte ELF hdr + 2×56-byte phdr)
// codeLen  = length of .text in bytes
// dataLen  = length of .data in bytes (follows .text immediately)
fn ms_appendMetaSafe(path: pchar, codeOff: int64, codeLen: int64, dataLen: int64) {
  // WP-32: single O_RDWR open — no close between read and write eliminates TOCTOU window
  var fd: int64 := open(path, 2, 0);  // O_RDWR
  if (fd < 0) { PrintStr("meta-safe: cannot open binary\n"); return; }
  var fileSize: int64 := lseek(fd, 0, 2);
  lseek(fd, 0, 0);
  var buf: int64 := alloc(fileSize + 4096);
  if (read(fd, buf as pchar, fileSize) != fileSize) {  // WP-27: partieller Read → Abbruch
    PrintStr("meta-safe: read incomplete\n"); close(fd); return;
  }

  // Compute CRC32 per 4096-byte page of .text
  var pageSize: int64 := 4096;
  var pageCount: int64 := (codeLen + pageSize - 1) / pageSize;
  // .meta_safe payload: Magic(4) + PageCount(4) + CodeLen(8) + pageCount×{pageOffset:4, crc32:4}
  // Total header: 16 bytes; entries at offset 16
  var payloadSize: int64 := 16 + pageCount * 8;
  var payload: int64 := alloc(payloadSize);

  // Magic: "META" = bytes 0x4D 0x45 0x54 0x41
  poke8(payload + 0, 0x4D);  // M
  poke8(payload + 1, 0x45);  // E
  poke8(payload + 2, 0x54);  // T
  poke8(payload + 3, 0x41);  // A
  poke32(payload + 4, pageCount);
  poke64(payload + LYU_META_OFF_CODELEN, codeLen);  // actual .text byte count for verifier

  var pi: int64 := 0;
  while (pi < pageCount) {
    var pageOff:    int64 := pi * pageSize;
    var fileOff:    int64 := codeOff + pageOff;
    var remaining:  int64 := codeLen - pageOff;
    var len:        int64 := pageSize;
    if (remaining < pageSize) { len := remaining; }
    var crc: int64 := ms_crc32(buf + fileOff, len);
    var entry: int64 := payload + 16 + pi * 8;
    poke32(entry,     pageOff);  // pageOffset (relative to .text start)
    poke32(entry + 4, crc);      // crc32
    pi += 1;
  }

  // Build .shstrtab: "\0.meta_safe\0.shstrtab\0"
  // Offsets: 0=\0, 1=.meta_safe (10 chars), 12=\0, 13=.shstrtab (9 chars), 23=\0 → 24 bytes
  var shstrSize:  int64 := 24;
  var shstr: int64 := alloc(shstrSize);  // zeroed
  var metaSafeName: pchar := ".meta_safe";
  var shstrtabName: pchar := ".shstrtab";
  memcpy(shstr + 1,  metaSafeName as int64, 10);
  memcpy(shstr + 12, shstrtabName as int64, 9);

  // Layout of new file:
  //   [0 .. fileSize-1]          : original ELF
  //   [fileSize .. +payloadSize]  : .meta_safe payload
  //   [fileSize+payloadSize .. ]  : .shstrtab (24 bytes)
  //   [fileSize+payloadSize+24..] : 3 × 64-byte section headers (aligned to 8)
  var shoff:    int64 := fileSize + payloadSize + shstrSize;
  var newSize:  int64 := shoff + 3 * 64;

  // Build new ELF buffer
  var nbuf: int64 := alloc(newSize);
  // Copy original ELF
  var ci: int64 := 0;
  memcpy(nbuf, buf, fileSize);
  // Append .meta_safe payload
  ci := 0;
  memcpy(nbuf + fileSize, payload, payloadSize);
  // Append .shstrtab
  ci := 0;
  memcpy(nbuf + fileSize + payloadSize, shstr, shstrSize);

  // Update ELF header:
  //   e_shoff      = shoff (offset of section header table)
  //   e_shnum      = 3 (NULL, .meta_safe, .shstrtab)
  //   e_shstrndx   = 2 (.shstrtab is entry 2)
  poke64(nbuf + ELF64_EHDR_OFF_SHOFF, shoff);  // e_shoff
  poke16(nbuf + 60, 3);      // e_shnum
  poke16(nbuf + 62, 2);      // e_shstrndx

  // Section header table (3 × 64 bytes, each Elf64_Shdr):
  // [0] NULL section — all zeros
  var sh0: int64 := nbuf + shoff;
  // (already zeroed by mmap)

  // [1] .meta_safe — SHT_NOTE=7, SHF_ALLOC|SHF_READONLY=6
  var sh1: int64 := nbuf + shoff + 64;
  poke32(sh1,      1);                        // sh_name = 1 (offset in .shstrtab)
  poke32(sh1 + 4,  7);                        // sh_type = SHT_NOTE
  poke64(sh1 + ELF64_SHDR_OFF_FLAGS,  2);                        // sh_flags = SHF_ALLOC (read-only; no SHF_WRITE/SHF_EXECINSTR)
  poke64(sh1 + ELF64_SHDR_OFF_ADDR, 0);                        // sh_addr = 0 (not loaded)
  poke64(sh1 + ELF64_SHDR_OFF_OFFSET, fileSize);                 // sh_offset = right after original ELF
  poke64(sh1 + ELF64_SHDR_OFF_SIZE, payloadSize);              // sh_size
  poke32(sh1 + 40, 0);                        // sh_link
  poke32(sh1 + 44, 0);                        // sh_info
  poke64(sh1 + ELF64_SHDR_OFF_ALIGN, 4);                        // sh_addralign
  poke64(sh1 + ELF64_SHDR_OFF_ENTSIZE, 0);                        // sh_entsize

  // [2] .shstrtab — SHT_STRTAB=3
  var sh2: int64 := nbuf + shoff + 128;
  poke32(sh2,      12);                       // sh_name = 12 (offset of ".shstrtab" in .shstrtab)
  poke32(sh2 + 4,  3);                        // sh_type = SHT_STRTAB
  poke64(sh2 + ELF64_SHDR_OFF_FLAGS,  0);                        // sh_flags
  poke64(sh2 + ELF64_SHDR_OFF_ADDR, 0);                        // sh_addr
  poke64(sh2 + ELF64_SHDR_OFF_OFFSET, fileSize + payloadSize);   // sh_offset
  poke64(sh2 + ELF64_SHDR_OFF_SIZE, shstrSize);                // sh_size
  poke32(sh2 + 40, 0);                        // sh_link
  poke32(sh2 + 44, 0);                        // sh_info
  poke64(sh2 + ELF64_SHDR_OFF_ALIGN, 1);                        // sh_addralign
  poke64(sh2 + ELF64_SHDR_OFF_ENTSIZE, 0);                        // sh_entsize

  // WP-32: write in-place on the same fd (no second open — TOCTOU eliminated)
  lseek(fd, 0, 0);
  write(fd, nbuf as pchar, newSize);
  close(fd);

  free(buf, fileSize + 4096);
  free(payload, payloadSize);
  free(shstr, shstrSize);
  free(nbuf, newSize);
}

