  // Liegt `path` im stdlib-Baum? Erkennt das Verzeichnis-Segment `std/`, `src/`
  // oder `data/` — also genau die Bäume, die der Import-Pfad ohnehin als
  // Binding-Layer (TCB) behandelt. Reine Präfix-Prüfung auf den Pfad, den der
  // Aufrufer angibt; die Datei selbst kann sich das Vertrauen nicht ausstellen.
  fn _pathInStdTree(path: pchar): int64 {
    if path == (0 as pchar) { return 0; }
    var n: int64 := StrLen(path);
    var i: int64 := 0;
    while (i < n) {
      // Segmentanfang: Position 0 oder direkt nach einem '/'
      var atSeg: int64 := 0;
      if (i == 0) { atSeg := 1; }
      else if ((StrCharAt(path, i - 1) & 255) == 47) { atSeg := 1; }
      if (atSeg != 0) {
        var c0: int64 := StrCharAt(path, i) & 255;
        if (c0 == 115 && i + 4 <= n) {                       // 's'
          var c1: int64 := StrCharAt(path, i + 1) & 255;
          var c2: int64 := StrCharAt(path, i + 2) & 255;
          var c3: int64 := StrCharAt(path, i + 3) & 255;
          if (c1 == 116 && c2 == 100 && c3 == 47) { return 1; }   // "std/"
          if (c1 == 114 && c2 == 99  && c3 == 47) { return 1; }   // "src/"
        }
        if (c0 == 100 && i + 5 <= n) {                       // 'd'
          var d1: int64 := StrCharAt(path, i + 1) & 255;
          var d2: int64 := StrCharAt(path, i + 2) & 255;
          var d3: int64 := StrCharAt(path, i + 3) & 255;
          var d4: int64 := StrCharAt(path, i + 4) & 255;
          if (d1 == 97 && d2 == 116 && d3 == 97 && d4 == 47) { return 1; }  // "data/"
        }
      }
      i += 1;
    }
    return 0;
  }

  // WP-BC-44: --trace-passes timing helpers
  // WP-BC-50: derive .lyu output path from source path by stripping .lyx and adding .lyu
  fn _lyuOutputPath(srcPath: pchar): pchar {
    var slen: int64 := StrLen(srcPath);
    // strip .lyx if present (4 chars), then append .lyu
    var base: pchar;
    if slen > 4 {
      base := StrSub(srcPath, 0, slen - 4);
    } else {
      base := srcPath;
    }
    return StrConcat(base, ".lyu"c);
  }

  fn _passStart(name: pchar): int64 {
    if !self.tracePasses { return 0; }
    PrintStr("[pass] "c);
    PrintStr(name);
    PrintStr(": start\n"c);
    return MonotonicTimeNano();
  }

  fn _passEnd(name: pchar, t0: int64): void {
    if !self.tracePasses { return; }
    var elapsed: int64 := MonotonicTimeNano() - t0;
    var us: int64 := elapsed / 1000;
    var ms: int64 := elapsed / 1000000;
    PrintStr("[pass] "c);
    PrintStr(name);
    PrintStr(": done ("c);
    PrintInt(ms);
    PrintStr("ms / "c);
    PrintInt(us);
    PrintStr("µs)\n"c);
  }

