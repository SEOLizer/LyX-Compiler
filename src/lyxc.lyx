  // WP-BC-45: recursive AST node printer (walks sibling chain + recurses into children)
  fn _dumpASTNode(nodes: int64, src: pchar, ni: int64, depth: int64): void {
    var cur: int64 := ni;
    while cur >= 0 {
      var base: int64 := nodes + cur * 88;
      var kind: int64 := peek64(base);
      var nc0:  int64 := peek64(base + NODE_OFF_C0);
      var nc1:  int64 := peek64(base + NODE_OFF_C1);
      var nc2:  int64 := peek64(base + NODE_OFF_C2);
      var nc3:  int64 := peek64(base + NODE_OFF_C3);
      var nxt:  int64 := peek64(base + NODE_OFF_NEXT);
      var iVal: int64 := peek64(base + NODE_OFF_IVAL);
      var sOff: int64 := peek64(base + NODE_OFF_SVAL);
      var sLen: int64 := peek64(base + NODE_OFF_SLEN);

      var d: int64 := 0;
      while d < depth {
        PrintStr("  "c);
        d += 1;
      }

      PrintStr("["c);
      PrintInt(cur);
      PrintStr("] "c);
      PrintStr(self._nkStr(kind));

      if sLen > 0 && (src as int64) != 0 {
        PrintStr(" '"c);
        PrintStr(StrSub(src, sOff, sLen));
        PrintStr("'"c);
      }

      if kind == NK_LIT_INT || kind == NK_LIT_CHAR || kind == NK_LIT_BOOL {
        PrintStr(" ="c);
        PrintInt(iVal);
      }

      PrintStr("\n"c);

      if nc0 >= 0 { self._dumpASTNode(nodes, src, nc0, depth + 1); }
      if nc1 >= 0 { self._dumpASTNode(nodes, src, nc1, depth + 1); }
      if nc2 >= 0 { self._dumpASTNode(nodes, src, nc2, depth + 1); }
      // Extern fn decls (a bodyless NK_FUNC_DECL) pack the link-library span
      // into c3 as ((len<<32)|offset) — not a node index — so never recurse it.
      var c3IsLib: int64 := 0;
      if kind == NK_FUNC_DECL && nc2 < 0 { c3IsLib := 1; }
      if nc3 >= 0 && c3IsLib == 0 { self._dumpASTNode(nodes, src, nc3, depth + 1); }

      cur := nxt;
    }
  }

