// WP-CS-05: map CompilerConfig.target → ARCH_* code (1=x86_64, 2=arm64, 3=riscv64, 4=arm_cm)
fn cfg_archCode(cfg: CompilerConfig): int64 {
  if cfg.target == LYX_TC_X86_64         { return 1; }
  if cfg.target == LYX_TC_MACOS_X86_64   { return 1; }
  if cfg.target == LYX_TC_WINDOWS_X86_64 { return 1; }
  if cfg.target == LYX_TC_ANDROID_X86_64 { return 1; }
  if cfg.target == LYX_TC_ARM64          { return 2; }
  if cfg.target == LYX_TC_MACOS_ARM64    { return 2; }
  if cfg.target == LYX_TC_WINDOWS_ARM64  { return 2; }
  if cfg.target == LYX_TC_ANDROID_ARM64  { return 2; }
  if cfg.target == LYX_TC_RISCV64        { return 3; }
  if cfg.target == LYX_TC_LINUX_RISCV64  { return 3; }
  if cfg.target == LYX_TC_ARM_CM         { return 4; }
  if cfg.target == LYX_TC_ARM_CM4        { return 4; }
  return 1;
}

// WP-CS-05: map CompilerConfig.target → OS_* code (1=linux, 2=macos, 3=windows, 4=bare)
fn cfg_osCode(cfg: CompilerConfig): int64 {
  if cfg.target == LYX_TC_X86_64         { return 1; }
  if cfg.target == LYX_TC_ARM64          { return 1; }
  if cfg.target == LYX_TC_RISCV64        { return 1; }
  if cfg.target == LYX_TC_LINUX_RISCV64  { return 1; }
  if cfg.target == LYX_TC_ANDROID_ARM64  { return 1; }
  if cfg.target == LYX_TC_ANDROID_X86_64 { return 1; }
  if cfg.target == LYX_TC_MACOS_X86_64   { return 2; }
  if cfg.target == LYX_TC_MACOS_ARM64    { return 2; }
  if cfg.target == LYX_TC_WINDOWS_X86_64 { return 3; }
  if cfg.target == LYX_TC_WINDOWS_ARM64  { return 3; }
  if cfg.target == LYX_TC_ARM_CM         { return 4; }
  if cfg.target == LYX_TC_ARM_CM4        { return 4; }
  return 1;
}

// WP-CS-05: inject system constants into a Codegen conTable (for runtime usage).
fn injectCgSystemConstants(cg: Codegen, arch: int64, os: int64): void {
  cg.AddBuiltinCon("ARCH_X86_64"c,  1);
  cg.AddBuiltinCon("ARCH_ARM64"c,   2);
  cg.AddBuiltinCon("ARCH_RISCV64"c, 3);
  cg.AddBuiltinCon("ARCH_ARM_CM"c,  4);
  cg.AddBuiltinCon("OS_LINUX"c,   1);
  cg.AddBuiltinCon("OS_MACOS"c,   2);
  cg.AddBuiltinCon("OS_WINDOWS"c, 3);
  cg.AddBuiltinCon("OS_BARE"c,    4);
  cg.AddBuiltinCon("TARGET_ARCH"c, arch);
  cg.AddBuiltinCon("TARGET_OS"c,   os);
  var b: int64 := 0;
  // ARM64-FIX: Conditional-Compile-Bool-Flags umbenannt von LYX_TC_* → TARGET_IS_*.
  // Die alten Namen kollidierten mit dem internen Target-ID-Enum (con LYX_TC_ARM64 := 2)
  // → Lookup fand das Bool (0) statt des Enums (2) → --target=arm64/riscv/arm_cm tot.
  if arch == 1 { b := 1; } else { b := 0; }  cg.AddBuiltinCon("TARGET_IS_X86_64"c,  b);
  if arch == 2 { b := 1; } else { b := 0; }  cg.AddBuiltinCon("TARGET_IS_ARM64"c,   b);
  if arch == 3 { b := 1; } else { b := 0; }  cg.AddBuiltinCon("TARGET_IS_RISCV64"c, b);
  if arch == 4 { b := 1; } else { b := 0; }  cg.AddBuiltinCon("TARGET_IS_ARM_CM"c,  b);
  if os == 1   { b := 1; } else { b := 0; }  cg.AddBuiltinCon("TARGET_LINUX"c,   b);
  if os == 2   { b := 1; } else { b := 0; }  cg.AddBuiltinCon("TARGET_MACOS"c,   b);
  if os == 3   { b := 1; } else { b := 0; }  cg.AddBuiltinCon("TARGET_WINDOWS"c, b);
  if os == 4   { b := 1; } else { b := 0; }  cg.AddBuiltinCon("TARGET_BARE"c,    b);
}

// WP-CS-05: inject compile-time system constants into sema before Pass1/Pass2.
fn injectSystemConstants(sema: Sema, cfg: CompilerConfig): void {
  // Arch-Codes
  sema.InjectConInt("ARCH_X86_64"c,  1);
  sema.InjectConInt("ARCH_ARM64"c,   2);
  sema.InjectConInt("ARCH_RISCV64"c, 3);
  sema.InjectConInt("ARCH_ARM_CM"c,  4);
  // OS-Codes
  sema.InjectConInt("OS_LINUX"c,   1);
  sema.InjectConInt("OS_MACOS"c,   2);
  sema.InjectConInt("OS_WINDOWS"c, 3);
  sema.InjectConInt("OS_BARE"c,    4);
  // Resolved values for current build target
  var arch: int64 := cfg_archCode(cfg);
  var os:   int64 := cfg_osCode(cfg);
  sema.InjectConInt("TARGET_ARCH"c, arch);
  sema.InjectConInt("TARGET_OS"c,   os);
  // Bool shortcuts (ARM64-FIX: TARGET_IS_* statt LYX_TC_* — Kollision mit Target-ID-Enum)
  sema.InjectConBool("TARGET_IS_X86_64"c,  arch == 1);
  sema.InjectConBool("TARGET_IS_ARM64"c,   arch == 2);
  sema.InjectConBool("TARGET_IS_RISCV64"c, arch == 3);
  sema.InjectConBool("TARGET_IS_ARM_CM"c,  arch == 4);
  sema.InjectConBool("TARGET_LINUX"c,   os == 1);
  sema.InjectConBool("TARGET_MACOS"c,   os == 2);
  sema.InjectConBool("TARGET_WINDOWS"c, os == 3);
  sema.InjectConBool("TARGET_BARE"c,    os == 4);
}

// Look up an environment variable by scanning envp, which on Linux x86_64
// starts right after argv's null terminator: argv + (argc+1)*8.
pub fn lyx_getEnvVar(argc: int64, argv: pchar, name: pchar): pchar {
  var envp:    int64 := argv as int64 + (argc + 1) * 8;
  var nameLen: int64 := StrLen(name);
  var i: int64 := 0;
  while true {
    var envPtr: int64 := peek64(envp + i * 8);
    if envPtr == 0 { return 0 as pchar; }
    var j: int64 := 0;
    var isMatch: int64 := 1;
    while j < nameLen {
      if peek8(envPtr + j) != peek8(name as int64 + j) {
        isMatch := 0;
        j := nameLen;
      }
      j += 1;
    }
    if isMatch == 1 && peek8(envPtr + nameLen) == 61 {
      return (envPtr + nameLen + 1) as pchar;
    }
    i += 1;
  }
  return 0 as pchar;
}

// ============================================================================
// WP-LIC-08: License Verification
// ============================================================================

pub fn lic_loadAndVerify(cfg: CompilerConfig, argc: int64, argv: pchar): bool {
  var info: LicenseInfo := new LicenseInfo();
  info.Init();
  var found: bool := false;

  // (1) --license-file=<path> (also covers LYX_LICENSE_FILE via cfg)
  if not found && cfg.licenseFile != 0 {
    found := lic_parseFile(cfg.licenseFile as pchar, info);
    if not found {
      EPrintStr("lyxc: Lizenzdatei nicht lesbar: "c);
      EPrintStr(cfg.licenseFile as pchar);
      EPrintStr("\n"c);
      return false;
    }
  }

  // (2) --license=KEY + --name=NAME + --email=EMAIL (also env vars LYX_LICENSE_*)
  if not found && cfg.licenseKey != 0 && cfg.licenseName != 0 && cfg.licenseEmail != 0 {
    info.key      := cfg.licenseKey   as pchar;
    info.keyLen   := StrLen(cfg.licenseKey   as pchar);
    info.name     := cfg.licenseName  as pchar;
    info.nameLen  := StrLen(cfg.licenseName  as pchar);
    info.email    := cfg.licenseEmail as pchar;
    info.emailLen := StrLen(cfg.licenseEmail as pchar);
    info.errCode  := LIC_OK;
    found := true;
  }

  // (3) ~/.lyx/license.key
  if not found {
    var home: pchar := lyx_getEnvVar(argc, argv, "HOME"c);
    if home != 0 as pchar {
      var homeLen: int64 := StrLen(home);
      var suffix: pchar := "/.lyx/license.key"c;
      var sfxLen: int64 := 17;
      var pathBuf: int64 := alloc(homeLen + sfxLen + 1);
      if pathBuf != 0 {
        var pi: int64 := 0;
        memcpy(pathBuf, home as int64, homeLen);
        pi := 0;
        memcpy(pathBuf + homeLen, suffix as int64, sfxLen);
        poke8(pathBuf + homeLen + sfxLen, 0);
        found := lic_parseFile(pathBuf as pchar, info);
        free(pathBuf, homeLen + sfxLen + 1);
      }
    }
  }

  // (4) ./license.key
  if not found {
    found := lic_parseFile("./license.key"c, info);
  }

  // No license found at all
  if not found {
    EPrintStr("lyxc: keine Lizenz gefunden.\n"c);
    EPrintStr("  Erstelle ~/.lyx/license.key:\n"c);
    EPrintStr("    name=Vorname Nachname\n"c);
    EPrintStr("    email=user@example.com\n"c);
    EPrintStr("    key=XXXXX-XXXXX-XXXXX-XXXXX-XXXXX\n"c);
    return false;
  }

  // Completeness check
  if info.nameLen == 0 || info.emailLen == 0 {
    EPrintStr("lyxc: Lizenzdatei unvollstaendig (Name oder E-Mail fehlt).\n"c);
    lic_infoFree(info);
    return false;
  }
  if info.keyLen == 0 {
    EPrintStr("lyxc: Lizenzdatei unvollstaendig (Schluessel fehlt).\n"c);
    lic_infoFree(info);
    return false;
  }

  // WP-29: Dual-Mode Verifikation
  // Ed25519 (WP-29): keyLen >= 64  → base64-dekodieren → Ed25519-Verify
  // HMAC-SHA256 (Legacy): keyLen <= 35 → HMAC ableiten → Zeitkonstanter Vergleich
  var ok: bool := false;
  var keyBuf: int64 := 0;
  var keyBufLen: int64 := 0;

  if info.keyLen >= 64 {
    // WP-29: Ed25519-Pfad
    var sig64: int64 := alloc(64);
    if sig64 != 0 {
      var sigLen: int64 := lic_base64Decode(info.key as int64, info.keyLen, sig64);
      if sigLen == 64 {
        ok := lic_verifyKey(info.name as int64, info.nameLen, info.email as int64, info.emailLen, sig64);
      }
      if ok {
        // WP-LIC-10: Schlüssel-String für Watermark bewahren
        keyBuf := alloc(96);
        if keyBuf != 0 {
          keyBufLen := info.keyLen;
          if keyBufLen > 90 { keyBufLen := 90; }
          memcpy(keyBuf, info.key as int64, keyBufLen);
        }
      }
      free(sig64, 64);
    }
  } else {
    // Legacy HMAC-SHA256-Pfad
    var expected: int64 := alloc(32);
    if expected != 0 {
      lic_deriveKey(info.name as int64, info.nameLen, info.email as int64, info.emailLen, expected as pchar);
      // WP-LIC-10: Schlüssel-String für Watermark bewahren
      keyBuf := alloc(32);
      if keyBuf != 0 {
        keyBufLen := info.keyLen;
        if keyBufLen > 29 { keyBufLen := 29; }
        memcpy(keyBuf, info.key as int64, keyBufLen);
      }
      // WP-15.1: Zeitkonstanter Vergleich (29 Positionen, kein early-exit)
      var diff: int64 := 0;
      var ci: int64 := 0;
      while ci < 29 {
        var got: int64 := 0;
        var exp: int64 := peek8(expected + ci);
        if ci < info.keyLen { got := peek8(info.key as int64 + ci); }
        diff := diff | (got ^ exp);
        ci += 1;
      }
      lic_zeroSecret(expected);
      free(expected, 32);
      ok := diff == 0;
      if not ok && keyBuf != 0 { free(keyBuf, 32); keyBuf := 0; keyBufLen := 0; }
    }
  }

  lic_infoFree(info);

  if not ok {
    EPrintStr("lyxc: ungueltiger Lizenzschluessel.\n"c);
    return false;
  }

  // Store verified key for WP-LIC-10 watermark embedding
  cfg.licenseKey    := keyBuf;
  cfg.licenseKeyLen := keyBufLen;
  return true;
}

// ============================================================================
// WP-LIC-11: --check-binary — inspect .lyx_lic watermark in an ELF binary
// ============================================================================

fn _lic_printHexByte(b: int64): void {
  var buf: int64 := alloc(2);
  var hi: int64 := (b >> 4) & 0xF;
  var lo: int64 := b & 0xF;
  var chHi: int64 := hi + 48;
  if hi >= 10 { chHi := hi + 55; }
  var chLo: int64 := lo + 48;
  if lo >= 10 { chLo := lo + 55; }
  poke8(buf,     chHi);
  poke8(buf + 1, chLo);
  write(1, buf as pchar, 2);
  free(buf, 2);
}

pub fn lic_checkBinary(cfg: CompilerConfig, argc: int64, argv: pchar): int64 {
  var path: pchar := cfg.checkBinary as pchar;

  var fd: int64 := open(path, 0, 0);
  if fd < 0 {
    EPrintStr("check-binary: Datei nicht gefunden: "c);
    EPrintStrLn(path);
    return 1;
  }

  // Read ELF header (64 bytes)
  var ehdr: int64 := alloc(64);
  var nr: int64 := read(fd, ehdr as pchar, 64);
  if nr < 64 {
    EPrintStrLn("check-binary: Datei zu klein oder kein ELF"c);
    close(fd);
    free(ehdr, 64);
    return 1;
  }

  // Verify ELF magic: 0x7F 'E' 'L' 'F'
  if peek8(ehdr) != 0x7F || peek8(ehdr+1) != 69 || peek8(ehdr+2) != 76 || peek8(ehdr+3) != 70 {
    EPrintStrLn("check-binary: kein gueltiges ELF-Binary"c);
    close(fd);
    free(ehdr, 64);
    return 1;
  }

  var shoff:    int64 := peek64(ehdr + ELF64_EHDR_OFF_SHOFF);
  var shnum:    int64 := peek16(ehdr + 60);
  var shstrndx: int64 := peek16(ehdr + 62);
  free(ehdr, 64);

  if shoff == 0 || shnum == 0 {
    PrintStr("check-binary: "c); PrintStrLn(path);
    PrintStrLn("  Kein .lyx_lic — nicht lizenziert"c);
    close(fd);
    return 0;
  }

  // WP-10.4: shnum aus ELF-Header (uint16, max 65535); shnum*64 passt sicher in int64,
  // aber trotzdem explizit prüfen um manipulierte Dateien abzufangen.
  if (shnum > 65535) { close(fd); return 0; }
  // Read all section headers
  var shdrsSize: int64 := shnum * 64;
  var shdrs: int64 := alloc(shdrsSize + 8);
  lseek(fd, shoff, 0);
  if (read(fd, shdrs as pchar, shdrsSize) != shdrsSize) {  // WP-27: partieller Read → Abbruch
    free(shdrs, shdrsSize + 8); close(fd); return 0;
  }

  // Read .shstrtab
  var strsHdr: int64 := shdrs + shstrndx * 64;
  var strsOff:  int64 := peek64(strsHdr + ELF64_SHDR_OFF_OFFSET);
  var strsSize: int64 := peek64(strsHdr + ELF64_SHDR_OFF_SIZE);
  // WP-10.4: strsSize aus Datei; strsSize+8 darf nicht überlaufen (>2 GB ist unrealistisch)
  if (strsSize < 0 || strsSize > 0x7FFFFFFF) {
    free(shdrs, shdrsSize + 8); close(fd); return 0;
  }
  var strs: int64 := alloc(strsSize + 8);
  lseek(fd, strsOff, 0);
  if (read(fd, strs as pchar, strsSize) != strsSize) {  // WP-27: partieller Read → Abbruch
    free(shdrs, shdrsSize + 8); free(strs, strsSize + 8); close(fd); return 0;
  }

  // Search for .lyx_lic section: bytes 46 108 121 120 95 108 105 99 0 = ".lyx_lic\0"
  var licOff:  int64 := 0;
  var licSize: int64 := 0;
  var si: int64 := 0;
  while si < shnum {
    var sh: int64 := shdrs + si * 64;
    var nameOff: int64 := peek32(sh);
    if nameOff >= 0 && nameOff + 9 <= strsSize {
      var nm: int64 := strs + nameOff;
      if peek8(nm)   == 46  && peek8(nm+1) == 108 && peek8(nm+2) == 121 &&
         peek8(nm+3) == 120 && peek8(nm+4) == 95  && peek8(nm+5) == 108 &&
         peek8(nm+6) == 105 && peek8(nm+7) == 99  && peek8(nm+8) == 0 {
        licOff  := peek64(sh + ELF64_SHDR_OFF_OFFSET);
        licSize := peek64(sh + ELF64_SHDR_OFF_SIZE);
      }
    }
    si += 1;
  }
  free(shdrs, shdrsSize + 8);
  free(strs, strsSize + 8);

  if licOff == 0 {
    PrintStr("check-binary: "c); PrintStrLn(path);
    PrintStrLn("  Kein .lyx_lic — nicht lizenziert"c);
    close(fd);
    return 0;
  }

  if licSize < 16 {
    EPrintStrLn("check-binary: .lyx_lic Sektion zu klein"c);
    close(fd);
    return 1;
  }

  // Read the 16-byte payload
  var payload: int64 := alloc(16);
  lseek(fd, licOff, 0);
  if (read(fd, payload as pchar, 16) != 16) {  // WP-27: partieller Read → Abbruch
    free(payload, 16); close(fd); return 1;
  }
  close(fd);

  PrintStr("check-binary: "c); PrintStrLn(path);
  PrintStr("  Fingerprint: "c);
  var pi: int64 := 0;
  while pi < 8 {
    _lic_printHexByte(peek8(payload + pi));
    pi += 1;
  }
  PrintStr("\n"c);
  PrintStr("  KeyChecksum: "c);
  pi := 0;
  while pi < 4 {
    _lic_printHexByte(peek8(payload + 8 + pi));
    pi += 1;
  }
  PrintStr("\n"c);
  PrintStr("  Version:     "c);
  PrintInt(peek8(payload + 12));
  PrintStr("\n"c);

  // Key comparison: verify keyChecksum = SHA256(licenseKey)[0..3]
  var keyHash: int64 := 0;
  var keyOk: bool := false;
  var ki: int64 := 0;
  if cfg.licenseKey != 0 {
    keyHash := alloc(32);
    lic_sha256(cfg.licenseKey, cfg.licenseKeyLen, keyHash);
    keyOk := true;
    while ki < 4 {
      if peek8(keyHash + ki) != peek8(payload + 8 + ki) { keyOk := false; }
      ki += 1;
    }
    free(keyHash, 32);
    if keyOk {
      PrintStrLn("  KeyChecksum: OK — Schluessel stimmt ueberein"c);
    } else {
      PrintStrLn("  KeyChecksum: MISMATCH — anderer Lizenzschluessel"c);
    }
  } else {
    PrintStrLn("  KeyChecksum: (kein Schluessel geladen — --license-file= angeben zum Vergleich)"c);
  }

  free(payload, 16);
  return 0;
}

// ============================================================================
// Main Entry Point
// ============================================================================

pub fn main(argc: int64, argv: pchar): int64 {
  // Initialize compiler
  var cfg: CompilerConfig := new CompilerConfig();
  cfg.CfgInit();

  // Parse CLI
  var cliOk: bool := cfg.parseCLI(argc, argv);
  if not cliOk {
    return cfg.exitCode;
  }

  // Apply LYX_PATH / LYX_STD_PATH env vars as fallback when -I / --std-path not given
  if cfg.includePath == 0 {
    var ep: pchar := lyx_getEnvVar(argc, argv, "LYX_PATH"c);
    if ep != 0 as pchar { cfg.includePath := ep as int64; }
  }
  if cfg.stdPath == 0 {
    var es: pchar := lyx_getEnvVar(argc, argv, "LYX_STD_PATH"c);
    if es != 0 as pchar { cfg.stdPath := es as int64; }
  }

  // WP-LIC-07: License env vars — CLI flags take priority, env vars fill gaps
  if cfg.licenseFile == 0 {
    var ev: pchar := lyx_getEnvVar(argc, argv, "LYX_LICENSE_FILE"c);
    if ev != 0 as pchar { cfg.licenseFile := ev as int64; }
  }
  if cfg.licenseKey == 0 {
    var ev: pchar := lyx_getEnvVar(argc, argv, "LYX_LICENSE_KEY"c);
    if ev != 0 as pchar { cfg.licenseKey := ev as int64; }
  }
  if cfg.licenseName == 0 {
    var ev: pchar := lyx_getEnvVar(argc, argv, "LYX_LICENSE_NAME"c);
    if ev != 0 as pchar { cfg.licenseName := ev as int64; }
  }
  if cfg.licenseEmail == 0 {
    var ev: pchar := lyx_getEnvVar(argc, argv, "LYX_LICENSE_EMAIL"c);
    if ev != 0 as pchar { cfg.licenseEmail := ev as int64; }
  }

  // Print version banner unless suppressed with --quiet
  if not cfg.quiet {
    PrintStr("lyxc 1.0.16B — Copyright (c) 2026 Andreas Röne. All rights reserved.\n"c);
  }

  // WP-BC-50: --unit-info <file> — read .lyu file, print metadata, exit
  if cfg.unitInfoFile > 1 {
    var uiFd: int64 := -1;
    var uiBuf: int64 := 0;
    var uiSz: int64 := 0;
    var uiOk: bool := false;
    uiFd := open(cfg.unitInfoPath as pchar, 0, 0);
    if uiFd >= 0 {
      uiBuf := alloc(131072);
      uiSz := read(uiFd, uiBuf as pchar, 131071);
      if uiSz < 0 { uiSz := 0; }   // WP-27: EINTR-Guard — verhindert poke8(buf-1)
      poke8(uiBuf + uiSz, 0);
      close(uiFd);
      uiOk := true;
    }
    if not uiOk {
      EPrintStr("error: cannot open .lyu file\n"c);
      return 1;
    }
    var rdr: LyuReader := new LyuReader();
    if rdr.LyrInit(uiBuf, uiSz) {
      rdr.PrintInfo();
    } else {
      EPrintStr("error: invalid .lyu file"c);
      return 1;
    }
    return 0;
  }

  // WP-LIC-08: License verification (only in release builds)
  if LYXC_LICENSE_REQUIRED == 1 && not cfg.noLicense {
    if not lic_loadAndVerify(cfg, argc, argv) {
      return 1;
    }
  }

  // WP-LIC-11: --check-binary — inspect .lyx_lic watermark
  if cfg.checkBinary != 0 {
    // In dev builds, try to load the license silently for key comparison
    if LYXC_LICENSE_REQUIRED == 0 && not cfg.noLicense && cfg.licenseKey == 0 {
      lic_loadAndVerify(cfg, argc, argv);
    }
    return lic_checkBinary(cfg, argc, argv);
  }

  // WP-T15: --self-test benötigt kein Input-File
  if cfg.selfTest {
    var lyxcPath: pchar := peek64(argv as int64) as pchar;  // argv[0]
    return run_self_test(lyxcPath);
  }

  // Get input file
  var inputFile: pchar := cfg.inputFile;
  if inputFile == 0 {
    EPrintStrLn("Error: No input file specified");
    EPrintStrLn("Run with --help for usage");
    cfg.exitCode := 1;
    return cfg.exitCode;
  }

  // Check if we need to rebuild
  var outputFile: pchar := cfg.outputFile;
  if outputFile == 0 {
    outputFile := "a.out"c;
  }

  if cfg.shouldRebuild(inputFile, outputFile) {
    cfg.Compile(inputFile, outputFile);
  } else {
    if cfg.enableVerbose {
      PrintStr("Skipping "c);
      PrintStr(inputFile);
      PrintStrLn(" (already up to date)");
    }
  }

  // Print statistics
  cfg.PrintStats();
  
  // Cleanup
  var exitCode: int64 := cfg.exitCode;
  cfg.Free();

  return exitCode;
}
 
