      var capOff: int64 := parser.nodes + capScan * PARSER_NODE_SIZE;
      if peek64(capOff + 0) == NK_CAPABILITY_DECL {
        var capPtr: int64 := (parser.src as int64) + peek64(capOff + NODE_OFF_SVAL);
        var capLen: int64 := peek64(capOff + NODE_OFF_SLEN);
        self.lyxosCapBits := self.lyxosCapBits | self._capBitsFromPath(capPtr, capLen);
      }
      capScan += 1;
