        if peek64(slBase) == NK_FUNC_DECL {
          var slVal: int64 := (peek64(slBase + NODE_OFF_IVAL) >> ANNO_STACKLIMIT_SHIFT) & ANNO_STACKLIMIT_MAX;
          if slVal > 0 {
            var slName: pchar := (source as int64 + peek64(slBase + NODE_OFF_SVAL)) as pchar;
            var slLen:  int64 := peek64(slBase + NODE_OFF_SLEN);
            if slGraph.IsRecursive(slName, slLen) != 0 {
              EPrintStr("error: "c);
              sys_write(2, slName as int64, slLen);
              EPrintStrLn(": @stack_limit ist mit Rekursion nicht nachweisbar — die Aufruftiefe ist unbeschraenkt"c);
              self.exitCode := 1;
              return self.exitCode;
