  // ---------------------------------------------------------------------------
  // CLI Parsing
  // ---------------------------------------------------------------------------
  
  fn parseCLI(argc: int64, argv: pchar): bool {
    // Initialize ALL fields to known values (opts is embedded, not a pointer)
    // Memory from alloc may contain garbage
    self.inputFile := 0;
    self.outputFile := 0;
    self.target := 0;
    self.format := 0;
    self.optLevel := 0;
    self.enableLint := false;
    self.lintOnly := false;
    self.enableDebug := false;
    self.enableVerbose := false;
    self.dumpLexer := false;
    self.dumpParser := false;
    self.dumpSema := false;
    self.dumpIR := false;
    self.dumpASM := false;
    self.dumpRelocs := false;
    self.callGraph := false;
    self.mapFile := false;
    self.staticAnalysis := false;
    self.mcdc := false;
    self.mcdcReport := false;
    self.emitASM := false;
    self.emitRelocs := false;
    self.warningsAsErrors := false;
    self.warnAll := false;
    self.quiet := false;
    self.asmListing := false;
    self.lintOnly := false;
    self.outputType := OUTPUT_TYPE_EXECUTABLE;

    // Force verbose off for now
    self.enableVerbose := false;
    
    var i: int64 := 1;
    
    while i < argc {
      var arg: pchar := ArgvGet(argv, i);
      var argLen: int64 := StrLen(arg);
      
      if argLen == 0 {
        i += 1;
        continue;
      }
      
      var firstChar: int64 := peek8(arg);
      
      // Check for flag (starts with -)
      if firstChar == 45 {  // '-'
        if argLen == 1 {
          i += 1;
          continue;
        }
        
        var secondChar: int64 := peek8(arg + 1);
        
        // Long flags (--)
        if secondChar == 45 {  // '--'
          self.parseLongFlag(arg, argLen);
        } else if secondChar == 73 {  // '-I'
          if argLen > 2 {
            // -I<path> inline form
            self.includePath := (arg + 2) as int64;
          } else {
            // -I <path> two-token form: sentinel, next positional fills it
            self.includePath := 1;
          }
        } else {
          // Short flags (-)
          self.parseShortFlags(arg, argLen);
        }
      } else {
        // Positional argument
        if self.includePath == 1 {
          // Argument following -I (space-separated form)
          self.includePath := arg as int64;
        } else if self.cHeaderFile == 1 {
          // Argument following --include is the header path
          self.cHeaderFile := arg as int64;
        } else if self.unitInfoFile == 1 {
          // WP-BC-50: argument following --unit-info is the .lyu path
          self.unitInfoFile := 2;
          self.unitInfoPath := arg as int64;
        } else if self.inputFile == 0 {
          self.inputFile := arg as int64;
        } else if self.outputFile == 0 {
          self.outputFile := arg as int64;
        }
      }

      i += 1;
    }

    // #1163: Ein beanstandetes Argument beendet den Lauf, statt etwas
    // anderes zu bauen als gemeint. Vor earlyExit geprueft, damit ein
    // Tippfehler neben --help nicht doch noch als Erfolg endet.
    if self.badArg {
      self.exitCode := 2;
      return false;
    }
    // Validate required options
    if self.earlyExit {
      return false;
    }
    // Reject output paths with ".." components to prevent path traversal
    if self.outputFile != 0 {
      var opLen: int64 := StrLen(self.outputFile as pchar);
      var opi: int64 := 0;
      while opi < opLen - 1 {
        if (peek8(self.outputFile + opi) == 46) && (peek8(self.outputFile + opi + 1) == 46) {
          if opi == 0 || peek8(self.outputFile + opi - 1) == 47 {
            EPrintStr("lyxc: ungültiger Ausgabepfad: '..' ist nicht erlaubt\n"c);
            self.exitCode := 1;
            return false;
          }
        }
        opi += 1;
      }
    }
    if self.inputFile == 0 && self.unitInfoFile <= 1 && self.checkBinary == 0 && !self.selfTest && !self.migrateCaps {
      self.printHelp();
      self.exitCode := 1;
      return false;
    }
    
    // Set defaults
    if self.target == 0 {
      self.target := LYX_TC_X86_64;
    }
    if self.format == 0 {
      self.format := FORMAT_ELF;
    }
    if self.optLevel == 0 {
      self.optLevel := OPT_O2;
    }
    
    return true;
  }
  
  fn parseLongFlag(arg: int64, argLen: int64): void {
    // --target=x86_64|arm64|linux-arm64|riscv64|arm_cm|macos-x86_64
    if StrStartsWith(arg, "--target=") {
      var val: int64 := arg + 9;  // skip "--target=" (9 chars)
      if StrCmp(val, "x86_64"c) == 0 {
        self.target := LYX_TC_X86_64;
      } else if StrCmp(val, "arm64"c) == 0 {
        self.target := LYX_TC_ARM64;
      } else if StrCmp(val, "linux-arm64"c) == 0 {
        self.target := LYX_TC_ARM64;
      } else if StrCmp(val, "riscv64"c) == 0 {
        self.target := LYX_TC_RISCV64;
      } else if StrCmp(val, "arm_cm"c) == 0 {
        self.target := LYX_TC_ARM_CM;
      } else if StrCmp(val, "macos-x86_64"c) == 0 {
        self.target := LYX_TC_MACOS_X86_64;
      } else if StrCmp(val, "windows-x86_64"c) == 0 {
        self.target := LYX_TC_WINDOWS_X86_64;
      } else if StrCmp(val, "macos-arm64"c) == 0 {
        self.target := LYX_TC_MACOS_ARM64;
        self.format := FORMAT_MACHO;
      } else if StrCmp(val, "windows-arm64"c) == 0 {
        self.target := LYX_TC_WINDOWS_ARM64;
        self.format := FORMAT_PE;
      } else if StrCmp(val, "linux-riscv64"c) == 0 {
        self.target := LYX_TC_LINUX_RISCV64;
        self.format := FORMAT_ELF;
      } else if StrCmp(val, "arm-cm4"c) == 0 || StrCmp(val, "arm-cm33"c) == 0 {
        self.target := LYX_TC_ARM_CM4;
        self.format := FORMAT_ELF;
      } else if StrCmp(val, "esp32"c) == 0 || StrCmp(val, "esp32s3"c) == 0 {
        self.target := LYX_TC_XTENSA;
        self.format := FORMAT_ELF;
      } else if StrCmp(val, "android-arm64"c) == 0 || StrCmp(val, "android"c) == 0 {
        // Default Android architecture: ARM64 (Android 5.0+ requires 64-bit ARM)
        self.target := LYX_TC_ANDROID_ARM64;
        self.format := FORMAT_ELF;
      } else if StrCmp(val, "android-x86_64"c) == 0 {
        self.target := LYX_TC_ANDROID_X86_64;
        self.format := FORMAT_ELF;
      } else if StrCmp(val, "win64"c) == 0 {
        self.target := LYX_TC_WINDOWS_X86_64;
        self.format := FORMAT_PE;
      } else if StrCmp(val, "linux"c) == 0 {
        self.target := LYX_TC_X86_64;
        self.format := FORMAT_ELF;
      } else if StrCmp(val, "macosx64"c) == 0 {
        self.target := LYX_TC_MACOS_X86_64;
        self.format := FORMAT_MACHO;
      } else if StrCmp(val, "riscv"c) == 0 {
        self.target := LYX_TC_RISCV64;
        self.format := FORMAT_ELF;
      } else if StrCmp(val, "lyxos"c) == 0 {
        self.target := LYX_TC_LYXOS;
        self.format := FORMAT_ELF;
      } else if StrCmp(val, "lyxos-kernel"c) == 0 {
        self.target     := LYX_TC_LYXOS;
        self.format     := FORMAT_ELF;
        self.kernelMode := 1;
      }
      return;
    }

    // --include-path=PATH (long form of -I)
    if StrStartsWith(arg, "--include-path=") {
      self.includePath := (arg + 15) as int64;
      return;
    }

    // --std-path=PATH
    if StrStartsWith(arg, "--std-path=") {
      self.stdPath := arg + 11;   // S2: "--std-path=" = 11 Zeichen (war arg+10 → lieferte "=PATH")
      return;
    }
    
    // --arch=x86_64|arm64|riscv64|arm_cm (alias für --target)
    if StrStartsWith(arg, "--arch=") {
      var val: int64 := arg + 7;
      if StrCmp(val, "x86_64"c) == 0 {
        self.target := LYX_TC_X86_64;
        self.arch := LYX_TC_X86_64;
      } else if StrCmp(val, "arm64"c) == 0 {
        self.target := LYX_TC_ARM64;
        self.arch := LYX_TC_ARM64;
      } else if StrCmp(val, "riscv"c) == 0 || StrCmp(val, "riscv64"c) == 0 {
        self.target := LYX_TC_RISCV64;
        self.arch := LYX_TC_RISCV64;
      } else if StrCmp(val, "arm_cm"c) == 0 {
        self.target := LYX_TC_ARM_CM;
        self.arch := LYX_TC_ARM_CM;
      }
      return;
    }
    
    // --output= or -o
    if StrStartsWith(arg, "--output=") {
      self.outputFile := arg + 9;
      return;
    }

    // --output-type=executable|shared-lib (WP-AND-02)
    if StrStartsWith(arg, "--output-type=") {
      var val: int64 := arg + 14;
      if StrCmp(val, "executable"c) == 0 || StrCmp(val, "exe"c) == 0 {
        self.outputType := OUTPUT_TYPE_EXECUTABLE;
      } else if StrCmp(val, "shared-lib"c) == 0 || StrCmp(val, "so"c) == 0 || StrCmp(val, "shared"c) == 0 {
        self.outputType := OUTPUT_TYPE_SHARED_LIB;
      }
      return;
    }

    // --shared (alias for --output-type=shared-lib, WP-AND-02)
    if StrCmp(arg, "--shared"c) == 0 {
      self.outputType := OUTPUT_TYPE_SHARED_LIB;
      return;
    }

    // --android-api=N (WP-AND-03): target Android API level for .so/.note.android.ident.
    // Accepts 21+ (64-bit ARM minimum); lower values default back to ANDROID_API_DEFAULT.
    if StrStartsWith(arg, "--android-api=") {
      // Parse digits manually (avoid ParseInt clobber bug under the seed bootstrap).
      var p: int64 := arg + 14;
      var apiVal: int64 := 0;
      while peek8(p) >= 48 && peek8(p) <= 57 {
        apiVal := apiVal * 10 + peek8(p) - 48;
        p += 1;
      }
      if apiVal >= ANDROID_API_MIN {
        self.androidApiLevel := apiVal;
      } else {
        EPrintStrLn("warning: --android-api < 21 ignored (64-bit ARM requires API 21+)");
      }
      return;
    }
    
    // --opt=O0|O1|O2|O3|Osafe
    if StrStartsWith(arg, "--opt=") {
      var val: int64 := arg + 6;
      if StrCmp(val, "O0"c) == 0 {
        self.optLevel := OPT_NONE;
      } else if StrCmp(val, "O1"c) == 0 {
        self.optLevel := OPT_O1;
      } else if StrCmp(val, "O2"c) == 0 {
        self.optLevel := OPT_O2;
      } else if StrCmp(val, "O3"c) == 0 {
        self.optLevel := OPT_O3;
      } else if StrCmp(val, "Osafe"c) == 0 {
        self.optLevel := OPT_SAFE;
      }
      return;
    }
    
    // --format=elf|pe|macho
    if StrStartsWith(arg, "--format=") {
      var val: int64 := arg + 9;
      if StrCmp(val, "elf"c) == 0 {
        self.format := FORMAT_ELF;
      } else if StrCmp(val, "pe"c) == 0 {
        self.format := FORMAT_PE;
      } else if StrCmp(val, "macho"c) == 0 {
        self.format := FORMAT_MACHO;
      }
      return;
    }
    
    // Boolean flags
    if StrCmp(arg, "--lint"c) == 0 {
      self.enableLint := true;
      return;
    }
    if StrCmp(arg, "--lint-only"c) == 0 {
      self.lintOnly := true;
      self.enableLint := true;
      return;
    }
    if StrCmp(arg, "--debug"c) == 0 {
      self.enableDebug := true;
      return;
    }
    if StrCmp(arg, "--verbose"c) == 0 {
      self.enableVerbose := true;
      return;
    }
    if StrCmp(arg, "--quiet"c) == 0 {
      self.quiet := true;
      return;
    }
    if StrCmp(arg, "--warnings-as-errors"c) == 0 {
      self.warningsAsErrors := true;
      return;
    }
    if StrCmp(arg, "--warn-all"c) == 0 {
      self.warnAll := true;
      return;
    }
    if StrCmp(arg, "--dump-lexer"c) == 0 {
      self.dumpLexer := true;
      return;
    }
    if StrCmp(arg, "--dump-parser"c) == 0 {
      self.dumpParser := true;
      return;
    }
    if StrCmp(arg, "--dump-sema"c) == 0 {
      self.dumpSema := true;
      return;
    }
    if StrCmp(arg, "--dump-ir"c) == 0 {
      self.dumpIR := true;
      return;
    }
    if StrCmp(arg, "--dump-asm"c) == 0 {
      self.dumpASM := true;
      return;
    }
    if StrCmp(arg, "--emit-asm"c) == 0 {
      self.emitASM := true;
      return;
    }
    if StrCmp(arg, "--emit=obj"c) == 0 || StrCmp(arg, "-c"c) == 0 {
      self.emitObj := true;   // WSP-07: relocatable ELF-Objekt (ET_REL) für extern "asm"
      return;
    }
    if StrCmp(arg, "--emit=lbf"c) == 0 {
      self.emitLBF := true;
      return;
    }
    if StrCmp(arg, "--list"c) == 0 {
      self.dumpList := true;
      return;
    }

    // CLI P2: --target-energy=N
    if StrStartsWith(arg, "--target-energy=") {
      // #1163: Derselbe Wert als Attribut (`@energy(9)`) wird sauber
      // abgewiesen; ueber das Flag fiel er still auf einen Default zurueck.
      // Die Pruefung gab es also schon, sie lief nur auf dem CLI-Pfad nicht.
      var val: int64 := arg + 16;
      var vp:  pchar := val as pchar;
      var vlen: int64 := StrLen(vp);
      var ok: int64 := 1;
      if vlen == 0 { ok := 0; }
      var vi: int64 := 0;
      while vi < vlen {
        var vc: int64 := peek8(val + vi);
        if vc < 48 || vc > 57 { ok := 0; }
        vi += 1;
      }
      if ok == 0 {
        EPrintStr("lyxc: --target-energy erwartet eine Zahl 1..5, nicht '"c);
        sys_write(2, val, vlen);
        EPrintStrLn("'"c);
        self.badArg := true;
        return;
      }
      var lvl: int64 := ParseInt(val);
      if lvl < 1 || lvl > 5 {
        EPrintStr("lyxc: --target-energy: Stufe ausserhalb 1..5: '"c);
        sys_write(2, val, vlen);
        EPrintStrLn("'"c);
        self.badArg := true;
        return;
      }
      self.targetEnergy := lvl;
      return;
    }

    // CLI P2: --dump-relocs
    if StrCmp(arg, "--dump-relocs"c) == 0 {
      self.dumpRelocs := true;
      return;
    }

    // CLI P2: --trace-imports
    if StrCmp(arg, "--trace-imports"c) == 0 {
      self.traceImports := true;
      return;
    }

    // CLI P3: --asm-listing
    if StrCmp(arg, "--asm-listing"c) == 0 {
      self.asmListing := true;
      return;
    }

    // CLI P3: --mcdc
    if StrCmp(arg, "--mcdc"c) == 0 {
      self.mcdc := true;
      return;
    }

    // CLI P3: --mcdc-report
    if StrCmp(arg, "--mcdc-report"c) == 0 {
      self.mcdcReport := true;
      return;
    }

    // CLI P3: --static-analysis
    if StrCmp(arg, "--static-analysis"c) == 0 {
      self.staticAnalysis := true;
      return;
    }

    // CLI P3: --call-graph
    if StrCmp(arg, "--call-graph"c) == 0 {
      self.callGraph := true;
      return;
    }

    // CLI P3: --map-file
    if StrCmp(arg, "--map-file"c) == 0 {
      self.mapFile := true;
      return;
    }

    // WP-BC-30: --include <header.h>  (next positional arg is the .h path)
    if StrCmp(arg, "--include"c) == 0 {
      self.cHeaderFile := 1;  // sentinel: next arg is the header path
      return;
    }
    
    // WP-BC-43: --trace / --profile
    if StrCmp(arg, "--trace"c) == 0 {
      self.traceEnabled := true;
      return;
    }
    if StrCmp(arg, "--profile"c) == 0 {
      self.profileEnabled := true;
      return;
    }

    // WP-BC-44: --trace-passes / --ir-source-map
    if StrCmp(arg, "--trace-passes"c) == 0 {
      self.tracePasses := true;
      return;
    }
    if StrCmp(arg, "--ir-source-map"c) == 0 {
      self.irSourceMap := true;
      return;
    }

    // WP-BC-45: --ast-dump / --symtab-dump
    if StrCmp(arg, "--ast-dump"c) == 0 {
      self.astDump := true;
      return;
    }
    if StrCmp(arg, "--symtab-dump"c) == 0 {
      self.symtabDump := true;
      return;
    }

    // WP-BC-46: --type-reasoning / --constraint-log
    if StrCmp(arg, "--type-reasoning"c) == 0 {
      self.typeReasoning := true;
      return;
    }
    if StrCmp(arg, "--constraint-log"c) == 0 {
      self.constraintLog := true;
      return;
    }

    // WP-BC-47: --provenance
    if StrCmp(arg, "--provenance"c) == 0 {
      self.provenance := true;
      return;
    }

    // WP-BC-48: --runtime-checks
    if StrCmp(arg, "--runtime-checks"c) == 0 {
      self.runtimeChecks := true;
      return;
    }

    // #1141: --verify-tmr prueft, dass jeder Zugriff auf eine
    // @redundant-Variable ueber die Mehrheitsentscheidung geht.
    if StrCmp(arg, "--verify-tmr"c) == 0 {
      self.verifyTmr := true;
      return;
    }

    // WP-3.2: --meta-safe
    if StrCmp(arg, "--meta-safe"c) == 0 {
      self.metaSafe := true;
      return;
    }

    // WP-A5: --no-libc-init — call main directly, skip __libc_start_main (bare-metal/static)
    if StrCmp(arg, "--no-libc-init"c) == 0 {
      self.noLibcInit := true;
      return;
    }

    // WP-BC-49: --debug-symbols
    if StrCmp(arg, "--debug-symbols"c) == 0 {
      self.debugSymbols := true;
      return;
    }

    // WP-T14: --migrate-capabilities / --capabilities=compat
    if StrCmp(arg, "--migrate-capabilities"c) == 0 {
      self.migrateCaps := true;
      return;
    }
    if StrCmp(arg, "--capabilities=compat"c) == 0 {
      self.capCompat := true;
      // WP-25.1: prominente Compiler-Warnung
      EPrintStrLn("WARNUNG: --capabilities=compat aktiv!"c);
      EPrintStrLn("         seccomp, landlock und Userspace-Proxy werden vollstaendig deaktiviert."c);
      EPrintStrLn("         Das generierte Binary laeuft OHNE Laufzeitschutz."c);
      return;
    }

    // WP-T15: --self-test
    if StrCmp(arg, "--self-test"c) == 0 {
      self.selfTest := true;
      return;
    }


    // WP-BC-50: --compile-unit / --unit-info
    if StrCmp(arg, "--compile-unit"c) == 0 {
      self.compileUnit := true;
      return;
    }
    if StrCmp(arg, "--unit-info"c) == 0 {
      self.unitInfoFile := 1;  // sentinel: next positional arg is the .lyu path
      return;
    }

    // --version
    if StrCmp(arg, "--version"c) == 0 {
      PrintStr("lyxc"c);
      PrintStr(" "c);
      PrintStrLn("1.0.16B"c);
      PrintStr("Build: "c);
      PrintStrLn("bootstrap"c);
      self.exitCode := 0;
      self.earlyExit := true;
      return;
    }

    // --help
    if StrCmp(arg, "--help"c) == 0 {
      self.printHelp();
      self.exitCode := 0;
      self.earlyExit := true;
      return;
    }

    // --build-info
    if StrCmp(arg, "--build-info"c) == 0 {
      PrintStrLn("Compiler Build Information:");
      PrintStr("  Name: "c);
      PrintStrLn("lyxc"c);
      PrintStr("  Version: "c);
      PrintStrLn("1.0.16B"c);
      PrintStr("  Build: "c);
      PrintStrLn("bootstrap"c);
      PrintStr("  Target: "c);
      PrintStrLn("x86_64-linux-elf");
      self.exitCode := 0;
      self.earlyExit := true;
      return;
    }

    // --config
    if StrCmp(arg, "--config"c) == 0 {
      PrintStrLn("Compiler Configuration:");
      PrintStr("  Targets: x86_64, arm64, riscv64, arm_cm, android-arm64, android-x86_64"c);
      PrintStrLn("");
      PrintStr("  Formats: elf, pe, macho"c);
      PrintStrLn("");
      PrintStr("  Optimization: O0, O1, O2, O3, Osafe"c);
      self.exitCode := 0;
      return;
    }
    
    // --no-opt (disable optimizations)
    if StrCmp(arg, "--no-opt"c) == 0 {
      self.optLevel := OPT_NONE;
      return;
    }

    // WP-AS-15: --daa (enable Definite Assignment Analysis warnings)
    if StrCmp(arg, "--daa"c) == 0 {
      self.daaWarn := 1;
      return;
    }
    // WP-AS-15: --daa-strict (DAA as errors, not warnings)
    if StrCmp(arg, "--daa-strict"c) == 0 {
      self.daaWarn := 2;
      return;
    }

    // --no-lint (disable linter)
    if StrCmp(arg, "--no-lint"c) == 0 {
      self.enableLint := false;
      return;
    }

    // WP-LIC-06: License flags
    if StrStartsWith(arg, "--license-file=") {
      self.licenseFile := arg + 15;
      return;
    }
    if StrStartsWith(arg, "--license=") {
      self.licenseKey := arg + 10;
      return;
    }
    if StrStartsWith(arg, "--name=") {
      self.licenseName := arg + 7;
      return;
    }
    if StrStartsWith(arg, "--email=") {
      self.licenseEmail := arg + 8;
      return;
    }
    if StrStartsWith(arg, "--check-binary=") {
      self.checkBinary := arg + 15;
      return;
    }
    if StrCmp(arg, "--no-license"c) == 0 {
      self.noLicense := true;
      return;
    }
    // #1163: Bis 1.0.15C endete diese Kette ohne Zweig — ein unbekanntes
    // Langflag wurde stillschweigend verschluckt und der Bau lief mit Exit 0
    // weiter. `--voellig-erfunden` und ein vertipptes echtes Flag waren damit
    // nicht zu unterscheiden. Auch `--energy-stats` aus guides/ fiel hier
    // durch, weshalb der Fehler in der Doku nie auffiel.
    EPrintStr("lyxc: unbekannter Schalter '"c);
    sys_write(2, arg, argLen);
    EPrintStrLn("'"c);
    EPrintStrLn("  `lyxc --help` listet die gueltigen Schalter."c);
    self.badArg := true;
  }
  
  fn parseShortFlags(arg: int64, argLen: int64): void {
    var i: int64 := 1;
    while i < argLen {
      var c: int64 := peek8(arg + i);
      
      if c == 79 {  // 'O'
        // -Olevel
        var level: int64 := peek8(arg + i + 1);
        if level == 48 {  // '0'
          self.optLevel := OPT_NONE;
        } else if level == 49 {  // '1'
          self.optLevel := OPT_O1;
        } else if level == 50 {  // '2'
          self.optLevel := OPT_O2;
        } else if level == 51 {  // '3'
          self.optLevel := OPT_O3;
        } else {
          // #1163: -O ohne Stufe oder mit einer, die es nicht gibt.
          EPrintStrLn("lyxc: -O erwartet eine Stufe 0..3"c);
          self.badArg := true;
        }
        // Die Stufe gehoert zum Schalter — sonst laeuft die Ziffer gleich
        // darauf als eigenes, unbekanntes Zeichen durch die Pruefung.
        if level >= 48 && level <= 51 { i += 1; }
      } else if c == 118 {  // 'v'
        self.enableVerbose := true;
      } else if c == 100 {  // 'd'
        self.enableDebug := true;
      } else if c == 108 {  // 'l'
        self.enableLint := true;
      } else if c == 71 {  // 'g'
        self.enableDebug := true;
      } else if c == 111 {  // 'o'
        // #1163: `-o` selbst traegt keinen Zustand — die Ausgabedatei folgt
        // als eigenes Argument und wird von der Positionslogik aufgenommen.
        // Hier steht der Fall nur, damit die Pruefung unten ihn nicht als
        // unbekannt meldet.
        i += 0;
      } else if c == 119 {  // 'w'
        var wOk: int64 := 0;
        if i + 1 < argLen {
          var next: int64 := peek8(arg + i + 1);
          if next == 101 {  // 'e'
            self.warningsAsErrors := true;
            wOk := 1;
          } else if next == 97 {  // 'a'
            self.warnAll := true;
            wOk := 1;
          }
        }
        if wOk == 0 {
          EPrintStrLn("lyxc: -w erwartet 'a' (alle Warnungen) oder 'e' (Warnungen als Fehler)"c);
          self.badArg := true;
        } else {
          i += 1;   // den verbrauchten Buchstaben ueberspringen
        }
      } else {
        // #1163: Bis 1.0.15C wurde jedes unbekannte Zeichen stillschweigend
        // verschluckt — `-Xyz` uebersetzte klaglos und mit Exit 0. Wer sich
        // vertippt, bekam ein Binary, das anders uebersetzt wurde als
        // beabsichtigt, ohne es zu merken.
        EPrintStr("lyxc: unbekannter Schalter '-"c);
        sys_write(2, arg + i, 1);
        EPrintStrLn("'"c);
        self.badArg := true;
      }

      i += 1;
    }
  }
  
