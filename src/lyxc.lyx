      var outPath: pchar := outputFile;
      if outPath == 0 as pchar { outPath := "a.exe"c; }
      var _t5w: int64 := self._passStart("codegen-win-x86_64"c);
      var cg: Codegen := new Codegen();
      cg.Init(source, parser.nodes, parser.toks);
      cg.includePath := self.includePath;
      cg.stdPath     := self.stdPath;
      injectCgSystemConstants(cg, cfg_archCode(self), cfg_osCode(self));  // WP-CS-05
      cg.ioCheckEnabled       := sema.ioCheckEnabled;        // WP-CS-07
      cg.overflowCheckEnabled := sema.overflowCheckEnabled;  // WP-CS-07
      cg.boundsCheckEnabled   := sema.boundsCheckEnabled;    // WP-AS-04
      cg.boundsCheckForced    := sema.boundsCheckForced;     // #1124
      cg.optLevel             := sema.optLevel;              // WP-AS-04
      cg.globalEnergyLevel    := self.targetEnergy;          // WP-EN-01: CLI
      if (cg.globalEnergyLevel == 0 && sema.energyLevel > 0) {
        cg.globalEnergyLevel  := sema.energyLevel;           // WP-EN-03: top-level @energy
      }
      cg.Generate(astRoot);
      var wxb: WinX86Backend := new WinX86Backend();
      wxb.Init();
      wxb.SetBaseRelocs(cg.cg_getBaseRelocBuf(), cg.cg_getBaseRelocCount());  // WP-A2.2
      wxb.Build(cg.code, cg.codeLen, cg.data, cg.dataLen);
      wxb.WritePE64(outPath);
      self._passEnd("codegen-win-x86_64"c, _t5w);
      return self.exitCode;
    }

    // Stage 5: IR Generation (for non-x86_64 targets)
    // Create IR module and lower AST → IR
    var irMod: IRModule := new IRModule();
    irMod.init();
    irMod.irSourceMap := self.irSourceMap;  // WP-BC-44
    irMod.provenance  := self.provenance;   // WP-BC-47

    var lower: IRLower := new IRLower();
    var irPtr: int64 := irMod as int64;
    lower.init(irPtr, parser.nodes, parser.nodeCount, source, irMod);
    lower.target := self.target;  // WSP-05: steuert arch-spezifische asm-Mnemonic-Tabelle
    lower.lowerModule(astRoot);

    // WP-BC-44: dump IR (--dump-ir or --ir-source-map)
    if self.dumpIR || self.irSourceMap {
      irMod.dump();
    }

    // WP-BC-47: --provenance dump
    if self.provenance {
      self.dumpProvenance(irMod, parser.nodes, source, inputFile);
    }
    
    // Stage 6: Optimization (WP-AS-06: gated on CLI optLevel)
    if (self.optLevel != 0) {
      var irOpt: IROptimize := new IROptimize();
      irOpt.init(irMod);
      // Prefer inline @optimization_level directive over CLI flag when set
      var effOpt: int64 := self.optLevel;
      if (sema.optLevel != 2) { effOpt := sema.optLevel; }  // non-default inline wins
      irOpt.optLevel := effOpt;
      irOpt.optimize();
    }

    // Stage 7: Code Generation
    if self.enableVerbose {
      PrintStrLn("Stage 7: Code Generation...");
    }

    // LX-00: --emit=lbf — serialize IR to .lbf bytecode file (lyxos target only)
    if self.emitLBF {
      if self.target != LYX_TC_LYXOS {
        EPrintStrLn("error: --emit=lbf requires --target=lyxos");
        self.exitCode := 1;
        return self.exitCode;
      }
      var outFile: pchar := self.outputFile;
      if outFile == 0 { outFile := "a.lbf"c; }
      var lbfw: LBFWriter := new LBFWriter();
      if !lbfw.serialize(irMod as int64, outFile) {
        EPrintStrLn("error: failed to write .lbf file");
        self.exitCode := 1;
        return self.exitCode;
      }
      return self.exitCode;
    }

    var codeBuffer: int64 := 0;

    if self.target == LYX_TC_X86_64 {
      codeBuffer := self.emitX86_64(irMod as int64, lower);
    } else if self.target == LYX_TC_ARM64 {
      codeBuffer := self.emitARM64(irMod as int64);
    } else if self.target == LYX_TC_ANDROID_ARM64 {
      // WP-AND-01: Android target registered; routes to Linux ARM64 backend.
      // Bionic-specific ABI (TLS, stack alignment, .eh_frame) is WP-AND-03.
      codeBuffer := self.emitARM64(irMod as int64);
    } else if self.target == LYX_TC_ANDROID_X86_64 {
      // WP-AND-01: Android x86_64 routes to Linux x86_64 backend (emulator target).
      codeBuffer := self.emitX86_64(irMod as int64, lower);
    } else if self.target == LYX_TC_MACOS_ARM64 {
      codeBuffer := self.emitMacOSARM64(irMod as int64);
    } else if self.target == LYX_TC_WINDOWS_ARM64 {
      codeBuffer := self.emitWindowsARM64(irMod as int64);
    } else if self.target == LYX_TC_LINUX_RISCV64 {
      codeBuffer := self.emitLinuxRISCV64(irMod as int64);
    } else if self.target == LYX_TC_ARM_CM4 {
      codeBuffer := self.emitARMCM4(irMod as int64);
    } else if self.target == LYX_TC_XTENSA {
      codeBuffer := self.emitXtensa(irMod as int64);
    } else if self.target == LYX_TC_RISCV64 {
      codeBuffer := self.emitRISCV(irMod as int64);
    } else if self.target == LYX_TC_ARM_CM {
      codeBuffer := self.emitARMCm(irMod as int64);
    } else if self.target == LYX_TC_LYXOS {
      codeBuffer := self.emitLyxOS(irMod as int64);
    }

    if codeBuffer == 0 {
      EPrintStrLn("error: codegen failed");
      self.exitCode := 1;
      return self.exitCode;
    }

    // Windows ARM64 / Linux RISC-V / ARM CM4 / Xtensa / LyxOS: file already written inside emit*
    if self.target == LYX_TC_WINDOWS_ARM64 || self.target == LYX_TC_LINUX_RISCV64 || self.target == LYX_TC_ARM_CM4 || self.target == LYX_TC_XTENSA || self.target == LYX_TC_LYXOS {
      return self.exitCode;
    }

    // Store codeSize from emit call
    // (self.codeSize was set by emitX86_64)

    // Stage 8: Binary Writing
    if self.enableVerbose {
      PrintStrLn("Stage 8: Writing Binary...");
    }

    var outFile: pchar := self.outputFile;
    if outFile == 0 {
      outFile := "a.out"c;
    }

    // WP-AND-02 Phase B: collect @export functions for shared-library symbol table.
    if self.outputType == OUTPUT_TYPE_SHARED_LIB {
      self.buildExportList(parser, astRoot);
    }

    var writeResult: bool := self.writeBinary(outFile, codeBuffer, self.codeSize);
    
    if not writeResult {
      EPrintStrLn("Error: Cannot write output file");
      self.exitCode := 1;
      return self.exitCode;
    }
    
    if self.enableVerbose {
      PrintStr("Wrote: "c);
      PrintStrLn(outFile);
    }
    
    return self.exitCode;
  }

  // ---------------------------------------------------------------------------
  // WP-BC-41: LFD Qt-UI-Builder — emit .h/.cpp for all NK_LFD_FORM nodes
  // ---------------------------------------------------------------------------

  fn emitLfdForms(astRoot: int64, nodes: int64, src: pchar, inputFile: pchar) {
    // Walk the top-level declaration list looking for NK_LFD_FORM nodes.
    // For each form, generate a .h and .cpp file next to the input file.
    var nd: int64 := astRoot;
    while (nd >= 0) {
      if (peek64(nodes + nd * 88) == 95) {  // LFD_NK_FORM = 95
        var nameOff: int64 := peek64(nodes + nd * PARSER_NODE_SIZE + NODE_OFF_SVAL);
        var nameLen: int64 := peek64(nodes + nd * PARSER_NODE_SIZE + NODE_OFF_SLEN);

        // Build base path: inputFile directory + formName
        var inputLen: int64 := StrLen(inputFile);
        // find last '/' to get directory prefix
        var lastSlash: int64 := -1;
        var pi: int64 := 0;
        while (pi < inputLen) {
          if (StrCharAt(inputFile, pi) == 47) { lastSlash := pi; }
          pi += 1;
        }
        var dirLen: int64 := lastSlash + 1;  // 0 if no slash

        // basePath = dir + formName  (null-terminated)
        var basePathSz: int64 := dirLen + nameLen + 8;
        var basePathBuf: int64 := alloc(basePathSz);
        var basePath: pchar := basePathBuf as pchar;
        var bpi: int64 := 0;
        pi := 0;
        while (pi < dirLen) {
          poke8(basePath as int64 + bpi, StrCharAt(inputFile, pi) & 255);
          bpi += 1; pi := pi + 1;
        }
        pi := 0;
        while (pi < nameLen) {
          poke8(basePath as int64 + bpi, StrCharAt(src, nameOff + pi) & 255);
          bpi += 1; pi := pi + 1;
        }
        poke8(basePath as int64 + bpi, 0);

        // headerName = formName + ".h"  (for #include in .cpp)
        var headerNameSz: int64 := nameLen + 4;
        var headerNameBuf: int64 := alloc(headerNameSz);
        var headerName: pchar := headerNameBuf as pchar;
        pi := 0;
        while (pi < nameLen) {
          poke8(headerName as int64 + pi, StrCharAt(src, nameOff + pi) & 255);
          pi += 1;
        }
        var dotH: pchar := ".h";
        memcpy(headerName as int64 + nameLen, dotH as int64, 3);

        // hPath = basePath + ".h"
        var hPathLen: int64 := StrLen(basePath);
        var hPathSz: int64 := hPathLen + 4;
        var hPathBuf: int64 := alloc(hPathSz);
        var hPath: pchar := hPathBuf as pchar;
        pi := 0;
        while (pi < hPathLen) {
          poke8(hPath as int64 + pi, StrCharAt(basePath, pi) & 255);
          pi += 1;
        }
        var dotH2: pchar := ".h";
        memcpy(hPath as int64 + hPathLen, dotH2 as int64, 3);

        // cppPath = basePath + ".cpp"
        var cppPathSz: int64 := hPathLen + 6;
        var cppPathBuf: int64 := alloc(cppPathSz);
        var cppPath: pchar := cppPathBuf as pchar;
        pi := 0;
        while (pi < hPathLen) {
          poke8(cppPath as int64 + pi, StrCharAt(basePath, pi) & 255);
          pi += 1;
        }
        var dotCpp: pchar := ".cpp";
        memcpy(cppPath as int64 + hPathLen, dotCpp as int64, 5);

        var gen: LfdCodeGen := new LfdCodeGen();
        gen.Init(src, nodes);

        // Generate .h
        gen.GenerateHeader(nd);
        FileWriteAll(hPath, gen.GetOut(), gen.GetOutLen());
        if self.enableVerbose {
          PrintStr("LFD: wrote "c);
          PrintStrLn(hPath);
        }

        // Generate .cpp
        gen.GenerateSource(nd, headerName);
        FileWriteAll(cppPath, gen.GetOut(), gen.GetOutLen());
        if self.enableVerbose {
          PrintStr("LFD: wrote "c);
          PrintStrLn(cppPath);
        }
      }
      nd := peek64(nodes + nd * PARSER_NODE_SIZE + NODE_OFF_NEXT);  // next
    }
  }

  // ---------------------------------------------------------------------------
  // Code Emission
  // ---------------------------------------------------------------------------

  fn emitX86_64(irMod: int64, lower: IRLower): int64 {
    // Generate code with _start and main
    // _start at offset 0, main at offset 19
    var codeBuf: int64 := alloc(65536);
    var codeLen: int64 := 0;
    
    // _start: standard entry point at vaddr 0x401000
    // Layout: push rbp(1) + mov rbp,rsp(3) + call(5) + mov rdi,rax(3) + mov eax,60(5) + syscall(2) = 19 bytes
    // main starts at offset 19; call next IP=9, rel32 = 19-9 = 10

    // push rbp (offset 0)
    poke8(codeBuf + codeLen, 85);
    codeLen += 1;
    // mov rbp, rsp (offset 1): 48 89 E5
    poke8(codeBuf + codeLen, 72);   // REX.W
    codeLen += 1;
    poke8(codeBuf + codeLen, 137);  // MOV r/m64, r64
    codeLen += 1;
    poke8(codeBuf + codeLen, 229);  // ModRM 0xE5 = 11 100 101 = mov rbp, rsp
    codeLen += 1;

    // call main (offset 4): E8 rel32; next IP = 9; main at 19; rel32 = 10
    poke8(codeBuf + codeLen, 232);  // E8
    codeLen += 1;
    poke8(codeBuf + codeLen, 10);   // rel32 = 10
    codeLen += 1;
    poke8(codeBuf + codeLen, 0);
    codeLen += 1;
    poke8(codeBuf + codeLen, 0);
    codeLen += 1;
    poke8(codeBuf + codeLen, 0);
    codeLen += 1;
    
    // After main returns, exit with return value in rax
    // mov rdi, rax (3 bytes at 0x40100e)
    // x86-64: 48 89 c7 = mov rdi, rax
    poke8(codeBuf + codeLen, 72);
    codeLen += 1;
    poke8(codeBuf + codeLen, 137);
    codeLen += 1;
    poke8(codeBuf + codeLen, 199);
    codeLen += 1;
    
    // mov eax, 60 (offset 12): B8 3C 00 00 00 — zero-extends to rax
    poke8(codeBuf + codeLen, 184);  // B8 = MOV EAX, imm32
    codeLen += 1;
    poke8(codeBuf + codeLen, 60);   // 60 = sys_exit
    codeLen += 1;
    poke8(codeBuf + codeLen, 0);
    codeLen += 1;
    poke8(codeBuf + codeLen, 0);
    codeLen += 1;
    poke8(codeBuf + codeLen, 0);
    codeLen += 1;

    // syscall (offset 17): 0F 05
    poke8(codeBuf + codeLen, 15);
    codeLen += 1;
    poke8(codeBuf + codeLen, 5);
    codeLen += 1;
    
    // main (offset 19 = 0x401013)
    // push rbp
    poke8(codeBuf + codeLen, 85);   // 55
    codeLen += 1;
    // mov rbp, rsp: 48 89 E5
    poke8(codeBuf + codeLen, 72);   // REX.W
    codeLen += 1;
    poke8(codeBuf + codeLen, 137);  // MOV r/m64, r64
    codeLen += 1;
    poke8(codeBuf + codeLen, 229);  // ModRM 0xE5 = 11 100 101 = mov rbp, rsp
    codeLen += 1;
    // mov eax, 42: B8 2A 00 00 00 (zero-extends to rax)
    poke8(codeBuf + codeLen, 184);  // B8 = MOV EAX, imm32
    codeLen += 1;
    poke8(codeBuf + codeLen, 42);   // 42
    codeLen += 1;
    poke8(codeBuf + codeLen, 0);
    codeLen += 1;
    poke8(codeBuf + codeLen, 0);
    codeLen += 1;
    poke8(codeBuf + codeLen, 0);
    codeLen += 1;
    // pop rbp
    poke8(codeBuf + codeLen, 93);   // 5D
    codeLen += 1;
    // ret
    poke8(codeBuf + codeLen, 195);  // C3
    codeLen += 1;
    
    self.codeSize := codeLen;
    return codeBuf;
  }

  fn emitARM64(irMod: int64): int64 {
    // ARM64-FIX: irMod für writeELF*/Globals verfügbar machen (war nie gesetzt → 0).
    self.irModulePtr := irMod;
    // If the IR module has functions, use the IR-based emitter.
    var funcCount: int64 := peek64(irMod + IR_MOD_OFF_FUNCLEN);
    if funcCount > 0 {
      var emitter: EmitARM64 := new EmitARM64();
      emitter.init(irMod);
      // WP-AND-02 Phase C: enable PIC global access + relocation recording.
      if self.outputType == OUTPUT_TYPE_SHARED_LIB {
        emitter.setSharedLib(1);
      }
      emitter.emit();
      var irCodeLen: int64 := emitter.getCodeLen();
      var irCodeBuf: int64 := emitter.getCodeBuf();
      // WP-AND-02 Phase B: expose funcAddrs for export-table building.
      self.codeFuncAddrs := emitter.getFuncAddrs();
      // WP-AND-02 Phase C: harvest dynamic-reloc records.
      self.relocBuf   := emitter.getRelocBuf();
      self.relocCount := emitter.getRelocCount();
      // WP-AND-upstream-fix v5: harvest global-load slot table + IR module ptr.
      self.globalRelocBuf   := emitter.getGlobalRelocBuf();
      self.globalRelocCount := emitter.getGlobalRelocCount();
      self.armExternBuf     := emitter.getExternBuf();
      self.armExternCount   := emitter.getExternCount();
      self.irModulePtr      := irMod;
      // WP-AND-03: harvest prologue-length table + function count for DWARF CFI.
      self.codeFuncPrologueLen := emitter.getFuncPrologueLen();
      self.codeFuncTotal       := emitter.funcCount;

      // WP-AND-02 Phase B: for shared libraries skip the executable _start stub.
      // The Android loader never invokes a .so's e_entry; the stub would be dead
      // code that pushes exported function offsets by 12 bytes.
      if self.outputType == OUTPUT_TYPE_SHARED_LIB {
        self.codeStubOff := 0;
        self.codeSize := irCodeLen;
        return irCodeBuf;
      }

      // WP-A5: For dynamically-linked binaries (armExternCount > 0) and --no-libc-init not set,
      // prepend a 56-byte _start that calls __libc_start_main before main.
      // Layout:
      //  0: ADR  x0, #56      — address of main (main is at offset 56)
      //  4: LDR  x1, [sp]     — argc from stack
      //  8: ADD  x2, sp, #8   — argv = sp+8
      // 12: MOVZ x3, #0       — init=NULL
      // 16: MOVZ x4, #0       — fini=NULL
      // 20: MOVZ x5, #0       — rtld_fini=NULL
      // 24: ADD  x6, sp, #0   — stack_end=sp
      // 28: LDR  x8, [pc,#20] — load __libc_start_main from GOT slot at offset 48
      // 32: BLR  x8            — call __libc_start_main
      // 36: MOVZ x8, #93      — fallback: SYS_exit
      // 40: SVC  #0            — fallback syscall
      // 44: NOP                — align GOT to 8 bytes
      // 48: .quad 0            — GOT slot for __libc_start_main (filled by loader)
      // 56: IR-emitted code (main...)
      //
      // For static binaries or --no-libc-init, use the original 12-byte stub.
      if self.armExternCount > 0 && !self.noLibcInit {
        if irCodeLen > 131016 {
          EPrintStr("lyxc: ARM64 code section too large for dynamic stub (>131016 bytes)\n"c);
          return;
        }
        self.codeStubOff := 56;
        var totalLen2: int64 := 56 + irCodeLen;
        var dynBuf: int64 := alloc(131072);
        // ADR x0, #56 = 0x100001C0
        poke8(dynBuf +  0, 0xC0); poke8(dynBuf +  1, 0x01); poke8(dynBuf +  2, 0x00); poke8(dynBuf +  3, 0x10);
        // LDR x1, [sp] = 0xF94003E1
        poke8(dynBuf +  4, 0xE1); poke8(dynBuf +  5, 0x03); poke8(dynBuf +  6, 0x40); poke8(dynBuf +  7, 0xF9);
        // ADD x2, sp, #8 = 0x910023E2
        poke8(dynBuf +  8, 0xE2); poke8(dynBuf +  9, 0x23); poke8(dynBuf + 10, 0x00); poke8(dynBuf + 11, 0x91);
        // MOVZ x3, #0 = 0xD2800003
        poke8(dynBuf + 12, 0x03); poke8(dynBuf + 13, 0x00); poke8(dynBuf + 14, 0x80); poke8(dynBuf + 15, 0xD2);
        // MOVZ x4, #0 = 0xD2800004
        poke8(dynBuf + 16, 0x04); poke8(dynBuf + 17, 0x00); poke8(dynBuf + 18, 0x80); poke8(dynBuf + 19, 0xD2);
        // MOVZ x5, #0 = 0xD2800005
        poke8(dynBuf + 20, 0x05); poke8(dynBuf + 21, 0x00); poke8(dynBuf + 22, 0x80); poke8(dynBuf + 23, 0xD2);
        // ADD x6, sp, #0 = 0x910003E6  (MOV x6, sp)
        poke8(dynBuf + 24, 0xE6); poke8(dynBuf + 25, 0x03); poke8(dynBuf + 26, 0x00); poke8(dynBuf + 27, 0x91);
        // LDR x8, [pc, #20] = 0x580000A8  (loads GOT at offset 48)
        poke8(dynBuf + 28, 0xA8); poke8(dynBuf + 29, 0x00); poke8(dynBuf + 30, 0x00); poke8(dynBuf + 31, 0x58);
        // BLR x8 = 0xD63F0100
        poke8(dynBuf + 32, 0x00); poke8(dynBuf + 33, 0x01); poke8(dynBuf + 34, 0x3F); poke8(dynBuf + 35, 0xD6);
        // MOVZ x8, #93 = 0xD2800BA8 (fallback exit)
        poke8(dynBuf + 36, 0xA8); poke8(dynBuf + 37, 0x0B); poke8(dynBuf + 38, 0x80); poke8(dynBuf + 39, 0xD2);
        // SVC #0 = 0xD4000001
        poke8(dynBuf + 40, 0x01); poke8(dynBuf + 41, 0x00); poke8(dynBuf + 42, 0x00); poke8(dynBuf + 43, 0xD4);
        // NOP = 0xD503201F (padding for 8-byte GOT alignment)
        poke8(dynBuf + 44, 0x1F); poke8(dynBuf + 45, 0x20); poke8(dynBuf + 46, 0x03); poke8(dynBuf + 47, 0xD5);
        // GOT slot for __libc_start_main (offset 48, 8 bytes zero — filled by loader)
        poke64(dynBuf + 48, 0);
        // Copy IR code after stub
        memcpy(dynBuf + 56, irCodeBuf, irCodeLen);
        self.arm64LibcStartMainUsed := true;
        self.codeSize := totalLen2;
        return dynBuf;
      }

      // Static/no-libc-init: 20-byte _start stub: load argc/argv then BL main + exit
      // _start (offset  0): LDR x0, [sp]     — argc from Linux AArch64 ABI stack → x0
      // _start (offset  4): ADD x1, sp, #8   — argv pointer → x1
      // _start (offset  8): BL main           — main at offset 20, imm26 delta = 3
      // _start (offset 12): MOVZ x8, #93     — SYS_EXIT fallback
      // _start (offset 16): SVC #0
      // main   (offset 20): IR-emitted function code
      self.codeStubOff := 20;
      var totalLen: int64 := 20 + irCodeLen;
      var newBuf: int64 := alloc(131072);

      // LDR x0, [sp] = 0xF94003E0
      poke8(newBuf + 0, 0xE0);  poke8(newBuf + 1, 0x03);
      poke8(newBuf + 2, 0x40);  poke8(newBuf + 3, 0xF9);
      // ADD x1, sp, #8 = 0x910023E1
      poke8(newBuf + 4, 0xE1);  poke8(newBuf + 5, 0x23);
      poke8(newBuf + 6, 0x00);  poke8(newBuf + 7, 0x91);
      // BL main — ARM64-FIX: delta zu main's ECHTEM Offset berechnen.
      // Vorher hardcodiert delta=3 → traf immer die ERSTE emittierte Funktion
      // (funcId 0). Wenn main nicht zuerst steht (Helper davor), wurde der Helper
      // mit x0=argc aufgerufen statt main. main bei (20 + mainOff); BL bei Offset 8.
      var asMfb: int64 := peek64(irMod + IR_MOD_OFF_FUNCBUF);
      var asMsb: int64 := peek64(irMod + IR_MOD_OFF_STRBUF);
      var asMfc: int64 := peek64(irMod + IR_MOD_OFF_FUNCLEN);
      var asMainId: int64 := 0;
      var asMi: int64 := 0;
      while asMi < asMfc {
        var asNoff: int64 := peek64(asMfb + asMi * IR_FUNC_SIZE);
        var asNlen: int64 := peek64(asMfb + asMi * IR_FUNC_SIZE + IR_FUNC_OFF_NAMELEN);
        if asNlen == 4 {
          if peek8(asMsb + asNoff) == 109 && peek8(asMsb + asNoff + 1) == 97 &&
             peek8(asMsb + asNoff + 2) == 105 && peek8(asMsb + asNoff + 3) == 110 {
            asMainId := asMi;
          }
        }
        asMi += 1;
      }
      var asMainOff: int64 := peek64(self.codeFuncAddrs + asMainId * 8);
      var asBlImm: int64 := (12 + asMainOff) / 4;   // (20 + mainOff - 8) / 4
      poke8(newBuf + 8,  asBlImm & 0xFF);        poke8(newBuf + 9,  (asBlImm >> 8) & 0xFF);
      poke8(newBuf + 10, (asBlImm >> 16) & 0xFF); poke8(newBuf + 11, 0x94);
      // MOVZ x8, #93 = 0xD2800BA8
      poke8(newBuf + 12, 0xA8); poke8(newBuf + 13, 0x0B);
      poke8(newBuf + 14, 0x80); poke8(newBuf + 15, 0xD2);
      // SVC #0 = 0xD4000001
      poke8(newBuf + 16, 0x01); poke8(newBuf + 17, 0x00);
      poke8(newBuf + 18, 0x00); poke8(newBuf + 19, 0xD4);

      // Copy IR code after stub
      memcpy(newBuf + 20, irCodeBuf, irCodeLen);

      self.codeSize := totalLen;
      return newBuf;
    }

    // Fallback: generate _start + main stub in ARM64 instructions.
    // Layout (all 32-bit ARM64 instructions):
    //   Offset  0: BL main          (main at offset 12 → delta=3)
    //   Offset  4: MOVZ x8, #93     (sys_exit)
    //   Offset  8: SVC #0
    //   Offset 12: _main prologue
    //   Offset 12: STP x29,x30,[sp,#-16]!
    //   Offset 16: MOV x29, sp
    //   Offset 20: MOVZ x0, #42    (return value)
    //   Offset 24: LDP x29,x30,[sp],#16
    //   Offset 28: RET
    var codeBuf: int64 := alloc(4096);
    var off: int64 := 0;

    // _start (offset 0):
    // BL main  — main is at offset 12, delta = (12-0)/4 = 3
    poke8(codeBuf + off,     3);   off := off + 1;  // imm26 low byte
    poke8(codeBuf + off,     0);   off := off + 1;
    poke8(codeBuf + off,     0);   off := off + 1;
    poke8(codeBuf + off,  0x94);   off := off + 1;  // BL opcode

    // MOVZ x8, #93  (= 0xD2800BA8)
    poke8(codeBuf + off,  0xA8);   off := off + 1;
    poke8(codeBuf + off,  0x0B);   off := off + 1;
    poke8(codeBuf + off,  0x80);   off := off + 1;
    poke8(codeBuf + off,  0xD2);   off := off + 1;

    // SVC #0  (= 0xD4000001)
    poke8(codeBuf + off,  0x01);   off := off + 1;
    poke8(codeBuf + off,  0x00);   off := off + 1;
    poke8(codeBuf + off,  0x00);   off := off + 1;
    poke8(codeBuf + off,  0xD4);   off := off + 1;

    // main (offset 12):
    // STP x29,x30,[sp,#-16]!  (= 0xA9BF7BFD)
    poke8(codeBuf + off,  0xFD);   off := off + 1;
    poke8(codeBuf + off,  0x7B);   off := off + 1;
    poke8(codeBuf + off,  0xBF);   off := off + 1;
    poke8(codeBuf + off,  0xA9);   off := off + 1;

    // MOV x29, sp  (= 0x910003FD)
    poke8(codeBuf + off,  0xFD);   off := off + 1;
    poke8(codeBuf + off,  0x03);   off := off + 1;
    poke8(codeBuf + off,  0x00);   off := off + 1;
    poke8(codeBuf + off,  0x91);   off := off + 1;

    // MOVZ x0, #42  (= 0xD2800540)
    poke8(codeBuf + off,  0x40);   off := off + 1;
    poke8(codeBuf + off,  0x05);   off := off + 1;
    poke8(codeBuf + off,  0x80);   off := off + 1;
    poke8(codeBuf + off,  0xD2);   off := off + 1;

    // LDP x29,x30,[sp],#16  (= 0xA8C17BFD)
    poke8(codeBuf + off,  0xFD);   off := off + 1;
    poke8(codeBuf + off,  0x7B);   off := off + 1;
    poke8(codeBuf + off,  0xC1);   off := off + 1;
    poke8(codeBuf + off,  0xA8);   off := off + 1;

    // RET  (= 0xD65F03C0)
    poke8(codeBuf + off,  0xC0);   off := off + 1;
    poke8(codeBuf + off,  0x03);   off := off + 1;
    poke8(codeBuf + off,  0x5F);   off := off + 1;
    poke8(codeBuf + off,  0xD6);   off := off + 1;

    self.codeSize := off;
    return codeBuf;
  }

  fn emitMacOSARM64(irMod: int64): int64 {
    // macOS ARM64 (Apple Silicon): 16-byte _start stub + IR-emitted code.
    // Syscall convention: number in x16, SVC #0x80; exit = 0x2000001.
    var funcCount: int64 := peek64(irMod + IR_MOD_OFF_FUNCLEN);
    if funcCount > 0 {
      var emitter: EmitARM64 := new EmitARM64();
      emitter.init(irMod);
      emitter.emit();
      var irCodeLen: int64 := emitter.getCodeLen();
      var irCodeBuf: int64 := emitter.getCodeBuf();
      var totalLen: int64 := 16 + irCodeLen;
      var newBuf: int64 := alloc(131072);

      // BL main — main at offset 16 (4 instructions forward) = 0x94000004
      poke8(newBuf + 0,  4);     poke8(newBuf + 1,  0);
      poke8(newBuf + 2,  0);     poke8(newBuf + 3,  0x94);
      // MOVZ x16, #1 = 0xD2800030
      poke8(newBuf + 4,  0x30);  poke8(newBuf + 5,  0x00);
      poke8(newBuf + 6,  0x80);  poke8(newBuf + 7,  0xD2);
      // MOVK x16, #0x200, LSL#16 = 0xF2A04010  (x16 becomes 0x2000001)
      poke8(newBuf + 8,  0x10);  poke8(newBuf + 9,  0x40);
      poke8(newBuf + 10, 0xA0);  poke8(newBuf + 11, 0xF2);
      // SVC #0x80 = 0xD4001001
      poke8(newBuf + 12, 0x01);  poke8(newBuf + 13, 0x10);
      poke8(newBuf + 14, 0x00);  poke8(newBuf + 15, 0xD4);

      var ci: int64 := 0;
      memcpy(newBuf + 16, irCodeBuf, irCodeLen);

      self.codeSize := totalLen;
      return newBuf;
    }

    // Fallback: minimal stub returning 42
    var codeBuf: int64 := alloc(4096);
    var off: int64 := 0;

    // BL main (offset 16 → 4 instructions = 0x94000004)
    poke8(codeBuf + off, 4);     off := off + 1;
    poke8(codeBuf + off, 0);     off := off + 1;
    poke8(codeBuf + off, 0);     off := off + 1;
    poke8(codeBuf + off, 0x94);  off := off + 1;
    // MOVZ x16, #1 = 0xD2800030
    poke8(codeBuf + off, 0x30);  off := off + 1;
    poke8(codeBuf + off, 0x00);  off := off + 1;
    poke8(codeBuf + off, 0x80);  off := off + 1;
    poke8(codeBuf + off, 0xD2);  off := off + 1;
    // MOVK x16, #0x200, LSL#16 = 0xF2A04010
    poke8(codeBuf + off, 0x10);  off := off + 1;
    poke8(codeBuf + off, 0x40);  off := off + 1;
    poke8(codeBuf + off, 0xA0);  off := off + 1;
    poke8(codeBuf + off, 0xF2);  off := off + 1;
    // SVC #0x80 = 0xD4001001
    poke8(codeBuf + off, 0x01);  off := off + 1;
    poke8(codeBuf + off, 0x10);  off := off + 1;
    poke8(codeBuf + off, 0x00);  off := off + 1;
    poke8(codeBuf + off, 0xD4);  off := off + 1;
    // main: STP x29,x30,[sp,#-16]! = 0xA9BF7BFD
    poke8(codeBuf + off, 0xFD);  off := off + 1;
    poke8(codeBuf + off, 0x7B);  off := off + 1;
    poke8(codeBuf + off, 0xBF);  off := off + 1;
    poke8(codeBuf + off, 0xA9);  off := off + 1;
    // MOV x29, sp = 0x910003FD
    poke8(codeBuf + off, 0xFD);  off := off + 1;
    poke8(codeBuf + off, 0x03);  off := off + 1;
    poke8(codeBuf + off, 0x00);  off := off + 1;
    poke8(codeBuf + off, 0x91);  off := off + 1;
    // MOVZ x0, #42 = 0xD2800540
    poke8(codeBuf + off, 0x40);  off := off + 1;
    poke8(codeBuf + off, 0x05);  off := off + 1;
    poke8(codeBuf + off, 0x80);  off := off + 1;
    poke8(codeBuf + off, 0xD2);  off := off + 1;
    // LDP x29,x30,[sp],#16 = 0xA8C17BFD
    poke8(codeBuf + off, 0xFD);  off := off + 1;
    poke8(codeBuf + off, 0x7B);  off := off + 1;
    poke8(codeBuf + off, 0xC1);  off := off + 1;
    poke8(codeBuf + off, 0xA8);  off := off + 1;
    // RET = 0xD65F03C0
    poke8(codeBuf + off, 0xC0);  off := off + 1;
    poke8(codeBuf + off, 0x03);  off := off + 1;
    poke8(codeBuf + off, 0x5F);  off := off + 1;
    poke8(codeBuf + off, 0xD6);  off := off + 1;

    self.codeSize := off;
    return codeBuf;
  }

  fn emitWindowsARM64(irMod: int64): int64 {
    var outPath: pchar := self.outputFile;
    if outPath == 0 as pchar { outPath := "a.exe"c; }
    var wab: WinARM64Backend := new WinARM64Backend();
    wab.Init();
    var funcCount: int64 := peek64(irMod + IR_MOD_OFF_FUNCLEN);
    if funcCount > 0 {
      var emitter: EmitARM64 := new EmitARM64();
      emitter.init(irMod);
      // WP-D2: Windows mode — replace Linux syscalls with Windows API helper calls
      emitter.setWinMode(1);
      emitter.emit();
      wab.Build(emitter.getCodeBuf(), emitter.getCodeLen(),
                emitter.getWinPatchBuf(), emitter.getWinPatchCount());
    } else {
      wab.Build(0, 0, 0, 0);
    }
    wab.WritePE64(outPath);
    self.codeSize := wab.GetCodeSize();
    return 1;
  }

