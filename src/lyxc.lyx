  // WP-BC-47: count newlines up to offset to get 1-based line number
  fn _lineFromSrcOff(src: pchar, sOff: int64): int64 {
    var line: int64 := 1;
    var i: int64 := 0;
    while i < sOff {
      if StrCharAt(src, i) == 10 { line := line + 1; }
      i += 1;
    }
    return line;
  }

  // WP-BC-47: provenance dump — IR[N] op → AST[M] kind 'name' → src:file:line
  fn dumpProvenance(irMod: IRModule, pNodes: int64, src: pchar, srcFile: pchar): void {
    PrintStr("=== PROVENANCE ===\n"c);
    var count: int64 := irMod.instrLen;
    var i: int64 := 0;
    while i < count {
      var astNi: int64 := irMod.getAstNode(i);
      PrintStr("IR["c);
      PrintInt(i);
      PrintStr("] "c);
      PrintStr(irMod.dumpOp(irMod.getInstrOp(i)));
      PrintStr("  ->  "c);
      if astNi < 0 {
        PrintStr("AST[-] ?\n"c);
      } else {
        var base: int64 := pNodes + astNi * 88;
        var kind: int64 := peek64(base);
        var sOff: int64 := peek64(base + NODE_OFF_SVAL);
        var sLen: int64 := peek64(base + NODE_OFF_SLEN);
        PrintStr("AST["c);
        PrintInt(astNi);
        PrintStr("] "c);
        PrintStr(self._nkStr(kind));
        if sLen > 0 && (src as int64) != 0 {
          PrintStr(" '"c);
          PrintStr(StrSub(src, sOff, sLen));
          PrintStr("'"c);
        }
        PrintStr("  ->  src:"c);
        if (srcFile as int64) != 0 { PrintStr(srcFile); } else { PrintStr("?"c); }
        PrintStr(":"c);
        if (src as int64) != 0 {
          PrintInt(self._lineFromSrcOff(src, sOff));
        } else {
          PrintStr("?"c);
        }
        PrintStr("\n"c);
      }
      i += 1;
    }
  }

