    if k == NK_LIT_FLOAT   { return "LIT_FLOAT"c; }
    if k == NK_LIT_STR     { return "LIT_STR"c; }
    if k == NK_LIT_CHAR    { return "LIT_CHAR"c; }
    if k == NK_LIT_BOOL    { return "LIT_BOOL"c; }
    if k == NK_LIT_NULL    { return "LIT_NULL"c; }
