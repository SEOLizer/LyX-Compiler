    if k == NK_STRUCT_DECL { return "STRUCT_DECL"c; }
    if k == NK_FIELD_DECL  { return "FIELD_DECL"c; }
    if k == NK_ENUM_DECL   { return "ENUM_DECL"c; }
    if k == NK_ENUM_MEM    { return "ENUM_MEM"c; }
    if k == NK_TYPE_DECL   { return "TYPE_DECL"c; }
    if k == NK_BLOCK       { return "BLOCK"c; }
    if k == NK_IF          { return "IF"c; }
    if k == NK_WHILE       { return "WHILE"c; }
    if k == NK_FOR         { return "FOR"c; }
    if k == NK_SWITCH      { return "SWITCH"c; }
    if k == NK_CASE        { return "CASE"c; }
    if k == NK_BREAK       { return "BREAK"c; }
    if k == NK_CONTINUE    { return "CONTINUE"c; }
    if k == NK_RETURN      { return "RETURN"c; }
    if k == NK_EXPR_STMT   { return "EXPR_STMT"c; }
    if k == NK_ASSIGN      { return "ASSIGN"c; }
    if k == NK_DISPOSE     { return "DISPOSE"c; }
    if k == NK_ASSERT      { return "ASSERT"c; }
