  // LX-01/LX-02: Lyx OS x86-64 backend.
  // Compiles IR → machine code, then writes ELF with .note.lyx-abi.
  // CAPS-Mapping: prüft ob die cap-Pfad-Bytes [ptr,len) mit dem Literal-Präfix beginnen.
  fn _capMatch(ptr: int64, len: int64, lit: pchar, litLen: int64): bool {
    if len < litLen { return false; }
    var i: int64 := 0;
    while i < litLen {
      if peek8(ptr + i) != peek8((lit as int64) + i) { return false; }
      i += 1;
    }
    return true;
  }

  // CAPS-Mapping: @capabilities-Pfad (z.B. "fs.read") → LBF_CAP_*-Bit. 0 = unbekannt/ignoriert.
  fn _capBitsFromPath(ptr: int64, len: int64): int64 {
    if self._capMatch(ptr, len, "fs.write"c, 8)   { return 2; }   // LBF_CAP_FS_WRITE
    if self._capMatch(ptr, len, "fs.read"c, 7)    { return 1; }   // LBF_CAP_FS_READ
    if self._capMatch(ptr, len, "network"c, 7)    { return 4; }   // LBF_CAP_NET_SOCKET
    if self._capMatch(ptr, len, "net."c, 4)       { return 4; }
    if self._capMatch(ptr, len, "process"c, 7)    { return 8; }   // LBF_CAP_PROC_SPAWN
    if self._capMatch(ptr, len, "proc."c, 5)      { return 8; }
    if self._capMatch(ptr, len, "ki.graph"c, 8)   { return 32; }  // LBF_CAP_KI_GRAPH_WRITE
    if self._capMatch(ptr, len, "ki.embed"c, 8)   { return 16; }  // LBF_CAP_KI_EMBED
    if self._capMatch(ptr, len, "audio"c, 5)      { return 128; } // LBF_CAP_AUDIO_MIC
    return 0;
  }

  fn emitLyxOS(irMod: int64): int64 {
    var outPath: pchar := self.outputFile;
    if outPath == 0 as pchar { outPath := "a.out"c; }

    var emitter: EmitLyxOS := new EmitLyxOS();
    emitter.init(irMod);

    // LX-36: choose _start variant by lifecycle kind.
    // RTC-Canary-Seed (kein getrandom in §10.4) verschiebt die CALL-Offsets:
    // ONE_SHOT/DAEMON (0,2): 64-byte stub; CALL rel32 at +46, callNextIP=50.
    // EVENT_LOOP (1): 86-byte stub; CALL rel32 at +68, callNextIP=72.
    // REACTIVE (3): no _start needed (kernel jumps to handler directly).
    if self.lifecycleKind == 1 {
        emitter.emitStartStubEventLoop();
    }
    if self.lifecycleKind != 1 {
        emitter.emitStartStub();
    }
    // Emit all IR functions. mainOff = absolute buffer offset of main().
    var mainOff: int64 := emitter.emitFunctions();

    // Append IR string pool and patch all CONST_STR LEA rel32s (LX-04).
    emitter.emitStrPool();

    // LYXOS-WP-3: Globals-Daten-Pool anhängen + RIP-relative Zugriffe patchen.
    emitter.emitGlobalsPool();

    // Patch CALL rel32 in _start now that mainOff is known.
    if self.lifecycleKind == 1 {
        emitter.patchCallRel32(68, mainOff - 72);  // EVENT_LOOP: rel32 at +68, callNextIP=72
    }
    if self.lifecycleKind != 1 {
        emitter.patchCallRel32(46, mainOff - 50);  // ONE_SHOT/DAEMON/REACTIVE: rel32 at +46, callNextIP=50
    }

    var lbf: LBFNativeWriter := new LBFNativeWriter();
    lbf.setLifecycle(self.lifecycleKind, 0, 0);  // LX-36: no events at compile time (handler VAs unknown)
    lbf.setCapabilities(self.lyxosCapBits);       // CAPS-TLV aus @capabilities (sonst nur STDIO)
    // LYXOS-WP-5: Sektions-Größen für Multi-Section-SECTION_MAP + Genesis-Counts.
    lbf.setSections(emitter.getTextLen(), emitter.getRodataLen(), emitter.getDataLen());
    if !lbf.writeLBF(outPath, self.inputFile as pchar, emitter.getCodeBuf(), emitter.getCodeLen()) {
      EPrintStrLn("error: lyxos: failed to write LBF");
      self.exitCode := 1;
      return 1;
    }
    self.codeSize := emitter.getCodeLen();
    return 1;
  }

  // ---------------------------------------------------------------------------
  // Binary Writing
  // ---------------------------------------------------------------------------
  
  // WP-AND-02 Phase B/B2: append a Java_<class>_<method> mangled name into
  // self.mangledNamesBuf. Replaces '.' with '_' in the class part. Returns
  // an absolute pchar to the NUL-terminated mangled string. Length is the
  // pre-mangling sum: 5 ("Java_") + classLen + 1 ("_") + methodLen.
  // (Phase B2 keeps mangling minimal — no _1/_0XXXX escapes; revisit if a
  // class or method name contains a literal underscore.)
  fn _mangleJniName(classPtr: int64, classLen: int64, methodPtr: int64, methodLen: int64): int64 {
    var outLen: int64 := 5 + classLen + 1 + methodLen;
    var need:   int64 := self.mangledNamesLen + outLen + 1;
    if need > self.mangledNamesCap {
      var newCap: int64 := self.mangledNamesCap * 2;
      if newCap < need { newCap := need + 64; }
      if newCap < 256  { newCap := 256; }
      var nb: int64 := alloc(newCap);
      var i: int64 := 0;
      memcpy(nb, self.mangledNamesBuf, self.mangledNamesLen);
      self.mangledNamesBuf := nb;
      self.mangledNamesCap := newCap;
    }
    var dst: int64 := self.mangledNamesBuf + self.mangledNamesLen;
    var javaPrefix: pchar := "Java_";
    memcpy(dst, javaPrefix as int64, 5);
    var wi: int64 := 5;
    var ci: int64 := 0;
    while ci < classLen {
      var ch: int64 := peek8(classPtr + ci);
      if ch == 46 { ch := 95; }    // '.' -> '_'
      poke8(dst + wi, ch);
      wi += 1;
      ci += 1;
    }
    StrSetChar(dst as pchar, wi, 95);
    wi += 1;
    memcpy(dst + wi, methodPtr, methodLen);
    wi += methodLen;
    poke8(dst + wi, 0);             // NUL terminator
    self.mangledNamesLen := self.mangledNamesLen + outLen + 1;
    return dst;
  }

  // WP-AND-02 Phase B/B2: collect @export- and @jni-annotated top-level
  // functions into self.exportBuf (24-byte records: [namePtr, nameLen, stValue]).
  // For @export the namePtr is parser.src + nameOff; for @jni it points into
  // self.mangledNamesBuf (Java_<class>_<method>).
  // Relies on the invariant that ir_lower's lowerModule processes top-level
  // NK_FUNC_DECL nodes in source order, so funcId N == N-th NK_FUNC_DECL.
  fn buildExportList(parser: Parser, astRoot: int64): void {
    var EXPORT_MASK: int64 := ANNO_EXPORT | ANNO_JNI;

    // Pass 1: count.
    var count: int64 := 0;
    var cur: int64 := astRoot;
    while cur >= 0 {
      var off: int64 := parser.nodes + cur * PARSER_NODE_SIZE;
      var kind: int64 := peek64(off + 0);
      if kind == NK_FUNC_DECL {
        var anno: int64 := peek64(off + NODE_OFF_IVAL);
        if (anno & EXPORT_MASK) != 0 { count := count + 1; }
      }
      cur := peek64(off + NODE_OFF_NEXT);
    }

    self.exportCount := count;
    if count == 0 { self.exportBuf := 0; return; }
    if self.codeFuncAddrs == 0 { self.exportBuf := 0; self.exportCount := 0; return; }

    // Pass 2: fill records.
    self.exportBuf := alloc(count * 24);
    var idx:    int64 := 0;
    var funcId: int64 := 0;
    cur := astRoot;
    while cur >= 0 {
      var off2:  int64 := parser.nodes + cur * PARSER_NODE_SIZE;
      var kind2: int64 := peek64(off2 + 0);
      if kind2 == NK_FUNC_DECL {
        var anno2: int64 := peek64(off2 + NODE_OFF_IVAL);
        if (anno2 & EXPORT_MASK) != 0 {
          var addr: int64 := peek64(self.codeFuncAddrs + funcId * 8) + self.codeStubOff;
          var namePtr: int64 := 0;
          var nameLen: int64 := 0;
          if (anno2 & ANNO_JNI) != 0 {
            var jniRec: int64 := parser.FindJniEntry(cur);
            if jniRec != 0 {
              var cOff: int64 := peek64(jniRec +  8);
              var cLen: int64 := peek64(jniRec + JNI_REC_OFF_CLASSLEN);
              var mOff: int64 := peek64(jniRec + JNI_REC_OFF_METHODOFF);
              var mLen: int64 := peek64(jniRec + JNI_REC_OFF_METHODLEN);
              var beforeLen: int64 := self.mangledNamesLen;
              namePtr := self._mangleJniName((parser.src as int64) + cOff, cLen,
                                             (parser.src as int64) + mOff, mLen);
              nameLen := self.mangledNamesLen - beforeLen - 1;  // exclude NUL
            } else {
              // @jni without args parsed — fall back to the raw function name.
              namePtr := (parser.src as int64) + peek64(off2 + NODE_OFF_SVAL);
              nameLen := peek64(off2 + NODE_OFF_SLEN);
            }
          } else {
            namePtr := (parser.src as int64) + peek64(off2 + NODE_OFF_SVAL);
            nameLen := peek64(off2 + NODE_OFF_SLEN);
          }
          var rec: int64 := self.exportBuf + idx * 24;
          poke64(rec +  0, namePtr);
          poke64(rec +  8, nameLen);
          poke64(rec + EXPBUF_OFF_ADDR, addr);
          idx += 1;
        }
        funcId += 1;
      }
      cur := peek64(off2 + NODE_OFF_NEXT);
    }
  }

  fn writeBinary(path: pchar, code: int64, size: int64): bool {
    if self.format == FORMAT_ELF {
      if self.outputType == OUTPUT_TYPE_SHARED_LIB {
        return self.writeELFSharedLib(path, code, size);
      }
      return self.writeELF(path, code, size);
    } else if self.format == FORMAT_PE {
      return self.writePE(path, code, size);
    } else if self.format == FORMAT_MACHO {
      return self.writeMachO(path, code, size);
    }
    return false;
  }
  
  // Dynamically-linked AArch64 ET_EXEC for FFI programs. Mirrors the x86_64
  // cg_writeELFDynamic: base 0x400000, code at file 0x1000 (VA 0x401000 =
  // e_entry), /lib/ld-linux-aarch64.so.1, one inline GOT slot per extern call
  // resolved by the loader via R_AARCH64_GLOB_DAT (relocs harvested from the
  // emitter). One RWX PT_LOAD maps the whole file so the ELF header, .interp
  // and .dynamic are all in memory and the GOT slots are writable.
  fn writeELFExecDynamic(path: pchar, code: int64, size: int64): bool {
    var baseVA: int64 := 0x400000;
    var codeFileOff: int64 := 4096;
    var interpOff: int64 := 232;     // after ELF hdr (64) + 3 phdrs (3*56)
    var interpStr: pchar := "/lib/ld-linux-aarch64.so.1";
    var interpLen: int64 := StrLen(interpStr) + 1;
    var nExt: int64 := self.armExternCount;
    var strBuf: int64 := peek64(self.irModulePtr + IR_MOD_OFF_STRBUF);   // IR string table
    var libcStartMainSymOff: int64 := 0;
    var libcSo6DynstrOff: int64 := 0;
    var libcSo6IsNew: bool := false;

    // ---- .dynstr: \0 + distinct lib names + symbol names ----
    con DYNSTR_MAX: int64 := 65536;
    var dynstr: int64 := alloc(DYNSTR_MAX);
    var dsLen: int64 := 0;
    poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
    var uniqLibOff: int64 := alloc((nExt + 1) * 8);
    var uniqLibStr: int64 := alloc((nExt + 1) * 8);
    var uniqCount: int64 := 0;
    var symStr: int64 := alloc((nExt + 1) * 8);

    var ei: int64 := 0;
    while ei < nExt {
      var eb: int64 := self.armExternBuf + ei * 32;
      var libOff: int64 := peek64(eb + CG_EXTERN_OFF_LIBPTR);
      var libLen: int64 := peek64(eb + CG_EXTERN_OFF_LIBLEN);
      var u: int64 := 0;
      var found: int64 := -1;
      while u < uniqCount {
        var pl: int64 := peek64(uniqLibOff + u * 8);
        var sameLib: int64 := 1;
        var k: int64 := 0;
        while k <= libLen {
          if sameLib != 0 { if peek8(strBuf + pl + k) != peek8(strBuf + libOff + k) { sameLib := 0; } }
          k += 1;
        }
        if sameLib != 0 { found := u; u := uniqCount; }
        u += 1;
      }
      if found < 0 {
        var off: int64 := dsLen;
        if dsLen + libLen + 1 > DYNSTR_MAX {
          EPrintStr("lyxc: .dynstr overflow: too many external symbols\n"c);
          return;
        }
        memcpy(dynstr + dsLen, strBuf + libOff, libLen); dsLen := dsLen + libLen;
        poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
        poke64(uniqLibOff + uniqCount * 8, libOff);
        poke64(uniqLibStr + uniqCount * 8, off);
        uniqCount += 1;
      }
      ei += 1;
    }
    ei := 0;
    while ei < nExt {
      var eb2: int64 := self.armExternBuf + ei * 32;
      var nmOff: int64 := peek64(eb2);
      var nmLen: int64 := peek64(eb2 + CG_EXTERN_OFF_NAMELEN);
      var soff: int64 := dsLen;
      if dsLen + nmLen + 1 > DYNSTR_MAX {
        EPrintStr("lyxc: .dynstr overflow: too many external symbols\n"c);
        return;
      }
      memcpy(dynstr + dsLen, strBuf + nmOff, nmLen); dsLen := dsLen + nmLen;
      poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
      poke64(symStr + ei * 8, soff);
      ei += 1;
    }

    // WP-A5: inject libc.so.6 DT_NEEDED and __libc_start_main symbol into .dynstr
    if self.arm64LibcStartMainUsed {
      var libcSo6Str: pchar := "libc.so.6"c;
      var libcSo6Len: int64 := 9;
      var libcFound: bool := false;
      var lu: int64 := 0;
      while lu < uniqCount {
        var dynstrLibOff: int64 := peek64(uniqLibStr + lu * 8);
        var km: int64 := 0;
        var matchL: bool := true;
        while km <= libcSo6Len {
          if matchL { if peek8(dynstr + dynstrLibOff + km) != peek8(libcSo6Str as int64 + km) { matchL := false; } }
          km += 1;
        }
        if matchL { libcFound := true; lu := uniqCount; }
        lu += 1;
      }
      if !libcFound {
        if dsLen + libcSo6Len + 1 > DYNSTR_MAX {
          EPrintStr("lyxc: .dynstr overflow: libc.so.6 entry\n"c);
          return;
        }
        libcSo6IsNew := true;
        libcSo6DynstrOff := dsLen;
        memcpy(dynstr + dsLen, libcSo6Str as int64, libcSo6Len);
        dsLen += libcSo6Len;
        poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
      }
      var lsmStr: pchar := "__libc_start_main"c;
      var lsmLen: int64 := 17;
      if dsLen + lsmLen + 1 > DYNSTR_MAX {
        EPrintStr("lyxc: .dynstr overflow: __libc_start_main entry\n"c);
        return;
      }
      libcStartMainSymOff := dsLen;
      memcpy(dynstr + dsLen, lsmStr as int64, lsmLen);
      dsLen += lsmLen;
      poke8(dynstr + dsLen, 0); dsLen := dsLen + 1;
    }

    var dynstrSize: int64 := dsLen;

    // ---- section offsets (8-aligned) ----
    var dynstrOff: int64 := ((codeFileOff + size + 7) >> 3) << 3;
    var dynsymOff: int64 := ((dynstrOff + dynstrSize + 7) >> 3) << 3;
    var lsmExtra: int64 := 0;
    if self.arm64LibcStartMainUsed { lsmExtra := 1; }
    var libcNeededExtra: int64 := 0;
    if libcSo6IsNew { libcNeededExtra := 1; }
    var dynsymSize: int64 := (nExt + lsmExtra + 1) * 24;
    var hashOff: int64 := dynsymOff + dynsymSize;
    var nchain: int64 := nExt + lsmExtra + 1;
    var hashSize: int64 := (3 + nchain) * 4;
    var relaOff: int64 := ((hashOff + hashSize + 7) >> 3) << 3;
    var relaSize: int64 := (self.relocCount + lsmExtra) * 24;
    var dynOff: int64 := relaOff + relaSize;
    var dynCount: int64 := uniqCount + libcNeededExtra + 11;
    var dynSize: int64 := dynCount * 16;
    var fileSize: int64 := dynOff + dynSize;

    var buf: int64 := alloc(fileSize);

    // ELF header
    poke8(buf, 0x7F); poke8(buf + 1, 69); poke8(buf + 2, 76); poke8(buf + 3, 70);
    poke8(buf + 4, 2); poke8(buf + 5, 1); poke8(buf + 6, 1); poke8(buf + 7, 0);
    poke16(buf + 16, 2);             // ET_EXEC
    poke16(buf + 18, 183);           // EM_AARCH64
    poke32(buf + 20, 1);
    poke64(buf + ELF64_EHDR_OFF_ENTRY, 0x401000);
    poke64(buf + ELF64_EHDR_OFF_PHOFF, 64);
    poke64(buf + ELF64_EHDR_OFF_SHOFF, 0);
    poke32(buf + 48, 0);
    poke16(buf + 52, 64);
    poke16(buf + 54, 56);
    poke16(buf + 56, 3);             // e_phnum
    poke16(buf + 58, 0); poke16(buf + 60, 0); poke16(buf + 62, 0);

    // program headers
    var ph: int64 := buf + 64;
    poke32(ph, 1); poke32(ph + 4, 7);                                   // PT_LOAD, RWX
    poke64(ph + ELF64_PHDR_OFF_OFFSET, 0); poke64(ph + ELF64_PHDR_OFF_VADDR, baseVA); poke64(ph + ELF64_PHDR_OFF_PADDR, baseVA);
    poke64(ph + ELF64_PHDR_OFF_FILESZ, fileSize); poke64(ph + ELF64_PHDR_OFF_MEMSZ, fileSize); poke64(ph + ELF64_PHDR_OFF_ALIGN, 0x10000);
    var ph2: int64 := buf + 120;
    poke32(ph2, 3); poke32(ph2 + 4, 4);                                 // PT_INTERP, R
    poke64(ph2 + ELF64_PHDR_OFF_OFFSET, interpOff); poke64(ph2 + ELF64_PHDR_OFF_VADDR, baseVA + interpOff); poke64(ph2 + ELF64_PHDR_OFF_PADDR, baseVA + interpOff);
    poke64(ph2 + ELF64_PHDR_OFF_FILESZ, interpLen); poke64(ph2 + ELF64_PHDR_OFF_MEMSZ, interpLen); poke64(ph2 + ELF64_PHDR_OFF_ALIGN, 1);
    var ph3: int64 := buf + 176;
    poke32(ph3, 2); poke32(ph3 + 4, 6);                                 // PT_DYNAMIC, RW
    poke64(ph3 + ELF64_PHDR_OFF_OFFSET, dynOff); poke64(ph3 + ELF64_PHDR_OFF_VADDR, baseVA + dynOff); poke64(ph3 + ELF64_PHDR_OFF_PADDR, baseVA + dynOff);
    poke64(ph3 + ELF64_PHDR_OFF_FILESZ, dynSize); poke64(ph3 + ELF64_PHDR_OFF_MEMSZ, dynSize); poke64(ph3 + ELF64_PHDR_OFF_ALIGN, 8);

    // .interp
    var ii: int64 := 0;
    memcpy(buf + interpOff, interpStr as int64, interpLen);

    // code (inline GOT slots stay 0; the loader fills them via GLOB_DAT)
    var ci: int64 := 0;
    memcpy(buf + codeFileOff, code, size);

    // .dynstr
    var si: int64 := 0;
    memcpy(buf + dynstrOff, dynstr, dynstrSize);

    // .dynsym — [0] null, [i+1] UNDEF GLOBAL FUNC
    ei := 0;
    while ei < nExt {
      var sy: int64 := buf + dynsymOff + (ei + 1) * 24;
      poke32(sy, peek64(symStr + ei * 8));   // st_name
      poke8(sy + 4, 0x12);                    // STB_GLOBAL|STT_FUNC
      poke8(sy + 5, 0);
      poke16(sy + 6, 0);                       // SHN_UNDEF
      ei += 1;
    }
    // WP-A5: __libc_start_main at dynsym index nExt+1
    if self.arm64LibcStartMainUsed {
      var lsmSy: int64 := buf + dynsymOff + (nExt + 1) * 24;
      poke32(lsmSy, libcStartMainSymOff);  // st_name
      poke8(lsmSy + 4, 0x12);              // STB_GLOBAL|STT_FUNC
      poke8(lsmSy + 5, 0);
      poke16(lsmSy + 6, 0);                // SHN_UNDEF
    }

    // .hash — minimal SysV (nbucket=1, empty)
    poke32(buf + hashOff, 1);
    poke32(buf + hashOff + 4, nchain);

    // .rela.dyn — GLOB_DAT relocs harvested from the emitter; r_offset = slot VA
    var ri: int64 := 0;
    while ri < self.relocCount {
      var src: int64 := self.relocBuf + ri * 24;
      var ra: int64 := buf + relaOff + ri * 24;
      poke64(ra, 0x401000 + self.codeStubOff + peek64(src));   // r_offset (slot VA)
      poke64(ra + 8, peek64(src + ELF64_RELA_OFF_INFO));                          // r_info (sym<<32|GLOB_DAT)
      poke64(ra + 16, peek64(src + ELF64_RELA_OFF_ADDEND));                        // r_addend
      ri += 1;
    }
    // WP-A5: RELA for __libc_start_main GOT slot (stub+48 = VA 0x401030)
    if self.arm64LibcStartMainUsed {
      var lsmRa: int64 := buf + relaOff + self.relocCount * 24;
      var lsmSymIdx: int64 := nExt + 1;
      var lsmRInfo: int64 := lsmSymIdx << 32;
      lsmRInfo := lsmRInfo | 0x401;         // R_AARCH64_GLOB_DAT
      poke64(lsmRa,      0x401030);          // r_offset: GOT slot at stub offset 48
      poke64(lsmRa + 8,  lsmRInfo);          // r_info
      poke64(lsmRa + 16, 0);                 // r_addend = 0
    }

    // .dynamic
    var dp: int64 := buf + dynOff;
    var u2: int64 := 0;
    while u2 < uniqCount {
      poke64(dp, 1); poke64(dp + ELF64_DYN_OFF_VAL, peek64(uniqLibStr + u2 * 8)); dp := dp + 16;  // DT_NEEDED
      u2 += 1;
    }
    // WP-A5: DT_NEEDED for libc.so.6 if not already in user externs
    if libcSo6IsNew {
      poke64(dp, 1); poke64(dp + ELF64_DYN_OFF_VAL, libcSo6DynstrOff); dp := dp + 16;  // DT_NEEDED libc.so.6
    }
    poke64(dp, 4);  poke64(dp + ELF64_DYN_OFF_VAL, baseVA + hashOff);   dp := dp + 16;   // DT_HASH
    poke64(dp, 5);  poke64(dp + ELF64_DYN_OFF_VAL, baseVA + dynstrOff); dp := dp + 16;   // DT_STRTAB
    poke64(dp, 6);  poke64(dp + ELF64_DYN_OFF_VAL, baseVA + dynsymOff); dp := dp + 16;   // DT_SYMTAB
    poke64(dp, 10); poke64(dp + ELF64_DYN_OFF_VAL, dynstrSize);         dp := dp + 16;   // DT_STRSZ
    poke64(dp, 11); poke64(dp + ELF64_DYN_OFF_VAL, 24);                 dp := dp + 16;   // DT_SYMENT
    poke64(dp, 7);  poke64(dp + ELF64_DYN_OFF_VAL, baseVA + relaOff);   dp := dp + 16;   // DT_RELA
    poke64(dp, 8);  poke64(dp + ELF64_DYN_OFF_VAL, relaSize);           dp := dp + 16;   // DT_RELASZ
    poke64(dp, 9);  poke64(dp + ELF64_DYN_OFF_VAL, 24);                 dp := dp + 16;   // DT_RELAENT
    poke64(dp, 30); poke64(dp + ELF64_DYN_OFF_VAL, 8);                  dp := dp + 16;   // DT_FLAGS = DF_BIND_NOW
    poke64(dp, 0);  poke64(dp + ELF64_DYN_OFF_VAL, 0);                                    // DT_NULL

    var result: int64 := FileWriteAll(path, buf as pchar, fileSize) as int64;
    free(buf, fileSize);
    chmod(path, 493);
    return result != 0;
  }

  fn writeELF(path: pchar, code: int64, size: int64): bool {
    // FFI programs (extern fn ... link) need a dynamically-linked ET_EXEC.
    // Programs without externs keep the static layout below.
    if self.armExternCount > 0 {
      return self.writeELFExecDynamic(path, code, size);
    }

    // Create minimal ELF matching S1 layout:
    // - Single PT_LOAD at offset 0x1000 (vaddr 0x401000)
    // - Entry point at 0x401000
    // - Headers at offset 64 (must be covered by LOAD)

    var codeFileOffset: int64 := 4096;  // 0x1000
    // ARM64-FIX: globals-.data nach Code (file-offset==vaddr im static PT_LOAD).
    // gIdx-Slots in den literal-pools (emitLoadGlobal/StoreGlobal) werden unten auf die
    // absolute VA gebacken. Nur arm64 (x86-IR-Globals: separater Pfad).
    var gblIsArm: bool := (self.target == LYX_TC_ARM64) || (self.target == LYX_TC_ANDROID_ARM64);
    var gblCount: int64 := 0;
    if gblIsArm && self.irModulePtr != 0 {
      gblCount := peek64(self.irModulePtr + IR_MOD_OFF_GLOBALLEN);
    }
    var gblFileOff: int64 := ((codeFileOffset + size + 7) / 8) * 8;
    var gblSize:    int64 := gblCount * 8;
    var elfSize: int64 := gblFileOff + gblSize;

    var fd: int64 := open(path, 577, 493);
    if fd == -1 { return false; }
    close(fd);
    
    var elfBuf: int64 := alloc(elfSize);
    if elfBuf == -1 { return false; }
    
    // Zero buffer
    var z: int64 := 0;
    while (z < elfSize) {
      poke8(elfBuf + z, 0);
      z += 1;
    }
    
    // Copy code to offset 4096
    var i: int64 := 0;
    memcpy(elfBuf + codeFileOffset, code, size);
    
    // ELF header (64 bytes)
    var off: int64 := 0;
    poke8(elfBuf + off, 127); off := off + 1;  // 0x7F
    poke8(elfBuf + off, 69); off := off + 1;  // 'E'
    poke8(elfBuf + off, 76); off := off + 1;  // 'L'
    poke8(elfBuf + off, 70); off := off + 1;  // 'F'
    poke8(elfBuf + off, 2); off := off + 1;   // 64-bit
    poke8(elfBuf + off, 1); off := off + 1;   // little endian
    poke8(elfBuf + off, 1); off := off + 1;   // ELF version
    poke8(elfBuf + off, 0); off := off + 1;   // OS ABI
    poke8(elfBuf + off, 0); off := off + 1;
    poke8(elfBuf + off, 0); off := off + 1;
    poke8(elfBuf + off, 0); off := off + 1;
    poke8(elfBuf + off, 0); off := off + 1;
    poke8(elfBuf + off, 0); off := off + 1;
    poke8(elfBuf + off, 0); off := off + 1;
    poke8(elfBuf + off, 0); off := off + 1;
    poke8(elfBuf + off, 0); off := off + 1;
    
    // ARM64-FIX: ET_EXEC mit fester Basis 0x401000 (wie x86), NICHT ET_DYN/PIE.
    // Grund: globals werden über literal-pool-Slots mit ABSOLUTER VA adressiert (kein
    // Reloc, da static/kein Loader). Bei ET_DYN lädt der Kernel an variabler Basis →
    // absolute VA falsch → SIGSEGV. Code ist PC-relativ (BL/ADR), läuft auch bei ET_EXEC.
    var etype:  int64 := 2;        // ET_EXEC
    var loadVA: int64 := 0x401000;
    // e_type (offset 16)
    poke16(elfBuf + 16, etype);
    // e_machine (offset 18): x86-64=62, AArch64=183
    var emach: int64 := 62;
    if self.target == LYX_TC_ARM64 { emach := 183; }
    if self.target == LYX_TC_ANDROID_ARM64 { emach := 183; }
    poke16(elfBuf + 18, emach);
    // e_version (offset 20): EV_CURRENT = 1
    poke32(elfBuf + 20, 1);
    // e_entry (offset 24)
    poke64(elfBuf + ELF64_EHDR_OFF_ENTRY, loadVA);
    // e_phoff (offset 32): program header offset = 64
    poke64(elfBuf + ELF64_EHDR_OFF_PHOFF, 64);
    // e_shoff (offset 40): no section headers = 0
    poke64(elfBuf + ELF64_EHDR_OFF_SHOFF, 0);
    // e_flags (offset 48): 0
    poke32(elfBuf + 48, 0);
    // e_ehsize (offset 52): 64
    poke16(elfBuf + 52, 64);
    // e_phentsize (offset 54): 56
    poke16(elfBuf + 54, 56);
    // e_phnum (offset 56): 1 program header
    poke16(elfBuf + 56, 1);
    // e_shentsize (offset 58): 0
    poke16(elfBuf + 58, 0);
    // e_shnum (offset 60): 0
    poke16(elfBuf + 60, 0);
    // e_shstrndx (offset 62): 0
    poke16(elfBuf + 62, 0);
    
    // Single PT_LOAD segment (at offset 64)
    var ph: int64 := 64;
    // p_type: PT_LOAD = 1
    poke32(elfBuf + ph, 1); ph := ph + 4;
    // p_flags: rwx = 7
    poke32(elfBuf + ph, 7); ph := ph + 4;
    // p_offset: file offset = 0x1000
    poke64(elfBuf + ph, codeFileOffset); ph := ph + 8;
    // p_vaddr / p_paddr: 0x1000 for ARM64 PIE, 0x401000 for x86-64
    poke64(elfBuf + ph, loadVA); ph := ph + 8;
    poke64(elfBuf + ph, loadVA); ph := ph + 8;
    // p_filesz/p_memsz: deckt Code + globals-.data ab
    var loadSpan: int64 := elfSize - codeFileOffset;
    poke64(elfBuf + ph, loadSpan); ph := ph + 8;
    poke64(elfBuf + ph, loadSpan); ph := ph + 8;
    // p_align: alignment = 0x1000
    poke64(elfBuf + ph, 4096);

    // ARM64-FIX: globals-.data init + literal-pool-Slots auf absolute VA backen.
    if gblIsArm && gblCount > 0 {
      var gblVABase: int64 := loadVA + (gblFileOff - codeFileOffset);  // file-off→vaddr
      // Init-Werte aus dem IR-globalBuffer
      var gbuf: int64 := peek64(self.irModulePtr + IR_MOD_OFF_GLOBALBUF);
      var dgi: int64 := 0;
      while dgi < gblCount {
        poke64(elfBuf + gblFileOff + dgi * 8, peek64(gbuf + dgi * 8));
        dgi += 1;
      }
      // Slots backen: slot liegt im finalen code bei (codeStubOff + slotCodeOff)
      var gri: int64 := 0;
      while gri < self.globalRelocCount {
        var grec: int64 := self.globalRelocBuf + gri * GRELOCBUF_SZ;
        var slotCodeOff: int64 := peek64(grec + 0);
        var gIdx:        int64 := peek64(grec + GRELOCBUF_OFF_GIDX);
        var slotFileOff: int64 := codeFileOffset + self.codeStubOff + slotCodeOff;
        poke64(elfBuf + slotFileOff, gblVABase + gIdx * 8);
        gri += 1;
      }
    }

    var result: int64 := FileWriteAll(path, elfBuf as pchar, elfSize) as int64;
    free(elfBuf, elfSize);
    chmod(path, 493);

    return result != 0;
  }

  // WP-AND-02: ELF Shared Library writer (ET_DYN).
  // Produces a .so with .dynamic, .dynsym, .dynstr, .hash. WP-AND-02 Phase B
  // adds real symbol exports collected by buildExportList; .dynsym entry 0
  // remains an UNDEF sentinel, and entries 1..N are STB_GLOBAL|STT_FUNC.
  // R_AARCH64_* relocations are still deferred to Phase C.
  fn writeELFSharedLib(path: pchar, code: int64, size: int64): bool {
    // Derive SONAME basename from output path (after the last '/').
    var pathLen: int64 := StrLen(path);
    var baseStart: int64 := 0;
    var k: int64 := 0;
    while k < pathLen {
      if peek8(path + k) == 47 { baseStart := k + 1; }  // '/'
      k += 1;
    }
    var soNameLen: int64 := pathLen - baseStart;

    // ---- Export-table sizing (Phase B/B2) ----
    // Records: [namePtr:i64 (absolute), nameLen:i64, stValue:i64].
    var expCount: int64 := self.exportCount;
    var expBuf:   int64 := self.exportBuf;

    // Sum of all export name lengths (each followed by a NUL in .dynstr).
    var expNamesBytes: int64 := 0;
    var ei: int64 := 0;
    while ei < expCount {
      expNamesBytes := expNamesBytes + peek64(expBuf + ei * EXPBUF_SZ + EXPBUF_OFF_NAMELEN) + 1;
      ei += 1;
    }

    // ---- Dynamic relocation sizing (Phase C) ----
    // WP-AND-upstream-fix v5: also account for one R_AARCH64_RELATIVE per
    // global-load slot before any layout depends on relaSize.
    var globalCountEarly: int64 := 0;
    if self.irModulePtr != 0 {
      globalCountEarly := peek64(self.irModulePtr + IR_MOD_OFF_GLOBALLEN);
    }
    var extraGlobalRelocs: int64 := self.globalRelocCount;
    var relCount: int64 := self.relocCount + extraGlobalRelocs;
    var relBuf:   int64 := self.relocBuf;
    var hasRelocs: int64 := 0;
    if relCount > 0 { hasRelocs := 1; }

    // ---- File layout planning ----
    var ehSize:     int64 := 64;
    var phSize:     int64 := 56;
    var phNum:      int64 := 4;     // PT_LOAD R-X, PT_LOAD RW, PT_DYNAMIC, PT_NOTE
    // phNum bumped to 5 below if we emit .eh_frame_hdr (PT_GNU_EH_FRAME).
    var pageSize:   int64 := 4096;

    var codeOff:    int64 := pageSize;          // .text starts at 0x1000
    var codeEnd:    int64 := codeOff + size;

    var dataOff:    int64 := ((codeEnd + pageSize - 1) / pageSize) * pageSize;

    // WP-AND-03: .note.android.ident section sits at the very front of PT_LOAD #2
    // so it gets a stable address near the top of the data segment. Layout:
    //   namesz (4) | descsz (4) | type (4)  = 12 bytes header
    //   "Android\0"                          =  8 bytes name (4-aligned)
    //   apiLevel (4)                         =  4 bytes desc (4-aligned)
    // Total: 24 bytes; happens to be 8-aligned so .dynamic follows immediately.
    var noteOff:    int64 := dataOff;
    var noteSize:   int64 := 24;
    var dynOff:     int64 := noteOff + noteSize;

    // .dynamic entry count: 7 baseline + 3 if relocations present (DT_RELA,
    // DT_RELASZ, DT_RELAENT).
    var dynNum:     int64 := 7;
    if hasRelocs != 0 { dynNum := 10; }
    var dynSize:    int64 := dynNum * 16;
    var dynsymOff:  int64 := dynOff + dynSize;
    // 1 UNDEF entry + 1 entry per exported function.
    var dynsymSize: int64 := (1 + expCount) * 24;
    var dynstrOff:  int64 := dynsymOff + dynsymSize;
    // \0 + soname + \0 + (export-names + \0)*
    var dynstrSize: int64 := 1 + soNameLen + 1 + expNamesBytes;
    var hashOffRaw: int64 := dynstrOff + dynstrSize;
    var hashOff:    int64 := ((hashOffRaw + 7) / 8) * 8;
    // SYSV hash: 8-byte header + 4*nbucket + 4*nchain; we use a single bucket.
    var hashNbucket: int64 := 1;
    var hashNchain:  int64 := 1 + expCount;
    var hashSize:    int64 := 8 + 4 * hashNbucket + 4 * hashNchain;
    // .rela.dyn (Phase C): 24-byte Elf64_Rela records, 8-byte aligned.
    var relaOffRaw: int64 := hashOff + hashSize;
    var relaOff:    int64 := ((relaOffRaw + 7) / 8) * 8;
    var relaSize:   int64 := relCount * 24;
    var afterReloc: int64 := relaOff + relaSize;
    if hasRelocs == 0 { afterReloc := hashOff + hashSize; }

    // WP-AND-03 DWARF CFI: .eh_frame_hdr (12 byte header + 8 byte table entry
    // per function) and .eh_frame (24-byte CIE + 28-byte FDE per function +
    // 4-byte terminator). PT_GNU_EH_FRAME program header references the hdr,
    // so the runtime unwinder can find FDEs via binary search.
    var funcN:        int64 := self.codeFuncTotal;
    var hasEhFrame:   int64 := 0;
    if funcN > 0 { hasEhFrame := 1; }

    var ehFrameHdrOff:  int64 := ((afterReloc + 3) / 4) * 4;
    var ehFrameHdrSize: int64 := 12 + 8 * funcN;
    var ehFrameOffRaw:  int64 := ehFrameHdrOff + ehFrameHdrSize;
    var ehFrameOff:     int64 := ((ehFrameOffRaw + 7) / 8) * 8;
    var ehFrameSize:    int64 := 24 + 28 * funcN + 4;
    var afterEh:        int64 := ehFrameOff + ehFrameSize;
    if hasEhFrame == 0 { afterEh := afterReloc; }
    if hasEhFrame != 0 { phNum := 5; }

    // WP-AND-upstream-fix v5: .data section for globals (after .eh_frame).
    // Sized to globalLen*8 (read from the IR module). The slot-patching
    // pass below rewrites every globalRelocBuf entry to point at this
    // region and emits the matching R_AARCH64_RELATIVE entries (those
    // slots were already accounted for via extraGlobalRelocs above, so
    // relaSize and the layout above are correctly sized).
    var globalCount: int64 := globalCountEarly;
    var hasGlobals:  int64 := 0;
    if globalCount > 0 { hasGlobals := 1; }
    var globalsOff:  int64 := ((afterEh + 7) / 8) * 8;
    var globalsSize: int64 := globalCount * 8;
    var fileSize:    int64 := globalsOff + globalsSize;
    if hasGlobals == 0 { fileSize := afterEh; }

    // ---- Allocate + zero buffer ----
    var fd: int64 := open(path, 577, 493);
    if fd == -1 { return false; }
    close(fd);

    var buf: int64 := alloc(fileSize);
    if buf == -1 { return false; }
    var z: int64 := 0;
    while z < fileSize { poke8(buf + z, 0); z := z + 1; }

    // ---- Copy code into .text ----
    var i: int64 := 0;
    memcpy(buf + codeOff, code, size);

    // ---- ELF header ----
    poke8(buf + 0, 127);                            // 0x7F
    poke8(buf + 1, 69); poke8(buf + 2, 76); poke8(buf + 3, 70);  // 'E' 'L' 'F'
    poke8(buf + 4, 2);                              // ELFCLASS64
    poke8(buf + 5, 1);                              // ELFDATA2LSB
    poke8(buf + 6, 1);                              // EV_CURRENT
    poke8(buf + 7, 0);                              // ELFOSABI_SYSV
    // e_ident[8..15] already zero

    poke16(buf + 16, 3);                            // e_type = ET_DYN
    var emach: int64 := 62;                         // EM_X86_64
    if self.target == LYX_TC_ARM64 { emach := 183; }
    if self.target == LYX_TC_ANDROID_ARM64 { emach := 183; }
    poke16(buf + 18, emach);                        // e_machine
    poke32(buf + 20, 1);                            // e_version
    poke64(buf + ELF64_EHDR_OFF_ENTRY, 0);
    poke64(buf + ELF64_EHDR_OFF_PHOFF, 64);
    poke64(buf + ELF64_EHDR_OFF_SHOFF, 0);
    poke32(buf + 48, 0);                            // e_flags
    poke16(buf + 52, 64);                           // e_ehsize
    poke16(buf + 54, 56);                           // e_phentsize
    poke16(buf + 56, phNum);                        // e_phnum (4 or 5: +PT_NOTE +PT_GNU_EH_FRAME)
    poke16(buf + 58, 0);                            // e_shentsize
    poke16(buf + 60, 0);                            // e_shnum
    poke16(buf + 62, 0);                            // e_shstrndx

    // ---- Program headers (3 × 56 bytes) ----
    var ph: int64 := 64;
    // PT_LOAD #1: R-X, covers ELF header + program headers + .text
    poke32(buf + ph,  1);          ph := ph + 4;    // p_type = PT_LOAD
    poke32(buf + ph,  5);          ph := ph + 4;    // p_flags = PF_R|PF_X
    poke64(buf + ph,  0);          ph := ph + 8;    // p_offset
    poke64(buf + ph,  0);          ph := ph + 8;    // p_vaddr
    poke64(buf + ph,  0);          ph := ph + 8;    // p_paddr
    poke64(buf + ph,  codeEnd);    ph := ph + 8;    // p_filesz
    poke64(buf + ph,  codeEnd);    ph := ph + 8;    // p_memsz
    poke64(buf + ph,  pageSize);   ph := ph + 8;    // p_align

    // PT_LOAD #2: RW, covers .dynamic + .dynsym + .dynstr + .hash
    var seg2Size: int64 := fileSize - dataOff;
    poke32(buf + ph,  1);          ph := ph + 4;    // p_type = PT_LOAD
    poke32(buf + ph,  6);          ph := ph + 4;    // p_flags = PF_R|PF_W
    poke64(buf + ph,  dataOff);    ph := ph + 8;    // p_offset
    poke64(buf + ph,  dataOff);    ph := ph + 8;    // p_vaddr
    poke64(buf + ph,  dataOff);    ph := ph + 8;    // p_paddr
    poke64(buf + ph,  seg2Size);   ph := ph + 8;    // p_filesz
    poke64(buf + ph,  seg2Size);   ph := ph + 8;    // p_memsz
    poke64(buf + ph,  pageSize);   ph := ph + 8;    // p_align

    // PT_DYNAMIC: points to .dynamic section
    poke32(buf + ph,  2);          ph := ph + 4;    // p_type = PT_DYNAMIC
    poke32(buf + ph,  6);          ph := ph + 4;    // p_flags = PF_R|PF_W
    poke64(buf + ph,  dynOff);     ph := ph + 8;    // p_offset
    poke64(buf + ph,  dynOff);     ph := ph + 8;    // p_vaddr
    poke64(buf + ph,  dynOff);     ph := ph + 8;    // p_paddr
    poke64(buf + ph,  dynSize);    ph := ph + 8;    // p_filesz
    poke64(buf + ph,  dynSize);    ph := ph + 8;    // p_memsz
    poke64(buf + ph,  8);          ph := ph + 8;    // p_align

    // WP-AND-03 PT_NOTE: covers the .note.android.ident section.
    poke32(buf + ph,  4);          ph := ph + 4;    // p_type = PT_NOTE
    poke32(buf + ph,  4);          ph := ph + 4;    // p_flags = PF_R
    poke64(buf + ph,  noteOff);    ph := ph + 8;    // p_offset
    poke64(buf + ph,  noteOff);    ph := ph + 8;    // p_vaddr
    poke64(buf + ph,  noteOff);    ph := ph + 8;    // p_paddr
    poke64(buf + ph,  noteSize);   ph := ph + 8;    // p_filesz
    poke64(buf + ph,  noteSize);   ph := ph + 8;    // p_memsz
    poke64(buf + ph,  4);          ph := ph + 8;    // p_align

    // WP-AND-03 PT_GNU_EH_FRAME: points to .eh_frame_hdr for fast unwinding.
    if hasEhFrame != 0 {
      poke32(buf + ph,  0x6474E550); ph := ph + 4;  // p_type = PT_GNU_EH_FRAME
      poke32(buf + ph,  4);          ph := ph + 4;  // p_flags = PF_R
      poke64(buf + ph,  ehFrameHdrOff);  ph := ph + 8;  // p_offset
      poke64(buf + ph,  ehFrameHdrOff);  ph := ph + 8;  // p_vaddr
      poke64(buf + ph,  ehFrameHdrOff);  ph := ph + 8;  // p_paddr
      poke64(buf + ph,  ehFrameHdrSize); ph := ph + 8;  // p_filesz
      poke64(buf + ph,  ehFrameHdrSize); ph := ph + 8;  // p_memsz
      poke64(buf + ph,  4);                              // p_align
    }

    // ---- .note.android.ident ----
    // ELF note header (12 bytes) + name (8) + desc (4) = 24 bytes total.
    poke32(buf + noteOff +  0, 8);                  // namesz: strlen("Android")+1
    poke32(buf + noteOff +  4, 4);                  // descsz: one uint32
    poke32(buf + noteOff +  8, 1);                  // type = NT_VERSION (Android-conventional)
    var androidName: pchar := "Android";
    memcpy(buf + noteOff + 12, androidName as int64, 8);
    poke32(buf + noteOff + 20, self.androidApiLevel);

    // ---- .dynamic ----
    // Tag values via Elf64_Dyn (d_tag: i64, d_un: u64).
    var d: int64 := dynOff;
    // DT_HASH = 4
    poke64(buf + d, 4);         poke64(buf + d + ELF64_DYN_OFF_VAL, hashOff);    d := d + 16;
    // DT_STRTAB = 5
    poke64(buf + d, 5);         poke64(buf + d + ELF64_DYN_OFF_VAL, dynstrOff);  d := d + 16;
    // DT_SYMTAB = 6
    poke64(buf + d, 6);         poke64(buf + d + ELF64_DYN_OFF_VAL, dynsymOff);  d := d + 16;
    // DT_STRSZ = 10
    poke64(buf + d, 10);        poke64(buf + d + ELF64_DYN_OFF_VAL, dynstrSize); d := d + 16;
    // DT_SYMENT = 11
    poke64(buf + d, 11);        poke64(buf + d + ELF64_DYN_OFF_VAL, 24);         d := d + 16;
    // DT_SONAME = 14 (string at offset 1 into .dynstr)
    poke64(buf + d, 14);        poke64(buf + d + ELF64_DYN_OFF_VAL, 1);          d := d + 16;
    // Phase C: DT_RELA / DT_RELASZ / DT_RELAENT if any relocations present.
    if hasRelocs != 0 {
      poke64(buf + d, 7);       poke64(buf + d + ELF64_DYN_OFF_VAL, relaOff);    d := d + 16;  // DT_RELA
      poke64(buf + d, 8);       poke64(buf + d + ELF64_DYN_OFF_VAL, relaSize);   d := d + 16;  // DT_RELASZ
      poke64(buf + d, 9);       poke64(buf + d + ELF64_DYN_OFF_VAL, 24);         d := d + 16;  // DT_RELAENT
    }
    // DT_NULL = 0 (terminator)
    poke64(buf + d, 0);         poke64(buf + d + ELF64_DYN_OFF_VAL, 0);

    // ---- .dynstr ----
    // Byte 0: NUL (already zero)
    // Bytes 1..1+soNameLen: SONAME basename
    var si: int64 := 0;
    memcpy(buf + dynstrOff + 1, path + baseStart, soNameLen);
    // Trailing NUL after soname is already zero from the initial fill.

    // Append exported function names; record each one's offset into .dynstr
    // so the matching .dynsym entry can reference it via st_name.
    var nextStr: int64 := 1 + soNameLen + 1;       // .dynstr cursor (relative)
    var ej: int64 := 0;
    while ej < expCount {
      var rec: int64 := expBuf + ej * 24;
      var nPtr: int64 := peek64(rec + 0);          // absolute name pointer
      var nLen: int64 := peek64(rec + EXPBUF_OFF_NAMELEN);
      var nameStart: int64 := nextStr;             // record where this name lands
      var ci: int64 := 0;
      memcpy(buf + dynstrOff + nextStr, nPtr, nLen);
      nextStr := nextStr + nLen + 1;               // +1 for NUL
      // Stash the dynstr-relative offset back into the record's namePtr slot
      // so the .dynsym writer below can reuse it without recomputing.
      poke64(rec + 0, nameStart);
      ej += 1;
    }

    // ---- .dynsym ----
    // Entry 0 is UNDEF (all zeros from the initial fill).
    // Entries 1..1+expCount: STB_GLOBAL | STT_FUNC, st_shndx = 1 (placeholder).
    var ek: int64 := 0;
    while ek < expCount {
      var rec2:  int64 := expBuf + ek * 24;
      var dnOff: int64 := peek64(rec2 + 0);        // offset into .dynstr (set above)
      var addr:  int64 := peek64(rec2 + EXPBUF_OFF_ADDR);       // st_value
      var symOff: int64 := dynsymOff + (1 + ek) * 24;
      poke32(buf + symOff + 0,  dnOff);            // st_name
      poke8(buf + symOff + 4,   0x12);             // st_info = (STB_GLOBAL<<4)|STT_FUNC
      poke8(buf + symOff + 5,   0);                // st_other
      poke16(buf + symOff + 6,  1);                // st_shndx (placeholder, any non-zero)
      poke64(buf + symOff + ELF64_SYM_OFF_VALUE,  addr);             // st_value
      poke64(buf + symOff + ELF64_SYM_OFF_SIZE, 0);                // st_size (unknown)
      ek += 1;
    }

    // ---- .hash (DT_HASH classic SYSV format) ----
    // Single bucket; all symbols chained linearly from there. With nbucket=1
    // every dlsym is O(n) but for small Phase-B exports that's acceptable.
    poke32(buf + hashOff + 0, hashNbucket);
    poke32(buf + hashOff + 4, hashNchain);
    // bucket[0]: index of first non-UNDEF symbol, or 0 if no exports.
    if expCount > 0 { poke32(buf + hashOff + 8, 1); }
    else            { poke32(buf + hashOff + 8, 0); }
    // chain[]: chain[0] = 0 (UNDEF terminator).
    // chain[i] for i in 1..expCount-1 → i+1; chain[expCount] → 0.
    poke32(buf + hashOff + 12, 0);                 // chain[0]
    var ci2: int64 := 1;
    while ci2 < expCount {
      poke32(buf + hashOff + 12 + ci2 * 4, ci2 + 1);
      ci2 += 1;
    }
    if expCount > 0 {
      poke32(buf + hashOff + 12 + expCount * 4, 0); // terminator
    }

    // ---- .rela.dyn (Phase C) ----
    // Each emit_arm64 record holds (codeBuf-relative offset, info, addend).
    // For r_offset we add codeOff because PT_LOAD #1 maps file offsets 1:1
    // onto vaddrs starting at vaddr 0 (so the slot's vaddr == its file offset).
    if hasRelocs != 0 {
      var ri: int64 := 0;
      // Original relocs from emit_arm64.relocBuf.
      while ri < self.relocCount {
        var src: int64 := relBuf + ri * 24;
        var rOffCode: int64 := peek64(src +  0);
        var rInfo:    int64 := peek64(src +  8);
        var rAddend:  int64 := peek64(src + ELF64_RELA_OFF_ADDEND);
        var dst: int64 := relaOff + ri * 24;
        poke64(buf + dst +  0, codeOff + rOffCode);
        poke64(buf + dst +  8, rInfo);
        poke64(buf + dst + ELF64_RELA_OFF_ADDEND, rAddend);
        ri += 1;
      }
      // WP-AND-upstream-fix v5: append per-global R_AARCH64_RELATIVE entries.
      // Each globalRelocBuf record holds (slotCodeOff, globalIdx). The slot
      // (a .quad inside the literal pool emitted by emitLoadGlobal) goes at
      // r_offset = codeOff + slotCodeOff, with r_addend pointing at the
      // global's .data home (globalsOff + globalIdx*8). We also write the
      // initial value directly into the slot in the code buffer so the
      // .so is self-consistent even without the runtime relocation pass.
      if hasGlobals != 0 {
        var gi: int64 := 0;
        while gi < self.globalRelocCount {
          var gsrc: int64 := self.globalRelocBuf + gi * GRELOCBUF_SZ;
          var slotCodeOff: int64 := peek64(gsrc + 0);
          var gIdx:        int64 := peek64(gsrc + GRELOCBUF_OFF_GIDX);
          var gAddend:     int64 := globalsOff + gIdx * 8;
          // Bake the resolved address into the literal-pool slot.
          poke64(buf + codeOff + slotCodeOff, gAddend);
          // Emit the matching R_AARCH64_RELATIVE entry.
          var gdst: int64 := relaOff + (self.relocCount + gi) * 24;
          poke64(buf + gdst +  0, codeOff + slotCodeOff);
          poke64(buf + gdst +  8, 1027);       // R_AARCH64_RELATIVE
          poke64(buf + gdst + ELF64_RELA_OFF_ADDEND, gAddend);
          gi += 1;
        }
      }
    }

    // ---- .data (WP-AND-upstream-fix v5) ----
    // Write each global's init value (8 bytes) at its slot in .data.
    // Sourced from the IR module's globalBuffer, which ir_lower populated
    // during the lowerModule pre-pass.
    if hasGlobals != 0 {
      var gbuf: int64 := peek64(self.irModulePtr + IR_MOD_OFF_GLOBALBUF);
      var dgi: int64 := 0;
      while dgi < globalCount {
        poke64(buf + globalsOff + dgi * 8, peek64(gbuf + dgi * 8));
        dgi += 1;
      }
    }

    // ---- .eh_frame (WP-AND-03) ----
    // Single CIE describing ARM64 conventions, followed by one FDE per function,
    // terminated by a zero-length record. Layout sizes are hard-coded; all
    // LEB128 values used here fit in single bytes so no general LEB128 encoder
    // is needed.
    if hasEhFrame != 0 {
      // ----- CIE @ ehFrameOff -----
      //   length        = 20  (body bytes, length field excluded)
      //   CIE_id        = 0
      //   version       = 1
      //   augmentation  = "zR\0"
      //   code_align    = 1
      //   data_align    = -8  (sleb128 single byte 0x78)
      //   ret_addr_reg  = 30  (LR for ARM64)
      //   aug_data_len  = 1
      //   aug_data      = 0x1B (DW_EH_PE_pcrel | DW_EH_PE_sdata4)
      //   initial CFI:    DW_CFA_def_cfa(31, 0)   -> at entry: CFA = sp + 0
      //   3 NOPs to 4-byte-align the total (length + body) to 24.
      poke32(buf + ehFrameOff +  0, 20);             // length
      poke32(buf + ehFrameOff +  4, 0);              // CIE_id
      poke8(buf + ehFrameOff +  8,  1);              // version
      poke8(buf + ehFrameOff +  9,  0x7A);           // 'z'
      poke8(buf + ehFrameOff + 10,  0x52);           // 'R'
      poke8(buf + ehFrameOff + 11,  0);              // \0
      poke8(buf + ehFrameOff + 12,  0x01);           // code_align
      poke8(buf + ehFrameOff + 13,  0x78);           // data_align = -8 (sleb128)
      poke8(buf + ehFrameOff + 14,  0x1E);           // ret_addr_reg = 30
      poke8(buf + ehFrameOff + 15,  0x01);           // aug_data_len
      poke8(buf + ehFrameOff + 16,  0x1B);           // FDE encoding
      poke8(buf + ehFrameOff + 17,  0x0C);           // DW_CFA_def_cfa
      poke8(buf + ehFrameOff + 18,  0x1F);           // reg 31 (sp)
      poke8(buf + ehFrameOff + 19,  0x00);           // offset 0
      // Bytes 20..23 are already zero (DW_CFA_nop) from the initial fill.

      // ----- FDEs @ ehFrameOff + 24, then every 28 bytes -----
      var fi: int64 := 0;
      while fi < funcN {
        var fdeRel: int64 := 24 + fi * 28;
        var fdeOff: int64 := ehFrameOff + fdeRel;

        // Function range: vaddr and size. PT_LOAD #1 maps vaddr=fileOffset.
        var fStart: int64 := peek64(self.codeFuncAddrs + fi * 8);   // offset in irCodeBuf
        var fEnd:   int64 := self.codeSize;
        if fi + 1 < funcN {
          fEnd := peek64(self.codeFuncAddrs + (fi + 1) * 8);
        }
        var fLen:   int64 := fEnd - fStart;
        var fVaddr: int64 := codeOff + fStart;          // codeStubOff is 0 in shared-lib mode

        // pc_begin field's vaddr (it lives at fdeOff + 8 in the file).
        var pcField: int64 := fdeOff + 8;
        var pcRel:   int64 := fVaddr - pcField;          // signed sdata4

        // CIE_pointer: offset from THIS FDE back to the CIE start.
        var ciePtr:  int64 := fdeRel;                    // CIE is at relative 0

        poke32(buf + fdeOff +  0, 24);                   // length (body bytes)
        poke32(buf + fdeOff +  4, ciePtr);               // CIE_pointer
        poke32(buf + fdeOff +  8, pcRel & 0xFFFFFFFF);   // pc_begin (sdata4)
        poke32(buf + fdeOff + 12, fLen);                 // pc_range

        poke8(buf + fdeOff + 16, 0);                     // aug_data_len = 0

        // DW_CFA_advance_loc(prologueLen): small form (0x40 | delta) for <=63 bytes.
        var prologueLen: int64 := peek64(self.codeFuncPrologueLen + fi * 8);
        poke8(buf + fdeOff + 17, 0x40 | (prologueLen & 0x3F));

        // DW_CFA_def_cfa(29, 16): CFA = x29 + 16.
        poke8(buf + fdeOff + 18, 0x0C);
        poke8(buf + fdeOff + 19, 0x1D);                  // reg 29 (fp)
        poke8(buf + fdeOff + 20, 0x10);                  // offset 16

        // DW_CFA_offset(29, 2): x29 saved at CFA + 2*(-8) = CFA - 16.
        poke8(buf + fdeOff + 21, 0x9D);                  // 0x80 | 29
        poke8(buf + fdeOff + 22, 0x02);

        // DW_CFA_offset(30, 1): x30 saved at CFA - 8.
        poke8(buf + fdeOff + 23, 0x9E);
        poke8(buf + fdeOff + 24, 0x01);

        // Bytes 25..27 are NOP padding (zero from initial fill).
        fi += 1;
      }

      // ----- Terminator (length = 0) -----
      // Already zero from initial fill; nothing more to do.

      // ----- .eh_frame_hdr -----
      //   version=1, eh_frame_ptr_enc=0x1B (PC-rel sdata4),
      //   fde_count_enc=0x03 (udata4), table_enc=0x3B (datarel sdata4)
      //   eh_frame_ptr: offset from this field to start of .eh_frame
      //   fde_count: number of FDEs
      //   table[]: (initial_loc, fde_addr) pairs, datarel to .eh_frame_hdr start
      poke8(buf + ehFrameHdrOff +  0, 1);
      poke8(buf + ehFrameHdrOff +  1, 0x1B);
      poke8(buf + ehFrameHdrOff +  2, 0x03);
      poke8(buf + ehFrameHdrOff +  3, 0x3B);
      var ehFrameRel: int64 := ehFrameOff - (ehFrameHdrOff + 4);
      poke32(buf + ehFrameHdrOff +  4, ehFrameRel & 0xFFFFFFFF);
      poke32(buf + ehFrameHdrOff +  8, funcN);
      // Binary search table: entries sorted by initial_location.
      // For our linear codegen, funcAddrs is already monotonically increasing.
      var hi: int64 := 0;
      while hi < funcN {
        var fStart2: int64 := peek64(self.codeFuncAddrs + hi * 8);
        var fVaddr2: int64 := codeOff + fStart2;
        var fdeAbs2: int64 := ehFrameOff + 24 + hi * 28;
        // datarel: offsets relative to ehFrameHdrOff (per encoding 0x3B).
        var initLoc: int64 := fVaddr2 - ehFrameHdrOff;
        var fdeRel2: int64 := fdeAbs2 - ehFrameHdrOff;
        poke32(buf + ehFrameHdrOff + 12 + hi * 8 + 0, initLoc & 0xFFFFFFFF);
        poke32(buf + ehFrameHdrOff + 12 + hi * 8 + 4, fdeRel2 & 0xFFFFFFFF);
        hi += 1;
      }
    }

    // ---- Write + cleanup ----
    var result: int64 := FileWriteAll(path, buf as pchar, fileSize) as int64;
    free(buf, fileSize);
    chmod(path, 493);
    return result != 0;
  }

  fn writePE(path: pchar, code: int64, size: int64): bool {
    var writer: TPE64Writer := new TPE64Writer();
    writer.Init();
    writer.SetCode(code, size);
    writer.SetEntryRVA(0x1000);
    writer.WriteStatic(path as int64, StrLen(path));
    writer.Destroy();
    return 1 as bool;
  }
  
  fn writeMachO(path: pchar, code: int64, size: int64): bool {
    // macOS ARM64 Mach-O binary layout (Apple Silicon, 16KB pages):
    //   Mach-O header (32 bytes)
    //   LC_SEGMENT_64 __PAGEZERO (72 bytes, 0 sections)
    //   LC_SEGMENT_64 __TEXT     (72+80=152 bytes, 1 section)
    //   LC_MAIN                  (24 bytes)
    //   Zeros to page boundary P
    //   Code section (size bytes)
    //
    // Page size: ARM64 macOS uses 0x4000 (16KB).

    var pageSize: int64 := 0x4000;
    var numCmds: int64 := 3;
    var segPZSize: int64 := 72;
    var segTextSize: int64 := 152;
    var lcMainSize: int64 := 24;
    var totalCmdSz: int64 := segPZSize + segTextSize + lcMainSize;  // 248
    var H: int64 := 32 + totalCmdSz;   // 280
    var P: int64 := pageSize;  // H=280 < 16KB so P = one page = 0x4000
    var textBase: int64 := 0x100000000;
    var textVMSz: int64 := P + size;

    var outCap: int64 := P + size;
    var outBuf: int64 := alloc(outCap);

    // Zero buffer
    var z: int64 := 0;
    while z < outCap {
      poke8(outBuf + z, 0);
      z += 1;
    }

    var off: int64 := 0;

    // --- Mach-O header (32 bytes) ---
    poke32(outBuf + off, 0xFEEDFACF); off := off + 4;  // magic MH_MAGIC_64
    if self.target == LYX_TC_MACOS_ARM64 {
      poke32(outBuf + off, 0x0100000C); off := off + 4;  // CPU_TYPE_ARM64
      poke32(outBuf + off, 0); off := off + 4;           // CPU_SUBTYPE_ARM64_ALL
    } else {
      poke32(outBuf + off, 0x01000007); off := off + 4;  // CPU_TYPE_X86_64
      poke32(outBuf + off, 3); off := off + 4;           // CPU_SUBTYPE_X86_64_ALL
    }
    poke32(outBuf + off, 2); off := off + 4;           // MH_EXECUTE
    poke32(outBuf + off, numCmds); off := off + 4;
    poke32(outBuf + off, totalCmdSz); off := off + 4;
    poke32(outBuf + off, 0x00200001); off := off + 4;  // MH_NOUNDEFS|MH_PIE
    poke32(outBuf + off, 0); off := off + 4;           // reserved

    // --- LC_SEGMENT_64 __PAGEZERO (72 bytes) ---
    poke32(outBuf + off, 0x19); off := off + 4;   // LC_SEGMENT_64
    poke32(outBuf + off, 72); off := off + 4;     // cmdsize
    // segname "__PAGEZERO" (16 bytes)
    var segPAGEZERO: pchar := "__PAGEZERO";
    memcpy(outBuf + off, segPAGEZERO as int64, 10);
    off += 16;
    poke64(outBuf + off, 0); off := off + 8;          // vmaddr = 0
    poke64(outBuf + off, textBase); off := off + 8;   // vmsize = 0x100000000
    poke64(outBuf + off, 0); off := off + 8;          // fileoff = 0
    poke64(outBuf + off, 0); off := off + 8;          // filesize = 0
    poke32(outBuf + off, 0); off := off + 4;          // maxprot = NONE
    poke32(outBuf + off, 0); off := off + 4;          // initprot = NONE
    poke32(outBuf + off, 0); off := off + 4;          // nsects = 0
    poke32(outBuf + off, 0); off := off + 4;          // flags = 0

    // --- LC_SEGMENT_64 __TEXT (152 bytes) ---
    poke32(outBuf + off, 0x19); off := off + 4;   // LC_SEGMENT_64
    poke32(outBuf + off, 152); off := off + 4;    // cmdsize
    // segname "__TEXT" (16 bytes)
    var segTEXT1: pchar := "__TEXT";
    memcpy(outBuf + off, segTEXT1 as int64, 6);
    off += 16;
    poke64(outBuf + off, textBase); off := off + 8;   // vmaddr
    poke64(outBuf + off, textVMSz); off := off + 8;   // vmsize
    poke64(outBuf + off, 0); off := off + 8;          // fileoff = 0 (whole file)
    poke64(outBuf + off, textVMSz); off := off + 8;   // filesize
    poke32(outBuf + off, 5); off := off + 4;          // maxprot = R|X
    poke32(outBuf + off, 5); off := off + 4;          // initprot = R|X
    poke32(outBuf + off, 1); off := off + 4;          // nsects = 1
    poke32(outBuf + off, 0); off := off + 4;          // flags = 0

    // Section __text in __TEXT (80 bytes)
    // sectname "__text" (16 bytes)
    var secText: pchar := "__text";
    memcpy(outBuf + off, secText as int64, 6);
    off += 16;
    // segname "__TEXT" (16 bytes)
    var segTEXT2: pchar := "__TEXT";
    memcpy(outBuf + off, segTEXT2 as int64, 6);
    off += 16;
    poke64(outBuf + off, textBase + P); off := off + 8;  // addr
    poke64(outBuf + off, size); off := off + 8;          // size
    poke32(outBuf + off, P); off := off + 4;             // offset in file
    poke32(outBuf + off, 4); off := off + 4;             // align = 2^4
    poke32(outBuf + off, 0); off := off + 4;             // reloff
    poke32(outBuf + off, 0); off := off + 4;             // nreloc
    poke32(outBuf + off, 0x80000400); off := off + 4;    // flags = PURE|SOME_INSTR
    poke32(outBuf + off, 0); off := off + 4;             // reserved1
    poke32(outBuf + off, 0); off := off + 4;             // reserved2
    poke32(outBuf + off, 0); off := off + 4;             // reserved3

    // --- LC_MAIN (24 bytes) ---
    poke32(outBuf + off, 0x80000028); off := off + 4;  // LC_MAIN
    poke32(outBuf + off, 24); off := off + 4;          // cmdsize
    poke64(outBuf + off, P); off := off + 8;           // entryoff (from __TEXT start)
    poke64(outBuf + off, 0); off := off + 8;           // stacksize = 0

    // Copy code at offset P (buffer already zeroed)
    var ci: int64 := 0;
    memcpy(outBuf + P, code, size);

    // Write to file
    var fd: int64 := open(path, 577, 493);
    if fd < 0 {
      free(outBuf, outCap);
      return false;
    }
    write(fd, outBuf as pchar, outCap);
    close(fd);
    free(outBuf, outCap);
    return true;
  }
  
