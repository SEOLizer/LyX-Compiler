// lyxc-keygen — Lizenzschlüssel-Generator (NICHT für Endkunden)
//
// Verwendung: lyxc-keygen --name="Vorname Nachname" --email="user@example.com"
//
// Dieses Binary wird vom Lizenzgeber lokal gebaut und NICHT ausgeliefert.
// Es kennt das Master-Secret (über lic_secret.lyx) und leitet daraus
// den Schlüssel ab — genau wie die Verifikation in lyxc.

import src.crypto.lic_derive;

fn pfxEq(arg: int64, pfx: pchar, pfxLen: int64): bool {
  var i: int64 := 0;
  while i < pfxLen {
    if peek8(arg + i) != peek8(pfx as int64 + i) { return false; }
    i := i + 1;
  }
  return true;
}

pub fn main(argc: int64, argv: pchar): int64 {
  var name:  int64 := 0;
  var email: int64 := 0;

  var i: int64 := 1;
  while i < argc {
    var arg: int64 := peek64(argv as int64 + i * 8);
    if pfxEq(arg, "--name="c,  7) { name  := arg + 7; }
    if pfxEq(arg, "--email="c, 8) { email := arg + 8; }
    i := i + 1;
  }

  if name == 0 || email == 0 {
    PrintStr("Verwendung: lyxc-keygen --name=NAME --email=EMAIL\n"c);
    return 1;
  }

  var nameLen:  int64 := StrLen(name  as pchar);
  var emailLen: int64 := StrLen(email as pchar);
  var keyBuf:   int64 := mmap(0, 32, 3, 34, -1, 0);
  if keyBuf == 0 { return 1; }

  lic_deriveKey(name, nameLen, email, emailLen, keyBuf as pchar);

  PrintStr("lyxc License Key Generator\n"c);
  PrintStr("Name:  "c); PrintStr(name  as pchar); PrintStr("\n"c);
  PrintStr("Email: "c); PrintStr(email as pchar); PrintStr("\n"c);
  PrintStr("Key:   "c); PrintStr(keyBuf as pchar); PrintStr("\n"c);
  PrintStr("\n"c);
  PrintStr("Speichern als ~/.lyx/license.key:\n"c);
  PrintStr("  name="c);  PrintStr(name  as pchar); PrintStr("\n"c);
  PrintStr("  email="c); PrintStr(email as pchar); PrintStr("\n"c);
  PrintStr("  key="c);   PrintStr(keyBuf as pchar); PrintStr("\n"c);

  munmap(keyBuf, 32);
  return 0;
}
