// ============================================================================
// Sema class
// Note: internal node-access methods use prefix 'sn_' to avoid VMT
//       collisions with the Parser class which has methods named NKind etc.
// ============================================================================

pub type Sema = class {

  // Source and parser data (copied from Parser on Init)
  src:        pchar;
  srcLen:     int64;
  pNodes:     int64;   // Parser.nodes buffer
  pNodeCount: int64;
  pToks:      int64;   // Parser.toks buffer
  pTokCount:  int64;

  // Symbol table (flat buffer of SEMA_SYM_SIZE byte entries)
  syms:     Array<SymRecord>;  // WP-POKE-08: heap array of symbol records
  symCount: int64;
  symCap:   int64;

  // Scope stack (each entry = int64 = symCount at scope start)
  scopes:     int64;
  scopeDepth: int64;
  scopeCap:   int64;

  // Diagnostics
  hadError:   int64;
  errorCount: int64;

  // WP-BC-22: current class node index (-1 = global scope)
  curClassNi: int64;

  // WP-L8: current class-level @capabilities node (-1 = none)
  classCapNode: int64;

  // Import deduplication (WP-10e)
  importedMods:  int64;
  importedCount: int64;
  importedCap:   int64;

  // #1028: Register der von Imports EXPORTIERTEN Symbole. Je Eintrag 32 Byte:
  //  +0  namePtr:8    Symbolname (nicht null-terminiert)
  //  +8  nameLen:8
  //  +16 modPtr:8     Modul, das ihn exportiert
  //  +24 modLen:8
  // Ohne diese Zuordnung laesst sich nicht sagen, WOHER ein doppelter Name
  // stammt -- und ohne das ist eine Kollisionsmeldung nicht brauchbar.
  expSyms:      int64;
  expSymCount:  int64;
  expSymCap:    int64;
  // Bis zu welchem Symbolindex die Exporte bereits erfasst sind. Ein Import
  // verarbeitet in Pass1 auch seine eigenen Imports; deren Symbole liegen mit
  // im Bereich des aeusseren Imports und sind dort bereits (mit ihrem echten
  // Modul) eingetragen. Ohne diese Marke meldete der aeussere Durchlauf sie
  // ein zweites Mal -- als Kollision mit sich selbst.
  expScanned:   int64;
  // #1035: Sichtbarkeit importierter Symbole. privFlags[i] != 0 bedeutet: das
  // Symbol stammt aus einem Import und traegt dort KEIN pub. privMod* haelt den
  // Modulnamen fuer die Meldung.
  privFlags:  int64;
  privModPtr: int64;
  privModLen: int64;
  privCap:    int64;
  privEnforce: int64;   // #1035: nur waehrend Pass2 des Wurzelmoduls pruefen

  // #1009: Typparameter der GERADE geprueften generischen Deklaration.
  // Innerhalb einer Vorlage ist `T` ein gueltiger Typname, auch wenn
  // ResolveType ihn nicht kennt — der konkrete Typ entsteht erst bei der
  // Monomorphisierung am Aufrufort.
  tpNames: int64;
  tpLens:  int64;
  tpCount: int64;
  tpCap:   int64;

  // WP-14/2.1: Generic instantiation cache
  // Record layout (64 bytes each):
  //  +0  genNamePtr:8   pointer to generic function name
  //  +8  genNameLen:8   length of generic function name
  //  +16 typeHash:8     hash of type arguments
  //  +24 instNamePtr:8  pointer to mangled name buffer
  //  +32 instNameLen:8  length of mangled name
  //  +40 instSymIdx:8   symbol table index of specialization
  //  +48 genNodeIdx:8   AST node index of the generic declaration
  //  +56 typeArgsNi:8   AST node index of first type-arg node
  instCache: int64;
  instCount: int64;
  instCap:   int64;
  instDepth: int64;  // WP-2.1: recursion depth guard

  // WP-13: Capture analysis for closures
  // Track which outer-scope variables are captured by nested functions
  capturedVars: int64;   // buffer: {funcNamePtr:8, funcNameLen:8, varNamePtr:8, varNameLen:8}
  capturedCount: int64;
  capturedCap:   int64;

  // WP-BC-42: search paths for import resolution (-I / --std-path)
  includePath: int64;  // extra include dir (pchar), 0 = not set
  stdPath:     int64;  // stdlib root override (pchar), 0 = not set

  // WP-35: actual byte count of the last file read by _sema_readFile (binary-safe, no StrLen)
  lastReadSize: int64;

  // WP-KM-01: --target=lyxos-kernel: 1 = reject POSIX-dependent imports
  kernelMode: int64;

  // WP-BC-46: verbose type-inference diagnostics
  typeReasoning: bool;  // --type-reasoning: log each resolved type
  constraintLog: bool;  // --constraint-log: log each type constraint

  // WP-CS-05: injected compile-time constants (TARGET_ARCH, OS_LINUX, etc.)
  injConValues: int64;  // ptr to int64 array — parallel to injected symbol entries
  injConCount:  int64;
  injConCap:    int64;

  // WP-CS-07: @io_check / @overflow_check scope state
  ioCheckEnabled:       int64;  // 0=off (default), 1=on
  overflowCheckEnabled: int64;  // 0=off (default), 1=on

  // WP-AS-03: @bounds_check / @debug_info / @optimization_level scope state
  boundsCheckEnabled: int64;  // 1=on (default, safety-first), 0=off
  debugInfoEnabled:   int64;  // 0=off (default), 1=on
  optLevel:           int64;  // 2=default, 0=none, 1=min, 3=aggressive

  // WP-AS-15: Definite Assignment Analysis (DAA)
  daaEnabled: int64;   // 0=off (default in v0.9, opt-in), 1=warn, 2=error
  daaBuf:     int64;   // mmap'd scratch buffer for DAA uninit-set {namePtr:8, nameLen:8} * 256
  daaCapacity: int64;  // max entries in daaBuf

  // WP-EN-03: @energy top-level directive state
  energyLevel: int64;  // 0=not set, 1-5=active

  // LX-36: @lifecycle annotation state
  lifecycleKind: int64;  // LBF_LC_ONE_SHOT=0 (default), EVENT_LOOP=1, DAEMON=2, REACTIVE=3

  // WP-L3: Capability-Vererbung
  currModuleCaps:  CapSet;  // C(P) des aktuellen Moduls (aus @capabilities auf main/module)
  importCapCache:  int64;   // ptr: (nameHash:8, capSetPtr:8) Paare
  importCapCount:  int64;
  importCapCap:    int64;

  // WP-L4: Transitiver Capability-Graph
  capGraph:        CapGraph;  // Modul-Import-Graph für transitive Hülle
  rootNodeIdx:     int64;     // Graph-Index des Wurzelmoduls (aktuell kompilierte Datei)

  // WP-L6: Compile-Time Stripping
  capStripper:     CapStripper;  // Liste geprunter Module + Report

  // WP-L7: @uses_caller_cap Registry und Callsite-Prüfung
  // UCC-Eintragsformat (UCC_ENTRY_SIZE Bytes):
  //   namePtr:8, nameLen:8, capCount:8, capId[0..7]:8*8 = 88 Bytes
  uccBuf:          int64;   // flat Buffer für UCC-Einträge
  uccCount:        int64;
  // Effektive Capabilities der aktuell analysierten Funktion
  // (eigene @capabilities + @uses_caller_cap = borrowable caps)
  curFuncCapBuf:   int64;   // alloc'd int64[64]: capIds
  curFuncCapCount: int64;
  // Pending-Annotations vor der nächsten Funktionsdeklaration
  pendingCapNode:  int64;   // letztes NK_CAPABILITY_ATTR vor NK_FUNC_DECL
  pendingUccNode:  int64;   // letztes NK_USES_CALLER_CAP vor NK_FUNC_DECL

  // BUG-3: current source file path for error messages (null = root module)
  curFile: pchar;

  // FFI-SANDBOX: 1 = aktuell analysierte Unit ist vertrauenswürdig (std.*/src.*),
  // 0 = User-Code. Unbekannte FFI (FFI_CLASS_UNKNOWN) ist nur in User-Code
  // fail-closed (erfordert @capabilities) — std-Bindings (571 Externs) bleiben erlaubt.
  ffiTrusted: int64;
  // Symbolanzahl nach Pass1 = Wasserzeichen der globalen Symbole. Alles darüber
  // ist Funktions-lokal und damit für eine verschachtelte Funktion tabu.
  globalSymCount: int64;
  // Symbolanzahl beim Betreten einer verschachtelten fn; -1 = nicht in einer.
  nestedBarrier: int64;
  // Vom Treiber gesetzt: 1, wenn das Root-Modul selbst eine stdlib-Unit ist
  // (--compile-unit auf einer Datei im stdlib-Baum). Siehe Check().
  unitTrusted: int64;

  // WP-KI-02: pointer to ErrorCollector (0 = text mode, ≠0 = --error-json mode)
  errColl: int64;

  // ------------------------------------------------------------------
  // Node access helpers
  // Prefixed sn_ to avoid VMT collision with Parser methods of same name.
  // ------------------------------------------------------------------

  fn sn_off(i: int64): int64    { return self.pNodes + i * SEMA_NODE_SIZE; }
  fn sn_kind(i: int64): int64   { return peek64(self.sn_off(i)); }
  fn sn_c0(i: int64): int64     { return peek64(self.sn_off(i) + NODE_OFF_C0); }
  fn sn_c1(i: int64): int64     { return peek64(self.sn_off(i) + NODE_OFF_C1); }
  fn sn_c2(i: int64): int64     { return peek64(self.sn_off(i) + NODE_OFF_C2); }
  fn sn_c3(i: int64): int64     { return peek64(self.sn_off(i) + NODE_OFF_C3); }
  fn sn_next(i: int64): int64   { return peek64(self.sn_off(i) + NODE_OFF_NEXT); }
  fn sn_tokIdx(i: int64): int64 { return peek64(self.sn_off(i) + NODE_OFF_TOKIDX); }
  fn sn_iVal(i: int64): int64   { return peek64(self.sn_off(i) + NODE_OFF_IVAL); }
  fn sn_sVal(i: int64): pchar   { return self.src + peek64(self.sn_off(i) + NODE_OFF_SVAL); }
  fn sn_sLen(i: int64): int64   { return peek64(self.sn_off(i) + NODE_OFF_SLEN); }

  fn sn_set_c0(i: int64, val: int64) { poke64(self.sn_off(i) + NODE_OFF_C0, val); }

  // Token line number (SEMA_TOK_SIZE = 40; line at +32)
  fn sn_tokLine(i: int64): int64 { return peek64(self.pToks + i * SEMA_TOK_SIZE + TOK_OFF_LINE); }

  // ------------------------------------------------------------------
  // String comparison (length-delimited, no null terminator required)
  // ------------------------------------------------------------------

  fn _strNEq(a: pchar, aLen: int64, b: pchar, bLen: int64): bool {
    if (aLen != bLen) { return false; }
    var i: int64 := 0;
    while (i < aLen) {
      if (StrCharAt(a, i) != StrCharAt(b, i)) { return false; }
      i += 1;
    }
    return true;
  }

  // ------------------------------------------------------------------
  // Symbol table helpers
  // ------------------------------------------------------------------

  pub fn SymName(i: int64): pchar       { return self.syms[i].name; }
  pub fn SymNameLen(i: int64): int64    { return self.syms[i].nameLen; }
  pub fn SymKind(i: int64): int64       { return self.syms[i].kind; }
  pub fn SymTypeId(i: int64): int64     { return self.syms[i].typeId; }
  pub fn SymNodeIdx(i: int64): int64    { return self.syms[i].nodeIdx; }
  pub fn SymIsVolatile(i: int64): int64 { return self.syms[i].isVolatile; }
  pub fn SymCount(): int64              { return self.symCount; }

  pub fn SetSymNodeIdx(i: int64, val: int64)  { self.syms[i].nodeIdx    := val; }
  pub fn SetSymVolatile(i: int64, val: int64) { self.syms[i].isVolatile := val; }
  pub fn SetSymKind(i: int64, val: int64)     { self.syms[i].kind       := val; }
  pub fn SetSymTypeId(i: int64, val: int64)   { self.syms[i].typeId     := val; }

  fn _growSyms() {
    var newCap: int64 := self.symCap * 2;
    var nb: int64 := alloc(newCap * SEMA_SYM_SIZE + 16);
    // Copy existing symbol data (skip old header, write past new header)
    memcpy(nb + 16, self.syms + 16, self.symCount * SEMA_SYM_SIZE);
    // Set new header: cap and current len
    poke64(nb,     newCap);
    poke64(nb + 8, self.symCount);
    self.syms   := nb;
    self.symCap := newCap;
  }

  fn _pushSym(name: pchar, nameLen: int64, kind: int64, typeId: int64, nodeIdx: int64) {
    if (self.symCount >= self.symCap) { self._growSyms(); }
    self.syms[self.symCount].name       := name;
    self.syms[self.symCount].nameLen    := nameLen;
    self.syms[self.symCount].kind       := kind;
    self.syms[self.symCount].typeId     := typeId;
    self.syms[self.symCount].nodeIdx    := nodeIdx;
    self.syms[self.symCount].isVolatile := 0;
    poke64(self.syms + 8, self.symCount + 1);
    self.symCount += 1;
  }

  // Register a builtin function (name = string literal pointer)
  fn _regBuiltin(name: pchar) {
    // Compute StrLen before method call to avoid rdi-clobber bug
    var _len: int64 := StrLen(name);
    self._pushSym(name, _len, SYM_BUILTIN, TY_UNKNOWN, -2);
  }

  // Register a builtin int64 constant
  fn _regBuiltinCon(name: pchar) {
    var _len: int64 := StrLen(name);
    self._pushSym(name, _len, SYM_CON, TY_INT64, -2);
  }

  // Lookup by name pointer + length; returns symbol index or -1
  fn Lookup(name: pchar, nameLen: int64): int64 {
    var i: int64 := self.symCount - 1;
    var privHit: int64 := 0 - 1;   // #1035: erster Treffer, der unit-privat ist
    while (i >= 0) {
      var sName: pchar  := self.SymName(i);
      var sLen:  int64  := self.SymNameLen(i);
      if (self._strNEq(sName, sLen, name, nameLen)) {
        // #1035: Ein importiertes Symbol OHNE pub ist unit-intern und fuer den
        // Importeur nicht sichtbar. Es wird uebersprungen, die Suche laeuft
        // weiter — damit bindet `import std.alloc; alloc(16)` an die oeffentliche
        // Fassung, auch wenn eine gleichnamige private aus einem anderen Import
        // spaeter in der flachen Tabelle steht. Erst wenn es GAR keine
        // oeffentliche Fassung gibt, wird gemeldet.
        if (self.privEnforce != 0 && i < self.privCap && peek8(self.privFlags + i) != 0) {
          if (privHit < 0) { privHit := i; }
          i -= 1;
          continue;
        }
        return i;
      }
      i -= 1;
    }
    // #1035: nur ein privater Treffer, keine oeffentliche Fassung — melden.
    if (privHit >= 0) {
      if (peek8(self.privFlags + privHit) == 1) {
        self._reportPrivateAccess(privHit, self.SymName(privHit), self.SymNameLen(privHit));
      }
      return privHit;
    }
    return -1;
  }

  // ------------------------------------------------------------------
  // Scope management
  // ------------------------------------------------------------------

  fn _pushScope() {
    if (self.scopeDepth >= self.scopeCap) {
      var newCap: int64 := self.scopeCap * 2;
      var nb: int64 := alloc(newCap * 8);
      var i: int64 := 0;
      memcpy(nb, self.scopes, self.scopeDepth * 8);
      self.scopes   := nb;
      self.scopeCap := newCap;
    }
    poke64(self.scopes + self.scopeDepth * 8, self.symCount);
    self.scopeDepth += 1;
  }

  fn _popScope() {
    if (self.scopeDepth <= 0) { PrintStr("sema: scope underflow\n"); return; }
    self.scopeDepth -= 1;
    self.symCount   := peek64(self.scopes + self.scopeDepth * 8);
  }

  // ------------------------------------------------------------------
  // Error reporting
  // ------------------------------------------------------------------

  fn _error(msg: pchar, line: int64) {
    if self.errColl != 0 {
      // WP-KI-02: route to ErrorCollector instead of text output
      var ec: ErrorCollector := self.errColl as ErrorCollector;
      ec.EcAdd(1, 0, self.curFile, line, msg);
    } else {
      if self.curFile != 0 as pchar {
        PrintStr(self.curFile);
        PrintStr(": ");
      }
      PrintStr("sema error (line ");
      PrintInt(line);
      PrintStr("): ");
      PrintStr(msg);
      PrintStr("\n");
    }
    self.hadError   := 1;
    self.errorCount += 1;
  }

  fn _errorNode(msg: pchar, ni: int64) {
    var tokIdx: int64 := self.sn_tokIdx(ni);
    var line: int64 := 0;
    if (tokIdx >= 0 && tokIdx < self.pTokCount) {
      line := self.sn_tokLine(tokIdx);
    }
    self._error(msg, line);
  }

  fn _errorNodeName(msg: pchar, ni: int64, name: pchar, nameLen: int64) {
    var tokIdx: int64 := self.sn_tokIdx(ni);
    var line: int64 := 0;
    if (tokIdx >= 0 && tokIdx < self.pTokCount) {
      line := self.sn_tokLine(tokIdx);
    }
    if self.errColl != 0 {
      // WP-KI-02: build combined message "msg 'name'" and route to collector
      var mlen: int64 := StrLen(msg);
      var tbuf: int64 := alloc(mlen + nameLen + 5);
      memcpy(tbuf, msg as int64, mlen);
      poke8(tbuf + mlen,     32);  // space
      poke8(tbuf + mlen + 1, 39);  // '
      memcpy(tbuf + mlen + 2, name as int64, nameLen);
      poke8(tbuf + mlen + 2 + nameLen,     39);  // '
      poke8(tbuf + mlen + 2 + nameLen + 1, 0);   // NUL
      var ec: ErrorCollector := self.errColl as ErrorCollector;
      ec.EcAdd(1, 0, self.curFile, line, tbuf as pchar);
      free(tbuf, mlen + nameLen + 5);
    } else {
      if self.curFile != 0 as pchar {
        PrintStr(self.curFile);
        PrintStr(": ");
      }
      PrintStr("sema error (line ");
      PrintInt(line);
      PrintStr("): ");
      PrintStr(msg);
      PrintStr(" '");
      sys_write(1, name as int64, nameLen);
      PrintStr("'\n");
    }
    self.hadError   := 1;
    self.errorCount += 1;
  }

  // WP-AS-15: emit a warning (does not increment errorCount)
  fn _warnNode(msg: pchar, ni: int64) {
    var tokIdx: int64 := self.sn_tokIdx(ni);
    var line: int64 := 0;
    if (tokIdx >= 0 && tokIdx < self.pTokCount) {
      line := self.sn_tokLine(tokIdx);
    }
    if self.errColl != 0 {
      var ec: ErrorCollector := self.errColl as ErrorCollector;
      ec.EcAdd(1, 1, self.curFile, line, msg);
    } else {
      PrintStr("warning(line "c);
      PrintInt(line);
      PrintStr("): "c);
      PrintStrLn(msg);
    }
  }

  // WP-2.2-A: Print a non-NUL-terminated source substring (for error messages).
  fn _printSrcName(name: pchar, len: int64) {
    // WP-10.1: len+1 must not overflow; reject implausibly large names (>2 GB)
    if (len < 0 || len > 0x7FFFFFFF) { PrintStr("(?)"c); return; }
    var buf: int64 := alloc(len + 1);
    if (buf == 0) { PrintStr("(?)"c); return; }
    var i: int64 := 0;
    while (i < len) { poke8(buf + i, StrCharAt(name, i)); i := i + 1; }
    poke8(buf + len, 0);
    PrintStr(buf as pchar);
    free(buf, len + 1);
  }

  // WP-2.2-A: Given an SNK_IDENT discriminant node, return the SNK_ENUM_DECL
  // node index of the variable's enum type, or -1 if it is not an enum.
  fn _findEnumDeclForIdent(identNi: int64): int64 {
    var nm: pchar := self.sn_sVal(identNi);
    var nl: int64 := self.sn_sLen(identNi);
    var sym: int64 := self.Lookup(nm, nl);
    if (sym < 0) { return -1; }
    var sk: int64 := self.SymKind(sym);
    if (sk != SYM_VAR && sk != SYM_PARAM) { return -1; }
    // Variable/parameter declaration → c0 holds the type node
    var declNi: int64 := self.SymNodeIdx(sym);
    if (declNi < 0) { return -1; }
    var typeNi: int64 := self.sn_c0(declNi);
    if (typeNi < 0) { return -1; }
    // Type node sVal/sLen give the enum's name
    var typeName: pchar := self.sn_sVal(typeNi);
    var typeLen:  int64 := self.sn_sLen(typeNi);
    var enumSym: int64 := self.Lookup(typeName, typeLen);
    if (enumSym < 0) { return -1; }
    if (self.SymKind(enumSym) != SYM_ENUM) { return -1; }
    return self.SymNodeIdx(enumSym);
  }

  // Sucht ein Feld in einer Struct-/Klassendeklaration und laeuft dabei die
  // Vererbungskette hoch (c2 = Elterntyp). 1 = gefunden bzw. nicht entscheidbar,
  // 0 = sicher nicht vorhanden. Iterativ statt rekursiv gehalten.
  fn _fieldExistsInDecl(startNi: int64, fldName: pchar, fldLen: int64): int64 {
    var declNi: int64 := startNi;
    var depth:  int64 := 0;
    while (declNi >= 0) {
      // Zyklus in der Vererbungskette: sema meldet das an anderer Stelle,
      // hier nur abbrechen und im Zweifel nicht meckern.
      if (depth > 16) { return 1; }
      var f: int64 := self.sn_c0(declNi);
      while (f >= 0) {
        if (self.sn_kind(f) == 7) {
          if (self._strNEq(fldName, fldLen, self.sn_sVal(f), self.sn_sLen(f)) != 0) { return 1; }
        }
        f := self.sn_next(f);
      }
      // Auch die Methoden (c1) zaehlen: `obj.Method` ohne Klammern nimmt die
      // Methode als WERT und bindet dabei den Empfaenger -- so werden
      // Methodenzeiger zugewiesen (`btn.on_click := form.Handle`). Diese Liste
      // fehlte zunaechst, wodurch jede solche Zuweisung als "unknown field"
      // abgelehnt wurde.
      var m: int64 := self.sn_c1(declNi);
      while (m >= 0) {
        if (self._strNEq(fldName, fldLen, self.sn_sVal(m), self.sn_sLen(m)) != 0) { return 1; }
        m := self.sn_next(m);
      }
      var parentNi: int64 := self.sn_c2(declNi);
      if (parentNi < 0) { return 0; }
      var pSym: int64 := self.Lookup(self.sn_sVal(parentNi), self.sn_sLen(parentNi));
      if (pSym < 0) { return 1; }        // Elternteil unbekannt -> nicht meckern
      // Elternklasse aus einem importierten Unit hat hier keinen AST-Knoten:
      // die Felderliste ist von dieser Uebersetzungseinheit aus nicht
      // einsehbar, Abwesenheit also nicht belegbar. Das betraf die gesamte
      // lyxvision-Hierarchie (TView -> TGroup -> ...) und meldete dort zwoelf
      // Units faelschlich als kaputt.
      declNi := self.SymNodeIdx(pSym);
      if (declNi < 0) { return 1; }
      depth := depth + 1;
    }
    return 0;
  }

  // Prueft bei `basis.feld`, ob `feld` im deklarierten Typ von `basis` existiert.
  //
  // Ohne diese Pruefung akzeptierte sema jeden Feldnamen auf jeder Basis: ein
  // Tippfehler (`p.lenght`) uebersetzte klaglos und lieferte zur Laufzeit 0,
  // ebenso `x.irgendwas` auf einem int64. Aufgefallen an std/qt5_egl.lyx, wo
  // ein Beispiel `disp.display` auf einem `pub type EGLDisplay = int64`
  // schrieb -- einem Typ ganz ohne Felder.
  //
  // Bewusst konservativ: gemeldet wird nur, wenn die Basis ein schlichter
  // Bezeichner ist, dessen deklarierter Typ sich eindeutig zu einer Struct-
  // oder Klassendeklaration mit mindestens einem Feld aufloesen laesst. Alles
  // andere (zusammengesetzte Ausdruecke, generische Instanzen, unbekannte oder
  // importierte Typen) bleibt ungeprueft, damit die Pruefung keine gueltigen
  // Programme abweist.
  fn _checkFieldExists(ni: int64) {
    var baseNi: int64 := self.sn_c0(ni);
    if (baseNi < 0) { return; }
    if (self.sn_kind(baseNi) != SNK_IDENT) { return; }
    var bn: pchar := self.sn_sVal(baseNi);
    var bl: int64 := self.sn_sLen(baseNi);
    if (bn == 0) { return; }
    if (bl <= 0) { return; }
    var sym: int64 := self.Lookup(bn, bl);
    if (sym < 0) { return; }
    var sk: int64 := self.SymKind(sym);
    if (sk != SYM_VAR && sk != SYM_PARAM) { return; }
    var declNi: int64 := self.SymNodeIdx(sym);
    if (declNi < 0) { return; }
    var typeNi: int64 := self.sn_c0(declNi);
    if (typeNi < 0) { return; }
    if (self.sn_kind(typeNi) != SNK_TYPE_NAME) { return; }
    if (self.sn_c1(typeNi) >= 0) { return; }
    var tSym: int64 := self.Lookup(self.sn_sVal(typeNi), self.sn_sLen(typeNi));
    if (tSym < 0) { return; }
    var tk: int64 := self.SymKind(tSym);
    if (tk != SYM_STRUCT && tk != SYM_TYPE) { return; }
    var tDecl: int64 := self.SymNodeIdx(tSym);
    if (tDecl < 0) { return; }
    if (self.sn_c0(tDecl) < 0) { return; }
    if (self.sn_kind(self.sn_c0(tDecl)) != 7) { return; }
    var fldName: pchar := self.sn_sVal(ni);
    var fldLen:  int64 := self.sn_sLen(ni);
    if (fldName == 0) { return; }
    if (fldLen <= 0) { return; }
    if (self._fieldExistsInDecl(tDecl, fldName, fldLen) == 0) {
      self._errorNodeName("unknown field", ni, fldName, fldLen);
    }
  }

  // ------------------------------------------------------------------
  // Type resolution
  // ------------------------------------------------------------------

  fn ResolveType(typeNi: int64): int64 {
    if (typeNi < 0) { return TY_VOID; }
    var k: int64 := self.sn_kind(typeNi);
    if (k == SNK_TYPE_ARRAY) { return TY_ARRAY; }
    if (k == 101) { return TY_ARRAY; }   // WP-BC-51: NK_TYPE_ARRAY_FIXED T[N]
    // WP-BC-17: RingBuffer<T> type
    if (k == SNK_TYPE_RINGBUF) { return TY_RING_BUFFER; }
    // WP-BC-18: parallel Array<T> type
    if (k == SNK_TYPE_PARALLEL) { return TY_PARALLEL_ARRAY; }
    // WP-04: Tuple return type [T, T, ...]
    if (k == SNK_TYPE_TUPLE) { return TY_TUPLE; }
    // WP-13: Function pointer type
    if (k == SNK_FN_PTR) { return TY_FN_PTR; }
    if (k == SNK_METHOD_PTR) { return TY_FN_PTR; }   // B2: method-Typ (Etappe 1: wie fn-ptr akzeptiert)
    // WP-14: Type parameter (T, U, etc.)
    if (k == SNK_TYPE_PARAM) { return TY_TYPE_PARAM; }
    // WP-14: Generic instantiation with type arguments
    if (k == SNK_TYPE_NAME && self.sn_c1(typeNi) >= 0) { return TY_GENERIC_INST; }
    if (k != SNK_TYPE_NAME)  { return TY_UNKNOWN; }
    var nm: pchar  := self.sn_sVal(typeNi);
    var nl: int64  := self.sn_sLen(typeNi);
    if (self._strNEq(nm, nl, "void",    4)) { return TY_VOID;    }
    if (self._strNEq(nm, nl, "bool",    4)) { return TY_BOOL;    }
    if (self._strNEq(nm, nl, "int64",   5)) { return TY_INT64;   }
    if (self._strNEq(nm, nl, "int32",   5)) { return TY_INT32;   }
    if (self._strNEq(nm, nl, "int16",   5)) { return TY_INT16;   }
    if (self._strNEq(nm, nl, "int8",    4)) { return TY_INT8;    }
    // #1151: iN als Schreibweise von intN. Fuer die vorzeichenLOSEN Typen hat
    // #1010 genau diese Luecke geschlossen; die vorzeichenbehaftete Haelfte
    // blieb offen -- `var a: i8` wurde abgewiesen, `a as i8` und `feld: i8`
    // gingen durch. ebnf.md §7 fuehrt beide Formen als denselben Typ.
    if (self._strNEq(nm, nl, "i64",     3)) { return TY_INT64;   }
    if (self._strNEq(nm, nl, "i32",     3)) { return TY_INT32;   }
    if (self._strNEq(nm, nl, "i16",     3)) { return TY_INT16;   }
    if (self._strNEq(nm, nl, "i8",      2)) { return TY_INT8;    }
    if (self._strNEq(nm, nl, "u64",     3)) { return TY_UINT64;  }
    if (self._strNEq(nm, nl, "u32",     3)) { return TY_UINT32;  }
    if (self._strNEq(nm, nl, "u16",     3)) { return TY_UINT16;  }
    if (self._strNEq(nm, nl, "u8",      2)) { return TY_UINT8;   }
    // #1010: uintN als Schreibweise von uN. Sie wird im Bestand breit verwendet
    // (std/net/types.lyx, mehrere Tests) und wurde im Feld stillschweigend
    // akzeptiert, im var-Deklarator aber abgewiesen -- beide Wege stimmen jetzt
    // ueberein. Kanonisch bleibt uN (ebnf.md §7).
    if (self._strNEq(nm, nl, "uint64",  6)) { return TY_UINT64;  }
    if (self._strNEq(nm, nl, "uint32",  6)) { return TY_UINT32;  }
    if (self._strNEq(nm, nl, "uint16",  6)) { return TY_UINT16;  }
    if (self._strNEq(nm, nl, "uint8",   5)) { return TY_UINT8;   }
    if (self._strNEq(nm, nl, "pchar",   5)) { return TY_PCHAR;   }
    if (self._strNEq(nm, nl, "f64",     3)) { return TY_FLOAT64; }
    if (self._strNEq(nm, nl, "f32",     3)) { return TY_FLOAT32; }
    if (self._strNEq(nm, nl, "char",    4)) { return TY_CHAR;    }
    // Look up user-defined type (struct / enum / type alias)
    var si: int64 := self.Lookup(nm, nl);
    if (si >= 0) {
      var sk: int64 := self.SymKind(si);
      if (sk == SYM_STRUCT || sk == SYM_ENUM || sk == SYM_TYPE) { return TY_USER; }
    }
    return TY_UNKNOWN;
  }

  // ------------------------------------------------------------------
  // WP-10e: import processing helpers
  // ------------------------------------------------------------------

  fn _sema_hasImported(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.importedCount) {
      var base: int64 := self.importedMods + i * 16;
      var p: pchar    := peek64(base) as pchar;
      var n: int64    := peek64(base + IMPORTED_OFF_NAMELEN);
      if (self._strNEq(p, n, name, nameLen)) { return 1; }
      i += 1;
    }
    return 0;
  }

  fn _sema_markImported(name: pchar, nameLen: int64) {
    if (self.importedCount >= self.importedCap) {
      var nc: int64 := self.importedCap * 2;
      var nb: int64 := alloc(nc * 16);
      var i: int64 := 0;
      memcpy(nb, self.importedMods, self.importedCount * 16);
      self.importedMods := nb;
      self.importedCap  := nc;
    }
    var base: int64 := self.importedMods + self.importedCount * 16;
    poke64(base,                      name as int64);
    poke64(base + IMPORTED_OFF_NAMELEN, nameLen);
    self.importedCount += 1;
  }

  // ------------------------------------------------------------------
  // #1028: Register der exportierten Symbole und Kollisionspruefung
  // ------------------------------------------------------------------

  // Traegt ein exportiertes Symbol mit seinem Herkunftsmodul ein.
  fn _recordExportedSym(name: pchar, nameLen: int64, modName: pchar, modLen: int64) {
    if (self.expSymCount >= self.expSymCap) {
      var nc: int64 := self.expSymCap * 2;
      var nb: int64 := alloc(nc * 32);
      memcpy(nb, self.expSyms, self.expSymCount * 32);
      self.expSyms   := nb;
      self.expSymCap := nc;
    }
    var base: int64 := self.expSyms + self.expSymCount * 32;
    poke64(base,      name as int64);
    poke64(base + 8,  nameLen);
    poke64(base + 16, modName as int64);
    poke64(base + 24, modLen);
    self.expSymCount += 1;
  }

  // Eintrag zu einem bereits registrierten Exportnamen; 0 = keiner.
  fn _findExportedSym(name: pchar, nameLen: int64): int64 {
    var i: int64 := 0;
    while (i < self.expSymCount) {
      var base: int64 := self.expSyms + i * 32;
      if (self._strNEq(peek64(base) as pchar, peek64(base + 8), name, nameLen)) { return base; }
      i += 1;
    }
    return 0;
  }

  // Nur Symbole, deren Doppeldeutigkeit den Aufrufer treffen kann: aufrufbare
  // bzw. referenzierbare Namen. Felder, Parameter und Locals stehen nie in der
  // globalen Tabelle zweier Module nebeneinander.
  fn _symKindIsAmbiguityRelevant(k: int64): int64 {
    if (k == SYM_FUNC)         { return 1; }
    if (k == SYM_GENERIC_FUNC) { return 1; }
    if (k == SYM_VAR)          { return 1; }
    if (k == SYM_STRUCT)       { return 1; }
    if (k == SYM_TYPE)         { return 1; }
    if (k == SYM_ENUM)         { return 1; }
    return 0;
  }

  // Prueft die frisch registrierten Symbole eines Imports gegen die bereits
  // bekannten Exporte und traegt sie danach selbst ein.
  //
  // Nur `pub`-Symbole zaehlen: ein unit-privater Helfer ist kein Angebot an den
  // Aufrufer, auch wenn Pass1 ihn (noch) in dieselbe flache Tabelle legt.
  // Zwei Units duerfen also weiterhin je ein eigenes internes `AlignUp` haben.
  //
  // Ohne diese Pruefung entschied allein die Reihenfolge in Lookup()
  // (rueckwaerts, letzter gewinnt), welche von zwei gleichnamigen
  // Implementierungen aufgerufen wird -- fehlerfrei uebersetzt, fehlerfrei
  // ausgefuehrt, falsches Ergebnis. Siehe Issue #1028.
  //
  // WICHTIG: vor dem nodeIdx-Fixup aufrufen. Danach ist der Knotenindex der
  // SYM_TYPE-Symbole auf -2 gesetzt und das pub-Flag nicht mehr lesbar.
  fn _checkAndRecordExports(symStart: int64, modName: pchar, modLen: int64) {
    var i: int64 := symStart;
    if (self.expScanned > i) { i := self.expScanned; }
    while (i < self.symCount) {
      if (self._symKindIsAmbiguityRelevant(self.SymKind(i)) != 0) {
        var ni: int64 := self.SymNodeIdx(i);
        // ni < 0: Builtin oder kein einsehbarer Knoten — nicht entscheidbar,
        // also nicht melden (fail-open, wie bei jeder Pruefung ueber
        // Typdeklarationen).
        // #1035: importiertes Symbol OHNE pub vormerken. Ausgenommen sind
        // `extern fn` (iVal Bit0): eine FFI-Bindung ist eine Link-Zeit-Zusage
        // und der eigentliche Zweck solcher Units — std/audio/alsa.lyx traegt
        // an keiner ihrer snd_pcm_*-Deklarationen ein pub, bietet sie aber
        // genau dafuer an. Sie als privat zu behandeln wuerde jede FFI-Unit
        // unbrauchbar machen.
        if (ni >= 0 && peek64(self.sn_off(ni) + NODE_OFF_ISPUB) == 0) {
          var isExternFn: int64 := 0;
          if (self.sn_kind(ni) == SNK_FUNC_DECL && (self.sn_iVal(ni) & 1) != 0) { isExternFn := 1; }
          if (isExternFn == 0 && i < self.privCap) {
            poke8(self.privFlags + i, 1);
            poke64(self.privModPtr + i * 8, modName as int64);
            poke64(self.privModLen + i * 8, modLen);
          }
        }
        if (ni >= 0 && peek64(self.sn_off(ni) + NODE_OFF_ISPUB) != 0) {
          var nm:  pchar := self.SymName(i);
          var nl:  int64 := self.SymNameLen(i);
          var hit: int64 := self._findExportedSym(nm, nl);
          if (hit != 0) {
            self._reportSymbolCollision(nm, nl, modName, modLen,
                                        peek64(hit + 16) as pchar, peek64(hit + 24));
          } else {
            self._recordExportedSym(nm, nl, modName, modLen);
          }
        }
      }
      i += 1;
    }
    self.expScanned := self.symCount;
  }

  fn _reportSymbolCollision(symName: pchar, symLen: int64,
                            modA: pchar, modALen: int64,
                            modB: pchar, modBLen: int64) {
    EPrintStr("sema error: mehrdeutiges Symbol '"c);
    sys_write(2, symName as int64, symLen);
    EPrintStr("' — exportiert von '"c);
    sys_write(2, modB as int64, modBLen);
    EPrintStr("' und '"c);
    sys_write(2, modA as int64, modALen);
    EPrintStrLn("'"c);
    EPrintStrLn("  Beide Units sind importiert; welche gebunden wird, entschiede allein die Import-Reihenfolge."c);
    EPrintStrLn("  Abhilfe: nur eine der beiden Units importieren oder eines der Symbole umbenennen."c);
    self.hadError   := 1;
    self.errorCount += 1;
  }

  // #1035: Zugriff auf ein importiertes Symbol, das in seiner Unit kein pub
  // traegt. Gemeldet wird einmal je Symbol (privFlags wird auf 2 gesetzt).
  fn _reportPrivateAccess(symIdx: int64, symName: pchar, symLen: int64) {
    EPrintStr("sema error: '"c);
    sys_write(2, symName as int64, symLen);
    EPrintStr("' ist in Unit '"c);
    sys_write(2, peek64(self.privModPtr + symIdx * 8), peek64(self.privModLen + symIdx * 8));
    EPrintStrLn("' nicht pub"c);
    EPrintStrLn("  Ohne pub ist eine Deklaration unit-intern und kein Angebot an den Aufrufer."c);
    EPrintStrLn("  Abhilfe: in der Unit ein pub davorsetzen, wenn sie zur Schnittstelle gehoert."c);
    poke8(self.privFlags + symIdx, 2);
    self.hadError   := 1;
    self.errorCount += 1;
  }

  fn _sema_readFile(path: pchar): pchar {
    var fd: int64 := open(path, 0, 0);
    if (fd < 0) {
      // WP-BC-42: fall back to includePath/<path> if set
      if (self.includePath != 0) {
        var incBase: pchar := self.includePath as pchar;
        var baseLen: int64 := StrLen(incBase);
        var pathLen: int64 := StrLen(path);
        var tryLen: int64 := baseLen + 1 + pathLen + 1;
        var tryBuf: int64 := alloc(tryLen);
        var i: int64 := 0;
        while i < baseLen { poke8(tryBuf + i, StrCharAt(incBase, i) & 255); i := i + 1; }
        StrSetChar(tryBuf as pchar, i, 47); i := i + 1;
        var j: int64 := 0;
        while j < pathLen { poke8(tryBuf + i + j, StrCharAt(path, j) & 255); j := j + 1; }
        poke8(tryBuf + i + j, 0);
        fd := open(tryBuf as pchar, 0, 0);
      }
      // Also try stdPath/<path> if includePath search failed
      if (fd < 0 && self.stdPath != 0) {
        var stdBase: pchar := self.stdPath as pchar;
        var baseLen: int64 := StrLen(stdBase);
        var pathLen: int64 := StrLen(path);
        var tryLen: int64 := baseLen + 1 + pathLen + 1;
        var tryBuf: int64 := alloc(tryLen);
        var i: int64 := 0;
        while i < baseLen { poke8(tryBuf + i, StrCharAt(stdBase, i) & 255); i := i + 1; }
        StrSetChar(tryBuf as pchar, i, 47); i := i + 1;
        var j: int64 := 0;
        while j < pathLen { poke8(tryBuf + i + j, StrCharAt(path, j) & 255); j := j + 1; }
        poke8(tryBuf + i + j, 0);
        fd := open(tryBuf as pchar, 0, 0);
      }
      if (fd < 0) { return 0 as pchar; }
    }
    var size: int64 := lseek(fd, 0, 2);
    if (size <= 0) { close(fd); return 0 as pchar; }
    // WP-31: Dateigrößen-Limit 256 MB — verhindert OOM durch präparierte .lyu/.lyx-Eingaben
    if (size > 268435456) {
      PrintStr("error: _sema_readFile: Unit überschreitet 256-MB-Limit\n"c);
      close(fd); return 0 as pchar;
    }
    lseek(fd, 0, 0);
    var buf: int64 := alloc(size + 1);
    var bytesRead: int64 := read(fd, buf as pchar, size);
    if bytesRead != size { close(fd); return 0 as pchar; }  // WP-27: partieller Read → Fehler
    poke8(buf + size, 0);
    close(fd);
    self.lastReadSize := size;  // WP-35: expose actual byte count for binary-safe callers
    return buf as pchar;
  }

  // WP-BC-50b: inline .lyu binary parser — injects symbols without parsing source
  fn _sema_parseLyuSyms(data: pchar, size: int64) {
    if (size < 10) { return; }
    // Validate magic 'LYU'
    if ((StrCharAt(data, 0) & 255) != 76) { return; }
    if ((StrCharAt(data, 1) & 255) != 89) { return; }
    if ((StrCharAt(data, 2) & 255) != 85) { return; }
    var pos: int64 := 4;  // skip magic (4 bytes)
    if pos + 4 > size { return; }
    var version: int64 := (StrCharAt(data, pos) & 255) | ((StrCharAt(data, pos+1) & 255) << 8);
    pos += 2;  // version
    pos += 1;  // arch
    pos += 1;  // flags
    // unit name
    if pos + 2 > size { return; }
    var ulen: int64 := (StrCharAt(data, pos) & 255) | ((StrCharAt(data, pos+1) & 255) << 8);
    if pos + 2 + ulen > size { return; }
    pos := pos + 2 + ulen;
    // v2 metadata: description, author, copyright
    if (version >= 2) {
      if pos + 2 > size { return; }
      var dl: int64 := (StrCharAt(data, pos) & 255) | ((StrCharAt(data, pos+1) & 255) << 8);
      if pos + 2 + dl > size { return; }
      pos := pos + 2 + dl;
      if pos + 2 > size { return; }
      var al: int64 := (StrCharAt(data, pos) & 255) | ((StrCharAt(data, pos+1) & 255) << 8);
      if pos + 2 + al > size { return; }
      pos := pos + 2 + al;
      if pos + 2 > size { return; }
      var cl: int64 := (StrCharAt(data, pos) & 255) | ((StrCharAt(data, pos+1) & 255) << 8);
      if pos + 2 + cl > size { return; }
      pos := pos + 2 + cl;
    }
    if pos + 4 > size { return; }
    var symCount: int64 := (StrCharAt(data, pos) & 255) | ((StrCharAt(data, pos+1) & 255) << 8) | ((StrCharAt(data, pos+2) & 255) << 16) | ((StrCharAt(data, pos+3) & 255) << 24);
    pos += 4;
    // WP-35: reject crafted .lyu files with absurdly large symCount (prevents OOM)
    if symCount > 65536 {
      EPrintStrLn("sema error: .lyu symCount unreasonably large — möglicherweise manipulierte Datei"c);
      return;
    }
    if pos + 16 > size { return; }
    pos += 16;  // skip 4 × u32 offset placeholders
    // Inject each exported symbol into the current sema scope
    var si: int64 := 0;
    while (si < symCount && pos < size) {
      if pos + 2 > size { return; }
      var nameLen: int64 := (StrCharAt(data, pos) & 255) | ((StrCharAt(data, pos+1) & 255) << 8);
      if pos + 2 + nameLen > size { return; }
      pos += 2;
      var namePtr: pchar := (data as int64 + pos) as pchar;
      pos += nameLen;
      if pos + 1 > size { return; }
      var lsk: int64 := StrCharAt(data, pos) & 255;
      pos += 1;
      if pos + 4 > size { return; }
      pos += 4;  // skip typeHash (u32)
      if pos + 2 > size { return; }
      var tiLen: int64 := (StrCharAt(data, pos) & 255) | ((StrCharAt(data, pos+1) & 255) << 8);
      if pos + 2 + tiLen > size { return; }
      pos += 2;
      var tiPtr: pchar := (data as int64 + pos) as pchar;
      pos += tiLen;
      // Map LSK kind → SYM kind
      var symKind: int64 := SYM_VAR;
      if (lsk == 0 || lsk == 7) { symKind := SYM_FUNC; }   // fn / extern fn
      if (lsk == 3)             { symKind := SYM_CON; }    // con
      if (lsk == 4 || lsk == 5) { symKind := SYM_STRUCT; } // struct / class
      if (lsk == 6)             { symKind := SYM_ENUM; }   // enum
      if (lsk == 8 || lsk == 9) { symKind := SYM_TYPE; }   // dim / utype
      // Map typeInfo string → TY_xxx by prefix matching on known names
      var typeId: int64 := TY_UNKNOWN;
      if (tiLen >= 4 && (StrCharAt(tiPtr, 0) & 255) == 118) { typeId := TY_VOID; }    // "void"
      if (tiLen == 4 && (StrCharAt(tiPtr, 0) & 255) == 98)  { typeId := TY_BOOL; }    // "bool"
      if (tiLen == 5 && (StrCharAt(tiPtr, 0) & 255) == 105 && (StrCharAt(tiPtr, 1) & 255) == 110 && (StrCharAt(tiPtr, 4) & 255) == 52) { typeId := TY_INT32; }  // "int32"
      if (tiLen == 5 && (StrCharAt(tiPtr, 0) & 255) == 105 && (StrCharAt(tiPtr, 4) & 255) == 56) { typeId := TY_INT8; }   // "int8x" → too broad, check exactly
      if (tiLen == 5 && (StrCharAt(tiPtr, 1) & 255) == 110 && (StrCharAt(tiPtr, 2) & 255) == 116 && (StrCharAt(tiPtr, 3) & 255) == 54 && (StrCharAt(tiPtr, 4) & 255) == 52) { typeId := TY_INT64; }  // "int64"
      if (tiLen == 5 && (StrCharAt(tiPtr, 0) & 255) == 112) { typeId := TY_PCHAR; }  // "pchar"
      if (tiLen == 7 && (StrCharAt(tiPtr, 0) & 255) == 102 && (StrCharAt(tiPtr, 1) & 255) == 108 && (StrCharAt(tiPtr, 5) & 255) == 54) { typeId := TY_FLOAT64; }  // "float64"
      if (tiLen == 4 && (StrCharAt(tiPtr, 0) & 255) == 99)  { typeId := TY_CHAR; }   // "char"
      if (typeId == TY_UNKNOWN) { typeId := TY_USER; }
      self._pushSym(namePtr, nameLen, symKind, typeId, -2);
      si += 1;
    }
  }

  // WP-KM-01: length-aware exact match (modName slice vs null-terminated literal).
  fn _sema_kmEq(a: pchar, aLen: int64, b: pchar): int64 {
    var bLen: int64 := StrLen(b);
    if aLen != bLen { return 0; }
    var i: int64 := 0;
    while i < aLen {
      if (StrCharAt(a, i) & 255) != (StrCharAt(b, i) & 255) { return 0; }
      i += 1;
    }
    return 1;
  }

  // WP-KM-01: length-aware prefix match (modName slice starts with null-terminated literal).
  fn _sema_kmPfx(a: pchar, aLen: int64, b: pchar): int64 {
    var bLen: int64 := StrLen(b);
    if aLen < bLen { return 0; }
    var i: int64 := 0;
    while i < bLen {
      if (StrCharAt(a, i) & 255) != (StrCharAt(b, i) & 255) { return 0; }
      i += 1;
    }
    return 1;
  }

  // WP-KM-01: returns 1 if modName[0..modLen] is a POSIX import forbidden in kernel mode.
  fn _sema_isKernelForbidden(modName: pchar, modLen: int64): int64 {
    // WP-28: std.net.* — Allowlist-Ansatz: alles blockiert, nur 5 reine Frame-Units erlaubt
    if self._sema_kmEq(modName, modLen, "std.net"c) != 0 { return 1; }
    if self._sema_kmPfx(modName, modLen, "std.net."c) != 0 {
      if self._sema_kmEq(modName, modLen, "std.net.eth"c)        != 0 { return 0; }
      if self._sema_kmEq(modName, modLen, "std.net.ipv4"c)       != 0 { return 0; }
      if self._sema_kmEq(modName, modLen, "std.net.udp"c)        != 0 { return 0; }
      if self._sema_kmEq(modName, modLen, "std.net.arp.frame"c)  != 0 { return 0; }
      if self._sema_kmEq(modName, modLen, "std.net.dhcp.frame"c) != 0 { return 0; }
      return 1;
    }
    // std.fs.*, std.thread.*, std.os.*, std.io.* — alle verboten
    if self._sema_kmEq(modName, modLen, "std.fs"c)        != 0 { return 1; }
    if self._sema_kmPfx(modName, modLen, "std.fs."c)      != 0 { return 1; }
    if self._sema_kmEq(modName, modLen, "std.thread"c)    != 0 { return 1; }
    if self._sema_kmPfx(modName, modLen, "std.thread."c)  != 0 { return 1; }
    if self._sema_kmEq(modName, modLen, "std.os"c)        != 0 { return 1; }
    if self._sema_kmPfx(modName, modLen, "std.os."c)      != 0 { return 1; }
    if self._sema_kmEq(modName, modLen, "std.io"c)        != 0 { return 1; }
    if self._sema_kmPfx(modName, modLen, "std.io."c)      != 0 { return 1; }
    return 0;
  }

  fn _sema_processImport(modName: pchar, modLen: int64, importNi: int64) {
    if (self._sema_hasImported(modName, modLen) != 0) { return; }
    self._sema_markImported(modName, modLen);

    // WP-7a: ".." als Modulkomponente verbieten ("..foo.bar" → "../foo/bar.lyx")
    // WP-33: `wptd + 1 < modLen` avoids underflow when modLen == 0
    var wptd: int64 := 0;
    while wptd + 1 < modLen {
      if ((StrCharAt(modName, wptd) & 255) == 46 && (StrCharAt(modName, wptd + 1) & 255) == 46) {
        EPrintStr("sema error: import path traversal verboten: "c);
        EPrintStrLn(modName);
        self.hadError   := 1;
        self.errorCount += 1;
        return;
      }
      wptd += 1;
    }

    // WP-KM-01: kernel mode — reject POSIX-dependent imports
    if self.kernelMode != 0 {
      if self._sema_isKernelForbidden(modName, modLen) != 0 {
        EPrintStr("kernel error: POSIX import verboten in --target=lyxos-kernel: "c);
        sys_write(2, modName as int64, modLen);
        EPrintStr("\n"c);
        self.hadError   := 1;
        self.errorCount += 1;
        return;
      }
    }

    // Convert "bootstrap.mathlib" → "bootstrap/mathlib.lyx"
    var pathBuf: int64 := alloc(modLen + 8);
    var i: int64 := 0;
    while (i < modLen) {
      var c: int64 := StrCharAt(modName, i);
      if (c == 46) { c := 47; }  // '.' → '/'
      poke8(pathBuf + i, c);
      i += 1;
    }
    var lyxExt: pchar := ".lyx";
    memcpy(pathBuf + modLen, lyxExt as int64, 5);

    var path: pchar := pathBuf as pchar;
    var src: pchar  := self._sema_readFile(path);
    if (src == 0 as pchar) {
      // WP-BC-50b: .lyx not found — try .lyu fallback (pre-compiled unit)
      StrSetChar(pathBuf as pchar, modLen + 3, 117);  // 'x' → 'u' → ".lyu"
      var lyuPath: pchar := pathBuf as pchar;
      var lyuSrc: pchar := self._sema_readFile(lyuPath);
      if (lyuSrc != 0 as pchar) {
        // WP-35: use actual file size (not StrLen) — .lyu is binary and contains null bytes
        var lyuSize: int64 := self.lastReadSize;
        self._sema_parseLyuSyms(lyuSrc, lyuSize);
        return;
      }
      // Weder .lyx noch .lyu gefunden. Vorher kehrte die Funktion hier
      // kommentarlos zurück: der Import verschwand, und der Fehler tauchte erst
      // an der ERSTEN NUTZUNG als "undefined function" auf — was nach einem
      // Tippfehler im Funktionsnamen aussieht, während die Ursache der
      // Import-Pfad ist. Genau so verlor sich `import src.std.cpu.features`
      // in std/cpu/dispatch.lyx.
      self._errorNodeName("Modul nicht gefunden (weder .lyx noch .lyu)", importNi, modName, modLen);
      // pathBuf wurde für den .lyu-Versuch in place umgeschrieben — für die
      // Meldung auf ".lyx" zurücksetzen, sonst steht dort zweimal ".lyu".
      StrSetChar(pathBuf as pchar, modLen + 3, 120);   // 'u' → 'x'
      EPrintStr("  gesucht als: "c);
      EPrintStr(path);
      EPrintStrLn(" (und dieselbe Datei mit .lyu)"c);
      if (self.includePath != 0) {
        EPrintStr("  -I: "c); EPrintStrLn(self.includePath as pchar);
      }
      if (self.stdPath != 0) {
        EPrintStr("  --std-path: "c); EPrintStrLn(self.stdPath as pchar);
      }
      return;
    }

    var p: Parser := new Parser();
    p.Init(src, StrLen(src));
    var head: int64 := p.Parse();
    if (p.hadError != 0) {
      PrintStr("sema error: parse error in imported module '"c);
      sys_write(1, modName as int64, modLen);
      PrintStr("'\n"c);
      self.hadError   := 1;
      self.errorCount += 1;
      dispose p;
      return;
    }

    // WP-L6: Caps ZUERST extrahieren (vor Pass1) für Pruning-Entscheidung
    var savedSrc:      pchar := self.src;
    var savedNodes:    int64 := self.pNodes;
    var savedToks:     int64 := self.pToks;
    var savedTokCount: int64 := self.pTokCount;
    var savedCurFile:  pchar := self.curFile;
    self.src       := p.src;
    self.pNodes    := p.nodes;
    self.pToks     := p.toks;
    self.pTokCount := p.tokCount;
    self.curFile   := path;

    // @capabilities extrahieren (für WP-L3 Cache und WP-L4 Graph)
    var importedCaps: CapSet := new CapSet();
    importedCaps.Init();
    // @uses_caller_cap extrahieren (für WP-L6 K3/K4 Pruning und WP-L4 Graph)
    var ucCaps: CapSet := new CapSet();
    ucCaps.Init();
    var capScanNi: int64 := head;
    while capScanNi >= 0 {
      var kk: int64 := self.sn_kind(capScanNi);
      if kk == SNK_CAPABILITY_ATTR && self.sn_iVal(capScanNi) == 0 {
        self._fillCapSet(self.sn_c0(capScanNi), importedCaps);
      } else if kk == SNK_USES_CALLER_CAP {
        self._fillCapSet(self.sn_c0(capScanNi), ucCaps);
      }
      capScanNi := self.sn_next(capScanNi);
    }

    // WP-L6: Pruning-Entscheidung — prune wenn WEDER @capabilities NOCH @uses_caller_cap
    // eine Überschneidung mit C(root) haben
    var stripByDecl: bool := self._shouldStripModule(importedCaps.entries, importedCaps.count);
    var stripByUcc:  bool := self._shouldStripModule(ucCaps.entries, ucCaps.count);
    // Modul nur prunen wenn beide Mengen keine Überschneidung haben
    // (importedCaps.count == 0 bedeutet "keine deklarativen Caps" → nur ucCaps entscheidet)
    var doStrip: bool := false;
    if importedCaps.count == 0 && ucCaps.count == 0 {
      doStrip := false;  // Utility-Modul: niemals prunen
    } else if importedCaps.count > 0 && ucCaps.count == 0 {
      doStrip := stripByDecl;
    } else if importedCaps.count == 0 && ucCaps.count > 0 {
      doStrip := stripByUcc;
    } else {
      doStrip := stripByDecl && stripByUcc;  // beide müssen leer sein
    }

    if doStrip {
      // Modul gepruned: Namen als null-term. Kopie sichern und melden
      var nameCopy: int64 := alloc(modLen + 1);
      memcpy(nameCopy, modName as int64, modLen);
      poke8(nameCopy + modLen, 0);
      self.capStripper.AddStripped(nameCopy as pchar, modLen);
      self.src       := savedSrc;
      self.pNodes    := savedNodes;
      self.pToks     := savedToks;
      self.pTokCount := savedTokCount;
      self.curFile   := savedCurFile;
      dispose p;
      return;
    }

    // Nicht gepruned: Pass1 ausführen um Symbole zu registrieren
    var symsBefore: int64 := self.symCount;
    self.Pass1(head);

    // #1028: exportierte Namen gegen die frueher importierten pruefen. Muss vor
    // dem nodeIdx-Fixup laufen — der macht das pub-Flag unlesbar.
    self._checkAndRecordExports(symsBefore, modName, modLen);
    // Fix stale nodeIdx (bestehende Logik, unverändert)
    var si: int64 := symsBefore;
    while (si < self.symCount) {
      if (self.SymKind(si) == SYM_TYPE) {
        var importNi: int64 := self.SymNodeIdx(si);
        if (importNi >= 0) {
          self.SetSymNodeIdx(si, -2);
        }
      }
      si += 1;
    }

    // WP-L3: Caps cachen
    self._cacheImportCaps(modName, modLen, importedCaps);

    // WP-L4: Knoten im Cap-Graph anlegen und eigene Caps setzen
    var nodeIdx: int64 := self.capGraph.AddNode(modName, modLen);
    if nodeIdx >= 0 {
      self.capGraph.SetOwnCapsFromCapSet(nodeIdx, importedCaps.entries, importedCaps.count);

      // @uses_caller_cap-Caps aus ucCaps (WP-L6: bereits extrahiert) hinzufügen
      var uci: int64 := 0;
      while uci < ucCaps.count {
        self.capGraph.AddOwnCap(nodeIdx,
          peek64(ucCaps.entries + uci * 16),
          peek64(ucCaps.entries + uci * 16 + 8));
        uci += 1;
      }

      // Kanten zu direkten Imports dieses Moduls hinzufügen
      var impScanNi: int64 := head;
      while impScanNi >= 0 {
        if self.sn_kind(impScanNi) == SNK_IMPORT {
          var subName: pchar  := self.sn_sVal(impScanNi);
          var subLen:  int64  := self.sn_sLen(impScanNi);
          var subIdx:  int64  := self.capGraph.AddNode(subName, subLen);
          self.capGraph.AddEdge(nodeIdx, subIdx);
        }
        impScanNi := self.sn_next(impScanNi);
      }
    }

    // FFI-SANDBOX: std.*/src.*-Units sind vertrauenswürdig (Binding-Layer = TCB);
    // ihre Externs dürfen FFI_CLASS_UNKNOWN sein. User-Code (und Drittmodule)
    // bleiben fail-closed. modName-Namespace ist robust (User kann nicht als std.*
    // importieren — Resolver schlägt std.* nur im stdPath nach).
    var savedTrust: int64 := self.ffiTrusted;
    var isStd: int64 := 0;
    if modLen >= 4 {
      if (StrCharAt(modName,0)&255)==115 && (StrCharAt(modName,1)&255)==116 &&
         (StrCharAt(modName,2)&255)==100 && (StrCharAt(modName,3)&255)==46 { isStd := 1; }  // "std."
      if (StrCharAt(modName,0)&255)==115 && (StrCharAt(modName,1)&255)==114 &&
         (StrCharAt(modName,2)&255)==99  && (StrCharAt(modName,3)&255)==46 { isStd := 1; }  // "src."
    }
    self.ffiTrusted := isStd;

    // BUG-3: type-check function bodies in imported module
    self.Pass2(head);

    self.ffiTrusted := savedTrust;
    self.src       := savedSrc;
    self.pNodes    := savedNodes;
    self.pToks     := savedToks;
    self.pTokCount := savedTokCount;
    self.curFile   := savedCurFile;

    dispose p;
  }

  // ------------------------------------------------------------------
  // WP-CS-06: @if constant-folding helpers
  // ------------------------------------------------------------------

  fn _lookupConst(name: pchar, nlen: int64): int64 {
    var si: int64 := self.Lookup(name, nlen);
    if (si < 0) { return 0; }
    if (self.SymKind(si) != SYM_CON) { return 0; }
    var nodeIdx: int64 := self.SymNodeIdx(si);
    if (self.IsInjCon(nodeIdx) != 0) { return self.InjConValue(nodeIdx); }
    if (nodeIdx < 0) { return 0; }
    var initNi: int64 := self.sn_c1(nodeIdx);
    if (initNi < 0) { return 0; }
    return self._evalConstExpr(initNi);
  }

  // BUG-5: compute compile-time size of a class or struct by name
  fn _sizeofType(name: pchar, nlen: int64): int64 {
    if self._strNEq(name, nlen, "int64"c, 5) { return 8; }
    if self._strNEq(name, nlen, "bool"c,  4) { return 8; }
    if self._strNEq(name, nlen, "f64"c,   3) { return 8; }
    if self._strNEq(name, nlen, "pchar"c, 5) { return 8; }
    var si: int64 := self.Lookup(name, nlen);
    if si < 0 { return 8; }
    var nodeIdx: int64 := self.SymNodeIdx(si);
    if nodeIdx < 0 { return 8; }
    var kk: int64 := self.sn_kind(nodeIdx);
    if kk == SNK_TYPE_DECL {
      var fieldCnt: int64 := 0;
      var tmp: int64 := self.sn_c0(nodeIdx);
      while tmp >= 0 {
        if self.sn_kind(tmp) == 7 { fieldCnt := fieldCnt + 1; }
        tmp := self.sn_next(tmp);
      }
      var vmtSlots: int64 := 0;
      var mth: int64 := self.sn_c1(nodeIdx);
      while mth >= 0 {
        if self.sn_kind(mth) == SNK_FUNC_DECL {
          if ((self.sn_iVal(mth) >> 1) & 1) != 0 { vmtSlots := vmtSlots + 1; }
        }
        mth := self.sn_next(mth);
      }
      if vmtSlots > 0 { return (fieldCnt + 1) * 8; }
      return fieldCnt * 8;
    }
    if kk == SNK_STRUCT_DECL {
      var fieldCnt: int64 := 0;
      var tmp: int64 := self.sn_c0(nodeIdx);
      while tmp >= 0 {
        if self.sn_kind(tmp) == 7 { fieldCnt := fieldCnt + 1; }
        tmp := self.sn_next(tmp);
      }
      return fieldCnt * 8;
    }
    return 8;
  }

  // #1082: Bereichstyp `type X = int64 range LO..HI;`.
  //
  // Liefert 1, wenn typeNi auf einen Bereichstyp zeigt, und legt die Grenzen
  // in loBox/hiBox ab. Der Parser haengt die Grenzen als NK_RANGE-Knoten an
  // c1 der Typdeklaration und setzt iv-Bit 2 (Wert 4).
  fn _rangeBounds(typeNi: int64, loBox: int64, hiBox: int64): int64 {
    if (typeNi < 0) { return 0; }
    var nm:  pchar := self.sn_sVal(typeNi);
    var nml: int64 := self.sn_sLen(typeNi);
    if (nml <= 0) { return 0; }
    var si: int64 := self.Lookup(nm, nml);
    if (si < 0) { return 0; }
    if (self.SymKind(si) != SYM_TYPE) { return 0; }
    var declNi: int64 := self.SymNodeIdx(si);
    // Ein importierter Typ ist hier nicht entscheidbar (SymNodeIdx == -1).
    // Das heisst "unbekannt", nicht "kein Bereichstyp" -- also nichts melden.
    if (declNi < 0) { return 0; }
    if ((self.sn_iVal(declNi) & 4) == 0) { return 0; }
    var rn: int64 := self.sn_c1(declNi);
    if (rn < 0) { return 0; }
    var loN: int64 := self.sn_c0(rn);
    var hiN: int64 := self.sn_c1(rn);
    if (loN < 0 || hiN < 0) { return 0; }
    poke64(loBox, self.sn_iVal(loN));
    poke64(hiBox, self.sn_iVal(hiN));
    return 1;
  }

  // #1082: Ist der Ausdruck eine Ganzzahlkonstante? 1 = ja, Wert in outBox.
  //
  // Bewusst eng gehalten: Literal, negiertes Literal und `con`-Bezeichner.
  // _evalConstExpr liefert bei nicht-konstanten Ausdruecken 0 und laesst sich
  // deshalb nicht von einer echten 0 unterscheiden -- hier braucht es aber
  // genau diese Unterscheidung, sonst wuerde jede Variable als "0" geprueft.
  fn _constIntOf(ni: int64, outBox: int64): int64 {
    if (ni < 0) { return 0; }
    var k: int64 := self.sn_kind(ni);
    if (k == 40) { poke64(outBox, self.sn_iVal(ni)); return 1; }
    if (k == SNK_UNOP) {
      if (self.sn_iVal(ni) != 71) { return 0; }   // nur unaeres Minus
      var innerNi: int64 := self.sn_c0(ni);
      if (innerNi < 0) { return 0; }
      if (self.sn_kind(innerNi) != 40) { return 0; }
      poke64(outBox, 0 - self.sn_iVal(innerNi));
      return 1;
    }
    if (k == SNK_IDENT) {
      var si: int64 := self.Lookup(self.sn_sVal(ni), self.sn_sLen(ni));
      if (si < 0) { return 0; }
      if (self.SymKind(si) != SYM_CON) { return 0; }
      poke64(outBox, self._lookupConst(self.sn_sVal(ni), self.sn_sLen(ni)));
      return 1;
    }
    if (k == SNK_BINOP) {
      // Beide Seiten konstant -> der ganze Ausdruck ist es. Deckt `0 - 5` ab,
      // die uebliche Schreibweise fuer negative Werte in diesem Bestand.
      var lBox: int64 := alloc(8);
      var rBox: int64 := alloc(8);
      var okL: int64 := self._constIntOf(self.sn_c0(ni), lBox);
      var okR: int64 := 0;
      if (okL != 0) { okR := self._constIntOf(self.sn_c1(ni), rBox); }
      var res: int64 := 0;
      if (okR != 0) {
        var bop: int64 := self.sn_iVal(ni);
        var lv: int64 := peek64(lBox);
        var rv: int64 := peek64(rBox);
        if (bop == 70) { poke64(outBox, lv + rv); res := 1; }
        if (bop == 71) { poke64(outBox, lv - rv); res := 1; }
        if (bop == 72) { poke64(outBox, lv * rv); res := 1; }
        if (bop == 93) { poke64(outBox, lv << rv); res := 1; }
      }
      free(lBox, 8); free(rBox, 8);
      return res;
    }
    return 0;
  }

  // #1082: Konstante gegen die Grenzen eines Bereichstyps pruefen.
  fn _checkRangeAssign(typeNi: int64, valNi: int64, atNi: int64): void {
    var loBox: int64 := alloc(8);
    var hiBox: int64 := alloc(8);
    var vBox:  int64 := alloc(8);
    if (self._rangeBounds(typeNi, loBox, hiBox) != 0) {
      if (self._constIntOf(valNi, vBox) != 0) {
        var v:  int64 := peek64(vBox);
        var lo: int64 := peek64(loBox);
        var hi: int64 := peek64(hiBox);
        if (v < lo || v > hi) {
          self._errorNode("Wert liegt ausserhalb des Bereichs des Typs", atNi);
        }
      }
    }
    free(loBox, 8); free(hiBox, 8); free(vBox, 8);
  }

  // #1156: Feste Groesse einer indizierten Variablen ermitteln.
  //
  // Zwei Schreibweisen tragen die Groesse zur Uebersetzungszeit:
  //   var a: int64[3];        -> Typknoten NK_TYPE_ARRAY_FIXED, c1 = Literal
  //   var a := [1, 2, 3];     -> Initialisierung ist ein Array-Literal
  // Alles andere (dynamische Arrays, Zeiger, Parameter) ist hier nicht
  // entscheidbar. Rueckgabe 0 heisst deshalb "unbekannt", nicht "Groesse 0" —
  // wer das verwechselt, meldet jeden Zeigerzugriff als Bereichsfehler.
  fn _fixedArraySize(baseNi: int64): int64 {
    if (baseNi < 0) { return 0; }
    if (self.sn_kind(baseNi) != SNK_IDENT) { return 0; }
    var si: int64 := self.Lookup(self.sn_sVal(baseNi), self.sn_sLen(baseNi));
    if (si < 0) { return 0; }
    if (self.SymKind(si) != SYM_VAR) { return 0; }
    var declNi: int64 := self.SymNodeIdx(si);
    // Importiert oder ohne Deklarationsknoten: unentscheidbar.
    if (declNi < 0) { return 0; }
    if (self.sn_kind(declNi) != SNK_VAR_DECL) { return 0; }

    var typeNi: int64 := self.sn_c0(declNi);
    if (typeNi >= 0 && self.sn_kind(typeNi) == 101) {
      var sizeNi: int64 := self.sn_c1(typeNi);
      var sBox: int64 := alloc(8);
      var got:  int64 := self._constIntOf(sizeNi, sBox);
      var sz:   int64 := 0;
      if (got != 0) { sz := peek64(sBox); }
      free(sBox, 8);
      if (sz > 0) { return sz; }
      return 0;
    }

    var initNi: int64 := self.sn_c1(declNi);
    if (initNi >= 0 && self.sn_kind(initNi) == 100) {
      var cnt: int64 := 0;
      var el:  int64 := self.sn_c0(initNi);
      while (el >= 0) { cnt := cnt + 1; el := self.sn_next(el); }
      return cnt;
    }
    return 0;
  }

  // #1156: `arr[5]` bei `int64[3]` ist zur Uebersetzungszeit entscheidbar.
  //
  // Bis 1.0.11D las so ein Zugriff kommentarlos den Speicher hinter dem Array;
  // der gelesene Wert war Stack-Muell. Weder sema noch der Codegen sagten
  // etwas — auch nicht unter --runtime-checks, das Bereichspruefungen
  // ausdruecklich verspricht.
  //
  // Geprueft wird nur, was hier sicher entscheidbar ist: konstanter Index auf
  // eine Variable mit fester Groesse. Der Rest gehoert in die Laufzeitpruefung
  // des Codegens.
  fn _checkIndexBounds(ni: int64): void {
    var sz: int64 := self._fixedArraySize(self.sn_c0(ni));
    if (sz <= 0) { return; }
    var iBox: int64 := alloc(8);
    if (self._constIntOf(self.sn_c1(ni), iBox) != 0) {
      var idx: int64 := peek64(iBox);
      if (idx < 0 || idx >= sz) {
        self._errorNode("Index liegt ausserhalb des Arrays", ni);
      }
    }
    free(iBox, 8);
  }

  // #1087: Benannte Argumente `F(b: 3, a: 10)`.
  //
  // Der Parser legt sie als NK_NAMED_ARG ab (sVal = Name, c0 = Wert), danach
  // wurden sie nur noch ausgewertet -- die Zuordnung blieb POSITIONELL. Wer
  // die Namen schreibt, um sich nicht auf die Reihenfolge verlassen zu
  // muessen, bekam still ein falsches Ergebnis; erfundene Namen fielen gar
  // nicht auf.
  //
  // Hier wird die Argumentliste in die Reihenfolge der Parameter gebracht.
  // Sema und Codegen arbeiten auf DERSELBEN Knotenarena (beide bekommen
  // parser.nodes), das Umhaengen der next-Kette wirkt also bis in die
  // Codeerzeugung.
  //
  // Rueckgabe: 1 = in Ordnung (ggf. umsortiert), 0 = Fehler bereits gemeldet.
  fn _reorderNamedArgs(callNi: int64, declNi: int64, nm: pchar, nl: int64): int64 {
    // Parameterzahl und -namen
    var pc: int64 := 0;
    var pp: int64 := self.sn_c0(declNi);
    while (pp >= 0) { pc := pc + 1; pp := self.sn_next(pp); }
    if (pc <= 0) { return 1; }
    if (pc > 32) { return 1; }   // absurd viele Parameter: nicht umsortieren

    var slot: int64 := alloc(pc * 8);
    var i: int64 := 0;
    while (i < pc) { poke64(slot + i * 8, 0 - 1); i := i + 1; }

    var ok: int64 := 1;
    var seenNamed: int64 := 0;
    var pos: int64 := 0;
    var arg: int64 := self.sn_c0(callNi);
    while (arg >= 0) {
      var nxt: int64 := self.sn_next(arg);
      if (self.sn_kind(arg) == 108) {
        seenNamed := 1;
        var an: pchar := self.sn_sVal(arg);
        var al: int64 := self.sn_sLen(arg);
        // Parameterindex zum Namen suchen
        var idx: int64 := 0 - 1;
        var q: int64 := self.sn_c0(declNi);
        var qi: int64 := 0;
        while (q >= 0) {
          if (self._strNEq(self.sn_sVal(q), self.sn_sLen(q), an, al)) { idx := qi; }
          qi := qi + 1;
          q := self.sn_next(q);
        }
        if (idx < 0) {
          self._errorNodeName("unbekannter Parametername im Aufruf von", callNi, nm, nl);
          ok := 0;
        } else {
          if (peek64(slot + idx * 8) >= 0) {
            self._errorNodeName("Parameter doppelt belegt im Aufruf von", callNi, nm, nl);
            ok := 0;
          } else {
            poke64(slot + idx * 8, arg);
          }
        }
      } else {
        // Positionelles Argument nach einem benannten waere mehrdeutig.
        if (seenNamed != 0) {
          self._errorNodeName("positionelles Argument nach benanntem im Aufruf von", callNi, nm, nl);
          ok := 0;
        } else {
          if (pos < pc) {
            if (peek64(slot + pos * 8) >= 0) {
              self._errorNodeName("Parameter doppelt belegt im Aufruf von", callNi, nm, nl);
              ok := 0;
            } else {
              poke64(slot + pos * 8, arg);
            }
          }
          pos := pos + 1;
        }
      }
      arg := nxt;
    }

    if (seenNamed == 0) { free(slot, pc * 8); return 1; }

    // Alle Parameter belegt?
    if (ok != 0) {
      i := 0;
      while (i < pc) {
        if (peek64(slot + i * 8) < 0) {
          self._errorNodeName("Parameter ohne Argument im Aufruf von", callNi, nm, nl);
          ok := 0;
        }
        i := i + 1;
      }
    }

    // Neu verketten
    if (ok != 0) {
      poke64(self.sn_off(callNi) + NODE_OFF_C0, peek64(slot));
      i := 0;
      while (i < pc - 1) {
        poke64(self.sn_off(peek64(slot + i * 8)) + NODE_OFF_NEXT, peek64(slot + (i + 1) * 8));
        i := i + 1;
      }
      poke64(self.sn_off(peek64(slot + (pc - 1) * 8)) + NODE_OFF_NEXT, 0 - 1);
    }

    free(slot, pc * 8);
    return ok;
  }

  // #1087: Traegt der Aufruf ueberhaupt ein benanntes Argument?
  fn _hasNamedArg(callNi: int64): int64 {
    var a: int64 := self.sn_c0(callNi);
    while (a >= 0) {
      if (self.sn_kind(a) == 108) { return 1; }
      a := self.sn_next(a);
    }
    return 0;
  }

  fn _evalConstExpr(ni: int64): int64 {
    if (ni < 0) { return 0; }
    var k: int64 := self.sn_kind(ni);
    if (k == 40) { return self.sn_iVal(ni); }  // NK_LIT_INT
    if (k == 44) { return self.sn_iVal(ni); }  // NK_LIT_BOOL
    if (k == SNK_IDENT) {
      return self._lookupConst(self.sn_sVal(ni), self.sn_sLen(ni));
    }
    if (k == SNK_UNOP) {
      var uop: int64 := self.sn_iVal(ni);
      var cv: int64 := self._evalConstExpr(self.sn_c0(ni));
      if (uop == 87) { if (cv == 0) { return 1; } else { return 0; } }  // TK_NOT
      if (uop == 71) { return 0 - cv; }                                  // TK_MINUS (unary negation)
      return 0;
    }
    if (k == SNK_BINOP) {
      var bop: int64 := self.sn_iVal(ni);
      var lv: int64 := self._evalConstExpr(self.sn_c0(ni));
      if (bop == 85) { if (lv == 0) { return 0; } return self._evalConstExpr(self.sn_c1(ni)); }  // TK_AND
      if (bop == 86) { if (lv != 0) { return 1; } return self._evalConstExpr(self.sn_c1(ni)); }  // TK_OR
      var rv: int64 := self._evalConstExpr(self.sn_c1(ni));
      if (bop == 70) { return lv + rv; }                                  // TK_PLUS
      if (bop == 71) { return lv - rv; }                                  // TK_MINUS
      if (bop == 72) { return lv * rv; }                                  // TK_STAR
      if (bop == 73) { if (rv == 0) { return 0; } return lv / rv; }      // TK_SLASH
      if (bop == 74) { if (rv == 0) { return 0; } return lv % rv; }      // TK_PERCENT
      if (bop == 89) { return lv ^ rv; }                                  // TK_BITXOR
      if (bop == 90) { return lv & rv; }                                  // TK_BITAND
      if (bop == 91) { return lv | rv; }                                  // TK_BITOR
      if (bop == 93) { return lv << rv; }                                 // TK_SHL
      if (bop == 94) { return lv >> rv; }                                 // TK_SHR
      if (bop == 79) { if (lv == rv) { return 1; } else { return 0; } }  // TK_EQ2 ==
      if (bop == 80) { if (lv != rv) { return 1; } else { return 0; } }  // TK_NEQ !=
      if (bop == 81) { if (lv < rv)  { return 1; } else { return 0; } }  // TK_LT  <
      if (bop == 82) { if (lv <= rv) { return 1; } else { return 0; } }  // TK_LE  <=
      if (bop == 83) { if (lv > rv)  { return 1; } else { return 0; } }  // TK_GT  >
      if (bop == 84) { if (lv >= rv) { return 1; } else { return 0; } }  // TK_GE  >=
      return 0;
    }
    if (k == SNK_CALL) {
      // sizeof(TypeName) is a compile-time constant (BUG-5)
      if self._strNEq(self.sn_sVal(ni), self.sn_sLen(ni), "sizeof"c, 6) {
        var argNi: int64 := self.sn_c0(ni);
        if argNi >= 0 {
          return self._sizeofType(self.sn_sVal(argNi), self.sn_sLen(argNi));
        }
      }
      return 0;
    }
    self._errorNode("@if: non-constant expression in condition", ni);
    return 0;
  }

  fn _pruneAtIf(ni: int64): void {
    var condVal: int64 := self._evalConstExpr(self.sn_c0(ni));
    var liveBlock: int64 := -1;
    if (condVal != 0) { liveBlock := self.sn_c1(ni); }
    else              { liveBlock := self.sn_c2(ni); }
    var liveHead: int64 := -1;
    if (liveBlock >= 0) { liveHead := self.sn_c0(liveBlock); }
    poke64(self.sn_off(ni),     SNK_BLOCK);  // mutate kind → SNK_BLOCK
    self.sn_set_c0(ni, liveHead);
  }

  // ------------------------------------------------------------------
  // Pass 1: collect top-level declarations
  // ------------------------------------------------------------------

  fn _p1Decl(ni: int64) {
    var k: int64    := self.sn_kind(ni);
    var name: pchar := self.sn_sVal(ni);
    var nlen: int64 := self.sn_sLen(ni);
    if (k == SNK_FUNC_DECL) {
      self._pushSym(name, nlen, SYM_FUNC, TY_VOID, ni);
    } else if (k == SNK_STRUCT_DECL) {
      self._pushSym(name, nlen, SYM_STRUCT, TY_USER, ni);
    } else if (k == SNK_TYPE_DECL) {
      self._pushSym(name, nlen, SYM_TYPE, TY_USER, ni);
    } else if (k == SNK_ENUM_DECL) {
      self._pushSym(name, nlen, SYM_ENUM, TY_USER, ni);
      // Register enum members as int64 constants
      var mem: int64 := self.sn_c0(ni);
      while (mem >= 0) {
        var mName: pchar := self.sn_sVal(mem);
        var mLen:  int64 := self.sn_sLen(mem);
        self._pushSym(mName, mLen, SYM_CON, TY_INT64, mem);
        mem := self.sn_next(mem);
      }
    } else if (k == SNK_GENERIC_DECL) {
      // WP-2.1: register generic function — type params in c0, body in c2
      self._pushSym(name, nlen, SYM_GENERIC_FUNC, TY_VOID, ni);
    } else if (k == SNK_CON_DECL) {
      self._pushSym(name, nlen, SYM_CON, TY_INT64, ni);
    } else if (k == SNK_VAR_DECL) {
      var typeNi: int64 := self.sn_c0(ni);
      var tid:    int64 := self.ResolveType(typeNi);
      self._pushSym(name, nlen, SYM_VAR, tid, ni);
    } else if (k == SNK_EXTERN_DATA) {
      // WSP-07: externes Daten-Symbol — als adress-typisierte Variable ohne
      // Initializer registrieren; IDENT-Auflösung + Typecheck laufen normal.
      var edTid: int64 := self.ResolveType(self.sn_c0(ni));
      self._pushSym(name, nlen, SYM_VAR, edTid, ni);
    } else if (k == SNK_IMPORT) {
      self._sema_processImport(name, nlen, ni);
    } else if (k == SNK_DIM_DECL) {
      self._pushSym(name, nlen, SYM_TYPE, TY_USER, ni);
    } else if (k == SNK_UTYPE_DECL) {
      self._pushSym(name, nlen, SYM_TYPE, TY_F64, ni);
    } else if (k == SNK_AT_IF) {
      self._pruneAtIf(ni);
      self._p1Decl(ni);  // recurse — ni is now SNK_BLOCK
    } else if (k == SNK_BLOCK) {  // inlined @if branch
      var child: int64 := self.sn_c0(ni);
      while (child >= 0) {
        self._p1Decl(child);
        child := self.sn_next(child);
      }
    }
  }

  fn Pass1(head: int64) {
    var ni: int64 := head;
    while (ni >= 0) {
      self._p1Decl(ni);
      ni := self.sn_next(ni);
    }
  }

  // ------------------------------------------------------------------
  // Pass 2: type-check expressions and statements
  // ------------------------------------------------------------------

  fn _checkExpr(ni: int64) {
    if (ni < 0) { return; }
    var k: int64 := self.sn_kind(ni);
    if (k == SNK_IDENT) {
      var nm: pchar := self.sn_sVal(ni);
      var nl: int64 := self.sn_sLen(ni);
      // 'self' keyword is always valid inside a method body
      if (nl == 4) {
        if (StrCharAt(nm, 0) == 115 && StrCharAt(nm, 1) == 101 &&
            StrCharAt(nm, 2) == 108 && StrCharAt(nm, 3) == 102) {
          return;
        }
      }
      var si: int64 := self.Lookup(nm, nl);
      if (si < 0) {
        self._errorNodeName("undefined symbol", ni, nm, nl);
      } else if (self.nestedBarrier >= 0) {
        // Verschachtelte Funktionen haben keinen Zugriff auf die Locals der
        // umgebenden Funktion: sie werden als gewöhnliche Funktionen emittiert
        // und bekommen keinen Static Link. Vorher lief das still falsch — der
        // Wert kam schlicht als 0 an. Lieber laut abbrechen als falsch rechnen.
        if (si >= self.globalSymCount && si < self.nestedBarrier) {
          self._errorNodeName("verschachtelte Funktion darf keine lokale Variable der umgebenden Funktion verwenden", ni, nm, nl);
        }
      }

    } else if (k == SNK_CALL) {
      var isMethod: int64 := self.sn_iVal(ni);
      if (isMethod == 1) {
        // Method call: obj.method(args) — check object, then args
        // BUG-6: Der Empfänger muss eine Instanz sein, kein Typname. `Pair.Method()`
        // wurde bisher stillschweigend akzeptiert und mit undefiniertem self
        // ausgeführt. Feldzugriff `Pair.second` (Byte-Offset) bleibt gültig — das ist
        // ein dokumentiertes Pattern und ein anderer Knoten (SNK_FIELD), hier greift
        // nur der Aufruf-Zweig.
        var recv: int64 := self.sn_c0(ni);
        if (recv >= 0 && self.sn_kind(recv) == SNK_IDENT) {
          var rnm: pchar := self.sn_sVal(recv);
          var rnl: int64 := self.sn_sLen(recv);
          var rsi: int64 := self.Lookup(rnm, rnl);
          if (rsi >= 0 && self.SymKind(rsi) == SYM_TYPE) {
            self._checkStaticMethodCall(ni, rsi, rnm, rnl);
          }
        }
        self._checkExpr(recv);
        var arg: int64 := self.sn_c1(ni);
        while (arg >= 0) { self._checkExpr(arg); arg := self.sn_next(arg); }
      } else {
        // Bare function call: fn(args) — check function name, then args
        var nm: pchar := self.sn_sVal(ni);
        var nl: int64 := self.sn_sLen(ni);
        var si: int64 := self.Lookup(nm, nl);
        if (si < 0) {
          self._errorNodeName("undefined function", ni, nm, nl);
        } else {
          // WP-L7: Caller-Cap-Prüfung für @uses_caller_cap-annotierte Funktionen
          self._checkCallerCap(ni, nm, nl);
          // WP-14: Check if this is a generic function call with type arguments
          // c2 contains type arguments (e.g., Foo<int64>(args))
          var namedHandled: int64 := 0;
          var typeArgs: int64 := self.sn_c2(ni);
          if (typeArgs >= 0) {
            // This is a generic call - resolve type arguments and check instantiation
            self._resolveGenericCall(nm, nl, typeArgs);
          }
          // WP-ARITY: Argument-Anzahl gegen Deklaration prüfen. Nur einfache User-/Extern-
          // Funktionen (SYM_FUNC), nicht-variadisch, nicht-generisch. Builtins (SYM_BUILTIN,
          // nodeIdx=-2), Methoden (eigener Zweig) und generische Calls bleiben außen vor.
          // Vorher fehlte JEDE Arity-Prüfung → zu wenige Args = Garbage/Crash (z.B. DNSResolve(1/4)).
          if (typeArgs < 0 && self.SymKind(si) == SYM_FUNC) {
            var declNi: int64 := self.SymNodeIdx(si);
            // declNi ist MODUL-RELATIV. Nur prüfen, wenn der Node im aktuellen Modul-Table
            // wirklich diese Funktion ist (Name-Match) — sonst cross-module-Garbage → überspringen.
            // Damit greift Arity-Check für same-module-Funktionen (häufigster Fehler); cross-module
            // (importierte stdlib) bleibt ungeprüft, aber ohne False-Positives.
            if (declNi >= 0 && self.sn_kind(declNi) == SNK_FUNC_DECL
                && self._strNEq(self.sn_sVal(declNi), self.sn_sLen(declNi), nm, nl)) {
              var variadic: int64 := (self.sn_iVal(declNi) >> 24) & 1;
              // extern fn (iVal bit0, FFI) hat abweichende/loose Param-Struktur → nicht prüfen.
              // Nur reguläre Lyx-Funktionen checken.
              var isExtern: int64 := self.sn_iVal(declNi) & 1;
              if (variadic == 0 && isExtern == 0) {
                var pc: int64 := 0; var pp: int64 := self.sn_c0(declNi);
                // #1089: Parameter mit Default-Wert (c1 des Parameterknotens)
                // duerfen fehlen. Der Codegen setzt sie laengst ein
                // (WP-MEM-05, cgDefFuncNi) -- die Arity-Pruefung hier wies den
                // Aufruf aber schon vorher ab, sodass die Deklaration ein
                // Angebot machte, das nie eingeloest wurde.
                //
                // Gezaehlt wird die MINDESTzahl: alle Parameter bis zum ersten
                // mit Default. Steht danach noch einer ohne, laesst er sich
                // nicht ueberspringen -- dann bleibt die Mindestzahl die volle.
                var pcMin: int64 := 0;
                var sawDefault: int64 := 0;
                while (pp >= 0) {
                  pc := pc + 1;
                  if (self.sn_c1(pp) >= 0) { sawDefault := 1; }
                  else { if (sawDefault == 0) { pcMin := pcMin + 1; } else { pcMin := pc; } }
                  pp := self.sn_next(pp);
                }
                var ac: int64 := 0; var aa: int64 := self.sn_c0(ni);
                while (aa >= 0) { ac := ac + 1; aa := self.sn_next(aa); }
                if (ac < pcMin || ac > pc) { self._errorNodeName("falsche Argument-Anzahl im Aufruf von", ni, nm, nl); }
                // #1087: Benannte Argumente in die Parameterreihenfolge bringen.
                else { self._reorderNamedArgs(ni, declNi, nm, nl); }
                namedHandled := 1;
              }
            }
          }
          // #1087: Laesst sich die Deklaration hier nicht heranziehen
          // (importiert, extern, variadisch, generisch, Builtin), koennen
          // benannte Argumente nicht zugeordnet werden. Sie stillschweigend
          // als positionell zu nehmen ist genau der gemeldete Fehler --
          // also melden. Ausnahme ist die eine eingebaute Sonderform
          // mmap(size:)/mmap(len:), die der Codegen kennt.
          if (namedHandled == 0 && self._hasNamedArg(ni) != 0) {
            var isMmapCall: int64 := 0;
            if (self._strNEq(nm, nl, "mmap"c, 4)) { isMmapCall := 1; }
            if (isMmapCall == 0) {
              self._errorNodeName("benannte Argumente werden fuer diesen Aufruf nicht unterstuetzt", ni, nm, nl);
            }
          }
        }
        var arg: int64 := self.sn_c0(ni);
        while (arg >= 0) { self._checkExpr(arg); arg := self.sn_next(arg); }
      }

    } else if (k == SNK_BINOP) {
      self._checkExpr(self.sn_c0(ni));
      self._checkExpr(self.sn_c1(ni));

    } else if (k == SNK_UNOP) {
      self._checkExpr(self.sn_c0(ni));

    } else if (k == SNK_INDEX) {
      self._checkExpr(self.sn_c0(ni));
      self._checkExpr(self.sn_c1(ni));
      self._checkIndexBounds(ni);   // #1156

    } else if (k == SNK_MATCH) {
      // match als Ausdruck: dieselbe Pruefung wie in Anweisungsposition.
      self._checkStmt(ni);

    } else if (k == SNK_FIELD) {
      // child0 = base object; field name is in sn_sVal (not a symbol ref)
      self._checkExpr(self.sn_c0(ni));
      self._checkFieldExists(ni);
      // WP-BC-22: visibility check when inside a class and base is 'self'
      var baseNi: int64 := self.sn_c0(ni);
      if (self.curClassNi >= 0 && baseNi >= 0 && self.sn_kind(baseNi) == SNK_IDENT) {
        var baseName: pchar := self.sn_sVal(baseNi);
        var baseLen:  int64 := self.sn_sLen(baseNi);
        var isSelf: int64 := 0;
        if (baseLen == 4) {
          if (StrCharAt(baseName, 0) == 115 && StrCharAt(baseName, 1) == 101 &&
              StrCharAt(baseName, 2) == 108 && StrCharAt(baseName, 3) == 102) { isSelf := 1; }
        }
        if (isSelf == 0) {
          // Non-self field access: find field in declaring class, check private
          var fldName: pchar := self.sn_sVal(ni);
          var fldLen:  int64 := self.sn_sLen(ni);
          var classFld: int64 := self.sn_c0(self.curClassNi);
          while (classFld >= 0) {
            if (self._strNEq(fldName, fldLen, self.sn_sVal(classFld), self.sn_sLen(classFld)) != 0) {
              var vis: int64 := (self.sn_iVal(classFld) >> 4) & 3;
              if (vis == 2) { self._errorNodeName("private field not accessible", ni, fldName, fldLen); }
              break;
            }
            classFld := self.sn_next(classFld);
          }
        }
      }

    } else if (k == SNK_NEW) {
      // WP-BC-20: error if instantiating abstract class
      var newName: pchar := self.sn_sVal(ni);
      var newLen:  int64 := self.sn_sLen(ni);
      var newSym:  int64 := self.Lookup(newName, newLen);
      if (newSym >= 0) {
        var newNi: int64 := self.SymNodeIdx(newSym);
        if (newNi >= 0) {
          var classAbstract: int64 := self.sn_iVal(newNi) & 1;
          if (classAbstract != 0) { self._errorNodeName("cannot instantiate abstract class", ni, newName, newLen); }
        }
      }
      // Check constructor arguments (child0 = first arg)
      var arg: int64 := self.sn_c0(ni);
      while (arg >= 0) { self._checkExpr(arg); arg := self.sn_next(arg); }

    } else if (k == SNK_CAST) {
      // WP-11: x as Type — check source expression and target type
      self._checkExpr(self.sn_c0(ni));
      var typeNode: int64 := self.sn_c1(ni);
      if (typeNode >= 0) {
        var castTid: int64 := self.ResolveType(typeNode);
        self._logConstraint(TY_UNKNOWN, castTid, "cast"c, ni);
      }

    } else if (k == SNK_CLOSURE) {
      // WP-02: anonymous function expression: fn(params): rettype { body }
      // c0 = param list, c1 = return type, c2 = body block
      self._pushScope();
      var param: int64 := self.sn_c0(ni);
      while (param >= 0) {
        var typeNi: int64 := self.sn_c0(param);
        var tid: int64 := self.ResolveType(typeNi);
        self._pushSym(self.sn_sVal(param), self.sn_sLen(param), SYM_PARAM, tid, param);
        param := self.sn_next(param);
      }
      var body: int64 := self.sn_c2(ni);
      if (body >= 0) { self._checkStmt(body); }
      self._popScope();

    } else if (k == SNK_FN_PTR) {
      // Function pointer literal — check function reference
      var fnRef: int64 := self.sn_c0(ni);
      if (fnRef >= 0 && self.sn_kind(fnRef) == SNK_IDENT) {
        var nm: pchar := self.sn_sVal(fnRef);
        var nl: int64 := self.sn_sLen(fnRef);
        var si: int64 := self.Lookup(nm, nl);
        if (si < 0) {
          self._errorNodeName("undefined function for fn ptr", ni, nm, nl);
        } else {
          self._checkFnPtrUcc(fnRef);  // WP-L7: Warnung bei UCC-annotierten Fn-Ptr
        }
      }

    } else if (k == SNK_IS_EXPR) {
      // WP-16: x is Type — check object and type
      self._checkExpr(self.sn_c0(ni));
      var typeNode: int64 := self.sn_c1(ni);
      if (typeNode >= 0) {
        self.ResolveType(typeNode);
      }

    } else if (k == SNK_SUPER_CALL) {
      // WP-10a: super.method() — check method call in parent class context
      var arg: int64 := self.sn_c0(ni);
      while (arg >= 0) { self._checkExpr(arg); arg := self.sn_next(arg); }

    } else if (k == SNK_RANGE) {
      // Range expression: start to/downto end
      self._checkExpr(self.sn_c0(ni));
      self._checkExpr(self.sn_c1(ni));

    } else if (k == SNK_MAP_LIT) {
      // { key: val, ... } — check each entry's key and value
      var entry: int64 := self.sn_c0(ni);
      while (entry >= 0) {
        self._checkExpr(self.sn_c0(entry));
        self._checkExpr(self.sn_c1(entry));
        entry := self.sn_next(entry);
      }

    } else if (k == SNK_SET_LIT) {
      // { val, ... } — check each element
      var elem: int64 := self.sn_c0(ni);
      while (elem >= 0) {
        self._checkExpr(elem);
        elem := self.sn_next(elem);
      }

    } else if (k == SNK_IN_EXPR) {
      // lhs in rhs — check both sides
      self._checkExpr(self.sn_c0(ni));
      self._checkExpr(self.sn_c1(ni));
    } else if (k == SNK_SIMD_NEW) {
      // parallel Array<T>(size) — check size expression (c1); type arg in c0
      self._checkExpr(self.sn_c1(ni));
    }
    // Literals, NK_LIT_NULL, NK_INVALID: nothing to check
  }

  // WP-2.2-C: Return 1 if a case body (SNK_BLOCK) ends with an explicit terminator:
  // break, return, throw, continue, or panic. Recurse into nested ifs where ALL
  // branches terminate. Empty blocks return 0 (treated as potentially falling through).
  fn _caseBodyTerminates(bodyNi: int64): int64 {
    if (bodyNi < 0) { return 0; }
    var k: int64 := self.sn_kind(bodyNi);
    // Direct terminators
    if (k == SNK_BREAK)    { return 1; }
    if (k == SNK_RETURN)   { return 1; }
    if (k == SNK_THROW)    { return 1; }
    if (k == SNK_CONTINUE) { return 1; }
    if (k == SNK_PANIC)    { return 1; }
    if (k != SNK_BLOCK) { return 0; }
    // It's a block — find the last statement
    var stmt: int64 := self.sn_c0(bodyNi);
    if (stmt < 0) { return 0; }  // empty block
    var last: int64 := stmt;
    while (self.sn_next(last) >= 0) { last := self.sn_next(last); }
    var lk: int64 := self.sn_kind(last);
    if (lk == SNK_BREAK)    { return 1; }
    if (lk == SNK_RETURN)   { return 1; }
    if (lk == SNK_THROW)    { return 1; }
    if (lk == SNK_CONTINUE) { return 1; }
    if (lk == SNK_PANIC)    { return 1; }
    // Nested block: recurse
    if (lk == SNK_BLOCK) { return self._caseBodyTerminates(last); }
    // If with else: both branches must terminate
    if (lk == SNK_IF) {
      var elseBlock: int64 := self.sn_c2(last);
      if (elseBlock < 0) { return 0; }  // if without else: might not terminate
      var thenOk: int64 := self._caseBodyTerminates(self.sn_c1(last));
      var elseOk: int64 := self._caseBodyTerminates(elseBlock);
      if (thenOk != 0 && elseOk != 0) { return 1; }
      return 0;
    }
    return 0;
  }

  fn _checkStmt(ni: int64) {
    if (ni < 0) { return; }
    var k: int64 := self.sn_kind(ni);

    if (k == SNK_BLOCK) {
      self._pushScope();
      // Verschachtelte `fn`-Deklarationen VOR den übrigen Statements registrieren.
      // NestedFnDecl steht in der EBNF, aber Pass1 läuft nur über die oberste
      // Ebene — der Name war deshalb nie in der Symboltabelle und jeder Aufruf
      // scheiterte an "undefined function". Vorab registrieren heißt zugleich:
      // Aufrufe vor der Deklaration und gegenseitige Aufrufe funktionieren.
      var pre: int64 := self.sn_c0(ni);
      while (pre >= 0) {
        if (self.sn_kind(pre) == SNK_FUNC_DECL) {
          self._pushSym(self.sn_sVal(pre), self.sn_sLen(pre), SYM_FUNC, TY_VOID, pre);
        }
        pre := self.sn_next(pre);
      }
      var s: int64 := self.sn_c0(ni);
      while (s >= 0) { self._checkStmt(s); s := self.sn_next(s); }
      self._popScope();

    } else if (k == SNK_FUNC_DECL) {
      // Verschachtelte Funktion: Rumpf prüfen. Vorher übersprang sema ihn ganz,
      // Fehler darin fielen erst im Codegen auf ("no codegen implementation").
      // `nestedBarrier` markiert die Symbolgrenze: alles, was oberhalb der
      // globalen Symbole und unterhalb dieser Marke liegt, ist ein Local der
      // umgebenden Funktion und für die verschachtelte tabu.
      var savedBarrier: int64 := self.nestedBarrier;
      self.nestedBarrier := self.symCount;
      self._checkFuncDecl(ni);
      self.nestedBarrier := savedBarrier;

    } else if (k == SNK_ASM) {
      // WSP-05: Inline-Assembly — Mnemonic-Strings, keine sema-Prüfung (Codegen validiert).

    } else if (k == SNK_VAR_DECL) {
      // BUG-8: reject 'self' as a variable name (reserved keyword in class methods)
      if self._strNEq(self.sn_sVal(ni), self.sn_sLen(ni), "self"c, 4) {
        self._errorNode("'self' is a reserved keyword and cannot be used as a variable name", ni);
      }
      var typeNi: int64 := self.sn_c0(ni);
      var initNi: int64 := self.sn_c1(ni);
      var tid: int64 := self.ResolveType(typeNi);
      if (tid == TY_UNKNOWN) {
        self._errorNodeName("unknown type in var decl", ni, self.sn_sVal(typeNi), self.sn_sLen(typeNi));
      }
      self._logReason("var-decl", ni, tid);
      if (initNi >= 0) {
        self._checkExpr(initNi);
        self._logConstraint(tid, TY_UNKNOWN, "var-init"c, ni);
        // #1082: Bereichstyp -- konstante Initialisierung sofort pruefen.
        self._checkRangeAssign(typeNi, initNi, initNi);
      }
      var varSi: int64 := self.symCount;
      self._pushSym(self.sn_sVal(ni), self.sn_sLen(ni), SYM_VAR, tid, ni);
      // WP-AS-18: propagate @volatile flag into symbol entry
      if ((self.sn_iVal(ni) & SEMA_VAR_FLAG_VOLATILE) != 0) {
        self.SetSymVolatile(varSi, 1);
      }

    } else if (k == SNK_CON_DECL) {
      var initNi: int64 := self.sn_c1(ni);
      if (initNi >= 0) { self._checkExpr(initNi); }
      self._pushSym(self.sn_sVal(ni), self.sn_sLen(ni), SYM_CON, TY_INT64, ni);

    } else if (k == SNK_ASSIGN) {
      // WP-AS-13: reject assignments to con-qualified parameters
      var lval: int64 := self.sn_c0(ni);
      if (self.sn_kind(lval) == SNK_IDENT) {
        var si: int64 := self.Lookup(self.sn_sVal(lval), self.sn_sLen(lval));
        if (si >= 0 && self.SymKind(si) == SYM_PARAM) {
          var paramNi: int64 := self.SymNodeIdx(si);
          if (paramNi >= 0 && (self.sn_iVal(paramNi) & SEMA_PARAM_FLAG_CON) != 0) {
            self._errorNodeName("assignment to con-parameter not allowed", ni, self.sn_sVal(lval), self.sn_sLen(lval));
          }
        }
      }
      self._checkExpr(self.sn_c0(ni));
      self._checkExpr(self.sn_c1(ni));
      // #1083: `let` und `co` binden einmal. Eine Zuweisung danach ist ein
      // Fehler -- bis 1.0.11D ging sie kommentarlos durch, `let` trug den
      // Schutz also nur im Namen. examples/basics/variables.lyx fuehrte die
      // Zeile sogar als Kommentar mit dem Vermerk "Wuerde einen Fehler
      // erzeugen!".
      if (self.sn_kind(lval) == SNK_IDENT) {
        var rosi: int64 := self.Lookup(self.sn_sVal(lval), self.sn_sLen(lval));
        if (rosi >= 0 && self.SymKind(rosi) == SYM_VAR) {
          var rodecl: int64 := self.SymNodeIdx(rosi);
          if (rodecl >= 0 && (self.sn_iVal(rodecl) & SEMA_VAR_FLAG_READONLY) != 0) {
            self._errorNodeName("assignment to let/co binding not allowed", ni, self.sn_sVal(lval), self.sn_sLen(lval));
          }
        }
      }
      // #1082: Zuweisung an eine Variable mit Bereichstyp -- konstante
      // rechte Seite sofort pruefen.
      if (self.sn_kind(lval) == SNK_IDENT) {
        var asi: int64 := self.Lookup(self.sn_sVal(lval), self.sn_sLen(lval));
        if (asi >= 0) {
          var adecl: int64 := self.SymNodeIdx(asi);
          if (adecl >= 0) {
            self._checkRangeAssign(self.sn_c0(adecl), self.sn_c1(ni), self.sn_c1(ni));
          }
        }
      }

    } else if (k == SNK_RETURN) {
      self._checkExpr(self.sn_c0(ni));

    } else if (k == SNK_EXPR_STMT) {
      self._checkExpr(self.sn_c0(ni));

    } else if (k == SNK_IF) {
      var ifCondNi: int64 := self.sn_c0(ni);
      // R2: dead-branch elimination — if condition is a compile-time constant
      // (e.g. TARGET_WINDOWS, TARGET_LINUX), only check the live branch.
      var ifFolded: int64 := 0;
      if self.sn_kind(ifCondNi) == SNK_IDENT {
        var ifNm: pchar := self.sn_sVal(ifCondNi);
        var ifNl: int64 := self.sn_sLen(ifCondNi);
        var ifSi: int64 := self.Lookup(ifNm, ifNl);
        if ifSi >= 0 && self.SymKind(ifSi) == SYM_CON {
          var ifCv: int64 := self._lookupConst(ifNm, ifNl);
          if ifCv != 0 {
            self._checkStmt(self.sn_c1(ni));
          } else {
            self._checkStmt(self.sn_c2(ni));
          }
          ifFolded := 1;
        }
      }
      if ifFolded == 0 {
        self._checkExpr(ifCondNi);
        self._checkStmt(self.sn_c1(ni));
        self._checkStmt(self.sn_c2(ni));
      }

    } else if (k == SNK_WHILE) {
      self._checkExpr(self.sn_c0(ni));   // condition
      self._checkStmt(self.sn_c1(ni));   // body

    } else if (k == SNK_REPEAT_UNTIL) {
      self._checkStmt(self.sn_c0(ni));   // body
      self._checkExpr(self.sn_c1(ni));   // condition

    } else if (k == SNK_TUPLE_VAR_DECL) {
      // var a, b := fn() — check init, push both names as int64 locals
      self._checkExpr(self.sn_c1(ni));   // init expr
      self._pushSym(self.sn_sVal(ni), self.sn_sLen(ni), SYM_VAR, TY_INT64, ni);
      var secondNode: int64 := self.sn_c0(ni);
      if (secondNode >= 0) {
        self._pushSym(self.sn_sVal(secondNode), self.sn_sLen(secondNode), SYM_VAR, TY_INT64, ni);
      }

    } else if (k == SNK_FOR) {
      // for VAR = start to end { body }
      // sn_sVal = loop var name, c0 = start, c1 = end, c2 = body
      self._pushScope();
      self._checkExpr(self.sn_c0(ni));
      self._checkExpr(self.sn_c1(ni));
      self._pushSym(self.sn_sVal(ni), self.sn_sLen(ni), SYM_VAR, TY_INT64, ni);
      self._checkStmt(self.sn_c2(ni));
      self._popScope();

    } else if (k == SNK_FOR_RANGE) {
      // WP-1.1-A: for i in range([start,] stop) { body } — stop is exclusive
      // Same scope/type semantics as SNK_FOR
      self._pushScope();
      self._checkExpr(self.sn_c0(ni));   // start
      self._checkExpr(self.sn_c1(ni));   // stop
      self._pushSym(self.sn_sVal(ni), self.sn_sLen(ni), SYM_VAR, TY_INT64, ni);
      self._checkStmt(self.sn_c2(ni));   // body
      self._popScope();

    } else if (k == SNK_FOR_C) {
      // for i := 0; cond; step { body }
      // c0=NK_VAR_DECL (declares loop var), c1=cond, c2=step, c3=body
      self._pushScope();
      self._checkStmt(self.sn_c0(ni));
      if (self.sn_c1(ni) >= 0) { self._checkExpr(self.sn_c1(ni)); }
      if (self.sn_c2(ni) >= 0) { self._checkStmt(self.sn_c2(ni)); }
      self._checkStmt(self.sn_c3(ni));
      self._popScope();

    } else if (k == SNK_SWITCH) {
      // c0 = discriminant, c1 = first case (sn_next-linked)
      self._checkExpr(self.sn_c0(ni));
      var c: int64 := self.sn_c1(ni);
      while (c >= 0) {
        // WP-2.2-C: check each case for fallthrough (body must terminate)
        if (self.sn_iVal(c) == 0) { self._checkExpr(self.sn_c0(c)); }
        var body: int64 := self.sn_c1(c);
        self._checkStmt(body);
        if (self._caseBodyTerminates(body) == 0) {
          self._errorNode("switch case may fall through; add 'break' or 'return'"c, c);
        }
        c := self.sn_next(c);
      }

    } else if (k == SNK_CASE) {
      // iVal = isDefault; c0 = value expr (or -1); c1 = body
      // (Individual SNK_CASE nodes are also checked here when traversed outside SNK_SWITCH)
      if (self.sn_iVal(ni) == 0) { self._checkExpr(self.sn_c0(ni)); }
      self._checkStmt(self.sn_c1(ni));

    } else if (k == SNK_DISPOSE) {
      self._checkExpr(self.sn_c0(ni));

    // WP-BC-07: assert(cond)
    } else if (k == SNK_ASSERT) {
      self._checkExpr(self.sn_c0(ni));   // condition

    // WP-BC-09: pool { stmt* }
    } else if (k == SNK_POOL) {
      self._checkStmt(self.sn_c0(ni));   // body block

    // WP-BC-10: panic(msg) — type is never, any message expr accepted
    } else if (k == SNK_PANIC) {
      self._checkExpr(self.sn_c0(ni));   // message expression

    // WP-12: Exception handling
    } else if (k == SNK_TRY) {
      // c0 = try block, c1 = catch chain, c2 = finally block
      self._checkStmt(self.sn_c0(ni));
      var cat: int64 := self.sn_c1(ni);
      while (cat >= 0) { self._checkStmt(cat); cat := self.sn_next(cat); }
      if (self.sn_c2(ni) >= 0) { self._checkStmt(self.sn_c2(ni)); }
    } else if (k == SNK_CATCH) {
      // c0 = catch block
      self._checkStmt(self.sn_c0(ni));
    // WP-15: Pattern matching
    } else if (k == SNK_MATCH) {
      // c0 = discriminant, c1 = cases (sn_next-linked)
      var discrim: int64 := self.sn_c0(ni);
      self._checkExpr(discrim);
      var mc: int64 := self.sn_c1(ni);
      var caseCount: int64 := 0;
      var hasWildcard: int64 := 0;
      while (mc >= 0) {
        var patNode: int64 := self.sn_c0(mc);
        var bodyNode: int64 := self.sn_c1(mc);
        var guardNode: int64 := self.sn_c2(mc);
        if (guardNode >= 0) { self._checkExpr(guardNode); }
        var patKind: int64 := self.sn_kind(patNode);
        if (patKind == SNK_PATTERN_OR) {
          var lp: int64 := self.sn_c0(patNode);
          var rp: int64 := self.sn_c1(patNode);
          if (lp >= 0) { self._checkExpr(lp); }
          if (rp >= 0) { self._checkExpr(rp); }
        } else if (patKind == SNK_PATTERN_WILD) {
          hasWildcard := 1;
        } else if (patKind == SNK_PATTERN_BIND) {
          var innerPat: int64 := self.sn_c0(patNode);
          if (innerPat >= 0) { self._checkStmt(innerPat); }
          hasWildcard := 1;  // binding pattern covers all values
        } else if (patKind == SNK_PATTERN_ENUM) {
          var variantName: pchar := self.sn_sVal(patNode);
          var variantLen: int64 := self.sn_sLen(patNode);
          var variantSym: int64 := self.Lookup(variantName, variantLen);
          if (variantSym >= 0) {
            if (self.SymKind(variantSym) != SYM_CON) {
              self._errorNodeName("enum pattern: not a valid enum variant"c, patNode, variantName, variantLen);
            }
          } else {
            self._errorNodeName("enum pattern: variant not found"c, patNode, variantName, variantLen);
          }
        } else if (patKind == SNK_PATTERN_STRUCT) {
          var structTypeName: pchar := self.sn_sVal(patNode);
          var structTypeLen: int64 := self.sn_sLen(patNode);
          var structSym: int64 := self.Lookup(structTypeName, structTypeLen);
          if (structSym >= 0) {
            var structSymKind: int64 := self.SymKind(structSym);
            if (structSymKind != SYM_STRUCT && structSymKind != SYM_TYPE) {
              self._errorNodeName("struct pattern: not a struct type"c, patNode, structTypeName, structTypeLen);
            }
          } else {
            self._errorNodeName("struct pattern: type not found"c, patNode, structTypeName, structTypeLen);
          }
          // #1104: Feldmuster. Der Wert eines Feldes ist entweder ein
          // Vergleich (Literal, `con`) oder eine BINDUNG -- ein Name, der
          // hier erst entsteht. Als Ausdruck geprueft, meldete die Bindung
          // "undefined symbol"; das Muster war damit auf Vergleiche
          // beschraenkt, ohne dass das irgendwo stand.
          var fieldPat: int64 := self.sn_c0(patNode);
          while (fieldPat >= 0) {
            var inner: int64 := self.sn_c0(fieldPat);
            var isBind: int64 := 0;
            if (inner >= 0 && self.sn_kind(inner) == SNK_IDENT) {
              var bn: pchar := self.sn_sVal(inner);
              var bl: int64 := self.sn_sLen(inner);
              if (self.Lookup(bn, bl) < 0) {
                self._pushSym(bn, bl, SYM_VAR, TY_INT64, inner);
                isBind := 1;
              }
            }
            if (isBind == 0) { self._checkStmt(fieldPat); }
            fieldPat := self.sn_next(fieldPat);
          }
        }
        self._checkStmt(bodyNode);
        caseCount += 1;
        mc := self.sn_next(mc);
      }
      if (caseCount == 0) { self._errorNode("match expression has no cases"c, ni); }

      // WP-2.2-A: Exhaustiveness check for enum discriminants.
      // Only triggered when the discriminant is an identifier of enum type
      // and no wildcard/binding case was found.
      if (hasWildcard == 0 && self.sn_kind(discrim) == SNK_IDENT) {
        var enumDecl: int64 := self._findEnumDeclForIdent(discrim);
        if (enumDecl >= 0) {
          // Walk every declared enum member and verify coverage
          var mem: int64 := self.sn_c0(enumDecl);
          while (mem >= 0) {
            var mName: pchar := self.sn_sVal(mem);
            var mLen:  int64 := self.sn_sLen(mem);
            var covered: int64 := 0;
            var mc3: int64 := self.sn_c1(ni);
            while (mc3 >= 0 && covered == 0) {
              var pat3: int64 := self.sn_c0(mc3);
              var pk3: int64 := self.sn_kind(pat3);
              if (pk3 == SNK_PATTERN_ENUM || pk3 == SNK_PATTERN_LIT) {
                if (self._strNEq(self.sn_sVal(pat3), self.sn_sLen(pat3), mName, mLen) != 0) {
                  covered := 1;
                }
              } else if (pk3 == SNK_PATTERN_OR) {
                // Or-pattern: check both sides
                var lp3: int64 := self.sn_c0(pat3);
                var rp3: int64 := self.sn_c1(pat3);
                if (lp3 >= 0 && self._strNEq(self.sn_sVal(lp3), self.sn_sLen(lp3), mName, mLen) != 0) { covered := 1; }
                if (rp3 >= 0 && self._strNEq(self.sn_sVal(rp3), self.sn_sLen(rp3), mName, mLen) != 0) { covered := 1; }
              }
              mc3 := self.sn_next(mc3);
            }
            if (covered == 0) {
              // Report error with variant name included
              var tokIdx: int64 := self.sn_tokIdx(ni);
              var line: int64 := 0;
              if (tokIdx >= 0 && tokIdx < self.pTokCount) { line := self.sn_tokLine(tokIdx); }
              PrintStr("sema error (line "c);
              PrintInt(line);
              PrintStr("): match does not cover variant '"c);
              self._printSrcName(mName, mLen);
              PrintStr("' — add a case or a wildcard _ => { ... }\n"c);
              self.hadError   := 1;
              self.errorCount += 1;
            }
            mem := self.sn_next(mem);
          }
        }
      }
    } else if (k == SNK_MATCH_CASE) {
      // c0 = pattern, c1 = body
      self._checkStmt(self.sn_c1(ni));
    } else if (k == SNK_FINALLY) {
      // c0 = finally block
      self._checkStmt(self.sn_c0(ni));
    } else if (k == SNK_THROW) {
      // c0 = thrown expression
      self._checkExpr(self.sn_c0(ni));
    // WP-16: isType expression (x is Type)
    } else if (k == SNK_IS_EXPR) {
      // c0 = expression, c1 = type to check
      self._checkExpr(self.sn_c0(ni));
      var checkType: int64 := self.ResolveType(self.sn_c1(ni));
      if (checkType == TY_UNKNOWN) {
        self._errorNodeName("unknown type in is expression", ni, self.sn_sVal(self.sn_c1(ni)), self.sn_sLen(self.sn_c1(ni)));
      }
    // WP-17: Range expression (1..100)
    // WP-BC-13: format expression expr:width[:decimals]
    } else if (k == SNK_FORMAT_EXPR) {
      self._checkExpr(self.sn_c0(ni));   // inner expression

    // WP-BC-14: null coalescing x ?? fallback
    } else if (k == SNK_NULL_COAL) {
      self._checkExpr(self.sn_c0(ni));   // nullable expression
      self._checkExpr(self.sn_c1(ni));   // fallback expression

    // WP-BC-14: safe cast x as? T
    } else if (k == SNK_SAFE_CAST) {
      self._checkExpr(self.sn_c0(ni));   // source expression

    } else if (k == SNK_RANGE) {
      // c0 = start, c1 = end
      self._checkExpr(self.sn_c0(ni));
      self._checkExpr(self.sn_c1(ni));
      // Range result type is TY_RANGE
    // WP-17: Where clause (type constraint)
    } else if (k == SNK_WHERE) {
      // c0 = base type, c1 = constraint expression
      var baseType: int64 := self.ResolveType(self.sn_c0(ni));
      self._checkExpr(self.sn_c0(ni));  // check base type
      self._checkExpr(self.sn_c1(ni));  // check constraint
      
      // WP-17: Validate constraint expression is a boolean comparison
      // For simple constraints like "value >= 0 && value <= 65535"
      // we can emit runtime assertions
      var constrKind: int64 := self.sn_kind(self.sn_c1(ni));
      if (constrKind != SNK_BINOP) {
        self._errorNode("where constraint must be a boolean expression", self.sn_c1(ni));
      }
      // Check that the constraint uses the 'value' keyword
      // (This is a simplified check - full implementation would analyze the constraint tree)
    } else if (k == SNK_AT_IF) {  // statement-level @if
      self._pruneAtIf(ni);
      self._checkStmt(ni);  // recurse — ni is now SNK_BLOCK, handled above

    } else if (k == SNK_AT_DIRECTIVE) {  // @io_check / @overflow_check / WP-AS-03
      var kind: int64 := self.sn_iVal(ni);
      var val:  int64 := self.sn_c0(ni);
      if (kind == 0) { self.ioCheckEnabled       := val; }
      if (kind == 1) { self.overflowCheckEnabled := val; }
      if (kind == 2) { self.boundsCheckEnabled   := val; }  // WP-AS-03
      if (kind == 3) { self.debugInfoEnabled     := val; }  // WP-AS-03
      if (kind == 4) { self.optLevel             := val; }  // WP-AS-03
    } else if (k == SNK_AT_ENERGY) {  // WP-EN-03: @energy(N); statement
      self.energyLevel := self.sn_iVal(ni);  // node stays in AST for codegen
    } else if (k == SNK_DEFER) {
      // WP-2.2-B: defer — type-check the inner statement; reject nested defer
      var inner: int64 := self.sn_c0(ni);
      if (inner >= 0 && self.sn_kind(inner) == SNK_DEFER) {
        self._errorNode("defer defer is not allowed"c, ni);
      } else {
        self._checkStmt(inner);
      }
    }
    // NK_BREAK, NK_IMPORT: nothing to check
  }

  // WP-L2: Validiert @capabilities([...]) oder @uses_caller_cap([...]) AST-Knoten.
  fn _checkCapabilityAttr(ni: int64): void {
    var capReg: CapabilityRegistry;
    capReg.Init();

    if self.sn_iVal(ni) == 1 { return; }

    var capDecl: int64 := self.sn_c0(ni);
    while capDecl >= 0 {
      var path: pchar    := self.sn_sVal(capDecl);
      var pathLen: int64 := self.sn_sLen(capDecl);
      var capId: int64   := capReg.LookupId(path, pathLen);

      if !capReg.IsKnown(capId) {
        self._errorNode("unbekannte Capability"c, capDecl);
      } else {
        var argNode: int64 := self.sn_c0(capDecl);
        while argNode >= 0 {
          var argKey: pchar    := self.sn_sVal(argNode);
          var argKeyLen: int64 := self.sn_sLen(argNode);
          var valNode: int64   := self.sn_c0(argNode);
          // #1108: Der Argumentname wird jetzt geprueft — fuer JEDEN Wert, nicht
          // nur fuer Ganzzahlen. Bis 1.0.13B sah nur die Wertebereichspruefung
          // hin, und die kannte Zeichenketten gar nicht: `fs.read(pfad: "/tmp")`
          // lief kommentarlos durch.
          if capReg.IsKnownArg(capId, argKey, argKeyLen) == 0 {
            if capReg.TakesArgs(capId) == 0 {
              self._errorNode("diese Capability nimmt keine Argumente"c, argNode);
            } else {
              self._errorNode("unbekanntes Capability-Argument"c, argNode);
            }
          } else {
            // #1108: Der Name stimmt — die Angabe bleibt aber folgenlos. Die
            // Sandbox setzt Capabilities als Ja/Nein durch (seccomp-Syscallfilter
            // plus eine Landlock-Regel fuer "/"), nicht als Einschraenkung auf
            // den genannten Pfad, Rechner oder Port. Eine Annotation, die eine
            // Beschraenkung ausdrueckt und sie nicht einhaelt, erzeugt eine
            // Sicherheitszusage, die es nicht gibt — dasselbe Muster wie bei den
            // Safety-Attributen in #1099, also dieselbe Antwort: melden.
            self._warnNode("Capability-Argument wird NICHT durchgesetzt — die Capability wirkt als Ja/Nein (#1108)"c, argNode);
          }
          if valNode >= 0 && self.sn_kind(valNode) == SNK_LIT_INT_CAP {
            var argVal: int64 := self.sn_iVal(valNode);
            var errMsg: pchar  := capReg.ValidateArg(capId, argKey, argKeyLen, argVal);
            if errMsg != 0 as pchar {
              self._errorNode(errMsg, argNode);
            }
          }
          argNode := self.sn_next(argNode);
        }
      }
      capDecl := self.sn_next(capDecl);
    }
  }

  // WP-L3: djb2-Hash eines längengebundenen Strings (für paramFp-Berechnung)
  fn _djb2N(s: pchar, len: int64): int64 {
    var h: int64 := 5381;
    var i: int64 := 0;
    while i < len {
      h := h * 33 + StrCharAt(s, i);
      i += 1;
    }
    return h;
  }

  // WP-L3: Berechnet paramFp = Hash der Argumente eines NK_CAPABILITY_DECL-Knotens.
  // argHead: erster NK_CAPABILITY_ARG-Knoten (sn_c0 des NK_CAPABILITY_DECL).
  // Gibt 0 zurück wenn keine Argumente vorhanden.
  fn _hashCapArgs(argHead: int64): int64 {
    if argHead < 0 { return 0; }
    var h: int64 := 5381;
    var argNode: int64 := argHead;
    while argNode >= 0 {
      // Hash den Schlüsselnamen
      var keyPtr: pchar  := self.sn_sVal(argNode);
      var keyLen: int64  := self.sn_sLen(argNode);
      var ki: int64 := 0;
      while ki < keyLen {
        h := h * 33 + StrCharAt(keyPtr, ki);
        ki += 1;
      }
      h := h * 33 + 58;  // ':'
      // Hash den Wert-Knoten
      var valNode: int64 := self.sn_c0(argNode);
      if valNode >= 0 {
        var vk: int64 := self.sn_kind(valNode);
        if vk == SNK_LIT_INT_CAP {
          // Integer-Wert direkt hashen
          var iv: int64 := self.sn_iVal(valNode);
          h := h * 33 + iv;
        } else if vk == SNK_LIT_STR_CAP || vk == SNK_IDENT_CAP {
          var vPtr: pchar := self.sn_sVal(valNode);
          var vLen: int64 := self.sn_sLen(valNode);
          var vi: int64 := 0;
          while vi < vLen {
            h := h * 33 + StrCharAt(vPtr, vi);
            vi += 1;
          }
        } else if vk == SNK_NETWORK_TARGET_CAP {
          // Adress-String + Port
          var vPtr: pchar := self.sn_sVal(valNode);
          var vLen: int64 := self.sn_sLen(valNode);
          var vi: int64 := 0;
          while vi < vLen {
            h := h * 33 + StrCharAt(vPtr, vi);
            vi += 1;
          }
          h := h * 33 + self.sn_iVal(valNode);
        }
      }
      argNode := self.sn_next(argNode);
    }
    return h;
  }

  // WP-L3: Füllt ein CapSet aus einer NK_CAPABILITY_DECL-Kette.
  // declHead: erster NK_CAPABILITY_DECL-Knoten.
  fn _fillCapSet(declHead: int64, set: CapSet): void {
    var reg: CapabilityRegistry;
    reg.Init();
    var cur: int64 := declHead;
    while cur >= 0 {
      var path: pchar    := self.sn_sVal(cur);
      var pathLen: int64 := self.sn_sLen(cur);
      var capId: int64   := reg.LookupId(path, pathLen);
      if capId >= 0 {
        var fp: int64 := self._hashCapArgs(self.sn_c0(cur));
        set.Add(capId, fp);
      }
      cur := self.sn_next(cur);
    }
  }

  // WP-L3: Füllt currModuleCaps aus allen NK_CAPABILITY_ATTR-Knoten im AST.
  fn _collectParentCaps(head: int64): void {
    self.currModuleCaps.Clear();
    var ni: int64 := head;
    while ni >= 0 {
      if self.sn_kind(ni) == SNK_CAPABILITY_ATTR && self.sn_iVal(ni) == 0 {
        self._fillCapSet(self.sn_c0(ni), self.currModuleCaps);
      }
      ni := self.sn_next(ni);
    }
  }

  // WP-L3: Speichert die Capabilities eines importierten Moduls im Cache.
  fn _cacheImportCaps(modName: pchar, modLen: int64, set: CapSet): void {
    if self.importCapCount >= self.importCapCap {
      var newCap: int64 := self.importCapCap * 2;
      var nb: int64 := alloc(newCap * 16);
      memcpy(nb, self.importCapCache, self.importCapCount * 16);
      free(self.importCapCache, self.importCapCap * 16);
      self.importCapCache := nb;
      self.importCapCap   := newCap;
    }
    var hash: int64 := self._djb2N(modName, modLen);
    var off:  int64 := self.importCapCache + self.importCapCount * 16;
    poke64(off,     hash);
    poke64(off + 8, set as int64);
    self.importCapCount += 1;
  }

  // WP-L3: Sucht C(M_decl) im Cache; Rückgabe: CapSet-Zeiger oder 0.
  fn _lookupImportCaps(modName: pchar, modLen: int64): CapSet {
    var hash: int64 := self._djb2N(modName, modLen);
    var i: int64 := 0;
    while i < self.importCapCount {
      var off: int64 := self.importCapCache + i * 16;
      if peek64(off) == hash {
        return peek64(off + 8) as CapSet;
      }
      i += 1;
    }
    return 0 as CapSet;
  }

  // WP-L6: Entscheidet ob ein importiertes Modul gepruned werden soll.
  // Nutzt direkte peek64-Zugriffe auf den CapSet-Puffer (kein VMT-Dispatch).
  // importedEntries: CapSet.entries-Puffer, importedCount: Anzahl Einträge.
  fn _shouldStripModule(importedEntries: int64, importedCount: int64): bool {
    return cap_shouldStrip(
      importedEntries, importedCount,
      self.currModuleCaps.entries, self.currModuleCaps.count);
  }

  // WP-L3: Hauptvalidierungspass — wird nach Pass1+Pass2 aufgerufen.
  // Phase 1: C(P) aus @capabilities-Annotation sammeln.
  // Phase 2: Imports gegen Vererbungsregeln prüfen.
  fn _checkCapabilityInheritance(head: int64): void {
    // Phase 1: C(P) aus @capabilities-Knoten sammeln
    self._collectParentCaps(head);

    // Phase 2: jeden NK_IMPORT-Knoten validieren
    var resolver: CapabilityResolver;
    resolver.Init();
    var effectiveCaps: CapSet := new CapSet();
    effectiveCaps.Init();

    var ni: int64 := head;
    while ni >= 0 {
      if self.sn_kind(ni) == SNK_IMPORT {
        var modName: pchar  := self.sn_sVal(ni);
        var modLen: int64   := self.sn_sLen(ni);
        var grantNi: int64  := self.sn_c1(ni);
        var restrictNi: int64 := self.sn_c2(ni);

        var moduleDecl: CapSet := self._lookupImportCaps(modName, modLen);
        var hasGrant: bool := grantNi >= 0 && self.sn_kind(grantNi) == SNK_GRANT_CLAUSE;
        var hasRestrict: bool := restrictNi >= 0 && self.sn_kind(restrictNi) == SNK_RESTRICT_CLAUSE;

        // Warnung: kein explizites grant (Kriterium 6)
        if !hasGrant {
          self._warnNode("Import ohne explizites grant — Security-Score -2"c, ni);
        }

        if hasGrant {
          // Regel 2: grant vorhanden
          var grantSet: CapSet := new CapSet();
          grantSet.Init();
          self._fillCapSet(self.sn_c0(grantNi), grantSet);

          var escId: int64 := resolver.ComputeGrant(self.currModuleCaps, grantSet, effectiveCaps);
          if escId >= 0 {
            // Eskalationsversuch (Kriterium 3)
            var reg2: CapabilityRegistry;
            reg2.Init();
            // Fehlermeldung mit Capability-ID
            self._errorNode("grant enthält Capability die nicht in Parent-Capabilities ist"c, grantNi);
          }

          // Breaking-Change-Prüfung (Kriterium 5)
          if moduleDecl != 0 as CapSet {
            var breakId: int64 := resolver.DetectBreakingChange(grantSet, moduleDecl);
            if breakId >= 0 {
              self._errorNode("Breaking Change: grant-Parameter stimmt nicht mit Modul-Deklaration überein"c, grantNi);
            }
          }

          dispose grantSet;
        } else if moduleDecl != 0 as CapSet {
          // Regel 1: kein grant, aber C(M_decl) bekannt
          var missingId: int64 := resolver.ComputeNoGrant(self.currModuleCaps, moduleDecl, effectiveCaps);
          if missingId >= 0 {
            self._errorNode("importiertes Modul deklariert Capability die im Parent fehlt"c, ni);
          }
        }

        if hasRestrict {
          var restrictSet: CapSet := new CapSet();
          restrictSet.Init();
          self._fillCapSet(self.sn_c0(restrictNi), restrictSet);
          var restricted: CapSet := new CapSet();
          restricted.Init();
          resolver.ApplyRestrict(effectiveCaps, restrictSet, restricted);
          dispose effectiveCaps;
          effectiveCaps := restricted;
          dispose restrictSet;
        }

        // Invarianten-Check: C(M) ⊆ C(P)
        var violId: int64 := resolver.CheckInvariant(effectiveCaps, self.currModuleCaps);
        if violId >= 0 {
          self._errorNode("Invariantenverletzung: C(M) ⊄ C(P)"c, ni);
        }

        effectiveCaps.Clear();
      }
      ni := self.sn_next(ni);
    }

    dispose effectiveCaps;
  }

  // WP-L4: Wurzelknoten anlegen, Kanten eintragen, Compute() aufrufen.
  // head: AST-Kopf des aktuell kompilierten Moduls.
  // rootName / rootLen: Modulname des Wurzelknotens (für Graph-Identifikation).
  fn _buildCapGraph(head: int64, rootName: pchar, rootLen: int64): void {
    // Wurzelknoten
    self.rootNodeIdx := self.capGraph.AddNode(rootName, rootLen);
    if self.rootNodeIdx >= 0 {
      self.capGraph.SetOwnCapsFromCapSet(self.rootNodeIdx, self.currModuleCaps.entries, self.currModuleCaps.count);

      // Kanten zu direkten Imports des Wurzelmoduls
      var ni: int64 := head;
      while ni >= 0 {
        if self.sn_kind(ni) == SNK_IMPORT {
          var subName: pchar := self.sn_sVal(ni);
          var subLen:  int64 := self.sn_sLen(ni);
          var subIdx:  int64 := self.capGraph.AddNode(subName, subLen);
          self.capGraph.AddEdge(self.rootNodeIdx, subIdx);
        }
        ni := self.sn_next(ni);
      }
    }

    // Transitive Hülle berechnen
    self.capGraph.Compute();

    // Zyklus-Fehler melden
    if self.capGraph.HadCycle() {
      var fromIdx: int64 := self.capGraph.CycleFrom();
      var toIdx:   int64 := self.capGraph.CycleTo();
      PrintStr("sema error: zyklischer Import erkannt: "c);
      PrintStr(self.capGraph.NodeName(fromIdx));
      PrintStr(" → "c);
      PrintStr(self.capGraph.NodeName(toIdx));
      PrintStr(" → …\n"c);
      self.hadError   := 1;
      self.errorCount += 1;
    }
  }

  // WP-L5: Prüft extern fn-Deklarationen auf FFI-Sicherheitsklasse.
  // Wird in _checkFuncDecl aufgerufen wenn iVal & 1 == 1 und c3 != -1 (extern fn).
  // SEC-BUG-01: Prüft zusätzlich das link-Zielsymbol gegen Blacklist (Aliasing-Schutz).
  fn _checkExternFn(ni: int64): void {
    var iVal:    int64 := self.sn_iVal(ni);
    var name:    pchar := self.sn_sVal(ni);
    var nameLen: int64 := self.sn_sLen(ni);

    // Signatur-Info aus iVal entpacken (WP-L5: Parser speichert dort)
    var pcharCount: int64 := (iVal >> 8) & 0xFF;
    var sizeCount:  int64 := (iVal >> 16) & 0xFF;
    var variadic:   int64 := (iVal >> 24) & 1;

    // Prüfen ob @capabilities([system.unsafe.format_string]) gesetzt
    var hasFormatCap: bool := false;
    var capAttrNi: int64 := self.sn_c2(ni);
    if capAttrNi >= 0 && self.sn_kind(capAttrNi) == SNK_CAPABILITY_ATTR {
      var capReg: CapabilityRegistry;
      capReg.Init();
      var decl: int64 := self.sn_c0(capAttrNi);
      while decl >= 0 {
        var cPath: pchar  := self.sn_sVal(decl);
        var cLen:  int64  := self.sn_sLen(decl);
        if capReg.LookupId(cPath, cLen) == CAP_SYSTEM_UNSAFE_FORMAT {
          hasFormatCap := true;
        }
        decl := self.sn_next(decl);
      }
    }

    // SEC-BUG-01: link-Zielsymbol gegen Blacklist prüfen (c3 = linkLen<<32 | linkOff).
    // Verhindert: extern fn safe_name(...) link "system"; — Lyx-Name wäre nicht geblockt.
    var c3val: int64 := self.sn_c3(ni);
    if c3val != -1 {
      var linkOff: int64 := c3val & 0x00000000FFFFFFFF;
      var linkLen: int64 := (c3val >> 32) & 0x00000000FFFFFFFF;
      var linkName: pchar := self.src + linkOff;
      if ffi_isLinkTargetBlacklisted(linkName, linkLen) {
        self._errorNode(ffi_linkAliasMsg(), ni);
        return;
      }
      if ffi_isLinkTargetFormatString(linkName, linkLen) && !hasFormatCap {
        self._errorNode(ffi_linkFormatAliasMsg(), ni);
        return;
      }
    }

    var cls: int64 := ffi_classify(name, nameLen, pcharCount, sizeCount, variadic, hasFormatCap);

    if cls == FFI_CLASS_FORBIDDEN {
      if ffi_isHardBlacklisted(name, nameLen) {
        self._errorNode(ffi_blacklistMsg(), ni);
      } else if ffi_isFormatStringFamily(name, nameLen) {
        self._errorNode(ffi_formatStringMsg(), ni);
      } else {
        self._errorNode(ffi_signatureMsg(), ni);
      }
    } else if cls == FFI_CLASS_OS {
      // OS-class extern fn must declare @capabilities([...]) — otherwise LCBS is bypassable
      if capAttrNi < 0 || self.sn_kind(capAttrNi) != SNK_CAPABILITY_ATTR {
        self._errorNode("extern fn mit OS-Zugriff erfordert @capabilities([...])-Annotation"c, ni);
      }
    } else if cls == FFI_CLASS_PROCESS {
      // S3 (V1.1): Prozess-Steuerung (fork/kill/clone/setuid…) erfordert @capabilities
      // wie OS — vorher fiel PROCESS durch und war ohne Cap erlaubt (Sandbox-Lücke).
      if capAttrNi < 0 || self.sn_kind(capAttrNi) != SNK_CAPABILITY_ATTR {
        self._errorNode("extern fn mit Prozess-Steuerung erfordert @capabilities([...])-Annotation"c, ni);
      }
    } else if cls == FFI_CLASS_UNKNOWN {
      // FFI-SANDBOX (Fail-Closed): unbekanntes/nicht-klassifiziertes FFI-Symbol. In
      // vertrauenswürdigen std.*/src.*-Units erlaubt (Binding-Layer = TCB); in User-Code
      // muss es per @capabilities([...]) explizit deklariert werden — sonst war es ein
      // Sandbox-Bypass (beliebiges Symbol als „SAFE" durchgewunken).
      if self.ffiTrusted == 0 {
        if capAttrNi < 0 || self.sn_kind(capAttrNi) != SNK_CAPABILITY_ATTR {
          self._errorNode("extern fn: unbekanntes FFI-Symbol erfordert @capabilities([...]) (FFI-Sandbox Fail-Closed)"c, ni);
        }
      }
    } else if ffi_isStrncpyFamily(name, nameLen) {
      self._warnNode(ffi_strncpyWarnMsg(), ni);
    }
  }

  // #1009: Typparameter aus c3 (NK_TYPE_PARAM-Kette) uebernehmen.
  // Liefert den vorherigen Stand zurueck, damit der Aufrufer ihn nach dem
  // Pruefen wiederherstellen kann (verschachtelte Funktionen).
  fn _pushTypeParams(ni: int64): int64 {
    var saved: int64 := self.tpCount;
    // Bei `extern fn` traegt c3 den gepackten link-String ((len << 32) | offset),
    // KEINEN Knotenindex — siehe ParseFuncDecl. Ein sn_kind() darauf liest weit
    // ausserhalb der Knotenarena und bringt den Compiler zum Absturz.
    if ((self.sn_iVal(ni) & 1) != 0) { return saved; }
    var tp: int64 := self.sn_c3(ni);
    while (tp >= 0 && tp < self.pNodeCount) {
      if (self.sn_kind(tp) == SNK_TYPE_PARAM && self.tpCount < self.tpCap) {
        poke64(self.tpNames + self.tpCount * 8, self.sn_sVal(tp) as int64);
        poke64(self.tpLens  + self.tpCount * 8, self.sn_sLen(tp));
        self.tpCount += 1;
      }
      tp := self.sn_next(tp);
    }
    return saved;
  }

  // #1009: Benennt dieser Typknoten einen aktiven Typparameter?
  fn _isTypeParamRef(typeNi: int64): int64 {
    if (typeNi < 0) { return 0; }
    if (self.sn_kind(typeNi) != SNK_TYPE_NAME) { return 0; }
    var nm: pchar := self.sn_sVal(typeNi);
    var nl: int64 := self.sn_sLen(typeNi);
    var i: int64 := 0;
    while (i < self.tpCount) {
      var pn: pchar := peek64(self.tpNames + i * 8) as pchar;
      var pl: int64 := peek64(self.tpLens + i * 8);
      if (self._strNEq(pn, pl, nm, nl)) { return 1; }
      i += 1;
    }
    return 0;
  }

  // #1089: Steht der Ausdruck zur Uebersetzungszeit fest? Literale jeder Art,
  // `con`-Bezeichner, unaeres Minus darauf und Verknuepfungen davon.
  fn _isCompileTimeConst(ni: int64): int64 {
    if (ni < 0) { return 0; }
    var k: int64 := self.sn_kind(ni);
    if (k == 40) { return 1; }   // NK_LIT_INT
    if (k == 41) { return 1; }   // NK_LIT_FLOAT
    if (k == 42) { return 1; }   // NK_LIT_STR
    if (k == 43) { return 1; }   // NK_LIT_CHAR
    if (k == 44) { return 1; }   // NK_LIT_BOOL
    if (k == 45) { return 1; }   // NK_LIT_NULL
    if (k == SNK_UNOP) { return self._isCompileTimeConst(self.sn_c0(ni)); }
    if (k == SNK_BINOP) {
      if (self._isCompileTimeConst(self.sn_c0(ni)) == 0) { return 0; }
      return self._isCompileTimeConst(self.sn_c1(ni));
    }
    if (k == SNK_IDENT) {
      var si: int64 := self.Lookup(self.sn_sVal(ni), self.sn_sLen(ni));
      if (si < 0) { return 0; }
      if (self.SymKind(si) == SYM_CON) { return 1; }
      return 0;
    }
    return 0;
  }

  // #1090: Enthaelt der Teilbaum eine Verwendung von `self`?
  // Iterativ mit eigenem Stapel -- eine Rekursion ueber tiefe Rumpfbaeume
  // waere hier die zweite Stelle, an der die Tiefe zum Problem wird.
  fn _usesSelf(root: int64): int64 {
    if (root < 0) { return 0; }
    var stack: int64 := alloc(4096 * 8);
    var sp: int64 := 0;
    poke64(stack, root); sp := 1;
    var found: int64 := 0;
    while (sp > 0 && found == 0) {
      sp := sp - 1;
      var n: int64 := peek64(stack + sp * 8);
      if (n >= 0) {
        if (self.sn_kind(n) == SNK_IDENT) {
          if (self._strNEq(self.sn_sVal(n), self.sn_sLen(n), "self"c, 4)) { found := 1; }
        }
        if (found == 0 && sp < 4090) {
          poke64(stack + sp * 8, self.sn_c0(n));   sp := sp + 1;
          poke64(stack + sp * 8, self.sn_c1(n));   sp := sp + 1;
          poke64(stack + sp * 8, self.sn_c2(n));   sp := sp + 1;
          poke64(stack + sp * 8, self.sn_c3(n));   sp := sp + 1;
          poke64(stack + sp * 8, self.sn_next(n)); sp := sp + 1;
        }
      }
    }
    free(stack, 4096 * 8);
    return found;
  }

  fn _checkFuncDecl(ni: int64) {
    self._pushScope();

    // #1089: Default-Werte muessen zur UEBERSETZUNGSZEIT feststehen
    // (ebnf.md §15.1). Der Codegen wertet den Ausdruck an JEDER Aufrufstelle
    // aus; ein nicht-konstanter Default liefe also bei jedem Aufruf erneut,
    // samt Seiteneffekten. Das ist weder das, was die Spezifikation sagt,
    // noch das, was jemand erwartet, der einen Vorgabewert hinschreibt.
    var dp: int64 := self.sn_c0(ni);
    while (dp >= 0) {
      var dv: int64 := self.sn_c1(dp);
      if (dv >= 0) {
        if (self._isCompileTimeConst(dv) == 0) {
          self._errorNodeName("Default-Wert muss zur Uebersetzungszeit feststehen", dv, self.sn_sVal(dp), self.sn_sLen(dp));
        }
      }
      dp := self.sn_next(dp);
    }

    // WP-L5: extern fn-Validierung (iVal & 1 = extern)
    // SEC-BUG-02: auch extern fn OHNE link-String prüfen (c3 == -1).
    // Stdlib-interne Builtins (fork, waitpid, getpid …) sind explizit ausgenommen.
    if (self.sn_iVal(ni) & 1) != 0 {
      if self.sn_c3(ni) != -1 {
        // Hat link-String → volle FFI-Prüfung inkl. link-Target
        self._checkExternFn(ni);
      } else {
        // Kein link-String.
        var bname:    pchar := self.sn_sVal(ni);
        var bnameLen: int64 := self.sn_sLen(ni);
        if self.ffiTrusted != 0 {
          // Vertrauenswürdige Unit (std.*/src.*): stdlib-interne Builtins (fork, mmap,
          // getpid …) exempt; sonst nur Blacklist (Binding-Layer = TCB).
          if !ffi_isStdlibBuiltin(bname, bnameLen) {
            if ffi_isHardBlacklisted(bname, bnameLen) {
              self._errorNode(ffi_noLinkBlacklistMsg(), ni);
            }
          }
        } else {
          // S3 (V1.1): User-Code → volle Klassifizierung auch ohne link-String. Die
          // stdlib-Builtin-Exemption gilt NICHT in User-Code: ein User-`extern fn fork()`
          // ist echte Prozess-Steuerung (PROCESS → @cap), `extern fn evil()` UNKNOWN →
          // fail-closed. Schließt die Fail-Open-Lücke im no-link-Pfad.
          self._checkExternFn(ni);
        }
      }
    }

    // WP-13: Capture analysis - track current function for nested function detection
    var funcName: pchar := self.sn_sVal(ni);
    var funcNameLen: int64 := self.sn_sLen(ni);

    // #1009: Typparameter dieser Deklaration bekannt machen. Ohne das meldete
    // sema fuer `fn max<T>(a: T, b: T): T` "unknown param type" — der Parser
    // legt die Parameter in c3 ab, _checkFuncDecl las den Slot aber nie.
    // ACHTUNG: bei `extern fn` traegt c3 den link-String, nicht Typparameter
    // (siehe Kommentar in ParseFuncDecl) — _pushTypeParams laeuft deshalb nur
    // ueber Knoten der Art SNK_TYPE_PARAM und ignoriert alles andere.
    var savedTp: int64 := self._pushTypeParams(ni);

    // Register parameters (c0 = first param, sn_next-linked)
    var param: int64 := self.sn_c0(ni);
    while (param >= 0) {
      var typeNi: int64 := self.sn_c0(param);
      var tid:    int64 := self.ResolveType(typeNi);
      if (tid == TY_UNKNOWN && self._isTypeParamRef(typeNi) == 0) {
        self._errorNode("unknown param type", param);
      }
      self._logReason("param"c, param, tid);
      self._pushSym(self.sn_sVal(param), self.sn_sLen(param), SYM_PARAM, tid, param);
      param := self.sn_next(param);
    }

    // Validate return type (c1)
    var retNi: int64 := self.sn_c1(ni);
    if (retNi >= 0) {
      var retTid: int64 := self.ResolveType(retNi);
      if (retTid == TY_UNKNOWN && self._isTypeParamRef(retNi) == 0) {
        self._errorNodeName("unknown return type", ni, self.sn_sVal(retNi), self.sn_sLen(retNi));
      }
      self._logReason("return-type"c, ni, retTid);
    }

    // Check body (c2)
    var body: int64 := self.sn_c2(ni);
    if (body >= 0) {
      // WP-13: Analyze body for nested function captures
      self._analyzeCaptures(body, funcName, funcNameLen);
      self._checkStmt(body);
      // WP-AS-15: DAA — check after body so locals are known
      if (self.daaEnabled != 0) { self._daaBlock(body, 0); }
    }
    // #1009: Typparameter gelten nur innerhalb dieser Deklaration.
    self.tpCount := savedTp;

    self._popScope();
  }

  // WP-AS-15: mark a name as initialized in the uninit set (remove entry)
  fn _daaMarkInit(nm: pchar, nl: int64, uninitCount: int64): int64 {
    var i: int64 := 0;
    while (i < uninitCount) {
      var ePtr: pchar := peek64(self.daaBuf + i * DAA_SIZE) as pchar;
      var eLen: int64 := peek64(self.daaBuf + i * DAA_SIZE + DAA_OFF_NAMELEN);
      if (self._strNEq(nm, nl, ePtr, eLen)) {
        // Shift remaining entries down
        var j: int64 := i;
        while (j < uninitCount - 1) {
          poke64(self.daaBuf + j * DAA_SIZE,                    peek64(self.daaBuf + (j + 1) * DAA_SIZE));
          poke64(self.daaBuf + j * DAA_SIZE + DAA_OFF_NAMELEN,  peek64(self.daaBuf + (j + 1) * DAA_SIZE + DAA_OFF_NAMELEN));
          j += 1;
        }
        return uninitCount - 1;
      }
      i += 1;
    }
    return uninitCount;
  }

  // WP-AS-15: check expression for reads of uninit vars; returns uninitCount unchanged
  fn _daaCheckExpr(ni: int64, uninitCount: int64) {
    if (ni < 0) { return; }
    var k: int64 := self.sn_kind(ni);
    if (k == SNK_FUNC_DECL) { return; }  // nested fn: own scope, skip
    if (k == SNK_IDENT) {
      var nm: pchar := self.sn_sVal(ni);
      var nl: int64 := self.sn_sLen(ni);
      var i: int64 := 0;
      while (i < uninitCount) {
        var ePtr: pchar := peek64(self.daaBuf + i * DAA_SIZE) as pchar;
        var eLen: int64 := peek64(self.daaBuf + i * DAA_SIZE + DAA_OFF_NAMELEN);
        if (self._strNEq(nm, nl, ePtr, eLen)) {
          if (self.daaEnabled >= 2) {
            self._errorNodeName("variable used before initialization"c, ni, nm, nl);
          } else {
            self._warnNode("variable possibly used before initialization"c, ni);
          }
        }
        i += 1;
      }
      return;
    }
    // Recurse into children
    self._daaCheckExpr(self.sn_c0(ni), uninitCount);
    self._daaCheckExpr(self.sn_c1(ni), uninitCount);
    self._daaCheckExpr(self.sn_c2(ni), uninitCount);
    self._daaCheckExpr(self.sn_c3(ni), uninitCount);
  }

  // WP-AS-15: walk a block sequentially, tracking uninit vars.
  // Returns updated uninitCount (for caller to ignore — we mutate daaBuf in place).
  fn _daaBlock(blockNi: int64, uninitCount: int64): int64 {
    if (blockNi < 0) { return uninitCount; }
    var k: int64 := self.sn_kind(blockNi);
    if (k == SNK_BLOCK) {
      var stmt: int64 := self.sn_c0(blockNi);
      while (stmt >= 0) {
        uninitCount := self._daaStmt(stmt, uninitCount);
        stmt := self.sn_next(stmt);
      }
    } else {
      uninitCount := self._daaStmt(blockNi, uninitCount);
    }
    return uninitCount;
  }

  // WP-AS-15: handle a single statement in DAA pass
  fn _daaStmt(ni: int64, uninitCount: int64): int64 {
    if (ni < 0) { return uninitCount; }
    var k: int64 := self.sn_kind(ni);
    if (k == SNK_VAR_DECL) {
      var initExpr: int64 := self.sn_c1(ni);
      if (initExpr >= 0) {
        // Has initializer: check init expr, then var is initialized
        self._daaCheckExpr(initExpr, uninitCount);
      } else {
        // No initializer: add to uninit set (zero-init makes it safe at runtime, but DAA warns)
        if (uninitCount < self.daaCapacity) {
          poke64(self.daaBuf + uninitCount * DAA_SIZE,                   self.sn_sVal(ni) as int64);
          poke64(self.daaBuf + uninitCount * DAA_SIZE + DAA_OFF_NAMELEN, self.sn_sLen(ni));
          uninitCount += 1;
        }
      }
    } else if (k == SNK_ASSIGN) {
      // Check RHS first (reads)
      self._daaCheckExpr(self.sn_c1(ni), uninitCount);
      // Mark LHS as initialized if it's a plain ident
      var lhs: int64 := self.sn_c0(ni);
      if (self.sn_kind(lhs) == SNK_IDENT) {
        uninitCount := self._daaMarkInit(self.sn_sVal(lhs), self.sn_sLen(lhs), uninitCount);
      }
    } else if (k == SNK_BLOCK) {
      uninitCount := self._daaBlock(ni, uninitCount);
    } else if (k == SNK_IF) {
      // Condition check
      self._daaCheckExpr(self.sn_c0(ni), uninitCount);
      // Conservative: recurse into branches without merging init sets
      self._daaBlock(self.sn_c1(ni), uninitCount);
      if (self.sn_c2(ni) >= 0) { self._daaBlock(self.sn_c2(ni), uninitCount); }
    } else if (k == SNK_WHILE) {
      self._daaCheckExpr(self.sn_c0(ni), uninitCount);
      self._daaBlock(self.sn_c1(ni), uninitCount);
    } else if (k == SNK_RETURN) {
      self._daaCheckExpr(self.sn_c0(ni), uninitCount);
    } else if (k == SNK_FUNC_DECL) {
      // Nested function: skip (own scope)
    } else {
      // All other stmts: check all expressions recursively
      self._daaCheckExpr(ni, uninitCount);
    }
    return uninitCount;
  }

  // WP-13: Analyze nested function bodies for captured variables
  fn _analyzeCaptures(blockNi: int64, outerName: pchar, outerNameLen: int64) {
    if (blockNi < 0) { return; }
    var k: int64 := self.sn_kind(blockNi);
    if (k == SNK_BLOCK) {
      var stmt: int64 := self.sn_c0(blockNi);
      while (stmt >= 0) {
        // Recursively analyze nested function declarations
        if (self.sn_kind(stmt) == SNK_FUNC_DECL) {
          // Found nested function - analyze what outer variables it uses
          var body: int64 := self.sn_c2(stmt);
          if (body >= 0) { self._collectCaptures(body, outerName, outerNameLen); }
        } else {
          // Continue searching in other statements
          self._analyzeCaptures(stmt, outerName, outerNameLen);
        }
        stmt := self.sn_next(stmt);
      }
    }
  }
  
  // WP-13: Collect captured variable references from nested function body
  fn _collectCaptures(exprNi: int64, outerName: pchar, outerNameLen: int64) {
    if (exprNi < 0) { return; }
    var k: int64 := self.sn_kind(exprNi);
    
    // Check identifiers - if not found in current or nested scopes, check outer scope
    if (k == SNK_IDENT) {
      var nm: pchar := self.sn_sVal(exprNi);
      var nl: int64 := self.sn_sLen(exprNi);
      // Check if identifier exists in current scope
      var si: int64 := self.Lookup(nm, nl);
      // If not found in current scope, check if it exists in outer scope
      // (This is a simplified check - full implementation would need scope depth analysis)
      if (si < 0) {
        // Check if it's a function parameter (which would be in the outer function's scope)
        // For now, treat any unknown identifier as potentially captured from outer scope
        self._addCapturedVar(outerName, outerNameLen, nm, nl);
      }
    }
    
    // Skip nested function declarations (they have their own scope)
    if (k == SNK_FUNC_DECL || k == SNK_CLOSURE) {
      return;
    }
    
    // Recurse into child nodes
    var c0: int64 := self.sn_c0(exprNi);
    var c1: int64 := self.sn_c1(exprNi);
    var c2: int64 := self.sn_c2(exprNi);
    if (c0 >= 0) { self._collectCaptures(c0, outerName, outerNameLen); }
    if (c1 >= 0) { self._collectCaptures(c1, outerName, outerNameLen); }
    if (c2 >= 0) { self._collectCaptures(c2, outerName, outerNameLen); }
  }
  
  // WP-13: Add a captured variable entry
  fn _addCapturedVar(funcName: pchar, funcLen: int64, varName: pchar, varLen: int64) {
    // Implement capture tracking with buffer management
    // Buffer format: {funcNamePtr:8, funcNameLen:8, varNamePtr:8, varNameLen:8} = 32 bytes per entry
    
    // Check if this capture already exists (avoid duplicates)
    var i: int64 := 0;
    while (i < self.capturedCount) {
      var base: int64 := self.capturedVars + i * 32;
      var funcN: pchar := peek64(base) as pchar;
      var fnlen: int64 := peek64(base + CAPTVAR_OFF_FUNCLEN);
      var varn: pchar := peek64(base + CAPTVAR_OFF_VARPTR) as pchar;
      var varlen: int64 := peek64(base + CAPTVAR_OFF_VARLEN);
      // Compare: must match function name AND variable name
      if (fnlen == funcLen && varlen == varLen) {
        if (self._strNEq(funcN, fnlen, funcName, funcLen) && self._strNEq(varn, varlen, varName, varLen)) {
          return;  // Already captured
        }
      }
      i += 1;
    }
    
    // Grow buffer if needed
    if (self.capturedCount >= self.capturedCap) {
      var newCap: int64 := self.capturedCap * 2;
      if (newCap == 0) { newCap := 8; }
      var nb: int64 := alloc(newCap * 32);
      var j: int64 := 0;
      memcpy(nb, self.capturedVars, self.capturedCount * 32);
      self.capturedVars := nb;
      self.capturedCap := newCap;
    }
    
    // Add new captured variable
    var entry: int64 := self.capturedVars + self.capturedCount * 32;
    poke64(entry,                     funcName as int64);
    poke64(entry + CAPTVAR_OFF_FUNCLEN, funcLen);
    poke64(entry + CAPTVAR_OFF_VARPTR,  varName as int64);
    poke64(entry + CAPTVAR_OFF_VARLEN,  varLen);
    self.capturedCount += 1;
  }

  // WP-2.1: Resolve generic function call with type arguments.
  // e.g., max[int64](3, 7) → instantiate max with T=int64 → max__int64
  fn _resolveGenericCall(fnName: pchar, fnLen: int64, typeArgsNi: int64) {
    // WP-2.1: recursion guard — prevents infinite instantiation loops
    if (self.instDepth > 8) {
      self._error("recursive generic instantiation detected"c);
      return;
    }
    self.instDepth += 1;

    // 1. Validate that type arguments are valid types
    var ta: int64 := typeArgsNi;
    var argCount: int64 := 0;
    while (ta >= 0) {
      var tid: int64 := self.ResolveType(ta);
      if (tid == TY_UNKNOWN) {
        self._errorNodeName("unknown type in generic arguments", ta, self.sn_sVal(ta), self.sn_sLen(ta));
      }
      argCount += 1;
      ta := self.sn_next(ta);
    }

    // 2. Look up the generic function declaration and check constraints
    var fnSym: int64 := self.Lookup(fnName, fnLen);
    if (fnSym >= 0) {
      var symKind: int64 := self.SymKind(fnSym);
      // If it's a generic function (SYM_GENERIC_FUNC), check constraints
      if (symKind == 10) {  // SYM_GENERIC_FUNC
        var typeParams: int64 := self.SymTypeId(fnSym);
        // Count type params and verify count matches
        var tpCount: int64 := 0;
        var tp: int64 := typeParams;
        while (tp >= 0) { tpCount := tpCount + 1; tp := self.sn_next(tp); }
        if (tpCount != argCount) {
          self._errorNode("generic type argument count mismatch", typeArgsNi);
        }
        // WP-BC-23: check constraints on each type argument
        var tp2: int64 := typeParams;
        var ta2: int64 := typeArgsNi;
        while (tp2 >= 0 && ta2 >= 0) {
          var constraint: int64 := self.sn_c0(tp2);
          if (constraint >= 0) {
            // constraint is a type node (interface name); look it up
            var cName: pchar := self.sn_sVal(constraint);
            var cLen:  int64 := self.sn_sLen(constraint);
            var cSym:  int64 := self.Lookup(cName, cLen);
            if (cSym < 0) {
              self._errorNode("unknown constraint interface", constraint);
            } else {
              // Resolve the type argument and check it implements the interface
              var argName: pchar := self.sn_sVal(ta2);
              var argLen:  int64 := self.sn_sLen(ta2);
              var argSym:  int64 := self.Lookup(argName, argLen);
              if (argSym >= 0) {
                var argNi:  int64 := self.SymNodeIdx(argSym);
                var ifaceNi: int64 := self.SymNodeIdx(cSym);
                if (argNi >= 0 && ifaceNi >= 0) {
                  // Check each interface method exists in the type arg
                  var iMth: int64 := self.sn_c1(ifaceNi);
                  while (iMth >= 0) {
                    var iMthName: pchar := self.sn_sVal(iMth);
                    var iMthLen:  int64 := self.sn_sLen(iMth);
                    var found2: int64 := 0;
                    var cMth2: int64 := self.sn_c1(argNi);
                    while (cMth2 >= 0) {
                      if (self._strNEq(iMthName, iMthLen, self.sn_sVal(cMth2), self.sn_sLen(cMth2)) != 0) {
                        found2 := 1; break;
                      }
                      cMth2 := self.sn_next(cMth2);
                    }
                    if (found2 == 0) {
                      self._errorNode("type arg does not satisfy generic constraint", ta2);
                    }
                    iMth := self.sn_next(iMth);
                  }
                }
              }
            }
          }
          tp2 := self.sn_next(tp2);
          ta2 := self.sn_next(ta2);
        }
      }
    }

    // 3. Try to get existing monomorphized instance, or create one
    var instIdx: int64 := self._getMonomorphInstance(fnName, fnLen, typeArgsNi);
    if (instIdx < 0) {
      // 4. Create new monomorphized instance — find the generic node index
      var genNodeIdx: int64 := -1;
      var genSym2: int64 := self.Lookup(fnName, fnLen);
      if (genSym2 >= 0) { genNodeIdx := self.SymNodeIdx(genSym2); }
      self._createMonomorphInstance(fnName, fnLen, typeArgsNi, genNodeIdx);
    }

    self.instDepth -= 1;
  }

  // WP-2.1: Map a type ID to its canonical name string for name mangling.
  fn _typeName(tid: int64): pchar {
    if (tid == TY_INT64)   { return "int64"c; }
    if (tid == TY_INT32)   { return "int32"c; }
    if (tid == TY_INT16)   { return "int16"c; }
    if (tid == TY_INT8)    { return "int8"c; }
    if (tid == TY_UINT64)  { return "uint64"c; }
    if (tid == TY_UINT32)  { return "uint32"c; }
    if (tid == TY_UINT16)  { return "uint16"c; }
    if (tid == TY_UINT8)   { return "uint8"c; }
    if (tid == TY_FLOAT64) { return "f64"c; }
    if (tid == TY_FLOAT32) { return "f32"c; }
    if (tid == TY_PCHAR)   { return "pchar"c; }
    if (tid == TY_BOOL)    { return "bool"c; }
    if (tid == TY_VOID)    { return "void"c; }
    return "T"c;
  }

  // WP-2.1: Create a new monomorphized function instance.
  // Builds a mangled name "genName__type1__type2", registers it as SYM_FUNC,
  // and caches the mapping so IR-lowering can find the specialization.
  fn _createMonomorphInstance(genName: pchar, genLen: int64, typeArgsNi: int64, genNodeIdx: int64) {
    // Build mangled name: "genName__type1__type2..."
    var nameBuf: int64 := alloc(genLen + 512);
    var pos: int64 := 0;
    var i: int64 := 0;
    while (i < genLen) {
      poke8(nameBuf + pos, StrCharAt(genName, i));
      pos += 1; i := i + 1;
    }
    var ta: int64 := typeArgsNi;
    while (ta >= 0) {
      // Double-underscore separator per spec (max__int64 not max_int64)
      StrSetChar(nameBuf as pchar, pos, 95); pos := pos + 1;
      StrSetChar(nameBuf as pchar, pos, 95); pos := pos + 1;
      // Use the source type name from the AST node when available
      var tName: pchar;
      var tLen: int64 := 0;
      if (self.sn_kind(ta) == SNK_TYPE_NAME) {
        tName := self.sn_sVal(ta);
        tLen  := self.sn_sLen(ta);
      } else {
        tName := self._typeName(self.ResolveType(ta));
        tLen  := StrLen(tName);
      }
      var j: int64 := 0;
      while (j < tLen) {
        poke8(nameBuf + pos, StrCharAt(tName, j));
        pos += 1; j := j + 1;
      }
      ta := self.sn_next(ta);
    }
    poke8(nameBuf + pos, 0);

    // Register specialized symbol pointing to the generic declaration's body
    self._pushSym(nameBuf as pchar, pos, SYM_FUNC, TY_VOID, genNodeIdx);
    var instSymIdx: int64 := self.symCount - 1;

    // Grow cache if needed (64-byte records)
    con INST_REC: int64 := GENINST_SIZE;
    if (self.instCount >= self.instCap) {
      var nc: int64 := self.instCap * 2;
      if (nc == 0) { nc := 8; }
      var nb: int64 := alloc(nc * INST_REC);
      var j: int64 := 0;
      memcpy(nb, self.instCache, self.instCount * INST_REC);
      if (self.instCache != 0) { free(self.instCache, self.instCap * INST_REC); }
      self.instCache := nb; self.instCap := nc;
    }
    // Compute type hash
    var typeHash: int64 := 0;
    var th: int64 := typeArgsNi;
    while (th >= 0) {
      typeHash := typeHash * 31 + self.ResolveType(th);
      th := self.sn_next(th);
    }
    var base: int64 := self.instCache + self.instCount * INST_REC;
    poke64(base,                        genName as int64);
    poke64(base + GENINST_OFF_GENLEN,   genLen);
    poke64(base + GENINST_OFF_TYPEHASH, typeHash);
    poke64(base + GENINST_OFF_INSTPTR,  nameBuf);
    poke64(base + GENINST_OFF_INSTLEN,  pos);
    poke64(base + GENINST_OFF_SYMIDX,   instSymIdx);
    poke64(base + GENINST_OFF_NODEIDX,  genNodeIdx);
    poke64(base + GENINST_OFF_TYPEARGS, typeArgsNi);
    self.instCount += 1;
  }

  // WP-2.1: Look up an existing monomorphized instance in the cache.
  // Returns instSymIdx (≥0) if found, -1 if not yet instantiated.
  fn _getMonomorphInstance(genName: pchar, genLen: int64, typeArgsNi: int64): int64 {
    con INST_REC: int64 := GENINST_SIZE;
    var typeHash: int64 := 0;
    var ta: int64 := typeArgsNi;
    while (ta >= 0) {
      typeHash := typeHash * 31 + self.ResolveType(ta);
      ta := self.sn_next(ta);
    }
    var i: int64 := 0;
    while (i < self.instCount) {
      var base: int64 := self.instCache + i * INST_REC;
      var fnlen: int64 := peek64(base + GENINST_OFF_GENLEN);
      var typeH: int64 := peek64(base + GENINST_OFF_TYPEHASH);
      if (fnlen == genLen && typeH == typeHash) {
        var funcN: pchar := peek64(base) as pchar;
        if (self._strNEq(funcN, fnlen, genName, genLen) != 0) {
          return peek64(base + GENINST_OFF_SYMIDX);
        }
      }
      i += 1;
    }
    return -1;
  }

  // WP-L7: Füllt curFuncCapBuf aus @capabilities- und @uses_caller_cap-Knoten.
  // capAttrNi: SNK_CAPABILITY_ATTR der Funktion (-1 wenn keine); uccNi: SNK_USES_CALLER_CAP (-1 wenn keine).
  // Geborgene UCC-Caps gelten innerhalb der Funktion als vorhanden (für transitive Propagation).
  fn _fillCurFuncCaps(capAttrNi: int64, uccNi: int64): void {
    self.curFuncCapCount := 0;
    var reg: CapabilityRegistry;
    reg.Init();
    if capAttrNi >= 0 {
      var capDecl: int64 := self.sn_c0(capAttrNi);
      while capDecl >= 0 && self.curFuncCapCount < 64 {
        var capId: int64 := reg.LookupId(self.sn_sVal(capDecl), self.sn_sLen(capDecl));
        if capId >= 0 {
          poke64(self.curFuncCapBuf + self.curFuncCapCount * 8, capId);
          self.curFuncCapCount += 1;
        }
        capDecl := self.sn_next(capDecl);
      }
    }
    if uccNi >= 0 {
      var uccDecl: int64 := self.sn_c0(uccNi);
      while uccDecl >= 0 && self.curFuncCapCount < 64 {
        var capId2: int64 := reg.LookupId(self.sn_sVal(uccDecl), self.sn_sLen(uccDecl));
        if capId2 >= 0 {
          poke64(self.curFuncCapBuf + self.curFuncCapCount * 8, capId2);
          self.curFuncCapCount += 1;
        }
        uccDecl := self.sn_next(uccDecl);
      }
    }
  }

  // WP-L8: Füllt curFuncCapBuf für Klassenmethoden: union(classCapNi, methodCapNi, uccNi).
  fn _fillMethodCaps(classCapNi: int64, methodCapNi: int64, uccNi: int64): void {
    self.curFuncCapCount := 0;
    var reg: CapabilityRegistry;
    reg.Init();
    // Class-level caps first
    if classCapNi >= 0 {
      var cd: int64 := self.sn_c0(classCapNi);
      while cd >= 0 && self.curFuncCapCount < 64 {
        var cid: int64 := reg.LookupId(self.sn_sVal(cd), self.sn_sLen(cd));
        if cid >= 0 {
          poke64(self.curFuncCapBuf + self.curFuncCapCount * 8, cid);
          self.curFuncCapCount += 1;
        }
        cd := self.sn_next(cd);
      }
    }
    // Method-own caps (union — skip duplicates)
    if methodCapNi >= 0 {
      var cd2: int64 := self.sn_c0(methodCapNi);
      while cd2 >= 0 && self.curFuncCapCount < 64 {
        var cid2: int64 := reg.LookupId(self.sn_sVal(cd2), self.sn_sLen(cd2));
        if cid2 >= 0 {
          var ci: int64 := 0;
          var dup: int64 := 0;
          while ci < self.curFuncCapCount {
            if peek64(self.curFuncCapBuf + ci * 8) == cid2 { dup := 1; ci := self.curFuncCapCount; }
            ci += 1;
          }
          if dup == 0 {
            poke64(self.curFuncCapBuf + self.curFuncCapCount * 8, cid2);
            self.curFuncCapCount += 1;
          }
        }
        cd2 := self.sn_next(cd2);
      }
    }
    // UCC-borrowed caps
    if uccNi >= 0 {
      var cd3: int64 := self.sn_c0(uccNi);
      while cd3 >= 0 && self.curFuncCapCount < 64 {
        var cid3: int64 := reg.LookupId(self.sn_sVal(cd3), self.sn_sLen(cd3));
        if cid3 >= 0 {
          poke64(self.curFuncCapBuf + self.curFuncCapCount * 8, cid3);
          self.curFuncCapCount += 1;
        }
        cd3 := self.sn_next(cd3);
      }
    }
  }

  // WP-L7: Registriert eine @uses_caller_cap-annotierte Funktion im UCC-Puffer.
  // funcNi: SNK_FUNC_DECL-Knoten; uccNi: SNK_USES_CALLER_CAP-Knoten.
  fn _registerUccFn(funcNi: int64, uccNi: int64): void {
    if self.uccCount >= 128 { return; }
    var off: int64 := self.uccBuf + self.uccCount * 88;
    poke64(off,     self.sn_sVal(funcNi) as int64);
    poke64(off + 8, self.sn_sLen(funcNi));
    var reg: CapabilityRegistry;
    reg.Init();
    var capDecl: int64  := self.sn_c0(uccNi);
    var capCount: int64 := 0;
    while capDecl >= 0 && capCount < 8 {
      var capId: int64 := reg.LookupId(self.sn_sVal(capDecl), self.sn_sLen(capDecl));
      if capId >= 0 {
        poke64(off + 24 + capCount * 8, capId);
        capCount += 1;
      }
      capDecl := self.sn_next(capDecl);
    }
    poke64(off + 16, capCount);
    self.uccCount += 1;
  }

  // WP-L7: Sucht Funktion im UCC-Puffer. Gibt Eintrag-Offset zurück, oder -1.
  fn _lookupUcc(name: pchar, nlen: int64): int64 {
    var i: int64 := 0;
    while i < self.uccCount {
      var off: int64   := self.uccBuf + i * 88;
      var eName: pchar := peek64(off) as pchar;
      var eLen: int64  := peek64(off + 8);
      if self._strNEq(name, nlen, eName, eLen) { return off; }
      i += 1;
    }
    return -1;
  }

  // BUG-6: Rekursiv prüfen, ob ein Methodenrumpf `self` verwendet.
  // Läuft über c0/c1/c2 und die next-Kette; verschachtelte SNK_FUNC_DECL werden
  // nicht betreten (eigener self-Kontext).
  fn _usesSelf(ni: int64, depth: int64): int64 {
    if (ni < 0) { return 0; }
    if (depth > 64) { return 1; }   // zu tief → konservativ „benutzt self"
    var n: int64 := ni;
    while (n >= 0) {
      var k: int64 := self.sn_kind(n);
      if (k == SNK_IDENT) {
        if (self._strNEq(self.sn_sVal(n), self.sn_sLen(n), "self"c, 4)) { return 1; }
      }
      if (k != SNK_FUNC_DECL || n == ni) {
        if (self._usesSelf(self.sn_c0(n), depth + 1) != 0) { return 1; }
        if (self._usesSelf(self.sn_c1(n), depth + 1) != 0) { return 1; }
        if (self._usesSelf(self.sn_c2(n), depth + 1) != 0) { return 1; }
      }
      n := self.sn_next(n);
    }
    return 0;
  }

  // BUG-6: `TypeName.Method(args)` — Aufruf über den Typnamen statt über eine Instanz.
  //
  // Das ist NICHT pauschal ungültig: statische Factory-Methoden sind ein etabliertes
  // Pattern (z.B. `StringBuilder.Create(256)` in src/std/string.lyx) — sie allozieren
  // selbst und rühren `self` nie an. Verboten ist nur der Fall, in dem die Methode
  // `self` tatsächlich benutzt: dann läuft sie mit undefiniertem Empfänger und
  // schreibt/liest an einer beliebigen Adresse. Genau das beschrieb BUG-6.
  //
  // Importierte Typen tragen SymNodeIdx -2 (siehe Import-Pass), deren Rümpfe sind hier
  // nicht sichtbar → übersprungen, lieber ungeprüft als falsch-positiv.
  fn _checkStaticMethodCall(callNi: int64, typeSi: int64, tname: pchar, tlen: int64): void {
    var declNi: int64 := self.SymNodeIdx(typeSi);
    if (declNi < 0) { return; }
    if (self.sn_kind(declNi) != SNK_TYPE_DECL) { return; }
    var mname: pchar := self.sn_sVal(callNi);
    var mlen: int64 := self.sn_sLen(callNi);
    var mth: int64 := self.sn_c1(declNi);
    while (mth >= 0) {
      if (self.sn_kind(mth) == SNK_FUNC_DECL) {
        if (self._strNEq(self.sn_sVal(mth), self.sn_sLen(mth), mname, mlen)) {
          if (self._usesSelf(self.sn_c2(mth), 0) != 0) {
            self._errorNodeName("Methode benutzt 'self' und braucht eine Instanz — Aufruf ueber den Typnamen", callNi, mname, mlen);
          }
          return;
        }
      }
      mth := self.sn_next(mth);
    }
  }

  // WP-L7: Prüft ob curFuncCapBuf alle von @uses_caller_cap geforderten Caps enthält.
  // Bei fehlendem Cap: Compiler-Fehler mit Cap-Name und Zeilennummer.
  fn _checkCallerCap(callNi: int64, name: pchar, nlen: int64): void {
    var uccOff: int64 := self._lookupUcc(name, nlen);
    if uccOff < 0 { return; }
    var reqCount: int64 := peek64(uccOff + 16);
    var ri: int64 := 0;
    while ri < reqCount {
      var reqCap: int64 := peek64(uccOff + 24 + ri * 8);
      var found: int64  := 0;
      var ci: int64     := 0;
      while ci < self.curFuncCapCount {
        if peek64(self.curFuncCapBuf + ci * 8) == reqCap { found := 1; ci := self.curFuncCapCount; }
        ci += 1;
      }
      if found == 0 {
        var tokIdx: int64 := self.sn_tokIdx(callNi);
        var line: int64   := 0;
        if tokIdx >= 0 { line := self.sn_tokLine(tokIdx); }
        PrintStr("sema error (line "c);
        PrintInt(line);
        PrintStr("): Caller hat nicht: "c);
        PrintStr(cap_nameOf(reqCap));
        PrintStr(" (benötigt von @uses_caller_cap)\n"c);
        // hadError must be set after PrintStr to avoid rdi-clobber issue
        var _he: int64 := 1;
        self.hadError   := _he;
        self.errorCount += _he;
      }
      ri += 1;
    }
  }

  // WP-L7: Warnt bei Funktionszeiger auf @uses_caller_cap-annotierte Funktion.
  fn _checkFnPtrUcc(ni: int64): void {
    if ni < 0 { return; }
    if self.sn_kind(ni) != SNK_IDENT { return; }
    var uccOff: int64 := self._lookupUcc(self.sn_sVal(ni), self.sn_sLen(ni));
    if uccOff < 0 { return; }
    self._warnNode("@uses_caller_cap bei indirektem Aufruf nicht überprüfbar"c, ni);
  }

  // WP-A3: Returns byte size of a field's type node for at(offset) overlap checking.
  // Uses direct string comparison with token-accurate lengths (without null terminator).
  fn _semFieldTypeSize(typeNi: int64): int64 {
    if (typeNi < 0) { return 8; }
    var tn: pchar := self.sn_sVal(typeNi);
    var tl: int64 := self.sn_sLen(typeNi);
    // 1-byte: int8, u8, char
    if (tl == 4 && self._strNEq(tn, tl, "int8"c, 4)) { return 1; }
    if (tl == 2 && self._strNEq(tn, tl, "u8"c,   2)) { return 1; }
    if (tl == 5 && self._strNEq(tn, tl, "uint8"c, 5)) { return 1; }
    if (tl == 4 && self._strNEq(tn, tl, "char"c, 4)) { return 1; }
    // 2-byte: int16, u16
    if (tl == 5 && self._strNEq(tn, tl, "int16"c, 5)) { return 2; }
    if (tl == 3 && self._strNEq(tn, tl, "u16"c,   3)) { return 2; }
    if (tl == 6 && self._strNEq(tn, tl, "uint16"c, 6)) { return 2; }
    // 4-byte: int32, u32, f32
    if (tl == 5 && self._strNEq(tn, tl, "int32"c, 5)) { return 4; }
    if (tl == 3 && self._strNEq(tn, tl, "u32"c,   3)) { return 4; }
    if (tl == 6 && self._strNEq(tn, tl, "uint32"c, 6)) { return 4; }
    if (tl == 3 && self._strNEq(tn, tl, "f32"c,   3)) { return 4; }
    return 8;  // int64, u64, f64, pchar, bool, structs: 8 bytes
  }

  // WP-A3: ConstExpr, monotonicity, and O(n²) overlap check for at(offset) fields.
  fn _checkAtOffsetFields(firstField: int64) {
    var hasOff: int64 := 0;
    var tmpf: int64 := firstField;
    while (tmpf >= 0) {
      if ((self.sn_iVal(tmpf) & 1) != 0) { hasOff := 1; break; }
      tmpf := self.sn_next(tmpf);
    }
    if (hasOff == 0) { return; }
    var prevOff: int64 := -1;
    var offBuf:  int64 := alloc(64 * 8);
    var szBuf:   int64 := alloc(64 * 8);
    var nodBuf:  int64 := alloc(64 * 8);
    var nOff:    int64 := 0;
    var fld:     int64 := firstField;
    while (fld >= 0 && nOff < 64) {
      if ((self.sn_iVal(fld) & 1) != 0) {
        var offNi: int64 := self.sn_c1(fld);
        if (offNi >= 0) {
          if (self.sn_kind(offNi) != 40) {
            self._errorNode("at(offset): value must be a compile-time integer constant"c, fld);
          }
          var fOff: int64 := self.sn_iVal(offNi);
          if (fOff < prevOff) {
            self._errorNode("struct field at(offset) must not decrease relative to previous field"c, fld);
          }
          prevOff := fOff;
          poke64(offBuf + nOff * 8, fOff);
          poke64(szBuf  + nOff * 8, self._semFieldTypeSize(self.sn_c0(fld)));
          poke64(nodBuf + nOff * 8, fld);
          nOff += 1;
        }
      }
      fld := self.sn_next(fld);
    }
    var ai:   int64 := 0;
    var aOff: int64 := 0;
    var aSz:  int64 := 0;
    var bi:   int64 := 0;
    var bOff: int64 := 0;
    var bSz:  int64 := 0;
    while (ai < nOff) {
      aOff := peek64(offBuf + ai * 8);
      aSz  := peek64(szBuf  + ai * 8);
      bi   := ai + 1;
      while (bi < nOff) {
        bOff := peek64(offBuf + bi * 8);
        bSz  := peek64(szBuf  + bi * 8);
        if (aOff < bOff + bSz && bOff < aOff + aSz) {
          var errNi: int64 := peek64(nodBuf + bi * 8);
          self._errorNode("struct field at(offset) overlaps with previous field"c, errNi);
        }
        bi += 1;
      }
      ai += 1;
    }
  }

  fn _p2Decl(ni: int64) {
    var k: int64 := self.sn_kind(ni);
    // WP-L7: Pending-Annotationen bei nicht-annotierbaren Knoten zurücksetzen.
    // Use 0-1 instead of -1 literal: bootstrap miscompiles -1 as 0 (known bug).
    if k != SNK_CAPABILITY_ATTR && k != SNK_USES_CALLER_CAP &&
       k != SNK_FUNC_DECL && k != SNK_BLOCK && k != SNK_TYPE_DECL {
      self.pendingCapNode := 0 - 1;
      self.pendingUccNode := 0 - 1;
    }
    if (k == SNK_FUNC_DECL) {
      // WP-L7: Effective Caps des aktuellen Functions setzen und UCC registrieren
      self._fillCurFuncCaps(self.pendingCapNode, self.pendingUccNode);
      if self.pendingUccNode >= 0 { self._registerUccFn(ni, self.pendingUccNode); }
      self.pendingCapNode := 0 - 1;
      self.pendingUccNode := 0 - 1;
      self._checkFuncDecl(ni);
    } else if (k == SNK_GENERIC_DECL) {
      // WP-2.1: generic declarations are not checked directly —
      // only their monomorphized instances (emitted by IR lowerer) are.
      return;
    } else if (k == SNK_STRUCT_DECL) {
      // Check struct field types and @big_endian constraints (WP-4.1-A/B/A3)
      var field: int64 := self.sn_c0(ni);
      while (field >= 0) {
        var typeNode: int64 := self.sn_c0(field);
        if (typeNode >= 0) { self.ResolveType(typeNode); }
        // WP-4.1-B: @big_endian must not be applied to f64 fields
        if ((self.sn_iVal(field) & 2) != 0 && typeNode >= 0) {
          var tp: pchar := self.sn_sVal(typeNode);
          var tn: int64 := self.sn_sLen(typeNode);
          if (tn == 3 && self._strNEq(tp, tn, "f64"c, 3) != 0) {
            self._errorNode("@big_endian cannot be applied to f64 fields"c, field);
          }
        }
        field := self.sn_next(field);
      }
      // WP-A3: ConstExpr + monotonicity + overlap check
      self._checkAtOffsetFields(self.sn_c0(ni));
    } else if (k == SNK_ENUM_DECL) {
      // Check enum variant payload types
      var variant: int64 := self.sn_c0(ni);
      while (variant >= 0) {
        var payload: int64 := self.sn_c0(variant);
        if (payload >= 0) {
          self._checkExpr(payload);
        }
        variant := self.sn_next(variant);
      }
    } else if (k == SNK_TYPE_DECL) {
      // Type alias or class: check aliased type; for classes, verify override methods
      var aliasedType: int64 := self.sn_c0(ni);
      if (aliasedType >= 0) {
        self.ResolveType(aliasedType);
      }
      // WP-BC-22: set class context for visibility checks
      var prevClassNi: int64 := self.curClassNi;
      if (self.sn_c1(ni) >= 0) { self.curClassNi := ni; }
      // WP-L8: class-level @capabilities node (from pendingCapNode, set by @capabilities before class)
      var prevClassCapNode: int64 := self.classCapNode;
      if self.pendingCapNode >= 0 {
        self.classCapNode := self.pendingCapNode;
        self.pendingCapNode := 0 - 1;
      } else {
        self.classCapNode := 0 - 1;
      }
      // WP-BC-19: for class declarations, check override methods have a parent
      var parentNi: int64 := self.sn_c2(ni);
      if (parentNi >= 0) {
        var parentName: pchar := self.sn_sVal(parentNi);
        var parentLen: int64 := self.sn_sLen(parentNi);
        var parentSym: int64 := self.Lookup(parentName, parentLen);
        if (parentSym < 0) {
          self._errorNodeName("unknown parent class", ni, parentName, parentLen);
        }
        // Check that methods marked override exist in parent (name check only)
        var mth: int64 := self.sn_c1(ni);
        while (mth >= 0) {
          if self.sn_kind(mth) == SNK_FUNC_DECL {
            var flags: int64 := self.sn_iVal(mth);
            var isOverride: int64 := (flags >> 2) & 1;
            if (isOverride != 0 && parentSym >= 0) {
              // Minimal check: parent exists; full method signature check deferred
            }
          }
          mth := self.sn_next(mth);
        }
      }
      // WP-BC-21: interface contract check — each interface in c3 list
      var ifaceListNi: int64 := self.sn_c3(ni);
      while (ifaceListNi >= 0) {
        var ifaceName: pchar := self.sn_sVal(ifaceListNi);
        var ifaceLen:  int64 := self.sn_sLen(ifaceListNi);
        var ifaceSym:  int64 := self.Lookup(ifaceName, ifaceLen);
        if (ifaceSym < 0) {
          self._errorNodeName("unknown interface", ni, ifaceName, ifaceLen);
        } else {
          var ifaceNi: int64 := self.SymNodeIdx(ifaceSym);
          if (ifaceNi >= 0) {
            var iMth: int64 := self.sn_c1(ifaceNi);
            while (iMth >= 0) {
              var iMthName: pchar := self.sn_sVal(iMth);
              var iMthLen:  int64 := self.sn_sLen(iMth);
              var found: int64 := 0;
              var cMth: int64 := self.sn_c1(ni);
              while (cMth >= 0) {
                if self.sn_kind(cMth) == SNK_FUNC_DECL {
                  if (self._strNEq(iMthName, iMthLen, self.sn_sVal(cMth), self.sn_sLen(cMth)) != 0) {
                    found := 1; break;
                  }
                }
                cMth := self.sn_next(cMth);
              }
              if (found == 0) { self._errorNodeName("class missing interface method", iMth, iMthName, iMthLen); }
              iMth := self.sn_next(iMth);
            }
          }
        }
        ifaceListNi := self.sn_next(ifaceListNi);
      }
      // #1090: `static`-Methoden pruefen -- unabhaengig von Annotationen.
      // Die volle Rumpfpruefung unten laeuft aus Ruecksicht auf Altbestand nur
      // fuer capability-annotierte Klassen; diese eine Frage muss aber ueberall
      // gestellt werden, sonst waere die Markierung `static` blosse Zierde.
      // Der Aufruf `A.F()` uebergibt self = 0; wer darin `self` anfasst,
      // dereferenziert null.
      var stMth: int64 := self.sn_c1(ni);
      while (stMth >= 0) {
        if (self.sn_kind(stMth) == SNK_FUNC_DECL) {
          if (((self.sn_iVal(stMth) >> 6) & 1) != 0) {
            if (self._usesSelf(self.sn_c2(stMth)) != 0) {
              self._errorNodeName("statische Methode darf self nicht verwenden", stMth, self.sn_sVal(stMth), self.sn_sLen(stMth));
            }
          }
        }
        stMth := self.sn_next(stMth);
      }

      // WP-L8: check method bodies only for capability-annotated classes or methods.
      // Classes without any capability annotations keep the pre-WP-L8 behavior
      // (no body checking) to preserve backward compatibility and avoid surfacing
      // latent sema errors in unannotated code (e.g., lyxc.lyx itself).
      var anyMthAnnotation: int64 := 0;
      var scanMth: int64 := self.sn_c1(ni);
      while scanMth >= 0 {
        var smk: int64 := self.sn_kind(scanMth);
        if smk == SNK_CAPABILITY_ATTR || smk == SNK_USES_CALLER_CAP { anyMthAnnotation := 1; }
        scanMth := self.sn_next(scanMth);
      }
      if self.classCapNode >= 0 || anyMthAnnotation > 0 {
        var mthCap: int64 := self.sn_c1(ni);
        var pendMthCap: int64 := 0 - 1;
        var pendMthUcc: int64 := 0 - 1;
        while mthCap >= 0 {
          var mk: int64 := self.sn_kind(mthCap);
          if mk == SNK_CAPABILITY_ATTR {
            pendMthCap := mthCap;
          } else if mk == SNK_USES_CALLER_CAP {
            pendMthUcc := mthCap;
          } else if mk == SNK_FUNC_DECL {
            self._fillMethodCaps(self.classCapNode, pendMthCap, pendMthUcc);
            self._checkFuncDecl(mthCap);
            pendMthCap := 0 - 1;
            pendMthUcc := 0 - 1;
          }
          mthCap := self.sn_next(mthCap);
        }
      }
      // WP-A3: For struct-type declarations (type X = struct {}), validate at(offset) fields.
      // Struct nodes have c1 < 0 (no methods) and c0 pointing to first field (NK_FIELD_DECL = 7).
      if (self.sn_c1(ni) < 0 && self.sn_c0(ni) >= 0 && self.sn_kind(self.sn_c0(ni)) == 7) {
        self._checkAtOffsetFields(self.sn_c0(ni));
      }
      // WP-BC-22 / WP-L8: restore class context
      self.classCapNode := prevClassCapNode;
      self.curClassNi := prevClassNi;
    } else if (k == SNK_IMPORT) {
      // Mark import as potentially used (will be checked by linter)
      // Import name is in sn_sVal
    } else if (k == SNK_DIM_DECL) {
      // dim declarations are compile-time only; no body to check
    } else if (k == SNK_UTYPE_DECL) {
      // utype declarations are compile-time only; no body to check
    } else if (k == SNK_BLOCK) {  // inlined @if branch (mutated by Pass1)
      var child: int64 := self.sn_c0(ni);
      while (child >= 0) {
        self._p2Decl(child);
        child := self.sn_next(child);
      }
    } else if (k == SNK_AT_DIRECTIVE) {  // top-level @io_check / @overflow_check / WP-AS-03
      var kind: int64 := self.sn_iVal(ni);
      var val:  int64 := self.sn_c0(ni);
      if (kind == 0) { self.ioCheckEnabled       := val; }
      if (kind == 1) { self.overflowCheckEnabled := val; }
      if (kind == 2) { self.boundsCheckEnabled   := val; }  // WP-AS-03
      if (kind == 3) { self.debugInfoEnabled     := val; }  // WP-AS-03
      if (kind == 4) { self.optLevel             := val; }  // WP-AS-03
    } else if (k == SNK_AT_ENERGY) {  // WP-EN-03: top-level @energy(N)
      self.energyLevel := self.sn_iVal(ni);
    } else if (k == SNK_CAPABILITY_ATTR) {  // WP-L2/L7: @capabilities([...])
      self._checkCapabilityAttr(ni);
      self.pendingCapNode := ni;  // WP-L7: für nächste fn-Deklaration merken
    } else if (k == SNK_USES_CALLER_CAP) {  // WP-L2/L7: @uses_caller_cap([...])
      self._checkCapabilityAttr(ni);
      self.pendingUccNode := ni;  // WP-L7: für nächste fn-Deklaration merken
    }
  }

  fn Pass2(head: int64) {
    var ni: int64 := head;
    while (ni >= 0) {
      self._p2Decl(ni);
      ni := self.sn_next(ni);
    }
  }

