// ============================================================================
// Symbol record — declared as Lyx struct (WP-POKE-08)
// ============================================================================

pub type SymRecord = struct {
  name:       pchar;
  nameLen:    int64;
  kind:       int64;
  typeId:     int64;
  nodeIdx:    int64;
  isVolatile: int64;
};

pub con SEMA_SYM_SIZE: int64 := 48;


// AST node field offsets (SEMA_NODE_SIZE = 88)
con NODE_OFF_C0:     int64 := 8;
con NODE_OFF_C1:     int64 := 16;
con NODE_OFF_C2:     int64 := 24;
con NODE_OFF_C3:     int64 := 32;
con NODE_OFF_NEXT:   int64 := 40;
con NODE_OFF_TOKIDX: int64 := 48;
con NODE_OFF_IVAL:   int64 := 56;
con NODE_OFF_SVAL:   int64 := 64;
con NODE_OFF_SLEN:   int64 := 72;

// Token field offsets (SEMA_TOK_SIZE = 40)
con TOK_OFF_LINE: int64 := 32;

// Generic instantiation cache entry (64 bytes)
con GENINST_SIZE:         int64 := 64;
con GENINST_OFF_GENLEN:   int64 := 8;
con GENINST_OFF_TYPEHASH: int64 := 16;
con GENINST_OFF_INSTPTR:  int64 := 24;
con GENINST_OFF_INSTLEN:  int64 := 32;
con GENINST_OFF_SYMIDX:   int64 := 40;
con GENINST_OFF_NODEIDX:  int64 := 48;
con GENINST_OFF_TYPEARGS: int64 := 56;

// Captured-var table entry (32 bytes)
con CAPTVAR_SIZE:       int64 := 32;
