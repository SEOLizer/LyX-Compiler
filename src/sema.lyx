con CAPTVAR_OFF_VARPTR:  int64 := 16;
con CAPTVAR_OFF_VARLEN:  int64 := 24;

// DAA (Definite Assignment Analysis) entry (16 bytes)
con DAA_SIZE:        int64 := 16;
con DAA_OFF_NAMELEN: int64 := 8;

// Imported-module entry (16 bytes: namePtr + nameLen)
con IMPORTED_SIZE:        int64 := 16;
con IMPORTED_OFF_NAMELEN: int64 := 8;

con SEMA_VAR_FLAG_VOLATILE: int64 := 1;  // WP-AS-18: mirrors VAR_FLAG_VOLATILE from parser
