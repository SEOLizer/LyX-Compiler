  // ------------------------------------------------------------------
  // Public API
  // ------------------------------------------------------------------

  fn _initWPL7(): void {
    self.uccBuf          := alloc(128 * 88);
    self.uccCount        := 0;
    self.curFuncCapBuf   := alloc(64 * 8);
    self.curFuncCapCount := 0;
    // Use 0-1 instead of -1 literal: bootstrap miscompiles -1 as 0 (known bug).
    self.pendingCapNode  := 0 - 1;
    self.pendingUccNode  := 0 - 1;
    self.classCapNode    := 0 - 1;
  }

  fn Init(src: pchar, srcLen: int64, nodes: int64, nodeCount: int64, toks: int64) {
    self.src        := src;
    self.srcLen     := srcLen;
    self.pNodes     := nodes;
    self.pNodeCount := nodeCount;
    self.pToks      := toks;
    self.pTokCount  := 1000000;

    self.symCap   := 256;
    self.syms     := alloc(self.symCap * SEMA_SYM_SIZE + 16);
    poke64(self.syms, self.symCap);  // Array header: cap
    poke64(self.syms + 8, 0);        // Array header: len
    self.symCount := 0;

    // #1295: Dimensionstabelle fuer utype-Symbole (auch importierte).
    self.utDimCap   := 16;
    self.utDimTab   := alloc(self.utDimCap * 32);
    self.klsCap     := 16;                        // #1570
    self.klsTab     := alloc(self.klsCap * 24);
    self.klsCount   := 0;
    self.utDimCount := 0;

    // #1264: Signaturtabelle (auch fuer importierte Funktionen).
    self.fnSigCap   := 64;
    self.fnSigTab   := alloc(self.fnSigCap * 48);
    self.fnSigCount := 0;

    self.scopeCap   := 64;
    self.scopes     := alloc(self.scopeCap * 8);
    self.scopeDepth := 0;

    self.hadError   := 0;
    self.errorCount := 0;
    self.curClassNi  := -1;
    self.classCapNode := -1;
    self.curFile     := 0 as pchar;
    self.ffiTrusted  := 0;   // Root/User-Modul ist NICHT vertrauenswürdig (fail-closed)
    self.globalSymCount := 0;
    self.nestedBarrier  := 0 - 1;
    self.unitTrusted := 0;   // vom Treiber nach Init() gesetzt; Check() übernimmt es

    // WP-10e: import dedup table
    self.importedCap   := 16;
    self.importedMods  := alloc(self.importedCap * 16);
    self.importedCount := 0;

    // #1028: Register der exportierten Symbole
    self.expSymCap   := 256;
    self.expSyms     := alloc(self.expSymCap * 32);
    self.expSymCount := 0;
    self.expScanned  := 0;
    self.privEnforce := 0;
    self.tpCap   := 32;
    self.tpNames := alloc(self.tpCap * 8);
    self.tpLens  := alloc(self.tpCap * 8);
    self.tpCount := 0;
    self.curAlias    := 0;   // #1262
    self.curAliasLen := 0;
    self.privCap    := 16384;
    self.symAliasPtr := alloc(self.privCap * 8);   // #1262
    self.symAliasLen := alloc(self.privCap * 8);
    var az: int64 := 0;
    while (az < self.privCap) { poke64(self.symAliasPtr + az * 8, 0); az := az + 1; }
    self.privFlags  := alloc(self.privCap);
    self.privModPtr := alloc(self.privCap * 8);
    self.privModLen := alloc(self.privCap * 8);
    var pz: int64 := 0;
    while (pz < self.privCap) { poke8(self.privFlags + pz, 0); pz := pz + 1; }

    // WP-14: generic instantiation cache
    self.instCap   := 64;
    self.instCache := alloc(self.instCap * 32);
    self.instCount := 0;

    // WP-13: captured vars table
    self.capturedCap   := 64;
    self.capturedVars := alloc(self.capturedCap * 32);
    self.capturedCount := 0;

    // WP-BC-42: search paths (set by caller after Init)
    self.includePath := 0;
    self.stdPath     := 0;
    self.lastReadSize := 0;  // WP-35: binary-safe file size
    self.lastReadPath := 0;
    self.traceImports := 0;

    // WP-BC-46: verbose flags (set by caller after Init)
    self.typeReasoning := false;
    self.constraintLog := false;

    // WP-CS-05: injected constants buffer
    self.injConCap    := 64;
    self.injConCount  := 0;
    self.injConValues := alloc(self.injConCap * 8);

    // WP-CS-07: directive state defaults (0=off; @io_check(true) enables at source level)
    self.ioCheckEnabled       := 0;
    self.overflowCheckEnabled := 0;

    // WP-AS-03: new directive defaults
    self.boundsCheckEnabled := 1;  // on by default (safety-first)
    self.curFnRetType := TY_UNKNOWN;   // #1135
    self.curFnBody    := -1;           // #1155: kein Rumpf ausserhalb einer fn
    self.boundsCheckForced  := 0;  // #1124
    self.debugInfoEnabled   := 0;
    self.optLevel           := 2;  // default optimisation level

    // WP-AS-15: DAA — off by default (opt-in in v0.9 via --daa CLI flag)
    self.daaEnabled  := 0;
    self.daaCapacity := 256;
    self.daaBuf      := alloc(256 * 16);

    // WP-EN-03
    self.energyLevel := 0;

    // WP-L3: Capability-Vererbung
    self.currModuleCaps := new CapSet();
    self.currModuleCaps.Init();
    self.importCapCap   := 32;
    self.importCapCount := 0;
    self.importCapCache := alloc(self.importCapCap * 16);  // 32 * (hash:8 + ptr:8)

    // WP-L4: Transitiver Capability-Graph
    self.capGraph    := new CapGraph();
    self.capGraph.Init();
    self.rootNodeIdx := -1;

    // WP-L6: Compile-Time Stripper
    self.capStripper := new CapStripper();
    self.capStripper.Init();

    // WP-L7: @uses_caller_cap Registry (in _initWPL7 um Short-Jump-Overflow zu vermeiden)
    self._initWPL7();

    self._registerBuiltins();
  }

  // Run all passes + WP-L3/L4/L5/L6 checks; returns hadError
  fn Check(head: int64): int64 {
    // FFI-Trust des Root-Moduls. Init() setzt fail-closed auf 0; der Treiber
    // setzt unitTrusted erst DANACH (er kennt den Pfad), deshalb wird es hier
    // übernommen und nicht in Init().
    self.ffiTrusted := self.unitTrusted;

    // WP-L6: C(root) VOR Pass1 extrahieren — wird für Pruning-Entscheidungen benötigt
    self._collectParentCaps(head);

    self.Pass1(head);
    self.globalSymCount := self.symCount;   // ab hier: Funktions-lokale Symbole
    // #1035: Die Sichtbarkeitspruefung gilt fuer das WURZELMODUL. Waehrend Pass1
    // laufen auch die Bodies importierter Units durch Lookup — deren Zugriffe auf
    // die eigenen privaten Symbole sind voellig legitim und duerfen nicht melden.
    self.privEnforce := 1;
    self.Pass2(head);
    self.privEnforce := 0;
    self._checkDuplicateFuncs(head);         // #1135
    self._checkCapabilityInheritance(head);  // WP-L3
    self._buildCapGraph(head, "<root>"c, 6); // WP-L4
    self.capStripper.PrintReport();          // WP-L6: Pruning-Report
    return self.hadError;
  }

  // #1135: Zwei Funktionen gleichen Namens im SELBEN Modul. Bisher gewann
  // stillschweigend die erste, die zweite war toter Text — ein Kopierfehler
  // beim Umbenennen blieb damit unbemerkt. Geprueft wird nur die oberste
  // Ebene des Wurzelmoduls: gleichnamige Funktionen in verschiedenen Units
  // sind kein Fehler, dafuer gibt es die Mehrdeutigkeitspruefung.
  fn _checkDuplicateFuncs(head: int64) {
    var a: int64 := head;
    while (a >= 0) {
      if (self.sn_kind(a) == SNK_FUNC_DECL) {
        var an: pchar := self.sn_sVal(a);
        var al: int64 := self.sn_sLen(a);
        var b: int64 := self.sn_next(a);
        while (b >= 0) {
          if (self.sn_kind(b) == SNK_FUNC_DECL) {
            if (self._strNEq(an, al, self.sn_sVal(b), self.sn_sLen(b)) != 0) {
              self._errorNodeName("Funktion bereits deklariert"c, b, self.sn_sVal(b), self.sn_sLen(b));
            }
          }
          b := self.sn_next(b);
        }
      }
      a := self.sn_next(a);
    }
  }

  // WP-BC-46: get source line for a node via its token index
  fn _nodeLineOf(ni: int64): int64 {
    if ni < 0 { return -1; }
    var tokIdx: int64 := self.sn_tokIdx(ni);
    if tokIdx < 0 { return -1; }
    return self.sn_tokLine(tokIdx);
  }

  // WP-BC-46: emit one [type-reason] line when typeReasoning is set
  fn _logReason(label: pchar, ni: int64, typeId: int64): void {
    if !self.typeReasoning { return; }
    PrintStr("[type-reason] "c);
    PrintStr(label);
    PrintStr("  node:"c);
    PrintInt(ni);
    PrintStr("  type:"c);
    PrintStr(self._tyStr(typeId));
    PrintStr("  line:"c);
    PrintInt(self._nodeLineOf(ni));
    PrintStr("\n"c);
  }

  // WP-BC-46: emit one [constraint] line when constraintLog is set
  fn _logConstraint(typeA: int64, typeB: int64, reason: pchar, ni: int64): void {
    if !self.constraintLog { return; }
    PrintStr("[constraint] "c);
    PrintStr(self._tyStr(typeA));
    PrintStr(" = "c);
    PrintStr(self._tyStr(typeB));
    PrintStr("  node:"c);
    PrintInt(ni);
    PrintStr("  reason:"c);
    PrintStr(reason);
    PrintStr("  line:"c);
    PrintInt(self._nodeLineOf(ni));
    PrintStr("\n"c);
  }

  // WP-BC-45: SYM_ kind → name string
  fn _symKindStr(k: int64): pchar {
    if k == SYM_BUILTIN { return "BUILTIN"c; }
    if k == SYM_FUNC    { return "FUNC"c; }
    if k == SYM_VAR     { return "VAR"c; }
    if k == SYM_STRUCT  { return "STRUCT"c; }
    if k == SYM_PARAM   { return "PARAM"c; }
    if k == SYM_CON     { return "CON"c; }
    if k == SYM_ENUM    { return "ENUM"c; }
    if k == SYM_FIELD   { return "FIELD"c; }
    if k == SYM_TYPE    { return "TYPE"c; }
    return "?"c;
  }

  // WP-BC-45: TY_ type id → name string
  fn _tyStr(t: int64): pchar {
    if t == TY_UNKNOWN  { return "unknown"c; }
    if t == TY_VOID     { return "void"c; }
    if t == TY_BOOL     { return "bool"c; }
    if t == TY_INT64    { return "int64"c; }
    if t == TY_PCHAR    { return "pchar"c; }
    if t == TY_FLOAT64  { return "float64"c; }
    if t == TY_INT32    { return "int32"c; }
    if t == TY_ARRAY    { return "array"c; }
    if t == TY_USER     { return "user"c; }
    if t == TY_INT8     { return "int8"c; }
    if t == TY_INT16    { return "int16"c; }
    if t == TY_UINT8    { return "uint8"c; }
    if t == TY_UINT16   { return "uint16"c; }
    if t == TY_UINT32   { return "uint32"c; }
    if t == TY_UINT64   { return "uint64"c; }
    if t == TY_FLOAT32  { return "float32"c; }
    if t == TY_CHAR     { return "char"c; }
    if t == TY_FN_PTR   { return "fn_ptr"c; }
    return "?"c;
  }

  // WP-BC-45: print all non-builtin symbols; builtins are listed at the end as a count
  pub fn DumpSymbols(): void {
    PrintStr("=== SYMBOL TABLE ===\n"c);
    var i: int64 := 0;
    var builtinCount: int64 := 0;
    var userCount: int64 := 0;
    while i < self.symCount {
      var kind: int64 := self.SymKind(i);
      if kind == SYM_BUILTIN {
        builtinCount += 1;
      } else {
        userCount += 1;
        PrintStr("["c);
        PrintInt(i);
        PrintStr("] "c);
        PrintStr(self._symKindStr(kind));
        PrintStr("\t'"c);
        var nm: pchar := self.SymName(i);
        var nl: int64 := self.SymNameLen(i);
        PrintStr(StrSub(nm, 0, nl));
        PrintStr("'\ttype:"c);
        PrintStr(self._tyStr(self.SymTypeId(i)));
        PrintStr("\tnode:"c);
        PrintInt(self.SymNodeIdx(i));
        PrintStr("\n"c);
      }
      i += 1;
    }
    PrintStr("Total: "c);
    PrintInt(self.symCount);
    PrintStr(" symbols ("c);
    PrintInt(userCount);
    PrintStr(" user, "c);
    PrintInt(builtinCount);
    PrintStr(" builtins)\n"c);
  }

};
