  // ------------------------------------------------------------------
  // Public API
  // ------------------------------------------------------------------

  fn Init(src: pchar, srcLen: int64, nodes: int64, nodeCount: int64, toks: int64) {
    self.src        := src;
    self.srcLen     := srcLen;
    self.pNodes     := nodes;
    self.pNodeCount := nodeCount;
    self.pToks      := toks;
    self.pTokCount  := 1000000;

    self.symCap   := 256;
    self.syms     := mmap(0, self.symCap * SEMA_SYM_SIZE, 3, 34, -1, 0);
    self.symCount := 0;

    self.scopeCap   := 64;
    self.scopes     := mmap(0, self.scopeCap * 8, 3, 34, -1, 0);
    self.scopeDepth := 0;

    self.hadError   := 0;
    self.errorCount := 0;
    self.curClassNi := -1;

    // WP-10e: import dedup table
    self.importedCap   := 16;
    self.importedMods  := mmap(0, self.importedCap * 16, 3, 34, -1, 0);
    self.importedCount := 0;

    // WP-14: generic instantiation cache
    self.instCap   := 64;
    self.instCache := mmap(0, self.instCap * 32, 3, 34, -1, 0);
    self.instCount := 0;

    // WP-13: captured vars table
    self.capturedCap   := 64;
    self.capturedVars := mmap(0, self.capturedCap * 32, 3, 34, -1, 0);
    self.capturedCount := 0;

    // WP-BC-42: search paths (set by caller after Init)
    self.includePath := 0;
    self.stdPath     := 0;

    // WP-BC-46: verbose flags (set by caller after Init)
    self.typeReasoning := false;
    self.constraintLog := false;

    // WP-CS-05: injected constants buffer
    self.injConCap    := 64;
    self.injConCount  := 0;
    self.injConValues := mmap(0, self.injConCap * 8, 3, 34, -1, 0);

    // WP-CS-07: directive state defaults (0=off; @io_check(true) enables at source level)
    self.ioCheckEnabled       := 0;
    self.overflowCheckEnabled := 0;

    // WP-AS-03: new directive defaults
    self.boundsCheckEnabled := 1;  // on by default (safety-first)
    self.debugInfoEnabled   := 0;
    self.optLevel           := 2;  // default optimisation level

    // WP-EN-03
    self.energyLevel := 0;

    self._registerBuiltins();
  }

  // Run both passes; returns hadError
  fn Check(head: int64): int64 {
    self.Pass1(head);
    self.Pass2(head);
    return self.hadError;
  }

  // WP-BC-46: get source line for a node via its token index
  fn _nodeLineOf(ni: int64): int64 {
    if ni < 0 { return -1; }
    var tokIdx: int64 := self.sn_tokIdx(ni);
    if tokIdx < 0 { return -1; }
    return self.sn_tokLine(tokIdx);
  }

  // WP-BC-46: emit one [type-reason] line when typeReasoning is set
  fn _logReason(label: pchar, ni: int64, typeId: int64): void {
    if !self.typeReasoning { return; }
    PrintStr("[type-reason] "c);
    PrintStr(label);
    PrintStr("  node:"c);
    PrintInt(ni);
    PrintStr("  type:"c);
    PrintStr(self._tyStr(typeId));
    PrintStr("  line:"c);
    PrintInt(self._nodeLineOf(ni));
    PrintStr("\n"c);
  }

  // WP-BC-46: emit one [constraint] line when constraintLog is set
  fn _logConstraint(typeA: int64, typeB: int64, reason: pchar, ni: int64): void {
    if !self.constraintLog { return; }
    PrintStr("[constraint] "c);
    PrintStr(self._tyStr(typeA));
    PrintStr(" = "c);
    PrintStr(self._tyStr(typeB));
    PrintStr("  node:"c);
    PrintInt(ni);
    PrintStr("  reason:"c);
    PrintStr(reason);
    PrintStr("  line:"c);
    PrintInt(self._nodeLineOf(ni));
    PrintStr("\n"c);
  }

  // WP-BC-45: SYM_ kind → name string
  fn _symKindStr(k: int64): pchar {
    if k == SYM_BUILTIN { return "BUILTIN"c; }
    if k == SYM_FUNC    { return "FUNC"c; }
    if k == SYM_VAR     { return "VAR"c; }
    if k == SYM_STRUCT  { return "STRUCT"c; }
    if k == SYM_PARAM   { return "PARAM"c; }
    if k == SYM_CON     { return "CON"c; }
    if k == SYM_ENUM    { return "ENUM"c; }
    if k == SYM_FIELD   { return "FIELD"c; }
    if k == SYM_TYPE    { return "TYPE"c; }
    return "?"c;
  }

  // WP-BC-45: TY_ type id → name string
  fn _tyStr(t: int64): pchar {
    if t == TY_UNKNOWN  { return "unknown"c; }
    if t == TY_VOID     { return "void"c; }
    if t == TY_BOOL     { return "bool"c; }
    if t == TY_INT64    { return "int64"c; }
    if t == TY_PCHAR    { return "pchar"c; }
    if t == TY_FLOAT64  { return "float64"c; }
    if t == TY_INT32    { return "int32"c; }
    if t == TY_ARRAY    { return "array"c; }
    if t == TY_USER     { return "user"c; }
    if t == TY_INT8     { return "int8"c; }
    if t == TY_INT16    { return "int16"c; }
    if t == TY_UINT8    { return "uint8"c; }
    if t == TY_UINT16   { return "uint16"c; }
    if t == TY_UINT32   { return "uint32"c; }
    if t == TY_UINT64   { return "uint64"c; }
    if t == TY_FLOAT32  { return "float32"c; }
    if t == TY_CHAR     { return "char"c; }
    if t == TY_FN_PTR   { return "fn_ptr"c; }
    return "?"c;
  }

  // WP-BC-45: print all non-builtin symbols; builtins are listed at the end as a count
  pub fn DumpSymbols(): void {
    PrintStr("=== SYMBOL TABLE ===\n"c);
    var i: int64 := 0;
    var builtinCount: int64 := 0;
    var userCount: int64 := 0;
    while i < self.symCount {
      var kind: int64 := self.SymKind(i);
      if kind == SYM_BUILTIN {
        builtinCount := builtinCount + 1;
      } else {
        userCount := userCount + 1;
        PrintStr("["c);
        PrintInt(i);
        PrintStr("] "c);
        PrintStr(self._symKindStr(kind));
        PrintStr("\t'"c);
        var nm: pchar := self.SymName(i);
        var nl: int64 := self.SymNameLen(i);
        PrintStr(StrSub(nm, 0, nl));
        PrintStr("'\ttype:"c);
        PrintStr(self._tyStr(self.SymTypeId(i)));
        PrintStr("\tnode:"c);
        PrintInt(self.SymNodeIdx(i));
        PrintStr("\n"c);
      }
      i := i + 1;
    }
    PrintStr("Total: "c);
    PrintInt(self.symCount);
    PrintStr(" symbols ("c);
    PrintInt(userCount);
    PrintStr(" user, "c);
    PrintInt(builtinCount);
    PrintStr(" builtins)\n"c);
  }

};
