// ===========================================================================
// src/herkunft.lyx — liegt eine geoeffnete Datei im massgeblichen Baum? (#2202)
// ===========================================================================
//
// Das FFI-Vertrauen (Binding-Layer: Externs mit unbekanntem Symbol erlaubt)
// hing bis 1.2.20C am NAMEN: beim Import an `std.`/`src.`, bei
// `--compile-unit` an einem Pfadsegment `std/`, `src/` oder `data/`. Beides
// bestimmt der uebersetzte Baum selbst — ein mitgeliefertes Verzeichnis
// `std/` neben der Quelldatei wird als `std.*` aufgeloest und bekam die
// Vertrauensstellung, ohne sie zu beantragen. Dieselbe Klasse wie die
// Praefixpruefungen aus #1823/#1826.
//
// Jetzt zaehlt die HERKUNFT: der kanonische Pfad der tatsaechlich
// geoeffneten Datei muss unter dem kanonischen Pfad des massgeblichen Baums
// liegen. Massgeblich ist `--std-path` (bzw. LYX_STD_PATH), sonst der
// Installationsbaum. Wer aus einem Checkout heraus baut, nennt den Baum
// ausdruecklich (`--std-path=.`) — kein stilles Sonderrecht.
//
// Kanonisch heisst: ueber /proc/self/fd/N aufgeloest, also ohne `..`,
// Symlinks und relative Teile. Gelingt das nicht (kein /proc), gilt die
// Datei als NICHT vertrauenswuerdig — fail-closed.

unit src.herkunft;

import src.std.alloc;

// Der Installationsbaum, wenn kein --std-path gesetzt ist. Dieselbe Angabe
// wie die letzte Suchstufe in sema._sema_readFile — die beiden muessen
// uebereinstimmen.
pub con HERKUNFT_INSTALLATION: pchar := "/usr/include/lyx/units";

// Kanonischer Pfad zu einem offenen Deskriptor; Laenge oder -1.
pub fn HerkunftKanonisch(fd: int64, buf: int64, cap: int64): int64 {
  if (fd < 0) { return 0 - 1; }
  // #2524: LyxOS hat kein procfs und kein readlink. Ohne diese Weiche kam der
  // Aufruf trotzdem in den IR-Strom, und `lyxc --target=lyxos` brach beim
  // SELBSTBAU ab: Builtin-ID 40 (sys_readlink) zeigt in emit_lyxos auf die
  // Entwurfsnummer 0x0214 = 532, und die ist im Kernel nicht belegt. Der
  // Abbruch war richtig -- eine erfundene Nummer meldet auf LyxOS stillen
  // Erfolg mit 0 Byte (`.r3_unknown`), und die Herkunftspruefung haette mit
  // einem leeren Puffer weitergearbeitet.
  //
  // Zurueckgegeben wird -1, also FAIL-CLOSED wie im Kopf dieser Datei
  // beschrieben: ohne kanonischen Pfad gilt die Datei als nicht
  // vertrauenswuerdig. Das kostet dort nichts Legitimes -- gemessen betrifft
  // es allein die 18 std-Units mit `extern fn`, und die verlangen samt und
  // sonders Linux-Bibliotheken (libQt5Core.so.5, libsqlite3.so.0,
  // libasound.so.2 ...). LyxOS hat keinen dynamischen Linker; auf diesem Ziel
  // abgewiesen zu werden ist fuer sie richtig und nicht Verlust. Units ohne
  // `extern fn` sind von der Vertrauensfrage gar nicht betroffen.
  //
  // Ein kanonischer Pfad OHNE procfs waere herstellbar (sema haelt den
  // Suchwegpfad in `lastReadPath`), braucht aber eine eigene Normalisierung:
  // ein Pfad aus dem Suchweg kann `..` enthalten, und ohne dessen Abbau waere
  // die Praefixpruefung umgehbar (`--std-path=/baum` und
  // `/baum/../fremd/x.lyx`) -- genau die Klasse, aus der #1823/#1826 und
  // damit diese Datei entstanden sind. Wer das will, baut es mit der
  // Normalisierung zusammen; hier wird nichts geraten.
  //
  // macOS ist absichtlich NICHT mitgefasst: dort gibt es `readlink`, nur kein
  // /proc/self/fd. Der Aufruf uebersetzt also und scheitert erst zur Laufzeit
  // -- fail-closed, aber auf anderem Weg. Das ist eine eigene Frage und wird
  // hier nicht stillschweigend mitentschieden.
  // Der readlink-Weg steht im ELSE-Zweig, nicht hinter einem fruehen return:
  // die Faltung (#2513) laesst den nicht genommenen ZWEIG weg, nicht den Code
  // NACH dem if. Ein `if ... { return -1; }` mit dem Aufruf darunter wuerde
  // den Aufruf also weiter senken -- und der Bau braeche wie zuvor.
  if TARGET_OS == OS_LYXOS {
    return 0 - 1;
  } else {
    var link: pchar := StrConcat("/proc/self/fd/"c, IntToStr(fd));
    var n: int64 := readlink(link, buf as pchar, cap - 1);
    if (n <= 0 || n >= cap - 1) { return 0 - 1; }
    poke8(buf + n, 0);
    return n;
  }
}

// 1, wenn die Datei hinter `fd` im Baum `wurzel` liegt (wurzel == 0: der
// Installationsbaum). Die Wurzel wird selbst geoeffnet und kanonisch
// aufgeloest; verglichen wird mit einem `/` dahinter, damit
// `/usr/include/lyx/units2/x.lyx` nicht als Teil von `.../units` gilt.
pub fn HerkunftImBaum(fd: int64, wurzel: pchar): int64 {
  if ((wurzel as int64) == 0) { wurzel := HERKUNFT_INSTALLATION; }
  var wfd: int64 := open(wurzel, 0, 0);
  if (wfd < 0) { return 0; }
  var wb: int64 := alloc(4096);
  var wn: int64 := HerkunftKanonisch(wfd, wb, 4096);
  close(wfd);
  if (wn <= 0) { return 0; }
  var db: int64 := alloc(4096);
  var dn: int64 := HerkunftKanonisch(fd, db, 4096);
  if (dn <= wn) { return 0; }
  var i: int64 := 0;
  while (i < wn) {
    if (peek8(db + i) != peek8(wb + i)) { return 0; }
    i := i + 1;
  }
  // Wurzel "/" endet selbst auf '/'; sonst muss die Datei mit '/' weitergehen.
  if (peek8(wb + wn - 1) == 47) { return 1; }
  if (peek8(db + wn) != 47) { return 0; }
  return 1;
}
