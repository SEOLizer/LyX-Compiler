// ===========================================================================
// src/herkunft.lyx — liegt eine geoeffnete Datei im massgeblichen Baum? (#2202)
// ===========================================================================
//
// Das FFI-Vertrauen (Binding-Layer: Externs mit unbekanntem Symbol erlaubt)
// hing bis 1.2.20C am NAMEN: beim Import an `std.`/`src.`, bei
// `--compile-unit` an einem Pfadsegment `std/`, `src/` oder `data/`. Beides
// bestimmt der uebersetzte Baum selbst — ein mitgeliefertes Verzeichnis
// `std/` neben der Quelldatei wird als `std.*` aufgeloest und bekam die
// Vertrauensstellung, ohne sie zu beantragen. Dieselbe Klasse wie die
// Praefixpruefungen aus #1823/#1826.
//
// Jetzt zaehlt die HERKUNFT: der kanonische Pfad der tatsaechlich
// geoeffneten Datei muss unter dem kanonischen Pfad des massgeblichen Baums
// liegen. Massgeblich ist `--std-path` (bzw. LYX_STD_PATH), sonst der
// Installationsbaum. Wer aus einem Checkout heraus baut, nennt den Baum
// ausdruecklich (`--std-path=.`) — kein stilles Sonderrecht.
//
// Kanonisch heisst: ueber /proc/self/fd/N aufgeloest, also ohne `..`,
// Symlinks und relative Teile. Gelingt das nicht (kein /proc), gilt die
// Datei als NICHT vertrauenswuerdig — fail-closed.

unit src.herkunft;

import src.std.alloc;

// Der Installationsbaum, wenn kein --std-path gesetzt ist. Dieselbe Angabe
// wie die letzte Suchstufe in sema._sema_readFile — die beiden muessen
// uebereinstimmen.
pub con HERKUNFT_INSTALLATION: pchar := "/usr/include/lyx/units";

// Kanonischer Pfad zu einem offenen Deskriptor; Laenge oder -1.
pub fn HerkunftKanonisch(fd: int64, buf: int64, cap: int64): int64 {
  if (fd < 0) { return 0 - 1; }
  var link: pchar := StrConcat("/proc/self/fd/"c, IntToStr(fd));
  var n: int64 := readlink(link, buf as pchar, cap - 1);
  if (n <= 0 || n >= cap - 1) { return 0 - 1; }
  poke8(buf + n, 0);
  return n;
}

// 1, wenn die Datei hinter `fd` im Baum `wurzel` liegt (wurzel == 0: der
// Installationsbaum). Die Wurzel wird selbst geoeffnet und kanonisch
// aufgeloest; verglichen wird mit einem `/` dahinter, damit
// `/usr/include/lyx/units2/x.lyx` nicht als Teil von `.../units` gilt.
pub fn HerkunftImBaum(fd: int64, wurzel: pchar): int64 {
  if ((wurzel as int64) == 0) { wurzel := HERKUNFT_INSTALLATION; }
  var wfd: int64 := open(wurzel, 0, 0);
  if (wfd < 0) { return 0; }
  var wb: int64 := alloc(4096);
  var wn: int64 := HerkunftKanonisch(wfd, wb, 4096);
  close(wfd);
  if (wn <= 0) { return 0; }
  var db: int64 := alloc(4096);
  var dn: int64 := HerkunftKanonisch(fd, db, 4096);
  if (dn <= wn) { return 0; }
  var i: int64 := 0;
  while (i < wn) {
    if (peek8(db + i) != peek8(wb + i)) { return 0; }
    i := i + 1;
  }
  // Wurzel "/" endet selbst auf '/'; sonst muss die Datei mit '/' weitergehen.
  if (peek8(wb + wn - 1) == 47) { return 1; }
  if (peek8(db + wn) != 47) { return 0; }
  return 1;
}
