// src/parse_cache.lyx — #2176: eine Unit wird einmal gelesen und geparst.
//
// Gemessen am Selbstbau (1.2.26A, --time-trace und strace -e trace=%file):
// 81 verschiedene Units, 163 Dateioeffnungen — jede Unit wird zweimal
// gelesen, src/lyxc.lyx dreimal. Im perf-Profil tragen Lexer und Parser
// zusammen 23,4 % (13,21 % + 10,17 %), also ist etwa die Haelfte davon
// doppelte Arbeit.
//
// Schluessel ist der MODULNAME, nicht der Pfad: beide Seiten bekommen ihn als
// Argument, und die Aufloesung ist in allen vier Stellen (sema, Codegen,
// ir_lower, Installationspfad) bewusst synchron gehalten — die Kommentare
// dort sagen ausdruecklich, dass sie uebereinstimmen MUESSEN, weil sonst der
// eine Weg die Unit findet und der andere nicht.
//
// Mitgegeben wird der QUELLTEXT. Die Knoten tragen Offsets in genau diesen
// Puffer (cg_nsval liest aus pSrc); wer die Knotentabelle uebernimmt und
// seinen eigenen, zweiten Puffer behaelt, liest Namen aus fremdem Text.
//
// Die Tabellen bleiben gueltig, obwohl der Erzeuger sein Parser-Objekt mit
// `dispose` freigibt: der Compiler benutzt src/std/alloc.lyx, eine Arena,
// deren `free` ein No-op ist (es gibt zwei Allokatoren, siehe CLAUDE.md).
// Das ist eine Zusicherung dieser Unit, kein Zufall — wer den Allokator
// tauscht, muss hier nachsehen.

import src.std.alloc;

// Eintrag: {nameOff, nameLen, src, nodes, nodeCount, head, integrityMs} = 56
//
// `integrityMs` ist mit drin, weil der Codegen diesen Wert NACH dem Parsen am
// Parser-Objekt abliest (#1878: ein `@integrity(interval: N)` in einer
// importierten Unit bringt sein Intervall mit). Wer nur Knoten und Quelltext
// hinterlegt, verliert ihn beim Treffer — still, und der gesetzte Wert waere
// wirkungslos, je nachdem in welcher Datei er steht.
con PC_SZ: int64 := 56;
con PC_OFF_NAMELEN:   int64 := 8;
con PC_OFF_SRC:       int64 := 16;
con PC_OFF_NODES:     int64 := 24;
con PC_OFF_NODECOUNT: int64 := 32;
con PC_OFF_HEAD:      int64 := 40;
con PC_OFF_INTEG:     int64 := 48;

pub var pcTab:   int64 := 0;
pub var pcAnz:   int64 := 0;
pub var pcCap:   int64 := 0;
pub var pcNamen: int64 := 0;   // Namenspuffer
pub var pcNamLen: int64 := 0;
pub var pcNamCap: int64 := 0;
pub var pcTreffer: int64 := 0;   // Messung: wiederverwendete Units
pub var pcEintraege: int64 := 0;

fn pcInit() {
  if (pcCap != 0) { return; }
  pcCap := 256;
  pcTab := alloc(pcCap * PC_SZ);
  pcNamCap := 16384;
  pcNamen := alloc(pcNamCap);
  pcNamLen := 0;
  pcAnz := 0;
}

fn pcGleich(off: int64, len: int64, nm: pchar, nl: int64): int64 {
  if (len != nl) { return 0; }
  var i: int64 := 0;
  while (i < len) {
    if (peek8(pcNamen + off + i) != peek8((nm as int64) + i)) { return 0; }
    i := i + 1;
  }
  return 1;
}

// Index des Eintrags zu diesem Modulnamen, sonst -1.
pub fn pcFinden(nm: pchar, nl: int64): int64 {
  pcInit();
  if (nl <= 0) { return 0 - 1; }
  var i: int64 := 0;
  while (i < pcAnz) {
    var e: int64 := pcTab + i * PC_SZ;
    if (pcGleich(peek64(e), peek64(e + PC_OFF_NAMELEN), nm, nl) != 0) { return i; }
    i := i + 1;
  }
  return 0 - 1;
}

pub fn pcSrc(idx: int64): pchar       { return peek64(pcTab + idx * PC_SZ + PC_OFF_SRC) as pchar; }
pub fn pcNodes(idx: int64): int64     { return peek64(pcTab + idx * PC_SZ + PC_OFF_NODES); }
pub fn pcNodeCount(idx: int64): int64 { return peek64(pcTab + idx * PC_SZ + PC_OFF_NODECOUNT); }
pub fn pcHead(idx: int64): int64      { return peek64(pcTab + idx * PC_SZ + PC_OFF_HEAD); }
pub fn pcInteg(idx: int64): int64     { return peek64(pcTab + idx * PC_SZ + PC_OFF_INTEG); }

// Eine geparste Unit hinterlegen. Ein zweiter Aufruf mit demselben Namen
// laesst den ersten Eintrag stehen: wer zuerst parst, gibt den Stand vor, und
// alle spaeteren Phasen sehen denselben. Scheitert das Parsen, wird NICHTS
// hinterlegt — ein halber Baum im Cache waere ein stiller Fehler fuer jede
// Phase danach.
pub fn pcEintragen(nm: pchar, nl: int64, src: pchar, nodes: int64, nodeCount: int64, head: int64,
                   integMs: int64) {
  pcInit();
  if (nl <= 0 || nodes == 0 || nodeCount <= 0) { return; }
  if (pcFinden(nm, nl) >= 0) { return; }
  if (pcAnz >= pcCap) { return; }               // voll: ab hier wird wie bisher geparst
  if (pcNamLen + nl >= pcNamCap) { return; }
  var off: int64 := pcNamLen;
  var i: int64 := 0;
  while (i < nl) {
    poke8(pcNamen + off + i, peek8((nm as int64) + i));
    i := i + 1;
  }
  pcNamLen := pcNamLen + nl;
  var e: int64 := pcTab + pcAnz * PC_SZ;
  poke64(e, off);
  poke64(e + PC_OFF_NAMELEN, nl);
  poke64(e + PC_OFF_SRC, src as int64);
  poke64(e + PC_OFF_NODES, nodes);
  poke64(e + PC_OFF_NODECOUNT, nodeCount);
  poke64(e + PC_OFF_HEAD, head);
  poke64(e + PC_OFF_INTEG, integMs);
  pcAnz := pcAnz + 1;
  pcEintraege := pcEintraege + 1;
}

pub fn pcTrefferZaehlen() { pcTreffer := pcTreffer + 1; }
