// src/tools/lbf/iofs_store.lyx — LX-32 In-Memory IOFS-Page-Store
//
// Einfacher Key-Value-Store: LPID → (page_ptr, edge_count).
// Für POSIX-Simulation ohne echten LyxOS-Kernel.
//
// Store-Struct-Layout:
//   +0  [8] count     — belegte Einträge
//   +8  [8] capacity  — maximale Einträge
//   +16 [8] entries   — Zeiger auf Entry-Array
//
// Entry-Layout (IOFS_STORE_ENTRY_SZ = 24 Bytes):
//   +0  [8] lpid
//   +8  [8] page_ptr
//   +16 [8] edge_count
//
// Import: import src.tools.lbf.iofs_store;

import src.std.alloc;

pub con IOFS_STORE_HDR_SZ   : int64 := 24;
pub con IOFS_STORE_ENTRY_SZ : int64 := 24;

// ── iofs_store_alloc ──────────────────────────────────────────────────────────

pub fn iofs_store_alloc(capacity: int64): int64 {
    var s: int64 := alloc(IOFS_STORE_HDR_SZ);
    poke64(s + 0,  0);
    poke64(s + 8,  capacity);
    var entries: int64 := alloc(capacity * IOFS_STORE_ENTRY_SZ);
    poke64(s + 16, entries);
    return s;
}

// ── iofs_store_free ───────────────────────────────────────────────────────────

pub fn iofs_store_free(s: int64) {
    var cap: int64 := peek64(s + 8);
    var entries: int64 := peek64(s + 16);
    free(entries, cap * IOFS_STORE_ENTRY_SZ);
    free(s, IOFS_STORE_HDR_SZ);
}

// ── iofs_store_add ────────────────────────────────────────────────────────────
//
// Fügt einen Eintrag hinzu. Rückgabe: 0=ok, -1=voll.

pub fn iofs_store_add(s: int64, lpid: int64, page_ptr: int64, edge_count: int64): int64 {
    var count: int64 := peek64(s + 0);
    var cap:   int64 := peek64(s + 8);
    if count >= cap { return 0 - 1; }
    var entries: int64 := peek64(s + 16);
    var slot: int64 := entries + count * IOFS_STORE_ENTRY_SZ;
    poke64(slot + 0,  lpid);
    poke64(slot + 8,  page_ptr);
    poke64(slot + 16, edge_count);
    poke64(s + 0, count + 1);
    return 0;
}

// ── iofs_store_lookup ─────────────────────────────────────────────────────────
//
// Gibt page_ptr für lpid zurück, oder 0 falls nicht gefunden.

pub fn iofs_store_lookup(s: int64, lpid: int64): int64 {
    var count:   int64 := peek64(s + 0);
    var entries: int64 := peek64(s + 16);
    var i: int64 := 0;
    while i < count {
        var slot: int64 := entries + i * IOFS_STORE_ENTRY_SZ;
        if peek64(slot + 0) == lpid { return peek64(slot + 8); }
        i := i + 1;
    }
    return 0;
}

// ── iofs_store_edge_count ─────────────────────────────────────────────────────
//
// Gibt edge_count für lpid zurück, oder -1 falls nicht gefunden.

pub fn iofs_store_edge_count(s: int64, lpid: int64): int64 {
    var count:   int64 := peek64(s + 0);
    var entries: int64 := peek64(s + 16);
    var i: int64 := 0;
    while i < count {
        var slot: int64 := entries + i * IOFS_STORE_ENTRY_SZ;
        if peek64(slot + 0) == lpid { return peek64(slot + 16); }
        i := i + 1;
    }
    return 0 - 1;
}

// ── iofs_store_count ──────────────────────────────────────────────────────────

pub fn iofs_store_count(s: int64): int64 {
    return peek64(s + 0);
}

// ── iofs_store_lpid_at ────────────────────────────────────────────────────────
//
// Gibt lpid des i-ten Eintrags zurück (0-basiert). -1 wenn out of range.

pub fn iofs_store_lpid_at(s: int64, i: int64): int64 {
    if i >= peek64(s + 0) { return 0 - 1; }
    var entries: int64 := peek64(s + 16);
    return peek64(entries + i * IOFS_STORE_ENTRY_SZ + 0);
}
