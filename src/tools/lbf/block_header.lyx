// src/tools/lbf/block_header.lyx — LX-25 Block Header I/O für LBF-Nativ (LYX!)
//
// Lesen, Schreiben und Validieren des 64-Byte-Block-Headers.
// Kompiliert sowohl für --target=x86_64 als auch --target=lyxos.
//
// Import: import src.tools.lbf.block_header;

import src.std.lyxos.lbf_layout;

// ── CRC32C (Castagnoli, Polynomial 0x82F63B78 reflected) ─────────────────────

fn crc32c(data: int64, len: int64): int64 {
    var crc: int64 := 0xFFFFFFFF;
    var i: int64 := 0;
    while i < len {
        crc := crc ^ (peek8(data + i) & 0xFF);
        var bit: int64 := 0;
        while bit < 8 {
            if (crc & 1) != 0 {
                crc := (crc >> 1) ^ 0x82F63B78;
            } else {
                crc := crc >> 1;
            }
            bit := bit + 1;
        }
        i := i + 1;
    }
    return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF;
}

// ── lbf_header_init ───────────────────────────────────────────────────────────
//
// Befüllt die 64-Byte-Block-Header-Region bei `buf`.
// is_genesis != 0 → setzt edge_offset und meta_offset auf 0x0040.
// block_crc32c wird auf 0 gesetzt und muss danach via lbf_header_set_crc
// befüllt werden.

pub fn lbf_header_init(buf: int64, block_index: int64, total_blocks: int64, compiled_at: int64, is_genesis: int64) {
    // Zero-fill die 64 Header-Bytes (8× poke64)
    var zi: int64 := 0;
    while zi < 64 {
        poke64(buf + zi, 0);
        zi := zi + 8;
    }

    // Magic: 'L' 'Y' 'X' '!'
    poke8(buf + LBF_H_MAGIC,     LBF_MAGIC_0);
    poke8(buf + LBF_H_MAGIC + 1, LBF_MAGIC_1);
    poke8(buf + LBF_H_MAGIC + 2, LBF_MAGIC_2);
    poke8(buf + LBF_H_MAGIC + 3, LBF_MAGIC_3);

    // page_type = 0x04 (LBF_Executable)
    poke8(buf + LBF_H_PAGE_TYPE, LBF_PAGE_EXECUTABLE);

    // edge_offset und meta_offset
    if is_genesis != 0 {
        poke16(buf + LBF_H_EDGE_OFF, LBF_GENESIS_EDGE_OFF);
        poke32(buf + LBF_H_META_OFF, LBF_GENESIS_META_OFF);
    }

    // payload_size = 4032
    poke16(buf + LBF_H_PAYLOAD_SZ, LBF_PAYLOAD_SIZE);

    // block_index und total_blocks
    poke32(buf + LBF_H_BLOCK_IDX, block_index);
    poke32(buf + LBF_H_TOTAL_BLK, total_blocks);

    // compiled_at (Epoch µs)
    poke64(buf + LBF_H_COMPILED_AT, compiled_at);
}

// ── lbf_header_set_immutable ─────────────────────────────────────────────────
//
// Setzt flags |= 0x01 (Immutable). Für .text- und .rodata-Blöcke.

pub fn lbf_header_set_immutable(buf: int64) {
    poke8(buf + LBF_H_FLAGS, peek8(buf + LBF_H_FLAGS) | LBF_FLAG_IMMUTABLE);
}

// ── lbf_header_set_crc ───────────────────────────────────────────────────────
//
// Berechnet CRC32C des Payloads (LBF_PAYLOAD_SIZE = 4032 Bytes) und speichert
// das Ergebnis im Header bei buf + LBF_H_CRC32C.

pub fn lbf_header_set_crc(buf: int64, payload: int64) {
    poke32(buf + LBF_H_CRC32C, crc32c(payload, LBF_PAYLOAD_SIZE));
}

// ── lbf_header_validate ──────────────────────────────────────────────────────
//
// Prüft Magic und CRC32C des Blocks.
// Payload wird bei buf + LBF_HEADER_SIZE (= buf + 64) erwartet.
//
// Rückgabe: 0=OK, -1=Magic-Fehler, -2=CRC-Fehler.

pub fn lbf_header_validate(buf: int64): int64 {
    if peek8(buf + LBF_H_MAGIC)     != LBF_MAGIC_0 { return 0 - 1; }
    if peek8(buf + LBF_H_MAGIC + 1) != LBF_MAGIC_1 { return 0 - 1; }
    if peek8(buf + LBF_H_MAGIC + 2) != LBF_MAGIC_2 { return 0 - 1; }
    if peek8(buf + LBF_H_MAGIC + 3) != LBF_MAGIC_3 { return 0 - 1; }

    // peek32 sign-extends → mask to 32 bits before comparing with CRC32C result
    var stored: int64 := peek32(buf + LBF_H_CRC32C) & 0xFFFFFFFF;
    var computed: int64 := crc32c(buf + LBF_HEADER_SIZE, LBF_PAYLOAD_SIZE);
    if stored != computed { return 0 - 2; }

    return 0;
}

// ── lbf_header_is_genesis ────────────────────────────────────────────────────
//
// Gibt true zurück wenn meta_offset == 0x0040 (Genesis-Block-Kennung).

pub fn lbf_header_is_genesis(buf: int64): bool {
    return peek32(buf + LBF_H_META_OFF) == LBF_GENESIS_META_OFF;
}
