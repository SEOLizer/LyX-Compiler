// src/tools/lbf/elf_builder.lyx — LX-31 Minimal-ELF64-Builder für LBF-Loader
//
// Baut ein ausführbares ELF64 aus einem LBF-Code-Puffer.
// Code wird bei VA 0x400000 gemappt (= LBF-Nativ entry_point).
//
// Datei-Layout:
//   Offset 0x0000–0x0077: ELF-Header (64 B) + PT_LOAD (56 B)
//   Offset 0x0078–0x0FFF: Padding (Nullbytes)
//   Offset 0x1000–...:   Code-Payload
//
// PT_LOAD: p_offset=0x1000, p_vaddr=0x400000, p_flags=R|X, p_align=0x1000
//
// Import: import src.tools.lbf.elf_builder;

// ── lbf_build_exec_elf ────────────────────────────────────────────────────────
//
// Schreibt ein minimales ELF64 in outBuf.
// outBuf muss mindestens (0x1000 + codeLen) Bytes groß sein.
// Rückgabe: ELF-Größe in Bytes (= 0x1000 + codeLen), oder -1 bei Fehler.

pub fn lbf_build_exec_elf(codeBuf: int64, codeLen: int64, outBuf: int64): int64 {
    var elfSz: int64 := 0x1000 + codeLen;

    // Puffer auf 0 initialisieren
    var zi: int64 := 0;
    while zi < elfSz { poke8(outBuf + zi, 0); zi := zi + 1; }

    // ── ELF-Header (64 Bytes) ─────────────────────────────────────────────────
    // e_ident magic: \x7fELF
    poke8(outBuf + 0, 127); poke8(outBuf + 1, 69);
    poke8(outBuf + 2, 76);  poke8(outBuf + 3, 70);
    poke8(outBuf + 4,  2);  // ELFCLASS64
    poke8(outBuf + 5,  1);  // ELFDATA2LSB
    poke8(outBuf + 6,  1);  // EV_CURRENT
    poke8(outBuf + 7,  0);  // ELFOSABI_NONE (0–15 padding = 0)

    // e_type = ET_EXEC (2), LE16
    poke8(outBuf + 16, 2); poke8(outBuf + 17, 0);
    // e_machine = EM_X86_64 (62), LE16
    poke8(outBuf + 18, 62); poke8(outBuf + 19, 0);
    // e_version = 1, LE32
    poke8(outBuf + 20, 1); poke8(outBuf + 21, 0); poke8(outBuf + 22, 0); poke8(outBuf + 23, 0);
    // e_entry = 0x400000, LE64
    poke8(outBuf + 24, 0); poke8(outBuf + 25, 0); poke8(outBuf + 26, 0x40); poke8(outBuf + 27, 0);
    poke8(outBuf + 28, 0); poke8(outBuf + 29, 0); poke8(outBuf + 30, 0); poke8(outBuf + 31, 0);
    // e_phoff = 64, LE64
    poke8(outBuf + 32, 64); poke8(outBuf + 33, 0); poke8(outBuf + 34, 0); poke8(outBuf + 35, 0);
    poke8(outBuf + 36, 0);  poke8(outBuf + 37, 0); poke8(outBuf + 38, 0); poke8(outBuf + 39, 0);
    // e_shoff = 0 (already 0)
    // e_flags = 0 (already 0)
    // e_ehsize = 64, LE16
    poke8(outBuf + 52, 64); poke8(outBuf + 53, 0);
    // e_phentsize = 56, LE16
    poke8(outBuf + 54, 56); poke8(outBuf + 55, 0);
    // e_phnum = 1, LE16
    poke8(outBuf + 56, 1); poke8(outBuf + 57, 0);
    // e_shentsize = 64, LE16
    poke8(outBuf + 58, 64); poke8(outBuf + 59, 0);
    // e_shnum = 0, e_shstrndx = 0 (already 0)

    // ── PT_LOAD (56 Bytes) ab Offset 64 ──────────────────────────────────────
    var ph: int64 := outBuf + 64;
    // p_type = PT_LOAD (1), LE32
    poke8(ph + 0, 1); poke8(ph + 1, 0); poke8(ph + 2, 0); poke8(ph + 3, 0);
    // p_flags = PF_R|PF_X (5), LE32
    poke8(ph + 4, 5); poke8(ph + 5, 0); poke8(ph + 6, 0); poke8(ph + 7, 0);
    // p_offset = 0x1000, LE64
    poke8(ph + 8,  0); poke8(ph + 9,  0x10); poke8(ph + 10, 0); poke8(ph + 11, 0);
    poke8(ph + 12, 0); poke8(ph + 13, 0);    poke8(ph + 14, 0); poke8(ph + 15, 0);
    // p_vaddr = 0x400000, LE64
    poke8(ph + 16, 0); poke8(ph + 17, 0); poke8(ph + 18, 0x40); poke8(ph + 19, 0);
    poke8(ph + 20, 0); poke8(ph + 21, 0); poke8(ph + 22, 0);    poke8(ph + 23, 0);
    // p_paddr = 0x400000, LE64 (same as vaddr)
    poke8(ph + 24, 0); poke8(ph + 25, 0); poke8(ph + 26, 0x40); poke8(ph + 27, 0);
    poke8(ph + 28, 0); poke8(ph + 29, 0); poke8(ph + 30, 0);    poke8(ph + 31, 0);
    // p_filesz = codeLen, LE64
    poke8(ph + 32, codeLen & 0xFF);
    poke8(ph + 33, (codeLen >> 8)  & 0xFF);
    poke8(ph + 34, (codeLen >> 16) & 0xFF);
    poke8(ph + 35, (codeLen >> 24) & 0xFF);
    poke8(ph + 36, (codeLen >> 32) & 0xFF);
    poke8(ph + 37, (codeLen >> 40) & 0xFF);
    poke8(ph + 38, (codeLen >> 48) & 0xFF);
    poke8(ph + 39, (codeLen >> 56) & 0xFF);
    // p_memsz = codeLen, LE64 (same as filesz)
    poke8(ph + 40, codeLen & 0xFF);
    poke8(ph + 41, (codeLen >> 8)  & 0xFF);
    poke8(ph + 42, (codeLen >> 16) & 0xFF);
    poke8(ph + 43, (codeLen >> 24) & 0xFF);
    poke8(ph + 44, (codeLen >> 32) & 0xFF);
    poke8(ph + 45, (codeLen >> 40) & 0xFF);
    poke8(ph + 46, (codeLen >> 48) & 0xFF);
    poke8(ph + 47, (codeLen >> 56) & 0xFF);
    // p_align = 0x1000, LE64
    poke8(ph + 48, 0); poke8(ph + 49, 0x10); poke8(ph + 50, 0); poke8(ph + 51, 0);
    poke8(ph + 52, 0); poke8(ph + 53, 0);    poke8(ph + 54, 0); poke8(ph + 55, 0);

    // ── Code ab Offset 0x1000 ─────────────────────────────────────────────────
    var ci: int64 := 0;
    while ci < codeLen {
        poke8(outBuf + 0x1000 + ci, peek8(codeBuf + ci));
        ci := ci + 1;
    }

    return elfSz;
}
