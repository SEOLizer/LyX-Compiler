// src/tools/lbf/lifecycle.lyx — LX-36 Lifecycle Descriptor Helpers
//
// Ereignis-Deskriptor-Format (11 Bytes pro Eintrag):
//   +0  ev_type    u8    (LBF_EV_STDIN, LBF_EV_TIMER, etc.)
//   +1  param      u16LE (hz für Timer, Signal-Nr, 0 sonst)
//   +3  handler_va u64LE (VA des Handlers, 0=unbekannt bei Kompilierung)
//
// TLV 0x08 Extended Format (Wert-Bytes):
//   byte 0:   kind   (LBF_LC_* Konstante)
//   byte 1:   count  (Anzahl Ereignis-Deskriptoren)
//   bytes 2+: N × LBF_LC_EV_SIZE Ereignis-Deskriptoren
//
// Import: import src.tools.lbf.lifecycle;

import src.std.alloc;
import src.std.lyxos.lbf_layout;
import src.tools.lbf.tlv;

pub con LBF_LC_EV_SIZE  : int64 := 11;  // bytes per event descriptor
pub con LBF_LC_HDR_SIZE : int64 := 2;   // kind(1) + count(1)

// ── Ereignis-Deskriptor Puffer-Verwaltung ─────────────────────────────────────

pub fn lc_ev_alloc(count: int64): int64 {
    return alloc(count * LBF_LC_EV_SIZE);
}

pub fn lc_ev_free(buf: int64, count: int64): void {
    free(buf, count * LBF_LC_EV_SIZE);
}

// Setzt einen Ereignis-Deskriptor an Position idx im Puffer.
pub fn lc_ev_set(buf: int64, idx: int64, ev_type: int64, param: int64, handler_va: int64): void {
    var base: int64 := buf + idx * LBF_LC_EV_SIZE;
    poke8(base,      ev_type);
    poke16(base + 1, param);
    poke64(base + 3, handler_va);
}

// Liest ev_type aus Deskriptor idx.
pub fn lc_ev_type(buf: int64, idx: int64): int64 {
    return peek8(buf + idx * LBF_LC_EV_SIZE) & 0xFF;
}

// Liest param aus Deskriptor idx.
pub fn lc_ev_param(buf: int64, idx: int64): int64 {
    return peek16(buf + idx * LBF_LC_EV_SIZE + 1) & 0xFFFF;
}

// Liest handler_va aus Deskriptor idx.
pub fn lc_ev_va(buf: int64, idx: int64): int64 {
    return peek64(buf + idx * LBF_LC_EV_SIZE + 3);
}

// ── TLV 0x08 Extended Encoder ─────────────────────────────────────────────────

// Fügt TLV LIFECYCLE (0x08) im erweiterten Format hinzu.
// lc:       LBF_LC_* Konstante (kind-Byte)
// ev_buf:   Ereignis-Deskriptor-Puffer aus lc_ev_alloc(), oder 0 wenn ev_count==0
// ev_count: Anzahl Ereignis-Deskriptoren (0 erlaubt)
// used_ptr: Zeiger auf int64-Zähler der belegten TLV-Pool-Bytes.
// Rückgabe: 0=OK, -1=Puffer voll.

pub fn tlv_add_lifecycle_full(tbuf: int64, used_ptr: int64, lc: int64, ev_buf: int64, ev_count: int64): int64 {
    var vlen: int64 := LBF_LC_HDR_SIZE + ev_count * LBF_LC_EV_SIZE;
    var lval: int64 := alloc(vlen);
    poke8(lval,     lc);
    poke8(lval + 1, ev_count);
    var i: int64 := 0;
    while i < ev_count * LBF_LC_EV_SIZE {
        poke8(lval + 2 + i, peek8(ev_buf + i));
        i := i + 1;
    }
    var r: int64 := tlv_append(tbuf, used_ptr, LBF_TLV_LIFECYCLE, lval, vlen);
    free(lval, vlen);
    return r;
}

// ── TLV 0x08 Accessor-Helfer (arbeiten auf dem TLV-Wert-Zeiger aus tlv_find) ──

// kind-Byte aus dem TLV-Wert-Zeiger.
pub fn tlv_lc_kind(val_ptr: int64): int64 {
    return peek8(val_ptr) & 0xFF;
}

// count-Byte aus dem TLV-Wert-Zeiger.
pub fn tlv_lc_count(val_ptr: int64): int64 {
    return peek8(val_ptr + 1) & 0xFF;
}

// ev_type des Ereignis-Deskriptors idx.
pub fn tlv_lc_ev_type(val_ptr: int64, idx: int64): int64 {
    return peek8(val_ptr + LBF_LC_HDR_SIZE + idx * LBF_LC_EV_SIZE) & 0xFF;
}

// param des Ereignis-Deskriptors idx.
pub fn tlv_lc_ev_param(val_ptr: int64, idx: int64): int64 {
    return peek16(val_ptr + LBF_LC_HDR_SIZE + idx * LBF_LC_EV_SIZE + 1) & 0xFFFF;
}

// handler_va des Ereignis-Deskriptors idx.
pub fn tlv_lc_ev_va(val_ptr: int64, idx: int64): int64 {
    return peek64(val_ptr + LBF_LC_HDR_SIZE + idx * LBF_LC_EV_SIZE + 3);
}
