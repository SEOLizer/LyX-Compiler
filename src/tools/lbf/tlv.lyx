// src/tools/lbf/tlv.lyx — LX-27 TLV-Framework für LBF-Nativ Genesis-Payload
//
// TLV-Encoding: [type:u8][length:u16LE][value:length Bytes]
// Kapazität: 3904 Bytes (LBF_TLV_MAX_SIZE) ab GEN_P_TLV_POOL im Genesis-Payload.
// Kompiliert sowohl für --target=x86_64 als auch --target=lyxos.
//
// Import: import src.tools.lbf.tlv;

import src.std.alloc;
import src.std.lyxos.lbf_layout;

// ── tlv_append ────────────────────────────────────────────────────────────────
//
// Hängt einen TLV-Eintrag an den Puffer an.
// used_ptr: Zeiger auf int64-Zähler der belegten Bytes — wird aktualisiert.
// Rückgabe: 0=OK, -1=Puffer voll (Puffer und Zähler unverändert).

pub fn tlv_append(tbuf: int64, used_ptr: int64, tag: int64, val: int64, vlen: int64): int64 {
    var cur: int64 := peek64(used_ptr);
    if cur + 3 + vlen > LBF_TLV_MAX_SIZE { return 0 - 1; }
    poke8(tbuf + cur,      tag);
    poke16(tbuf + cur + 1, vlen);
    var i: int64 := 0;
    while i < vlen {
        poke8(tbuf + cur + 3 + i, peek8(val + i));
        i := i + 1;
    }
    poke64(used_ptr, cur + 3 + vlen);
    return 0;
}

// ── tlv_find ─────────────────────────────────────────────────────────────────
//
// Sucht den ersten TLV-Eintrag mit gegebenem Tag.
// used: Wert (aktuelle belegte Bytes im Puffer).
// out_val: Zeiger auf int64 — empfängt die Adresse des Werts im Puffer.
// out_len: Zeiger auf int64 — empfängt die Länge des Werts.
// Rückgabe: 0=gefunden, -1=nicht gefunden.

pub fn tlv_find(tbuf: int64, used: int64, tag: int64, out_val: int64, out_len: int64): int64 {
    var off: int64 := 0;
    while off + 3 <= used {
        var t: int64 := peek8(tbuf + off) & 0xFF;
        var len: int64 := peek16(tbuf + off + 1);
        if t == tag {
            poke64(out_val, tbuf + off + 3);
            poke64(out_len, len);
            return 0;
        }
        off := off + 3 + len;
    }
    return 0 - 1;
}

// ── tlv_count ─────────────────────────────────────────────────────────────────
//
// Zählt alle TLV-Einträge im Puffer (unabhängig vom Tag).
// used: Wert (aktuelle belegte Bytes im Puffer).

pub fn tlv_count(tbuf: int64, used: int64): int64 {
    var count: int64 := 0;
    var off: int64 := 0;
    while off + 3 <= used {
        var len: int64 := peek16(tbuf + off + 1);
        count := count + 1;
        off := off + 3 + len;
    }
    return count;
}

// ── tlv_add_intent ────────────────────────────────────────────────────────────
//
// Fügt TLV HUMAN_INTENT (0x01) hinzu.
// text: Null-terminierter UTF-8-String — wird bis zum Null oder max 512 Bytes gelesen.
// used_ptr: Zeiger auf int64-Zähler.

pub fn tlv_add_intent(tbuf: int64, used_ptr: int64, text: int64): int64 {
    var len: int64 := 0;
    while len < 512 && peek8(text + len) != 0 {
        len := len + 1;
    }
    return tlv_append(tbuf, used_ptr, LBF_TLV_HUMAN_INTENT, text, len);
}

// ── tlv_add_section ───────────────────────────────────────────────────────────
//
// Fügt TLV SECTION_MAP (0x09) hinzu.
// Value-Encoding: [block_start:u32][block_count:u16][sect_type:u8][prot:u8] = 8 Bytes.
// sect_type: LBF_SECT_TYPE_TEXT/RODATA/DATA/BSS.
// prot:      LBF_SECT_PROT_RX / LBF_SECT_PROT_R / LBF_SECT_PROT_RW.
// used_ptr: Zeiger auf int64-Zähler.

pub fn tlv_add_section(tbuf: int64, used_ptr: int64, block_start: int64, block_count: int64, sect_type: int64, prot: int64): int64 {
    var sval: int64 := alloc(8);
    poke32(sval,     block_start);
    poke16(sval + 4, block_count);
    poke8(sval + 6,  sect_type);
    poke8(sval + 7,  prot);
    var r: int64 := tlv_append(tbuf, used_ptr, LBF_TLV_SECTION_MAP, sval, 8);
    free(sval, 8);
    return r;
}

// ── tlv_add_capabilities ─────────────────────────────────────────────────────
//
// Fügt TLV CAPABILITIES (0x05) hinzu. cap_bits als uint64 (8 Bytes LE).
// used_ptr: Zeiger auf int64-Zähler.

pub fn tlv_add_capabilities(tbuf: int64, used_ptr: int64, cap_bits: int64): int64 {
    var cval: int64 := alloc(8);
    poke64(cval, cap_bits);
    var r: int64 := tlv_append(tbuf, used_ptr, LBF_TLV_CAPABILITIES, cval, 8);
    free(cval, 8);
    return r;
}

// ── tlv_add_lifecycle ─────────────────────────────────────────────────────────
//
// Fügt TLV LIFECYCLE (0x08) hinzu. lc: LBF_LC_* Konstante (1 Byte).
// lc: 0=ONE_SHOT, 1=EVENT_LOOP, 2=DAEMON, 3=REACTIVE.
// used_ptr: Zeiger auf int64-Zähler.

pub fn tlv_add_lifecycle(tbuf: int64, used_ptr: int64, lc: int64): int64 {
    var lval: int64 := alloc(1);
    poke8(lval, lc);
    var r: int64 := tlv_append(tbuf, used_ptr, LBF_TLV_LIFECYCLE, lval, 1);
    free(lval, 1);
    return r;
}
