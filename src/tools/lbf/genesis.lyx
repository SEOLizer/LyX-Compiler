// src/tools/lbf/genesis.lyx — LX-26 Genesis Content Serializer
//
// Lesen und Schreiben der 4032-Byte Genesis-Payload des LBF-Nativ-Formats.
// Kompiliert sowohl für --target=x86_64 als auch --target=lyxos.
//
// Import: import src.tools.lbf.genesis;

import src.std.alloc;
import src.std.lyxos.lbf_layout;

// ── Daten-Puffer-Layout (GEN_D_*) ────────────────────────────────────────────
//
// genesis_data_alloc gibt einen GEN_D_SIZE-Byte-Puffer zurück.
// Alle numerischen Felder als int64 (8 Bytes), Byte-Arrays inline.
//
//  +0   [8]  content_type
//  +8   [8]  target_arch
//  +16  [8]  os_version_min
//  +24  [8]  entry_point
//  +32  [8]  file_size
//  +40  [8]  text_blocks
//  +48  [8]  rodata_blocks
//  +56  [8]  data_blocks
//  +64  [8]  bss_blocks
//  +72  [8]  stack_size
//  +80  [8]  compiler_ver
//  +88  [8]  compiled_at
//  +96  [16] compiler_name  (max 15 Zeichen + NUL)
//  +112 [16] compiler_uuid  (16 Raw-Bytes)
//  +128 [32] source_sha256  (32 Raw-Bytes)
//  +160 [8]  tlv_offset
//  +168 [8]  tlv_used

pub con GEN_D_CONTENT_TYPE  : int64 := 0;
pub con GEN_D_TARGET_ARCH   : int64 := 8;
pub con GEN_D_OS_VER_MIN    : int64 := 16;
pub con GEN_D_ENTRY_POINT   : int64 := 24;
pub con GEN_D_FILE_SIZE     : int64 := 32;
pub con GEN_D_TEXT_BLOCKS   : int64 := 40;
pub con GEN_D_RODATA_BLOCKS : int64 := 48;
pub con GEN_D_DATA_BLOCKS   : int64 := 56;
pub con GEN_D_BSS_BLOCKS    : int64 := 64;
pub con GEN_D_STACK_SIZE    : int64 := 72;
pub con GEN_D_COMPILER_VER  : int64 := 80;
pub con GEN_D_COMPILED_AT   : int64 := 88;
pub con GEN_D_COMPILER_NAME : int64 := 96;
pub con GEN_D_COMPILER_UUID : int64 := 112;
pub con GEN_D_SOURCE_SHA256 : int64 := 128;
pub con GEN_D_TLV_OFFSET    : int64 := 160;
pub con GEN_D_TLV_USED      : int64 := 168;
pub con GEN_D_SIZE          : int64 := 176;

// ── genesis_data_alloc ────────────────────────────────────────────────────────
//
// Allokiert und initialisiert einen GEN_D_SIZE-Puffer mit Standard-Defaults:
//   content_type = 1 (LBF_GEN_CONTENT_EXECUTABLE)
//   target_arch  = 1 (LBF_ARCH_X86_64)
//   stack_size   = 0x20000 (131072 Bytes)
//   tlv_offset   = 128 (GEN_P_TLV_POOL)
//   compiler_name = "lyxc" (Bytes 4–15 = 0x00)
// Alle anderen Felder = 0 (alloc liefert Zero-initialized Memory).

pub fn genesis_data_alloc(): int64 {
    var d: int64 := alloc(GEN_D_SIZE);

    poke64(d + GEN_D_CONTENT_TYPE, LBF_GEN_CONTENT_EXECUTABLE);
    poke64(d + GEN_D_TARGET_ARCH,  LBF_ARCH_X86_64);
    poke64(d + GEN_D_STACK_SIZE,   131072);
    poke64(d + GEN_D_TLV_OFFSET,   GEN_P_TLV_POOL);

    // compiler_name = "lyxc" — 'l'=108, 'y'=121, 'x'=120, 'c'=99
    poke8(d + GEN_D_COMPILER_NAME,     108);
    poke8(d + GEN_D_COMPILER_NAME + 1, 121);
    poke8(d + GEN_D_COMPILER_NAME + 2, 120);
    poke8(d + GEN_D_COMPILER_NAME + 3, 99);

    return d;
}

// ── genesis_data_free ─────────────────────────────────────────────────────────

pub fn genesis_data_free(d: int64) {
    free(d, GEN_D_SIZE);
}

// ── genesis_serialize ─────────────────────────────────────────────────────────
//
// Schreibt alle Felder aus dem Daten-Puffer d in die 4032-Byte-Payload p.
// file_crc32c wird immer auf 0x00000000 gesetzt (nach außen zu berechnen).
// Der TLV-Pool-Inhalt wird vom TLV-Framework (LX-27) direkt in p verwaltet.

pub fn genesis_serialize(d: int64, p: int64) {
    poke8(p  + GEN_P_CONTENT_TYPE,   peek64(d + GEN_D_CONTENT_TYPE));
    poke8(p  + GEN_P_TARGET_ARCH,    peek64(d + GEN_D_TARGET_ARCH));
    poke16(p + GEN_P_OS_VER_MIN,     peek64(d + GEN_D_OS_VER_MIN));
    poke64(p + GEN_P_ENTRY_POINT,    peek64(d + GEN_D_ENTRY_POINT));
    poke32(p + GEN_P_FILE_SIZE,      peek64(d + GEN_D_FILE_SIZE));
    poke16(p + GEN_P_TEXT_BLOCKS,    peek64(d + GEN_D_TEXT_BLOCKS));
    poke16(p + GEN_P_RODATA_BLOCKS,  peek64(d + GEN_D_RODATA_BLOCKS));
    poke16(p + GEN_P_DATA_BLOCKS,    peek64(d + GEN_D_DATA_BLOCKS));
    poke16(p + GEN_P_BSS_BLOCKS,     peek64(d + GEN_D_BSS_BLOCKS));
    poke32(p + GEN_P_STACK_SIZE,     peek64(d + GEN_D_STACK_SIZE));
    poke32(p + GEN_P_FILE_CRC32C,    0);

    var ci: int64 := 0;
    while ci < 16 {
        poke8(p + GEN_P_COMPILER_NAME + ci, peek8(d + GEN_D_COMPILER_NAME + ci));
        ci := ci + 1;
    }

    poke32(p + GEN_P_COMPILER_VER, peek64(d + GEN_D_COMPILER_VER));
    poke64(p + GEN_P_COMPILED_AT,  peek64(d + GEN_D_COMPILED_AT));

    var ui: int64 := 0;
    while ui < 16 {
        poke8(p + GEN_P_COMPILER_UUID + ui, peek8(d + GEN_D_COMPILER_UUID + ui));
        ui := ui + 1;
    }

    var si: int64 := 0;
    while si < 32 {
        poke8(p + GEN_P_SOURCE_SHA256 + si, peek8(d + GEN_D_SOURCE_SHA256 + si));
        si := si + 1;
    }

    poke16(p + GEN_P_TLV_OFFSET, peek64(d + GEN_D_TLV_OFFSET));
    poke16(p + GEN_P_TLV_USED,   peek64(d + GEN_D_TLV_USED));
}

// ── genesis_deserialize ───────────────────────────────────────────────────────
//
// Liest die 4032-Byte-Payload p und schreibt alle Felder in den Daten-Puffer d.
// peek32 sign-extends → & 0xFFFFFFFF für alle u32-Felder.
// peek16 zero-extends → kein Masking nötig.

pub fn genesis_deserialize(p: int64, d: int64) {
    poke64(d + GEN_D_CONTENT_TYPE,  peek8(p  + GEN_P_CONTENT_TYPE) & 0xFF);
    poke64(d + GEN_D_TARGET_ARCH,   peek8(p  + GEN_P_TARGET_ARCH)  & 0xFF);
    poke64(d + GEN_D_OS_VER_MIN,    peek16(p + GEN_P_OS_VER_MIN));
    poke64(d + GEN_D_ENTRY_POINT,   peek64(p + GEN_P_ENTRY_POINT));
    poke64(d + GEN_D_FILE_SIZE,     peek32(p + GEN_P_FILE_SIZE)     & 0xFFFFFFFF);
    poke64(d + GEN_D_TEXT_BLOCKS,   peek16(p + GEN_P_TEXT_BLOCKS));
    poke64(d + GEN_D_RODATA_BLOCKS, peek16(p + GEN_P_RODATA_BLOCKS));
    poke64(d + GEN_D_DATA_BLOCKS,   peek16(p + GEN_P_DATA_BLOCKS));
    poke64(d + GEN_D_BSS_BLOCKS,    peek16(p + GEN_P_BSS_BLOCKS));
    poke64(d + GEN_D_STACK_SIZE,    peek32(p + GEN_P_STACK_SIZE)    & 0xFFFFFFFF);
    poke64(d + GEN_D_COMPILER_VER,  peek32(p + GEN_P_COMPILER_VER)  & 0xFFFFFFFF);
    poke64(d + GEN_D_COMPILED_AT,   peek64(p + GEN_P_COMPILED_AT));

    var ci: int64 := 0;
    while ci < 16 {
        poke8(d + GEN_D_COMPILER_NAME + ci, peek8(p + GEN_P_COMPILER_NAME + ci));
        ci := ci + 1;
    }

    var ui: int64 := 0;
    while ui < 16 {
        poke8(d + GEN_D_COMPILER_UUID + ui, peek8(p + GEN_P_COMPILER_UUID + ui));
        ui := ui + 1;
    }

    var si: int64 := 0;
    while si < 32 {
        poke8(d + GEN_D_SOURCE_SHA256 + si, peek8(p + GEN_P_SOURCE_SHA256 + si));
        si := si + 1;
    }

    poke64(d + GEN_D_TLV_OFFSET, peek16(p + GEN_P_TLV_OFFSET));
    poke64(d + GEN_D_TLV_USED,   peek16(p + GEN_P_TLV_USED));
}

// ── genesis_get_entry_point ───────────────────────────────────────────────────
//
// Schnellabfrage: liest entry_point direkt aus der Payload (kein Daten-Puffer).

pub fn genesis_get_entry_point(p: int64): int64 {
    return peek64(p + GEN_P_ENTRY_POINT);
}

// ── genesis_get_total_block_count ─────────────────────────────────────────────
//
// Schnellabfrage: text_blocks + rodata_blocks + data_blocks + bss_blocks + 1
// Das +1 ist der Genesis-Block selbst.

pub fn genesis_get_total_block_count(p: int64): int64 {
    var n: int64 := peek16(p + GEN_P_TEXT_BLOCKS);
    n := n + peek16(p + GEN_P_RODATA_BLOCKS);
    n := n + peek16(p + GEN_P_DATA_BLOCKS);
    n := n + peek16(p + GEN_P_BSS_BLOCKS);
    return n + 1;
}
