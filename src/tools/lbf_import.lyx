// src/tools/lbf_import.lyx — LX-32 LBF-Nativ → IOFS-Import
//
// Usage: lbf_import <file.lbf>
//
// Konvertiert eine LBF-Nativ-Datei in IOFS-Pages und gibt die
// Genesis-LPID auf stdout aus. Jeder LBF-Block → eine IOFS-Page (Typ 0x04).
// Blöcke werden via 0xB001-Kanten verkettet.

import src.std.alloc;
import src.std.io;
import src.tools.lbf.iofs_store;
import src.tools.lbf.importer;

// ── main ──────────────────────────────────────────────────────────────────────

fn main(): int64 {
    var argc: int64 := GetArgC();
    if argc < 2 {
        EPrintStrLn("usage: lbf_import <file.lbf>");
        return 1;
    }
    var path: pchar := GetArg(1) as pchar;

    var store: int64 := iofs_store_alloc(256);
    var lpid: int64 := lbf_import(path, store);

    if lpid == (0 - 1) {
        EPrintStrLn("lbf_import: import failed");
        iofs_store_free(store);
        return 1;
    }

    PrintStr("lbf_import: genesis LPID = ");
    PrintInt(lpid);
    PrintStr("\n");
    PrintStr("lbf_import: pages = ");
    PrintInt(iofs_store_count(store));
    PrintStr("\n");

    iofs_store_free(store);
    return 0;
}
