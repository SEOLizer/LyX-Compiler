// src/tools/lbf_dump.lyx — LX-35 LBF-Nativ Inspection Tool
//
// Usage:
//   lbf_dump <file.lbf>               — vollständiger Dump auf stdout
//   lbf_dump --verify-only <file.lbf> — Exit 0 = gültig, 1 = korrupt
//
// Analogon zu readelf(1) für LYX!-Binaries.

import src.std.alloc;
import src.std.io;
import src.tools.lbf.dumper;

fn str_eq(a: pchar, b: pchar): bool {
    var ia: int64 := a as int64;
    var ib: int64 := b as int64;
    var i: int64 := 0;
    while (peek8(ia + i) & 0xFF) != 0 || (peek8(ib + i) & 0xFF) != 0 {
        if peek8(ia + i) != peek8(ib + i) { return false; }
        i := i + 1;
    }
    return true;
}

fn main(): int64 {
    var argc: int64 := GetArgC();
    if argc < 2 {
        EPrintStrLn("usage: lbf_dump [--verify-only] <file.lbf>");
        return 1;
    }

    var verify_only: int64 := 0;
    var path_idx: int64 := 1;

    if str_eq(GetArg(1) as pchar, "--verify-only"c) {
        verify_only := 1;
        path_idx := 2;
        if argc < 3 {
            EPrintStrLn("usage: lbf_dump [--verify-only] <file.lbf>");
            return 1;
        }
    }

    var path: pchar := GetArg(path_idx) as pchar;

    var fd: int64 := open(path, 0, 0);
    if fd < 0 {
        EPrintStrLn("lbf_dump: cannot open file");
        return 1;
    }
    var fsize: int64 := lseek(fd, 0, 2);
    lseek(fd, 0, 0);
    var fbuf: int64 := alloc(fsize);
    var got: int64 := read(fd, fbuf, fsize);
    close(fd);

    if got != fsize {
        EPrintStrLn("lbf_dump: read error");
        free(fbuf, fsize);
        return 1;
    }

    if verify_only == 1 {
        var rc: int64 := lbf_dump_verify(fbuf, fsize);
        free(fbuf, fsize);
        if rc == 0 {
            PrintStrLn("OK");
            return 0;
        }
        if rc == (0 - 1) { EPrintStrLn("lbf_dump: invalid file size"); }
        if rc == (0 - 2) { EPrintStrLn("lbf_dump: bad magic"); }
        if rc == (0 - 3) { EPrintStrLn("lbf_dump: block CRC mismatch"); }
        if rc == (0 - 4) { EPrintStrLn("lbf_dump: file CRC mismatch"); }
        PrintStrLn("CORRUPT");
        return 1;
    }

    lbf_dump_print_all(fbuf, fsize, path);
    free(fbuf, fsize);
    return 0;
}
