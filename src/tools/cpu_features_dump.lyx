// src/tools/cpu_features_dump.lyx
// #2384: Zeigt JEDE von std.cpu.features ermittelte Faehigkeit der laufenden
// CPU, eine je Zeile als "<flagname> <0|1>". Die Namen sind die des
// Linux-Kernels (arch/x86/include/asm/cpufeatures.h), damit die Ausgabe ohne
// Umschreiben gegen /proc/cpuinfo bzw. `lscpu` gegengelesen werden kann;
// genau das tut tests/cpu_features_test.sh.
//
// Key Locker hat im Kernel keinen Flagnamen (die Unterstuetzung wurde nie
// aufgenommen), die Zeile `keylocker` hat also keine Referenz und wird vom
// Test nur in der Richtung "Referenz nennt es nicht" geprueft.
//
// Uebersetzen: ./lyxc --std-path=. src/tools/cpu_features_dump.lyx -o cpufeat
@description("Zeigt die ueber CPUID ermittelten CPU-Faehigkeiten")
@author("Andreas Röne")
@copyright("2025 Andreas Röne")

import src.std.io;
import std.cpu.features;

fn zeile(name: pchar, wert: int64): int64 {
  PrintStr(name);
  PrintStr(" "c);
  PrintLn(wert);
  return 0;
}

fn main(): int64 {
  zeile("cpuid"c,      CpuHasCpuid());
  zeile("sse2"c,       CpuHasSSE2());
  zeile("sse4_1"c,     CpuHasSSE41());
  zeile("sse4_2"c,     CpuHasSSE42());
  zeile("popcnt"c,     CpuHasPOPCNT());
  zeile("abm"c,        CpuHasLZCNT());
  zeile("avx"c,        CpuHasAVX());
  zeile("avx2"c,       CpuHasAVX2());
  zeile("avx512f"c,    CpuHasAVX512F());
  zeile("fma"c,        CpuHasFMA());
  zeile("bmi1"c,       CpuHasBMI1());
  zeile("bmi2"c,       CpuHasBMI2());
  // Krypto-Erweiterungen (#2384)
  zeile("aes"c,        CpuHasAESNI());
  zeile("pclmulqdq"c,  CpuHasPCLMUL());
  zeile("vaes"c,       CpuHasVAES());
  zeile("vpclmulqdq"c, CpuHasVPCLMUL());
  zeile("sha_ni"c,     CpuHasSHANI());
  zeile("sha512"c,     CpuHasSHA512());
  zeile("sm3"c,        CpuHasSM3());
  zeile("sm4"c,        CpuHasSM4());
  zeile("rdrand"c,     CpuHasRDRAND());
  zeile("rdseed"c,     CpuHasRDSEED());
  zeile("keylocker"c,  CpuHasKeyLocker());
  return 0;
}
