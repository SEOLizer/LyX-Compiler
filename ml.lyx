// ml.lyx - Machine Learning utilities for Lyx
// Linear and Logistic Regression, KNN, KMeans, Naive Bayes, Decision Tree

// Memory constants for mmap-based functions
con PROT_RW: int64 := 3;
con MAP_ANON: int64 := 34;
con FD_NONE: int64 := -1;

// ============================================================================
// Mathematical Helper Functions (f64)
// ============================================================================

pub fn SquareF64(x: f64): f64 {
  return x * x;
}

pub fn AbsF64(x: f64): f64 {
  if (x < 0.0) { return 0.0 - x; }
  return x;
}

// Newton's method square root
pub fn SqrtF64(x: f64): f64 {
  if (x <= 0.0) { return 0.0; }
  var y: f64 := x;
  var z: f64 := (y + 1.0) / 2.0;
  while (z < y) {
    y := z;
    z := (y + x / y) / 2.0;
  }
  return y;
}

// SSE2 sqrtsd raw (for future optimization)
extern fn _sqrtsd(x: f64): f64;

// SSE2 sqrt - uses builtin sqrt
pub fn SqrtF64SSE(x: f64): f64 {
  return _sqrtsd(x);
}

// Exponential function - Taylor series approximation
pub fn ExpF64(x: f64): f64 {
  if (x > 10.0) { return 22000.0; }
  var neg10: f64 := 0.0 - 10.0;
  if (x < neg10) { return 0.0; }
  var x2: f64 := x * x;
  var x3: f64 := x2 * x;
  var x4: f64 := x3 * x;
  return 1.0 + x + x2 * 0.5 + x3 * 0.166666 + x4 * 0.041666;
}

// Sigmoid: σ(z) = 1 / (1 + e^(-z))
pub fn SigmoidF64(z: f64): f64 {
  if (z > 20.0) { return 1.0; }
  var neg20: f64 := 0.0 - 20.0;
  if (z < neg20) { return 0.0; }
  var negz: f64 := 0.0 - z;
  var ez: f64 := ExpF64(negz);
  return 1.0 / (1.0 + ez);
}

// Log (natural logarithm) - inverse of exp
pub fn LogF64(x: f64): f64 {
  if (x <= 0.0) {
    return -100.0;  // Very negative for invalid input
  }
  // This is a placeholder for a proper log implementation.
  // Currently returns 0.0, which is incorrect for most inputs.
  return 0.0;
}

// Log approximation (used by NaiveBayes, DecisionTree)
pub fn NBLog(x: f64): f64 {
  if (x <= 0.0) { return -100.0; }
  if (x >= 1.0) { return 0.0; }
  if (x >= 0.5) { return -0.693 + (x - 0.5) * 1.0; }
  if (x >= 0.25) { return -1.386 + (x - 0.25) * 2.0; }
  if (x >= 0.125) { return -2.079 + (x - 0.125) * 4.0; }
  if (x >= 0.0625) { return -2.772 + (x - 0.0625) * 8.0; }
  if (x >= 0.03125) { return -3.465 + (x - 0.03125) * 16.0; }
  return -5.0 + (x * 10.0);
}

// ============================================================================
// Linear Regression - Gradient Descent
// ============================================================================

var lr_weight: f64;
var lr_bias: f64;
var lr_epochs: int64;
var lr_loss: f64;

pub fn LinearRegressionInit(): void {
  lr_weight := 0.0;
  lr_bias := 0.0;
  lr_epochs := 0;
  lr_loss := 0.0;
}

pub fn LinearRegressionWeight(): f64 { return lr_weight; }
pub fn LinearRegressionBias(): f64 { return lr_bias; }
pub fn LinearRegressionLoss(): f64 { return lr_loss; }
pub fn LinearRegressionEpochs(): int64 { return lr_epochs; }

// Train (1 data point)
pub fn LinearRegressionFit1(
  x0: f64, y0: f64,
  learning_rate: f64,
  epochs: int64
): void {
  var e: int64 := 0;
  while (e < epochs) {
    var pred: f64 := lr_weight * x0 + lr_bias;
    var err: f64 := pred - y0;
    var dw: f64 := err * x0;
    var db: f64 := err;
    lr_weight := lr_weight - learning_rate * dw;
    lr_bias := lr_bias - learning_rate * db;
    lr_loss := err * err;
    e := e + 1;
  }
  lr_epochs := epochs;
}

// Train (2 data points)
pub fn LinearRegressionFit2(
  x0: f64, x1: f64,
  y0: f64, y1: f64,
  learning_rate: f64,
  epochs: int64
): void {
  var e: int64 := 0;
  while (e < epochs) {
    var pred0: f64 := lr_weight * x0 + lr_bias;
    var pred1: f64 := lr_weight * x1 + lr_bias;
    var err0: f64 := pred0 - y0;
    var err1: f64 := pred1 - y1;
    var dw: f64 := (err0 * x0 + err1 * x1) * 0.5;
    var db: f64 := (err0 + err1) * 0.5;
    lr_weight := lr_weight - learning_rate * dw;
    lr_bias := lr_bias - learning_rate * db;
    lr_loss := (err0 * err0 + err1 * err1) * 0.5;
    e := e + 1;
  }
  lr_epochs := lr_epochs + epochs;
}

// Train (8 data points, closed-form solution)
pub fn LinearRegressionFit(
  x0: f64, x1: f64, x2: f64, x3: f64,
  x4: f64, x5: f64, x6: f64, x7: f64,
  y0: f64, y1: f64, y2: f64, y3: f64,
  y4: f64, y5: f64, y6: f64, y7: f64,
  learning_rate: f64,
  epochs: int64
): void {
  var x: array[8]f64;
  var y: array[8]f64;
  x[0] := x0; x[1] := x1; x[2] := x2; x[3] := x3;
  x[4] := x4; x[5] := x5; x[6] := x6; x[7] := x7;
  y[0] := y0; y[1] := y1; y[2] := y2; y[3] := y3;
  y[4] := y4; y[5] := y5; y[6] := y6; y[7] := y7;

  var sum_x: f64 := 0.0;
  var sum_y: f64 := 0.0;
  var sum_xy: f64 := 0.0;
  var sum_xx: f64 := 0.0;

  var i: int64 := 0;
  while (i < 8) {
    sum_x := sum_x + x[i];
    sum_y := sum_y + y[i];
    sum_xy := sum_xy + (x[i] * y[i]);
    sum_xx := sum_xx + (x[i] * x[i]);
    i := i + 1;
  }

  var n: f64 := 8.0;
  var denom: f64 := (n * sum_xx) - (sum_x * sum_x);

  if (denom > 0.001 || denom < -0.001) {
    var numerator: f64 := n * sum_xy - sum_x * sum_y;
    lr_weight := numerator * (1.0 / denom);
  }

  lr_bias := (sum_y - (lr_weight * sum_x)) * 0.125;

  var loss_sum: f64 := 0.0;
  i := 0;
  while (i < 8) {
    var pred: f64 := (lr_weight * x[i]) + lr_bias;
    var diff: f64 := pred - y[i];
    loss_sum := loss_sum + (diff * diff);
    i := i + 1;
  }
  lr_loss := loss_sum * 0.125;
  lr_epochs := 1;
}

// R-squared (8 points)
pub fn LinearRegressionR2(
  x0: f64, x1: f64, x2: f64, x3: f64,
  x4: f64, x5: f64, x6: f64, x7: f64,
  y0: f64, y1: f64, y2: f64, y3: f64,
  y4: f64, y5: f64, y6: f64, y7: f64
): f64 {
  return 1.0 - lr_loss;
}

// Train from f64 arrays (arbitrary n)
pub fn LinearRegressionFitArrays(xData: int64, yData: int64, n: int64): void {
  if (n < 2) { lr_loss := 1.0; lr_epochs := 0; return; }

  var sum_x: f64 := 0.0;
  var sum_y: f64 := 0.0;
  var sum_xy: f64 := 0.0;
  var sum_xx: f64 := 0.0;

  var i: int64 := 0;
  while (i < n) {
    var xVal: f64 := peekf64(xData + i * 8);
    var yVal: f64 := peekf64(yData + i * 8);
    sum_x := sum_x + xVal;
    sum_y := sum_y + yVal;
    sum_xy := sum_xy + (xVal * yVal);
    sum_xx := sum_xx + (xVal * xVal);
    i := i + 1;
  }

  var nn: f64 := n as f64;
  var denom: f64 := (nn * sum_xx) - (sum_x * sum_x);

  if (denom > 0.0001 || denom < -0.0001) {
    var numerator: f64 := nn * sum_xy - sum_x * sum_y;
    lr_weight := numerator / denom;
  } else {
    lr_weight := 0.1;
  }

  lr_bias := (sum_y - lr_weight * sum_x) / nn;

  var loss_sum: f64 := 0.0;
  i := 0;
  while (i < n) {
    var xVal: f64 := peekf64(xData + i * 8);
    var yVal: f64 := peekf64(yData + i * 8);
    var pred: f64 := lr_weight * xVal + lr_bias;
    var diff: f64 := pred - yVal;
    loss_sum := loss_sum + (diff * diff);
    i := i + 1;
  }
  lr_loss := loss_sum / nn;
  lr_epochs := 1;
}

// Train from DataFrame
pub fn LinearRegressionFitDataFrame(df: int64, xCol: int64, yCol: int64): void {
  var rowCount: int64 := peek8(df + 24);
  var colCount: int64 := peek8(df + 16);

  if (rowCount < 2) { lr_loss := 1.0; lr_epochs := 0; return; }

  var xIdx: int64 := 0;
  var yIdx: int64 := 1;

  var sum_x: f64 := 0.0;
  var sum_y: f64 := 0.0;
  var sum_xy: f64 := 0.0;
  var sum_xx: f64 := 0.0;

  var i: int64 := 0;
  while (i < rowCount) {
    var xSeries: int64 := peek8(peek8(df) + xIdx * 16 + 8);
    var ySeries: int64 := peek8(peek8(df) + yIdx * 16 + 8);
    var xVal: f64 := peekf64(peek8(xSeries) + i * 8);
    var yVal: f64 := peekf64(peek8(ySeries) + i * 8);
    sum_x := sum_x + xVal;
    sum_y := sum_y + yVal;
    sum_xy := sum_xy + (xVal * yVal);
    sum_xx := sum_xx + (xVal * xVal);
    i := i + 1;
  }

  var n: f64 := rowCount as f64;
  var denom: f64 := (n * sum_xx) - (sum_x * sum_x);

  if (denom > 0.0001 || denom < -0.0001) {
    var numerator: f64 := n * sum_xy - sum_x * sum_y;
    lr_weight := numerator / denom;
  } else {
    lr_weight := 0.1;
  }

  lr_bias := (sum_y - lr_weight * sum_x) / n;

  var loss_sum: f64 := 0.0;
  i := 0;
  while (i < rowCount) {
    var xSeries: int64 := peek8(peek8(df) + xIdx * 16 + 8);
    var ySeries: int64 := peek8(peek8(df) + yIdx * 16 + 8);
    var xVal: f64 := peekf64(peek8(xSeries) + i * 8);
    var yVal: f64 := peekf64(peek8(ySeries) + i * 8);
    var pred: f64 := lr_weight * xVal + lr_bias;
    var diff: f64 := pred - yVal;
    loss_sum := loss_sum + (diff * diff);
    i := i + 1;
  }
  lr_loss := loss_sum / n;
  lr_epochs := 1;
}

// Predict
pub fn LinearRegressionPredict(x: f64): f64 {
  return lr_weight * x + lr_bias;
}

// ============================================================================
// Logistic Regression - Binary Classification
// ============================================================================

var logr_weight: f64;
var logr_bias: f64;
var logr_epochs: int64;
var logr_loss: f64;
var logr_accuracy: f64;

pub fn LogisticRegressionInit(): void {
  logr_weight := 0.0;
  logr_bias := 0.0;
  logr_epochs := 0;
  logr_loss := 0.0;
  logr_accuracy := 0.0;
}

pub fn LogisticRegressionWeight(): f64 { return logr_weight; }
pub fn LogisticRegressionBias(): f64 { return logr_bias; }
pub fn LogisticRegressionLoss(): f64 { return logr_loss; }
pub fn LogisticRegressionAccuracy(): f64 { return logr_accuracy; }
pub fn LogisticRegressionEpochs(): int64 { return logr_epochs; }

// Train (1 data point)
pub fn LogisticRegressionFit1(
  x0: f64, y0: f64,
  learning_rate: f64,
  epochs: int64
): void {
  var e: int64 := 0;
  while (e < epochs) {
    var z: f64 := logr_weight * x0 + logr_bias;
    var pred: f64 := SigmoidF64(z);
    var err: f64 := pred - y0;
    var dw: f64 := err * x0;
    var db: f64 := err;
    logr_weight := logr_weight - learning_rate * dw;
    logr_bias := logr_bias - learning_rate * db;
    var diff: f64 := pred - y0;
    logr_loss := diff * diff;
    var pred_class: int64 := 0;
    if (pred >= 0.5) { pred_class := 1; }
    if (pred_class == (y0 as int64)) {
      logr_accuracy := 1.0;
    } else {
      logr_accuracy := 0.0;
    }
    e := e + 1;
  }
  logr_epochs := epochs;
}

// Train (2 data points)
pub fn LogisticRegressionFit2(
  x0: f64, x1: f64,
  y0: f64, y1: f64,
  learning_rate: f64,
  epochs: int64
): void {
  var e: int64 := 0;
  while (e < epochs) {
    var z0: f64 := logr_weight * x0 + logr_bias;
    var z1: f64 := logr_weight * x1 + logr_bias;
    var pred0: f64 := SigmoidF64(z0);
    var pred1: f64 := SigmoidF64(z1);
    var err0: f64 := pred0 - y0;
    var err1: f64 := pred1 - y1;
    var dw: f64 := (err0 * x0 + err1 * x1) * 0.5;
    var db: f64 := (err0 + err1) * 0.5;
    logr_weight := logr_weight - learning_rate * dw;
    logr_bias := logr_bias - learning_rate * db;
    logr_loss := (err0 * err0 + err1 * err1) * 0.5;
    var correct: int64 := 0;
    var pc0: int64 := 0; if (pred0 >= 0.5) { pc0 := 1; }
    var pc1: int64 := 0; if (pred1 >= 0.5) { pc1 := 1; }
    if (pc0 == (y0 as int64)) { correct := correct + 1; }
    if (pc1 == (y1 as int64)) { correct := correct + 1; }
    logr_accuracy := correct as f64 * 0.5;
    e := e + 1;
  }
  logr_epochs := logr_epochs + epochs;
}

// Train (8 data points)
pub fn LogisticRegressionFit(
  x0: f64, x1: f64, x2: f64, x3: f64,
  x4: f64, x5: f64, x6: f64, x7: f64,
  y0: f64, y1: f64, y2: f64, y3: f64,
  y4: f64, y5: f64, y6: f64, y7: f64,
  learning_rate: f64,
  epochs: int64
): void {
  var x: array[8]f64;
  var y: array[8]f64;
  x[0] := x0; x[1] := x1; x[2] := x2; x[3] := x3;
  x[4] := x4; x[5] := x5; x[6] := x6; x[7] := x7;
  y[0] := y0; y[1] := y1; y[2] := y2; y[3] := y3;
  y[4] := y4; y[5] := y5; y[6] := y6; y[7] := y7;

  var n: f64 := 8.0;
  var lr: f64 := learning_rate;

  var e: int64 := 0;
  while (e < epochs) {
    var sum_dw: f64 := 0.0;
    var sum_db: f64 := 0.0;

    var i: int64 := 0;
    while (i < 8) {
      var z: f64 := (logr_weight * x[i]) + logr_bias;
      var pred: f64 := SigmoidF64(z);
      var error: f64 := pred - y[i];
      sum_dw := sum_dw + (error * x[i]);
      sum_db := sum_db + error;
      i := i + 1;
    }

    var dw: f64 := sum_dw * (lr * 0.125);
    var db: f64 := sum_db * (lr * 0.125);
    logr_weight := logr_weight - (learning_rate * dw);
    logr_bias := logr_bias - (learning_rate * db);

    var loss_sum: f64 := 0.0;
    var correct: int64 := 0;

    i := 0;
    while (i < 8) {
      var z: f64 := (logr_weight * x[i]) + logr_bias;
      var pred: f64 := SigmoidF64(z);
      var y_true: f64 := y[i];
      var diff: f64 := pred - y_true;
      loss_sum := loss_sum + (diff * diff);
      var pred_class: int64 := 0;
      if (pred >= 0.5) { pred_class := 1; }
      if (pred_class == (y_true as int64)) { correct := correct + 1; }
      i := i + 1;
    }

    logr_loss := loss_sum / n;
    logr_accuracy := (correct as f64) / n;
    logr_epochs := logr_epochs + 1;
    e := e + 1;
  }
}

// Train from arrays (arbitrary n)
pub fn LogisticRegressionFitArrays(xData: int64, yData: int64, n: int64, learningRate: f64, epochs: int64): void {
  if (n < 2) { logr_loss := 1.0; logr_epochs := 0; return; }

  var e: int64 := 0;
  while (e < epochs) {
    var sum_dw: f64 := 0.0;
    var sum_db: f64 := 0.0;

    var i: int64 := 0;
    while (i < n) {
      var xVal: f64 := peekf64(xData + i * 8);
      var yVal: f64 := peekf64(yData + i * 8);
      var z: f64 := logr_weight * xVal + logr_bias;
      var pred: f64 := SigmoidF64(z);
      var error: f64 := pred - yVal;
      sum_dw := sum_dw + (error * xVal);
      sum_db := sum_db + error;
      i := i + 1;
    }

    var nn: f64 := n as f64;
    logr_weight := logr_weight - (learningRate * (sum_dw / nn));
    logr_bias := logr_bias - (learningRate * (sum_db / nn));

    var loss_sum: f64 := 0.0;
    var correct: int64 := 0;
    i := 0;
    while (i < n) {
      var xVal: f64 := peekf64(xData + i * 8);
      var yVal: f64 := peekf64(yData + i * 8);
      var z: f64 := logr_weight * xVal + logr_bias;
      var pred: f64 := SigmoidF64(z);
      var diff: f64 := pred - yVal;
      loss_sum := loss_sum + (diff * diff);
      var predClass: int64 := 0;
      if (pred >= 0.5) { predClass := 1; }
      if (predClass == (yVal as int64)) { correct := correct + 1; }
      i := i + 1;
    }

    logr_loss := loss_sum / nn;
    logr_accuracy := (correct as f64) / nn;
    logr_epochs := logr_epochs + 1;
    e := e + 1;
  }
}

// Train from DataFrame
pub fn LogisticRegressionFitDataFrame(df: int64, xCol: int64, yCol: int64, learningRate: f64, epochs: int64): void {
  var rowCount: int64 := peek8(df + 24);

  if (rowCount < 2) { logr_loss := 1.0; logr_epochs := 0; return; }

  var xIdx: int64 := 0;
  var yIdx: int64 := 1;
  var n: f64 := rowCount as f64;

  var e: int64 := 0;
  while (e < epochs) {
    var sum_dw: f64 := 0.0;
    var sum_db: f64 := 0.0;

    var i: int64 := 0;
    while (i < rowCount) {
      var xSeries: int64 := peek8(peek8(df) + xIdx * 16 + 8);
      var ySeries: int64 := peek8(peek8(df) + yIdx * 16 + 8);
      var xVal: f64 := peekf64(peek8(xSeries) + i * 8);
      var yVal: f64 := peekf64(peek8(ySeries) + i * 8);
      var z: f64 := logr_weight * xVal + logr_bias;
      var pred: f64 := SigmoidF64(z);
      var error: f64 := pred - yVal;
      sum_dw := sum_dw + (error * xVal);
      sum_db := sum_db + error;
      i := i + 1;
    }

    logr_weight := logr_weight - (learningRate * (sum_dw / n));
    logr_bias := logr_bias - (learningRate * (sum_db / n));

    var loss_sum: f64 := 0.0;
    var correct: int64 := 0;
    i := 0;
    while (i < rowCount) {
      var xSeries: int64 := peek8(peek8(df) + xIdx * 16 + 8);
      var ySeries: int64 := peek8(peek8(df) + yIdx * 16 + 8);
      var xVal: f64 := peekf64(peek8(xSeries) + i * 8);
      var yVal: f64 := peekf64(peek8(ySeries) + i * 8);
      var z: f64 := logr_weight * xVal + logr_bias;
      var pred: f64 := SigmoidF64(z);
      var diff: f64 := pred - yVal;
      loss_sum := loss_sum + (diff * diff);
      var predClass: int64 := 0;
      if (pred >= 0.5) { predClass := 1; }
      if (predClass == (yVal as int64)) { correct := correct + 1; }
      i := i + 1;
    }

    logr_loss := loss_sum / n;
    logr_accuracy := (correct as f64) / n;
    logr_epochs := logr_epochs + 1;
    e := e + 1;
  }
}

// Predict probability
pub fn LogisticRegressionPredictProb(x: f64): f64 {
  return SigmoidF64(logr_weight * x + logr_bias);
}

// Predict class
pub fn LogisticRegressionPredict(x: f64): int64 {
  var prob: f64 := LogisticRegressionPredictProb(x);
  if (prob >= 0.5) { return 1; }
  return 0;
}

// ============================================================================
// Distance Metrics
// ============================================================================

pub fn EuclideanDistance(x1: f64, y1: f64, x2: f64, y2: f64): f64 {
  var dx: f64 := x2 - x1;
  var dy: f64 := y2 - y1;
  if (dx < 0.0) { dx := 0.0 - dx; }
  if (dy < 0.0) { dy := 0.0 - dy; }
  return SqrtF64SSE(dx * dx + dy * dy); // Use SSE2 optimized sqrt
}

// ============================================================================
// Statistics
// ============================================================================

pub fn Mean2(a: f64, b: f64): f64 { return (a + b) * 0.5; }

pub fn Variance2(a: f64, b: f64): f64 {
  var m: f64 := Mean2(a, b);
  var da: f64 := a - m;
  var db: f64 := b - m;
  return (da * da + db * db) * 0.5;
}

pub fn StdDev2(a: f64, b: f64): f64 { return SqrtF64SSE(Variance2(a, b)); } // Use SSE2 optimized sqrt

// ============================================================================
// Loss Metrics
// ============================================================================

pub fn MSE2(y_true0: f64, y_true1: f64, y_pred0: f64, y_pred1: f64): f64 {
  var e0: f64 := y_pred0 - y_true0;
  var e1: f64 := y_pred1 - y_true1;
  return (e0 * e0 + e1 * e1) * 0.5;
}

pub fn MAE2(y_true0: f64, y_true1: f64, y_pred0: f64, y_pred1: f64): f64 {
  var e0: f64 := y_pred0 - y_true0;
  var e1: f64 := y_pred1 - y_true1;
  if (e0 < 0.0) { e0 := 0.0 - e0; }
  if (e1 < 0.0) { e1 := 0.0 - e1; }
  return (e0 + e1) * 0.5;
}

pub fn R2Score2(y_true0: f64, y_true1: f64, y_pred0: f64, y_pred1: f64): f64 {
  var mean_y: f64 := (y_true0 + y_true1) * 0.5;
  var ss_tot: f64 := (y_true0 - mean_y) * (y_true0 - mean_y) + (y_true1 - mean_y) * (y_true1 - mean_y);
  if (ss_tot == 0.0) { return 0.0; }
  var e0: f64 := y_pred0 - y_true0;
  var e1: f64 := y_pred1 - y_true1;
  return 1.0 - ((e0 * e0 + e1 * e1) / ss_tot);
}

// ============================================================================
// k-Nearest Neighbors - Simple 2-point API
// ============================================================================

var knn_k: int64;
var knn_x0: f64;
var knn_x1: f64;
var knn_y0: f64;
var knn_y1: f64;

pub fn KNNInit2(k: int64, x0: f64, x1: f64, y0: f64, y1: f64): void {
  knn_k := k;
  knn_x0 := x0;
  knn_x1 := x1;
  knn_y0 := y0;
  knn_y1 := y1;
}

// 1D nearest neighbor predict (simple API, 2 training points)
pub fn KNNPredict2(x: f64): int64 {
  var d0: f64 := x - knn_x0;
  var d1: f64 := x - knn_x1;
  if (d0 < 0.0) { d0 := 0.0 - d0; }
  if (d1 < 0.0) { d1 := 0.0 - d1; }
  if (d0 < d1) {
    if (knn_y0 >= 0.5) { return 1; }
    return 0;
  } else {
    if (knn_y1 >= 0.5) { return 1; }
    return 0;
  }
}

// ============================================================================
// k-Nearest Neighbors - Full API (arbitrary features and training set)
// ============================================================================

var knn_n: int64;
var knn_features: int64;
var knn_labels: int64;
var knn_nFeatures: int64;

pub fn KNNInit(k: int64): void {
  knn_k := k;
  knn_n := 0;
  knn_features := 0;
  knn_labels := 0;
  knn_nFeatures := 0;
}

pub fn KNNGetK(): int64 { return knn_k; }
pub fn KNNGetNSamples(): int64 { return knn_n; }

pub fn KNNFit(features: int64, labels: int64, n: int64, nFeatures: int64): void {
  knn_features := features;
  knn_labels := labels;
  knn_n := n;
  knn_nFeatures := nFeatures;
}

// Euclidean distance between two n-dimensional vectors
pub fn KNNDistance(a: int64, b: int64, n: int64): f64 {
  var sumSq: f64 := 0.0;
  var i: int64 := 0;
  while (i < n) {
    var diff: f64 := peekf64(a + i * 8) - peekf64(b + i * 8);
    sumSq := sumSq + (diff * diff);
    i := i + 1;
  }
  return SqrtF64SSE(sumSq); // Use SSE2 optimized sqrt
}

// Manhattan distance (L1)
pub fn KNNManhattanDistance(a: int64, b: int64, n: int64): f64 {
  var sum: f64 := 0.0;
  var i: int64 := 0;
  while (i < n) {
    var diff: f64 := peekf64(a + i * 8) - peekf64(b + i * 8);
    if (diff < 0.0) { diff := 0.0 - diff; }
    sum := sum + diff;
    i := i + 1;
  }
  return sum;
}

// Find k nearest neighbor indices
pub fn KNNFindNeighbors(query: int64, k: int64): int64 {
  if (knn_n == 0 || knn_features == 0) { return 0; }
  if (k > knn_n) { k := knn_n; }

  var distArr: int64 := mmap(0, knn_n * 16, PROT_RW, MAP_ANON, FD_NONE, 0);
  var i: int64 := 0;
  while (i < knn_n) {
    var dist: int64 := knn_features + i * knn_nFeatures * 8;
    var d: f64 := KNNDistance(query, dist, knn_nFeatures);
    pokef64(distArr + i * 16, d);
    poke8(distArr + i * 16 + 8, i);
    i := i + 1;
  }

  // Insertion sort by distance
  var j: int64 := 0;
  while (j < knn_n - 1) {
    var d1: f64 := peekf64(distArr + j * 16);
    var d2: f64 := peekf64(distArr + (j + 1) * 16);
    if (d2 < d1) {
      pokef64(distArr + j * 16, d2);
      var idx1: int64 := peek8(distArr + j * 16 + 8);
      var idx2: int64 := peek8(distArr + (j + 1) * 16 + 8);
      poke8(distArr + j * 16 + 8, idx2);
      poke8(distArr + (j + 1) * 16 + 8, idx1);
      if (j > 0) { j := j - 1; }
    } else {
      j := j + 1;
    }
  }

  var result: int64 := mmap(0, k * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  i := 0;
  while (i < k) {
    var idx: int64 := peek8(distArr + i * 16 + 8);
    poke8(result + i * 8, idx);
    i := i + 1;
  }
  munmap(distArr, knn_n * 16);
  return result;
}

// Majority vote among neighbors
pub fn KNNMajorityVote(neighborIndices: int64, k: int64): int64 {
  if (knn_labels == 0 || neighborIndices == 0) { return 0; }
  var votes: int64 := mmap(0, 10 * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  var maxVote: int64 := 0;
  var maxLabel: int64 := 0;
  var i: int64 := 0;
  while (i < k) {
    var idx: int64 := peek8(neighborIndices + i * 8);
    var label: int64 := peek8(knn_labels + idx * 8);
    var count: int64 := peek8(votes + label * 8);
    count := count + 1;
    poke8(votes + label * 8, count);
    if (count > maxVote) { maxVote := count; maxLabel := label; }
    i := i + 1;
  }
  munmap(votes, 10 * 8);
  return maxLabel;
}

// Weighted vote (inverse distance)
pub fn KNNWeightedVote(neighborIndices: int64, query: int64, k: int64): int64 {
  if (knn_labels == 0 || neighborIndices == 0) { return 0; }
  var votes: int64 := mmap(0, 10 * 16, PROT_RW, MAP_ANON, FD_NONE, 0);
  var maxVote: f64 := 0.0;
  var maxLabel: int64 := 0;
  var i: int64 := 0;
  while (i < k) {
    var idx: int64 := peek8(neighborIndices + i * 8);
    var label: int64 := peek8(knn_labels + idx * 8);
    var trainPt: int64 := knn_features + idx * knn_nFeatures * 8;
    var dist: f64 := KNNDistance(query, trainPt, knn_nFeatures);
    var weight: f64 := 1.0;
    if (dist > 0.0001) { weight := 1.0 / dist; }
    var current: f64 := peekf64(votes + label * 16);
    current := current + weight;
    pokef64(votes + label * 16, current);
    if (current > maxVote) { maxVote := current; maxLabel := label; }
    i := i + 1;
  }
  munmap(votes, 10 * 16);
  return maxLabel;
}

// Predict class for a query point
pub fn KNNPredict(query: int64): int64 {
  if (knn_n == 0 || knn_features == 0) { return 0; }
  var neighbors: int64 := KNNFindNeighbors(query, knn_k);
  if (neighbors == 0) { return 0; }
  var prediction: int64 := KNNMajorityVote(neighbors, knn_k);
  munmap(neighbors, knn_k * 8);
  return prediction;
}

// Predict class probabilities
pub fn KNNPredictProba(query: int64, nClasses: int64): int64 {
  if (knn_n == 0 || knn_features == 0) { return 0; }
  var neighbors: int64 := KNNFindNeighbors(query, knn_k);
  if (neighbors == 0) { return 0; }
  var classVotes: int64 := mmap(0, nClasses * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  var i: int64 := 0;
  while (i < knn_k) {
    var idx: int64 := peek8(neighbors + i * 8);
    var label: int64 := peek8(knn_labels + idx * 8);
    if (label >= 0 && label < nClasses) {
      var count: int64 := peek8(classVotes + label * 8);
      count := count + 1;
      poke8(classVotes + label * 8, count);
    }
    i := i + 1;
  }
  var proba: int64 := mmap(0, nClasses * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  var kf: f64 := knn_k as f64;
  i := 0;
  while (i < nClasses) {
    var count: int64 := peek8(classVotes + i * 8);
    pokef64(proba + i * 8, (count as f64) / kf);
    i := i + 1;
  }
  munmap(classVotes, nClasses * 8);
  munmap(neighbors, knn_k * 8);
  return proba;
}

// k-fold cross-validation score
pub fn KNNCrossValidation(features: int64, labels: int64, n: int64, nFeatures: int64, k: int64, folds: int64): f64 {
  if (n < folds || folds < 2) { return 0.0; }
  var foldSize: int64 := n / folds;
  var correct: int64 := 0;
  var total: int64 := 0;
  var fold: int64 := 0;
  while (fold < folds) {
    var testStart: int64 := fold * foldSize;
    var testEnd: int64 := testStart + foldSize;
    if (fold == folds - 1) { testEnd := n; }
    var trainN: int64 := n - foldSize;
    var trainFeatures: int64 := mmap(0, trainN * nFeatures * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
    var trainLabels: int64 := mmap(0, trainN * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
    var trainIdx: int64 := 0;
    var i: int64 := 0;
    while (i < n) {
      if (i >= testStart && i < testEnd) {
        // skip test
      } else {
        var j: int64 := 0;
        while (j < nFeatures) {
          var val: f64 := peekf64(features + i * nFeatures * 8 + j * 8);
          pokef64(trainFeatures + trainIdx * nFeatures * 8 + j * 8, val);
          j := j + 1;
        }
        poke8(trainLabels + trainIdx * 8, peek8(labels + i * 8));
        trainIdx := trainIdx + 1;
      }
      i := i + 1;
    }
    KNNFit(trainFeatures, trainLabels, trainN, nFeatures);
    i := testStart;
    while (i < testEnd) {
      var query: int64 := features + i * nFeatures * 8;
      var pred: int64 := KNNPredict(query);
      var trueLabel: int64 := peek8(labels + i * 8);
      if (pred == trueLabel) { correct := correct + 1; }
      total := total + 1;
      i := i + 1;
    }
    munmap(trainFeatures, trainN * nFeatures * 8);
    munmap(trainLabels, trainN * 8);
    fold := fold + 1;
  }
  if (total == 0) { return 0.0; }
  return (correct as f64) / (total as f64);
}

// Score on a labeled dataset
pub fn KNNScore(features: int64, labels: int64, n: int64): f64 {
  if (knn_n == 0 || knn_features == 0) { return 0.0; }
  var correct: int64 := 0;
  var i: int64 := 0;
  while (i < n) {
    var query: int64 := features + i * knn_nFeatures * 8;
    var pred: int64 := KNNPredict(query);
    var trueLabel: int64 := peek8(labels + i * 8);
    if (pred == trueLabel) { correct := correct + 1; }
    i := i + 1;
  }
  return (correct as f64) / (n as f64);
}

// ============================================================================
// k-Means Clustering - Simple 2-cluster API
// ============================================================================

var km_centroid0: f64;
var km_centroid1: f64;
var km_iterations: int64;

pub fn KMeansInit2(c0: f64, c1: f64): void {
  km_centroid0 := c0;
  km_centroid1 := c1;
  km_iterations := 0;
}

// Fit 2-cluster k-means to 2 data points (assigns each to its own cluster)
pub fn KMeansFit2(x0: f64, x1: f64, iterations: int64): void {
  // Assign each point to its own centroid
  if (x0 <= x1) {
    km_centroid0 := x0;
    km_centroid1 := x1;
  } else {
    km_centroid0 := x1;
    km_centroid1 := x0;
  }
  km_iterations := 1;
}

pub fn KMeansPredict(x: f64): int64 {
  var d0: f64 := x - km_centroid0;
  var d1: f64 := x - km_centroid1;
  if (d0 < 0.0) { d0 := 0.0 - d0; }
  if (d1 < 0.0) { d1 := 0.0 - d1; }
  if (d0 < d1) { return 0; }
  return 1;
}

pub fn KMeansCentroid0(): f64 { return km_centroid0; }
pub fn KMeansCentroid1(): f64 { return km_centroid1; }

// ============================================================================
// k-Means Clustering - Full API
// ============================================================================

var km_k: int64;
var km_n: int64;
var km_features: int64;
var km_centroids: int64;
var km_assignments: int64;
var km_nFeatures: int64;
var km_maxIter: int64;
var km_tolerance: f64;
var km_iter: int64;
var km_inertia: f64;

pub fn KMeansInit(k: int64): void {
  km_k := k;
  km_n := 0;
  km_features := 0;
  km_centroids := 0;
  km_assignments := 0;
  km_nFeatures := 0;
  km_maxIter := 100;
  km_tolerance := 0.001;
  km_iter := 0;
  km_inertia := 0.0;
}

pub fn KMeansGetK(): int64 { return km_k; }
pub fn KMeansGetIter(): int64 { return km_iter; }
pub fn KMeansGetInertia(): f64 { return km_inertia; }

// Initialize centroids using k-means++ strategy
pub fn KMeansInitCentroids(features: int64, n: int64, nFeatures: int64, k: int64): void {
  if (n < k || features == 0) { return; }

  km_centroids := mmap(0, k * nFeatures * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  km_assignments := mmap(0, n * 8, PROT_RW, MAP_ANON, FD_NONE, 0);

  // First centroid: middle point
  var randIdx: int64 := n / 2;
  var i: int64 := 0;
  while (i < nFeatures) {
    var val: f64 := peekf64(features + randIdx * nFeatures * 8 + i * 8);
    pokef64(km_centroids + i * 8, val);
    i := i + 1;
  }

  // Remaining centroids: weighted by distance squared
  var c: int64 := 1;
  while (c < k) {
    var dists: int64 := mmap(0, n * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
    var totalDist: f64 := 0.0;
    var j: int64 := 0;

    while (j < n) {
      var minDist: f64 := 999999999.0;
      var ci: int64 := 0;
      while (ci < c) {
        var centroid: int64 := km_centroids + ci * nFeatures * 8;
        var point: int64 := features + j * nFeatures * 8;
        var d: f64 := KNNDistance(centroid, point, nFeatures);
        if (d < minDist) { minDist := d; }
        ci := ci + 1;
      }
      pokef64(dists + j * 8, minDist * minDist);
      totalDist := totalDist + (minDist * minDist);
      j := j + 1;
    }

    var r: f64 := totalDist * 0.5;
    var cumDist: f64 := 0.0;
    j := 0;
    while (j < n) {
      cumDist := cumDist + peekf64(dists + j * 8);
      if (cumDist >= r) {
        var fIdx: int64 := 0;
        while (fIdx < nFeatures) {
          var val: f64 := peekf64(features + j * nFeatures * 8 + fIdx * 8);
          pokef64(km_centroids + c * nFeatures * 8 + fIdx * 8, val);
          fIdx := fIdx + 1;
        }
        break;
      }
      j := j + 1;
    }

    munmap(dists, n * 8);
    c := c + 1;
  }
}

// Fit k-Means to data
pub fn KMeansFit(features: int64, n: int64, nFeatures: int64, k: int64): void {
  if (n == 0 || features == 0 || k == 0) { return; }

  km_features := features;
  km_n := n;
  km_nFeatures := nFeatures;
  km_k := k;
  km_iter := 0;

  KMeansInitCentroids(features, n, nFeatures, k);

  var converged: int64 := 0;
  while (converged == 0 && km_iter < km_maxIter) {
    km_iter := km_iter + 1;

    var changed: int64 := 0;
    var i: int64 := 0;
    while (i < n) {
      var point: int64 := features + i * nFeatures * 8;
      var minDist: f64 := 999999999.0;
      var minCluster: int64 := 0;
      var c: int64 := 0;
      while (c < k) {
        var centroid: int64 := km_centroids + c * nFeatures * 8;
        var d: f64 := KNNDistance(point, centroid, nFeatures);
        if (d < minDist) { minDist := d; minCluster := c; }
        c := c + 1;
      }
      var oldAss: int64 := peek8(km_assignments + i * 8);
      if (oldAss != minCluster) { changed := 1; }
      poke8(km_assignments + i * 8, minCluster);
      i := i + 1;
    }

    var j: int64 := 0;
    while (j < k) {
      var count: int64 := 0;
      var sum: int64 := mmap(0, nFeatures * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
      i := 0;
      while (i < n) {
        if (peek8(km_assignments + i * 8) == j) {
          count := count + 1;
          var f: int64 := 0;
          while (f < nFeatures) {
            var val: f64 := peekf64(features + i * nFeatures * 8 + f * 8);
            var cur: f64 := peekf64(sum + f * 8);
            pokef64(sum + f * 8, cur + val);
            f := f + 1;
          }
        }
        i := i + 1;
      }
      if (count > 0) {
        var f: int64 := 0;
        while (f < nFeatures) {
          var mean: f64 := peekf64(sum + f * 8) / (count as f64);
          pokef64(km_centroids + j * nFeatures * 8 + f * 8, mean);
          f := f + 1;
        }
      }
      munmap(sum, nFeatures * 8);
      j := j + 1;
    }

    if (changed == 0 || km_iter >= km_maxIter) { converged := 1; }
  }

  km_inertia := 0.0;
  var pt: int64 := 0;
  while (pt < n) {
    var point: int64 := features + pt * nFeatures * 8;
    var cluster: int64 := peek8(km_assignments + pt * 8);
    var centroid: int64 := km_centroids + cluster * nFeatures * 8;
    var d: f64 := KNNDistance(point, centroid, nFeatures);
    km_inertia := km_inertia + (d * d);
    pt := pt + 1;
  }
}

// Predict cluster for a single point
pub fn KMeansPredictCluster(point: int64): int64 {
  if (km_centroids == 0 || km_k == 0) { return -1; }
  var minDist: f64 := 999999999.0;
  var minCluster: int64 := 0;
  var c: int64 := 0;
  while (c < km_k) {
    var centroid: int64 := km_centroids + c * km_nFeatures * 8;
    var d: f64 := KNNDistance(point, centroid, km_nFeatures);
    if (d < minDist) { minDist := d; minCluster := c; }
    c := c + 1;
  }
  return minCluster;
}

pub fn KMeansGetAssignments(): int64 { return km_assignments; }
pub fn KMeansGetCentroids(): int64 { return km_centroids; }

pub fn KMeansGetClusterSize(clusterIdx: int64): int64 {
  if (km_assignments == 0) { return 0; }
  var count: int64 := 0;
  var i: int64 := 0;
  while (i < km_n) {
    if (peek8(km_assignments + i * 8) == clusterIdx) { count := count + 1; }
    i := i + 1;
  }
  return count;
}

pub fn KMeansGetCentroid(idx: int64, featureIdx: int64): f64 {
  if (km_centroids == 0) { return 0.0; }
  return peekf64(km_centroids + idx * km_nFeatures * 8 + featureIdx * 8);
}

// Silhouette score
pub fn KMeansSilhouette(features: int64, n: int64, nFeatures: int64): f64 {
  if (km_n == 0 || km_assignments == 0) { return 0.0; }
  var totalScore: f64 := 0.0;
  var i: int64 := 0;
  while (i < n) {
    var point: int64 := features + i * nFeatures * 8;
    var myCluster: int64 := peek8(km_assignments + i * 8);
    var aDist: f64 := 0.0;
    var aCount: int64 := 0;
    var j: int64 := 0;
    while (j < n) {
      if (peek8(km_assignments + j * 8) == myCluster) {
        aDist := aDist + KNNDistance(point, features + j * nFeatures * 8, nFeatures);
        aCount := aCount + 1;
      }
      j := j + 1;
    }
    if (aCount > 1) { aDist := aDist / (aCount - 1); }
    if (aDist == 0.0) { aDist := 0.0001; }
    var bDist: f64 := 999999999.0;
    var c: int64 := 0;
    while (c < km_k) {
      if (c != myCluster) {
        var otherDist: f64 := 0.0;
        var oCount: int64 := 0;
        j := 0;
        while (j < n) {
          if (peek8(km_assignments + j * 8) == c) {
            otherDist := otherDist + KNNDistance(point, features + j * nFeatures * 8, nFeatures);
            oCount := oCount + 1;
          }
          j := j + 1;
        }
        if (oCount > 0) {
          otherDist := otherDist / (oCount as f64);
          if (otherDist < bDist) { bDist := otherDist; }
        }
      }
      c := c + 1;
    }
    if (bDist == 999999999.0) { bDist := 0.0; }
    var s: f64 := 0.0;
    if (aDist > 0.0 || bDist > 0.0) {
      var mx: f64 := aDist;
      if (bDist > mx) { mx := bDist; }
      s := (bDist - aDist) / mx;
    }
    totalScore := totalScore + s;
    i := i + 1;
  }
  return totalScore / (n as f64);
}

// Elbow method
pub fn KMeansElbow(features: int64, n: int64, nFeatures: int64, maxK: int64): int64 {
  var result: int64 := mmap(0, maxK * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  var k: int64 := 1;
  while (k <= maxK) {
    KMeansFit(features, n, nFeatures, k);
    pokef64(result + (k - 1) * 8, km_inertia);
    k := k + 1;
  }
  return result;
}

// ============================================================================
// k-Means Mini-Batch
// ============================================================================

var kmb_batchSize: int64;

pub fn KMeansMiniBatchInit(k: int64, batchSize: int64): void {
  KMeansInit(k);
  kmb_batchSize := batchSize;
  if (kmb_batchSize < 10) { kmb_batchSize := 10; }
}

pub fn KMeansMiniBatchFit(features: int64, n: int64, nFeatures: int64, k: int64): void {
  if (n == 0 || features == 0 || k == 0) { return; }
  km_features := features;
  km_n := n;
  km_nFeatures := nFeatures;
  km_k := k;
  KMeansInitCentroids(features, n, nFeatures, k);
  var iter: int64 := 0;
  var converged: int64 := 0;
  while (converged == 0 && iter < km_maxIter) {
    iter := iter + 1;
    var changed: int64 := 0;
    var startIdx: int64 := (iter * kmb_batchSize) % n;
    var batchEnd: int64 := startIdx + kmb_batchSize;
    if (batchEnd > n) { batchEnd := n; }
    var i: int64 := startIdx;
    while (i < batchEnd) {
      var point: int64 := features + i * nFeatures * 8;
      var cluster: int64 := KMeansPredictCluster(point);
      var oldAss: int64 := peek8(km_assignments + i * 8);
      if (oldAss != cluster) { changed := 1; }
      poke8(km_assignments + i * 8, cluster);
      i := i + 1;
    }
    i := startIdx;
    while (i < batchEnd) {
      var point: int64 := features + i * nFeatures * 8;
      var cluster: int64 := peek8(km_assignments + i * 8);
      var lr: f64 := 0.1;
      var f: int64 := 0;
      while (f < nFeatures) {
        var cur: f64 := peekf64(km_centroids + cluster * nFeatures * 8 + f * 8);
        var pt: f64 := peekf64(point + f * 8);
        pokef64(km_centroids + cluster * nFeatures * 8 + f * 8, cur + (pt - cur) * lr);
        f := f + 1;
      }
      i := i + 1;
    }
    if (changed == 0 || iter >= km_maxIter) { converged := 1; }
  }
  var i: int64 := 0;
  while (i < n) {
    var point: int64 := features + i * nFeatures * 8;
    poke8(km_assignments + i * 8, KMeansPredictCluster(point));
    i := i + 1;
  }
  km_inertia := 0.0;
  i := 0;
  while (i < n) {
    var point: int64 := features + i * nFeatures * 8;
    var cluster: int64 := peek8(km_assignments + i * 8);
    var centroid: int64 := km_centroids + cluster * nFeatures * 8;
    var d: f64 := KNNDistance(point, centroid, nFeatures);
    km_inertia := km_inertia + (d * d);
    i := i + 1;
  }
}

// ============================================================================
// Data Preprocessing
// ============================================================================

pub fn MinMaxNorm(x: f64, min: f64, max: f64): f64 {
  if (max == min) { return 0.0; }
  return (x - min) / (max - min);
}

pub fn MinMaxDenorm(x_norm: f64, min: f64, max: f64): f64 {
  return x_norm * (max - min) + min;
}

pub fn ZScoreNorm(x: f64, mean: f64, stddev: f64): f64 {
  if (stddev == 0.0) { return 0.0; }
  return (x - mean) / stddev;
}

pub fn TrainTestSplit(index: int64): int64 {
  if ((index as int64) % 2 == 0) { return 0; }
  return 1;
}

// ============================================================================
// Naive Bayes Classifier (Multinomial)
// ============================================================================

var nb_vocabSize: int64;
var nb_nClasses: int64;
var nb_wordCounts: int64;
var nb_classCounts: int64;
var nb_classPriors: int64;
var nb_alpha: f64;
var nb_nDocs: int64;
var nb_bernoulli: int64;

pub fn NaiveBayesInit(nClasses: int64, vocabSize: int64): void {
  nb_nClasses := nClasses;
  nb_vocabSize := vocabSize;
  nb_alpha := 1.0;
  nb_nDocs := 0;
  nb_bernoulli := 0;
  nb_wordCounts := mmap(0, nClasses * vocabSize * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  nb_classCounts := mmap(0, nClasses * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  nb_classPriors := mmap(0, nClasses * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
}

pub fn NaiveBayesFit(documents: int64, docLengths: int64, labels: int64, n: int64): void {
  if (documents == 0 || labels == 0 || n == 0) { return; }
  nb_nDocs := n;
  var i: int64 := 0;
  while (i < n) {
    var label: int64 := peek8(labels + i * 8);
    var docStart: int64 := peek8(documents + i * 8);
    var docLen: int64 := peek8(docLengths + i * 8);
    var classCount: int64 := peek8(nb_classCounts + label * 8);
    poke8(nb_classCounts + label * 8, classCount + 1);
    var j: int64 := 0;
    while (j < docLen) {
      var wordIdx: int64 := peek8(docStart + j * 8);
      if (wordIdx >= 0 && wordIdx < nb_vocabSize) {
        var idx: int64 := label * nb_vocabSize + wordIdx;
        var count: f64 := peekf64(nb_wordCounts + idx * 8);
        pokef64(nb_wordCounts + idx * 8, count + 1.0);
      }
      j := j + 1;
    }
    i := i + 1;
  }
  var total: f64 := n as f64;
  i := 0;
  while (i < nb_nClasses) {
    var count: int64 := peek8(nb_classCounts + i * 8);
    var prior: f64 := (count as f64 + nb_alpha) / (total + nb_alpha * (nb_nClasses as f64));
    pokef64(nb_classPriors + i * 8, NBLog(prior));
    i := i + 1;
  }
}

pub fn NaiveBayesPredict(docWords: int64, docLen: int64): int64 {
  if (nb_wordCounts == 0 || docWords == 0) { return 0; }
  var bestClass: int64 := 0;
  var bestScore: f64 := -999999999.0;
  var c: int64 := 0;
  while (c < nb_nClasses) {
    var score: f64 := peekf64(nb_classPriors + c * 8);
    var i: int64 := 0;
    while (i < docLen) {
      var wordIdx: int64 := peek8(docWords + i * 8);
      if (wordIdx >= 0 && wordIdx < nb_vocabSize) {
        var wc: f64 := peekf64(nb_wordCounts + c * nb_vocabSize * 8 + wordIdx * 8);
        wc := wc + nb_alpha;
        var totalWords: f64 := 0.0;
        var j: int64 := 0;
        while (j < nb_vocabSize) {
          totalWords := totalWords + peekf64(nb_wordCounts + c * nb_vocabSize * 8 + j * 8);
          j := j + 1;
        }
        totalWords := totalWords + nb_alpha * (nb_vocabSize as f64);
        score := score + NBLog(wc / totalWords);
      }
      i := i + 1;
    }
    if (score > bestScore) { bestScore := score; bestClass := c; }
    c := c + 1;
  }
  return bestClass;
}

pub fn NaiveBayesPredictProba(docWords: int64, docLen: int64): int64 {
  if (nb_wordCounts == 0) { return 0; }
  var scores: int64 := mmap(0, nb_nClasses * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  var c: int64 := 0;
  while (c < nb_nClasses) {
    var score: f64 := peekf64(nb_classPriors + c * 8);
    var i: int64 := 0;
    while (i < docLen) {
      var wordIdx: int64 := peek8(docWords + i * 8);
      if (wordIdx >= 0 && wordIdx < nb_vocabSize) {
        var wc: f64 := peekf64(nb_wordCounts + c * nb_vocabSize * 8 + wordIdx * 8);
        wc := wc + nb_alpha;
        var totalWords: f64 := 0.0;
        var j: int64 := 0;
        while (j < nb_vocabSize) {
          totalWords := totalWords + peekf64(nb_wordCounts + c * nb_vocabSize * 8 + j * 8);
          j := j + 1;
        }
        totalWords := totalWords + nb_alpha * (nb_vocabSize as f64);
        score := score + NBLog(wc / totalWords);
      }
      i := i + 1;
    }
    pokef64(scores + c * 8, score);
    c := c + 1;
  }
  return scores;
}

pub fn NaiveBayesGetWordCount(classIdx: int64, wordIdx: int64): f64 {
  if (nb_wordCounts == 0) { return 0.0; }
  if (classIdx < 0 || classIdx >= nb_nClasses) { return 0.0; }
  if (wordIdx < 0 || wordIdx >= nb_vocabSize) { return 0.0; }
  return peekf64(nb_wordCounts + classIdx * nb_vocabSize * 8 + wordIdx * 8);
}

pub fn NaiveBayesGetClassCount(classIdx: int64): int64 {
  if (nb_classCounts == 0) { return 0; }
  return peek8(nb_classCounts + classIdx * 8);
}

pub fn NaiveBayesScore(documents: int64, docLengths: int64, labels: int64, n: int64): f64 {
  if (documents == 0) { return 0.0; }
  var correct: int64 := 0;
  var i: int64 := 0;
  while (i < n) {
    var docWords: int64 := peek8(documents + i * 8);
    var docLen: int64 := peek8(docLengths + i * 8);
    var trueLabel: int64 := peek8(labels + i * 8);
    var pred: int64 := NaiveBayesPredict(docWords, docLen);
    if (pred == trueLabel) { correct := correct + 1; }
    i := i + 1;
  }
  return (correct as f64) / (n as f64);
}

pub fn NaiveBayesBernoulliInit(nClasses: int64, vocabSize: int64): void {
  NaiveBayesInit(nClasses, vocabSize);
  nb_bernoulli := 1;
}

pub fn NaiveBayesBernoulliFit(documents: int64, docLengths: int64, labels: int64, n: int64): void {
  if (documents == 0 || labels == 0 || n == 0) { return; }
  nb_nDocs := n;
  nb_bernoulli := 1;
  var i: int64 := 0;
  while (i < n) {
    var label: int64 := peek8(labels + i * 8);
    var classCount: int64 := peek8(nb_classCounts + label * 8);
    poke8(nb_classCounts + label * 8, classCount + 1);
    i := i + 1;
  }
  i := 0;
  while (i < n) {
    var label: int64 := peek8(labels + i * 8);
    var docStart: int64 := peek8(documents + i * 8);
    var docLen: int64 := peek8(docLengths + i * 8);
    var j: int64 := 0;
    while (j < docLen) {
      var wordIdx: int64 := peek8(docStart + j * 8);
      if (wordIdx >= 0 && wordIdx < nb_vocabSize) {
        var idx: int64 := label * nb_vocabSize + wordIdx;
        var count: f64 := peekf64(nb_wordCounts + idx * 8);
        if (count == 0.0) { pokef64(nb_wordCounts + idx * 8, 1.0); }
      }
      j := j + 1;
    }
    i := i + 1;
  }
  var total: f64 := n as f64;
  i := 0;
  while (i < nb_nClasses) {
    var count: int64 := peek8(nb_classCounts + i * 8);
    var prior: f64 := (count as f64) / total;
    pokef64(nb_classPriors + i * 8, NBLog(prior));
    i := i + 1;
  }
}

pub fn NaiveBayesBernoulliPredict(docWords: int64, docLen: int64): int64 {
  if (nb_wordCounts == 0) { return 0; }
  var bestClass: int64 := 0;
  var bestScore: f64 := -999999999.0;
  var c: int64 := 0;
  while (c < nb_nClasses) {
    var score: f64 := peekf64(nb_classPriors + c * 8);
    var nDocsInClass: int64 := peek8(nb_classCounts + c * 8);
    var i: int64 := 0;
    while (i < docLen) {
      var wordIdx: int64 := peek8(docWords + i * 8);
      if (wordIdx >= 0 && wordIdx < nb_vocabSize) {
        var wc: f64 := peekf64(nb_wordCounts + c * nb_vocabSize * 8 + wordIdx * 8);
        var pPresent: f64 := (wc + nb_alpha) / (nDocsInClass as f64 + 2.0 * nb_alpha);
        if (pPresent > 0.0) { score := score + NBLog(pPresent); }
      }
      i := i + 1;
    }
    if (score > bestScore) { bestScore := score; bestClass := c; }
    c := c + 1;
  }
  return bestClass;
}

// ============================================================================
// Decision Tree Classifier
// ============================================================================

pub type DecisionTreeNode = class {
  featureIdx: int64;
  threshold: f64;
  left: DecisionTreeNode;
  right: DecisionTreeNode;
  classLabel: int64;
  nSamples: int64;
  impurity: f64;
};

var dt_root: DecisionTreeNode;
var dt_maxDepth: int64;
var dt_minSamplesSplit: int64;
var dt_nClasses: int64;
var dt_nFeatures: int64;
var dt_criterion: int64;

pub con DT_GINI: int64 := 0;
pub con DT_ENTROPY: int64 := 1;
pub con DT_MSE: int64 := 2;

pub fn DecisionTreeInit(maxDepth: int64, criterion: int64): void {
  dt_root := DecisionTreeNode{};
  dt_maxDepth := maxDepth;
  if (dt_maxDepth < 1) { dt_maxDepth := 10; }
  dt_minSamplesSplit := 2;
  dt_nClasses := 0;
  dt_nFeatures := 0;
  dt_criterion := criterion;
  if (dt_criterion < 0 || dt_criterion > 2) { dt_criterion := DT_GINI; }
}

pub fn DTGiniImpurity(labels: int64, n: int64): f64 {
  if (n == 0) { return 0.0; }
  var classCounts: int64 := mmap(0, dt_nClasses * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  var i: int64 := 0;
  while (i < n) {
    var label: int64 := peek8(labels + i * 8);
    if (label >= 0 && label < dt_nClasses) {
      var count: int64 := peek8(classCounts + label * 8);
      poke8(classCounts + label * 8, count + 1);
    }
    i := i + 1;
  }
  var gini: f64 := 1.0;
  i := 0;
  while (i < dt_nClasses) {
    var count: int64 := peek8(classCounts + i * 8);
    var p: f64 := (count as f64) / (n as f64);
    gini := gini - (p * p);
    i := i + 1;
  }
  munmap(classCounts, dt_nClasses * 8);
  return gini;
}

pub fn DTEntropyImpurity(labels: int64, n: int64): f64 {
  if (n == 0) { return 0.0; }
  var classCounts: int64 := mmap(0, dt_nClasses * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
  var i: int64 := 0;
  while (i < n) {
    var label: int64 := peek8(labels + i * 8);
    if (label >= 0 && label < dt_nClasses) {
      var count: int64 := peek8(classCounts + label * 8);
      poke8(classCounts + label * 8, count + 1);
    }
    i := i + 1;
  }
  var entropy: f64 := 0.0;
  i := 0;
  while (i < dt_nClasses) {
    var count: int64 := peek8(classCounts + i * 8);
    if (count > 0) {
      var p: f64 := (count as f64) / (n as f64);
      entropy := entropy + (p * NBLog(p) * -1.442695);
    }
    i := i + 1;
  }
  munmap(classCounts, dt_nClasses * 8);
  return entropy;
}

pub fn DTMSEImpurity(values: int64, n: int64): f64 {
  if (n == 0) { return 0.0; }
  var sum: f64 := 0.0;
  var i: int64 := 0;
  while (i < n) { sum := sum + peekf64(values + i * 8); i := i + 1; }
  var mean: f64 := sum / (n as f64);
  var mse: f64 := 0.0;
  i := 0;
  while (i < n) {
    var diff: f64 := peekf64(values + i * 8) - mean;
    mse := mse + (diff * diff);
    i := i + 1;
  }
  return mse / (n as f64);
}

pub fn DTFindBestSplit(features: int64, featureIdx: int64, labels: int64, n: int64): DecisionTreeNode {
  var node: DecisionTreeNode := DecisionTreeNode{};
  if (n < dt_minSamplesSplit) {
    node.featureIdx := -1;
    node.classLabel := 0;
    node.nSamples := n;
    return node;
  }
  var bestImpurity: f64 := 999999.0;
  var bestThreshold: f64 := 0.0;
  var bestFeature: int64 := -1;
  var i: int64 := 0;
  while (i < n - 1) {
    var thresh: f64 := (peekf64(features + i * 8) + peekf64(features + (i + 1) * 8)) * 0.5;
    var leftN: int64 := 0;
    var rightN: int64 := 0;
    var leftLabels: int64 := mmap(0, n * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
    var rightLabels: int64 := mmap(0, n * 8, PROT_RW, MAP_ANON, FD_NONE, 0);
    var j: int64 := 0;
    while (j < n) {
      var val: f64 := peekf64(features + j * 8);
      if (val <= thresh) {
        poke8(leftLabels + leftN * 8, peek8(labels + j * 8));
        leftN := leftN + 1;
      } else {
        poke8(rightLabels + rightN * 8, peek8(labels + j * 8));
        rightN := rightN + 1;
      }
      j := j + 1;
    }
    var impLeft: f64 := 0.0;
    var impRight: f64 := 0.0;
    if (dt_criterion == DT_GINI) {
      impLeft := DTGiniImpurity(leftLabels, leftN);
      impRight := DTGiniImpurity(rightLabels, rightN);
    } else if (dt_criterion == DT_ENTROPY) {
      impLeft := DTEntropyImpurity(leftLabels, leftN);
      impRight := DTEntropyImpurity(rightLabels, rightN);
    }
    var weighted: f64 := (impLeft * (leftN as f64) + impRight * (rightN as f64)) / (n as f64);
    if (weighted < bestImpurity) {
      bestImpurity := weighted;
      bestThreshold := thresh;
      bestFeature := featureIdx;
    }
    munmap(leftLabels, n * 8);
    munmap(rightLabels, n * 8);
    i := i + 1;
  }
  node.threshold := bestThreshold;
  node.featureIdx := bestFeature;
  node.nSamples := n;
  node.impurity := bestImpurity;
  return node;
}

pub fn DecisionTreeFit(features: int64, labels: int64, n: int64, nFeatures: int64, nClasses: int64): void {
  if (features == 0 || labels == 0 || n == 0) { return; }
  dt_nFeatures := nFeatures;
  dt_nClasses := nClasses;
  if (dt_nClasses < 2) { dt_nClasses := 2; }
}

pub fn DecisionTreePredict(featureVector: int64): int64 {
  var node: DecisionTreeNode := dt_root;
  var depth: int64 := 0;
  while (node.featureIdx != -1 && depth < dt_maxDepth) {
    if (peekf64(featureVector + node.featureIdx * 8) <= node.threshold) {
      if (node.left == nil) { break; } // Handle null case defensively
      node := node.left;
    } else {
      if (node.right == nil) { break; } // Handle null case defensively
      node := node.right;
    }
    depth := depth + 1;
  }
  return node.classLabel;
}

// ============================================================================
// Metrics & Scoring
// ============================================================================

// Classification Accuracy
pub fn AccuracyScore(y_true: int64, y_pred: int64, n: int64): f64 {
  var correct: int64 := 0;
  var i: int64 := 0;
  while (i < n) {
    if (peek8(y_true + i * 8) == peek8(y_pred + i * 8)) {
      correct := correct + 1;
    }
    i := i + 1;
  }
  return (correct as f64) / (n as f64);
}

// Mean Squared Error
pub fn MeanSquaredError(y_true: int64, y_pred: int64, n: int64): f64 {
  var sum_sq_err: f64 := 0.0;
  var i: int64 := 0;
  while (i < n) {
    var diff: f64 := peekf64(y_true + i * 8) - peekf64(y_pred + i * 8);
    sum_sq_err := sum_sq_err + (diff * diff);
    i := i + 1;
  }
  return sum_sq_err / (n as f64);
}

// Mean Absolute Error
pub fn MeanAbsoluteError(y_true: int64, y_pred: int64, n: int64): f64 {
  var sum_abs_err: f64 := 0.0;
  var i: int64 := 0;
  while (i < n) {
    var diff: f64 := peekf64(y_true + i * 8) - peekf64(y_pred + i * 8);
    if (diff < 0.0) { diff := 0.0 - diff; }
    sum_abs_err := sum_abs_err + diff;
    i := i + 1;
  }
  return sum_abs_err / (n as f64);
}

// R2 Score
pub fn R2Score(y_true: int64, y_pred: int64, n: int64): f64 {
  var mean_y_true: f64 := 0.0;
  var i: int64 := 0;
  while (i < n) {
    mean_y_true := mean_y_true + peekf64(y_true + i * 8);
    i := i + 1;
  }
  mean_y_true := mean_y_true / (n as f64);

  var ss_tot: f64 := 0.0;
  var ss_res: f64 := 0.0;
  i := 0;
  while (i < n) {
    var true_val: f64 := peekf64(y_true + i * 8);
    var pred_val: f64 := peekf64(y_pred + i * 8);
    ss_tot := ss_tot + (true_val - mean_y_true) * (true_val - mean_y_true);
    ss_res := ss_res + (true_val - pred_val) * (true_val - pred_val);
    i := i + 1;
  }
  if (ss_tot == 0.0) { return 0.0; } // Avoid division by zero
  return 1.0 - (ss_res / ss_tot);
}
